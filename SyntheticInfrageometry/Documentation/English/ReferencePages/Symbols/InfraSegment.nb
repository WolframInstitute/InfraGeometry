Cell[CellGroupData[{
Cell["InfraSegment", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d6713a17-18fb-4526-8fdc-c151a76bce70"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4eff8e54-3d9c-439b-96ec-a0c6876af6d4"],
 "\[LineSeparator]",
 "is the segment from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ": every geodesic from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " at once. It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMeasurement", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "041f85fa-489c-474d-9df4-d0899d9c572a"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraVertexList", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "870a2951-cd73-427a-8395-b5094d5bbeb4"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b512ca9b-d330-43fd-a789-e7e010aa049c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fdd71b77-179e-4113-bb5c-ddc1013b8ce5"],
 "\[LineSeparator]",
 "is the polyline of the segments [",
 StyleBox["p1", "TI"],
 ", ",
 StyleBox["p2", "TI"],
 "], \[Ellipsis], [",
 StyleBox["p(k-1)", "TI"],
 ", ",
 StyleBox["pk", "TI"],
 "].",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0400c815-6d34-450a-a5b2-872ffe40a24a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1c5ba61-eef4-4189-bf9a-cb1e02977e05"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraScene", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "73fefe14-42fa-4c15-bae9-3c41fba52f7e"],
 " is the segment construction token; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraSegment", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "087d0d73-a006-46c1-80b5-749881bfb95b"],
 " is the search."
}], "Usage",ExpressionUUID->"9cb096b0-2713-4075-82c1-4880ac5b885f"],

Cell[TextData[{
 "Definition: an infra-segment between ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " is the set of all geodesics from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"dd7b9a8c-6ddd-4258-bb70-3ee0af2a72d7"],

Cell["\<\
It carries no weights. The geodesics are equally admissible, so nothing \
distinguishes them.\
\>", "Notes",ExpressionUUID->"f18f8016-2b9e-4172-8aa7-94a3c12e8b66"],

Cell[TextData[{
 "The head holds its two points and computes nothing. Its graph \[LongDash] \
",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMeasurement", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fde285b-a963-492f-8c2f-69a31a11e750"],
 " \[LongDash] is the geodesic interval: the vertices ",
 StyleBox["v", "TI"],
 " with ",
 StyleBox["d(p, v) + d(v, q) = d(p, q)", "TI"],
 ", with arrows of rising distance from ",
 StyleBox["p", "TI"],
 ". Its source-to-sink chains are exactly the geodesics, each once, so ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "836dd457-8a1e-4a0a-9c1c-537188a94c86"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2abe8003-82a1-4117-b22c-de65c4bc4c48"],
 "."
}], "Notes",ExpressionUUID->"30fb1518-ab49-4728-92b9-a362e6798b45"],

Cell["\<\
Every count is read off that graph by dynamic programming, never by \
enumeration. The graph stays small where the family is large: two vertices at \
distance 5 on a square grid have 10 geodesics and a 12-vertex graph.\
\>", "Notes",ExpressionUUID->"8efc2089-22bf-497e-9cce-6b3ab777caa2"],

Cell[TextData[{
 "A polyline is the one head whose ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34db4af3-e499-4edb-be6c-bca26860f10c"],
 " of graphs is not a family of alternatives. Its members are concatenations \
of one geodesic per piece, so its ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf13f1b8-6c6a-4005-9442-e76c95f732d3"],
 " is the product over the pieces and its ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c86804e-071c-4d9c-ae2a-033ed3fb28d3"],
 " the sum. Its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ccfe9cd-ecbb-42f2-8b17-6f08193cc490"],
 " stays the sum of the piece densities."
}], "Notes",ExpressionUUID->"f4f16ed9-0771-4a3a-9bfa-8c2186aa8a8d"],

Cell[TextData[{
 "A member is a vertex list; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraVertexList", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5d26d158-8349-4afd-bf2f-5eb61a603c9d"],
 " reads one, several or all of them, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMemberQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5a2e0396-59ca-483b-83c1-05065bb434a3"],
 " tests one."
}], "Notes",ExpressionUUID->"6fe42ac2-4e09-401e-bad2-e4904243653a"]
}, Open  ]],

