Cell["\<\
A polyline through the centre of a 5 \[Times] 5 grid: 36 members, each 8 \
edges long, and 12 of them \[LongDash] the six geodesics in, times the six \
out, counted once per piece \[LongDash] pass the centre.\
\>", "ExampleText",ExpressionUUID->"7d2f584c-4ae3-41cd-8ed2-570d4b2db344"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"poly", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"1", ",", " ", "13", ",", " ", "25"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "poly", ",", " ", "\"\<Cardinality\>\""}], "]"}],
      ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "poly", ",", " ", "\"\<Length\>\""}], "]"}], ",",
      "\n", "   ", 
     RowBox[{
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "poly", ",", " ", "\"\<VertexDensity\>\""}], 
       "]"}], "[", "13", "]"}]}], "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"c2aaac2d-7d0c-406b-8d75-61feb9a52ab1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"36", ",", "8", ",", "12"}], "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"1279954b-adfd-44c8-affe-f85e047e1a56"]
}, Open  ]]
}, Open  ]],

