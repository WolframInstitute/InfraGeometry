Cell["The graph is small where the family is large.", "ExampleText",ExpressionUUID->"f5641e68-633d-444d-b7f1-a4b05e458326"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<geodesics\>\"", " ", "->", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<Cardinality\>\""}], 
       "]"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<length\>\"", " ", "->", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<Length\>\""}], "]"}]}], ",",
      "\n", "    ", 
     RowBox[{"\"\<graph vertices\>\"", " ", "->", " ", 
      RowBox[{"VertexCount", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<Graph\>\""}], 
        "]"}]}]}]}], "|>"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"27ae1d34-3ec4-46ed-807d-9b1f55973b74"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"geodesics\"\>", "\[Rule]", "10"}], ",", 
   RowBox[{"\<\"length\"\>", "\[Rule]", "5"}], ",", 
   RowBox[{"\<\"graph vertices\"\>", "\[Rule]", "12"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"22df5762-1623-44bf-baf2-1f6e34cb8e4e"]
}, Open  ]],

Cell["The members are vertex lists.", "ExampleText",ExpressionUUID->"784170fc-d288-4e89-918a-f56682b6193e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraVertexList", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
   RowBox[{"InfraSegment", "[", 
    RowBox[{"1", ",", " ", "11"}], "]"}], ",", " ", "All"}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"a6f667b2-4fc6-456f-9615-77b9ece128e3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "7", ",", "11"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "6", ",", "7", ",", "11"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "6", ",", "10", ",", "11"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "5", ",", "6", ",", "7", ",", "11"}], "}"}], ",", 
