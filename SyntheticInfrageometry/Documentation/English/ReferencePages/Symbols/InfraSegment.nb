Cell["\<\
The graph of a segment on the square grid. Every geodesic is a directed path \
through it.\
\>", "ExampleText",ExpressionUUID->"1f70705a-da51-47d6-b82c-ac5ff50e9e5d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
    "]"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"041d4145-8c65-4bb4-b0a3-a4a872df4d3f"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3, 4, 7, 8, 9, 10, 17, 20, 21, 
      31}, {{{1, 2}, {1, 4}, {2, 3}, {2, 5}, {3, 6}, {3, 8}, {4, 3}, {4, 7}, {
       5, 6}, {6, 9}, {7, 8}, {7, 11}, {8, 9}, {8, 10}, {9, 12}, {10, 12}, {
       11, 10}}, Null}]]}, 
    TagBox[
     GraphicsGroupBox[
      GraphicsComplexBox[{{0., 5.}, {0., 4.}, {1., 3.}, {1., 4.}, {0., 3.}, {
       0., 2.}, {2., 3.}, {1., 2.}, {1., 1.}, {2., 1.}, {2., 2.}, {1., 
       0.}}, {
        {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], Arrowheads[
         Medium], ArrowBox[{1, 2}, 0.043048128342245986`], 
         ArrowBox[{1, 4}, 0.043048128342245986`], 
         ArrowBox[{2, 3}, 0.043048128342245986`], 
         ArrowBox[{2, 5}, 0.043048128342245986`], 
         ArrowBox[{3, 6}, 0.043048128342245986`], 
         ArrowBox[{3, 8}, 0.043048128342245986`], 
         ArrowBox[{4, 3}, 0.043048128342245986`], 
         ArrowBox[{4, 7}, 0.043048128342245986`], 
         ArrowBox[{5, 6}, 0.043048128342245986`], 
         ArrowBox[{6, 9}, 0.043048128342245986`], 
         ArrowBox[{7, 8}, 0.043048128342245986`], 
         ArrowBox[{7, 11}, 0.043048128342245986`], 
         ArrowBox[{8, 9}, 0.043048128342245986`], 
         ArrowBox[{8, 10}, 0.043048128342245986`], 
         ArrowBox[{9, 12}, 0.043048128342245986`], 
         ArrowBox[{10, 12}, 0.043048128342245986`], 
