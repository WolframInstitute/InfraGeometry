Cell[CellGroupData[{
Cell["InfraSubgraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c8f366d2-e5cb-418b-931f-79a369f810dc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubgraph"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSubgraph", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8bb9687c-8857-4ada-af56-b7eeac4dd111"],
 "\[LineSeparator]",
 "gives the subgraph of ",
 StyleBox["graph", "TI"],
 " induced on the support of the Euclidean head ",
 StyleBox["obj", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0f3bf987-e760-4f39-b000-400af1f39a76"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubgraph"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSubgraph", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    RowBox[{
     StyleBox["obj", "TI"], " ", "->", " ", 
     StyleBox["t", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b499d775-77df-45b8-a104-35f3f4c5e609"],
 "\[LineSeparator]",
 "thickens the support by ",
 StyleBox["t", "TI"],
 " steps before inducing \[LongDash] the subgraph on ",
 Cell[BoxData[
  RowBox[{"VertexList", " ", "@", " ", 
   RowBox[{"NeighborhoodGraph", "[", 
    RowBox[{"graph", ",", " ", "support", ",", " ", "t"}], "]"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a94476d3-b351-4afd-9246-875c53088b64"],
 "."
}], "Usage",ExpressionUUID->"71c62a28-cd97-47d5-b9d5-a8b0b0cbff91"],

Cell[TextData[{
 "Same as ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{"graph", ",", " ", "obj", ",", " ", "\"\<Subgraph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48b2b87c-72c2-488c-ae63-ae4396344f17"],
 "; the support itself is ",
 Cell[BoxData[
  RowBox[{"Keys", " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"graph", ",", " ", "obj", ",", " ", "\"\<VertexDensity\>\""}], 
    "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26aa16c1-a415-4842-b248-82255d807800"],
 ". Works on ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraIntersection", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "38082502-5a21-4b49-9f3f-c15cb683f039"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraUnion", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "43ca38d3-0b61-4d8c-93ef-a667a33d3897"],
 " as well as on the five Euclidean heads, since every one of them carries a ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c25deba2-31c9-4bc5-b4b4-3ea91abdb10b"],
 "."
}], "Notes",ExpressionUUID->"5ab1621b-9c25-497a-a148-be08b95a76ae"]
