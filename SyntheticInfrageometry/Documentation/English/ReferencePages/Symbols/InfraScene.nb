Notebook[{

Cell[CellGroupData[{
Cell["InfraScene", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a7bd0aea-cc2d-433a-a876-82790926f0b5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraScene"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraScene", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["x1", "TI"], ",", " ", 
      StyleBox["x2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["hyp1", "TI"], ",", " ", 
      StyleBox["hyp2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e24e02cd-c3e1-4bb4-af34-da335fff1928"],
 "\[LineSeparator]",
 "is a construction stated before any graph: the objects ",
 StyleBox["xi", "TI"],
 ", and hypotheses that construct them or assert relations between them.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"161edc63-c0e1-4eb4-8f35-194576216e6f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraScene"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraScene", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["x1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraGeometricStep", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          StyleBox["hyp1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
        
        StyleBox["label", "TI"]}], "]"}], ",", " ", "\[Ellipsis]"}], "}"}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67720451-4db5-4be4-82ac-c98a5424118f"],
 "\[LineSeparator]",
 "groups the hypotheses into labelled steps."
}], "Usage",ExpressionUUID->"b5193a13-f0ae-4508-872a-0eac3db56842"],

Cell[TextData[{
 "Definition: a scene is a list of objects and a list of hypotheses. A ",
 StyleBox["construction",
  FontWeight->"Bold"],
 " is a hypothesis ",
 Cell[BoxData[
  RowBox[{"x", " ", "==", " ", "token"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "094a9b35-261e-40ca-9b31-c17d47eaf638"],
 ", whose left side is an object. Every other hypothesis is an ",
 StyleBox["assertion",
  FontWeight->"Bold"],
 ". A scene computes nothing; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraScene"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraScene", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "baa64898-2310-4cbf-9978-cd4dbd2ef121"],
 " solves it on a graph."
}], "Notes",ExpressionUUID->"47b1be63-4c60-451e-84a6-41614d9a8475"],

Cell[TextData[{
 "The right side of a construction is a token: an inert head with objects in \
place of points. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPoint"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPoint", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f8171732-d225-484c-88b1-12894f561946"],
 Cell[BoxData[
  RowBox[{"[", "v", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2666195e-bd00-4e6e-bfec-bf979537d2c8"],
 " is the vertex ",
 StyleBox["v", "TI"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPoint"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPoint", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84ab2866-56dd-40a2-bfae-a9636304c619"],
 " every vertex at distance ",
 StyleBox["d", "TI"],
 " from ",
 StyleBox["v", "TI"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6055c1c0-fde4-492f-8098-7f544d38594f"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "y"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f42bab7a-25c2-44b9-96e0-278e624f7cb9"],
 " is a geodesic from ",
 StyleBox["x", "TI"],
 " to ",
 StyleBox["y", "TI"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRay"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraRay", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c9dc6434-39b3-43d1-9cf5-936ec2d8b7f3"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "y"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9cc5f365-9d6c-4998-adf1-ba7a2325bcdb"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLine"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraLine", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6775c273-e2e6-493a-bd7d-8f1420f20134"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "y"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "edfab84c-c0b1-465a-afb4-42dca1fc92e4"],
 " a ray and a line. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraCircle", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7c3b33ec-77e0-499e-800b-6f166a417e2e"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa8fd764-9337-43a0-8be4-6f08eca061fa"],
 " is a circle about ",
 StyleBox["x", "TI"],
 " at radius ",
 StyleBox["r", "TI"],
 ", or in the band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "s"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dfa2b972-b521-4dc6-ab16-6fa086d37746"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraIntersection", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "19db3c48-2063-470c-b43b-8772ea7561b0"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "y"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1bc70e0-55c5-4bdf-8808-11fb5005495a"],
 " is a vertex the two objects share; an operand may be a token itself."
}], "Notes",ExpressionUUID->"8c7377fb-4d3f-4a95-b059-2922e87b70e2"],

Cell["\<\
A token stands for its realisations, and each realisation is one branch. So a \
construction binds its object to a single vertex, or a single vertex list, \
per branch, and the branches multiply from one construction to the next.\
\>", "Notes",ExpressionUUID->"5c7c0c48-6555-4d05-ac18-ac544e3a88a2"],

Cell[TextData[{
 "Inside a scene the token ",
 Cell[BoxData[
  RowBox[{"InfraCircle", "[", 
   RowBox[{"x", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce5225f6-bea3-4c4d-827d-09e5774a4a3e"],
 " reads ",
 StyleBox["r", "TI"],
 " as a radius. As a head, a bare second argument of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraCircle", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4f9ba825-1071-4be7-b100-d64cc16d6835"],
 " is always a point. This is an open inconsistency."
}], "Notes",ExpressionUUID->"9c464c74-5de8-4a36-9305-fc7a7fbfc4d4"],

Cell[TextData[{
 "An assertion is a predicate on objects: a comparison of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDistance"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraDistance", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "067f3dd8-31a2-49d6-974d-5d7def0aa8ed"],
 " values, or one of the ",
 Cell[BoxData[
  RowBox[{"Infra", "*", "Q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22157e8a-7ad4-4513-8246-6b8e6bb34e71"],
 " tests without its graph (",
 Cell[BoxData[
  RowBox[{"InfraSegmentQ", "[", "s", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd2b276b-d4ca-4297-ad0e-3359f9c35b14"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraCircleQ", "[", "c", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6c8f02c-ba44-42e3-8169-0470bbb319a2"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraParallelQ", "[", 
   RowBox[{"l1", ",", " ", "l2"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c0051df-90c5-410a-9a18-6971ac91cab9"],
 " and a few more). The graph is supplied when the scene is solved, and a \
branch survives only if every assertion holds on it. An ",
 Cell[BoxData[
  RowBox[{"Infra", "*", "Q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8106c7a3-b385-483f-a50b-4e5b4d21b97f"],
 " test that cannot be given the graph is refused with ",
 Cell[BoxData[
  RowBox[{"InfraScene", "::", "badassertion"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "328d4e6e-9d68-4988-b62f-dc75d1dab47f"],
 "."
}], "Notes",ExpressionUUID->"b93c411a-6039-4741-9017-0bdcaf765a31"],

Cell[TextData[{
 "Without ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraGeometricStep"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraGeometricStep", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7bd5d0e8-332d-4c81-b864-8155eba01450"],
 ", the steps are the levels of the dependency graph of the constructions: \
first the objects that depend on no other object, then those that depend only \
on them, and so on. With it, the steps are the ones written, in order."
}], "Notes",ExpressionUUID->"13425214-c43b-4824-8d18-063ea63fb7e5"],

Cell[TextData[{
 "The objects are ordinary symbols, so they must have no value when the scene \
is built; ",
 Cell[BoxData["ClearAll"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "277d110a-3093-4005-904c-0ecb3365816c"],
 " them first."
}], "Notes",ExpressionUUID->"a06cff80-dd81-4c28-b97c-90591a7ee71f"],

Cell[TextData[{
 "A scene answers ",
 Cell[BoxData["\"\<Objects\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b6e1076-d72d-4c84-abf2-f165af45ab8b"],
 ", ",
 Cell[BoxData["\"\<Constructions\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "842a2398-2f46-4ad6-9b1b-74616faa128c"],
 ", ",
 Cell[BoxData["\"\<Assertions\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "730f4e38-ba08-4b14-8909-c92eef01c42f"],
 ", ",
 Cell[BoxData["\"\<Steps\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "553197f2-21ff-4981-a432-76b720e20b49"],
 ", ",
 Cell[BoxData["\"\<Labels\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4757e406-f0e2-4efe-ba5d-1349a42bd5fd"],
 " and ",
 Cell[BoxData["\"\<DependencyGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbf20b09-1e81-4555-a37a-4f027efe17f9"],
 ". The dependency graph is ",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fabd77f4-3780-4833-afdf-2cc6d75a62d5"],
 " when the steps are written by hand."
}], "Notes",ExpressionUUID->"56b7cd73-5e32-4a27-8b47-ecf507629b5c"],

Cell[TextData[{
 StyleBox["A construction can stall.",
  FontWeight->"Bold"],
 " Euclid never postulated that the two circles of I.1 meet, and on a graph \
they need not. On a square grid a single distance shell spans no cycle, so \
the circles of I.1 at one radius do not exist. That is the continuity \
assumption Euclid left unstated, showing up as an empty result. A band two \
radii thick carries the circles, and there the construction goes through."
}], "Notes",ExpressionUUID->"f8f1064f-62c5-47f8-82b2-35bc3074afec"]
}, Open  ]],

