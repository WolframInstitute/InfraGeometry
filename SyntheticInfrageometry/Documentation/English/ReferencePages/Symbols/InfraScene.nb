Cell["\<\
The opening of Euclid I.10: two points, a circle about each, and the vertices \
where the circles meet. On the discretized plane this succeeds.\
\>", "ExampleText",ExpressionUUID->"6ec73fa3-d2aa-4061-8a0b-bad68f498404"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "a", ",", " ", "b", ",", " ", "cA", ",", " ", "cB", ",", " ", "u"}], "]"}],
   ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p1", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p2", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "p1", ",", " ", "#"}], "]"}], " ", "==", " ",
          "8"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "a", ",", " ", "b", ",", " ", "cA", ",", " ", "cB", ",", " ", "u"}], 
        "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "p1", "]"}]}], "}"}], ",", 
           " ", "\"\<point a\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"b", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "p2", "]"}]}], "}"}], ",", 
           " ", "\"\<point b\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"cA", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"a", ",", " ", 
               RowBox[{"{", 
                RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle around a\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"cB", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"b", ",", " ", 
               RowBox[{"{", 
                RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle around b\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"u", " ", "==", " ", 
             RowBox[{"InfraIntersection", "[", 
              RowBox[{"cA", ",", " ", "cB"}], "]"}]}], "}"}], ",", 
           " ", "\"\<they meet\>\""}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<objects\>\"", " ", "->", " ", 
      RowBox[{"scene", "[", "\"\<Objects\>\"", "]"}]}], ",", " ", 
     RowBox[{"\"\<labels\>\"", " ", "->", " ", 
      RowBox[{"scene", "[", "\"\<Labels\>\"", "]"}]}]}], "|>"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"96d661dd-6a45-499a-8e09-653188f4d58f"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"objects\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "cA", ",", "cB", ",", "u"}], "}"}]}], ",", 
   RowBox[{"\<\"labels\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"point a\"\>", ",", "\<\"point b\"\>", 
      ",", "\<\"circle around a\"\>", ",", "\<\"circle around b\"\>", 
      ",", "\<\"they meet\"\>"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ecc1117e-bd7b-482c-9f4b-b1b7db4d09e9"]
}, Open  ]],

Cell["\<\
Solving it. The third argument is the step to solve up to, and the last step \
binds every object.\
\>", "ExampleText",ExpressionUUID->"4789e987-4dde-4b66-ab2e-641d2ea7a1a8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "a", ",", " ", "b", ",", " ", "cA", ",", " ", "cB", ",", " ", "u"}], "]"}],
   ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p1", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p2", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "p1", ",", " ", "#"}], "]"}], " ", "==", " ",
          "8"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "a", ",", " ", "b", ",", " ", "cA", ",", " ", "cB", ",", " ", "u"}], 
        "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
