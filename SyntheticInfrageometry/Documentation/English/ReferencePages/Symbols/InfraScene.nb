Cell[TextData[{
 "An assertion keeps the branches it holds on. Of the four meeting vertices, \
one is nearer to the corner 1 than ",
 StyleBox["A", "TI"],
 " is."
}], "ExampleText",ExpressionUUID->"9746ace8-e306-4634-b3e9-9441c38b864b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "pA", ",", " ", "pB", ",", " ", "circleA", ",", " ", "circleB", ",", " ", 
    "meet"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"13", ",", " ", "13"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "pA", ",", " ", "pB", ",", " ", "circleA", ",", " ", "circleB", ",", 
         " ", "meet"}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "83", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "87", "]"}]}], ",", "\n", "      ", 
         RowBox[{"circleA", " ", "==", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"pA", ",", " ", 
            RowBox[{"{", 
             RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}], ",", " ", 
         RowBox[{"circleB", " ", "==", " ", 
          RowBox[{"InfraCircle", "[", 
