Cell["The objects, the step labels and the steps.", "ExampleText",ExpressionUUID->"03089c41-e545-481d-a119-00d6446083dc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "pA", ",", " ", "pB", ",", " ", "circleA", ",", " ", "circleB", ",", " ", 
    "meet"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "pA", ",", " ", "pB", ",", " ", "circleA", ",", " ", "circleB", ",", 
         " ", "meet"}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"pA", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "83", "]"}]}], "}"}], ",", 
           " ", "\"\<point A\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"pB", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "87", "]"}]}], "}"}], ",", 
           " ", "\"\<point B\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"circleA", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"pA", ",", " ", 
               RowBox[{"{", 
                RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle about A\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"circleB", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"pB", ",", " ", 
               RowBox[{"{", 
                RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle about B\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"meet", " ", "==", " ", 
             RowBox[{"InfraIntersection", "[", 
              RowBox[{"circleA", ",", " ", "circleB"}], "]"}]}], "}"}], ",", 
           " ", "\"\<where they meet\>\""}], "]"}]}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"scene", "[", "\"\<Objects\>\"", "]"}], ",", " ", 
     RowBox[{"scene", "[", "\"\<Labels\>\"", "]"}], ",", " ", 
     RowBox[{"scene", "[", "\"\<Steps\>\"", "]"}]}], "}"}]}], "]"}]}], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"c14ce43c-0100-42a5-8876-7a31b5527cd4"],

