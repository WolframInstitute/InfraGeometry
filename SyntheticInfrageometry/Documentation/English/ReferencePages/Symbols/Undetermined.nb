Cell[TextData[{
 "The circle's \"Faithful\" is always ",
 Cell[BoxData["Undetermined"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6df1b920-279e-48e2-a637-d06588ffbac9"],
 ", whatever the substrate."
}], "ExampleText",ExpressionUUID->"fc2de113-391f-483d-baa6-80af129bb1dc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cir", " ", "=", " ", 
     RowBox[{"InfraCircle", "[", 
      RowBox[{"13", ",", " ", 
       RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"g", ",", " ", "cir", ",", " ", "\"\<Faithful\>\""}], "]"}]}], 
  "\n", "]"}]], "Input",
