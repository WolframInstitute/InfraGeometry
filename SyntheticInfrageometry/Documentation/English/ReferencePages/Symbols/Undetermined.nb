Notebook[{

Cell[CellGroupData[{
Cell["Undetermined", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4f18b95c-733e-4134-bb5a-a9cee1b08615"],
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/Undetermined", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "533d2c0f-6d0e-45ba-b1bc-6f6feeb56b1e"],
 "\[LineSeparator]",
 "is the value of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMeasurement", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", "\"\<Faithful\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1957185-c118-4c2a-b2f0-e705dcc4ea57"],
 " on a head whose graph is faithful \[LongDash] its chains are exactly its \
intended members \[LongDash] only under a hypothesis this paclet does not \
certify.",
 "\n"
}], "Usage",ExpressionUUID->"f1862539-0143-45aa-baa1-b6eef6e1ffe4"],

Cell[TextData[{
 "Every Euclidean head has a graph, and \"Faithful\" states whether every \
chain of that graph is genuinely a member of the head and every member a \
chain of it. For a segment, a ray or a line this is a proved theorem and ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff3f0c17-4453-42a1-b8c8-fbb4e8c5f9e5"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "135de2a5-417b-4b32-9795-a425a179eda4"],
 ". For ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraCircle", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7df68d97-93ce-4709-bd4b-98e8ba30b8ce"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraArc"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraArc", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "32e9969e-b8b7-4de2-a9da-e0e6bc6feda6"],
 " the analogous statement needs a geometric hypothesis on the substrate \
\[LongDash] a winding condition for the circle, the same condition plus a \
common-circle condition for the arc \[LongDash] that no computation here \
checks, so the honest answer is neither ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80e0a212-2507-44be-be23-b10d5c700e9e"],
 " nor ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02606044-868e-4771-960b-95841982450b"],
 " but ",
 Cell[BoxData["Undetermined"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03a1074b-e8ae-4b55-a6cf-9a3f1306c7a1"],
 ": the question is open on this call, not answered no."
}], "Notes",ExpressionUUID->"96d0233d-5b2a-4d77-8a5c-4ab98ca75e0b"],

Cell[TextData[{
 Cell[BoxData["Undetermined"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a918306-b545-420a-9029-7381c5174121"],
 " carries no further structure; it is a plain symbol, not a function."
}], "Notes",ExpressionUUID->"2902f017-a739-4755-889b-00a59efc4366"]
}, Open  ]],

