Cell["\<\
A circle lies in its band, and consecutive vertices are adjacent, the last \
and the first too.\
\>", "ExampleText",ExpressionUUID->"9fa77c64-b9e3-4962-8f97-a20d47899d1c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cyc", " ", "=", " ", 
     RowBox[{"InfraVertexList", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"41", ",", " ", 
         RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4"}], "}"}]}]}], "]"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"SubsetQ", "[", 
      RowBox[{
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "41", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", "cyc"}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Partition", "[", 
        RowBox[{"cyc", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], "]"}], ",",
        " ", 
       RowBox[{
        RowBox[{"EdgeQ", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"UndirectedEdge", " ", "@@", " ", "#"}]}], "]"}], " ", 
        "&"}]}], "]"}]}], "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f04592ed-d27f-4824-bd22-f74da74cbffc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f83313dc-368a-48ca-9fb2-cf7e0ce8b500"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraCircle"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraCircle", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a989f29f-40a6-4e6b-8e5c-7c39eaefc24b"],
 " searches the band directly and finds as many circles."
}], "ExampleText",ExpressionUUID->"af4120ca-c9ec-4d04-9f95-28c53107da01"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"41", ",", " ", 
         RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4"}], "}"}]}]}], "]"}], ",", 
       " ", "\"\<Cardinality\>\""}], "]"}], ",", "\n", "   ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraCircle", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", 
        RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}]}], ",", " ", "All"}], "]"}]}]}],
     "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4efb2131-8a81-48e4-bc1b-3b8db37d06bb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"16", ",", "16"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"0870fd5a-36d2-40d5-b40e-f92152007ce6"]
}, Open  ]],

Cell["\<\
The necklace is acyclic, and its closing arrow runs from its sink back to its \
source.\
\>", "ExampleText",ExpressionUUID->"2611b117-f02c-40e1-8c32-270e5763c2b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"neck", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{
        RowBox[{"GridGraph", "[", 
         RowBox[{"{", 
          RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
        RowBox[{"InfraCircle", "[", 
         RowBox[{"13", ",", " ", 
          RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}]}]}], "]"}], ",", 
        " ", "\"\<Graph\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"AcyclicGraphQ", "[", "neck", "]"}], ",", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "neck", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexInDegree", "[", 
          RowBox[{"neck", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], " ", 
        "&"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "neck", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexOutDegree", "[", 
          RowBox[{"neck", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], " ", 
        "&"}]}], "]"}]}], "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"05b6b563-1ad0-4766-9c3f-f3cf03eb7cbc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"{", "8", "}"}], ",", 
   RowBox[{"{", "7", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"7e773efd-8995-47b2-8ecb-bc1166240985"]
}, Open  ]]
}, Open  ]],

