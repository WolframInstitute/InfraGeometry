Cell[TextData[{
 "The band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", " ", "5"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd1d4900-72cb-468a-962f-be57f8ca1f28"],
 " around the centre of a square grid: the number of circles, their length, \
and the number of necklaces carrying them."
}], "ExampleText",ExpressionUUID->"a0d2762d-f299-412f-a2cd-6c79df211bed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"InfraCircle", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "5"}], "}"}]}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "circle", ",", " ", "\"\<Cardinality\>\""}], 
      "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "circle", ",", " ", "\"\<Length\>\""}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "circle", ",", " ", "\"\<Graph\>\""}], 
       "]"}]}]}], "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"23217e52-00c4-4e2c-b5eb-6332585d0582"],

