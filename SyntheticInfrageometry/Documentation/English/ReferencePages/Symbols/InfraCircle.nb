    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "073d3c6a-3771-47bf-a230-cc9365f17fae"],
 "\[LineSeparator]",
 "is the circle around ",
 StyleBox["c", "TI"],
 " through ",
 StyleBox["p", "TI"],
 ". It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMeasurement", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "22870356-9bc9-4b88-83a1-89a62074312e"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraVertexList", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d2d631e8-0bc4-447d-888b-f285d5bf4c39"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"39d131e8-7e1f-4c3a-b8c4-1fc3f3995545"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraCircle", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
     StyleBox["r", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "417a34ce-bb42-429f-bb7e-3ca560e8a638"],
 "\[LineSeparator]",
 "is the family of circles around ",
 StyleBox["c", "TI"],
 " at radius ",
 StyleBox["r", "TI"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraCircle", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["r", "TI"], ",", " ", 
       StyleBox["s", "TI"]}], "}"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2a72d87-59b5-437d-bf76-efc65e212e7f"],
 " the family in the band ",
 StyleBox["r", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["s", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ecf3626f-d7f9-4651-90d0-a718883c3f90"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraCircle", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c46b519-b3fa-4d1a-adcd-21f4a8e9d498"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraScene", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
