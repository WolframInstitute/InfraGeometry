Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraPoint", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f797eaaf-87bd-4686-8a24-975d67b56990"],
 Cell[BoxData[
  RowBox[{"RandomInfraPoint", "[", 
   StyleBox["graph", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aee195cf-4781-44ff-b6a0-25573e703c16"],
 "\[LineSeparator]",
 "gives a uniformly random vertex of ",
 StyleBox["graph", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"86c89c58-2eaf-4251-9a4e-7ef2b106e90a"],
 Cell[BoxData[
  RowBox[{"RandomInfraPoint", "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b78f925-df28-440d-90a9-888dd88a4062"],
 "\[LineSeparator]",
 "gives a uniformly random vertex at graph distance ",
 StyleBox["d", "TI"],
 " from ",
 StyleBox["p", "TI"],
 "."
}], "Usage",ExpressionUUID->"47c0fc79-7af0-47f7-893f-ba10d83795c6"],

Cell[TextData[{
 "A point on a graph is a bare vertex, so ",
 Cell[BoxData["RandomInfraPoint"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fdc8823b-f429-4b04-9f7d-ad6fd59548e2"],
 " returns one directly rather than a wrapped object. The two-argument form \
draws uniformly from the metric shell ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"v", " ", ":", " ", 
    RowBox[{
     RowBox[{"d", 
      RowBox[{"(", 
       RowBox[{"p", ",", " ", "v"}], ")"}]}], " ", "==", " ", "d"}]}], "}"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb12debb-d4e0-49fb-bdf8-dcffbcaa87a2"],
 "; it is ",
 Cell[BoxData[
  RowBox[{"RandomChoice", " ", "@", " ", 
   RowBox[{"FindInfraShell", "[", 
    RowBox[{"graph", ",", " ", "p", ",", " ", "d"}], "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb8d6450-e379-44ba-9001-e6b0eb246d13"],
 "."
}], "Notes",ExpressionUUID->"14df5c47-41b3-4ab0-83cd-30a46cb0a500"],

Cell[TextData[{
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8188652a-90cf-4124-bfca-04bfca529771"],
 " in front reproduces the draw, as with every random construction in this \
paclet."
}], "Notes",ExpressionUUID->"98f237e8-8ea3-4820-8811-ce4d9888222b"]
}, Open  ]],

