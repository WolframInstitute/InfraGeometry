Cell["\<\
A random vertex of a grid, and a random vertex at distance 2 from its center.\
\
\>", "ExampleText",ExpressionUUID->"f6aef4f4-48cb-4d9e-8a8b-6734d3a25a11"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "1", "]"}], ";", "\n", "  ", 
    RowBox[{"RandomInfraPoint", "[", "g", "]"}]}]}], "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a8e1e982-ae22-475a-b54b-b38171ebe948"],

Cell[BoxData["6"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1fabc698-7d74-406a-9c74-1f2842ea4495"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "1", "]"}], ";", "\n", "  ", 
    RowBox[{"RandomInfraPoint", "[", 
     RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}]}]}], "\n", 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0992f460-b24c-48c2-be0b-b415e7350b06"],

Cell[BoxData["19"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"65571b68-6735-49a9-b10e-715fae02987e"]
}, Open  ]]
}, Open  ]],

