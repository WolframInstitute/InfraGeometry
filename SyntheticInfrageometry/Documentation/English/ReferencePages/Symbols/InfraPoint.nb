60cd9b065eb1"],

Cell[TextData[{
 "The vertex label is carried verbatim, including a list label such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "j"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9db3ea40-1d85-4599-bab4-aa13f56e1010"],
 " on a grid or tessellation."
}], "Notes",ExpressionUUID->"87da79d7-a3a1-4ce0-9fa2-c2e5a925a4cd"],

Cell[TextData[{
 "Invariants are functions of the graph and a vertex, not accessors: ",
 Cell[BoxData[
  RowBox[{"BallVolumes", "[", 
   RowBox[{"g", ",", " ", "v", ",", " ", 
    RowBox[{"{", 
     RowBox[{"rmin", ",", " ", "rmax"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f54de378-23cd-48ca-a5fb-00232989f1d6"],
 " gives the bare numbers for one vertex, and one row per vertex for a vertex \
list."
}], "Notes",ExpressionUUID->"118e17cb-1e04-4c43-a2a0-1cdf1cea077e"]
}, Open  ]],

