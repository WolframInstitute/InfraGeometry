    BoxData["\"\<Inflate\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d15ee031-feb7-434a-ba23-8447ccb25c97"]], "TableText",ExpressionUUID->
     "eac6b1ac-f64f-41d7-a4c4-2d0fe3072831"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
