Cell[TextData[{
 "The three tilings of the plane are cut from the infinite tiling as \
graph-distance balls. The three tori are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TorusTessellation"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/TorusTessellation", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aef02ed4-06e3-486d-9dbe-a8ad682eb8d5"],
 " graphs placed on a torus of revolution."
}], "Notes",ExpressionUUID->"a4b82212-b082-495e-821c-850157ed6e98"],

Cell[TextData[{
 "A Wolfram-model universe is named ",
 Cell[BoxData["\"\<wm\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "303d04e4-9814-458a-a70c-e51f1df6fb5b"],
 " followed by its number in the Registry of Notable Universes. Any of the \
947 entries resolves, through ",
 Cell[BoxData[
  RowBox[{"ResourceFunction", "[", "\"\<WolframModelData\>\"", "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60c0abae-3d20-4d4d-a566-8ffb7b85ac09"],
 ", so this needs the network."
}], "Notes",ExpressionUUID->"1f61f160-ffaa-4b1f-b35f-8a0bc01114a5"],

Cell[TextData[{
 StyleBox["size", "TI"],
 " may also be a raw value: the cell measure of a mesh, the radius of a \
tiling, the dimensions of a grid, the generation count of a Wolfram model or \
a fractal."
}], "Notes",ExpressionUUID->"50ab8158-514d-4646-bd95-f11735d07613"],

Cell[TextData[{
 "A substrate is ",
 StyleBox["bare combinatorics",
  FontWeight->"Bold"],
 " by default. A stored embedding is discarded, and a spring layout of the \
substrate's own dimension places the vertices. ",
 Cell[BoxData[
  RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88ac60ee-bc29-485e-ad28-1a189c632052"],
 " draws the substrate where it lives. Every figure on a patch of the plane \
sets it."
}], "Notes",ExpressionUUID->"827707ba-a455-4c62-bc92-c23a9454f4b1"],

Cell[TextData[{
 "A patch has a rim, and the rim is not geometry. Anchor a construction at \
the centre, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCenter"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraCenter", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f2123311-8e9a-4903-a7f3-9bed047c9299"],
 ", and keep it well inside the patch, or the figure shows boundary effects."
}], "Notes",ExpressionUUID->"cf85900a-56ea-4f3a-ac66-b045b9b64c6e"],

Cell[TextData[{
 "A substrate built by a random construction \[LongDash] a uniform-length \
ellipsoid, or any substrate with ",
 Cell[BoxData["\"\<Inflate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72f02b28-5f00-46f7-b7ae-50be71e233be"],
 " \[LongDash] is seeded from outside. ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76b57c93-b191-4846-94a2-3b469f8382c1"],
 " in front of the call gives the same graph again."
}], "Notes",ExpressionUUID->"79f9a048-38a7-4b9f-b09f-08031422135a"],

Cell["Options:", "Notes",ExpressionUUID->"6814212d-38b9-48d0-bd71-b129541977f9"],

