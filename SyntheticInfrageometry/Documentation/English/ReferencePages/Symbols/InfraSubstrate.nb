      FontSize->0.9 Inherited,ExpressionUUID->
      "5884e03b-6dd8-4977-b8a0-58ae7da759ed"],
     " draws the substrate in its own embedding"
    }], "TableText",ExpressionUUID->"f5e1ff8b-998c-427e-a6e5-55e52f00ebec"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
