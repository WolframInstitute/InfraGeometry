Cell[TextData[{
 "By default the discretized square is laid out by springs. With ",
 Cell[BoxData[
  RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bfe3fade-d6dd-4768-9eb2-77876910a27b"],
 " it is drawn in the unit square it was cut from."
}], "ExampleText",ExpressionUUID->"f437a8b8-b310-45f2-b22e-1d7005e5272d"],

