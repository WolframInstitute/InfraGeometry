   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "61693782-b0da-48ac-80ac-c7ba5053f82a"],
 " graph, placed in space."
}], "ExampleText",ExpressionUUID->"93f0a7df-13ce-46c5-93a6-2bcaa33b4eae"],

