     "fe0065bc-6a23-4b89-b963-7c21a719392f"], Cell[TextData[{
     "a number of extra vertices over every vertex, a range ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"min", ",", " ", "max"}], "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "896331c9-6981-4218-9fd6-c6fc05a8302f"],
