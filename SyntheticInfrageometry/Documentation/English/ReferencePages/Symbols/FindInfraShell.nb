Cell["\<\
The ball is the union of the shells up to its radius, so the volumes are the \
partial sums of the areas.\
\>", "ExampleText",ExpressionUUID->"0cf34833-8773-4eae-97eb-0f8aaaa2524e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"areas", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"FindInfraShell", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"volumes", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"FindInfraBall", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Accumulate", "[", "areas", "]"}], " ", "===", " ", "volumes"}]}],
   "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a4d60699-47e6-4b3c-9e01-102cd8740ef3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"5975a99b-e817-4a60-8d04-86dfc832966f"]
}, Open  ]]
}, Open  ]],

