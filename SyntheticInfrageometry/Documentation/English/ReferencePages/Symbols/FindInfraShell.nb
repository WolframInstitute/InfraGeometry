Cell["\<\
The ball is the union of the shells up to its radius, so the volumes are the \
partial sums of the areas.\
\>", "ExampleText",ExpressionUUID->"988adf08-c9e0-48ec-a292-f97e72c730f7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"areas", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"FindInfraShell", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"volumes", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"FindInfraBall", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Accumulate", "[", "areas", "]"}], " ", "===", " ", "volumes"}]}],
   "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"780c1af2-fa5d-41fc-9d65-164d729367e6"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e0aab770-cdaf-4c78-9b15-a646ec62b63b"]
}, Open  ]]
}, Open  ]],

