Notebook[{

Cell[CellGroupData[{
Cell["FindInfraShell", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"de7c8b2e-a7bf-4388-a5ea-9974725a62e8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraShell"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraShell", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c546d7ad-d716-408b-a652-54ac43750162"],
 "\[LineSeparator]",
 "gives the metric shell ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["v", "TI"], ":", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["c", "TI"], ",", 
       StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
     StyleBox["r", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74e58340-5a8c-4a40-a2a6-8756b990e7c5"],
 " around ",
 StyleBox["c", "TI"],
 " as a sorted vertex list. ",
 StyleBox["r", "TI"],
 " may be a band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"rmin", ",", " ", "rmax"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71c753fc-b87c-445b-969c-8a6eca3a5331"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"326f353a-314d-44d5-ace3-eb44ddb6668a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraShell"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraShell", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15cba76a-a193-4c9f-bc35-6fbd81693485"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9321600-0f6a-4447-bedc-522fa86b1392"],
 " of exactly ",
 StyleBox["n", "TI"],
 " vertex sets or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bb272e3-9395-41a1-bfca-c4a0250b9721"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3df589da-651f-44f4-aa83-7c094ca8aaa3"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f731b6d-dbc3-42a9-924a-570d671d5513"],
 " gives all of them. Under the default ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f60576d3-fff1-412c-9b47-21676d434249"],
 " the level set is the one vertex set."
}], "Usage",ExpressionUUID->"57e3269d-4300-4984-b23a-fe6b3b76fcb0"],

Cell[TextData[{
 "The shell of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["v", "TI"], ":", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["c", "TI"], ",", 
       StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
     StyleBox["r", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a06b91a1-271b-4da8-a366-eaa574daa78c"],
 " \[LongDash] the sphere of the graph metric, as a vertex ",
 StyleBox["set",
  FontWeight->"Bold"],
 "."
}], "Notes",ExpressionUUID->"86a91645-9fb6-4cc8-a356-92d9ee95db03"],

Cell[TextData[{
 "It is the discrete analogue of a sphere, not of a circle: it is \
codimension-1 as a set, but on a lattice its vertices are pairwise \
non-adjacent, so it carries no cycle. The cyclic object is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraCircle"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraCircle", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "99604590-6664-4c2a-923d-da9aeedf0d43"],
 ", which needs a thickened band for exactly that reason."
}], "Notes",ExpressionUUID->"da7e59b9-ac27-4255-84c0-b6ecc368bdea"],

Cell[TextData[{
 "The shell is the substrate of the volume-growth invariants. Its cardinality \
as a function of ",
 StyleBox["r", "TI"],
 " is the surface-area profile, and on a flat lattice it grows ",
 StyleBox["linearly",
  FontWeight->"Bold"],
 ", which is the statement that the dimension is 2. The slope is a property \
of the tiling: 4 per step on the square grid, 3 on the hexagonal."
}], "Notes",ExpressionUUID->"b7d6ba51-9fc9-4d55-8c67-aa9079d43dd4"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd2c067a-e91c-480c-b037-25e2a787578e"],
 " takes ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb809d28-2a40-48c8-8bb5-d1a395e683c9"],
 " (default; the whole level set as one vertex set), ",
 Cell[BoxData[
  RowBox[{"{", "\"\<Separating\>\"", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d21db7d-83cb-4367-989b-11f39ceb65c2"],
 " (inclusion-minimal subsets separating the centre from beyond), or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ca06999-ac3f-43cf-8a84-d1eadf458f19"],
 ". Option ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ffe8331-39a2-496b-a364-cb7f929ad5c4"],
 " takes ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eda3fda7-6cf5-4fa9-9316-e96ca058c893"],
 " (default), ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dea91a37-50dc-4272-b683-1e987fc9d94f"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
    RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cfa11722-1cab-4d40-8c6b-69e95d16d016"],
 ", ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d29d6ba4-2918-4cb4-8a06-b44f22e96d20"],
 " or ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84de03b1-13af-4402-9949-31dc4c5513a2"],
 ", and is read only when ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dc42b52-fd9f-4f0a-8e9e-38bcb8b84575"],
 " names a class to search: ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "394a411f-69c2-4050-bcdc-306e34e6ef15"],
 " resolves by the count \[LongDash] ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba652c95-4f96-4f31-94a0-68ed817095c5"],
 " to ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67f1d8a5-d0a9-47d7-a3d1-56c7de9500e8"],
 "; a bounded or absent count to ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c597f59-7490-4cb3-b5f4-d5c5d920ea02"],
 ", the lazy peel, so the count-less call is one minimal subset, \
deterministic \[LongDash] and the class is the same under every value. ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d06dffcd-fc44-4e66-ba71-1eb42333e2d4"],
 " peels in random order, seeded by an ambient ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b27c1081-aaf4-4c07-9684-090bd913e15e"],
 "; ",
 Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3384659c-97ba-441f-8eca-da00bece8995"],
 " caps the removable vertices tried per layer, and the result is then \
minimal among the survivors. The ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Volume\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dfb95f3b-0413-4f45-b09a-c8dadb717fec"],
 " accessor gives the per-realisation vertex count as a list."
}], "Notes",ExpressionUUID->"6c8f00b3-38da-4629-b9e9-0596fef21ae0"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"bc6f96dd-c606-43f5-98b0-b556d8600c90"],

