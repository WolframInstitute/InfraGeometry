Notebook[{

Cell[CellGroupData[{
Cell["FindInfraPerpendicular", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ff618c35-8c2b-4aaa-b41f-aa93e88d0672"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPerpendicular"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
FindInfraPerpendicular", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["point", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "513f5d8a-7686-4b86-bd19-508574adb7f3"],
 "\[LineSeparator]",
 "gives the lines through ",
 StyleBox["point", "TI"],
 " perpendicular to ",
 StyleBox["line", "TI"],
 ", as a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a21a5fb-a5eb-44d3-8ae3-539a414496ef"],
 " of directed path graphs.",
 "\n",
 "A count ",
 StyleBox["n", "TI"],
 " gives exactly ",
 StyleBox["n", "TI"],
 " or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7438950c-5aad-42d0-8626-2303ebc94826"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5575bb4e-f41e-4d07-b3f0-2884efa919e7"],
 " up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82fc69ec-5021-4a11-8ec2-64b2b114cbfc"],
 " all of them."
}], "Usage",ExpressionUUID->"05cf1ef2-1163-4eae-abf9-6bec6cf89858"],

Cell[TextData[{
 "Definition, with the default ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Metric\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f68a223b-9d9f-4a94-9d05-548c8e9b53e2"],
 ": this is Euclid I.12. Take an isosceles base on the line, find its \
midpoint \[LongDash] the foot \[LongDash] and return the maximal lines \
through the foot and the point."
}], "Notes",ExpressionUUID->"f7f0906c-1a7e-4dc0-b906-051c49bb2e83"],

Cell["Two consequences follow from that construction.", "Notes",ExpressionUUID->"721a78b7-20b4-4169-bd41-02a4db4994fc"],

Cell[TextData[{
 "It returns nothing when ",
 StyleBox["point", "TI"],
 " lies ",
 StyleBox["on",
  FontWeight->"Bold"],
 " ",
 StyleBox["line", "TI"],
 ". The construction needs a foot distinct from the point, and there is none. \
Erecting a perpendicular at a point of the line is Euclid I.11, a different \
proposition."
}], "Notes",ExpressionUUID->"48a3da45-2cad-4f6c-8ae6-2591c2f21ba1"],

Cell[TextData[{
 "The count is very large. On an 81-vertex square patch, a point off a line \
admits 6381 perpendiculars. This is the same combinatorial explosion as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraLine"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraLine", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1961a9bb-084d-4170-84d5-a3b99ecd646e"],
 ", and it has the same cause: a maximal geodesic on a lattice has many \
admissible continuations."
}], "Notes",ExpressionUUID->"8ff16723-e173-458a-9b14-cf0fe5ecc09f"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["\"\<Radius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2a71ba4-8d4d-4602-9012-37adde99f5f1"],
 " is the lever that makes it usable. ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "91c4e7ba-3b3f-4306-9ff3-0d9f32b8d219"],
 " localises both the candidate enumeration and the test to the ",
 StyleBox["r", "TI"],
 "-neighbourhood of the point. On that same patch the count falls to 110 at \
radius 3 and 26 at radius 2. Perpendicularity is a local notion, so \
localising it is not a compromise."
}], "Notes",ExpressionUUID->"92b26a9d-161c-4954-9685-b1fbe57b11b9"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1020fdff-a6bf-4b2e-a075-cb5d67611cac"],
 " also takes the ",
 Cell[BoxData["Q"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "456f786d-c8e7-4034-bedc-6c64f5bd32e1"],
 "-side families \[LongDash] ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0f1b895-cb95-4338-9830-283f10c648a8"],
 ", ",
 Cell[BoxData["\"\<Coordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33413a28-38b6-4fa2-b730-cb6cc660c73d"],
 ", ",
 Cell[BoxData["\"\<Arclength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16ea00d1-af1c-43ab-900a-488a0a3f0fb8"],
 ", ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "babc9d0c-c3b2-4168-b4b6-baefa02ab3ad"],
 " \[LongDash] which enumerate maximal geodesics through the point and filter \
them with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "babf7d41-cf5f-4338-b306-418278a365de"],
 ". Sub-options belong inside the method spec and are passed through."
}], "Notes",ExpressionUUID->"0e05635a-d4aa-4dcd-8321-377067e50be7"],

Cell[TextData[{
 "The result need not satisfy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5e679bf1-a602-476e-ae0b-c5eb7691e8e1"],
 " under its default settings. The default ",
 Cell[BoxData["\"\<Metric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffbe0817-5ba2-410f-b4ef-f0077c58c6f4"],
 " construction is Euclid's, while the predicate tests a projection \
condition, and on a lattice the two do not coincide. See that page for which \
equality setting reconciles them."
}], "Notes",ExpressionUUID->"a5724c45-7f70-4bc2-b8f8-3500e28b2418"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"23157a62-9c8d-4d10-b44f-5464b9103248"],

