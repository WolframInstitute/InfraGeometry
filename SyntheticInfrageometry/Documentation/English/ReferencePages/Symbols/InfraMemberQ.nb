Notebook[{

Cell[CellGroupData[{
Cell["InfraMemberQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d6c3b0e1-f864-4b67-a5b8-e4b522fba77b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMemberQ"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMemberQ", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", 
    StyleBox["path", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "654060e1-4708-4573-a111-0c55e03fdeb6"],
 "\[LineSeparator]",
 "tests whether the vertex list ",
 StyleBox["path", "TI"],
 " is a member of the Euclidean head ",
 StyleBox["obj", "TI"],
 " on ",
 StyleBox["graph", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"f9682eb1-59c5-4213-821a-3a623ec877db"],

Cell[TextData[{
 StyleBox["path", "TI"],
 " is a member exactly when it is a source-to-sink chain of ",
 StyleBox["obj", "TI"],
 "'s graph \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMeasurement", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "032c2249-8e44-41e6-b391-a051b023cc34"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"graph", ",", " ", "obj", ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fc37252-fdf6-4941-84ec-c59072555d35"],
 " \[LongDash] for a circle, up to rotation and direction. ",
 Cell[BoxData["InfraMemberQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b16885c7-1b7a-436d-8c7a-3b4d517f2448"],
 " agrees with ",
 Cell[BoxData["InfraVertexList"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39cf5496-d32e-4a02-bdd9-4513146591cd"],
 " by construction: every vertex list ",
 Cell[BoxData["InfraVertexList"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54abe400-8f14-4b77-8d85-ecf355e51788"],
 " returns passes ",
 Cell[BoxData["InfraMemberQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b78d525-9463-4cad-9474-2494a0c39f3a"],
 ", and conversely."
}], "Notes",ExpressionUUID->"cbf1b3ce-18cb-4450-b68f-415631bc2e6f"],

Cell[TextData[{
 "Unlike ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegmentQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegmentQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "430392a8-f3f2-41d9-ba49-3a60cbe53c6c"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLineQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraLineQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b94b0297-7ae6-4abb-8874-b2470bf83799"],
 ", which test ",
 StyleBox["path", "TI"],
 " against the general definition of the class on ",
 StyleBox["graph", "TI"],
 ", ",
 Cell[BoxData["InfraMemberQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "224b9ff1-511c-43d0-9d3c-8157d6b9d04f"],
 " tests it against one specific head \[LongDash] so it also distinguishes, \
say, one line through two points from another line through the same points on \
a graph where several exist."
}], "Notes",ExpressionUUID->"8fc56089-0f9e-4681-9434-31b7714c18a6"]
}, Open  ]],

