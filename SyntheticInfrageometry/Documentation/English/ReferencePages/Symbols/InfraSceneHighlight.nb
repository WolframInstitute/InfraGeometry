    StyleBox["g", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "775f745a-86f6-4051-a160-ebf6337c5462"],
 "\[LineSeparator]",
 "draws a single object."
}], "Usage",ExpressionUUID->"3c502c52-dccd-4a39-9937-94f37a3b1f3f"],

Cell["\<\
This is the only rendering primitive in the paclet. Every viewer and every \
figure calls it.\
\>", "Notes",ExpressionUUID->"71f48ae9-a10c-4b98-b400-a275990649f2"],

Cell["\<\
The principle is diffuse rendering. A construction is a family, not a choice. \
So the picture shows the whole family, and multiplicity sets the intensity. \
An edge on many geodesics is drawn strongly. An edge on few is drawn faintly. \
No single realisation is privileged.\
\>", "Notes",ExpressionUUID->"c3b1f56b-5dcc-4522-a5aa-ff80586f3598"],

Cell[TextData[{
 "Objects are given as ",
 Cell[BoxData[
  RowBox[{"obj", " ", "->", " ", "style"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20a1a898-0922-42ec-b3a1-1a54a7d708ae"],
 " entries: a vertex, a vertex list, a list of vertex lists, a density or a \
walk graph. With no style, the colour comes from the shape via ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$InfraPalette"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/$InfraPalette", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f06d048e-3942-43d7-a6e2-11f5070e6fd5"],
 ". The Euclidean heads \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4f72f971-2cf6-45c8-b6a2-798f6b978a16"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraCircle", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9a24628a-832b-44f2-85a0-883dc0d4ccae"],
 " and the rest \[LongDash] are inert and are not drawn directly: draw their \
members, from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraVertexList", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "86c249cc-8343-47b0-a70b-50c22b663679"],
 ", or their ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0642d83-b8d7-40a5-95a3-7c2b8cf226b7"],
 "."
}], "Notes",ExpressionUUID->"30878d60-81a7-42e2-8ef7-44f72c97608a"],

