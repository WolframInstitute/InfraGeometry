Cell[CellGroupData[{
Cell["InfraSceneHighlight", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4331fc2c-8303-455a-ba3f-f469f043c658"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSceneHighlight"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSceneHighlight",
      "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["multiObjects", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9062298c-0175-4f6c-9323-5bdad34bd1df"],
 "\[LineSeparator]",
 "draws multi-objects on ",
 StyleBox["g", "TI"],
 ". Intensity follows multiplicity. Colours blend across objects.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8ff7b1e7-5871-4073-8a40-77ece86f0414"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSceneHighlight"]], 
