Cell[TextData[{
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81207d1f-30b5-4796-8fef-1d913eaf4ccb"],
 " turns diffusion off and draws every realisation alike. A scalar sets the \
base measure. A pair sets the envelope."
}], "Notes",ExpressionUUID->"658cdf41-49e6-44ac-abb8-197a672b4336"],

Cell[TextData[{
 "A per-object override goes on the right of the arrow: a colour, a ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "754a828b-4131-4c2a-ab00-a6cfdec2564d"],
 ", or a list of options. Bare directives are routed by family. Thickness and \
dashing go to edges. Point size goes to vertices. Colours and opacity go to \
both."
}], "Notes",ExpressionUUID->"f7d9760a-41d2-4aa1-be21-85432d7826f4"],

Cell["Two things to watch.", "Notes",ExpressionUUID->"310963c7-d186-4655-b58b-b97f9d335ff2"],

Cell[TextData[{
 "An explicit appearance directive suppresses the matching diffusion. A ",
 Cell[BoxData["Thickness"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b40666cf-009a-4d9c-a4a7-160b4e959c6d"],
 " directive turns off ",
 Cell[BoxData["\"\<ThicknessRange\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96d0d721-ad27-4250-9616-9d3ff7115aa8"],
 ", and the multiplicity information with it."
}], "Notes",ExpressionUUID->"a41f587f-8d59-4656-8bbf-c6f1138fd4a9"],

Cell[TextData[{
 "Ambient styling belongs on the graph, not here. Use ",
 Cell[BoxData[
  RowBox[{"Graph", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"Sequence", " ", "@@", " ", 
     RowBox[{"InfraSubstrateStyle", "[", "\"\<Gray\>\"", "]"}]}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34b248e2-a74a-4f45-802b-fa38dca1c433"],
 ", and set uniform dot size top-level with ",
 Cell[BoxData["VertexShapeFunction"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "571793d9-8c79-434f-9666-355075f17798"],
 ". A per-entry ",
 Cell[BoxData["AbsolutePointSize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "475ce350-868a-44c0-a6e0-62865673879e"],
 " inside the highlight list has no effect."
}], "Notes",ExpressionUUID->"2e8028e9-f69a-41a9-bf83-091da9c594a7"]
}, Open  ]],

