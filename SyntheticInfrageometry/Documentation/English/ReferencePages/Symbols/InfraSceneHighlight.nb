Cell[TextData[{
 "The same bundle at three opacity settings. ",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50121ff8-7ac8-45ad-b721-d6de2e981a26"],
 " draws every geodesic alike. A wider envelope exaggerates the contrast."
}], "ExampleText",ExpressionUUID->"6855dd2e-bb88-481a-a08b-ce803e2fcb04"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "     ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",",
           " ", "\"\<Gray\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "     ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
      "     ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"Sort", " ", "@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"GraphDistance", "[", 
               RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
              " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
      "     ", 
      RowBox[{"Labeled", "[", "\n", "       ", 
       RowBox[{
        RowBox[{"InfraSceneHighlight", "[", 
         RowBox[{"g", ",", "\n", "         ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"FindInfraSegment", "[", 
             RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], 
             "]"}], " ", "->", " ", "$InfraSegmentColor"}], "}"}], ",", "\n", 
          "         ", 
          RowBox[{"\"\<OpacityRange\>\"", " ", "->", " ", "spec"}], ",", "\n",
           "         ", 
          RowBox[{"VertexShapeFunction", " ", "->", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"AbsolutePointSize", "[", "2", "]"}], ",", " ", 
               RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}],
           ",", "\n", "         ", 
          RowBox[{"ImageSize", " ", "->", " ", "240"}]}], "]"}], ",", "\n", 
        "       ", 
        RowBox[{"Text", "[", 
         RowBox[{"ToString", "[", "spec", "]"}], "]"}]}], "]"}]}], "]"}], ",",
     "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"spec", ",", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.4", ",", " ", "1."}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.05", ",", " ", "1."}], "}"}]}], "}"}]}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6a374687-d3f0-4d5e-9428-63abf75a64e4"],

