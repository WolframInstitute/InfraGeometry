Cell["\<\
Through an edge of the 6-cycle there are three lines, one per DAG.\
\>", "ExampleText",ExpressionUUID->"0beb0686-8b48-4a22-b1d9-5bfccfccb1ac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
