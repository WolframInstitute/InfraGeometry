Cell["\<\
The anchors lie on every line, so their density is the cardinality.\
\>", "ExampleText",ExpressionUUID->"cfd1f56b-f3f3-4f58-8ffa-5336ac110516"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"density", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraLine", "[", 
        RowBox[{"6", ",", " ", "7"}], "]"}], ",", 
       " ", "\"\<VertexDensity\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"density", "[", "6", "]"}], ",", " ", 
     RowBox[{"density", "[", "7", "]"}], ",", " ", 
     RowBox[{"density", "[", "1", "]"}]}], "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6d9e2e74-26e7-4821-aca3-f76cbfced6bf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"12", ",", "12", ",", "6"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"81e0b55c-bde5-46bf-a562-b2044bd10efd"]
}, Open  ]],

