  FontSize->0.9 Inherited,ExpressionUUID->
  "2a93677e-dcc6-42c5-83de-8c7bb41e1c4e"],
 "\[LineSeparator]",
 "is the line through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ": every inextensible geodesic through ",
 StyleBox["p", "TI"],
 " and then ",
 StyleBox["q", "TI"],
 ". It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMeasurement", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
