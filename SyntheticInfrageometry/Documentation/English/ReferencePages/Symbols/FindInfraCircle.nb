Cell["\<\
A circle lies in its band, and its last vertex is adjacent to its first.\
\>", "ExampleText",ExpressionUUID->"e470cdaf-4122-4c76-b548-b81dc52d0d6f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"FindInfraCircle", "[", 
      RowBox[{"g", ",", " ", "41", ",", " ", 
       RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "4"}], "}"}]}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"SubsetQ", "[", 
      RowBox[{
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "41", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", "circle"}], 
      "]"}], ",", " ", 
     RowBox[{"EdgeQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"UndirectedEdge", "[", 
        RowBox[{
         RowBox[{"Last", " ", "@", " ", "circle"}], ",", " ", 
         RowBox[{"First", " ", "@", " ", "circle"}]}], "]"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b9cb74f3-32fd-450a-877b-447d5931ca38"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"5eb81f0b-db9c-4456-8996-c624f8e5aec5"]
}, Open  ]],

