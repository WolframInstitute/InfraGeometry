Notebook[{

Cell[CellGroupData[{
Cell["FindInfraCircle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c456baad-d5d1-4d27-9a59-c041fbac0eb1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraCircle"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraCircle", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "efe3b95e-bc5c-44e9-9de5-a94313755e27"],
 "\[LineSeparator]",
 "gives one circle around ",
 StyleBox["c", "TI"],
 " through the point ",
 StyleBox["p", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ", as a cyclic vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a980e1a7-a809-41c9-9df7-6d3b8234b0e6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraCircle"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraCircle", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
     StyleBox["r", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "267fd410-d702-442d-bc40-2972d2f0e502"],
 "\[LineSeparator]",
 "gives one circle around ",
 StyleBox["c", "TI"],
 " at radius ",
 StyleBox["r", "TI"],
 "; ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"r", ",", " ", "s"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b576079-1bc3-4a29-932c-e24ace2194d0"],
 " takes the band ",
 StyleBox["r", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["s", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f1fd9e4f-f389-467e-a63c-331220ff943b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraCircle"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraCircle", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["spec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e75f0d8-fadb-4f16-98b2-e100b8ab853d"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b2e5135-008a-4c79-b843-a8f1aefe3595"],
 " of exactly ",
 StyleBox["n", "TI"],
 " circles or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eefb9fff-4165-4bee-8a4c-4a589a19eb57"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56f9aaef-9bc0-4283-bbfa-fd590dc81ac7"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8bfd782-0d57-46a4-b8f9-ca5d8cac1a91"],
 " gives every circle."
}], "Usage",ExpressionUUID->"6f7155df-c7c2-4e4b-83c1-2d048397bd44"],

Cell[TextData[{
 "The band around ",
 StyleBox["c", "TI"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["v", "TI"], ":", 
     StyleBox["r", "TI"], "\[LessEqual]", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["c", "TI"], ",", 
       StyleBox["v", "TI"]}], ")"}], "\[LessEqual]", 
     StyleBox["s", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b08b5cb3-bb0a-4bef-a426-b944a7a393b4"],
 ". A circle is a shortest cycle of the subgraph induced on the band whose \
removal leaves ",
 StyleBox["c", "TI"],
 " in a component reaching no further than the band. The point form takes the \
band at ",
 StyleBox["d(c, p)", "TI"],
 " and keeps the circles through ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"9eb9f078-972c-4927-bf89-68f8666cd913"],

Cell["\<\
A circle is returned as a cyclic vertex list: the edge from the last vertex \
back to the first is implicit, and the first vertex is not repeated.\
\>", "Notes",ExpressionUUID->"1abb3a58-26df-4f54-8d7d-55a0150fddf9"],

Cell[TextData[{
 StyleBox["A circle need not exist.",
  FontWeight->"Bold"],
 " On a lattice a single distance shell contains no two adjacent vertices, so \
it spans no cycle at all and the result is empty. This is not a defect of the \
definition \[LongDash] it is what a sphere of one-vertex thickness is on a \
lattice."
}], "Notes",ExpressionUUID->"9b72e6a2-1b8f-457d-ae78-d41fa2c7a7e7"],

Cell[TextData[{
 "Thickening the radius to a band fixes it, and ",
 StyleBox["the band thickness that suffices tracks the girth of the tiling",
  FontWeight->"Bold"],
 ". On the square grid, girth 4, a two-thick band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", 
    RowBox[{"r", "+", "1"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "407fb135-f029-4249-acd4-6afef49cb09d"],
 " already carries a cycle. On the hexagonal tiling, girth 6, it does not: ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", 
    RowBox[{"r", "+", "1"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f425f6d-cd9a-445e-a8c9-1c44b0928563"],
 " is still empty and the band has to reach ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", 
    RowBox[{"r", "+", "2"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5abb871e-6702-4ed0-92b9-80f7d1f72729"],
 ". On an irregular mesh a single shell usually works, since its vertices are \
adjacent by accident of the triangulation."
}], "Notes",ExpressionUUID->"4700be82-ccbe-4d5f-8aa7-77c5c64e2b1f"],

Cell[TextData[{
 "The search sweeps the band directly, length by length with ",
 Cell[BoxData["FindCycle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17f215a1-b960-4eef-af51-ea550f26c768"],
 ". It does not read the necklaces of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraCircle", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "380c0046-d678-4ff1-9e61-a7bc1b909791"],
 ", so it is the check on them, and it still answers where no seam cuts the \
band open, or where nothing lies beyond the band and separation is vacuous. \
It returns exactly the shapes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraVertexList", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e8b781f3-ce15-42c1-b863-300bedf1ac96"],
 " gives for that head. To count circles without enumerating them, use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMeasurement", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7b0f8ece-1220-46b5-b0c3-fc07a52792b9"],
 "."
}], "Notes",ExpressionUUID->"24b1aa0c-3841-42d4-aaea-9cbc5b10ae73"],

Cell[TextData[{
 "Option ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "104220f8-dd3d-42e8-8906-1b4350716e3a"],
 " widens the band of the point form to ",
 StyleBox["d(c, p)", "TI"],
 " \[Minus] ",
 StyleBox["deltaIn", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, p)", "TI"],
 " + ",
 StyleBox["deltaOut", "TI"],
 ". A scalar ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "delta"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c29ae70d-62ff-4ce9-8970-e4f94f21decb"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af2ca964-a07e-4608-adf3-a3c02cc74d83"],
 ", outward only. The default is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d585620-129d-4db4-9617-d25cbfaa54cf"],
 ". There is no ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3964de45-77c2-4099-af76-37af2b717dab"],
 " and no ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "765670aa-ac6d-4777-bd43-37d4c02fbc62"],
 "."
}], "Notes",ExpressionUUID->"15730fee-0568-49f4-8b58-e237c3610957"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"d6c13834-1357-4889-a12c-8c80d2cca689"],

