Cell[TextData[{
 "Searches the band graph directly \[LongDash] ",
 Cell[BoxData["FindPath"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13733f39-6e78-4ae4-8420-5df1dcaa9a38"],
 " at the band distance between consecutive points, folded together at the \
knots \[LongDash] independently of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraArc"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraArc", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dded40b1-02ae-4cdb-8769-a7f6f7d13b2b"],
 "'s own graph, so it is the check on that graph rather than a reader of it: \
it answers even where the band has no seam to cut open. Returns exactly the \
vertex-list shapes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraVertexList", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dea7c8be-859c-436c-a282-7db5538d48ab"],
 " gives for ",
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p1", ",", " ", "...", ",", " ", "pk"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6c63287-585a-405d-a0bd-050493b1da15"],
 "."
}], "Notes",ExpressionUUID->"66e13d5b-defc-42e5-814d-5248aa0e8e59"],

