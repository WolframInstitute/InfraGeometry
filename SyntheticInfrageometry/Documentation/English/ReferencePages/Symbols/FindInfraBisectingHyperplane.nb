Notebook[{

Cell[CellGroupData[{
Cell["FindInfraBisectingHyperplane", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"65375d6c-8eff-4e7c-acea-e448e95e785a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
FindInfraBisectingHyperplane", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12609a9e-f9a3-48a5-8e59-bcdf87ec3c9d"],
 "\[LineSeparator]",
 "gives the perpendicular bisector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["v", "TI"], ":", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["p", "TI"], "1"], ",", 
       StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["p", "TI"], "2"], ",", 
       StyleBox["v", "TI"]}], ")"}]}], "}"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6d6fe30-1083-455b-a3b3-701bff3f2e62"],
 " as a sorted vertex list. A positional ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e5ebc07-57a6-4903-969b-f995788d1dd2"],
 " widens it to the slab ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["l", "TI"], 
    StyleBox["o", "TI"], "\[LessEqual]", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], "1"], ",", 
      StyleBox["v", "TI"]}], ")"}], "-", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], "2"], ",", 
      StyleBox["v", "TI"]}], ")"}], "\[LessEqual]", 
    StyleBox["h", "TI"], 
    StyleBox["i", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b782ae0-a83f-417d-bfb4-5372c490c8aa"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4e42c980-37cd-45b8-8ae2-9096f1867fbf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
FindInfraBisectingHyperplane", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84d21b22-2b07-42fd-9f09-81ea17bbfb74"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ee7804c-1de7-4a4f-a693-35f1be4b90af"],
 " of exactly ",
 StyleBox["n", "TI"],
 " vertex sets or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7b8e8ee-7607-47c6-ab68-e96484bb73d7"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b00ecb7-0f8d-49b0-ae01-bafb15311963"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "782ca302-c55b-4fcd-a716-42bb03ba0a92"],
 " gives all of them. Under the default ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48555397-770f-4aac-9495-7c9de5de88fa"],
 " the slab is the one vertex set."
}], "Usage",ExpressionUUID->"63558713-5b5f-4190-af2e-ea0606205cc6"],

Cell[TextData[{
 "The bisector of ",
 StyleBox["p1", "TI"],
 " and ",
 StyleBox["p2", "TI"],
 " is the set of vertices equidistant from both. It is the codimension-1 \
object of the metric: in the plane a line, here a vertex set."
}], "Notes",ExpressionUUID->"c54cfe8a-1976-42ac-b089-4d433869aceb"],

Cell[TextData[{
 StyleBox["It is empty at odd distance.",
  FontWeight->"Bold"],
 " If ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], "1"], ",", 
     SubscriptBox[
      StyleBox["p", "TI"], "2"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ba61312-1c48-4292-9c1e-6b68f2c7844e"],
 " is odd then no vertex can be equidistant from both, since the two \
distances would have to be equal halves of an odd number. Below, two vertices \
at distance 6 on a square grid have a 21-vertex bisector, while at distance 5 \
the bisector is empty. This is the same parity obstruction that makes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraMidpoint"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraMidpoint", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6b25726e-61f8-4949-bd2c-595612cf1c46"],
 " return the two central vertices of each geodesic at odd distance, seen one \
dimension up."
}], "Notes",ExpressionUUID->"d21f5b6f-7563-49ac-8717-89b2df830dd7"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3be187c-84f1-4034-a39f-beb9d7ca4224"],
 " slab is the repair: widening to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "1"}], "\[LessEqual]", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], "1"], ",", 
      StyleBox["v", "TI"]}], ")"}], "-", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], "2"], ",", 
      StyleBox["v", "TI"]}], ")"}], "\[LessEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cfc1258f-67be-4fcf-9b25-c0d6982327a7"],
 " catches the vertices that straddle the bisector and is non-empty at either \
parity."
}], "Notes",ExpressionUUID->"8ece20bc-1c27-4f25-abb6-44b925a62403"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0aeef495-7d6d-400e-b5d4-23aafb00ab1f"],
 " takes ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f95f6f5-ba9d-4161-b042-e94e5c12fd1f"],
 " (default; the slab itself as one vertex set), ",
 Cell[BoxData[
  RowBox[{"{", "\"\<Separating\>\"", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "283a4328-1ec3-44f4-aa53-6df807fde2fe"],
 " (inclusion-minimal subsets that disconnect ",
 StyleBox["p1", "TI"],
 " from ",
 StyleBox["p2", "TI"],
 "), or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a4278dc-7d9d-4a3b-a87b-bb1dd943ae54"],
 ". Option ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a47090e-0be1-482b-97d0-887423893ac9"],
 " takes ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79c5f241-e0ee-44af-9c34-bbecffd07fcd"],
 " (default), ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a608ba1b-7a7e-435d-b588-65225fcbd118"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
    RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c061e66-d1c0-4ad7-9af8-6f0cd71910ea"],
 ", ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db76aa9c-844e-48e3-aa98-a6d071889cd3"],
 " or ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ab27d34-81f8-4e51-8aa6-0a6cb239e08a"],
 ", and is read only when ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ef28fdf-de82-43a0-a653-c19a7dcceb72"],
 " names a class to search: ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "861153e3-caa7-44e5-b34a-9528e7fa7ea2"],
 " resolves by the count \[LongDash] ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9a49a62-9ac3-4f39-89de-dc0ee3547ad7"],
 " to ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e581264d-aec7-4b45-9dd5-140b364cf304"],
 "; a bounded or absent count to ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7bc2187-da84-4bc2-a36d-cbeb7b3bb38a"],
 ", the lazy peel, so the count-less call is one minimal subset, \
deterministic \[LongDash] and the class is the same under every value. ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f41f64f-e792-4671-9a8c-39da91ee8b75"],
 " peels in random order, seeded by an ambient ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99cbf3c7-1d5a-4c4d-a900-0e90ee5d7130"],
 "; ",
 Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f993f54-69fb-4b90-a4d8-30eb35dc1719"],
 " caps the removable vertices tried per layer, and the result is then \
minimal among the survivors."
}], "Notes",ExpressionUUID->"dcef6250-1590-469e-b23c-28aefcb981ea"],

