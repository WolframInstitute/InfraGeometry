    "Method"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2e4be626-3fb7-4ac6-82bc-8433bd4ab480"]], "TableText",ExpressionUUID->
     "22c679d5-5cd9-45c5-a8e4-903f628b9d95"], Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "45760a16-4ad9-439c-aa18-b5bc7db68208"],
     " (default), ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "d3fa166e-612c-41c2-8f57-7887ee5e30e9"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
        RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "68c14a84-a053-40ff-8a09-3fed577f5a0a"],
     ", ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "131b8691-3ff8-48fa-b4a5-a5ee0b438183"],
     ", ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0551f0bb-63fa-4125-9b08-52bc0a64d43d"]
    }], "TableText",ExpressionUUID->"a94df8ce-fdbb-455a-a520-bad2a13ee00f"], 
    Cell[TextData[{
     "forwarded to the side geodesics. ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5131895c-6991-4b9f-a06b-a838271593bc"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8ecca6ff-4142-4b35-bccf-65705bce8e9c"],
     " to ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a8146ab2-0baf-4bfe-9aef-3e14b588f357"],
     ", a bounded or absent count to ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7234d4b0-8909-4f26-b9e3-0a805f9e11a2"],
     ". The class is the same under every value; ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0979f07c-b415-43ca-8b3f-1ed08340cb70"],
     " and ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ec6c3044-db76-4f0f-b630-c2a21c1c5a5a"],
     " take each side's geodesics in candidate order, ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9b2a276d-8273-461a-b7cc-d9ebef2dde4b"],
     " in random order, seeded by an ambient ",
     Cell[BoxData["SeedRandom"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9623cf2c-6932-4776-bab5-fbd698403c0f"],
     ". ",
     Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "184b89e5-09cc-48de-b1b5-d8c1de38751d"],
     " is accepted and inert: the sides come off geodesic pools, which have \
no frontier to cap."
    }], "TableText",ExpressionUUID->"125a85fc-aa9d-4732-bab3-ea588114af9e"]}
  }]], "3ColumnTableMod",ExpressionUUID->"c60dc470-8583-406e-b0ae-\
a6f25e633af9"],

Cell[TextData[{
 "Sides chosen by a local rule \[LongDash] straightest, curvature-minimising \
\[LongDash] are not a polygon option: build them with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraGeodesic", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bfbd1476-a222-4977-9b62-01f48f204b49"],
 " and assemble the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52a4b084-77d5-4b61-a0f0-d782b9950bc6"],
 " of sides."
}], "Notes",ExpressionUUID->"4a7e81e7-f7b9-41d2-a91a-36271974da53"],

