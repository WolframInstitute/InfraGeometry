Cell[TextData[{
 "Definition: the viewer solves the scene one step at a time and draws the \
objects bound so far, through ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSceneHighlight"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSceneHighlight", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e91032f9-3961-4eec-9d05-b697bd53d609"],
 "."
}], "Notes",ExpressionUUID->"8ad85cec-12bd-48c6-b8ce-132af1d3e2d1"],

Cell["\<\
It exists because a construction is a sequence, not a picture. Reading Euclid \
I.10 as a single figure hides the order; stepping it shows which object each \
later one depends on.\
\>", "Notes",ExpressionUUID->"0c2b8b3c-9df1-4ff6-b2d0-630309f1a895"],

Cell["Controls, in two rows.", "Notes",ExpressionUUID->"1fee5ece-8423-4187-b932-fdb77668b35e"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7480bfa6-81cb-41bd-aafe-a2f917b9c2e4"], Cell["Control", "TableText",
     FontWeight->Bold,ExpressionUUID->"6a474e2d-cb4f-4bab-95aa-c8a461953c04"],
     Cell["Does", "TableText",
     FontWeight->Bold,ExpressionUUID->"b7bd56c6-c8c4-405a-b698-102f3b5a0981"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e22479ba-57b7-4d0b-a762-0923443a6f41"], Cell[
    "step arrows, label menu", "TableText",ExpressionUUID->
     "19bc4a67-e611-4f66-aa0f-2fdd13cf0278"], Cell[
    "move between construction steps", "TableText",ExpressionUUID->
     "ed539b0d-3e59-4675-81d4-a3aa99aa40bf"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "226c7c19-ca01-45c0-b1b0-71b0c641ecab"], Cell[
    "eye", "TableText",ExpressionUUID->
     "9c85a56f-ef65-41af-b054-cc0882cd1718"], Cell[
    "hide or show the current step's object", "TableText",ExpressionUUID->
     "c2c06016-b20b-4139-971d-17f327978876"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2cc2a185-f097-460a-8080-91eee9fc5ea9"], Cell[
    "Branch / Diffuse", "TableText",ExpressionUUID->
     "80088fa0-e501-4b4f-aa84-8468ac1cc1a5"], Cell[
    "show one realisation, or all of them overlaid", "TableText",
     ExpressionUUID->"7de07219-0779-4ef8-8c10-eb3177434ccc"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d616aa29-9622-4f9f-8b41-3e731e43882d"], Cell[
    "branch arrows", "TableText",ExpressionUUID->
     "874eed33-d003-4563-a216-911c7dafe4a3"], Cell[
    "page through realisations of the current step", "TableText",
     ExpressionUUID->"4e346b05-b08c-458b-8c39-d69560030474"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "abe039cd-7e7a-400f-a182-761a381efff4"], Cell[
    "Fixed", "TableText",ExpressionUUID->
     "07197a1a-0ef8-49af-9d49-6b448881c744"], Cell["\<\
lock the current branch as the starting point for later steps\
\>", "TableText",ExpressionUUID->"4842fe20-cc9f-46fe-8c2c-6dc453dbd1a6"]}
  }]], "2ColumnTableMod",ExpressionUUID->"b6b50d35-81f2-4243-9e0a-\
771f9285ad24"],

Cell["\<\
Branch and Diffuse are the two ways to look at a family. Diffuse draws every \
realisation at once, with intensity following multiplicity, which is the \
right view for seeing where an object is concentrated. Branch picks one, \
which is the right view for following a single construction through to the \
end.\
\>", "Notes",ExpressionUUID->"02d1fd2c-7225-4739-b18a-b415b8f6ac41"],

Cell["\<\
Fixed matters on long constructions. Without it, each step re-solves against \
every branch of the previous ones and the instance count multiplies. Fixing a \
branch collapses that.\
\>", "Notes",ExpressionUUID->"3cc8168b-f965-4a52-9ad0-b1132fcc5df0"],

