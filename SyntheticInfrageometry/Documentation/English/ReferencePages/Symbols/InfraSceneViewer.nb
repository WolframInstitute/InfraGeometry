Cell[TextData[{
 "Definition: the viewer solves the scene one step at a time and draws the \
objects bound so far, through ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraHighlightGraph"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraHighlightGraph", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8f2ae729-fc35-4e1b-a06c-fb9e601aa28f"],
 "."
}], "Notes",ExpressionUUID->"2b479d09-b705-403f-8dc5-01404ec94322"],

Cell["\<\
It exists because a construction is a sequence, not a picture. Reading Euclid \
I.10 as a single figure hides the order; stepping it shows which object each \
later one depends on.\
\>", "Notes",ExpressionUUID->"441f4555-6e95-430c-af01-e2748395f7dd"],

Cell["Controls, in two rows.", "Notes",ExpressionUUID->"32eaade7-203e-4a3b-80c0-472f8b664562"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "00126e74-ea1b-4096-aebc-f63f41ae6fba"], Cell["Control", "TableText",
     FontWeight->Bold,ExpressionUUID->"7f11479f-fcf3-4cb3-b25a-ed976af6a1e5"],
