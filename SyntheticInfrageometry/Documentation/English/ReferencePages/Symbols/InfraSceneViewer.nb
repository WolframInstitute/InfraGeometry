Cell[TextData[{
 "Build a scene and open the viewer on it. The result is a ",
 Cell[BoxData["Manipulate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ec87db0-65f9-4641-a6f7-d8a1abb97862"],
 "."
}], "ExampleText",ExpressionUUID->"e473c49f-f9e0-45fa-bb5a-24eae1ab9260"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "a", ",", " ", "b", ",", " ", "cA", ",", " ", "cB", ",", " ", "u"}], "]"}],
   ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p1", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p2", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "p1", ",", " ", "#"}], "]"}], " ", "==", " ",
          "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "a", ",", " ", "b", ",", " ", "cA", ",", " ", "cB", ",", " ", "u"}], 
        "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "p1", "]"}]}], "}"}], ",", 
           " ", "\"\<point a\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"b", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "p2", "]"}]}], "}"}], ",", 
           " ", "\"\<point b\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"cA", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"a", ",", " ", "4"}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle around a\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"cB", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"b", ",", " ", "4"}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle around b\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"u", " ", "==", " ", 
             RowBox[{"InfraIntersection", "[", 
              RowBox[{"cA", ",", " ", "cB"}], "]"}]}], "}"}], ",", 
           " ", "\"\<they meet\>\""}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Head", " ", "@", " ", 
    RowBox[{"InfraSceneViewer", "[", 
     RowBox[{"scene", ",", " ", "g"}], "]"}]}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0703c205-c1b9-40a7-9ec1-cd6f60065c28"],

Cell[BoxData["DynamicModule"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f1ad6595-ccee-4d94-acf9-66789af62ffb"]
}, Open  ]],

Cell["\<\
The first three steps as stills: the two points, then the circle about the \
first. This is what the viewer shows as you step, drawn without the interface.\
\>", "ExampleText",ExpressionUUID->"bb2178ce-b055-471d-918f-06e339c77a23"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", "\"\<Gray\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p1", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p2", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "p1", ",", " ", "#"}], "]"}], " ", "==", " ",
          "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Row", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSceneHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"p1", ",", " ", "p2"}], "}"}], " ", "->", " ", 
            "$InfraPointColor"}], "}"}], ",", "\n", "        ", 
          RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "18"}], ",", "\n",
           "        ", 
          RowBox[{"VertexShapeFunction", " ", "->", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"AbsolutePointSize", "[", "2", "]"}], ",", " ", 
               RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}],
           ",", " ", 
          RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
        "      ", 
        RowBox[{"Text", "[", "\"\<points a and b\>\"", "]"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSceneHighlight", "[", 
         RowBox[{"g", ",", "\n", "        ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Graph", "[", 
                 RowBox[{"DirectedEdge", " ", "@@@", " ", 
                  RowBox[{"Partition", "[", 
                   RowBox[{"#", ",", " ", "2", ",", " ", "1", ",", " ", "1"}],
                    "]"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
               RowBox[{"FindInfraCircle", "[", 
                RowBox[{"g", ",", " ", "p1", ",", " ", 
                 RowBox[{"\"\<Radius\>\"", " ", "->", " ", "4"}], ",", " ", 
                 "All"}], "]"}]}], ")"}], " ", "->", " ", 
             "$InfraCircleColor"}], ",", "\n", "         ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"p1", ",", " ", "p2"}], "}"}], " ", "->", " ", 
             "$InfraPointColor"}]}], "}"}], ",", "\n", "        ", 
          RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "18"}], ",", "\n",
           "        ", 
          RowBox[{"VertexShapeFunction", " ", "->", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"AbsolutePointSize", "[", "2", "]"}], ",", " ", 
               RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}],
           ",", " ", 
          RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
        "      ", 
        RowBox[{"Text", "[", "\"\<circle around a\>\"", "]"}]}], "]"}]}], 
     "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"82ca5328-3298-46e2-84c7-d504202b6ef0"],

Cell[BoxData[
 TemplateBox[{
   TemplateBox[{
