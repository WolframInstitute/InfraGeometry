     "4ded9096-f24b-4cf3-9359-ec674414f5c2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b2e10b48-c9a0-43e5-9f9d-4ae860cc0a39"], Cell[
    "eye", "TableText",ExpressionUUID->
     "c76a829e-9562-41d0-9d66-db717d235771"], Cell[
    "hide or show the current step's object", "TableText",ExpressionUUID->
     "b13de7b1-1807-4298-b4f3-ed32e4d566d7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "16988d43-0b2a-429c-bd39-79e3780ff0fc"], Cell[
    "Branch / Diffuse", "TableText",ExpressionUUID->
     "030c4c57-46c6-4758-99b0-bcc9e9cc3030"], Cell[
    "show one realisation, or all of them overlaid", "TableText",
     ExpressionUUID->"6f3c8ec8-9bd2-4f53-8764-9b16d01fbedc"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f925c723-6326-4508-868a-4e312cd37caf"], Cell[
