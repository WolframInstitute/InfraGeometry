    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"7", ",", " ", "19"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "1", "]"}], ";", "\n", "  ", 
    RowBox[{"InfraVertexList", "[", 
     RowBox[{
     "g", ",", " ", "seg", ",", " ", "1", ",", " ", "\"\<RandomChoice\>\""}], 
     "]"}]}]}], "\n", "]"}]], "Input",
