Notebook[{

Cell[CellGroupData[{
Cell["InfraVertexList", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7c25f59d-9c0e-445f-ac87-4251504d177c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraVertexList"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraVertexList", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04d931ff-3b36-4084-bfd4-711dfbccbf2e"],
 "\[LineSeparator]",
 "gives one member of the Euclidean head ",
 StyleBox["obj", "TI"],
 " as a vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"9b8b6e5a-d69b-463f-bf87-c97c4b32d9d1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraVertexList"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraVertexList", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", 
    RowBox[{
     StyleBox["n", "TI"], " ", "|", " ", 
     RowBox[{
      ButtonBox["UpTo",
       BaseStyle->"Link"], "[", 
      StyleBox["n", "TI"], "]"}], " ", "|", " ", 
     ButtonBox["All",
      BaseStyle->"Link"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5d436a8-7112-4911-9771-342e8c6024f9"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dc63319-f2c7-4afb-a83e-7335dfcf2b7d"],
 " of ",
 StyleBox["n", "TI"],
 ", at most ",
 StyleBox["n", "TI"],
 ", or every member."
}], "Usage",ExpressionUUID->"8683bf98-acab-4e54-af77-89ce315c7828"],

Cell[TextData[{
 "A member is a source-to-sink chain of the head's graph \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMeasurement", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c63be81f-1464-4f23-b193-a833ba4bbdeb"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"graph", ",", " ", "obj", ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0361050b-841f-489a-ab99-e179889e0c75"],
 " \[LongDash] read off in lexicographic order; for a circle it is the \
chain's cyclic closure. A closed count under a non-negative integer ",
 StyleBox["n", "TI"],
 " that exceeds the number of members gives ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "738844dc-9869-4a4f-bada-61b9db039d80"],
 ", matching every ",
 Cell[BoxData[
  RowBox[{"Find", "*"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bf2dfea-27f2-4b10-985b-91a8b882cef9"],
 " count contract."
}], "Notes",ExpressionUUID->"92422de0-c37b-42c7-974d-6880050a4b2a"],

Cell["Two modifiers, given after the count:", "Notes",ExpressionUUID->"49bdf4f1-236e-42c9-9cd6-e86c8b55905a"],

Cell[TextData[{
 Cell[BoxData["\"\<RandomChoice\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "390fd827-b1e3-45c5-a526-2d1ae043aafe"],
 " walks the graph choosing the next arrow ",
 StyleBox["v", "TI"],
 " -> ",
 StyleBox["w", "TI"],
 " with probability proportional to the backward count at ",
 StyleBox["w", "TI"],
 ", so every member of the family is drawn with probability ",
 Cell[BoxData[
  RowBox[{"1", " ", "/", " ", "Cardinality"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "534a76bc-2929-4c1c-9cd7-cc9f748342e8"],
 "; ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "472a407d-59a1-4934-99ff-0aca17dd4bfb"],
 " in front reproduces the draw."
}], "Notes",ExpressionUUID->"ad1b14df-0a96-4b37-87e3-9b6be61a7fe1"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84f006bc-3fcf-4ae1-90e5-774fd36d7564"],
 " discards a random fraction ",
 StyleBox["q", "TI"],
 " of the candidates at each step of an otherwise exhaustive enumeration."
}], "Notes",ExpressionUUID->"7c97fa96-414a-4fe1-8555-f28677a5f481"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraVertexList", "[", 
   RowBox[{"graph", ",", " ", "obj"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b389187-0e41-47d6-8cba-df3e3ca4e86b"],
 " (no count) is the same as ",
 Cell[BoxData[
  RowBox[{"InfraVertexList", "[", 
   RowBox[{"graph", ",", " ", "obj", ",", " ", "Automatic"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b445de78-d03c-4f95-bdaa-0deedfc12e59"],
 ", the first member in canonical order."
}], "Notes",ExpressionUUID->"9b6e330e-e1c6-4b27-a797-ec82fd68ded8"]
}, Open  ]],

