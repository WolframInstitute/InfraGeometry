Cell["InfraVertexList", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5e6b1828-0b06-4e27-a2a3-c102d5ceb1af"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraVertexList"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraVertexList", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44081f65-d817-46cf-94fd-04c9a137b970"],
 "\[LineSeparator]",
 "gives one member of the Euclidean head ",
 StyleBox["obj", "TI"],
 " as a vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5e07446e-3f43-4eef-ae02-8dd2de0207d9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraVertexList"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraVertexList", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", 
    RowBox[{
     StyleBox["n", "TI"], " ", "|", " ", 
     RowBox[{
      ButtonBox["UpTo",
       BaseStyle->"Link"], "[", 
      StyleBox["n", "TI"], "]"}], " ", "|", " ", 
     ButtonBox["All",
      BaseStyle->"Link"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e545cff5-4978-4ea6-8f6c-980c393c5997"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55bd439f-e2da-48d1-8da1-a5223c7e20eb"],
 " of ",
 StyleBox["n", "TI"],
 ", at most ",
 StyleBox["n", "TI"],
 ", or every member."
}], "Usage",ExpressionUUID->"e5f3e6c7-6667-40d4-a7aa-1a8b13fcecb8"],

Cell[TextData[{
 "A member is a source-to-sink chain of the head's graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMeasurement", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6a7e6de-3ac6-4dd0-bdad-73eead9ee2eb"],
 " \[LongDash] read off in lexicographic order. A circle's graph is a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56212290-1f5b-4437-b0f1-6afa5ee416de"],
 " of necklaces, each opened at its closing arrow ",
 StyleBox["u", "TI"],
 " -> ",
 StyleBox["s1", "TI"],
 ", so each is an acyclic DAG with one source and one sink; a circle's member \
is the open chain ",
 StyleBox["s1", "TI"],
 " \[Ellipsis] ",
 StyleBox["u", "TI"],
 ", a cyclic vertex list whose first vertex is not repeated. A closed count \
under a non-negative integer ",
 StyleBox["n", "TI"],
 " that exceeds the number of members gives ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "196c3a40-62d8-4cd0-baa0-d9d26e445567"],
 ", matching every ",
 Cell[BoxData[
  RowBox[{"Find", "*"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d16ebc89-7a83-4e6f-86b7-fdc20d1703eb"],
 " count contract."
}], "Notes",ExpressionUUID->"a0492bea-a917-4e5c-a189-9ed2befd3959"],

Cell["Two modifiers, given after the count:", "Notes",ExpressionUUID->"0364a6b4-2911-41a3-a976-110d93adf040"],

Cell[TextData[{
 Cell[BoxData["\"\<RandomChoice\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c73cc932-ae12-4e36-a4aa-ba82b291c128"],
 " walks the graph choosing the next arrow ",
 StyleBox["v", "TI"],
 " -> ",
 StyleBox["w", "TI"],
 " with probability proportional to the backward count at ",
 StyleBox["w", "TI"],
 ", so every member of the family is drawn with probability ",
 Cell[BoxData[
  RowBox[{"1", " ", "/", " ", "Cardinality"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e4e3e24-1cf7-47f6-adf6-3f83d5e5c175"],
 "; ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff73ba09-a38f-4cc2-9d89-7f05d29084c2"],
 " in front reproduces the draw."
}], "Notes",ExpressionUUID->"ddb8b912-cc24-40d9-ab3c-303d22c4219a"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1af9a363-6ae9-46e8-8e4e-70bebbcfc35c"],
 " discards a random fraction ",
 StyleBox["q", "TI"],
 " of the candidates at each step of an otherwise exhaustive enumeration."
}], "Notes",ExpressionUUID->"c214ce0b-f518-4582-8762-b1c5b4c5242a"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraVertexList", "[", 
   RowBox[{"graph", ",", " ", "obj"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62528b55-b4d4-4cea-8e00-98e10f7275af"],
 " (no count) is the same as ",
 Cell[BoxData[
  RowBox[{"InfraVertexList", "[", 
   RowBox[{"graph", ",", " ", "obj", ",", " ", "Automatic"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "caba0a4c-a7ae-4fa7-9676-59267444d61e"],
 ", the first member in canonical order."
}], "Notes",ExpressionUUID->"cf37fb0b-8be0-4dca-943f-3bea3d1b69c2"]
}, Open  ]],

