   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"picks", " ", "=", " ", 
       RowBox[{"InfraVertexList", "[", 
        RowBox[{"g", ",", " ", "seg", ",", " ", "All"}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{"picks", ",", " ", 
         RowBox[{
          RowBox[{"InfraMemberQ", "[", 
           RowBox[{"g", ",", " ", "seg", ",", " ", "#"}], "]"}], " ", "&"}]}],
         "]"}], ",", " ", 
       RowBox[{
        RowBox[{"Length", " ", "@", " ", "picks"}], " ", "===", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<Cardinality\>\""}], 
         "]"}]}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f8482f9c-f7e4-4062-a2a1-7dc9edbf430b"],

