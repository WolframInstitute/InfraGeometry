Cell["One geodesic, then every geodesic, of a segment on a grid.", \
"ExampleText",ExpressionUUID->"f70e9864-6635-45a5-b3ee-cef62d0a460f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
