Notebook[{

Cell[CellGroupData[{
Cell["InfraVertexList", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8cf19f4a-28cd-46a9-848b-6814bc8ca500"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraVertexList"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraVertexList", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28f6fff9-d023-467b-b16e-48b7d0e813b1"],
 "\[LineSeparator]",
 "gives one member of the Euclidean head ",
 StyleBox["obj", "TI"],
 " as a vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5bf00c31-8598-448c-a9d1-3bf5064b5cc4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraVertexList"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraVertexList", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", 
    RowBox[{
     StyleBox["n", "TI"], " ", "|", " ", 
     RowBox[{
      ButtonBox["UpTo",
       BaseStyle->"Link"], "[", 
      StyleBox["n", "TI"], "]"}], " ", "|", " ", 
     ButtonBox["All",
      BaseStyle->"Link"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a440e91-ef2c-43c3-ab69-bb56ffa54644"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "829ae4b1-78ff-472f-b2a6-3dbb693a5dd7"],
 " of ",
 StyleBox["n", "TI"],
 ", at most ",
 StyleBox["n", "TI"],
 ", or every member."
}], "Usage",ExpressionUUID->"ece089f8-3859-420f-ab92-18d41a89bc53"],

Cell[TextData[{
 "A member is a source-to-sink chain of the head's graph \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMeasurement", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e1ecea16-af00-4abf-bf55-03c93af50527"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"graph", ",", " ", "obj", ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cdd7df41-ad76-447f-b929-fddc2a8508d2"],
 " \[LongDash] read off in lexicographic order. A circle's graph is a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "773e9957-c084-47a2-8c3c-01e8ad08a80c"],
 " of necklaces, each opened at its closing arrow ",
 StyleBox["u", "TI"],
 " -> ",
 StyleBox["s1", "TI"],
 ", so each is an acyclic DAG with one source and one sink; a circle's member \
is the open chain ",
 StyleBox["s1", "TI"],
 " \[Ellipsis] ",
 StyleBox["u", "TI"],
 ", a cyclic vertex list whose first vertex is not repeated. A closed count \
under a non-negative integer ",
 StyleBox["n", "TI"],
 " that exceeds the number of members gives ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fddd9f2d-ce4c-450a-8ae5-2ccc16d9df6f"],
 ", matching every ",
 Cell[BoxData[
  RowBox[{"Find", "*"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b912abf3-8b00-4c0b-a806-2babc70734e3"],
 " count contract."
}], "Notes",ExpressionUUID->"8f267c9b-ef89-4577-8562-bcb4f14abd59"],

Cell["Two modifiers, given after the count:", "Notes",ExpressionUUID->"9e675363-5baa-4a65-bacb-13ac2398bf81"],

Cell[TextData[{
 Cell[BoxData["\"\<RandomChoice\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45a6031c-0c80-4424-941e-b49c8975f094"],
 " walks the graph choosing the next arrow ",
 StyleBox["v", "TI"],
 " -> ",
 StyleBox["w", "TI"],
 " with probability proportional to the backward count at ",
 StyleBox["w", "TI"],
 ", so every member of the family is drawn with probability ",
 Cell[BoxData[
  RowBox[{"1", " ", "/", " ", "Cardinality"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10bacc2e-b9e5-427f-b318-18601e355e69"],
 "; ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "022bf6d0-6fbd-4fef-bdcc-1e7a7e695826"],
 " in front reproduces the draw."
}], "Notes",ExpressionUUID->"383c1b14-6a8f-4414-b16d-0af818e60cd3"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb422ca1-2fda-46ab-b0b1-1262871d4eb2"],
 " discards a random fraction ",
 StyleBox["q", "TI"],
 " of the candidates at each step of an otherwise exhaustive enumeration."
}], "Notes",ExpressionUUID->"5250205e-874d-4009-a64c-bea5fceb50cd"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraVertexList", "[", 
   RowBox[{"graph", ",", " ", "obj"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "797760cc-62fe-4ae4-8f73-8766bac4c88c"],
 " (no count) is the same as ",
 Cell[BoxData[
  RowBox[{"InfraVertexList", "[", 
   RowBox[{"graph", ",", " ", "obj", ",", " ", "Automatic"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fbd10f5-1daf-450a-a9d5-66f6aa8443a4"],
 ", the first member in canonical order."
}], "Notes",ExpressionUUID->"291b62e4-c1c5-4c57-8568-7c050e9d14fc"]
}, Open  ]],

