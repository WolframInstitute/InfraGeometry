Cell[TextData[{
 "A uniformly random geodesic of a segment, drawn over the whole family. ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "301cef9a-4743-45cb-9cea-a9b5a4539af2"],
 " in front fixes the draw."
}], "ExampleText",ExpressionUUID->"1b14719d-db9b-4ca8-b292-85aedee10d99"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"41", ",", " ", "61"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "3", "]"}], ";", "\n", "  ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"picks", " ", "=", " ", 
        RowBox[{"InfraVertexList", "[", 
         RowBox[{
         "g", ",", " ", "seg", ",", " ", "1", ",", 
          " ", "\"\<RandomChoice\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraHighlightGraph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{"seg", ",", " ", 
            RowBox[{"InfraWalk", "[", 
             RowBox[{"First", " ", "@", " ", "picks"}], "]"}]}], "}"}], ",", 
          " ", 
          RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", " ", 
        "picks"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"12f3dc99-b3d6-4f75-96a6-59f155281685"],

