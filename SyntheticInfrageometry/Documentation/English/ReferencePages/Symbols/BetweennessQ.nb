     "dbee359c-1e20-447a-85a8-ca854bff1ef5"], Cell[TextData[{
     Cell[BoxData[
      FormBox[
       StyleBox["w", "TI"], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e2a1cb96-2da6-4b1a-8c8c-16fdc5a93a99"],
     " is between ",
     Cell[BoxData[
      FormBox[
       StyleBox["u", "TI"], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2f23c909-f069-4585-8e67-f9305ba8abc5"],
     " and ",
     Cell[BoxData[
      FormBox[
       StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "03c5290c-e98b-47a3-bfde-8098cf49269d"],
     " iff its ruler coordinate lies between theirs."
    }], "TableText",ExpressionUUID->"3cab64f5-95a0-4197-aa05-ed04977a120c"]}
  }]], "3ColumnTableMod",ExpressionUUID->"fd96ef56-44a7-4b13-8024-\
a88d4511d7d6"]
}, Open  ]],

