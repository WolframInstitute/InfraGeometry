      FontSize->0.9 Inherited,ExpressionUUID->
      "f7fad220-6153-4f82-9d47-83fc62ae9377"],
     " is between ",
     Cell[BoxData[
      FormBox[
       StyleBox["u", "TI"], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7bc1f0cd-702a-4fd2-a141-d8c1aeb9c3bf"],
     " and ",
     Cell[BoxData[
      FormBox[
       StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c5f7a4e0-7be7-4e59-8f82-1bbe600a137f"],
     " iff its ruler coordinate lies between theirs."
    }], "TableText",ExpressionUUID->"489ec9e4-43fa-421d-afa6-ff6ebf759f7d"]}
  }]], "3ColumnTableMod",ExpressionUUID->"fb744250-175d-4f13-ab24-\
afd225bdfb2d"]
}, Open  ]],

