Cell[CellGroupData[{
Cell["BetweennessQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3287cacd-d706-46f8-89bd-cdcab24bce05"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BetweennessQ"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/BetweennessQ", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3b43f3e-08d4-49bd-afeb-9520ab3c9016"],
 "\[LineSeparator]",
 "tests Tarski's betweenness ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["B", "TI"], "(", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     StyleBox["w", "TI"], ",", 
     StyleBox["v", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e52ea68f-23d7-4a19-a398-e645733521a8"],
 ": whether ",
 StyleBox["w", "TI"],
 " lies on a geodesic from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"3520d2eb-359a-41c7-ab4a-5a42915ed7d2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["B", "TI"], "(", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     StyleBox["w", "TI"], ",", 
     StyleBox["v", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6b3fb8d-acd1-4226-bc7b-624627e1338e"],
 " holds exactly when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      StyleBox["w", "TI"]}], ")"}], "+", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["w", "TI"], ",", 
      StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      StyleBox["v", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "840f9335-724b-4d07-9f33-561edcdb7232"],
 "."
}], "Notes",ExpressionUUID->"2795335c-9319-48b4-b1ed-cba6fc68ce2e"],

Cell[TextData[{
 "Betweenness is one of the two primitives of Tarski's axiomatization \
\[LongDash] the other is equidistance, tested by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["EquidistanceQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/EquidistanceQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ef2d9b60-6019-477a-b64f-dee3cca27358"],
 " \[LongDash] so this predicate is where the classical axiom system meets \
the graph. ",
 Cell[BoxData["TarskiAxiomQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c74845dc-14f0-43d4-97f2-c2524e2e5230"],
 " and the eleven individual axiom predicates are all built from these two."
}], "Notes",ExpressionUUID->"37ba263a-699c-4cbb-a96f-9ff13ff26fc4"],

Cell[TextData[{
 "Note the argument order: the ",
 StyleBox["middle",
  FontWeight->"Bold"],
 " point is second, matching Tarski's ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["B", "TI"], "(", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     StyleBox["w", "TI"], ",", 
     StyleBox["v", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "632e6b25-3839-44c4-b78d-5b86343b6a88"],
 ", not last."
}], "Notes",ExpressionUUID->"9afb859c-d3fd-4374-92ea-38b81863fdff"],

Cell[TextData[{
 "Unlike the plane, a graph has no order-completeness. Betweenness holds for \
a whole ",
 StyleBox["set", "TI"],
 " of middle vertices, which is exactly the metric interval, and that set can \
be large: on a square grid the vertices between two points fill a whole \
diamond, not a line."
}], "Notes",ExpressionUUID->"62b37b40-462e-4068-923d-990c3aed7503"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"70808469-2814-4b40-a4d6-0199629afd80"],

