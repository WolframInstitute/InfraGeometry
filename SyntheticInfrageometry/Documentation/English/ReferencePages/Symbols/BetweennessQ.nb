Cell[CellGroupData[{
Cell["BetweennessQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0c65d9e8-7231-42f2-9caa-c32aea49ca94"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BetweennessQ"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/BetweennessQ", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166db7e1-6f78-4a8a-8b92-b5b95308867e"],
 "\[LineSeparator]",
 "tests Tarski's betweenness ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["B", "TI"], "(", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     StyleBox["w", "TI"], ",", 
     StyleBox["v", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4a31ba8-9968-4350-8b8f-4151bde94c6e"],
 ": whether ",
 StyleBox["w", "TI"],
 " lies on a geodesic from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"46231345-48dd-477e-8ad1-9296663bc1b7"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["B", "TI"], "(", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     StyleBox["w", "TI"], ",", 
     StyleBox["v", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c059d15-ef8d-431f-8c2c-25895348cb6d"],
 " holds exactly when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      StyleBox["w", "TI"]}], ")"}], "+", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["w", "TI"], ",", 
      StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      StyleBox["v", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b99a7ab-ae17-4582-b4ae-a72e05432c7c"],
 "."
}], "Notes",ExpressionUUID->"d4af56fb-02b3-441e-85d5-ac84bb9ab350"],

Cell[TextData[{
 "Betweenness is one of the two primitives of Tarski's axiomatization \
\[LongDash] the other is equidistance, tested by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["EquidistanceQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/EquidistanceQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f150d993-ddf0-42a2-a5df-1e6f546309f2"],
 " \[LongDash] so this predicate is where the classical axiom system meets \
the graph. ",
 Cell[BoxData["TarskiAxiomQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "941c9282-24c7-42c7-b025-9c6edae932f7"],
 " and the eleven individual axiom predicates are all built from these two."
}], "Notes",ExpressionUUID->"34ae20fc-45e7-4125-b512-79bb6ed7c5d3"],

Cell[TextData[{
 "Note the argument order: the ",
 StyleBox["middle",
  FontWeight->"Bold"],
 " point is second, matching Tarski's ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["B", "TI"], "(", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     StyleBox["w", "TI"], ",", 
     StyleBox["v", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43ec9345-cc21-4bbb-8f4c-1188447d532e"],
 ", not last."
}], "Notes",ExpressionUUID->"90a11dd6-f21b-4977-8aaf-8140337021fe"],

Cell[TextData[{
 "Unlike the plane, a graph has no order-completeness. Betweenness holds for \
a whole ",
 StyleBox["set", "TI"],
 " of middle vertices, which is exactly the metric interval, and that set can \
be large: on a square grid the vertices between two points fill a whole \
diamond, not a line."
}], "Notes",ExpressionUUID->"d199234d-b48e-4bb1-80e1-c12f422a387d"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"63ac0044-63da-40e9-b80f-8f93eb9448fb"],

