Cell[TextData[{
 "The vertices between two points are exactly ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MetricInterval"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/MetricInterval", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1f77389b-f277-4823-8e5e-7994fe0c0855"],
 "."
}], "ExampleText",ExpressionUUID->"47393d4d-9e70-4e2f-ab68-149ddb6f50ad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"BetweennessQ", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "#", ",", " ", "b"}], "]"}], 
       " ", "&"}]}], "]"}], " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"MetricInterval", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6118df1e-48b9-4c7d-8e3b-47a455f751d5"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"bcc95307-7b4c-422e-807f-7065913a0d53"]
