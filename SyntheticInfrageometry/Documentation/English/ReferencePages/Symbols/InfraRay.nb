Cell["\<\
Five rays leave 6 through 7 on a 4 \[Times] 4 grid. Two stop at the corner 4 \
after three steps, three reach the corner 16 after four.\
\>", "ExampleText",ExpressionUUID->"43d10c35-9851-41f2-8f1d-b88312ad9e3c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ray", " ", "=", " ", 
     RowBox[{"InfraRay", "[", 
      RowBox[{"6", ",", " ", "7"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "ray", ",", " ", "\"\<Cardinality\>\""}], "]"}], 
     ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "ray", ",", " ", "\"\<Length\>\""}], "]"}]}], 
    "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f8d9fb44-2663-4ff5-bca6-8f86431e7a1f"],

Cell[BoxData[
 RowBox[{"{", 
