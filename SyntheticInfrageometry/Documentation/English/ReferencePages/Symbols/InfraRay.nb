Cell["InfraRay", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fde34440-3b62-4867-b0f4-9bc247f03591"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRay"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraRay", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84d5696c-f5a6-4b33-8ac6-1db58a648bb7"],
 "\[LineSeparator]",
 "is the ray from ",
 StyleBox["p", "TI"],
 " through ",
 StyleBox["q", "TI"],
 ": every geodesic from ",
 StyleBox["p", "TI"],
 " through ",
 StyleBox["q", "TI"],
 " that cannot be prolonged past its last vertex. It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMeasurement", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "71efbaa2-1a4f-4f48-916a-afeebf6c267f"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraVertexList", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "be05057a-70e9-4941-8b7a-fd8253a56ec3"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a8a29fbb-21ca-4b66-992c-3fc54e2bec55"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRay"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraRay", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5b7cfeb-6f89-46ab-8fd8-7798056d9259"],
 "\[LineSeparator]",
 "is the pencil at ",
 StyleBox["p", "TI"],
 ": every ray from ",
 StyleBox["p", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f9ecc48a-b114-40a4-9faf-50a31c263612"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRay"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraRay", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49a91a80-2f5f-43f7-821c-49259a8d5a54"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraScene", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "385cd045-1c7f-4340-b76e-9010cc51055c"],
 " is the ray construction token; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRay"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraRay", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d9e7f966-0cdc-49a2-90c2-96dbefc7dc49"],
 " is the search."
}], "Usage",ExpressionUUID->"d7803b02-85f6-46c5-b458-5c834514172c"],

Cell[TextData[{
 "Its graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMeasurement", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ray", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87e9e9ad-5f66-4629-a00b-1da85244338b"],
 " \[LongDash] is one DAG with source ",
 StyleBox["p", "TI"],
 ": the geodesic interval from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " glued at ",
 StyleBox["q", "TI"],
 " to ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
GeodesicExtensionGraph", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd9aa8d6-7717-44ea-9c48-61888c47c255"],
 ". Its sinks are exactly the inextensible ends, so its source-to-sink chains \
are exactly the rays, and ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23eac1fc-5d58-41e1-8e8f-e83db9e5da72"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20d6d977-dada-4893-b54b-a0b9dffbb803"],
 "."
}], "Notes",ExpressionUUID->"bca8fe6d-ca31-4845-8306-151dfb8fd0a7"],

Cell[TextData[{
 "Rays to different sinks differ in length, so ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e1521ce-f47e-47ab-93ab-c48cf9463048"],
 " is a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38251583-1874-4378-b2a8-a195b6526edc"],
 " of the lengths present."
}], "Notes",ExpressionUUID->"8d332158-6383-4e4d-a564-73304996a117"],

Cell[TextData[{
