Cell["\<\
A tuple of three mutually most-distant points comes back as three vertices.\
\>", "ExampleText",ExpressionUUID->"8158e78e-4a15-42aa-ab5a-807d4a010804"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"FindInfraPoint", "[", 
      RowBox[{"g", ",", " ", "3", ",", " ", 
       RowBox[{"\"\<Distance\>\"", " ", "->", " ", "\"\<Max\>\""}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<count\>\"", " ", "->", " ", 
      RowBox[{"Length", "[", "t", "]"}]}], ",", " ", 
     RowBox[{"\"\<vertices\>\"", " ", "->", " ", "t"}]}], "|>"}]}], 
  "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"c3beae75-9651-4d26-8f68-a722e1fe0903"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"count\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"vertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"267", ",", "363", ",", "299"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"a815fec5-49a4-438d-8bba-f98009cc24fb"]
}, Open  ]]
}, Open  ]],

