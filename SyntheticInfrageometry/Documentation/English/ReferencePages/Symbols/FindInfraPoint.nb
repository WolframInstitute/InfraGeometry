Cell["\<\
One point is a vertex; the calling triple gives a list of them.\
\>", "ExampleText",ExpressionUUID->"ec3f9c0c-1f42-435f-9c51-5bf72e2ca9b7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FindInfraPoint", "[", "g", "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraPoint", "[", 
       RowBox[{"g", ",", " ", "All"}], "]"}]}], ",", " ", 
     RowBox[{"VertexCount", "[", "g", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"08c52e95-bc4c-4e25-99a0-f483dde498cf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"17", ",", "313", ",", "313"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9c766891-cb31-413b-9b0b-1c97e289c5d9"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2952cf00-99f0-4735-9582-a2cacb49954a"],
 " selects the metrically special vertices. Here the centre is one vertex and \
the periphery is many."
}], "ExampleText",ExpressionUUID->"4115ab52-a280-4bf6-815e-11da1df14e1f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<centre\>\"", " ", "->", " ", 
      RowBox[{"FindInfraPoint", "[", 
       RowBox[{"g", ",", " ", "All", ",", " ", 
        RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], "]"}]}],
      ",", "\n", "    ", 
     RowBox[{"\"\<periphery count\>\"", " ", "->", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", "All", ",", " ", 
         RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Periphery\>\""}]}], 
        "]"}]}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b077cd0f-0aa3-48c2-8180-750555ddf115"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"centre\"\>", "\[Rule]", 
    RowBox[{"{", "1", "}"}]}], ",", 
   RowBox[{"\<\"periphery count\"\>", "\[Rule]", "48"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"441d1215-ab72-4124-a81f-afed0b72d27f"]
}, Open  ]],

Cell["\<\
Centre and periphery drawn together. The periphery of a patch is its rim.\
\>", "ExampleText",ExpressionUUID->"854fd8b9-9235-44a9-9c1d-19356c0bc00b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", "\"\<Gray\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSceneHighlight", "[", 
    RowBox[{"g", ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"FindInfraPoint", "[", 
         RowBox[{"g", ",", " ", "All", ",", " ", 
          RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Periphery\>\""}]}], 
         "]"}], " ", "->", " ", "$InfraShellColor"}], ",", "\n", "     ", 
       RowBox[{
        RowBox[{"FindInfraPoint", "[", 
         RowBox[{"g", ",", " ", "All", ",", " ", 
          RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], "]"}],
         " ", "->", " ", "$InfraPointColor"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "16"}], ",", "\n", 
     "    ", 
     RowBox[{"VertexShapeFunction", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
          RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}], ",",
      "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "340"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[3]:= ",ExpressionUUID->"95492794-2e62-4718-bea9-61f5f5bcf2b9"],

