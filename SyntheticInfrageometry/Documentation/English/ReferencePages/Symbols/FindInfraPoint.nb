Cell[TextData[{
 "Keeping a draw off the rim. The balls are a nested family, so ",
 Cell[BoxData["q"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e87af56-b9f6-4a54-9796-47c88dd7030c"],
 " reads directly as the fraction of the way out a point is allowed to sit."
}], "ExampleText",ExpressionUUID->"044037f5-0b83-49b2-96f9-55ff5d450359"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", "\"\<Gray\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSceneHighlight", "[", 
    RowBox[{"g", ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"VertexList", " ", "@", " ", 
         RowBox[{"CenterGraph", "[", 
          RowBox[{"g", ",", " ", "0.8"}], "]"}]}], " ", "->", " ", 
        "$InfraShellColor"}], ",", "\n", "     ", 
       RowBox[{
        RowBox[{"VertexList", " ", "@", " ", 
         RowBox[{"CenterGraph", "[", 
          RowBox[{"g", ",", " ", "0.4"}], "]"}]}], " ", "->", " ", 
        "$InfraPointColor"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "16"}], ",", "\n", 
     "    ", 
     RowBox[{"VertexShapeFunction", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
          RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}], ",",
      "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "340"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[4]:= ",ExpressionUUID->"75c626a3-656d-4d1c-89f3-7d97db3b0c7f"],

