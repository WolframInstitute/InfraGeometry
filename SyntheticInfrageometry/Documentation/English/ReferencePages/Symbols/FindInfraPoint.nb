Cell[TextData[{
 Cell[BoxData["\"\<Center\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e0ec118-ef17-4812-a205-0047dc58ef61"],
 " and ",
 Cell[BoxData["\"\<Periphery\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92df9b22-3e76-48e7-996f-5af60127cdb2"],
 " are meant in the graph-eccentricity sense. ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e75aac4a-d36e-4e47-8d28-2884f867513d"],
 " imposes a mutual-distance condition on a tuple."
}], "Notes",ExpressionUUID->"7ef67b07-0fa0-40bb-ab4d-9041fd106168"],

Cell[TextData[{
 "To keep a whole construction interior, not just its anchors, cut the \
substrate with ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68804f5b-571d-4ca2-b77e-94474492e8bf"],
 " (from the Infrageometry paclet) and work on that graph: it is the ball of \
radius ",
 Cell[BoxData[
  RowBox[{"Floor", "[", 
   RowBox[{"q", " ", 
    RowBox[{"GraphRadius", "[", "g", "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8c32b46-32b0-4007-a7ac-c2a4ffe3a7c5"],
 " about ",
 Cell[BoxData[
  RowBox[{"GraphCenter", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90cfd415-4f3e-4424-ba3f-dc6f71a65d22"],
 ", carrying the same vertex labels and coordinates, so the result draws on \
the original. Restricting ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4016c7ca-dfb0-48b6-adad-58ea1bae475f"],
 " alone pins only the anchors; a construction with slack spends it outward."
}], "Notes",ExpressionUUID->"05093445-4334-4829-8e25-ce7a55f6580d"],

Cell[TextData[{
 "To narrow a bundle you already hold, use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SelectInfraPoint"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/SelectInfraPoint", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a5efac88-4412-40ae-9098-5f306f00cf04"],
 ". It takes the same ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95d4fff2-7337-4dd1-94aa-859ae483978a"],
 " and ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e14017fa-4b14-4b12-a29a-749340a12a64"],
 " vocabulary on a supplied vertex set."
}], "Notes",ExpressionUUID->"c751beb7-a2fb-4e71-910f-53681994f06b"],

Cell[TextData[{
 "The draw is random: seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd5197eb-3fa1-4cb2-af31-7900f91c6e94"],
 " before the first call if you need a reproducible figure."
}], "Notes",ExpressionUUID->"7f193d0f-4bec-4ea2-ad8c-f471fe12eaf4"],

