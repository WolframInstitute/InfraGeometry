Cell[TextData[{
 "Keeping a draw off the rim. The balls are a nested family, so ",
 Cell[BoxData["q"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4b8f39b-03d4-4d6e-9175-cd8584b5f9c0"],
 " reads directly as the fraction of the way out a point is allowed to sit."
}], "ExampleText",ExpressionUUID->"88cc173b-d1ae-4fe7-a971-af12f44d082c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", "\"\<Gray\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"InfraHighlightGraph", "[", 
    RowBox[{"g", ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"VertexList", " ", "@", " ", 
         RowBox[{"CenterGraph", "[", 
          RowBox[{"g", ",", " ", "0.8"}], "]"}]}], " ", "->", " ", 
        "$InfraShellColor"}], ",", "\n", "     ", 
       RowBox[{
        RowBox[{"VertexList", " ", "@", " ", 
         RowBox[{"CenterGraph", "[", 
          RowBox[{"g", ",", " ", "0.4"}], "]"}]}], " ", "->", " ", 
        "$InfraPointColor"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "16"}], ",", "\n", 
     "    ", 
     RowBox[{"VertexShapeFunction", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
          RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}], ",",
      "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "340"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[4]:= ",ExpressionUUID->"f3acf72f-1aad-4e57-afdb-9637009d3c53"],

