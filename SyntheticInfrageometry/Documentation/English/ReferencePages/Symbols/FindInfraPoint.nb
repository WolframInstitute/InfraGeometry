Cell[TextData[{
 Cell[BoxData["\"\<Center\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f57baf3-4130-4c54-a287-46f17e62b617"],
 " and ",
 Cell[BoxData["\"\<Periphery\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24a1ebcb-c206-43fd-9934-1575c1c3e998"],
 " are meant in the graph-eccentricity sense. ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c5c9d76-25e0-4e72-9a39-2aa3209d45e7"],
 " imposes a mutual-distance condition on a tuple."
}], "Notes",ExpressionUUID->"8c547d63-3130-4077-9544-28cea28b00ab"],

Cell[TextData[{
 "To keep a whole construction interior, not just its anchors, cut the \
substrate with ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c0314cd-2b29-483e-90c0-856b61a53240"],
 " (from the Infrageometry paclet) and work on that graph: it is the ball of \
radius ",
 Cell[BoxData[
  RowBox[{"Floor", "[", 
   RowBox[{"q", " ", 
    RowBox[{"GraphRadius", "[", "g", "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36625595-0cf6-44fa-8964-c8ebfa2a1f1a"],
 " about ",
 Cell[BoxData[
  RowBox[{"GraphCenter", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0731856e-1de4-4b7f-aa4f-8b1b28bb5327"],
 ", carrying the same vertex labels and coordinates, so the result draws on \
the original. Restricting ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e23ff2d1-0b9a-401f-88fb-8cac1ffd8ae7"],
 " alone pins only the anchors; a construction with slack spends it outward."
}], "Notes",ExpressionUUID->"a9157c4d-e444-4e5a-a2c5-19cb489de6f1"],

Cell[TextData[{
 "To narrow a bundle you already hold, use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SelectInfraPoint"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/SelectInfraPoint", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "82ad5e52-4806-4042-890d-fb933da6cc6f"],
 ". It takes the same ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c43fd483-4cd4-4407-b916-54cc69112caf"],
 " and ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4e49259-05f4-418a-aee5-c9a3d50856bc"],
 " vocabulary on a supplied vertex set."
}], "Notes",ExpressionUUID->"a9bcb51a-ef55-427d-8bd8-66a7ec321b00"],

Cell[TextData[{
 "The draw is random: seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e9953fb-e2f4-4203-ac15-e54f6da87e53"],
 " before the first call if you need a reproducible figure."
}], "Notes",ExpressionUUID->"22694f32-9466-4333-a58b-6b56c533e400"],

