Cell[CellGroupData[{
Cell["FindInfraPoint", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cab6f870-2d32-40b0-9760-86511c8faa9a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraPoint", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3efef3d7-8224-45f5-a747-3bf22ac4cd7b"],
 "\[LineSeparator]",
 "gives one point of ",
 StyleBox["g", "TI"],
 ", as a vertex.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"834e4c28-3e9f-4478-b08a-758ad0586bd3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraPoint", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae4e796a-2190-4e54-80cb-e6c2d36399a1"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["n", "TI"],
 " points, as a vertex list. Exactly ",
 StyleBox["n", "TI"],
 " or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0038b1e1-7850-4a41-88d0-28ef892d8f36"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4068e607-7f70-4661-b8b9-d575c92ba54b"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7718e740-1817-4cbd-9192-f17f97689bf1"],
 " gives every vertex of the pool."
}], "Usage",ExpressionUUID->"ea811e29-f01e-49db-abd9-4bb031d68d4d"],

Cell[TextData[{
 "Definition: a point of ",
 StyleBox["g", "TI"],
 " drawn from the ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1152875d-8291-4dfd-b00c-a25f8bb7271d"],
 " candidate pool."
}], "Notes",ExpressionUUID->"a99d5486-7d4b-49e3-ae89-5a49530ed49c"],

Cell[TextData[{
 "The count always means ",
 StyleBox["how many points you get",
  FontWeight->"Bold"],
 "; the ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aca7be8a-50dc-494d-b085-4edd77505d49"],
 " option constrains ",
 StyleBox["which",
  FontWeight->"Bold"],
 " ones. With a distance condition the returned list is therefore one \
mutually-constrained tuple \[LongDash] three points pairwise at maximum \
distance is a joint condition, and a plain vertex list states it without \
ambiguity."
}], "Notes",ExpressionUUID->"888da1f9-74c9-4e0f-a53d-c376059960a9"],

Cell[TextData[{
 "The whole pool is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraPoint", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ddd1dc10-cd8d-48ba-b3e7-4dbd8cd3670b"],
 ", a vertex list."
}], "Notes",ExpressionUUID->"9ee96429-f419-43c7-81bd-4bfe8740454d"],

