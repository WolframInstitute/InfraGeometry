Cell[TextData[{
 "Every parallel is a geodesic, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraParallelQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraParallelQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d3a931a8-9837-4b73-b114-e4f377b4dfdf"],
 " accepts it \[LongDash] as it accepts two concentric shells, which no \
geodesic could be."
}], "ExampleText",ExpressionUUID->"6d23de96-209c-4804-9f0b-f9cb962709c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"row", " ", "=", " ", 
     RowBox[{"FindInfraParallel", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Range", "[", "5", "]"}], ",", " ", "13"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSegmentQ", "[", 
      RowBox[{"g", ",", " ", "row"}], "]"}], ",", " ", 
     RowBox[{"InfraParallelQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Range", "[", "5", "]"}], ",", " ", "row"}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"InfraParallelQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "13", ",", " ", "1"}], "]"}], ",", " ", 
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "13", ",", " ", "2"}], "]"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a83242d2-2dfd-4583-ab1a-013bc3e93d41"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b697fbc5-793a-42d7-9ef3-177a6023bf68"]
}, Open  ]],

