Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"c31edc0b-dd48-46ce-80cd-9cdf8a8f22a9"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a093fd40-6ed3-46a4-a553-e39fcfb3000a"], Cell["System", "TableText",
     FontWeight->Bold,ExpressionUUID->"1341abcf-9035-4f1c-b6eb-c18259548302"],
