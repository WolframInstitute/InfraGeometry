     FontWeight->Bold,ExpressionUUID->"5f9981c5-650b-4474-ae0b-06bfcc07bb25"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "72c52fd8-add4-4ebe-aef5-02464bdfd26a"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "411e446e-3d62-47b7-86ff-3b9f16d939a3"], Cell[
    "Postulate 5", "TableText",ExpressionUUID->
     "7095e8c9-c682-44c7-afd8-10f2958b40c7"], Cell["\<\
The parallel postulate: two lines cut by a transversal making internal angles \
less than two right angles meet on that side.\
\>", "TableText",ExpressionUUID->"e7b2f8c3-0182-40e8-878c-abb0b5a66734"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "42645b34-6029-4d5a-9e97-e77261560143"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "7470b7cd-31f9-4665-bb6c-aa60343f237d"], Cell[
    "Proposition I.31", "TableText",ExpressionUUID->
     "1cc1c662-bddb-4df7-b8dd-302c7a6ccd35"], Cell["\<\
To draw a line through a given point parallel to a given line.\
\>", "TableText",ExpressionUUID->"543d16d0-6bcf-4bdc-b4c9-e731f1eb1e95"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1c4ce11e-48e8-4fb2-a49b-51c9c8242353"], Cell[
    "Hilbert", "TableText",ExpressionUUID->
     "9f7068ff-a677-42c3-bc20-c1f0dff60825"], Cell[
    "Group IV", "TableText",ExpressionUUID->
     "60eb9c99-471c-4525-ae00-3375d24f354e"], Cell["\<\
Playfair's axiom: through a point not on a line there is exactly one parallel.\
\>", "TableText",ExpressionUUID->"5b67b8c6-f502-4b9e-92f9-256b18b2655c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9fbc0756-e35d-465c-ac81-86dafa7fb160"], Cell[
    "Tarski", "TableText",ExpressionUUID->
