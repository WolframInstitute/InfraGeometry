    }], "TableText",ExpressionUUID->"d5955e6d-7593-47d8-8284-2538b20c6bdd"], 
    Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "59bfa688-9b62-41d5-9c9b-0f2a6b5b72ab"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b864fe41-f957-46b2-b1f2-905cf33c1230"],
     " to ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e2d78e45-850a-49e4-b059-264ed7e9b522"],
     ", a bounded or absent count to ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5a60da4c-0b4c-473e-b97b-f2f065d3bfc9"],
     ". The class is the same under every value; ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c30af49c-7279-41ac-9d15-16ebba33e128"],
     " and ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c852280b-7359-4d0c-8472-e63508fea26c"],
     " take the end pairs and the branches of each DAG in candidate order, ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f2752633-0d57-40aa-ac47-74b33ce694d8"],
     " in random order, seeded by an ambient ",
