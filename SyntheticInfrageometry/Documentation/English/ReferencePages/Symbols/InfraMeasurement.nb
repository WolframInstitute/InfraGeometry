Cell[TextData[{
 "The support of every object \[LongDash] what ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97e9d75b-51b6-4db3-9f64-ae5efb620fe3"],
 " and the four volumes read \[LongDash] is ",
 Cell[BoxData[
  RowBox[{"Keys", " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"graph", ",", " ", "obj", ",", " ", "\"\<VertexDensity\>\""}], 
    "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3962376-6107-4045-8cae-53910dfc8430"],
 "."
}], "Notes",ExpressionUUID->"23e9715c-d2d2-4d1b-8d9f-23fa6b84208c"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraIntersection", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ac770434-de16-4796-9ade-e5e5f4b5ea40"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraUnion", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "072f9e30-1805-4d59-9f14-3f33d2234b93"],
 " are heads on heads: neither is a family of walks, so neither has a ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e06aa50-5aa7-4158-b421-867ff4407644"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e04aa430-7f96-4bee-9fde-3ac9d06a3638"],
 ", ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54b0a5ff-d06e-4dc6-ad39-56e7f7ddb8d4"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc461254-a8de-4553-9b81-0cfcc51e878a"],
 " or ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "234cd1a1-796d-471c-b19a-924874321a9b"],
 ", and their ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "092b4009-5e9f-4c1b-bff8-84d70b7bd9cb"],
 " lists only the density, the subgraph and the four volumes. The \
intersection's ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "565bf771-50be-4537-bda4-5fcb18b7b80a"],
 " is the product of the two objects' densities on their common vertices, the \
union's the sum."
}], "Notes",ExpressionUUID->"35a7517f-5c45-4070-90cd-6bec78ec7022"],

Cell[TextData[{
 "A circle or a circle band takes ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
   RowBox[{"r", " ", "|", " ", 
    RowBox[{"{", 
     RowBox[{"r", ",", " ", "s"}], "}"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c3ccd00-a3d9-47c4-9c5d-180bbacd28dd"],
 " in place of a point, or widens the circle through a point with ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"delta", " ", "|", " ", 
    RowBox[{"{", 
     RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "356c2cbd-5f0b-4458-ac69-4df85b26aaa8"],
 " (default ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "213c56cf-8255-4e7c-8b0b-e363697cdc43"],
 ")."
}], "Notes",ExpressionUUID->"7e3ec746-366a-42a2-913c-219f51c1f74f"]
}, Open  ]],

