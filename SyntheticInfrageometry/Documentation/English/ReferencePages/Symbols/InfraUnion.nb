Cell["The union of two vertex lists.", "ExampleText",ExpressionUUID->"fe7c98b6-43e6-46e4-91b4-33cd5cfd9921"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraUnion", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "8", ",", " ", "13"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d1a81880-28a1-4774-8c91-49a7d4c4a522"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "8", ",", "13"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e9316c7e-644d-43aa-8fa3-0826d2b071b3"]
}, Open  ]],

Cell["\<\
Two crossing segments on a grid: the density of their union is the sum of \
theirs.\
\>", "ExampleText",ExpressionUUID->"145d0a92-731a-40c5-9c3a-993400804953"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraMeasurement", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
   RowBox[{"InfraUnion", "[", 
    RowBox[{
     RowBox[{"InfraSegment", "[", 
      RowBox[{"1", ",", " ", "13"}], "]"}], ",", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"7", ",", " ", "19"}], "]"}]}], "]"}], ",", 
   " ", "\"\<VertexDensity\>\""}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c8e5bd03-deca-46d0-8ffa-f41c142cf64b"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "6"}], ",", 
   RowBox[{"2", "\[Rule]", "3"}], ",", 
   RowBox[{"3", "\[Rule]", "1"}], ",", 
   RowBox[{"6", "\[Rule]", "3"}], ",", 
   RowBox[{"7", "\[Rule]", "10"}], ",", 
   RowBox[{"8", "\[Rule]", "6"}], ",", 
   RowBox[{"9", "\[Rule]", "1"}], ",", 
   RowBox[{"11", "\[Rule]", "1"}], ",", 
   RowBox[{"12", "\[Rule]", "6"}], ",", 
   RowBox[{"13", "\[Rule]", "10"}], ",", 
