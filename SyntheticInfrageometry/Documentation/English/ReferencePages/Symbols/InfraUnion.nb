Notebook[{

Cell[CellGroupData[{
Cell["InfraUnion", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9fc56c2d-211c-48f8-904b-f6f1c11cfe99"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraUnion"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraUnion", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj1", "TI"], ",", " ", 
    StyleBox["obj2", "TI"], ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43626ff0-9357-4c61-8321-1776aae59730"],
 "\[LineSeparator]",
 "returns the vertex-set union of the given shapes on graph \[LongDash] \
vertex lists, densities, walk graphs \[LongDash] as a sorted List.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4fdd025c-1005-4fc0-8e39-b044dbf52de5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraUnion"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraUnion", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["obj1", "TI"], ",", " ", 
    StyleBox["obj2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5976e5f-2f11-4784-975a-b086a9cdd7cd"],
 "\[LineSeparator]",
 "of two Euclidean heads is itself an inert head; InfraMeasurement evaluates \
it on a graph."
}], "Usage",ExpressionUUID->"22478f1b-ae82-4389-8468-24f746f4e44c"],

Cell["\<\
On heads, InfraMeasurement gives the union its \"VertexDensity\" \[LongDash] \
the sum of the two densities \[LongDash] its \"Subgraph\" and the four \
volumes. It is not a family of walks, so it has no \"Graph\", \
\"Cardinality\", \"Length\", \"EdgeDensity\" or \"Faithful\".\
\>", "Notes",ExpressionUUID->"96ffe4f2-b987-4f60-ada6-ec77ff80855a"],

Cell[TextData[{
 "Inside InfraScene hypotheses ",
 Cell[BoxData[
  RowBox[{"InfraUnion", "[", 
   RowBox[{"c1", ",", " ", "c2"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "174a7b00-dc4b-4960-8c61-60ab68e1640c"],
 " is the union token, the engine supplying the graph."
}], "Notes",ExpressionUUID->"72ae30f5-b7fb-4cae-b795-3b14d4928380"]
}, Open  ]],

