      RowBox[{"g", ",", " ", "6", ",", " ", "7", ",", " ", "All"}], "]"}]}], 
    " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"InfraVertexList", "[", 
