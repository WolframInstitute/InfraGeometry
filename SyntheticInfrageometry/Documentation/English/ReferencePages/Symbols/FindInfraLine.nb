Cell[CellGroupData[{
Cell["FindInfraLine", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4755fccc-8075-496e-9e22-61075f4a2c9b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraLine"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraLine", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b642182-8873-48a6-8a7b-7fbbeb22aac5"],
 "\[LineSeparator]",
 "gives one line through ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " \[LongDash] an inextensible geodesic containing both \[LongDash] as a \
vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"677a6748-3ee7-430e-b58e-d3808f94b349"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraLine"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraLine", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seq", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72aecfb0-21db-4180-b58a-ce7c406d0eff"],
 "\[LineSeparator]",
 "gives one line containing the geodesic vertex list ",
 StyleBox["seq", "TI"],
 " as a contiguous subsequence.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"609b0475-cfc0-4ebc-aa3d-17828fd79eaa"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraLine"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraLine", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64ee7acc-e41f-42dd-bf3d-dd65f3a95576"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3cfe867-e405-4ace-ab1f-81b5a0fabee7"],
 " of exactly ",
 StyleBox["n", "TI"],
 " lines or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "460d2e64-3605-4ad0-aafd-3bc7b9b5c372"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0d15d03-6035-413a-9a12-5fc66e5bfcdf"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c7fe77f-2091-4031-b640-60510acb7af3"],
 " gives every line."
}], "Usage",ExpressionUUID->"b8582d2f-f320-4e57-9966-2e7590f4c8d5"],

Cell[TextData[{
 "A line is an ",
 StyleBox["inextensible geodesic",
  FontWeight->"Bold"],
 ": a shortest path that no neighbour of either endpoint prolongs. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLineQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraLineQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a04813d0-ff01-4378-b613-caee54605499"],
 " is the predicate, and every line returned satisfies it."
}], "Notes",ExpressionUUID->"110dc250-9d31-4bd2-8c89-43619c8fc805"],

Cell["\<\
That is the intrinsic reading of Euclid's second postulate \[LongDash] \
produce a finite straight line continuously \[LongDash] and it is where the \
analogy with the plane breaks hardest. In the plane two points determine one \
line. On a lattice they determine an enormous family: below, two vertices at \
distance 5 on a 313-vertex square-tiling patch lie on 5 242 880 lines, \
against 6144 on the hexagonal tiling and 1386 on the irregular mesh.\
\>", "Notes",ExpressionUUID->"736f4954-ede1-47e7-9c91-0ea1d91cd25b"],

Cell[TextData[{
 "The search runs on the substrate directly: a geodesic from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 ", prolonged one geodesic step at a time, every prolongation at the back and \
then every prolongation at the front, kept when neither end can be prolonged. \
It does not read the graph of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraLine", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5488a48-9ebc-4382-9ed6-c60623a6b5d3"],
 ", so it is the check on that graph, and it returns exactly the shapes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraVertexList", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "641416fa-4be3-4a31-821c-19607bc02a7b"],
 " gives for that head."
}], "Notes",ExpressionUUID->"8a675145-5c86-48ff-b28a-6896770e5d9c"],

Cell[TextData[{
 "The search enumerates. To count lines, use ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMeasurement", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraLine", "[", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"]}], "]"}], ",", " ", "\"\<Cardinality\>\""}], "]"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0aa4f7c8-567f-4195-972b-bbc322c72541"],
 ", which reads the count off the head's graph without enumerating a line."
}], "Notes",ExpressionUUID->"6283282d-726e-4d7c-a2c5-6b96779ac938"],

Cell[TextData[{
 "The count-less call is one line, deterministic. There is no ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e147fdf-1003-4e96-a04d-7c30988effb7"],
 " and no ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b01e0a3c-ce58-4410-9c1b-0e444d75f628"],
 "."
}], "Notes",ExpressionUUID->"c61d5829-3b9c-487c-acfc-501628bf8a19"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"1859f5b5-b1d3-49b4-b6c9-1b23acbeeac4"],

