Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"da5267bd-01b8-474c-8df3-5ad2f5f12d5d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraGoldenSection"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
FindInfraGoldenSection", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d23975d6-aba0-4735-b4b7-38537d0755dd"],
 "\[LineSeparator]",
 "gives the density <|v -> m, \[Ellipsis]|> of the vertices at the golden \
index 1 + (n-1)/GoldenRatio along every geodesic from p1 to p2, m counting \
the geodesics.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"15a21bc1-7e86-46c1-bdf3-cc7ca9b02dcf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
