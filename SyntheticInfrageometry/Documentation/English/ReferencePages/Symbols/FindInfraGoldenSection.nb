     "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
FindInfraGoldenSection", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["walk1", "TI"], ",", " ", "..."}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30fce2c6-c405-45c8-8749-8ae95bee340f"],
 "\[LineSeparator]",
 "and ",
 Cell[BoxData[
  RowBox[{"FindInfraGoldenSection", "[", 
   RowBox[{"graph", ",", " ", "walk"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09edd01f-ff47-43b6-af6a-0f62692601e0"],
 " use the supplied walks \[LongDash] vertex lists or walk graphs."
}], "Usage",ExpressionUUID->"e42c6391-6c7e-4b0f-9cff-bad903b22e78"],

