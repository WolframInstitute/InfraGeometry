Cell[CellGroupData[{
Cell["InfraArc", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f9ab7b1f-e6d2-4e8f-b579-db3fe4e8d88a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraArc", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ae5a0c6-2fcc-4bf7-b5da-3c8117a1f88a"],
 "\[LineSeparator]",
 "is the arc around ",
 StyleBox["c", "TI"],
 " from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ": the minor arcs of the circle through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ". It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMeasurement", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ffad231c-c32b-474a-beba-0dc444e944f0"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraVertexList", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e9720f3f-905d-440f-9159-913e8b52b012"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"57bce3b9-a5f0-43a0-b8b7-ac8c71058252"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraArc", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pk", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "819a6a01-c9e3-44a6-9fe4-90d6559bfc6b"],
 "\[LineSeparator]",
 "is the polyline of the minor arcs from each point to the next."
}], "Usage",ExpressionUUID->"9eb253a3-7c8e-41b5-822e-4cbd56a13548"],

Cell[TextData[{
 "Definition: with ",
 StyleBox["r", "TI"],
 " = ",
 StyleBox["d(c, p)", "TI"],
 ", the band ",
 StyleBox["W", "TI"],
 " is the shell { ",
 StyleBox["v", "TI"],
 " : ",
 StyleBox["d(c, v)", "TI"],
 " = ",
 StyleBox["r", "TI"],
 " }, widened by ",
 Cell[BoxData["\"\<RadiusDelta\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e3c2555-9431-4e84-a247-8b694de1b7fc"],
 ". A minor arc from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is a geodesic from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " of the subgraph induced on ",
 StyleBox["W", "TI"],
 "."
}], "Notes",ExpressionUUID->"5bc85d0e-6b13-407b-a251-12381471281f"],

Cell[TextData[{
 "Option ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2423f750-1e1e-4451-8b39-5bc5bd708478"],
 " widens the band to ",
 StyleBox["r", "TI"],
 " \[Minus] ",
 StyleBox["deltaIn", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["r", "TI"],
 " + ",
 StyleBox["deltaOut", "TI"],
 ". A scalar ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "delta"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cbbbdab-96bf-4c58-87c0-ec8298786c47"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3fb5360-b522-4efd-90d0-a81dcbac8c56"],
 ", outward only. The default is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "270ed371-1ea0-4152-8d06-60aaf47f74c0"],
 "."
}], "Notes",ExpressionUUID->"5af759b7-0a79-403d-9847-a0b0a96d3c05"],

Cell[TextData[{
 "Its graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMeasurement", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["arc", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b3011a6-80b9-44b7-ac93-b21f774721ca"],
 " \[LongDash] is the geodesic interval of the band from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", with arrows of rising band distance from ",
 StyleBox["p", "TI"],
 ". It is the same object ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ff203193-3c02-46ba-b15c-d5c356ec229b"],
 " is on the whole graph. Its chains are those geodesics, all of one length."
}], "Notes",ExpressionUUID->"3a6f7e34-7e7e-4733-80f1-89c7672b1e0c"],

Cell[TextData[{
 "That they are exactly the minor arcs needs the winding functional on the \
substrate, and ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " on a common circle. Nothing here certifies either, so ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0815fd22-83c0-4d70-9ec7-98e22b514f9f"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/Undetermined", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6712294e-a8e4-4c49-9b58-6bb0e77872cd"],
 "."
}], "Notes",ExpressionUUID->"edbf5d68-7ad3-4e67-96a3-0972bbead7b1"],

Cell[TextData[{
 "The arc is empty when ",
 StyleBox["q", "TI"],
 " leaves the band or the band disconnects ",
 StyleBox["p", "TI"],
 " from ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"d6e40b11-5d0b-4c15-bfbb-aab270795bd3"],

Cell[TextData[{
 "A polyline arc reads each piece on the band of the circle through its own \
first point. Its members concatenate one arc per piece, so its ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56070e1d-7207-4ac7-965e-4aa0af961259"],
 " is the product over the pieces."
}], "Notes",ExpressionUUID->"7e7561e3-0b57-4573-b311-9dd68df0c452"]
}, Open  ]],

