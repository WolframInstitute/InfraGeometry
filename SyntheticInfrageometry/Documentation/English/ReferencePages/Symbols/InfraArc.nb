Cell[CellGroupData[{
Cell["InfraArc", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"97c5ae25-28b4-4deb-b1ac-0ce2dcf62bfa"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraArc", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2591fb3b-bd3a-4a52-a64f-f47c488a02d6"],
 "\[LineSeparator]",
 "is the arc around ",
 StyleBox["c", "TI"],
 " from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ": the minor arcs of the circle through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ". It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMeasurement", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f63775e4-8444-4af8-a7c0-3946678c812f"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraVertexList", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1ea6945c-2624-423e-8db8-a50efef43b28"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"beb6a8ee-a2fe-4389-94a9-a25de7f63120"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraArc", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pk", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "795b200c-c20f-46cf-b4a5-69a6f68c67f9"],
 "\[LineSeparator]",
 "is the polyline of the minor arcs from each point to the next."
}], "Usage",ExpressionUUID->"acc8780c-73d9-44c7-aad9-a3c6aed16c01"],

Cell[TextData[{
 "Definition: with ",
 StyleBox["r", "TI"],
 " = ",
 StyleBox["d(c, p)", "TI"],
 ", the band ",
 StyleBox["W", "TI"],
 " is the shell { ",
 StyleBox["v", "TI"],
 " : ",
 StyleBox["d(c, v)", "TI"],
 " = ",
 StyleBox["r", "TI"],
 " }, widened by ",
 Cell[BoxData["\"\<RadiusDelta\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c92665e-4275-4cbc-9847-3a4a1a121a07"],
 ". A minor arc from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is a geodesic from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " of the subgraph induced on ",
 StyleBox["W", "TI"],
 "."
}], "Notes",ExpressionUUID->"85250975-d7f6-4bdb-822e-a192887b0cda"],

Cell[TextData[{
 "Option ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbd8fb0d-a8e7-4d23-9046-17520c114430"],
 " widens the band to ",
 StyleBox["r", "TI"],
 " \[Minus] ",
 StyleBox["deltaIn", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["r", "TI"],
 " + ",
 StyleBox["deltaOut", "TI"],
 ". A scalar ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "delta"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b97e3e52-9fdb-46fe-aeeb-9c999994d7f4"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e7c7a40-dee0-4f41-b246-1039efc08fc1"],
 ", outward only. The default is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92880a5f-320d-47fa-b433-81f98ec90cfa"],
 "."
}], "Notes",ExpressionUUID->"e4ef9e86-aa24-4d70-8950-aa9a1ca17069"],

Cell[TextData[{
 "Its graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMeasurement", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["arc", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d99baa2-1723-45f3-8ab7-9720af39ce3d"],
 " \[LongDash] is the geodesic interval of the band from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", with arrows of rising band distance from ",
 StyleBox["p", "TI"],
 ". It is the same object ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "74d1c900-febf-4fc8-9e66-d242e1f64bd9"],
 " is on the whole graph. Its chains are those geodesics, all of one length."
}], "Notes",ExpressionUUID->"b9361143-cfa4-4487-a5be-9e981e99c49b"],

Cell[TextData[{
 "That they are exactly the minor arcs needs the winding functional on the \
substrate, and ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " on a common circle. Nothing here certifies either, so ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37ac4c06-9082-441a-ae68-c9e0be3236e0"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/Undetermined", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "769463ac-3b5b-4d41-8880-38ba3f024948"],
 "."
}], "Notes",ExpressionUUID->"fa64c985-3aa2-44cb-83df-9e9648d675ea"],

Cell[TextData[{
 "The arc is empty when ",
 StyleBox["q", "TI"],
 " leaves the band or the band disconnects ",
 StyleBox["p", "TI"],
 " from ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"2e3f94ed-6aa8-4d36-95ac-957548603d26"],

Cell[TextData[{
 "A polyline arc reads each piece on the band of the circle through its own \
first point. Its members concatenate one arc per piece, so its ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf345455-8ffa-462f-a582-0cdd9b58186b"],
 " is the product over the pieces."
}], "Notes",ExpressionUUID->"bf0f6657-43f5-4b87-9328-eeb043b388d5"]
}, Open  ]],

