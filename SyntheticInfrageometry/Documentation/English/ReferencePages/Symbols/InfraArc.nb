Cell["\<\
The two half-rings between antipodes of the radius-2 hexagon on a triangular \
patch, drawn with the centre.\
\>", "ExampleText",ExpressionUUID->"b6495fa1-7f62-4ca9-add2-685a89a15060"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"TessellationNeighborhoodGraph", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "6"}], "}"}], ",", " ", "5"}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ring", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "2"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", "ring"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{"ring", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{
            RowBox[{"Subgraph", "[", 
             RowBox[{"g", ",", " ", "ring"}], "]"}], ",", " ", "p", ",", " ", 
            "#"}], "]"}], " ", "==", " ", "6"}], " ", "&"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"arc", " ", "=", " ", 
     RowBox[{"InfraArc", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "q"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "arc", ",", " ", "\"\<Cardinality\>\""}], "]"}], 
     ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "arc", ",", " ", "\"\<Length\>\""}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"InfraHighlightGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"InfraVertexList", "[", 
           RowBox[{"g", ",", " ", "arc", ",", " ", "All"}], "]"}], " ", "->", 
          " ", "$InfraCircleColor"}], ",", " ", 
         RowBox[{
          RowBox[{"{", "c", "}"}], " ", "->", " ", "$InfraPointColor"}]}], 
        "}"}]}], "]"}]}], "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"fedb952e-dd3e-434e-8a86-844cca9bcf66"],

