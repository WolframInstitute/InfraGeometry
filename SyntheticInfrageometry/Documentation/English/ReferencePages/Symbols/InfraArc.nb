Cell["\<\
Two vertices at distance 2 from the centre of a 5 \[Times] 5 grid, on \
opposite sides. With the band widened one step, two minor arcs join them, one \
each way round.\
\>", "ExampleText",ExpressionUUID->"c58e4f4c-a97e-4173-870a-4b6c135d1845"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"arc", " ", "=", " ", 
     RowBox[{"InfraArc", "[", 
      RowBox[{"13", ",", " ", 
       RowBox[{"{", 
        RowBox[{"7", ",", " ", "19"}], "}"}], ",", " ", 
       RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "1"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "arc", ",", " ", "\"\<Cardinality\>\""}], "]"}], 
     ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "arc", ",", " ", "\"\<Length\>\""}], "]"}]}], 
    "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"94e2cf0b-26b5-49db-a667-5fa1f3e982d5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"43de444b-da4e-47f8-99d4-a16c4ca2d302"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraVertexList", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
   RowBox[{"InfraArc", "[", 
    RowBox[{"13", ",", " ", 
     RowBox[{"{", 
      RowBox[{"7", ",", " ", "19"}], "}"}], ",", " ", 
     RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
   "All"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b93a4355-a468-4ffa-9acd-17d7ad91ab96"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "7", ",", "2", ",", "3", ",", "4", ",", "9", ",", "10", ",", "15", ",", 
     "20", ",", "19"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
    "7", ",", "6", ",", "11", ",", "16", ",", "17", ",", "22", ",", "23", ",",
      "24", ",", "19"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"31c9281a-736d-423a-b97c-801dde7bcb85"]
}, Open  ]],

Cell["\<\
The two half-rings between antipodes of the radius-2 hexagon on a triangular \
patch, drawn with the centre.\
\>", "ExampleText",ExpressionUUID->"a7f4925f-a4be-4e42-94c3-87ab5fe02e5e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"TessellationNeighborhoodGraph", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "6"}], "}"}], ",", " ", "5"}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ring", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "2"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", "ring"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{"ring", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{
            RowBox[{"Subgraph", "[", 
             RowBox[{"g", ",", " ", "ring"}], "]"}], ",", " ", "p", ",", " ", 
            "#"}], "]"}], " ", "==", " ", "6"}], " ", "&"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"arc", " ", "=", " ", 
     RowBox[{"InfraArc", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "q"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "arc", ",", " ", "\"\<Cardinality\>\""}], "]"}], 
     ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "arc", ",", " ", "\"\<Length\>\""}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"InfraHighlightGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"InfraVertexList", "[", 
           RowBox[{"g", ",", " ", "arc", ",", " ", "All"}], "]"}], " ", "->", 
          " ", "$InfraCircleColor"}], ",", " ", 
         RowBox[{
          RowBox[{"{", "c", "}"}], " ", "->", " ", "$InfraPointColor"}]}], 
        "}"}]}], "]"}]}], "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"eac6f0f9-26b8-425d-bf32-cac2c38c69ab"],

