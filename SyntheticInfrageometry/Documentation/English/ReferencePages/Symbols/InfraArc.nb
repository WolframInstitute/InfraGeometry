Cell["\<\
Two vertices at distance 2 from the centre of a 5 \[Times] 5 grid, on \
opposite sides. With the band widened one step, two minor arcs join them, one \
each way round.\
\>", "ExampleText",ExpressionUUID->"5320278c-31f9-40fd-b282-a588961e15bb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"arc", " ", "=", " ", 
     RowBox[{"InfraArc", "[", 
      RowBox[{"13", ",", " ", 
       RowBox[{"{", 
        RowBox[{"7", ",", " ", "19"}], "}"}], ",", " ", 
       RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "1"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "arc", ",", " ", "\"\<Cardinality\>\""}], "]"}], 
     ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "arc", ",", " ", "\"\<Length\>\""}], "]"}]}], 
    "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f1236886-fa1d-46cb-a93f-26a5d6a813c3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d895e76d-fa20-4c55-8990-b5b94a098ef2"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraVertexList", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
   RowBox[{"InfraArc", "[", 
    RowBox[{"13", ",", " ", 
     RowBox[{"{", 
      RowBox[{"7", ",", " ", "19"}], "}"}], ",", " ", 
     RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
   "All"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"fa31cf65-c057-46b7-a554-5540f8ca70aa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "7", ",", "2", ",", "3", ",", "4", ",", "9", ",", "10", ",", "15", ",", 
     "20", ",", "19"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
    "7", ",", "6", ",", "11", ",", "16", ",", "17", ",", "22", ",", "23", ",",
      "24", ",", "19"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"f3b86a57-fad7-4de7-8849-ea8b03dd4e73"]
}, Open  ]],

Cell["\<\
The two half-rings between antipodes of the radius-2 hexagon on a triangular \
patch, drawn with the centre.\
\>", "ExampleText",ExpressionUUID->"182ddf98-c646-4273-8750-76e3d4fd6784"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"TessellationNeighborhoodGraph", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "6"}], "}"}], ",", " ", "5"}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ring", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "2"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", "ring"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{"ring", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{
            RowBox[{"Subgraph", "[", 
             RowBox[{"g", ",", " ", "ring"}], "]"}], ",", " ", "p", ",", " ", 
            "#"}], "]"}], " ", "==", " ", "6"}], " ", "&"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"arc", " ", "=", " ", 
     RowBox[{"InfraArc", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "q"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "arc", ",", " ", "\"\<Cardinality\>\""}], "]"}], 
     ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "arc", ",", " ", "\"\<Length\>\""}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"InfraSceneHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"InfraVertexList", "[", 
           RowBox[{"g", ",", " ", "arc", ",", " ", "All"}], "]"}], " ", "->", 
          " ", "$InfraCircleColor"}], ",", " ", 
         RowBox[{
          RowBox[{"{", "c", "}"}], " ", "->", " ", "$InfraPointColor"}]}], 
        "}"}]}], "]"}]}], "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"04937f95-10d6-4755-99a2-31d6351909db"],

