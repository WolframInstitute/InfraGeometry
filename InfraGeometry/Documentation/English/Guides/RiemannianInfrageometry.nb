Cell["Infrageodesics", "GuideFunctionsSubsection",ExpressionUUID->"8dfd77ee-66d7-4b4b-9d51-16fec88b6377"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraGeodesic", 
