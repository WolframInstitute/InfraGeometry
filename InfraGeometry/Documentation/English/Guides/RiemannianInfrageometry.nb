Cell[CellGroupData[{

Cell["Not here", "GuideFunctionsSubsection",ExpressionUUID->"399cb924-8446-4f89-9fcc-f3e10bb75b28"],

Cell["\<\
not here: the Riemann tensor, the curvature tensor from directional growth; \
its estimators are the backlog item CurvatureTensorEstimators\
\>", "GuideText",ExpressionUUID->"6f4ec588-27e1-40ab-b06f-09d2b0baac56"]
