Cell[CellGroupData[{

Cell["Volume measurements", "GuideFunctionsSubsection",ExpressionUUID->"2a5466f1-b892-40bf-bb03-bf5a2fc271ba"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "890ca69a-4f01-4494-8119-79418f0db56e"],
 " \[LongDash] ",
 "the \"CountingMeasure\" and the \"RiemannianMeasure\" of a ball, shell or \
tube; the profiles are its Table over the radius"
}], "GuideText",ExpressionUUID->"8aa36c0e-13b9-41d9-9517-59e4c0182cf4"],

Cell[TextData[{
 "A region on a graph is measured by counting vertices, and its boundary is \
not negligible at a finite scale: the vertices at distance exactly ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "072e69af-097d-48db-89f7-adc6ff5c735a"],
 " are a share of order ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b9ac5a6-45e6-46cb-80f8-146c1cf519aa"],
 " of the ball of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3372c08d-ed53-4bb4-b5d3-52109f4db704"],
 ". So every region carries two measures. The counting measure is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Mu]", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["A", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   TemplateBox[{
     StyleBox["A", "TI"]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23ec5729-4a2f-4f4f-9119-fd523e234b03"],
 ". The Riemannian measure is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Mu]", "TI"], "\[SmallCircle]"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["A", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   TemplateBox[{
     SuperscriptBox[
      StyleBox["A", "TI"], "\[SmallCircle]"]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3037948-517c-40de-ac85-1cea395f2b6e"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["A", "TI"], "\[SmallCircle]"], "=", "{", 
    StyleBox["v", "TI"], "\[Element]", 
    StyleBox["A", "TI"]}], ":", 
   RowBox[{
    StyleBox["N", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[SubsetEqual]", 
    StyleBox["A", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f416f3b4-38a3-4100-acde-de338ae1daf8"],
 " is the set of vertices all of whose neighbours lie in ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166dcf79-2926-4424-8fd8-3d0ce25b3213"],
 "; it is the count without the boundary and the default of the growth \
estimators."
}], "GuideText",ExpressionUUID->"1716df3c-96c9-4630-8858-495e4e87f0c8"],

Cell[TextData[{
 "On the square grid the ball of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d20453f8-92f9-4331-8fcf-48b4e87cf5c3"],
 " has counting measure ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "+", "2", 
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9819ae7e-950d-4c27-9056-9f5bae637826"],
 " and Riemannian measure ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "-", "2", 
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce28a822-9811-4626-ac62-e2df2c8da933"],
 ", the counting measure of the ball of radius ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "953f85d2-4509-4b18-808c-55a6120fac2e"],
 "; the shell has counting measure ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68f04f0d-81f5-446c-b23b-a3c7a848c8a0"],
 " and Riemannian measure ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "011855cb-17dd-4a42-91aa-a11e2ba7cc4d"],
 ". The same shift holds on the triangular lattice before the rim, the \
convention of the Wolfram Physics technical introduction."
}], "GuideText",ExpressionUUID->"c258ebba-fe52-4655-987e-2094d9c5a62a"],

