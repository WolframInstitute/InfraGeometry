  "565109f9-d427-426f-829e-5ae55479dc35"],
 " \[LongDash] ",
 "the \"CountingMeasure\" and the \"RiemannianMeasure\" of a ball, shell or \
tube; the profiles are its Table over the radius"
}], "GuideText",ExpressionUUID->"8a3caf61-edf1-45e1-b616-dd1cbe3f75ae"],

Cell[TextData[{
 "A region on a graph is measured by counting vertices, and its boundary is \
not negligible at a finite scale: the vertices at distance exactly ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee0c0591-aab7-46ce-9325-7a31baefe390"],
 " are a share of order ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbbeb8da-73fe-4e29-91ca-2a86e810a66a"],
 " of the ball of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fbf0a3ed-0031-414e-b927-75912312dfd1"],
 ". So every region carries two measures. The counting measure is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Mu]", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["A", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   TemplateBox[{
     StyleBox["A", "TI"]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f50a9d9-8eab-4962-bcd1-2c25b68b24f1"],
 ". The Riemannian measure is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Mu]", "TI"], "\[SmallCircle]"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["A", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   TemplateBox[{
     SuperscriptBox[
      StyleBox["A", "TI"], "\[SmallCircle]"]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bc35ef6-e750-48cc-b736-ced023a308e8"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["A", "TI"], "\[SmallCircle]"], "=", "{", 
    StyleBox["v", "TI"], "\[Element]", 
    StyleBox["A", "TI"]}], ":", 
   RowBox[{
    StyleBox["N", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[SubsetEqual]", 
    StyleBox["A", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b371d392-44d0-4e2d-8d6c-d280a81ade16"],
 " is the set of vertices all of whose neighbours lie in ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd4424c6-5c59-4ef9-b2ec-c9859f6fbfbb"],
 "; it is the count without the boundary and the default of the growth \
estimators."
}], "GuideText",ExpressionUUID->"cd9789d8-2355-46ea-8dd0-60c7d3755984"],

Cell[TextData[{
 "On the square grid the ball of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3b28253-06b1-4545-be6e-8b3b62ef4f2c"],
 " has counting measure ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "+", "2", 
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ea91294-bca3-44b1-a436-4129412767b4"],
 " and Riemannian measure ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "-", "2", 
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9d883e4-2c83-4488-971b-52bf4f3b23dc"],
 ", the counting measure of the ball of radius ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da05dbff-55fa-45c0-9259-5557e6ebef3d"],
 "; the shell has counting measure ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4be2f14-3646-4f3d-bb40-48a003c344d8"],
 " and Riemannian measure ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d70dc6e-9952-4b90-9bcc-ad506f4ca678"],
 ". The same shift holds on the triangular lattice before the rim, the \
convention of the Wolfram Physics technical introduction."
}], "GuideText",ExpressionUUID->"f28b9ff6-6817-4b9e-a011-1b39f950ebf6"],

