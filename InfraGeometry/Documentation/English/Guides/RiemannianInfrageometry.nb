Cell[CellGroupData[{

Cell["Straight walks", "GuideFunctionsSubsection",ExpressionUUID->"46414974-b918-4bdb-bb94-41fc4bd71c18"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "aeaaa5f5-12a0-4185-9320-25318584abf2"],
 " \[LongDash] ",
 "walks grown from a germ; ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Geodesic\>\"", ",", " ", 
    RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "\[Beta]"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5df0fe4-d056-4f13-84a6-fc38de1697dc"],
 " weighs each step by its mean gain, and the bare ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9aa58023-b233-435a-96fb-eb2138376059"],
 " is a shortest path"
}], "GuideText",ExpressionUUID->"9d78031a-fff1-4d6a-b30a-2c4c8f61a442"],

Cell[TextData[{
 "A step from the tip ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["w", "TI"], 
   StyleBox["t", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02998451-897e-4dbe-b814-2cff658810eb"],
 " of the window ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["w", "TI"], "0"], ",", "\[Ellipsis]", ",", 
    SubscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["t", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f889548-924c-4c37-8118-cf4afe216eac"],
 " to a neighbour ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f22cbb5-0c0a-40f3-b7b4-47f57fc18be7"],
 " has the gain ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["i", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["w", "TI"], 
      StyleBox["i", "TI"]], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "-", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["w", "TI"], 
      StyleBox["i", "TI"]], ",", 
     SubscriptBox[
      StyleBox["w", "TI"], 
      StyleBox["t", "TI"]]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[Element]", "{", "-", "1"}], ",", "0", ",", 
   RowBox[{"1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56e2e99f-40b3-41e0-8837-52815dc38a65"],
 " against each earlier vertex, and the mean gain ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", 
    StyleBox["t", "TI"]], 
   UnderscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["i", "TI"], "<", 
     StyleBox["t", "TI"]}],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["i", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e00c7cd-e78c-44d3-b6d5-7e629b73448d"],
 "."
}], "GuideText",ExpressionUUID->"6d68cdb8-1c32-4202-b7ae-a8f86d0f85b8"],

Cell[TextData[{
 "The walk draws ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d4d4973-818e-42b1-9ec7-89580d4bef6b"],
 " with probability proportional to ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{
    StyleBox["\[Beta]", "TI"], 
    StyleBox["g", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78fc0ae3-a3a8-4fb4-9080-360878c29492"],
 ". Only differences of scores matter, so the mean gain ranks like the total \
distance ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["i", "TI"], "<", 
     StyleBox["t", "TI"]}],
    LimitsPositioning->False], 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["i", "TI"]], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80ec0cb9-2932-45b2-8d8f-f9c4592f4568"],
 " to the window, and the exponential is the only such weight."
}], "GuideText",ExpressionUUID->"23447938-ccab-4fcb-9f61-627166f73d0b"],

Cell[TextData[{
 "On a mesh whose path distance is a rounding of the Euclidean distance, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[TildeTilde]", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff3ffd34-e926-4d5f-9db8-618a5e5cf85a"],
 " for a turn by the angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bacead8f-c7b0-4e04-acfb-d0ee4d45dd00"],
 ", since the roundings up and down balance along a window not aligned with \
the mesh. The turning angle follows the von Mises distribution ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{
    StyleBox["\[Beta]", "TI"], 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[Theta]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "abde5fb2-c963-4b41-8db2-68b3fa2b9b26"],
 ", approximately Gaussian with variance ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Beta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa7c3331-e0c7-408f-9cd2-fb05424d0d9b"],
 "."
}], "GuideText",ExpressionUUID->"9d5e1cbe-acda-4eb7-b12d-7d2549e7e554"],

Cell[TextData[{
 "On the square grid a turn by ",
 Cell[BoxData[
  SuperscriptBox["90", "\[SmallCircle]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fff650e-6b3d-4348-b6a4-b727980da91e"],
 " has gain ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a530be02-2dd3-450c-9050-b618cfe7fc68"],
 " as well, and the straightest walks are staircases."
}], "GuideText",ExpressionUUID->"29139a92-e13a-43d4-9c27-a41d74b3aecf"]
}, Open  ]],

