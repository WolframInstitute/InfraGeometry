Cell[CellGroupData[{

Cell["Straight walks", "GuideFunctionsSubsection",ExpressionUUID->"e4ebfa50-afd3-40d5-9af0-5241221a3b15"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "643b59e0-9fc0-4a25-b3eb-1907fcd0a66e"],
 " \[LongDash] ",
 "walks grown from a germ; ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Geodesic\>\"", ",", " ", 
    RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "\[Beta]"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73136416-37c3-49ac-b05f-ed6ec028516a"],
 " weighs each step by its mean gain, and the bare ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3966e1b6-cebc-48a2-95c0-fe2f8bb58e65"],
 " is a shortest path"
}], "GuideText",ExpressionUUID->"d8834e4f-376f-46b8-8b6b-7cb03a62400b"],

Cell[TextData[{
 "A step from the tip ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["w", "TI"], 
   StyleBox["t", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cf624db-7c85-41b5-8834-f553cf8af20f"],
 " of the window ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["w", "TI"], "0"], ",", "\[Ellipsis]", ",", 
    SubscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["t", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4464c0cd-7b78-4aae-b831-38e2bedb0389"],
 " to a neighbour ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8947a14d-0727-4e68-b787-148d77a3a076"],
 " has the gain ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["i", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["w", "TI"], 
      StyleBox["i", "TI"]], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "-", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["w", "TI"], 
      StyleBox["i", "TI"]], ",", 
     SubscriptBox[
      StyleBox["w", "TI"], 
      StyleBox["t", "TI"]]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[Element]", "{", "-", "1"}], ",", "0", ",", 
   RowBox[{"1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1354505a-889b-48a8-9f5c-788f7d313849"],
 " against each earlier vertex, and the mean gain ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", 
    StyleBox["t", "TI"]], 
   UnderscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["i", "TI"], "<", 
     StyleBox["t", "TI"]}],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["i", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84041c03-26f4-46e5-93f7-e09bca604ca0"],
 "."
}], "GuideText",ExpressionUUID->"990f003b-053b-4810-9237-d4f121598660"],

Cell[TextData[{
 "The walk draws ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dd106c9-0c10-457e-ab9a-226beb9f9a08"],
 " with probability proportional to ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{
    StyleBox["\[Beta]", "TI"], 
    StyleBox["g", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1c71a36-ee8f-4e60-9b92-6665f506556d"],
 ". Only differences of scores matter, so the mean gain ranks like the total \
distance ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["i", "TI"], "<", 
     StyleBox["t", "TI"]}],
    LimitsPositioning->False], 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["i", "TI"]], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "edc95079-cc1f-4c2d-bea7-30a190d1290b"],
 " to the window, and the exponential is the only such weight."
}], "GuideText",ExpressionUUID->"c24bed50-36f5-43e3-99f1-798413b6da16"],

Cell[TextData[{
 "On a mesh whose path distance is a rounding of the Euclidean distance, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[TildeTilde]", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d11bee4-7b56-43bf-83fa-eb2f7767ccb5"],
 " for a turn by the angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "787871be-f431-4495-8309-961ee6f4ff48"],
 ", since the roundings up and down balance along a window not aligned with \
the mesh. The turning angle follows the von Mises distribution ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{
    StyleBox["\[Beta]", "TI"], 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[Theta]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b158b403-9250-4704-9e79-6d00ddfdfc28"],
 ", approximately Gaussian with variance ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Beta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b108ceb2-a1e0-402c-be85-12c9faa49298"],
 "."
}], "GuideText",ExpressionUUID->"f8622fdf-57bf-4bb4-aa98-3cc1bf2b8ca0"],

Cell[TextData[{
 "On the square grid a turn by ",
 Cell[BoxData[
  SuperscriptBox["90", "\[SmallCircle]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0c75008-3a2b-4da2-97f0-c7cd658b792e"],
 " has gain ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef47f3ea-ee74-4332-8565-90fbef7d92ba"],
 " as well, and the straightest walks are staircases."
}], "GuideText",ExpressionUUID->"804901f8-ae24-4d6e-a034-95728ddadbcb"]
}, Open  ]],

