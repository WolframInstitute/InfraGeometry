Cell[CellGroupData[{

Cell["The metric tensor", "GuideFunctionsSubsection",ExpressionUUID->"b6e5d35e-c1aa-4745-a3e9-2209421e97af"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMetricTensor"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMetricTensor", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "b981d6e9-df0e-40b0-94f4-95249c37d586"],
 " \[LongDash] ",
 "the matrix d(p, u) / d(p, v) over v, w with u the foot of v on the interval \
I(p, w); with r, over the shell of radius r; \"SelectCoordinate\" reads a tie \
of feet"
}], "GuideText",ExpressionUUID->"65f66093-49fa-4e71-8e99-071e1d7830bf"]
}, Open  ]],

