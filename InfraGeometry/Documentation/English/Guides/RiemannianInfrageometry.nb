}], "GuideText",ExpressionUUID->"1798773c-2052-4425-9016-9a66aa27eec0"],

Cell[TextData[{
 "A region on a graph is measured by counting vertices, and its boundary is \
not negligible at a finite scale: the vertices at distance exactly ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6241edfa-b8d0-40e6-b317-aef3210b5ebb"],
 " are a share of order ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb8c398d-7d13-4372-9362-2b0ee9560488"],
 " of the ball of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e26defe-a830-4c83-9683-17ab84368c3e"],
 ". So every region carries two measures. The counting measure is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Mu]", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["A", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   TemplateBox[{
     StyleBox["A", "TI"]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f3efab3-2d68-48fa-a796-bddfd26fc65c"],
 ". The Riemannian measure is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Mu]", "TI"], "\[SmallCircle]"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["A", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   TemplateBox[{
     SuperscriptBox[
      StyleBox["A", "TI"], "\[SmallCircle]"]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e50b207-3da0-4150-8d08-622e897cc888"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["A", "TI"], "\[SmallCircle]"], "=", "{", 
    StyleBox["v", "TI"], "\[Element]", 
    StyleBox["A", "TI"]}], ":", 
   RowBox[{
    StyleBox["N", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[SubsetEqual]", 
    StyleBox["A", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c6ecab4-ee5f-49ca-9c0a-ccddab799d37"],
 " is the set of vertices all of whose neighbours lie in ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "424a04f2-3583-4445-9736-5348f74624a6"],
 "; it is the count without the boundary and the default of the growth \
estimators."
}], "GuideText",ExpressionUUID->"11452dbe-8c01-428b-bd74-e74eee44894c"],

Cell[TextData[{
 "On the square grid the ball of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e96a75b0-3e9b-4d7d-9f5b-cd9c7569eb37"],
 " has counting measure ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "+", "2", 
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a35d80e8-60a6-4ce0-ae10-fc341399ab63"],
 " and Riemannian measure ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "-", "2", 
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fbdf573b-251d-4807-b417-92145cf2a915"],
 ", the counting measure of the ball of radius ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b90336a-c14c-4491-8d98-d36e7cb2a75f"],
 "; the shell has counting measure ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ce7171a-b239-46ba-96be-bfe71caeaaaf"],
 " and Riemannian measure ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4cd6d959-5c55-4476-86d9-3bc0b1e6de91"],
 ". The same shift holds on the triangular lattice before the rim, the \
convention of the Wolfram Physics technical introduction."
}], "GuideText",ExpressionUUID->"4328faa2-db23-4091-8075-747f58d67685"],

