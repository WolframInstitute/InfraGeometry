Cell[CellGroupData[{

Cell["Tech Notes", "GuideTutorialsSection",
 CellID->415694126,ExpressionUUID->"90fbef20-ae74-4ea3-a50b-de22929861f8"],

Cell[TextData[Cell[BoxData[
 TemplateBox[{
