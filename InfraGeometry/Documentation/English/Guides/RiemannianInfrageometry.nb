Cell[CellGroupData[{

Cell["Straight walks", "GuideFunctionsSubsection",ExpressionUUID->"f6690332-f710-49cf-bad2-266ba346c3fa"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "d3b3dd1a-b927-45c3-b104-94c231069491"],
 " \[LongDash] ",
 "walks grown from a germ; ",
 Cell[BoxData[
  RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "\[Beta]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c1df11b-5edf-4e0f-862b-46483e83402d"],
 " weighs each step by its mean gain"
}], "GuideText",ExpressionUUID->"d1df20a7-2877-499e-b42a-dd5ffa66da1b"],

Cell[TextData[{
 "A step from the tip ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["w", "TI"], 
   StyleBox["t", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd3f80c0-132f-4255-89f1-15f1e83a9f02"],
 " of the window ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["w", "TI"], "0"], ",", "\[Ellipsis]", ",", 
    SubscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["t", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "411572b0-825a-47c9-a895-a8c5a97672fc"],
 " to a neighbour ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc4de585-8272-406c-908e-34c3f792e69c"],
 " has the gain ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox["i", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["w", "TI"], 
      StyleBox["i", "TI"]], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "-", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["w", "TI"], 
      StyleBox["i", "TI"]], ",", 
     SubscriptBox[
      StyleBox["w", "TI"], 
      StyleBox["t", "TI"]]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[Element]", "{", "-", "1"}], ",", "0", ",", 
   RowBox[{"1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36103ebf-e7e5-42c1-b7e3-76350aec0d3f"],
 " against each earlier vertex, and the mean gain ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", 
    StyleBox["t", "TI"]], 
   UnderscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["i", "TI"], "<", 
     StyleBox["t", "TI"]}],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["i", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ea11321-4cb6-46a2-9450-0f952b610016"],
 "."
}], "GuideText",ExpressionUUID->"b01670c0-f0f0-492d-b2fc-e206a13f23b8"],

Cell[TextData[{
 "The walk draws ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48cfd160-dcd1-4cb3-9396-b45d96f060ed"],
 " with probability proportional to ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{
    StyleBox["\[Beta]", "TI"], 
    StyleBox["g", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46da620e-7ee7-4bda-b842-83cf728c10c3"],
 ". Only differences of scores matter, so the mean gain ranks like the total \
distance ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["i", "TI"], "<", 
     StyleBox["t", "TI"]}],
    LimitsPositioning->False], 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["i", "TI"]], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "225eff3b-ff93-4385-80df-67cb690658a1"],
 " to the window, and the exponential is the only such weight."
}], "GuideText",ExpressionUUID->"7e945509-b18b-463a-b814-e4ddc07a4318"],

Cell[TextData[{
 "On a mesh whose path distance is a rounding of the Euclidean distance, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[TildeTilde]", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7b75e7f-3331-446f-b832-0f0cb7a1f41d"],
 " for a turn by the angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57712447-392a-4dad-952f-2af07e16b822"],
 ", since the roundings up and down balance along a window not aligned with \
the mesh. The turning angle follows the von Mises distribution ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{
    StyleBox["\[Beta]", "TI"], 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[Theta]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e781cfc-87d9-4077-b2ce-e630f7deb1eb"],
 ", approximately Gaussian with variance ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Beta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93e269c0-8431-4b7a-93ee-627950833d39"],
 "."
}], "GuideText",ExpressionUUID->"33e68a22-2273-44ed-a053-60f14b5e613b"],

Cell[TextData[{
 "On the square grid a turn by ",
 Cell[BoxData[
  SuperscriptBox["90", "\[SmallCircle]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa8d85a7-257f-4276-8bbb-438ed010c984"],
 " has gain ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f265acf-3e02-4985-b314-1f1bb85a296e"],
 " as well, and the straightest walks are staircases."
}], "GuideText",ExpressionUUID->"67388bd8-f773-4245-b506-f2a3c38acb66"]
}, Open  ]],

