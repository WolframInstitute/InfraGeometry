   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "17dc4c54-7e44-4742-bb88-c8fdb31a08b9"],
 " \[LongDash] ",
 "the shell {v : d(c, v) = r}, or the band {rmin, rmax}, as a sorted vertex \
list; the separating subsets of a shell are RandomInfraSphere on the \
Euclidean Infrageometry guide"
}], "GuideText",ExpressionUUID->"64f2d0ee-366d-4db0-a8b5-95aa8e4405da"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Volume measurements", "GuideFunctionsSubsection",ExpressionUUID->"542c96d6-0fa6-4465-9084-f3507d8fe86f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "9d19e111-71a4-43ff-9df5-d2bd594ad4d0"],
 " \[LongDash] ",
 "the \"CountingMeasure\" and the \"RiemannianMeasure\" of a ball, shell or \
tube; the profiles are its Table over the radius"
}], "GuideText",ExpressionUUID->"29c745d6-848b-4721-bb50-5f7a6ef2a698"],

Cell[TextData[{
 "A region on a graph is measured by counting vertices, and its boundary is \
not negligible at a finite scale: the vertices at distance exactly ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea6c74ac-ccb4-4df0-9756-f22519b10f8f"],
 " are a share of order ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5d0c934-486f-4c65-8f13-386b71dde68e"],
 " of the ball of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1fc9621-3504-4cfa-b33a-c053d7801c55"],
 ". So every region carries two measures. The counting measure is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Mu]", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["A", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   TemplateBox[{
     StyleBox["A", "TI"]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86b5e8b0-a057-4b6e-8bde-c7404530c6f2"],
 ". The Riemannian measure is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Mu]", "TI"], "\[SmallCircle]"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["A", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   TemplateBox[{
     SuperscriptBox[
      StyleBox["A", "TI"], "\[SmallCircle]"]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8a01f52-939f-4f01-a871-11c1b9f600fa"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["A", "TI"], "\[SmallCircle]"], "=", "{", 
    StyleBox["v", "TI"], "\[Element]", 
    StyleBox["A", "TI"]}], ":", 
   RowBox[{
    StyleBox["N", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[SubsetEqual]", 
    StyleBox["A", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d6b2393-1458-42d8-9417-ba311df62911"],
 " is the set of vertices all of whose neighbours lie in ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c992ab41-905b-4d7a-8051-2a098afccc5d"],
 "; it is the count without the boundary and the default of the growth \
estimators."
}], "GuideText",ExpressionUUID->"3d910c7d-b2fc-45e0-8736-82213391d84a"],

Cell[TextData[{
 "On the square grid the ball of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1feaba9f-3452-4660-8b1b-ba2e372644a4"],
 " has counting measure ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "+", "2", 
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4636070-1278-42b9-a5bc-232cbd940090"],
 " and Riemannian measure ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "-", "2", 
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cdd9586-852b-4d1d-ad0e-0beb845ffdc3"],
 ", the counting measure of the ball of radius ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9bde67c0-979e-4173-afd7-f46495b0bcf0"],
 "; the shell has counting measure ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "164e27ce-4162-4c81-8823-0d02f16b1af5"],
 " and Riemannian measure ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30950215-11ee-4157-819d-4fc40ba19b70"],
 ". The same shift holds on the triangular lattice before the rim, the \
convention of the Wolfram Physics technical introduction."
}], "GuideText",ExpressionUUID->"e2e9e35c-d521-4f5f-af59-a56940946d30"],

