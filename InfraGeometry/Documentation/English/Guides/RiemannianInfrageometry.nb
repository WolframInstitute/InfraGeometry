Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraGeodesic[...]"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic[...]", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "7fb3ce72-12d7-41db-b9a1-2e7b9d4b5f42"],
 " \[LongDash] ",
 "grows paths that are shortest in every window of ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c604fa5-2fe1-499e-864c-aec1586e4769"],
 " edges. Unlike smooth geodesics, a germ has many continuations. We ask for \
the least ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d14ff0a1-7f07-417c-be1f-d7e12f7cc453"],
 " at which the most visited paths become globally shortest: proposed ",
 Cell[BoxData[
  RowBox[{"InfraGeodesicStraighteningScale", "[", "...", "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62a07719-767d-441c-8764-4334e50c166f"],
 "."
}], "GuideText",ExpressionUUID->"ad829fc7-05e5-4470-8a63-ab7b35eb32aa"],

