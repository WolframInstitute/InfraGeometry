Cell[CellGroupData[{

Cell["Infrageodesics", "GuideFunctionsSubsection",ExpressionUUID->"d5b6f7e8-7f8b-4c20-b348-21150ed2bcdd"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "d986aa2a-e6f9-4ffd-b720-434f2a688fba"],
 " \[LongDash] ",
 "the geodesics at infra-scale s from p1, or from p1 to p2: every window of s \
consecutive vertices plus the next one is a shortest path; a trailing count \
gives a List of them"
}], "GuideText",ExpressionUUID->"5091b029-5868-4e12-8252-8eea8c324630"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraGeodesicQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraGeodesicQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "846ba6a7-f988-47ac-a1a7-0b55bb970235"],
 " \[LongDash] ",
 "whether a walk is a geodesic at infra-scale s; scale 1 is InfraWalkQ and \
Infinity is InfraSegmentQ"
}], "GuideText",ExpressionUUID->"39f601fd-29b2-472d-bad9-3f92481d0eb8"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExtendInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "193a826b-d916-4ec9-b3ce-0c9b47ab6224"],
 " \[LongDash] ",
 "continues a seed walk as a geodesic at infra-scale s, by a budget of edges \
per growing side"
}], "GuideText",ExpressionUUID->"40dbba5d-b3e3-404a-ab20-c9e33cec76bc"],

Cell[TextData[{
 StyleBox["GeodesicIntervalGraph",
  FontWeight->"Bold"],
 " \[LongDash] the metric interval I(u, v) = {w : d(u, w) + d(w, v) = d(u, \
v)} as a directed acyclic graph whose directed u-v paths are exactly the \
geodesics, built from the distance fields without listing them"
}], "GuideText",ExpressionUUID->"1d957b2e-7561-4b7d-a384-4fa1ca27f365"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GeodesicSprayGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/GeodesicSprayGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "4ed4f321-3d11-41f5-a29f-045195c8acb6"],
 " \[LongDash] ",
 "the breadth-first DAG rooted at c, whose source-to-sink paths are exactly \
the maximal geodesics from c; a list of pairs gives the union of their \
geodesics"
}], "GuideText",ExpressionUUID->"085e894c-0cc0-47cc-9d9b-4e42136bbaf2"]
}, Open  ]],

