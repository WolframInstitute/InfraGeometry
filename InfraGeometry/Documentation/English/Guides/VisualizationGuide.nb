Cell["InfraParallelQ", "Item",ExpressionUUID->"c9ce2f11-ea7f-437b-80bf-55b20e4b0542"],

Cell["InfraIntersectQ", "Item",ExpressionUUID->"67ff6007-2b09-4fb0-82f9-c2f18ca65fa8"],

