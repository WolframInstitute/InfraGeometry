Cell["Examples on large graphs", "Section",ExpressionUUID->"3821b253-e908-42ec-bbcc-6944ac3a6c40"],

Cell["\<\
One layered scene on three textures: metric ball (green), level shell (mint), \
canonical circle (teal), geodesic bundle (coral), and points (red) -- every \
wrapper family lands on its own palette channel, with count-diffusion doing \
the blending. The Wolfram-model universe admits no separating circle at this \
radius, so its panel shows the shortest level-surface cycles instead.\
\>", "Text",ExpressionUUID->"f305752d-6f3d-42d2-81cb-1a01badc3b09"],

Cell["Define the three substrates.", "CodeText",ExpressionUUID->"a9ff8819-da6a-4c32-9f32-a5201420cdc8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Needs", "[", "\"\<WolframInstitute`InfraGeometry`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<WolframInstitute`DiscreteGeometry`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"graphs", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"g", " ", "|->", " ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"h", " ", "=", " ", 
          RowBox[{"Graph", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
        "     ", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", "\n", "     ", 
         RowBox[{"Graph", "[", 
          RowBox[{"h", ",", " ", 
           RowBox[{"VertexCoordinates", " ", "->", " ", 
            RowBox[{"GraphEmbedding", "[", 
             RowBox[{"h", ",", " ", "\"\<SpringElectricalEmbedding\>\""}], 
             "]"}]}], ",", "\n", "       ", 
           RowBox[{"EdgeStyle", " ", "->", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"StandardGray", ",", " ", 
              RowBox[{"Opacity", "[", "0.15", "]"}]}], "]"}]}], ",", "\n", 
           "       ", 
           RowBox[{"VertexStyle", " ", "->", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"StandardGray", ",", " ", 
              RowBox[{"Opacity", "[", "0.3", "]"}]}], "]"}]}]}], "]"}]}]}], 
       "]"}]}], ")"}], " ", "/@", " ", 
    RowBox[{"{", "\n", "   ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"UniformLengthGraph", "[", 
         RowBox[{
          RowBox[{"Disk", "[", "]"}], ",", " ", "600"}], "]"}]}], ")"}], ",", 
      "\n", "   ", 
      RowBox[{"TessellationGraph", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"20", ",", " ", "15"}], "}"}]}], "]"}], ",", "\n", "   ", 
      RowBox[{"SimpleGraph", " ", "@", " ", 
       RowBox[{"UndirectedGraph", " ", "@", " ", 
        RowBox[{
         RowBox[{"ResourceFunction", "[", "\"\<HypergraphToGraph\>\"", "]"}], 
         "[", "\n", "     ", 
         RowBox[{
          RowBox[{"ResourceFunction", "[", "\"\<WolframModel\>\"", "]"}], "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"x", ",", " ", "z"}], "}"}]}], "}"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x", ",", " ", "z"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"x", ",", " ", "w"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"y", ",", " ", "w"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"z", ",", " ", "w"}], "}"}]}], "}"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", "13", ",",
            " ", "\"\<FinalState\>\""}], "]"}], "]"}]}]}]}], "}"}]}]}], 
  ";"}]}], "Code",
 InitializationCell->
  True,ExpressionUUID->"0d91232c-f52d-4819-8762-c95755abf821"],

Cell["\<\
Ball, shell, circle, bundle, and endpoints in one scene per substrate.\
\>", "CodeText",ExpressionUUID->"b3162466-4ce0-4187-b373-fac643978405"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"g", ",", "br", ",", "cr", ",", "d", ",", "seed"}], "}"}], ",", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"c", "=", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"SeedRandom", "[", "seed", "]"}], ";", 
              RowBox[{"FindInfraPoint", "[", 
               RowBox[{"g", ",", 
                RowBox[{"\"\<From\>\"", "\[Rule]", "\"\<Center\>\""}]}], 
               "]"}]}], ")"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"b", "=", 
            RowBox[{"FindInfraPoint", "[", 
             RowBox[{"g", ",", 
              RowBox[{"\"\<From\>\"", "\[Rule]", 
               RowBox[{"c", "\[Rule]", "d"}]}]}], "]"}]}], "}"}], ",", 
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"FindInfraBall", "[", 
                RowBox[{"g", ",", "c", ",", "br"}], "]"}], "\[Rule]", 
               "$InfraBallColor"}], ",", 
              RowBox[{
               RowBox[{"FindInfraShell", "[", 
                RowBox[{"g", ",", "c", ",", "cr"}], "]"}], "\[Rule]", 
               "$InfraShellColor"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Graph", "[", 
                   RowBox[{"DirectedEdge", "@@@", 
                    RowBox[{"Partition", "[", 
                    RowBox[{"#1", ",", "2", ",", "1", ",", "1"}], "]"}]}], 
                   "]"}], "&"}], ")"}], "/@", 
                RowBox[{"FindInfraCircle", "[", 
                 RowBox[{"g", ",", "c", ",", 
                  RowBox[{"\"\<Radius\>\"", "\[Rule]", "cr"}], ",", "All"}], 
                 "]"}]}], "\[Rule]", "$InfraCircleColor"}], ",", 
              RowBox[{
               RowBox[{"FindInfraSegment", "[", 
                RowBox[{"g", ",", "c", ",", "b"}], "]"}], "\[Rule]", 
               "$InfraSegmentColor"}], ",", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"c", ",", "b"}], "}"}], "\[Rule]", 
               "$InfraPointColor"}]}], "}"}], ",", 
            RowBox[{"ImageSize", "\[Rule]", "300"}]}], "]"}]}], "]"}]}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"graphs", ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"3", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "7", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3", ",", "5"}], "}"}]}], "}"}]}], "]"}], "}"}], ",", 
   RowBox[{"Spacings", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}]], "Input",ExpressionUUID->\
"f5e20a19-c611-4442-9657-032b29c06b11"],

Cell["\<\
Per-object style overrides: a rule with a Directive overrides the diffusion \
channel it names, and a scalar \"PointSizeRange\" pins the on-screen point \
size.\
\>", "CodeText",ExpressionUUID->"f589b6c6-1958-48a4-839b-3932d4476c38"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", "=", 
     RowBox[{
     "graphs", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
    "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"c", "=", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", 
         RowBox[{"\"\<From\>\"", "\[Rule]", "\"\<Center\>\""}]}], "]"}]}], 
      ")"}]}], "}"}], ",", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Graph", "[", 
            RowBox[{"DirectedEdge", "@@@", 
             RowBox[{"Partition", "[", 
              RowBox[{"#1", ",", "2", ",", "1", ",", "1"}], "]"}]}], "]"}], 
           "&"}], ")"}], "/@", 
         RowBox[{"FindInfraCircle", "[", 
          RowBox[{"g", ",", "c", ",", 
           RowBox[{"\"\<Radius\>\"", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"3", ",", "4"}], "}"}]}], ",", "All"}], "]"}]}], "\[Rule]", 
        RowBox[{"Directive", "[", 
         RowBox[{"$InfraCircleColor", ",", 
          RowBox[{"AbsoluteThickness", "[", "6", "]"}]}], "]"}]}], ",", 
       RowBox[{"c", "\[Rule]", "$InfraPointColor"}]}], "}"}], ",", 
     RowBox[{"\"\<PointSizeRange\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"14", ",", "14"}], "}"}]}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "300"}]}], "]"}]}], "]"}]], "Input",Expre\
ssionUUID->"f1723494-10b7-4ea8-86b7-a8aae5adf508"],

Cell["Tutorial", "Section",ExpressionUUID->"1091c861-5dd2-4c0b-bb54-adab9daf3a64"],

Cell["See VisualizationTutorial for runnable examples.", "Item",ExpressionUUID->"76915354-cffd-485e-92b3-c564f182fcab"]
