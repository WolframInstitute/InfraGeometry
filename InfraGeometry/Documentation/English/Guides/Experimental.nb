Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] VolumeGrowth.wl", "GuideFunctionsSubsection",ExpressionUUID->"a211c6c9-6581-4309-8f44-42688aaed43e"],

Cell[TextData[{
 StyleBox["BallHull",
  FontWeight->"Bold"],
 " \[LongDash] the ball hull of a vertex subset S of g"
}], "GuideText",ExpressionUUID->"5bf80e72-71e8-4f5b-9f97-3cd946ca378d"],

Cell[TextData[{
 StyleBox["CylinderVolumes",
  FontWeight->"Bold"],
 " \[LongDash] the matrix of cylinder volumes between every source-target pair"
}], "GuideText",ExpressionUUID->"e23f0b8c-45b7-4dd4-bd07-175fd60c607f"],

Cell[TextData[{
 StyleBox["IntervalVolumes",
  FontWeight->"Bold"],
 " \[LongDash] the volume profile of the interval between p and q, over the \
slack r"
}], "GuideText",ExpressionUUID->"d88395f7-1603-4f37-8c7b-cf7a0a958dcf"],

Cell[TextData[{
 StyleBox["GeodesicOccupation",
  FontWeight->"Bold"],
 " \[LongDash] the per-vertex geodesic occupation over a geodesic DAG"
}], "GuideText",ExpressionUUID->"d78ad00c-b297-43d4-99e6-0d0fdd6a310c"],

Cell[TextData[{
 StyleBox["GeodesicEdgeOccupation",
  FontWeight->"Bold"],
 " \[LongDash] the per-edge geodesic occupation over a geodesic DAG"
}], "GuideText",ExpressionUUID->"185dda92-9f84-4dda-a474-b0a0a0d4e170"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] TessellationGraphs.wl", \
"GuideFunctionsSubsection",ExpressionUUID->"d2910181-e8a7-488e-9220-\
d567c292ef5c"],

Cell[TextData[{
 StyleBox["TessellationCurvature",
  FontWeight->"Bold"],
 " \[LongDash] the combinatorial Gaussian curvature at a vertex of a {p, q} \
regular map or of a uniform map"
}], "GuideText",ExpressionUUID->"e3dc0246-96b5-4e2b-84e0-a5d53f871855"],

Cell[TextData[{
 StyleBox["TessellationEulerCharacteristic",
  FontWeight->"Bold"],
 " \[LongDash] the Euler characteristic V - E + F of the realised \
tessellation graph"
}], "GuideText",ExpressionUUID->"7278d7c0-ae7f-4790-a936-b059d889f668"],

Cell[TextData[{
 StyleBox["TessellationGenus",
  FontWeight->"Bold"],
 " \[LongDash] the orientable genus of the realised tessellation graph"
}], "GuideText",ExpressionUUID->"63e47cdd-2cc6-4bb4-b13f-e43bdac78976"],

Cell[TextData[{
 StyleBox["TessellationNeighborhoodGraph",
  FontWeight->"Bold"],
 " \[LongDash] the radius-r ball cut from the infinite regular {p, q} \
tessellation of its covering surface"
}], "GuideText",ExpressionUUID->"13298f7a-862d-4450-bd3e-5ba12d527255"],

Cell[TextData[{
 StyleBox["CosetEnumeration",
  FontWeight->"Bold"],
 " \[LongDash] the Todd-Coxeter index of a subgroup of the von Dyck group \
D(p, q, 2)"
}], "GuideText",ExpressionUUID->"3cd957f8-6136-4ac0-9589-fb6a8da867bf"],

Cell[TextData[{
 StyleBox["LowIndexMaps",
  FontWeight->"Bold"],
 " \[LongDash] every {p, q} map of index at most maxIndex up to isomorphism, \
by low-index subgroup enumeration"
}], "GuideText",ExpressionUUID->"e316c507-b7cc-447d-96f6-0e5fc1ea34f4"],

Cell[TextData[{
 StyleBox["RotationMapGraph",
  FontWeight->"Bold"],
 " \[LongDash] the 1-skeleton of the orientable map of a rotation pair {x, \
y}"
}], "GuideText",ExpressionUUID->"98b11f12-0472-4c0a-8e3c-090d41148309"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] Displacements.wl", "GuideFunctionsSubsection",ExpressionUUID->"f0f23804-905c-43e3-aebb-f39137d4724f"],

Cell[TextData[{
 StyleBox["DisplacementCompose",
  FontWeight->"Bold"],
 " \[LongDash] composes displacements as flows, the leftmost acting first"
}], "GuideText",ExpressionUUID->"2c298e27-e85f-4297-8043-0ca828323b7e"],

Cell[TextData[{
 StyleBox["DisplacementScale",
  FontWeight->"Bold"],
 " \[LongDash] scales displacement d by t"
}], "GuideText",ExpressionUUID->"948a3b73-8d25-4dd8-b8e1-0d3405ccb3a5"],

Cell[TextData[{
 StyleBox["DisplacementNegative",
  FontWeight->"Bold"],
 " \[LongDash] the metric negative of d"
}], "GuideText",ExpressionUUID->"afb39b6c-8c90-429d-9240-652185f98390"],

Cell[TextData[{
 StyleBox["DisplacementInverse",
  FontWeight->"Bold"],
 " \[LongDash] reverses the relation d"
}], "GuideText",ExpressionUUID->"65629493-982d-49bc-9886-ad0c26ebe647"],

Cell[TextData[{
 StyleBox["DisplacementSum",
  FontWeight->"Bold"],
 " \[LongDash] the bisector of the two composition orders of d1 and d2"
}], "GuideText",ExpressionUUID->"450e5ae8-d340-40bb-ba26-4d746950b91d"],

Cell[TextData[{
 StyleBox["DisplacementCommutator",
  FontWeight->"Bold"],
 " \[LongDash] the commutator loop of two displacements, selected by Method"
}], "GuideText",ExpressionUUID->"3097e587-5bfd-4ad8-b4cb-87ad112eac39"],

Cell[TextData[{
 StyleBox["DisplacementBracket",
  FontWeight->"Bold"],
 " \[LongDash] the scale-dependent metric bracket candidate, the commutator \
with Method -> \"Negative\""
}], "GuideText",ExpressionUUID->"1b810a52-a2bc-44b2-a60f-03537a44472d"],

Cell[TextData[{
 StyleBox["DisplacementMagnitude",
  FontWeight->"Bold"],
 " \[LongDash] the maximal step length of displacement d"
}], "GuideText",ExpressionUUID->"f901f164-6c69-4fef-baa3-3045689dd63e"],

Cell[TextData[{
 StyleBox["DisplacementReduce",
  FontWeight->"Bold"],
 " \[LongDash] contracts each value set of d to its metric centre, iterated \
to a fixed point"
}], "GuideText",ExpressionUUID->"34b1a562-5701-48f6-96ff-3a688b4ec212"],

Cell[TextData[{
 StyleBox["DisplacementSingleValuedQ",
  FontWeight->"Bold"],
 " \[LongDash] whether every value of displacement d is a single vertex"
}], "GuideText",ExpressionUUID->"709a923a-9a8e-4a8c-b27f-9c60eb2c46a1"],

Cell[TextData[{
 StyleBox["DisplacementBijectionQ",
  FontWeight->"Bold"],
 " \[LongDash] whether displacement d is a single-valued permutation of the \
vertex set"
}], "GuideText",ExpressionUUID->"ec7fdf45-8d7f-4cd6-a158-5b884f1a58ec"],

Cell[TextData[{
 StyleBox["DisplacementIsomorphismQ",
  FontWeight->"Bold"],
 " \[LongDash] whether displacement d is a graph automorphism of g"
}], "GuideText",ExpressionUUID->"2cd41840-b83b-4456-8bc8-10d4195e4005"],

Cell[TextData[{
 StyleBox["ContinuousDisplacementQ",
  FontWeight->"Bold"],
 " \[LongDash] tests k-continuity of displacement d"
}], "GuideText",ExpressionUUID->"c63dd20a-b312-49b6-8114-6146d4211eaf"],

Cell[TextData[{
 StyleBox["RandomDisplacement",
  FontWeight->"Bold"],
 " \[LongDash] generates a random continuous displacement of magnitude at \
most r"
}], "GuideText",ExpressionUUID->"ea5f9532-aa7c-4065-97c2-5fb72f16f236"],

Cell[TextData[{
 StyleBox["FindKillingDisplacement",
  FontWeight->"Bold"],
 " \[LongDash] finds the nontrivial graph automorphism of least displacement \
magnitude, as a displacement"
}], "GuideText",ExpressionUUID->"8c7c25e1-62a9-4a26-bd94-25eea56b0ac7"],

Cell[TextData[{
 StyleBox["KillingDisplacementMagnitude",
  FontWeight->"Bold"],
 " \[LongDash] the least magnitude of a nonidentity graph automorphism, or \
Infinity when g is asymmetric"
}], "GuideText",ExpressionUUID->"7fe05798-a227-496f-81ff-509d1796a3c2"],

Cell[TextData[{
 StyleBox["PolarDisplacements",
  FontWeight->"Bold"],
 " \[LongDash] the polar pair of radial and angular displacements at centre \
c"
}], "GuideText",ExpressionUUID->"4e4a0843-54a4-487c-bb92-b61ed84fd54b"],

Cell[TextData[{
 StyleBox["GradientDisplacement",
  FontWeight->"Bold"],
 " \[LongDash] the steepest-ascent displacement of a vertex function f"
}], "GuideText",ExpressionUUID->"1eb28f64-e659-44d9-b8b3-9fa5d1dd241d"],

Cell[TextData[{
 StyleBox["TranslationDisplacement",
  FontWeight->"Bold"],
 " \[LongDash] translates along the graph embedding"
}], "GuideText",ExpressionUUID->"62a0c5a6-238a-4d40-81ed-4763e9f23da7"],

Cell[TextData[{
 StyleBox["DisplacementPlot",
  FontWeight->"Bold"],
 " \[LongDash] draws displacement d as bent arcs over the graph's own \
embedding"
}], "GuideText",ExpressionUUID->"b33417ad-5bea-4098-9b03-7505bb257f1b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] Boundary.wl", "GuideFunctionsSubsection",ExpressionUUID->"133b3e56-2cfc-44a7-84fc-c707cbda4df7"],

Cell[TextData[{
 StyleBox["GraphBoundary",
  FontWeight->"Bold"],
 " \[LongDash] the inner vertex boundary of S in g, the vertices where an \
edge of g escapes S"
}], "GuideText",ExpressionUUID->"29fca054-8ab4-4468-ae2d-98d0822b60fd"],

Cell[TextData[{
 StyleBox["GraphInterior",
  FontWeight->"Bold"],
 " \[LongDash] the interior of S in g, S minus its GraphBoundary"
}], "GuideText",ExpressionUUID->"9b5e4da0-0805-4603-a30a-5b047df96337"],

Cell[TextData[{
 StyleBox["GraphExteriorBoundary",
  FontWeight->"Bold"],
 " \[LongDash] the exterior-boundary, rim, vertices of the whole graph, \
detected from vertex degrees"
}], "GuideText",ExpressionUUID->"0609afb2-d84e-4640-8996-bf08201c880b"],

Cell[TextData[{
 StyleBox["BoundarylessGraph",
  FontWeight->"Bold"],
 " \[LongDash] deletes every edge joining two rim vertices and then the \
vertices this isolates"
}], "GuideText",ExpressionUUID->"e65b8bda-fb08-4c58-bd08-4048e3e90a9a"],

Cell[TextData[{
 StyleBox["GraphEccentricities",
  FontWeight->"Bold"],
 " \[LongDash] the eccentricity of every vertex, in VertexList order"
}], "GuideText",ExpressionUUID->"7236b29e-52f1-475d-b5d9-3ec92d35561d"],

Cell[TextData[{
 StyleBox["CenterGraph",
  FontWeight->"Bold"],
 " \[LongDash] the substrate cut to a fraction q of the way out from its \
centre"
}], "GuideText",ExpressionUUID->"6e992c2d-513b-4c46-b0f1-6b5b3cfe0a0c"],

Cell[TextData[{
 StyleBox["RelativeEccentricity",
  FontWeight->"Bold"],
 " \[LongDash] the eccentricity of each vertex rescaled to run from 0 at the \
radius to 1 at the diameter"
}], "GuideText",ExpressionUUID->"f0e1c0df-3eb7-4fdd-8bce-8b963d2ea2ab"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] BallTopology.wl", "GuideFunctionsSubsection",ExpressionUUID->"0acd8308-0f33-4166-99c9-ed50a04656bc"],

Cell[TextData[{
 StyleBox["BallTopology",
  FontWeight->"Bold"],
 " \[LongDash] the Hasse diagram of the r-ball specialization preorder on the \
vertices of g"
}], "GuideText",ExpressionUUID->"194ad449-f802-48fe-82f7-986f10e9eff4"],

Cell[TextData[{
 StyleBox["TopologicalClosure",
  FontWeight->"Bold"],
 " \[LongDash] the closure of a vertex list in a specialization-preorder \
digraph"
}], "GuideText",ExpressionUUID->"4a6c116a-f0e5-4ca8-8ce6-ba4137343250"],

Cell[TextData[{
 StyleBox["TopologicalInterior",
  FontWeight->"Bold"],
 " \[LongDash] the interior of a vertex list in a specialization-preorder \
digraph"
}], "GuideText",ExpressionUUID->"7238e87b-8269-4e78-8733-d6bb17cf5ebe"],

Cell[TextData[{
 StyleBox["TopologicalBoundary",
  FontWeight->"Bold"],
 " \[LongDash] the two-sided boundary, closure minus interior, of a vertex \
list in a specialization-preorder digraph"
}], "GuideText",ExpressionUUID->"8e8b59f0-3f56-4beb-a907-99994faa3761"],

Cell[TextData[{
 StyleBox["TopologicalNeighborhood",
  FontWeight->"Bold"],
 " \[LongDash] the unique minimal open neighborhood of a vertex list in a \
specialization-preorder digraph"
}], "GuideText",ExpressionUUID->"8c7f03a1-af7a-4685-ae43-c8859bdc3799"],

Cell[TextData[{
 StyleBox["ContinuousMapQ",
  FontWeight->"Bold"],
 " \[LongDash] whether a vertex map is continuous from one preorder digraph \
to another"
}], "GuideText",ExpressionUUID->"73b8a92d-5ff9-4095-90fe-d0303de6836b"],

Cell[TextData[{
 StyleBox["TopologyGraph",
  FontWeight->"Bold"],
 " \[LongDash] draws g overlaid with the Hasse arrows of a \
specialization-preorder digraph"
}], "GuideText",ExpressionUUID->"4ccb9557-ce55-4c1f-8328-4c9c070d11ac"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] ExampleGraphs.wl", "GuideFunctionsSubsection",ExpressionUUID->"75413042-5155-427c-b681-19a3863f4175"],

Cell[TextData[{
 StyleBox["SierpinskiGraph",
  FontWeight->"Bold"],
 " \[LongDash] the trivalent Sierpinski graph"
}], "GuideText",ExpressionUUID->"839cb66d-95d8-48da-a631-6a8de3776d8b"],

Cell[TextData[{
 StyleBox["BetheGraph",
  FontWeight->"Bold"],
 " \[LongDash] the finite Bethe lattice, or Cayley tree, of n shells and \
coordination number z"
}], "GuideText",ExpressionUUID->"07d6ed3a-fa56-4ff1-b789-e118904d3291"],

Cell[TextData[{
 StyleBox["BranchingSequenceTree",
  FontWeight->"Bold"],
 " \[LongDash] the spherically symmetric rooted tree whose offspring count \
depends only on depth"
}], "GuideText",ExpressionUUID->"d4187001-e9ae-46ed-afdb-1a241858c43e"],

Cell[TextData[{
 StyleBox["InflateGraph",
  FontWeight->"Bold"],
 " \[LongDash] grows a fiber of extra vertices over every vertex of g and \
adds random edges between nearby fibers"
}], "GuideText",ExpressionUUID->"241b6dbb-8397-4a8d-a777-ef4121f5f018"],

Cell[TextData[{
 StyleBox["InflatedVertex",
  FontWeight->"Bold"],
