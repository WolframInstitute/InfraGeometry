Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] VolumeGrowth.wl", "GuideFunctionsSubsection",ExpressionUUID->"7733527d-4483-4b26-b9f6-d3159da43757"],

Cell[TextData[{
 StyleBox["BallHull",
  FontWeight->"Bold"],
 " \[LongDash] the ball hull of a vertex subset S of g"
}], "GuideText",ExpressionUUID->"220ec844-61c3-44d7-9027-381bcd423395"],

Cell[TextData[{
 StyleBox["CylinderVolumes",
  FontWeight->"Bold"],
 " \[LongDash] the matrix of cylinder volumes between every source-target pair"
}], "GuideText",ExpressionUUID->"c07a654f-d8c4-4827-923f-b2f8b581daf1"],

Cell[TextData[{
 StyleBox["IntervalVolumes",
  FontWeight->"Bold"],
 " \[LongDash] the volume profile of the interval between p and q, over the \
slack r"
}], "GuideText",ExpressionUUID->"104561ce-9aad-49f8-8817-4de6409e7057"],

Cell[TextData[{
 StyleBox["GeodesicOccupation",
  FontWeight->"Bold"],
 " \[LongDash] the per-vertex geodesic occupation over a geodesic DAG"
}], "GuideText",ExpressionUUID->"3b691e41-45db-48da-a533-6061cc25c344"],

Cell[TextData[{
 StyleBox["GeodesicEdgeOccupation",
  FontWeight->"Bold"],
 " \[LongDash] the per-edge geodesic occupation over a geodesic DAG"
}], "GuideText",ExpressionUUID->"add7343b-22eb-4268-a70c-cc6832253dfe"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] TessellationGraphs.wl", \
"GuideFunctionsSubsection",ExpressionUUID->"3ddec329-4cc8-4c78-a1d9-\
06c39b867673"],

Cell[TextData[{
 StyleBox["TessellationCurvature",
  FontWeight->"Bold"],
 " \[LongDash] the combinatorial Gaussian curvature at a vertex of a {p, q} \
regular map or of a uniform map"
}], "GuideText",ExpressionUUID->"66ccae9a-c790-477a-a8a7-abc9f2adc245"],

Cell[TextData[{
 StyleBox["TessellationEulerCharacteristic",
  FontWeight->"Bold"],
 " \[LongDash] the Euler characteristic V - E + F of the realised \
tessellation graph"
}], "GuideText",ExpressionUUID->"e27c4824-d3c8-48a6-a289-edc87105e3b9"],

Cell[TextData[{
 StyleBox["TessellationGenus",
  FontWeight->"Bold"],
 " \[LongDash] the orientable genus of the realised tessellation graph"
}], "GuideText",ExpressionUUID->"5a50c9db-e3af-4690-b503-de995d60832e"],

Cell[TextData[{
 StyleBox["TessellationNeighborhoodGraph",
  FontWeight->"Bold"],
 " \[LongDash] the radius-r ball cut from the infinite regular {p, q} \
tessellation of its covering surface"
}], "GuideText",ExpressionUUID->"fb5b83eb-30a2-4c87-8c12-ef8e47c66843"],

Cell[TextData[{
 StyleBox["CosetEnumeration",
  FontWeight->"Bold"],
 " \[LongDash] the Todd-Coxeter index of a subgroup of the von Dyck group \
D(p, q, 2)"
}], "GuideText",ExpressionUUID->"9f955019-9fea-4002-a1b3-26f47e4952cd"],

Cell[TextData[{
 StyleBox["LowIndexMaps",
  FontWeight->"Bold"],
 " \[LongDash] every {p, q} map of index at most maxIndex up to isomorphism, \
by low-index subgroup enumeration"
}], "GuideText",ExpressionUUID->"b7365edb-00fb-45f8-a4c1-25378c1326d5"],

Cell[TextData[{
 StyleBox["RotationMapGraph",
  FontWeight->"Bold"],
 " \[LongDash] the 1-skeleton of the orientable map of a rotation pair {x, \
y}"
}], "GuideText",ExpressionUUID->"6fbe7ab3-450d-4d29-8448-c3bd8fb60ba2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] Displacements.wl", "GuideFunctionsSubsection",ExpressionUUID->"6182249f-34e0-4153-b62e-36d5ce1d5c02"],

Cell[TextData[{
 StyleBox["DisplacementCompose",
  FontWeight->"Bold"],
 " \[LongDash] composes displacements as flows, the leftmost acting first"
}], "GuideText",ExpressionUUID->"03f5485d-d165-4d99-86f2-38a3381aa8cc"],

Cell[TextData[{
 StyleBox["DisplacementScale",
  FontWeight->"Bold"],
 " \[LongDash] scales displacement d by t"
}], "GuideText",ExpressionUUID->"8f2d849b-2d48-4bf4-9c1e-3cd5d1b8cf47"],

Cell[TextData[{
 StyleBox["DisplacementNegative",
  FontWeight->"Bold"],
 " \[LongDash] the metric negative of d"
}], "GuideText",ExpressionUUID->"5bf96553-bf10-477b-ac40-89f51aa303c5"],

Cell[TextData[{
 StyleBox["DisplacementInverse",
  FontWeight->"Bold"],
 " \[LongDash] reverses the relation d"
}], "GuideText",ExpressionUUID->"b328edc0-1f81-457e-88e1-47cf22a4a145"],

Cell[TextData[{
 StyleBox["DisplacementSum",
  FontWeight->"Bold"],
 " \[LongDash] the bisector of the two composition orders of d1 and d2"
}], "GuideText",ExpressionUUID->"34e928a2-1826-40a1-b023-a3bf6a5c0273"],

Cell[TextData[{
 StyleBox["DisplacementCommutator",
  FontWeight->"Bold"],
 " \[LongDash] the commutator loop of two displacements, selected by Method"
}], "GuideText",ExpressionUUID->"806adce4-ebd8-4b65-8825-d5f262eff9b8"],

Cell[TextData[{
 StyleBox["DisplacementBracket",
  FontWeight->"Bold"],
 " \[LongDash] the scale-dependent metric bracket candidate, the commutator \
with Method -> \"Negative\""
}], "GuideText",ExpressionUUID->"d4b6007c-6362-4ec3-bbe1-d0895d381d22"],

Cell[TextData[{
 StyleBox["DisplacementMagnitude",
  FontWeight->"Bold"],
 " \[LongDash] the maximal step length of displacement d"
}], "GuideText",ExpressionUUID->"5890beab-6c32-47ba-9d18-a1af24b6ffa5"],

Cell[TextData[{
 StyleBox["DisplacementReduce",
  FontWeight->"Bold"],
 " \[LongDash] contracts each value set of d to its metric centre, iterated \
to a fixed point"
}], "GuideText",ExpressionUUID->"0234fc7b-9393-4d6f-9234-309a45aa221c"],

Cell[TextData[{
 StyleBox["DisplacementSingleValuedQ",
  FontWeight->"Bold"],
 " \[LongDash] whether every value of displacement d is a single vertex"
}], "GuideText",ExpressionUUID->"87b9ed0d-366a-4c83-a5a4-63049c93f0f9"],

Cell[TextData[{
 StyleBox["DisplacementBijectionQ",
  FontWeight->"Bold"],
 " \[LongDash] whether displacement d is a single-valued permutation of the \
vertex set"
}], "GuideText",ExpressionUUID->"e36cd3d3-0d02-450d-9843-05601896be05"],

Cell[TextData[{
 StyleBox["DisplacementIsomorphismQ",
  FontWeight->"Bold"],
 " \[LongDash] whether displacement d is a graph automorphism of g"
}], "GuideText",ExpressionUUID->"cb0aa5af-9a04-4dcd-9506-68b938a4877b"],

Cell[TextData[{
 StyleBox["ContinuousDisplacementQ",
  FontWeight->"Bold"],
 " \[LongDash] tests k-continuity of displacement d"
}], "GuideText",ExpressionUUID->"742cced6-2fc1-4bb1-a096-ab3cc89bbcc0"],

Cell[TextData[{
 StyleBox["RandomDisplacement",
  FontWeight->"Bold"],
 " \[LongDash] generates a random continuous displacement of magnitude at \
most r"
}], "GuideText",ExpressionUUID->"e7fc620a-3b94-43ad-8acc-528e3557f81b"],

Cell[TextData[{
 StyleBox["FindKillingDisplacement",
  FontWeight->"Bold"],
 " \[LongDash] finds the nontrivial graph automorphism of least displacement \
magnitude, as a displacement"
}], "GuideText",ExpressionUUID->"ca3c2c73-1559-444e-8a7a-9888e03c4e90"],

Cell[TextData[{
 StyleBox["KillingDisplacementMagnitude",
  FontWeight->"Bold"],
 " \[LongDash] the least magnitude of a nonidentity graph automorphism, or \
Infinity when g is asymmetric"
}], "GuideText",ExpressionUUID->"2151766b-11d8-4bbc-a771-12a1127df0f7"],

Cell[TextData[{
 StyleBox["PolarDisplacements",
  FontWeight->"Bold"],
 " \[LongDash] the polar pair of radial and angular displacements at centre \
c"
}], "GuideText",ExpressionUUID->"b7b24d93-1f35-46f9-913c-d0d3346b5ba6"],

Cell[TextData[{
 StyleBox["GradientDisplacement",
  FontWeight->"Bold"],
 " \[LongDash] the steepest-ascent displacement of a vertex function f"
}], "GuideText",ExpressionUUID->"8c01d328-b05f-4c8c-aee7-b22df1d261da"],

Cell[TextData[{
 StyleBox["TranslationDisplacement",
  FontWeight->"Bold"],
 " \[LongDash] translates along the graph embedding"
}], "GuideText",ExpressionUUID->"7cdebb51-6209-4df0-a1ce-b8090b88f265"],

Cell[TextData[{
 StyleBox["DisplacementPlot",
  FontWeight->"Bold"],
 " \[LongDash] draws displacement d as bent arcs over the graph's own \
embedding"
}], "GuideText",ExpressionUUID->"81ec3921-a529-414a-aa19-a26b61505c06"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] Boundary.wl", "GuideFunctionsSubsection",ExpressionUUID->"300b96cd-c6c5-4fc6-9c98-4f0a017234d9"],

Cell[TextData[{
 StyleBox["GraphBoundary",
  FontWeight->"Bold"],
 " \[LongDash] the inner vertex boundary of S in g, the vertices where an \
edge of g escapes S"
}], "GuideText",ExpressionUUID->"073719a1-957f-4453-8681-4dfa71ec2dfd"],

Cell[TextData[{
 StyleBox["GraphInterior",
  FontWeight->"Bold"],
 " \[LongDash] the interior of S in g, S minus its GraphBoundary"
}], "GuideText",ExpressionUUID->"0f3de62a-ce36-42d0-bae6-22a71593b3fa"],

Cell[TextData[{
 StyleBox["GraphExteriorBoundary",
  FontWeight->"Bold"],
 " \[LongDash] the exterior-boundary, rim, vertices of the whole graph, \
detected from vertex degrees"
}], "GuideText",ExpressionUUID->"123c56b1-48d1-4cbe-9841-906fbc6fac5d"],

Cell[TextData[{
 StyleBox["BoundarylessGraph",
  FontWeight->"Bold"],
 " \[LongDash] deletes every edge joining two rim vertices and then the \
vertices this isolates"
}], "GuideText",ExpressionUUID->"5fa74d28-7aa7-4f61-8486-febb60207d14"],

Cell[TextData[{
 StyleBox["GraphEccentricities",
  FontWeight->"Bold"],
 " \[LongDash] the eccentricity of every vertex, in VertexList order"
}], "GuideText",ExpressionUUID->"5c92a92c-7060-4d68-bb48-68facf0f73d9"],

Cell[TextData[{
 StyleBox["CenterGraph",
  FontWeight->"Bold"],
 " \[LongDash] the substrate cut to a fraction q of the way out from its \
centre"
}], "GuideText",ExpressionUUID->"05592037-15f6-4745-a0c2-f201697ae0c1"],

Cell[TextData[{
 StyleBox["RelativeEccentricity",
  FontWeight->"Bold"],
 " \[LongDash] the eccentricity of each vertex rescaled to run from 0 at the \
radius to 1 at the diameter"
}], "GuideText",ExpressionUUID->"96e90e87-516f-4738-997c-975a8ce85703"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] BallTopology.wl", "GuideFunctionsSubsection",ExpressionUUID->"d7263735-7ac5-4bf9-82f5-5f154540b60f"],

Cell[TextData[{
 StyleBox["BallTopology",
  FontWeight->"Bold"],
 " \[LongDash] the Hasse diagram of the r-ball specialization preorder on the \
vertices of g"
}], "GuideText",ExpressionUUID->"9ecc2b65-e8e3-4912-96c0-06b5ceb17005"],

Cell[TextData[{
 StyleBox["TopologicalClosure",
  FontWeight->"Bold"],
 " \[LongDash] the closure of a vertex list in a specialization-preorder \
digraph"
}], "GuideText",ExpressionUUID->"f4729695-4695-4a9f-a315-f69a829124d8"],

Cell[TextData[{
 StyleBox["TopologicalInterior",
  FontWeight->"Bold"],
 " \[LongDash] the interior of a vertex list in a specialization-preorder \
digraph"
}], "GuideText",ExpressionUUID->"43ff568e-0ab8-4b57-b041-56952395d8cf"],

Cell[TextData[{
 StyleBox["TopologicalBoundary",
  FontWeight->"Bold"],
 " \[LongDash] the two-sided boundary, closure minus interior, of a vertex \
list in a specialization-preorder digraph"
}], "GuideText",ExpressionUUID->"846997be-a0bd-46c5-bdd0-19d961109f7a"],

Cell[TextData[{
 StyleBox["TopologicalNeighborhood",
  FontWeight->"Bold"],
 " \[LongDash] the unique minimal open neighborhood of a vertex list in a \
specialization-preorder digraph"
}], "GuideText",ExpressionUUID->"5d01acf0-bab7-473a-8be0-c6a792b0b80a"],

Cell[TextData[{
 StyleBox["ContinuousMapQ",
  FontWeight->"Bold"],
 " \[LongDash] whether a vertex map is continuous from one preorder digraph \
to another"
}], "GuideText",ExpressionUUID->"80c574c6-d5fd-4e20-bbbd-c401148e81fa"],

Cell[TextData[{
 StyleBox["TopologyGraph",
  FontWeight->"Bold"],
 " \[LongDash] draws g overlaid with the Hasse arrows of a \
specialization-preorder digraph"
}], "GuideText",ExpressionUUID->"697e29ae-4c6f-4bd6-89ea-8e4196532f3b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] ExampleGraphs.wl", "GuideFunctionsSubsection",ExpressionUUID->"e0ca2fd5-9d2e-45a5-816d-8c0b75628532"],

Cell[TextData[{
 StyleBox["SierpinskiGraph",
  FontWeight->"Bold"],
 " \[LongDash] the trivalent Sierpinski graph"
}], "GuideText",ExpressionUUID->"cd5f4d0e-e6cb-4d5e-a53f-08fbbffb5045"],

Cell[TextData[{
 StyleBox["BetheGraph",
  FontWeight->"Bold"],
 " \[LongDash] the finite Bethe lattice, or Cayley tree, of n shells and \
coordination number z"
}], "GuideText",ExpressionUUID->"1e10bce8-1964-4315-a31b-016177a456fe"],

Cell[TextData[{
 StyleBox["BranchingSequenceTree",
  FontWeight->"Bold"],
 " \[LongDash] the spherically symmetric rooted tree whose offspring count \
depends only on depth"
}], "GuideText",ExpressionUUID->"843a9220-7384-4889-80fa-9182f7f040ef"],

Cell[TextData[{
 StyleBox["InflateGraph",
  FontWeight->"Bold"],
 " \[LongDash] grows a fiber of extra vertices over every vertex of g and \
adds random edges between nearby fibers"
}], "GuideText",ExpressionUUID->"b60fefe5-981a-415e-abee-863a0d4a4841"],

Cell[TextData[{
 StyleBox["InflatedVertex",
  FontWeight->"Bold"],
 " \[LongDash] the i-th fiber vertex over base vertex v in a graph produced \
