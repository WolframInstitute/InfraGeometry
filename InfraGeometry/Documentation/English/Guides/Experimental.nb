Cell["Riemannian \[CenterDot] VolumeGrowth.wl", "GuideFunctionsSubsection",ExpressionUUID->"386f87f1-5c10-463a-ab56-592fa5607753"],

Cell[TextData[{
 StyleBox["CylinderVolumes",
  FontWeight->"Bold"],
 " \[LongDash] the matrix of cylinder volumes between every source-target pair"
}], "GuideText",ExpressionUUID->"4f6be144-ae00-4439-b5e3-66a2bb45560f"],

Cell[TextData[{
 StyleBox["IntervalVolumes",
  FontWeight->"Bold"],
 " \[LongDash] the volume profile of the interval between p and q, over the \
slack r"
}], "GuideText",ExpressionUUID->"9224ef60-9cbc-46a4-97b0-a68f0f5e7089"],

Cell[TextData[{
 StyleBox["GeodesicOccupation",
  FontWeight->"Bold"],
 " \[LongDash] the per-vertex geodesic occupation over a geodesic DAG"
}], "GuideText",ExpressionUUID->"c0b456e3-1455-44eb-b4c0-7498c66eab14"],

Cell[TextData[{
 StyleBox["GeodesicEdgeOccupation",
  FontWeight->"Bold"],
 " \[LongDash] the per-edge geodesic occupation over a geodesic DAG"
}], "GuideText",ExpressionUUID->"95a6f4e5-00a3-499c-bc69-feeed0e5f576"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] TessellationGraphs.wl", \
"GuideFunctionsSubsection",ExpressionUUID->"4293be59-bcbf-46e8-b6cc-\
b7d7e7c5218e"],

Cell[TextData[{
 StyleBox["CosetEnumeration",
  FontWeight->"Bold"],
 " \[LongDash] the Todd-Coxeter index of a subgroup of the von Dyck group \
D(p, q, 2)"
}], "GuideText",ExpressionUUID->"6d66c0cb-76d3-4997-8e5d-4dd960dcec0e"],

Cell[TextData[{
 StyleBox["LowIndexMaps",
  FontWeight->"Bold"],
 " \[LongDash] every {p, q} map of index at most maxIndex up to isomorphism, \
by low-index subgroup enumeration"
}], "GuideText",ExpressionUUID->"c2eef870-4f48-4b64-9789-bd89013cca22"],

Cell[TextData[{
 StyleBox["RotationMapGraph",
  FontWeight->"Bold"],
 " \[LongDash] the 1-skeleton of the orientable map of a rotation pair {x, \
y}"
}], "GuideText",ExpressionUUID->"5a1d8a83-a48a-446d-bba0-c4157522f30c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] Boundary.wl", "GuideFunctionsSubsection",ExpressionUUID->"670f4d09-8e65-45c0-a637-42afb5417feb"],

Cell[TextData[{
 StyleBox["GraphBoundary",
  FontWeight->"Bold"],
 " \[LongDash] the inner vertex boundary of S in g, the vertices where an \
edge of g escapes S"
}], "GuideText",ExpressionUUID->"c3bdb308-e5e6-4954-8b6a-c88c255865e6"],

Cell[TextData[{
 StyleBox["GraphInterior",
  FontWeight->"Bold"],
 " \[LongDash] the interior of S in g, S minus its GraphBoundary"
}], "GuideText",ExpressionUUID->"59004556-ed24-49e0-ba24-4415a2b503e5"],

Cell[TextData[{
 StyleBox["GraphExteriorBoundary",
  FontWeight->"Bold"],
 " \[LongDash] the exterior-boundary, rim, vertices of the whole graph, \
detected from vertex degrees"
}], "GuideText",ExpressionUUID->"3c2a2b1d-2558-4074-918e-fc1c007ff88c"],

Cell[TextData[{
 StyleBox["BoundarylessGraph",
  FontWeight->"Bold"],
 " \[LongDash] deletes every edge joining two rim vertices and then the \
vertices this isolates"
}], "GuideText",ExpressionUUID->"b4ab9f04-72a4-4774-9026-98a99aa003c8"],

Cell[TextData[{
 StyleBox["GraphEccentricities",
  FontWeight->"Bold"],
 " \[LongDash] the eccentricity of every vertex, in VertexList order"
}], "GuideText",ExpressionUUID->"46ac0288-8724-42ff-8216-4a85d1a6a925"],

Cell[TextData[{
 StyleBox["CenterGraph",
  FontWeight->"Bold"],
 " \[LongDash] the substrate cut to a fraction q of the way out from its \
centre"
}], "GuideText",ExpressionUUID->"ec3dbdb6-8fab-45b7-9e25-d2f34e5e4568"],

Cell[TextData[{
 StyleBox["RelativeEccentricity",
  FontWeight->"Bold"],
 " \[LongDash] the eccentricity of each vertex rescaled to run from 0 at the \
radius to 1 at the diameter"
}], "GuideText",ExpressionUUID->"621b0ea3-4a99-45df-91e9-dc065029c9b4"]
}, Open  ]],

