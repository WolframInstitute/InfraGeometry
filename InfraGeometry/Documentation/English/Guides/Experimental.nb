}], "GuideText",ExpressionUUID->"912dc674-6e90-4545-be9e-509f75475fe7"],

Cell[TextData[{
 StyleBox["CochainCupOne",
  FontWeight->"Bold"],
 " \[LongDash] the Steenrod cup-1 product of ordered cochains"
}], "GuideText",ExpressionUUID->"33f9a711-f864-4be0-8f54-9b54520820d9"],

Cell[TextData[{
 StyleBox["AntisymmetrizedCup",
  FontWeight->"Bold"],
