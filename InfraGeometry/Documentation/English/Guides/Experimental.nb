}], "GuideText",ExpressionUUID->"3940ef80-7704-46a6-9602-913f85d63304"],

Cell[TextData[{
 StyleBox["CochainCup",
  FontWeight->"Bold"],
 " \[LongDash] the cup product of alternating cochains"
}], "GuideText",ExpressionUUID->"dcdf2696-7145-418c-9347-6a9e242b83d7"],

Cell[TextData[{
 StyleBox["OrderedCochainCup",
