}], "GuideText",ExpressionUUID->"91408cb0-a8f3-47b0-8fe6-961ebe34260e"],

Cell[TextData[{
 StyleBox["Coboundary",
  FontWeight->"Bold"],
 " \[LongDash] the coboundary of cochain a"
}], "GuideText",ExpressionUUID->"ebf45515-cae3-4754-b7cf-71f75b1ef4a5"],

Cell[TextData[{
 StyleBox["FormDifferential",
  FontWeight->"Bold"],
