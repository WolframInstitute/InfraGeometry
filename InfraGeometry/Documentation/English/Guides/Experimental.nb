}], "GuideText",ExpressionUUID->"5c44d952-050b-4e10-b976-1ed64ef3c4a0"],

Cell[TextData[{
 StyleBox["CochainCup",
  FontWeight->"Bold"],
 " \[LongDash] the cup product of alternating cochains"
}], "GuideText",ExpressionUUID->"87fda697-a991-45be-a0ab-7828ae8caf91"],

Cell[TextData[{
 StyleBox["OrderedCochainCup",
  FontWeight->"Bold"],
