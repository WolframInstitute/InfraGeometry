Cell[CellGroupData[{

Cell["Experimental \[CenterDot] OllivierCurvature.wl", \
"GuideFunctionsSubsection",ExpressionUUID->"e1b091e8-9b96-4357-8e4a-\
ed614ad2435b"],

Cell[TextData[{
 StyleBox["OllivierRicciCurvature",
  FontWeight->"Bold"],
 " \[LongDash] the Ollivier-Ricci curvature of every edge, with the uniform \
measure on each neighbourhood"
}], "GuideText",ExpressionUUID->"704a655d-329a-48df-b6aa-c8a071db00cc"],

Cell[TextData[{
 StyleBox["EffectiveResistance",
  FontWeight->"Bold"],
 " \[LongDash] the Klein-Randic resistance distance R(u, v), from the \
pseudoinverse of the graph Laplacian"
}], "GuideText",ExpressionUUID->"9614ef7f-c82e-4bfb-804d-6feb992326f3"],

Cell[TextData[{
 StyleBox["ResistanceQ",
  FontWeight->"Bold"],
 " \[LongDash] whether a symmetric matrix with zero diagonal is realisable as \
a resistance distance matrix"
}], "GuideText",ExpressionUUID->"dc97fcfe-e468-48f4-8be9-2ed0ed8ba77a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Experimental \[CenterDot] DifferentialForms.wl", \
"GuideFunctionsSubsection",ExpressionUUID->"15dc9cb5-90ad-4d75-8e02-\
47707eb5963d"],

Cell[TextData[{
 StyleBox["FormValue",
  FontWeight->"Bold"],
 " \[LongDash] the value of the germ of a form at a vertex on a tuple of its \
neighbours, alternating in the tuple"
}], "GuideText",ExpressionUUID->"fc4ca8c3-41ee-40a9-a794-a5bbb2148634"],

Cell[TextData[{
 StyleBox["CochainValue",
  FontWeight->"Bold"],
 " \[LongDash] the value of an alternating cochain on a vertex tuple"
}], "GuideText",ExpressionUUID->"35f9726c-b6eb-4b1b-8438-03c75fb29604"],

Cell[TextData[{
 StyleBox["OrderedCochainValue",
  FontWeight->"Bold"],
 " \[LongDash] the value of an ordered cochain on an increasing vertex tuple"
}], "GuideText",ExpressionUUID->"e9bf22a4-b461-49a7-a473-02df852c13b1"],

Cell[TextData[{
 StyleBox["FormDegree",
  FontWeight->"Bold"],
 " \[LongDash] the degree of a form"
}], "GuideText",ExpressionUUID->"94c0df26-50e9-4efe-97a0-8e37ea338f68"],

Cell[TextData[{
 StyleBox["CochainDegree",
  FontWeight->"Bold"],
 " \[LongDash] the degree of a cochain"
}], "GuideText",ExpressionUUID->"cf9b0059-9def-4418-ab0a-25e97a3945b8"],

Cell[TextData[{
 StyleBox["ZeroForm",
  FontWeight->"Bold"],
 " \[LongDash] a vertex function as a 0-form"
}], "GuideText",ExpressionUUID->"0185cb24-6a98-404d-a9ff-565c725cd167"],

Cell[TextData[{
 StyleBox["RestrictionMap",
  FontWeight->"Bold"],
 " \[LongDash] the form read from an alternating cochain with the base vertex \
prepended"
}], "GuideText",ExpressionUUID->"8d49c4b1-c70e-4e3c-9dab-632fc2363e20"],

Cell[TextData[{
 StyleBox["IntegrationMap",
  FontWeight->"Bold"],
 " \[LongDash] the cochain averaged from the germs of a form over each \
clique, a left inverse of RestrictionMap"
}], "GuideText",ExpressionUUID->"622023ab-9b21-4abe-9401-80d9122a810b"],

Cell[TextData[{
 StyleBox["Coboundary",
  FontWeight->"Bold"],
 " \[LongDash] the coboundary of a cochain, the alternating sum over the \
faces of every clique one dimension up"
}], "GuideText",ExpressionUUID->"bb7f8414-d968-47b9-a148-b8f3ba1747c5"],

Cell[TextData[{
 StyleBox["FormDifferential",
  FontWeight->"Bold"],
 " \[LongDash] the differential of a form, the gradient on 0-forms and with a \
transport term on 1-forms"
}], "GuideText",ExpressionUUID->"efe27e35-2603-4138-93c7-0a749355503f"],

Cell[TextData[{
 StyleBox["NaiveDifferential",
  FontWeight->"Bold"],
 " \[LongDash] the differential of a 1-form with the transport term dropped, \
kept for comparison"
}], "GuideText",ExpressionUUID->"45c508e6-522c-44d2-952f-6735d6d6007d"],

Cell[TextData[{
 StyleBox["FormWedge",
  FontWeight->"Bold"],
 " \[LongDash] the wedge product of forms, fibre by fibre"
}], "GuideText",ExpressionUUID->"548374e4-b53a-44a5-87d9-c0b92a1e2708"],

Cell[TextData[{
 StyleBox["CochainCup",
  FontWeight->"Bold"],
 " \[LongDash] the cup product of alternating cochains, antisymmetrised over \
the orderings of each clique"
}], "GuideText",ExpressionUUID->"14e36596-bf01-4a13-af3e-217364f65a4d"],

Cell[TextData[{
 StyleBox["OrderedCochainCup",
  FontWeight->"Bold"],
 " \[LongDash] the Alexander-Whitney cup product of ordered cochains"
}], "GuideText",ExpressionUUID->"2f6161f7-4ca4-46f2-8877-ccbad5fea31a"],

Cell[TextData[{
 StyleBox["CochainCupOne",
  FontWeight->"Bold"],
 " \[LongDash] the Steenrod cup-1 product of ordered cochains"
}], "GuideText",ExpressionUUID->"085bf09f-2e14-4655-ba35-08318f1af33d"],

Cell[TextData[{
 StyleBox["AntisymmetrizedCup",
  FontWeight->"Bold"],
 " \[LongDash] an alias of CochainCup"
}], "GuideText",ExpressionUUID->"ab00b74e-d1f5-45ee-821b-c47ed502243e"]
}, Open  ]]
}, Open  ]],

