Notebook[{

Cell[CellGroupData[{
Cell["Experimental Functions", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell["\<\
Every exported symbol that no other guide of the site covers, one section per \
kernel file: the synthetic branch first, then the Riemannian branch, then the \
infrastructure. The symplectic branch has no code yet. Each entry is the \
symbol's usage message cut to one line. A linked name opens its existing \
reference page, which has not been revised for this site; a name in bold has \
no reference page.\
\>", "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

