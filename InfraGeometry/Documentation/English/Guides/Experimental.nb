}], "GuideText",ExpressionUUID->"dae6d111-1bdb-4079-9307-16da7d902aa0"],

Cell[TextData[{
 StyleBox["NaiveDifferential",
  FontWeight->"Bold"],
 " \[LongDash] the differential of a 1-form with the transport term dropped"
}], "GuideText",ExpressionUUID->"4be8ca40-b647-493c-ac93-fd710c94af49"],

Cell[TextData[{
 StyleBox["FormWedge",
  FontWeight->"Bold"],
 " \[LongDash] the wedge product of forms, the exterior product on each \
