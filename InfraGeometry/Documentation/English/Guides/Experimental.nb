Notebook[{

Cell[CellGroupData[{
Cell["Experimental Functions", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell["\<\
Research functions not yet settled into a branch: walks and their \
singularities, osculating shells, the space of walks near a reference curve, \
the homotopy of walks by elementary moves, shortest-path counts and medians, \
vertex boundaries and eccentricities, metric coordinates and the metric \
dimension, Ollivier-Ricci curvature and effective resistance, and \
differential forms and cochains on the cliques of a graph.\
\>", "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

