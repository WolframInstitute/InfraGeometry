}], "GuideText",ExpressionUUID->"72a468a4-dac2-4309-b31e-84cb0756e6b1"],

Cell[TextData[{
 StyleBox["CochainCup",
  FontWeight->"Bold"],
 " \[LongDash] the cup product of alternating cochains"
}], "GuideText",ExpressionUUID->"784e6219-088a-4092-82c5-71fc60e92e8d"],

Cell[TextData[{
 StyleBox["OrderedCochainCup",
  FontWeight->"Bold"],
