Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] VolumeGrowth.wl", "GuideFunctionsSubsection",ExpressionUUID->"503303ee-d8dc-46b1-a7d3-40713fa26296"],

Cell[TextData[{
 StyleBox["BallHull",
  FontWeight->"Bold"],
 " \[LongDash] the ball hull of a vertex subset S of g"
}], "GuideText",ExpressionUUID->"f57ee51b-482d-4875-ada1-348e751a1819"],

Cell[TextData[{
 StyleBox["CylinderVolumes",
  FontWeight->"Bold"],
 " \[LongDash] the matrix of cylinder volumes between every source-target pair"
}], "GuideText",ExpressionUUID->"d9e9f343-df4c-407c-8246-b2351bccb513"],

Cell[TextData[{
 StyleBox["IntervalVolumes",
  FontWeight->"Bold"],
 " \[LongDash] the volume profile of the interval between p and q, over the \
slack r"
}], "GuideText",ExpressionUUID->"6339829a-85b0-4b0d-bdba-d59d42af8a96"],

Cell[TextData[{
 StyleBox["GeodesicOccupation",
  FontWeight->"Bold"],
 " \[LongDash] the per-vertex geodesic occupation over a geodesic DAG"
}], "GuideText",ExpressionUUID->"7db744e6-f8cf-4dd7-93fb-c3f1c95d7fe3"],

Cell[TextData[{
 StyleBox["GeodesicEdgeOccupation",
  FontWeight->"Bold"],
 " \[LongDash] the per-edge geodesic occupation over a geodesic DAG"
}], "GuideText",ExpressionUUID->"9d95c5d5-155e-439c-be9a-00036247f16c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] TessellationGraphs.wl", \
"GuideFunctionsSubsection",ExpressionUUID->"bedac42f-abe1-4767-9ea7-\
6f595576134d"],

Cell[TextData[{
 StyleBox["TessellationCurvature",
  FontWeight->"Bold"],
 " \[LongDash] the combinatorial Gaussian curvature at a vertex of a {p, q} \
regular map or of a uniform map"
}], "GuideText",ExpressionUUID->"7935fcdd-5f10-4fae-a414-0c799323a6b8"],

Cell[TextData[{
 StyleBox["TessellationEulerCharacteristic",
  FontWeight->"Bold"],
 " \[LongDash] the Euler characteristic V - E + F of the realised \
tessellation graph"
}], "GuideText",ExpressionUUID->"7eaec6af-8989-4a42-aca2-216eea1f9f19"],

Cell[TextData[{
 StyleBox["TessellationGenus",
  FontWeight->"Bold"],
 " \[LongDash] the orientable genus of the realised tessellation graph"
}], "GuideText",ExpressionUUID->"d013bedb-e297-40c1-9f87-427aa7c8bd1e"],

Cell[TextData[{
 StyleBox["TessellationNeighborhoodGraph",
  FontWeight->"Bold"],
 " \[LongDash] the radius-r ball cut from the infinite regular {p, q} \
tessellation of its covering surface"
}], "GuideText",ExpressionUUID->"fd3c4aa7-518d-41a6-ab22-1ba8553c8d88"],

Cell[TextData[{
 StyleBox["CosetEnumeration",
  FontWeight->"Bold"],
 " \[LongDash] the Todd-Coxeter index of a subgroup of the von Dyck group \
D(p, q, 2)"
}], "GuideText",ExpressionUUID->"12b009c7-712a-4b91-abdb-87d45c26490b"],

Cell[TextData[{
 StyleBox["LowIndexMaps",
  FontWeight->"Bold"],
 " \[LongDash] every {p, q} map of index at most maxIndex up to isomorphism, \
by low-index subgroup enumeration"
}], "GuideText",ExpressionUUID->"0908b304-972f-4db0-a2d4-176a9fc72487"],

Cell[TextData[{
 StyleBox["RotationMapGraph",
  FontWeight->"Bold"],
 " \[LongDash] the 1-skeleton of the orientable map of a rotation pair {x, \
y}"
}], "GuideText",ExpressionUUID->"596bb240-aa4f-4792-90e1-3eac39601166"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] Displacements.wl", "GuideFunctionsSubsection",ExpressionUUID->"a7520608-9b7f-4aaa-8c18-0ebfe35d4481"],

Cell[TextData[{
 StyleBox["DisplacementCompose",
  FontWeight->"Bold"],
 " \[LongDash] composes displacements as flows, the leftmost acting first"
}], "GuideText",ExpressionUUID->"5d7140ea-8416-466e-ba1a-4fa63da3e7d8"],

Cell[TextData[{
 StyleBox["DisplacementScale",
  FontWeight->"Bold"],
 " \[LongDash] scales displacement d by t"
}], "GuideText",ExpressionUUID->"80256cb3-0592-49d3-a4dc-992e5e6de7bb"],

Cell[TextData[{
 StyleBox["DisplacementNegative",
  FontWeight->"Bold"],
 " \[LongDash] the metric negative of d"
}], "GuideText",ExpressionUUID->"c467a3b9-b16f-409b-bc5d-bb114852f363"],

Cell[TextData[{
 StyleBox["DisplacementInverse",
  FontWeight->"Bold"],
 " \[LongDash] reverses the relation d"
}], "GuideText",ExpressionUUID->"c4f12db3-4ccc-4d47-aa80-06bf60562cf3"],

Cell[TextData[{
 StyleBox["DisplacementSum",
  FontWeight->"Bold"],
 " \[LongDash] the bisector of the two composition orders of d1 and d2"
}], "GuideText",ExpressionUUID->"54f1c8b7-c978-416b-a323-31207921fc4b"],

Cell[TextData[{
 StyleBox["DisplacementCommutator",
  FontWeight->"Bold"],
 " \[LongDash] the commutator loop of two displacements, selected by Method"
}], "GuideText",ExpressionUUID->"a1e92d03-c7a4-46ca-a6b8-bce0696d2028"],

Cell[TextData[{
 StyleBox["DisplacementBracket",
  FontWeight->"Bold"],
 " \[LongDash] the scale-dependent metric bracket candidate, the commutator \
with Method -> \"Negative\""
}], "GuideText",ExpressionUUID->"65d9cb98-7768-477b-8df3-c68d6b841126"],

Cell[TextData[{
 StyleBox["DisplacementMagnitude",
  FontWeight->"Bold"],
 " \[LongDash] the maximal step length of displacement d"
}], "GuideText",ExpressionUUID->"cb094aee-690e-47e2-90ea-6eaaba061636"],

Cell[TextData[{
 StyleBox["DisplacementReduce",
  FontWeight->"Bold"],
 " \[LongDash] contracts each value set of d to its metric centre, iterated \
to a fixed point"
}], "GuideText",ExpressionUUID->"6ba4b6ac-885b-4b4a-a524-f730e76db917"],

Cell[TextData[{
 StyleBox["DisplacementSingleValuedQ",
  FontWeight->"Bold"],
 " \[LongDash] whether every value of displacement d is a single vertex"
}], "GuideText",ExpressionUUID->"73106071-1489-4ef4-9ef7-46e2e89cdb27"],

Cell[TextData[{
 StyleBox["DisplacementBijectionQ",
  FontWeight->"Bold"],
 " \[LongDash] whether displacement d is a single-valued permutation of the \
vertex set"
}], "GuideText",ExpressionUUID->"226d6973-edab-4473-98e9-286a7ee3de74"],

Cell[TextData[{
 StyleBox["DisplacementIsomorphismQ",
  FontWeight->"Bold"],
 " \[LongDash] whether displacement d is a graph automorphism of g"
}], "GuideText",ExpressionUUID->"a6515ca8-1a91-4d26-add9-3af4132710db"],

Cell[TextData[{
 StyleBox["ContinuousDisplacementQ",
  FontWeight->"Bold"],
 " \[LongDash] tests k-continuity of displacement d"
}], "GuideText",ExpressionUUID->"e19592c6-6eab-4ca5-bd03-b0af6cfb9997"],

Cell[TextData[{
 StyleBox["RandomDisplacement",
  FontWeight->"Bold"],
 " \[LongDash] generates a random continuous displacement of magnitude at \
most r"
}], "GuideText",ExpressionUUID->"d9b7dee9-4b7a-4915-9808-f90c329bdfbc"],

Cell[TextData[{
 StyleBox["FindKillingDisplacement",
  FontWeight->"Bold"],
 " \[LongDash] finds the nontrivial graph automorphism of least displacement \
magnitude, as a displacement"
}], "GuideText",ExpressionUUID->"b3c01434-951f-4258-b8df-136d6c931ffb"],

Cell[TextData[{
 StyleBox["KillingDisplacementMagnitude",
  FontWeight->"Bold"],
 " \[LongDash] the least magnitude of a nonidentity graph automorphism, or \
Infinity when g is asymmetric"
}], "GuideText",ExpressionUUID->"6a49d0f7-b73c-440f-b5c1-b64915f01bd0"],

Cell[TextData[{
 StyleBox["PolarDisplacements",
  FontWeight->"Bold"],
 " \[LongDash] the polar pair of radial and angular displacements at centre \
c"
}], "GuideText",ExpressionUUID->"29bc8bf3-5487-4978-8905-2a7a9478c3b2"],

Cell[TextData[{
 StyleBox["GradientDisplacement",
  FontWeight->"Bold"],
 " \[LongDash] the steepest-ascent displacement of a vertex function f"
}], "GuideText",ExpressionUUID->"49e00058-fe40-4edd-9d38-1773c852448f"],

Cell[TextData[{
 StyleBox["TranslationDisplacement",
  FontWeight->"Bold"],
 " \[LongDash] translates along the graph embedding"
}], "GuideText",ExpressionUUID->"ed1d97a4-fee8-4571-b523-7396ffd4e457"],

Cell[TextData[{
 StyleBox["DisplacementPlot",
  FontWeight->"Bold"],
 " \[LongDash] draws displacement d as bent arcs over the graph's own \
embedding"
}], "GuideText",ExpressionUUID->"d11a8625-d627-4d4e-a6cf-0a00434cc663"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] Boundary.wl", "GuideFunctionsSubsection",ExpressionUUID->"bc1c71e7-7485-4845-8296-27ff17591568"],

Cell[TextData[{
 StyleBox["GraphBoundary",
  FontWeight->"Bold"],
 " \[LongDash] the inner vertex boundary of S in g, the vertices where an \
edge of g escapes S"
}], "GuideText",ExpressionUUID->"592f5752-319e-4fd1-8caf-638552033d8a"],

Cell[TextData[{
 StyleBox["GraphInterior",
  FontWeight->"Bold"],
 " \[LongDash] the interior of S in g, S minus its GraphBoundary"
}], "GuideText",ExpressionUUID->"758c0bd5-a5a5-45b0-a706-725d1c9694da"],

Cell[TextData[{
 StyleBox["GraphExteriorBoundary",
  FontWeight->"Bold"],
 " \[LongDash] the exterior-boundary, rim, vertices of the whole graph, \
detected from vertex degrees"
}], "GuideText",ExpressionUUID->"3aa29eda-d615-4a37-9efa-3f39075a0a1e"],

Cell[TextData[{
 StyleBox["BoundarylessGraph",
  FontWeight->"Bold"],
 " \[LongDash] deletes every edge joining two rim vertices and then the \
vertices this isolates"
}], "GuideText",ExpressionUUID->"5f07784c-9010-4dec-9aac-ddd4bc751925"],

Cell[TextData[{
 StyleBox["GraphEccentricities",
  FontWeight->"Bold"],
 " \[LongDash] the eccentricity of every vertex, in VertexList order"
}], "GuideText",ExpressionUUID->"f37ca911-9651-496d-aa09-4d220873047d"],

Cell[TextData[{
 StyleBox["CenterGraph",
  FontWeight->"Bold"],
 " \[LongDash] the substrate cut to a fraction q of the way out from its \
centre"
}], "GuideText",ExpressionUUID->"9183e19b-276b-48d6-87b9-939b213a88dd"],

Cell[TextData[{
 StyleBox["RelativeEccentricity",
  FontWeight->"Bold"],
 " \[LongDash] the eccentricity of each vertex rescaled to run from 0 at the \
radius to 1 at the diameter"
}], "GuideText",ExpressionUUID->"1406731e-0a8e-4fa0-b96a-9bef8e4d6dec"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] BallTopology.wl", "GuideFunctionsSubsection",ExpressionUUID->"1742f2d6-1ab2-4039-a735-b918b51262a5"],

Cell[TextData[{
 StyleBox["BallTopology",
  FontWeight->"Bold"],
 " \[LongDash] the Hasse diagram of the r-ball specialization preorder on the \
vertices of g"
}], "GuideText",ExpressionUUID->"992b2c01-5dbc-444a-904c-c7c81261baa9"],

Cell[TextData[{
 StyleBox["TopologicalClosure",
  FontWeight->"Bold"],
 " \[LongDash] the closure of a vertex list in a specialization-preorder \
digraph"
}], "GuideText",ExpressionUUID->"88c415ca-0e39-4ab8-b00a-0609bbbf3b1c"],

Cell[TextData[{
 StyleBox["TopologicalInterior",
  FontWeight->"Bold"],
 " \[LongDash] the interior of a vertex list in a specialization-preorder \
digraph"
}], "GuideText",ExpressionUUID->"1019ac28-cf47-43ef-90ab-e416646291ac"],

Cell[TextData[{
 StyleBox["TopologicalBoundary",
  FontWeight->"Bold"],
 " \[LongDash] the two-sided boundary, closure minus interior, of a vertex \
list in a specialization-preorder digraph"
}], "GuideText",ExpressionUUID->"576ae838-ce6f-44de-b31b-6a838cb29ed0"],

Cell[TextData[{
 StyleBox["TopologicalNeighborhood",
  FontWeight->"Bold"],
 " \[LongDash] the unique minimal open neighborhood of a vertex list in a \
specialization-preorder digraph"
}], "GuideText",ExpressionUUID->"7e96ef48-da77-42db-b031-06fa5421c936"],

Cell[TextData[{
 StyleBox["ContinuousMapQ",
  FontWeight->"Bold"],
 " \[LongDash] whether a vertex map is continuous from one preorder digraph \
to another"
}], "GuideText",ExpressionUUID->"67522afa-e6dc-426a-b769-7ce8bcae6dd8"],

Cell[TextData[{
 StyleBox["TopologyGraph",
  FontWeight->"Bold"],
 " \[LongDash] draws g overlaid with the Hasse arrows of a \
specialization-preorder digraph"
}], "GuideText",ExpressionUUID->"c155d701-e3e8-4250-ad58-b65bcbb6582d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] ExampleGraphs.wl", "GuideFunctionsSubsection",ExpressionUUID->"ce71945e-1f6d-493f-ab40-eae3deb63764"],

Cell[TextData[{
 StyleBox["SierpinskiGraph",
  FontWeight->"Bold"],
 " \[LongDash] the trivalent Sierpinski graph"
}], "GuideText",ExpressionUUID->"6cee53f0-1f88-4e68-9d3b-19fb85a26771"],

Cell[TextData[{
 StyleBox["BetheGraph",
  FontWeight->"Bold"],
 " \[LongDash] the finite Bethe lattice, or Cayley tree, of n shells and \
coordination number z"
}], "GuideText",ExpressionUUID->"40742bd8-3af6-482b-9cc6-24e7fb142875"],

Cell[TextData[{
 StyleBox["BranchingSequenceTree",
  FontWeight->"Bold"],
 " \[LongDash] the spherically symmetric rooted tree whose offspring count \
depends only on depth"
}], "GuideText",ExpressionUUID->"8f3ff3f6-ba3c-4bf3-b3cf-62b3267ee46d"],

Cell[TextData[{
 StyleBox["InflateGraph",
  FontWeight->"Bold"],
 " \[LongDash] grows a fiber of extra vertices over every vertex of g and \
adds random edges between nearby fibers"
}], "GuideText",ExpressionUUID->"0765f8a4-a6b7-4662-aac3-e8636a9e544a"],

Cell[TextData[{
 StyleBox["InflatedVertex",
  FontWeight->"Bold"],
