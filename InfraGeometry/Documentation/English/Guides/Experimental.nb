Cell[CellGroupData[{

Cell["Experimental \[CenterDot] GraphBoundary.wl", "GuideFunctionsSubsection",ExpressionUUID->"56b0492e-00c4-4884-b9f3-965b521a9bef"],

Cell[TextData[{
 StyleBox["GraphBoundary",
  FontWeight->"Bold"],
 " \[LongDash] the inner vertex boundary of S in g, the vertices where an \
edge of g escapes S"
}], "GuideText",ExpressionUUID->"30d186ea-b6a9-4343-a5ac-01e405c98761"],

Cell[TextData[{
 StyleBox["GraphInterior",
  FontWeight->"Bold"],
 " \[LongDash] the interior of S in g, S minus its GraphBoundary"
}], "GuideText",ExpressionUUID->"c9243398-47f5-4569-86da-68d3621af005"],

Cell[TextData[{
 StyleBox["GraphEccentricities",
  FontWeight->"Bold"],
 " \[LongDash] the eccentricity of every vertex, in VertexList order"
}], "GuideText",ExpressionUUID->"90409f39-f0dc-4d60-85d4-30623f6096f9"],

Cell[TextData[{
 StyleBox["RelativeEccentricity",
  FontWeight->"Bold"],
 " \[LongDash] the eccentricity of each vertex rescaled to run from 0 at the \
radius to 1 at the diameter"
}], "GuideText",ExpressionUUID->"b1fe1d6e-796b-4206-aa0c-97cf7821a1b8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Experimental \[CenterDot] Coordinatization.wl", \
"GuideFunctionsSubsection",ExpressionUUID->"ea3f8042-1116-4998-bdca-\
d8333be54359"],

Cell[TextData[{
 StyleBox["RadarCoordinates",
  FontWeight->"Bold"],
 " \[LongDash] the distance vector from a vertex to each vertex of a basis"
}], "GuideText",ExpressionUUID->"b36c76ba-a652-498d-be7b-753f4fa749c1"],

Cell[TextData[{
 StyleBox["ResolvingSetQ",
  FontWeight->"Bold"],
 " \[LongDash] whether a basis is a resolving set"
}], "GuideText",ExpressionUUID->"ac039b71-ebbd-47f6-a8bd-eab5687efedb"],

Cell[TextData[{
 StyleBox["FindResolvingSet",
  FontWeight->"Bold"],
 " \[LongDash] up to n resolving sets, or metric bases, of g by ascending size"
}], "GuideText",ExpressionUUID->"29192c7b-89ea-438e-9a15-fe538e2bdf68"],

Cell[TextData[{
 StyleBox["MetricDimension",
  FontWeight->"Bold"],
 " \[LongDash] the metric dimension of g"
}], "GuideText",ExpressionUUID->"b62d3da8-8954-4a97-8287-c3949f4cc543"],

Cell[TextData[{
 StyleBox["ResistanceCoordinates",
  FontWeight->"Bold"],
 " \[LongDash] the spectral embedding whose squared distances are the \
effective resistances"
}], "GuideText",ExpressionUUID->"8631ebda-7057-470e-909e-9736cdc3c3f0"],

