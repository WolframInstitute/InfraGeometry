Cell["Riemannian \[CenterDot] ExampleGraphs.wl", "GuideFunctionsSubsection",ExpressionUUID->"66f45b1b-618b-4a2a-8074-7341b5ccf6ac"],

Cell[TextData[{
 StyleBox["SierpinskiGraph",
  FontWeight->"Bold"],
 " \[LongDash] the trivalent Sierpinski graph"
}], "GuideText",ExpressionUUID->"209ca594-281c-4b01-9153-4cf37dcd74bf"],

Cell[TextData[{
 StyleBox["BetheGraph",
  FontWeight->"Bold"],
 " \[LongDash] the finite Bethe lattice, or Cayley tree, of n shells and \
coordination number z"
}], "GuideText",ExpressionUUID->"135704f5-4c7d-4a81-8718-38a73d2095ed"],

Cell[TextData[{
 StyleBox["BranchingSequenceTree",
  FontWeight->"Bold"],
 " \[LongDash] the spherically symmetric rooted tree whose offspring count \
depends only on depth"
}], "GuideText",ExpressionUUID->"38a2e9ec-0405-462a-88bf-51bc55caffa3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] UniformLengthDiscretization.wl", \
"GuideFunctionsSubsection",ExpressionUUID->"68018f42-6afb-409f-916e-\
57735f5c665b"],

Cell[TextData[{
 StyleBox["UniformLengthGraph",
  FontWeight->"Bold"],
 " \[LongDash] the contact graph of a hard-sphere packing relaxed in a \
region, filling a solid or meshing a surface"
}], "GuideText",ExpressionUUID->"89d2ab62-864e-499f-9629-7cfbbaae31ef"],

Cell[TextData[{
 StyleBox["UniformLengthEmbedding",
  FontWeight->"Bold"],
 " \[LongDash] embeds a graph in R^d so that every edge is a unit segment"
}], "GuideText",ExpressionUUID->"13309b41-d1cb-4a44-84c4-97ee2e2935b3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Riemannian \[CenterDot] Coordinatization.wl", "GuideFunctionsSubsection",ExpressionUUID->"6fcf66f9-562d-4bc1-91de-f23d398f1b71"],

Cell[TextData[{
