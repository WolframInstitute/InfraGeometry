}, Open  ]],

Cell[CellGroupData[{

Cell["Underlying graphs", "GuideFunctionsSubsection",ExpressionUUID->"43d3d607-0f44-4bc0-a198-8bcf11e16a2b"],

Cell[TextData[{
 "waits: IntervalGraph, the new name of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GeodesicIntervalGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/GeodesicIntervalGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f0e5d664-9fc8-45e4-a41e-138166f59bd1"],
 ": the interval I(p, q) as a directed acyclic graph whose directed p-q paths \
are exactly the geodesics"
}], "GuideText",ExpressionUUID->"3f0fb8d9-d5e4-4d8f-8a6e-489b370cc4ed"],

Cell[TextData[{
 "waits: SprayGraph, the new name of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GeodesicSprayGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/GeodesicSprayGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f4348bda-3edf-468d-b13a-7c24c0cd1d75"],
 ": the breadth-first DAG rooted at c, whose source-to-sink paths are exactly \
the maximal geodesics from c"
}], "GuideText",ExpressionUUID->"08015aff-705f-4be8-8b02-3ae0ebd7e0f0"],

Cell["\<\
waits: ArcGraph, the band interval DAG of an arc, whose chains are its \
