}, Open  ]],

Cell[CellGroupData[{

Cell["Multi-constructions", "GuideFunctionsSubsection",ExpressionUUID->"42f08d67-5dae-407d-92ad-ce114d8cbe17"],

Cell["\<\
Whereas the causal graph of Euclidean constructions is causally invariant, \
the branchial graphs in infrageometry are non-trivial due to \
multi-constructions.\
\>", "GuideText",ExpressionUUID->"c54cc9d7-0e41-4d87-9fd6-e43d9514fa93"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "33c5de42-c82a-47fd-a80d-05b76f56afb6"],
 " \[LongDash] ",
 "a construction stated before any graph: the objects, and hypotheses that \
construct them with inert heads or assert relations between them"
}], "GuideText",ExpressionUUID->"ae2a7236-65be-47c7-9199-9f9c55a911b0"],

Cell[TextData[{
 "waits: InfraStep, one construction encapsulated as a step of a scene, the \
