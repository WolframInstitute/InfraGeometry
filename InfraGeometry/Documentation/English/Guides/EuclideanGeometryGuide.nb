Cell[CellGroupData[{

Cell["Multi-constructions", "GuideFunctionsSubsection",ExpressionUUID->"0e89bbdf-8513-4a60-b41f-3f0bf7b173d8"],

Cell["\<\
Whereas the causal graph of Euclidean constructions is causally invariant, \
the branchial graphs in infrageometry are non-trivial due to \
multi-constructions.\
\>", "GuideText",ExpressionUUID->"10c90bbe-961d-4444-9ebc-46ad7aca3da9"],

