}, Open  ]],

Cell[CellGroupData[{

Cell["Measurements", "GuideFunctionsSubsection",ExpressionUUID->"1e03e7c0-4d36-4c74-b3a7-6d5b3495e586"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
