Cell[CellGroupData[{

Cell["Multi-constructions", "GuideFunctionsSubsection",ExpressionUUID->"0d5b7f50-26b9-46af-b22e-1e476b0befb2"],

Cell["\<\
Whereas the causal graph of Euclidean constructions is causally invariant, \
the branchial graphs in infrageometry are non-trivial due to \
multi-constructions.\
\>", "GuideText",ExpressionUUID->"00420b23-9110-46c8-bc21-9c104cb0b537"],

