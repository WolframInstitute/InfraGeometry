Cell[CellGroupData[{

Cell["Multi-constructions", "GuideFunctionsSubsection",ExpressionUUID->"9c175d54-c666-4a3e-8a55-00ed85d9a09c"],

Cell["\<\
Whereas the causal graph of Euclidean constructions is causally invariant, \
the branchial graphs in infrageometry are non-trivial due to \
multi-constructions.\
\>", "GuideText",ExpressionUUID->"4b05fe46-cf5a-4f2d-add3-e94b4feae6e0"],

