Notebook[{Cell[CellGroupData[{Cell["Infra Topology", "GuideTitle", 
      CellID -> 942062912, ExpressionUUID -> 
       "a3a3c038-ca24-47b7-9945-83f1c1312fe3"], 
     Cell[TextData[StyleBox[
        "Abstract written by Pavel Hajek on 27 October 2026.", 
        FontSlant -> "Italic"]], "GuideAbstract", CellID -> 275198331, 
      ExpressionUUID -> "a9f77475-5dd5-461a-8ee8-7a71be15fca1"], 
     Cell[TextData[{"We study the topology, or global structure, of an infra \
substrate as seen by an infra observer at scale ", 
        Cell[BoxData[StyleBox["r", "TI"]], "InlineFormula", 
         FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "5128aa96-e6fa-4d48-bd14-5f179c87332f"], ". The ", 
        StyleBox["ball intersection complex", FontWeight -> "Bold"], 
        ", computed by ", Cell[BoxData[TemplateBox[
           {Cell[TextData["BallIntersectionComplex"]], "paclet:WolframInstitu\
te/InfraGeometry/ref/BallIntersectionComplex", 
            "WolframInstitute/InfraGeometry Package Symbol"}, "PackageLink", 
           BaseStyle -> "InlineFormula"]], "InlineFormula", 
         ExpressionUUID -> "7bc8cd16-1876-426f-8f31-2f9468046890"], 
        ", encodes the intersections among the balls of radius ", 
        Cell[BoxData[StyleBox["r", "TI"]], "InlineFormula", 
         FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "72f8ad6e-c17c-4824-8020-267bc1616a9f"], 
        " covering the substrate. A collection of ", 
        Cell[BoxData[RowBox[{StyleBox["k", "TI"], "+", "1"}]], 
         "InlineFormula", FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "d4305a82-a763-4d16-9bbd-c29a185fa650"], " balls spans a ", 
        Cell[BoxData[StyleBox["k", "TI"]], "InlineFormula", 
         FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "491b00a3-e839-431a-9665-e9a74654e9a1"], 
        "-simplex whenever every subcollection of at most ", 
        Cell[BoxData[StyleBox["m", "TI"]], "InlineFormula", 
         FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "5b332e9a-cbc0-4867-b57e-5bc8a3aa01a3"], 
        " balls has nonempty intersection. The case ", 
        Cell[BoxData[RowBox[{StyleBox["m", "TI"], "=", "\[Infinity]"}]], 
         "InlineFormula", FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "6086ae4b-fe1a-4a6b-8890-169a5ad5d90b"], " recovers the ", 
        StyleBox["\[CapitalCHacek]ech complex", FontWeight -> "Bold"], 
        ", computed by ", Cell[BoxData[TemplateBox[
           {Cell[TextData["CechComplex"]], 
            "paclet:WolframInstitute/InfraGeometry/ref/CechComplex", 
            "WolframInstitute/InfraGeometry Package Symbol"}, "PackageLink", 
           BaseStyle -> "InlineFormula"]], "InlineFormula", 
         ExpressionUUID -> "2e337c7e-38a5-44ea-aa84-9adf601f2295"], 
        ", while ", Cell[BoxData[RowBox[{StyleBox["m", "TI"], "=", "2"}]], 
         "InlineFormula", FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "fb82d728-d7e0-4f85-9976-9b20bca67bfc"], " recovers the ", 
        StyleBox["Vietoris\[Dash]Rips complex", FontWeight -> "Bold"], 
        " at threshold ", Cell[BoxData[RowBox[{"2", StyleBox["r", "TI"]}]], 
         "InlineFormula", FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "f2077970-2b56-405f-a733-e55964738112"], "."}], "GuideAbstract", 
      CellChangeTimes -> {{4.002049503088282*^9, 4.002049505070956*^9}, 
        {4.0020498514154387*^9, 4.002049869078261*^9}, {4.002050711249585*^9, 
         4.002050725391959*^9}}, CellID -> 715985883, 
      ExpressionUUID -> "cc68bfc1-e1cc-409c-9133-372fe38a1d33"], 
     Cell[TextData[{"We consider several notions of ", StyleBox["dimension", 
         FontWeight -> "Bold"], " at an observer scale ", 
        Cell[BoxData[StyleBox["r", "TI"]], "InlineFormula", 
         FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "ef4e7bc0-ddb1-4a89-8eef-12a46350be0a"], ". A ", 
        StyleBox["Hausdorff-type dimension", FontWeight -> "Bold"], 
        " is based on the number of balls of radius ", 
        Cell[BoxData[RowBox[{StyleBox["s", "TI"], "<", StyleBox["r", 
             "TI"]}]], "InlineFormula", FontSize -> 0.9*Inherited, 
         ExpressionUUID -> "4589b343-007c-420b-bf17-322772fbcbc0"], 
        " required to cover a ball of radius ", 
        Cell[BoxData[StyleBox["r", "TI"]], "InlineFormula", 
         FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "14f3558f-3403-4dc8-8385-1e76aeee091f"], " centered at a point ", 
        Cell[BoxData[StyleBox["p", "TI"]], "InlineFormula", 
         FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "e744dde8-350a-4f0a-b8bf-f886220e0b69"], ". ", 
        Cell[BoxData[TemplateBox[{Cell[TextData["BallCoverNumber"]], 
            "paclet:WolframInstitute/InfraGeometry/ref/BallCoverNumber", 
            "WolframInstitute/InfraGeometry Package Symbol"}, "PackageLink", 
           BaseStyle -> "InlineFormula"]], "InlineFormula", 
         ExpressionUUID -> "d63cac4b-3952-41ed-90ef-e8155a5ba066"], 
        " computes the minimal number of such balls, while ", 
        Cell[BoxData[TemplateBox[{Cell[TextData["FindBallCover"]], 
            "paclet:WolframInstitute/InfraGeometry/ref/FindBallCover", 
            "WolframInstitute/InfraGeometry Package Symbol"}, "PackageLink", 
           BaseStyle -> "InlineFormula"]], "InlineFormula", 
         ExpressionUUID -> "3af54af4-051c-4593-8016-8da3b4ac9541"], " finds \
their centers. In particular, we can study how the number of radius-", 
        Cell[BoxData[RowBox[{StyleBox["r", "TI"], "/", "2"}]], 
         "InlineFormula", FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "93e34dcd-ba84-48c9-83ee-6ce484db7f7d"], 
        " balls needed to cover a radius-", 
        Cell[BoxData[StyleBox["r", "TI"]], "InlineFormula", 
         FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "82846ecc-04d8-4494-8f41-ebd9ec58d58e"], " ball varies with ", 
        Cell[BoxData[StyleBox["r", "TI"]], "InlineFormula", 
         FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "74787a54-edf4-41a7-bfae-4e5cf00c33ce"], 
        ". Another notion is based on the maximal number of ", 
        StyleBox["mutually orthogonal axes", FontWeight -> "Bold"], 
        " of length ", Cell[BoxData[StyleBox["r", "TI"]], "InlineFormula", 
         FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "42730478-87df-48f0-b0be-20e96e0dac2e"], " through ", 
        Cell[BoxData[StyleBox["p", "TI"]], "InlineFormula", 
         FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "cc0dafb9-86c3-46c2-ad34-34046eb62d00"], ", computed by ", 
        Cell[BoxData[TemplateBox[{Cell[TextData["FindInfraOrthogonalAxes"]], 
            "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxe\
s", "WolframInstitute/InfraGeometry Package Symbol"}, "PackageLink", 
           BaseStyle -> "InlineFormula"]], "InlineFormula", 
         ExpressionUUID -> "9da1f27e-be16-4fc9-9003-baf1ee91ac5a"], 
        ". We also define a dimension in terms of ", 
        StyleBox["equidistant sets", FontWeight -> "Bold"], 
        ". Starting from pairs of maximally separated points on the radius-", 
        Cell[BoxData[StyleBox["r", "TI"]], "InlineFormula", 
         FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "439f581d-fb97-43df-8600-3134c14f5dbe"], " shell around ", 
        Cell[BoxData[StyleBox["p", "TI"]], "InlineFormula", 
         FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "82a5bc02-8ed3-421d-88e5-c62bcdd125b7"], ", we consider their \
perpendicular bisectors and determine the maximal number of independent \
bisectors with a nonempty common intersection. ", 
        Cell[BoxData[TemplateBox[{Cell[TextData["InfraEquidistantSet"]], 
            "paclet:WolframInstitute/InfraGeometry/ref/InfraEquidistantSet", 
            "WolframInstitute/InfraGeometry Package Symbol"}, "PackageLink", 
           BaseStyle -> "InlineFormula"]], "InlineFormula", 
         ExpressionUUID -> "20782b8e-9817-40ac-bcad-6a5b4f39a4b0"], 
        " represents this common set, while ", 
        Cell[BoxData[TemplateBox[{Cell[TextData["FindInfraEquidistantSet"]], 
            "paclet:WolframInstitute/InfraGeometry/ref/FindInfraEquidistantSe\
t", "WolframInstitute/InfraGeometry Package Symbol"}, "PackageLink", 
           BaseStyle -> "InlineFormula"]], "InlineFormula", 
         ExpressionUUID -> "14deb2a4-8436-46a2-bb5e-b96c99905742"], " \
computes it. A further notion is based on intersections of radius-", 
        Cell[BoxData[StyleBox["r", "TI"]], "InlineFormula", 
         FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "712268af-441f-4f7e-943c-f36c7c2377ed"], " balls and asks for the \
smallest intersection order for which intersections of small subcollections \
determine whether the entire family has a common point. Finally, ", 
        Cell[BoxData[TemplateBox[{Cell[TextData["VolumeGrowthObservables"]], 
            "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservable\
s", "WolframInstitute/InfraGeometry Package Symbol"}, "PackageLink", 
           BaseStyle -> "InlineFormula"]], "InlineFormula", 
         ExpressionUUID -> "ee562523-5593-4489-8dc5-d37a752b2c53"], " \
implements the Riemannian idea of extracting dimension, together with scalar \
curvature, from the growth of ", StyleBox["ball and shell volumes", 
         FontWeight -> "Bold"], " with radius."}], "GuideAbstract", 
      CellChangeTimes -> {{4.002049917615307*^9, 4.002049952194415*^9}, 
        {4.002050018279171*^9, 4.002050018846477*^9}, {4.0020507494242992*^9, 
         4.002050770383376*^9}, {4.0020524559042997*^9, 
         4.0020524623990927*^9}, {4.002052661729475*^9, 
         4.0020526834019413*^9}, {4.002052802737306*^9, 
         4.002052814939867*^9}}, CellID -> 1597156335, 
      ExpressionUUID -> "85d284c4-d34d-4a8d-9ed0-08a8b66ef8a0"], 
     Cell[TextData[{"We also study ", StyleBox["homotopy of paths and loops", 
         FontWeight -> "Bold"], " through local deformations. ", 
        Cell[BoxData["\"NullHomotopicCycles\""], "InlineFormula", 
         FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "adf5ac99-acf3-4b3e-8937-15f2b8e55863"], 
        " specifies which cycles may be contracted. ", 
        Cell[BoxData[TemplateBox[{Cell[TextData["FindInfraHomotopy"]], 
            "paclet:WolframInstitute/InfraGeometry/ref/FindInfraHomotopy", 
            "WolframInstitute/InfraGeometry Package Symbol"}, "PackageLink", 
           BaseStyle -> "InlineFormula"]], "InlineFormula", 
         ExpressionUUID -> "6569a36b-c7b8-41de-96f1-6dfbff4a5a6a"], 
        " finds sequences of deformations, while ", 
        Cell[BoxData[TemplateBox[{Cell[TextData["HomotopicQ"]], 
            "paclet:WolframInstitute/InfraGeometry/ref/HomotopicQ", 
            "WolframInstitute/InfraGeometry Package Symbol"}, "PackageLink", 
           BaseStyle -> "InlineFormula"]], "InlineFormula", 
         ExpressionUUID -> "cadbfce2-a71c-4c8a-82d6-e56c10ff015c"], " and ", 
        Cell[BoxData[TemplateBox[{Cell[TextData["NullHomotopicQ"]], 
            "paclet:WolframInstitute/InfraGeometry/ref/NullHomotopicQ", 
            "WolframInstitute/InfraGeometry Package Symbol"}, "PackageLink", 
           BaseStyle -> "InlineFormula"]], "InlineFormula", 
         ExpressionUUID -> "d884442d-8aac-4bea-9aac-9f1c46f6cae1"], 
        " test homotopy and null-homotopy. We also consider ", 
        StyleBox["controlled deformations of shortest paths", 
         FontWeight -> "Bold"], ", keeping endpoints fixed and bounding both \
the excess length and the distance from the reference path. One restricted \
family consists of ", StyleBox["forward walks", FontWeight -> "Bold"], ", for \
which distance from the starting point never decreases. Their excess length \
counts steps within distance shells, and such walks can be counted using \
powers of the adjacency matrix of the admissible-step graph. ", 
        Cell[BoxData[TemplateBox[{Cell[TextData["InfraDeformationSize"]], 
            "paclet:WolframInstitute/InfraGeometry/ref/InfraDeformationSize", 
            "WolframInstitute/InfraGeometry Package Symbol"}, "PackageLink", 
           BaseStyle -> "InlineFormula"]], "InlineFormula", 
         ExpressionUUID -> "dcbe64d8-bf85-436b-8fd3-0bb3af8cd3e6"], " \
measures the extent of the change along the reference path, between the \
common prefix and suffix."}], "GuideAbstract", CellID -> 1165913449, 
      ExpressionUUID -> "66ff0f01-2d08-4b9a-9f33-8d1e88f71aab"], 
     Cell[TextData[{"Infra topology also includes the ", 
        StyleBox["topological properties of fibre bundles", 
         FontWeight -> "Bold"], ", discussed in the ", 
        Cell[BoxData[TemplateBox[{Cell[TextData["Infra Fiber Bundles"]], 
            "paclet:WolframInstitute/InfraGeometry/guide/InfraFiberBundles"}, 
           "RefLinkPlain", BaseStyle -> {"InlineFormula"}]], "InlineFormula", 
         FontSize -> 0.9*Inherited, ExpressionUUID -> 
          "e86847fa-0f00-4f30-8795-35c002e8c162"], " guide."}], 
      "GuideAbstract", CellID -> 848725228, ExpressionUUID -> 
       "a7410443-13a8-4810-9b63-856f59d3f1f5"]}, Open]], 
  Cell[CellGroupData[{Cell["", "GuideFunctionsSection", CellID -> 1866139230, 
      ExpressionUUID -> "a0ea3657-4c83-4862-93c8-ecf80cebc774"], 
