Cell[CellGroupData[{

Cell["The ball intersection complex", "GuideFunctionsSubsection",ExpressionUUID->"1d9db673-0480-4192-adf4-dee5cf429aea"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallIntersectionComplex"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "c3bb7854-ae9c-4cad-814e-75e6a81a00f4"],
 " \[LongDash] ",
 "the order-",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f46aa650-ce53-4865-a470-a8b9ee7bb071"],
 " complex of the closed ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61c968bd-183c-4830-8e1e-2bdf476a6f85"],
 "-balls"
}], "GuideText",ExpressionUUID->"753717e2-05d5-4927-9d06-4a82768b6a38"],

