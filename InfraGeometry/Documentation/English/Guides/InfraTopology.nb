Notebook[{

Cell[CellGroupData[{
Cell["Infra Topology", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[StyleBox["Reviewed by Pavel Hajek on 27 October 2026.", "TI"]], \
"GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"],

Cell[TextData[{
 "We study the topology, or global structure, of an infra substrate as seen \
by an infra observer at scale ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0258825b-3367-4d02-8dd6-f0c7bc03f7f6"],
 ". The ",
 StyleBox["ball intersection complex",
  FontWeight->"Bold"],
 ", computed by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallIntersectionComplex"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "58619471-d50c-4d9b-b01c-18f9bb4145be"],
 ", encodes the intersections among the balls of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7084fd4a-2a77-43eb-b748-baa4170691b4"],
 " covering the substrate. A collection of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2836a96-8d3d-4efc-84f5-a435e8b51089"],
 " balls spans a ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "957125a6-0bff-4b36-8d9b-017f60e29a3d"],
 "-simplex whenever every subcollection of at most ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1334e24-ebe3-45c4-bbda-d4bcc63ffc9c"],
 " balls has nonempty intersection. The case ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49b56cc4-6349-424c-be03-10ed422b3d27"],
 " recovers the ",
 StyleBox["\[CapitalCHacek]ech complex",
  FontWeight->"Bold"],
 ", computed by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CechComplex"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CechComplex", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0915694a-8e29-4d91-b5f4-cf6b668acc71"],
 ", while ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ea65c24-d155-468d-9734-42f59ae18217"],
 " recovers the ",
 StyleBox["Vietoris\[Dash]Rips complex",
  FontWeight->"Bold"],
 " at threshold ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e209c6bf-c38c-41de-a4ce-3b2941a456da"],
 "."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"],

Cell[TextData[{
 "We consider several notions of ",
 StyleBox["dimension",
  FontWeight->"Bold"],
 " at an observer scale ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8fa49ea6-27a2-4454-9a14-ef34e01da933"],
 ". A ",
 StyleBox["Hausdorff-type dimension",
  FontWeight->"Bold"],
 " is based on the number of balls of radius ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "<", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "741dc82d-c9f9-44fd-bfc9-46b77af227bf"],
 " required to cover a ball of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05af32ec-1bd6-4675-a4c0-4df909e7de3e"],
 " centered at a point ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37151072-29fd-46ea-8672-9a44e4f3008c"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallCoverNumber"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallCoverNumber", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "385a6685-5507-4c63-be5c-affa4e55e530"],
 " computes the minimal number of such balls, while ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindBallCover"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindBallCover", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3f3fd72c-1fde-4365-acaa-9c2522d87bfb"],
 " finds their centers. In particular, we can study how the number of radius-",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b921057-44fb-4792-a162-47af8488f681"],
 " balls needed to cover a radius-",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d480a73-5692-4295-9d47-326d85c1779a"],
 " ball varies with ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b17cac4b-355b-4d20-9ec6-9441da1bbef4"],
 ". Another notion is based on the maximal number of ",
 StyleBox["mutually orthogonal axes",
  FontWeight->"Bold"],
 " of length ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c696d35-cb18-4b5a-b466-74fc4c2c68e5"],
 " through ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0730f59-f066-4d7e-8f5f-b4eb777db91a"],
 ", computed by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9c723db2-b647-4a43-96c7-a6f4887842f9"],
 ". We also define a dimension in terms of ",
 StyleBox["equidistant sets",
  FontWeight->"Bold"],
 ". Starting from pairs of maximally separated points on the radius-",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "725e8b89-881e-44be-b214-a40646cc4b59"],
 " shell around ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04704b63-4870-4e4d-8cf9-d2d5e627fe0c"],
 ", we consider their perpendicular bisectors and determine the maximal \
number of independent bisectors with a nonempty common intersection. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEquidistantSet"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEquidistantSet", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1f80411c-5583-4db5-8dba-99561c609d87"],
 " represents this common set, while ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraEquidistantSet"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraEquidistantSet", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d0c208a9-504c-49ef-b309-0192be9c6e59"],
 " computes it. A further notion is based on intersections of radius-",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0269dd84-e486-4307-a0ac-cc71b7a60e15"],
 " balls and asks for the smallest intersection order for which intersections \
of small subcollections determine whether the entire family has a common \
point. Finally, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VolumeGrowthObservables"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cc121894-9584-40d3-9fbb-17f424b4908c"],
 " implements the Riemannian idea of extracting dimension, together with \
scalar curvature, from the growth of ",
 StyleBox["ball and shell volumes",
  FontWeight->"Bold"],
 " with radius."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"],

Cell[TextData[{
 "We also study ",
 StyleBox["homotopy of paths and loops",
  FontWeight->"Bold"],
 " through local deformations. ",
 Cell[BoxData["\"\<NullHomotopicCycles\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a149b34-c901-402a-8f57-0921a3105f49"],
 " specifies which cycles may be contracted. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraHomotopy"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraHomotopy", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "316df86d-f23b-424c-9489-81e2ec33459a"],
 " finds sequences of deformations, while ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HomotopicQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/HomotopicQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "62328a78-7d04-44b1-a1e4-f7f11ab1a2b3"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NullHomotopicQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/NullHomotopicQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "031dcb4e-165b-4bf4-8883-10048b1964e1"],
 " test homotopy and null-homotopy. We also consider ",
 StyleBox["controlled deformations of shortest paths",
  FontWeight->"Bold"],
 ", keeping endpoints fixed and bounding both the excess length and the \
distance from the reference path. One restricted family consists of ",
 StyleBox["forward walks",
  FontWeight->"Bold"],
 ", for which distance from the starting point never decreases. Their excess \
length counts steps within distance shells, and such walks can be counted \
using powers of the adjacency matrix of the admissible-step graph. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDeformationSize"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDeformationSize", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7f76bcd8-5f93-4498-bd96-91014044dba0"],
 " measures the extent of the change along the reference path, between the \
common prefix and suffix."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"],

Cell[TextData[{
 "Infra topology also includes the ",
 StyleBox["topological properties of fibre bundles",
  FontWeight->"Bold"],
 ", discussed in the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infra Fiber Bundles"]], 
    "paclet:WolframInstitute/InfraGeometry/guide/InfraFiberBundles"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "9a65bd56-f93c-4794-bec2-72d17fdf9b23"],
 " guide."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

