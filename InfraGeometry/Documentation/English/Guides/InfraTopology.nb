             {"PageType" -> "Function"}, ExpressionUUID -> 
             "18693888-63d0-4d7f-b9b1-6aad115b403a"], " \[LongDash] ", 
           "the order-", Cell[BoxData[StyleBox["k", "TI"]], "InlineFormula", 
            FontSize -> 0.9*Inherited, ExpressionUUID -> 
             "f1fa6b71-7cff-4d86-be6a-5a07c52db2b2"], 
           " complex of the closed ", Cell[BoxData[StyleBox["r", "TI"]], 
            "InlineFormula", FontSize -> 0.9*Inherited, ExpressionUUID -> 
