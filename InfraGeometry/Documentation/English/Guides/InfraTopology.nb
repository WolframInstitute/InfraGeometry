   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "cfffcbf5-c14f-4bdd-83ab-829f634d96eb"],
 " \[LongDash] ",
 "the nerve of the closed ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "381167b4-15a9-413f-b0b4-e5a2b5d57142"],
 "-balls"
}], "GuideText",ExpressionUUID->"7b5e61a2-f4ec-4ab9-8c59-4c7850dd9ab2"],

Cell[TextData[{
