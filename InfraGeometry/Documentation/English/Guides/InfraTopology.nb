Cell[CellGroupData[{

Cell["The ball intersection complex", "GuideFunctionsSubsection",ExpressionUUID->"56e93116-0d91-495d-bc7f-2156a24c028d"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallIntersectionComplex"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "eaa3a1d7-01da-436a-a062-5a2b2f226c92"],
 " \[LongDash] ",
 "the order-",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1357c5a3-3014-4518-8494-79e62d4e274b"],
 " complex of the closed ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0569934c-2878-4275-bca5-2694c7fbe56b"],
 "-balls"
}], "GuideText",ExpressionUUID->"554be860-42d4-4568-890c-bee78e5de6f4"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
