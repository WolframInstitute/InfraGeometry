Cell[CellGroupData[{

Cell["Maps behind the tessellations", "GuideFunctionsSubsection",ExpressionUUID->"ca0c2fbd-e521-4054-8e4f-a9b00d74ae93"],

Cell[TextData[{
 StyleBox["CosetEnumeration",
  FontWeight->"Bold"],
 " \[LongDash] the Todd-Coxeter index of a subgroup of the von Dyck group \
D(p, q, 2)"
}], "GuideText",ExpressionUUID->"3337b329-b64c-4cb9-bf73-15264c3a3982"],

Cell[TextData[{
 StyleBox["LowIndexMaps",
  FontWeight->"Bold"],
 " \[LongDash] every {p, q} map of index at most maxIndex up to isomorphism, \
by low-index subgroup enumeration"
}], "GuideText",ExpressionUUID->"b3e123c7-5e8b-4c51-9f3f-e580aeb63e7f"],

Cell[TextData[{
 StyleBox["RotationMapGraph",
  FontWeight->"Bold"],
 " \[LongDash] the 1-skeleton of the orientable map of a rotation pair {x, \
y}"
}], "GuideText",ExpressionUUID->"4d70b3af-abc3-45bb-af12-21804a80bb0e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Uniform-length graphs", "GuideFunctionsSubsection",ExpressionUUID->"b518816f-8369-4346-803c-e73fbf8b6029"],

Cell[TextData[{
 StyleBox["UniformLengthGraph",
  FontWeight->"Bold"],
 " \[LongDash] the contact graph of a hard-sphere packing relaxed in a \
region, filling a solid or meshing a surface"
}], "GuideText",ExpressionUUID->"b809b53f-dc30-440e-806e-e46bc930958d"],

Cell[TextData[{
 StyleBox["UniformLengthEmbedding",
  FontWeight->"Bold"],
 " \[LongDash] embeds a graph in R^d so that every edge is a unit segment"
}], "GuideText",ExpressionUUID->"ba9d6528-f52c-4950-aaa3-ceb5da48724a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Other example graphs", "GuideFunctionsSubsection",ExpressionUUID->"99479217-40da-411d-912c-54fd2e75df28"],

Cell[TextData[{
 StyleBox["SierpinskiGraph",
  FontWeight->"Bold"],
