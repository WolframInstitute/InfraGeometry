Cell[CellGroupData[{

Cell["Maps behind the tessellations", "GuideFunctionsSubsection",ExpressionUUID->"6d145af7-dd81-4442-9f6c-d3a78a608438"],

Cell[TextData[{
 StyleBox["CosetEnumeration",
  FontWeight->"Bold"],
 " \[LongDash] the Todd-Coxeter index of a subgroup of the von Dyck group \
D(p, q, 2)"
}], "GuideText",ExpressionUUID->"8e2c7de0-3ccc-4776-ae35-5303b19e7d02"],

Cell[TextData[{
 StyleBox["LowIndexMaps",
  FontWeight->"Bold"],
 " \[LongDash] every {p, q} map of index at most maxIndex up to isomorphism, \
by low-index subgroup enumeration"
}], "GuideText",ExpressionUUID->"9d1d2ddd-6851-4a0d-bca6-b8b015e70ec1"],

Cell[TextData[{
 StyleBox["RotationMapGraph",
  FontWeight->"Bold"],
 " \[LongDash] the 1-skeleton of the orientable map of a rotation pair {x, \
y}"
}], "GuideText",ExpressionUUID->"76ba9d97-64c7-4b4e-b16e-b0a614084659"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Uniform-length graphs", "GuideFunctionsSubsection",ExpressionUUID->"92921665-28d9-44d2-9731-ce898655bcbc"],

Cell[TextData[{
 StyleBox["UniformLengthGraph",
  FontWeight->"Bold"],
 " \[LongDash] the contact graph of a hard-sphere packing relaxed in a \
region, filling a solid or meshing a surface"
}], "GuideText",ExpressionUUID->"c86ed673-091d-49c4-b703-f7271083b182"],

Cell[TextData[{
 StyleBox["UniformLengthEmbedding",
  FontWeight->"Bold"],
 " \[LongDash] embeds a graph in R^d so that every edge is a unit segment"
}], "GuideText",ExpressionUUID->"dfdd325e-5f61-45d3-9c9c-8e22d5ef7448"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Other example graphs", "GuideFunctionsSubsection",ExpressionUUID->"b51d316e-3f80-47b1-a5d2-0f75fdabeebb"],

Cell[TextData[{
 StyleBox["SierpinskiGraph",
  FontWeight->"Bold"],
