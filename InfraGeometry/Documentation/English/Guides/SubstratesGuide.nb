by InflateGraph"
}], "GuideText",ExpressionUUID->"04148744-8959-4519-9fd4-0f5efa456038"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Warped products", "GuideFunctionsSubsection",ExpressionUUID->"685c0b8f-41fa-4f07-80ef-a2c7727d5606"],

