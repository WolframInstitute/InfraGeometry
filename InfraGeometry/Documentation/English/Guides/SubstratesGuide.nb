}], "GuideText",ExpressionUUID->"9ac00759-4610-48ff-8a0c-de54a0942c61"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Inflated substrates", "GuideFunctionsSubsection",ExpressionUUID->"8554e086-bf09-4c71-b124-3404e7ee390a"],

Cell[TextData[{
 StyleBox["InflateGraph",
  FontWeight->"Bold"],
 " \[LongDash] grows a fiber of extra vertices over every vertex, joined to \
