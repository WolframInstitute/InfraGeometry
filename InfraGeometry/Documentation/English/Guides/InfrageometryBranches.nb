           BaseStyle -> {"InlineFormula"}]], "InlineFormula", 
         ExpressionUUID -> "cc3a5630-0d24-4a30-a4a0-8f9ceda0fb07"], 
        " studies the ", StyleBox["substrate itself", FontWeight -> "Bold"], 
        " from a geometric point of view."}], "GuideAbstract", 
      CellID -> 2001916300, ExpressionUUID -> 
       "ef0ab37b-2e0d-4399-8f7e-82603ccbe925"], 
