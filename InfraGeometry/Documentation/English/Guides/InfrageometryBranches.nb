Notebook[{

Cell[CellGroupData[{
Cell["Branches of Infrageometry", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[StyleBox["Reviewed by Pavel Hajek on 30 October 2026.", "TI"]], \
"GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infra Substrates and Observers"]], 
    "paclet:WolframInstitute/InfraGeometry/guide/InfraSubstrates"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "22872b4d-ab7a-4dbc-b145-259221424d26"],
 " gives the basic point of view: a graph is a ",
 StyleBox["discrete substrate",
  FontWeight->"Bold"],
 " seen by an observer."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Euclidean Infrageometry"]], 
    "paclet:WolframInstitute/InfraGeometry/guide/EuclideanInfrageometry"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "a506af88-049d-4909-b51f-01505a997d77"],
 " is the analogue of the ",
 StyleBox["synthetic approach",
  FontWeight->"Bold"],
 " to classical geometry. It studies objects and constructions, and not so \
much the substrate."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Riemannian Infrageometry"]], 
    "paclet:WolframInstitute/InfraGeometry/guide/RiemannianInfrageometry"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "38866172-d6bb-4979-9e19-bdcfd0ea4e2b"],
 " studies the ",
 StyleBox["substrate itself",
  FontWeight->"Bold"],
 " from a geometric point of view."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infra Topology"]], 
    "paclet:WolframInstitute/InfraGeometry/guide/InfraTopology"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "55a764e7-26d0-42a2-9379-a431a9c5b2b9"],
 " studies the substrate from the ",
 StyleBox["global perspective",
  FontWeight->"Bold"],
 "."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infra Fiber Bundles"]], 
    "paclet:WolframInstitute/InfraGeometry/guide/InfraFiberBundles"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "507cc107-842c-413d-94f1-3f8bf7bb41ec"],
 " studies ",
 StyleBox["relations between different graphs",
  FontWeight->"Bold"],
 "."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infra Analysis"]], 
    "paclet:WolframInstitute/InfraGeometry/guide/InfraAnalysis"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "5fe14e9d-1bd0-4f03-8962-762d5c5806eb"],
 " is mainly ",
 StyleBox["integration and differentiation",
  FontWeight->"Bold"],
 ", and related operations."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
