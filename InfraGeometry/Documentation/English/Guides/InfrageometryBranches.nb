     Cell[TextData[{"This research arose under the direction of ", 
        ButtonBox["Stephen Wolfram", BaseStyle -> "Hyperlink", 
         ButtonData -> {URL["https://writings.stephenwolfram.com/"], None}], 
        "."}], "GuideAbstract", CellID -> 2001916300, 
      ExpressionUUID -> "ef0ab37b-2e0d-4399-8f7e-82603ccbe925"], 
     Cell[TextData[{Cell[BoxData[TemplateBox[
           {Cell[TextData["Infra Substrates and Observers"]], 
            "paclet:WolframInstitute/InfraGeometry/guide/InfraSubstrates"}, 
           "RefLinkPlain", BaseStyle -> {"InlineFormula"}]], "InlineFormula", 
         ExpressionUUID -> "09f71dd5-f2c6-4896-984e-b55981ce0b47"], 
        " gives the basic point of view: a graph is a ", 
        StyleBox["discrete substrate", FontWeight -> "Bold"], 
        " seen by an observer."}], "GuideAbstract", CellID -> 2001916300, 
      ExpressionUUID -> "ef0ab37b-2e0d-4399-8f7e-82603ccbe925"], 
     Cell[TextData[{Cell[BoxData[TemplateBox[
           {Cell[TextData["Euclidean Infrageometry"]], "paclet:WolframInstitu\
te/InfraGeometry/guide/EuclideanInfrageometry"}, "RefLinkPlain", 
           BaseStyle -> {"InlineFormula"}]], "InlineFormula", 
         ExpressionUUID -> "9d9872d5-ea61-4943-b745-5991f9729b77"], 
        " is the analogue of the ", StyleBox["synthetic approach", 
         FontWeight -> "Bold"], " to classical geometry. It studies objects \
and constructions, and not so much the substrate."}], "GuideAbstract", 
      CellID -> 2001916300, ExpressionUUID -> 
       "ef0ab37b-2e0d-4399-8f7e-82603ccbe925"], 
     Cell[TextData[{Cell[BoxData[TemplateBox[
