Notebook[{

Cell[CellGroupData[{
Cell["Infra Fiber Bundles", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell["\<\
A fibered graph is a graph with a projection onto a base graph, the preimage \
of each base vertex its fiber. It is a fiber bundle when the fibers are \
isomorphic and the edges over each base edge lift consistently. A connection \
chooses how an edge of the base lifts to the fibers; transport along a closed \
walk of the base returns a permutation of the fiber, its holonomy, and the \
connection is flat when every holonomy is trivial. A section picks a vertex \
of each fiber. The Levi-Civita connection is the connection of the \
displacement bundle that the metric singles out: over each edge the best \
angle-isometries of the direction spheres fixing the geodesics through it. \
Three heads carry a fibration: the literal InfraFibration and the two \
constructions InfraTangentBundle and InfraDisplacementBundle. Every function \
runs on all three through InfraTotalGraph and InfraFibrationAssociation. \
Sections, connections and bundle morphisms are inert maps that carry no \
graph. The names InfraParallelTransport, InfraHolonomy, InfraHolonomyAngle, \
InfraCovariantDerivative and InfraCanonicalOneForm also exist in the \
InfraGaugeTheory paclet with other signatures. With both paclets loaded in \
one kernel the later load shadows the earlier; load them in separate kernels \
or call the symbols by their full context.\
\>", "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "GuideFunctionsSection",
 CellID->1866139230,ExpressionUUID->"a0ea3657-4c83-4862-93c8-ecf80cebc774"],

Cell[CellGroupData[{

Cell["Fibrations", "GuideFunctionsSubsection",ExpressionUUID->"862d19a0-e16a-4cd3-8010-8e516177925e"],

Cell[TextData[{
 StyleBox["InfraFibration",
  FontWeight->"Bold"],
 " \[LongDash] a fibered graph: the total graph with its projection onto the \
base"
}], "GuideText",ExpressionUUID->"64b7a416-c805-4413-96fb-f210acfa40c7"],

Cell[TextData[{
 StyleBox["InfraTotalGraph",
  FontWeight->"Bold"],
 " \[LongDash] the total graph of a fibration"
}], "GuideText",ExpressionUUID->"025de341-5e17-4d1f-bdb6-8590b7801fde"],

Cell[TextData[{
 StyleBox["InfraFibrationAssociation",
  FontWeight->"Bold"],
 " \[LongDash] the projection of a fibration, total vertex to base vertex"
}], "GuideText",ExpressionUUID->"7997228b-7a56-40d5-a05d-75756a59ef39"],

Cell[TextData[{
 StyleBox["InfraBaseGraph",
  FontWeight->"Bold"],
 " \[LongDash] the base graph reconstructed from the projection"
}], "GuideText",ExpressionUUID->"04a27074-6c04-48ca-a4d2-78907315a010"],

Cell[TextData[{
 StyleBox["InfraFiber",
  FontWeight->"Bold"],
 " \[LongDash] the fiber over a base vertex, as a subgraph of the total \
graph"
}], "GuideText",ExpressionUUID->"fd4d4f57-09b7-407c-869e-bba31970406c"],

Cell[TextData[{
 StyleBox["InfraFibers",
  FontWeight->"Bold"],
 " \[LongDash] the fibers over all base vertices"
}], "GuideText",ExpressionUUID->"950015c4-b2c4-4e8b-ab71-3eca09c4a4c6"],

Cell[TextData[{
 StyleBox["RandomInfraFibration",
  FontWeight->"Bold"],
 " \[LongDash] a random fibered graph over a base"
}], "GuideText",ExpressionUUID->"0dafa046-696e-4969-81f1-e91528a8e0ec"],

Cell[TextData[{
 StyleBox["InfraFibrationQ",
  FontWeight->"Bold"],
 " \[LongDash] whether edges of the base lift to the total graph"
}], "GuideText",ExpressionUUID->"d854a613-0ce5-44f7-abd2-0637eb27c18e"],

Cell[TextData[{
 StyleBox["InfraFiberBundleQ",
  FontWeight->"Bold"],
 " \[LongDash] whether the fibers are isomorphic and the fibration is locally \
trivial"
}], "GuideText",ExpressionUUID->"b757645f-c40d-45f2-bf13-af0469bb1834"],

Cell[TextData[{
 StyleBox["InfraBundleMorphismQ",
  FontWeight->"Bold"],
 " \[LongDash] whether a map of total vertices is a graph homomorphism \
covering a map of bases"
}], "GuideText",ExpressionUUID->"44e8aff7-da14-49a0-bf02-1b595eb59073"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tangent, cotangent and displacement bundles", "GuideFunctionsSubsection",ExpressionUUID->"922b9d90-24d2-40c3-8bc3-271338ea2707"],

Cell[TextData[{
 StyleBox["InfraRays",
  FontWeight->"Bold"],
 " \[LongDash] the rays of a given length from a vertex"
}], "GuideText",ExpressionUUID->"cafaeb32-a0f1-4245-abf7-49e008576247"],

Cell[TextData[{
 StyleBox["InfraTangentBundle",
  FontWeight->"Bold"],
 " \[LongDash] the bundle of rays of length r, adjacent vertexwise"
}], "GuideText",ExpressionUUID->"658414ce-87b6-4aa9-865a-179445d790fa"],

Cell[TextData[{
 StyleBox["InfraCotangentBundle",
  FontWeight->"Bold"],
 " \[LongDash] the tangent bundle on reversed rays"
}], "GuideText",ExpressionUUID->"a822df60-8178-4947-b113-ca60cd28d423"],

Cell[TextData[{
 StyleBox["InfraDisplacementBundle",
  FontWeight->"Bold"],
 " \[LongDash] the bundle of pairs of vertices at distance r"
}], "GuideText",ExpressionUUID->"ea147619-c9ee-40e5-a8a9-2305b579de86"],

Cell[TextData[{
 StyleBox["InfraBundleMorphism",
  FontWeight->"Bold"],
 " \[LongDash] the natural map between two bundles: endpoint, truncation, \
reversal"
}], "GuideText",ExpressionUUID->"76148745-8228-4b29-a8db-22668fd57017"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sections", "GuideFunctionsSubsection",ExpressionUUID->"2b704532-3b4f-476f-9bb1-61e21490942a"],

Cell[TextData[{
 StyleBox["InfraSection",
  FontWeight->"Bold"],
 " \[LongDash] a section as an inert map from base vertices to total \
vertices"
}], "GuideText",ExpressionUUID->"91f34ec7-fba3-4b93-be2f-801e73d2d616"],

Cell[TextData[{
 StyleBox["InfraSectionQ",
  FontWeight->"Bold"],
 " \[LongDash] whether a map picks a vertex of each fiber"
}], "GuideText",ExpressionUUID->"a55bde23-dada-4ad3-b78b-18aff06da797"],

Cell[TextData[{
 StyleBox["InfraContinuousSectionQ",
  FontWeight->"Bold"],
 " \[LongDash] whether a section sends base edges to total edges"
}], "GuideText",ExpressionUUID->"833ff7ff-adee-4a81-8ea7-127f167f2e16"],

Cell[TextData[{
 StyleBox["RandomInfraSection",
  FontWeight->"Bold"],
 " \[LongDash] a random section of a fibration"
}], "GuideText",ExpressionUUID->"b590dc0b-7ddc-47fa-b400-d425fccb2641"],

Cell[TextData[{
 StyleBox["FindInfraSection",
  FontWeight->"Bold"],
 " \[LongDash] continuous sections over the whole base"
}], "GuideText",ExpressionUUID->"0100f3cc-a31a-4ec3-8317-c3b82996fef2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Connections and holonomy", "GuideFunctionsSubsection",ExpressionUUID->"081ebce9-50cf-4187-a3b3-0aec8dfe684f"],

Cell[TextData[{
 StyleBox["InfraConnection",
  FontWeight->"Bold"],
 " \[LongDash] the horizontal edges chosen as lifts of the base edges"
}], "GuideText",ExpressionUUID->"fc3f9436-942f-4155-94db-02344a8fde6e"],

Cell[TextData[{
 StyleBox["InfraConnectionQ",
  FontWeight->"Bold"],
 " \[LongDash] whether the edges form a connection of a fibration"
}], "GuideText",ExpressionUUID->"9eead3ed-82ed-41a4-b10b-4ff99cea4c63"],

Cell[TextData[{
 StyleBox["InfraFlatConnectionQ",
  FontWeight->"Bold"],
 " \[LongDash] whether the horizontal leaves project injectively"
}], "GuideText",ExpressionUUID->"8ba910d9-3125-4f8a-8204-984df6cff0b9"],

Cell[TextData[{
 StyleBox["RandomInfraConnection",
  FontWeight->"Bold"],
 " \[LongDash] a random connection of a fibration"
}], "GuideText",ExpressionUUID->"73e07700-9c2a-44c0-bc0b-848147ea38ef"],

Cell[TextData[{
 StyleBox["FindInfraHorizontalLift",
  FontWeight->"Bold"],
 " \[LongDash] the horizontal lifts of a walk from a fiber vertex"
}], "GuideText",ExpressionUUID->"bef5215b-a69b-420b-b4f8-a051bb2e02a4"],

Cell[TextData[{
 StyleBox["InfraParallelTransport",
  FontWeight->"Bold"],
 " \[LongDash] the transport of a fiber along a walk; on a displacement \
bundle without a connection, the Levi-Civita transports"
}], "GuideText",ExpressionUUID->"f13c1e07-afc5-4ffd-ae19-7a9da9082629"],

Cell[TextData[{
 StyleBox["InfraHolonomy",
  FontWeight->"Bold"],
 " \[LongDash] the transport around a closed walk, as Cycles on the fiber"
}], "GuideText",ExpressionUUID->"c61f8b36-890d-40aa-bdba-677efcc44649"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Levi-Civita connection", "GuideFunctionsSubsection",ExpressionUUID->"7ddbe34e-d65e-4419-9ccb-bfdf7b27697a"],

Cell[TextData[{
 StyleBox["FindInfraLeviCivitaConnection",
  FontWeight->"Bold"],
