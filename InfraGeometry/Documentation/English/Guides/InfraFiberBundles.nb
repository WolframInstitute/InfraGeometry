Notebook[{

Cell[CellGroupData[{
Cell["Infra Fiber Bundles", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell["\<\
A fibered graph is a graph with a projection onto a base graph, the preimage \
of each base vertex its fiber. It is a fiber bundle when the fibers are \
isomorphic and the edges over each base edge lift consistently. A connection \
chooses how an edge of the base lifts to the fibers; transport along a closed \
walk of the base returns a permutation of the fiber, its holonomy, and the \
connection is flat when every holonomy is trivial. A section picks a vertex \
of each fiber. The Levi-Civita connection is the connection of the tangent \
spaces that the metric singles out. Three heads carry a fibration: the \
literal InfraFibration and the two constructions InfraTangentBundle and \
InfraDisplacementBundle. Every function runs on all three through \
InfraTotalGraph and InfraFibrationAssociation. Sections, connections and \
bundle morphisms are inert maps that carry no graph. The names \
InfraParallelTransport, InfraHolonomy, InfraHolonomyAngle, \
InfraCovariantDerivative and InfraCanonicalOneForm also exist in the \
InfraGaugeTheory paclet with other signatures. With both paclets loaded in \
one kernel the later load shadows the earlier; load them in separate kernels \
or call the symbols by their full context.\
\>", "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "GuideFunctionsSection",
 CellID->1866139230,ExpressionUUID->"a0ea3657-4c83-4862-93c8-ecf80cebc774"],

Cell[CellGroupData[{

Cell["Fibrations", "GuideFunctionsSubsection",ExpressionUUID->"8c5f18ad-5a9e-4c9a-8d21-630ef0b28e0e"],

Cell[TextData[{
 StyleBox["InfraFibration",
  FontWeight->"Bold"],
 " \[LongDash] a fibered graph: the total graph with its projection onto the \
base"
}], "GuideText",ExpressionUUID->"c2bd0f62-8475-4286-b089-8f844e78e4d9"],

Cell[TextData[{
 StyleBox["InfraTotalGraph",
  FontWeight->"Bold"],
 " \[LongDash] the total graph of a fibration"
}], "GuideText",ExpressionUUID->"6632c2fb-6fe5-4543-a8ce-7101cef23dd3"],

Cell[TextData[{
 StyleBox["InfraFibrationAssociation",
  FontWeight->"Bold"],
 " \[LongDash] the projection of a fibration, total vertex to base vertex"
}], "GuideText",ExpressionUUID->"e73797f1-f56a-475f-a6f5-502f7ad2bb17"],

Cell[TextData[{
 StyleBox["InfraBaseGraph",
  FontWeight->"Bold"],
 " \[LongDash] the base graph reconstructed from the projection"
}], "GuideText",ExpressionUUID->"281592da-a490-4d5c-9bbe-f290c670dbfc"],

Cell[TextData[{
 StyleBox["InfraFiber",
  FontWeight->"Bold"],
 " \[LongDash] the fiber over a base vertex, as a subgraph of the total \
graph"
}], "GuideText",ExpressionUUID->"02c28d9b-f164-4ce9-adb1-46aa2ad45263"],

Cell[TextData[{
 StyleBox["InfraFibers",
  FontWeight->"Bold"],
 " \[LongDash] the fibers over all base vertices"
}], "GuideText",ExpressionUUID->"bfc0daf8-5ad9-4d41-a0a1-6b4bcfd54d09"],

Cell[TextData[{
 StyleBox["RandomInfraFibration",
  FontWeight->"Bold"],
 " \[LongDash] a random fibered graph over a base"
}], "GuideText",ExpressionUUID->"b529a8e0-252a-443e-9090-a93ffcdd920e"],

Cell[TextData[{
 StyleBox["InfraFibrationQ",
  FontWeight->"Bold"],
 " \[LongDash] whether edges of the base lift to the total graph"
}], "GuideText",ExpressionUUID->"21513441-5d08-424e-8b38-07a708ab98de"],

Cell[TextData[{
 StyleBox["InfraFiberBundleQ",
  FontWeight->"Bold"],
 " \[LongDash] whether the fibers are isomorphic and the fibration is locally \
trivial"
}], "GuideText",ExpressionUUID->"1efd8cc7-b4df-492e-968e-d504d790d5cc"],

Cell[TextData[{
 StyleBox["InfraBundleMorphismQ",
  FontWeight->"Bold"],
 " \[LongDash] whether a map of total vertices is a graph homomorphism \
covering a map of bases"
}], "GuideText",ExpressionUUID->"77af30fc-0ae2-4e3e-9f4c-f04fd342c31d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tangent, cotangent and displacement bundles", "GuideFunctionsSubsection",ExpressionUUID->"3d678df5-9c85-432d-9316-98426dde133e"],

Cell[TextData[{
 StyleBox["InfraRays",
  FontWeight->"Bold"],
 " \[LongDash] the rays of a given length from a vertex"
}], "GuideText",ExpressionUUID->"bbe5803b-e8c9-4305-9df0-5ae2ea574b8e"],

Cell[TextData[{
 StyleBox["InfraTangentBundle",
  FontWeight->"Bold"],
 " \[LongDash] the bundle of rays of length r, adjacent vertexwise"
}], "GuideText",ExpressionUUID->"73dfc384-ee73-4556-9fcf-e961b9505dac"],

Cell[TextData[{
 StyleBox["InfraCotangentBundle",
  FontWeight->"Bold"],
 " \[LongDash] the tangent bundle on reversed rays"
}], "GuideText",ExpressionUUID->"f9a31d10-a8a1-4015-8724-f286fc99bf4e"],

Cell[TextData[{
 StyleBox["InfraDisplacementBundle",
  FontWeight->"Bold"],
 " \[LongDash] the bundle of pairs of vertices at distance r"
}], "GuideText",ExpressionUUID->"92597ac8-cb52-4902-af5c-7547179250a9"],

Cell[TextData[{
 StyleBox["InfraBundleMorphism",
  FontWeight->"Bold"],
 " \[LongDash] the natural map between two bundles: endpoint, truncation, \
reversal"
}], "GuideText",ExpressionUUID->"e03b2a24-8a62-4566-8e49-5128b094a167"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sections", "GuideFunctionsSubsection",ExpressionUUID->"654f288a-f679-48d9-b64d-2d77571ce4e6"],

Cell[TextData[{
 StyleBox["InfraSection",
  FontWeight->"Bold"],
 " \[LongDash] a section as an inert map from base vertices to total \
vertices"
}], "GuideText",ExpressionUUID->"c638a0dd-9dc3-49d7-aaa0-53e5497ed926"],

Cell[TextData[{
 StyleBox["InfraSectionQ",
  FontWeight->"Bold"],
 " \[LongDash] whether a map picks a vertex of each fiber"
}], "GuideText",ExpressionUUID->"03e72a02-2db2-4a50-b3bb-c9286428a288"],

Cell[TextData[{
 StyleBox["InfraContinuousSectionQ",
  FontWeight->"Bold"],
 " \[LongDash] whether a section sends base edges to total edges"
}], "GuideText",ExpressionUUID->"2ef9ff97-d445-418b-adaa-85057898af94"],

Cell[TextData[{
 StyleBox["RandomInfraSection",
  FontWeight->"Bold"],
 " \[LongDash] a random section of a fibration"
}], "GuideText",ExpressionUUID->"5c9ade7e-a255-4283-b971-2cf82b6f8978"],

Cell[TextData[{
 StyleBox["FindInfraSection",
  FontWeight->"Bold"],
 " \[LongDash] continuous sections over the whole base"
}], "GuideText",ExpressionUUID->"629899ec-a6cc-4da9-a30f-71cf88eb49d3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Connections and holonomy", "GuideFunctionsSubsection",ExpressionUUID->"34b7b1db-b41b-4473-9d0c-fccac24f1abb"],

Cell[TextData[{
 StyleBox["InfraConnection",
  FontWeight->"Bold"],
 " \[LongDash] the horizontal edges chosen as lifts of the base edges"
}], "GuideText",ExpressionUUID->"243f9244-860c-4a90-b390-cd64e7db311f"],

Cell[TextData[{
 StyleBox["InfraConnectionQ",
  FontWeight->"Bold"],
 " \[LongDash] whether the edges form a connection of a fibration"
}], "GuideText",ExpressionUUID->"501a3eba-e0c1-4f38-85bf-69397689b460"],

Cell[TextData[{
 StyleBox["InfraFlatConnectionQ",
  FontWeight->"Bold"],
 " \[LongDash] whether the horizontal leaves project injectively"
}], "GuideText",ExpressionUUID->"2c5fe57c-c3d4-4105-b950-12c62ea63518"],

Cell[TextData[{
 StyleBox["RandomInfraConnection",
  FontWeight->"Bold"],
 " \[LongDash] a random connection of a fibration"
}], "GuideText",ExpressionUUID->"4a7ce216-1663-4261-9af7-dd2aae7e6062"],

Cell[TextData[{
 StyleBox["FindInfraHorizontalLift",
  FontWeight->"Bold"],
 " \[LongDash] the horizontal lifts of a walk from a fiber vertex"
}], "GuideText",ExpressionUUID->"9deaa02c-b78b-48e4-9904-0072697d2eb4"],

Cell[TextData[{
 StyleBox["InfraParallelTransport",
  FontWeight->"Bold"],
 " \[LongDash] the transport of a fiber along a walk"
}], "GuideText",ExpressionUUID->"72837058-863e-4869-a74c-8aaa772d25a2"],

Cell[TextData[{
 StyleBox["InfraHolonomy",
  FontWeight->"Bold"],
 " \[LongDash] the transport around a closed walk, as Cycles on the fiber"
}], "GuideText",ExpressionUUID->"fc1c324c-6a67-4cd8-9bcd-00bbd565365d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Levi-Civita connection", "GuideFunctionsSubsection",ExpressionUUID->"4968b84e-1c58-4df6-9884-6c99a343b3da"],

Cell[TextData[{
 StyleBox["FindInfraLeviCivitaConnection",
  FontWeight->"Bold"],
 " \[LongDash] the connection of a displacement bundle singled out by the \
