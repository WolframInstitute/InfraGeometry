Cell[CellGroupData[{

Cell["Measures", "GuideFunctionsSubsection",ExpressionUUID->"9558aca8-38a9-4717-a57c-b7ed27307319"],

Cell[TextData[{
 "A region on a graph is measured by counting vertices, and its boundary is \
never negligible at a finite scale: the vertices at distance exactly ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "145af67a-db98-4dc5-8077-9e2c152cfd1c"],
 " are a share of order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    StyleBox["r", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c8c3979-45ee-4875-8171-0240edaea115"],
 " of the ball of radius ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8567d314-370e-4191-9d8f-654f25df8167"],
 ". So every region carries two measures, read by InfraMeasurement as \
properties of the region on a graph."
}], "GuideText",ExpressionUUID->"412e24e6-ccd6-43e2-be16-f466c0bf3f57"],

Cell[TextData[{
 "Counting measure, \"CountingMeasure\": ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", 
    RowBox[{"(", 
     StyleBox["A", "TI"], ")"}], "\[LongEqual]", "|", 
    StyleBox["A", "TI"], "|"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20f7546d-0496-4200-bf59-e8a201bf418c"],
 ", the number of vertices of the support ",
 Cell[BoxData[
  FormBox[
   StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e09271f7-fc06-45a3-82bd-871f63611eae"],
 " of the region."
}], "GuideText",ExpressionUUID->"ad4e0ec0-1460-4305-9a31-dd2c5875f9f9"],

Cell[TextData[{
 "Riemannian measure, \"RiemannianMeasure\": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Mu]", "\[EmptySmallCircle]"], 
    RowBox[{"(", 
     StyleBox["A", "TI"], ")"}], "\[LongEqual]", "|", 
    SuperscriptBox[
     StyleBox["A", "TI"], "\[EmptySmallCircle]"], "|"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d89455ff-38a2-4b08-b944-dc79e7da117b"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["A", "TI"], "\[EmptySmallCircle]"], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v", "TI"], "\[Element]", 
      StyleBox["A", "TI"], ":", 
      StyleBox["N", "TI"], 
      RowBox[{"(", 
       StyleBox["v", "TI"], ")"}], "\[SubsetEqual]", 
      StyleBox["A", "TI"]}], "}"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d57350d-0148-4d72-8583-cd26ef1679aa"],
 " is the set of vertices all of whose neighbours lie in ",
 Cell[BoxData[
  FormBox[
   StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c4bac2e3-d8b5-407c-9b88-f6762a9b0fd7"],
 ". It is the count without the boundary, the default of the volume growth \
estimators."
}], "GuideText",ExpressionUUID->"19bf0ef7-f4e9-463d-838b-8e9ed2220a77"],

