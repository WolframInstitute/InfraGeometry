Cell[TextData[{
 "Ball on the square grid: counting measure ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "+", "2", 
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be216e5c-46f5-4b94-9ef6-2e0f2c5b50bd"],
 ", Riemannian measure ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "-", "2", 
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df252192-57d6-4332-b534-cc3eaf5f09e4"],
 ", the counting measure of the ball of radius ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58f733f4-da11-4665-ac2d-b4b484e5a8b4"],
 ". The same shift holds on the triangular lattice, before the rim, and is \
the convention of the Wolfram Physics technical introduction; on the \
hexagonal lattice it is measured, not proved."
}], "GuideText",ExpressionUUID->"5ff0fa85-ed50-4817-8196-1791409549f1"],

Cell[TextData[{
 "Shell on the square grid: counting measure ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "531c187b-7ddd-435e-9a8c-bc1a413171b2"],
 ", the coordination sequence; Riemannian measure ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef467c16-0cd9-44c5-a119-4035989885e5"],
 ", since a shell is all boundary."
}], "GuideText",ExpressionUUID->"928d64e4-5d75-4869-9d1e-98e48dd89eef"],

Cell[TextData[{
 "Segment on the square grid between vertices ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "903b6f88-d7a9-4875-b06a-030d71f7fd52"],
 " and ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d78ec1b6-d9a6-4b12-9dd4-e7f70ea7de6c"],
 " steps apart along the two axes, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], ",", 
   RowBox[{
    StyleBox["b", "TI"], "\[GreaterEqual]", "1"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6403b906-569f-439b-99e1-e425e556e808"],
 ": its interval is a rectangle, with counting measure ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["b", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47136852-1b1f-4f48-81f1-0cdc866cb514"],
 " and Riemannian measure ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["b", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f1ea8d1-0d64-4bee-89d5-f71c6e1e70e7"],
 "."
}], "GuideText",ExpressionUUID->"eb7af9ce-ee50-4158-9149-3b50ddb17e10"],

Cell[TextData[{
 "Ball on the discretized plane: the Riemannian measure can exceed the \
counting measure of the smaller ball, when a vertex at distance ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ccfe139-d6ad-4c7e-81a2-b64aea420e40"],
 " has no neighbour at distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "792bbb40-3403-4440-b968-ef7d51da636f"],
 "."
}], "GuideText",ExpressionUUID->"eb3c5431-5f4f-47d5-a012-5712df289185"],

