  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "90615be7-8ae4-461c-a349-5e080f1e61d1"],
 " \[LongDash] ",
 "one solved binding of a scene; with an object name, reads that object out \
of it"
}], "GuideText",ExpressionUUID->"89acb7d1-73d6-4157-84af-2c0e31ba767b"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSceneViewer"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSceneViewer", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "accca1a1-d21a-4eb9-9ac5-781cd2a86fe7"],
 " \[LongDash] ",
 "a step-by-step view of a scene on a graph"
}], "GuideText",ExpressionUUID->"8498b3c4-6655-4cc5-97dc-d794df8fd399"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Underlying graphs", "GuideFunctionsSubsection",ExpressionUUID->"a5d99d23-6aa0-4332-a9ea-f4d9dd6da699"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SprayGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "f5c6ba94-c174-4ccd-93d7-69e3af540ca9"],
 " \[LongDash] ",
 "the breadth-first DAG rooted at c, whose source-to-sink paths are exactly \
the maximal shortest paths from c"
}], "GuideText",ExpressionUUID->"03e564b5-e015-43e9-8f9d-8ed335579269"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Not here", "GuideFunctionsSubsection",ExpressionUUID->"ebf69e72-abe6-4a8d-affa-40ee3664e413"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindBallHull"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindBallHull", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "e44bda33-1be4-4ff5-9a2d-3eec5234e79d"],
 " \[LongDash] ",
 "the intersection of all balls containing a set of points; it lives on the \
Infra Topology guide"
}], "GuideText",ExpressionUUID->"0a63272d-4535-4065-89cd-7c1b3de37a77"],

Cell["\<\
not here: the quadric as an inert head and the layers of the convex hull; \
FindInfraQuadric stays on the Experimental guide\
\>", "GuideText",ExpressionUUID->"84a1d694-00c3-4632-af90-76bcfff2ac1e"],

Cell["\<\
not here: an invariant of four points, the inverse of every head (the values \
of its unknowns for a given vertex set), and the graph of a line or of an arc \
as an exported name; none is in an item yet\
\>", "GuideText",ExpressionUUID->"cc15b048-11b6-4597-a025-128d040854a9"],

Cell["\<\
not here: the interactive multi-construction stepper in the causal and \
branchial direction; it stays on the Experimental guide\
\>", "GuideText",ExpressionUUID->"20092542-14e1-4665-86bd-958a64cabcb8"]
}, Open  ]]
}, Open  ]],

