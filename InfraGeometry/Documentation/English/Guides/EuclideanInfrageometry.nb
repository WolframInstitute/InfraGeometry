Cell[TextData[{
 "Ball on the square grid: counting measure ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "+", "2", 
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fbaf4ee8-e444-49b7-848d-fdc212d85b86"],
 ", Riemannian measure ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "-", "2", 
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82ee8805-aeb6-4cf6-8cc2-2ce17f9bc744"],
 ", the counting measure of the ball of radius ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38dd0953-a591-40bb-8346-51efb6068cd9"],
 ". The same shift holds on the triangular lattice, before the rim, and is \
the convention of the Wolfram Physics technical introduction; on the \
hexagonal lattice it is measured, not proved."
}], "GuideText",ExpressionUUID->"2cad0245-4780-43f6-a0be-0711afa108fd"],

Cell[TextData[{
 "Shell on the square grid: counting measure ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d637dea-fae4-422f-b7f4-d4ef68691cf6"],
 ", the coordination sequence; Riemannian measure ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a89bd0e-23d6-4d55-b104-ccd7a5e5854e"],
 ", since a shell is all boundary."
}], "GuideText",ExpressionUUID->"82b3f594-cc14-45d6-87ba-a2b5f4b8f500"],

Cell[TextData[{
 "Segment on the square grid between vertices ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8a0adf1-bae7-46d4-8160-d305090f79c3"],
 " and ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1960ee8-4c02-4766-ac4d-a1e6857414ff"],
 " steps apart along the two axes, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], ",", 
   RowBox[{
    StyleBox["b", "TI"], "\[GreaterEqual]", "1"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6be420ac-a8cf-497f-a049-d141a7af8949"],
 ": its interval is a rectangle, with counting measure ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["b", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1181b8d-46bf-4e96-b30e-49194ecf60e8"],
 " and Riemannian measure ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["b", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8fb1203f-91d8-4e23-9b8a-3aa54b16e0a7"],
 "."
}], "GuideText",ExpressionUUID->"aaa03e53-320c-4f41-b36b-f14a724f497f"],

Cell[TextData[{
 "Ball on the discretized plane: the Riemannian measure can exceed the \
counting measure of the smaller ball, when a vertex at distance ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bd21477-0a79-4167-b90b-e8624d13af18"],
 " has no neighbour at distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0352af18-ddbd-49f9-9477-c6ead22b5512"],
 "."
}], "GuideText",ExpressionUUID->"8d12cd29-7048-4261-bdbe-1ea7ccfda070"],

