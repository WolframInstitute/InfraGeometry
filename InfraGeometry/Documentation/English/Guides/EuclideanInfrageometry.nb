Cell[CellGroupData[{

Cell["Measures", "GuideFunctionsSubsection",ExpressionUUID->"642b8ee4-2913-4be2-834c-0d8ff9f8b519"],

Cell[TextData[{
 "A region on a graph is measured by counting vertices, and its boundary is \
never negligible at a finite scale: the vertices at distance exactly ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "442c0a0a-c6ca-4d4c-9a76-0c9007335b5e"],
 " are a share of order ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44ec5fa5-1e7c-407f-89f1-7409b76c19a9"],
 " of the ball of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e597d72-b365-4df9-9331-da3b9560677e"],
 ". So every region carries two measures, read by InfraMeasurement as \
properties of the region on a graph."
}], "GuideText",ExpressionUUID->"5ea2ec34-7f5b-4a22-837f-a9a0421df733"],

Cell[TextData[{
 "Counting measure, \"CountingMeasure\": ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Mu]", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["A", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   TemplateBox[{
     StyleBox["A", "TI"]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cea089d0-f0ec-46fc-b5e4-a873121ccb7f"],
 ", the number of vertices of the support ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa916f53-4c8d-408a-93ea-03de94e8f7b0"],
 " of the region."
}], "GuideText",ExpressionUUID->"80335b7a-b815-4df7-96dd-9ceca4899c78"],

Cell[TextData[{
 "Riemannian measure, \"RiemannianMeasure\": ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Mu]", "TI"], "\[SmallCircle]"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["A", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   TemplateBox[{
     SuperscriptBox[
      StyleBox["A", "TI"], "\[SmallCircle]"]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb464283-2c0f-415f-8d83-84fc87748e63"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["A", "TI"], "\[SmallCircle]"], "=", "{", 
    StyleBox["v", "TI"], "\[Element]", 
    StyleBox["A", "TI"]}], ":", 
   RowBox[{
    StyleBox["N", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[SubsetEqual]", 
    StyleBox["A", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "720115b6-8332-4fb6-b83a-6c2093896861"],
 " is the set of vertices all of whose neighbours lie in ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a2a1e3e-4d58-4c99-8836-77b99805ff6e"],
 ". It is the count without the boundary, the default of the volume growth \
estimators."
}], "GuideText",ExpressionUUID->"f45ec559-6976-4d26-94fe-b4efb08c830b"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
