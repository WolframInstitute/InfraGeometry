Cell[CellGroupData[{

Cell["Multi-constructions", "GuideFunctionsSubsection",ExpressionUUID->"73152490-5a56-41d0-b869-0e8aa856df99"],

Cell["\<\
Whereas the causal graph of Euclidean constructions is causally invariant, \
the branchial graphs in infrageometry are non-trivial due to \
multi-constructions.\
\>", "GuideText",ExpressionUUID->"57476cd5-2bc1-4288-8db1-217bddb3ea4d"],

