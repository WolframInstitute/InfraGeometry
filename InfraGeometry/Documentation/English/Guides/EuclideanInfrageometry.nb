    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "5086abfd-c911-4e00-bc61-8e4ba70f562f"],
 " \[LongDash] ",
 "one solved binding of a scene; with an object name, reads that object out \
of it"
}], "GuideText",ExpressionUUID->"b0a141e8-3307-45d3-bbef-bfb259765684"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSceneViewer"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSceneViewer", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "6f4fc930-6842-4897-87f5-eb19e51fd929"],
 " \[LongDash] ",
 "a step-by-step view of a scene on a graph"
}], "GuideText",ExpressionUUID->"7de3495f-439e-4e4a-8fd0-4854c48794a5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Underlying graphs", "GuideFunctionsSubsection",ExpressionUUID->"9ede8222-d142-43d7-935b-b57177339006"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SprayGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "7f1359d0-653a-4145-aa15-601caf5aa8bb"],
 " \[LongDash] ",
 "the breadth-first DAG rooted at c, whose source-to-sink paths are exactly \
the maximal shortest paths from c"
}], "GuideText",ExpressionUUID->"01ecb8b4-04cc-400c-9d96-d2e957ca6cfa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Not here", "GuideFunctionsSubsection",ExpressionUUID->"102669fe-69a7-49f8-a7e7-ba1c51e558e2"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindBallHull"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindBallHull", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "62662126-d524-4c8f-8e8a-1c45357939a9"],
 " \[LongDash] ",
 "the intersection of all balls containing a set of points; it lives on the \
Infra Topology guide"
}], "GuideText",ExpressionUUID->"4fa80ea6-116b-4f7c-8cf7-a721eb703dd2"],

Cell["\<\
not here: the quadric as an inert head and the layers of the convex hull; \
FindInfraQuadric stays on the Experimental guide\
\>", "GuideText",ExpressionUUID->"57b63313-3813-4de1-8c23-235ce64eab6a"],

Cell["\<\
not here: an invariant of four points, the inverse of every head (the values \
of its unknowns for a given vertex set), and the graph of a line or of an arc \
as an exported name; none is in an item yet\
\>", "GuideText",ExpressionUUID->"671307a7-96f2-48f5-a4b1-b75432146980"],

Cell["\<\
not here: the interactive multi-construction stepper in the causal and \
branchial direction; it stays on the Experimental guide\
\>", "GuideText",ExpressionUUID->"13acc454-f688-4d29-94be-e2cf9c4a0a13"]
}, Open  ]]
}, Open  ]],

