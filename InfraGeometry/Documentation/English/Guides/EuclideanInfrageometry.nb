Cell[CellGroupData[{

Cell["Measures", "GuideFunctionsSubsection",ExpressionUUID->"b6afb2f2-627d-4303-822b-c4df1df04c63"],

Cell[TextData[{
 "A region on a graph is measured by counting vertices, and its boundary is \
never negligible at a finite scale: the vertices at distance exactly ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4813bb4f-b695-4628-a693-836b2ff382fe"],
 " are a share of order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    StyleBox["r", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50a2dc9c-97e8-41cd-9168-897e60a745e8"],
 " of the ball of radius ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1389df0d-656e-4534-8162-84c5a0b07d7e"],
 ". So every region carries two measures, read by InfraMeasurement as \
properties of the region on a graph."
}], "GuideText",ExpressionUUID->"2cf24238-6423-4c57-bd6f-f1ca05cfa6d3"],

Cell[TextData[{
 "Counting measure, \"CountingMeasure\": ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", 
    RowBox[{"(", 
     StyleBox["A", "TI"], ")"}], "\[LongEqual]", "|", 
    StyleBox["A", "TI"], "|"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ad6ea25-76ee-4c9c-a2ac-66849257fb19"],
 ", the number of vertices of the support ",
 Cell[BoxData[
  FormBox[
   StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2957f494-27b4-4e63-b360-f4f5c11fe604"],
 " of the region."
}], "GuideText",ExpressionUUID->"404423ea-b931-4c96-ab4e-18cec3161114"],

Cell[TextData[{
 "Riemannian measure, \"RiemannianMeasure\": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Mu]", "\[EmptySmallCircle]"], 
    RowBox[{"(", 
     StyleBox["A", "TI"], ")"}], "\[LongEqual]", "|", 
    SuperscriptBox[
     StyleBox["A", "TI"], "\[EmptySmallCircle]"], "|"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0ee5ab0-67d0-4c70-a5da-167bbf777568"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["A", "TI"], "\[EmptySmallCircle]"], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v", "TI"], "\[Element]", 
      StyleBox["A", "TI"], ":", 
      StyleBox["N", "TI"], 
      RowBox[{"(", 
       StyleBox["v", "TI"], ")"}], "\[SubsetEqual]", 
      StyleBox["A", "TI"]}], "}"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3ccffab-a186-4bb8-a9dc-edf54a516564"],
 " is the set of vertices all of whose neighbours lie in ",
 Cell[BoxData[
  FormBox[
   StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e192630d-6fad-4a4f-8e7d-4171024e5102"],
 ". It is the count without the boundary, the default of the volume growth \
estimators."
}], "GuideText",ExpressionUUID->"791f3b93-839e-4b0d-9a33-1198c9e2abbc"],

