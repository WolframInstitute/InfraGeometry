   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "c22d1177-2447-4cc7-81c2-55978b433426"],
 " \[LongDash] ",
 "one construction encapsulated as a step of a scene; a second argument \
labels it"
}], "GuideText",ExpressionUUID->"ed81ec7b-4890-4434-a3d7-20b323b877db"],

Cell[TextData[{
 Cell[BoxData[
