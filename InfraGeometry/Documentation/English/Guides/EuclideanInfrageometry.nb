}], "GuideText",ExpressionUUID->"bd33422a-e7d1-4e8e-9781-0c09fc86a706"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Underlying graphs", "GuideFunctionsSubsection",ExpressionUUID->"286f5f94-6251-4adb-9ce3-eaf5e17312ff"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SegmentGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SegmentGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "62639c05-ee90-42d5-8b47-98a583ef2ff0"],
 " \[LongDash] ",
 "the interval I(p, q) as a directed acyclic graph whose directed p-q paths \
are exactly the shortest paths from p to q: the graph of InfraSegment[p, q]"
}], "GuideText",ExpressionUUID->"b7284a59-264b-4a9e-9034-c6af1fa77afd"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SprayGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "3a4ead70-ea6a-4256-901f-4c687ba55064"],
 " \[LongDash] ",
 "the breadth-first DAG rooted at c, whose source-to-sink paths are exactly \
the maximal shortest paths from c"
}], "GuideText",ExpressionUUID->"c984919e-358e-420f-addd-bcabecbaface"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Not here", "GuideFunctionsSubsection",ExpressionUUID->"83d907c7-8b1a-4245-9000-76fa9e7e17c0"],

