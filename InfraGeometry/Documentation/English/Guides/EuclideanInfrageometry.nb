  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "4dfc78f8-45eb-44ab-88ee-2d3208730cc8"],
 " \[LongDash] ",
 "a scene solved on a graph, step by step; a List of bindings, one per \
admissible combination"
}], "GuideText",ExpressionUUID->"ed5ba1b6-feac-46de-ae1a-ee9ad3181142"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSceneInstance"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSceneInstance", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "607bfcf9-2222-4003-8ba6-61a7d64b52a8"],
 " \[LongDash] ",
 "one solved binding of a scene; with an object name, reads that object out \
of it"
}], "GuideText",ExpressionUUID->"aa5f7560-ba32-4a9d-942d-f4e7215dcb27"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSceneViewer"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSceneViewer", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "4ef56014-7ef3-48ed-9786-744a71e072ef"],
 " \[LongDash] ",
 "a step-by-step view of a scene on a graph"
}], "GuideText",ExpressionUUID->"a071b7f8-47ed-4355-bea4-130fd8d4abc8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Underlying graphs", "GuideFunctionsSubsection",ExpressionUUID->"98760010-66ac-47df-9179-4d6d4d0aeb7e"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SprayGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "42237064-b885-4dd7-9538-2caf22378919"],
 " \[LongDash] ",
 "the breadth-first DAG rooted at c, whose source-to-sink paths are exactly \
the maximal shortest paths from c"
}], "GuideText",ExpressionUUID->"21f8bbdc-0aa8-46eb-9d35-edfc82274ea5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Not here", "GuideFunctionsSubsection",ExpressionUUID->"f39e19de-29d3-4ac1-92d8-9ff06af3603b"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindBallHull"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindBallHull", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "47b0852c-aaa5-431f-9dc9-ca1ad5f3f274"],
 " \[LongDash] ",
 "the intersection of all balls containing a set of points; it lives on the \
Infra Topology guide"
}], "GuideText",ExpressionUUID->"a8ba8eab-b9c8-4827-9488-d0084ee502ab"],

Cell["\<\
not here: the quadric as an inert head and the layers of the convex hull; \
FindInfraQuadric stays on the Experimental guide\
\>", "GuideText",ExpressionUUID->"ba23047f-59e6-4884-8e94-7d2a42ebe548"],

Cell["\<\
not here: an invariant of four points, the inverse of every head (the values \
of its unknowns for a given vertex set), and the graph of a line or of an arc \
as an exported name; none is in an item yet\
\>", "GuideText",ExpressionUUID->"f4f94610-6599-490b-8105-6ea38e56fb3a"],

Cell["\<\
not here: the interactive multi-construction stepper in the causal and \
branchial direction; it stays on the Experimental guide\
\>", "GuideText",ExpressionUUID->"6c9e6e93-f8ba-47e9-b713-fc6fafae6de9"]
}, Open  ]]
}, Open  ]],

