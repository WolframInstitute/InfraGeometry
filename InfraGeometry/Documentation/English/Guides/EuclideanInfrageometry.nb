Cell[CellGroupData[{

Cell["Measures", "GuideFunctionsSubsection",ExpressionUUID->"457119d6-0377-4cf2-864d-eef8ae219740"],

Cell[TextData[{
 "A region on a graph is measured by counting vertices, and its boundary is \
never negligible at a finite scale: the vertices at distance exactly ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e9f5946-01df-44cf-b179-1d99ecce5ddc"],
 " are a share of order ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03e9fcf2-6e6c-46f6-aba0-5d11ac0a5fc3"],
 " of the ball of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d5591fa-3b1c-4c94-8718-988d6e2169c6"],
 ". So every region carries two measures, read by InfraMeasurement as \
properties of the region on a graph."
}], "GuideText",ExpressionUUID->"1f8165aa-ea2c-4236-8d0f-3f77c55c21d0"],

Cell[TextData[{
 "Counting measure, \"CountingMeasure\": ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Mu]", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["A", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   TemplateBox[{
     StyleBox["A", "TI"]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c3e3c28-233d-4a70-98ef-0147081f9d48"],
 ", the number of vertices of the support ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7765f057-b832-4041-8772-a0a5fb755ff0"],
 " of the region."
}], "GuideText",ExpressionUUID->"cc62679b-92a8-4a2f-8b04-294e993981b2"],

Cell[TextData[{
 "Riemannian measure, \"RiemannianMeasure\": ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Mu]", "TI"], "\[SmallCircle]"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["A", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   TemplateBox[{
     SuperscriptBox[
      StyleBox["A", "TI"], "\[SmallCircle]"]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c354ef-ab78-4676-bbdb-42c10297dcbd"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["A", "TI"], "\[SmallCircle]"], "=", "{", 
    StyleBox["v", "TI"], "\[Element]", 
    StyleBox["A", "TI"]}], ":", 
   RowBox[{
    StyleBox["N", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[SubsetEqual]", 
    StyleBox["A", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf4c0f5e-3a77-418c-9caf-ef6421d56804"],
 " is the set of vertices all of whose neighbours lie in ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bb9ce4b-1701-48d4-909c-46bfcf65afb3"],
 ". It is the count without the boundary, the default of the volume growth \
estimators."
}], "GuideText",ExpressionUUID->"0f88602b-12d3-46b8-a405-06264d79832f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
