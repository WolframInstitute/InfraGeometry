  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "4258d175-eea0-4db1-a512-ffbd86a35917"],
 " \[LongDash] ",
 "whether a vertex list is a member of a head on a graph"
}], "GuideText",ExpressionUUID->"8d7b780c-9fa7-49d5-87b6-043d23010a0b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Substrates and Drawing", "GuideFunctionsSubsection",ExpressionUUID->"1da29b50-75d0-4810-8100-7dde68e22ada"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
