Cell[CellGroupData[{

Cell["Measures", "GuideFunctionsSubsection",ExpressionUUID->"f44286fe-fed1-4fd5-a136-6f36acc1e09c"],

Cell[TextData[{
 "A region on a graph is measured by counting vertices, and its boundary is \
never negligible at a finite scale: the vertices at distance exactly ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0696bfa-0878-4d8f-9cf7-99a919742ef5"],
 " are a share of order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    StyleBox["r", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a67890aa-2723-42e4-b87b-3f55aca3bfdb"],
 " of the ball of radius ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e8027df-cf1d-4fa8-bb9a-9d8ea1fd16f0"],
 ". So every region carries two measures, read by InfraMeasurement as \
properties of the region on a graph."
}], "GuideText",ExpressionUUID->"b03402f2-b70d-4bf9-96f3-4caf4b7eee8c"],

Cell[TextData[{
 "Counting measure, \"CountingMeasure\": ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", 
    RowBox[{"(", 
     StyleBox["A", "TI"], ")"}], "\[LongEqual]", "|", 
    StyleBox["A", "TI"], "|"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5032554c-6747-451d-b365-439036feda3f"],
 ", the number of vertices of the support ",
 Cell[BoxData[
  FormBox[
   StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92cccc71-9ea1-48e2-bde1-07c1e16bc0ec"],
 " of the region."
}], "GuideText",ExpressionUUID->"65260c74-5d36-4051-9a2f-0fdeff219aaa"],

Cell[TextData[{
 "Riemannian measure, \"RiemannianMeasure\": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Mu]", "\[EmptySmallCircle]"], 
    RowBox[{"(", 
     StyleBox["A", "TI"], ")"}], "\[LongEqual]", "|", 
    SuperscriptBox[
     StyleBox["A", "TI"], "\[EmptySmallCircle]"], "|"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "403591c5-90b3-4df8-8b35-762f745862c3"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["A", "TI"], "\[EmptySmallCircle]"], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v", "TI"], "\[Element]", 
      StyleBox["A", "TI"], ":", 
      StyleBox["N", "TI"], 
      RowBox[{"(", 
       StyleBox["v", "TI"], ")"}], "\[SubsetEqual]", 
      StyleBox["A", "TI"]}], "}"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9fb2e3b4-2768-4c87-bc0f-5de3b67d6bb1"],
 " is the set of vertices all of whose neighbours lie in ",
 Cell[BoxData[
  FormBox[
   StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08179a15-4f48-4466-a400-b4ed75dc0ef9"],
 ". It is the count without the boundary, the default of the volume growth \
estimators."
}], "GuideText",ExpressionUUID->"64034dc5-3f0a-4ce6-83ac-93e7531d2bb9"],

