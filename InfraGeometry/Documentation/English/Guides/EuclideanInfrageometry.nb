  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "7d022b14-4964-4a02-947f-fc4d5027205b"],
 " \[LongDash] ",
 "whether a vertex list is a member of a head on a graph"
}], "GuideText",ExpressionUUID->"a0320feb-c91c-4ffa-8056-0b079f304266"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Substrates and Drawing", "GuideFunctionsSubsection",ExpressionUUID->"f8140e4e-3cc8-4da1-bc65-17b05f84e398"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
