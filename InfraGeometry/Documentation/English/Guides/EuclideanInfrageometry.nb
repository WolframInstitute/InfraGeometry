Cell[CellGroupData[{

Cell["Measures", "GuideFunctionsSubsection",ExpressionUUID->"c1803eba-a0cb-471a-a385-f893f357db07"],

Cell[TextData[{
 "A region on a graph is measured by counting vertices, and its boundary is \
never negligible at a finite scale: the vertices at distance exactly ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96efff77-dd01-42e1-8b73-b2d5b61002c5"],
 " are a share of order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    StyleBox["r", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2edd2944-edc1-4a5c-8543-0ed6ada17ff3"],
 " of the ball of radius ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf29f97e-29b7-4e41-b221-1747931b1168"],
 ". So every region carries two measures, read by InfraMeasurement as \
properties of the region on a graph."
}], "GuideText",ExpressionUUID->"d5db68ae-e530-475e-8796-f29aac289012"],

Cell[TextData[{
 "Counting measure, \"CountingMeasure\": ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", 
    RowBox[{"(", 
     StyleBox["A", "TI"], ")"}], "\[LongEqual]", "|", 
    StyleBox["A", "TI"], "|"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a37a001-e52a-493c-9000-3fc07f9f2d12"],
 ", the number of vertices of the support ",
 Cell[BoxData[
  FormBox[
   StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "347f1de9-8c58-434b-a41e-3d902579ad0f"],
 " of the region."
}], "GuideText",ExpressionUUID->"9cb4a5b1-d564-4976-9967-11c87af2133f"],

Cell[TextData[{
 "Riemannian measure, \"RiemannianMeasure\": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Mu]", "\[EmptySmallCircle]"], 
    RowBox[{"(", 
     StyleBox["A", "TI"], ")"}], "\[LongEqual]", "|", 
    SuperscriptBox[
     StyleBox["A", "TI"], "\[EmptySmallCircle]"], "|"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7152aaa0-68f1-4678-bf43-de6ff4c642bb"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["A", "TI"], "\[EmptySmallCircle]"], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v", "TI"], "\[Element]", 
      StyleBox["A", "TI"], ":", 
      StyleBox["N", "TI"], 
      RowBox[{"(", 
       StyleBox["v", "TI"], ")"}], "\[SubsetEqual]", 
      StyleBox["A", "TI"]}], "}"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55352c5a-f20a-45cb-8b9b-437d241fcdd6"],
 " is the set of vertices all of whose neighbours lie in ",
 Cell[BoxData[
  FormBox[
   StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61df8c8f-21fb-48f8-9b70-d43d1067e261"],
 ". It is the count without the boundary, the default of the volume growth \
estimators."
}], "GuideText",ExpressionUUID->"c9e89e9a-2af1-4e02-96d2-322b0b18557c"],

