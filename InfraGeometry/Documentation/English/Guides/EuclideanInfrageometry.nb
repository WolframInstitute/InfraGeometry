  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "8466d38b-819f-45f1-9429-b05f01949568"],
 " \[LongDash] ",
 "a step-by-step view of a scene on a graph"
}], "GuideText",ExpressionUUID->"db5a1005-ac35-4b66-a4f5-42fc8d98b3f8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Underlying graphs", "GuideFunctionsSubsection",ExpressionUUID->"68beaf4d-719c-4ff1-8925-ce0737213873"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SegmentGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SegmentGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "0ab70b89-a092-471a-ab8f-20c698d83080"],
 " \[LongDash] ",
 "the interval I(p, q) as a directed acyclic graph whose directed p-q paths \
are exactly the shortest paths from p to q: the graph of InfraSegment[p, q]"
}], "GuideText",ExpressionUUID->"eecff706-52a5-4a9a-bc4e-65a2b6bd8b3b"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SprayGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "a5817f31-23ec-48f5-91d4-678f75948ee3"],
 " \[LongDash] ",
 "the breadth-first DAG rooted at c, whose source-to-sink paths are exactly \
the maximal shortest paths from c"
}], "GuideText",ExpressionUUID->"cc82ed76-b40e-4727-becf-ced8040464c5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Not here", "GuideFunctionsSubsection",ExpressionUUID->"85fefe94-48ec-4aea-b423-f0bb6f520e6b"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindBallHull"]], 
