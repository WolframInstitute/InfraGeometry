Cell[TextData[{
 "Ball on the square grid: counting measure ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "+", "2", 
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d09141bb-dc40-423e-b553-fc93db7a1809"],
 ", Riemannian measure ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "-", "2", 
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5660997f-8763-4192-af7c-41b165f3ad2d"],
 ", the counting measure of the ball of radius ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d162a6b-ec46-420d-a3de-5bb1d171c70d"],
 ". The same shift holds on the triangular lattice, before the rim, and is \
the convention of the Wolfram Physics technical introduction; on the \
hexagonal lattice it is measured, not proved."
}], "GuideText",ExpressionUUID->"7e058e29-d375-49de-b801-f3f7a2ff1dd5"],

Cell[TextData[{
 "Shell on the square grid: counting measure ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f0bc3d9-6f48-402b-a4bf-4093250d00a3"],
 ", the coordination sequence; Riemannian measure ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbbc8780-723d-4841-9e2f-4f89c443375d"],
 ", since a shell is all boundary."
}], "GuideText",ExpressionUUID->"5315af41-6082-418c-8f8b-243ddae273cd"],

Cell[TextData[{
 "Segment on the square grid between vertices ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d776e83e-5c97-429c-8b3b-728ed0d66401"],
 " and ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc4e5ad2-a08c-4533-975b-35769f58f59e"],
 " steps apart along the two axes, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], ",", 
   RowBox[{
    StyleBox["b", "TI"], "\[GreaterEqual]", "1"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "910d9ae5-b3ad-4539-a8e4-6138c60b1f2b"],
 ": its interval is a rectangle, with counting measure ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["b", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "afc48fad-7688-4438-a34e-0ceaa82c7b4e"],
 " and Riemannian measure ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["b", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7943b6f-e006-4b5b-bf6b-cc0a9ddd68c3"],
 "."
}], "GuideText",ExpressionUUID->"2b49ff74-40e4-4d8e-89ef-18e9c3db7767"],

Cell[TextData[{
 "Ball on the discretized plane: the Riemannian measure can exceed the \
counting measure of the smaller ball, when a vertex at distance ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05126a21-c32e-417c-9705-08cabe1b274c"],
 " has no neighbour at distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9e94831-d391-48d6-a24f-7e31b18781ed"],
 "."
}], "GuideText",ExpressionUUID->"05f1ab20-3e12-449e-a4c1-2e278b848fa6"],

