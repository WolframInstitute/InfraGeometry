Cell[CellGroupData[{

Cell["Multi-constructions", "GuideFunctionsSubsection",ExpressionUUID->"08191f62-6ca5-40bf-a398-3388b4394a82"],

Cell["\<\
Whereas the causal graph of Euclidean constructions is causally invariant, \
the branchial graphs in infrageometry are non-trivial due to \
multi-constructions.\
\>", "GuideText",ExpressionUUID->"8390e3c3-d237-484b-82dc-91394c70de29"],

