  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "ed193976-9d6d-4f18-825b-9f356a630f9e"],
 " \[LongDash] ",
 "one solved binding of a scene; with an object name, reads that object out \
of it"
}], "GuideText",ExpressionUUID->"595bcd08-41bf-49ae-8988-c6e495d11160"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSceneViewer"]], 
