Cell[CellGroupData[{

Cell["Measures", "GuideFunctionsSubsection",ExpressionUUID->"807e9e44-4189-4410-9679-ca73529d3e46"],

Cell[TextData[{
 "A region on a graph is measured by counting vertices, and its boundary is \
never negligible at a finite scale: the vertices at distance exactly ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9010bd5-72ac-4081-93d6-02d21d827f79"],
 " are a share of order ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6cfdd7b-183e-4536-8c51-8d3058c63f83"],
 " of the ball of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ae52888-a2c8-4852-8334-5cbb2124e728"],
 ". So every region carries two measures, read by InfraMeasurement as \
properties of the region on a graph."
}], "GuideText",ExpressionUUID->"52387075-6ee6-45e6-a300-8f7602b0a5f1"],

Cell[TextData[{
 "Counting measure, \"CountingMeasure\": ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Mu]", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["A", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   TemplateBox[{
     StyleBox["A", "TI"]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c6f13fb-5b29-47c9-9e60-fcf5e3c9ae7b"],
 ", the number of vertices of the support ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd2c5d90-da34-4cad-9cbc-b713300128aa"],
 " of the region."
}], "GuideText",ExpressionUUID->"90ee5e1c-f1fc-4998-891e-b8f7a11447bf"],

Cell[TextData[{
 "Riemannian measure, \"RiemannianMeasure\": ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Mu]", "TI"], "\[SmallCircle]"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["A", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   TemplateBox[{
     SuperscriptBox[
      StyleBox["A", "TI"], "\[SmallCircle]"]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f99e1a0f-ecfd-4ffe-990c-fccdceb901ac"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["A", "TI"], "\[SmallCircle]"], "=", "{", 
    StyleBox["v", "TI"], "\[Element]", 
    StyleBox["A", "TI"]}], ":", 
   RowBox[{
    StyleBox["N", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[SubsetEqual]", 
    StyleBox["A", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de8defdc-f1c2-44fd-bcec-bc037a69cc55"],
 " is the set of vertices all of whose neighbours lie in ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3324918d-fc6f-4e6a-bfe5-a370db250fc3"],
 ". It is the count without the boundary, the default of the volume growth \
estimators."
}], "GuideText",ExpressionUUID->"3fafae74-9741-4dae-a1fa-b6b756d74b23"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
