Cell[CellGroupData[{

Cell["Underlying graphs", "GuideFunctionsSubsection",ExpressionUUID->"3e992aaa-f5f6-4d27-978a-55e8a788705b"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
