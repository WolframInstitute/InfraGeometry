Cell[CellGroupData[{

Cell["Measures", "GuideFunctionsSubsection",ExpressionUUID->"7cd6e446-7b9c-4d98-a9ab-326390c86b7b"],

Cell[TextData[{
 "A region on a graph is measured by counting vertices, and its boundary is \
never negligible at a finite scale: the vertices at distance exactly ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20a28d76-3779-460e-b6a7-7cb764f38496"],
 " are a share of order ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0690708a-07b6-447c-a3c2-449f6d729673"],
 " of the ball of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff7d114f-d0c4-46e9-a565-ff7312461b0a"],
 ". So every region carries two measures, read by InfraMeasurement as \
properties of the region on a graph."
}], "GuideText",ExpressionUUID->"e79a6679-a127-4b41-afbe-5432ffdb89cb"],

Cell[TextData[{
 "Counting measure, \"CountingMeasure\": ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Mu]", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["A", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   TemplateBox[{
     StyleBox["A", "TI"]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db8f4351-5092-437c-a5c3-3fe836b81e97"],
 ", the number of vertices of the support ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e1dd1b2-2157-4d5a-a086-313c3c3f0d3d"],
 " of the region."
}], "GuideText",ExpressionUUID->"84d57091-42e2-4d2b-875a-e30caa7bfc67"],

Cell[TextData[{
 "Riemannian measure, \"RiemannianMeasure\": ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Mu]", "TI"], "\[SmallCircle]"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["A", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   TemplateBox[{
     SuperscriptBox[
      StyleBox["A", "TI"], "\[SmallCircle]"]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2163603-a1f8-4eab-84b5-357f2782961f"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["A", "TI"], "\[SmallCircle]"], "=", "{", 
    StyleBox["v", "TI"], "\[Element]", 
    StyleBox["A", "TI"]}], ":", 
   RowBox[{
    StyleBox["N", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[SubsetEqual]", 
    StyleBox["A", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15bd7900-de57-4ab9-b7e5-90a1b36dcfb2"],
 " is the set of vertices all of whose neighbours lie in ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7e0fb72-e796-4d1b-bbcf-99af4e0abebb"],
 ". It is the count without the boundary, the default of the volume growth \
estimators."
}], "GuideText",ExpressionUUID->"d99b5a97-af3d-4859-95d0-61bd95798e94"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
