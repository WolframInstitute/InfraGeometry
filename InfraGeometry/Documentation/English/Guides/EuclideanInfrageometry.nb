Cell[TextData[{
 "Ball on the square grid: counting measure ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "+", "2", 
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dda036ec-7dc3-43e6-89e7-496bd5594040"],
 ", Riemannian measure ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "-", "2", 
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e06a4fe7-b5d6-478a-9337-ea88ff8e92dd"],
 ", the counting measure of the ball of radius ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e80d9eb-41a9-4381-a6b8-07921db475ac"],
 ". The same shift holds on the triangular lattice, before the rim, and is \
the convention of the Wolfram Physics technical introduction; on the \
hexagonal lattice it is measured, not proved."
}], "GuideText",ExpressionUUID->"f0b712ab-c84a-4e26-8faf-fd3005dd3d1b"],

Cell[TextData[{
 "Shell on the square grid: counting measure ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4039fa00-b8d9-4736-bbb3-f68072316bc1"],
 ", the coordination sequence; Riemannian measure ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb2b7173-b306-41a6-bd01-0443e4550280"],
 ", since a shell is all boundary."
}], "GuideText",ExpressionUUID->"5b85a51e-2937-4c74-9067-a5efea702dbb"],

Cell[TextData[{
 "Segment on the square grid between vertices ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55daa5bf-4798-4593-8fff-38153589275f"],
 " and ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d602d8f1-8fdd-4c3a-9fcf-742ccd9c9972"],
 " steps apart along the two axes, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], ",", 
   RowBox[{
    StyleBox["b", "TI"], "\[GreaterEqual]", "1"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5627afde-aef0-466c-b74f-786d0e7bdc23"],
 ": its interval is a rectangle, with counting measure ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["b", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2b523a6-d22e-4383-b9d0-e751a054f0a5"],
 " and Riemannian measure ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["b", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d482a757-470e-4cf4-bc78-f6a0296c0825"],
 "."
}], "GuideText",ExpressionUUID->"2044de8c-fea8-4f2a-b3e2-2f0d3bfbc6e2"],

Cell[TextData[{
 "Ball on the discretized plane: the Riemannian measure can exceed the \
counting measure of the smaller ball, when a vertex at distance ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e05aa4d1-325d-4d23-9f52-fa30fca3e5d5"],
 " has no neighbour at distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c92736c-921e-4c19-a9e8-f569c3e7c999"],
 "."
}], "GuideText",ExpressionUUID->"fda2a3b7-0605-4a92-93fc-f2724a5e8f8a"],

