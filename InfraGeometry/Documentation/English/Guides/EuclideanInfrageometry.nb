  "d02abe83-ee2c-484c-802c-208b510ab0c4"],
 " \[LongDash] ",
 "the region heads, each measured by both; so is every Euclidean head, \
through the support of its vertex density"
}], "GuideText",ExpressionUUID->"e11aedc6-6dad-4e2c-9c1e-cd03698935cd"],

Cell[TextData[{
 "Ball on the square grid: counting measure ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SuperscriptBox[
     StyleBox["r", "TI"], "2"], "+", "2", 
    StyleBox["r", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dfebe2d3-440c-4442-9553-5ef12c73f51f"],
 ", Riemannian measure ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SuperscriptBox[
     StyleBox["r", "TI"], "2"], "-", "2", 
    StyleBox["r", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af647136-8dfc-4254-bf3d-7f06d9dbae21"],
 ", the counting measure of the ball of radius ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c15db97-00aa-4cc3-aae5-259a2a4d52e7"],
 ". The same shift holds on the triangular lattice, before the rim, and is \
the convention of the Wolfram Physics technical introduction; on the \
hexagonal lattice it is measured, not proved."
}], "GuideText",ExpressionUUID->"66d9a86f-53b4-468a-b80e-3d706ea50fc8"],

Cell[TextData[{
 "Shell on the square grid: counting measure ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", 
    StyleBox["r", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8af7364-4351-4956-a0e2-72955e790ed8"],
 ", the coordination sequence; Riemannian measure ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f47fae9-5cb2-4bb9-837c-17dad1531876"],
 ", since a shell is all boundary."
}], "GuideText",ExpressionUUID->"7abf0a23-c22a-401d-8789-375f9c491953"],

Cell[TextData[{
 "Segment on the square grid between vertices ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0c5aca3-54da-4075-ad9c-140bc3de09b2"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1167a8a0-7517-4fc6-8aa7-6d97a0b0ff74"],
 " steps apart along the two axes, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"], "\[GreaterEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00b0e3e0-fb08-4ac2-bc10-d5fded5fe6c0"],
 ": its interval is a rectangle, with counting measure ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["a", "TI"], "+", "1"}], ")"}], "(", 
    RowBox[{
     StyleBox["b", "TI"], "+", "1"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30e5f949-98eb-4127-af94-10f99b979a80"],
 " and Riemannian measure ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["a", "TI"], "-", "1"}], ")"}], "(", 
    RowBox[{
     StyleBox["b", "TI"], "-", "1"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f24bca1b-e5d3-41f6-8614-dd832022aee2"],
 "."
}], "GuideText",ExpressionUUID->"4cb70474-b542-4481-8b43-bc8c2a026535"],

Cell[TextData[{
 "Ball on the discretized plane: the Riemannian measure can exceed the \
counting measure of the smaller ball, when a vertex at distance ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd8dd237-0edd-4f86-8eb0-974356bcd4da"],
 " has no neighbour at distance ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "858ec0e7-433e-4966-876b-b1a8dee739fc"],
 "."
}], "GuideText",ExpressionUUID->"0eecd4f7-8106-44f7-a2d8-1d5c0a935b31"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VolumeGrowthObservables"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "de7d6888-aa37-4215-b3cb-b92d2e331842"],
 " \[LongDash] ",
 "the dimension and the scalar curvature read from the growth of the balls \
under either measure; it lives on the Riemannian Infrageometry guide"
}], "GuideText",ExpressionUUID->"c2ab5271-f1e7-4a35-85cc-fafee872bebf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Find Functions", "GuideFunctionsSubsection",ExpressionUUID->"611d2eae-458c-49fe-8819-53fab8095083"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "772f0f4e-ae75-4912-8b6c-fa2f5cd9736a"],
 " \[LongDash] ",
 "a vertex drawn from the candidate pool, narrowed by \"From\" and \"Distance\
\"; a trailing count gives a List of vertices"
}], "GuideText",ExpressionUUID->"c7054837-0107-4259-bdd0-d75f25a09862"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraMidpoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraMidpoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "59b465bb-a6eb-4b68-896a-98e2ab79fe61"],
 " \[LongDash] ",
 "the middle vertices of the shortest paths from p1 to p2 as a density, one \
vertex at even distance, two at odd"
}], "GuideText",ExpressionUUID->"514af773-10b2-4061-9e36-94d1210c22a5"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraEquidistantSet"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraEquidistantSet", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "598ba235-38b0-487c-840e-23e506da2d26"],
 " \[LongDash] ",
 "the vertices equidistant from p1, \[Ellipsis], pn, as a sorted vertex list; \
a trailing {lo, hi} thickens each bisector to a slab"
}], "GuideText",ExpressionUUID->"054def35-5e30-40da-9834-f5c7a17439c3"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "05518506-d885-47ff-be60-b6da45356419"],
 " \[LongDash] ",
 "n inclusion-minimal connected subsets of the shell of c that separate its \
inside from its outside; Properties chooses the class, \"NextVertexFunction\" \
the order of the peel"
}], "GuideText",ExpressionUUID->"3c52df00-8f51-4598-9eb5-bec982d9704c"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "ce47e0cc-769b-413b-ab95-1f80b96071aa"],
 " \[LongDash] ",
 "one shortest path from p to q as a vertex list; a trailing count gives a \
List of them"
}], "GuideText",ExpressionUUID->"2c1e3ddb-168a-4703-b829-bb71ec476a41"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRay"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "89971e64-04cd-4a0a-a2c3-73e9019ca7ed"],
 " \[LongDash] ",
 "one ray from p through q as a vertex list, a shortest path from p through q \
that no neighbour of its last vertex prolongs; a trailing count gives a List \
of them"
}], "GuideText",ExpressionUUID->"6e0af996-2203-444a-831b-8ec54edf8a25"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "8f82f440-1da1-4335-a486-2b9dd1042e0d"],
 " \[LongDash] ",
 "one line through p and q as a vertex list, an inextensible shortest path \
through both; a trailing count gives a List of them"
}], "GuideText",ExpressionUUID->"3d6d71bd-e94b-484d-b4d3-5787d115cdea"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Measurements", "GuideFunctionsSubsection",ExpressionUUID->"c05fc5af-986c-40e4-88ad-15c3c793a7d1"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "e994f6c6-2c3c-462b-bc36-0c33783f721b"],
 " \[LongDash] ",
 "a property of a head on a graph: \"Graph\", \"Cardinality\", \"Length\", \
\"VertexDensity\", \"EdgeDensity\", \"Subgraph\", \"Faithful\", \
\"CountingMeasure\" and \"RiemannianMeasure\"; a List of properties gives an \
Association, All gives every property"
}], "GuideText",ExpressionUUID->"0a364e93-17b6-4d60-af36-4a0d1baf30e3"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDensity"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDensity", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "0c8dbf41-2b3b-455a-ba15-b41e5dcfe444"],
 " \[LongDash] ",
 "the marginal of any shape to the vertex set with respect to the counting \
measure: a vertex, a vertex list, a density, a walk graph; the one coercion \
in the API"
}], "GuideText",ExpressionUUID->"84a2b074-b10a-4f6e-ab80-dd7109c0001d"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "47cb05b7-50a9-487d-997c-424d8d027e6f"],
 " \[LongDash] ",
 "one member of a head as a vertex list, read off its graph or found by its \
search; a trailing count gives a List of them, \"RandomChoice\" a random \
member"
}], "GuideText",ExpressionUUID->"cc2faf3c-3d25-4437-bda0-81dcc2c6830c"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
