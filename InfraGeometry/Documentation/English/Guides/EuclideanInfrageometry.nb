}], "GuideText",ExpressionUUID->"8f5f6b6d-a90f-4e1a-829e-82f9641a5273"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Underlying graphs", "GuideFunctionsSubsection",ExpressionUUID->"fad15d14-cd01-421d-80b8-b28e1f60268f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
