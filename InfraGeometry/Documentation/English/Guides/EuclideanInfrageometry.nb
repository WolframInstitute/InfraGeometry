    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "e9b2128a-cd31-4efc-bdf1-7a3c16e9dd21"],
 " \[LongDash] ",
 "the named example substrates at size \"Small\", \"Medium\" or \"Large\": \
the tilings, meshes and closed surfaces the other pages draw on; \
InfraSubstrate[] lists the roster"
}], "GuideText",ExpressionUUID->"c9a277b4-4d85-41f4-997f-da666a6e7813"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "a4149d83-0a73-4065-9ef2-1af67ca45a27"],
 " \[LongDash] ",
 "the summed densities of a list of objects drawn on a graph, the i-th object \
in the i-th palette color; a Directive styles the objects after it"
}], "GuideText",ExpressionUUID->"bf8af9e7-8e89-4d98-ba39-0a6d5697be03"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Multi-constructions", "GuideFunctionsSubsection",ExpressionUUID->"983e4338-68ee-4df1-a989-c1f2b49266bf"],

Cell["\<\
Whereas the causal graph of Euclidean constructions is causally invariant, \
the branchial graphs in infrageometry are non-trivial due to \
multi-constructions.\
\>", "GuideText",ExpressionUUID->"e4666b62-e2eb-4f1e-b2a3-38979671cc22"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "2e64363a-0d23-4b80-9a46-4ae54612777a"],
 " \[LongDash] ",
 "a construction stated before any graph: the objects, and hypotheses that \
construct them with inert heads or assert relations between them"
}], "GuideText",ExpressionUUID->"280485ac-00f2-4618-9bff-8eb6188d4eb5"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraStep"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraStep", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "529a8843-7246-4ead-a831-6d9dfe53d7ae"],
 " \[LongDash] ",
 "one construction encapsulated as a step of a scene; a second argument \
labels it"
}], "GuideText",ExpressionUUID->"43ca9527-aeea-4115-87c6-05a5490accac"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraScene"]], 
