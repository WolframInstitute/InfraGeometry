  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "3878012d-5259-4163-aca2-2e924ebe5f4d"],
 " \[LongDash] ",
 "whether a vertex list is a member of a head on a graph"
}], "GuideText",ExpressionUUID->"fae61450-687d-4851-9929-89f4beb18990"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Substrates and Drawing", "GuideFunctionsSubsection",ExpressionUUID->"ccf897c7-93e0-4281-a839-9dd0db5046a7"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
