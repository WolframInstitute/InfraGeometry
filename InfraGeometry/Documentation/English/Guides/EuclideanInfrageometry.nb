Cell[CellGroupData[{

Cell["Measures", "GuideFunctionsSubsection",ExpressionUUID->"100f9b4f-ce98-4ded-8fbe-828d2ca4c9c0"],

Cell[TextData[{
 "A region on a graph is measured by counting vertices, and its boundary is \
never negligible at a finite scale: the vertices at distance exactly ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "996abd49-7916-43ea-9f8c-ed36e2bdb0c6"],
 " are a share of order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    StyleBox["r", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26254971-4eef-4eea-afa6-c0ae0d029ca7"],
 " of the ball of radius ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fde376a3-05f8-49f2-9d3d-cd4d71855752"],
 ". So every region carries two measures, read by InfraMeasurement as \
properties of the region on a graph."
}], "GuideText",ExpressionUUID->"9f138a61-ba7b-43f0-981d-29336b394287"],

Cell[TextData[{
 "Counting measure, \"CountingMeasure\": ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", 
    RowBox[{"(", 
     StyleBox["A", "TI"], ")"}], "\[LongEqual]", "|", 
    StyleBox["A", "TI"], "|"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60491b25-2a6b-499d-a1b4-4e6f72dfa248"],
 ", the number of vertices of the support ",
 Cell[BoxData[
  FormBox[
   StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f83d50ba-753e-41a1-ac2d-6f9a59c356e9"],
 " of the region."
}], "GuideText",ExpressionUUID->"46cc8f88-6d48-4a16-9353-f70d4feeac19"],

Cell[TextData[{
 "Riemannian measure, \"RiemannianMeasure\": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Mu]", "\[EmptySmallCircle]"], 
    RowBox[{"(", 
     StyleBox["A", "TI"], ")"}], "\[LongEqual]", "|", 
    SuperscriptBox[
     StyleBox["A", "TI"], "\[EmptySmallCircle]"], "|"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65afdcf8-c2db-4cf3-805a-0e39c6888767"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["A", "TI"], "\[EmptySmallCircle]"], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v", "TI"], "\[Element]", 
      StyleBox["A", "TI"], ":", 
      StyleBox["N", "TI"], 
      RowBox[{"(", 
       StyleBox["v", "TI"], ")"}], "\[SubsetEqual]", 
      StyleBox["A", "TI"]}], "}"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2283b9c6-9fd2-40d4-bfb6-5201ce8d0bef"],
 " is the set of vertices all of whose neighbours lie in ",
 Cell[BoxData[
  FormBox[
   StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8388788d-33b1-4cb7-a2aa-b514ca749f18"],
 ". It is the count without the boundary, the default of the volume growth \
estimators."
}], "GuideText",ExpressionUUID->"feaa3367-f5a0-4646-b78f-1606d274a80b"],

