  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "4b8d804a-9af3-4616-ac47-223898d7102a"],
 " \[LongDash] ",
 "one solved binding of a scene; with an object name, reads that object out \
of it"
}], "GuideText",ExpressionUUID->"bad7291b-d0a3-49cb-a409-0cfbf8b9ab3f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSceneViewer"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSceneViewer", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "12e24503-9b2a-4906-a08d-d3360807e5e8"],
 " \[LongDash] ",
 "a step-by-step view of a scene on a graph"
}], "GuideText",ExpressionUUID->"e00267f8-4e5c-45d6-921d-bda60dc1173b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Underlying graphs", "GuideFunctionsSubsection",ExpressionUUID->"dbec8f4e-501d-4755-b44d-eff79d8cf030"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SprayGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "8ce6fb20-b754-40d6-a821-69a244a565d8"],
 " \[LongDash] ",
 "the breadth-first DAG rooted at c, whose source-to-sink paths are exactly \
the maximal shortest paths from c"
}], "GuideText",ExpressionUUID->"1b127963-972f-4af1-ba80-c38a1e2d2456"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Not here", "GuideFunctionsSubsection",ExpressionUUID->"55542c66-179d-4565-9a21-290f354c4463"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindBallHull"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindBallHull", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "b9dacaae-142d-402e-8910-26df3d49bf30"],
 " \[LongDash] ",
 "the intersection of all balls containing a set of points; it lives on the \
Infra Topology guide"
}], "GuideText",ExpressionUUID->"cd949166-5a40-463c-8b69-a45d3277db71"],

Cell["\<\
not here: the quadric as an inert head and the layers of the convex hull; \
FindInfraQuadric stays on the Experimental guide\
\>", "GuideText",ExpressionUUID->"f66ef98e-227a-47cf-89d7-7d30d67dda34"],

Cell["\<\
not here: an invariant of four points, the inverse of every head (the values \
of its unknowns for a given vertex set), and the graph of a line or of an arc \
as an exported name; none is in an item yet\
\>", "GuideText",ExpressionUUID->"2e5d9066-fd90-4e69-9f01-d0f98a072115"],

Cell["\<\
not here: the interactive multi-construction stepper in the causal and \
branchial direction; it stays on the Experimental guide\
\>", "GuideText",ExpressionUUID->"22ced026-7826-495f-903b-dc5ce3366c22"]
}, Open  ]]
}, Open  ]],

