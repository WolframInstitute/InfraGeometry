  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "f0ea94f8-e7f0-4c48-bcef-ef29db61be30"],
 " \[LongDash] ",
 "a step-by-step view of a scene on a graph"
}], "GuideText",ExpressionUUID->"1921c4cc-968e-46ca-ad9a-f989641894f2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Underlying graphs", "GuideFunctionsSubsection",ExpressionUUID->"c485b3e8-8cfa-48bc-8f27-2c4fed7f04be"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SegmentGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SegmentGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "317994cf-1954-470d-a02b-7e2b4cfd10f4"],
 " \[LongDash] ",
 "the interval I(p, q) as a directed acyclic graph whose directed p-q paths \
are exactly the shortest paths from p to q: the graph of InfraSegment[p, q]"
}], "GuideText",ExpressionUUID->"be3e2dae-2db8-45b4-8b73-6eaa344e4ba7"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SprayGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "474138e6-05bc-428e-bef6-3d079f23930a"],
 " \[LongDash] ",
 "the breadth-first DAG rooted at c, whose source-to-sink paths are exactly \
the maximal shortest paths from c"
}], "GuideText",ExpressionUUID->"e829bca3-7b1f-41a0-ac0f-8be141c4ea6c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Not here", "GuideFunctionsSubsection",ExpressionUUID->"6253f2d9-5783-4865-8af5-b90c35f18070"],

