Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "13166c65-b57e-4d86-9b2f-efda63a7e424"],
 " \[LongDash] ",
 "the summed densities of a list of objects drawn on a graph, the i-th object \
in the i-th palette color; a Directive styles the objects after it"
}], "GuideText",ExpressionUUID->"4ab68e74-73a9-4974-8dd4-5d07c09b127f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Multi-constructions", "GuideFunctionsSubsection",ExpressionUUID->"52c95d46-80d6-495f-b5d4-8f6ee660cc59"],

Cell["\<\
Whereas the causal graph of Euclidean constructions is causally invariant, \
the branchial graphs in infrageometry are non-trivial due to \
multi-constructions.\
\>", "GuideText",ExpressionUUID->"db0bcd37-bef1-41a8-87b0-15fbaf4d2c9a"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "70a7eeb3-ad84-4639-873b-a7c655f2818d"],
 " \[LongDash] ",
 "a construction stated before any graph: the objects, and hypotheses that \
construct them with inert heads or assert relations between them"
}], "GuideText",ExpressionUUID->"78bea4a0-7450-4320-b70b-6038cef46107"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraStep"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraStep", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "e69ba6ec-8620-4901-97ea-5eae00208b4f"],
 " \[LongDash] ",
 "one construction encapsulated as a step of a scene; a second argument \
labels it"
}], "GuideText",ExpressionUUID->"16f6158b-a626-4e8f-a487-31e67c098507"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "3327a4bb-b8bc-49bd-885e-1fa102d5a594"],
 " \[LongDash] ",
 "a scene solved on a graph, step by step; a List of bindings, one per \
admissible combination"
}], "GuideText",ExpressionUUID->"30d869fc-30e2-4f44-878e-1815173285b7"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSceneInstance"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSceneInstance", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "6ddbe8aa-3581-4916-afe2-5ffb8a434744"],
 " \[LongDash] ",
 "one solved binding of a scene; with an object name, reads that object out \
of it"
}], "GuideText",ExpressionUUID->"ce6433fa-f332-4395-a8a2-e52147b66c7e"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSceneViewer"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSceneViewer", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "e20eff9b-4f8a-463e-b58a-6d43ae2acbc0"],
 " \[LongDash] ",
 "a step-by-step view of a scene on a graph"
}], "GuideText",ExpressionUUID->"afabc7e0-53d9-412f-a7cd-f686c025cad9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Underlying graphs", "GuideFunctionsSubsection",ExpressionUUID->"fac9a229-41af-48a2-a2b3-abfee4566a2e"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SegmentGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SegmentGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "327e4c72-f810-44cc-9a37-6b0fd01f973c"],
 " \[LongDash] ",
 "the interval I(p, q) as a directed acyclic graph whose directed p-q paths \
are exactly the shortest paths from p to q: the graph of InfraSegment[p, q]"
}], "GuideText",ExpressionUUID->"05ba7934-4534-4f9d-8e3d-5e9c747fda69"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SprayGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "092fb99d-ece2-446c-a3a4-0543e45948a1"],
 " \[LongDash] ",
 "the breadth-first DAG rooted at c, whose source-to-sink paths are exactly \
the maximal shortest paths from c"
}], "GuideText",ExpressionUUID->"42dfabce-88e2-46e0-8660-d84c9b192aef"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Not here", "GuideFunctionsSubsection",ExpressionUUID->"8a71ed6b-ae80-470e-846d-e9d6e4a07b2d"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindBallHull"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindBallHull", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "e6576892-ffa9-41be-8feb-27e138752339"],
 " \[LongDash] ",
 "the intersection of all balls containing a set of points; it lives on the \
Infra Topology guide"
}], "GuideText",ExpressionUUID->"ff33176e-5160-4ea1-a24a-99ef6a9e4d1c"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TubeVolumes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TubeVolumes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "9b374896-abee-474d-ab14-b569c175706f"],
 " \[LongDash] ",
 "the volumes of the tube about a core; they live on the Riemannian \
Infrageometry guide"
}], "GuideText",ExpressionUUID->"40f19ee2-2d1f-44bc-b400-aad3c90f854a"],

Cell["\<\
not here: the cone, the sphere and the quadric as inert heads, and the layers \
of the convex hull; they are planned in the backlog item InfraRegions, and \
FindInfraQuadric stays on the Experimental guide\
\>", "GuideText",ExpressionUUID->"510d5b7b-fd3d-4861-a756-0c6b87a9b446"],

Cell["\<\
not here: an invariant of four points, the inverse of every head (the values \
of its unknowns for a given vertex set), and the graph of a line or of an arc \
as an exported name; none is in an item yet\
\>", "GuideText",ExpressionUUID->"68e00306-8de5-47ef-a547-de7477a33b14"],

Cell["\<\
not here: the interactive multi-construction stepper in the causal and \
branchial direction; it stays on the Experimental guide\
\>", "GuideText",ExpressionUUID->"2e6f0ec3-601f-44ef-928b-eb62f3e78c97"]
}, Open  ]]
}, Open  ]],

