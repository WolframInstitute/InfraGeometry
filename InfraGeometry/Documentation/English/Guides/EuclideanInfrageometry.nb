   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "17687e7e-94a9-47bf-8488-057c456c54c2"],
 " lets us describe a construction through named objects and hypotheses. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraInstance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraInstance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["scene", "TI"], ",", " ", 
    StyleBox["graph", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fbc4e70b-afd5-46a3-8c68-8df0356da6db"],
 " draws an admissible instance on a given substrate, and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSceneViewer"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSceneViewer", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["scene", "TI"], ",", " ", 
    StyleBox["graph", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f55d52f8-6205-4a1d-94ee-5f162ecca4e6"],
 " displays the construction step by step in both the causal and branchial \
directions."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

