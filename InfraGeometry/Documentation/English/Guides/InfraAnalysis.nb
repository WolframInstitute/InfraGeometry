Notebook[{

Cell[CellGroupData[{
Cell["Infra Analysis", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell["\<\
Tangent spaces: the first-order structure of a substrate, with the tangent \
space at a vertex, the displacements that move its vertices, and the \
tautological 1-form. A displacement of scale r sends each vertex to a set of \
vertices within distance r, a discrete flow for time r, and it is multivalued \
by design. Its operations are metric: scaling moves along the geodesics from \
each vertex to its images, the sum is the bisector of the two orders of \
composition, and the commutator is the loop of the two displacements and \
their inverses, or of their metric negatives. The differential forms and \
cochains are on the Experimental guide. The tangent space is the tangent \
bundle, a fibration whose sections are vector fields; the tautological 1-form \
pairs a vector with a covector.\
\>", "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "GuideFunctionsSection",
 CellID->1866139230,ExpressionUUID->"a0ea3657-4c83-4862-93c8-ecf80cebc774"],

Cell[CellGroupData[{

Cell["Tangent spaces", "GuideFunctionsSubsection",ExpressionUUID->"5df94f42-cb76-4c92-b2c0-56770a4b841a"],

Cell[TextData[{
 StyleBox["InfraTangentBundle",
  FontWeight->"Bold"],
 " \[LongDash] the tangent spaces of a graph at scale r, the rays of length r \
over each vertex"
}], "GuideText",ExpressionUUID->"f95c82d4-bb7a-4ee6-a426-3d743a41fbc3"],

Cell[TextData[{
 StyleBox["InfraDisplacementBundle",
  FontWeight->"Bold"],
 " \[LongDash] the displacements of scale r, the pairs of vertices at \
distance r"
}], "GuideText",ExpressionUUID->"6fecb64f-b7fe-4a77-95bf-f44d6ea147c9"],

Cell[TextData[{
 StyleBox["InfraRays",
  FontWeight->"Bold"],
 " \[LongDash] the rays of a given length from a vertex"
}], "GuideText",ExpressionUUID->"6c9cb156-b48d-4d4d-adf4-959dd23cffcf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Displacements", "GuideFunctionsSubsection",ExpressionUUID->"1cf1d6be-7a9e-40ee-abbd-b351dc82cb63"],

Cell[TextData[{
 StyleBox["DisplacementCompose",
  FontWeight->"Bold"],
 " \[LongDash] composes displacements as flows, the leftmost acting first"
}], "GuideText",ExpressionUUID->"913216c3-25bc-440a-a5e5-e59d7038c52d"],

Cell[TextData[{
 StyleBox["DisplacementScale",
  FontWeight->"Bold"],
 " \[LongDash] scales a displacement by t along the geodesics from each \
vertex to its images; t < 0 reflects through the base point"
}], "GuideText",ExpressionUUID->"638d526a-3f0f-417a-a9ab-d6da5d54df69"],

Cell[TextData[{
 StyleBox["DisplacementNegative",
  FontWeight->"Bold"],
 " \[LongDash] the metric negative of a displacement, each step reflected \
through its base point"
}], "GuideText",ExpressionUUID->"658277b0-77be-42f7-8b85-cc5887a3b0de"],

Cell[TextData[{
 StyleBox["DisplacementInverse",
  FontWeight->"Bold"],
 " \[LongDash] the reversed relation, the inverse when the displacement is \
bijective"
}], "GuideText",ExpressionUUID->"7ef50485-2a2f-4b11-b9ef-ed1e604a78e5"],

Cell[TextData[{
 StyleBox["DisplacementSum",
  FontWeight->"Bold"],
 " \[LongDash] the bisector of the two orders of composition of two \
displacements"
}], "GuideText",ExpressionUUID->"e14d1aeb-4ad8-4dbd-98ec-c5972a1cc984"],

Cell[TextData[{
 StyleBox["DisplacementCommutator",
  FontWeight->"Bold"],
 " \[LongDash] the commutator loop of two displacements, by their inverses or \
by their metric negatives"
}], "GuideText",ExpressionUUID->"e7e773d5-885e-42e3-b404-63d20cf53d5a"],

Cell[TextData[{
 StyleBox["DisplacementBracket",
  FontWeight->"Bold"],
 " \[LongDash] the commutator by metric negatives, the scale-dependent bracket"
}], "GuideText",ExpressionUUID->"802d6dfc-430f-42a0-9629-3d20c1ab8381"],

Cell[TextData[{
 StyleBox["DisplacementMagnitude",
  FontWeight->"Bold"],
 " \[LongDash] the largest step of a displacement, its scale"
}], "GuideText",ExpressionUUID->"14c7730b-b5bd-4825-9e7a-18c7c920fe05"],

Cell[TextData[{
 StyleBox["DisplacementReduce",
  FontWeight->"Bold"],
 " \[LongDash] contracts each value set of a displacement to its metric \
centre, iterated to a fixed point"
}], "GuideText",ExpressionUUID->"ce4a6764-90a0-4d15-b472-395ec06fa6c0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Kinds of displacements", "GuideFunctionsSubsection",ExpressionUUID->"2eb51b7d-175d-4c87-8d26-6aec55b623ba"],

Cell[TextData[{
 StyleBox["DisplacementSingleValuedQ",
  FontWeight->"Bold"],
 " \[LongDash] whether every value of a displacement is a single vertex"
}], "GuideText",ExpressionUUID->"35fa008d-c2de-45ae-9d66-5f03707ce890"],

Cell[TextData[{
 StyleBox["DisplacementBijectionQ",
  FontWeight->"Bold"],
 " \[LongDash] whether a displacement is a single-valued permutation of the \
vertices"
}], "GuideText",ExpressionUUID->"bed603db-8d47-4940-8932-6afa4b0db114"],

Cell[TextData[{
 StyleBox["DisplacementIsomorphismQ",
  FontWeight->"Bold"],
 " \[LongDash] whether a displacement is a graph automorphism, a discrete \
Killing displacement"
}], "GuideText",ExpressionUUID->"657a6255-4d3b-4843-963a-f9d13e933ff3"],

Cell[TextData[{
 StyleBox["ContinuousDisplacementQ",
  FontWeight->"Bold"],
 " \[LongDash] whether a displacement is k-continuous, in the weak, Hausdorff \
or strong sense"
}], "GuideText",ExpressionUUID->"2f23761c-d50d-4373-93d6-3d4db79cdc0c"],

Cell[TextData[{
 StyleBox["FindKillingDisplacement",
  FontWeight->"Bold"],
 " \[LongDash] the nontrivial automorphism of least magnitude, as a \
displacement"
}], "GuideText",ExpressionUUID->"f73c01ea-410c-40ca-b0ec-6e36fa1b8246"],

Cell[TextData[{
 StyleBox["KillingDisplacementMagnitude",
  FontWeight->"Bold"],
 " \[LongDash] the least magnitude of a nonidentity automorphism, Infinity on \
an asymmetric graph"
}], "GuideText",ExpressionUUID->"5c92ab5b-8a36-41a8-838a-85af919790b6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Canonical displacements", "GuideFunctionsSubsection",ExpressionUUID->"438497a8-b8f6-4764-a7bf-41f02c6fa4df"],

Cell[TextData[{
 StyleBox["RandomDisplacement",
  FontWeight->"Bold"],
 " \[LongDash] a random continuous displacement of magnitude at most r"
}], "GuideText",ExpressionUUID->"158eb568-fe47-4de6-8c14-e20be497fc65"],

Cell[TextData[{
 StyleBox["PolarDisplacements",
  FontWeight->"Bold"],
 " \[LongDash] the radial and the angular displacement about a centre"
}], "GuideText",ExpressionUUID->"ec2d6a5e-dca6-4012-b8b3-2f4306ab30c8"],

Cell[TextData[{
 StyleBox["GradientDisplacement",
  FontWeight->"Bold"],
 " \[LongDash] the steepest-ascent displacement of a vertex function"
}], "GuideText",ExpressionUUID->"77702ad1-1f29-4c0b-9ee9-e005a1f111a5"],

Cell[TextData[{
 StyleBox["TranslationDisplacement",
  FontWeight->"Bold"],
 " \[LongDash] the translation by a vector of the graph embedding, each \
vertex moved to the nearest vertices"
}], "GuideText",ExpressionUUID->"c3aea722-91f2-48fb-ab8f-b565ca9f80ca"],

Cell[TextData[{
 StyleBox["DisplacementPlot",
  FontWeight->"Bold"],
 " \[LongDash] a displacement, or a sequence of them, drawn as bent arcs over \
the graph"
}], "GuideText",ExpressionUUID->"37cc6c7c-e0ea-4d63-a198-af83dd241586"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The tautological 1-form", "GuideFunctionsSubsection",ExpressionUUID->"f7768b6c-2bfd-40a7-b2b4-b7363d2ab4ac"],

Cell[TextData[{
 StyleBox["InfraCotangentBundle",
  FontWeight->"Bold"],
 " \[LongDash] the tangent bundle on reversed rays"
}], "GuideText",ExpressionUUID->"0f38405c-0fd5-47ef-a176-cacf7fc2981c"],

Cell[TextData[{
 StyleBox["InfraCanonicalOneForm",
  FontWeight->"Bold"],
 " \[LongDash] the pairing of a vector with a covector at a scale, the \
tautological 1-form"
}], "GuideText",ExpressionUUID->"b54f9cda-ffde-4edf-bbf4-ea000ce2cd9a"]
}, Open  ]]
}, Open  ]],

