Notebook[{

Cell[CellGroupData[{
Cell["Infra Analysis", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell["\<\
Tangent spaces and differential forms: the first-order structure of a \
substrate, with the tangent space at a vertex, the displacements that move \
its vertices, the differential forms and cochains, and the tautological \
1-form. A displacement of scale r sends each vertex to a set of vertices \
within distance r, a discrete flow for time r, and it is multivalued by \
design. Its operations are metric: scaling moves along the geodesics from \
each vertex to its images, the sum is the bisector of the two orders of \
composition, and the commutator is the loop of the two displacements and \
their inverses, or of their metric negatives. A form is a germ of values at a \
vertex on tuples of its neighbours, a cochain a value on the cliques of the \
graph; the restriction and integration maps pass between the two, and the \
coboundary, the differential, the wedge and the cup products act on them. The \
tangent space is the tangent bundle, a fibration whose sections are vector \
fields; the tautological 1-form pairs a vector with a covector.\
\>", "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "GuideFunctionsSection",
 CellID->1866139230,ExpressionUUID->"a0ea3657-4c83-4862-93c8-ecf80cebc774"],

Cell[CellGroupData[{

Cell["Tangent spaces", "GuideFunctionsSubsection",ExpressionUUID->"efd60398-8a50-40ee-8896-aef3f2238dc5"],

Cell[TextData[{
 StyleBox["InfraTangentBundle",
  FontWeight->"Bold"],
 " \[LongDash] the tangent spaces of a graph at scale r, the rays of length r \
over each vertex"
}], "GuideText",ExpressionUUID->"7b472028-f2f3-474a-89a1-d440d8420614"],

Cell[TextData[{
 StyleBox["InfraDisplacementBundle",
  FontWeight->"Bold"],
 " \[LongDash] the displacements of scale r, the pairs of vertices at \
distance r"
}], "GuideText",ExpressionUUID->"9f3ce123-4a62-4c47-bcdd-055520774f9f"],

Cell[TextData[{
 StyleBox["InfraRays",
  FontWeight->"Bold"],
 " \[LongDash] the rays of a given length from a vertex"
}], "GuideText",ExpressionUUID->"a55ae59d-9b0a-4a0a-9d12-ad8fbe3a046e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Displacements", "GuideFunctionsSubsection",ExpressionUUID->"b9798c30-1efe-4b71-99fd-6ce361215b31"],

Cell[TextData[{
 StyleBox["DisplacementCompose",
  FontWeight->"Bold"],
 " \[LongDash] composes displacements as flows, the leftmost acting first"
}], "GuideText",ExpressionUUID->"fc61f33b-1155-4a76-88f3-5c42cb6f63b6"],

Cell[TextData[{
 StyleBox["DisplacementScale",
  FontWeight->"Bold"],
 " \[LongDash] scales a displacement by t along the geodesics from each \
vertex to its images; t < 0 reflects through the base point"
}], "GuideText",ExpressionUUID->"5a9af2ca-65a4-446c-932c-389bdb3548f5"],

Cell[TextData[{
 StyleBox["DisplacementNegative",
  FontWeight->"Bold"],
 " \[LongDash] the metric negative of a displacement, each step reflected \
through its base point"
}], "GuideText",ExpressionUUID->"ccee9788-e63b-44f9-a713-18c45c384a34"],

Cell[TextData[{
 StyleBox["DisplacementInverse",
  FontWeight->"Bold"],
 " \[LongDash] the reversed relation, the inverse when the displacement is \
bijective"
}], "GuideText",ExpressionUUID->"d46e1ec2-c545-46f5-8c85-74e9868a8a5a"],

Cell[TextData[{
 StyleBox["DisplacementSum",
  FontWeight->"Bold"],
 " \[LongDash] the bisector of the two orders of composition of two \
displacements"
}], "GuideText",ExpressionUUID->"c17cdce7-e58e-45bf-b1c0-9efe1900823b"],

Cell[TextData[{
 StyleBox["DisplacementCommutator",
  FontWeight->"Bold"],
 " \[LongDash] the commutator loop of two displacements, by their inverses or \
by their metric negatives"
}], "GuideText",ExpressionUUID->"39d6104f-53cb-423b-b82b-53e52c10e8fd"],

Cell[TextData[{
 StyleBox["DisplacementBracket",
  FontWeight->"Bold"],
 " \[LongDash] the commutator by metric negatives, the scale-dependent bracket"
}], "GuideText",ExpressionUUID->"cb9d537e-51d5-4591-9447-40aa44b207ae"],

Cell[TextData[{
 StyleBox["DisplacementMagnitude",
  FontWeight->"Bold"],
 " \[LongDash] the largest step of a displacement, its scale"
}], "GuideText",ExpressionUUID->"4490fc16-c5d0-4cc9-a892-bbef4ce9a64f"],

Cell[TextData[{
 StyleBox["DisplacementReduce",
  FontWeight->"Bold"],
 " \[LongDash] contracts each value set of a displacement to its metric \
centre, iterated to a fixed point"
}], "GuideText",ExpressionUUID->"b67c1a83-14f0-4a0a-ac9f-b70650634725"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Kinds of displacements", "GuideFunctionsSubsection",ExpressionUUID->"b80763f9-38d0-4e26-a44e-29bf305fe046"],

Cell[TextData[{
 StyleBox["DisplacementSingleValuedQ",
  FontWeight->"Bold"],
 " \[LongDash] whether every value of a displacement is a single vertex"
}], "GuideText",ExpressionUUID->"8f0fe059-3d7e-48b2-a966-ecc97e5e53aa"],

Cell[TextData[{
 StyleBox["DisplacementBijectionQ",
  FontWeight->"Bold"],
 " \[LongDash] whether a displacement is a single-valued permutation of the \
vertices"
}], "GuideText",ExpressionUUID->"eade6caa-1d6e-4714-9ffa-c9462d142e19"],

Cell[TextData[{
 StyleBox["DisplacementIsomorphismQ",
  FontWeight->"Bold"],
 " \[LongDash] whether a displacement is a graph automorphism, a discrete \
Killing displacement"
}], "GuideText",ExpressionUUID->"b6bcde19-f703-4344-856a-8661f3d4e25a"],

Cell[TextData[{
 StyleBox["ContinuousDisplacementQ",
  FontWeight->"Bold"],
 " \[LongDash] whether a displacement is k-continuous, in the weak, Hausdorff \
or strong sense"
}], "GuideText",ExpressionUUID->"47ac43ab-01c0-445e-b1ea-23e636d47681"],

Cell[TextData[{
 StyleBox["FindKillingDisplacement",
  FontWeight->"Bold"],
 " \[LongDash] the nontrivial automorphism of least magnitude, as a \
displacement"
}], "GuideText",ExpressionUUID->"825c4698-5923-4fb4-83de-7a19162f31d6"],

Cell[TextData[{
 StyleBox["KillingDisplacementMagnitude",
  FontWeight->"Bold"],
 " \[LongDash] the least magnitude of a nonidentity automorphism, Infinity on \
an asymmetric graph"
}], "GuideText",ExpressionUUID->"c86c9a6b-54c5-4799-9763-b54ca0d302f8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Canonical displacements", "GuideFunctionsSubsection",ExpressionUUID->"4347c0bb-b4c6-4449-9f51-246b51629198"],

Cell[TextData[{
 StyleBox["RandomDisplacement",
  FontWeight->"Bold"],
 " \[LongDash] a random continuous displacement of magnitude at most r"
}], "GuideText",ExpressionUUID->"50856644-2b20-4919-971f-8992087c3db2"],

Cell[TextData[{
 StyleBox["PolarDisplacements",
  FontWeight->"Bold"],
 " \[LongDash] the radial and the angular displacement about a centre"
}], "GuideText",ExpressionUUID->"e86684e9-3015-4d7c-a1ab-56009d676bf4"],

Cell[TextData[{
 StyleBox["GradientDisplacement",
  FontWeight->"Bold"],
 " \[LongDash] the steepest-ascent displacement of a vertex function"
}], "GuideText",ExpressionUUID->"5f8bd1ab-2e55-4b4a-b3af-bc0f69aba3d3"],

Cell[TextData[{
 StyleBox["TranslationDisplacement",
  FontWeight->"Bold"],
 " \[LongDash] the translation by a vector of the graph embedding, each \
vertex moved to the nearest vertices"
}], "GuideText",ExpressionUUID->"8248764c-1108-46b0-9042-64a8aed07920"],

Cell[TextData[{
 StyleBox["DisplacementPlot",
  FontWeight->"Bold"],
 " \[LongDash] a displacement, or a sequence of them, drawn as bent arcs over \
the graph"
}], "GuideText",ExpressionUUID->"cd7429df-2cf7-433a-9823-b2d761d394cf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Forms and cochains", "GuideFunctionsSubsection",ExpressionUUID->"4811ffda-1401-496d-9c62-f81198db7bbf"],

Cell[TextData[{
 StyleBox["FormValue",
  FontWeight->"Bold"],
 " \[LongDash] the value of the germ of a form at a vertex on a tuple of its \
neighbours, alternating in the tuple"
}], "GuideText",ExpressionUUID->"d804485e-cfab-40eb-86a0-d78a027f0a80"],

Cell[TextData[{
 StyleBox["CochainValue",
  FontWeight->"Bold"],
 " \[LongDash] the value of an alternating cochain on a vertex tuple"
}], "GuideText",ExpressionUUID->"cc57c52f-f2b7-41f0-bbe3-becfa7a92783"],

Cell[TextData[{
 StyleBox["OrderedCochainValue",
  FontWeight->"Bold"],
 " \[LongDash] the value of an ordered cochain on an increasing vertex tuple"
}], "GuideText",ExpressionUUID->"2fdbbaf8-f8b6-4a09-9cf7-01d50f120b52"],

Cell[TextData[{
 StyleBox["FormDegree",
  FontWeight->"Bold"],
 " \[LongDash] the degree of a form"
}], "GuideText",ExpressionUUID->"018376e0-c790-4be7-9aee-b6cc0aebf172"],

Cell[TextData[{
 StyleBox["CochainDegree",
  FontWeight->"Bold"],
 " \[LongDash] the degree of a cochain"
}], "GuideText",ExpressionUUID->"6dfe6872-cd42-40b2-8091-302105726d6a"],

Cell[TextData[{
 StyleBox["ZeroForm",
  FontWeight->"Bold"],
 " \[LongDash] a vertex function as a 0-form"
}], "GuideText",ExpressionUUID->"3766ee57-5511-4820-9711-011876feaacc"],

Cell[TextData[{
 StyleBox["RestrictionMap",
  FontWeight->"Bold"],
 " \[LongDash] the form read from an alternating cochain with the base vertex \
prepended"
}], "GuideText",ExpressionUUID->"f9a682e2-9178-41d7-8ecf-5eba6d33f3c0"],

Cell[TextData[{
 StyleBox["IntegrationMap",
  FontWeight->"Bold"],
 " \[LongDash] the cochain averaged from the germs of a form over each \
clique, a left inverse of RestrictionMap"
}], "GuideText",ExpressionUUID->"feb71119-87a3-47bb-8491-9a8b3440f75a"],

Cell[TextData[{
 StyleBox["Coboundary",
  FontWeight->"Bold"],
 " \[LongDash] the coboundary of a cochain, the alternating sum over the \
faces of every clique one dimension up"
}], "GuideText",ExpressionUUID->"8efe0313-8b35-4bd8-94bf-7f261220469f"],

Cell[TextData[{
 StyleBox["FormDifferential",
  FontWeight->"Bold"],
 " \[LongDash] the differential of a form, the gradient on 0-forms and with a \
transport term on 1-forms"
}], "GuideText",ExpressionUUID->"4aee5947-bbc8-48a2-84e6-0de85b0cfc7b"],

Cell[TextData[{
 StyleBox["NaiveDifferential",
  FontWeight->"Bold"],
 " \[LongDash] the differential of a 1-form with the transport term dropped, \
kept for comparison"
}], "GuideText",ExpressionUUID->"2ce0bf7f-9703-422a-a77e-43432704abdd"],

Cell[TextData[{
 StyleBox["FormWedge",
  FontWeight->"Bold"],
 " \[LongDash] the wedge product of forms, fibre by fibre"
}], "GuideText",ExpressionUUID->"aba69603-cce3-4d88-afd9-83332e7c456f"],

Cell[TextData[{
 StyleBox["CochainCup",
  FontWeight->"Bold"],
 " \[LongDash] the cup product of alternating cochains, antisymmetrised over \
the orderings of each clique"
}], "GuideText",ExpressionUUID->"41ee96f9-5737-41d9-a340-00c9d4835455"],

Cell[TextData[{
 StyleBox["OrderedCochainCup",
  FontWeight->"Bold"],
 " \[LongDash] the Alexander-Whitney cup product of ordered cochains"
}], "GuideText",ExpressionUUID->"08313614-3172-4d9d-bbde-82b3edeba7ce"],

Cell[TextData[{
 StyleBox["CochainCupOne",
  FontWeight->"Bold"],
 " \[LongDash] the Steenrod cup-1 product of ordered cochains"
}], "GuideText",ExpressionUUID->"139183d8-29d7-4946-9f4b-ef93a5b0e984"],

Cell[TextData[{
 StyleBox["AntisymmetrizedCup",
  FontWeight->"Bold"],
 " \[LongDash] an alias of CochainCup"
}], "GuideText",ExpressionUUID->"7e3f0358-9a2b-4b51-9ce4-4e07f7240074"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The tautological 1-form", "GuideFunctionsSubsection",ExpressionUUID->"1873d031-7e1d-4504-b80a-346fb5411ecf"],

Cell[TextData[{
 StyleBox["InfraCotangentBundle",
  FontWeight->"Bold"],
 " \[LongDash] the tangent bundle on reversed rays"
}], "GuideText",ExpressionUUID->"954ef4a4-2154-47ce-bdc5-f301d4971748"],

Cell[TextData[{
 StyleBox["InfraCanonicalOneForm",
  FontWeight->"Bold"],
 " \[LongDash] the pairing of a vector with a covector at a scale, the \
tautological 1-form"
}], "GuideText",ExpressionUUID->"d0c65f50-6c81-4cb9-98ce-2a926789eca3"]
}, Open  ]]
}, Open  ]],

