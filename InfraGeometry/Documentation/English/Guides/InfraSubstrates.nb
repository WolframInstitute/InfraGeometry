Cell[CellGroupData[{

Cell["Uniform-length graphs", "GuideFunctionsSubsection",ExpressionUUID->"acb75efe-b626-43cc-a86a-9c80b4998bd1"],

Cell[TextData[{
 StyleBox["UniformLengthGraph",
  FontWeight->"Bold"],
 " \[LongDash] the contact graph of a hard-sphere packing relaxed in a \
region, filling a solid or meshing a surface"
}], "GuideText",ExpressionUUID->"0dbddda8-dd81-4561-9c51-d3c592bda2a9"],

Cell[TextData[{
 StyleBox["UniformLengthEmbedding",
  FontWeight->"Bold"],
