}], "GuideText",ExpressionUUID->"aa14025e-2f5e-4a07-9005-8130f4557a40"],

Cell[TextData[{
 StyleBox["BetheGraph",
  FontWeight->"Bold"],
 " \[LongDash] the finite Bethe lattice, or Cayley tree, of n shells and \
