Cell[CellGroupData[{

Cell["Uniform-length graphs", "GuideFunctionsSubsection",ExpressionUUID->"41e574b2-bfcd-448d-af9d-99d8d1d9d20d"],

Cell[TextData[{
 StyleBox["UniformLengthGraph",
  FontWeight->"Bold"],
 " \[LongDash] the contact graph of a hard-sphere packing relaxed in a \
region, filling a solid or meshing a surface"
}], "GuideText",ExpressionUUID->"21f41512-ae1b-46a6-8c45-8431fc208d20"],

Cell[TextData[{
 StyleBox["UniformLengthEmbedding",
  FontWeight->"Bold"],
 " \[LongDash] embeds a graph in R^d so that every edge is a unit segment"
}], "GuideText",ExpressionUUID->"411e141d-8785-4a45-8809-4ea4796439ef"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Other example graphs", "GuideFunctionsSubsection",ExpressionUUID->"acf1523a-460e-47be-b726-5e3427e7286f"],

Cell[TextData[{
 StyleBox["SierpinskiGraph",
  FontWeight->"Bold"],
