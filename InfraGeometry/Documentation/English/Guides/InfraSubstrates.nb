}, Open  ]],

Cell[CellGroupData[{

Cell["Surface-like graphs", "GuideFunctionsSubsection",ExpressionUUID->"b2ef68d1-1c0a-4a3a-8a77-f488753a2326"],

Cell[TextData[{
 StyleBox["TessellationCurvature",
  FontWeight->"Bold"],
