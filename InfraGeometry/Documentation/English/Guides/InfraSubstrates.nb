}], "GuideText",ExpressionUUID->"27108c8f-d29a-467d-80b0-f72c58437434"],

Cell[TextData[{
 StyleBox["BranchingSequenceTree",
  FontWeight->"Bold"],
 " \[LongDash] the spherically symmetric rooted tree whose offspring count \
depends only on depth"
}], "GuideText",ExpressionUUID->"6e803ce3-b7da-4a74-98e5-007658aefa65"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Surface-like graphs", "GuideFunctionsSubsection",ExpressionUUID->"34ecae86-b95f-4a59-a0d0-1574f2b160c5"],

Cell[TextData[{
 StyleBox["TessellationCurvature",
  FontWeight->"Bold"],
 " \[LongDash] the combinatorial Gaussian curvature at a vertex of a regular \
or uniform map; its sign says spherical, flat or hyperbolic"
}], "GuideText",ExpressionUUID->"fd38017c-e858-4e64-b338-a72405ec5360"],

Cell[TextData[{
 StyleBox["TessellationEulerCharacteristic",
  FontWeight->"Bold"],
 " \[LongDash] the Euler characteristic V - E + F of a tessellation graph"
}], "GuideText",ExpressionUUID->"9ea43661-dbcf-4b1a-8ec1-2daa15e9f9f2"],

Cell[TextData[{
 StyleBox["TessellationGenus",
  FontWeight->"Bold"],
 " \[LongDash] the orientable genus of a tessellation graph, from its Euler \
characteristic"
}], "GuideText",ExpressionUUID->"9c277edd-e3a5-441a-88ec-a3a499245654"],

Cell["\<\
waits: a test whether a graph is surface-like at a scale, its metric balls \
discs and its metric shells cycles\
\>", "GuideText",ExpressionUUID->"4b647398-fab5-4fc8-adf1-72d4332afce8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Preparing a substrate", "GuideFunctionsSubsection",ExpressionUUID->"0cc41313-6564-4aa6-8888-9f78aff5bdaa"],

Cell[TextData[{
 StyleBox["CenterGraph",
  FontWeight->"Bold"],
 " \[LongDash] the substrate cut to a fraction q of the way out from its \
