Cell[CellGroupData[{

Cell["Uniform-length graphs", "GuideFunctionsSubsection",ExpressionUUID->"e11a3ddb-09b4-404f-b976-9e230344d525"],

Cell[TextData[{
 StyleBox["UniformLengthGraph",
  FontWeight->"Bold"],
 " \[LongDash] the contact graph of a hard-sphere packing relaxed in a \
region, filling a solid or meshing a surface"
}], "GuideText",ExpressionUUID->"ddf9c844-8a77-4479-a032-d7e06b6bf59b"],

Cell[TextData[{
 StyleBox["UniformLengthEmbedding",
  FontWeight->"Bold"],
 " \[LongDash] embeds a graph in R^d so that every edge is a unit segment"
}], "GuideText",ExpressionUUID->"83e4b369-de34-4fb0-9111-946bb98c3cc6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Other example graphs", "GuideFunctionsSubsection",ExpressionUUID->"d7cd0f80-f0d5-4a9b-bdc7-850044ba0437"],

Cell[TextData[{
 StyleBox["SierpinskiGraph",
