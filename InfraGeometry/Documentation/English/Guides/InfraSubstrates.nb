Cell[CellGroupData[{

Cell["Uniform-length graphs", "GuideFunctionsSubsection",ExpressionUUID->"7388d70f-d491-4a83-a3d1-335311e73073"],

Cell[TextData[{
 StyleBox["UniformLengthGraph",
  FontWeight->"Bold"],
 " \[LongDash] the contact graph of a hard-sphere packing relaxed in a \
