Cell[CellGroupData[{

Cell["Uniform-length graphs", "GuideFunctionsSubsection",ExpressionUUID->"9d1e92eb-c506-4542-b35f-07bf1b887c65"],

Cell[TextData[{
 StyleBox["UniformLengthGraph",
  FontWeight->"Bold"],
 " \[LongDash] the contact graph of a hard-sphere packing relaxed in a \
region, filling a solid or meshing a surface"
}], "GuideText",ExpressionUUID->"025702b9-fdb1-445c-99c7-31e6e5af797e"],

Cell[TextData[{
 StyleBox["UniformLengthEmbedding",
  FontWeight->"Bold"],
 " \[LongDash] embeds a graph in R^d so that every edge is a unit segment"
}], "GuideText",ExpressionUUID->"1e0e6dc4-a3ec-405d-9871-bcb671ec8b24"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Other example graphs", "GuideFunctionsSubsection",ExpressionUUID->"72943794-4bdd-4bba-96e4-1238e6e08a86"],

Cell[TextData[{
 StyleBox["SierpinskiGraph",
