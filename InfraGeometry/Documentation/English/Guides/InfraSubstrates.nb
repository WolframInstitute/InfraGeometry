}], "GuideText",ExpressionUUID->"00924104-fdd8-42cc-aeef-98bc66fd6908"],

Cell[TextData[{
 StyleBox["BoundarylessGraph",
  FontWeight->"Bold"],
 " \[LongDash] deletes every edge joining two rim vertices and then the \
vertices this isolates, an open window onto the geometry"
}], "GuideText",ExpressionUUID->"5639e680-b13a-4ba3-a614-863896dbef0b"],

Cell[TextData[{
 StyleBox["GraphExteriorBoundary",
  FontWeight->"Bold"],
 " \[LongDash] the rim vertices of the whole graph, detected from vertex \
degrees"
}], "GuideText",ExpressionUUID->"5facc959-4549-43e6-a78c-a5b18a715f31"]
}, Open  ]],

Cell[CellGroupData[{

