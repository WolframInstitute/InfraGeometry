Cell["Covering a region", "Section",ExpressionUUID->"1c789b37-c2b3-454e-a226-b993be5c2475"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["N", "TI"], 
    StyleBox["r", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad95a766-e2d6-4898-be16-cbd199381f00"],
 " be the least number of closed balls of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78995893-dc04-4133-bfe7-618646ade7b5"],
 " covering the target vertices ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae676ac0-3b1a-4bd2-861d-017dc7a8c5ad"],
 ". Their centres may be anywhere in the graph."
}], "Item",ExpressionUUID->"9bb6c615-96ec-4aa4-bdef-dfb97e2b6c43"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindBallCover"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindBallCover", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8451c8f3-a822-4db0-9cb8-9c8b2c2d779d"],
 " gives the centres. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallCoverNumber"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallCoverNumber", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "95fb11c2-4afb-4970-8758-d5d29abb0295"],
 " gives their number. The default method finds a smallest cover; the greedy \
method gives an upper bound."
}], "Item",ExpressionUUID->"ba467963-2757-4158-a3d5-b8225e4cb9c0"],

Cell["\<\
We first find an exact cover on a small square tiling. The target is gray and \
each covering ball has its own colour.\
\>", "Item",ExpressionUUID->"d4f54e1e-0d21-4a30-8adf-7c14f7965c99"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "2", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", " ", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"target", " ", "=", " ", 
      RowBox[{"FindInfraRepresentative", "[", " ", 
       RowBox[{"graph", ",", " ", 
        RowBox[{"InfraBall", "[", " ", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", " ", "graph", " ", "]"}]}], ",", " ", 
          "4"}], " ", "]"}]}], " ", "]"}]}], ",", " ", 
     RowBox[{"radius", " ", "=", " ", "2"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"centres", " ", "=", " ", 
     RowBox[{"FindBallCover", "[", " ", 
      RowBox[{"graph", ",", " ", "radius", ",", " ", "target"}], " ", "]"}]}],
     " ", "}"}], ",", "\n", "  ", 
   RowBox[{"Column", "[", " ", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", " ", 
       RowBox[{"graph", ",", " ", 
        RowBox[{"Join", "[", " ", 
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{"target", " ", "->", " ", "StandardGray"}], " ", "}"}], ",",
           "\n", "      ", 
          RowBox[{"MapIndexed", "[", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"{", " ", 
              RowBox[{"centre", ",", " ", "index"}], " ", "}"}], " ", "|->", 
             " ", 
             RowBox[{
              RowBox[{"InfraBall", "[", " ", 
               RowBox[{"centre", ",", " ", "radius"}], " ", "]"}], " ", "->", 
              " ", 
              RowBox[{
               RowBox[{"ColorData", "[", " ", "97", " ", "]"}], "[", " ", 
               RowBox[{"First", "[", " ", "index", " ", "]"}], " ", "]"}]}]}],
             ",", " ", "centres"}], " ", "]"}], ",", "\n", "      ", 
          RowBox[{"{", " ", 
           RowBox[{"centres", " ", "->", " ", "StandardRed"}], " ", "}"}]}], 
         " ", "]"}]}], " ", "]"}], ",", "\n", "    ", 
      RowBox[{"<|", " ", 
       RowBox[{
        RowBox[{"\"\<Radius\>\"", " ", "->", " ", "radius"}], ",", " ", 
        RowBox[{"\"\<Exact count\>\"", " ", "->", " ", 
         RowBox[{"BallCoverNumber", "[", " ", 
          RowBox[{"graph", ",", " ", "radius", ",", " ", "target"}], " ", 
          "]"}]}], ",", "\n", "      ", 
        RowBox[{"\"\<Covers target\>\"", " ", "->", " ", 
         RowBox[{"BallCoverQ", "[", " ", 
          RowBox[{
          "graph", ",", " ", "radius", ",", " ", "centres", ",", " ", 
           "target"}], " ", "]"}]}]}], " ", "|>"}]}], " ", "}"}], " ", 
    "]"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"3bfb615e-fdac-409a-a8ae-5c27865b009f"],

