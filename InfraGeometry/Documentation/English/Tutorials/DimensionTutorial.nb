                "data", "[", " ", "\"\<GrowthRadii\>\"", " ", "]"}]}]}], " ", 
              "}"}], ",", " ", 
             RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}]}], " ", "]"}]}], 
          " ", "]"}]}], " ", "}"}]}], " ", "]"}]}], ",", "\n", "  ", 
    "dimensionProfiles"}], " ", "]"}], " ", "]"}]], "Input",
