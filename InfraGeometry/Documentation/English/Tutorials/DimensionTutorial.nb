Cell["\<\
The normalized profiles against a horizontal target line: the box count \
multiplied by the shifted radius to the reference dimension, and the growth \
counts divided by the radius to that dimension. A flat profile supports the \
reference exponent over that window.\
\>", "Text",ExpressionUUID->"2a54d20b-03e6-45ea-b3d8-87ca465859ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", " ", 
  RowBox[{"Map", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"data", " ", "|->", " ", 
     RowBox[{"With", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"box", " ", "=", " ", 
          RowBox[{
           RowBox[{"data", "[", " ", "\"\<BoxCounts\>\"", " ", "]"}], " ", 
           RowBox[{
            RowBox[{"(", " ", 
             RowBox[{
              RowBox[{"data", "[", " ", "\"\<BoxRadii\>\"", " ", "]"}], " ", "+",
               " ", 
              RowBox[{"1", "/", "2"}]}], " ", ")"}], " ", "^", " ", 
            RowBox[{"data", "[", " ", "\"\<Reference\>\"", " ", "]"}]}]}]}], ",",
          "\n", "      ", 
         RowBox[{"growth", " ", "=", " ", 
          RowBox[{
           RowBox[{"data", "[", " ", "\"\<GrowthCounts\>\"", " ", "]"}], " ", 
           "/", " ", 
           RowBox[{
            RowBox[{"data", "[", " ", "\"\<GrowthRadii\>\"", " ", "]"}], " ", 
            "^", " ", 
            RowBox[{"data", "[", " ", "\"\<Reference\>\"", " ", "]"}]}]}]}], ",",
          "\n", "      ", 
         RowBox[{"volume", " ", "=", " ", 
          RowBox[{
           RowBox[{"data", "[", " ", "\"\<Volumes\>\"", " ", "]"}], " ", "/", 
           " ", 
           RowBox[{
            RowBox[{"data", "[", " ", "\"\<GrowthRadii\>\"", " ", "]"}], " ", 
            "^", " ", 
            RowBox[{"data", "[", " ", "\"\<Reference\>\"", " ", "]"}]}]}]}]}],
         " ", "}"}], ",", "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"Show", "[", "\n", "        ", 
          RowBox[{
           RowBox[{"ListPlot", "[", " ", 
            RowBox[{
             RowBox[{"Transpose", "[", " ", 
              RowBox[{"{", " ", 
               RowBox[{
                RowBox[{"data", "[", " ", "\"\<BoxRadii\>\"", " ", "]"}], ",",
                 " ", 
                RowBox[{"box", " ", "/", " ", 
                 RowBox[{"First", "[", " ", "box", " ", "]"}]}]}], " ", "}"}],
               " ", "]"}], ",", " ", 
             RowBox[{"Joined", " ", "->", " ", "True"}], ",", "\n", 
             "          ", 
             RowBox[{"PlotLabel", " ", "->", " ", 
              RowBox[{"data", "[", " ", "\"\<Name\>\"", " ", "]"}]}], ",", 
             " ", 
             RowBox[{"AxesLabel", " ", "->", " ", 
              RowBox[{"{", " ", 
               RowBox[{"\"\<r\>\"", ",", " ", "\"\<normalized box\>\""}], " ",
                "}"}]}], ",", " ", 
             RowBox[{"PlotRange", " ", "->", " ", "All"}]}], " ", "]"}], ",", 
           "\n", "        ", 
           RowBox[{"Plot", "[", " ", 
            RowBox[{"1", ",", " ", 
             RowBox[{"{", " ", 
              RowBox[{"r", ",", " ", 
               RowBox[{"First", " ", "@", " ", 
                RowBox[{"data", "[", " ", "\"\<BoxRadii\>\"", " ", "]"}]}], ",",
                " ", 
               RowBox[{"Last", " ", "@", " ", 
                RowBox[{"data", "[", " ", "\"\<BoxRadii\>\"", " ", "]"}]}]}], 
              " ", "}"}], ",", " ", 
