Cell["The span in a cube mesh", "Section",ExpressionUUID->"163e4748-4f76-4f1c-b3f8-79d8115cbb92"],

Cell["\<\
The four pictures show nested hulls of two through five points at separation \
four. The third direction can open when a fourth point is added. The large \
roster mesh is too coarse for a useful three-dimensional exponent window, so \
these are pictures of spans rather than a dimension fit.\
\>", "Text",ExpressionUUID->"6e7a1f2d-6c4a-4b14-8b75-dfa09c585d05"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "2", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"InfraSubstrate", "[", " ", 
       RowBox[{"\"\<CubeMeshGraph\>\"", ",", " ", "\"\<Large\>\"", ",", " ", 
        RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}], ",", 
        "\n", "      ", 
        RowBox[{"EdgeStyle", " ", "->", " ", 
         RowBox[{"Directive", "[", " ", 
          RowBox[{"StandardGray", ",", " ", 
           RowBox[{"Opacity", "[", " ", "0.08", " ", "]"}]}], " ", "]"}]}], ",",
         " ", 
        RowBox[{"VertexStyle", " ", "->", " ", 
         RowBox[{"Directive", "[", " ", 
          RowBox[{"StandardGray", ",", " ", 
           RowBox[{"Opacity", "[", " ", "0.08", " ", "]"}]}], " ", "]"}]}]}], 
       " ", "]"}]}], ",", " ", 
     RowBox[{"spread", " ", "=", " ", "4"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"vertices", " ", "=", " ", 
      RowBox[{"VertexList", "[", " ", "graph", " ", "]"}]}], ",", " ", 
     RowBox[{"distances", " ", "=", " ", 
      RowBox[{"GraphDistanceMatrix", "[", " ", "graph", " ", "]"}]}], ",", 
     " ", 
     RowBox[{"centre", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"GraphCenter", "[", " ", "graph", " ", "]"}]}]}]}], " ", "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"endpoint", " ", "=", " ", 
     RowBox[{"Last", " ", "@", " ", 
      RowBox[{"MaximalBy", "[", " ", 
       RowBox[{"vertices", ",", " ", 
        RowBox[{"v", " ", "|->", " ", 
         RowBox[{"GraphDistance", "[", " ", 
          RowBox[{"graph", ",", " ", "centre", ",", " ", "v"}], " ", 
          "]"}]}]}], " ", "]"}]}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"path", " ", "=", " ", 
     RowBox[{"FindShortestPath", "[", " ", 
      RowBox[{"graph", ",", " ", "centre", ",", " ", "endpoint"}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"pair", " ", "=", " ", 
     RowBox[{"Map", "[", " ", 
      RowBox[{
       RowBox[{"v", " ", "|->", " ", 
        RowBox[{"VertexIndex", "[", " ", 
         RowBox[{"graph", ",", " ", "v"}], " ", "]"}]}], ",", " ", 
       RowBox[{"path", "[", 
        RowBox[{"[", " ", 
         RowBox[{"{", " ", 
          RowBox[{"1", ",", " ", 
           RowBox[{"spread", " ", "+", " ", "1"}]}], " ", "}"}], " ", "]"}], 
        "]"}]}], " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"indices", " ", "=", " ", 
     RowBox[{"Nest", "[", " ", 
      RowBox[{
       RowBox[{"chosen", " ", "|->", " ", 
        RowBox[{"Append", "[", " ", 
         RowBox[{"chosen", ",", "\n", "      ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Ordering", "[", " ", 
            RowBox[{
             RowBox[{"Total", "[", " ", 
              RowBox[{"Abs", "[", " ", 
               RowBox[{
                RowBox[{"distances", "[", 
                 RowBox[{"[", " ", "chosen", " ", "]"}], "]"}], " ", "-", " ",
                 "spread"}], " ", "]"}], " ", "]"}], ",", " ", "1"}], " ", 
            "]"}]}]}], " ", "]"}]}], ",", " ", "pair", ",", " ", "3"}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"seeds", " ", "=", " ", 
     RowBox[{"vertices", "[", 
      RowBox[{"[", " ", "indices", " ", "]"}], "]"}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", " ", 
    RowBox[{"hulls", " ", "=", " ", 
     RowBox[{"Table", "[", " ", 
      RowBox[{
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", " ", 
         RowBox[{"graph", ",", " ", 
          RowBox[{"InfraBallHull", "[", " ", 
           RowBox[{"Take", "[", " ", 
            RowBox[{"seeds", ",", " ", "k"}], " ", "]"}], " ", "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], " ", "]"}]}], ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"k", ",", " ", "2", ",", " ", "5"}], " ", "}"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"Column", "[", " ", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"GraphicsGrid", "[", " ", 
       RowBox[{"Partition", "[", " ", 
        RowBox[{
         RowBox[{"Table", "[", " ", 
          RowBox[{
           RowBox[{"Labeled", "[", " ", 
            RowBox[{
             RowBox[{"InfraSubstrateHighlight", "[", " ", 
              RowBox[{"graph", ",", "\n", "      ", 
               RowBox[{"{", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Complement", "[", " ", 
                   RowBox[{
                    RowBox[{"hulls", "[", 
                    RowBox[{"[", " ", 
                    RowBox[{"k", " ", "-", " ", "1"}], " ", "]"}], "]"}], ",",
                     " ", 
                    RowBox[{"Take", "[", " ", 
                    RowBox[{"seeds", ",", " ", "k"}], " ", "]"}]}], " ", 
                   "]"}], " ", "->", " ", "StandardBlue"}], ",", "\n", 
                 "        ", 
                 RowBox[{
                  RowBox[{"Take", "[", " ", 
                   RowBox[{"seeds", ",", " ", "k"}], " ", "]"}], " ", "->", 
                  " ", 
                  RowBox[{"{", " ", 
                   RowBox[{"StandardRed", ",", " ", 
                    RowBox[{"AbsolutePointSize", "[", " ", "7", " ", "]"}]}], 
                   " ", "}"}]}]}], " ", "}"}], ",", "\n", "      ", 
               RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "4"}]}], " ",
               "]"}], ",", "\n", "      ", 
             RowBox[{"Row", "[", " ", 
              RowBox[{"{", " ", 
               RowBox[{
               "k", ",", " ", "\"\< points, L = \>\"", ",", " ", "spread"}], 
               " ", "}"}], " ", "]"}]}], " ", "]"}], ",", " ", 
           RowBox[{"{", " ", 
            RowBox[{"k", ",", " ", "2", ",", " ", "5"}], " ", "}"}]}], " ", 
          "]"}], ",", " ", "2"}], " ", "]"}], " ", "]"}], ",", "\n", "    ", 
      RowBox[{"Grid", "[", " ", 
       RowBox[{
        RowBox[{"Prepend", "[", " ", 
         RowBox[{
          RowBox[{"Transpose", "[", " ", 
           RowBox[{"{", " ", 
            RowBox[{
             RowBox[{"Range", "[", " ", 
              RowBox[{"2", ",", " ", "5"}], " ", "]"}], ",", " ", 
             RowBox[{"Length", " ", "/@", " ", "hulls"}]}], " ", "}"}], " ", 
           "]"}], ",", " ", 
          RowBox[{"{", " ", 
           RowBox[{"\"\<Points\>\"", ",", " ", "\"\<Hull vertices\>\""}], " ",
            "}"}]}], " ", "]"}], ",", " ", 
        RowBox[{"Frame", " ", "->", " ", "All"}]}], " ", "]"}]}], " ", "}"}], 
    " ", "]"}]}], " ", "]"}]}], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"6615bcf5-6806-443f-aeb5-a7c0c2933622"],

