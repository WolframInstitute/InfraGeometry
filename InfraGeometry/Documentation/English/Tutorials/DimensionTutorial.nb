Notebook[{

Cell[CellGroupData[{
Cell["Dimension", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell["\<\
Dimension describes how a region grows when its scale grows. We read it from \
vertex volumes and ball covers.\
\>", "Item",ExpressionUUID->"1fe81f59-e9d9-4367-a92e-d4537fe9ee64"],

Cell["\<\
The graph distance supplies the scale. The drawing supplies no measurement.\
\>", "Item",ExpressionUUID->"df36e912-f6a8-4f5d-923f-8ed289261d12"],

Cell["\<\
These are readings over finite windows. The lattice scale, the boundary and \
the shape of the balls can bias them.\
\>", "Item",ExpressionUUID->"6e8b9774-3b83-486b-a5b1-4dcd5798662a"],

Cell["Setup", "Section",ExpressionUUID->"4dfe5fbd-1c2b-4e92-ab1c-15c67881e616"],

Cell[BoxData[
 RowBox[{"Needs", "[", " ", "\"\<WolframInstitute`InfraGeometry`\>\"", " ", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"64320d94-caac-45de-9922-42e2b87c8183"],

Cell["\<\
The plane mesh, square tiling and Sierpinski triangle use the large roster \
size; the Menger carpet uses medium. The reference dimensions of the fractals \
come from their self-similar pieces and scale factors. The carpet is planar; \
its reference is not the dimension of the Menger sponge.\
\>", "Text",ExpressionUUID->"35e43b00-e139-4645-844c-9bcb6d91215f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "2", " ", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dimensionSubstrates", " ", "=", " ", 
   RowBox[{"Apply", "[", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"{", " ", 
       RowBox[{"name", ",", " ", "size", ",", " ", "reference"}], " ", "}"}], 
      " ", "|->", " ", 
      RowBox[{"With", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{"graph", " ", "=", " ", 
          RowBox[{"InfraSubstrate", "[", " ", 
           RowBox[{"name", ",", " ", "size", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           " ", "]"}]}], " ", "}"}], ",", "\n", "    ", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"centre", " ", "=", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"GraphCenter", "[", " ", "graph", " ", "]"}]}]}], ",", 
          " ", 
          RowBox[{"radius", " ", "=", " ", 
           RowBox[{"Floor", "[", " ", 
            RowBox[{"4", " ", 
             RowBox[{
              RowBox[{"GraphRadius", "[", " ", "graph", " ", "]"}], " ", "/", 
              " ", "5"}]}], " ", "]"}]}]}], " ", "}"}], ",", "\n", "    ", 
        RowBox[{"<|", " ", 
         RowBox[{
          RowBox[{"\"\<Name\>\"", " ", "->", " ", "name"}], ",", " ", 
          RowBox[{"\"\<Graph\>\"", " ", "->", " ", "graph"}], ",", " ", 
          RowBox[{"\"\<Centre\>\"", " ", "->", " ", "centre"}], ",", " ", 
          RowBox[{"\"\<Radius\>\"", " ", "->", " ", "radius"}], ",", "\n", 
          "      ", 
          RowBox[{"\"\<Reference\>\"", " ", "->", " ", "reference"}]}], " ", 
         "|>"}]}], " ", "]"}]}], ",", "\n", "  ", 
     RowBox[{"{", " ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\"", ",", 
         " ", "2"}], " ", "}"}], ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Large\>\"", ",", 
         " ", "2"}], " ", "}"}], ",", "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{"\"\<SierpinskiTriangleGraph\>\"", ",", " ", "\"\<Large\>\"", 
         ",", " ", 
         RowBox[{
          RowBox[{"Log", "[", " ", "3", " ", "]"}], " ", "/", " ", 
          RowBox[{"Log", "[", " ", "2", " ", "]"}]}]}], " ", "}"}], ",", "\n",
        "    ", 
       RowBox[{"{", " ", 
        RowBox[{"\"\<MengerCarpetGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
         " ", 
         RowBox[{
          RowBox[{"Log", "[", " ", "8", " ", "]"}], " ", "/", " ", 
          RowBox[{"Log", "[", " ", "3", " ", "]"}]}]}], " ", "}"}]}], " ", 
      "}"}], ",", " ", 
     RowBox[{"{", " ", "1", " ", "}"}]}], " ", "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsGrid", "[", " ", 
  RowBox[{"Partition", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Map", "[", " ", 
     RowBox[{
      RowBox[{"data", " ", "|->", " ", 
       RowBox[{"Labeled", "[", " ", 
        RowBox[{
         RowBox[{"data", "[", " ", "\"\<Graph\>\"", " ", "]"}], ",", " ", 
         RowBox[{"data", "[", " ", "\"\<Name\>\"", " ", "]"}]}], " ", "]"}]}],
       ",", " ", "dimensionSubstrates"}], " ", "]"}], ",", " ", "2"}], " ", 
   "]"}], " ", "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0321b21d-265c-49ec-bd7c-7995b815a24a"],

