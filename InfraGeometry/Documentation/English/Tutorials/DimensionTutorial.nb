Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "2", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"data", " ", "=", " ", 
     RowBox[{"Last", "[", " ", "planeSpans", " ", "]"}]}], " ", "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"data", "[", " ", "\"\<Graph\>\"", " ", "]"}]}], ",", " ", 
     RowBox[{"pair", " ", "=", " ", 
      RowBox[{"Take", "[", " ", 
       RowBox[{
        RowBox[{"data", "[", " ", "\"\<Seeds\>\"", " ", "]"}], ",", " ", 
        "2"}], " ", "]"}]}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"enclosingRadius", " ", "=", " ", 
     RowBox[{"Min", "[", " ", 
      RowBox[{"Max", " ", "/@", " ", 
       RowBox[{"Transpose", "[", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", " ", 
           RowBox[{"graph", ",", " ", "#"}], " ", "]"}], " ", "&"}], " ", "/@",
          " ", "pair"}], " ", "]"}]}], " ", "]"}]}], " ", "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", " ", 
    RowBox[{"bounds", " ", "=", " ", 
     RowBox[{"DeleteDuplicates", "[", " ", 
      RowBox[{"{", " ", 
       RowBox[{"enclosingRadius", ",", " ", 
        RowBox[{"enclosingRadius", " ", "+", " ", "1"}], ",", " ", 
        RowBox[{"enclosingRadius", " ", "+", " ", "2"}], ",", "\n", "      ", 
        
        RowBox[{"data", "[", " ", "\"\<Spread\>\"", " ", "]"}], ",", " ", 
        "Infinity"}], " ", "}"}], " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"hulls", " ", "=", " ", 
     RowBox[{"Map", "[", " ", 
      RowBox[{
       RowBox[{"bound", " ", "|->", " ", 
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", " ", 
          RowBox[{"graph", ",", " ", 
           RowBox[{"InfraBallHull", "[", " ", 
            RowBox[{"pair", ",", " ", "bound"}], " ", "]"}], ",", 
           " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], ",", " ", 
       "bounds"}], " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"Column", "[", " ", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", " ", 
       RowBox[{"MapThread", "[", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{"bound", ",", " ", "hull"}], " ", "}"}], " ", "|->", " ", 
          RowBox[{"Labeled", "[", "\n", "      ", 
           RowBox[{
            RowBox[{"InfraSubstrateHighlight", "[", " ", 
             RowBox[{"graph", ",", "\n", "        ", 
              RowBox[{"{", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"Complement", "[", " ", 
                  RowBox[{"hull", ",", " ", "pair"}], " ", "]"}], " ", "->", 
                 " ", "StandardBlue"}], ",", " ", 
                RowBox[{"pair", " ", "->", " ", 
                 RowBox[{"{", " ", 
                  RowBox[{"StandardRed", ",", " ", 
                   RowBox[{"AbsolutePointSize", "[", " ", "7", " ", "]"}]}], 
                  " ", "}"}]}]}], " ", "}"}]}], " ", "]"}], ",", "\n", 
            "      ", 
            RowBox[{"Row", "[", " ", 
             RowBox[{"{", " ", 
              RowBox[{"\"\<radius bound \>\"", ",", " ", "bound"}], " ", 
              "}"}], " ", "]"}]}], " ", "]"}]}], ",", " ", 
         RowBox[{"{", " ", 
          RowBox[{"bounds", ",", " ", "hulls"}], " ", "}"}]}], " ", "]"}], 
       " ", "]"}], ",", "\n", "    ", 
      RowBox[{"Grid", "[", " ", 
       RowBox[{
        RowBox[{"Prepend", "[", " ", 
         RowBox[{
          RowBox[{"Transpose", "[", " ", 
           RowBox[{"{", " ", 
            RowBox[{"bounds", ",", " ", 
             RowBox[{"Length", " ", "/@", " ", "hulls"}]}], " ", "}"}], " ", 
           "]"}], ",", " ", 
          RowBox[{"{", " ", 
           
           RowBox[{"\"\<Radius bound\>\"", ",", 
            " ", "\"\<Hull vertices\>\""}], " ", "}"}]}], " ", "]"}], ",", 
        " ", 
        RowBox[{"Frame", " ", "->", " ", "All"}]}], " ", "]"}], ",", "\n", 
      "    ", 
      RowBox[{"<|", " ", 
       RowBox[{
        RowBox[{"\"\<Nested\>\"", " ", "->", " ", 
         RowBox[{"And", " ", "@@", " ", 
          RowBox[{"MapThread", "[", " ", 
           RowBox[{"SubsetQ", ",", " ", 
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{"Most", "[", " ", "hulls", " ", "]"}], ",", " ", 
              RowBox[{"Rest", "[", " ", "hulls", " ", "]"}]}], " ", "}"}]}], 
           " ", "]"}]}]}], ",", "\n", "      ", 
        RowBox[{"\"\<Final hull is unrestricted\>\"", " ", "->", " ", 
         RowBox[{"(", " ", 
          RowBox[{
           RowBox[{"Last", "[", " ", "hulls", " ", "]"}], " ", "===", " ", 
           RowBox[{"Keys", " ", "@", " ", 
            RowBox[{"InfraMeasurement", "[", " ", 
             RowBox[{"graph", ",", " ", 
              RowBox[{"InfraBallHull", "[", " ", "pair", " ", "]"}], ",", 
              " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], " ", ")"}]}]}], 
       " ", "|>"}]}], " ", "}"}], " ", "]"}]}], " ", "]"}]}], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"6b075e9d-68f1-4690-b404-6afab02814f6"],

