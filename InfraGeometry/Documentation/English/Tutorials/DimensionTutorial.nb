Cell["Two covering slopes", "Section",ExpressionUUID->"7ed5704b-76fb-40c6-899f-9511c86df468"],

Cell[TextData[{
 StyleBox["Box reading.",
  FontWeight->"Bold"],
 " Fix ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], "=", 
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["\[Rho]", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["c", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69115334-ad85-48d3-80bb-ac62a1303cfb"],
 " and vary the covering radius. A ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc4df607-2908-4cac-8a62-d0d35f3b25ba"],
 "-dimensional region needs approximately ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["r", "TI"], 
   RowBox[{"-", 
    StyleBox["d", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f83de569-a301-47ef-891f-619c7f479e21"],
 " balls."
}], "Item",ExpressionUUID->"72e30d0d-89e5-4025-8b5c-ccd300fb42d8"],

Cell[TextData[{
 "On a lattice a ball volume is a polynomial in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "+", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5acd31c2-3a8f-470a-b13b-1480a39a2617"],
 ". We use this shifted radius for the box slope. Using ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eebcb101-26a9-45db-a6ea-71091c84fa94"],
 " at these small radii gives a lower reading."
}], "Item",ExpressionUUID->"3d9accf3-247a-4f08-8eba-5b32d2c08d30"],

Cell[TextData[{
 StyleBox["Growth at a fixed resolution.",
  FontWeight->"Bold"],
 " Fix the covering radius and grow ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["s", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["c", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a22e3e9c-a200-4481-9686-ebcd3edb66e9"],
 ". Its covering count is the volume measured in balls of that radius. At \
radius zero this is exactly the vertex count."
}], "Item",ExpressionUUID->"fe8a0975-aeca-44ad-bebb-2afdf89b8529"],

Cell["\<\
We fit one least-squares slope over each window. Successive quotients of \
integer covering counts jump and can vanish on plateaux.\
\>", "Item",ExpressionUUID->"1fc23fbf-5d4a-488e-8def-04d0117ad080"],

Cell["\<\
The profiles below are computed with greedy covers. The box window ends at \
half the target radius; the growth window starts beyond the first few layers. \
The vertex-volume slope uses exactly the growth window.\
\>", "Text",ExpressionUUID->"d31854d6-70d7-4c7b-8740-56ad17c642ff"],

Cell[BoxData[
 RowBox[{
  RowBox[{"logSlope", "[", " ", 
   RowBox[{"scales_", ",", " ", "counts_"}], " ", "]"}], " ", ":=", "\n", 
  "  ", 
  RowBox[{"Coefficient", "[", " ", 
   RowBox[{
    RowBox[{"Fit", "[", " ", 
     RowBox[{
      RowBox[{"Transpose", "[", " ", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"Log", "[", " ", 
          RowBox[{"N", "[", " ", "scales", " ", "]"}], " ", "]"}], ",", " ", 
         RowBox[{"Log", "[", " ", 
          RowBox[{"N", "[", " ", "counts", " ", "]"}], " ", "]"}]}], " ", 
        "}"}], " ", "]"}], ",", " ", 
      RowBox[{"{", " ", 
       RowBox[{"1", ",", " ", "x"}], " ", "}"}], ",", " ", "x"}], " ", "]"}], 
    ",", " ", "x"}], " ", "]"}]}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"2444e0ae-179e-4604-91b7-b3c229e328a9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "2", " ", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dimensionProfiles", " ", "=", " ", 
   RowBox[{"Map", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"data", " ", "|->", " ", 
      RowBox[{"With", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"graph", " ", "=", " ", 
           RowBox[{"data", "[", " ", "\"\<Graph\>\"", " ", "]"}]}], ",", " ", 
          
          RowBox[{"centre", " ", "=", " ", 
           RowBox[{"data", "[", " ", "\"\<Centre\>\"", " ", "]"}]}], ",", " ", 
          RowBox[{"radius", " ", "=", " ", 
           RowBox[{"data", "[", " ", "\"\<Radius\>\"", " ", "]"}]}]}], " ", 
         "}"}], ",", "\n", "    ", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"boxRadii", " ", "=", " ", 
           RowBox[{"Range", "[", " ", 
            RowBox[{"Floor", "[", " ", 
             RowBox[{"radius", " ", "/", " ", "2"}], " ", "]"}], " ", "]"}]}],
           ",", " ", 
          RowBox[{"growthRadii", " ", "=", " ", 
           RowBox[{"Range", "[", " ", 
            RowBox[{"3", ",", " ", "radius"}], " ", "]"}]}], ",", "\n", 
          "      ", 
          RowBox[{"target", " ", "=", " ", 
           RowBox[{"FindInfraRepresentative", "[", " ", 
            RowBox[{"graph", ",", " ", 
             RowBox[{"InfraBall", "[", " ", 
              RowBox[{"centre", ",", " ", "radius"}], " ", "]"}]}], " ", 
            "]"}]}]}], " ", "}"}], ",", "\n", "    ", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"boxCounts", " ", "=", " ", 
           RowBox[{"Map", "[", " ", 
            RowBox[{
             RowBox[{"r", " ", "|->", " ", 
              RowBox[{"BallCoverNumber", "[", " ", 
               RowBox[{"graph", ",", " ", "r", ",", " ", "target", ",", " ", 
                RowBox[{"Method", " ", "->", " ", "\"\<Greedy\>\""}]}], " ", 
               "]"}]}], ",", " ", "boxRadii"}], " ", "]"}]}], ",", "\n", 
          "      ", 
          RowBox[{"growthCounts", " ", "=", " ", 
           RowBox[{"Map", "[", " ", 
            RowBox[{
             RowBox[{"s", " ", "|->", " ", 
              RowBox[{"BallCoverNumber", "[", " ", 
               RowBox[{"graph", ",", " ", "1", ",", "\n", "        ", 
                RowBox[{"FindInfraRepresentative", "[", " ", 
                 RowBox[{"graph", ",", " ", 
                  RowBox[{"InfraBall", "[", " ", 
                   RowBox[{"centre", ",", " ", "s"}], " ", "]"}]}], " ", 
                 "]"}], ",", " ", 
                RowBox[{"Method", " ", "->", " ", "\"\<Greedy\>\""}]}], " ", 
               "]"}]}], ",", " ", "growthRadii"}], " ", "]"}]}], ",", "\n", 
          "      ", 
          RowBox[{"volumes", " ", "=", " ", 
           RowBox[{"Map", "[", " ", 
            RowBox[{
             RowBox[{"s", " ", "|->", " ", 
              RowBox[{"Length", " ", "@", " ", 
               RowBox[{"FindInfraRepresentative", "[", " ", 
                RowBox[{"graph", ",", " ", 
                 RowBox[{"InfraBall", "[", " ", 
                  RowBox[{"centre", ",", " ", "s"}], " ", "]"}]}], " ", 
                "]"}]}]}], ",", " ", "growthRadii"}], " ", "]"}]}]}], " ", 
         "}"}], ",", "\n", "    ", 
        RowBox[{"Join", "[", " ", 
         RowBox[{"data", ",", " ", 
          RowBox[{"<|", " ", 
           RowBox[{
            RowBox[{"\"\<BoxRadii\>\"", " ", "->", " ", "boxRadii"}], ",", 
            " ", 
            RowBox[{"\"\<BoxCounts\>\"", " ", "->", " ", "boxCounts"}], ",", 
            "\n", "      ", 
            RowBox[{"\"\<GrowthRadii\>\"", " ", "->", " ", "growthRadii"}], ",",
             " ", 
            RowBox[{"\"\<GrowthCounts\>\"", " ", "->", " ", "growthCounts"}], 
            ",", " ", 
            RowBox[{"\"\<Volumes\>\"", " ", "->", " ", "volumes"}], ",", "\n",
             "      ", 
            RowBox[{"\"\<Box\>\"", " ", "->", " ", 
             RowBox[{"-", 
              RowBox[{"logSlope", "[", " ", 
               RowBox[{
                RowBox[{"boxRadii", " ", "+", " ", 
                 RowBox[{"1", "/", "2"}]}], ",", " ", "boxCounts"}], " ", 
               "]"}]}]}], ",", " ", 
            RowBox[{"\"\<UnshiftedBox\>\"", " ", "->", " ", 
             RowBox[{"-", 
              RowBox[{"logSlope", "[", " ", 
               RowBox[{"boxRadii", ",", " ", "boxCounts"}], " ", "]"}]}]}], ",",
             "\n", "      ", 
            RowBox[{"\"\<Growth\>\"", " ", "->", " ", 
             RowBox[{"logSlope", "[", " ", 
              RowBox[{"growthRadii", ",", " ", "growthCounts"}], " ", "]"}]}],
             ",", " ", 
            RowBox[{"\"\<VertexVolume\>\"", " ", "->", " ", 
             RowBox[{"logSlope", "[", " ", 
              RowBox[{"growthRadii", ",", " ", "volumes"}], " ", "]"}]}]}], 
           " ", "|>"}]}], " ", "]"}]}], " ", "]"}]}], ",", "\n", "  ", 
     "dimensionSubstrates"}], " ", "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsGrid", "[", " ", 
  RowBox[{"Map", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"data", " ", "|->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"ListLogLogPlot", "[", " ", 
        RowBox[{
         RowBox[{"Transpose", "[", " ", 
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"data", "[", " ", "\"\<BoxRadii\>\"", " ", "]"}], " ", "+",
              " ", 
             RowBox[{"1", "/", "2"}]}], ",", " ", 
            RowBox[{"data", "[", " ", "\"\<BoxCounts\>\"", " ", "]"}]}], " ", 
           "}"}], " ", "]"}], ",", "\n", "      ", 
         RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"AxesLabel", " ", "->", " ", 
          RowBox[{"{", " ", 
           RowBox[{"\"\<r + 1/2\>\"", ",", " ", "\"\<cover count\>\""}], " ", 
           "}"}]}], ",", " ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"data", "[", " ", "\"\<Name\>\"", " ", "]"}]}]}], " ", 
        "]"}], ",", "\n", "    ", 
       RowBox[{"ListLogLogPlot", "[", " ", 
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{"Transpose", "[", " ", 
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{"data", "[", " ", "\"\<GrowthRadii\>\"", " ", "]"}], ",",
               " ", 
              RowBox[{"data", "[", " ", "\"\<GrowthCounts\>\"", " ", "]"}]}], 
             " ", "}"}], " ", "]"}], ",", "\n", "      ", 
           RowBox[{"Transpose", "[", " ", 
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{"data", "[", " ", "\"\<GrowthRadii\>\"", " ", "]"}], ",",
               " ", 
              RowBox[{"data", "[", " ", "\"\<Volumes\>\"", " ", "]"}]}], " ", 
             "}"}], " ", "]"}]}], " ", "}"}], ",", " ", 
         RowBox[{"Joined", " ", "->", " ", "True"}], ",", "\n", "      ", 
         RowBox[{"PlotLegends", " ", "->", " ", 
          RowBox[{"{", " ", 
           
           RowBox[{"\"\<radius-one cover\>\"", ",", 
            " ", "\"\<vertex volume\>\""}], " ", "}"}]}], ",", " ", 
         RowBox[{"AxesLabel", " ", "->", " ", 
          RowBox[{"{", " ", 
           RowBox[{"\"\<s\>\"", ",", " ", "\"\<count\>\""}], " ", "}"}]}]}], 
        " ", "]"}]}], " ", "}"}]}], ",", "\n", "  ", "dimensionProfiles"}], 
   " ", "]"}], " ", "]"}]}], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"a34d0b2b-caed-423a-b9da-5bbe036e46c3"],

