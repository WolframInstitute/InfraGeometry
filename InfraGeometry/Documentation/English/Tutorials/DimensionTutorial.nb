Cell["Covering a region", "Section",ExpressionUUID->"17e83b66-031b-45b2-806a-cdeb3abb9882"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["N", "TI"], 
    StyleBox["r", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "715b61b9-5e3e-4d88-bde5-79f611994763"],
 " be the least number of closed balls of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88193b2e-7e92-4ef2-acf0-2f66590f149f"],
 " covering the target vertices ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc66c4cd-3f42-4968-8e69-e13936b31395"],
 ". Their centres may be anywhere in the graph."
}], "Item",ExpressionUUID->"352e2329-2573-4a2f-bb45-904f1071ac1f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindBallCover"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindBallCover", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "171dba7c-9e64-4af4-a699-5fdcac3d2ccd"],
 " gives covering centres and minimizes their number by default. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallCoverNumber"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallCoverNumber", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "394773f3-60fe-43a5-a979-7db5f2224617"],
 " always gives the minimum. The length of a greedy cover gives an upper \
bound."
}], "Item",ExpressionUUID->"86302cd6-f301-4247-b488-b2a2c98acb5d"],

Cell["\<\
The target is read within the surrounding graph: centres may lie outside it, \
and shortest paths may leave it. Replacing the graph by the target's induced \
graph changes this question.\
\>", "Item",ExpressionUUID->"00a78866-6d54-45aa-8b72-a7c8eabfac30"],

Cell["\<\
We first find an exact cover on a small square tiling. The target is gray and \
each covering ball has its own colour.\
\>", "Item",ExpressionUUID->"4f9877b5-ea1b-4fcf-8ade-39a2daa641bb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "2", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", " ", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "\t", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"target", " ", "=", " ", 
      RowBox[{"InfraBall", "[", " ", 
       RowBox[{
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", " ", "graph", " ", "]"}]}], ",", " ", 
        "4"}], " ", "]"}]}], ",", " ", 
     RowBox[{"radius", " ", "=", " ", "2"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"centres", " ", "=", " ", 
     RowBox[{"FindBallCover", "[", " ", 
      RowBox[{"graph", ",", " ", "radius", ",", " ", "target"}], " ", "]"}]}],
     " ", "}"}], ",", "\n", "  ", 
   RowBox[{"Column", "[", " ", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", " ", 
       RowBox[{"graph", ",", " ", 
        RowBox[{"Join", "[", " ", 
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{"target", " ", "->", " ", "StandardGray"}], " ", "}"}], ",",
           "\n", "      ", 
          RowBox[{"MapIndexed", "[", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"{", " ", 
              RowBox[{"centre", ",", " ", "index"}], " ", "}"}], " ", "|->", 
             " ", 
             RowBox[{
              RowBox[{"InfraBall", "[", " ", 
               RowBox[{"centre", ",", " ", "radius"}], " ", "]"}], " ", "->", 
              " ", 
              RowBox[{
               RowBox[{"ColorData", "[", " ", "97", " ", "]"}], "[", " ", 
               RowBox[{"First", "[", " ", "index", " ", "]"}], " ", "]"}]}]}],
             ",", " ", "centres"}], " ", "]"}], ",", "\n", "      ", 
          RowBox[{"{", " ", 
           RowBox[{"centres", " ", "->", " ", "StandardRed"}], " ", "}"}]}], 
         " ", "]"}]}], " ", "]"}], ",", "\n", "    ", 
      RowBox[{"<|", " ", 
       RowBox[{
        RowBox[{"\"\<Radius\>\"", " ", "->", " ", "radius"}], ",", " ", 
        RowBox[{"\"\<Exact count\>\"", " ", "->", " ", 
         RowBox[{"BallCoverNumber", "[", " ", 
          RowBox[{"graph", ",", " ", "radius", ",", " ", "target"}], " ", 
          "]"}]}], ",", "\n", "      ", 
        RowBox[{"\"\<Covers target\>\"", " ", "->", " ", 
         RowBox[{"BallCoverQ", "[", " ", 
          RowBox[{
          "graph", ",", " ", "radius", ",", " ", "centres", ",", " ", 
           "target"}], " ", "]"}]}]}], " ", "|>"}]}], " ", "}"}], " ", 
    "]"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"6f434d5d-d5c1-477a-b7a1-58e3993a4ef0"],

