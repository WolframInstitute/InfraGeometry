Cell["The square-tiling trap", "Section",ExpressionUUID->"14a0dd74-8294-47bf-9864-089f782d98ff"],

Cell["\<\
The square tiling has a taxicab metric, whose unit ball is a diamond. The \
ball hull of two opposite points already fills that diamond. A third point on \
its side adds nothing. Thus a pair can span an area: the Euclidean span rule \
depends on the shape of the balls.\
\>", "Text",ExpressionUUID->"2f57c84d-3de3-48a7-9ab7-e690064a019c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "2", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", " ", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Large\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"centre", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", " ", "graph", " ", "]"}]}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"coordinates", " ", "=", " ", 
      RowBox[{"GraphEmbedding", "[", " ", "graph", " ", "]"}]}], ",", " ", 
     RowBox[{"vertices", " ", "=", " ", 
      RowBox[{"VertexList", "[", " ", "graph", " ", "]"}]}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"origin", " ", "=", " ", 
      RowBox[{"coordinates", "[", 
       RowBox[{"[", " ", 
        RowBox[{"VertexIndex", "[", " ", 
         RowBox[{"graph", ",", " ", "centre"}], " ", "]"}], " ", "]"}], 
       "]"}]}], ",", " ", 
     RowBox[{"neighbours", " ", "=", " ", 
      RowBox[{"AdjacencyList", "[", " ", 
       RowBox[{"graph", ",", " ", "centre"}], " ", "]"}]}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"direction", " ", "=", " ", 
     RowBox[{
      RowBox[{"coordinates", "[", 
       RowBox[{"[", " ", 
        RowBox[{"VertexIndex", "[", " ", 
         RowBox[{"graph", ",", " ", 
          RowBox[{"First", "[", " ", "neighbours", " ", "]"}]}], " ", "]"}], 
        " ", "]"}], "]"}], " ", "-", " ", "origin"}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", " ", 
    RowBox[{"seeds", " ", "=", " ", 
     RowBox[{"Map", "[", " ", 
      RowBox[{
       RowBox[{"offset", " ", "|->", " ", 
        RowBox[{"vertices", "[", 
         RowBox[{"[", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Ordering", "[", "\n", "      ", 
            RowBox[{
             RowBox[{"Norm", " ", "/@", " ", 
              RowBox[{"(", " ", 
               RowBox[{"coordinates", " ", "-", " ", 
                RowBox[{"ConstantArray", "[", " ", 
                 RowBox[{
                  RowBox[{"origin", " ", "+", " ", "offset"}], ",", " ", 
                  RowBox[{"Length", "[", " ", "coordinates", " ", "]"}]}], 
                 " ", "]"}]}], " ", ")"}]}], ",", " ", "1"}], " ", "]"}]}], 
          " ", "]"}], "]"}]}], ",", "\n", "      ", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "4"}], " ", "direction"}], ",", " ", 
         RowBox[{"4", " ", "direction"}], ",", " ", 
         RowBox[{"4", " ", 
          RowBox[{"Reverse", "[", " ", "direction", " ", "]"}], " ", 
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", "1"}], " ", "}"}]}]}], " ", "}"}]}],
       " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"hulls", " ", "=", " ", 
     RowBox[{"Table", "[", " ", 
      RowBox[{
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", " ", 
         RowBox[{"graph", ",", " ", 
          RowBox[{"InfraBallHull", "[", " ", 
           RowBox[{"Take", "[", " ", 
            RowBox[{"seeds", ",", " ", "k"}], " ", "]"}], " ", "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], " ", "]"}]}], ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"k", ",", " ", "2", ",", " ", "3"}], " ", "}"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"Column", "[", " ", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", " ", 
       RowBox[{"Table", "[", " ", 
        RowBox[{
         RowBox[{"Labeled", "[", " ", 
          RowBox[{
           RowBox[{"InfraSubstrateHighlight", "[", " ", 
            RowBox[{"graph", ",", "\n", "      ", 
             RowBox[{"{", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Complement", "[", " ", 
                 RowBox[{
                  RowBox[{"hulls", "[", 
                   RowBox[{"[", " ", 
                    RowBox[{"k", " ", "-", " ", "1"}], " ", "]"}], "]"}], ",",
                   " ", 
                  RowBox[{"Take", "[", " ", 
                   RowBox[{"seeds", ",", " ", "k"}], " ", "]"}]}], " ", "]"}],
                 " ", "->", " ", "StandardBlue"}], ",", "\n", "        ", 
               RowBox[{
                RowBox[{"Take", "[", " ", 
                 RowBox[{"seeds", ",", " ", "k"}], " ", "]"}], " ", "->", " ", 
                RowBox[{"{", " ", 
                 RowBox[{"StandardRed", ",", " ", 
                  RowBox[{"AbsolutePointSize", "[", " ", "7", " ", "]"}]}], 
                 " ", "}"}]}]}], " ", "}"}]}], " ", "]"}], ",", " ", 
           RowBox[{"Row", "[", " ", 
            RowBox[{"{", " ", 
             RowBox[{"k", ",", " ", "\"\< points\>\""}], " ", "}"}], " ", 
            "]"}]}], " ", "]"}], ",", " ", 
         RowBox[{"{", " ", 
          RowBox[{"k", ",", " ", "2", ",", " ", "3"}], " ", "}"}]}], " ", 
        "]"}], " ", "]"}], ",", "\n", "    ", 
      RowBox[{"<|", " ", 
       RowBox[{
        RowBox[{"\"\<Pair distance\>\"", " ", "->", " ", 
         RowBox[{"GraphDistance", "[", " ", 
          RowBox[{"graph", ",", " ", 
           RowBox[{"Sequence", " ", "@@", " ", 
            RowBox[{"Take", "[", " ", 
             RowBox[{"seeds", ",", " ", "2"}], " ", "]"}]}]}], " ", "]"}]}], ",",
         "\n", "      ", 
        RowBox[{"\"\<Hull volumes\>\"", " ", "->", " ", 
         RowBox[{"(", " ", 
          RowBox[{"Length", " ", "/@", " ", "hulls"}], " ", ")"}]}], ",", " ", 
        RowBox[{"\"\<Same hull\>\"", " ", "->", " ", 
         RowBox[{"(", " ", 
          RowBox[{
           RowBox[{"First", "[", " ", "hulls", " ", "]"}], " ", "===", " ", 
           RowBox[{"Last", "[", " ", "hulls", " ", "]"}]}], " ", ")"}]}]}], 
       " ", "|>"}]}], " ", "}"}], " ", "]"}]}], " ", "]"}]}], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"6d9570a3-a138-4b37-bfbc-09c78c220632"],

