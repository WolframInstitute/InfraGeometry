               RowBox[{"{", " ", 
                RowBox[{"4", ",", " ", "2"}], " ", "}"}]}], " ", "]"}]}], ",",
             "\n", "      ", 
            RowBox[{"Lookup", "[", " ", 
             RowBox[{"data", ",", " ", 
              RowBox[{"{", " ", 
               
