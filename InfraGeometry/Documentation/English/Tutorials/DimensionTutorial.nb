Cell["Doubling sees the shape of a ball", "Section",ExpressionUUID->"19231919-fc5d-4127-99dd-41789ccdf51f"],

Cell[TextData[{
 "A different reading covers ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["B", "TI"], 
    RowBox[{"2", 
     StyleBox["r", "TI"]}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["c", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b90f1f62-1b23-4a7a-acc9-9b1c02e9acd6"],
 " by balls of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbf62520-bc32-4f54-9557-0b114eb903f0"],
 " and takes the base-two logarithm of the count."
}], "Item",ExpressionUUID->"395feaf5-e3c2-4251-9798-3d4ab0dc937d"],

Cell["\<\
The square tiling admits a small exact cover. The mesh uses more balls in the \
greedy cover even though both substrates have planar growth dimension.\
\>", "Item",ExpressionUUID->"849442c8-8d55-46f7-ac3a-bd1b06ad2358"],

Cell["\<\
A Euclidean disc cannot tile a doubled disc without overlap. Doubling sees \
this covering overhead as well as the dimension. The greedy mesh count is an \
upper bound; it does not prove that no smaller cover exists.\
\>", "Item",ExpressionUUID->"b0cf9988-0d02-4a54-a0a5-b216b502d62c"],

Cell["\<\
The exact square-tiling counts and the greedy mesh counts, computed over \
interior scales. The pictures show one scale, with each ball in its own \
colour.\
\>", "Text",ExpressionUUID->"9880f909-6bde-4965-b90d-d6f5741e881c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "2", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"square", " ", "=", " ", 
      RowBox[{"InfraSubstrate", "[", " ", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
        " ", 
        RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], " ", 
       "]"}]}], ",", "\n", "    ", 
     RowBox[{"mesh", " ", "=", " ", 
      RowBox[{
       RowBox[{"dimensionSubstrates", "[", 
        RowBox[{"[", " ", "1", " ", "]"}], "]"}], "[", " ", "\"\<Graph\>\"", 
       " ", "]"}]}]}], " ", "}"}], ",", "\n", "\t", 
   RowBox[{"{", " ", 
    RowBox[{"cases", " ", "=", " ", 
     RowBox[{"{", " ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{
        "square", ",", " ", "\"\<Square tiling\>\"", ",", " ", "Automatic", ",",
          " ", 
         RowBox[{"Range", "[", " ", 
          RowBox[{"1", ",", " ", "3"}], " ", "]"}]}], " ", "}"}], ",", "\n", 
       "      ", 
       RowBox[{"{", " ", 
        RowBox[{
        "mesh", ",", " ", "\"\<Plane mesh\>\"", ",", " ", "\"\<Greedy\>\"", ",",
          " ", 
         RowBox[{"Range", "[", " ", 
          RowBox[{"2", ",", " ", "8"}], " ", "]"}]}], " ", "}"}]}], " ", 
      "}"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"Column", "[", " ", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"Grid", "[", " ", 
       RowBox[{
        RowBox[{"Prepend", "[", " ", 
         RowBox[{
          RowBox[{"Join", " ", "@@", " ", 
           RowBox[{"Apply", "[", "\n", "      ", 
            RowBox[{
             RowBox[{
              RowBox[{"{", " ", 
               RowBox[{
               "graph", ",", " ", "name", ",", " ", "method", ",", " ", 
                "radii"}], " ", "}"}], " ", "|->", " ", 
              RowBox[{"Map", "[", "\n", "        ", 
               RowBox[{
                RowBox[{"r", " ", "|->", " ", 
                 RowBox[{"With", "[", "\n", "\t\t\t\t\t", 
                  RowBox[{
                   RowBox[{"{", " ", 
                    RowBox[{"target", " ", "=", " ", 
                    RowBox[{"InfraBall", "[", " ", 
                    RowBox[{
                    RowBox[{"First", " ", "@", " ", 
                    RowBox[{"GraphCenter", "[", " ", "graph", " ", "]"}]}], ",",
                     " ", 
                    RowBox[{"2", " ", "r"}]}], " ", "]"}]}], " ", "}"}], ",", 
                   "\n", "\t\t\t\t\t", 
                   RowBox[{"{", " ", 
                    RowBox[{"count", " ", "=", " ", 
                    RowBox[{"Length", " ", "@", " ", 
                    RowBox[{"FindBallCover", "[", " ", 
                    RowBox[{
                    "graph", ",", " ", "r", ",", " ", "target", ",", " ", 
                    RowBox[{"Method", " ", "->", " ", "method"}]}], " ", 
                    "]"}]}]}], " ", "}"}], ",", "\n", "          ", 
                   RowBox[{"{", " ", 
                    RowBox[{
                    "name", ",", " ", "method", ",", " ", "r", ",", " ", 
                    "count", ",", " ", 
                    RowBox[{"NumberForm", "[", " ", 
                    RowBox[{
                    RowBox[{"N", "[", " ", 
                    RowBox[{"Log", "[", " ", 
                    RowBox[{"2", ",", " ", "count"}], " ", "]"}], " ", "]"}], 
                    ",", " ", 
                    RowBox[{"{", " ", 
                    RowBox[{"4", ",", " ", "2"}], " ", "}"}]}], " ", "]"}]}], 
                    " ", "}"}]}], " ", "]"}]}], ",", " ", "radii"}], " ", 
               "]"}]}], ",", " ", "cases", ",", " ", 
             RowBox[{"{", " ", "1", " ", "}"}]}], " ", "]"}]}], ",", "\n", 
          "      ", 
          RowBox[{"{", " ", 
           
           RowBox[{"\"\<Substrate\>\"", ",", " ", "\"\<Method\>\"", ",", 
            " ", "\"\<r\>\"", ",", " ", "\"\<Cover count\>\"", ",", 
            " ", "\"\<log2 count\>\""}], " ", "}"}]}], " ", "]"}], ",", " ", 
        RowBox[{"Frame", " ", "->", " ", "All"}]}], " ", "]"}], ",", "\n", 
      "    ", 
      RowBox[{"GraphicsRow", "[", " ", 
       RowBox[{"Apply", "[", "\n", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{
           "graph", ",", " ", "name", ",", " ", "method", ",", " ", "radii"}],
            " ", "}"}], " ", "|->", " ", 
          RowBox[{"With", "[", "\n", "        ", 
           RowBox[{
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{"r", " ", "=", " ", 
               RowBox[{"radii", "[", 
                RowBox[{"[", " ", "2", " ", "]"}], "]"}]}], ",", " ", 
              RowBox[{"centre", " ", "=", " ", 
               RowBox[{"First", " ", "@", " ", 
                RowBox[{"GraphCenter", "[", " ", "graph", " ", "]"}]}]}]}], 
             " ", "}"}], ",", "\n", "\t\t\t\t", 
            RowBox[{"{", " ", 
             RowBox[{"target", " ", "=", " ", 
              RowBox[{"InfraBall", "[", " ", 
               RowBox[{"centre", ",", " ", 
                RowBox[{"2", " ", "r"}]}], " ", "]"}]}], " ", "}"}], ",", 
            "\n", "        ", 
            RowBox[{"{", " ", 
             RowBox[{"centres", " ", "=", " ", 
              RowBox[{"FindBallCover", "[", " ", 
               RowBox[{"graph", ",", " ", "r", ",", " ", "target", ",", " ", 
                RowBox[{"Method", " ", "->", " ", "method"}]}], " ", "]"}]}], 
             " ", "}"}], ",", "\n", "        ", 
            RowBox[{"Labeled", "[", " ", 
             RowBox[{
              RowBox[{"InfraSubstrateHighlight", "[", " ", 
               RowBox[{"graph", ",", " ", 
                RowBox[{"Join", "[", " ", 
                 RowBox[{
                  RowBox[{"{", " ", 
                   RowBox[{"target", " ", "->", " ", "StandardGray"}], " ", 
                   "}"}], ",", "\n", "          ", 
                  RowBox[{"MapIndexed", "[", " ", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"{", " ", 
                    RowBox[{"point", ",", " ", "index"}], " ", "}"}], " ", "|->",
                     " ", 
                    RowBox[{
                    RowBox[{"InfraBall", "[", " ", 
                    RowBox[{"point", ",", " ", "r"}], " ", "]"}], " ", "->", 
                    " ", 
                    RowBox[{
                    RowBox[{"ColorData", "[", " ", "97", " ", "]"}], "[", " ", 
                    RowBox[{"First", "[", " ", "index", " ", "]"}], " ", 
                    "]"}]}]}], ",", " ", "centres"}], " ", "]"}], ",", "\n", 
                  "          ", 
                  RowBox[{"{", " ", 
                   RowBox[{"centres", " ", "->", " ", "StandardRed"}], " ", 
                   "}"}]}], " ", "]"}]}], " ", "]"}], ",", " ", "name"}], " ",
              "]"}]}], " ", "]"}]}], ",", " ", "cases", ",", " ", 
         RowBox[{"{", " ", "1", " ", "}"}]}], " ", "]"}], " ", "]"}]}], " ", 
     "}"}], " ", "]"}]}], " ", "]"}]}], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"90ecdd05-a8af-4f7f-a581-ae34af42e907"],

