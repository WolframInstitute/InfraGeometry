Notebook[{

Cell[CellGroupData[{
Cell["Dimension", "Title",ExpressionUUID->"bcb72528-31b3-40d4-b4bc-66135f280a96"],

Cell["LLM generated.", "Text",ExpressionUUID->"0217092b-bd41-4542-85ed-bcc70ce40479"],

Cell["\<\
Dimension describes how a region grows when its scale grows. We read it from \
vertex volumes and ball covers.\
\>", "Item",ExpressionUUID->"94c952d1-5a5a-4e36-9304-35b0ba5c7f11"],

Cell["\<\
The graph distance supplies the scale. The drawing supplies no measurement.\
\>", "Item",ExpressionUUID->"ddc4e8a5-ca00-442b-8828-5ae4b18c16cc"],

Cell["\<\
These are readings over finite windows. The lattice scale, the boundary and \
the shape of the balls can bias them.\
\>", "Item",ExpressionUUID->"163cc538-0445-41c8-8336-ebbea29b9b1c"],

Cell["Setup", "Section",ExpressionUUID->"9758d6a2-446d-4606-a51f-166dbf6fa6a0"],

Cell[BoxData[
 RowBox[{"Needs", "[", " ", "\"\<WolframInstitute`InfraGeometry`\>\"", " ", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4ea68cee-e46a-4a4c-b959-39450ae4a81d"],

Cell["\<\
The plane mesh, square tiling and Sierpinski triangle use the large roster \
size; the Menger carpet uses medium. The reference dimensions of the fractals \
come from their self-similar pieces and scale factors. The carpet is planar; \
its reference is not the dimension of the Menger sponge.\
\>", "Text",ExpressionUUID->"59db04f5-7b66-42aa-9786-792d75cac1f4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "2", " ", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dimensionSubstrates", " ", "=", " ", 
   RowBox[{"Apply", "[", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"{", " ", 
       RowBox[{"name", ",", " ", "size", ",", " ", "reference"}], " ", "}"}], 
      " ", "|->", " ", 
      RowBox[{"With", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{"graph", " ", "=", " ", 
          RowBox[{"InfraSubstrate", "[", " ", 
           RowBox[{"name", ",", " ", "size", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           " ", "]"}]}], " ", "}"}], ",", "\n", "    ", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"centre", " ", "=", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"GraphCenter", "[", " ", "graph", " ", "]"}]}]}], ",", 
          " ", 
          RowBox[{"radius", " ", "=", " ", 
           RowBox[{"Floor", "[", " ", 
            RowBox[{"4", " ", 
             RowBox[{
              RowBox[{"GraphRadius", "[", " ", "graph", " ", "]"}], " ", "/", 
              " ", "5"}]}], " ", "]"}]}]}], " ", "}"}], ",", "\n", "    ", 
        RowBox[{"<|", " ", 
         RowBox[{
          RowBox[{"\"\<Name\>\"", " ", "->", " ", "name"}], ",", " ", 
          RowBox[{"\"\<Graph\>\"", " ", "->", " ", "graph"}], ",", " ", 
          RowBox[{"\"\<Centre\>\"", " ", "->", " ", "centre"}], ",", " ", 
          RowBox[{"\"\<Radius\>\"", " ", "->", " ", "radius"}], ",", "\n", 
          "      ", 
          RowBox[{"\"\<Reference\>\"", " ", "->", " ", "reference"}]}], " ", 
         "|>"}]}], " ", "]"}]}], ",", "\n", "  ", 
     RowBox[{"{", " ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\"", ",", 
         " ", "2"}], " ", "}"}], ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Large\>\"", ",", 
         " ", "2"}], " ", "}"}], ",", "\n", "    ", 
       RowBox[{"{", " ", 
        RowBox[{"\"\<SierpinskiTriangleGraph\>\"", ",", " ", "\"\<Large\>\"", 
         ",", " ", 
         RowBox[{
          RowBox[{"Log", "[", " ", "3", " ", "]"}], " ", "/", " ", 
          RowBox[{"Log", "[", " ", "2", " ", "]"}]}]}], " ", "}"}], ",", "\n",
        "    ", 
       RowBox[{"{", " ", 
        RowBox[{"\"\<MengerCarpetGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
         " ", 
         RowBox[{
          RowBox[{"Log", "[", " ", "8", " ", "]"}], " ", "/", " ", 
          RowBox[{"Log", "[", " ", "3", " ", "]"}]}]}], " ", "}"}]}], " ", 
      "}"}], ",", " ", 
     RowBox[{"{", " ", "1", " ", "}"}]}], " ", "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsGrid", "[", " ", 
  RowBox[{"Partition", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Map", "[", " ", 
     RowBox[{
      RowBox[{"data", " ", "|->", " ", 
       RowBox[{"Labeled", "[", " ", 
        RowBox[{
         RowBox[{"data", "[", " ", "\"\<Graph\>\"", " ", "]"}], ",", " ", 
         RowBox[{"data", "[", " ", "\"\<Name\>\"", " ", "]"}]}], " ", "]"}]}],
       ",", " ", "dimensionSubstrates"}], " ", "]"}], ",", " ", "2"}], " ", 
   "]"}], " ", "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2b9e904a-1b58-4f5b-a6ec-eeebbab15f8b"],

