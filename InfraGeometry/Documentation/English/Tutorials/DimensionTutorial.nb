Cell["\<\
The table computes the hull volumes and their least-squares log-log slopes. \
The Euclidean reference exponents are one for the pair and two for both \
larger sets. The mesh, path direction and short window introduce visible \
errors; adding a fourth point should not introduce another planar dimension.\
\>", "Text",ExpressionUUID->"0b3bb6db-b582-4056-a139-5811da543bca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"spreads", " ", "=", " ", 
      RowBox[{"Lookup", "[", " ", 
       RowBox[{"planeSpans", ",", " ", "\"\<Spread\>\""}], " ", "]"}]}], ",", 
     " ", 
     RowBox[{"counts", " ", "=", " ", 
      RowBox[{"Map", "[", " ", 
       RowBox[{
        RowBox[{"data", " ", "|->", " ", 
         RowBox[{"Length", " ", "/@", " ", 
          RowBox[{"data", "[", " ", "\"\<Hulls\>\"", " ", "]"}]}]}], ",", " ",
         "planeSpans"}], " ", "]"}]}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"Column", "[", " ", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"Grid", "[", " ", 
       RowBox[{
        RowBox[{"Prepend", "[", " ", 
         RowBox[{
          RowBox[{"MapThread", "[", " ", 
           RowBox[{"Prepend", ",", " ", 
            RowBox[{"{", " ", 
             RowBox[{"counts", ",", " ", "spreads"}], " ", "}"}]}], " ", 
           "]"}], ",", " ", 
          RowBox[{"{", " ", 
           
           RowBox[{"\"\<L\>\"", ",", " ", "\"\<Pair\>\"", ",", 
            " ", "\"\<Triple\>\"", ",", " ", "\"\<Quadruple\>\""}], " ", 
           "}"}]}], " ", "]"}], ",", " ", 
        RowBox[{"Frame", " ", "->", " ", "All"}]}], " ", "]"}], ",", "\n", 
      "    ", 
      RowBox[{"Grid", "[", " ", 
       RowBox[{
        RowBox[{"Prepend", "[", " ", 
         RowBox[{
          RowBox[{"Table", "[", "\n", "      ", 
           RowBox[{
            RowBox[{"{", " ", 
             RowBox[{"k", ",", " ", 
              RowBox[{"Min", "[", " ", 
               RowBox[{
                RowBox[{"k", " ", "-", " ", "1"}], ",", " ", "2"}], " ", 
               "]"}], ",", " ", 
              RowBox[{"NumberForm", "[", " ", 
               RowBox[{
                RowBox[{"logSlope", "[", " ", 
                 RowBox[{"spreads", ",", " ", 
                  RowBox[{"counts", "[", 
                   RowBox[{"[", " ", 
                    RowBox[{"All", ",", " ", 
                    RowBox[{"k", " ", "-", " ", "1"}]}], " ", "]"}], "]"}]}], 
                 " ", "]"}], ",", " ", 
                RowBox[{"{", " ", 
                 RowBox[{"4", ",", " ", "2"}], " ", "}"}]}], " ", "]"}]}], 
             " ", "}"}], ",", " ", 
            RowBox[{"{", " ", 
             RowBox[{"k", ",", " ", "2", ",", " ", "4"}], " ", "}"}]}], " ", 
           "]"}], ",", "\n", "      ", 
          RowBox[{"{", " ", 
           
           RowBox[{"\"\<Points\>\"", ",", " ", "\"\<Euclidean exponent\>\"", ",",
             " ", "\"\<Measured exponent\>\""}], " ", "}"}]}], " ", "]"}], ",",
         " ", 
        RowBox[{"Frame", " ", "->", " ", "All"}]}], " ", "]"}], ",", "\n", 
      "    ", 
      RowBox[{"ListLogLogPlot", "[", " ", 
       RowBox[{
        RowBox[{"Map", "[", " ", 
         RowBox[{
          RowBox[{"volumes", " ", "|->", " ", 
           RowBox[{"Transpose", "[", " ", 
            RowBox[{"{", " ", 
             RowBox[{"spreads", ",", " ", "volumes"}], " ", "}"}], " ", 
            "]"}]}], ",", " ", 
          RowBox[{"Transpose", "[", " ", "counts", " ", "]"}]}], " ", "]"}], ",",
         "\n", "      ", 
        RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
        RowBox[{"PlotLegends", " ", "->", " ", 
         RowBox[{"{", " ", 
          
          RowBox[{"\"\<pair\>\"", ",", " ", "\"\<triple\>\"", ",", 
           " ", "\"\<quadruple\>\""}], " ", "}"}]}], ",", " ", 
        RowBox[{"AxesLabel", " ", "->", " ", 
         RowBox[{"{", " ", 
          RowBox[{"\"\<L\>\"", ",", " ", "\"\<hull vertices\>\""}], " ", 
          "}"}]}]}], " ", "]"}]}], " ", "}"}], " ", "]"}]}], " ", 
  "]"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"b767034c-35b8-4379-aaae-6d607dd3963f"],

