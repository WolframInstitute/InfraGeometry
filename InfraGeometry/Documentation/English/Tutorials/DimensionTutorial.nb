Cell["\<\
The same construction on the larger substrates, now with greedy covers. The \
target radius is a fixed fraction of the graph radius, and the covering \
radius a fraction of the target radius.\
\>", "Text",ExpressionUUID->"807bce83-9d31-4746-b456-c107982249a7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "2", " ", "]"}], ";"}], "\n", 
 RowBox[{"GraphicsGrid", "[", " ", 
  RowBox[{"Partition", "[", " ", 
   RowBox[{
    RowBox[{"Map", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"data", " ", "|->", " ", 
       RowBox[{"With", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{"graph", " ", "=", " ", 
            RowBox[{"data", "[", " ", "\"\<Graph\>\"", " ", "]"}]}], ",", " ", 
           RowBox[{"centre", " ", "=", " ", 
            RowBox[{"data", "[", " ", "\"\<Centre\>\"", " ", "]"}]}], ",", 
           " ", 
           RowBox[{"targetRadius", " ", "=", " ", 
            RowBox[{"data", "[", " ", "\"\<Radius\>\"", " ", "]"}]}]}], " ", 
          "}"}], ",", "\n", "    ", 
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{"radius", " ", "=", " ", 
            RowBox[{"Max", "[", " ", 
             RowBox[{"1", ",", " ", 
              RowBox[{"Floor", "[", " ", 
               RowBox[{"targetRadius", " ", "/", " ", "3"}], " ", "]"}]}], 
             " ", "]"}]}], ",", " ", 
           RowBox[{"target", " ", "=", " ", 
            RowBox[{"FindInfraRepresentative", "[", " ", 
             RowBox[{"graph", ",", " ", 
              RowBox[{"InfraBall", "[", " ", 
               RowBox[{"centre", ",", " ", "targetRadius"}], " ", "]"}]}], 
             " ", "]"}]}]}], " ", "}"}], ",", "\n", "    ", 
         RowBox[{"{", " ", 
          RowBox[{"centres", " ", "=", " ", 
           RowBox[{"FindBallCover", "[", " ", 
            RowBox[{"graph", ",", " ", "radius", ",", " ", "target", ",", " ", 
             RowBox[{"Method", " ", "->", " ", "\"\<Greedy\>\""}]}], " ", 
            "]"}]}], " ", "}"}], ",", "\n", "    ", 
         RowBox[{"Labeled", "[", "\n", "      ", 
          RowBox[{
           RowBox[{"InfraSubstrateHighlight", "[", " ", 
            RowBox[{"graph", ",", " ", 
             RowBox[{"Join", "[", " ", 
              RowBox[{
               RowBox[{"{", " ", 
                RowBox[{"target", " ", "->", " ", "StandardGray"}], " ", 
                "}"}], ",", "\n", "        ", 
               RowBox[{"MapIndexed", "[", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"{", " ", 
                   RowBox[{"point", ",", " ", "index"}], " ", "}"}], " ", "|->",
                   " ", 
                  RowBox[{
                   RowBox[{"InfraBall", "[", " ", 
                    RowBox[{"point", ",", " ", "radius"}], " ", "]"}], " ", "->",
                    " ", 
                   RowBox[{
                    RowBox[{"ColorData", "[", " ", "97", " ", "]"}], "[", " ", 
                    RowBox[{"First", "[", " ", "index", " ", "]"}], " ", 
                    "]"}]}]}], ",", " ", "centres"}], " ", "]"}], ",", "\n", 
               "        ", 
               RowBox[{"{", " ", 
                RowBox[{"centres", " ", "->", " ", "StandardRed"}], " ", 
                "}"}]}], " ", "]"}]}], " ", "]"}], ",", "\n", "      ", 
           RowBox[{"Row", "[", " ", 
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{"data", "[", " ", "\"\<Name\>\"", " ", "]"}], ",", 
              " ", "\"\<: \>\"", ",", " ", 
              RowBox[{"Length", "[", " ", "centres", " ", "]"}], ",", 
              " ", "\"\< balls, radius \>\"", ",", " ", "radius"}], " ", 
             "}"}], " ", "]"}]}], " ", "]"}]}], " ", "]"}]}], ",", "\n", "  ",
       "dimensionSubstrates"}], " ", "]"}], ",", " ", "2"}], " ", "]"}], " ", 
  "]"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"b5b1690f-7bfb-4e54-9723-618670c114bf"],

