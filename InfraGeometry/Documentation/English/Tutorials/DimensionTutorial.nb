Cell["Two covering slopes", "Section",ExpressionUUID->"199d9ac6-f2f3-49b3-93c2-f408e2dfa846"],

Cell[TextData[{
 StyleBox["Box reading.",
  FontWeight->"Bold"],
 " Fix ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], "=", 
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["\[Rho]", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["c", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c84dd23-40a1-417d-81f6-6468931f497d"],
 " and vary the covering radius. A ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6db2f984-210e-4f02-8155-5e2bc3fbf689"],
 "-dimensional region needs approximately ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["r", "TI"], 
   RowBox[{"-", 
    StyleBox["d", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b8fa131-cc9f-4465-a79e-e81c1a372bb2"],
 " balls."
}], "Item",ExpressionUUID->"f93af4b3-d5be-4d00-8133-6ab9abbdb2ff"],

Cell[TextData[{
 "On a lattice a ball volume is a polynomial in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "+", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24686a0d-689f-43d4-a357-0cfcb23606dc"],
 ". We use this shifted radius for the box slope. Using ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "763ebc89-fc99-4fc6-968c-08617fe7542c"],
 " at these small radii gives a lower reading."
}], "Item",ExpressionUUID->"61565a59-639b-4a10-b1f6-1fde056e115e"],

Cell[TextData[{
 StyleBox["Growth at a fixed resolution.",
  FontWeight->"Bold"],
 " Fix the covering radius and grow ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["s", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["c", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6db2f3e-1d0e-40b1-9dab-1806de9a143f"],
 ". Its covering count is the volume measured in balls of that radius. At \
radius zero this is exactly the vertex count."
}], "Item",ExpressionUUID->"b3c88576-40ef-47a4-859d-2731b5305247"],

Cell["\<\
We fit one least-squares slope over each window. Successive quotients of \
integer covering counts jump and can vanish on plateaux.\
\>", "Item",ExpressionUUID->"5290b92f-5e1a-426a-8c65-df1e211eee18"],

Cell["\<\
The profiles below are computed with greedy covers. The box window ends at \
half the target radius; the growth window starts beyond the first few layers. \
The vertex-volume slope uses exactly the growth window.\
\>", "Text",ExpressionUUID->"9f1ba317-389a-4790-ad6d-bddaea8d9a60"],

Cell[BoxData[
 RowBox[{
  RowBox[{"logSlope", "[", " ", 
   RowBox[{"scales_", ",", " ", "counts_"}], " ", "]"}], " ", ":=", "\n", 
  "  ", 
  RowBox[{"Coefficient", "[", " ", 
   RowBox[{
    RowBox[{"Fit", "[", " ", 
     RowBox[{
      RowBox[{"Transpose", "[", " ", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"Log", "[", " ", 
          RowBox[{"N", "[", " ", "scales", " ", "]"}], " ", "]"}], ",", " ", 
         RowBox[{"Log", "[", " ", 
          RowBox[{"N", "[", " ", "counts", " ", "]"}], " ", "]"}]}], " ", 
        "}"}], " ", "]"}], ",", " ", 
      RowBox[{"{", " ", 
       RowBox[{"1", ",", " ", "x"}], " ", "}"}], ",", " ", "x"}], " ", "]"}], 
    ",", " ", "x"}], " ", "]"}]}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"40596cbc-0691-4395-b762-76ad43681642"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "2", " ", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dimensionProfiles", " ", "=", " ", 
   RowBox[{"Map", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"data", " ", "|->", " ", 
      RowBox[{"With", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"graph", " ", "=", " ", 
           RowBox[{"data", "[", " ", "\"\<Graph\>\"", " ", "]"}]}], ",", " ", 
          
          RowBox[{"centre", " ", "=", " ", 
           RowBox[{"data", "[", " ", "\"\<Centre\>\"", " ", "]"}]}], ",", " ", 
          RowBox[{"radius", " ", "=", " ", 
           RowBox[{"data", "[", " ", "\"\<Radius\>\"", " ", "]"}]}]}], " ", 
         "}"}], ",", "\n", "    ", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"boxRadii", " ", "=", " ", 
           RowBox[{"Range", "[", " ", 
            RowBox[{"Floor", "[", " ", 
             RowBox[{"radius", " ", "/", " ", "2"}], " ", "]"}], " ", "]"}]}],
           ",", " ", 
          RowBox[{"growthRadii", " ", "=", " ", 
           RowBox[{"Range", "[", " ", 
            RowBox[{"3", ",", " ", "radius"}], " ", "]"}]}], ",", "\n", 
          "\t\t\t", 
          RowBox[{"target", " ", "=", " ", 
           RowBox[{"InfraBall", "[", " ", 
            RowBox[{"centre", ",", " ", "radius"}], " ", "]"}]}]}], " ", 
         "}"}], ",", "\n", "\t\t", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"boxCounts", " ", "=", " ", 
           RowBox[{"Map", "[", " ", 
            RowBox[{
             RowBox[{"r", " ", "|->", " ", 
              RowBox[{"Length", " ", "@", " ", 
               RowBox[{"FindBallCover", "[", " ", 
                RowBox[{
                "graph", ",", " ", "r", ",", " ", "target", ",", " ", 
                 RowBox[{"Method", " ", "->", " ", "\"\<Greedy\>\""}]}], " ", 
                "]"}]}]}], ",", " ", "boxRadii"}], " ", "]"}]}], ",", "\n", 
          "\t\t\t", 
          RowBox[{"growthCounts", " ", "=", " ", 
           RowBox[{"Map", "[", " ", 
            RowBox[{
             RowBox[{"s", " ", "|->", " ", 
              RowBox[{"Length", " ", "@", " ", 
               RowBox[{"FindBallCover", "[", " ", 
                RowBox[{"graph", ",", " ", "1", ",", " ", 
                 RowBox[{"InfraBall", "[", " ", 
                  RowBox[{"centre", ",", " ", "s"}], " ", "]"}], ",", " ", 
                 RowBox[{"Method", " ", "->", " ", "\"\<Greedy\>\""}]}], " ", 
                "]"}]}]}], ",", " ", "growthRadii"}], " ", "]"}]}], ",", "\n",
           "      ", 
          RowBox[{"volumes", " ", "=", " ", 
           RowBox[{"Map", "[", " ", 
            RowBox[{
             RowBox[{"s", " ", "|->", " ", 
              RowBox[{"Length", " ", "@", " ", 
