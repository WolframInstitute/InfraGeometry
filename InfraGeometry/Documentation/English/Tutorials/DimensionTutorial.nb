Cell["\<\
The same construction on the larger substrates, now with greedy covers. The \
target radius is a fixed fraction of the graph radius, and the covering \
radius a fraction of the target radius.\
\>", "Text",ExpressionUUID->"e9fd610c-8957-4b2e-8cca-492adf86ea62"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "2", " ", "]"}], ";"}], "\n", 
 RowBox[{"GraphicsGrid", "[", " ", 
  RowBox[{"Partition", "[", " ", 
   RowBox[{
    RowBox[{"Map", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"data", " ", "|->", " ", 
       RowBox[{"With", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{"graph", " ", "=", " ", 
            RowBox[{"data", "[", " ", "\"\<Graph\>\"", " ", "]"}]}], ",", " ", 
           RowBox[{"centre", " ", "=", " ", 
            RowBox[{"data", "[", " ", "\"\<Centre\>\"", " ", "]"}]}], ",", 
           " ", 
           RowBox[{"targetRadius", " ", "=", " ", 
            RowBox[{"data", "[", " ", "\"\<Radius\>\"", " ", "]"}]}]}], " ", 
          "}"}], ",", "\n", "\t\t", 
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{"radius", " ", "=", " ", 
            RowBox[{"Max", "[", " ", 
             RowBox[{"1", ",", " ", 
              RowBox[{"Floor", "[", " ", 
               RowBox[{"targetRadius", " ", "/", " ", "3"}], " ", "]"}]}], 
             " ", "]"}]}], ",", " ", 
           RowBox[{"target", " ", "=", " ", 
            RowBox[{"InfraBall", "[", " ", 
             RowBox[{"centre", ",", " ", "targetRadius"}], " ", "]"}]}]}], 
          " ", "}"}], ",", "\n", "    ", 
         RowBox[{"{", " ", 
          RowBox[{"centres", " ", "=", " ", 
           RowBox[{"FindBallCover", "[", " ", 
            RowBox[{"graph", ",", " ", "radius", ",", " ", "target", ",", " ", 
             RowBox[{"Method", " ", "->", " ", "\"\<Greedy\>\""}]}], " ", 
            "]"}]}], " ", "}"}], ",", "\n", "    ", 
         RowBox[{"Labeled", "[", "\n", "      ", 
          RowBox[{
           RowBox[{"InfraSubstrateHighlight", "[", " ", 
            RowBox[{"graph", ",", " ", 
             RowBox[{"Join", "[", " ", 
              RowBox[{
               RowBox[{"{", " ", 
                RowBox[{"target", " ", "->", " ", "StandardGray"}], " ", 
                "}"}], ",", "\n", "        ", 
               RowBox[{"MapIndexed", "[", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"{", " ", 
                   RowBox[{"point", ",", " ", "index"}], " ", "}"}], " ", "|->",
                   " ", 
                  RowBox[{
                   RowBox[{"InfraBall", "[", " ", 
                    RowBox[{"point", ",", " ", "radius"}], " ", "]"}], " ", "->",
                    " ", 
                   RowBox[{
                    RowBox[{"ColorData", "[", " ", "97", " ", "]"}], "[", " ", 
                    RowBox[{"First", "[", " ", "index", " ", "]"}], " ", 
                    "]"}]}]}], ",", " ", "centres"}], " ", "]"}], ",", "\n", 
               "        ", 
               RowBox[{"{", " ", 
                RowBox[{"centres", " ", "->", " ", "StandardRed"}], " ", 
                "}"}]}], " ", "]"}]}], " ", "]"}], ",", "\n", "      ", 
           RowBox[{"Row", "[", " ", 
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{"data", "[", " ", "\"\<Name\>\"", " ", "]"}], ",", 
              " ", "\"\<: \>\"", ",", " ", 
              RowBox[{"Length", "[", " ", "centres", " ", "]"}], ",", 
              " ", "\"\< balls, radius \>\"", ",", " ", "radius"}], " ", 
             "}"}], " ", "]"}]}], " ", "]"}]}], " ", "]"}]}], ",", "\n", "  ",
       "dimensionSubstrates"}], " ", "]"}], ",", " ", "2"}], " ", "]"}], " ", 
  "]"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"4959f0fd-faa2-4079-bcd7-30c484926739"],

