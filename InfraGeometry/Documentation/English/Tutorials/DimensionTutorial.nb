Cell["Volume growth", "Section",ExpressionUUID->"9a8b8911-34fb-434b-8013-8e68f22f587f"],

Cell[TextData[{
 "Write ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["V", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["s", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   TemplateBox[{
     RowBox[{
       SubscriptBox[
        StyleBox["B", "TI"], 
        StyleBox["s", "TI"]], 
       StyleBox["(", SpanMaxSize -> 1], 
       StyleBox["c", "TI"], 
       StyleBox[")", SpanMaxSize -> 1]}]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d898a4f6-f320-45c3-b7ed-6690fd8587d5"],
 " for the number of vertices in the closed ball about a centre."
}], "Item",ExpressionUUID->"b073b733-fc7d-4aee-a544-7228a2329ca7"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["s", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de3bee88-aaff-4bf8-9db5-30590770502d"],
 " is proportional to ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["s", "TI"], 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bfb3bb76-80d8-4256-80b5-996818fa1aa0"],
 ", its log-log slope is ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dbf1384-8e1a-408f-a4cc-537b5fdc5efb"],
 "."
}], "Item",ExpressionUUID->"89ba9746-b62a-4b56-bff0-913ec96172ce"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LogDifferenceQuotients"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/LogDifferenceQuotients", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5990c7db-0769-4ea8-9e54-b93073ba63d3"],
 " reads successive slopes. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DimensionCurvatureFit"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b99e3679-f87f-4f04-978e-dc8f5dcd231f"],
 " fits their dimension and curvature over a chosen window; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VolumeGrowthObservables"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "18e27654-ce39-4ab1-a74b-6ae7090c12e9"],
 " chooses a window for the Riemannian probes."
}], "Item",ExpressionUUID->"ddbb81cb-8326-4aa1-af84-2ce5427612c9"],

Cell["\<\
The growth dimension once, on the plane mesh: the quotients and the fitted \
curve. Small radii see individual layers; large radii see the boundary. The \
fit is a reading over the selected window.\
\>", "Text",ExpressionUUID->"82031df0-a6ce-4e7c-a469-538ff21a1261"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "2", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{
       RowBox[{"dimensionSubstrates", "[", 
        RowBox[{"[", " ", "1", " ", "]"}], "]"}], "[", " ", "\"\<Graph\>\"", 
       " ", "]"}]}], ",", " ", 
     RowBox[{"centre", " ", "=", " ", 
      RowBox[{
       RowBox[{"dimensionSubstrates", "[", 
        RowBox[{"[", " ", "1", " ", "]"}], "]"}], "[", " ", "\"\<Centre\>\"", 
       " ", "]"}]}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"observables", " ", "=", " ", 
     RowBox[{"VolumeGrowthObservables", "[", " ", 
      RowBox[{"graph", ",", " ", "centre", ",", " ", 
       RowBox[{"\"\<Measure\>\"", " ", "->", 
        " ", "\"\<CountingMeasure\>\""}]}], " ", "]"}]}], " ", "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"window", " ", "=", " ", 
      RowBox[{"observables", "[", " ", "\"\<BallWindow\>\"", " ", "]"}]}], ",",
      " ", 
     RowBox[{"quotients", " ", "=", " ", 
      RowBox[{
      "observables", "[", " ", "\"\<BallLogDifferenceQuotients\>\"", " ", 
       "]"}]}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"Table", "[", " ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"r", ",", " ", 
         RowBox[{"quotients", "[", 
          RowBox[{"[", " ", "r", " ", "]"}], "]"}]}], " ", "}"}], ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"r", ",", " ", 
         RowBox[{"window", "[", 
          RowBox[{"[", " ", "1", " ", "]"}], "]"}], ",", " ", 
         RowBox[{"window", "[", 
          RowBox[{"[", " ", "2", " ", "]"}], "]"}]}], " ", "}"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"fit", " ", "=", " ", 
     RowBox[{"DimensionCurvatureFit", "[", " ", "points", " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Column", "[", " ", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"Show", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"ListPlot", "[", " ", 
         RowBox[{"points", ",", " ", 
          RowBox[{"AxesLabel", " ", "->", " ", 
           RowBox[{"{", " ", 
            RowBox[{"\"\<r\>\"", ",", " ", "\"\<q\>\""}], " ", "}"}]}], ",", 
          " ", 
          RowBox[{"PlotRange", " ", "->", " ", "All"}]}], " ", "]"}], ",", 
        "\n", "      ", 
        RowBox[{"Plot", "[", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"fit", "[", " ", "\"\<Dimension\>\"", " ", "]"}], " ", "-",
            " ", 
           RowBox[{
            RowBox[{"fit", "[", " ", "\"\<ScalarCurvature\>\"", " ", "]"}], " ",
             "r", " ", 
            RowBox[{
             RowBox[{"(", " ", 
              RowBox[{"r", " ", "+", " ", "1"}], " ", ")"}], " ", "/", " ", 
             RowBox[{"(", " ", 
              RowBox[{"3", " ", 
               RowBox[{"(", " ", 
                RowBox[{
                 RowBox[{"fit", "[", " ", "\"\<Dimension\>\"", " ", "]"}], 
                 " ", "+", " ", "2"}], " ", ")"}]}], " ", ")"}]}]}]}], ",", 
          "\n", "        ", 
          RowBox[{"{", " ", 
           RowBox[{"r", ",", " ", 
            RowBox[{"window", "[", 
             RowBox[{"[", " ", "1", " ", "]"}], "]"}], ",", " ", 
            RowBox[{"window", "[", 
             RowBox[{"[", " ", "2", " ", "]"}], "]"}]}], " ", "}"}]}], " ", 
         "]"}]}], " ", "]"}], ",", "\n", "    ", "fit"}], " ", "}"}], " ", 
    "]"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"d6fac1ef-5c5a-4398-a2bf-8adfbb911fa4"],

