Cell["The span of points", "Section",ExpressionUUID->"f57131e4-3287-43bc-b842-ca7b28c3c677"],

Cell[TextData[{
 "The ball hull is the intersection of all balls containing the chosen \
points. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBallHull"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBallHull", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "96c87d5b-85ca-4849-8150-1d22c930dfe1"],
 " restricts their radii when a bound is supplied."
}], "Item",ExpressionUUID->"f82a020f-876c-464f-9f0f-1610494cd617"],

Cell[TextData[{
 "In Euclidean space this is the convex hull. For ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3824638-0b0e-47e4-9824-610dbfa1cd80"],
 " points in general position its dimension is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["min",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["k", "TI"], "-", "1"}], ",", 
    StyleBox["d", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4c892f4-735f-4503-a05e-9461232aaf70"],
 "."
}], "Item",ExpressionUUID->"cb022a77-e598-4d85-97a9-5e247d49f515"],

Cell[TextData[{
 "A pair spans a segment, a triple a triangle. The first full-dimensional \
hull needs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2da7e290-7990-42ce-84d9-c4e25e368600"],
 " points."
}], "Item",ExpressionUUID->"fa210965-c624-427a-8bb0-707956a66f68"],

Cell[TextData[{
 "On a graph we compare the number of hull vertices as the separation ",
 Cell[BoxData[
  StyleBox["L", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f195f848-d7c6-4e1d-8e17-858f71ad7c9c"],
 " grows. This tests a scaling window, rather than assigning an exact \
dimension to one finite hull."
}], "Item",ExpressionUUID->"d51682c8-54ed-4c2b-8861-b05c879f7db2"],

Cell["\<\
On the plane mesh we start at a centre and follow one shortest path for the \
chosen separation. Each further point is chosen to keep its distances from \
the earlier points close to that separation. The hulls are blue and their \
defining points red.\
\>", "Text",ExpressionUUID->"687cf48c-9db0-4911-87f8-e57e14ee193e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "2", " ", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"planeSpans", " ", "=", " ", 
   RowBox[{"With", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", " ", 
      RowBox[{"graph", " ", "=", " ", 
       RowBox[{"InfraSubstrate", "[", " ", 
        RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\"", ",", 
         " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], " ", 
        "]"}]}], " ", "}"}], ",", "\n", "  ", 
     RowBox[{"{", " ", 
      RowBox[{
       RowBox[{"vertices", " ", "=", " ", 
        RowBox[{"VertexList", "[", " ", "graph", " ", "]"}]}], ",", " ", 
       RowBox[{"distances", " ", "=", " ", 
        RowBox[{"GraphDistanceMatrix", "[", " ", "graph", " ", "]"}]}], ",", 
       " ", 
       RowBox[{"centre", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", " ", "graph", " ", "]"}]}]}]}], " ", 
      "}"}], ",", "\n", "  ", 
     RowBox[{"{", " ", 
      RowBox[{"endpoint", " ", "=", " ", 
       RowBox[{"Last", " ", "@", " ", 
        RowBox[{"MaximalBy", "[", " ", 
         RowBox[{"vertices", ",", " ", 
          RowBox[{"v", " ", "|->", " ", 
           RowBox[{"GraphDistance", "[", " ", 
            RowBox[{"graph", ",", " ", "centre", ",", " ", "v"}], " ", 
            "]"}]}]}], " ", "]"}]}]}], " ", "}"}], ",", "\n", "  ", 
     RowBox[{"{", " ", 
      RowBox[{"path", " ", "=", " ", 
       RowBox[{"FindShortestPath", "[", " ", 
        RowBox[{"graph", ",", " ", "centre", ",", " ", "endpoint"}], " ", 
        "]"}]}], " ", "}"}], ",", "\n", "  ", 
     RowBox[{"Map", "[", " ", 
      RowBox[{
       RowBox[{"spread", " ", "|->", " ", 
        RowBox[{"With", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{"pair", " ", "=", " ", 
            RowBox[{"Map", "[", " ", 
             RowBox[{
              RowBox[{"v", " ", "|->", " ", 
               RowBox[{"VertexIndex", "[", " ", 
                RowBox[{"graph", ",", " ", "v"}], " ", "]"}]}], ",", " ", 
              RowBox[{"path", "[", 
               RowBox[{"[", " ", 
                RowBox[{"{", " ", 
                 RowBox[{"1", ",", " ", 
                  RowBox[{"spread", " ", "+", " ", "1"}]}], " ", "}"}], " ", 
                "]"}], "]"}]}], " ", "]"}]}], " ", "}"}], ",", "\n", "    ", 
          RowBox[{"{", " ", 
           RowBox[{"indices", " ", "=", " ", 
            RowBox[{"Nest", "[", " ", 
             RowBox[{
              RowBox[{"chosen", " ", "|->", " ", 
               RowBox[{"Append", "[", " ", 
                RowBox[{"chosen", ",", "\n", "        ", 
                 RowBox[{"First", " ", "@", " ", 
                  RowBox[{"Ordering", "[", " ", 
                   RowBox[{
                    RowBox[{"Total", "[", " ", 
                    RowBox[{"Abs", "[", " ", 
                    RowBox[{
                    RowBox[{"distances", "[", 
                    RowBox[{"[", " ", "chosen", " ", "]"}], "]"}], " ", "-", 
                    " ", "spread"}], " ", "]"}], " ", "]"}], ",", " ", "1"}], 
                   " ", "]"}]}]}], " ", "]"}]}], ",", " ", "pair", ",", " ", 
              "2"}], " ", "]"}]}], " ", "}"}], ",", "\n", "    ", 
          RowBox[{"{", " ", 
           RowBox[{"seeds", " ", "=", " ", 
            RowBox[{"vertices", "[", 
             RowBox[{"[", " ", "indices", " ", "]"}], "]"}]}], " ", "}"}], ",",
           "\n", "    ", 
          RowBox[{"<|", " ", 
           RowBox[{
            RowBox[{"\"\<Graph\>\"", " ", "->", " ", "graph"}], ",", " ", 
            RowBox[{"\"\<Spread\>\"", " ", "->", " ", "spread"}], ",", " ", 
            RowBox[{"\"\<Seeds\>\"", " ", "->", " ", "seeds"}], ",", "\n", 
            "      ", 
            RowBox[{"\"\<Hulls\>\"", " ", "->", " ", 
             RowBox[{"Table", "[", " ", 
              RowBox[{
               RowBox[{"Keys", " ", "@", " ", 
                RowBox[{"InfraMeasurement", "[", " ", 
                 RowBox[{"graph", ",", " ", 
                  RowBox[{"InfraBallHull", "[", " ", 
                   RowBox[{"Take", "[", " ", 
                    RowBox[{"seeds", ",", " ", "k"}], " ", "]"}], " ", "]"}], 
                  ",", " ", "\"\<VertexDensity\>\""}], " ", "]"}]}], ",", " ", 
               RowBox[{"{", " ", 
                RowBox[{"k", ",", " ", "2", ",", " ", "4"}], " ", "}"}]}], 
              " ", "]"}]}]}], " ", "|>"}]}], " ", "]"}]}], ",", "\n", "    ", 
       
       RowBox[{"{", " ", 
        RowBox[{"2", ",", " ", "4", ",", " ", "6", ",", " ", "8"}], " ", 
        "}"}]}], " ", "]"}]}], " ", "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsRow", "[", " ", 
  RowBox[{"Table", "[", " ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", " ", 
       RowBox[{"data", " ", "=", " ", 
        RowBox[{"Last", "[", " ", "planeSpans", " ", "]"}]}], " ", "}"}], ",",
       "\n", "  ", 
      RowBox[{"Labeled", "[", " ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", " ", 
         RowBox[{
          RowBox[{"data", "[", " ", "\"\<Graph\>\"", " ", "]"}], ",", "\n", 
          "    ", 
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Complement", "[", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"data", "[", " ", "\"\<Hulls\>\"", " ", "]"}], "[", 
                RowBox[{"[", " ", 
                 RowBox[{"k", " ", "-", " ", "1"}], " ", "]"}], "]"}], ",", 
               " ", 
               RowBox[{"Take", "[", " ", 
                RowBox[{
                 RowBox[{"data", "[", " ", "\"\<Seeds\>\"", " ", "]"}], ",", 
                 " ", "k"}], " ", "]"}]}], " ", "]"}], " ", "->", " ", 
             "StandardBlue"}], ",", "\n", "      ", 
            RowBox[{
             RowBox[{"Take", "[", " ", 
              RowBox[{
               RowBox[{"data", "[", " ", "\"\<Seeds\>\"", " ", "]"}], ",", 
               " ", "k"}], " ", "]"}], " ", "->", " ", 
             RowBox[{"{", " ", 
              RowBox[{"StandardRed", ",", " ", 
               RowBox[{"AbsolutePointSize", "[", " ", "7", " ", "]"}]}], " ", 
              "}"}]}]}], " ", "}"}]}], " ", "]"}], ",", "\n", "    ", 
        RowBox[{"Row", "[", " ", 
         RowBox[{"{", " ", 
          RowBox[{"k", ",", " ", "\"\< points, L = \>\"", ",", " ", 
           RowBox[{"data", "[", " ", "\"\<Spread\>\"", " ", "]"}]}], " ", 
          "}"}], " ", "]"}]}], " ", "]"}]}], " ", "]"}], ",", " ", 
    RowBox[{"{", " ", 
     RowBox[{"k", ",", " ", "2", ",", " ", "4"}], " ", "}"}]}], " ", "]"}], 
  " ", "]"}]}], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"83f25eec-8b18-4dc5-b315-e03c68de8ba6"],

