          " ", "]"}], ",", "\n", "      ", 
         RowBox[{"Show", "[", "\n", "        ", 
          RowBox[{
           RowBox[{"ListPlot", "[", " ", 
            RowBox[{
             RowBox[{"{", " ", 
              RowBox[{
               RowBox[{"Transpose", "[", " ", 
                RowBox[{"{", " ", 
                 RowBox[{
                  RowBox[{"data", "[", " ", "\"\<GrowthRadii\>\"", " ", "]"}],
                   ",", " ", 
                  RowBox[{"growth", " ", "/", " ", 
                   RowBox[{"First", "[", " ", "growth", " ", "]"}]}]}], " ", 
                 "}"}], " ", "]"}], ",", "\n", "          ", 
               RowBox[{"Transpose", "[", " ", 
                RowBox[{"{", " ", 
                 RowBox[{
                  RowBox[{"data", "[", " ", "\"\<GrowthRadii\>\"", " ", "]"}],
                   ",", " ", 
                  RowBox[{"volume", " ", "/", " ", 
                   RowBox[{"First", "[", " ", "volume", " ", "]"}]}]}], " ", 
                 "}"}], " ", "]"}]}], " ", "}"}], ",", " ", 
             RowBox[{"Joined", " ", "->", " ", "True"}], ",", "\n", 
             "          ", 
             RowBox[{"PlotLegends", " ", "->", " ", 
              RowBox[{"{", " ", 
               RowBox[{"\"\<cover\>\"", ",", " ", "\"\<vertices\>\""}], " ", 
               "}"}]}], ",", " ", 
             RowBox[{"AxesLabel", " ", "->", " ", 
              RowBox[{"{", " ", 
