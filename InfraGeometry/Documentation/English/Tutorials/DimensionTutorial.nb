Cell["Readings at this resolution", "Section",ExpressionUUID->"cf786d12-0eed-494e-986f-93f5daba9d36"],

Cell["\<\
The table compares the slopes with the reference dimensions. The carpet has a \
shorter scale window than the other examples. The cover slopes are readings \
from greedy upper bounds, not certified estimates of the least-cover slopes.\
\>", "Text",ExpressionUUID->"085ebe08-c5f4-4123-ac12-e3d865b7c819"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", " ", 
  RowBox[{
   RowBox[{"Prepend", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"Map", "[", " ", 
      RowBox[{
       RowBox[{"data", " ", "|->", " ", 
