Cell["Volume growth", "Section",ExpressionUUID->"2f59d7f6-5071-4a4f-bee6-4ef904c05155"],

Cell[TextData[{
 "Write ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["V", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["s", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   TemplateBox[{
     RowBox[{
       SubscriptBox[
        StyleBox["B", "TI"], 
        StyleBox["s", "TI"]], 
       StyleBox["(", SpanMaxSize -> 1], 
       StyleBox["c", "TI"], 
       StyleBox[")", SpanMaxSize -> 1]}]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76e3bbdb-65e0-4f47-a0a1-0044e828acd7"],
 " for the number of vertices in the closed ball about a centre."
}], "Item",ExpressionUUID->"6afebcaf-56b9-4179-87cb-31211a61823e"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["s", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c731a48d-f143-46bf-a364-dc183afac3d9"],
 " is proportional to ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["s", "TI"], 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90f59357-493a-474b-af98-6f6991c78e59"],
 ", its log-log slope is ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0de1d459-1958-44e6-8b44-047def4bdf4b"],
 "."
}], "Item",ExpressionUUID->"e36b7912-5a47-463a-a4d1-23150f0677ec"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LogDifferenceQuotients"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/LogDifferenceQuotients", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c4125bfd-b2b0-4dc6-b661-12aa4aea08b3"],
 " reads successive slopes. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DimensionCurvatureFit"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f1194f9e-4a8a-44f1-ab39-452d6dec1d34"],
 " fits their dimension and curvature over a chosen window; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VolumeGrowthObservables"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "75b52707-53bb-4cf3-8a4e-f7d7b1cc4f3d"],
 " chooses a window for the Riemannian probes."
}], "Item",ExpressionUUID->"c3b4ea71-ddc6-4d0c-9aeb-b03b94402444"],

Cell["\<\
The growth dimension once, on the plane mesh: the quotients and the fitted \
curve. Small radii see individual layers; large radii see the boundary. The \
fit is a reading over the selected window.\
\>", "Text",ExpressionUUID->"376f88ae-e9ad-4993-a420-490060f68553"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "2", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{
       RowBox[{"dimensionSubstrates", "[", 
        RowBox[{"[", " ", "1", " ", "]"}], "]"}], "[", " ", "\"\<Graph\>\"", 
       " ", "]"}]}], ",", " ", 
     RowBox[{"centre", " ", "=", " ", 
      RowBox[{
       RowBox[{"dimensionSubstrates", "[", 
        RowBox[{"[", " ", "1", " ", "]"}], "]"}], "[", " ", "\"\<Centre\>\"", 
       " ", "]"}]}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"observables", " ", "=", " ", 
     RowBox[{"VolumeGrowthObservables", "[", " ", 
      RowBox[{"graph", ",", " ", "centre", ",", " ", 
       RowBox[{"\"\<Measure\>\"", " ", "->", 
        " ", "\"\<CountingMeasure\>\""}]}], " ", "]"}]}], " ", "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"window", " ", "=", " ", 
      RowBox[{"observables", "[", " ", "\"\<BallWindow\>\"", " ", "]"}]}], ",",
      " ", 
     RowBox[{"quotients", " ", "=", " ", 
      RowBox[{
      "observables", "[", " ", "\"\<BallLogDifferenceQuotients\>\"", " ", 
       "]"}]}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"Table", "[", " ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"r", ",", " ", 
         RowBox[{"quotients", "[", 
          RowBox[{"[", " ", "r", " ", "]"}], "]"}]}], " ", "}"}], ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"r", ",", " ", 
         RowBox[{"window", "[", 
          RowBox[{"[", " ", "1", " ", "]"}], "]"}], ",", " ", 
         RowBox[{"window", "[", 
          RowBox[{"[", " ", "2", " ", "]"}], "]"}]}], " ", "}"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"fit", " ", "=", " ", 
     RowBox[{"DimensionCurvatureFit", "[", " ", "points", " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Column", "[", " ", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"Show", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"ListPlot", "[", " ", 
         RowBox[{"points", ",", " ", 
          RowBox[{"AxesLabel", " ", "->", " ", 
           RowBox[{"{", " ", 
            RowBox[{"\"\<r\>\"", ",", " ", "\"\<q\>\""}], " ", "}"}]}], ",", 
          " ", 
          RowBox[{"PlotRange", " ", "->", " ", "All"}]}], " ", "]"}], ",", 
        "\n", "      ", 
        RowBox[{"Plot", "[", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"fit", "[", " ", "\"\<Dimension\>\"", " ", "]"}], " ", "-",
            " ", 
           RowBox[{
            RowBox[{"fit", "[", " ", "\"\<ScalarCurvature\>\"", " ", "]"}], " ",
             "r", " ", 
            RowBox[{
             RowBox[{"(", " ", 
              RowBox[{"r", " ", "+", " ", "1"}], " ", ")"}], " ", "/", " ", 
             RowBox[{"(", " ", 
              RowBox[{"3", " ", 
               RowBox[{"(", " ", 
                RowBox[{
                 RowBox[{"fit", "[", " ", "\"\<Dimension\>\"", " ", "]"}], 
                 " ", "+", " ", "2"}], " ", ")"}]}], " ", ")"}]}]}]}], ",", 
          "\n", "        ", 
          RowBox[{"{", " ", 
           RowBox[{"r", ",", " ", 
            RowBox[{"window", "[", 
             RowBox[{"[", " ", "1", " ", "]"}], "]"}], ",", " ", 
            RowBox[{"window", "[", 
             RowBox[{"[", " ", "2", " ", "]"}], "]"}]}], " ", "}"}]}], " ", 
         "]"}]}], " ", "]"}], ",", "\n", "    ", "fit"}], " ", "}"}], " ", 
    "]"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"62990458-d678-4930-861f-2e7460c81093"],

