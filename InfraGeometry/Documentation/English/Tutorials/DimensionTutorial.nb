               " ", "}"}]}], ",", " ", 
             RowBox[{"PlotRange", " ", "->", " ", "All"}]}], " ", "]"}], ",", 
           "\n", "        ", 
           RowBox[{"Plot", "[", " ", 
            RowBox[{"1", ",", " ", 
             RowBox[{"{", " ", 
              RowBox[{"s", ",", " ", 
