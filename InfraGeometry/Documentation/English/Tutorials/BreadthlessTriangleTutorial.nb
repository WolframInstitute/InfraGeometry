          RowBox[{"{", 
           RowBox[{"g", " ", "=", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
              RowBox[{"InfraSubstrate", "[", 
               RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "size"}], "]"}]}],
              ")"}]}], "}"}], ",", "\n", "        ", 
          RowBox[{"{", 
           RowBox[{"abc", " ", "=", " ", 
            RowBox[{"corners", " ", "@", " ", "g"}]}], "}"}], ",", "\n", 
          "        ", 
          RowBox[{"{", 
