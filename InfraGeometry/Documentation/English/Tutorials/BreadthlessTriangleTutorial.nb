           RowBox[{"name", ",", " ", "size", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"abc", " ", "=", " ", 
