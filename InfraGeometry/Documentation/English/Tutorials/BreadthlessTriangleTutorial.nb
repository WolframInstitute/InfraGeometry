Cell["\<\
The breadth of the density falls on every substrate, the square tiling and \
the mesh alike. On a lattice the count of shortest paths through a vertex is \
a product of binomial coefficients, so the density of a rhombus concentrates \
on a band of the order of the square root of the length around its diagonal, \
and the breadth falls as the inverse square root.\
\>", "Item",ExpressionUUID->"7d217b1c-37e8-406e-8dbc-68d691f2fb81"],

Cell["\<\
The hexagonal tiling alternates between two levels with the parity of the \
radius.\
\>", "Item",ExpressionUUID->"74651b4e-133d-43d2-998f-03d7cc8e038c"],

Cell["The breadth of the support, the same sides.", "Text",ExpressionUUID->"3fbeb3a3-67f2-40bb-a9ca-b8eedb80e56b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Join", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{
             RowBox[{"spec", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
             RowBox[{"spec", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
         "        ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"c", " ", "=", " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"GraphCenter", " ", "@", " ", "g"}]}]}], ",", " ", 
           RowBox[{"d", " ", "=", " ", 
            RowBox[{"GraphDistanceMatrix", " ", "@", " ", "g"}]}]}], "}"}], ",",
          "\n", "        ", 
         RowBox[{"Table", "[", "\n", "          ", 
          RowBox[{
           RowBox[{"With", "[", "\n", "            ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"shell", " ", "=", " ", 
               RowBox[{"FindInfraShell", "[", 
                RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]}], "}"}], ",",
              "\n", "            ", 
             RowBox[{"{", 
              RowBox[{"row", " ", "=", " ", 
               RowBox[{"end", " ", "|->", " ", 
                RowBox[{"d", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"VertexIndex", "[", 
                    RowBox[{"g", ",", " ", "end"}], "]"}], ",", " ", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"VertexIndex", "[", 
                    RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@",
                     " ", "shell"}]}], "]"}], "]"}]}]}], "}"}], ",", "\n", 
             "            ", 
             RowBox[{"{", 
              RowBox[{"a", " ", "=", " ", 
               RowBox[{"First", " ", "@", " ", "shell"}]}], "}"}], ",", "\n", 
             "            ", 
             RowBox[{"{", 
              RowBox[{"b", " ", "=", " ", 
               RowBox[{"shell", "[", 
                RowBox[{"[", 
                 RowBox[{"First", " ", "@", " ", 
                  RowBox[{"Ordering", "[", 
                   RowBox[{
                    RowBox[{"row", " ", "@", " ", "a"}], ",", " ", 
                    RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}], "}"}], ",",
              "\n", "            ", 
             RowBox[{"{", 
              RowBox[{"abc", " ", "=", " ", 
               RowBox[{"{", 
                RowBox[{"a", ",", " ", "b", ",", " ", 
                 RowBox[{"shell", "[", 
                  RowBox[{"[", 
                   RowBox[{"First", " ", "@", " ", 
                    RowBox[{"Ordering", "[", 
                    RowBox[{
                    RowBox[{"MapThread", "[", 
                    RowBox[{"Min", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"row", " ", "@", " ", "a"}], ",", " ", 
                    RowBox[{"row", " ", "@", " ", "b"}]}], "}"}]}], "]"}], ",",
                     " ", 
                    RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}], "}"}]}], 
              "}"}], ",", "\n", "            ", 
             RowBox[{"{", 
              RowBox[{"r", ",", " ", 
               RowBox[{"First", " ", "@", " ", 
                RowBox[{"triangleBreadth", "[", 
                 RowBox[{"g", ",", " ", "abc"}], "]"}]}]}], "}"}]}], "]"}], ",",
            "\n", "          ", 
           RowBox[{"{", 
            RowBox[{"r", ",", " ", "2", ",", " ", 
             RowBox[{"spec", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], "}"}]}], "]"}]}], "]"}], ",", 
       "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"spec", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "30", ",", " ", 
             "14"}], "}"}], ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "26", ",", " ",
              "13"}], "}"}], ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "45", ",", " ", 
             "22"}], "}"}]}], "}"}]}], "}"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"Table", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"With", "[", "\n", "        ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"g", " ", "=", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
              RowBox[{"InfraSubstrate", "[", 
               RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "size"}], "]"}]}],
              ")"}]}], "}"}], ",", "\n", "        ", 
          RowBox[{"{", 
           RowBox[{"abc", " ", "=", " ", 
            RowBox[{"corners", " ", "@", " ", "g"}]}], "}"}], ",", "\n", 
          "        ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Floor", "[", 
             RowBox[{
              RowBox[{"GraphRadius", "[", "g", "]"}], "/", "2"}], "]"}], ",", 
            " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"triangleBreadth", "[", 
              RowBox[{"g", ",", " ", "abc"}], "]"}]}]}], "}"}]}], "]"}], ",", 
        "\n", "      ", 
        RowBox[{"{", 
         RowBox[{"size", ",", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
            " ", "\"\<Large\>\"", ",", " ", "0.0003"}], "}"}]}], "}"}]}], 
       "]"}], "}"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Text", "[", "\"\<r\>\"", "]"}], ",", " ", 
      RowBox[{"Text", "[", "\"\<breadth\>\"", "]"}]}], "}"}]}], ",", "\n", 
   "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"Text", " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<square\>\"", ",", " ", "\"\<triangular\>\"", ",", 
       " ", "\"\<hexagonal\>\"", ",", " ", "\"\<mesh\>\""}], "}"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"a0a79325-0f57-40b1-8276-fe9ee1dc6d0b"],

