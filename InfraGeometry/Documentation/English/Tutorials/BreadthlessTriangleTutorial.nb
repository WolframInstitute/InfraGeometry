Cell["\<\
On the square tiling the interval of two vertices in general position is a \
full rectangle with the side as its diagonal; the rectangle does not thin out \
as the tiling grows, but the density concentrates along the diagonal, where \
the binomial counts of lattice paths peak.\
\>", "Item",ExpressionUUID->"f38c01b1-28b7-425b-9bf1-ddb70ea4c239"],

Cell["\<\
On the triangular tiling a side along a lattice direction is one path; a side \
off the lattice directions is a parallelogram with the same concentration.\
\>", "Item",ExpressionUUID->"a7e54d64-6687-4ae0-968d-189cba48db04"],

Cell["\<\
On the mesh a side is a thin bundle of paths, and its density is largest \
where the bundle is narrowest.\
\>", "Item",ExpressionUUID->"84e5f032-d0f5-49d2-b57e-2057bdd41387"],

Cell["The density in numbers", "Section",ExpressionUUID->"0f15b122-a720-41f0-8522-7d62073ee8da"],

Cell["\<\
The vertex density of the whole triangle, written at each vertex of its \
support, on the small substrates. A corner carries the paths of both sides \
through it; a vertex on a thin side carries one.\
\>", "Item",ExpressionUUID->"e095990a-20a7-4327-8496-810de3ac44bd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"abc", " ", "=", " ", 
        RowBox[{"corners", " ", "@", " ", "g"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"rho", " ", "=", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraUnion", " ", "@@", " ", 
           RowBox[{"(", 
            RowBox[{"InfraSegment", " ", "@@@", " ", 
             RowBox[{"Partition", "[", 
              RowBox[{"abc", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], 
              "]"}]}], ")"}]}], ",", " ", "\"\<VertexDensity\>\""}], "]"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"InfraSegment", " ", "@@@", " ", 
             RowBox[{"Partition", "[", 
              RowBox[{"abc", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], 
              "]"}]}], ",", " ", "abc"}], "}"}]}], "]"}], ",", "\n", "      ", 
        RowBox[{"VertexLabels", " ", "->", " ", 
         RowBox[{"KeyValueMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#1", " ", "->", " ", 
             RowBox[{"Placed", "[", 
              RowBox[{"#2", ",", " ", "Above"}], "]"}]}], " ", "&"}], ",", 
           " ", "rho"}], "]"}]}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

