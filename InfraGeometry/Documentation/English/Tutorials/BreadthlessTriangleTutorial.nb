Cell["\<\
The breadth of the density falls on every substrate, the square tiling and \
the mesh alike. On a lattice the count of shortest paths through a vertex is \
a product of binomial coefficients, so the density of a rhombus concentrates \
on a band of the order of the square root of the length around its diagonal, \
and the breadth falls as the inverse square root.\
\>", "Item",ExpressionUUID->"6ac30d19-7cf6-48cf-b502-26bdf064bd71"],

Cell["\<\
The hexagonal tiling alternates between two levels with the parity of the \
radius.\
\>", "Item",ExpressionUUID->"210b8375-1bb0-4eaf-aec9-1f7fa9fe8608"],

Cell["The breadth of the support, the same sides.", "Text",ExpressionUUID->"0989be29-c544-4ce3-9385-25efa48616c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Join", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{
             RowBox[{"spec", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
             RowBox[{"spec", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
         "        ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"c", " ", "=", " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"GraphCenter", " ", "@", " ", "g"}]}]}], ",", " ", 
           RowBox[{"d", " ", "=", " ", 
            RowBox[{"GraphDistanceMatrix", " ", "@", " ", "g"}]}]}], "}"}], ",",
          "\n", "        ", 
         RowBox[{"Table", "[", "\n", "          ", 
          RowBox[{
           RowBox[{"With", "[", "\n", "            ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"shell", " ", "=", " ", 
               RowBox[{"FindInfraShell", "[", 
                RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]}], "}"}], ",",
              "\n", "            ", 
             RowBox[{"{", 
              RowBox[{"row", " ", "=", " ", 
               RowBox[{"end", " ", "|->", " ", 
                RowBox[{"d", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"VertexIndex", "[", 
                    RowBox[{"g", ",", " ", "end"}], "]"}], ",", " ", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"VertexIndex", "[", 
                    RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@",
                     " ", "shell"}]}], "]"}], "]"}]}]}], "}"}], ",", "\n", 
             "            ", 
             RowBox[{"{", 
              RowBox[{"a", " ", "=", " ", 
               RowBox[{"First", " ", "@", " ", "shell"}]}], "}"}], ",", "\n", 
             "            ", 
             RowBox[{"{", 
              RowBox[{"b", " ", "=", " ", 
               RowBox[{"shell", "[", 
                RowBox[{"[", 
                 RowBox[{"First", " ", "@", " ", 
                  RowBox[{"Ordering", "[", 
                   RowBox[{
                    RowBox[{"row", " ", "@", " ", "a"}], ",", " ", 
                    RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}], "}"}], ",",
              "\n", "            ", 
             RowBox[{"{", 
              RowBox[{"abc", " ", "=", " ", 
               RowBox[{"{", 
                RowBox[{"a", ",", " ", "b", ",", " ", 
                 RowBox[{"shell", "[", 
                  RowBox[{"[", 
                   RowBox[{"First", " ", "@", " ", 
                    RowBox[{"Ordering", "[", 
                    RowBox[{
                    RowBox[{"MapThread", "[", 
                    RowBox[{"Min", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"row", " ", "@", " ", "a"}], ",", " ", 
                    RowBox[{"row", " ", "@", " ", "b"}]}], "}"}]}], "]"}], ",",
                     " ", 
                    RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}], "}"}]}], 
              "}"}], ",", "\n", "            ", 
             RowBox[{"{", 
              RowBox[{"r", ",", " ", 
               RowBox[{"First", " ", "@", " ", 
                RowBox[{"triangleBreadth", "[", 
                 RowBox[{"g", ",", " ", "abc"}], "]"}]}]}], "}"}]}], "]"}], ",",
            "\n", "          ", 
           RowBox[{"{", 
            RowBox[{"r", ",", " ", "2", ",", " ", 
             RowBox[{"spec", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], "}"}]}], "]"}]}], "]"}], ",", 
       "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"spec", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "30", ",", " ", 
             "14"}], "}"}], ",", " ", 
