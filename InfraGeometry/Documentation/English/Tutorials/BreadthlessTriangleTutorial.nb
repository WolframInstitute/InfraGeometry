Cell["One side", "Section",ExpressionUUID->"fbe36817-6d5b-4b3a-9334-c173f22a415d"],

Cell[TextData[{
 "The side ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe9f7efa-528b-4b3b-a221-589ce2777f7f"],
 " is the inert head on the two corners; on a graph it is the interval ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fcd2d44-00cc-48f4-8210-13380c604c08"],
 " with its vertex density. The ink is the density: a vertex is drawn the \
larger and an edge the thicker, the more shortest paths run through it."
}], "Item",ExpressionUUID->"0f235983-433f-4703-8711-8f8e6fe7cb2a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "size", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"abc", " ", "=", " ", 
        RowBox[{"corners", " ", "@", " ", "g"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraSegment", "[", 
           RowBox[{
            RowBox[{"abc", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            RowBox[{"abc", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"abc", "[", 
            RowBox[{"[", 
             RowBox[{";;", " ", "2"}], "]"}], "]"}], " ", "->", " ", 
           "StandardBlue"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"size", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
        " ", "\"\<Large\>\""}], "}"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

