Notebook[{

Cell[CellGroupData[{
Cell["The Breadthless Triangle", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 "Euclid opens with two definitions: a point is that which has no part, and a \
line is breadthless length. A graph has neither. Its points are vertices, and \
the segment from ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c93a8c4e-ae70-49a0-a58c-9e2dc367787d"],
 " to ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e152e401-ada2-4694-97c5-553f3eea0b7c"],
 " is the set of all shortest paths between them, the ",
 StyleBox["interval",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c85936-ed27-41f2-a546-fc25f64d701f"],
 ", which has breadth."
}], "Item",ExpressionUUID->"09eb56e0-583c-4b22-85ba-bbea57183465"],

Cell[TextData[{
 "The triangle on three corners ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], ",", 
   StyleBox["b", "TI"], ",", 
   StyleBox["c", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a310ec3-410b-47bf-b85c-776872f5a458"],
 " is the union of the three segments ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b83101f5-c0d1-4221-aae3-89398651313c"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["b", "TI"], ",", 
    StyleBox["c", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77e533ba-89b2-437d-af3f-d8b17e937ef2"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["a", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64997a89-93c4-4402-90e4-08f99703755b"],
 ". The ",
 StyleBox["vertex density",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea319621-f0f5-4e72-914a-2b9a00433b2c"],
 " of a segment counts the shortest paths through ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41859504-f17f-46c5-bf9c-6e171b730c40"],
 "; the triangle's density is the sum over its sides."
}], "Item",ExpressionUUID->"59da3479-2bbd-4f28-ad63-7637ff42130a"],

Cell[TextData[{
 "Let the substrate grow: a tiling at a growing radius, a mesh under \
refinement. We rescale the path metric and the counting measure so that the \
circumradius of the triangle stays one. The claim is that the normalized \
densities ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["n", "TI"]], "/", 
   UnderscriptBox["\[Sum]", 
    StyleBox["v", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0e2cc59-6552-484e-b342-db16ba9c29da"],
 " converge weakly to the uniform measure on a triangle of the plane, \
although the support of a side does not thin out at all."
}], "Item",ExpressionUUID->"718adadd-f31b-4ae9-9941-bfabed9e6cce"],

Cell["\<\
The pictures keep the embedding of the substrate so that the reader sees the \
plane; no construction below uses it.\
\>", "Item",ExpressionUUID->"ee8c0455-ae1f-45c9-a4a3-b87dcbc55f6d"],

Cell["Setup", "Section",ExpressionUUID->"f2e642f7-d171-4baa-87df-3f9f3f542d06"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`InfraGeometry`\>\"", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4fe37dd5-bd08-4b6c-9ff2-4f2e49223e3d"],

Cell[TextData[{
 "The corners: three vertices on the shell of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b8b0a03-6a6c-4b17-b9dc-bd1ca35352d0"],
 " about a centre of the graph, pairwise as far apart as the shell allows. \
The scale ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0b2b3c9-92e0-448a-990a-0eeb236de632"],
 " is half the graph radius."
}], "Text",ExpressionUUID->"3f3f51e4-31dc-41f7-93ec-c6b23d8196e5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"corners", "[", "g_", "]"}], " ", ":=", " ", 
  RowBox[{"With", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", " ", "@", " ", "g"}]}]}], ",", " ", 
      RowBox[{"d", " ", "=", " ", 
       RowBox[{"GraphDistanceMatrix", " ", "@", " ", "g"}]}]}], "}"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"r", " ", "=", " ", 
      RowBox[{"Floor", "[", 
       RowBox[{
        RowBox[{"GraphRadius", "[", "g", "]"}], "/", "2"}], "]"}]}], "}"}], ",",
     "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"shell", " ", "=", " ", 
      RowBox[{"FindInfraShell", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]}], "}"}], ",", "\n",
     "  ", 
    RowBox[{"{", 
     RowBox[{"row", " ", "=", " ", 
      RowBox[{"end", " ", "|->", " ", 
       RowBox[{"d", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"VertexIndex", "[", 
           RowBox[{"g", ",", " ", "end"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"VertexIndex", "[", 
             RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
           "shell"}]}], "]"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", "shell"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"shell", "[", 
       RowBox[{"[", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"Ordering", "[", 
          RowBox[{
           RowBox[{"row", " ", "@", " ", "a"}], ",", " ", 
           RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}], "}"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"a", ",", " ", "b", ",", " ", 
      RowBox[{"shell", "[", 
       RowBox[{"[", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"Ordering", "[", 
          RowBox[{
           RowBox[{"MapThread", "[", 
            RowBox[{"Min", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"row", " ", "@", " ", "a"}], ",", " ", 
               RowBox[{"row", " ", "@", " ", "b"}]}], "}"}]}], "]"}], ",", 
           " ", 
           RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a42e2ac3-8733-4d90-b604-8a513d36a936"],

Cell[TextData[{
 "The breadth of a side, read on its level sets: the vertices of the interval \
at distance ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cbd5afb-9f3c-42e9-95da-4dd6e9ba7bf4"],
 " from ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0cf23ca-891b-4825-9f48-a43595826799"],
 ", for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["t", "TI"], "=", "0"}], ",", "\[Ellipsis]", ",", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["b", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d15f0cdc-e23f-41cd-9b99-fbcbed615b37"],
 ". The breadth of the support is the mean size of a level set, the breadth \
of the density the mean effective size ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   UnderscriptBox["\[Sum]", 
    StyleBox["v", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["t", "TI"]], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["v", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49c0f696-03ea-459d-889b-f4e3df1efd09"],
 " of the density normalized on the level set; both in units of the length."
}], "Text",ExpressionUUID->"10ffb3f3-0c21-493e-a374-5100c537dd81"],

Cell[BoxData[
 RowBox[{
  RowBox[{"breadth", "[", 
   RowBox[{"g_", ",", " ", "a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
  RowBox[{"With", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"rho", " ", "=", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSegment", "[", 
          RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
      RowBox[{"d", " ", "=", " ", 
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", "a"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"levels", " ", "=", " ", 
      RowBox[{"Values", " ", "@", " ", 
       RowBox[{"GroupBy", "[", 
        RowBox[{
         RowBox[{"Normal", " ", "@", " ", "rho"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"d", "[", 
            RowBox[{"[", 
             RowBox[{"VertexIndex", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"First", " ", "@", " ", "#"}]}], "]"}], "]"}], "]"}], 
           " ", "&"}], " ", "->", " ", "Last"}]}], "]"}]}]}], "}"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"length", " ", "=", " ", 
      RowBox[{
       RowBox[{"Length", "[", "levels", "]"}], " ", "-", " ", "1"}]}], "}"}], 
    ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Mean", "[", 
        RowBox[{"Length", " ", "/@", " ", "levels"}], "]"}], " ", "/", " ", 
       "length"}], ",", " ", 
      RowBox[{
       RowBox[{"Mean", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"1", " ", "/", " ", 
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#", " ", "/", " ", 
               RowBox[{"Total", " ", "@", " ", "#"}]}], ")"}], "^", "2"}], 
            "]"}]}], " ", "&"}], " ", "/@", " ", "levels"}], "]"}], " ", "/", 
       " ", "length"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"9eed835f-ba5e-4ea3-ad9d-86ca98ce10fb"],

Cell["The breadth of a triangle: the mean over its three sides.", "Text",ExpressionUUID->"85836677-f7ac-4973-aba0-62ae54d7d35d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"triangleBreadth", "[", 
   RowBox[{"g_", ",", " ", "abc_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Mean", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"breadth", "[", 
      RowBox[{"g", ",", " ", "#1", ",", " ", "#2"}], "]"}], " ", "&"}], " ", "@@@",
     " ", 
    RowBox[{"Partition", "[", 
     RowBox[{"abc", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"5c6b847d-a70c-4180-b13c-419542345d69"],

Cell["The corners", "Section",ExpressionUUID->"c46dc159-cf2e-49e5-85bf-30ac4342d268"],

Cell["\<\
Each picture below is one substrate at one size: the rows are the sizes \
small, medium and large, the columns the square tiling, the triangular tiling \
and an irregular square mesh.\
\>", "Item",ExpressionUUID->"ac78f0d4-6c97-4bcb-a941-89fce36f8640"],

Cell[TextData[{
 "The shell of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4454d60e-9e75-4115-a70a-c91c619683be"],
 " about the centre is gray, the three corners on it blue. The corners are \
chosen by the path metric alone, so on the mesh the triangle is as irregular \
as the mesh is."
}], "Item",ExpressionUUID->"9589caa3-10c4-48e8-a9c1-5aba8adf8e44"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "size", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", " ", "@", " ", "g"}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"Floor", "[", 
         RowBox[{
          RowBox[{"GraphRadius", "[", "g", "]"}], "/", "2"}], "]"}]}], "}"}], 
      ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"FindInfraShell", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}], " ", "->", 
           " ", "StandardGray"}], ",", " ", 
          RowBox[{
           RowBox[{"corners", "[", "g", "]"}], " ", "->", " ", 
           "StandardBlue"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"size", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
        " ", "\"\<Large\>\""}], "}"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[5]:= ",ExpressionUUID->"51f18c60-2e51-4094-8b7a-d782acf0b5f4"],

