Notebook[{

Cell[CellGroupData[{
Cell["The Breadthless Triangle", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 "Euclid opens with two definitions: a point is that which has no part, and a \
line is breadthless length. A graph has neither. Its points are vertices, and \
the segment from ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c219915e-b83c-426b-a4d4-d4f7171adbb2"],
 " to ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb7c7a50-8164-4d15-ba13-d6d813c62ee5"],
 " is the set of all shortest paths between them, the ",
 StyleBox["interval",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4313c4b9-47cd-4ecc-8331-a4eb9d7ca82d"],
 ", which has breadth."
}], "Item",ExpressionUUID->"f6d758b3-281c-4d6e-9199-67bcd7596c52"],

Cell[TextData[{
 "The triangle on three corners ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], ",", 
   StyleBox["b", "TI"], ",", 
   StyleBox["c", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0baa0792-710b-418b-ac0b-5e1b38000763"],
 " is the union of the three segments ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffcf4865-e630-43c4-b524-959c184c82ed"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["b", "TI"], ",", 
    StyleBox["c", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50890dc3-752a-430b-b69b-1b795489fbf3"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["a", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aeaa2b38-65e5-4d44-833f-ccca2de6da13"],
 ". The ",
 StyleBox["vertex density",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14042399-9420-46e8-80df-f963515a405e"],
 " of a segment counts the shortest paths through ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b73ad5f-8304-48be-ac2b-3bba64845b06"],
 "; the triangle's density is the sum over its sides."
}], "Item",ExpressionUUID->"e50ece65-0963-4bf1-9708-2677775428f5"],

Cell[TextData[{
 "Let the substrate grow: a tiling at a growing radius, a mesh under \
refinement. We rescale the path metric and the counting measure so that the \
circumradius of the triangle stays one. The claim is that the normalized \
densities ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["n", "TI"]], "/", 
   UnderscriptBox["\[Sum]", 
    StyleBox["v", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c43efc73-a62d-4d84-8e7f-88b983f48bb0"],
 " converge weakly to the uniform measure on a triangle of the plane, \
although the support of a side does not thin out at all."
}], "Item",ExpressionUUID->"d54c5bb1-37dc-4a57-a94e-fd2123dba03a"],

Cell["\<\
The pictures keep the embedding of the substrate so that the reader sees the \
plane; no construction below uses it.\
\>", "Item",ExpressionUUID->"66377ec7-e3b3-41e7-832e-d4a94816cbec"],

Cell["Setup", "Section",ExpressionUUID->"7b9ab692-5883-4755-a432-839f0ceca7ac"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`InfraGeometry`\>\"", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6f7a0ef9-ad24-489b-bb08-f8f45dc16c97"],

Cell[TextData[{
 "The corners: three vertices on the shell of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b8b7eb6-ba1d-47a0-b148-927df2886928"],
 " about a centre of the graph, pairwise as far apart as the shell allows. \
The scale ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75594759-78af-41bc-b5a6-2f61428a2e11"],
 " is half the graph radius."
}], "Text",ExpressionUUID->"834a0236-6a4a-4011-881e-b26e1443fc27"],

Cell[BoxData[
 RowBox[{
  RowBox[{"corners", "[", "g_", "]"}], " ", ":=", " ", 
  RowBox[{"With", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", " ", "@", " ", "g"}]}]}], ",", " ", 
      RowBox[{"d", " ", "=", " ", 
       RowBox[{"GraphDistanceMatrix", " ", "@", " ", "g"}]}]}], "}"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"r", " ", "=", " ", 
      RowBox[{"Floor", "[", 
       RowBox[{
        RowBox[{"GraphRadius", "[", "g", "]"}], "/", "2"}], "]"}]}], "}"}], ",",
     "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"shell", " ", "=", " ", 
      RowBox[{"FindInfraShell", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]}], "}"}], ",", "\n",
     "  ", 
    RowBox[{"{", 
     RowBox[{"row", " ", "=", " ", 
      RowBox[{"end", " ", "|->", " ", 
       RowBox[{"d", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"VertexIndex", "[", 
           RowBox[{"g", ",", " ", "end"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"VertexIndex", "[", 
             RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
           "shell"}]}], "]"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", "shell"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"shell", "[", 
       RowBox[{"[", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"Ordering", "[", 
          RowBox[{
           RowBox[{"row", " ", "@", " ", "a"}], ",", " ", 
           RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}], "}"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"a", ",", " ", "b", ",", " ", 
      RowBox[{"shell", "[", 
       RowBox[{"[", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"Ordering", "[", 
          RowBox[{
           RowBox[{"MapThread", "[", 
            RowBox[{"Min", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"row", " ", "@", " ", "a"}], ",", " ", 
               RowBox[{"row", " ", "@", " ", "b"}]}], "}"}]}], "]"}], ",", 
           " ", 
           RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ac8809a0-6bcd-49bf-bae2-f4902ccbf003"],

Cell[TextData[{
 "The breadth of a side, read on its level sets: the vertices of the interval \
at distance ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a4d95e9-b176-401d-a2cc-b0d1150c967d"],
 " from ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f163bef8-6c18-422b-903f-cec3ca939ccd"],
 ", for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["t", "TI"], "=", "0"}], ",", "\[Ellipsis]", ",", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["b", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b93a678-30ce-49dc-9f1b-0836c52c690a"],
 ". The breadth of the support is the mean size of a level set, the breadth \
of the density the mean effective size ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   UnderscriptBox["\[Sum]", 
    StyleBox["v", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["t", "TI"]], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["v", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd057e37-97f4-4b0c-83ca-7532fc1ffe8d"],
 " of the density normalized on the level set; both in units of the length."
}], "Text",ExpressionUUID->"36000307-99bc-4ed6-b2ae-a5451faf9ddb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"breadth", "[", 
   RowBox[{"g_", ",", " ", "a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
  RowBox[{"With", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"rho", " ", "=", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSegment", "[", 
          RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
      RowBox[{"d", " ", "=", " ", 
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", "a"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"levels", " ", "=", " ", 
      RowBox[{"Values", " ", "@", " ", 
       RowBox[{"GroupBy", "[", 
        RowBox[{
         RowBox[{"Normal", " ", "@", " ", "rho"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"d", "[", 
            RowBox[{"[", 
             RowBox[{"VertexIndex", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"First", " ", "@", " ", "#"}]}], "]"}], "]"}], "]"}], 
           " ", "&"}], " ", "->", " ", "Last"}]}], "]"}]}]}], "}"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"length", " ", "=", " ", 
      RowBox[{
       RowBox[{"Length", "[", "levels", "]"}], " ", "-", " ", "1"}]}], "}"}], 
    ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Mean", "[", 
        RowBox[{"Length", " ", "/@", " ", "levels"}], "]"}], " ", "/", " ", 
       "length"}], ",", " ", 
      RowBox[{
       RowBox[{"Mean", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"1", " ", "/", " ", 
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#", " ", "/", " ", 
               RowBox[{"Total", " ", "@", " ", "#"}]}], ")"}], "^", "2"}], 
            "]"}]}], " ", "&"}], " ", "/@", " ", "levels"}], "]"}], " ", "/", 
       " ", "length"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"6272de8d-2989-48c9-a56a-4e884e5d48b1"],

Cell["The breadth of a triangle: the mean over its three sides.", "Text",ExpressionUUID->"deaebcfe-2903-4d28-95ec-a716798ef246"],

Cell[BoxData[
 RowBox[{
  RowBox[{"triangleBreadth", "[", 
   RowBox[{"g_", ",", " ", "abc_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Mean", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"breadth", "[", 
      RowBox[{"g", ",", " ", "#1", ",", " ", "#2"}], "]"}], " ", "&"}], " ", "@@@",
     " ", 
    RowBox[{"Partition", "[", 
     RowBox[{"abc", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"df507fc9-09c5-46d1-987a-946fd2b9ea32"],

Cell["The corners", "Section",ExpressionUUID->"433ed673-ef7a-4566-999a-ea35d7141fa6"],

Cell["\<\
Each picture below is one substrate at one size: the rows are the sizes \
small, medium and large, the columns the square tiling, the triangular tiling \
and an irregular square mesh.\
\>", "Item",ExpressionUUID->"faa30b5c-8476-4cc3-8907-e7cda9e1fd2e"],

Cell[TextData[{
 "The shell of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f1461be4-4e84-44fc-9efc-fd28c38752e9"],
 " about the centre is gray, the three corners on it blue. The corners are \
chosen by the path metric alone, so on the mesh the triangle is as irregular \
as the mesh is."
}], "Item",ExpressionUUID->"4b0eb13e-4764-4c51-a9f7-6d8ca2f2318e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "size", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", " ", "@", " ", "g"}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"Floor", "[", 
         RowBox[{
          RowBox[{"GraphRadius", "[", "g", "]"}], "/", "2"}], "]"}]}], "}"}], 
      ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"FindInfraShell", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}], " ", "->", 
           " ", "StandardGray"}], ",", " ", 
          RowBox[{
           RowBox[{"corners", "[", "g", "]"}], " ", "->", " ", 
           "StandardBlue"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"size", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
        " ", "\"\<Large\>\""}], "}"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[5]:= ",ExpressionUUID->"892ddac9-0586-4673-be75-0d02677ed6f0"],

