Cell["\<\
At every size the picture is a triangle: the sides are bundles of shortest \
paths that meet only at the corners, and no bundle is mistaken for another.\
\>", "Item",ExpressionUUID->"89e27157-e9d9-47b5-a934-9b0e72f166b9"],

Cell["\<\
Growing the substrate thins each bundle relative to its length. On the \
tilings the limit shape is visible already at the medium size; on the mesh \
the sides stay crooked, since the path metric of a mesh is not the metric of \
the plane at any finite refinement.\
\>", "Item",ExpressionUUID->"08d83925-1155-42d5-9414-d124077ac637"],

Cell["The triangle as one object", "Section",ExpressionUUID->"eafed839-4805-4e4e-af81-548e5d8ae66e"],

Cell["\<\
The union of the three sides is one inert head, and its vertex density is the \
sum of the three densities. Drawn as one object, the three sides share one \
density scale.\
\>", "Item",ExpressionUUID->"464a6cff-9f3a-4e31-948b-464115dba203"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "size", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"abc", " ", "=", " ", 
        RowBox[{"corners", " ", "@", " ", "g"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraUnion", " ", "@@", " ", 
           RowBox[{"(", 
            RowBox[{"InfraSegment", " ", "@@@", " ", 
             RowBox[{"Partition", "[", 
              RowBox[{"abc", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], 
              "]"}]}], ")"}]}], ",", " ", 
          RowBox[{"abc", " ", "->", " ", "StandardBlue"}]}], "}"}]}], "]"}]}],
      "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"size", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
        " ", "\"\<Large\>\""}], "}"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[9]:= ",ExpressionUUID->"7e17d4f0-44a9-4db1-850c-51d877c108c4"],

