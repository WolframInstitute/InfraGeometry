Cell["\<\
A side along a lattice direction, or a thin side on the mesh, is one path or \
a few, while a side in general position carries exponentially many. The sum \
of the raw counts is therefore dominated by the fattest side, and its \
normalization converges to that side alone, not to the triangle.\
\>", "Item",ExpressionUUID->"e7c056c9-dccf-4d79-96b5-4aab0a63817f"],

Cell["\<\
The breadthless triangle is the limit of the sum of the three sides each \
normalized to mass one. The counts are the measurement; the weights are the \
observer's choice.\
\>", "Item",ExpressionUUID->"4c3e6388-b470-4a2f-8107-10963ba7f0f6"],

Cell["Breadth", "Section",ExpressionUUID->"545b158e-4667-4cdf-8d82-16a53d1da87e"],

Cell[TextData[{
 "On a tiling the base point does not matter: away from the rim the graph is \
homogeneous, so one large graph suffices and the radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de615a7b-f864-44c4-8536-f70619c74dce"],
 " of the shell carrying the corners is the growing scale. The mesh refines \
instead, and is read at the shell of half its graph radius."
}], "Item",ExpressionUUID->"1f1b81ec-e094-4abc-b903-71e3d82f72a6"],

Cell["\<\
Both breadths are in units of the side length, so a breadthless side has \
breadth zero.\
\>", "Item",ExpressionUUID->"ade7f42e-5adc-4be8-88c0-507a559be215"],

Cell["The breadth of the density, the mean over the three sides.", "Text",ExpressionUUID->"507195c6-150c-4fff-ae83-641c0fcf8ef9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Join", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{
             RowBox[{"spec", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
             RowBox[{"spec", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
         "        ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"c", " ", "=", " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"GraphCenter", " ", "@", " ", "g"}]}]}], ",", " ", 
           RowBox[{"d", " ", "=", " ", 
            RowBox[{"GraphDistanceMatrix", " ", "@", " ", "g"}]}]}], "}"}], ",",
          "\n", "        ", 
         RowBox[{"Table", "[", "\n", "          ", 
          RowBox[{
           RowBox[{"With", "[", "\n", "            ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"shell", " ", "=", " ", 
               RowBox[{"FindInfraShell", "[", 
                RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]}], "}"}], ",",
              "\n", "            ", 
             RowBox[{"{", 
              RowBox[{"row", " ", "=", " ", 
               RowBox[{"end", " ", "|->", " ", 
                RowBox[{"d", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"VertexIndex", "[", 
                    RowBox[{"g", ",", " ", "end"}], "]"}], ",", " ", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"VertexIndex", "[", 
                    RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@",
                     " ", "shell"}]}], "]"}], "]"}]}]}], "}"}], ",", "\n", 
             "            ", 
             RowBox[{"{", 
              RowBox[{"a", " ", "=", " ", 
               RowBox[{"First", " ", "@", " ", "shell"}]}], "}"}], ",", "\n", 
             "            ", 
             RowBox[{"{", 
              RowBox[{"b", " ", "=", " ", 
               RowBox[{"shell", "[", 
                RowBox[{"[", 
                 RowBox[{"First", " ", "@", " ", 
                  RowBox[{"Ordering", "[", 
                   RowBox[{
                    RowBox[{"row", " ", "@", " ", "a"}], ",", " ", 
                    RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}], "}"}], ",",
              "\n", "            ", 
             RowBox[{"{", 
              RowBox[{"abc", " ", "=", " ", 
               RowBox[{"{", 
                RowBox[{"a", ",", " ", "b", ",", " ", 
                 RowBox[{"shell", "[", 
                  RowBox[{"[", 
                   RowBox[{"First", " ", "@", " ", 
                    RowBox[{"Ordering", "[", 
                    RowBox[{
                    RowBox[{"MapThread", "[", 
                    RowBox[{"Min", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"row", " ", "@", " ", "a"}], ",", " ", 
                    RowBox[{"row", " ", "@", " ", "b"}]}], "}"}]}], "]"}], ",",
                     " ", 
                    RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}], "}"}]}], 
              "}"}], ",", "\n", "            ", 
             RowBox[{"{", 
              RowBox[{"r", ",", " ", 
               RowBox[{"Last", " ", "@", " ", 
                RowBox[{"triangleBreadth", "[", 
                 RowBox[{"g", ",", " ", "abc"}], "]"}]}]}], "}"}]}], "]"}], ",",
            "\n", "          ", 
           RowBox[{"{", 
            RowBox[{"r", ",", " ", "2", ",", " ", 
             RowBox[{"spec", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], "}"}]}], "]"}]}], "]"}], ",", 
       "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"spec", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "30", ",", " ", 
             "14"}], "}"}], ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "26", ",", " ",
              "13"}], "}"}], ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "45", ",", " ", 
             "22"}], "}"}]}], "}"}]}], "}"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"Table", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"With", "[", "\n", "        ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"g", " ", "=", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
              RowBox[{"InfraSubstrate", "[", 
               RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "size"}], "]"}]}],
              ")"}]}], "}"}], ",", "\n", "        ", 
          RowBox[{"{", 
           RowBox[{"abc", " ", "=", " ", 
            RowBox[{"corners", " ", "@", " ", "g"}]}], "}"}], ",", "\n", 
          "        ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Floor", "[", 
             RowBox[{
              RowBox[{"GraphRadius", "[", "g", "]"}], "/", "2"}], "]"}], ",", 
            " ", 
            RowBox[{"Last", " ", "@", " ", 
             RowBox[{"triangleBreadth", "[", 
              RowBox[{"g", ",", " ", "abc"}], "]"}]}]}], "}"}]}], "]"}], ",", 
        "\n", "      ", 
        RowBox[{"{", 
         RowBox[{"size", ",", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
            " ", "\"\<Large\>\"", ",", " ", "0.0003"}], "}"}]}], "}"}]}], 
       "]"}], "}"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Text", "[", "\"\<r\>\"", "]"}], ",", " ", 
      RowBox[{"Text", "[", "\"\<breadth\>\"", "]"}]}], "}"}]}], ",", "\n", 
   "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"Text", " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<square\>\"", ",", " ", "\"\<triangular\>\"", ",", 
       " ", "\"\<hexagonal\>\"", ",", " ", "\"\<mesh\>\""}], "}"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"ba67a89e-8c48-4297-8fd4-7bba332257de"],

