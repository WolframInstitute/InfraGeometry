     "3b69d955-d795-40a3-886a-f4c6d01f49bd"], Cell[
    "InfraRegularPolygon[anchors,n]", "TableText",ExpressionUUID->
     "91414565-b581-4a56-9b7a-2d60ce696a2c"], Cell["\<\
Existing regular family remains; no corner-polygon overload is added.\
\>", "TableText",ExpressionUUID->"1f360276-5a72-47c4-b16f-99842094ed87"]}
  }]], "3ColumnTableMod",ExpressionUUID->"85954d48-7572-4859-86aa-\
