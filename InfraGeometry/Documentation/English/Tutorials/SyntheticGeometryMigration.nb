Cell[CellGroupData[{
Cell["Synthetic Geometry Migration", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 "The public generic representative sampler RandomInfraRepresentative is \
removed, with no compatibility alias. Choose the named sampler for the \
construction. The complete list and carrier differences are in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Named construction samplers"]], 
    "paclet:WolframInstitute/InfraGeometry/tutorial/\
NamedConstructionSamplers"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "91f87140-d232-4378-9b23-d75c9fd5c63f"],
 "."
}], "Text",ExpressionUUID->"67e2a099-7852-4eff-b8c2-05c8e1ec792e"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5572b792-b2b8-4bce-9b4e-568cbd5ca5b0"], Cell[
    "Earlier construction", "TableText",
     FontWeight->Bold,ExpressionUUID->"a254108f-3277-4b98-9e46-25e17cb04e7a"],
     Cell["Current construction", "TableText",
     FontWeight->Bold,ExpressionUUID->"1be2425c-8d37-4661-bf6d-6f4d5c79a381"],
     Cell["Compatibility", "TableText",
     FontWeight->Bold,ExpressionUUID->"f3d38285-8cc9-46b7-ad3d-1a56bc9f7eb4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "255e26ae-1763-4252-84e0-2abeb4a30aea"], Cell[
    "InfraRay[p,q]", "TableText",ExpressionUUID->
     "b8b58ab4-5069-4a53-9c5c-c306c2b234cd"], Cell[
    "InfraHalfLine[p,q]", "TableText",ExpressionUUID->
     "ec615131-9796-4822-b7ee-ae2a99a50849"], Cell["\<\
Old inert head and named sampler/predicate remain accepted for at least this \
release.\
\>", "TableText",ExpressionUUID->"1b9dda65-df06-4ea3-9b7d-450872e51774"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6ae85cfc-2701-43d0-a5a8-1c35773e1f1c"], Cell[
    "InfraLine[p,q] or InfraLine[germ]", "TableText",ExpressionUUID->
