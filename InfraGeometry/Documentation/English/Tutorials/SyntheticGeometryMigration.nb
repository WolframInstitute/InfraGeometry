Cell[CellGroupData[{
Cell["Synthetic Geometry Migration", "Title",ExpressionUUID->"b10441b7-961d-4c0c-a14d-06defe4a9cb6"],

Cell[TextData[{
 "The public generic representative sampler RandomInfraRepresentative is \
removed, with no compatibility alias. Choose the named sampler for the \
construction. The complete list and carrier differences are in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Named construction samplers"]], 
    "paclet:WolframInstitute/InfraGeometry/tutorial/\
NamedConstructionSamplers"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "c44d62ce-d68a-4346-b8b9-0fa2bc4ac796"],
 "."
}], "Text",ExpressionUUID->"4b70e786-7ab5-4c66-a751-8782927fe028"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e72cf6ab-9f97-41fb-86e9-e18ba140e9e9"], Cell[
    "Earlier construction", "TableText",
     FontWeight->Bold,ExpressionUUID->"0277e32d-fbab-49ed-934a-9f18b6f9440d"],
     Cell["Current construction", "TableText",
     FontWeight->Bold,ExpressionUUID->"187c72a3-7f06-45f8-9884-53bda63a6db7"],
     Cell["Compatibility", "TableText",
     FontWeight->Bold,ExpressionUUID->"ee63d272-7231-4ae3-9a75-f407c8f7b713"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d238e5ae-c999-4845-b412-9c47d1fcc9d7"], Cell[
    "InfraRay[p,q]", "TableText",ExpressionUUID->
     "10604c72-a004-4114-85bb-c86463ec87ab"], Cell[
    "InfraHalfLine[p,q]", "TableText",ExpressionUUID->
     "7e77d9d1-c018-4028-acb0-b9a7af70d2a2"], Cell["\<\
Old inert head and named sampler/predicate remain accepted for at least this \
release.\
\>", "TableText",ExpressionUUID->"54d5b26b-b944-44ca-8df7-7f968182349b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7c053595-87ab-408d-904c-e222ef77dbb8"], Cell[
    "InfraLine[p,q] or InfraLine[germ]", "TableText",ExpressionUUID->
     "932b8ee1-28f3-4dac-9d4c-f0ad77e06a83"], Cell[
    "InfraInfiniteLine[p,q] or InfraInfiniteLine[germ]", "TableText",
     ExpressionUUID->"9b9b2d34-3bf9-43ce-a294-85951de8093f"], Cell["\<\
Finite maximal shortest-path meaning and germ overload remain.\
\>", "TableText",ExpressionUUID->"82b8a0f5-c87a-4e59-8c3c-d021df90bdce"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "badaafee-5d36-41e8-ad26-f4ab480ca06b"], Cell[
