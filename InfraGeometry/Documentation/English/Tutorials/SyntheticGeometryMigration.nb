Cell["\<\
Do not rewrite inside vertex labels. A bare sampler and its token overload \
can have different carriers and traversal laws. In particular, bare regular \
polygons give directed Graph legs; tokens give ordered vertex sequences. Bare \
geodesics give position-spelled Graphs; tokens give ordered sequences. Bare \
half-line and infinite-line traversal laws remain distinct from their token \
DAG-family sampling.\
\>", "Text",ExpressionUUID->"f7c38976-a4dd-449f-84bc-8e37e7a47a1b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"PathGraph", "[", " ", 
       RowBox[{"Range", "[", " ", "5", " ", "]"}], " ", "]"}]}], " ", "}"}], ",",
     "\n", "  ", 
    RowBox[{"RandomInfraHalfLine", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"InfraHalfLine", "[", " ", 
       RowBox[{"2", ",", " ", "3"}], " ", "]"}], ",", " ", "All"}], " ", 
     "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d8b19b94-552b-4eec-aa5b-774639d110b5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"2", ",", "3", ",", "4", ",", "5"}], "}"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a7ccc3ba-64e1-42d4-95ee-df4d2e371ae7"]
}, Open  ]],

Cell["\<\
Counts enumerate representatives, not support vertices. A singleton region \
has one representative even when its set is empty. A decided empty point \
family has no representatives. An unsupported call remains unevaluated and \
must not be interpreted as an empty family.\
\>", "Text",ExpressionUUID->"9766edc9-eb2e-46ee-a273-6934473f830a"],

Cell["\<\
The midpoint is the central layer, or two central layers, of the oriented \
segment graph. Its vertex density retains the shortest-path occupation \
counts. The older segment \"Midpoint\" measurement retains middle-layer \
density and can contain two layers.\
\>", "Text",ExpressionUUID->"1c9cfd45-3c92-4370-8352-3cc0a0cdb182"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"PathGraph", "[", " ", 
       RowBox[{"Range", "[", " ", "2", " ", "]"}], " ", "]"}]}], " ", "}"}], ",",
     "\n", "  ", 
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"RandomInfraMidpoint", "[", " ", 
       RowBox[{"graph", ",", " ", "1", ",", " ", "2", ",", " ", "All"}], " ", 
       "]"}], ",", "\n", "    ", 
      RowBox[{"InfraMeasurement", "[", " ", 
       RowBox[{"graph", ",", " ", 
        RowBox[{"InfraSegment", "[", " ", 
         RowBox[{"1", ",", " ", "2"}], " ", "]"}], ",", 
        " ", "\"\<Midpoint\>\""}], " ", "]"}]}], " ", "}"}]}], " ", 
   "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ee3ae190-b868-469a-8c1a-4cb90c26c833"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"1", "\[Rule]", "1"}], ",", 
     RowBox[{"2", "\[Rule]", "1"}]}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"cf8b2df8-32d5-48d4-8258-89f0779e05c9"]
}, Open  ]],

Cell["\<\
The exact perpendicular-bisector head is the finite equidistant locus. It \
need not be a separating plane or a line. Nearest-point families retain every \
finite-distance tie. Their supported measures inherit existing counting and \
interior-support laws; no Area or Volume property is added.\
\>", "Text",ExpressionUUID->"f8056874-c612-4b45-bf49-66c419deb87e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"PathGraph", "[", " ", 
       RowBox[{"Range", "[", " ", "3", " ", "]"}], " ", "]"}]}], " ", "}"}], ",",
     "\n", "  ", 
    RowBox[{"InfraSubstrateHighlight", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"{", " ", 
       RowBox[{
        RowBox[{"InfraRegionNearest", "[", " ", 
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{"1", ",", " ", "3"}], " ", "}"}], ",", " ", "2"}], " ", 
         "]"}], ",", " ", "2"}], " ", "}"}]}], " ", "]"}]}], " ", 
   "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"f955cc9c-0eae-4246-a90e-994334a2990c"],

