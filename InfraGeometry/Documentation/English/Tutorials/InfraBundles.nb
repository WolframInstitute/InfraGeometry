Cell["\<\
The multiplicity reader returns an association from each total vertex to an \
association of adjacent base vertices and their counts. Zero counts record \
missing lifts. Vertical neighbours are excluded. A total vertex over an \
isolated base vertex has an empty inner association.\
\>", "Text",ExpressionUUID->"8e741fa1-9ec7-4db9-9e0e-04fccfebf663"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b120e05b-3e6e-4d2d-a199-74443c964737"], Cell["Condition", "TableText",
     FontWeight->Bold,ExpressionUUID->"f01a1dfb-2387-4774-9430-e1a59f4ce56f"],
     Cell["Finite meaning", "TableText",
     FontWeight->Bold,ExpressionUUID->"7ba29188-743c-4601-ae2c-0a34a68b69e2"],
     Cell["Reader", "TableText",
