   {Cell["      ", "ModInfo",ExpressionUUID->
     "e533c11e-328a-4aef-bc3b-c70ca3a36a15"], Cell[
    "Weak graph continuity", "TableText",ExpressionUUID->
     "446af3b9-7494-4ce5-b21f-e553c400408b"], Cell["\<\
Every total edge projects to a base edge or a vertex; automatic for the \
reconstructed base\
\>", "TableText",ExpressionUUID->"b43aeb75-ce8d-40b0-8a8a-37b2a8522b4d"], 
    Cell["InfraFiberedGraphQ", "TableText",ExpressionUUID->
     "922ecff5-d054-42d5-bbda-11b4b42e2912"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
