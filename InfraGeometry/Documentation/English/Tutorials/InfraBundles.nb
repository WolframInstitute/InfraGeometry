  }]], "2ColumnTableMod",ExpressionUUID->"fa669005-6358-4961-b6d0-\
47fb9fca7af1"],

Cell["\<\
The projection may be an association or a function. Association keys are \
literal total vertices; lists are allowed as individual labels.\
\>", "Text",ExpressionUUID->"794d1242-bb04-49ad-acf1-eb03cc184511"],

Cell["\<\
A cycle wraps twice around its reconstructed square base. The marked vertices \
form one fiber.\
\>", "Text",ExpressionUUID->"d49a7241-b367-4679-9da6-86e607e3f1c7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}], ",", " ", 
       RowBox[{"vertex", " ", "|->", " ", 
        RowBox[{"Mod", "[", " ", 
         RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
      " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", " ", 
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"{", " ", 
         RowBox[{"InfraFiber", "[", " ", 
          RowBox[{"fib", ",", " ", "1"}], " ", "]"}], " ", "}"}]}], " ", 
       "]"}], ",", "\n", "    ", 
      RowBox[{"InfraTotalSpace", "[", " ", "fib", " ", "]"}], ",", " ", 
      RowBox[{"InfraBaseSpace", "[", " ", "fib", " ", "]"}]}], " ", "}"}], 
    " ", "]"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5c52ff82-eeae-4eb0-a9db-5f54feb9f099"],

