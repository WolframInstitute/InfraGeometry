Cell[TextData[{
 "Scalar edge caps intersect the property-feasible interval. Exact counts and \
ranges must fit every permitted fiber size; they are never clipped. Count \
draws are uniform on their admissible interval; graph samples are not \
asserted uniform. See ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraFiberedGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFiberedGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7f00c285-f11f-4105-b538-e62c7a9a97d9"],
 " for the joint size and edge-count constraints."
}], "Text",ExpressionUUID->"ffda2e98-e51f-4a41-b959-b0464f6259d9"],

Cell["\<\
The first graph has independent fiber sizes. The second has isomorphic fibers \
and lift existence. The third is a graph bundle.\
\>", "Text",ExpressionUUID->"ccdc8660-e2f6-44d1-892a-e79277273dd8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"base", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "6", " ", "]"}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"GraphicsRow", "[", " ", 
    RowBox[{"InfraFiberedGraphHighlight", " ", "/@", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"RandomInfraFiberedGraph", "[", " ", 
        RowBox[{"base", ",", " ", 
         RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
          RowBox[{"{", " ", 
           RowBox[{"2", ",", " ", "4"}], " ", "}"}]}], ",", " ", 
         RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}], ",", 
       "\n", "    ", 
       RowBox[{"RandomInfraFiberedGraph", "[", " ", 
        RowBox[{"base", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", " ", 
           
           RowBox[{"\"\<IsomorphicFibers\>\"", ",", 
            " ", "\"\<Fibration\>\""}], " ", "}"}]}], ",", "\n", "      ", 
         RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
          RowBox[{"{", " ", "3", " ", "}"}]}], ",", " ", 
         RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", 
          RowBox[{"{", " ", "2", " ", "}"}]}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}], ",", 
       "\n", "    ", 
       RowBox[{"RandomInfraFiberedGraph", "[", " ", 
        RowBox[{"base", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", " ", "\"\<FiberBundle\>\"", " ", "}"}]}], ",", "\n", 
         "      ", 
         RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
          RowBox[{"{", " ", "3", " ", "}"}]}], ",", " ", 
         RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", 
          RowBox[{"{", " ", "2", " ", "}"}]}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}]}], " ", 
      "}"}]}], " ", "]"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"68f531b9-63bd-479b-845c-fea1c6da1ebd"],

