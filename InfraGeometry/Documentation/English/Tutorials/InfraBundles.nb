Cell["\<\
The viewer fixes the structure and layout when created. Hovering a base \
vertex inspects its fiber; hovering a base edge inspects supplied section and \
connection edges above it. Live hovering requires the notebook front end.\
\>", "Text",ExpressionUUID->"f2961f9c-8e32-433e-b3f3-d40888362d25"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "6", " ", "]"}], ",", "\n", "    ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "2", " ", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"connection", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphViewer", "[", " ", 
    RowBox[{"fib", ",", " ", "connection"}], " ", "]"}]}], " ", 
  "]"}]}], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"378768fe-fd2a-4430-8b5d-495efe2e81c7"],

