  }]], "2ColumnTableMod",ExpressionUUID->"d8512c53-cf80-4367-91e3-\
76d69bd1efec"],

Cell["\<\
The projection may be an association or a function. Association keys are \
literal total vertices; lists are allowed as individual labels.\
\>", "Text",ExpressionUUID->"402ed436-454f-4bc0-abb2-ebf2b5f4f83e"],

Cell["\<\
A cycle wraps twice around its reconstructed square base. The marked vertices \
form one fiber.\
\>", "Text",ExpressionUUID->"d6defe0c-e6ab-420e-afc7-c1cb8eaaa445"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}], ",", " ", 
       RowBox[{"vertex", " ", "|->", " ", 
        RowBox[{"Mod", "[", " ", 
         RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
      " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", " ", 
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"{", " ", 
         RowBox[{"InfraFiber", "[", " ", 
          RowBox[{"fib", ",", " ", "1"}], " ", "]"}], " ", "}"}]}], " ", 
       "]"}], ",", "\n", "    ", 
      RowBox[{"InfraTotalSpace", "[", " ", "fib", " ", "]"}], ",", " ", 
      RowBox[{"InfraBaseSpace", "[", " ", "fib", " ", "]"}]}], " ", "}"}], 
    " ", "]"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"14cdbb96-a3ec-4b81-b382-caf0978f8364"],

