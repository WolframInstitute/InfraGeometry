Cell[TextData[{
 "Scalar edge caps intersect the property-feasible interval. Exact counts and \
ranges must fit every permitted fiber size; they are never clipped. Count \
draws are uniform on their admissible interval; graph samples are not \
asserted uniform. See ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraFiberedGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFiberedGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a7508e6e-2a21-4b58-99b2-c9d753d7721b"],
 " for the joint size and edge-count constraints."
}], "Text",ExpressionUUID->"c56fb2f6-d7d1-4b2e-bb91-7be7a535e520"],

Cell["\<\
The first graph has independent fiber sizes. The second has isomorphic fibers \
and lift existence. The third is a graph bundle.\
\>", "Text",ExpressionUUID->"25dcbb7a-154c-4300-ab31-6bdf81cfd2f6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"base", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "6", " ", "]"}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"GraphicsRow", "[", " ", 
    RowBox[{"InfraFiberedGraphHighlight", " ", "/@", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"RandomInfraFiberedGraph", "[", " ", 
        RowBox[{"base", ",", " ", 
         RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
          RowBox[{"{", " ", 
           RowBox[{"2", ",", " ", "4"}], " ", "}"}]}], ",", " ", 
         RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}], ",", 
       "\n", "    ", 
       RowBox[{"RandomInfraFiberedGraph", "[", " ", 
        RowBox[{"base", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", " ", 
           
           RowBox[{"\"\<IsomorphicFibers\>\"", ",", 
            " ", "\"\<Fibration\>\""}], " ", "}"}]}], ",", "\n", "      ", 
         RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
          RowBox[{"{", " ", "3", " ", "}"}]}], ",", " ", 
         RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", 
          RowBox[{"{", " ", "2", " ", "}"}]}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}], ",", 
       "\n", "    ", 
       RowBox[{"RandomInfraFiberedGraph", "[", " ", 
        RowBox[{"base", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", " ", "\"\<FiberBundle\>\"", " ", "}"}]}], ",", "\n", 
         "      ", 
         RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
          RowBox[{"{", " ", "3", " ", "}"}]}], ",", " ", 
         RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", 
          RowBox[{"{", " ", "2", " ", "}"}]}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}]}], " ", 
      "}"}]}], " ", "]"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"eb50a4d8-7b37-40b1-aaf0-82cec1deb5d9"],

