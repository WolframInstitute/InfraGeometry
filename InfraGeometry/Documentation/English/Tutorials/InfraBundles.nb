     "f3d2a973-bcc1-4eda-ba22-a527c9500f03"], Cell["\<\
Isomorphic fibers and unique lifts whose matchings preserve vertical adjacency\
\>", "TableText",ExpressionUUID->"18e6514d-7f5e-4d98-88b0-dfc281bc852d"], 
    Cell["InfraFiberBundleQ", "TableText",ExpressionUUID->
     "cd2f3060-0da7-459b-9349-26fe09708610"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
