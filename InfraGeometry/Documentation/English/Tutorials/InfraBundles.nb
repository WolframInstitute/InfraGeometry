            RowBox[{"{", " ", 
             RowBox[{"3", ",", " ", "5"}], " ", "}"}], ",", " ", 
            RowBox[{"{", " ", 
             RowBox[{"3", ",", " ", "6"}], " ", "}"}]}], " ", "}"}]}]}], " ", 
        "]"}], ",", "\n", "    ", 
       RowBox[{"<|", " ", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<q\>\""}], ",", " ", 
         RowBox[{"5", " ", "->", " ", "\"\<q\>\""}], ",", " ", 
         RowBox[{"6", " ", "->", " ", "\"\<q\>\""}]}], " ", "|>"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", " ", "fib", " ", "]"}], ",", 
     " ", 
