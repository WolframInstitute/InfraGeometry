Cell[TextData[{
 "Existing literal objects remain accepted by the readers and operations. The \
earlier random generator retains its distinct option grammar as Experimental \
compatibility functionality. Particular geometric models and scale or \
completion questions are treated in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Experimental Infra Bundles"]], 
    "paclet:WolframInstitute/InfraGeometry/tutorial/ExperimentalInfraBundles"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "485bfaf2-5525-4687-b4c0-b0c2101469ba"],
 "."
}], "Text",ExpressionUUID->"a4cc0e26-1d2c-4430-877b-ec70a748aa54"],

