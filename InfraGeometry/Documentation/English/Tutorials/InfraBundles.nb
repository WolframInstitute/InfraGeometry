b4c7d5d1514c"],

Cell[TextData[{
 "Scalar edge caps intersect the property-feasible interval. Exact counts and \
ranges must fit every permitted fiber size; they are never clipped. Count \
draws are uniform on their admissible interval; graph samples are not \
asserted uniform. See ",
 Cell[BoxData["RandomInfraFiberedGraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2e8beb2-2d1a-4849-bec1-b59f163077c3"],
 " for the joint size and edge-count constraints."
}], "Text",ExpressionUUID->"2617b8fa-0fe1-432b-87b3-6472678be200"],

Cell["\<\
The first graph has independent fiber sizes. The second has isomorphic fibers \
and lift existence. The third is a graph bundle.\
\>", "Text",ExpressionUUID->"272b59f1-17b5-4bb8-ba1f-f4cb6834d8bb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"base", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "6", " ", "]"}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"GraphicsRow", "[", " ", 
    RowBox[{"InfraFiberedGraphHighlight", " ", "/@", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"RandomInfraFiberedGraph", "[", " ", 
        RowBox[{"base", ",", " ", 
         RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
          RowBox[{"{", " ", 
           RowBox[{"2", ",", " ", "4"}], " ", "}"}]}], ",", " ", 
         RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", "2"}]}], " ", 
        "]"}], ",", "\n", "    ", 
       RowBox[{"RandomInfraFiberedGraph", "[", " ", 
        RowBox[{"base", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", " ", 
           
           RowBox[{"\"\<IsomorphicFibers\>\"", ",", 
            " ", "\"\<Fibration\>\""}], " ", "}"}]}], ",", "\n", "      ", 
         RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
          RowBox[{"{", " ", "3", " ", "}"}]}], ",", " ", 
         RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", 
          RowBox[{"{", " ", "2", " ", "}"}]}]}], " ", "]"}], ",", "\n", 
       "    ", 
       RowBox[{"RandomInfraFiberedGraph", "[", " ", 
        RowBox[{"base", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", " ", "\"\<FiberBundle\>\"", " ", "}"}]}], ",", "\n", 
         "      ", 
         RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
          RowBox[{"{", " ", "3", " ", "}"}]}], ",", " ", 
         RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", 
