   {Cell["      ", "ModInfo",ExpressionUUID->
     "9a3f366d-4e4e-49ba-b68f-87f87861356a"], Cell[
    "Weak graph continuity", "TableText",ExpressionUUID->
     "b0cc0070-9718-423d-8c81-745da46406ef"], Cell["\<\
Every total edge projects to a base edge or a vertex; automatic for the \
reconstructed base\
\>", "TableText",ExpressionUUID->"449a666a-a245-4e33-9e69-5da0e543d6c4"], 
    Cell["InfraFiberedGraphQ", "TableText",ExpressionUUID->
     "cc075870-c40e-4fd0-b401-65bc8e0e2e31"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
