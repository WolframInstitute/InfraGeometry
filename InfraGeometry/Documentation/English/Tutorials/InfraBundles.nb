c09b3cf8e6a3"],

Cell[TextData[{
 "Scalar edge caps intersect the property-feasible interval. Exact counts and \
ranges must fit every permitted fiber size; they are never clipped. Count \
draws are uniform on their admissible interval; graph samples are not \
asserted uniform. See ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraFiberedGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFiberedGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c735b508-83ca-4fe7-a9e7-13d421765c9a"],
 " for the joint size and edge-count constraints."
}], "Text",ExpressionUUID->"4ac8e99e-f812-4db3-99d7-9518919c3ae5"],

Cell["\<\
The first graph has independent fiber sizes. The second has isomorphic fibers \
and lift existence. The third is a graph bundle.\
\>", "Text",ExpressionUUID->"87343283-1658-4656-ba25-aba599690a1c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"base", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "6", " ", "]"}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"GraphicsRow", "[", " ", 
    RowBox[{"InfraFiberedGraphHighlight", " ", "/@", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"RandomInfraFiberedGraph", "[", " ", 
        RowBox[{"base", ",", " ", 
         RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
          RowBox[{"{", " ", 
           RowBox[{"2", ",", " ", "4"}], " ", "}"}]}], ",", " ", 
         RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}], ",", 
       "\n", "    ", 
       RowBox[{"RandomInfraFiberedGraph", "[", " ", 
        RowBox[{"base", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", " ", 
           
           RowBox[{"\"\<IsomorphicFibers\>\"", ",", 
            " ", "\"\<Fibration\>\""}], " ", "}"}]}], ",", "\n", "      ", 
         RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
          RowBox[{"{", " ", "3", " ", "}"}]}], ",", " ", 
         RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", 
          RowBox[{"{", " ", "2", " ", "}"}]}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}], ",", 
       "\n", "    ", 
       RowBox[{"RandomInfraFiberedGraph", "[", " ", 
        RowBox[{"base", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", " ", "\"\<FiberBundle\>\"", " ", "}"}]}], ",", "\n", 
         "      ", 
         RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
          RowBox[{"{", " ", "3", " ", "}"}]}], ",", " ", 
         RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", 
          RowBox[{"{", " ", "2", " ", "}"}]}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}]}], " ", 
      "}"}]}], " ", "]"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"b46c8a09-fced-4e9b-95fb-a3eeca22c451"],

