     "b70592d0-a5d3-4751-906e-cae32444eb9b"]}
  }]], "2ColumnTableMod",ExpressionUUID->"5fbee5aa-b5e7-4a6e-ba0f-\
b2260778dfaf"],

Cell["\<\
The projection may be an association or a function. Association keys are \
literal total vertices; lists are allowed as individual labels.\
\>", "Text",ExpressionUUID->"6a7d8ac2-2a72-4d6b-b54a-d106dc9b35ef"],

Cell["\<\
A cycle wraps twice around its reconstructed square base. The marked vertices \
form one fiber.\
\>", "Text",ExpressionUUID->"bb202664-220c-429e-858b-0a8c3d9ce5b5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}], ",", " ", 
       RowBox[{"vertex", " ", "|->", " ", 
        RowBox[{"Mod", "[", " ", 
         RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
      " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", " ", 
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"{", " ", 
         RowBox[{"InfraFiber", "[", " ", 
          RowBox[{"fib", ",", " ", "1"}], " ", "]"}], " ", "}"}]}], " ", 
       "]"}], ",", "\n", "    ", 
      RowBox[{"InfraTotalSpace", "[", " ", "fib", " ", "]"}], ",", " ", 
      RowBox[{"InfraBaseSpace", "[", " ", "fib", " ", "]"}]}], " ", "}"}], 
    " ", "]"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"616b0c55-3476-4f1c-bc19-6b7ef6f2238b"],

