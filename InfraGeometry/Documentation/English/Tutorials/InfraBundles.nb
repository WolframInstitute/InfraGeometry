     "54cc4aee-ca72-47c8-9ac2-671752827e35"], Cell["\<\
Every multiplicity is positive; the project's weak fibration condition\
\>", "TableText",ExpressionUUID->"94ef1025-4b60-4916-b7ad-cd0a1de60ff6"], 
    Cell["InfraFibrationQ", "TableText",ExpressionUUID->
     "bc15d496-6066-4e76-9dff-5f25cc58c00e"]},
