Cell[TextData[{
 "The retained flat-connection predicate tests ",
 StyleBox["trivial global monodromy", "TI"],
 ": every closed base walk acts identically. This is equivalent to every \
horizontal leaf projecting injectively. Indeed, two vertices in one leaf over \
the same base vertex give a lifted closed walk between them. Conversely, a \
closed walk with distinct lift endpoints places two such vertices in one leaf."
}], "Text",ExpressionUUID->"27900c4c-9f88-4aa6-b94d-112b4c39eea2"],

Cell["\<\
Curvature needs a specified family of faces and their boundary loops. A graph \
alone supplies no such family. The global monodromy predicate therefore does \
not replace a face-based curvature definition.\
\>", "Text",ExpressionUUID->"2ce3ab04-8f15-403e-8a53-7d755f085bfa"],

Cell["Three views of one object", "Section",ExpressionUUID->"b109fcc4-92e3-474f-84ce-4dba2dc2b3c0"],

Cell["\<\
Circular fibers, upright three-dimensional fibers and the total graph's own \
layout display the same finite object. Highlights preserve their meaning in \
every view.\
\>", "Text",ExpressionUUID->"fc7edfbd-8364-46f3-b8f0-0789f227ae0c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "6", " ", "]"}], ",", "\n", "    ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "3", " ", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"section", " ", "=", " ", 
      RowBox[{"RandomInfraSection", "[", " ", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", " ", "\"\<Continuous\>\"", " ", "}"}]}], ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}]}], ",", 
     "\n", "    ", 
     RowBox[{"connection", " ", "=", " ", 
      RowBox[{"RandomInfraConnection", "[", " ", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}]}]}], " ",
     "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", " ", 
    RowBox[{"Map", "[", " ", 
     RowBox[{
      RowBox[{"method", " ", "|->", " ", 
       RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
        RowBox[{"fib", ",", " ", 
         RowBox[{"{", " ", 
          RowBox[{"section", ",", " ", "connection"}], " ", "}"}], ",", " ", 
         RowBox[{"Method", " ", "->", " ", "method"}]}], " ", "]"}]}], ",", 
      "\n", "    ", 
      RowBox[{"{", " ", 
       RowBox[{"\"\<CircularFiber\>\"", ",", " ", "\"\<3DFiber\>\"", ",", 
        " ", "\"\<HighlightFiber\>\""}], " ", "}"}]}], " ", "]"}], " ", 
    "]"}]}], " ", "]"}]}], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"e36ea875-dfed-4e8c-b64f-fd13e99608ed"],

