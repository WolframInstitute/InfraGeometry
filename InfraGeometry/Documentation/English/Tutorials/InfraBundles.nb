Cell["Sections and extensions", "Section",ExpressionUUID->"2db183c3-b509-412d-b6be-a56cb40d490f"],

Cell[TextData[{
 "A ",
 StyleBox["section on a domain", "TI"],
 " chooses one total vertex over each base vertex in that domain. It is ",
 StyleBox["continuous", "TI"],
 " when every base edge within the domain maps to a total edge. A partial \
section fixes values to be preserved by an extension."
}], "Text",ExpressionUUID->"a00778ef-1cc7-4838-b40b-87144af99791"],

Cell["\<\
The default section class is set-theoretic on every overload. A domain list \
restricts the target; an inert section supplies prescribed values and \
requests extension over the whole base. The continuous property is requested \
explicitly.\
\>", "Text",ExpressionUUID->"d05db7e6-d76b-4d89-a385-055c160cee61"],

Cell["\<\
Complete joins let a partial section extend continuously in every choice of \
the remaining fibers.\
\>", "Text",ExpressionUUID->"4fecda40-b908-495b-8692-4cc36cd96bfc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "6", " ", "]"}], ",", "\n", "    ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "3", " ", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"partial", " ", "=", " ", 
     RowBox[{"RandomInfraSection", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"1", ",", " ", "3"}], " ", "}"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"section", " ", "=", " ", 
     RowBox[{"RandomInfraSection", "[", " ", 
      RowBox[{"fib", ",", " ", "partial", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", " ", "\"\<Continuous\>\"", " ", "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", " ", 
      RowBox[{"partial", ",", " ", "section"}], " ", "}"}]}], " ", "]"}]}], 
  " ", "]"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"c6637db0-b724-44fc-838e-317ddf83a881"],

