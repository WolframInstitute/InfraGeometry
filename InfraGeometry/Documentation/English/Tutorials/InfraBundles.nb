Cell["\<\
If all fibers are mutually isomorphic and the selected matchings preserve \
their adjacency, the vertical edges and selected transverse edges form a \
graph bundle. A raw fibered graph may contain additional transverse edges, so \
this statement concerns the selected subgraph.\
\>", "Text",ExpressionUUID->"24bdd71e-e814-4f01-9efb-4d784792ef6d"],

Cell["Twisting and holonomy", "Section",ExpressionUUID->"07def00d-7fd4-4262-b730-77ed7bc64307"],

Cell[TextData[{
 "The ",
 StyleBox["holonomy", "TI"],
 " of a closed base walk is the permutation produced by transport around it. \
Permutation positions refer to the vertex order of the starting fiber. A \
one-vertex loop gives the identity."
}], "Text",ExpressionUUID->"c76d5e92-3538-4345-baba-afffe9d9d7b9"],

Cell["\<\
A graph bundle can be twisted. Both graphs below cover the same square with \
two points per fiber. The product has two horizontal leaves; the connected \
double cover exchanges the two points after one base circuit.\
\>", "Text",ExpressionUUID->"1306769f-6cc0-4123-bdcc-030300abf010"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"product", " ", "=", " ", 
      RowBox[{"InfraFiberedGraph", "[", " ", 
       RowBox[{
        RowBox[{"GraphProduct", "[", " ", 
         RowBox[{
          RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}], ",", " ", 
          RowBox[{"Graph", "[", " ", 
           RowBox[{
            RowBox[{"{", " ", 
             RowBox[{"1", ",", " ", "2"}], " ", "}"}], ",", " ", 
            RowBox[{"{", " ", "}"}]}], " ", "]"}], ",", 
          " ", "\"\<Cartesian\>\""}], " ", "]"}], ",", " ", "First"}], " ", 
       "]"}]}], ",", "\n", "    ", 
     RowBox[{"twisted", " ", "=", " ", 
      RowBox[{"InfraFiberedGraph", "[", " ", 
       RowBox[{
        RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}], ",", " ", 
        RowBox[{"vertex", " ", "|->", " ", 
         RowBox[{"Mod", "[", " ", 
          RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
       " ", "]"}]}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", " ", 
    RowBox[{"Map", "[", " ", 
     RowBox[{
      RowBox[{"fib", " ", "|->", " ", 
       RowBox[{"With", "[", " ", 
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{"connection", " ", "=", " ", 
           RowBox[{"InfraConnection", "[", " ", 
            RowBox[{"EdgeList", " ", "@", " ", 
             RowBox[{"InfraTotalSpace", "[", " ", "fib", " ", "]"}]}], " ", 
            "]"}]}], " ", "}"}], ",", "\n", "    ", 
         RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
          RowBox[{"fib", ",", " ", "connection"}], " ", "]"}]}], " ", "]"}]}],
       ",", " ", 
      RowBox[{"{", " ", 
       RowBox[{"product", ",", " ", "twisted"}], " ", "}"}]}], " ", "]"}], 
    " ", "]"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"0d01c52e-bc53-4eb4-a3b7-f87c291da20f"],

