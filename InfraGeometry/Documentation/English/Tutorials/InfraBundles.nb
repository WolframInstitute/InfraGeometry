   {Cell["      ", "ModInfo",ExpressionUUID->
     "01196f42-f67c-4b2a-a959-988bdf18829d"], Cell[
    "Weak graph continuity", "TableText",ExpressionUUID->
     "e7d47530-beed-439c-a0e1-eb5c7c4fbef6"], Cell["\<\
Every total edge projects to a base edge or a vertex; automatic for the \
reconstructed base\
\>", "TableText",ExpressionUUID->"40e7c5fa-7802-48cf-8455-125abc17b99e"], 
    Cell["InfraFiberedGraphQ", "TableText",ExpressionUUID->
     "d2e4cc75-77f0-4ce8-8242-243d0071efce"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "12decaf7-db6b-47ba-9ea8-a092aced1e18"], Cell[
    "Equal fiber sizes", "TableText",ExpressionUUID->
     "5ef7b835-2f69-4659-8a54-1b0dfad187c4"], Cell["\<\
Every fiber has the same cardinality, including across base components\
\>", "TableText",ExpressionUUID->"e000742c-f147-4b14-ac57-98fb9b86430a"], 
    Cell["InfraEqualFiberSizesQ", "TableText",ExpressionUUID->
     "b0069678-5acd-4dd6-ba20-93487ec2a455"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4c1630de-f5ce-4146-8016-48d0ef90bde0"], Cell[
    "Isomorphic fibers", "TableText",ExpressionUUID->
     "a709bc0b-c744-455c-b195-42ca0997b33c"], Cell[
    "All induced fiber graphs are mutually isomorphic", "TableText",
     ExpressionUUID->"7398620a-23a0-41fe-baf7-e836f01d61d5"], Cell[
    "InfraIsomorphicFibersQ", "TableText",ExpressionUUID->
     "a2617a3e-1775-4166-bafa-6a961af33e23"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "febf6093-bbac-46dc-881f-8dc2a8a016de"], Cell[
    "Local surjectivity on transverse neighbours", "TableText",ExpressionUUID->
     "31fd27e0-b3e0-40d5-9e08-7ce064a77792"], Cell["\<\
Every multiplicity is positive; the project's weak fibration condition\
\>", "TableText",ExpressionUUID->"3daf381a-1624-4c3b-b277-9571d20667e8"], 
    Cell["InfraFibrationQ", "TableText",ExpressionUUID->
     "d7d2b73c-4e70-4b80-b11e-dbb7e6831622"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "186a9f07-0210-48dd-b785-8686b60b2735"], Cell[
    "Local injectivity on transverse neighbours", "TableText",ExpressionUUID->
     "14b38efd-9ef9-4ca0-9c86-24b129cca28e"], Cell[
    "Every multiplicity is at most one", "TableText",ExpressionUUID->
     "a3edcf3f-c51e-42e6-8179-5e6a276e9482"], Cell[
    "InfraAtMostOneEdgeLiftQ", "TableText",ExpressionUUID->
     "ca99f567-9080-4d8e-8a94-d28161438fd0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "73ba28be-af5d-43c1-b8a8-3c9741f6d717"], Cell[
    "Unique edge lifting", "TableText",ExpressionUUID->
     "1d3567b5-ee7f-4d77-8a56-a60a0a186568"], Cell[
    "Every multiplicity is one", "TableText",ExpressionUUID->
     "4b4bd709-ca3c-4578-a6fb-1c8297f8b8ce"], Cell[
