    "Isomorphic fibers", "TableText",ExpressionUUID->
     "3253a354-3253-4c2e-ab91-30fa58d8934d"], Cell[
    "All induced fiber graphs are mutually isomorphic", "TableText",
     ExpressionUUID->"fcc811b7-f13b-457f-ade6-be64b8932598"], Cell[
    "InfraIsomorphicFibersQ", "TableText",ExpressionUUID->
     "b36e235a-7a43-4f1c-8bf7-839377ef5f5b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2365da01-e94f-4f56-bc58-7d29bc14aaee"], Cell[
    "Local surjectivity on transverse neighbours", "TableText",ExpressionUUID->
     "0cd9d04e-6a98-4cd0-ac04-bd202b378457"], Cell["\<\
Every multiplicity is positive; the project's weak fibration condition\
\>", "TableText",ExpressionUUID->"f8caaa07-6273-467e-b366-fd9d8a6b412f"], 
    Cell["InfraFibrationQ", "TableText",ExpressionUUID->
     "0baae92f-a45b-4a7a-80c6-9acd0b990299"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "85ec1cc7-d6ad-4e54-aa73-59156e7229de"], Cell[
    "Local injectivity on transverse neighbours", "TableText",ExpressionUUID->
     "fc343f2e-b21e-4191-8756-48bb120061d3"], Cell[
    "Every multiplicity is at most one", "TableText",ExpressionUUID->
     "545434ae-1b11-4b40-a00c-7e411b468ab7"], Cell[
    "InfraAtMostOneEdgeLiftQ", "TableText",ExpressionUUID->
     "590ea49c-00f7-41f0-99ef-078af49bc04f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "950bd93d-92b0-47f0-86f0-6f7118396664"], Cell[
    "Unique edge lifting", "TableText",ExpressionUUID->
