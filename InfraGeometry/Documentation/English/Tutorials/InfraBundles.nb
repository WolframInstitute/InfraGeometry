    "Equal fiber sizes", "TableText",ExpressionUUID->
     "135eae5f-d4c2-4544-8950-a6590ed06eb3"], Cell["\<\
Every fiber has the same cardinality, including across base components\
\>", "TableText",ExpressionUUID->"9d960d83-c96e-42c8-8a49-bab06a2852f6"], 
    Cell["InfraEqualFiberSizesQ", "TableText",ExpressionUUID->
     "fb4e04f1-601f-4ef4-9240-9f98b003c990"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "faddcc95-e373-4c04-93ab-fab6fe215f14"], Cell[
    "Isomorphic fibers", "TableText",ExpressionUUID->
     "ac06ad2e-90aa-41a9-970a-5855e09c5fc1"], Cell[
    "All induced fiber graphs are mutually isomorphic", "TableText",
     ExpressionUUID->"26309923-363d-46c1-9ba0-68c8d379ac5a"], Cell[
    "InfraIsomorphicFibersQ", "TableText",ExpressionUUID->
     "fc531312-57e9-4fa1-aef8-69dab053b888"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "db226298-68ce-45f3-b198-a693e95146f4"], Cell[
    "Local surjectivity on transverse neighbours", "TableText",ExpressionUUID->
     "3ca85cd8-11b8-4489-aa19-1e8ae38030ee"], Cell["\<\
Every multiplicity is positive; the project's weak fibration condition\
\>", "TableText",ExpressionUUID->"c2357b32-e3e9-49c4-94c1-67490b7602e4"], 
    Cell["InfraFibrationQ", "TableText",ExpressionUUID->
     "06eb1659-7616-4adf-9d63-c948337d4c29"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "24b5a9d2-fd35-4872-a0b6-26c503d43425"], Cell[
    "Local injectivity on transverse neighbours", "TableText",ExpressionUUID->
     "f04fd30c-289d-4d63-bdbf-2e9408658530"], Cell[
    "Every multiplicity is at most one", "TableText",ExpressionUUID->
     "340469b5-36f7-4983-a84e-0ceef4ec904b"], Cell[
    "InfraAtMostOneEdgeLiftQ", "TableText",ExpressionUUID->
     "271369ab-d4a6-43f1-b0cd-07a0bcf59451"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2bbe785e-d96c-4c34-adbe-b7b77462af41"], Cell[
    "Unique edge lifting", "TableText",ExpressionUUID->
     "11d155ac-0202-43dc-9f3f-050c7221ef01"], Cell[
    "Every multiplicity is one", "TableText",ExpressionUUID->
     "d3bf15f5-7545-4607-8346-9dae5dab1187"], Cell[
    "InfraUniqueEdgeLiftingQ", "TableText",ExpressionUUID->
     "64da474a-9c97-471e-b64c-1b4d3b643ded"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "62c1dc65-6c67-4105-b56f-8f3121abd2c4"], Cell[
    "Graph bundle", "TableText",ExpressionUUID->
     "2a2faee1-de0b-462e-981d-b2a6e8e11b5d"], Cell["\<\
Isomorphic fibers and unique lifts whose matchings preserve vertical adjacency\
\>", "TableText",ExpressionUUID->"7a881b5c-459b-4c99-9d0b-9f0423a1ecb6"], 
    Cell["InfraFiberBundleQ", "TableText",ExpressionUUID->
