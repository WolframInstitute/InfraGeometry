Cell["\<\
The multiplicity reader returns an association from each total vertex to an \
association of adjacent base vertices and their counts. Zero counts record \
missing lifts. Vertical neighbours are excluded. A total vertex over an \
isolated base vertex has an empty inner association.\
\>", "Text",ExpressionUUID->"6c3380f5-e01c-4952-a6bb-ddd22c0c036b"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "41b83d88-a84d-4942-b7cc-3814ace03c77"], Cell["Condition", "TableText",
     FontWeight->Bold,ExpressionUUID->"1831d0bd-0997-45c7-b8b7-f83b6f024c2a"],
     Cell["Finite meaning", "TableText",
     FontWeight->Bold,ExpressionUUID->"1d1660d8-aa6d-4e73-840e-69236b2abf8d"],
     Cell["Reader", "TableText",
     FontWeight->Bold,ExpressionUUID->"5470273c-5111-48ce-8bd3-43f56c6c4efe"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "440c4ec3-c87d-4b4f-8fb5-a5f56cf80820"], Cell[
    "Weak graph continuity", "TableText",ExpressionUUID->
     "a4b4b284-ce92-4947-a904-4d78117b797c"], Cell["\<\
Every total edge projects to a base edge or a vertex; automatic for the \
reconstructed base\
\>", "TableText",ExpressionUUID->"15faeaad-0295-482e-a4cd-0916de7f2398"], 
    Cell["InfraFiberedGraphQ", "TableText",ExpressionUUID->
     "6c323f62-4261-4cff-8d1a-4a9a22c864ec"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "07616c65-3553-406e-bb79-65b5a1ccae99"], Cell[
    "Equal fiber sizes", "TableText",ExpressionUUID->
     "283a867f-ec84-4dc2-8e97-d61e8fb271d6"], Cell["\<\
Every fiber has the same cardinality, including across base components\
\>", "TableText",ExpressionUUID->"480e22eb-ad34-4591-8901-d2a5df44282b"], 
    Cell["InfraEqualFiberSizesQ", "TableText",ExpressionUUID->
     "35c6135a-71f8-4be6-992b-fc1bb1739b9d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "cc468aa6-bd77-49f0-b3b2-3dfe46745118"], Cell[
    "Isomorphic fibers", "TableText",ExpressionUUID->
     "3d0c1176-5e2e-4a22-8032-ba859081f085"], Cell[
    "All induced fiber graphs are mutually isomorphic", "TableText",
     ExpressionUUID->"78c4ae7d-4470-4f42-9345-04015f7bf747"], Cell[
    "InfraIsomorphicFibersQ", "TableText",ExpressionUUID->
     "18d91a3f-79c3-4bde-af50-799b7a8863d6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d94a5e29-a422-47be-87bb-10d4bbbc7af4"], Cell[
    "Local surjectivity on transverse neighbours", "TableText",ExpressionUUID->
     "fe2bec59-5fb5-4fa6-9528-5b7bd9a85bf0"], Cell["\<\
Every multiplicity is positive; the project's weak fibration condition\
\>", "TableText",ExpressionUUID->"c8ca1909-19ce-41cf-908f-09c7c1b73d5d"], 
    Cell["InfraFibrationQ", "TableText",ExpressionUUID->
     "7efb8f47-24fd-45be-b62b-ff434f99172a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "00e3dace-25c0-4710-95ea-99f03ca4366b"], Cell[
    "Local injectivity on transverse neighbours", "TableText",ExpressionUUID->
     "deed6a0c-bffd-4cbe-8247-5c593c4df2ff"], Cell[
    "Every multiplicity is at most one", "TableText",ExpressionUUID->
     "8ec21617-cd84-4890-9d5d-fd93edad7486"], Cell[
    "InfraAtMostOneEdgeLiftQ", "TableText",ExpressionUUID->
     "085aa1e9-a53d-412a-99bb-d058804679da"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "10a7eaba-0d0c-4a76-80d4-3093431abdd3"], Cell[
    "Unique edge lifting", "TableText",ExpressionUUID->
     "20239a2e-f5e6-4faa-97eb-6425c0753e6a"], Cell[
    "Every multiplicity is one", "TableText",ExpressionUUID->
     "bd00a661-1526-45c5-a6f8-ba3b8996fd89"], Cell[
    "InfraUniqueEdgeLiftingQ", "TableText",ExpressionUUID->
     "26a12e3f-386b-4660-a5a0-f88e6065cac9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "65b3e586-c5ba-4c51-a577-b322a2eade47"], Cell[
    "Graph bundle", "TableText",ExpressionUUID->
     "1d0ac822-537d-4c75-835d-33bf3a947318"], Cell["\<\
Isomorphic fibers and unique lifts whose matchings preserve vertical adjacency\
\>", "TableText",ExpressionUUID->"f776d11a-cf51-412e-a4e9-c22e256541bb"], 
    Cell["InfraFiberBundleQ", "TableText",ExpressionUUID->
     "34d9d34f-5d25-421e-be86-a993de4e6049"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "33aac45b-b93d-4e82-b74f-3499e3a6bcba"], Cell[
