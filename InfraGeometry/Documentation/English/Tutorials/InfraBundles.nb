  }]], "2ColumnTableMod",ExpressionUUID->"d09bc4f6-f2b8-4760-b1d1-\
3f900b1fea8f"],

Cell["\<\
The projection may be an association or a function. Association keys are \
literal total vertices; lists are allowed as individual labels.\
\>", "Text",ExpressionUUID->"c417aaa3-d10f-431a-b82a-59e72652a593"],

Cell["\<\
A cycle wraps twice around its reconstructed square base. The marked vertices \
form one fiber.\
\>", "Text",ExpressionUUID->"8eb0458c-ee26-4f3f-813e-82392858333b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}], ",", " ", 
       RowBox[{"vertex", " ", "|->", " ", 
        RowBox[{"Mod", "[", " ", 
         RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
      " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", " ", 
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"{", " ", 
         RowBox[{"InfraFiber", "[", " ", 
          RowBox[{"fib", ",", " ", "1"}], " ", "]"}], " ", "}"}]}], " ", 
       "]"}], ",", "\n", "    ", 
      RowBox[{"InfraTotalSpace", "[", " ", "fib", " ", "]"}], ",", " ", 
      RowBox[{"InfraBaseSpace", "[", " ", "fib", " ", "]"}]}], " ", "}"}], 
    " ", "]"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"960a56b3-7dd1-4a0b-8d5e-8c2701eb2b80"],

