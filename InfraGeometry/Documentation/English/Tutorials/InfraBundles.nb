     "3f483643-661f-4bdc-9fc5-6ec56d0fa236"], Cell["\<\
Isomorphic fibers and unique lifts whose matchings preserve vertical adjacency\
\>", "TableText",ExpressionUUID->"849e9222-6b6f-4205-ad8d-f5ed173ea040"], 
    Cell["InfraFiberBundleQ", "TableText",ExpressionUUID->
     "7854b351-cecb-4b3a-a887-3532b2c5ec1d"]},
