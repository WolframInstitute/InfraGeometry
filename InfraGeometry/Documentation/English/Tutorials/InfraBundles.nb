Cell["\<\
A complete connection lifts each base walk uniquely after a starting total \
vertex is chosen. The result is an ordered vertex list, including repeated \
visits. Parallel transport records its endpoint for every start in the \
initial fiber.\
\>", "Text",ExpressionUUID->"10012574-922d-4da9-8d7b-3a4e67cb9548"],

Cell["\<\
The selected connection below determines the highlighted lift.\
\>", "Text",ExpressionUUID->"994e79b9-b236-4658-b387-f2a4a54daa6f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "6", " ", "]"}], ",", "\n", "    ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "3", " ", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"connection", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"start", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"VertexList", " ", "@", " ", 
       RowBox[{"InfraFiber", "[", " ", 
        RowBox[{"fib", ",", " ", "1"}], " ", "]"}]}]}]}], " ", "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"lift", " ", "=", " ", 
     RowBox[{"InfraHorizontalLift", "[", " ", 
      RowBox[{"fib", ",", " ", "connection", ",", " ", "start", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{
        "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "5", ",", 
         " ", "6", ",", " ", "1"}], " ", "}"}]}], " ", "]"}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", " ", 
      RowBox[{"connection", ",", " ", 
       RowBox[{"InfraWalk", "[", " ", "lift", " ", "]"}]}], " ", "}"}]}], " ",
     "]"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"ad745430-0cda-48d1-a90d-751e6421b8dc"],

