Cell["\<\
The multiplicity reader returns an association from each total vertex to an \
association of adjacent base vertices and their counts. Zero counts record \
missing lifts. Vertical neighbours are excluded. A total vertex over an \
isolated base vertex has an empty inner association.\
\>", "Text",ExpressionUUID->"b21ca067-fca2-4e57-9ec0-e7a76deb8221"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4734178c-5307-4410-9378-a07cc987e4c7"], Cell["Condition", "TableText",
     FontWeight->Bold,ExpressionUUID->"978e34e2-05ef-486c-b85c-ad9a34d70f83"],
     Cell["Finite meaning", "TableText",
     FontWeight->Bold,ExpressionUUID->"ef780b27-baf7-470c-860f-e27bab60ef34"],
