      RowBox[{"fib", ",", " ", "All"}], " ", "]"}]}], " ", "}"}]}], " ", 
  "]"}]}], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"cab5b230-f925-432f-9f65-8230b70ef131"],

