     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"Graph", "[", " ", 
        RowBox[{
         RowBox[{"Range", "[", " ", "6", " ", "]"}], ",", "\n", "    ", 
         RowBox[{"UndirectedEdge", " ", "@@@", " ", 
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"{", " ", 
             RowBox[{"1", ",", " ", "4"}], " ", "}"}], ",", " ", 
            RowBox[{"{", " ", 
