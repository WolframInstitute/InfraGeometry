Notebook[{

Cell[CellGroupData[{
Cell["Straightening at a Scale", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 "A ",
 StyleBox["germ",
  FontWeight->"Bold"],
 " is a shortest path, here of eight edges ending at the centre of the graph. \
We extend it forward by ten steps."
}], "Item",ExpressionUUID->"08489946-56b3-4586-85e9-d4ef1ee9ed8d"],

Cell[TextData[{
 "A walk is a ",
 StyleBox["geodesic at infra-scale",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74c8f5a2-43f8-4560-a0f7-3d755d5f7a21"],
 " when every ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e77581f1-d7cf-42de-bff5-1a8382a9ec50"],
 " consecutive vertices of it form a shortest path. The observer checks \
straightness only within a horizon of ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bcfe5fc7-68f2-4cdf-ac9b-2f22fb2444db"],
 " steps; at scale ",
 Cell[BoxData["\[Infinity]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c351eca-eb71-4b21-b8b8-10314c20fdde"],
 " the whole walk is a shortest path."
}], "Item",ExpressionUUID->"1ec680ae-93a3-4b4b-9a0a-0a9f8b70087f"],

Cell[TextData[{
 "The ",
 StyleBox["beam",
  FontWeight->"Bold"],
 " of the germ at scale ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39fdd278-83d1-4cd7-a83a-72cb14b9cbcd"],
 " is the set of all geodesics at scale ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53bef8cc-69c7-414c-b194-8b5aa4a11a60"],
 " that extend the germ. A ",
 StyleBox["most visited",
  FontWeight->"Bold"],
 " member is one that maximizes the sum of the vertex and edge densities of \
the beam along it."
}], "Item",ExpressionUUID->"49d902fc-8438-4f95-8338-5fad08bbf548"],

Cell[TextData[{
 "The question: from which scale ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["r", "TI"], "*"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "813c8c70-dc70-49e6-9970-6a4754d55b91"],
 " on is the most visited member of the beam a ",
 StyleBox["segment",
  FontWeight->"Bold"],
 ", a shortest path between its ends? We answer it on three lattices."
}], "Item",ExpressionUUID->"d41ea4db-b130-4953-98ee-77e97b94fd4e"],

Cell["\<\
The pictures keep the embedding of the substrate so that the reader sees the \
plane; only the chord deviation below uses it.\
\>", "Item",ExpressionUUID->"7cbfa561-ed13-4b0c-b087-adf9fccdb7b3"],

Cell["Setup", "Section",ExpressionUUID->"b056fd16-9175-4cad-a422-e94072687e5a"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`InfraGeometry`\>\"", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"26f97e24-7135-4919-9a8f-94bc8028b3b9"],

Cell["The beam at a scale", "Section",ExpressionUUID->"fcd21cdd-6a85-49f5-8442-ce602ded2b62"],

Cell[TextData[{
 "Each picture is one lattice at one scale: the rows are the square, the \
triangular and the hexagonal tiling, the columns the scales ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["r", "TI"], "=", "2"}], ",", 
   RowBox[{"4", ",", "8"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c446b9a4-76b0-40db-b54f-79e73f7837cd"],
 "."
}], "Item",ExpressionUUID->"2f8d7909-7b53-4535-8be5-329fb9960550"],

Cell["\<\
The beam is orange, its endpoints green, each sized by the number of members \
ending there. The most visited members are red, all of them; the germ is \
drawn last.\
\>", "Item",ExpressionUUID->"580ce16b-53fe-459c-b647-94c84a7f3293"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "\"\<Large\>\"", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"germ", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"RandomInfraRepresentative", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSegment", "[", 
            RowBox[{
             RowBox[{"First", " ", "@", " ", 
              RowBox[{"FindInfraShell", "[", 
               RowBox[{"g", ",", " ", "c", ",", " ", "8"}], "]"}]}], ",", " ",
              "c"}], "]"}], ",", " ", "1"}], "]"}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"walks", " ", "=", " ", 
        RowBox[{"RandomInfraGeodesic", "[", 
         RowBox[{"g", ",", " ", "germ", ",", " ", "r", ",", " ", 
          RowBox[{"{", "10", "}"}], ",", " ", "All"}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", "\n", "      ", 
         RowBox[{
          RowBox[{"walks", " ", "->", " ", "StandardOrange"}], ",", "\n", 
          "      ", 
          RowBox[{
           RowBox[{"SelectInfraWalk", "[", 
            RowBox[{"g", ",", " ", "walks", ",", " ", "All", ",", " ", 
             
             RowBox[{"\"\<From\>\"", " ", "->", 
              " ", "\"\<MostVisited\>\""}]}], "]"}], " ", "->", " ", 
           "StandardRed"}], ",", "\n", "      ", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "germ", "]"}], " ", "->", " ", 
           "StandardOrange"}], ",", "\n", "      ", 
          RowBox[{
           RowBox[{"Counts", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Last", " ", "@", " ", 
               RowBox[{"Last", " ", "@", " ", 
                RowBox[{"Sort", " ", "@", " ", 
                 RowBox[{"VertexList", " ", "@", " ", "#"}]}]}]}], " ", "&"}],
              " ", "/@", " ", "walks"}], "]"}], " ", "->", " ", 
           "StandardGreen"}]}], "}"}], ",", "\n", "      ", 
        RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}]}]}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"r", ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4", ",", " ", "8"}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3c0c0af5-e002-44e8-b091-3a273edd91bc"],

