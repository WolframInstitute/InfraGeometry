Cell["\<\
At the smallest scale the beam fans out over a wide region and its endpoints \
fill it. Every member starts at the germ, so the density is highest there, \
and the most visited member is the one that stays near the germ: it circles \
around the centre. A geodesic at a small scale may revisit a vertex, and \
these members do.\
\>", "Item",ExpressionUUID->"29d33178-369a-4251-8059-c3ec0300a339"],

Cell["\<\
From a scale on the endpoints gather on a short arc and the most visited \
members run straight away from the germ. On the square tiling this happens \
later than on the other two: at the middle scale its most visited member \
still bends away.\
\>", "Item",ExpressionUUID->"b2a03d84-2c0a-4907-9d02-fb9c88b0e920"],

Cell["\<\
The straight members do not continue the germ's direction. On the square \
tiling they run along the diagonal of the cone of the two lattice directions \
that contains the germ: a lattice keeps a direction only up to its cone.\
\>", "Item",ExpressionUUID->"475408f4-c641-4e6d-8598-9981b107e805"],

Cell["The scale of straightness", "Section",ExpressionUUID->"87816ea3-ad38-43be-b373-3e2bdfb3a1dc"],

Cell[TextData[{
 "Three readouts of the most visited members, for every scale ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["r", "TI"], "=", "2"}], ",", "\[Ellipsis]", ",", "10"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1546a142-a9f7-4750-80e9-193d5633280a"],
 ", each the worst over the ties. The extension is a member without the \
germ."
}], "Item",ExpressionUUID->"b2bf8d8b-d7e1-4cda-8f34-35e1db173cfb"],

Cell[TextData[{
 "The ",
 StyleBox["excess",
  FontWeight->"Bold"],
 " of an extension is its length minus the distance between its ends. It is \
zero exactly when the extension is a segment, so the threshold ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["r", "TI"], "*"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23700fe1-65d1-49d9-ae74-b8761ca50ab0"],
 " is the scale where the excess first vanishes."
}], "Item",ExpressionUUID->"91254b5f-746f-45cd-89ff-634c06e90a1f"],

Cell[TextData[{
 "The ",
 StyleBox["chord deviation",
  FontWeight->"Bold"],
 " is read in the plane; the ",
 StyleBox["spread",
  FontWeight->"Bold"],
 " of the endpoints is the largest distance between two of them."
}], "Item",ExpressionUUID->"ab48a07f-7970-48a6-b678-87dc812bc0a5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"readouts", " ", "=", " ", 
   RowBox[{"Table", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"name", ",", " ", "\"\<Large\>\"", ",", " ", 
             RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
            "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"germWalk", " ", "=", " ", 
          RowBox[{"germ", "[", "g", "]"}]}], ",", " ", 
         RowBox[{"d", " ", "=", " ", 
          RowBox[{"GraphDistanceMatrix", "[", "g", "]"}]}]}], "}"}], ",", 
       "\n", "    ", 
       RowBox[{"Table", "[", "\n", "      ", 
        RowBox[{
         RowBox[{"With", "[", "\n", "        ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"b", " ", "=", " ", 
             RowBox[{"beam", "[", 
              RowBox[{
              "g", ",", " ", "germWalk", ",", " ", "r", ",", " ", "10"}], 
              "]"}]}], "}"}], ",", "\n", "        ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"walks", " ", "=", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Drop", "[", 
                 RowBox[{"#", ",", " ", 
                  RowBox[{
                   RowBox[{"Length", "[", "germWalk", "]"}], " ", "-", " ", 
                   "1"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
               RowBox[{"mostVisited", "[", "b", "]"}]}]}], ",", " ", 
             RowBox[{"ends", " ", "=", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"VertexIndex", "[", 
                 RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", 
               " ", 
               RowBox[{"Keys", "[", 
                RowBox[{"beamEndpoints", "[", "b", "]"}], "]"}]}]}]}], "}"}], 
           ",", "\n", "        ", 
           RowBox[{"{", 
            RowBox[{"r", ",", " ", 
             RowBox[{"Max", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", "#", "]"}], " ", "-", " ", "1", " ", "-",
                  " ", 
                 RowBox[{"d", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"VertexIndex", "[", 
                    RowBox[{"g", ",", " ", 
                    RowBox[{"First", " ", "@", " ", "#"}]}], "]"}], ",", " ", 
                    
                    RowBox[{"VertexIndex", "[", 
                    RowBox[{"g", ",", " ", 
                    RowBox[{"Last", " ", "@", " ", "#"}]}], "]"}]}], "]"}], 
                  "]"}]}], " ", "&"}], " ", "/@", " ", "walks"}], "]"}], ",", 
             " ", 
             RowBox[{"Max", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"deviation", "[", 
                 RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", 
               " ", "walks"}], "]"}], ",", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"d", "[", 
               RowBox[{"[", 
                RowBox[{"ends", ",", " ", "ends"}], "]"}], "]"}], "]"}]}], 
            "}"}]}], "]"}], ",", "\n", "      ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "2", ",", " ", "10"}], "}"}]}], "]"}]}], 
