Cell["\<\
At the smallest scale the beam fans out over a wide region and its endpoints \
fill it. Every member starts at the germ, so the density is highest there, \
and the most visited member is the one that stays near the germ: it circles \
around the end of the germ. A geodesic at a small scale may revisit a vertex, \
and these members do.\
\>", "Item",ExpressionUUID->"11785c97-007b-48bc-aa7d-c3a02bdb5c7f"],

Cell["\<\
From a scale on the endpoints gather on a short arc and the most visited \
members run straight away from the germ. At the middle scale this has \
happened on the triangular tiling only; the square and the hexagonal tilings \
still bend.\
\>", "Item",ExpressionUUID->"29be1e43-f84b-4e85-b41f-c5c1b70c69f0"],

Cell["\<\
The straight members need not continue the germ's direction: a lattice keeps \
a direction only up to the cone of its lattice directions.\
\>", "Item",ExpressionUUID->"0f28351f-9449-4a35-b9a0-7b88206e71a6"],

Cell["The scale of straightness", "Section",ExpressionUUID->"c4c4fe11-a0af-41e3-8bc6-6969228a41d1"],

Cell[TextData[{
 "Two readouts of the most visited members, for every scale ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["r", "TI"], "=", "2"}], ",", "\[Ellipsis]", ",", "10"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc7670ad-38ad-4451-a746-dd4481a7c20b"],
 ", each the worst over the ties. The extension is a member without the \
germ."
}], "Item",ExpressionUUID->"6a23e851-7280-43e7-970d-be78c2165911"],

Cell[TextData[{
 "The ",
 StyleBox["excess",
  FontWeight->"Bold"],
 " of an extension is its length minus the distance between its ends. It is \
zero exactly when the extension is a segment, so the threshold ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["r", "TI"], "*"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b4a8d29-1384-4a78-bd7c-813e18170910"],
 " is the scale where the excess first vanishes."
}], "Item",ExpressionUUID->"dfbad5e2-fc9f-45e9-8b36-87c69588b2ae"],

Cell[TextData[{
 "The ",
 StyleBox["chord deviation",
  FontWeight->"Bold"],
 " is the largest distance of the extension's vertices from the chord joining \
its ends, in units of the edge length, read in the plane."
}], "Item",ExpressionUUID->"0d56ad68-5f96-4f54-a3c9-0aee50eb1d2e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"readouts", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "      ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
             RowBox[{"InfraSubstrate", "[", 
              RowBox[{"name", ",", " ", "\"\<Large\>\"", ",", " ", 
               RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
              "]"}]}], ")"}]}], "}"}], ",", "\n", "      ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"c", " ", "=", " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
           RowBox[{"d", " ", "=", " ", 
            RowBox[{"GraphDistanceMatrix", "[", "g", "]"}]}], ",", " ", 
           RowBox[{"xy", " ", "=", " ", 
            RowBox[{"AssociationThread", "[", 
             RowBox[{
              RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
              RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}]}], "}"}], ",",
          "\n", "      ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"germ", " ", "=", " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"FindInfraRepresentative", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSegment", "[", 
                RowBox[{
                 RowBox[{"First", " ", "@", " ", 
                  RowBox[{"FindInfraShell", "[", 
                   RowBox[{"g", ",", " ", "c", ",", " ", "8"}], "]"}]}], ",", 
                 " ", "c"}], "]"}], ",", " ", "1"}], "]"}]}]}], ",", "\n", 
           "       ", 
           RowBox[{"unit", " ", "=", " ", 
            RowBox[{"EuclideanDistance", " ", "@@", " ", 
             RowBox[{"Lookup", "[", 
              RowBox[{"xy", ",", " ", 
               RowBox[{"List", " ", "@@", " ", 
                RowBox[{"First", " ", "@", " ", 
                 RowBox[{"EdgeList", " ", "@", " ", "g"}]}]}]}], "]"}]}]}]}], 
          "}"}], ",", "\n", "      ", 
         RowBox[{"Table", "[", "\n", "        ", 
          RowBox[{
           RowBox[{"With", "[", "\n", "          ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"walks", " ", "=", " ", 
               RowBox[{"FindInfraGeodesic", "[", 
                RowBox[{"g", ",", " ", "germ", ",", " ", "r", ",", " ", 
                 RowBox[{"{", "10", "}"}], ",", " ", "All"}], "]"}]}], "}"}], 
             ",", "\n", "          ", 
             RowBox[{"{", 
              RowBox[{"ext", " ", "=", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"Drop", "[", 
                  RowBox[{
                   RowBox[{"Last", " ", "/@", " ", 
                    RowBox[{"Sort", " ", "@", " ", 
                    RowBox[{"VertexList", " ", "@", " ", "#"}]}]}], ",", " ", 
                   
                   RowBox[{
                    RowBox[{"Length", "[", "germ", "]"}], " ", "-", " ", 
                    "1"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
                RowBox[{"SelectInfraWalk", "[", 
                 RowBox[{"g", ",", " ", "walks", ",", " ", "All", ",", " ", 
                  
                  RowBox[{"\"\<From\>\"", " ", "->", 
                   " ", "\"\<MostVisited\>\""}]}], "]"}]}]}], "}"}], ",", 
             "\n", "          ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"r", ",", " ", 
                 RowBox[{"Max", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "#", "]"}], " ", "-", " ", "1", 
                    " ", "-", " ", 
                    RowBox[{"d", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"VertexIndex", "[", 
                    RowBox[{"g", ",", " ", 
                    RowBox[{"First", " ", "@", " ", "#"}]}], "]"}], ",", " ", 
                    
                    RowBox[{"VertexIndex", "[", 
                    RowBox[{"g", ",", " ", 
                    RowBox[{"Last", " ", "@", " ", "#"}]}], "]"}]}], "]"}], 
                    "]"}]}], " ", "&"}], " ", "/@", " ", "ext"}], "]"}]}], 
                "}"}], ",", "\n", "           ", 
               RowBox[{"{", 
                RowBox[{"r", ",", " ", 
                 RowBox[{
                  RowBox[{"Max", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Max", "[", 
                    RowBox[{"RegionDistance", "[", 
                    RowBox[{
                    RowBox[{"Line", "[", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"xy", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"First", " ", "@", " ", "#"}], ",", " ", 
                    RowBox[{"Last", " ", "@", " ", "#"}]}], "}"}]}], "]"}], 
                    "]"}], ",", " ", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"xy", ",", " ", "#"}], "]"}]}], "]"}], "]"}], " ",
                     "&"}], " ", "/@", " ", "ext"}], "]"}], " ", "/", " ", 
                  "unit"}]}], "}"}]}], "}"}]}], "]"}], ",", "\n", "        ", 
           
           RowBox[{"{", 
            RowBox[{"r", ",", " ", "2", ",", " ", "10"}], "}"}]}], "]"}]}], 
        "]"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
           " ", "\"\<TriangularTilingGraph\>\"", ",", 
           " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"readouts", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "All", ",", " ", "1"}], "]"}], "]"}], ",", 
        " ", 
        RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
        RowBox[{"AxesLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Text", "[", "\"\<r\>\"", "]"}], ",", " ", 
           RowBox[{"Text", "[", "\"\<excess\>\"", "]"}]}], "}"}]}], ",", "\n",
         "      ", 
        RowBox[{"PlotLegends", " ", "->", " ", 
         RowBox[{"Text", " ", "/@", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<square\>\"", ",", " ", "\"\<triangular\>\"", ",", 
            " ", "\"\<hexagonal\>\""}], "}"}]}]}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"readouts", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "All", ",", " ", "2"}], "]"}], "]"}], ",", 
        " ", 
        RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
        RowBox[{"AxesLabel", " ", "->", " ", 
         RowBox[{"{", 
