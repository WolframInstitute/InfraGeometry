          RowBox[{"{", 
           
           RowBox[{"\"\<trihexagonal\>\"", ",", 
            " ", "\"\<truncated square\>\"", ",", 
            " ", "\"\<rhombitrihexagonal\>\""}], "}"}]}]}]}], "]"}]}], "}"}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"1e3b8d95-a473-4fed-9416-abb502e54141"],

