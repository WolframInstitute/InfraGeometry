Notebook[{

Cell[CellGroupData[{
Cell["Straightening at a Scale", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 "A ",
 StyleBox["germ",
  FontWeight->"Bold"],
 " is a shortest path, here of eight edges ending at the centre of the graph. \
We extend it forward by ten steps."
}], "Item",ExpressionUUID->"4533879b-dc97-4a25-ba1c-c183010dc6cc"],

Cell[TextData[{
 "A walk is a ",
 StyleBox["geodesic at infra-scale",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a5681c2-9cd6-4d22-801e-90263aaabfdc"],
 " when every ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8cf5b5ec-d60f-4fd1-856b-b79ca4048d3b"],
 " consecutive vertices of it form a shortest path. The observer checks \
straightness only within a horizon of ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6deb0162-67f0-42a1-9ebf-59b62be772e4"],
 " steps; at scale ",
 Cell[BoxData["\[Infinity]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c880cf59-82fa-4ae9-afbe-7891ac842a9c"],
 " the whole walk is a shortest path."
}], "Item",ExpressionUUID->"a3d102d6-5159-41ee-a6f8-73782a050a20"],

Cell[TextData[{
 "The ",
 StyleBox["beam",
  FontWeight->"Bold"],
 " of the germ at scale ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "069c672e-ba8d-487d-a3d2-92e2d8fe78b1"],
 " is the set of all geodesics at scale ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09d3b9e2-c35f-43ea-b897-c79f4831e431"],
 " that extend the germ. A ",
 StyleBox["most visited",
  FontWeight->"Bold"],
 " member is one that maximizes the sum of the vertex and edge densities of \
the beam along it."
}], "Item",ExpressionUUID->"6686f962-397d-4eed-a12b-a8fbd83ab9f8"],

Cell[TextData[{
 "The question: from which scale ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["r", "TI"], "*"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51b6be6d-2ba3-45af-9d84-ed749c3c9ecf"],
 " on is the most visited member of the beam a ",
 StyleBox["segment",
  FontWeight->"Bold"],
 ", a shortest path between its ends? We answer it on three Archimedean \
lattices: the trihexagonal tiling ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "3"}], ",", 
   RowBox[{"6", ",", "3"}], ",", 
   RowBox[{"6", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d4d1222-60dd-4d41-bbe4-28bb5742f0c8"],
 ", the truncated square tiling ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "4"}], ",", "8", ",", 
   RowBox[{"8", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539ba9ef-d770-4377-82ce-3c837f8cb36b"],
 " and the rhombitrihexagonal tiling ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "3"}], ",", 
   RowBox[{"4", ",", "6"}], ",", 
   RowBox[{"4", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "acac7dad-6597-4886-a44c-476c60b4f3e9"],
 ", each the ball of radius 14 about a vertex."
}], "Item",ExpressionUUID->"7904bd16-330b-4e2b-9b0f-74e5278ac7fe"],

Cell["\<\
The pictures keep the embedding of the substrate so that the reader sees the \
plane; only the chord deviation below uses it.\
\>", "Item",ExpressionUUID->"a507ce48-3767-4cf7-835f-da67e5b6be27"],

Cell["Setup", "Section",ExpressionUUID->"820885af-49c5-4c77-97cc-c58571dd9373"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`InfraGeometry`\>\"", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c7f7a1ea-c50f-4c3b-8b65-ff86fd1e2816"],

Cell["The beam at a scale", "Section",ExpressionUUID->"eb16cbeb-8521-4905-afa5-2fa46385ccc7"],

Cell[TextData[{
 "Each picture is one lattice at one scale: the rows are the trihexagonal, \
the truncated square and the rhombitrihexagonal tiling, the columns the \
scales ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c65db441-9304-4c4e-a6d4-91d405c0b59a"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "6"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6f318f7-fae6-4722-83a7-147213df383d"],
 "."
}], "Item",ExpressionUUID->"60b4921c-a4d7-417a-b373-6092b5dfc90a"],

Cell["\<\
The beam is orange and the most visited members are red, all of them; the \
germ is drawn last.\
\>", "Item",ExpressionUUID->"c932b2a7-e51d-40dc-a14e-818ad2d0fad7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"Graph", "[", 
         RowBox[{
          RowBox[{"TessellationNeighborhoodGraph", "[", 
           RowBox[{"config", ",", " ", "14"}], "]"}], ",", " ", 
          RowBox[{"Sequence", " ", "@@", " ", 
           RowBox[{"InfraSubstrateStyle", "[", "\"\<Large\>\"", "]"}]}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"germ", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"RandomInfraSegment", "[", " ", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSegment", "[", 
            RowBox[{
             RowBox[{"First", " ", "@", " ", 
              RowBox[{"Keys", " ", "@", " ", 
               RowBox[{"InfraMeasurement", "[", " ", 
                RowBox[{"g", ",", " ", 
                 RowBox[{"InfraShell", "[", " ", 
                  RowBox[{"c", ",", " ", "8"}], " ", "]"}], ",", 
                 " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], ",", " ", 
             "c"}], "]"}], ",", " ", "1", ",", " ", 
           RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], " ", "]"}]}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"walks", " ", "=", " ", 
        RowBox[{"RandomInfraGeodesic", "[", 
         RowBox[{"g", ",", " ", "germ", ",", " ", "r", ",", " ", 
          RowBox[{"{", "10", "}"}], ",", " ", "All"}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", "\n", "      ", 
         RowBox[{
          RowBox[{"walks", " ", "->", " ", "StandardOrange"}], ",", "\n", 
          "      ", 
          RowBox[{
           RowBox[{"SelectInfraWalk", "[", 
            RowBox[{"g", ",", " ", "walks", ",", " ", "All", ",", " ", 
             
             RowBox[{"\"\<From\>\"", " ", "->", 
              " ", "\"\<MostVisited\>\""}]}], "]"}], " ", "->", " ", 
           "StandardRed"}], ",", "\n", "      ", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "germ", "]"}], " ", "->", " ", 
           "StandardOrange"}]}], "}"}], ",", "\n", "      ", 
        RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}]}]}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"config", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "6", ",", " ", "3", ",", " ", "6"}], "}"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "8", ",", " ", "8"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4", ",", " ", "6", ",", " ", "4"}], "}"}]}], 
       "}"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"r", ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "6"}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8481ad42-cd13-489c-a977-bdb8dea1e454"],

