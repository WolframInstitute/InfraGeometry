Notebook[{

Cell[CellGroupData[{
Cell["Straightening at a Scale", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 "A ",
 StyleBox["germ",
  FontWeight->"Bold"],
 " is a shortest path, here of eight edges ending at the centre of the graph. \
We extend it forward by ten steps."
}], "Item",ExpressionUUID->"c77074e7-959b-4229-ab0e-8a8b46add90a"],

Cell[TextData[{
 "A walk is a ",
 StyleBox["geodesic at infra-scale",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76f5ce7c-e9b6-4601-8472-a8b9e943cd0c"],
 " when every ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc6a2eab-05b6-470c-bf15-5c7f72c2ff97"],
 " consecutive vertices of it form a shortest path. The observer checks \
straightness only within a horizon of ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f7bf5d9-3256-40ab-9279-ba194f52328c"],
 " steps; at scale ",
 Cell[BoxData["\[Infinity]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e359741-f060-490f-b824-7b3471906850"],
 " the whole walk is a shortest path."
}], "Item",ExpressionUUID->"45e7951d-0bb3-4301-b1f7-fc2776004796"],

Cell[TextData[{
 "The ",
 StyleBox["beam",
  FontWeight->"Bold"],
 " of the germ at scale ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a091250-bc47-4acf-9fa8-2c440b4d8598"],
 " is the set of all geodesics at scale ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39aebaca-1480-4eb8-9083-e699286a87f5"],
 " that extend the germ. A ",
 StyleBox["most visited",
  FontWeight->"Bold"],
 " member is one that maximizes the sum of the vertex and edge densities of \
the beam along it."
}], "Item",ExpressionUUID->"b884b8a7-deca-40a5-bb74-e1600beba0af"],

Cell[TextData[{
 "The question: from which scale ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["r", "TI"], "*"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04fbbe6d-5d6a-4ef5-a6f4-94fb44326337"],
 " on is the most visited member of the beam a ",
 StyleBox["segment",
  FontWeight->"Bold"],
 ", a shortest path between its ends? We answer it on three lattices."
}], "Item",ExpressionUUID->"d883f868-2083-4275-90ff-b69fc05f4fd4"],

Cell["\<\
The pictures keep the embedding of the substrate so that the reader sees the \
plane; only the chord deviation below uses it.\
\>", "Item",ExpressionUUID->"62e22b97-3a35-44c3-a200-7b3d7543508b"],

Cell["Setup", "Section",ExpressionUUID->"82f565d0-53a6-454a-bcf0-f81da54c86a9"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`InfraGeometry`\>\"", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b77614bc-a8fc-4a25-8d5f-21f6213fc71b"],

Cell["The beam at a scale", "Section",ExpressionUUID->"cb9c7f58-c93d-4228-ad7c-96eaee1aea56"],

Cell[TextData[{
 "Each picture is one lattice at one scale: the rows are the square, the \
triangular and the hexagonal tiling, the columns the scales ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["r", "TI"], "=", "2"}], ",", 
   RowBox[{"4", ",", "8"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "275672e4-f0b3-4c6a-8388-5e4e2bdf0d83"],
 "."
}], "Item",ExpressionUUID->"3536884e-025e-4092-977b-5d5804f0d309"],

Cell["\<\
The beam is orange, its endpoints green, each sized by the number of members \
ending there. The most visited members are red, all of them; the germ is \
drawn last.\
\>", "Item",ExpressionUUID->"36b2daff-7f51-4810-b8e4-eb3aa90f4fb5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "\"\<Large\>\"", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"germ", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"FindInfraRepresentative", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSegment", "[", 
            RowBox[{
             RowBox[{"First", " ", "@", " ", 
              RowBox[{"FindInfraShell", "[", 
               RowBox[{"g", ",", " ", "c", ",", " ", "8"}], "]"}]}], ",", " ",
              "c"}], "]"}], ",", " ", "1"}], "]"}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"walks", " ", "=", " ", 
        RowBox[{"FindInfraGeodesic", "[", 
         RowBox[{"g", ",", " ", "germ", ",", " ", "r", ",", " ", 
          RowBox[{"{", "10", "}"}], ",", " ", "All"}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", "\n", "      ", 
         RowBox[{
          RowBox[{"walks", " ", "->", " ", "StandardOrange"}], ",", "\n", 
          "      ", 
          RowBox[{
           RowBox[{"SelectInfraWalk", "[", 
            RowBox[{"g", ",", " ", "walks", ",", " ", "All", ",", " ", 
             
             RowBox[{"\"\<From\>\"", " ", "->", 
              " ", "\"\<MostVisited\>\""}]}], "]"}], " ", "->", " ", 
           "StandardRed"}], ",", "\n", "      ", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "germ", "]"}], " ", "->", " ", 
           "StandardOrange"}], ",", "\n", "      ", 
          RowBox[{
           RowBox[{"Counts", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Last", " ", "@", " ", 
               RowBox[{"Last", " ", "@", " ", 
                RowBox[{"Sort", " ", "@", " ", 
                 RowBox[{"VertexList", " ", "@", " ", "#"}]}]}]}], " ", "&"}],
              " ", "/@", " ", "walks"}], "]"}], " ", "->", " ", 
           "StandardGreen"}]}], "}"}], ",", "\n", "      ", 
        RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}]}]}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"r", ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4", ",", " ", "8"}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f21a82c3-8a1b-4ec8-bb4c-dc10e991c282"],

