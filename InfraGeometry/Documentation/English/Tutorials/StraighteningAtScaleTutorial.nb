Cell["\<\
At scale 3 the beam spreads over a wide region; its members end at 194, 49 \
and 131 vertices. Every member starts at the germ, so the density is highest \
there, and the most visited member is the one that stays near the germ: it \
circles around the end of the germ, on a hexagon, an octagon and a hexagon. A \
geodesic at a small scale may revisit a vertex, and these members do.\
\>", "Item",ExpressionUUID->"12fe8e3f-4e75-4564-94bf-335f473aa56c"],

Cell["\<\
At scale 6 the members end at 31, 19 and 22 vertices, and the most visited \
members run straight away from the germ on all three lattices.\
\>", "Item",ExpressionUUID->"70eebe5b-1338-4ac3-a6d5-cb2685b30423"],

Cell["\<\
The straight members need not continue the germ's direction: they turn by 30\
\[Degree] to 43\[Degree] on the trihexagonal tiling, by 1\[Degree] or 36\
\[Degree] on the truncated square tiling and by 15\[Degree] on the \
rhombitrihexagonal tiling. A lattice keeps a direction only up to the cone of \
its lattice directions.\
\>", "Item",ExpressionUUID->"4860bce3-5d2b-4af7-b956-3883872de909"],

Cell["The scale of straightness", "Section",ExpressionUUID->"6f8335a5-d5b3-4bb7-9333-edf1dbf54426"],

Cell[TextData[{
 "Two readouts of the most visited members, for every scale ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["r", "TI"], "=", "2"}], ",", "\[Ellipsis]", ",", "10"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f2aaa1e-5199-4468-9bf2-5ed1f0ca6633"],
 ", each the worst over the ties. The extension is a member without the \
germ."
}], "Item",ExpressionUUID->"be6bdfa1-31f6-49f8-a080-c5d99e762883"],

Cell[TextData[{
 "The ",
 StyleBox["excess",
  FontWeight->"Bold"],
 " of an extension is its length minus the distance between its ends. It is \
zero exactly when the extension is a segment, so the threshold ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["r", "TI"], "*"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b08bd6c8-c1ed-49cc-ba4b-227f2782ca6f"],
 " is the scale where the excess first vanishes."
}], "Item",ExpressionUUID->"1fbeeee5-391c-4202-83ff-dc5046db3c7a"],

Cell[TextData[{
 "The ",
 StyleBox["chord deviation",
  FontWeight->"Bold"],
 " is the largest distance of the extension's vertices from the chord joining \
its ends, read in the plane. The edges of the three tilings have length 1, so \
it is in units of the edge length."
}], "Item",ExpressionUUID->"88aeca85-1474-4476-af21-9a7edfbdd57f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"readouts", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "      ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"TessellationNeighborhoodGraph", "[", 
            RowBox[{"config", ",", " ", "14"}], "]"}]}], "}"}], ",", "\n", 
         "      ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"c", " ", "=", " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
           RowBox[{"d", " ", "=", " ", 
            RowBox[{"GraphDistanceMatrix", "[", "g", "]"}]}], ",", " ", 
           RowBox[{"xy", " ", "=", " ", 
            RowBox[{"AssociationThread", "[", 
             RowBox[{
              RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
              RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}]}], "}"}], ",",
          "\n", "      ", 
         RowBox[{"{", 
          RowBox[{"germ", " ", "=", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"RandomInfraSegment", "[", " ", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraSegment", "[", 
               RowBox[{
                RowBox[{"First", " ", "@", " ", 
                 RowBox[{"Keys", " ", "@", " ", 
                  RowBox[{"InfraMeasurement", "[", " ", 
                   RowBox[{"g", ",", " ", 
                    RowBox[{"InfraShell", "[", " ", 
                    RowBox[{"c", ",", " ", "8"}], " ", "]"}], ",", 
                    " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], ",", " ", 
                "c"}], "]"}], ",", " ", "1", ",", " ", 
              RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], " ", 
             "]"}]}]}], "}"}], ",", "\n", "      ", 
         RowBox[{"Table", "[", "\n", "        ", 
          RowBox[{
           RowBox[{"With", "[", "\n", "          ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"walks", " ", "=", " ", 
               RowBox[{"RandomInfraGeodesic", "[", 
                RowBox[{"g", ",", " ", "germ", ",", " ", "r", ",", " ", 
                 RowBox[{"{", "10", "}"}], ",", " ", "All"}], "]"}]}], "}"}], 
             ",", "\n", "          ", 
             RowBox[{"{", 
              RowBox[{"ext", " ", "=", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"Drop", "[", 
                  RowBox[{
                   RowBox[{"Last", " ", "/@", " ", 
                    RowBox[{"Sort", " ", "@", " ", 
                    RowBox[{"VertexList", " ", "@", " ", "#"}]}]}], ",", " ", 
                   
                   RowBox[{
                    RowBox[{"Length", "[", "germ", "]"}], " ", "-", " ", 
                    "1"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
                RowBox[{"SelectInfraWalk", "[", 
                 RowBox[{"g", ",", " ", "walks", ",", " ", "All", ",", " ", 
                  
                  RowBox[{"\"\<From\>\"", " ", "->", 
                   " ", "\"\<MostVisited\>\""}]}], "]"}]}]}], "}"}], ",", 
             "\n", "          ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"r", ",", " ", 
                 RowBox[{"Max", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "#", "]"}], " ", "-", " ", "1", 
                    " ", "-", " ", 
                    RowBox[{"d", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"VertexIndex", "[", 
                    RowBox[{"g", ",", " ", 
                    RowBox[{"First", " ", "@", " ", "#"}]}], "]"}], ",", " ", 
                    
                    RowBox[{"VertexIndex", "[", 
                    RowBox[{"g", ",", " ", 
                    RowBox[{"Last", " ", "@", " ", "#"}]}], "]"}]}], "]"}], 
                    "]"}]}], " ", "&"}], " ", "/@", " ", "ext"}], "]"}]}], 
                "}"}], ",", "\n", "           ", 
               RowBox[{"{", 
                RowBox[{"r", ",", " ", 
                 RowBox[{"Max", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Max", "[", 
                    RowBox[{"RegionDistance", "[", 
                    RowBox[{
                    RowBox[{"Line", "[", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"xy", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"First", " ", "@", " ", "#"}], ",", " ", 
                    RowBox[{"Last", " ", "@", " ", "#"}]}], "}"}]}], "]"}], 
                    "]"}], ",", " ", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"xy", ",", " ", "#"}], "]"}]}], "]"}], "]"}], " ",
                     "&"}], " ", "/@", " ", "ext"}], "]"}]}], "}"}]}], 
              "}"}]}], "]"}], ",", "\n", "        ", 
           RowBox[{"{", 
            RowBox[{"r", ",", " ", "2", ",", " ", "10"}], "}"}]}], "]"}]}], 
        "]"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"config", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "6", ",", " ", "3", ",", " ", "6"}], "}"}],
            ",", " ", 
           RowBox[{"{", 
            RowBox[{"4", ",", " ", "8", ",", " ", "8"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "4", ",", " ", "6", ",", " ", "4"}], 
            "}"}]}], "}"}]}], "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"readouts", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "All", ",", " ", "1"}], "]"}], "]"}], ",", 
        " ", 
        RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
        RowBox[{"AxesLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Text", "[", "\"\<r\>\"", "]"}], ",", " ", 
           RowBox[{"Text", "[", "\"\<excess\>\"", "]"}]}], "}"}]}], ",", "\n",
         "      ", 
        RowBox[{"PlotLegends", " ", "->", " ", 
         RowBox[{"Text", " ", "/@", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<trihexagonal\>\"", ",", 
            " ", "\"\<truncated square\>\"", ",", 
            " ", "\"\<rhombitrihexagonal\>\""}], "}"}]}]}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"readouts", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "All", ",", " ", "2"}], "]"}], "]"}], ",", 
        " ", 
        RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
        RowBox[{"AxesLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Text", "[", "\"\<r\>\"", "]"}], ",", " ", 
