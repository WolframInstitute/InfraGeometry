Cell["\<\
At the smallest scale the beam fans out over a wide region and its endpoints \
fill it. Every member starts at the germ, so the density is highest there, \
and the most visited member is the one that stays near the germ: it circles \
around the end of the germ. A geodesic at a small scale may revisit a vertex, \
and these members do.\
\>", "Item",ExpressionUUID->"672aeead-0917-4cbe-a0d1-f46293acdb19"],

Cell["\<\
From a scale on the endpoints gather on a short arc and the most visited \
members run straight away from the germ. At the middle scale this has \
happened on the triangular tiling only; the square and the hexagonal tilings \
still bend.\
\>", "Item",ExpressionUUID->"eb5df3fb-1c3d-42af-956c-7f193eb40584"],

Cell["\<\
The straight members need not continue the germ's direction: a lattice keeps \
a direction only up to the cone of its lattice directions.\
\>", "Item",ExpressionUUID->"2564cfa6-ea3e-4367-88e0-9cf38c9746ad"],

Cell["The scale of straightness", "Section",ExpressionUUID->"486ebc33-4d98-4bd1-ae25-3d8cacb6ef40"],

Cell[TextData[{
 "Two readouts of the most visited members, for every scale ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["r", "TI"], "=", "2"}], ",", "\[Ellipsis]", ",", "10"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "450c7a8d-cd14-4551-9c78-e71a0cd7f553"],
 ", each the worst over the ties. The extension is a member without the \
germ."
}], "Item",ExpressionUUID->"c2ffa0fb-06b6-42b3-8469-ab0ac9311121"],

Cell[TextData[{
 "The ",
 StyleBox["excess",
  FontWeight->"Bold"],
 " of an extension is its length minus the distance between its ends. It is \
zero exactly when the extension is a segment, so the threshold ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["r", "TI"], "*"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "131ce8ee-37de-4aa7-a30b-30e095869c37"],
 " is the scale where the excess first vanishes."
}], "Item",ExpressionUUID->"fbb04b0b-b4d4-41c3-b480-26d2aacfa6c1"],

Cell[TextData[{
 "The ",
 StyleBox["chord deviation",
  FontWeight->"Bold"],
 " is the largest distance of the extension's vertices from the chord joining \
its ends, in units of the edge length, read in the plane."
}], "Item",ExpressionUUID->"60ca1444-7144-41a5-8c83-078128f48965"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"readouts", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "      ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
             RowBox[{"InfraSubstrate", "[", 
              RowBox[{"name", ",", " ", "\"\<Large\>\"", ",", " ", 
               RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
              "]"}]}], ")"}]}], "}"}], ",", "\n", "      ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"c", " ", "=", " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
           RowBox[{"d", " ", "=", " ", 
            RowBox[{"GraphDistanceMatrix", "[", "g", "]"}]}], ",", " ", 
           RowBox[{"xy", " ", "=", " ", 
            RowBox[{"AssociationThread", "[", 
             RowBox[{
              RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
              RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}]}], "}"}], ",",
          "\n", "      ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"germ", " ", "=", " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"RandomInfraRepresentative", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSegment", "[", 
                RowBox[{
                 RowBox[{"First", " ", "@", " ", 
                  RowBox[{"FindInfraShell", "[", 
                   RowBox[{"g", ",", " ", "c", ",", " ", "8"}], "]"}]}], ",", 
                 " ", "c"}], "]"}], ",", " ", "1"}], "]"}]}]}], ",", "\n", 
           "       ", 
           RowBox[{"unit", " ", "=", " ", 
            RowBox[{"EuclideanDistance", " ", "@@", " ", 
             RowBox[{"Lookup", "[", 
              RowBox[{"xy", ",", " ", 
               RowBox[{"List", " ", "@@", " ", 
                RowBox[{"First", " ", "@", " ", 
                 RowBox[{"EdgeList", " ", "@", " ", "g"}]}]}]}], "]"}]}]}]}], 
          "}"}], ",", "\n", "      ", 
         RowBox[{"Table", "[", "\n", "        ", 
          RowBox[{
           RowBox[{"With", "[", "\n", "          ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"walks", " ", "=", " ", 
               RowBox[{"RandomInfraGeodesic", "[", 
                RowBox[{"g", ",", " ", "germ", ",", " ", "r", ",", " ", 
                 RowBox[{"{", "10", "}"}], ",", " ", "All"}], "]"}]}], "}"}], 
             ",", "\n", "          ", 
             RowBox[{"{", 
              RowBox[{"ext", " ", "=", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"Drop", "[", 
                  RowBox[{
                   RowBox[{"Last", " ", "/@", " ", 
                    RowBox[{"Sort", " ", "@", " ", 
                    RowBox[{"VertexList", " ", "@", " ", "#"}]}]}], ",", " ", 
                   
                   RowBox[{
                    RowBox[{"Length", "[", "germ", "]"}], " ", "-", " ", 
                    "1"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
                RowBox[{"SelectInfraWalk", "[", 
                 RowBox[{"g", ",", " ", "walks", ",", " ", "All", ",", " ", 
                  
                  RowBox[{"\"\<From\>\"", " ", "->", 
                   " ", "\"\<MostVisited\>\""}]}], "]"}]}]}], "}"}], ",", 
             "\n", "          ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"r", ",", " ", 
                 RowBox[{"Max", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "#", "]"}], " ", "-", " ", "1", 
                    " ", "-", " ", 
                    RowBox[{"d", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"VertexIndex", "[", 
                    RowBox[{"g", ",", " ", 
                    RowBox[{"First", " ", "@", " ", "#"}]}], "]"}], ",", " ", 
                    
                    RowBox[{"VertexIndex", "[", 
                    RowBox[{"g", ",", " ", 
                    RowBox[{"Last", " ", "@", " ", "#"}]}], "]"}]}], "]"}], 
                    "]"}]}], " ", "&"}], " ", "/@", " ", "ext"}], "]"}]}], 
                "}"}], ",", "\n", "           ", 
               RowBox[{"{", 
                RowBox[{"r", ",", " ", 
                 RowBox[{
                  RowBox[{"Max", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Max", "[", 
                    RowBox[{"RegionDistance", "[", 
                    RowBox[{
                    RowBox[{"Line", "[", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"xy", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"First", " ", "@", " ", "#"}], ",", " ", 
                    RowBox[{"Last", " ", "@", " ", "#"}]}], "}"}]}], "]"}], 
                    "]"}], ",", " ", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"xy", ",", " ", "#"}], "]"}]}], "]"}], "]"}], " ",
                     "&"}], " ", "/@", " ", "ext"}], "]"}], " ", "/", " ", 
                  "unit"}]}], "}"}]}], "}"}]}], "]"}], ",", "\n", "        ", 
           
           RowBox[{"{", 
            RowBox[{"r", ",", " ", "2", ",", " ", "10"}], "}"}]}], "]"}]}], 
        "]"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
           " ", "\"\<TriangularTilingGraph\>\"", ",", 
           " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"readouts", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "All", ",", " ", "1"}], "]"}], "]"}], ",", 
        " ", 
        RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
        RowBox[{"AxesLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Text", "[", "\"\<r\>\"", "]"}], ",", " ", 
           RowBox[{"Text", "[", "\"\<excess\>\"", "]"}]}], "}"}]}], ",", "\n",
         "      ", 
        RowBox[{"PlotLegends", " ", "->", " ", 
         RowBox[{"Text", " ", "/@", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<square\>\"", ",", " ", "\"\<triangular\>\"", ",", 
            " ", "\"\<hexagonal\>\""}], "}"}]}]}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"readouts", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "All", ",", " ", "2"}], "]"}], "]"}], ",", 
        " ", 
        RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
        RowBox[{"AxesLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Text", "[", "\"\<r\>\"", "]"}], ",", " ", 
           RowBox[{"Text", "[", "\"\<deviation\>\"", "]"}]}], "}"}]}], ",", 
        "\n", "      ", 
        RowBox[{"PlotLegends", " ", "->", " ", 
         RowBox[{"Text", " ", "/@", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<square\>\"", ",", " ", "\"\<triangular\>\"", ",", 
            " ", "\"\<hexagonal\>\""}], "}"}]}]}]}], "]"}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"f336cbf0-cd18-4515-bc15-4fbf5429520c"],

