Notebook[{

Cell[CellGroupData[{
Cell["Straightening at a Scale", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 "A ",
 StyleBox["germ",
  FontWeight->"Bold"],
 " is a short shortest path, here of three edges ending at the centre of the \
graph. We extend it forward by ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a9d35fd-81ad-4a8f-94b1-96b78278bae7"],
 " steps."
}], "Item",ExpressionUUID->"9b2ee3c9-a3e0-45e4-a468-274099a59d9b"],

Cell[TextData[{
 "A walk is a ",
 StyleBox["geodesic at infra-scale",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b09977c6-c21f-40b5-9053-62b644f1f0f0"],
 " when every ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df81f115-ca7e-4c39-813f-eae1a93a2277"],
 " consecutive vertices of it form a shortest path. The observer checks \
straightness only within a horizon of ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d441a41f-d25c-4d00-a48f-4dc2591a54d8"],
 " steps; at scale ",
 Cell[BoxData["\[Infinity]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97186f9a-cdec-40d0-9c49-4766b0fc3441"],
 " the whole walk is a shortest path."
}], "Item",ExpressionUUID->"69edd2db-744f-44cf-a610-77a8a28dd0d4"],

Cell[TextData[{
 "The ",
 StyleBox["beam",
  FontWeight->"Bold"],
 " of the germ at scale ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed496bd0-0132-4352-acfc-7a87129c4184"],
 " is the set of all geodesics at scale ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bcb045ed-42fe-4e6d-b3f5-f0f3adf063d5"],
 " that extend the germ by ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2f30536-efde-48e3-8e2b-b66c4c2f2d27"],
 " steps. Its ",
 StyleBox["vertex density",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a767300d-e7a4-45fd-b88a-b80cf92798d1"],
 " counts the visits of its members to ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a7daad5-556e-4ec6-ac44-1b8fa5c22b43"],
 ", and its edge density counts the traversals of an edge. A ",
 StyleBox["most visited",
  FontWeight->"Bold"],
 " member is one that maximizes the sum of the vertex and edge densities \
along it."
}], "Item",ExpressionUUID->"bf9fd932-07cb-4246-86a0-1b0316fb96e1"],

Cell[TextData[{
 "The question: from which scale ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["r", "TI"], "*"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c81c2d31-870f-46d3-93bb-2122e8b423d4"],
 " on is the most visited member of the beam a ",
 StyleBox["segment",
  FontWeight->"Bold"],
 ", a shortest path between its ends? We answer it on three lattices."
}], "Item",ExpressionUUID->"229b18e2-6516-46df-ab84-f9954f8f5aee"],

Cell[TextData[{
 "The beam is never listed. The geodesics at scale ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c158b9b-afcc-46dc-856a-5061ce7c6be2"],
 " through the germ are the walks of the ",
 StyleBox["window graph",
  FontWeight->"Bold"],
 ": a vertex is a window, the last ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14e09656-5ca5-4b60-95bf-2550ed3ea473"],
 " vertices of a walk, and an arrow appends one admissible step. The members \
of the beam are the walks of ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0460976d-ac38-471f-81cd-3e75660a5157"],
 " edges from the germ's window, so the densities and the most visited \
members are read off powers of its adjacency matrix."
}], "Item",ExpressionUUID->"eefa0fee-b804-4b75-b8d9-74fc70493b87"],

Cell["\<\
The pictures keep the embedding of the substrate so that the reader sees the \
plane; only the chord deviation below uses it.\
\>", "Item",ExpressionUUID->"145b4a4e-8748-4fd4-8d74-ee54bdc9711f"],

Cell["Setup", "Section",ExpressionUUID->"3ae31806-025d-44d2-b0eb-6b9b6049e3c9"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`InfraGeometry`\>\"", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7128488a-cbc4-45ce-9a15-ad0c71aae55e"],

Cell[TextData[{
 "The germ: a shortest path from the first vertex of the shell of radius ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88ce2d69-5022-435d-b0c0-7a8256d1fbb3"],
 " about the centre to the centre."
}], "Text",ExpressionUUID->"12e39f36-3348-4806-a375-3be02e532072"],

Cell[BoxData[
 RowBox[{
  RowBox[{"germ", "[", "g_", "]"}], " ", ":=", " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"c", " ", "=", " ", 
      RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", " ", 
    RowBox[{"First", " ", "@", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"FindInfraShell", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}], ",", " ", 
         "c"}], "]"}], ",", " ", "1"}], "]"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f43f7902-3366-46c6-8296-530cbace8e67"],

Cell[TextData[{
 "The beam of ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab47194f-4e7e-4696-be01-4b9006910ceb"],
 " steps at scale ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5a89bf4-6499-43e6-95ba-173b9686b607"],
 ". With ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "713fc7cc-b913-4f9f-892a-9c09ae5cd67c"],
 " the adjacency matrix of the window graph and ",
 Cell[BoxData[
  StyleBox["e", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2f35057-68a4-40dc-bbd4-0f3d3f2c58d5"],
 " the indicator of the germ's window, the forward counts ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["f", "TI"], 
    StyleBox["i", "TI"]], "=", 
   StyleBox["e", "TI"], 
   SuperscriptBox[
    StyleBox["A", "TI"], 
    StyleBox["i", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55dae6b8-aea0-4e91-94df-aba80d25bf74"],
 " count the members that reach a window after ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c404936-855f-4bb9-9c00-02ecc61eb621"],
 " steps, and the backward counts ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["i", "TI"]], "=", 
   SuperscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["k", "TI"], "-", 
     StyleBox["i", "TI"]}]], 
   StyleBox["1",
    FontWeight->"Bold",
    FontSlant->"Plain"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "584bcbf7-84d7-4eee-a064-8ea5212b1734"],
 " count the ways to finish from it."
}], "Text",ExpressionUUID->"83a6dd4d-1ff5-47f5-a387-a74fd6a89998"],

Cell[BoxData[
 RowBox[{
  RowBox[{"beam", "[", 
   RowBox[{"g_", ",", " ", "germWalk_", ",", " ", "r_", ",", " ", "k_"}], 
   "]"}], " ", ":=", " ", 
  RowBox[{"With", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"windows", " ", "=", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraGeodesic", "[", 
         RowBox[{"germWalk", ",", " ", "r"}], "]"}], ",", 
        " ", "\"\<Graph\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"AdjacencyMatrix", "[", "windows", "]"}]}], "}"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"from", " ", "=", " ", 
      RowBox[{"UnitVector", "[", 
       RowBox[{
        RowBox[{"VertexCount", "[", "windows", "]"}], ",", " ", 
        RowBox[{"VertexIndex", "[", 
         RowBox[{"windows", ",", " ", 
          RowBox[{"Take", "[", 
           RowBox[{"germWalk", ",", " ", 
            RowBox[{"-", 
             RowBox[{"Min", "[", 
              RowBox[{"r", ",", " ", 
               RowBox[{"Length", "[", "germWalk", "]"}]}], "]"}]}]}], "]"}]}],
          "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Germ\>\"", " ", "->", " ", "germWalk"}], ",", " ", 
      RowBox[{"\"\<Windows\>\"", " ", "->", " ", "windows"}], ",", "\n", 
      "    ", 
      RowBox[{"\"\<Forward\>\"", " ", "->", " ", 
       RowBox[{"NestList", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", " ", ".", " ", "a"}], " ", "&"}], ",", " ", "from", ",",
          " ", "k"}], "]"}]}], ",", "\n", "    ", 
      RowBox[{"\"\<Backward\>\"", " ", "->", " ", 
       RowBox[{"Reverse", " ", "@", " ", 
        RowBox[{"NestList", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"a", " ", ".", " ", "#"}], " ", "&"}], ",", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"1", ",", " ", 
            RowBox[{"VertexCount", "[", "windows", "]"}]}], "]"}], ",", " ", 
          "k"}], "]"}]}]}]}], "|>"}]}], "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"fe15b50e-ba7b-447e-b5e0-2287f07315d1"],

Cell[TextData[{
 "The vertex density: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["i", "TI"], "=", "0"}], 
    StyleBox["k", "TI"],
    LimitsPositioning->False], 
   UnderscriptBox["\[Sum]", 
    StyleBox["w", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["f", "TI"], 
    StyleBox["i", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["w", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   SubscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["i", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["w", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23674692-96d3-42bb-980f-1a1496cb0090"],
 " over the windows ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "261632c8-baaa-4916-a98c-4c01940136f8"],
 " ending at ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "033fcd9b-ec54-484c-a244-3fdde4fbc003"],
 "; every member runs through the earlier vertices of the germ."
}], "Text",ExpressionUUID->"978185f4-48dd-4eb4-8f1f-81f5ecdcf3cf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"beamDensity", "[", "beam_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"Select", "[", "Positive", "]"}], " ", "@", " ", 
   RowBox[{"Merge", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Counts", "[", 
         RowBox[{"Most", " ", "@", " ", 
          RowBox[{"beam", "[", "\"\<Germ\>\"", "]"}]}], "]"}], " ", 
        RowBox[{"Total", "[", 
         RowBox[{"Last", " ", "@", " ", 
          RowBox[{"beam", "[", "\"\<Forward\>\"", "]"}]}], "]"}]}], ",", "\n",
        "    ", 
       RowBox[{"Merge", "[", 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Last", " ", "/@", " ", 
             RowBox[{"VertexList", "[", 
              RowBox[{"beam", "[", "\"\<Windows\>\"", "]"}], "]"}]}], ")"}], 
           " ", "->", " ", 
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{"beam", "[", "\"\<Forward\>\"", "]"}], " ", 
             RowBox[{"beam", "[", "\"\<Backward\>\"", "]"}]}], "]"}]}], "]"}],
          ",", " ", "Total"}], "]"}]}], "}"}], ",", "\n", "  ", "Total"}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"6b27895b-a368-4ead-b72c-27a297f9b389"],

Cell[TextData[{
 "The endpoints, each with the number of members ending there: ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["f", "TI"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01110bab-e6f7-4c29-8581-3b248ffd7d5f"],
 " on the windows ending at a vertex."
}], "Text",ExpressionUUID->"f5b7c83e-e055-4d99-b822-5690ce3360c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"beamEndpoints", "[", "beam_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"Select", "[", "Positive", "]"}], " ", "@", " ", 
   RowBox[{"Merge", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Last", " ", "/@", " ", 
         RowBox[{"VertexList", "[", 
          RowBox[{"beam", "[", "\"\<Windows\>\"", "]"}], "]"}]}], ")"}], " ", 
       "->", " ", 
       RowBox[{"Last", "[", 
        RowBox[{"beam", "[", "\"\<Forward\>\"", "]"}], "]"}]}], "]"}], ",", 
     " ", "Total"}], "]"}]}]}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"e03ae598-fe2b-40b2-bba8-34812d4fb36a"],

Cell[TextData[{
 "The edge density: ",
 Cell[BoxData[
  RowBox[{"\[Epsilon]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"u", "v"}], "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["i", "TI"], "=", "0"}], 
    RowBox[{
     StyleBox["k", "TI"], "-", "1"}],
    LimitsPositioning->False], 
   StyleBox["\[Sum]",
    FontSize->1.15 Inherited], 
   SubscriptBox[
    StyleBox["f", "TI"], 
    StyleBox["i", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["w", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   SubscriptBox[
    StyleBox["b", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "+", "1"}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["w", "TI"], "\[Prime]"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb9d9fed-8759-41a8-97a8-f772d68f0972"],
 " over the arrows ",
 Cell[BoxData[
  RowBox[{
   StyleBox["w", "TI"], "\[Rule]", 
   SuperscriptBox[
    StyleBox["w", "TI"], "\[Prime]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e39fcc5-8c90-4d81-ba22-10bbd1c3ccc6"],
 " of the window graph stepping between ",
 Cell[BoxData[
  StyleBox["u", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db9352ad-98ea-4bf8-80b7-52839d0be335"],
 " and ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fafe743e-8f63-43fa-bcfd-8270e78e7d14"],
 "."
}], "Text",ExpressionUUID->"71ee0a34-3ed2-44ec-b522-7b0f59223d17"],

Cell[BoxData[
 RowBox[{
  RowBox[{"beamEdgeDensity", "[", "beam_", "]"}], " ", ":=", " ", 
  RowBox[{"With", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"tips", " ", "=", " ", 
       RowBox[{"Last", " ", "/@", " ", 
        RowBox[{"VertexList", "[", 
         RowBox[{"beam", "[", "\"\<Windows\>\"", "]"}], "]"}]}]}], ",", " ", 
      RowBox[{"steps", " ", "=", " ", 
       RowBox[{
        RowBox[{"AdjacencyMatrix", "[", 
         RowBox[{"beam", "[", "\"\<Windows\>\"", "]"}], "]"}], 
        "[", "\"\<NonzeroPositions\>\"", "]"}]}]}], "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"Select", "[", "Positive", "]"}], " ", "@", " ", 
     RowBox[{"Merge", "[", 
      RowBox[{
       RowBox[{"{", "\n", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{"Counts", "[", 
           RowBox[{"Sort", " ", "/@", " ", 
            RowBox[{"Partition", "[", 
             RowBox[{
              RowBox[{"beam", "[", "\"\<Germ\>\"", "]"}], ",", " ", "2", ",", 
              " ", "1"}], "]"}]}], "]"}], " ", 
          RowBox[{"Total", "[", 
           RowBox[{"Last", " ", "@", " ", 
            RowBox[{"beam", "[", "\"\<Forward\>\"", "]"}]}], "]"}]}], ",", 
         "\n", "      ", 
         RowBox[{"Merge", "[", 
          RowBox[{
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"Sort", " ", "/@", " ", 
               RowBox[{"Map", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"tips", "[", 
                   RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], ",", " ", 
                 "steps"}], "]"}]}], ")"}], " ", "->", "\n", "        ", 
             RowBox[{"Total", " ", "@", " ", 
              RowBox[{"MapThread", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"#1", "[", 
                   RowBox[{"[", 
                    RowBox[{"steps", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}], 
                   "]"}], " ", 
                  RowBox[{"#2", "[", 
                   RowBox[{"[", 
                    RowBox[{"steps", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], 
                   "]"}]}], " ", "&"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Most", " ", "@", " ", 
                   RowBox[{"beam", "[", "\"\<Forward\>\"", "]"}]}], ",", " ", 
                  
                  RowBox[{"Rest", " ", "@", " ", 
                   RowBox[{"beam", "[", "\"\<Backward\>\"", "]"}]}]}], 
                 "}"}]}], "]"}]}]}], "]"}], ",", " ", "Total"}], "]"}]}], 
        "}"}], ",", "\n", "    ", "Total"}], "]"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"807d5f37-0626-4662-b71c-e8a46fd908b3"],

Cell[TextData[{
 "The most visited members: a longest path through the layers ",
 Cell[BoxData[
  RowBox[{"0", ",", "\[Ellipsis]", ",", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4143984-b339-4f3e-b132-146522426b6e"],
 " of the window graph, each step weighted by ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a39b4bed-02d7-490f-a673-2e0944f249e6"],
 " of the vertex it reaches and ",
 Cell[BoxData["\[Epsilon]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2e1ceb7-638c-4852-86b1-f7dbf07c5c7f"],
 " of the edge it uses. The window determines the walk, so every maximal \
chain of windows is one most visited member, and all ties are kept."
}], "Text",ExpressionUUID->"d89795a0-4150-46fc-93ec-98f522cdb226"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mostVisited", "[", "beam_", "]"}], " ", ":=", " ", 
  RowBox[{"With", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"tips", " ", "=", " ", 
       RowBox[{"Last", " ", "/@", " ", 
        RowBox[{"VertexList", "[", 
         RowBox[{"beam", "[", "\"\<Windows\>\"", "]"}], "]"}]}]}], ",", " ", 
      RowBox[{"steps", " ", "=", " ", 
       RowBox[{
        RowBox[{"AdjacencyMatrix", "[", 
         RowBox[{"beam", "[", "\"\<Windows\>\"", "]"}], "]"}], 
        "[", "\"\<NonzeroPositions\>\"", "]"}]}], ",", "\n", "   ", 
      RowBox[{"rho", " ", "=", " ", 
       RowBox[{"beamDensity", "[", "beam", "]"}]}], ",", " ", 
      RowBox[{"eps", " ", "=", " ", 
       RowBox[{"beamEdgeDensity", "[", "beam", "]"}]}], ",", " ", 
      RowBox[{"fw", " ", "=", " ", 
       RowBox[{"beam", "[", "\"\<Forward\>\"", "]"}]}], ",", " ", 
      RowBox[{"bw", " ", "=", " ", 
       RowBox[{"beam", "[", "\"\<Backward\>\"", "]"}]}]}], "}"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"layers", " ", "=", " ", 
      RowBox[{"Table", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"live", " ", "=", " ", 
            RowBox[{"Pick", "[", 
             RowBox[{"steps", ",", " ", 
              RowBox[{"Sign", "[", 
               RowBox[{
                RowBox[{"fw", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", " ", 
                   RowBox[{"steps", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}], 
                 "]"}], " ", 
                RowBox[{"bw", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"i", " ", "+", " ", "1"}], ",", " ", 
                   RowBox[{"steps", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}], 
                 "]"}]}], "]"}], ",", " ", "1"}], "]"}]}], "}"}], ",", "\n", 
          "      ", 
          RowBox[{"Thread", "[", 
           RowBox[{"live", " ", "->", " ", 
            RowBox[{
             RowBox[{"Lookup", "[", 
              RowBox[{"rho", ",", " ", 
               RowBox[{"tips", "[", 
                RowBox[{"[", 
                 RowBox[{"live", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], 
                "]"}]}], "]"}], " ", "+", " ", 
             RowBox[{"Lookup", "[", 
              RowBox[{"eps", ",", " ", 
               RowBox[{"Key", " ", "/@", " ", 
                RowBox[{"Sort", " ", "/@", " ", 
                 RowBox[{"Map", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"tips", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], ",", " ", 
                   "live"}], "]"}]}]}]}], "]"}]}]}], "]"}]}], "]"}], ",", 
        "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{
           RowBox[{"Length", "[", "fw", "]"}], " ", "-", " ", "1"}]}], 
         "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"best", " ", "=", " ", 
      RowBox[{"FoldList", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"score", ",", " ", "layer"}], "}"}], " ", "|->", " ", 
         RowBox[{"GroupBy", "[", 
          RowBox[{"layer", ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], " ", "&"}], " ", "->",
             " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"score", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], " ", "+",
                " ", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], " ", "&"}], ")"}]}], ",", 
           " ", "Max"}], "]"}]}], ",", "\n", "    ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Ordering", "[", 
            RowBox[{
             RowBox[{"First", " ", "@", " ", "fw"}], ",", " ", 
             RowBox[{"-", "1"}]}], "]"}]}], " ", "->", " ", "0"}], "|>"}], ",",
         " ", "layers"}], "]"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"tight", " ", "=", " ", 
      RowBox[{"Graph", " ", "@", " ", 
       RowBox[{"Catenate", " ", "@", " ", 
        RowBox[{"Table", "[", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"DirectedEdge", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"i", " ", "-", " ", "1"}], ",", " ", 
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], "}"}], ",", 
              " ", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", 
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], "}"}]}], 
             "]"}], " ", "&"}], " ", "/@", "\n", "      ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"layers", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"best", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", " ", 
                   RowBox[{"Key", " ", "@", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}]}], "]"}], 
                 "]"}], " ", "+", " ", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], " ", "==", " ", 
               RowBox[{"best", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"i", " ", "+", " ", "1"}], ",", " ", 
                  RowBox[{"Key", " ", "@", " ", 
                   RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}]}], "]"}], 
                "]"}]}], " ", "&"}]}], "]"}]}], ",", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", 
            RowBox[{"Length", "[", "layers", "]"}]}], "}"}]}], "]"}]}]}]}], 
     "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"beam", "[", "\"\<Germ\>\"", "]"}], ",", " ", 
        RowBox[{"tips", "[", 
         RowBox[{"[", 
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"2", " ", ";;"}], ",", " ", "2"}], "]"}], "]"}], "]"}], 
         "]"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"Catenate", " ", "@", " ", 
      RowBox[{"Map", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"FindPath", "[", 
          RowBox[{"tight", ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"First", " ", "@", " ", 
              RowBox[{"Keys", " ", "@", " ", 
               RowBox[{"First", " ", "@", " ", "best"}]}]}]}], "}"}], ",", 
           " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Length", "[", "layers", "]"}], ",", " ", "#"}], "}"}], ",",
            " ", "Infinity", ",", " ", "All"}], "]"}], " ", "&"}], ",", "\n", 
        "    ", 
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"MaximalBy", "[", 
          RowBox[{
           RowBox[{"Last", " ", "@", " ", "best"}], ",", " ", "Identity"}], 
          "]"}]}]}], "]"}]}]}]}], "]"}]}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"a91e5b74-55a7-4778-9ed0-d5bfa7f762b0"],

Cell["\<\
The chord deviation of a walk: the largest distance of its vertices from the \
chord joining its ends, in units of the edge length. It is the one readout \
that uses the embedding.\
\>", "Text",ExpressionUUID->"163da77f-b481-4c15-bd23-d4d335c6cc90"],

Cell[BoxData[
 RowBox[{
  RowBox[{"deviation", "[", 
   RowBox[{"g_", ",", " ", "walk_"}], "]"}], " ", ":=", " ", 
  RowBox[{"With", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"xy", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"unit", " ", "=", " ", 
      RowBox[{"Mean", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"EuclideanDistance", " ", "@@", " ", 
          RowBox[{"Lookup", "[", 
           RowBox[{"xy", ",", " ", 
            RowBox[{"List", " ", "@@", " ", "#"}]}], "]"}]}], " ", "&"}], " ",
         "/@", " ", 
        RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
    "  ", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"RegionDistance", "[", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"xy", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"First", " ", "@", " ", "walk"}], ",", " ", 
               RowBox[{"Last", " ", "@", " ", "walk"}]}], "}"}]}], "]"}], 
           "]"}], ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"Lookup", "[", 
        RowBox[{"xy", ",", " ", "walk"}], "]"}]}], "]"}], " ", "/", " ", 
     "unit"}]}], "]"}]}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"a4bc3828-52a4-4cfd-b749-2fb2db4802a7"],

Cell["The beam at a scale", "Section",ExpressionUUID->"a91f66d2-2b36-4b56-a27d-ce0d4733e56e"],

Cell[TextData[{
 "Each picture is one lattice at one scale: the rows are the square, the \
triangular and the hexagonal tiling, the columns the scales ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["r", "TI"], "=", "2"}], ",", 
   RowBox[{"4", ",", "8"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62e24612-098a-4b16-a3db-060624ebe271"],
 ". The beam extends the germ by ten steps."
}], "Item",ExpressionUUID->"33112046-4b10-496f-867e-bb4df264082c"],

Cell["\<\
The vertex density of the beam is orange, its endpoints green, each sized by \
the number of members ending there. The most visited members are red, all of \
them; the germ is drawn last.\
\>", "Item",ExpressionUUID->"920f5fad-a87a-4a0c-95c0-80367636bec4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "\"\<Large\>\"", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"germWalk", " ", "=", " ", 
        RowBox[{"germ", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"beam", "[", 
         RowBox[{"g", ",", " ", "germWalk", ",", " ", "r", ",", " ", "10"}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", "\n", "      ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"beamDensity", "[", "b", "]"}], " ", "->", " ", 
           "StandardOrange"}], ",", " ", 
          RowBox[{
           RowBox[{"beamEndpoints", "[", "b", "]"}], " ", "->", " ", 
           "StandardGreen"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraWalk", " ", "/@", " ", 
            RowBox[{"mostVisited", "[", "b", "]"}]}], " ", "->", " ", 
           "StandardRed"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "germWalk", "]"}], " ", "->", " ", 
           "StandardOrange"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"r", ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4", ",", " ", "8"}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"80aac89e-0663-4086-ba82-9248428658fa"],

