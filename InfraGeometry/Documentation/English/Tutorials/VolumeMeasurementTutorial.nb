Cell["\<\
Two Wolfram models, in the introduction's reading only. The first at the \
centre of its states after 500, 1000, \[Ellipsis], 2500 steps; the second \
averaged over a random sample of vertices of the same states. Both against \
the dimension two.\
\>", "Text",ExpressionUUID->"d8bd650f-0465-4e38-9fa8-bbc4427e7f40"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Show", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"ListLinePlot", "[", "\n", "      ", 
       RowBox[{"Table", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"With", "[", "\n", "          ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"g", " ", "=", " ", 
             RowBox[{"UndirectedGraph", " ", "@", " ", 
              RowBox[{
               RowBox[{
               "ResourceFunction", "[", "\"\<HypergraphToGraph\>\"", "]"}], "[", 
               RowBox[{"Quiet", " ", "@", " ", 
                RowBox[{
                 RowBox[{
                 "ResourceFunction", "[", "\"\<WolframModel\>\"", "]"}], "[", 
                 
                 RowBox[{
                  RowBox[{"First", "[", "spec", "]"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", 
                    " ", 
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], 
                   "}"}], ",", " ", "steps", ",", " ", "\"\<FinalState\>\""}],
                  "]"}]}], "]"}]}]}], "}"}], ",", "\n", "          ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"top", " ", "=", " ", 
              RowBox[{"GraphRadius", "[", "g", "]"}]}], ",", " ", 
             RowBox[{"seeds", " ", "=", " ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"Last", "[", "spec", "]"}], ",", " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
                  RowBox[{"RandomSample", "[", 
                   RowBox[{
                    RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "32"}], 
                   "]"}]}], ")"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"First", " ", "@", " ", 
                  RowBox[{"GraphCenter", "[", "g", "]"}]}], "}"}]}], 
               "]"}]}]}], "}"}], ",", "\n", "          ", 
           RowBox[{"LogDifferenceQuotients", "[", 
            RowBox[{"MeanAround", " ", "/@", " ", 
             RowBox[{"Transpose", " ", "@", " ", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"InfraMeasurement", "[", 
                 RowBox[{"g", ",", " ", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"InfraBall", "[", 
                    RowBox[{"seed", ",", " ", "r"}], "]"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"r", ",", " ", "0", ",", " ", "top"}], "}"}]}], 
                   "]"}], ",", " ", "\"\<CountingMeasure\>\""}], "]"}], ",", 
                " ", 
                RowBox[{"{", 
                 RowBox[{"seed", ",", " ", "seeds"}], "}"}]}], "]"}]}]}], 
            "]"}]}], "]"}], ",", "\n", "        ", 
         RowBox[{"{", 
          RowBox[{
          "steps", ",", " ", "500", ",", " ", "2500", ",", " ", "500"}], 
          "}"}]}], "]"}], "]"}], ",", "\n", "    ", 
      RowBox[{"GridLines", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"None", ",", " ", 
         RowBox[{"{", "2", "}"}]}], "}"}]}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
