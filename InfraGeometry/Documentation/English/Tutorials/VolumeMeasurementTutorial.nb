Cell[TextData[{
 "The profiles over the slope ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["m", "TI"], "=", "0"}], ",", 
   FractionBox["1", "8"], ",", "\[Ellipsis]", ",", 
   FractionBox["3", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e14998e1-c901-497f-9b10-bfea85b2176d"],
 ": the cone as points, the ball of radius ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftFloor]",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"m", "R"}], "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightFloor]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da89a927-907c-4b2b-90a6-9df88e82d210"],
 " about the far end as joined points, the counting measure in the first \
colour and the Riemannian measure in the second."
}], "Text",ExpressionUUID->"30174611-2371-49ed-b5f0-088f01210b9e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "size"}], "]"}]}], ")"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p", " ", "=", " ", 
         RowBox[{"farEnd", "[", "g", "]"}]}], ",", " ", 
        RowBox[{"radius", " ", "=", " ", 
         RowBox[{"profileRadius", "[", "g", "]"}]}], ",", " ", 
        RowBox[{"slopes", " ", "=", " ", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"3", "/", "2"}], ",", " ", 
           RowBox[{"1", "/", "8"}]}], "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"geodesic", " ", "=", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "p"}], 
           "]"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Show", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"ListLinePlot", "[", 
         RowBox[{
          RowBox[{"twoMeasures", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"InfraBall", "[", 
               RowBox[{"p", ",", " ", 
                RowBox[{"Floor", "[", 
                 RowBox[{"m", " ", "radius"}], "]"}]}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"m", ",", " ", "slopes"}], "}"}]}], "]"}]}], "]"}], ",",
           " ", 
          RowBox[{"DataRange", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"3", "/", "2"}]}], "}"}]}]}], "]"}], ",", "\n", "      ", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"twoMeasures", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"InfraCone", "[", 
               RowBox[{"geodesic", ",", " ", "m"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"m", ",", " ", "slopes"}], "}"}]}], "]"}]}], "]"}], ",",
           " ", 
          RowBox[{"DataRange", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"3", "/", "2"}]}], "}"}]}]}], "]"}], ",", "\n", "      ", 
        RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"size", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
        " ", "\"\<Large\>\""}], "}"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

