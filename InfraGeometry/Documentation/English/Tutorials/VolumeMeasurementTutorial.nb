Cell[TextData[{
 "The Sierpinski graphs of six and seven steps, against the Hausdorff \
dimension ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", "3", "/", 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6f08520-0939-4200-8397-44a737450418"],
 ". The introduction averages the profiles over all vertices, here over a \
random sample of them."
}], "Text",ExpressionUUID->"1c4e4914-38b1-446b-8d0e-9a787c7a64ce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"IndexGraph", "[", 
         RowBox[{"MeshConnectivityGraph", "[", 
          RowBox[{
           RowBox[{"SierpinskiMesh", "[", "steps", "]"}], ",", " ", "0"}], 
          "]"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"top", " ", "=", " ", 
         RowBox[{"GraphRadius", "[", "g", "]"}]}], ",", " ", 
        RowBox[{"seeds", " ", "=", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
           RowBox[{"RandomSample", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "64"}], "]"}]}],
           ")"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"ballVolumes", " ", "=", " ", 
        RowBox[{"MeanAround", " ", "/@", " ", 
         RowBox[{"Transpose", " ", "@", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"InfraBall", "[", 
                 RowBox[{"seed", ",", " ", "r"}], "]"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"r", ",", " ", "0", ",", " ", "top"}], "}"}]}], 
               "]"}], ",", " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
            
            RowBox[{"{", 
             RowBox[{"seed", ",", " ", "seeds"}], "}"}]}], "]"}]}]}]}], "}"}],
       ",", "\n", "    ", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"LogDifferenceQuotients", "[", "ballVolumes", "]"}], ",", 
          " ", 
          RowBox[{"LogDifferenceQuotients", "[", 
           RowBox[{"Rest", "[", "ballVolumes", "]"}], "]"}]}], "}"}], ",", 
        " ", 
        RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
        RowBox[{"Joined", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"True", ",", " ", "False"}], "}"}]}], ",", " ", 
        RowBox[{"GridLines", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"None", ",", " ", 
           RowBox[{"{", 
            RowBox[{"Log", "[", 
             RowBox[{"2", ",", " ", "3"}], "]"}], "}"}]}], "}"}]}]}], "]"}]}],
      "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"steps", ",", " ", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "7"}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[30]:= ",ExpressionUUID->"07af2c04-3c50-481a-8b65-199b3ce2a065"],

