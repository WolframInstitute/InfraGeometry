Cell["\<\
The counting profile is linear on the tilings and close to linear on the \
mesh; the Riemannian profile is zero everywhere.\
\>", "Item",ExpressionUUID->"5d2d22f0-4a9c-46b6-b45c-627d9f24ee5a"],

Cell["Tubes", "Section",ExpressionUUID->"d9d99196-607a-4650-8321-f4b5de53ebc5"],

Cell[TextData[{
 "The tube of thickness ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42af7fca-d38a-4893-bbdb-e8a09149fcdc"],
 " about a set ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55bf19c0-2979-4bd8-a47b-70d4b47a3796"],
 " is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["s", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["X", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", "{", 
    StyleBox["v", "TI"]}], ":", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["v", "TI"], ",", 
     StyleBox["X", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[LessEqual]", 
    StyleBox["s", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6beee05c-8604-4719-b802-19f2b6cdbc70"],
 "; the tube about one vertex is the ball."
}], "Item",ExpressionUUID->"5177279d-85fc-49d4-be34-a7db25f80e1c"],

Cell[TextData[{
 "Two cores join the centre ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bae5c7a8-2290-4675-9ee9-4f5c6f0a01b6"],
 " to the far end ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6760a262-1431-44ec-ba0c-d05b708e36df"],
 ". The ",
 StyleBox["fat tube",
  FontWeight->"Bold"],
 " is the tube about the interval ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e01432e-b394-4e7a-87ab-273fee8e7c2a"],
 ", the union of all geodesics from ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f9fb770-9833-4982-b7f9-bc1dbf80dfba"],
 " to ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a37ceb2-cca4-4a94-a85c-494b3057cfa1"],
 ": the head ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTube"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "28376856-b17f-480b-9bec-bf70c8e29bad"],
 " on the segment. The ",
 StyleBox["thin tube",
  FontWeight->"Bold"],
 " is the tube about one geodesic ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48cb1a0c-8e92-49f7-8e24-22199a277854"],
 ": the head on a representative of the segment."
}], "Item",ExpressionUUID->"c7a031b2-773a-410a-8418-93058292ab3d"],

Cell[TextData[{
 "The interior of a tube is one layer thinner: for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "\[GreaterEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "309bd7a8-3cd4-4308-986f-5938eb1d86a9"],
 ", ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["Int",
     FontSlant->"Plain"], 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["s", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["X", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    SubscriptBox[
     StyleBox["T", "TI"], 
     RowBox[{
      StyleBox["s", "TI"], "-", "1"}]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["X", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[Union]", "{", 
    StyleBox["w", "TI"]}], ":", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["w", "TI"], ",", 
     StyleBox["X", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["s", "TI"]}], ",", 
   RowBox[{
    StyleBox[
     RowBox[{"\[NonBreakingSpace]", 
      RowBox[{
      "no", "\[NonBreakingSpace]", "neighbour", "\[NonBreakingSpace]", "of", 
       "\[NonBreakingSpace]"}]}],
     FontSlant->"Plain"], 
    StyleBox["w", "TI"], 
    StyleBox[
     RowBox[{"\[NonBreakingSpace]", 
      RowBox[{
      "at", "\[NonBreakingSpace]", "distance", "\[NonBreakingSpace]"}]}],
     FontSlant->"Plain"], 
    StyleBox["s", "TI"], "+", "1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d6f7899-3d04-496a-8476-f85256a2e520"],
 ". So the Riemannian measure of a tube is the counting measure of the tube \
one step thinner, together with the dead ends of its outer layer."
}], "Item",ExpressionUUID->"8a474545-3669-4e69-9fe8-e04e27962c20"],

Cell[TextData[{
 "On the square lattice the interval is a box of sides ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a", "TI"], "1"], ",", 
   SubscriptBox[
    StyleBox["a", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e56420e7-358b-40a8-aa00-2e84417934ff"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a", "TI"], "1"], "+", 
   SubscriptBox[
    StyleBox["a", "TI"], "2"], "=", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e462008e-a560-4f12-a40c-06957774a375"],
 ", and the fat tube holds ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["a", "TI"], "1"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["a", "TI"], "2"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "+", "2", 
   StyleBox["s", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["a", "TI"], "1"], "+", 
    SubscriptBox[
     StyleBox["a", "TI"], "2"], "+", "2"}], 
   StyleBox[")",
    SpanMaxSize->1], "+", "2", 
   StyleBox["s", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["s", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa774bc0-b3b2-472d-8747-2097472d0d97"],
 " vertices. The thin tube about a staircase geodesic has no closed form."
}], "Item",ExpressionUUID->"ae8c0390-aea6-432d-8293-0ac8d7c8dbe6"],

Cell[TextData[{
 "In the continuum the thin tube is the counterpart of Gray's tube about a \
geodesic of length ",
 Cell[BoxData[
  StyleBox["L", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9bb0ebf-7206-4280-889f-0b8244b9a28a"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Vol",
    FontSlant->"Plain"], 
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["s", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    RowBox[{
     StyleBox["n", "TI"], "-", "1"}]], 
   SuperscriptBox[
    StyleBox["s", "TI"], 
    RowBox[{
     StyleBox["n", "TI"], "-", "1"}]], 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   StyleBox["L", "TI"], "-", 
   FractionBox[
    SuperscriptBox[
     StyleBox["s", "TI"], "2"], 
    RowBox[{"6", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["n", "TI"], "+", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   UnderscriptBox["\[Integral]", 
    StyleBox["\[Gamma]", "TI"],
    LimitsPositioning->True], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["Scal",
     FontSlant->"Plain"], "+", 
    StyleBox["Ric",
     FontSlant->"Plain"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["\[Gamma]", "TI"], "."], ",", 
     OverscriptBox[
      StyleBox["\[Gamma]", "TI"], "."]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["s", "TI"], "4"], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1137b6ff-7444-4745-b7b8-736cef43cac2"],
 ", with the two end caps added; in Euclidean space the tube about a segment \
is the spherocylinder of volume ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    RowBox[{
     StyleBox["n", "TI"], "-", "1"}]], 
   SuperscriptBox[
    StyleBox["s", "TI"], 
    RowBox[{
     StyleBox["n", "TI"], "-", "1"}]], 
   StyleBox["L", "TI"], "+", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["n", "TI"]], 
   SuperscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "89e85827-567b-408f-9133-88e8ee27f3d2"],
 ". The fat tube has no such counterpart: its core is a box that grows with \
the offset of the two ends."
}], "Item",ExpressionUUID->"f19a511a-a0f2-46a5-82fb-fe276d8f46fa"],

Cell[TextData[{
 "The tubes of thickness ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftCeiling]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["R", "TI"], "/", "2"}], 
   StyleBox["\[RightCeiling]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "271f1105-6f06-4d6d-b88e-4be253a61ba2"],
 ": the thin tube green, the rest of the fat tube blue, and the geodesic."
}], "Text",ExpressionUUID->"c62972b1-004c-493b-86e8-393ee6fa29cb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "size", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
        RowBox[{"p", " ", "=", " ", 
         RowBox[{"farEnd", "[", "g", "]"}]}], ",", " ", 
        RowBox[{"thickness", " ", "=", " ", 
         RowBox[{"Ceiling", "[", 
          RowBox[{
           RowBox[{"profileRadius", "[", "g", "]"}], "/", "2"}], "]"}]}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"geodesic", " ", "=", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"c", ",", " ", "p"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"fat", " ", "=", " ", 
         RowBox[{"FindInfraRepresentative", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraTube", "[", 
            RowBox[{
             RowBox[{"InfraSegment", "[", 
              RowBox[{"c", ",", " ", "p"}], "]"}], ",", " ", "thickness"}], 
            "]"}]}], "]"}]}], ",", " ", 
        RowBox[{"thin", " ", "=", " ", 
         RowBox[{"FindInfraRepresentative", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraTube", "[", 
            RowBox[{"geodesic", ",", " ", "thickness"}], "]"}]}], "]"}]}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Complement", "[", 
            RowBox[{"fat", ",", " ", "thin"}], "]"}], " ", "->", " ", 
           "StandardBlue"}], ",", " ", 
          RowBox[{"thin", " ", "->", " ", "StandardGreen"}], ",", " ", 
          RowBox[{"InfraWalk", "[", "geodesic", "]"}]}], "}"}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"size", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
        " ", "\"\<Large\>\""}], "}"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->
  "In[10]:= ",ExpressionUUID->"c582026a-7598-4c8e-b2c5-3917497e5f7b"],

