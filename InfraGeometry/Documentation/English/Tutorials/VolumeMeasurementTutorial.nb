Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "size"}], "]"}]}], ")"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"radius", " ", "=", " ", 
        RowBox[{"profileRadius", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      
      RowBox[{"{", 
       RowBox[{"lattice", " ", "=", " ", 
        RowBox[{"Switch", "[", 
         RowBox[{"name", ",", " ", "\"\<SquareTilingGraph\>\"", ",", " ", 
          RowBox[{"4", " ", "r"}], ",", " ", "\"\<TriangularTilingGraph\>\"", 
          ",", " ", 
          RowBox[{"6", " ", "r"}], ",", " ", "_", ",", " ", "Nothing"}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Show", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"Plot", "[", 
         RowBox[{"lattice", ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "0", ",", " ", "radius"}], "}"}]}], "]"}], ",",
         "\n", "      ", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"twoMeasures", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"InfraShell", "[", 
               RowBox[{
                RowBox[{"First", " ", "@", " ", 
                 RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "r"}], 
               "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"r", ",", " ", "0", ",", " ", "radius"}], "}"}]}], 
             "]"}]}], "]"}], ",", " ", 
          RowBox[{"DataRange", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "radius"}], "}"}]}]}], "]"}], ",", "\n", 
        "      ", 
        RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"size", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
        " ", "\"\<Large\>\""}], "}"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[9]:= ",ExpressionUUID->"1df2c286-1176-4c27-81cc-7638ad3075a1"],

