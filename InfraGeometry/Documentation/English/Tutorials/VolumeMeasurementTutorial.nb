Cell["\<\
On the square tiling no vertex is red at any size: the ellipsoid is the tube. \
On the triangular tiling and on the mesh the ellipsoid reaches beyond the \
tube.\
\>", "Item",ExpressionUUID->"3b18602e-4271-43e7-b4d1-c00b9ea1b869"],

Cell[TextData[{
 "The profiles over ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["s", "TI"], "=", "0"}], ",", "\[Ellipsis]", ",", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7205a591-29e1-49f9-a8ba-fdd7ce3d96e2"],
 ": the ellipsoid of slack ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1099ea7-9c4d-4e32-9f0f-13d57f73c12d"],
 " as joined points, the fat tube of thickness ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fbbb5037-0133-4d9f-919d-297c546ed9d2"],
 " as points, the counting measure in the first colour and the Riemannian \
measure in the second."
}], "Text",ExpressionUUID->"340504e6-dc9d-4c4a-b044-f5d82e22f3c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "size"}], "]"}]}], ")"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
        RowBox[{"p", " ", "=", " ", 
         RowBox[{"farEnd", "[", "g", "]"}]}], ",", " ", 
        RowBox[{"radius", " ", "=", " ", 
         RowBox[{"profileRadius", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"Show", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"ListLinePlot", "[", 
         RowBox[{
          RowBox[{"twoMeasures", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"InfraTube", "[", 
               RowBox[{
                RowBox[{"FindInfraRepresentative", "[", 
                 RowBox[{"g", ",", " ", 
                  RowBox[{"InfraQuadric", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"c", ",", " ", "p"}], "}"}], ",", " ", 
                    RowBox[{"radius", " ", "+", " ", 
                    RowBox[{"2", " ", "s"}]}]}], "]"}]}], "]"}], ",", " ", 
                "0"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"s", ",", " ", "0", ",", " ", "radius"}], "}"}]}], 
             "]"}]}], "]"}], ",", " ", 
          RowBox[{"DataRange", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "radius"}], "}"}]}], ",", " ", 
          RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}]}], "]"}], ",", 
        "\n", "      ", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"twoMeasures", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"InfraTube", "[", 
               RowBox[{
                RowBox[{"InfraSegment", "[", 
                 RowBox[{"c", ",", " ", "p"}], "]"}], ",", " ", "s"}], "]"}], 
              ",", " ", 
              RowBox[{"{", 
               RowBox[{"s", ",", " ", "0", ",", " ", "radius"}], "}"}]}], 
             "]"}]}], "]"}], ",", " ", 
          RowBox[{"DataRange", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "radius"}], "}"}]}]}], "]"}], ",", "\n", 
        "      ", 
        RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"size", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
        " ", "\"\<Large\>\""}], "}"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

