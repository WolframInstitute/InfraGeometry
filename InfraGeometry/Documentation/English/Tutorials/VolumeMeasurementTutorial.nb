Cell["\<\
The triangulated rectangle of the introduction, and its balls of radius one \
to six about the centre.\
\>", "Text",ExpressionUUID->"42c06816-4d3e-4bc2-936b-0ad87ccf9cc7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"MeshConnectivityGraph", "[", 
      RowBox[{"DiscretizeRegion", "[", 
       RowBox[{
        RowBox[{"Rectangle", "[", "]"}], ",", " ", 
        RowBox[{"MaxCellMeasure", " ", "->", " ", "0.002"}]}], "]"}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "r"}], "]"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "6"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[28]:= ",ExpressionUUID->"cfa82a3e-a7af-4c51-b069-dbe8489a3c73"],

