Cell["\<\
The ball is not round. On the square tiling it is a square, on the triangular \
tiling a hexagon: the scaled path metric of a lattice tends to a norm, and \
these are its unit balls.\
\>", "Item",ExpressionUUID->"bb4a5033-0e4e-4a5d-ad96-65731846ff73"],

Cell[TextData[{
 "On the square lattice the ball holds ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["r", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "2", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "+", "2", 
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b08cf5b-ef3e-4ed9-b820-829868f0fda8"],
 " vertices, on the triangular lattice ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["r", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "3", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "+", "3", 
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "457d7786-53bf-496b-93d8-10ee6d1e6f0b"],
 "; the leading coefficient is the area of the unit ball of the norm, counted \
in vertex cells."
}], "Item",ExpressionUUID->"b94c4f39-714b-4b7e-abc8-eee35874c000"],

Cell[TextData[{
 "On both lattices every vertex at distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "\[GreaterEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e3eb483-6c81-4d36-bfc2-395fb4b5a723"],
 " from ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "122829c0-bdc4-4a4f-a8c7-fbd4df842ddf"],
 " has a neighbour at distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2c68cb2-2a16-469d-bb3f-24d86eadf714"],
 ", so the interior of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["B", "TI"], 
   StyleBox["r", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb9aa7ed-0aec-4b84-a9be-3fd343ee62a2"],
 " is ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["B", "TI"], 
   RowBox[{
    StyleBox["r", "TI"], "-", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e29eefe-55f5-4519-aa9b-3bc41b1d5282"],
 ". The Riemannian measure is therefore ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["r", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "541e8aad-59f0-4dab-a4f9-4a620fe83519"],
 " for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "\[GreaterEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cdb60ef7-f450-4617-958a-f81f6cdcf4d7"],
 ", and ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81449355-4845-4234-b547-44f3e6820401"],
 " at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3c505a4-dd10-467c-938b-2bde922d986d"],
 ", where the centre has a neighbour outside."
}], "Item",ExpressionUUID->"5866806a-e75d-4637-a134-710ec50dced6"],

Cell[TextData[{
 "In the continuum the reference is the small-ball expansion of Gray and \
Vanhecke. On a Riemannian manifold of dimension ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4140b9db-442a-4ff4-b687-811a588ff122"],
 ", with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec8bf59c-dc41-49e5-bf0e-18ffc0149548"],
 " the volume of the Euclidean unit ball and ",
 Cell[BoxData[
  StyleBox["Scal",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "600b2303-c1d1-4dac-bc68-a681e07897bb"],
 " the scalar curvature at the centre, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Vol",
    FontSlant->"Plain"], 
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["r", "TI"]], "=", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["n", "TI"]], 
   SuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["(",
    FontSize->1.2 Inherited], "1", "-", 
   FractionBox[
    StyleBox["Scal",
     FontSlant->"Plain"], 
    RowBox[{"6", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["n", "TI"], "+", "2"}], 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "+", 
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["r", "TI"], "4"], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08e6cf63-270d-4095-b662-f6465ab887e5"],
 "."
}], "Item",ExpressionUUID->"fd344cb1-b72c-4d67-8375-4ec89a03ce35"],

Cell[TextData[{
 "The two profiles over ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["r", "TI"], "=", "0"}], ",", "\[Ellipsis]", ",", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0590e037-3221-43e7-8345-21de94b3f7e1"],
 ": the counting measure as points in the first colour, the Riemannian \
measure in the second; the curves are ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["r", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5e3b304-6150-4ca2-b93c-aa58ac83ccf6"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["r", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0c8bc8c-17d9-4677-aa0b-74905365c6b6"],
 "."
}], "Text",ExpressionUUID->"2fb995f9-c5f5-4df4-b11a-28c149461d18"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "size"}], "]"}]}], ")"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"radius", " ", "=", " ", 
        RowBox[{"profileRadius", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      
      RowBox[{"{", 
       RowBox[{"lattice", " ", "=", " ", 
        RowBox[{"Switch", "[", 
         RowBox[{"name", ",", " ", "\"\<SquareTilingGraph\>\"", ",", " ", 
          RowBox[{
           RowBox[{"2", " ", 
            RowBox[{"r", "^", "2"}]}], " ", "+", " ", 
           RowBox[{"2", " ", "r"}], " ", "+", " ", "1"}], ",", 
          " ", "\"\<TriangularTilingGraph\>\"", ",", " ", 
          RowBox[{
           RowBox[{"3", " ", 
            RowBox[{"r", "^", "2"}]}], " ", "+", " ", 
           RowBox[{"3", " ", "r"}], " ", "+", " ", "1"}], ",", " ", "_", ",", 
          " ", "Nothing"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Show", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{"Evaluate", "[", 
           RowBox[{"{", 
            RowBox[{"lattice", ",", " ", 
             RowBox[{"lattice", " ", "/.", " ", 
              RowBox[{"r", " ", "->", " ", 
               RowBox[{"r", " ", "-", " ", "1"}]}]}]}], "}"}], "]"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "0", ",", " ", "radius"}], "}"}]}], "]"}], ",",
         "\n", "      ", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"twoMeasures", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"InfraBall", "[", 
               RowBox[{
                RowBox[{"First", " ", "@", " ", 
                 RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "r"}], 
               "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"r", ",", " ", "0", ",", " ", "radius"}], "}"}]}], 
             "]"}]}], "]"}], ",", " ", 
          RowBox[{"DataRange", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "radius"}], "}"}]}]}], "]"}], ",", "\n", 
        "      ", 
        RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"size", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
        " ", "\"\<Large\>\""}], "}"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[7]:= ",ExpressionUUID->"6de248f4-c499-45d5-8ebd-dbe9466bf89e"],

