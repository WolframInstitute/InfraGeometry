Cell["\<\
On every substrate the counting curve rises towards two from below and the \
Riemannian curve falls towards it from above, until the balls meet the rim of \
the substrate.\
\>", "Item",ExpressionUUID->"e6859a3c-a18c-4fae-b21b-cbc46c3ce61a"],

Cell[TextData[{
 "The two curves part most at small radius, where a finite substrate is read. \
Their mean is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "+", 
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["r", "TI"], 
    RowBox[{"-", "2"}]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be56f0c8-f399-4838-92ae-7a12b902c497"],
 " on the lattices."
}], "Item",ExpressionUUID->"bb34d691-4a4a-4d8e-baa2-da1e7eea1839"],

Cell["The row of section 4.5", "Subsection",ExpressionUUID->"32d0433b-6821-4eb6-9d5a-bca93d9b544c"],

Cell[TextData[{
 "The figures of the introduction's section, measured with the heads of this \
paclet: the balls through ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "51ce048e-32a8-4409-acb0-3e34941d299e"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "96e8a541-7472-4843-bd35-9e7064200cd6"],
 ", the quotients through ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LogDifferenceQuotients"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/LogDifferenceQuotients", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "76bd4277-7c47-4310-bf8e-940256392958"],
 ". Each quotient plot shows the introduction's reading, the profile from \
radius zero, as joined points, the counting curve at its own radius as \
points, and the reference dimension as a line."
}], "Text",ExpressionUUID->"afd4c8b5-5478-466b-98fd-adb2e4d9b9c1"],

Cell["\<\
The grids of dimension one, two and three, and their balls of radius zero to \
five about the centre.\
\>", "Text",ExpressionUUID->"ba791b25-021d-4d0c-b40e-88295b1db933"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Column", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"GridGraph", "[", "sides", "]"}]}], "}"}], ",", "\n", "    ", 
      
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"GraphicsRow", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"InfraSubstrateHighlight", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", 
            RowBox[{"InfraBall", "[", 
             RowBox[{"c", ",", " ", "r"}], "]"}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"sides", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "11", "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"11", ",", " ", "11"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"7", ",", " ", "7", ",", " ", "7"}], "}"}]}], "}"}]}], 
     "}"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[25]:= ",ExpressionUUID->"c7378386-0e2f-4e6d-950b-da1a392c4401"],

