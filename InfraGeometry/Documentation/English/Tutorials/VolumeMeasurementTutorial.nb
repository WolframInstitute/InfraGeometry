 CellLabel->
  "Out[21]= ",ExpressionUUID->"4a60c9a9-848c-44c6-adab-8ff8197c6299"]
}, Open  ]],

Cell[TextData[{
 "On the square lattice with spacing ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb754740-f26d-4e51-86d3-b992481f14a1"],
 ", vertex area ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["a", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57388130-fe1b-488e-a8ac-735ad72fb20a"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], "=", 
   StyleBox["a", "TI"], 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4670c16-0f20-46aa-8082-e7d8a90c4c17"],
 ", the closed and the open count give ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["R", "TI"], "2"], "+", "2", 
   StyleBox["a", "TI"], 
   StyleBox["R", "TI"], "+", 
   SuperscriptBox[
    StyleBox["a", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e074f9e9-7ee9-4eea-bfcb-6563bd921fa9"],
 " and ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["R", "TI"], "2"], "-", "2", 
   StyleBox["a", "TI"], 
   StyleBox["R", "TI"], "+", 
   SuperscriptBox[
    StyleBox["a", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "225fc504-a544-4618-929a-3288ce27798a"],
 ", against the area ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["R", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f3ecb0f-48cb-46b3-9cfb-4b647be2772d"],
 " of the ",
 Cell[BoxData[
  SuperscriptBox["\[ScriptL]", "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27ee38cf-c9fe-4c07-9ae8-4f116677e964"],
 " ball: relative errors ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   StyleBox["a", "TI"], "/", 
   StyleBox["R", "TI"], "+", 
   SuperscriptBox[
    StyleBox["a", "TI"], "2"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SuperscriptBox[
     StyleBox["R", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49a47da7-7bce-4fec-ad36-98d44193ce68"],
 ". Deleting the outer layer reverses the linear correction and keeps the \
constant term."
}], "Item",ExpressionUUID->"1d579b88-c284-43cb-8385-c6f213d56ac5"],

Cell[TextData[{
 "The two measures of the balls about the centre over ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["r", "TI"], "=", "0"}], ",", "\[Ellipsis]", ",", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ba8b7a5-2a66-4db0-950a-be0cf9c57f46"],
 " as points, against the continuum volume counted in vertex cells. Here the \
columns are the square tiling, the mesh of the unit square and a mesh of the \
unit sphere. The continuum volume is, in turn, the area ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc758ae5-17ac-4d5d-a125-031f92b88ee3"],
 " of the ",
 Cell[BoxData[
  SuperscriptBox["\[ScriptL]", "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1eec02f3-7c2b-4574-9ce5-0de534a5273a"],
 " ball, the area of the disk of radius ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"a", "r"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5abb9ff-4615-497a-a2b9-6552336b7223"],
 " times the number of vertices, and the area of the cap of angular radius ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"a", "r"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3ac8ff2-df76-47a5-b1cc-4fd451aa6fbd"],
 " times the number of vertices per unit area. The hop length ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00968b3e-2459-46ed-a178-d037e917733f"],
 " is the mean distance of a vertex from the centre per hop, in the metric of \
the continuum: on the square tiling the ",
 Cell[BoxData[
  SuperscriptBox["\[ScriptL]", "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3c5340a-fc12-49f2-9653-ba174e94b0f0"],
 " metric of the lattice, which in the stored coordinates, turned by an \
eighth of a turn, is the chessboard metric; on the square the Euclidean \
metric; on the sphere the angle."
}], "Text",ExpressionUUID->"e00cef0c-d8c2-4885-9bd5-412ab444a7b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{
            RowBox[{"First", "[", "spec", "]"}], ",", " ", "size", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
        RowBox[{"radius", " ", "=", " ", 
         RowBox[{"profileRadius", "[", "g", "]"}]}], ",", " ", 
        RowBox[{"where", " ", "=", " ", 
         RowBox[{"AssociationThread", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"hop", " ", "=", " ", 
        RowBox[{"Mean", " ", "@", " ", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{"pt", " ", "|->", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"spec", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "[", 
              RowBox[{
               RowBox[{"where", "[", "pt", "]"}], ",", " ", 
               RowBox[{"where", "[", "c", "]"}]}], "]"}], "/", 
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", "c", ",", " ", "pt"}], "]"}]}]}], ",", 
           " ", 
           RowBox[{"DeleteCases", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "c"}], "]"}]}], 
          "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Show", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"spec", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "[", 
           RowBox[{
            RowBox[{"hop", " ", "r"}], ",", " ", 
            RowBox[{"VertexCount", "[", "g", "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "0", ",", " ", "radius"}], "}"}]}], "]"}], ",",
         "\n", "      ", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"twoMeasures", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"InfraBall", "[", 
               RowBox[{"c", ",", " ", "r"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"r", ",", " ", "0", ",", " ", "radius"}], "}"}]}], 
             "]"}]}], "]"}], ",", " ", 
          RowBox[{"DataRange", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "radius"}], "}"}]}]}], "]"}], ",", "\n", 
        "      ", 
        RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"size", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
        " ", "\"\<Large\>\""}], "}"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"spec", ",", " ", 
      RowBox[{"{", "\n", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "ChessboardDistance", 
          ",", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"rho", ",", " ", "total"}], "}"}], " ", "|->", " ", 
           RowBox[{"2", " ", 
            RowBox[{"rho", "^", "2"}]}]}]}], "}"}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "EuclideanDistance", ",",
           " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"rho", ",", " ", "total"}], "}"}], " ", "|->", " ", 
           RowBox[{"total", " ", "Pi", " ", 
            RowBox[{"rho", "^", "2"}]}]}]}], "}"}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"\"\<SphereMeshGraph\>\"", ",", " ", "VectorAngle", ",", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"rho", ",", " ", "total"}], "}"}], " ", "|->", " ", 
           RowBox[{"total", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", " ", "-", " ", 
               RowBox[{"Cos", "[", "rho", "]"}]}], ")"}], "/", "2"}]}]}]}], 
         "}"}]}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"b4250bba-f4e0-4ede-af62-8a4f12530659"],

