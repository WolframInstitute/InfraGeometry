Cell[TextData[{
 "The profiles of one instance in each band ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], 
   RowBox[{
    StyleBox["r", "TI"], ",", 
    RowBox[{
     StyleBox["r", "TI"], "+", "1"}]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f055e1e-59ce-4793-ad27-8356484c5e03"],
 " over ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["r", "TI"], "=", "1"}], ",", "\[Ellipsis]", ",", 
   RowBox[{
    StyleBox["min",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["R", "TI"], ",", "6"}], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbae951e-8399-4571-b176-40e2534f6de2"],
 " as points, the counting measure in the first colour and the Riemannian \
measure in the second, with the counting measures of the two shells ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], 
   StyleBox["r", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81233134-0dfa-4d3e-be96-79102d224e58"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], 
   RowBox[{
    StyleBox["r", "TI"], "+", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42a7002d-2e2a-4bce-a83b-d236d464f576"],
 " as joined points."
}], "Text",ExpressionUUID->"3e2877ed-724c-4fb3-a8d8-f7cf3355b26b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "size"}], "]"}]}], ")"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
        RowBox[{"bandRadii", " ", "=", " ", 
         RowBox[{"Range", "[", 
          RowBox[{"1", ",", " ", 
           RowBox[{"Min", "[", 
            RowBox[{
             RowBox[{"profileRadius", "[", "g", "]"}], ",", " ", "6"}], 
            "]"}]}], "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"walls", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"InfraTube", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
              RowBox[{"FindInfraRepresentative", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"InfraSphere", "[", 
                 RowBox[{"c", ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"r", ",", " ", 
                    RowBox[{"r", " ", "+", " ", "1"}]}], "}"}]}], "]"}]}], 
               "]"}]}], ")"}], ",", " ", "0"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "bandRadii"}], "}"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"shells", " ", "=", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"InfraShell", "[", 
             RowBox[{"c", ",", " ", "r"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"r", ",", " ", 
              RowBox[{"First", "[", "bandRadii", "]"}], ",", " ", 
              RowBox[{
               RowBox[{"Last", "[", "bandRadii", "]"}], " ", "+", " ", 
               "1"}]}], "}"}]}], "]"}], ",", " ", "\"\<CountingMeasure\>\""}],
          "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Show", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"ListLinePlot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"bandRadii", ",", " ", 
               RowBox[{"Most", "[", "shells", "]"}]}], "}"}], "]"}], ",", " ", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"bandRadii", ",", " ", 
               RowBox[{"Rest", "[", "shells", "]"}]}], "}"}], "]"}]}], "}"}], 
          ",", " ", 
          RowBox[{"PlotStyle", " ", "->", " ", "Gray"}]}], "]"}], ",", "\n", 
        "      ", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"bandRadii", ",", " ", "#"}], "}"}], "]"}], " ", "&"}], 
          " ", "/@", " ", 
          RowBox[{"twoMeasures", "[", 
           RowBox[{"g", ",", " ", "walls"}], "]"}]}], "]"}], ",", "\n", 
        "      ", 
        RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"size", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
        " ", "\"\<Large\>\""}], "}"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->
  "In[19]:= ",ExpressionUUID->"068d89bb-e5f9-416b-b987-d13e92100319"],

