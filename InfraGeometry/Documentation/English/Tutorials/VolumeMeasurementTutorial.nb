 "The two profiles over ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["r", "TI"], "=", "0"}], ",", "\[Ellipsis]", ",", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ed9a11f-e46e-4bb0-8bdb-1c8be11f9cd7"],
 ", against ",
