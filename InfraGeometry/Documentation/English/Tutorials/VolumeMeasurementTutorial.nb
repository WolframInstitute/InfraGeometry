Cell["\<\
Its quotients, the profiles averaged over the centres and their neighbours.\
\>", "Text",ExpressionUUID->"d1bc7d1c-2612-4936-ab1b-a56e7f66fb98"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"MeshConnectivityGraph", "[", 
      RowBox[{"DiscretizeRegion", "[", 
       RowBox[{
        RowBox[{"Rectangle", "[", "]"}], ",", " ", 
        RowBox[{"MaxCellMeasure", " ", "->", " ", "0.002"}]}], "]"}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seeds", " ", "=", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"NeighborhoodGraph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}], ",", " ", "1"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"top", " ", "=", " ", 
     RowBox[{"Min", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"VertexEccentricity", "[", 
         RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
       "seeds"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ballVolumes", " ", "=", " ", 
     RowBox[{"MeanAround", " ", "/@", " ", 
      RowBox[{"Transpose", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"InfraBall", "[", 
              RowBox[{"seed", ",", " ", "r"}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"r", ",", " ", "0", ",", " ", "top"}], "}"}]}], "]"}], ",",
            " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"seed", ",", " ", "seeds"}], "}"}]}], "]"}]}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"LogDifferenceQuotients", "[", "ballVolumes", "]"}], ",", " ", 
       
       RowBox[{"LogDifferenceQuotients", "[", 
        RowBox[{"Rest", "[", "ballVolumes", "]"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"Joined", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"True", ",", " ", "False"}], "}"}]}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", "2", "}"}]}], "}"}]}]}], "]"}]}], "]"}]], "Input",
