Cell[TextData[{
 "On the square tiling the points sit on the joined points under both \
measures. On the triangular tiling and on the mesh the ellipsoid outgrows the \
tube, and the gap widens with ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa0560fe-84b5-4ca0-902f-f6633cb0d228"],
 "."
}], "Item",ExpressionUUID->"9c4f1cf6-a584-4dac-b2f6-f2cd32099508"],

Cell[TextData[{
 "The modularity of the substrates themselves, checked rather than assumed: \
for every pair ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], ",", 
   StyleBox["q", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82db807b-2f49-4715-a833-d91988244283"],
 " and every vertex ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6afe9e7c-7520-46a7-882f-517100016d1d"],
 ", the triple has a median exactly when ",
 Cell[BoxData[
  RowBox[{"2", " ", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    RowBox[{
     StyleBox["I", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["p", "TI"], ",", 
      StyleBox["q", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["p", "TI"], ",", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["q", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["p", "TI"], ",", 
    StyleBox["q", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ea1357c-ce0e-4981-af66-98b5b429d12e"],
 ". Each vertex is inked by the number of pairs with which it has no median; \
the small substrates."
}], "Text",ExpressionUUID->"f96de722-7b99-41a8-a609-05664272e1d0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"d", " ", "=", " ", 
         RowBox[{"GraphDistanceMatrix", "[", "g", "]"}]}], ",", " ", 
        RowBox[{"vertexTotal", " ", "=", " ", 
         RowBox[{"VertexCount", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"lacking", " ", "=", " ", 
        RowBox[{"Total", " ", "@", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", "\n", "      ", 
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"core", " ", "=", " ", 
                 RowBox[{"Pick", "[", 
                  RowBox[{
                   RowBox[{"Range", "[", "vertexTotal", "]"}], ",", " ", 
                   RowBox[{
                    RowBox[{"d", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], " ", "+", " ", 
                    RowBox[{"d", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], ",", " ", 
                   RowBox[{"d", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", " ", "j"}], "]"}], "]"}]}], "]"}]}], 
                "}"}], ",", " ", 
               RowBox[{"Unitize", "[", 
                RowBox[{
                 RowBox[{"2", " ", 
                  RowBox[{"(", 
                   RowBox[{"Min", " ", "/@", " ", 
                    RowBox[{"d", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", " ", "core"}], "]"}], "]"}]}], 
