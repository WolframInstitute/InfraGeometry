Cell["\<\
The binary tree of eleven levels, the profiles averaged over a random sample \
of vertices.\
\>", "Text",ExpressionUUID->"9ccbef27-fd27-45bb-a8b8-d5825ecb3e80"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"KaryTree", "[", "2047", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"top", " ", "=", " ", 
      RowBox[{"GraphRadius", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"seeds", " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
        RowBox[{"RandomSample", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "64"}], "]"}]}], 
       ")"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ballVolumes", " ", "=", " ", 
     RowBox[{"MeanAround", " ", "/@", " ", 
      RowBox[{"Transpose", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"InfraBall", "[", 
              RowBox[{"seed", ",", " ", "r"}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"r", ",", " ", "0", ",", " ", "top"}], "}"}]}], "]"}], ",",
            " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"seed", ",", " ", "seeds"}], "}"}]}], "]"}]}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"LogDifferenceQuotients", "[", "ballVolumes", "]"}], ",", " ", 
       
       RowBox[{"LogDifferenceQuotients", "[", 
        RowBox[{"Rest", "[", "ballVolumes", "]"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"Joined", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"True", ",", " ", "False"}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[31]:= ",ExpressionUUID->"fbcf1023-577a-40ed-8f18-8a113580923d"],

