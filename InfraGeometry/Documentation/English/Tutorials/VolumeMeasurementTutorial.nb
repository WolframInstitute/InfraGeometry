Cell["\<\
On the tilings both profiles sit on their polynomials at every size: a tiling \
is a patch of its lattice, and a ball that stays one layer inside the patch \
counts as on the lattice.\
\>", "Item",ExpressionUUID->"42dc2733-c231-4fad-9f1a-2a91652a91cc"],

Cell["\<\
On the mesh both profiles grow quadratically, with no closed form, and the \
Riemannian profile is again the counting profile one radius later.\
\>", "Item",ExpressionUUID->"a5708cf5-e597-4f64-aa63-1255c526702e"],

Cell[TextData[{
 "[[ On the hexagonal tiling, does every vertex at distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "\[GreaterEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09962f84-dee2-406e-b85b-2b0b4366d0e6"],
 " have a neighbour at distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "792c300f-ef74-4f8d-8f28-4047433d036e"],
 "? Then its Riemannian ball count is ",
 Cell[BoxData[
  RowBox[{"1", "+", 
   FractionBox["3", "2"], 
   StyleBox["r", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["r", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9abe5ef1-e94c-4a9e-bdfa-88d4cd6f4aa1"],
 ", the counting polynomial ",
 Cell[BoxData[
  RowBox[{"1", "+", 
   FractionBox["3", "2"], 
   StyleBox["r", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["r", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36436120-4900-4873-abb6-818e1f7007d1"],
 " one radius earlier. ]]"
}], "Item",ExpressionUUID->"aa429475-6875-4099-870c-5197c48519d3"],

Cell["Shells", "Section",ExpressionUUID->"c199ce23-530d-434b-aca2-61dc0a484209"],

Cell[TextData[{
 "The shell is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["r", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["c", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", "{", 
    StyleBox["v", "TI"]}], ":", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["c", "TI"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["r", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1408c50b-97a8-4aa9-ba43-e38ce26a36a3"],
 ", the outer layer of the ball. On the lattices it holds ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["r", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["r", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "454bf895-2d14-4987-b275-d42a8b6873d8"],
 " vertices, ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae23e339-9af3-4fb0-8550-191e4bbec35f"],
 " on the square lattice and ",
 Cell[BoxData[
  RowBox[{"6", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee9d49cc-4cf3-4d5b-8cdf-460ca40da9d9"],
 " on the triangular one."
}], "Item",ExpressionUUID->"e148b92b-979a-498f-84eb-be816c9fab8f"],

Cell[TextData[{
 "Its Riemannian measure is zero. Every vertex of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], 
   StyleBox["r", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28d27602-8770-47ed-a555-571aad98a34f"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "\[GreaterEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "066bcd3a-2034-421d-a25a-3b8838e16a9a"],
 " has a neighbour at distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bda55de-2895-4484-8643-8ff9e47c4f3e"],
 ", which lies outside the shell, and the centre has a neighbour outside ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0963d42-9209-4bd3-a85b-b6ef431a0af2"],
 ". The whole shell is boundary."
}], "Item",ExpressionUUID->"e76c3384-81a4-4d11-beb6-d085f255435f"],

Cell[TextData[{
 "In the continuum the geodesic sphere has area ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["n", "TI"]], 
   SuperscriptBox[
    StyleBox["r", "TI"], 
    RowBox[{
     StyleBox["n", "TI"], "-", "1"}]], 
   StyleBox["(",
    FontSize->1.2 Inherited], "1", "-", 
   FractionBox[
    StyleBox["Scal",
     FontSlant->"Plain"], 
    RowBox[{"6", 
     StyleBox["n", "TI"]}]], 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "+", 
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["r", "TI"], "4"], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9fdcdd6-f6db-4ce8-af72-6a4be0db0f00"],
 " and volume zero. The two measures of a shell are its two readings: an \
area, counted, and a volume, which vanishes."
}], "Item",ExpressionUUID->"0d24a58b-8685-4cec-b00e-841f75643382"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "size", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"interiorAndBoundary", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", 
            RowBox[{"profileRadius", "[", "g", "]"}]}], "]"}]}], "]"}]}], 
       "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"size", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
        " ", "\"\<Large\>\""}], "}"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[8]:= ",ExpressionUUID->"9ffbf546-ec74-4b8b-a7ea-3ec20cb7620d"],

