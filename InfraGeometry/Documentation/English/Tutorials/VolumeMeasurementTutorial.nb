Cell["\<\
The fat tube contains the thin one and outgrows it. On the square tiling the \
fat tube follows the box count, and its Riemannian measure is the count one \
step thinner.\
\>", "Item",ExpressionUUID->"d121a5e9-3562-4adb-8030-58c290014117"],

Cell["The ellipsoid", "Section",ExpressionUUID->"58dea96e-fa3f-416e-ae31-e8089660cabc"],

Cell[TextData[{
 "Two foci ",
 Cell[BoxData[
  RowBox[{
   StyleBox["c", "TI"], ",", 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c15ab249-0d68-4998-8c93-a0418fac702a"],
 " at distance ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e63f588e-06c4-47ac-a762-ee1ffbd2f9c9"],
 " bound the ",
 StyleBox["solid ellipsoid",
  FontWeight->"Bold"],
 " of slack ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61d7d6e8-30c4-487d-8202-c9241a82704b"],
 ", ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["k", "TI"]], "=", "{", 
    StyleBox["v", "TI"]}], ":", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["c", "TI"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "+", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["v", "TI"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[LessEqual]", 
    StyleBox["n", "TI"], "+", 
    StyleBox["k", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0324d5a-3e9d-46a2-a3a9-89efce956f7c"],
 ", which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraQuadric"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraQuadric", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "81179479-2bd1-48a0-b906-c84f30eb76ed"],
 " gives. At slack zero it is the interval ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "048333e5-7a5e-4ff0-be87-44a4bf709dc3"],
 ", the core of the fat tube."
}], "Item",ExpressionUUID->"eb8ebc17-9ede-45c2-9868-c713f6b855f9"],

Cell[TextData[{
 "On every graph ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["s", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["c", "TI"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[SubsetEqual]", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{"2", 
     StyleBox["s", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1a561ce-cedc-4041-a8b6-792b7293df6f"],
 ". For ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "354741fb-dd03-40d0-99bb-88b572ee7f8e"],
 " within ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de0cab50-ba8b-4782-956a-9b260bb96b2b"],
 " of a vertex ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "898900cb-d094-4898-958d-30ae882036dd"],
 " of the interval, two triangle inequalities through ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "237b6190-2f46-47d0-9367-c84977bcf67c"],
 " give ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[LessEqual]", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["y", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["y", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", "2", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[LessEqual]", 
   StyleBox["n", "TI"], "+", "2", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3872b544-f563-46f3-aae3-cf7e0d2eeed6"],
 "."
}], "Item",ExpressionUUID->"e0dcb4be-c359-4e86-83e4-c8f105fe91f0"],

Cell[TextData[{
 "A ",
 StyleBox["median",
  FontWeight->"Bold"],
 " of three vertices lies on a geodesic between each two of them. If ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e7111db-5fc6-4701-8262-c6d073859594"],
 " is a median of ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "960ef25a-a27a-4217-b919-017f50e2923c"],
 ", ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da56a282-bf54-41d7-b585-bbb2ea454ebe"],
 " and ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f67a3d1-9893-4da1-9202-115f370da45a"],
 ", then ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["m", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6311d4a3-5d38-48c3-a982-e27724f2f782"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["m", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], ",", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1687f20b-5418-439b-8b42-124408ca83fd"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["p", "TI"], ",", 
    StyleBox["m", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], ",", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["p", "TI"], ",", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e17e966b-c0a1-4d09-9177-8b0df3689956"],
 "; adding the last two and subtracting the first gives ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], ",", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64f3a675-2c23-4801-9d80-897c811ae658"],
 ". A median converts the slack of ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fb9d542-ecbd-4ca5-821b-527f81d80d46"],
 " into its distance from the interval, at the rate two."
}], "Item",ExpressionUUID->"1faa3dc9-54c5-41eb-8f5d-6449d4f13bf4"],

Cell[TextData[{
 "A graph is ",
 StyleBox["modular",
  FontWeight->"Bold"],
 " when every three vertices have a median. On a modular graph a vertex of \
slack at most ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9579a5ec-d735-45a3-a389-ed59d2082bad"],
 " has its median within ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55afc5d2-9bcb-464a-81ec-63ac288e6e43"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{"2", 
     StyleBox["s", "TI"]}]], "=", 
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["s", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["c", "TI"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f97103b6-27f1-4097-88f8-66ac2952c74d"],
 ": the ellipsoid of slack ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b5cde7e-0c38-4fed-af6c-1ba10b2ecb1f"],
 " is the fat tube of thickness ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0503fc05-0859-40cc-8b58-54ed0d629f13"],
 ", under both measures."
}], "Item",ExpressionUUID->"e9185f96-588e-4b9e-99a3-077a7b42ac0e"],

Cell[TextData[{
 "In the Euclidean plane the two differ: the ellipse of slack ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cd3d58d-f4ae-4b75-abef-67fce53f4e6c"],
 " bulges to a half-width of order ",
 Cell[BoxData[
  SqrtBox[
   StyleBox[
    RowBox[{"n", "k"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0da72d7d-b0d0-4a76-b8bb-07de7a9d8fd0"],
 " in the middle, the tube keeps the half-width ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd2a2702-1c44-4885-bbbb-84fdefa9dd3d"],
 ". Under the ",
 Cell[BoxData[
  SuperscriptBox["\[ScriptL]", "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50931124-9db6-4cc0-b580-4acf554caf1d"],
 " norm, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      RowBox[{
        StyleBox["x", "TI"], "+", 
        StyleBox["a", "TI"]}]},
     "Abs"], "+", 
    TemplateBox[{
      RowBox[{
        StyleBox["x", "TI"], "-", 
        StyleBox["a", "TI"]}]},
     "Abs"]}], "=", 
   RowBox[{"2", 
    StyleBox["max",
     FontSlant->"Plain"], "\[ThinSpace]", 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      TemplateBox[{
        StyleBox["x", "TI"]},
       "Abs"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c89c73f-9120-4bb8-bb18-1d1d161b1921"],
 ", and the ellipse is the tube; the square lattice carries the ",
 Cell[BoxData[
  SuperscriptBox["\[ScriptL]", "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "edaa917e-0795-4f93-9733-a1d8ad6b3ac7"],
 " norm."
}], "Item",ExpressionUUID->"71db91b3-6834-4183-9b71-835b3869cafc"],

Cell[TextData[{
 "The ellipsoid of slack ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae3b5d04-7540-429a-a836-1b26de080ae2"],
 " and the fat tube of thickness ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fac6d6d-44e8-4301-9087-a0e0d140c065"],
 ", for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "=", 
   StyleBox["\[LeftCeiling]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["R", "TI"], "/", "2"}], 
   StyleBox["\[RightCeiling]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8bfe8069-aeb8-43ed-841c-0f92e8af934a"],
 ": the tube green, the vertices of the ellipsoid outside the tube red, and \
the interval."
}], "Text",ExpressionUUID->"f5686b5a-cd86-4794-a271-2824872ece4b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "size", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
        RowBox[{"p", " ", "=", " ", 
         RowBox[{"farEnd", "[", "g", "]"}]}], ",", " ", 
        RowBox[{"thickness", " ", "=", " ", 
         RowBox[{"Ceiling", "[", 
          RowBox[{
           RowBox[{"profileRadius", "[", "g", "]"}], "/", "2"}], "]"}]}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"ellipsoid", " ", "=", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraQuadric", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"c", ",", " ", "p"}], "}"}], ",", " ", 
            RowBox[{
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", "c", ",", " ", "p"}], "]"}], " ", "+", 
             " ", 
             RowBox[{"2", " ", "thickness"}]}]}], "]"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"tube", " ", "=", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraTube", "[", 
           RowBox[{
            RowBox[{"InfraSegment", "[", 
             RowBox[{"c", ",", " ", "p"}], "]"}], ",", " ", "thickness"}], 
           "]"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Complement", "[", 
            RowBox[{"ellipsoid", ",", " ", "tube"}], "]"}], " ", "->", " ", 
           "StandardRed"}], ",", " ", 
          RowBox[{"tube", " ", "->", " ", "StandardGreen"}], ",", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"c", ",", " ", "p"}], "]"}]}], "}"}]}], "]"}]}], "]"}], ",",
     "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"size", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
        " ", "\"\<Large\>\""}], "}"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->
  "In[12]:= ",ExpressionUUID->"4519166a-949b-4e0f-a3cc-20e2a9c293ba"],

