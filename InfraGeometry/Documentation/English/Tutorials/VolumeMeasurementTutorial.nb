Notebook[{

Cell[CellGroupData[{
Cell["Volume Measurement", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 "A region about a vertex ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ab74d4b-0073-4a78-ae09-4524601268d6"],
 " is a set ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04e9712d-3ac3-4aec-8bd6-4e412a91bece"],
 " of vertices, and its volume is a count. The regions here are the ball, the \
shell, the tube about the interval of two vertices or about one geodesic, the \
solid ellipsoid of two foci, the cone about a geodesic and the sphere \
instance in a band. Each has a size parameter, and its ",
 StyleBox["profile",
  FontWeight->"Bold"],
 " is its volume as a function of the size."
}], "Item",ExpressionUUID->"63f3b0d8-3834-44f9-96d4-16e49209db97"],

Cell[TextData[{
 "Every region is measured twice. The ",
 StyleBox["counting measure",
  FontWeight->"Bold"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["X", "TI"]},
   "Abs"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0143fadd-eef0-4790-9c4d-b41ef7507d6a"],
 ". The ",
 StyleBox["Riemannian measure",
  FontWeight->"Bold"],
 " is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      StyleBox["X", "TI"]},
     "Abs"], "-", 
    TemplateBox[{
      RowBox[{"\[PartialD]", 
        StyleBox["X", "TI"]}]},
     "Abs"]}], "=", 
   TemplateBox[{
     RowBox[{
       StyleBox["Int", FontSlant -> "Plain"], 
       StyleBox["X", "TI"]}]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbfee20e-8ac9-4bbe-a211-e3f0f6ab420a"],
 ", where the boundary ",
 Cell[BoxData[
  RowBox[{"\[PartialD]", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95299b7e-c44d-4127-a21f-fd59855f3d73"],
 " is the set of vertices of ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0722a2a-34cc-4c9b-87b5-4e05cbbfb272"],
 " with a neighbour outside ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "844e8653-2be6-46f7-94f0-6be9db519b9f"],
 ", and the interior ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Int",
    FontSlant->"Plain"], 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c491f40-d68e-4abd-9f2b-6191ed4957f4"],
 " is the rest."
}], "Item",ExpressionUUID->"9003a050-49ae-4285-9c12-d43365810947"],

Cell["\<\
The questions: which closed formula each profile follows on a lattice, which \
formula of the continuum it approaches, why either measure stands for the \
volume of a region of the limit space, and which dimension the profiles read.\
\
\>", "Item",ExpressionUUID->"ae6f01f8-ef5b-466c-b0e3-592504123623"],

Cell["\<\
Each 3 \[Times] 3 figure is one substrate at one size: the rows are the sizes \
small, medium and large, the columns the square tiling, the triangular tiling \
and an irregular mesh of the square. The pictures keep the embedding of the \
substrate; no measurement uses it.\
\>", "Item",ExpressionUUID->"e9eab9fa-aee7-49b2-b1f2-abbc5bfbeb94"],

Cell["Setup", "Section",ExpressionUUID->"c90da718-37dc-41e0-8894-50e262cecbec"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`InfraGeometry`\>\"", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6c4f3628-e7d4-4424-bd93-5d876ab270ce"],

Cell[TextData[{
 "The centre ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af596790-1e06-487c-a525-82c462c7343a"],
 " is a vertex of least eccentricity. The profiles run up to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], "=", 
   StyleBox["\[LeftFloor]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["ecc",
      FontSlant->"Plain"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["c", "TI"], 
     StyleBox[")",
      SpanMaxSize->1], "-", "1"}], 
    StyleBox[")",
     SpanMaxSize->1], "/", "2"}], 
   StyleBox["\[RightFloor]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e843c5f-1bc5-4474-9964-6ce5615d918f"],
 ", so that a tube of thickness ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35fce91b-e0f2-4b9a-acc8-ca317673267c"],
 " about a segment of length ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7438cf0-c3a2-478d-bb74-aaaa9e38e271"],
 " from ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb0494a5-5c80-4a9e-82bc-5a199b53bf6d"],
 " stays inside the graph."
}], "Text",ExpressionUUID->"6ed433d6-8349-4a04-a9c8-9ba6f9d92109"],

Cell[BoxData[
 RowBox[{
  RowBox[{"profileRadius", "[", "g_", "]"}], " ", ":=", " ", 
  RowBox[{"Floor", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"VertexEccentricity", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}], " ", "-", " ", 
      "1"}], ")"}], "/", "2"}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8c9c4efc-04a9-472a-8d9a-f3fb11d41ef6"],

Cell[TextData[{
 "The far end ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21e05aa5-23e0-4055-a875-8a16a5cc7240"],
 " of the segments: a vertex at distance ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49f14734-a57b-431c-9f06-48a6f4e905a9"],
 " from the centre, drawn after a seed."
}], "Text",ExpressionUUID->"a930e139-959f-434b-b66a-f36b2f9c14d7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"farEnd", "[", "g_", "]"}], " ", ":=", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
    RowBox[{"RandomInfraPoint", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraShell", "[", 
       RowBox[{
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", 
        RowBox[{"profileRadius", "[", "g", "]"}]}], "]"}]}], "]"}]}], 
   ")"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"75fbd852-ac8d-4182-adde-a9c9c3131f61"],

Cell["\<\
The two measures of a list of regions: the counting measure first, the \
Riemannian measure second.\
\>", "Text",ExpressionUUID->"d9760c83-3c4c-461d-9e25-fce9238a80ee"],

Cell[BoxData[
 RowBox[{
  RowBox[{"twoMeasures", "[", 
   RowBox[{"g_", ",", " ", "regions_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"g", ",", " ", "regions", ",", " ", "#"}], "]"}], " ", "&"}], 
   " ", "/@", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<CountingMeasure\>\"", ",", 
     " ", "\"\<RiemannianMeasure\>\""}], "}"}]}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"5eb7e973-5621-4360-98f4-87e81d49ba69"],

Cell["\<\
A region drawn by its two measures: the interior green, the boundary blue. \
The counting measure counts both colours, the Riemannian measure the green \
vertices only.\
\>", "Text",ExpressionUUID->"dd3eea8d-c129-4171-a5d1-d301002b2345"],

Cell[BoxData[
 RowBox[{
  RowBox[{"interiorAndBoundary", "[", 
   RowBox[{"g_", ",", " ", "region_"}], "]"}], " ", ":=", " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"support", " ", "=", " ", 
      RowBox[{"FindInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", "region"}], "]"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraInterior", "[", 
        RowBox[{"g", ",", " ", "support"}], "]"}], " ", "->", " ", 
       "StandardGreen"}], ",", " ", 
      RowBox[{
       RowBox[{"InfraBoundary", "[", 
        RowBox[{"g", ",", " ", "support"}], "]"}], " ", "->", " ", 
       "StandardBlue"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"b8e221b7-7fdc-458c-8e75-3aa07b4e3890"],

Cell["Balls", "Section",ExpressionUUID->"c0fcb266-c4fd-469a-bc62-6081f8d86e46"],

Cell[TextData[{
 "The ball is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["r", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["c", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", "{", 
    StyleBox["v", "TI"]}], ":", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["c", "TI"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[LessEqual]", 
    StyleBox["r", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f40e9e74-e1e9-4bb2-97f3-63016676108d"],
 ". Below, the ball of radius ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b21d418-d546-4812-bbd8-f66e11d05643"],
 " about the centre."
}], "Item",ExpressionUUID->"efee1a23-89e1-4339-8b3c-853dfc7e4bc1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "size", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"interiorAndBoundary", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", 
            RowBox[{"profileRadius", "[", "g", "]"}]}], "]"}]}], "]"}]}], 
       "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"size", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
        " ", "\"\<Large\>\""}], "}"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[6]:= ",ExpressionUUID->"7f8db807-2e12-47c6-a4c4-e3b9ad4b7fb1"],

