Cell["\<\
The introduction's curve is the Riemannian curve, point for point. The \
counting curve, each volume at its own radius, approaches two from below: the \
two readings of one profile differ most at small radius, where the dimension \
is read.\
\>", "Item",ExpressionUUID->"27aeef4f-0e8b-43c0-81cf-0ed7f620ee2f"],

Cell[TextData[{
 "The two curves on the substrates: the counting curve ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c91d64b-0fc8-47fd-ad74-3288e637db3d"],
 " of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "\[Function]", 
   TemplateBox[{
     SubscriptBox[
      StyleBox["B", "TI"], 
      StyleBox["r", "TI"]]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f07345c5-1f0b-43ba-9609-890544d99def"],
 " in the first colour, the Riemannian curve ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36f20a60-8c5a-4a95-b752-e80c68897b37"],
 " of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "\[Function]", 
   TemplateBox[{
     RowBox[{
       StyleBox["Int", FontSlant -> "Plain"], 
       SubscriptBox[
        StyleBox["B", "TI"], 
        StyleBox["r", "TI"]]}]},
    "Abs"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebb8d008-e209-484b-97ce-34dfad41a669"],
 " in the second, over the radii below the eccentricity of the centre. The \
curves are ",
 Cell[BoxData[
  RowBox[{"2", "-", "1", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9af6545e-6d69-47da-825e-297d99d6f327"],
 " and ",
 Cell[BoxData[
  RowBox[{"2", "+", "1", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7e81fb0-2739-42a5-9146-4db73b6e7943"],
 ", the two rates of the planar lattices, and the line is the dimension two."
}], "Text",ExpressionUUID->"1c701390-f637-4d41-95d0-21a8d6fbc562"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "size"}], "]"}]}], ")"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"top", " ", "=", " ", 
        RowBox[{"VertexEccentricity", "[", 
         RowBox[{"g", ",", " ", "c"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Show", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"2", " ", "-", " ", 
             RowBox[{"1", "/", "r"}]}], ",", " ", 
            RowBox[{"2", " ", "+", " ", 
             RowBox[{"1", "/", "r"}]}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "1", ",", " ", 
            RowBox[{"top", " ", "-", " ", "2"}]}], "}"}]}], "]"}], ",", "\n", 
        "      ", 
        RowBox[{"ListPlot", "[", 
