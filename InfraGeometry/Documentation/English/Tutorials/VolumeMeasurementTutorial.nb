Cell[TextData[{
 "An instance grows linearly in ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16629526-5b69-403a-9544-9c8416ec000a"],
 ", like the shells of its band, and its Riemannian measure stays zero."
}], "Item",ExpressionUUID->"22177184-6369-4e3f-9ad0-a9cbea922b47"],

Cell["\<\
The instance found depends on the search. On the triangular tiling either \
shell of the band is an instance by itself, and the one found is the outer \
shell. On the square tiling a wall needs vertices of both shells and is \
larger than either.\
\>", "Item",ExpressionUUID->"cd6dd4b4-45ef-4b15-92c8-e24e0b4cff63"],

Cell[TextData[{
 "[[ Is the size of the least sphere instance in the band ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], 
   RowBox[{
    StyleBox["r", "TI"], ",", 
    RowBox[{
     StyleBox["r", "TI"], "+", "1"}]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5dd5710-790d-40ff-b3e5-cfea5cacd075"],
 " of a lattice a polynomial in ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e86fd353-8e40-4f8a-b615-cc27b04601a6"],
 "? ]]"
}], "Item",ExpressionUUID->"71ff881c-0af1-4f06-8249-3b98b8f84352"],

Cell["The measure", "Section",ExpressionUUID->"c14a6a02-ff4a-499a-99df-8b344dbccc42"],

Cell[TextData[{
 "The two measures differ by a layer, and that layer holds a share of order \
",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f71937e-6184-4c47-beef-976d5cdc5fbe"],
 " of a ball. Which of them is the volume? The argument runs through a graph \
that approximates a manifold."
}], "Text",ExpressionUUID->"d5d23c7e-2920-4ab9-ab11-eacbcc70ed12"],

Cell[TextData[{
 StyleBox["The approximating graph.",
  FontWeight->"Bold"],
 " Let ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65e26527-c9cc-4073-a6b4-e93835da1718"],
 " be a closed Riemannian manifold with normalized volume ",
 Cell[BoxData[
  StyleBox["\[Mu]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33832cdc-b6ff-4cfb-9e13-e8eee4df5f4e"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], "\[Subset]", 
   StyleBox["M", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bf849bd-68cc-4b01-bc88-c64b10b16676"],
 " a sample of ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eba88be2-6da1-434d-9dca-99b584ddb32e"],
 " points whose ",
 StyleBox["mesh",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], "=", 
   UnderscriptBox[
    StyleBox["sup",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["x", "TI"], "\[Element]", 
     StyleBox["M", "TI"]}],
    LimitsPositioning->False], "\[ThinSpace]", 
   UnderscriptBox[
    StyleBox["min",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["v", "TI"], "\[Element]", 
     StyleBox["V", "TI"]}],
    LimitsPositioning->False], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6af5a0b-c003-4a3b-b63b-756865c86862"],
 " is small. The ",
 StyleBox["Rips graph",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["G", "TI"], "\[Epsilon]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e114e3d-c0fc-465d-b4a6-db517baab8a0"],
 " joins two points at distance less than ",
 Cell[BoxData["\[Epsilon]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24662bc4-d823-4ceb-adaa-3c7287391f91"],
 "; ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["H", "TI"], "\[Epsilon]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a23bc4e8-10ec-44d9-8a6f-146fe28f0c66"],
 " is its hop distance and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Nu]", "TI"], 
    StyleBox["V", "TI"]], "=", 
   FractionBox["1", 
    StyleBox["N", "TI"]], 
   UnderscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["v", "TI"], "\[Element]", 
     StyleBox["V", "TI"]}],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["\[Delta]", "TI"], 
    StyleBox["v", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad139802-6e0a-4438-92f7-15ddfb53a1cf"],
 " its normalized counting measure."
}], "Item",ExpressionUUID->"1bfbf640-e870-457e-af69-4d37e83df55e"],

Cell[TextData[{
 StyleBox["Topology.",
  FontWeight->"Bold"],
 " For every small scale ",
 Cell[BoxData["\[Epsilon]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac12f3cc-e839-42a8-b750-932d073db103"],
 " and every sample dense enough for it, the clique complex of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["G", "TI"], "\[Epsilon]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2ed90e9-d170-42e8-8333-d6684e46d975"],
 " has the homotopy type of ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f802fb8e-ab94-415a-ba01-a7924475416a"],
 " (",
 ButtonBox["Latschev",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://doi.org/10.1007/PL00000526"], None}],
 "); quantitatively, ",
 Cell[BoxData[
  RowBox[{"14", 
   StyleBox["h", "TI"], "<", "\[Epsilon]", "<", 
   FractionBox["7", "8"], "\[CapitalDelta]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ebf22e1-40b5-4729-b219-c4822a8513ed"],
 " suffices, with ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ee4d185-4876-4684-8c31-2a9537741114"],
 " a bound from the convexity radius and the sectional curvature (",
 ButtonBox["Majhi",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2305.17288"], None}],
 "). The complex carries the topology, not the graph."
}], "Item",ExpressionUUID->"fbc4382a-b4a4-4ef9-bcc8-8e31fec7c7af"],

Cell[TextData[{
 StyleBox["Distance.",
  FontWeight->"Bold"],
 " If ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["h", "TI"], "<", "\[Epsilon]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb6c42de-fc66-48c1-8697-2e298b64e6e1"],
 ", then ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "\[LessEqual]", "\[Epsilon]", 
   SubscriptBox[
    StyleBox["H", "TI"], "\[Epsilon]"], "\[LessEqual]", 
   FractionBox["\[Epsilon]", 
    RowBox[{"\[Epsilon]", "-", "2", 
     StyleBox["h", "TI"]}]], " ", 
   StyleBox["d", "TI"], "+", "\[Epsilon]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a33ff255-618b-4b43-b12e-e5aa9da0f298"],
 ": a geodesic of length ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec95ed4d-f12a-48ad-849d-1c96b3e254b0"],
 " cut into pieces of length below ",
 Cell[BoxData[
  RowBox[{"\[Epsilon]", "-", "2", 
   StyleBox["h", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8910fde1-929c-4090-9bdc-61d07f627639"],
 ", each division point moved to a sample point within ",
 Cell[BoxData[
  StyleBox["h", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dce5793-44cb-4d53-9818-543f9c85f995"],
 ", is a path of the graph. As ",
 Cell[BoxData[
  RowBox[{"\[Epsilon]", "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c4ea40e-e42d-4771-9f22-1e9ad4a07e5b"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], "/", "\[Epsilon]", "\[Rule]", "0"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "765d4535-c5ae-4cf5-84fb-d9f2a9a501a7"],
 " the scaled hop distance converges uniformly to ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "412f9d30-f696-4c5a-8f2f-78953943f68c"],
 ", and shortest paths of the graph converge, along subsequences, to \
minimizing geodesics."
}], "Item",ExpressionUUID->"b9bf838b-65ae-4433-81fa-9c0f18a168ef"],

Cell[TextData[{
 StyleBox["Volume.",
  FontWeight->"Bold"],
 " Coverage alone does not make ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Nu]", "TI"], 
   StyleBox["V", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc6671d8-c7b7-465f-9f4f-dd389798dcb6"],
 " approximate ",
 Cell[BoxData[
  StyleBox["\[Mu]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "669f2eb6-5d13-4dec-9bef-e04b5d9eaecf"],
 ": equally spaced points on a circle, with as many again crowded on a short \
arc, have a small mesh and put half the mass on the arc. It does when the \
mesh tends to zero and the nearest-vertex cells ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["v", "TI"]], "\[SubsetEqual]", 
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["h", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["v", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86ef09e2-0e1a-44f9-a738-6b12aec03353"],
 " have nearly equal volumes, and almost surely when the points are drawn \
independently from ",
 Cell[BoxData[
  StyleBox["\[Mu]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33246e7d-269b-42f2-986d-a5635942f714"],
 ". Each vertex represents its cell, the centre of a ball included."
}], "Item",ExpressionUUID->"4765dcd0-a4bd-4341-863f-6f4e583df922"],

Cell[TextData[{
 StyleBox["Balls.",
  FontWeight->"Bold"],
 " Let ",
 Cell[BoxData[
  RowBox[{"\[Epsilon]", "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4efc73de-ef6a-4e57-9e2e-8f638a0b3239"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], "/", "\[Epsilon]", "\[Rule]", "0"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "f28dc695-4bd3-4ffb-b188-8c1f4b82aaec"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Nu]", "TI"], 
    StyleBox["V", "TI"]], "\[Rule]", 
   StyleBox["\[Mu]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ad21a30-618d-4e40-813e-2d910ab2d7dd"],
 " weakly, and let the hop radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05ecf20c-97e3-43f9-a45f-79d583112064"],
 " grow with ",
 Cell[BoxData[
  RowBox[{"\[Epsilon]", 
   StyleBox["r", "TI"], "\[Rule]", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "012701f9-32b5-42d0-9623-9fc2c1be6da4"],
 ". Both the closed graph ball ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["r", "TI"]], "=", "{", 
   SubscriptBox[
    StyleBox["H", "TI"], "\[Epsilon]"], "\[LessEqual]", 
   StyleBox["r", "TI"], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08818a33-ffae-4d4d-9432-ca8a833e1b79"],
 " and the open one ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["B", "TI"], 
    RowBox[{
     StyleBox["r", "TI"], "-", "1"}]], "=", "{", 
   SubscriptBox[
    StyleBox["H", "TI"], "\[Epsilon]"], "<", 
   StyleBox["r", "TI"], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3ed454a-e2a7-42c2-893e-2767d5079cc6"],
 " have normalized counts converging to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Mu]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["R", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["p", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23288bc7-08b9-4f17-9a1c-a2f70e2eafaf"],
 ", since they lie between the geodesic balls of radii ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], "-", 
   StyleBox["a", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62a87e55-b1c2-498e-adb2-485063d7b43a"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], "+", 
   StyleBox["a", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "526f2329-9260-4398-a678-e65e49464d69"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e56aa77-7bd4-4f5b-a1d8-5ad0960fbe07"],
 ", and the geodesic sphere has volume zero. Removing the outer graph layer \
is consistent, and it is not required."
}], "Item",ExpressionUUID->"218a48d8-e272-4c5d-b61a-edda49a53199"],

Cell[TextData[{
 "The Riemannian measure counts the interior of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["B", "TI"], 
   StyleBox["r", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe47e6ae-86a2-41f0-b218-b9fc68589231"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["B", "TI"], 
    RowBox[{
     StyleBox["r", "TI"], "-", "1"}]], "\[SubsetEqual]", 
   StyleBox["Int",
    FontSlant->"Plain"], 
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["r", "TI"]], "\[SubsetEqual]", 
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["r", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af651dee-5ab5-42dd-ac45-c4edecb5e631"],
 ", since a vertex at hop distance at most ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fab21e1c-d72b-40dc-91f7-062c727ff229"],
 " has all its neighbours within ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4de1c8d-dce5-4af0-803c-1d32cb4ca115"],
 ". So the Riemannian measure converges to the same volume. The counting \
measure ",
 StyleBox["represents the ball of radius ",
  FontWeight->"Bold"],
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"f7d8a527-18cb-4bb5-bb74-3fbf18596ad6"],
 " read as a closed ball, the Riemannian measure represents it read as an \
open ball, and the argument singles out neither."
}], "Item",ExpressionUUID->"f250022c-490a-4896-a978-6ce7feb74cd2"],

Cell[TextData[{
 "A Rips graph of points sprinkled in the unit square at the scale ",
 Cell[BoxData[
  RowBox[{"\[Epsilon]", "=", 
   SuperscriptBox[
    StyleBox["N", "TI"], 
    RowBox[{"-", "1", "/", "3"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8cb9ef86-55c9-496b-a946-5b12595856e3"],
 ", for a growing number ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a90735cc-49af-4a05-a632-a461055b1c19"],
 " of points, and the ball about the point nearest the middle at the hop \
radius closest to a quarter. Each point is drawn with its nearest-point cell: \
the cells of the interior green, of the boundary blue. The red circle has the \
radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "089c29f2-7a41-424d-8997-96289888e6ba"],
 " times the mean length of one hop from the centre."
}], "Text",ExpressionUUID->"51c4b314-b73c-44ec-a1b3-941d887a1a5e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"points", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"RandomPoint", "[", 
           RowBox[{
            RowBox[{"Rectangle", "[", "]"}], ",", " ", "count"}], "]"}]}], 
         ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"rips", " ", "=", " ", 
        RowBox[{"NearestNeighborGraph", "[", 
         RowBox[{"points", ",", " ", 
          RowBox[{"{", 
           RowBox[{"All", ",", " ", 
            RowBox[{"count", "^", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "/", "3"}], ")"}]}]}], "}"}]}], "]"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"Nearest", "[", 
          RowBox[{"points", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"1", "/", "2"}], ",", " ", 
             RowBox[{"1", "/", "2"}]}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"hop", " ", "=", " ", 
        RowBox[{"Mean", " ", "@", " ", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{"pt", " ", "|->", " ", 
            RowBox[{
             RowBox[{"EuclideanDistance", "[", 
              RowBox[{"pt", ",", " ", "c"}], "]"}], "/", 
             RowBox[{"GraphDistance", "[", 
              RowBox[{"rips", ",", " ", "c", ",", " ", "pt"}], "]"}]}]}], ",",
            " ", 
           RowBox[{"DeleteCases", "[", 
            RowBox[{"points", ",", " ", "c"}], "]"}]}], "]"}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"radius", " ", "=", " ", 
        RowBox[{"Round", "[", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"4", " ", "hop"}], ")"}]}], "]"}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"ball", " ", "=", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"rips", ",", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"c", ",", " ", "radius"}], "]"}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"inner", " ", "=", " ", 
        RowBox[{"InfraInterior", "[", 
         RowBox[{"rips", ",", " ", "ball"}], "]"}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"Graphics", "[", 
       RowBox[{"{", "\n", "      ", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{"cell", " ", "|->", " ", 
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"owner", " ", "=", " ", 
                RowBox[{"First", " ", "@", " ", 
                 RowBox[{"Nearest", "[", 
                  RowBox[{"points", ",", " ", 
                   RowBox[{"RegionCentroid", "[", "cell", "]"}]}], "]"}]}]}], 
               "}"}], ",", "\n", "        ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"EdgeForm", "[", "LightGray", "]"}], ",", " ", 
                RowBox[{"Which", "[", 
                 RowBox[{
                  RowBox[{"MemberQ", "[", 
                   RowBox[{"inner", ",", " ", "owner"}], "]"}], ",", " ", 
                  RowBox[{"Lighter", "[", 
                   RowBox[{"StandardGreen", ",", " ", "0.5"}], "]"}], ",", 
                  " ", 
                  RowBox[{"MemberQ", "[", 
                   RowBox[{"ball", ",", " ", "owner"}], "]"}], ",", " ", 
                  RowBox[{"Lighter", "[", 
                   RowBox[{"StandardBlue", ",", " ", "0.5"}], "]"}], ",", " ",
                   "True", ",", " ", 
                  RowBox[{"FaceForm", "[", "]"}]}], "]"}], ",", " ", "cell"}],
                "}"}]}], "]"}]}], ",", "\n", "        ", 
           RowBox[{"MeshPrimitives", "[", 
            RowBox[{
             RowBox[{"VoronoiMesh", "[", 
              RowBox[{"points", ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}], "]"}], ",", 
             " ", "2"}], "]"}]}], "]"}], ",", "\n", "      ", 
         RowBox[{"Point", "[", "points", "]"}], ",", " ", "StandardRed", ",", 
         " ", 
         RowBox[{"Circle", "[", 
          RowBox[{"c", ",", " ", 
           RowBox[{"hop", " ", "radius"}]}], "]"}]}], "}"}], "]"}]}], "]"}], ",",
     "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"count", ",", " ", 
      RowBox[{"{", 
       RowBox[{"100", ",", " ", "400", ",", " ", "1600"}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[20]:= ",ExpressionUUID->"ebb3ef5b-63cd-479f-9692-cee882eea736"],

