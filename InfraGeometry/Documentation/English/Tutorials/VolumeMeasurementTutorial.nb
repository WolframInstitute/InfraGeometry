Cell[TextData[{
 "The ball volumes of the finite grids against the infinite grid, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["d", "TI"]], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["r", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["k", "TI"],
     LimitsPositioning->False], 
    RowBox[{
     SuperscriptBox["2", 
      StyleBox["k", "TI"]], 
     TemplateBox[{
       StyleBox["d", "TI"], 
       StyleBox["k", "TI"]},
      "Binomial"], 
     TemplateBox[{
       StyleBox["r", "TI"], 
       StyleBox["k", "TI"]},
      "Binomial"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5036dfc7-2035-4f17-aad9-7225146440d0"],
 ", and against the leading term ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    SuperscriptBox["2", 
     StyleBox["d", "TI"]], 
    RowBox[{
     StyleBox["d", "TI"], "!"}]], 
   SuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8ecd170-5349-4a10-9791-568ce3e12450"],
 "."
}], "Text",ExpressionUUID->"82117f9a-9db6-413f-b097-6053a106a433"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"GridGraph", "[", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"11", ",", " ", "dim"}], "]"}], "]"}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"top", " ", "=", " ", 
        RowBox[{"VertexEccentricity", "[", 
         RowBox[{"g", ",", " ", "c"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Show", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"2", "^", "k"}], " ", 
               RowBox[{"Binomial", "[", 
                RowBox[{"dim", ",", " ", "k"}], "]"}], " ", 
               RowBox[{"Binomial", "[", 
                RowBox[{"r", ",", " ", "k"}], "]"}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"k", ",", " ", "0", ",", " ", "dim"}], "}"}]}], "]"}], 
            ",", " ", 
            RowBox[{
             RowBox[{"2", "^", "dim"}], " ", 
             RowBox[{
              RowBox[{"r", "^", "dim"}], "/", 
              RowBox[{"dim", "!"}]}]}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "0", ",", " ", "top"}], "}"}]}], "]"}], ",",
         "\n", "      ", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"InfraBall", "[", 
               RowBox[{"c", ",", " ", "r"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"r", ",", " ", "0", ",", " ", "top"}], "}"}]}], "]"}], 
            ",", " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
          RowBox[{"DataRange", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "top"}], "}"}]}]}], "]"}], ",", "\n", 
        "      ", 
        RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"dim", ",", " ", "3"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[26]:= ",ExpressionUUID->"7cab389b-a8d2-4ea3-80eb-a50ba3c202ad"],

