Cell["\<\
From slope one on, the cone is the far ball under both measures, on every \
substrate. Below slope one the cone contains the far ball and is larger: at \
slope zero it is the geodesic itself.\
\>", "Item",ExpressionUUID->"9a9d4f7e-c2a7-4b0e-9681-4a999845031f"],

Cell[TextData[{
 "[[ For a rational slope ",
 Cell[BoxData[
  RowBox[{"0", "<", 
   StyleBox["m", "TI"], "<", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3236ce35-9f82-4373-95ad-bd0a7f177cd4"],
 ", is the counting measure of the cone about a geodesic of length ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce65a860-7ddd-40d2-a4cd-dd7d08dbae2a"],
 " in the square lattice a quasi-polynomial in ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b28f05a2-4320-4b1c-961a-22396ac3ca12"],
 ", and does it depend on the geodesic chosen in the interval? ]]"
}], "Item",ExpressionUUID->"76d7532d-17e0-4e0d-b1bb-685fdedfb27f"],

Cell["Spheres", "Section",ExpressionUUID->"1096f9b7-d432-4e9f-8228-24d2086bffd8"],

Cell[TextData[{
 "A set ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b352a0c1-ac6c-451d-8cbc-b09a49dfc6ce"],
 " in the band ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["S", "TI"], 
     RowBox[{
      StyleBox["r", "TI"], ",", 
      StyleBox["s", "TI"]}]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["c", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", "{", 
    StyleBox["v", "TI"]}], ":", 
   RowBox[{
    StyleBox["r", "TI"], "\[LessEqual]", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["c", "TI"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[LessEqual]", 
    StyleBox["s", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec21a9f2-c037-40ce-b642-026ee9a711e6"],
 " ",
 StyleBox["separates",
  FontWeight->"Bold"],
 " if every path from ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52240d54-d456-4a58-8bad-9c10f380d604"],
 " to a vertex beyond distance ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9a3a7a1a-936e-4ff4-8273-41ea3bb20dc0"],
 " meets ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e30aebe-676c-402a-91ab-79d214e0ade9"],
 ". A ",
 StyleBox["sphere instance",
  FontWeight->"Bold"],
 " of the band is a separating set that induces a connected subgraph and has \
no proper subset with both properties: a minimal wall around ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c176f99c-c9a9-41d3-8b85-97cdafaba407"],
 ". The head ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f07df24e-e5d8-4159-8ae8-bc042484ecfa"],
 " is the family of instances; one instance, found greedily, is its \
representative."
}], "Item",ExpressionUUID->"3560c91f-be7a-4ce0-ac53-341b1d216983"],

Cell[TextData[{
 "In the band ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], 
   RowBox[{
    StyleBox["r", "TI"], ",", 
    RowBox[{
     StyleBox["r", "TI"], "+", "1"}]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e599bee3-7600-496d-9834-418323c9847d"],
 " the Riemannian measure of an instance is zero whenever every vertex at \
distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95018223-5046-47ac-aa13-de867a820e3c"],
 " has a neighbour at distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "+", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c6828dd-75f3-4886-b0af-7425e8118f3c"],
 ": every vertex of the band then has a neighbour outside it."
}], "Item",ExpressionUUID->"757a52bc-b731-40a9-8afc-72c0ef4f4a35"],

Cell[TextData[{
 "In the continuum an instance stands for the geodesic sphere, of area ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["n", "TI"]], 
   SuperscriptBox[
    StyleBox["r", "TI"], 
    RowBox[{
     StyleBox["n", "TI"], "-", "1"}]], 
   StyleBox["(",
    FontSize->1.2 Inherited], "1", "-", 
   FractionBox[
    StyleBox["Scal",
     FontSlant->"Plain"], 
    RowBox[{"6", 
     StyleBox["n", "TI"]}]], 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "+", 
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["r", "TI"], "4"], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c433be2-c7fc-404a-b653-4e973984df93"],
 ". An instance is not a shell: no two vertices at one distance from ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1afd4e3c-5715-4c8b-ab57-cea24196d745"],
 " are adjacent on the square tiling, so a wall there zigzags between two \
shells."
}], "Item",ExpressionUUID->"2df3cb61-728d-4665-8f65-043abd3c1948"],

Cell[TextData[{
 "One instance in the band between the radii ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftCeiling]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["R", "TI"], "/", "2"}], 
   StyleBox["\[RightCeiling]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "503f63d9-15f8-4e80-99dc-e651020d1adc"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftCeiling]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["R", "TI"], "/", "2"}], 
   StyleBox["\[RightCeiling]",
    SpanMaxSize->1], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b97eb6f8-cd58-4be5-8b0f-c4de2aec9e66"],
 ", orange, drawn over the band, green."
}], "Text",ExpressionUUID->"d9f9ea8c-89a2-47d2-9036-fd94be4efea3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "size", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
        RowBox[{"inner", " ", "=", " ", 
         RowBox[{"Ceiling", "[", 
          RowBox[{
           RowBox[{"profileRadius", "[", "g", "]"}], "/", "2"}], "]"}]}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"wall", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"FindInfraRepresentative", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSphere", "[", 
             RowBox[{"c", ",", " ", 
              RowBox[{"{", 
               RowBox[{"inner", ",", " ", 
                RowBox[{"inner", " ", "+", " ", "1"}]}], "}"}]}], "]"}]}], 
           "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", 
             RowBox[{"{", 
              RowBox[{"inner", ",", " ", 
               RowBox[{"inner", " ", "+", " ", "1"}]}], "}"}]}], "]"}], " ", "->",
            " ", "StandardGreen"}], ",", " ", 
          RowBox[{"wall", " ", "->", " ", "StandardOrange"}]}], "}"}]}], 
       "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"size", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
        " ", "\"\<Large\>\""}], "}"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->
  "In[18]:= ",ExpressionUUID->"c4d8e277-a870-4b6f-a844-77d328db0946"],

