Cell[TextData[{
 "The small square tiling carries no ink: every triple has a median, the \
patch is modular, and the ellipsoid of slack ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ddf58f8-8ee5-4926-8baf-67e0c04435f4"],
 " is the tube of thickness ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47792c09-b438-400d-b91c-84906bfaa3ae"],
 " for every pair of foci. The square lattice itself is a median graph, with \
the coordinatewise median."
}], "Item",ExpressionUUID->"75ad7b1e-46f0-4477-98af-6aa3bf4f052d"],

Cell["\<\
On the triangular tiling and on the mesh every vertex lacks a median with \
some pair.\
\>", "Item",ExpressionUUID->"23979eff-0823-462d-9c2d-12bd87a7cc09"],

Cell[TextData[{
 "The smallest counterexample to the equality on the triangular tiling, with \
foci at distance two and thickness one: the corners ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], ",", 
   StyleBox["b", "TI"], ",", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca1fe9f8-4e1d-4ede-b14d-2242f9c412fd"],
 " of a triangle of side two, with the three intervals between them."
}], "Text",ExpressionUUID->"e822279a-8925-4cef-88a8-62c26b66044b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"beyond", " ", "=", " ", 
     RowBox[{"focus", " ", "|->", " ", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraQuadric", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"a", ",", " ", "focus"}], "}"}], ",", " ", "4"}], 
           "]"}]}], "]"}], ",", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraTube", "[", 
           RowBox[{
            RowBox[{"InfraSegment", "[", 
             RowBox[{"a", ",", " ", "focus"}], "]"}], ",", " ", "1"}], 
           "]"}]}], "]"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"beyond", "[", "#", "]"}], " ", "=!=", " ", 
         RowBox[{"{", "}"}]}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"{", 
    RowBox[{"x", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"beyond", "[", "b", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraSegment", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"b", ",", " ", "x"}], "]"}], ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"x", ",", " ", "a"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b", ",", " ", "x"}], "}"}]}], "}"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"64905f98-106a-4496-b38b-832a75eacefb"],

