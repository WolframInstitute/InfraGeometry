Cell[TextData[{
 "The profiles over ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["s", "TI"], "=", "0"}], ",", "\[Ellipsis]", ",", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b36e6231-cb7b-4203-9c2a-2a5b65038c72"],
 ": the fat tube as joined points, the thin tube as points, the counting \
measure in the first colour and the Riemannian measure in the second. On the \
square tiling the curves are the box count and its value one step thinner."
}], "Text",ExpressionUUID->"db5d5d22-d84a-4b83-858f-a1ce503ba0f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "size"}], "]"}]}], ")"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
        RowBox[{"p", " ", "=", " ", 
         RowBox[{"farEnd", "[", "g", "]"}]}], ",", " ", 
        RowBox[{"radius", " ", "=", " ", 
         RowBox[{"profileRadius", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"geodesic", " ", "=", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"c", ",", " ", "p"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"box", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"name", " ", "==", " ", "\"\<SquareTilingGraph\>\""}], ",", 
          " ", 
          RowBox[{
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSegment", "[", 
              RowBox[{"c", ",", " ", "p"}], "]"}], ",", 
             " ", "\"\<CountingMeasure\>\""}], "]"}], " ", "+", " ", 
           RowBox[{"2", " ", "s", " ", 
            RowBox[{"(", 
             RowBox[{"radius", " ", "+", " ", "2"}], ")"}]}], " ", "+", " ", 
           RowBox[{"2", " ", "s", " ", 
            RowBox[{"(", 
             RowBox[{"s", " ", "-", " ", "1"}], ")"}]}]}], ",", " ", 
          "Nothing"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Show", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{"Evaluate", "[", 
           RowBox[{"{", 
            RowBox[{"box", ",", " ", 
             RowBox[{"box", " ", "/.", " ", 
              RowBox[{"s", " ", "->", " ", 
               RowBox[{"s", " ", "-", " ", "1"}]}]}]}], "}"}], "]"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"s", ",", " ", "0", ",", " ", "radius"}], "}"}]}], "]"}], ",",
         "\n", "      ", 
        RowBox[{"ListLinePlot", "[", 
         RowBox[{
          RowBox[{"twoMeasures", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"InfraTube", "[", 
               RowBox[{
                RowBox[{"InfraSegment", "[", 
                 RowBox[{"c", ",", " ", "p"}], "]"}], ",", " ", "s"}], "]"}], 
