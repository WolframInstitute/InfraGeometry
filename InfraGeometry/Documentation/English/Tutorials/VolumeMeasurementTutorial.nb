Cell["\<\
The cells of the closed ball overshoot the circle by about one layer of \
cells, the cells of the interior fall short of it by about as much. Both \
layers thin out as the sample refines, and both unions of cells approach the \
disk.\
\>", "Item",ExpressionUUID->"69bccf46-a590-44c7-9b81-5e8fe8c2d1d8"],

Cell[TextData[{
 StyleBox["Exact evidence.",
  FontWeight->"Bold"],
 " On the cycle of ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03ce7dc4-b8fc-40b5-a7a2-61cf4b5c306e"],
 " vertices, spacing ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], "=", "1", "/", 
   StyleBox["N", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9eed5a3a-be9d-46f8-b087-4429bda70a98"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], "=", 
   StyleBox["a", "TI"], 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c4681b14-1a04-4518-ae00-686b64422d6c"],
 ", the ball of radius ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd0afa9d-82b1-4ce0-addf-ba126a31a25f"],
 " has volume ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82714c22-9405-418a-b86c-bfb3b9269858"],
 ", the closed graph ball has mass ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["R", "TI"], "+", 
   StyleBox["a", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed7ba982-f3db-4954-ad47-88a99862034e"],
 " and the open one ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["R", "TI"], "-", 
   StyleBox["a", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec3e3cf6-880d-4a82-b79b-7f14dca216d8"],
 ". The two one-layer conventions err by one vertex mass with opposite signs; \
half weight at the two end vertices gives ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b46f48ea-6fbf-4adf-80ba-180efc8945f3"],
 " exactly."
}], "Item",ExpressionUUID->"68693105-bb13-40fb-b511-c54f8c8a317c"],

Cell[TextData[{
 "The two measures of the ball of radius ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], "=", "1", "/", "10"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e42a4ef2-6c60-4279-a32d-fc0880a98192"],
 " on cycles of growing length, divided by ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "315da7b9-d59a-43fb-acf1-0ba805d4f8a1"],
 ", beside the volume ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd59847b-a2e1-4094-922d-1d80f1c1aa8b"],
 "."
}], "Text",ExpressionUUID->"4021d5db-66b0-4d42-a6a8-5fb9c097a537"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"CycleGraph", "[", "count", "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"ball", " ", "=", " ", 
           RowBox[{"InfraBall", "[", 
            RowBox[{"1", ",", " ", 
             RowBox[{"count", "/", "10"}]}], "]"}]}], "}"}], ",", "\n", 
         "      ", 
         RowBox[{"{", 
          RowBox[{"count", ",", " ", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{
              "g", ",", " ", "ball", ",", " ", "\"\<RiemannianMeasure\>\""}], 
              "]"}], "/", "count"}], "]"}], ",", " ", 
           RowBox[{"N", "[", 
            RowBox[{"1", "/", "5"}], "]"}], ",", " ", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{
              "g", ",", " ", "ball", ",", " ", "\"\<CountingMeasure\>\""}], 
              "]"}], "/", "count"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"count", ",", " ", 
         RowBox[{"{", 
          RowBox[{"100", ",", " ", "200", ",", " ", "400"}], "}"}]}], "}"}]}],
       "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"\"\<N\>\"", ",", " ", "\"\<Riemannian\>\"", ",", 
       " ", "\"\<volume\>\"", ",", " ", "\"\<counting\>\""}], "}"}]}], "]"}], 
   ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"cade9679-780a-47f7-8c3f-182afaca66e7"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"N\"\>", "\<\"Riemannian\"\>", "\<\"volume\"\>", \
"\<\"counting\"\>"},
    {"100", "0.19`", "0.2`", "0.21`"},
    {"200", "0.195`", "0.2`", "0.205`"},
    {"400", "0.1975`", "0.2`", "0.2025`"}
   },
   AutoDelete->False,
