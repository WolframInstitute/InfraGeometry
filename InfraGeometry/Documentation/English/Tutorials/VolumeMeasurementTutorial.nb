Cell["\<\
On every substrate the continuum volume runs between the two measures: the \
counting measure above, the Riemannian measure below, one layer of vertices \
apart.\
\>", "Item",ExpressionUUID->"31215842-5192-4130-b7d7-830c8115a049"],

Cell[TextData[{
 StyleBox["The centre.",
  FontWeight->"Bold"],
 " The ball of radius zero has counting measure one and Riemannian measure \
zero, and neither is wrong. The centre represents its cell; a ball of \
physical radius below the spacing contains only the centre, and its volume \
exponent is zero. A dimension appears only over a range of resolved scales, \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], "\[LessLess]", "\[Epsilon]", "\[LessLess]", 
   StyleBox["R", "TI"], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80decd2a-4676-419a-b9be-1ca7dbfa0f0a"],
 ", and there closed balls and balls rounded by one hop have the same \
asymptotics."
}], "Item",ExpressionUUID->"85be6049-52ef-4f8b-b77b-4d385700b50f"],

Cell["\<\
[[ Which weighting of the boundary, such as half weight on it as on the \
cycle, makes the error second order on a mesh? ]]\
\>", "Item",ExpressionUUID->"bd571ec3-67e0-4083-b567-7f202fbf5f71"],

Cell["Dimension", "Section",ExpressionUUID->"0ce78817-57ff-43c3-b766-1b6815575514"],

Cell[TextData[{
 "On a space of dimension ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e92769b-fb34-45cf-9fb0-ff38ab59cce1"],
 " the ball volume grows like ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["r", "TI"], 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a86a92a9-5354-4528-980b-b8bdfd2c905f"],
 ". The ",
 StyleBox["log-difference quotient",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["r", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    RowBox[{
     StyleBox["log",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["V", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["r", "TI"], "+", "1"}], 
     StyleBox[")",
      SpanMaxSize->1], "-", 
     StyleBox["log",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["V", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["r", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    RowBox[{
     StyleBox["log",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["r", "TI"], "+", "1"}], 
     StyleBox[")",
      SpanMaxSize->1], "-", 
     StyleBox["log",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["r", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee3a5038-9bbe-4421-965f-b8f795bf804b"],
 " is the slope of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["V", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "921ef73e-e370-4657-ac65-242acb6f8c10"],
 " against ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65ae1d2c-5dae-4644-8987-124863477c62"],
 " between two radii, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LogDifferenceQuotients"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/LogDifferenceQuotients", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "82d5586a-ab8c-47ad-a111-5e348c1b7320"],
 " computes it."
}], "Item",ExpressionUUID->"4cf35bc8-14b9-426e-823f-135db6d03b62"],

Cell[TextData[{
 "For a polynomial profile of degree ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41d1290c-34c3-4b2b-ad69-a26fd7215d89"],
 " with leading coefficient ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18411ad5-1d03-4c40-ae88-be35253ea267"],
 " and next coefficient ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], 
   RowBox[{
    StyleBox["d", "TI"], "-", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e8f138f-44c1-406f-bf4c-aaa51e27743a"],
 ", ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["r", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["d", "TI"], "-", 
   FractionBox[
    RowBox[{
     SubscriptBox[
      StyleBox["c", "TI"], 
      RowBox[{
       StyleBox["d", "TI"], "-", "1"}]], "/", 
     SubscriptBox[
      StyleBox["c", "TI"], 
      StyleBox["d", "TI"]]}], 
    StyleBox["r", "TI"]], "+", 
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["r", "TI"], 
    RowBox[{"-", "2"}]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0afc809-22e9-48c9-8b45-6d5249ea4be5"],
 ". For a lattice ball count ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["c", "TI"], 
    RowBox[{
     StyleBox["d", "TI"], "-", "1"}]], "/", 
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["d", "TI"]], "=", 
   StyleBox["d", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d37ba284-45e5-4ba5-bc78-e84cbf04c087"],
 ", so the counting profile ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["r", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9cd07a8f-a7cf-4b96-8328-d020f1e4c19a"],
 " gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "-", 
   FractionBox[
    StyleBox["d", "TI"], 
    RowBox[{"2", 
     StyleBox["r", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a00b9896-23b9-43e3-a94e-d74aeaace653"],
 ", from below, and the Riemannian profile ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["r", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a87b9dac-e79e-4758-9d53-63d930e245d2"],
 " gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "+", 
   FractionBox[
    StyleBox["d", "TI"], 
    RowBox[{"2", 
     StyleBox["r", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fcf30fe-732c-44e1-aefa-7ee73ca00aa9"],
 ", from above, at the same rate."
}], "Item",ExpressionUUID->"1c1f2dba-4793-4c89-a10c-0c96a290f018"],

Cell[TextData[{
 "The technical introduction of the Wolfram Physics Project, ",
 ButtonBox["section 4.5",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolframphysics.org/technical-introduction/limiting-\
behavior-and-emergent-geometry/the-notion-of-dimension/"], None}],
 ", defines ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["V", "TI"], 
   StyleBox["r", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa7b928a-2871-4085-b727-744e738c29dd"],
 " as the number of vertices within distance ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d010821d-4f0a-489d-b5c1-e11785c77345"],
 " and ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["r", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d7e7ab4-0638-430a-8173-e7b60e6551d0"],
 " as above. Its code applies the log-differences to the list ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["V", "TI"], "0"], ",", 
   SubscriptBox[
    StyleBox["V", "TI"], "1"], ",", 
   SubscriptBox[
    StyleBox["V", "TI"], "2"], ",", "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "89ef2bdb-e47d-44b3-ab32-27ecfb5ac57f"],
 " that starts at radius zero, so the value it plots at radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fdb92b08-7ac0-4330-90f8-5d6ecd05c337"],
 " is computed from ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["V", "TI"], 
   RowBox[{
    StyleBox["r", "TI"], "-", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64f2f579-ad58-4ac8-8944-b47413222f88"],
 ". On a lattice ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["V", "TI"], 
   RowBox[{
    StyleBox["r", "TI"], "-", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e89ad211-7003-4ab4-9c90-7461eaa29dde"],
 " is the count of the interior of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["B", "TI"], 
   StyleBox["r", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa060156-e5ea-4833-aca2-73bbe7060186"],
 ": the introduction reads the Riemannian measure."
}], "Item",ExpressionUUID->"ef345c1f-dd33-4c0f-a04c-4fc097cc007d"],

Cell["\<\
The introduction's code, beside the quotients of the paclet's two profiles, \
on the grid graph of the introduction.\
\>", "Text",ExpressionUUID->"e48fdbcf-4ffa-4b03-a1b4-2c89ef39f88f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"51", ",", " ", "51"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ballVolumes", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "r"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "0", ",", " ", "25"}], "}"}]}], "]"}], ",", 
       " ", "\"\<CountingMeasure\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"{", "\n", "      ", 
      RowBox[{
       RowBox[{"Take", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ResourceFunction", "[", "\"\<LogDifferences\>\"", "]"}], "[", 
          RowBox[{"N", " ", "@", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"Values", " ", "@", " ", 
             RowBox[{
              RowBox[{
              "ResourceFunction", "[", "\"\<GraphNeighborhoodVolumes\>\"", 
               "]"}], "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"{", "c", "}"}]}], "]"}]}]}]}], "]"}], ",", " ", 
         "24"}], "]"}], ",", "\n", "      ", 
       RowBox[{"LogDifferenceQuotients", "[", 
        RowBox[{"N", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"InfraBall", "[", 
              RowBox[{"c", ",", " ", "r"}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"r", ",", " ", "1", ",", " ", "25"}], "}"}]}], "]"}], ",",
            " ", "\"\<RiemannianMeasure\>\""}], "]"}]}], "]"}], ",", "\n", 
       "      ", 
       RowBox[{"LogDifferenceQuotients", "[", 
        RowBox[{"N", " ", "@", " ", 
         RowBox[{"Rest", "[", "ballVolumes", "]"}]}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<introduction\>\"", ",", " ", "\"\<Riemannian\>\"", ",", 
        " ", "\"\<counting\>\""}], "}"}]}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", "2", "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->
  "In[23]:= ",ExpressionUUID->"84fa5ddb-c3b9-4b5f-a027-ce2c6bfc410b"],

