                RowBox[{"c", ",", " ", "r"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"r", ",", " ", "1", ",", " ", 
                 RowBox[{"top", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], 
            "]"}], "]"}]}], "]"}], ",", "\n", "      ", 
        RowBox[{"GridLines", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"None", ",", " ", 
           RowBox[{"{", "2", "}"}]}], "}"}]}], ",", " ", 
        RowBox[{"PlotRange", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "4"}], "}"}]}]}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
