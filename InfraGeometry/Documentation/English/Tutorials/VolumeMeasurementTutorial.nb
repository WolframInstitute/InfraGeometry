Cell["\<\
The quotients at the centres of grids of dimension one, two and three.\
\>", "Text",ExpressionUUID->"745aeb7f-a4e1-4de6-b968-df02ba2d1a63"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"GridGraph", "[", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"First", "[", "spec", "]"}], ",", " ", 
           RowBox[{"Last", "[", "spec", "]"}]}], "]"}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"ballVolumes", " ", "=", " ", 
        RowBox[{"N", " ", "@", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraBall", "[", 
              RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
             " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"r", ",", " ", "0", ",", " ", 
             RowBox[{"VertexEccentricity", "[", 
              RowBox[{"g", ",", " ", "c"}], "]"}]}], "}"}]}], "]"}]}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"LogDifferenceQuotients", "[", "ballVolumes", "]"}], ",", 
          " ", 
          RowBox[{"LogDifferenceQuotients", "[", 
           RowBox[{"Rest", "[", "ballVolumes", "]"}], "]"}]}], "}"}], ",", 
        " ", 
        RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
        RowBox[{"Joined", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"True", ",", " ", "False"}], "}"}]}], ",", " ", 
        RowBox[{"GridLines", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"None", ",", " ", 
           RowBox[{"{", 
            RowBox[{"Last", "[", "spec", "]"}], "}"}]}], "}"}]}], ",", " ", 
        RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"spec", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"51", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"51", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"21", ",", " ", "3"}], "}"}]}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[27]:= ",ExpressionUUID->"2dd70925-963f-4ef3-bf7d-71ea820caf91"],

