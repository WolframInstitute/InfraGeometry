Cell[TextData[{
 "The three intervals are the three sides of the triangle, and no vertex lies \
on all three: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], ",", 
   StyleBox["b", "TI"], ",", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "504fcca4-7caf-4ce4-b6f3-1e09a21d8aa1"],
 " have no median. The corner ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf0bd45d-e520-4be2-a17e-4cc97c5afe51"],
 " has slack two over the foci ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], ",", 
   StyleBox["b", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36d54f03-80a0-45b3-8cd4-f2605e7a512c"],
 ", so it lies in the ellipsoid ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71ffb8c9-c7fc-4165-b308-536080437fb6"],
 ", but its distance from the side ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5bacf94-7cbf-49d7-8109-0b7235f7265a"],
 " is two, so it lies outside the tube ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd8b5c18-7853-43d4-9eea-e3f2cff63bb0"],
 "."
}], "Item",ExpressionUUID->"3c659827-3a27-44c9-9bf3-bf154914f2aa"],

Cell[TextData[{
 "[[ On a non-modular substrate, is the gap between the ellipsoid of slack ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd840702-9261-4b50-bce4-56673369955c"],
 " and the tube of thickness ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92ca0b35-223d-43a2-be3c-ec7fd944f1c0"],
 " of the order ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], 
   SqrtBox[
    StyleBox[
     RowBox[{"n", "s"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "457aa4c5-ca28-4853-a839-58b832ded8d6"],
 ", as for the Euclidean ellipse? ]]"
}], "Item",ExpressionUUID->"41cf04e6-ba51-4e0a-977c-a5de77521727"],

Cell["Cones", "Section",ExpressionUUID->"710b00fa-26c8-4342-8c46-56d9831621ce"],

Cell[TextData[{
 "The cone of slope ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66a0e47f-3633-4a65-a77b-5bbe7a39c371"],
 " about a geodesic ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], "0"], ",", "\[Ellipsis]", ",", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["n", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c4ef32d5-7441-4fef-9b5e-45e40079d9b8"],
 " from the apex ",
 Cell[BoxData[
  RowBox[{
   StyleBox["c", "TI"], "=", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95ed3d8b-7b90-42ae-8447-d7978525d13c"],
 " to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "=", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8668e97-4b27-4eb3-9705-5b73342b0105"],
 " is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["m", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Gamma]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", "{", 
    StyleBox["v", "TI"]}], ":", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["v", "TI"], ",", 
     SubscriptBox[
      StyleBox["\[Gamma]", "TI"], 
      StyleBox["i", "TI"]]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[LessEqual]", 
    StyleBox["\[LeftFloor]",
     SpanMaxSize->1], 
    StyleBox[
     RowBox[{"m", "i"}], "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightFloor]",
     SpanMaxSize->1], 
    StyleBox[
     RowBox[{"\[NonBreakingSpace]", 
      RowBox[{"for", "\[NonBreakingSpace]", "some", "\[NonBreakingSpace]"}]}],
     
     FontSlant->"Plain"], 
    StyleBox["i", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78efa338-80a1-4cb0-882e-6c3d318bac36"],
 ": a ball of growing radius slid along ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e966c49c-4a1a-4c86-8853-e162dd2782ff"],
 "."
}], "Item",ExpressionUUID->"3de6de79-6ff1-4d25-a3ca-3f444a7c11b1"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "\[GreaterEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b135cec-31d4-493a-83bd-fb93c68b0519"],
 " the cone is the ball ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["B", "TI"], 
    RowBox[{
     StyleBox["\[LeftFloor]",
      SpanMaxSize->1], 
     StyleBox[
      RowBox[{"m", "n"}], "TI"], "\[VeryThinSpace]", 
     StyleBox["\[RightFloor]",
      SpanMaxSize->1]}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["p", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba179525-4823-4941-ad72-9b1d056e5acd"],
 " about the far end: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["v", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[LessEqual]", 
   StyleBox["\[LeftFloor]",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"m", "i"}], "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightFloor]",
    SpanMaxSize->1], "+", 
   StyleBox["n", "TI"], "-", 
   StyleBox["i", "TI"], "\[LessEqual]", 
   StyleBox["\[LeftFloor]",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"m", "n"}], "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightFloor]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1509b515-d987-4505-bfe2-fdb850d4aaf5"],
 ", on every graph."
}], "Item",ExpressionUUID->"e0c53b0b-9db9-416a-b136-a6f963c5b9c8"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "<", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65e637d1-89d5-41c7-a1af-ab06a64a2c80"],
 " no closed lattice count is known. In the Euclidean plane the cone over a \
segment of length ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d004350c-fa6f-4f00-a738-8714dceb746b"],
 " is the convex hull of the apex and the disk of radius ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"m", "R"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e668086-afce-4449-9516-bd38f8c67857"],
 " about the far end, of area ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["R", "TI"], "2"], 
   StyleBox["m", "TI"], 
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["m", "TI"], "2"]}]], "+", 
   SuperscriptBox[
    StyleBox["m", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["R", "TI"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[Pi]", "-", 
    StyleBox["arccos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["m", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ff81682-33ae-412d-ac60-2b09b0319ac1"],
 ". On a manifold the solid cone of radius ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86836031-6062-4ba4-bb23-2ca98009be18"],
 " over a set ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78ee5aa9-50fc-441f-bf54-58119d8e9a27"],
 " of unit directions has volume ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    RowBox[{
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], "\[CapitalOmega]", 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox["n", "TI"]], 
   SuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["n", "TI"]], "-", 
   FractionBox[
    SuperscriptBox[
     StyleBox["r", "TI"], 
     RowBox[{
      StyleBox["n", "TI"], "+", "2"}]], 
    RowBox[{"6", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["n", "TI"], "+", "2"}], 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   UnderscriptBox["\[Integral]", "\[CapitalOmega]",
    LimitsPositioning->True], 
   StyleBox["Ric",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["u", "TI"], ",", 
    StyleBox["u", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   StyleBox["d", "TI"], 
   StyleBox["u", "TI"], "+", 
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["r", "TI"], 
    RowBox[{
     StyleBox["n", "TI"], "+", "4"}]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d58a68a-0f80-4c4d-a957-8aebedd52f9b"],
 "."
}], "Item",ExpressionUUID->"978f70a9-620a-478c-a3d4-a13e20fe0e6d"],

Cell["\<\
The cone of slope one half about one geodesic from the centre to the far end, \
by its two measures, with its axis.\
\>", "Text",ExpressionUUID->"4d4ef80a-b9f0-4cd4-af60-7b5dc839438e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "size", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}]}], ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"geodesic", " ", "=", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", 
            RowBox[{"farEnd", "[", "g", "]"}]}], "]"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"interiorAndBoundary", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCone", "[", 
             RowBox[{"geodesic", ",", " ", 
              RowBox[{"1", "/", "2"}]}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"InfraWalk", "[", "geodesic", "]"}]}], "]"}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"size", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
        " ", "\"\<Large\>\""}], "}"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->
  "In[16]:= ",ExpressionUUID->"04459b3b-5939-486d-bd20-e143ffe77375"],

