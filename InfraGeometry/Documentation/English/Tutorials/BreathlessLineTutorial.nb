Cell[TextData[{
 StyleBox["Subdivision.",
  FontWeight->"Bold"],
 " Start with a square split along one diagonal and choose the two opposite \
corners off that diagonal. Barycentric subdivision splits every triangle into \
six. A vertex of the subdivision is a chain of faces, and an original corner \
stays the singleton chain at every level. Keep the original endpoints and \
draw each graph in its inherited embedding, aligned by the same rule."
}], "Text",ExpressionUUID->"bf14beb9-e410-421c-a921-58583a32ed9f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"Nest", "[", 
         RowBox[{"BarycentricRefinement", ",", " ", 
          RowBox[{"Graph", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"1", " ", "<->", " ", "2"}], ",", " ", 
             RowBox[{"2", " ", "<->", " ", "3"}], ",", " ", 
             RowBox[{"3", " ", "<->", " ", "4"}], ",", " ", 
             RowBox[{"4", " ", "<->", " ", "1"}], ",", " ", 
             RowBox[{"1", " ", "<->", " ", "3"}]}], "}"}], "]"}], ",", " ", 
          "k"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", " ", "=", " ", 
         RowBox[{"Nest", "[", 
          RowBox[{"List", ",", " ", "2", ",", " ", "k"}], "]"}]}], ",", " ", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"Nest", "[", 
          RowBox[{"List", ",", " ", "4", ",", " ", "k"}], "]"}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"xy", " ", "=", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"u", " ", "=", " ", 
        RowBox[{
         RowBox[{"xy", "[", "b", "]"}], " ", "-", " ", 
         RowBox[{"xy", "[", "a", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"aligned", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"p", " ", "|->", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"u", ",", " ", 
               RowBox[{"Cross", "[", "u", "]"}]}], "}"}], " ", ".", " ", 
             RowBox[{"(", 
              RowBox[{"p", " ", "-", " ", 
               RowBox[{"xy", "[", "a", "]"}]}], ")"}]}], " ", "/", " ", 
            RowBox[{"(", 
             RowBox[{"u", " ", ".", " ", "u"}], ")"}]}]}], ")"}], " ", "/@", 
         " ", 
         RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{
        RowBox[{"Graph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", "aligned"}]}], "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraSegment", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], " ", "->", " ", 
           "StandardBlue"}], ",", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "b"}], "}"}], " ", "->", " ", 
           "StandardBlue"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"k", ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"4f90c132-d484-4124-93fc-f44a96d3aba1"],

