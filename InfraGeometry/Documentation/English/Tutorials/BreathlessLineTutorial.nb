Cell["\<\
The panels show two, three and four subdivisions. All edges have unit cost. \
This is a nested refinement of one complex; the preceding tessellation panels \
are growing neighborhoods.\
\>", "Text",ExpressionUUID->"463b6a87-41e9-4ff6-9596-72317e3ab6c3"],

Cell["A line takes shape", "Section",ExpressionUUID->"f29e3685-4e5e-4b1c-a646-df518052dfba"],

Cell[TextData[{
 "Place each edge probability at its embedded midpoint ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["e", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "336b78c4-79fd-4190-8839-7a3b5ca46ce5"],
 ". This gives a probability measure in the plane:"
}], "Text",ExpressionUUID->"845fc07e-feee-4242-afd3-2a0be2b87115"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["\[Mu]", "TI"], 
     StyleBox["n", "TI"]], "=", 
    UnderscriptBox["\[Sum]", 
     StyleBox["e", "TI"],
     LimitsPositioning->False], 
    SubscriptBox[
     StyleBox["p", "TI"], 
     RowBox[{
      StyleBox["E", "TI"], ",", 
      StyleBox["n", "TI"]}]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["e", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Delta]", "TI"], 
     RowBox[{
      SubscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["n", "TI"]], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["e", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"c1e67835-c50c-4249-\
8473-95786d44244f"],

Cell[TextData[{
 "Here ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Delta]", "TI"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72a0d6f2-e864-4b5e-b962-a2b3881d7c19"],
 " is unit mass at ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbd40277-5d0e-4232-b87c-d12616de0a4a"],
 ". The question is whether these measures approach uniform length on the \
fixed segment. Explicitly, do we have"
}], "Text",ExpressionUUID->"805ef742-e5b7-417a-a25c-5419d6e69a1d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["e", "TI"],
     LimitsPositioning->False], 
    SubscriptBox[
     StyleBox["p", "TI"], 
     RowBox[{
      StyleBox["E", "TI"], ",", 
      StyleBox["n", "TI"]}]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["e", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], 
    StyleBox["f", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["n", "TI"]], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["e", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox[")",
     SpanMaxSize->1], 
    SubsuperscriptBox["\[Rule]", "0", "1"], 
    StyleBox["f", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["t", "TI"], ",", "0"}], 
    StyleBox[")",
     SpanMaxSize->1], 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"]}], "?"}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"6d7a977c-5466-4ed3-\
ab99-c946b8a53a07"],

Cell[TextData[{
 "The limit is required for every bounded continuous function ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "befb9bd9-9ecd-4ddc-b95b-4c2a420f6f7f"],
 ". It combines concentration across the line with uniform occupation along \
it."
}], "Text",ExpressionUUID->"bd766d13-ee5b-49a8-bf34-6500251eab00"],

Cell[TextData[{
 "We measure these two features separately. Write ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["X", "TI"], ",", 
    StyleBox["Y", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be44b85e-0966-4f93-be5b-563731e90bbc"],
 " for a point sampled from ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Mu]", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bef52d60-39eb-4dfc-ac38-f16b78961e19"],
 ". Its transverse spread and longitudinal discrepancy are"
}], "Text",ExpressionUUID->"ea2a52bd-8f8b-4414-9426-3d94a62f26a0"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["w", "TI"], 
     StyleBox["n", "TI"]], "=", 
    SqrtBox[
     RowBox[{
      UnderscriptBox["\[Integral]", 
       SuperscriptBox[
        StyleBox["R", "TI"], "2"],
       LimitsPositioning->True], 
      SuperscriptBox[
       StyleBox["y", "TI"], "2"], 
      StyleBox["d", "TI"], 
      SubscriptBox[
       StyleBox["\[Mu]", "TI"], 
       StyleBox["n", "TI"]], 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["x", "TI"], ",", 
       StyleBox["y", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]]}], ",", 
   RowBox[{
    SubscriptBox[
     "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
     StyleBox["n", "TI"]], "=", 
    RowBox[{
     UnderscriptBox[
      StyleBox["sup",
       FontSlant->"Plain"], 
      StyleBox["t", "TI"],
      LimitsPositioning->False], "\[ThinSpace]", 
     RowBox[{
      TemplateBox[{
        RowBox[{
          StyleBox["Pr", FontSlant -> "Plain"], "\[ThinSpace]", 
          StyleBox["(", SpanMaxSize -> 1], 
          RowBox[{
            StyleBox["X", "TI"], "\[LessEqual]", 
            StyleBox["t", "TI"]}], 
          StyleBox[")", SpanMaxSize -> 1], "-", 
          StyleBox["U", "TI"], 
          StyleBox["(", SpanMaxSize -> 1], 
          StyleBox["t", "TI"], 
          StyleBox[")", SpanMaxSize -> 1]}]},
       "Abs"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"adeba336-b844-4f97-\
9a8a-9fa965ed81d7"],

Cell[TextData[{
 "Here ",
 Cell[BoxData[
  StyleBox["U", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f4f5103-6e15-4666-bb7f-f83682677d8b"],
 " is the distribution function of the uniform law on ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{"0", ",", "1"}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aea94b22-e9af-4356-9b00-73f9ede3b8af"],
 ". The left plot shows transverse spread; the right shows longitudinal \
discrepancy. The horizontal coordinate is the shell radius: on the large \
tessellations the radius grows, and the mesh is read at its three sizes."
}], "Text",ExpressionUUID->"a871f14f-cf6b-4e29-a1b0-0b3f1f07c927"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"readouts", " ", "=", " ", 
     RowBox[{"Join", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Table", "[", "\n", "      ", 
        RowBox[{
         RowBox[{"With", "[", "\n", "        ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"g", " ", "=", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
               RowBox[{"InfraSubstrate", "[", 
                RowBox[{"name", ",", " ", "\"\<Large\>\""}], "]"}]}], ")"}]}],
             "}"}], ",", "\n", "        ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"c", " ", "=", " ", 
              RowBox[{"First", " ", "@", " ", 
               RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
             RowBox[{"xy", " ", "=", " ", 
              RowBox[{"AssociationThread", "[", 
               RowBox[{
                RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
                RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}]}], "}"}],
            ",", "\n", "        ", 
           RowBox[{"Table", "[", "\n", "          ", 
            RowBox[{
             RowBox[{"With", "[", "\n", "            ", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"shell", " ", "=", " ", 
                 RowBox[{"Keys", " ", "@", " ", 
                  RowBox[{"InfraMeasurement", "[", 
                   RowBox[{"g", ",", " ", 
                    RowBox[{"InfraShell", "[", 
                    RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
                    " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", 
               "\n", "            ", 
               RowBox[{"{", 
                RowBox[{"a", " ", "=", " ", 
                 RowBox[{"First", " ", "@", " ", "shell"}]}], "}"}], ",", 
               "\n", "            ", 
               RowBox[{"{", 
                RowBox[{"b", " ", "=", " ", 
                 RowBox[{"First", " ", "@", " ", 
                  RowBox[{"MaximalBy", "[", 
                   RowBox[{"shell", ",", " ", 
                    RowBox[{
                    RowBox[{"InfraMeasurement", "[", 
                    RowBox[{"g", ",", " ", 
                    RowBox[{"InfraSegment", "[", 
                    RowBox[{"a", ",", " ", "#"}], "]"}], ",", 
                    " ", "\"\<Cardinality\>\""}], "]"}], " ", "&"}]}], 
                   "]"}]}]}], "}"}], ",", "\n", "            ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"density", " ", "=", " ", 
                  RowBox[{"InfraMeasurement", "[", 
                   RowBox[{"g", ",", " ", 
                    RowBox[{"InfraSegment", "[", 
                    RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
                    " ", "\"\<EdgeDensity\>\""}], "]"}]}], ",", " ", 
                 RowBox[{"u", " ", "=", " ", 
                  RowBox[{
                   RowBox[{"xy", "[", "b", "]"}], " ", "-", " ", 
                   RowBox[{"xy", "[", "a", "]"}]}]}]}], "}"}], ",", "\n", 
               "            ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"masses", " ", "=", " ", 
                  RowBox[{
                   RowBox[{"Values", "[", "density", "]"}], " ", "/", " ", 
                   RowBox[{"Total", "[", "density", "]"}]}]}], ",", "\n", 
                 "             ", 
                 RowBox[{"midpoints", " ", "=", " ", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"e", " ", "|->", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"u", ",", " ", 
                    RowBox[{"Cross", "[", "u", "]"}]}], "}"}], " ", ".", " ", 
                    
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Mean", " ", "@", " ", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"xy", ",", " ", 
                    RowBox[{"List", " ", "@@", " ", "e"}]}], "]"}]}], " ", "-",
                     " ", 
                    RowBox[{"xy", "[", "a", "]"}]}], ")"}]}], " ", "/", " ", 
                    RowBox[{"(", 
                    RowBox[{"u", " ", ".", " ", "u"}], ")"}]}]}], ")"}], " ", 
                   "/@", " ", 
                   RowBox[{"Keys", "[", "density", "]"}]}]}]}], "}"}], ",", 
               "\n", "            ", 
               RowBox[{"{", 
                RowBox[{"order", " ", "=", " ", 
                 RowBox[{"Ordering", "[", 
                  RowBox[{"midpoints", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}]}], 
                "}"}], ",", "\n", "            ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"cumulative", " ", "=", " ", 
                  RowBox[{"Accumulate", "[", 
                   RowBox[{"masses", "[", 
                    RowBox[{"[", "order", "]"}], "]"}], "]"}]}], ",", " ", 
                 RowBox[{"positions", " ", "=", " ", 
                  RowBox[{"Clip", "[", 
                   RowBox[{
                    RowBox[{"midpoints", "[", 
                    RowBox[{"[", 
                    RowBox[{"order", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
                    
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}]}]}], "}"}], ",",
                "\n", "            ", 
               RowBox[{"{", 
