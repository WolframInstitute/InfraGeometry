Cell[TextData[{
 StyleBox["Observation.",
  FontWeight->"Bold"],
 " Transverse spread decreases on every substrate. Longitudinal discrepancy \
decreases on the square and triangular tessellations and on the mesh; on the \
hexagonal tessellation both quantities alternate with the parity of the \
radius. These observations do not establish convergence."
}], "Text",ExpressionUUID->"fa5a38f1-55f4-4804-af65-80c1d31e8f4e"],

Cell[TextData[{
 StyleBox["Open question.",
  FontWeight->"Bold"],
 " Do both quantities tend to zero for this embedding procedure, and at what \
rates? These finite computations do not prove convergence or a power law."
}], "Text",ExpressionUUID->"745c40ec-da44-4eec-bd05-397754a14e1d"],

Cell["\<\
In the barycentric example both quantities decrease, but slowly. Four \
subdivisions do not decide whether the limit is the straight segment.\
\>", "Text",ExpressionUUID->"94519983-eed7-41dc-a459-a88dbf28936f"],

Cell["The triangle", "Section",ExpressionUUID->"1d1b30a2-c1f0-46c1-8fa7-e1a3d763661a"],

Cell["\<\
Choose a third vertex on the same shell, as far as possible from the nearer \
endpoint. Keep one common spring-electric embedding for all three sides. A \
reflection puts the third vertex above the base.\
\>", "Text",ExpressionUUID->"9e3909ca-3890-4309-8302-3237368957e3"],

Cell["\<\
Each side carries its own normalized occupation measure. The colors \
distinguish the three sides in the medium-size square, triangular and \
hexagonal substrates.\
\>", "Text",ExpressionUUID->"c1f81bff-2809-443c-ba2f-7a6ab345476d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "\"\<Medium\>\""}], "]"}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"shell", " ", "=", " ", 
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", 
             RowBox[{"Floor", "[", 
              RowBox[{
               RowBox[{"GraphRadius", "[", "g", "]"}], "/", "2"}], "]"}]}], 
            "]"}], ",", " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", "shell"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"MaximalBy", "[", 
          RowBox[{"shell", ",", " ", 
           RowBox[{
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraSegment", "[", 
               RowBox[{"a", ",", " ", "#"}], "]"}], ",", 
              " ", "\"\<Cardinality\>\""}], "]"}], " ", "&"}]}], "]"}]}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"third", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"MaximalBy", "[", 
          RowBox[{"shell", ",", " ", 
           RowBox[{
            RowBox[{"Min", "[", 
             RowBox[{
              RowBox[{"GraphDistance", "[", 
               RowBox[{"g", ",", " ", "#", ",", " ", "a"}], "]"}], ",", " ", 
              RowBox[{"GraphDistance", "[", 
               RowBox[{"g", ",", " ", "#", ",", " ", "b"}], "]"}]}], "]"}], 
            " ", "&"}]}], "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"xy", " ", "=", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"u", " ", "=", " ", 
        RowBox[{
         RowBox[{"xy", "[", "b", "]"}], " ", "-", " ", 
         RowBox[{"xy", "[", "a", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"flip", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"Sign", "[", 
           RowBox[{
            RowBox[{"Cross", "[", "u", "]"}], " ", ".", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"xy", "[", "third", "]"}], " ", "-", " ", 
              RowBox[{"xy", "[", "a", "]"}]}], ")"}]}], "]"}]}], "}"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"aligned", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"p", " ", "|->", " ", 
           RowBox[{"flip", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"u", ",", " ", 
                RowBox[{"Cross", "[", "u", "]"}]}], "}"}], " ", ".", " ", 
              RowBox[{"(", 
               RowBox[{"p", " ", "-", " ", 
                RowBox[{"xy", "[", "a", "]"}]}], ")"}]}], " ", "/", " ", 
             RowBox[{"(", 
              RowBox[{"u", " ", ".", " ", "u"}], ")"}]}]}]}], ")"}], " ", "/@",
          " ", 
         RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{
        RowBox[{"Graph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", "aligned"}]}], "]"}], ",",
         "\n", "      ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraSegment", "[", 
           RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"b", ",", " ", "third"}], "]"}], ",", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"third", ",", " ", "a"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "b", ",", " ", "third"}], "}"}], " ", "->",
            " ", "StandardBlue"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"b04b66d3-2954-456b-bb00-f0f38c49da12"],

