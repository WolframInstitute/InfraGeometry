Cell["The triangle as one object", "Section",ExpressionUUID->"dd010235-fc53-4b23-a50f-8553b796e58d"],

Cell["Give each side one third of the total mass:", "Text",ExpressionUUID->"1bb92ab4-6761-4d0d-a3d2-30f347265057"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[Mu]", "TI"], 
     StyleBox["n", "TI"], "\[EmptyUpTriangle]"], "=", 
    FractionBox["1", "3"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["\[Mu]", "TI"], 
      StyleBox["n", "TI"], 
      StyleBox[
       RowBox[{"a", "b"}], "TI"]], "+", 
     SubsuperscriptBox[
      StyleBox["\[Mu]", "TI"], 
      StyleBox["n", "TI"], 
      StyleBox[
       RowBox[{"b", "c"}], "TI"]], "+", 
     SubsuperscriptBox[
      StyleBox["\[Mu]", "TI"], 
      StyleBox["n", "TI"], 
      StyleBox[
       RowBox[{"c", "a"}], "TI"]]}], 
    StyleBox[")",
     SpanMaxSize->1]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"11e1ffde-8854-4122-\
b5f5-80ad2672f8eb"],

Cell["\<\
Overlapping sides contribute additively. Normalizing each side before \
combining them prevents a side with more shortest paths from dominating \
solely through its path count.\
\>", "Text",ExpressionUUID->"8d247fa9-bab2-4e35-a6d9-10019642e7ed"],

Cell["\<\
The vertex density of each side is divided by its number of shortest paths, \
and the three are summed. A vertex is drawn the larger, the more mass it \
carries.\
\>", "Text",ExpressionUUID->"797b9d55-e09f-4f4c-8000-bb032e2a9508"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "\"\<Medium\>\""}], "]"}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"shell", " ", "=", " ", 
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", 
             RowBox[{"Floor", "[", 
              RowBox[{
               RowBox[{"GraphRadius", "[", "g", "]"}], "/", "2"}], "]"}]}], 
            "]"}], ",", " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", "shell"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"MaximalBy", "[", 
          RowBox[{"shell", ",", " ", 
           RowBox[{
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraSegment", "[", 
               RowBox[{"a", ",", " ", "#"}], "]"}], ",", 
              " ", "\"\<Cardinality\>\""}], "]"}], " ", "&"}]}], "]"}]}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"third", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"MaximalBy", "[", 
          RowBox[{"shell", ",", " ", 
           RowBox[{
            RowBox[{"Min", "[", 
             RowBox[{
              RowBox[{"GraphDistance", "[", 
               RowBox[{"g", ",", " ", "#", ",", " ", "a"}], "]"}], ",", " ", 
              RowBox[{"GraphDistance", "[", 
               RowBox[{"g", ",", " ", "#", ",", " ", "b"}], "]"}]}], "]"}], 
            " ", "&"}]}], "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"xy", " ", "=", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"u", " ", "=", " ", 
        RowBox[{
         RowBox[{"xy", "[", "b", "]"}], " ", "-", " ", 
         RowBox[{"xy", "[", "a", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"flip", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"Sign", "[", 
           RowBox[{
            RowBox[{"Cross", "[", "u", "]"}], " ", ".", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"xy", "[", "third", "]"}], " ", "-", " ", 
              RowBox[{"xy", "[", "a", "]"}]}], ")"}]}], "]"}]}], "}"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"aligned", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"p", " ", "|->", " ", 
           RowBox[{"flip", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"u", ",", " ", 
                RowBox[{"Cross", "[", "u", "]"}]}], "}"}], " ", ".", " ", 
              RowBox[{"(", 
               RowBox[{"p", " ", "-", " ", 
                RowBox[{"xy", "[", "a", "]"}]}], ")"}]}], " ", "/", " ", 
             RowBox[{"(", 
              RowBox[{"u", " ", ".", " ", "u"}], ")"}]}]}]}], ")"}], " ", "/@",
          " ", 
         RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"sides", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraSegment", "[", 
           RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"b", ",", " ", "third"}], "]"}], ",", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"third", ",", " ", "a"}], "]"}]}], "}"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{
        RowBox[{"Graph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", "aligned"}]}], "]"}], ",",
         "\n", "      ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Merge", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"side", " ", "|->", " ", 
                RowBox[{
                 RowBox[{"InfraMeasurement", "[", 
                  RowBox[{
                  "g", ",", " ", "side", ",", " ", "\"\<VertexDensity\>\""}], 
                  "]"}], " ", "/", " ", 
                 RowBox[{"InfraMeasurement", "[", 
                  RowBox[{
                  "g", ",", " ", "side", ",", " ", "\"\<Cardinality\>\""}], 
                  "]"}]}]}], ")"}], " ", "/@", " ", "sides"}], ",", " ", 
             "Total"}], "]"}], " ", "->", " ", "StandardBlue"}], ",", "\n", 
          "       ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "b", ",", " ", "third"}], "}"}], " ", "->",
            " ", "StandardBlue"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"673b8dcd-4a8a-407c-ab67-2b35b2dbd144"],

