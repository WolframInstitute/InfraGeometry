Cell[TextData[{
 "These counts give several probability distributions, depending on ",
 StyleBox["what we choose at random", "TI"],
 "."
}], "Text",ExpressionUUID->"cb62f75c-9030-4e31-b1ee-54d7e8a4bd0e"],

Cell[TextData[{
 StyleBox["Choose a path uniformly.",
  FontWeight->"Bold"],
 " The probabilities that it contains a given edge or vertex are"
}], "Text",ExpressionUUID->"174ecdac-890f-4c6d-9773-415e87e8eb76"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["E", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["e", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["c", "TI"], 
       StyleBox["E", "TI"]], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["e", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     StyleBox["N", "TI"]]}], ",", 
   RowBox[{
    SubscriptBox[
     "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
     StyleBox["V", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["c", "TI"], 
       StyleBox["V", "TI"]], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["v", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     StyleBox["N", "TI"]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"abd38854-bb17-4a35-\
8933-34e1c4d05991"],

Cell[TextData[{
 "These are ",
 StyleBox["occupation probabilities", "TI"],
 ". They sum to ",
 Cell[BoxData[
  StyleBox["L", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab42cb5d-fd99-4f11-a56e-0fb0d8065b38"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b04fef2-38e8-4919-8b22-d860d0a50a57"],
 ", respectively: one path occupies several edges and vertices. In \
particular, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["V", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["a", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["V", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["b", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f26cabd-f637-4999-95fb-af5f46bb5cae"],
 "."
}], "Text",ExpressionUUID->"07e64e5e-3e3e-409e-a4b8-73fc333d7f5c"],

Cell[TextData[{
 StyleBox["Choose a location along that path.",
  FontWeight->"Bold"],
 " After choosing the path, choose one of its edges or vertices uniformly. \
The resulting distributions are"
}], "Text",ExpressionUUID->"1abefe56-1f8c-4f4a-9501-b882e7dcbea4"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["E", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["e", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["c", "TI"], 
       StyleBox["E", "TI"]], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["e", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     StyleBox[
      RowBox[{"N", "L"}], "TI"]]}], ",", 
   RowBox[{
    SubscriptBox[
     "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
     StyleBox["V", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["c", "TI"], 
       StyleBox["V", "TI"]], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["v", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{
      StyleBox["N", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["L", "TI"], "+", "1"}], 
      StyleBox[")",
       SpanMaxSize->1]}]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"6eb288dc-ab2e-444c-\
9e88-338845a2e4dc"],

Cell["\<\
Each sums to one. They describe where a randomly sampled edge visit or vertex \
visit occurs.\
\>", "Text",ExpressionUUID->"0c9a342f-e38a-4545-b6bf-69f6a42c7a10"],

Cell[TextData[{
 StyleBox["Observe the path at a fixed step.",
  FontWeight->"Bold"],
 " At step ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e5e0961-0ec6-4dfd-8251-5dad449b1489"],
 ", every shortest path occupies exactly one vertex at graph distance ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b96ff0f-6f2c-4ca8-b5da-47e81d225225"],
 " from ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07fa4fc8-0b5d-46d3-be72-539bb368c726"],
 ". Thus"
}], "Text",ExpressionUUID->"96e6609b-4911-48e7-95b7-46e1eb5b69fd"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["k", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", "{", GridBox[{
      {
       FractionBox[
        RowBox[{
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["V", "TI"]], 
         StyleBox["(",
          SpanMaxSize->1], 
         StyleBox["v", "TI"], 
         StyleBox[")",
          SpanMaxSize->1]}], 
        StyleBox["N", "TI"]], 
       RowBox[{
        StyleBox["d", "TI"], 
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         StyleBox["a", "TI"], ",", 
         StyleBox["v", "TI"]}], 
        StyleBox[")",
         SpanMaxSize->1], "=", 
        StyleBox["k", "TI"]}]},
      {"0", 
       StyleBox["otherwise",
        FontSlant->"Plain"]}
     },
     GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}}]}], ",",
    "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["v", "TI"],
      LimitsPositioning->False], 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Rho]", "TI"], 
       StyleBox["k", "TI"]], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["v", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}]}], "=", 
    RowBox[{"1", "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"2c2cf128-4e7a-4f87-\
9440-0de8f3c2a6c3"],

Cell["The vertex distribution above is their average:", "Text",ExpressionUUID->"78b6bca6-369a-4e5e-8413-09e3145782e7"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["V", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox["1", 
     RowBox[{
      StyleBox["L", "TI"], "+", "1"}]], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["k", "TI"], "=", "0"}], 
     StyleBox["L", "TI"],
     LimitsPositioning->False], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["k", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"0a36bd86-3152-454a-\
b67a-37e80d85c7ec"],

Cell[TextData[{
 "We can also choose uniformly from all edges\[LongDash]or all vertices\
\[LongDash]that occur in at least one shortest path. This gives equal weight \
to every occupied location, regardless of how many paths pass through it. It \
describes the ",
 StyleBox["support",
  FontWeight->"Bold"],
 ", while the distributions ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["E", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d2abb2c-7feb-4f40-9d4f-4e98ac9284df"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["V", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d08ea9a9-dc57-4f3f-bbbc-061172b387e5"],
 " retain the multiplicity of paths."
}], "Text",ExpressionUUID->"62a5f303-77fb-4f45-93e5-2ee76ecf7742"],

Cell["The picture", "Section",ExpressionUUID->"bd6d7d3e-d02d-4e49-aa68-d7af7dc96183"],

Cell["\<\
Take growing neighborhoods of a center in the square, triangular and \
hexagonal tessellations. On the shell at half the graph radius, choose two \
vertices joined by many shortest paths: the first vertex of the shell, and \
the vertex of the shell with the most shortest paths from it.\
\>", "Text",ExpressionUUID->"52d275b5-cb44-48b6-9fa1-55f7ad207028"],

Cell[TextData[{
 "Draw the whole graph using a ",
 StyleBox["spring-electric embedding", "TI"],
 ". Translate, rotate and uniformly rescale this drawing so that the two \
selected vertices occupy the same positions at every size:"
}], "Text",ExpressionUUID->"568b9785-788d-4bea-8c82-c48dc3b7d1ba"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CurlyPhi]", 
     StyleBox["n", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    SubscriptBox[
     StyleBox["s", "TI"], 
     StyleBox["n", "TI"]], 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["n", "TI"]], 
    SubscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["n", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["v", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "+", 
    SubscriptBox[
     StyleBox["t", "TI"], 
     StyleBox["n", "TI"]]}], ",", 
   RowBox[{
    SubscriptBox[
     "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
     StyleBox["n", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["n", "TI"]], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"0", ",", "0"}], 
    StyleBox[")",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    SubscriptBox[
     "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
     StyleBox["n", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["n", "TI"]], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", ",", "0"}], 
    StyleBox[")",
     SpanMaxSize->1]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"8ebfe026-a09a-4c19-\
aa40-6727da9bfbc1"],

Cell[TextData[{
 "Here ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d01190d-efd8-4f7a-896e-d709c505a016"],
 " is the spring-electric layout, ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["R", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db05591b-9596-49a0-ba70-8b699eb6f8da"],
 " is a rotation, ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "164398df-6e94-4e09-8134-b4aa34af123c"],
 " is a positive scale, and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["t", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85424bbb-db2d-4489-9b6e-36a16832e588"],
 " is a translation. The graph determines shortest paths; this embedding \
determines the geometric positions we compare."
}], "Text",ExpressionUUID->"82631f80-2522-4b90-bee8-998da6d901be"],

Cell[TextData[{
 "The columns are square, triangular and hexagonal tessellations; sizes \
increase down the rows. The endpoints are fixed. Edge thickness is \
proportional to ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["E", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "543c3094-7d6d-4f4f-b9a0-07e2a68e40ab"],
 ", with the thickest edge set to the same display width in each panel."
}], "Text",ExpressionUUID->"f27ddaf6-5219-4d90-be8e-b523ef483cc1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"name", ",", " ", "size"}], "]"}]}], ")"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"shell", " ", "=", " ", 
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", 
             RowBox[{"Floor", "[", 
              RowBox[{
               RowBox[{"GraphRadius", "[", "g", "]"}], "/", "2"}], "]"}]}], 
            "]"}], ",", " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", "shell"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"MaximalBy", "[", 
          RowBox[{"shell", ",", " ", 
           RowBox[{
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraSegment", "[", 
               RowBox[{"a", ",", " ", "#"}], "]"}], ",", 
              " ", "\"\<Cardinality\>\""}], "]"}], " ", "&"}]}], "]"}]}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"xy", " ", "=", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"u", " ", "=", " ", 
        RowBox[{
         RowBox[{"xy", "[", "b", "]"}], " ", "-", " ", 
         RowBox[{"xy", "[", "a", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"aligned", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"p", " ", "|->", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"u", ",", " ", 
               RowBox[{"Cross", "[", "u", "]"}]}], "}"}], " ", ".", " ", 
             RowBox[{"(", 
              RowBox[{"p", " ", "-", " ", 
               RowBox[{"xy", "[", "a", "]"}]}], ")"}]}], " ", "/", " ", 
            RowBox[{"(", 
             RowBox[{"u", " ", ".", " ", "u"}], ")"}]}]}], ")"}], " ", "/@", 
         " ", 
         RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{
        RowBox[{"Graph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", "aligned"}]}], "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraSegment", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], " ", "->", " ", 
           "StandardBlue"}], ",", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "b"}], "}"}], " ", "->", " ", 
           "StandardBlue"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"size", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
        " ", "\"\<Large\>\""}], "}"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"9b28e88a-20ce-41d8-8155-677c0c80e4f6"],

