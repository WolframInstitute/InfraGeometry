Cell["\<\
The same construction on a triangulated mesh, from coarse to fine:\
\>", "Text",ExpressionUUID->"2d9a2b91-40e1-46e5-8ac9-6840de8a3828"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"InfraSubstrate", "[", 
           RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "size"}], "]"}]}], 
         ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"shell", " ", "=", " ", 
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", 
             RowBox[{"Floor", "[", 
              RowBox[{
               RowBox[{"GraphRadius", "[", "g", "]"}], "/", "2"}], "]"}]}], 
            "]"}], ",", " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", "shell"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"MaximalBy", "[", 
          RowBox[{"shell", ",", " ", 
           RowBox[{
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraSegment", "[", 
               RowBox[{"a", ",", " ", "#"}], "]"}], ",", 
              " ", "\"\<Cardinality\>\""}], "]"}], " ", "&"}]}], "]"}]}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"xy", " ", "=", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"u", " ", "=", " ", 
        RowBox[{
         RowBox[{"xy", "[", "b", "]"}], " ", "-", " ", 
         RowBox[{"xy", "[", "a", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"aligned", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"p", " ", "|->", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"u", ",", " ", 
               RowBox[{"Cross", "[", "u", "]"}]}], "}"}], " ", ".", " ", 
             RowBox[{"(", 
              RowBox[{"p", " ", "-", " ", 
               RowBox[{"xy", "[", "a", "]"}]}], ")"}]}], " ", "/", " ", 
            RowBox[{"(", 
             RowBox[{"u", " ", ".", " ", "u"}], ")"}]}]}], ")"}], " ", "/@", 
         " ", 
         RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{
        RowBox[{"Graph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", "aligned"}]}], "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraSegment", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], " ", "->", " ", 
           "StandardBlue"}], ",", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "b"}], "}"}], " ", "->", " ", 
           "StandardBlue"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"size", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Small\>\"", ",", " ", "\"\<Medium\>\"", ",", 
        " ", "\"\<Large\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"fc00f7ac-d0f0-456f-a53d-109cea37c45b"],

