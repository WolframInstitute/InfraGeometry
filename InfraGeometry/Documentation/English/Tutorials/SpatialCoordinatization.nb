        TraditionalForm]], "InlineFormula"], " is one step from both ", 
     Cell[BoxData[FormBox["0", TraditionalForm]], "InlineFormula"], " and ", 
     Cell[BoxData[FormBox[RowBox[{"-", SubscriptBox["e", "2"]}], 
        TraditionalForm]], "InlineFormula"], 
     ", and similarly for the third axis. ", StyleBox["Min", "InlineCode"], 
     " gives ", Cell[BoxData[FormBox["(-1,-1,-1)", TraditionalForm]], 
      "InlineFormula"], "; ", StyleBox["Max", "InlineCode"], " gives ", 
     Cell[BoxData[FormBox["(-1,0,0)", TraditionalForm]], "InlineFormula"], ". \
Removing the diagonal edges gives a Cartesian-grid calibration, whose \
coordinates recover all 27 original tuples."}], "Text"], 
