      "1", " ", "]", ",", " ", "dimension", " ", "]", ",", "\:f3a2", 
      "      ", "directions", " ", "=", " ", "Prepend", "[", " ", 
      "IdentityMatrix", "[", " ", "dimension", " ", "]", ",", " ", 
