  Cell[TextData[{"For the diamond ", 
     Cell[BoxData[FormBox[RowBox[{"a", "\[RightArrow]", "{", "b", ",", "c", 
          "}", "\[RightArrow]", "d"}], TraditionalForm]], "InlineFormula"], 
     ", the backward branch map sends both middle events to ", 
     Cell[BoxData[FormBox["a", TraditionalForm]], "InlineFormula"], 
     ". The forward merge map sends them to ", 
     Cell[BoxData[FormBox["d", TraditionalForm]], "InlineFormula"], 
     ". Backward from ", Cell[BoxData[FormBox["d", TraditionalForm]], 
      "InlineFormula"], ", ", StyleBox["CausalSliceRelation", "InlineCode"], 
     " retains both candidates and ", StyleBox["CausalSliceKernel", 
      "InlineCode"], " assigns each weight ", 
     Cell[BoxData[FormBox[FractionBox["1", "2"], TraditionalForm]], 
      "InlineFormula"], "."}], "Text"], 
  Cell[CellGroupData[{Cell[BoxData[RowBox[{"With", "[", " ", "{", " ", 
         "diamond", " ", "=", " ", "Graph", "[", " ", "{", " ", "\"a\"", " ", 
         "->", " ", "\"b\"", ",", " ", "\"a\"", " ", "->", " ", "\"c\"", ",", 
         " ", "\"b\"", " ", "->", " ", "\"d\"", ",", " ", "\"c\"", " ", "->", 
         " ", "\"d\"", " ", "}", " ", "]", ",", "\:f3a2", "    ", "slices", 
         " ", "=", " ", "{", " ", "{", " ", "\"a\"", " ", "}", ",", " ", "{", 
         " ", "\"b\"", ",", " ", "\"c\"", " ", "}", ",", " ", "{", " ", 
         "\"d\"", " ", "}", " ", "}", " ", "}", ",", "\:f3a2", "  ", "<|", 
         " ", "\"BackwardBranchMap\"", " ", "->", " ", "CausalSliceMap", "[", 
         " ", "diamond", ",", " ", "slices", ",", " ", "{", " ", "2", ",", 
         " ", "1", " ", "}", " ", "]", ",", "\:f3a2", "    ", 
         "\"ForwardMergeMap\"", " ", "->", " ", "CausalSliceMap", "[", " ", 
         "diamond", ",", " ", "slices", ",", " ", "{", " ", "2", ",", " ", 
         "3", " ", "}", " ", "]", ",", "\:f3a2", "    ", 
         "\"BackwardMergeRelation\"", " ", "->", " ", "CausalSliceRelation", 
         "[", " ", "diamond", ",", " ", "slices", ",", " ", "{", " ", "3", 
         ",", " ", "2", " ", "}", " ", "]", ",", "\:f3a2", "    ", 
         "\"BackwardMergeKernel\"", " ", "->", " ", "CausalSliceKernel", "[", 
         " ", "diamond", ",", " ", "slices", ",", " ", "{", " ", "3", ",", 
         " ", "2", " ", "}", " ", "]", " ", "|>", " ", "]"}]], "Input"], 
     Cell[BoxData[RowBox[{"\[LeftAssociation]", 
         RowBox[{RowBox[{"\"BackwardBranchMap\"", "\[Rule]", 
             RowBox[{"\[LeftAssociation]", RowBox[{RowBox[{"\"b\"", 
                   "\[Rule]", "\"a\""}], ",", RowBox[{"\"c\"", "\[Rule]", 
                   "\"a\""}]}], "\[RightAssociation]"}]}], ",", 
           RowBox[{"\"ForwardMergeMap\"", "\[Rule]", 
             RowBox[{"\[LeftAssociation]", RowBox[{RowBox[{"\"b\"", 
                   "\[Rule]", "\"d\""}], ",", RowBox[{"\"c\"", "\[Rule]", 
                   "\"d\""}]}], "\[RightAssociation]"}]}], ",", 
           RowBox[{"\"BackwardMergeRelation\"", "\[Rule]", 
             RowBox[{"\[LeftAssociation]", RowBox[{"\"d\"", "\[Rule]", 
                 RowBox[{"{", RowBox[{"\"b\"", ",", "\"c\""}], "}"}]}], 
               "\[RightAssociation]"}]}], ",", 
           RowBox[{"\"BackwardMergeKernel\"", "\[Rule]", 
             RowBox[{"\[LeftAssociation]", RowBox[{"\"d\"", "\[Rule]", 
                 RowBox[{"\[LeftAssociation]", RowBox[{RowBox[{"\"b\"", 
                       "\[Rule]", FractionBox["1", "2"]}], ",", RowBox[
                      {"\"c\"", "\[Rule]", FractionBox["1", "2"]}]}], 
                   "\[RightAssociation]"}]}], "\[RightAssociation]"}]}]}], 
         "\[RightAssociation]"}]], "Output"]}, Open]], 
  Cell[TextData[{"A map is automatic only when every causal image is a \
singleton. An explicit ", StyleBox["\"SelectImage\"", "InlineCode"], " \
chooses among candidates, without making that choice canonical. Such causal \
maps need not preserve spatial adjacency or be surjective, so they do not \
generally define a coarse graph quotient. For a kernel with row sums one, \
transport by ", Cell[BoxData[FormBox[RowBox[{"\[Nu]", "(", "y", ")", "=", 
          UnderscriptBox["\[Sum]", "x"], "\[Mu]", "(", "x", ")", "K", "(", 
          "x", ",", "y", ")"}], TraditionalForm]], "InlineFormula"], " \
preserves total mass. An event with no causal image prevents a total map or \
conservative kernel; those calls remain unevaluated."}], "Text"], 
