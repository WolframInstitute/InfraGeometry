Notebook[{Cell["Spatial Coordinatization", "Title"], 
  Cell[TextData[{"We reconstruct spatial graphs from a causal history and \
assign integer coordinates using four persistent landmarks. Coordinate fibers \
retain the events that these coordinates identify. These examples require the \
current package version. When using the notebook in the source checkout, \
register the local paclet first."}], "Text"], 
  Cell[BoxData[RowBox[{"PacletDirectoryLoad", "[", " ", "ExpandFileName", 
      "[", " ", "FileNameJoin", "[", " ", "{", " ", "NotebookDirectory", "[", 
      " ", "]", ",", " ", "\"..\"", ",", " ", "\"..\"", ",", " ", "\"..\"", 
      " ", "}", " ", "]", " ", "]", " ", "]", ";", "\:f3a2", "Needs", "[", 
      " ", "\"WolframInstitute`InfraGeometry`\"", " ", "]"}]], "Input"], 
  Cell["A causal history and a frame", "Section"], 
  Cell[TextData[{"At each time, take the points ", 
     Cell[BoxData[FormBox[RowBox[{"x", "\[Element]", SuperscriptBox[
           RowBox[{"{", RowBox[{"-1", ",", "0", ",", "1"}], "}"}], "3"]}], 
        TraditionalForm]], "InlineFormula"], ". An event ", 
     Cell[BoxData[FormBox[RowBox[{"(", "t", ",", "x", ")"}], 
        TraditionalForm]], "InlineFormula"], " has arrows to ", 
     Cell[BoxData[FormBox[RowBox[{"(", "t", "+", "1", ",", "x", ")"}], 
        TraditionalForm]], "InlineFormula"], " and each available ", 
     Cell[BoxData[FormBox[RowBox[{"(", "t", "+", "1", ",", "x", "+", 
          SubscriptBox["e", "i"], ")"}], TraditionalForm]], "InlineFormula"], 
     ". The chains at ", 
     Cell[BoxData[FormBox[RowBox[{"0", ",", SubscriptBox["e", "1"], ",", 
          SubscriptBox["e", "2"], ",", SubscriptBox["e", "3"]}], 
        TraditionalForm]], "InlineFormula"], " meet every time slice once. \
They will specify an origin and three directions. The tuple labels construct \
this example and position its pictures; the reconstruction uses graph \
adjacency."}], "Text"], 
  Cell[BoxData[RowBox[{"causalGrid", "[", " ", "dimension_Integer", " ", "]", 
      " ", ":=", "\:f3a2", "  ", "With", "[", " ", "{", " ", "points", " ", 
