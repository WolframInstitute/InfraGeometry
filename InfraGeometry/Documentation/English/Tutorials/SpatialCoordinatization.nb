  Cell[TextData[
    {"Number each axis by signed distance from the origin. For a vertex ", 
     Cell[BoxData[FormBox["v", TraditionalForm]], "InlineFormula"], ", let ", 
     Cell[BoxData[FormBox[RowBox[{SubscriptBox["P", "i"], "(", "v", ")"}], 
