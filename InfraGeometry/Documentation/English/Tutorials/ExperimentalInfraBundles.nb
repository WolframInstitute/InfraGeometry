Cell["Exact ball projection under weak lifting", "Section",ExpressionUUID->"1fd5a3a1-667e-40fd-adf8-76721ea37b64"],

Cell[TextData[{
 "Weak edge lifting has a positive consequence at every finite distance \
scale. Write ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["E", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f890abbc-00c5-4658-97a5-227c42682645"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["p", "TI"], ",", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a409135-92f5-498a-a266-db9b0242ccc6"],
 " for closed graph-distance balls of integer radius ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "\[GreaterEqual]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc0c50a2-4319-456c-8993-65866ba8d1b4"],
 ". A fibered graph has weak edge lifting exactly when"
}], "Text",ExpressionUUID->"33207dd4-5cea-4c6b-9cc3-42300169466e"],

Cell[BoxData[
 PaneBox[
  RowBox[{"\[Pi]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["E", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["r", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"\[Pi]", 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["x", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], ",", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"ce0f300f-96dc-41fb-\
bf05-6f047259f4ae"],

Cell[TextData[{
 "for every total vertex ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b8c05bc-ae87-492b-91c5-ecd113c291a2"],
 " and every such radius. It is enough to test radius one."
}], "Text",ExpressionUUID->"a37a64cd-a29c-409a-9219-4852754fa7fc"],

Cell[TextData[{
 "Every total edge projects to a base edge or a vertex. Projecting a total \
walk therefore gives a base walk after repetitions are removed, without \
increasing length. This proves the inclusion from left to right. For the \
reverse inclusion, choose a shortest base walk from ",
 Cell[BoxData[
  RowBox[{"\[Pi]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0867201-3741-4e57-b515-d7ac970e9746"],
 " to a point of its radius-",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57503f65-23d7-4f52-b2af-33c4ff3c478f"],
 " ball. Weak lifting supplies a transverse lift of each successive step, \
starting at ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a4c5e6a-e0b5-44c2-adb1-4cc5afd0535d"],
 ". The lifted endpoint lies in the total radius-",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5492913-39fa-40f6-9b1d-2d07e579995f"],
 " ball and projects to the required point. Conversely, equality at radius \
one supplies a total neighbour over every base neighbour, because a distinct \
base vertex cannot be the projection of ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "209bf9d7-5ad6-4cad-8cdc-5b781d5ed11a"],
 " itself. This is precisely weak edge lifting."
}], "Text",ExpressionUUID->"d8453c2b-55fe-48d9-b9fc-494ac1f4dce1"],

Cell["\<\
The total ball below projects onto the marked base ball. The statement \
permits multiple lifts and unequal fibers.\
\>", "Text",ExpressionUUID->"15db2188-dc98-416c-9531-4927d79ab835"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"PathGraph", "[", " ", 
        RowBox[{"Range", "[", " ", "6", " ", "]"}], " ", "]"}], ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", " ", "\"\<Fibration\>\"", " ", "}"}]}], ",", "\n", 
       "    ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", 
         RowBox[{"2", ",", " ", "3"}], " ", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"total", " ", "=", " ", 
      RowBox[{"InfraTotalSpace", "[", " ", "fib", " ", "]"}]}], ",", " ", 
     RowBox[{"base", " ", "=", " ", 
      RowBox[{"InfraBaseSpace", "[", " ", "fib", " ", "]"}]}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"start", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"VertexList", "[", " ", "total", " ", "]"}]}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", " ", 
