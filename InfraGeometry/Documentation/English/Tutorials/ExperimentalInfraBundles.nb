Cell[TextData[{
 "There is an exact criterion for reducing a projection. Let ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], ":", 
   RowBox[{
    StyleBox["V", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["E", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[Rule]", 
    OverscriptBox[
     RowBox[{
      StyleBox["V", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["E", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], "_"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad712abe-a26d-4661-9576-dcb87e40a3be"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Beta]", "TI"], ":", 
   RowBox[{
    StyleBox["V", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["B", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[Rule]", 
    OverscriptBox[
     RowBox[{
      StyleBox["V", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["B", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], "_"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa464ecc-6c54-46a7-91f8-9ecc06609325"],
 " describe total and base observations. A map ",
 Cell[BoxData[
  OverscriptBox["\[Pi]", "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f802b578-3de1-4cb3-8451-41e51eec89dc"],
 " satisfying"
}], "Text",ExpressionUUID->"6b612782-a46f-45fc-a210-740957255fef"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   OverscriptBox["\[Pi]", "_"], "\[SmallCircle]", 
   StyleBox["\[Alpha]", "TI"], "=", 
   StyleBox["\[Beta]", "TI"], "\[SmallCircle]", "\[Pi]"}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"7811b8fd-93cc-4c05-\
9f9c-6185791bf573"],

Cell[TextData[{
 "exists exactly when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Beta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[Pi]", 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["\[Beta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[Pi]", 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["y", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6c953a5-e907-491b-9626-2261ecbeac23"],
 " whenever ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["\[Alpha]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["y", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d463ccd9-ae51-4ff1-ba5b-fd0f2727bcb8"],
 ". Necessity follows by applying the displayed identity to both \
representatives. For sufficiency, define ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox["\[Pi]", "_"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["\[Beta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[Pi]", 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ad2d575-1504-427c-bdb0-b717096e1813"],
 "; the condition makes this independent of the representative. With quotient \
adjacency reconstructed from edges, each edge still projects to an edge or a \
vertex. This establishes a reduced graph map, without establishing any \
lifting property."
}], "Text",ExpressionUUID->"7aa92355-020c-41a7-95e2-042093295a34"],

Cell["Exact descent of a selected transport", "Section",ExpressionUUID->"19e9d97d-f795-46da-aab4-30a815eadf1e"],

Cell[TextData[{
 "Suppose a complete connection transports ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c9fe44e3-a2cb-4268-be0a-f4784c62b368"],
 " to ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], 
   StyleBox["q", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05a61a4d-53b5-4fb7-a474-3e2966b9ec50"],
 " by a bijection ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], 
   StyleBox[
    RowBox[{"p", "q"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c75220d-093a-45b8-a762-dae2a0a60152"],
 ". Choose an equivalence relation in each fiber. The transport descends to a \
map of equivalence classes exactly when"
}], "Text",ExpressionUUID->"c7450df0-0ab9-4b58-b363-0f233196b60f"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["x", "TI"], 
    SubscriptBox["\[Tilde]", 
     StyleBox["p", "TI"]], 
    StyleBox["y", "TI"], "\[NonBreakingSpace]\[NonBreakingSpace]", "\[DoubleLongRightArrow]",
     "\[NonBreakingSpace]\[NonBreakingSpace]", 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"p", "q"}], "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], 
    SubscriptBox["\[Tilde]", 
     StyleBox["q", "TI"]], 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"p", "q"}], "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["y", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"75c1c334-6613-4533-\
b0d7-8266f4075d65"],

Cell[TextData[{
 "Indeed, this condition says precisely that the proposed image class is \
independent of the representative. The descended map is a bijection with \
descended inverse when the same condition holds for ",
 Cell[BoxData[
  SubsuperscriptBox[
   StyleBox["T", "TI"], 
   StyleBox[
    RowBox[{"p", "q"}], "TI"], 
   RowBox[{"-", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00101083-8f0c-4686-9d01-33ef6bfa5c56"],
 ". If the original transport is a fiber-graph isomorphism, these two \
conditions also give an isomorphism of the reconstructed quotient fiber \
graphs. Every original adjacency maps to a quotient adjacency or a collapsed \
vertex, and the inverse gives the converse."
}], "Text",ExpressionUUID->"2a53c3b3-4cff-4a9f-a223-64879c322369"],

Cell["\<\
These conditions can be checked for a proposed observation. An arbitrary \
partition need not satisfy them. Merging base vertices creates additional \
compatibility questions and is not covered by this fixed-base descent \
statement.\
\>", "Text",ExpressionUUID->"92bb5992-d168-42cd-96f6-faa5ef177b34"],

Cell["Proposed completion and emergence questions", "Section",ExpressionUUID->"23a1418b-82a1-4b2a-82d9-1d8da0d1ceb8"],

Cell["\<\
A single finite unweighted graph does not determine a continuum limit. A \
completion claim needs a family of finite objects, scale choices and a \
specified notion of convergence. A bundle-emergence claim additionally needs \
a limit projection and a stated bundle class.\
\>", "Text",ExpressionUUID->"d144ee2c-71ff-4264-8739-f61ae34a57e7"],

Cell["\<\
The following are research requirements to formulate and prove in a chosen \
model, not a sufficient-condition theorem.\
\>", "Text",ExpressionUUID->"23d651fd-3a1d-4064-82f6-c1b2a91da0d6"],

Cell["\<\
Specify total graphs, base graphs and projections at each resolution, \
together with the comparison maps between resolutions.\
\>", "Item",ExpressionUUID->"c284a281-f8ee-4956-a5c4-95487eba72dc"],

Cell["\<\
Specify how graph distance is rescaled and what convergence of total spaces, \
base spaces and projections means.\
\>", "Item",ExpressionUUID->"ec2a522c-2d95-4f97-951f-f2cce548764d"],

Cell["\<\
Control the fibers under those comparisons. Equal cardinalities at one \
resolution neither prevent collapse nor produce a limiting fiber topology.\
\>", "Item",ExpressionUUID->"dcea9f0e-233f-4a3b-819c-4ef7d533a567"],

Cell["\<\
Construct compatible local identifications and prove the limit's required \
local product or lifting property.\
\>", "Item",ExpressionUUID->"78710f9f-df98-41af-a840-68451fe1bd9d"],

Cell["\<\
If connections are retained, specify a common transport target or compatible \
actions, and prove convergence of transport along comparable walks.\
\>", "Item",ExpressionUUID->"f3e4f9de-b875-47a6-a2b3-3dad9f6f3c6a"],

Cell["\<\
If curvature is claimed, supply faces or another loop family and prove the \
appropriate scaled holonomy statement.\
\>", "Item",ExpressionUUID->"4e206117-a554-4e00-9b4e-b524de60acd3"],

Cell[TextData[{
 "There is a basic exact obstruction to retaining a nontrivial fiber under \
uniform metric rescaling. Suppose every vertical fiber is a copy of one fixed \
connected graph ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93993f72-40c2-4dfe-acbe-568c1dbf4769"],
 " of diameter ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "587a90c6-e65f-4e45-aabe-326299d1f543"],
 ". When every total edge has rescaled length ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "648b2def-073a-458a-a60e-394c1f2c4bd5"],
 ", two vertices in the same fiber have total-space distance at most ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["D", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4036fc62-bcc2-41ef-9596-da6a2b03b1a4"],
 ", using a vertical path. If ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "438b7a57-8a1e-4553-a2b3-0fe766ac93fc"],
 " tends to zero, all such pairwise fiber distances tend to zero. Thus a \
proposed nontrivial limiting fiber needs additional structure or a different \
scaling regime."
}], "Text",ExpressionUUID->"8bd815b9-ba9a-493e-996e-ca7d6e663717"],

Cell[TextData[{
 "A graph-bundle predicate alone supplies none of these limiting choices. \
Even geometric realization requires care: a Cartesian product graph contains \
edges, but no filled squares. The local product requirement for topological \
bundles concerns spaces and their neighbourhoods, as in ",
 ButtonBox["Hatcher, Algebraic Topology, Section 4.2",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://pi.math.cornell.edu/~hatcher/AT/AT.pdf"], None}],
 "."
}], "Text",ExpressionUUID->"787241c1-8068-4bb2-8e28-739c650f3b62"],

Cell["\<\
Finite models motivated by the seven-sphere, Hurwitz algebras or Hopf \
fibrations belong to particular research constructions. Each needs its own \
projection, algebraic action and comparison with the intended continuous \
object. They are not assumptions of the finite framework, and do not \
establish generic emergence of topological bundles.\
\>", "Text",ExpressionUUID->"0d72961a-6df9-48d8-9b20-065439915136"],

Cell["Holonomy under changed fiber coordinates", "Section",ExpressionUUID->"5db9255a-ba0a-47af-8fb0-c45b4fb2be86"],

Cell[TextData[{
 "There is an exact statement before any limiting argument. If fiber \
coordinates are changed by bijections ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["g", "TI"], 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9044b95c-31a9-4ae0-8332-66c863a0ed90"],
 ", edge transport becomes ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["q", "TI"]], 
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox[
     RowBox[{"p", "q"}], "TI"]], 
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["p", "TI"], 
    RowBox[{"-", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4069d7ad-e251-4724-8aed-7fd976ae56c8"],
 ". Around a closed walk at ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "220e7ed6-62e8-4002-8dcb-90e1f9d5125f"],
 ", intermediate coordinate changes cancel, so holonomy becomes ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["p", "TI"]], 
   StyleBox["H", "TI"], 
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["p", "TI"], 
    RowBox[{"-", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b9b14e3-7146-486b-99bd-8019a95ccd21"],
 ". Its conjugacy class is therefore independent of those coordinate choices. \
If the coordinates and transport are required to preserve fiber graphs, the \
bijections must be graph isomorphisms."
}], "Text",ExpressionUUID->"40141ea2-a5b9-487b-bd58-64372715f122"],

Cell[TextData[{
 "This is the finite gauge interpretation in Ioana Milea's Fibered Graph \
Gauge Theory Basics, unpublished, 2026. It does not supply a face system or a \
continuum limit. The general holonomy reader remains a permutation of one \
finite fiber, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTrivialMonodromyQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTrivialMonodromyQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b5af5960-3e53-4d4c-9e41-b9f5c8a6b0a8"],
 " tests trivial global monodromy."
}], "Text",ExpressionUUID->"6d01b0e8-4869-46cc-8db9-277c4c36b737"],

