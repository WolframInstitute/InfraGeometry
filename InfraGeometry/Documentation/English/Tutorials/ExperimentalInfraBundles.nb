Cell["Exact ball projection under weak lifting", "Section",ExpressionUUID->"27a63e7a-130d-42da-a445-82515a344752"],

Cell[TextData[{
 "Weak edge lifting has a positive consequence at every finite distance \
scale. Write ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["E", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c3cc4c5-e1b8-42ee-ada4-28edfdf69d0a"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["p", "TI"], ",", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72166432-8d51-4736-a8ff-68c45756158e"],
 " for closed graph-distance balls of integer radius ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "\[GreaterEqual]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65e64460-4add-428a-aa79-8fa546c6487c"],
 ". A fibered graph has weak edge lifting exactly when"
}], "Text",ExpressionUUID->"585760fa-262a-4d5f-a5ee-09e3dde9da1d"],

Cell[BoxData[
 PaneBox[
  RowBox[{"\[Pi]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["E", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["r", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"\[Pi]", 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["x", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], ",", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"ccba0478-acde-445e-\
ae0e-ae2aaaaf07b2"],

Cell[TextData[{
 "for every total vertex ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e107ef5f-b5da-48c6-bfbb-5713bafced28"],
 " and every such radius. It is enough to test radius one."
}], "Text",ExpressionUUID->"5c346694-44f8-41a5-9050-a75ce76d13a2"],

Cell[TextData[{
 "Every total edge projects to a base edge or a vertex. Projecting a total \
walk therefore gives a base walk after repetitions are removed, without \
increasing length. This proves the inclusion from left to right. For the \
reverse inclusion, choose a shortest base walk from ",
 Cell[BoxData[
  RowBox[{"\[Pi]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0b111c5-2fe8-456a-a8f7-038128ba1223"],
 " to a point of its radius-",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "969d2843-71bb-4de0-b5cb-21c4c6477112"],
 " ball. Weak lifting supplies a transverse lift of each successive step, \
starting at ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d013101-d141-460b-9eb5-6beace6a2c78"],
 ". The lifted endpoint lies in the total radius-",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2d54ed1-0360-4e83-b63a-1bf6899304e2"],
 " ball and projects to the required point. Conversely, equality at radius \
one supplies a total neighbour over every base neighbour, because a distinct \
base vertex cannot be the projection of ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f317948f-8253-429e-b380-c6f153b46362"],
 " itself. This is precisely weak edge lifting."
}], "Text",ExpressionUUID->"0b35736d-3b22-43e4-8736-a8af91f8add1"],

Cell["\<\
The total ball below projects onto the marked base ball. The statement \
permits multiple lifts and unequal fibers.\
\>", "Text",ExpressionUUID->"fa6f243c-6a6a-46fb-ac98-892a6fdfe19f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"PathGraph", "[", " ", 
        RowBox[{"Range", "[", " ", "6", " ", "]"}], " ", "]"}], ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", " ", "\"\<Fibration\>\"", " ", "}"}]}], ",", "\n", 
       "    ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", 
         RowBox[{"2", ",", " ", "3"}], " ", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"total", " ", "=", " ", 
      RowBox[{"InfraTotalSpace", "[", " ", "fib", " ", "]"}]}], ",", " ", 
     RowBox[{"base", " ", "=", " ", 
      RowBox[{"InfraBaseSpace", "[", " ", "fib", " ", "]"}]}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"start", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"VertexList", "[", " ", "total", " ", "]"}]}]}], " ", "}"}], ",",
