Cell[CellGroupData[{
Cell["Experimental Infra Bundles", "Title",ExpressionUUID->"2a0b413d-7ed8-40ea-9dd4-6bd6ee23dba1"],

Cell["LLM generated.", "Text",ExpressionUUID->"aea91148-a860-422f-acd6-13fe674857d5"],

Cell[TextData[StyleBox["[[ LLM Generated ]]",
 FontWeight->"Bold"]], "Text",ExpressionUUID->"46ea656b-0eb0-48ad-ab98-a81ee314fa4f"],

Cell[TextData[{
 "We separate particular finite models from questions about observation at \
scale and possible limits. The exact statements below concern finite graphs, \
quotient maps and selected matchings. The completion and emergence section \
states research requirements; it supplies no general convergence theorem or \
new scale API. The general definitions are in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infra Bundles"]], 
    "paclet:WolframInstitute/InfraGeometry/tutorial/InfraBundles"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "3b9640eb-2f24-4ade-86ea-75bf4e39b1c6"],
 "."
}], "Text",ExpressionUUID->"0f5d7015-38a5-43f3-b14c-f651204e4781"],

Cell["Setup", "Section",ExpressionUUID->"fb144aa8-218f-49f0-8052-0062e873c677"],

Cell[BoxData[
 RowBox[{"Needs", "[", " ", "\"\<WolframInstitute`InfraGeometry`\>\"", " ", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a3abf947-c514-46bd-a549-4d4ecece770c"],

Cell["Particular geometric models", "Section",ExpressionUUID->"ddc44e42-ac86-42da-b34b-496fa7702b42"],

Cell["\<\
The model names describe how their total vertices and edges are constructed. \
Their fibration and bundle properties must be checked on the chosen substrate \
and scale. The name of a model does not assert the general graph-bundle \
predicate.\
\>", "Text",ExpressionUUID->"2725e91b-cd2f-41ba-9aae-3b1a37f44ef1"],

