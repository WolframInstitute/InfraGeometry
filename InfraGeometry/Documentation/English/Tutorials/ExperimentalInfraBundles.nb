Cell[TextData[{
 "There is an exact criterion for reducing a projection. Let ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], ":", 
   RowBox[{
    StyleBox["V", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["E", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[Rule]", 
    OverscriptBox[
     RowBox[{
      StyleBox["V", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["E", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], "_"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8db2752-5b21-46d0-a071-09961feaf76a"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Beta]", "TI"], ":", 
   RowBox[{
    StyleBox["V", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["B", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[Rule]", 
    OverscriptBox[
     RowBox[{
      StyleBox["V", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["B", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], "_"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bed3f472-aec2-455d-9046-e21b5c8f082f"],
 " describe total and base observations. A map ",
 Cell[BoxData[
  OverscriptBox["\[Pi]", "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3d70777-cdf6-4c0c-94ea-bf2f1ef8b680"],
 " satisfying"
}], "Text",ExpressionUUID->"e19ec476-2a3f-451b-897d-39cc8b327baa"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   OverscriptBox["\[Pi]", "_"], "\[SmallCircle]", 
   StyleBox["\[Alpha]", "TI"], "=", 
   StyleBox["\[Beta]", "TI"], "\[SmallCircle]", "\[Pi]"}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"bc154997-2ff5-41e8-\
b034-9c447db303d4"],

Cell[TextData[{
 "exists exactly when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Beta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[Pi]", 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["\[Beta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[Pi]", 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["y", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15436336-4316-47cc-8066-481f796beb83"],
 " whenever ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["\[Alpha]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["y", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "027ee5de-9e66-4175-a977-112c1bae6b50"],
 ". Necessity follows by applying the displayed identity to both \
representatives. For sufficiency, define ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox["\[Pi]", "_"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["\[Beta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[Pi]", 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93799ecf-3d93-4524-9478-7ecd00d13cf0"],
 "; the condition makes this independent of the representative. With quotient \
adjacency reconstructed from edges, each edge still projects to an edge or a \
vertex. This establishes a reduced graph map, without establishing any \
lifting property."
}], "Text",ExpressionUUID->"5ea5eb74-ebcb-4f9a-be1b-5a0740d1d726"],

Cell["Exact descent of a selected transport", "Section",ExpressionUUID->"ea1142ea-7b6c-4a5a-860a-5ec5890f86d9"],

Cell[TextData[{
 "Suppose a complete connection transports ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bf3c916-9024-41c0-91d1-d1769b70bbb5"],
 " to ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], 
   StyleBox["q", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "995db897-91b7-4c7c-bdef-de1526981c3f"],
 " by a bijection ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], 
   StyleBox[
    RowBox[{"p", "q"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6cae500-78d9-4286-a249-5572f51017b4"],
 ". Choose an equivalence relation in each fiber. The transport descends to a \
map of equivalence classes exactly when"
}], "Text",ExpressionUUID->"4704f208-30af-40f8-aee6-607dbaa03b5f"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["x", "TI"], 
    SubscriptBox["\[Tilde]", 
     StyleBox["p", "TI"]], 
    StyleBox["y", "TI"], "\[NonBreakingSpace]\[NonBreakingSpace]", "\[DoubleLongRightArrow]",
     "\[NonBreakingSpace]\[NonBreakingSpace]", 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"p", "q"}], "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], 
    SubscriptBox["\[Tilde]", 
     StyleBox["q", "TI"]], 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"p", "q"}], "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["y", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"7ae3a099-bad4-4acf-\
8aa6-71e05363ff86"],

Cell[TextData[{
 "Indeed, this condition says precisely that the proposed image class is \
independent of the representative. The descended map is a bijection with \
descended inverse when the same condition holds for ",
 Cell[BoxData[
  SubsuperscriptBox[
   StyleBox["T", "TI"], 
   StyleBox[
    RowBox[{"p", "q"}], "TI"], 
   RowBox[{"-", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba516f1e-515e-497d-831b-1dba868bb10d"],
 ". If the original transport is a fiber-graph isomorphism, these two \
conditions also give an isomorphism of the reconstructed quotient fiber \
graphs. Every original adjacency maps to a quotient adjacency or a collapsed \
vertex, and the inverse gives the converse."
}], "Text",ExpressionUUID->"a85481ab-8d0b-4cb7-97e2-3d59532f4198"],

Cell["\<\
These conditions can be checked for a proposed observation. An arbitrary \
partition need not satisfy them. Merging base vertices creates additional \
compatibility questions and is not covered by this fixed-base descent \
statement.\
\>", "Text",ExpressionUUID->"389717f9-cdd3-4a69-8744-c26aa35ae705"],

Cell["Proposed completion and emergence questions", "Section",ExpressionUUID->"b6a5f743-b3b4-45d2-91ee-c2b2b28384d8"],

Cell["\<\
A single finite unweighted graph does not determine a continuum limit. A \
completion claim needs a family of finite objects, scale choices and a \
specified notion of convergence. A bundle-emergence claim additionally needs \
a limit projection and a stated bundle class.\
\>", "Text",ExpressionUUID->"3d1daf0a-2fee-49cf-8cbb-186a6ff7aa3c"],

Cell["\<\
The following are research requirements to formulate and prove in a chosen \
model, not a sufficient-condition theorem.\
\>", "Text",ExpressionUUID->"e4c63101-765f-4850-930d-f2d53b6c25d8"],

Cell["\<\
Specify total graphs, base graphs and projections at each resolution, \
together with the comparison maps between resolutions.\
\>", "Item",ExpressionUUID->"462ed7fa-bb8b-4165-b75f-187a6c318e90"],

Cell["\<\
Specify how graph distance is rescaled and what convergence of total spaces, \
base spaces and projections means.\
\>", "Item",ExpressionUUID->"61983fc2-ac1e-4b5f-b228-c8b2917bb3b4"],

Cell["\<\
Control the fibers under those comparisons. Equal cardinalities at one \
resolution neither prevent collapse nor produce a limiting fiber topology.\
\>", "Item",ExpressionUUID->"fbcc4539-1da5-4453-b7c1-e488820a5daf"],

Cell["\<\
Construct compatible local identifications and prove the limit's required \
local product or lifting property.\
\>", "Item",ExpressionUUID->"a2eb37dc-8d58-44fc-83f4-dd9d0766da62"],

Cell["\<\
If connections are retained, specify a common transport target or compatible \
actions, and prove convergence of transport along comparable walks.\
\>", "Item",ExpressionUUID->"1d755f3e-0b70-4cad-9ab7-db2b7d936cd0"],

Cell["\<\
If curvature is claimed, supply faces or another loop family and prove the \
appropriate scaled holonomy statement.\
\>", "Item",ExpressionUUID->"a0232866-f7ec-4b88-93e2-74aa8002b6e9"],

Cell[TextData[{
 "There is a basic exact obstruction to retaining a nontrivial fiber under \
uniform metric rescaling. Suppose every vertical fiber is a copy of one fixed \
connected graph ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a034aee3-fc3c-4519-ade1-576ed95cfd67"],
 " of diameter ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d42a810-c1ba-4357-8924-5ea2213f7d0b"],
 ". When every total edge has rescaled length ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96e43360-02e3-4c98-9437-2af50b495b4b"],
 ", two vertices in the same fiber have total-space distance at most ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["D", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c4b98e4-8f52-461b-bfdc-4bbd0a68ae58"],
 ", using a vertical path. If ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0ef9a1a-7991-410e-9194-670f76bec529"],
 " tends to zero, all such pairwise fiber distances tend to zero. Thus a \
proposed nontrivial limiting fiber needs additional structure or a different \
scaling regime."
}], "Text",ExpressionUUID->"439ebb70-701e-45be-825f-599eda139215"],

Cell[TextData[{
 "A graph-bundle predicate alone supplies none of these limiting choices. \
Even geometric realization requires care: a Cartesian product graph contains \
edges, but no filled squares. The local product requirement for topological \
bundles concerns spaces and their neighbourhoods, as in ",
 ButtonBox["Hatcher, Algebraic Topology, Section 4.2",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://pi.math.cornell.edu/~hatcher/AT/AT.pdf"], None}],
 "."
}], "Text",ExpressionUUID->"82b0b89a-3dbe-4970-957e-09b78d98072e"],

Cell["\<\
Finite models motivated by the seven-sphere, Hurwitz algebras or Hopf \
fibrations belong to particular research constructions. Each needs its own \
projection, algebraic action and comparison with the intended continuous \
object. They are not assumptions of the finite framework, and do not \
establish generic emergence of topological bundles.\
\>", "Text",ExpressionUUID->"6d339d6c-3007-4c63-bcc4-235b7f84450a"],

Cell["Holonomy under changed fiber coordinates", "Section",ExpressionUUID->"c68f5a10-0112-4325-be01-f2ddcaa861b0"],

Cell[TextData[{
 "There is an exact statement before any limiting argument. If fiber \
coordinates are changed by bijections ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["g", "TI"], 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f91c18e8-375d-4eb9-a6d9-b1533593ca9f"],
 ", edge transport becomes ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["q", "TI"]], 
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox[
     RowBox[{"p", "q"}], "TI"]], 
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["p", "TI"], 
    RowBox[{"-", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01195144-a22b-4815-8025-b75835843dae"],
 ". Around a closed walk at ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07629530-055c-47a4-b30e-deb8d427e737"],
 ", intermediate coordinate changes cancel, so holonomy becomes ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["p", "TI"]], 
   StyleBox["H", "TI"], 
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["p", "TI"], 
    RowBox[{"-", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "621b0ab1-464d-421e-8b22-3ab50f6c3a8b"],
 ". Its conjugacy class is therefore independent of those coordinate choices. \
If the coordinates and transport are required to preserve fiber graphs, the \
bijections must be graph isomorphisms."
}], "Text",ExpressionUUID->"e4edf717-c0e2-4aa0-b625-9f4ff63f70ef"],

Cell["\<\
This is the finite gauge interpretation in Ioana Milea's Fibered Graph Gauge \
Theory Basics, unpublished, 2026. It does not supply a face system or a \
continuum limit. The general holonomy reader remains a permutation of one \
finite fiber, and the retained flat-connection predicate remains the test of \
trivial global monodromy.\
\>", "Text",ExpressionUUID->"ca018dc0-fb3f-4c07-85a7-ff144e139bcd"],

