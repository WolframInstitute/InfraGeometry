Cell["Exact ball projection under weak lifting", "Section",ExpressionUUID->"b485c3bb-df21-4c85-8d48-a75e2356617b"],

Cell[TextData[{
 "Weak edge lifting has a positive consequence at every finite distance \
scale. Write ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["E", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2f7c23f-7d86-46ac-ac3f-71c10e81b960"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["p", "TI"], ",", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3f01ba3-f2b0-4972-b67c-78f651a6f2cc"],
 " for closed graph-distance balls of integer radius ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "\[GreaterEqual]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "565d6513-f864-48c9-a5d3-d8faf46bc764"],
 ". A fibered graph has weak edge lifting exactly when"
}], "Text",ExpressionUUID->"0ac574a5-724c-4ea2-98a7-34be5bf04049"],

Cell[BoxData[
 PaneBox[
  RowBox[{"\[Pi]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["E", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["r", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"\[Pi]", 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["x", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], ",", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"698b25da-8f17-478d-\
b0a9-a5866922cdc9"],

Cell[TextData[{
 "for every total vertex ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66534024-bd88-4fae-a375-9daa09686783"],
 " and every such radius. It is enough to test radius one."
}], "Text",ExpressionUUID->"1d3c4575-ab81-4d07-88be-fb9b838e373f"],

Cell[TextData[{
 "Every total edge projects to a base edge or a vertex. Projecting a total \
walk therefore gives a base walk after repetitions are removed, without \
increasing length. This proves the inclusion from left to right. For the \
reverse inclusion, choose a shortest base walk from ",
 Cell[BoxData[
  RowBox[{"\[Pi]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aee69470-6ee4-43ae-a1fc-62e00e79b2af"],
 " to a point of its radius-",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fd12607-da20-46a2-9aaa-537ae5d68403"],
 " ball. Weak lifting supplies a transverse lift of each successive step, \
starting at ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06b17795-a3ad-490a-bab6-80158aa30025"],
 ". The lifted endpoint lies in the total radius-",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "992c02db-5893-4159-a333-5b65efad6a65"],
 " ball and projects to the required point. Conversely, equality at radius \
one supplies a total neighbour over every base neighbour, because a distinct \
base vertex cannot be the projection of ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c50407bc-f040-424c-a923-9ec0dec14353"],
 " itself. This is precisely weak edge lifting."
}], "Text",ExpressionUUID->"4ff2ef76-b12b-4787-b1cf-23350f738a82"],

Cell["\<\
The total ball below projects onto the marked base ball. The statement \
permits multiple lifts and unequal fibers.\
\>", "Text",ExpressionUUID->"68bee323-caeb-4ddc-92ae-bc3fd4cad4d2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"PathGraph", "[", " ", 
        RowBox[{"Range", "[", " ", "6", " ", "]"}], " ", "]"}], ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", " ", "\"\<Fibration\>\"", " ", "}"}]}], ",", "\n", 
       "    ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", 
         RowBox[{"2", ",", " ", "3"}], " ", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"total", " ", "=", " ", 
      RowBox[{"InfraTotalSpace", "[", " ", "fib", " ", "]"}]}], ",", " ", 
     RowBox[{"base", " ", "=", " ", 
      RowBox[{"InfraBaseSpace", "[", " ", "fib", " ", "]"}]}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"start", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"VertexList", "[", " ", "total", " ", "]"}]}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"point", " ", "=", " ", 
     RowBox[{"Lookup", "[", " ", 
      RowBox[{
       RowBox[{"InfraProjection", "[", " ", "fib", " ", "]"}], ",", " ", 
       RowBox[{"Key", "[", " ", "start", " ", "]"}]}], " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", " ", 
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"{", " ", 
         RowBox[{"NeighborhoodGraph", "[", " ", 
          RowBox[{"total", ",", " ", "start", ",", " ", "2"}], " ", "]"}], 
         " ", "}"}]}], " ", "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", " ", 
       RowBox[{"base", ",", " ", 
        RowBox[{"{", " ", 
         RowBox[{"NeighborhoodGraph", "[", " ", 
          RowBox[{"base", ",", " ", "point", ",", " ", "2"}], " ", "]"}], " ",
          "}"}]}], " ", "]"}]}], " ", "}"}], " ", "]"}]}], " ", 
  "]"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"f65dcfdb-9ea5-4444-b62b-4bcc0aeaac7a"],

