Cell["Exact ball projection under weak lifting", "Section",ExpressionUUID->"7a8b9a48-2048-43c5-8184-10cde6bfe48c"],

Cell[TextData[{
 "Weak edge lifting has a positive consequence at every finite distance \
scale. Write ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["E", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "534b1ae6-1f13-4ef7-8ac5-2952983c6516"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["p", "TI"], ",", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f25ad1b-b0fc-40aa-9e02-3827c90a3f7f"],
 " for closed graph-distance balls of integer radius ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "\[GreaterEqual]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70ddee2d-d8c3-4926-895f-43a1e2f24484"],
 ". A fibered graph has weak edge lifting exactly when"
}], "Text",ExpressionUUID->"3dc1b854-18ac-43d7-89bf-658d1d065ffe"],

Cell[BoxData[
 PaneBox[
  RowBox[{"\[Pi]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["E", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["r", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"\[Pi]", 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["x", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], ",", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"3a031255-61b1-40f6-\
ac24-915930c08b51"],

Cell[TextData[{
 "for every total vertex ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd758678-ff5b-4d67-9412-c040b552200e"],
 " and every such radius. It is enough to test radius one."
}], "Text",ExpressionUUID->"1a2be6af-6ac3-42a8-a80d-547cc5599d06"],

Cell[TextData[{
 "Every total edge projects to a base edge or a vertex. Projecting a total \
walk therefore gives a base walk after repetitions are removed, without \
increasing length. This proves the inclusion from left to right. For the \
reverse inclusion, choose a shortest base walk from ",
 Cell[BoxData[
  RowBox[{"\[Pi]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63d96d8b-988e-4471-8e98-57a17dd2ebce"],
 " to a point of its radius-",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cd034da-b63a-459d-9e0d-0cc513ecb9d3"],
 " ball. Weak lifting supplies a transverse lift of each successive step, \
starting at ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62341696-129a-4ce5-ac7c-beb2a3ade124"],
 ". The lifted endpoint lies in the total radius-",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b59b4d41-242c-40b9-892f-34886e60decc"],
 " ball and projects to the required point. Conversely, equality at radius \
one supplies a total neighbour over every base neighbour, because a distinct \
base vertex cannot be the projection of ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1c35432-a180-47ed-b535-9078eac7fc5c"],
 " itself. This is precisely weak edge lifting."
}], "Text",ExpressionUUID->"c13337ce-ab62-401c-9145-2728c432f45d"],

Cell["\<\
The total ball below projects onto the marked base ball. The statement \
permits multiple lifts and unequal fibers.\
\>", "Text",ExpressionUUID->"f624aa83-d5d4-47e8-9991-7deeacd92341"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"PathGraph", "[", " ", 
        RowBox[{"Range", "[", " ", "6", " ", "]"}], " ", "]"}], ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", " ", "\"\<Fibration\>\"", " ", "}"}]}], ",", "\n", 
       "    ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", 
         RowBox[{"2", ",", " ", "3"}], " ", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"total", " ", "=", " ", 
      RowBox[{"InfraTotalSpace", "[", " ", "fib", " ", "]"}]}], ",", " ", 
     RowBox[{"base", " ", "=", " ", 
      RowBox[{"InfraBaseSpace", "[", " ", "fib", " ", "]"}]}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"start", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"VertexList", "[", " ", "total", " ", "]"}]}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"point", " ", "=", " ", 
     RowBox[{"Lookup", "[", " ", 
      RowBox[{
