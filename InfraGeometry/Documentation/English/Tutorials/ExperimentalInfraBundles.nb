Cell[TextData[{
 "There is an exact criterion for reducing a projection. Let ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], ":", 
   RowBox[{
    StyleBox["V", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["E", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[Rule]", 
    OverscriptBox[
     RowBox[{
      StyleBox["V", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["E", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], "_"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0cb5c80-0cbc-4cd8-8402-c048b669c8c3"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Beta]", "TI"], ":", 
   RowBox[{
    StyleBox["V", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["B", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[Rule]", 
    OverscriptBox[
     RowBox[{
      StyleBox["V", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["B", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], "_"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7ebbba9-0032-47b5-8e15-6d1e060aa9cc"],
 " describe total and base observations. A map ",
 Cell[BoxData[
  OverscriptBox["\[Pi]", "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1cd067a-4ad4-4ed9-894d-a2a8f90c0ccd"],
 " satisfying"
}], "Text",ExpressionUUID->"234ab15d-4789-4dda-b0df-0b334db7fe14"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   OverscriptBox["\[Pi]", "_"], "\[SmallCircle]", 
   StyleBox["\[Alpha]", "TI"], "=", 
   StyleBox["\[Beta]", "TI"], "\[SmallCircle]", "\[Pi]"}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"6a284661-5c5e-40d4-\
aac6-dda8561515ac"],

Cell[TextData[{
 "exists exactly when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Beta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[Pi]", 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["\[Beta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[Pi]", 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["y", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47c0f47d-2b9c-41cc-bf13-3161e7e4e946"],
 " whenever ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["\[Alpha]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["y", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4899bc0-9899-46d3-b989-dcf02c076c03"],
 ". Necessity follows by applying the displayed identity to both \
representatives. For sufficiency, define ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox["\[Pi]", "_"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["\[Beta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[Pi]", 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ceb7a27d-bd4e-4f6b-86e5-12216e29e5f4"],
 "; the condition makes this independent of the representative. With quotient \
adjacency reconstructed from edges, each edge still projects to an edge or a \
vertex. This establishes a reduced graph map, without establishing any \
lifting property."
}], "Text",ExpressionUUID->"5b54c2e2-ad2d-414e-9d82-a8e1c1cfe355"],

Cell["Exact descent of a selected transport", "Section",ExpressionUUID->"580f3054-f7de-4ad6-bdd4-130bb4d0fe99"],

Cell[TextData[{
 "Suppose a complete connection transports ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e37d3342-005f-4d58-931e-3d98559fa230"],
 " to ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], 
   StyleBox["q", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e30478ef-0bb4-46fd-a731-9a9d64f7d5bf"],
 " by a bijection ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], 
   StyleBox[
    RowBox[{"p", "q"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "434b6445-dd08-4165-9fd8-5d47e8fd8bf4"],
 ". Choose an equivalence relation in each fiber. The transport descends to a \
map of equivalence classes exactly when"
}], "Text",ExpressionUUID->"c69e4d13-8c56-4b09-bc6f-8053ccc039ff"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["x", "TI"], 
    SubscriptBox["\[Tilde]", 
     StyleBox["p", "TI"]], 
    StyleBox["y", "TI"], "\[NonBreakingSpace]\[NonBreakingSpace]", "\[DoubleLongRightArrow]",
     "\[NonBreakingSpace]\[NonBreakingSpace]", 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"p", "q"}], "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], 
    SubscriptBox["\[Tilde]", 
     StyleBox["q", "TI"]], 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"p", "q"}], "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["y", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"3c200d79-3de6-49a7-\
a0ac-77b4c180bd4e"],

Cell[TextData[{
 "Indeed, this condition says precisely that the proposed image class is \
independent of the representative. The descended map is a bijection with \
descended inverse when the same condition holds for ",
 Cell[BoxData[
  SubsuperscriptBox[
   StyleBox["T", "TI"], 
   StyleBox[
    RowBox[{"p", "q"}], "TI"], 
   RowBox[{"-", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f7cb2c8-655d-4ccf-9c70-174f1fe0a732"],
 ". If the original transport is a fiber-graph isomorphism, these two \
conditions also give an isomorphism of the reconstructed quotient fiber \
graphs. Every original adjacency maps to a quotient adjacency or a collapsed \
vertex, and the inverse gives the converse."
}], "Text",ExpressionUUID->"7602803a-f8e5-42e1-804d-50e9f280539e"],

Cell["\<\
These conditions can be checked for a proposed observation. An arbitrary \
partition need not satisfy them. Merging base vertices creates additional \
compatibility questions and is not covered by this fixed-base descent \
statement.\
\>", "Text",ExpressionUUID->"63146fec-43aa-476d-a7b2-ebe870e7e231"],

Cell["Proposed completion and emergence questions", "Section",ExpressionUUID->"ae6978ab-803c-4e98-938b-ad8ac269ecd1"],

Cell["\<\
A single finite unweighted graph does not determine a continuum limit. A \
completion claim needs a family of finite objects, scale choices and a \
specified notion of convergence. A bundle-emergence claim additionally needs \
a limit projection and a stated bundle class.\
\>", "Text",ExpressionUUID->"328c48fe-5f45-4b12-b6a7-c009561e9d5a"],

Cell["\<\
The following are research requirements to formulate and prove in a chosen \
model, not a sufficient-condition theorem.\
\>", "Text",ExpressionUUID->"668191fa-8f64-4bdc-bfc6-e252f37161fa"],

Cell["\<\
Specify total graphs, base graphs and projections at each resolution, \
together with the comparison maps between resolutions.\
\>", "Item",ExpressionUUID->"8f0dd8dc-b70b-470d-a6f2-913436fcd5f4"],

Cell["\<\
Specify how graph distance is rescaled and what convergence of total spaces, \
base spaces and projections means.\
\>", "Item",ExpressionUUID->"4525cf0e-b3ec-467e-86a2-7c7d03c4e56a"],

Cell["\<\
Control the fibers under those comparisons. Equal cardinalities at one \
resolution neither prevent collapse nor produce a limiting fiber topology.\
\>", "Item",ExpressionUUID->"ceac4b9e-7d1c-46fc-aa94-f46255c8b3e3"],

Cell["\<\
Construct compatible local identifications and prove the limit's required \
local product or lifting property.\
\>", "Item",ExpressionUUID->"babd3020-8d8c-4624-90ae-4d0a8b6b6f5c"],

Cell["\<\
If connections are retained, specify a common transport target or compatible \
actions, and prove convergence of transport along comparable walks.\
\>", "Item",ExpressionUUID->"502458dc-7fbb-4597-969c-aceb073b1906"],

Cell["\<\
If curvature is claimed, supply faces or another loop family and prove the \
appropriate scaled holonomy statement.\
\>", "Item",ExpressionUUID->"33715378-cf91-4e6c-b496-38a2249291c5"],

Cell[TextData[{
 "There is a basic exact obstruction to retaining a nontrivial fiber under \
uniform metric rescaling. Suppose every vertical fiber is a copy of one fixed \
connected graph ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74f682de-5443-4742-b4fb-108f7835ac82"],
 " of diameter ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6423d701-714f-4273-a458-1dd45a5a63b4"],
 ". When every total edge has rescaled length ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a361e64-8ab9-4f00-b242-57a97949205b"],
 ", two vertices in the same fiber have total-space distance at most ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["D", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "edbe94ab-59a8-4b78-9995-9e0e5fb0d95a"],
 ", using a vertical path. If ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1601cabf-9dba-4c15-af27-a861cd45d415"],
 " tends to zero, all such pairwise fiber distances tend to zero. Thus a \
proposed nontrivial limiting fiber needs additional structure or a different \
scaling regime."
}], "Text",ExpressionUUID->"a5ab0056-37bb-420a-838d-4804d3be515c"],

Cell[TextData[{
 "A graph-bundle predicate alone supplies none of these limiting choices. \
Even geometric realization requires care: a Cartesian product graph contains \
edges, but no filled squares. The local product requirement for topological \
bundles concerns spaces and their neighbourhoods, as in ",
 ButtonBox["Hatcher, Algebraic Topology, Section 4.2",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://pi.math.cornell.edu/~hatcher/AT/AT.pdf"], None}],
 "."
}], "Text",ExpressionUUID->"dd436f96-611f-49d7-b524-0cc5568a3e92"],

Cell["\<\
Finite models motivated by the seven-sphere, Hurwitz algebras or Hopf \
fibrations belong to particular research constructions. Each needs its own \
projection, algebraic action and comparison with the intended continuous \
object. They are not assumptions of the finite framework, and do not \
establish generic emergence of topological bundles.\
\>", "Text",ExpressionUUID->"d8d3fc27-a275-48ac-b4e3-5337582af712"],

Cell["Holonomy under changed fiber coordinates", "Section",ExpressionUUID->"a3e637c3-25cd-4b98-ba5e-c53877b2c03c"],

Cell[TextData[{
 "There is an exact statement before any limiting argument. If fiber \
coordinates are changed by bijections ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["g", "TI"], 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0d31a78-a511-463f-afa6-ec4c08369d7f"],
 ", edge transport becomes ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["q", "TI"]], 
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox[
     RowBox[{"p", "q"}], "TI"]], 
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["p", "TI"], 
    RowBox[{"-", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b36d48d0-bfa8-4de3-b14e-120b088afee6"],
 ". Around a closed walk at ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5a7b95b-08ce-4889-aaf9-27751d9c6adf"],
 ", intermediate coordinate changes cancel, so holonomy becomes ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["p", "TI"]], 
   StyleBox["H", "TI"], 
   SubsuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox["p", "TI"], 
    RowBox[{"-", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23c27388-f3b2-4504-9350-2ff8d477d91d"],
 ". Its conjugacy class is therefore independent of those coordinate choices. \
If the coordinates and transport are required to preserve fiber graphs, the \
bijections must be graph isomorphisms."
}], "Text",ExpressionUUID->"8f57b214-dc39-4daa-bfa9-3dc5358843f5"],

Cell[TextData[{
 "This is the finite gauge interpretation in Ioana Milea's Fibered Graph \
Gauge Theory Basics, unpublished, 2026. It does not supply a face system or a \
continuum limit. The general holonomy reader remains a permutation of one \
finite fiber, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTrivialMonodromyQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTrivialMonodromyQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8fa57fea-e351-4947-8df3-0b3086b88683"],
 " tests trivial global monodromy."
}], "Text",ExpressionUUID->"bc5b6982-2a44-4400-a835-3db5a13f0e3b"],

