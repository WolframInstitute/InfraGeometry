Cell["\<\
These operations need not commute with projection. They need not preserve \
unique lifting, fiber sizes, selected connections or monodromy. Such \
preservation is a statement to prove for a specified operation.\
\>", "Text",ExpressionUUID->"d0e897f2-94ae-4db2-82d7-63486b81ed32"],

Cell["\<\
For example, replace the total graph of the double covering of a square by \
its second graph power while keeping its vertex projection. A total vertex \
now has two neighbours over the opposite square vertex. The reconstructed \
base gains diagonals, and unique lifting fails. The three pictures use \
reachability scales one, two and three.\
\>", "Text",ExpressionUUID->"7feac1ef-36e4-4ec8-a5e3-812efa1a976d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"GraphicsRow", "[", " ", 
  RowBox[{"Map", "[", " ", 
   RowBox[{
    RowBox[{"radius", " ", "|->", " ", 
     RowBox[{"With", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"fib", " ", "=", " ", 
         RowBox[{"InfraFiberedGraph", "[", " ", 
          RowBox[{
           RowBox[{"GraphPower", "[", " ", 
            RowBox[{
             RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}], ",", " ", 
             "radius"}], " ", "]"}], ",", " ", 
           RowBox[{"vertex", " ", "|->", " ", 
            RowBox[{"Mod", "[", " ", 
             RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}],
           " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
       RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
        RowBox[{"fib", ",", " ", 
         RowBox[{"{", " ", 
          RowBox[{"InfraFiber", "[", " ", 
           RowBox[{"fib", ",", " ", "1"}], " ", "]"}], " ", "}"}]}], " ", 
        "]"}]}], " ", "]"}]}], ",", " ", 
    RowBox[{"Range", "[", " ", "3", " ", "]"}]}], " ", "]"}], " ", 
  "]"}]}], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"e959d9cf-b9fc-4138-8ec3-958eec4439c7"],

