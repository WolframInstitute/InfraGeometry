Notebook[{

Cell[CellGroupData[{
Cell["Experimental Infra Bundles", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 "We separate particular finite models from questions about observation at \
scale and possible limits. The exact statements below concern finite graphs, \
quotient maps and selected matchings. The completion and emergence section \
states research requirements; it supplies no general convergence theorem or \
new scale API. The general definitions are in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infra Bundles"]], 
    "paclet:WolframInstitute/InfraGeometry/tutorial/InfraBundles"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "26092523-d286-4177-90fe-cf1bc7b88119"],
 "."
}], "Text",ExpressionUUID->"172873f0-c588-4993-834f-35218447c762"],

Cell["Setup", "Section",ExpressionUUID->"fd66ba15-7c7b-463d-abbd-0c0c321368d0"],

Cell[BoxData[
 RowBox[{"Needs", "[", " ", "\"\<WolframInstitute`InfraGeometry`\>\"", " ", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"adccd552-d0a2-4382-af04-929720f39618"],

Cell["Particular geometric models", "Section",ExpressionUUID->"f37b1eff-fb07-4b18-9058-8d6ebd9b8237"],

Cell["\<\
The model names describe how their total vertices and edges are constructed. \
Their fibration and bundle properties must be checked on the chosen substrate \
and scale. The name of a model does not assert the general graph-bundle \
predicate.\
\>", "Text",ExpressionUUID->"39e737ae-e3db-4048-a207-e904e62d7d03"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "74b13ee5-fd14-4cba-965e-b96f4f5f04fb"], Cell["Construction", "TableText",
     FontWeight->Bold,ExpressionUUID->"9d06e8f8-d71d-4bef-88c5-3ebd6aa9d187"],
     Cell["Total vertices and projection", "TableText",
