Cell["Exact reduction by observations", "Section",ExpressionUUID->"b99a3423-f952-41af-817a-b66895466ebd"],

Cell["\<\
An observation map groups total vertices into classes and thereby defines \
another reconstructed base. This quotient records whether some edge joins two \
classes. It does not retain how many lifts each representative has. The \
multiplicity measurement reads that information before reduction.\
\>", "Text",ExpressionUUID->"5fdbc060-1923-44d3-8e7d-37c624a3e8aa"],

Cell["\<\
Here adjacent pairs of vertices of a cycle become single observed states. \
Each fiber is an edge, but its two endpoints lift different directions of the \
quotient cycle. This is a valid fibered graph without the weak fibration \
property.\
\>", "Text",ExpressionUUID->"6d804d6b-5c01-4ac0-a165-8d6d113258f0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "12", " ", "]"}], ",", " ", 
       RowBox[{"vertex", " ", "|->", " ", 
        RowBox[{"Ceiling", "[", " ", 
         RowBox[{"vertex", " ", "/", " ", "2"}], " ", "]"}]}]}], " ", "]"}]}],
     " ", "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", " ", 
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"{", " ", 
         RowBox[{"InfraFiber", "[", " ", 
          RowBox[{"fib", ",", " ", "1"}], " ", "]"}], " ", "}"}]}], " ", 
       "]"}], ",", "\n", "    ", 
      RowBox[{"InfraTotalSpace", "[", " ", "fib", " ", "]"}], ",", " ", 
      RowBox[{"InfraBaseSpace", "[", " ", "fib", " ", "]"}]}], " ", "}"}], 
    " ", "]"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"35bc1fab-4cf6-4a2b-8ef4-223b13716f13"],

