Cell["Exact ball projection under weak lifting", "Section",ExpressionUUID->"c11f9440-c23e-4c8d-9ec9-e64c82412261"],

Cell[TextData[{
 "Weak edge lifting has a positive consequence at every finite distance \
scale. Write ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["E", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "423ae59b-097e-4dfa-b9da-724fd68bf51e"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["p", "TI"], ",", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e49909cb-4920-432b-81d9-c08ec6864831"],
 " for closed graph-distance balls of integer radius ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "\[GreaterEqual]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1387daed-2165-4f54-b920-b8af66f27665"],
 ". A fibered graph has weak edge lifting exactly when"
}], "Text",ExpressionUUID->"020d7fb7-3006-431c-8b2b-37928f929845"],

Cell[BoxData[
 PaneBox[
  RowBox[{"\[Pi]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["E", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["r", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["B", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"\[Pi]", 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["x", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], ",", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"dbb21d1d-2888-4335-\
9067-830ae6fd1980"],

Cell[TextData[{
 "for every total vertex ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2af3ed08-d77b-474e-98da-5f4ba9e853bb"],
 " and every such radius. It is enough to test radius one."
}], "Text",ExpressionUUID->"75367a7c-fc64-4df9-9d22-b58f6f304156"],

Cell[TextData[{
 "Every total edge projects to a base edge or a vertex. Projecting a total \
walk therefore gives a base walk after repetitions are removed, without \
increasing length. This proves the inclusion from left to right. For the \
reverse inclusion, choose a shortest base walk from ",
 Cell[BoxData[
  RowBox[{"\[Pi]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4c970f4-38b3-48d9-b799-a2b81c87dd0d"],
 " to a point of its radius-",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81a18594-d423-4bdc-b1b8-32379bdaa960"],
 " ball. Weak lifting supplies a transverse lift of each successive step, \
starting at ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a97d4208-2eea-411e-9e3f-d372e1dbf63b"],
 ". The lifted endpoint lies in the total radius-",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5051bc80-51f8-471e-85e7-f60cc86e86e1"],
 " ball and projects to the required point. Conversely, equality at radius \
one supplies a total neighbour over every base neighbour, because a distinct \
base vertex cannot be the projection of ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0079555f-252a-457c-ab79-247ecd0b7828"],
 " itself. This is precisely weak edge lifting."
}], "Text",ExpressionUUID->"bee11056-e899-4539-acfc-ebd7a55a579a"],

Cell["\<\
The total ball below projects onto the marked base ball. The statement \
permits multiple lifts and unequal fibers.\
\>", "Text",ExpressionUUID->"a0ba71ba-ffe2-4871-b72e-6e8412a9b8f5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"PathGraph", "[", " ", 
        RowBox[{"Range", "[", " ", "6", " ", "]"}], " ", "]"}], ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", " ", "\"\<Fibration\>\"", " ", "}"}]}], ",", "\n", 
       "    ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", 
         RowBox[{"2", ",", " ", "3"}], " ", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"total", " ", "=", " ", 
      RowBox[{"InfraTotalSpace", "[", " ", "fib", " ", "]"}]}], ",", " ", 
     RowBox[{"base", " ", "=", " ", 
      RowBox[{"InfraBaseSpace", "[", " ", "fib", " ", "]"}]}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"start", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"VertexList", "[", " ", "total", " ", "]"}]}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", " ", 
