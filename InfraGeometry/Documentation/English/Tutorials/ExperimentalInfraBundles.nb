          RowBox[{"fib", ",", " ", "1"}], " ", "]"}], " ", "}"}]}], " ", 
       "]"}], ",", "\n", "    ", 
      RowBox[{"InfraTotalSpace", "[", " ", "fib", " ", "]"}], ",", " ", 
      RowBox[{"InfraBaseSpace", "[", " ", "fib", " ", "]"}]}], " ", "}"}], 
    " ", "]"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"2ed20b5f-dac4-4504-8761-2b803ae79581"],

