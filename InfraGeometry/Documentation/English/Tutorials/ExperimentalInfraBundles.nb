         RowBox[{"graph", ",", " ", "1"}], " ", "]"}]}], " ", "}"}]}], " ", 
     "]"}], " ", "]"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"312d642c-80de-436f-96d7-e5d48705a6aa"],

