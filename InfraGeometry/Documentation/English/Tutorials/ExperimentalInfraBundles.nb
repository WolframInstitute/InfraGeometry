          RowBox[{"fib", ",", " ", "1"}], " ", "]"}], " ", "}"}]}], " ", 
       "]"}], ",", "\n", "    ", 
      RowBox[{"InfraTotalSpace", "[", " ", "fib", " ", "]"}], ",", " ", 
      RowBox[{"InfraBaseSpace", "[", " ", "fib", " ", "]"}]}], " ", "}"}], 
    " ", "]"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"f3c6083e-f590-4a55-bf56-839cf27542dd"],

