Notebook[{

Cell[CellGroupData[{
Cell["LLM generated.", "Text",ExpressionUUID->"4edbc5bb-950e-4e1d-b58e-8aa4e0f2d511"],

Cell["\<\
Synthetic constructions now have separate named samplers. The former public \
generic representative sampler is removed, with no compatibility alias.\
\>", "Text",ExpressionUUID->"c4e167d9-6178-4a2d-8f79-cd0ac766db45"],

Cell["\<\
A token call preserves its declared carrier and sampling law. A bare \
half-line or infinite-line call retains its original traversal law; its token \
call samples the shortest-path DAG family. A bare regular polygon returns \
directed Graph legs; its token returns an ordered vertex sequence. A bare \
geodesic returns a position-spelled Graph; its token returns an ordered \
sequence.\
\>", "Text",ExpressionUUID->"f9e3ed7a-30b8-423c-b226-9de32dae77cf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"PathGraph", "[", " ", 
      RowBox[{"Range", "[", " ", "5", " ", "]"}], " ", "]"}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"RandomInfraHalfLine", "[", " ", 
    RowBox[{"graph", ",", " ", 
     RowBox[{"InfraHalfLine", "[", " ", 
      RowBox[{"2", ",", " ", "3"}], " ", "]"}], ",", " ", "All"}], " ", 
    "]"}]}], " ", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"df1f098a-9df8-4190-a0c8-f28cdcfda901"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"2", ",", "3", ",", "4", ",", "5"}], "}"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"cbd13aef-b65c-4968-9837-728eb5afe869"]
}, Open  ]],

Cell[TextData[{
 "A region head has one member, its vertex set, so it has no sampler: ",
 Cell[BoxData["InfraSupport"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f2c8c46-e1ba-481f-982f-44cc49157ac0"],
 " reads the set and ",
 Cell[BoxData["RandomInfraPoint"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "196fa7b2-35ce-4ddd-ae4b-611169a7fd5a"],
 " draws vertices of it."
}], "Text",ExpressionUUID->"36ff39b7-c8a3-4b92-933a-b1d8f6825b45"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"PathGraph", "[", " ", 
       RowBox[{"Range", "[", " ", "5", " ", "]"}], " ", "]"}]}], " ", "}"}], ",",
     "\n", "  ", 
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"InfraSupport", "[", " ", 
       RowBox[{"graph", ",", " ", 
        RowBox[{"InfraBall", "[", " ", 
         RowBox[{"3", ",", " ", "1"}], " ", "]"}]}], " ", "]"}], ",", " ", 
      RowBox[{"RandomInfraPoint", "[", " ", 
       RowBox[{"graph", ",", " ", 
        RowBox[{"InfraBall", "[", " ", 
         RowBox[{"3", ",", " ", "1"}], " ", "]"}], ",", " ", "2"}], " ", 
       "]"}]}], " ", "}"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"dd23183f-2f09-472a-b3a9-6debe681685e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"84a67063-7485-44e6-9e0c-b70ca3c31dfc"]
}, Open  ]],

Cell["\<\
The old inert Ray, Line and Polygon spellings remain supported for this \
release. Their canonical names are InfraHalfLine, InfraInfiniteLine and \
InfraRegularPolygon. The old named ray and line samplers and predicates \
forward without drawing extra random numbers.\
\>", "Text",ExpressionUUID->"4d0d5693-2d8f-4172-bf4e-f741d8f985a1"],

Cell["\<\
Omitted or Automatic count selects one representative. An integer requests \
exactly that many distinct representatives, UpTo gives at most that many, and \
All enumerates the complete pool. Negative counts and unsupported options \
stay unevaluated. Default All and Identity do not advance random state. An \
explicit legacy stochastic selector retains its original action.\
\>", "Text",ExpressionUUID->"928b6c96-b205-4fb3-90d6-bbbc23cd13bc"],

Cell[TextData[{
 "Ball, Shell, Tube, Cylinder, Cone, SolidOfRevolution, BallHull, ConvexHull \
and Quadric each have one member, their support, possibly empty; ",
 Cell[BoxData[
  RowBox[{"InfraSupport", "[", 
   RowBox[{"graph", ",", " ", "head"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61c7f644-61d8-43fe-9757-d4c1b4cf9b45"],
 " reads it and there is no ",
 Cell[BoxData[
  RowBox[{"RandomInfra", "..."}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8d2d18d-6067-4917-8259-e1f8530f7d63"],
 " sampler for them. Intersection and Union sample points from complete \
operand supports. Point labels that are Lists remain intact."
}], "Text",ExpressionUUID->"29ab8216-8e5a-4461-b7c0-05059f0c80a3"],

Cell["\<\
The named functions are RandomInfraPoint, RandomInfraSegment, \
RandomInfraHalfLine, RandomInfraInfiniteLine, RandomInfraCircle, \
RandomInfraArc, RandomInfraRegularPolygon, RandomInfraPlane, \
RandomInfraSphere, RandomInfraWalk, RandomInfraGeodesic, RandomInfraEllipse, \
RandomInfraIntersection, RandomInfraUnion, RandomInfraMidpoint, \
RandomInfraPerpendicularBisector and RandomInfraRegionNearest.\
\>", "Text",ExpressionUUID->"7f757081-914d-4732-965a-e87c59625a6d"],

Cell[TextData[{
 "Exact Midpoint, PerpendicularBisector and RegionNearest are point families \
on finite simple undirected unweighted graphs. Their complete pools contain \
distinct raw vertices in graph order. Exact midpoint can be empty; \
equidistance does not imply separation; nearest support retains all ties. See \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Synthetic geometry migration"]], 
    "paclet:WolframInstitute/InfraGeometry/tutorial/\
SyntheticGeometryMigration"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "bd02d527-0856-434e-981c-f455a23649ad"],
 " for compatibility and the segment middle-layer distinction."
}], "Text",ExpressionUUID->"5df1dba6-a8a4-4986-8489-79bb8ab4c76b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"InfraSubstrateHighlight", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"{", " ", 
       RowBox[{
        RowBox[{"InfraMidpoint", "[", " ", 
         RowBox[{"1", ",", " ", "3"}], " ", "]"}], ",", " ", "1", ",", " ", 
        "3"}], " ", "}"}]}], " ", "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"59d3a0a4-7098-4187-9629-984feae593e3"],

