Notebook[{

Cell[CellGroupData[{
Cell["Named Construction Samplers", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell["\<\
Synthetic constructions now have separate named samplers. The former public \
generic representative sampler is removed, with no compatibility alias.\
\>", "Text",ExpressionUUID->"02eaf168-1de8-4d3c-8e65-85d9b0641338"],

Cell["\<\
A token call preserves its declared carrier and sampling law. A bare \
half-line or infinite-line call retains its original traversal law; its token \
call samples the shortest-path DAG family. A bare regular polygon returns \
directed Graph legs; its token returns an ordered vertex sequence. A bare \
geodesic returns a position-spelled Graph; its token returns an ordered \
sequence.\
\>", "Text",ExpressionUUID->"95c6e1a9-553a-4581-8b6a-62750d9f0162"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"PathGraph", "[", " ", 
      RowBox[{"Range", "[", " ", "5", " ", "]"}], " ", "]"}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"RandomInfraHalfLine", "[", " ", 
    RowBox[{"graph", ",", " ", 
     RowBox[{"InfraHalfLine", "[", " ", 
      RowBox[{"2", ",", " ", "3"}], " ", "]"}], ",", " ", "All"}], " ", 
    "]"}]}], " ", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"290273ce-c430-45df-9a96-eccbba2e189e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"2", ",", "3", ",", "4", ",", "5"}], "}"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ce449a08-dfc1-4e2c-b109-1a558f7caafc"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"PathGraph", "[", " ", 
      RowBox[{"Range", "[", " ", "5", " ", "]"}], " ", "]"}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"Keys", " ", "@", " ", 
    RowBox[{"InfraMeasurement", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"InfraBall", "[", " ", 
       RowBox[{"3", ",", " ", "1"}], " ", "]"}], ",", 
      " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], " ", "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"fa9b3be4-9842-4f27-9f41-c8471d96082e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3", ",", "4"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"5d02cd14-840a-4638-8730-e5095930f1c7"]
}, Open  ]],

Cell["\<\
The old inert Ray, Line and Polygon spellings remain supported for this \
release. Their canonical names are InfraHalfLine, InfraInfiniteLine and \
InfraRegularPolygon. The old named ray and line samplers and predicates \
forward without drawing extra random numbers.\
\>", "Text",ExpressionUUID->"1147aa0e-23b4-46b4-b94f-6b82d88b31e3"],

Cell["\<\
Omitted or Automatic count selects one representative. An integer requests \
exactly that many distinct representatives, UpTo gives at most that many, and \
All enumerates the complete pool. Negative counts and unsupported options \
stay unevaluated. Default All and Identity do not advance random state. An \
explicit legacy stochastic selector retains its original action.\
\>", "Text",ExpressionUUID->"76e4c39d-7d62-42e0-a292-62117e6e5580"],

Cell[TextData[{
 "Ball, Shell, Tube, Cylinder, Cone, SolidOfRevolution, BallHull, ConvexHull \
and Quadric are fixed vertex sets, including an empty set. Read their \
vertices with ",
 Cell[BoxData[
  RowBox[{"Keys", " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"graph", ",", " ", "object", ",", " ", "\"\<VertexDensity\>\""}], 
    "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3fa6179-b5db-4546-96e3-6b7619db29c8"],
 ". Intersection and Union combine the operand densities; they have no random \
constructor. Use RandomInfraPoint on a region to sample its points. Point \
labels that are Lists remain intact."
}], "Text",ExpressionUUID->"bacc1055-057e-4e3d-9d2b-37a71d004aae"],

Cell["\<\
The named functions are RandomInfraPoint, RandomInfraSegment, \
RandomInfraHalfLine, RandomInfraInfiniteLine, RandomInfraCircle, \
RandomInfraArc, RandomInfraRegularPolygon, RandomInfraPlane, \
RandomInfraSphere, RandomInfraWalk, RandomInfraGeodesic, RandomInfraEllipse, \
RandomInfraMidpoint and RandomInfraRegionNearest.\
\>", "Text",ExpressionUUID->"80a71abf-f483-4ebf-b7d7-dc02003fbb28"],

Cell[TextData[{
 "Midpoint and RegionNearest are point families on finite simple undirected \
unweighted graphs. Their complete pools contain distinct raw vertices in \
graph order. Midpoint uses the central layer or two central layers of the \
oriented segment graph; RegionNearest retains all distance-minimizing ties. \
PerpendicularBisector is the unique finite equidistant locus. Use \
InfraPoint[InfraPerpendicularBisector[p,q]] to choose a point on it. See ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Synthetic geometry migration"]], 
    "paclet:WolframInstitute/InfraGeometry/tutorial/\
SyntheticGeometryMigration"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "e18d26bf-1a77-4715-9ab9-a2541de83f53"],
 " for compatibility and midpoint density."
}], "Text",ExpressionUUID->"c3b5516c-9751-4635-b56c-e61e455c9269"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"InfraSubstrateHighlight", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"{", " ", 
       RowBox[{
        RowBox[{"InfraMidpoint", "[", " ", 
         RowBox[{"1", ",", " ", "3"}], " ", "]"}], ",", " ", "1", ",", " ", 
        "3"}], " ", "}"}]}], " ", "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"d58b3532-9508-4c4b-aa3f-982b24d42eb9"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3, 4}, {Null, 
       SparseArray[
       Automatic, {4, 4}, 0, {
        1, {{0, 2, 4, 6, 8}, {{2}, {4}, {1}, {3}, {2}, {4}, {1}, {3}}}, 
         Pattern}]}, {
      GraphLayout -> "CircularEmbedding", 
       VertexShapeFunction -> {3 -> (Append[{
            RGBColor[1., 0.607843, 0.], 
            Opacity[1.]}, 
           Disk[#, 1 #3]]& ), 1 -> (Append[{
            RGBColor[0.192157, 0.388235, 0.807843], 
            Opacity[1.]}, 
           Disk[#, 1 #3]]& ), 4 -> (Append[{
            RGBColor[0.790588, 0.201176, 0.], 
            Opacity[1.]}, 
           Disk[#, 1 #3]]& ), 2 -> (Append[{
            RGBColor[0.790588, 0.201176, 0.], 
            Opacity[1.]}, 
           Disk[#, 1 #3]]& )}}]]}, 
    TagBox[GraphicsGroupBox[{
       {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], 
