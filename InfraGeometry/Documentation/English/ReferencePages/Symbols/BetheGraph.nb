Notebook[{

Cell[CellGroupData[{
Cell["BetheGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"67bdad69-6b61-424c-8193-09d9a1fe491b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BetheGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BetheGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["z", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11384f71-80a3-4be9-af92-831c8bf5b208"],
 "\[LineSeparator]",
 "gives the Bethe lattice of coordination number ",
 StyleBox["z", "TI"],
 " with ",
 StyleBox["n", "TI"],
 " shells: the ball of radius ",
 StyleBox["n", "TI"],
 " about a vertex of the tree in which every vertex has degree ",
 StyleBox["z", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"b45a1c63-3c57-48a2-839f-74133a3bde8d"],

Cell[TextData[{
 "Definition: the root has ",
 StyleBox["z", "TI"],
 " children, and every other vertex at depth less than ",
 StyleBox["n", "TI"],
 " has ",
 StyleBox["z", "TI"],
 " \[Minus] 1. So every vertex inside has degree ",
 StyleBox["z", "TI"],
 ", and the leaves, at depth ",
 StyleBox["n", "TI"],
 ", have degree 1."
}], "Notes",ExpressionUUID->"9bd78de5-502b-4404-904a-39d9ea612bee"],

Cell[TextData[{
 "The shell at depth ",
 StyleBox["k", "TI"],
 " \[GreaterEqual] 1 has ",
 StyleBox["z", "TI"],
 "(",
 StyleBox["z", "TI"],
 " \[Minus] 1)^(",
 StyleBox["k", "TI"],
 " \[Minus] 1) vertices, and the graph has 1 + ",
 StyleBox["z", "TI"],
 "((",
 StyleBox["z", "TI"],
 " \[Minus] 1)^",
 StyleBox["n", "TI"],
 " \[Minus] 1)/(",
 StyleBox["z", "TI"],
 " \[Minus] 2) of them for ",
 StyleBox["z", "TI"],
 " > 2. For ",
 StyleBox["z", "TI"],
 " = 2 it is the path with 2",
 StyleBox["n", "TI"],
 " + 1 vertices. The balls grow exponentially, unlike those of a lattice."
}], "Notes",ExpressionUUID->"0540e472-4b03-4a49-9896-d69114c2c6d2"],

Cell[TextData[{
 "The root is the vertex 0. A vertex at depth ",
 StyleBox["k", "TI"],
 " is the list of the ",
 StyleBox["k", "TI"],
 " choices on the way down from the root: the first among 1, \[Ellipsis], ",
 StyleBox["z", "TI"],
 ", the others among 1, \[Ellipsis], ",
 StyleBox["z", "TI"],
 " \[Minus] 1."
}], "Notes",ExpressionUUID->"280bc494-6e0b-4b53-ac8d-af887af9d123"],

Cell[TextData[{
 "The graph is undirected; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DirectedEdges"]], "paclet:ref/DirectedEdges"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a8c85c83-343e-4c0f-aac7-0ad4e636bc04"],
 " -> ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e5e9493a-623c-4a50-a070-4bc72eb97ecc"],
 " orients every edge away from the root. Other ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "60b94e9b-d690-48ae-9ef3-af10c5a16f2d"],
 " options are passed on to the graph."
}], "Notes",ExpressionUUID->"f7b3e23d-6dec-49b1-9664-d90c6328b977"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["CompleteKaryTree",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74ed4b16-76fd-4832-9e9b-1f7c6fedf583"],
 " is the rooted tree in which every inner vertex has ",
 StyleBox["k", "TI"],
 " children, so its root has degree ",
 StyleBox["k", "TI"],
 " and its other inner vertices ",
 StyleBox["k", "TI"],
 " + 1."
}], "Notes",ExpressionUUID->"9f4e7ec4-0ec3-48f5-909c-a328e8c3500e"]
}, Open  ]],

