Notebook[{

Cell[CellGroupData[{
Cell["BetheGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b5228504-93d1-4a4f-af77-73d17a28b807"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BetheGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BetheGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["z", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f814486d-2bdd-41ce-afaa-d76b1c1d7456"],
 "\[LineSeparator]",
 "gives the Bethe lattice with ",
 StyleBox["n", "TI"],
 " shells and coordination number ",
 StyleBox["z", "TI"],
 ": the ball of radius ",
 StyleBox["n", "TI"],
 " about a vertex of the infinite tree in which every vertex has degree ",
 StyleBox["z", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"96b96fbf-82f4-47a5-aad9-42e6423417bd"],

Cell[TextData[{
 "The root has ",
 StyleBox["z", "TI"],
 " children and every other vertex at depth less than ",
 StyleBox["n", "TI"],
 " has ",
 StyleBox["z", "TI"],
 " \[Minus] 1. Every inner vertex has degree ",
 StyleBox["z", "TI"],
 "; the leaves, at depth ",
 StyleBox["n", "TI"],
 ", have degree 1."
}], "Notes",ExpressionUUID->"92211a61-da86-4392-b29e-faa61e6adf28"],

Cell[TextData[{
 "The shell at depth ",
 StyleBox["k", "TI"],
 " \[GreaterEqual] 1 has ",
 StyleBox["z", "TI"],
 "(",
 StyleBox["z", "TI"],
 " \[Minus] 1)\:1d4f\:207b\.b9 vertices, and the graph has ",
 StyleBox["1 + z((z \[Minus] 1)\:207f \[Minus] 1)/(z \[Minus] 2)", "TI"],
 " vertices for ",
 StyleBox["z", "TI"],
 " > 2. For ",
 StyleBox["z", "TI"],
 " = 2 it is the path with 2",
 StyleBox["n", "TI"],
 " + 1 vertices."
}], "Notes",ExpressionUUID->"e2b8b6b8-8bbd-4bdf-9b9f-f381a887126c"],

Cell[TextData[{
 "The balls grow exponentially, unlike those of a lattice. The leaves are a \
share of the whole graph that tends to ",
 StyleBox["(z \[Minus] 2)/(z \[Minus] 1)", "TI"],
 " as ",
 StyleBox["n", "TI"],
 " grows: the boundary of a ball is never small."
}], "Notes",ExpressionUUID->"368195bc-fee3-4a3e-964f-5df8898e1fed"],

Cell[TextData[{
 "The root is the vertex 0. A vertex at depth ",
 StyleBox["k", "TI"],
 " is the list of the ",
 StyleBox["k", "TI"],
 " choices on the way down: the first among 1, \[Ellipsis], ",
 StyleBox["z", "TI"],
 ", the others among 1, \[Ellipsis], ",
 StyleBox["z", "TI"],
 " \[Minus] 1."
}], "Notes",ExpressionUUID->"2a43b365-a9be-4de7-9668-f6da1819cd50"],

Cell[TextData[{
 "The graph is undirected. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DirectedEdges"]], "paclet:ref/DirectedEdges"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a6b00f92-cd01-4b02-8b9f-cdf268d2fedf"],
 " -> ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e7028d33-7a6f-4521-853e-8bd5662929a6"],
 " orients every edge away from the root; other ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a4fa4b28-14b5-4522-b154-c93d72b84772"],
 " options are passed on."
}], "Notes",ExpressionUUID->"e559a462-bb67-47cd-9669-d5df8a1d2876"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CompleteKaryTree"]], "paclet:ref/CompleteKaryTree"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "070ffce3-9553-4f45-806c-36cbccfbf6d2"],
 "[",
 StyleBox["n", "TI"],
 ", ",
 StyleBox["k", "TI"],
 "] differs: its root has degree ",
 StyleBox["k", "TI"],
 " and its other inner vertices ",
 StyleBox["k", "TI"],
 " + 1."
}], "Notes",ExpressionUUID->"25be3f44-67c2-47ac-b43e-86d181f7f2ab"]
}, Open  ]],

