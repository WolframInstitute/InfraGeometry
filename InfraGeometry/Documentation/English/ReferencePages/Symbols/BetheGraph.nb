Cell[TextData[{
 "The number of vertices is 1 + ",
 StyleBox["z", "TI"],
 "((",
 StyleBox["z", "TI"],
 " \[Minus] 1)^",
 StyleBox["n", "TI"],
 " \[Minus] 1)/(",
 StyleBox["z", "TI"],
 " \[Minus] 2)."
}], "ExampleText",ExpressionUUID->"1e21a281-b07b-4b24-adce-3eabc84eb33e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"counts", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"VertexCount", " ", "@", " ", 
        RowBox[{"BetheGraph", "[", 
         RowBox[{"n", ",", " ", "z"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"z", ",", " ", "3", ",", " ", "5"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListLogPlot", "[", 
      RowBox[{"counts", ",", " ", 
       RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<z = 3\>\"", ",", " ", "\"\<z = 4\>\"", ",", 
          " ", "\"\<z = 5\>\""}], "}"}]}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<n\>\"", ",", " ", "\"\<vertices\>\""}], "}"}]}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"counts", " ", "==", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"z", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"z", " ", "-", " ", "1"}], ")"}], "^", "n"}], " ", "-",
              " ", "1"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"z", " ", "-", " ", "2"}], ")"}]}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"z", ",", " ", "3", ",", " ", "5"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "5"}], "}"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"8bfe290a-18af-4497-853f-7050f2cdcfe6"],

