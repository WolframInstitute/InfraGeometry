Cell["\<\
The Bethe lattices with four shells and coordination numbers 3, 4 and 5, and \
their numbers of vertices.\
\>", "ExampleText",ExpressionUUID->"f201b1cf-c575-4d1d-8fd4-67f9d3742327"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"trees", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"BetheGraph", "[", 
        RowBox[{"4", ",", " ", "z"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"z", ",", " ", "3", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", "trees", "]"}], ",", " ", 
     RowBox[{"VertexCount", " ", "/@", " ", "trees"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"430482a2-d2fc-47f2-8339-a312dc933ba8"],

