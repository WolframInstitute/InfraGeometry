Cell[TextData[{
 "The number of vertices is ",
 StyleBox["1 + z((z \[Minus] 1)\:207f \[Minus] 1)/(z \[Minus] 2)", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"ed2977bb-32ce-44b1-8f87-db8f64d9e67d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"VertexCount", " ", "@", " ", 
     RowBox[{"BetheGraph", "[", 
      RowBox[{"n", ",", " ", "z"}], "]"}]}], " ", "==", " ", 
    RowBox[{"1", " ", "+", " ", 
     RowBox[{"z", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"z", " ", "-", " ", "1"}], ")"}], "^", "n"}], " ", "-", 
         " ", "1"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"z", " ", "-", " ", "2"}], ")"}]}]}]}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"z", ",", " ", "3", ",", " ", "5"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"n", ",", " ", "5"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"75eba906-ed39-4183-9a85-c8c85920f8d3"],

