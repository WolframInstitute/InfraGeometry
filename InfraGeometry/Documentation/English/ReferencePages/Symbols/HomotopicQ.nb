    "stutter", "TableText",ExpressionUUID->
     "de3cec3b-f4b7-4029-a6dd-2b4a13702c8a"], Cell[TextData[{
     "insert or delete a repeated vertex: ",
     StyleBox["\[Ellipsis] u \[Ellipsis]", "TI"],
     " \[LeftRightArrow] ",
     StyleBox["\[Ellipsis] u u \[Ellipsis]", "TI"]
    }], "TableText",ExpressionUUID->"7e17f5d6-c4c4-4c99-b1b0-6a4fc9b84375"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "525403fd-e386-4836-9e87-22f91b6f3098"], Cell[
