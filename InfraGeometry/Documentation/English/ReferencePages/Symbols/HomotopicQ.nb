Cell[TextData[{
 "The exhaustive search is breadth first over all walks up to ",
 Cell[BoxData["\"\<MaxLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20212462-8424-4c25-93ae-a5f5cae0d406"],
 ", so ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b62dca85-2881-4333-930a-25360a4e715e"],
 " means no chain within that length. The greedy search takes the move that \
brings the walk closest to the target, in the Hausdorff distance, and stops \
when no move brings it closer; its ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "606df509-f9a2-4691-a7af-ea412c43654a"],
 " means only that the descent stalled."
}], "Notes",ExpressionUUID->"8e06004f-cbf2-482b-8108-2cdd3be15c7a"]
}, Open  ]],

