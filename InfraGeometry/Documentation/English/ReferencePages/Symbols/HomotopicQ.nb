 CellID->2061341341,ExpressionUUID->"3276b1d7-cf51-4f3b-970a-56b0e7c469f0"],

Cell[CellGroupData[{

Cell["FreeHomotopy", "ExampleSubsection",ExpressionUUID->"9261eca2-c175-4f44-8659-0aab2e6f56a5"],

Cell["\<\
With free endpoints every two walks of a connected graph are homotopic, as \
two paths in the plane are:\
\>", "ExampleText",ExpressionUUID->"0811e51b-d9ef-402c-abba-6579d120cca0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"HomotopicQ", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"First", " ", "@", " ", "members"}], ",", " ", 
     RowBox[{"Last", " ", "@", " ", "members"}], ",", " ", 
     RowBox[{"\"\<FreeHomotopy\>\"", " ", "->", " ", "True"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"075bd509-6cc0-4f80-8d1a-20f9540e094b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"54e0301a-fef6-4f5f-8b56-55a6795b7bbf"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Method", "ExampleSubsection",ExpressionUUID->"ed1cbca4-b781-41b1-9edb-8bf4d071a75e"],

Cell["\<\
On the ladder of two squares, with the squares filled, the two paths round \
the ladder are homotopic. The greedy descent stalls at once, since every move \
keeps a vertex at distance 1 from the other path:\
\>", "ExampleText",ExpressionUUID->"56dc9657-e55a-4d6e-b130-dcd9fc62c3bf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "6", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", " ", "<->", " ", "2"}], ",", " ", 
         RowBox[{"2", " ", "<->", " ", "3"}], ",", " ", 
         RowBox[{"4", " ", "<->", " ", "5"}], ",", " ", 
         RowBox[{"5", " ", "<->", " ", "6"}], ",", " ", 
         RowBox[{"1", " ", "<->", " ", "4"}], ",", " ", 
         RowBox[{"2", " ", "<->", " ", "5"}], ",", " ", 
         RowBox[{"3", " ", "<->", " ", "6"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"HomotopicQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "6"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "4", ",", " ", "5", ",", " ", "6"}], "}"}], ",",
        " ", 
       RowBox[{"\"\<NullHomotopicCycles\>\"", " ", "->", " ", "4"}], ",", " ", 
       RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Exhaustive\>\"", ",", " ", "\"\<Greedy\>\""}], "}"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"edbf8fb1-19b4-4449-861f-6a3391c35ad7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"4f361453-8b06-4ab8-82f5-2d79ac1b7596"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

