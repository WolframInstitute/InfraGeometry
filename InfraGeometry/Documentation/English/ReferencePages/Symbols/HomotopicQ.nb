Cell["\<\
Two walks are homotopic when a chain of elementary moves turns one into the \
other:\
\>", "Notes",ExpressionUUID->"6af18fd1-4ba4-4603-90ff-3fb7031fd558"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f586db06-157c-4c7c-b517-d51250c05d87"], Cell["Move", "TableText",
     FontWeight->Bold,ExpressionUUID->"895ee7e0-17b1-4e6e-a45f-4ca5afe2ce7c"],
     Cell["Change", "TableText",
     FontWeight->Bold,ExpressionUUID->"7965c1e7-63a1-480c-b429-94b302a3f9a5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f4b938de-d229-4df2-9717-44b05db74444"], Cell[
    "stutter", "TableText",ExpressionUUID->
     "a4b0d282-1027-4bda-807e-ca4413d6e257"], Cell[TextData[{
     "insert or delete a repeated vertex: ",
     StyleBox["\[Ellipsis] u \[Ellipsis]", "TI"],
     " \[LeftRightArrow] ",
     StyleBox["\[Ellipsis] u u \[Ellipsis]", "TI"]
    }], "TableText",ExpressionUUID->"ba9083c1-d67e-4f47-8c0c-0244d77a8c80"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5346d6f0-eb89-4ea9-8a68-c4ee3e906317"], Cell[
    "backtrack", "TableText",ExpressionUUID->
     "39f0f0b2-5819-4183-ac3f-bd33bfcbc018"], Cell[TextData[{
     "insert or delete a step out and back: ",
     StyleBox["\[Ellipsis] u \[Ellipsis]", "TI"],
     " \[LeftRightArrow] ",
     StyleBox["\[Ellipsis] u v u \[Ellipsis]", "TI"]
    }], "TableText",ExpressionUUID->"cca7d7f4-92a4-46b4-8490-6b347a940a31"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a5c21b2c-9534-4804-b503-a36cebfe42e1"], Cell[
    "face", "TableText",ExpressionUUID->
     "89f17ba0-41f1-4169-b42a-dbe63cb2ccc8"], Cell[
    "replace an arc of a filled cycle by the rest of that cycle", "TableText",
     ExpressionUUID->"6e09f9c3-8fb6-4d9f-bb61-51086c9500a1"]}
  }]], "2ColumnTableMod",ExpressionUUID->"1e381c42-78f5-4140-8c39-\
efb32768a5e1"],

Cell["\<\
An open walk keeps its endpoints fixed; a closed walk keeps its base point. \
Both walks must be open or both closed. A vertex list is an open walk, a \
cycle graph a closed one.\
\>", "Notes",ExpressionUUID->"b7b24c7d-f6e7-49ba-a91a-c7895d8d8134"],

Cell[TextData[{
 "By default the filled cycles are the triangles. The square mesh is \
triangulated, and two paths that bound a pair of its triangles are homotopic. \
The square grid has no triangles: every square is a hole, and two sides of a \
square are not homotopic until ",
 Cell[BoxData[
  RowBox[{"\"\<NullHomotopicCycles\>\"", " ", "->", " ", "4"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ecf9e6c-d493-4905-975c-3508382f7b12"],
 " fills the squares."
}], "Notes",ExpressionUUID->"1205155f-7ebe-4b2e-9d81-0f4537a9aeea"],

Cell[TextData[{
 "A family of walks, such as a list of walk graphs, gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a60846ef-ffa4-4bb0-8721-11eb0c281374"],
 " when every pair from the two families is homotopic."
}], "Notes",ExpressionUUID->"75d4c604-bab2-4043-bc91-a0aadfa72bea"],

