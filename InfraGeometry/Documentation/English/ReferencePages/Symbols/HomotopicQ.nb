Cell[TextData[{
 "Finding a move chain certifies ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90937d77-3fd6-447b-839b-1fb3b42866ca"],
 ". A failed bounded search or stalled greedy descent does not certify ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd0892d2-1d35-4724-af39-a01722378f94"],
 "; the original predicate remains unevaluated. ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "89870d76-78ef-4166-81b9-a00eb430c976"],
 " requires an exact obstruction, such as incompatible fixed endpoints or \
unequal reduced words in the face-free relation. The search limits control \
computation, not the homotopy relation."
}], "Notes",ExpressionUUID->"78e861e8-79bb-43f2-9540-b44c5a00087e"]
}, Open  ]],

