Cell["\<\
Two walks are homotopic when a chain of elementary moves turns one into the \
other:\
\>", "Notes",ExpressionUUID->"19b02f53-fe4e-4709-a82b-e3669f712f89"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0bb605f0-2e00-4f4f-9c5f-bfaaf50e5570"], Cell["Move", "TableText",
     FontWeight->Bold,ExpressionUUID->"85ed8696-c074-4581-84a8-df23930e5363"],
     Cell["Change", "TableText",
     FontWeight->Bold,ExpressionUUID->"60a045bd-7957-44ae-962b-29c42ee3c17d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5190e3dd-7615-4a6d-a8c9-67c1f83a8d94"], Cell[
    "stutter", "TableText",ExpressionUUID->
     "50444a80-69aa-4491-b354-0ac5d6d2134f"], Cell[TextData[{
     "insert or delete a repeated vertex: ",
     StyleBox["\[Ellipsis] u \[Ellipsis]", "TI"],
     " \[LeftRightArrow] ",
     StyleBox["\[Ellipsis] u u \[Ellipsis]", "TI"]
    }], "TableText",ExpressionUUID->"e16c54d7-ac7a-47e9-beab-2f1fba4e4414"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "22064916-781f-43d9-947a-d0eec5407fa7"], Cell[
    "backtrack", "TableText",ExpressionUUID->
     "cd179d27-5d99-4e2a-ba3d-d0bb3f395e4c"], Cell[TextData[{
     "insert or delete a step out and back: ",
     StyleBox["\[Ellipsis] u \[Ellipsis]", "TI"],
     " \[LeftRightArrow] ",
     StyleBox["\[Ellipsis] u v u \[Ellipsis]", "TI"]
    }], "TableText",ExpressionUUID->"d7965def-00ff-4584-9d69-cdeabb840784"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d0dc8849-2c91-4b6b-a213-42c58a1cee78"], Cell[
    "face", "TableText",ExpressionUUID->
     "5afbee96-1c8f-4e8d-a429-0619e18e339d"], Cell[
    "replace an arc of a filled cycle by the rest of that cycle", "TableText",
     ExpressionUUID->"f4d58622-20c7-410d-bc4c-68504e6ce2f6"]}
  }]], "2ColumnTableMod",ExpressionUUID->"c97b4565-0cb5-4545-8173-\
97715f22aac3"],

Cell["\<\
An open walk keeps its endpoints fixed; a closed walk keeps its base point. \
Both walks must be open or both closed. A vertex list is an open walk, a \
cycle graph a closed one.\
\>", "Notes",ExpressionUUID->"25c1e14d-5d12-4445-97f2-34c0caee15a0"],

Cell[TextData[{
 "By default the filled cycles are the triangles. The square mesh is \
triangulated, and two paths that bound a pair of its triangles are homotopic. \
The square grid has no triangles: every square is a hole, and two sides of a \
square are not homotopic until ",
 Cell[BoxData[
  RowBox[{"\"\<NullHomotopicCycles\>\"", " ", "->", " ", "4"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bcaceacd-1ebb-494e-9586-2e9c74e0a5ba"],
 " fills the squares."
}], "Notes",ExpressionUUID->"6bda31a9-47c2-4f24-8eb8-b3aaf02c2897"],

Cell[TextData[{
 "A family of walks, such as a list of walk graphs, gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d9b74f6-34af-4d4b-a7e0-eeabb1f44b8b"],
 " when every pair from the two families is homotopic."
}], "Notes",ExpressionUUID->"37e8c08a-af2f-4281-8361-9ce171c65b55"],

