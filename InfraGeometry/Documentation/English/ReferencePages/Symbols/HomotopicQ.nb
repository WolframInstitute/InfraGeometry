Cell[TextData[{
 "The search is breadth first over all walks up to ",
 Cell[BoxData["\"\<MaxLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9a38162-eb4c-4181-8a96-71c6228b0a0b"],
