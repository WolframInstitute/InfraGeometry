 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d33ff949-ab8d-41fc-9032-69be99bf915d"],
 " means no chain within that length."
}], "Notes",ExpressionUUID->"3ba1e773-9935-452f-a0a9-6f144edee5c3"]
