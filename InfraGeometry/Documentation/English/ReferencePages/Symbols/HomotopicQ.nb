Cell[CellGroupData[{
Cell["HomotopicQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"96dd7f0b-d83d-45d7-94bf-963a86021e4d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HomotopicQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/HomotopicQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e113fe45-c72e-49cc-9668-f3a6fd2b274f"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "722a337c-2c6e-44da-bc5e-e4a39f5c273c"],
 " when homotopy of the walks ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " is certified, ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "901eff78-e3e9-4df4-aa51-ff9b20b864a4"],
 " when non-homotopy is certified, and remains unevaluated when undecided.",
 "\n"
}], "Usage",ExpressionUUID->"a3027005-ffe4-48cf-805e-53e197c9f2ad"],

Cell["\<\
Two walks are homotopic when a chain of elementary moves turns one into the \
other:\
\>", "Notes",ExpressionUUID->"45f3bcf2-1e85-4ace-8de8-4c9c15b3a181"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "cbb75d8f-20ed-41ee-803e-661f1723e7af"], Cell["Move", "TableText",
     FontWeight->Bold,ExpressionUUID->"43763061-ea2a-44cc-a355-aa83ab02c012"],
     Cell["Change", "TableText",
     FontWeight->Bold,ExpressionUUID->"434b508b-5521-4142-845f-4023a74ee16b"]},
