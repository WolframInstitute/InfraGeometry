Cell[CellGroupData[{

Cell["FreeHomotopy", "ExampleSubsection",ExpressionUUID->"2ef599eb-002c-4614-bfbb-cd0b8e9c43c8"],

Cell["\<\
With free endpoints every two walks of a connected graph are homotopic, as \
two paths in the plane are:\
\>", "ExampleText",ExpressionUUID->"480fa8d0-fb82-4a3b-ae95-6a50af2eb3a9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"HomotopicQ", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"First", " ", "@", " ", "members"}], ",", " ", 
     RowBox[{"Last", " ", "@", " ", "members"}], ",", " ", 
     RowBox[{"\"\<FreeHomotopy\>\"", " ", "->", " ", "True"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6f4f8018-88b9-4061-bc72-2a063fb15946"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"31e04532-8645-4645-83f8-28d89cd6cc8c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Method", "ExampleSubsection",ExpressionUUID->"fda64404-c8ce-4136-aa7c-0567929b0199"],

Cell[TextData[{
 "Compare the methods on two paths around a ladder whose squares are filled. \
A heuristic may fail to find a witness. An unresolved predicate is displayed \
as ",
 Cell[BoxData["\"\<Undecided\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "287f1f3c-032b-449d-b03c-211a60c0e825"],
 ":"
}], "ExampleText",ExpressionUUID->"279903f1-bffd-4cc9-9a34-ad78f84df4ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "6", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", " ", "<->", " ", "2"}], ",", " ", 
         RowBox[{"2", " ", "<->", " ", "3"}], ",", " ", 
         RowBox[{"4", " ", "<->", " ", "5"}], ",", " ", 
         RowBox[{"5", " ", "<->", " ", "6"}], ",", " ", 
         RowBox[{"1", " ", "<->", " ", "4"}], ",", " ", 
         RowBox[{"2", " ", "<->", " ", "5"}], ",", " ", 
         RowBox[{"3", " ", "<->", " ", "6"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Replace", "[", 
      RowBox[{
       RowBox[{"HomotopicQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "6"}], "}"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "4", ",", " ", "5", ",", " ", "6"}], "}"}], ",",
          " ", 
         RowBox[{"\"\<NullHomotopicCycles\>\"", " ", "->", " ", "4"}], ",", 
         " ", 
         RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", "\n", "    ", 
       
       RowBox[{"_HomotopicQ", " ", "->", " ", "\"\<Undecided\>\""}]}], "]"}], 
     ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Exhaustive\>\"", ",", " ", "\"\<Greedy\>\""}], "}"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cb212599-59df-44f5-89c7-834ee7a3deda"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ba6280fc-c133-4267-a90a-332ef5229e9f"]
