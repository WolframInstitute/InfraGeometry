Cell["\<\
The zeros are the centre, the ones the periphery, and the values are the \
eccentricities rescaled to the interval from 0 to 1:\
\>", "ExampleText",ExpressionUUID->"a1d622e6-6027-4632-8025-016dc1ffce21"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"RelativeEccentricity", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Pick", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "t", ",", " ", "0"}],
        "]"}], " ", "===", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Pick", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "t", ",", " ", 
         "1"}], "]"}]}], " ", "===", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"GraphPeriphery", "[", "g", "]"}]}]}], ",", "\n", "   ", 
     RowBox[{"t", " ", "==", " ", 
      RowBox[{"Rescale", "[", 
       RowBox[{"GraphEccentricities", "[", "g", "]"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cf9a352d-6c51-4d17-80a9-4f24edbdaf17"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"abaff664-4e3c-47c8-a0b8-6d191b4fd1b3"]
}, Open  ]],

Cell[TextData[{
 "On the square grid the relative eccentricity is the distance to the centre \
divided by ",
 StyleBox["D \[Minus] r", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"cb36a89e-6d49-4b34-b928-8f0ad9c3c67b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"ctr", " ", "=", " ", 
     RowBox[{"GraphCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", " ", "=", " ", 
      RowBox[{"GraphRadius", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"d", " ", "=", " ", 
      RowBox[{"GraphDiameter", "[", "g", "]"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"depth", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "v", ",", " ", "#"}], "]"}], " ", "&"}], 
         " ", "/@", " ", "ctr"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"v", ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"RelativeEccentricity", "[", "g", "]"}], " ", "==", " ", 
      RowBox[{"depth", "/", 
       RowBox[{"(", 
        RowBox[{"d", " ", "-", " ", "r"}], ")"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "d"}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e95e1e2e-a0ca-4f85-ba17-4375c2f33b96"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"{", 
    RowBox[{"9", ",", "16"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"e7c34892-e0a7-4884-96cb-e40958658075"]
}, Open  ]]
}, Open  ]],

