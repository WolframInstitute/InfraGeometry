Cell["A distance matrix gives the same values as its graph:", "ExampleText",ExpressionUUID->"cf58ee83-3ae1-44ce-86e8-1d313e84c36c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"PathGraph", "[", 
      RowBox[{"Range", "[", "5", "]"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"RelativeEccentricity", "[", "g", "]"}], ",", " ", 
     RowBox[{"RelativeEccentricity", "[", 
      RowBox[{"GraphDistanceMatrix", "[", "g", "]"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"38ac0799-f6e3-4484-a9d6-4712b78161a5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", 
     FractionBox["1", "2"], ",", "0", ",", 
     FractionBox["1", "2"], ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     FractionBox["1", "2"], ",", "0", ",", 
     FractionBox["1", "2"], ",", "1"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f2c7e97e-bbe4-4ef7-905d-24fd4656fb82"]
}, Open  ]]
}, Open  ]],

