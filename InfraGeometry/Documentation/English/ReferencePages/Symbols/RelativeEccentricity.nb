     "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
    "1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6", ",", "7", ",", 
     "8"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1512fd3e-55b9-4502-af96-b530a6919db4"]
}, Open  ]],

Cell["On a disconnected graph every value is 0:", "ExampleText",ExpressionUUID->"f49f806a-3af7-4277-9677-886fa028b282"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RelativeEccentricity", "[", 
