Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"28003677-893b-4b99-9f51-fa2b711e26cf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RelativeEccentricity"]], 
