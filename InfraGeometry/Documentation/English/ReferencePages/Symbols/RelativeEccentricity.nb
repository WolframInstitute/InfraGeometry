Cell["\<\
On a vertex-transitive graph every vertex is both centre and periphery, and \
the value is 0, not 1:\
\>", "ExampleText",ExpressionUUID->"d2bb088e-a2ac-4b72-b120-a82267c2c676"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"RelativeEccentricity", "[", 
    RowBox[{"CycleGraph", "[", "8", "]"}], "]"}], ",", " ", 
   RowBox[{"GraphPeriphery", "[", 
    RowBox[{"CycleGraph", "[", "8", "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"382513cc-9af3-4063-b2c0-39801f9b364f"],

