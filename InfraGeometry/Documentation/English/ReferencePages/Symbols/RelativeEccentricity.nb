Cell["\<\
The relative eccentricity on the square, hexagonal and triangular tilings, \
blue at 0 and red at 1, and the number of its values. On a tiling it is the \
distance from the centre divided by the radius.\
\>", "ExampleText",ExpressionUUID->"83169d6c-3f49-4f26-8f2e-17ddbd765f8e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"panels", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "       ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
             RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
            "]"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{"depths", " ", "=", " ", 
           RowBox[{"RelativeEccentricity", "[", "g", "]"}]}], "}"}], ",", 
         "\n", "       ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraSubstrateHighlight", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#1", " ", "->", " ", 
                 RowBox[{"Blend", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"StandardBlue", ",", " ", "StandardRed"}], "}"}], 
                   ",", " ", "#2"}], "]"}]}], " ", "&"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "depths"}], 
                "}"}]}], "]"}]}], "]"}], ",", " ", 
           RowBox[{"CountDistinct", "[", "depths", "]"}]}], "}"}]}], "]"}], ",",
        "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
           " ", "\"\<HexagonalTilingGraph\>\"", ",", 
           " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"First", " ", "/@", " ", "panels"}], "]"}], ",", " ", 
     RowBox[{"Last", " ", "/@", " ", "panels"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"25db73a8-4313-4282-a2cd-7a375be71267"],

