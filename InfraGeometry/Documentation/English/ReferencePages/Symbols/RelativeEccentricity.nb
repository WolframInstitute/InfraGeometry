Cell[TextData[{
 "The relative eccentricity is the eccentricity rescaled to the interval from \
0 to 1. Its zeros are the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphCenter"]], "paclet:ref/GraphCenter"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e179e5f4-682c-4694-8e58-567ff51a345b"],
 " and its ones the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphPeriphery"]], "paclet:ref/GraphPeriphery"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dc3f1a38-df63-4a00-8b5f-e97ef147dc10"],
 "."
}], "ExampleText",ExpressionUUID->"6673a1f9-aab4-445d-b010-1a1c532563f5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"depths", " ", "=", " ", 
     RowBox[{"RelativeEccentricity", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Pick", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "depths", ",", 
            " ", "0"}], "]"}], " ", "->", " ", "StandardBlue"}], ",", " ", 
         RowBox[{
          RowBox[{"Pick", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "depths", ",", 
            " ", "1"}], "]"}], " ", "->", " ", "StandardRed"}]}], "}"}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"depths", " ", "==", " ", 
      RowBox[{"Rescale", "[", 
       RowBox[{"GraphEccentricities", "[", "g", "]"}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Pick", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "depths", ",", " ", 
        "0"}], "]"}], " ", "===", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"Pick", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "depths", ",", " ", 
         "1"}], "]"}], "]"}], " ", "===", " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"GraphPeriphery", "[", "g", "]"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"37c40f06-fd5d-4565-afbb-6fcaf0a244ca"],

