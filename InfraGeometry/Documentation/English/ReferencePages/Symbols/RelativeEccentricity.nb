  FontSize->0.9 Inherited,ExpressionUUID->
  "be4235a3-44f0-476f-87de-8d716dd7a2db"],
 "\[LineSeparator]",
 "gives (",
 StyleBox["e", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") \[Minus] ",
 StyleBox["r", "TI"],
 ")/(",
 StyleBox["D", "TI"],
 " \[Minus] ",
 StyleBox["r", "TI"],
 ") for every vertex ",
 StyleBox["v", "TI"],
 " of ",
 StyleBox["g", "TI"],
 ", in the order of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VertexList"]], "paclet:ref/VertexList"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "06ae8676-f212-4ffe-83d5-03458cc90753"],
 ": 0 on the centre and 1 on the periphery.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4d7ab3f3-8c44-46ae-acec-569043c04b08"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
