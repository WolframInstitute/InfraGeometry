  FontSize->0.9 Inherited,ExpressionUUID->
  "61feeef1-363b-4f55-88c6-b88f61b5a54c"],
 "\[LineSeparator]",
 "gives (",
 StyleBox["e", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") \[Minus] ",
 StyleBox["r", "TI"],
 ")/(",
 StyleBox["D", "TI"],
 " \[Minus] ",
 StyleBox["r", "TI"],
 ") for every vertex ",
 StyleBox["v", "TI"],
 " of ",
 StyleBox["g", "TI"],
 ", in the order of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VertexList"]], "paclet:ref/VertexList"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fd362ac8-5389-4e28-8216-0b630f47dc52"],
 ": 0 on the centre and 1 on the periphery.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6b0310a3-2724-4b0d-98b8-6614c0ac7694"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
