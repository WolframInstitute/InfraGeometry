Cell["\<\
The relative eccentricity on the square, hexagonal and triangular tilings, \
blue at 0 and red at 1, and the number of its values. On a tiling it is the \
distance from the centre divided by the radius.\
\>", "ExampleText",ExpressionUUID->"cd91c738-45f1-45b7-8b9d-45bd0d0664e6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"panels", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "       ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
             RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
            "]"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{"depths", " ", "=", " ", 
           RowBox[{"RelativeEccentricity", "[", "g", "]"}]}], "}"}], ",", 
         "\n", "       ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraSubstrateHighlight", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#1", " ", "->", " ", 
                 RowBox[{"Blend", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"StandardBlue", ",", " ", "StandardRed"}], "}"}], 
                   ",", " ", "#2"}], "]"}]}], " ", "&"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "depths"}], 
                "}"}]}], "]"}]}], "]"}], ",", " ", 
           RowBox[{"CountDistinct", "[", "depths", "]"}]}], "}"}]}], "]"}], ",",
        "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
           " ", "\"\<HexagonalTilingGraph\>\"", ",", 
           " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"First", " ", "/@", " ", "panels"}], "]"}], ",", " ", 
     RowBox[{"Last", " ", "/@", " ", "panels"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e4cd04d4-7bac-40cf-9ee0-c36b6fa89279"],

