}], "Usage",ExpressionUUID->"6bef4f05-d6d9-42fb-b532-a7c345f2811e"],

Cell[TextData[{
 "Definition: with ",
 StyleBox["e", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") the eccentricity of ",
 StyleBox["v", "TI"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphEccentricities"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/GraphEccentricities", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6e13550a-cb4a-4e16-b662-30c6ef23db6c"],
 ", ",
 StyleBox["r", "TI"],
 " the radius and ",
 StyleBox["D", "TI"],
 " the diameter of ",
 StyleBox["g", "TI"],
 ", the relative eccentricity is ",
 StyleBox["t", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = (",
 StyleBox["e", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") \[Minus] ",
 StyleBox["r", "TI"],
 ")/(",
 StyleBox["D", "TI"],
 " \[Minus] ",
 StyleBox["r", "TI"],
 "). It runs from 0 exactly on the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphCenter"]], "paclet:ref/GraphCenter"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1d96d12d-f2be-427f-b24f-f9dfe88dde48"],
 " to 1 exactly on the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphPeriphery"]], "paclet:ref/GraphPeriphery"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6000d784-9daa-497e-b6a1-6798a589522f"],
 "."
}], "Notes",ExpressionUUID->"767e8476-7c56-4a5e-bd94-d8af2b2ba75c"],

Cell[TextData[{
 "On a graph the eccentricity is an integer, so ",
 StyleBox["t", "TI"],
 " takes at most ",
 StyleBox["D", "TI"],
 " \[Minus] ",
 StyleBox["r", "TI"],
 " + 1 values, 0, 1/(",
 StyleBox["D", "TI"],
 " \[Minus] ",
 StyleBox["r", "TI"],
 "), \[Ellipsis], 1. The sets {",
 StyleBox["t", "TI"],
 " \[LessEqual] ",
 StyleBox["q", "TI"],
 "} are nested, and each holds the centre."
}], "Notes",ExpressionUUID->"85a210cf-af48-40ca-b772-6fc02629b348"],

Cell[TextData[{
 "When ",
 StyleBox["D", "TI"],
 " = ",
 StyleBox["r", "TI"],
 ", as on a vertex-transitive graph, and on a graph with several components, \
every value is 0."
}], "Notes",ExpressionUUID->"00ff2f86-83c4-4dba-9931-0c5b88f0908a"]
}, Open  ]],

