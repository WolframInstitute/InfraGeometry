Cell["RelativeEccentricity", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e0d87bc2-5315-42cb-959b-1d40b396843c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RelativeEccentricity"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RelativeEccentricity", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2407fd83-92f2-482c-b7c3-527c2d464ad6"],
 "\[LineSeparator]",
 "gives the list of the relative eccentricities ",
 StyleBox["(e(v) \[Minus] r)/(D \[Minus] r)", "TI"],
 " of the vertices ",
 StyleBox["v", "TI"],
 " of ",
 StyleBox["g", "TI"],
 ", in the order of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VertexList"]], "paclet:ref/VertexList"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ddee598e-92e8-41aa-b782-46f117466ab8"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f66f6939-15be-4a79-bb07-a8b568453c83"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RelativeEccentricity"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RelativeEccentricity", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["m", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02897619-f0ef-4b97-aad2-8f8142b07a92"],
 "\[LineSeparator]",
 "gives the relative eccentricities of the points of the distance matrix ",
 StyleBox["m", "TI"],
 "."
}], "Usage",ExpressionUUID->"aad066b1-d79f-4910-b800-831b85c0ea85"],

Cell[TextData[{
 "With ",
 StyleBox["e(v)", "TI"],
 " the eccentricity of ",
 StyleBox["v", "TI"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphEccentricities"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/GraphEccentricities", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6b12039b-46a6-404b-9572-59992b45a941"],
 ", ",
 StyleBox["r", "TI"],
 " the radius and ",
 StyleBox["D", "TI"],
 " the diameter, the relative eccentricity is ",
 StyleBox["t(v) = (e(v) \[Minus] r)/(D \[Minus] r)", "TI"],
 ". It is 0 exactly on the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphCenter"]], "paclet:ref/GraphCenter"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1d002c41-47e7-44a2-a87d-626c6104b310"],
 " and 1 exactly on the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphPeriphery"]], "paclet:ref/GraphPeriphery"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "65f9c96a-bc3d-403a-a91c-384dfc2c7f0f"],
 "."
}], "Notes",ExpressionUUID->"e3ebd492-248e-46fb-875b-1bee7def0536"],

Cell[TextData[{
 "The eccentricity is an integer, so ",
 StyleBox["t", "TI"],
 " takes at most ",
 StyleBox["D \[Minus] r + 1", "TI"],
 " values: 0, 1/(",
 StyleBox["D \[Minus] r", "TI"],
 "), \[Ellipsis], 1."
}], "Notes",ExpressionUUID->"68599cdf-08b2-42d9-83af-8b7e7ab54fd9"],

Cell[TextData[{
 "On the square grid ",
 StyleBox["e(v) = r + d(v, C)", "TI"],
 ", with ",
 StyleBox["C", "TI"],
 " the centre, so ",
 StyleBox["t(v) = d(v, C)/(D \[Minus] r)", "TI"],
 " and the level sets of ",
 StyleBox["t", "TI"],
 " are the rings about the centre."
}], "Notes",ExpressionUUID->"c0949aaa-8dc6-498f-9dbf-d03cefbe9277"],

Cell[TextData[{
 "When ",
 StyleBox["D = r", "TI"],
 ", as on a vertex-transitive graph, and on a disconnected graph, every value \
is 0."
}], "Notes",ExpressionUUID->"1be17e67-1d5b-43a3-b4e6-bd9370298bcd"]
}, Open  ]],

