Cell[TextData[{
 "The relative eccentricity is the eccentricity rescaled to the interval from \
0 to 1. Its zeros are the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphCenter"]], "paclet:ref/GraphCenter"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c7abb6b1-f7e9-4bb8-96b8-e3818113c438"],
 " and its ones the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphPeriphery"]], "paclet:ref/GraphPeriphery"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b3ac17bc-b904-4a5b-83b3-612326ff44be"],
 "."
}], "ExampleText",ExpressionUUID->"09ba5e6f-c724-47a1-88eb-71440c4ee64a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"depths", " ", "=", " ", 
     RowBox[{"RelativeEccentricity", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Pick", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "depths", ",", 
            " ", "0"}], "]"}], " ", "->", " ", "StandardBlue"}], ",", " ", 
         RowBox[{
          RowBox[{"Pick", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "depths", ",", 
            " ", "1"}], "]"}], " ", "->", " ", "StandardRed"}]}], "}"}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"depths", " ", "==", " ", 
      RowBox[{"Rescale", "[", 
       RowBox[{"GraphEccentricities", "[", "g", "]"}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Pick", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "depths", ",", " ", 
        "0"}], "]"}], " ", "===", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"Pick", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "depths", ",", " ", 
         "1"}], "]"}], "]"}], " ", "===", " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"GraphPeriphery", "[", "g", "]"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"725ee90c-67e7-44e5-a07d-70105f86d567"],

