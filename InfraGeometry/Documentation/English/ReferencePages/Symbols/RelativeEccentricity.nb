Cell["\<\
The level sets follow the shape of the graph: on a 16 \[Times] 6 grid they \
are bands across it, rising from its middle toward both ends, and on the \
irregular discretized plane they are rings about its middle.\
\>", "ExampleText",ExpressionUUID->"98b7270b-fea3-4435-b6fe-b412e42a12d9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"InfraSubstrateHighlight", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", " ", "->", " ", 
          RowBox[{"Blend", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"StandardBlue", ",", " ", "StandardRed"}], "}"}], ",", 
            " ", "#2"}], "]"}]}], " ", "&"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"RelativeEccentricity", "[", "g", "]"}]}], "}"}]}], "]"}]}],
      "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
