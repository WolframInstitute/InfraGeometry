Notebook[{

Cell[CellGroupData[{
Cell["FindInfraDeformation", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"95e1aa59-8d0b-4187-a6c9-47546ffe81fe"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraDeformation"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraDeformation", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["family", "TI"], ",", " ", 
    StyleBox["target", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6210348-e960-4089-9c1d-4429f99c11ba"],
 "\[LineSeparator]",
 "finds a certified chain of simple vertex-list paths from the reference of \
",
 StyleBox["family", "TI"],
 " to ",
 StyleBox["target", "TI"],
 " using elementary filled-face moves.",
 "\n"
}], "Usage",ExpressionUUID->"4ce9fc86-4e2a-4925-88c3-a1dabe46cdd6"],

Cell[TextData[{
 StyleBox["family", "TI"],
 " is an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDeformation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDeformation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4cb75833-b029-4dde-bfaf-1fb7501268b3"],
 " object, and ",
 StyleBox["target", "TI"],
 " must be one of its members. The result is a list of vertex lists, starting \
at the reference and ending at the target. Consecutive paths differ by a move \
across a declared face."
}], "Notes",ExpressionUUID->"4d2dd117-5f01-4cc6-b290-28eb9982b447"],

Cell[TextData[{
 "Every intermediate path is checked to be simple, to retain the ordered \
endpoints, to stay within the reference tube, and to have excess at most the \
upper excess bound. The number of moves is checked against ",
 Cell[BoxData["\"\<MaxMoves\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d376673-1793-4ce1-9006-d4fd2a0dc74f"],
 "."
}], "Notes",ExpressionUUID->"25c70447-ff1d-46fb-a7d3-645ff19c0c1a"],

Cell[TextData[{
 "The requested lower excess bound applies to the target. Intermediate paths \
may have smaller excess, including the reference at excess 0. Thus a family \
with exact target excess ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37689078-f753-4bec-92f7-d337f493f9e2"],
 " can still have a certificate beginning at the reference."
}], "Notes",ExpressionUUID->"2861470b-3354-4e38-accb-106c721f9046"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b8666746-31c9-4bce-b9ff-2280e8de8213"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"1d88b28c-f13f-4836-a31b-2c0d735f69bb"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"bb69c128-7e9f-4029-b5e3-ffe2f5ce9d4a"],
     Cell["Meaning", "TableText",
     FontWeight->Bold,ExpressionUUID->"5349f285-d791-403e-bc2f-0f0272bbc2d8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "21686200-54c0-47a9-a3a3-b4e1c3dc4a42"], Cell[TextData[Cell[
    BoxData["\"\<NullHomotopicCycles\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f6a5c307-6137-4676-9cd1-6ab84ebc9c88"]], "TableText",ExpressionUUID->
     "d63f524d-a4c1-4f1c-b1b6-9ad720566709"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "4"}], "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "20dac983-d662-4ad5-81b5-aa4fb7d315e2"]], "TableText",ExpressionUUID->
     "253622ab-e0d7-4492-b6fc-3dca2926f658"], Cell["\<\
lengths of filled cycles, each at least 3, or an explicit list of simple \
cyclic vertex lists\
\>", "TableText",ExpressionUUID->"0f1f54aa-1342-4db1-89bb-0cc8e7daae10"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ebd13e41-51a8-4fe9-9381-ce86cb611d4a"], Cell[TextData[Cell[
    BoxData["\"\<MaxMoves\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b6c0109f-7460-43ce-8c46-562b966ce9d8"]], "TableText",ExpressionUUID->
     "794cc7ae-5e9f-4bc7-932a-67ddcc3bbee3"], Cell[TextData[Cell[BoxData[
    "Infinity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d3bc188e-dc9b-4b41-9434-7dce07e7cc19"]], "TableText",ExpressionUUID->
     "922d8e89-b54d-474d-91f8-614b2ee3b41f"], Cell[TextData[{
     "nonnegative integer bound on the number of elementary moves, or ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "337f6032-d899-45b0-9765-f567040dd2da"]
    }], "TableText",ExpressionUUID->"051492b3-1cc6-417f-bef3-2a90919f3e68"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "558249c9-7086-48aa-bffe-a1c767f7e938"], Cell[TextData[Cell[
    BoxData["\"\<MaxStates\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "cca198f5-a75b-45e1-b0d8-5788017fec5e"]], "TableText",ExpressionUUID->
     "f58d2b26-48d7-444b-b209-3d308060264d"], Cell[TextData[Cell[BoxData[
    "1000"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9678f658-e0a4-4d3d-bfdf-893980d9fefa"]], "TableText",ExpressionUUID->
     "4644fbd5-be51-445d-a3a9-f01b03924181"], Cell[
    "positive integer bound on the certificate search states", "TableText",
     ExpressionUUID->"796672cb-1851-4a22-af46-839154b26847"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b84f481d-239a-43ff-a74f-039042479e73"], Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["Method"]], "paclet:ref/Method"},
      "RefLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "ccf13ccc-0d6a-4721-a2de-5dab45372548"]], "TableText",ExpressionUUID->
     "581a6135-669c-4ddf-aa07-740ba533489d"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5969c5fe-781e-42cf-9546-bf47102648b8"]], "TableText",ExpressionUUID->
     "10262f51-8db7-4c40-8b2a-01d939bf77e6"], Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f5deb1f5-835f-4464-ad4a-048ffd8bb155"],
     " or ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9fa16aeb-bdd5-4af4-b68d-e639c59327b5"]
    }], "TableText",ExpressionUUID->"2a77fefd-3a78-47b4-b888-e89a7165142b"]}
  }]], "3ColumnTableMod",ExpressionUUID->"c51aaebc-ec8f-41c9-aa1d-\
6bc62fb4aea9"],

Cell[TextData[{
 "The face option is a list; for example, ",
 Cell[BoxData[
  RowBox[{"{", "4", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4693fe2-05be-4a86-bb08-551ae4e27993"],
 " permits square moves. An explicit face lists its vertices cyclically \
without repeating the first vertex at the end. The faces used by the search \
lie inside the tube."
}], "Notes",ExpressionUUID->"bf27d0ed-89c5-42e8-8779-9150cab08d64"],

Cell[TextData[{
 "The search calls ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraHomotopy"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraHomotopy", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "60266aa0-6755-4752-b726-f9069bd50ce6"],
 " and validates the resulting chain. It is incomplete: a failed search, a \
reached search limit, or a proposed chain that violates an intermediate-path \
constraint leaves the original call unevaluated. This does not establish that \
no admissible chain exists. A target outside the family also leaves the call \
unevaluated."
}], "Notes",ExpressionUUID->"e600512c-af5a-4c15-9e78-bb9b5df23c78"],

Cell[TextData[{
 "The family's ",
 Cell[BoxData["\"\<MaxStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "83670211-9261-480a-8e1b-d873f0d0ed47"],
 " bounds construction of its counting graph. The finder's separate ",
 Cell[BoxData["\"\<MaxStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "021bf03a-a430-4b9c-b08a-56e5824f1c50"],
 " bounds the certificate search. Finding a certificate does not require \
enumerating the whole nearby-path family."
}], "Notes",ExpressionUUID->"d47825fe-7033-4d11-b40e-2ac48fece9d8"]
}, Open  ]],

