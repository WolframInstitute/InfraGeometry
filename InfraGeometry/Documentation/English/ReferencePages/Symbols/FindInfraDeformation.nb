\>", "ExampleText",ExpressionUUID->"031c8ff3-a2b5-4788-a7d3-4e0b31cba485"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "4", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Replace", "[", 
    RowBox[{
     RowBox[{"FindInfraDeformation", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraDeformation", "[", 
        RowBox[{
         RowBox[{"{", 
