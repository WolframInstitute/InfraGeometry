         RowBox[{"UpTo", "[", "2", "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "4", ",", " ", "3", ",", " ", "2"}], "}"}], ",",
        " ", 
       RowBox[{"\"\<MaxMoves\>\"", " ", "->", " ", "0"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"_FindInfraDeformation", " ", "->", " ", "\"\<Undecided\>\""}]}],
     "]"}]}], "]"}]}], "Input",
