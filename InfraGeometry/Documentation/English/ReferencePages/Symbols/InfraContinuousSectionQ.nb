Cell["Switching sheets across a base edge breaks continuity.", "ExampleText",ExpressionUUID->"04ad9443-55e1-4afb-920e-31022f412a6d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"Graph", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{"1", ",", " ", "3"}], "]"}], ",", " ", 
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{"2", ",", " ", "4"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<a\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<a\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<b\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<b\>\""}]}], "|>"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"section", " ", "=", " ", 
     RowBox[{"InfraSection", "[", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<a\>\"", " ", "->", " ", "1"}], ",", " ", 
        RowBox[{"\"\<b\>\"", " ", "->", " ", "4"}]}], "|>"}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", 
      RowBox[{"fib", ",", " ", "section"}], "]"}], ",", " ", 
     RowBox[{"InfraSectionQ", "[", 
      RowBox[{"fib", ",", " ", "section"}], "]"}], ",", " ", 
     RowBox[{"InfraContinuousSectionQ", "[", 
      RowBox[{"fib", ",", " ", "section"}], "]"}]}], "}"}]}], "]"}]}], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"b0913696-c255-4cf6-8bec-03e45b5e136d"],

