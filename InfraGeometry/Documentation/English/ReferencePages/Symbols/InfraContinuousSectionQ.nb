Cell["\<\
The up field on the grid is continuous: its values, with the total edges \
between them, form a copy of the base under it.\
\>", "ExampleText",ExpressionUUID->"4aff30b6-0b4e-411f-97ad-ec19d7983ba7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridDisplacementBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"up", " ", "=", " ", 
     RowBox[{"InfraSection", " ", "@", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{"p", " ", "|->", " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", 
           RowBox[{"p", " ", "+", " ", "1"}]}], "}"}]}], ",", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Range", "[", "16", "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{"#", ",", " ", "4"}], "]"}], " ", "!=", " ", "0"}], " ", 
           "&"}]}], "]"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"total", ",", " ", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"InfraWalk", " ", "/@", " ", 
          RowBox[{"List", " ", "@@@", " ", 
           RowBox[{"EdgeList", " ", "@", " ", 
            RowBox[{"Subgraph", "[", 
             RowBox[{"total", ",", " ", 
              RowBox[{"Values", " ", "@", " ", 
               RowBox[{"First", " ", "@", " ", "up"}]}]}], "]"}]}]}]}], ",", 
         " ", 
         RowBox[{"Directive", "[", "StandardBlue", "]"}]}], "]"}]}], "]"}], ",",
      "\n", "    ", 
     RowBox[{"InfraContinuousSectionQ", "[", 
      RowBox[{"fib", ",", " ", "up"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1b4eddac-025b-460c-b853-b2ae4a4cb15c"],

