Cell["InfraContinuousSectionQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7cd42e2a-cb0a-4517-ae65-9de465337610"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraContinuousSectionQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraContinuousSectionQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    RowBox[{"InfraSection", "[", 
     StyleBox["s", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93716f7c-7667-43ed-afa7-67a7f7b0962b"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "418e0eba-5c76-46b1-8c76-11829fbaee05"],
 " if ",
 StyleBox["s", "TI"],
 " is a section of the fibered graph ",
 StyleBox["fib", "TI"],
 " that sends every base edge between its keys to a total edge.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"249a2075-495d-479c-a7b2-7f646f13e8a0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraContinuousSectionQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraContinuousSectionQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["sec1", "TI"], ",", " ", 
      StyleBox["sec2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "554c508a-a1cd-437d-aa9a-f4a815321433"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "792a8dd9-7b86-43e8-9983-f4d00f2b9a00"],
 " if every ",
 StyleBox["sec\:1d62", "TI"],
 " is a continuous section."
}], "Usage",ExpressionUUID->"1670dd36-4382-4432-a25b-2ceeb155d51f"],

Cell[TextData[{
 "The section ",
 StyleBox["s", "TI"],
 " is continuous when ",
 StyleBox["s(p)", "TI"],
 " lies over ",
 StyleBox["p", "TI"],
 " for every key ",
 StyleBox["p", "TI"],
 ", as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "174bce38-6f0b-4528-8f0e-95266ff7ba61"],
 " tests, and ",
 StyleBox["{s(p), s(q)}", "TI"],
 " is a total edge for every base edge ",
 StyleBox["{p, q}", "TI"],
 " with both ends keys of ",
 StyleBox["s", "TI"],
 "."
}], "Notes",ExpressionUUID->"6abcce95-963a-409f-bf29-dcd4e9d66350"],

Cell["\<\
A section may be partial. Only the base edges inside its domain are checked, \
and the empty section is continuous.\
\>", "Notes",ExpressionUUID->"53186f92-2804-448b-a674-1f266f0aaf2c"],

Cell[TextData[{
 "On the displacement bundle at scale 1 a section is a displacement ",
 StyleBox["p \[RightTeeArrow] v(p)", "TI"],
 " with ",
 StyleBox["v(p)", "TI"],
 " adjacent to ",
 StyleBox["p", "TI"],
 ". It is continuous iff ",
 StyleBox["d(v(p), v(q)) \[LessEqual] 1", "TI"],
 " for every base edge ",
 StyleBox["{p, q}", "TI"],
 ": neighbours move to equal or adjacent vertices."
}], "Notes",ExpressionUUID->"83d06ccd-4365-4346-a5df-ef640a373e88"],

Cell[TextData[{
 "Continuity uses only the total graph. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraParallelSectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelSectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "333d6f78-2013-423c-bcb5-13dc642eb389"],
 " asks more: that a chosen connection carries ",
 StyleBox["s(p)", "TI"],
 " to ",
 StyleBox["s(q)", "TI"],
 "."
}], "Notes",ExpressionUUID->"28d1c03b-ff1e-4ce6-a708-35f6fd7e6a6e"],

Cell[TextData[{
 "The empty list gives ",
