Cell["InfraContinuousSectionQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6ee4d2a7-99e3-479d-ada5-7e0ffa60265c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraContinuousSectionQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraContinuousSectionQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    RowBox[{"InfraSection", "[", 
     StyleBox["s", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c47c5ee-0658-4b47-83bf-cf391341545d"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["s", "TI"],
 " is a section of ",
 StyleBox["fib", "TI"],
 " mapping every base edge between its keys to a total edge.",
 "\n"
}], "Usage",ExpressionUUID->"5af83cf0-49db-45cf-b483-1fbff7abca38"],

Cell[TextData[{
 "Only base edges with both endpoints among the keys of ",
 StyleBox["s", "TI"],
 " are checked, so a section over a part of the base is continuous when it is \
continuous there."
}], "Notes",ExpressionUUID->"c4e25e39-f134-44ca-9097-3229fa690ebb"],

Cell["\<\
On a displacement bundle a continuous section is a continuous displacement: \
adjacent vertices move to adjacent or equal vertices.\
\>", "Notes",ExpressionUUID->"e7844291-0d5c-43fb-9f48-9a333a2d22c2"]
}, Open  ]],

