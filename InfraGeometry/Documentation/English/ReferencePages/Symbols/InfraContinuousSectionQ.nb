Cell["\<\
The two sheets of a product covering are continuous sections.\
\>", "ExampleText",ExpressionUUID->"e5f4370f-27ee-45e0-a077-f19ab285a95e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GraphProduct", "[", 
        RowBox[{
         RowBox[{"CycleGraph", "[", "4", "]"}], ",", " ", 
         RowBox[{"Graph", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
           RowBox[{"{", "}"}]}], "]"}], ",", " ", "\"\<Cartesian\>\""}], 
        "]"}], ",", " ", "First"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sections", " ", "=", " ", 
     RowBox[{"RandomInfraSection", "[", 
      RowBox[{"fib", ",", " ", "All", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Continuous\>\"", "}"}]}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraFiberedGraphHighlight", "[", 
         RowBox[{"fib", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
       "sections"}], "]"}], ",", " ", 
     RowBox[{"InfraContinuousSectionQ", "[", 
      RowBox[{"fib", ",", " ", "sections"}], "]"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"106566fa-893c-4546-8bf5-bc172d50540e"],

