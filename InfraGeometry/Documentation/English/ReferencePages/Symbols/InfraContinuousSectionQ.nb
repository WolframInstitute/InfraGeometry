Cell["\<\
A continuous partial section need not extend. On the connected double cover \
of the cycle of length 8, the first sheet over the vertices 1 to 7 is \
continuous, but no continuous section extends it, since both values over 8 \
break one of its two edges:\
\>", "ExampleText",ExpressionUUID->"0bec6227-a6ed-4bd7-9679-ee2b4463bcb6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<CycleDoubleCover\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"part", " ", "=", " ", 
     RowBox[{"InfraSection", " ", "@", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"#", ",", " ", "1"}], "}"}], " ", "&"}], ",", " ", 
        RowBox[{"Range", "[", "7", "]"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraContinuousSectionQ", "[", 
      RowBox[{"fib", ",", " ", "part"}], "]"}], ",", " ", 
     RowBox[{"RandomInfraSection", "[", 
      RowBox[{"fib", ",", " ", "part", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Continuous\>\"", "}"}]}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraContinuousSectionQ", "[", 
        RowBox[{"fib", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"RandomInfraSection", "[", 
       RowBox[{"fib", ",", " ", "part", ",", " ", "All"}], "]"}]}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fb031550-38e4-49f0-b0d4-002e618dc886"],

