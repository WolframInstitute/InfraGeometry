Cell["\<\
A sheet of the trivial double cover of the square grid is continuous. Moving \
the value at the centre to the other sheet breaks continuity at its four \
edges:\
\>", "ExampleText",ExpressionUUID->"bf54a398-f86b-4b60-8f43-b99fd07f3448"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"xy", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GraphProduct", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Graph", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
           RowBox[{"{", "}"}]}], "]"}], ",", " ", "\"\<Cartesian\>\""}], 
        "]"}], ",", " ", "First"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sections", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"InfraSection", " ", "@", " ", 
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{"p", " ", "|->", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"p", " ", "==", " ", "c"}], ",", " ", "k", ",", " ", 
               "1"}], "]"}]}], "}"}]}], ",", " ", 
          RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "2"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraFiberedGraphHighlight", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"{", "s", "}"}], ",", " ", 
        RowBox[{"\"\<BaseVertexCoordinates\>\"", " ", "->", " ", "xy"}], ",", 
        " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraContinuousSectionQ", "[", 
          RowBox[{"fib", ",", " ", "s"}], "]"}]}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"s", ",", " ", "sections"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"86cb1cff-a986-4aab-8564-84a180139f05"],

