Cell["\<\
A random section is not: few of the total edges between its values remain.\
\>", "ExampleText",ExpressionUUID->"8abf28f8-9eff-43d0-976f-04cf59214efc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridDisplacementBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"random", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomInfraSection", "[", "fib", "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"total", ",", " ", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"InfraWalk", " ", "/@", " ", 
          RowBox[{"List", " ", "@@@", " ", 
           RowBox[{"EdgeList", " ", "@", " ", 
            RowBox[{"Subgraph", "[", 
             RowBox[{"total", ",", " ", 
              RowBox[{"Values", " ", "@", " ", 
               RowBox[{"First", " ", "@", " ", "random"}]}]}], "]"}]}]}]}], ",",
          " ", 
         RowBox[{"Directive", "[", "StandardBlue", "]"}]}], "]"}]}], "]"}], ",",
      "\n", "    ", 
     RowBox[{"InfraContinuousSectionQ", "[", 
      RowBox[{"fib", ",", " ", "random"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d84cfdf5-ff23-4ddc-af19-2f877e31836e"],

