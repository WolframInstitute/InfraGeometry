Cell["\<\
A random section is not: few of the total edges between its values remain.\
\>", "ExampleText",ExpressionUUID->"5a77d86a-32e2-4904-bd9b-dbdc4946ea38"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridDisplacementBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"random", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomInfraSection", "[", "fib", "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"total", ",", " ", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"InfraWalk", " ", "/@", " ", 
          RowBox[{"List", " ", "@@@", " ", 
           RowBox[{"EdgeList", " ", "@", " ", 
            RowBox[{"Subgraph", "[", 
             RowBox[{"total", ",", " ", 
              RowBox[{"Values", " ", "@", " ", 
               RowBox[{"First", " ", "@", " ", "random"}]}]}], "]"}]}]}]}], ",",
          " ", 
         RowBox[{"Directive", "[", "StandardBlue", "]"}]}], "]"}]}], "]"}], ",",
      "\n", "    ", 
     RowBox[{"InfraContinuousSectionQ", "[", 
      RowBox[{"fib", ",", " ", "random"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d82bef3b-1dca-4916-b2c7-f5c8a580ecb5"],

