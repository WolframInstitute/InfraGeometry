   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fc1951f7-8044-4f5b-91a0-ede5b52999e3"],
 "."
}], "Notes",ExpressionUUID->"5ab5cad2-94fc-4788-8fcd-57845fd4971c"]
}, Open  ]],

