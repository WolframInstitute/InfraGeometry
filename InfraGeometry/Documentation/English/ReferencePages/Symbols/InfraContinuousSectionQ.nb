Cell[TextData[{
 "On the displacement bundle at scale 1, continuity is ",
 StyleBox["d(v(p), v(q)) \[LessEqual] 1", "TI"],
 " on every base edge:"
}], "ExampleText",ExpressionUUID->"7eabc0bb-07ca-4865-abf2-c7a1cc660cb6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraDisplacementBundle", "[", 
      RowBox[{"g", ",", " ", "1"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sections", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RandomInfraSection", "[", 
        RowBox[{"fib", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", "\"\<Continuous\>\"", "}"}]}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"RandomInfraSection", "[", 
        RowBox[{"fib", ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraContinuousSectionQ", "[", 
        RowBox[{"fib", ",", " ", "s"}], "]"}], ",", "\n", "      ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
         RowBox[{"e", " ", "|->", " ", 
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"Last", " ", "@", " ", 
              RowBox[{
               RowBox[{"First", "[", "s", "]"}], "[", 
               RowBox[{"First", " ", "@", " ", "e"}], "]"}]}], ",", " ", 
             RowBox[{"Last", " ", "@", " ", 
              RowBox[{
               RowBox[{"First", "[", "s", "]"}], "[", 
               RowBox[{"Last", " ", "@", " ", "e"}], "]"}]}]}], "]"}], " ", "<=",
            " ", "1"}]}]}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "sections"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6a477c0b-bb92-4013-8c01-953fc5be4e73"],

