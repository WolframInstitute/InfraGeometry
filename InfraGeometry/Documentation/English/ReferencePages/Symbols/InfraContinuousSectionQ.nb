Cell["InfraContinuousSectionQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8418fb11-57a7-4b26-aa8c-98586cb6a445"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraContinuousSectionQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraContinuousSectionQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    RowBox[{"InfraSection", "[", 
     StyleBox["s", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3481816d-6934-42e6-92e4-cd12f108daac"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "851443c0-bbaa-4446-994f-d24e8d7ca938"],
 " if ",
 StyleBox["s", "TI"],
 " is a section of the fibered graph ",
 StyleBox["fib", "TI"],
 " that sends every base edge between its keys to a total edge.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"9b2e220e-ac11-43ae-b9a1-c0cc51c1b3e9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraContinuousSectionQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraContinuousSectionQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["sec1", "TI"], ",", " ", 
      StyleBox["sec2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57660c9f-4b0e-4fcf-92c0-ae85e27a92f8"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c0e83296-b14d-4b4f-949b-580624692cbf"],
 " if every ",
 StyleBox["sec\:1d62", "TI"],
 " is a continuous section."
}], "Usage",ExpressionUUID->"7fdbb04c-5f4a-4979-8395-d7b56221efb3"],

Cell[TextData[{
 "The section ",
 StyleBox["s", "TI"],
 " is continuous when ",
 StyleBox["s(p)", "TI"],
 " lies over ",
 StyleBox["p", "TI"],
 " for every key ",
 StyleBox["p", "TI"],
 ", as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4fa56afc-718b-406c-a9cc-53c16af741ec"],
 " tests, and ",
 StyleBox["{s(p), s(q)}", "TI"],
 " is a total edge for every base edge ",
 StyleBox["{p, q}", "TI"],
 " with both ends keys of ",
 StyleBox["s", "TI"],
 "."
}], "Notes",ExpressionUUID->"dd9551e3-841a-45f2-88d0-7b5caf165d8f"],

Cell["\<\
A section may be partial. Only the base edges inside its domain are checked, \
and the empty section is continuous.\
\>", "Notes",ExpressionUUID->"ea4db348-d8a7-47eb-a423-bd70a881324d"],

Cell[TextData[{
 "On the displacement bundle at scale 1 a section is a displacement ",
 StyleBox["p \[RightTeeArrow] v(p)", "TI"],
 " with ",
 StyleBox["v(p)", "TI"],
 " adjacent to ",
 StyleBox["p", "TI"],
 ". It is continuous iff ",
 StyleBox["d(v(p), v(q)) \[LessEqual] 1", "TI"],
 " for every base edge ",
 StyleBox["{p, q}", "TI"],
 ": neighbours move to equal or adjacent vertices."
}], "Notes",ExpressionUUID->"9df28384-6bc9-4e82-935b-b16060c2a7b4"],

Cell[TextData[{
 "Continuity uses only the total graph. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraParallelSectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelSectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6debe355-4623-4c75-825e-5f9744946785"],
 " asks more: that a chosen connection carries ",
 StyleBox["s(p)", "TI"],
 " to ",
 StyleBox["s(q)", "TI"],
 "."
}], "Notes",ExpressionUUID->"cb7c007e-ca6e-47d0-8e33-142081eb88df"],

Cell[TextData[{
 "The empty list gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a9e0dd90-a68c-4b93-b8d3-0ea464b9e13f"],
 "."
}], "Notes",ExpressionUUID->"fcc2d065-4eef-45d0-8eca-f1afaeee6eaa"]
}, Open  ]],

