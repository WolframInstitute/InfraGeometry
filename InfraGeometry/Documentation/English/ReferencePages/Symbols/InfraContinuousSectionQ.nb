Cell["\<\
A random continuous section of the displacement bundle of the grid, and a \
random section:\
\>", "ExampleText",ExpressionUUID->"1c2e1d76-0f19-49ff-b194-1fabbd5b3a5e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraDisplacementBundle", "[", 
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}],
        ",", " ", "1"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraContinuousSectionQ", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomInfraSection", "[", 
        RowBox[{"fib", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", "\"\<Continuous\>\"", "}"}]}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}], ",",
      "\n", "    ", 
     RowBox[{"InfraContinuousSectionQ", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomInfraSection", "[", 
        RowBox[{"fib", ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"74c15517-c6bf-4b2d-98d8-1e5c0bf2645e"],

