Cell["A projection with list-valued total vertices.", "ExampleText",ExpressionUUID->"f7ef8300-faa1-470f-85a4-f0de54413737"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"GraphProduct", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}], ",", " ", 
       RowBox[{"PathGraph", "[", " ", 
        RowBox[{"{", " ", 
         RowBox[{"1", ",", " ", "2"}], " ", "}"}], " ", "]"}], ",", 
       " ", "\"\<Cartesian\>\""}], " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{"total", ",", " ", "First"}], " ", "]"}]}], " ", "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"InfraFiber", "[", " ", 
         RowBox[{"fib", ",", " ", "1"}], " ", "]"}], " ", "}"}]}], " ", "]"}],
      ",", "\n", "    ", 
     RowBox[{"Lookup", "[", " ", 
      RowBox[{
       RowBox[{"InfraProjection", "[", " ", "fib", " ", "]"}], ",", " ", 
       RowBox[{"Key", "[", " ", 
        RowBox[{"{", " ", 
         RowBox[{"1", ",", " ", "2"}], " ", "}"}], " ", "]"}]}], " ", "]"}]}],
     " ", "}"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"546bcc08-87e5-4a6b-8536-7c7c075e37c1"],

