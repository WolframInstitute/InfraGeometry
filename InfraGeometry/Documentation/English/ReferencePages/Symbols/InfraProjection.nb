Cell["\<\
A tangent vector projects to its first vertex, a cotangent vector to its \
last. The ray {6, 7, 8} and its reverse both lie over 6:\
\>", "ExampleText",ExpressionUUID->"fda54f33-3ce5-49b1-a4d7-c1f969f0652b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Lookup", "[", 
      RowBox[{
       RowBox[{"InfraProjection", "[", 
        RowBox[{"InfraTangentBundle", "[", 
         RowBox[{"g", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
       RowBox[{"Key", "[", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "7", ",", " ", "8"}], "}"}], "]"}]}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"Lookup", "[", 
      RowBox[{
       RowBox[{"InfraProjection", "[", 
        RowBox[{"InfraCotangentBundle", "[", 
         RowBox[{"g", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
       RowBox[{"Key", "[", 
        RowBox[{"{", 
         RowBox[{"8", ",", " ", "7", ",", " ", "6"}], "}"}], "]"}]}], "]"}]}],
     "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d47f9fa4-059c-4897-87c5-c4272fbe4ff9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "6"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"96600b8f-ba75-4502-83d9-89caa076e05f"]
}, Open  ]]
}, Open  ]],

