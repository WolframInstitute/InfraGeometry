Cell[TextData[{
 "The projection of a double covering of the 4 \[Times] 4 grid sends the \
vertex {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["k", "TI"],
 "} on sheet ",
 StyleBox["k", "TI"],
 " to ",
 StyleBox["p", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"cc444f74-bf9b-4514-ba1a-630d4aadc6fc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", "\n", "    ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Covering\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Take", "[", 
    RowBox[{
     RowBox[{"InfraProjection", "[", "fib", "]"}], ",", " ", "6"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"bb6f1505-2251-466b-88e1-4c87f9a513e0"],

