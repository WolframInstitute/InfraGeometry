Cell[TextData[{
 "The projection of a double covering of the 4 \[Times] 4 grid sends the \
vertex {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["k", "TI"],
 "} on sheet ",
 StyleBox["k", "TI"],
 " to ",
 StyleBox["p", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"d7b8d8fd-c9bf-4c5f-b604-95de079bc08d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", "\n", "    ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Covering\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Take", "[", 
    RowBox[{
     RowBox[{"InfraProjection", "[", "fib", "]"}], ",", " ", "6"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3c3ac04d-ce17-46c4-99f5-55eb446914e3"],

