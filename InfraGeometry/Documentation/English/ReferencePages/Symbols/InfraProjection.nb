Cell[CellGroupData[{
Cell["InfraProjection", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7ecce377-c033-43d4-be6f-1ab52844324c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraProjection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraProjection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17811a72-7189-4555-b840-fc79455c09dc"],
 "\[LineSeparator]",
 "gives the projection ",
 StyleBox["\[Pi]", "TI"],
 " of the fibered graph ",
 StyleBox["fib", "TI"],
 ", as an association from the total vertices to the base vertices.",
 "\n"
}], "Usage",ExpressionUUID->"1f45731e-f511-43ec-8ccb-a5aae0d69de7"],

Cell[TextData[{
 "The projection is a map ",
 StyleBox["\[Pi] : V(E) \[RightArrow] V(B)", "TI"],
 " from the total graph ",
 StyleBox["E", "TI"],
 " to the base ",
 StyleBox["B", "TI"],
 ". The fiber over ",
 StyleBox["p", "TI"],
 " is the subgraph of ",
 StyleBox["E", "TI"],
 " on ",
 StyleBox["\[Pi]\:207b\.b9(p)", "TI"],
 ", and the base has the values of ",
 StyleBox["\[Pi]", "TI"],
 " as its vertices."
}], "Notes",ExpressionUUID->"c838520c-9435-4ad3-b6e3-e899e9b50f6b"],

Cell[TextData[{
 "In ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFiberedGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    ButtonBox["E",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["\[Pi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0d74405-327b-4d88-8c74-730dee180bba"],
 ", ",
 StyleBox["\[Pi]", "TI"],
 " is an association whose keys are exactly the vertices of ",
 StyleBox["E", "TI"],
 ", or a function applied to each vertex."
}], "Notes",ExpressionUUID->"1d354599-4c8c-48bc-856d-a662a366c723"],

Cell["\<\
The tangent and displacement bundles project a ray or a pair to its first \
vertex, the cotangent bundle a reversed ray to its last vertex.\
\>", "Notes",ExpressionUUID->"f3cd1792-fa15-4a27-bb81-a11bc7780762"],

Cell[TextData[{
 "Total vertices are often lists. Read one with ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Lookup",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["\[Pi]", "TR"], ",", " ", 
    RowBox[{
     ButtonBox["Key",
      BaseStyle->"Link"], "[", 
     StyleBox["v", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8142741a-6468-4706-a841-5adf18a92b69"],
 "."
}], "Notes",ExpressionUUID->"ac42160f-0cae-47bc-b944-90926e5483b3"]
}, Open  ]],

