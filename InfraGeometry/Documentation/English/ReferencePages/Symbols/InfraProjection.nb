Cell["The counts of the projection values are the fiber sizes:", "ExampleText",ExpressionUUID->"398559a6-73e6-4e55-9fe4-8a43a1e767fa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{"KeySort", "[", 
     RowBox[{"Counts", "[", 
      RowBox[{"Values", "[", 
       RowBox[{"InfraProjection", "[", "fib", "]"}], "]"}], "]"}], "]"}], " ",
     "===", " ", 
    RowBox[{"KeySort", "[", 
     RowBox[{"VertexCount", " ", "/@", " ", 
      RowBox[{"InfraFibers", "[", "fib", "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"646bc86a-aa64-4e46-985d-c7dd227ff123"],

