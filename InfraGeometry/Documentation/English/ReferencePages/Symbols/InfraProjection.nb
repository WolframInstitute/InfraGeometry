Cell["\<\
A tangent vector projects to its first vertex, a cotangent vector to its \
last. The ray {6, 7, 8} and its reverse both lie over 6:\
\>", "ExampleText",ExpressionUUID->"a342618c-84bc-4f16-ba76-40a392a43757"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Lookup", "[", 
      RowBox[{
       RowBox[{"InfraProjection", "[", 
        RowBox[{"InfraTangentBundle", "[", 
         RowBox[{"g", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
       RowBox[{"Key", "[", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "7", ",", " ", "8"}], "}"}], "]"}]}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"Lookup", "[", 
      RowBox[{
       RowBox[{"InfraProjection", "[", 
        RowBox[{"InfraCotangentBundle", "[", 
         RowBox[{"g", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
       RowBox[{"Key", "[", 
        RowBox[{"{", 
         RowBox[{"8", ",", " ", "7", ",", " ", "6"}], "}"}], "]"}]}], "]"}]}],
     "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"392a6e5f-e9da-40a8-989c-bb70465adac3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "6"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a1c48974-4ece-4a15-b921-901a48db7ae7"]
}, Open  ]]
}, Open  ]],

