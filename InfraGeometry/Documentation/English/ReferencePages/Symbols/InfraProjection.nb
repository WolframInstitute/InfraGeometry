Cell["A projection with list-valued total vertices.", "ExampleText",ExpressionUUID->"5695d0e3-838b-416c-8dff-9850a5829726"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"GraphProduct", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}], ",", " ", 
       RowBox[{"PathGraph", "[", " ", 
        RowBox[{"{", " ", 
         RowBox[{"1", ",", " ", "2"}], " ", "}"}], " ", "]"}], ",", 
       " ", "\"\<Cartesian\>\""}], " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{"total", ",", " ", "First"}], " ", "]"}]}], " ", "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"InfraFiber", "[", " ", 
         RowBox[{"fib", ",", " ", "1"}], " ", "]"}], " ", "}"}]}], " ", "]"}],
      ",", "\n", "    ", 
     RowBox[{"Lookup", "[", " ", 
      RowBox[{
       RowBox[{"InfraProjection", "[", " ", "fib", " ", "]"}], ",", " ", 
       RowBox[{"Key", "[", " ", 
        RowBox[{"{", " ", 
         RowBox[{"1", ",", " ", "2"}], " ", "}"}], " ", "]"}]}], " ", "]"}]}],
     " ", "}"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f81f0671-e5fd-4351-ae96-429c1b773f9d"],

