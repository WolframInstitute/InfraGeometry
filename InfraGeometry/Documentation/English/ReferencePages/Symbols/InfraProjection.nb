Cell[CellGroupData[{
Cell["InfraProjection", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6fefd5c3-784f-4d7d-8f96-691f4aa096ff"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraProjection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraProjection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5830bc41-e00b-4fd0-b497-c380a76f0b95"],
 "\[LineSeparator]",
 "gives the projection of ",
 StyleBox["fib", "TI"],
 " as an association from total vertices to base vertices.",
 "\n"
}], "Usage",ExpressionUUID->"dc5cb1f7-0f51-4533-99fd-f63462f5ae2e"],

Cell["\<\
An association projection must cover exactly the total vertices. A function \
projection is evaluated on each total vertex.\
\>", "Notes",ExpressionUUID->"abb9822a-65a8-492f-9c5d-50bc5fd783f6"],

Cell["\<\
Every vertex label is one literal key, including a list or an expression \
containing a pattern.\
\>", "Notes",ExpressionUUID->"7dc104ac-fb63-44be-8dcd-b9cd6ec5c9ae"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Lookup",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["projection", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Key",
      BaseStyle->"Link"], "[", 
     StyleBox["vertex", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7903402-e628-48df-8c76-d4f1d6ef47aa"],
 " to read one literal vertex, and ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Lookup",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["projection", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Key",
      BaseStyle->"Link"], " ", "/@", " ", 
     StyleBox["vertices", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8de67d4-d0c0-4f18-a742-92c61ada0eb3"],
 " for an ordered vertex list."
}], "Notes",ExpressionUUID->"85d5b1f9-6493-45d5-8c04-107721449470"],

Cell["\<\
The Experimental tangent and displacement models project to the first vertex \
of a ray or pair. The cotangent model projects to the last vertex of its \
reversed ray.\
\>", "Notes",ExpressionUUID->"b89a7cf2-83dc-439c-87ff-d5f05416d3f8"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibrationAssociation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationAssociation", 
