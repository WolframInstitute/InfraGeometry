Cell[CellGroupData[{
Cell["InfraProjection", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"308c7ce4-44d5-4f94-8730-e38e35f295ec"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraProjection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraProjection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7972623-17b6-484e-b69a-b5ab0366f4aa"],
 "\[LineSeparator]",
 "gives the projection ",
 StyleBox["\[Pi]", "TI"],
 " of the fibered graph ",
 StyleBox["fib", "TI"],
 ", as an association from the total vertices to the base vertices.",
 "\n"
}], "Usage",ExpressionUUID->"6697886f-c8a1-4e00-9a80-9b992e55031d"],

Cell[TextData[{
 "The projection is a map ",
 StyleBox["\[Pi] : V(E) \[RightArrow] V(B)", "TI"],
 " from the total graph ",
 StyleBox["E", "TI"],
 " to the base ",
 StyleBox["B", "TI"],
 ". The fiber over ",
 StyleBox["p", "TI"],
 " is the subgraph of ",
 StyleBox["E", "TI"],
 " on ",
 StyleBox["\[Pi]\:207b\.b9(p)", "TI"],
 ", and the base has the values of ",
 StyleBox["\[Pi]", "TI"],
 " as its vertices."
}], "Notes",ExpressionUUID->"5f4b6793-8ee8-4c89-b36c-c439ea2b5898"],

Cell[TextData[{
 "In ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFiberedGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    ButtonBox["E",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["\[Pi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4c0f4c5-b2a0-478e-a912-c3fdea15f7cf"],
 ", ",
 StyleBox["\[Pi]", "TI"],
 " is an association whose keys are exactly the vertices of ",
 StyleBox["E", "TI"],
 ", or a function applied to each vertex."
}], "Notes",ExpressionUUID->"194ab9fe-3591-486d-b484-711177ab7973"],

Cell["\<\
The tangent and displacement bundles project a ray or a pair to its first \
vertex, the cotangent bundle a reversed ray to its last vertex.\
\>", "Notes",ExpressionUUID->"b17c8c77-7bd5-4e77-93b2-deb95a0f1564"],

Cell[TextData[{
 "Total vertices are often lists. Read one with ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Lookup",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["\[Pi]", "TR"], ",", " ", 
    RowBox[{
     ButtonBox["Key",
      BaseStyle->"Link"], "[", 
     StyleBox["v", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed66bff1-c500-4bfd-9be3-016ca3d6005a"],
 "."
}], "Notes",ExpressionUUID->"dc282f71-bb51-41b8-aef0-8dea8632adf4"],

