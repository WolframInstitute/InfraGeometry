Cell["The counts of the projection values are the fiber sizes:", "ExampleText",ExpressionUUID->"e0666822-2b88-4288-94aa-7732587b1918"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{"KeySort", "[", 
     RowBox[{"Counts", "[", 
      RowBox[{"Values", "[", 
       RowBox[{"InfraProjection", "[", "fib", "]"}], "]"}], "]"}], "]"}], " ",
     "===", " ", 
    RowBox[{"KeySort", "[", 
     RowBox[{"VertexCount", " ", "/@", " ", 
      RowBox[{"InfraFibers", "[", "fib", "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5a4d88fe-9a98-488f-9336-11d4c6401526"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e610df2b-dff1-45c8-ad75-bb68e9fef9f7"]
