Cell["\<\
The fibers are the preimages of base vertices. The preimages of the vertices \
6 and 10:\
\>", "ExampleText",ExpressionUUID->"2f378c44-3eeb-471f-8eaa-c0079bd7d104"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", "2"}], ",", "\n", 
       "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "6"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"proj", " ", "=", " ", 
     RowBox[{"InfraProjection", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"proj", ",", " ", 
          RowBox[{"EqualTo", "[", "6", "]"}]}], "]"}]}], ",", " ", 
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"proj", ",", " ", 
          RowBox[{"EqualTo", "[", "10", "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2a2da82a-bd90-4ac1-8032-532f1cffc36e"],

