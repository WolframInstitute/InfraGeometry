Notebook[{

Cell[CellGroupData[{
Cell["InfraProjection", "ObjectName",ExpressionUUID->"53f14edd-c8d8-4a9d-843c-b4797fbc99ac"],

Cell["LLM generated.", "Notes",ExpressionUUID->"2ba0e9f4-7010-40dd-a2be-66028d74e0a2"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5254eda8-384c-4abb-b9ea-3d967410a26d"],
 Cell[BoxData[
  RowBox[{"InfraProjection", "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "768b7f94-cbf0-48d8-86be-f0ca6effe2f3"],
 "\[LineSeparator]",
 "gives the projection of ",
 StyleBox["fib", "TI"],
 " as an association from total vertices to base vertices.",
 "\n"
}], "Usage",ExpressionUUID->"effc4dcf-dd04-495c-894c-f78497986ce2"],

Cell["\<\
An association projection must cover exactly the total vertices. A function \
projection is evaluated on each total vertex.\
\>", "Notes",ExpressionUUID->"46c7b7ce-5d55-4aad-8951-13073a9b30f1"],

Cell["\<\
Every vertex label is one literal key, including a list or an expression \
containing a pattern.\
\>", "Notes",ExpressionUUID->"5209466e-528d-4a4a-94cf-7213ffe641e9"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Lookup",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["projection", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Key",
      BaseStyle->"Link"], "[", 
     StyleBox["vertex", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27c85b87-4f53-411e-a837-23069b31ff4a"],
 " to read one literal vertex, and ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Lookup",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["projection", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Key",
      BaseStyle->"Link"], " ", "/@", " ", 
     StyleBox["vertices", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e718fe39-c8a5-44ea-a71e-c2d721e75e41"],
 " for an ordered vertex list."
}], "Notes",ExpressionUUID->"36397ece-fd13-4da5-8921-a1737aad4724"],

Cell["\<\
The Experimental tangent and displacement models project to the first vertex \
of a ray or pair. The cotangent model projects to the last vertex of its \
reversed ray.\
\>", "Notes",ExpressionUUID->"195a2795-6f79-4af0-ae5c-68eb3625eb58"],

