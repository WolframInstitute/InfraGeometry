Cell["\<\
Two labelled steps: two points three steps apart, then the segment between \
them. The segments of every branch are drawn summed.\
\>", "ExampleText",ExpressionUUID->"bf0b6745-6721-4127-acdb-d8d0c9ee15d3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"pA", ",", " ", "pB", ",", " ", "seg1"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "pB", ",", " ", "seg1"}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"pA", " ", "==", " ", 
              RowBox[{"InfraPoint", "[", "c", "]"}]}], ",", " ", 
             RowBox[{"pB", " ", "==", " ", 
              RowBox[{"InfraPoint", "[", 
               RowBox[{"pA", ",", " ", "3"}], "]"}]}]}], "}"}], ",", 
           " ", "\"\<two points\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"seg1", " ", "==", " ", 
             RowBox[{"InfraSegment", "[", 
              RowBox[{"pA", ",", " ", "pB"}], "]"}]}], "}"}], ",", 
           " ", "\"\<the segment\>\""}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"solved", " ", "=", " ", 
     RowBox[{"FindInfraScene", "[", 
      RowBox[{"scene", ",", " ", "g"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"InfraSceneInstance", "[", 
            RowBox[{"#", ",", " ", "seg1"}], "]"}], " ", "&"}], " ", "/@", 
          " ", "solved"}], ",", " ", "c"}], "}"}]}], "]"}], ",", "\n", "   ", 
     
     RowBox[{"scene", "[", "\"\<Labels\>\"", "]"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0b49a958-a63f-4586-8579-b253c8fe6f66"],

