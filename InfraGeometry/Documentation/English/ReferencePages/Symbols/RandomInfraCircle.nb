Cell[TextData[{
 "The sampler has the same token geometry as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d055c590-921c-4acd-9a08-ccc27a281ce7"],
 ". An omitted or ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6aaad1fa-e6fe-4bb4-beee-dfa3504ed730"],
 " count returns one representative. An integer count requests exactly that \
many distinct representatives and returns ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96f92f35-d2f2-4f21-85a1-83b983ea4039"],
 " when too few exist."
}], "Notes",ExpressionUUID->"8a61a547-9fa3-44f3-b60f-2ffd12dab20f"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95696ea7-4743-4e74-bdf6-41f768ab42e6"],
 " selects deterministically. Default ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebc2a40d-6d2a-4793-9a1c-ee4b7b5a0a5a"],
 " does not advance random state. Seed an ordinary draw with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08f6e995-8194-4154-8f51-62f63ea79d87"],
 "."
}], "Notes",ExpressionUUID->"429e8685-4c2c-4444-b18f-882dc9a53f2a"],

