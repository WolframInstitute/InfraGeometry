Cell["\<\
The grid has no circle of one radius: the shell has no edges.\
\>", "ExampleText",ExpressionUUID->"9391bc2f-389b-4080-872d-fd3790f395e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"RandomInfraCircle", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}], ",", " ", 
     RowBox[{"EdgeCount", " ", "@", " ", 
      RowBox[{"Subgraph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "All"}], "]"}]}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3567f29c-e9bd-44c3-b3b4-d642b5b2bb01"],

