Cell["\<\
A circle in the band of radii 3 to 4 about the centre, on the square grid and \
on the square mesh:\
\>", "ExampleText",ExpressionUUID->"a926810c-c8ea-42c9-8e2f-a2fb8cb9a144"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"circle", " ", "=", " ", 
        RowBox[{"RandomInfraCircle", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{"{", 
             RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{"{", 
             RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"InfraWalk", "[", 
           RowBox[{"Append", "[", 
            RowBox[{"circle", ",", " ", 
             RowBox[{"First", " ", "@", " ", "circle"}]}], "]"}], "]"}], ",", 
          " ", "c"}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"e0aa89bc-5c55-41d6-9dc6-f206df2899c5"],

