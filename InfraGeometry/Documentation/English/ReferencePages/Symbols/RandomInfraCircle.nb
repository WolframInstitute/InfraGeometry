Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraCircle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"99fde8dc-9b61-4f46-a7dd-e3c9a92c95c9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCircle", "[", 
     RowBox[{
      StyleBox["c", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a4b6825-dae2-437e-91cd-70622b3a5712"],
 "\[LineSeparator]",
 "samples a cyclic vertex sequence on graph ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"464c8966-c046-42af-b364-5bbb44ede060"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCircle", "[", 
     RowBox[{
      StyleBox["c", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69d479a2-61c5-4108-b7e1-9088ee39b5ba"],
 "\[LineSeparator]",
 "requests ",
 Cell[BoxData["count"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd927786-3f37-4478-b001-f1d39ebab975"],
 " representatives. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8fdc27e-8acd-479e-827f-cfa4aeb68706"],
 " enumerates the full pool; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2964d948-cf2f-46e9-be58-e9771b5b476f"],
 " returns at most ",
 StyleBox["n", "TI"],
 "."
}], "Usage",ExpressionUUID->"cc312652-336d-483a-b8cc-03caf6e76267"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomInfraCircle", "[", 
   RowBox[{"g", ",", " ", "c", ",", " ", "r", ",", " ", "count"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ecfe53c5-e714-4585-9cbe-693a4e121efe"],
 " uses the direct form."
}], "Notes",ExpressionUUID->"f610943f-67c7-4a0b-acd8-d37b47d72924"],

Cell[TextData[{
 "The sampler has the same token geometry as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7b577ae7-7653-4b36-90d1-68c00a9fbf2a"],
 ". An omitted or ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b47595e3-180f-4633-a956-1061769c8fdc"],
 " count returns one representative. An integer count requests exactly that \
many distinct representatives and returns ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80b86f33-0ba9-4650-bac2-461a219602f3"],
 " when too few exist."
}], "Notes",ExpressionUUID->"6925db33-7c35-4a11-85a9-2aed350389a1"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2623c8a-7a52-4718-b62d-02e8266398ce"],
 " selects deterministically; default ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffc35aa4-f77d-469e-8073-335f7b22f0f3"],
 " makes no draw. ",
 Cell[BoxData[
  RowBox[{"RandomSeeding", " ", "->", " ", "Automatic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0270ccc-1957-41e3-8606-858f7bb4345e"],
 " (default) seeds each call afresh, independently of ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07c656c5-e4c7-420f-b8ea-3ddfd730378f"],
 "; an integer or string gives a reproducible draw, and ",
 Cell[BoxData["Inherited"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27789a86-8cf9-4b1d-83f6-9e47d6db6b37"],
 " a local snapshot of the current state. The outer random state is restored \
afterward, as with ",
 ButtonBox["RandomInstance",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/RandomInstance.html"], 
    None}],
 "."
}], "Notes",ExpressionUUID->"501e0625-869c-4e43-a7a3-d261697cc5b1"],

Cell[TextData[{
 "See ",
 ButtonBox["Named construction samplers",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["../Tutorials/NamedConstructionSamplers.md"], None}],
 " for bare overloads, carrier differences and compatibility spellings."
}], "Notes",ExpressionUUID->"a197f658-7f52-4ed2-a023-d653c2cbdb6c"]
}, Open  ]],

