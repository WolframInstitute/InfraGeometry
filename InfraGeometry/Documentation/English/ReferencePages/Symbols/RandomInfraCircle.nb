  FontSize->0.9 Inherited,ExpressionUUID->
  "a6833310-9777-43c2-8d4e-18d067f407b3"],
 "\[LineSeparator]",
 "samples a cyclic vertex sequence on graph ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"60167d31-7faa-4473-acd6-c81a55b74116"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCircle", "[", 
     RowBox[{
      StyleBox["c", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4b16895-b3b6-4313-839d-05bba40b3fb5"],
 "\[LineSeparator]",
 "requests ",
 Cell[BoxData["count"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "834216d2-b344-4ab2-a1f1-938638504cc6"],
 " representatives. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b44f548e-bcd8-450b-a73a-86a574304b53"],
 " enumerates the full pool; ",
