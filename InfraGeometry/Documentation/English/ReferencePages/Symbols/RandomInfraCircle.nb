Cell[TextData[{
 "A circle in the band ",
 StyleBox["W = {v : r \[LessEqual] d(c, v) \[LessEqual] s}", "TI"],
 " is a shortest cycle of the subgraph induced on ",
 StyleBox["W", "TI"],
 " that separates ",
 StyleBox["c", "TI"],
 " from the vertices beyond ",
 StyleBox["s", "TI"],
 ". The radius ",
 StyleBox["r", "TI"],
 " is the band {",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["r", "TI"],
 "}."
}], "Notes",ExpressionUUID->"d070680b-dd5a-4c2f-9614-020c0e8a5ed0"],

Cell[TextData[{
 "A shell can have no edges. On the square grid, which is bipartite, a circle \
of one radius does not exist. The band {",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["r", "TI"],
 " + 1} has exactly one circle, of length ",
 StyleBox["8r", "TI"],
 ". In the plane the circumference is ",
 StyleBox["2\[Pi]r", "TI"],
 "; ",
 StyleBox["8", "TI"],
 " is the perimeter of the \[ScriptL]\.b9 unit circle."
}], "Notes",ExpressionUUID->"f6991ab3-0685-42d4-9b56-86ad7124ef8d"],

Cell[TextData[{
 "A circle is returned as a vertex list ",
 StyleBox["v\:2081, \[Ellipsis], v\:2096", "TI"],
 ", the edge ",
 StyleBox["v\:2096v\:2081", "TI"],
 " closing it. The draw is uniform over the circles of the band."
}], "Notes",ExpressionUUID->"1c457c25-b390-4685-882a-a437e65f29bc"],

