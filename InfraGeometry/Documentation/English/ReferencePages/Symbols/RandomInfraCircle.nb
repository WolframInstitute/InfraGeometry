Cell["\<\
Removing a circle cuts the centre off from the vertices beyond the band. The \
farthest vertex left with the centre is at distance 3:\
\>", "ExampleText",ExpressionUUID->"3950f5da-990d-485f-a75c-bcc576312cbb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"RandomInfraCircle", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@",
      " ", 
     RowBox[{"VertexComponent", "[", 
      RowBox[{
       RowBox[{"VertexDelete", "[", 
        RowBox[{"g", ",", " ", "circle"}], "]"}], ",", " ", "c"}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1168d256-462c-4ab0-bec1-8473580804f0"],

Cell[BoxData["3"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2fec0ba0-1a5f-48d8-bd24-f32857d922ce"]
}, Open  ]],

Cell[TextData[{
 "A circle of one radius is a cycle on a shell, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircleQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircleQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ff85b460-0c8c-4ae1-b909-06017eb9cb12"],
 " holds:"
}], "ExampleText",ExpressionUUID->"b45ec9ca-e1b4-4629-b26e-8077aca8d8e6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraCircleQ", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"RandomInfraCircle", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "3", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1da56bc4-cb29-49bc-8274-78353a67af50"],

Cell[BoxData["True"], "Output",
