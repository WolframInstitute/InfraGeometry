  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Length", " ", "/@", " ", 
      RowBox[{"RandomInfraCircle", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCircle", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", 
            RowBox[{"r", " ", "+", " ", "1"}]}], "}"}]}], "]"}], ",", " ", 
        "All"}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "1", ",", " ", "5"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"612b7023-8939-4db8-802f-6025d44656fb"],

