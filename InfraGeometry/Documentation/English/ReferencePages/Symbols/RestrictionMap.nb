Cell[TextData[{
 "The coboundary of the distance from the centre of the triangular tiling, \
left, drawn by an arc along each edge in the direction in which it is 1, and \
its restriction, right, drawn by an arc from ",
 StyleBox["v", "TI"],
 " to ",
 StyleBox["w", "TI"],
 " where the germ at ",
 StyleBox["v", "TI"],
 " is positive on the step to ",
 StyleBox["w", "TI"],
 ", blue, or negative, orange. On each step between two shells the germ at \
the inner end is 1 towards the outer end, and the germ at the outer end is \
\[Minus]1 towards the inner end."
}], "ExampleText",ExpressionUUID->"58bc50d8-4a3a-4521-93ca-6ef002493c50"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cochain", " ", "=", " ", 
     RowBox[{"Coboundary", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"AssociationMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", 
            RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
         RowBox[{"List", " ", "/@", " ", 
          RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"form", " ", "=", " ", 
     RowBox[{"RestrictionMap", "[", 
      RowBox[{"g", ",", " ", "cochain"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"DisplacementPlot", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"GroupBy", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"Select", "[", 
              RowBox[{"cochain", ",", " ", "Positive"}], "]"}]}], ",", " ", 
            RowBox[{"Reverse", " ", "/@", " ", 
             RowBox[{"Keys", " ", "@", " ", 
              RowBox[{"Select", "[", 
               RowBox[{"cochain", ",", " ", "Negative"}], "]"}]}]}]}], "]"}], 
          ",", " ", 
          RowBox[{"First", " ", "->", " ", "Last"}]}], "]"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"DisplacementPlot", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"Catenate", " ", "@*", " ", "Keys", " ", "@*", " ", 
             RowBox[{"Select", "[", "Positive", "]"}]}], ",", " ", "form"}], 
           "]"}], ",", " ", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"Catenate", " ", "@*", " ", "Keys", " ", "@*", " ", 
             RowBox[{"Select", "[", "Negative", "]"}]}], ",", " ", "form"}], 
           "]"}]}], "}"}]}], "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e1176162-0c97-4cf6-bf66-9ea72bd69c00"],

