Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IntegrationMap"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/IntegrationMap", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5bcfd002-986f-47e7-bec9-7c8a60eb7a56"],
 " undoes the restriction, for random 1- and 2-cochains on the mesh:"
}], "ExampleText",ExpressionUUID->"350cfa08-a455-4035-ba9f-677001a73446"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"edges", " ", "=", " ", 
      RowBox[{"Sort", " ", "/@", " ", 
       RowBox[{"List", " ", "@@@", " ", 
        RowBox[{"EdgeList", "[", "g", "]"}]}]}]}], ",", " ", 
     RowBox[{"triangles", " ", "=", " ", 
      RowBox[{"Sort", " ", "/@", " ", 
       RowBox[{"FindClique", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", "3", "}"}], ",", " ", "All"}], "]"}]}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a1", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"edges", ",", " ", 
        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"RandomChoice", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "2"}], ",", " ", 
              RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "2"}], "}"}], ",", 
            " ", 
            RowBox[{"Length", "[", "edges", "]"}]}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}]}], 
     ",", "\n", "   ", 
     RowBox[{"a2", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"triangles", ",", "\n", "     ", 
        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"RandomChoice", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "2"}], ",", " ", 
              RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "2"}], "}"}], ",", 
            " ", 
            RowBox[{"Length", "[", "triangles", "]"}]}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"KeySort", "[", 
       RowBox[{"IntegrationMap", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"RestrictionMap", "[", 
          RowBox[{"g", ",", " ", "a"}], "]"}]}], "]"}], "]"}], " ", "==", " ", 
      RowBox[{"KeySort", "[", "a", "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", 
       RowBox[{"{", 
        RowBox[{"a1", ",", " ", "a2"}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"bc589f9f-13cc-4f45-8ddc-d4bc5d3eb030"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"134ea4ff-30e4-4a7f-ba57-aa9cb1cd91ea"]
}, Open  ]],

Cell["\<\
In degree 1 the form of a cochain is antisymmetric across every edge:\
\>", "ExampleText",ExpressionUUID->"94bed30a-5449-404f-a42b-68ddaea32378"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"edges", " ", "=", " ", 
     RowBox[{"Sort", " ", "/@", " ", 
      RowBox[{"List", " ", "@@@", " ", 
       RowBox[{"EdgeList", "[", "g", "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{"edges", ",", " ", 
       RowBox[{"BlockRandom", "[", 
        RowBox[{
         RowBox[{"RandomChoice", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", " ", 
             RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "2"}], "}"}], ",", 
           " ", 
           RowBox[{"Length", "[", "edges", "]"}]}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"form", " ", "=", " ", 
     RowBox[{"RestrictionMap", "[", 
      RowBox[{"g", ",", " ", "a"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{"edges", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"FormValue", "[", 
        RowBox[{"form", ",", " ", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "}"}]}], "]"}], " ", "==", " ", 
       RowBox[{"-", 
        RowBox[{"FormValue", "[", 
         RowBox[{"form", ",", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "}"}]}], "]"}]}]}], " ", "&"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9e6560ce-8bee-4707-8445-6e85d8cf55e7"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"ab11ae8c-c666-4761-9eee-ecec92ed440f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Possible Issues", "ExampleSection",ExpressionUUID->
   "dda06a82-eb41-4b48-8510-6cb821647761"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell["\<\
The cochain is not checked against the graph. The square grid has no \
triangles, yet a value on three of its vertices gives germs:\
\>", "ExampleText",ExpressionUUID->"3761fdea-66b4-4895-ba92-ac26af0da1b1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "3"}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindClique", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", "3", "}"}], ",", " ", "All"}], "]"}]}], ",", " ", 
     RowBox[{"Normal", " ", "/@", " ", 
      RowBox[{"RestrictionMap", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"<|", 
         RowBox[{"t", " ", "->", " ", "1"}], "|>"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"942dd92d-b0f3-4b08-82e8-38664f58f188"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"2", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], "\[Rule]", "1"}], "}"}]}], ",", 
     RowBox[{"3", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}], "\[Rule]", 
        RowBox[{"-", "1"}]}], "}"}]}], ",", 
     RowBox[{"4", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], "\[Rule]", "1"}], "}"}]}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"919cf2b8-42ff-4ae1-a778-b6cef8cae9bf"]
}, Open  ]]
}, Open  ]],

