Cell[CellGroupData[{
Cell["RestrictionMap", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7d0f951d-cfe4-4b0a-8fbb-35caf02e1178"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RestrictionMap"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RestrictionMap", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["\[Alpha]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc2ec918-6c31-4213-b190-33256ec77697"],
 "\[LineSeparator]",
 "gives the form ",
 StyleBox["R\[Alpha]", "TI"],
 " of the alternating ",
 StyleBox["k", "TI"],
 "-cochain ",
 StyleBox["\[Alpha]", "TI"],
 ", whose germ at ",
 StyleBox["v", "TI"],
 " is ",
 StyleBox["\[Alpha]", "TI"],
 " with ",
 StyleBox["v", "TI"],
 " put in front: ",
 StyleBox["(R\[Alpha])(v; w\:2081, \[Ellipsis], w\:2096) = \[Alpha](v, \
w\:2081, \[Ellipsis], w\:2096)", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"883a3341-118f-416c-9672-20416196cc0f"],

Cell[TextData[{
 StyleBox["R", "TI"],
 " maps the ",
 StyleBox["k", "TI"],
 "-cochains to the ",
 StyleBox["k", "TI"],
 "-forms. ",
 StyleBox["R\[Alpha]", "TI"],
 " vanishes on every tuple of neighbours that does not span a clique with ",
 StyleBox["v", "TI"],
 ", and a vertex on no clique where ",
 StyleBox["\[Alpha]", "TI"],
 " has a value gets no germ."
}], "Notes",ExpressionUUID->"9a0a93df-aa39-49c1-912e-9212e844315c"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IntegrationMap"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/IntegrationMap", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "42b6a4e5-12d2-4b2c-b0db-20a5aa0a8614"],
 " is a left inverse: ",
 StyleBox["I(R\[Alpha]) = \[Alpha]", "TI"],
 " in every degree, so ",
 StyleBox["R", "TI"],
 " is injective. In degree 1 the image is the forms antisymmetric across \
every edge, ",
 StyleBox["\[Omega](v; w) = \[Minus]\[Omega](w; v)", "TI"],
 "."
}], "Notes",ExpressionUUID->"cdc5dc1c-3518-4b59-9722-6cfa80806a22"],

Cell[TextData[{
 "In degree 0 a cochain and its form carry the same values. The restriction \
of a coboundary is the gradient: ",
 StyleBox["(R \[Delta]f)(v; w) = f(w) \[Minus] f(v)", "TI"],
 ", the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FormDifferential"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FormDifferential", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b183b98c-323c-421b-80f3-1eac7aac4925"],
 " of the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ZeroForm"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ZeroForm", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c6e569c5-d260-44af-a942-d0d7a8ac6824"],
 " of ",
 StyleBox["f", "TI"],
 "."
}], "Notes",ExpressionUUID->"a5a1e765-5527-43b4-a8fe-2e7fd2b9e137"],

Cell["\<\
On the square grid there are no triangles, so no 2-cochains and no 2-forms; \
on the square mesh there are 154 triangles.\
\>", "Notes",ExpressionUUID->"20f1bded-c428-47fe-a517-1d7ec62f8b42"]
}, Open  ]],

