Cell["\<\
The restriction of the 2-cochain that is 1 on one triangle at the centre has \
a germ at each of its three corners, on the pair of the other two, with the \
sign of moving the corner to the front.\
\>", "ExampleText",ExpressionUUID->"6da3c2ae-a07a-42f9-a2ae-26d9a4f0d297"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"center", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
     RowBox[{"positions", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"triangle", " ", "=", " ", 
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"FindClique", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", "3", "}"}], ",", " ", "All"}], "]"}], ",", " ", 
         RowBox[{"MemberQ", "[", "center", "]"}]}], "]"}]}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"{", 
         RowBox[{"StandardBlue", ",", " ", 
          RowBox[{"Polygon", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"positions", ",", " ", "triangle"}], "]"}], "]"}]}], 
         "}"}], "]"}], ",", " ", "g"}], "]"}], ",", " ", "triangle", ",", " ", 
     RowBox[{"Normal", "[", 
      RowBox[{"Normal", " ", "/@", " ", 
       RowBox[{"RestrictionMap", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"<|", 
