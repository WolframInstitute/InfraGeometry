Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IntegrationMap"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/IntegrationMap", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b0194965-a7b7-4d2b-9bf3-7ddf7099ef2d"],
 " undoes the restriction: a random 1-cochain with values \[PlusMinus]1 and \
\[PlusMinus]2, drawn by an arc along each edge in the direction in which it \
is positive, comes back from its form unchanged."
}], "ExampleText",ExpressionUUID->"0f4da5ec-2686-47bf-b07c-c0c5107c8bcd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cochain", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"AssociationMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"RandomChoice", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", " ", 
             RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "2"}], "}"}], "]"}],
           " ", "&"}], ",", " ", 
         RowBox[{"Sort", " ", "/@", " ", 
          RowBox[{"List", " ", "@@@", " ", 
           RowBox[{"EdgeList", "[", "g", "]"}]}]}]}], "]"}]}], ")"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"GroupBy", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Keys", " ", "@", " ", 
            RowBox[{"Select", "[", 
             RowBox[{"cochain", ",", " ", "Positive"}], "]"}]}], ",", " ", 
           RowBox[{"Reverse", " ", "/@", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"Select", "[", 
              RowBox[{"cochain", ",", " ", "Negative"}], "]"}]}]}]}], "]"}], ",",
          " ", 
         RowBox[{"First", " ", "->", " ", "Last"}]}], "]"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"KeySort", "[", 
       RowBox[{"IntegrationMap", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"RestrictionMap", "[", 
          RowBox[{"g", ",", " ", "cochain"}], "]"}]}], "]"}], "]"}], " ", "===",
       " ", 
      RowBox[{"KeySort", "[", "cochain", "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"55e6e6af-82cf-436e-87c5-d3bcbfacd11f"],

