Notebook[{

Cell[CellGroupData[{
Cell["RestrictionMap", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"81f95318-97b0-4aca-9831-721a5065e033"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RestrictionMap"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RestrictionMap", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["\[Alpha]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b710e54-7390-427e-8f6f-7dcd03a5201e"],
 "\[LineSeparator]",
 "gives the form ",
 StyleBox["R\[Alpha]", "TI"],
 " of the alternating ",
 StyleBox["k", "TI"],
 "-cochain ",
 StyleBox["\[Alpha]", "TI"],
 ": its germ at the vertex ",
 StyleBox["v", "TI"],
 " reads ",
 StyleBox["\[Alpha]", "TI"],
 " with ",
 StyleBox["v", "TI"],
 " prepended, ",
 StyleBox["(R\[Alpha])(v; w\:2081, \[Ellipsis], w\:2096) = \[Alpha](v, \
w\:2081, \[Ellipsis], w\:2096)", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"b7b8a0ac-532c-4d8c-82ec-af203c8786fb"],

Cell[TextData[{
 "Definition: ",
 StyleBox["(R\[Alpha])(v; w\:2081, \[Ellipsis], w\:2096) = \[Alpha](v, \
w\:2081, \[Ellipsis], w\:2096)", "TI"],
 " for every vertex ",
 StyleBox["v", "TI"],
 " and every ",
 StyleBox["k", "TI"],
 "-tuple of distinct neighbours of ",
 StyleBox["v", "TI"],
 ". It maps the ",
 StyleBox["k", "TI"],
 "-cochains to the ",
 StyleBox["k", "TI"],
 "-forms."
}], "Notes",ExpressionUUID->"5cd50776-0754-42f8-8797-704ca760177e"],

Cell[TextData[{
 StyleBox["R\[Alpha]", "TI"],
 " vanishes on every tuple of neighbours that does not span a clique with ",
 StyleBox["v", "TI"],
 ", since ",
 StyleBox["\[Alpha]", "TI"],
 " does. A vertex that lies on no clique where ",
 StyleBox["\[Alpha]", "TI"],
 " has a value gets no germ."
}], "Notes",ExpressionUUID->"320c959e-4246-49ae-8be0-d1c013ebc596"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IntegrationMap"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/IntegrationMap", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e24b61f7-d046-44c8-8b31-56c6e5588f9a"],
 " is a left inverse, ",
 StyleBox["I(R\[Alpha]) = \[Alpha]", "TI"],
 " in every degree, so ",
 StyleBox["R", "TI"],
 " is injective. In degree 1 its image is the forms that are antisymmetric \
across every edge, ",
 StyleBox["\[Omega](v; w) = \[Minus]\[Omega](w; v)", "TI"],
 "."
}], "Notes",ExpressionUUID->"9cacc659-6875-4e51-af38-dc6b57e9fdf2"],

Cell[TextData[{
 "In degree 0 a cochain and its form carry the same values, and the \
restriction of the coboundary of a 0-cochain ",
 StyleBox["f", "TI"],
 " is the gradient of its 0-form: ",
 StyleBox["(R\[Delta]f)(v; w) = \[Delta]f(v, w) = f(w) \[Minus] f(v)", "TI"],
 "."
}], "Notes",ExpressionUUID->"6a955b30-38e8-4479-a95a-9a67520b1ddf"]
}, Open  ]],

