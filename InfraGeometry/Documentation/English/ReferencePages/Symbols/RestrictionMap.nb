Cell["\<\
The 2-cochain that is 1 on one triangle at the centre of the mesh. Its form \
has a germ at each corner, on the other two corners, with the sign of putting \
the corner in front:\
\>", "ExampleText",ExpressionUUID->"008c02f4-d73a-4fcc-9fb2-6eae01e3fcc2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"FindClique", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", "3", "}"}], ",", " ", "All"}], "]"}], ",", " ", 
         RowBox[{"MemberQ", "[", "c", "]"}]}], "]"}]}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"form", " ", "=", " ", 
     RowBox[{"RestrictionMap", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"<|", 
        RowBox[{"t", " ", "->", " ", "1"}], "|>"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", "t", "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"FormValue", "[", 
          RowBox[{"form", ",", " ", "#", ",", " ", 
           RowBox[{"DeleteCases", "[", 
            RowBox[{"t", ",", " ", "#"}], "]"}]}], "]"}], " ", "&"}], " ", "/@",
         " ", "t"}], ")"}]}], ",", "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"bda7c1bc-1d38-456f-af40-24759f2de063"],

