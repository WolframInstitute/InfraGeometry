Cell["\<\
The restriction of the coboundary of a 0-cochain is the gradient of its \
0-form, here for the distance from the centre.\
\>", "ExampleText",ExpressionUUID->"f90d3e27-3b00-43ec-8340-a2dca6b56e60"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"center", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"form", " ", "=", " ", 
     RowBox[{"RestrictionMap", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"AssociationMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "center", ",", " ", 
              RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
           RowBox[{"List", " ", "/@", " ", 
            RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"gradient", " ", "=", " ", 
     RowBox[{"FormDifferential", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"ZeroForm", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "center", ",", " ", "#"}], "]"}], " ", 
          "&"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{"Catenate", " ", "@*", " ", "Keys", " ", "@*", " ", 
            RowBox[{"Select", "[", "Positive", "]"}]}], ",", " ", 
           "gradient"}], "]"}], ",", " ", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{"Catenate", " ", "@*", " ", "Keys", " ", "@*", " ", 
            RowBox[{"Select", "[", "Negative", "]"}]}], ",", " ", 
           "gradient"}], "]"}]}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"KeySort", "[", 
       RowBox[{"KeySort", " ", "/@", " ", "form"}], "]"}], " ", "===", " ", 
      RowBox[{"KeySort", "[", 
       RowBox[{"KeySort", " ", "/@", " ", "gradient"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6a47ec41-d6c4-474a-b276-d591a8aecf8d"],

