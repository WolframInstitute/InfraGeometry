Cell["\<\
The restriction of the coboundary of the distance from the centre is the \
gradient of the distance:\
\>", "ExampleText",ExpressionUUID->"c2ce55e3-a91c-4a63-a5f1-18786e68adc5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
     
     RowBox[{"{", 
      RowBox[{"f", " ", "=", " ", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"List", " ", "/@", " ", 
          RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{
      RowBox[{"KeySort", "[", 
       RowBox[{"KeySort", " ", "/@", " ", 
        RowBox[{"RestrictionMap", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"Coboundary", "[", 
           RowBox[{"g", ",", " ", "f"}], "]"}]}], "]"}]}], "]"}], " ", "==", 
      "\n", "      ", 
      RowBox[{"KeySort", "[", 
       RowBox[{"KeySort", " ", "/@", " ", 
        RowBox[{"FormDifferential", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"ZeroForm", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", 
             "&"}]}], "]"}]}], "]"}]}], "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
