Cell["\<\
With the graph metric the common point can be any vertex of the graph. The \
four corners of a square of the grid: the largest simplex has 3 vertices at \
radius 1 and all 4 at radius 2:\
\>", "ExampleText",ExpressionUUID->"18ed84fa-75a6-45c9-8690-ad98c3638db7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"First", " ", "/@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindCycle", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", ",", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", "4", "}"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{"Length", " ", "/@", " ", 
       RowBox[{"CechComplex", "[", 
        RowBox[{"corners", ",", " ", "r", ",", " ", 
         RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}]}], "]"}]}], "]"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "1", ",", " ", "2"}], "}"}]}], "]"}]}], 
