Cell["\<\
The nerve of a smallest cover of the hexagonal tiling by balls of radius 3: \
an edge joins two centres whose balls meet.\
\>", "ExampleText",ExpressionUUID->"01a0c0e1-27c2-4b02-aef0-74a6dca4e9f7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cover", " ", "=", " ", 
     RowBox[{"FindBallCover", "[", 
      RowBox[{"g", ",", " ", "3"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"nerve", " ", "=", " ", 
     RowBox[{"CechComplex", "[", 
      RowBox[{"cover", ",", " ", "3", ",", " ", 
       RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"Show", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraBall", "[", 
          RowBox[{"#", ",", " ", "3"}], "]"}], " ", "&"}], " ", "/@", " ", 
        "cover"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"Graph", "[", 
      RowBox[{"cover", ",", " ", 
       RowBox[{"UndirectedEdge", " ", "@@@", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"cover", "[", 
            RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{"nerve", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "2"}], " ", 
             "&"}]}], "]"}]}], ")"}]}], ",", "\n", "      ", 
       RowBox[{"VertexCoordinates", " ", "->", " ", 
        RowBox[{"Thread", "[", 
         RowBox[{"cover", " ", "->", " ", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{
              RowBox[{"VertexIndex", "[", 
               RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", 
             " ", "cover"}], "]"}], "]"}]}], "]"}]}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"009822c6-0586-403b-a63e-725e94e470b3"],

