Cell["\<\
The \[CapitalCHacek]ech complex of sixteen random points in the unit square \
at radii 0.08, 0.12 and 0.16, drawn over the disks.\
\>", "ExampleText",ExpressionUUID->"93154f38-034f-4598-b833-dcb2ac8d874a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"16", ",", " ", "2"}], "}"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"complex", " ", "=", " ", 
          RowBox[{"CechComplex", "[", 
           RowBox[{"points", ",", " ", "r"}], "]"}]}], "}"}], ",", "\n", 
        "      ", 
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"{", "\n", "        ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"StandardBlue", ",", " ", 
              RowBox[{"Opacity", "[", "0.15", "]"}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Disk", "[", 
                 RowBox[{"#", ",", " ", "r"}], "]"}], " ", "&"}], " ", "/@", 
               " ", "points"}]}], "}"}], ",", "\n", "        ", 
            RowBox[{"{", 
             RowBox[{"StandardRed", ",", " ", 
              RowBox[{"Opacity", "[", "0.3", "]"}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Polygon", "[", 
                 RowBox[{"points", "[", 
                  RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "&"}], " ", "/@",
                " ", 
               RowBox[{"Select", "[", 
                RowBox[{"complex", ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "3"}], 
                  " ", "&"}]}], "]"}]}]}], "}"}], ",", "\n", "        ", 
            RowBox[{"{", 
             RowBox[{"StandardRed", ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Line", "[", 
                 RowBox[{"points", "[", 
                  RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "&"}], " ", "/@",
                " ", 
               RowBox[{"Select", "[", 
                RowBox[{"complex", ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "2"}], 
                  " ", "&"}]}], "]"}]}]}], "}"}], ",", "\n", "        ", 
            RowBox[{"Point", "[", "points", "]"}]}], "}"}], ",", "\n", 
          "        ", 
          RowBox[{"PlotLabel", " ", "->", " ", "r"}]}], "]"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.08", ",", " ", "0.12", ",", " ", "0.16"}], "}"}]}], 
       "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4086ffea-bb0e-4194-b229-cd6318b9137b"],

