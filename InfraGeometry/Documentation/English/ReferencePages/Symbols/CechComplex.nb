Cell[TextData[{
 "A set of Euclidean points is a simplex exactly when its smallest enclosing \
ball has radius at most ",
 StyleBox["r", "TI"],
 ". The lattice points of the ball of radius 2 at radius 0.75:"
}], "ExampleText",ExpressionUUID->"c0d9799b-d121-41a1-9ce6-4caaed4f450a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "2"}], ",", " ", "2"}], "]"}], ",", " ", "2"}], "]"}],
        ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"Abs", "[", "#", "]"}], "]"}], " ", "<=", " ", "2"}], " ", 
        "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"CechComplex", "[", 
     RowBox[{"points", ",", " ", "0.75"}], "]"}], " ", "===", " ", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"Subsets", "[", 
       RowBox[{
        RowBox[{"Range", " ", "@", " ", 
         RowBox[{"Length", "[", "points", "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"MiniballRadius", "[", 
         RowBox[{"points", "[", 
          RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "<=", " ", "0.75"}], 
       " ", "&"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"19717112-fdb7-4778-850e-13b207b213e4"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"cf410772-dab1-485b-bf2c-0e1bcf3ff9c0"]
}, Open  ]],

Cell[TextData[{
 "The \[CapitalCHacek]ech complex is the ball intersection complex of order \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8445763e-400e-438f-b7be-199e139d1a79"],
 ":"
}], "ExampleText",ExpressionUUID->"222b1266-f91d-44fe-b99b-a0843ed9798c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"data", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "2"}], "]"}], ",",
         " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"CechComplex", "[", 
     RowBox[{"data", ",", " ", "1", ",", " ", 
      RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}]}], "]"}], " ", "===", 
    " ", 
    RowBox[{"BallIntersectionComplex", "[", 
     RowBox[{"data", ",", " ", "1", ",", " ", "Infinity", ",", " ", 
      RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"29db9343-ae54-415f-8486-3e6a7071f81e"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"3c4c84b5-5e8d-4182-9e3c-2c88b81ca779"]
}, Open  ]]
}, Open  ]],

