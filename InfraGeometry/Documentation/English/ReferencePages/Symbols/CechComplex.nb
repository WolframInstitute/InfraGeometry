Cell[CellGroupData[{
Cell["CechComplex", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a4c1f044-d9e3-451b-832c-3e6ebc3d7459"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CechComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/CechComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "593ddf93-c3c2-4bdc-b2de-1c784afd340a"],
 "\[LineSeparator]",
 "gives the \[CapitalCHacek]ech complex of the balls of radius ",
 StyleBox["r", "TI"],
 " about the points of ",
 StyleBox["data", "TI"],
 ": a set of balls is a simplex when they have a common point.",
 "\n"
}], "Usage",ExpressionUUID->"d0cfa1b4-448f-4cff-b7b9-bf550b71fc8d"],

Cell[TextData[{
 "The \[CapitalCHacek]ech complex is the nerve of the balls ",
 StyleBox["B\:1d62", "TI"],
 ": the sets ",
 StyleBox["\[Sigma]", "TI"],
 " of positions with ",
 StyleBox["\[Intersection] B\:1d62 \[NotEqual] \[EmptySet]", "TI"],
 ", ",
 StyleBox["i \[Element] \[Sigma]", "TI"],
 ". It is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    ButtonBox["Infinity",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a02607e-df96-444f-b5fa-efe134693136"],
 " and takes the same options, ",
 Cell[BoxData["\"\<Metric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "238635e7-0b21-4022-a767-ef93bd2732b4"],
 ", ",
 Cell[BoxData["\"\<IntersectionTest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04a941b9-3d3b-43f5-9b2c-e869e39d3a44"],
 " and ",
 Cell[BoxData["\"\<MaxDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca53b52c-5d9a-4f42-ace2-84f0f151833f"],
 "."
}], "Notes",ExpressionUUID->"2b7dc891-01fa-4de4-931e-274a9606401b"],

Cell[TextData[{
 "For Euclidean points a set is a simplex when its points fit in a ball of \
radius ",
 StyleBox["r", "TI"],
 ": ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"MiniballRadius", "[", 
    StyleBox["points", "TI"], "]"}], " ", "\[LessEqual]", " ", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2847a530-ee96-40ac-badf-571ef76ec5ec"],
 ". The balls are convex, and by the nerve theorem the complex has the \
homotopy type of the union of the balls."
}], "Notes",ExpressionUUID->"e69bf337-66ef-4ece-a95f-848a3044571f"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95483ae3-4b04-4ac2-8b21-223eeade0e01"],
 " the points are vertices of the graph ",
 StyleBox["g", "TI"],
 ", and a set is a simplex when some vertex of ",
 StyleBox["g", "TI"],
 " lies within ",
 StyleBox["r", "TI"],
 " of each of them."
}], "Notes",ExpressionUUID->"7cb964cc-6202-4b2a-9e49-2faf6c934c01"],

Cell[TextData[{
 "A simplex is a sorted list of positions in ",
 StyleBox["data", "TI"],
 "."
}], "Notes",ExpressionUUID->"ddfe7017-569d-40ac-b65a-99d418cf872a"]
}, Open  ]],

