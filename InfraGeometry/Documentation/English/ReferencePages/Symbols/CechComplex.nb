Cell[CellGroupData[{
Cell["CechComplex", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1205dbed-0b0e-4ccc-a749-86249e66e9f1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CechComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/CechComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46587132-3340-4129-9e3c-b4bdeb536560"],
 "\[LineSeparator]",
 "gives the \[CapitalCHacek]ech complex of the closed balls of radius ",
 StyleBox["r", "TI"],
 " about the points of ",
 StyleBox["data", "TI"],
 ": a set of balls is a simplex when they have a common point.",
 "\n"
}], "Usage",ExpressionUUID->"5f373e1a-f727-4dcf-a541-447a26d76ddf"],

Cell[TextData[{
 "Definition: the \[CapitalCHacek]ech complex is the nerve of the balls ",
 StyleBox["B_i", "TI"],
 ", the sets ",
 StyleBox["\[Sigma]", "TI"],
 " of positions with ",
 StyleBox["\[Intersection]_(i \[Element] \[Sigma]) B_i \[NotEqual] \
\[EmptySet]", "TI"],
 ". It is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    ButtonBox["Infinity",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e81270f5-2d3e-4b5d-9c97-ed54010d4ac1"],
 " and takes its options: ",
 Cell[BoxData["\"\<Metric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f19a0fd2-cc7f-4492-8ab8-5c4db62abc71"],
 ", ",
 Cell[BoxData["\"\<IntersectionTest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c4bbc537-2c9a-4923-8f2b-10edebcfde0d"],
 ", ",
 Cell[BoxData["\"\<MaxDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0be8bbb7-9249-4564-a610-306e92a7b631"],
 "."
}], "Notes",ExpressionUUID->"17f4a03c-aa4c-4777-918f-825d004c46e5"],

Cell[TextData[{
 "For Euclidean points a set is a simplex when its points fit in a ball of \
radius ",
 StyleBox["r", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"MiniballRadius", "[", 
    StyleBox["points", "TI"], "]"}], " ", "\[LessEqual]", " ", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d611c42c-77e1-4d45-8c4b-85e6745c44dd"],
 ". With ",
 Cell[BoxData["\"\<Metric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea3785af-93f5-4e64-8295-c0fc066a9ca7"],
 " -> ",
 StyleBox["g", "TI"],
 " the points are vertices of the graph ",
 StyleBox["g", "TI"],
 ", and a set is a simplex when some vertex of ",
 StyleBox["g", "TI"],
 " lies within ",
 StyleBox["r", "TI"],
 " of each of them."
}], "Notes",ExpressionUUID->"1eded3cd-b87c-4c57-bb9b-8a5955f40176"],

Cell[TextData[{
 "A simplex is a sorted list of positions in ",
 StyleBox["data", "TI"],
 "."
}], "Notes",ExpressionUUID->"f4a28640-4c4d-4ac9-964e-a8404b546d27"]
}, Open  ]],

