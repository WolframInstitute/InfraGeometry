Cell[CellGroupData[{
Cell["CechComplex", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"58400713-eb01-4978-85a3-78eb9fdd7e17"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CechComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/CechComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b38db383-8a30-4b58-9a70-20fab8b0490c"],
 "\[LineSeparator]",
 "gives the \[CapitalCHacek]ech complex of the closed balls of radius ",
 StyleBox["r", "TI"],
 " about the points of ",
 StyleBox["data", "TI"],
 ": a set of balls is a simplex when they have a common point.",
 "\n"
}], "Usage",ExpressionUUID->"cb4518cf-3061-4aa3-b2a1-d160773a4f86"],

Cell[TextData[{
 "Definition: the \[CapitalCHacek]ech complex is the nerve of the balls ",
 StyleBox["B_i", "TI"],
 ", the sets ",
 StyleBox["\[Sigma]", "TI"],
 " of positions with ",
 StyleBox["\[Intersection]_(i \[Element] \[Sigma]) B_i \[NotEqual] \
\[EmptySet]", "TI"],
 ". It is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    ButtonBox["Infinity",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac0e73d6-3711-4106-aa20-2333040f285f"],
 " and takes its options: ",
 Cell[BoxData["\"\<Metric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7cf908c-60b5-47f6-b263-6c1d146b74fd"],
 ", ",
 Cell[BoxData["\"\<IntersectionTest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59d7e530-c163-4726-87f2-7ff96dec26d6"],
 ", ",
 Cell[BoxData["\"\<MaxDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53783c88-a7b7-48db-82c4-c2e91492ff22"],
 "."
}], "Notes",ExpressionUUID->"5fbc9718-8053-4db6-9844-d8df6d6572b0"],

Cell[TextData[{
 "For Euclidean points a set is a simplex when its points fit in a ball of \
radius ",
 StyleBox["r", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"MiniballRadius", "[", 
    StyleBox["points", "TI"], "]"}], " ", "\[LessEqual]", " ", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c5b726d-abb2-4782-b30e-ce5f6a9031d7"],
 ". With ",
 Cell[BoxData["\"\<Metric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ebf5e57-4c21-4b4e-8653-6d830dded774"],
 " -> ",
 StyleBox["g", "TI"],
 " the points are vertices of the graph ",
 StyleBox["g", "TI"],
 ", and a set is a simplex when some vertex of ",
 StyleBox["g", "TI"],
 " lies within ",
 StyleBox["r", "TI"],
 " of each of them."
}], "Notes",ExpressionUUID->"459c7bcd-1f09-43d3-a366-a69f7abd8322"],

Cell[TextData[{
 "A simplex is a sorted list of positions in ",
 StyleBox["data", "TI"],
 "."
}], "Notes",ExpressionUUID->"57927d32-af6e-409a-a23a-2da5a4b0c468"]
}, Open  ]],

