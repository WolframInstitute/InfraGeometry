Cell[TextData[{
 "A set of Euclidean points is a simplex exactly when its smallest enclosing \
ball has radius at most ",
 StyleBox["r", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"5b962555-df9e-44a7-be79-ff1394f75086"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"16", ",", " ", "2"}], "}"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"complex", " ", "=", " ", 
     RowBox[{"CechComplex", "[", 
      RowBox[{"points", ",", " ", "0.16"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{"{", "\n", "     ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"StandardBlue", ",", " ", 
          RowBox[{"Opacity", "[", "0.15", "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Disk", "[", 
             RowBox[{"#", ",", " ", "0.16"}], "]"}], " ", "&"}], " ", "/@", 
           " ", "points"}]}], "}"}], ",", "\n", "     ", 
        RowBox[{"{", 
         RowBox[{"StandardRed", ",", " ", 
          RowBox[{"Opacity", "[", "0.3", "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Polygon", "[", 
             RowBox[{"points", "[", 
              RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "&"}], " ", "/@", 
           " ", 
           RowBox[{"Select", "[", 
            RowBox[{"complex", ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "3"}], " ", 
              "&"}]}], "]"}]}]}], "}"}], ",", "\n", "     ", 
        RowBox[{"Point", "[", "points", "]"}]}], "}"}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"complex", " ", "==", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Subsets", "[", 
         RowBox[{
          RowBox[{"Range", "[", "16", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "16"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"MiniballRadius", "[", 
           RowBox[{"points", "[", 
            RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "<=", " ", "0.16"}], 
         " ", "&"}]}], "]"}]}]}], "}"}]}], "]"}]], "Input",
