Cell["\<\
The nerve of a smallest cover by balls of radius 3, on the square grid and on \
the square mesh. A line joins two centres whose balls meet:\
\>", "ExampleText",ExpressionUUID->"3ea0eab1-365f-438c-9348-676899e86640"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"cover", " ", "=", " ", 
        RowBox[{"FindBallCover", "[", 
         RowBox[{"g", ",", " ", "3"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"xy", " ", "=", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"edges", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"CechComplex", "[", 
           RowBox[{"cover", ",", " ", "3", ",", " ", 
            RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}]}], "]"}], ",", 
          " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "2"}], " ", 
           "&"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"InfraBall", "[", 
             RowBox[{"#", ",", " ", "3"}], "]"}], " ", "&"}], " ", "/@", " ", 
           "cover"}]}], "]"}], ",", "\n", "      ", 
        RowBox[{"Graphics", "[", 
         RowBox[{"{", 
          RowBox[{"Thick", ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"xy", ",", " ", 
                RowBox[{"cover", "[", 
                 RowBox[{"[", "#", "]"}], "]"}]}], "]"}], "]"}], " ", "&"}], 
            " ", "/@", " ", "edges"}]}], "}"}], "]"}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"ca620dba-ac06-48c7-a789-ebdb4a71ef8a"],

