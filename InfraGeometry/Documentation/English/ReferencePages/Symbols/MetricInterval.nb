    "45", ",", "46", ",", "47", ",", "48", ",", "55", ",", "56", ",", "57", ",",
      "58", ",", "65", ",", "66", ",", "67", ",", "68"}], "}"}], ",", "12"}], 
  "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"8bb93166-4da3-41ae-9004-c215cbeb1e95"]
}, Open  ]]
}, Open  ]],

