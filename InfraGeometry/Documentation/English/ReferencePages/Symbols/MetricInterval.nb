Cell[TextData[{
 "On the grid the interval is a rectangle of ",
 StyleBox["(a + 1)(b + 1)", "TI"],
 " vertices. From 45 to 68 there are 2 and 3 steps:"
}], "ExampleText",ExpressionUUID->"5e3ad427-0239-4f68-8a4d-03fbc3eb2e05"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"interval", " ", "=", " ", 
     RowBox[{"MetricInterval", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", "68"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"interval", ",", " ", 
     RowBox[{"Length", "[", "interval", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"bfe687d9-6431-439f-8210-cd620c7f974f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
