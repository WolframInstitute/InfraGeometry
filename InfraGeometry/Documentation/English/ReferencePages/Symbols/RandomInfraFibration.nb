Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraFibration", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8b514823-a0c2-455a-895d-94b9667439ec"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraFibration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFibration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["base", "TI"], ",", " ", 
    StyleBox["options", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b54f0e06-109e-4540-8dd8-d1041efa3807"],
 "\[LineSeparator]",
 "gives a random ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fac9d3b2-84fe-4d97-9d2c-3c3cfa21dfe0"],
 " whose reconstructed base has the vertices and edges of ",
 StyleBox["base", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"3cb401d7-9c64-43e1-bf03-91e5142f80b7"],

Cell["\<\
The supported base is a finite simple undirected unweighted graph, including \
isolated vertices and the empty graph.\
\>", "Notes",ExpressionUUID->"916f566e-7d07-4f29-9fe2-4b1997f5b9f8"],

Cell[TextData[{
 "Every fiber is nonempty. Its vertices are pairs {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["k", "TI"],
 "}, where ",
 StyleBox["p", "TI"],
 " is a base vertex."
}], "Notes",ExpressionUUID->"47a62c18-3d0f-4186-9723-bbbff6c14525"],

Cell[TextData[{
 "Integer count ranges use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInteger"]], "paclet:ref/RandomInteger"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "756c4407-9ed0-443a-8d5a-2068bd05527f"],
 ". Real density ranges use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomReal"]], "paclet:ref/RandomReal"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "25b14b1c-95c2-4260-b006-371e767b19d9"],
 ". Excess requested vertical edges are capped at the complete graph's edge \
count."
}], "Notes",ExpressionUUID->"a5e5d718-fe87-47b7-9015-eeffb333e3d6"],

Cell["\<\
With isomorphic fibers, one size and one vertical graph are shared by all \
fibers. Otherwise sizes and vertical graphs are drawn separately.\
\>", "Notes",ExpressionUUID->"bded6364-560e-4367-8b7d-09b4607a197b"],

Cell[TextData[{
 "For adjacent fibers of sizes ",
 StyleBox["n", "TI"],
 " and ",
 StyleBox["m", "TI"],
 ", positive numeric density ",
 StyleBox["d", "TI"],
 " retains pairs (",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 ") satisfying Mod[",
 StyleBox["i m", "TI"],
 " - ",
 StyleBox["j n", "TI"],
 ", ",
 StyleBox["n m", "TI"],
 "] < ",
 StyleBox["d", "TI"],
 " Max[",
 StyleBox["n", "TI"],
 ", ",
 StyleBox["m", "TI"],
 "]. This preserves the earlier diagonal-width convention; it is not an \
independent edge probability."
}], "Notes",ExpressionUUID->"5659bcac-138b-4569-9a01-04e92c6b1066"],

Cell[TextData[{
 "Density ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6121a6ec-49e6-4fbb-85b6-f3eb840ee4ed"],
 " joins adjacent fibers completely. Positive numeric density always retains \
an edge over each base edge, but need not give every total vertex a lift."
}], "Notes",ExpressionUUID->"757a0e4a-3edb-46b2-ab57-4531286a8854"],

Cell[TextData[{
 "Drawing coordinates are computed by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraphHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraphHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e194ef74-55ef-4d94-9225-de597e2ec99c"],
 ", separately from construction."
}], "Notes",ExpressionUUID->"8485b2bd-e479-4d8e-99f0-ae0735b9cc81"],

Cell[TextData[{
 "Random draws use the ambient stream controlled by external ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5dfca96e-b340-4faf-90dd-1e2894f0ddd4"],
 ". No per-call seed option is provided."
}], "Notes",ExpressionUUID->"107d268c-e766-40c8-9817-2452ecb5f1d1"],

