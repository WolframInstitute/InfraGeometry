Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraFibration", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"da930449-9790-4148-bcfd-c87871eac7b7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraFibration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFibration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["base", "TI"], ",", " ", 
    StyleBox["options", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cc8588b-2c41-4e40-b8cf-c736a7a6ec2a"],
 "\[LineSeparator]",
 "gives a random ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ba21cbb4-09a1-43b6-9116-f6ea1f07c40d"],
 " whose reconstructed base has the vertices and edges of ",
 StyleBox["base", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"49cd788c-70e2-4402-b03d-782cb7fc078a"],

Cell[TextData[{
 "This is an Experimental compatibility sampler. Use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraFiberedGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFiberedGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8835df36-f85a-4fac-905c-b0603566b9b3"],
 " for new general constructions."
}], "Notes",ExpressionUUID->"fa463a46-8008-4610-91ac-a3a24fd8a122"],

Cell["\<\
Its existing options, scalar exact counts, count ranges, vertical-edge \
clipping and cyclic-width rule are retained. They are distinct from the new \
count grammar.\
\>", "Notes",ExpressionUUID->"53588a3f-7da6-4ec6-9281-5a180ea76bdb"],

Cell["\<\
The supported base is a finite simple undirected unweighted graph, including \
isolated vertices and the empty graph.\
\>", "Notes",ExpressionUUID->"bd64b883-798f-4c32-964c-500e9ceb2b3d"],

Cell[TextData[{
 "Every fiber is nonempty. Its vertices are pairs {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["k", "TI"],
 "}, where ",
 StyleBox["p", "TI"],
 " is a base vertex."
}], "Notes",ExpressionUUID->"88973dd8-8aae-40be-ac3b-5826cd1b1e0c"],

Cell[TextData[{
 "Integer count ranges use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInteger"]], "paclet:ref/RandomInteger"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "addbaece-b4f8-44b1-9194-4f122aae437b"],
 ". Real density ranges use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomReal"]], "paclet:ref/RandomReal"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cc8443c8-43fc-459c-835a-a64c78f66dfb"],
 ". Excess requested vertical edges are capped at the complete graph's edge \
count."
}], "Notes",ExpressionUUID->"f4ced0aa-655f-406d-a6fa-1720de441d43"],

Cell["\<\
With isomorphic fibers, one size and one vertical graph are shared by all \
fibers. Otherwise sizes and vertical graphs are drawn separately.\
\>", "Notes",ExpressionUUID->"fd87d2fb-74d2-4966-af9b-d27a3e464fb4"],

Cell[TextData[{
 "For adjacent fibers of sizes ",
 StyleBox["n", "TI"],
 " and ",
 StyleBox["m", "TI"],
 ", positive numeric density ",
 StyleBox["d", "TI"],
 " retains pairs (",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 ") satisfying Mod[",
 StyleBox["i m", "TI"],
 " - ",
 StyleBox["j n", "TI"],
 ", ",
 StyleBox["n m", "TI"],
 "] < ",
 StyleBox["d", "TI"],
 " Max[",
 StyleBox["n", "TI"],
 ", ",
 StyleBox["m", "TI"],
 "]. This preserves the earlier diagonal-width convention; it is not an \
independent edge probability."
}], "Notes",ExpressionUUID->"c385fd79-d671-4533-b026-6595a9ca34a6"],

Cell[TextData[{
 "Density ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dc5dadb5-13e3-4dc0-9b36-1da725bd6fa4"],
 " joins adjacent fibers completely. Positive numeric density always retains \
an edge over each base edge, but need not give every total vertex a lift."
}], "Notes",ExpressionUUID->"ff91d908-882f-4d09-a36d-651dd2316e0f"],

Cell[TextData[{
 "Drawing coordinates are computed by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraphHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraphHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "92135195-6df2-4fed-969c-3e9755581bfa"],
 ", separately from construction."
}], "Notes",ExpressionUUID->"dfc3eee4-ce15-4205-8450-ab187439d7bd"],

Cell[TextData[{
 "Random draws use the ambient stream controlled by external ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "96f8a090-5621-4e95-8519-dbb0124951ee"],
 ". No per-call seed option is provided."
}], "Notes",ExpressionUUID->"f5bf8026-3a12-432e-9481-4246090a6d45"],

