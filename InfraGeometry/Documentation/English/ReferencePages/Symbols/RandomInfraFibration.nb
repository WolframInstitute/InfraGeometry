Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraFibration", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"35f4673c-5613-4ae6-bd42-13416326e93f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraFibration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFibration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["base", "TI"], ",", " ", 
    StyleBox["options", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "640e7a66-41ee-4115-900a-3c0a97a9da86"],
 "\[LineSeparator]",
 "gives a random ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e7bd5dcd-d73a-4ee5-9df9-b6a3894bec00"],
 " whose reconstructed base has the vertices and edges of ",
 StyleBox["base", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"549de1fc-3d3c-42d4-a44b-fd171196951a"],

Cell[TextData[{
 "This is an Experimental compatibility sampler. Use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraFiberedGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFiberedGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aa524eaa-9e12-4cd5-903d-ba64575ddaec"],
 " for new general constructions."
}], "Notes",ExpressionUUID->"23008938-3ff9-4e05-988f-0712bdf5262b"],

Cell["\<\
Its existing options, scalar exact counts, count ranges, vertical-edge \
clipping and cyclic-width rule are retained. They are distinct from the new \
count grammar.\
\>", "Notes",ExpressionUUID->"ed04f029-e1a8-4cce-8832-c4ce356c4e0b"],

Cell["\<\
The supported base is a finite simple undirected unweighted graph, including \
isolated vertices and the empty graph.\
\>", "Notes",ExpressionUUID->"a9c6ce01-9c42-468f-a637-41ff9e65d251"],

Cell[TextData[{
 "Every fiber is nonempty. Its vertices are pairs {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["k", "TI"],
 "}, where ",
 StyleBox["p", "TI"],
 " is a base vertex."
}], "Notes",ExpressionUUID->"215088e0-0c2b-4188-8506-3636c427b7e8"],

Cell[TextData[{
 "Integer count ranges use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInteger"]], "paclet:ref/RandomInteger"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0490ba9a-d624-419f-ba8d-9e9de5bf7a08"],
 ". Real density ranges use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomReal"]], "paclet:ref/RandomReal"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f824d7dd-f7eb-45a8-a41f-e90961622d2f"],
 ". Excess requested vertical edges are capped at the complete graph's edge \
count."
}], "Notes",ExpressionUUID->"5ce8b579-3a49-437f-997a-7375733a6331"],

Cell["\<\
With isomorphic fibers, one size and one vertical graph are shared by all \
fibers. Otherwise sizes and vertical graphs are drawn separately.\
\>", "Notes",ExpressionUUID->"9763bce3-68e7-4588-a8f9-f62722e3ae5a"],

Cell[TextData[{
 "For adjacent fibers of sizes ",
 StyleBox["n", "TI"],
 " and ",
 StyleBox["m", "TI"],
 ", positive numeric density ",
 StyleBox["d", "TI"],
 " retains pairs (",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 ") satisfying Mod[",
 StyleBox["i m", "TI"],
 " - ",
 StyleBox["j n", "TI"],
 ", ",
 StyleBox["n m", "TI"],
 "] < ",
 StyleBox["d", "TI"],
 " Max[",
 StyleBox["n", "TI"],
 ", ",
 StyleBox["m", "TI"],
 "]. This preserves the earlier diagonal-width convention; it is not an \
independent edge probability."
}], "Notes",ExpressionUUID->"f3e62a31-3ed0-4956-8a44-612fa7123138"],

Cell[TextData[{
 "Density ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e67415bb-9dd2-411e-ad42-2283da1001ff"],
 " joins adjacent fibers completely. Positive numeric density always retains \
an edge over each base edge, but need not give every total vertex a lift."
}], "Notes",ExpressionUUID->"5eb9d1ed-9d64-448d-af83-ebc978d24386"],

Cell[TextData[{
 "Drawing coordinates are computed by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraphHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraphHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "07361580-8aa5-48f6-9e1b-bf014bef1ef2"],
 ", separately from construction."
}], "Notes",ExpressionUUID->"b961a681-4511-4cf0-9aae-12638743b5da"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomSeeding", " ", "->", " ", "Automatic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "474c5d7a-9721-4702-8016-6be1012b7ef8"],
 " (default) seeds each call afresh, independently of ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "708cb626-6ac4-48e1-b7d3-f70fa0e2b0be"],
 "; an integer or string gives a reproducible draw, and ",
 Cell[BoxData["Inherited"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e2b13ce-b5b5-4eb1-9a6f-d73018b15afa"],
 " a local snapshot of the current state. The outer random state is restored \
afterward, as with ",
 ButtonBox["RandomInstance",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/RandomInstance.html"], 
    None}],
 "."
}], "Notes",ExpressionUUID->"04f1ed26-d57c-4d5b-8206-3e81ac352e56"],

