Cell[CellGroupData[{
Cell["RandomInfraFibration", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4cf82eee-b1ff-4dd7-b774-d547e61208a9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraFibration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFibration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["base", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ee61b5e-e370-4605-b328-bd486f6f0d3e"],
 "\[LineSeparator]",
 "gives a random ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "099a2755-c14b-47b5-9ca4-95b79765b7c4"],
 " over the graph ",
 StyleBox["base", "TI"],
 ", each fiber drawn around its base vertex.",
 "\n"
}], "Usage",ExpressionUUID->"51e5ae86-155e-4daf-aea4-a58adfc634ee"],

Cell[TextData[{
 "The total vertices over a base vertex ",
 StyleBox["p", "TI"],
 " are the pairs {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["k", "TI"],
 "}. The fiber vertex ",
 StyleBox["i", "TI"],
 " over ",
 StyleBox["p", "TI"],
 " meets the fiber vertex ",
 StyleBox["j", "TI"],
 " over ",
 StyleBox["q", "TI"],
 " iff ",
 StyleBox["i", "TI"],
 "/",
 StyleBox["n1", "TI"],
 " and ",
 StyleBox["j", "TI"],
 "/",
 StyleBox["n2", "TI"],
 " nearly agree, for ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " within the horizontal radius; the density widens this diagonal matching."
}], "Notes",ExpressionUUID->"2c7166b7-7a76-469a-b9e1-1af3e6bd0c22"],

Cell[TextData[{
 "An option value given as a range {",
 StyleBox["min", "TI"],
 ", ",
 StyleBox["max", "TI"],
 "} is drawn at random for every fiber."
}], "Notes",ExpressionUUID->"96bf619a-cd6e-4a12-b40d-848564784999"],

