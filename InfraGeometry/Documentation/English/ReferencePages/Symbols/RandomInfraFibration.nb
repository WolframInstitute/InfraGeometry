Cell[CellGroupData[{
Cell["RandomInfraFibration", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"169b7596-66c7-4c32-a0c6-c15198dc5134"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraFibration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFibration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["base", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97ac86d8-ab5d-46d2-ab46-3c96613184b9"],
 "\[LineSeparator]",
 "gives a random ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6bde68a1-20f1-43fa-998f-46097509cd0c"],
 " over the graph ",
 StyleBox["base", "TI"],
 ", each fiber drawn around its base vertex.",
 "\n"
}], "Usage",ExpressionUUID->"cf46ef60-3c00-4479-8f5f-c40a8a51e9f3"],

Cell[TextData[{
 "The total vertices over a base vertex ",
 StyleBox["p", "TI"],
 " are the pairs {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["k", "TI"],
 "}. The fiber vertex ",
 StyleBox["i", "TI"],
 " over ",
 StyleBox["p", "TI"],
 " meets the fiber vertex ",
 StyleBox["j", "TI"],
 " over ",
 StyleBox["q", "TI"],
 " iff ",
 StyleBox["i", "TI"],
 "/",
 StyleBox["n1", "TI"],
 " and ",
 StyleBox["j", "TI"],
 "/",
 StyleBox["n2", "TI"],
 " nearly agree, for ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " within the horizontal radius; the density widens this diagonal matching."
}], "Notes",ExpressionUUID->"91440069-9436-43a7-9aed-ffcfc7d9d7bd"],

Cell[TextData[{
 "An option value given as a range {",
 StyleBox["min", "TI"],
 ", ",
 StyleBox["max", "TI"],
 "} is drawn at random for every fiber."
}], "Notes",ExpressionUUID->"9ddf70ec-513f-496f-8e37-adca96ce20be"],

