Cell["\<\
A random fibration over a 3 x 3 grid with three vertices and one edge in each \
fiber. The fiber over the centre is drawn.\
\>", "ExampleText",ExpressionUUID->"d4042f31-982b-4d63-bb0a-0681a91e3950"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraFibration", "[", 
        RowBox[{
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
         RowBox[{"\"\<VerticalVertices\>\"", " ", "->", " ", "3"}], ",", " ", 
         
         RowBox[{"\"\<VerticalEdges\>\"", " ", "->", " ", "1"}]}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"total", ",", " ", 
     RowBox[{"{", 
      RowBox[{"InfraDensity", "[", 
       RowBox[{"total", ",", " ", 
        RowBox[{"VertexList", " ", "@", " ", 
         RowBox[{"InfraFiber", "[", 
          RowBox[{"fib", ",", " ", "5"}], "]"}]}]}], "]"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"12ed502a-6642-47bf-9e10-4e5770628d12"],

