Cell["\<\
A random fibered graph over a grid, with its central fiber highlighted.\
\>", "ExampleText",ExpressionUUID->"adde4319-a805-4291-a1fd-a7866792e683"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFibration", "[", " ", 
      RowBox[{
       RowBox[{"GridGraph", "[", " ", 
        RowBox[{"{", " ", 
         RowBox[{"3", ",", " ", "3"}], " ", "}"}], " ", "]"}], ",", "\n", 
       "      ", 
       RowBox[{"\"\<VerticalVertices\>\"", " ", "->", " ", "3"}], ",", " ", 
       RowBox[{"\"\<VerticalEdges\>\"", " ", "->", " ", "1"}]}], " ", "]"}]}],
     " ", "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", " ", 
      RowBox[{"InfraFiber", "[", " ", 
       RowBox[{"fib", ",", " ", "5"}], " ", "]"}], " ", "}"}]}], " ", "]"}]}],
   " ", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b1844cf0-847b-4d26-8579-b097bd44980f"],

