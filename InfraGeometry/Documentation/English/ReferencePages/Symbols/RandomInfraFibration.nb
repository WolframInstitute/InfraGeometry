Cell[CellGroupData[{

Cell["HorizontalEdgesDensity", "ExampleSubsection",ExpressionUUID->"3d67d05f-5f2b-4eab-a675-c1b1f98b517a"],

Cell["\<\
Complete joins support every section choice and every matching between \
equal-sized fibers.\
\>", "ExampleText",ExpressionUUID->"927b6b6f-f237-421e-b867-e1e40a2846ff"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "3", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFibration", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "6", " ", "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertices\>\"", " ", "->", " ", "3"}], ",", "\n", 
       "      ", 
       RowBox[{"\"\<IsomorphicFibers\>\"", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgesDensity\>\"", " ", "->", " ", "All"}], ",",
        " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "3"}]}], " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"section", " ", "=", " ", 
     RowBox[{"RandomInfraSection", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", " ", "\"\<Continuous\>\"", " ", "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "3"}]}], " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", " ", "section", " ", "}"}]}], " ", "]"}]}], " ", 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"abdb85a0-ec97-4b02-acf7-78c03594431e"],

