Cell[CellGroupData[{
Cell["RandomInfraFibration", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b9ef3c15-0573-4134-816a-82975254c300"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraFibration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFibration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["base", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df129b08-7ce7-4730-bbf0-c146f35c039b"],
 "\[LineSeparator]",
 "gives a random ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0c276be0-a247-40da-b1bc-1deb96950d73"],
 " over the graph ",
 StyleBox["base", "TI"],
 ", each fiber drawn around its base vertex.",
 "\n"
}], "Usage",ExpressionUUID->"e2a66598-4352-4178-bb21-9427b88afc18"],

Cell[TextData[{
 "The total vertices over a base vertex ",
 StyleBox["p", "TI"],
 " are the pairs {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["k", "TI"],
 "}. The fiber vertex ",
 StyleBox["i", "TI"],
 " over ",
 StyleBox["p", "TI"],
 " meets the fiber vertex ",
 StyleBox["j", "TI"],
 " over ",
 StyleBox["q", "TI"],
 " iff ",
 StyleBox["i", "TI"],
 "/",
 StyleBox["n1", "TI"],
 " and ",
 StyleBox["j", "TI"],
 "/",
 StyleBox["n2", "TI"],
 " nearly agree, for ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " within the horizontal radius; the density widens this diagonal matching."
}], "Notes",ExpressionUUID->"18972a38-e4d6-4554-afa0-eb16d14acd30"],

Cell[TextData[{
 "An option value given as a range {",
 StyleBox["min", "TI"],
 ", ",
 StyleBox["max", "TI"],
 "} is drawn at random for every fiber."
}], "Notes",ExpressionUUID->"e2fd56de-deaf-44a0-b63f-a4810831f39c"],

