Cell[CellGroupData[{

Cell["HorizontalEdgesDensity", "ExampleSubsection",ExpressionUUID->"5f37bd25-a3ea-45cd-83c0-e56bdbd78be0"],

Cell[TextData[{
 "With fibers of 3 vertices, density ",
 StyleBox["d", "TI"],
 " gives every vertex ",
 StyleBox["d", "TI"],
 " neighbours over each base neighbour:"
}], "ExampleText",ExpressionUUID->"5b18b1d8-d83f-493c-84fd-610fc1c373f0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fib", " ", "=", " ", 
       RowBox[{"RandomInfraFibration", "[", 
        RowBox[{
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
         RowBox[{"\"\<VerticalVertices\>\"", " ", "->", " ", "3"}], ",", " ", 
         
         RowBox[{"\"\<HorizontalEdgesDensity\>\"", " ", "->", " ", "d"}], ",",
          "\n", "      ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"Union", " ", "@", " ", 
      RowBox[{"Catenate", "[", 
       RowBox[{"Values", " ", "/@", " ", 
        RowBox[{"Values", " ", "@", " ", 
         RowBox[{"InfraEdgeLiftMultiplicity", "[", "fib", "]"}]}]}], 
       "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"d", ",", " ", "3"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0289d1b7-4eb0-4909-b8fc-0b3a1a0a5d9e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", "3", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9d7e11bc-6999-47cf-8fc5-8d0a20a1baa5"]
}, Open  ]]
}, Open  ]],

