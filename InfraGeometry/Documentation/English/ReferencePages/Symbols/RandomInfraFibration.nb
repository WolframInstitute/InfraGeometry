Cell["\<\
A random fibered graph over a grid, with its central fiber highlighted.\
\>", "ExampleText",ExpressionUUID->"a10d6a87-e5ab-4e65-ae34-094d8fd3aeae"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFibration", "[", " ", 
      RowBox[{
       RowBox[{"GridGraph", "[", " ", 
        RowBox[{"{", " ", 
         RowBox[{"3", ",", " ", "3"}], " ", "}"}], " ", "]"}], ",", "\n", 
       "      ", 
       RowBox[{"\"\<VerticalVertices\>\"", " ", "->", " ", "3"}], ",", " ", 
       RowBox[{"\"\<VerticalEdges\>\"", " ", "->", " ", "1"}]}], " ", "]"}]}],
     " ", "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", " ", 
      RowBox[{"InfraFiber", "[", " ", 
       RowBox[{"fib", ",", " ", "5"}], " ", "]"}], " ", "}"}]}], " ", "]"}]}],
   " ", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"77853757-9eb8-4e04-9adb-0ede84273b02"],

