Cell[CellGroupData[{

Cell["HorizontalEdgesDensity", "ExampleSubsection",ExpressionUUID->"ccf59efd-a972-4b99-8356-3522aa4a448a"],

Cell[TextData[{
 "With fibers of 3 vertices, density ",
 StyleBox["d", "TI"],
 " gives every vertex ",
 StyleBox["d", "TI"],
 " neighbours over each base neighbour:"
}], "ExampleText",ExpressionUUID->"05149b36-0ae2-490b-8b50-cd5c37f297ea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fib", " ", "=", " ", 
       RowBox[{"RandomInfraFibration", "[", 
        RowBox[{
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
         RowBox[{"\"\<VerticalVertices\>\"", " ", "->", " ", "3"}], ",", " ", 
         
         RowBox[{"\"\<HorizontalEdgesDensity\>\"", " ", "->", " ", "d"}], ",",
          "\n", "      ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"Union", " ", "@", " ", 
      RowBox[{"Catenate", "[", 
       RowBox[{"Values", " ", "/@", " ", 
        RowBox[{"Values", " ", "@", " ", 
         RowBox[{"InfraEdgeLiftMultiplicity", "[", "fib", "]"}]}]}], 
       "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"d", ",", " ", "3"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"73f342cf-10e8-4756-9bf9-c64db83eb698"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", "3", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"49e75cf1-6b37-40d7-88a6-23692ab6ceb7"]
}, Open  ]]
}, Open  ]],

