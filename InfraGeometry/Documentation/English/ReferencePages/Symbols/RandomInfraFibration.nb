Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraFibration", "ObjectName",ExpressionUUID->"de83b438-709e-4f7b-91d7-efafc2246b92"],

Cell["LLM generated.", "Notes",ExpressionUUID->"275c6bb0-0072-4d22-b98c-b0f208109fab"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"787f3b3b-d79f-4629-bec8-bf6adc2f76a8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraFibration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFibration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["base", "TI"], ",", " ", 
    StyleBox["options", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af9997e6-4452-4311-9512-851a41124014"],
 "\[LineSeparator]",
 "gives a random ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "391b86ce-ef4c-4c16-8889-5e9cc07637e1"],
 " whose reconstructed base has the vertices and edges of ",
 StyleBox["base", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"3d649d01-d624-4226-afb0-e970db0eeb1f"],

Cell[TextData[{
 "This is an Experimental compatibility sampler. Use ",
 Cell[BoxData["RandomInfraFiberedGraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f306e03-170a-4dd7-bdfb-e4b0ddb02bd4"],
 " for new general constructions."
}], "Notes",ExpressionUUID->"94d75679-7212-4da4-8571-7e1aed0eae95"],

Cell["\<\
Its existing options, scalar exact counts, count ranges, vertical-edge \
clipping and cyclic-width rule are retained. They are distinct from the new \
count grammar.\
\>", "Notes",ExpressionUUID->"2a9019c2-cc20-4e09-b7d8-a77f96a722d9"],

Cell["\<\
The supported base is a finite simple undirected unweighted graph, including \
isolated vertices and the empty graph.\
\>", "Notes",ExpressionUUID->"748b818f-f903-4014-b76c-2bb35181b361"],

Cell[TextData[{
 "Every fiber is nonempty. Its vertices are pairs {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["k", "TI"],
 "}, where ",
 StyleBox["p", "TI"],
 " is a base vertex."
}], "Notes",ExpressionUUID->"9263fbed-6015-4761-ad0d-15e69b872343"],

Cell[TextData[{
 "Integer count ranges use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInteger"]], "paclet:ref/RandomInteger"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "17f79d16-4d05-4132-b220-af374e3a94f1"],
 ". Real density ranges use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomReal"]], "paclet:ref/RandomReal"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e5d58f3d-f7f5-4079-836a-1130b09c1ad7"],
 ". Excess requested vertical edges are capped at the complete graph's edge \
count."
}], "Notes",ExpressionUUID->"0c1ef2fe-8cb2-4a60-bd75-99e7a1605bae"],

Cell["\<\
With isomorphic fibers, one size and one vertical graph are shared by all \
fibers. Otherwise sizes and vertical graphs are drawn separately.\
\>", "Notes",ExpressionUUID->"857f87ce-556e-4aad-b8e5-2a1637736e76"],

Cell[TextData[{
 "For adjacent fibers of sizes ",
 StyleBox["n", "TI"],
 " and ",
 StyleBox["m", "TI"],
 ", positive numeric density ",
 StyleBox["d", "TI"],
 " retains pairs (",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 ") satisfying Mod[",
 StyleBox["i m", "TI"],
 " - ",
 StyleBox["j n", "TI"],
 ", ",
 StyleBox["n m", "TI"],
 "] < ",
 StyleBox["d", "TI"],
 " Max[",
 StyleBox["n", "TI"],
 ", ",
 StyleBox["m", "TI"],
 "]. This preserves the earlier diagonal-width convention; it is not an \
independent edge probability."
}], "Notes",ExpressionUUID->"9f004512-6207-479a-abd8-6a568354008b"],

Cell[TextData[{
 "Density ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "14be4175-424e-4e4c-be8a-24d76811acca"],
 " joins adjacent fibers completely. Positive numeric density always retains \
an edge over each base edge, but need not give every total vertex a lift."
}], "Notes",ExpressionUUID->"4666028a-5c1a-4802-8d7b-a0f244866fd0"],

Cell[TextData[{
 "Drawing coordinates are computed by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraphHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraphHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d9f94151-0d3f-47a4-ad63-4e9795d363ea"],
 ", separately from construction."
}], "Notes",ExpressionUUID->"1e1191bc-470d-4db4-9d6b-506a3faeb744"],

Cell[TextData[{
 "Random draws use the ambient stream controlled by external ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f6938876-a7e2-44a1-9886-c2c61e1a6eef"],
 ". No per-call seed option is provided."
}], "Notes",ExpressionUUID->"fd12f3f1-4427-4778-b48b-331cb6d4efd1"],

