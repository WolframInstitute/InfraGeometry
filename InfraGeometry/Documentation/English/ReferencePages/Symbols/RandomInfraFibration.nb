Cell["\<\
A random fibered graph over a grid, with its central fiber highlighted.\
\>", "ExampleText",ExpressionUUID->"ca53597d-09bf-4084-8a7d-75d231bf54cc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFibration", "[", " ", 
      RowBox[{
       RowBox[{"GridGraph", "[", " ", 
        RowBox[{"{", " ", 
         RowBox[{"3", ",", " ", "3"}], " ", "}"}], " ", "]"}], ",", "\n", 
       "      ", 
       RowBox[{"\"\<VerticalVertices\>\"", " ", "->", " ", "3"}], ",", " ", 
       RowBox[{"\"\<VerticalEdges\>\"", " ", "->", " ", "1"}]}], " ", "]"}]}],
     " ", "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", " ", 
      RowBox[{"InfraFiber", "[", " ", 
       RowBox[{"fib", ",", " ", "5"}], " ", "]"}], " ", "}"}]}], " ", "]"}]}],
   " ", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ad8bc879-0117-4db5-a21a-0a5a55ee931c"],

