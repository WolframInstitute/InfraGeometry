Cell["\<\
A random fibered graph over a grid, with its central fiber highlighted.\
\>", "ExampleText",ExpressionUUID->"44bba442-72a3-4e7b-977c-4b6c5089f73d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFibration", "[", " ", 
      RowBox[{
       RowBox[{"GridGraph", "[", " ", 
        RowBox[{"{", " ", 
         RowBox[{"3", ",", " ", "3"}], " ", "}"}], " ", "]"}], ",", "\n", 
       "      ", 
       RowBox[{"\"\<VerticalVertices\>\"", " ", "->", " ", "3"}], ",", " ", 
       RowBox[{"\"\<VerticalEdges\>\"", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", " ", 
      RowBox[{"InfraFiber", "[", " ", 
       RowBox[{"fib", ",", " ", "5"}], " ", "]"}], " ", "}"}]}], " ", "]"}]}],
   " ", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"80b017cc-c450-4d8a-ae08-4e276af69dc4"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{{1, 1}, {1, 2}, {1, 3}, {2, 1}, {2, 2}, {2, 3}, {3, 1}, {3, 2}, {
      3, 3}, {4, 1}, {4, 2}, {4, 3}, {5, 1}, {5, 2}, {5, 3}, {6, 1}, {6, 2}, {
      6, 3}, {7, 1}, {7, 2}, {7, 3}, {8, 1}, {8, 2}, {8, 3}, {9, 1}, {9, 2}, {
      9, 3}}, {Null, {{1, 3}, {4, 5}, {7, 9}, {10, 12}, {13, 14}, {16, 17}, {
       19, 20}, {22, 24}, {25, 26}, {1, 4}, {2, 5}, {3, 6}, {1, 10}, {2, 
       11}, {3, 12}, {4, 7}, {5, 8}, {6, 9}, {4, 13}, {5, 14}, {6, 15}, {7, 
       16}, {8, 17}, {9, 18}, {10, 13}, {11, 14}, {12, 15}, {10, 19}, {11, 
       20}, {12, 21}, {13, 16}, {14, 17}, {15, 18}, {13, 22}, {14, 23}, {15, 
       24}, {16, 25}, {17, 26}, {18, 27}, {19, 22}, {20, 23}, {21, 24}, {22, 
       25}, {23, 26}, {24, 27}}}, {
      EdgeStyle -> {UndirectedEdge[{5, 1}, {5, 2}] -> Directive[
           RGBColor[0.790588, 0.201176, 0.], 
           Opacity[1.], 
           AbsoluteThickness[1.]]}, 
       GraphHighlight -> {{5, 2}, {5, 3}, {5, 1}}, 
