Cell[CellGroupData[{
Cell["RandomInfraFibration", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9e744ea0-6dd5-434a-8f53-82127aa44e78"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraFibration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFibration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["base", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba50cd8f-bcf9-4848-9219-700d25ba7062"],
 "\[LineSeparator]",
 "gives a random ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e5b7f143-210b-4bb5-919d-a74b829fe379"],
 " whose base is the graph ",
 StyleBox["base", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"4562b638-4f35-4fca-8111-21b9a0bc381e"],

Cell[TextData[{
 "The fiber over ",
 StyleBox["p", "TI"],
 " has the vertices {",
 StyleBox["p", "TI"],
 ", 1}, \[Ellipsis], {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["n", "TI"],
 "} and random vertical edges. Over every base edge the transverse edges form \
a band: with fibers of sizes ",
 StyleBox["n", "TI"],
 ", ",
 StyleBox["m", "TI"],
 " and density ",
 StyleBox["d", "TI"],
 ", the vertices {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["i", "TI"],
 "} and {",
 StyleBox["q", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "} are joined iff ",
 StyleBox["(i m \[Minus] j n) mod nm < d max(n, m)", "TI"],
 "."
}], "Notes",ExpressionUUID->"779d1381-1c54-44ef-94b4-712602aee811"],

Cell[TextData[{
 "For fibers of equal size ",
 StyleBox["n", "TI"],
 " the band is cyclic: {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["i", "TI"],
 "} is joined to the {",
 StyleBox["q", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "} with ",
 StyleBox["(i \[Minus] j) mod n < d", "TI"],
 ". So every vertex has exactly ",
 StyleBox["d", "TI"],
 " neighbours over each base neighbour, for ",
 StyleBox["d = 1, \[Ellipsis], n", "TI"],
 ". Density 1 then joins {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["i", "TI"],
 "} to {",
 StyleBox["q", "TI"],
 ", ",
 StyleBox["i", "TI"],
 "}."
}], "Notes",ExpressionUUID->"f0a775eb-3d7d-45ab-a229-aeb954eacc1d"],

Cell["The default, one vertex per fiber, gives a copy of the base.", "Notes",ExpressionUUID->"8a139b3e-86da-47ce-be91-01bb4af2510e"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraFiberedGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFiberedGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "79ca3c23-ee1a-4342-8f2a-8b3b2be1e392"],
 " is the general sampler; this one is Experimental and keeps its own options."
}], "Notes",ExpressionUUID->"37e6c15e-52d9-4e23-9028-3ae8a5ce030b"],

