Cell[CellGroupData[{

Cell["HorizontalEdgesDensity", "ExampleSubsection",ExpressionUUID->"c8192115-57d1-4766-a68f-d6f117c12bc0"],

Cell["\<\
Complete joins support every section choice and every matching between \
equal-sized fibers.\
\>", "ExampleText",ExpressionUUID->"812e4632-b81d-465c-b716-32fc8c7a1682"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "3", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFibration", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "6", " ", "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertices\>\"", " ", "->", " ", "3"}], ",", "\n", 
       "      ", 
       RowBox[{"\"\<IsomorphicFibers\>\"", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgesDensity\>\"", " ", "->", " ", "All"}]}], 
      " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"section", " ", "=", " ", 
     RowBox[{"RandomInfraSection", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", " ", "\"\<Continuous\>\"", " ", "}"}]}]}], " ", "]"}]}], 
    " ", "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", " ", "section", " ", "}"}]}], " ", "]"}]}], " ", 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4b979432-1dd1-4f88-afe4-0324b3445e98"],

