Cell["RandomInfraFibration", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"50b368f0-1fc4-4e41-9073-2a41b90206da"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraFibration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFibration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["base", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f77804a-b227-4038-8703-eccd08a15f06"],
 "\[LineSeparator]",
 "gives a random ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "91fa25c8-5711-4c79-b36f-e59da96356c9"],
 " over the graph ",
 StyleBox["base", "TI"],
 ", each fiber drawn around its base vertex.",
 "\n"
}], "Usage",ExpressionUUID->"2d7c659d-cf82-40d7-8dcc-24f1abdda534"],

Cell[TextData[{
 "The total vertices over a base vertex ",
 StyleBox["p", "TI"],
 " are the pairs {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["k", "TI"],
 "}. The fiber vertex ",
 StyleBox["i", "TI"],
 " over ",
 StyleBox["p", "TI"],
 " meets the fiber vertex ",
 StyleBox["j", "TI"],
 " over ",
 StyleBox["q", "TI"],
 " iff ",
 StyleBox["i", "TI"],
 "/",
 StyleBox["n1", "TI"],
 " and ",
 StyleBox["j", "TI"],
 "/",
 StyleBox["n2", "TI"],
 " nearly agree, for ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " within the horizontal radius; the density widens this diagonal matching."
}], "Notes",ExpressionUUID->"90e0bc55-93c6-4cab-a587-baf73f5feed0"],

Cell[TextData[{
 "An option value given as a range {",
 StyleBox["min", "TI"],
 ", ",
 StyleBox["max", "TI"],
 "} is drawn at random for every fiber."
}], "Notes",ExpressionUUID->"7c8edf86-c4ba-4d51-83cd-89765cfdf282"],

