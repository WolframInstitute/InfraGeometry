Cell[CellGroupData[{
Cell["RandomInfraFibration", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ceb1c92e-d965-4e51-ac03-590b98e39ad7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraFibration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFibration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["base", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5a0a665-72a9-40fe-a4b7-547ab4cae15b"],
 "\[LineSeparator]",
 "gives a random ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ccbc4629-5c50-46f1-a199-9fb9ae2959a4"],
 " whose base is the graph ",
 StyleBox["base", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"f2e3694a-f046-458b-b16b-faa2a381df26"],

Cell[TextData[{
 "The fiber over ",
 StyleBox["p", "TI"],
 " has the vertices {",
 StyleBox["p", "TI"],
 ", 1}, \[Ellipsis], {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["n", "TI"],
 "} and random vertical edges. Over every base edge the transverse edges form \
a band: with fibers of sizes ",
 StyleBox["n", "TI"],
 ", ",
 StyleBox["m", "TI"],
 " and density ",
 StyleBox["d", "TI"],
 ", the vertices {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["i", "TI"],
 "} and {",
 StyleBox["q", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "} are joined iff ",
 StyleBox["(i m \[Minus] j n) mod nm < d max(n, m)", "TI"],
 "."
}], "Notes",ExpressionUUID->"8173faed-e92c-4fcb-90bc-8d57dfbe482b"],

Cell[TextData[{
 "For fibers of equal size ",
 StyleBox["n", "TI"],
 " the band is cyclic: {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["i", "TI"],
 "} is joined to the {",
 StyleBox["q", "TI"],
 ", ",
 StyleBox["j", "TI"],
 "} with ",
 StyleBox["(i \[Minus] j) mod n < d", "TI"],
 ". So every vertex has exactly ",
 StyleBox["d", "TI"],
 " neighbours over each base neighbour, for ",
 StyleBox["d = 1, \[Ellipsis], n", "TI"],
 ". Density 1 then joins {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["i", "TI"],
 "} to {",
 StyleBox["q", "TI"],
 ", ",
 StyleBox["i", "TI"],
 "}."
}], "Notes",ExpressionUUID->"3aded74f-2e07-42f9-a78f-b08de89012af"],

Cell["The default, one vertex per fiber, gives a copy of the base.", "Notes",ExpressionUUID->"74a914ab-c117-4634-b9aa-ff6ee0e931ee"],

