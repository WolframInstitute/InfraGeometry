Cell[TextData[{
 "The circle of radius 1 about a vertex is its link, a ",
 StyleBox["q", "TI"],
 "-cycle. On the icosahedron it has 5 vertices, on the triangulated torus 6, \
on the Klein quartic 7: positive, zero and negative curvature."
}], "ExampleText",ExpressionUUID->"c0bb341c-3b9b-4613-adf9-6feeffe3ce48"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "     ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"map", " ", "=", " ", 
        RowBox[{"TessellationGraph", " ", "@@", " ", "spec"}]}], "}"}], ",", 
      "\n", "     ", 
      RowBox[{"{", 
       RowBox[{"hub", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"VertexList", "[", "map", "]"}]}]}], "}"}], ",", "\n", 
      "     ", 
      RowBox[{"Labeled", "[", "\n", "       ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"map", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"InfraCircle", "[", 
             RowBox[{"hub", ",", " ", 
              RowBox[{"\"\<Radius\>\"", " ", "->", " ", "1"}]}], "]"}], ",", 
            " ", 
            RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
            "hub"}], "}"}], ",", " ", 
          RowBox[{"ImageSize", " ", "->", " ", "200"}]}], "]"}], ",", "\n", 
        "       ", 
        RowBox[{"First", "[", "spec", "]"}]}], "]"}]}], "]"}], ",", "\n", 
    "   ", 
    RowBox[{"{", 
     RowBox[{"spec", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "5"}], "}"}], ",", " ", "1"}], "}"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "6"}], "}"}], ",", " ", "6"}], "}"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "7"}], "}"}], ",", " ", "1"}], "}"}]}], 
       "}"}]}], "}"}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c44d202d-ef5a-41ef-9131-fe85ecaad7b2"],

Cell[BoxData[
 TemplateBox[{
   TemplateBox[{
     GraphicsBox[
      NamespaceBox["NetworkGraphics", 
