Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f8ccfe7d-e384-4172-bf04-992c16fef646"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
