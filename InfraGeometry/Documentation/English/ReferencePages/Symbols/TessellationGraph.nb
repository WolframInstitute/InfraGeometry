  }]], "3ColumnTableMod",ExpressionUUID->"0e5a2bcc-5d01-4d4a-bccc-\
f2a07c6f8657"],

Cell[TextData[{
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac374e97-e3cf-4758-bc2d-77f05134c038"],
 " takes the enumeration of the normal subgroups. ",
 Cell[BoxData["\"\<PSL2\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38192c2a-72af-4d68-acec-c6494dae1864"],
 " takes the quotient PSL(2, \[ScriptL]) of the ",
 StyleBox["k", "TI"],
 "-th prime \[ScriptL] < 50 whose group has a (2, ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ")-generation: a fast way to a large map, not in order of size. ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9cfd6611-d5e4-4938-92ef-b255f5ac616e"],
 " options are passed on to the graph."
}], "Notes",ExpressionUUID->"7f40ca6f-c6a6-4bba-9d32-d637a9b3d6d2"]
}, Open  ]],

