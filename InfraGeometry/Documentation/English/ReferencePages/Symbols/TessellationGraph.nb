Cell[TextData[{
 "The maps of a hyperbolic type are the finite quotients ",
 StyleBox["G", "TI"],
 " of the triangle group, generated by ",
 StyleBox["x", "TI"],
 " of order ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["y", "TI"],
 " of order ",
 StyleBox["q", "TI"],
 " and ",
 StyleBox["xy", "TI"],
 " of order 2. The map of ",
 StyleBox["G", "TI"],
 " has ",
 StyleBox["|G|/q", "TI"],
 " vertices, ",
 StyleBox["|G|/2", "TI"],
 " edges and ",
 StyleBox["|G|/p", "TI"],
 " faces. Quotients up to the order 1100 are enumerated; a quotient whose \
skeleton has a loop or a multiple edge is skipped. Each normal subgroup is \
one map, so a chiral pair counts twice."
}], "Notes",ExpressionUUID->"6ec6b641-a2de-4796-92fa-53fd4ebeb495"],

Cell["\<\
A uniform map is a rectification, truncation or both of a regular map. Snub \
solids and snub and elongated tilings are not built.\
\>", "Notes",ExpressionUUID->"fefdd7fe-8378-4b12-a3a8-2d1639bd1b5b"],

Cell[TextData[{
 "Every map is closed: a circle on a small map wraps round within a few \
steps. Patches of the tilings are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationNeighborhoodGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationNeighborhoodGraph",
     "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2ed42025-1904-42c4-892b-7c329bbcd310"],
 "."
}], "Notes",ExpressionUUID->"5c636805-51e2-4ff9-a90c-f8b7dee5bafb"],

