     StyleBox["p", "TI"], ",", " ", 
     StyleBox["q", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af54dad0-18d7-4ad5-91de-d367e4c6fe02"],
 "\[LineSeparator]",
 "is the smallest regular map of type {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "}, as a graph: ",
 StyleBox["p", "TI"],
 "-gon faces, ",
 StyleBox["q", "TI"],
 " of them at every vertex.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0182532b-5479-4095-bdce-c1bab1fce096"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a232d70e-bcd2-46cb-93d4-daef1bbca3ae"],
 "\[LineSeparator]",
 "is the ",
 StyleBox["k", "TI"],
 "-th map of that type in increasing order of size: the ",
 StyleBox["k", "TI"],
 " \[Times] ",
 StyleBox["k", "TI"],
 " flat torus when the type is Euclidean, the ",
 StyleBox["k", "TI"],
 "-th quotient of the triangle group otherwise.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d668547f-a0e9-4339-9352-6aa4a3a30b9d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["n", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11b8efa4-3881-45b3-b8b3-90bfcee993fb"],
 "\[LineSeparator]",
 "is the ",
 StyleBox["m", "TI"],
 " \[Times] ",
 StyleBox["n", "TI"],
 " flat torus of a Euclidean type.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3d89a37a-6b49-408d-9dcf-1caf57245630"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}], ",", " ", "G"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "747dad9e-c484-40a2-8967-b6b148626c87"],
 "\[LineSeparator]",
 "is the map carried by a (2, ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ")-generation of the finite group ",
 StyleBox["G", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b90685aa-1027-44ba-b5c5-8de25e4d291c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["config", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f05c6595-cf64-483a-9165-41440bc3a1a9"],
 "\[LineSeparator]",
 "is the uniform map with vertex configuration ",
 StyleBox["config", "TI"],
 ", the cyclic list of face sizes around a vertex, built on the ",
 StyleBox["k", "TI"],
 "-th map of its parent type."
}], "Usage",ExpressionUUID->"86eeb416-5ac9-4565-98a8-fc2161951ca1"],

Cell[TextData[{
 "A regular map of type {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} is a closed surface cut into ",
 StyleBox["p", "TI"],
 "-gons, ",
 StyleBox["q", "TI"],
 " at every vertex, with a rotation taking any directed edge to any other. \
The graph is its 1-skeleton. The faces are not returned."
}], "Notes",ExpressionUUID->"93bd4af7-33de-4ed0-94a8-70d2ed6c5b3b"],

Cell[TextData[{
 "The sign of (",
 StyleBox["p", "TI"],
 " \[Minus] 2)(",
 StyleBox["q", "TI"],
 " \[Minus] 2) \[Minus] 4 is the sign of the curvature. It decides the \
surface:"
}], "Notes",ExpressionUUID->"a2432c03-2a74-4954-994f-3074480c291e"],

