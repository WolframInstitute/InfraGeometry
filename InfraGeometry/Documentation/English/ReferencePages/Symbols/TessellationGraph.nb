     "ed97913a-bc7b-4feb-bc46-fb21b16416c6"]}
  }]], "3ColumnTableMod",ExpressionUUID->"d1d595d7-2a75-41ca-8da4-\
13815c7aa62a"],

Cell[TextData[{
 "The Euler characteristic ",
 StyleBox["V", "TI"],
 " \[Minus] ",
 StyleBox["E", "TI"],
 " + ",
 StyleBox["F", "TI"],
 " with ",
 StyleBox["F", "TI"],
 " = 2",
 StyleBox["E", "TI"],
 "/",
 StyleBox["p", "TI"],
 " reads the surface off the graph: 2 on the sphere, 0 on the torus, negative \
on a hyperbolic surface."
}], "Notes",ExpressionUUID->"7c61c5eb-35b5-4de7-9c07-853876aa549f"],

Cell[TextData[{
 "Every map here is ",
 StyleBox["closed",
  FontWeight->"Bold"],
 ". A line or a circle drawn on it wraps round the surface, and on a small \
map the wrap is felt within a few steps. For plane geometry use the patches \
of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6695435e-d384-4f14-8bba-6c01a2d9b8e3"],
 ", which are cut from the infinite tiling and have no wrap."
}], "Notes",ExpressionUUID->"cc42733f-1d12-4fd1-8112-11fb0d2e4a1c"],

Cell[TextData[{
 "The flat tori are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TorusTessellation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TorusTessellation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6c543096-f90a-4ff5-804e-e93b7d8b63b0"],
 " graphs. The uniform maps are built with the Conway operations on a regular \
seed: rectify, truncate and their composites. Apart from the snub cube and \
the snub dodecahedron, the snub and elongated families are not built, and \
give ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bba19721-d128-4599-ad6c-dc65bef4fd48"],
 " with a message."
}], "Notes",ExpressionUUID->"b8eab8a9-875e-401f-8cd9-a40dec412a79"],

