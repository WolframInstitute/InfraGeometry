Cell["\<\
Uniform maps. The configuration {4, 6, 8} is the great rhombicuboctahedron, \
and {4, 4, 5} is the pentagonal prism.\
\>", "ExampleText",ExpressionUUID->"8354925f-b288-4967-8bfd-72d3fb7e5150"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
