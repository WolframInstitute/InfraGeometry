Cell["\<\
The second hyperbolic {3, 7} map has 156 vertices and Euler characteristic \
\[Minus]26, so genus 14.\
\>", "ExampleText",ExpressionUUID->"342c4772-85bc-41c7-8a89-0a311e554162"],

Cell[CellGroupData[{

Cell[BoxData[
