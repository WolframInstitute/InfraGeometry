Cell["\<\
The second hyperbolic {3, 7} map has 156 vertices and Euler characteristic \
\[Minus]26, so genus 14.\
\>", "ExampleText",ExpressionUUID->"ae75c589-91ef-4a63-8643-bf18865cd61b"],

Cell[CellGroupData[{

Cell[BoxData[
