Cell[CellGroupData[{
Cell["TessellationGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a51799b1-f9c3-4d6f-9608-b4defc5d0b8e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["p", "TI"], ",", " ", 
     StyleBox["q", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73bd056d-4d57-4bf5-99fe-609a6be3ab2b"],
 "\[LineSeparator]",
 "is the smallest regular map of type {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "}, as a graph: ",
 StyleBox["p", "TI"],
 "-gon faces, ",
 StyleBox["q", "TI"],
 " of them at every vertex.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0ed309c0-4173-4615-bf29-4fa1d17a0fa4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c8266e1-7969-4e9b-8f41-ab7389dc9a66"],
 "\[LineSeparator]",
 "is the ",
 StyleBox["n", "TI"],
 "-th map of that type: the ",
 StyleBox["n", "TI"],
 " \[Times] ",
 StyleBox["n", "TI"],
 " flat torus when the type is Euclidean, the ",
 StyleBox["n", "TI"],
 "-th PSL(2, \[ScriptL]) quotient when it is hyperbolic.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3762c96e-31bb-46e4-8c6a-7cbaf050e955"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["n", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae020307-54ac-4f1f-8adb-2c066adf438d"],
 "\[LineSeparator]",
 "is the ",
 StyleBox["m", "TI"],
 " \[Times] ",
 StyleBox["n", "TI"],
 " flat torus of a Euclidean type.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c3dd4221-80aa-4f85-be69-99b29b428c6d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}], ",", " ", "G"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c331c889-3b98-4c23-8e87-f7e22bec9dc9"],
 "\[LineSeparator]",
 "is the map carried by a (2, ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ")-generation of the finite group ",
 StyleBox["G", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"56c1b46c-352b-4149-961b-70db00c9d7f6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["config", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "658c1ba5-4d12-4347-b5c3-43a6ce75ce95"],
 "\[LineSeparator]",
 "is the uniform map with vertex configuration ",
 StyleBox["config", "TI"],
 ", the cyclic list of face sizes around a vertex."
}], "Usage",ExpressionUUID->"af2768d9-1f84-467e-95e4-3ac71f85a606"],

Cell[TextData[{
 "A regular map of type {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} is a closed surface cut into ",
 StyleBox["p", "TI"],
 "-gons, ",
 StyleBox["q", "TI"],
 " at every vertex, with a rotation taking any directed edge to any other. \
The graph is its 1-skeleton. The faces are not returned; every face is a \
cycle of length ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"10f9195c-91cd-495e-823c-0f3b6800d647"],

Cell[TextData[{
 "The sign of (",
 StyleBox["p", "TI"],
 " \[Minus] 2)(",
 StyleBox["q", "TI"],
 " \[Minus] 2) \[Minus] 4 is the sign of the curvature. It decides the \
surface:"
}], "Notes",ExpressionUUID->"f193caad-7750-4c8a-be12-ffaae9e9362a"],

