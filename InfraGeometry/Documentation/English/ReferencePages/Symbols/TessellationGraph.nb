     "2e2cfc3e-da91-419d-8e55-9bd11179a165"], Cell[
    "{4, 4}, {3, 6} and {6, 3}, one per size", "TableText",ExpressionUUID->
     "2488d03f-b38f-49ee-95d0-d329ca05f4b4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d644e90d-fbbf-492e-85c9-a74cf727d509"], Cell[
    "> 4", "TableText",ExpressionUUID->
     "c1c68427-5af1-44ad-8aa5-1f2a5b4854d0"], Cell[
    "hyperbolic surface of higher genus", "TableText",ExpressionUUID->
     "74a7b64b-e126-4235-be6a-f18b9f2bfbce"], Cell[
    "quotients of the hyperbolic tiling", "TableText",ExpressionUUID->
     "8908603d-b49b-4840-8d89-459e82cdc4fd"]}
  }]], "3ColumnTableMod",ExpressionUUID->"423b57e8-4f05-4017-9a0e-\
a9eea1889341"],

Cell[TextData[{
 "The Euler characteristic ",
 StyleBox["V", "TI"],
 " \[Minus] ",
 StyleBox["E", "TI"],
 " + ",
 StyleBox["F", "TI"],
 " with ",
 StyleBox["F", "TI"],
 " = 2",
 StyleBox["E", "TI"],
 "/",
 StyleBox["p", "TI"],
 " reads the surface off the graph: 2 on the sphere, 0 on the torus, negative \
on a hyperbolic surface."
}], "Notes",ExpressionUUID->"3da1c24e-c50d-47ed-95f8-527b5f850b00"],

Cell[TextData[{
 "Every map here is ",
 StyleBox["closed",
  FontWeight->"Bold"],
 ". A line or a circle drawn on it wraps round the surface, and on a small \
map the wrap is felt within a few steps. For plane geometry use the patches \
of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "582755f8-984c-45ce-b771-24eedff3dcb5"],
 ", which are cut from the infinite tiling and have no wrap."
}], "Notes",ExpressionUUID->"05414405-e718-493b-8910-36ac27f770c9"],

Cell[TextData[{
 "The flat tori are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TorusTessellation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TorusTessellation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5b2d2d2d-5109-4a95-bb97-18c1b4ff8faf"],
 " graphs. The uniform maps are built with the Conway operations on a regular \
seed: rectify, truncate and their composites. Apart from the snub cube and \
the snub dodecahedron, the snub and elongated families are not built, and \
give ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d94d7d09-9400-4df0-b48f-7bbd7ca77b1c"],
 " with a message."
}], "Notes",ExpressionUUID->"a81a1e4c-ad52-40ee-84fa-7ed85932659c"],

