     "0ceb1099-8324-4c3b-8fd7-12056c1c200e"], Cell[
    "quotients of the hyperbolic tiling", "TableText",ExpressionUUID->
     "aaf68de2-57ef-4319-beb7-65a7c9b71c77"]}
  }]], "3ColumnTableMod",ExpressionUUID->"ee97048b-b491-4ffc-b867-\
0c181fbcb900"],

Cell[TextData[{
 "The Euler characteristic ",
 StyleBox["V", "TI"],
 " \[Minus] ",
 StyleBox["E", "TI"],
 " + ",
 StyleBox["F", "TI"],
 " with ",
 StyleBox["F", "TI"],
 " = 2",
 StyleBox["E", "TI"],
 "/",
 StyleBox["p", "TI"],
 " reads the surface off the graph: 2 on the sphere, 0 on the torus, negative \
on a hyperbolic surface."
}], "Notes",ExpressionUUID->"48ece80f-2188-44a8-b134-85801f0aa963"],

Cell[TextData[{
 "Every map here is ",
 StyleBox["closed",
  FontWeight->"Bold"],
 ". A line or a circle drawn on it wraps round the surface, and on a small \
map the wrap is felt within a few steps. For plane geometry use the patches \
of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "44246548-31dc-44cb-bb2d-55059b05b844"],
 ", which are cut from the infinite tiling and have no wrap."
}], "Notes",ExpressionUUID->"217937a7-9d8b-4ccf-a841-7cd35d723cb3"],

Cell[TextData[{
 "The flat tori are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TorusTessellation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TorusTessellation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "14180543-0a7c-47a1-8752-465d4bfd571d"],
 " graphs. The uniform maps are built with the Conway operations on a regular \
seed: rectify, truncate and their composites. Apart from the snub cube and \
the snub dodecahedron, the snub and elongated families are not built, and \
give ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bc6ca54-b500-4b21-b3c5-c956e7760297"],
 " with a message."
}], "Notes",ExpressionUUID->"27ddf50c-a09b-41a0-8f68-a95e9a51805a"],

