Cell[TextData[{
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5be1e51a-f966-4dfc-8467-35229a39d50c"],
 " takes the enumeration of the normal subgroups. ",
 Cell[BoxData["\"\<PSL2\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de6f3d54-9387-4e7e-9355-c8f8068426f7"],
 " takes the quotient PSL(2, \[ScriptL]) of the ",
 StyleBox["k", "TI"],
 "-th prime \[ScriptL] < 50 whose group has a (2, ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ")-generation: a fast way to a large map, not in order of size. ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5113e070-6dc3-4e6e-a19d-2202614d3c87"],
 " options are passed on to the graph."
}], "Notes",ExpressionUUID->"1417ed17-a5c9-47a2-8e19-7070daa87e9a"]
}, Open  ]],

