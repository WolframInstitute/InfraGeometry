Cell["\<\
The second hyperbolic {3, 7} map has 156 vertices and Euler characteristic \
\[Minus]26, so genus 14.\
\>", "ExampleText",ExpressionUUID->"f5bef695-622f-44d8-9a39-6e894378ceab"],

Cell[CellGroupData[{

Cell[BoxData[
