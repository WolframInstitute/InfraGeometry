Cell[CellGroupData[{
Cell["TessellationGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"25b344be-7311-464e-9aa8-aa5ae9b092ca"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["p", "TI"], ",", " ", 
     StyleBox["q", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f97d25ae-7841-4d6a-9fb3-a155f5a908b9"],
 "\[LineSeparator]",
 "is the smallest regular map of type {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "}, as a graph: ",
 StyleBox["p", "TI"],
 "-gon faces, ",
 StyleBox["q", "TI"],
 " of them at every vertex.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"18d8ee43-ab58-4f5c-9071-7bbca0706169"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b97bcea5-e389-4096-b735-d7df4334a4ec"],
 "\[LineSeparator]",
 "is the ",
 StyleBox["n", "TI"],
 "-th map of that type: the ",
 StyleBox["n", "TI"],
 " \[Times] ",
 StyleBox["n", "TI"],
 " flat torus when the type is Euclidean, the ",
 StyleBox["n", "TI"],
 "-th PSL(2, \[ScriptL]) quotient when it is hyperbolic.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f08daa7a-b664-43b3-bc6b-029d9e65134b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["n", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8aaf4e2-1eff-4213-80f1-04dd032b6df9"],
 "\[LineSeparator]",
 "is the ",
 StyleBox["m", "TI"],
 " \[Times] ",
 StyleBox["n", "TI"],
 " flat torus of a Euclidean type.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"68c51fcf-96bb-4651-95e7-c8c0ebb487b8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}], ",", " ", "G"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60360623-726c-4e25-8f13-8161d0023ecb"],
 "\[LineSeparator]",
 "is the map carried by a (2, ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ")-generation of the finite group ",
 StyleBox["G", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a44f8edf-2fd3-4d91-bf15-c2bc7a7cd540"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["config", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c93aff96-0a28-4371-97cb-0cc7f9c18f5c"],
 "\[LineSeparator]",
 "is the uniform map with vertex configuration ",
 StyleBox["config", "TI"],
 ", the cyclic list of face sizes around a vertex."
}], "Usage",ExpressionUUID->"0e60eff1-4828-4302-91c4-743762e8acb2"],

Cell[TextData[{
 "A regular map of type {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} is a closed surface cut into ",
 StyleBox["p", "TI"],
 "-gons, ",
 StyleBox["q", "TI"],
 " at every vertex, with a rotation taking any directed edge to any other. \
The graph is its 1-skeleton. The faces are not returned; every face is a \
cycle of length ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"4838d973-89ae-464b-8e0e-414cd6f7b0df"],

Cell[TextData[{
 "The sign of (",
 StyleBox["p", "TI"],
 " \[Minus] 2)(",
 StyleBox["q", "TI"],
 " \[Minus] 2) \[Minus] 4 is the sign of the curvature. It decides the \
surface:"
}], "Notes",ExpressionUUID->"94fbd179-d4ef-466d-9da9-f506fe570aff"],

