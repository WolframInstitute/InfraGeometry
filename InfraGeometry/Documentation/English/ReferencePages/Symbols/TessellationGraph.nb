Cell[CellGroupData[{
Cell["TessellationGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ee3bbb87-33bf-4816-ab25-ed077eb18342"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["p", "TI"], ",", " ", 
     StyleBox["q", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dbca29d-dfb6-42fa-a182-3feb8210fc1f"],
 "\[LineSeparator]",
 "is the smallest regular map of type {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "}, as a graph: ",
 StyleBox["p", "TI"],
 "-gon faces, ",
 StyleBox["q", "TI"],
 " of them at every vertex.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"510dc00a-0723-46b7-96a3-861c702d9d4f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee6a56b9-f4e5-4fc3-840e-807be828425f"],
 "\[LineSeparator]",
 "is the ",
 StyleBox["n", "TI"],
 "-th map of that type: the ",
 StyleBox["n", "TI"],
 " \[Times] ",
 StyleBox["n", "TI"],
 " flat torus when the type is Euclidean, the ",
 StyleBox["n", "TI"],
 "-th PSL(2, \[ScriptL]) quotient when it is hyperbolic.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"635a79e3-4246-4183-8336-e278ec45b0aa"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["n", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c795d7a-5577-44cb-94f8-be9ae62447a7"],
 "\[LineSeparator]",
 "is the ",
 StyleBox["m", "TI"],
 " \[Times] ",
 StyleBox["n", "TI"],
 " flat torus of a Euclidean type.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ad39be97-ab0b-4d4a-a773-8c16fed3c94e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}], ",", " ", "G"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f490ce1-318d-481f-8ecd-e08272c699f7"],
 "\[LineSeparator]",
 "is the map carried by a (2, ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ")-generation of the finite group ",
 StyleBox["G", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"077ee198-8010-4331-9f5a-e76b2fa0f89c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["config", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "888bcda9-3443-439a-b7d1-fa740d6523ad"],
 "\[LineSeparator]",
 "is the uniform map with vertex configuration ",
 StyleBox["config", "TI"],
 ", the cyclic list of face sizes around a vertex."
}], "Usage",ExpressionUUID->"2b2bb560-f38c-4aa1-b4ba-2c4fde6ff6cb"],

Cell[TextData[{
 "A regular map of type {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} is a closed surface cut into ",
 StyleBox["p", "TI"],
 "-gons, ",
 StyleBox["q", "TI"],
 " at every vertex, with a rotation taking any directed edge to any other. \
The graph is its 1-skeleton. The faces are not returned; every face is a \
cycle of length ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"c9fbf50b-c89c-47e3-baa6-9d7816b1aef8"],

Cell[TextData[{
 "The sign of (",
 StyleBox["p", "TI"],
 " \[Minus] 2)(",
 StyleBox["q", "TI"],
 " \[Minus] 2) \[Minus] 4 is the sign of the curvature. It decides the \
surface:"
}], "Notes",ExpressionUUID->"ba027853-0406-4883-931d-fa25e6295d2e"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c76cfb28-bda1-4ceb-928f-27db2be5578f"], Cell[TextData[{
