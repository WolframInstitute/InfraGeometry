Cell["\<\
The second hyperbolic {3, 7} map has 156 vertices and Euler characteristic \
\[Minus]26, so genus 14.\
\>", "ExampleText",ExpressionUUID->"36d9c0cf-013f-45c6-8d32-6b60db60e422"],

Cell[CellGroupData[{

