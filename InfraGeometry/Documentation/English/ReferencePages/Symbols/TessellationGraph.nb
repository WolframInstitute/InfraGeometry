       RowBox[{"4", ",", " ", "6", ",", " ", "8"}], "}"}], "]"}], ",", " ", 
     RowBox[{"PolyhedronData", "[", 
      RowBox[{"\"\<GreatRhombicuboctahedron\>\"", ",", 
       " ", "\"\<SkeletonGraph\>\""}], "]"}]}], "]"}], ",", "\n", " ", 
