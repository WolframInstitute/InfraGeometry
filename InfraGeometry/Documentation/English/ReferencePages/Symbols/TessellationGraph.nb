Cell["\<\
The second hyperbolic {3, 7} map has 156 vertices and Euler characteristic \
\[Minus]26, so genus 14.\
\>", "ExampleText",ExpressionUUID->"183c0627-8bbe-468f-a86f-b39f849009bd"],

Cell[CellGroupData[{

Cell[BoxData[
