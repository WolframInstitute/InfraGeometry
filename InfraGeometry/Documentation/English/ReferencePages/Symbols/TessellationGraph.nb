     "68068979-e480-4b45-917f-ba6be62c9455"]}
  }]], "3ColumnTableMod",ExpressionUUID->"b1635eeb-6e50-444a-bb96-\
1351cf0312c0"],

Cell[TextData[{
 "The Euler characteristic ",
 StyleBox["V", "TI"],
 " \[Minus] ",
 StyleBox["E", "TI"],
 " + ",
 StyleBox["F", "TI"],
 " with ",
 StyleBox["F", "TI"],
 " = 2",
 StyleBox["E", "TI"],
 "/",
 StyleBox["p", "TI"],
 " reads the surface off the graph: 2 on the sphere, 0 on the torus, negative \
on a hyperbolic surface."
}], "Notes",ExpressionUUID->"3e4b2ef7-e2fe-4df6-950d-2d1252250dd5"],

Cell[TextData[{
 "Every map here is ",
 StyleBox["closed",
  FontWeight->"Bold"],
 ". A line or a circle drawn on it wraps round the surface, and on a small \
map the wrap is felt within a few steps. For plane geometry use the patches \
of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8e907709-7486-496e-8b6a-2bac80ae1a71"],
 ", which are cut from the infinite tiling and have no wrap."
}], "Notes",ExpressionUUID->"398e554d-8b05-4463-a597-b008f801ee11"],

Cell[TextData[{
 "The flat tori are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TorusTessellation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TorusTessellation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "29753f21-67d9-4f33-ba65-31e6750ecf5e"],
 " graphs. The uniform maps are built with the Conway operations on a regular \
seed: rectify, truncate and their composites. Apart from the snub cube and \
the snub dodecahedron, the snub and elongated families are not built, and \
give ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef27cca9-a4ff-479b-820d-1790fc3990ce"],
 " with a message."
}], "Notes",ExpressionUUID->"c45beb62-4cc6-4322-ae89-7c38fca65888"],

