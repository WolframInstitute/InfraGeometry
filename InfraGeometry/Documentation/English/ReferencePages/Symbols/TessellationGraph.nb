Cell[CellGroupData[{
Cell["TessellationGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"46985fb1-0c18-4d5d-b52f-84b3b271690a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["p", "TI"], ",", " ", 
     StyleBox["q", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cddcb600-6319-4537-aa45-4395c14a386d"],
 "\[LineSeparator]",
 "is the smallest regular map of type {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "}, as a graph: ",
 StyleBox["p", "TI"],
 "-gon faces, ",
 StyleBox["q", "TI"],
 " of them at every vertex.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ef790afd-a8dd-4e8c-814c-7529729e4969"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff23856d-1905-43bd-9cce-e91460d8a90b"],
 "\[LineSeparator]",
 "is the ",
 StyleBox["n", "TI"],
 "-th map of that type: the ",
 StyleBox["n", "TI"],
 " \[Times] ",
 StyleBox["n", "TI"],
 " flat torus when the type is Euclidean, the ",
 StyleBox["n", "TI"],
 "-th PSL(2, \[ScriptL]) quotient when it is hyperbolic.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"24484ccf-aa2a-47cf-940f-833824bca5f6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["n", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb4a9c17-802a-4d5e-8072-6e97c35c3833"],
 "\[LineSeparator]",
 "is the ",
 StyleBox["m", "TI"],
 " \[Times] ",
 StyleBox["n", "TI"],
 " flat torus of a Euclidean type.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a0aeb2f9-156a-47bb-8f98-40915c621054"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}], ",", " ", "G"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "311efc14-b844-4435-b2ad-fedda8ef294d"],
 "\[LineSeparator]",
 "is the map carried by a (2, ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ")-generation of the finite group ",
 StyleBox["G", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4aaf1729-f5f3-4177-a2b1-85b239b9fb80"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["config", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f1122d1-a3fc-4221-9f77-5d265858638a"],
 "\[LineSeparator]",
 "is the uniform map with vertex configuration ",
 StyleBox["config", "TI"],
 ", the cyclic list of face sizes around a vertex."
}], "Usage",ExpressionUUID->"229daf9f-a84f-424d-bdc9-58191b593c83"],

Cell[TextData[{
 "A regular map of type {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} is a closed surface cut into ",
 StyleBox["p", "TI"],
 "-gons, ",
 StyleBox["q", "TI"],
 " at every vertex, with a rotation taking any directed edge to any other. \
The graph is its 1-skeleton. The faces are not returned; every face is a \
cycle of length ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"9558e62f-a599-4549-93d6-6da25fa013d8"],

Cell[TextData[{
 "The sign of (",
 StyleBox["p", "TI"],
 " \[Minus] 2)(",
 StyleBox["q", "TI"],
 " \[Minus] 2) \[Minus] 4 is the sign of the curvature. It decides the \
surface:"
}], "Notes",ExpressionUUID->"0a3252c3-28c0-4403-b614-1a4551cdcec6"],

