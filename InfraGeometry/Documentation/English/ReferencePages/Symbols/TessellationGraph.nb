     "36549ed7-6285-44ea-aec8-9efa089a2618"]}
  }]], "3ColumnTableMod",ExpressionUUID->"39276f92-ea5c-4dca-b186-\
2dc469fff918"],

Cell[TextData[{
 "The Euler characteristic ",
 StyleBox["V", "TI"],
 " \[Minus] ",
 StyleBox["E", "TI"],
 " + ",
 StyleBox["F", "TI"],
 " with ",
 StyleBox["F", "TI"],
 " = 2",
 StyleBox["E", "TI"],
 "/",
 StyleBox["p", "TI"],
 " reads the surface off the graph: 2 on the sphere, 0 on the torus, negative \
on a hyperbolic surface."
}], "Notes",ExpressionUUID->"d5b348a2-b7e3-48b6-91b2-246227b57409"],

Cell[TextData[{
 "Every map here is ",
 StyleBox["closed",
  FontWeight->"Bold"],
 ". A line or a circle drawn on it wraps round the surface, and on a small \
map the wrap is felt within a few steps. For plane geometry use the patches \
of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "540cd31d-6ebf-49a7-bfa5-015764b3537a"],
 ", which are cut from the infinite tiling and have no wrap."
}], "Notes",ExpressionUUID->"17a32a99-5caf-4189-9fc1-5baa6a722e87"],

Cell[TextData[{
 "The flat tori are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TorusTessellation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TorusTessellation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b2c08a09-73fb-4f96-afea-f2758224c1ba"],
 " graphs. The uniform maps are built with the Conway operations on a regular \
seed: rectify, truncate and their composites. Apart from the snub cube and \
the snub dodecahedron, the snub and elongated families are not built, and \
give ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6892ab78-ebcf-4ebf-8523-2c11e15aa84f"],
 " with a message."
}], "Notes",ExpressionUUID->"4dd6aba2-4271-4478-b285-b8c27e4e05c9"],

