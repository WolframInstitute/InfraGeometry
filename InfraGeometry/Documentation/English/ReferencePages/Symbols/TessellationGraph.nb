Cell[TextData[{
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5318c4d-a7d2-4b50-ab87-31057e75525a"],
 " takes the fast construction for the curvature. ",
 Cell[BoxData["\"\<CosetEnumeration\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed8ee8ce-ef41-4ffe-abde-7498e92e0b67"],
 " searches the subgroups of low index in the (2, ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ") triangle group, up to index 24 by default. ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d614c1f-7bb9-4356-9a97-841b1eb8c99e"],
 " options are passed on to the graph."
}], "Notes",ExpressionUUID->"1e93edaf-ed85-4cce-bc90-8cf417b5cc0d"]
}, Open  ]],

