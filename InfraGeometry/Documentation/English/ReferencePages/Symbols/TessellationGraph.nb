      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["n", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "713dc37b-a560-4a0b-a930-43443debbe02"],
 "\[LineSeparator]",
 "is the ",
 StyleBox["m", "TI"],
 " \[Times] ",
 StyleBox["n", "TI"],
 " flat torus of a Euclidean type.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"147ca6e4-9c66-425d-b1f9-098994a1ec87"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
