Cell[TextData[{
 "The fat tube about a segment of length 5 on the square grid against the box \
count, with ",
 StyleBox["(a_1 + 1)(a_2 + 1)", "TI"],
 " the size of the interval and ",
 StyleBox["a_1 + a_2 = 5", "TI"],
 ", and the thin tube about one of its shortest paths below it."
}], "ExampleText",ExpressionUUID->"5271f5af-1be0-4487-a489-f038dc7ac3f1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fat", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", "5"}], "]"}]}], "]"}]}], ")"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"intervalSize", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "fat", ",", " ", "\"\<CountingMeasure\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"geodesic", " ", "=", " ", 
     RowBox[{"RandomInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", "fat"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Show", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"intervalSize", " ", "+", " ", 
        RowBox[{"2", " ", "s", " ", 
         RowBox[{"(", 
          RowBox[{"5", " ", "+", " ", "2"}], ")"}]}], " ", "+", " ", 
        RowBox[{"2", " ", "s", " ", 
         RowBox[{"(", 
          RowBox[{"s", " ", "-", " ", "1"}], ")"}]}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"s", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"{", "\n", "      ", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraTube", "[", 
              RowBox[{"fat", ",", " ", "s"}], "]"}], ",", 
             " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"s", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], ",", 
         "\n", "      ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraTube", "[", 
              RowBox[{"geodesic", ",", " ", "s"}], "]"}], ",", 
             " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"s", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], 
        "}"}], ",", " ", 
       RowBox[{"DataRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "5"}], "}"}]}], ",", " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ac57f0a5-886b-43e9-bd84-726f79e6f465"],

