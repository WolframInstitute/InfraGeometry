Cell["InfraTube", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f54d6c52-eef8-4737-ad36-82f09fc1666c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["core", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf9defc0-9f21-4ab8-b8da-b57e703253cd"],
 "\[LineSeparator]",
 "is the tube of radius ",
 StyleBox["s", "TI"],
 " about ",
 StyleBox["core", "TI"],
 ": the vertices at distance at most ",
 StyleBox["s", "TI"],
 " from it. It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9433efb7-01ed-450c-8686-5f2165e56bc4"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b4c98f95-81dc-4e89-a3df-3f2301c01234"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a9ed65d8-cfa6-4a2c-8d1b-fc2a7854e319"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["core", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", " ", 
      StyleBox["t", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f25c65d6-5ae2-4860-a92b-3c36096a62a0"],
 "\[LineSeparator]",
 "is the mantle: the vertices at distance between ",
 StyleBox["s", "TI"],
 " and ",
 StyleBox["t", "TI"],
 "."
}], "Usage",ExpressionUUID->"56de0430-8a5c-43e0-9a8c-838e13498f2b"],

Cell[TextData[{
 "Definition: the tube of radius ",
 StyleBox["s", "TI"],
 " about ",
 StyleBox["core", "TI"],
 " is ",
 StyleBox["{v : d(v, core) \[LessEqual] s}", "TI"],
 "."
}], "Notes",ExpressionUUID->"6da31fd6-4c63-41f2-b8de-f41356edc9af"],

Cell[TextData[{
 StyleBox["core", "TI"],
 " is a vertex, a vertex list, a density, a walk graph, or a Euclidean head \
such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "327654d8-3422-4767-bde0-71f19beb75b6"],
 ", read through the keys of its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c256b1a-d752-4b48-8b48-cb6098f4a573"],
 ". The tube of a vertex is the ball, and the tube of a segment is the tube \
of the interval."
}], "Notes",ExpressionUUID->"59e5db92-10db-4d26-83ca-7376c326372a"],

Cell[TextData[{
 "The head computes nothing. A tube has one member, the vertex set, and owns \
the same seven properties as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e770cd07-3ae1-483e-af53-f53ee547ae7c"],
 "."
}], "Notes",ExpressionUUID->"5cddc765-53b1-42e4-8c46-c859e6ba2559"],

