Cell["The tube of a vertex is the ball.", "ExampleText",ExpressionUUID->"e0f5a0e1-0daf-4d9b-99dd-823de0a5182b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"RandomInfraTube", "[", " ", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraTube", "[", 
       RowBox[{"c", ",", " ", "3"}], "]"}]}], " ", "]"}], " ", "===", " ", 
    RowBox[{"RandomInfraBall", "[", " ", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraBall", "[", 
       RowBox[{"c", ",", " ", "3"}], "]"}]}], " ", "]"}]}]}], "]"}]}], "Input",\

