Cell["The mantle of radii 2 and 3 about a segment.", "ExampleText",ExpressionUUID->"b4b5f833-9a6d-4f4c-9818-96453a9357d7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraTube", "[", 
        RowBox[{"seg", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", "seg"}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"4afad960-afcc-4968-9b88-bc96e0b4a720"],

