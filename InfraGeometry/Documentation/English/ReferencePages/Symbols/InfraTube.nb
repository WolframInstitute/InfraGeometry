     "71258ce2-a21d-48d1-90d1-833d43f6054b"]], "TableText",ExpressionUUID->
     "059b1072-4b48-457d-97a9-099f15d6d7ba"], Cell[
    "the number of vertices of the tube", "TableText",ExpressionUUID->
