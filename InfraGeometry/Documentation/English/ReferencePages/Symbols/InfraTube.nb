     "2e27cb73-8d8f-450a-a40c-3f64cf135e04"], Cell["\<\
the number of vertices of the tube all of whose neighbours lie in the tube: \
the count without the boundary\
\>", "TableText",ExpressionUUID->"7f2ef3fd-8d21-4546-8e14-a5861654e99e"]}
  }]], "2ColumnTableMod",ExpressionUUID->"365ab97d-3bc2-4104-8b4d-\
d32989f4d66b"],

Cell[TextData[{
 "The Riemannian measure of the tube of radius ",
 StyleBox["s", "TI"],
 " always counts the tube of radius ",
 StyleBox["s \[Minus] 1", "TI"],
 "; on the square grid, away from the rim, it counts nothing more. The tube \
of radius 0 of a segment is its interval, and its Riemannian measure counts \
the inner vertices of the interval: ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ddc02ac-28dd-4da2-87d7-96d307bbc139"],
 " when the segment has one shortest path."
}], "Notes",ExpressionUUID->"5ac41484-aa7c-410c-8aba-f22b4ccaee85"],

Cell[TextData[{
 "The head computes nothing. A tube has one member, the vertex set. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b5a249a9-609e-4f3f-80c3-6c63525eadf7"],
 " also reads ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f52e47cc-001a-408f-b19d-926cb3c5848f"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9fe1984-b76e-43d4-8db6-e21ef0d638de"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7b5d9de-aca8-4552-965a-f7f95e713e51"],
 ", ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2515c3f-b2e1-495c-97f3-f4ea7fea722d"],
 " and ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b02f3ca-df63-4e8b-8fa8-2cafe5882dab"],
 ". The tube is the primitive behind ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCylinder"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dee21119-2fc2-484c-906c-b958cdd29c68"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCone"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCone", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "04b67718-828e-4d91-9639-25692aabf394"],
 ". A tube of an empty core is empty."
}], "Notes",ExpressionUUID->"0beaa02f-6358-462c-aa30-7f1e840d1b25"]
}, Open  ]],

