Cell["The tube of a vertex is the ball.", "ExampleText",ExpressionUUID->"a779492d-c985-4cde-b6f8-55f1b9bea418"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"RandomInfraRepresentative", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraTube", "[", 
       RowBox[{"c", ",", " ", "3"}], "]"}]}], "]"}], " ", "===", " ", 
    RowBox[{"RandomInfraRepresentative", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraBall", "[", 
       RowBox[{"c", ",", " ", "3"}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"6d602c7f-b18c-4718-ad2d-92cb3bca3e08"],

