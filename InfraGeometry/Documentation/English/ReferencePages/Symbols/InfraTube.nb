Notebook[{

Cell[CellGroupData[{
Cell["InfraTube", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"712db057-ddaf-4bca-b35a-8486c4fa84d5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["core", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99ad7ae6-9200-4c4a-bc18-552feaafc245"],
 "\[LineSeparator]",
 "is the tube of radius ",
 StyleBox["s", "TI"],
 " about ",
 StyleBox["core", "TI"],
 ": the vertices at distance at most ",
 StyleBox["s", "TI"],
 " from it. It is a symbolic object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "008087f6-c44a-4d9b-91c6-50e4646a6e62"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7254ba6f-c353-488e-9824-f3f616e55e45"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3639d241-1d43-45e4-ae0e-637671cb6694"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["core", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", " ", 
      StyleBox["t", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "daa3fb07-a9b3-49d9-a07f-33b8445b4966"],
 "\[LineSeparator]",
 "is the mantle: the vertices at distance between ",
 StyleBox["s", "TI"],
 " and ",
 StyleBox["t", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f81fd085-7fb1-4aa5-a0ef-038dd0b1182d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["core", "TI"], ",", " ", 
    StyleBox["profile", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ace7b13-22cc-4376-b637-3775661aac3a"],
 "\[LineSeparator]",
 "lets the radius vary along the core: ",
 StyleBox["profile", "TI"],
 " is a list of radii or bands, one per core vertex, or a function of the \
position ",
 StyleBox["i", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2f67dad4-8e66-4add-bc41-ee38ebda74a1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["profile", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Sliced\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2732478b-9a1a-4245-8ce6-cf32e92c176d"],
 "\[LineSeparator]",
 "reads the profile at the axis vertex that each vertex projects to, and \
gives the solids with flat ends."
}], "Usage",ExpressionUUID->"f041abac-e328-4d3d-ad31-f0ab2060d84e"],

Cell[TextData[{
 "Definition: the tube of radius ",
 StyleBox["s", "TI"],
 " about ",
 StyleBox["core", "TI"],
 " is ",
 StyleBox["{v : d(v, core) \[LessEqual] s}", "TI"],
 "."
}], "Notes",ExpressionUUID->"776c825b-433c-4aa3-a926-3fda839445ee"],

Cell[TextData[{
 StyleBox["core", "TI"],
 " is a vertex, a vertex list, a density, a walk graph, or a Euclidean head \
such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f005276c-94e0-4d75-a5ac-d6088d0e5eb9"],
 ", read through the keys of its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "879ca20a-e627-48f8-a4ce-bcb55b7c183e"],
 ". The tube of a vertex is the ball."
}], "Notes",ExpressionUUID->"19047ef8-80a2-40e5-8df1-348223a834b2"],

Cell[TextData[{
 "The profile is a radius ",
 StyleBox["r", "TI"],
 ", which is the band ",
 StyleBox["{0, r}", "TI"],
 "; a pair of numbers ",
 StyleBox["{s, t}", "TI"],
 ", which is a band constant along the core; a list of radii or bands along \
the core; or a function of the position ",
 StyleBox["i = 1, \[Ellipsis], m", "TI"],
 ". The band profile ",
 StyleBox["{r, r}", "TI"],
 " is the surface, the vertices at distance exactly ",
 StyleBox["r", "TI"],
 "."
}], "Notes",ExpressionUUID->"46f3da0a-59bd-48c1-9739-42ff11ea01dd"],

Cell[TextData[{
 "Option ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Method"]], "paclet:ref/Method"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23c7af81-2e14-4113-83df-c7a2432e4a61"],
 " takes ",
 Cell[BoxData["\"\<Balls\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dce8fd0d-f95d-4851-976a-b5483e1962b8"],
 " (default) or ",
 Cell[BoxData["\"\<Sliced\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "564c16e5-aa4d-4a92-ae54-96e1f907abd0"],
 ". ",
 Cell[BoxData["\"\<Balls\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71be3a44-c764-49f3-a29f-68d2ffa19bd2"],
 " is the union of the balls ",
 StyleBox["B(a_i, r_i)", "TI"],
 " about the core vertices, rounded where the profile jumps and at the ends. ",
 Cell[BoxData["\"\<Sliced\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5abf2f1a-e636-4f17-8565-b2c9937f5048"],
 " needs a walk for a core: slice ",
 StyleBox["i", "TI"],
 " is the set of vertices whose nearest axis vertex is ",
 StyleBox["a_i", "TI"],
 ", a tie lying in every nearest slice, and ",
 StyleBox["v", "TI"],
 " is in the solid when ",
 StyleBox["d(a_i, v)", "TI"],
 " lies in the band of its slice. The axis is prolonged straight on past both \
ends and the vertices nearer a prolongation than the axis are cut, so the \
ends are flat; a closed axis has no ends. A jump of the profile is then a \
sharp step."
}], "Notes",ExpressionUUID->"7d51c1d1-5452-4c8b-9a9f-c7577ae3dbb2"],

Cell[TextData[{
 "The tube of a segment is the tube of its whole interval, not of one \
shortest path: the ",
 StyleBox["fat tube", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["c", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "]"}], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0823d03-7065-4734-bed3-192befa20a45"],
 ". Where the segment has many shortest paths it is fatter than the tube of \
any of them. The ",
 StyleBox["thin tube", "TI"],
 " of one path takes as its core a member that ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1e2e1217-09c5-43f0-a286-5ff82347e626"],
 " gives, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"RandomInfraRepresentative", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      RowBox[{"InfraSegment", "[", 
       RowBox[{
        StyleBox["c", "TI"], ",", " ", 
        StyleBox["p", "TI"]}], "]"}]}], "]"}], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4cd76aa-b853-4449-bf6b-eb2935100c4a"],
 "."
}], "Notes",ExpressionUUID->"83958806-919f-4eaf-b2d3-331aba62823f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f1408346-e7da-42f2-bc03-bbac458eecd1"],
 " gives two measures of a tube:"
}], "Notes",ExpressionUUID->"337d54d0-aa4f-4e78-9911-e0fa329b04e4"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c2e4b209-c075-4c32-a8a0-91014d66d7a5"], Cell["Measure", "TableText",
     FontWeight->Bold,ExpressionUUID->"c87ad277-b4de-48e6-9e37-78e3256079b4"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"462fce2f-643d-4b21-90d4-6c9feaab174c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "94ab9761-c500-4e7f-a10d-198ff2570d7d"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c6a55f2e-90f5-4b74-a202-0bfd8c8852cf"]], "TableText",ExpressionUUID->
     "1f80a6b1-3147-43ab-87a2-0cd9184cf8fd"], Cell[
    "the number of vertices of the tube", "TableText",ExpressionUUID->
     "d1f23511-ae2c-4e86-8b9f-fbbdd2318f52"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "316a1181-b95e-442b-9718-2658a58a1fb8"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1eaa6be3-ab7f-4be6-bb0b-066c0d41aad9"]], "TableText",ExpressionUUID->
     "8851233c-feb0-4f34-82c1-07a02873c0f9"], Cell["\<\
the number of vertices of the tube all of whose neighbours lie in the tube: \
the count without the boundary\
\>", "TableText",ExpressionUUID->"7870d1e3-4a67-45f7-93ba-14bc9e6e419f"]}
  }]], "2ColumnTableMod",ExpressionUUID->"4939eedd-a8a5-4b8b-b4a7-\
64cadf74ba6f"],

Cell[TextData[{
 "The Riemannian measure of the tube of radius ",
 StyleBox["s \[GreaterEqual] 1", "TI"],
 " counts the tube of radius ",
 StyleBox["s \[Minus] 1", "TI"],
 " and the vertices at distance ",
 StyleBox["s", "TI"],
 " from the core that have no neighbour at distance ",
 StyleBox["s + 1", "TI"],
 ". For the fat tube on the square and the cubic grids, away from the rim, \
there are none, so the Riemannian profile is the counting profile one step \
later. The tube of radius 0 of a segment is its interval, and its Riemannian \
measure counts the inner vertices of the interval: ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a78233cb-4442-42d6-b8f9-ea9244832086"],
 " when the segment has one shortest path."
}], "Notes",ExpressionUUID->"eccf9108-ff2d-4380-a62d-a09eb64e360c"],

Cell[TextData[{
 "On ",
 StyleBox["Z^d", "TI"],
 " the fat tube has an exact count. The interval of ",
 StyleBox["c", "TI"],
 " and ",
 StyleBox["p", "TI"],
 " is the box with sides ",
 StyleBox["a_i = |p_i \[Minus] c_i|", "TI"],
 ", and the tube of radius ",
 StyleBox["s", "TI"],
 " about it has ",
 StyleBox["\[CapitalSigma]", "TI"],
 StyleBox["J 2^|J| C(s, |J|) \[CapitalPi]", "TI", "TI"],
 StyleBox["(i \[NotElement] J) (a_i + 1)", "TI"],
 " vertices, the sum over the sets ",
 StyleBox["J", "TI"],
 " of coordinates, with ",
 StyleBox["C", "TI"],
 " the binomial coefficient. On the square grid this is"
}], "Notes",ExpressionUUID->"c00d015a-e772-48da-8f5c-7af992c7e2e7"],

Cell[TextData[{
 StyleBox["(a_1 + 1)(a_2 + 1) + 2s(a_1 + a_2 + 2) + 2s(s \[Minus] 1)", "TI"],
 ","
}], "Notes",ExpressionUUID->"743834a2-5362-44e9-a3a5-fdc40fa61159"],

Cell[TextData[{
 "where ",
 StyleBox["(a_1 + 1)(a_2 + 1)", "TI"],
 " is the number of vertices of the interval and ",
 StyleBox["a_1 + a_2", "TI"],
 " the length of the segment. The Riemannian measure is the same count at ",
 StyleBox["s \[Minus] 1", "TI"],
 ", for ",
 StyleBox["s \[GreaterEqual] 1", "TI"],
 ". A straight segment along an axis has one shortest path, and there the \
thin tube is the fat one, the case ",
 StyleBox["a_2 = 0", "TI"],
 ". The thin tube of a staircase path has no closed form."
}], "Notes",ExpressionUUID->"66f7bda3-ca4e-4f0a-a2d3-e8dc6ce003e0"],

Cell[TextData[{
 "In the continuum two tubes are the references. Gray's expansion is for the \
tube of normal geodesic discs about a geodesic ",
 StyleBox["\[Gamma]", "TI"],
 " of length ",
 StyleBox["L", "TI"],
 " with unit tangent ",
 StyleBox["u", "TI"],
 " in a Riemannian manifold of dimension ",
 StyleBox["n", "TI"],
 ": ",
 StyleBox["\[Omega]_(n\[Minus]1) s^(n\[Minus]1) \[Integral]_0^L (1 \[Minus] \
(Scal + Ric(u, u)) s\.b2 / (6(n + 1)) + O(s\:2074)) dt", "TI"],
 ", with ",
 StyleBox["\[Omega]_k", "TI"],
 " the volume of the Euclidean unit ",
 StyleBox["k", "TI"],
 "-ball. The set of points within ",
 StyleBox["s", "TI"],
 " of a segment adds two half-balls at its ends; in Euclidean space its \
volume is ",
 StyleBox["\[Omega]_(n\[Minus]1) s^(n\[Minus]1) L + \[Omega]_n s^n", "TI"],
 ", the spherocylinder. The thin tube is the graph counterpart of these, \
whose core is a curve. The fat tube is not: on ",
 StyleBox["Z^d", "TI"],
 " its core is a box, which grows with the offset of the two ends."
}], "Notes",ExpressionUUID->"2eaa29c0-e8a5-4b77-818b-39a0b55b583e"],

Cell[TextData[{
 "How the number is measured: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraTube", "[", 
     RowBox[{
      StyleBox["core", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "]"}], ",", " ", 
    StyleBox["measure", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8072cdeb-a530-4eab-b8d8-6c1a8725f004"],
 " takes the vertices within ",
 StyleBox["s", "TI"],
 " of the support of the core, the interval for a segment and one path for a \
representative, and counts them, or counts their ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraInterior"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraInterior", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "10aad00f-8561-4e45-b56b-8f51ff07ac6b"],
 ". The profile is the list over ",
 StyleBox["s = 0, 1, \[Ellipsis]", "TI"],
 "."
}], "Notes",ExpressionUUID->"5d627455-3d51-4220-b3b9-f36a15dce442"],

Cell[TextData[{
 "The head computes nothing. A tube has one member, the vertex set. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e9c87606-42ed-4e33-ada3-494cb3021e8a"],
 " also reads ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c843cd4-1ab2-4b58-b9bc-828f6271277b"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e2c2288-1f8c-4337-b1f6-e26a14d19497"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d17efd5a-be9b-4ae6-ab97-8982367ade14"],
 ", ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c69f4af3-afe2-4e29-a9f9-dae3fdda62ac"],
 " and ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b2e5de0-0c29-4b63-b205-3023064bbfec"],
 ". The tube is the primitive behind ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCylinder"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "facc7412-21d3-4add-b5d7-116488f676f0"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCone"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCone", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fa87af7f-3e2b-4816-9d16-dfcc4ebd3a4d"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSolidOfRevolution"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSolidOfRevolution", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d0b73743-9b1b-48c9-989f-992a401a7c40"],
 ", which are its sliced profiles. A tube of an empty core is empty."
}], "Notes",ExpressionUUID->"02c556d1-3f19-47f2-bfaa-d24167022a60"]
}, Open  ]],

Cell[CellGroupData[{

