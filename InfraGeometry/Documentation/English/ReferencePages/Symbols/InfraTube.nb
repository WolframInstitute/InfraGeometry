Cell["\<\
The two measures against the radius, about a segment of length 6 on the \
square grid. The Riemannian profile is the counting profile one radius later.\
\
\>", "ExampleText",ExpressionUUID->"5f65cbd0-7f2a-43b8-9280-b5185a1fc8fd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", "6"}], "]"}]}], "]"}]}], ")"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"ListLinePlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraTube", "[", 
          RowBox[{"seg", ",", " ", "s"}], "]"}], ",", " ", "measure"}], "]"}],
        ",", " ", 
       RowBox[{"{", 
        RowBox[{"measure", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<CountingMeasure\>\"", ",", 
           " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"s", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"DataRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "5"}], "}"}]}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<CountingMeasure\>\"", ",", 
        " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<s\>\"", ",", " ", "None"}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"de5199b9-908f-40b3-9f4f-0983837b4d49"],

