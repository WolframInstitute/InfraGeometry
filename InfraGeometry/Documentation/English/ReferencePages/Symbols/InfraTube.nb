Cell["The tube of a vertex is the ball.", "ExampleText",ExpressionUUID->"9ac31bfa-ce5c-4c35-b881-a35abcc15af3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"FindInfraRepresentative", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraTube", "[", 
       RowBox[{"c", ",", " ", "3"}], "]"}]}], "]"}], " ", "===", " ", 
    RowBox[{"FindInfraRepresentative", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraBall", "[", 
       RowBox[{"c", ",", " ", "3"}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"10b05c58-4e7c-4979-b603-18cbf29c7373"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c07013a5-0bc1-47f6-b2fd-77a6f484294b"]
}, Open  ]],

Cell["\<\
The tube about a segment holds the ball of every vertex of the interval, so \
its counting measure at slack 0 is the number of vertices of the interval.\
\>", "ExampleText",ExpressionUUID->"add445c8-24d6-464b-bc20-a3a60ef6981d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "4"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraTube", "[", 
       RowBox[{
        RowBox[{"InfraSegment", "[", 
         RowBox[{"c", ",", " ", "p"}], "]"}], ",", " ", "0"}], "]"}], ",", 
      " ", "\"\<CountingMeasure\>\""}], "]"}], " ", "===", " ", 
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraSegment", "[", 
       RowBox[{"c", ",", " ", "p"}], "]"}], ",", 
      " ", "\"\<CountingMeasure\>\""}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f188a8fd-78bb-4dae-b8d5-5e7ac9d2a714"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"dd896017-3d12-4383-83e6-f65b73f0bc47"]
}, Open  ]]
}, Open  ]],

