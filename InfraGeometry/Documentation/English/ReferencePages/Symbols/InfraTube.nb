Cell["The mantle of radii 2 and 3 about a segment.", "ExampleText",ExpressionUUID->"ccdde8cf-8d22-469a-bcd6-b7cfa983492e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"FindInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraTube", "[", 
        RowBox[{"seg", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", "seg"}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"929bcfed-77cc-46e1-ae45-ac4871869944"],

