Cell["The tube of a vertex is the ball.", "ExampleText",ExpressionUUID->"9eccdd93-dc93-430f-a94d-614c6a2dd690"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"FindInfraRepresentative", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraTube", "[", 
       RowBox[{"c", ",", " ", "3"}], "]"}]}], "]"}], " ", "===", " ", 
    RowBox[{"FindInfraRepresentative", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraBall", "[", 
       RowBox[{"c", ",", " ", "3"}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"85bc18c5-ec8d-45c0-83c4-c5da6f6e2ef1"],

