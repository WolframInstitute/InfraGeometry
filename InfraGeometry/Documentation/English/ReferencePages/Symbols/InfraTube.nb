Cell[TextData[{
 "The fat tube about a segment of length 5 on the square grid against the box \
count, with ",
 StyleBox["(a_1 + 1)(a_2 + 1)", "TI"],
 " the size of the interval and ",
 StyleBox["a_1 + a_2 = 5", "TI"],
 ", and the thin tube about one of its shortest paths below it."
}], "ExampleText",ExpressionUUID->"0c397e20-57e7-40b2-a067-71b4b8a68a5c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fat", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "5"}], "]"}]}], ")"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"intervalSize", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "fat", ",", " ", "\"\<CountingMeasure\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"geodesic", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", "fat"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Show", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"intervalSize", " ", "+", " ", 
        RowBox[{"2", " ", "s", " ", 
         RowBox[{"(", 
          RowBox[{"5", " ", "+", " ", "2"}], ")"}]}], " ", "+", " ", 
        RowBox[{"2", " ", "s", " ", 
         RowBox[{"(", 
          RowBox[{"s", " ", "-", " ", "1"}], ")"}]}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"s", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"{", "\n", "      ", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraTube", "[", 
              RowBox[{"fat", ",", " ", "s"}], "]"}], ",", 
             " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"s", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], ",", 
         "\n", "      ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraTube", "[", 
              RowBox[{"geodesic", ",", " ", "s"}], "]"}], ",", 
             " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"s", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], 
        "}"}], ",", " ", 
       RowBox[{"DataRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "5"}], "}"}]}], ",", " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0eb11762-a29f-4274-9c8b-dc7790d3696c"],

