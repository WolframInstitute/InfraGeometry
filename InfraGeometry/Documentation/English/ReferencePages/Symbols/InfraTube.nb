Cell["InfraTube", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"71650c34-8adc-4e3b-91a9-0bc9804e0bb9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["core", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22cfa906-233b-47ee-bd80-f91bbc95f117"],
 "\[LineSeparator]",
 "is the tube of radius ",
 StyleBox["s", "TI"],
 " about ",
 StyleBox["core", "TI"],
 ": the vertices at distance at most ",
 StyleBox["s", "TI"],
 " from it. It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "935c770f-49bc-4358-9675-fa8f7a08f346"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c47d4b4d-fc70-4a32-bb62-d0a6e0cf0d8d"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7511ef9c-53b7-447d-9e79-ec858944edcb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["core", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", " ", 
      StyleBox["t", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fdf5d26c-1733-4fc1-84ce-058fb60e4f8d"],
 "\[LineSeparator]",
 "is the mantle: the vertices at distance between ",
 StyleBox["s", "TI"],
 " and ",
 StyleBox["t", "TI"],
 "."
}], "Usage",ExpressionUUID->"da87af65-d35a-4c03-8e03-0abd305fa5c7"],

Cell[TextData[{
 "Definition: the tube of radius ",
 StyleBox["s", "TI"],
 " about ",
 StyleBox["core", "TI"],
 " is ",
 StyleBox["{v : d(v, core) \[LessEqual] s}", "TI"],
 "."
}], "Notes",ExpressionUUID->"dc32f3b5-5125-46c8-b966-882b7faf426e"],

Cell[TextData[{
 StyleBox["core", "TI"],
 " is a vertex, a vertex list, a density, a walk graph, or a Euclidean head \
such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cb9d788c-3254-4f4c-8c25-a59378f6e352"],
 ", read through the keys of its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56ea17c4-cc87-4a0d-87ed-3cc7bbb3e03e"],
 ". The tube of a vertex is the ball."
}], "Notes",ExpressionUUID->"9348e180-a573-483c-af4e-3aa2482977d5"],

Cell[TextData[{
 "The tube of a segment is the tube of its whole interval, not of one \
shortest path. Where the segment has many shortest paths it is fatter than \
the tube of any of them. The tube of one path takes as its core a member that \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "098f9b98-39e6-4501-9396-679c926406a7"],
 " gives."
}], "Notes",ExpressionUUID->"07576e41-eeab-4ae0-a34d-7fe2c61397d7"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "853ad3c7-775b-461a-a9b1-353290c9cdfc"],
 " gives two measures of a tube:"
}], "Notes",ExpressionUUID->"ad4abca1-f12e-427f-a2f6-f1c83623f670"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "56ccf5d8-8168-460c-b2b9-829c37ee59c1"], Cell["Measure", "TableText",
     FontWeight->Bold,ExpressionUUID->"6d103069-b7dc-4d53-a3a6-dc946ccba4db"],
