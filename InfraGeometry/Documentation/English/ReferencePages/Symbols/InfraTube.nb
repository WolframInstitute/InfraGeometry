Cell["\<\
The two measures against the radius, about a segment of length 6 on the \
square grid. The Riemannian profile is the counting profile one radius later.\
\
\>", "ExampleText",ExpressionUUID->"a3171916-fa26-48df-8048-cda0de05c07f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"FindInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", "6"}], "]"}]}], "]"}]}], ")"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"ListLinePlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraTube", "[", 
          RowBox[{"seg", ",", " ", "s"}], "]"}], ",", " ", "measure"}], "]"}],
        ",", " ", 
       RowBox[{"{", 
        RowBox[{"measure", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<CountingMeasure\>\"", ",", 
           " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"s", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"DataRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "5"}], "}"}]}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<CountingMeasure\>\"", ",", 
        " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<s\>\"", ",", " ", "None"}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"21741b05-1a9a-48ef-b5d9-f4c03f43f61a"],

