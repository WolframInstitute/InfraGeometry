Notebook[{

Cell[CellGroupData[{
Cell["InfraTube", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5b3f9855-2caa-480d-9839-640abd211c89"],
 Cell[BoxData[
  RowBox[{"InfraTube", "[", 
   RowBox[{
    StyleBox["core", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d1f0593-6aba-4e63-b0dd-7c75a6ae1d24"],
 "\[LineSeparator]",
 "is the tube of radius ",
 StyleBox["s", "TI"],
 " about ",
 StyleBox["core", "TI"],
 ": the vertices at distance at most ",
 StyleBox["s", "TI"],
 " from it. It is inert; ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "784210c3-b901-418d-9b56-c3ee39119045"],
 " and ",
 Cell[BoxData["FindInfraRepresentative"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1db81d9c-993b-4a33-a38c-0c6a790764f6"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1d3b29f2-7360-4a7a-8eb7-e926a262ade3"],
 Cell[BoxData[
  RowBox[{"InfraTube", "[", 
   RowBox[{
    StyleBox["core", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", " ", 
      StyleBox["t", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2544b5e-a6f0-455b-884c-c0147ae2a5ed"],
 "\[LineSeparator]",
 "is the mantle: the vertices at distance between ",
 StyleBox["s", "TI"],
 " and ",
 StyleBox["t", "TI"],
 "."
}], "Usage",ExpressionUUID->"03584329-4838-4784-bbdd-22926c64c80e"],

Cell[TextData[{
 "Definition: the tube of radius ",
 StyleBox["s", "TI"],
 " about ",
 StyleBox["core", "TI"],
 " is ",
 StyleBox["{v : d(v, core) \[LessEqual] s}", "TI"],
 "."
}], "Notes",ExpressionUUID->"ce3163ae-d75b-435a-82ba-9e3748ae7a5f"],

Cell[TextData[{
 StyleBox["core", "TI"],
 " is a vertex, a vertex list, a density, a walk graph, or a Euclidean head \
such as ",
 Cell[BoxData["InfraSegment"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97359b35-5c4e-4c2f-a562-8192633640c9"],
 ", read through the keys of its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa848eeb-b7e1-4e36-8ff1-741d4e8416be"],
 ". The tube of a vertex is the ball."
}], "Notes",ExpressionUUID->"1c4e4d9b-e332-4757-acb4-a119bbfcf677"],

Cell[TextData[{
 "The tube of a segment is the tube of its whole interval, not of one \
shortest path: the ",
 StyleBox["fat tube", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{"InfraTube", "[", 
   RowBox[{
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["c", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "]"}], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8275784-880e-458c-9fc7-2c5229c87d80"],
 ". Where the segment has many shortest paths it is fatter than the tube of \
any of them. The ",
 StyleBox["thin tube", "TI"],
 " of one path takes as its core a member that ",
 Cell[BoxData["FindInfraRepresentative"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99afa593-e624-45be-a351-20f8f240dd91"],
 " gives, ",
 Cell[BoxData[
  RowBox[{"InfraTube", "[", 
   RowBox[{
    RowBox[{"FindInfraRepresentative", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      RowBox[{"InfraSegment", "[", 
       RowBox[{
        StyleBox["c", "TI"], ",", " ", 
        StyleBox["p", "TI"]}], "]"}]}], "]"}], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13d2288d-d9c1-44a8-8fba-b1f80429fb06"],
 "."
}], "Notes",ExpressionUUID->"8d174f2c-4455-4170-b053-7a3d7fce48d1"],

Cell[TextData[{
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d86a4e0b-fbe8-4a41-a4f4-44471023e920"],
 " gives two measures of a tube:"
}], "Notes",ExpressionUUID->"2dd17272-5883-437d-b7d7-ab747b731afa"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "220d6850-a3e3-41f1-8710-f6c96a89bd05"], Cell["Measure", "TableText",
     FontWeight->Bold,ExpressionUUID->"a4daf358-acc8-43f4-a81e-1ffa45ce6239"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"374fd726-acf9-4ed8-b45f-f7a883d44e0d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fc0f38f1-c384-4407-9cda-bdb699990ae4"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3a04f350-945f-4c0a-8da4-5ed94dd916d4"]], "TableText",ExpressionUUID->
     "cd971d75-85f0-4184-bf62-f6ee367f91c1"], Cell[
    "the number of vertices of the tube", "TableText",ExpressionUUID->
     "9b68c8f6-e6c1-4fdf-ae4a-8f867f792c7a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6d1fdae5-8055-47f3-a028-a7720e8ca3c9"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d8853636-2e52-41fc-a085-a45b318290c9"]], "TableText",ExpressionUUID->
     "3f7eaf73-8e24-4f9c-bd94-126a2688bfd2"], Cell["\<\
the number of vertices of the tube all of whose neighbours lie in the tube: \
the count without the boundary\
\>", "TableText",ExpressionUUID->"658c9dae-29c0-4a08-bd91-7e3047f8a0da"]}
  }]], "2ColumnTableMod",ExpressionUUID->"655f4eee-3f68-445d-9356-\
c625782ed2de"],

Cell[TextData[{
 "The Riemannian measure of the tube of radius ",
 StyleBox["s \[GreaterEqual] 1", "TI"],
 " counts the tube of radius ",
 StyleBox["s \[Minus] 1", "TI"],
 " and the vertices at distance ",
 StyleBox["s", "TI"],
 " from the core that have no neighbour at distance ",
 StyleBox["s + 1", "TI"],
 ". For the fat tube on the square and the cubic grids, away from the rim, \
there are none, so the Riemannian profile is the counting profile one step \
later. The tube of radius 0 of a segment is its interval, and its Riemannian \
measure counts the inner vertices of the interval: ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88a90582-7775-4d26-a40a-ab08986b762d"],
 " when the segment has one shortest path."
}], "Notes",ExpressionUUID->"f8b3eb32-7d02-4b26-a110-940477b343e4"],

Cell[TextData[{
 "On ",
 StyleBox["Z^d", "TI"],
 " the fat tube has an exact count. The interval of ",
 StyleBox["c", "TI"],
 " and ",
 StyleBox["p", "TI"],
 " is the box with sides ",
 StyleBox["a_i = |p_i \[Minus] c_i|", "TI"],
 ", and the tube of radius ",
 StyleBox["s", "TI"],
 " about it has ",
 StyleBox["\[CapitalSigma]", "TI"],
 StyleBox["J 2^|J| C(s, |J|) \[CapitalPi]", "TI", "TI"],
 StyleBox["(i \[NotElement] J) (a_i + 1)", "TI"],
 " vertices, the sum over the sets ",
 StyleBox["J", "TI"],
 " of coordinates, with ",
 StyleBox["C", "TI"],
 " the binomial coefficient. On the square grid this is"
}], "Notes",ExpressionUUID->"d7168d42-3bfb-4123-a929-2416a16f9f12"],

Cell[TextData[{
 StyleBox["(a_1 + 1)(a_2 + 1) + 2s(a_1 + a_2 + 2) + 2s(s \[Minus] 1)", "TI"],
 ","
}], "Notes",ExpressionUUID->"bc5d9dda-60b4-4784-b32a-8a2cfb1721d3"],

Cell[TextData[{
 "where ",
 StyleBox["(a_1 + 1)(a_2 + 1)", "TI"],
 " is the number of vertices of the interval and ",
 StyleBox["a_1 + a_2", "TI"],
 " the length of the segment. The Riemannian measure is the same count at ",
 StyleBox["s \[Minus] 1", "TI"],
 ", for ",
 StyleBox["s \[GreaterEqual] 1", "TI"],
 ". A straight segment along an axis has one shortest path, and there the \
thin tube is the fat one, the case ",
 StyleBox["a_2 = 0", "TI"],
 ". The thin tube of a staircase path has no closed form."
}], "Notes",ExpressionUUID->"12c6a89b-b69e-417f-bd38-2099ec4b41ae"],

Cell[TextData[{
 "In the continuum two tubes are the references. Gray's expansion is for the \
tube of normal geodesic discs about a geodesic ",
 StyleBox["\[Gamma]", "TI"],
 " of length ",
 StyleBox["L", "TI"],
 " with unit tangent ",
 StyleBox["u", "TI"],
 " in a Riemannian manifold of dimension ",
 StyleBox["n", "TI"],
 ": ",
 StyleBox["\[Omega]_(n\[Minus]1) s^(n\[Minus]1) \[Integral]_0^L (1 \[Minus] \
(Scal + Ric(u, u)) s\.b2 / (6(n + 1)) + O(s\:2074)) dt", "TI"],
 ", with ",
 StyleBox["\[Omega]_k", "TI"],
 " the volume of the Euclidean unit ",
 StyleBox["k", "TI"],
 "-ball. The set of points within ",
 StyleBox["s", "TI"],
 " of a segment adds two half-balls at its ends; in Euclidean space its \
volume is ",
 StyleBox["\[Omega]_(n\[Minus]1) s^(n\[Minus]1) L + \[Omega]_n s^n", "TI"],
 ", the spherocylinder. The thin tube is the graph counterpart of these, \
whose core is a curve. The fat tube is not: on ",
 StyleBox["Z^d", "TI"],
 " its core is a box, which grows with the offset of the two ends."
}], "Notes",ExpressionUUID->"9fe63a07-89a4-4a68-9308-ffcc3f7439b9"],

Cell[TextData[{
 "How the number is measured: ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraTube", "[", 
     RowBox[{
      StyleBox["core", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "]"}], ",", " ", 
    StyleBox["measure", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2114350d-182b-4216-87ce-9a033226e9ee"],
 " takes the vertices within ",
 StyleBox["s", "TI"],
 " of the support of the core, the interval for a segment and one path for a \
representative, and counts them, or counts their ",
 Cell[BoxData["InfraInterior"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "174b208a-cb29-4017-a2f6-6a011d5a5506"],
 ". The profile is the list over ",
 StyleBox["s = 0, 1, \[Ellipsis]", "TI"],
 "."
}], "Notes",ExpressionUUID->"976c9a3d-1bc0-4616-9bcb-0a6e2ae3f055"],

Cell[TextData[{
 "The head computes nothing. A tube has one member, the vertex set. ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "350dba1b-ca74-4c67-9d88-c10b38661237"],
 " also reads ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "530fc59a-8490-4b7b-bd06-0879402cdbc5"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d15d7ca-a3a7-401a-bc4d-ae19d738687e"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d81b975-2309-4bd0-b5c9-34c2878775b1"],
 ", ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10cdc333-bfd1-4ca2-bae2-bdcd5aa9b769"],
 " and ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c777448f-2a5d-438d-86a7-73cd0991f29d"],
 ". The tube is the primitive behind ",
 Cell[BoxData["InfraCylinder"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "633da4b1-eb51-4657-ad09-d5a9ec50fcd2"],
 " and ",
 Cell[BoxData["InfraCone"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c12460a-a0c7-457b-9b82-57979f0658d3"],
 ". A tube of an empty core is empty."
}], "Notes",ExpressionUUID->"20d47f75-cfd8-4a26-9241-d1163bcf6f0a"]
}, Open  ]],

