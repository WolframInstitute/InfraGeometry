Notebook[{

Cell[CellGroupData[{
Cell["InfraTube", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e517d99d-8447-46dc-96fa-1fa0936af96c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["core", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9184ddb7-5804-4ea9-8c09-f6e997889213"],
 "\[LineSeparator]",
 "is the tube of radius ",
 StyleBox["s", "TI"],
 " about ",
 StyleBox["core", "TI"],
 ": the vertices at distance at most ",
 StyleBox["s", "TI"],
 " from it. It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c686ee3e-667e-4b3f-9add-d5ce84bbd89c"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f557cc8e-c37e-4301-bda9-36f22c1cf5f0"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"05dc7a99-883e-465b-bf45-3baadb240b60"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["core", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", " ", 
      StyleBox["t", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9cd2d524-01be-4a5d-88bc-ddb9b64d5ee5"],
 "\[LineSeparator]",
 "is the mantle: the vertices at distance between ",
 StyleBox["s", "TI"],
 " and ",
 StyleBox["t", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"98222f7a-e578-43d9-b3b3-1212b51f6eeb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["core", "TI"], ",", " ", 
    StyleBox["profile", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "976676e3-47f9-4e32-a6a0-5ecc6fd3e7f1"],
 "\[LineSeparator]",
 "lets the radius vary along the core: ",
 StyleBox["profile", "TI"],
 " is a list of radii or bands, one per core vertex, or a function of the \
position ",
 StyleBox["i", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e3089931-a601-4da6-910d-56cc640f17bf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["profile", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Sliced\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f29a23e1-1a96-4e39-877f-9f18c73048b1"],
 "\[LineSeparator]",
 "reads the profile at the axis vertex that each vertex projects to, and \
gives the solids with flat ends."
}], "Usage",ExpressionUUID->"7f31dcda-7272-4a5d-8b10-014525a27224"],

Cell[TextData[{
 "Definition: the tube of radius ",
 StyleBox["s", "TI"],
 " about ",
 StyleBox["core", "TI"],
 " is ",
 StyleBox["{v : d(v, core) \[LessEqual] s}", "TI"],
 "."
}], "Notes",ExpressionUUID->"cb58b11a-3dcb-49fa-8c63-3b038df09e19"],

Cell[TextData[{
 StyleBox["core", "TI"],
 " is a vertex, a vertex list, a density, a walk graph, or a Euclidean head \
such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cd15c34b-23c9-49f4-b95d-77716d2929ff"],
 ", read through the keys of its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c8de6eb-2c98-4661-9a0e-37cfef09b2fa"],
 ". The tube of a vertex is the ball."
}], "Notes",ExpressionUUID->"8fd96f69-e078-4f01-96ba-d6c3dc126de2"],

Cell[TextData[{
 "The profile is a radius ",
 StyleBox["r", "TI"],
 ", which is the band ",
 StyleBox["{0, r}", "TI"],
 "; a pair of numbers ",
 StyleBox["{s, t}", "TI"],
 ", which is a band constant along the core; a list of radii or bands along \
the core; or a function of the position ",
 StyleBox["i = 1, \[Ellipsis], m", "TI"],
 ". The band profile ",
 StyleBox["{r, r}", "TI"],
 " is the surface, the vertices at distance exactly ",
 StyleBox["r", "TI"],
 "."
}], "Notes",ExpressionUUID->"eb76bce6-a462-4f9f-a6d4-5223c536332e"],

Cell[TextData[{
 "Option ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Method"]], "paclet:ref/Method"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "205ffcfd-3443-4a92-a5c3-b01e85918179"],
 " takes ",
 Cell[BoxData["\"\<Balls\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f17924ab-74ce-4ec6-ab90-f488f967283b"],
 " (default) or ",
 Cell[BoxData["\"\<Sliced\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "303aa507-a3e4-4e70-a0d8-2980e7d81fa5"],
 ". ",
 Cell[BoxData["\"\<Balls\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6440f621-a1e0-40cb-8ea6-c69552036689"],
 " is the union of the balls ",
 StyleBox["B(a_i, r_i)", "TI"],
 " about the core vertices, rounded where the profile jumps and at the ends. ",
 Cell[BoxData["\"\<Sliced\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5b603a5-6e19-4a71-9a12-53ebc62761a6"],
 " needs a walk for a core: slice ",
 StyleBox["i", "TI"],
 " is the set of vertices whose nearest axis vertex is ",
 StyleBox["a_i", "TI"],
 ", a tie lying in every nearest slice, and ",
 StyleBox["v", "TI"],
 " is in the solid when ",
 StyleBox["d(a_i, v)", "TI"],
 " lies in the band of its slice. The axis is prolonged straight on past both \
ends and the vertices nearer a prolongation than the axis are cut, so the \
ends are flat; a closed axis has no ends. A jump of the profile is then a \
sharp step."
}], "Notes",ExpressionUUID->"c9449aa6-9a54-4ba3-af66-292f5bde4bda"],

Cell[TextData[{
 "The tube of a segment is the tube of its whole interval, not of one \
shortest path: the ",
 StyleBox["fat tube", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["c", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "]"}], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80f2036e-d47d-48ef-9e76-6214ce8b31f6"],
 ". Where the segment has many shortest paths it is fatter than the tube of \
any of them. The ",
 StyleBox["thin tube", "TI"],
 " of one path takes as its core a member that ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a5e1f1c6-fe30-4ed7-bcd4-4c14d847063e"],
 " gives, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"FindInfraRepresentative", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      RowBox[{"InfraSegment", "[", 
       RowBox[{
        StyleBox["c", "TI"], ",", " ", 
        StyleBox["p", "TI"]}], "]"}]}], "]"}], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca1d695b-7069-4912-a8f4-0c3e3a8bacae"],
 "."
}], "Notes",ExpressionUUID->"9c5b1078-e65b-40fd-85a5-b37f731471d6"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7b7762bb-91dd-437b-a520-bd027690442c"],
 " gives two measures of a tube:"
}], "Notes",ExpressionUUID->"d77de485-a634-424d-b4d0-6d7b31a083cb"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6ccccd96-76fc-4340-bf8d-bea2414deddf"], Cell["Measure", "TableText",
     FontWeight->Bold,ExpressionUUID->"3b1d7d88-e304-4ce9-9eea-572cc4d2376c"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"1fc7bfcd-044b-45ca-b498-20ab88744bc7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "693b4221-8f6a-479a-9fab-7b55e440f32d"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0aa6df1d-0b6a-434f-ab97-58de559092f1"]], "TableText",ExpressionUUID->
     "edd08780-ee32-4dd2-a424-d8049a8ebd5a"], Cell[
    "the number of vertices of the tube", "TableText",ExpressionUUID->
     "023f5783-db32-43a3-9218-ecf8616983f1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "75a906aa-8ef9-48b1-89b3-5591d3ccb10d"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "bb9c6571-5e0c-4517-b92e-1bfb402e9d48"]], "TableText",ExpressionUUID->
     "18311aad-24cf-4469-81d7-2801e56fb130"], Cell["\<\
the number of vertices of the tube all of whose neighbours lie in the tube: \
the count without the boundary\
\>", "TableText",ExpressionUUID->"15ccbeed-6d21-4362-b934-5885f551776a"]}
  }]], "2ColumnTableMod",ExpressionUUID->"4f0e2110-b65c-4c06-99fa-\
53c9d48980d7"],

Cell[TextData[{
 "The Riemannian measure of the tube of radius ",
 StyleBox["s \[GreaterEqual] 1", "TI"],
 " counts the tube of radius ",
 StyleBox["s \[Minus] 1", "TI"],
 " and the vertices at distance ",
 StyleBox["s", "TI"],
 " from the core that have no neighbour at distance ",
 StyleBox["s + 1", "TI"],
 ". For the fat tube on the square and the cubic grids, away from the rim, \
there are none, so the Riemannian profile is the counting profile one step \
later. The tube of radius 0 of a segment is its interval, and its Riemannian \
measure counts the inner vertices of the interval: ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b92c2584-6362-4a18-bc63-7bce6a7d5aee"],
 " when the segment has one shortest path."
}], "Notes",ExpressionUUID->"300493a7-2c5a-40d3-8cc0-d90cffc7d3e5"],

Cell[TextData[{
 "On ",
 StyleBox["Z^d", "TI"],
 " the fat tube has an exact count. The interval of ",
 StyleBox["c", "TI"],
 " and ",
 StyleBox["p", "TI"],
 " is the box with sides ",
 StyleBox["a_i = |p_i \[Minus] c_i|", "TI"],
 ", and the tube of radius ",
 StyleBox["s", "TI"],
 " about it has ",
 StyleBox["\[CapitalSigma]", "TI"],
 StyleBox["J 2^|J| C(s, |J|) \[CapitalPi]", "TI", "TI"],
 StyleBox["(i \[NotElement] J) (a_i + 1)", "TI"],
 " vertices, the sum over the sets ",
 StyleBox["J", "TI"],
 " of coordinates, with ",
 StyleBox["C", "TI"],
 " the binomial coefficient. On the square grid this is"
}], "Notes",ExpressionUUID->"43f622f6-a7e4-4d38-8e10-97bf05397648"],

Cell[TextData[{
 StyleBox["(a_1 + 1)(a_2 + 1) + 2s(a_1 + a_2 + 2) + 2s(s \[Minus] 1)", "TI"],
 ","
}], "Notes",ExpressionUUID->"5698960b-40de-48c7-bf21-bcc360b3b4dc"],

Cell[TextData[{
 "where ",
 StyleBox["(a_1 + 1)(a_2 + 1)", "TI"],
 " is the number of vertices of the interval and ",
 StyleBox["a_1 + a_2", "TI"],
 " the length of the segment. The Riemannian measure is the same count at ",
 StyleBox["s \[Minus] 1", "TI"],
 ", for ",
 StyleBox["s \[GreaterEqual] 1", "TI"],
 ". A straight segment along an axis has one shortest path, and there the \
thin tube is the fat one, the case ",
 StyleBox["a_2 = 0", "TI"],
 ". The thin tube of a staircase path has no closed form."
}], "Notes",ExpressionUUID->"cd27aa0d-cde4-4b02-9769-8fb30bada797"],

Cell[TextData[{
 "In the continuum two tubes are the references. Gray's expansion is for the \
tube of normal geodesic discs about a geodesic ",
 StyleBox["\[Gamma]", "TI"],
 " of length ",
 StyleBox["L", "TI"],
 " with unit tangent ",
 StyleBox["u", "TI"],
 " in a Riemannian manifold of dimension ",
 StyleBox["n", "TI"],
 ": ",
 StyleBox["\[Omega]_(n\[Minus]1) s^(n\[Minus]1) \[Integral]_0^L (1 \[Minus] \
(Scal + Ric(u, u)) s\.b2 / (6(n + 1)) + O(s\:2074)) dt", "TI"],
 ", with ",
 StyleBox["\[Omega]_k", "TI"],
 " the volume of the Euclidean unit ",
 StyleBox["k", "TI"],
 "-ball. The set of points within ",
 StyleBox["s", "TI"],
 " of a segment adds two half-balls at its ends; in Euclidean space its \
volume is ",
 StyleBox["\[Omega]_(n\[Minus]1) s^(n\[Minus]1) L + \[Omega]_n s^n", "TI"],
 ", the spherocylinder. The thin tube is the graph counterpart of these, \
whose core is a curve. The fat tube is not: on ",
 StyleBox["Z^d", "TI"],
 " its core is a box, which grows with the offset of the two ends."
}], "Notes",ExpressionUUID->"7f3bd5a1-0297-4677-8111-4c65dd3a0d27"],

Cell[TextData[{
 "How the number is measured: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraTube", "[", 
     RowBox[{
      StyleBox["core", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "]"}], ",", " ", 
    StyleBox["measure", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90f75145-0f88-458a-ae6a-747ce540c9ca"],
 " takes the vertices within ",
 StyleBox["s", "TI"],
 " of the support of the core, the interval for a segment and one path for a \
representative, and counts them, or counts their ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraInterior"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraInterior", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dcfe36ed-7e93-46c5-b91f-fa36e56423c2"],
 ". The profile is the list over ",
 StyleBox["s = 0, 1, \[Ellipsis]", "TI"],
 "."
}], "Notes",ExpressionUUID->"af5e1d53-fb30-43de-929f-f56d3109acc3"],

Cell[TextData[{
 "The head computes nothing. A tube has one member, the vertex set. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "01fd2716-8a38-476c-a7df-5ede83610983"],
 " also reads ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1312fb57-a1b3-45a7-841d-0bcd6102c725"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f6df590-e98d-4d1f-b723-a4b25c2e7614"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b62db42-e0ef-46bc-87bc-2aae98dd28f1"],
 ", ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "afb5be02-8d4f-4243-956a-c9e1b1e7c4fa"],
 " and ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b946af71-c881-4b01-b13d-8b232e653f05"],
 ". The tube is the primitive behind ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCylinder"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d72a8f3e-f6cc-4a35-9fe1-7057eca5d290"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCone"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCone", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c87234d6-e76e-4685-8cba-d3d2fe0b7d0b"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSolidOfRevolution"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSolidOfRevolution", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1bec7895-7b82-475c-897b-c05783f6c4f1"],
 ", which are its sliced profiles. A tube of an empty core is empty."
}], "Notes",ExpressionUUID->"88b549ca-9873-4028-96b4-5c7dcba2002d"]
}, Open  ]],

Cell[CellGroupData[{

