Cell["\<\
The tube of radius 2 about a segment on the discretized plane, the square \
grid and the hexagonal tiling. The Riemannian measure counts the inner \
vertices, in green; the counting measure adds the boundary, in blue.\
\>", "ExampleText",ExpressionUUID->"b70be68d-7a6d-4042-8ae4-3e3a07e88e22"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"tube", " ", "=", " ", 
        RowBox[{"InfraTube", "[", 
         RowBox[{
          RowBox[{"InfraSegment", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
              RowBox[{"RandomInfraPoint", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"InfraShell", "[", 
                 RowBox[{"c", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], 
           "]"}], ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"support", " ", "=", " ", 
        RowBox[{"RandomInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", "tube"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"InfraInterior", "[", 
              RowBox[{"g", ",", " ", "support"}], "]"}], " ", "->", " ", 
             "StandardGreen"}], ",", " ", 
            RowBox[{
             RowBox[{"InfraBoundary", "[", 
              RowBox[{"g", ",", " ", "support"}], "]"}], " ", "->", " ", 
             "StandardBlue"}]}], "}"}]}], "]"}], ",", "\n", "      ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", "tube", ",", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<CountingMeasure\>\"", ",", 
            " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "]"}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8ab0ae1c-19df-420f-9f23-26cc9f4e2ae4"],

