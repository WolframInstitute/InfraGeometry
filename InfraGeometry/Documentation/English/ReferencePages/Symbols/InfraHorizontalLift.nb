Notebook[{

Cell[CellGroupData[{
Cell["InfraHorizontalLift", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"11e305ef-32c3-4b4a-9da5-d9d9306a3d34"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHorizontalLift"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHorizontalLift", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["conn", "TI"], ",", " ", 
    StyleBox["x", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3da9867-25d3-4640-a1bf-0e450e3ab01f"],
 "\[LineSeparator]",
 "gives the horizontal lift of the base walk ",
 StyleBox["walk", "TI"],
 " along the connection ",
 StyleBox["conn", "TI"],
 ", starting at the total vertex ",
 StyleBox["x", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"cf661b1f-f38d-43c0-b77c-049e41bd8639"],

Cell[TextData[{
 "For a walk ",
 StyleBox["\[Gamma] = (v\:2080, v\:2081, \[Ellipsis], v\:2099)", "TI"],
 " and a start ",
 StyleBox["x\:2080", "TI"],
 " over ",
 StyleBox["v\:2080", "TI"],
 ", the lift is ",
 StyleBox["\[Gamma]\:0303 = (x\:2080, x\:2081, \[Ellipsis], x\:2099)", "TI"],
 ", where ",
 StyleBox["x\:1d62", "TI"],
 " is the neighbour of ",
 StyleBox["x\:1d62\:208b\:2081", "TI"],
 " over ",
 StyleBox["v\:1d62", "TI"],
 " along ",
 StyleBox["conn", "TI"],
 ". The projection of ",
 StyleBox["\[Gamma]\:0303", "TI"],
 " is ",
 StyleBox["\[Gamma]", "TI"],
 ", repeated vertices included."
}], "Notes",ExpressionUUID->"b16d372c-9d2d-4d5c-88a5-280341841601"],

Cell["\<\
A complete connection is a perfect matching over every base edge, so each \
step has exactly one choice and the lift is unique. Without a connection a \
walk in a fibered graph may have no lift or several.\
\>", "Notes",ExpressionUUID->"2416a84a-0453-4fbe-9888-8511df7693ca"],

Cell[TextData[{
 "The last vertex ",
 StyleBox["x\:2099", "TI"],
 " is the parallel transport of ",
 StyleBox["x\:2080", "TI"],
 " along ",
 StyleBox["\[Gamma]", "TI"],
 ". For a closed walk it can differ from ",
 StyleBox["x\:2080", "TI"],
 "; the permutation of the fiber is the holonomy."
}], "Notes",ExpressionUUID->"47977998-5330-4b04-b5fc-81726fc7f6aa"],

Cell[TextData[{
 "The connection must satisfy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "24c84b10-4e39-4535-ad54-e58942ab8874"],
 ", ",
 StyleBox["x", "TI"],
 " must lie over the first vertex of the walk, and consecutive vertices of \
the walk must be adjacent in the base. Otherwise the call stays unevaluated."
}], "Notes",ExpressionUUID->"b4bd1495-e2c9-438e-ae0d-7753036fa3b7"]
}, Open  ]],

