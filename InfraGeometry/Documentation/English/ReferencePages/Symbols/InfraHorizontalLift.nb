Cell[CellGroupData[{
Cell["InfraHorizontalLift", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"40d8add5-b5f2-4fd3-b8a0-9af07785df26"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHorizontalLift"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHorizontalLift", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["connection", "TI"], ",", " ", 
    StyleBox["start", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebe04114-1896-45c7-8bc2-406b165de6a3"],
 "\[LineSeparator]",
 "gives the unique horizontal lift of a base walk starting at the total \
vertex ",
 StyleBox["start", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"d46cfded-86d0-496e-bb62-0dd90d753869"],

Cell[TextData[{
 "The result is one ordered list of total vertices. Its projection is exactly \
",
 StyleBox["walk", "TI"],
 ", including repeated visits."
}], "Notes",ExpressionUUID->"c2f089fc-cbe4-4af2-a4af-7e2f24126d6f"],

Cell[TextData[{
 "The connection must satisfy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b91d7079-358e-4b7a-be2f-c92e89c55ca5"],
 ". The starting vertex must lie over the first vertex of the walk."
}], "Notes",ExpressionUUID->"c4e1b847-26f1-43d5-8c9f-f9baa90fb8e7"],

Cell[TextData[{
 "The walk is a nonempty list of base vertices with every consecutive pair \
joined by a base edge. A one-vertex walk has zero length and lifts to {",
 StyleBox["start", "TI"],
 "}."
}], "Notes",ExpressionUUID->"518e9367-2676-4b7a-b0f3-f7df261b326c"],

Cell["\<\
The reader is determined and consumes no random draws. It has no count or \
sampling option.\
\>", "Notes",ExpressionUUID->"5bc0fcab-8998-4986-bbcf-b1a9fc51c7ce"],

Cell["\<\
Invalid or ambiguous connections and unsupported walks or starting vertices \
remain unevaluated.\
\>", "Notes",ExpressionUUID->"a1aac8c6-a526-471a-9d93-df6099f4a756"],

