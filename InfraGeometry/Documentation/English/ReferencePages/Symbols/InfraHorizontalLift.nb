Cell["\<\
Retracing an edge retraces its lift. A zero-length walk stays at its starting \
vertex.\
\>", "ExampleText",ExpressionUUID->"783bd2d0-c0cc-4a84-b4a1-78dbada763b7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"fib", " ", "=", " ", 
      RowBox[{"InfraFiberedGraph", "[", " ", 
       RowBox[{"total", ",", " ", 
        RowBox[{"vertex", " ", "|->", " ", 
         RowBox[{"Mod", "[", " ", 
          RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
       " ", "]"}]}], ",", "\n", "    ", 
     RowBox[{"connection", " ", "=", " ", 
      RowBox[{"InfraConnection", "[", " ", 
       RowBox[{"EdgeList", " ", "@", " ", "total"}], " ", "]"}]}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraHorizontalLift", "[", " ", 
      RowBox[{"fib", ",", " ", "connection", ",", " ", "1", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"1", ",", " ", "2", ",", " ", "1", ",", " ", "2"}], " ", 
        "}"}]}], " ", "]"}], ",", "\n", "    ", 
     RowBox[{"InfraHorizontalLift", "[", " ", 
      RowBox[{"fib", ",", " ", "connection", ",", " ", "1", ",", " ", 
       RowBox[{"{", " ", "1", " ", "}"}]}], " ", "]"}]}], " ", "}"}]}], "\n", 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d94abc6c-3a2b-4ec3-a3b1-ef5b2ca07d20"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", "1", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c51de203-d31e-4c5a-9c3b-8b7fcf71c458"]
}, Open  ]]
}, Open  ]],

