Cell[CellGroupData[{
Cell["InfraHorizontalLift", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bc698678-dbb2-4f4f-933e-e3e9c014ddab"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHorizontalLift"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHorizontalLift", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["connection", "TI"], ",", " ", 
    StyleBox["start", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ccb55bd5-1ddf-42a4-a2c8-a7f8e30fc5fa"],
 "\[LineSeparator]",
 "gives the unique horizontal lift of a base walk starting at the total \
vertex ",
 StyleBox["start", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"fe064060-432c-499e-82d6-87246181fc92"],

Cell[TextData[{
 "The result is one ordered list of total vertices. Its projection is exactly \
",
 StyleBox["walk", "TI"],
 ", including repeated visits."
}], "Notes",ExpressionUUID->"81485684-c96c-4309-9920-06319ad9dd35"],

Cell[TextData[{
 "The connection must satisfy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "16061a06-4fe6-4759-a6a1-a98b761e1135"],
 ". The starting vertex must lie over the first vertex of the walk."
}], "Notes",ExpressionUUID->"3726b934-6da5-4708-90ae-4a1010d0c794"],

Cell[TextData[{
 "The walk is a nonempty list of base vertices with every consecutive pair \
joined by a base edge. A one-vertex walk has zero length and lifts to {",
 StyleBox["start", "TI"],
 "}."
}], "Notes",ExpressionUUID->"958bc8f8-205c-4adf-ac93-db0402d1ad6b"],

Cell["\<\
The reader is determined and consumes no random draws. It has no count or \
sampling option.\
\>", "Notes",ExpressionUUID->"e998b8ed-1b05-4b1b-bd1f-6f952eba792e"],

Cell["\<\
Invalid or ambiguous connections and unsupported walks or starting vertices \
remain unevaluated.\
\>", "Notes",ExpressionUUID->"f692abaa-f342-4040-b50f-5a574100194d"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
