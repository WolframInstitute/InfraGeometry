Cell[CellGroupData[{
Cell["InfraHorizontalLift", "ObjectName",ExpressionUUID->"ba98bdd3-4735-4c1e-9a61-96746b74061a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"39a9308b-42ca-4baa-8767-91d6296d842d"],
 Cell[BoxData[
  RowBox[{"InfraHorizontalLift", "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["connection", "TI"], ",", " ", 
    StyleBox["start", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c83d9934-c421-4890-aa6f-682cb5db9b90"],
 "\[LineSeparator]",
 "gives the unique horizontal lift of a base walk starting at the total \
vertex ",
 StyleBox["start", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"fdd38008-a7af-44d8-8848-854bcda7330b"],

Cell[TextData[{
 "The result is one ordered list of total vertices. Its projection is exactly \
",
 StyleBox["walk", "TI"],
 ", including repeated visits."
}], "Notes",ExpressionUUID->"a60b2923-5b29-4a68-9781-a1c7013e7c04"],

Cell[TextData[{
 "The connection must satisfy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bb764dc4-97eb-49ba-8963-5b3e96dd0ac2"],
 ". The starting vertex must lie over the first vertex of the walk."
}], "Notes",ExpressionUUID->"f31579ca-20d0-4086-ac27-74dcd58870de"],

Cell[TextData[{
 "The walk is a nonempty list of base vertices with every consecutive pair \
joined by a base edge. A one-vertex walk has zero length and lifts to {",
 StyleBox["start", "TI"],
 "}."
}], "Notes",ExpressionUUID->"c3d64b97-f125-4c67-8710-9d141e5dfd94"],

Cell["\<\
The reader is determined and consumes no random draws. It has no count or \
sampling option.\
\>", "Notes",ExpressionUUID->"47f86560-b8fa-4a24-ab18-ea129cef751e"],

Cell["\<\
Invalid or ambiguous connections and unsupported walks or starting vertices \
remain unevaluated.\
\>", "Notes",ExpressionUUID->"49246490-ac71-4592-8d3a-7d4775923841"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraHorizontalLift"]], 
