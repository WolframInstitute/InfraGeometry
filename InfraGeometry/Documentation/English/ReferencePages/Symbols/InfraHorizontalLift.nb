Cell["\<\
Fibers of two vertices joined completely, with a random connection. The lift \
of the walk around the rim of the grid:\
\>", "ExampleText",ExpressionUUID->"3d06b649-c447-40ba-8080-6d091b63c1e7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       "\n", "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"lift", " ", "=", " ", 
     RowBox[{"InfraHorizontalLift", "[", 
      RowBox[{"fib", ",", " ", "conn", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "8", ",", 
         " ", "12", ",", " ", "16", ",", " ", "15", ",", " ", "14", ",", " ", 
         "13", ",", " ", "9", ",", " ", "5", ",", " ", "1"}], "}"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", 
      RowBox[{"conn", ",", " ", 
       RowBox[{"InfraWalk", "[", "lift", "]"}]}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2793bb3d-0593-4ec3-8519-829343b463db"],

