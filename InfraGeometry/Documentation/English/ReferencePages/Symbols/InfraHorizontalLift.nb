Cell["\<\
A loop in the base of this double covering lifts from one sheet to the other.\
\
\>", "ExampleText",ExpressionUUID->"29124eeb-e476-478d-a1ab-c75864a29cd7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"fib", " ", "=", " ", 
      RowBox[{"InfraFiberedGraph", "[", " ", 
       RowBox[{"total", ",", " ", 
        RowBox[{"vertex", " ", "|->", " ", 
         RowBox[{"Mod", "[", " ", 
          RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
       " ", "]"}]}], ",", "\n", "    ", 
     RowBox[{"connection", " ", "=", " ", 
      RowBox[{"InfraConnection", "[", " ", 
       RowBox[{"EdgeList", " ", "@", " ", "total"}], " ", "]"}]}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"loop", " ", "=", " ", 
     RowBox[{"{", " ", 
      RowBox[{
      "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "1"}], " ", 
      "}"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"lift", " ", "=", " ", 
     RowBox[{"InfraHorizontalLift", "[", " ", 
      RowBox[{
      "fib", ",", " ", "connection", ",", " ", "1", ",", " ", "loop"}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"connection", ",", " ", 
         RowBox[{"InfraWalk", "[", " ", "lift", " ", "]"}]}], " ", "}"}]}], 
      " ", "]"}], ",", "\n", "    ", "lift", ",", " ", 
     RowBox[{"Lookup", "[", " ", 
      RowBox[{
       RowBox[{"InfraProjection", "[", " ", "fib", " ", "]"}], ",", " ", 
       RowBox[{"Key", " ", "/@", " ", "lift"}]}], " ", "]"}]}], " ", "}"}]}], 
  "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"80e4c7d5-be6a-45a6-8388-bfecb36827e6"],

