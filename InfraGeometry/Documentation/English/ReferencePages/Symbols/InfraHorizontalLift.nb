Cell["\<\
Retracing an edge retraces its lift. A zero-length walk stays at its starting \
vertex.\
\>", "ExampleText",ExpressionUUID->"fe3705cd-1e87-4216-ac8a-8292b1737f5a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"fib", " ", "=", " ", 
      RowBox[{"InfraFibration", "[", " ", 
       RowBox[{"total", ",", " ", 
        RowBox[{"vertex", " ", "|->", " ", 
         RowBox[{"Mod", "[", " ", 
          RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
       " ", "]"}]}], ",", "\n", "    ", 
     RowBox[{"connection", " ", "=", " ", 
      RowBox[{"InfraConnection", "[", " ", 
       RowBox[{"EdgeList", " ", "@", " ", "total"}], " ", "]"}]}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraHorizontalLift", "[", " ", 
      RowBox[{"fib", ",", " ", "connection", ",", " ", "1", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"1", ",", " ", "2", ",", " ", "1", ",", " ", "2"}], " ", 
        "}"}]}], " ", "]"}], ",", "\n", "    ", 
     RowBox[{"InfraHorizontalLift", "[", " ", 
      RowBox[{"fib", ",", " ", "connection", ",", " ", "1", ",", " ", 
       RowBox[{"{", " ", "1", " ", "}"}]}], " ", "]"}]}], " ", "}"}]}], "\n", 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6e094212-bbbe-4656-9efe-2c0cccf0877b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", "1", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0d5064f6-89a8-401e-a9cf-d5a543a16c4f"]
}, Open  ]]
}, Open  ]],

