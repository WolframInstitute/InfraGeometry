        RowBox[{"vertex", " ", "|->", " ", 
         RowBox[{"Mod", "[", " ", 
          RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
       " ", "]"}]}], ",", "\n", "    ", 
     RowBox[{"connection", " ", "=", " ", 
      RowBox[{"InfraConnection", "[", " ", 
       RowBox[{"EdgeList", " ", "@", " ", "total"}], " ", "]"}]}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Head", " ", "@", " ", 
    RowBox[{"InfraHorizontalLift", "[", " ", 
     RowBox[{"fib", ",", " ", "connection", ",", " ", "2", ",", " ", 
      RowBox[{"{", " ", 
       RowBox[{"1", ",", " ", "2"}], " ", "}"}]}], " ", "]"}]}]}], "\n", 
  "]"}]}], "Input",
