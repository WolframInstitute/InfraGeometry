Cell["\<\
A loop in the base of this double covering lifts from one sheet to the other.\
\
\>", "ExampleText",ExpressionUUID->"e6b53402-2200-44ea-8039-750c8f5b1302"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"fib", " ", "=", " ", 
      RowBox[{"InfraFibration", "[", " ", 
       RowBox[{"total", ",", " ", 
        RowBox[{"vertex", " ", "|->", " ", 
         RowBox[{"Mod", "[", " ", 
          RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
       " ", "]"}]}], ",", "\n", "    ", 
     RowBox[{"connection", " ", "=", " ", 
      RowBox[{"InfraConnection", "[", " ", 
       RowBox[{"EdgeList", " ", "@", " ", "total"}], " ", "]"}]}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"loop", " ", "=", " ", 
     RowBox[{"{", " ", 
      RowBox[{
      "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "1"}], " ", 
      "}"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"lift", " ", "=", " ", 
     RowBox[{"InfraHorizontalLift", "[", " ", 
      RowBox[{
      "fib", ",", " ", "connection", ",", " ", "1", ",", " ", "loop"}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"connection", ",", " ", 
         RowBox[{"InfraWalk", "[", " ", "lift", " ", "]"}]}], " ", "}"}]}], 
      " ", "]"}], ",", "\n", "    ", "lift", ",", " ", 
     RowBox[{"Lookup", "[", " ", 
      RowBox[{
       RowBox[{"InfraFibrationAssociation", "[", " ", "fib", " ", "]"}], ",", 
       " ", 
       RowBox[{"Key", " ", "/@", " ", "lift"}]}], " ", "]"}]}], " ", "}"}]}], 
  "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5939ddaa-fe30-45d3-bb04-177d65cedb6e"],

