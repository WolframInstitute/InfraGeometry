Cell["\<\
A random double covering of the 4 \[Times] 4 grid. The lift of the loop \
around the square 6, 7, 11, 10 starts at {6, 1} and ends at {6, 2}, on the \
other sheet:\
\>", "ExampleText",ExpressionUUID->"a0c95438-23e6-4f28-b718-8e4748c06227"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", "\n", "    ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Covering\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"lift", " ", "=", " ", 
     RowBox[{"InfraHorizontalLift", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomInfraConnection", "[", 
        RowBox[{"fib", ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"6", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "6", ",", " ", "7", ",", " ", "11", ",", " ", "10", ",", " ", "6"}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", 
      RowBox[{"InfraWalk", "[", "lift", "]"}], "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Last", "[", "lift", "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ae481360-6766-415a-827c-e181eb216704"],

