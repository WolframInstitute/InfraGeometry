Cell["\<\
The starting vertex must lie over the first base vertex. An unsupported call \
stays unevaluated.\
\>", "ExampleText",ExpressionUUID->"647e7ce1-20f4-4957-96c1-6553d13fe741"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"fib", " ", "=", " ", 
      RowBox[{"InfraFiberedGraph", "[", " ", 
       RowBox[{"total", ",", " ", 
        RowBox[{"vertex", " ", "|->", " ", 
         RowBox[{"Mod", "[", " ", 
          RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
       " ", "]"}]}], ",", "\n", "    ", 
     RowBox[{"connection", " ", "=", " ", 
      RowBox[{"InfraConnection", "[", " ", 
       RowBox[{"EdgeList", " ", "@", " ", "total"}], " ", "]"}]}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Head", " ", "@", " ", 
    RowBox[{"InfraHorizontalLift", "[", " ", 
     RowBox[{"fib", ",", " ", "connection", ",", " ", "2", ",", " ", 
      RowBox[{"{", " ", 
       RowBox[{"1", ",", " ", "2"}], " ", "}"}]}], " ", "]"}]}]}], "\n", 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9f91eea6-4e61-4670-9257-b47fcd895f0c"],

