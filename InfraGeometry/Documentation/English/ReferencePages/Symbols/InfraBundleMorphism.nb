     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraBundleMorphismQ", "[", 
    RowBox[{
     RowBox[{"InfraTangentBundle", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"InfraDisplacementBundle", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"ray", " ", "|->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"First", " ", "@", " ", "ray"}], ",", " ", 
