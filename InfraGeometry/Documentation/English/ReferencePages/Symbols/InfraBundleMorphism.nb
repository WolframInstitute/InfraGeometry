Cell["\<\
The three maps out of the tangent bundle are bundle morphisms.\
\>", "ExampleText",ExpressionUUID->"4ed0cdb1-0ba9-4a75-ad4e-a0b49c404567"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"tangent", " ", "=", " ", 
     RowBox[{"InfraTangentBundle", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"InfraBundleMorphismQ", "[", 
      RowBox[{"tangent", ",", " ", "#", ",", " ", 
       RowBox[{"InfraBundleMorphism", "[", 
        RowBox[{"tangent", ",", " ", "#"}], "]"}]}], "]"}], " ", "&"}], " ", "/@",
     "\n", "    ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraDisplacementBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", 
      RowBox[{"InfraTangentBundle", "[", 
       RowBox[{"g", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"InfraCotangentBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"118802e3-17ad-4bf9-b7a7-4734a8a1e86e"],

