Cell["\<\
The three maps out of the tangent bundle are bundle morphisms:\
\>", "ExampleText",ExpressionUUID->"3f7c7930-df0e-40ac-9dde-8eefe8be172f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"tangent", " ", "=", " ", 
     RowBox[{"InfraTangentBundle", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraBundleMorphismQ", "[", 
      RowBox[{"tangent", ",", " ", "fib", ",", " ", 
       RowBox[{"InfraBundleMorphism", "[", 
        RowBox[{"tangent", ",", " ", "fib"}], "]"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"{", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraDisplacementBundle", "[", 
          RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"InfraTangentBundle", "[", 
          RowBox[{"g", ",", " ", "1"}], "]"}], ",", " ", 
         RowBox[{"InfraCotangentBundle", "[", 
          RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d9497f38-4b4b-4a2b-a195-80af1f3319c4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"4a0e0875-65ac-49ac-9c46-7aed375ddcd0"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Possible Issues", "ExampleSection",ExpressionUUID->
   "dda06a82-eb41-4b48-8510-6cb821647761"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell["\<\
There is no natural map back from the displacement bundle, and none between \
bundles of different graphs:\
\>", "ExampleText",ExpressionUUID->"bea38660-fca9-45e8-a672-48ef7729b5c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"g", " ", "=", " ", 
      RowBox[{"InfraSubstrate", "[", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}], ",", " ", 
     RowBox[{"h", " ", "=", " ", 
      RowBox[{"InfraSubstrate", "[", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Head", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraBundleMorphism", "[", 
       RowBox[{
        RowBox[{"InfraDisplacementBundle", "[", 
         RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", 
        RowBox[{"InfraTangentBundle", "[", 
         RowBox[{"g", ",", " ", "2"}], "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"InfraBundleMorphism", "[", 
       RowBox[{
        RowBox[{"InfraTangentBundle", "[", 
         RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", 
        RowBox[{"InfraDisplacementBundle", "[", 
         RowBox[{"h", ",", " ", "2"}], "]"}]}], "]"}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6fe5652c-9fff-4fbf-9d25-8d9c18cedf18"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"InfraBundleMorphism", ",", "InfraBundleMorphism"}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ea038066-4d9e-4d1a-9dd7-a9ee75127438"]
}, Open  ]]
}, Open  ]],

