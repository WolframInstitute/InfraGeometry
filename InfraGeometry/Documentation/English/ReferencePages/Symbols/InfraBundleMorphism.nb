Cell["\<\
Sending a ray to its first step instead of its endpoint does not land in the \
displacement bundle at the same scale.\
\>", "ExampleText",ExpressionUUID->"1ec2d05d-9107-4ff8-a52d-ef3ea004cc75"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraBundleMorphismQ", "[", 
    RowBox[{
     RowBox[{"InfraTangentBundle", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"InfraDisplacementBundle", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", 
