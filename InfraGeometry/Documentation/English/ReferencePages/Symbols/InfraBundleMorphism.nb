Cell["\<\
The three maps out of the tangent bundle are bundle morphisms.\
\>", "ExampleText",ExpressionUUID->"927b6abc-c023-4877-9921-a89f0052e4cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"tangent", " ", "=", " ", 
     RowBox[{"InfraTangentBundle", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"InfraBundleMorphismQ", "[", 
      RowBox[{"tangent", ",", " ", "#", ",", " ", 
       RowBox[{"InfraBundleMorphism", "[", 
        RowBox[{"tangent", ",", " ", "#"}], "]"}]}], "]"}], " ", "&"}], " ", "/@",
     " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraDisplacementBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", 
      RowBox[{"InfraTangentBundle", "[", 
       RowBox[{"g", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"InfraCotangentBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7e477d99-273d-48b8-9658-d49452b976bc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7e3f792a-d958-4857-9eaa-385ad3b2d07f"]
}, Open  ]]
