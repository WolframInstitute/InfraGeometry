Cell["\<\
The truncation to scale 1 sends the 12 rays of length 2 at the centre of the \
grid to the 4 steps from it, 3 rays to each:\
\>", "ExampleText",ExpressionUUID->"e078ba5b-7c60-49a8-aa6f-b2205bc8c000"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"tangent", " ", "=", " ", 
     RowBox[{"InfraTangentBundle", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"truncate", " ", "=", " ", 
     RowBox[{"InfraBundleMorphism", "[", 
      RowBox[{"tangent", ",", " ", 
       RowBox[{"InfraTangentBundle", "[", 
        RowBox[{"g", ",", " ", "1"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"counts", " ", "=", " ", 
     RowBox[{"Counts", "[", 
      RowBox[{"Last", " ", "/@", " ", 
       RowBox[{"truncate", " ", "/@", " ", 
        RowBox[{"VertexList", " ", "@", " ", 
         RowBox[{"InfraFiber", "[", 
          RowBox[{"tangent", ",", " ", "c"}], "]"}]}]}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"counts", ",", " ", "c"}], "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", "counts"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a7539e15-96f6-41fd-a94a-83c00058fe54"],

