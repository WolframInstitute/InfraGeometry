Cell["\<\
The three maps out of the tangent bundle are bundle morphisms.\
\>", "ExampleText",ExpressionUUID->"884193e1-01d6-457d-b98d-daa24f8eb5b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"tangent", " ", "=", " ", 
     RowBox[{"InfraTangentBundle", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"InfraBundleMorphismQ", "[", 
      RowBox[{"tangent", ",", " ", "#", ",", " ", 
       RowBox[{"InfraBundleMorphism", "[", 
        RowBox[{"tangent", ",", " ", "#"}], "]"}]}], "]"}], " ", "&"}], " ", "/@",
     " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraDisplacementBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", 
      RowBox[{"InfraTangentBundle", "[", 
       RowBox[{"g", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"InfraCotangentBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8c609fdb-0451-49f7-86f9-76cd4dd40a04"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2d382d1c-fecd-4a96-b66d-9e2dd2dd6c64"]
}, Open  ]]
