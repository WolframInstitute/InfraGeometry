Cell["\<\
Sending a ray to its first step instead of its endpoint does not land in the \
displacement bundle at the same scale.\
\>", "ExampleText",ExpressionUUID->"44f59996-136c-4cf9-90f7-6122cb4fed8f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraBundleMorphismQ", "[", 
    RowBox[{
     RowBox[{"InfraTangentBundle", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"InfraDisplacementBundle", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"ray", " ", "|->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"First", " ", "@", " ", "ray"}], ",", " ", 
        RowBox[{"ray", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}]}], "]"}]}], "]"}]], "Input",\

