Cell["\<\
Sending a ray to its first step instead of its endpoint does not land in the \
displacement bundle at the same scale.\
\>", "ExampleText",ExpressionUUID->"74e92fdf-2e7c-491b-8407-3d4ff4207577"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
