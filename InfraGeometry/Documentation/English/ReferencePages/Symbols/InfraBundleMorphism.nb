Cell["\<\
The rays of length 2 at the centre sent to their endpoints. The size of a \
vertex is the number of rays that end there, the number of shortest paths \
from the centre:\
\>", "ExampleText",ExpressionUUID->"2be8e203-fe61-45b1-a55b-1b6abdb066a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"tangent", " ", "=", " ", 
         RowBox[{"InfraTangentBundle", "[", 
          RowBox[{"g", ",", " ", "2"}], "]"}]}], ",", " ", 
        RowBox[{"displacement", " ", "=", " ", 
         RowBox[{"InfraDisplacementBundle", "[", 
          RowBox[{"g", ",", " ", "2"}], "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"endpoint", " ", "=", " ", 
        RowBox[{"InfraBundleMorphism", "[", 
         RowBox[{"tangent", ",", " ", "displacement"}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Counts", "[", 
           RowBox[{"Last", " ", "/@", " ", 
            RowBox[{"endpoint", " ", "/@", " ", 
             RowBox[{"VertexList", " ", "@", " ", 
              RowBox[{"InfraFiber", "[", 
               RowBox[{"tangent", ",", " ", "c"}], "]"}]}]}]}], "]"}], ",", 
          " ", "c"}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

