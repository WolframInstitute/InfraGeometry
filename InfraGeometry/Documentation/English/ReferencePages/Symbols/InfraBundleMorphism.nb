Cell[TextData[{
 "The result is a function on total vertices. Each map keeps the base point \
and sends adjacent rays to adjacent or equal total vertices, so it passes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBundleMorphismQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBundleMorphismQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b22fef63-99d5-455c-b4e2-3313dbd0b267"],
 "."
}], "Notes",ExpressionUUID->"063c3012-b180-415c-a60e-56ba9f4f27b5"],

Cell[TextData[{
 "The endpoint map is not injective: the rays from ",
 StyleBox["p", "TI"],
 " to a vertex ",
 StyleBox["v", "TI"],
 " at distance ",
 StyleBox["r", "TI"],
 " are the shortest paths from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ", and all go to {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "}. The reversal is a bijection."
}], "Notes",ExpressionUUID->"956d0304-5da9-49b5-a345-a492e3fd7d01"],

Cell["\<\
Both bundles must be built on the same graph, with the same vertices and \
edges. Any other pair of bundles leaves the call unevaluated.\
\>", "Notes",ExpressionUUID->"2fedea72-c6e1-43fc-8f07-8b01c849b398"]
}, Open  ]],

