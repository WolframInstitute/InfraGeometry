Cell["\<\
The rays over the vertex 6 of the grid tangent bundle at scale 2, their \
truncations at scale 1 and their endpoint pairs in the displacement bundle at \
scale 2.\
\>", "ExampleText",ExpressionUUID->"f0d73dfa-caff-407d-97b8-dbea71131c4d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"InfraFiberedSubstrate", "[", 
       RowBox[{"\"\<GridTangentBundle\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"tangent", " ", "=", " ", 
      RowBox[{"InfraTangentBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}]}], ",", " ", 
     RowBox[{"tangent1", " ", "=", " ", 
      RowBox[{"InfraTangentBundle", "[", 
       RowBox[{"g", ",", " ", "1"}], "]"}]}], ",", " ", 
     RowBox[{"displacementBundle", " ", "=", " ", 
      RowBox[{"InfraDisplacementBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"truncate", " ", "=", " ", 
      RowBox[{"InfraBundleMorphism", "[", 
       RowBox[{"tangent", ",", " ", "tangent1"}], "]"}]}], ",", " ", 
     RowBox[{"endpoint", " ", "=", " ", 
      RowBox[{"InfraBundleMorphism", "[", 
       RowBox[{"tangent", ",", " ", "displacementBundle"}], "]"}]}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rays", " ", "=", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"InfraFiber", "[", 
       RowBox[{"tangent", ",", " ", "6"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{
        RowBox[{"InfraTotalGraph", "[", "tangent", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"InfraDensity", "[", 
          RowBox[{
           RowBox[{"InfraTotalGraph", "[", "tangent", "]"}], ",", " ", 
           "rays"}], "]"}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{
        RowBox[{"InfraTotalGraph", "[", "tangent1", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"InfraDensity", "[", 
          RowBox[{
           RowBox[{"InfraTotalGraph", "[", "tangent1", "]"}], ",", " ", 
           RowBox[{"truncate", " ", "/@", " ", "rays"}]}], "]"}], "}"}]}], 
       "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{
        RowBox[{"InfraTotalGraph", "[", "displacementBundle", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"InfraDensity", "[", 
          RowBox[{
           RowBox[{"InfraTotalGraph", "[", "displacementBundle", "]"}], ",", 
           " ", 
           RowBox[{"endpoint", " ", "/@", " ", "rays"}]}], "]"}], "}"}]}], 
       "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"590f20ca-478f-4f96-b02b-0ababa121bb4"],

