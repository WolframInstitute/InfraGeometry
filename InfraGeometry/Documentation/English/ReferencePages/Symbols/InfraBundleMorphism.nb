Cell["\<\
The rays over the vertex 6 of the grid tangent bundle at scale 2, their \
truncations at scale 1 and their endpoint pairs in the displacement bundle at \
scale 2.\
\>", "ExampleText",ExpressionUUID->"4519061e-7f7b-4a07-8b0c-0eb57e33f286"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"InfraFiberedSubstrate", "[", 
       RowBox[{"\"\<GridTangentBundle\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"tangent", " ", "=", " ", 
      RowBox[{"InfraTangentBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}]}], ",", " ", 
     RowBox[{"tangent1", " ", "=", " ", 
      RowBox[{"InfraTangentBundle", "[", 
       RowBox[{"g", ",", " ", "1"}], "]"}]}], ",", " ", 
     RowBox[{"displacementBundle", " ", "=", " ", 
      RowBox[{"InfraDisplacementBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"truncate", " ", "=", " ", 
      RowBox[{"InfraBundleMorphism", "[", 
       RowBox[{"tangent", ",", " ", "tangent1"}], "]"}]}], ",", " ", 
     RowBox[{"endpoint", " ", "=", " ", 
      RowBox[{"InfraBundleMorphism", "[", 
       RowBox[{"tangent", ",", " ", "displacementBundle"}], "]"}]}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rays", " ", "=", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"InfraFiber", "[", 
       RowBox[{"tangent", ",", " ", "6"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{
        RowBox[{"InfraTotalSpace", "[", "tangent", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"InfraDensity", "[", 
          RowBox[{
           RowBox[{"InfraTotalSpace", "[", "tangent", "]"}], ",", " ", 
           "rays"}], "]"}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{
        RowBox[{"InfraTotalSpace", "[", "tangent1", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"InfraDensity", "[", 
          RowBox[{
           RowBox[{"InfraTotalSpace", "[", "tangent1", "]"}], ",", " ", 
           RowBox[{"truncate", " ", "/@", " ", "rays"}]}], "]"}], "}"}]}], 
       "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{
        RowBox[{"InfraTotalSpace", "[", "displacementBundle", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"InfraDensity", "[", 
          RowBox[{
           RowBox[{"InfraTotalSpace", "[", "displacementBundle", "]"}], ",", 
           " ", 
           RowBox[{"endpoint", " ", "/@", " ", "rays"}]}], "]"}], "}"}]}], 
       "]"}]}], "}"}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"efce3fcf-3455-4ac3-994c-8ae78b124125"],

