Cell["\<\
The three maps applied to one ray from the centre of the grid:\
\>", "ExampleText",ExpressionUUID->"7d9de106-e593-42a0-98e9-194c7ef03893"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"tangent", " ", "=", " ", 
      RowBox[{"InfraTangentBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}]}], ",", " ", 
     RowBox[{"ray", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"InfraRays", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}]}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ray", ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraBundleMorphism", "[", 
         RowBox[{"tangent", ",", " ", "fib"}], "]"}], "[", "ray", "]"}], ",", 
       "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"fib", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraDisplacementBundle", "[", 
            RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", 
           RowBox[{"InfraTangentBundle", "[", 
            RowBox[{"g", ",", " ", "1"}], "]"}], ",", " ", 
           RowBox[{"InfraCotangentBundle", "[", 
            RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}]}], "}"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"38728424-3503-46e1-aec9-bf421e39dd6a"],

Cell[BoxData[
 RowBox[{"{", 
