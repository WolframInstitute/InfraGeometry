Cell["\<\
The order-2 complex of ten random points at radius 0.2 is the set of all \
subsets whose value is at most 0.2.\
\>", "ExampleText",ExpressionUUID->"aa0152a6-e034-4e1b-818a-39234604fe6d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "4", "]"}], ";", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"10", ",", " ", "2"}], "}"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"complex", " ", "=", " ", 
     RowBox[{"BallIntersectionComplex", "[", 
      RowBox[{"points", ",", " ", "0.2", ",", " ", "2"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
