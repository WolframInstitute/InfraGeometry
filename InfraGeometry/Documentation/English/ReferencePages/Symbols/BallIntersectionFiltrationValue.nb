Cell[CellGroupData[{

Cell["Metric", "ExampleSubsection",ExpressionUUID->"fe2fbcf5-10ac-41b3-90a5-92fbb6b30e99"],

Cell["\<\
Two vertices of a path at distance 2. Their balls first meet at radius 1 in \
the graph, at the vertex between them, and in the plane; with the distance \
matrix of the two alone the common point must be one of them, and the radius \
is 2.\
\>", "ExampleText",ExpressionUUID->"cd4f4d14-26f8-437c-ae14-e3ff5b84607e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
