Cell[TextData[{
 "The equilateral triangle of side 1. At order 2 it is born at radius 1/2, \
when the disks touch in pairs; in the \[CapitalCHacek]ech complex at radius \
",
 StyleBox["1/\[Sqrt]3", "TI"],
 ", when all three meet at the centre."
}], "ExampleText",ExpressionUUID->"0b991d03-690b-4902-9b0c-c573f2c7ca9d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"CirclePoints", "[", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", "3", "]"}]}], ",", " ", "3"}], "]"}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"values", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"BallIntersectionFiltrationValue", "[", 
        RowBox[{"points", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", "#"}],
         "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "Infinity"}], "}"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"StandardBlue", ",", " ", 
              RowBox[{"Opacity", "[", "0.15", "]"}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Disk", "[", 
                 RowBox[{"#", ",", " ", "s"}], "]"}], " ", "&"}], " ", "/@", 
               " ", "points"}]}], "}"}], ",", " ", 
            RowBox[{"Point", "[", "points", "]"}]}], "}"}], ",", " ", 
          RowBox[{"PlotLabel", " ", "->", " ", "s"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"s", ",", " ", "values"}], "}"}]}], "]"}]}], ",", " ", 
     "values"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"aa59c7fa-1f02-49bb-bf9b-7d8d9f2f3823"],

