Cell[TextData[{
 "The equilateral triangle of side 1. At order 2 it is born at radius 1/2, \
when the disks touch in pairs; in the \[CapitalCHacek]ech complex at radius \
",
 StyleBox["1/\[Sqrt]3", "TI"],
 ", when all three meet at the centre."
}], "ExampleText",ExpressionUUID->"9b83c761-d710-49ad-adf1-b46a39c71ae4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"CirclePoints", "[", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", "3", "]"}]}], ",", " ", "3"}], "]"}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"values", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"BallIntersectionFiltrationValue", "[", 
        RowBox[{"points", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", "#"}],
         "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "Infinity"}], "}"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"StandardBlue", ",", " ", 
              RowBox[{"Opacity", "[", "0.15", "]"}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Disk", "[", 
                 RowBox[{"#", ",", " ", "s"}], "]"}], " ", "&"}], " ", "/@", 
               " ", "points"}]}], "}"}], ",", " ", 
            RowBox[{"Point", "[", "points", "]"}]}], "}"}], ",", " ", 
          RowBox[{"PlotLabel", " ", "->", " ", "s"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"s", ",", " ", "values"}], "}"}]}], "]"}]}], ",", " ", 
     "values"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e9c9224d-32b2-43c9-bbcf-dd228c04749b"],

