Cell["\<\
The four corners of a square of the square tiling, with the graph metric. \
Three of their balls meet from radius 1, all four only from radius 2.\
\>", "ExampleText",ExpressionUUID->"6260e48e-55b4-4f7c-8a87-ae3e88787729"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"First", " ", "/@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindCycle", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", "4", "}"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraWalk", "[", 
         RowBox[{"Append", "[", 
          RowBox[{"corners", ",", " ", 
           RowBox[{"First", "[", "corners", "]"}]}], "]"}], "]"}], "}"}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"BallIntersectionFiltrationValue", "[", 
        RowBox[{"corners", ",", " ", 
         RowBox[{"Range", "[", "4", "]"}], ",", " ", "k", ",", " ", 
         RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "2", ",", " ", "4"}], "}"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8368446b-99e0-4dc5-a023-f20a50f157bd"],

