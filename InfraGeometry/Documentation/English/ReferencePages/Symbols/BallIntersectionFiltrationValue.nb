Cell[CellGroupData[{
Cell["BallIntersectionFiltrationValue", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3a22ec3d-3b26-4cf1-a970-3f56b32f04c6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionFiltrationValue"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
BallIntersectionFiltrationValue", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["\[Sigma]", "TR"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1081918-1d45-4a28-acbb-47aec77f593c"],
 "\[LineSeparator]",
 "gives the least radius at which the positions ",
 StyleBox["\[Sigma]", "TI"],
 " form a simplex of the order-",
 StyleBox["k", "TI"],
 " ball intersection complex of ",
 StyleBox["data", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1922ee56-dac7-4fe9-a4e1-ac3146b9d528"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionFiltrationValue"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
BallIntersectionFiltrationValue", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["\[Sigma]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4466805-68cd-4b54-adf9-29115f29d467"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["k", "TI"],
 " = ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a7538a32-8e2f-4614-a5a7-1b795c341be4"],
 ", the \[CapitalCHacek]ech complex."
}], "Usage",ExpressionUUID->"3a3888c6-6a10-418c-b1f7-eefeb0730315"],

Cell[TextData[{
 "Definition: let ",
 StyleBox["\[Rho](\[Tau])", "TI"],
 " be the least radius at which the balls about the points of ",
 StyleBox["\[Tau]", "TI"],
 " have a common point. Then ",
 StyleBox["f_k(\[Sigma]) = \[Rho](\[Sigma])", "TI"],
 " when ",
 StyleBox["\[Sigma]", "TI"],
 " has at most ",
 StyleBox["k", "TI"],
 " elements, and otherwise ",
 StyleBox["f_k(\[Sigma])", "TI"],
 " is the largest ",
 StyleBox["\[Rho](\[Tau])", "TI"],
 " over the subsets ",
 StyleBox["\[Tau]", "TI"],
 " of ",
 StyleBox["\[Sigma]", "TI"],
 " with ",
 StyleBox["k", "TI"],
 " elements."
}], "Notes",ExpressionUUID->"f8812c50-778a-4ebb-911f-ad9d6b0e28d5"],

Cell[TextData[{
 "The set ",
 StyleBox["\[Sigma]", "TI"],
 " is a simplex of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd0d5ddb-f568-425c-a02c-820e21bf86f3"],
 " exactly when ",
 StyleBox["f_k(\[Sigma]) \[LessEqual] r", "TI"],
 ". Since ",
 StyleBox["\[Rho]", "TI"],
 " grows with the set, ",
 StyleBox["f_k", "TI"],
 " is monotone under faces, and it grows with ",
 StyleBox["k", "TI"],
 " up to ",
 StyleBox["\[Rho](\[Sigma])", "TI"],
 "."
}], "Notes",ExpressionUUID->"3244c0d3-8f61-4158-baab-520577f6eda1"],

Cell[TextData[{
 "For Euclidean points ",
 StyleBox["\[Rho]", "TI"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MiniballRadius"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/MiniballRadius", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ba3b0f98-18b5-4d73-9afe-7fac0e8dba53"],
 ". Option ",
 Cell[BoxData["\"\<Metric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "125273a4-0afb-4097-9626-1fe991752c6d"],
 " -> ",
 StyleBox["g", "TI"],
 " reads ",
 StyleBox["data", "TI"],
 " as vertices of the graph ",
 StyleBox["g", "TI"],
 ", and ",
 StyleBox["\[Rho](\[Tau])", "TI"],
 " is the least ",
 StyleBox["r", "TI"],
 " such that some vertex of ",
 StyleBox["g", "TI"],
 " lies within ",
 StyleBox["r", "TI"],
 " of every point of ",
 StyleBox["\[Tau]", "TI"],
 ". A distance matrix or a function looks for that point among the points of ",
 StyleBox["data", "TI"],
 ". For ",
 StyleBox["k", "TI"],
 " = 2 the value of a pair is therefore half its distance for Euclidean \
points, the ceiling of that half for a graph, and in general neither for a \
matrix or a function."
}], "Notes",ExpressionUUID->"4c6afe73-4326-4e3e-80ff-e65c9f357dda"]
}, Open  ]],

