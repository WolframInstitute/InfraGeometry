Cell["\<\
The order-2 complex of ten random points at radius 0.2 is the set of all \
subsets whose value is at most 0.2.\
\>", "ExampleText",ExpressionUUID->"066158fa-2227-43f9-9c79-56a0928f2251"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "4", "]"}], ";", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"10", ",", " ", "2"}], "}"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"complex", " ", "=", " ", 
     RowBox[{"BallIntersectionComplex", "[", 
      RowBox[{"points", ",", " ", "0.2", ",", " ", "2"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{"{", "\n", "     ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"StandardBlue", ",", " ", 
          RowBox[{"Opacity", "[", "0.15", "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Disk", "[", 
             RowBox[{"#", ",", " ", "0.2"}], "]"}], " ", "&"}], " ", "/@", 
           " ", "points"}]}], "}"}], ",", "\n", "     ", 
        RowBox[{"{", 
         RowBox[{"StandardRed", ",", " ", 
          RowBox[{"Opacity", "[", "0.3", "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Polygon", "[", 
             RowBox[{"points", "[", 
              RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "&"}], " ", "/@", 
           " ", 
           RowBox[{"Select", "[", 
            RowBox[{"complex", ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "3"}], " ", 
              "&"}]}], "]"}]}]}], "}"}], ",", "\n", "     ", 
        RowBox[{"{", 
         RowBox[{"StandardRed", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"points", "[", 
              RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "&"}], " ", "/@", 
           " ", 
           RowBox[{"Select", "[", 
            RowBox[{"complex", ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "2"}], " ", 
              "&"}]}], "]"}]}]}], "}"}], ",", "\n", "     ", 
        RowBox[{"Point", "[", "points", "]"}]}], "}"}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"complex", " ", "==", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Subsets", "[", 
         RowBox[{
          RowBox[{"Range", "[", "10", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "10"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"BallIntersectionFiltrationValue", "[", 
           RowBox[{"points", ",", " ", "#", ",", " ", "2"}], "]"}], " ", "<=",
           " ", "0.2"}], " ", "&"}]}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fc9e1c13-8826-45d8-8317-7c18fc092bd8"],

