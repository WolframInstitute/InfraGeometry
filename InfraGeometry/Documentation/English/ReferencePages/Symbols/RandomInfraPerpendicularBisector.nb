Cell["Enumerate the complete point family.", "ExampleText",ExpressionUUID->"a1941022-eb1e-46b0-9e38-e700c4bf92aa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CompleteGraph", "[", " ", "3", " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"RandomInfraPerpendicularBisector", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"InfraPerpendicularBisector", "[", " ", 
       RowBox[{"1", ",", " ", "2"}], " ", "]"}], ",", " ", "All"}], " ", 
     "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"783384e5-35c5-4e9d-801c-034cda15dd25"],

Cell[BoxData[
 RowBox[{"{", "3", "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7e955c09-184a-4dc2-a237-50fd525cc73c"]
