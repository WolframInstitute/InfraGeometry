Cell["Draw and highlight one point.", "ExampleText",ExpressionUUID->"b8420543-5ed1-42b8-8c19-4e17fdcc37db"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CompleteGraph", "[", " ", "3", " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"{", " ", 
     RowBox[{"point", " ", "=", " ", 
      RowBox[{"RandomInfraPerpendicularBisector", "[", " ", 
       RowBox[{"graph", ",", " ", 
        RowBox[{"InfraPerpendicularBisector", "[", " ", 
         RowBox[{"1", ",", " ", "2"}], " ", "]"}]}], " ", "]"}]}], " ", "}"}],
     ",", "\n", "  ", 
    RowBox[{"InfraSubstrateHighlight", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"{", " ", 
       RowBox[{"<|", " ", 
        RowBox[{"point", " ", "->", " ", "1"}], " ", "|>"}], " ", "}"}]}], 
     " ", "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4be5dfa1-01eb-410e-8e2f-d711e8a55f96"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3}, {Null, 
       SparseArray[
       Automatic, {3, 3}, 0, {
        1, {{0, 2, 4, 6}, {{2}, {3}, {1}, {3}, {1}, {2}}}, Pattern}]}, {
      GraphLayout -> {"CircularEmbedding", "OptimalOrder" -> False}, 
       VertexShapeFunction -> {3 -> (Append[{
            RGBColor[0.790588, 0.201176, 0.], 
            Opacity[1.]}, 
           Disk[#, 1 #3]]& )}}]]}, 
    TagBox[GraphicsGroupBox[{
       {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], 
