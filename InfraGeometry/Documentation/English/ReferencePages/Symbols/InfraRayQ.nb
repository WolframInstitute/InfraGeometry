Cell[CellGroupData[{
Cell["InfraRayQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fd376b65-263d-48c5-8e45-2a3e5588c21f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ray", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12dd04a6-2513-4d89-8b4c-e66cc63afec6"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["ray", "TI"],
 " is a ray in ",
 StyleBox["g", "TI"],
 ": a geodesic from its own first vertex that cannot be prolonged past its \
last.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"9c06a132-ca9a-4a6a-b390-fcd77bac5820"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["ray1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "947ac863-52dd-4073-8af1-831166e43b8c"],
 "\[LineSeparator]",
 "tests every ray of a list, such as the one ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a550015-a3a2-4853-95c9-85c15c5bcfc6"],
 " returns."
}], "Usage",ExpressionUUID->"1acb08e8-d302-465b-a27f-65013289233d"],

Cell["\<\
Two conditions, and the asymmetry between them is the whole definition:\
\>", "Notes",ExpressionUUID->"3f21e5ba-edff-4ad0-a4a1-c982536464a8"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "18fa3504-d987-4315-a06f-56be226cb614"], Cell["Condition", "TableText",
     FontWeight->Bold,ExpressionUUID->"2dae0b8e-bb86-4875-8ae7-00904178be8c"],
     Cell["Why", "TableText",
     FontWeight->Bold,ExpressionUUID->"f9d1264a-23d0-420b-a081-4e5d168cb86c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1e4f360f-150d-4f40-af6a-8ce25d93761c"], Cell[
    "the sequence is a geodesic", "TableText",ExpressionUUID->
     "afaf1788-32f3-4002-8008-8526c59d9499"], Cell[TextData[{
     "a ray is straight, so ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSegmentQ"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "b9a64b69-9111-4e79-9565-819f54cd14ed"],
     " must hold"
    }], "TableText",ExpressionUUID->"4b5f3469-6432-499d-8803-09c922c2cb40"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4eec2fcc-823e-4c9c-9fce-f1572b41de01"], Cell["\<\
no neighbour of the last vertex sits one step farther from the first\
\>", "TableText",ExpressionUUID->"0c46846d-12c3-47e6-a4fa-d590694169b9"], 
    Cell["the far end is inextensible", "TableText",ExpressionUUID->
     "79e1b401-ff6d-4846-b601-e04dfb1796ef"]}
  }]], "2ColumnTableMod",ExpressionUUID->"e37a10a4-9224-440e-acee-\
63a61a6b13d1"],

Cell[TextData[{
 "Inextensibility is required ",
 StyleBox["only at the far end",
  FontWeight->"Bold"],
 ". The origin is an endpoint by fiat \[LongDash] that is exactly what \
distinguishes a ray from a line (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "efc3d294-f9b8-42c8-be9a-dbdac0243af8"],
 " asks for inextensibility at both ends), and it means a ray may start \
anywhere, not only at a peripheral vertex."
}], "Notes",ExpressionUUID->"63398ed0-b4eb-451f-ae97-7cf9e6060438"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9668553d-ab82-45c7-b063-e80cd1e5ec8c"],
 ": a single vertex has no direction."
}], "Notes",ExpressionUUID->"5e8600bc-b93f-415f-86de-e8f71cb0490f"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRay"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cf7d5b00-0361-4945-ad40-6ec5c311f668"],
 ", which prolongs a geodesic outward until no neighbour prolongs it, so \
every ray that finder returns satisfies it."
}], "Notes",ExpressionUUID->"8b3135da-e8ad-49b9-910a-01f7e5c91366"]
}, Open  ]],

