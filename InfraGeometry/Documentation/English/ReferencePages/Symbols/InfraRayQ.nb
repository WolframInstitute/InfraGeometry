Cell[CellGroupData[{
Cell["InfraRayQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0fb06e89-ee17-4bc7-a183-e8f4e13746ad"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ray", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "569d3ba1-6c1c-46fd-b23e-96c893564c2e"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["ray", "TI"],
 " is a ray in ",
 StyleBox["g", "TI"],
 ": a geodesic from its own first vertex that cannot be prolonged past its \
last.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"9a20b1f8-747f-4562-9a9e-f45a192bba99"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["ray1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95cb2169-a8bd-431f-932d-a8bcbc28a1ac"],
 "\[LineSeparator]",
 "tests every ray of a list, such as the one ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8a10cce-ba6c-47be-8758-b33b86e0336c"],
 " returns."
}], "Usage",ExpressionUUID->"35c8b81b-732d-47b7-bf42-3e65f34d12e1"],

Cell["\<\
Two conditions, and the asymmetry between them is the whole definition:\
\>", "Notes",ExpressionUUID->"e1dd76ea-6dc0-4c75-ad00-bb324c196ecd"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "21fdc22d-60ac-4d63-9c26-eaff84303df8"], Cell["Condition", "TableText",
     FontWeight->Bold,ExpressionUUID->"8b190192-b5d9-446c-8dc3-07e6574446dc"],
     Cell["Why", "TableText",
     FontWeight->Bold,ExpressionUUID->"ce9f0d8c-4eb0-4830-939c-57f4f55e5926"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7ad15e6d-f2d2-477e-9aea-649664ad0042"], Cell[
    "the sequence is a geodesic", "TableText",ExpressionUUID->
     "8aed7a98-0a56-402c-a1cd-384530d94bbc"], Cell[TextData[{
     "a ray is straight, so ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSegmentQ"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "7b1a4721-d9cf-444c-8133-9205212b9484"],
     " must hold"
    }], "TableText",ExpressionUUID->"db801f3f-553c-4522-aa0f-562be0e1ed5f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2727040c-2597-4bbd-bb15-99dbc4567c96"], Cell["\<\
no neighbour of the last vertex sits one step farther from the first\
\>", "TableText",ExpressionUUID->"590d79c1-e22f-472c-9a06-d5eb1e0dd28d"], 
    Cell["the far end is inextensible", "TableText",ExpressionUUID->
     "9f6952e2-7d07-4156-ac52-75a4308f1c1c"]}
  }]], "2ColumnTableMod",ExpressionUUID->"30298ccc-3be6-41c1-8995-\
e9783bdb4dc2"],

Cell[TextData[{
 "Inextensibility is required ",
 StyleBox["only at the far end",
  FontWeight->"Bold"],
 ". The origin is an endpoint by fiat \[LongDash] that is exactly what \
distinguishes a ray from a line (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bed299f5-8798-4e57-930f-be5365f652ae"],
 " asks for inextensibility at both ends), and it means a ray may start \
anywhere, not only at a peripheral vertex."
}], "Notes",ExpressionUUID->"6bb49394-9c5a-4a47-acc6-08ef90e1699b"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffb7c043-329c-4280-b3d9-4953751c1d3a"],
 ": a single vertex has no direction."
}], "Notes",ExpressionUUID->"0ebed808-8283-4194-92ab-d7c68d201348"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRay"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "66f4432e-2d54-49f2-ba96-6d3f92ce1422"],
 ", which prolongs a geodesic outward until no neighbour prolongs it, so \
every ray that finder returns satisfies it."
}], "Notes",ExpressionUUID->"7b5b35de-7293-4320-a6ef-41e6e58328f0"]
}, Open  ]],

