Cell[CellGroupData[{
Cell["InfraRayQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d160006e-fc7a-4444-b2c8-490a7930caa8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ray", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5889d7ab-ec88-4ee3-836d-ea1e66b3dfea"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["ray", "TI"],
 " is a ray in ",
 StyleBox["g", "TI"],
 ": a geodesic from its own first vertex that cannot be prolonged past its \
last.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b7185a5d-1640-4d77-bd01-80a73121fb17"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["ray1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "156c08dd-9511-4758-8f41-236af888f383"],
 "\[LineSeparator]",
 "tests every ray of a list, such as the one ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b7867d9-7b18-47ae-8085-b8e41a5c9f9d"],
 " returns."
}], "Usage",ExpressionUUID->"11f7176a-ca81-4fde-bff0-ee8207dd2724"],

Cell["\<\
Two conditions, and the asymmetry between them is the whole definition:\
\>", "Notes",ExpressionUUID->"cc4a411d-1209-4ea2-8103-563c3ff11840"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1be62ab0-db94-495f-8df1-7a27b685f3d4"], Cell["Condition", "TableText",
     FontWeight->Bold,ExpressionUUID->"62031fc6-a099-4ef9-8f08-5365a4b9bfa2"],
     Cell["Why", "TableText",
     FontWeight->Bold,ExpressionUUID->"cfb325f6-6669-4b83-ab3e-c1f6a1061568"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8c8bc23d-20d8-411d-9d0a-8d814d568e20"], Cell[
    "the sequence is a geodesic", "TableText",ExpressionUUID->
     "8c69a35b-4d56-4a9e-98f0-88223d4114b1"], Cell[TextData[{
     "a ray is straight, so ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSegmentQ"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "8f14aa5f-306d-4f25-b88d-8cf6bb852559"],
     " must hold"
    }], "TableText",ExpressionUUID->"b379224e-debb-4d54-8249-1a3e8bf2dc3d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "08c54d26-c66f-441c-aa03-e52ed53cfc4b"], Cell["\<\
no neighbour of the last vertex sits one step farther from the first\
\>", "TableText",ExpressionUUID->"23fb841c-58b1-44f8-8767-dd76a7a3ce77"], 
    Cell["the far end is inextensible", "TableText",ExpressionUUID->
     "fc472aad-ccb3-44e2-a637-8395a919cbda"]}
  }]], "2ColumnTableMod",ExpressionUUID->"60117767-a3f7-48d4-9cb9-\
cbdc99a9a0d8"],

Cell[TextData[{
 "Inextensibility is required ",
 StyleBox["only at the far end",
  FontWeight->"Bold"],
 ". The origin is an endpoint by fiat \[LongDash] that is exactly what \
distinguishes a ray from a line (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0cc3fed0-d511-47ad-9643-d26afb4125ae"],
 " asks for inextensibility at both ends), and it means a ray may start \
anywhere, not only at a peripheral vertex."
}], "Notes",ExpressionUUID->"93c7c89e-2462-4cee-be19-48f04512a00d"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2dc8680-d13b-4d95-b823-5df54bdc3896"],
 ": a single vertex has no direction."
}], "Notes",ExpressionUUID->"698cf5f9-014e-4bbe-b783-0519b698445e"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRay"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d52386a6-378a-48de-a26a-b0fe46780b2c"],
 ", which prolongs a geodesic outward until no neighbour prolongs it, so \
every ray that finder returns satisfies it."
}], "Notes",ExpressionUUID->"d86eabd7-2da1-4b26-b8f4-6bc04af3f2bf"]
}, Open  ]],

