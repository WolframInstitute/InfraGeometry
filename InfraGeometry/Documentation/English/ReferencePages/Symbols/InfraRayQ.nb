Cell[CellGroupData[{
Cell["InfraRayQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d50949a4-6d83-43c6-9e4b-ffa6cd22dc1a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ray", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d2dee82-00e0-4bcd-9cfb-6968df3d0453"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["ray", "TI"],
 " is a ray in ",
 StyleBox["g", "TI"],
 ": a shortest path from its own first vertex that cannot be prolonged past \
its last.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"844148ad-d8c2-4cf8-9126-051bab13f81c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["ray1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41c48dd3-4240-403e-8f89-2a6eb99fad91"],
 "\[LineSeparator]",
 "tests every ray of a list, such as the one ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40d24124-5c96-4798-8056-297f579692ee"],
 " returns."
}], "Usage",ExpressionUUID->"cda70e18-24b2-40b1-9a9b-09be1c807096"],

Cell["\<\
Two conditions, and the asymmetry between them is the whole definition:\
\>", "Notes",ExpressionUUID->"2d2de727-cce6-427a-be46-41648cfc940a"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3b0e681e-4814-48a6-9bc5-a95c747f4d88"], Cell["Condition", "TableText",
     FontWeight->Bold,ExpressionUUID->"d497003d-75df-42c2-a9f0-458a614682ef"],
     Cell["Why", "TableText",
     FontWeight->Bold,ExpressionUUID->"23b13751-17ee-4b3a-a3c0-66dfc44c50fd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "445408b7-c6e2-43a3-9d23-de48aaa561f3"], Cell[
    "the sequence is a shortest path", "TableText",ExpressionUUID->
     "bdef90fa-4c3e-492d-91c0-5142ec9f0ff5"], Cell[TextData[{
     "a ray is straight, so ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSegmentQ"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "f88b8a28-6bb2-4a7c-bc24-c57de446e2c2"],
     " must hold"
    }], "TableText",ExpressionUUID->"cc7d2fc6-a02e-463f-9034-1f61aee894cd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "bdef6cc6-89b5-4a7e-89f0-40053669b428"], Cell["\<\
no neighbour of the last vertex sits one step farther from the first\
\>", "TableText",ExpressionUUID->"b052b4fd-0021-45f3-9cdd-beae3cd15e42"], 
    Cell["the far end is inextensible", "TableText",ExpressionUUID->
     "a7177880-08cf-40e1-a7fb-840b928a5ac0"]}
  }]], "2ColumnTableMod",ExpressionUUID->"ff1acd9d-41b4-4bbe-9815-\
ed6cdb1934cd"],

Cell[TextData[{
 "Inextensibility is required ",
 StyleBox["only at the far end",
  FontWeight->"Bold"],
 ". The origin is an endpoint by fiat \[LongDash] that is exactly what \
distinguishes a ray from a line (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "caef56bb-1d90-42ff-b0a8-c411d0f15ef7"],
 " asks for inextensibility at both ends), and it means a ray may start \
anywhere, not only at a peripheral vertex."
}], "Notes",ExpressionUUID->"ef895ad1-2cc5-4fcc-9011-ef782b59fff8"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6fcf878-e86e-4542-8da8-500ee0dc0fe5"],
 ": a single vertex has no direction."
}], "Notes",ExpressionUUID->"73436c14-5e62-4a25-abb4-d2fe9a4c054d"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraRay"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRay", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a775b168-759f-45b0-9dcf-767859bdf6a9"],
 ", which prolongs a shortest path outward until no neighbour prolongs it, so \
every ray that finder returns satisfies it."
}], "Notes",ExpressionUUID->"3983973d-0bbd-4d68-a4e8-9b24fcd91f8e"]
}, Open  ]],

