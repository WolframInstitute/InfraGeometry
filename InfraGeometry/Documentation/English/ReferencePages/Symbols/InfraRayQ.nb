Cell[CellGroupData[{
Cell["InfraRayQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bfb586c8-b24d-4630-b600-50dd540fa73b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ray", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25cea8fb-819c-4f09-b7a8-ef5ef12b91c8"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["ray", "TI"],
 " is a ray in ",
 StyleBox["g", "TI"],
 ": a geodesic from its own first vertex that cannot be prolonged past its \
last.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0f3134fe-225e-4fa0-b53c-bfb3d1ea82cb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["ray1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d65865c2-11e5-44a3-aa51-b9089472558b"],
 "\[LineSeparator]",
 "tests every ray of a list, such as the one ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b0d89b3-2be2-41ee-9ea0-3a7a73d26ef5"],
 " returns."
}], "Usage",ExpressionUUID->"5f3f8be8-8c05-4345-ba5d-2f6f3c398a5f"],

Cell["\<\
Two conditions, and the asymmetry between them is the whole definition:\
\>", "Notes",ExpressionUUID->"18d5c32d-e693-48c7-b5b4-80f8841645bf"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3207b5e8-e939-4f22-b7d9-ff1ac17c8379"], Cell["Condition", "TableText",
     FontWeight->Bold,ExpressionUUID->"8bcd8408-728a-413b-8c8b-ece3a90c78cc"],
     Cell["Why", "TableText",
     FontWeight->Bold,ExpressionUUID->"922ea097-8cfa-4a9a-a9e6-54f2fd5d358a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "67cda566-e4b2-4b3a-b149-c69f8e07a6a1"], Cell[
    "the sequence is a geodesic", "TableText",ExpressionUUID->
     "20fb26e9-3aa8-4f43-8a4d-7769d5b3f8ec"], Cell[TextData[{
     "a ray is straight, so ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSegmentQ"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "eb687f6c-4cbd-4c4c-9100-0562058772c5"],
     " must hold"
    }], "TableText",ExpressionUUID->"9ebcbafc-2dec-41dd-9e2d-dc9a210cb976"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5fcfaa46-581b-4715-9cd5-5f250b9f1d08"], Cell["\<\
no neighbour of the last vertex sits one step farther from the first\
\>", "TableText",ExpressionUUID->"3135b202-ecd8-4536-9fb0-182c2f438d8c"], 
    Cell["the far end is inextensible", "TableText",ExpressionUUID->
     "81d72f3d-7c78-44a7-bfa1-4fa048cc6627"]}
  }]], "2ColumnTableMod",ExpressionUUID->"741791ad-5137-4a38-bc33-\
7fb362d8964c"],

Cell[TextData[{
 "Inextensibility is required ",
 StyleBox["only at the far end",
  FontWeight->"Bold"],
 ". The origin is an endpoint by fiat \[LongDash] that is exactly what \
distinguishes a ray from a line (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "89acc07f-88ed-4767-918d-a2122dcaa73a"],
 " asks for inextensibility at both ends), and it means a ray may start \
anywhere, not only at a peripheral vertex."
}], "Notes",ExpressionUUID->"0d7db5df-251b-478f-8dd4-7b66ca84190d"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51e5b3b8-e287-4d59-bc9d-7d1d25153974"],
 ": a single vertex has no direction."
}], "Notes",ExpressionUUID->"3997bbe8-f15b-4213-9883-edf7be4e259b"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRay"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "65fa6338-725c-4a08-be5e-8174642f1c79"],
 ", which prolongs a geodesic outward until no neighbour prolongs it, so \
every ray that finder returns satisfies it."
}], "Notes",ExpressionUUID->"8f1df4d2-af06-41b0-a1ba-7f02adb7424e"]
}, Open  ]],

