Cell[CellGroupData[{
Cell["InfraRayQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2ff3228e-3e7b-4bc0-a72c-fb88aaa8604b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ray", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ccfda89-b735-4936-b9a4-1ad14f14fccd"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["ray", "TI"],
 " is a ray in ",
 StyleBox["g", "TI"],
 ": a shortest path from its own first vertex that cannot be prolonged past \
its last.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"aad8386d-9e41-463d-903a-3cb4e16b2425"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["ray1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "134ce472-55bd-4611-b918-a9edd96709b2"],
 "\[LineSeparator]",
 "tests every ray of a list, such as the one ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1429ee35-5b1f-481f-8997-98ea453ed426"],
 " returns."
}], "Usage",ExpressionUUID->"0e6c4dc4-02cd-4a90-a02a-903f5831f4ab"],

Cell[TextData[{
 "This is the legacy compatibility spelling. New code uses ",
 Cell[BoxData["InfraHalfLineQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e6fd6a9-f12c-49c9-a972-9777e4e51e02"],
 "."
}], "Notes",ExpressionUUID->"e6cbf79e-8d6c-4f3c-9cc1-da509831e02e"],

Cell["\<\
Two conditions, and the asymmetry between them is the whole definition:\
\>", "Notes",ExpressionUUID->"d3e9e106-a190-42d4-87f3-5d089c55b9c5"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "77c30df2-6288-4651-987b-cc56074a38b8"], Cell["Condition", "TableText",
     FontWeight->Bold,ExpressionUUID->"41739929-a8d9-4306-9e0c-2f14f043d647"],
     Cell["Why", "TableText",
     FontWeight->Bold,ExpressionUUID->"f5832df4-c8f5-468d-b976-32ecaff8ca1d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6ece0de4-4bc0-4b66-a204-f723b151bd61"], Cell[
    "the sequence is a shortest path", "TableText",ExpressionUUID->
     "043dd6dd-7a61-4a93-b838-1830aff7bdc3"], Cell[TextData[{
     "a ray is straight, so ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSegmentQ"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "cf333513-46fa-4d98-bee6-772294469255"],
     " must hold"
    }], "TableText",ExpressionUUID->"4ff3de8c-fb53-4df0-9067-d7ec88eb69d3"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "39044fa4-ebd9-4ed8-add5-53a6009be69a"], Cell["\<\
no neighbour of the last vertex sits one step farther from the first\
\>", "TableText",ExpressionUUID->"1a95db20-11a2-4f10-bc8f-712b8cedd93a"], 
    Cell["the far end is inextensible", "TableText",ExpressionUUID->
     "2f9e2786-c4af-4436-9dac-0e17fda687d5"]}
  }]], "2ColumnTableMod",ExpressionUUID->"57411d34-3143-464f-a81b-\
4bef76f03d15"],

Cell[TextData[{
 "Inextensibility is required ",
 StyleBox["only at the far end",
  FontWeight->"Bold"],
 ". The origin is an endpoint by fiat \[LongDash] that is exactly what \
distinguishes a ray from a line (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b9bd44d9-5994-4091-bb17-b78c46e8125b"],
 " asks for inextensibility at both ends), and it means a ray may start \
anywhere, not only at a peripheral vertex."
}], "Notes",ExpressionUUID->"a4e36345-660f-4583-85b4-9d21cecfd4c7"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2a17b55-2f54-480e-bd46-682c9a57ea3f"],
 ": a single vertex has no direction."
}], "Notes",ExpressionUUID->"d01f7d9d-5552-422d-a105-2fd7aacf5939"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraRay"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRay", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f3889222-98fe-4d37-9a38-6b513b1f5815"],
 ", which prolongs a shortest path outward until no neighbour prolongs it, so \
every ray that finder returns satisfies it."
}], "Notes",ExpressionUUID->"0dd9a258-a323-42d3-80f6-dfe898006231"]
}, Open  ]],

