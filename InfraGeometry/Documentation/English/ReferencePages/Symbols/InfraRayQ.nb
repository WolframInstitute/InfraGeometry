Cell["InfraRayQ", "ObjectName",ExpressionUUID->"a64e38d5-c4da-456f-a7aa-b17c82e73b74"],

Cell["LLM generated.", "Notes",ExpressionUUID->"47717891-77ec-4bd6-8ce8-d50b59256346"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"87184ed2-cea0-4386-a141-ef2b2351989c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
