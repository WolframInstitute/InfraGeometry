  FontSize->0.9 Inherited,ExpressionUUID->
  "230db25e-947a-461b-a76b-e824b91122ab"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["ray", "TI"],
 " is a ray in ",
 StyleBox["g", "TI"],
 ": a shortest path from its own first vertex that cannot be prolonged past \
its last.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4e8ce1a1-eb27-483d-b924-9fbb01c32e2f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["ray1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60a224e7-5237-423c-825a-439e114ae289"],
 "\[LineSeparator]",
 "tests every ray of a list, such as the one ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRay", 
