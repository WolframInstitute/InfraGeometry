Cell["\<\
Dropping the far vertex breaks inextensibility, so the truncation is no \
longer a ray.\
\>", "ExampleText",ExpressionUUID->"768f1d1b-aecc-43b6-80fc-6ff011ea8eec"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ray", " ", "=", " ", 
     RowBox[{"RandomInfraRay", "[", 
      RowBox[{"g", ",", " ", "1", ",", " ", "13", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraRayQ", "[", 
      RowBox[{"g", ",", " ", "ray"}], "]"}], ",", " ", 
     RowBox[{"InfraRayQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Most", " ", "@", " ", "ray"}]}], "]"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5dd0b791-306b-48bb-9617-d2b96d703bb4"],

