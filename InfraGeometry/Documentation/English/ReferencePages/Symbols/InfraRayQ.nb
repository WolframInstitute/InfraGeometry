Notebook[{

Cell[CellGroupData[{
Cell["InfraRayQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"595b0f59-b89c-4dcb-a3e3-38387efb18af"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ray", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cc9fa38-875c-4a79-9dbc-f6af758e1c6a"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["ray", "TI"],
 " is a ray in ",
 StyleBox["g", "TI"],
 ": a geodesic from its own first vertex that cannot be prolonged past its \
last.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b5e71aac-d843-481c-b9af-fbf522d56a19"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["ray1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58f2425e-a1ad-425c-abf7-047fe5ee191c"],
 "\[LineSeparator]",
 "tests every ray of a list, such as the one ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "353003ad-598f-427b-854c-65beebe4141a"],
 " returns."
}], "Usage",ExpressionUUID->"7426b403-f267-4c9c-9bd7-1f0751d0bf5d"],

Cell["\<\
Two conditions, and the asymmetry between them is the whole definition:\
\>", "Notes",ExpressionUUID->"cea9ae7d-bdba-4433-8d85-d45801870e9b"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ed6f87ae-89b6-45fc-9370-9a7c2272d97d"], Cell["Condition", "TableText",
     FontWeight->Bold,ExpressionUUID->"83ce02f3-5439-43b1-9883-3ed28c35fe9f"],
     Cell["Why", "TableText",
     FontWeight->Bold,ExpressionUUID->"7e6443e2-801d-45eb-99b0-a77a45e458db"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "dd82edcf-394f-4036-b6c9-68bc6ef99fb6"], Cell[
    "the sequence is a geodesic", "TableText",ExpressionUUID->
     "776f987a-9c39-431b-88c2-72ffe5b5ad92"], Cell[TextData[{
     "a ray is straight, so ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSegmentQ"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "9f976105-956d-42a6-bc95-7283aafdb281"],
     " must hold"
    }], "TableText",ExpressionUUID->"c5bb1c67-1736-4c32-a216-cc62be53f2c6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0b66c479-d394-4592-ad52-92bc54838038"], Cell["\<\
no neighbour of the last vertex sits one step farther from the first\
\>", "TableText",ExpressionUUID->"1c8cf268-4ccf-4f11-a519-8bc7393d7da5"], 
    Cell["the far end is inextensible", "TableText",ExpressionUUID->
     "4dcc195b-67db-49e6-9e8c-065efadde24c"]}
  }]], "2ColumnTableMod",ExpressionUUID->"4bc3b59b-512b-4005-9cb8-\
6c722dad442a"],

Cell[TextData[{
 "Inextensibility is required ",
 StyleBox["only at the far end",
  FontWeight->"Bold"],
 ". The origin is an endpoint by fiat \[LongDash] that is exactly what \
distinguishes a ray from a line (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7e7a3391-beff-4b46-9997-c9229d27ce99"],
 " asks for inextensibility at both ends), and it means a ray may start \
anywhere, not only at a peripheral vertex."
}], "Notes",ExpressionUUID->"b7b00296-42bd-4019-841e-29864fee3526"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7827a433-c084-43cf-aa86-1a3f752f75ec"],
 ": a single vertex has no direction."
}], "Notes",ExpressionUUID->"955d2160-856e-478c-92d1-7a61df225481"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRay"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "557e39c3-48b5-4dba-9d70-be755b7c22fa"],
 ", which prolongs a geodesic outward until no neighbour prolongs it, so \
every ray that finder returns satisfies it."
}], "Notes",ExpressionUUID->"b7ad61c4-13d8-4e8d-b65b-0313ac0247ee"]
}, Open  ]],

