Cell[CellGroupData[{
Cell["InfraRayQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8ead4b31-d5be-4edb-ae25-cf7b721eb48c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ray", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e6eeb7e-8dcf-4658-83c9-b5e84f6087cb"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["ray", "TI"],
 " is a ray in ",
 StyleBox["g", "TI"],
 ": a shortest path from its own first vertex that cannot be prolonged past \
its last.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"490c237e-99eb-4460-9ff9-c1a46042de7e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["ray1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b724612-473e-4c9b-8e5d-6995f70fc9ba"],
 "\[LineSeparator]",
 "tests every ray of a list, such as the one ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca2744b6-0203-470e-a327-4b7231ce72e1"],
 " returns."
}], "Usage",ExpressionUUID->"9c1bdb54-c043-4174-bde0-3ad68f6472ce"],

Cell[TextData[{
 "This is the legacy compatibility spelling. New code uses ",
 Cell[BoxData["InfraHalfLineQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cae80918-681c-4c17-ab35-c3ccb36c9e87"],
 "."
}], "Notes",ExpressionUUID->"c47a7399-71e1-447a-97d5-91cd8720b9c5"],

Cell["\<\
Two conditions, and the asymmetry between them is the whole definition:\
\>", "Notes",ExpressionUUID->"bd21bb71-90a2-4f85-b07f-36318436263c"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3b3e6a25-066d-4f84-9254-702cc3e7f081"], Cell["Condition", "TableText",
     FontWeight->Bold,ExpressionUUID->"90333c9a-516c-471d-aaaf-0a9b1729dc2a"],
     Cell["Why", "TableText",
     FontWeight->Bold,ExpressionUUID->"e7d80bd1-2ce3-4200-ab25-c7da6c114bdf"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4d1b04eb-ac6e-4538-bead-4928d853a54d"], Cell[
    "the sequence is a shortest path", "TableText",ExpressionUUID->
     "2eff3f01-fd6f-4e8e-823b-41bd39a86c9f"], Cell[TextData[{
     "a ray is straight, so ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSegmentQ"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "b3fb7520-5ee0-4e37-b64e-80b957077434"],
     " must hold"
    }], "TableText",ExpressionUUID->"3ddf2f7c-1a12-47d6-b86d-4fa55f593987"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fe2f407e-5c9c-4b06-a868-605bef2b0b42"], Cell["\<\
no neighbour of the last vertex sits one step farther from the first\
\>", "TableText",ExpressionUUID->"3dae0bba-ff2c-42ed-9223-bacc088ac612"], 
    Cell["the far end is inextensible", "TableText",ExpressionUUID->
     "a8d777c3-5adc-4d19-b5fa-ca712d8baa30"]}
  }]], "2ColumnTableMod",ExpressionUUID->"8c776d45-4712-466a-8a7a-\
75cc07dffcd0"],

Cell[TextData[{
 "Inextensibility is required ",
 StyleBox["only at the far end",
  FontWeight->"Bold"],
 ". The origin is an endpoint by fiat \[LongDash] that is exactly what \
distinguishes a ray from a line (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "912326eb-7ec5-41b6-ae93-7a839e135b0a"],
 " asks for inextensibility at both ends), and it means a ray may start \
anywhere, not only at a peripheral vertex."
}], "Notes",ExpressionUUID->"d604bd0f-1d14-45b3-a100-7c88f2f8e331"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c22cbfd5-a7f3-4ad8-9686-7e6e02410c6d"],
 ": a single vertex has no direction."
}], "Notes",ExpressionUUID->"5a4633a0-27e7-4246-ae72-fafc2c839211"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraRay"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRay", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a1a7c9e3-cfa5-4035-b49c-281d86c7d481"],
 ", which prolongs a shortest path outward until no neighbour prolongs it, so \
every ray that finder returns satisfies it."
}], "Notes",ExpressionUUID->"a709484d-7a1c-4b67-8151-d894d3ff3dc6"]
}, Open  ]],

