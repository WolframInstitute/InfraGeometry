Cell["\<\
Dropping the far vertex breaks inextensibility, so the truncation is no \
longer a ray.\
\>", "ExampleText",ExpressionUUID->"f96fb41f-22af-4a06-a37d-ec647b755e2b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
