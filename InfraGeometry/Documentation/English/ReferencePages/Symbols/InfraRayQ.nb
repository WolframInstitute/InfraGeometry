Notebook[{

Cell[CellGroupData[{
Cell["InfraRayQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bd094333-48d9-4c8b-8ddc-0e9966f6743d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ray", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "116fd728-01b0-4667-9745-16eccc8838ab"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["ray", "TI"],
 " is a ray in ",
 StyleBox["g", "TI"],
 ": a geodesic from its own first vertex that cannot be prolonged past its \
last.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2b64bc7c-8ba3-4fc3-8ecc-9ca1ed3b6cc7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["ray1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6db91b5-9e34-4f14-ab62-61eaf191513a"],
 "\[LineSeparator]",
 "tests every ray of a list, such as the one ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b894046e-52b3-45b4-be0e-70fa4bb670d8"],
 " returns."
}], "Usage",ExpressionUUID->"7b65bccd-07dc-4cc8-9b0a-a6ddf3637abb"],

Cell["\<\
Two conditions, and the asymmetry between them is the whole definition:\
\>", "Notes",ExpressionUUID->"8fb554c3-d9dd-4779-9185-8b71d31967b0"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d7f8c029-5609-42e5-ba2a-fa242f7a86b4"], Cell["Condition", "TableText",
     FontWeight->Bold,ExpressionUUID->"319618bb-e593-44cc-bf45-a8765fded6ed"],
     Cell["Why", "TableText",
     FontWeight->Bold,ExpressionUUID->"ea043314-b882-4e12-b9d3-c82e29b7c7f6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9ea17dca-6177-4496-87de-3e9134aa7a6b"], Cell[
    "the sequence is a geodesic", "TableText",ExpressionUUID->
     "78cfba6c-a720-4628-bec5-60d09f96a600"], Cell[TextData[{
     "a ray is straight, so ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSegmentQ"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "1ac2bfb4-2309-426b-9928-6dc087c7d5d1"],
     " must hold"
    }], "TableText",ExpressionUUID->"fc6f7246-cded-4133-a6a1-bbb9b277028a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ae7958c5-c4c8-4884-9136-2d569fd571c5"], Cell["\<\
no neighbour of the last vertex sits one step farther from the first\
\>", "TableText",ExpressionUUID->"bc4a0231-cc07-49e5-a749-da286548a08b"], 
    Cell["the far end is inextensible", "TableText",ExpressionUUID->
     "004c030b-9c45-4916-872f-44ce793dffc5"]}
  }]], "2ColumnTableMod",ExpressionUUID->"f1cb2fbe-b921-4395-a73b-\
04552bc642f4"],

Cell[TextData[{
 "Inextensibility is required ",
 StyleBox["only at the far end",
  FontWeight->"Bold"],
 ". The origin is an endpoint by fiat \[LongDash] that is exactly what \
distinguishes a ray from a line (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b0a1d63f-33b4-42c8-a30a-96df47218423"],
 " asks for inextensibility at both ends), and it means a ray may start \
anywhere, not only at a peripheral vertex."
}], "Notes",ExpressionUUID->"b8cf966b-46fc-4ea4-9b81-deb94d9dfdec"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b751272-efba-4568-bd73-0634a85fcc20"],
 ": a single vertex has no direction."
}], "Notes",ExpressionUUID->"bfe4d24a-3214-4956-aea4-fc3c3b6c3e44"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRay"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9fde1039-8431-41e7-b475-9794564d5d6e"],
 ", which prolongs a geodesic outward until no neighbour prolongs it, so \
every ray that finder returns satisfies it."
}], "Notes",ExpressionUUID->"9324f31e-8e57-4417-b1d9-eaa799c980e4"]
}, Open  ]],

