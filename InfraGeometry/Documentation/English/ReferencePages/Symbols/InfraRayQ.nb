Cell[CellGroupData[{
Cell["InfraRayQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"514459e2-1041-4d99-b583-228890293cda"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ray", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af7bad34-4e78-410c-b840-b877695fa3ce"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["ray", "TI"],
 " is a ray in ",
 StyleBox["g", "TI"],
 ": a geodesic from its own first vertex that cannot be prolonged past its \
last.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"821d60a5-4c6d-4ca8-a6df-a406a3d64cea"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["ray1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa926a57-6e5f-43c8-a58f-e06546a4634e"],
 "\[LineSeparator]",
 "tests every ray of a list, such as the one ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "736b1344-ba6d-4cef-b6a5-573ddc79aab1"],
 " returns."
}], "Usage",ExpressionUUID->"70d39e9f-7c46-4beb-a715-d9d831be539d"],

Cell["\<\
Two conditions, and the asymmetry between them is the whole definition:\
\>", "Notes",ExpressionUUID->"502cb690-6d8b-43d7-bd38-4ae1e6194d55"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b212bf00-979a-4508-91a6-63e778f0f984"], Cell["Condition", "TableText",
     FontWeight->Bold,ExpressionUUID->"15c01b00-3a31-4ecf-9bea-1faba86c64a2"],
     Cell["Why", "TableText",
     FontWeight->Bold,ExpressionUUID->"d9e824d5-f798-407d-b9e8-3f5bffbdd59e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fc6a6c0f-1455-4e39-81e0-f12e00613c51"], Cell[
    "the sequence is a geodesic", "TableText",ExpressionUUID->
     "b01a5286-7921-4fa7-9bce-cbdb1606f092"], Cell[TextData[{
     "a ray is straight, so ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSegmentQ"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "a87741f4-9307-430d-ac58-d168c3a80c0d"],
     " must hold"
    }], "TableText",ExpressionUUID->"0bef93e9-4348-4960-992c-a0c88c123074"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c9d19c96-b632-499a-8945-061d2d8d9d86"], Cell["\<\
no neighbour of the last vertex sits one step farther from the first\
\>", "TableText",ExpressionUUID->"7c4a0247-0fee-4bbd-a811-3cd63a4f468f"], 
    Cell["the far end is inextensible", "TableText",ExpressionUUID->
     "4126f2ed-39aa-479a-8315-df468f54f813"]}
  }]], "2ColumnTableMod",ExpressionUUID->"0e0297ea-b6cb-4580-963f-\
4e6eb4a59829"],

Cell[TextData[{
 "Inextensibility is required ",
 StyleBox["only at the far end",
  FontWeight->"Bold"],
 ". The origin is an endpoint by fiat \[LongDash] that is exactly what \
distinguishes a ray from a line (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b7132d14-21b0-4b4e-8881-8dd9ff3e6e41"],
 " asks for inextensibility at both ends), and it means a ray may start \
anywhere, not only at a peripheral vertex."
}], "Notes",ExpressionUUID->"1dc0a130-4a60-4651-b683-1cf1797177a8"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "811d96b1-33c1-43b3-ae20-21f0f2d68fc4"],
 ": a single vertex has no direction."
}], "Notes",ExpressionUUID->"f7733514-11c8-47ca-a72e-a7de7f66e51b"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRay"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cf26b411-58e1-4a1d-966b-9882d4fc355d"],
 ", which prolongs a geodesic outward until no neighbour prolongs it, so \
every ray that finder returns satisfies it."
}], "Notes",ExpressionUUID->"9de44ff8-b69a-4708-a939-6fe91d50f4cd"]
}, Open  ]],

