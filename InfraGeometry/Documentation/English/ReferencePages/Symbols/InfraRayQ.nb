       RowBox[{"Most", " ", "@", " ", "ray"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f920ab01-f747-4394-b0db-5cd2207f90af"],

