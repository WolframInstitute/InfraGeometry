Cell["\<\
Dropping the far vertex breaks inextensibility, so the truncation is no \
longer a ray.\
\>", "ExampleText",ExpressionUUID->"50af3341-2665-4a01-acd5-b929f58da37d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
