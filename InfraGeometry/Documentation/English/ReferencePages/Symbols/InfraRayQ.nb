Cell[CellGroupData[{
Cell["InfraRayQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a700a232-dff4-4814-a158-fe131025b0fb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ray", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05e473f9-a53f-4e8e-9990-2bbf5573f15e"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["ray", "TI"],
 " is a ray in ",
 StyleBox["g", "TI"],
 ": a geodesic from its own first vertex that cannot be prolonged past its \
last.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"93708815-e146-43d8-bb7d-e14a4b7a34e6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["ray1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60fa3193-6e45-4800-8cf4-104bdbb6b90f"],
 "\[LineSeparator]",
 "tests every ray of a list, such as the one ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7771159f-634d-4822-b0c3-b4aaa4d12d42"],
 " returns."
}], "Usage",ExpressionUUID->"e44a41d4-62eb-4af0-8f14-1403c7ec4c18"],

Cell["\<\
Two conditions, and the asymmetry between them is the whole definition:\
\>", "Notes",ExpressionUUID->"2952845f-ff6b-4fbd-b5bc-62f0d4a5ae2e"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "457c876c-6732-4f9c-a0f0-31bab967f18f"], Cell["Condition", "TableText",
     FontWeight->Bold,ExpressionUUID->"423f826e-4efe-4ea9-9e0e-d6aafb6e5fa1"],
     Cell["Why", "TableText",
     FontWeight->Bold,ExpressionUUID->"4d9ad60e-3a5b-473c-bb25-c700d0fc0be8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4b0feefb-0557-42a1-ba5c-b8ad9c58aac6"], Cell[
    "the sequence is a geodesic", "TableText",ExpressionUUID->
     "c030303b-6ae6-4b7e-929e-04db7f714e81"], Cell[TextData[{
     "a ray is straight, so ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSegmentQ"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "1286a12b-d4d6-441b-bcf1-c29c7b888da6"],
     " must hold"
    }], "TableText",ExpressionUUID->"8336e947-d96c-4998-8906-c69c12a89df0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a70a2704-a340-4263-91d0-902696a14375"], Cell["\<\
no neighbour of the last vertex sits one step farther from the first\
\>", "TableText",ExpressionUUID->"fbe6866b-91f7-465f-a708-65a19a633991"], 
    Cell["the far end is inextensible", "TableText",ExpressionUUID->
     "2f74a7fd-ea5f-409f-8c6a-1be134f5f1d4"]}
  }]], "2ColumnTableMod",ExpressionUUID->"34d52711-c80c-4d57-aec2-\
4edd2c804b5d"],

Cell[TextData[{
 "Inextensibility is required ",
 StyleBox["only at the far end",
  FontWeight->"Bold"],
 ". The origin is an endpoint by fiat \[LongDash] that is exactly what \
distinguishes a ray from a line (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cce57275-ecd0-4dee-a283-5631e648a498"],
 " asks for inextensibility at both ends), and it means a ray may start \
anywhere, not only at a peripheral vertex."
}], "Notes",ExpressionUUID->"7527c174-8c09-4dbf-afa3-90363ea517f3"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f1deaef2-c7f1-44f4-8eea-a2793433c117"],
 ": a single vertex has no direction."
}], "Notes",ExpressionUUID->"6cf21dde-7861-4f39-a7ac-20bcf972fca5"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRay"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3f236805-0c3e-4dcd-8c4d-be99760fb299"],
 ", which prolongs a geodesic outward until no neighbour prolongs it, so \
every ray that finder returns satisfies it."
}], "Notes",ExpressionUUID->"9351550d-3d81-4808-9e12-8983621c0a07"]
}, Open  ]],

