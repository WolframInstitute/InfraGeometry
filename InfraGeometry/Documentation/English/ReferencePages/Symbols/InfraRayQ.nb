Cell[CellGroupData[{
Cell["InfraRayQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"726a80b7-7925-4701-8976-011885b3b698"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ray", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f254c92e-45a4-4f8d-8179-8ead66c4c5ba"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["ray", "TI"],
 " is a ray in ",
 StyleBox["g", "TI"],
 ": a geodesic from its own first vertex that cannot be prolonged past its \
last.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8d311848-cf22-4bc4-b9c8-caef9d90bd82"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["ray1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e595a3b-17e1-4f00-8d71-e48a6dde18f6"],
 "\[LineSeparator]",
 "tests every ray of a list, such as the one ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc700058-f39f-4934-993e-b98a893d8441"],
 " returns."
}], "Usage",ExpressionUUID->"5fd17102-d1e2-4d99-bb24-7261850149be"],

Cell["\<\
Two conditions, and the asymmetry between them is the whole definition:\
\>", "Notes",ExpressionUUID->"15c25c6e-5166-453c-8037-699a146175db"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6264a11e-71f8-4a71-8500-25a333e7b975"], Cell["Condition", "TableText",
     FontWeight->Bold,ExpressionUUID->"3ce5bb2c-0c5e-44ed-a10e-7177db3bb2a5"],
     Cell["Why", "TableText",
     FontWeight->Bold,ExpressionUUID->"da8ed7ec-37ac-45a5-b952-23a651e07862"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "aee140a6-d5a6-4bdc-91d7-912706b433f5"], Cell[
    "the sequence is a geodesic", "TableText",ExpressionUUID->
     "6cabf5b3-effd-42dd-83b8-7b6524932926"], Cell[TextData[{
     "a ray is straight, so ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSegmentQ"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "fe19693c-2919-4dee-a32c-bdc45c8c0437"],
     " must hold"
    }], "TableText",ExpressionUUID->"03ffcbd9-2e0b-4180-8ac2-0d28ada1f844"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "bd6f5651-eb73-4e6a-9ebd-15b20c0aaadf"], Cell["\<\
no neighbour of the last vertex sits one step farther from the first\
\>", "TableText",ExpressionUUID->"17c88a9b-d6f6-42bc-b0ed-e59989e1bce8"], 
    Cell["the far end is inextensible", "TableText",ExpressionUUID->
     "ab8cfe70-a21e-4eb9-8d54-7010888893bf"]}
  }]], "2ColumnTableMod",ExpressionUUID->"b3708ff0-0de0-47f6-9708-\
e5b0ad6f2fde"],

Cell[TextData[{
 "Inextensibility is required ",
 StyleBox["only at the far end",
  FontWeight->"Bold"],
 ". The origin is an endpoint by fiat \[LongDash] that is exactly what \
distinguishes a ray from a line (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5f52ca03-9811-4e6d-aa2d-5b2ce95a7f6c"],
 " asks for inextensibility at both ends), and it means a ray may start \
anywhere, not only at a peripheral vertex."
}], "Notes",ExpressionUUID->"76ebdab5-be94-41a9-8440-6eb554d2f1b6"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e293a902-a9b1-4d5f-8ed4-f34490a99373"],
 ": a single vertex has no direction."
}], "Notes",ExpressionUUID->"2b2b92ad-7391-43b0-b371-e6df71d17b68"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraRay"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRay", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f7cbcc18-0b3b-44f7-9593-8f972435712e"],
 ", which prolongs a geodesic outward until no neighbour prolongs it, so \
every ray that finder returns satisfies it."
}], "Notes",ExpressionUUID->"db42c932-0ba3-4d25-b13b-26650bcb5179"]
}, Open  ]],

