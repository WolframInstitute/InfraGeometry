Cell["\<\
Dropping the far vertex breaks inextensibility, so the truncation is no \
longer a ray.\
\>", "ExampleText",ExpressionUUID->"7d8d5604-e00f-4ecb-a8d6-df2e68253390"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
