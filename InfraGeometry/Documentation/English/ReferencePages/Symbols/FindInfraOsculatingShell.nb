Cell[TextData[{
 "The number of shells through the window against its size ",
 StyleBox["k", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"0ba0bc6a-4075-4097-9df7-90ce06c8219f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cycle", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"RandomInfraCircle", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCircle", "[", 
         RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "All"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"k", " ", "->", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"FindInfraOsculatingShell", "[", 
        RowBox[{"g", ",", " ", "cycle", ",", " ", "6", ",", " ", "k"}], 
        "]"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "1", ",", " ", "11", ",", " ", "2"}], "}"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b9a12585-540b-457a-855a-9b7bd1cbcd42"],

Cell[BoxData[
 RowBox[{"{", 
