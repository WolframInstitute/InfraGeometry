Cell["\<\
The single shell of the long window is the shell of radius 3 about the centre:\
\>", "ExampleText",ExpressionUUID->"4e725203-8974-4932-b16a-2fd49ed31ac9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cycle", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"RandomInfraCircle", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCircle", "[", 
         RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "All"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"FindInfraOsculatingShell", "[", 
     RowBox[{"g", ",", " ", "cycle", ",", " ", "6", ",", " ", "7"}], "]"}], 
    " ", "==", " ", 
    RowBox[{"{", 
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "3"}], "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}]}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"d2c7222d-6d48-40d1-860d-e2a0ced33155"],

