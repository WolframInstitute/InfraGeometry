Cell[CellGroupData[{
Cell["FindInfraOsculatingShell", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6d258206-79fd-4993-ad89-aeae4f38be8a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOsculatingShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOsculatingShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"], ",", " ", 
    StyleBox["i", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03550b34-a292-4c70-9851-1d0bd87b5892"],
 "\[LineSeparator]",
 "gives the shells that contain the ",
 StyleBox["k", "TI"],
 " vertices of ",
 StyleBox["walk", "TI"],
 " around position ",
 StyleBox["i", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b8ed25eb-a988-43e1-a007-5d265653d7af"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOsculatingShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOsculatingShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"], ",", " ", 
    StyleBox["i", "TI"], ",", " ", 
    StyleBox["k", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0487ff1-4ce6-4c03-b2ad-461f190a6267"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["n", "TI"],
 " of them."
}], "Usage",ExpressionUUID->"26ab1e22-8463-474d-8733-0057e2744920"],

Cell[TextData[{
 "The window is the ",
 StyleBox["k", "TI"],
 " consecutive vertices of the walk centred at position ",
 StyleBox["i", "TI"],
 ", cut off at the ends of the walk. For every vertex ",
 StyleBox["c", "TI"],
 " at one common distance ",
 StyleBox["r", "TI"],
 " from all window vertices, the result contains the shell ",
 StyleBox["S\:1d63(c) = {v : d(c, v) = r}", "TI"],
 ", as a sorted vertex list. Shells come in order of increasing ",
 StyleBox["r", "TI"],
 "."
}], "Notes",ExpressionUUID->"a3c02f75-5e10-4c03-98d7-2d8a853566c4"],

Cell[TextData[{
 "It is the graph analogue of the osculating circle: the circles through ",
 StyleBox["k", "TI"],
 " nearby points of a curve. In the plane three points fix one circle. On a \
graph a short window lies on many shells, and a longer one cuts them down."
}], "Notes",ExpressionUUID->"06e9e256-1544-4523-b532-b46148624550"],

Cell["\<\
The walk can be a vertex list, a walk graph or a list of walk graphs.\
\>", "Notes",ExpressionUUID->"f15f51f9-bb45-4911-add0-4c4332885092"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f6830ba-ce92-46e0-b41d-49f2e7442581"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7336e10-c522-4b8b-9760-c25e17ee48fc"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4487d471-abf5-4954-878a-2229839a8fb8"],
 ", the default. Fewer than ",
 StyleBox["n", "TI"],
 " shells give ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e439809-a720-4c45-8cc4-d00b6bbec883"],
 "."
}], "Notes",ExpressionUUID->"9650f9ef-055b-48d5-822a-b4c63419afbe"],

