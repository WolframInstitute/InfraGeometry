     "040793d9-75b7-4f70-9a3e-d2c5d7ab6c17"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f8292067-9083-430c-950f-b0dd47da83f1"], Cell[TextData[Cell[
    BoxData["\"\<RayCount\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "4de0807f-93bb-4a7f-98cb-48a3412acbb1"]], "TableText",ExpressionUUID->
     "46d59f7f-70c5-49d6-8fea-34724909c502"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "81fc2ac9-2d2f-4e71-b70f-61aa0dc7f234"]], "TableText",ExpressionUUID->
     "08843238-74c1-48da-8779-c43bce7e4a49"], Cell[
    "the number of rays in a set", "TableText",ExpressionUUID->
     "b8fd4db7-5b87-406f-85bc-3b819842fd33"]}
  }]], "3ColumnTableMod",ExpressionUUID->"ecd1e28e-2c5d-4894-a5b5-\
2c1536d0a961"],

Cell[TextData[{
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5a21b7c-47d0-451a-ba28-2b990cb7e1fd"],
 ", ",
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "761e6e04-00ef-4244-b8d1-6a094d8c00d2"],
 " and the count act as on ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dc168788-1ee6-4c6f-b693-fad2833876e5"],
 ". ",
 Cell[BoxData[
  RowBox[{"\"\<RayCount\>\"", " ", "->", " ", "k"}]], "InlineFormula",
