Cell["\<\
The frame of rays is not a basis: the opposite rays are two of its members. \
Count the directions after identifying each ray with its negative, or take \
the axes.\
\>", "ExampleText",ExpressionUUID->"323aaee9-2faa-4e91-b196-0d66779525d2"],

Cell[TextData[{
 "The same cost as the axes: the candidates grow like the shortest paths from \
",
 StyleBox["c", "TI"],
 ", so a long length on a large grid is slow."
}], "ExampleText",ExpressionUUID->"702a06ed-7c76-4254-a94d-7a40417ee81e"]
