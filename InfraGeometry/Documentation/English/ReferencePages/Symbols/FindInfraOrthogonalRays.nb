     "f907810c-e1e7-47c6-9250-69a428b88b91"]}
  }]], "3ColumnTableMod",ExpressionUUID->"ef14e2ae-be75-4b14-a0a7-\
ec777e3d69c9"],

Cell[TextData[{
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ea01bb2-4655-4e6d-a850-48cdfd999de7"],
