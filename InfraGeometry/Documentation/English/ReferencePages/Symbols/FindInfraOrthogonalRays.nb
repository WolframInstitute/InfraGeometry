Notebook[{

Cell[CellGroupData[{
Cell["FindInfraOrthogonalRays", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6ee5af32-0731-4a20-bcbc-8348fdcf741b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOrthogonalRays"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalRays", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["len", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf14c368-3fa6-4608-a4a1-86872e61a3ea"],
 "\[LineSeparator]",
 "gives one maximal set of mutually perpendicular geodesic rays from the \
vertex ",
 StyleBox["c", "TI"],
 ", each a vertex list starting at ",
 StyleBox["c", "TI"],
 ", the straightest set first.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"32e2877e-61d2-426e-b270-81e9f7c9123f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOrthogonalRays"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalRays", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["len", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92d9b1f1-6e3a-4e43-974c-d3fb1906133a"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5b0221b-6705-46fa-a6a9-36bae8bfead4"],
 " of exactly ",
 StyleBox["n", "TI"],
 " such sets or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6781577a-8488-4c8c-96a1-e87518b49329"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86da8677-a575-489f-9f8b-07793bb533b8"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8ef2f88-cd5a-417b-a552-b95067ce44f7"],
 " gives every one."
}], "Usage",ExpressionUUID->"34f83aa0-7aa7-47c3-a791-0754d44e7870"],

Cell[TextData[{
 "The problem is well posed. Fix a graph ",
 StyleBox["g", "TI"],
 ", a vertex ",
 StyleBox["c", "TI"],
 " and a length ",
 StyleBox["len", "TI"],
 "."
}], "Notes",ExpressionUUID->"01b7632a-ceef-4d44-9186-ce78aeefd3e3"],

Cell[TextData[{
 "A ",
 StyleBox["ray",
  FontWeight->"Bold"],
 " at ",
 StyleBox["c", "TI"],
 " is a geodesic from ",
 StyleBox["c", "TI"],
 ", a vertex list starting at ",
 StyleBox["c", "TI"],
 " with a length in ",
 StyleBox["len", "TI"],
 ", maximal there: its last vertex has no neighbour that prolongs it to a \
longer geodesic from ",
 StyleBox["c", "TI"],
 " inside ",
 StyleBox["len", "TI"],
 ". The rays form a finite set in the ball of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 ", ",
 StyleBox["r", "TI"],
 " the largest length."
}], "Notes",ExpressionUUID->"f5476b2c-ff3b-49bd-863e-594c280e5083"],

Cell[TextData[{
 "Two rays are ",
 StyleBox["perpendicular",
  FontWeight->"Bold"],
 " by the test of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "89520421-f3d8-40fb-be8d-cd4a66984ca5"],
 ": the shortest-path projection of every vertex of each onto the other is ",
 StyleBox["c", "TI"],
 ", that is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"d", 
    RowBox[{"(", 
     RowBox[{"v", ",", " ", "w"}], ")"}]}], " ", ">", " ", 
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{"d", 
      RowBox[{"(", 
       RowBox[{"c", ",", " ", "v"}], ")"}]}], ",", " ", 
     RowBox[{"d", 
      RowBox[{"(", 
       RowBox[{"c", ",", " ", "w"}], ")"}]}]}], "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e645777-e0b1-41f9-9453-aec331e73c42"],
 " for every vertex ",
 StyleBox["v", "TI"],
 " of one and ",
 StyleBox["w", "TI"],
 " of the other, both different from ",
 StyleBox["c", "TI"],
 ". The relation is symmetric, so the sets of mutually perpendicular rays are \
the cliques of a finite graph, and the largest number of mutually \
perpendicular rays at ",
 StyleBox["c", "TI"],
 " is its clique number."
}], "Notes",ExpressionUUID->"c0d24702-5c16-41ba-a604-05e67797614a"],

Cell[TextData[{
 "A single ray carries no right angle. On the grid ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"d", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", ",", " ", "0"}], ")"}], ",", " ", 
      RowBox[{"(", 
       RowBox[{"0", ",", " ", "2"}], ")"}]}], ")"}]}], " ", "=", " ", 
   RowBox[{"4", " ", "=", " ", 
    RowBox[{"d", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", ",", " ", "0"}], ")"}], ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "2"}], ",", " ", "0"}], ")"}]}], ")"}]}]}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a2c5e9a-9ee9-42fe-8537-cd5e29127802"],
 ": the distances do not tell a quarter turn from a half turn. The test \
therefore passes the ",
 StyleBox["opposite",
  FontWeight->"Bold"],
 " of a ray as well, the reflection of the ray through ",
 StyleBox["c", "TI"],
 ", and a frame of the grid ",
 Cell[BoxData[
  RowBox[{"Z", "^", "d"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5eb50654-c8e1-43f8-9ff5-8b778c6ae75b"],
 " is ",
 Cell[BoxData[
  RowBox[{"2", " ", "d"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c41cd03-2d46-4603-b097-1c1cd1feff63"],
 " rays, the ",
 Cell[BoxData["d"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa61a8a7-1e45-48a4-a2f4-159439cd646d"],
 " directions each with its negative. A direction is read after identifying \
each ray with its negative."
}], "Notes",ExpressionUUID->"50a39085-f70c-48da-abea-bbbabefb313c"],

Cell[TextData[{
 "Where the negative of a ray does not exist or is not unique, the two maxima \
differ: the number of mutually perpendicular lines through ",
 StyleBox["c", "TI"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c4488a17-be2b-4516-a7ea-6100efdc7bd6"],
 ", and the number of mutually perpendicular rays at ",
 StyleBox["c", "TI"],
 ". At a path endpoint there is a ray and no line. In Euclidean space both \
are the dimension, the rays counted up to their negatives."
}], "Notes",ExpressionUUID->"822b83ed-5e7f-4907-9218-a90ce65bf29f"],

Cell[TextData[{
 "An axis splits at ",
 StyleBox["c", "TI"],
 " into two rays, and a ray extends through ",
 StyleBox["c", "TI"],
 " to a line with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2ccf6ad0-380d-4c14-a44d-f9f712f4a3d8"],
 "."
}], "Notes",ExpressionUUID->"8a4ee6ab-710b-4a62-ab2b-c0137642d654"],

Cell[TextData[{
 StyleBox["len", "TI"],
 " is ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e290276f-4aa6-4c63-9f33-30cf285a8bbe"],
 ", an integer ",
 StyleBox["k", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b23da574-2c03-4c0f-bf3d-075ccc07313e"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"min", ",", " ", "max"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad8c699d-5976-45ac-90b2-c063dd22208c"],
 " (",
 StyleBox["max", "TI"],
 " may be ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2985ce53-e750-4128-94c5-27b62411467a"],
 "); each ray is maximal inside the range, so ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "371535b0-6768-433b-af2c-14ed2f34724a"],
 " never returns a sub-ray of a ray. The count-less call gives the first set, \
",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52a77422-03b7-4609-99a8-97969451868c"],
 " the first ",
 StyleBox["n", "TI"],
 " sets, ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "107bd100-22f5-4682-82cc-a9b99909f2d1"],
 " every maximal set. The rank is a longer ray first, then fewer vertices in \
the geodesic interval of its ends, so the straight frame comes first."
}], "Notes",ExpressionUUID->"d1a1da81-71ef-4a0e-b55c-247973310926"],

Cell[TextData[{
 StyleBox["c", "TI"],
 " is a vertex or an association ",
 Cell[BoxData[
  RowBox[{"<|", " ", 
   RowBox[{
    RowBox[{"v1", " ", "->", " ", "w1"}], ",", " ", "..."}], " ", "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef871cbd-4b9d-4cb4-8e1b-439378501b12"],
 " of vertices, as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fede2f77-98d2-4616-9554-ca4ab1a7f7ac"],
 "."
}], "Notes",ExpressionUUID->"c843327c-60da-4ac5-b58a-d76d1b066376"],

