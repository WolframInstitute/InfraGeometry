     FontSize->0.9 Inherited,ExpressionUUID->
     "a9e78385-9b01-47f8-a70a-35a2a8a2b10d"]], "TableText",ExpressionUUID->
     "12857cc7-0353-4f02-a4ec-10572b2f0145"], Cell[
    "the number of rays in a set", "TableText",ExpressionUUID->
     "f96d5268-8fc7-491b-b93e-3fc42e26b904"]}
  }]], "3ColumnTableMod",ExpressionUUID->"6e3a4135-e848-418c-9dd7-\
d76925271776"],

Cell[TextData[{
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "015f0228-09b9-40e9-97f1-a30d9fdb5783"],
 ", ",
