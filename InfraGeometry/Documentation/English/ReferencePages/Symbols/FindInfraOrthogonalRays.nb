Notebook[{

Cell[CellGroupData[{
Cell["FindInfraOrthogonalRays", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"43aab5d9-bb9d-446e-8e33-1b220c132c64"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOrthogonalRays"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalRays", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["len", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9df593c4-7c8e-4490-8bf0-fcc3874bb514"],
 "\[LineSeparator]",
 "gives one maximal set of mutually perpendicular shortest path rays from the \
vertex ",
 StyleBox["c", "TI"],
 ", each a vertex list starting at ",
 StyleBox["c", "TI"],
 ", the straightest set first.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b93ab966-67f5-459b-940c-deb31131f1e9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOrthogonalRays"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalRays", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["len", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54258c40-91ca-4ce7-a2ac-dfc20d5493b8"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d06e9bcd-3084-4de5-84fc-ce18aa7f1ff8"],
 " of exactly ",
 StyleBox["n", "TI"],
 " such sets or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "691a2c5a-f9cf-4dc5-a488-71388a107b0a"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4079761e-e9fe-49ec-843a-7b846bb74f0f"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2ef5f47-dc28-474f-8d7e-ebb4e79f193f"],
 " gives every one."
}], "Usage",ExpressionUUID->"02279d1f-c3c0-4604-847b-cf08f29c5ad3"],

Cell[TextData[{
 "The problem is well posed. Fix a graph ",
 StyleBox["g", "TI"],
 ", a vertex ",
 StyleBox["c", "TI"],
 " and a length ",
 StyleBox["len", "TI"],
 "."
}], "Notes",ExpressionUUID->"6b9e976f-6c4a-4bd9-8210-fbf9151b1567"],

Cell[TextData[{
 "A ",
 StyleBox["ray",
  FontWeight->"Bold"],
 " at ",
 StyleBox["c", "TI"],
 " is a shortest path from ",
 StyleBox["c", "TI"],
 ", a vertex list starting at ",
 StyleBox["c", "TI"],
 " with a length in ",
 StyleBox["len", "TI"],
 ", maximal there: its last vertex has no neighbour that prolongs it to a \
longer shortest path from ",
 StyleBox["c", "TI"],
 " inside ",
 StyleBox["len", "TI"],
 ". The rays form a finite set in the ball of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 ", ",
 StyleBox["r", "TI"],
 " the largest length."
}], "Notes",ExpressionUUID->"13dda566-52ba-4aa3-ae8b-7426b3310dd0"],

Cell[TextData[{
 "Two rays are ",
 StyleBox["perpendicular",
  FontWeight->"Bold"],
 " by the test of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "04ac0bd6-64af-44ef-93b6-ebdf7d6bbd1f"],
 ": the shortest-path projection of every vertex of each onto the other is ",
 StyleBox["c", "TI"],
 ", that is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"d", 
    RowBox[{"(", 
     RowBox[{"v", ",", " ", "w"}], ")"}]}], " ", ">", " ", 
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{"d", 
      RowBox[{"(", 
       RowBox[{"c", ",", " ", "v"}], ")"}]}], ",", " ", 
     RowBox[{"d", 
      RowBox[{"(", 
       RowBox[{"c", ",", " ", "w"}], ")"}]}]}], "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fcd5e69-c12b-4272-a32c-67e0f66abb61"],
 " for every vertex ",
 StyleBox["v", "TI"],
 " of one and ",
 StyleBox["w", "TI"],
 " of the other, both different from ",
 StyleBox["c", "TI"],
 ". The relation is symmetric, so the sets of mutually perpendicular rays are \
the cliques of a finite graph, and the largest number of mutually \
perpendicular rays at ",
 StyleBox["c", "TI"],
 " is its clique number."
}], "Notes",ExpressionUUID->"1b2ec5f7-73a7-4ce7-a671-d4685390efa2"],

Cell[TextData[{
 "A single ray carries no right angle. On the grid ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"d", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", ",", " ", "0"}], ")"}], ",", " ", 
      RowBox[{"(", 
       RowBox[{"0", ",", " ", "2"}], ")"}]}], ")"}]}], " ", "=", " ", 
   RowBox[{"4", " ", "=", " ", 
    RowBox[{"d", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", ",", " ", "0"}], ")"}], ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "2"}], ",", " ", "0"}], ")"}]}], ")"}]}]}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93e955d3-b78f-434b-b6b0-fadd8a9c44d8"],
 ": the distances do not tell a quarter turn from a half turn. The test \
therefore passes the ",
 StyleBox["opposite",
  FontWeight->"Bold"],
 " of a ray as well, the reflection of the ray through ",
 StyleBox["c", "TI"],
 ", and a frame of the grid ",
 Cell[BoxData[
  RowBox[{"Z", "^", "d"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26ea890f-3bbc-44bd-b3b9-2d750d881cef"],
 " is ",
 Cell[BoxData[
  RowBox[{"2", " ", "d"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3752d48-9084-4418-bbd1-bcf99ef0d6dc"],
 " rays, the ",
 Cell[BoxData["d"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "263d331e-6352-4f5c-b2d8-c260b4f57c2e"],
 " directions each with its negative. A direction is read after identifying \
each ray with its negative."
}], "Notes",ExpressionUUID->"da17034c-22a3-4b32-82f9-73a2f36c58f0"],

Cell[TextData[{
 "Where the negative of a ray does not exist or is not unique, the two maxima \
differ: the number of mutually perpendicular lines through ",
 StyleBox["c", "TI"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5c430fa7-a079-4791-948c-d817276eb6fd"],
 ", and the number of mutually perpendicular rays at ",
 StyleBox["c", "TI"],
 ". At a path endpoint there is a ray and no line. In Euclidean space both \
are the dimension, the rays counted up to their negatives."
}], "Notes",ExpressionUUID->"26557e21-7c0e-4a18-94b1-972352253e01"],

Cell[TextData[{
 "An axis splits at ",
 StyleBox["c", "TI"],
 " into two rays, and a ray extends through ",
 StyleBox["c", "TI"],
 " to a line with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a4161dfc-838b-4dd4-a913-3c2e228f1db2"],
 "."
}], "Notes",ExpressionUUID->"9064d83d-130b-4816-b107-60e5b45cb226"],

Cell[TextData[{
 StyleBox["len", "TI"],
 " is ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ddb8975-5be3-43d9-8ca5-3438a6e1468e"],
 ", an integer ",
 StyleBox["k", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73876986-7e5d-47e6-aef6-f053f073f581"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"min", ",", " ", "max"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0febff04-7ab3-48cb-98ee-982a927d731c"],
 " (",
 StyleBox["max", "TI"],
 " may be ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66201f58-2f40-4836-a5c3-7ed35668cc94"],
 "); each ray is maximal inside the range, so ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "342517f9-23b2-48c5-a952-8aca177b8977"],
 " never returns a sub-ray of a ray. The count-less call gives the first set, \
",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79d84d58-e6bb-43a8-862a-29ea63fd12e4"],
 " the first ",
 StyleBox["n", "TI"],
 " sets, ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98fb8f38-f21c-4764-b7e6-8af9cf7207f8"],
 " every maximal set. The rank is a longer ray first, then fewer vertices in \
the shortest path interval of its ends, so the straight frame comes first."
}], "Notes",ExpressionUUID->"446b1d3b-d059-4261-841a-ed0889469f3a"],

Cell[TextData[{
 StyleBox["c", "TI"],
 " is a vertex or an association ",
 Cell[BoxData[
  RowBox[{"<|", " ", 
   RowBox[{
    RowBox[{"v1", " ", "->", " ", "w1"}], ",", " ", "..."}], " ", "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f4ea9ee-995d-4d64-82c1-b488eb6d9432"],
 " of vertices, as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "308b7cb4-60ba-4e6a-8961-8e1d64b016c7"],
 "."
}], "Notes",ExpressionUUID->"5ec074e6-88db-46dd-944b-e9a44ede3c51"],

