Cell["\<\
The straight frame at the centre of the square tiling: four rays of 4 steps, \
each axis read twice.\
\>", "ExampleText",ExpressionUUID->"60bbb94d-1b0d-4c3b-82e6-cb97c1d2f5f6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rays", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalRays", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "4"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Append", "[", 
        RowBox[{"rays", ",", " ", 
         RowBox[{"{", "c", "}"}]}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "rays"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e8595230-4955-4959-87fd-6488180e9f74"],

