    "the order the candidates are tried in", "TableText",ExpressionUUID->
     "9e3e855c-7db9-4789-a059-81f61ea1a921"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "05f1018a-bec7-49b8-a083-f82111c4cc90"], Cell[TextData[Cell[
    BoxData["\"\<RayCount\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2424bf77-212d-4f51-8af4-ab76f773923a"]], "TableText",ExpressionUUID->
     "0da85937-66c1-4d89-99ad-69c5ed720011"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "60a758a2-57e7-4091-a64c-b0e8cb756f31"]], "TableText",ExpressionUUID->
     "7d233120-e121-4ef4-96f1-f35814dd3c4c"], Cell[
    "the number of rays in a set", "TableText",ExpressionUUID->
     "151bdbd7-ae11-427e-8edb-f291d745d94c"]}
  }]], "3ColumnTableMod",ExpressionUUID->"e1127195-8d4b-4d69-9908-\
787a10e639bc"],

Cell[TextData[{
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c550b31-9f11-4ee5-9743-860308be2cca"],
 ", ",
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54cb27b5-96db-4ab8-ab73-9c6f1287d68b"],
 " and the count act as on ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4c4f2fb9-f156-4c0e-bf2e-446f985c9bb0"],
 ". ",
 Cell[BoxData[
  RowBox[{"\"\<RayCount\>\"", " ", "->", " ", "k"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b6058d7-f0ea-4608-9cc7-dd1dd554cfad"],
 " keeps the sets of exactly ",
 StyleBox["k", "TI"],
 " rays, ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d16afc90-d796-41d8-88a1-d2d7170950b5"],
 " the sets of ",
 StyleBox["k", "TI"],
 " rays or fewer if maximal, ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b7a22db-b0b3-4a78-8427-1558ee4e0292"],
 " every clique of any size, ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a20cfb0a-8673-4c5d-be19-5f7993b02ee3"],
 " the maximal ones."
}], "Notes",ExpressionUUID->"661b67f0-e7df-4fbe-9b67-4778eda68756"]
}, Open  ]],

