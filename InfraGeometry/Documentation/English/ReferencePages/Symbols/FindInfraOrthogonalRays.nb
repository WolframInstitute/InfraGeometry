Cell[TextData[{
 "The frame feeds ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrthogonalCoordinates"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrthogonalCoordinates", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e1c17ec9-3fb2-470f-bb22-e25819754073"],
 " as it stands: each axis is read twice, once as its positive and once as \
its negative part, and a vertex of the grid has the signed position on each."
}], "ExampleText",ExpressionUUID->"3fad40bc-18f6-448a-836d-200f80ad696b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
