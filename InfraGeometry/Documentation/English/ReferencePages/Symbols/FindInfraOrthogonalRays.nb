     "]"}]}], ",", " ", 
   RowBox[{"Length", " ", "@", " ", 
    RowBox[{"FindInfraOrthogonalAxes", "[", 
     RowBox[{
      RowBox[{"StarGraph", "[", "6", "]"}], ",", " ", "1", ",", " ", "All"}], 
     "]"}]}]}], "}"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0979d375-da7d-4419-b3b7-c148770428cf"],

