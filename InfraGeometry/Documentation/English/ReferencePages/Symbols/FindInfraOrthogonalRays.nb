    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "844061da-1edf-4a48-86be-80df7ea5b127"],
 " one coordinate per ray. The vertex 67, two steps along each axis from the \
centre, reads 2 on two rays and 0 on their opposites:"
}], "ExampleText",ExpressionUUID->"9bda8338-2cf5-490b-bf1f-9b02e9d0125a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"OrthogonalCoordinates", "[", 
    RowBox[{"g", ",", " ", "45", ",", " ", 
     RowBox[{"FindInfraOrthogonalRays", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", "2"}], "]"}], ",", " ", "67"}], 
