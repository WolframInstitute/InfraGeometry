 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ab297f5-d0a1-4b1e-a583-244ad25d4f03"],
 " the sets of ",
 StyleBox["k", "TI"],
 " rays or fewer if maximal, ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca67d6d5-5053-4a52-b17f-a1773e9ce3ff"],
 " every clique of any size, ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "588a07e6-c411-41c6-a557-e2f2cfaee020"],
 " the maximal ones."
}], "Notes",ExpressionUUID->"370c2570-bdc1-4291-8531-e80fca0da8b4"]
}, Open  ]],

