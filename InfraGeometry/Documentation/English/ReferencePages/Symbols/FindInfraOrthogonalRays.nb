     "216a5dd6-95ac-4cd9-8ed0-fc25750dfe66"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a241c97d-c038-4aee-b525-28e0847594db"], Cell[TextData[Cell[
    BoxData["\"\<RayCount\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b1469748-6d4f-4746-b3f9-e39250f7f3cc"]], "TableText",ExpressionUUID->
