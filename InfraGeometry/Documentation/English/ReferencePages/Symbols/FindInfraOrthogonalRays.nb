  "54872b40-ae6f-488d-aca2-b67e2bcb87e2"],
 " keeps the sets of exactly ",
 StyleBox["k", "TI"],
 " rays, ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "019e9dbe-441f-4af4-9851-6b6c649c6af2"],
 " the sets of ",
 StyleBox["k", "TI"],
 " rays or fewer if maximal, ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6869b32a-9d47-4cf6-afe5-a893395f951c"],
 " every clique of any size, ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6be994b-bce9-4532-a8e4-20b82bbcf97f"],
 " the maximal ones."
}], "Notes",ExpressionUUID->"0d60984b-7481-4ca1-9def-4c761c0bf360"]
