Cell["\<\
The frame of rays is not a basis: the opposite rays are two of its members. \
Count the directions after identifying each ray with its negative, or take \
the axes.\
\>", "ExampleText",ExpressionUUID->"ada7b513-fa11-462d-8ff4-8b82365e099e"],

Cell[TextData[{
 "The same cost as the axes: the candidates grow like the geodesics from ",
 StyleBox["c", "TI"],
 ", so a long length on a large grid is slow."
}], "ExampleText",ExpressionUUID->"a03101da-47ee-4684-8296-131814d81b54"]
}, Open  ]],

