Cell[CellGroupData[{
Cell["FindInfraOrthogonalRays", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6b7dd3e4-3d5b-4e98-8750-2c5897f95b6d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOrthogonalRays"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalRays", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["len", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64e7bb6b-6950-489e-aa19-41a78c985311"],
 "\[LineSeparator]",
 "gives a maximal set of mutually perpendicular rays from the vertex ",
 StyleBox["c", "TI"],
 ", each a vertex list starting at ",
 StyleBox["c", "TI"],
 ", the straightest set first.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2f3a8383-1aa1-4e6a-b7ef-9e42897653f0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOrthogonalRays"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalRays", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["len", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6fa5e31-c177-4961-85e2-3d0fef5b63e9"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " such sets."
}], "Usage",ExpressionUUID->"bf5c03a6-3e6f-48f8-a4cc-29315d58ec77"],

Cell[TextData[{
 "A ray at ",
 StyleBox["c", "TI"],
 " is a shortest path from ",
 StyleBox["c", "TI"],
 " with a length in ",
 StyleBox["len", "TI"],
 ", maximal: its last vertex has no neighbour that prolongs it to a longer \
shortest path from ",
 StyleBox["c", "TI"],
 " within ",
 StyleBox["len", "TI"],
 "."
}], "Notes",ExpressionUUID->"eed7544d-078b-417e-b0c5-b886f7ef3d1e"],

Cell[TextData[{
 "Two rays are perpendicular by the test of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b32ef372-8367-4c03-b753-ce6b7b652af4"],
 ": ",
 StyleBox["d(v, w) > max(d(c, v), d(c, w))", "TI"],
 " for all ",
 StyleBox["v", "TI"],
 " on one and ",
 StyleBox["w", "TI"],
 " on the other, both different from ",
 StyleBox["c", "TI"],
 "."
}], "Notes",ExpressionUUID->"3bfede0c-8846-4a09-932d-05028975922e"],

Cell[TextData[{
 "The test cannot tell a right angle from a straight one, so a ray and its \
opposite pass it. The frame of the ",
 StyleBox["d", "TI"],
 "-dimensional grid is ",
 StyleBox["2d", "TI"],
 " rays, each direction with its negative."
}], "Notes",ExpressionUUID->"0f1301d9-e2ef-481c-9957-6d54960ff24b"],

Cell[TextData[{
 "At a path endpoint there is a ray and no axis. Two edges at ",
 StyleBox["c", "TI"],
 " are perpendicular rays of length 1 exactly when their ends are not \
adjacent; at the centre of a star all edges are."
}], "Notes",ExpressionUUID->"6c99f300-9bd2-43a0-aeee-e0637a526a30"],

Cell[TextData[{
 StyleBox["len", "TI"],
 " is ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd7b45b0-c818-497f-b385-ed8264657c7e"],
 ", ",
 StyleBox["k", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d24fa58a-99fe-461e-a46d-c54e2bf6e750"],
 " or {",
 StyleBox["min", "TI"],
 ", ",
 StyleBox["max", "TI"],
 "}. The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b99c5fa-4ee5-4aac-9b9d-d9f3f77c0d97"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92f9ab2c-9dc7-4337-845f-05662d0dbfa1"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d2a394e-30fe-4229-8e26-a9cea55f1890"],
 ". ",
 StyleBox["c", "TI"],
 " can be an association of vertices, as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d61e54e0-2831-420c-a358-29bedea98bd9"],
 "."
}], "Notes",ExpressionUUID->"ff7a3805-80e5-4a8d-b06d-409354d5417f"],

