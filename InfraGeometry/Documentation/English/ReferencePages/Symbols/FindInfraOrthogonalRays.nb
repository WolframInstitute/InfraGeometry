Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"axes", " ", "=", " ", 
      RowBox[{"FindInfraOrthogonalAxes", "[", 
       RowBox[{"g", ",", " ", "45", ",", " ", "3"}], "]"}]}], ",", " ", 
     RowBox[{"rays", " ", "=", " ", 
      RowBox[{"FindInfraOrthogonalRays", "[", 
       RowBox[{"g", ",", " ", "45", ",", " ", "3"}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"InfraWalk", " ", "/@", " ", "axes"}], ",", " ", "45"}], 
         "]"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"Length", "[", "axes", "]"}]}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"InfraWalk", " ", "/@", " ", "rays"}], ",", " ", "45"}], 
         "]"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"Length", "[", "rays", "]"}]}]}], "]"}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fb0ee507-0639-4dae-ada9-a3cff91024d9"],

