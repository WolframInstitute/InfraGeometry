Notebook[{

Cell[CellGroupData[{
Cell["FindInfraOrthogonalRays", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8158b9ee-1ae2-456b-a093-251534a58fa7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOrthogonalRays"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalRays", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["len", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "753b9916-756e-4c32-aa41-eccb6354ef84"],
 "\[LineSeparator]",
 "gives one maximal set of mutually perpendicular geodesic rays from the \
vertex ",
 StyleBox["c", "TI"],
 ", each a vertex list starting at ",
 StyleBox["c", "TI"],
 ", the straightest set first.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a08351d4-48e8-4901-a32a-9bd3ba40b542"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOrthogonalRays"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalRays", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["len", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ece500c-7308-4010-a73a-57c4a9c1a65f"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d488908-dca2-49c3-a5f7-00127b036aee"],
 " of exactly ",
 StyleBox["n", "TI"],
 " such sets or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2823b9e-66f8-44cb-a282-fe22aab8b9d9"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d034e1b-f5ce-4993-a824-802c2f6fd29b"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09b612e9-9eaa-4d3c-94a7-f8ed07e29e71"],
 " gives every one."
}], "Usage",ExpressionUUID->"845dff62-b0a8-43c0-984f-e4d40e2dff94"],

Cell[TextData[{
 "The problem is well posed. Fix a graph ",
 StyleBox["g", "TI"],
 ", a vertex ",
 StyleBox["c", "TI"],
 " and a length ",
 StyleBox["len", "TI"],
 "."
}], "Notes",ExpressionUUID->"cf3563f6-78d7-4086-8c3b-e52ce73fd300"],

Cell[TextData[{
 "A ",
 StyleBox["ray",
  FontWeight->"Bold"],
 " at ",
 StyleBox["c", "TI"],
 " is a geodesic from ",
 StyleBox["c", "TI"],
 ", a vertex list starting at ",
 StyleBox["c", "TI"],
 " with a length in ",
 StyleBox["len", "TI"],
 ", maximal there: its last vertex has no neighbour that prolongs it to a \
longer geodesic from ",
 StyleBox["c", "TI"],
 " inside ",
 StyleBox["len", "TI"],
 ". The rays form a finite set in the ball of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 ", ",
 StyleBox["r", "TI"],
 " the largest length."
}], "Notes",ExpressionUUID->"b609ac27-17ad-4486-b3ec-4770693c8e7d"],

Cell[TextData[{
 "Two rays are ",
 StyleBox["perpendicular",
  FontWeight->"Bold"],
 " by the test of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8c1210fd-fd54-4431-b3f7-7bc21f3945d1"],
 ": the shortest-path projection of every vertex of each onto the other is ",
 StyleBox["c", "TI"],
 ", that is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"d", 
    RowBox[{"(", 
     RowBox[{"v", ",", " ", "w"}], ")"}]}], " ", ">", " ", 
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{"d", 
      RowBox[{"(", 
       RowBox[{"c", ",", " ", "v"}], ")"}]}], ",", " ", 
     RowBox[{"d", 
      RowBox[{"(", 
       RowBox[{"c", ",", " ", "w"}], ")"}]}]}], "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20d706bc-a340-44c7-aec9-57444aee20a2"],
 " for every vertex ",
 StyleBox["v", "TI"],
 " of one and ",
 StyleBox["w", "TI"],
 " of the other, both different from ",
 StyleBox["c", "TI"],
 ". The relation is symmetric, so the sets of mutually perpendicular rays are \
the cliques of a finite graph, and the largest number of mutually \
perpendicular rays at ",
 StyleBox["c", "TI"],
 " is its clique number."
}], "Notes",ExpressionUUID->"26c93f87-549c-4766-89e6-e351838aadf5"],

Cell[TextData[{
 "A single ray carries no right angle. On the grid ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"d", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", ",", " ", "0"}], ")"}], ",", " ", 
      RowBox[{"(", 
       RowBox[{"0", ",", " ", "2"}], ")"}]}], ")"}]}], " ", "=", " ", 
   RowBox[{"4", " ", "=", " ", 
    RowBox[{"d", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", ",", " ", "0"}], ")"}], ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "2"}], ",", " ", "0"}], ")"}]}], ")"}]}]}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c85c145-9c98-4517-983b-7c176fb4759f"],
 ": the distances do not tell a quarter turn from a half turn. The test \
therefore passes the ",
 StyleBox["opposite",
  FontWeight->"Bold"],
 " of a ray as well, the reflection of the ray through ",
 StyleBox["c", "TI"],
 ", and a frame of the grid ",
 Cell[BoxData[
  RowBox[{"Z", "^", "d"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa001ccc-7658-4082-bdae-6ca6666243ba"],
 " is ",
 Cell[BoxData[
  RowBox[{"2", " ", "d"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bfe02f5b-20ff-48df-9b2f-262013b2275d"],
 " rays, the ",
 Cell[BoxData["d"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0abc0ae0-4bf8-4e03-876b-1be6ce065a2e"],
 " directions each with its negative. A direction is read after identifying \
each ray with its negative."
}], "Notes",ExpressionUUID->"a36645d0-c763-4a85-9f75-1e2d28a0e6f0"],

Cell[TextData[{
 "Where the negative of a ray does not exist or is not unique, the two maxima \
differ: the number of mutually perpendicular lines through ",
 StyleBox["c", "TI"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ba555e7e-6405-49f9-9d39-cfe3cd9654db"],
 ", and the number of mutually perpendicular rays at ",
 StyleBox["c", "TI"],
 ". At a path endpoint there is a ray and no line. In Euclidean space both \
are the dimension, the rays counted up to their negatives."
}], "Notes",ExpressionUUID->"92cb652c-74f3-4571-a9ac-4ea09550bfe3"],

Cell[TextData[{
 "An axis splits at ",
 StyleBox["c", "TI"],
 " into two rays, and a ray extends through ",
 StyleBox["c", "TI"],
 " to a line with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8f9f838d-ad73-4ed2-b2da-1f995fbdc244"],
 "."
}], "Notes",ExpressionUUID->"4c822bec-19ff-4b5f-959d-84e3585be3af"],

Cell[TextData[{
 StyleBox["len", "TI"],
 " is ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a3dfef-203f-4151-a99f-8fca4803fe58"],
 ", an integer ",
 StyleBox["k", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5808fed9-22ce-4638-ad3e-ed83f67b5859"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"min", ",", " ", "max"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f84b90e-4fce-4b5e-8ddd-e03f7590b5b6"],
 " (",
 StyleBox["max", "TI"],
 " may be ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5751ee2c-0b9a-486a-9e55-96b262804766"],
 "); each ray is maximal inside the range, so ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bf1e821-b603-4ecb-b29b-9d568762394d"],
 " never returns a sub-ray of a ray. The count-less call gives the first set, \
",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15064e6b-7675-4a4d-be4f-1d421de805e5"],
 " the first ",
 StyleBox["n", "TI"],
 " sets, ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b22e408e-4a5b-4b57-ab1a-58e7790253ff"],
 " every maximal set. The rank is a longer ray first, then fewer vertices in \
the geodesic interval of its ends, so the straight frame comes first."
}], "Notes",ExpressionUUID->"ad50d414-b127-4059-b590-e46ca8c097e1"],

Cell[TextData[{
 StyleBox["c", "TI"],
 " is a vertex or an association ",
 Cell[BoxData[
  RowBox[{"<|", " ", 
   RowBox[{
    RowBox[{"v1", " ", "->", " ", "w1"}], ",", " ", "..."}], " ", "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3851d89a-1b1d-4d30-97d6-74e19fc7fb1f"],
 " of vertices, as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a0afc1d0-2170-4b15-b163-5f82f4fc3d25"],
 "."
}], "Notes",ExpressionUUID->"53e3e7c0-9582-4767-b482-83c8f6b2b683"],

