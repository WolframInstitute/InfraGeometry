Cell["\<\
The straight frame at the centre of the square tiling: four rays of 4 steps, \
each axis read twice.\
\>", "ExampleText",ExpressionUUID->"a1dbc652-961b-4456-a915-f82b1cfc5133"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rays", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalRays", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "4"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Append", "[", 
        RowBox[{"rays", ",", " ", 
         RowBox[{"{", "c", "}"}]}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "rays"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4d49b2be-a817-4a0a-955f-f4c5cb136753"],

