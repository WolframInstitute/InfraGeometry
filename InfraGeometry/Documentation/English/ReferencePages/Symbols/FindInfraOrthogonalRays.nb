Notebook[{

Cell[CellGroupData[{
Cell["FindInfraOrthogonalRays", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell["LLM generated.", "Notes",ExpressionUUID->"99edf436-a2bb-45dd-a794-608ff32945ff"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2e0561f1-dbf1-4327-9c5b-44d222019336"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOrthogonalRays"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalRays", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["len", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3437169d-fce7-4e79-9081-5ca2bd1ae5ea"],
 "\[LineSeparator]",
 "gives one maximal set of mutually perpendicular shortest path rays from the \
vertex ",
 StyleBox["c", "TI"],
 ", each a vertex list starting at ",
 StyleBox["c", "TI"],
 ", the straightest set first.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c99d9a60-39aa-468d-aecd-680b82bde0d5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOrthogonalRays"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalRays", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["len", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84a7f3b4-50a2-4012-927c-ab91203df273"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af22b924-e73d-45ba-8f9a-5427e8fb1033"],
 " of exactly ",
 StyleBox["n", "TI"],
 " such sets or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68ffe17c-8d8e-4a1d-85f6-56687042a63f"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5079103-e01a-4ea1-9b2c-2694ca3a3bf0"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8844069c-3b28-49e9-8b13-e1bb70c8891b"],
 " gives every one."
}], "Usage",ExpressionUUID->"d2207fd5-2af9-467a-b08c-6f1573e66ab5"],

Cell[TextData[{
 "The problem is well posed. Fix a graph ",
 StyleBox["g", "TI"],
 ", a vertex ",
 StyleBox["c", "TI"],
 " and a length ",
 StyleBox["len", "TI"],
 "."
}], "Notes",ExpressionUUID->"4af94f57-e784-42b0-b904-66c19a0b7109"],

Cell[TextData[{
 "A ",
 StyleBox["ray",
  FontWeight->"Bold"],
 " at ",
 StyleBox["c", "TI"],
 " is a shortest path from ",
 StyleBox["c", "TI"],
 ", a vertex list starting at ",
 StyleBox["c", "TI"],
 " with a length in ",
 StyleBox["len", "TI"],
 ", maximal there: its last vertex has no neighbour that prolongs it to a \
longer shortest path from ",
 StyleBox["c", "TI"],
 " inside ",
 StyleBox["len", "TI"],
 ". The rays form a finite set in the ball of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 ", ",
 StyleBox["r", "TI"],
 " the largest length."
}], "Notes",ExpressionUUID->"bb9fb131-2a32-4d58-a9d2-2790d7099df0"],

Cell[TextData[{
 "Two rays are ",
 StyleBox["perpendicular",
  FontWeight->"Bold"],
 " by the test of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0408c1e5-a08e-4a04-9ec5-c86dbb4eff34"],
 ": the shortest-path projection of every vertex of each onto the other is ",
 StyleBox["c", "TI"],
 ", that is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"d", 
    RowBox[{"(", 
     RowBox[{"v", ",", " ", "w"}], ")"}]}], " ", ">", " ", 
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{"d", 
      RowBox[{"(", 
       RowBox[{"c", ",", " ", "v"}], ")"}]}], ",", " ", 
     RowBox[{"d", 
      RowBox[{"(", 
       RowBox[{"c", ",", " ", "w"}], ")"}]}]}], "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f902fcab-3cd4-4b01-ba84-d2268dafc562"],
 " for every vertex ",
 StyleBox["v", "TI"],
 " of one and ",
 StyleBox["w", "TI"],
 " of the other, both different from ",
 StyleBox["c", "TI"],
 ". The relation is symmetric, so the sets of mutually perpendicular rays are \
the cliques of a finite graph, and the largest number of mutually \
perpendicular rays at ",
 StyleBox["c", "TI"],
 " is its clique number."
}], "Notes",ExpressionUUID->"7f4052e3-20e3-43fc-826f-63006cccef18"],

Cell[TextData[{
 "A single ray carries no right angle. On the grid ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"d", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", ",", " ", "0"}], ")"}], ",", " ", 
      RowBox[{"(", 
       RowBox[{"0", ",", " ", "2"}], ")"}]}], ")"}]}], " ", "=", " ", 
   RowBox[{"4", " ", "=", " ", 
    RowBox[{"d", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", ",", " ", "0"}], ")"}], ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "2"}], ",", " ", "0"}], ")"}]}], ")"}]}]}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d880b39-16bd-4a60-9bbe-dea2c704a16e"],
 ": the distances do not tell a quarter turn from a half turn. The test \
therefore passes the ",
 StyleBox["opposite",
  FontWeight->"Bold"],
 " of a ray as well, the reflection of the ray through ",
 StyleBox["c", "TI"],
 ", and a frame of the grid ",
 Cell[BoxData[
  RowBox[{"Z", "^", "d"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f188de58-7b6d-4347-9cfb-7d6d816ef1e6"],
 " is ",
 Cell[BoxData[
  RowBox[{"2", " ", "d"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6adfff84-6772-4092-b1c4-156cf3bb520f"],
 " rays, the ",
 Cell[BoxData["d"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d818a36-b51f-42c3-a659-31398e3be964"],
 " directions each with its negative. A direction is read after identifying \
each ray with its negative."
}], "Notes",ExpressionUUID->"559bd87a-3ac1-4ed3-8071-e16271b1afdf"],

Cell[TextData[{
 "Where the negative of a ray does not exist or is not unique, the two maxima \
differ: the number of mutually perpendicular lines through ",
 StyleBox["c", "TI"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2b6b3b15-9a0d-49cd-bb86-6591e64ee290"],
 ", and the number of mutually perpendicular rays at ",
 StyleBox["c", "TI"],
 ". At a path endpoint there is a ray and no line. In Euclidean space both \
are the dimension, the rays counted up to their negatives."
}], "Notes",ExpressionUUID->"49bb043c-93e9-4402-a006-3c2fae2894df"],

Cell[TextData[{
 "An axis splits at ",
 StyleBox["c", "TI"],
 " into two rays, and a ray extends through ",
 StyleBox["c", "TI"],
 " to a line with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraInfiniteLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraInfiniteLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "22cdcc85-74d7-4edd-b067-05bbb78a9a16"],
 "."
}], "Notes",ExpressionUUID->"e4a1d93e-26ac-4a41-bbe3-fe1a2434a0c1"],

Cell[TextData[{
 StyleBox["len", "TI"],
 " is ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f52b9ac5-463a-4ad1-a863-f9ec847a1644"],
 ", an integer ",
 StyleBox["k", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ff33aaa-fc6f-4a7a-8e34-7cbc507d23b9"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"min", ",", " ", "max"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2755caf-74e7-4b57-ba44-bfde014ac091"],
 " (",
 StyleBox["max", "TI"],
 " may be ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c499699-185a-436c-a3f1-881bbd505c34"],
 "); each ray is maximal inside the range, so ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2f03691-9507-400a-a569-5773d3835baf"],
 " never returns a sub-ray of a ray. The count-less call gives the first set, \
",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98715059-f551-4939-9b89-595694a9c8e8"],
 " the first ",
 StyleBox["n", "TI"],
 " sets, ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "303023a6-c0cd-4d4b-b09e-c2c2305f96a5"],
 " every maximal set. The rank is a longer ray first, then fewer vertices in \
the shortest path interval of its ends, so the straight frame comes first."
}], "Notes",ExpressionUUID->"328099ef-29bf-43c1-9c02-282fecadbc64"],

Cell[TextData[{
 StyleBox["c", "TI"],
 " is a vertex or an association ",
 Cell[BoxData[
  RowBox[{"<|", " ", 
   RowBox[{
    RowBox[{"v1", " ", "->", " ", "w1"}], ",", " ", "..."}], " ", "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21885094-d716-4520-a0f3-caa5aa0b7db1"],
 " of vertices, as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "59863fef-f3ab-4e31-9866-cb280d42f6eb"],
 "."
}], "Notes",ExpressionUUID->"80bd1f76-afed-4923-9c64-a64f380593ca"],

