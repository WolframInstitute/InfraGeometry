    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "cd874b80-4faf-473f-a58b-66d275d74240"]], "TableText",ExpressionUUID->
     "fd9e220f-6bf4-4fad-b8ea-55314ebb3b4f"], Cell[
