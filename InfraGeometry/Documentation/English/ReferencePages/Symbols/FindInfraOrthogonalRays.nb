Cell[TextData[{
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6161bf9f-9a87-41a2-b4e0-3afe9dbbde13"],
 " draws the candidates at random, so the count-less call is a random maximal \
set of rays."
}], "ExampleText",ExpressionUUID->"4825e5ce-23ce-424c-867b-0dab97ed157c"],

