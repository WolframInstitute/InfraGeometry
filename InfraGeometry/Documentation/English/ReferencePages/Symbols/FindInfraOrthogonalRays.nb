     "]"}]}], ",", " ", 
   RowBox[{"Length", " ", "@", " ", 
    RowBox[{"FindInfraOrthogonalAxes", "[", 
     RowBox[{
      RowBox[{"StarGraph", "[", "6", "]"}], ",", " ", "1", ",", " ", "All"}], 
