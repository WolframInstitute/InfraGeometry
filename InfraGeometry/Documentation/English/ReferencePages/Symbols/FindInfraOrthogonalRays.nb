 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61a668ed-b323-4233-a2ae-2f95394c0987"],
 " draws the candidates at random, so the count-less call is a random maximal \
set of rays."
}], "ExampleText",ExpressionUUID->"036a1060-9d81-43ee-a7b9-44e00803b673"],

