Cell["\<\
Sets of exactly two rays of length 2 at the centre of the grid, the first \
three:\
\>", "ExampleText",ExpressionUUID->"b63137b0-2cd8-4640-821f-b61a05efe370"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sets", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalRays", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", "2", ",", " ", "3", ",", " ", 
       RowBox[{"\"\<RayCount\>\"", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"InfraWalk", " ", "/@", " ", "set"}], ",", " ", "45"}], 
         "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"set", ",", " ", "sets"}], "}"}]}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"3b8055f7-a9b6-4738-a152-624d1e3ba7c3"],

