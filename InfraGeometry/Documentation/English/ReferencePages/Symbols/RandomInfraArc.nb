Cell[TextData[{
 "With ",
 StyleBox["r = d(c, p)", "TI"],
 ", an arc from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is a shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " in the subgraph induced on the band ",
 StyleBox["W = {v : r \[LessEqual] d(c, v) \[LessEqual] r + \[Delta]}", 
  "TI"],
 ". The closed arc ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     StyleBox["p", "TI"], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7386d08d-9ce8-4d3c-8e1f-fd8d14cf852f"],
 " is the family of the circles of the band through ",
 StyleBox["p", "TI"],
 ", as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "67536f53-63ae-4169-aa3a-12bb72e7f9cc"],
 "."
}], "Notes",ExpressionUUID->"dfa24999-8c08-4ffc-a575-9593bb3affc8"],

Cell[TextData[{
 "On the square grid no two vertices of one shell are adjacent, so \[Delta] = \
0 gives no arc. With \[Delta] = 1 the arc between opposite points of the \
circle of radius ",
 StyleBox["r", "TI"],
 " has length ",
 StyleBox["4r", "TI"],
 ", half the circle."
}], "Notes",ExpressionUUID->"c104e260-806a-4c10-b111-e82589e36c30"],

Cell[TextData[{
 "There is no arc when ",
 StyleBox["q", "TI"],
 " is not in the band or the band does not connect ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ". Then the result is ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3995ba94-a04d-4e9b-acd9-48f963415540"],
 "."
}], "Notes",ExpressionUUID->"a92ba8e0-b97d-4af2-8812-046d9e0bdadd"],

Cell["The draw is uniform over the arcs.", "Notes",ExpressionUUID->"920c7110-f97f-4d07-bef6-d32cd5e3e861"],

Cell["Options:", "Notes",ExpressionUUID->"1dd8f474-a293-4d0f-9a40-0bd9a9e67d02"],

