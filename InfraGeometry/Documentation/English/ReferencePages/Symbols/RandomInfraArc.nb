  FontSize->0.9 Inherited,ExpressionUUID->
  "81f853fc-98a7-48ac-8004-8c0fcf8539b6"],
 " does not advance random state. Seed an ordinary draw with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08d40601-656d-41bd-aeb4-54a04e0fa56b"],
 "."
}], "Notes",ExpressionUUID->"f603211a-ef99-434e-92a8-0d5a0ed4485b"],

