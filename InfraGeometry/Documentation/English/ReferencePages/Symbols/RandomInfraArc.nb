Cell[TextData[{
 "A wider band allows more arcs of the same length. The number of arcs and \
their length on the mesh, for ",
 StyleBox["\[Delta]", "TI"],
 " = 0 and 1:"
}], "ExampleText",ExpressionUUID->"f8a1286b-47b2-4848-85a5-d33f2b065b3f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"pq", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "2", ",", " ", 
       RowBox[{"\"\<PairwiseDistance\>\"", " ", "->", " ", "6"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"\[Delta]", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", " ", "@", " ", 
         RowBox[{"RandomInfraArc", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraArc", "[", 
            RowBox[{"c", ",", " ", "pq", ",", " ", 
             RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "\[Delta]"}]}], 
            "]"}], ",", " ", "All"}], "]"}]}], ",", "\n", "    ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraArc", "[", 
           RowBox[{"c", ",", " ", "pq", ",", " ", 
            RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "\[Delta]"}]}], 
           "]"}], ",", " ", "\"\<Length\>\""}], "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Delta]", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
