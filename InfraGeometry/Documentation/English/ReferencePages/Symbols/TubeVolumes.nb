Cell["\<\
Tube volume against radius about the interval from the centre to a vertex six \
steps away, on the discretized plane, the square tiling and the hexagonal \
tiling.\
\>", "ExampleText",ExpressionUUID->"51deb224-3da7-4dfe-8e70-171c509995ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"names", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
        ",", " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"ListLinePlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"gr", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"nm", ",", " ", "\"\<Large\>\""}], "]"}]}], "}"}], ",", 
         "\n", "        ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ctr", " ", "=", " ", 
             RowBox[{"InfraCenter", "[", "gr", "]"}]}], "}"}], ",", "\n", 
           "          ", 
           RowBox[{"TubeVolumes", "[", 
            RowBox[{"gr", ",", " ", "ctr", ",", " ", 
             RowBox[{"First", " ", "@", " ", 
              RowBox[{"FindInfraShell", "[", 
               RowBox[{"gr", ",", " ", "ctr", ",", " ", "6"}], "]"}]}], ",", 
             " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "8"}], "}"}]}], "]"}]}], "]"}]}], "]"}], 
       ",", "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"nm", ",", " ", "names"}], "}"}]}], "]"}], ",", "\n", "    ", 
     
     RowBox[{"DataRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "8"}], "}"}]}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", "names"}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<s\>\"", ",", " ", "\"\<T(s)\>\""}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"980a31e3-7ab4-46f8-aea6-8653577b107a"],

