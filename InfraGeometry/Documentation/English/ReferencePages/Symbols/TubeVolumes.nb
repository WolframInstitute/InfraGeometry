Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Large\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ctr", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"TubeVolumes", "[", 
     RowBox[{"g", ",", " ", "ctr", ",", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"Sort", " ", "@", " ", 
        RowBox[{"FindInfraShell", "[", 
         RowBox[{"g", ",", " ", "ctr", ",", " ", "6"}], "]"}]}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "5"}], "}"}]}], "]"}], " ", "===", "\n", "    ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"3", " ", "*", " ", "5"}], " ", "+", " ", 
       RowBox[{"2", " ", "s", " ", 
        RowBox[{"(", 
         RowBox[{"2", " ", "+", " ", "4", " ", "+", " ", "2"}], ")"}]}], " ", 
       "+", " ", 
       RowBox[{"2", " ", "s", " ", 
        RowBox[{"(", 
         RowBox[{"s", " ", "-", " ", "1"}], ")"}]}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"s", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
