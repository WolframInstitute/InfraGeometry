Cell["\<\
Tube volume against radius about the interval from the centre to a vertex six \
steps away, on the discretized plane, the square tiling and the hexagonal \
tiling.\
\>", "ExampleText",ExpressionUUID->"ce1794ac-af04-4858-823a-924b8fc6d683"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"names", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
        ",", " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"ListLinePlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"gr", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"nm", ",", " ", "\"\<Large\>\""}], "]"}]}], "}"}], ",", 
         "\n", "        ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ctr", " ", "=", " ", 
             RowBox[{"InfraCenter", "[", "gr", "]"}]}], "}"}], ",", "\n", 
           "          ", 
           RowBox[{"TubeVolumes", "[", 
            RowBox[{"gr", ",", " ", "ctr", ",", " ", 
             RowBox[{"First", " ", "@", " ", 
              RowBox[{"FindInfraShell", "[", 
               RowBox[{"gr", ",", " ", "ctr", ",", " ", "6"}], "]"}]}], ",", 
             " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "8"}], "}"}]}], "]"}]}], "]"}]}], "]"}], 
       ",", "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"nm", ",", " ", "names"}], "}"}]}], "]"}], ",", "\n", "    ", 
     
     RowBox[{"DataRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "8"}], "}"}]}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", "names"}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<s\>\"", ",", " ", "\"\<T(s)\>\""}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2c8fdc5d-6735-485a-bd50-1df2052b8b43"],

