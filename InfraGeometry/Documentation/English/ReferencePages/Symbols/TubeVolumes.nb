Cell[TextData[{
 "On the square tiling the tube about an interval is the exact rectangle \
count, the gray curve: here ",
 StyleBox["a", "TI"],
 " = 2, ",
 StyleBox["b", "TI"],
 " = 4."
}], "ExampleText",ExpressionUUID->"02b280f1-f491-4726-b837-6460655fc9d8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Large\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ctr", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"tube", " ", "=", " ", 
     RowBox[{"TubeVolumes", "[", 
      RowBox[{"g", ",", " ", "ctr", ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"Sort", " ", "@", " ", 
         RowBox[{"FindInfraShell", "[", 
          RowBox[{"g", ",", " ", "ctr", ",", " ", "6"}], "]"}]}]}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ListPlot", "[", 
        RowBox[{"tube", ",", " ", 
         RowBox[{"DataRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "5"}], "}"}]}], ",", " ", 
         RowBox[{"AxesLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<s\>\"", ",", " ", "\"\<T(s)\>\""}], "}"}]}]}], "]"}], 
       ",", "\n", "     ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"3", " ", "*", " ", "5"}], " ", "+", " ", 
          RowBox[{"2", " ", "s", " ", 
           RowBox[{"(", 
            RowBox[{"2", " ", "+", " ", "4", " ", "+", " ", "2"}], ")"}]}], 
          " ", "+", " ", 
          RowBox[{"2", " ", "s", " ", 
           RowBox[{"(", 
            RowBox[{"s", " ", "-", " ", "1"}], ")"}]}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"s", ",", " ", "0", ",", " ", "5"}], "}"}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", "Gray"}]}], "]"}]}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"tube", " ", "===", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"3", " ", "*", " ", "5"}], " ", "+", " ", 
         RowBox[{"2", " ", "s", " ", 
          RowBox[{"(", 
           RowBox[{"2", " ", "+", " ", "4", " ", "+", " ", "2"}], ")"}]}], 
         " ", "+", " ", 
         RowBox[{"2", " ", "s", " ", 
          RowBox[{"(", 
           RowBox[{"s", " ", "-", " ", "1"}], ")"}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"s", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"db85574c-9584-449a-be1b-8e83726b5662"],

