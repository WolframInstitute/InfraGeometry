Cell[TextData[{
 "The pair form is the tube about the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MetricInterval"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/MetricInterval", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c9f04b09-afcc-48c7-babf-a0c8c99876c6"],
 ", drawn with its tube of radius 1."
}], "ExampleText",ExpressionUUID->"c2130028-f5ba-45ad-9684-4aaa181d6982"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "4"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"interval", " ", "=", " ", 
     RowBox[{"MetricInterval", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"FindInfraRepresentative", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraBall", "[", 
             RowBox[{"interval", ",", " ", "1"}], "]"}]}], "]"}], " ", "->", 
          " ", "$InfraBallColor"}], ",", " ", 
         RowBox[{"interval", " ", "->", " ", "$InfraSegmentColor"}]}], 
        "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"TubeVolumes", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "b"}], "]"}], " ", "===", " ", 
      RowBox[{"TubeVolumes", "[", 
       RowBox[{"g", ",", " ", "interval"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a4cbf4e5-b2cd-4e02-a43f-0c3f461148c3"],

