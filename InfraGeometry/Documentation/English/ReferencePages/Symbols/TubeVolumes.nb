Cell[CellGroupData[{
Cell["TubeVolumes", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"48a5aaf8-3512-46cd-950b-f2d46468c3e0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TubeVolumes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TubeVolumes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["core", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5b639a8-0e7c-4bc1-a365-ff14fe22e402"],
 "\[LineSeparator]",
 "gives the tube-volume profile {",
 StyleBox["T", "TI"],
 "(0), ",
 StyleBox["T", "TI"],
 "(1), \[Ellipsis]} of the vertex list ",
 StyleBox["core", "TI"],
 ", where ",
 StyleBox["T", "TI"],
 "(",
 StyleBox["s", "TI"],
 ") is the number of vertices within distance ",
 StyleBox["s", "TI"],
 " of the core.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1cde6a96-5bd4-47a5-8982-e5a7196b50db"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TubeVolumes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TubeVolumes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f89448cc-3150-4f66-b5ac-6d393451dd8b"],
 "\[LineSeparator]",
 "takes the metric interval between ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " as the core.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"54eaa23f-fe6f-448b-acd5-58d1648ec731"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TubeVolumes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TubeVolumes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["q1", "TI"], ",", " ", 
      StyleBox["q2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "955cb595-8e86-4ff7-9c38-f1f30654f8a1"],
 "\[LineSeparator]",
 "gives one profile per target, each about the interval from ",
 StyleBox["p", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72dde3af-f3d8-48d0-8e0e-8fc4db512ff3"],
 " takes every vertex as a target.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"9aebe8ca-e114-4ba2-9110-fd0a8866eb97"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TubeVolumes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TubeVolumes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9532e918-977e-4c52-9269-06117a027590"],
 "\[LineSeparator]",
 "gives the single volume ",
 StyleBox["T", "TI"],
 "(",
 StyleBox["s", "TI"],
 "), and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TubeVolumes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TubeVolumes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["smin", "TI"], ",", " ", 
      StyleBox["smax", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40116621-fd48-40fe-8413-6a9236881c61"],
 " the volumes for the radii ",
 StyleBox["smin", "TI"],
 " to ",
 StyleBox["smax", "TI"],
 "."
}], "Usage",ExpressionUUID->"1b68db41-3ed6-481f-8264-4c6012db4e2b"],

Cell[TextData[{
 "Definition: the tube of radius ",
 StyleBox["s", "TI"],
 " about a vertex set ",
 StyleBox["K", "TI"],
 " is ",
 StyleBox["T_s(K) = {w : d(w, K) \[LessEqual] s}", "TI"],
 ", and its volume is the number of its vertices. ",
 StyleBox["T(0)", "TI"],
 " is the size of the core, and the profile saturates at the component of the \
core."
}], "Notes",ExpressionUUID->"f6414223-88db-4845-b759-c647a31395a6"],

Cell[TextData[{
 "The tube reads the curvature along a direction, which the ball cannot. For \
a geodesic of length ",
 StyleBox["L", "TI"],
 " and direction ",
 StyleBox["v", "TI"],
 " on a Riemannian manifold, Gray's tube formula is ",
 StyleBox["Vol T_s = \[Omega]_(d\[Minus]1) s^(d\[Minus]1) L (1 \[Minus] (R + \
Ric(v, v)) s\.b2 / (6(d + 1)) + O(s\:2074))", "TI"],
 ". The regression of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DimensionCurvatureFit"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5845521d-9dbf-43c0-81e8-1b2d5181cf1d"],
 " with ",
 Cell[BoxData[
  RowBox[{"\"\<Probe\>\"", " ", "->", " ", "\"\<Tube\>\""}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d16221c-d6ed-4c6b-af1c-0476e6d70c3c"],
 " reads ",
 StyleBox["R + Ric(v, v)", "TI"],
 ", and subtracting the scalar curvature read by the ball leaves the Ricci \
curvature in the direction ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"c118f76a-a4a2-4884-9d4a-0b5aa6bb4244"],

Cell[TextData[{
 "The pair form takes as core the metric interval ",
 StyleBox["I(p, q) = {w : d(p, w) + d(w, q) = d(p, q)}", "TI"],
 ", the union of all geodesics from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", which is the vertex set of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SegmentGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SegmentGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1db2c12b-3da5-456c-b356-2180fa659ddc"],
 ". On a lattice the interval is fat: on the square grid it is the rectangle \
spanned by ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ", and a tube about it is exactly ",
 StyleBox["(a + 1)(b + 1) + 2s(a + b + 2) + 2s(s \[Minus] 1)", "TI"],
 " vertices, with ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " the two coordinate differences. The spread of the tube volumes over a \
shell of targets is then the spread of the rectangles, not curvature."
}], "Notes",ExpressionUUID->"94e7fbfb-2e5c-46d3-94ef-47a21be53d41"],

Cell[TextData[{
 "The target form reads every profile off one distance matrix, so the \
distribution of tube volumes over a shell of ",
 StyleBox["p", "TI"],
 " is one call."
}], "Notes",ExpressionUUID->"ad55c9c0-9914-482f-b543-b676189a7cda"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["\"\<Measure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e95efa0-cfe4-4cf2-a815-6d619511b43c"],
 " sets the convention for the outermost layer, as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallVolumes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallVolumes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2c46a0db-330d-4b4b-815d-12ce8829776e"],
 ", with the boundary of the tube in place of that of the ball: ",
 Cell[BoxData["\"\<FullCount\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce84d89f-615c-448e-9bc7-951ea61a2d14"],
 " (default), ",
 Cell[BoxData["\"\<WithoutBoundary\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbd59208-6525-4f11-8eaa-6fcb3abcfbc5"],
 ", ",
 Cell[BoxData["\"\<HalfBoundary\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "163f9cab-2948-4261-b7e9-7f1c7b4be028"],
 ", ",
 Cell[BoxData["\"\<ExpandingFront\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "329276ba-3ded-4242-a59a-3ac2d2825fbc"],
 "."
}], "Notes",ExpressionUUID->"76bf9e0a-37cb-4891-a81d-7841ba480216"]
}, Open  ]],

