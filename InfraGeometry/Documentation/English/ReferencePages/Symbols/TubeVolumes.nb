Cell[CellGroupData[{
Cell["TubeVolumes", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"db52234a-3c6f-44c9-bc0e-bd4eb44d6807"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TubeVolumes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TubeVolumes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["core", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa05a828-2276-439b-80a5-24e1e98b2da2"],
 "\[LineSeparator]",
 "gives the tube-volume profile {",
 StyleBox["T", "TI"],
 "(0), ",
 StyleBox["T", "TI"],
 "(1), \[Ellipsis]} of the vertex list ",
 StyleBox["core", "TI"],
 ", where ",
 StyleBox["T", "TI"],
 "(",
 StyleBox["s", "TI"],
 ") is the number of vertices within distance ",
 StyleBox["s", "TI"],
 " of the core.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ab87d78a-145e-452e-8fa1-4ef7a10ec7ee"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TubeVolumes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TubeVolumes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ab27b8b-87eb-4418-859d-b34016990ed1"],
 "\[LineSeparator]",
 "takes the metric interval between ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " as the core.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d0b3c6ca-a576-498c-b3f7-4246f6e44f77"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TubeVolumes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TubeVolumes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["q1", "TI"], ",", " ", 
      StyleBox["q2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c539cae9-de03-434d-b8ba-e087f0c536cb"],
 "\[LineSeparator]",
 "gives one profile per target, each about the interval from ",
 StyleBox["p", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72f057d0-a0de-4046-b836-599c4bbd8f1f"],
 " takes every vertex as a target.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"785f4c6f-dabc-433c-962b-6940dd5bcdbb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TubeVolumes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TubeVolumes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dfdedbfb-b392-4a47-a958-0e1a50ddb4b3"],
 "\[LineSeparator]",
 "gives the single volume ",
 StyleBox["T", "TI"],
 "(",
 StyleBox["s", "TI"],
 "), and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TubeVolumes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TubeVolumes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["smin", "TI"], ",", " ", 
      StyleBox["smax", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d7893f81-77f8-4ec2-b27a-59466eac467e"],
 " the volumes for the radii ",
 StyleBox["smin", "TI"],
 " to ",
 StyleBox["smax", "TI"],
 "."
}], "Usage",ExpressionUUID->"27d4d802-f727-4bdb-8639-c3a2227f4b9f"],

Cell[TextData[{
 "Definition: the tube of radius ",
 StyleBox["s", "TI"],
 " about a vertex set ",
 StyleBox["K", "TI"],
 " is ",
 StyleBox["T_s(K) = {w : d(w, K) \[LessEqual] s}", "TI"],
 ", and its volume is the number of its vertices. ",
 StyleBox["T(0)", "TI"],
 " is the size of the core, and the profile saturates at the component of the \
core."
}], "Notes",ExpressionUUID->"4a1bfd18-a5ce-4f71-8bf4-472a741ae845"],

Cell[TextData[{
 "The tube reads the curvature along a direction, which the ball cannot. For \
a geodesic of length ",
 StyleBox["L", "TI"],
 " and direction ",
 StyleBox["v", "TI"],
 " on a Riemannian manifold, Gray's tube formula is ",
 StyleBox["Vol T_s = \[Omega]_(d\[Minus]1) s^(d\[Minus]1) L (1 \[Minus] (R + \
Ric(v, v)) s\.b2 / (6(d + 1)) + O(s\:2074))", "TI"],
 ". The regression of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DimensionCurvatureFit"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "513c09ad-3cf4-4312-8188-f9053033153f"],
 " with ",
 Cell[BoxData[
  RowBox[{"\"\<Probe\>\"", " ", "->", " ", "\"\<Tube\>\""}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "517d836d-5f88-4da2-bdf8-d2df3457aa76"],
 " reads ",
 StyleBox["R + Ric(v, v)", "TI"],
 ", and subtracting the scalar curvature read by the ball leaves the Ricci \
curvature in the direction ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"490dd94a-76a5-4767-a6b3-ce0b9c762bec"],

Cell[TextData[{
 "The pair form takes as core the metric interval ",
 StyleBox["I(p, q) = {w : d(p, w) + d(w, q) = d(p, q)}", "TI"],
 ", the union of all geodesics from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", which is the vertex set of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SegmentGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SegmentGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "167e2f98-35ba-4bad-993b-5bfc4f45dbfd"],
 ". On a lattice the interval is fat: on the square grid it is the rectangle \
spanned by ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ", and a tube about it is exactly ",
 StyleBox["(a + 1)(b + 1) + 2s(a + b + 2) + 2s(s \[Minus] 1)", "TI"],
 " vertices, with ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " the two coordinate differences. The spread of the tube volumes over a \
shell of targets is then the spread of the rectangles, not curvature."
}], "Notes",ExpressionUUID->"a8726d3c-dfd4-41a0-86d2-152834e20762"],

Cell[TextData[{
 "The target form reads every profile off one distance matrix, so the \
distribution of tube volumes over a shell of ",
 StyleBox["p", "TI"],
 " is one call."
}], "Notes",ExpressionUUID->"ec319472-48ee-4e7c-9458-982f65b315c5"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["\"\<Measure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "619093e4-846a-41ca-9f0b-39ac94a22d38"],
 " sets the convention for the outermost layer, as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallVolumes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallVolumes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7c99c6e4-96eb-49e0-ad1d-602ae82e3f2b"],
 ", with the boundary of the tube in place of that of the ball: ",
 Cell[BoxData["\"\<FullCount\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79011abe-2fe4-4c77-8e90-ad051d22f76e"],
 " (default), ",
 Cell[BoxData["\"\<WithoutBoundary\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9378fb93-2eb5-4e9e-8f00-ce9dfae0b298"],
 ", ",
 Cell[BoxData["\"\<HalfBoundary\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af1490b7-4613-4bb3-8ead-390d71991993"],
 ", ",
 Cell[BoxData["\"\<ExpandingFront\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ca2256d-d285-4db9-8024-c4ae96a8dc0a"],
 "."
}], "Notes",ExpressionUUID->"c7d08097-2225-41b3-a5b2-2440c0305296"]
}, Open  ]],

