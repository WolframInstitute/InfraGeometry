Cell["\<\
The volumes of the tubes of radius 2 about the intervals from the centre of \
the square tiling to each vertex of its shell of radius 6, as a histogram.\
\>", "ExampleText",ExpressionUUID->"cb19c42c-f4ef-4d0f-b593-9cde1841ea34"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Large\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ctr", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"tubes", " ", "=", " ", 
     RowBox[{"TubeVolumes", "[", 
      RowBox[{"g", ",", " ", "ctr", ",", " ", 
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "ctr", ",", " ", "6"}], "]"}], ",", " ", "2"}],
       "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Histogram", "[", 
      RowBox[{"tubes", ",", " ", 
       RowBox[{"{", "1", "}"}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<T(2)\>\"", ",", " ", "\"\<targets\>\""}], "}"}]}]}], 
      "]"}], ",", " ", 
     RowBox[{"KeySort", " ", "@", " ", 
      RowBox[{"Counts", " ", "@", " ", "tubes"}]}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"866852b3-55e7-4b5d-90b7-0c6abcaff0a3"],

