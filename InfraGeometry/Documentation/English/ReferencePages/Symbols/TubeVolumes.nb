Cell["\<\
The volumes of the tubes of radius 2 about the intervals from the centre of \
the square tiling to each vertex of its shell of radius 6, as a histogram of \
counts.\
\>", "ExampleText",ExpressionUUID->"fa9f1901-40a3-4dd3-b188-adea95dca531"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Large\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ctr", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"KeySort", " ", "@", " ", 
    RowBox[{"Counts", " ", "@", " ", 
     RowBox[{"TubeVolumes", "[", 
      RowBox[{"g", ",", " ", "ctr", ",", " ", 
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "ctr", ",", " ", "6"}], "]"}], ",", " ", "2"}],
       "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3e3e0b64-e3bc-4c58-9f47-3c4ee292ce4e"],

