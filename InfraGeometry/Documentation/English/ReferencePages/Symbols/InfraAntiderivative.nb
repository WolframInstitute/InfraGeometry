     "c715d106-fb45-40f6-ac30-b1074ab08501"], Cell[TextData[{
     "the probability that a uniformly random maximal chain from the sources \
to ",
     StyleBox["v", "TI"],
     " passes through ",
     StyleBox["u", "TI"]
    }], "TableText",ExpressionUUID->"57ef35d7-9965-438f-bf72-f27753099888"], 
