    }], "TableText",ExpressionUUID->"923eb564-e811-4487-b8c2-cf8082287e95"], 
    Cell[TextData[StyleBox[
    "W = 1", "TI"]], "TableText",ExpressionUUID->
     "6045e6b9-7417-4f60-875a-5c7ddc726741"], Cell[TextData[{
     "the sum of ",
     StyleBox["f(u)", "TI"],
     " times the number of chains from ",
