Cell["\<\
The forward random walk carries all the mass to the maximal elements. Here \
the only maximal element is 6:\
\>", "ExampleText",ExpressionUUID->"ec9a4865-1a72-44b8-b1bf-aaeace02fed0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dag", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"2", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"1", " ", "->", " ", "4"}], ",", " ", 
        RowBox[{"4", " ", "->", " ", "5"}], ",", " ", 
        RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
        RowBox[{"5", " ", "->", " ", "6"}], ",", " ", 
        RowBox[{"1", " ", "->", " ", "6"}]}], "}"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"1", " ", "->", " ", "5"}], ",", " ", 
       RowBox[{"2", " ", "->", " ", 
        RowBox[{"-", "2"}]}], ",", " ", 
       RowBox[{"3", " ", "->", " ", "7"}], ",", " ", 
       RowBox[{"4", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"5", " ", "->", " ", "3"}], ",", " ", 
       RowBox[{"6", " ", "->", " ", 
        RowBox[{"-", "4"}]}]}], "|>"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"dag", ",", " ", 
        RowBox[{"InfraAntiderivative", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<ForwardRandomWalk\>\""}]}], 
         "]"}], ",", " ", "\"\<Function\>\""}], "]"}], "[", "6", "]"}], ",", 
     " ", 
     RowBox[{"Total", "[", "f", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5d949cfc-e85a-4fcf-8b41-defe9d458488"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"10", ",", "10"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"ddf9140c-beaf-4b91-b0d7-a009b86f14a7"]
}, Open  ]],

Cell[TextData[{
 "From an origin ",
 StyleBox["c", "TI"],
 ", the zeta antiderivative at ",
 StyleBox["v", "TI"],
 " is the sum of ",
 StyleBox["f", "TI"],
 " over the segment from ",
 StyleBox["c", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ", and the uniform-chain antiderivative the mean of the integral of ",
 StyleBox["f", "TI"],
 " along it:"
}], "ExampleText",ExpressionUUID->"e4f599be-45d5-4273-b63d-d8322a09be41"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"c", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"#", "^", "2"}], ",", " ", "11"}], "]"}], " ", "&"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"zeta", " ", "=", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraAntiderivative", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"\"\<Origin\>\"", " ", "->", " ", "c"}]}], "]"}], ",", 
        " ", "\"\<Function\>\""}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"uniform", " ", "=", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraAntiderivative", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<UniformChain\>\""}], ",", 
          " ", 
          RowBox[{"\"\<Origin\>\"", " ", "->", " ", "c"}]}], "]"}], ",", 
        " ", "\"\<Function\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", "\n", "     ", 
       RowBox[{
        RowBox[{
         RowBox[{"zeta", "[", "#", "]"}], " ", "==", " ", 
         RowBox[{"Total", "[", 
          RowBox[{"f", " ", "/@", " ", 
           RowBox[{"Keys", " ", "@", " ", 
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraSegment", "[", 
               RowBox[{"c", ",", " ", "#"}], "]"}], ",", 
              " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}]}], " ", 
        "&"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"uniform", "[", "#", "]"}], " ", "==", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraIntegral", "[", 
            RowBox[{"f", ",", " ", 
             RowBox[{"InfraSegment", "[", 
              RowBox[{"c", ",", " ", "#"}], "]"}]}], "]"}], ",", 
           " ", "\"\<Mean\>\""}], "]"}]}], " ", "&"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"c8682993-da94-48db-9bf0-8f5c9bf31006"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"9a889393-8b12-432e-b2cb-59b95578dcf0"]
}, Open  ]],

Cell[TextData[{
 "Blow each vertex of the diamond up into two copies and each link into the \
four links between the copies, spread ",
 StyleBox["f", "TI"],
 " evenly and add the copies back. The random walks and, on this graded \
order, ",
 Cell[BoxData["\"\<UniformChain\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6df8a252-0411-4ef3-a2fb-ac5f48240b4c"],
 " commute with the blow-up; ",
 Cell[BoxData["\"\<Zeta\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bfa20e77-c5ea-43df-963f-4f4bb1198722"],
 " and ",
 Cell[BoxData["\"\<PathCount\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5365a01f-bcf4-40a0-b986-7b7bbc319389"],
 " count the new chains and do not:"
}], "ExampleText",ExpressionUUID->"ce56554a-bd17-454d-be8e-87cc13f214c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"diamond", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "4"}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "4"}]}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"2", " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
        RowBox[{"4", " ", "->", " ", "3"}]}], "|>"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"big", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{"Flatten", " ", "@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"DirectedEdge", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"First", "[", "e", "]"}], ",", " ", "i"}], "}"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Last", "[", "e", "]"}], ",", " ", "j"}], "}"}]}], 
           "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"e", ",", " ", 
            RowBox[{"EdgeList", "[", "diamond", "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "2"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "2"}], "}"}]}], "]"}]}], "]"}]}], ",", "\n",
      "   ", 
     RowBox[{"spread", " ", "=", " ", 
      RowBox[{"Association", " ", "@", " ", 
       RowBox[{"Flatten", " ", "@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"v", ",", " ", "i"}], "}"}], " ", "->", " ", 
           RowBox[{
            RowBox[{"f", "[", "v", "]"}], " ", "/", " ", "2"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"v", ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "2"}], "}"}]}], "]"}]}]}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"m", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Values", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"diamond", ",", " ", 
           RowBox[{"InfraAntiderivative", "[", 
            RowBox[{"f", ",", " ", 
             RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", 
           " ", "\"\<Function\>\""}], "]"}]}], " ", "===", "\n", "      ", 
        RowBox[{"Total", " ", "/@", " ", 
         RowBox[{"Partition", "[", 
          RowBox[{
           RowBox[{"Values", " ", "@", " ", 
            RowBox[{"KeySort", " ", "@", "\n", "        ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"big", ",", " ", 
               RowBox[{"InfraAntiderivative", "[", 
                RowBox[{"spread", ",", " ", 
                 RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", 
               " ", "\"\<Function\>\""}], "]"}]}]}], ",", " ", "2"}], 
          "]"}]}]}], ")"}]}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Zeta\>\"", ",", " ", "\"\<PathCount\>\"", ",", 
         " ", "\"\<BackwardRandomWalk\>\"", ",", " ", "\"\<UniformChain\>\"", 
         ",", " ", "\"\<ForwardRandomWalk\>\""}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"91ea565f-e581-4e07-90fc-34ab10ef9d28"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Zeta\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"PathCount\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"BackwardRandomWalk\"\>", "\[Rule]", "True"}], ",", 
