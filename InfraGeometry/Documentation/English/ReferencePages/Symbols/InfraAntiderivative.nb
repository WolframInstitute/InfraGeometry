          RowBox[{"InfraAntiderivative", "[", 
           RowBox[{
            RowBox[{"InfraDerivative", "[", 
             RowBox[{"f", ",", " ", 
              RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", " ", 
            RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", 
          " ", "\"\<Function\>\""}], "]"}], " ", "===", " ", "f"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Zeta\>\"", ",", " ", "\"\<PathCount\>\"", ",", 
