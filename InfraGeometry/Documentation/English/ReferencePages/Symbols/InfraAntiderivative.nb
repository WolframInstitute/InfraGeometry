        RowBox[{"4", " ", "->", " ", "5"}], ",", " ", 
        RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
        RowBox[{"5", " ", "->", " ", "6"}], ",", " ", 
        RowBox[{"1", " ", "->", " ", "6"}]}], "}"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"1", " ", "->", " ", "5"}], ",", " ", 
       RowBox[{"2", " ", "->", " ", 
        RowBox[{"-", "2"}]}], ",", " ", 
       RowBox[{"3", " ", "->", " ", "7"}], ",", " ", 
       RowBox[{"4", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"5", " ", "->", " ", "3"}], ",", " ", 
       RowBox[{"6", " ", "->", " ", 
        RowBox[{"-", "4"}]}]}], "|>"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"m", " ", "->", " ", 
      RowBox[{"{", "\n", "     ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"dag", ",", " ", 
           RowBox[{"InfraDerivative", "[", 
            RowBox[{
             RowBox[{"InfraAntiderivative", "[", 
              RowBox[{"f", ",", " ", 
               RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", " ", 
             RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", 
           " ", "\"\<Function\>\""}], "]"}], " ", "===", " ", "f"}], ",", 
        "\n", "     ", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"dag", ",", " ", 
           RowBox[{"InfraAntiderivative", "[", 
            RowBox[{
             RowBox[{"InfraDerivative", "[", 
              RowBox[{"f", ",", " ", 
               RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", " ", 
             RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", 
           " ", "\"\<Function\>\""}], "]"}], " ", "===", " ", "f"}]}], 
       "}"}]}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Zeta\>\"", ",", " ", "\"\<PathCount\>\"", ",", 
         " ", "\"\<BackwardRandomWalk\>\"", ",", " ", "\"\<UniformChain\>\"", 
         ",", " ", "\"\<ForwardRandomWalk\>\""}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f1f1d765-8cba-4e97-8405-83b4ff0978e4"],

