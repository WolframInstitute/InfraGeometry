Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0d9100ab-dcc9-4226-b5a9-9a0342c479e1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraAntiderivative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraAntiderivative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["f", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95384dcc-3024-423b-86b6-1af08f6e0d09"],
 "\[LineSeparator]",
 "is the antiderivative of the vertex function ",
 StyleBox["f", "TI"],
 ": the sum of ",
 StyleBox["f", "TI"],
 " over the past of each vertex.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"96d22493-fa84-4193-a6bb-ceb8e1cfd2a7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraAntiderivative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraAntiderivative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["f", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", 
     StyleBox["m", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "367f3ec8-c6dc-4b57-b81f-671cf4fce9bb"],
 "\[LineSeparator]",
 "sums ",
 StyleBox["f", "TI"],
 " over the past with the kernel of the method ",
 StyleBox["m", "TI"],
 "."
}], "Usage",ExpressionUUID->"73c8f051-9047-455f-9e3a-d12c063ec0ee"],

Cell[TextData[{
 "The antiderivative with kernel ",
 StyleBox["K", "TI"],
 " is ",
 StyleBox["F(v) = \[CapitalSigma] f(u) K(u, v)", "TI"],
 ", the sum over the ",
 StyleBox["u \[PrecedesEqual] v", "TI"],
 ", with ",
 StyleBox["K(v, v) = 1", "TI"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDerivative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDerivative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1dad034a-ab9b-46c6-80ee-0ff4721e3759"],
 " is its exact inverse."
}], "Notes",ExpressionUUID->"2ef6425c-70c5-4e97-897c-ae33a6b54585"],

