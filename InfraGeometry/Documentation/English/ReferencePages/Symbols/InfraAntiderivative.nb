            RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", 
          " ", "\"\<Function\>\""}], "]"}], " ", "===", " ", "f"}], ",", "\n",
        "     ", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
