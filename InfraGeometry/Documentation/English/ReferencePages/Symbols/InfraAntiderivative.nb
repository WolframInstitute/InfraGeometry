Cell[TextData[{
 "From an origin, the uniform-chain antiderivative is the mean of the \
integral of ",
 StyleBox["f", "TI"],
 " along the shortest paths from the origin, and the zeta antiderivative is \
the sum of ",
 StyleBox["f", "TI"],
 " over the segment."
}], "ExampleText",ExpressionUUID->"e529940d-af56-4b7e-a9cb-e84a26d65dba"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "3", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"c", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "9"}], ",", " ", "9"}], "}"}], ",", " ", 
          RowBox[{"VertexCount", "[", "g", "]"}]}], "]"}]}], "]"}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"uniform", " ", "=", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraAntiderivative", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<UniformChain\>\""}], ",", 
          " ", 
          RowBox[{"\"\<Origin\>\"", " ", "->", " ", "c"}]}], "]"}], ",", 
        " ", "\"\<Function\>\""}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"zeta", " ", "=", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraAntiderivative", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"\"\<Origin\>\"", " ", "->", " ", "c"}]}], "]"}], ",", 
        " ", "\"\<Function\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"uniform", "[", "#", "]"}], " ", "==", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraIntegral", "[", 
            RowBox[{"f", ",", " ", 
             RowBox[{"InfraSegment", "[", 
              RowBox[{"c", ",", " ", "#"}], "]"}]}], "]"}], ",", 
           " ", "\"\<Mean\>\""}], "]"}]}], " ", "&"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"zeta", "[", "#", "]"}], " ", "==", " ", 
         RowBox[{"Total", " ", "@", " ", 
          RowBox[{"Lookup", "[", 
           RowBox[{"f", ",", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSegment", "[", 
                RowBox[{"c", ",", " ", "#"}], "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}]}]}], " ", 
        "&"}]}], "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"a4eab2fd-663f-40d7-b7c7-144984a0c1ad"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"88b85c7e-c7dc-4419-a8e9-7dcf0402a0a3"]
}, Open  ]],

Cell[TextData[{
 "Blow up each vertex into ",
 StyleBox["n", "TI"],
 " copies and each link into the complete bipartite graph between them, \
spread ",
 StyleBox["f", "TI"],
 " evenly over the copies and sum the antiderivative back. ",
 Cell[BoxData["\"\<BackwardRandomWalk\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f65652ec-25d8-4b96-9cdc-2bb6cb2de866"],
 " and ",
 Cell[BoxData["\"\<ForwardRandomWalk\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba37d9f7-fc3e-4d16-beac-02e3212cc03f"],
 " commute with this; ",
 Cell[BoxData["\"\<UniformChain\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "049fca44-9632-4734-9c96-2999ee1d2562"],
 " does on a graded order, such as the diamond; ",
 Cell[BoxData["\"\<Zeta\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fbf8e7ef-12f9-4dbd-b862-eff58eb5a37b"],
 " and ",
 Cell[BoxData["\"\<PathCount\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "745ba264-743e-4d68-996a-48baa091ccae"],
 " count the new chains and do not."
}], "ExampleText",ExpressionUUID->"b0d5bcac-3816-4409-8612-1b7c3cd958fc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"diamond", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
          RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
          RowBox[{"2", " ", "->", " ", "4"}], ",", " ", 
          RowBox[{"3", " ", "->", " ", "4"}]}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"2", " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
        RowBox[{"4", " ", "->", " ", "3"}]}], "|>"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"big", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"v", ",", " ", "i"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"v", ",", " ", "4"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", "1"}], 
        "]"}], ",", " ", 
       RowBox[{"Flatten", " ", "@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"DirectedEdge", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"First", "[", "e", "]"}], ",", " ", "i"}], "}"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Last", "[", "e", "]"}], ",", " ", "j"}], "}"}]}], 
           "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"e", ",", " ", 
            RowBox[{"EdgeList", "[", "diamond", "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "2"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "2"}], "}"}]}], "]"}]}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"spread", " ", "=", " ", 
     RowBox[{"Association", " ", "@", " ", 
      RowBox[{"Flatten", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"v", ",", " ", "i"}], "}"}], " ", "->", " ", 
          RowBox[{
           RowBox[{"f", "[", "v", "]"}], " ", "/", " ", "2"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "4"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "2"}], "}"}]}], "]"}]}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"m", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"big", ",", " ", 
               RowBox[{"InfraAntiderivative", "[", 
                RowBox[{"spread", ",", " ", 
                 RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", 
               " ", "\"\<Function\>\""}], "]"}], "[", 
             RowBox[{"{", 
              RowBox[{"v", ",", " ", "i"}], "}"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"v", ",", " ", "4"}], "}"}]}], "]"}], " ", "===", " ", 
        RowBox[{"Values", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"diamond", ",", " ", 
           RowBox[{"InfraAntiderivative", "[", 
            RowBox[{"f", ",", " ", 
             RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", 
           " ", "\"\<Function\>\""}], "]"}]}]}], ")"}]}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Zeta\>\"", ",", " ", "\"\<PathCount\>\"", ",", 
         " ", "\"\<BackwardRandomWalk\>\"", ",", " ", "\"\<UniformChain\>\"", 
         ",", " ", "\"\<ForwardRandomWalk\>\""}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"1b3ede0d-23bc-463d-9cb2-ce7b23bd3387"],

