      "5592c1ed-d0f1-415a-9bc0-943d5a24abd7"]
    }], "TableText",ExpressionUUID->"99a92f80-7cee-4f6d-aa7f-461cc9539699"]},
   {Cell[TextData[Cell[BoxData["\"\<PathCount\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "e84a8342-5054-45a9-996e-b7d45b87b4bd"]], "TableText",ExpressionUUID->
     "dfbb3c15-d8e7-4226-8503-941e0e5e83c8"], Cell[TextData[{
     "the number of chains from ",
     StyleBox["u", "TI"],
     " to ",
