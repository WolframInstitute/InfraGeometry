Cell[TextData[{
 "Every method on the function 1, at a vertex two steps along each axis from \
the centre of the square grid. The segment to it is a 3 \[Times] 3 square \
with 6 shortest paths. ",
 Cell[BoxData["\"\<Zeta\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0594678b-48fe-4cd7-b8e6-dc7bcdc11dad"],
 " counts its 9 vertices, ",
 Cell[BoxData["\"\<PathCount\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "754c4806-dd09-43ee-9029-f81d05188cab"],
 " counts each vertex once per shortest path from it, ",
 Cell[BoxData["\"\<BackwardRandomWalk\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b95115a3-6f90-49b2-9975-fe1ebd6e2441"],
 " and ",
 Cell[BoxData["\"\<UniformChain\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e99081e8-7a38-4c9f-a7ce-0a03c5350fe1"],
 " give the 5 vertices of every shortest path, and ",
 Cell[BoxData["\"\<ForwardRandomWalk\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9ed04d4-ed9b-4a8c-93f7-53730f9d8d08"],
 " the mass it holds when every vertex starts with 1 and passes what it holds \
on, evenly over its out-links."
}], "ExampleText",ExpressionUUID->"2b58f904-9740-48c3-9873-7d803791556b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"MaximalBy", "[", 
       RowBox[{
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", "4"}], "]"}], ",", 
           " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSegment", "[", 
            RowBox[{"c", ",", " ", "#"}], "]"}], ",", 
           " ", "\"\<Cardinality\>\""}], "]"}], " ", "&"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"m", " ", "->", " ", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraAntiderivative", "[", 
          RowBox[{
           RowBox[{"1", " ", "&"}], ",", " ", 
           RowBox[{"Method", " ", "->", " ", "m"}], ",", " ", 
           RowBox[{"\"\<Origin\>\"", " ", "->", " ", "c"}]}], "]"}], ",", 
         " ", "\"\<Function\>\""}], "]"}], "[", "q", "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Zeta\>\"", ",", " ", "\"\<PathCount\>\"", ",", 
         " ", "\"\<BackwardRandomWalk\>\"", ",", " ", "\"\<UniformChain\>\"", 
         ",", " ", "\"\<ForwardRandomWalk\>\""}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"67a51fe0-bce5-47b1-859a-0557a5914e5a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Zeta\"\>", "\[Rule]", "9"}], ",", 
   RowBox[{"\<\"PathCount\"\>", "\[Rule]", "19"}], ",", 
   RowBox[{"\<\"BackwardRandomWalk\"\>", "\[Rule]", "5"}], ",", 
   RowBox[{"\<\"UniformChain\"\>", "\[Rule]", "5"}], ",", 
   RowBox[{"\<\"ForwardRandomWalk\"\>", "\[Rule]", 
    FractionBox["61", "18"]}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"143fb6ce-a90e-4c8f-aa6e-5049548588d2"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<Future\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dcd2290-d5cd-4296-81f0-4e7665c47a2d"],
 " accumulates over the future instead, the antiderivative on the reversed \
graph."
}], "ExampleText",ExpressionUUID->"c2af7d08-3fa5-4a50-836a-7e0cf7a232f6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"dag", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
          RowBox[{"2", " ", "->", " ", "3"}], ",", " ", 
          RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
          RowBox[{"1", " ", "->", " ", "4"}], ",", " ", 
          RowBox[{"4", " ", "->", " ", "5"}], ",", " ", 
          RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
          RowBox[{"5", " ", "->", " ", "6"}]}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", 
          RowBox[{"-", "2"}], ",", " ", "7", ",", " ", "1", ",", " ", "3", ",",
           " ", 
          RowBox[{"-", "4"}]}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"dag", ",", " ", 
      RowBox[{"InfraAntiderivative", "[", 
       RowBox[{"f", ",", " ", 
        RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<Future\>\""}]}], 
       "]"}], ",", " ", "\"\<Function\>\""}], "]"}], " ", "===", " ", 
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{
      RowBox[{"ReverseGraph", "[", "dag", "]"}], ",", " ", 
      RowBox[{"InfraAntiderivative", "[", "f", "]"}], ",", 
      " ", "\"\<Function\>\""}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"044dd169-829e-499f-a333-550b3ffa095a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"222c35d9-d7c7-44b7-a46b-e53bb1168c79"]
}, Open  ]]
}, Open  ]],

