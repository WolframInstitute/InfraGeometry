Cell[TextData[{
 "Every method but ",
 Cell[BoxData["\"\<Zeta\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39ef01d3-863c-4440-88c0-e617b09215de"],
 " is a path kernel ",
 StyleBox["K = (1 \[Minus] W)^(\[Minus]1)", "TI"],
 ": ",
 StyleBox["K(u, v)", "TI"],
 " sums, over the chains from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ", the product of a weight ",
 StyleBox["W", "TI"],
 " on their links, and ",
 StyleBox["F(v) = f(v) + \[CapitalSigma]_(u \:22d6 v) W(u, v) F(u)", "TI"],
 "."
}], "Notes",ExpressionUUID->"03a13bbc-fb23-4aa6-89c2-68dede49a00e"],

Cell[BoxData[GridBox[{
   {Cell[TextData[Cell[BoxData[
