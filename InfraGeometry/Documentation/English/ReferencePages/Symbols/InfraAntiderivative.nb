     "98a934a3-ed99-448f-b9ca-56a4b28c7f1a"], Cell[TextData[{
     "the expected integral of ",
     StyleBox["f", "TI"],
     " along the random walk back from ",
     StyleBox["v", "TI"]
    }], "TableText",ExpressionUUID->"50f23faa-779d-437e-a52a-892e04bbb57e"]},
   {Cell[TextData[Cell[BoxData["\"\<ForwardRandomWalk\>\""], "InlineFormula",
