Cell[TextData[{
 "Every method but ",
 Cell[BoxData["\"\<Zeta\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48359629-ec26-430a-88de-49b42ab53583"],
 " is a path kernel ",
 StyleBox["K = (1 \[Minus] W)\:207b\.b9", "TI"],
 ", a weight ",
 StyleBox["W", "TI"],
 " on the links multiplied along the chains from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ". Then ",
 StyleBox["F(v) = f(v) + \[CapitalSigma] W(u, v) F(u)", "TI"],
 ", the sum over the links ",
 StyleBox["u \:22d6 v", "TI"],
 "."
}], "Notes",ExpressionUUID->"b61cb06a-f39b-4f38-978d-aa1193a231ec"],

