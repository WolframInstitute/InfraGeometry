Cell[TextData[{
 "On the diamond ",
 StyleBox["1 < 2, 3 < 4", "TI"],
 " the zeta and the path-count antiderivative differ at the top, which two \
chains join to the bottom:"
}], "ExampleText",ExpressionUUID->"bc1e1449-e539-4453-ac8c-7c030e092d4e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"diamond", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"2", " ", "->", " ", "4"}], ",", " ", 
        RowBox[{"3", " ", "->", " ", "4"}]}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
       RowBox[{"2", " ", "->", " ", "3"}], ",", " ", 
       RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
       RowBox[{"4", " ", "->", " ", "7"}]}], "|>"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"diamond", ",", " ", 
       RowBox[{"InfraAntiderivative", "[", 
        RowBox[{"f", ",", " ", 
         RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", 
       " ", "\"\<Function\>\""}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Zeta\>\"", ",", " ", "\"\<PathCount\>\""}], "}"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ebcab203-47e3-44a4-83fe-c001a41fe7d6"],

