Notebook[{

Cell[CellGroupData[{
Cell["InfraAntiderivative", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a4cea5db-93a5-4927-9a28-50b32c90215c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraAntiderivative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraAntiderivative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["f", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9346ad55-f724-46b2-8792-e59551c3b6f5"],
 "\[LineSeparator]",
 "is the antiderivative of the vertex function ",
 StyleBox["f", "TI"],
 ": ",
 StyleBox["F(v) = \[CapitalSigma]_(u \[PrecedesEqual] v) f(u)", "TI"],
 ", the sum of ",
 StyleBox["f", "TI"],
 " over the past of each vertex. It is a symbolic object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cb8bdda6-511e-4d48-8217-222b70056ace"],
 " evaluates it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b8118e00-9d92-46d5-b5ad-8e064af92e91"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraAntiderivative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraAntiderivative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["f", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", 
     StyleBox["m", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22491c87-94bd-4ed0-93fb-8ad801d74ba7"],
 "\[LineSeparator]",
 "accumulates ",
 StyleBox["f", "TI"],
 " through the kernel of the method ",
 StyleBox["m", "TI"],
 ": ",
 StyleBox["F(v) = \[CapitalSigma]_(u \[PrecedesEqual] v) f(u) K(u, v)", 
  "TI"],
 "."
}], "Usage",ExpressionUUID->"e6b99ede-f41b-4b8b-8cb3-5810323e9a04"],

Cell[TextData[{
 "Definition: the antiderivative with kernel ",
 StyleBox["K", "TI"],
 " is ",
 StyleBox["(I_K f)(v) = \[CapitalSigma]_(u \[PrecedesEqual] v) f(u) K(u, v)", 
  "TI"],
 ", where ",
 StyleBox["K", "TI"],
 " is a function on the pairs ",
 StyleBox["u \[PrecedesEqual] v", "TI"],
 " of the order with ",
 StyleBox["K(v, v) = 1", "TI"],
 ", an element of its incidence algebra. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDerivative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDerivative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5ad5be3d-1120-407a-84f0-92abccf0a0fc"],
 " is its exact inverse."
}], "Notes",ExpressionUUID->"e2f3dcb6-a14f-4aa2-98d4-0a650b156afd"],

Cell["The order:", "Notes",ExpressionUUID->"5285562a-c6ad-4c2f-b99b-2480ef234332"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f190e123-37d3-46f6-a071-74c28fb505ec"], Cell["Substrate", "TableText",
     FontWeight->Bold,ExpressionUUID->"2a340437-3c47-443c-bc15-65a7b40dbab7"],
     Cell[TextData[{
     "Order ",
     StyleBox["u \[PrecedesEqual] v", "TI"]
    }], "TableText",
     FontWeight->Bold,ExpressionUUID->"b5c8ac8a-5be3-4607-94ee-0953d321fded"],
     Cell[TextData[{
     "Links ",
     StyleBox["u \:22d6 v", "TI"]
    }], "TableText",
     FontWeight->Bold,ExpressionUUID->"f7bbc254-856e-4d27-9be2-970f61c65f8a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "56a6d1f9-12f0-4313-9963-8f6087391589"], Cell[
    "directed acyclic graph", "TableText",ExpressionUUID->
     "7a500788-af1b-45ed-b268-1fa0fe0b5812"], Cell[TextData[{
     StyleBox["v", "TI"],
     " is reachable from ",
     StyleBox["u", "TI"]
    }], "TableText",ExpressionUUID->"2278fe09-e94e-454c-b69d-4f195d11501f"], 
    Cell[TextData[{
     "the edges of ",
     Cell[BoxData["TransitiveReductionGraph"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1cb86040-b148-46ca-9562-7eda3a047ba0"]
    }], "TableText",ExpressionUUID->"7206361f-db60-4c1a-aeb7-4330787aaa1a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "07b246f0-5c75-4360-b6d2-f1fe91ef45f6"], Cell[TextData[{
     "undirected graph, ",
     Cell[BoxData[
      RowBox[{"\"\<Origin\>\"", " ", "->", " ", "c"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e285a957-e79e-4139-aed4-f050243338b9"]
    }], "TableText",ExpressionUUID->"1ed1200a-8ead-4642-ae10-b46acda53a6e"], 
    Cell[TextData[{
     "the spray order, ",
     StyleBox["d(c, u) + d(u, v) = d(c, v)", "TI"]
    }], "TableText",ExpressionUUID->"0c417036-a6f6-4eee-8040-7833354b08fe"], 
    Cell[TextData[{
     "the edges of ",
     Cell[BoxData[
      RowBox[{
       TemplateBox[{
         Cell[
          TextData["SprayGraph"]], 
         "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
         "WolframInstitute/InfraGeometry Package Symbol"},
        "PackageLink",
        BaseStyle->"InlineFormula"], "[", 
       RowBox[{
        StyleBox["g", "TI"], ",", " ", 
        StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f11662bc-a77c-441b-9788-d5aeedf01273"]
    }], "TableText",ExpressionUUID->"42e2d707-60c7-4bd3-852f-d2a00477d156"]}
  }]], "3ColumnTableMod",ExpressionUUID->"9e4b1e5f-9daa-4049-8856-\
dadb3d9a636c"],

Cell[TextData[{
 "On a directed acyclic graph everything reads the links, so adding an \
implied edge changes nothing. From an origin the intervals of the order are \
the segments: ",
 StyleBox["u \[PrecedesEqual] v", "TI"],
 " exactly when ",
 StyleBox["u", "TI"],
 " lies on a shortest path from ",
 StyleBox["c", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ". Vertices that ",
 StyleBox["c", "TI"],
 " does not reach are left out."
}], "Notes",ExpressionUUID->"710b4dce-e681-483b-874e-ee6cefb7c7fb"],

Cell[TextData[{
 StyleBox["f", "TI"],
 " is a 0-form: an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bb2b9853-e906-470d-b029-7f939a647cb8"],
 " ",
 StyleBox["v", "TI"],
 " -> ",
 StyleBox["x", "TI"],
 ", in which a missing vertex counts as 0, or a function applied to each \
vertex. A head with a ",
 Cell[BoxData["\"\<Function\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d15f6b1-846f-49ec-91ec-910c70ba2aa2"],
 " reading is read through it."
}], "Notes",ExpressionUUID->"bdbc7dc0-2091-46aa-af90-0cf7fdc429b8"],

