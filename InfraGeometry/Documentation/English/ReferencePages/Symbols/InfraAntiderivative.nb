Cell["The degrees are those of the links. Arithmetic stays exact.", "Notes",ExpressionUUID->"1606ae59-a6b5-4c61-8a62-fd6115e0790a"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
