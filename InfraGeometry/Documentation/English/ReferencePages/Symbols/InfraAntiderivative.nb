    }], "TableText",ExpressionUUID->"b42d3704-db11-4f7d-9f2e-878d1a7e125b"], 
    Cell[TextData[StyleBox[
    "W(u, v) = 1 / indeg(v)", "TI"]], "TableText",ExpressionUUID->
     "a692cb06-b9e9-4c02-a9bf-6fe0bb87d7ad"], Cell[TextData[{
     "the expected integral of ",
     StyleBox["f", "TI"],
     " along the random walk back from ",
     StyleBox["v", "TI"]
    }], "TableText",ExpressionUUID->"f8f9af1c-4cd8-48cb-92a5-f1b9deb5e517"]},
   {Cell[TextData[Cell[BoxData["\"\<ForwardRandomWalk\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "84e6dc54-4956-4e7a-b724-fb242478cd47"]], "TableText",ExpressionUUID->
     "fde2f34f-769a-4354-b1f6-de40a3609a04"], Cell[TextData[{
     "the probability that the forward random walk from ",
     StyleBox["u", "TI"],
     ", each step to a uniformly random successor, visits ",
     StyleBox["v", "TI"]
    }], "TableText",ExpressionUUID->"645fbec8-3a02-44b1-a9d0-79b236a27191"], 
    Cell[TextData[StyleBox[
    "W(u, v) = 1 / outdeg(u)", "TI"]], "TableText",ExpressionUUID->
     "bfb64a31-a893-4263-8159-86f4e31eba5e"], Cell[TextData[{
     "the mass of ",
     StyleBox["f", "TI"],
     " reaching ",
     StyleBox["v", "TI"],
     " when each vertex splits its mass evenly over its out-links"
    }], "TableText",ExpressionUUID->"8f1b834e-aebe-4feb-8280-3896569d8573"]},
   {Cell[TextData[Cell[BoxData["\"\<UniformChain\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
