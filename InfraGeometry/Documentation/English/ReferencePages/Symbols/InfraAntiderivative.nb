Cell["\<\
The antiderivative reads the order, not its encoding: the transitive closure \
gives the same function.\
\>", "ExampleText",ExpressionUUID->"8f40b9d3-2538-4e4c-ba44-ec5be4266727"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"dag", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
          RowBox[{"2", " ", "->", " ", "3"}], ",", " ", 
          RowBox[{"1", " ", "->", " ", "4"}], ",", " ", 
          RowBox[{"4", " ", "->", " ", "5"}], ",", " ", 
          RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
          RowBox[{"5", " ", "->", " ", "6"}]}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", 
          RowBox[{"-", "2"}], ",", " ", "7", ",", " ", "1", ",", " ", "3", ",",
           " ", 
          RowBox[{"-", "4"}]}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"dag", ",", " ", 
        RowBox[{"InfraAntiderivative", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", 
        " ", "\"\<Function\>\""}], "]"}], " ", "===", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{
        RowBox[{"TransitiveClosureGraph", "[", "dag", "]"}], ",", " ", 
        RowBox[{"InfraAntiderivative", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", 
        " ", "\"\<Function\>\""}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Volume\>\"", ",", " ", "\"\<Paths\>\"", ",", 
         " ", "\"\<Average\>\"", ",", " ", "\"\<Uniform\>\"", ",", 
         " ", "\"\<Flow\>\""}], "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b23fdf36-229f-4fff-a6fc-27774bb44844"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True", ",", "True", ",", "True"}], 
  "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"bf97751a-06aa-45e1-8037-63a7bf345a7f"]
}, Open  ]],

Cell["The flow carries all the mass to the maximal elements.", "ExampleText",ExpressionUUID->"ea8d9370-5b62-4d21-b5d0-4a2269066b3a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "2", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dag", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "8", "]"}], ",", " ", 
       RowBox[{"DirectedEdge", " ", "@@@", " ", 
        RowBox[{"(", 
         RowBox[{"Sort", " ", "/@", " ", 
          RowBox[{"RandomSample", "[", 
           RowBox[{
            RowBox[{"Subsets", "[", 
             RowBox[{
              RowBox[{"Range", "[", "8", "]"}], ",", " ", 
              RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", "12"}], "]"}]}], 
         ")"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"Range", "[", "8", "]"}], ",", " ", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "9"}], "}"}], ",", " ", "8"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Total", " ", "@", " ", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"dag", ",", " ", 
          RowBox[{"InfraAntiderivative", "[", 
           RowBox[{"f", ",", " ", 
            RowBox[{"Method", " ", "->", " ", "\"\<Flow\>\""}]}], "]"}], ",", 
          " ", "\"\<Function\>\""}], "]"}], ",", " ", 
        RowBox[{"Pick", "[", 
         RowBox[{
          RowBox[{"Range", "[", "8", "]"}], ",", " ", 
          RowBox[{"VertexOutDegree", "[", "dag", "]"}], ",", " ", "0"}], 
         "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"Total", "[", "f", "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"4ac08d3d-620b-451a-b9f7-1cb10d6a8e1a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"44", ",", "44"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"a75ea641-3ce7-400a-a83d-e7f0980cbed2"]
}, Open  ]],

Cell[TextData[{
 "From an origin, the uniform antiderivative is the mean of the integral of \
",
 StyleBox["f", "TI"],
 " along the shortest paths from the origin, and the volume antiderivative is \
the sum of ",
 StyleBox["f", "TI"],
 " over the segment."
}], "ExampleText",ExpressionUUID->"4deac152-a768-40ed-a33c-9ea9b5f087e2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "3", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"c", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "9"}], ",", " ", "9"}], "}"}], ",", " ", 
          RowBox[{"VertexCount", "[", "g", "]"}]}], "]"}]}], "]"}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"uniform", " ", "=", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraAntiderivative", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<Uniform\>\""}], ",", " ", 
          RowBox[{"\"\<Origin\>\"", " ", "->", " ", "c"}]}], "]"}], ",", 
        " ", "\"\<Function\>\""}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"volume", " ", "=", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraAntiderivative", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"\"\<Origin\>\"", " ", "->", " ", "c"}]}], "]"}], ",", 
        " ", "\"\<Function\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"uniform", "[", "#", "]"}], " ", "==", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraIntegral", "[", 
            RowBox[{"f", ",", " ", 
             RowBox[{"InfraSegment", "[", 
              RowBox[{"c", ",", " ", "#"}], "]"}]}], "]"}], ",", 
           " ", "\"\<Mean\>\""}], "]"}]}], " ", "&"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"volume", "[", "#", "]"}], " ", "==", " ", 
         RowBox[{"Total", " ", "@", " ", 
          RowBox[{"Lookup", "[", 
           RowBox[{"f", ",", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraSegment", "[", 
                RowBox[{"c", ",", " ", "#"}], "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}]}]}], " ", 
        "&"}]}], "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"58b11874-9e4b-4774-b0ef-b0ad3ce19b1e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"a8910d03-ddad-4614-841a-c9019354bc2d"]
}, Open  ]],

Cell[TextData[{
 "Blow up each vertex into ",
 StyleBox["n", "TI"],
 " copies and each link into the complete bipartite graph between them, \
spread ",
 StyleBox["f", "TI"],
 " evenly over the copies and sum the antiderivative back. ",
 Cell[BoxData["\"\<Average\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8951562c-781a-4769-996a-7f94d3480b3a"],
 " and ",
 Cell[BoxData["\"\<Flow\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a43ca43d-38a8-468f-a0ad-c85bfa778967"],
 " commute with this; ",
 Cell[BoxData["\"\<Uniform\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e2d8da2-c3f5-4b12-805e-61e33f53a392"],
 " does on a graded order, such as the diamond; ",
 Cell[BoxData["\"\<Volume\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63ce4a8c-b311-4b3e-93b1-cf6b93cfb1db"],
 " and ",
 Cell[BoxData["\"\<Paths\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0410ab3f-b494-4374-96d3-19268d09364c"],
 " count the new chains and do not."
}], "ExampleText",ExpressionUUID->"5cb614f9-fb90-4b96-b9c3-d39c28d139f9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"diamond", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
          RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
          RowBox[{"2", " ", "->", " ", "4"}], ",", " ", 
          RowBox[{"3", " ", "->", " ", "4"}]}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"2", " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
        RowBox[{"4", " ", "->", " ", "3"}]}], "|>"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"big", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"v", ",", " ", "i"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"v", ",", " ", "4"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", "1"}], 
        "]"}], ",", " ", 
       RowBox[{"Flatten", " ", "@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"DirectedEdge", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"First", "[", "e", "]"}], ",", " ", "i"}], "}"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Last", "[", "e", "]"}], ",", " ", "j"}], "}"}]}], 
           "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"e", ",", " ", 
            RowBox[{"EdgeList", "[", "diamond", "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "2"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "2"}], "}"}]}], "]"}]}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"spread", " ", "=", " ", 
     RowBox[{"Association", " ", "@", " ", 
      RowBox[{"Flatten", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"v", ",", " ", "i"}], "}"}], " ", "->", " ", 
          RowBox[{
           RowBox[{"f", "[", "v", "]"}], " ", "/", " ", "2"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "4"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "2"}], "}"}]}], "]"}]}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"m", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"big", ",", " ", 
               RowBox[{"InfraAntiderivative", "[", 
                RowBox[{"spread", ",", " ", 
                 RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", 
               " ", "\"\<Function\>\""}], "]"}], "[", 
             RowBox[{"{", 
              RowBox[{"v", ",", " ", "i"}], "}"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"v", ",", " ", "4"}], "}"}]}], "]"}], " ", "===", " ", 
        RowBox[{"Values", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"diamond", ",", " ", 
           RowBox[{"InfraAntiderivative", "[", 
            RowBox[{"f", ",", " ", 
             RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", 
           " ", "\"\<Function\>\""}], "]"}]}]}], ")"}]}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Volume\>\"", ",", " ", "\"\<Paths\>\"", ",", 
         " ", "\"\<Average\>\"", ",", " ", "\"\<Uniform\>\"", ",", 
         " ", "\"\<Flow\>\""}], "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"74e53a54-0be8-4608-b33b-c630552ba971"],

