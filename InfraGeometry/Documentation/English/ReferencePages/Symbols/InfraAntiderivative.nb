Cell[TextData[{
 "Every method on the function 1 at the vertex (7, 7) of the grid, centre (5, \
5). The segment to it is a 3 \[Times] 3 square. ",
 Cell[BoxData["\"\<Zeta\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe051217-1f63-4b4e-84e5-b53403927acb"],
 " counts its 9 vertices, ",
 Cell[BoxData["\"\<PathCount\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8aa9bce7-d09a-46d9-9ce0-7e0f4c3e64fe"],
 " each vertex once per chain from it, ",
 Cell[BoxData["\"\<BackwardRandomWalk\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19e9c30a-68ef-4790-9f99-585d09d94ca5"],
 " and ",
 Cell[BoxData["\"\<UniformChain\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dfbbfd46-4198-4249-aa47-59c529eafcd0"],
 " the 5 vertices of a shortest path:"
}], "ExampleText",ExpressionUUID->"88d02c51-ca2e-48cb-850e-1d218331e529"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Nearest", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphEmbedding", "[", "g", "]"}], " ", "->", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"7", ",", " ", "7"}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"m", " ", "->", " ", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraAntiderivative", "[", 
          RowBox[{
           RowBox[{"1", " ", "&"}], ",", " ", 
           RowBox[{"Method", " ", "->", " ", "m"}], ",", " ", 
           RowBox[{"\"\<Origin\>\"", " ", "->", " ", "c"}]}], "]"}], ",", 
         " ", "\"\<Function\>\""}], "]"}], "[", "q", "]"}]}], ",", "\n", 
     "    ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Zeta\>\"", ",", " ", "\"\<PathCount\>\"", ",", 
         " ", "\"\<BackwardRandomWalk\>\"", ",", " ", "\"\<UniformChain\>\"", 
         ",", " ", "\"\<ForwardRandomWalk\>\""}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"17297883-3ac9-4847-b53d-173cd84e3362"],

