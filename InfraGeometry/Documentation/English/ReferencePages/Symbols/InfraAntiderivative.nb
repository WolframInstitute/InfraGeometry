    }], "TableText",
     FontWeight->Bold,ExpressionUUID->"10f01c90-5e45-4982-aea7-cb533814b60d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1c850069-ba64-4047-9347-88dc28f431d4"], Cell[
    "directed acyclic graph", "TableText",ExpressionUUID->
     "c4643779-d509-453d-8eef-96acfe90b419"], Cell[TextData[{
     StyleBox["v", "TI"],
     " is reachable from ",
