Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dag", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "8", "]"}], ",", " ", 
       RowBox[{"DirectedEdge", " ", "@@@", " ", 
        RowBox[{"(", 
         RowBox[{"Sort", " ", "/@", " ", 
          RowBox[{"RandomSample", "[", 
           RowBox[{
            RowBox[{"Subsets", "[", 
             RowBox[{
              RowBox[{"Range", "[", "8", "]"}], ",", " ", 
              RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", "12"}], "]"}]}], 
         ")"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"Range", "[", "8", "]"}], ",", " ", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "9"}], ",", " ", "9"}], "}"}], ",", " ", "8"}], 
