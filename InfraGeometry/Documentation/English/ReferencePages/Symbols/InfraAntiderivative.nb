              RowBox[{"Range", "[", "8", "]"}], ",", " ", 
              RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", "12"}], "]"}]}], 
         ")"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
