Cell[TextData[{
 "The antiderivative of 1 from the centre: at each vertex ",
 StyleBox["v", "TI"],
 ", the number of vertices of the segment from the centre to ",
 StyleBox["v", "TI"],
 ". On the grid, away from the pendant vertices of the rim, it is ",
 StyleBox["(a + 1)(b + 1)", "TI"],
 ", with ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " the steps along the two axes:"
}], "ExampleText",ExpressionUUID->"a75f3e68-8838-407b-b614-b28d145b648f"],

