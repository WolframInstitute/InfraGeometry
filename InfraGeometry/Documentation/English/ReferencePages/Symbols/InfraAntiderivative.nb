Notebook[{

Cell[CellGroupData[{
Cell["InfraAntiderivative", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6569782c-cd9e-49a8-8470-5173ead71fcb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraAntiderivative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraAntiderivative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["f", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b85f820-cce4-4498-8023-dc6e3b2e8be2"],
 "\[LineSeparator]",
 "is the antiderivative of the vertex function ",
 StyleBox["f", "TI"],
 ": ",
 StyleBox["F(v) = \[CapitalSigma]_(u \[PrecedesEqual] v) f(u)", "TI"],
 ", the sum of ",
 StyleBox["f", "TI"],
 " over the past of each vertex. It is a symbolic object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c4a7fb2d-66ab-4275-a8dd-db7463f6bf4e"],
 " evaluates it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1d78f5d6-fcbf-4b1f-89e0-418760c18e7f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraAntiderivative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraAntiderivative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["f", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", 
     StyleBox["m", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "646d5cda-6990-4f65-8836-83b3466b4bdc"],
 "\[LineSeparator]",
 "accumulates ",
 StyleBox["f", "TI"],
 " through the kernel of the method ",
 StyleBox["m", "TI"],
 ": ",
 StyleBox["F(v) = \[CapitalSigma]_(u \[PrecedesEqual] v) f(u) K(u, v)", 
  "TI"],
 "."
}], "Usage",ExpressionUUID->"b02a5e13-057d-49d0-9b74-53fe6f40cddf"],

Cell[TextData[{
 "Definition: the antiderivative with kernel ",
 StyleBox["K", "TI"],
 " is ",
 StyleBox["(I_K f)(v) = \[CapitalSigma]_(u \[PrecedesEqual] v) f(u) K(u, v)", 
  "TI"],
 ", where ",
 StyleBox["K", "TI"],
 " is a function on the pairs ",
 StyleBox["u \[PrecedesEqual] v", "TI"],
 " of the order with ",
 StyleBox["K(v, v) = 1", "TI"],
 ", an element of its incidence algebra. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDerivative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDerivative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "56d536cf-89c6-40d0-91a6-4c71ffaa0a6a"],
 " is its exact inverse."
}], "Notes",ExpressionUUID->"dc172513-e5ce-4ef5-ab77-5bb559ff12a1"],

Cell["The order:", "Notes",ExpressionUUID->"da2ea9e9-1c71-4306-8fa2-a507fa085f2a"],

