Cell[TextData[{
 "Every method on the function 1, at a vertex two steps along each axis from \
the centre of the square grid. The segment to it is a 3 \[Times] 3 square \
with 6 shortest paths. ",
 Cell[BoxData["\"\<Volume\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e79dfef-f096-4100-80cd-265518b2cd2a"],
 " counts its 9 vertices, ",
 Cell[BoxData["\"\<Paths\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4370676b-0e3d-4541-8876-54106edebf68"],
 " counts each vertex once per shortest path from it, ",
 Cell[BoxData["\"\<Average\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb1ccd4c-a338-4033-8694-be5222578ad5"],
 " and ",
 Cell[BoxData["\"\<Uniform\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e304eef3-1315-406f-bf3a-80384351b288"],
 " give the 5 vertices of every shortest path, and ",
 Cell[BoxData["\"\<Flow\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3570ff04-33e1-4f6a-ad62-fafcab38c6da"],
 " the mass it holds when every vertex starts with 1 and passes what it holds \
on, evenly over its out-links."
}], "ExampleText",ExpressionUUID->"641d198d-59fe-4e2e-aafb-198031925d5c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"MaximalBy", "[", 
       RowBox[{
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", "4"}], "]"}], ",", 
           " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSegment", "[", 
            RowBox[{"c", ",", " ", "#"}], "]"}], ",", 
           " ", "\"\<Cardinality\>\""}], "]"}], " ", "&"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"m", " ", "->", " ", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraAntiderivative", "[", 
          RowBox[{
           RowBox[{"1", " ", "&"}], ",", " ", 
           RowBox[{"Method", " ", "->", " ", "m"}], ",", " ", 
           RowBox[{"\"\<Origin\>\"", " ", "->", " ", "c"}]}], "]"}], ",", 
         " ", "\"\<Function\>\""}], "]"}], "[", "q", "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Volume\>\"", ",", " ", "\"\<Paths\>\"", ",", 
         " ", "\"\<Average\>\"", ",", " ", "\"\<Uniform\>\"", ",", 
         " ", "\"\<Flow\>\""}], "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6a259b29-040e-4a67-88fd-f7cee9d1c720"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Volume\"\>", "\[Rule]", "9"}], ",", 
   RowBox[{"\<\"Paths\"\>", "\[Rule]", "19"}], ",", 
   RowBox[{"\<\"Average\"\>", "\[Rule]", "5"}], ",", 
   RowBox[{"\<\"Uniform\"\>", "\[Rule]", "5"}], ",", 
   RowBox[{"\<\"Flow\"\>", "\[Rule]", 
    FractionBox["61", "18"]}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9e776169-dd19-4e06-b973-261fb57d3de9"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<Future\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3d41b0b-574d-4903-8f9a-8920bcbdd920"],
 " accumulates over the future instead, the antiderivative on the reversed \
graph."
}], "ExampleText",ExpressionUUID->"25122572-7504-4862-919d-2d597ed5c033"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"dag", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
          RowBox[{"2", " ", "->", " ", "3"}], ",", " ", 
          RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
          RowBox[{"1", " ", "->", " ", "4"}], ",", " ", 
          RowBox[{"4", " ", "->", " ", "5"}], ",", " ", 
          RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
          RowBox[{"5", " ", "->", " ", "6"}]}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", 
          RowBox[{"-", "2"}], ",", " ", "7", ",", " ", "1", ",", " ", "3", ",",
           " ", 
          RowBox[{"-", "4"}]}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"dag", ",", " ", 
      RowBox[{"InfraAntiderivative", "[", 
       RowBox[{"f", ",", " ", 
        RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<Future\>\""}]}], 
       "]"}], ",", " ", "\"\<Function\>\""}], "]"}], " ", "===", " ", 
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{
      RowBox[{"ReverseGraph", "[", "dag", "]"}], ",", " ", 
      RowBox[{"InfraAntiderivative", "[", "f", "]"}], ",", 
      " ", "\"\<Function\>\""}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"88335946-f6e1-4ab5-97d6-253ec752d389"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"34c81056-19c8-4288-801b-d5da2d60bf36"]
}, Open  ]]
