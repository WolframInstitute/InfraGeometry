Cell["\<\
The kernel of the uniform-chain method on the diamond: from the bottom, each \
of the two chains to the top carries half.\
\>", "ExampleText",ExpressionUUID->"d52fa90d-92df-4a23-b654-edee88e38884"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Normal", " ", "@", " ", 
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    RowBox[{"Graph", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"2", " ", "->", " ", "4"}], ",", " ", 
        RowBox[{"3", " ", "->", " ", "4"}]}], "}"}]}], "]"}], ",", " ", 
    RowBox[{"InfraAntiderivative", "[", 
     RowBox[{
      RowBox[{"1", " ", "&"}], ",", " ", 
      RowBox[{"Method", " ", "->", " ", "\"\<UniformChain\>\""}]}], "]"}], ",",
     " ", "\"\<Kernel\>\""}], "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"009b87b1-9791-401c-9d44-6243c8efc61e"],

