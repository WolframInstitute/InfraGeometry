      "3405b15f-e0e7-4440-96dc-15505ca1327d"]
    }], "TableText",ExpressionUUID->"afe5f891-17d5-474c-b0ff-3d408ad1c965"], 
    Cell[TextData[{
     "the spray order, ",
     StyleBox["d(c, u) + d(u, v) = d(c, v)", "TI"]
    }], "TableText",ExpressionUUID->"c6b91079-e9d4-485c-a651-e5a7cd428fd0"], 
    Cell[TextData[{
     "the edges of ",
     Cell[BoxData[
      RowBox[{
       TemplateBox[{
         Cell[
          TextData["SprayGraph"]], 
         "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
         "WolframInstitute/InfraGeometry Package Symbol"},
        "PackageLink",
        BaseStyle->"InlineFormula"], "[", 
       RowBox[{
        StyleBox["g", "TI"], ",", " ", 
        StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e8324449-d10a-46ff-b8ef-9fd40abe5293"]
    }], "TableText",ExpressionUUID->"99fed415-4519-4111-8ed0-067017539115"]}
  }]], "3ColumnTableMod",ExpressionUUID->"8253c536-6b69-4c1b-8762-\
7f40fcec1e9c"],

Cell[TextData[{
 "On a directed acyclic graph everything reads the links, so adding an \
implied edge changes nothing. From an origin the intervals of the order are \
the segments: ",
 StyleBox["u \[PrecedesEqual] v", "TI"],
 " exactly when ",
 StyleBox["u", "TI"],
 " lies on a shortest path from ",
 StyleBox["c", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ". Vertices that ",
 StyleBox["c", "TI"],
 " does not reach are left out."
}], "Notes",ExpressionUUID->"303ca2d2-932b-4262-86c9-dce15e92a194"],

Cell[TextData[{
 StyleBox["f", "TI"],
 " is a 0-form: an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8bf1582d-9b6e-453f-a884-f4e16377be9d"],
 " ",
 StyleBox["v", "TI"],
 " -> ",
 StyleBox["x", "TI"],
 ", in which a missing vertex counts as 0, or a function applied to each \
vertex. A head with a ",
 Cell[BoxData["\"\<Function\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e2fae7a-6419-4359-a289-582d0a9d6610"],
 " reading is read through it."
}], "Notes",ExpressionUUID->"66cd9779-1618-445e-aad0-ccc386caea22"],

