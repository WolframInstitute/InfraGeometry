      FontSize->0.9 Inherited,ExpressionUUID->
      "b127e9db-88b6-4a37-8568-067f49bc9144"]
    }], "TableText",ExpressionUUID->"18893a6a-ef5c-416b-b89f-332fdc0d7dea"]},
   {Cell[TextData[Cell[BoxData["\"\<PathCount\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1cd5f79a-b8e7-4e52-bd56-ccd966daf7a1"]], "TableText",ExpressionUUID->
     "21fd8ddf-10f1-47a9-88e1-a28122e79383"], Cell[TextData[{
     "the number of chains from ",
     StyleBox["u", "TI"],
     " to ",
     StyleBox["v", "TI"]
    }], "TableText",ExpressionUUID->"e3de4e79-c76b-4330-b581-e92bb48fc87e"], 
    Cell[TextData[StyleBox[
    "W = 1", "TI"]], "TableText",ExpressionUUID->
     "72ec9d85-2a91-46fc-8e35-f7bfccd2fc9c"], Cell[TextData[{
     "the sum of ",
     StyleBox["f(u)", "TI"],
     " times the number of chains from ",
     StyleBox["u", "TI"],
     " to ",
     StyleBox["v", "TI"]
    }], "TableText",ExpressionUUID->"2574571d-ae42-48a8-84ed-b9d0548313b4"]},
   {Cell[TextData[Cell[
    BoxData["\"\<BackwardRandomWalk\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "42c5421f-3d00-4f15-a9da-8482bbb0dfaa"]], "TableText",ExpressionUUID->
     "5a0f1289-222d-479f-b933-00254bb0b74b"], Cell[TextData[{
     "the probability that the backward random walk from ",
     StyleBox["v", "TI"],
     ", each step to a uniformly random predecessor, visits ",
