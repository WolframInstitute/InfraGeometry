Cell["\<\
The antiderivative reads the order, not its encoding: the transitive closure \
gives the same function.\
\>", "ExampleText",ExpressionUUID->"f87c9be6-1cfd-458d-9774-95926efd246a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"dag", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
          RowBox[{"2", " ", "->", " ", "3"}], ",", " ", 
          RowBox[{"1", " ", "->", " ", "4"}], ",", " ", 
          RowBox[{"4", " ", "->", " ", "5"}], ",", " ", 
          RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
          RowBox[{"5", " ", "->", " ", "6"}]}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", 
          RowBox[{"-", "2"}], ",", " ", "7", ",", " ", "1", ",", " ", "3", ",",
           " ", 
          RowBox[{"-", "4"}]}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"dag", ",", " ", 
        RowBox[{"InfraAntiderivative", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", 
        " ", "\"\<Function\>\""}], "]"}], " ", "===", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{
        RowBox[{"TransitiveClosureGraph", "[", "dag", "]"}], ",", " ", 
        RowBox[{"InfraAntiderivative", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", 
        " ", "\"\<Function\>\""}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Zeta\>\"", ",", " ", "\"\<PathCount\>\"", ",", 
         " ", "\"\<BackwardRandomWalk\>\"", ",", " ", "\"\<UniformChain\>\"", 
         ",", " ", "\"\<ForwardRandomWalk\>\""}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
