Cell[TextData[{
 "Every method on the function 1, at a vertex two steps along each axis from \
the centre of the square grid. The segment to it is a 3 \[Times] 3 square \
with 6 shortest paths. ",
 Cell[BoxData["\"\<Zeta\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "83bfec3d-c382-4193-b753-54dc06385f16"],
 " counts its 9 vertices, ",
 Cell[BoxData["\"\<PathCount\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05f9f874-7dda-4d1e-b89a-214d7842db34"],
 " counts each vertex once per shortest path from it, ",
 Cell[BoxData["\"\<BackwardRandomWalk\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d262285-96d6-42ed-8d60-ca828b30d61a"],
 " and ",
 Cell[BoxData["\"\<UniformChain\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5a3d31e-d068-4015-a203-96e57082f107"],
 " give the 5 vertices of every shortest path, and ",
 Cell[BoxData["\"\<ForwardRandomWalk\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd412f58-2cb8-429b-944a-cc4dadd9cd9d"],
 " the mass it holds when every vertex starts with 1 and passes what it holds \
on, evenly over its out-links."
}], "ExampleText",ExpressionUUID->"c8ec93b0-e3b4-459d-8128-9ed3b94ad264"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"MaximalBy", "[", 
       RowBox[{
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", "4"}], "]"}], ",", 
           " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSegment", "[", 
            RowBox[{"c", ",", " ", "#"}], "]"}], ",", 
           " ", "\"\<Cardinality\>\""}], "]"}], " ", "&"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"m", " ", "->", " ", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraAntiderivative", "[", 
          RowBox[{
           RowBox[{"1", " ", "&"}], ",", " ", 
           RowBox[{"Method", " ", "->", " ", "m"}], ",", " ", 
           RowBox[{"\"\<Origin\>\"", " ", "->", " ", "c"}]}], "]"}], ",", 
         " ", "\"\<Function\>\""}], "]"}], "[", "q", "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Zeta\>\"", ",", " ", "\"\<PathCount\>\"", ",", 
         " ", "\"\<BackwardRandomWalk\>\"", ",", " ", "\"\<UniformChain\>\"", 
         ",", " ", "\"\<ForwardRandomWalk\>\""}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8cf113c1-5d88-45f3-a278-15622efdbcc8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Zeta\"\>", "\[Rule]", "9"}], ",", 
   RowBox[{"\<\"PathCount\"\>", "\[Rule]", "19"}], ",", 
   RowBox[{"\<\"BackwardRandomWalk\"\>", "\[Rule]", "5"}], ",", 
   RowBox[{"\<\"UniformChain\"\>", "\[Rule]", "5"}], ",", 
   RowBox[{"\<\"ForwardRandomWalk\"\>", "\[Rule]", 
    FractionBox["61", "18"]}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"4864153d-0c73-42d7-9fa9-20b358c94955"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<Future\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f40133f4-2252-477d-9c8c-a65bc602e78d"],
 " accumulates over the future instead, the antiderivative on the reversed \
graph."
}], "ExampleText",ExpressionUUID->"8d7df8b1-0034-4f3c-80a2-83c8d738f6a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"dag", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
          RowBox[{"2", " ", "->", " ", "3"}], ",", " ", 
          RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
          RowBox[{"1", " ", "->", " ", "4"}], ",", " ", 
          RowBox[{"4", " ", "->", " ", "5"}], ",", " ", 
          RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
          RowBox[{"5", " ", "->", " ", "6"}]}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", 
          RowBox[{"-", "2"}], ",", " ", "7", ",", " ", "1", ",", " ", "3", ",",
           " ", 
          RowBox[{"-", "4"}]}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"dag", ",", " ", 
      RowBox[{"InfraAntiderivative", "[", 
       RowBox[{"f", ",", " ", 
        RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<Future\>\""}]}], 
       "]"}], ",", " ", "\"\<Function\>\""}], "]"}], " ", "===", " ", 
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{
      RowBox[{"ReverseGraph", "[", "dag", "]"}], ",", " ", 
      RowBox[{"InfraAntiderivative", "[", "f", "]"}], ",", 
      " ", "\"\<Function\>\""}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b8f40816-d8d5-4725-8c02-5b9b75dcfd53"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"93cb106b-a480-45bb-a819-8f8caeeb9223"]
}, Open  ]]
}, Open  ]],

