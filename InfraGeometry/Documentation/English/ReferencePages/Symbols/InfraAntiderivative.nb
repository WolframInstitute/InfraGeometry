}, Open  ]],

Cell["\<\
The forward random walk carries all the mass to the maximal elements.\
\>", "ExampleText",ExpressionUUID->"6f52421c-dabf-4e3d-b41c-db48b705adca"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "2", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dag", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "8", "]"}], ",", " ", 
       RowBox[{"DirectedEdge", " ", "@@@", " ", 
        RowBox[{"(", 
         RowBox[{"Sort", " ", "/@", " ", 
          RowBox[{"RandomSample", "[", 
           RowBox[{
            RowBox[{"Subsets", "[", 
             RowBox[{
              RowBox[{"Range", "[", "8", "]"}], ",", " ", 
              RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", "12"}], "]"}]}], 
         ")"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"Range", "[", "8", "]"}], ",", " ", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "9"}], "}"}], ",", " ", "8"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Total", " ", "@", " ", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"dag", ",", " ", 
          RowBox[{"InfraAntiderivative", "[", 
           RowBox[{"f", ",", " ", 
            RowBox[{"Method", " ", "->", " ", "\"\<ForwardRandomWalk\>\""}]}],
            "]"}], ",", " ", "\"\<Function\>\""}], "]"}], ",", " ", 
        RowBox[{"Pick", "[", 
         RowBox[{
          RowBox[{"Range", "[", "8", "]"}], ",", " ", 
          RowBox[{"VertexOutDegree", "[", "dag", "]"}], ",", " ", "0"}], 
         "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"Total", "[", "f", "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"64a7b9aa-27ad-4934-a33b-9fa945b53da8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"44", ",", "44"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"bdf558aa-0775-4884-9db2-2f0d56523242"]
