Notebook[{

Cell[CellGroupData[{
Cell["InfraAntiderivative", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2711ae32-9613-44e7-87b5-f74460f0bd0f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraAntiderivative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraAntiderivative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["f", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8867a5c-020b-450e-882e-734f7b4a7692"],
 "\[LineSeparator]",
 "is the antiderivative of the vertex function ",
 StyleBox["f", "TI"],
 ": ",
 StyleBox["F(v) = \[CapitalSigma]_(u \[PrecedesEqual] v) f(u)", "TI"],
 ", the sum of ",
 StyleBox["f", "TI"],
 " over the past of each vertex. It is a symbolic object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2546c42c-f309-459f-ba2f-305565d61aa9"],
 " evaluates it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c024202b-af90-4e7b-a626-af5882d001a6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraAntiderivative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraAntiderivative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["f", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", 
     StyleBox["m", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "988e253f-bfa6-491a-9753-866a432502f2"],
 "\[LineSeparator]",
 "accumulates ",
 StyleBox["f", "TI"],
 " through the kernel of the method ",
 StyleBox["m", "TI"],
 ": ",
 StyleBox["F(v) = \[CapitalSigma]_(u \[PrecedesEqual] v) f(u) K(u, v)", 
  "TI"],
 "."
}], "Usage",ExpressionUUID->"4c8f7d70-8ac6-4808-839f-cef8b5a252d1"],

Cell[TextData[{
 "Definition: the antiderivative with kernel ",
 StyleBox["K", "TI"],
 " is ",
 StyleBox["(I_K f)(v) = \[CapitalSigma]_(u \[PrecedesEqual] v) f(u) K(u, v)", 
  "TI"],
 ", where ",
 StyleBox["K", "TI"],
 " is a function on the pairs ",
 StyleBox["u \[PrecedesEqual] v", "TI"],
 " of the order with ",
 StyleBox["K(v, v) = 1", "TI"],
 ", an element of its incidence algebra. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDerivative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDerivative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3af81f11-6566-48f5-b2a7-83d34114b0a0"],
 " is its exact inverse."
}], "Notes",ExpressionUUID->"40ef1b8b-c216-41b6-9d48-57e5b95bd55a"],

Cell["The order:", "Notes",ExpressionUUID->"b4708fe7-6c6e-41d0-a098-872061212add"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "26f42c85-1a7c-44ef-a53f-a61779ac24fe"], Cell["Substrate", "TableText",
     FontWeight->Bold,ExpressionUUID->"161095de-c36a-4e8d-9f67-35701a1d165f"],
     Cell[TextData[{
     "Order ",
     StyleBox["u \[PrecedesEqual] v", "TI"]
    }], "TableText",
     FontWeight->Bold,ExpressionUUID->"f7630840-e9e8-4550-bb50-2635bf9290cf"],
     Cell[TextData[{
     "Links ",
     StyleBox["u \:22d6 v", "TI"]
    }], "TableText",
     FontWeight->Bold,ExpressionUUID->"feeeb0ed-9459-4f37-a5a2-66aacb82dd7d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5f5c3d8d-388c-4ba1-9899-53bcb4102ca0"], Cell[
    "directed acyclic graph", "TableText",ExpressionUUID->
     "a0474c93-bbe8-475a-a694-64b84f2725f5"], Cell[TextData[{
     StyleBox["v", "TI"],
     " is reachable from ",
     StyleBox["u", "TI"]
    }], "TableText",ExpressionUUID->"65dc50b0-8b93-4a3d-b561-c26f5a1a32ae"], 
    Cell[TextData[{
     "the edges of ",
     Cell[BoxData["TransitiveReductionGraph"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e6ab45b3-1229-40c3-b8d8-e517a2db15a0"]
    }], "TableText",ExpressionUUID->"1fe599b8-d19d-47cd-bcb2-e3f38fbc1044"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7e515679-696a-47a2-88cb-16547cc90c75"], Cell[TextData[{
     "undirected graph, ",
     Cell[BoxData[
      RowBox[{"\"\<Origin\>\"", " ", "->", " ", "c"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "928ed571-2ce7-4308-b349-0b83339e7417"]
    }], "TableText",ExpressionUUID->"9db9efae-e952-4fd4-bc3c-61d268368815"], 
    Cell[TextData[{
     "the spray order, ",
     StyleBox["d(c, u) + d(u, v) = d(c, v)", "TI"]
    }], "TableText",ExpressionUUID->"e5d516ef-f4f8-4fc8-bbe9-acc6f6c349fa"], 
    Cell[TextData[{
     "the edges of ",
     Cell[BoxData[
      RowBox[{
       TemplateBox[{
         Cell[
          TextData["SprayGraph"]], 
         "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
         "WolframInstitute/InfraGeometry Package Symbol"},
        "PackageLink",
        BaseStyle->"InlineFormula"], "[", 
       RowBox[{
        StyleBox["g", "TI"], ",", " ", 
        StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7bffb233-e61d-4c9e-88df-62bdebf26068"]
    }], "TableText",ExpressionUUID->"392895a8-36b1-4299-8d48-f4ec08b9b2e3"]}
  }]], "3ColumnTableMod",ExpressionUUID->"45291ec7-e2ad-40b1-b34c-\
a63821e6bd69"],

Cell[TextData[{
 "On a directed acyclic graph everything reads the links, so adding an \
implied edge changes nothing. From an origin the intervals of the order are \
the segments: ",
 StyleBox["u \[PrecedesEqual] v", "TI"],
 " exactly when ",
 StyleBox["u", "TI"],
 " lies on a shortest path from ",
 StyleBox["c", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ". Vertices that ",
 StyleBox["c", "TI"],
 " does not reach are left out."
}], "Notes",ExpressionUUID->"1eb5eded-eb23-444d-b059-bb358f7bfb5e"],

Cell[TextData[{
 StyleBox["f", "TI"],
 " is a 0-form: an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a66f1d5a-b5a7-47f7-b052-84598c550672"],
 " ",
 StyleBox["v", "TI"],
 " -> ",
 StyleBox["x", "TI"],
 ", in which a missing vertex counts as 0, or a function applied to each \
vertex. A head with a ",
 Cell[BoxData["\"\<Function\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "591c0c94-3901-4b01-beb4-8bd60a28ecf1"],
 " reading is read through it."
}], "Notes",ExpressionUUID->"fd92029e-db5a-490c-946b-bbc4e39d8f21"],

