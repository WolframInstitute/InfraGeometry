        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "9"}], ",", " ", "9"}], "}"}], ",", " ", "8"}], 
        "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
