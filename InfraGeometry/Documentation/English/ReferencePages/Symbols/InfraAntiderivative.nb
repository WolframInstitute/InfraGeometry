Cell["\<\
The forward random walk carries all the mass to the maximal elements.\
\>", "ExampleText",ExpressionUUID->"d405c3ef-1fb3-40fc-b74b-4d5bd35d6327"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "2", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dag", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "8", "]"}], ",", " ", 
       RowBox[{"DirectedEdge", " ", "@@@", " ", 
        RowBox[{"(", 
         RowBox[{"Sort", " ", "/@", " ", 
          RowBox[{"RandomSample", "[", 
           RowBox[{
            RowBox[{"Subsets", "[", 
             RowBox[{
              RowBox[{"Range", "[", "8", "]"}], ",", " ", 
              RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", "12"}], "]"}]}], 
         ")"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"Range", "[", "8", "]"}], ",", " ", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "9"}], "}"}], ",", " ", "8"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Total", " ", "@", " ", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"dag", ",", " ", 
          RowBox[{"InfraAntiderivative", "[", 
           RowBox[{"f", ",", " ", 
            RowBox[{"Method", " ", "->", " ", "\"\<ForwardRandomWalk\>\""}]}],
            "]"}], ",", " ", "\"\<Function\>\""}], "]"}], ",", " ", 
        RowBox[{"Pick", "[", 
         RowBox[{
          RowBox[{"Range", "[", "8", "]"}], ",", " ", 
          RowBox[{"VertexOutDegree", "[", "dag", "]"}], ",", " ", "0"}], 
         "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"Total", "[", "f", "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"8c08017a-cbe9-41f2-baac-5a0d9f3e5eae"],

