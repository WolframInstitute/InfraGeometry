      FontSize->0.9 Inherited,ExpressionUUID->
      "5e77154a-5219-470f-91c6-4376b9da0327"]
    }], "TableText",ExpressionUUID->"87c8e350-e06e-4242-b9b8-c520ec46db26"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5b40adb1-240c-41b9-960e-6fdca283d780"], Cell[TextData[{
     "undirected graph, ",
     Cell[BoxData[
      RowBox[{"\"\<Origin\>\"", " ", "->", " ", "c"}]], "InlineFormula",
