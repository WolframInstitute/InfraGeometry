Cell[TextData[{
 "The zeta and the path-count antiderivative of a function on the diamond ",
 StyleBox["1 < 2, 3 < 4", "TI"],
 ". They differ at the top, which two chains join to the bottom."
}], "ExampleText",ExpressionUUID->"a3d457e2-0355-4bf7-82c6-b0c6e886ee69"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"diamond", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
          RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
          RowBox[{"2", " ", "->", " ", "4"}], ",", " ", 
          RowBox[{"3", " ", "->", " ", "4"}]}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"2", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
        RowBox[{"4", " ", "->", " ", "7"}]}], "|>"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"Normal", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"diamond", ",", " ", 
        RowBox[{"InfraAntiderivative", "[", "f", "]"}], ",", 
        " ", "\"\<Function\>\""}], "]"}], ",", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"diamond", ",", " ", 
        RowBox[{"InfraAntiderivative", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<PathCount\>\""}]}], "]"}], ",",
         " ", "\"\<Function\>\""}], "]"}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4a56caff-6bf4-4361-a4f8-9f2fc56cba05"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "\[Rule]", "2"}], ",", 
     RowBox[{"2", "\[Rule]", "5"}], ",", 
     RowBox[{"3", "\[Rule]", "7"}], ",", 
     RowBox[{"4", "\[Rule]", "17"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "\[Rule]", "2"}], ",", 
     RowBox[{"2", "\[Rule]", "5"}], ",", 
     RowBox[{"3", "\[Rule]", "7"}], ",", 
     RowBox[{"4", "\[Rule]", "19"}]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d6c78ac1-bf3e-4e62-a0b4-af551f343f98"]
}, Open  ]],

Cell["\<\
The zeta antiderivative of 1 from the centre of the discretized plane, the \
square grid and the hexagonal tiling: the number of vertices of the segment \
from the centre to each vertex.\
\>", "ExampleText",ExpressionUUID->"109c4012-671b-4670-998e-275e2aa48ea6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraAntiderivative", "[", 
             RowBox[{
              RowBox[{"1", " ", "&"}], ",", " ", 
              RowBox[{"\"\<Origin\>\"", " ", "->", " ", "c"}]}], "]"}], ",", 
            " ", "\"\<Function\>\""}], "]"}], ",", " ", "c"}], "}"}]}], 
       "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"17b069e0-66ae-4066-bf8b-268f8e88fd67"],

