Cell[TextData[{
 "Every method but ",
 Cell[BoxData["\"\<Zeta\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46fe3f6d-8249-446b-9e32-5f3fe0b833d6"],
 " is a path kernel ",
 StyleBox["K = (1 \[Minus] W)^(\[Minus]1)", "TI"],
 ": ",
 StyleBox["K(u, v)", "TI"],
 " sums, over the chains from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ", the product of a weight ",
 StyleBox["W", "TI"],
 " on their links, and ",
 StyleBox["F(v) = f(v) + \[CapitalSigma]_(u \:22d6 v) W(u, v) F(u)", "TI"],
 "."
}], "Notes",ExpressionUUID->"00c45dd5-0e2f-47cd-b83d-b044206730e3"],

