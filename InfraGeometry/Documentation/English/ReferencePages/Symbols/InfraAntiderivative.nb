     "dc855c91-bf88-4a35-863a-9db594c8dceb"], Cell[TextData[{
     "the probability that the forward random walk from ",
     StyleBox["u", "TI"],
     ", each step to a uniformly random successor, visits ",
     StyleBox["v", "TI"]
    }], "TableText",ExpressionUUID->"54909491-592e-470b-8997-8e24f779e800"], 
    Cell[TextData[StyleBox[
    "W(u, v) = 1 / outdeg(u)", "TI"]], "TableText",ExpressionUUID->
     "bab94e80-b7a1-4356-b47f-ae5efb9be325"], Cell[TextData[{
     "the mass of ",
     StyleBox["f", "TI"],
     " reaching ",
     StyleBox["v", "TI"],
