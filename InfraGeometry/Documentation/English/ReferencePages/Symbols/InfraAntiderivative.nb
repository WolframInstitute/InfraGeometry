Cell[TextData[{
 "Every method but ",
 Cell[BoxData["\"\<Volume\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb46b79a-14ec-4dde-99fa-ad2c2cf47bf5"],
 " is a path kernel ",
 StyleBox["K = (1 \[Minus] W)^(\[Minus]1)", "TI"],
 ": ",
 StyleBox["K(u, v)", "TI"],
 " sums, over the chains from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ", the product of a weight ",
 StyleBox["W", "TI"],
 " on their links, and ",
 StyleBox["F(v) = f(v) + \[CapitalSigma]_(u \:22d6 v) W(u, v) F(u)", "TI"],
 "."
}], "Notes",ExpressionUUID->"21fc07a2-9d16-4012-9fe4-2569fbafe991"],

