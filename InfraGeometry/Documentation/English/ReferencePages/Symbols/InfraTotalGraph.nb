 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"37fab498-a636-4fa5-9394-2d807019cdb8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTotalGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTotalGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
