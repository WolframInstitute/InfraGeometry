Cell["\<\
The rays of the tangent bundle over the base vertex 6, drawn around their \
base point.\
\>", "ExampleText",ExpressionUUID->"acb509a6-beae-4c03-a8c7-d60193e3c003"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", " ", "@", " ", 
      RowBox[{"InfraFiberedSubstrate", "[", 
       RowBox[{"\"\<GridTangentBundle\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"total", ",", " ", 
     RowBox[{"{", 
      RowBox[{"InfraDensity", "[", 
       RowBox[{"total", ",", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"VertexList", " ", "@", " ", "total"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"First", " ", "@", " ", "#"}], " ", "==", " ", "6"}], " ",
            "&"}]}], "]"}]}], "]"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"eb6b5e69-c8a5-44aa-9927-43b5f4b9e595"],

