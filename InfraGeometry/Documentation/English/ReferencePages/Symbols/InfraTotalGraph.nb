  FontSize->0.9 Inherited,ExpressionUUID->
  "27aac1d0-8a6d-4871-af31-c37693865e76"],
 "\[LineSeparator]",
 "gives the total graph of the fibration ",
 StyleBox["fib", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"38dfecb9-89ee-47e9-ad03-c24e0322709e"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTotalGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTotalGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "261f2386-ffd9-40e7-8f4c-8c443eb639a5"],
 " is one of the two primitives of a fibration; the other is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibrationAssociation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationAssociation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "74b04219-e146-4092-9afb-5a394f53e47a"],
 ". Every other function of the Infra Fiber Bundles guide is written over \
these two."
}], "Notes",ExpressionUUID->"f73cbf73-6f31-40bf-bc5a-addfe07d7ef5"],

Cell[TextData[{
 "For a literal ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFibration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["total", "TI"], ",", " ", 
    StyleBox["proj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "789d42f6-62cf-40e7-9aea-1be348516a1a"],
 " it is ",
 StyleBox["total", "TI"],
 ". For a construction it is computed: the rays of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTangentBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTangentBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f26d7964-687c-44f0-a3a0-0079c2c1bf1e"],
 ", the reversed rays of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCotangentBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCotangentBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "65ba728e-8823-4364-b998-0c6fb56d0fa3"],
 ", the pairs of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDisplacementBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "56fce9e1-f198-4952-b7e3-761fcea5bb89"],
 "."
}], "Notes",ExpressionUUID->"f7f02d67-aa7c-40ed-846e-dd9d12661aad"],

