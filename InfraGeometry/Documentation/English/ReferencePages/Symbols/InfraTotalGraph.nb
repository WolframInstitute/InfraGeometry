Cell[TextData[{
 "The total graph of a fibered graph is the graph ",
 StyleBox["E", "TI"],
 " whose vertices the projection ",
 StyleBox["\[Pi]", "TI"],
 " sends to the base."
}], "Notes",ExpressionUUID->"0b125751-a2c5-4610-bfa2-d419a1453641"],

