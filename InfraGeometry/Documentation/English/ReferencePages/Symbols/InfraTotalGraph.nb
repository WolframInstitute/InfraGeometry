Cell["InfraTotalGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"29b7b712-93f6-4a6d-add1-9f9e5ee654f4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTotalGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTotalGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60c9959f-abac-416a-9656-6a2652e38603"],
 "\[LineSeparator]",
 "gives the total graph of the fibration ",
 StyleBox["fib", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"cadabc91-d0b8-446c-bc64-25c6b2d45253"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTotalGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTotalGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "eca35dd8-d797-482f-8753-55ab1562469a"],
 " is one of the two primitives of a fibration; the other is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibrationAssociation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationAssociation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6e72be11-9ec5-4667-b4ae-984e96276ecc"],
 ". Every other function of the Infra Fiber Bundles guide is written over \
these two."
}], "Notes",ExpressionUUID->"da1f53d4-b44f-447d-8da2-05635de2d2f5"],

Cell[TextData[{
 "For a literal ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFibration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["total", "TI"], ",", " ", 
    StyleBox["proj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3db73aa1-8784-4fdf-bb64-6bd57528722b"],
 " it is ",
 StyleBox["total", "TI"],
 ". For a construction it is computed: the rays of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTangentBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTangentBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "651c1641-287c-4867-9caf-6c883978b6a2"],
 ", the reversed rays of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCotangentBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCotangentBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "270a09e2-fcfc-4cef-84c6-ffb969a32723"],
 ", the pairs of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDisplacementBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f4d5553c-19d0-473b-af97-8e376b9e3121"],
 "."
}], "Notes",ExpressionUUID->"16d08810-b82d-42fc-8aa9-83d80e2176cb"],

Cell["\<\
The total graph of a construction carries vertex coordinates: each total \
vertex is drawn near its base point, displaced towards the rest of its ray or \
pair.\
\>", "Notes",ExpressionUUID->"ba4987d3-e5d0-42ad-bda9-3f6a0bc1cc14"]
}, Open  ]],

