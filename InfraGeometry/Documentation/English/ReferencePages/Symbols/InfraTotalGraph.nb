          RowBox[{
           RowBox[{
            RowBox[{"First", " ", "@", " ", "#"}], " ", "==", " ", "6"}], " ",
            "&"}]}], "]"}]}], "]"}], "}"}]}], "]"}]}], "]"}]}], "Input",
