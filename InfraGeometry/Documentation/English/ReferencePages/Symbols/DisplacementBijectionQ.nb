Cell["\<\
Exchanging two vertices is a bijection. The centre of the grid and the vertex \
89:\
\>", "ExampleText",ExpressionUUID->"dfa6208a-50c5-48a7-9a4e-52a86f8c9128"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"swap", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"AssociationMap", "[", 
        RowBox[{"List", ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"c", " ", "->", " ", 
          RowBox[{"{", "89", "}"}]}], ",", " ", 
         RowBox[{"89", " ", "->", " ", 
          RowBox[{"{", "c", "}"}]}]}], "|>"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", "swap", ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"DisplacementBijectionQ", "[", "swap", "]"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"fe647705-9448-4534-b24f-6db103dbfb29"],

