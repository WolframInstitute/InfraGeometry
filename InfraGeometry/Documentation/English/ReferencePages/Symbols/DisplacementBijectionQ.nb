Cell["A bijection composed with its inverse is the identity.", "ExampleText",ExpressionUUID->"a77f01b4-ff81-44fe-b8a5-bd9e3140e89e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rotation", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"rotation", ",", " ", 
         RowBox[{"DisplacementInverse", "[", "rotation", "]"}]}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{
      RowBox[{"DisplacementCompose", "[", 
       RowBox[{"rotation", ",", " ", 
        RowBox[{"DisplacementInverse", "[", "rotation", "]"}]}], "]"}], " ", "===",
       " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{"List", ",", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"72991b80-4269-46d8-8b1c-c5d2c3a50f08"],

