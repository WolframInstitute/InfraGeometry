Cell["\<\
The rotation of the 12-cycle is a bijection. The step right of the 6 \[Times] \
6 grid is not: the right column moves to itself, and nothing moves to the \
left column.\
\>", "ExampleText",ExpressionUUID->"171e7ba7-5779-475a-8e1f-546901e0e43e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"cycle", " ", "=", " ", 
      RowBox[{"CycleGraph", "[", "12", "]"}]}], ",", " ", 
     RowBox[{"grid", " ", "=", " ", 
      RowBox[{"GridGraph", "[", 
       RowBox[{"{", 
        RowBox[{"6", ",", " ", "6"}], "}"}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rotation", " ", "=", " ", 
      RowBox[{"FindKillingDisplacement", "[", "cycle", "]"}]}], ",", " ", 
     RowBox[{"right", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"grid", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"DisplacementPlot", "[", 
         RowBox[{"cycle", ",", " ", "rotation"}], "]"}], ",", " ", 
        RowBox[{"DisplacementPlot", "[", 
         RowBox[{"grid", ",", " ", "right"}], "]"}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"DisplacementBijectionQ", "[", "rotation", "]"}], ",", " ", 
     RowBox[{"DisplacementBijectionQ", "[", "right", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9cc192fe-d8aa-4c05-96a7-4326a9be8fd3"],

