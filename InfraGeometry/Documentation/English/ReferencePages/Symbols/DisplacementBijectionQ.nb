Cell["\<\
A bijection composed with its inverse is the identity, in both orders:\
\>", "ExampleText",ExpressionUUID->"e5dbce6b-8892-4ead-9e99-fc2c99bbb054"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"swap", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"AssociationMap", "[", 
        RowBox[{"List", ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"c", " ", "->", " ", 
          RowBox[{"{", "89", "}"}]}], ",", " ", 
         RowBox[{"89", " ", "->", " ", 
          RowBox[{"{", "c", "}"}]}]}], "|>"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"identity", " ", "=", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{"List", ",", " ", 
       RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"DisplacementCompose", "[", 
      RowBox[{"swap", ",", " ", 
       RowBox[{"DisplacementInverse", "[", "swap", "]"}]}], "]"}], " ", "===",
      " ", "identity"}], " ", "&&", "\n", "    ", 
    RowBox[{
     RowBox[{"DisplacementCompose", "[", 
      RowBox[{
       RowBox[{"DisplacementInverse", "[", "swap", "]"}], ",", " ", "swap"}], 
      "]"}], " ", "===", " ", "identity"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8729345e-3446-43df-ba74-fe018740aa5d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"290def7b-3f58-46d6-a01b-cdfe9fd854eb"]
}, Open  ]],

Cell["\<\
A bijection need not be a symmetry. The exchange of the centre with the \
vertex 89 moves 8 steps and is not an automorphism:\
\>", "ExampleText",ExpressionUUID->"f46ea34c-33e4-4c73-b5a7-c57d7e25ce3d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"swap", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"AssociationMap", "[", 
        RowBox[{"List", ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"c", " ", "->", " ", 
          RowBox[{"{", "89", "}"}]}], ",", " ", 
         RowBox[{"89", " ", "->", " ", 
          RowBox[{"{", "c", "}"}]}]}], "|>"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementBijectionQ", "[", "swap", "]"}], ",", " ", 
     RowBox[{"DisplacementIsomorphismQ", "[", 
      RowBox[{"g", ",", " ", "swap"}], "]"}], ",", " ", 
     RowBox[{"DisplacementMagnitude", "[", 
      RowBox[{"g", ",", " ", "swap"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"cc05cac6-bf5e-4b00-a41b-3be05dc6a36b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"d346d068-0629-41d4-b0ed-c9983fbfa2ac"]
}, Open  ]]
}, Open  ]],

