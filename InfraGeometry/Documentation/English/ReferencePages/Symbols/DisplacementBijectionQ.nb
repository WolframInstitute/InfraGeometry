Cell["\<\
The step right is not a bijection, on the square grid or on the square mesh:\
\>", "ExampleText",ExpressionUUID->"0cd5d09f-4eb6-43fb-8962-91af4c6aad5a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"KeyValueMap", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name", ",", " ", "s"}], "}"}], " ", "|->", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"t", " ", "=", " ", 
         RowBox[{"TranslationDisplacement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", 
            RowBox[{"s", ",", " ", "0"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"DisplacementPlot", "[", 
        RowBox[{"g", ",", " ", "t", ",", " ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"DisplacementBijectionQ", "[", "t", "]"}]}]}], "]"}]}], 
      "]"}]}], ",", "\n", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<SquareGridGraph\>\"", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"\"\<SquareMeshGraph\>\"", " ", "->", " ", 
       RowBox[{"1", "/", "8"}]}]}], "|>"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7f6f674e-862f-4c4b-ade5-ed5e66c7b8e8"],

