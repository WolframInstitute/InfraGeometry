Cell[CellGroupData[{
Cell["DisplacementBijectionQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a7aa4a71-02fa-4fae-9dfe-7ae5a5087e59"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementBijectionQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementBijectionQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebfca100-dcea-4d94-b1b2-6d8acdabec5e"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3e0fa9e0-1d3d-4817-ae62-088e769b3344"],
 " when the displacement ",
 StyleBox["d", "TI"],
 " is single-valued and permutes the vertices, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6e483234-625f-4c02-9f77-8c675cd516db"],
 " otherwise.",
 "\n"
}], "Usage",ExpressionUUID->"451b8f60-7d48-43ce-931a-ca1286c11852"],

Cell[TextData[{
 "Definition: ",
 StyleBox["D", "TI"],
 " is a bijection when it is single-valued (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementSingleValuedQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementSingleValuedQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "79f8f804-10a3-4a65-acfe-30bd30e8c4d4"],
 ") and its values, taken together, are its keys, each exactly once."
}], "Notes",ExpressionUUID->"07f42c1e-a4dd-45f4-8ad8-c5108fcbc415"],

Cell[TextData[{
 "A bijection has an inverse map, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementInverse"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementInverse", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9334e089-6bc4-4f2e-918a-e61314ef72f2"],
 ", and composing the two in either order gives the identity. The test needs \
no graph: a bijection need not respect the edges. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementIsomorphismQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementIsomorphismQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "47dc03e1-45b9-4dd8-a676-d32793982173"],
 " asks for that too, and a bijection that is 1-continuous (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ContinuousDisplacementQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ContinuousDisplacementQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "81e92a17-c1f6-459a-81f5-9008c2052588"],
 ") is already an automorphism."
}], "Notes",ExpressionUUID->"6ccf037a-1585-4ca7-a7a9-daf1d03c3835"]
}, Open  ]],

