Cell["\<\
Exchanging the two ends of one edge of the cycle is a bijection of magnitude \
1, but not a symmetry of the cycle.\
\>", "ExampleText",ExpressionUUID->"c4118e39-398d-49e7-bad8-7c4aaa00d382"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"swap", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"AssociationMap", "[", 
        RowBox[{"List", ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", 
          RowBox[{"{", "2", "}"}]}], ",", " ", 
         RowBox[{"2", " ", "->", " ", 
          RowBox[{"{", "1", "}"}]}]}], "|>"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", "swap"}], "]"}], ",", " ", 
     RowBox[{"DisplacementBijectionQ", "[", "swap", "]"}], ",", " ", 
     RowBox[{"DisplacementMagnitude", "[", 
      RowBox[{"g", ",", " ", "swap"}], "]"}], ",", " ", 
     RowBox[{"DisplacementIsomorphismQ", "[", 
      RowBox[{"g", ",", " ", "swap"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3b20e640-5a18-4859-b696-ffc5d4163f8d"],

