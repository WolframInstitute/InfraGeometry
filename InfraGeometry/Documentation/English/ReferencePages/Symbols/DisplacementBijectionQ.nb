Cell["\<\
Of the 720 bijections of the hexagon, 20 move no vertex more than one step, \
and the 12 that are 1-continuous, drawn here, are exactly its 12 symmetries. \
A small magnitude does not make a symmetry; continuity does.\
\>", "ExampleText",ExpressionUUID->"3177745c-d082-4598-a832-24cdbecd7aa5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "6", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"bijections", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"Range", "[", "6", "]"}], ",", " ", 
         RowBox[{"List", " ", "/@", " ", "#"}]}], "]"}], " ", "&"}], " ", "/@",
       " ", 
      RowBox[{"Permutations", "[", 
       RowBox[{"Range", "[", "6", "]"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"continuous", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"bijections", ",", " ", 
       RowBox[{
        RowBox[{"ContinuousDisplacementQ", "[", 
         RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsGrid", "[", 
      RowBox[{"Partition", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"DisplacementPlot", "[", 
           RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
         "continuous"}], ",", " ", "6"}], "]"}], "]"}], ",", "\n", "   ", 
     RowBox[{"Count", "[", 
      RowBox[{"bijections", ",", " ", 
       RowBox[{"b_", " ", "/;", " ", 
        RowBox[{
         RowBox[{"DisplacementMagnitude", "[", 
          RowBox[{"g", ",", " ", "b"}], "]"}], " ", "<=", " ", "1"}]}]}], 
      "]"}], ",", " ", 
     RowBox[{"Length", "[", "continuous", "]"}], ",", " ", 
     RowBox[{"Count", "[", 
      RowBox[{"continuous", ",", " ", 
       RowBox[{"b_", " ", "/;", " ", 
        RowBox[{"DisplacementIsomorphismQ", "[", 
         RowBox[{"g", ",", " ", "b"}], "]"}]}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5406a705-8a70-4b0b-8034-ab54049feb23"],

