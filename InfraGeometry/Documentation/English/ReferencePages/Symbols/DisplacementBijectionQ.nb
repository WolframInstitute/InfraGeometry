Cell[CellGroupData[{
Cell["DisplacementBijectionQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"41b67dd1-a03e-409d-ac22-e58f8a5fedb9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementBijectionQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementBijectionQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a2b68eb-8259-4cc4-b2b9-9d78c3915854"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5a2911b7-1025-400c-ae85-969561771af9"],
 " when the displacement ",
 StyleBox["d", "TI"],
 " is single-valued and permutes the vertices, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "010d80cf-c0f1-41a5-a882-3df121dde2e6"],
 " otherwise.",
 "\n"
}], "Usage",ExpressionUUID->"1e7a57b6-b568-432e-ba31-94b9f89468a7"],

Cell[TextData[{
 StyleBox["D", "TI"],
 " is a bijection when it is single-valued (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementSingleValuedQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementSingleValuedQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8e50a961-8a8c-413b-9805-d91b4c8908c7"],
 ") and its values, taken together, are its keys, each once."
}], "Notes",ExpressionUUID->"27a2164e-92fd-48b5-9b6d-ab1fad141d72"],

Cell[TextData[{
 "A bijection has an inverse map, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementInverse"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementInverse", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "012a8981-4407-45c1-ac05-30a51a32f692"],
 ", and both composites with it are the identity."
}], "Notes",ExpressionUUID->"b60eec01-9736-426c-b167-2bd4afe22564"],

Cell[TextData[{
 "The test needs no graph: a bijection need not respect the edges. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementIsomorphismQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementIsomorphismQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "07f314c0-7297-4870-997e-e4d7ccb0d0b7"],
 " asks for that too, and a 1-continuous bijection is already an automorphism \
(",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ContinuousDisplacementQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ContinuousDisplacementQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dfbd19bc-7461-4e34-bf8c-71b24b63be08"],
 ")."
}], "Notes",ExpressionUUID->"8da8823b-28d7-4011-95ec-6eda0a749eac"],

Cell["\<\
On a finite graph with a rim a translation is not a bijection: nothing \
arrives at one side.\
\>", "Notes",ExpressionUUID->"031309d6-ec7d-4e73-a39f-063b9be488a7"]
}, Open  ]],

