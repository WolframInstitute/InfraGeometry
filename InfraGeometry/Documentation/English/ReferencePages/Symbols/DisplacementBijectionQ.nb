Cell["\<\
The square torus has no rim, and its translation by one step is a bijection, \
drawn at a planar layout of the torus:\
\>", "ExampleText",ExpressionUUID->"49e84425-77bc-44cc-be4c-e31c4787fded"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"translation", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", "translation", ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"DisplacementBijectionQ", "[", "translation", "]"}]}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"58c8234b-bea4-4e7d-80ed-246ad23eb037"],

