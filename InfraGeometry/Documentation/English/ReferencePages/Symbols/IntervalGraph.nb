Cell[CellGroupData[{
Cell["IntervalGraph", "ObjectName",ExpressionUUID->"051500e0-6a98-4c54-8abc-b3a445a87517"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9cce03ed-7708-4be3-923f-aafc172644c8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["IntervalGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/IntervalGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce5819bc-10de-4022-8572-25d65354d324"],
 "\[LineSeparator]",
 "gives the directed acyclic graph whose source-to-sink paths are exactly the \
shortest paths from p to q.",
 "\n"
}], "Usage",ExpressionUUID->"3c63c9f4-08da-4e8c-990d-3f13724745de"],

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{"graph", ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "\"\<Graph\>\""}], "]"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "720a2ff6-447b-4b34-afbd-b42edaf3e5be"],
 "."
}], "Notes",ExpressionUUID->"fae20415-a8f4-4da0-b798-dbe397789311"],

Cell["\<\
More than two points give a list of consecutive interval DAGs, one for each \
piece of a polyline.\
\>", "Notes",ExpressionUUID->"540151c7-d5e8-4c72-a88e-76b0e656bdff"]
}, Open  ]],

