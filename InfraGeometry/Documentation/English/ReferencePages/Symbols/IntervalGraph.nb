Cell["IntervalGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"adcd9e5c-75d0-4c97-94f7-bab7eb39ba90"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["IntervalGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/IntervalGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb553011-e21a-4d84-86e9-9dc84417d714"],
 "\[LineSeparator]",
 "gives the directed acyclic graph whose source-to-sink paths are exactly the \
shortest paths from p to q.",
 "\n"
}], "Usage",ExpressionUUID->"6342a923-95e9-492d-91ad-b77f5efc1f46"],

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{"graph", ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "\"\<Graph\>\""}], "]"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7658aba5-4e3b-453b-951f-654af7065ac4"],
 "."
}], "Notes",ExpressionUUID->"e4ad37f1-ea44-4085-80fd-880fd1a2fb35"],

Cell["\<\
More than two points give a list of consecutive interval DAGs, one for each \
piece of a polyline.\
\>", "Notes",ExpressionUUID->"37723efb-0a5d-44a5-b1f7-be4ca5228067"]
}, Open  ]],

