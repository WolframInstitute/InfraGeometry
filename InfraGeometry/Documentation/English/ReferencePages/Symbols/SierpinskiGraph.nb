Notebook[{

Cell[CellGroupData[{
Cell["SierpinskiGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"adeaee62-567f-4769-b973-c6303878128e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SierpinskiGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SierpinskiGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["n", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff80dd28-7983-4508-aafa-b51dba037159"],
 "\[LineSeparator]",
 "gives the trivalent Sierpinski graph of generation ",
 StyleBox["n", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"8691d9dc-0d38-4b43-a20c-d3458879142c"],

Cell[TextData[{
 "Construction: generation 1 is the complete graph on four vertices, the \
tetrahedron. Generation ",
 StyleBox["n", "TI"],
 " cuts every corner of generation ",
 StyleBox["n", "TI"],
 " \[Minus] 1: each vertex becomes a triangle, and its three edges are \
attached to the three corners of the triangle. On a graph in which every \
vertex has degree 3 this is truncation, so every generation has degree 3 at \
every vertex."
}], "Notes",ExpressionUUID->"aa882344-b127-44aa-b39d-b55964c2deac"],

Cell[TextData[{
 "Generation ",
 StyleBox["n", "TI"],
 " has 4\[CenterDot]3^(",
 StyleBox["n", "TI"],
 " \[Minus] 1) vertices and 6\[CenterDot]3^(",
 StyleBox["n", "TI"],
 " \[Minus] 1) edges. Generation 2 is the truncated tetrahedron."
}], "Notes",ExpressionUUID->"e83e6ce6-97d8-406b-86fe-63b6b6062e7e"],

Cell[TextData[{
 "A vertex of generation ",
 StyleBox["n", "TI"],
 " is a pair {",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["i", "TI"],
 "}: ",
 StyleBox["v", "TI"],
 " a vertex of generation ",
 StyleBox["n", "TI"],
 " \[Minus] 1 and ",
 StyleBox["i", "TI"],
 " = 1, 2, 3 a corner of its triangle. Generation 1 has the vertices 1, 2, 3, \
4."
}], "Notes",ExpressionUUID->"61c98428-4a13-4675-a21d-11f1b6340bcb"],

Cell[TextData[{
 "The graph has no coordinates; its layout is the default. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a60c4203-47a6-4633-85b7-426a70f375ad"],
 " options are passed on to the graph, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph3D"]], "paclet:ref/Graph3D"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "27e52012-3fd0-461c-a408-95f9f9b1f655"],
 " draws it in space."
}], "Notes",ExpressionUUID->"c516f050-8f9f-4806-b70d-b6ccdf7d0fec"],

Cell[TextData[{
 "The graph differs from the substrate ",
 Cell[BoxData["\"\<SierpinskiTriangleGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "826d97ec-170c-409e-81ee-8f93f3cb0daa"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "07ba9c10-7161-40e2-8f12-dad9dacff1f6"],
 ", the mesh of the Sierpinski triangle, whose junctions have degree 4."
}], "Notes",ExpressionUUID->"775c6b28-aea3-4e6e-b404-74dc4389f759"]
}, Open  ]],

