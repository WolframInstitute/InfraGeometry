Cell[TextData[{
 "The number of vertices of generation ",
 StyleBox["n", "TI"],
 " is 4\[CenterDot]3^(",
 StyleBox["n", "TI"],
 " \[Minus] 1), and for ",
 StyleBox["n", "TI"],
 " = 1, \[Ellipsis], 6 the diameter is 2^",
 StyleBox["n", "TI"],
 " \[Minus] 1. Where both hold, the vertex count grows like the diameter to \
the power log 3 / log 2 \[TildeTilde] 1.585, the dimension of the Sierpinski \
triangle."
}], "ExampleText",ExpressionUUID->"c26aca2d-b93f-483b-82e1-bcb532399fcd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"sizes", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"GraphDiameter", "[", 
          RowBox[{"SierpinskiGraph", "[", "n", "]"}], "]"}], ",", " ", 
         RowBox[{"VertexCount", "[", 
          RowBox[{"SierpinskiGraph", "[", "n", "]"}], "]"}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListLogLogPlot", "[", 
      RowBox[{"sizes", ",", " ", 
       RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<diameter\>\"", ",", " ", "\"\<vertices\>\""}], 
         "}"}]}]}], "]"}], ",", " ", 
     RowBox[{"sizes", " ", "==", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"2", "^", "n"}], " ", "-", " ", "1"}], ",", " ", 
          RowBox[{"4", " ", 
           RowBox[{"3", "^", 
            RowBox[{"(", 
             RowBox[{"n", " ", "-", " ", "1"}], ")"}]}]}]}], "}"}], ",", " ", 
        
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "6"}], "}"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3f0b9893-6afe-4afd-8dae-b88690ec3ade"],

