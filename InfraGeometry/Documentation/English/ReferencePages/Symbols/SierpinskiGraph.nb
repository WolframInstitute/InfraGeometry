Cell[TextData[{
 "Every vertex has degree 3. The substrate ",
 Cell[BoxData["\"\<SierpinskiTriangleGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "604384ca-1454-497a-b03c-37b2c800d609"],
 " has vertices of degree 2 and 4."
}], "ExampleText",ExpressionUUID->"4798f274-aa6a-47ba-9920-5ebd905bf1e6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graphs", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"SierpinskiGraph", "[", "4", "]"}], ",", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"\"\<SierpinskiTriangleGraph\>\"", ",", 
         " ", "\"\<Small\>\""}], "]"}]}], "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", "graphs", "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Union", " ", "@", " ", 
        RowBox[{"VertexDegree", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ",
       "graphs"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"962249c2-ba14-49b8-9161-dbfe23d06d38"],

