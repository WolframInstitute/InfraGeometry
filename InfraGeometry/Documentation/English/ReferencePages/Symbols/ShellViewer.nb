Cell[TextData[{
 "The viewer draws the spheres of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f7b410d6-d5f7-43bf-ac04-016719221f8c"],
 " about a centre ",
 StyleBox["p", "TI"],
 " at radius ",
 StyleBox["r", "TI"],
 ". Clicking a vertex makes it the centre; the first centre is a random \
vertex."
}], "Notes",ExpressionUUID->"d55cbad1-00ab-42ce-9d1c-2b13cb636a65"],

