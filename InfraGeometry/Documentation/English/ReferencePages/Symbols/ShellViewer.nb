Cell["\<\
The viewer on the square grid. The seed fixes the first centre, here the \
centre of the grid, with the shell of radius 5 about it:\
\>", "ExampleText",ExpressionUUID->"6d44a9b9-0c3c-4515-a34f-e2b767a99a12"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BlockRandom", "[", 
  RowBox[{
   RowBox[{"ShellViewer", "[", 
    RowBox[{"InfraSubstrate", "[", 
     RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
      RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}], 
    "]"}], ",", "\n", "  ", 
   RowBox[{"RandomSeeding", " ", "->", " ", "26"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2d80aa74-f3ec-4c9c-8153-64b82d5fb3d6"],

