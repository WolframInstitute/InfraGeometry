Cell[CellGroupData[{
Cell["InfraFibrationAssociation", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"753e0acf-3e92-4654-90ca-e18cb2d63856"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFibrationAssociation"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationAssociation", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68d95d36-def2-45f6-ac39-06facfa757e9"],
 "\[LineSeparator]",
 "is the older name of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraProjection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraProjection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7944d553-7373-4ef1-bdb3-e972d5339eae"],
 ": the projection of ",
 StyleBox["fib", "TI"],
 " as an association from each total vertex to its base vertex.",
 "\n"
}], "Usage",ExpressionUUID->"c2ff0e1f-d517-45ae-8853-d14e94b68b91"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraProjection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraProjection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "67b1c82c-9db2-4535-981a-e382b5bc7bf2"],
 " in new code. Both names accept the same fibered graphs and give the same \
association. A function projection is evaluated at every vertex."
}], "Notes",ExpressionUUID->"1d644b4f-aca9-4053-8e62-fccfb6a08869"]
}, Open  ]],

