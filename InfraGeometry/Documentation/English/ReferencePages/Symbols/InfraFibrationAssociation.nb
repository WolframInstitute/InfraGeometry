Cell["The compatibility reader accepts a canonical fibered graph.", \
"ExampleText",ExpressionUUID->"3f5fb89d-15ba-478b-ac5c-0e25dc273aea"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}], ",", " ", 
       RowBox[{"vertex", " ", "|->", " ", 
        RowBox[{"Mod", "[", " ", 
         RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
      " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFibrationAssociation", "[", " ", "fib", " ", "]"}]}], " ", 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0ef07d69-f439-4e06-b9f4-8ffa22cce5d0"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "1"}], ",", 
   RowBox[{"2", "\[Rule]", "2"}], ",", 
   RowBox[{"3", "\[Rule]", "3"}], ",", 
   RowBox[{"4", "\[Rule]", "4"}], ",", 
   RowBox[{"5", "\[Rule]", "1"}], ",", 
   RowBox[{"6", "\[Rule]", "2"}], ",", 
   RowBox[{"7", "\[Rule]", "3"}], ",", 
   RowBox[{"8", "\[Rule]", "4"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c31b2dbc-8f48-4299-838f-f6c6ca4d2cb5"]
}, Open  ]]
}, Open  ]],

