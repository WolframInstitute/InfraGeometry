Cell["InfraFibrationAssociation", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"dc07146a-f01b-4b5b-91e9-6cab8c24ce46"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFibrationAssociation"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationAssociation", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b32815f-c633-4e40-96d0-1da0020a0867"],
 "\[LineSeparator]",
 "gives the projection of ",
 StyleBox["fib", "TI"],
 " as an association from each total vertex ",
 StyleBox["x", "TI"],
 " to the base vertex ",
 StyleBox["p", "TI"],
 " below it.",
 "\n"
}], "Usage",ExpressionUUID->"a2e4642d-963d-445c-8fd5-7c68ffc5c214"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibrationAssociation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationAssociation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3d2c36c1-7ffd-47d4-be01-b275e3171192"],
 " is one of the two primitives of a fibration; the other is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTotalGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTotalGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fbd22472-9db9-4205-969b-a2623702392b"],
 "."
}], "Notes",ExpressionUUID->"6c6fad30-7d0c-49d6-95f3-db14694da517"],

Cell["\<\
For a literal fibration given by a function, the function is evaluated on \
every vertex of the total graph.\
\>", "Notes",ExpressionUUID->"a7814553-2f91-42c9-ba42-f19da257d1f8"],

Cell["\<\
The tangent and displacement bundles project a ray or a pair to its first \
vertex. The cotangent bundle projects a reversed ray to its last vertex.\
\>", "Notes",ExpressionUUID->"4f1220e6-fc0d-4607-8cbf-d275126d7f33"]
}, Open  ]],

