Cell["\<\
The total vertices that project to the base vertex 6 of the grid tangent \
bundle.\
\>", "ExampleText",ExpressionUUID->"a4df0d9f-145b-45c7-834f-2f8e516fa185"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridTangentBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"total", " ", "=", " ", 
      RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], ",", " ", 
     RowBox[{"proj", " ", "=", " ", 
      RowBox[{"InfraFibrationAssociation", "[", "fib", "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"total", ",", " ", 
     RowBox[{"{", 
      RowBox[{"InfraDensity", "[", 
       RowBox[{"total", ",", " ", 
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"Select", "[", 
          RowBox[{"proj", ",", " ", 
           RowBox[{
            RowBox[{"#", " ", "==", " ", "6"}], " ", "&"}]}], "]"}]}]}], 
       "]"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b99bc827-be38-40fa-b972-45d9aaab5ade"],

