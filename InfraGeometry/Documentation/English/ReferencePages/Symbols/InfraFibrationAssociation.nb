Cell["\<\
The projection of the cycle of length 8 onto the cycle of length 4:\
\>", "ExampleText",ExpressionUUID->"5007e01e-4c6a-4429-a4c1-cdb02fc0a394"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraFibrationAssociation", " ", "@", " ", 
  RowBox[{"InfraFiberedGraph", "[", 
   RowBox[{
    RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
    RowBox[{"v", " ", "|->", " ", 
     RowBox[{"Mod", "[", 
      RowBox[{"v", ",", " ", "4", ",", " ", "1"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"906245fb-cc28-4ebf-bb27-43319524fcc1"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "1"}], ",", 
   RowBox[{"2", "\[Rule]", "2"}], ",", 
   RowBox[{"3", "\[Rule]", "3"}], ",", 
   RowBox[{"4", "\[Rule]", "4"}], ",", 
   RowBox[{"5", "\[Rule]", "1"}], ",", 
   RowBox[{"6", "\[Rule]", "2"}], ",", 
   RowBox[{"7", "\[Rule]", "3"}], ",", 
   RowBox[{"8", "\[Rule]", "4"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7056a741-a3f8-47a4-9bfc-61b3bb9f6845"]
}, Open  ]]
}, Open  ]],

