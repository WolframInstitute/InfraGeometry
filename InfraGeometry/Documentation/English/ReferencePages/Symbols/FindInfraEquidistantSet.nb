   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "64350bec-0e60-4658-b2d6-aaa9fadde473"],
 " is the same set as a symbolic object."
}], "Notes",ExpressionUUID->"3c99d5d0-6f4e-4248-bfa1-74a3f0c4290d"]
}, Open  ]],

