Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"27908db5-5efa-43bc-b7dd-540fb4773a92"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraEquidistantSet"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraEquidistantSet", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pn", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b43699d-64d3-4da7-8619-6117a424238a"],
 "\[LineSeparator]",
 "gives the sorted list of the vertices at equal distance from all the points \
",
 StyleBox["p\:1d62", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f336a2fd-48fe-424a-9b34-1369276564a0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraEquidistantSet"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraEquidistantSet", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pn", "TI"]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["lo", "TI"], ",", " ", 
      StyleBox["hi", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da4fc6fb-e201-4c79-a229-3fd3894303d3"],
 "\[LineSeparator]",
 "gives the vertices ",
 StyleBox["v", "TI"],
 " with ",
 StyleBox["lo \[LessEqual] d(p\:1d62, v) \[Minus] d(p\:1d62\:208a\:2081, v) \
\[LessEqual] hi", "TI"],
 " for each ",
 StyleBox["i", "TI"],
 "."
}], "Usage",ExpressionUUID->"1a086aeb-db9a-4b30-94de-84bccf017fbf"],

Cell[TextData[{
 "The equidistant set is ",
 StyleBox["E(p\:2081, \[Ellipsis], p\:2099) = {v : d(p\:2081, v) = \
\[Ellipsis] = d(p\:2099, v)}", "TI"],
 ", the intersection of the bisectors of consecutive points. For two points \
it is their bisector. For three points it is the set of the circumcentres: \
the centres of the circles through all three."
}], "Notes",ExpressionUUID->"f5b59edd-357b-4106-8380-be0bc55e9336"],

Cell["\<\
In the plane three points not on a line have one circumcentre. On a graph \
there can be none or several, at different radii.\
\>", "Notes",ExpressionUUID->"1a058a20-d121-427e-9d59-a7dfe0e2a30b"],

Cell["\<\
On a bipartite graph, such as the square grid, the set is empty when two of \
the points are at odd distance. The slab form thickens each bisector and \
catches the vertices next to the missing one.\
\>", "Notes",ExpressionUUID->"49c8dd0c-c3f9-47f0-a096-c170bdc491f5"],

