Cell["\<\
On the grid the only circumcentre is the centre. On the mesh there are three, \
at the radii 4, 3 and 5:\
\>", "ExampleText",ExpressionUUID->"9ff37157-5dc0-4c62-b247-d93aafbe7262"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
        "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
     
     RowBox[{"{", 
      RowBox[{"pts", " ", "=", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", "3", ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{"v", " ", "|->", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "v", ",", " ", "#"}], "]"}], " ", "&"}], 
         " ", "/@", " ", "pts"}]}], ",", " ", 
       RowBox[{"FindInfraEquidistantSet", "[", 
        RowBox[{"g", ",", " ", "pts"}], "]"}]}], "]"}]}], "]"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", 
       " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
