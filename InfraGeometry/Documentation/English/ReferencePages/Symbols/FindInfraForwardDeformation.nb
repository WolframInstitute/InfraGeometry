    StyleBox["g", "TI"], ",", " ", 
    StyleBox["family", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "661fecd3-3114-4282-8aaf-2b73b621d10a"],
 "\[LineSeparator]",
 "gives one vertex-list walk from the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraForwardDeformation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraForwardDeformation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5e805e9e-9de9-4a1a-bcb0-30974ea20ca2"],
 " family on ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"97bd52e2-d16c-401a-a902-644d11fb8e19"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraForwardDeformation"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraForwardDeformation", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
