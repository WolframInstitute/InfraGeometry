Cell["Enumeration agrees with the exact count:", "ExampleText",ExpressionUUID->"e219a2a1-211e-4bbb-9159-70c940cec0b7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "4", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"family", " ", "=", " ", 
     RowBox[{"InfraForwardDeformation", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"UpTo", "[", "2", "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Length", "[", 
     RowBox[{"FindInfraForwardDeformation", "[", 
      RowBox[{"g", ",", " ", "family", ",", " ", "All"}], "]"}], "]"}], " ", "==",
     " ", 
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"g", ",", " ", "family", ",", " ", "\"\<Cardinality\>\""}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"66b50faf-543b-488e-a142-9ab404df3660"],

Cell[BoxData["True"], "Output",
