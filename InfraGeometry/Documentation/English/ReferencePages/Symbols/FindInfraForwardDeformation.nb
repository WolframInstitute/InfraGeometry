Cell[CellGroupData[{
Cell["FindInfraForwardDeformation", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d1d2660e-5500-4c03-8037-f7268623351b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraForwardDeformation"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraForwardDeformation", 
