Cell["Both shortest routes around a square:", "ExampleText",ExpressionUUID->"6622a8bb-04cf-4de0-a8d4-43db2aa10a56"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "4", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"FindInfraForwardDeformation", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"InfraForwardDeformation", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", "0", "}"}]}], "]"}], ",", " ", "All"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e4b72628-c47d-4aed-9629-2a5e2e4050c2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "4", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"061f88c8-9ee9-4549-b115-44c5eac1774e"]
}, Open  ]],

Cell["The edge and the longer route across a triangle:", "ExampleText",ExpressionUUID->"a737020c-ca2f-4a25-962a-beca8c03de2b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "3", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"FindInfraForwardDeformation", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"InfraForwardDeformation", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"UpTo", "[", "1", "]"}]}], "]"}], ",", " ", "All"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6c190463-73d1-4ac7-9282-45155e796283"],

Cell[BoxData[
