 "."
}], "Usage",ExpressionUUID->"a818f363-1437-4324-9ffe-ef4aa47b6452"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomInfraIntersection", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"{", 
     RowBox[{"obj1", ",", " ", "obj2"}], "}"}], ",", " ", "count"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f7cab47-1423-4366-af80-dfbb441278ea"],
