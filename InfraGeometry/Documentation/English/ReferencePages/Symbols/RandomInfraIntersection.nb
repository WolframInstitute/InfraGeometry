 "\[LineSeparator]",
 "samples one point from the intersection of complete operand supports on \
graph ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1f026798-6753-4d4c-acd8-2d0f869e328e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraIntersection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraIntersection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraIntersection", "[", 
     RowBox[{
      StyleBox["obj1", "TI"], ",", " ", 
      StyleBox["obj2", "TI"]}], "]"}], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0aff730e-3538-43fb-8f1c-577563aa0dde"],
 "\[LineSeparator]",
 "requests ",
 Cell[BoxData["count"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d87bd491-c86f-4a0a-bfa4-1ed97d48c6d6"],
 " representatives. ",
