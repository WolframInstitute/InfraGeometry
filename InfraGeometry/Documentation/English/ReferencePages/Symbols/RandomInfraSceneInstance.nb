  }]], "3ColumnTableMod",ExpressionUUID->"c1db1e99-e0f5-47b5-b78e-\
d0f7051a368b"],

Cell[TextData[{
 "With deterministic construction callbacks, ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64388c7a-b1bb-4a7a-bb30-21255ff75aaa"],
 " gives deterministic descent, and ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d5df27a-3618-4625-a4b7-580aa3644243"],
 " with the default ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Automatic"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53bafc84-a45c-421d-98dc-278cc7cceb09"],
 " makes no random draw. Stochastic construction callbacks or explicit \
stochastic candidate ordering and pruning use the local scene stream."
}], "Notes",ExpressionUUID->"8357de6b-caac-4fed-8402-7446c323ea7d"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomSeeding", " ", "->", " ", "Automatic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5eb3a441-9aa0-47ff-8a23-db4b0ba1a0c6"],
 " freshly seeds each call. An integer or string gives a reproducible call; a \
saved ",
 Cell[BoxData["RandomGeneratorState"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3ade62c-97f2-41e3-8ecb-2d477fd82381"],
 " restores that state locally. ",
 Cell[BoxData["Inherited"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7cbed4a-85d0-4b12-9420-988c713c9397"],
 " uses a local snapshot of the current generator state. Every setting \
restores the outer random state afterward, so successive ",
 Cell[BoxData["Inherited"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "661e7fdb-30d3-4b10-a6f2-cd3cfd70f19f"],
 " calls can repeat."
}], "Notes",ExpressionUUID->"09327af3-095d-4bf3-8ad9-43dfd4f325f8"],

Cell[TextData[{
 "The seed applies once to the complete search, including random \
candidate-selection callbacks and nested geometry samplers. Counts, initial \
bindings and ",
 Cell[BoxData["\"\<Steps\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "464073db-1ab9-4df3-a318-78b071b3dfca"],
 " retain their existing meanings. A stochastic callback with ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c621e705-ef2f-48bb-ba33-32daf217a4a5"],
 " can prune the search; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5887d28-2d5f-44e6-95c0-473eddf58570"],
 " is exhaustive only for the retained tree."
}], "Notes",ExpressionUUID->"0a2a8b53-c231-4c6d-b7bb-acc1fae5e319"],

Cell[TextData[{
 "This follows Wolfram's ",
 ButtonBox["RandomInstance",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/RandomInstance.html"], 
    None}],
 " and ",
 ButtonBox["RandomSeeding",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/RandomSeeding.html"], 
    None}],
 " convention. Every named geometry sampler takes the same option."
}], "Notes",ExpressionUUID->"8b2d3b58-5a25-42b6-8793-5c034290c063"],

Cell[TextData[{
 "A function such as ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    RowBox[{"RandomSample", "[", 
     RowBox[{"#", ",", " ", 
      RowBox[{"UpTo", "[", "2", "]"}]}], "]"}], " ", "&"}], ")"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ad7722a-a8f1-4ad1-bbd1-96237b7d565b"],
 " keeps at most two candidate extensions at each construction. Failure then \
means failure in the retained tree. ",
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbbb845f-2efb-4887-82e0-31d3f50878fb"],
 " follows just one route, without backtracking, and is not accepted with ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4787c8f1-d5e7-426e-83d5-622dc8876eba"],
 "."
}], "Notes",ExpressionUUID->"0f288296-1578-4ca8-9850-020fe0940eec"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Steps\>\"", " ", "->", " ", "k"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2fa0d12-39a1-4ee3-a341-159b30c9ab79"],
 " returns partial bindings after the first ",
 StyleBox["k", "TI"],
 " steps. Assertions with unbound objects remain deferred; a partial binding \
need not have a complete extension. The third integer argument counts \
instances, not steps."
}], "Notes",ExpressionUUID->"a6c9e64b-41e1-4a5b-9a86-18ec395276ec"]
}, Open  ]],

