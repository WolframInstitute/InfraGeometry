Cell["\<\
The instances are the choices made: as many as the points at distance 2, \
weighted by their shortest paths.\
\>", "ExampleText",ExpressionUUID->"d224666a-682b-49c3-9920-2515ca012a65"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"pA", ",", " ", "pB", ",", " ", "seg1"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "pB", ",", " ", "seg1"}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "c", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"InfraDistance", "[", 
           RowBox[{"pA", ",", " ", "pB"}], "]"}], " ", "==", " ", "2"}], ",", 
         " ", 
         RowBox[{"seg1", " ", "==", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"pA", ",", " ", "pB"}], "]"}]}]}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"InfraMeasurement", "[", " ", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraShell", "[", " ", 
             RowBox[{"c", ",", " ", "2"}], " ", "]"}], ",", 
            " ", "\"\<VertexDensity\>\""}], " ", "]"}]}], ",", " ", "c"}], 
        "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"RandomInfraSceneInstance", "[", " ", 
        RowBox[{"scene", ",", " ", "g", ",", " ", "All"}], " ", "]"}]}], " ", 
      "===", " ", 
      RowBox[{"Total", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSegment", "[", 
            RowBox[{"c", ",", " ", "through"}], "]"}], ",", 
           " ", "\"\<Cardinality\>\""}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"through", ",", " ", 
           RowBox[{"Keys", " ", "@", " ", 
            RowBox[{"InfraMeasurement", "[", " ", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraShell", "[", " ", 
               RowBox[{"c", ",", " ", "2"}], " ", "]"}], ",", 
              " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], "}"}]}], 
        "]"}]}]}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"756d1c57-8ef6-40f3-9ad2-bff09a0a30d7"],

