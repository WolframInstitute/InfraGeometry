Cell[TextData[{
 "The scene has two steps, the points and then the segment. ",
 Cell[BoxData[
  RowBox[{"\"\<Steps\>\"", " ", "->", " ", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59a9fdfc-1953-4f21-82cf-6bdfa6b2f115"],
 " binds the points only, and gives the circle of radius 3:"
}], "ExampleText",ExpressionUUID->"6727c31e-ed78-474b-9bc9-a2bd818fd1e6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "pB", ",", " ", "ab"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "c", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"InfraDistance", "[", 
           RowBox[{"pA", ",", " ", "pB"}], "]"}], " ", "==", " ", "3"}], ",", 
         " ", 
         RowBox[{"ab", " ", "==", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"pA", ",", " ", "pB"}], "]"}]}]}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraSceneInstance", "[", 
        RowBox[{"#", ",", " ", "pB"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"RandomInfraSceneInstance", "[", 
       RowBox[{"scene", ",", " ", "g", ",", " ", "All", ",", " ", 
        RowBox[{"\"\<Steps\>\"", " ", "->", " ", "1"}]}], "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"points", ",", " ", "c"}], "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"scene", "[", "\"\<Steps\>\"", "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0bb883e0-2739-4029-b7f6-c39f5682977d"],

