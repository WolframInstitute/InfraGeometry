 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"037847c2-c626-4084-87b8-12ad8112684a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSceneInstance"]], 
