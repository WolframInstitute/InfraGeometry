Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4c689458-75b0-4294-888b-f28771be1457"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSceneInstance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSceneInstance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
