Cell["\<\
An inherited seed snapshots the ambient state without advancing it; repeated \
calls can return the same instance.\
\>", "ExampleText",ExpressionUUID->"7d8bfcd5-c30a-4c27-9d42-d88ffa4c85f8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "123", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "p", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", "p", "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", " ", "==", " ", 
         RowBox[{"InfraPoint", "[", "]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"instance", " ", "=", " ", 
     RowBox[{"RandomInfraSceneInstance", "[", 
      RowBox[{"scene", ",", " ", "g", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "Inherited"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"instance", " ", "===", " ", 
    RowBox[{"RandomInfraSceneInstance", "[", 
     RowBox[{"scene", ",", " ", "g", ",", " ", 
      RowBox[{"RandomSeeding", " ", "->", " ", "Inherited"}]}], "]"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a197f120-a993-4d72-b68d-c5503f6d47a8"],

