Cell["\<\
A point at distance 3 from the centre and the segment to it, one instance on \
the square grid and on the square mesh:\
\>", "ExampleText",ExpressionUUID->"1445ca30-ccc5-4e48-a44a-c29185391127"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"scene", " ", "=", " ", 
        RowBox[{"InfraScene", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"pA", ",", " ", "pB", ",", " ", "ab"}], "}"}], ",", "\n", 
          "      ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"pA", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "c", "]"}]}], ",", " ", 
            RowBox[{"pB", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{"InfraDistance", "[", 
              RowBox[{"pA", ",", " ", "pB"}], "]"}], " ", "==", " ", "3"}], ",",
             " ", 
            RowBox[{"ab", " ", "==", " ", 
             RowBox[{"InfraSegment", "[", 
              RowBox[{"pA", ",", " ", "pB"}], "]"}]}]}], "}"}]}], "]"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"instance", " ", "=", " ", 
        RowBox[{"RandomInfraSceneInstance", "[", 
         RowBox[{"scene", ",", " ", "g", ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraWalk", "[", 
           RowBox[{"InfraSceneInstance", "[", 
            RowBox[{"instance", ",", " ", "ab"}], "]"}], "]"}], ",", " ", "c",
           ",", " ", 
          RowBox[{"InfraSceneInstance", "[", 
           RowBox[{"instance", ",", " ", "pB"}], "]"}]}], "}"}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"6328702a-e168-488d-8009-13f231a4c1fb"],

