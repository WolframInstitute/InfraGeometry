Cell["\<\
A point, a second point at distance 2 from it, and the segment between them, \
solved on the square tiling: one instance per choice of the second point and \
of the shortest path to it. Their segments, summed, cover the ball of radius \
2.\
\>", "ExampleText",ExpressionUUID->"a1708bc5-6dc7-411d-8828-919adcca9ed2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"pA", ",", " ", "pB", ",", " ", "seg1"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "pB", ",", " ", "seg1"}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "c", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"InfraDistance", "[", 
           RowBox[{"pA", ",", " ", "pB"}], "]"}], " ", "==", " ", "2"}], ",", 
         " ", 
         RowBox[{"seg1", " ", "==", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"pA", ",", " ", "pB"}], "]"}]}]}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"solved", " ", "=", " ", 
     RowBox[{"RandomInfraSceneInstance", "[", " ", 
      RowBox[{"scene", ",", " ", "g", ",", " ", "All"}], " ", "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"InfraSceneInstance", "[", 
            RowBox[{"#", ",", " ", "seg1"}], "]"}], " ", "&"}], " ", "/@", 
