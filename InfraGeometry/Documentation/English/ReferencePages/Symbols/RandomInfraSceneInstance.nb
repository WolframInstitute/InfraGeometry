Cell[CellGroupData[{

Cell["NextVertexFunction", "ExampleSubsection",ExpressionUUID->"8250981b-bddc-4bcd-8b86-51ce06498de6"],

Cell[TextData[{
 "Keeping at most ",
 StyleBox["k", "TI"],
 " candidates at each construction prunes the search. The number of instances \
found, out of 28; with 2 candidates for the second point none is at distance \
3:"
}], "ExampleText",ExpressionUUID->"372688a6-fa16-4a30-b8de-4112d6c68cb3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "pB", ",", " ", "ab"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "c", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"InfraDistance", "[", 
           RowBox[{"pA", ",", " ", "pB"}], "]"}], " ", "==", " ", "3"}], ",", 
         " ", 
         RowBox[{"ab", " ", "==", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"pA", ",", " ", "pB"}], "]"}]}]}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"k", " ", "->", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"RandomInfraSceneInstance", "[", 
        RowBox[{
        "scene", ",", " ", "g", ",", " ", "All", ",", "\n", "      ", 
         RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"RandomSample", "[", 
             RowBox[{"#", ",", " ", 
              RowBox[{"UpTo", "[", "k", "]"}]}], "]"}], " ", "&"}], ")"}]}], ",",
          " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}]}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "10", ",", " ", "50", ",", " ", "96"}], 
        "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"81daa432-03e7-4442-9322-5565d5ca5e43"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"2", "\[Rule]", "0"}], ",", 
   RowBox[{"10", "\[Rule]", "3"}], ",", 
   RowBox[{"50", "\[Rule]", "18"}], ",", 
   RowBox[{"96", "\[Rule]", "28"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7828ad9f-0008-462a-ada7-fa7bc0b9daa4"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

