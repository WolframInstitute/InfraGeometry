Cell[TextData[{
 "An instance binds every object of the scene to a vertex, a vertex list or a \
member of its construction, so that every assertion holds. It is an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSceneInstance"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSceneInstance", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "282a21b0-9642-47aa-921a-2e0cba013980"],
 " and gives the value of an object ",
 StyleBox["x", "TI"],
 " as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSceneInstance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSceneInstance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["inst", "TI"], ",", " ", 
    StyleBox["x", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f725b92-317e-4f67-9527-d1c5dd0e94b8"],
 "."
}], "Notes",ExpressionUUID->"0f0c87d8-fa8f-48e6-a000-2a74f4f15e64"],

Cell[TextData[{
 "A construction is a family, so a scene has many instances. A segment gives \
one instance per shortest path, and so the instances of \"a point at distance \
",
 StyleBox["d", "TI"],
 " from ",
 StyleBox["c", "TI"],
 " and the segment to it\" are counted by ",
 StyleBox["\[CapitalSigma] C(c, v)", "TI"],
 " over the vertices ",
 StyleBox["v", "TI"],
 " at distance ",
 StyleBox["d", "TI"],
 ", with ",
 StyleBox["C(c, v)", "TI"],
 " the number of shortest paths."
}], "Notes",ExpressionUUID->"94a015bf-4e56-4e23-abf2-d437a68d73fb"],

Cell["\<\
The search binds one object at a time, checks each assertion as soon as its \
objects are bound, and backtracks from a dead end. The draw is not uniform \
over the instances.\
\>", "Notes",ExpressionUUID->"54e3776c-1d9f-40fe-9932-4005ed97973a"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db910245-01ea-414c-938d-c79ac4677a95"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17e05220-1e38-4552-97f2-f0dc6a808523"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a617d201-bd68-4b3a-bf3b-e6fc6736175c"],
 ". A scene with no instance gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0c1eaca-38d7-4870-aa36-3d81969ac30a"],
 "."
}], "Notes",ExpressionUUID->"fbed438a-0cbf-4bd7-99bb-2b217ded631f"],

