Cell["\<\
An inherited seed snapshots the ambient state without advancing it; repeated \
calls can return the same instance.\
\>", "ExampleText",ExpressionUUID->"cb2a2468-c917-4825-b1c7-bc589d3ce8c2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "123", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "p", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", "p", "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", " ", "==", " ", 
         RowBox[{"InfraPoint", "[", "]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"instance", " ", "=", " ", 
     RowBox[{"RandomInfraSceneInstance", "[", 
      RowBox[{"scene", ",", " ", "g", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "Inherited"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"instance", " ", "===", " ", 
    RowBox[{"RandomInfraSceneInstance", "[", 
     RowBox[{"scene", ",", " ", "g", ",", " ", 
      RowBox[{"RandomSeeding", " ", "->", " ", "Inherited"}]}], "]"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8e56bc2e-581f-4c83-b265-f7b0c5f865a4"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"0f5d0a99-31aa-40ac-8310-e23140967141"]
}, Open  ]]
