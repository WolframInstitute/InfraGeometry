   RowBox[{
    StyleBox["scene", "TI"], ",", " ", 
    StyleBox["graph", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30affbf9-56fa-41b8-9e98-84846df72729"],
 "\[LineSeparator]",
 "draws one admissible ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSceneInstance"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSceneInstance", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3b7bdcaf-2379-4673-933a-d56b414167c1"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7591b3ad-ecb8-4eb8-8b21-c84af26eb562"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSceneInstance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSceneInstance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["scene", "TI"], ",", " ", 
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "772e0935-fbcf-4f8a-b4b3-8df3b6d55ecd"],
 "\[LineSeparator]",
 "gives exactly ",
 StyleBox["n", "TI"],
 " distinct instances, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32a7ab78-242c-4f60-9846-7047fac25934"],
 " when fewer exist. ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fa254d6-22c4-4e91-b09c-bcc374df7d2e"],
 " gives at most ",
 StyleBox["n", "TI"],
 ". ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a298b340-f448-482f-ae74-76ba274f08c0"],
 " enumerates every instance in construction order when the construction and \
selection callbacks are deterministic.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1e314916-a353-482d-beb8-6db7ed2cae57"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSceneInstance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSceneInstance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["scene", "TI"], ",", " ", 
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["bindings", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d5c06de-06ef-409e-8a50-e35ca641204a"],
 "\[LineSeparator]",
 "fixes the given ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "875be0b4-fbc2-4374-ad4c-70f11bf2235a"],
 " of bindings. A count may precede ",
 StyleBox["bindings", "TI"],
 "."
}], "Usage",ExpressionUUID->"f11238b9-3dfb-46e1-b8dd-b13389eccd6f"],

Cell[TextData[{
 "The search extends one binding at a time, checks each assertion as soon as \
its objects are bound, and backtracks from a dead end. It stops when the \
requested number of distinct instances has been found. A count-less call with \
no admissible instance gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f9ceaab-5833-4b97-94c7-704778b1f8b5"],
 "."
}], "Notes",ExpressionUUID->"3933ed9b-2e04-4e31-a873-f2579c1115af"],

Cell["\<\
The default draw is not uniform over instances. Each visited construction \
enumerates its candidate family; the search avoids forming the full product \
of those families.\
\>", "Notes",ExpressionUUID->"9cebc021-6c0a-4a07-8b6c-4c3d3ba46b05"],

Cell["\<\
An object already bound is not constructed again. A partly fixed tuple \
construction keeps only tuples agreeing with its fixed entries.\
\>", "Notes",ExpressionUUID->"d73d803b-517c-40e0-bdd6-fb021cb64dad"],

