Notebook[{

Cell[CellGroupData[{
Cell["EquidistanceQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b09f2c32-f219-4bbb-ac44-81deb9125113"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["EquidistanceQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/EquidistanceQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43d078ae-fe1d-424d-8376-905be1087a23"],
 "\[LineSeparator]",
 "tests Tarski's equidistance ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    StyleBox["b", "TI"], "\[Congruent]", 
    StyleBox["c", "TI"], 
    StyleBox["d", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ca2b36f-c228-4411-b928-6bf9d48482e7"],
 ": whether ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["b", "TI"]}], ")"}], "\[LongEqual]", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["c", "TI"], ",", 
      StyleBox["d", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63a1df24-21b1-4290-bd9e-11644e0dbede"],
 " in ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"06833998-5b38-49b8-ab3c-56ee7ce6016c"],

Cell[TextData[{
 "Equidistance is the second primitive of Tarski's axiomatization, alongside \
betweenness (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BetweennessQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BetweennessQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3c857757-0245-48f2-9d0f-a51f4400c0e7"],
 "). It is a ",
 StyleBox["four-place",
  FontWeight->"Bold"],
 " relation on vertices \[LongDash] it compares two segments rather than \
describing one \[LongDash] and it is what does the work of congruence: Tarski \
has no separate congruence primitive, no motions, and no ruler."
}], "Notes",ExpressionUUID->"695d0405-8f98-43fd-95cf-511a938f65cf"],

Cell[TextData[{
 "On a graph it reduces to equality of graph distances, so it is cheap. What \
is not cheap, and not automatic, is that the axioms governing it hold: ",
 Cell[BoxData["TarskiCongruenceReflexivityQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b21b791-97f4-4d54-b266-b74a280540d3"],
 ", ",
 Cell[BoxData["TarskiCongruenceTransitivityQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9730ab2a-fe68-44e6-ae34-66b818efe5ea"],
 " and ",
 Cell[BoxData["TarskiCongruenceIdentityQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3bef47f-1107-4039-84e2-a4f766e3e770"],
 " test the three that concern equidistance alone, and ",
 Cell[BoxData["TarskiAxiomQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ecb195bc-0e56-4369-9a9a-0e40741e4be1"],
 " runs the whole dashboard."
}], "Notes",ExpressionUUID->"d170481f-ee6a-42fb-8bbb-39dc12b5afde"],

Cell[TextData[{
 "Because the graph metric takes only integer values, the equidistance \
classes are coarse: every pair at distance ",
 StyleBox["k", "TI"],
 " is congruent to every other. ",
 Cell[BoxData["TarskiEquidistanceClasses"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb06c520-f967-4e39-91a7-ee85641db511"],
 " returns that partition. This is the sharpest way in which a graph is not a \
Euclidean plane \[LongDash] there are only ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["diam",
     FontSlant->"Plain"], "(", 
    StyleBox["g", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539af51c-1e0e-4f7b-a13a-fffec9df91dc"],
 " congruence classes of segments, so congruence carries far less information \
than it does classically."
}], "Notes",ExpressionUUID->"c383562f-865c-452d-9e36-186b92b26b90"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"aad5b030-0f4d-41dd-a397-4f9e41dd7635"],

