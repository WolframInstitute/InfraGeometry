Notebook[{

Cell[CellGroupData[{
Cell["EquidistanceQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"23f778a3-23c6-430c-8609-4a934aac5eaa"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["EquidistanceQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/EquidistanceQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9843cf03-2607-4353-a464-770c4a94f8ca"],
 "\[LineSeparator]",
 "tests Tarski's equidistance ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    StyleBox["b", "TI"], "\[Congruent]", 
    StyleBox["c", "TI"], 
    StyleBox["d", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b5e3826-4fb0-4782-b824-4365f6957055"],
 ": whether ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["b", "TI"]}], ")"}], "\[LongEqual]", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["c", "TI"], ",", 
      StyleBox["d", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "369dfaad-41cf-46f2-ba7b-54a29d2ba940"],
 " in ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"42c5c4ef-a3ce-49b8-9ed0-91b920e13087"],

Cell[TextData[{
 "Equidistance is the second primitive of Tarski's axiomatization, alongside \
betweenness (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BetweennessQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BetweennessQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a9b78760-7a46-489d-85d2-168da1ad4b04"],
 "). It is a ",
 StyleBox["four-place",
  FontWeight->"Bold"],
 " relation on vertices \[LongDash] it compares two segments rather than \
describing one \[LongDash] and it is what does the work of congruence: Tarski \
has no separate congruence primitive, no motions, and no ruler."
}], "Notes",ExpressionUUID->"ca3ccadc-4472-4793-a2ef-ab29958b5faf"],

Cell[TextData[{
 "On a graph it reduces to equality of graph distances, so it is cheap. What \
is not cheap, and not automatic, is that the axioms governing it hold: ",
 Cell[BoxData["TarskiCongruenceReflexivityQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ca4588c-8e67-49ea-8327-7fcff7f217f7"],
 ", ",
 Cell[BoxData["TarskiCongruenceTransitivityQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53b73f54-d724-4746-9fd6-4dd4438f0d64"],
 " and ",
 Cell[BoxData["TarskiCongruenceIdentityQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "163730d8-60a1-4183-847c-be1a2008552e"],
 " test the three that concern equidistance alone, and ",
 Cell[BoxData["TarskiAxiomQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36e69045-b37b-44f3-9d54-f2254ade651f"],
 " runs the whole dashboard."
}], "Notes",ExpressionUUID->"84add851-565f-4dbc-972b-3f701eada074"],

Cell[TextData[{
 "Because the graph metric takes only integer values, the equidistance \
classes are coarse: every pair at distance ",
 StyleBox["k", "TI"],
 " is congruent to every other. ",
 Cell[BoxData["TarskiEquidistanceClasses"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d747fb26-5db7-4f5f-9fc5-dce0327e1b1b"],
 " returns that partition. This is the sharpest way in which a graph is not a \
Euclidean plane \[LongDash] there are only ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["diam",
     FontSlant->"Plain"], "(", 
    StyleBox["g", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e522472-786b-4f93-97f2-20334404ea53"],
 " congruence classes of segments, so congruence carries far less information \
than it does classically."
}], "Notes",ExpressionUUID->"7dc97cec-a9f0-4f1c-b52c-dc3d8b47f34c"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"44c2b6c9-20f1-4fb1-bb78-5d23a6ce4c7c"],

