Notebook[{

Cell[CellGroupData[{
Cell["EquidistanceQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"27f06c5c-5d3c-431a-b5e9-4866939cdb37"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["EquidistanceQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/EquidistanceQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1215e97b-88cd-433f-8e55-b13f2b70d2df"],
 "\[LineSeparator]",
 "tests Tarski's equidistance ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    StyleBox["b", "TI"], "\[Congruent]", 
    StyleBox["c", "TI"], 
    StyleBox["d", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92d6fdc6-beeb-4c0b-8f65-b871b0f4fe0a"],
 ": whether ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["b", "TI"]}], ")"}], "\[LongEqual]", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["c", "TI"], ",", 
      StyleBox["d", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "036495bc-0a98-4375-9a61-50271a7940b9"],
 " in ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"d6b57001-1b6b-4eef-a076-d35c95c7069f"],

Cell[TextData[{
 "Equidistance is the second primitive of Tarski's axiomatization, alongside \
betweenness (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BetweennessQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BetweennessQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a8105519-7514-40ce-b24e-c4d4485999ac"],
 "). It is a ",
 StyleBox["four-place",
  FontWeight->"Bold"],
 " relation on vertices \[LongDash] it compares two segments rather than \
describing one \[LongDash] and it is what does the work of congruence: Tarski \
has no separate congruence primitive, no motions, and no ruler."
}], "Notes",ExpressionUUID->"e2ce53ad-7f13-45a9-883e-13d8e87cec9f"],

Cell[TextData[{
 "On a graph it reduces to equality of graph distances, so it is cheap. What \
is not cheap, and not automatic, is that the axioms governing it hold: ",
 Cell[BoxData["TarskiCongruenceReflexivityQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e46aa17a-d41a-488f-aefa-aeac199ed8c9"],
 ", ",
 Cell[BoxData["TarskiCongruenceTransitivityQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "681bba7d-7e68-4f85-bee6-f84d534756d9"],
 " and ",
 Cell[BoxData["TarskiCongruenceIdentityQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b19fd569-eeab-4273-915a-823965ff7115"],
 " test the three that concern equidistance alone, and ",
 Cell[BoxData["TarskiAxiomQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b71b7507-2eac-45aa-8072-39e6a013654c"],
 " runs the whole dashboard."
}], "Notes",ExpressionUUID->"ad217d76-8d36-4e11-8960-c7aca2accc76"],

Cell[TextData[{
 "Because the graph metric takes only integer values, the equidistance \
classes are coarse: every pair at distance ",
 StyleBox["k", "TI"],
 " is congruent to every other. ",
 Cell[BoxData["TarskiEquidistanceClasses"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "abcfc41e-6d81-4413-ad39-8d8a31c12eef"],
 " returns that partition. This is the sharpest way in which a graph is not a \
Euclidean plane \[LongDash] there are only ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["diam",
     FontSlant->"Plain"], "(", 
    StyleBox["g", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c61cbd2-bcaa-46a0-a455-d66da8c1e9b7"],
 " congruence classes of segments, so congruence carries far less information \
than it does classically."
}], "Notes",ExpressionUUID->"ecd86da6-4e67-46e5-9e60-87ae71b288fb"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"f0c4315f-8b40-4466-89aa-4641680aa4ad"],

