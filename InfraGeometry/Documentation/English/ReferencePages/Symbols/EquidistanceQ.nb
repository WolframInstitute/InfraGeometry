Cell["\<\
Equidistance is symmetric in each pair and reflexive, so a segment is \
congruent to itself read either way.\
\>", "ExampleText",ExpressionUUID->"176eef34-af5e-47f9-99bd-942b7f27b27c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"EquidistanceQ", "[", 
      RowBox[{
      "g", ",", " ", "a", ",", " ", "b", ",", " ", "a", ",", " ", "b"}], 
      "]"}], ",", " ", 
     RowBox[{"EquidistanceQ", "[", 
      RowBox[{
      "g", ",", " ", "a", ",", " ", "b", ",", " ", "b", ",", " ", "a"}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"135953cd-fdbc-48bc-bd2a-b441875d488e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f0cdba20-2c6d-4fa8-9bef-065b43d4e920"]
}, Open  ]],

Cell["\<\
The congruence classes are the distance classes, so their number is the \
diameter rather than a continuum \[LongDash] on each substrate every pair at \
a given distance is congruent to every other.\
\>", "ExampleText",ExpressionUUID->"e1851a70-824f-4332-9266-0c26daee85aa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"Union", " ", "@", " ", 
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c"}], "]"}]}]}]}], "]"}]}], ",", "\n", 
    "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ad463a59-9620-403d-83ee-ed1e954409c0"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"SquareMeshGraph\"\>", "\[Rule]", "11"}], ",", 
   RowBox[{"\<\"SquareTilingGraph\"\>", "\[Rule]", "13"}], ",", 
   RowBox[{"\<\"HexagonalTilingGraph\"\>", "\[Rule]", "15"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"c3f1793c-c454-4c08-9aa5-0b16978fccc3"]
}, Open  ]],

Cell["\<\
Every vertex of the perpendicular bisector is, by definition, equidistant \
from the two points it bisects.\
\>", "ExampleText",ExpressionUUID->"a5918817-6980-4d0c-b36d-0fcd3593fd7a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "6"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"FindInfraBisectingHyperplane", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"EquidistanceQ", "[", 
       RowBox[{
       "g", ",", " ", "a", ",", " ", "#", ",", " ", "b", ",", " ", "#"}], 
       "]"}], " ", "&"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"f58cbd3a-8667-472f-8bce-562f1d536c7c"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"e6372d44-39ba-403a-9976-2bae63345c0c"]
}, Open  ]]
}, Open  ]],

