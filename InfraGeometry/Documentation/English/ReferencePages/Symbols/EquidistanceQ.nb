Notebook[{

Cell[CellGroupData[{
Cell["EquidistanceQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"14ac7f78-947a-4ee8-9f58-894a391c6db3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["EquidistanceQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/EquidistanceQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95e83c84-b6d8-4850-b8c6-34ff83a17fe7"],
 "\[LineSeparator]",
 "tests Tarski's equidistance ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], 
    StyleBox["b", "TI"], "\[Congruent]", 
    StyleBox["c", "TI"], 
    StyleBox["d", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c52f29e-f9d7-41db-9b90-6ea227894ea4"],
 ": whether ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["b", "TI"]}], ")"}], "\[LongEqual]", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["c", "TI"], ",", 
      StyleBox["d", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aaedb946-552a-4366-8bc0-e5fc7eef889e"],
 " in ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"87877736-c985-44d3-b563-4725ae546e0d"],

Cell[TextData[{
 "Equidistance is the second primitive of Tarski's axiomatization, alongside \
betweenness (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BetweennessQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BetweennessQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e9adc3fa-ffac-4d87-83d8-136caaad789d"],
 "). It is a ",
 StyleBox["four-place",
  FontWeight->"Bold"],
 " relation on vertices \[LongDash] it compares two segments rather than \
describing one \[LongDash] and it is what does the work of congruence: Tarski \
has no separate congruence primitive, no motions, and no ruler."
}], "Notes",ExpressionUUID->"f7c386c9-04a5-44ce-b13e-2046f99c0547"],

Cell[TextData[{
 "On a graph it reduces to equality of graph distances, so it is cheap. What \
is not cheap, and not automatic, is that the axioms governing it hold: ",
 Cell[BoxData["TarskiCongruenceReflexivityQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de526b5e-4e61-4c6a-b7cc-404a8a199a71"],
 ", ",
 Cell[BoxData["TarskiCongruenceTransitivityQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca4e5e93-7b5b-4ebb-b454-aaf30911ad40"],
 " and ",
 Cell[BoxData["TarskiCongruenceIdentityQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9663489-5a8c-451c-a5b7-e388638f6f1a"],
 " test the three that concern equidistance alone, and ",
 Cell[BoxData["TarskiAxiomQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3f0b0e4-0f44-41c6-b467-4c7853257394"],
 " runs the whole dashboard."
}], "Notes",ExpressionUUID->"8cc5fc70-842e-4d7b-82d7-a82c3995bab0"],

Cell[TextData[{
 "Because the graph metric takes only integer values, the equidistance \
classes are coarse: every pair at distance ",
 StyleBox["k", "TI"],
 " is congruent to every other. ",
 Cell[BoxData["TarskiEquidistanceClasses"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7098f10c-3960-43ec-9b1b-ef4fd97a7609"],
 " returns that partition. This is the sharpest way in which a graph is not a \
Euclidean plane \[LongDash] there are only ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["diam",
     FontSlant->"Plain"], "(", 
    StyleBox["g", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b09a99c6-2de7-492f-b358-6e6e0c83684a"],
 " congruence classes of segments, so congruence carries far less information \
than it does classically."
}], "Notes",ExpressionUUID->"9944c746-3f32-4a8e-ae5c-a5a08f162cac"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"d6381850-64c8-49a8-95ae-54fa7c213176"],

