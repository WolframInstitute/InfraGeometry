    "17", ",", "27", ",", "36", ",", "47", ",", "56", ",", "66", ",", "76", ",",
      "87"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"31dc5c46-fd28-49cc-90fc-ecd220433973"]
}, Open  ]],

