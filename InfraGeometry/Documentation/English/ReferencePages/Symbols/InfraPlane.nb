Cell["\<\
For an axis pair the plane is connected and is the only wall; for the \
diagonal pair no plane is connected, and there is no wall:\
\>", "ExampleText",ExpressionUUID->"27864a62-73f7-4f19-9a0f-7c2a671cb7d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"walls", " ", "=", " ", 
