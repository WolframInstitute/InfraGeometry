       "}"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"RandomInfraPlane", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraPlane", "[", 
         RowBox[{"45", ",", " ", "47"}], "]"}], ",", " ", "All"}], "]"}], " ",
