Cell["A wall and a plane in the slab {\[Minus]1, 1} on the mesh:", \
"ExampleText",ExpressionUUID->"0b4f2973-5975-45a5-8494-29994cdd9ee4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RandomInfraPlane", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraPlane", "[", 
             RowBox[{"a", ",", " ", "b", ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "]"}], ",", " ",
             "props", ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ",
           "a", ",", " ", "b"}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"props", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Properties", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], 
            "}"}]}], ",", " ", 
          RowBox[{"Properties", " ", "->", " ", 
           RowBox[{"{", "\"\<Separating\>\"", "}"}]}]}], "}"}]}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1af08ac4-17b3-47b0-8949-58005127dc99"],

