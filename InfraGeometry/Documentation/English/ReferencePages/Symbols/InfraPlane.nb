Cell["\<\
Two points on one axis of the grid. The bisector is the line between them; \
the plane, drawn over it, leaves out its two rim vertices, which have one \
neighbour each:\
\>", "ExampleText",ExpressionUUID->"3ddfafc0-6ff0-4a9e-a14d-1395ee561d4e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"bisector", " ", "=", " ", 
      RowBox[{"FindInfraBisectingHyperplane", "[", 
       RowBox[{"g", ",", " ", "45", ",", " ", "47"}], "]"}]}], ",", " ", 
     RowBox[{"planes", " ", "=", " ", 
      RowBox[{"RandomInfraPlane", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraPlane", "[", 
         RowBox[{"45", ",", " ", "47"}], "]"}], ",", " ", "All"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "bisector", ",", " ", "planes", ",", " ", "45", ",", " ", "47"}], "}"}],
      ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"68d51bac-949e-4010-a2ce-dd13fdb8b171"],

