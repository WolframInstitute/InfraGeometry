Cell["\<\
At odd distance on the grid no vertex is equidistant, and there is no plane; \
the window {\[Minus]1, 1} gives one:\
\>", "ExampleText",ExpressionUUID->"9807897f-5841-4e5a-bc83-eefef4ec6717"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"RandomInfraPlane", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraPlane", "[", 
        RowBox[{"45", ",", " ", "48"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"RandomInfraPlane", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraPlane", "[", 
        RowBox[{"45", ",", " ", "48", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"864618a1-e2ac-4db4-a7f1-643467e35427"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
