Cell[CellGroupData[{
Cell["InfraPlane", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d8354fa1-544c-415c-99a7-314b9a7dced9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPlane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPlane", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c03d1a74-75d9-4d42-aece-14bd2b386f87"],
 "\[LineSeparator]",
 "is the bisecting plane of ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ": the family of the minimal vertex sets equidistant from ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " that separate them.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"03c63cda-7fa2-478b-b03c-63738024c10b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPlane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPlane", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["lo", "TI"], ",", " ", 
      StyleBox["hi", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "118b5bc9-38e8-4752-94da-5ed29ad6eb17"],
 "\[LineSeparator]",
 "takes the vertices ",
 StyleBox["v", "TI"],
 " with ",
 StyleBox["lo \[LessEqual] d(p, v) \[Minus] d(q, v) \[LessEqual] hi", "TI"],
 " in place of the equidistant ones."
}], "Usage",ExpressionUUID->"0aaa5573-b950-4083-8e33-7b74b1866730"],

Cell[TextData[{
 "A member of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPlane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPlane", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17a447d5-df34-4b3d-9946-ff3576808162"],
 " is a vertex set ",
 StyleBox["H", "TI"],
 " in the bisector ",
 StyleBox["{v : d(p, v) = d(q, v)}", "TI"],
 " such that every path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " meets ",
 StyleBox["H", "TI"],
 ", and no smaller subset of ",
 StyleBox["H", "TI"],
 " does."
}], "Notes",ExpressionUUID->"70982000-2c1b-4575-b72d-cba91150f25c"],

Cell["\<\
In space the perpendicular bisector of two points is a hyperplane and cuts \
space into two half-spaces. On a graph the bisector can be thick, empty or \
not separating, so the plane is a thin separating part of it, and need not be \
unique.\
\>", "Notes",ExpressionUUID->"c75b13a0-882a-4253-a755-6b5fe571e27c"],

