Cell[TextData[{
 "A plane need not be connected. In the bisector ",
 StyleBox["B", "TI"],
 " without ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ", a wall is a set ",
 StyleBox["W \[SubsetEqual] B", "TI"],
 " that separates ",
 StyleBox["p", "TI"],
 " from ",
 StyleBox["q", "TI"],
 ", induces a connected subgraph, and has no proper subset that does both; a \
connected plane is a wall. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraPlane"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraPlane", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c787a1bd-120e-4dbe-845c-2757497d6753"],
 " with ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], "}"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9c92e66-6658-4187-83f3-16d658740b3a"],
 " draws walls instead of planes, by a greedy search."
}], "Notes",ExpressionUUID->"197540a6-2749-4340-b930-4a66ce4a44f2"],

