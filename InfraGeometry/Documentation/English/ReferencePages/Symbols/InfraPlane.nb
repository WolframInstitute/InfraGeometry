   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "928e6b42-5e5a-43ad-a42c-5ae89962800d"],
 " ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPlane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPlane", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef3f3f00-4852-4cf6-915e-190e11e31aad"],
 " is a construction whose realisations are the members. The whole bisector \
is ",
 Cell[BoxData[
  TemplateBox[{
