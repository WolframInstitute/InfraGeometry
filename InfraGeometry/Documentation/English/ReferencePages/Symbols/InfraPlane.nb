Cell["\<\
A plane between the centre and a vertex at distance 4. On the mesh the \
bisector does not separate, so the window is {\[Minus]1, 1}:\
\>", "ExampleText",ExpressionUUID->"bd03a083-5f6c-4fad-9d65-a799b84e07de"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", "spec"}], ",", " ", "\"\<Small\>\"",
           ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RandomInfraPlane", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraPlane", "[", 
             RowBox[{"a", ",", " ", "b", ",", " ", 
              RowBox[{"Last", " ", "@", " ", "spec"}]}], "]"}], ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ",
           "a", ",", " ", "b"}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"spec", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "}"}]}], "}"}]}], 
     "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c8eeadd0-e246-4503-bf53-b294e592c03c"],

