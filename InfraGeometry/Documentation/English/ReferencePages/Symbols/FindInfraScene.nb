           RowBox[{"pA", ",", " ", "2"}], "]"}]}], ",", " ", 
         RowBox[{"seg1", " ", "==", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"pA", ",", " ", "pB"}], "]"}]}]}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"First", " ", "@", " ", 
    RowBox[{"FindInfraScene", "[", 
     RowBox[{"scene", ",", " ", 
      RowBox[{"GridGraph", "[", 
       RowBox[{"{", 
        RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "]"}]}]}], 
  "]"}]}], "Input",
