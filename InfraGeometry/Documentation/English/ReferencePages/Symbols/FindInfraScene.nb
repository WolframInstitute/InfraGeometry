Cell["One instance, and its segment drawn.", "ExampleText",ExpressionUUID->"8380e485-009f-4a6b-b081-dc2b61e9be53"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"pA", ",", " ", "pB", ",", " ", "seg1"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "pB", ",", " ", "seg1"}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "c", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", 
           RowBox[{"pA", ",", " ", "2"}], "]"}]}], ",", " ", 
         RowBox[{"seg1", " ", "==", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"pA", ",", " ", "pB"}], "]"}]}]}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"instance", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FindInfraScene", "[", 
       RowBox[{"scene", ",", " ", "g"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraSceneInstance", "[", 
          RowBox[{"instance", ",", " ", "seg1"}], "]"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c"}],
         "}"}]}], "]"}], ",", " ", "instance"}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4ef8e929-da72-4f86-8edd-c10e3c3c8ce6"],

