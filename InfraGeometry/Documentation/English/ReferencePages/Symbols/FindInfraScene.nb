"ExampleText",ExpressionUUID->"8fbe045b-14f1-4937-bba5-79e0ffac4615"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"pA", ",", " ", "pB", ",", " ", "seg1"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "pB", ",", " ", "seg1"}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "c", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"InfraDistance", "[", 
           RowBox[{"pA", ",", " ", "pB"}], "]"}], " ", "==", " ", "2"}], ",", 
         " ", 
         RowBox[{"seg1", " ", "==", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"pA", ",", " ", "pB"}], "]"}]}]}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"segments", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraSceneInstance", "[", 
          RowBox[{"#", ",", " ", "seg1"}], "]"}], " ", "&"}], " ", "/@", " ", 
        
        RowBox[{"FindInfraScene", "[", 
         RowBox[{"scene", ",", " ", "g", ",", " ", 
          RowBox[{"\"\<PruneProbability\>\"", " ", "->", " ", "0.5"}]}], 
         "]"}]}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"segments", ",", " ", "c"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "segments"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"70018683-a15c-403a-99f0-65f5fda2d156"],

