Cell["\<\
A point, a second point two steps from it, and the segment between them, \
solved on a grid: eight choices of the second point and one or two geodesics \
to each, twelve instances in all. Their segments, summed, cover the ball of \
radius 2.\
\>", "ExampleText",ExpressionUUID->"1c482e88-1e0d-4566-9095-d28c4be117b0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"pA", ",", " ", "pB", ",", " ", "seg1"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "pB", ",", " ", "seg1"}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "41", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", 
           RowBox[{"pA", ",", " ", "2"}], "]"}]}], ",", " ", 
         RowBox[{"seg1", " ", "==", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"pA", ",", " ", "pB"}], "]"}]}]}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"solved", " ", "=", " ", 
       RowBox[{"FindInfraScene", "[", 
        RowBox[{"scene", ",", " ", "g"}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraSubstrateHighlight", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"InfraSceneInstance", "[", 
              RowBox[{"#", ",", " ", "seg1"}], "]"}], " ", "&"}], " ", "/@", 
            " ", "solved"}], ",", " ", 
           RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
           "41"}], "}"}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
       "     ", 
       RowBox[{"Length", " ", "@", " ", "solved"}]}], "}"}]}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6d31fa40-4bde-4757-aef5-bd44f1b335cf"],

