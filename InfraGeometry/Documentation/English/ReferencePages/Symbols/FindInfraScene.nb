Cell["\<\
The instances are the choices made: as many as the points at distance 2, \
weighted by their shortest paths.\
\>", "ExampleText",ExpressionUUID->"5ff6cb79-95d0-4029-b002-f53b9676a4e8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"pA", ",", " ", "pB", ",", " ", "seg1"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "pB", ",", " ", "seg1"}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "c", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", 
           RowBox[{"pA", ",", " ", "2"}], "]"}]}], ",", " ", 
         RowBox[{"seg1", " ", "==", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"pA", ",", " ", "pB"}], "]"}]}]}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"FindInfraShell", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}], ",", " ", "c"}],
         "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"FindInfraScene", "[", 
        RowBox[{"scene", ",", " ", "g"}], "]"}]}], " ", "===", " ", 
      RowBox[{"Total", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSegment", "[", 
            RowBox[{"c", ",", " ", "through"}], "]"}], ",", 
           " ", "\"\<Cardinality\>\""}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"through", ",", " ", 
           RowBox[{"FindInfraShell", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}]}], "}"}]}], 
        "]"}]}]}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6b68467e-83c8-4a5a-a1b1-7d0987a8639c"],

