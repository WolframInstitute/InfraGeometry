 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["EffectiveResistance"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/EffectiveResistance", 
    "WolframInstitute/InfraGeometry Package Symbol"},
