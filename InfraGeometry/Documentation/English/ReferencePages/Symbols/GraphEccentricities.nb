Cell["\<\
The level sets of the eccentricity on the square, hexagonal and triangular \
tilings, each in its own colour, and the least and the largest value, the \
radius and the diameter.\
\>", "ExampleText",ExpressionUUID->"1df047f6-7649-4d80-a298-a88399c7f2a8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"panels", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "       ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
             RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
            "]"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{"eccentricities", " ", "=", " ", 
           RowBox[{"AssociationThread", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
             RowBox[{"GraphEccentricities", "[", "g", "]"}]}], "]"}]}], "}"}],
          ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraSubstrateHighlight", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"AssociationThread", "[", 
                RowBox[{"#", ",", " ", "1"}], "]"}], " ", "&"}], " ", "/@", 
              " ", 
              RowBox[{"Values", "[", 
               RowBox[{"KeySort", " ", "@", " ", 
                RowBox[{"GroupBy", "[", 
                 RowBox[{
                  RowBox[{"Keys", "[", "eccentricities", "]"}], ",", " ", 
                  "eccentricities"}], "]"}]}], "]"}]}]}], "]"}], ",", " ", 
           RowBox[{"MinMax", "[", "eccentricities", "]"}]}], "}"}]}], "]"}], ",",
        "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
           " ", "\"\<HexagonalTilingGraph\>\"", ",", 
           " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"First", " ", "/@", " ", "panels"}], "]"}], ",", " ", 
     RowBox[{"Last", " ", "/@", " ", "panels"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2210e640-e126-477c-935c-b218d6e8a78b"],

