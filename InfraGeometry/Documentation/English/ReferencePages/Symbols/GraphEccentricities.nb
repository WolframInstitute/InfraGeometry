Cell["\<\
On the three tilings the eccentricity is the radius plus the distance from \
the centre: the farthest vertex lies across the centre, on the rim.\
\>", "ExampleText",ExpressionUUID->"a4388778-fef7-4bda-9083-7d2a0e48bbc1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
       "\n", "      ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"First", " ", "@", " ", 
               RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "#"}], 
             "]"}], " ", "&"}], " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{"GraphEccentricities", "[", "g", "]"}]}], "}"}], "]"}]}], 
      "]"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"name", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
         " ", "\"\<HexagonalTilingGraph\>\"", ",", 
         " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<square\>\"", ",", " ", "\"\<hexagonal\>\"", ",", 
      " ", "\"\<triangular\>\""}], "}"}]}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<d(c, v)\>\"", ",", " ", "\"\<e(v)\>\""}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ba05ca69-c202-4a3b-88e6-c549dfa145ab"],

