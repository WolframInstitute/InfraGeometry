   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e9ca1d8f-65cd-4151-8df9-1c5b2f2868e8"],
 " matrix."
}], "Notes",ExpressionUUID->"22518a6c-57d7-4da9-a357-af62c298f434"],

Cell[TextData[{
 "Along an edge the eccentricity changes by at most 1. On a graph with \
several components every eccentricity is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
