Cell[TextData[{
 "Definition: the eccentricity of a vertex ",
 StyleBox["v", "TI"],
 " is ",
 StyleBox["e", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = max ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["w", "TI"],
 ") over the vertices ",
 StyleBox["w", "TI"],
 ", the distance to a farthest vertex. The least eccentricity is the radius \
of ",
 StyleBox["g", "TI"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphRadius"]], "paclet:ref/GraphRadius"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "90404431-d09e-4803-9665-b2b8235efca2"],
 ", reached on the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphCenter"]], "paclet:ref/GraphCenter"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "79361a3f-f18b-4fc2-8869-3cf5554418fe"],
 "; the largest is the diameter, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphDiameter"]], "paclet:ref/GraphDiameter"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a218301e-23a5-4618-9dd8-d281f0d7c4cb"],
 ", reached on the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphPeriphery"]], "paclet:ref/GraphPeriphery"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0b4aad69-29fd-47c2-af54-b56d7da3f9ff"],
 "."
}], "Notes",ExpressionUUID->"e54a47b4-3f83-4145-ac9d-2ca7bbf7928b"],

Cell[TextData[{
 "It is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VertexEccentricity"]], "paclet:ref/VertexEccentricity"},
