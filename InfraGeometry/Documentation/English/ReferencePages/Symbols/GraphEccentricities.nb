Cell["\<\
On the three tilings the eccentricity is the radius plus the distance from \
the centre: the farthest vertex lies across the centre, on the rim.\
\>", "ExampleText",ExpressionUUID->"e3f68a69-1a70-442b-9bf1-5a061c6d384a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
       "\n", "      ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"First", " ", "@", " ", 
               RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "#"}], 
             "]"}], " ", "&"}], " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{"GraphEccentricities", "[", "g", "]"}]}], "}"}], "]"}]}], 
      "]"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"name", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
         " ", "\"\<HexagonalTilingGraph\>\"", ",", 
         " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<square\>\"", ",", " ", "\"\<hexagonal\>\"", ",", 
      " ", "\"\<triangular\>\""}], "}"}]}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<d(c, v)\>\"", ",", " ", "\"\<e(v)\>\""}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"66908b68-b69b-43cd-9746-f1e22e022a78"],

