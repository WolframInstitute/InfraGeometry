Cell[TextData[{
 "The centre, red, has the least eccentricity, the radius, and the periphery, \
blue, the largest, the diameter. The values agree with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VertexEccentricity"]], "paclet:ref/VertexEccentricity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5b41d2ed-7ed1-4f67-8dfe-2141a6f90d48"],
 "."
}], "ExampleText",ExpressionUUID->"c311b8ac-c53f-4ab7-a501-8085d55fd57b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"eccentricities", " ", "=", " ", 
     RowBox[{"GraphEccentricities", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"GraphCenter", "[", "g", "]"}], " ", "->", " ", 
          "StandardRed"}], ",", " ", 
         RowBox[{
          RowBox[{"GraphPeriphery", "[", "g", "]"}], " ", "->", " ", 
          "StandardBlue"}]}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"MinMax", "[", "eccentricities", "]"}], " ", "==", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GraphRadius", "[", "g", "]"}], ",", " ", 
        RowBox[{"GraphDiameter", "[", "g", "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"eccentricities", " ", "===", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexEccentricity", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}], ")"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9bb8c585-6947-4650-aa1f-924a86f2ad14"],

