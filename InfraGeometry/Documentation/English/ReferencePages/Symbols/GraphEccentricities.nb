Cell[TextData[{
 "Definition: the eccentricity of a vertex ",
 StyleBox["v", "TI"],
 " is ",
 StyleBox["e", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = max ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["w", "TI"],
 ") over the vertices ",
 StyleBox["w", "TI"],
 ", the distance to a farthest vertex. The least eccentricity is the radius \
of ",
 StyleBox["g", "TI"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphRadius"]], "paclet:ref/GraphRadius"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "960dd7d4-934b-4af4-8893-7a444343a526"],
 ", reached on the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphCenter"]], "paclet:ref/GraphCenter"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "22adb8ca-1e42-4bb4-b146-506502bb3cc9"],
 "; the largest is the diameter, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphDiameter"]], "paclet:ref/GraphDiameter"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b4d33986-81cd-4a4e-888a-d02c3df5aee6"],
 ", reached on the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphPeriphery"]], "paclet:ref/GraphPeriphery"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "850969b0-e16a-49db-94c0-77e6b53081d7"],
 "."
}], "Notes",ExpressionUUID->"2832ec10-d018-42cf-a297-fd0f650aabca"],

Cell[TextData[{
 "It is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VertexEccentricity"]], "paclet:ref/VertexEccentricity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "50d77313-ff7c-4207-8893-1203bb5d3633"],
 " at every vertex at once, read off one ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphDistanceMatrix"]], "paclet:ref/GraphDistanceMatrix"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6a8cae5c-4999-43ea-8571-622a8a504b80"],
