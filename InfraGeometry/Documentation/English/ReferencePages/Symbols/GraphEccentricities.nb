Cell["\<\
A distance matrix: the eccentricities of the square tiling under the \
effective resistance, blue at the least and red at the largest. The rim is \
far in resistance too, and the corners, each held by one edge, are farthest.\
\>", "ExampleText",ExpressionUUID->"87324714-1c8f-4b1a-b0a5-2a38cbf716e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"eccentricities", " ", "=", " ", 
     RowBox[{"GraphEccentricities", "[", 
      RowBox[{"EffectiveResistance", "[", "g", "]"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#1", " ", "->", " ", 
           RowBox[{"Blend", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"StandardBlue", ",", " ", "StandardRed"}], "}"}], ",", 
             " ", "#2"}], "]"}]}], " ", "&"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{"Rescale", "[", "eccentricities", "]"}]}], "}"}]}], 
        "]"}]}], "]"}], ",", " ", 
     RowBox[{"MinMax", "[", "eccentricities", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"53c50828-863e-4155-9f7f-0a7e8570be76"],

