Cell["\<\
A distance matrix: the eccentricities of the square tiling under the \
effective resistance, blue at the least and red at the largest. The rim is \
far in resistance too, and the corners, each held by one edge, are farthest.\
\>", "ExampleText",ExpressionUUID->"567e7222-d510-431f-a556-c3c9a99e00d7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"eccentricities", " ", "=", " ", 
     RowBox[{"GraphEccentricities", "[", 
      RowBox[{"EffectiveResistance", "[", "g", "]"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#1", " ", "->", " ", 
           RowBox[{"Blend", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"StandardBlue", ",", " ", "StandardRed"}], "}"}], ",", 
             " ", "#2"}], "]"}]}], " ", "&"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{"Rescale", "[", "eccentricities", "]"}]}], "}"}]}], 
        "]"}]}], "]"}], ",", " ", 
     RowBox[{"MinMax", "[", "eccentricities", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"05660c62-307e-4e96-8ebc-b91afba62cbd"],

