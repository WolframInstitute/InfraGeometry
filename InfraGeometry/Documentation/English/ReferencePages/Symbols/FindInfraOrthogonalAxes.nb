Cell["\<\
The straight cross through the centre of the square tiling, two axes of 4 \
steps on each side.\
\>", "ExampleText",ExpressionUUID->"9ed407f6-cdba-4534-97ed-d30da091ca7b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axes", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "4"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Append", "[", 
        RowBox[{"axes", ",", " ", 
         RowBox[{"{", "c", "}"}]}], "]"}]}], "]"}], ",", " ", "axes"}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7c4df437-ffef-4169-afae-4ec5b3c597bb"],

