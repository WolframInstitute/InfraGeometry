Cell[TextData[{
 "The exact test is the default. The ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14eca7b4-b45a-4e5a-ad28-40e10cf56332"],
 " method of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "604a067a-49bc-4cfa-a9ca-b6ab492f14e1"],
 " is a relaxation: two lines meeting only at ",
 StyleBox["c", "TI"],
 " pass it, so the straight cross takes four bent axes along (right), where \
the exact test keeps the cross alone (left)."
}], "ExampleText",ExpressionUUID->"00877255-7263-4b45-90dd-02f99f946369"],

