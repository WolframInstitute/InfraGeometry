Cell[TextData[{
 "A length is an integer, ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "797e6ba4-02f2-44b3-9430-470b35f9de2a"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"min", ",", " ", "max"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2162c82-6121-49f9-9642-75834c37c898"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e61d4f8-910e-474d-a705-98bdafcf141f"],
 ". On a bounded grid ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4c955dd-fbbd-43e0-a12a-d5b061e92cf2"],
 " reaches the walls, and a straight line through the centre extends by a \
turn, so only corner-to-corner shortest paths are maximal."
}], "ExampleText",ExpressionUUID->"7b058f05-9635-4948-8780-ff3a5977574b"],

