Cell[TextData[{
 "An axis splits at ",
 StyleBox["c", "TI"],
 " into two rays: the straight cross of the 9 x 9 grid is two axes, and the \
same frame is four rays."
}], "ExampleText",ExpressionUUID->"34448c90-8458-4aab-9fc6-4c8829d86dd3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Length", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"FindInfraOrthogonalAxes", "[", 
