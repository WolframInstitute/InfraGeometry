Cell["NextVertexFunction", "ExampleSubsection",ExpressionUUID->"5d567fee-a280-4b07-8b49-4989349fe2be"],

Cell[TextData[{
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2c95b24-0fb4-4df2-9cab-ff5d865cc56b"],
 " draws the candidates at random, so the count-less call is a random maximal \
set. Three draws at scale 2 on the 9 x 9 grid."
}], "ExampleText",ExpressionUUID->"b3e84b55-5e56-48e7-8d31-807cbb1db9d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", "\n", "      ", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
            RowBox[{"FindInfraOrthogonalAxes", "[", 
             RowBox[{"g", ",", " ", "41", ",", " ", "2", ",", " ", 
              
              RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
               "RandomChoice"}]}], "]"}]}], ")"}], ",", " ", 
          RowBox[{"{", "41", "}"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"seed", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
