Notebook[{

Cell[CellGroupData[{
Cell["FindInfraOrthogonalAxes", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"439e0ff8-76ec-466c-a7d8-04d4ec0b9603"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOrthogonalAxes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["len", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99f99702-b2cd-4998-9160-02736bea2af8"],
 "\[LineSeparator]",
 "gives one maximal set of mutually perpendicular shortest path lines through \
the vertex ",
 StyleBox["c", "TI"],
 ", each a vertex list, the straightest set first.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2ca24cb4-c719-4e23-afc8-12a8e2b2297d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOrthogonalAxes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["len", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae3d1d4a-f384-4dd6-87f0-0e539c454de0"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ccb8575d-1808-4c2f-ab56-52193bc25d6c"],
 " of exactly ",
 StyleBox["n", "TI"],
 " such sets or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a19f533c-9b88-4e18-98f9-4715a4ab09ea"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd3e28bf-7dfa-4cb4-8934-74e94c4a51dc"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79a948da-eaa3-466d-b9d7-d80509130552"],
 " gives every one."
}], "Usage",ExpressionUUID->"e75a708f-47b3-4f2d-ad8a-1475b5538bcf"],

Cell[TextData[{
 "The problem is well posed. Fix a graph ",
 StyleBox["g", "TI"],
 ", a vertex ",
 StyleBox["c", "TI"],
 " and a length ",
 StyleBox["len", "TI"],
 "."
}], "Notes",ExpressionUUID->"a6209f8b-fe93-4f1a-b3de-0930e9b6288f"],

Cell[TextData[{
 "An ",
 StyleBox["axis",
  FontWeight->"Bold"],
 " at ",
 StyleBox["c", "TI"],
 " is a shortest path through ",
 StyleBox["c", "TI"],
 ", a vertex list whose two halves from ",
 StyleBox["c", "TI"],
 " have lengths in ",
 StyleBox["len", "TI"],
 ", maximal there: neither end extends by one step to a longer shortest path \
through ",
 StyleBox["c", "TI"],
 " inside ",
 StyleBox["len", "TI"],
 ". The axes form a finite set, since a shortest path of the range lies in \
the ball of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 ", ",
 StyleBox["r", "TI"],
 " the largest half-length; for ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c095252-fab7-4e22-8946-c0201ceb6b50"],
 " it is the whole component of ",
 StyleBox["c", "TI"],
 "."
}], "Notes",ExpressionUUID->"81366828-87be-45ab-82a3-892deda19eed"],

Cell[TextData[{
 "Two axes are ",
 StyleBox["perpendicular",
  FontWeight->"Bold"],
 " when the shortest-path projection of every vertex of each onto the other \
is ",
 StyleBox["c", "TI"],
 ": every vertex of one has ",
 StyleBox["c", "TI"],
 " as its only nearest vertex on the other. On the distance matrix this is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"d", 
    RowBox[{"(", 
     RowBox[{"v", ",", " ", "w"}], ")"}]}], " ", ">", " ", 
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{"d", 
      RowBox[{"(", 
       RowBox[{"c", ",", " ", "v"}], ")"}]}], ",", " ", 
     RowBox[{"d", 
      RowBox[{"(", 
       RowBox[{"c", ",", " ", "w"}], ")"}]}]}], "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca1b81b6-0382-4d2e-ab97-94f96890c18f"],
 " for every vertex ",
 StyleBox["v", "TI"],
 " of one and ",
 StyleBox["w", "TI"],
 " of the other, both different from ",
 StyleBox["c", "TI"],
 ". The test is exact, symmetric and does not depend on the order of the axes."
}], "Notes",ExpressionUUID->"31ed961d-672d-40ca-a996-c7f55fe5e6ac"],

Cell[TextData[{
 "Perpendicularity is a symmetric relation on a finite set, so the sets of \
mutually perpendicular axes are the cliques of a finite graph. The largest \
number of mutually perpendicular lines through ",
 StyleBox["c", "TI"],
 " is its clique number, and a maximal set cannot be extended by one more \
axis. The call returns maximal sets; the largest of them is the largest of ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29c5a11a-1721-40cc-b4dc-3e10fbceeceb"],
 ". On ",
 Cell[BoxData[
  RowBox[{"GridGraph", "[", 
   RowBox[{"{", 
    RowBox[{"5", ",", " ", "...", ",", " ", "5"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc8eb11c-c6a2-4715-91f4-7cd84fd191bb"],
 " at its centre the largest set has ",
 StyleBox["d", "TI"],
 " axes, the dimension."
}], "Notes",ExpressionUUID->"fba6640d-ed11-4656-8605-1f341e7d9f22"],

Cell[TextData[{
 "A bent shortest path through ",
 StyleBox["c", "TI"],
 " is an axis too, so the sets of ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de8a79fc-5b50-457e-bd61-4f4cc8f6abcc"],
 " include crosses that turn at ",
 StyleBox["c", "TI"],
 ". They are ranked after the straight one: a longer axis first, then fewer \
vertices in the shortest path interval of its ends, which is the axis itself \
exactly when the shortest path is unique, as the straight lines of a grid \
are. The count-less call and ",
 Cell[BoxData[
  RowBox[{"n", " ", "=", " ", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29f0ed65-69f2-4fc0-ad37-452085af4233"],
 " give the first set in that order."
}], "Notes",ExpressionUUID->"d449b92d-1bd9-47d8-af2c-b41ebeaae818"],

Cell[TextData[{
 StyleBox["len", "TI"],
 " is ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0443d906-2559-4ff5-a721-f54c74d0732a"],
 ", an integer ",
 StyleBox["k", "TI"],
 " (both halves of length ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0562da18-bdea-49ba-aaf9-ed3930e499b2"],
 " (each half between 1 and ",
 StyleBox["k", "TI"],
 ") or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"min", ",", " ", "max"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a0cc00d-24fb-4d3a-9646-c01fd5a57ca9"],
 " (each half between ",
 StyleBox["min", "TI"],
 " and ",
 StyleBox["max", "TI"],
 ", ",
 Cell[BoxData["max"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "421b72ec-f739-4521-bf22-8bdd5f934659"],
 " may be ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5a633c1-8f8d-4ab3-8d6e-8ff759c9bf18"],
 "). The halves of an axis need not be equal. Each axis is maximal inside the \
range, so ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "478b6e4f-f489-4ff9-ab70-e846fb82e54b"],
 " never returns a sub-line of a line."
}], "Notes",ExpressionUUID->"9f7e0aea-1fe5-4c1e-8fba-2a563bc93873"],

Cell[TextData[{
 StyleBox["c", "TI"],
 " is a vertex, or an association ",
 Cell[BoxData[
  RowBox[{"<|", " ", 
   RowBox[{
    RowBox[{"v1", " ", "->", " ", "w1"}], ",", " ", "..."}], " ", "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39589d6a-ddc2-4167-8387-4f95dc3386db"],
 " for a point realised by several vertices: the search is run from each ",
 StyleBox["v", "TI"],
 " on one ball, a set belongs to one anchor, and the duplicates are dropped."
}], "Notes",ExpressionUUID->"3d0dc9e6-6eb0-4ad1-92c7-e9447581bbaa"],

Cell[TextData[{
 "The count-less call gives one set, a list of vertex lists; a count gives a \
list of sets. A vertex without a through-line, a path endpoint or a leaf, has \
no axis: the call gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "230b633a-027c-4fb9-b295-b9a410b11b34"],
 ". The rays from such a vertex are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalRays"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalRays", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "17fa7508-f8ca-4758-9dd7-70647edeea21"],
 "."
}], "Notes",ExpressionUUID->"48319af8-fb06-414a-83c4-39f6500d84d2"],

Cell[TextData[{
 "One ",
 Cell[BoxData["GraphDistanceMatrix"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40fe0f3b-0b18-403c-8310-20dc385d68d8"],
 " on the ball of radius 2 ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " is read; no path is searched per candidate."
}], "Notes",ExpressionUUID->"f435a64b-e93b-4cfe-8006-cbb91a797f72"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8ac4b94a-5b9e-4541-ad3f-6604a0c40878"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"567775fc-f5ac-48f1-a3b4-ab92f4295828"],
