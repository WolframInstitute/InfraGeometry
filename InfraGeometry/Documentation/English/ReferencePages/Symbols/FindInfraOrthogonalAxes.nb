Cell[TextData[{
 "A length is an integer, ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59281c3d-454d-4d95-8cb5-c29328e67ff2"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"min", ",", " ", "max"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f77a662b-3df1-4ce9-88e5-4f4eeeaf5af7"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "511a0e9f-7cfd-49da-9744-a7601b08228a"],
 ". On a bounded grid ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca2a4e02-7b75-4185-ab68-7ddd93bba3a8"],
 " reaches the walls, and a straight line through the centre extends by a \
turn, so only corner-to-corner geodesics are maximal."
}], "ExampleText",ExpressionUUID->"5be5a663-9006-480a-b898-bc95e7a4b3ef"],

