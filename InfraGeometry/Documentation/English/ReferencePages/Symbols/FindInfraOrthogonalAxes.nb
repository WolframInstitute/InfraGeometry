Cell[TextData[{
 "A pruning to one candidate per node returns some maximal sets, a sample of ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bceb1b7-367c-4932-89f9-5902b5814dc3"],
 "."
}], "ExampleText",ExpressionUUID->"4851aa69-79ab-42b2-876a-9e9122c0648d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"all", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{"g", ",", " ", "41", ",", " ", "2", ",", " ", "All"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sample", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"FindInfraOrthogonalAxes", "[", 
        RowBox[{"g", ",", " ", "41", ",", " ", "2", ",", " ", "All", ",", " ", 
         RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"RandomSample", "[", 
             RowBox[{"#", ",", " ", 
              RowBox[{"UpTo", "[", "1", "]"}]}], "]"}], " ", "&"}], ")"}]}]}],
         "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", "all"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "sample"}], ",", " ", 
     RowBox[{"SubsetQ", "[", 
      RowBox[{"all", ",", " ", "sample"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f399ead9-e91c-4c40-bc5b-9bffaf0821cb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"27", ",", "1", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"699217c4-e191-48f1-81e4-96682ab8b34c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["AxisCount", "ExampleSubsection",ExpressionUUID->"7ff8f33a-e1a1-4d01-9749-b87e4cdbfe76"],

Cell["\<\
The sets of exactly one axis: every single axis of scale 2 that is maximal, \
the bent ones included, 30 on the 5 x 5 grid at its centre.\
\>", "ExampleText",ExpressionUUID->"36c682c2-200c-42c4-af49-a08a00acd0fa"],

