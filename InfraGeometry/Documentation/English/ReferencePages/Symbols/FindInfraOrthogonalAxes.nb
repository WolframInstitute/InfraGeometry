Cell[TextData[{
 "An axis splits at ",
 StyleBox["c", "TI"],
 " into two rays: the straight cross of the 9 x 9 grid is two axes, and the \
same frame is four rays."
}], "ExampleText",ExpressionUUID->"e15d8a3b-c27c-4732-a8e1-73c63e7eda89"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Length", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"FindInfraOrthogonalAxes", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", "3"}], "]"}], ",", " ", 
