Notebook[{

Cell[CellGroupData[{
Cell["FindInfraOrthogonalAxes", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8eb81ab7-28f2-4ba6-a441-c271791b2609"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOrthogonalAxes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["len", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c99f4ff3-191e-42fc-9d74-73bb52b969c8"],
 "\[LineSeparator]",
 "gives a maximal set of mutually perpendicular axes through the vertex ",
 StyleBox["c", "TI"],
 ", each a vertex list, the straightest set first.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e3139ff3-2b44-43a1-96e3-2085751b29f3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOrthogonalAxes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["len", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8fd6b61b-f27e-4206-9cb9-c68982a70f46"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " such sets."
}], "Usage",ExpressionUUID->"ab9afc99-13c8-4186-ba28-a0eae6481f05"],

Cell[TextData[{
 "An axis at ",
 StyleBox["c", "TI"],
 " is a shortest path through ",
 StyleBox["c", "TI"],
 " whose two halves have lengths in ",
 StyleBox["len", "TI"],
 ", maximal: neither end extends to a longer shortest path through ",
 StyleBox["c", "TI"],
 " within ",
 StyleBox["len", "TI"],
 "."
}], "Notes",ExpressionUUID->"1c258d21-e304-4643-963e-302efdd48dd8"],

Cell[TextData[{
 "Two axes are perpendicular when every vertex of each has ",
 StyleBox["c", "TI"],
 " as its only nearest vertex on the other: ",
 StyleBox["d(v, w) > max(d(c, v), d(c, w))", "TI"],
 " for all ",
 StyleBox["v", "TI"],
 " on one and ",
 StyleBox["w", "TI"],
 " on the other, both different from ",
 StyleBox["c", "TI"],
 "."
}], "Notes",ExpressionUUID->"b85cbd9e-5435-4e6c-8824-e3abb5e489ec"],

Cell[TextData[{
 "The sets returned are maximal: no further axis is perpendicular to all of \
them. The largest number of perpendicular axes through ",
 StyleBox["c", "TI"],
 " is a reading of the dimension at ",
 StyleBox["c", "TI"],
 ": ",
 StyleBox["d", "TI"],
 " at the centre of a ",
 StyleBox["d", "TI"],
 "-dimensional grid."
}], "Notes",ExpressionUUID->"78fcdb4a-14a0-4377-8c8d-be952f1c2533"],

Cell["\<\
The test cannot tell a right angle from a straight one. On the grid the \
vertices 2 steps along the two axes, and 2 steps either way along one axis, \
are both 4 apart.\
\>", "Notes",ExpressionUUID->"de10cea3-8c2d-4c44-9d82-1a1a6f6e2f55"],

Cell[TextData[{
 "A bent shortest path through ",
 StyleBox["c", "TI"],
 " is an axis as well, ranked after the straight ones. Some bent axes pair \
into a cross that turns at ",
 StyleBox["c", "TI"],
 "; others have no perpendicular partner and form a set of their own."
}], "Notes",ExpressionUUID->"3e977c86-181d-4e2b-9538-b611af86b66a"],

Cell[TextData[{
 "On a triangulated mesh the exact test is hard to meet: two axes of length 1 \
need four pairwise non-adjacent neighbours of ",
 StyleBox["c", "TI"],
 ", and at the centre of the square mesh there is no perpendicular pair of \
length 1 or 2."
}], "Notes",ExpressionUUID->"d08de717-61e8-463e-8e84-34e975cdc16c"],

Cell[TextData[{
 StyleBox["len", "TI"],
 " is ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5015f05-13ab-44cb-869d-2e2a20573c63"],
 ", ",
 StyleBox["k", "TI"],
 " (both halves ",
 StyleBox["k", "TI"],
 " steps), ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "028f67a9-6399-4503-be97-0129072626ee"],
 " (each half 1 to ",
 StyleBox["k", "TI"],
 " steps) or {",
 StyleBox["min", "TI"],
 ", ",
 StyleBox["max", "TI"],
 "}. The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "158511b4-a93e-4082-a716-06ffc627885c"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "865747d0-f689-4308-8559-3283ada98998"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "811873ea-d042-418a-ac32-6833f6cc1232"],
 ". ",
 StyleBox["c", "TI"],
 " can be an association of vertices, for a point realised by several \
vertices."
}], "Notes",ExpressionUUID->"7371ccec-afc5-4aea-bd7b-8f4542f5d02f"],

Cell["Options:", "Notes",ExpressionUUID->"9ae30c50-be6e-4e95-bebb-6686ace59ddc"],

