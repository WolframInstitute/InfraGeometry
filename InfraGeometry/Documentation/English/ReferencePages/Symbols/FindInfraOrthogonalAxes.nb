Cell[TextData[{
 "A pruning to one candidate per node returns some maximal sets, a sample of ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2e8491a-3526-4bf7-be87-95424004047d"],
 "."
}], "ExampleText",ExpressionUUID->"d1acf97e-30ab-4dd2-9fea-98510f4953e7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"all", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{"g", ",", " ", "41", ",", " ", "2", ",", " ", "All"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sample", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"FindInfraOrthogonalAxes", "[", 
        RowBox[{"g", ",", " ", "41", ",", " ", "2", ",", " ", "All", ",", " ", 
         RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"RandomSample", "[", 
             RowBox[{"#", ",", " ", 
              RowBox[{"UpTo", "[", "1", "]"}]}], "]"}], " ", "&"}], ")"}]}]}],
         "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", "all"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "sample"}], ",", " ", 
     RowBox[{"SubsetQ", "[", 
      RowBox[{"all", ",", " ", "sample"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"07b8f2e4-a329-4397-8b67-91d54f117138"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"27", ",", "1", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"fc24290c-8226-451d-80ab-7cae11ff6a6d"]
}, Open  ]]
