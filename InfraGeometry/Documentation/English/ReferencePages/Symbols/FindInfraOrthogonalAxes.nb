Cell[TextData[{
 "A length is an integer, ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fa5dc03-d927-464b-8734-ae0603a34fbb"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"min", ",", " ", "max"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2c684f7-0e8c-4421-ac1b-88127a302a46"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "103887bc-e6dc-4d29-b068-cd1ec5ba76df"],
 ". On a bounded grid ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08c5bff8-0451-4a50-97dc-137771d9dad2"],
 " reaches the walls, and a straight line through the centre extends by a \
turn, so only corner-to-corner shortest paths are maximal."
}], "ExampleText",ExpressionUUID->"f1d3ebc0-9486-47a7-9726-c0636b771900"],

