Cell["\<\
A predicate on the chosen axes plus the candidate: here at most one axis, so \
every set is a single axis, and the number of sets is the number of maximal \
axes.\
\>", "ExampleText",ExpressionUUID->"f29c2d6d-ab16-4a6d-a38a-21ace674159b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"sets", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", "13", ",", " ",
        "2", ",", " ", "All", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "#", "]"}], " ", "<=", " ", "1"}], " ", 
          "&"}], ")"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", "sets"}], ",", " ", 
     RowBox[{"Union", "[", 
      RowBox[{"Length", " ", "/@", " ", "sets"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d5e04ffa-9b26-4eda-96e1-d95e29a7ba09"],

