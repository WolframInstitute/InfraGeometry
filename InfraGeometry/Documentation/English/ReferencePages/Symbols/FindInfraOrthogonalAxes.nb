Cell[CellGroupData[{

Cell["Properties", "ExampleSubsection",ExpressionUUID->"d1aab05f-4d16-4d02-ac0d-22cd1cd3d6e3"],

Cell["\<\
A predicate on the list of chosen axes. Admitting at most one axis makes \
every set a single axis, one set per axis:\
\>", "ExampleText",ExpressionUUID->"eb21b66c-f873-463c-b87f-ae59384635ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sets", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", "2", ",", " ", "All", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "#", "]"}], " ", "<=", " ", "1"}], " ", 
          "&"}], ")"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "sets", "]"}], ",", " ", 
     RowBox[{"Union", "[", 
      RowBox[{"Length", " ", "/@", " ", "sets"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7555c7ae-3d8e-487d-ad52-ca304422c508"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"30", ",", 
   RowBox[{"{", "1", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"750442d7-a5ef-4a16-bf85-aff80de508bf"]
}, Open  ]],

Cell[TextData[{
 "The ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ac2c690-d69c-4033-9b15-29279e3150de"],
 " method of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6db1dc32-172e-4e34-ade8-2aa86aa78fb8"],
 ". Perpendicular lines meet in one vertex, so the axes meet only at ",
 StyleBox["c", "TI"],
 "; at length 2 on the grid the set is the straight cross:"
}], "ExampleText",ExpressionUUID->"06c5c7fa-d606-4436-bb67-006d94b58131"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axes", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", "2", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", "\"\<Projection\>\""}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{"InfraWalk", " ", "/@", " ", "axes"}], ",", " ", "45"}], "]"}],
      ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Length", "[", "axes", "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"03820bae-c88f-4854-9898-89a916d17731"],

