           RowBox[{"#", ",", " ", 
            RowBox[{"{", "13", "}"}]}], "]"}]}], "]"}], " ", "&"}], " ", "/@",
        " ", 
       RowBox[{"Take", "[", 
        RowBox[{"single", ",", " ", "3"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "single"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c0dfcbd9-19ee-42d9-9930-85a51899e997"],

