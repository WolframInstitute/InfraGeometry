Cell["NextVertexFunction", "ExampleSubsection",ExpressionUUID->"a839892c-2406-49f1-9fd9-bb372bec08cd"],

Cell[TextData[{
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebbd43bb-e4ed-49a5-9ba6-052b11cf9572"],
 " draws the candidates at random, so the count-less call is a random maximal \
set. Three draws at scale 2 on the 9 x 9 grid."
}], "ExampleText",ExpressionUUID->"8cd9b1ba-c47c-4455-abcc-460f3488aa89"],

