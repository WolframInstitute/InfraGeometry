Cell[TextData[{
 "A pruning to one candidate per node returns some maximal sets, a sample of ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7caafbcb-847c-4344-89fe-cf3479278641"],
 "."
}], "ExampleText",ExpressionUUID->"74bc3872-333f-4bea-a839-e3a0f2a76d64"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"all", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{"g", ",", " ", "41", ",", " ", "2", ",", " ", "All"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sample", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"FindInfraOrthogonalAxes", "[", 
        RowBox[{"g", ",", " ", "41", ",", " ", "2", ",", " ", "All", ",", " ", 
         RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"RandomSample", "[", 
             RowBox[{"#", ",", " ", 
              RowBox[{"UpTo", "[", "1", "]"}]}], "]"}], " ", "&"}], ")"}]}]}],
         "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", "all"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "sample"}], ",", " ", 
     RowBox[{"SubsetQ", "[", 
      RowBox[{"all", ",", " ", "sample"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"41100ea0-fd95-4142-9cf7-778c52804681"],

