 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bc4b8a62-84aa-41fb-a10a-417f7b29db2d"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
