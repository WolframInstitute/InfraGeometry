Cell["Any two axes of a set pass the perpendicularity test:", "ExampleText",ExpressionUUID->"70d4a6bc-9e5d-4a0f-9b4e-ef0d6a10b80e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axes", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "4"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{"Flatten", " ", "@", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", "v", ",", " ", "w"}], "]"}], " ", ">", " ", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "v"}], "]"}], ",", " ", 
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "w"}], "]"}]}], "]"}]}], ",",
        "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"v", ",", " ", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"axes", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", "c"}], "]"}]}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"w", ",", " ", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"axes", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", " ", "c"}], "]"}]}], "}"}]}],
       "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"dfce80e1-cd6e-4407-b8ed-2df64b57f601"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ed971248-0a14-4626-a496-7eb0ad4e7a23"]
}, Open  ]],

