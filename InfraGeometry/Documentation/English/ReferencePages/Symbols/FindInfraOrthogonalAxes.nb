Cell["\<\
The number of perpendicular axes at the centre of the grids of dimension 2, 3 \
and 4 is the dimension:\
\>", "ExampleText",ExpressionUUID->"422fcc9a-bd48-4c27-874a-b70964c5dea6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Length", " ", "@", " ", 
    RowBox[{"FindInfraOrthogonalAxes", "[", 
     RowBox[{
      RowBox[{"GridGraph", "[", 
       RowBox[{"Table", "[", 
        RowBox[{"5", ",", " ", "d"}], "]"}], "]"}], ",", " ", 
      RowBox[{"Ceiling", "[", 
       RowBox[{
        RowBox[{"5", "^", "d"}], "/", "2"}], "]"}], ",", " ", "2"}], "]"}]}], 
   ",", " ", 
   RowBox[{"{", 
    RowBox[{"d", ",", " ", "2", ",", " ", "4"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"cb339b53-52fc-4602-b7c0-76868033517c"],

