     FontWeight->Bold,ExpressionUUID->"b328ebc1-641d-4db7-ac4e-3042bec839f3"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"069c040e-b113-4941-a173-d4986797f93f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9beda618-6879-40da-99ab-7ce16c35df86"], Cell[TextData[Cell[BoxData[
    "Properties"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "779a0621-3e2a-468d-9d29-52cef2f2707b"]], "TableText",ExpressionUUID->
     "89452739-0e34-48e9-ab49-30e0e1e65e79"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "72bf1d18-0de4-494c-80c9-7d32d971d81c"]], "TableText",ExpressionUUID->
     "f7b2ea62-b2ac-4572-90a7-e5dbc4506f80"], Cell[
    "the class of admissible next axes", "TableText",ExpressionUUID->
     "0ad5d346-5778-4327-b0a0-9fbfe6a8b264"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e926e222-64f0-4337-b63c-0fc31552088d"], Cell[TextData[Cell[
    BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ff515249-a324-40f9-b9bc-50da706ecce3"]], "TableText",ExpressionUUID->
     "e575340a-2c73-4adc-b813-383c35e3054b"], Cell[TextData[Cell[BoxData[
    "Identity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9b93118b-4e65-43c5-80e3-5ba6361dd855"]], "TableText",ExpressionUUID->
     "baab1f74-3fee-4e48-88e2-5d7763de6f45"], Cell[
    "the order the candidates are tried in", "TableText",ExpressionUUID->
     "597f6f89-f072-454c-b490-695e7aab44f0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ce721571-7d72-4170-8c84-0a88d9611464"], Cell[TextData[Cell[
    BoxData["\"\<AxisCount\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "86225159-0216-422d-b1d3-a0b2829b4458"]], "TableText",ExpressionUUID->
     "32c8a88a-c8a6-4211-91a2-49b8d54e087a"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a4172879-ae27-4320-9187-b58ddbc28441"]], "TableText",ExpressionUUID->
     "ffe99ea8-fe92-40de-97d5-90e88c087a55"], Cell[
    "the number of axes in a set", "TableText",ExpressionUUID->
     "7f7e8e4d-c971-4469-a966-f0a4b4a767f2"]}
  }]], "3ColumnTableMod",ExpressionUUID->"bd088e5b-15cc-4af1-a559-\
dfaf5482f5c9"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", "Automatic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14e4fb01-4124-4e49-909a-f000b94d16dd"],
 " is the exact projection test above. A string or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"string", ",", " ", "opts"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df3a56f4-4acf-46da-931d-737389ff2714"],
 " names a ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3275d5d-9eb6-4389-8710-dbbe9f8449b8"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4cbba40d-e554-4092-85f9-731d77bd99db"],
 ", checked between the candidate and every axis already chosen; any other \
value ",
 StyleBox["f", "TI"],
 " is a predicate on the list of the chosen axes plus the candidate, so ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "#", "]"}], " ", "<=", " ", "1"}], " ", "&"}], 
    ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29ae6844-6d5e-486b-ac08-6f64e5420155"],
 " admits no pair."
}], "Notes",ExpressionUUID->"18ceef50-8549-43c0-9c77-ea8a3c7215ff"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "f"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4d0cfd4-9070-4830-b2d3-99119fed0fa0"],
 " turns the ranked candidates into the order they are tried in. ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e04f4bc-6bdd-4a50-bd17-7f0bd22dbe1e"],
 " keeps the ranking; ",
 Cell[BoxData["RandomSample"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62b3bce5-4f2c-4509-a980-e86163d68851"],
 " and any permutation change the order but not the class, so ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8704f02-5ba0-4ce8-9dfa-2027427c9ecd"],
 " is the same set of sets; ",
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "001c4634-1e96-407f-ba64-959e1809cbb6"],
 " draws one candidate, so the count-less call is a random maximal set; ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    RowBox[{"RandomSample", "[", 
     RowBox[{"#", ",", " ", 
      RowBox[{"UpTo", "[", "k", "]"}]}], "]"}], " ", "&"}], ")"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "036db53c-1eb5-4404-b1db-2e6f41204fc5"],
 " prunes to ",
 StyleBox["k", "TI"],
 " candidates per node and so returns some of the maximal sets."
}], "Notes",ExpressionUUID->"5bd2bdbf-1e1a-43cf-b220-1ceddc4e61f6"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<AxisCount\>\"", " ", "->", " ", "k"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5667a538-41ab-4b0c-9854-df72bff8a3ac"],
 " keeps the sets of exactly ",
 StyleBox["k", "TI"],
 " axes, ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe6f66c3-93ec-4fd7-a5cb-30b7275263cf"],
 " the sets of ",
 StyleBox["k", "TI"],
 " axes or fewer if maximal, ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0885d692-d740-437a-a5ea-c05352f71dcf"],
 " every clique of any size, ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24cf3a42-7b31-4742-9709-c3bcd124b0af"],
 " the maximal ones."
}], "Notes",ExpressionUUID->"29c9343a-5740-4ad5-8218-4366ab7964d8"]
}, Open  ]],

