 CellLabel->"Out[2]= ",ExpressionUUID->"c3273416-9523-4316-b19f-5aec9aaaa356"]
}, Open  ]],

Cell["\<\
The first three sets at length 2 on the grid: the straight cross, then two \
bent axes alone:\
\>", "ExampleText",ExpressionUUID->"ae4a6d1e-4cb1-4798-9c8f-f9fd82541b2e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sets", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", "2", ",", " ", "3"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"InfraWalk", " ", "/@", " ", "set"}], ",", " ", "45"}], 
         "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"set", ",", " ", "sets"}], "}"}]}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[3]:= ",ExpressionUUID->"665c06a6-1c2d-46c3-9abc-a18799bfe816"],

