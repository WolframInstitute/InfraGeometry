    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"Append", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"{", "13", "}"}]}], "]"}]}], "]"}], " ", "&"}], " ", "/@",
        " ", 
       RowBox[{"Take", "[", 
        RowBox[{"single", ",", " ", "3"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "single"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3e3d81bd-51ee-4ce4-9bfe-13c1342dddb0"],

