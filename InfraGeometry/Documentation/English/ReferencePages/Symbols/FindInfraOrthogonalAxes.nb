Notebook[{

Cell[CellGroupData[{
Cell["FindInfraOrthogonalAxes", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a097553b-64c5-40a0-985b-9552e7b798d6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOrthogonalAxes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["len", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e90d3319-eead-47e2-9741-f0fb988c4d87"],
 "\[LineSeparator]",
 "gives one maximal set of mutually perpendicular shortest path lines through \
the vertex ",
 StyleBox["c", "TI"],
 ", each a vertex list, the straightest set first.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2773e36e-b519-4ef0-a480-735852c86ef9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOrthogonalAxes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["len", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28f16989-e859-42aa-8f77-9080d7dc5aa9"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92787669-79d5-4818-82f3-dd86cf7e8ddb"],
 " of exactly ",
 StyleBox["n", "TI"],
 " such sets or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85fdc0d1-5663-4e5e-8a6d-c49b95bb2cbf"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73ec7a24-3d91-4705-adf6-cbc27dd37f81"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "432c1c1c-fb9b-4db2-9dfd-95ffe521b68b"],
 " gives every one."
}], "Usage",ExpressionUUID->"4fe6c68c-dd88-4214-9a78-83bb0ca7d0e2"],

Cell[TextData[{
 "The problem is well posed. Fix a graph ",
 StyleBox["g", "TI"],
 ", a vertex ",
 StyleBox["c", "TI"],
 " and a length ",
 StyleBox["len", "TI"],
 "."
}], "Notes",ExpressionUUID->"032ec97f-f5bd-4a0c-b017-902b53942055"],

Cell[TextData[{
 "An ",
 StyleBox["axis",
  FontWeight->"Bold"],
 " at ",
 StyleBox["c", "TI"],
 " is a shortest path through ",
 StyleBox["c", "TI"],
 ", a vertex list whose two halves from ",
 StyleBox["c", "TI"],
 " have lengths in ",
 StyleBox["len", "TI"],
 ", maximal there: neither end extends by one step to a longer shortest path \
through ",
 StyleBox["c", "TI"],
 " inside ",
 StyleBox["len", "TI"],
 ". The axes form a finite set, since a shortest path of the range lies in \
the ball of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 ", ",
 StyleBox["r", "TI"],
 " the largest half-length; for ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f26b2af-d993-45d7-b728-23ef58b8c580"],
 " it is the whole component of ",
 StyleBox["c", "TI"],
 "."
}], "Notes",ExpressionUUID->"db9a95ba-9203-47d5-9704-eb4f12bfebc8"],

Cell[TextData[{
 "Two axes are ",
 StyleBox["perpendicular",
  FontWeight->"Bold"],
 " when the shortest-path projection of every vertex of each onto the other \
is ",
 StyleBox["c", "TI"],
 ": every vertex of one has ",
 StyleBox["c", "TI"],
 " as its only nearest vertex on the other. On the distance matrix this is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"d", 
    RowBox[{"(", 
     RowBox[{"v", ",", " ", "w"}], ")"}]}], " ", ">", " ", 
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{"d", 
      RowBox[{"(", 
       RowBox[{"c", ",", " ", "v"}], ")"}]}], ",", " ", 
     RowBox[{"d", 
      RowBox[{"(", 
       RowBox[{"c", ",", " ", "w"}], ")"}]}]}], "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa68ae49-1cb6-4bfe-8f3f-0d692f6d4b00"],
 " for every vertex ",
 StyleBox["v", "TI"],
 " of one and ",
 StyleBox["w", "TI"],
 " of the other, both different from ",
 StyleBox["c", "TI"],
 ". The test is exact, symmetric and does not depend on the order of the axes."
}], "Notes",ExpressionUUID->"372207c6-42b9-4204-bac3-e28351ae365f"],

Cell[TextData[{
 "Perpendicularity is a symmetric relation on a finite set, so the sets of \
mutually perpendicular axes are the cliques of a finite graph. The largest \
number of mutually perpendicular lines through ",
 StyleBox["c", "TI"],
 " is its clique number, and a maximal set cannot be extended by one more \
axis. The call returns maximal sets; the largest of them is the largest of ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39ca0cea-028b-45b0-b353-60dc6037bcf6"],
 ". On ",
 Cell[BoxData[
  RowBox[{"GridGraph", "[", 
   RowBox[{"{", 
    RowBox[{"5", ",", " ", "...", ",", " ", "5"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30465e99-019c-4eb8-9243-e6809cd4910f"],
 " at its centre the largest set has ",
 StyleBox["d", "TI"],
 " axes, the dimension."
}], "Notes",ExpressionUUID->"2775fd1a-8d72-4025-85a8-73f12ac33b3e"],

Cell[TextData[{
 "A bent shortest path through ",
 StyleBox["c", "TI"],
 " is an axis too, so the sets of ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "139d7c16-57d9-4517-bda4-31e727cf597f"],
 " include crosses that turn at ",
 StyleBox["c", "TI"],
 ". They are ranked after the straight one: a longer axis first, then fewer \
vertices in the shortest path interval of its ends, which is the axis itself \
exactly when the shortest path is unique, as the straight lines of a grid \
are. The count-less call and ",
 Cell[BoxData[
  RowBox[{"n", " ", "=", " ", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d23acb0b-081b-4d68-a498-63513568d83d"],
 " give the first set in that order."
}], "Notes",ExpressionUUID->"0b281943-6ee9-416e-9379-3a7d9a629f33"],

Cell[TextData[{
 StyleBox["len", "TI"],
 " is ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5419431b-b5c9-4a97-8e50-0da8daf7fc58"],
 ", an integer ",
 StyleBox["k", "TI"],
 " (both halves of length ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "750b221c-dcf3-4eb0-b0f2-086f08fe025b"],
 " (each half between 1 and ",
 StyleBox["k", "TI"],
 ") or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"min", ",", " ", "max"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0b7cd98-41e9-442a-a287-76e5215eb0dd"],
 " (each half between ",
 StyleBox["min", "TI"],
 " and ",
 StyleBox["max", "TI"],
 ", ",
 Cell[BoxData["max"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e558e5e1-ca99-4b16-a42d-1494d4196556"],
 " may be ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7382c402-bfdc-4a1e-acc9-c76569b86336"],
 "). The halves of an axis need not be equal. Each axis is maximal inside the \
range, so ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f5a97e0-e223-4d34-b7a7-acfe1b8c94c6"],
 " never returns a sub-line of a line."
}], "Notes",ExpressionUUID->"74c06ed0-56d5-46be-a6a0-a2cbecd8e544"],

Cell[TextData[{
 StyleBox["c", "TI"],
 " is a vertex, or an association ",
 Cell[BoxData[
  RowBox[{"<|", " ", 
   RowBox[{
    RowBox[{"v1", " ", "->", " ", "w1"}], ",", " ", "..."}], " ", "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b41c93a7-6172-4c41-96f4-b756202aa988"],
 " for a point realised by several vertices: the search is run from each ",
 StyleBox["v", "TI"],
 " on one ball, a set belongs to one anchor, and the duplicates are dropped."
}], "Notes",ExpressionUUID->"fe4d43d0-c419-461b-a7f3-4653e8cd8bae"],

Cell[TextData[{
 "The count-less call gives one set, a list of vertex lists; a count gives a \
list of sets. A vertex without a through-line, a path endpoint or a leaf, has \
no axis: the call gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e810bc3d-9f34-41da-b02b-92385d048267"],
 ". The rays from such a vertex are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalRays"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalRays", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "22c76a16-5492-4545-b4f6-bd3f27b47537"],
 "."
}], "Notes",ExpressionUUID->"813befd3-a1e7-4383-a31e-bc2366f54046"],

Cell[TextData[{
 "One ",
 Cell[BoxData["GraphDistanceMatrix"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5e1cc54-3829-4e2c-8588-0935c12cdb89"],
 " on the ball of radius 2 ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " is read; no path is searched per candidate."
}], "Notes",ExpressionUUID->"b755efe1-16aa-4fa7-8b3c-81308bdc29ca"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e58ff6b4-937e-4583-8b2e-404b02b9e105"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"5b6c3b1d-0631-498a-ad63-e9099a6dda88"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"f5af29bb-14fa-4890-a4cf-0334efd8e68f"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"0446b431-4f18-440a-bf93-07fee8fba5a5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1dcefe86-4cc5-4456-8388-02ecb3476a6d"], Cell[TextData[Cell[BoxData[
    "Properties"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "4f2b80f0-5661-4ebf-9652-a9c101bf07d5"]], "TableText",ExpressionUUID->
     "942f2cdb-74e8-4f16-9d79-e742a39f723b"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5869a240-929f-433c-98fa-86b600aceac3"]], "TableText",ExpressionUUID->
     "5cf362ba-37eb-4ea5-9ed7-e434d9c87a67"], Cell[
    "the class of admissible next axes", "TableText",ExpressionUUID->
     "06f57150-d5b8-4869-8cb2-4a87ceaade3e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9bc1c44a-0f68-4229-b286-a4867fa65212"], Cell[TextData[Cell[
    BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0aa25734-b937-41e3-9a01-ec45db4549fc"]], "TableText",ExpressionUUID->
     "17e03cdd-4ae9-474b-be36-3dd4e96e31b6"], Cell[TextData[Cell[BoxData[
    "Identity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2276881d-5808-4983-8e80-2e5010511344"]], "TableText",ExpressionUUID->
     "43def69b-7c8c-42e6-a8ef-45055003eaae"], Cell[
    "the order the candidates are tried in", "TableText",ExpressionUUID->
     "e2ebacc3-9bf0-49b5-858c-054b82636043"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "bf7dce85-13c3-4770-b770-548aa9244cd3"], Cell[TextData[Cell[
    BoxData["\"\<AxisCount\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "8676c42f-c8ee-4d55-8e36-6fb45f614fa4"]], "TableText",ExpressionUUID->
     "81b00058-1a06-462a-835e-2164a5f44858"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "67cb9bf2-0ce0-4354-a7f6-2f7dce2002e6"]], "TableText",ExpressionUUID->
     "830869bb-7aad-49d3-a4ee-91c790f4aa85"], Cell[
    "the number of axes in a set", "TableText",ExpressionUUID->
     "356750bc-217d-497f-a9b0-97a7aa9fe63a"]}
  }]], "3ColumnTableMod",ExpressionUUID->"c03746a2-0f2f-4bdb-9b83-\
2c7c48d31fd0"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", "Automatic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7f20a5d-c876-4cce-acc1-918fa2b5473e"],
 " is the exact projection test above. A string or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"string", ",", " ", "opts"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ce67f8a-8d84-4dee-a148-d8b0438ce427"],
 " names a ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8c1d4de-ccb3-42ea-b609-f4d898cb7810"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cbf59493-4d44-4711-a924-d0a798e0e586"],
 ", checked between the candidate and every axis already chosen; any other \
value ",
 StyleBox["f", "TI"],
 " is a predicate on the list of the chosen axes plus the candidate, so ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "#", "]"}], " ", "<=", " ", "1"}], " ", "&"}], 
    ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de643e18-0a38-4798-b54b-8a04ee5667b5"],
 " admits no pair."
}], "Notes",ExpressionUUID->"7fc3cb4b-488a-4392-b542-047df91e567b"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "f"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46fc7657-6022-4947-97f1-07ea73241662"],
 " turns the ranked candidates into the order they are tried in. ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa36d037-94f3-4dc5-a3e0-b8e606486d80"],
 " keeps the ranking; ",
 Cell[BoxData["RandomSample"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b1084db-7aef-4d9f-9614-f7e311e7b20a"],
 " and any permutation change the order but not the class, so ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f75b83f0-5ba4-426e-bab4-a85165dbec4f"],
 " is the same set of sets; ",
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f6bdaa0-0187-4d20-80fd-270e33d26290"],
 " draws one candidate, so the count-less call is a random maximal set; ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    RowBox[{"RandomSample", "[", 
     RowBox[{"#", ",", " ", 
      RowBox[{"UpTo", "[", "k", "]"}]}], "]"}], " ", "&"}], ")"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "892e347c-ae4d-4962-9387-526fb7e3c752"],
 " prunes to ",
 StyleBox["k", "TI"],
 " candidates per node and so returns some of the maximal sets."
}], "Notes",ExpressionUUID->"dda75769-755f-442c-85e6-5f3c3c76fd3a"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<AxisCount\>\"", " ", "->", " ", "k"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d0a27ba-08c8-4923-8ace-40c1e4a237fb"],
 " keeps the sets of exactly ",
 StyleBox["k", "TI"],
 " axes, ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d289c4f-c4ab-4b0d-a8f2-6499da8fbe26"],
 " the sets of ",
 StyleBox["k", "TI"],
 " axes or fewer if maximal, ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45415b55-cb2d-4474-8181-4127e8fe44a0"],
 " every clique of any size, ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53065629-32a0-4d3e-b912-3c2e0d704c52"],
 " the maximal ones."
}], "Notes",ExpressionUUID->"8281181d-1e69-4e31-85ae-7f8b2da0408d"]
}, Open  ]],

