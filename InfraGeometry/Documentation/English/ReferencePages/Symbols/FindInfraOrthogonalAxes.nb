Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrthogonalCoordinates"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrthogonalCoordinates", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "709531b8-b14c-45ec-9fdd-54f168de2df5"],
 " reads the axes as coordinate lines. On the straight cross of the 9 x 9 \
grid the coordinates are a bijection onto the grid ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "4"}], ",", " ", "...", ",", " ", "4"}], "}"}], "^", "2"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3483783-15dd-4203-be86-88c005fac903"],
 ", so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3d39920f-4ba5-4653-8abf-9be1204d9f6d"],
 " of the grid over them has the grid as its base."
}], "ExampleText",ExpressionUUID->"4bf92864-c123-4148-ad01-e953080c0e7f"],

