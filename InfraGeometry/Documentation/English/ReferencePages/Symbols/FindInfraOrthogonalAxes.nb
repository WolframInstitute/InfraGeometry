Notebook[{

Cell[CellGroupData[{
Cell["FindInfraOrthogonalAxes", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9d652cdc-9c5e-4923-abe9-55e3febafb4e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOrthogonalAxes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["len", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d13b314-2f65-4dcc-ac18-79cd8338f2ef"],
 "\[LineSeparator]",
 "gives one maximal set of mutually perpendicular geodesic lines through the \
vertex ",
 StyleBox["c", "TI"],
 ", each a vertex list, the straightest set first.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3bbaeae7-c725-4d31-a202-6dfa50a155b2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOrthogonalAxes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["len", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c53aba9-9e5a-455c-a34d-bda5f5eabf13"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36fe478c-ffa6-4b2e-8fee-4aa8dce3451b"],
 " of exactly ",
 StyleBox["n", "TI"],
 " such sets or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ced43d7-a105-44eb-be1b-973d1e4630db"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0216816-74f2-4866-a245-27a5700e80c6"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1599044a-ad2c-4505-879d-b068d5460488"],
 " gives every one."
}], "Usage",ExpressionUUID->"3697b07c-d375-458a-aee0-a716bfa37ce2"],

Cell[TextData[{
 "The problem is well posed. Fix a graph ",
 StyleBox["g", "TI"],
 ", a vertex ",
 StyleBox["c", "TI"],
 " and a length ",
 StyleBox["len", "TI"],
 "."
}], "Notes",ExpressionUUID->"90daa899-1229-42ab-8651-f16be595aa94"],

Cell[TextData[{
 "An ",
 StyleBox["axis",
  FontWeight->"Bold"],
 " at ",
 StyleBox["c", "TI"],
 " is a geodesic through ",
 StyleBox["c", "TI"],
 ", a vertex list whose two halves from ",
 StyleBox["c", "TI"],
 " have lengths in ",
 StyleBox["len", "TI"],
 ", maximal there: neither end extends by one step to a longer geodesic \
through ",
 StyleBox["c", "TI"],
 " inside ",
 StyleBox["len", "TI"],
 ". The axes form a finite set, since a geodesic of the range lies in the \
ball of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 ", ",
 StyleBox["r", "TI"],
 " the largest half-length; for ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78dfcc30-68bb-4ea1-83e2-492b500af6d7"],
 " it is the whole component of ",
 StyleBox["c", "TI"],
 "."
}], "Notes",ExpressionUUID->"65df0125-04fc-4873-8a12-90f26175f6b1"],

Cell[TextData[{
 "Two axes are ",
 StyleBox["perpendicular",
  FontWeight->"Bold"],
 " when the shortest-path projection of every vertex of each onto the other \
is ",
 StyleBox["c", "TI"],
 ": every vertex of one has ",
 StyleBox["c", "TI"],
 " as its only nearest vertex on the other. On the distance matrix this is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"d", 
    RowBox[{"(", 
     RowBox[{"v", ",", " ", "w"}], ")"}]}], " ", ">", " ", 
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{"d", 
      RowBox[{"(", 
       RowBox[{"c", ",", " ", "v"}], ")"}]}], ",", " ", 
     RowBox[{"d", 
      RowBox[{"(", 
       RowBox[{"c", ",", " ", "w"}], ")"}]}]}], "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffc83e57-fbb3-4291-98cf-44093b05c40a"],
 " for every vertex ",
 StyleBox["v", "TI"],
 " of one and ",
 StyleBox["w", "TI"],
 " of the other, both different from ",
 StyleBox["c", "TI"],
 ". The test is exact, symmetric and does not depend on the order of the axes."
}], "Notes",ExpressionUUID->"b90f7d3a-7a4e-480b-bcd6-abde68414367"],

Cell[TextData[{
 "Perpendicularity is a symmetric relation on a finite set, so the sets of \
mutually perpendicular axes are the cliques of a finite graph. The largest \
number of mutually perpendicular lines through ",
 StyleBox["c", "TI"],
 " is its clique number, and a maximal set cannot be extended by one more \
axis. The call returns maximal sets; the largest of them is the largest of ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd060313-e31f-462e-9a8f-edb32aaf73f4"],
 ". On ",
 Cell[BoxData[
  RowBox[{"GridGraph", "[", 
   RowBox[{"{", 
    RowBox[{"5", ",", " ", "...", ",", " ", "5"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7025d02e-2a84-4b83-8602-f934bac68af8"],
 " at its centre the largest set has ",
 StyleBox["d", "TI"],
 " axes, the dimension."
}], "Notes",ExpressionUUID->"027e7e76-cd30-471a-bd3b-30d8fb29f0c1"],

Cell[TextData[{
 "A bent geodesic through ",
 StyleBox["c", "TI"],
 " is an axis too, so the sets of ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96fa8300-f3f7-4907-9c11-3a734ca58cf8"],
 " include crosses that turn at ",
 StyleBox["c", "TI"],
 ". They are ranked after the straight one: a longer axis first, then fewer \
vertices in the geodesic interval of its ends, which is the axis itself \
exactly when the geodesic is unique, as the straight lines of a grid are. The \
count-less call and ",
 Cell[BoxData[
  RowBox[{"n", " ", "=", " ", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "827c3d58-06ba-4609-bebb-803c926dce9b"],
 " give the first set in that order."
}], "Notes",ExpressionUUID->"c9eb2aaf-e7ff-45d5-959a-34e49c0d3f95"],

Cell[TextData[{
 StyleBox["len", "TI"],
 " is ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2676034b-0021-4cbc-a44f-b1d99ed59389"],
 ", an integer ",
 StyleBox["k", "TI"],
 " (both halves of length ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c00e84c-296d-4475-a9e1-45dfe1be9b17"],
 " (each half between 1 and ",
 StyleBox["k", "TI"],
 ") or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"min", ",", " ", "max"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c96d3879-8292-4fb0-956f-6bd1ae704557"],
 " (each half between ",
 StyleBox["min", "TI"],
 " and ",
 StyleBox["max", "TI"],
 ", ",
 Cell[BoxData["max"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "424ac19b-0fa0-40ff-9832-71b518d96ac3"],
 " may be ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e410d83-30d9-4442-a5b0-80fde728b5eb"],
 "). The halves of an axis need not be equal. Each axis is maximal inside the \
range, so ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aadb85fa-dc78-406f-8a1a-5880828e8727"],
 " never returns a sub-line of a line."
}], "Notes",ExpressionUUID->"c1284e75-9915-4841-8506-8adec274c17e"],

Cell[TextData[{
 StyleBox["c", "TI"],
 " is a vertex, or an association ",
 Cell[BoxData[
  RowBox[{"<|", " ", 
   RowBox[{
    RowBox[{"v1", " ", "->", " ", "w1"}], ",", " ", "..."}], " ", "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9782afa2-7bd3-4a34-a1e8-32b44cd601a5"],
 " for a point realised by several vertices: the search is run from each ",
 StyleBox["v", "TI"],
 " on one ball, a set belongs to one anchor, and the duplicates are dropped."
}], "Notes",ExpressionUUID->"c899106e-2a4e-448b-9b2d-9f8346ccff93"],

Cell[TextData[{
 "The count-less call gives one set, a list of vertex lists; a count gives a \
list of sets. A vertex without a through-line, a path endpoint or a leaf, has \
no axis: the call gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4cf1fdd9-672d-4f90-b281-cd3c025564cf"],
 ". The rays from such a vertex are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalRays"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalRays", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9257056c-c554-4ad1-a06c-71d9a20ef773"],
 "."
}], "Notes",ExpressionUUID->"88a12289-c4e0-4e89-8617-8ab7951be82a"],

Cell[TextData[{
 "One ",
 Cell[BoxData["GraphDistanceMatrix"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e23045e-a611-48ce-b930-b478c5992691"],
 " on the ball of radius 2 ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " is read; no path is searched per candidate."
}], "Notes",ExpressionUUID->"577fe60c-63f7-48e2-a878-12937d75bdb7"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2f9d2d95-a36d-4e00-85e3-d48ab501eeff"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"210d1219-933e-46de-a1bb-9117a7ee0dec"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"54f397a3-a7e7-4764-8647-8adc872523d5"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"5e018664-ccde-4525-9a20-e78ecf83b7e8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ca8c90ab-f0a6-41bd-b60b-99fe7ed15034"], Cell[TextData[Cell[BoxData[
    "Properties"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "45836258-ca99-4bff-a4bf-892a5e37ef66"]], "TableText",ExpressionUUID->
     "8df484d8-7f71-42ac-a203-08833aa212c6"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "8816ee5b-5f87-4d1b-88f2-f8c9450e00f8"]], "TableText",ExpressionUUID->
     "acc3283d-71bd-412c-a9ad-40a47518fe59"], Cell[
    "the class of admissible next axes", "TableText",ExpressionUUID->
     "a6aab27f-fb3f-44e1-a072-35e5f7c8983a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "19295cba-6d56-4234-b3c8-0e3f078c3c80"], Cell[TextData[Cell[
    BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ca7ee99e-1a65-48a1-97b7-b3b8e7cafd3a"]], "TableText",ExpressionUUID->
     "8dc12bcf-9885-4641-b3e1-8013ff898b2e"], Cell[TextData[Cell[BoxData[
    "Identity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "e7d7f6fc-c599-4b50-aac8-47a5b95af150"]], "TableText",ExpressionUUID->
     "a7bc4f5f-7079-4486-9842-788d32bfc3bd"], Cell[
    "the order the candidates are tried in", "TableText",ExpressionUUID->
     "f0e4686f-8b08-45f1-8874-d94f300eed86"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9497ff23-2e27-4717-b188-9ebcdc7e27c4"], Cell[TextData[Cell[
    BoxData["\"\<AxisCount\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "cd31ad54-6fe5-4186-b059-0d2500da10a4"]], "TableText",ExpressionUUID->
     "dd0c1a42-d9f7-4784-b2df-b697b4d32b95"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c247af5a-c1da-4cc6-8e47-e06c112ec0d3"]], "TableText",ExpressionUUID->
     "5bafcb6a-a911-4291-bf69-636b8e6af960"], Cell[
    "the number of axes in a set", "TableText",ExpressionUUID->
     "09ab2169-0924-4bdf-8afe-52ff700af751"]}
  }]], "3ColumnTableMod",ExpressionUUID->"2207cb1c-4650-4f6e-bed3-\
eab7d5b33604"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", "Automatic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0af5479-a3ec-422f-ade1-280e2569c0c2"],
 " is the exact projection test above. A string or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"string", ",", " ", "opts"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c783289-c165-40fc-8f2e-3cc2ba3b1593"],
 " names a ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f47418bd-a318-431c-aedb-2af1ddc7a0e6"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e673a78e-1af4-44f1-8156-65e6a82ba70e"],
 ", checked between the candidate and every axis already chosen; any other \
value ",
 StyleBox["f", "TI"],
 " is a predicate on the list of the chosen axes plus the candidate, so ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "#", "]"}], " ", "<=", " ", "1"}], " ", "&"}], 
    ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64136e31-2c60-4e08-b385-a2f257b1fbc6"],
 " admits no pair."
}], "Notes",ExpressionUUID->"51b6439a-1bd1-45b7-b4c7-3e4949f01bc7"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "f"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa02c9b5-5c5d-49f7-bafa-1a5736bf3236"],
 " turns the ranked candidates into the order they are tried in. ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9375d94b-a605-4f9a-98a7-6827f3a318ba"],
 " keeps the ranking; ",
 Cell[BoxData["RandomSample"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "034124f8-1ce6-4df7-881e-0545fa2b8496"],
 " and any permutation change the order but not the class, so ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12e978d9-1e10-421d-8ed9-60859e695042"],
 " is the same set of sets; ",
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e959a89-8de5-459d-9496-728cec9d01fb"],
 " draws one candidate, so the count-less call is a random maximal set; ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    RowBox[{"RandomSample", "[", 
     RowBox[{"#", ",", " ", 
      RowBox[{"UpTo", "[", "k", "]"}]}], "]"}], " ", "&"}], ")"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "faea682c-3d34-4d8c-b1cd-4b05731b735a"],
 " prunes to ",
 StyleBox["k", "TI"],
 " candidates per node and so returns some of the maximal sets."
}], "Notes",ExpressionUUID->"e8687f61-6d6b-46f1-b30e-7a81b31d6572"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<AxisCount\>\"", " ", "->", " ", "k"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34530f18-72da-4923-805d-dc64aa78c3c0"],
 " keeps the sets of exactly ",
 StyleBox["k", "TI"],
 " axes, ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8905a86e-4289-4872-87b0-80e21c80b4c8"],
 " the sets of ",
 StyleBox["k", "TI"],
 " axes or fewer if maximal, ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62692610-6a05-4db8-ab0e-af605ffcfc40"],
 " every clique of any size, ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad668cdc-5a28-48dd-957f-2e404e0178a2"],
 " the maximal ones."
}], "Notes",ExpressionUUID->"c2c3feaa-998a-45ff-ab20-2459279c41fd"]
}, Open  ]],

