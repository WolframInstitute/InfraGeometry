Cell["\<\
A predicate on the chosen axes plus the candidate: here at most one axis, so \
every set is a single axis, and the number of sets is the number of maximal \
axes.\
\>", "ExampleText",ExpressionUUID->"bf2eda51-bed0-4073-b091-e40766418a3a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"sets", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", "13", ",", " ",
        "2", ",", " ", "All", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "#", "]"}], " ", "<=", " ", "1"}], " ", 
          "&"}], ")"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", "sets"}], ",", " ", 
     RowBox[{"Union", "[", 
      RowBox[{"Length", " ", "/@", " ", "sets"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c0893e19-ac71-4c1b-b4e5-52a11a1a857a"],

