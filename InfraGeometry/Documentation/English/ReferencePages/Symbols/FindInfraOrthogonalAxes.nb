Cell[TextData[{
 "The number of candidates grows like the geodesics from ",
 StyleBox["c", "TI"],
 ", not like the vertices. ",
 Cell[BoxData[
  RowBox[{"FindInfraOrthogonalAxes", "[", 
   RowBox[{
    RowBox[{"GridGraph", "[", 
     RowBox[{"{", 
      RowBox[{"30", ",", " ", "30"}], "}"}], "]"}], ",", " ", "465", ",", " ",
     "10"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "116055e4-191a-4646-aca7-aab311249aeb"],
 " takes about two minutes, where the coordinates of the same grid take a \
fraction of a second: take a short length, or ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "1", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "334a807f-8275-474a-a88d-a29053c5d938"],
 " sets, and fix the scale by the question."
}], "ExampleText",ExpressionUUID->"5f9c44ad-59da-40fa-9fcd-da09f09ee5e6"],

Cell[TextData[{
 "A bent axis is maximal on its own. The strict test requires that ",
 StyleBox["c", "TI"],
 " be the only nearest vertex, so a bent axis has no perpendicular partner, \
and ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0afa5ae-81da-4f69-af17-309551738145"],
 " lists it as a set of one axis, ranked after the straight cross."
}], "ExampleText",ExpressionUUID->"a06b169a-59b4-4474-9364-9883f5fd260e"],

Cell[TextData[{
 "The projection test does not tell a right angle from a straight angle: on \
the grid ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"d", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", ",", " ", "0"}], ")"}], ",", " ", 
      RowBox[{"(", 
       RowBox[{"0", ",", " ", "2"}], ")"}]}], ")"}]}], " ", "=", " ", 
   RowBox[{"4", " ", "=", " ", 
    RowBox[{"d", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", ",", " ", "0"}], ")"}], ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "2"}], ",", " ", "0"}], ")"}]}], ")"}]}]}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5e8931c-135f-4e03-a2a3-ab4c916f0a37"],
 ". The axes of a set are therefore lines, not rays; the rays of a frame are \
read through their opposites, see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalRays"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalRays", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "23382f9c-15ce-48c7-923b-630d5f5727ec"],
 "."
}], "ExampleText",ExpressionUUID->"b4a2fb49-ca8d-444d-8784-68dd79726a16"]
}, Open  ]],

