Cell[TextData[{
 "The exact test is the default. The ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ed95c1c-483a-494e-83f2-e8d73e57a54c"],
 " method of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bd728557-0b06-4659-ad47-6a2787740d0a"],
 " is a relaxation: two lines meeting only at ",
 StyleBox["c", "TI"],
 " pass it, so the straight cross takes four bent axes along (right), where \
the exact test keeps the cross alone (left)."
}], "ExampleText",ExpressionUUID->"70fa422d-457f-43c8-9428-cca7ff498498"],

