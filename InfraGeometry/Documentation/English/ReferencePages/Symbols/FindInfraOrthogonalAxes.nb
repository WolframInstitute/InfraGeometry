Cell[TextData[{
 "The exact test is the default. The ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d0fd920-3564-4a9a-b9c4-9b7daa4dc9ec"],
 " method of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "91bebb59-f0c5-477c-a630-a0db4872cd84"],
 " is a relaxation: two lines meeting only at ",
 StyleBox["c", "TI"],
 " pass it, so the straight cross takes four bent axes along (right), where \
the exact test keeps the cross alone (left)."
}], "ExampleText",ExpressionUUID->"9ef18dd9-f1b4-4adb-bbf9-52f8a7aff3bf"],

