Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrthogonalCoordinates"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrthogonalCoordinates", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7be630ee-a8cd-486f-8006-9f6eb8912d6e"],
 " reads the axes as coordinate lines. On the straight cross of the 9 x 9 \
grid the coordinates are a bijection onto the grid ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "4"}], ",", " ", "...", ",", " ", "4"}], "}"}], "^", "2"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e71e4885-5161-4f08-b67f-60e12485f729"],
 ", so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cde64927-0185-4865-bef1-ba853a4cd867"],
 " of the grid over them has the grid as its base."
}], "ExampleText",ExpressionUUID->"d9fd735f-fdc2-4ebc-a8d9-292b6f3749bd"],

