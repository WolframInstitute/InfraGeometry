Cell[TextData[{
 "A pruning to one candidate per node returns some maximal sets, a sample of ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed65f350-8f6c-4e1b-a01a-dd5912e7fdaf"],
 "."
}], "ExampleText",ExpressionUUID->"c0728c5b-3e80-494f-8919-be5e9b5eb7a2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"all", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{"g", ",", " ", "41", ",", " ", "2", ",", " ", "All"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sample", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"FindInfraOrthogonalAxes", "[", 
        RowBox[{"g", ",", " ", "41", ",", " ", "2", ",", " ", "All", ",", " ", 
         RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"RandomSample", "[", 
             RowBox[{"#", ",", " ", 
              RowBox[{"UpTo", "[", "1", "]"}]}], "]"}], " ", "&"}], ")"}]}]}],
         "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", "all"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "sample"}], ",", " ", 
     RowBox[{"SubsetQ", "[", 
      RowBox[{"all", ",", " ", "sample"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9d198f59-0224-4b61-9fa2-f5db48f988ec"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"27", ",", "1", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"76a85c8d-0677-4ccf-8c12-21dd3586941c"]
}, Open  ]]
