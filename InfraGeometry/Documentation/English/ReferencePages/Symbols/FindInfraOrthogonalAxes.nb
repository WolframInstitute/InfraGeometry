    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6845c90b-4915-4d4e-a70e-0f2463e2c328"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSpanningAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSpanningAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
