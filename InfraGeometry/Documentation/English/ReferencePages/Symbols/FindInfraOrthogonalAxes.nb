 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSpanningAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSpanningAxes", 
