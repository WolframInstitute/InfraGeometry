Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrthogonalCoordinates"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrthogonalCoordinates", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7d422b3c-c525-47d0-b004-451a834be3e7"],
 " reads the axes as coordinate lines. On the straight cross of the 9 x 9 \
grid the coordinates are a bijection onto the grid ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "4"}], ",", " ", "...", ",", " ", "4"}], "}"}], "^", "2"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "974009bd-a0c0-4500-a86c-fae3e7b06e49"],
 ", so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "912c6092-62ec-423b-9f7f-11275a2048f6"],
 " of the grid over them has the grid as its base."
}], "ExampleText",ExpressionUUID->"a1edf512-e1b8-41bf-9a0a-46370176db96"],

