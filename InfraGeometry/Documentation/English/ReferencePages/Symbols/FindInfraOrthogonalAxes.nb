Cell[TextData[{
 "An axis splits at ",
 StyleBox["c", "TI"],
 " into two rays: the straight cross of the 9 x 9 grid is two axes, and the \
same frame is four rays."
}], "ExampleText",ExpressionUUID->"283690c0-dd74-4fd4-910e-c76664b232d8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Length", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"FindInfraOrthogonalAxes", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", "3"}], "]"}], ",", " ", 
      RowBox[{"FindInfraOrthogonalRays", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", "3"}], "]"}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"b94c331b-65ce-4c37-a0e6-d4cd5dcd5c0c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "4"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"15e72667-d96a-4a23-9d5b-6773b538d12d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Possible Issues", "ExampleSection",ExpressionUUID->
   "dda06a82-eb41-4b48-8510-6cb821647761"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell[TextData[{
 "The number of candidates grows like the shortest paths from ",
 StyleBox["c", "TI"],
 ", not like the vertices. ",
 Cell[BoxData[
  RowBox[{"FindInfraOrthogonalAxes", "[", 
   RowBox[{
    RowBox[{"GridGraph", "[", 
     RowBox[{"{", 
      RowBox[{"30", ",", " ", "30"}], "}"}], "]"}], ",", " ", "465", ",", " ",
     "10"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7f61c90-c04d-4860-8964-8e5466fea65a"],
 " takes about two minutes, where the coordinates of the same grid take a \
fraction of a second: take a short length, or ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "1", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8f66c0e-5b8e-428f-97d2-956a34a6427c"],
 " sets, and fix the scale by the question."
}], "ExampleText",ExpressionUUID->"dc5c77e1-8cbe-4617-84ab-74b1c7877b30"],

Cell[TextData[{
 "A bent axis is maximal on its own. The strict test requires that ",
 StyleBox["c", "TI"],
 " be the only nearest vertex, so a bent axis has no perpendicular partner, \
and ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f04253f0-8345-463e-87f7-1c28a0a928b5"],
 " lists it as a set of one axis, ranked after the straight cross."
}], "ExampleText",ExpressionUUID->"b63e8ab3-42fb-4417-865b-2246953c416a"],

Cell[TextData[{
 "The projection test does not tell a right angle from a straight angle: on \
the grid ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"d", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", ",", " ", "0"}], ")"}], ",", " ", 
      RowBox[{"(", 
       RowBox[{"0", ",", " ", "2"}], ")"}]}], ")"}]}], " ", "=", " ", 
   RowBox[{"4", " ", "=", " ", 
    RowBox[{"d", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", ",", " ", "0"}], ")"}], ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "2"}], ",", " ", "0"}], ")"}]}], ")"}]}]}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28dacd2d-2f0c-4ce1-89f8-14e18fb39348"],
 ". The axes of a set are therefore lines, not rays; the rays of a frame are \
read through their opposites, see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalRays"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalRays", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
