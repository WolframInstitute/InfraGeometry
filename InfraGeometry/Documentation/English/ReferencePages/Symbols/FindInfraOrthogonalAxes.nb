Notebook[{

Cell[CellGroupData[{
Cell["FindInfraOrthogonalAxes", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"65452ac1-e0b5-4ccb-a57d-f17ed56ac25f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOrthogonalAxes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["len", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b03a06c-0f15-43fb-a1de-d386cc0e4597"],
 "\[LineSeparator]",
 "gives one maximal set of mutually perpendicular geodesic lines through the \
vertex ",
 StyleBox["c", "TI"],
 ", each a vertex list, the straightest set first.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"66052dae-e5a7-4b41-bffd-a58d2452587b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraOrthogonalAxes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["len", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5514508f-3b00-4e51-bb5d-50f0b916a7ad"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b96bdb0c-1db8-4efb-9e90-8193e80aa980"],
 " of exactly ",
 StyleBox["n", "TI"],
 " such sets or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "026eeaa8-f844-4d26-90c9-b20e181f2d21"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01423b5c-1c3b-46ca-bed7-ff68cf4cb303"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d8054e4-98e1-4d56-8be5-b444b7269278"],
 " gives every one."
}], "Usage",ExpressionUUID->"eda18c95-7e9f-4820-a5a0-abce2d80b740"],

Cell[TextData[{
 "The problem is well posed. Fix a graph ",
 StyleBox["g", "TI"],
 ", a vertex ",
 StyleBox["c", "TI"],
 " and a length ",
 StyleBox["len", "TI"],
 "."
}], "Notes",ExpressionUUID->"c2186557-1056-443b-835f-cf0c6b6931bc"],

Cell[TextData[{
 "An ",
 StyleBox["axis",
  FontWeight->"Bold"],
 " at ",
 StyleBox["c", "TI"],
 " is a geodesic through ",
 StyleBox["c", "TI"],
 ", a vertex list whose two halves from ",
 StyleBox["c", "TI"],
 " have lengths in ",
 StyleBox["len", "TI"],
 ", maximal there: neither end extends by one step to a longer geodesic \
through ",
 StyleBox["c", "TI"],
 " inside ",
 StyleBox["len", "TI"],
 ". The axes form a finite set, since a geodesic of the range lies in the \
ball of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 ", ",
 StyleBox["r", "TI"],
 " the largest half-length; for ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9d2ad8b-0c4a-4560-8b71-ef46da91d507"],
 " it is the whole component of ",
 StyleBox["c", "TI"],
 "."
}], "Notes",ExpressionUUID->"87ad6815-a73c-42c6-a477-5e2acb80cab3"],

Cell[TextData[{
 "Two axes are ",
 StyleBox["perpendicular",
  FontWeight->"Bold"],
 " when the shortest-path projection of every vertex of each onto the other \
is ",
 StyleBox["c", "TI"],
 ": every vertex of one has ",
 StyleBox["c", "TI"],
 " as its only nearest vertex on the other. On the distance matrix this is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"d", 
    RowBox[{"(", 
     RowBox[{"v", ",", " ", "w"}], ")"}]}], " ", ">", " ", 
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{"d", 
      RowBox[{"(", 
       RowBox[{"c", ",", " ", "v"}], ")"}]}], ",", " ", 
     RowBox[{"d", 
      RowBox[{"(", 
       RowBox[{"c", ",", " ", "w"}], ")"}]}]}], "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b73deb1e-9e41-4dde-87ca-8f4bad9c926f"],
 " for every vertex ",
 StyleBox["v", "TI"],
 " of one and ",
 StyleBox["w", "TI"],
 " of the other, both different from ",
 StyleBox["c", "TI"],
 ". The test is exact, symmetric and does not depend on the order of the axes."
}], "Notes",ExpressionUUID->"d7de67da-1f0d-462c-9205-b0942d1e8051"],

Cell[TextData[{
 "Perpendicularity is a symmetric relation on a finite set, so the sets of \
mutually perpendicular axes are the cliques of a finite graph. The largest \
number of mutually perpendicular lines through ",
 StyleBox["c", "TI"],
 " is its clique number, and a maximal set cannot be extended by one more \
axis. The call returns maximal sets; the largest of them is the largest of ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00a8b896-3879-4081-bb9f-a7ee2b0d8bcb"],
 ". On ",
 Cell[BoxData[
  RowBox[{"GridGraph", "[", 
   RowBox[{"{", 
    RowBox[{"5", ",", " ", "...", ",", " ", "5"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81dc6875-fe1d-4bff-aaf7-a9058db1dc7d"],
 " at its centre the largest set has ",
 StyleBox["d", "TI"],
 " axes, the dimension."
}], "Notes",ExpressionUUID->"81f13b93-a2a8-4a69-a05c-2c3962aca28a"],

Cell[TextData[{
 "A bent geodesic through ",
 StyleBox["c", "TI"],
 " is an axis too, so the sets of ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e95a5daa-a736-4e65-959d-38944ed1699a"],
 " include crosses that turn at ",
 StyleBox["c", "TI"],
 ". They are ranked after the straight one: a longer axis first, then fewer \
vertices in the geodesic interval of its ends, which is the axis itself \
exactly when the geodesic is unique, as the straight lines of a grid are. The \
count-less call and ",
 Cell[BoxData[
  RowBox[{"n", " ", "=", " ", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ac505f1-ee74-4e9d-8780-62208c2a0e49"],
 " give the first set in that order."
}], "Notes",ExpressionUUID->"09be9f07-67ff-450e-b4bb-9c201aaae478"],

Cell[TextData[{
 StyleBox["len", "TI"],
 " is ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cb2fe69-be99-4eb3-91f3-35c781297caf"],
 ", an integer ",
 StyleBox["k", "TI"],
 " (both halves of length ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f64a295-2284-4d95-8540-0d5d96c3404e"],
 " (each half between 1 and ",
 StyleBox["k", "TI"],
 ") or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"min", ",", " ", "max"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9c19db7-6569-4f96-817b-9e763cbddc3b"],
 " (each half between ",
 StyleBox["min", "TI"],
 " and ",
 StyleBox["max", "TI"],
 ", ",
 Cell[BoxData["max"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98d9845b-5ef2-4785-bbb6-ff0863b5c6ff"],
 " may be ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df1b9488-118d-4a5a-96b7-ba0d7412439e"],
 "). The halves of an axis need not be equal. Each axis is maximal inside the \
range, so ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "025fe2fa-2591-43f7-b7b6-243f21e9d91f"],
 " never returns a sub-line of a line."
}], "Notes",ExpressionUUID->"b035e01f-610e-4994-bfd6-4e2ff5ce82cf"],

Cell[TextData[{
 StyleBox["c", "TI"],
 " is a vertex, or an association ",
 Cell[BoxData[
  RowBox[{"<|", " ", 
   RowBox[{
    RowBox[{"v1", " ", "->", " ", "w1"}], ",", " ", "..."}], " ", "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd54e160-f496-4264-ae95-9e0860a82b6d"],
 " for a point realised by several vertices: the search is run from each ",
 StyleBox["v", "TI"],
 " on one ball, a set belongs to one anchor, and the duplicates are dropped."
}], "Notes",ExpressionUUID->"9bdee4e6-8c66-4102-bc4d-f9c82f091936"],

Cell[TextData[{
 "The count-less call gives one set, a list of vertex lists; a count gives a \
list of sets. A vertex without a through-line, a path endpoint or a leaf, has \
no axis: the call gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b3fd4b9-6333-4179-86e4-7ab4bccafada"],
 ". The rays from such a vertex are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalRays"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalRays", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e108001a-3840-4754-a5e0-96028715f1e2"],
 "."
}], "Notes",ExpressionUUID->"d0a5eb01-4bbb-4121-8cd3-a8eba00b9c06"],

Cell[TextData[{
 "One ",
 Cell[BoxData["GraphDistanceMatrix"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14517329-bd7b-49ae-ad54-91ac5e63b09a"],
 " on the ball of radius 2 ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " is read; no path is searched per candidate."
}], "Notes",ExpressionUUID->"b712bcd1-270c-4829-b5df-3b66836032bd"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "03c023ac-20f2-48ca-836e-543dd59f779e"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"b57c1054-897e-48f4-8bef-ab746e9cff89"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"9b152251-f837-4d63-a444-79a31106c851"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"7fb5daa4-6e0c-4a0a-98ea-842638896e42"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d3568362-7bb7-48bf-b95f-26251e9da165"], Cell[TextData[Cell[BoxData[
    "Properties"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "04480acc-6b91-4a11-9111-aef3f1aae709"]], "TableText",ExpressionUUID->
     "aedc7ecd-a671-4bc7-8f56-074c5d5f425f"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f628d77f-8296-4b7b-89b2-d8934a8245ed"]], "TableText",ExpressionUUID->
     "402ecd27-bcf7-45bb-8ea8-7064793dfbfc"], Cell[
    "the class of admissible next axes", "TableText",ExpressionUUID->
     "4eeefa87-7275-49da-b56e-c562e0d46f60"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "71cfbf4f-fced-48a5-9ebb-140e40b7a470"], Cell[TextData[Cell[
    BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0dcc5290-543a-4def-8380-aa0d110c2bfe"]], "TableText",ExpressionUUID->
     "5185c221-c640-4617-988d-6bbf2f0e70b6"], Cell[TextData[Cell[BoxData[
    "Identity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "eca00593-4171-40a0-b36d-13132bb72bf5"]], "TableText",ExpressionUUID->
     "72b86d57-c960-4967-81ce-c11bb35c3fc6"], Cell[
    "the order the candidates are tried in", "TableText",ExpressionUUID->
     "9f74c157-8ad8-4058-af7b-67fe56986005"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6edeb6d8-a5fe-4608-b1d1-226755158c5b"], Cell[TextData[Cell[
    BoxData["\"\<AxisCount\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c37f61cf-bee1-4efc-8700-10b7f9269355"]], "TableText",ExpressionUUID->
     "31c1cac5-5c1d-44ae-ab7b-6539614d0506"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "12d7987c-34b5-44b6-997a-f63cf49014b0"]], "TableText",ExpressionUUID->
     "4145d255-370b-41ca-acb7-fafcd394b97d"], Cell[
    "the number of axes in a set", "TableText",ExpressionUUID->
     "598fad27-61ae-4fbd-8567-04e077c136b2"]}
  }]], "3ColumnTableMod",ExpressionUUID->"4d7dd338-c253-4df0-842c-\
0065659e1c4e"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", "Automatic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "877cdabf-5fe4-4511-ae60-38985da6736d"],
 " is the exact projection test above. A string or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"string", ",", " ", "opts"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60ec01c0-f312-4f07-83d6-1448491e8b43"],
 " names a ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16dffe2c-6913-4b33-994c-fb10cef38360"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "511d8327-5e39-42e7-825b-460d1808276c"],
 ", checked between the candidate and every axis already chosen; any other \
value ",
 StyleBox["f", "TI"],
 " is a predicate on the list of the chosen axes plus the candidate, so ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "#", "]"}], " ", "<=", " ", "1"}], " ", "&"}], 
    ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ebba7b5-a5be-48e7-b378-d09a1d2ab7aa"],
 " admits no pair."
}], "Notes",ExpressionUUID->"f98efef2-45d9-4c50-91aa-bb2fdc801ad7"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "f"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aae491b-2ffe-4109-a5a7-c56e6b702a34"],
 " turns the ranked candidates into the order they are tried in. ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec0ac0a9-a291-43bc-89cc-b52f12fbd065"],
 " keeps the ranking; ",
 Cell[BoxData["RandomSample"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "908127c1-b38a-4b98-85d6-03804a019bd5"],
 " and any permutation change the order but not the class, so ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3388cbc1-e4e8-473f-ac4d-722834f48398"],
 " is the same set of sets; ",
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bde513b-14fa-48d3-8511-6814f6ea165e"],
 " draws one candidate, so the count-less call is a random maximal set; ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    RowBox[{"RandomSample", "[", 
     RowBox[{"#", ",", " ", 
      RowBox[{"UpTo", "[", "k", "]"}]}], "]"}], " ", "&"}], ")"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba993d57-764e-49f6-bc88-c2755c287688"],
 " prunes to ",
 StyleBox["k", "TI"],
 " candidates per node and so returns some of the maximal sets."
}], "Notes",ExpressionUUID->"7d65667b-b23f-4c4f-a698-e6eb54a49daa"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<AxisCount\>\"", " ", "->", " ", "k"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "200f06ab-701e-431e-8271-d7997e2eabe4"],
 " keeps the sets of exactly ",
 StyleBox["k", "TI"],
 " axes, ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c356660-f34b-4fff-a95b-43c872990432"],
 " the sets of ",
 StyleBox["k", "TI"],
 " axes or fewer if maximal, ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e713892-1152-4a7a-a92c-de90cfa9b8ac"],
 " every clique of any size, ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99faaf76-84be-4e5e-9168-eef39df05fba"],
 " the maximal ones."
}], "Notes",ExpressionUUID->"c092cf79-c912-49ea-8851-c7792812824f"]
}, Open  ]],

