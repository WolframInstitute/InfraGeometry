Cell[TextData[{
 "An axis splits at ",
 StyleBox["c", "TI"],
 " into two rays: the straight cross of the 9 x 9 grid is two axes, and the \
same frame is four rays."
}], "ExampleText",ExpressionUUID->"25cf0415-8ec8-4a6c-9953-335418e28fc7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Length", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"FindInfraOrthogonalAxes", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", "3"}], "]"}], ",", " ", 
      RowBox[{"FindInfraOrthogonalRays", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", "3"}], "]"}]}], "}"}]}]}], 
  "]"}]], "Input",
