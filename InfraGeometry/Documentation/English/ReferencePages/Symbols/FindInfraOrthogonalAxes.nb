Cell[TextData[{
 "The number of candidates grows like the geodesics from ",
 StyleBox["c", "TI"],
 ", not like the vertices. ",
 Cell[BoxData[
  RowBox[{"FindInfraOrthogonalAxes", "[", 
   RowBox[{
    RowBox[{"GridGraph", "[", 
     RowBox[{"{", 
      RowBox[{"30", ",", " ", "30"}], "}"}], "]"}], ",", " ", "465", ",", " ",
     "10"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3588866-ed1e-448d-be13-5e8eb6f7fd86"],
 " takes about two minutes, where the coordinates of the same grid take a \
fraction of a second: take a short length, or ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "1", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "457afe4c-4869-435c-bba8-a9fd11e4866d"],
 " sets, and fix the scale by the question."
}], "ExampleText",ExpressionUUID->"7f682f4e-c533-4247-bff8-f61f2b9f36a1"],

Cell[TextData[{
 "A bent axis is maximal on its own. The strict test requires that ",
 StyleBox["c", "TI"],
 " be the only nearest vertex, so a bent axis has no perpendicular partner, \
and ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "447c91bd-aa67-4674-abf2-e2199e8af08b"],
 " lists it as a set of one axis, ranked after the straight cross."
}], "ExampleText",ExpressionUUID->"ed2f2b54-a285-46e9-b7dc-7a45d9cd725b"],

Cell[TextData[{
 "The projection test does not tell a right angle from a straight angle: on \
the grid ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"d", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", ",", " ", "0"}], ")"}], ",", " ", 
      RowBox[{"(", 
       RowBox[{"0", ",", " ", "2"}], ")"}]}], ")"}]}], " ", "=", " ", 
   RowBox[{"4", " ", "=", " ", 
    RowBox[{"d", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", ",", " ", "0"}], ")"}], ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "2"}], ",", " ", "0"}], ")"}]}], ")"}]}]}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e9aca85-d34d-4581-9faf-293fc8d24b75"],
 ". The axes of a set are therefore lines, not rays; the rays of a frame are \
read through their opposites, see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalRays"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalRays", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c83cd6e9-ba11-47cc-b8de-da80799d839f"],
 "."
}], "ExampleText",ExpressionUUID->"3e252406-de06-4913-a171-0f436b0b6890"]
}, Open  ]],

