           RowBox[{"#", ",", " ", 
            RowBox[{"{", "13", "}"}]}], "]"}]}], "]"}], " ", "&"}], " ", "/@",
        " ", 
       RowBox[{"Take", "[", 
        RowBox[{"single", ",", " ", "3"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "single"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e17ee6c5-dc14-4900-ad58-b72a4fbb301d"],

