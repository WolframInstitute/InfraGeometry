Cell[TextData[{
 "A length is an integer, ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4532c14b-6692-41ad-ac2e-9dc8d5a5e738"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"min", ",", " ", "max"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8b6eaf4-030b-4bc9-a271-d33c2e570953"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "168bf632-021c-4ed3-a33f-237042dbc059"],
 ". On a bounded grid ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a6f3f49-6b43-410e-b580-c1710925a3d0"],
 " reaches the walls, and a straight line through the centre extends by a \
turn, so only corner-to-corner geodesics are maximal."
}], "ExampleText",ExpressionUUID->"a3cc5361-6f2c-4d85-82e9-b31dda7c804c"],

