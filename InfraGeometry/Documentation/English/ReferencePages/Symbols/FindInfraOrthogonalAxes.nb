 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9a5f2305-414b-49ce-8be1-e4dcca2bc2a2"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSpanningAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSpanningAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "41e7d05a-8d3a-443b-8712-fca5eeff3a56"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "10b0757d-56a4-4586-a807-3f3014b26d8f"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
