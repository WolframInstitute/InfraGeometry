Cell[CellGroupData[{

Cell["AxisCount", "ExampleSubsection",ExpressionUUID->"d34ec7c0-8b40-4b3d-85e4-ac043e386ee3"],

Cell["\<\
The sets of exactly one axis: every single axis of scale 2 that is maximal, \
the bent ones included, 30 on the 5 x 5 grid at its centre.\
\>", "ExampleText",ExpressionUUID->"88b03440-6b2a-4e3e-b72a-fa297b3af47f"],

