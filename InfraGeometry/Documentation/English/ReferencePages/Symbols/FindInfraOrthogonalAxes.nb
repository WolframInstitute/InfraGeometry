Cell["\<\
Halves of different lengths: at least 2 and at most 4 steps on each side of \
the centre.\
\>", "ExampleText",ExpressionUUID->"1036411f-a2c6-4085-b8a4-b71fbae29218"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axes", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"Append", "[", 
      RowBox[{"axes", ",", " ", 
       RowBox[{"{", "c", "}"}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6ac04115-20f3-4a04-89e5-578b1920d283"],

