Cell[CellGroupData[{

Cell["AxisCount", "ExampleSubsection",ExpressionUUID->"16508e10-9e41-47e5-a39c-51fe4efd9489"],

Cell["\<\
The sets of exactly one axis: every single axis of scale 2 that is maximal, \
the bent ones included, 30 on the 5 x 5 grid at its centre.\
\>", "ExampleText",ExpressionUUID->"7fecf411-53e9-4c90-9f19-c465b0339aea"],

