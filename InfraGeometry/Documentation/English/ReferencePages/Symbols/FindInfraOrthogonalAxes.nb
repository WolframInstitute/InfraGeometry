Cell["\<\
Two axes of a set are perpendicular by the exact test, and the set is \
maximal: no axis of the range can be added to it.\
\>", "ExampleText",ExpressionUUID->"c75508a2-785c-4a08-9096-f35e2959e3d1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"g", " ", "=", " ", 
      RowBox[{"GridGraph", "[", 
       RowBox[{"{", 
        RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"c", " ", "=", " ", "41"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sets", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "2", ",", " ", "All"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"perpendicular", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b"}], "}"}], " ", "|->", " ", 
       RowBox[{"And", " ", "@@", " ", 
        RowBox[{"Flatten", " ", "@", " ", 
         RowBox[{"Table", "[", "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "v", ",", " ", "w"}], "]"}], " ", ">", 
            " ", 
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"GraphDistance", "[", 
               RowBox[{"g", ",", " ", "c", ",", " ", "v"}], "]"}], ",", " ", 
              RowBox[{"GraphDistance", "[", 
               RowBox[{"g", ",", " ", "c", ",", " ", "w"}], "]"}]}], "]"}]}], 
           ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"v", ",", " ", 
             RowBox[{"DeleteCases", "[", 
              RowBox[{"a", ",", " ", "c"}], "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"w", ",", " ", 
             RowBox[{"DeleteCases", "[", 
              RowBox[{"b", ",", " ", "c"}], "]"}]}], "}"}]}], "]"}]}]}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"AllTrue", "[", 
      RowBox[{"sets", ",", " ", 
       RowBox[{"set", " ", "|->", " ", 
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"Subsets", "[", 
           RowBox[{"set", ",", " ", 
            RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"perpendicular", " ", "@@", " ", "#"}], " ", "&"}]}], 
         "]"}]}]}], "]"}], ",", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Length", " ", "/@", " ", "sets"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5e2d54b6-4a02-43ca-8ffa-0a8e66ecf396"],

