Cell["NextVertexFunction", "ExampleSubsection",ExpressionUUID->"754f81ee-078c-4a27-b495-5f5330433429"],

Cell[TextData[{
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4dc5d1d-6296-44d6-bbb2-e101257042de"],
 " draws the candidates at random, so the count-less call is a random maximal \
set. Three draws at scale 2 on the 9 x 9 grid."
}], "ExampleText",ExpressionUUID->"f8f39799-ba21-4958-a8e4-c872f74d0c61"],

