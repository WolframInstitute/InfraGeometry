      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"single", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{"g", ",", " ", "13", ",", " ", "2", ",", " ", "All", ",", " ", 
       RowBox[{"\"\<AxisCount\>\"", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
