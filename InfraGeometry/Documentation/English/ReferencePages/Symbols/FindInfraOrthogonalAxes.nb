Cell["NextVertexFunction", "ExampleSubsection",ExpressionUUID->"3c817cb9-be2a-4234-b7d4-9d002ef93819"],

Cell[TextData[{
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bee006f-97a4-46a2-85ff-7a3779d3ced0"],
 " draws the candidates at random, so the count-less call is a random maximal \
set. Three draws at scale 2 on the 9 x 9 grid."
}], "ExampleText",ExpressionUUID->"ae2ecf05-51d9-4c45-9a68-b3a4ccb4a9b5"],

