Cell["AxisCount", "ExampleSubsection",ExpressionUUID->"6371d75f-33f7-453e-8bb6-f33df75521ef"],

Cell["\<\
The sets of exactly two axes of length 2 on the grid: the straight cross and \
two crosses that turn at the centre:\
\>", "ExampleText",ExpressionUUID->"c28986f8-46ac-433b-aa01-a2cbb52362f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sets", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", "2", ",", " ", "All", ",", " ", 
       RowBox[{"\"\<AxisCount\>\"", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"InfraWalk", " ", "/@", " ", "set"}], ",", " ", "45"}], 
         "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"set", ",", " ", "sets"}], "}"}]}], "]"}]}]}], "]"}]], "Input",\

