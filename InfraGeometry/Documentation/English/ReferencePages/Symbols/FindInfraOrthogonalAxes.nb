Cell["\<\
A predicate on the chosen axes plus the candidate: here at most one axis, so \
every set is a single axis, and the number of sets is the number of maximal \
axes.\
\>", "ExampleText",ExpressionUUID->"d71dfd63-a348-4163-9f4a-7ead58d81e23"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"sets", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", "13", ",", " ",
        "2", ",", " ", "All", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "#", "]"}], " ", "<=", " ", "1"}], " ", 
          "&"}], ")"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", "sets"}], ",", " ", 
     RowBox[{"Union", "[", 
      RowBox[{"Length", " ", "/@", " ", "sets"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"06290a57-631a-40e5-8bcd-59eca3a30e99"],

