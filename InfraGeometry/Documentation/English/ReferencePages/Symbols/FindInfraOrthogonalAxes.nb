Cell[CellGroupData[{

Cell["AxisCount", "ExampleSubsection",ExpressionUUID->"0962cc6a-12d0-471c-ab16-4f0367353ea3"],

Cell["\<\
The sets of exactly one axis: every single axis of scale 2 that is maximal, \
the bent ones included, 30 on the 5 x 5 grid at its centre.\
\>", "ExampleText",ExpressionUUID->"3497f682-06bc-43fe-a43f-7e1e7edd1965"],

