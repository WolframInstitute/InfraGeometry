Cell["\<\
The projection distinguishes a valid partial section from a value in the \
wrong fiber.\
\>", "ExampleText",ExpressionUUID->"a5e87f83-e8e7-4d81-a784-a801eb9f4767"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"PathGraph", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], ",", " ", "Identity"}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"InfraSectionQ", "[", 
      RowBox[{"fib", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraSection", "[", 
       RowBox[{"<|", 
        RowBox[{"1", " ", "->", " ", "1"}], "|>"}], "]"}], ",", " ", 
      RowBox[{"InfraSection", "[", 
       RowBox[{"<|", 
        RowBox[{"1", " ", "->", " ", "2"}], "|>"}], "]"}], ",", " ", 
      RowBox[{"InfraSection", "[", 
       RowBox[{"<|", "|>"}], "]"}]}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9be35d18-9c3e-4fb6-838f-8d28e2c3f7fa"],

Cell[BoxData[
