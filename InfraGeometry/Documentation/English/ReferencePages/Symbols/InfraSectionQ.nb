Cell["A section picks one vertex in each selected fiber.", "ExampleText",ExpressionUUID->"d7d316df-0af5-46e4-806b-b274452b0ddd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"Graph", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{"1", ",", " ", "3"}], "]"}], ",", " ", 
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{"2", ",", " ", "4"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<a\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<a\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<b\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<b\>\""}]}], "|>"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"section", " ", "=", " ", 
     RowBox[{"RandomInfraSection", "[", "fib", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", 
      RowBox[{"fib", ",", " ", "section"}], "]"}], ",", " ", 
     RowBox[{"InfraSectionQ", "[", 
      RowBox[{"fib", ",", " ", "section"}], "]"}]}], "}"}]}], "]"}]}], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"2ba70817-9c9f-44a1-84a3-57906cdcfe52"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   GraphicsBox[
    NamespaceBox["NetworkGraphics",
     DynamicModuleBox[{Typeset`graph = HoldComplete[
       Graph[{1, 2, 3, 4}, {Null, {{1, 3}, {2, 4}}}, {
        EdgeStyle -> {UndirectedEdge[2, 4] -> Directive[
             RGBColor[0.790588, 0.201176, 0.], 
             Opacity[1.], 
             AbsoluteThickness[1.]]}, GraphLayout -> {"Dimension" -> 2}, 
         VertexCoordinates -> {{1.3333333333333333`, 0.}, {0.6666666666666667,
           0.}, {-0.6666666666666667, 0.}, {-1.3333333333333333`, 0.}}, 
         VertexShapeFunction -> {4 -> (Append[{
              RGBColor[0.790588, 0.201176, 0.], 
              Opacity[1.]}, 
             Disk[#, 1 #3]]& ), 2 -> (Append[{
              RGBColor[0.790588, 0.201176, 0.], 
              Opacity[1.]}, 
             Disk[#, 1 #3]]& )}, 
         VertexStyle -> {
          2 -> RGBColor[0.9057646, 0.6405292, 0.55], 1 -> 
           RGBColor[0.9057646, 0.6405292, 0.55], 3 -> 
           RGBColor[0.63647065, 0.72470575, 0.91352935], 4 -> 
           RGBColor[0.63647065, 0.72470575, 0.91352935]}}]]}, 
      TagBox[GraphicsGroupBox[{
         {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], 
          LineBox[{
           DynamicLocation["VertexID$1", Automatic, Center], DynamicLocation[
            "VertexID$3", Automatic, Center]}], 
          {RGBColor[0.790588, 0.201176, 0.], AbsoluteThickness[1.], Opacity[
           1.], LineBox[{
            DynamicLocation["VertexID$2", Automatic, Center], DynamicLocation[
             "VertexID$4", Automatic, Center]}]}}, 
         {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
          TagBox[
           {RGBColor[0.9057646, 0.6405292, 0.55], 
            DiskBox[{1.3333333333333333`, 0.}, 0.027800407331975557]},
           "DynamicName",
           BoxID -> "VertexID$1"], 
          TagBox[
           {RGBColor[0.9057646, 0.6405292, 0.55], 
            {RGBColor[0.790588, 0.201176, 0.], Opacity[1.], 
             DiskBox[{0.6666666666666667, 0.}, 0.027800407331975557]}},
           "DynamicName",
           BoxID -> "VertexID$2"], 
          TagBox[
           {RGBColor[0.63647065, 0.72470575, 0.91352935], 
            DiskBox[{-0.6666666666666667, 0.}, 0.027800407331975557]},
           "DynamicName",
           BoxID -> "VertexID$3"], 
          TagBox[
           {RGBColor[0.63647065, 0.72470575, 0.91352935], 
            {RGBColor[0.790588, 0.201176, 0.], Opacity[1.], 
             DiskBox[{-1.3333333333333333`, 0.}, 0.027800407331975557]}},
           "DynamicName",
           BoxID -> "VertexID$4"]}}],
       MouseAppearanceTag["NetworkGraphics"]],
      AllowKernelInitialization->False]],
    DefaultBaseStyle->"NetworkGraphics",
    FormatType->TraditionalForm,
    FrameTicks->None], ",", "True"}], "}"}]], "Output",
