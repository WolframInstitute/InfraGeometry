           RowBox[{"First", " ", "@", " ", "wrong"}]}]}], "]"}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"InfraSectionQ", "[", 
      RowBox[{"fib", ",", " ", "wrong"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a1ff5b9d-3484-4089-af6f-006f6c0a21c0"],

