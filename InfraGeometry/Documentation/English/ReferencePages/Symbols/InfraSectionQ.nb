Cell["\<\
The projection distinguishes a valid partial section from a value in the \
wrong fiber.\
\>", "ExampleText",ExpressionUUID->"c7cf3dba-343b-4492-8558-fb7ab53c2f0d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"PathGraph", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], ",", " ", "Identity"}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"InfraSectionQ", "[", 
      RowBox[{"fib", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraSection", "[", 
       RowBox[{"<|", 
        RowBox[{"1", " ", "->", " ", "1"}], "|>"}], "]"}], ",", " ", 
      RowBox[{"InfraSection", "[", 
       RowBox[{"<|", 
        RowBox[{"1", " ", "->", " ", "2"}], "|>"}], "]"}], ",", " ", 
      RowBox[{"InfraSection", "[", 
       RowBox[{"<|", "|>"}], "]"}]}], "}"}]}]}], "]"}]}], "Input",
