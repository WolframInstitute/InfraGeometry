Cell["A section picks one vertex in each selected fiber.", "ExampleText",ExpressionUUID->"8c0707e9-0cd0-49ae-bfc7-da54ea8e6774"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"Graph", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{"1", ",", " ", "3"}], "]"}], ",", " ", 
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{"2", ",", " ", "4"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<a\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<a\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<b\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<b\>\""}]}], "|>"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"section", " ", "=", " ", 
     RowBox[{"RandomInfraSection", "[", "fib", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", 
      RowBox[{"fib", ",", " ", "section"}], "]"}], ",", " ", 
     RowBox[{"InfraSectionQ", "[", 
      RowBox[{"fib", ",", " ", "section"}], "]"}]}], "}"}]}], "]"}]}], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"5d51b695-8870-450c-8496-fd8083371e95"],

