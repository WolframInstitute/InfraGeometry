Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"80d39adc-4679-420b-bf28-b618ed8ae9b6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSectionQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSectionQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    RowBox[{"InfraSection", "[", 
     StyleBox["s", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6df3855d-0fc9-4af1-b79f-1a7d15546007"],
 "\[LineSeparator]",
 "tests whether every value of the association ",
 StyleBox["s", "TI"],
 " lies over its key.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ef7f0a61-e672-4f30-82ab-ce6d78b0edc3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSectionQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSectionQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["section1", "TI"], ",", " ", 
      StyleBox["section2", "TI"], ",", " ", "..."}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "373c7e0e-6a97-4f7c-8069-0a6e3337326a"],
 "\[LineSeparator]",
 "tests whether every section in a nonempty collection satisfies this \
condition."
}], "Usage",ExpressionUUID->"b46e3e99-f515-4edf-9bb1-a322898025ef"],

Cell[TextData[{
 "The keys of ",
 StyleBox["s", "TI"],
 " specify its domain. They need not cover the whole reconstructed base."
}], "Notes",ExpressionUUID->"0bc3bf7c-853d-40c4-85b1-4e7af0b68a44"],

Cell[TextData[{
 "The right-inverse condition is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"projection", "[", 
    RowBox[{"s", "[", "p", "]"}], "]"}], " ", "==", " ", "p"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a71e5b2-d9d9-4e0e-8c10-71cb6da7b2e6"],
 " on that domain, with literal association keys."
}], "Notes",ExpressionUUID->"1c07aa5d-caf4-4702-8181-8a72aea91027"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraSection", "[", 
   RowBox[{"<|", "|>"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ca123d2-26ed-4f12-a778-e73dcda749c6"],
 " is a valid empty partial section."
}], "Notes",ExpressionUUID->"2892f8b0-2119-4826-94e1-1744c00b3760"],

Cell[TextData[{
 "An empty collection returns ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a35f367f-3bb8-45f5-aeca-028da4075394"],
 ". It is distinct from one empty section."
}], "Notes",ExpressionUUID->"766eb00f-f394-430d-a4cb-24f09f12c6ff"],

Cell["\<\
Undecided predicates in a collection remain as a conjunction. Malformed \
objects and unsupported fibered data remain unevaluated.\
\>", "Notes",ExpressionUUID->"41f5fcaf-32f4-4d68-a3b3-581cd709cb5d"]
}, Open  ]],

