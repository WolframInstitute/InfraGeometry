Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c5ad54a2-8dc4-4539-8af8-479181368a4b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSectionQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSectionQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    RowBox[{"InfraSection", "[", 
     StyleBox["s", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "720844f2-baf7-457d-b827-d072ffeb0ac3"],
 "\[LineSeparator]",
 "tests whether every value of the association ",
 StyleBox["s", "TI"],
 " lies over its key.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a70e6b96-da12-43a1-a3b0-acfd8fdd26de"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSectionQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSectionQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["section1", "TI"], ",", " ", 
      StyleBox["section2", "TI"], ",", " ", "..."}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63d1baaf-85f5-4b42-aaf1-de910db42331"],
 "\[LineSeparator]",
 "tests whether every section in a nonempty collection satisfies this \
condition."
}], "Usage",ExpressionUUID->"44ea135f-b6a0-4b17-ac3d-567828eab7d9"],

Cell[TextData[{
 "The keys of ",
 StyleBox["s", "TI"],
 " specify its domain. They need not cover the whole reconstructed base."
}], "Notes",ExpressionUUID->"8514db7a-4491-4f51-9931-f8d09cff0b63"],

Cell[TextData[{
 "The right-inverse condition is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"projection", "[", 
    RowBox[{"s", "[", "p", "]"}], "]"}], " ", "==", " ", "p"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45c676a6-fe43-4b80-9859-6932e78c5b64"],
 " on that domain, with literal association keys."
}], "Notes",ExpressionUUID->"8a806ad7-4e37-4ace-8b0a-c9348a8771df"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraSection", "[", 
   RowBox[{"<|", "|>"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d68634e-fd03-4c0c-8167-b5f6c6e225ec"],
 " is a valid empty partial section."
}], "Notes",ExpressionUUID->"0263deb6-3ad9-4956-b2ba-2865edffaad7"],

Cell[TextData[{
 "An empty collection returns ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "edb836c5-5afa-4af4-b830-f8997e173728"],
 ". It is distinct from one empty section."
}], "Notes",ExpressionUUID->"a37cb25f-6469-49ab-b3cc-1603c3d14a4d"],

Cell["\<\
Undecided predicates in a collection remain as a conjunction. Malformed \
objects and unsupported fibered data remain unevaluated.\
\>", "Notes",ExpressionUUID->"a13a762f-b131-4201-a635-7411c15fa0f5"]
}, Open  ]],

