}, Open  ]],

Cell["\<\
The projection distinguishes a valid partial section from a value in the \
wrong fiber.\
\>", "ExampleText",ExpressionUUID->"0cc147b8-992d-4b4a-bf39-b3534ce35257"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"PathGraph", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], ",", " ", "Identity"}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"InfraSectionQ", "[", 
      RowBox[{"fib", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraSection", "[", 
       RowBox[{"<|", 
        RowBox[{"1", " ", "->", " ", "1"}], "|>"}], "]"}], ",", " ", 
      RowBox[{"InfraSection", "[", 
       RowBox[{"<|", 
        RowBox[{"1", " ", "->", " ", "2"}], "|>"}], "]"}], ",", " ", 
      RowBox[{"InfraSection", "[", 
       RowBox[{"<|", "|>"}], "]"}]}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"16aa2117-cff6-47b5-b8ff-aaa09208370e"],

