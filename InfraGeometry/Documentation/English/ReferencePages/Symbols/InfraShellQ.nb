Cell["\<\
A shell with one vertex removed is not a shell, on the grid and on the mesh:\
\>", "ExampleText",ExpressionUUID->"1e924bc7-f533-44bd-ab85-823cf8a5384d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
     
     RowBox[{"{", 
      RowBox[{"shell", " ", "=", " ", 
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", "3"}], "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraShellQ", "[", 
        RowBox[{"g", ",", " ", "shell"}], "]"}], ",", " ", 
       RowBox[{"InfraShellQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Rest", " ", "@", " ", "shell"}]}], "]"}]}], "}"}]}], "]"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", 
       " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7f7f4825-0ed3-4092-be32-ce206b0b357e"],

