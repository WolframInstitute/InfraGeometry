Cell["\<\
Vertices at one distance from a centre need not form a shell. The two \
neighbours of 45 along one axis miss the other two:\
\>", "ExampleText",ExpressionUUID->"58f2b53b-9f4f-45a1-b75a-6268156a7b4b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", "45", ",", " ", "#"}], "]"}], " ", "&"}], " ", 
      "/@", " ", 
      RowBox[{"{", 
       RowBox[{"44", ",", " ", "46"}], "}"}]}], ",", " ", 
     RowBox[{"InfraShellQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"44", ",", " ", "46"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"22cdc292-67fe-4ce5-a197-67362b984386"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"8d9c4ba5-5e4e-43a5-bf1b-6f874cc72d5b"]
}, Open  ]]
}, Open  ]],

