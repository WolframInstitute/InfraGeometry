Cell[CellGroupData[{
Cell["InfraShellQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5775fb7f-afe8-412b-ad36-e267889c444a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShellQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShellQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["vs", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8dfc55e5-fbfb-4ddf-b7a2-771c8bdabc5f"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81f3dd0a-03f8-46a7-adcf-470906ac5749"],
 " if the vertex set ",
 StyleBox["vs", "TI"],
 " is a shell of ",
 StyleBox["g", "TI"],
 ": all the vertices at distance ",
 StyleBox["r", "TI"],
 " from some vertex ",
 StyleBox["c", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"550e1273-8f5a-4ac9-9168-09639eb4ca81"],

Cell[TextData[{
 StyleBox["vs", "TI"],
 " is a shell when ",
 StyleBox["vs = {v : d(c, v) = r}", "TI"],
 " for a vertex ",
 StyleBox["c", "TI"],
 " and a finite radius ",
 StyleBox["r \[GreaterEqual] 0", "TI"],
 ". A single vertex is the shell of radius 0 about itself."
}], "Notes",ExpressionUUID->"f06e56ad-6036-48d2-b5b9-e53db8cb1cfb"],

Cell["\<\
A shell is a whole level set: a part of one is not a shell. Being at one \
distance from a centre is not enough.\
\>", "Notes",ExpressionUUID->"0a7935e9-da15-40c4-b647-387b1ec5c8e2"],

Cell[TextData[{
 StyleBox["vs", "TI"],
 " is a vertex list, a density ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"v", " ", "->", " ", "m"}], ",", " ", "\[Ellipsis]"}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2880a5cd-3ca3-44e7-be13-fc09f043678a"],
 " read as its support, or a list of vertex lists, which passes when each one \
does."
}], "Notes",ExpressionUUID->"ca883bf5-0443-4799-89e4-4a76c0fcf46d"],

Cell[TextData[{
 "In an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f8151b41-d968-4036-8048-e1af046ee7ce"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraShellQ", "[", "x", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e891dcfc-1ff1-4f66-a6d6-0e2c0078c776"],
 " is the assertion that ",
 StyleBox["x", "TI"],
 " is a shell."
}], "Notes",ExpressionUUID->"499e75c7-fa93-4c05-a309-5ee1195b5dcb"]
}, Open  ]],

