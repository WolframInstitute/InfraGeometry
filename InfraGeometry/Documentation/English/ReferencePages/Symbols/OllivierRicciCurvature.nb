Cell[TextData[{
 "On the complete graph the two neighbourhoods differ in the two ends only, \
and ",
 StyleBox["\[Kappa] = (n \[Minus] 2)/(n \[Minus] 1)", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"32d4691b-daad-48a3-95c6-849710e48fea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Union", " ", "@", " ", 
     RowBox[{"Rationalize", "[", 
      RowBox[{
       RowBox[{"Values", " ", "@", " ", 
        RowBox[{"OllivierRicciCurvature", "[", 
         RowBox[{"CompleteGraph", "[", "n", "]"}], "]"}]}], ",", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "9"}]}]}], "]"}]}], " ", "==", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"n", " ", "-", " ", "2"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"n", " ", "-", " ", "1"}], ")"}]}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"n", ",", " ", "3", ",", " ", "9"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b97a5a37-c643-4628-bde6-9443c1200b78"],

