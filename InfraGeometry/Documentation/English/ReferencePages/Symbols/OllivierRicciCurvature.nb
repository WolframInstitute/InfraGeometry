    FractionBox["2", "3"], "}"}], ",", 
   RowBox[{"{", 
    FractionBox["1", "2"], "}"}], ",", 
   RowBox[{"{", 
    FractionBox["1", "5"], "}"}], ",", 
   RowBox[{"{", "0", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"-", 
     FractionBox["1", "3"]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"0ca5a050-3650-447d-a6e6-c6c1d168487a"]
}, Open  ]]
