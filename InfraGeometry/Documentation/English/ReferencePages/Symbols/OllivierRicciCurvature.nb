Cell[TextData[{
 "On the complete graph with ",
 StyleBox["n", "TI"],
 " vertices the curvature is (",
 StyleBox["n", "TI"],
 " \[Minus] 2)/(",
 StyleBox["n", "TI"],
 " \[Minus] 1): the neighbourhoods of the two ends of an edge differ only in \
the two ends, so a mass 1/(",
 StyleBox["n", "TI"],
 " \[Minus] 1) moves one step."
}], "ExampleText",ExpressionUUID->"dfada97f-8b52-4ee6-acb4-0b6409a81563"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CompleteGraph", "[", "6", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"g", ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Union", "[", 
         RowBox[{"Rationalize", "[", 
          RowBox[{
           RowBox[{"Values", "[", 
            RowBox[{"OllivierRicciCurvature", "[", 
             RowBox[{"CompleteGraph", "[", "n", "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "9"}]}]}], "]"}], "]"}], " ", "==", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n", " ", "-", " ", "2"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"n", " ", "-", " ", "1"}], ")"}]}], "}"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "3", ",", " ", "9"}], "}"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"837962d5-dadc-4458-a1e3-5f85ba7e3735"],

