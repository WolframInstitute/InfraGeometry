Cell[CellGroupData[{
Cell["OllivierRicciCurvature", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a348b35f-e3e3-4614-a9d3-707194826ee9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OllivierRicciCurvature"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/OllivierRicciCurvature", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6806ed74-f2aa-4d76-8e0e-006024aa4838"],
 "\[LineSeparator]",
 "gives the association of every edge ",
 StyleBox["u", "TI"],
 " \[LongLeftRightArrow] ",
 StyleBox["v", "TI"],
 " of ",
 StyleBox["g", "TI"],
 " with its Ollivier\[Dash]Ricci curvature ",
 StyleBox["\[Kappa](u, v) = 1 \[Minus] W\:2081(\[Mu]\:1d64, \[Mu]\:1d65)", 
  "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"e634cd5d-f563-446e-9ac0-259677cd8aa5"],

Cell[TextData[{
 "Here ",
 StyleBox["\[Mu]\:2093", "TI"],
 " is the uniform probability on the neighbours of ",
 StyleBox["x", "TI"],
 ", with no mass on ",
 StyleBox["x", "TI"],
 ", and ",
 StyleBox["W\:2081", "TI"],
 " is the earth mover's distance: the least cost ",
 StyleBox["\[CapitalSigma] \[Pi](x, y) d(x, y)", "TI"],
 " of a coupling ",
 StyleBox["\[Pi]", "TI"],
 " of ",
 StyleBox["\[Mu]\:1d64", "TI"],
 " and ",
 StyleBox["\[Mu]\:1d65", "TI"],
 ". For an edge ",
 StyleBox["d(u, v) = 1", "TI"],
 ", so ",
 StyleBox["\[Kappa] = 1 \[Minus] W\:2081/d(u, v)", "TI"],
 "."
}], "Notes",ExpressionUUID->"83992c04-cf41-40f5-ba83-498edee401bd"],

Cell[TextData[{
 "The curvature is positive where the neighbourhoods of the two ends are \
close, as across triangles, and negative where they are far apart, as on a \
tree. Every neighbour of ",
 StyleBox["u", "TI"],
 " is within distance 3 of every neighbour of ",
 StyleBox["v", "TI"],
 ", so ",
 StyleBox["\[Minus]2 \[LessEqual] \[Kappa] < 1", "TI"],
 "."
}], "Notes",ExpressionUUID->"acc5d68e-b9e4-4698-87e5-02ca175e40ea"],

Cell["Closed forms:", "Notes",ExpressionUUID->"6e9f95f0-6ea8-40da-9e35-c0885533b73c"],

