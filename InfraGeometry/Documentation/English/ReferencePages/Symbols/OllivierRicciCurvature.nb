Cell["\<\
The curvature of every edge of the square, hexagonal and triangular tilings, \
blue where it is positive, gray where it is 0 and red where it is negative, \
and its values. Away from the rim it is 0 on the square and triangular \
tilings and \[Minus]2/3 on the hexagonal one.\
\>", "ExampleText",ExpressionUUID->"560c8fb6-1ea5-4e30-9554-160eaf6a3daf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graphs", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"#", ",", " ", "\"\<Small\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}],
        " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"curvatures", " ", "=", " ", 
     RowBox[{"OllivierRicciCurvature", " ", "/@", " ", "graphs"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"MapThread", "[", "\n", "     ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", ",", " ", "kappa"}], "}"}], " ", "|->", " ", 
         RowBox[{"InfraSubstrateHighlight", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"KeyValueMap", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"edge", ",", " ", "k"}], "}"}], " ", "|->", " ", 
              RowBox[{
               RowBox[{"InfraWalk", "[", 
                RowBox[{"List", " ", "@@", " ", "edge"}], "]"}], " ", "->", 
               " ", 
               RowBox[{"Blend", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                  "StandardRed", ",", " ", "StandardGray", ",", " ", 
                   "StandardBlue"}], "}"}], ",", " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"k", " ", "+", " ", "1"}], ")"}], "/", "2"}]}], 
                "]"}]}]}], ",", " ", "kappa"}], "]"}]}], "]"}]}], ",", "\n", 
        "     ", 
        RowBox[{"{", 
         RowBox[{"graphs", ",", " ", "curvatures"}], "}"}]}], "]"}], "]"}], ",",
      "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"Union", "[", 
        RowBox[{"Rationalize", "[", 
         RowBox[{
          RowBox[{"Values", "[", "#", "]"}], ",", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "9"}]}]}], "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
      "curvatures"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e739177e-c58f-4288-bbd9-39907e6614c1"],

