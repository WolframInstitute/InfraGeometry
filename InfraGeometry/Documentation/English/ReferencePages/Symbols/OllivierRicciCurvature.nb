Cell[CellGroupData[{
Cell["OllivierRicciCurvature", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"51c486aa-33b7-47e1-b4bb-02255223890a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OllivierRicciCurvature"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/OllivierRicciCurvature", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94753125-0938-4553-859e-b4a1b955d8ac"],
 "\[LineSeparator]",
 "gives the association of every edge {",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "} of ",
 StyleBox["g", "TI"],
 " with its Ollivier\[Dash]Ricci curvature \[Kappa](",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") = 1 \[Minus] ",
 StyleBox["W", "TI"],
 "\:2081(\[Mu]\:1d64, \[Mu]\:1d65), where \[Mu]\:2093 is the uniform measure \
on the neighbours of ",
 StyleBox["x", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"2b8aebd6-aa9d-49f1-932b-e8546c1eff71"],

Cell[TextData[{
 "Definition: for an edge {",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "}, \[Kappa](",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") = 1 \[Minus] ",
 StyleBox["W", "TI"],
 "\:2081(\[Mu]\:1d64, \[Mu]\:1d65)/",
 StyleBox["d", "TI"],
 "(",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "), with ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") = 1. Here \[Mu]\:2093 is the uniform probability on the neighbours of ",
 StyleBox["x", "TI"],
 ", with no mass on ",
 StyleBox["x", "TI"],
 " itself, and ",
 StyleBox["W", "TI"],
 "\:2081 is the earth mover's distance: the least cost \[CapitalSigma] \[Pi](",
 StyleBox["x", "TI"],
 ", ",
 StyleBox["y", "TI"],
 ") ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["x", "TI"],
 ", ",
 StyleBox["y", "TI"],
 ") of a coupling \[Pi] of \[Mu]\:1d64 and \[Mu]\:1d65. Each edge costs one \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LinearOptimization"]], "paclet:ref/LinearOptimization"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "64c24f09-cbd5-4c9b-9681-3724bac4b47b"],
 "."
}], "Notes",ExpressionUUID->"3195783b-d98a-4fd0-9947-2fcf5757cc25"],

Cell[TextData[{
 "Every neighbour of ",
 StyleBox["u", "TI"],
 " lies within distance 3 of every neighbour of ",
 StyleBox["v", "TI"],
 ", so \[Minus]2 \[LessEqual] \[Kappa], and \[Kappa] < 1. The curvature is \
positive where the two neighbourhoods are close, as across triangles, and \
negative where they are far apart, as in a tree."
}], "Notes",ExpressionUUID->"b01c01eb-a932-43fc-9e85-ea76017415ce"],

Cell[TextData[{
 "On the complete graph with ",
 StyleBox["n", "TI"],
 " vertices \[Kappa] = (",
 StyleBox["n", "TI"],
 " \[Minus] 2)/(",
 StyleBox["n", "TI"],
 " \[Minus] 1). On a tree, \[Kappa](",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") = \[Minus]2(1 \[Minus] 1/deg ",
 StyleBox["u", "TI"],
 " \[Minus] 1/deg ",
 StyleBox["v", "TI"],
 ") where this is negative, and 0 elsewhere."
}], "Notes",ExpressionUUID->"0088499e-b019-4f4f-8873-bbc46d590bf8"],

Cell["The values are machine numbers from a linear program.", "Notes",ExpressionUUID->"d3532d1c-8893-4193-84c3-1591d36d892c"]
}, Open  ]],

