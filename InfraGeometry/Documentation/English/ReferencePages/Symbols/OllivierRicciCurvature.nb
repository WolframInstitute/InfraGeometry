Cell["\<\
The curvature of every edge, blue where it is positive, gray where it is 0 \
and red where it is negative. On the square grid it is 0, except \[Minus]1/2 \
on the edges whose two ends both have a neighbour on the rim:\
\>", "ExampleText",ExpressionUUID->"2f579c3c-4b3d-47ee-b7b7-e5c8552b3c9d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"kappa", " ", "=", " ", 
        RowBox[{"OllivierRicciCurvature", "[", "g", "]"}]}], "}"}], ",", "\n",
       "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", "\n", "      ", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"InfraWalk", "[", 
             RowBox[{"List", " ", "@@", " ", "#1"}], "]"}], " ", "->", " ", 
            RowBox[{"Blend", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "StandardRed", ",", " ", "StandardGray", ",", " ", 
                "StandardBlue"}], "}"}], ",", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"#2", " ", "+", " ", "1"}], ")"}], "/", "2"}]}], 
             "]"}]}], " ", "&"}], ",", " ", "kappa"}], "]"}], ",", "\n", 
        "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"MinMax", "[", 
          RowBox[{"Rationalize", "[", 
           RowBox[{
            RowBox[{"Values", "[", "kappa", "]"}], ",", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "9"}]}]}], "]"}], "]"}]}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"5ea5051e-e489-464f-a277-2a9b1b6bca4d"],

