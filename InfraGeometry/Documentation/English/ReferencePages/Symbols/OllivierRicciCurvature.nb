Cell["\<\
The five Platonic solids. Every edge has the same curvature: 2/3, 1/2 and 1/5 \
on the tetrahedron, octahedron and icosahedron, 0 on the cube, \[Minus]1/3 on \
the dodecahedron:\
\>", "ExampleText",ExpressionUUID->"771e52e5-1fff-4dd8-9c26-5d77ee6ba5cb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Union", " ", "@", " ", 
    RowBox[{"Rationalize", "[", 
     RowBox[{
      RowBox[{"Values", " ", "@", " ", 
       RowBox[{"OllivierRicciCurvature", "[", "g", "]"}]}], ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "9"}]}]}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"CompleteGraph", "[", "4", "]"}], ",", " ", 
       RowBox[{"CompleteGraph", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}], "]"}], ",", " ", 
       
       RowBox[{"GraphData", "[", "\"\<IcosahedralGraph\>\"", "]"}], ",", " ", 
       
       RowBox[{"HypercubeGraph", "[", "3", "]"}], ",", "\n", "    ", 
       RowBox[{"GraphData", "[", "\"\<DodecahedralGraph\>\"", "]"}]}], 
      "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2c6495ad-45da-4f6a-ae76-6b4c9be64779"],

Cell[BoxData[
 RowBox[{"{", 
