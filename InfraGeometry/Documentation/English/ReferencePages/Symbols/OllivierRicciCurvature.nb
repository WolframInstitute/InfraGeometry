Cell["\<\
On a small closed surface the neighbourhoods of an edge can meet around the \
surface. The Klein quartic is a quotient of the tiling by seven triangles at \
each vertex, but its curvature is 1/7, while on the tiling it is \[Minus]2/7.\
\
\>", "ExampleText",ExpressionUUID->"7d92f88d-d4d2-4a42-aeb1-dd6316b00642"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"TessellationGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "7"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"g", ",", " ", 
     RowBox[{"Union", "[", 
      RowBox[{"Rationalize", "[", 
       RowBox[{
        RowBox[{"Values", "[", 
         RowBox[{"OllivierRicciCurvature", "[", "g", "]"}], "]"}], ",", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}], "]"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8940980e-72df-4d18-807c-6b020b096c76"],

