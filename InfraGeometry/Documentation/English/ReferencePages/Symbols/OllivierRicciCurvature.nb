Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", "\n", "   ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"TessellationNeighborhoodGraph", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"3", ",", " ", "q"}], "}"}], ",", " ", "3"}], "]"}]}], 
          "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"c", " ", "=", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
         "     ", 
         RowBox[{"{", 
          RowBox[{"q", ",", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"Rationalize", "[", 
             RowBox[{
              RowBox[{"Values", " ", "@", " ", 
               RowBox[{"KeySelect", "[", 
                RowBox[{
                 RowBox[{"OllivierRicciCurvature", "[", "g", "]"}], ",", " ", 
                 
                 RowBox[{
                  RowBox[{"MemberQ", "[", 
                   RowBox[{"#", ",", " ", "c"}], "]"}], " ", "&"}]}], "]"}]}],
