Cell[TextData[{
 "The curvature at the centre of the tiling by triangles with ",
 StyleBox["q", "TI"],
 " at each vertex, against the combinatorial curvature ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationCurvature"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationCurvature", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "650833e4-4f76-4813-9216-3c1399074b99"],
 ". Both are positive below 6, 0 at 6 and negative above:"
}], "ExampleText",ExpressionUUID->"59dff2c0-9d70-419c-b047-08b7b337c2ad"],

