Cell["\<\
The five Platonic solids. Every edge of a solid has the same curvature: 2/3 \
on the tetrahedron, 1/2 on the octahedron, 1/5 on the icosahedron, 0 on the \
cube and \[Minus]1/3 on the dodecahedron.\
\>", "ExampleText",ExpressionUUID->"dc42a6a0-99eb-4dcb-9bef-904d843289ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"solids", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"CompleteGraph", "[", "4", "]"}], ",", " ", 
       RowBox[{"GraphData", "[", "\"\<OctahedralGraph\>\"", "]"}], ",", " ", 
       RowBox[{"GraphData", "[", "\"\<IcosahedralGraph\>\"", "]"}], ",", " ", 
       
       RowBox[{"HypercubeGraph", "[", "3", "]"}], ",", " ", 
       RowBox[{"GraphData", "[", "\"\<DodecahedralGraph\>\"", "]"}]}], 
      "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", "solids", "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Union", "[", 
        RowBox[{"Rationalize", "[", 
         RowBox[{
          RowBox[{"Values", "[", 
           RowBox[{"OllivierRicciCurvature", "[", "#", "]"}], "]"}], ",", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "9"}]}]}], "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
      "solids"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6c3b1ab3-dea6-415e-a369-e72ee3ec6354"],

