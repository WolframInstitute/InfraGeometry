Cell[TextData[{
 "The curvature of the edges at the centre of the tilings by ",
 StyleBox["q", "TI"],
 " triangles at each vertex, against their combinatorial curvature, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationCurvature"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationCurvature", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5a67696f-c977-4794-a1b1-763423dc4a72"],
 ". Both are positive below 6 triangles, 0 at 6 and negative above."
}], "ExampleText",ExpressionUUID->"c61599c0-50ce-46cc-a384-feb701fcb02c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"curvatures", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "       ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"TessellationNeighborhoodGraph", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"3", ",", " ", "q"}], "}"}], ",", " ", "3"}], "]"}]}], 
          "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{"c", " ", "=", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
         "       ", 
         RowBox[{"{", 
          RowBox[{"q", ",", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"Union", " ", "@", " ", 
             RowBox[{"Rationalize", "[", 
              RowBox[{
               RowBox[{"Values", " ", "@", " ", 
                RowBox[{"KeySelect", "[", 
                 RowBox[{
                  RowBox[{"OllivierRicciCurvature", "[", "g", "]"}], ",", " ", 
                  RowBox[{
                   RowBox[{"MemberQ", "[", 
                    RowBox[{"#", ",", " ", "c"}], "]"}], " ", "&"}]}], 
                 "]"}]}], ",", " ", 
               RowBox[{"10", "^", 
                RowBox[{"-", "9"}]}]}], "]"}]}]}]}], "}"}]}], "]"}], ",", 
       "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"q", ",", " ", "3", ",", " ", "9"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"curvatures", ",", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"q", ",", " ", 
             RowBox[{"TessellationCurvature", "[", 
              RowBox[{"{", 
               RowBox[{"3", ",", " ", "q"}], "}"}], "]"}]}], "}"}], ",", " ", 
           
           RowBox[{"{", 
            RowBox[{"q", ",", " ", "3", ",", " ", "9"}], "}"}]}], "]"}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Ollivier-Ricci\>\"", ",", 
          " ", "\"\<combinatorial\>\""}], "}"}]}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<q\>\"", ",", " ", "\"\<curvature\>\""}], "}"}]}]}], 
      "]"}], ",", " ", 
     RowBox[{"Last", " ", "/@", " ", "curvatures"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8f79a9fc-9b01-437b-a877-a63d57b6adab"],

