Cell["\<\
On a tree the curvature depends only on the degrees of the two ends. On the \
binary tree it is \[Minus]2/3 between two inner vertices, \[Minus]1/3 at the \
root and 0 at the leaves:\
\>", "ExampleText",ExpressionUUID->"32e4e675-20b1-43af-8763-2b50fa4a2b47"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"KaryTree", "[", "15", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"kappa", " ", "=", " ", 
     RowBox[{"OllivierRicciCurvature", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"formula", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Min", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{
          RowBox[{"-", "2"}], " ", 
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{"1", "/", 
             RowBox[{"VertexDegree", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], " ", "-", " ", 
            RowBox[{"1", "/", 
             RowBox[{"VertexDegree", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}]}], ")"}]}]}], "]"}],
        " ", "&"}], " ", "/@", " ", 
      RowBox[{"Keys", "[", "kappa", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Union", " ", "@", " ", 
      RowBox[{"Rationalize", "[", 
       RowBox[{
        RowBox[{"Values", "[", "kappa", "]"}], ",", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Max", " ", "@", " ", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"Values", "[", "kappa", "]"}], " ", "-", " ", "formula"}], 
        "]"}]}], " ", "<", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "9"}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2d7fb6d4-889c-4df5-8bc3-753b1335b29e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["2", "3"]}], ",", 
     RowBox[{"-", 
      FractionBox["1", "3"]}], ",", "0"}], "}"}], ",", "True"}], 
  "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"1ae4439b-1c1a-4315-9d24-91778dabc673"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Possible Issues", "ExampleSection",ExpressionUUID->
   "dda06a82-eb41-4b48-8510-6cb821647761"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell[TextData[{
 "The values are machine numbers, and an exact 0 can come out as a tiny \
number. On the square mesh 28 of the 51 edges of curvature 0 carry 1.1 \
\[Times] 10\:207b\.b9\:2076; compare with a tolerance or use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Rationalize"]], "paclet:ref/Rationalize"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "57d7d371-b857-4b2c-8a82-6a9add195ab9"],
 ":"
}], "ExampleText",ExpressionUUID->"85aa3df5-750b-44b6-948a-8a383ae57de8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"kappa", " ", "=", " ", 
     RowBox[{"Values", " ", "@", " ", 
      RowBox[{"OllivierRicciCurvature", "[", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}],
        "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Counts", " ", "@", " ", 
    RowBox[{"Select", "[", 
     RowBox[{"kappa", ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "#", "]"}], " ", "<", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "10"}]}]}], " ", "&"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"816b66bc-0f67-467f-8778-36d5dd301b43"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"0.`", "\[Rule]", "23"}], ",", 
   RowBox[{"1.1102230246251565`*^-16", "\[Rule]", "28"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"131390c9-12fd-438a-88fc-80a73bbb0817"]
}, Open  ]],

Cell["\<\
On a small closed surface the neighbourhoods of an edge can meet around the \
surface. The Klein quartic is a quotient of the tiling by triangles with 7 at \
each vertex, but its curvature is 1/7, not \[Minus]2/7:\
\>", "ExampleText",ExpressionUUID->"ff257981-ca05-46f9-8419-519ccd00fc9e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Union", " ", "@", " ", 
  RowBox[{"Rationalize", "[", 
   RowBox[{
    RowBox[{"Values", " ", "@", " ", 
     RowBox[{"OllivierRicciCurvature", "[", 
      RowBox[{"TessellationGraph", "[", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "7"}], "}"}], "]"}], "]"}]}], ",", " ", 
    RowBox[{"10", "^", 
     RowBox[{"-", "9"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ee8b9f8e-085c-47e0-a595-18391ceabe9b"],

Cell[BoxData[
 RowBox[{"{", 
  FractionBox["1", "7"], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"3dadd6f0-cd49-48d2-b721-bbee871057eb"]
}, Open  ]]
}, Open  ]],

