Cell[TextData[{
 "On the complete graph with ",
 StyleBox["n", "TI"],
 " vertices the curvature is (",
 StyleBox["n", "TI"],
 " \[Minus] 2)/(",
 StyleBox["n", "TI"],
 " \[Minus] 1): the neighbourhoods of the two ends of an edge differ only in \
the two ends, so a mass 1/(",
 StyleBox["n", "TI"],
 " \[Minus] 1) moves one step."
}], "ExampleText",ExpressionUUID->"9dc0741f-683c-46f1-b8ec-2f0d0fde278f"],

