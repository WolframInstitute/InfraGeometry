Cell[CellGroupData[{
Cell["OllivierRicciCurvature", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f8a008cd-d633-4eeb-a030-6f9fa85f74fe"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OllivierRicciCurvature"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/OllivierRicciCurvature", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe4b3324-1ef9-444f-8b2b-aae925b04bdb"],
 "\[LineSeparator]",
 "gives the association of every edge {",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "} of ",
 StyleBox["g", "TI"],
 " with its Ollivier\[Dash]Ricci curvature \[Kappa](",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") = 1 \[Minus] ",
 StyleBox["W", "TI"],
 "\:2081(\[Mu]\:1d64, \[Mu]\:1d65), where \[Mu]\:2093 is the uniform measure \
on the neighbours of ",
 StyleBox["x", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"d06ac111-6dec-4d4a-b4bc-b0f2f022c582"],

Cell[TextData[{
 "Definition: for an edge {",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "}, \[Kappa](",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") = 1 \[Minus] ",
 StyleBox["W", "TI"],
 "\:2081(\[Mu]\:1d64, \[Mu]\:1d65)/",
 StyleBox["d", "TI"],
 "(",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "), with ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") = 1. Here \[Mu]\:2093 is the uniform probability on the neighbours of ",
 StyleBox["x", "TI"],
 ", with no mass on ",
 StyleBox["x", "TI"],
 " itself, and ",
 StyleBox["W", "TI"],
 "\:2081 is the earth mover's distance: the least cost \[CapitalSigma] \[Pi](",
 StyleBox["x", "TI"],
 ", ",
 StyleBox["y", "TI"],
 ") ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["x", "TI"],
 ", ",
 StyleBox["y", "TI"],
 ") of a coupling \[Pi] of \[Mu]\:1d64 and \[Mu]\:1d65. Each edge costs one \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LinearOptimization"]], "paclet:ref/LinearOptimization"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "eff64099-0aff-4648-b453-f9633979fc4c"],
 "."
}], "Notes",ExpressionUUID->"a1b7f1e9-8b30-4dd5-9702-8d9a1556ba37"],

Cell[TextData[{
 "Every neighbour of ",
 StyleBox["u", "TI"],
 " lies within distance 3 of every neighbour of ",
 StyleBox["v", "TI"],
 ", so \[Minus]2 \[LessEqual] \[Kappa], and \[Kappa] < 1. The curvature is \
positive where the two neighbourhoods are close, as across triangles, and \
negative where they are far apart, as in a tree."
}], "Notes",ExpressionUUID->"c7c6d8e4-a4fa-4045-b3aa-ac250b07f944"],

Cell[TextData[{
 "On the complete graph with ",
 StyleBox["n", "TI"],
 " vertices \[Kappa] = (",
 StyleBox["n", "TI"],
 " \[Minus] 2)/(",
 StyleBox["n", "TI"],
 " \[Minus] 1). On a tree, \[Kappa](",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") = \[Minus]2(1 \[Minus] 1/deg ",
 StyleBox["u", "TI"],
 " \[Minus] 1/deg ",
 StyleBox["v", "TI"],
 ") where this is negative, and 0 elsewhere."
}], "Notes",ExpressionUUID->"273c395d-f650-4267-994f-6504f77f3354"],

Cell["The values are machine numbers from a linear program.", "Notes",ExpressionUUID->"5e84b59d-8cae-4b6a-96bf-3a961cbd960a"]
}, Open  ]],

