Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CompleteGraph", "[", "6", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"g", ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Union", "[", 
         RowBox[{"Rationalize", "[", 
          RowBox[{
           RowBox[{"Values", "[", 
            RowBox[{"OllivierRicciCurvature", "[", 
             RowBox[{"CompleteGraph", "[", "n", "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "9"}]}]}], "]"}], "]"}], " ", "==", " ", 
