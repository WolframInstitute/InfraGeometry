    }], "TableText",ExpressionUUID->"0ecc9b3f-298e-433a-9ccc-105b6d78e21b"], 
    Cell[TextData[StyleBox[
    "(n \[Minus] 2)/(n \[Minus] 1)", "TI"]], "TableText",ExpressionUUID->
     "4cc48c1f-1ef4-4e48-9062-5842e6bdd551"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "822b4d4e-bdfe-46b2-95a2-9ba447d1b66e"], Cell[
    "tree", "TableText",ExpressionUUID->
     "1e5e7954-2fd1-4cb8-bbc8-61c3ff336e89"], Cell[TextData[{
     StyleBox["\[Minus]2(1 \[Minus] 1/deg u \[Minus] 1/deg v)", "TI"],
     " where this is negative, 0 elsewhere"
    }], "TableText",ExpressionUUID->"79ade805-89aa-4fdd-a999-f84d6dde0ca5"]}
  }]], "2ColumnTableMod",ExpressionUUID->"55868155-5c43-4123-8229-\
0b7f0747f9d5"],

Cell["\<\
The values are machine numbers from a linear program, and an exact 0 can come \
out as 10\:207b\.b9\:2076.\
\>", "Notes",ExpressionUUID->"474e095a-fd97-4060-84dd-94c10edbde68"]
}, Open  ]],

