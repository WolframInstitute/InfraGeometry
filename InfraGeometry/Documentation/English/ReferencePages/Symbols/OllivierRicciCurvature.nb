Cell[TextData[{
 "On a tree the curvature of an edge depends only on the degrees of its ends, \
\[Minus]2(1 \[Minus] 1/deg ",
 StyleBox["u", "TI"],
 " \[Minus] 1/deg ",
 StyleBox["v", "TI"],
 ") where this is negative and 0 elsewhere: on the binary tree, \[Minus]2/3 \
between two inner vertices, \[Minus]1/3 at the root and 0 at the leaves."
}], "ExampleText",ExpressionUUID->"81e895c8-2875-4927-8207-64033ad22af0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"KaryTree", "[", "15", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"kappa", " ", "=", " ", 
     RowBox[{"OllivierRicciCurvature", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"KeyValueMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"edge", ",", " ", "k"}], "}"}], " ", "|->", " ", 
          RowBox[{
           RowBox[{"InfraWalk", "[", 
            RowBox[{"List", " ", "@@", " ", "edge"}], "]"}], " ", "->", " ", 
           RowBox[{"Blend", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "StandardRed", ",", " ", "StandardGray", ",", " ", 
               "StandardBlue"}], "}"}], ",", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"k", " ", "+", " ", "1"}], ")"}], "/", "2"}]}], 
            "]"}]}]}], ",", " ", "kappa"}], "]"}]}], "]"}], ",", "\n", "   ", 
     
     RowBox[{"Union", "[", 
      RowBox[{"Rationalize", "[", 
       RowBox[{
        RowBox[{"Values", "[", "kappa", "]"}], ",", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}], "]"}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"Values", "[", "kappa", "]"}], " ", "-", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Min", "[", 
             RowBox[{"0", ",", " ", 
              RowBox[{
               RowBox[{"-", "2"}], " ", 
               RowBox[{"(", 
                RowBox[{"1", " ", "-", " ", 
                 RowBox[{"1", "/", 
                  RowBox[{"VertexDegree", "[", 
                   RowBox[{"g", ",", " ", 
                    RowBox[{"First", "[", "#", "]"}]}], "]"}]}], " ", "-", 
                 " ", 
                 RowBox[{"1", "/", 
                  RowBox[{"VertexDegree", "[", 
                   RowBox[{"g", ",", " ", 
                    RowBox[{"Last", "[", "#", "]"}]}], "]"}]}]}], ")"}]}]}], 
             "]"}], " ", "&"}], " ", "/@", " ", 
           RowBox[{"Keys", "[", "kappa", "]"}]}], ")"}]}], "]"}], "]"}], " ", 
      "<", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "9"}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e910b62e-de30-48b0-bca9-413c2c074d50"],

