Cell["\<\
The segment from the centre of the grid to a vertex at distance 4. The two \
points can be placed in either order, and both orders lead to one state; from \
it the 4 shortest paths branch:\
\>", "ExampleText",ExpressionUUID->"2f5fa75b-db0b-4770-91ae-c9ceb3a4567a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "pB", ",", " ", "seg"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "a", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "b", "]"}]}], ",", " ", 
         RowBox[{"seg", " ", "==", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"pA", ",", " ", "pB"}], "]"}]}]}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{
    RowBox[{"InfraSceneMultiway", "[", 
     RowBox[{"scene", ",", " ", "g"}], "]"}], "[", "\"\<StateGraph\>\"", 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"826fdec8-c1da-46e7-9f69-300064160632"],

Cell[BoxData[
 GraphicsBox[
