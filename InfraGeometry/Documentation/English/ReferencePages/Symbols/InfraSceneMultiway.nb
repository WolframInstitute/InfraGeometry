Cell[TextData[{
 "The exploration is exhaustive, for small graphs and short scenes. Options \
bound it; by default they are ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da8abd07-513c-4392-b92c-6fa359b05a12"],
 ", so the result is exact, and a bound makes it partial, as ",
 Cell[BoxData["\"\<Completeness\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5d04ce8-253e-44f8-8dab-74275462276f"],
 " reports:"
}], "Notes",ExpressionUUID->"5f9710a4-5853-4ba3-b9a5-d6408bc4ed12"],

