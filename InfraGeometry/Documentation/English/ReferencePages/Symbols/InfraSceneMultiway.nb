Cell["Two construction orders merge at one terminal state.", "ExampleText",ExpressionUUID->"cb4248d6-c714-45f4-aa99-f4395eb8cc22"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"PathGraph", "[", " ", 
       RowBox[{"Range", "[", " ", "3", " ", "]"}], " ", "]"}]}], " ", "}"}], ",",
     "\n", "  ", 
    RowBox[{"{", " ", 
     RowBox[{"scene", " ", "=", " ", 
      RowBox[{"InfraScene", "[", " ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{"p", ",", " ", "q"}], " ", "}"}], ",", " ", 
        RowBox[{"{", " ", 
         RowBox[{"InfraStep", "[", " ", 
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"p", " ", "==", " ", 
             RowBox[{"InfraMidpoint", "[", " ", 
              RowBox[{"1", ",", " ", "3"}], " ", "]"}]}], ",", " ", 
            RowBox[{"q", " ", "==", " ", 
             RowBox[{"InfraMidpoint", "[", " ", 
              RowBox[{"1", ",", " ", "1"}], " ", "]"}]}]}], " ", "}"}], " ", 
          "]"}], " ", "}"}]}], " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
    RowBox[{"{", " ", 
     RowBox[{"data", " ", "=", " ", 
      RowBox[{"InfraSceneMultiway", "[", " ", 
       RowBox[{"scene", ",", " ", "graph"}], " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"data", "[", " ", "\"\<StateGraph\>\"", " ", "]"}]}], " ", 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"157c46e9-3251-4236-89f6-04c5ad2f17b5"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3, 4}, {{{1, 2}, {1, 3}, {2, 4}, {3, 4}}, Null}]]}, 
    TagBox[
     GraphicsGroupBox[
      GraphicsComplexBox[{{-1.8369701987210297`*^-16, 1.}, {1., 
       1.2246467991473532`*^-16}, {-1., -2.4492935982947064`*^-16}, {
