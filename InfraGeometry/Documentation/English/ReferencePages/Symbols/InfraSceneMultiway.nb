Cell["\<\
A state is a set of bindings: the objects constructed so far and their \
values. An event constructs one more object, with one of its realisations, \
and leads from a state to a new one. Two orders of construction that reach \
the same bindings reach the same state.\
\>", "Notes",ExpressionUUID->"e11f53be-afcb-4c24-a326-457e22e95e35"],

Cell[TextData[{
 "The final states are the instances of the scene, all that ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSceneInstance"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSceneInstance", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f6597bae-7abf-4b71-aeb7-c06a079e4953"],
 " can draw. A branch dies when an assertion fails on it."
}], "Notes",ExpressionUUID->"3d6d3100-ea66-4b5b-a787-59790684d89f"],

Cell[TextData[{
 "The result is an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "291a2964-5fc7-4bd9-9f10-bbcad1d4cbab"],
 ":"
}], "Notes",ExpressionUUID->"8ff511a1-c48a-4b14-a266-022a09c871b4"],

