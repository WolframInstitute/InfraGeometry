Cell["Two construction orders merge at one terminal state.", "ExampleText",ExpressionUUID->"9223cfe5-19f2-4429-8fa3-fe5a75e7e49a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"PathGraph", "[", " ", 
       RowBox[{"Range", "[", " ", "3", " ", "]"}], " ", "]"}]}], " ", "}"}], ",",
     "\n", "  ", 
    RowBox[{"{", " ", 
     RowBox[{"scene", " ", "=", " ", 
      RowBox[{"InfraScene", "[", " ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{"p", ",", " ", "q"}], " ", "}"}], ",", " ", 
        RowBox[{"{", " ", 
         RowBox[{"InfraSceneStep", "[", " ", 
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"p", " ", "==", " ", 
             RowBox[{"InfraMidpoint", "[", " ", 
              RowBox[{"1", ",", " ", "3"}], " ", "]"}]}], ",", " ", 
            RowBox[{"q", " ", "==", " ", 
             RowBox[{"InfraMidpoint", "[", " ", 
              RowBox[{"1", ",", " ", "1"}], " ", "]"}]}]}], " ", "}"}], " ", 
          "]"}], " ", "}"}]}], " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
    RowBox[{"{", " ", 
     RowBox[{"data", " ", "=", " ", 
      RowBox[{"InfraSceneMultiway", "[", " ", 
       RowBox[{"scene", ",", " ", "graph"}], " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"data", "[", " ", "\"\<StateGraph\>\"", " ", "]"}]}], " ", 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ce8b02b8-d925-48b4-a502-f9a301ca2b88"],

