Cell["Inspect a bounded frontier.", "ExampleText",ExpressionUUID->"56252818-67c3-432f-9bd8-1f8746660461"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"PathGraph", "[", " ", 
       RowBox[{"Range", "[", " ", "3", " ", "]"}], " ", "]"}]}], " ", "}"}], ",",
     "\n", "  ", 
    RowBox[{"{", " ", 
     RowBox[{"scene", " ", "=", " ", 
      RowBox[{"InfraScene", "[", " ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{"p", ",", " ", "q"}], " ", "}"}], ",", " ", 
        RowBox[{"{", " ", 
         RowBox[{"InfraStep", "[", " ", 
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"p", " ", "==", " ", 
             RowBox[{"InfraMidpoint", "[", " ", 
              RowBox[{"1", ",", " ", "3"}], " ", "]"}]}], ",", " ", 
            RowBox[{"q", " ", "==", " ", 
             RowBox[{"InfraMidpoint", "[", " ", 
              RowBox[{"1", ",", " ", "1"}], " ", "]"}]}]}], " ", "}"}], " ", 
          "]"}], " ", "}"}]}], " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
    RowBox[{"{", " ", 
     RowBox[{"data", " ", "=", " ", 
      RowBox[{"InfraSceneMultiway", "[", " ", 
       RowBox[{"scene", ",", " ", "graph", ",", " ", 
        RowBox[{"\"\<MaxEvents\>\"", " ", "->", " ", "3"}]}], " ", "]"}]}], 
     " ", "}"}], ",", "\n", "  ", 
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"data", "[", " ", "\"\<Completeness\>\"", " ", "]"}], ",", " ", 
      
      RowBox[{"data", "[", " ", "\"\<Frontier\>\"", " ", "]"}]}], " ", 
     "}"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"cfe66f00-c2d9-4eb4-a601-67b8542b0d68"],

