Cell[TextData[{
 "Two loops snapped to the mesh with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindEmbeddingClosestPath"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindEmbeddingClosestPath", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e004e675-907c-4c90-8232-494a209588e0"],
 ". The first crosses itself at one double point. The strands of the second \
share an edge:"
}], "ExampleText",ExpressionUUID->"cfa2e120-58de-4569-b8cc-5f7f6c4bace5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
          " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"w", " ", "=", " ", 
        RowBox[{"FindEmbeddingClosestPath", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"Line", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0.5", ",", " ", "0.5"}], "}"}], " ", "+", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"0.25", " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"t", "^", "2"}], " ", "-", " ", "1.2"}], ")"}]}], ",",
                 " ", 
                RowBox[{"b", " ", "t", " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"t", "^", "2"}], " ", "-", " ", "1.2"}], ")"}]}]}],
                "}"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"t", ",", " ", 
               RowBox[{"-", "1.7"}], ",", " ", "1.7", ",", " ", "0.05"}], 
              "}"}]}], "]"}], "]"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", "w", "}"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraGenericQ", "[", 
          RowBox[{"g", ",", " ", "w"}], "]"}]}]}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"b", ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.2", ",", " ", "0.3"}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cd899a93-1cbb-4707-bba2-614086329975"],

