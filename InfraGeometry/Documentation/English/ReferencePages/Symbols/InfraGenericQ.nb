Cell[TextData[{
 "Two loops snapped to the mesh with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindEmbeddingClosestPath"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindEmbeddingClosestPath", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2d82ec56-9df6-4892-a9a6-61b0caa9ac13"],
 ". The first crosses itself at one double point. The strands of the second \
share an edge:"
}], "ExampleText",ExpressionUUID->"fd708fe0-817a-4660-94fd-93e6cfbbff4b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
          " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"w", " ", "=", " ", 
        RowBox[{"FindEmbeddingClosestPath", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"Line", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0.5", ",", " ", "0.5"}], "}"}], " ", "+", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"0.25", " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"t", "^", "2"}], " ", "-", " ", "1.2"}], ")"}]}], ",",
                 " ", 
                RowBox[{"b", " ", "t", " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"t", "^", "2"}], " ", "-", " ", "1.2"}], ")"}]}]}],
                "}"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"t", ",", " ", 
               RowBox[{"-", "1.7"}], ",", " ", "1.7", ",", " ", "0.05"}], 
              "}"}]}], "]"}], "]"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", "w", "}"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraGenericQ", "[", 
          RowBox[{"g", ",", " ", "w"}], "]"}]}]}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"b", ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.2", ",", " ", "0.3"}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c343a1df-093f-469e-a15a-62a79665453f"],

