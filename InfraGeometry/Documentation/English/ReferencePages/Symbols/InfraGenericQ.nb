Cell["\<\
The boundary of a square face, as a cycle graph, is a generic closed curve. \
Run around twice it is not: every vertex is visited twice and every edge \
traversed twice:\
\>", "ExampleText",ExpressionUUID->"2b67f03f-3831-4a3f-aac4-ff193587c1c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"square", " ", "=", " ", 
     RowBox[{"First", " ", "/@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindCycle", "[", 
        RowBox[{
         RowBox[{"NeighborhoodGraph", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"{", "4", "}"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraGenericQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Graph", "[", 
        RowBox[{"DirectedEdge", " ", "@@@", " ", 
         RowBox[{"Partition", "[", 
          RowBox[{"square", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], 
          "]"}]}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"InfraGenericQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Join", "[", 
        RowBox[{"square", ",", " ", "square", ",", " ", 
         RowBox[{"Take", "[", 
          RowBox[{"square", ",", " ", "1"}], "]"}]}], "]"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d4338420-d0cf-4317-9496-60cac05b0c5c"],

