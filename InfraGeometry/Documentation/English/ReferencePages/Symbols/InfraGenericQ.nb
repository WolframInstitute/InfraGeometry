Cell["\<\
A vertex list is an open walk. A closed loop given as a list repeats its \
first vertex at the end, a self-intersection at the ends, so it is not \
generic. Give a cycle graph instead:\
\>", "ExampleText",ExpressionUUID->"c1046d47-e338-4f08-9e01-c9003ab6065f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"square", " ", "=", " ", 
     RowBox[{"First", " ", "/@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindCycle", "[", 
        RowBox[{
         RowBox[{"NeighborhoodGraph", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"{", "4", "}"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraGenericQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Append", "[", 
        RowBox[{"square", ",", " ", 
         RowBox[{"First", " ", "@", " ", "square"}]}], "]"}]}], "]"}], ",", 
     " ", 
     RowBox[{"InfraGenericQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Graph", "[", 
        RowBox[{"DirectedEdge", " ", "@@@", " ", 
         RowBox[{"Partition", "[", 
          RowBox[{"square", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], 
          "]"}]}], "]"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f1709cda-5101-4fbf-a8b1-b5a28bfed686"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"8a308a8f-6475-4e07-b819-3739b5a716b3"]
}, Open  ]]
}, Open  ]],

