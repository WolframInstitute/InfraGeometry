Cell["\<\
A vertex list is an open walk. A closed loop given as a list repeats its \
first vertex at the end, a self-intersection at the ends, so it is not \
generic. Give a cycle graph instead:\
\>", "ExampleText",ExpressionUUID->"09b17c4a-ff27-489b-9ba6-8835b17752e9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"square", " ", "=", " ", 
     RowBox[{"First", " ", "/@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindCycle", "[", 
        RowBox[{
         RowBox[{"NeighborhoodGraph", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"{", "4", "}"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraGenericQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Append", "[", 
        RowBox[{"square", ",", " ", 
         RowBox[{"First", " ", "@", " ", "square"}]}], "]"}]}], "]"}], ",", 
     " ", 
     RowBox[{"InfraGenericQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Graph", "[", 
        RowBox[{"DirectedEdge", " ", "@@@", " ", 
         RowBox[{"Partition", "[", 
          RowBox[{"square", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], 
          "]"}]}], "]"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"76888ea5-e8e0-4d57-af47-bdd9feaa0da0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"63383270-314f-4583-9f99-85160bf0da88"]
}, Open  ]]
}, Open  ]],

