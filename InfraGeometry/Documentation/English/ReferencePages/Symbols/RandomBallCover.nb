Cell[CellGroupData[{
Cell["RandomBallCover", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9a5affae-1a7f-459b-a7c4-9055139f6996"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomBallCover"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomBallCover", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ea33b41-503b-4aab-ba81-81348e6da1bd"],
 "\[LineSeparator]",
 "gives a uniformly chosen minimum centre set whose closed radius-",
 StyleBox["r", "TI"],
 " balls cover every vertex of ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"080efb97-cb9b-4ba5-bbde-33505fbef7fe"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomBallCover"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomBallCover", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["target", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "272c9be2-8cd9-40d2-9fc4-9d6a84a82c91"],
 "\[LineSeparator]",
 "samples a minimum cover of ",
 StyleBox["target", "TI"],
 ", using centres anywhere in ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"142fd982-dc3e-4f63-8716-fc66e50cd48f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomBallCover"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomBallCover", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["target", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc33a085-dac4-4bd6-a772-1d4a2c2b12f5"],
 "\[LineSeparator]",
 "gives exactly ",
 StyleBox["n", "TI"],
 " distinct minimum covers, sampled without replacement, or an empty list if \
fewer exist.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"bb8e2854-d578-4786-b534-86a8f78b5099"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomBallCover"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomBallCover", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["target", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["UpTo",
      BaseStyle->"Link"], "[", 
     StyleBox["n", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d1ea4d9-adec-4903-b4f5-b5fb168b0b1c"],
 "\[LineSeparator]",
 "samples at most ",
 StyleBox["n", "TI"],
 " distinct minimum covers.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e6e449f5-be6f-4ea9-aa3f-72cfb22f5766"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomBallCover"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomBallCover", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["target", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a018c9f-6c67-4581-83d1-8f507266104a"],
 "\[LineSeparator]",
 "gives every minimum cover in deterministic enumeration order."
}], "Usage",ExpressionUUID->"43358805-b455-47bd-ae13-2570ce2c041b"],

Cell[TextData[{
 "A centre set covers a target when every target vertex is at graph distance \
at most ",
 StyleBox["r", "TI"],
 " from some centre. A minimum cover has the fewest centres among all such \
sets. Each distinct minimum centre set has equal sampling probability; \
different permutations of the same centres are one cover."
}], "Notes",ExpressionUUID->"cf8bf26f-dc37-4370-b0d7-715bb78b6d98"],

Cell[TextData[{
 "The graph is finite, undirected and unweighted; the radius is a nonnegative \
integer, defaulting to 1. The target defaults to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4a64a79f-cd53-4e7d-bb05-d57c86371a9c"],
 ". It accepts a vertex, vertex list, density association, graph carrier or \
abstract region such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a0da4b56-dfc8-4109-aed3-be2dd5c18e42"],
 ". Only vertex support matters. A literal vertex takes precedence over list \
interpretation. Centres and distances belong to the ambient graph."
}], "Notes",ExpressionUUID->"90eb009b-1f5a-440f-aba8-b9cde52c2ab1"],

Cell[TextData[{
 "Omitting the count gives one centre list. Every explicit count gives a list \
of centre lists; explicit 1 therefore gives a one-element list. Counts occupy \
the fourth argument, after the target. Integer counts are strict, while ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UpTo"]], "paclet:ref/UpTo"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ea0efc20-f3ee-4640-978f-495f56bc23ad"],
 " permits fewer. Sampling is without replacement within a call; separate \
calls can repeat."
}], "Notes",ExpressionUUID->"95dcd27d-de73-4a39-89ba-fb8156bc45f6"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomSeeding", " ", "->", " ", "Automatic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b57fd11-17bf-44ad-aaeb-78c8a4aedd1d"],
 " (default) seeds each call afresh, independently of ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3beeb39-e84f-4b32-aa8a-4bc5b613c3f1"],
 "; an integer or string gives a reproducible draw, and ",
 Cell[BoxData["Inherited"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c315a71-b413-4d22-963f-3e811e5700d4"],
 " a local snapshot of the current state. The outer random state is restored \
afterward, as with ",
 ButtonBox["RandomInstance",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/RandomInstance.html"], 
    None}],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "44dab591-f18b-4237-ba8a-5db4509983a7"],
 ", 0 and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UpTo"]], "paclet:ref/UpTo"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "46ea14a0-f82c-4f3e-95ee-7b7a6e5aa751"],
 "[0] make no draw. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9a26810b-46c0-4825-8c5e-f431be5772eb"],
 " returns the same complete family as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindBallCover"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindBallCover", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e7117b33-5cab-439b-ba92-e8f66db4fc31"],
 " with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0730c82b-2d0e-4a13-b4b0-769069017c99"],
 "; its order has no intrinsic geometric meaning."
}], "Notes",ExpressionUUID->"2e0309a1-e67a-4b43-a220-3f9e0576b263"],

