Notebook[{

Cell[CellGroupData[{
Cell["RandomBallCover", "ObjectName",ExpressionUUID->"7a79ecd1-fdc2-42c7-834c-9acca974a148"],

Cell["LLM generated.", "Notes",ExpressionUUID->"32158ca1-d864-436a-bdb1-b906ad6be896"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"671dd69b-15c3-4cbc-b46e-8cc55fbe46ed"],
 Cell[BoxData[
  RowBox[{"RandomBallCover", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c9dc82b-5211-4cd0-9c7b-7e5d1914502f"],
 "\[LineSeparator]",
 "gives a uniformly chosen minimum centre set whose closed radius-",
 StyleBox["r", "TI"],
 " balls cover every vertex of ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c96ea445-4335-4531-b7ea-7da2f06140db"],
 Cell[BoxData[
  RowBox[{"RandomBallCover", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["target", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a72236f-5095-443a-a792-31a33d4c4bb1"],
 "\[LineSeparator]",
 "samples a minimum cover of ",
 StyleBox["target", "TI"],
 ", using centres anywhere in ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a16b2754-17b7-45d3-881d-f599fdfa462c"],
 Cell[BoxData[
  RowBox[{"RandomBallCover", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["target", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ddc41f69-6e57-45e6-8236-8fd7204f8d11"],
 "\[LineSeparator]",
 "gives exactly ",
 StyleBox["n", "TI"],
 " distinct minimum covers, sampled without replacement, or an empty list if \
fewer exist.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e8fd615b-030b-499d-a6c8-b0b487e92e4c"],
 Cell[BoxData[
  RowBox[{"RandomBallCover", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["target", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["UpTo",
      BaseStyle->"Link"], "[", 
     StyleBox["n", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1868ecb0-d408-432b-bc02-351e856d7f1f"],
 "\[LineSeparator]",
 "samples at most ",
 StyleBox["n", "TI"],
 " distinct minimum covers.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1b7885e8-2262-4f31-8a1d-540bf466ec44"],
 Cell[BoxData[
  RowBox[{"RandomBallCover", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["target", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bafc7bab-94ac-4162-9e14-5210b170ce33"],
 "\[LineSeparator]",
 "gives every minimum cover in deterministic enumeration order."
}], "Usage",ExpressionUUID->"ffa5d0d3-63ff-49a1-b674-fa2693090e5a"],

Cell[TextData[{
 "A centre set covers a target when every target vertex is at graph distance \
at most ",
 StyleBox["r", "TI"],
 " from some centre. A minimum cover has the fewest centres among all such \
sets. Each distinct minimum centre set has equal sampling probability; \
different permutations of the same centres are one cover."
}], "Notes",ExpressionUUID->"7fbbe9ca-41d1-4d12-8afd-593976e6c183"],

Cell[TextData[{
 "The graph is finite, undirected and unweighted; the radius is a nonnegative \
integer, defaulting to 1. The target defaults to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "88801ce0-3f56-46b2-93e9-178ad6a5db6c"],
 ". It accepts a vertex, vertex list, density association, graph carrier or \
abstract region such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "01c55ca8-04e3-4605-ab0b-8b67298645fb"],
 ". Only vertex support matters. A literal vertex takes precedence over list \
interpretation. Centres and distances belong to the ambient graph."
}], "Notes",ExpressionUUID->"f2928e83-17a7-40e3-b255-e6820c6ce360"],

Cell[TextData[{
 "Omitting the count gives one centre list. Every explicit count gives a list \
of centre lists; explicit 1 therefore gives a one-element list. Counts occupy \
the fourth argument, after the target. Integer counts are strict, while ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UpTo"]], "paclet:ref/UpTo"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "42a6e1ad-3b32-46fe-bfa6-a43ed826e94c"],
 " permits fewer. Sampling is without replacement within a call; separate \
calls can repeat."
}], "Notes",ExpressionUUID->"23c6cb49-7dcb-4d03-b4ca-33bf94ca860f"],

Cell[TextData[{
 "The sampler uses the ambient random state. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "43c49f15-5696-4567-b9b6-12c7f1930e0c"],
 " reproduces a draw, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BlockRandom"]], "paclet:ref/BlockRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "42aa304b-3b2b-4da8-bf98-bed63965e79e"],
 " isolates it. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5942f6f9-3747-4723-927d-e857d930dd4c"],
 ", 0 and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UpTo"]], "paclet:ref/UpTo"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "73d8786f-02d6-41a4-846b-e5ea93a465a4"],
 "[0] do not consume random numbers. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b54faace-d7fc-4653-a513-1b0bd1b310ed"],
 " returns the same complete family as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindBallCover"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindBallCover", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3b349aa7-626c-4298-bdae-f0486d422069"],
 " with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "750988bb-0135-4b41-ad83-a14a3fdabf94"],
 "; its order has no intrinsic geometric meaning."
}], "Notes",ExpressionUUID->"a15879d5-f21b-4538-af0f-54a9f72e1724"],

