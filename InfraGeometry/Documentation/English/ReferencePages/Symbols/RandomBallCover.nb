Cell["The found and sampled covers have the same minimum size:", "ExampleText",ExpressionUUID->"1af5e1e7-5387-46cd-af94-0f434cc1ef1c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "101", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "\t", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "6", " ", "]"}]}], " ", "}"}], ",", "\n",
    "\t", 
   RowBox[{"Grid", "[", " ", 
    RowBox[{
     RowBox[{"{", " ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"\"\<Minimum size\>\"", ",", " ", "\"\<Found cover\>\"", ",", 
         " ", "\"\<Random cover\>\""}], " ", "}"}], ",", "\n", "\t\t", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"BallCoverNumber", "[", " ", 
          RowBox[{"graph", ",", " ", "1"}], " ", "]"}], ",", " ", 
         RowBox[{"FindBallCover", "[", " ", 
          RowBox[{"graph", ",", " ", "1"}], " ", "]"}], ",", " ", 
         RowBox[{"RandomBallCover", "[", " ", 
          RowBox[{"graph", ",", " ", "1"}], " ", "]"}]}], " ", "}"}]}], " ", 
      "}"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}]}], " ", "]"}]}], " ", 
  "]"}]}], "Input",
