  FontSize->0.9 Inherited,ExpressionUUID->
  "98b254e7-e198-4ca0-91ac-dc04bef0618e"],
 "\[LineSeparator]",
 "samples at most ",
 StyleBox["n", "TI"],
 " distinct minimum covers.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"21360680-1878-49ee-aec5-1b978204658f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomBallCover"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomBallCover", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
