Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Automatic"]], "paclet:ref/Automatic"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0e1e8609-bea9-4c66-a01d-575adeb54ee5"],
 " and ",
 Cell[BoxData["\"\<IntegerLinearProgramming\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f56904f7-c2e2-48ea-9292-33e2cb0dba76"],
 " use exact integer optimization. ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f51402d4-9bea-4801-8269-b0a01bfd5483"],
