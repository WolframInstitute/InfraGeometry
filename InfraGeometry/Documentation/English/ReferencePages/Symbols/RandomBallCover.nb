       Graph[{1, 2, 3, 4, 5, 6}, {Null, 
         SparseArray[
         Automatic, {6, 6}, 0, {
          1, {{0, 2, 4, 6, 8, 10, 12}, {{2}, {6}, {1}, {3}, {2}, {4}, {3}, {
            5}, {4}, {6}, {1}, {5}}}, Pattern}]}, {
        GraphLayout -> "CircularEmbedding"}]]}, 
      TagBox[
       GraphicsGroupBox[
