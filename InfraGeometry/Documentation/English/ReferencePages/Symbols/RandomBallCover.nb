Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Automatic"]], "paclet:ref/Automatic"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6395dee7-0454-4c64-a9b7-c7ceb6636a84"],
 " and ",
 Cell[BoxData["\"\<IntegerLinearProgramming\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e45a9f4-739e-45ba-8215-2cc7c3c0d00f"],
 " use exact integer optimization. ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "655d9a46-3e02-4da3-9b0b-12efd6c53d2f"],
 " is a compatibility alias for that algorithm. These are method values of \
this function, not the solver method names of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LinearOptimization"]], "paclet:ref/LinearOptimization"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a8c7f4de-8dcd-4a7b-85c6-acdf922dd8e4"],
 ". ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b088c73-72fa-41f9-b32a-6fcca7b8bde9"],
 " is unsupported; a greedy cover need not be minimum."
}], "Notes",ExpressionUUID->"34b5f885-6741-49fd-afb6-b3a978d69205"],

Cell["\<\
A positive bounded sample request first enumerates every minimum centre set, \
even for one draw. This family can have exponential size. The count controls \
the number returned, not the search effort; there is no heuristic fallback.\
\>", "Notes",ExpressionUUID->"e495dca6-c93a-4b1d-8cdf-072e19d6c8e3"],

Cell[TextData[{
 "The empty target has one minimum cover, the empty centre list. Omitting the \
count gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a47226c-05a2-41bc-8d7f-568290bb2dcf"],
 "; explicit 1, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UpTo"]], "paclet:ref/UpTo"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7998d87a-1b8e-48e1-a019-ee87a778c6fe"],
 "[1] and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d1274809-2727-4793-8889-6af4e33806a6"],
 " give ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"{", "}"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "200cf401-2870-4497-95e1-fe12fa4e8396"],
 ". An empty association ",
 Cell[BoxData[
  RowBox[{"<|", "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47c1a89a-1ebc-4480-968c-0b650eab01d3"],
 " specifies an empty target even when ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79e631f1-660a-4256-ba96-0f2d75eed166"],
 " is itself a vertex label."
}], "Notes",ExpressionUUID->"2b0513c7-da99-4ae6-96fd-48cf6e7d8803"]
}, Open  ]],

