Cell["\<\
Draw two different minimum covers and show their covering balls:\
\>", "ExampleText",ExpressionUUID->"38f086be-f4a7-47a1-bc64-aa2d599f4728"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "101", " ", "]"}], ";"}], "\n", 
