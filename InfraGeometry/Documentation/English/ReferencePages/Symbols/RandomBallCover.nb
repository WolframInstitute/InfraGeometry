  FontSize->0.9 Inherited,ExpressionUUID->
  "6c3e552c-8654-4e7b-98c1-d69ef9524fdb"],
 " is itself a vertex label."
}], "Notes",ExpressionUUID->"2e8c5364-a435-45cf-9d9d-b538ff680ae8"]
