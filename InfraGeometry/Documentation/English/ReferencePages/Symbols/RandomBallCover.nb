Cell["Sample one minimum cover of a six-cycle:", "ExampleText",ExpressionUUID->"5d7f4e41-f0de-4945-9750-61e26421673c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "101", " ", "]"}], ";"}], "\n", 
 RowBox[{"RandomBallCover", "[", " ", 
  RowBox[{
   RowBox[{"CycleGraph", "[", " ", "6", " ", "]"}], ",", " ", "1", ",", " ", 
   RowBox[{"RandomSeeding", " ", "->", " ", "101"}]}], " ", "]"}]}], "Input",
 CellFrameLabels->{{Inherited, Inherited}, {Inherited, 
    Cell[
     TextData[{
      "26.10.18: FindShortestPath illustrates witness selection without a \
canonical tie rule; FindBallCover retains that role. RandomPoint and \
RandomSample motivate ambient seeding for the separate sampler. Here the \
distribution is explicitly uniform over minimum centre sets, implemented by \
complete exact enumeration. No native RandomBallCover counterpart or extra \
cover wrapper is assumed.", "\n\n", 
       Cell[
        BoxData[
         GridBox[{{
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Edit"]], BaseStyle -> 
               "TextAnnotationButton"]]], 
            StyleBox[
             RowBox[{
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "LastAnnotator"]], "pavel"}], 
             "TextAnnotator"], 
            Cell[
             BoxData[
              ButtonBox[
               DynamicBox[
                FEPrivate`FrontEndResource[
                "DocumentationToolsStrings", "Delete"]], BaseStyle -> 
               "TextAnnotationRemoveButton"]]], ""}}, 
          GridBoxAlignment -> {
           "Columns" -> {Left, Left, Right, Right}, "Rows" -> {{Automatic}}}, 
          GridBoxItemSize -> {"Columns" -> {
