Cell["RandomBallCover", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ce954565-2fe6-4f70-969e-ed61926ad1e8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomBallCover"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomBallCover", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57052521-d9d8-40b0-ac9c-65dba696646a"],
 "\[LineSeparator]",
 "gives a uniformly chosen minimum centre set whose closed radius-",
 StyleBox["r", "TI"],
 " balls cover every vertex of ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"02f377fd-99b9-453c-9c65-82dfd3212ce3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomBallCover"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomBallCover", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["target", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "843733b5-5193-496c-807c-2e331754a6a5"],
 "\[LineSeparator]",
 "samples a minimum cover of ",
 StyleBox["target", "TI"],
 ", using centres anywhere in ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0c5c97ea-87d8-4f66-b5c4-dd519c6a3fd7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomBallCover"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomBallCover", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["target", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b438825-52b1-4e29-a4ca-f951dee436f8"],
 "\[LineSeparator]",
 "gives exactly ",
 StyleBox["n", "TI"],
 " distinct minimum covers, sampled without replacement, or an empty list if \
fewer exist.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"33923f1e-499e-4c5c-a2ac-28544536ec1c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomBallCover"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomBallCover", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
