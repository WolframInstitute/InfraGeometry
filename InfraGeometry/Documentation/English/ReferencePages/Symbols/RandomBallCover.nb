Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Automatic"]], "paclet:ref/Automatic"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6a6b7120-9502-4848-899b-44acd6425ad3"],
 " and ",
 Cell[BoxData["\"\<IntegerLinearProgramming\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fbf9752-325b-4517-b22a-5a98c71b97a2"],
 " use exact integer optimization. ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "065ab351-ad34-423b-824f-41e0c413b2ca"],
 " is a compatibility alias for that algorithm. These are method values of \
this function, not the solver method names of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LinearOptimization"]], "paclet:ref/LinearOptimization"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "defaa33e-ffca-4bbe-8957-e07cd6c40e24"],
 ". ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8994343-4c92-4f6c-8a78-7188cf19c73b"],
 " is unsupported; a greedy cover need not be minimum."
}], "Notes",ExpressionUUID->"ab686b09-70bf-4dbe-a17d-2c9a7e995373"],

Cell["\<\
A positive bounded sample request first enumerates every minimum centre set, \
even for one draw. This family can have exponential size. The count controls \
the number returned, not the search effort; there is no heuristic fallback.\
\>", "Notes",ExpressionUUID->"e40e56ad-a096-4750-8c38-1e1f21aa1a75"],

Cell[TextData[{
 "The empty target has one minimum cover, the empty centre list. Omitting the \
count gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41f9c4c3-144d-42bb-be38-5127f4fcef67"],
 "; explicit 1, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UpTo"]], "paclet:ref/UpTo"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "128a868d-a8c6-4341-8d20-01c5af19ef59"],
 "[1] and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "82d1be0b-d2b9-407f-924e-2ddc00021998"],
 " give ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"{", "}"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "729dfa40-5038-4457-8047-1296d2234601"],
 ". An empty association ",
 Cell[BoxData[
  RowBox[{"<|", "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02d6ec9c-9894-4fbc-a88f-02aa260722d2"],
 " specifies an empty target even when ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4aa50852-931e-432e-8146-e7210b8b8f27"],
 " is itself a vertex label."
}], "Notes",ExpressionUUID->"75b09804-1b3b-4489-a014-7d11785b2be6"]
}, Open  ]],

