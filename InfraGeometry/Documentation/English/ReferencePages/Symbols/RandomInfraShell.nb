Cell["RandomInfraShell", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8b6a0002-d072-4d36-a39c-345292f561bb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraShell", "[", 
     RowBox[{
      StyleBox["c", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8f74ed2-8745-4b16-8faa-ece7c8eedd0a"],
 "\[LineSeparator]",
 "samples a sorted vertex set on graph ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"21a18e63-6fae-44f4-b104-211adfca371f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraShell", "[", 
     RowBox[{
      StyleBox["c", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fbe77bae-fab7-47a5-b758-abeb3e6791fe"],
 "\[LineSeparator]",
 "requests ",
 Cell[BoxData["count"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dde947a9-c547-46a8-9632-fa400d1575fa"],
 " representatives. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dcc49a0-854a-4dd9-a2b7-af8ed4050002"],
 " enumerates the full pool; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a60d444-d755-495e-bf34-885aeecc5891"],
 " returns at most ",
 StyleBox["n", "TI"],
 "."
}], "Usage",ExpressionUUID->"97353748-3a2d-46cb-9f33-909c571792cf"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomInfraShell", "[", 
   RowBox[{"g", ",", " ", "c", ",", " ", "r", ",", " ", "count"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "801c38e1-4455-4da4-9174-58a609c73b8d"],
 " uses the direct form."
}], "Notes",ExpressionUUID->"3e1e26f6-6727-4c9f-8fec-abdfe58bcea6"],

Cell[TextData[{
 "The sampler has the same token geometry as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f3564157-e530-4b49-8659-1400ecb3fa84"],
 ". An omitted or ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f5ae37b-3bc9-4c81-92f7-1aad388d693b"],
 " count returns one representative. An integer count requests exactly that \
many distinct representatives and returns ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b7f0a06-55a4-4485-b558-dd068fd5bc07"],
 " when too few exist."
}], "Notes",ExpressionUUID->"75ace811-3a72-4012-ba54-b09ccadbb300"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a76a067c-d3df-4c9b-a723-a80dbbaeea39"],
 " selects deterministically. Default ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3904b7e-261d-41d5-ac75-12c6ef427e63"],
 " does not advance random state. Seed an ordinary draw with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c09fc65-2ad1-4606-955f-9a516f206704"],
 "."
}], "Notes",ExpressionUUID->"612f6ce2-5f16-4c81-97c6-328788bbe076"],

