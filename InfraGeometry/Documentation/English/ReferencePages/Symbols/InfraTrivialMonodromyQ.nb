   "d18b1e1f-4c4c-49a5-bb54-1e5e145ddf4e"],
  $Line = 0; Null]], "ExampleSection",
 CellID->2123667759,ExpressionUUID->"0e0d5f37-f3c9-4474-a22b-9f10dcc8b438"],

Cell["\<\
The horizontal leaves are the components of the connection graph. The prism \
has two leaves, each meeting every fiber once; the Moebius ladder has one, \
meeting every fiber twice:\
\>", "ExampleText",ExpressionUUID->"31da9380-c9ae-42ba-a36e-c1a24d57dfa9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fib", " ", "=", " ", 
       RowBox[{"InfraFiberedSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"conn", " ", "=", " ", 
       RowBox[{"RandomInfraConnection", "[", 
        RowBox[{"fib", ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"Length", " ", "/@", " ", 
      RowBox[{"ConnectedComponents", " ", "@", " ", 
       RowBox[{"Graph", "[", 
        RowBox[{
         RowBox[{"VertexList", " ", "@", " ", 
          RowBox[{"InfraTotalSpace", "[", "fib", "]"}]}], ",", " ", 
         RowBox[{"First", " ", "@", " ", "conn"}]}], "]"}]}]}]}], "]"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<CycleProductBundle\>\"", ",", 
       " ", "\"\<MoebiusLadderCover\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"14aeab02-efa0-4244-b905-4205f081774e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"8", ",", "8"}], "}"}], ",", 
   RowBox[{"{", "16", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f80dcbf3-e01b-4da7-9ef4-fb088221370e"]
}, Open  ]],

Cell["\<\
For this grid, the two square boundaries generate its cycles: a connection \
has trivial monodromy exactly when its holonomy around both faces is the \
identity:\
\>", "ExampleText",ExpressionUUID->"c5a58836-5eda-451e-9127-195eba0e3e43"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       "\n", "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conns", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{"conns", ",", " ", 
     RowBox[{"conn", " ", "|->", " ", 
      RowBox[{
       RowBox[{"InfraTrivialMonodromyQ", "[", 
        RowBox[{"fib", ",", " ", "conn"}], "]"}], " ", "===", "\n", "    ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "1", ",", " ", "2", ",", " ", "4", ",", " ", "3", ",", " ", "1"}],
             "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
            "3", ",", " ", "4", ",", " ", "6", ",", " ", "5", ",", " ", "3"}],
             "}"}]}], "}"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraHolonomy", "[", 
            RowBox[{"fib", ",", " ", "conn", ",", " ", "#"}], "]"}], " ", "===",
            " ", 
           RowBox[{"Cycles", "[", 
            RowBox[{"{", "}"}], "]"}]}], " ", "&"}]}], "]"}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"beb3a075-0961-4071-aecb-a65ee2d1eb50"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"4707325d-b389-4441-bfb1-8c52b22cfbb0"]
}, Open  ]]
}, Open  ]],

