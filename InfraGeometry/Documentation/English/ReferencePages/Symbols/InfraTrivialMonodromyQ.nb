Cell["\<\
Fibers of two points over the 2 \[Times] 3 grid, joined completely. Of the 2\
\:2077 = 128 connections, 2\:2075 = 32 have trivial monodromy:\
\>", "ExampleText",ExpressionUUID->"35bc0c01-29e7-402f-be33-ae2e80532128"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       "\n", "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conns", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "conns", "]"}], ",", " ", 
     RowBox[{"Count", "[", 
      RowBox[{"conns", ",", " ", 
       RowBox[{"conn_", " ", "/;", " ", 
        RowBox[{"InfraTrivialMonodromyQ", "[", 
         RowBox[{"fib", ",", " ", "conn"}], "]"}]}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2c9ff0e6-afe1-44bd-a3ea-3c124f7bb78a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"128", ",", "32"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"32d9160d-6311-4fab-8ef7-d0ea926dbc42"]
}, Open  ]]
}, Open  ]],

