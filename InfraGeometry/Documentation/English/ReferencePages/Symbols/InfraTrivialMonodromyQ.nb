Cell["\<\
The prism and the Moebius ladder with their connections. The prism's \
connection has trivial monodromy; on the Moebius ladder the transport around \
the cycle exchanges the two ends of the rung:\
\>", "ExampleText",ExpressionUUID->"bc2c2015-1e7a-4e81-a538-41b1653d4117"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fib", " ", "=", " ", 
        RowBox[{"InfraFiberedSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"conn", " ", "=", " ", 
        RowBox[{"RandomInfraConnection", "[", 
         RowBox[{"fib", ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraFiberedGraphHighlight", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"{", "conn", "}"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraTrivialMonodromyQ", "[", 
          RowBox[{"fib", ",", " ", "conn"}], "]"}]}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<CycleProductBundle\>\"", ",", 
        " ", "\"\<MoebiusLadderCover\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"94d16ea3-cd85-4186-8513-5bf8e913dda1"],

