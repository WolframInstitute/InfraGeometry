Cell["\<\
Fibers of two points over the 2 \[Times] 3 grid, joined completely. Of the 2\
\:2077 = 128 connections, 2\:2075 = 32 have trivial monodromy:\
\>", "ExampleText",ExpressionUUID->"5b7f0ac1-6ad3-4e1d-8dce-410ebc8f3c5f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       "\n", "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conns", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "conns", "]"}], ",", " ", 
     RowBox[{"Count", "[", 
      RowBox[{"conns", ",", " ", 
       RowBox[{"conn_", " ", "/;", " ", 
        RowBox[{"InfraTrivialMonodromyQ", "[", 
         RowBox[{"fib", ",", " ", "conn"}], "]"}]}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0973482d-654d-4d75-aae6-0e184e901942"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"128", ",", "32"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"d51be3cd-37b0-4222-899e-820780642dcf"]
}, Open  ]]
}, Open  ]],

