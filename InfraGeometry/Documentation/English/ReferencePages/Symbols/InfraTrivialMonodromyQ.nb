Cell[TextData[{
 "The condition is ",
 StyleBox["hol(\[Gamma]) = id", "TI"],
 " for every closed base walk ",
 StyleBox["\[Gamma]", "TI"],
 ", with ",
 StyleBox["hol", "TI"],
 " the holonomy of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraHolonomy"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraHolonomy", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b08fa64d-c8ed-436f-97ea-6f986ef90e0e"],
 "."
}], "Notes",ExpressionUUID->"a20f0508-20d7-4a80-b9cd-ad14f6440ab5"],

Cell["\<\
Equivalently, every connected component of the graph of connection edges, a \
horizontal leaf, meets each fiber at most once. On a connected base each leaf \
is then a global section, and the connection identifies every fiber with one \
fixed fiber.\
\>", "Notes",ExpressionUUID->"266bc931-245d-4478-b3c1-e8cabf1c6bd8"],

Cell[TextData[{
 "Over a tree every complete connection has trivial monodromy. On a connected \
base with ",
 StyleBox["V", "TI"],
 " vertices and ",
 StyleBox["E", "TI"],
 " edges, with fibers of ",
 StyleBox["k", "TI"],
 " points joined completely, there are ",
 StyleBox["(k!)\:1d31", "TI"],
 " connections and ",
 StyleBox["(k!)\:2c7d\:207b\.b9", "TI"],
 " of them have trivial monodromy."
}], "Notes",ExpressionUUID->"cd2aec07-da2e-4699-8953-80d3ec2b49bf"],

Cell["\<\
The test covers every component of the base. It tests global path \
independence, rather than zero curvature on specified faces. A flat \
connection can have nontrivial holonomy around a noncontractible loop. The \
fibered graph itself carries no distinguished face system.\
\>", "Notes",ExpressionUUID->"10a7d544-0049-41d2-a89c-f8b03c3e786e"],

Cell[TextData[{
 StyleBox["conn", "TI"],
 " must be a complete connection, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0daf49b8-107d-4208-a292-af8fb45eb804"],
 " tests; otherwise the result is ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9702cdb3-f2a0-4af7-aa59-2151633da20a"],
 ". The empty list gives ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18a3f8fe-7c61-4f51-bc2a-b0266dfb8330"],
 "."
}], "Notes",ExpressionUUID->"9c64b4b0-3a14-4d72-9dd8-f9c6fc2f3971"]
}, Open  ]],

