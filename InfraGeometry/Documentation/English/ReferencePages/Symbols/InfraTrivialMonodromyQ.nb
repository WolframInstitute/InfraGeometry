Cell["\<\
The prism and the Moebius ladder with their connections. The prism's \
connection has trivial monodromy; on the Moebius ladder the transport around \
the cycle exchanges the two ends of the rung:\
\>", "ExampleText",ExpressionUUID->"d8295c2d-b097-446c-8669-70dbe40c149e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fib", " ", "=", " ", 
        RowBox[{"InfraFiberedSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"conn", " ", "=", " ", 
        RowBox[{"RandomInfraConnection", "[", 
         RowBox[{"fib", ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraFiberedGraphHighlight", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"{", "conn", "}"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraTrivialMonodromyQ", "[", 
          RowBox[{"fib", ",", " ", "conn"}], "]"}]}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<CycleProductBundle\>\"", ",", 
        " ", "\"\<MoebiusLadderCover\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a9e15d26-8a8f-4be2-902c-1c08f6cffd25"],

