Cell["\<\
Over a spanning tree of the 3 \[Times] 3 grid all 2\:2078 = 256 connections \
have trivial monodromy:\
\>", "ExampleText",ExpressionUUID->"4e51be79-c27e-4407-9d4d-0c7a666eafb7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"FindSpanningTree", "[", 
        RowBox[{"GridGraph", "[", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", "\n", "    ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conns", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "conns", "]"}], ",", " ", 
     RowBox[{"InfraTrivialMonodromyQ", "[", 
      RowBox[{"fib", ",", " ", "conns"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b888b8d8-e5ab-464a-bfab-8d5a41b05f47"],

