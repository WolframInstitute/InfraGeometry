  FontSize->0.9 Inherited,ExpressionUUID->
  "a8bdf7ed-1472-4443-890d-0e499d821ef0"],
 "."
}], "Notes",ExpressionUUID->"780f09ac-ab9a-4a5f-822a-c8b872a5b33c"]
}, Open  ]],

