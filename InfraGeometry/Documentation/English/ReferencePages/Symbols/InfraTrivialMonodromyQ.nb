Cell[TextData[{
 "The condition is ",
 StyleBox["hol(\[Gamma]) = id", "TI"],
 " for every closed base walk ",
 StyleBox["\[Gamma]", "TI"],
 ", with ",
 StyleBox["hol", "TI"],
 " the holonomy of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraHolonomy"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraHolonomy", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5a24d2eb-8e66-49ca-8604-891248771fef"],
 "."
}], "Notes",ExpressionUUID->"6f831d79-f3b5-49dc-858d-6c2eed6f47d2"],

Cell["\<\
Equivalently, every connected component of the graph of connection edges, a \
horizontal leaf, meets each fiber at most once. On a connected base each leaf \
is then a global section, and the connection identifies every fiber with one \
fixed fiber.\
\>", "Notes",ExpressionUUID->"9c954fa4-22e8-4cdc-ac25-5ba4f747cde6"],

Cell[TextData[{
 "Over a tree every complete connection has trivial monodromy. On a connected \
base with ",
 StyleBox["V", "TI"],
 " vertices and ",
 StyleBox["E", "TI"],
 " edges, with fibers of ",
 StyleBox["k", "TI"],
 " points joined completely, there are ",
 StyleBox["(k!)\:1d31", "TI"],
 " connections and ",
 StyleBox["(k!)\:2c7d\:207b\.b9", "TI"],
 " of them have trivial monodromy."
}], "Notes",ExpressionUUID->"83224916-b36c-4887-929d-6c461b454720"],

Cell["\<\
The test covers every component of the base. It tests global path \
independence, rather than zero curvature on specified faces. A flat \
connection can have nontrivial holonomy around a noncontractible loop. The \
fibered graph itself carries no distinguished face system.\
\>", "Notes",ExpressionUUID->"18498b54-1b0a-46f7-81aa-4758abad659c"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFlatConnectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFlatConnectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "86b60d56-242c-48b6-b67c-016babbd5bc3"],
 " is the retained compatibility spelling."
}], "Notes",ExpressionUUID->"f900bf08-da23-44c2-b6b6-fce702aa9291"],

Cell[TextData[{
 StyleBox["conn", "TI"],
