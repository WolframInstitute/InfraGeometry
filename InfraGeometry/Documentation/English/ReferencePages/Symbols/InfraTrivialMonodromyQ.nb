Cell["\<\
The horizontal leaves are the components of the connection graph. The prism \
has two leaves, each meeting every fiber once; the Moebius ladder has one, \
meeting every fiber twice:\
\>", "ExampleText",ExpressionUUID->"04b26a75-cc26-49e8-b0de-3b32bb09c806"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fib", " ", "=", " ", 
       RowBox[{"InfraFiberedSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"conn", " ", "=", " ", 
       RowBox[{"RandomInfraConnection", "[", 
        RowBox[{"fib", ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"Length", " ", "/@", " ", 
      RowBox[{"ConnectedComponents", " ", "@", " ", 
       RowBox[{"Graph", "[", 
        RowBox[{
         RowBox[{"VertexList", " ", "@", " ", 
          RowBox[{"InfraTotalSpace", "[", "fib", "]"}]}], ",", " ", 
         RowBox[{"First", " ", "@", " ", "conn"}]}], "]"}]}]}]}], "]"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<CycleProductBundle\>\"", ",", 
       " ", "\"\<MoebiusLadderCover\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"b3135d9b-cff8-4f9b-be6b-446058ca5a2c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"8", ",", "8"}], "}"}], ",", 
   RowBox[{"{", "16", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e1e33447-e7fa-49e3-bd0d-ec188ac0c249"]
}, Open  ]],

Cell["\<\
For this grid, the two square boundaries generate its cycles: a connection \
has trivial monodromy exactly when its holonomy around both faces is the \
identity:\
\>", "ExampleText",ExpressionUUID->"2e1b264a-36af-4065-b966-b4d60d6c271a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       "\n", "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conns", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{"conns", ",", " ", 
     RowBox[{"conn", " ", "|->", " ", 
      RowBox[{
       RowBox[{"InfraTrivialMonodromyQ", "[", 
        RowBox[{"fib", ",", " ", "conn"}], "]"}], " ", "===", "\n", "    ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "1", ",", " ", "2", ",", " ", "4", ",", " ", "3", ",", " ", "1"}],
             "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
            "3", ",", " ", "4", ",", " ", "6", ",", " ", "5", ",", " ", "3"}],
             "}"}]}], "}"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraHolonomy", "[", 
            RowBox[{"fib", ",", " ", "conn", ",", " ", "#"}], "]"}], " ", "===",
            " ", 
           RowBox[{"Cycles", "[", 
            RowBox[{"{", "}"}], "]"}]}], " ", "&"}]}], "]"}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"64bccb68-be76-4f3d-9e0b-528909f34c31"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"51e31d54-fae4-4502-abb4-ceb09abb63a1"]
}, Open  ]]
}, Open  ]],

