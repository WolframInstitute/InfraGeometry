Cell["\<\
Over a spanning tree of the 3 \[Times] 3 grid all 2\:2078 = 256 connections \
have trivial monodromy:\
\>", "ExampleText",ExpressionUUID->"3eface41-4996-4a41-bf91-8178a8ff7033"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"FindSpanningTree", "[", 
        RowBox[{"GridGraph", "[", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", "\n", "    ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conns", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "conns", "]"}], ",", " ", 
     RowBox[{"InfraTrivialMonodromyQ", "[", 
      RowBox[{"fib", ",", " ", "conns"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"84d05079-cc53-4f4f-bf80-c3fa43c6824e"],

