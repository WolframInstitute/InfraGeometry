Cell[CellGroupData[{

Cell["Method", "ExampleSubsection",ExpressionUUID->"627bf956-937a-44e1-9046-2e17bc7922b9"],

Cell["\<\
The two loops of the steps right and up of the grid. Both close away from the \
rim. At the rim the inverse loop spreads over the vertices with a common \
image; the loop of the negatives turns along the rim:\
\>", "ExampleText",ExpressionUUID->"28476c31-aaa2-4f85-a7ad-dc8e6f541d99"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"right", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
