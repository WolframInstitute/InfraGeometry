Cell[CellGroupData[{
Cell["DisplacementCommutator", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fdaae872-e713-44af-a6d8-56b72a94bc6e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementCommutator"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementCommutator", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ab1a0ca-994d-4291-88e8-8f1869dbbf75"],
 "\[LineSeparator]",
 "is the commutator loop of the displacements: ",
 StyleBox["d1", "TI"],
 ", then ",
 StyleBox["d2", "TI"],
 ", then the inverse of ",
 StyleBox["d1", "TI"],
 ", then the inverse of ",
 StyleBox["d2", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a3416bc7-1273-42e2-b892-80d31f996b52"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementCommutator"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementCommutator", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "695312a2-1627-4edd-ac5a-9a4856ddeea4"],
 "\[LineSeparator]",
 "gives its value at the vertex ",
 StyleBox["v", "TI"],
 "."
}], "Usage",ExpressionUUID->"336d4fb4-f52a-40f8-ba60-6a424efd1ae2"],

Cell[TextData[{
 "Definition: with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Method"]], "paclet:ref/Method"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b020bbca-2551-480f-ac3b-e748890e8191"],
 " -> ",
 Cell[BoxData["\"\<Inverse\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9909171-02a2-479b-9024-fc6fdac78515"],
 ", the default, the loop is ",
 StyleBox["D2\:207b\.b9 \[SmallCircle] D1\:207b\.b9 \[SmallCircle] D2 \
\[SmallCircle] D1", "TI"],
 ", the inverses those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementInverse"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementInverse", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e08d63fc-859e-452b-a43f-d980ef4b2fba"],
 ". For two bijections it is their group commutator, and the identity exactly \
when they commute."
}], "Notes",ExpressionUUID->"7c001673-142f-4f5e-bf29-c24822cd0254"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Method"]], "paclet:ref/Method"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "65875d8a-f277-4eb9-b0e0-85c639b744ce"],
 " -> ",
 Cell[BoxData["\"\<Negative\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc4e22f6-3b22-4d7e-9102-d2ed4f1cb802"],
 " the inverses are replaced by the metric negatives of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementNegative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementNegative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c5e441ab-eca3-4d5f-bdfa-d52f76d76159"],
 ": the loop is ",
 StyleBox["(\[Minus]D2) \[SmallCircle] (\[Minus]D1) \[SmallCircle] D2 \
\[SmallCircle] D1", "TI"],
 ", each negative taken at the vertex the loop has reached. This loop needs \
neither bijections nor relation inverses, and it is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementBracket"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementBracket", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "42e06c87-9394-4878-a52f-2114ac2ffcbd"],
 "."
}], "Notes",ExpressionUUID->"39eda8c0-5672-43f1-8670-aa88d6a5a15a"],

