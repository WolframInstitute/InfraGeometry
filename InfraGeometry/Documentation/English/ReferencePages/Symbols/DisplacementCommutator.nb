Cell["\<\
On a 12-cycle the commutator of the rotation by one step and a reflection is \
the rotation by two steps:\
\>", "ExampleText",ExpressionUUID->"a49c5f3b-859b-4edf-aba3-8af34c525afe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rotation", " ", "=", " ", 
      RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"reflection", " ", "=", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"2", " ", "-", " ", "#"}], ",", " ", "12", ",", " ", 
            "1"}], "]"}], "}"}], " ", "&"}], ",", " ", 
        RowBox[{"Range", "[", "12", "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"loop", " ", "=", " ", 
     RowBox[{"DisplacementCommutator", "[", 
      RowBox[{"g", ",", " ", "rotation", ",", " ", "reflection"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", "loop", ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"loop", "[", "1", "]"}], ",", " ", 
        RowBox[{"DisplacementMagnitude", "[", 
         RowBox[{"g", ",", " ", "loop"}], "]"}]}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"490dffff-9d81-42ce-95ee-ff056b96967a"],

