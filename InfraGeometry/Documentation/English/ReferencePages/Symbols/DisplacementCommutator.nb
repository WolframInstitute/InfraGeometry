Cell[CellGroupData[{

Cell["Method", "ExampleSubsection",ExpressionUUID->"4fec2c2b-7434-4832-83d4-230a7bb7afc7"],

Cell["\<\
The two loops of the steps right and up of the grid. Both close away from the \
rim. At the rim the inverse loop spreads over the vertices with a common \
image, and the loop of the metric negatives takes a single step towards the \
rim.\
\>", "ExampleText",ExpressionUUID->"ef5f0daa-fb20-4e7c-911b-9b29e93cb608"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "6"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"right", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"up", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"DisplacementPlot", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"DisplacementCommutator", "[", 
         RowBox[{"g", ",", " ", "right", ",", " ", "up", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "method"}]}], "]"}]}], "]"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"method", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Inverse\>\"", ",", " ", "\"\<Negative\>\""}], "}"}]}], 
       "}"}]}], "]"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8253ab7d-7264-4434-9157-9a8ef4df444b"],

