Cell["Exchanging the two automorphisms inverts their commutator.", \
"ExampleText",ExpressionUUID->"906a420b-2a30-4097-b41a-3006f2099c4b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rotation", " ", "=", " ", 
      RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"reflection", " ", "=", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"2", " ", "-", " ", "#"}], ",", " ", "12", ",", " ", 
            "1"}], "]"}], "}"}], " ", "&"}], ",", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"loop", " ", "=", " ", 
      RowBox[{"DisplacementCommutator", "[", 
       RowBox[{"g", ",", " ", "rotation", ",", " ", "reflection"}], "]"}]}], ",",
      " ", 
     RowBox[{"swapped", " ", "=", " ", 
      RowBox[{"DisplacementCommutator", "[", 
       RowBox[{"g", ",", " ", "reflection", ",", " ", "rotation"}], "]"}]}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"loop", ",", " ", "swapped"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"swapped", " ", "===", " ", 
      RowBox[{"DisplacementInverse", "[", "loop", "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c93895e3-96a4-4187-9d5f-abaf9b46ec10"],

