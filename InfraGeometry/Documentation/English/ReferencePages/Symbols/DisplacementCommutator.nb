       RowBox[{"6", ",", " ", "6"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"right", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"up", " ", "=", " ", 
