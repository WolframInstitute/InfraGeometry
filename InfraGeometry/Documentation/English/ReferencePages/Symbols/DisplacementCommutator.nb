Cell["\<\
On the 12-cycle the commutator of the rotation by one step and a reflection \
is the rotation by two steps, an automorphism of magnitude 2.\
\>", "ExampleText",ExpressionUUID->"c94c0783-fb34-4e00-83f8-bf2cf9645ab6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rotation", " ", "=", " ", 
      RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"reflection", " ", "=", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"2", " ", "-", " ", "#"}], ",", " ", "12", ",", " ", 
            "1"}], "]"}], "}"}], " ", "&"}], ",", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"loop", " ", "=", " ", 
     RowBox[{"DisplacementCommutator", "[", 
      RowBox[{"g", ",", " ", "rotation", ",", " ", "reflection"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", "loop"}], "]"}], ",", " ", 
     RowBox[{"loop", "[", "1", "]"}], ",", " ", 
     RowBox[{"DisplacementIsomorphismQ", "[", 
      RowBox[{"g", ",", " ", "loop"}], "]"}], ",", " ", 
     RowBox[{"DisplacementMagnitude", "[", 
      RowBox[{"g", ",", " ", "loop"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"43541142-a444-414f-a591-2cf0302a835f"],

