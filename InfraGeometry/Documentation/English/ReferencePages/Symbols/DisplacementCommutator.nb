Cell[CellGroupData[{
Cell["DisplacementCommutator", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1f0816c3-3337-4d06-be04-9ed74564ac86"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementCommutator"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementCommutator", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60c2760a-b4d2-4dd9-aee6-a69efd52a2ed"],
 "\[LineSeparator]",
 "is the commutator loop of the displacements: ",
 StyleBox["d1", "TI"],
 ", then ",
 StyleBox["d2", "TI"],
 ", then the inverse of ",
 StyleBox["d1", "TI"],
 ", then the inverse of ",
 StyleBox["d2", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4b642041-b489-476d-93d5-78f4b2e2ba72"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementCommutator"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementCommutator", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c53d4717-2498-4e09-ba9f-9f6896ee7e2d"],
 "\[LineSeparator]",
 "gives its value at the vertex ",
 StyleBox["v", "TI"],
 "."
}], "Usage",ExpressionUUID->"994110f9-133f-4844-90c1-073677e53d5a"],

Cell[TextData[{
 "Definition: with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Method"]], "paclet:ref/Method"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c5718411-5dbb-4a7f-99c1-6dfc658419ef"],
 " -> ",
 Cell[BoxData["\"\<Inverse\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88e77e67-2236-47ed-b714-b30c35bf42b0"],
 ", the default, the loop is ",
 StyleBox["D2\:207b\.b9 \[SmallCircle] D1\:207b\.b9 \[SmallCircle] D2 \
\[SmallCircle] D1", "TI"],
 ", the inverses those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementInverse"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementInverse", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d4ff2b71-369d-4e58-a6a9-e0bc10c23845"],
 ". For two bijections it is their group commutator, and the identity exactly \
when they commute."
}], "Notes",ExpressionUUID->"b6020fd7-7db8-4c14-8cfc-6ae5e060fcf8"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Method"]], "paclet:ref/Method"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3421c80b-3242-43e2-8238-92e0d83726d9"],
 " -> ",
 Cell[BoxData["\"\<Negative\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07dab9dd-5e8b-4c68-b8ad-6c0d2def5665"],
 " the inverses are replaced by the metric negatives of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementNegative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementNegative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1fa1adeb-6892-48d6-9d6b-fb5368eda752"],
 ": the loop is ",
 StyleBox["(\[Minus]D2) \[SmallCircle] (\[Minus]D1) \[SmallCircle] D2 \
\[SmallCircle] D1", "TI"],
 ", each negative taken at the vertex the loop has reached. This loop needs \
neither bijections nor relation inverses, and it is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementBracket"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementBracket", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "41629c2f-c941-438a-9bb2-e51308795110"],
 "."
}], "Notes",ExpressionUUID->"06957a40-8a78-4385-b221-f7e3e35c525a"],

