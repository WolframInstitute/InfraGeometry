Notebook[{

Cell[CellGroupData[{
Cell["DisplacementCommutator", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5720466a-000d-4e5c-a754-09af519062d0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementCommutator"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementCommutator", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1488915-926a-4d7d-a9c5-4d04c5042890"],
 "\[LineSeparator]",
 "is the commutator loop of the displacements ",
 StyleBox["d1", "TI"],
 " and ",
 StyleBox["d2", "TI"],
 ": ",
 StyleBox["d1", "TI"],
 ", then ",
 StyleBox["d2", "TI"],
 ", then the inverse of ",
 StyleBox["d1", "TI"],
 ", then the inverse of ",
 StyleBox["d2", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4b39d1c5-49f6-4aac-87fe-dee93d637bdd"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementCommutator"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementCommutator", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbda841f-290a-422b-9e9a-39f3bdcdf5ca"],
 "\[LineSeparator]",
 "gives its value at the vertex ",
 StyleBox["v", "TI"],
 "."
}], "Usage",ExpressionUUID->"77a27be9-0d23-4e55-a648-16d986df9f51"],

Cell[TextData[{
 "The loop is ",
 StyleBox["D\:2082\:207b\.b9 \[SmallCircle] D\:2081\:207b\.b9 \[SmallCircle] \
D\:2082 \[SmallCircle] D\:2081", "TI"],
 ", with the inverses of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementInverse"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementInverse", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9b4bd03d-f319-4c60-8438-9547eab75db0"],
 ". For two bijections it is their group commutator, the identity exactly \
when they commute."
}], "Notes",ExpressionUUID->"10232ba0-5e01-4a7f-9b07-f8351640918e"],

Cell[TextData[{
 "For the flows of two vector fields ",
 StyleBox["X", "TI"],
 ", ",
 StyleBox["Y", "TI"],
 " at scale ",
 StyleBox["r", "TI"],
 " the loop moves each point by ",
 StyleBox["r\.b2[X, Y] + O(r\.b3)", "TI"],
 ", so a loop that closes reads a vanishing bracket."
}], "Notes",ExpressionUUID->"364a4586-71f7-48c2-a971-a4aa1a75bfb4"],

Cell["\<\
The inverse of a displacement that is not injective has several values, and \
the loop then spreads.\
\>", "Notes",ExpressionUUID->"90dae5b4-e801-4dc1-a0b5-34e00d911686"],

Cell["\<\
The commutator of two automorphisms is an automorphism, and exchanging the \
two inverts it.\
\>", "Notes",ExpressionUUID->"4d0e118a-7cf2-4852-83e1-0b0904f520e3"],

Cell["Options:", "Notes",ExpressionUUID->"37f0ac2a-5cae-4294-8be6-3bbbe9cc1263"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ac788853-373d-4653-bc27-72bbc3cc673d"], Cell["Option", "TableText",
