"ExampleText",ExpressionUUID->"cb5686ba-a7a3-4b61-b08a-1640bfca4e6f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rotation", " ", "=", " ", 
      RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"reflection", " ", "=", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"2", " ", "-", " ", "#"}], ",", " ", "12", ",", " ", 
            "1"}], "]"}], "}"}], " ", "&"}], ",", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"loop", " ", "=", " ", 
      RowBox[{"DisplacementCommutator", "[", 
       RowBox[{"g", ",", " ", "rotation", ",", " ", "reflection"}], "]"}]}], ",",
      " ", 
     RowBox[{"swapped", " ", "=", " ", 
      RowBox[{"DisplacementCommutator", "[", 
       RowBox[{"g", ",", " ", "reflection", ",", " ", "rotation"}], "]"}]}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"loop", ",", " ", "swapped"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"swapped", " ", "===", " ", 
      RowBox[{"DisplacementInverse", "[", "loop", "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"231451e5-d939-430b-b9cf-e732d0b3fd83"],

