Cell["Method", "ExampleSubsection",ExpressionUUID->"272687fe-a56f-4a5d-a8af-1ec8ae2bf8d3"],

Cell["\<\
The two loops of the steps right and up of the grid. Both close away from the \
rim. At the rim the inverse loop spreads over the vertices with a common \
image, and the loop of the metric negatives takes a single step towards the \
rim.\
\>", "ExampleText",ExpressionUUID->"dcc3f4d8-855c-46ab-ade2-78ea8077a3a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "6"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"right", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"up", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"DisplacementPlot", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"DisplacementCommutator", "[", 
         RowBox[{"g", ",", " ", "right", ",", " ", "up", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "method"}]}], "]"}]}], "]"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"method", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Inverse\>\"", ",", " ", "\"\<Negative\>\""}], "}"}]}], 
       "}"}]}], "]"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"db7f87f9-797a-406f-8520-50cd1737fb60"],

