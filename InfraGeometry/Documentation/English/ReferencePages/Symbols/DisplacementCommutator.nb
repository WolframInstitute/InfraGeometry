Cell[CellGroupData[{

Cell["Method", "ExampleSubsection",ExpressionUUID->"932a5516-94f5-4ff2-b606-a332675e0395"],

Cell["\<\
The two loops of the steps right and up of the grid. Both close away from the \
rim. At the rim the inverse loop spreads over the vertices with a common \
image, and the loop of the metric negatives takes a single step towards the \
rim.\
\>", "ExampleText",ExpressionUUID->"b6771322-933a-453f-b699-d550f3da9d80"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "6"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"right", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"up", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"DisplacementPlot", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"DisplacementCommutator", "[", 
         RowBox[{"g", ",", " ", "right", ",", " ", "up", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "method"}]}], "]"}]}], "]"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"method", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Inverse\>\"", ",", " ", "\"\<Negative\>\""}], "}"}]}], 
       "}"}]}], "]"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d4585c00-db89-49d6-9372-65bb3a769322"],

