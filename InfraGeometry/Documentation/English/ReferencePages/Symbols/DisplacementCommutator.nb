Cell["\<\
The commutator of two automorphisms is an automorphism, and exchanging the \
two inverts it:\
\>", "ExampleText",ExpressionUUID->"0b28d08d-efb7-4067-9ae6-cb0d7fbab843"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rotation", " ", "=", " ", 
      RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"reflection", " ", "=", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"2", " ", "-", " ", "#"}], ",", " ", "12", ",", " ", 
            "1"}], "]"}], "}"}], " ", "&"}], ",", " ", 
        RowBox[{"Range", "[", "12", "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"loop", " ", "=", " ", 
     RowBox[{"DisplacementCommutator", "[", 
      RowBox[{"g", ",", " ", "rotation", ",", " ", "reflection"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementIsomorphismQ", "[", 
      RowBox[{"g", ",", " ", "loop"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"DisplacementCommutator", "[", 
       RowBox[{"g", ",", " ", "reflection", ",", " ", "rotation"}], "]"}], 
      " ", "===", " ", 
      RowBox[{"DisplacementInverse", "[", "loop", "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"36871e64-2e57-4e44-90c9-ac70df07ab4d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ad50b066-e69c-4c4e-821a-948974b12f81"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<Negative\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c26e16ca-cadd-420b-b6f8-92d65743b4b2"],
 " gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementBracket"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementBracket", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fb5f0817-1327-4185-82db-1eedb71b5d1b"],
 ":"
}], "ExampleText",ExpressionUUID->"8f2d2013-e91f-4531-8f2d-ec278a7599cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"right", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "8"}], ",", " ", "0"}], "}"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{"up", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"1", "/", "8"}]}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{
    RowBox[{"DisplacementCommutator", "[", 
     RowBox[{"g", ",", " ", "right", ",", " ", "up", ",", " ", 
      RowBox[{"Method", " ", "->", " ", "\"\<Negative\>\""}]}], "]"}], " ", "===",
     " ", 
    RowBox[{"DisplacementBracket", "[", 
     RowBox[{"g", ",", " ", "right", ",", " ", "up"}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1b4bc052-688a-4ad5-bebc-3ccb2afa99cb"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"778946bd-e623-44df-b8f3-03145d2fd5d7"]
}, Open  ]]
}, Open  ]],

