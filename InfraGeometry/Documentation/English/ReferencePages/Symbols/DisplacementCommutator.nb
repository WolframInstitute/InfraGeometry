Cell[CellGroupData[{
Cell["DisplacementCommutator", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"60b1bbd0-342c-4745-b275-d3cd78e8f9a1"],
 Cell[BoxData[
  RowBox[{"DisplacementCommutator", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "002fe3cb-ff03-465e-a90f-3db3d5b8718b"],
 "\[LineSeparator]",
 "is the commutator loop of the displacements: ",
 StyleBox["d1", "TI"],
 ", then ",
 StyleBox["d2", "TI"],
 ", then the inverse of ",
 StyleBox["d1", "TI"],
 ", then the inverse of ",
 StyleBox["d2", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"08437f1c-629f-405b-9683-ac70b240d44c"],
 Cell[BoxData[
  RowBox[{"DisplacementCommutator", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7828850f-b89a-4c01-94ed-8605ff9e04c0"],
 "\[LineSeparator]",
 "gives its value at the vertex ",
 StyleBox["v", "TI"],
 "."
}], "Usage",ExpressionUUID->"00aaf33a-3cf6-4143-b636-188dc86ab36a"],

Cell[TextData[{
 "Definition: with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Method"]], "paclet:ref/Method"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "09e7f100-3acc-48f0-a88d-bd2b787ccbd2"],
 " -> ",
 Cell[BoxData["\"\<Inverse\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "abccf424-7450-46d5-87ce-f7d9be235b68"],
 ", the default, the loop is ",
 StyleBox["D2\:207b\.b9 \[SmallCircle] D1\:207b\.b9 \[SmallCircle] D2 \
\[SmallCircle] D1", "TI"],
 ", the inverses those of ",
 Cell[BoxData["DisplacementInverse"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39a507e1-41a7-47b2-afb2-3c547ca372a4"],
 ". For two bijections it is their group commutator, and the identity exactly \
when they commute."
}], "Notes",ExpressionUUID->"712ac7ff-74cf-49ed-9049-faca1ed3389e"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Method"]], "paclet:ref/Method"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "54cdbd83-0c9f-4cca-b5b7-4207e3846a21"],
 " -> ",
 Cell[BoxData["\"\<Negative\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0da645d-ef43-446d-a161-c2ecb10a266e"],
 " the inverses are replaced by the metric negatives of ",
 Cell[BoxData["DisplacementNegative"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c4199a19-ee63-4c9c-8126-20a2da19ee24"],
 ": the loop is ",
 StyleBox["(\[Minus]D2) \[SmallCircle] (\[Minus]D1) \[SmallCircle] D2 \
\[SmallCircle] D1", "TI"],
 ", each negative taken at the vertex the loop has reached. This loop needs \
neither bijections nor relation inverses, and it is ",
 Cell[BoxData["DisplacementBracket"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c28b2881-e2f5-4c70-bb94-e1aff21315c3"],
 "."
}], "Notes",ExpressionUUID->"f54a58e4-bfce-4ee6-a0a4-b3e3022d9b05"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e5b6f98e-96b3-447d-8661-a1dd06bb7860"], Cell["Method", "TableText",
