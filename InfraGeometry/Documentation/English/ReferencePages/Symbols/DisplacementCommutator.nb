Cell["Exchanging the two automorphisms inverts their commutator.", \
"ExampleText",ExpressionUUID->"e7490e6d-7cbc-44b2-a3e1-82b175e0992c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rotation", " ", "=", " ", 
      RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"reflection", " ", "=", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"2", " ", "-", " ", "#"}], ",", " ", "12", ",", " ", 
            "1"}], "]"}], "}"}], " ", "&"}], ",", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"loop", " ", "=", " ", 
      RowBox[{"DisplacementCommutator", "[", 
       RowBox[{"g", ",", " ", "rotation", ",", " ", "reflection"}], "]"}]}], ",",
      " ", 
     RowBox[{"swapped", " ", "=", " ", 
      RowBox[{"DisplacementCommutator", "[", 
       RowBox[{"g", ",", " ", "reflection", ",", " ", "rotation"}], "]"}]}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"loop", ",", " ", "swapped"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"swapped", " ", "===", " ", 
      RowBox[{"DisplacementInverse", "[", "loop", "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"846c99e2-1bc3-4c20-81d1-07286d08f9b8"],

