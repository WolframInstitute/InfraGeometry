Cell["\<\
The commutator of the steps right and up, on the square grid and on the \
square mesh, with the number of vertices where the loop closes. On the grid \
it fails only at the top and the right; on the mesh it closes at 12 of the \
102 vertices, and at 30 it has no value, where an inverse was empty:\
\>", "ExampleText",ExpressionUUID->"ee96e0b8-76a4-45c8-b7f7-7b336ae2f6ab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"KeyValueMap", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name", ",", " ", "s"}], "}"}], " ", "|->", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"loop", " ", "=", " ", 
         RowBox[{"DisplacementCommutator", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"TranslationDisplacement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", 
              RowBox[{"s", ",", " ", "0"}], "}"}]}], "]"}], ",", " ", 
           RowBox[{"TranslationDisplacement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "s"}], "}"}]}], "]"}]}], "]"}]}], "}"}], 
       ",", "\n", "    ", 
       RowBox[{"DisplacementPlot", "[", 
        RowBox[{"g", ",", " ", "loop", ",", " ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"Count", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{"v_", " ", "/;", " ", 
             RowBox[{
              RowBox[{"loop", "[", "v", "]"}], " ", "===", " ", 
              RowBox[{"{", "v", "}"}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}], ",",
     "\n", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<SquareGridGraph\>\"", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"\"\<SquareMeshGraph\>\"", " ", "->", " ", 
       RowBox[{"1", "/", "8"}]}]}], "|>"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4493101f-ab14-4fef-aaa6-a4ccc7ee97a9"],

