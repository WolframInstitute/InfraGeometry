     "f097c694-20da-4d98-81bc-ac78def74ea3"]], "TableText",ExpressionUUID->
     "60fe003b-7fa2-4b4f-a025-702b5bf734a1"], Cell[TextData[{
     Cell[BoxData["\"\<Negative\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9275d317-50db-459c-999f-3b2b9c0daa88"],
     " replaces the inverses by the metric negatives of ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["DisplacementNegative"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/DisplacementNegative", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "76835ae2-20d5-4f97-9653-068ea98483b7"],
     ", each taken at the vertex the loop has reached; this is ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["DisplacementBracket"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/DisplacementBracket", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "89d4323b-ff34-43d9-bd65-f98c0274f828"]
    }], "TableText",ExpressionUUID->"33201b41-56b5-48a8-aeeb-9fbc1fd5e2bf"]}
  }]], "3ColumnTableMod",ExpressionUUID->"c965bd03-538e-4c8b-9879-\
24a7c69dd3bb"]
}, Open  ]],

