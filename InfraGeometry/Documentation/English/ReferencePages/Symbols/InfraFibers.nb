Cell["\<\
The fibers of a branched fibration over a grid, each in its own colour: a \
vertex over one colour class of the grid, an edge over the other.\
\>", "ExampleText",ExpressionUUID->"aa4dcb8d-1b8c-41e0-b4b9-df6803ab3c60"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<BranchedGridFibration\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"total", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraDensity", "[", 
        RowBox[{"total", ",", " ", 
         RowBox[{"VertexList", " ", "@", " ", "#"}]}], "]"}], " ", "&"}], " ",
       "/@", " ", 
      RowBox[{"Values", " ", "@", " ", 
       RowBox[{"InfraFibers", "[", "fib", "]"}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"35faddbf-5127-41a0-bf58-7057a5a554a2"],

