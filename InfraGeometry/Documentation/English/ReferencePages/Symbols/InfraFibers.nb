Cell[CellGroupData[{
Cell["InfraFibers", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"da1dc4f4-1420-4168-9a49-b4ba7d092ed0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFibers"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFibers", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ef078d2-77a8-4b55-b8c7-7502b5fc960c"],
 "\[LineSeparator]",
 "gives the association <|",
 StyleBox["p", "TI"],
 " -> ",
 StyleBox["F(p)", "TI"],
 ", \[Ellipsis]|> of the fibers of ",
 StyleBox["fib", "TI"],
 " over every base vertex ",
 StyleBox["p", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"9c14fb44-bf43-40c3-8c55-d9be84584208"],

Cell[TextData[{
 "The fiber ",
 StyleBox["F(p)", "TI"],
 " is the subgraph of the total graph induced on ",
 StyleBox["\[Pi]\:207b\.b9(p)", "TI"],
 ", as given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiber"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiber", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ad823bff-7012-446b-a197-2f32f954c824"],
 "."
}], "Notes",ExpressionUUID->"d2358d66-a81d-4f3f-b427-feb2393b58a2"],

Cell["\<\
The fibers partition the vertices of the total graph, so their sizes add up \
to its vertex count.\
\>", "Notes",ExpressionUUID->"cae560aa-a0fb-40b3-904c-b9d6506e057e"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"VertexCount", " ", "/@", " ", 
   RowBox[{"InfraFibers", "[", "fib", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cab58f40-8401-4474-aedf-b68bf7a695af"],
 " is the fiber size as a function on the base. All sizes are equal exactly \
when ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEqualFiberSizesQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEqualFiberSizesQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fa6ef5f2-aa7b-4910-8be2-575467d68c76"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76868763-df78-467b-9605-ccf5cb911ca4"],
 "."
}], "Notes",ExpressionUUID->"85aef335-8e18-4cd3-b85d-f3e543083300"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDisplacementBundle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67115f0b-cfe7-43d0-855f-7ddb5c756add"],
 " the fiber over ",
 StyleBox["p", "TI"],
 " has one vertex for each vertex at distance ",
 StyleBox["r", "TI"],
 " from ",
 StyleBox["p", "TI"],
 ". On the square grid, away from the rim, that is ",
 StyleBox["4r", "TI"],
 "."
}], "Notes",ExpressionUUID->"86340975-c610-47b4-9d07-4eb2a75bb206"]
}, Open  ]],

