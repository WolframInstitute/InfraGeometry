Cell["\<\
The sizes of the fibers add up to the number of vertices of the total graph:\
\>", "ExampleText",ExpressionUUID->"74c38a3a-93d8-4013-867f-6f9bf89196ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraDisplacementBundle", "[", 
      RowBox[{"g", ",", " ", "3"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{"VertexCount", " ", "/@", " ", 
       RowBox[{"InfraFibers", "[", "fib", "]"}]}], "]"}], ",", " ", 
     RowBox[{"VertexCount", " ", "@", " ", 
      RowBox[{"InfraTotalSpace", "[", "fib", "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4c16c355-5ebb-446e-b813-eec585e55656"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"840", ",", "840"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1c81ea58-e0a0-4a0d-bf2c-bfb71a66523c"]
}, Open  ]],

Cell["The keys are the vertices of the base:", "ExampleText",ExpressionUUID->"d7bd1988-558f-4f98-8177-f550c636298d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<BranchedGridFibration\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraFibers", "[", "fib", "]"}]}]}], " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"InfraBaseSpace", "[", "fib", "]"}]}]}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"26ec1eff-63d7-4048-a7a9-3df6a1bf224c"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"907bb8d2-23a9-4624-afbd-76c0a40be35f"]
}, Open  ]]
}, Open  ]],

