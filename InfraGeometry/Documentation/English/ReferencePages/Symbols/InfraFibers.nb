Cell["\<\
The fibers of a branched fibration over a grid, each in its own colour: a \
vertex over one colour class of the grid, an edge over the other.\
\>", "ExampleText",ExpressionUUID->"43ff7a6b-bf17-4823-8239-61f8704e7f8a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<BranchedGridFibration\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"total", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraDensity", "[", 
        RowBox[{"total", ",", " ", 
         RowBox[{"VertexList", " ", "@", " ", "#"}]}], "]"}], " ", "&"}], " ",
       "/@", " ", 
      RowBox[{"Values", " ", "@", " ", 
       RowBox[{"InfraFibers", "[", "fib", "]"}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d211919c-b7cb-466d-bf06-89032ab5cc8b"],

