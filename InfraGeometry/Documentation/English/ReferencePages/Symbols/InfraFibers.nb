Cell["\<\
The sizes of the fibers of the grid displacement bundle, drawn as a density \
on the base: two neighbours at a corner, four inside.\
\>", "ExampleText",ExpressionUUID->"9da0707c-1e45-4bc7-b2d9-f2b459c37d1d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridDisplacementBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{
     RowBox[{"First", " ", "@", " ", "fib"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"VertexCount", " ", "/@", " ", 
       RowBox[{"InfraFibers", "[", "fib", "]"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"dafe2e65-5ad8-4cb5-a4c1-a2f660f57131"],

