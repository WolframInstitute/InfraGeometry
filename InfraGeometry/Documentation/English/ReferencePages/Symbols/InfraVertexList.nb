   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"picks", " ", "=", " ", 
       RowBox[{"InfraVertexList", "[", 
        RowBox[{"g", ",", " ", "seg", ",", " ", "All"}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{"picks", ",", " ", 
         RowBox[{
          RowBox[{"InfraMemberQ", "[", 
           RowBox[{"g", ",", " ", "seg", ",", " ", "#"}], "]"}], " ", "&"}]}],
         "]"}], ",", " ", 
       RowBox[{
        RowBox[{"Length", " ", "@", " ", "picks"}], " ", "===", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<Cardinality\>\""}], 
         "]"}]}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"788488dc-a6bf-4b9f-851f-728ac5d7eea3"],

