Cell[TextData[{
 "A closed count that cannot be met is ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f11c1ef-d53c-4c02-95c3-9aebb83b9244"],
 "; ",
 Cell[BoxData["UpTo"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba8e6ad0-a798-4d2f-a5ed-fc9d24461509"],
 " takes what there is."
}], "ExampleText",ExpressionUUID->"ed225265-fee1-40bb-a7fa-65f1c98ff476"],

