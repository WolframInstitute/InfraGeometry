Cell[TextData[{
 "A uniformly random geodesic of a segment, drawn over the whole family. ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "675141c9-bf2c-4428-b399-d1df4e67e90a"],
 " in front fixes the draw."
}], "ExampleText",ExpressionUUID->"9878e86b-6f3b-4d0b-9a9e-e285f807b338"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"41", ",", " ", "61"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "3", "]"}], ";", "\n", "  ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"picks", " ", "=", " ", 
        RowBox[{"InfraVertexList", "[", 
         RowBox[{
         "g", ",", " ", "seg", ",", " ", "1", ",", 
          " ", "\"\<RandomChoice\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{"seg", ",", " ", 
            RowBox[{"InfraWalk", "[", 
             RowBox[{"First", " ", "@", " ", "picks"}], "]"}]}], "}"}], ",", 
          " ", 
          RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", " ", 
        "picks"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"19091910-f7fd-4206-a27d-16dc0ff38125"],

