      RowBox[{"41", ",", " ", "61"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"picks", " ", "=", " ", 
       RowBox[{"InfraVertexList", "[", 
        RowBox[{"g", ",", " ", "seg", ",", " ", "All"}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{"picks", ",", " ", 
         RowBox[{
          RowBox[{"InfraMemberQ", "[", 
           RowBox[{"g", ",", " ", "seg", ",", " ", "#"}], "]"}], " ", "&"}]}],
         "]"}], ",", " ", 
       RowBox[{
        RowBox[{"Length", " ", "@", " ", "picks"}], " ", "===", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<Cardinality\>\""}], 
         "]"}]}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6a02ead8-3416-4559-981e-97f66d17283f"],

