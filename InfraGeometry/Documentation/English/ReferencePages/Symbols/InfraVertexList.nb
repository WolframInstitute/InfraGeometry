Cell[TextData[{
 "A uniformly random geodesic of a segment, drawn over the whole family. ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0467e78-44e8-4fb4-a655-a00dd8f05139"],
 " in front fixes the draw."
}], "ExampleText",ExpressionUUID->"e03c1560-aec2-493b-b863-5050b80c066c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"41", ",", " ", "61"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "3", "]"}], ";", "\n", "  ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"picks", " ", "=", " ", 
        RowBox[{"InfraVertexList", "[", 
         RowBox[{
         "g", ",", " ", "seg", ",", " ", "1", ",", 
          " ", "\"\<RandomChoice\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraHighlightGraph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{"seg", ",", " ", 
            RowBox[{"InfraWalk", "[", 
             RowBox[{"First", " ", "@", " ", "picks"}], "]"}]}], "}"}], ",", 
          " ", 
          RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", " ", 
        "picks"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"668785dc-4bc2-41bd-85a1-92426c5cdd2c"],

