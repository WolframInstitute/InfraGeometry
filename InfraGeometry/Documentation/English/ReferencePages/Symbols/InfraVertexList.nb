Cell[CellGroupData[{
Cell["InfraVertexList", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c924a115-7886-4126-9360-323705504bf8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraVertexList"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraVertexList", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52be6ac6-3490-4419-a28e-c8bcfc0cde29"],
 "\[LineSeparator]",
 "gives one member of the Euclidean head ",
 StyleBox["obj", "TI"],
 " as a vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"65721099-de04-439f-b119-193301e310d8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraVertexList"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraVertexList", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", 
    RowBox[{
     StyleBox["n", "TI"], " ", "|", " ", 
     RowBox[{
      ButtonBox["UpTo",
       BaseStyle->"Link"], "[", 
      StyleBox["n", "TI"], "]"}], " ", "|", " ", 
     ButtonBox["All",
      BaseStyle->"Link"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a29d35e-0170-45f8-a8a1-9110809fb769"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cee8672-5f86-41cb-a870-13d0334962dd"],
 " of ",
 StyleBox["n", "TI"],
 ", at most ",
 StyleBox["n", "TI"],
 ", or every member."
}], "Usage",ExpressionUUID->"aa7b9bc9-443b-47b0-9648-837292b96191"],

Cell[TextData[{
 "A member is a source-to-sink chain of the head's graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d234246e-a560-4b57-8670-9fe03ed24b72"],
 " \[LongDash] read off in lexicographic order. A circle's graph is a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd202f60-f814-46f9-8240-0d5fd6cde0a3"],
 " of necklaces, each opened at its closing arrow ",
 StyleBox["u", "TI"],
 " -> ",
 StyleBox["s1", "TI"],
 ", so each is an acyclic DAG with one source and one sink; a circle's member \
is the open chain ",
 StyleBox["s1", "TI"],
 " \[Ellipsis] ",
 StyleBox["u", "TI"],
 ", a cyclic vertex list whose first vertex is not repeated. A closed count \
under a non-negative integer ",
 StyleBox["n", "TI"],
 " that exceeds the number of members gives ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b65a1507-ba96-4014-8551-70173e2d8549"],
 ", matching every ",
 Cell[BoxData[
  RowBox[{"Find", "*"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50044170-318a-4dd1-99c8-c61ff8ec6e00"],
 " count contract."
}], "Notes",ExpressionUUID->"71918897-1727-45f6-b268-b2c3ab9a2fb8"],

Cell["Two modifiers, given after the count:", "Notes",ExpressionUUID->"daa19388-97a6-4938-9de6-d3923eeb8348"],

Cell[TextData[{
 Cell[BoxData["\"\<RandomChoice\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "573cf699-fe85-45cf-ad86-6f3b897d2ce6"],
 " walks the graph choosing the next arrow ",
 StyleBox["v", "TI"],
 " -> ",
 StyleBox["w", "TI"],
 " with probability proportional to the backward count at ",
 StyleBox["w", "TI"],
 ", so every member of the family is drawn with probability ",
 Cell[BoxData[
  RowBox[{"1", " ", "/", " ", "Cardinality"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd894b7e-57fd-40a6-81ac-54d3414ca641"],
 "; ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d9a719e-bae4-40a4-b4af-ad2aebef0510"],
 " in front reproduces the draw."
}], "Notes",ExpressionUUID->"4493e1a5-7115-458e-807b-7a7508bf1012"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5e053e6-ed0f-4f9a-af56-b9a5a922e726"],
 " discards a random fraction ",
 StyleBox["q", "TI"],
 " of the candidates at each step of an otherwise exhaustive enumeration."
}], "Notes",ExpressionUUID->"f9d0538e-44e2-4e2b-a4f0-e2a4b63bb625"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraVertexList", "[", 
   RowBox[{"graph", ",", " ", "obj"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dd74d43-1bec-4eab-bb2d-3b41445844b5"],
 " (no count) is the same as ",
 Cell[BoxData[
  RowBox[{"InfraVertexList", "[", 
   RowBox[{"graph", ",", " ", "obj", ",", " ", "Automatic"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1717e344-ad65-46db-9394-e115803f2686"],
 ", the first member in canonical order."
}], "Notes",ExpressionUUID->"7d290974-0b16-45bd-b139-9702f256286c"]
}, Open  ]],

