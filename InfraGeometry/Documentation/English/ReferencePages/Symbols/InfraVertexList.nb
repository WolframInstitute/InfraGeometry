Cell[CellGroupData[{
Cell["InfraVertexList", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d73bd9c8-2ef5-4226-81dd-271b9d9c9382"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraVertexList"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraVertexList", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1396d7d2-1dd2-4052-9b2f-e0aab0fc5019"],
 "\[LineSeparator]",
 "gives one member of the Euclidean head ",
 StyleBox["obj", "TI"],
 " as a vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"951a65c7-a9ea-4091-aabf-16bf17cf18f8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraVertexList"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraVertexList", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", 
    RowBox[{
     StyleBox["n", "TI"], " ", "|", " ", 
     RowBox[{
      ButtonBox["UpTo",
       BaseStyle->"Link"], "[", 
      StyleBox["n", "TI"], "]"}], " ", "|", " ", 
     ButtonBox["All",
      BaseStyle->"Link"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b7b4403-1485-4da0-bb8c-80818b9da80a"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22c7eba1-18ab-4504-b5c5-53a102d7d80a"],
 " of ",
 StyleBox["n", "TI"],
 ", at most ",
 StyleBox["n", "TI"],
 ", or every member."
}], "Usage",ExpressionUUID->"2f7aea72-73ba-435a-aab1-6bb3fb8f9ee2"],

Cell[TextData[{
 "A member is a source-to-sink chain of the head's graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d546ea01-325e-4359-b7fc-15af8debb175"],
 " \[LongDash] read off in lexicographic order. A circle's graph is a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ddd95947-5341-41d6-a7c8-b45e9b122215"],
 " of necklaces, each opened at its closing arrow ",
 StyleBox["u", "TI"],
 " -> ",
 StyleBox["s1", "TI"],
 ", so each is an acyclic DAG with one source and one sink; a circle's member \
is the open chain ",
 StyleBox["s1", "TI"],
 " \[Ellipsis] ",
 StyleBox["u", "TI"],
 ", a cyclic vertex list whose first vertex is not repeated. A closed count \
under a non-negative integer ",
 StyleBox["n", "TI"],
 " that exceeds the number of members gives ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da11e921-2424-4b6d-9610-8f40925ddce5"],
 ", matching every ",
 Cell[BoxData[
  RowBox[{"Find", "*"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73c8822b-e0fd-4a67-8194-9e95bb11242a"],
 " count contract."
}], "Notes",ExpressionUUID->"36398878-19d4-4571-ae85-884201786af5"],

Cell["Two modifiers, given after the count:", "Notes",ExpressionUUID->"91f61ade-eb38-413e-90cd-99c917a06271"],

Cell[TextData[{
 Cell[BoxData["\"\<RandomChoice\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2923621a-fee2-488b-a26d-54ac92c85bc0"],
 " walks the graph choosing the next arrow ",
 StyleBox["v", "TI"],
 " -> ",
 StyleBox["w", "TI"],
 " with probability proportional to the backward count at ",
 StyleBox["w", "TI"],
 ", so every member of the family is drawn with probability ",
 Cell[BoxData[
  RowBox[{"1", " ", "/", " ", "Cardinality"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69657ddc-fc7f-4241-bca7-d54997a7d127"],
 "; ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b9a0e78-fea5-408b-89be-01ed3685cfa4"],
 " in front reproduces the draw."
}], "Notes",ExpressionUUID->"f5bea32a-c750-4173-b964-370fa8b68be2"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fcefbfc2-b7c6-4b55-83d9-488304140e47"],
 " discards a random fraction ",
 StyleBox["q", "TI"],
 " of the candidates at each step of an otherwise exhaustive enumeration."
}], "Notes",ExpressionUUID->"77296703-c4c0-4755-9ef9-95226fe9e4ab"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraVertexList", "[", 
   RowBox[{"graph", ",", " ", "obj"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f41c1921-6213-4ae3-b1b7-28914cac8524"],
 " (no count) is the same as ",
 Cell[BoxData[
  RowBox[{"InfraVertexList", "[", 
   RowBox[{"graph", ",", " ", "obj", ",", " ", "Automatic"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87ca8d2d-c714-4848-9895-103f2d399391"],
 ", the first member in canonical order."
}], "Notes",ExpressionUUID->"e528607a-57a3-4e22-9d0f-c5a5248ff3fc"]
}, Open  ]],

