         ",", " ", "46", ",", " ", "36"}], "}"}]}], "}"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraWalk", "[", "w", "]"}], ",", " ", 
          RowBox[{"First", " ", "@", " ", "w"}]}], "}"}], ",", "\n", "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"DeleteCases", "[", 
           RowBox[{
            RowBox[{"WalkSingularities", "[", "w", "]"}], ",", " ", 
            RowBox[{"{", "}"}]}], "]"}]}]}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"w", ",", " ", "walks"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c8186aa1-77f2-4509-83ef-7edb079b183a"],

