Cell["\<\
A walk is immersed exactly when it has no cusp. On 50 random walks of 6 edges:\
\>", "ExampleText",ExpressionUUID->"6bc515a7-cf49-4db2-97fa-60416a91df17"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{"RandomInfraWalk", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", 
       RowBox[{"{", "6", "}"}], ",", " ", "50", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{"walks", ",", " ", 
     RowBox[{"w", " ", "|->", " ", 
      RowBox[{
       RowBox[{"InfraImmersedQ", "[", 
        RowBox[{"g", ",", " ", "w"}], "]"}], " ", "===", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"WalkSingularities", "[", "w", "]"}], "[", "\"\<Cusps\>\"", 
          "]"}], " ", "===", " ", 
         RowBox[{"{", "}"}]}], ")"}]}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"792e77a6-0bd0-4a67-909e-6ec9ec96924e"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c3b59bd0-f73f-4370-8b35-15ef15e3ff5f"]
}, Open  ]]
}, Open  ]],

