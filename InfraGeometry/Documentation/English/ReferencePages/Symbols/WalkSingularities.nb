Cell["\<\
A walk that crosses itself, one that runs back along a stretch, and one that \
turns back, each from the marked vertex. The labels name the kinds of \
singularity found. A stretch run twice and a cusp revisit vertices, so they \
come with self-intersections:\
\>", "ExampleText",ExpressionUUID->"5c25691b-7567-4ecd-a56c-d4a64636c478"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "25", ",", " ", "35", ",", " ", "45", ",", " ", "55", ",", " ", "65", 
         ",", " ", "66", ",", " ", "56", ",", " ", "46", ",", " ", "45", ",", 
         " ", "44", ",", " ", "43"}], "}"}], ",", " ", 
