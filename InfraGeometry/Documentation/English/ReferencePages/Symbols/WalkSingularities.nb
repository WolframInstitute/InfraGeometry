     "the blocks ",
     StyleBox["i \[Minus] k", "TI"],
     ", \[Ellipsis], ",
     StyleBox["i + k", "TI"],
     " about each turning point ",
     StyleBox["i", "TI"],
     ", where ",
     StyleBox["v\:1d62\:208b\:209c = v\:1d62\:208a\:209c", "TI"],
