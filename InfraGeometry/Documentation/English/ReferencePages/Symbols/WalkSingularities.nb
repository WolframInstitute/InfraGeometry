}], "Usage",ExpressionUUID->"98240e58-f8f4-42c9-aec8-d04d82cf88be"],

Cell[TextData[{
 "For a walk ",
 StyleBox["v\:2081", "TI"],
 ", \[Ellipsis], ",
 StyleBox["v\:2098", "TI"],
 " the result is an association:"
}], "Notes",ExpressionUUID->"3bdff0b9-8d6c-498d-87b3-2dd38da58a0d"],

