Cell[TextData[{
 "A walk graph, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "18ed04d8-b84d-475b-9480-43f1e2e5d658"],
 " returns. A random walk of 6 edges from the centre steps back at once:"
}], "ExampleText",ExpressionUUID->"7a617511-07a9-4be2-a6cb-1a2afe3da7ad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"walk", " ", "=", " ", 
     RowBox[{"RandomInfraWalk", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", 
       RowBox[{"{", "6", "}"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Last", " ", "/@", " ", 
      RowBox[{"VertexList", "[", "walk", "]"}]}], ",", " ", 
     RowBox[{"WalkSingularities", "[", "walk", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"14e46d32-ac37-4ecb-8246-cac89ee8cb0b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "45", ",", "55", ",", "45", ",", "35", ",", "25", ",", "15", ",", "14"}], 
    "}"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"SelfIntersections\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}], "}"}]}], ",", 
     RowBox[{"\<\"SelfTangencies\"\>", "\[Rule]", 
      RowBox[{"{", "}"}]}], ",", 
     RowBox[{"\<\"Cusps\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], "}"}]}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ced9f0f1-af4d-47cd-a209-b2704bed492a"]
}, Open  ]],

Cell[TextData[{
 "A closed walk is a directed cycle on the position pairs {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "}, read round the cycle. The figure eight through 45 passes it twice as a \
closed walk, three times as the open list that starts and ends there:"
}], "ExampleText",ExpressionUUID->"1330e590-0780-4d87-8fc3-1d67188a4500"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"seq", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "45", ",", " ", "46", ",", " ", "56", ",", " ", "55", ",", " ", "45", ",",
        " ", "44", ",", " ", "34", ",", " ", "35"}], "}"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"closed", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{"DirectedEdge", " ", "@@@", " ", 
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{"MapIndexed", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"First", " ", "@", " ", "#2"}], ",", " ", "#1"}], "}"}],
             " ", "&"}], ",", " ", "seq"}], "]"}], ",", " ", "2", ",", " ", 
         "1", ",", " ", "1"}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"WalkSingularities", "[", "closed", "]"}], 
      "[", "\"\<SelfIntersections\>\"", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"WalkSingularities", "[", 
       RowBox[{"Append", "[", 
        RowBox[{"seq", ",", " ", "45"}], "]"}], "]"}], 
      "[", "\"\<SelfIntersections\>\"", "]"}]}], "}"}]}], "]"}]], "Input",
