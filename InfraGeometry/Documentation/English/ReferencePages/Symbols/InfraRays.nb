}], "ExampleText",ExpressionUUID->"83f8ceec-a961-4335-a99a-e446fdcdfb93"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"InfraRays", "[", 
      RowBox[{"g", ",", " ", "6", ",", " ", "2"}], "]"}]}], " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"InfraFiber", "[", 
       RowBox[{
        RowBox[{"InfraTangentBundle", "[", 
         RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", "6"}], "]"}]}]}]}]}], 
  "]"}]], "Input",
