Cell["\<\
The rays of length 2 from an interior vertex of the grid, each in its own \
colour.\
\>", "ExampleText",ExpressionUUID->"87ee85ab-569d-43b7-b072-067d3bab6614"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"InfraFiberedSubstrate", "[", 
       RowBox[{"\"\<GridTangentBundle\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"InfraWalk", " ", "/@", " ", 
      RowBox[{"InfraRays", "[", 
       RowBox[{"g", ",", " ", "6", ",", " ", "2"}], "]"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ecc154b4-e3d0-49bd-a448-baa0c94ff6ea"],

