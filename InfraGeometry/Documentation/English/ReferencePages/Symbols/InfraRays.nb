}], "ExampleText",ExpressionUUID->"2edde7ed-91b0-4e7c-b7cc-d60281850472"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"InfraRays", "[", 
      RowBox[{"g", ",", " ", "6", ",", " ", "2"}], "]"}]}], " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"InfraFiber", "[", 
       RowBox[{
        RowBox[{"InfraTangentBundle", "[", 
         RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", "6"}], "]"}]}]}]}]}], 
  "]"}]], "Input",
