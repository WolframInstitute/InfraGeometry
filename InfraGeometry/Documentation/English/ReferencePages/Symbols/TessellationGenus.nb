Notebook[{

Cell[CellGroupData[{
Cell["TessellationGenus", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5d6e0a19-1236-435c-a6ea-6b27c30406f9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGenus"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGenus", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["spec", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21d8324e-3d14-4658-8def-6a0f444c4e85"],
 "\[LineSeparator]",
 "gives the genus of the surface of the ",
 StyleBox["k", "TI"],
 "-th map of type ",
 StyleBox["spec", "TI"],
 ", a symbol {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} or a vertex configuration, from the type and the size of the map alone.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8acecd44-1626-4a2f-989e-80895836bc2f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGenus"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGenus", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["spec", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc61745e-da81-4240-b325-07ef03537b3d"],
 "\[LineSeparator]",
 "gives the genus of the first map.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"66bac7c4-b611-405a-ae97-a15efbaddda9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGenus"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGenus", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["spec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31fb7edb-1329-47be-87de-2fe1bdbd24ad"],
 "\[LineSeparator]",
 "gives the genus of the orientable closed surface that carries the map with \
graph ",
 StyleBox["g", "TI"],
 " and type ",
 StyleBox["spec", "TI"],
 "."
}], "Usage",ExpressionUUID->"cc5cbe66-bb3d-4294-805e-0d10abe6b19f"],

Cell[TextData[{
 "Definition: the genus is (2 \[Minus] ",
 StyleBox["\[Chi]", "TI"],
 ")/2, ",
 StyleBox["\[Chi]", "TI"],
 " the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationEulerCharacteristic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/\
TessellationEulerCharacteristic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3bd8a6ae-c697-4516-aadf-8af4bd2265a4"],
 " of the map: 0 for the sphere, 1 for the torus, the number of handles in \
general."
}], "Notes",ExpressionUUID->"3823ebcc-7b35-43e7-91f0-bb3c31fa2f07"],

Cell[TextData[{
 "The maps of a type are counted as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3d098a5d-8214-40a6-8303-dc4dbf83972f"],
 ", so the ",
 StyleBox["k", "TI"],
 "-th map is the map of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ff3f307d-0438-4e40-9737-4fbb2eada73a"],
 "[",
 StyleBox["spec", "TI"],
 ", ",
 StyleBox["k", "TI"],
 "]. When every vertex has the configuration (",
 StyleBox["f", "TI"],
 "\:2081, \[Ellipsis], ",
 StyleBox["f", "TI"],
 "\:2096), ",
 StyleBox["\[Chi]", "TI"],
 " = ",
 StyleBox["V \[Kappa]", "TI"],
 " with ",
 StyleBox["\[Kappa]", "TI"],
 " the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationCurvature"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationCurvature", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9c395e64-91dc-4cdc-b94d-368d20a0e4d5"],
 ", so the genus is 1 \[Minus] ",
 StyleBox["V \[Kappa]", "TI"],
 "/2 and depends on the type and the number of vertices only."
}], "Notes",ExpressionUUID->"7d608351-9c63-4845-80b7-dc607cd5309f"],

Cell[TextData[{
 "For a symbol {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} the ",
 StyleBox["k", "TI"],
 "-th map is a quotient ",
 StyleBox["G", "TI"],
 " of the triangle group, with ",
 StyleBox["V", "TI"],
 " = |",
 StyleBox["G", "TI"],
 "|/",
 StyleBox["q", "TI"],
 " vertices, so its genus is ",
 StyleBox["g", "TI"],
 " = 1 + |",
 StyleBox["G", "TI"],
 "| (",
 StyleBox["pq", "TI"],
 " \[Minus] 2",
 StyleBox["p", "TI"],
 " \[Minus] 2",
 StyleBox["q", "TI"],
 ")/(4",
 StyleBox["pq", "TI"],
 "). The order |",
 StyleBox["G", "TI"],
 "| is all the sized form takes from the enumeration of the normal subgroups. \
A map of a Euclidean type is a torus, of genus 1 at every size; a spherical \
type has one map, of genus 0."
}], "Notes",ExpressionUUID->"4e3e89cf-bf5d-4ba3-a796-a11bc1cd4e7e"],

Cell[TextData[{
 "A uniform map is built on the ",
 StyleBox["k", "TI"],
 "-th map of a regular parent type by rectification and truncation. These \
operations keep the surface, so the uniform map has the genus of its parent."
}], "Notes",ExpressionUUID->"7f718002-03e5-41c4-8557-1c7ef5f2fe47"],

Cell[TextData[{
 "It is the genus of the surface of this map, which can exceed the least \
genus of a surface on which ",
 StyleBox["g", "TI"],
 " can be drawn without crossings."
}], "Notes",ExpressionUUID->"2b8e77b6-7aca-434d-a84c-a38c31273758"],

Cell[TextData[{
 "The formula presumes an orientable surface. Every map of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a0dd19f6-1309-4115-a8a9-8e6e6907ab77"],
 " is orientable."
}], "Notes",ExpressionUUID->"79aab7a1-4239-4d91-ad46-fecfe64e4ad9"]
}, Open  ]],

