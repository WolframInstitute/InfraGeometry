 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"40b7f020-c16f-4697-8319-e18a002c55d1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGenus"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGenus", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["spec", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8bd6dc96-87f0-4900-ba9a-d4e1cfce9d3d"],
 "\[LineSeparator]",
 "gives the genus of the surface of the ",
 StyleBox["k", "TI"],
 "-th map of type ",
 StyleBox["spec", "TI"],
 ", a symbol {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} or a vertex configuration, as counted by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e46be683-16a5-4979-b6b7-794d3a175a7e"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"9467ceb6-6d88-4a15-8274-abd7c03a8186"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGenus"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGenus", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["spec", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd984308-6833-4622-9643-5066b10be1b2"],
 "\[LineSeparator]",
 "gives the genus of the first map.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"69e60563-12f7-4f19-8c3e-6f95801b0d21"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGenus"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGenus", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["spec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d30035d8-ea1c-4c17-9c46-21bbc43bbe87"],
 "\[LineSeparator]",
 "gives the genus of the closed orientable surface that carries the map with \
graph ",
 StyleBox["g", "TI"],
 " and type ",
 StyleBox["spec", "TI"],
 "."
}], "Usage",ExpressionUUID->"f098b8a1-f21e-4273-9bde-e4bea3079425"],

Cell[TextData[{
 "The genus is ",
 StyleBox["\[Gamma] = (2 \[Minus] \[Chi])/2", "TI"],
 ", with ",
 StyleBox["\[Chi]", "TI"],
 " the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationEulerCharacteristic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/\
TessellationEulerCharacteristic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "739e8e5c-17b4-4cba-b95b-59a5c515a9f4"],
 " of the map: 0 for the sphere, 1 for the torus, the number of handles in \
general."
}], "Notes",ExpressionUUID->"6c7c7b90-a8ce-46a9-9ba6-3448945ce3aa"],

Cell[TextData[{
 "With every vertex of curvature ",
 StyleBox["\[Kappa]", "TI"],
 ", ",
 StyleBox["\[Chi] = V\[Kappa]", "TI"],
 ", so ",
 StyleBox["\[Gamma] = 1 \[Minus] V\[Kappa]/2", "TI"],
 ". For {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} the ",
 StyleBox["k", "TI"],
 "-th map comes from a quotient ",
 StyleBox["G", "TI"],
 " of the (2, ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ") triangle group, with ",
 StyleBox["V = |G|/q", "TI"],
 ", and ",
 StyleBox["\[Gamma] = 1 + |G|(pq \[Minus] 2p \[Minus] 2q)/(4pq)", "TI"],
 "."
}], "Notes",ExpressionUUID->"dad3de94-1a11-4986-b2ef-c24885cb2492"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1108f26f-659b-463a-a8a1-9db8b2638535"], Cell["Type", "TableText",
