Cell[TextData[{
 "The sized form counts the maps of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "141f00cc-7c43-47f3-8897-33fb344fee42"],
 ": past the order 1100 of the group, and past the one map of a spherical \
type, it stays unevaluated."
}], "ExampleText",ExpressionUUID->"098539a4-cf87-45ed-9119-32a26404657f"],

