Cell[TextData[{
 "The genus can exist where the graph does not. The truncation of the 2 \
\[Times] 2 square torus is a map on the torus, but its parent has multiple \
edges, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "329d49bb-bc25-407c-8d1d-4a8cbed5e1b2"],
 " does not build it."
}], "ExampleText",ExpressionUUID->"213614bf-4e17-4643-b98c-94b5d349bbb4"],

