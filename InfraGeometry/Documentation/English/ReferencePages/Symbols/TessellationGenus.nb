}, Open  ]],

Cell[TextData[{
 "The genus can exist where the graph does not. The truncation of the 2 \
\[Times] 2 square torus lies on the torus, but its parent has multiple edges \
and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "423f44a0-7f09-4004-b763-09195591c523"],
 " does not build it:"
}], "ExampleText",ExpressionUUID->"6483c8a1-a100-4762-80ca-85a98f5b64cd"],

