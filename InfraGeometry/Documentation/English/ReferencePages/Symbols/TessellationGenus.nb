Cell[CellGroupData[{
Cell["TessellationGenus", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6b7fb81c-52c0-4b2e-addd-de8c43f1aaa8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGenus"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGenus", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["spec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62215c43-434d-43f9-8c52-1044800b2c59"],
 "\[LineSeparator]",
 "gives the genus of the orientable closed surface that carries the map with \
graph ",
 StyleBox["g", "TI"],
 " and type ",
 StyleBox["spec", "TI"],
 ": a symbol {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} or a vertex configuration.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c0bc9d7b-e18b-49c1-a903-3284ec70c2a3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGenus"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGenus", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "279ab0e7-64c7-49e7-bf7f-b328137f1b49"],
 "\[LineSeparator]",
 "reads the type off ",
 StyleBox["g", "TI"],
 " as for a regular map."
}], "Usage",ExpressionUUID->"4e61b119-456d-43f7-9b02-8cca0c766826"],

Cell[TextData[{
 "Definition: the genus is (2 \[Minus] ",
 StyleBox["\[Chi]", "TI"],
 ")/2, ",
 StyleBox["\[Chi]", "TI"],
 " the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationEulerCharacteristic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/\
TessellationEulerCharacteristic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "00acf346-929b-4c5d-bbc8-2892983ac985"],
 " of the map: 0 for the sphere, 1 for the torus, the number of handles in \
general."
}], "Notes",ExpressionUUID->"4548c563-4a7b-492c-bded-3686ae3d3560"],

Cell[TextData[{
 "It is the genus of the surface of this map, which can exceed the least \
genus of a surface on which ",
 StyleBox["g", "TI"],
 " can be drawn without crossings."
}], "Notes",ExpressionUUID->"f5419962-1011-483b-b2f9-a326b294853e"],

Cell[TextData[{
 "The formula presumes an orientable surface. Every map of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aa77d481-1c3e-43f5-85e9-bb7d45d8e8a1"],
 " is orientable."
}], "Notes",ExpressionUUID->"e9ad3bfa-5f3f-43ee-abab-740a44147100"],

Cell[TextData[{
 "The graph form takes the type {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} with ",
 StyleBox["p", "TI"],
 " the girth of ",
 StyleBox["g", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " its least degree, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationCurvature"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationCurvature", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7f777bbb-4915-48f8-a67d-421452a0a192"],
 " does."
}], "Notes",ExpressionUUID->"c8f946b7-cde4-4521-b7f6-2d39498b6652"]
}, Open  ]],

