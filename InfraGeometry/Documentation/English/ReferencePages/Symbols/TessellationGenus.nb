   {Cell["      ", "ModInfo",ExpressionUUID->
     "a402abff-09cd-47a5-824f-d07ae0af4348"], Cell[TextData[{
     "spherical, ",
     StyleBox["\[Kappa]", "TI"],
     " > 0"
    }], "TableText",ExpressionUUID->"407d3706-a0f1-462b-9e57-8716bdc93ce2"], 
    Cell["one map, genus 0", "TableText",ExpressionUUID->
     "b452c16c-5468-4b1f-8815-1d6b7761ca13"]},
