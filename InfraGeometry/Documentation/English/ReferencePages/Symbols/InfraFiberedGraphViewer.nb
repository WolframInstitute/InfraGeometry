Cell["\<\
Inspect the same kind of object with upright three-dimensional fibers.\
\>", "ExampleText",ExpressionUUID->"4b04f41e-6a24-4114-8164-67538ee6e351"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFibration", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "4", "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertices\>\"", " ", "->", " ", "3"}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgesDensity\>\"", " ", "->", " ", "All"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"connection", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", "fib", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"InfraFiberedGraphViewer", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", 
      RowBox[{"connection", " ", "->", " ", "StandardBlue"}], "}"}], ",", " ", 
     RowBox[{"Method", " ", "->", " ", "\"\<3DFiber\>\""}]}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"818d9813-be02-4538-b8aa-aaf8f72d4396"],

