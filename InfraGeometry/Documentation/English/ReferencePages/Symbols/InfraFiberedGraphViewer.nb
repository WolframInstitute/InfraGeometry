Cell["\<\
Inspect a continuous section and a connection over the hexagon.\
\>", "ExampleText",ExpressionUUID->"8139b8c2-4063-44cf-a0d2-e672c92b9042"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "3", " ", "}"}]}], ",", "\n", "    ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", " ", "\"\<IsomorphicFibers\>\"", " ", "}"}]}], ",", " ", 
       
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"partial", " ", "=", " ", 
     RowBox[{"RandomInfraSection", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"section", " ", "=", " ", 
     RowBox[{"RandomInfraSection", "[", 
      RowBox[{"fib", ",", " ", "partial", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Continuous\>\"", "}"}]}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"connection", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", "fib", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"InfraFiberedGraphViewer", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", 
      RowBox[{"partial", ",", " ", "section", ",", " ", "connection"}], 
      "}"}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e88496f8-9339-4dce-aed9-1d762df0d997"],

Cell[BoxData[
 DynamicModuleBox[{
  WolframInstitute`InfraGeometry`InfraFiberedGraphViewer`PackagePrivate`\
hovered$$ = {}}, 
  TagBox[GridBox[{
     {
      TemplateBox[{
        TagBox[
         DynamicBox[
          ToBoxes[
           
           With[{WolframInstitute`InfraGeometry`InfraFiberedGraphViewer`\
PackagePrivate`selectedVertices$ = 
             Which[WolframInstitute`InfraGeometry`InfraFiberedGraphViewer`\
PackagePrivate`hovered$$ === {}, {}, 
               First[WolframInstitute`InfraGeometry`InfraFiberedGraphViewer`\
PackagePrivate`hovered$$] === "Vertex", {
                Last[
                WolframInstitute`InfraGeometry`InfraFiberedGraphViewer`\
PackagePrivate`hovered$$]}, True, 
               Apply[List, 
                Last[
                WolframInstitute`InfraGeometry`InfraFiberedGraphViewer`\
PackagePrivate`hovered$$]]]}, {
            WolframInstitute`InfraGeometry`InfraFiberedGraphViewer`\
PackagePrivate`overlays$ = 
             If[WolframInstitute`InfraGeometry`InfraFiberedGraphViewer`\
PackagePrivate`hovered$$ === {}, {}, 
               Join[
                If[
                First[WolframInstitute`InfraGeometry`InfraFiberedGraphViewer`\
PackagePrivate`hovered$$] === "Vertex", {
                  Style[
                   WolframInstitute`InfraGeometry`InfraFiber[
                    WolframInstitute`InfraGeometry`InfraFiberedGraph[
                    
                    Graph[{{1, 1}, {1, 2}, {1, 3}, {2, 1}, {2, 2}, {2, 3}, {3,
                     1}, {3, 2}, {3, 3}, {4, 1}, {4, 2}, {4, 3}, {5, 1}, {5, 
                    2}, {5, 3}, {6, 1}, {6, 2}, {6, 3}}, {
                    Null, {{1, 4}, {1, 5}, {1, 6}, {2, 4}, {2, 5}, {2, 6}, {3,
                     4}, {3, 5}, {3, 6}, {1, 16}, {1, 17}, {1, 18}, {2, 16}, {
                    2, 17}, {2, 18}, {3, 16}, {3, 17}, {3, 18}, {4, 7}, {4, 
                    8}, {4, 9}, {5, 7}, {5, 8}, {5, 9}, {6, 7}, {6, 8}, {6, 
                    9}, {7, 10}, {7, 11}, {7, 12}, {8, 10}, {8, 11}, {8, 
                    12}, {9, 10}, {9, 11}, {9, 12}, {10, 13}, {10, 14}, {10, 
                    15}, {11, 13}, {11, 14}, {11, 15}, {12, 13}, {12, 14}, {
                    12, 15}, {13, 16}, {13, 17}, {13, 18}, {14, 16}, {14, 
                    17}, {14, 18}, {15, 16}, {15, 17}, {15, 18}}}, {
                    GraphLayout -> {"Dimension" -> 2}, 
                    VertexCoordinates -> {{-0.5773502691896263, 
                    0.33333333333333426`}, {-0.8660254037844389, 
                    0.8333333333333339}, {-1.1547005383792515`, 
                    0.33333333333333426`}, {0.2886751345948128, 
                    0.8333333333333335}, {1.8369701987210297`*^-16, 
                    1.333333333333333}, {-0.2886751345948125, 
                    0.8333333333333335}, {1.1547005383792512`, 
                    0.3333333333333327}, {0.8660254037844386, 
                    0.8333333333333324}, {0.577350269189626, 
                    0.3333333333333327}, {
                    1.1547005383792515`, -0.6666666666666677}, {
                    0.8660254037844389, -0.16666666666666813`}, {
                    0.5773502691896263, -0.6666666666666677}, {
                    0.28867513459481303`, -1.1666666666666665`}, {
                    3.8285686989269494`*^-16, -0.666666666666667}, \
{-0.28867513459481225`, -1.1666666666666665`}, {-0.5773502691896257, \
-0.666666666666666}, {-0.8660254037844384, -0.1666666666666663}, \
{-1.154700538379251, -0.666666666666666}}, 
                    VertexStyle -> {{4, 2} -> 
                    RGBColor[0.55, 0.8182351, 0.5994118], {4, 1} -> 
                    RGBColor[0.55, 0.8182351, 0.5994118], {1, 1} -> 
                    RGBColor[0.9057646, 0.6405292, 0.55], {1, 2} -> 
                    RGBColor[0.9057646, 0.6405292, 0.55], {3, 2} -> 
                    RGBColor[1., 0.82352935, 0.55], {2, 2} -> 
                    RGBColor[0.63647065, 0.72470575, 0.91352935], {6, 2} -> 
                    RGBColor[0.55, 0.81470575, 0.8676469], {5, 3} -> 
                    RGBColor[
                    0.8053417, 0.6954265000000001, 0.8784239500000001], {2, 
                    1} -> RGBColor[0.63647065, 0.72470575, 0.91352935], {6, 
                    1} -> RGBColor[0.55, 0.81470575, 0.8676469], {2, 3} -> 
                    RGBColor[0.63647065, 0.72470575, 0.91352935], {6, 3} -> 
                    RGBColor[0.55, 0.81470575, 0.8676469], {5, 2} -> 
                    RGBColor[
                    0.8053417, 0.6954265000000001, 0.8784239500000001], {3, 
                    1} -> RGBColor[1., 0.82352935, 0.55], {3, 3} -> 
                    RGBColor[1., 0.82352935, 0.55], {4, 3} -> 
                    RGBColor[0.55, 0.8182351, 0.5994118], {1, 3} -> 
                    RGBColor[0.9057646, 0.6405292, 0.55], {5, 1} -> 
                    RGBColor[
                    0.8053417, 0.6954265000000001, 0.8784239500000001]}}], <|{
                    1, 1} -> 1, {1, 2} -> 1, {1, 3} -> 1, {2, 1} -> 2, {2, 2} -> 
                    2, {2, 3} -> 2, {3, 1} -> 3, {3, 2} -> 3, {3, 3} -> 
                    3, {4, 1} -> 4, {4, 2} -> 4, {4, 3} -> 4, {5, 1} -> 
                    5, {5, 2} -> 5, {5, 3} -> 5, {6, 1} -> 6, {6, 2} -> 
                    6, {6, 3} -> 6|>], 
                    Last[
                    WolframInstitute`InfraGeometry`InfraFiberedGraphViewer`\
PackagePrivate`hovered$$]], StandardYellow, 
                   Opacity[0.7]]}, {}], 
                Map[Style[
                  WolframInstitute`InfraGeometry`InfraSection[
                   
                   KeyTake[#, 
                    WolframInstitute`InfraGeometry`InfraFiberedGraphViewer`\
PackagePrivate`selectedVertices$]], StandardOrange, 
                  AbsolutePointSize[10]]& , {<|1 -> {1, 2}, 3 -> {3, 3}|>, <|
                  1 -> {1, 2}, 2 -> {2, 2}, 3 -> {3, 3}, 4 -> {4, 3}, 
                   5 -> {5, 1}, 6 -> {6, 2}|>}], 
                If[
                First[WolframInstitute`InfraGeometry`InfraFiberedGraphViewer`\
PackagePrivate`hovered$$] === "Edge", 
                 Map[
                  Function[
                  WolframInstitute`InfraGeometry`InfraFiberedGraphViewer`\
PackagePrivate`edges$, 
                   Style[
                    WolframInstitute`InfraGeometry`InfraConnection[
                    Select[
                    WolframInstitute`InfraGeometry`InfraFiberedGraphViewer`\
PackagePrivate`edges$, Sort[
                    
                    Lookup[<|{1, 1} -> 1, {1, 2} -> 1, {1, 3} -> 1, {2, 1} -> 
