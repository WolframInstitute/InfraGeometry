  "aec8b6e9-fc24-425d-b35e-15b8adc2b584"],
 " and ",
 Cell[BoxData["\"\<FiberRadius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa61742e-f0a9-462b-8b15-d62b6ea59f99"],
 " have the same meanings as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraphHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraphHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "69e48e9c-1873-4f82-800d-fc8a5c129ab5"],
 ". Unsupported view names remain unevaluated. Live hovering requires the \
Wolfram notebook front end."
}], "Notes",ExpressionUUID->"7276e61b-7fb9-4efd-9afb-e28eebb1ed71"]
