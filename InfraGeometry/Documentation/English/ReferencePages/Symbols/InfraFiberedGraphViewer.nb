Cell[TextData[{
 "The viewer uses ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraphHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraphHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9c300183-ad08-4926-9768-3c80d08a07b7"],
 " and accepts the same object list, style grammar and options. Graph \
structure and styling options apply to the total view. Image size, \
background, labels and text styling also apply to the base view; its \
coordinates and layout use the base-specific options. The total graph appears \
on the left and the reconstructed base on the right. The result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DynamicModule"]], "paclet:ref/DynamicModule"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "94da2b36-5acd-469f-aa10-7d7cd3051a77"],
 ". For a list of options, supply the item list explicitly, as in ",
 Cell[BoxData[
  RowBox[{"InfraFiberedGraphViewer", "[", 
   RowBox[{"fib", ",", " ", 
    RowBox[{"{", "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"Method", " ", "->", " ", "\"\<3DFiber\>\""}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5a83927-e289-4ee2-bc38-84aa1b326ca8"],
 "."
}], "Notes",ExpressionUUID->"4955a6a5-bbdb-415d-8520-b7de0f9f0df5"],

Cell["\<\
Hover a total vertex or a base vertex to highlight its fiber and the supplied \
section values in that fiber.\
\>", "Notes",ExpressionUUID->"539bba40-2dc8-4f94-84de-645740da5ddc"],

Cell["\<\
Hover a base edge to highlight the supplied sections and connection edges \
above that edge.\
\>", "Notes",ExpressionUUID->"2323dbfa-ffbd-4fb8-ae56-be94727629a4"],

Cell["\<\
Supplied sections and connections retain their individual identity; several \
objects are not combined into one mathematical section or connection.\
\>", "Notes",ExpressionUUID->"753d9f61-bf17-4303-97dd-37205f10bc7e"],

Cell["\<\
A walk retains its repeated visits and traversals through the shared \
highlighting operation.\
\>", "Notes",ExpressionUUID->"d89c4a6e-c645-4ede-91e1-193b62e827a8"],

Cell["\<\
The viewer materializes the supplied structure and its layout when created. \
Hovering changes highlights only. It never calls a random section, connection \
or fibration sampler.\
\>", "Notes",ExpressionUUID->"8f834ade-ecfd-4929-a576-7e7096ae46cd"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Method"]], "paclet:ref/Method"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7fae38f4-c81a-4311-bc97-204b2a0c2fae"],
 " accepts ",
 Cell[BoxData["\"\<CircularFiber\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a785b91-a3c7-4488-8534-c5fe59a62802"],
 ", ",
 Cell[BoxData["\"\<3DFiber\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5247956-44a7-46e8-b8ee-b00265a5ca59"],
 " and ",
 Cell[BoxData["\"\<HighlightFiber\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "962455b1-8734-4be0-a32a-f20ff346a166"],
 ". The base is drawn in the plane in every view. ",
 Cell[BoxData["\"\<BaseGraphLayout\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bdad9d8-2252-48dd-8935-63b457ed88c2"],
 ", ",
 Cell[BoxData["\"\<BaseVertexCoordinates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b1a8f5a-ed16-4f16-ba78-5aee362bc818"],
 " and ",
 Cell[BoxData["\"\<FiberRadius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d46353e9-a890-4cae-9a51-d4da4de985e5"],
 " have the same meanings as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraphHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraphHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "41ff86ca-5344-48f5-9cc2-277865190b8c"],
 ". Unsupported view names remain unevaluated. Live hovering requires the \
Wolfram notebook front end."
}], "Notes",ExpressionUUID->"db7c0ee3-d752-4341-aeff-1f1de672c5da"]
