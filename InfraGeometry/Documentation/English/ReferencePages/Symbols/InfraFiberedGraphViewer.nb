  FontSize->0.9 Inherited,ExpressionUUID->
  "c2b30444-3bf7-499e-b86d-6cfb5bcb46d7"],
 " and ",
 Cell[BoxData["\"\<HighlightFiber\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a0b1cf6-6de8-495d-9067-48425570c556"],
 ". The base is drawn in the plane in every view. ",
 Cell[BoxData["\"\<BaseGraphLayout\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f775fc9f-2bad-4223-943c-bf19a49a06cc"],
 ", ",
 Cell[BoxData["\"\<BaseVertexCoordinates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "260f1497-70a7-4e80-86e5-9a41d115dc92"],
 " and ",
 Cell[BoxData["\"\<FiberRadius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c48362b-0c3f-4d43-a9f5-eb967026b507"],
 " have the same meanings as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraphHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraphHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "601b8ffe-50e1-45af-a7e6-8886cbc6a0e6"],
 ". Unsupported view names remain unevaluated. Live hovering requires the \
Wolfram notebook front end."
}], "Notes",ExpressionUUID->"8e04722b-f0ec-48dc-bbe3-8e5d58ce0c27"]
