Cell["\<\
The tensor on the shell of radius 3 about the centre of the square tiling, \
beside the shell it is read on.\
\>", "ExampleText",ExpressionUUID->"552a0efe-618d-4d2a-b838-1aa50dcb20f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"FindInfraShell", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}], ",", " ", "c"}],
         "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"MatrixPlot", "[", 
      RowBox[{"InfraMetricTensor", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"00085338-785f-4e34-abf2-2f7742107ad8"],

