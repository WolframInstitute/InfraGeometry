      RowBox[{"InfraMetricTensor", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"InfraMetricTensor", "[", 
        RowBox[{"g", ",", " ", "c"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"shellIndices", ",", " ", "shellIndices"}], "]"}], "]"}]}]}], 
