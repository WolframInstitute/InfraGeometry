Cell[TextData[{
 "The tensor on a shell of radius 8 against the cosine of the angle between \
the two directions, on the discretized plane, the square grid and the \
hexagonal tiling. The gray curve is the plane's value ",
 StyleBox["max(0, cos \[Theta])", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"89ca996d-7f47-41fc-aef8-24e43b6748da"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Large\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"p", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"shell", " ", "=", " ", 
         RowBox[{"FindInfraShell", "[", 
          RowBox[{"g", ",", " ", "p", ",", " ", "8"}], "]"}]}], "}"}], ",", 
       "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"dirs", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Normalize", "[", 
            RowBox[{
             RowBox[{"AnnotationValue", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"g", ",", " ", "#"}], "}"}], ",", " ", 
               "VertexCoordinates"}], "]"}], " ", "-", " ", 
             RowBox[{"AnnotationValue", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"g", ",", " ", "p"}], "}"}], ",", " ", 
               "VertexCoordinates"}], "]"}]}], "]"}], " ", "&"}], " ", "/@", 
          " ", "shell"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"Show", "[", "\n", "      ", 
        RowBox[{
         RowBox[{"ListPlot", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Flatten", "[", 
               RowBox[{"dirs", " ", ".", " ", 
                RowBox[{"Transpose", "[", "dirs", "]"}]}], "]"}], ",", " ", 
              RowBox[{"Flatten", " ", "@", " ", 
               RowBox[{"InfraMetricTensor", "[", 
                RowBox[{"g", ",", " ", "p", ",", " ", "8"}], "]"}]}]}], "}"}],
             "]"}], ",", "\n", "        ", 
           RowBox[{"PlotRange", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}]}], "]"}], ",", 
         "\n", "      ", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"0", ",", " ", "x"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"x", ",", " ", 
             RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
           RowBox[{"PlotStyle", " ", "->", " ", "Gray"}]}], "]"}], ",", "\n", 
         "      ", 
         RowBox[{"ImageSize", " ", "->", " ", "200"}], ",", " ", 
         RowBox[{"PlotLabel", " ", "->", " ", "name"}]}], "]"}]}], "]"}], ",",
      "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"name", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
         " ", "\"\<SquareTilingGraph\>\"", ",", 
         " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], ",", 
   " ", 
   RowBox[{"Spacer", "[", "10", "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"000b0fbd-2715-4608-94d1-2045bfdf3f3b"],

