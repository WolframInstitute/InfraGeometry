Cell[TextData[{
 "The tensor on the circle of radius 6 against the cosine of the angle at the \
centre, with the plane's value ",
 StyleBox["max(0, cos \[Theta])", "TI"],
 ". The entries are multiples of 1/6, and on both substrates some obtuse \
angles read positive; on the grid the entries are ",
 StyleBox["1 \[Minus] d(v, w)/12", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"a58117bd-fa46-44c5-b8ff-b89fc09a5fc9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Medium\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"circle", " ", "=", " ", 
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"p", ",", " ", "6"}], "]"}], ",", 
           " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"xy", " ", "=", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"dirs", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Normalize", "[", 
           RowBox[{
            RowBox[{"xy", "[", "#", "]"}], " ", "-", " ", 
            RowBox[{"xy", "[", "p", "]"}]}], "]"}], " ", "&"}], " ", "/@", 
         " ", "circle"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Show", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{"dirs", " ", ".", " ", 
               RowBox[{"Transpose", "[", "dirs", "]"}]}], "]"}], ",", " ", 
             RowBox[{"Flatten", " ", "@", " ", 
              RowBox[{"InfraMetricTensor", "[", 
               RowBox[{"g", ",", " ", "p", ",", " ", "6"}], "]"}]}]}], "}"}], 
           "]"}], ",", "\n", "        ", 
          RowBox[{"PlotRange", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}]}], "]"}], ",", 
        "\n", "      ", 
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"0", ",", " ", "x"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", 
            RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "]"}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"15f0ab29-b0f6-4cae-91ad-d085ea118f70"],

