Cell[TextData[{
 "On a shell of the square grid the tensor is ",
 StyleBox["1 \[Minus] d(v, w)/(2r)", "TI"],
 ", at every radius:"
}], "ExampleText",ExpressionUUID->"822eec7d-8d10-4a7a-b4ea-b12ff7bdbf1b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"circle", " ", "=", " ", 
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraShell", "[", 
             RowBox[{"p", ",", " ", "r"}], "]"}], ",", 
            " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", 
       "      ", 
       RowBox[{
        RowBox[{"InfraMetricTensor", "[", 
         RowBox[{"g", ",", " ", "p", ",", " ", "r"}], "]"}], " ", "==", " ", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{
          RowBox[{"Outer", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", "#1", ",", " ", "#2"}], "]"}], " ", 
             "&"}], ",", " ", "circle", ",", " ", "circle"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "r"}], ")"}]}]}]}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "2", ",", " ", "6"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5cffe5f7-cbb0-47a2-a6fa-bb65516788b3"],

