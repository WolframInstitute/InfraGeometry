Cell["\<\
The shell matrix is the submatrix of the full one on the shell:\
\>", "ExampleText",ExpressionUUID->"d300351d-5186-4dd5-8abc-0403d52ffc88"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"indices", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"VertexIndex", "[", 
        RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"p", ",", " ", "2"}], "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{
    RowBox[{"InfraMetricTensor", "[", 
     RowBox[{"g", ",", " ", "p", ",", " ", "2"}], "]"}], " ", "==", " ", 
    RowBox[{
     RowBox[{"InfraMetricTensor", "[", 
      RowBox[{"g", ",", " ", "p"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"indices", ",", " ", "indices"}], "]"}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2aa49cd5-a36c-460e-a672-41b786f57ff4"],

