Cell["\<\
On the hexagon, the interval from 1 to 5 is 1, 6, 5, and its vertices 1 and 5 \
are both at distance 2 from 3. The four rules read that tie differently.\
\>", "ExampleText",ExpressionUUID->"5e42cdc3-cfa2-4582-997b-3319a3efd9e3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"sel", " ", "->", " ", 
    RowBox[{
     RowBox[{"InfraMetricTensor", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", "1", ",", " ", 
       RowBox[{"\"\<SelectCoordinate\>\"", " ", "->", " ", "sel"}]}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"3", ",", " ", "5"}], "]"}], "]"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"sel", ",", " ", 
     RowBox[{"{", 
      RowBox[{"Min", ",", " ", "Max", ",", " ", "Mean", ",", " ", "All"}], 
      "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5417ca0d-999c-4265-b49a-2c0f78f076bc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Min", "\[Rule]", "0"}], ",", 
   RowBox[{"Max", "\[Rule]", "1"}], ",", 
   RowBox[{"Mean", "\[Rule]", 
    FractionBox["1", "2"]}], ",", 
   RowBox[{"All", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}]}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9ad92ca2-d6aa-458a-b352-5d646f2197cb"]
}, Open  ]],

Cell["\<\
On the triangular tiling the ties are the rule rather than the exception: the \
smallest and the largest foot differ in about two thirds of the entries of a \
shell.\
\>", "ExampleText",ExpressionUUID->"926fe35d-b988-46a7-8c9d-469322faca82"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"gap", " ", "=", " ", 
     RowBox[{
      RowBox[{"InfraMetricTensor", "[", 
       RowBox[{"g", ",", " ", "p", ",", " ", "4", ",", " ", 
        RowBox[{"\"\<SelectCoordinate\>\"", " ", "->", " ", "Max"}]}], "]"}], 
      " ", "-", " ", 
      RowBox[{"InfraMetricTensor", "[", 
       RowBox[{"g", ",", " ", "p", ",", " ", "4"}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{"N", " ", "@", " ", 
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{"Flatten", " ", "@", " ", "gap"}], ",", " ", 
       RowBox[{"_", "?", "Positive"}]}], "]"}]}], "/", 
    RowBox[{"Length", "[", 
     RowBox[{"Flatten", " ", "@", " ", "gap"}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1f29648b-051d-4898-9f44-db34e03d6ecb"],

Cell[BoxData["0.6458333333333333`"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"07bcec4d-2a5a-4176-9914-045eb51ee349"]
}, Open  ]]
}, Open  ]],

