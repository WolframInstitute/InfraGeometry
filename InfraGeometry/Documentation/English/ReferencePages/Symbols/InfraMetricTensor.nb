 "The entry is the foot of ",
 StyleBox["v", "TI"],
 " on the interval to ",
 StyleBox["w", "TI"],
 ", read off the explicit construction."
}], "ExampleText",ExpressionUUID->"055ef3d4-625c-47f8-95ab-8589106ef66b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"7", ",", " ", "7"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"feet", " ", "=", " ", 
     RowBox[{"FindClosestInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"MetricInterval", "[", 
        RowBox[{"g", ",", " ", "25", ",", " ", "40"}], "]"}], ",", " ", 
       "12"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Min", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "25", ",", " ", "#"}], "]"}], " ", "&"}], 
        " ", "/@", " ", "feet"}], "]"}], "/", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", "25", ",", " ", "12"}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"InfraMetricTensor", "[", 
       RowBox[{"g", ",", " ", "25"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"12", ",", " ", "40"}], "]"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c8b54155-4940-4ac1-b8ab-8907cd318fec"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["1", "3"], ",", 
   FractionBox["1", "3"]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"35907d2e-a448-4d1e-abc6-484e1af92ec3"]
}, Open  ]],

Cell["\<\
On a shell of the square grid the tensor is one minus the distance over twice \
the radius, at every radius.\
\>", "ExampleText",ExpressionUUID->"e6c20c1d-057d-46ba-b3bd-6351bc95c2c8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"GridGraph", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"2", " ", "r"}], " ", "+", " ", "1"}], ",", " ", 
           RowBox[{
            RowBox[{"2", " ", "r"}], " ", "+", " ", "1"}]}], "}"}], "]"}]}], ",",
        " ", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"r", "^", "2"}]}], " ", "+", " ", 
         RowBox[{"2", " ", "r"}], " ", "+", " ", "1"}]}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"{", 
      RowBox[{"shell", " ", "=", " ", 
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "p", ",", " ", "r"}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{
      RowBox[{"InfraMetricTensor", "[", 
       RowBox[{"g", ",", " ", "p", ",", " ", "r"}], "]"}], " ", "==", " ", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistanceMatrix", "[", "g", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"shell", ",", " ", "shell"}], "]"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "r"}], ")"}]}]}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"r", ",", " ", "2", ",", " ", "6"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1043ca1f-284c-4292-b28e-c3cb539fabae"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True", ",", "True", ",", "True"}], 
  "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"d1643f2e-065d-40f4-a454-f3188c7986cb"]
}, Open  ]],

Cell[TextData[{
 "The comparison cosine of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScalarProduct"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScalarProduct", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2c3e5d06-635c-4b61-9e4d-e590ec0fc237"],
 " reads \[Minus]1 for two orthogonal neighbours on the grid, the same as for \
two opposite ones. The tensor reads 0 for both, which is right for the \
orthogonal pair."
}], "ExampleText",ExpressionUUID->"3b3c3dc9-1a7a-4aa7-ac64-15cf47542206"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraScalarProduct", "[", 
      RowBox[{"g", ",", " ", "13", ",", " ", "12", ",", " ", "8"}], "]"}], ",",
      " ", 
     RowBox[{"InfraMetricTensor", "[", 
      RowBox[{"g", ",", " ", "13", ",", " ", "1"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"5d87e554-ef70-41c5-9972-c20d75d4beec"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "1"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"3a8aafe6-97bc-4db9-ab63-cec8eb9c95af"]
}, Open  ]]
}, Open  ]],

