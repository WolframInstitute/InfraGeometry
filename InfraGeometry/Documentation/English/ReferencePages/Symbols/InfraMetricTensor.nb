Cell[CellGroupData[{
Cell["InfraMetricTensor", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2892b39a-bf18-445e-a010-777876b84c5d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMetricTensor"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMetricTensor", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cba0b576-23b2-46d3-b0f6-740cc8cfbb0b"],
 "\[LineSeparator]",
 "gives the matrix ",
 StyleBox["T", "TI"],
 " over all pairs of vertices ",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["w", "TI"],
 " of ",
 StyleBox["g", "TI"],
 ", with ",
 StyleBox["T[v, w] = d(p, u) / d(p, v)", "TI"],
 " for ",
 StyleBox["u", "TI"],
 " the vertex of the interval ",
 StyleBox["I(p, w)", "TI"],
 " closest to ",
 StyleBox["v", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b5f78ef6-4a2b-40e3-b14d-e38ad65ce1ee"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMetricTensor"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMetricTensor", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cfcd4cc-12b8-4fb6-8a02-1394f39c6ca0"],
 "\[LineSeparator]",
 "gives the matrix over the vertices of the shell ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01f5bb75-3870-4598-a4a1-c9500c7a44b9"],
 "."
}], "Usage",ExpressionUUID->"ab88b6d4-1d87-45d5-ae8d-f8556a68f8b7"],

Cell[TextData[{
 "The interval is ",
 StyleBox["I(p, w) = {u : d(p, u) + d(u, w) = d(p, w)}", "TI"],
 ", the vertices on the shortest paths from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["w", "TI"],
 ". The vertex ",
 StyleBox["u", "TI"],
 " of ",
 StyleBox["I(p, w)", "TI"],
 " closest to ",
 StyleBox["v", "TI"],
 " is the foot of ",
 StyleBox["v", "TI"],
 ", and ",
 StyleBox["T[v, w]", "TI"],
 " is the length of the projection of ",
 StyleBox["v", "TI"],
 " on the direction of ",
 StyleBox["w", "TI"],
 ", over the length of ",
 StyleBox["v", "TI"],
 ". Rows are ",
 StyleBox["v", "TI"],
 ", columns ",
 StyleBox["w", "TI"],
 ". The rows and columns of the full matrix follow ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VertexList"]], "paclet:ref/VertexList"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a6fdc02f-2e67-4f78-a129-66422fa6ff14"],
 "; those of the shell matrix follow the sorted shell."
}], "Notes",ExpressionUUID->"82fbb6ec-830d-490d-8b87-e806b28e89f9"],

Cell[TextData[{
 "In the plane the foot of ",
 StyleBox["v", "TI"],
 " on the segment from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["w", "TI"],
 " gives ",
 StyleBox["T = max(0, cos \[Theta])", "TI"],
 " on a circle about ",
 StyleBox["p", "TI"],
 ", with ",
 StyleBox["\[Theta]", "TI"],
 " the angle at ",
 StyleBox["p", "TI"],
 ": the Gram matrix of the unit directions, an obtuse angle read as 0. This \
is Euclid's projection of Book II, Propositions 12 and 13."
}], "Notes",ExpressionUUID->"30baf76d-cedf-46ce-ae5b-20b16decf5e2"],

Cell[TextData[{
 "The row and the column of ",
 StyleBox["p", "TI"],
 " are 0; the diagonal elsewhere is 1. In general ",
 StyleBox["0 \[LessEqual] T[v, w] \[LessEqual] d(p, w)/d(p, v)", "TI"],
 ", and ",
 StyleBox["T", "TI"],
 " is not symmetric."
}], "Notes",ExpressionUUID->"c23b932e-c0a6-4560-8526-a439f0c19fe3"],

Cell[TextData[{
 "On the square grid the foot is unique, and on a shell of radius ",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["T[v, w] = 1 \[Minus] d(v, w)/(2r)", "TI"],
 " at every radius. So the grid tensor does not approach the cosine: two axis \
directions read 0, as in the plane, but two diagonal directions at a right \
angle read 1/2."
}], "Notes",ExpressionUUID->"e66397a2-2e73-4561-a1d3-7243deb1ea85"],

Cell[TextData[{
 "The foot need not be unique. ",
 Cell[BoxData["\"\<SelectCoordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31a71dcb-8610-481f-9064-2970800a06de"],
 " says which value ",
 StyleBox["d(p, u)", "TI"],
 " of the tied feet is used:"
}], "Notes",ExpressionUUID->"bdfb5ced-af3d-40a3-a736-033336cc0674"],

