Cell["\<\
On a shell of the square tiling the tensor is one minus the distance over \
twice the radius, at every radius.\
\>", "ExampleText",ExpressionUUID->"fcb0a816-44de-4bc0-9424-50d06be1d60c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"MatrixPlot", "[", 
         RowBox[{"InfraMetricTensor", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r", ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4", ",", " ", "6"}], "}"}]}], "}"}]}], 
       "]"}]}], ",", "\n", "   ", 
     RowBox[{"Table", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"shell", " ", "=", " ", 
           RowBox[{"FindInfraShell", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]}], "}"}], ",", 
         "\n", "       ", 
         RowBox[{
          RowBox[{"InfraMetricTensor", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}], " ", "==", " ", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{
            RowBox[{"Outer", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"GraphDistance", "[", 
                RowBox[{"g", ",", " ", "#1", ",", " ", "#2"}], "]"}], " ", 
               "&"}], ",", " ", "shell", ",", " ", "shell"}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", "r"}], ")"}]}]}]}]}], "]"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "2", ",", " ", "6"}], "}"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"aeac69ad-1476-469b-9b8c-bfbc2ef29458"],

