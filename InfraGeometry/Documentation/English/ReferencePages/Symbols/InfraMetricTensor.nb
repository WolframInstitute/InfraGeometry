Cell[TextData[{
 "Along a path, based at an end, the entry is ",
 StyleBox["min(d(p,v), d(p,w)) / d(p,v)", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"abc3e7f3-68eb-46a1-84ec-806ff04c9343"],

