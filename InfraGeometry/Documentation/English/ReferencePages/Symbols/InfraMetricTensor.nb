Cell[TextData[{
 "The entry is the foot of ",
 StyleBox["v", "TI"],
 " on the interval to ",
 StyleBox["w", "TI"],
 ", read off the explicit construction: the interval, the feet of ",
 StyleBox["v", "TI"],
 " on it, and the three points."
}], "ExampleText",ExpressionUUID->"d44861fe-e99a-4ccb-a742-7885697fb551"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"w", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "p", ",", " ", "5"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "12", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "p", ",", " ", "4"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"interval", " ", "=", " ", 
     RowBox[{"MetricInterval", "[", 
      RowBox[{"g", ",", " ", "p", ",", " ", "w"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"feet", " ", "=", " ", 
     RowBox[{"FindClosestInfraPoint", "[", 
      RowBox[{"g", ",", " ", "interval", ",", " ", "v", ",", " ", "All"}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "interval", ",", " ", "p", ",", " ", "v", ",", " ", "w", ",", " ", 
         "feet"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Min", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "p", ",", " ", "#"}], "]"}], " ", "&"}], " ",
         "/@", " ", "feet"}], "]"}], "/", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", "p", ",", " ", "v"}], "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"InfraMetricTensor", "[", 
       RowBox[{"g", ",", " ", "p"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"VertexIndex", "[", 
         RowBox[{"g", ",", " ", "v"}], "]"}], ",", " ", 
        RowBox[{"VertexIndex", "[", 
         RowBox[{"g", ",", " ", "w"}], "]"}]}], "]"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5a469b51-ba33-439d-91cb-43435f3837ae"],

