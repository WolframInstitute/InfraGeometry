Cell[TextData[{
 "The comparison cosine of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScalarProduct"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScalarProduct", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "eaddb77a-f0ca-4edd-af4d-07f660f7b134"],
 " reads \[Minus]1 for two orthogonal neighbours of the centre, the same as \
for two opposite ones. The tensor reads 0 for both, which is right for the \
orthogonal pair."
}], "ExampleText",ExpressionUUID->"a44c07e4-b405-49c9-8e82-31f7584d76e9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "2", ",", " ", "6", ",", " ", "11"}], "}"}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraScalarProduct", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "2", ",", " ", "6"}], "]"}], ",",
        " ", 
       RowBox[{"InfraScalarProduct", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "2", ",", " ", "11"}], "]"}]}], 
      "}"}], ",", "\n", "   ", 
