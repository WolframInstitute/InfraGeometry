Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"7", ",", " ", "7"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"shell", " ", "=", " ", 
     RowBox[{"FindInfraShell", "[", 
      RowBox[{"g", ",", " ", "25", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{
    RowBox[{"InfraMetricTensor", "[", 
     RowBox[{"g", ",", " ", "25", ",", " ", "2"}], "]"}], " ", "==", " ", 
    RowBox[{
     RowBox[{"InfraMetricTensor", "[", 
      RowBox[{"g", ",", " ", "25"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"shell", ",", " ", "shell"}], "]"}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[3]:= ",ExpressionUUID->"a3197b38-9cc9-4720-8774-04bf13b8bb33"],

