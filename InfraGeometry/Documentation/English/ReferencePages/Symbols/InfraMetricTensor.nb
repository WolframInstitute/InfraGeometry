     StyleBox["f", "TI"],
     " applied to that list"
    }], "TableText",ExpressionUUID->"50667e26-7ea8-471d-9e2e-ab0698a4e885"]}
  }]], "2ColumnTableMod",ExpressionUUID->"7d4bc592-256e-4307-b758-\
f789284db603"],

Cell["\<\
The graph is assumed connected. The whole distance matrix is computed once \
and serves every row.\
\>", "Notes",ExpressionUUID->"6e86871c-97a7-4fdd-a76d-065ff40e51f7"]
}, Open  ]],

