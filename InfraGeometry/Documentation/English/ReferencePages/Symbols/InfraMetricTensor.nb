Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"shellIndices", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"VertexIndex", "[", 
        RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"FindInfraShell", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MatrixPlot", "[", 
      RowBox[{"InfraMetricTensor", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}], "]"}], ",", "\n", 
     "   ", 
