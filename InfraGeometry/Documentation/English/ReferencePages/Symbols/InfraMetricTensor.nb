Cell[TextData[{
 "The entry is the foot of ",
 StyleBox["v", "TI"],
 " on the interval to ",
 StyleBox["w", "TI"],
 ". The interval, the feet of ",
 StyleBox["v", "TI"],
 " on it, and the entry computed from them:"
}], "ExampleText",ExpressionUUID->"ac35aca0-5c4c-4680-b1da-3fe08bc9326b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"w", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"p", ",", " ", "5"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"p", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"interval", " ", "=", " ", 
     RowBox[{"MetricInterval", "[", 
      RowBox[{"g", ",", " ", "p", ",", " ", "w"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"feet", " ", "=", " ", 
     RowBox[{"FindClosestInfraPoint", "[", 
      RowBox[{"g", ",", " ", "interval", ",", " ", "v", ",", " ", "All"}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"entry", " ", "=", " ", 
     RowBox[{
      RowBox[{"InfraMetricTensor", "[", 
       RowBox[{"g", ",", " ", "p"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"VertexIndex", "[", 
         RowBox[{"g", ",", " ", "v"}], "]"}], ",", " ", 
        RowBox[{"VertexIndex", "[", 
         RowBox[{"g", ",", " ", "w"}], "]"}]}], "]"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "interval", ",", " ", "feet", ",", " ", "v", ",", " ", "w", ",", " ", 
       "p"}], "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "p", ",", " ", "#"}], "]"}], " ", "&"}], 
           " ", "/@", " ", "feet"}], "]"}], "/", "4"}], ",", " ", "entry"}], 
       "}"}]}], ",", "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2b9f8eb0-4a91-43c2-bef4-cdacf5248a72"],

