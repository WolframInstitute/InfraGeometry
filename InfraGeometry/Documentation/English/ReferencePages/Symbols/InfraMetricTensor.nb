   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"InfraScalarProduct", "[", 
        RowBox[{"g", ",", " ", "45", ",", " ", "55", ",", " ", "v"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"v", ",", " ", 
         RowBox[{"{", 
          RowBox[{"46", ",", " ", "35"}], "}"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"MatrixForm", " ", "@", " ", 
      RowBox[{"InfraMetricTensor", "[", 
       RowBox[{"g", ",", " ", "45", ",", " ", "1"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
