Cell["\<\
On the triangular tiling the ties are the rule rather than the exception. The \
entries of a shell where the smallest and the largest foot differ, drawn as a \
matrix, and their fraction.\
\>", "ExampleText",ExpressionUUID->"cf2ccba2-9d66-4e2d-afb9-492533ae08be"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"gap", " ", "=", " ", 
     RowBox[{
      RowBox[{"InfraMetricTensor", "[", 
       RowBox[{"g", ",", " ", "p", ",", " ", "4", ",", " ", 
        RowBox[{"\"\<SelectCoordinate\>\"", " ", "->", " ", "Max"}]}], "]"}], 
      " ", "-", " ", 
      RowBox[{"InfraMetricTensor", "[", 
       RowBox[{"g", ",", " ", "p", ",", " ", "4"}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MatrixPlot", "[", "gap", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"N", " ", "@", " ", 
       RowBox[{"Count", "[", 
        RowBox[{
         RowBox[{"Flatten", " ", "@", " ", "gap"}], ",", " ", 
         RowBox[{"_", "?", "Positive"}]}], "]"}]}], "/", 
      RowBox[{"Length", "[", 
       RowBox[{"Flatten", " ", "@", " ", "gap"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1e7c645b-77d1-48a4-995d-33f92fad0852"],

