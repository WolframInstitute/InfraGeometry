    }], "TableText",ExpressionUUID->"a61c6141-a07e-4ad8-ad8a-a29f3f9f2535"]}
  }]], "2ColumnTableMod",ExpressionUUID->"b6ffe87f-acac-49da-8a50-\
89419a7ecb25"],

Cell["\<\
The graph is assumed connected. The whole distance matrix is computed once \
and serves every row.\
\>", "Notes",ExpressionUUID->"20669738-d5e6-4a89-8971-7eea669656b7"]
}, Open  ]],

