Cell[TextData[{
 "The tensor on a shell of radius 8 against the cosine of the angle between \
the two directions, on the discretized plane, the square tiling and the \
hexagonal tiling. The gray curve is the plane's value ",
 StyleBox["max(0, cos \[Theta])", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"739feef0-91a1-46ee-b152-7ad7051ceb2d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Large\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"shell", " ", "=", " ", 
        RowBox[{"FindInfraShell", "[", 
         RowBox[{"g", ",", " ", "p", ",", " ", "8"}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"dirs", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Normalize", "[", 
           RowBox[{
            RowBox[{"AnnotationValue", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"g", ",", " ", "#"}], "}"}], ",", " ", 
              "VertexCoordinates"}], "]"}], " ", "-", " ", 
            RowBox[{"AnnotationValue", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"g", ",", " ", "p"}], "}"}], ",", " ", 
              "VertexCoordinates"}], "]"}]}], "]"}], " ", "&"}], " ", "/@", 
         " ", "shell"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Show", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{"dirs", " ", ".", " ", 
               RowBox[{"Transpose", "[", "dirs", "]"}]}], "]"}], ",", " ", 
             RowBox[{"Flatten", " ", "@", " ", 
              RowBox[{"InfraMetricTensor", "[", 
               RowBox[{"g", ",", " ", "p", ",", " ", "8"}], "]"}]}]}], "}"}], 
           "]"}], ",", "\n", "        ", 
          RowBox[{"PlotRange", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}], ",", " ", 
          RowBox[{"PlotLabel", " ", "->", " ", "name"}]}], "]"}], ",", "\n", 
        "      ", 
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"0", ",", " ", "x"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", 
            RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"PlotStyle", " ", "->", " ", "Gray"}]}], "]"}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"95bd4d9e-0bf5-4313-a7d3-e1072c7af5d5"],

