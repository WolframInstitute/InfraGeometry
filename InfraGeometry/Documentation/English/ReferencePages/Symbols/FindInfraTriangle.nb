     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "74b2ac4d-c45b-4001-8662-9a71c795111d"],
     " (default), ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "d16e2020-b82c-453b-bd77-f379b86044c0"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
        RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b684a5aa-634f-49ff-b473-d35da7967f42"],
     ", ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7a7c0018-2763-41cb-b7bd-6e8e799f1b6b"],
     ", ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4104358a-01c8-4514-998e-d8ebc16dfd23"]
    }], "TableText",ExpressionUUID->"8f6b6832-02fe-4edd-bd17-290790db5c42"], 
    Cell[TextData[{
     "forwarded to the side geodesics. ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "94eeef83-fcba-4039-94d9-d68bc7ddf5a9"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0dda8368-f67e-4cab-9b24-263717e4204e"],
     " to ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4da46a5f-c0ad-4d3f-9839-3e2f98e4fe53"],
     ", a bounded or absent count to ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "913f2813-8ba3-44d6-bf02-855f5589d3bc"],
     ". The class is the same under every value; ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0cc20ba2-d2af-4ba5-aab0-5ba075042a4f"],
     " and ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f955e6bc-dc5e-43c5-b5a0-a9e68f4adfdf"],
     " take each side's geodesics in candidate order, ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5a3319c9-b2be-4637-ae23-585df6ffa948"],
     " in random order, seeded by an ambient ",
     Cell[BoxData["SeedRandom"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "53b74ec7-f8b4-4f19-9b5f-0210db1cddc6"],
     ". ",
     Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ea2ba745-debe-44f2-bc50-52a9d8e439a6"],
     " is accepted and inert: the sides come off geodesic pools, which have \
no frontier to cap."
    }], "TableText",ExpressionUUID->"0e4190ad-a54b-4b63-b658-515b0a2b3f64"]}
  }]], "3ColumnTableMod",ExpressionUUID->"7ad0c3e2-0d3c-4c9e-a48b-\
