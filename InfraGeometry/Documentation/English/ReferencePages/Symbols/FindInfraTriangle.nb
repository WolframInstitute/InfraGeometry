Cell["The perimeter is the sum of the three corner distances.", "ExampleText",ExpressionUUID->"7b088bc5-b6f1-4342-b858-68429b6c54e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "4"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"d", " ", "=", " ", 
     RowBox[{"Last", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
            " ", "4"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "b", ",", " ", "#"}], "]"}], " ", "==", 
            " ", "4"}]}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"EdgeCount", " ", "/@", " ", 
      RowBox[{"FindInfraTriangle", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "b", ",", " ", "d"}], "}"}]}], "]"}]}], "]"}],
     " ", "===", " ", 
    RowBox[{
     RowBox[{"GraphDistance", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "b"}], "]"}], " ", "+", " ", 
     RowBox[{"GraphDistance", "[", 
      RowBox[{"g", ",", " ", "b", ",", " ", "d"}], "]"}], " ", "+", " ", 
     RowBox[{"GraphDistance", "[", 
      RowBox[{"g", ",", " ", "d", ",", " ", "c"}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"30ce229d-feec-4600-99a3-924f5ab17ec5"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"fc6ff4e6-87b6-42eb-bdcc-716fee2ba234"]
}, Open  ]]
}, Open  ]],

