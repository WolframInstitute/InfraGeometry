Cell[TextData[{
 "The class is the same under every ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f469fa14-2ca5-4470-81d5-2fb00c9ac131"],
 "; only the order in which triangles come off it differs, and ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c0a92df-b327-45a2-b837-3606ed87c2d6"],
 " draws the witness in random order, so the seed goes in front."
}], "ExampleText",ExpressionUUID->"161fc261-260b-45d4-b953-956a0da3ec2f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
  RowBox[{"With", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", " ", "=", " ", 
      RowBox[{"GridGraph", "[", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
    
    RowBox[{"{", 
     RowBox[{
      RowBox[{"SameQ", " ", "@@", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Sort", " ", "@", " ", 
           RowBox[{"FindInfraTriangle", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "3", ",", " ", "9"}], "}"}], ",", " ", 
             "All", ",", " ", 
             RowBox[{"Method", " ", "->", " ", "#"}]}], "]"}]}], " ", "&"}], 
         " ", "/@", "\n", "      ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Exhaustive\>\"", ",", " ", "\"\<Greedy\>\"", ",", 
           " ", "\"\<RandomGreedy\>\""}], "}"}]}], ")"}]}], ",", "\n", "   ", 
      
      RowBox[{"FindInfraTriangle", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3", ",", " ", "9"}], "}"}], ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<RandomGreedy\>\""}]}], "]"}]}],
      "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"30cac1c0-684b-4754-b88c-6e8ccc7eaadd"],

