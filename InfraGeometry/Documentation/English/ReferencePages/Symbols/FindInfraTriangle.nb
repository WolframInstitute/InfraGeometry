Cell[CellGroupData[{
Cell["FindInfraTriangle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"79a579ad-8b3b-430c-9e9e-0c6cb837eb24"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraTriangle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraTriangle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"], ",", " ", 
      StyleBox["c", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ba0aa7b-4eb2-4d8c-806b-5b2dadf4f850"],
 "\[LineSeparator]",
 "gives one triangle with corners ",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["b", "TI"],
 ", ",
 StyleBox["c", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " \[LongDash] a geodesic on each side \[LongDash] as the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bba7492a-78a6-4724-9c0e-f22e71db59eb"],
 " of its three sides, one directed path graph each.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f09c7444-2f25-41d0-a7e8-81e09a7051a3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraTriangle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraTriangle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"], ",", " ", 
      StyleBox["c", "TI"]}], "}"}], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b491e580-9f77-4c9d-afea-d9332f5d1252"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5525fc2e-0cfe-4e71-bd95-cb9396abe672"],
 " of exactly ",
 StyleBox["n", "TI"],
 " triangles or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eab5a4f0-7733-4173-acf7-91f5ac9d4a70"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "743906ec-b649-4bf1-8574-c0904adc1a54"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bad11b0d-a59e-4274-9cfb-e07d772f07c1"],
 " gives the whole class."
}], "Usage",ExpressionUUID->"83a934ab-5d3f-4f5e-bd3f-b109fd4db155"],

Cell[TextData[{
 "A triangle with corners ",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["b", "TI"],
 ", ",
 StyleBox["c", "TI"],
 " is three geodesics, ",
 StyleBox["a \[Ellipsis] b", "TI"],
 ", ",
 StyleBox["b \[Ellipsis] c", "TI"],
 " and ",
 StyleBox["c \[Ellipsis] a", "TI"],
 ". It is the three-corner case of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPolygon"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPolygon", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7dee0a66-2750-49eb-8548-683f9cd4447d"],
 " and shares its engine, options and defaults: corners are vertices, each \
triangle is the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd46d51c-d5f6-414d-a227-79ea114bd802"],
 " of its three sides, one directed path graph each, and its perimeter is the \
total edge count of the sides."
}], "Notes",ExpressionUUID->"82f4e8bb-1784-40a4-9fbf-007bb4ccbb95"],

Cell["\<\
The class is the product of the three geodesic classes, so the count \
multiplies. Below, the triangle on the centre of each substrate and two \
vertices at distance 4 from it and from each other has 18 members on the \
irregular mesh, 36 on the square tiling and 8 on the hexagonal \[LongDash] \
all of perimeter 12.\
\>", "Notes",ExpressionUUID->"d2e15b9a-378d-4779-ba2d-dec3607a77c0"],

Cell["\<\
Nothing in the definition keeps the sides apart. On the 3\[Times]3 grid with \
corners 1, 3, 9 the side from 9 to 1 may retrace the two others, and the \
class admits it, since each side is a geodesic on its own.\
\>", "Notes",ExpressionUUID->"ed1a9108-b38a-49b0-831e-d50e35589ecc"],

Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52e502b0-1d56-435c-bb8e-92ab6a75c8ff"],
 " forms the product. A bounded count never does: it streams that many \
geodesics per side and reads the first members of their product, so the \
count-less call \[LongDash] one triangle, the first geodesic of every side \
\[LongDash] is cheap and deterministic, and a strict count is exact."
}], "Notes",ExpressionUUID->"b24a1efa-826c-4196-a3a7-4d5d362dec78"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d2552a35-b43f-4f99-bfdb-ee88fcc68193"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"3f9b19ea-24c4-4110-a9e6-0c7b8dfea69c"],
