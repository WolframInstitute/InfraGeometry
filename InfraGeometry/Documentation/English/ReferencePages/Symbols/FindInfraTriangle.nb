Cell[CellGroupData[{
Cell["FindInfraTriangle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a29e267e-a69f-401b-b4e1-908f7c9a00fe"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraTriangle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraTriangle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"], ",", " ", 
      StyleBox["c", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe6f1ae8-1fd9-44db-a04f-dabbb4cc527d"],
 "\[LineSeparator]",
 "gives one triangle with corners ",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["b", "TI"],
 ", ",
 StyleBox["c", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " \[LongDash] a geodesic on each side \[LongDash] as the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47c52cc7-e14f-4ed4-addd-085cbc9ef2ce"],
 " of its three sides, one directed path graph each.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"9d4e5d4e-be7d-4d23-964d-6c50be0fb13b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraTriangle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraTriangle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"], ",", " ", 
      StyleBox["c", "TI"]}], "}"}], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05c91d74-cdb9-4168-af3d-e5b407f41091"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7df0d8f4-c6b0-4213-b756-9b4a216086c3"],
 " of exactly ",
 StyleBox["n", "TI"],
 " triangles or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ebaebce-b1ca-417a-9a6c-1b450a3db7a7"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ae13794-2870-4033-a212-db12c14bf3f4"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4686de51-7c83-491a-9e7c-8b74d1707320"],
 " gives the whole class."
}], "Usage",ExpressionUUID->"cccdf08e-92c1-4b3a-867b-9a2f6638b08e"],

Cell[TextData[{
 "A triangle with corners ",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["b", "TI"],
 ", ",
 StyleBox["c", "TI"],
 " is three geodesics, ",
 StyleBox["a \[Ellipsis] b", "TI"],
 ", ",
 StyleBox["b \[Ellipsis] c", "TI"],
 " and ",
 StyleBox["c \[Ellipsis] a", "TI"],
 ". It is the three-corner case of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPolygon"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPolygon", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "73c5d5ae-f813-4e1b-bf3f-a1a904955ca9"],
 " and shares its engine, options and defaults: corners are vertices, each \
triangle is the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b79a733-7898-44ac-bed9-17b9ffe574f8"],
 " of its three sides, one directed path graph each, and its perimeter is the \
total edge count of the sides."
}], "Notes",ExpressionUUID->"3a42faea-e400-47ef-8605-338f7b1710d1"],

Cell["\<\
The class is the product of the three geodesic classes, so the count \
multiplies. Below, the triangle on the centre of each substrate and two \
vertices at distance 4 from it and from each other has 18 members on the \
irregular mesh, 36 on the square tiling and 8 on the hexagonal \[LongDash] \
all of perimeter 12.\
\>", "Notes",ExpressionUUID->"36177339-ebe3-4bb4-925a-3977b0d6aecf"],

Cell["\<\
Nothing in the definition keeps the sides apart. On the 3\[Times]3 grid with \
corners 1, 3, 9 the side from 9 to 1 may retrace the two others, and the \
class admits it, since each side is a geodesic on its own.\
\>", "Notes",ExpressionUUID->"f65a1634-d375-48e8-a68e-b78e9f4bb2b6"],

Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0c7c7d2-6053-4707-9389-47897be9c2c5"],
 " forms the product. A bounded count never does: it streams that many \
geodesics per side and reads the first members of their product, so the \
count-less call \[LongDash] one triangle, the first geodesic of every side \
\[LongDash] is cheap and deterministic, and a strict count is exact."
}], "Notes",ExpressionUUID->"db8ca419-1a2d-438f-8964-cb357f362c7e"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "55c5404c-9acd-4fe3-bd93-3b81e9026f11"], Cell["Option", "TableText",
