Cell[TextData[{
 "On the 3\[Times]3 grid the corners 1, 3, 9 carry six triangles. The \
count-less call is one of them \[LongDash] its third side retraces the other \
two \[LongDash] and a strict count of seven is ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc6c3aea-178b-4b5b-aeb0-8c36dffc0724"],
 "."
}], "ExampleText",ExpressionUUID->"08f5b836-4ab1-434a-9df1-d9c81be22f85"],

