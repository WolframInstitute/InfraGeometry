Cell[TextData[{
 "The class is the same under every ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dcde6e2-9a1e-42aa-a18e-0ca7f051e9cb"],
 "; only the order in which triangles come off it differs, and ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa096bf0-9a02-4c8b-9971-9b5a47ea05e2"],
 " draws the witness in random order, so the seed goes in front."
}], "ExampleText",ExpressionUUID->"dfefb057-fb85-4f43-9ba3-2ce160f85806"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
  RowBox[{"With", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", " ", "=", " ", 
      RowBox[{"GridGraph", "[", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
    
    RowBox[{"{", 
     RowBox[{
      RowBox[{"SameQ", " ", "@@", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Sort", " ", "@", " ", 
           RowBox[{"FindInfraTriangle", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "3", ",", " ", "9"}], "}"}], ",", " ", 
             "All", ",", " ", 
             RowBox[{"Method", " ", "->", " ", "#"}]}], "]"}]}], " ", "&"}], 
         " ", "/@", "\n", "      ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Exhaustive\>\"", ",", " ", "\"\<Greedy\>\"", ",", 
           " ", "\"\<RandomGreedy\>\""}], "}"}]}], ")"}]}], ",", "\n", "   ", 
      
      RowBox[{"FindInfraTriangle", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3", ",", " ", "9"}], "}"}], ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<RandomGreedy\>\""}]}], "]"}]}],
      "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fa4c75db-087a-421f-be95-c5cf7b6f9b11"],

