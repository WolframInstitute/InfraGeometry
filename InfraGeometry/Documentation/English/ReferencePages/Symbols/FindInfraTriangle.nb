   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b3e31df4-9437-478d-8e7c-bb6068162e37"],
 ", and the class is the polygon class on the same three corners."
}], "ExampleText",ExpressionUUID->"f2f9d885-7758-4150-978c-fb93219a5ab2"],

