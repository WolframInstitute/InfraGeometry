    "Method"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "df6855a5-fa14-405a-98fe-5b91759d45ed"]], "TableText",ExpressionUUID->
     "90b9652e-97e0-4e9e-9c09-2065acef3e7c"], Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "86023870-ffb2-4d02-9a75-ac4596633492"],
     " (default), ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "fbe213e6-7d21-48f5-b6f6-75f5caf803c7"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
        RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ceada4ac-8ad0-4df3-b0c6-918d19e461a6"],
     ", ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "198e5077-1293-4986-a40c-26770f26f729"],
     ", ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2ebc4762-1129-41e9-9408-faa0b340fcb7"]
    }], "TableText",ExpressionUUID->"dd8a338e-b790-4b6a-b1f5-51a6ed5a9e24"], 
    Cell[TextData[{
     "forwarded to the side geodesics. ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4f0e081f-5812-4d3d-ba33-6d4a9484aff2"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "23627dea-9830-45e7-a13c-cc64c29df816"],
     " to ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "721f1ad0-5969-4c12-87db-56b1c3a7c898"],
     ", a bounded or absent count to ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9da9f79b-4e12-45a0-8cde-9736548b253c"],
     ". The class is the same under every value; ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "71bb3492-0327-4923-bfaa-4680cfce039a"],
     " and ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e456c9f9-40a9-4a9e-9d8c-a4f4a0771cc1"],
     " take each side's geodesics in candidate order, ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "dd4d4768-00ee-4b65-b63f-375203e2d12a"],
     " in random order, seeded by an ambient ",
     Cell[BoxData["SeedRandom"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "caa40573-8374-4891-9272-b134d1484fae"],
     ". ",
     Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b06fdbae-f36a-4084-8469-c35738182b44"],
     " is accepted and inert: the sides come off geodesic pools, which have \
no frontier to cap."
    }], "TableText",ExpressionUUID->"99e905f5-4574-47dc-9b5d-1d0679c72b81"]}
  }]], "3ColumnTableMod",ExpressionUUID->"7a5843d5-fc12-4a5e-a4ec-\
d5d08a73247c"],

