Cell["\<\
On the square tiling, with the graph metric, the ladder does not stop at \
order 3. The vertices within distance 3 of the centre at radius 1: the four \
corners of each of the twelve squares drawn are a simplex of order 3 and not \
of order 4.\
\>", "ExampleText",ExpressionUUID->"78539879-e6fd-4727-8699-83e4e2b31372"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"data", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{
         RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "3"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"bifiltration", " ", "=", " ", 
     RowBox[{"BallIntersectionBifiltration", "[", 
      RowBox[{"data", ",", " ", 
       RowBox[{"{", "1", "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}], ",", " ", 
       RowBox[{"\"\<MaxDimension\>\"", " ", "->", " ", "3"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"gap", " ", "=", " ", 
     RowBox[{"Complement", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"bifiltration", "[", "3", "]"}], "[", "1", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"bifiltration", "[", "4", "]"}], "[", "1", "]"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"data", "[", 
           RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         "gap"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Length", "[", "gap", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"093149d0-e6d7-4521-b27d-79be72702ea0"],

