  FontSize->0.9 Inherited,ExpressionUUID->
  "75bf933a-d87f-4ef3-abc1-67e75b5bebdc"],
 "."
}], "Notes",ExpressionUUID->"552b6a20-2a03-4a3d-b04b-6443ce23c900"]
}, Open  ]],

