Cell[TextData[{
 "The number of simplices of sixteen random points in the plane against the \
radius, at orders 2, 3 and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "80751305-0ccd-43cf-8ca0-e2081a304508"],
 ". Orders 3 and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bb53192f-695b-4fc0-85aa-b0f9c748efb6"],
 " coincide, as Helly's theorem says."
}], "ExampleText",ExpressionUUID->"4d1a2e2f-a2fb-47e5-ab00-9877ace92613"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"16", ",", " ", "2"}], "}"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"bifiltration", " ", "=", " ", 
     RowBox[{"BallIntersectionBifiltration", "[", 
      RowBox[{"points", ",", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0.02", ",", " ", "0.3", ",", " ", "0.02"}], "]"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3", ",", " ", "Infinity"}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"ListLinePlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"KeyValueMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#1", ",", " ", 
            RowBox[{"Length", "[", "#2", "]"}]}], "}"}], " ", "&"}], ",", " ", 
         RowBox[{"bifiltration", "[", "k", "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3", ",", " ", "Infinity"}], "}"}]}], 
        "}"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3", ",", " ", "Infinity"}], "}"}]}], ",", "\n",
      "    ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<r\>\"", ",", " ", "\"\<simplices\>\""}], "}"}]}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e51721a6-d864-44c8-af0b-f8f09b44123f"],

