Cell["\<\
For each radius the complexes shrink as the order grows; in the plane they \
stop shrinking at order 3.\
\>", "ExampleText",ExpressionUUID->"957e8d29-f721-4657-b1f9-58ebd83135de"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"16", ",", " ", "2"}], "}"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"radii", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0.02", ",", " ", "0.3", ",", " ", "0.02"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"bifiltration", " ", "=", " ", 
     RowBox[{"BallIntersectionBifiltration", "[", 
      RowBox[{"points", ",", " ", "radii", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"KeyValueMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#1", ",", " ", 
              RowBox[{"Length", "[", "#2", "]"}]}], "}"}], " ", "&"}], ",", 
           " ", 
           RowBox[{"bifiltration", "[", "k", "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], "}"}]}], 
        "]"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<r\>\"", ",", " ", "\"\<simplices\>\""}], "}"}]}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"radii", ",", " ", 
       RowBox[{"r", " ", "|->", " ", 
        RowBox[{
         RowBox[{"SubsetQ", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"bifiltration", "[", "2", "]"}], "[", "r", "]"}], ",", 
           " ", 
           RowBox[{
            RowBox[{"bifiltration", "[", "3", "]"}], "[", "r", "]"}]}], "]"}],
          " ", "&&", " ", 
         RowBox[{"SubsetQ", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"bifiltration", "[", "3", "]"}], "[", "r", "]"}], ",", 
           " ", 
           RowBox[{
            RowBox[{"bifiltration", "[", "4", "]"}], "[", "r", "]"}]}], 
          "]"}]}]}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7ab8a7b1-b1c1-4c57-8c31-ed37fe6cb4ac"],

