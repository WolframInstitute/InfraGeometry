Cell["\<\
On the square tiling, with the graph metric, the ladder does not stop at \
order 3. The vertices within distance 3 of the centre at radius 1: the four \
corners of each of the twelve squares drawn are a simplex of order 3 and not \
of order 4.\
\>", "ExampleText",ExpressionUUID->"1e6ea607-7321-441a-8043-eb4a79ec6f52"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"data", " ", "=", " ", 
     RowBox[{"RandomInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "3"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"bifiltration", " ", "=", " ", 
     RowBox[{"BallIntersectionBifiltration", "[", 
      RowBox[{"data", ",", " ", 
       RowBox[{"{", "1", "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}], ",", " ", 
       RowBox[{"\"\<MaxDimension\>\"", " ", "->", " ", "3"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"gap", " ", "=", " ", 
     RowBox[{"Complement", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"bifiltration", "[", "3", "]"}], "[", "1", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"bifiltration", "[", "4", "]"}], "[", "1", "]"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"data", "[", 
           RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         "gap"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Length", "[", "gap", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f369804e-0937-49e9-9dbf-ff87df3d1452"],

