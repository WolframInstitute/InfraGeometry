Cell[CellGroupData[{
Cell["BallIntersectionBifiltration", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9d0c189f-4a4a-467a-99a7-23c27d15573f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionBifiltration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionBifiltration",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["radii", "TI"], ",", " ", 
    StyleBox["orders", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bcaa2e2-0da5-4fe0-af14-25c3f4e76190"],
 "\[LineSeparator]",
 "gives an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b91ac74a-e71c-450c-b676-c9f7a2fb93a9"],
 " from each order ",
 StyleBox["k", "TI"],
 " of ",
 StyleBox["orders", "TI"],
 " to the filtration ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionFiltration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionFiltration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["radii", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d361903c-2160-44e6-8ca7-3373ca81088f"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"4abf8eca-b672-48f6-ad6c-198a937fd916"],

Cell[TextData[{
 "Definition: the complexes ",
 StyleBox["C^(k)_r", "TI"],
 " grow with the radius ",
 StyleBox["r", "TI"],
 " and shrink with the order ",
 StyleBox["k", "TI"],
 ". Over a grid of radii and orders they form a filtration in two parameters: \
the result is ",
 StyleBox["bif[k][r] = C^(k)_r", "TI"],
 "."
}], "Notes",ExpressionUUID->"590b34f2-8092-430e-9f23-d33bb1491530"],

Cell[TextData[{
 "For a fixed radius the orders run from the Vietoris\[Dash]Rips complex at \
",
 StyleBox["k = 2", "TI"],
 " down to the \[CapitalCHacek]ech complex. In ",
 StyleBox["\:211d^d", "TI"],
 " the balls are convex and by Helly's theorem the ladder stops at ",
 StyleBox["k = d + 1", "TI"],
 ". On a graph the balls need not be convex, and the ladder can go on."
}], "Notes",ExpressionUUID->"84b8db8a-12f0-41b2-87a5-9c801a341c09"],

