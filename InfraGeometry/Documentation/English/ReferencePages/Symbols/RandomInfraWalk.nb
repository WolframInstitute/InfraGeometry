Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraWalk", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d5be381e-35ea-4f1e-b26a-879571bfc3b5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "301baf71-0ad7-4e25-ab09-8416fa99edc6"],
 "\[LineSeparator]",
 "gives one walk grown from ",
 StyleBox["germ", "TI"],
 " one step at a time under the rules of ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "980c13a9-d07f-4234-82af-2f4d0d5718e0"],
 ", until a stopping condition fires or the budget ",
 StyleBox["kspec", "TI"],
 " is spent.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5093828c-9cb0-412c-9cc1-4f0552d3c96b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3ade24d-22c6-43a2-a744-9753e9aa234d"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1675e43a-8650-45e2-8f30-9baf1d4d38e5"],
 " of exactly ",
 StyleBox["n", "TI"],
 " walks or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e433a3b5-cd2a-4fd2-8a92-7cb03458d52e"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01030ede-7277-4e29-8b49-e7f90bf63621"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a63a10f-ce2f-4801-99f9-4f3e0faef8c0"],
 " gives every one."
}], "Usage",ExpressionUUID->"6f0c38ce-60d9-443a-9427-93dd035c3686"],

Cell[TextData[{
 "The default draw is random. Give ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b082c87d-5924-4239-8850-3172a21c29e5"],
 " for deterministic descent. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e2f0453-685d-4f37-adcd-eaca23fccd80"],
 " with ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f82de26-7ca2-4603-8b63-6518311d8b2f"],
 " keeps the full enumeration without drawing. ",
 Cell[BoxData[
  RowBox[{"RandomSeeding", " ", "->", " ", "Automatic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6185fe99-8fcb-4dcb-84f8-f78d3c67308f"],
 " (default) seeds each call afresh, independently of ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43d2b657-d2cc-49b0-bcab-6becabe39366"],
 "; an integer or string gives a reproducible draw, and ",
 Cell[BoxData["Inherited"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c961f308-9664-4839-a68d-4bf657bbc56f"],
 " a local snapshot of the current state. The outer random state is restored \
afterward, as with ",
 ButtonBox["RandomInstance",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/RandomInstance.html"], 
    None}],
 "."
}], "Notes",ExpressionUUID->"eb44f579-5b67-47bd-b0fe-23b646c6eebe"],

Cell[TextData[{
 "The germ is the seed of the walk: a vertex, a vertex list, a walk graph, or \
a list of germs. A vertex is the one-vertex germ, so ",
 Cell[BoxData[
  RowBox[{"RandomInfraWalk", "[", 
   RowBox[{"g", ",", " ", "p", ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ef5f35f-3da9-4dfc-97d1-b6dda822e69f"],
 " and ",
 Cell[BoxData[
  RowBox[{"RandomInfraWalk", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"{", "p", "}"}], ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a74b7c84-c469-4761-8737-4f3651fbbc81"],
 " are the same call. A germ is read as a vertex first, so on a substrate \
labelled by lists the vertex ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "1"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "131e81c8-3b83-40a7-b959-2724f7afbf94"],
 " is one point, not the walk of its entries. A walk graph is read as its \
vertex sequence; a list of germs gives the walks grown from each."
}], "Notes",ExpressionUUID->"9c003c86-b5ab-4c69-966c-d6e55a8e01cf"],

Cell[TextData[{
 StyleBox["kspec", "TI"],
 " is the budget in edges added on each growing side: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd008cc8-9b2d-4767-84ea-0015d5a1898d"],
 " (at most ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4ade491-0979-4839-82db-6b86300ee76b"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7ca635d-01be-4e38-a300-0312a2aabcc0"],
 ", or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3371ecbd-6660-428b-af80-b4506479cde0"],
 ". A bare integer is no ",
 StyleBox["kspec", "TI"],
 ". ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "821988a1-c4f3-4b9d-9bad-2ddf068b1b20"],
 " is legal only under a hard rule that bounds the class: a bare ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e352aed-c62c-45ce-8d16-74b00da868a5"],
 " or a bare ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cfd4c0a-f76e-4ae2-8215-7547c636ee99"],
 "."
}], "Notes",ExpressionUUID->"d72eec58-0250-4d96-8764-8c0d383604b0"],

Cell[TextData[{
 "A walk is a graph: a directed path graph on the pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "v"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2696424a-fde2-469a-9f90-c8614e1abc2e"],
 ", the position and the vertex. ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0324a7d6-e6f3-4a56-b669-11b9b3d02bde"],
 " is its vertex sequence. The count-less call returns one walk graph, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5a1c585-0da4-477d-9d9c-db4956b857db"],
 " when there is none."
}], "Notes",ExpressionUUID->"3260fa38-1ba2-465c-92c3-d37e28acec94"],

Cell[TextData[{
 "A step reads a ",
 StyleBox["window",
  FontWeight->"Bold"],
 ": the last ",
 StyleBox["r", "TI"],
 " vertices of the growing side with the candidate appended, ",
 StyleBox["r", "TI"],
 " + 1 vertices and ",
 StyleBox["r", "TI"],
 " edges; ",
 StyleBox["r", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07b6c2bb-2130-4f85-830e-0655ac33c728"],
 " is the whole side. A rule is an ",
 StyleBox["energy",
  FontWeight->"Bold"],
 " on the window, a non-negative number that is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "047de835-7606-4442-9041-6d6c706d2ddc"],
 " exactly when the rule holds:"
}], "Notes",ExpressionUUID->"7f226701-01f8-4255-a7f5-8d5fd99a0b07"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8848e785-2a35-4c6c-a87b-cb9152f15136"], Cell["Rule", "TableText",
     FontWeight->Bold,ExpressionUUID->"18628c42-3581-48fd-821b-e244f5341ee4"],
     Cell["Energy of the window", "TableText",
     FontWeight->Bold,ExpressionUUID->"026824a4-0657-4d70-bb03-922f4adb90e4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b0d5f174-99d7-4182-9b1c-d3559f8653fd"], Cell[TextData[Cell[
    BoxData["\"\<Simple\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7b84771a-b701-429d-9998-b503bb06d7f3"]], "TableText",ExpressionUUID->
     "e6cf701c-8deb-41ea-a213-cb1a71b833f3"], Cell[TextData[{
     "the number of earlier occurrences of the candidate; at ",
     StyleBox["r", "TI"],
     " = 2 a backtrack, a cusp"
    }], "TableText",ExpressionUUID->"9382493a-1893-457b-8539-8d8f21404215"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "81664473-4349-475a-8d19-37630ed21ec7"], Cell[TextData[Cell[
    BoxData["\"\<Shortest\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a612f782-2076-4ff8-b20e-e4ff7e24a7ef"]], "TableText",ExpressionUUID->
     "996e4403-da67-4910-9db0-c94d518c5e96"], Cell["\<\
the defect: the edges of the window minus the distance between its ends\
\>", "TableText",ExpressionUUID->"3757122a-cb46-4554-bd2c-3f252b75806f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5a2f212a-7413-4d5e-8d99-069a47489e06"], Cell[TextData[Cell[
    BoxData["\"\<Stretched\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "4b1ce640-7e01-47e7-99a4-94b49802c92c"]], "TableText",ExpressionUUID->
     "c76e31cf-854d-4adc-8248-87054b7baae9"], Cell["\<\
the defect minus the least defect among the step's candidates\
\>", "TableText",ExpressionUUID->"3428f60d-584e-4357-8f94-51a9d62de168"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e4af355b-ef49-40b3-b717-873e370d5f2d"], Cell[TextData[StyleBox[
    "f", "TI"]], "TableText",ExpressionUUID->
     "13ece5df-beb5-4520-8626-078aebf1c203"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"f", "[", "window", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "26cb52bf-2849-45c3-89d0-92aabf7ad1e1"],
     ", a non-negative number; ",
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b05cccd9-847c-43eb-9291-95ba2738260e"],
     " and ",
     Cell[BoxData["False"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "886272f4-1a6c-4a7f-ba76-2757a96ebcb8"],
     " read as ",
     Cell[BoxData["0"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "92893969-0a9b-4e90-a19e-74a8d66a255c"],
     " and ",
     Cell[BoxData["1"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "db16687f-61ab-4024-ab8f-ec1033ec43e4"],
     ", so a predicate is a rule"
    }], "TableText",ExpressionUUID->"bad431f2-5632-4e28-b074-6d9752de15bf"]}
  }]], "2ColumnTableMod",ExpressionUUID->"68f2933c-f9af-4381-91d5-\
0b4315caabb9"],

Cell[TextData[{
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "152af6b9-28b7-41a2-8879-2ce1ca204a98"],
 " is a list of rules, each written ",
 Cell[BoxData["rule"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "484beb0f-5831-441b-a854-db109b5621d6"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"rule", ",", " ", "r"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd03c17d-1ab5-45f6-beba-641089c99e00"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"rule", ",", " ", "r", ",", " ", "p"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "315265dc-7feb-445d-bda1-728d7ea4a7e2"],
 ". A bare rule has ",
 StyleBox["r", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11ac265d-f3f8-44b2-83f7-c7dde7ca77a0"],
 ", a pair has ",
 StyleBox["p", "TI"],
 " = ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "feb2eec5-fc78-49e1-b2cf-d101d66f9550"],
 ". The weight ",
 StyleBox["p", "TI"],
 " says how much a violation costs:"
}], "Notes",ExpressionUUID->"79bfcc5c-7c5e-4bdb-8196-53d174404383"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "cfce7de6-1b55-4132-9dba-ef8c1b126b29"], Cell[TextData[StyleBox[
    "p", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"b488d1c2-61c6-42b9-aa79-5a9be19e1a64"],
     Cell["Reading", "TableText",
     FontWeight->Bold,ExpressionUUID->"cd448e91-0e64-4117-b82d-a97dc8ac8ac1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e1d1ba67-758c-46d4-b2d2-5237d4ca479f"], Cell[TextData[Cell[BoxData[
    "0"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "4dc068ee-0088-4e00-93aa-0f20de0ad2e7"]], "TableText",ExpressionUUID->
     "c2dd3205-eaaa-4d73-a1ac-7f8b037329f0"], Cell[
    "hard: a candidate of positive energy is dropped", "TableText",
     ExpressionUUID->"d759870b-6fd3-497e-bdc1-e7e4970b9858"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8bc69439-15a1-44ca-9996-45ef32d6332b"], Cell[TextData[Cell[BoxData[
     RowBox[{"0", " ", "<", " ", "p", " ", "<=", " ", "1"}]], "InlineFormula",
     
     FontSize->0.9 Inherited,ExpressionUUID->
     "83bb64cc-c11d-40c3-89f9-9a861e81188f"]], "TableText",ExpressionUUID->
     "f7fc39d6-2858-4798-aa22-81f161907a95"], Cell[TextData[{
     "soft: a candidate keeps the weight ",
     StyleBox["p", "TI"],
     "^energy; ",
     StyleBox["p", "TI"],
     " = ",
     Cell[BoxData[
      RowBox[{"Exp", "[", 
       RowBox[{"-", "beta"}], "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "31ec7df4-1c4d-4fcc-a858-1e48b8926eaa"],
     " is the Boltzmann weight at inverse temperature ",
     StyleBox["beta", "TI"],
     "; at ",
     StyleBox["p", "TI"],
     " = ",
     Cell[BoxData["1"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "cd7e1366-da47-44f2-a9cc-6d38337915c5"],
     " every candidate weighs alike"
    }], "TableText",ExpressionUUID->"af9845b7-e749-418e-9f54-381cb0371c00"]}
  }]], "2ColumnTableMod",ExpressionUUID->"e4c0b2e6-8411-46e2-9b99-\
1d929f956daf"],

Cell[TextData[{
 "The hard rules cut the class; the soft rules put a distribution on it, the \
weight of a candidate being the product over the soft rules. The rules act in \
the order written, so ",
 Cell[BoxData["\"\<Stretched\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5b5ecac-7a81-4a86-b4b8-94d5f28cddb1"],
 " compares the candidates the hard rules before it left. As soft rules ",
 Cell[BoxData["\"\<Stretched\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca78acd9-3f2b-4cd5-b6fa-0a5b4fc987d1"],
 " and ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01638362-ed8d-474f-8491-27aa6741e79d"],
 " weigh alike: their energies differ by a constant on each step."
}], "Notes",ExpressionUUID->"c6d38112-0e8e-4e34-81a9-8cdb8bb0bc71"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fcd80152-55b1-4394-81cc-931104251a52"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"e63e83c8-b254-43f5-9a81-46cd344c52b2"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"780c59cb-51bb-4ece-88f3-f3d6300ed443"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"ea418072-1d1c-490b-8845-e1fbb970b6f2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9fb45cd5-73c7-4903-b813-699d8703114d"], Cell[TextData[Cell[BoxData[
    "Properties"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "4e193612-b4ba-4482-aaf7-5665666bf2ad"]], "TableText",ExpressionUUID->
     "05de4421-5afb-4ec8-a58a-cd2c1c752480"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "040e13a9-68dd-4fbd-8905-1e71ed8e7b6e"]], "TableText",ExpressionUUID->
     "82302be0-6253-4387-ba7e-72527dcb700c"], Cell[TextData[{
     "the rules; ",
     Cell[BoxData[
      RowBox[{"{", "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6b822bd5-6ae1-4afb-b45a-225c359e5244"],
     " is every walk"
    }], "TableText",ExpressionUUID->"fce78269-9f4d-41c3-8e84-365c1d0f1ff1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f8121819-c166-47b7-8620-02d87d7f6956"], Cell[TextData[Cell[
    BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "07de0ae4-5759-48d4-8514-b80e03d1f0a9"]], "TableText",ExpressionUUID->
     "ad9f3c3f-e430-4af4-b3eb-350ed6109312"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d67406d8-c4c3-4967-be86-b1ec947bd8ff"]], "TableText",ExpressionUUID->
     "a44451ff-823a-4fcb-90fe-3a2a1221eb60"], Cell[
    "the order the surviving candidates are tried in", "TableText",
     ExpressionUUID->"5cbceccc-3e1d-44b3-bbdd-3967dd902b1c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "879f84dd-ed5d-47a8-9d91-45284509c26a"], Cell[TextData[Cell[
    BoxData["\"\<Direction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "e3908a61-ca3b-463b-ba7f-fd6622e54d17"]], "TableText",ExpressionUUID->
     "bd535a37-fd16-4759-98b8-9df53570b3f9"], Cell[TextData[Cell[
    BoxData["\"\<Forward\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "578a32d8-d8d5-4e89-8bab-2ab33df127cb"]], "TableText",ExpressionUUID->
     "ae45f345-6d79-4686-95d4-820a09c44794"], Cell[TextData[{
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9bc6f618-237c-45f2-b8ac-fb869dde1d5e"],
     ", ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7444f2a3-0398-4f3f-9aae-3d00ac3e4a52"],
     " or ",
     Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8b1b6af3-869a-473a-a004-b82a71acb378"]
    }], "TableText",ExpressionUUID->"ce843643-9e0e-47be-9261-0b794835ab38"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c2e39484-ea85-4aba-b1ce-f061cedd0e70"], Cell[TextData[Cell[
    BoxData["\"\<StoppingCondition\>\""], "InlineFormula",
