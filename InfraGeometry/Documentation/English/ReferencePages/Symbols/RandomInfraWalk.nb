Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraWalk", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b766e018-8857-482e-8b21-341791b4d87b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25d851d6-e68e-44ab-8588-1dd75249acc8"],
 "\[LineSeparator]",
 "gives one walk grown from ",
 StyleBox["germ", "TI"],
 " one step at a time under the rules of ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "029ee898-bf0b-4a28-b36a-0c021c8496e4"],
 ", until a stopping condition fires or the budget ",
 StyleBox["kspec", "TI"],
 " is spent.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f724a89e-bac4-4e38-b7e4-f09ce0727a6d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6c3c7bf-bdef-46a1-899f-03da5a0227c0"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "561cc06c-f91e-4247-b5b3-7a279aa42f8f"],
 " of exactly ",
 StyleBox["n", "TI"],
 " walks or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7d2034a-4996-427e-b9a4-4ba10e36d3cd"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82b93e34-e4ca-405c-88da-3c0596a850d9"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a0cfd21-bb8d-447d-bf66-1348910ffbb1"],
 " gives every one."
}], "Usage",ExpressionUUID->"1814457d-f183-408c-84f8-e68c6b8d38fb"],

Cell[TextData[{
 "The default draw is random. Seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "522d5eb1-c568-4fce-88c2-b24d99c3ae74"],
 " to reproduce it. Give ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b535cf28-5b69-4fb0-88ca-a72bc13184bf"],
 " for deterministic descent. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c5cf605-22e6-4091-8e62-68ba17ed11cc"],
 " with ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a73c7210-b643-4378-924a-1deace75129d"],
 " keeps the full enumeration without drawing."
}], "Notes",ExpressionUUID->"45d171e2-1ecf-4ad4-bb88-d594ea2d2580"],

Cell[TextData[{
 "The germ is the seed of the walk: a vertex, a vertex list, a walk graph, or \
a list of germs. A vertex is the one-vertex germ, so ",
 Cell[BoxData[
  RowBox[{"RandomInfraWalk", "[", 
   RowBox[{"g", ",", " ", "p", ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13554a8a-8015-47d4-8d53-43893417a8f2"],
 " and ",
 Cell[BoxData[
  RowBox[{"RandomInfraWalk", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"{", "p", "}"}], ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93019eeb-ea36-4a7b-a15a-3a8e706797bd"],
 " are the same call. A germ is read as a vertex first, so on a substrate \
labelled by lists the vertex ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "1"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "adbea202-f3b6-4d51-82d5-cdfed43805ca"],
 " is one point, not the walk of its entries. A walk graph is read as its \
vertex sequence; a list of germs gives the walks grown from each."
}], "Notes",ExpressionUUID->"3a648a3f-b905-4f0d-94c4-36ddefdc3572"],

Cell[TextData[{
 StyleBox["kspec", "TI"],
 " is the budget in edges added on each growing side: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db535512-f00b-4c7a-b8c6-5728dc4b2598"],
 " (at most ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8bd41aa-c5f6-4ae8-b980-f9c6cebd1cb2"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc626d0c-3920-419c-a98e-7d483d8d06fa"],
 ", or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2be5c341-a1f8-4838-9418-3d8b080e883f"],
 ". A bare integer is no ",
 StyleBox["kspec", "TI"],
 ". ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fd37762-f2f0-4cd8-b556-5c43921ff6f6"],
 " is legal only under a hard rule that bounds the class: a bare ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e63c779f-f9b9-49bf-bb41-b6a9d6f77935"],
 " or a bare ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d79ca77-b786-4450-801c-081b8ccacd6b"],
 "."
}], "Notes",ExpressionUUID->"6b729bdc-a3ae-4a43-b7ad-24ef7edcf0db"],

Cell[TextData[{
 "A walk is a graph: a directed path graph on the pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "v"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19ce32dd-46ca-40e9-8710-3f00e5bce3ae"],
 ", the position and the vertex. ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fffdf0d2-0202-4c9b-88e0-09b71f7ebcf3"],
 " is its vertex sequence. The count-less call returns one walk graph, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "503ce9e0-8a43-449f-b302-27bf0c3de89b"],
 " when there is none."
}], "Notes",ExpressionUUID->"e71f1468-25cf-447c-98f6-e29a677b085e"],

Cell[TextData[{
 "A step reads a ",
 StyleBox["window",
  FontWeight->"Bold"],
 ": the last ",
 StyleBox["r", "TI"],
 " vertices of the growing side with the candidate appended, ",
 StyleBox["r", "TI"],
 " + 1 vertices and ",
 StyleBox["r", "TI"],
 " edges; ",
 StyleBox["r", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ac00fff-82a8-42cc-bbb7-6901b412a06a"],
 " is the whole side. A rule is an ",
 StyleBox["energy",
  FontWeight->"Bold"],
 " on the window, a non-negative number that is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27035f40-4b0b-42d8-b68f-454c17dddb09"],
 " exactly when the rule holds:"
}], "Notes",ExpressionUUID->"b93f9f9d-3d70-40bd-90a3-91d9e69d0f32"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b7813efb-9b72-45ff-9934-a477e62284d8"], Cell["Rule", "TableText",
     FontWeight->Bold,ExpressionUUID->"68531ca8-cfbc-4a4c-ac82-7781527b51c0"],
     Cell["Energy of the window", "TableText",
     FontWeight->Bold,ExpressionUUID->"4dc6d79e-39ed-4c28-9caf-5e2c5f1de827"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1874fb55-d0e8-4597-9d53-b1a6a5c2890d"], Cell[TextData[Cell[
    BoxData["\"\<Simple\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3b02ecc6-0378-4cb4-bf09-23bef35f99ad"]], "TableText",ExpressionUUID->
     "6999a63d-9b2e-4e1a-8037-910d7dc8db51"], Cell[TextData[{
     "the number of earlier occurrences of the candidate; at ",
     StyleBox["r", "TI"],
     " = 2 a backtrack, a cusp"
    }], "TableText",ExpressionUUID->"284a747f-269b-48e0-995e-e022e1b1a711"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "af62e217-3614-407c-b20f-644cf34200b6"], Cell[TextData[Cell[
    BoxData["\"\<Shortest\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "118b4d12-1dbb-467c-adf5-f66d1a01535e"]], "TableText",ExpressionUUID->
     "81c65036-681e-40e6-bb3c-dc6258588955"], Cell["\<\
the defect: the edges of the window minus the distance between its ends\
\>", "TableText",ExpressionUUID->"3aa6bb1f-160d-4f3b-8f6e-4647166de3d4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "642a20fc-d9cc-4044-9668-bd8c902c878f"], Cell[TextData[Cell[
    BoxData["\"\<Stretched\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9ee85d43-2b1b-481c-b3ec-558386697dd0"]], "TableText",ExpressionUUID->
     "55433111-7e67-4448-a612-4d3f45783f38"], Cell["\<\
the defect minus the least defect among the step's candidates\
\>", "TableText",ExpressionUUID->"25d8a2f9-d58e-49de-916f-2233fc963a35"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c87cbee4-0440-4ab9-b01a-19dadd2ad487"], Cell[TextData[StyleBox[
    "f", "TI"]], "TableText",ExpressionUUID->
     "e81c2221-b4da-4747-b3b6-75645b763698"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"f", "[", "window", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c067530a-4db8-4d88-a161-199180ecf36d"],
     ", a non-negative number; ",
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3836dcde-8f7b-4aff-bd81-fed2ec8779aa"],
     " and ",
     Cell[BoxData["False"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "25f8f71e-9a5e-4800-b837-673cd88d875a"],
     " read as ",
     Cell[BoxData["0"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0c9c46ce-0501-4369-8a55-6d4490b3e91d"],
     " and ",
     Cell[BoxData["1"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "66b46fa3-1295-43c0-ae29-399fa22466e2"],
     ", so a predicate is a rule"
    }], "TableText",ExpressionUUID->"3129c2c0-134a-493d-96ef-77903dd70109"]}
  }]], "2ColumnTableMod",ExpressionUUID->"e627f701-1261-4e8f-a603-\
081fd6132be5"],

Cell[TextData[{
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "edcf0ff3-d666-48ff-9e80-186cc473c7d2"],
 " is a list of rules, each written ",
 Cell[BoxData["rule"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1391ae1d-aa48-42d8-83c9-ddc48441e0db"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"rule", ",", " ", "r"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4733893-f0d3-4b79-9e32-146a24e4d71f"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"rule", ",", " ", "r", ",", " ", "p"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24b5cca9-9cfa-495a-85b8-0d0bc7b9cb6d"],
 ". A bare rule has ",
 StyleBox["r", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fcfbf7ef-d3fc-467d-a99e-cddc640724de"],
 ", a pair has ",
 StyleBox["p", "TI"],
 " = ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e21f1a1-89a5-405c-8979-8d4deab871fb"],
 ". The weight ",
 StyleBox["p", "TI"],
 " says how much a violation costs:"
}], "Notes",ExpressionUUID->"2f5acf0c-6cbb-436b-99be-fd03b548e1de"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "787c06df-1847-40ac-941f-855c75509f9d"], Cell[TextData[StyleBox[
    "p", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"c22e1d13-3436-4ebf-83ad-ccb0e51e9f6d"],
     Cell["Reading", "TableText",
     FontWeight->Bold,ExpressionUUID->"bec0906a-2d01-4348-aa20-2093d9e7809d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5674e716-ba9d-415e-adba-7a39dd095ecf"], Cell[TextData[Cell[BoxData[
    "0"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7aead89e-d31c-4c35-befc-49a5c446903b"]], "TableText",ExpressionUUID->
     "0335f8ff-64fc-4134-a47a-a8d18474e8d8"], Cell[
    "hard: a candidate of positive energy is dropped", "TableText",
     ExpressionUUID->"db863af7-7c29-40ff-b016-c3ca330d0ce5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e90d36d1-6052-4476-84f3-c8ae66582279"], Cell[TextData[Cell[BoxData[
     RowBox[{"0", " ", "<", " ", "p", " ", "<=", " ", "1"}]], "InlineFormula",
     
     FontSize->0.9 Inherited,ExpressionUUID->
     "3cdb27df-4720-486a-85b7-39c954731e54"]], "TableText",ExpressionUUID->
     "3c20c889-b1e5-4175-88dc-b19881dc937d"], Cell[TextData[{
     "soft: a candidate keeps the weight ",
     StyleBox["p", "TI"],
     "^energy; ",
     StyleBox["p", "TI"],
     " = ",
     Cell[BoxData[
      RowBox[{"Exp", "[", 
       RowBox[{"-", "beta"}], "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "dda692bd-1dc3-4cdf-b759-a7fb65f99688"],
     " is the Boltzmann weight at inverse temperature ",
     StyleBox["beta", "TI"],
     "; at ",
     StyleBox["p", "TI"],
     " = ",
     Cell[BoxData["1"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6c59ac47-dd6a-4195-9d91-fbdc643df0ed"],
     " every candidate weighs alike"
    }], "TableText",ExpressionUUID->"61c70644-f9da-4bfb-8195-4650c29e9436"]}
  }]], "2ColumnTableMod",ExpressionUUID->"868c6298-9504-4337-8317-\
7a879da95e1c"],

Cell[TextData[{
 "The hard rules cut the class; the soft rules put a distribution on it, the \
weight of a candidate being the product over the soft rules. The rules act in \
the order written, so ",
 Cell[BoxData["\"\<Stretched\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a85c42c1-3bcf-44db-bd46-694199f3c1e1"],
 " compares the candidates the hard rules before it left. As soft rules ",
 Cell[BoxData["\"\<Stretched\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "574dd753-8adc-43e1-abf4-cb64bccfbcbc"],
 " and ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5841106b-cb5f-4c53-82b3-8038c686f34d"],
 " weigh alike: their energies differ by a constant on each step."
}], "Notes",ExpressionUUID->"afdb58b4-311e-4f45-9c1e-ded3a9d6aa32"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "99f2f7d1-d88e-4d76-826a-9b1067cec3b5"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"e8bfc55d-e252-49af-b584-ff7317cc0e8b"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"6792d999-d71b-4f0e-8fb7-a12374df7e1a"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"06027794-0ac1-4197-9167-ff8bf8607c97"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f3190381-8729-4994-b897-ab97ddf90867"], Cell[TextData[Cell[BoxData[
    "Properties"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "80a43518-83f6-46c3-92c7-e1ecfb8e8cd1"]], "TableText",ExpressionUUID->
     "8782b441-cbf1-4d79-91f3-87369d6808a2"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "16e3e672-a434-4675-bd40-98d2f09c8ef2"]], "TableText",ExpressionUUID->
     "ca366074-2f68-4cd1-b74c-8fb18e7153ab"], Cell[TextData[{
     "the rules; ",
     Cell[BoxData[
      RowBox[{"{", "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9f5adda6-1fe8-4a23-ab51-31ac95052db4"],
     " is every walk"
    }], "TableText",ExpressionUUID->"c9aa0be2-b59b-4676-84e8-7b9408329b20"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "dcbc9e6d-bc6c-45fb-a05c-15878fe701ae"], Cell[TextData[Cell[
    BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ecb01cfa-5321-4f65-a3ba-b36048042a28"]], "TableText",ExpressionUUID->
     "80d01f4a-a60c-4328-a430-d998e497656f"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5cd24000-7b3c-4542-9bab-71a4c130a3ad"]], "TableText",ExpressionUUID->
     "e39bf9e2-8e44-4c4e-9b09-c05ffc082abd"], Cell[
    "the order the surviving candidates are tried in", "TableText",
     ExpressionUUID->"b1c67d74-71b8-44c0-acac-b0bfc78f031c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d43e74f4-6579-4d1b-a454-b43564f187bc"], Cell[TextData[Cell[
    BoxData["\"\<Direction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "adb479f7-fd06-4dd6-9722-d899fe345401"]], "TableText",ExpressionUUID->
     "11987da7-75dc-4491-a40d-d8cfd60ba7b5"], Cell[TextData[Cell[
    BoxData["\"\<Forward\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "eadf02a4-22e2-456d-be18-6aa183e2c9f4"]], "TableText",ExpressionUUID->
     "36655cd5-74f0-43c1-a94e-780673d3ac6e"], Cell[TextData[{
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c70c66c1-bc6c-4a3c-adf6-e8a3ce0089cd"],
     ", ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b54e4d85-9ca6-40fd-867e-b6d5d60a875b"],
     " or ",
     Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "aaf82b1e-4051-4c58-aca6-bec06f991bc4"]
    }], "TableText",ExpressionUUID->"0fc598c1-260a-4b27-b067-a188a84577c8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ded60a4f-8066-4c22-ab05-2b766fac1eb3"], Cell[TextData[Cell[
    BoxData["\"\<StoppingCondition\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c16d42bc-6033-462f-b851-8a3bf1e10ff6"]], "TableText",ExpressionUUID->
     "a10cc664-77ce-4868-880a-fa80ae77bfa7"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a163a253-a516-4ad3-9a4f-53857d8b899b"]], "TableText",ExpressionUUID->
     "dae6aaf1-b968-4daa-b8fb-2a48e14d1147"], Cell[
    "a predicate on the walk so far", "TableText",ExpressionUUID->
     "1abc7fb0-a0b2-4e1b-9586-8167a2fdf0b9"]}
  }]], "3ColumnTableMod",ExpressionUUID->"af0fde70-7edf-407e-8a0f-\
e46b21ed74bf"],

Cell[TextData[{
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1310841-2bd2-4eb2-ba81-dedd492e572c"],
 " turns the surviving candidates and their weights into the order they are \
tried:"
}], "Notes",ExpressionUUID->"d9abaa25-de8e-4ca2-8ddf-841d30d19cf8"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c3835662-95c7-4ac7-bc84-9eb08363e432"], Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"49c837c4-d4d1-4108-b417-fa382b1ac3c4"],
     Cell["Order", "TableText",
     FontWeight->Bold,ExpressionUUID->"cce21310-0b32-4faa-89ff-304dcfbd8e4a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "72a5a782-7ada-4621-81b3-6e5d83380069"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "bfc632bc-91a3-4e92-9926-6a4afa03d113"]], "TableText",ExpressionUUID->
     "50a1c7c9-a789-48df-b0f0-87f508ce1e98"], Cell[TextData[{
     "random by the weights for bounded counts; canonical for ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e4c89861-e66e-4476-86ea-165a38c87cc9"]
    }], "TableText",ExpressionUUID->"75d689e0-374b-4cc6-bf37-9b2c298de4db"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3f964d4f-7484-4986-a92b-61aa95594a48"], Cell[TextData[Cell[BoxData[
    "Identity"], "InlineFormula",
