Cell[TextData[{
 "A function is a rule: the energy ",
 Cell[BoxData[
  RowBox[{"GraphDistance", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"Last", " ", "@", " ", "w"}], ",", " ", "q"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79496bf8-e1ec-4c71-bc34-80b7550f267e"],
 " at window 1 and weight 0.3 pulls the walk toward ",
 StyleBox["q", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"1cbbe00c-79c1-46a5-896d-e32432eb4448"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"a", ",", " ", "6"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", "\n", "      ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
            RowBox[{"RandomInfraWalk", "[", 
             RowBox[{"g", ",", " ", "a", ",", " ", 
              RowBox[{"{", "12", "}"}], ",", " ", 
              RowBox[{"Properties", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"w", " ", "|->", " ", 
                   RowBox[{"GraphDistance", "[", 
                    RowBox[{"g", ",", " ", 
                    RowBox[{"Last", " ", "@", " ", "w"}], ",", " ", "q"}], 
                    "]"}]}], ",", " ", "1", ",", " ", "0.3"}], "}"}], 
                "}"}]}]}], "]"}]}], ")"}], ",", " ", "a", ",", " ", "q"}], 
         "}"}], ",", "\n", "      ", 
        RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"seed", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}]}], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"7ade9b58-1057-4eb7-94ae-ceded01e70cc"],

