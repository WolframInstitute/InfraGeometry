Cell[CellGroupData[{

Cell["Direction", "ExampleSubsection",ExpressionUUID->"cbd15918-3b43-495f-abaa-299be8dabca9"],

Cell["\<\
The self-avoiding walks that add at most 2 edges to a germ of one edge, \
forward, backward and at both ends:\
\>", "ExampleText",ExpressionUUID->"c6ae60ae-56b9-495c-bc44-34ac24de527c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"germ", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"c", ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", "c"}], "]"}]}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"walks", " ", "=", " ", 
          RowBox[{"RandomInfraWalk", "[", 
           RowBox[{"g", ",", " ", "germ", ",", " ", 
            RowBox[{"UpTo", "[", "2", "]"}], ",", " ", "All", ",", " ", 
            RowBox[{"Properties", " ", "->", " ", 
             RowBox[{"{", "\"\<Simple\>\"", "}"}]}], ",", " ", 
            RowBox[{"\"\<Direction\>\"", " ", "->", " ", "dir"}]}], "]"}]}], 
         "}"}], ",", "\n", "      ", 
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{"walks", ",", " ", "germ"}], "}"}], ",", " ", 
          RowBox[{"PlotLabel", " ", "->", " ", 
           RowBox[{"Length", "[", "walks", "]"}]}]}], "]"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"dir", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Forward\>\"", ",", " ", "\"\<Backward\>\"", ",", 
          " ", "\"\<BothSides\>\""}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d44556a9-f555-4ee8-bd83-fe6eb11037ae"],

