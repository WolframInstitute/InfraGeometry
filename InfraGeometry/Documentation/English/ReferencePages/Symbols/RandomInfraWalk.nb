Cell["\<\
Three walks of 9 edges from the centre of a mesh, the soft straightness at \
window 5 with weights 1, 0.3 and 0.01: from the random walk to a nearly \
straight one.\
\>", "ExampleText",ExpressionUUID->"c6eecd5f-cba8-4ef6-a98d-373ed05dc246"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
            RowBox[{"RandomInfraWalk", "[", 
             RowBox[{"g", ",", " ", "c", ",", " ", 
              RowBox[{"UpTo", "[", "9", "]"}], ",", " ", 
              RowBox[{"Properties", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"{", 
                 RowBox[{"\"\<Shortest\>\"", ",", " ", "5", ",", " ", "p"}], 
                 "}"}], "}"}]}]}], "]"}]}], ")"}], ",", " ", "c"}], "}"}], ",",
         " ", 
        RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0.3", ",", " ", "0.01"}], "}"}]}], "}"}]}], 
     "]"}]}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f58502fa-5a1f-49a0-b1b3-7f6fdb3475b9"],

