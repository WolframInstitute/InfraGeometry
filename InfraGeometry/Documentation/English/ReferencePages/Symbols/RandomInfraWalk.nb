Cell[TextData[{
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Stretched\>\"", ",", " ", "2"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5f609e9-9d8c-44f6-abaa-2aeb99e70e1f"],
 " keeps at each step the candidates farthest from the vertex two steps back: \
on the triangular tiling the three of the six neighbours that neither step \
back nor cut a triangle."
}], "ExampleText",ExpressionUUID->"4e36e7a2-1c31-4998-ac21-4689c0053732"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{"RandomInfraWalk", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", 
       RowBox[{"{", "4", "}"}], ",", " ", "All", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"\"\<Stretched\>\"", ",", " ", "2"}], "}"}], "}"}]}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"walks", ",", " ", "a"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "walks"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"1fbaf772-1782-4650-b708-490823b15807"],

