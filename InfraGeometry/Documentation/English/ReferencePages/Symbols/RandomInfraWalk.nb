Cell[TextData[{
 "A walk is a shortest path exactly when every step has energy 0. At the \
large ",
 StyleBox["\[Beta]", "TI"],
 " = 1000 on the mesh some walks of 10 edges from the centre are, and some \
meet a vertex where no candidate has energy 0; the pairs agree. The bare ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14b3d549-1f29-4f12-a1a5-5d322ada9be2"],
 " keeps only the first, the walks of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "71b6a9f1-6abe-4973-b77f-8456f7513ead"],
 ":"
}], "ExampleText",ExpressionUUID->"7be5ca8d-046a-41bc-a2f0-fb62920078d9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"energy", " ", "=", " ", 
     RowBox[{"w", " ", "|->", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "w", "]"}], " ", "<", " ", "3"}], ",", " ", 
        "0", ",", "\n", "     ", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"Mean", " ", "@", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"w", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
               RowBox[{"Last", "[", "w", "]"}]}], "]"}], " ", "-", " ", 
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"w", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
               RowBox[{"w", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "2"}], "]"}], "]"}]}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", 
              RowBox[{
               RowBox[{"Length", "[", "w", "]"}], " ", "-", " ", "2"}]}], 
             "}"}]}], "]"}]}]}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"w", " ", "=", " ", 
         RowBox[{"Last", " ", "/@", " ", 
          RowBox[{"VertexList", " ", "@", " ", 
           RowBox[{"RandomInfraWalk", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", 
             RowBox[{"{", "10", "}"}], ",", " ", 
             RowBox[{"Properties", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<Simple\>\"", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"\"\<Geodesic\>\"", ",", " ", 
                  RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "1000"}]}], 
                 "}"}]}], "}"}]}], ",", " ", 
             RowBox[{"RandomSeeding", " ", "->", " ", "s"}]}], "]"}]}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"energy", " ", "@", " ", 
              RowBox[{"Take", "[", 
               RowBox[{"w", ",", " ", "k"}], "]"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"k", ",", " ", "2", ",", " ", 
               RowBox[{"Length", "[", "w", "]"}]}], "}"}]}], "]"}], ",", " ", 
           
           RowBox[{
            RowBox[{"#", " ", "==", " ", "0"}], " ", "&"}]}], "]"}], ",", " ", 
         RowBox[{"InfraGeodesicQ", "[", 
          RowBox[{"g", ",", " ", "w"}], "]"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"fb2b7727-3d04-440d-a0db-b65720f0125d"],

