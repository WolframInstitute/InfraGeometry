 "Stopping at the first arrival at ",
 StyleBox["b", "TI"],
 ". The walks that end there are the self-avoiding walks of at most 5 edges \
from the centre to ",
 StyleBox["b", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"c9504cb9-b1bc-45cc-8b2a-db465d2b2691"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{"RandomInfraWalk", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"UpTo", "[", "5", "]"}], ",", " ", "All", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Simple\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "b"}], " ", 
          "&"}], ")"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"arrived", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"walks", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Last", " ", "@", " ", 
          RowBox[{"Last", " ", "@", " ", 
           RowBox[{"VertexList", " ", "@", " ", "#"}]}]}], " ", "===", " ", 
         "b"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"arrived", ",", " ", "c", ",", " ", "b"}], "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Length", "[", "arrived", "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"689672bb-d9de-42b0-a575-a8ff98dafcfb"],

