     "c04a2add-cef3-4ae2-8774-97c625982109"], Cell[TextData[{
     "a predicate on the vertex sequence so far; the walk stops when it gives \
",
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "74623683-6717-4626-913e-0c301f5a6f93"]
    }], "TableText",ExpressionUUID->"88dd5acf-739f-4903-8548-6ef820af71b4"]},
