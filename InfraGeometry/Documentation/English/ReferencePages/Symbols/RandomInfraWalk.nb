                    RowBox[{"Last", "[", "w", "]"}], ",", " ", "q"}], 
                    "]"}]}]}], ",", " ", 
                 RowBox[{"\"\<Window\>\"", " ", "->", " ", "1"}]}], "}"}]}], 
              "}"}]}], ",", "\n", "        ", 
