Cell["\<\
The number of self-avoiding walks of 1 to 5 edges on the grid:\
\>", "ExampleText",ExpressionUUID->"36a9e4bf-02e6-495e-8d06-e7ed3f2d11b3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"{", "k", "}"}], ",", " ", "All", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", "\"\<Simple\>\"", "}"}]}]}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "5"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f6435db2-2e15-48b0-b1f1-63954d5c417b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "12", ",", "36", ",", "100", ",", "284"}], 
  "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"037a930b-852d-4c8a-a00f-ae8c1e024fef"]
}, Open  ]],

Cell[TextData[{
 "From the random walk to a straight one: 9 edges from the centre of the \
square mesh at ",
 StyleBox["\[Beta]", "TI"],
 " = 0, 2, 8, 32 and ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08f8fd06-fc69-48bb-a130-22e23608d695"],
 ":"
}], "ExampleText",ExpressionUUID->"0ace807b-0a43-4527-b087-17e10ba24d6a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"InfraSubstrateHighlight", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"RandomInfraWalk", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", 
             RowBox[{"{", "9", "}"}], ",", " ", 
             RowBox[{"Properties", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<Simple\>\"", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"\"\<Geodesic\>\"", ",", " ", 
                  RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "b"}]}], 
                 "}"}]}], "}"}]}], ",", " ", 
             RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}], ",", 
           " ", "c"}], "}"}], ",", "\n", "      ", 
         RowBox[{"PlotLabel", " ", "->", " ", "b"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", 
         RowBox[{"{", 
          RowBox[{
          "0", ",", " ", "2", ",", " ", "8", ",", " ", "32", ",", " ", 
           "Infinity"}], "}"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"30c96a07-5f6c-4388-8099-61589e177290"],

