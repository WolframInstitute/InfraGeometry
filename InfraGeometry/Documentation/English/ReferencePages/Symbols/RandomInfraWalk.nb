Cell[TextData[{
 "The walks of 4 edges on the grid: self-avoiding, without a step back, and \
all of them, ",
 StyleBox["100", "TI"],
 ", ",
 StyleBox["4 \[CenterDot] 3\.b3 = 108", "TI"],
 " and ",
 StyleBox["4\:2074 = 256", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"a0a85b98-24e6-49ea-af20-7b1db77db149"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"rules", " ", "->", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"RandomInfraWalk", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", 
         RowBox[{"{", "4", "}"}], ",", " ", "All", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", "rules"}]}], "]"}]}]}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"rules", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "\"\<Simple\>\"", "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"\"\<Simple\>\"", ",", " ", "2"}], "}"}], "}"}], ",", " ", 
         
         RowBox[{"{", "}"}]}], "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1729c979-d997-4444-b461-8fbec5eaac51"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"{", "\<\"Simple\"\>", "}"}], "\[Rule]", "100"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"\<\"Simple\"\>", ",", "2"}], "}"}], "}"}], "\[Rule]", "108"}], 
   ",", 
   RowBox[{
    RowBox[{"{", "}"}], "\[Rule]", "256"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c202a065-739a-4003-875f-1e8bd6cb200e"]
}, Open  ]],

Cell[TextData[{
 "A function is an energy. The energy ",
 StyleBox["d(v, q)", "TI"],
 " of the new vertex, at window 1 and ",
 StyleBox["\[Beta]", "TI"],
 " = 1.2, pulls a self-avoiding walk toward ",
 StyleBox["q", "TI"],
 ", here at distance 5; the walk stops there. The labels are the lengths:"
}], "ExampleText",ExpressionUUID->"ce3a3636-c7ae-4ad7-aa8b-9dfd63e60d7b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "5"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"walk", " ", "=", " ", 
          RowBox[{"RandomInfraWalk", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", 
            RowBox[{"UpTo", "[", "20", "]"}], ",", " ", 
            RowBox[{"Properties", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<Simple\>\"", ",", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"w", " ", "|->", " ", 
                  RowBox[{"GraphDistance", "[", 
                   RowBox[{"g", ",", " ", 
                    RowBox[{"Last", "[", "w", "]"}], ",", " ", "q"}], "]"}]}],
                  ")"}], " ", "->", " ", 
                RowBox[{"{", 
                 RowBox[{"1.2", ",", " ", "1"}], "}"}]}]}], "}"}]}], ",", 
            "\n", "        ", 
            RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "q"}], " ", 
               "&"}], ")"}]}], ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "seed"}]}], "]"}]}], 
         "}"}], ",", "\n", "      ", 
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{"walk", ",", " ", "c", ",", " ", "q"}], "}"}], ",", " ", 
          RowBox[{"PlotLabel", " ", "->", " ", 
           RowBox[{"EdgeCount", "[", "walk", "]"}]}]}], "]"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"seed", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"dbefcb2d-25af-4cb4-9844-e9a150d19129"],

