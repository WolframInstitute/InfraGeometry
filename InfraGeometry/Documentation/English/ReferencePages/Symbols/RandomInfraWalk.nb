Cell[TextData[{
 "A soft ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7225cdc3-d4c8-48b4-ad9c-cb7587bcfe9e"],
 ": the walk of 30 edges that rarely returns to a vertex it has visited, at \
weights 0.01, 0.1 and 1, with the number of returns."
}], "ExampleText",ExpressionUUID->"a278d919-1a2a-4638-9724-ec3cbd37b6ee"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"walk", " ", "=", " ", 
          RowBox[{"RandomInfraWalk", "[", 
           RowBox[{"g", ",", " ", "a", ",", " ", 
            RowBox[{"{", "30", "}"}], ",", " ", 
            RowBox[{"Properties", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"{", 
               
               RowBox[{"\"\<Simple\>\"", ",", " ", "Infinity", ",", " ", 
                "p"}], "}"}], "}"}]}], ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "4"}]}], "]"}]}], "}"}], 
        ",", "\n", "      ", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"walk", ",", " ", "a"}], "}"}], ",", " ", 
            RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]}], "]"}], ",",
           "\n", "        ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "\"\<: \>\"", ",", " ", 
             RowBox[{"31", " ", "-", " ", 
              RowBox[{"Length", " ", "@", " ", 
               RowBox[{"DeleteDuplicates", "[", 
                RowBox[{"Last", " ", "/@", " ", 
                 RowBox[{"VertexList", " ", "@", " ", "walk"}]}], "]"}]}]}]}],
             "}"}], "]"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.01", ",", " ", "0.1", ",", " ", "1"}], "}"}]}], "}"}]}], 
     "]"}]}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4050ce5b-e8aa-48f3-9692-4ad76916d4a7"],

