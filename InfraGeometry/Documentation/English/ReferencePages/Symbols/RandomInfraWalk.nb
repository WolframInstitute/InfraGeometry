Cell[TextData[{
 "The budget ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4175a03-7a50-4de2-bd4b-d6e673f875f2"],
 " without ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "602480a4-8197-4941-b173-327d7049c4dd"],
 " or ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c5e8cc9-d6d1-4914-b26b-ce52318e00cd"],
 " on the whole walk, and a bare integer as budget, leave the call \
unevaluated:"
}], "ExampleText",ExpressionUUID->"c15829ee-bae0-4f4d-a876-dc95a9d2efe8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "Infinity", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"\"\<Geodesic\>\"", ",", " ", 
            RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "5"}]}], "}"}], 
          "}"}]}]}], "]"}]}], ",", " ", 
     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3f88665f-b5f5-45d1-bc49-7b790c92be5b"],

