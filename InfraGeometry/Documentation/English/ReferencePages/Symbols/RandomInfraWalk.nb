     "fbbdc8a3-1afa-42bc-88d4-b60e459e1698"], Cell[TextData[{
     "one candidate drawn by the weights, no backtracking: the random walk; a \
count ",
     StyleBox["n", "TI"],
     " is ",
     StyleBox["n", "TI"],
     " independent runs"
    }], "TableText",ExpressionUUID->"eef46e34-1817-43b6-9d03-300bc3c9f433"]},
