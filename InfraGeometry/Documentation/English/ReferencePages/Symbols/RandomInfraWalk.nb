Cell[TextData[{
 "A window: ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Simple\>\"", ",", " ", "3"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cb67f70-3381-4f30-8276-f23be6a69963"],
 " forbids a return within 3 steps only, so the walk may close round a \
hexagon; ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6628b67b-d741-4865-8fec-94b39dcfe3ab"],
 " may not."
}], "ExampleText",ExpressionUUID->"0acea327-7c0c-4266-9c28-53f7f58d9cd9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"loops", " ", "=", " ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"RandomInfraWalk", "[", 
             RowBox[{"g", ",", " ", "a", ",", " ", 
              RowBox[{"{", "6", "}"}], ",", " ", "All", ",", " ", 
              RowBox[{"Properties", " ", "->", " ", 
               RowBox[{"{", "rule", "}"}]}]}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Last", " ", "@", " ", 
               RowBox[{"Last", " ", "@", " ", 
                RowBox[{"VertexList", " ", "@", " ", "#"}]}]}], " ", "===", 
              " ", "a"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "      ", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"loops", ",", " ", "a"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"rule", ",", " ", "\"\<: \>\"", ",", " ", 
             RowBox[{"Length", " ", "@", " ", "loops"}]}], "}"}], "]"}]}], 
         "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"rule", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Simple\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<Simple\>\"", ",", " ", "3"}], "}"}]}], "}"}]}], 
       "}"}]}], "]"}]}]}], "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"9a3a0859-ea19-4d94-8ccf-fbc22491af09"],

