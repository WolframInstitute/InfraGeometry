Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraWalk", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b74722bb-4774-4e1e-a09f-de21604909c0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7d28194-ef24-48be-801f-f9ac0ae43910"],
 "\[LineSeparator]",
 "gives a random walk grown from ",
 StyleBox["germ", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " by at most the budget ",
 StyleBox["k", "TI"],
 " of edges, each step under the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Properties"]], "paclet:ref/Properties"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c55af9de-98da-4d09-acab-4d39bf8d50bf"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"536b9e60-81a0-4112-803f-37000ac99791"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["k", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b50abba-1c8e-4d4c-9622-eee11e7527fa"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " distinct walks.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"9efaa1a8-af2c-4a2f-9934-3dc30dad485c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45c94cac-44b3-427f-bad6-f5c2e9096ba1"],
 "\[LineSeparator]",
 "grows the walk with no budget, until no admissible step remains or the \
stopping condition fires."
}], "Usage",ExpressionUUID->"3759146d-7a54-4fa8-8b99-ca6a957298da"],

Cell[TextData[{
 "The germ is a vertex, a vertex list or a walk graph; a list of germs gives \
the walks grown from each. A walk is returned as a directed path graph on the \
pairs {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "}; ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5519158b-e6ec-47ff-87ec-1adb64dfd829"],
 " is its vertex sequence."
}], "Notes",ExpressionUUID->"66e17ce9-cd1f-4502-b1b9-70d6f4aebd5f"],

Cell[TextData[{
 "The budget ",
 StyleBox["k", "TI"],
 " counts the edges added on each growing side: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "109be37c-24c1-4d98-9d65-dab31b77c05b"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "631b9c66-8c54-4033-9bd2-f72d02ff2aa5"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"kmin", ",", " ", "kmax"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b1197e2-e9ea-453f-a6b7-351261d0f86d"],
 " or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ad3317d-17c2-43de-9564-f1f384fa1206"],
 ". ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "908ec07f-21da-4620-90a3-60f62cd139af"],
 " needs the bare ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc1dfb46-29fc-4daf-940b-3073a61f6453"],
 ", which bounds the walks."
}], "Notes",ExpressionUUID->"fa78eff6-8ee2-4bee-a757-b23d5a6cdd20"],

Cell[TextData[{
 "Each step chooses the next vertex among the neighbours of the last one, the \
candidates. A property reads the ",
 StyleBox["window", "TI"],
 " of a candidate ",
 StyleBox["v", "TI"],
 ": the last ",
 StyleBox["r", "TI"],
 " vertices of the walk followed by ",
 StyleBox["v", "TI"],
 ", so a window of scale ",
 StyleBox["r", "TI"],
 " has ",
 StyleBox["r", "TI"],
 " edges; ",
 StyleBox["r", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4d49dc8-0d17-43d5-a8d9-1c39c1f042cd"],
 ", the default, is the whole walk."
}], "Notes",ExpressionUUID->"ccde7968-00d4-4aac-992d-5cb034466db5"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b9c2806a-7b4f-407d-8f75-efea0e3a7318"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"7bde0d42-b0a3-49f0-b020-ab536a435c7f"],
     Cell["Effect", "TableText",
     FontWeight->Bold,ExpressionUUID->"66f420a5-718d-4368-9762-6dbd44208b71"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "badaad12-a70f-4d4a-8e51-469c8fe8df45"], Cell[TextData[Cell[
    BoxData["\"\<Simple\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0fb395e9-b8e6-4a19-8f1c-39535b947c9e"]], "TableText",ExpressionUUID->
     "af310be7-8b47-4603-af84-af8169d93abc"], Cell[TextData[{
     "no vertex twice; ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Simple\>\"", ",", " ", "r"}], "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b2ef9dae-775b-47c4-a42d-cb00eec344b5"],
     " no vertex twice within the window, ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Simple\>\"", ",", " ", "r", ",", " ", "p"}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2066079f-d1be-44a9-83a2-07b15828dcab"],
     " a repeat weighed ",
     StyleBox["p", "TI"],
     " instead of forbidden"
    }], "TableText",ExpressionUUID->"fb4d115c-a875-4b90-a8b5-bf8f68568ff2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "35cc2dba-3b0a-4d45-8a30-530d3d7db3aa"], Cell[TextData[Cell[BoxData[
     RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "\[Beta]"}]], 
     "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "688baa8f-ff97-45a0-b36e-896e0aaecc89"]], "TableText",ExpressionUUID->
     "c3e09261-05f9-4b1c-a3d3-7211364a87d7"], Cell[TextData[{
     "each step prefers the straightest continuation: a candidate is weighed ",
     Cell[BoxData[
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]"}], "]"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "202d6d7d-792f-4d54-bf4d-914f5f6c71bd"],
     ", \[CapitalDelta] its excess defect, below"
    }], "TableText",ExpressionUUID->"0f97c856-b4fc-4968-a74e-21bb1af74a79"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7301cd3b-434b-4f5c-958d-6e2ddfc3ec70"], Cell[TextData[Cell[BoxData[
     RowBox[{"\"\<Straightness\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\[Beta]", ",", " ", "r"}], "}"}]}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ccaf0656-9271-4d0d-981d-56407937320e"]], "TableText",ExpressionUUID->
     "b8e7a210-8e8b-4c8a-ae85-4aa859cc056f"], Cell[TextData[{
     "the same on the window of scale ",
     StyleBox["r", "TI"]
    }], "TableText",ExpressionUUID->"8266044d-4114-4f43-8bd5-875f2e1dd8d5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "21da1811-6b70-4c31-86a9-2f96eac6571c"], Cell[TextData[{
     StyleBox["f", "TI"],
     " ",
     Cell[BoxData[
      RowBox[{"->", " ", "\[Beta]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "bcdab075-9f8a-4d3b-a345-271d5ace58d1"],
     ", ",
     StyleBox["f", "TI"],
     " ",
     Cell[BoxData[
      RowBox[{"->", " ", 
       RowBox[{"{", 
        RowBox[{"\[Beta]", ",", " ", "r"}], "}"}]}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "dcf819e8-b631-459a-b799-7faaecc4a78e"]
    }], "TableText",ExpressionUUID->"6c8d2dd9-499a-428f-a33a-db5506911923"], 
    Cell[TextData[{
     "the energy ",
     Cell[BoxData[
      RowBox[{"f", "[", "window", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e4077f83-d063-4411-9c75-15fd9238266c"],
     " \[GreaterEqual] 0 in place of the defect; ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2267dd9f-066c-46aa-b924-0db38a1fe01d"],
     " forbids the window, and a predicate reads ",
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3a99e9d6-88c6-4a30-8307-5c9f9130143a"],
     " as 0 and ",
     Cell[BoxData["False"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "cd591bf4-3f69-427e-8b5a-f90d10370b66"],
     " as ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2519a58a-691e-4c1d-97fa-8b9aa500e0d3"]
    }], "TableText",ExpressionUUID->"31d36055-f5e3-44b5-a206-e7c7be7878bf"]}
  }]], "2ColumnTableMod",ExpressionUUID->"a07e2c9e-4041-4959-989b-\
4de86507077b"],

Cell[TextData[{
 StyleBox["\[Beta]", "TI"],
 " is a non-negative number or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7344c1f4-7018-43f1-8f43-a9613a0bdae2"],
 ". The properties act in the order given."
}], "Notes",ExpressionUUID->"e3c3cf2f-3450-422b-b30e-b4873f6222f9"],

Cell[TextData[{
 StyleBox["The defect.",
  FontWeight->"Bold"],
 " For a window ",
 StyleBox["w", "TI"],
 " = (",
 StyleBox["w", "TI"],
 "\:2081, \[Ellipsis], ",
 StyleBox["w", "TI"],
 "\:2098) the piece from ",
 StyleBox["w\:1d62", "TI"],
 " to the end has ",
 StyleBox["m", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 " edges, and its defect"
}], "Notes",ExpressionUUID->"51979311-3f13-43b6-b1d3-6faf95775f92"],

Cell[TextData[{
 "  ",
 StyleBox["D\:1d62", "TI"],
 "(",
 StyleBox["w", "TI"],
 ") = (",
 StyleBox["m", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 ") \[Minus] ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w\:1d62", "TI"],
 ", ",
 StyleBox["w\:2098", "TI"],
 ")"
}], "Notes",ExpressionUUID->"173d6a8f-b842-42a4-9497-e8f9770a7f1a"],

Cell["\<\
is the number of edges it wastes against a shortest path: 0 exactly when that \
piece is a shortest path. The defect of the window is the mean over its \
vertices,\
\>", "Notes",ExpressionUUID->"03f7f589-0004-4154-852f-58bf87e595aa"],

Cell[TextData[{
 "  ",
 StyleBox["D", "TI"],
 "(",
 StyleBox["w", "TI"],
 ") = (",
 StyleBox["D", "TI"],
 "\:2081(",
 StyleBox["w", "TI"],
 ") + ",
 StyleBox["D", "TI"],
 "\:2082(",
 StyleBox["w", "TI"],
 ") + \[CenterEllipsis] + ",
 StyleBox["D", "TI"],
 "\:2098\:208b\:2081(",
 StyleBox["w", "TI"],
 ")) / (",
 StyleBox["m", "TI"],
 " \[Minus] 1),"
}], "Notes",ExpressionUUID->"c410df50-b218-4542-9469-8bc9df5c56cd"],

Cell[TextData[{
 "0 exactly when the window is a shortest path, and positive for a bend at \
any scale up to ",
 StyleBox["r", "TI"],
 "."
}], "Notes",ExpressionUUID->"cad68562-d609-43ec-ab61-8961a1c7561f"],

Cell[TextData[{
 StyleBox["The excess defect.",
  FontWeight->"Bold"],
 " Appending a candidate ",
 StyleBox["v", "TI"],
 " to the window changes the term of each earlier vertex ",
 StyleBox["w\:1d62", "TI"],
 " by 0 when ",
 StyleBox["v", "TI"],
 " is farther from ",
 StyleBox["w\:1d62", "TI"],
 " than the last vertex is, by 1 when it is as far, and by 2 when it is \
nearer. The excess defect of ",
 StyleBox["v", "TI"],
 " is its defect against the best candidate ",
 StyleBox["u", "TI"],
 " of the step,"
}], "Notes",ExpressionUUID->"76dc2fe8-e109-4d1d-8207-2a3474a8ba2d"],

Cell[TextData[{
 "  \[CapitalDelta](",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["D", "TI"],
 "(",
 StyleBox["w", "TI"],
 " + ",
 StyleBox["v", "TI"],
 ") \[Minus] min_",
 StyleBox["u", "TI"],
 " ",
 StyleBox["D", "TI"],
 "(",
 StyleBox["w", "TI"],
 " + ",
 StyleBox["u", "TI"],
 "),"
}], "Notes",ExpressionUUID->"9d78d2f3-136b-468a-85d0-2f54f95b8c36"],

Cell[TextData[{
 "so \[CapitalDelta] is, against the best candidate, the fraction of earlier \
vertices of the window that the step does not move away from, between 0 and \
2. The step draws ",
 StyleBox["v", "TI"],
 " with probability ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]", 
    RowBox[{"(", "v", ")"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db766114-cac8-4f28-9ead-86d43cdc62cb"],
 " divided by the sum of ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]", 
    RowBox[{"(", "u", ")"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b54f1591-ac4e-4e72-a236-087955e84f82"],
 " over the candidates: a Boltzmann weight at inverse temperature ",
 StyleBox["\[Beta]", "TI"],
 ". On a mesh whose path distance is close to the Euclidean one, a turn by \
the angle ",
 StyleBox["\[Theta]", "TI"],
 " costs about ",
 StyleBox["\[Beta]", "TI"],
 " (1 \[Minus] cos ",
 StyleBox["\[Theta]", "TI"],
 ") \[TildeTilde] ",
 StyleBox["\[Beta]", "TI"],
 " ",
 StyleBox["\[Theta]", "TI"],
 "\.b2 / 2, whatever the length of the window, so ",
 StyleBox["\[Beta]", "TI"],
 " is a bending rigidity: turns of order 1/\[Sqrt]",
 StyleBox["\[Beta]", "TI"],
 " are typical."
}], "Notes",ExpressionUUID->"2a9468ef-0327-4c88-aeca-04ac1fa43d51"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2050e5ef-b742-466d-9edf-c9e2dcdb7211"], Cell[TextData[StyleBox[
    "\[Beta]", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"76e0ecc4-8e13-4633-971e-16ef36519705"],
     Cell["The walk", "TableText",
     FontWeight->Bold,ExpressionUUID->"d21a8fd2-57b0-41cf-b3f2-89c609e7f054"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "daba15fe-46ca-4293-ab63-78c4454970ca"], Cell[
    "0", "TableText",ExpressionUUID->"de71ddc9-4a0e-4262-a00c-2be2e93c5c7d"], 
    Cell["the plain random walk: every candidate weighs alike", "TableText",
     ExpressionUUID->"1ce3a53d-44c2-4814-9f6f-b73ffd7e4ca3"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1e13a374-1d01-474a-89f1-47859134b77b"], Cell[
    "2", "TableText",ExpressionUUID->"fa9cb88a-f3f8-4ddf-9ca1-4f23c063daeb"], 
    Cell["wanders, with a preference for going on", "TableText",
     ExpressionUUID->"8ce5c149-2195-47f2-98f8-71c4deae1ad5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "587d324f-b62e-4271-b5c7-6410d84ca4a9"], Cell[
    "8", "TableText",ExpressionUUID->"8b5cc918-fd97-4255-ae7c-6b1ed888c4fc"], 
    Cell["bends by about 20\[Degree] per step", "TableText",ExpressionUUID->
     "db0f34d1-9aba-4e68-8be5-f016c32bf92f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9a147d8b-f451-46e6-ad16-69ce1d53ffa4"], Cell[
    "32", "TableText",ExpressionUUID->"5751c547-39c9-4a1d-9020-13973b71ff09"],
     Cell["nearly straight", "TableText",ExpressionUUID->
     "c44b808a-5a4d-4103-8749-dcbea2d203f6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "38d3185b-9aab-44a3-b0da-37e2d72e48f0"], Cell[TextData[Cell[BoxData[
    "Infinity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a64aabe5-2b17-44d0-a77d-52bc0d8f26d4"]], "TableText",ExpressionUUID->
     "ff0daf04-85ed-44c2-8325-0a5225aa2d6c"], Cell["\<\
always a candidate of \[CapitalDelta] = 0; straightness never ends the walk, \
since some candidate always has \[CapitalDelta] = 0\
\>", "TableText",ExpressionUUID->"32ba1865-9f85-40cf-83d5-76a08b3ae076"]}
  }]], "2ColumnTableMod",ExpressionUUID->"80f1edb6-131c-4557-881d-\
e7dc45211f25"],

Cell[TextData[{
 "A walk is a shortest path at scale ",
 StyleBox["r", "TI"],
 " (",
 Cell[BoxData[
  RowBox[{"InfraGeodesicQ", "[", 
   RowBox[{"g", ",", " ", "walk", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "054f02cd-3bd6-405d-a8cf-005b223a17ac"],
 ") exactly when every step moves away from all the earlier vertices of its \
window, that is when ",
 StyleBox["D", "TI"],
 "(",
 StyleBox["w", "TI"],
 " + ",
 StyleBox["v", "TI"],
 ") = 0 at every step; at ",
 StyleBox["\[Beta]", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1a6e7ff-fd87-43e0-adea-03b4bf42be0d"],
 " the walk takes such a step whenever one exists."
}], "Notes",ExpressionUUID->"a0c12849-15e3-43f6-86b2-3a004e5823a5"],

Cell[TextData[{
 "Under ",
 Cell[BoxData[
  RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<BothSides\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bcaada6-e428-4bab-b70a-c1e42613702e"],
 " the window of a step is the joined walk: a step at both ends draws the new \
first vertex on the whole walk, then the new last vertex on the whole walk \
with that new first vertex, so the two halves are straight as one walk."
}], "Notes",ExpressionUUID->"af87ff66-5ec0-43b9-9ae1-819f6bbbaf76"],

Cell[TextData[{
 "The defect sees shortest paths, not Euclidean straightness. On the square \
grid every monotone staircase is a shortest path, so at ",
 StyleBox["\[Beta]", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a3d46b5-b958-4733-8596-cc32005115e4"],
 " the walk is a random staircase, not a straight line; a walk straight in \
the Euclidean sense needs a substrate whose shortest paths are straight, such \
as the square mesh."
}], "Notes",ExpressionUUID->"9483bca5-3c87-4c06-b996-5f64cbfb6961"],

Cell["Options:", "Notes",ExpressionUUID->"ef75b02a-4fda-43f4-bcef-70d8c153406c"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f57735e8-5432-43d2-99f7-8a3ada1ddfb4"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"30454f68-df9d-42aa-a321-b605a8c32547"],
     Cell["Default", "TableText",
