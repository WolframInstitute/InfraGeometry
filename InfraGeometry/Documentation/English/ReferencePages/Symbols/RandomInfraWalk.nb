Cell[TextData[{
 "A call with ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b657c25-330b-4384-b7c4-40dcb3932b02"],
 " and no hard rule that bounds the class is refused, since a stopping \
condition may never fire; so is a bare integer as ",
 StyleBox["kspec", "TI"],
 ". Both calls stay unevaluated, which ",
 Cell[BoxData["MatchQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8a93400-7674-4841-a089-3e778b3509de"],
 " tests."
}], "ExampleText",ExpressionUUID->"43bba9ae-634c-4463-9578-4662bcf27cdf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MatchQ", "[", 
      RowBox[{
       RowBox[{"RandomInfraWalk", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "Infinity", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", "}"}]}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       "_RandomInfraWalk"}], "]"}], ",", " ", 
     RowBox[{"MatchQ", "[", 
      RowBox[{
       RowBox[{"RandomInfraWalk", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "3", ",", " ", "All"}], "]"}], ",",
        " ", "_RandomInfraWalk"}], "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a8e87c21-eeb0-49a9-812d-ce5fecf6672f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"44c93321-c030-4d55-93bb-5bda77099e31"]
}, Open  ]],

Cell[TextData[{
 "Under ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac8cdabb-3a46-4bbc-8306-241c3579c321"],
 " the weights are ignored, so a soft rule changes nothing: the walk is the \
canonical walk of the hard rules."
}], "ExampleText",ExpressionUUID->"d05190cc-3a3f-4c1e-afcf-af8c0ef153c0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"RandomInfraWalk", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", 
       RowBox[{"{", "4", "}"}], ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Simple\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<Shortest\>\"", ",", " ", "3", ",", " ", "0.01"}], 
           "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}], ",",
        " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], " ", "===", 
     "\n", "    ", 
     RowBox[{"RandomInfraWalk", "[", 
