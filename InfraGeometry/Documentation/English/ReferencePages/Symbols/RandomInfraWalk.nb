     "c35980b0-2a63-493e-a3bf-7bd75a25d4d9"]], "TableText",ExpressionUUID->
     "07b1fb45-b08d-4835-8eab-8f5720b22fa6"], Cell[TextData[{
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0543bc8e-78a3-481f-bea2-8f5dd971430d"],
