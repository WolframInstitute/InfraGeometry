Cell[TextData[{
 "A call with ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f689c6f0-187e-4600-8230-a1402375dfa9"],
 " and no hard rule that bounds the class is refused, since a stopping \
condition may never fire; so is a bare integer as ",
 StyleBox["kspec", "TI"],
 ". Both calls stay unevaluated, which ",
 Cell[BoxData["MatchQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a752a991-712b-4d82-b288-a855e6683abf"],
 " tests."
}], "ExampleText",ExpressionUUID->"16518b75-0566-40d8-b2d9-c469ea900cb8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MatchQ", "[", 
      RowBox[{
       RowBox[{"RandomInfraWalk", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "Infinity", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", "}"}]}]}], "]"}], ",", " ", "_RandomInfraWalk"}], 
      "]"}], ",", " ", 
     RowBox[{"MatchQ", "[", 
      RowBox[{
       RowBox[{"RandomInfraWalk", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "3", ",", " ", "All"}], "]"}], ",",
        " ", "_RandomInfraWalk"}], "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4dacab70-df79-4119-911e-200b28291cce"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"818991ae-c7ec-488a-8a6c-4f875873af80"]
}, Open  ]],

Cell[TextData[{
 "Under ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3dbd3b9-f8ce-4399-8f5b-8a0dc025475e"],
 " the weights are ignored, so a soft rule changes nothing: the walk is the \
canonical walk of the hard rules."
}], "ExampleText",ExpressionUUID->"a9b7eba6-937b-4bc1-9712-dc3af4276be3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"RandomInfraWalk", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", 
       RowBox[{"{", "4", "}"}], ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Simple\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<Shortest\>\"", ",", " ", "3", ",", " ", "0.01"}], 
           "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]}], 
      "]"}], " ", "===", "\n", "    ", 
     RowBox[{"RandomInfraWalk", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", 
       RowBox[{"{", "4", "}"}], ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Simple\>\"", "}"}]}]}], "]"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"629f845b-e58b-4115-908b-db422c3e759d"],

