Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraWalk", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6e981cb9-494f-46a2-ac7a-d5b165bb72db"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d3921a6-bdab-4f39-b7b7-fd57afb03cdc"],
 "\[LineSeparator]",
 "gives a random walk grown from ",
 StyleBox["germ", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " by at most the budget ",
 StyleBox["k", "TI"],
 " of edges, each step under the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Properties"]], "paclet:ref/Properties"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "97f48b6b-decb-48d9-8eae-a5d6c92b5320"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"bd066e3d-8253-4b5b-b3eb-9fb2c5a2bac1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["k", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e46d87b-3a34-4d2e-b384-f6c082ed2b56"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " distinct walks.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4a63adeb-186e-4524-a0b2-48108e7366ff"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64d5427d-de07-4d57-814d-816072ba20d5"],
 "\[LineSeparator]",
 "grows the walk with no budget, until no admissible step remains or the \
stopping condition fires."
}], "Usage",ExpressionUUID->"2d592b40-264f-43f1-aa82-b117148b86ef"],

Cell[TextData[{
 "The germ is a vertex, a vertex list or a walk graph; a list of germs gives \
the walks grown from each. A walk is returned as a directed path graph on the \
pairs {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "}; ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5b03e95-dd57-4dda-bad2-9d512e73ef47"],
 " is its vertex sequence."
}], "Notes",ExpressionUUID->"01341bd8-0b22-4c9e-8c6e-94988b7f407c"],

Cell[TextData[{
 "The budget ",
 StyleBox["k", "TI"],
 " counts the edges added on each growing side: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a68f72a-04d6-4cf9-9136-b3e264226e85"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de73f793-116f-49b6-aa30-04cf40cf3651"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"kmin", ",", " ", "kmax"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80eb8094-f8d3-4238-88fe-4bffb86ea37a"],
 " or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "957c5c8e-be81-4d55-badb-f04677fe9409"],
 ". ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7df00cea-3683-4adf-b25d-892f04ecee2d"],
 " needs ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc3bc60b-a17c-4650-b5c4-16a25c60ff78"],
 " or ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40c3268f-71b7-4277-a40e-c5d9dd1e8e6a"],
 " on the whole walk, which bound the walks."
}], "Notes",ExpressionUUID->"724321e8-fe5a-4489-9f17-e1e5759c2f0c"],

Cell[TextData[{
 "Each step chooses the next vertex among the neighbours of the last one, the \
candidates. A property is a name, bare or with its sub-options, ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<name\>\"", ",", " ", 
    RowBox[{"\"\<Window\>\"", " ", "->", " ", "r"}], ",", " ", 
    "\[Ellipsis]"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4495a4ba-ce91-44a6-8c0b-ce794a331019"],
 ". It reads the ",
 StyleBox["window", "TI"],
 " of a candidate ",
 StyleBox["v", "TI"],
 ": the last ",
 StyleBox["r", "TI"],
 " vertices of the walk followed by ",
 StyleBox["v", "TI"],
 ", so a window of scale ",
 StyleBox["r", "TI"],
 " has ",
 StyleBox["r", "TI"],
 " edges; ",
 StyleBox["r", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85a0fe35-0f5c-41fa-afb1-f5f9e7434d97"],
 ", the default, is the whole walk."
}], "Notes",ExpressionUUID->"0c68a17d-84ce-43ca-9f73-d0b882062d86"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9581ab9d-d07b-4be1-bf33-f61decdee897"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"e7feea96-db8b-4fcb-bab4-a2c1a244612c"],
     Cell["Effect", "TableText",
     FontWeight->Bold,ExpressionUUID->"c5832252-7a35-49cd-a5f4-a0b69ff9e5d5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b64726e3-3de7-4e97-865f-e9033cd7df87"], Cell[TextData[Cell[
    BoxData["\"\<Simple\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9d5807fc-b7c3-4d10-9727-08074d08fa0a"]], "TableText",ExpressionUUID->
     "73d3a335-eabf-4ff5-8878-3968c9db95cc"], Cell[
    "no vertex twice in the window", "TableText",ExpressionUUID->
     "0de46a24-f79b-4553-bbc9-f60eb8b01d65"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "718f7eae-adc7-48ce-8f7c-e0dab0aab612"], Cell[TextData[Cell[
    BoxData["\"\<Geodesic\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "77698c1f-7758-4d91-9c44-ed87ad62d3f0"]], "TableText",ExpressionUUID->
     "cb5b14f3-465b-4da8-b36c-321d9cc5a15a"], Cell[TextData[{
     "every window a shortest path, the walks of ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["RandomInfraGeodesic"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "b3b53a34-a906-4c70-a5e2-531353c07659"]
    }], "TableText",ExpressionUUID->"6f6769f7-9032-460e-9056-0c59bbaea044"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "30e9ee13-c7d0-4d8e-828f-81152c1810ef"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", 
      RowBox[{"\"\<Geodesic\>\"", ",", " ", 
       RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "\[Beta]"}]}], "}"}]], 
     "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "71b96937-b5b9-453d-8b20-daab271e84cb"]], "TableText",ExpressionUUID->
     "e9f01934-682f-4132-8af1-bc8da2ef024e"], Cell[TextData[{
     "each step prefers the straightest continuation: a candidate is weighed ",
     Cell[BoxData[
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]"}], "]"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0414ebef-0f98-4bae-b8a2-39a541f3ab55"],
     ", \[CapitalDelta] its excess energy, below"
    }], "TableText",ExpressionUUID->"86e5f29a-7dda-40f5-95b3-b76b83f179da"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "08a41426-70bb-4ba8-a3fb-26858bf3d553"], Cell[TextData[StyleBox[
    "f", "TI"]], "TableText",ExpressionUUID->
     "a4dc88c6-a1ea-4ece-ac48-67f9af015b6b"], Cell[TextData[{
     "the energy ",
     Cell[BoxData[
      RowBox[{"f", "[", "window", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a1ba0e18-0137-4a5e-9f4a-a2ffbff5a3bc"],
     " \[GreaterEqual] 0: a candidate is weighed ",
     Cell[BoxData[
      RowBox[{"Exp", "[", 
       RowBox[{"-", "\[CapitalDelta]"}], "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2ad5c416-df8d-4ef2-a46e-8a340df5ebc8"],
     ", the scale inside ",
     StyleBox["f", "TI"],
     "; ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "95cc486b-8233-4f02-92be-f9079ddeb96b"],
     " forbids the window, and a predicate reads ",
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6d794ced-2aa5-4461-8b52-18794f3db394"],
     " as 0 and ",
     Cell[BoxData["False"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1f0f0ef0-4154-42b5-8f30-887415fdda04"],
     " as ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "fbff5667-8b53-41e2-9b14-23e0114eca40"],
     ", so it is a constraint"
    }], "TableText",ExpressionUUID->"5873075a-05c5-49df-86f0-bd14d887aad2"]}
  }]], "2ColumnTableMod",ExpressionUUID->"2201f09d-8b8f-4c9f-844f-\
a228eac58847"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e7df08e2-42b3-4714-b578-e1dfbdad3c28"], Cell["Sub-option", "TableText",
     FontWeight->Bold,ExpressionUUID->"9000cb50-2d47-429a-b780-7984bee06526"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"fae4da76-176c-465a-9a83-7d236052a7a5"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"908fa324-2558-4c40-8347-f9d1530b4dbd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1dfac5f5-6583-46d0-afc7-ed6d114078d4"], Cell[TextData[Cell[
    BoxData["\"\<Window\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "61726fe3-9c9b-4b67-8722-411178b3acfe"]], "TableText",ExpressionUUID->
     "e58f5c95-7e93-4320-87bb-f79073a08e12"], Cell[TextData[Cell[BoxData[
    "Infinity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ba5ce812-0d16-44a1-ab3a-b15057869761"]], "TableText",ExpressionUUID->
     "07271917-9563-4513-abc9-96a2f5d04428"], Cell[TextData[{
     "a positive integer ",
     StyleBox["r", "TI"],
     ", the window of scale ",
     StyleBox["r", "TI"]
    }], "TableText",ExpressionUUID->"d5d6c3e1-1a48-4883-9960-0b46def6ef90"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b824fcd1-d47f-48ca-ac80-aa5e17d994e9"], Cell[TextData[Cell[
    BoxData["\"\<Straightness\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b1383efd-038a-4e44-909d-78b0bc8bae44"]], "TableText",ExpressionUUID->
     "7c2a70f3-5675-464f-8f4f-70465c8bf89a"], Cell[TextData[Cell[BoxData[
    "Infinity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "01cd516d-1259-45cc-8d6d-eb57d1330008"]], "TableText",ExpressionUUID->
     "f19c8164-374c-4ba8-b9bb-a0c246d963d5"], Cell[TextData[{
     "on ",
     Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "75eea487-ae70-4085-a059-aa27a9a248c1"],
     ", a non-negative number ",
     StyleBox["\[Beta]", "TI"],
     "; ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "06529d8f-2093-4f0b-afb4-59c28dc94e3a"],
     " is the shortest path"
    }], "TableText",ExpressionUUID->"79a653ec-c1e0-4d90-b4ee-a3401a260525"]}
  }]], "3ColumnTableMod",ExpressionUUID->"f2c84488-7eee-4c62-839f-\
a6e4347796eb"],

Cell["The properties act in the order given.", "Notes",ExpressionUUID->"08c9f419-b7aa-4bf9-a873-e1d41564791d"],

Cell[TextData[{
 StyleBox["The gain.",
  FontWeight->"Bold"],
 " Let (",
 StyleBox["w", "TI"],
 "\:2080, \[Ellipsis], ",
 StyleBox["w", "TI"],
 "\:209c) be the window before the step, its tip ",
 StyleBox["w", "TI"],
 "\:209c the last vertex of the walk. A candidate ",
 StyleBox["v", "TI"],
 " changes the distance to each earlier vertex ",
 StyleBox["w\:1d62", "TI"],
 " by its ",
 StyleBox["gain", "TI"]
}], "Notes",ExpressionUUID->"391426b4-5102-41fa-b482-eb78759e7e18"],

Cell[TextData[{
 "  ",
 StyleBox["g\:1d62", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w\:1d62", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") \[Minus] ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w\:1d62", "TI"],
 ", ",
 StyleBox["w\:209c", "TI"],
 ") \[Element] {\[Minus]1, 0, 1}:"
}], "Notes",ExpressionUUID->"f0f048ac-e669-4e2b-91e4-b0f4e5ebd2b6"],

Cell[TextData[{
 "1 when ",
 StyleBox["v", "TI"],
 " moves away from ",
 StyleBox["w\:1d62", "TI"],
 ", 0 when it keeps the distance, \[Minus]1 when it comes back. The ",
 StyleBox["mean gain", "TI"]
}], "Notes",ExpressionUUID->"f36f65b6-2af1-4839-9586-5ba5b4a986e3"],

Cell[TextData[{
 "  ",
 StyleBox["g", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = (",
 StyleBox["g", "TI"],
 "\:2080(",
 StyleBox["v", "TI"],
 ") + ",
 StyleBox["g", "TI"],
 "\:2081(",
 StyleBox["v", "TI"],
 ") + \[CenterEllipsis] + ",
 StyleBox["g", "TI"],
 "\:209c\:208b\:2081(",
 StyleBox["v", "TI"],
 ")) / ",
 StyleBox["t", "TI"]
}], "Notes",ExpressionUUID->"255ca1f0-f07e-4bab-96c7-122ce98583f4"],

Cell[TextData[{
 "lies between \[Minus]1 and 1, and is 1 exactly when ",
 StyleBox["v", "TI"],
 " moves away from every earlier vertex of the window. The tip itself is left \
out: its gain is always 1."
}], "Notes",ExpressionUUID->"7def43b8-1f8d-49a0-bddc-2e11c75cf4b9"],

Cell[TextData[{
 StyleBox["The energy and the weight.",
  FontWeight->"Bold"],
 " The energy of ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6918383-b6c2-4bad-b8ae-9194d55c99ec"],
 " is ",
 StyleBox["E", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = 1 \[Minus] ",
 StyleBox["g", "TI"],
 "(",
 StyleBox["v", "TI"],
 "), between 0 and 2, and 0 while the window is the tip alone. The excess \
energy of ",
 StyleBox["v", "TI"],
 " is its energy against the best candidate ",
 StyleBox["u", "TI"],
 " of the step,"
}], "Notes",ExpressionUUID->"9f5ca0e5-1ea8-405a-88da-b4cb826fd2bc"],

Cell[TextData[{
 "  \[CapitalDelta](",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["E", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") \[Minus] min_",
 StyleBox["u", "TI"],
 " ",
 StyleBox["E", "TI"],
 "(",
 StyleBox["u", "TI"],
 "),"
}], "Notes",ExpressionUUID->"feb607a0-8c5d-4537-b152-ec25a22c9052"],

Cell[TextData[{
 "and the step draws ",
 StyleBox["v", "TI"],
 " with probability ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]", 
    RowBox[{"(", "v", ")"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10a3baab-8bf6-483b-986f-0d30f936f840"],
 " divided by the sum of ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]", 
    RowBox[{"(", "u", ")"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32164834-7c0a-4549-bf74-5d74b0295882"],
 " over the candidates: a Boltzmann weight at inverse temperature ",
 StyleBox["\[Beta]", "TI"],
 ". Only differences of energies matter, so ranking by the mean gain is \
ranking by the total distance ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w", "TI"],
 "\:2080, ",
 StyleBox["v", "TI"],
 ") + \[CenterEllipsis] + ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w", "TI"],
 "\:209c\:208b\:2081, ",
 StyleBox["v", "TI"],
 ") to the window, and the exponential is the only weight with this property. \
The mean, not the sum, keeps the cost of a turn independent of the length of \
the window."
}], "Notes",ExpressionUUID->"96662154-22e9-49d7-b831-03859a25a76a"],

Cell[TextData[{
 StyleBox["The turning angle.",
  FontWeight->"Bold"],
 " Suppose the path distance is close to a rounding of the Euclidean one, the \
window is straight, and the window is not aligned with the mesh. Then for a \
candidate turning by the angle ",
 StyleBox["\[Theta]", "TI"],
 " the mean gain is about cos ",
 StyleBox["\[Theta]", "TI"],
 ": the Euclidean gain against every earlier vertex is cos ",
 StyleBox["\[Theta]", "TI"],
 " up to order 1/",
 StyleBox["s", "TI"],
 ", ",
 StyleBox["s", "TI"],
 " its distance to the tip, and the roundings up and down balance along the \
window. The weight of a step is then about ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{"\[Beta]", " ", "cos", " ", "\[Theta]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a032d39-ec15-42fd-9b29-788194d3d636"],
 ", the von Mises distribution in the turning angle, and for large ",
 StyleBox["\[Beta]", "TI"],
 " about ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", "\[Beta]"}], " ", 
    RowBox[{
     RowBox[{"\[Theta]", "^", "2"}], "/", "2"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c85c56c1-2d8d-44c2-91d8-585772554f4b"],
 ", a Gaussian of variance 1/",
 StyleBox["\[Beta]", "TI"],
 ". So ",
 StyleBox["\[Beta]", "TI"],
 " is a bending rigidity: turns of order 1/\[Sqrt]",
 StyleBox["\[Beta]", "TI"],
 " are typical. For a window aligned with the mesh the roundings do not \
balance and the mean gain is a step function of ",
 StyleBox["\[Theta]", "TI"],
 ", not the cosine."
}], "Notes",ExpressionUUID->"5af1178d-943b-492b-b65a-b0a8d0a4a6d6"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a5567dfc-167e-44a2-86ee-b010c796744d"], Cell[TextData[StyleBox[
    "\[Beta]", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"2b2eecab-289d-476e-8ee0-f236718befdf"],
     Cell["The walk", "TableText",
     FontWeight->Bold,ExpressionUUID->"c2b0c13e-e5b8-418a-bf35-f6bf13e55438"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "634b2384-5abf-4d2f-9a34-aa757a0b187b"], Cell[
    "0", "TableText",ExpressionUUID->"781da000-786b-4291-8ae4-2c1f9ac82dc8"], 
    Cell["the plain random walk: every candidate weighs alike", "TableText",
     ExpressionUUID->"20e2769d-5046-48a2-bdb8-7f8ea5429c27"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a9f7c127-700c-4a7b-81c1-361d8e5f8c6d"], Cell[
    "2", "TableText",ExpressionUUID->"3aa7094c-491a-4bec-940d-788d300ceda0"], 
    Cell["wanders, with a preference for going on", "TableText",
     ExpressionUUID->"d831e7dc-a7bb-47ab-8b3f-c21b5d7807f3"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8815deaa-f742-4f8c-8fec-4eaa5c3769df"], Cell[
    "8", "TableText",ExpressionUUID->"1663ad27-5a2a-4b70-a3a6-337a401adfe7"], 
    Cell["bends by about 20\[Degree] per step", "TableText",ExpressionUUID->
     "a274ac63-da51-4b62-9c21-834e872ba69f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d113ac53-209a-4bea-82c5-6042c6cd5c4b"], Cell[
    "32", "TableText",ExpressionUUID->"2a56c11d-923b-480e-9741-feb50454f2ff"],
     Cell["nearly straight", "TableText",ExpressionUUID->
     "fc06835a-8c82-4bbc-b653-cb31deb9aa4a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "64495ab3-81b7-42fb-939d-3704b42c8646"], Cell[TextData[{
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c17cde5d-a21f-4e50-922f-987bae72d5d2"],
     ", the default"
    }], "TableText",ExpressionUUID->"dcc0bf89-a6e2-42f5-a4d0-054d905ae957"], 
    Cell["\<\
a shortest path: every step has energy 0, and the walk backtracks where no \
candidate has\
\>", "TableText",ExpressionUUID->"d12ce8e5-ba3e-4f94-a3f7-12a0867829a7"]}
  }]], "2ColumnTableMod",ExpressionUUID->"4fc98ca6-146a-4952-8834-\
0b202f190fc5"],

Cell[TextData[{
 "A walk is a shortest path at scale ",
 StyleBox["r", "TI"],
 " (",
 Cell[BoxData[
  RowBox[{"InfraGeodesicQ", "[", 
   RowBox[{"g", ",", " ", "walk", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c79413c-a920-489c-9ff2-5f3703552514"],
 ") exactly when every step moves away from all the earlier vertices of its \
window, that is when ",
 StyleBox["E", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = 0 at every step: this is ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce85135a-8135-48da-b197-b93c7baeabe2"],
 " with no straightness given. A large finite ",
 StyleBox["\[Beta]", "TI"],
 " takes such a step whenever one exists, and otherwise the least bent one."
}], "Notes",ExpressionUUID->"5b3768fd-e8fc-4974-b34c-946dbdc6572a"],

Cell[TextData[{
 "Under ",
 Cell[BoxData[
  RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<BothSides\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e9bdabd-604d-4d34-ba3f-b4429794d182"],
 " the window of a step is the joined walk: a step at both ends draws the new \
first vertex on the whole walk, then the new last vertex on the whole walk \
with that new first vertex, so the two halves are straight as one walk."
}], "Notes",ExpressionUUID->"4cc5e370-bb71-4983-aa2d-eb486f1a8672"],

Cell[TextData[{
 "The gain sees shortest paths, not Euclidean straightness. On the square \
grid every monotone staircase is a shortest path, and a turn by 90\[Degree] \
has gain 1 like the step straight on, so ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f170c2ca-6eea-496b-89cd-776e36d37e55"],
 " gives a random staircase, not a straight line; a walk straight in the \
Euclidean sense needs a substrate whose shortest paths are straight, such as \
the square mesh."
}], "Notes",ExpressionUUID->"77d64305-1c69-45f7-9686-12677a1e8c0e"],

Cell["Options:", "Notes",ExpressionUUID->"09570169-09fb-405e-a1de-1adb0b41e804"],

