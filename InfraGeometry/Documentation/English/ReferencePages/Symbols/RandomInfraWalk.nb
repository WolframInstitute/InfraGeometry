Cell[TextData[{
 "A function is a rule: the energy ",
 Cell[BoxData[
  RowBox[{"GraphDistance", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"Last", " ", "@", " ", "w"}], ",", " ", "q"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9a686353-5197-4391-9312-e0ece7f6186b"],
 " at window 1 and weight 0.3 pulls the walk toward ",
 StyleBox["q", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"f382cc28-83ed-4de1-b2cf-a5533e603434"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "6"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", "\n", "      ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RandomInfraWalk", "[", 
           RowBox[{"g", ",", " ", "a", ",", " ", 
            RowBox[{"{", "12", "}"}], ",", " ", 
            RowBox[{"Properties", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"w", " ", "|->", " ", 
                 RowBox[{"GraphDistance", "[", 
                  RowBox[{"g", ",", " ", 
                   RowBox[{"Last", " ", "@", " ", "w"}], ",", " ", "q"}], 
                  "]"}]}], ",", " ", "1", ",", " ", "0.3"}], "}"}], "}"}]}], ",",
             " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "seed"}]}], "]"}], ",", 
          " ", "a", ",", " ", "q"}], "}"}], ",", "\n", "      ", 
        RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"seed", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}]}], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"232f3855-aacb-4d39-9450-e495b868d89c"],

