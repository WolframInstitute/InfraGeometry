Cell[TextData[{
 "A fixed seed reproduces the draw, whatever state ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09cb4a7a-0b75-472d-8aa5-e279c7e3de24"],
 " has set:"
}], "ExampleText",ExpressionUUID->"c57b7951-7004-4a67-bb47-3f751a17e94f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "k", "]"}], ";", " ", 
    RowBox[{"Last", " ", "/@", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{
        RowBox[{"GridGraph", "[", 
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", "1", ",", " ", 
        RowBox[{"{", "6", "}"}], ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", "\"\<Simple\>\"", "}"}]}], ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], "]"}]}]}]}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "2"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6451b932-7617-4432-96d3-f321ba1ca3ac"],

