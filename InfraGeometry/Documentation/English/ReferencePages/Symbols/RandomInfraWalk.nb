Cell[TextData[{
 "A walk is a shortest path exactly when every step has defect 0. At ",
 StyleBox["\[Beta]", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4261b366-e0fd-4826-bb88-8aac6da9d10f"],
 " on the mesh some walks of 10 edges from the centre are, and some meet a \
vertex where no candidate has defect 0; the pairs agree. The exact shortest \
paths from a germ are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "af46e798-1322-4a3b-b66d-875b80f92872"],
 ":"
}], "ExampleText",ExpressionUUID->"5dddbdc7-12ad-4047-bffa-bc4de0e5d9ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"defect", " ", "=", " ", 
     RowBox[{"w", " ", "|->", " ", 
      RowBox[{"Total", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Length", "[", "w", "]"}], " ", "-", " ", "i"}], ")"}], 
          " ", "-", " ", 
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"w", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
            RowBox[{"Last", "[", "w", "]"}]}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{
            RowBox[{"Length", "[", "w", "]"}], " ", "-", " ", "1"}]}], 
          "}"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"w", " ", "=", " ", 
         RowBox[{"Last", " ", "/@", " ", 
          RowBox[{"VertexList", " ", "@", " ", 
           RowBox[{"RandomInfraWalk", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", 
             RowBox[{"{", "10", "}"}], ",", " ", 
             RowBox[{"Properties", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<Simple\>\"", ",", " ", 
                
                RowBox[{"\"\<Straightness\>\"", " ", "->", " ", 
                 "Infinity"}]}], "}"}]}], ",", " ", 
             RowBox[{"RandomSeeding", " ", "->", " ", "s"}]}], "]"}]}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"defect", " ", "@", " ", 
              RowBox[{"Take", "[", 
               RowBox[{"w", ",", " ", "k"}], "]"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"k", ",", " ", "2", ",", " ", 
               RowBox[{"Length", "[", "w", "]"}]}], "}"}]}], "]"}], ",", " ", 
           
           RowBox[{
            RowBox[{"#", " ", "==", " ", "0"}], " ", "&"}]}], "]"}], ",", " ", 
         RowBox[{"InfraGeodesicQ", "[", 
          RowBox[{"g", ",", " ", "w"}], "]"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7303f787-a039-404d-9d3b-66039e25aa2c"],

