   {Cell["      ", "ModInfo",ExpressionUUID->
     "fa46dd5f-6158-4866-a995-71341e4a2395"], Cell[TextData[Cell[
    BoxData["\"\<StoppingCondition\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1f3b145c-2345-40c8-8161-0d520016d795"]], "TableText",ExpressionUUID->
