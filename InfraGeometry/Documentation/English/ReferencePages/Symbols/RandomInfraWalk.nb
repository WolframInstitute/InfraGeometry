Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraWalk", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"aca4fdca-eadb-44c2-aff5-6aa92a77e5a3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b102320-2fe9-4bfb-90cd-64513b4efce5"],
 "\[LineSeparator]",
 "gives a random walk grown from ",
 StyleBox["germ", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " by at most the budget ",
 StyleBox["k", "TI"],
 " of edges, each step under the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Properties"]], "paclet:ref/Properties"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2deed1c3-6232-4f11-8227-68995506b40d"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"07c4f850-227f-49cc-a318-d006aeeb01ac"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["k", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b1f96ea-caf3-4153-85c0-fe389fb06e2d"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " distinct walks.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d7c40ca6-f256-4d22-b117-39e1aed155fa"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e1ca4e1-f196-47c8-933a-ab08c1b82322"],
 "\[LineSeparator]",
 "grows the walk with no budget, until no admissible step remains or the \
stopping condition fires."
}], "Usage",ExpressionUUID->"97eb126b-fda2-465e-af46-9423cdf540fc"],

Cell[TextData[{
 "The germ is a vertex, a vertex list or a walk graph; a list of germs gives \
the walks grown from each. A walk is returned as a directed path graph on the \
pairs {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "}; ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ed700cc-ad7f-469a-bda3-26b81b2bea07"],
 " is its vertex sequence."
}], "Notes",ExpressionUUID->"78fdd8ce-3487-4255-ba64-e9fc3d9f2f11"],

Cell[TextData[{
 "The budget ",
 StyleBox["k", "TI"],
 " counts the edges added on each growing side: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "faf947fe-f681-4d83-a261-8ce31466c0ff"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9357b5dc-112a-42ef-8ec8-4ce3ba949854"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"kmin", ",", " ", "kmax"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e65f378c-aa74-42a1-93b8-f513c3350ec5"],
 " or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffff1c06-3a3a-451a-ab5c-9d89df040c36"],
 ". ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5228ab83-8ade-45a9-b667-dd129132cf54"],
 " needs the bare ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41c08f96-c643-43f1-866b-543f8fbaf193"],
 ", which bounds the walks."
}], "Notes",ExpressionUUID->"d5c1e2f5-edfb-47da-a4c7-38cc71df5c44"],

Cell[TextData[{
 "Each step chooses the next vertex among the neighbours of the last one, the \
candidates. A property reads the ",
 StyleBox["window", "TI"],
 " of a candidate ",
 StyleBox["v", "TI"],
 ": the last ",
 StyleBox["r", "TI"],
 " vertices of the walk followed by ",
 StyleBox["v", "TI"],
 ", so a window of scale ",
 StyleBox["r", "TI"],
 " has ",
 StyleBox["r", "TI"],
 " edges; ",
 StyleBox["r", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d3c6779-32d4-48d5-ad6a-35e7c83520bd"],
 ", the default, is the whole walk."
}], "Notes",ExpressionUUID->"0b6dbc77-ecf1-4e39-a670-8e73f2dcd2c8"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "093c7a37-edbf-48bd-8cac-70b48efa4c3f"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"a535575a-cd9f-4230-afec-7b64aec359d3"],
     Cell["Effect", "TableText",
     FontWeight->Bold,ExpressionUUID->"ae2c6b93-5c53-4832-a74a-9e0b88228958"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7af4f51f-e6cf-4965-bd07-55ff61f7f222"], Cell[TextData[Cell[
    BoxData["\"\<Simple\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "99546ada-0332-42f5-bdf4-7656e3f62b00"]], "TableText",ExpressionUUID->
     "08f56b63-dce2-4506-a5a0-c5f1b32d65e8"], Cell[TextData[{
     "no vertex twice; ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Simple\>\"", ",", " ", "r"}], "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e4e8f311-1c75-4235-94c2-9e6c56eb7d73"],
     " no vertex twice within the window, ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Simple\>\"", ",", " ", "r", ",", " ", "p"}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a77df867-ef47-44b3-a206-c5dec6045434"],
     " a repeat weighed ",
     StyleBox["p", "TI"],
     " instead of forbidden"
    }], "TableText",ExpressionUUID->"a88f253b-9b62-46c5-b048-25db85c74c37"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9133be4d-4653-4751-afdb-cd93f6af4c6b"], Cell[TextData[Cell[BoxData[
     RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "\[Beta]"}]], 
     "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "037dab5a-9552-48eb-a7e6-cba2dcad19eb"]], "TableText",ExpressionUUID->
     "caf80fcd-6e45-41ba-b74d-e6896d7c1a71"], Cell[TextData[{
     "each step prefers the straightest continuation: a candidate is weighed ",
     Cell[BoxData[
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]"}], "]"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7a09680e-5c91-48d7-86ad-0cb3007453ac"],
     ", \[CapitalDelta] its excess defect, below"
    }], "TableText",ExpressionUUID->"27a17b87-e996-4e62-a685-3fccc7eca5f7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9f2d11c1-7bc2-4b6d-a404-c94364cefbb5"], Cell[TextData[Cell[BoxData[
     RowBox[{"\"\<Straightness\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\[Beta]", ",", " ", "r"}], "}"}]}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "10cee1ce-da4c-43b1-a923-03e468542da3"]], "TableText",ExpressionUUID->
     "e8f75d8f-397c-436c-8ba4-bd7c3943d1cc"], Cell[TextData[{
     "the same on the window of scale ",
     StyleBox["r", "TI"]
    }], "TableText",ExpressionUUID->"01c4f904-a0cc-4962-a4ae-5c353e6e4ddd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2f4d2e3d-57b1-437f-b8d1-d57f279e94a6"], Cell[TextData[{
     StyleBox["f", "TI"],
     " ",
     Cell[BoxData[
      RowBox[{"->", " ", "\[Beta]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "516d0fcb-b53c-48a6-a3d7-06a3c07dcb3d"],
     ", ",
     StyleBox["f", "TI"],
     " ",
     Cell[BoxData[
      RowBox[{"->", " ", 
       RowBox[{"{", 
        RowBox[{"\[Beta]", ",", " ", "r"}], "}"}]}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "74321c2d-6282-4ec3-ba02-42287eedc5c4"]
    }], "TableText",ExpressionUUID->"163b9ca7-6c40-43a2-bba4-4f1ebce35cac"], 
    Cell[TextData[{
     "the energy ",
     Cell[BoxData[
      RowBox[{"f", "[", "window", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9251dcca-6853-4c6d-b778-a62d162644a5"],
     " \[GreaterEqual] 0 in place of the defect; ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "644666dc-b96a-4828-bfef-31aa7f5af04d"],
     " forbids the window, and a predicate reads ",
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8540a382-a3c8-4a3c-a9d2-45a7d6066ad9"],
     " as 0 and ",
     Cell[BoxData["False"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f398058d-3f9d-4d7c-821f-c9cc7fb814be"],
     " as ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a6e6538c-9886-4526-8b00-2874a1111bba"]
    }], "TableText",ExpressionUUID->"68b96b65-ebd3-48d6-bfeb-62af4fbed105"]}
  }]], "2ColumnTableMod",ExpressionUUID->"41aea94a-c057-4b82-85a4-\
2ccb3e19b9e4"],

Cell[TextData[{
 StyleBox["\[Beta]", "TI"],
 " is a non-negative number or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "251e6feb-0fb8-4e77-aacc-235feec208a6"],
 ". The properties act in the order given."
}], "Notes",ExpressionUUID->"5595a811-b3da-40e0-bd3f-6755d0a935d9"],

Cell[TextData[{
 StyleBox["The defect.",
  FontWeight->"Bold"],
 " For a window ",
 StyleBox["w", "TI"],
 " = (",
 StyleBox["w", "TI"],
 "\:2081, \[Ellipsis], ",
 StyleBox["w", "TI"],
 "\:2098) the piece from ",
 StyleBox["w\:1d62", "TI"],
 " to the end has ",
 StyleBox["m", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 " edges, and its defect"
}], "Notes",ExpressionUUID->"2a60b54f-7cbf-4ee0-ad91-b428e4803f01"],

Cell[TextData[{
 "  ",
 StyleBox["D\:1d62", "TI"],
 "(",
 StyleBox["w", "TI"],
 ") = (",
 StyleBox["m", "TI"],
 " \[Minus] ",
 StyleBox["i", "TI"],
 ") \[Minus] ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w\:1d62", "TI"],
 ", ",
 StyleBox["w\:2098", "TI"],
 ")"
}], "Notes",ExpressionUUID->"207fd41d-0609-411b-aa97-13d5c9ebe642"],

Cell["\<\
is the number of edges it wastes against a shortest path: 0 exactly when that \
piece is a shortest path. The defect of the window is the sum over its \
vertices,\
\>", "Notes",ExpressionUUID->"50cf58fe-1a7f-44cb-908a-c827321f0341"],

Cell[TextData[{
 "  ",
 StyleBox["D", "TI"],
 "(",
 StyleBox["w", "TI"],
 ") = ",
 StyleBox["D", "TI"],
 "\:2081(",
 StyleBox["w", "TI"],
 ") + ",
 StyleBox["D", "TI"],
 "\:2082(",
 StyleBox["w", "TI"],
 ") + \[CenterEllipsis] + ",
 StyleBox["D", "TI"],
 "\:2098\:208b\:2081(",
 StyleBox["w", "TI"],
 "),"
}], "Notes",ExpressionUUID->"6eb8051f-26d9-4b44-be9f-3f5e764f0385"],

Cell[TextData[{
 "0 exactly when the window is a shortest path, and positive for a bend at \
any scale up to ",
 StyleBox["r", "TI"],
 "."
}], "Notes",ExpressionUUID->"af9b5afc-3413-481b-a7d9-3a6de6f328fb"],

Cell[TextData[{
 StyleBox["The excess defect.",
  FontWeight->"Bold"],
 " Appending a candidate ",
 StyleBox["v", "TI"],
 " to the window changes the term of each earlier vertex ",
 StyleBox["w\:1d62", "TI"],
 " by 0 when ",
 StyleBox["v", "TI"],
 " is farther from ",
 StyleBox["w\:1d62", "TI"],
 " than the last vertex is, by 1 when it is as far, and by 2 when it is \
nearer. The excess defect of ",
 StyleBox["v", "TI"],
 " is its defect against the best candidate ",
 StyleBox["u", "TI"],
 " of the step,"
}], "Notes",ExpressionUUID->"5464c728-cd9f-49b1-a08b-e1339247bd70"],

Cell[TextData[{
 "  \[CapitalDelta](",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["D", "TI"],
 "(",
 StyleBox["w", "TI"],
 " + ",
 StyleBox["v", "TI"],
 ") \[Minus] min_",
 StyleBox["u", "TI"],
 " ",
 StyleBox["D", "TI"],
 "(",
 StyleBox["w", "TI"],
 " + ",
 StyleBox["u", "TI"],
 "),"
}], "Notes",ExpressionUUID->"78f1852e-bebb-4e20-8ed9-165a801c4aea"],

Cell[TextData[{
 "so \[CapitalDelta] counts, against the best candidate, the earlier vertices \
of the window that the step does not move away from. The step draws ",
 StyleBox["v", "TI"],
 " with probability ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]", 
    RowBox[{"(", "v", ")"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44b1524e-69cb-455f-b16e-2b63a3edd0fc"],
 " divided by the sum of ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]", 
    RowBox[{"(", "u", ")"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fba727a6-47dc-40d7-923a-cc2a8a5e55fd"],
 " over the candidates: a Boltzmann weight at inverse temperature ",
 StyleBox["\[Beta]", "TI"],
 "."
}], "Notes",ExpressionUUID->"70769a6a-d234-4c08-a140-a22cdac312e4"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "54394985-ad17-43c8-8a78-932a1d12351e"], Cell[TextData[StyleBox[
    "\[Beta]", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"95d33ace-86b0-4324-903a-0a742522b85a"],
     Cell["The walk", "TableText",
     FontWeight->Bold,ExpressionUUID->"9c513b44-33b3-4886-92dd-0da54e89f21f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2e122b12-7a6c-4df0-bb8a-440cd35fc8d6"], Cell[
    "0", "TableText",ExpressionUUID->"83a05678-897b-4e71-a539-a3e0adab3c4c"], 
    Cell["the plain random walk: every candidate weighs alike", "TableText",
     ExpressionUUID->"e1a4dce0-d594-4a8b-8956-453681fc2f25"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "451e2d31-b432-4a75-bace-fbb620b2aab7"], Cell[
    "1", "TableText",ExpressionUUID->"3a7b62aa-0fa8-4bb0-abf5-7d3cc079f4b0"], 
    Cell["wanders, with a preference for going on", "TableText",
     ExpressionUUID->"eb48ede6-a2c4-402c-815d-ba34394005d3"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9860cae0-122e-4363-8739-c004521bfdfe"], Cell[
    "5", "TableText",ExpressionUUID->"d8dc4cc1-2b9a-4efa-a6e8-35c3d0b5ec4d"], 
    Cell["nearly straight", "TableText",ExpressionUUID->
     "791536e2-63a0-42e4-b5fc-06ac89001151"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d16d31db-3ae8-4e8b-a8e8-ac04153a6fb6"], Cell[TextData[Cell[BoxData[
    "Infinity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0ace4fcf-ef53-4f3b-9b52-1f57cb841cc3"]], "TableText",ExpressionUUID->
     "bd184c3a-8818-4d78-82cf-2b5e88032bc7"], Cell["\<\
always a candidate of \[CapitalDelta] = 0; straightness never ends the walk, \
since some candidate always has \[CapitalDelta] = 0\
\>", "TableText",ExpressionUUID->"08238725-8073-4a39-88be-1422d816ad0c"]}
  }]], "2ColumnTableMod",ExpressionUUID->"c2ff1620-ce0f-40a2-bf1f-\
8d23867f7e4d"],

Cell[TextData[{
 "A walk is a shortest path at scale ",
 StyleBox["r", "TI"],
 " (",
 Cell[BoxData[
  RowBox[{"InfraGeodesicQ", "[", 
   RowBox[{"g", ",", " ", "walk", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbc62237-0348-4122-861d-5fef961fab37"],
 ") exactly when every step moves away from all the earlier vertices of its \
window, that is when ",
 StyleBox["D", "TI"],
 "(",
 StyleBox["w", "TI"],
 " + ",
 StyleBox["v", "TI"],
 ") = 0 at every step; at ",
 StyleBox["\[Beta]", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72bcafdf-c686-43cf-9b6b-dd4c9e18e57f"],
 " the walk takes such a step whenever one exists."
}], "Notes",ExpressionUUID->"33e1432a-5320-4abe-b999-0321a20121c7"],

Cell[TextData[{
 "Under ",
 Cell[BoxData[
  RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<BothSides\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1a3ee37-d612-404e-81fe-332c6941a105"],
 " the window of a step is the joined walk: a step at both ends draws the new \
first vertex on the whole walk, then the new last vertex on the whole walk \
with that new first vertex, so the two halves are straight as one walk."
}], "Notes",ExpressionUUID->"e318e66a-a13f-4e16-890d-8dcde49217d2"],

Cell[TextData[{
 "The defect sees shortest paths, not Euclidean straightness. On the square \
grid every monotone staircase is a shortest path, so at ",
 StyleBox["\[Beta]", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bace1d82-c8f0-40c7-bd28-1890b3aa2cbb"],
 " the walk is a random staircase, not a straight line; a walk straight in \
the Euclidean sense needs a substrate whose shortest paths are straight, such \
as the square mesh."
}], "Notes",ExpressionUUID->"7cb02e81-f757-4359-bb39-5311a66bf82d"],

Cell["Options:", "Notes",ExpressionUUID->"8caa28b0-b8cf-41d4-a4d8-3b06c34803e9"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1bfd70f4-d3a4-4831-81ee-0a6c76c8e281"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"5793fe63-89c8-4884-83bf-67f38ada4161"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"518aff9c-97c5-4834-abe1-1597a294fabe"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"1c857f69-2283-4c29-bed4-1f5389b515cb"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "653ed31c-afa7-4af7-86bf-3abe67f39186"], Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["Properties"]], "paclet:ref/Properties"},
      "RefLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "b6368077-25d6-46ec-9b18-7eb0fb5cfb9d"]], "TableText",ExpressionUUID->
     "84ffb4e0-7ddb-4ddb-b62c-d66b3bd1750f"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9927fb87-3613-4c0e-9725-494b6e8c08f2"]], "TableText",ExpressionUUID->
     "1a523869-031e-4678-a5f3-334aa710e3c5"], Cell[TextData[{
     "the list of properties; ",
     Cell[BoxData[
      RowBox[{"{", "}"}]], "InlineFormula",
