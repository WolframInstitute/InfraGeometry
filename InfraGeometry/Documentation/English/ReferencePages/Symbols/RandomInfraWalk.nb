Cell[TextData[{
 "At both ends the straightness reads the joined walk: 8 edges on each side \
of the centre of the square mesh at ",
 StyleBox["\[Beta]", "TI"],
 " = 5 make one nearly straight walk of 16 edges; the label is the distance \
of its ends:"
}], "ExampleText",ExpressionUUID->"60d64e27-f893-40f6-bff9-fc896f47fd73"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walk", " ", "=", " ", 
     RowBox[{"RandomInfraWalk", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"{", "8", "}"}], ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Simple\>\"", ",", " ", 
          RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "5"}]}], "}"}]}], ",",
        " ", 
       RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<BothSides\>\""}], ",",
        " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"walk", ",", " ", "c"}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"First", " ", "@", " ", "#"}], ",", " ", 
          RowBox[{"Last", " ", "@", " ", "#"}]}], "]"}]}], " ", "&"}], " ", "@",
       " ", 
      RowBox[{"(", 
       RowBox[{"Last", " ", "/@", " ", 
        RowBox[{"VertexList", "[", "walk", "]"}]}], ")"}]}], ",", "\n", 
     "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0e7d4f75-2775-4d30-8d8e-96a15febf310"],

