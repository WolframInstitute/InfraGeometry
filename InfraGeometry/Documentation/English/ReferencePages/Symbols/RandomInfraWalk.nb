Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraWalk", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8f8e4edb-1b1c-4452-9c89-2c17ba17d10e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d04bcee-c9a7-41b2-a520-084707fa874e"],
 "\[LineSeparator]",
 "gives a random walk grown from ",
 StyleBox["germ", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " by at most the budget ",
 StyleBox["k", "TI"],
 " of edges, each step under the rules of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Properties"]], "paclet:ref/Properties"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a7007d25-b038-42fb-a1da-6bfe747edb71"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c547f195-09ce-4bf9-b0cf-75657b535d8d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["k", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba4848e9-3785-48ea-bbf1-eae4744f6127"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " distinct walks.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"03c7d2b4-b582-4efd-91ca-0f898dda0e49"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19ff2f79-0583-424b-8241-45aac5139635"],
 "\[LineSeparator]",
 "grows the walk with no budget, until no admissible step remains or the \
stopping condition fires."
}], "Usage",ExpressionUUID->"897e70c3-957e-4943-ab3f-e12fefe8af32"],

Cell[TextData[{
 "The germ is a vertex, a vertex list or a walk graph; a list of germs gives \
the walks grown from each. A walk is returned as a directed path graph on the \
pairs {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "}; ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "305bf087-158e-4d1a-a5b2-64ca908bc3ee"],
 " is its vertex sequence."
}], "Notes",ExpressionUUID->"0f9e4bdb-b937-418f-a71b-85334194d062"],

Cell[TextData[{
 "The budget ",
 StyleBox["k", "TI"],
 " counts the edges added on each growing side: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "529db606-228f-4f07-bfc8-a406dceb615c"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3dd850b-159f-43de-9247-cc395787e43d"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"kmin", ",", " ", "kmax"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46c13e57-e164-418c-82e5-96041b07f829"],
 " or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd12567f-a6cd-4a2b-9779-ebf0f9794fc8"],
 ". ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "840dd9bf-9527-46d1-b4e3-d9af3727a4fc"],
 " needs a hard ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38d4c4d5-bb69-4987-bf72-45a2f8f3a440"],
 " or ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cfca2732-f4e1-42d3-b533-bc638b50377d"],
 " with no window, which bounds the walks."
}], "Notes",ExpressionUUID->"b1e841b9-7c97-4b90-94cc-a8b95c953566"],

Cell[TextData[{
 "A step looks at a window: the last ",
 StyleBox["r", "TI"],
 " vertices of the growing side with the candidate appended; ",
 StyleBox["r", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca79bf45-9553-4178-a215-3dd3ab160929"],
 " is the whole side. A rule is an energy ",
 StyleBox["E", "TI"],
 " \[GreaterEqual] 0 on the window, ",
 StyleBox["E", "TI"],
 " = 0 exactly when the rule holds:"
}], "Notes",ExpressionUUID->"a48e4b33-98f6-41be-a736-8aa178cfead1"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "135c39c6-5c5d-4659-b921-e5be69bd9a21"], Cell["Rule", "TableText",
     FontWeight->Bold,ExpressionUUID->"7e5e49a0-bdc2-4c01-9e9b-3dfc77a67002"],
     Cell[TextData[{
     "Energy ",
     StyleBox["E", "TI"],
     " of the window"
    }], "TableText",
     FontWeight->Bold,ExpressionUUID->"a1a49eab-eafd-4afb-a79c-2babc1ad7a12"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "09013a02-1238-4083-aacb-01cd5b141436"], Cell[TextData[Cell[
    BoxData["\"\<Simple\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3101049b-9dad-478e-9118-6ce62bbc5906"]], "TableText",ExpressionUUID->
     "bc810cb0-7e56-42e9-9d3e-f5c72b82e3d6"], Cell[TextData[{
     "the number of earlier occurrences of the candidate; at ",
     StyleBox["r", "TI"],
     " = 2 a step back"
    }], "TableText",ExpressionUUID->"0bb3f6d0-a0cb-472b-a07d-f537f5082133"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e5184177-3602-44f8-9e3d-9cf6abaae5b8"], Cell[TextData[Cell[
    BoxData["\"\<Shortest\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "13845309-9391-4b0e-b1f0-004a2545c918"]], "TableText",ExpressionUUID->
     "5487959a-ccef-4dea-a0a7-62c9ba5b1c74"], Cell["\<\
the defect: the number of edges of the window minus the distance of its ends\
\>", "TableText",ExpressionUUID->"3f555b69-0768-45c4-9309-ff9b4809d9f0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0fa5e35e-07ab-4892-afc1-7b6abba0fe03"], Cell[TextData[Cell[
    BoxData["\"\<Stretched\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "8c9f0810-8e2b-4f7e-af40-f2d6e50236d4"]], "TableText",ExpressionUUID->
     "f2ea40f4-46bd-46e9-8a3f-904ab12e7068"], Cell["\<\
the defect minus the least defect among the candidates of the step\
\>", "TableText",ExpressionUUID->"9b710ff9-be5d-4787-9034-0055b2682291"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9dc3ab81-44ad-48df-8d27-c41cf4dfa421"], Cell[TextData[StyleBox[
    "f", "TI"]], "TableText",ExpressionUUID->
     "3a677afd-919f-4a2a-bda0-072d6ebc54b8"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"f", "[", "window", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "795bb3ea-79ab-4c9d-9a33-5fdefb465e87"],
     "; ",
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "86fa1896-5569-47f3-ab3f-c6f39b24f815"],
     " and ",
     Cell[BoxData["False"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4fd98414-f2d8-4f6c-bc52-1340756f5767"],
     " read as 0 and 1"
    }], "TableText",ExpressionUUID->"acf23b19-36d3-46de-832f-9a594aaf5317"]}
  }]], "2ColumnTableMod",ExpressionUUID->"e5b8d387-1b60-4d48-a47a-\
5aff0a7891b1"],

Cell[TextData[{
 "A rule is written ",
 Cell[BoxData["rule"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96c48eca-1d11-4381-a0f9-2e3dcdd32b94"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"rule", ",", " ", "r"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8081144-709e-4b37-b327-745df00c2877"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"rule", ",", " ", "r", ",", " ", "p"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa3ecb53-e99e-4986-add3-278584e7bdbe"],
 ", with ",
 StyleBox["r", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "239786c8-2b75-48f2-af60-af32b318f9e0"],
 " and ",
 StyleBox["p", "TI"],
 " = 0 when omitted. The weight ",
 StyleBox["p", "TI"],
 " sets how much a violation costs:"
}], "Notes",ExpressionUUID->"7bcaed04-cc34-408d-9d19-104c6575f356"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0c14c3d8-b10c-4887-bbe4-980284086ec5"], Cell[TextData[StyleBox[
    "p", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"7ce79e15-4881-4d96-a104-669435d987fc"],
     Cell["Effect", "TableText",
