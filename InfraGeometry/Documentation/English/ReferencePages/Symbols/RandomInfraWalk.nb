     "840401fe-bf1e-4a95-89c8-09be2ba45852"], Cell[TextData[Cell[
    BoxData["\"\<Forward\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f1c3b996-c8fc-4812-9bc6-f141f7be2dfc"]], "TableText",ExpressionUUID->
     "41d11bc6-b69d-43d3-a1b5-cd2cf322e673"], Cell[TextData[{
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
