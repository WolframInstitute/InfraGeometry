Cell[TextData[{
 "A soft rule changes the order, not the class: under ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c4d2998-2958-4cb8-9488-18298c25367d"],
 " the weighted walks are the walks of the hard rules."
}], "ExampleText",ExpressionUUID->"28506a9f-1e1c-441a-87c4-41343605b214"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{"g", ",", " ", "a", ",", " ", 
        RowBox[{"{", "4", "}"}], ",", " ", "All", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Simple\>\"", ",", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<Shortest\>\"", ",", " ", "3", ",", " ", "0.3"}], 
            "}"}]}], "}"}]}]}], "]"}]}], " ", "===", "\n", "    ", 
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{"g", ",", " ", "a", ",", " ", 
        RowBox[{"{", "4", "}"}], ",", " ", "All", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", "\"\<Simple\>\"", "}"}]}]}], "]"}]}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"22c180d6-9a3b-4e64-9cff-47fe35db5196"],

Cell[BoxData[
 RowBox[{"{", "True", "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"c5eaa620-4496-4f43-b5fb-0717966055ed"]
}, Open  ]],

Cell[TextData[{
 "The soft ",
 Cell[BoxData["\"\<Stretched\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aba69c92-c5aa-4ed8-9a7d-10ed914db6c1"],
 " weighs as the soft ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5e05b63-6023-4d3d-a416-6e48f98dc26b"],
 ": under one seed the two draw the same walk."
}], "ExampleText",ExpressionUUID->"632e640d-1f4b-4391-93a0-327a2b0fef1b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"SameQ", " ", "@@", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Last", " ", "/@", " ", 
        RowBox[{"VertexList", " ", "@", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
           RowBox[{"RandomInfraWalk", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", 
             RowBox[{"{", "6", "}"}], ",", " ", 
             RowBox[{"Properties", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"{", 
                RowBox[{"rule", ",", " ", "3", ",", " ", "0.3"}], "}"}], 
               "}"}]}]}], "]"}]}], ")"}]}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"rule", ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Stretched\>\"", ",", " ", "\"\<Shortest\>\""}], 
          "}"}]}], "}"}]}], "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"4103b89e-e09b-4863-bb0d-827e9ff95103"],

Cell[BoxData[
 RowBox[{"{", "True", "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"606ce75e-303e-4a91-ac42-522f18ee6b27"]
}, Open  ]],

Cell[TextData[{
 "The cusps, self-tangencies and triple points of a walk are read by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WalkSingularities"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/WalkSingularities", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "08f2a444-4a16-49cf-9d57-23e7b382162d"],
 "; a class free of one of them is a predicate on it."
}], "ExampleText",ExpressionUUID->"951fda09-e07a-40f2-9c73-6ed6bb0d3854"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"RandomInfraWalk", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", 
         RowBox[{"{", "6", "}"}], ",", " ", "All", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"\"\<Simple\>\"", ",", " ", "2"}], "}"}], "}"}]}]}], 
        "]"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"WalkSingularities", "[", 
           RowBox[{"Last", " ", "/@", " ", 
            RowBox[{"VertexList", " ", "@", " ", "#"}]}], "]"}], 
          "[", "\"\<SelfTangencies\>\"", "]"}], " ", "=!=", " ", 
         RowBox[{"{", "}"}]}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"walks", ",", " ", 
           RowBox[{"UpTo", "[", "3", "]"}]}], "]"}], ",", " ", "a"}], "}"}]}],
       "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "walks"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"38902f07-5073-475c-abc6-6f33d4ece8f9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   GraphicsBox[
