Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraWalk", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cb3cbfd0-61f0-4fc9-9810-6e7a65687132"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb9ca030-7325-4c16-850f-80ceffc0f037"],
 "\[LineSeparator]",
 "gives a random walk grown from ",
 StyleBox["germ", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " by at most the budget ",
 StyleBox["k", "TI"],
 " of edges, each step under the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Properties"]], "paclet:ref/Properties"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6ddae7fe-b26c-46a7-9613-6f5bb14768a4"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a8279778-84d0-4dd5-970b-3de8653dc0d1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["k", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ccbb9712-0729-4793-9a24-0c24831ed55d"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " distinct walks.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8ffa8f98-69f7-4317-828b-515634f8102c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e48bb36-f203-4ec7-8b47-9c8650a03e52"],
 "\[LineSeparator]",
 "grows the walk with no budget, until no admissible step remains or the \
stopping condition fires."
}], "Usage",ExpressionUUID->"6c87fb2b-02c0-48a3-87da-f4f49f8c6951"],

Cell[TextData[{
 "The germ is a vertex, a vertex list or a walk graph; a list of germs gives \
the walks grown from each. A walk is returned as a directed path graph on the \
pairs {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "}; ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a41e246-7d2c-4b32-92b2-ea02d340ff98"],
 " is its vertex sequence."
}], "Notes",ExpressionUUID->"7e744af9-3b7b-460c-a0c8-cfcda5561d34"],

Cell[TextData[{
 "The budget ",
 StyleBox["k", "TI"],
 " counts the edges added on each growing side: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75b29588-870d-4bc1-b3c2-9bec823fabac"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe405277-a205-4755-860a-f08c386aa2f1"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"kmin", ",", " ", "kmax"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c73c6810-c7ce-45ce-91c3-4e3232b9cd92"],
 " or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "887033eb-cae5-4d8e-a462-d1d8ac8d5cf3"],
 ". ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06c4d05c-953a-4f75-a4b7-346ac10c6dad"],
 " needs the bare ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4978ef3c-4a5c-434b-b7da-c339015b7d07"],
 ", which bounds the walks."
}], "Notes",ExpressionUUID->"f56c4767-ca35-44d1-8adf-f75753318c0e"],

Cell[TextData[{
 "Each step chooses the next vertex among the neighbours of the last one, the \
candidates. A property reads the ",
 StyleBox["window", "TI"],
 " of a candidate ",
 StyleBox["v", "TI"],
 ": the last ",
 StyleBox["r", "TI"],
 " vertices of the walk followed by ",
 StyleBox["v", "TI"],
 ", so a window of scale ",
 StyleBox["r", "TI"],
 " has ",
 StyleBox["r", "TI"],
 " edges; ",
 StyleBox["r", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f5f2e66-af46-4bfb-bbad-2bd70f59ae29"],
 ", the default, is the whole walk."
}], "Notes",ExpressionUUID->"dbb7070f-986c-46ec-b3a3-bacc1fdbd61e"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "56e42949-ad22-4b1f-b189-b3d49fd0fb67"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"81055340-dfd5-4871-9309-4af949195c42"],
     Cell["Effect", "TableText",
     FontWeight->Bold,ExpressionUUID->"5919c5fb-a209-43f9-8514-4160ead21a97"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d25d0013-eef1-44e0-a4f7-a1fcf4d7876e"], Cell[TextData[Cell[
    BoxData["\"\<Simple\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3af39219-7cd6-4290-ba0e-b48d531bc2a3"]], "TableText",ExpressionUUID->
     "386d4b06-7325-4829-a41f-1aa413fef7aa"], Cell[TextData[{
     "no vertex twice; ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Simple\>\"", ",", " ", "r"}], "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "134f1ae4-b759-4b98-8a38-f800af96fe38"],
     " no vertex twice within the window, ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Simple\>\"", ",", " ", "r", ",", " ", "p"}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0adca149-eaf2-465a-b9bf-d7b60069957d"],
     " a repeat weighed ",
     StyleBox["p", "TI"],
     " instead of forbidden"
    }], "TableText",ExpressionUUID->"222a8fc3-f3d7-4709-9dc1-31485d3e2b1a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "bde77c83-b449-43aa-b4c8-3df7f1224f1e"], Cell[TextData[Cell[BoxData[
     RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "\[Beta]"}]], 
     "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d94a9087-1a10-42bd-8cfa-4b29af981428"]], "TableText",ExpressionUUID->
     "e535069d-8925-42d5-9629-ca7b68905c49"], Cell[TextData[{
     "each step prefers the straightest continuation: a candidate is weighed ",
     Cell[BoxData[
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]"}], "]"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3258599d-0ead-44a4-9a87-467200aa3b69"],
     ", \[CapitalDelta] its excess energy, below"
    }], "TableText",ExpressionUUID->"c4a0bc98-161b-49d2-92ce-b85256428bca"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "aa1eb164-0911-4608-911d-208f4480c647"], Cell[TextData[Cell[BoxData[
     RowBox[{"\"\<Straightness\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\[Beta]", ",", " ", "r"}], "}"}]}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "28f55540-b316-43ac-9e3c-8bf011d2b18d"]], "TableText",ExpressionUUID->
     "fa7678cc-cc39-47c6-957c-fd3397c2fb50"], Cell[TextData[{
     "the same on the window of scale ",
     StyleBox["r", "TI"]
    }], "TableText",ExpressionUUID->"6abf7f57-df28-4a38-903d-919895041b7f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "dcebf7b8-dac1-4db6-91e0-fabbcfa0465b"], Cell[TextData[{
     StyleBox["f", "TI"],
     " ",
     Cell[BoxData[
      RowBox[{"->", " ", "\[Beta]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8cb07fc9-ddb8-4798-acaf-5957f06e9436"],
     ", ",
     StyleBox["f", "TI"],
     " ",
     Cell[BoxData[
      RowBox[{"->", " ", 
       RowBox[{"{", 
        RowBox[{"\[Beta]", ",", " ", "r"}], "}"}]}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ef6a591f-f85d-4ac6-92da-f6f3626fe44c"]
    }], "TableText",ExpressionUUID->"b3f59806-473b-4309-b87a-7fcec9bc1592"], 
    Cell[TextData[{
     "the energy ",
     Cell[BoxData[
      RowBox[{"f", "[", "window", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8082a3bc-fe28-4d09-b003-73b296277551"],
     " \[GreaterEqual] 0 in place of the straightness energy; ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "74ba2c8e-9691-4fd5-8939-f45cdc116a75"],
     " forbids the window, and a predicate reads ",
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4016aea6-8e92-4c98-b6ad-95fca8ab497a"],
     " as 0 and ",
     Cell[BoxData["False"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "edac5f63-8ad7-4f72-8d98-4be8e725b4fa"],
     " as ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b6654256-f454-49d2-885c-5d1f24d9d529"]
    }], "TableText",ExpressionUUID->"fa1cc65a-0364-4564-8352-11d0a4b6fb3d"]}
  }]], "2ColumnTableMod",ExpressionUUID->"52708117-8759-4b9d-a08b-\
b4151582c649"],

Cell[TextData[{
 StyleBox["\[Beta]", "TI"],
 " is a non-negative number or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d27913e7-acac-4d92-92a7-59acc03f9de0"],
 ". The properties act in the order given."
}], "Notes",ExpressionUUID->"b17e35f5-4bf0-4ee7-aa47-d9bbaf1a9e60"],

Cell[TextData[{
 StyleBox["The gain.",
  FontWeight->"Bold"],
 " Let (",
 StyleBox["w", "TI"],
 "\:2080, \[Ellipsis], ",
 StyleBox["w", "TI"],
 "\:209c) be the window before the step, its tip ",
 StyleBox["w", "TI"],
 "\:209c the last vertex of the walk. A candidate ",
 StyleBox["v", "TI"],
 " changes the distance to each earlier vertex ",
 StyleBox["w\:1d62", "TI"],
 " by its ",
 StyleBox["gain", "TI"]
}], "Notes",ExpressionUUID->"b2d961fb-0b76-4ea5-b3c6-e681f243a821"],

Cell[TextData[{
 "  ",
 StyleBox["g\:1d62", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w\:1d62", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") \[Minus] ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w\:1d62", "TI"],
 ", ",
 StyleBox["w\:209c", "TI"],
 ") \[Element] {\[Minus]1, 0, 1}:"
}], "Notes",ExpressionUUID->"31c6f02c-38e1-45ec-a55c-76fb1c1f1aa4"],

Cell[TextData[{
 "1 when ",
 StyleBox["v", "TI"],
 " moves away from ",
 StyleBox["w\:1d62", "TI"],
 ", 0 when it keeps the distance, \[Minus]1 when it comes back. The ",
 StyleBox["mean gain", "TI"]
}], "Notes",ExpressionUUID->"b11cb9f8-2d4e-425b-abef-7761271e0cb1"],

Cell[TextData[{
 "  ",
 StyleBox["g", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = (",
 StyleBox["g", "TI"],
 "\:2080(",
 StyleBox["v", "TI"],
 ") + ",
 StyleBox["g", "TI"],
 "\:2081(",
 StyleBox["v", "TI"],
 ") + \[CenterEllipsis] + ",
 StyleBox["g", "TI"],
 "\:209c\:208b\:2081(",
 StyleBox["v", "TI"],
 ")) / ",
 StyleBox["t", "TI"]
}], "Notes",ExpressionUUID->"27b1df26-6306-414e-a5c9-0284e84dc08d"],

Cell[TextData[{
 "lies between \[Minus]1 and 1, and is 1 exactly when ",
 StyleBox["v", "TI"],
 " moves away from every earlier vertex of the window. The tip itself is left \
out: its gain is always 1."
}], "Notes",ExpressionUUID->"9c32e77c-b2b6-472d-9a77-2b5e4f20af59"],

Cell[TextData[{
 StyleBox["The energy and the weight.",
  FontWeight->"Bold"],
 " The energy of ",
 Cell[BoxData["\"\<Straightness\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d88bb32-96a6-412c-be08-3c36d8f69ff5"],
 " is ",
 StyleBox["E", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = 1 \[Minus] ",
 StyleBox["g", "TI"],
 "(",
 StyleBox["v", "TI"],
 "), between 0 and 2, and 0 while the window is the tip alone. The excess \
energy of ",
 StyleBox["v", "TI"],
 " is its energy against the best candidate ",
 StyleBox["u", "TI"],
 " of the step,"
}], "Notes",ExpressionUUID->"0cb7ca50-b0ec-4012-b2f9-63aa58d565ca"],

Cell[TextData[{
 "  \[CapitalDelta](",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["E", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") \[Minus] min_",
 StyleBox["u", "TI"],
 " ",
 StyleBox["E", "TI"],
 "(",
 StyleBox["u", "TI"],
 "),"
}], "Notes",ExpressionUUID->"0e0ce6a2-3e7d-428f-bb79-456440830943"],

Cell[TextData[{
 "and the step draws ",
 StyleBox["v", "TI"],
 " with probability ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]", 
    RowBox[{"(", "v", ")"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9757dce-4941-41d6-9d74-beb63be01f55"],
 " divided by the sum of ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]", 
    RowBox[{"(", "u", ")"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26d8faac-a752-4fd8-b8f5-ae192acd194b"],
 " over the candidates: a Boltzmann weight at inverse temperature ",
 StyleBox["\[Beta]", "TI"],
 ". Only differences of energies matter, so ranking by the mean gain is \
ranking by the total distance ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w", "TI"],
 "\:2080, ",
 StyleBox["v", "TI"],
 ") + \[CenterEllipsis] + ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w", "TI"],
 "\:209c\:208b\:2081, ",
 StyleBox["v", "TI"],
 ") to the window, and the exponential is the only weight with this property. \
The mean, not the sum, keeps the cost of a turn independent of the length of \
the window."
}], "Notes",ExpressionUUID->"6f980aa9-878c-4665-b18d-b46a6e722b5e"],

Cell[TextData[{
 StyleBox["The turning angle.",
  FontWeight->"Bold"],
 " Suppose the path distance is close to a rounding of the Euclidean one, the \
window is straight, and the window is not aligned with the mesh. Then for a \
candidate turning by the angle ",
 StyleBox["\[Theta]", "TI"],
 " the mean gain is about cos ",
 StyleBox["\[Theta]", "TI"],
 ": the Euclidean gain against every earlier vertex is cos ",
 StyleBox["\[Theta]", "TI"],
 " up to order 1/",
 StyleBox["s", "TI"],
 ", ",
 StyleBox["s", "TI"],
 " its distance to the tip, and the roundings up and down balance along the \
window. The weight of a step is then about ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{"\[Beta]", " ", "cos", " ", "\[Theta]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "175a44fc-a9a9-47b5-babc-d99f490fccfb"],
 ", the von Mises distribution in the turning angle, and for large ",
 StyleBox["\[Beta]", "TI"],
 " about ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", "\[Beta]"}], " ", 
    RowBox[{
     RowBox[{"\[Theta]", "^", "2"}], "/", "2"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62293d11-ef67-45e9-aea1-9b718b1e9b37"],
 ", a Gaussian of variance 1/",
 StyleBox["\[Beta]", "TI"],
 ". So ",
 StyleBox["\[Beta]", "TI"],
 " is a bending rigidity: turns of order 1/\[Sqrt]",
 StyleBox["\[Beta]", "TI"],
 " are typical. For a window aligned with the mesh the roundings do not \
balance and the mean gain is a step function of ",
 StyleBox["\[Theta]", "TI"],
 ", not the cosine."
}], "Notes",ExpressionUUID->"99ca7c98-c4d1-4dea-a434-b82769a8e798"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "71b731e6-3e78-4799-93b4-7f5b83692e38"], Cell[TextData[StyleBox[
    "\[Beta]", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"9cc6f769-1364-457b-af7f-32731fb6784f"],
     Cell["The walk", "TableText",
     FontWeight->Bold,ExpressionUUID->"9f1c8222-b11e-4c0e-be28-86e268883d6a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "40bad5ca-8268-4c87-b0c1-bbd41138de1d"], Cell[
    "0", "TableText",ExpressionUUID->"00b10c1b-9a6e-41e0-9051-da24845625fa"], 
    Cell["the plain random walk: every candidate weighs alike", "TableText",
     ExpressionUUID->"9aba376d-a07b-4ce2-9f92-1dc107a09e92"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "06bebc43-ffe2-4446-ad26-40aa0787c547"], Cell[
    "2", "TableText",ExpressionUUID->"17fb43e0-8286-4a34-bc8c-cb7bf97b97bf"], 
    Cell["wanders, with a preference for going on", "TableText",
     ExpressionUUID->"d5a8b4e6-9cfc-44a7-abd0-4d8074fb9713"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4e441a85-3029-4ced-9723-75582a3fe0f3"], Cell[
    "8", "TableText",ExpressionUUID->"a47a47aa-9eb3-4bcb-99df-dec7d9eaf4ea"], 
    Cell["bends by about 20\[Degree] per step", "TableText",ExpressionUUID->
     "a6d49d7b-c058-4ab0-b7a4-3f3b177c7ea9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "be6fa599-cdf1-4268-a796-a783bf1e8283"], Cell[
    "32", "TableText",ExpressionUUID->"762b3d74-be10-43ca-9a66-2457e78229b4"],
     Cell["nearly straight", "TableText",ExpressionUUID->
     "9dacd7cf-019a-47a2-a701-7be37d9a5fdd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "959e329d-43ca-4d02-87e4-2a818e99f382"], Cell[TextData[Cell[BoxData[
    "Infinity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "fc7a1fe8-fd19-4fdb-9ce2-e50239faf4de"]], "TableText",ExpressionUUID->
     "d955981e-a1db-4c65-85eb-115e709b9614"], Cell["\<\
always a candidate of \[CapitalDelta] = 0; straightness never ends the walk, \
since some candidate always has \[CapitalDelta] = 0\
\>", "TableText",ExpressionUUID->"9a19f33a-6604-46e4-912f-1f56c0298d07"]}
  }]], "2ColumnTableMod",ExpressionUUID->"0612d85d-de99-4fa9-bc2b-\
29d25d9ef9d5"],

Cell[TextData[{
 "A walk is a shortest path at scale ",
 StyleBox["r", "TI"],
 " (",
 Cell[BoxData[
  RowBox[{"InfraGeodesicQ", "[", 
   RowBox[{"g", ",", " ", "walk", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1a12031-3a6c-4da5-bdcc-03506642d7cd"],
 ") exactly when every step moves away from all the earlier vertices of its \
window, that is when ",
 StyleBox["E", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = 0 at every step; at ",
 StyleBox["\[Beta]", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da73ce14-6a26-47d1-ad9a-215a27b0d946"],
 " the walk takes such a step whenever one exists."
}], "Notes",ExpressionUUID->"f4438b52-53bb-4641-a438-72906c529965"],

Cell[TextData[{
 "Under ",
 Cell[BoxData[
  RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<BothSides\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "298ee040-8094-4d83-a4b6-6cc3419b1119"],
 " the window of a step is the joined walk: a step at both ends draws the new \
first vertex on the whole walk, then the new last vertex on the whole walk \
with that new first vertex, so the two halves are straight as one walk."
}], "Notes",ExpressionUUID->"cecaa8bf-281f-4a74-aa88-093a3ef3be57"],

Cell[TextData[{
 "The gain sees shortest paths, not Euclidean straightness. On the square \
grid every monotone staircase is a shortest path, and a turn by 90\[Degree] \
has gain 1 like the step straight on, so at ",
 StyleBox["\[Beta]", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e09aff60-d905-4635-ae9b-aafbfcc5ea2a"],
 " the walk is a random staircase, not a straight line; a walk straight in \
the Euclidean sense needs a substrate whose shortest paths are straight, such \
as the square mesh."
}], "Notes",ExpressionUUID->"22f72754-e693-4b6d-b18a-d3af7b6e6db3"],

Cell["Options:", "Notes",ExpressionUUID->"0cd1a341-ab9e-4eae-8d82-5a37a0cd6435"],

