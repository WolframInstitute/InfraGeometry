Cell[TextData[{
 "The straightness of ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb3aab9e-042e-4876-a3c9-fbd1492c2f68"],
 " is the energy 1 \[Minus] ",
 StyleBox["g", "TI"],
 "(",
 StyleBox["v", "TI"],
 "), one minus the mean gain, written out as a user energy scaled by ",
 StyleBox["\[Beta]", "TI"],
 ", walk for walk:"
}], "ExampleText",ExpressionUUID->"148c74a0-1610-4c8e-89cb-78d4c9a053b7"],

