Cell["\<\
The number of self-avoiding walks of 1 to 5 edges on the grid:\
\>", "ExampleText",ExpressionUUID->"cad608dc-63b2-47f9-a20a-782e2f8b5940"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"{", "k", "}"}], ",", " ", "All", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", "\"\<Simple\>\"", "}"}]}]}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "5"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f24fa9f0-df2e-4b60-a4b4-294a1d94b869"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "12", ",", "36", ",", "100", ",", "284"}], 
  "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"43595be7-c838-4310-8559-5c8884ce80e2"]
}, Open  ]],

Cell[TextData[{
 "From the random walk to a straight one: 9 edges from the centre of the \
square mesh at ",
 StyleBox["\[Beta]", "TI"],
 " = 0, 2, 8, 32 and ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "467d73a8-3e3a-498f-860b-8cb0bae7cd12"],
 ":"
}], "ExampleText",ExpressionUUID->"82fb05ab-9ccd-4377-960c-8c04d54cb50c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"InfraSubstrateHighlight", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"RandomInfraWalk", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", 
             RowBox[{"{", "9", "}"}], ",", " ", 
             RowBox[{"Properties", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<Simple\>\"", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"\"\<Geodesic\>\"", ",", " ", 
                  RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "b"}]}], 
                 "}"}]}], "}"}]}], ",", " ", 
             RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}], ",", 
           " ", "c"}], "}"}], ",", "\n", "      ", 
         RowBox[{"PlotLabel", " ", "->", " ", "b"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", 
         RowBox[{"{", 
          RowBox[{
          "0", ",", " ", "2", ",", " ", "8", ",", " ", "32", ",", " ", 
           "Infinity"}], "}"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"6a14fad5-20ba-43a2-a428-587363d3bf6d"],

