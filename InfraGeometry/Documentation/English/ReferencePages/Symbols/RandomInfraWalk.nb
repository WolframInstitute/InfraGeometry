Cell[TextData[{
 "The class widens from the simple walks to the walks without a cusp, ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Simple\>\"", ",", " ", "2"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56eeba20-eeaa-4181-9458-5fffcd5cf232"],
 ", and to every walk of at most 4 edges."
}], "ExampleText",ExpressionUUID->"85edb5aa-c690-44a7-81a0-8a8bf74ab2ca"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"walks", " ", "=", " ", 
          RowBox[{"RandomInfraWalk", "[", 
           RowBox[{"g", ",", " ", "a", ",", " ", 
            RowBox[{"UpTo", "[", "4", "]"}], ",", " ", "All", ",", " ", 
            RowBox[{"Properties", " ", "->", " ", "rules"}]}], "]"}]}], "}"}],
         ",", "\n", "      ", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"walks", ",", " ", "a"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"rules", ",", " ", "\"\<: \>\"", ",", " ", 
             RowBox[{"Length", " ", "@", " ", "walks"}]}], "}"}], "]"}]}], 
         "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"rules", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "\"\<Simple\>\"", "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"\"\<Simple\>\"", ",", " ", "2"}], "}"}], "}"}], ",", " ", 
          RowBox[{"{", "}"}]}], "}"}]}], "}"}]}], "]"}]}]}], "]"}]}], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"b43ea487-d083-4cfa-8544-111d3412e85f"],

