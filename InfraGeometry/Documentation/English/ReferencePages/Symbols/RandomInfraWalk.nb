  RowBox[{
   RowBox[{
    RowBox[{"{", "\<\"Simple\"\>", "}"}], "\[Rule]", "100"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"\<\"Simple\"\>", ",", 
       RowBox[{"\<\"Window\"\>", "\[Rule]", "2"}]}], "}"}], "}"}], "\[Rule]", 
    "108"}], ",", 
   RowBox[{
    RowBox[{"{", "}"}], "\[Rule]", "256"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d0540fe4-cf40-4767-b05e-d59ebe01dc2e"]
}, Open  ]],

Cell[TextData[{
 "A function is an energy. The energy 1.2 ",
 StyleBox["d(v, q)", "TI"],
 " of the new vertex, at window 1, pulls a self-avoiding walk toward ",
 StyleBox["q", "TI"],
 ", here at distance 5; the walk stops there. The labels are the lengths:"
}], "ExampleText",ExpressionUUID->"670c0523-b91e-4e0b-a5c7-ffa62765a4ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "5"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"walk", " ", "=", " ", 
          RowBox[{"RandomInfraWalk", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", 
            RowBox[{"UpTo", "[", "20", "]"}], ",", " ", 
            RowBox[{"Properties", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<Simple\>\"", ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"w", " ", "|->", " ", 
                  RowBox[{"1.2", " ", 
                   RowBox[{"GraphDistance", "[", 
                    RowBox[{"g", ",", " ", 
                    RowBox[{"Last", "[", "w", "]"}], ",", " ", "q"}], 
                    "]"}]}]}], ",", " ", 
                 RowBox[{"\"\<Window\>\"", " ", "->", " ", "1"}]}], "}"}]}], 
              "}"}]}], ",", "\n", "        ", 
            RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "q"}], " ", 
               "&"}], ")"}]}], ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "seed"}]}], "]"}]}], 
         "}"}], ",", "\n", "      ", 
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{"walk", ",", " ", "c", ",", " ", "q"}], "}"}], ",", " ", 
          RowBox[{"PlotLabel", " ", "->", " ", 
           RowBox[{"EdgeCount", "[", "walk", "]"}]}]}], "]"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"seed", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0616a77d-d454-466d-822e-1f0295861f7a"],

