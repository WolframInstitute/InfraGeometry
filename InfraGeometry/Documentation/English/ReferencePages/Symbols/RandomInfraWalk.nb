Cell["Properties", "ExampleSubsection",ExpressionUUID->"a76a852b-bc9b-4929-acfb-3e9b7bf79fef"],

Cell[TextData[{
 "The walks of 4 edges on the grid: self-avoiding, without a step back, and \
all of them, ",
 StyleBox["100", "TI"],
 ", ",
 StyleBox["4 \[CenterDot] 3\.b3 = 108", "TI"],
 " and ",
 StyleBox["4\:2074 = 256", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"9c8056f6-3a0f-4331-b8e2-127e8bea2410"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"rules", " ", "->", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"RandomInfraWalk", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", 
         RowBox[{"{", "4", "}"}], ",", " ", "All", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", "rules"}]}], "]"}]}]}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"rules", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "\"\<Simple\>\"", "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"\"\<Simple\>\"", ",", " ", 
            RowBox[{"\"\<Window\>\"", " ", "->", " ", "2"}]}], "}"}], "}"}], ",",
          " ", 
         RowBox[{"{", "}"}]}], "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c3fca60a-0561-4b49-bde4-b5d4f07ba559"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"{", "\<\"Simple\"\>", "}"}], "\[Rule]", "100"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"\<\"Simple\"\>", ",", 
       RowBox[{"\<\"Window\"\>", "\[Rule]", "2"}]}], "}"}], "}"}], "\[Rule]", 
    "108"}], ",", 
