Cell["\<\
The number of self-avoiding walks of 1 to 5 edges on the grid:\
\>", "ExampleText",ExpressionUUID->"f117bb3f-adf5-462a-ab9a-561b2bfeabed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"{", "k", "}"}], ",", " ", "All", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", "\"\<Simple\>\"", "}"}]}]}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "5"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"21fd4f2c-b9cd-46a2-a504-bec81f3ccefd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "12", ",", "36", ",", "100", ",", "284"}], 
  "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"6a9ed3a0-e634-4580-a177-2e41e67dcef1"]
}, Open  ]],

Cell[TextData[{
 "From the random walk to a straight one: 9 edges from the centre of the \
triangular tiling at ",
 StyleBox["\[Beta]", "TI"],
 " = 0, 2, 8, 32 and ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4349bfc0-b324-4878-801d-09e8ac579185"],
 ":"
}], "ExampleText",ExpressionUUID->"06dbffba-808a-41c6-8208-f1d998fb367e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"InfraSubstrateHighlight", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"RandomInfraWalk", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", 
             RowBox[{"{", "9", "}"}], ",", " ", 
             RowBox[{"Properties", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<Simple\>\"", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"\"\<Geodesic\>\"", ",", " ", 
                  RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "b"}]}], 
                 "}"}]}], "}"}]}], ",", " ", 
             RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}], ",", 
           " ", "c"}], "}"}], ",", "\n", "      ", 
         RowBox[{"PlotLabel", " ", "->", " ", "b"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", 
         RowBox[{"{", 
          RowBox[{
          "0", ",", " ", "2", ",", " ", "8", ",", " ", "32", ",", " ", 
           "Infinity"}], "}"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"0e2676d7-46d4-41bc-8c0b-6d08d9f333e2"],

