     "295c7ad7-06be-410f-801f-3b06211a2d6a"], Cell[
    "a predicate on the walk so far", "TableText",ExpressionUUID->
     "313647bf-0d2e-42cc-b868-1d7ed011cee1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3c686636-2d1a-4795-89d5-0e22162c5641"], Cell[TextData[Cell[BoxData[
    "RandomSeeding"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "28b08c99-55b4-48a8-930c-1932e2bee8a4"]], "TableText",ExpressionUUID->
     "0ae9a991-95c7-42ed-861d-686e44fea7e6"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
