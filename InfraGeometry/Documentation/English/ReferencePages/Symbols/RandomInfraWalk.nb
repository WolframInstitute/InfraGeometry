Cell[TextData[{
 "From the random walk to a straight one: 9 edges from the centre of the \
square mesh at ",
 StyleBox["\[Beta]", "TI"],
 " = 0, 2, 8, 32 and ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6733692a-12cc-462f-b32b-b74b74c96f19"],
 ":"
}], "ExampleText",ExpressionUUID->"71d958d7-dd16-419f-a613-0fef67025d8b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"InfraSubstrateHighlight", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"RandomInfraWalk", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", 
             RowBox[{"{", "9", "}"}], ",", " ", 
             RowBox[{"Properties", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<Simple\>\"", ",", " ", 
                RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "b"}]}], 
               "}"}]}], ",", " ", 
             RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}], ",", 
           " ", "c"}], "}"}], ",", "\n", "      ", 
         RowBox[{"PlotLabel", " ", "->", " ", "b"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", 
         RowBox[{"{", 
          RowBox[{
          "0", ",", " ", "2", ",", " ", "8", ",", " ", "32", ",", " ", 
           "Infinity"}], "}"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"f4c78601-9b21-45cf-8bdf-68b76935030a"],

