Cell[TextData[{
 "Under ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cb50242-8ae2-457b-be41-c7ca6e3e97c7"],
 " the predicate reads both tips: the shortest paths through an edge of the \
grid stop when the back reaches 22 or the front reaches 28, whichever comes \
first."
}], "ExampleText",ExpressionUUID->"f7ff4d25-ea11-454b-a6d7-80b183d14bd1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"7", ",", " ", "7"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{"RandomInfraWalk", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"24", ",", " ", "25"}], "}"}], ",", " ", "Infinity", ",", " ",
        "All", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Shortest\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<BothSides\>\""}], ",",
        "\n", "    ", 
       RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"First", "[", "#", "]"}], " ", "===", " ", "22"}], " ", "||",
            " ", 
           RowBox[{
            RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "28"}]}], " ", 
          "&"}], ")"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"stopped", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"walks", ",", " ", 
       RowBox[{
        RowBox[{"MatchQ", "[", 
         RowBox[{
          RowBox[{"Last", " ", "/@", " ", 
           RowBox[{"VertexList", " ", "@", " ", "#"}]}], ",", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"22", ",", " ", "__"}], "}"}], " ", "|", " ", 
           RowBox[{"{", 
            RowBox[{"__", ",", " ", "28"}], "}"}]}]}], "]"}], " ", "&"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"stopped", ",", " ", 
         RowBox[{"{", 
          RowBox[{"24", ",", " ", "25"}], "}"}], ",", " ", "22", ",", " ", 
         "28"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"walks", ",", " ", "stopped"}], "}"}]}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c469f923-2dd5-4db2-87ba-c83751165c39"],

