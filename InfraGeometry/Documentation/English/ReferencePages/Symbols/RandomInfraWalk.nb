Cell["\<\
The number of self-avoiding walks of 1 to 5 edges on the grid:\
\>", "ExampleText",ExpressionUUID->"ca5d1612-7670-4f29-8a0a-23c4827f84e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"{", "k", "}"}], ",", " ", "All", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", "\"\<Simple\>\"", "}"}]}]}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "5"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b4fde861-4d9c-446d-b60f-a62e7bc5f4ea"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "12", ",", "36", ",", "100", ",", "284"}], 
  "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"a5c0cc5c-a9ac-41b7-a867-31276343ef41"]
}, Open  ]],

Cell[TextData[{
 "A soft straightness, the rule ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c686dcc-9d0e-48ea-a38b-b4b8201d28d1"],
 " on a window of 5 vertices with weight 1, 0.3 and 0.01: from the random \
walk to a nearly straight one:"
}], "ExampleText",ExpressionUUID->"626bdbe4-fde1-4086-8183-609a065cdc52"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RandomInfraWalk", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", 
            RowBox[{"{", "9", "}"}], ",", " ", 
            RowBox[{"Properties", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{"\"\<Shortest\>\"", ",", " ", "5", ",", " ", "p"}], 
               "}"}], "}"}]}], ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "5"}]}], "]"}], ",", " ",
           "c"}], "}"}], ",", "\n", "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", "p"}]}], "]"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0.3", ",", " ", "0.01"}], "}"}]}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"ea286dee-f2fc-4dbe-a71e-356fb8bd6935"],

