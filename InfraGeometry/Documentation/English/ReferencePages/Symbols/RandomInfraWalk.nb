Cell[TextData[{
 "The straightness of ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb883d46-70c2-455b-8daf-c7a441d8efcd"],
 " is the energy 1 \[Minus] ",
 StyleBox["g", "TI"],
 "(",
 StyleBox["v", "TI"],
 "), one minus the mean gain, written out as a user energy scaled by ",
 StyleBox["\[Beta]", "TI"],
 ", walk for walk:"
}], "ExampleText",ExpressionUUID->"6f6a44a4-98c0-4a62-b6c6-26d9c2f49326"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"energy", " ", "=", " ", 
     RowBox[{"w", " ", "|->", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "w", "]"}], " ", "<", " ", "3"}], ",", " ", 
        "0", ",", "\n", "     ", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"Mean", " ", "@", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"w", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
               RowBox[{"Last", "[", "w", "]"}]}], "]"}], " ", "-", " ", 
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"w", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
               RowBox[{"w", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "2"}], "]"}], "]"}]}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", 
              RowBox[{
               RowBox[{"Length", "[", "w", "]"}], " ", "-", " ", "2"}]}], 
             "}"}]}], "]"}]}]}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"{", "10", "}"}], ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"\"\<Geodesic\>\"", ",", " ", 
            RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "2"}]}], "}"}], 
          "}"}]}], ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "s"}]}], "]"}], " ", "===", 
      "\n", "    ", 
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"{", "10", "}"}], ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"w", " ", "|->", " ", 
           RowBox[{"2", " ", 
            RowBox[{"energy", "[", "w", "]"}]}]}], "}"}]}], ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "s"}]}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "5"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"aa47fd7c-4a0b-4264-bf94-68c6e0d9b6c1"],

