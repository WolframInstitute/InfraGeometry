Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraWalk", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9afe790c-93fc-44c5-8062-794a2dab2baa"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "080aaffc-e343-49bb-a2a7-19ce96881585"],
 "\[LineSeparator]",
 "gives a random walk grown from ",
 StyleBox["germ", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " by at most the budget ",
 StyleBox["k", "TI"],
 " of edges, each step under the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Properties"]], "paclet:ref/Properties"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "080b746f-ae6f-496e-9115-79dd1447b39c"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"50cb6ac5-d0f1-4b7d-81c1-7890bd1c46de"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["k", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f85f787-b0ad-4d21-840e-df4fdedc9d03"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " distinct walks.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e187a3d4-b9df-4daa-b515-489ad0224466"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11b2e3e9-3e1b-48fc-a73f-578729efb070"],
 "\[LineSeparator]",
 "grows the walk with no budget, until no admissible step remains or the \
stopping condition fires."
}], "Usage",ExpressionUUID->"6940b12e-488c-4e20-aeb8-b3de43bf5964"],

Cell[TextData[{
 "The germ is a vertex, a vertex list or a walk graph; a list of germs gives \
the walks grown from each. A walk is returned as a directed path graph on the \
pairs {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "}; ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18a20250-5843-4bd0-832b-d0f127271ff2"],
 " is its vertex sequence."
}], "Notes",ExpressionUUID->"47231372-cba9-4be9-8fb2-4baf4c6d57d9"],

Cell[TextData[{
 "The budget ",
 StyleBox["k", "TI"],
 " counts the edges added on each growing side: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0acf0d63-74b4-4d08-8bed-bd7a21025967"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d60cf008-00f6-4bb7-9076-3b515c885abd"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"kmin", ",", " ", "kmax"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03c19f62-79dc-4b3d-a4a3-cf9b0e07e180"],
 " or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38546247-590f-4f85-8e1e-66114f28c53b"],
 ". ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dce6007e-ef0c-4e5b-8f8f-d30a3e43d67e"],
 " needs ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d943e634-14e7-4046-a911-5403484969a0"],
 " or ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1c31a61-7c55-44e2-8485-51343748790c"],
 " on the whole walk, which bound the walks."
}], "Notes",ExpressionUUID->"62444484-81cb-4a90-a7fa-b463d84de1b4"],

Cell[TextData[{
 "Each step chooses the next vertex among the neighbours of the last one, the \
candidates. A property is a name, bare or with its sub-options, ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<name\>\"", ",", " ", 
    RowBox[{"\"\<Window\>\"", " ", "->", " ", "r"}], ",", " ", 
    "\[Ellipsis]"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7129819e-b7e9-4fc8-8bcf-b52d5e7a3bd9"],
 ". It reads the ",
 StyleBox["window", "TI"],
 " of a candidate ",
 StyleBox["v", "TI"],
 ": the last ",
 StyleBox["r", "TI"],
 " vertices of the walk followed by ",
 StyleBox["v", "TI"],
 ", so a window of scale ",
 StyleBox["r", "TI"],
 " has ",
 StyleBox["r", "TI"],
 " edges; ",
 StyleBox["r", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01d343fc-45f1-4883-ac1c-6d66cf9f980b"],
 ", the default, is the whole walk."
}], "Notes",ExpressionUUID->"58069579-9d65-4181-bfeb-624e042cd094"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "649ad381-708a-4b03-a555-8741f6072f94"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"9790dea3-1812-4fa6-b76d-08e2f8957d25"],
     Cell["Effect", "TableText",
     FontWeight->Bold,ExpressionUUID->"b8d58632-a295-4d05-b9da-130431e9d520"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "911a90c4-97b1-4098-bf9b-6b82dbcb7131"], Cell[TextData[Cell[
    BoxData["\"\<Simple\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a72e4005-56d3-4e88-807a-d1edda693aab"]], "TableText",ExpressionUUID->
     "dcc07ade-bc98-4569-849e-5a26cb1e2054"], Cell[
    "no vertex twice in the window", "TableText",ExpressionUUID->
     "5bfa7b16-bd8f-421d-b12c-e83eb38b2111"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ae7b97f4-596c-4d4a-bafe-70d86fa386d5"], Cell[TextData[Cell[
    BoxData["\"\<Geodesic\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ec24f387-6708-4f5b-b2ea-cb39fa47257d"]], "TableText",ExpressionUUID->
     "8329163a-83f3-494d-b5ae-8de7b286a15a"], Cell[TextData[{
     "every window a shortest path, the walks of ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["RandomInfraGeodesic"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "4f29b1b5-9e00-49bd-bcfc-acf5847014c5"]
    }], "TableText",ExpressionUUID->"58b3ee8b-acde-4935-9d27-80ee5b2ab5f3"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9392b4c0-ae66-4b29-88bb-9c0b30ad6f7b"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", 
      RowBox[{"\"\<Geodesic\>\"", ",", " ", 
       RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "\[Beta]"}]}], "}"}]], 
     "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ee69d1d8-7eb4-4910-9b4a-a0a8b89486ef"]], "TableText",ExpressionUUID->
     "9a5309f2-efd2-42fc-9552-34caf913b677"], Cell[TextData[{
     "each step prefers the straightest continuation: a candidate is weighed ",
     Cell[BoxData[
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]"}], "]"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f8c16099-4626-4756-b503-b47a5409ba09"],
     ", \[CapitalDelta] its excess energy, below"
    }], "TableText",ExpressionUUID->"844a2aee-2e1b-40d6-83a1-904dc0c679a9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7060dbc0-ebed-43f3-a430-adde0ee1d86d"], Cell[TextData[StyleBox[
    "f", "TI"]], "TableText",ExpressionUUID->
     "b06664c5-60df-4b3e-8bc4-563ed80253a3"], Cell[TextData[{
     "the energy ",
     Cell[BoxData[
      RowBox[{"f", "[", "window", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9f26e828-ffe0-4c8c-8e6c-9c5293406cbe"],
     " \[GreaterEqual] 0: a candidate is weighed ",
     Cell[BoxData[
      RowBox[{"Exp", "[", 
       RowBox[{"-", "\[CapitalDelta]"}], "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b0165546-7730-4def-9b46-97075985268e"],
     ", the scale inside ",
     StyleBox["f", "TI"],
     "; ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4b659e03-f52a-4541-b8f4-335dc516e1ed"],
     " forbids the window, and a predicate reads ",
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a03dcf15-43e4-42fc-aaff-9e1026499628"],
     " as 0 and ",
     Cell[BoxData["False"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4da8b47b-0975-4215-8693-edfc128f02da"],
     " as ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "deed78ce-4dfc-470d-8193-5ff5f829a819"],
     ", so it is a constraint"
    }], "TableText",ExpressionUUID->"74b4e26f-f1a3-49dd-ac3c-d5665fc8422e"]}
  }]], "2ColumnTableMod",ExpressionUUID->"016b8970-cf3a-4742-9110-\
3e94958e96f4"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "626ee2f4-1d99-4b84-8e75-14ccb6651810"], Cell["Sub-option", "TableText",
     FontWeight->Bold,ExpressionUUID->"6d440e5b-a931-45f5-befb-9559943b86c8"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"4d44a060-ccf8-4208-8366-0ff139bc050c"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"731854bd-0d52-407e-9ff6-60f7691fcebb"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ee471f1a-1743-48a4-b887-aae58ef12c5c"], Cell[TextData[Cell[
    BoxData["\"\<Window\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6524997b-c3a2-4d92-a636-d4d8fb85fb07"]], "TableText",ExpressionUUID->
     "be2f928f-fc0a-4cde-b7db-58bd982ed00c"], Cell[TextData[Cell[BoxData[
    "Infinity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "988e48dd-1186-4549-8d6a-497a004154b0"]], "TableText",ExpressionUUID->
     "33430da5-f399-449d-ab78-d79d877e9c6e"], Cell[TextData[{
     "a positive integer ",
     StyleBox["r", "TI"],
     ", the window of scale ",
     StyleBox["r", "TI"]
    }], "TableText",ExpressionUUID->"8f01792a-950f-424a-b9ca-f8780f36a96e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3102d68e-0ab9-44be-92f6-861cbe6987f1"], Cell[TextData[Cell[
    BoxData["\"\<Straightness\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "132aef53-a7e0-40ff-84a0-520421f93562"]], "TableText",ExpressionUUID->
     "e20783a4-72c6-4332-8a50-225edd0054a7"], Cell[TextData[Cell[BoxData[
    "Infinity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "705ce20d-fc3e-454f-a283-d97b53cb4d93"]], "TableText",ExpressionUUID->
     "44c0f2e5-0e31-4943-a049-fc2e31050ec0"], Cell[TextData[{
     "on ",
     Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6891bf6a-f7f8-4318-8123-a1d7d76a551b"],
     ", a non-negative number ",
     StyleBox["\[Beta]", "TI"],
     "; ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "30abb2e9-5394-4159-84e1-e9a07ab7aeae"],
     " is the shortest path"
    }], "TableText",ExpressionUUID->"5f636533-2dec-4128-ad5f-6189a15e544a"]}
  }]], "3ColumnTableMod",ExpressionUUID->"06e674bb-e7fd-495b-8744-\
22c6bdc3c16e"],

Cell["The properties act in the order given.", "Notes",ExpressionUUID->"57de4c6f-c4df-4063-b9f6-c33dc841f1e5"],

Cell[TextData[{
 StyleBox["The gain.",
  FontWeight->"Bold"],
 " Let (",
 StyleBox["w", "TI"],
 "\:2080, \[Ellipsis], ",
 StyleBox["w", "TI"],
 "\:209c) be the window before the step, its tip ",
 StyleBox["w", "TI"],
 "\:209c the last vertex of the walk. A candidate ",
 StyleBox["v", "TI"],
 " changes the distance to each earlier vertex ",
 StyleBox["w\:1d62", "TI"],
 " by its ",
 StyleBox["gain", "TI"]
}], "Notes",ExpressionUUID->"320f9c92-fbb7-4a40-9ac0-562ea09d112c"],

Cell[TextData[{
 "  ",
 StyleBox["g\:1d62", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w\:1d62", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") \[Minus] ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w\:1d62", "TI"],
 ", ",
 StyleBox["w\:209c", "TI"],
 ") \[Element] {\[Minus]1, 0, 1}:"
}], "Notes",ExpressionUUID->"35ccbfb2-2cb9-4904-9478-490819ea549c"],

Cell[TextData[{
 "1 when ",
 StyleBox["v", "TI"],
 " moves away from ",
 StyleBox["w\:1d62", "TI"],
 ", 0 when it keeps the distance, \[Minus]1 when it comes back. The ",
 StyleBox["mean gain", "TI"]
}], "Notes",ExpressionUUID->"212667e9-6e09-448f-809d-cf5817dd83fd"],

Cell[TextData[{
 "  ",
 StyleBox["g", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = (",
 StyleBox["g", "TI"],
 "\:2080(",
 StyleBox["v", "TI"],
 ") + ",
 StyleBox["g", "TI"],
 "\:2081(",
 StyleBox["v", "TI"],
 ") + \[CenterEllipsis] + ",
 StyleBox["g", "TI"],
 "\:209c\:208b\:2081(",
 StyleBox["v", "TI"],
 ")) / ",
 StyleBox["t", "TI"]
}], "Notes",ExpressionUUID->"5568a5bf-9fd9-45fe-a2a0-258ffc6cba10"],

Cell[TextData[{
 "lies between \[Minus]1 and 1, and is 1 exactly when ",
 StyleBox["v", "TI"],
 " moves away from every earlier vertex of the window. The tip itself is left \
out: its gain is always 1."
}], "Notes",ExpressionUUID->"35db4de3-1819-4bd2-afb9-a39b9b41a34f"],

Cell[TextData[{
 StyleBox["The energy and the weight.",
  FontWeight->"Bold"],
 " The energy of ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45371fbc-aadc-4617-a9a1-2c371e171b6e"],
 " is ",
 StyleBox["E", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = 1 \[Minus] ",
 StyleBox["g", "TI"],
 "(",
 StyleBox["v", "TI"],
 "), between 0 and 2, and 0 while the window is the tip alone. The excess \
energy of ",
 StyleBox["v", "TI"],
 " is its energy against the best candidate ",
 StyleBox["u", "TI"],
 " of the step,"
}], "Notes",ExpressionUUID->"fef2188a-0df8-46c4-aac7-3fb9e79dacdd"],

Cell[TextData[{
 "  \[CapitalDelta](",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["E", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") \[Minus] min_",
 StyleBox["u", "TI"],
 " ",
 StyleBox["E", "TI"],
 "(",
 StyleBox["u", "TI"],
 "),"
}], "Notes",ExpressionUUID->"cbd1e551-842b-4ff6-8b8d-778d3751b1db"],

Cell[TextData[{
 "and the step draws ",
 StyleBox["v", "TI"],
 " with probability ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]", 
    RowBox[{"(", "v", ")"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6151add4-d65c-4d88-80cc-d99ccc8b8a6d"],
 " divided by the sum of ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]", 
    RowBox[{"(", "u", ")"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ec5080e-bc2a-4ad3-b831-826dadb13322"],
 " over the candidates: a Boltzmann weight at inverse temperature ",
 StyleBox["\[Beta]", "TI"],
 ". Only differences of energies matter, so ranking by the mean gain is \
ranking by the total distance ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w", "TI"],
 "\:2080, ",
 StyleBox["v", "TI"],
 ") + \[CenterEllipsis] + ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w", "TI"],
 "\:209c\:208b\:2081, ",
 StyleBox["v", "TI"],
 ") to the window, and the exponential is the only weight with this property. \
The mean, not the sum, keeps the cost of a turn independent of the length of \
the window."
}], "Notes",ExpressionUUID->"a093d8e1-6af4-4b15-9b8a-3b8039c29692"],

Cell[TextData[{
 StyleBox["The turning angle.",
  FontWeight->"Bold"],
 " Suppose the path distance is close to a rounding of the Euclidean one, the \
window is straight, and the window is not aligned with the mesh. Then for a \
candidate turning by the angle ",
 StyleBox["\[Theta]", "TI"],
 " the mean gain is about cos ",
 StyleBox["\[Theta]", "TI"],
 ": the Euclidean gain against every earlier vertex is cos ",
 StyleBox["\[Theta]", "TI"],
 " up to order 1/",
 StyleBox["s", "TI"],
 ", ",
 StyleBox["s", "TI"],
 " its distance to the tip, and the roundings up and down balance along the \
window. The weight of a step is then about ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{"\[Beta]", " ", "cos", " ", "\[Theta]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb4a87d7-ceea-4596-9ab9-f154f443a4f8"],
 ", the von Mises distribution in the turning angle, and for large ",
 StyleBox["\[Beta]", "TI"],
 " about ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", "\[Beta]"}], " ", 
    RowBox[{
     RowBox[{"\[Theta]", "^", "2"}], "/", "2"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbfddf0-20dd-4033-98c7-6746aac0f912"],
 ", a Gaussian of variance 1/",
 StyleBox["\[Beta]", "TI"],
 ". So ",
 StyleBox["\[Beta]", "TI"],
 " is a bending rigidity: turns of order 1/\[Sqrt]",
 StyleBox["\[Beta]", "TI"],
 " are typical. For a window aligned with the mesh the roundings do not \
balance and the mean gain is a step function of ",
 StyleBox["\[Theta]", "TI"],
 ", not the cosine."
}], "Notes",ExpressionUUID->"74a11c28-19d9-494b-a9be-9806eb00045f"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "054abf59-ee5a-48b7-86c9-d8727412e3b9"], Cell[TextData[StyleBox[
    "\[Beta]", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"a7bc9ad6-250c-45f6-8b85-0664cfbe539d"],
     Cell["The walk", "TableText",
     FontWeight->Bold,ExpressionUUID->"88351156-434d-43df-9a5c-7806b5ad6e26"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c758b5ac-3e83-4d84-9865-1afb464adbaf"], Cell[
    "0", "TableText",ExpressionUUID->"496d962d-df13-4cb9-94a7-b0c39a3b064a"], 
    Cell["the plain random walk: every candidate weighs alike", "TableText",
     ExpressionUUID->"280d4d32-e6a3-43f8-96d4-6dd2c19e92c2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "17d5f98d-5fa3-490a-a71e-81e39a972b4f"], Cell[
    "2", "TableText",ExpressionUUID->"a95bf306-69ec-44da-b959-8020f27034c3"], 
    Cell["wanders, with a preference for going on", "TableText",
     ExpressionUUID->"ca3504a5-8f34-4b0d-8f2d-741887f145cc"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3749bb37-d1be-4ac4-af86-41097f840b7b"], Cell[
    "8", "TableText",ExpressionUUID->"6cb92e68-9a70-4b25-9e74-98201641657f"], 
    Cell["bends by about 20\[Degree] per step", "TableText",ExpressionUUID->
     "d8ab2780-bf70-40a8-8979-9539fa53be93"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "28faa66b-25c0-43e4-8bf3-af2ac2df1ac2"], Cell[
    "32", "TableText",ExpressionUUID->"e82475a9-0315-443d-afa9-cbb9a37fc8b1"],
     Cell["nearly straight", "TableText",ExpressionUUID->
     "1cf92b2e-fb5a-4ae7-a95e-5f0408a7dce1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "07d85e15-7db0-433e-ae68-f8831c2a35cc"], Cell[TextData[{
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "113c1d9f-473d-49b6-9452-752d07ac331b"],
     ", the default"
    }], "TableText",ExpressionUUID->"5670f7a8-568b-440a-8070-a89174ba6367"], 
    Cell["\<\
a shortest path: every step has energy 0, and the walk backtracks where no \
candidate has\
\>", "TableText",ExpressionUUID->"34f1ad93-1f62-440d-a5a4-04476c51357b"]}
  }]], "2ColumnTableMod",ExpressionUUID->"dc4ad0ca-1935-408d-b0f2-\
528848bd1024"],

Cell[TextData[{
 "A walk is a shortest path at scale ",
 StyleBox["r", "TI"],
 " (",
 Cell[BoxData[
  RowBox[{"InfraGeodesicQ", "[", 
   RowBox[{"g", ",", " ", "walk", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "903f4b96-88aa-4426-8db9-ffdff27590cb"],
 ") exactly when every step moves away from all the earlier vertices of its \
window, that is when ",
 StyleBox["E", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = 0 at every step: this is ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cd85a8d-5bd8-4400-ab3e-5123b6fc1a63"],
 " with no straightness given. A large finite ",
 StyleBox["\[Beta]", "TI"],
 " takes such a step whenever one exists, and otherwise the least bent one."
}], "Notes",ExpressionUUID->"23c4b488-8a5b-4f75-b00b-af3cd3c20e98"],

Cell[TextData[{
 "Under ",
 Cell[BoxData[
  RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<BothSides\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b85bb92-7d65-4005-8e9b-e4301745e438"],
 " the window of a step is the joined walk: a step at both ends draws the new \
first vertex on the whole walk, then the new last vertex on the whole walk \
with that new first vertex, so the two halves are straight as one walk."
}], "Notes",ExpressionUUID->"5f971ae9-0928-44ae-97db-ac3bd9600f1e"],

Cell[TextData[{
 "The gain sees shortest paths, not Euclidean straightness. On the square \
grid every monotone staircase is a shortest path, and a turn by 90\[Degree] \
has gain 1 like the step straight on, so ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "295d19f8-e7d4-453d-aa71-630cca184510"],
 " gives a random staircase, not a straight line; a walk straight in the \
Euclidean sense needs a substrate whose shortest paths are straight, such as \
the square mesh."
}], "Notes",ExpressionUUID->"777f5e83-8068-4ca6-8759-9febf0e95276"],

Cell["Options:", "Notes",ExpressionUUID->"6c35ebcf-ccf3-4cd8-90c8-677f6bc3380b"],

