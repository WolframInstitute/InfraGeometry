      FontSize->0.9 Inherited,ExpressionUUID->
      "1f9d5044-fc9c-4e46-8602-07e435e966f7"]
    }], "TableText",ExpressionUUID->"0fac4909-b7cc-47b7-b487-01cd08b85b63"]},
