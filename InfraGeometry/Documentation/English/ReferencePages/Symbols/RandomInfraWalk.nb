Cell["\<\
The number of self-avoiding walks of 1 to 5 edges on the grid:\
\>", "ExampleText",ExpressionUUID->"5f650dfb-6632-4576-8e7f-d8eae7a90a47"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"{", "k", "}"}], ",", " ", "All", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", "\"\<Simple\>\"", "}"}]}]}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "5"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8983e827-fa04-4b4a-8969-d776b8eb65b1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "12", ",", "36", ",", "100", ",", "284"}], 
  "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"2a9b4a06-542f-48a6-a9b0-9239eac3f7fb"]
}, Open  ]],

Cell[TextData[{
 "From the random walk to a straight one: 9 edges from the centre of the \
square mesh at ",
 StyleBox["\[Beta]", "TI"],
 " = 0, 2, 8, 32 and ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e9a8145-1fab-4270-830f-04d14ac131d5"],
 ":"
}], "ExampleText",ExpressionUUID->"89f1560e-f72d-4540-9f79-b8a50886acbb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"InfraSubstrateHighlight", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"RandomInfraWalk", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", 
             RowBox[{"{", "9", "}"}], ",", " ", 
             RowBox[{"Properties", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<Simple\>\"", ",", " ", 
                RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "b"}]}], 
               "}"}]}], ",", " ", 
             RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}], ",", 
           " ", "c"}], "}"}], ",", "\n", "      ", 
         RowBox[{"PlotLabel", " ", "->", " ", "b"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", 
         RowBox[{"{", 
          RowBox[{
          "0", ",", " ", "2", ",", " ", "8", ",", " ", "32", ",", " ", 
           "Infinity"}], "}"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"22c1d5a9-9bbe-46f7-a4c0-976a030e75c2"],

