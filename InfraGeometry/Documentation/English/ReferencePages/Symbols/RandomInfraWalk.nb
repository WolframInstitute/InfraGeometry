     "}"
    }], "TableText",ExpressionUUID->"e077d01d-d8fd-4dcd-85e1-80af43306068"], 
    Cell[TextData[{
     StyleBox["f", "TI"],
     " of the candidate windows, whole or of scale ",
     StyleBox["r", "TI"],
     ", gives the candidates to pursue; the weights ignored"
    }], "TableText",ExpressionUUID->"13f61c0a-5921-40d7-ab40-73ee98144981"]}
  }]], "2ColumnTableMod",ExpressionUUID->"a9280e84-1354-4954-9f10-\
b13a67fb48b6"],

Cell[TextData[{
 "A candidate whose weight is below ",
 Cell[BoxData["$MachineEpsilon"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3da6998e-6aa4-4241-8c19-e73a91bb18f3"],
 " times the number of candidates, relative to the best, is never drawn; ",
 Cell[BoxData["RandomSample"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "424b1fd2-00e9-433e-a198-14a21c6768d1"],
 " tries it after the others. Under ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87115f42-11b2-47dd-bfa7-0de797dd2cf1"],
 " a finite ",
 StyleBox["\[Beta]", "TI"],
 " changes the order of the walks, not the class. A walk also stops when the \
budget is spent or no candidate is left."
}], "Notes",ExpressionUUID->"4886979f-17f6-4aa4-9110-7902cdb5650a"]
}, Open  ]],

