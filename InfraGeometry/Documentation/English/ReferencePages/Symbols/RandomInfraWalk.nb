Cell["Properties", "ExampleSubsection",ExpressionUUID->"5b4fea3d-c693-453a-96e0-4b92a7ee4883"],

Cell[TextData[{
 "The walks of 4 edges on the grid: self-avoiding, without a step back, and \
all of them, ",
 StyleBox["100", "TI"],
 ", ",
 StyleBox["4 \[CenterDot] 3\.b3 = 108", "TI"],
 " and ",
 StyleBox["4\:2074 = 256", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"a226979e-9f05-483e-807f-2015bacf5813"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"rules", " ", "->", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"RandomInfraWalk", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", 
         RowBox[{"{", "4", "}"}], ",", " ", "All", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", "rules"}]}], "]"}]}]}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"rules", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "\"\<Simple\>\"", "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"\"\<Simple\>\"", ",", " ", 
            RowBox[{"\"\<Window\>\"", " ", "->", " ", "2"}]}], "}"}], "}"}], ",",
          " ", 
         RowBox[{"{", "}"}]}], "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1bd91e6b-1e82-455d-bad2-5ccd8988a261"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"{", "\<\"Simple\"\>", "}"}], "\[Rule]", "100"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"\<\"Simple\"\>", ",", 
       RowBox[{"\<\"Window\"\>", "\[Rule]", "2"}]}], "}"}], "}"}], "\[Rule]", 
    "108"}], ",", 
   RowBox[{
    RowBox[{"{", "}"}], "\[Rule]", "256"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"8446d392-e3ea-4106-8b1a-cb2cf60dbcdc"]
}, Open  ]],

Cell[TextData[{
 "A function is an energy. The energy 1.2 ",
 StyleBox["d(v, q)", "TI"],
 " of the new vertex, at window 1, pulls a self-avoiding walk toward ",
 StyleBox["q", "TI"],
 ", here at distance 5; the walk stops there. The labels are the lengths:"
}], "ExampleText",ExpressionUUID->"417977f6-4d98-4086-bc59-c3fd9b7ce907"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "5"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
