Cell[TextData[{
 "A soft rule changes the order, not the class: under ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8f542eb-f5a3-421d-93fb-eaa3372acc5a"],
 " the weighted walks are the walks of the hard rules."
}], "ExampleText",ExpressionUUID->"4a552b54-897c-41a4-8259-9601985c8957"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{"g", ",", " ", "a", ",", " ", 
        RowBox[{"{", "4", "}"}], ",", " ", "All", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Simple\>\"", ",", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<Shortest\>\"", ",", " ", "3", ",", " ", "0.3"}], 
            "}"}]}], "}"}]}]}], "]"}]}], " ", "===", "\n", "    ", 
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{"g", ",", " ", "a", ",", " ", 
        RowBox[{"{", "4", "}"}], ",", " ", "All", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", "\"\<Simple\>\"", "}"}]}]}], "]"}]}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"81abb8bd-d35a-43dd-b8c2-0981c086ee2d"],

Cell[BoxData[
 RowBox[{"{", "True", "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"c25aa319-c6db-4757-904a-224d7bcf0075"]
}, Open  ]],

Cell[TextData[{
 "The soft ",
 Cell[BoxData["\"\<Stretched\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "122e78da-838c-45c5-8ff6-68cbc0f525ee"],
 " weighs as the soft ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "226f4cc7-c362-4184-87e4-13f1ed42d2a2"],
 ": under one seed the two draw the same walk."
}], "ExampleText",ExpressionUUID->"02679fea-7dcb-467c-b7d8-ea5ec3092b8d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"SameQ", " ", "@@", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Last", " ", "/@", " ", 
        RowBox[{"VertexList", " ", "@", " ", 
         RowBox[{"RandomInfraWalk", "[", 
          RowBox[{"g", ",", " ", "a", ",", " ", 
           RowBox[{"{", "6", "}"}], ",", " ", 
           RowBox[{"Properties", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"rule", ",", " ", "3", ",", " ", "0.3"}], "}"}], 
