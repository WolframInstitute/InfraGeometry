Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"defect", " ", "=", " ", 
     RowBox[{"w", " ", "|->", " ", 
      RowBox[{"Mean", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Length", "[", "w", "]"}], " ", "-", " ", "i"}], ")"}], 
          " ", "-", " ", 
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"w", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
            RowBox[{"Last", "[", "w", "]"}]}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{
            RowBox[{"Length", "[", "w", "]"}], " ", "-", " ", "1"}]}], 
          "}"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"{", "10", "}"}], ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "2"}], "}"}]}], ",",
         " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "s"}]}], "]"}], " ", "===", 
      "\n", "    ", 
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"{", "10", "}"}], ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"defect", " ", "->", " ", "2"}], "}"}]}], ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "s"}]}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "5"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"71fb98b7-509e-4415-b9cb-edbd852d52c2"],

