Cell[TextData[{
 "One step: a walk of 6 edges from the centre of the square mesh, its \
candidates for the next vertex labelled by their excess energy \
\[CapitalDelta]. The candidate of \[CapitalDelta] = 0 moves away from every \
earlier vertex; the other has \[CapitalDelta] = 1 and at ",
 StyleBox["\[Beta]", "TI"],
 " = 8 is drawn about 3000 times less often, the factor ",
 Cell[BoxData[
  RowBox[{"Exp", "[", "8", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc79081c-4b9d-4c0b-add8-76a8b837901f"],
 ":"
}], "ExampleText",ExpressionUUID->"731266c4-7ab0-4c66-9f5e-0a762864ac12"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walk", " ", "=", " ", 
     RowBox[{"Last", " ", "/@", " ", 
      RowBox[{"VertexList", " ", "@", " ", 
       RowBox[{"RandomInfraWalk", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", 
         RowBox[{"{", "6", "}"}], ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<Simple\>\"", ",", " ", 
            RowBox[{"{", 
             RowBox[{"\"\<Geodesic\>\"", ",", " ", 
              RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "8"}]}], 
             "}"}]}], "}"}]}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"energy", " ", "=", " ", 
      RowBox[{"w", " ", "|->", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "w", "]"}], " ", "<", " ", "3"}], ",", " ", 
         "0", ",", "\n", "     ", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"Mean", " ", "@", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"GraphDistance", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"w", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
                RowBox[{"Last", "[", "w", "]"}]}], "]"}], " ", "-", " ", 
              RowBox[{"GraphDistance", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"w", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
                RowBox[{"w", "[", 
                 RowBox[{"[", 
                  RowBox[{"-", "2"}], "]"}], "]"}]}], "]"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", 
               RowBox[{
                RowBox[{"Length", "[", "w", "]"}], " ", "-", " ", "2"}]}], 
              "}"}]}], "]"}]}]}]}], "]"}]}]}], ",", "\n", "   ", 
     RowBox[{"candidates", " ", "=", " ", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"Last", "[", "walk", "]"}]}], "]"}], ",", " ", "walk"}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"excess", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"#", " ", "-", " ", 
        RowBox[{"Min", "[", "#", "]"}]}], " ", "&"}], " ", "@", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{"v", " ", "|->", " ", 
         RowBox[{"energy", "[", 
          RowBox[{"Append", "[", 
           RowBox[{"walk", ",", " ", "v"}], "]"}], "]"}]}], ",", " ", 
        "candidates"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Graph", "[", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "walk", "]"}], ",", " ", "c"}], "}"}], ",",
          " ", 
         RowBox[{"Thread", "[", 
          RowBox[{"candidates", " ", "->", " ", "StandardOrange"}], "]"}]}], 
        "]"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"VertexLabels", " ", "->", " ", 
      RowBox[{"KeyValueMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", " ", "->", " ", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"#2", ",", " ", "16", ",", " ", "Bold"}], "]"}], ",", 
            " ", "Above"}], "]"}]}], " ", "&"}], ",", " ", "excess"}], 
       "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"e4a64f8e-ecfc-405f-9fac-8c12a79841e9"],

