Cell[TextData[{
 "One step: a walk of 6 edges from the centre of the square mesh, its \
candidates for the next vertex labelled by their excess defect \
\[CapitalDelta]. The two candidates of \[CapitalDelta] = 0 move away from \
every earlier vertex; at ",
 StyleBox["\[Beta]", "TI"],
 " = 1 the one of \[CapitalDelta] = 3 is drawn ",
 StyleBox["e", "TI"],
 "\.b3 \[TildeTilde] 20 times less often:"
}], "ExampleText",ExpressionUUID->"3c6b53cd-52e6-454a-b685-9845447bec7c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walk", " ", "=", " ", 
     RowBox[{"Last", " ", "/@", " ", 
      RowBox[{"VertexList", " ", "@", " ", 
       RowBox[{"RandomInfraWalk", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", 
         RowBox[{"{", "6", "}"}], ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<Simple\>\"", ",", " ", 
            RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "1"}]}], "}"}]}], 
         ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"defect", " ", "=", " ", 
      RowBox[{"w", " ", "|->", " ", 
       RowBox[{"Total", " ", "@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Length", "[", "w", "]"}], " ", "-", " ", "i"}], ")"}], 
           " ", "-", " ", 
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"w", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
             RowBox[{"Last", "[", "w", "]"}]}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", 
            RowBox[{
             RowBox[{"Length", "[", "w", "]"}], " ", "-", " ", "1"}]}], 
           "}"}]}], "]"}]}]}]}], ",", "\n", "   ", 
     RowBox[{"candidates", " ", "=", " ", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"Last", "[", "walk", "]"}]}], "]"}], ",", " ", "walk"}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"excess", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"#", " ", "-", " ", 
        RowBox[{"Min", "[", "#", "]"}]}], " ", "&"}], " ", "@", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{"v", " ", "|->", " ", 
         RowBox[{"defect", "[", 
          RowBox[{"Append", "[", 
           RowBox[{"walk", ",", " ", "v"}], "]"}], "]"}]}], ",", " ", 
        "candidates"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Graph", "[", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "walk", "]"}], ",", " ", "c"}], "}"}], ",",
          " ", 
         RowBox[{"Thread", "[", 
          RowBox[{"candidates", " ", "->", " ", "StandardOrange"}], "]"}]}], 
        "]"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"VertexLabels", " ", "->", " ", 
      RowBox[{"KeyValueMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", " ", "->", " ", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"#2", ",", " ", "16", ",", " ", "Bold"}], "]"}], ",", 
            " ", "Above"}], "]"}]}], " ", "&"}], ",", " ", "excess"}], 
       "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"ee6ecc0a-a555-467a-85a0-df01b84174fa"],

