     "f647c0ee-5077-4ff5-a0c9-8f8c70d23417"], Cell[TextData[{
     "a predicate on the vertex sequence so far; the walk stops when it gives \
",
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f363d5e3-8d3d-4ead-94b4-a01985a9014e"]
    }], "TableText",ExpressionUUID->"46a6a47a-eb5d-400f-ae06-5a0190cc396f"]},
