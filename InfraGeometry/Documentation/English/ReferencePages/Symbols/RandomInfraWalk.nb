     FontSize->0.9 Inherited,ExpressionUUID->
     "f78b2e3a-54c6-4315-9693-196aa9eeb87f"]], "TableText",ExpressionUUID->
     "58893fcc-d51c-43ac-acae-1dba88e72a2b"], Cell[
    "random by the weights, uniform without a soft rule", "TableText",
     ExpressionUUID->"c7b0698c-e103-4962-8023-600cfba0d160"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6744a4c5-a58c-43cb-ae36-7b32cc221a85"], Cell[TextData[Cell[BoxData[
    "RandomChoice"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "afcb5e53-01b3-45c7-a1e3-c91d6b050f0c"]], "TableText",ExpressionUUID->
     "7283de3b-7dd4-4915-bdb3-35a23cf96c64"], Cell["\<\
one candidate drawn by the weights: the random walk, which never backtracks\
\>", "TableText",ExpressionUUID->"80dec001-b7fa-44c8-b238-1153eef77738"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "01e342de-0948-4cc8-a6ad-0f8fef81c88c"], Cell[TextData[{
     StyleBox["f", "TI"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"f", ",", " ", "r"}], "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6e3aa34f-3db2-44d1-82e4-6ce3c76c3faf"]
    }], "TableText",ExpressionUUID->"315e728d-04e8-43c0-84b4-49b3add05892"], 
    Cell[TextData[{
     Cell[BoxData["f"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4fe6ed8e-5775-49b3-a590-37c9db8b76b0"],
     " of the candidate windows, whole or of scale ",
     StyleBox["r", "TI"],
     ", giving the ones to pursue in order; the weights ignored"
    }], "TableText",ExpressionUUID->"c949f805-31e1-4eba-af0d-ae2684ee9b4a"]}
  }]], "2ColumnTableMod",ExpressionUUID->"843166bb-fbca-4d69-b09c-\
d5ff86d1639f"],

Cell[TextData[{
 "Every order works with every rule. ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c38020e-9929-4db5-ad33-063da8dd25f8"],
 " and a function do not see the weights, so under them a soft rule changes \
nothing. ",
 Cell[BoxData["RandomSample"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c9e1868-c656-4cd1-8532-08ffc23eeac4"],
 " is a permutation, so ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dae475f0-af25-4ad3-aeaa-b0c88f28813f"],
 " is the whole class whatever the weights. Under ",
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f693878-17b1-454d-a86f-27280321c92b"],
 " the count ",
 StyleBox["n", "TI"],
 " is ",
 StyleBox["n", "TI"],
 " independent runs from the germ, and the runs that met ",
 StyleBox["kspec", "TI"],
 " are returned; a pruning to ",
 StyleBox["m", "TI"],
 " branches per step is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"RandomSample", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"UpTo", "[", "m", "]"}]}], "]"}], " ", "&"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92c2dd78-021d-43dd-955e-a713ae7a2b0a"],
 "."
}], "Notes",ExpressionUUID->"9b0b05bb-1a45-4062-ba4f-25880b8757de"],

Cell[TextData[{
 Cell[BoxData["\"\<Direction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18a1ded1-3da7-4164-b331-ec206e57ead4"],
 " says where the walk grows: ",
 Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6bc78a2-825f-45e6-a2e0-0784402ddb47"],
 " after the last vertex of the germ, ",
 Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a78c97da-f5a5-4a5f-adbb-1f8349344554"],
 " before the first, ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8e06306-9e66-4ef5-8f2d-95ba9a3ce43d"],
 " at both ends. Under ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7786a475-b5f9-4431-9a7e-adb63dcf2c72"],
 " each outer step grows both ends, the front only or the back only, the hard \
",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d7ccb57f-7754-4a76-9e10-348d1245ee74"],
 " and ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69388d57-f217-461f-a504-14cdac366cb9"],
 " are checked again on the window holding both new ends, and the budget is \
the edges added on the longer side."
}], "Notes",ExpressionUUID->"5ba190e2-ec88-423e-8a0d-3285190ed15c"],

Cell[TextData[{
 Cell[BoxData["\"\<StoppingCondition\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "668263f2-831f-4c71-b009-7e1066f90187"],
 " is a predicate on the whole walk so far, its vertex sequence, read after \
every step and on the germ once it has an edge. It can test both tips, and \
when it fires the walk stops on both sides. A walk also stops when the budget \
is spent or no admissible step remains."
}], "Notes",ExpressionUUID->"b3700a5f-3da5-48cd-801d-00791f7cd671"],

Cell[TextData[{
 "An endpoint is a stopping condition. ",
 Cell[BoxData[
  RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "q"}], " ", "&"}], 
    ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40919953-1060-4d03-aa15-047a319155d1"],
 " stops each walk at its first arrival at ",
 StyleBox["q", "TI"],
 "; the walks that end at ",
 StyleBox["q", "TI"],
 " are the walks from the germ to ",
 StyleBox["q", "TI"],
 ". A shortest path between two points is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "75d58e9f-a073-4875-b0d3-0b86150d43fd"],
 "; the walk family has no two-point form."
}], "Notes",ExpressionUUID->"ecdead52-34b4-467b-a9e0-914ecb99c26e"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aec936f9-17f7-4503-82b3-3875cee36b78"],
 " is this call with ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Shortest\>\"", ",", " ", "s"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ab44e97-0484-4fc3-94e3-26cc21567d8f"],
 " first among the rules."
}], "Notes",ExpressionUUID->"5a4aed82-8354-4779-ae19-30e804f143e6"]
}, Open  ]],

