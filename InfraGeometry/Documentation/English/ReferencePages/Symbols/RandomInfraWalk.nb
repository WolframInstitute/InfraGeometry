Cell["NextVertexFunction", "ExampleSubsection",ExpressionUUID->"d84dc7b9-da2f-4660-b494-e7e7415e08d4"],

Cell[TextData[{
 "Under ",
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a04a66cc-4964-4a24-abea-0ab803dd4a2b"],
 " the walk is a random one, one admissible step at a time, and the count is \
the number of independent runs. Three simple walks of 12 edges from the \
centre in one call."
}], "ExampleText",ExpressionUUID->"2760d0c3-f791-4b20-8ba6-7935724ea025"],

Cell[CellGroupData[{

Cell[BoxData[{
