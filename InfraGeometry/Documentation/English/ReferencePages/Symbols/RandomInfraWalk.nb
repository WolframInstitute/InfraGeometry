Cell[TextData[{
 "On the square grid every monotone staircase is a shortest path, so the \
straightest walks at ",
 StyleBox["\[Beta]", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e91ab01-2afa-4f9c-8b17-bc9356d54df0"],
 " are random staircases; each of these is a shortest path:"
}], "ExampleText",ExpressionUUID->"1ccc7fca-a8c2-4ba4-97c4-119b9e22be6e"],

