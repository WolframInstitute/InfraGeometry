  }]], "3ColumnTableMod",ExpressionUUID->"61b0cfff-8dce-45c3-abb6-\
f9dd14ba63b1"],

Cell[TextData[{
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f45f8967-0c1d-4f2a-9922-de8ad69ff377"],
 " turns the surviving candidates and their weights into the order they are \
tried:"
}], "Notes",ExpressionUUID->"4365df4d-c45f-41e0-ba39-3f11fdc66f34"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4cea9654-7864-4a91-a702-2cc94fa19eee"], Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"7428c366-b4e4-4fcb-bbcd-d30af9528b3c"],
     Cell["Order", "TableText",
     FontWeight->Bold,ExpressionUUID->"7fd0e23a-387a-4de4-a9f0-b48cfa246ee2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8069793e-241f-47d7-915d-c915e1374e0f"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "fdf696d1-a91e-41ff-8d9a-cfe730340485"]], "TableText",ExpressionUUID->
     "7135a4c3-24de-47a3-83f6-11e0e384178b"], Cell[TextData[{
     "random by the weights for bounded counts; canonical for ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7c66f84c-c73d-4fdc-ac99-e673649a4144"]
    }], "TableText",ExpressionUUID->"de45ea78-cd08-4a3a-a797-8d760e0a69dd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
