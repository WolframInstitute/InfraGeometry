Cell["\<\
One simple walk of exactly 5 edges, beside its vertex sequence.\
\>", "ExampleText",ExpressionUUID->"7682c7ff-b05c-45bb-a740-3cb3f090d1b6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walk", " ", "=", " ", 
     RowBox[{"RandomInfraWalk", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", 
       RowBox[{"{", "5", "}"}], ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Simple\>\"", "}"}]}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"walk", ",", " ", "a"}], "}"}], ",", " ", 
       RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]}], "]"}], ",", 
     " ", 
     RowBox[{"Last", " ", "/@", " ", 
      RowBox[{"VertexList", "[", "walk", "]"}]}]}], "}"}]}], "]"}]}], "Input",\

 CellLabel->"In[3]:= ",ExpressionUUID->"42b050a7-c6be-4ab8-b4ec-e7a4de1ee6a5"],

