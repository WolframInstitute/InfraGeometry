Cell[TextData[{
 "A function keeps only the candidates it returns, so ",
 Cell[BoxData["MinimalBy"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42fe7dfb-fdfd-4908-80f5-9382be16157d"],
 " keeps those of least energy. With the end defect of the window of scale 3 \
as the energy, every step moves as far as possible from the vertex three \
steps back; 246 of the 2730 self-avoiding walks of 5 edges from the centre of \
the triangular tiling remain:"
}], "ExampleText",ExpressionUUID->"ef54fa5b-9884-4687-9d4c-f447992073f6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"defect", " ", "=", " ", 
     RowBox[{"w", " ", "|->", " ", 
      RowBox[{
       RowBox[{"Length", "[", "w", "]"}], " ", "-", " ", "1", " ", "-", " ", 
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"First", " ", "@", " ", "w"}], ",", " ", 
         RowBox[{"Last", " ", "@", " ", "w"}]}], "]"}]}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{"RandomInfraWalk", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"{", "5", "}"}], ",", " ", "All", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Simple\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"windows", " ", "|->", " ", 
           RowBox[{"MinimalBy", "[", 
            RowBox[{"windows", ",", " ", "defect"}], "]"}]}], ",", " ", "3"}],
          "}"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"walks", ",", " ", "c"}], "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Length", "[", "walks", "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a8824cfd-c493-4146-adc6-858ae3737c7c"],

