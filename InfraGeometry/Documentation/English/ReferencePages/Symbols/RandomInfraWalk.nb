Cell["\<\
A window of scale 3 asks for straightness at scale 3 only; the walk is a \
shortest path at scale 3 and bends at larger scales:\
\>", "ExampleText",ExpressionUUID->"c66eab2a-3d84-4ec5-8213-0d8dad9323eb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walk", " ", "=", " ", 
     RowBox[{"RandomInfraWalk", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"{", "9", "}"}], ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Simple\>\"", ",", " ", 
          RowBox[{"\"\<Straightness\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"Infinity", ",", " ", "3"}], "}"}]}]}], "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"walk", ",", " ", "c"}], "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraGeodesicQ", "[", 
         RowBox[{"g", ",", " ", "walk", ",", " ", "3"}], "]"}], ",", " ", 
        RowBox[{"InfraGeodesicQ", "[", 
         RowBox[{"g", ",", " ", "walk"}], "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"5586803b-1656-4f6d-9368-4c35a79b87aa"],

