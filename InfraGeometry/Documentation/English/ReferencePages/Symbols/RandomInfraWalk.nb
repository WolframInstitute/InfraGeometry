Cell[TextData[{
 "The cusps, self-tangencies and triple points of a walk are read by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WalkSingularities"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/WalkSingularities", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6f414583-5c1e-4791-8601-220586f815db"],
 "; a class free of one of them is a predicate on it."
}], "ExampleText",ExpressionUUID->"2b32e66a-243b-448a-82e5-41c639fbdbf3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"RandomInfraWalk", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", 
         RowBox[{"{", "6", "}"}], ",", " ", "All", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"\"\<Simple\>\"", ",", " ", "2"}], "}"}], "}"}]}]}], 
        "]"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"WalkSingularities", "[", 
           RowBox[{"Last", " ", "/@", " ", 
            RowBox[{"VertexList", " ", "@", " ", "#"}]}], "]"}], 
          "[", "\"\<SelfTangencies\>\"", "]"}], " ", "=!=", " ", 
         RowBox[{"{", "}"}]}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"walks", ",", " ", 
           RowBox[{"UpTo", "[", "3", "]"}]}], "]"}], ",", " ", "a"}], "}"}]}],
       "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "walks"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"d6ac2824-b0e5-4935-a328-7e09c887fb7a"],

