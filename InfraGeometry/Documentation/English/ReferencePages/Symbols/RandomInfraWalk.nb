Cell["\<\
A germ of two vertices grows forward: the simple walks that add at most 2 \
edges after its last vertex.\
\>", "ExampleText",ExpressionUUID->"38b1ab18-1594-4d3d-b541-458aa184d319"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"germ", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}]}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{"RandomInfraWalk", "[", 
      RowBox[{"g", ",", " ", "germ", ",", " ", 
       RowBox[{"UpTo", "[", "2", "]"}], ",", " ", "All", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Simple\>\"", "}"}]}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"walks", ",", " ", "germ"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "walks"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"81433693-eaec-494b-b200-527e842b4390"],

