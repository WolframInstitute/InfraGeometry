                  RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "1000"}]}], 
                 "}"}]}], "}"}]}], ",", " ", 
             RowBox[{"RandomSeeding", " ", "->", " ", "s"}]}], "]"}]}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"energy", " ", "@", " ", 
              RowBox[{"Take", "[", 
               RowBox[{"w", ",", " ", "k"}], "]"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"k", ",", " ", "2", ",", " ", 
               RowBox[{"Length", "[", "w", "]"}]}], "}"}]}], "]"}], ",", " ", 
           
           RowBox[{
            RowBox[{"#", " ", "==", " ", "0"}], " ", "&"}]}], "]"}], ",", " ", 
         RowBox[{"InfraGeodesicQ", "[", 
          RowBox[{"g", ",", " ", "w"}], "]"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5feca8c1-21a6-494e-b204-8830822f4e41"],

