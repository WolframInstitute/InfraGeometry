  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraWalk", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", 
         RowBox[{"{", "12", "}"}], ",", " ", "3", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", "\"\<Simple\>\"", "}"}]}], ",", " ", 
         RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
          "RandomChoice"}]}], "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"#", ",", " ", "a"}], "}"}], ",", " ", 
        RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]}], "]"}], " ", 
      "&"}], " ", "/@", " ", "walks"}], "]"}]}], "]"}]}], "Input",
