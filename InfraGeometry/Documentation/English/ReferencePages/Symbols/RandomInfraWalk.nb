Cell[TextData[{
 "A soft ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fdf04de-6102-47b1-ab9e-8b5d6c9413c3"],
 ": the walk of 30 edges that rarely returns to a vertex it has visited, at \
weights 0.01, 0.1 and 1, with the number of returns."
}], "ExampleText",ExpressionUUID->"b2a1431b-87f0-4120-b946-81e2a22f9894"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"walk", " ", "=", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "4", "]"}], ";", "\n", "        ", 
            RowBox[{"RandomInfraWalk", "[", 
             RowBox[{"g", ",", " ", "a", ",", " ", 
              RowBox[{"{", "30", "}"}], ",", " ", 
              RowBox[{"Properties", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"{", 
                 
                 RowBox[{"\"\<Simple\>\"", ",", " ", "Infinity", ",", " ", 
                  "p"}], "}"}], "}"}]}]}], "]"}]}], ")"}]}], "}"}], ",", "\n",
         "      ", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"walk", ",", " ", "a"}], "}"}], ",", " ", 
            RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]}], "]"}], ",",
           "\n", "        ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "\"\<: \>\"", ",", " ", 
             RowBox[{"31", " ", "-", " ", 
              RowBox[{"Length", " ", "@", " ", 
               RowBox[{"DeleteDuplicates", "[", 
                RowBox[{"Last", " ", "/@", " ", 
                 RowBox[{"VertexList", " ", "@", " ", "walk"}]}], "]"}]}]}]}],
             "}"}], "]"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.01", ",", " ", "0.1", ",", " ", "1"}], "}"}]}], "}"}]}], 
     "]"}]}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e69c5c31-f19c-48a6-8e25-58e8cbe89744"],

