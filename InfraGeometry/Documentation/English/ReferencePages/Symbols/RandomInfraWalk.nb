Cell["Properties", "ExampleSubsection",ExpressionUUID->"8101a324-851c-4358-8ac7-7b40e09d3c99"],

Cell[TextData[{
 "The walks of 4 edges on the grid: self-avoiding, without a step back, and \
all of them, ",
 StyleBox["100", "TI"],
 ", ",
 StyleBox["4 \[CenterDot] 3\.b3 = 108", "TI"],
 " and ",
 StyleBox["4\:2074 = 256", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"55af2897-9273-407b-9249-a880e62ad7f7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"rules", " ", "->", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"RandomInfraWalk", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", 
         RowBox[{"{", "4", "}"}], ",", " ", "All", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", "rules"}]}], "]"}]}]}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"rules", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "\"\<Simple\>\"", "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"\"\<Simple\>\"", ",", " ", "2"}], "}"}], "}"}], ",", " ", 
         
         RowBox[{"{", "}"}]}], "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"686ad30c-8d79-463d-a1b9-85ff30fee25f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"{", "\<\"Simple\"\>", "}"}], "\[Rule]", "100"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"\<\"Simple\"\>", ",", "2"}], "}"}], "}"}], "\[Rule]", "108"}], 
   ",", 
   RowBox[{
    RowBox[{"{", "}"}], "\[Rule]", "256"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e7f2f18d-1796-4821-8ee1-b6f6391b6817"]
}, Open  ]],

Cell[TextData[{
 "A function is an energy. The energy ",
 StyleBox["d(v, q)", "TI"],
 " of the new vertex, at window 1 and ",
 StyleBox["\[Beta]", "TI"],
 " = 1.2, pulls a self-avoiding walk toward ",
 StyleBox["q", "TI"],
 ", here at distance 5; the walk stops there. The labels are the lengths:"
}], "ExampleText",ExpressionUUID->"586bcf95-60cb-49c4-adfe-89029d3b9b42"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "5"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"walk", " ", "=", " ", 
          RowBox[{"RandomInfraWalk", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", 
            RowBox[{"UpTo", "[", "20", "]"}], ",", " ", 
            RowBox[{"Properties", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<Simple\>\"", ",", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"w", " ", "|->", " ", 
                  RowBox[{"GraphDistance", "[", 
                   RowBox[{"g", ",", " ", 
                    RowBox[{"Last", "[", "w", "]"}], ",", " ", "q"}], "]"}]}],
                  ")"}], " ", "->", " ", 
                RowBox[{"{", 
                 RowBox[{"1.2", ",", " ", "1"}], "}"}]}]}], "}"}]}], ",", 
            "\n", "        ", 
            RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "q"}], " ", 
               "&"}], ")"}]}], ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "seed"}]}], "]"}]}], 
         "}"}], ",", "\n", "      ", 
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{"walk", ",", " ", "c", ",", " ", "q"}], "}"}], ",", " ", 
          RowBox[{"PlotLabel", " ", "->", " ", 
           RowBox[{"EdgeCount", "[", "walk", "]"}]}]}], "]"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"seed", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a49bd798-71cf-4b33-aa83-ff85bdd43c9b"],

