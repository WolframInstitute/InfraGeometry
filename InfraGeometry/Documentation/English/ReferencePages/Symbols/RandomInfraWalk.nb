Cell[CellGroupData[{

Cell["Direction", "ExampleSubsection",ExpressionUUID->"c3423561-b934-446e-8fa7-965427feb329"],

Cell["\<\
The simple walks of at most 2 edges grown from a two-vertex germ forward, \
backward and on both sides.\
\>", "ExampleText",ExpressionUUID->"eb8b1cc7-277f-4098-881e-3402a9385d86"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"germ", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}]}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"walks", " ", "=", " ", 
          RowBox[{"RandomInfraWalk", "[", 
           RowBox[{"g", ",", " ", "germ", ",", " ", 
            RowBox[{"UpTo", "[", "2", "]"}], ",", " ", "All", ",", " ", 
            RowBox[{"Properties", " ", "->", " ", 
             RowBox[{"{", "\"\<Simple\>\"", "}"}]}], ",", " ", 
            RowBox[{"\"\<Direction\>\"", " ", "->", " ", "dir"}]}], "]"}]}], 
         "}"}], ",", "\n", "      ", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"walks", ",", " ", "germ"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"dir", ",", " ", "\"\<: \>\"", ",", " ", 
             RowBox[{"Length", " ", "@", " ", "walks"}]}], "}"}], "]"}]}], 
         "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"dir", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Forward\>\"", ",", " ", "\"\<Backward\>\"", ",", 
          " ", "\"\<BothSides\>\""}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"184167b0-b720-4670-9948-55ad6a3b58c2"],

