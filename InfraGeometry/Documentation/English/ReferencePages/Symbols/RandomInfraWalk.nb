Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraWalk", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"80d4c313-a2b9-476c-ba5d-82c82eab0c82"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b416a13-a102-4e56-8f7c-bb1bff608c5c"],
 "\[LineSeparator]",
 "gives a random walk grown from ",
 StyleBox["germ", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " by at most the budget ",
 StyleBox["k", "TI"],
 " of edges, each step under the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Properties"]], "paclet:ref/Properties"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "681738c5-d608-4aac-a1db-b7154f8caca1"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a885db4a-11ac-4726-977d-e7bc81bf4ccf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["k", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a5d7a1d-262e-4662-b315-e26003c90532"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " distinct walks.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"38456143-b61d-4f68-bf41-5b5bf9326161"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee58868b-008a-4d5a-be81-bb8559e84d52"],
 "\[LineSeparator]",
 "grows the walk with no budget, until no admissible step remains or the \
stopping condition fires."
}], "Usage",ExpressionUUID->"1a787bd0-8a9a-4d62-9add-05055e041490"],

Cell[TextData[{
 "The germ is a vertex, a vertex list or a walk graph; a list of germs gives \
the walks grown from each. A walk is returned as a directed path graph on the \
pairs {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "}; ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "734db42c-3af8-4164-819e-b81967412cdf"],
 " is its vertex sequence."
}], "Notes",ExpressionUUID->"b3f4965c-d43a-4ff7-a626-db9cce3b3418"],

Cell[TextData[{
 "The budget ",
 StyleBox["k", "TI"],
 " counts the edges added on each growing side: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb2dfa5b-101f-4037-a5bb-a70fab2b7a74"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa17eef1-e9df-4e6a-8b2c-6805af9b1d5c"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"kmin", ",", " ", "kmax"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5790c466-439e-496f-af41-0b1179c32571"],
 " or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b82711a3-06e0-42c1-a0be-b0e6b839f9d6"],
 ". ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f66ac659-2566-4646-8f4a-196fc6752bb8"],
 " needs ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0aed1a6b-a039-4cc0-a7d9-2b5c7ad5fc1b"],
 " or ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0c507c7-5fd3-4fe0-8694-9a7d69331be9"],
 " on the whole walk, which bound the walks."
}], "Notes",ExpressionUUID->"45f9d742-1898-49d1-b28b-dec19124e2a7"],

Cell[TextData[{
 "Each step chooses the next vertex among the neighbours of the last one, the \
candidates. A property is a name, bare or with its sub-options, ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<name\>\"", ",", " ", 
    RowBox[{"\"\<Window\>\"", " ", "->", " ", "r"}], ",", " ", 
    "\[Ellipsis]"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a09a06c1-41e0-41f8-b651-c305d8d3cda6"],
 ". It reads the ",
 StyleBox["window", "TI"],
 " of a candidate ",
 StyleBox["v", "TI"],
 ": the last ",
 StyleBox["r", "TI"],
 " vertices of the walk followed by ",
 StyleBox["v", "TI"],
 ", so a window of scale ",
 StyleBox["r", "TI"],
 " has ",
 StyleBox["r", "TI"],
 " edges; ",
 StyleBox["r", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d5861f9-d004-461b-a0a2-b725ad0d360a"],
 ", the default, is the whole walk."
}], "Notes",ExpressionUUID->"c4f0105b-1a6d-419a-9174-fcce9ab671a2"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "05cedd09-500c-4464-8415-7158b706a362"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"e6c554a6-dc40-4e73-81e3-3492fbd99cf4"],
     Cell["Effect", "TableText",
     FontWeight->Bold,ExpressionUUID->"20bd589b-264b-4d35-9e23-360e53d93a4d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "08d5b5e2-4e2b-4840-a3b5-5d5004fbbad1"], Cell[TextData[Cell[
    BoxData["\"\<Simple\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "cc3ce997-3afd-4ef5-b86b-6d02713ec0e9"]], "TableText",ExpressionUUID->
     "66beb8c2-3379-47b1-b65d-243507e75eff"], Cell[
    "no vertex twice in the window", "TableText",ExpressionUUID->
     "b96f0ac4-0c36-4125-9eec-13a014c45291"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "97d57f2b-913a-4dc4-91da-5d271a3aa2ef"], Cell[TextData[Cell[
    BoxData["\"\<Geodesic\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "bc9faf96-e918-4c20-81d5-d8896d40159f"]], "TableText",ExpressionUUID->
     "8406bb02-bc01-4d1a-805d-a8067b300779"], Cell[TextData[{
     "every window a shortest path, the walks of ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["RandomInfraGeodesic"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "778b6464-999f-40a4-b77f-56e0d83164ec"]
    }], "TableText",ExpressionUUID->"b60d2d2f-9910-4e3d-84bc-225817ce61fc"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9aaa1ff7-9c8f-4b34-be4c-c7eb3794bad4"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", 
      RowBox[{"\"\<Geodesic\>\"", ",", " ", 
       RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "\[Beta]"}]}], "}"}]], 
     "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5703813a-e387-46b2-9b5e-4e7da2f355d1"]], "TableText",ExpressionUUID->
     "85a3c890-6956-4940-837c-b63574efa12d"], Cell[TextData[{
     "each step prefers the straightest continuation: a candidate is weighed ",
     Cell[BoxData[
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]"}], "]"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7c163b92-b5d4-45cc-8324-487520a6843f"],
     ", \[CapitalDelta] its excess energy, below"
    }], "TableText",ExpressionUUID->"1ee44f9a-3417-459b-8a36-31bec27eed65"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "76d54446-ca4f-4736-bcb4-b9d40a28ddd2"], Cell[TextData[StyleBox[
    "f", "TI"]], "TableText",ExpressionUUID->
     "da3c8b35-ba6a-45f4-af9c-e8ea4147f235"], Cell[TextData[{
     "the energy ",
     Cell[BoxData[
      RowBox[{"f", "[", "window", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "068740fa-e23b-4107-9a19-98fc3a28f472"],
     " \[GreaterEqual] 0: a candidate is weighed ",
     Cell[BoxData[
      RowBox[{"Exp", "[", 
       RowBox[{"-", "\[CapitalDelta]"}], "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "874caed0-a6bd-4283-b5b5-99263217582c"],
     ", the scale inside ",
     StyleBox["f", "TI"],
     "; ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "63e6a924-c485-4e69-a967-a3701dc9bfab"],
     " forbids the window, and a predicate reads ",
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0ad8216e-9490-44c6-901c-48734d473fb5"],
     " as 0 and ",
     Cell[BoxData["False"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0b9bb148-28ce-41c9-a493-4a756d8ce9de"],
     " as ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c5390d18-c56e-437f-8942-94d134d3d51e"],
     ", so it is a constraint"
    }], "TableText",ExpressionUUID->"234e05cf-9d38-4588-ade5-882320ca9628"]}
  }]], "2ColumnTableMod",ExpressionUUID->"b64a091d-4af1-442c-8e12-\
52554a6e59a0"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f9c3e1fc-42a3-4aac-8c56-abc36c16348e"], Cell["Sub-option", "TableText",
     FontWeight->Bold,ExpressionUUID->"fd34e972-b020-4e71-87dd-7ab4582de41a"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"1a436931-81d4-4d05-b0be-81995317e77e"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"4729ff19-f732-48de-82ae-8293bc1ee386"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "94494c44-aaf8-4fc7-bd15-7555a1f2026e"], Cell[TextData[Cell[
    BoxData["\"\<Window\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "24e73d4c-c0a5-4584-9a18-55a1e7993604"]], "TableText",ExpressionUUID->
     "c83aa92e-ec45-4c07-b1cf-438f9469838a"], Cell[TextData[Cell[BoxData[
    "Infinity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "512bc0f1-6183-48b9-a6e1-bdcd0380c4a4"]], "TableText",ExpressionUUID->
     "9a201411-ae60-4ec7-8b3c-4250b8af540e"], Cell[TextData[{
     "a positive integer ",
     StyleBox["r", "TI"],
     ", the window of scale ",
     StyleBox["r", "TI"]
    }], "TableText",ExpressionUUID->"deddb43e-e33a-48c9-9c64-865b2bd1497c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "313beaec-f29d-4204-bd74-f8fc2b6666bb"], Cell[TextData[Cell[
    BoxData["\"\<Straightness\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a376dc86-7d61-4f6f-b952-7cb52dc608f6"]], "TableText",ExpressionUUID->
     "285a25af-15d3-4a55-9517-6daa774012fe"], Cell[TextData[Cell[BoxData[
    "Infinity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ad13f759-e4a4-4d16-b783-163b4fb9f3ae"]], "TableText",ExpressionUUID->
     "87d22ea1-687e-4387-8f19-111fd76cd513"], Cell[TextData[{
     "on ",
     Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "424fbdd6-a1b5-407d-8dd3-a89de97e4349"],
     ", a non-negative number ",
     StyleBox["\[Beta]", "TI"],
     "; ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6707744f-0d54-4b69-84da-75c6930d5b83"],
     " is the shortest path"
    }], "TableText",ExpressionUUID->"21d18ba1-44a4-49bc-8855-7acdc1b70a05"]}
  }]], "3ColumnTableMod",ExpressionUUID->"d784f914-b8b0-4bbe-b506-\
98dda8d9ca42"],

Cell["The properties act in the order given.", "Notes",ExpressionUUID->"7345dc47-ddcc-46e4-98fb-ed72fe200629"],

Cell[TextData[{
 StyleBox["The gain.",
  FontWeight->"Bold"],
 " Let (",
 StyleBox["w", "TI"],
 "\:2080, \[Ellipsis], ",
 StyleBox["w", "TI"],
 "\:209c) be the window before the step, its tip ",
 StyleBox["w", "TI"],
 "\:209c the last vertex of the walk. A candidate ",
 StyleBox["v", "TI"],
 " changes the distance to each earlier vertex ",
 StyleBox["w\:1d62", "TI"],
 " by its ",
 StyleBox["gain", "TI"]
}], "Notes",ExpressionUUID->"f568de94-78a6-4d7d-80d3-56f380341dae"],

Cell[TextData[{
 "  ",
 StyleBox["g\:1d62", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w\:1d62", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") \[Minus] ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w\:1d62", "TI"],
 ", ",
 StyleBox["w\:209c", "TI"],
 ") \[Element] {\[Minus]1, 0, 1}:"
}], "Notes",ExpressionUUID->"4fa340f6-6eb7-416e-9d6d-0dfa82560626"],

Cell[TextData[{
 "1 when ",
 StyleBox["v", "TI"],
 " moves away from ",
 StyleBox["w\:1d62", "TI"],
 ", 0 when it keeps the distance, \[Minus]1 when it comes back. The ",
 StyleBox["mean gain", "TI"]
}], "Notes",ExpressionUUID->"d0c76a43-bf7e-41c0-8552-5a924d671601"],

Cell[TextData[{
 "  ",
 StyleBox["g", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = (",
 StyleBox["g", "TI"],
 "\:2080(",
 StyleBox["v", "TI"],
 ") + ",
 StyleBox["g", "TI"],
 "\:2081(",
 StyleBox["v", "TI"],
 ") + \[CenterEllipsis] + ",
 StyleBox["g", "TI"],
 "\:209c\:208b\:2081(",
 StyleBox["v", "TI"],
 ")) / ",
 StyleBox["t", "TI"]
}], "Notes",ExpressionUUID->"656ca657-5795-48ad-bf2a-157f8e9d88a4"],

Cell[TextData[{
 "lies between \[Minus]1 and 1, and is 1 exactly when ",
 StyleBox["v", "TI"],
 " moves away from every earlier vertex of the window. The tip itself is left \
out: its gain is always 1."
}], "Notes",ExpressionUUID->"fa0bc8ad-826d-4f2e-a1d0-e331ba4b0078"],

Cell[TextData[{
 StyleBox["The energy and the weight.",
  FontWeight->"Bold"],
 " The energy of ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21dd67ed-1868-4c31-b5fb-1df5dee2fc52"],
 " is ",
 StyleBox["E", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = 1 \[Minus] ",
 StyleBox["g", "TI"],
 "(",
 StyleBox["v", "TI"],
 "), between 0 and 2, and 0 while the window is the tip alone. The excess \
energy of ",
 StyleBox["v", "TI"],
 " is its energy against the best candidate ",
 StyleBox["u", "TI"],
 " of the step,"
}], "Notes",ExpressionUUID->"9232bbee-4ab3-4bed-a01f-290c8c0f5910"],

Cell[TextData[{
 "  \[CapitalDelta](",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["E", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") \[Minus] min_",
 StyleBox["u", "TI"],
 " ",
 StyleBox["E", "TI"],
 "(",
 StyleBox["u", "TI"],
 "),"
}], "Notes",ExpressionUUID->"ad5eed4e-5884-4e1a-8638-2ea66afddf55"],

Cell[TextData[{
 "and the step draws ",
 StyleBox["v", "TI"],
 " with probability ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]", 
    RowBox[{"(", "v", ")"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67cde858-eb88-47c5-81e2-0e8b60f97f97"],
 " divided by the sum of ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]", 
    RowBox[{"(", "u", ")"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab11a206-1213-4fba-9f19-cec22f6b233e"],
 " over the candidates: a Boltzmann weight at inverse temperature ",
 StyleBox["\[Beta]", "TI"],
 ". Only differences of energies matter, so ranking by the mean gain is \
ranking by the total distance ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w", "TI"],
 "\:2080, ",
 StyleBox["v", "TI"],
 ") + \[CenterEllipsis] + ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w", "TI"],
 "\:209c\:208b\:2081, ",
 StyleBox["v", "TI"],
 ") to the window, and the exponential is the only weight with this property. \
The mean, not the sum, keeps the cost of a turn independent of the length of \
the window."
}], "Notes",ExpressionUUID->"aa26f5b9-de2d-4fd3-a2d0-fa81150a1927"],

Cell[TextData[{
 StyleBox["The turning angle.",
  FontWeight->"Bold"],
 " Suppose the path distance is close to a rounding of the Euclidean one, the \
window is straight, and the window is not aligned with the mesh. Then for a \
candidate turning by the angle ",
 StyleBox["\[Theta]", "TI"],
 " the mean gain is about cos ",
 StyleBox["\[Theta]", "TI"],
 ": the Euclidean gain against every earlier vertex is cos ",
 StyleBox["\[Theta]", "TI"],
 " up to order 1/",
 StyleBox["s", "TI"],
 ", ",
 StyleBox["s", "TI"],
 " its distance to the tip, and the roundings up and down balance along the \
window. The weight of a step is then about ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{"\[Beta]", " ", "cos", " ", "\[Theta]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d31fa2c6-f64c-44b4-93dd-0d23fc0382c8"],
 ", the von Mises distribution in the turning angle, and for large ",
 StyleBox["\[Beta]", "TI"],
 " about ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", "\[Beta]"}], " ", 
    RowBox[{
     RowBox[{"\[Theta]", "^", "2"}], "/", "2"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d35f08a7-1ac2-4384-a153-3c2c252c439e"],
 ", a Gaussian of variance 1/",
 StyleBox["\[Beta]", "TI"],
 ". So ",
 StyleBox["\[Beta]", "TI"],
 " is a bending rigidity: turns of order 1/\[Sqrt]",
 StyleBox["\[Beta]", "TI"],
 " are typical. For a window aligned with the mesh the roundings do not \
balance and the mean gain is a step function of ",
 StyleBox["\[Theta]", "TI"],
 ", not the cosine."
}], "Notes",ExpressionUUID->"22b9cd69-3da5-4ff2-a4b2-0ee44ac2cc53"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "36be81c2-fb81-418c-ad41-89c73a2eb646"], Cell[TextData[StyleBox[
    "\[Beta]", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"6aa1c1ea-2023-4965-b74e-b9c0b30f6878"],
     Cell["The walk", "TableText",
     FontWeight->Bold,ExpressionUUID->"fa0bab8c-c78b-4038-ae6b-8b537cf81955"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "677b3a9b-63f8-4ecd-a8ff-c6fecbeec5c1"], Cell[
    "0", "TableText",ExpressionUUID->"cc32ee2c-563f-44d0-86ff-2801ccbd0b03"], 
    Cell["the plain random walk: every candidate weighs alike", "TableText",
     ExpressionUUID->"6bd340cf-0b91-4674-9ac7-13a518c13897"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "66d68abe-2804-4ee9-b631-800ef9ed0bb3"], Cell[
    "2", "TableText",ExpressionUUID->"1ddfc92a-e250-4834-bfcc-e9e3fcb33a40"], 
    Cell["wanders, with a preference for going on", "TableText",
     ExpressionUUID->"0f93a061-bdab-4c95-9f06-e8366681e49c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "26aa62b6-d472-4009-8614-80b64c609cb8"], Cell[
    "8", "TableText",ExpressionUUID->"9a3725e6-0548-4f13-a922-25da288cae19"], 
    Cell["bends by about 20\[Degree] per step", "TableText",ExpressionUUID->
     "5a5a09f4-b567-4034-bd84-e437820ad501"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "467f90d7-6ad2-48c5-a987-fbe2c59eebf6"], Cell[
    "32", "TableText",ExpressionUUID->"9c288f38-e9f6-4e93-9f13-cabf890e86b4"],
     Cell["nearly straight", "TableText",ExpressionUUID->
     "538239cc-d2c5-4a3e-954a-346f5b4bec73"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b9457ce8-fcda-48c6-8f0b-81249a0fed9b"], Cell[TextData[{
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "d3fea022-aaf4-4ab2-b833-8827aeb0b6f4"],
     ", the default"
    }], "TableText",ExpressionUUID->"ebd06689-c41a-4921-a1d5-712de7d5b05b"], 
    Cell["\<\
a shortest path: every step has energy 0, and the walk backtracks where no \
candidate has\
\>", "TableText",ExpressionUUID->"c564447b-c3b5-4bcb-b751-13fc6d89941c"]}
  }]], "2ColumnTableMod",ExpressionUUID->"947047c0-abfd-4b63-9598-\
bad013a77c14"],

Cell[TextData[{
 "A walk is a shortest path at scale ",
 StyleBox["r", "TI"],
 " (",
 Cell[BoxData[
  RowBox[{"InfraGeodesicQ", "[", 
   RowBox[{"g", ",", " ", "walk", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60bc366e-8b88-4992-b9de-6cf7396064b3"],
 ") exactly when every step moves away from all the earlier vertices of its \
window, that is when ",
 StyleBox["E", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = 0 at every step: this is ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "075c1c3a-ff42-4685-857f-ac24a8e1c3cf"],
 " with no straightness given. A large finite ",
 StyleBox["\[Beta]", "TI"],
 " takes such a step whenever one exists, and otherwise the least bent one."
}], "Notes",ExpressionUUID->"0438e3cf-5fab-418a-a330-0bf90a3eb42e"],

Cell[TextData[{
 "Under ",
 Cell[BoxData[
  RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<BothSides\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01b1f98e-b8fa-4025-8a05-20de97e1f131"],
 " the window of a step is the joined walk: a step at both ends draws the new \
first vertex on the whole walk, then the new last vertex on the whole walk \
with that new first vertex, so the two halves are straight as one walk."
}], "Notes",ExpressionUUID->"c0a9be2f-3bc2-4e32-97ab-6785ead4c80f"],

Cell[TextData[{
 "The gain sees shortest paths, not Euclidean straightness. On the square \
grid every monotone staircase is a shortest path, and a turn by 90\[Degree] \
has gain 1 like the step straight on, so ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b63c671-92d6-4725-8cd6-34792abf7ea3"],
 " gives a random staircase, not a straight line; a walk straight in the \
Euclidean sense needs a substrate whose shortest paths are straight, such as \
the square mesh."
}], "Notes",ExpressionUUID->"10af080f-d062-4284-9f5b-030641cd6223"],

