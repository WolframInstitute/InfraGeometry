Cell[TextData[{
 "A candidate whose weight is below ",
 Cell[BoxData["$MachineEpsilon"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3222720-08e4-4513-8449-95de532977b9"],
 " times the number of candidates, relative to the best, is never drawn; ",
 Cell[BoxData["RandomSample"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6f013eb-4ff4-4895-b67d-bec799b02a89"],
 " tries it after the others. Under ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b1af8d6-058c-4060-8e13-f3cc65e5f121"],
 " a finite ",
 StyleBox["\[Beta]", "TI"],
 " changes the order of the walks, not the class. A walk also stops when the \
budget is spent or no candidate is left."
}], "Notes",ExpressionUUID->"ee6a4e43-cb27-45e8-9b27-d0eedc6f4ecb"]
}, Open  ]],

