  FontSize->0.9 Inherited,ExpressionUUID->
  "d0f87696-803d-4514-b823-3ad9128ef753"],
 " on the whole walk, and a bare integer as budget, leave the call \
unevaluated:"
}], "ExampleText",ExpressionUUID->"a5c5c50a-7d50-456d-b774-6548b6f4c60e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "Infinity", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"\"\<Geodesic\>\"", ",", " ", 
            RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "5"}]}], "}"}], 
          "}"}]}]}], "]"}]}], ",", " ", 
     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1eb95a8e-3a71-4bb2-b3f7-b7c38f4c1e0e"],

