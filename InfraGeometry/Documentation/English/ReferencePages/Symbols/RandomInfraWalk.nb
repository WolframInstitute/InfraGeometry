     "a7f36006-e952-4ecf-a5ac-1e8e215d0619"], Cell[TextData[Cell[BoxData[
    "0"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5ec9c8ba-2e83-4906-8771-ee56cd52f97c"]], "TableText",ExpressionUUID->
     "ae2912e3-54c7-4440-82c8-357ab1e6d102"], Cell[TextData[{
     "hard: a candidate with ",
     StyleBox["E", "TI"],
     " > 0 is dropped"
    }], "TableText",ExpressionUUID->"8f28524e-302a-42a5-8eb6-b53b2635f9bf"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c5e9b71e-d0f8-4944-ad07-078f63d5c37e"], Cell[TextData[{
     "0 < ",
     StyleBox["p", "TI"],
     " \[LessEqual] 1"
    }], "TableText",ExpressionUUID->"8ed630eb-ccfe-40a4-8372-49e3705e5f3d"], 
    Cell[TextData[{
     "soft: a candidate keeps the weight ",
     StyleBox["p\:1d31", "TI"],
     "; ",
     StyleBox["p", "TI"],
     " = ",
     StyleBox["e", "TI"],
     "^(\[Minus]\[Beta]) is the Boltzmann weight at inverse temperature \
\[Beta]"
    }], "TableText",ExpressionUUID->"ba512932-462b-4862-8828-48ed7a67701c"]}
  }]], "2ColumnTableMod",ExpressionUUID->"b8c34a48-52f4-40c7-9560-\
4078cd4c9b07"],

Cell["\<\
Hard rules cut the class of walks, soft rules put a distribution on it. The \
rules act in the order given.\
\>", "Notes",ExpressionUUID->"3c875dc9-06dc-47e1-95ec-f7613876bbf0"],

Cell[TextData[{
 "The hard ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "271b91d9-2ba9-47be-a394-381ae2a43a81"],
 " gives the self-avoiding walks; on the square grid there are 4, 12, 36, \
100, 284 of 1 to 5 edges from a vertex. The hard ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f233b4b4-5f1f-4551-9500-7e73c649d037"],
 " with no window gives shortest paths."
}], "Notes",ExpressionUUID->"16f0d8d3-f146-481b-b9f2-38afcb75707b"],

