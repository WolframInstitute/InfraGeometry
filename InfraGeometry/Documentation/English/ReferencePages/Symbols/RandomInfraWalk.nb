    "Identity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ccd89c03-526e-4cec-a176-44a7900c2bf4"]], "TableText",ExpressionUUID->
     "5d2af500-535e-42b3-bf7f-bdd3922dd6e8"], Cell[
    "canonical, the weights ignored", "TableText",ExpressionUUID->
     "34172771-a5b0-4a3f-b80e-9897ec57ca69"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
