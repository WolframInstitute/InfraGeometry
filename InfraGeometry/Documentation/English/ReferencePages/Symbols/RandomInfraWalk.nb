Cell[TextData[{
 "One step: a walk of 6 edges from the centre of the square mesh, its \
candidates for the next vertex labelled by their excess defect \
\[CapitalDelta]. The candidate of \[CapitalDelta] = 0 moves away from every \
earlier vertex; the other has \[CapitalDelta] = 6/7 and at ",
 StyleBox["\[Beta]", "TI"],
 " = 8 is drawn about 950 times less often, the factor ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{"8", " ", "\[CenterDot]", " ", 
    RowBox[{"6", "/", "7"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "889c8792-f987-4a47-9925-fdd6489c1762"],
 ":"
}], "ExampleText",ExpressionUUID->"5bdd245e-98e6-44f9-9f38-5e1b7e1eb390"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walk", " ", "=", " ", 
     RowBox[{"Last", " ", "/@", " ", 
      RowBox[{"VertexList", " ", "@", " ", 
       RowBox[{"RandomInfraWalk", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", 
         RowBox[{"{", "6", "}"}], ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<Simple\>\"", ",", " ", 
            RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "8"}]}], "}"}]}], 
         ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"defect", " ", "=", " ", 
      RowBox[{"w", " ", "|->", " ", 
       RowBox[{"Mean", " ", "@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Length", "[", "w", "]"}], " ", "-", " ", "i"}], ")"}], 
           " ", "-", " ", 
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"w", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
             RowBox[{"Last", "[", "w", "]"}]}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", 
            RowBox[{
             RowBox[{"Length", "[", "w", "]"}], " ", "-", " ", "1"}]}], 
           "}"}]}], "]"}]}]}]}], ",", "\n", "   ", 
     RowBox[{"candidates", " ", "=", " ", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", 
