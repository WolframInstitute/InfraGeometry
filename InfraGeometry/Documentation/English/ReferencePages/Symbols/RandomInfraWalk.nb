Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraWalk", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9fee12e8-5901-43a3-aae2-9fc6ff9fcf25"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cff88e6c-c9a0-4dfd-b182-ad5157ff5e85"],
 "\[LineSeparator]",
 "gives a random walk grown from ",
 StyleBox["germ", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " by at most the budget ",
 StyleBox["k", "TI"],
 " of edges, each step under the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Properties"]], "paclet:ref/Properties"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "917ecc46-1fc2-4ae8-90f5-72ab98675fe9"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"71156cb2-c956-4ade-8de7-2b8984485a4e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["k", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7925621b-6fda-4bd9-84f7-cee34d84c3bd"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " distinct walks.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d3142ed8-1802-4123-b43b-b336d83d1c97"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "caa2200b-3db5-43c0-81c8-1fdc4749f61d"],
 "\[LineSeparator]",
 "grows the walk with no budget, until no admissible step remains or the \
stopping condition fires."
}], "Usage",ExpressionUUID->"8b82caed-72a2-4f55-a346-3268afbfcac3"],

Cell[TextData[{
 "The germ is a vertex, a vertex list or a walk graph; a list of germs gives \
the walks grown from each. A walk is returned as a directed path graph on the \
pairs {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "}; ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1088e62e-cee2-420b-a342-9c0e876e563d"],
 " is its vertex sequence."
}], "Notes",ExpressionUUID->"fc65102e-3bb2-4d29-856e-68686acae224"],

Cell[TextData[{
 "The budget ",
 StyleBox["k", "TI"],
 " counts the edges added on each growing side: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "959d02c1-6f83-4763-a5d3-1b48604903cb"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62c0f562-5312-4ec0-8f2d-43e0b20eff16"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"kmin", ",", " ", "kmax"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05876cf7-4b14-4d13-95c2-babf2a3ed449"],
 " or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ddde3525-a129-4ad8-9ffb-d698fd192d94"],
 ". ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24f8aeb9-9495-463f-93f7-b05c905df141"],
 " needs ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc7f87b6-b217-4d1e-b9c2-b0c0a9034e48"],
 " or ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e3e463e-9940-468b-84d6-a8fb0d274434"],
 " on the whole walk, which bound the walks."
}], "Notes",ExpressionUUID->"8a463497-2477-4459-a120-3026e813f294"],

Cell[TextData[{
 "Each step chooses the next vertex among the neighbours of the last one, the \
candidates. A property is a name, bare or with its sub-options, ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<name\>\"", ",", " ", 
    RowBox[{"\"\<Window\>\"", " ", "->", " ", "r"}], ",", " ", 
    "\[Ellipsis]"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d413da67-0870-4ff8-848f-d94115ac5cf9"],
 ". It reads the ",
 StyleBox["window", "TI"],
 " of a candidate ",
 StyleBox["v", "TI"],
 ": the last ",
 StyleBox["r", "TI"],
 " vertices of the walk followed by ",
 StyleBox["v", "TI"],
 ", so a window of scale ",
 StyleBox["r", "TI"],
 " has ",
 StyleBox["r", "TI"],
 " edges; ",
 StyleBox["r", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa4940b1-6bc2-4aa9-8485-ad80bc100755"],
 ", the default, is the whole walk."
}], "Notes",ExpressionUUID->"547d6abf-90e6-4bd0-a1e1-b8446b3bef55"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f2898db8-f956-4cde-8436-ee46a15ec402"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"1bd58827-7870-46a0-ad63-f4c2fd2a902e"],
     Cell["Effect", "TableText",
     FontWeight->Bold,ExpressionUUID->"91455897-4f15-40b9-9c50-4d667ff1586a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ed1ace5d-6c09-44ba-b28e-68e6348dfafa"], Cell[TextData[Cell[
    BoxData["\"\<Simple\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "28e59286-7b4a-403b-a46e-741f34b67ed1"]], "TableText",ExpressionUUID->
     "4eaac801-4bd4-4d6f-beba-77141e022bfa"], Cell[
    "no vertex twice in the window", "TableText",ExpressionUUID->
     "372624ed-a053-4407-83b2-1f1766f5f94c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "366d6b75-0353-422f-914c-5450b7872b64"], Cell[TextData[Cell[
    BoxData["\"\<Geodesic\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "e147bef2-0693-47ad-944e-f8933a8b065c"]], "TableText",ExpressionUUID->
     "bfaa3cf4-226c-4d55-8d22-cfa771a86e09"], Cell[TextData[{
     "every window a shortest path, the walks of ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["RandomInfraGeodesic"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "1ca1f3bb-41c9-4b47-9e5b-04efdd7b2fc4"]
    }], "TableText",ExpressionUUID->"c4eacd79-ea03-466c-a13c-6b0e2890182a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "666e3a85-86b2-4aae-a3b7-e5aa85deb7d6"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", 
      RowBox[{"\"\<Geodesic\>\"", ",", " ", 
       RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "\[Beta]"}]}], "}"}]], 
     "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "af13991b-f2ab-4fb8-9135-76a1941289cc"]], "TableText",ExpressionUUID->
     "4e47d86c-92d1-4286-b78a-f88ebe554caa"], Cell[TextData[{
     "each step prefers the straightest continuation: a candidate is weighed ",
     Cell[BoxData[
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]"}], "]"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "146628d8-58d0-4b23-82ec-fa847bbc93c5"],
     ", \[CapitalDelta] its excess energy, below"
    }], "TableText",ExpressionUUID->"d393250b-c616-48f2-ae30-3ab88549bdb2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1236047d-7e96-44fc-8be1-2e5112d4f757"], Cell[TextData[StyleBox[
    "f", "TI"]], "TableText",ExpressionUUID->
     "911e1bf0-4682-4356-b3de-2a90f67ec995"], Cell[TextData[{
     "the energy ",
     Cell[BoxData[
      RowBox[{"f", "[", "window", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9d3b5592-edca-4309-be53-e5593a0cb203"],
     " \[GreaterEqual] 0: a candidate is weighed ",
     Cell[BoxData[
      RowBox[{"Exp", "[", 
       RowBox[{"-", "\[CapitalDelta]"}], "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "94d8b8eb-6f3a-417f-b79f-d4324b7fb3e6"],
     ", the scale inside ",
     StyleBox["f", "TI"],
     "; ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b1292a8b-44d3-43ed-9e4d-311f6c17f241"],
     " forbids the window, and a predicate reads ",
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "25bbd1db-5944-43f8-b3c7-db5ebb1b35e1"],
     " as 0 and ",
     Cell[BoxData["False"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "85cc5d39-0a32-47da-9098-9cf5ac145c87"],
     " as ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0e1dccf1-717d-4bf0-8473-709a600e11af"],
     ", so it is a constraint"
    }], "TableText",ExpressionUUID->"f379f9b3-02c6-48d0-bb66-412e91bda6b8"]}
  }]], "2ColumnTableMod",ExpressionUUID->"ad5f46f2-bed0-4eb3-a181-\
281104a675c7"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "77556f7f-0216-48d8-8983-4422936846d9"], Cell["Sub-option", "TableText",
     FontWeight->Bold,ExpressionUUID->"e33ea1ff-8958-4dbf-8288-deefe3092ce7"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"a2a262a5-e955-4716-8068-f01a4bde63fb"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"fea00029-5848-4bc3-9783-e0dfb245d65d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2ae9e1a4-ffc0-401e-8177-b9a6a647cff4"], Cell[TextData[Cell[
    BoxData["\"\<Window\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d5690f7a-491f-41d2-bc69-4f7582ea1c57"]], "TableText",ExpressionUUID->
     "dbcda3a2-c0ee-47a8-ab9d-6611b6d75471"], Cell[TextData[Cell[BoxData[
    "Infinity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "af3ecd4d-7ea8-4065-ad9b-ce562e4ec62c"]], "TableText",ExpressionUUID->
     "bc5d054b-882a-4545-86cf-b95aaa273b8c"], Cell[TextData[{
     "a positive integer ",
     StyleBox["r", "TI"],
     ", the window of scale ",
     StyleBox["r", "TI"]
    }], "TableText",ExpressionUUID->"148cb7a8-8914-40bf-a21d-ad7d619400e2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "49507689-c818-4d40-9874-4b7986c2d628"], Cell[TextData[Cell[
    BoxData["\"\<Straightness\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "37498b2c-8caf-4282-9575-79382d551550"]], "TableText",ExpressionUUID->
     "b656d731-4202-4e91-8273-6ac3d1c97599"], Cell[TextData[Cell[BoxData[
    "Infinity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b047abd1-4c84-4477-95a9-548cbd494c62"]], "TableText",ExpressionUUID->
     "e79185b7-750f-4d89-9582-bfbe9c121e5e"], Cell[TextData[{
     "on ",
     Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "15eb3d4a-522c-4ad8-8e73-0a6e39e966e7"],
     ", a non-negative number ",
     StyleBox["\[Beta]", "TI"],
     "; ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e3a126fa-0870-451e-b002-927c9c6b8740"],
     " is the shortest path"
    }], "TableText",ExpressionUUID->"7523a2fe-6d3b-4199-91d5-c7e5e168c1e5"]}
  }]], "3ColumnTableMod",ExpressionUUID->"a6fef6a2-1854-4316-a852-\
8bd8454eeace"],

Cell["The properties act in the order given.", "Notes",ExpressionUUID->"e40f5cea-1f92-4928-92ef-ed7229301a81"],

Cell[TextData[{
 StyleBox["The gain.",
  FontWeight->"Bold"],
 " Let (",
 StyleBox["w", "TI"],
 "\:2080, \[Ellipsis], ",
 StyleBox["w", "TI"],
 "\:209c) be the window before the step, its tip ",
 StyleBox["w", "TI"],
 "\:209c the last vertex of the walk. A candidate ",
 StyleBox["v", "TI"],
 " changes the distance to each earlier vertex ",
 StyleBox["w\:1d62", "TI"],
 " by its ",
 StyleBox["gain", "TI"]
}], "Notes",ExpressionUUID->"dd0d73dc-c13f-4a0f-b7f3-8ef03e495216"],

Cell[TextData[{
 "  ",
 StyleBox["g\:1d62", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w\:1d62", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") \[Minus] ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w\:1d62", "TI"],
 ", ",
 StyleBox["w\:209c", "TI"],
 ") \[Element] {\[Minus]1, 0, 1}:"
}], "Notes",ExpressionUUID->"06e41df4-ed0e-4092-b75d-6a6bd58bd74b"],

Cell[TextData[{
 "1 when ",
 StyleBox["v", "TI"],
 " moves away from ",
 StyleBox["w\:1d62", "TI"],
 ", 0 when it keeps the distance, \[Minus]1 when it comes back. The ",
 StyleBox["mean gain", "TI"]
}], "Notes",ExpressionUUID->"fd453ff7-122b-448f-80d2-f99d5bfc6397"],

Cell[TextData[{
 "  ",
 StyleBox["g", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = (",
 StyleBox["g", "TI"],
 "\:2080(",
 StyleBox["v", "TI"],
 ") + ",
 StyleBox["g", "TI"],
 "\:2081(",
 StyleBox["v", "TI"],
 ") + \[CenterEllipsis] + ",
 StyleBox["g", "TI"],
 "\:209c\:208b\:2081(",
 StyleBox["v", "TI"],
 ")) / ",
 StyleBox["t", "TI"]
}], "Notes",ExpressionUUID->"f8472148-3087-4402-9c26-bdb5142e446f"],

Cell[TextData[{
 "lies between \[Minus]1 and 1, and is 1 exactly when ",
 StyleBox["v", "TI"],
 " moves away from every earlier vertex of the window. The tip itself is left \
out: its gain is always 1."
}], "Notes",ExpressionUUID->"917d535a-35be-4c60-82a0-c858e0f02efa"],

Cell[TextData[{
 StyleBox["The energy and the weight.",
  FontWeight->"Bold"],
 " The energy of ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1f63a9e-f36c-4d6d-b325-ae24f42c8c97"],
 " is ",
 StyleBox["E", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = 1 \[Minus] ",
 StyleBox["g", "TI"],
 "(",
 StyleBox["v", "TI"],
 "), between 0 and 2, and 0 while the window is the tip alone. The excess \
energy of ",
 StyleBox["v", "TI"],
 " is its energy against the best candidate ",
 StyleBox["u", "TI"],
 " of the step,"
}], "Notes",ExpressionUUID->"693b3bca-80f8-4ddc-ae35-b895f5e15624"],

Cell[TextData[{
 "  \[CapitalDelta](",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["E", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") \[Minus] min_",
 StyleBox["u", "TI"],
 " ",
 StyleBox["E", "TI"],
 "(",
 StyleBox["u", "TI"],
 "),"
}], "Notes",ExpressionUUID->"c2e2f575-f899-481b-920e-0f3a43f3d8b0"],

Cell[TextData[{
 "and the step draws ",
 StyleBox["v", "TI"],
 " with probability ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]", 
    RowBox[{"(", "v", ")"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b13dd0b-71a3-43fe-8c9e-c5fee0d0151a"],
 " divided by the sum of ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", "\[Beta]"}], " ", "\[CapitalDelta]", 
    RowBox[{"(", "u", ")"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c734cc6d-34e0-46e5-a987-ca75f5ddd342"],
 " over the candidates: a Boltzmann weight at inverse temperature ",
 StyleBox["\[Beta]", "TI"],
 ". Only differences of energies matter, so ranking by the mean gain is \
ranking by the total distance ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w", "TI"],
 "\:2080, ",
 StyleBox["v", "TI"],
 ") + \[CenterEllipsis] + ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["w", "TI"],
 "\:209c\:208b\:2081, ",
 StyleBox["v", "TI"],
 ") to the window, and the exponential is the only weight with this property. \
The mean, not the sum, keeps the cost of a turn independent of the length of \
the window."
}], "Notes",ExpressionUUID->"a7e9b63c-b6c3-4702-871a-25c55d95486f"],

Cell[TextData[{
 StyleBox["The turning angle.",
  FontWeight->"Bold"],
 " Suppose the path distance is close to a rounding of the Euclidean one, the \
window is straight, and the window is not aligned with the mesh. Then for a \
candidate turning by the angle ",
 StyleBox["\[Theta]", "TI"],
 " the mean gain is about cos ",
 StyleBox["\[Theta]", "TI"],
 ": the Euclidean gain against every earlier vertex is cos ",
 StyleBox["\[Theta]", "TI"],
 " up to order 1/",
 StyleBox["s", "TI"],
 ", ",
 StyleBox["s", "TI"],
 " its distance to the tip, and the roundings up and down balance along the \
window. The weight of a step is then about ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{"\[Beta]", " ", "cos", " ", "\[Theta]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eee2a5f-f35e-4835-8f0d-b6863694838b"],
 ", the von Mises distribution in the turning angle, and for large ",
 StyleBox["\[Beta]", "TI"],
 " about ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", "\[Beta]"}], " ", 
    RowBox[{
     RowBox[{"\[Theta]", "^", "2"}], "/", "2"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4a9c7a2-5d84-49e7-8c44-b53e6b9b50ea"],
 ", a Gaussian of variance 1/",
 StyleBox["\[Beta]", "TI"],
 ". So ",
 StyleBox["\[Beta]", "TI"],
 " is a bending rigidity: turns of order 1/\[Sqrt]",
 StyleBox["\[Beta]", "TI"],
 " are typical. For a window aligned with the mesh the roundings do not \
balance and the mean gain is a step function of ",
 StyleBox["\[Theta]", "TI"],
 ", not the cosine."
}], "Notes",ExpressionUUID->"89c18456-a567-47d1-bcaa-feb88d5f821a"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "21c03c19-6560-478e-9973-50db39b1dfcd"], Cell[TextData[StyleBox[
    "\[Beta]", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"3c9cb1a8-49a2-4e96-b588-f367cbe6731f"],
     Cell["The walk", "TableText",
     FontWeight->Bold,ExpressionUUID->"4491aaf2-9fc4-47fc-9076-c39b79bf21f9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "74c49b21-6a78-41b7-a98a-a5ff537e7777"], Cell[
    "0", "TableText",ExpressionUUID->"c871b9d5-38ee-414b-8f80-232d04ad6c5e"], 
    Cell["the plain random walk: every candidate weighs alike", "TableText",
     ExpressionUUID->"62165a0b-60c3-486e-82d6-806b1f9c63ca"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b6db97db-ae46-430d-b68b-60291cb4001b"], Cell[
    "2", "TableText",ExpressionUUID->"509ed88b-a5c3-4151-9726-f56d3c09a2cc"], 
    Cell["wanders, with a preference for going on", "TableText",
     ExpressionUUID->"8cb3f07e-fe24-4494-807b-338852467ccd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "981fc7d6-7331-4082-aabc-ee579545e8f8"], Cell[
    "8", "TableText",ExpressionUUID->"b3a84628-eec3-4785-854a-c83f2953b0b7"], 
    Cell["bends by about 20\[Degree] per step", "TableText",ExpressionUUID->
     "7c20a365-f05d-4cd9-8148-ccd7079c9492"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a24d4470-06e5-48cf-96c7-4f824eb9fe91"], Cell[
    "32", "TableText",ExpressionUUID->"9a727590-6aae-4537-8e33-20343fe5f808"],
     Cell["nearly straight", "TableText",ExpressionUUID->
     "f22b0cd6-02fe-4b1a-9269-86497f173ff6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2125f5c2-8acc-4aed-a92b-df9158856a57"], Cell[TextData[{
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "afb872ef-f6fc-4d03-9b45-533043243e52"],
     ", the default"
    }], "TableText",ExpressionUUID->"00e8263a-9875-4b9d-8e71-6236a789a4a5"], 
    Cell["\<\
a shortest path: every step has energy 0, and the walk backtracks where no \
candidate has\
\>", "TableText",ExpressionUUID->"03cc6f33-6441-4f4f-b11c-68b33dd97b04"]}
  }]], "2ColumnTableMod",ExpressionUUID->"69fecb92-5bfc-4535-9921-\
d737954d04b1"],

Cell[TextData[{
 "A walk is a shortest path at scale ",
 StyleBox["r", "TI"],
 " (",
 Cell[BoxData[
  RowBox[{"InfraGeodesicQ", "[", 
   RowBox[{"g", ",", " ", "walk", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7856506a-305d-47dc-ac0e-8c4446b6ae5a"],
 ") exactly when every step moves away from all the earlier vertices of its \
window, that is when ",
 StyleBox["E", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") = 0 at every step: this is ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ac49c49-e2ed-4548-9ee5-3baea41959cb"],
 " with no straightness given. A large finite ",
 StyleBox["\[Beta]", "TI"],
 " takes such a step whenever one exists, and otherwise the least bent one."
}], "Notes",ExpressionUUID->"afb26ed6-e57c-43df-afc7-1e4edad74560"],

Cell[TextData[{
 "Under ",
 Cell[BoxData[
  RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<BothSides\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0035fd0-358f-4056-84b1-5295a0642abf"],
 " the window of a step is the joined walk: a step at both ends draws the new \
first vertex on the whole walk, then the new last vertex on the whole walk \
with that new first vertex, so the two halves are straight as one walk."
}], "Notes",ExpressionUUID->"33df2d3e-0727-4b1f-9762-38e6a91776f2"],

Cell[TextData[{
 "The gain sees shortest paths, not Euclidean straightness. On the square \
grid every monotone staircase is a shortest path, and a turn by 90\[Degree] \
has gain 1 like the step straight on, so ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf7a2c1c-0776-413d-8073-da7f6feb6302"],
 " gives a random staircase, not a straight line; a walk straight in the \
Euclidean sense needs a substrate whose shortest paths are straight, such as \
the square mesh."
}], "Notes",ExpressionUUID->"32685816-4e8b-49a2-8ac4-c5928fef012a"],

