Cell[TextData[{
 "A walk is a shortest path exactly when every step has defect 0. At ",
 StyleBox["\[Beta]", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af2aa9cc-b2f1-4b4c-a710-3c64951e047e"],
 " on the mesh some walks of 10 edges from the centre are, and some meet a \
vertex where no candidate has defect 0; the pairs agree. The exact shortest \
paths from a germ are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "db0c2caf-dbf5-425d-a9c7-840c53122d0c"],
 ":"
}], "ExampleText",ExpressionUUID->"3f1dd758-a3d8-4edc-9f11-87ac0f357ae8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"defect", " ", "=", " ", 
     RowBox[{"w", " ", "|->", " ", 
      RowBox[{"Mean", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Length", "[", "w", "]"}], " ", "-", " ", "i"}], ")"}], 
          " ", "-", " ", 
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"w", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
            RowBox[{"Last", "[", "w", "]"}]}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{
            RowBox[{"Length", "[", "w", "]"}], " ", "-", " ", "1"}]}], 
          "}"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"w", " ", "=", " ", 
         RowBox[{"Last", " ", "/@", " ", 
          RowBox[{"VertexList", " ", "@", " ", 
           RowBox[{"RandomInfraWalk", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", 
             RowBox[{"{", "10", "}"}], ",", " ", 
             RowBox[{"Properties", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<Simple\>\"", ",", " ", 
                
                RowBox[{"\"\<Straightness\>\"", " ", "->", " ", 
                 "Infinity"}]}], "}"}]}], ",", " ", 
             RowBox[{"RandomSeeding", " ", "->", " ", "s"}]}], "]"}]}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"defect", " ", "@", " ", 
              RowBox[{"Take", "[", 
               RowBox[{"w", ",", " ", "k"}], "]"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"k", ",", " ", "2", ",", " ", 
               RowBox[{"Length", "[", "w", "]"}]}], "}"}]}], "]"}], ",", " ", 
           
           RowBox[{
            RowBox[{"#", " ", "==", " ", "0"}], " ", "&"}]}], "]"}], ",", " ", 
         RowBox[{"InfraGeodesicQ", "[", 
          RowBox[{"g", ",", " ", "w"}], "]"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c4d8183f-1eed-4964-aeb4-e16520976109"],

