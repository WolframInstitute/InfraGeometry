Cell["Properties", "ExampleSubsection",ExpressionUUID->"908cdc5c-43bc-487e-b703-ef7c83bf520e"],

Cell[TextData[{
 "The walks of 4 edges on the grid: self-avoiding, without a step back, and \
all of them, ",
 StyleBox["100", "TI"],
 ", ",
 StyleBox["4 \[CenterDot] 3\.b3 = 108", "TI"],
 " and ",
 StyleBox["4\:2074 = 256", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"eeb41305-633a-47ab-ab0e-f7159d1f5c0c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"rules", " ", "->", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"RandomInfraWalk", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", 
         RowBox[{"{", "4", "}"}], ",", " ", "All", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", "rules"}]}], "]"}]}]}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"rules", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "\"\<Simple\>\"", "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"\"\<Simple\>\"", ",", " ", 
            RowBox[{"\"\<Window\>\"", " ", "->", " ", "2"}]}], "}"}], "}"}], ",",
          " ", 
         RowBox[{"{", "}"}]}], "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"56270851-b179-4251-830f-a3496207af21"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"{", "\<\"Simple\"\>", "}"}], "\[Rule]", "100"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"\<\"Simple\"\>", ",", 
       RowBox[{"\<\"Window\"\>", "\[Rule]", "2"}]}], "}"}], "}"}], "\[Rule]", 
    "108"}], ",", 
   RowBox[{
