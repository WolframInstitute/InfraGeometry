Cell[TextData[{
 "Under ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "baaabb57-a7b3-4ecd-a95f-40ae111b042f"],
 " the predicate reads both tips: the shortest paths through an edge of the \
grid stop when the back reaches 22 or the front reaches 28, whichever comes \
first."
}], "ExampleText",ExpressionUUID->"6b2b36e6-2ff2-408e-b137-569d9eee5b9f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"7", ",", " ", "7"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{"RandomInfraWalk", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"24", ",", " ", "25"}], "}"}], ",", " ", "Infinity", ",", " ",
        "All", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Shortest\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<BothSides\>\""}], ",",
        "\n", "    ", 
       RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"First", "[", "#", "]"}], " ", "===", " ", "22"}], " ", "||",
            " ", 
           RowBox[{
            RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "28"}]}], " ", 
          "&"}], ")"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"stopped", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"walks", ",", " ", 
       RowBox[{
        RowBox[{"MatchQ", "[", 
         RowBox[{
          RowBox[{"Last", " ", "/@", " ", 
           RowBox[{"VertexList", " ", "@", " ", "#"}]}], ",", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"22", ",", " ", "__"}], "}"}], " ", "|", " ", 
           RowBox[{"{", 
            RowBox[{"__", ",", " ", "28"}], "}"}]}]}], "]"}], " ", "&"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"stopped", ",", " ", 
         RowBox[{"{", 
          RowBox[{"24", ",", " ", "25"}], "}"}], ",", " ", "22", ",", " ", 
         "28"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"walks", ",", " ", "stopped"}], "}"}]}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d18c5306-363a-4dad-99af-7af2b69cb2a2"],

