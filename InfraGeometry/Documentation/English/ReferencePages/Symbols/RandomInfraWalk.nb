     "cd553b6f-6ba1-4bec-a35f-dc0f17bac788"]], "TableText",ExpressionUUID->
     "a25c1510-9552-4da6-bb2b-57bc6f649ea2"], Cell[
    "canonical, the weights ignored", "TableText",ExpressionUUID->
     "b602c5f6-a336-4aa6-af50-a749b689727a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "cbc37c5f-c57a-4565-83db-271aa0f52732"], Cell[TextData[Cell[BoxData[
    "RandomSample"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "e029c68d-2e68-4714-aaf8-2fcfdc473d19"]], "TableText",ExpressionUUID->
     "149056e9-2234-4f4f-8af3-da5d4f07f9f6"], Cell[
    "random by the weights, uniform without a soft rule", "TableText",
     ExpressionUUID->"dab673c7-257a-4ee7-830d-479f1ee5f826"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1277c878-0bdf-455a-99ed-ab0f6197a789"], Cell[TextData[Cell[BoxData[
    "RandomChoice"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "97e53a84-c640-4951-9f85-8c7ea3044d0b"]], "TableText",ExpressionUUID->
     "28f32a18-aee4-4f9a-b449-79ffb31fc40d"], Cell["\<\
one candidate drawn by the weights: the random walk, which never backtracks\
\>", "TableText",ExpressionUUID->"f9ad2d2c-c2e0-4bad-b497-575079471b82"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6a0df5a0-bb25-4826-b750-db30ee70b576"], Cell[TextData[{
     StyleBox["f", "TI"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"f", ",", " ", "r"}], "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9df6aa24-c534-4b86-9821-18661153fcc7"]
    }], "TableText",ExpressionUUID->"8328df3d-8469-444a-9d7c-69bb3acd06b1"], 
    Cell[TextData[{
     Cell[BoxData["f"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4200201a-d034-4b05-a7c0-a0a515787c7f"],
     " of the candidate windows, whole or of scale ",
     StyleBox["r", "TI"],
     ", giving the ones to pursue in order; the weights ignored"
    }], "TableText",ExpressionUUID->"1c6fc7d8-9d2f-4f42-80ae-ff7407099be8"]}
  }]], "2ColumnTableMod",ExpressionUUID->"57ad66b4-ea90-4b2d-9842-\
e8629376c6ee"],

Cell[TextData[{
 "Every order works with every rule. ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bed33369-2d0a-43a8-9f42-76822654ce89"],
 " and a function do not see the weights, so under them a soft rule changes \
nothing. ",
 Cell[BoxData["RandomSample"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca64e373-e10a-49af-8290-d5ef5a4bc4ca"],
 " is a permutation, so ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae8bb3d9-0af4-4373-ac25-3753fbdea02e"],
 " is the whole class whatever the weights. Under ",
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77f6e476-fb56-4bd5-838f-eeac141892b0"],
 " the count ",
 StyleBox["n", "TI"],
 " is ",
 StyleBox["n", "TI"],
 " independent runs from the germ, and the runs that met ",
 StyleBox["kspec", "TI"],
 " are returned; a pruning to ",
 StyleBox["m", "TI"],
 " branches per step is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"RandomSample", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"UpTo", "[", "m", "]"}]}], "]"}], " ", "&"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "051d9c6b-eecc-4c29-8afd-dcea72304ba0"],
 "."
}], "Notes",ExpressionUUID->"b8d13abf-cf2f-4dc1-92ba-5f4f41638c36"],

Cell[TextData[{
 Cell[BoxData["\"\<Direction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c69b7361-49cd-4c06-afa7-40efd60acd72"],
 " says where the walk grows: ",
 Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12251a4a-caab-4ac4-be4f-0d8b84ed9b0d"],
 " after the last vertex of the germ, ",
 Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c91d4dd8-b59d-4b1a-b1cf-7e25d83add42"],
 " before the first, ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af907243-fe1a-4bec-b656-d946bc51b098"],
 " at both ends. Under ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35648387-e23f-4b27-be26-65bbb8570239"],
 " each outer step grows both ends, the front only or the back only, the hard \
",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93e651c8-06a0-462e-8d9d-d5b6a90d5156"],
 " and ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33b9a8b7-d6ce-4bf3-8931-2c9c9d85ff3b"],
 " are checked again on the window holding both new ends, and the budget is \
the edges added on the longer side."
}], "Notes",ExpressionUUID->"333d379e-039d-44a2-b92a-1c957bb23036"],

Cell[TextData[{
 Cell[BoxData["\"\<StoppingCondition\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "704b92d3-cafe-4faa-a183-870426160349"],
 " is a predicate on the whole walk so far, its vertex sequence, read after \
every step and on the germ once it has an edge. It can test both tips, and \
when it fires the walk stops on both sides. A walk also stops when the budget \
is spent or no admissible step remains."
}], "Notes",ExpressionUUID->"a1dbd4ab-0963-4144-8a34-45510f9aeea6"],

Cell[TextData[{
 "An endpoint is a stopping condition. ",
 Cell[BoxData[
  RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "q"}], " ", "&"}], 
    ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b977f6a5-21ae-48b6-8716-87ffcfbabaf5"],
 " stops each walk at its first arrival at ",
 StyleBox["q", "TI"],
 "; the walks that end at ",
 StyleBox["q", "TI"],
 " are the walks from the germ to ",
 StyleBox["q", "TI"],
 ". A shortest path between two points is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "44bbf778-591f-41e8-a801-ef5f6dc0e171"],
 "; the walk family has no two-point form."
}], "Notes",ExpressionUUID->"785291c2-1686-4a76-865c-aaea20053ef8"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bc84d0b9-b5a2-4a93-bc2d-09be9f45c7c1"],
 " is this call with ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Shortest\>\"", ",", " ", "s"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8503baf8-58d9-4cc6-b800-5353c1d6c159"],
 " first among the rules."
}], "Notes",ExpressionUUID->"7bf7da24-aece-49d9-9fab-b3e55452513b"]
}, Open  ]],

