Cell[TextData[{
 Cell[BoxData["\"\<Straightness\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b0d090b-4a24-409c-b275-1f6728f01f6f"],
 " is the energy 1 \[Minus] ",
 StyleBox["g", "TI"],
 "(",
 StyleBox["v", "TI"],
 "), one minus the mean gain, written out as a user energy, walk for walk:"
}], "ExampleText",ExpressionUUID->"385a077d-ad35-47cf-99a6-566847c54b12"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"energy", " ", "=", " ", 
     RowBox[{"w", " ", "|->", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "w", "]"}], " ", "<", " ", "3"}], ",", " ", 
        "0", ",", "\n", "     ", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"Mean", " ", "@", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"w", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
               RowBox[{"Last", "[", "w", "]"}]}], "]"}], " ", "-", " ", 
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"w", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
               RowBox[{"w", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "2"}], "]"}], "]"}]}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", 
              RowBox[{
               RowBox[{"Length", "[", "w", "]"}], " ", "-", " ", "2"}]}], 
             "}"}]}], "]"}]}]}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"{", "10", "}"}], ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Straightness\>\"", " ", "->", " ", "2"}], "}"}]}], ",",
         " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "s"}]}], "]"}], " ", "===", 
      "\n", "    ", 
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"{", "10", "}"}], ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"energy", " ", "->", " ", "2"}], "}"}]}], ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "s"}]}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "5"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9c3a7eef-ec7e-4d93-8a51-594795ab9428"],

