Cell[TextData[{
 "A walk is a shortest path exactly when every step has energy 0. At ",
 StyleBox["\[Beta]", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e7b2759-306b-401f-a945-9087a847f5f2"],
 " on the mesh some walks of 10 edges from the centre are, and some meet a \
vertex where no candidate has energy 0; the pairs agree. The exact shortest \
paths from a germ are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "17a64df2-f6fe-4a68-9414-542582f1a5d9"],
 ":"
}], "ExampleText",ExpressionUUID->"b5931754-aa15-4bdd-b5f2-718ed1ab90c3"],

