Cell[TextData[{
 "The straightness of ",
 Cell[BoxData["\"\<Geodesic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b68cb43f-a01c-4465-ace1-91ea1fe65991"],
 " is the energy 1 \[Minus] ",
 StyleBox["g", "TI"],
 "(",
 StyleBox["v", "TI"],
 "), one minus the mean gain, written out as a user energy scaled by ",
 StyleBox["\[Beta]", "TI"],
 ", walk for walk:"
}], "ExampleText",ExpressionUUID->"da586902-3eac-49b2-afec-d26fe58dd80e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"energy", " ", "=", " ", 
     RowBox[{"w", " ", "|->", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "w", "]"}], " ", "<", " ", "3"}], ",", " ", 
        "0", ",", "\n", "     ", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"Mean", " ", "@", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"w", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
               RowBox[{"Last", "[", "w", "]"}]}], "]"}], " ", "-", " ", 
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"w", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
               RowBox[{"w", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "2"}], "]"}], "]"}]}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", 
              RowBox[{
               RowBox[{"Length", "[", "w", "]"}], " ", "-", " ", "2"}]}], 
             "}"}]}], "]"}]}]}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"RandomInfraWalk", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"{", "10", "}"}], ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"\"\<Geodesic\>\"", ",", " ", 
