Cell[TextData[{
 "The same sections as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9fff0ba4-8ada-45f2-b93f-e1587ad29814"],
 " with the continuity property and the vertices taken in order:"
}], "ExampleText",ExpressionUUID->"0a9beb4a-a89d-4965-8cd1-27fd8f4e47dc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GraphProduct", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Graph", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
           RowBox[{"{", "}"}]}], "]"}], ",", " ", "\"\<Cartesian\>\""}], 
        "]"}], ",", " ", "First"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"FindInfraSection", "[", 
     RowBox[{"fib", ",", " ", "All"}], "]"}], " ", "===", "\n", "    ", 
    RowBox[{"RandomInfraSection", "[", 
     RowBox[{"fib", ",", " ", "All", ",", " ", 
      RowBox[{"Properties", " ", "->", " ", 
       RowBox[{"{", "\"\<Continuous\>\"", "}"}]}], ",", " ", 
      RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]}], 
     "]"}]}]}], "]"}]], "Input",
