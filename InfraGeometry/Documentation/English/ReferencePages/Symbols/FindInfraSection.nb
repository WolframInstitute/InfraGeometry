      " ", "&"}], " ", "/@", " ", 
     RowBox[{"FindInfraSection", "[", 
      RowBox[{"fib", ",", " ", "All"}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8abadd30-4d9f-4868-8b54-dda992a56496"],

