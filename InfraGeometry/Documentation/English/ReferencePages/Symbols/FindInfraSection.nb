Cell[CellGroupData[{
Cell["FindInfraSection", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e60343b3-dbf1-4e9a-a428-12ae2695a53f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraSection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b122071-799d-48cf-8c5c-2aacee0253b7"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " continuous sections of the fibered graph ",
 StyleBox["fib", "TI"],
 " over its whole base.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7725de9d-a2b0-4233-ac33-9a5aec3f8f71"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraSection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSection", 
