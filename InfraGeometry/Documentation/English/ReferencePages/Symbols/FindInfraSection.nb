Cell["\<\
A continuous section picks one total vertex over each base vertex, adjacent \
over every base edge.\
\>", "Notes",ExpressionUUID->"2a360f5c-d857-4780-8d94-0af84032f1d1"],

Cell["\<\
The sections are found as cliques of the graph joining total vertices over \
distinct base vertices that are not adjacent in the base or adjacent in the \
total graph.\
\>", "Notes",ExpressionUUID->"4ca6b387-7cc9-4461-a6e8-0139135893e3"],

Cell[TextData[{
 "With an exact count ",
 StyleBox["n", "TI"],
 ", the result is {} when fewer than ",
 StyleBox["n", "TI"],
 " sections exist."
}], "Notes",ExpressionUUID->"71730dd9-1c63-4095-b289-9b670730bca8"],

Cell[TextData[{
 "The count is required. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "656cf9e3-0f01-4a5a-87c3-c8315c940560"],
 " can be exponential in the size of the base."
}], "Notes",ExpressionUUID->"429464ef-e3c4-46f9-9e87-0c94248b1ef4"]
}, Open  ]],

