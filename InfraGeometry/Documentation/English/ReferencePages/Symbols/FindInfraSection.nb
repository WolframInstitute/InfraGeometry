          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
           RowBox[{"{", "}"}]}], "]"}], ",", " ", "\"\<Cartesian\>\""}], 
        "]"}], ",", " ", "First"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sections", " ", "=", " ", 
     RowBox[{"FindInfraSection", "[", 
      RowBox[{"fib", ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraFiberedGraphHighlight", "[", 
         RowBox[{"fib", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
       "sections"}], "]"}], ",", "\n", "    ", 
     RowBox[{"sections", " ", "===", " ", 
      RowBox[{"RandomInfraSection", "[", 
       RowBox[{"fib", ",", " ", "All", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", "\"\<Continuous\>\"", "}"}]}], ",", " ", 
        RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]}], 
       "]"}]}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"87625656-75c5-4ec3-b627-7bef6d440f27"],

