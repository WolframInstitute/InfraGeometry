Cell[TextData[{
 "The grid product bundle has three continuous sections, one for each vertex \
of the triangle. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UpTo"]], "paclet:ref/UpTo"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2fb44482-069a-48fa-84fa-c4fb6adf35c9"],
 " gives all three, an exact count of five gives none."
}], "ExampleText",ExpressionUUID->"176b4ea6-c20b-42d7-a4ec-80c8a54d5280"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridProductBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraSection", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"UpTo", "[", "5", "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"FindInfraSection", "[", 
      RowBox[{"fib", ",", " ", "5"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"afa17038-3161-4d6c-b6bb-0b2fbd08b7ab"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", 
