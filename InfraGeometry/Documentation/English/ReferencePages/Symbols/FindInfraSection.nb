Cell["\<\
The old and current call forms give the same two sheets of this product \
covering.\
\>", "ExampleText",ExpressionUUID->"bcbb7137-7f3c-4799-a5df-5d549425f456"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
