Cell["\<\
A continuous section picks one total vertex over each base vertex, adjacent \
over every base edge.\
\>", "Notes",ExpressionUUID->"d465b8d5-3bfa-45b7-96b8-7abf8c7105b1"],

Cell["\<\
The sections are found as cliques of the graph joining total vertices over \
distinct base vertices that are not adjacent in the base or adjacent in the \
total graph.\
\>", "Notes",ExpressionUUID->"d7bd4e47-becb-4c42-9d19-05cd9a656a7a"],

Cell[TextData[{
 "With an exact count ",
 StyleBox["n", "TI"],
 ", the result is {} when fewer than ",
 StyleBox["n", "TI"],
 " sections exist."
}], "Notes",ExpressionUUID->"cb1faa5e-ea3a-4066-9e1e-4f7648da8636"],

Cell[TextData[{
 "The count is required. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5b51b26d-10ff-4413-bc57-857adc7c7b98"],
 " can be exponential in the size of the base."
}], "Notes",ExpressionUUID->"8f3cb38c-56d2-4080-a8a1-e22b66c7df00"]
}, Open  ]],

