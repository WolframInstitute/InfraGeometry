    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["UpTo",
      BaseStyle->"Link"], "[", 
     StyleBox["n", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "579985d8-9785-4d5d-ace2-81db93bb0d1f"],
 "\[LineSeparator]",
 "gives at most ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraSection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSection", 
