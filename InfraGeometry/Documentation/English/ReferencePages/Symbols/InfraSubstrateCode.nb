Cell["\<\
The code of the discretized plane, the square tiling and the hexagonal \
tiling, beside the graph it builds.\
\>", "ExampleText",ExpressionUUID->"92a23123-cb18-4cda-8fcf-c05f46523dd2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"code", " ", "=", " ", 
         RowBox[{"InfraSubstrateCode", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"code", ",", " ", 
         RowBox[{"ReleaseHold", "[", "code", "]"}]}], "}"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"name", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
         " ", "\"\<SquareTilingGraph\>\"", ",", 
         " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], ",", 
   "\n", "  ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"aceb7cb4-5062-4071-8ffc-a81a2f03304a"],

