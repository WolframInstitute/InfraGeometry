Cell["\<\
The code of the discretized plane, the square tiling and the hexagonal \
tiling, beside the graph it builds.\
\>", "ExampleText",ExpressionUUID->"46e4af30-3bd4-4d79-b204-f4661e940980"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"code", " ", "=", " ", 
         RowBox[{"InfraSubstrateCode", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"code", ",", " ", 
         RowBox[{"ReleaseHold", "[", "code", "]"}]}], "}"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"name", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
         " ", "\"\<SquareTilingGraph\>\"", ",", 
         " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], ",", 
   "\n", "  ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c71413d9-b5f2-4dc7-9c12-516f1f621cf5"],

