Cell["\<\
A torus: the flat torus graph, placed on a torus of revolution.\
\>", "ExampleText",ExpressionUUID->"46e01fff-b328-4341-bf3d-e16946259709"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"code", " ", "=", " ", 
     RowBox[{"InfraSubstrateCode", "[", 
      RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"code", ",", " ", 
     RowBox[{"ReleaseHold", "[", "code", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ff7348f3-de59-4a05-be3a-160085925347"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TagBox[
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"torus", "=", 
        RowBox[{"TorusTessellation", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"10", ",", "10"}], "}"}], ",", "\<\"Square\"\>"}], "]"}]}],
        "}"}], ",", 
      RowBox[{"Graph", "[", 
       RowBox[{"torus", ",", 
        RowBox[{"VertexCoordinates", "\[Rule]", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"v", ",", 
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"s", "=", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "[", "v", "]"}], "\[GreaterEqual]", 
                   "3"}], ",", 
                  RowBox[{
                  "v", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}],
                   ",", "0"}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"u", "=", 
                 RowBox[{
                  FractionBox["2", "10"], " ", "\[Pi]", " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    "v", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], "+", 
                    FractionBox["s", "2"]}], ")"}]}]}], ",", 
                RowBox[{"w", "=", 
                 RowBox[{
                  FractionBox["2", "10"], " ", "\[Pi]", " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    "v", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}], "+", 
                    FractionBox["s", "2"]}], ")"}]}]}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "+", 
                   RowBox[{"0.4`", " ", 
                    RowBox[{"Cos", "[", "w", "]"}]}]}], ")"}], " ", 
                 RowBox[{"Cos", "[", "u", "]"}]}], ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "+", 
                   RowBox[{"0.4`", " ", 
                    RowBox[{"Cos", "[", "w", "]"}]}]}], ")"}], " ", 
                 RowBox[{"Sin", "[", "u", "]"}]}], ",", 
                RowBox[{"0.4`", " ", 
                 RowBox[{"Sin", "[", "w", "]"}]}]}], "}"}]}], "]"}]}], "]"}], 
          "/@", 
          RowBox[{"VertexList", "[", "torus", "]"}]}]}]}], "]"}]}], "]"}],
    HoldForm], ",", 
