Cell["\<\
A seed set before the code is built is spent on the build. The graph then \
differs from the substrate drawn at that seed.\
\>", "ExampleText",ExpressionUUID->"4931641a-30c2-436e-a75e-6f5933ecd143"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"ReleaseHold", "[", 
        RowBox[{"InfraSubstrateCode", "[", 
         RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
          " ", 
          RowBox[{"\"\<Inflate\>\"", " ", "->", " ", "1"}], ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}], "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"substrate", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
         " ", "\"\<Default\>\"", ",", " ", 
         RowBox[{"\"\<Inflate\>\"", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{"graph", ",", " ", "substrate"}], "}"}], "]"}], ",", " ", 
     RowBox[{"graph", " ", "===", " ", "substrate"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4cf61cf6-3a2e-4592-9ae6-0ca7ab85ac33"],

