Cell[TextData[{
 "An inflated substrate: the code calls ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InflateGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InflateGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2c68bc76-1dc7-4e63-96bf-0eb9a712a935"],
 " with the amount and the options."
}], "ExampleText",ExpressionUUID->"026c2004-73c1-4850-9dc5-d5869cfe96aa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"code", " ", "=", " ", 
     RowBox[{"InfraSubstrateCode", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<Inflate\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", 
          RowBox[{"\"\<VerticalEdges\>\"", " ", "->", " ", "1"}]}], "}"}]}], ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"code", ",", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"ReleaseHold", "[", "code", "]"}]}], ")"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c89eb634-53ea-4540-ac5a-e8cbebc0bb8d"],

