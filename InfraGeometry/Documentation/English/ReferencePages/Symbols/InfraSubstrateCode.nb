 "."
}], "Notes",ExpressionUUID->"e1360d1e-d9ca-44ed-9e1e-1a996e61bc34"],

Cell[TextData[{
 "The code also carries what the options add: the layout of a substrate \
without ",
 Cell[BoxData["\"\<KeepCoordinates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f8ffc77-2da0-436b-a7bc-e566cc1e6877"],
 " -> ",
