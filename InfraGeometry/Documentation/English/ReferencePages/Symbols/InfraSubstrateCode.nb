Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"ReleaseHold", " ", "@", " ", 
      RowBox[{"InfraSubstrateCode", "[", 
       RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
         " ", 
        RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"styled", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{"graph", ",", " ", 
       RowBox[{"Sequence", " ", "@@", " ", 
        RowBox[{"InfraSubstrateStyle", "[", "\"\<Small\>\"", "]"}]}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"styled", ",", " ", 
     RowBox[{"styled", " ", "===", " ", 
