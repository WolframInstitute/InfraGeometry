Cell["\<\
A torus: the flat torus graph, placed on a torus of revolution.\
\>", "ExampleText",ExpressionUUID->"c216fc49-90eb-41e6-9f57-afa797d84ea2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"code", " ", "=", " ", 
     RowBox[{"InfraSubstrateCode", "[", 
      RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"code", ",", " ", 
     RowBox[{"ReleaseHold", "[", "code", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8e4f11f3-9b28-49e7-b5bc-f584280b398b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TagBox[
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"torus", "=", 
        RowBox[{"TorusTessellation", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"10", ",", "10"}], "}"}], ",", "\<\"Square\"\>"}], "]"}]}],
        "}"}], ",", 
      RowBox[{"Graph", "[", 
       RowBox[{"torus", ",", 
        RowBox[{"VertexCoordinates", "\[Rule]", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"v", ",", 
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"s", "=", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "[", "v", "]"}], "\[GreaterEqual]", 
                   "3"}], ",", 
                  RowBox[{
                  "v", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}],
                   ",", "0"}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"u", "=", 
                 RowBox[{
                  FractionBox["2", "10"], " ", "\[Pi]", " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    "v", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], "+", 
                    FractionBox["s", "2"]}], ")"}]}]}], ",", 
                RowBox[{"w", "=", 
                 RowBox[{
                  FractionBox["2", "10"], " ", "\[Pi]", " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    "v", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}], "+", 
                    FractionBox["s", "2"]}], ")"}]}]}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "+", 
                   RowBox[{"0.4`", " ", 
                    RowBox[{"Cos", "[", "w", "]"}]}]}], ")"}], " ", 
                 RowBox[{"Cos", "[", "u", "]"}]}], ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "+", 
                   RowBox[{"0.4`", " ", 
                    RowBox[{"Cos", "[", "w", "]"}]}]}], ")"}], " ", 
                 RowBox[{"Sin", "[", "u", "]"}]}], ",", 
                RowBox[{"0.4`", " ", 
                 RowBox[{"Sin", "[", "w", "]"}]}]}], "}"}]}], "]"}]}], "]"}], 
          "/@", 
          RowBox[{"VertexList", "[", "torus", "]"}]}]}]}], "]"}]}], "]"}],
    HoldForm], ",", 
