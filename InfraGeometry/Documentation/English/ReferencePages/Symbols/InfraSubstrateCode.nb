Cell["\<\
The code of the discretized plane, the square tiling and the hexagonal \
tiling, beside the graph it builds.\
\>", "ExampleText",ExpressionUUID->"1c9cf3a4-ca9d-4455-a4cd-20cdf4ddd254"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"code", " ", "=", " ", 
         RowBox[{"InfraSubstrateCode", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"code", ",", " ", 
         RowBox[{"ReleaseHold", "[", "code", "]"}]}], "}"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"name", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
         " ", "\"\<SquareTilingGraph\>\"", ",", 
         " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], ",", 
   "\n", "  ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"848dc1be-822e-4868-b10a-4a4598589a2f"],

