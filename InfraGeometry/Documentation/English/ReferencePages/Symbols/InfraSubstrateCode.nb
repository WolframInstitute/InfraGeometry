Cell["\<\
The code gives the substrate drawn with no style, and with the style of its \
size spliced in, the substrate as drawn:\
\>", "ExampleText",ExpressionUUID->"25f28389-432c-431b-b2bc-9bcb1859a8db"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"ReleaseHold", " ", "@", " ", 
      RowBox[{"InfraSubstrateCode", "[", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
        RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"g", " ", "===", " ", 
      RowBox[{"InfraSubstrate", "[", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
        " ", "\"\<Default\>\"", ",", " ", 
        RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
       "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Graph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"Sequence", " ", "@@", " ", 
         RowBox[{"InfraSubstrateStyle", "[", "\"\<Small\>\"", "]"}]}]}], 
       "]"}], " ", "===", " ", 
      RowBox[{"InfraSubstrate", "[", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
        RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"14c6a09c-ed8a-43d2-a82b-f97ae3fb0e9f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6fb3cef7-60f6-44b7-9dac-12d097fa746b"]
}, Open  ]],

Cell["\<\
For a random construction, the seed set after the build gives the substrate \
drawn at that seed:\
\>", "ExampleText",ExpressionUUID->"72dd8eb5-cf4a-42a4-aa8b-03d03b343e45"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"code", " ", "=", " ", 
     RowBox[{"InfraSubstrateCode", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<Inflate\>\"", " ", "->", " ", "2"}], ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"BlockRandom", "[", 
     RowBox[{
      RowBox[{"ReleaseHold", "[", "code", "]"}], ",", " ", 
      RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], " ", "===", 
    "\n", "    ", 
    RowBox[{"BlockRandom", "[", 
     RowBox[{
      RowBox[{"InfraSubstrate", "[", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
        " ", "\"\<Default\>\"", ",", " ", 
        RowBox[{"\"\<Inflate\>\"", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}], 
      ",", " ", 
      RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"03f69d1c-5c7c-4ad9-b853-218ca1ba5cb2"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"34c1fbf9-872a-401d-908f-81e9feaebf14"]
}, Open  ]]
}, Open  ]],

