Cell[TextData[{
 "The roster of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dc7f3890-4372-4624-a6f9-82aa9be51434"],
 " is written as held code: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bfa3120d-e3a0-4b56-813f-fb46b31f4822"],
 " evaluates it, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateCode"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateCode", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4e742eb5-811e-4d12-9bad-bf35506f2f36"],
 " prints it. The printed code is therefore the code that runs, with the size \
table replaced by the value ",
 StyleBox["size", "TI"],
 " selects, and it names only exported functions."
}], "Notes",ExpressionUUID->"84e69ac1-0286-4dc8-b188-a39a0058f119"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ReleaseHold"]], "paclet:ref/ReleaseHold"},
