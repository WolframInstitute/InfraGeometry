   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b6a7ec28-a877-4032-9afd-35c156e05dd3"],
 ", so it reads as code in an output cell."
}], "Notes",ExpressionUUID->"dfa3bd8f-8903-4d42-ad6d-904514c6245f"],

Cell[TextData[{
 "A substrate drawn from a random construction is seeded from outside. \
Building the code evaluates it once, so set the seed after building the code \
and before ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ReleaseHold"]], "paclet:ref/ReleaseHold"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cc37e018-3a91-49d3-bab1-e70a3d98f636"],
