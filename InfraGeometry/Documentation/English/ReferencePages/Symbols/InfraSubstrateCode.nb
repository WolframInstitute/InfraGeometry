Cell[TextData[{
 "A substrate drawn from a random construction is seeded from outside. \
Building the code evaluates it once, so set the seed after building the code \
and before ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ReleaseHold"]], "paclet:ref/ReleaseHold"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
