   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c62aed26-e2a3-41eb-a07f-153fff255950"],
 " for ",
 Cell[BoxData["\"\<Inflate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d225803-d53a-4878-8ab8-7a23f3bd11f3"],
 ". A Wolfram-model universe carries its rule and initial condition."
}], "Notes",ExpressionUUID->"bbd2f0fc-96bd-46de-b44e-7c731b534167"],

Cell[TextData[{
 "The options are those of ",
