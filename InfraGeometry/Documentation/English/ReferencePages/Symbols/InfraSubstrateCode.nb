Cell[TextData[{
 "The style of the size spliced in gives the substrate as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f9db99c7-77b8-4db3-915a-e3eb9b6aded7"],
 " draws it."
}], "ExampleText",ExpressionUUID->"5527335b-abb7-4ef7-9716-f5cc6c49a075"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"ReleaseHold", " ", "@", " ", 
      RowBox[{"InfraSubstrateCode", "[", 
       RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
         " ", 
        RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"styled", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{"graph", ",", " ", 
       RowBox[{"Sequence", " ", "@@", " ", 
        RowBox[{"InfraSubstrateStyle", "[", "\"\<Small\>\"", "]"}]}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"styled", ",", " ", 
     RowBox[{"styled", " ", "===", " ", 
      RowBox[{"InfraSubstrate", "[", 
       RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
         " ", 
        RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b557042c-2712-4290-9df3-8ea552e9b5e4"],

