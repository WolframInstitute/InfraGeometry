Cell["\<\
A seed set before the code is built is spent on the build. The graph then \
differs from the substrate drawn at that seed.\
\>", "ExampleText",ExpressionUUID->"7db63ef6-5066-459d-9c9c-18d5586f45ac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"ReleaseHold", "[", 
        RowBox[{"InfraSubstrateCode", "[", 
         RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
          " ", 
          RowBox[{"\"\<Inflate\>\"", " ", "->", " ", "1"}], ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}], "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"substrate", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
         " ", "\"\<Default\>\"", ",", " ", 
         RowBox[{"\"\<Inflate\>\"", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{"graph", ",", " ", "substrate"}], "}"}], "]"}], ",", " ", 
     RowBox[{"graph", " ", "===", " ", "substrate"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b08a481e-0591-48a6-8263-f230a1f16242"],

