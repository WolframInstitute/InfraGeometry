Cell[TextData[{
 "The roster of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6f4ba3bc-4ecf-4044-b501-44a38111e135"],
 " is written as held code: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6e3fb4d6-9200-4ea6-bdf4-dba97ae95e43"],
 " evaluates it, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateCode"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateCode", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5c12d90d-e71e-44c3-8b49-59101ab194af"],
 " prints it. The printed code is therefore the code that runs, with the size \
table replaced by the value ",
 StyleBox["size", "TI"],
 " selects, and it names only exported functions."
}], "Notes",ExpressionUUID->"cb130011-ff13-4a59-9e7b-5d97833b5a66"],

Cell[TextData[{
