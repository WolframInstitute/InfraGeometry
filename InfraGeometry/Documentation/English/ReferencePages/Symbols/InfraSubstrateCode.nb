  FontSize->0.9 Inherited,ExpressionUUID->
  "7f1fcc6d-4f53-46ca-826c-a9d824832d39"],
 "."
}], "Notes",ExpressionUUID->"c3401eea-2019-4a35-972d-092d5cba4fd4"],

Cell[TextData[{
 "The code also carries what the options add: the layout of a substrate \
without ",
 Cell[BoxData["\"\<KeepCoordinates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76d177e7-f05b-4065-a638-960cf974bde5"],
 " -> ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f47ace96-b821-4cab-a82f-44a6518f1d8c"],
 ", and the call of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InflateGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InflateGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "68e7a477-6242-4313-a206-2a4662abeaed"],
 " for ",
 Cell[BoxData["\"\<Inflate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f1c9329-3ec9-4f98-9eb0-2e548cbd7e85"],
 ". A Wolfram-model universe carries its rule and initial condition."
}], "Notes",ExpressionUUID->"6c88b1e7-13a4-401e-bace-9d63b0339210"],

Cell[TextData[{
 "The options are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
