  FontSize->0.9 Inherited,ExpressionUUID->
  "407191e3-4ca2-414d-b8a1-7fa378ebc970"],
 "\[LineSeparator]",
 "gives the code of the substrate ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubstrate"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["name", "TI"], ",", " ", 
    StyleBox["size", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a6f932a-7541-4344-bcb5-0356df8da806"],
 ", held: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ReleaseHold"]], "paclet:ref/ReleaseHold"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "73a65727-91c9-4766-a73c-b717cadee41a"],
 " of it builds the graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ef81a279-37a6-427d-9ec1-d67f8a43deb8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubstrateCode"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateCode", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["name", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c76b1433-fe9b-4d6a-9780-c9373c43f8c2"],
 "\[LineSeparator]",
 "gives the code of the ",
 Cell[BoxData["\"\<Medium\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b761315-8fec-450e-a7be-d9d9934b53c4"],
 " size."
}], "Usage",ExpressionUUID->"4026b273-ed97-4a97-a363-632ec34c31a3"],

Cell[TextData[{
 "The result is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HoldForm"]], "paclet:ref/HoldForm"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7b03f72c-3a52-4bc4-97a0-9eddca8077c8"],
 " of the construction, with the size table replaced by the value ",
 StyleBox["size", "TI"],
 " selects. It is the code ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1dde5e80-3147-435f-82da-e0266b86f3f4"],
 " runs, and it uses exported functions only."
}], "Notes",ExpressionUUID->"fc612e6e-413b-4ca9-8004-460f494e4bac"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ReleaseHold"]], "paclet:ref/ReleaseHold"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3e2cc271-fefe-48c0-96ba-39505990371f"],
 " of the code gives the substrate drawn with the style ",
 Cell[BoxData["\"\<Default\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a04391eb-890f-417a-901f-cdac1e409e2b"],
 ". The style is not code; ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Graph",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Sequence",
      BaseStyle->"Link"], " ", "@@", " ", 
     RowBox[{"InfraSubstrateStyle", "[", 
      StyleBox["size", "TI"], "]"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "548bf956-c1f8-4341-8b9e-828f6b76bb68"],
 " splices it back."
}], "Notes",ExpressionUUID->"ccf1ad48-1035-447a-85a5-48e1743e763e"],

Cell[TextData[{
 "The code carries what the options add: a spring layout unless ",
 Cell[BoxData["\"\<KeepCoordinates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e2aa636-be30-4450-b093-0e570bc028d5"],
 " -> ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0bc304b0-4e26-4195-993c-3c3427e4bef1"],
 ", and the call of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InflateGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InflateGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "48cec0f3-daa7-470d-ae9e-d1781586a24c"],
 " for ",
 Cell[BoxData["\"\<Inflate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e25fb4dc-e186-4d33-8472-b1104948fbd0"],
 ". The options are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "64e9c551-5dc0-4f33-a145-db82ed0a027b"],
 "; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5eb39c26-217c-4e04-87f4-26b99bd803ab"],
 " options are passed on into the code."
}], "Notes",ExpressionUUID->"4979e0f3-8900-4fe1-b764-d019f469b5c8"],

Cell[TextData[{
 "Building the code builds the graph once. For a random construction, fix the \
seed after building the code and before ",
