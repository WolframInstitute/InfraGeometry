Cell["InfraSubstrateCode", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b73f8397-3019-456e-8b75-f98f09215dee"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubstrateCode"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateCode", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["name", "TI"], ",", " ", 
