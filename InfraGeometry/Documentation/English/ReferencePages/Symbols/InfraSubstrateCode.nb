 "."
}], "Notes",ExpressionUUID->"5cbf3767-97de-42bc-9ad9-05b98b89ed9e"],

Cell[TextData[{
 "The code also carries what the options add: the layout of a substrate \
without ",
 Cell[BoxData["\"\<KeepCoordinates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8cb489ef-03ee-4981-b803-7c5380637f2e"],
 " -> ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d02df765-47ec-4ed9-accc-65fe55905b72"],
