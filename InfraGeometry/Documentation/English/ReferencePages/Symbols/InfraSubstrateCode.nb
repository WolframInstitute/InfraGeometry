Cell[TextData[{
 "An inflated substrate: the code calls ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InflateGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InflateGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7b0e5e68-4518-45e4-a46e-707e5487d8b7"],
 "."
}], "ExampleText",ExpressionUUID->"e716a69e-5616-49c2-a7e2-f4778d2bc0aa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"code", " ", "=", " ", 
     RowBox[{"InfraSubstrateCode", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<Inflate\>\"", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"code", ",", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"ReleaseHold", "[", "code", "]"}]}], ")"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d3d826c5-ddb4-41ba-9996-4e94d552eb83"],

