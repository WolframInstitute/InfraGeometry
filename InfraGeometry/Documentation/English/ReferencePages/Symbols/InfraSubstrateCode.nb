       RowBox[{"\<\"Dimension\"\>", "\[Rule]", "2"}]}], "}"}]}]}], "]"}],
  HoldForm]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c2431560-a436-4d07-97c1-1a6fabef2e3d"]
}, Open  ]],

Cell[TextData[{
 "An inflated substrate: the code calls ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InflateGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InflateGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c9fd0be3-ce92-495f-a3b1-f7fa5f005f87"],
 " with the amount and the options:"
}], "ExampleText",ExpressionUUID->"c3aeeaa3-6d69-4a26-b524-737b416b8a26"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraSubstrateCode", "[", 
  RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
   RowBox[{"\"\<Inflate\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", 
      RowBox[{"\"\<VerticalEdges\>\"", " ", "->", " ", "1"}]}], "}"}]}], ",", 
   " ", 
   RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5b00a795-5bcc-43f0-9492-60a09fbe07c6"],

Cell[BoxData[
 TagBox[
  RowBox[{"InflateGraph", "[", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"mesh", "=", 
        RowBox[{"BoundarylessGraph", "[", 
         RowBox[{"DiscretizeRegion", "[", 
          RowBox[{
           RowBox[{"Rectangle", "[", "]"}], ",", 
           RowBox[{"MaxCellMeasure", "\[Rule]", "0.0085`"}], ",", 
           RowBox[{"PrecisionGoal", "\[Rule]", "\[Infinity]"}]}], "]"}], 
         "]"}]}], "}"}], ",", 
      RowBox[{"VertexDelete", "[", 
       RowBox[{"mesh", ",", 
        RowBox[{"Pick", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "mesh", "]"}], ",", 
          RowBox[{"VertexDegree", "[", "mesh", "]"}], ",", "1"}], "]"}]}], 
       "]"}]}], "]"}], ",", "2", ",", 
    RowBox[{"\<\"VerticalEdges\"\>", "\[Rule]", "1"}]}], "]"}],
  HoldForm]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"af20a8d4-cacc-4d5c-af0c-6dc37c437602"]
}, Open  ]]
}, Open  ]],

