Cell[TextData[{
 "The style of the size spliced in gives the substrate as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cc1a1f38-ac6b-4ab5-a923-b6373b4bb170"],
 " draws it."
}], "ExampleText",ExpressionUUID->"c4a9b74e-04b4-43b5-a7b6-aadd55d9e063"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"ReleaseHold", " ", "@", " ", 
      RowBox[{"InfraSubstrateCode", "[", 
       RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
         " ", 
        RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"styled", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{"graph", ",", " ", 
       RowBox[{"Sequence", " ", "@@", " ", 
        RowBox[{"InfraSubstrateStyle", "[", "\"\<Small\>\"", "]"}]}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"styled", ",", " ", 
     RowBox[{"styled", " ", "===", " ", 
      RowBox[{"InfraSubstrate", "[", 
       RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
         " ", 
        RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7edd4b1e-d065-48ef-bad5-c2e6ffae9847"],

