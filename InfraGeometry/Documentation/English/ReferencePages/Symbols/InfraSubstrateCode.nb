Cell[TextData[{
 "An inflated substrate: the code calls ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InflateGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InflateGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a3612a40-4ce1-4b68-8e0d-ce24edcedc4f"],
 "."
}], "ExampleText",ExpressionUUID->"cd586aac-ff80-45ea-a17e-ffdefddf0aa7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"code", " ", "=", " ", 
     RowBox[{"InfraSubstrateCode", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<Inflate\>\"", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"code", ",", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"ReleaseHold", "[", "code", "]"}]}], ")"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a708cf46-9587-4ed3-82b3-1d98990e273d"],

