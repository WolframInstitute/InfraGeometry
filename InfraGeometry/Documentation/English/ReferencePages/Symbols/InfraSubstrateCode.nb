Cell[TextData[{
 "The roster of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "44e248f2-7c63-4907-a0e3-7d5d60dac920"],
 " is written as held code: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c61cf6a3-562c-406f-9256-86d1f34aaa6a"],
 " evaluates it, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateCode"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateCode", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6e9aa156-f687-4508-bbb3-fde38214f720"],
 " prints it. The printed code is therefore the code that runs, with the size \
table replaced by the value ",
 StyleBox["size", "TI"],
 " selects, and it names only exported functions."
}], "Notes",ExpressionUUID->"403e6bef-3e49-4bf3-9310-e1b7681e3f16"],

Cell[TextData[{
