Cell["\<\
The combinatorial boundary of a ball is its outer shell at every radius. The \
ball of radius 4 about the centre of the square tiling has that shell, drawn \
blue on the right, and no topological boundary at radius 2.\
\>", "ExampleText",ExpressionUUID->"69f3d46f-d16a-4839-85f9-3e707f6acb6d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"RandomInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "4"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"TopologicalBoundary", "[", 
      RowBox[{
       RowBox[{"BallTopology", "[", 
        RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", "ball"}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Complement", "[", 
           RowBox[{"ball", ",", " ", 
            RowBox[{"InfraBoundary", "[", 
             RowBox[{"g", ",", " ", "ball"}], "]"}]}], "]"}], " ", "->", " ", 
          "StandardGreen"}], ",", " ", 
         RowBox[{
          RowBox[{"InfraBoundary", "[", 
           RowBox[{"g", ",", " ", "ball"}], "]"}], " ", "->", " ", 
          "StandardBlue"}]}], "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ea47cfde-e2bb-45d1-8b16-78fdabbe9dfb"],

