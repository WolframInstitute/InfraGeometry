Cell[TextData[{
 "A set and its complement have one boundary, the intersection of their \
closures. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBoundary"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBoundary", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9cdffd5c-dd65-4957-956d-765be8eecaf9"],
 " with the method ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f2d5f33-117b-4316-9e1a-c5a403ecb4ce"],
 " gives the same set."
}], "ExampleText",ExpressionUUID->"3157e660-0f55-4156-a9c2-c1ed9fc1de8e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"topo", " ", "=", " ", 
     RowBox[{"BallTopology", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"RandomInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "6"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ring", " ", "=", " ", 
     RowBox[{"Complement", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "ball"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"boundary", " ", "=", " ", 
     RowBox[{"TopologicalBoundary", "[", 
      RowBox[{"topo", ",", " ", "ball"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"boundary", " ", "->", " ", "StandardBlue"}], "}"}]}], "]"}], 
     ",", "\n", "   ", 
     RowBox[{"boundary", " ", "==", " ", 
      RowBox[{"TopologicalBoundary", "[", 
       RowBox[{"topo", ",", " ", "ring"}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"boundary", " ", "==", " ", 
      RowBox[{"Intersection", "[", 
       RowBox[{
        RowBox[{"TopologicalClosure", "[", 
         RowBox[{"topo", ",", " ", "ball"}], "]"}], ",", " ", 
        RowBox[{"TopologicalClosure", "[", 
         RowBox[{"topo", ",", " ", "ring"}], "]"}]}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{"boundary", " ", "==", " ", 
      RowBox[{"InfraBoundary", "[", 
       RowBox[{"g", ",", " ", "ball", ",", " ", 
        RowBox[{"Method", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Alexandrov\>\"", ",", " ", 
           RowBox[{"\"\<Radius\>\"", " ", "->", " ", "2"}]}], "}"}]}]}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"64899a0a-2b57-47ff-a413-c62bee90948e"],

