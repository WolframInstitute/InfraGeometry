Cell[TextData[{
 "A set and its complement have one boundary, the intersection of their \
closures. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBoundary"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBoundary", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c36a8188-35db-4025-8140-0b0b5f52f5aa"],
 " with the method ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da9dc76a-734b-4fa7-b65d-cd9382516ae8"],
 " gives the same set."
}], "ExampleText",ExpressionUUID->"1edb0a24-f123-4662-979a-d3673d2605b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"topo", " ", "=", " ", 
     RowBox[{"BallTopology", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "6"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ring", " ", "=", " ", 
     RowBox[{"Complement", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "ball"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"boundary", " ", "=", " ", 
     RowBox[{"TopologicalBoundary", "[", 
      RowBox[{"topo", ",", " ", "ball"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"boundary", " ", "->", " ", "StandardBlue"}], "}"}]}], "]"}], 
     ",", "\n", "   ", 
     RowBox[{"boundary", " ", "==", " ", 
      RowBox[{"TopologicalBoundary", "[", 
       RowBox[{"topo", ",", " ", "ring"}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"boundary", " ", "==", " ", 
      RowBox[{"Intersection", "[", 
       RowBox[{
        RowBox[{"TopologicalClosure", "[", 
         RowBox[{"topo", ",", " ", "ball"}], "]"}], ",", " ", 
        RowBox[{"TopologicalClosure", "[", 
         RowBox[{"topo", ",", " ", "ring"}], "]"}]}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{"boundary", " ", "==", " ", 
      RowBox[{"InfraBoundary", "[", 
       RowBox[{"g", ",", " ", "ball", ",", " ", 
        RowBox[{"Method", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Alexandrov\>\"", ",", " ", 
           RowBox[{"\"\<Radius\>\"", " ", "->", " ", "2"}]}], "}"}]}]}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fe78064e-bf97-45f9-aba6-7203afe8943f"],

