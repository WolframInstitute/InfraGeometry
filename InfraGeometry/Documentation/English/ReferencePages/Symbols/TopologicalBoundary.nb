Cell["\<\
The combinatorial boundary of a ball is its outer shell at every radius. The \
ball of radius 4 about the centre of the square tiling has that shell, drawn \
blue on the right, and no topological boundary at radius 2.\
\>", "ExampleText",ExpressionUUID->"117b3b18-78c9-4726-b033-cd83ac611a52"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "4"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"TopologicalBoundary", "[", 
      RowBox[{
       RowBox[{"BallTopology", "[", 
        RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", "ball"}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Complement", "[", 
           RowBox[{"ball", ",", " ", 
            RowBox[{"InfraBoundary", "[", 
             RowBox[{"g", ",", " ", "ball"}], "]"}]}], "]"}], " ", "->", " ", 
          "StandardGreen"}], ",", " ", 
         RowBox[{
          RowBox[{"InfraBoundary", "[", 
           RowBox[{"g", ",", " ", "ball"}], "]"}], " ", "->", " ", 
          "StandardBlue"}]}], "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e2e41822-35af-4a0d-afce-b11ee8f7bda8"],

