Cell["\<\
The balls of radius 4, 5 and 6 about the centre of the square tiling, at \
radius 2. The boundary is empty while the ball stays more than two steps from \
the rim. Closer, it is the set of vertices of the ball whose ball contains \
the ball of a vertex outside.\
\>", "ExampleText",ExpressionUUID->"9e9e9f7a-d3f7-4a3a-b462-bc4f7aa01d21"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"topo", " ", "=", " ", 
     RowBox[{"BallTopology", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ball", " ", "=", " ", 
          RowBox[{"RandomInfraRepresentative", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraBall", "[", 
             RowBox[{
              RowBox[{"First", " ", "@", " ", 
               RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "radius"}],
              "]"}]}], "]"}]}], "}"}], ",", "\n", "      ", 
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Complement", "[", 
              RowBox[{"ball", ",", " ", 
               RowBox[{"TopologicalBoundary", "[", 
                RowBox[{"topo", ",", " ", "ball"}], "]"}]}], "]"}], " ", "->",
              " ", "StandardGreen"}], ",", " ", 
            RowBox[{
             RowBox[{"TopologicalBoundary", "[", 
              RowBox[{"topo", ",", " ", "ball"}], "]"}], " ", "->", " ", 
             "StandardBlue"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"radius", ",", " ", "4", ",", " ", "6"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"fcfada39-1b04-4c76-a093-1c70d2ed4fd6"],

