Cell["\<\
The balls of radius 4, 5 and 6 about the centre of the square tiling, at \
radius 2. The boundary is empty while the ball stays more than two steps from \
the rim. Closer, it is the set of vertices of the ball whose ball contains \
the ball of a vertex outside.\
\>", "ExampleText",ExpressionUUID->"bb015808-6333-40a9-a96f-2c9762f79e9b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"topo", " ", "=", " ", 
     RowBox[{"BallTopology", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ball", " ", "=", " ", 
          RowBox[{"FindInfraRepresentative", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraBall", "[", 
             RowBox[{
              RowBox[{"First", " ", "@", " ", 
               RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "radius"}],
              "]"}]}], "]"}]}], "}"}], ",", "\n", "      ", 
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
