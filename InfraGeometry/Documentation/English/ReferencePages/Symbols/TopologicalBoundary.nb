Cell[CellGroupData[{
Cell["TopologicalBoundary", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c9946c23-6896-4dfc-b86c-21076062c1ee"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TopologicalBoundary"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TopologicalBoundary", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["topo", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fa75d85-3bb9-4353-9ffb-68d4cb64754a"],
 "\[LineSeparator]",
 "gives the boundary of the vertex list ",
 StyleBox["s", "TI"],
 " in the topology of the digraph ",
 StyleBox["topo", "TI"],
 ": its closure minus its interior.",
 "\n"
}], "Usage",ExpressionUUID->"55cf6cbc-f891-4d50-8ca5-50e58354c4df"],

Cell[TextData[{
 "Definition: ",
 StyleBox["bd(s) = cl(s) \[Backslash] int(s) = cl(s) \:2229 cl(V \[Backslash] \
s)", "TI"],
 ", where ",
 StyleBox["V", "TI"],
 " is the vertex set of ",
 StyleBox["topo", "TI"],
 ", ",
 StyleBox["cl", "TI"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologicalClosure"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TopologicalClosure", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b28d8d80-35d4-4cdb-a991-800c66c7dd35"],
 " and ",
 StyleBox["int", "TI"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologicalInterior"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TopologicalInterior", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f02a3322-f64e-41ee-a53f-85da5ea3c80d"],
 "."
}], "Notes",ExpressionUUID->"186b5ca2-2ef9-4ad4-8440-974b952af9a8"],

Cell[TextData[{
 "The boundary is two-sided: it may hold vertices outside ",
 StyleBox["s", "TI"],
 ", and ",
 StyleBox["s", "TI"],
 " and its complement have the same boundary. It is empty exactly when ",
 StyleBox["s", "TI"],
 " is open and closed."
}], "Notes",ExpressionUUID->"bff31030-7879-48ef-8535-b70a9085b04a"],

Cell["\<\
In the ball topology of a patch of a tiling, a vertex far from the rim is \
open and closed, so no boundary reaches it.\
\>", "Notes",ExpressionUUID->"f730a02e-794d-408b-b0f3-4f30deaab2e1"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBoundary"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBoundary", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Alexandrov\>\"", ",", " ", 
       RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
        StyleBox["r", "TI"]}]}], "}"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffa82f1d-26d7-4eee-98c5-65f8fa066585"],
 " is this boundary in the ball topology of radius ",
 StyleBox["r", "TI"],
 ". The default method of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBoundary"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBoundary", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6fd6b18d-bb5e-4f0c-b112-81162f3e1141"],
 " is the combinatorial boundary: the vertices of ",
 StyleBox["s", "TI"],
 " with a neighbour outside ",
 StyleBox["s", "TI"],
 "."
}], "Notes",ExpressionUUID->"e40e6aac-e8eb-43f0-b9d4-e59f92322ef5"],

Cell["The result is a sorted vertex list.", "Notes",ExpressionUUID->"003a0003-0fa7-48d2-8d95-95c6dbfbf6e2"]
}, Open  ]],

