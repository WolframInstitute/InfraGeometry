Cell["\<\
The ring outside a ball about the centre, in the ball topology of radius 2, \
on the discretized plane, the square tiling and the hexagonal tiling. The \
ring is green; its boundary, blue, lies outside it.\
\>", "ExampleText",ExpressionUUID->"a6ac2712-a393-4dae-a4a6-62968106fde4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"ring", " ", "=", " ", 
        RowBox[{"Complement", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"RandomInfraRepresentative", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraBall", "[", 
             RowBox[{"c", ",", " ", 
              RowBox[{
               RowBox[{"VertexEccentricity", "[", 
                RowBox[{"g", ",", " ", "c"}], "]"}], " ", "-", " ", "2"}]}], 
             "]"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ring", " ", "->", " ", "StandardGreen"}], ",", " ", 
          RowBox[{
           RowBox[{"TopologicalBoundary", "[", 
            RowBox[{
             RowBox[{"BallTopology", "[", 
              RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", "ring"}], "]"}], 
           " ", "->", " ", "StandardBlue"}]}], "}"}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"daed8246-2e85-4e7c-8419-7a0607e35a7a"],

