Cell["\<\
The ring outside a ball about the centre, in the ball topology of radius 2, \
on the discretized plane, the square tiling and the hexagonal tiling. The \
ring is green; its boundary, blue, lies outside it.\
\>", "ExampleText",ExpressionUUID->"f99c6c61-5ece-4ea1-94bc-67e5bc05a4d1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"ring", " ", "=", " ", 
        RowBox[{"Complement", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"FindInfraRepresentative", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraBall", "[", 
             RowBox[{"c", ",", " ", 
              RowBox[{
               RowBox[{"VertexEccentricity", "[", 
                RowBox[{"g", ",", " ", "c"}], "]"}], " ", "-", " ", "2"}]}], 
             "]"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ring", " ", "->", " ", "StandardGreen"}], ",", " ", 
          RowBox[{
           RowBox[{"TopologicalBoundary", "[", 
            RowBox[{
             RowBox[{"BallTopology", "[", 
              RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", "ring"}], "]"}], 
           " ", "->", " ", "StandardBlue"}]}], "}"}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"04d716b2-e3dc-4a63-81af-467ddfc76fa6"],

