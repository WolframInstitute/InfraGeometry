Cell[CellGroupData[{
Cell["TopologicalBoundary", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c92a78e4-ef5b-4356-99a4-87eddd1e30ce"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TopologicalBoundary"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TopologicalBoundary", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["topo", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d709a66-86dd-47c5-b509-9e004248eccd"],
 "\[LineSeparator]",
 "gives the boundary of the vertex list ",
 StyleBox["s", "TI"],
 " in the topology of the digraph ",
 StyleBox["topo", "TI"],
 ": its closure minus its interior.",
 "\n"
}], "Usage",ExpressionUUID->"3dfa52c1-053f-459a-8857-a92625b1f8e2"],

Cell[TextData[{
 "Definition: ",
 StyleBox["bd(s) = cl(s) \[Backslash] int(s) = cl(s) \:2229 cl(V \[Backslash] \
s)", "TI"],
 ", where ",
 StyleBox["V", "TI"],
 " is the vertex set of ",
 StyleBox["topo", "TI"],
 ", ",
 StyleBox["cl", "TI"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologicalClosure"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TopologicalClosure", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b6973386-73ae-4621-8ddb-0cdc3e6b9ff8"],
 " and ",
 StyleBox["int", "TI"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologicalInterior"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TopologicalInterior", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a9c2c7f9-b320-403e-b5b3-820f13043d33"],
 "."
}], "Notes",ExpressionUUID->"dab1eb62-63b9-4cd3-8e6b-613c1395b286"],

Cell[TextData[{
 "The boundary is two-sided: it may hold vertices outside ",
 StyleBox["s", "TI"],
 ", and ",
 StyleBox["s", "TI"],
 " and its complement have the same boundary. It is empty exactly when ",
 StyleBox["s", "TI"],
 " is open and closed."
}], "Notes",ExpressionUUID->"ec136f4a-900e-41a2-8692-4d06211a22ea"],

Cell["\<\
In the ball topology of a patch of a tiling, a vertex far from the rim is \
open and closed, so no boundary reaches it.\
\>", "Notes",ExpressionUUID->"bb7b82ff-860f-4810-937b-37bb8d8ff4f0"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBoundary"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBoundary", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Alexandrov\>\"", ",", " ", 
       RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
        StyleBox["r", "TI"]}]}], "}"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4e55782-5d9f-467e-beb9-bb50ae360dcb"],
 " is this boundary in the ball topology of radius ",
 StyleBox["r", "TI"],
 ". The default method of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBoundary"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBoundary", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cbfe7250-4a05-4d45-a786-b95b3b3f401b"],
 " is the combinatorial boundary: the vertices of ",
 StyleBox["s", "TI"],
 " with a neighbour outside ",
 StyleBox["s", "TI"],
 "."
}], "Notes",ExpressionUUID->"29464a2e-a0a2-4a74-9c78-bfdf205a1baf"],

Cell["The result is a sorted vertex list.", "Notes",ExpressionUUID->"938eea6d-40d9-408b-ac88-1376fb335a5b"]
}, Open  ]],

