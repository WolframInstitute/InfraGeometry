  FontSize->0.9 Inherited,ExpressionUUID->
  "40b1371e-9837-4c7d-b154-337c5a6e9401"],
 "\[LineSeparator]",
 "gives the effective resistance ",
 StyleBox["R", "TI"],
 "(",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") between the vertices ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " of ",
 StyleBox["g", "TI"],
 ", every edge a unit resistor.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d43538b0-f646-4aca-b90d-14862c44ba0b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["EffectiveResistance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/EffectiveResistance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
