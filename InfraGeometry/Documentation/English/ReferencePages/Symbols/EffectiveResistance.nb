Cell["\<\
On the square tiling the ball of radius 5 about the centre, blue, is a \
square. The vertices within resistance 1.15 of the centre, green, are as \
many, 61, and they form a round disk.\
\>", "ExampleText",ExpressionUUID->"1b06858b-e596-48e9-aa93-d7edf1378ff8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fromCentre", " ", "=", " ", 
     RowBox[{
      RowBox[{"EffectiveResistance", "[", "g", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"VertexIndex", "[", 
        RowBox[{"g", ",", " ", "c"}], "]"}], "]"}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"disk", " ", "=", " ", 
      RowBox[{"Pick", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"Thread", "[", 
         RowBox[{"fromCentre", " ", "<=", " ", "1.15"}], "]"}]}], "]"}]}], ",",
      " ", 
     RowBox[{"graphBall", " ", "=", " ", 
      RowBox[{"FindInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{"c", ",", " ", "5"}], "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"AssociationThread", "[", 
             RowBox[{"graphBall", ",", " ", "1"}], "]"}], " ", "->", " ", 
            "StandardBlue"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"AssociationThread", "[", 
             RowBox[{"disk", ",", " ", "1"}], "]"}], " ", "->", " ", 
            "StandardGreen"}], "}"}]}], "]"}]}], "}"}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"Length", " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"graphBall", ",", " ", "disk"}], "}"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"aff4c73e-e5bf-4135-84b2-dd18c5567a97"],

