Cell["\<\
The matrix on a vertex list: the centre of the grid and its four neighbours. \
Each edge has resistance close to 1/2, its value on the infinite square \
lattice:\
\>", "ExampleText",ExpressionUUID->"5d2a8ae7-eb08-4eca-9862-089a589b9e23"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"MatrixForm", " ", "@", " ", 
    RowBox[{"EffectiveResistance", "[", 
     RowBox[{"g", ",", " ", 
