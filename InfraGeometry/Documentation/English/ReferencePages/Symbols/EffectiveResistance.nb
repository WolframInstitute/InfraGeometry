Cell["\<\
The resistance from the centre against the distance on the square, hexagonal \
and triangular tilings and on a binary tree. On the tree they are equal; on \
the tilings the resistance grows far more slowly, as in the plane, where it \
grows like the logarithm of the distance.\
\>", "ExampleText",ExpressionUUID->"a820a844-e67b-4cb1-aa63-dbc487535ef3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "      ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "v"}], "]"}], ",", " ", 
           RowBox[{"EffectiveResistance", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "v"}], "]"}]}], "}"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], "}"}]}], "]"}]}], "]"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"#", ",", " ", "\"\<Small\>\""}], "]"}], " ", "&"}], " ", 
          "/@", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
            " ", "\"\<HexagonalTilingGraph\>\"", ",", 
            " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], ",", " ", 
         RowBox[{"KaryTree", "[", "31", "]"}]}], "]"}]}], "}"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<square\>\"", ",", " ", "\"\<hexagonal\>\"", ",", 
      " ", "\"\<triangular\>\"", ",", " ", "\"\<binary tree\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<d\>\"", ",", " ", "\"\<R\>\""}], "}"}]}]}], "]"}]], "Input",\

