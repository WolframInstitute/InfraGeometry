Cell["\<\
The resistance from the centre against the distance. On a tree they are \
equal; on the grid and the mesh the resistance grows far more slowly, as in \
the plane, where it grows like the logarithm of the distance:\
\>", "ExampleText",ExpressionUUID->"1c309a6a-f509-450c-92e4-c22e0595cf0d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"EffectiveResistance", "[", "g", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"VertexIndex", "[", 
             RowBox[{"g", ",", " ", "c"}], "]"}], "]"}], "]"}]}], "}"}], 
        "]"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], 
          "]"}], ",", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], 
          "]"}], ",", " ", 
         RowBox[{"KaryTree", "[", "31", "]"}]}], "}"}]}], "}"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<SquareMeshGraph\>\"", ",",
       " ", "\"\<KaryTree[31]\>\""}], "}"}]}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<d\>\"", ",", " ", "\"\<R\>\""}], "}"}]}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"df95865b-4e8d-4f72-a2dc-afd3bb51165e"],

