 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c8fa33f3-a2a2-4ed9-9420-5b3e1c80140e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["EffectiveResistance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/EffectiveResistance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
