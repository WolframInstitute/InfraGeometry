Cell["\<\
The 61 vertices of the ball of radius 5 about the centre of the grid, a \
square on its corner, and the 61 vertices nearest to the centre in \
resistance, a round disk:\
\>", "ExampleText",ExpressionUUID->"2d4b0814-ac58-4a27-8684-22b0aa7fca3d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ball", " ", "=", " ", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "5"}], "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], "]"}]}]}], ",", " ", 
     RowBox[{"r", " ", "=", " ", 
      RowBox[{
       RowBox[{"EffectiveResistance", "[", "g", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"VertexIndex", "[", 
         RowBox[{"g", ",", " ", "c"}], "]"}], "]"}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"disk", " ", "=", " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"Ordering", "[", "r", "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"Length", "[", "ball", "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"ball", ",", " ", "c"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"disk", ",", " ", "c"}], "}"}]}], "]"}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f3cd756e-89ec-4569-ae85-2fe255e18aec"],

