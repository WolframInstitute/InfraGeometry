Cell[CellGroupData[{
Cell["EffectiveResistance", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9308422f-98eb-4e9c-a4f2-d7c2bc917e6f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["EffectiveResistance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/EffectiveResistance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3a9caea-36ee-4e59-80b3-42aec838c1ec"],
 "\[LineSeparator]",
 "gives the effective resistance ",
 StyleBox["R(u, v)", "TI"],
 " between the vertices ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " of ",
 StyleBox["g", "TI"],
 ", every edge a unit resistor.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3d25789f-376f-4428-a246-01ce0f0982a5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["EffectiveResistance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/EffectiveResistance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "572d8432-1c77-4a08-9223-5449538577c1"],
 "\[LineSeparator]",
 "gives the matrix of the effective resistances of all pairs of vertices, in \
the order of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VertexList"]], "paclet:ref/VertexList"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8c304630-b198-482c-9665-869db0a0d850"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2a9a51de-e2f2-4a48-b19e-3af46c58f447"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["EffectiveResistance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/EffectiveResistance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["vs", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "779980e2-1baf-4bf0-95a1-5a8e29279159"],
 "\[LineSeparator]",
 "gives the matrix on the vertex list ",
 StyleBox["vs", "TI"],
 "."
}], "Usage",ExpressionUUID->"8a1ffcfa-84fb-48e3-b131-58a27a3909a5"],

Cell[TextData[{
 "The effective resistance is ",
 StyleBox["R(u, v) = (e\:1d64 \[Minus] e\:1d65)\:1d40 L\:207a (e\:1d64 \
\[Minus] e\:1d65)", "TI"],
 ", with ",
 StyleBox["L\:207a", "TI"],
 " the pseudoinverse of the Laplacian ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KirchhoffMatrix"]], "paclet:ref/KirchhoffMatrix"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "684ce31f-b798-4135-937e-e6d6c6a5830e"],
 ". It is the voltage between ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " when a unit current enters at ",
 StyleBox["u", "TI"],
 " and leaves at ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"c7008821-9142-42b2-b7cd-1efda567b775"],

Cell[TextData[{
 StyleBox["R", "TI"],
 " is a metric, and ",
 StyleBox["R \[LessEqual] d", "TI"],
 ", with equality on a tree. Adding an edge does not increase any \
resistance."
}], "Notes",ExpressionUUID->"e9250c29-bda6-4d25-9e38-e1a824a36662"],

Cell[TextData[{
 "On a connected graph with ",
 StyleBox["n", "TI"],
 " vertices the resistances of the edges add up to ",
 StyleBox["n", "TI"],
 " \[Minus] 1 (Foster). The expected commute time of the random walk between ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " is ",
 StyleBox["2|E| R(u, v)", "TI"],
 "."
}], "Notes",ExpressionUUID->"4c295a0b-32c3-4409-82af-c19334c62bcc"],

Cell[TextData[{
 "Between two components no current flows, and ",
 StyleBox["R", "TI"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bb5d7840-1ee3-478c-8b74-3a066161f47e"],
 ". The values are machine numbers."
}], "Notes",ExpressionUUID->"b1efedf5-743a-4dcd-ae7d-1f2148fe61df"]
}, Open  ]],

