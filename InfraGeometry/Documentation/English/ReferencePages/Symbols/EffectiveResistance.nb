Cell[TextData[{
 "The whole matrix: on the 12-cycle ",
 StyleBox["R", "TI"],
 "(",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["k", "TI"],
 "(12 \[Minus] ",
 StyleBox["k", "TI"],
 ")/12 for vertices ",
 StyleBox["k", "TI"],
 " steps apart, the two arcs carrying the current in parallel."
}], "ExampleText",ExpressionUUID->"3f9c171f-1ec2-426b-a88e-043e789d89ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"resistances", " ", "=", " ", 
     RowBox[{"EffectiveResistance", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MatrixPlot", "[", "resistances", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"resistances", " ", "-", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"k", " ", "=", " ", 
               RowBox[{"Abs", "[", 
                RowBox[{"i", " ", "-", " ", "j"}], "]"}]}], "}"}], ",", " ", 
             RowBox[{"k", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"12", " ", "-", " ", "k"}], ")"}], "/", "12"}]}]}], 
            "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "12"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "12"}], "}"}]}], "]"}]}], "]"}], "]"}], 
      " ", "<", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "9"}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"440b41b9-de26-4469-bbe5-175eaaa9e65a"],

