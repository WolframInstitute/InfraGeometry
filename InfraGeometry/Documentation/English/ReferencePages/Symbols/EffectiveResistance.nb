Cell["\<\
The matrix on a vertex list: the four corners of the square tiling, red, each \
held by one edge.\
\>", "ExampleText",ExpressionUUID->"5bb01472-3dc6-4220-9b5e-e5eeb40e92de"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexDegree", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}], " ", "==", " ", "1"}], " ", 
        "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"corners", " ", "->", " ", "StandardRed"}], "}"}]}], "]"}], ",",
      " ", 
     RowBox[{"MatrixForm", "[", 
      RowBox[{"EffectiveResistance", "[", 
       RowBox[{"g", ",", " ", "corners"}], "]"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"96a4d621-2fc1-4cfa-b99f-84bd44a7a523"],

