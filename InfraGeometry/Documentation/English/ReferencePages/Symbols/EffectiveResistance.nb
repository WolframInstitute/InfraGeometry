Cell[TextData[{
 "Definition: with ",
 StyleBox["L", "TI"],
 " the Laplacian of ",
 StyleBox["g", "TI"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KirchhoffMatrix"]], "paclet:ref/KirchhoffMatrix"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "962c7305-9ece-4fde-9066-06708f2ae8b5"],
 ", and ",
 StyleBox["L", "TI"],
 "\:207a its pseudoinverse, ",
 StyleBox["R", "TI"],
 "(",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") = (",
 StyleBox["e", "TI"],
 "\:1d64 \[Minus] ",
 StyleBox["e", "TI"],
 "\:1d65)\:1d40 ",
 StyleBox["L", "TI"],
 "\:207a (",
 StyleBox["e", "TI"],
 "\:1d64 \[Minus] ",
 StyleBox["e", "TI"],
 "\:1d65) = ",
 StyleBox["L", "TI"],
 "\:207a\:1d64\:1d64 + ",
 StyleBox["L", "TI"],
 "\:207a\:1d65\:1d65 \[Minus] 2",
 StyleBox["L", "TI"],
 "\:207a\:1d64\:1d65, the resistance distance of Klein and Randi\[CAcute]. It \
is the voltage between ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " when every edge is a unit resistor and a unit current enters at ",
 StyleBox["u", "TI"],
 " and leaves at ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"2143c846-9183-4500-a144-0895a6167fdf"],

Cell[TextData[{
 StyleBox["R", "TI"],
 " is a metric, and ",
 StyleBox["R", "TI"],
 " \[LessEqual] ",
 StyleBox["d", "TI"],
 ", with equality on a tree, where the current has one path. Adding an edge \
does not increase any resistance. On a connected graph the resistances of the \
edges add up to ",
 StyleBox["n", "TI"],
 " \[Minus] 1, for ",
 StyleBox["n", "TI"],
 " vertices (Foster), and the expected commute time of the random walk \
between ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " is 2|",
 StyleBox["E", "TI"],
 "| ",
 StyleBox["R", "TI"],
 "(",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ")."
}], "Notes",ExpressionUUID->"2609870c-0258-408c-8aa4-2addb80e7131"],

Cell[TextData[{
 "The resistances are the squared distances of the points of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ResistanceCoordinates"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ResistanceCoordinates", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0291b32e-8800-4ae4-9e08-e727db0bf254"],
 ". The values are machine numbers."
}], "Notes",ExpressionUUID->"93e9f4b6-6f0c-4f26-ba98-4f697b226782"]
}, Open  ]],

