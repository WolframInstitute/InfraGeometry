Cell["\<\
The resistance of every edge of the square, hexagonal and triangular tilings, \
blue near 0 and red at 1, where an edge is a bridge. The resistances of the \
edges add up to one less than the number of vertices (Foster). Away from the \
rim an edge has resistance near 1/2, 2/3 and 1/3, two over the degree.\
\>", "ExampleText",ExpressionUUID->"ba513bf2-2233-4f32-b0cc-305d074a9d2b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graphs", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"#", ",", " ", "\"\<Small\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}],
        " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"edgeResistances", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "       ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"resistances", " ", "=", " ", 
           RowBox[{"EffectiveResistance", "[", "g", "]"}]}], "}"}], ",", "\n",
          "       ", 
         RowBox[{"AssociationMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"resistances", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"VertexIndex", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{"First", "[", "#", "]"}]}], "]"}], ",", " ", 
               RowBox[{"VertexIndex", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{"Last", "[", "#", "]"}]}], "]"}]}], "]"}], "]"}], 
            " ", "&"}], ",", " ", 
           RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}]}], "]"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{"g", ",", " ", "graphs"}], "}"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"MapThread", "[", "\n", "     ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", ",", " ", "edgeValues"}], "}"}], " ", "|->", " ", 
         RowBox[{"InfraSubstrateHighlight", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"KeyValueMap", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"edge", ",", " ", "r"}], "}"}], " ", "|->", " ", 
              RowBox[{
               RowBox[{"InfraWalk", "[", 
                RowBox[{"List", " ", "@@", " ", "edge"}], "]"}], " ", "->", 
               " ", 
               RowBox[{"Blend", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"StandardBlue", ",", " ", "StandardRed"}], "}"}], ",",
                  " ", "r"}], "]"}]}]}], ",", " ", "edgeValues"}], "]"}]}], 
          "]"}]}], ",", "\n", "     ", 
        RowBox[{"{", 
         RowBox[{"graphs", ",", " ", "edgeResistances"}], "}"}]}], "]"}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"Values", "[", "#1", "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"VertexCount", "[", "#2", "]"}], " ", "-", " ", "1"}]}], 
         "}"}], " ", "&"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"edgeResistances", ",", " ", "graphs"}], "}"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"19d7fa9f-f719-415b-8358-52cbfbc05bd1"],

