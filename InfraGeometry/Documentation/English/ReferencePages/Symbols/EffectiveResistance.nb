Cell[TextData[{
 "The whole matrix. On the 12-cycle, ",
 StyleBox["R(u, v) = k(12 \[Minus] k)/12", "TI"],
 " for vertices ",
 StyleBox["k", "TI"],
 " steps apart, the two arcs carrying the current in parallel:"
}], "ExampleText",ExpressionUUID->"666230f9-3148-423e-ba16-d247f2e0050b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"r", " ", "=", " ", 
     RowBox[{"EffectiveResistance", "[", 
      RowBox[{"CycleGraph", "[", "12", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Chop", " ", "@", " ", 
      RowBox[{"First", "[", "r", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Max", " ", "@", " ", 
       RowBox[{"Abs", "[", 
        RowBox[{"r", " ", "-", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"i", " ", "-", " ", "j"}], "]"}], " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"12", " ", "-", " ", 
               RowBox[{"Abs", "[", 
                RowBox[{"i", " ", "-", " ", "j"}], "]"}]}], ")"}], " ", "/", 
             " ", "12"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "12"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "12"}], "}"}]}], "]"}]}], "]"}]}], " ", "<",
       " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "9"}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"74aeb79e-5b4e-4d38-9f00-0b424c9aafaf"],

