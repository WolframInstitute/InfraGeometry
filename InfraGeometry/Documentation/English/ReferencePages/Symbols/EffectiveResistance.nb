Cell["\<\
Foster's theorem: the resistances of the edges add up to one less than the \
number of vertices. The resistance is at most the distance:\
\>", "ExampleText",ExpressionUUID->"824332fb-e5a8-47a8-95f8-e4df43b5b0cc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"EffectiveResistance", "[", "g", "]"}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"r", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"VertexIndex", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"First", "[", "#", "]"}]}], "]"}], ",", " ", 
             RowBox[{"VertexIndex", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"Last", "[", "#", "]"}]}], "]"}]}], "]"}], "]"}], " ", 
          "&"}], " ", "/@", " ", 
         RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"VertexCount", "[", "g", "]"}], " ", "-", " ", "1"}], ",", 
       "\n", "     ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"r", " ", "-", " ", 
          RowBox[{"GraphDistanceMatrix", "[", "g", "]"}]}], "]"}], " ", "<", 
        " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], "}"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", 
       " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7f3fa032-d6b1-4a92-b49e-27f1f3f7e4a1"],

