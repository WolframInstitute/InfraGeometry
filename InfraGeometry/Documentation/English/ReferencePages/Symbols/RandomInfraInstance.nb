Cell["RandomSeeding", "ExampleSubsection",ExpressionUUID->"650ca9ee-7691-4655-b57f-f433630330a6"],

Cell["Repeat a complete scene search with an explicit seed.", "ExampleText",ExpressionUUID->"551e5eb6-bb7f-405d-bd48-2e773e8021ec"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "q"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "]"}]}], ",", " ", 
         RowBox[{"q", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"InfraDistance", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], " ", "==", " ", "2"}]}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"instance", " ", "=", " ", 
     RowBox[{"RandomInfraInstance", "[", 
      RowBox[{"scene", ",", " ", "g", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "123"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraSceneInstance", "[", 
         RowBox[{"instance", ",", " ", 
          RowBox[{"{", 
           RowBox[{"p", ",", " ", "q"}], "}"}]}], "]"}], "}"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"instance", " ", "===", " ", 
      RowBox[{"RandomInfraInstance", "[", 
       RowBox[{"scene", ",", " ", "g", ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "123"}]}], "]"}]}]}], 
    "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"17c5726c-1c67-4b35-bb64-9c36fbc30849"],

