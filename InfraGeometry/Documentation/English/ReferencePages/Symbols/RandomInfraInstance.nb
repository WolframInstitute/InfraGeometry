Cell["RandomSeeding", "ExampleSubsection",ExpressionUUID->"e1575e5a-9032-47db-8e39-611bb14af10f"],

Cell["Repeat a complete scene search with an explicit seed.", "ExampleText",ExpressionUUID->"ac80fb3b-e79c-4517-a0ea-c62ceb6926ff"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "q"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "]"}]}], ",", " ", 
         RowBox[{"q", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"InfraDistance", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], " ", "==", " ", "2"}]}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"instance", " ", "=", " ", 
     RowBox[{"RandomInfraInstance", "[", 
      RowBox[{"scene", ",", " ", "g", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "123"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraSceneInstance", "[", 
         RowBox[{"instance", ",", " ", 
          RowBox[{"{", 
           RowBox[{"p", ",", " ", "q"}], "}"}]}], "]"}], "}"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"instance", " ", "===", " ", 
      RowBox[{"RandomInfraInstance", "[", 
       RowBox[{"scene", ",", " ", "g", ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "123"}]}], "]"}]}]}], 
    "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"bd44b6a5-a370-45f7-a9ab-12c08322db05"],

