 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ba122613-ee3e-47e2-bcc3-5e2ee8fdcb77"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraInstance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraInstance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["scene", "TI"], ",", " ", 
    StyleBox["graph", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05895b38-fdf3-4715-b127-b2cf19f9f549"],
 "\[LineSeparator]",
 "draws one admissible ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSceneInstance"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSceneInstance", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2606051f-bd9b-41fb-9493-6c4f6706d5e6"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"cf5bb677-65ca-4426-93b4-dac37bee1891"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraInstance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraInstance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["scene", "TI"], ",", " ", 
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc64362c-726c-484e-be77-e01ad579afcb"],
 "\[LineSeparator]",
 "gives exactly ",
 StyleBox["n", "TI"],
 " distinct instances, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0c3aa68-d53d-4799-bbbc-ec9da0272d4e"],
 " when fewer exist. ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "317eed92-4992-4832-981f-72e97f1fb122"],
 " gives at most ",
 StyleBox["n", "TI"],
 ". ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb18128b-607d-4186-8e10-666774b44dce"],
 " enumerates every instance in construction order when the construction and \
selection callbacks are deterministic.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4e9d7571-dc0a-4ec0-ac9e-5b4d8c2ba322"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraInstance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraInstance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["scene", "TI"], ",", " ", 
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["bindings", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7eb51f49-c207-48e0-8aaa-81abf16153cd"],
 "\[LineSeparator]",
 "fixes the given ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dc5dd2a-f35e-4eca-b747-2566ad1b19bb"],
 " of bindings. A count may precede ",
 StyleBox["bindings", "TI"],
 "."
}], "Usage",ExpressionUUID->"9c024a70-2d04-4e07-8fad-50f57b6f8996"],

Cell[TextData[{
 "The search extends one binding at a time, checks each assertion as soon as \
its objects are bound, and backtracks from a dead end. It stops when the \
requested number of distinct instances has been found. A count-less call with \
no admissible instance gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "962dbef4-e8cd-4138-b49d-1e63fbd7f258"],
 "."
}], "Notes",ExpressionUUID->"d0cb9c55-066a-4281-a5ea-55e73ff1015c"],

Cell["\<\
The default draw is not uniform over instances. Each visited construction \
enumerates its candidate family; the search avoids forming the full product \
of those families.\
\>", "Notes",ExpressionUUID->"4cfecadb-e142-419c-b04b-139220a4dc37"],

Cell["\<\
An object already bound is not constructed again. A partly fixed tuple \
construction keeps only tuples agreeing with its fixed entries.\
\>", "Notes",ExpressionUUID->"8a2ea4cf-dc72-4b7f-adbe-2a12b1bd61df"],

