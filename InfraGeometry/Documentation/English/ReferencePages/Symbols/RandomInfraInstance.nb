Cell["\<\
An inherited seed snapshots the ambient state without advancing it; repeated \
calls can return the same instance.\
\>", "ExampleText",ExpressionUUID->"fe0e7931-bf80-4594-9ce1-5626a9795fbd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "123", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "p", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", "p", "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", " ", "==", " ", 
         RowBox[{"InfraPoint", "[", "]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"instance", " ", "=", " ", 
     RowBox[{"RandomInfraInstance", "[", 
      RowBox[{"scene", ",", " ", "g", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "Inherited"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"instance", " ", "===", " ", 
    RowBox[{"RandomInfraInstance", "[", 
     RowBox[{"scene", ",", " ", "g", ",", " ", 
      RowBox[{"RandomSeeding", " ", "->", " ", "Inherited"}]}], "]"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"89762d83-d743-4716-ba45-211dc9f5fcdd"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"71845ede-f4a8-4e8a-9586-32f21e6580d5"]
}, Open  ]]
