Cell["\<\
An inherited seed snapshots the ambient state without advancing it; repeated \
calls can return the same instance.\
\>", "ExampleText",ExpressionUUID->"1c9a8003-fa23-40f6-9fe8-8f59a28714e0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "123", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "p", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", "p", "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", " ", "==", " ", 
         RowBox[{"InfraPoint", "[", "]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"instance", " ", "=", " ", 
     RowBox[{"RandomInfraInstance", "[", 
      RowBox[{"scene", ",", " ", "g", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "Inherited"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"instance", " ", "===", " ", 
    RowBox[{"RandomInfraInstance", "[", 
     RowBox[{"scene", ",", " ", "g", ",", " ", 
      RowBox[{"RandomSeeding", " ", "->", " ", "Inherited"}]}], "]"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9027084d-ce31-499c-811f-3c3bf87f0d42"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"812446ff-1c0f-4feb-99d6-d20e2556c3bc"]
