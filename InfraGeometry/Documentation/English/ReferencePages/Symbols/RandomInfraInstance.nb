Cell["\<\
Fixing the second point in advance leaves only the segment to choose: one \
instance per shortest path.\
\>", "ExampleText",ExpressionUUID->"9d34eea4-b5e9-4a35-8cb2-f205f42f3a03"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"pA", ",", " ", "pB", ",", " ", "seg1"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "pB", ",", " ", "seg1"}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "c", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"InfraDistance", "[", 
           RowBox[{"pA", ",", " ", "pB"}], "]"}], " ", "==", " ", "2"}], ",", 
         " ", 
         RowBox[{"seg1", " ", "==", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"pA", ",", " ", "pB"}], "]"}]}]}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"segments", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraSceneInstance", "[", 
        RowBox[{"#", ",", " ", "seg1"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"RandomInfraInstance", "[", 
       RowBox[{"scene", ",", " ", "g", ",", " ", 
        RowBox[{"<|", 
         RowBox[{"pB", " ", "->", " ", "b"}], "|>"}]}], "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"segments", ",", " ", "c", ",", " ", "b"}], "}"}]}], "]"}], ",",
      " ", 
     RowBox[{"Length", " ", "@", " ", "segments"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"11d053b6-39f1-4c6d-a0b7-670087943240"],

