Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7d24c59-ffdf-481d-8f41-e82c84f5f422"],
 " gives deterministic descent. Ambient ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf25573a-0b65-42e5-ace4-99cd6414e08a"],
 " controls random draws. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "963ce241-41ca-43a9-82b9-ab889dcb525d"],
 " with ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6da12b0-04af-47ff-b379-96c0091a2a0e"],
 " makes no draw."
}], "Notes",ExpressionUUID->"4916d608-1ff9-495a-ae83-6d4db35d5441"],

Cell[TextData[{
 "A function such as ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    RowBox[{"RandomSample", "[", 
     RowBox[{"#", ",", " ", 
      RowBox[{"UpTo", "[", "2", "]"}]}], "]"}], " ", "&"}], ")"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97530864-71ae-4250-bfc2-5c78912c84d9"],
 " keeps at most two candidate extensions at each construction. Failure then \
means failure in the retained tree. ",
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d835cba-87c2-43c4-ab49-a9a90c460278"],
 " follows just one route, without backtracking, and is not accepted with ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08778197-9491-4766-8a15-8e6ad43b34f6"],
 "."
}], "Notes",ExpressionUUID->"1d4ececb-c907-4915-9a0d-af63a6dd7883"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Steps\>\"", " ", "->", " ", "k"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45b75aae-7bda-4036-919f-920ac999364a"],
 " returns partial bindings after the first ",
 StyleBox["k", "TI"],
 " steps. Assertions with unbound objects remain deferred; a partial binding \
need not have a complete extension. The third integer argument counts \
instances, not steps."
}], "Notes",ExpressionUUID->"33aacb63-262a-42ca-a3d4-185167cf8658"]
}, Open  ]],

