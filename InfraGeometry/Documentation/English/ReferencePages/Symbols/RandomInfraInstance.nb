  }]], "3ColumnTableMod",ExpressionUUID->"e76400cf-88e9-42a4-8934-\
d6383b0f1b6b"],

Cell[TextData[{
 "With deterministic construction callbacks, ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38b96661-8e9b-4718-8ad5-1904815a768f"],
 " gives deterministic descent, and ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "633f3c0e-fecf-4e13-8f20-cdaf93cbc1dd"],
 " with the default ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Automatic"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5ec735a-838a-4c6f-9586-b31c0b72c0cc"],
 " makes no random draw. Stochastic construction callbacks or explicit \
stochastic candidate ordering and pruning use the local scene stream."
}], "Notes",ExpressionUUID->"4a835238-6278-460a-b9e5-0d6e2a10f8f1"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomSeeding", " ", "->", " ", "Automatic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0429b302-ca64-412b-b9a3-d096f4532fc7"],
 " freshly seeds each call. An integer or string gives a reproducible call; a \
saved ",
 Cell[BoxData["RandomGeneratorState"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82320bf4-17f3-4d10-ad93-6fad5b984aa5"],
 " restores that state locally. ",
 Cell[BoxData["Inherited"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8da2624d-51c7-4be2-995d-6f01ae06ad2e"],
 " uses a local snapshot of the current generator state. Every setting \
restores the outer random state afterward, so successive ",
 Cell[BoxData["Inherited"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b1065a2-af4b-4f47-930a-ad1a11d8a7bc"],
 " calls can repeat."
}], "Notes",ExpressionUUID->"032a7dcb-4d33-4e7d-8329-5c53359edc81"],

Cell[TextData[{
 "The seed applies once to the complete search, including random \
candidate-selection callbacks and nested geometry samplers. Counts, initial \
bindings and ",
 Cell[BoxData["\"\<Steps\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48cfb63b-e62a-4380-8676-a40739c7c2c6"],
 " retain their existing meanings. A stochastic callback with ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f704e96-dadf-466a-bf77-a2b6c5b261ed"],
 " can prune the search; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed299782-37a0-4348-9ad3-2970a9583e04"],
 " is exhaustive only for the retained tree."
}], "Notes",ExpressionUUID->"fd28190c-6ec2-4c1b-b2d0-2c1494dfd6c7"],

Cell[TextData[{
 "This follows Wolfram's ",
 ButtonBox["RandomInstance",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/RandomInstance.html"], 
    None}],
 " and ",
 ButtonBox["RandomSeeding",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/RandomSeeding.html"], 
    None}],
 " convention. Named geometry samplers instead use ambient ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dc34d6d-568e-4139-b139-016293633d81"],
 ", like ",
 ButtonBox["RandomPoint",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/RandomPoint.html"], None}],
 " and ",
 ButtonBox["RandomChoice",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/RandomChoice.html"], 
    None}],
 ". To migrate an externally seeded scene example, supply ",
 Cell[BoxData[
  RowBox[{"RandomSeeding", " ", "->", " ", "seed"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b6689e5-caaf-45fa-8b05-c803d048df85"],
 " directly; use ",
 Cell[BoxData["Inherited"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "017eb793-ded5-449e-90a7-fbe58fc4eaa8"],
 " when a local snapshot of an externally seeded stream is intended."
}], "Notes",ExpressionUUID->"07a23516-28de-4adc-b338-ab543913e4de"],

Cell[TextData[{
 "A function such as ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    RowBox[{"RandomSample", "[", 
     RowBox[{"#", ",", " ", 
      RowBox[{"UpTo", "[", "2", "]"}]}], "]"}], " ", "&"}], ")"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c52286b3-a160-4bfe-8fa9-1347b63227ce"],
 " keeps at most two candidate extensions at each construction. Failure then \
means failure in the retained tree. ",
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fead8de-88c9-4cb9-aee7-58d3581bbc24"],
 " follows just one route, without backtracking, and is not accepted with ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43e3b79d-5c15-46ca-a78c-47486da4e70c"],
 "."
}], "Notes",ExpressionUUID->"f52d8549-19a0-4582-9553-493ef64770be"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Steps\>\"", " ", "->", " ", "k"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "456c9840-cee6-4d75-ab6b-5e1ce9b1a978"],
 " returns partial bindings after the first ",
 StyleBox["k", "TI"],
 " steps. Assertions with unbound objects remain deferred; a partial binding \
need not have a complete extension. The third integer argument counts \
instances, not steps."
}], "Notes",ExpressionUUID->"a44bab14-6b46-49f1-af1a-64ab31085720"]
}, Open  ]],

