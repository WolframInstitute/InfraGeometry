Cell["RandomInfraInstance", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b7647065-eb8f-4e3a-8086-f1a94d26ec9d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraInstance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraInstance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["scene", "TI"], ",", " ", 
    StyleBox["graph", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c242bf4-87cd-4a4a-907d-c273fddabb9d"],
 "\[LineSeparator]",
 "draws one admissible ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSceneInstance"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSceneInstance", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "91080b5e-d95f-4541-8de0-88bde01c48ab"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b98941fd-cc0a-462f-a16c-90af5761c9ba"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraInstance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraInstance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["scene", "TI"], ",", " ", 
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f6f1f20-c895-4df0-85de-9e132d6e2472"],
 "\[LineSeparator]",
 "gives exactly ",
 StyleBox["n", "TI"],
 " distinct instances, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "433adb97-e550-4617-91f2-0fbe19903d2e"],
 " when fewer exist. ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82a94f0e-69be-4591-99f9-ccc6cd95cb59"],
 " gives at most ",
 StyleBox["n", "TI"],
 ". ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b7da4c8-8e28-435b-9543-e585f069830c"],
 " enumerates every instance in construction order when the construction and \
selection callbacks are deterministic.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a6924ad2-97a2-49cf-b866-9672a65517b7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraInstance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraInstance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["scene", "TI"], ",", " ", 
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["bindings", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "900653ae-d2a8-4a6d-b736-1eb40796c67a"],
 "\[LineSeparator]",
 "fixes the given ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "89d848e6-a299-469c-94b8-9e592ce47d84"],
 " of bindings. A count may precede ",
 StyleBox["bindings", "TI"],
 "."
}], "Usage",ExpressionUUID->"cfb18ee6-b200-463e-b810-5ea9533d8f3b"],

Cell[TextData[{
 "The search extends one binding at a time, checks each assertion as soon as \
its objects are bound, and backtracks from a dead end. It stops when the \
requested number of distinct instances has been found. A count-less call with \
no admissible instance gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b98f4155-273d-4c17-bd90-d8686d507fa2"],
 "."
}], "Notes",ExpressionUUID->"fa24e22e-dc6c-4c95-bdbd-8b36fe2b5f04"],

Cell["\<\
The default draw is not uniform over instances. Each visited construction \
enumerates its candidate family; the search avoids forming the full product \
of those families.\
\>", "Notes",ExpressionUUID->"f153b77e-bd6d-4533-955e-5d9f3ec26338"],

Cell["\<\
An object already bound is not constructed again. A partly fixed tuple \
construction keeps only tuples agreeing with its fixed entries.\
\>", "Notes",ExpressionUUID->"da03cd7e-9429-428c-b0de-4fa3cc50e53f"],

