Cell[TextData[{
 "A germ fixes the middle stretch. The two shortest paths from ",
 StyleBox["p", "TI"],
 " to a diagonal ",
 StyleBox["q", "TI"],
 " split the lines through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " in two:"
}], "ExampleText",ExpressionUUID->"26c304e5-e870-4b19-b773-6d3d43943a51"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"p", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"germs", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "p", ",", " ", "q", ",", " ", "All"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraInfiniteLine", "[", "germ", "]"}], ",", " ", 
          RowBox[{"InfraWalk", "[", "germ", "]"}]}], "}"}], ",", "\n", 
        "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraInfiniteLine", "[", "germ", "]"}], ",", 
           " ", "\"\<Cardinality\>\""}], "]"}]}]}], "]"}], ",", "\n", "    ", 
      
      RowBox[{"{", 
       RowBox[{"germ", ",", " ", "germs"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"54549da3-2a8f-4b8b-affe-80a0a2a8f9be"],

