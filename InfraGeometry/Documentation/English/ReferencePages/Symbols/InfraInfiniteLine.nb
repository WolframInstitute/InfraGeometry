Cell["\<\
The union of the three DAGs carries the path 5, 6, 1, 2, 3, 4 from 5 to 4, \
which is no shortest path:\
\>", "ExampleText",ExpressionUUID->"7805291e-f89f-401a-abb3-c030ea188ef4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "6", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"union", " ", "=", " ", 
     RowBox[{"GraphUnion", " ", "@@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraInfiniteLine", "[", 
         RowBox[{"1", ",", " ", "2"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FindPath", "[", 
      RowBox[{"union", ",", " ", "5", ",", " ", "4"}], "]"}], ",", " ", 
     RowBox[{"GraphDistance", "[", 
      RowBox[{"g", ",", " ", "5", ",", " ", "4"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"de2a0cea-fd3b-4b1b-9f5a-246890bc6783"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"5", ",", "6", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}], 
    "}"}], ",", "1"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"b332fa4b-ec17-456f-a9f9-ab7c1b6543ca"]
}, Open  ]],

Cell[TextData[{
 "Every ray from ",
 StyleBox["p", "TI"],
 " through ",
 StyleBox["q", "TI"],
 " is the tail of a line through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ". Not conversely: a line stops where no step leads farther from its other \
end, which can come before a ray stops. On the mesh 22 rays and 28 tails:"
}], "ExampleText",ExpressionUUID->"6f05409e-38c1-4141-b75f-10e9592dbe55"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"p", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"tails", " ", "=", " ", 
     RowBox[{"Union", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Drop", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"FirstPosition", "[", 
             RowBox[{"#", ",", " ", "p"}], "]"}]}], " ", "-", " ", "1"}]}], 
         "]"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"RandomInfraInfiniteLine", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraInfiniteLine", "[", 
          RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rays", " ", "=", " ", 
     RowBox[{"RandomInfraHalfLine", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraHalfLine", "[", 
        RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "All"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"SubsetQ", "[", 
      RowBox[{"tails", ",", " ", "rays"}], "]"}], ",", " ", 
     RowBox[{"Length", "[", "rays", "]"}], ",", " ", 
     RowBox[{"Length", "[", "tails", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"bad68ed6-cdd9-4e66-85f7-a1f85eb3bbb0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "22", ",", "28"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"cac9f945-372a-455e-996b-065ee65e501c"]
}, Open  ]]
}, Open  ]],

