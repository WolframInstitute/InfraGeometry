Cell["\<\
The DAGs are not merged: their union can carry paths that are not shortest \
paths.\
\>", "Notes",ExpressionUUID->"af4a9348-65d6-4f77-819e-0d74b9452c75"],

Cell[TextData[{
 "A line through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " contains exactly one shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ". So the line through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " is the disjoint union of the lines through its germs, and the germ form \
keeps one of them. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraInfiniteLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraInfiniteLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a54a7e3c-ca7c-41b5-bf61-f1312ad9814e"],
 " is every inextensible shortest path through ",
 StyleBox["p", "TI"],
 ", once in each direction."
}], "Notes",ExpressionUUID->"f3b34bde-207e-44f3-8e9c-ea29ea95eab4"],

