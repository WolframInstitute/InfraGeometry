Cell[CellGroupData[{
Cell["InfraInfiniteLine", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2ca3659a-5c84-47dd-b287-ddf66f5bd579"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraInfiniteLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraInfiniteLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5520345e-9a85-46c7-b7e5-7d0e4bec306a"],
 "\[LineSeparator]",
 "is the line through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ": the family of all inextensible shortest paths that pass through ",
 StyleBox["p", "TI"],
 " and then ",
 StyleBox["q", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6b68bbcc-75be-4475-9e8a-e6e98585455b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraInfiniteLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraInfiniteLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["germ", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d9276bf-8fe0-4d07-bfe8-0149ca139a5d"],
 "\[LineSeparator]",
 "is the line through a germ: the inextensible shortest paths that contain \
the shortest path ",
 StyleBox["germ", "TI"],
 " as a contiguous stretch."
}], "Usage",ExpressionUUID->"d564ee7a-da1d-4ca0-8029-1eab772d8722"],

Cell[TextData[{
 "A line is a shortest path ",
 StyleBox["(v\:2080, \[Ellipsis], v\:2099)", "TI"],
 ", ",
 StyleBox["d(v\:2080, v\:2099) = n", "TI"],
 ", that no neighbour of either end prolongs: no ",
 StyleBox["u", "TI"],
 " adjacent to ",
 StyleBox["v\:2080", "TI"],
 " has ",
 StyleBox["d(u, v\:2099) = n + 1", "TI"],
 ", and likewise at ",
 StyleBox["v\:2099", "TI"],
 "."
}], "Notes",ExpressionUUID->"99131fb2-ffbc-4094-a8c1-b285e753abd4"],

Cell[TextData[{
 "A graph line is finite and ends where the graph does not let it go on. A \
line through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " has ends ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " with ",
 StyleBox["d(a, b) = d(a, p) + d(p, q) + d(q, b)", "TI"],
 ", and its length is ",
 StyleBox["d(a, b)", "TI"],
 ": lines through the same two points can have different lengths."
}], "Notes",ExpressionUUID->"40290e0d-af37-42d1-a929-75cc32cb2a4b"],

Cell["\<\
The line through two points is not unique. On the square grid it is a large \
family, and its support covers whole quadrants.\
\>", "Notes",ExpressionUUID->"fedb561f-d9d5-4aac-b956-deb6425d558e"],

