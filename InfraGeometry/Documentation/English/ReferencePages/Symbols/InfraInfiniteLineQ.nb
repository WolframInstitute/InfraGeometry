Cell[CellGroupData[{
Cell["InfraInfiniteLineQ", "ObjectName",ExpressionUUID->"3a471654-2c14-4721-8122-43cd5b5e79be"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"84d4a524-5b1d-430a-94c5-075796d29ebc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraInfiniteLineQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraInfiniteLineQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "453e0abb-7acf-4e4e-bf6f-370e3d426402"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["walk", "TI"],
 " is a line in ",
 StyleBox["g", "TI"],
 ": a shortest path that no neighbour of either endpoint prolongs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5945cb83-bdb0-49fb-bbb1-fc78e25f0e4f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraInfiniteLineQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraInfiniteLineQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["lines", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe6f38d3-20ef-47eb-a6ec-169f70e35657"],
 "\[LineSeparator]",
 "tests every line of an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraInfiniteLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraInfiniteLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1153ce2a-7a8a-465d-8e23-e87602f0c094"],
 " bundle or pool."
}], "Usage",ExpressionUUID->"90ffdad6-2666-44b1-a8c4-a2cb355761a5"],

Cell[TextData[{
 "Two conditions: the sequence is a shortest path (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegmentQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3e30c00c-5d9b-4fca-b4b7-dc3eba2ef758"],
 "), and stepping off either end to a neighbour gives a walk that is no \
longer a shortest path \[LongDash] no neighbour of the first vertex lies one \
step farther from the last, and no neighbour of the last lies one step \
farther from the first. Both tests are single distance lookups."
}], "Notes",ExpressionUUID->"789651c2-e0a5-48e6-a701-c7768dbb1fbd"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf943fbd-c82c-414a-865c-c6ec1c9f2b89"],
 "."
}], "Notes",ExpressionUUID->"1379f2ca-679b-4183-90c2-3aa1a81b25ce"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraInfiniteLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraInfiniteLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b8044543-606e-4bcd-a35f-075cde73f241"],
 ", and every line that finder returns satisfies it under every ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbb40b74-2417-4466-bb85-33ff20d56da9"],
 "."
}], "Notes",ExpressionUUID->"18c6d345-17f0-41f9-b66c-682223f0a871"]
}, Open  ]],

