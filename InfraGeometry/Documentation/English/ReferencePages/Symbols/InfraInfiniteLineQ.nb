Cell[CellGroupData[{
Cell["InfraInfiniteLineQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"93c6c9bb-f7ed-462a-a70d-8c2ae004e518"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraInfiniteLineQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraInfiniteLineQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0830b55-df26-4904-b1fc-88bb685684cb"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["walk", "TI"],
 " is a line in ",
 StyleBox["g", "TI"],
 ": a shortest path that no neighbour of either endpoint prolongs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"65efb143-3d74-4050-bdec-4e27d5032220"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraInfiniteLineQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraInfiniteLineQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["lines", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d9a2aa5-26f3-4c76-b517-d87ad9494dc8"],
 "\[LineSeparator]",
 "tests every line of an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraInfiniteLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraInfiniteLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cef9e0a4-8ebb-4608-b94f-17a8db6e61c2"],
 " bundle or pool."
}], "Usage",ExpressionUUID->"09bae52d-c388-4977-a8ab-bd59102248a0"],

Cell[TextData[{
 "Two conditions: the sequence is a shortest path (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegmentQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a4c3f917-af9b-4867-b555-e0f163307995"],
 "), and stepping off either end to a neighbour gives a walk that is no \
longer a shortest path \[LongDash] no neighbour of the first vertex lies one \
step farther from the last, and no neighbour of the last lies one step \
farther from the first. Both tests are single distance lookups."
}], "Notes",ExpressionUUID->"0a085d3e-201a-4bd8-b24b-3a2c2bd3462c"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96b2c424-c80b-4e34-a90c-606b026b51cf"],
 "."
}], "Notes",ExpressionUUID->"81f1600d-f397-464c-942c-ed1cd0608ed5"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraInfiniteLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraInfiniteLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "61b7ff11-5cf1-4b0d-9ff3-34bc547acea3"],
 ", and every line that finder returns satisfies it under every ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a363604-5f76-4301-b8ae-fb8412b1ffe2"],
 "."
}], "Notes",ExpressionUUID->"8cab2cab-c68e-4177-b750-f4514476c2e4"]
}, Open  ]],

