Cell["\<\
The double cover of a cycle is a fibration. Deleting one total edge breaks \
it: its two endpoints, drawn, lose their lift of a base edge.\
\>", "ExampleText",ExpressionUUID->"78947837-5445-43a9-ae00-a3620bd6eaaf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<CycleDoubleCover\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalSpace", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cut", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"EdgeList", "[", "total", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"broken", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"EdgeDelete", "[", 
        RowBox[{"total", ",", " ", "cut"}], "]"}], ",", " ", 
       RowBox[{"InfraProjection", "[", "fib", "]"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{
       RowBox[{"InfraTotalSpace", "[", "broken", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraDensity", "[", 
         RowBox[{"total", ",", " ", 
          RowBox[{"List", " ", "@@", " ", "cut"}]}], "]"}], "}"}]}], "]"}], ",",
      " ", 
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraFibrationQ", "[", "broken", "]"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c2d19ee7-0c43-49a8-b975-bbe477c4aa60"],

