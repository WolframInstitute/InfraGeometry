Cell["\<\
Projected to its columns, the full grid graph is a fibration. The square grid \
is not: the vertices on its top and bottom rim have no neighbour in the next \
columns:\
\>", "ExampleText",ExpressionUUID->"4a7b6139-4373-4883-a3bb-8e6cb6096523"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"InfraFibrationQ", " ", "@", " ", 
    RowBox[{"InfraFiberedGraph", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"Round", " ", "@", " ", 
         RowBox[{
          RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}]}], "]"}]}], "]"}]}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"8", ",", " ", "8"}], "}"}], "]"}], ",", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
         " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
        "]"}]}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f47c8ef9-903f-4adb-a5de-40aa26b03096"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"8d41301b-fb54-45d5-9687-1bb0b11663f8"]
}, Open  ]]
}, Open  ]],

