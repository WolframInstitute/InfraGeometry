Cell["\<\
Even equal fiber sizes and lift existence do not guarantee a complete \
connection. The first two source vertices here can only reach the same target \
vertex.\
\>", "ExampleText",ExpressionUUID->"af84998d-1c48-4ba4-a72a-e5696db1b46e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
