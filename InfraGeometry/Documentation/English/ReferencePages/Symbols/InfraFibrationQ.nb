Cell[TextData[{
 "The empty fibered graph is a fibration. A list of objects gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f8e38e7-33cf-4e75-93cb-3bf9dafbb286"],
 " when every member is a fibration; the empty list gives ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35325b56-c628-4f5f-9bf6-b6c4b650b303"],
 "."
}], "Notes",ExpressionUUID->"908c476e-f70d-43ea-9ed8-f0d54f099598"]
