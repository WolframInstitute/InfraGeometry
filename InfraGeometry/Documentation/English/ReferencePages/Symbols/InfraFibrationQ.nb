Cell["\<\
A branched fibration has fibers of different sizes and is still a fibration.\
\>", "ExampleText",ExpressionUUID->"d095e1d2-f73a-4b9b-902c-78fdc0f4ae62"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<BranchedCycleFibration\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraTotalSpace", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraFiberBundleQ", "[", "fib", "]"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7fdfd3e4-29dc-4946-baa6-91a052ac7f06"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   GraphicsBox[
    NamespaceBox["NetworkGraphics",
     DynamicModuleBox[{Typeset`graph = HoldComplete[
       Graph[{{2, 1}, {2, 2}, {4, 1}, {4, 2}, {6, 1}, {6, 2}, {8, 1}, {8, 
