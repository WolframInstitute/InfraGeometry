Cell[CellGroupData[{
Cell["InfraFibrationQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cb6a6c0c-d585-4907-86ee-bc345b3f124b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFibrationQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d555bd01-0560-4017-93ef-2b928deadcd4"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "979b5764-49b0-4984-9a14-c4323772e8ed"],
 " if ",
 StyleBox["fib", "TI"],
 " has the edge lifting property: every total vertex over ",
 StyleBox["p", "TI"],
 " has a neighbour over every base neighbour of ",
 StyleBox["p", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"2495c624-0370-4b06-8e82-6d396e6a0ad0"],

Cell[TextData[{
 "The condition is ",
 StyleBox["m(x, q) \[GreaterEqual] 1", "TI"],
 " for every total vertex ",
 StyleBox["x", "TI"],
 " and every base neighbour ",
 StyleBox["q", "TI"],
 " of ",
 StyleBox["\[Pi](x)", "TI"],
 ", with ",
 StyleBox["m", "TI"],
 " the multiplicity of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEdgeLiftMultiplicity"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEdgeLiftMultiplicity", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aef0b478-ac0f-40ac-bd27-e7c7aeec98f0"],
 "."
}], "Notes",ExpressionUUID->"777668ef-7fef-4d15-9e20-5d7e9d3143e9"],

Cell["\<\
Then every base walk lifts to a walk from any vertex over its start, one step \
at a time. The lift need not be unique.\
\>", "Notes",ExpressionUUID->"f6c88a7b-4d83-4fae-ad16-6c4c23f8f091"],

Cell["\<\
Fibers may have different sizes, and an edge may have several lifts at a \
vertex. Equal sizes and lifting together still need not give a complete \
connection.\
\>", "Notes",ExpressionUUID->"0c263d0e-3943-4e37-8fe9-332871d966ad"],

Cell["Stronger conditions:", "Notes",ExpressionUUID->"77ce3986-bbdf-49b5-b0d9-c5f639139c2e"],

