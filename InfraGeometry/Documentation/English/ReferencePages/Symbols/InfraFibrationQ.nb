Cell[CellGroupData[{
Cell["InfraFibrationQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c307f368-d981-427b-8607-a2bf847b5477"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFibrationQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "467a80c1-ad02-43eb-847b-30796b35e8f9"],
 "\[LineSeparator]",
 "tests the edge lifting property: every total vertex over ",
 StyleBox["p", "TI"],
 " has a neighbour over every base neighbour of ",
 StyleBox["p", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"ee3e353a-8ada-4c7a-aaf5-bb8c736bcf65"],

Cell[TextData[{
 "The base is the reconstructed ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBaseSpace"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBaseSpace", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e019eaee-19c3-48b7-b547-6e60763ee889"],
 "."
}], "Notes",ExpressionUUID->"33ad2e0b-2a4f-4cc2-b30b-ddd0960209c0"],

Cell["\<\
This is the project's lift-existence convention. It does not impose the \
unique incoming-edge lifting used by some standard graph-fibration \
definitions.\
\>", "Notes",ExpressionUUID->"0ef85ac8-eb98-4bd1-af2a-c4227c04a47d"],

Cell[TextData[{
 "Equivalently, every entry of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEdgeLiftMultiplicity"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEdgeLiftMultiplicity", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "81bde20e-6740-4857-ab04-1a5978a4e3ba"],
 " is positive. The projection is locally surjective on transverse \
neighbourhoods."
}], "Notes",ExpressionUUID->"787ffdd3-aaea-4a7d-9350-70efc931d2f9"],

Cell["\<\
The condition allows unequal fibers and multiple lifts. It does not guarantee \
a perfect matching or a complete connection.\
\>", "Notes",ExpressionUUID->"f3a40673-6bb1-4bc0-9ff9-64ac12d5ee84"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUniqueEdgeLiftingQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUniqueEdgeLiftingQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f48e792b-28ba-4621-b88e-18ba1fc69d54"],
 " adds uniqueness. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberBundleQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberBundleQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bd984bfd-dabc-466b-bf08-d0d91f2a7f65"],
 " also requires common fiber graphs and preservation of their adjacency."
}], "Notes",ExpressionUUID->"7d847abd-287e-4a27-9a0e-1b46483a10e2"],

Cell["\<\
The empty fibered graph satisfies the condition vacuously. Unsupported inputs \
remain unevaluated.\
\>", "Notes",ExpressionUUID->"0049616f-062e-4bbc-a7cd-6c2ab23f4e30"],

Cell["\<\
A nonempty list is tested by conjunction. An empty result list is False and \
does not establish existence.\
\>", "Notes",ExpressionUUID->"976053cd-d9ad-49e5-8915-d6db5a9305b1"]
}, Open  ]],

