Cell["\<\
The double cover of a cycle is a fibration. Deleting one total edge breaks \
it: its two endpoints, drawn, lose their lift of a base edge.\
\>", "ExampleText",ExpressionUUID->"2fabfd21-4389-46c2-a89a-66183acb8c73"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<CycleDoubleCover\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalSpace", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cut", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"EdgeList", "[", "total", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"broken", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"EdgeDelete", "[", 
        RowBox[{"total", ",", " ", "cut"}], "]"}], ",", " ", 
       RowBox[{"InfraProjection", "[", "fib", "]"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{
       RowBox[{"InfraTotalSpace", "[", "broken", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"total", ",", " ", 
          RowBox[{"List", " ", "@@", " ", "cut"}], ",", 
          " ", "\"\<VertexDensity\>\""}], " ", "]"}], "}"}]}], "]"}], ",", 
     " ", 
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraFibrationQ", "[", "broken", "]"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"084ae758-d2ce-44dd-b8c1-bb7e8cb46b1c"],

