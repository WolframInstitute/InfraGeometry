Cell["\<\
The double cover of the cycle of length 8 is a fibration. Deleting one edge \
breaks it: its two endpoints, drawn, lose their lift of a base edge:\
\>", "ExampleText",ExpressionUUID->"5d98bce8-61c2-4276-ae46-6ed6397ccf65"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<CycleDoubleCover\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalSpace", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cut", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"EdgeList", "[", "total", "]"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"broken", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"EdgeDelete", "[", 
        RowBox[{"total", ",", " ", "cut"}], "]"}], ",", " ", 
       RowBox[{"InfraProjection", "[", "fib", "]"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", 
    RowBox[{"broken", ",", " ", 
     RowBox[{"List", " ", "@@", " ", "cut"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
        RowBox[{"InfraFibrationQ", "[", "broken", "]"}]}], "}"}]}], ",", "\n",
      "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2e2a81d0-925a-4529-a0ac-f1d257defab5"],

