Cell[TextData[{
 "Equal fiber sizes and lifting do not give a complete connection. The \
vertices 1 and 2 over ",
 Cell[BoxData["\"\<p\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3c95f05-92c2-4dd2-b791-0969b077a6bd"],
 " both lift only to 4, so no perfect matching exists:"
}], "ExampleText",ExpressionUUID->"a32688c2-d559-41c0-93fd-a6c37443206c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"Graph", "[", 
        RowBox[{
         RowBox[{"Range", "[", "6", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", " ", "<->", " ", "4"}], ",", " ", 
           RowBox[{"2", " ", "<->", " ", "4"}], ",", " ", 
           RowBox[{"3", " ", "<->", " ", "5"}], ",", " ", 
           RowBox[{"3", " ", "<->", " ", "6"}]}], "}"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<q\>\""}], ",", " ", 
         RowBox[{"5", " ", "->", " ", "\"\<q\>\""}], ",", " ", 
         RowBox[{"6", " ", "->", " ", "\"\<q\>\""}]}], "|>"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraEqualFiberSizesQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", "All"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6f1b7176-7422-4511-a0b4-4b7935680186"],

