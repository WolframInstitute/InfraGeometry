Cell["\<\
A branched fibration has fibers of sizes 1 and 2. It is a fibration, but not \
a fiber bundle:\
\>", "ExampleText",ExpressionUUID->"df6b2d66-0e63-4692-8fa4-1b829573bcab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<BranchedCycleFibration\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
        RowBox[{"InfraFiberBundleQ", "[", "fib", "]"}]}], "}"}]}], ",", "\n", 
     "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"865c8c1e-e45f-430c-973e-12793dc39a82"],

