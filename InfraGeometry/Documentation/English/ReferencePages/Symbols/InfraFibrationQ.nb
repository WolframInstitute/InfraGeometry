Cell["\<\
The double cover of a cycle is a fibration. Deleting one total edge breaks \
it: its two endpoints, drawn, lose their lift of a base edge.\
\>", "ExampleText",ExpressionUUID->"f1aaaff1-223d-43d7-93c7-4ff0fbf5b893"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<CycleDoubleCover\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cut", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"EdgeList", "[", "total", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"broken", " ", "=", " ", 
     RowBox[{"InfraFibration", "[", 
      RowBox[{
       RowBox[{"EdgeDelete", "[", 
        RowBox[{"total", ",", " ", "cut"}], "]"}], ",", " ", 
       RowBox[{"InfraFibrationAssociation", "[", "fib", "]"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{
       RowBox[{"InfraTotalGraph", "[", "broken", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraDensity", "[", 
         RowBox[{"total", ",", " ", 
          RowBox[{"List", " ", "@@", " ", "cut"}]}], "]"}], "}"}]}], "]"}], ",",
      " ", 
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraFibrationQ", "[", "broken", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4886f7b8-749d-4d45-95ac-04dcdc8e7913"],

