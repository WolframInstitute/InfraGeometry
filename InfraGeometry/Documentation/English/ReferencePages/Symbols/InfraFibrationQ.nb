  FontSize->0.9 Inherited,ExpressionUUID->
  "9b836d7b-9938-4d13-b70f-ccf8baa73639"],
 "\[LineSeparator]",
 "tests the edge lifting property: every total vertex over ",
 StyleBox["p", "TI"],
 " has a neighbour over every base neighbour of ",
 StyleBox["p", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"2b68d5ab-ac76-4e7f-ab21-cb49b5dbd909"],

Cell[TextData[{
 "The base is the reconstructed ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBaseSpace"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBaseSpace", 
    "WolframInstitute/InfraGeometry Package Symbol"},
