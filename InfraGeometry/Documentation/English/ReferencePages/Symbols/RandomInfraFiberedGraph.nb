     "79519db7-5a6b-4920-acdc-ca50ea112073"], Cell[
    "1 through Min[n,m]; the edges form a matching", "TableText",
     ExpressionUUID->"f12e7e83-9ef1-479b-93c3-17926ebbd506"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "03406d5b-bb4e-494f-8ac0-aba2e8edb60d"], Cell[TextData[{
     Cell[BoxData["\"\<UniqueEdgeLifting\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4db70edf-00ab-4abb-803f-5b81aa9c07c5"],
     ", or both ",
     Cell[BoxData["\"\<Fibration\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1e4098db-168a-4f86-8d11-9a7aa32d084d"],
     " and ",
     Cell[BoxData["\"\<AtMostOneEdgeLift\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f39480e2-1ed6-40c5-ac01-b7e28c18cc6f"]
    }], "TableText",ExpressionUUID->"51c386a1-3526-495c-9061-0d25e4c24c09"], 
    Cell["n, with n = m; a perfect matching", "TableText",ExpressionUUID->
     "4840404e-b024-416f-b803-aca438256f3c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f0b336d2-d6ee-4f77-8bda-2f141c0af81f"], Cell[TextData[Cell[
