Cell["\<\
An exact vertical edge needs fibers of at least 2 vertices. A bound of 3 \
allows fibers of 1 vertex, so the call stays unevaluated:\
\>", "ExampleText",ExpressionUUID->"39fe3979-9d5b-45e3-bf5e-978ead7fcde8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Head", " ", "@", " ", 
  RowBox[{"RandomInfraFiberedGraph", "[", 
   RowBox[{
    RowBox[{"GridGraph", "[", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
    RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", "3"}], ",", " ", 
    RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", 
     RowBox[{"{", "1", "}"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1856e6d4-38ba-48ba-87fa-d9963ed89248"],

