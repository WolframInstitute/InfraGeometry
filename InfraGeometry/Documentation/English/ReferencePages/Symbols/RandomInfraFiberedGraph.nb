Cell["HorizontalEdgeCount", "ExampleSubsection",ExpressionUUID->"e4970ba8-1208-4dca-a8ba-f7d360fcafeb"],

Cell["\<\
A complete join between equal fibers supports every section choice and every \
fiber matching.\
\>", "ExampleText",ExpressionUUID->"b26df971-f984-4272-afa0-d9dc0aa8b1e2"],

