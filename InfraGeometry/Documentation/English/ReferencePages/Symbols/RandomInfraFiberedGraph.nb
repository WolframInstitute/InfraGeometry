     FontSize->0.9 Inherited,ExpressionUUID->
     "7778693b-7a4b-4448-9821-fb62fcaaacd8"]], "TableText",ExpressionUUID->
     "f1e17819-7196-4c4d-a68f-a83de7bc6f29"], Cell["\<\
Fiber vertex count: upper bound, exact singleton or inclusive range.\
\>", "TableText",ExpressionUUID->"517f2d9e-b98e-4ac2-bf76-4467601b780f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fe85f6a0-82e0-4aec-9ef0-4b9f1961d3b2"], Cell[TextData[Cell[
    BoxData["\"\<VerticalEdgeCount\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c52ed413-7496-443c-883a-7911a73b4849"]], "TableText",ExpressionUUID->
     "a11cb92d-29ae-4cbb-a658-e75ed6edbf1b"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "0", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1751b968-e481-4b05-8f96-7e7669f88e02"]], "TableText",ExpressionUUID->
     "6448de25-3f22-490b-9b1c-dcea935c1d0e"], Cell["\<\
Vertical edge count: upper bound, exact singleton or inclusive range.\
\>", "TableText",ExpressionUUID->"3b52f4b5-07e1-440b-9e7e-9f847fe79479"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "89e156c0-ab47-4029-afc9-2ca4de4907ba"], Cell[TextData[Cell[
    BoxData["\"\<HorizontalEdgeCount\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "fab211c1-bf4f-49ad-affe-b496e1c3ad9f"]], "TableText",ExpressionUUID->
     "e6bd568e-de25-4f73-8101-1c33d89eae9a"], Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["Automatic"]], "paclet:ref/Automatic"},
      "RefLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "da8d1a50-bc95-409c-8c74-075da0c0b462"]], "TableText",ExpressionUUID->
     "f2d8776e-a473-4efb-a0a7-13e94737c0b6"], Cell[TextData[{
     "Count over each base edge: upper bound, exact singleton, inclusive \
range, ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ef33af98-6779-4124-999e-3e63b55455a6"],
     " or ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e653d620-3293-454f-9d52-1c5274426c04"],
     "."
    }], "TableText",ExpressionUUID->"15850aff-bbec-4978-b948-ba3b02ee56f6"]}
  }]], "3ColumnTableMod",ExpressionUUID->"f0519713-e305-4eb5-92a3-\
a313e7990891"],

Cell[TextData[{
 "Ordinarily each fiber size is drawn independently. ",
 Cell[BoxData["\"\<EqualFiberSizes\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c460dd1a-40b6-472b-9ef0-468597f1b4f5"],
 ", ",
 Cell[BoxData["\"\<IsomorphicFibers\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea7bf0e9-1f8f-4bc6-8df1-52c5b0e99edf"],
 " and ",
 Cell[BoxData["\"\<FiberBundle\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88b451bd-314a-40ff-985a-49051858fb40"],
 " use one size draw over the whole base. ",
 Cell[BoxData["\"\<UniqueEdgeLifting\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4288d95f-26e7-4fb5-b786-b1c1ee6c407a"],
 " and ",
 Cell[BoxData["\"\<Covering\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd279e48-b2cf-4f18-8a17-fe3e70b9814d"],
 " use one size draw per connected base component, unless a global equal-size \
property is also requested. ",
 Cell[BoxData["\"\<IsomorphicFibers\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "496778ba-67bb-481f-b7e2-598646c4cffb"],
 " and ",
 Cell[BoxData["\"\<FiberBundle\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b896f236-a051-4aca-a716-9b4291ce5852"],
 " share one vertical graph template across all fibers. A graph bundle uses \
fiber isomorphisms for its transverse matchings; it can have nontrivial \
monodromy."
}], "Notes",ExpressionUUID->"c812a662-3cb7-4c0d-8753-7b1dd92de74e"],

Cell[TextData[{
 "For a fiber of size ",
 StyleBox["n", "TI"],
 ", the vertical count ranges from zero to ",
 StyleBox["n", "TI"],
 " (",
 StyleBox["n", "TI"],
 " - 1) / 2. ",
 Cell[BoxData["\"\<Covering\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "853a7ad3-c26d-45df-bbd8-4b07168b6903"],
 " forces the count to zero. A scalar vertical cap permits this restriction; \
an exact positive count or a range containing positive counts is incompatible \
with ",
 Cell[BoxData["\"\<Covering\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d6d2f98-c7a4-4671-8cb9-8493617796ca"],
 "."
}], "Notes",ExpressionUUID->"4c1c6743-fc8f-4c98-8abf-2b927df7c511"],

Cell[TextData[{
 "For adjacent fiber sizes ",
 StyleBox["n", "TI"],
 " and ",
 StyleBox["m", "TI"],
 ", the requested properties give these feasible counts. Combined properties \
impose all their constraints."
}], "Notes",ExpressionUUID->"11051943-2793-4463-b5b3-71dd60a32121"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "727c1e6e-0686-4f91-bf30-f91706b39063"], Cell["Property", "TableText",
