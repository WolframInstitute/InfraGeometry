     FontSize->0.9 Inherited,ExpressionUUID->
     "c74d9612-fa1d-42b3-b652-586d2697c498"]], "TableText",ExpressionUUID->
     "9b5381db-2528-4a62-8ebb-8232cfbbf39f"], Cell[
    "n, with n = m; the matching preserves fiber adjacency", "TableText",
     ExpressionUUID->"c483fa02-3793-4d07-b2ea-80a9566197d8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3fa45533-fe5d-4da8-bba8-8efbd0322de7"], Cell[TextData[Cell[
    BoxData["\"\<Covering\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "400bf8a4-fd13-4787-bc47-60ec2ef19c56"]], "TableText",ExpressionUUID->
     "dcbd7ae4-9f6b-42d2-bf2f-fb7844b9dfbb"], Cell[
    "n, with n = m and no vertical edges", "TableText",ExpressionUUID->
     "95ae6847-5c41-4bd3-8e31-a258650d64ac"]}
  }]], "2ColumnTableMod",ExpressionUUID->"0d837bfe-4365-4374-bc14-\
3a154f4b69aa"],

Cell[TextData[{
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "157ac9c4-a404-4dc8-8765-509825426f6d"],
 " draws a feasible count and constructs edges satisfying the properties. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ecc6dc0-414e-4eb7-afc6-fd924a78d02f"],
 " uses the complete join of adjacent fibers; it is accepted only when this \
satisfies every requested property. In particular, a complete join with \
unique lifting requires both adjacent fibers to be singletons."
}], "Notes",ExpressionUUID->"77fa0480-e242-4408-8aee-48137dbc94a8"]
}, Open  ]],

