Cell[TextData[{
 "Ordinarily each fiber size is drawn independently. ",
 Cell[BoxData["\"\<EqualFiberSizes\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0951e424-f0fb-432d-8d9b-0dbb7ce8a54f"],
 ", ",
 Cell[BoxData["\"\<IsomorphicFibers\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0b40cfb-54d6-47dd-b40c-a75b63e96db0"],
 " and ",
 Cell[BoxData["\"\<FiberBundle\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4859c63-d0d6-41ba-ade0-ca7430ceffca"],
 " use one size draw over the whole base. ",
 Cell[BoxData["\"\<UniqueEdgeLifting\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20eaf556-d61f-40eb-bf16-84c084c85d85"],
 " and ",
 Cell[BoxData["\"\<Covering\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61e0a477-c55f-47c7-93be-f8a5b6654700"],
 " use one size draw per connected base component, unless a global equal-size \
property is also requested. ",
 Cell[BoxData["\"\<IsomorphicFibers\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7da498b5-46c7-4572-aa0a-8515417fcccd"],
 " and ",
 Cell[BoxData["\"\<FiberBundle\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "384bd118-bf93-4a43-a8ac-92283edc821d"],
 " share one vertical graph template across all fibers. A graph bundle uses \
fiber isomorphisms for its transverse matchings; it can have nontrivial \
monodromy."
}], "Notes",ExpressionUUID->"d554482b-08b4-49ad-a60d-cccc39dabc65"],

Cell[TextData[{
 "For a fiber of size ",
 StyleBox["n", "TI"],
 ", the vertical count ranges from zero to ",
 StyleBox["n", "TI"],
 " (",
 StyleBox["n", "TI"],
 " - 1) / 2. ",
 Cell[BoxData["\"\<Covering\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc1ddc10-2758-4063-8b01-194c370dc7ee"],
 " forces the count to zero. A scalar vertical cap permits this restriction; \
an exact positive count or a range containing positive counts is incompatible \
with ",
 Cell[BoxData["\"\<Covering\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49d4a6a6-c932-47df-8064-f14373294df1"],
 "."
}], "Notes",ExpressionUUID->"f2cd52c8-e17f-4416-9463-bf8e28268d83"],

Cell[TextData[{
 "For adjacent fiber sizes ",
 StyleBox["n", "TI"],
 " and ",
 StyleBox["m", "TI"],
 ", the requested properties give these feasible counts. Combined properties \
impose all their constraints."
}], "Notes",ExpressionUUID->"0a2b4610-9b49-43a9-b13e-c62c6506df20"],

