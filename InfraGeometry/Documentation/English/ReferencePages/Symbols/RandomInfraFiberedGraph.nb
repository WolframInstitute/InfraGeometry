     FontSize->0.9 Inherited,ExpressionUUID->
     "ab4cb8b8-e212-4cf7-8ffa-c32bf5f6c5f5"]], "TableText",ExpressionUUID->
     "e6bf91e5-13f3-4f3f-8895-45ed7a1edcd4"], Cell["\<\
Fiber vertex count: upper bound, exact singleton or inclusive range.\
\>", "TableText",ExpressionUUID->"046e9c4e-72ff-4224-a410-541dfa173d84"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9d68cc54-51dc-4f9c-9726-94444b658426"], Cell[TextData[Cell[
    BoxData["\"\<VerticalEdgeCount\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9c347c49-c6d1-4425-8c85-2fd61b48473d"]], "TableText",ExpressionUUID->
     "e0d54f36-cecb-4aa5-b000-783897afdc16"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "0", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b9e97e6d-3417-4f53-88d7-5bd7751f8303"]], "TableText",ExpressionUUID->
     "2fc2e59e-6606-4c8b-b64d-e87f0ed9f020"], Cell["\<\
Vertical edge count: upper bound, exact singleton or inclusive range.\
\>", "TableText",ExpressionUUID->"404167c4-1187-43af-87a2-e4e4e823f9ec"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "df3d211f-37b4-4e2b-895c-4d567351d4cb"], Cell[TextData[Cell[
    BoxData["\"\<HorizontalEdgeCount\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b642f846-a436-4f44-84d2-dac02aa94260"]], "TableText",ExpressionUUID->
     "2c016fa3-46db-449c-9ab9-b76927eafa57"], Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["Automatic"]], "paclet:ref/Automatic"},
      "RefLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "734f134f-061d-4bd0-93b9-b5de76c42e28"]], "TableText",ExpressionUUID->
     "d8a31d8b-0eb0-488c-b51b-8677ca6490d5"], Cell[TextData[{
     "Count over each base edge: upper bound, exact singleton, inclusive \
range, ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e5a6d99d-ecf2-430b-a9e4-2c0f7f17ca08"],
     " or ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e1b88695-a53d-4ba1-aeed-9835198c4570"],
     "."
    }], "TableText",ExpressionUUID->"b835a19b-2f8a-4c14-a1e0-90e009ca3f18"]}
  }]], "3ColumnTableMod",ExpressionUUID->"5becbe1d-bcb0-4e81-a4a0-\
0fbe570a5d8e"],

Cell[TextData[{
 "Ordinarily each fiber size is drawn independently. ",
 Cell[BoxData["\"\<EqualFiberSizes\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9896321-c9a5-4d4c-9a5c-aafd6c896d2e"],
 ", ",
 Cell[BoxData["\"\<IsomorphicFibers\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f85fb21-7a63-4539-b0cb-3980bf9d4bcf"],
 " and ",
 Cell[BoxData["\"\<FiberBundle\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81fa074a-e2de-4c42-9c0d-093879666c87"],
 " use one size draw over the whole base. ",
 Cell[BoxData["\"\<UniqueEdgeLifting\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01a63f69-bfa1-4552-820a-886964ab91b0"],
 " and ",
 Cell[BoxData["\"\<Covering\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "548c200c-6781-4ff7-989f-eb5b486647ae"],
 " use one size draw per connected base component, unless a global equal-size \
property is also requested. ",
 Cell[BoxData["\"\<IsomorphicFibers\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2329d9b-6df3-452d-88c6-ef011d464e2c"],
 " and ",
 Cell[BoxData["\"\<FiberBundle\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a523556-74d8-40c5-9044-c2f0ead83f8f"],
 " share one vertical graph template across all fibers. A graph bundle uses \
fiber isomorphisms for its transverse matchings; it can have nontrivial \
monodromy."
}], "Notes",ExpressionUUID->"15331224-2629-4935-973c-e1f99ca9ba30"],

Cell[TextData[{
 "For a fiber of size ",
 StyleBox["n", "TI"],
 ", the vertical count ranges from zero to ",
 StyleBox["n", "TI"],
 " (",
 StyleBox["n", "TI"],
 " - 1) / 2. ",
 Cell[BoxData["\"\<Covering\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88c897d7-b353-4175-ba5a-c91bd8a61b54"],
 " forces the count to zero. A scalar vertical cap permits this restriction; \
an exact positive count or a range containing positive counts is incompatible \
with ",
 Cell[BoxData["\"\<Covering\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad4072e7-2707-49b6-8432-741a6516b317"],
 "."
}], "Notes",ExpressionUUID->"bb905247-fe68-44a2-a19b-54e21c74efea"],

Cell[TextData[{
 "For adjacent fiber sizes ",
 StyleBox["n", "TI"],
 " and ",
 StyleBox["m", "TI"],
 ", the requested properties give these feasible counts. Combined properties \
impose all their constraints."
}], "Notes",ExpressionUUID->"9a28d147-1b08-4b88-bdf4-00f61c25d990"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "00cf5f0e-b5f1-4830-8a70-b1621254df38"], Cell["Property", "TableText",
