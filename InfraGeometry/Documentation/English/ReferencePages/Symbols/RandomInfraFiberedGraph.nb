     "8d200e3a-948a-4552-ac66-b86935013903"], Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["Properties"]], "paclet:ref/Properties"},
      "RefLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "def88626-55b5-44be-8c2a-8075b73a6d40"]], "TableText",ExpressionUUID->
     "d6cbb38d-c062-418b-896c-1fd83b787bc0"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5cf18ba5-1ac1-4ba7-94e0-4567df71b82c"]], "TableText",ExpressionUUID->
     "61b9fc99-70c5-4ae0-8333-aa6b2afe239e"], Cell[
    "Conjunction of the requested structural properties.", "TableText",
     ExpressionUUID->"fc797623-a252-46e8-a2c6-816ab15c78de"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d948b465-bdcf-4adb-a0b8-050e63d14e57"], Cell[TextData[Cell[
    BoxData["\"\<VerticalVertexCount\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "236e3a7f-3d82-48ee-8aa0-280e6a5d4552"]], "TableText",ExpressionUUID->
     "823f02a3-db25-4d30-a053-c21803fcbe95"], Cell[TextData[Cell[BoxData[
