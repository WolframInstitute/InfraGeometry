   {Cell["      ", "ModInfo",ExpressionUUID->
     "cb87b00c-275b-4e58-ae7a-e8d1439f35ff"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"e1112f93-6980-49c9-aec0-f8494144901a"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"83d5d5a3-d23e-47ac-8af0-c4340d3fc6c0"],
     Cell["Meaning", "TableText",
     FontWeight->Bold,ExpressionUUID->"21257bf4-8c07-4a1e-90c6-275bb42853c8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "66a0e0cf-fde7-4d45-8384-2f6382a919fb"], Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["Properties"]], "paclet:ref/Properties"},
      "RefLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "2efd4d81-3ad9-4315-8412-0e274f71c99e"]], "TableText",ExpressionUUID->
     "1a2e59e5-af1e-447d-8653-4f5ed1252d72"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3582e1f7-7137-4df4-9d6f-aa99223b020f"]], "TableText",ExpressionUUID->
     "570c1fe3-9d0d-470f-a4a0-960ecc27637e"], Cell[
    "Conjunction of the requested structural properties.", "TableText",
     ExpressionUUID->"a34e066b-5fb3-4f40-a307-c59a2e05118e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "05124912-84ac-4551-9446-462bb6b33089"], Cell[TextData[Cell[
    BoxData["\"\<VerticalVertexCount\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "cdbe7b5d-34eb-486f-881b-279b1c021396"]], "TableText",ExpressionUUID->
     "ad620433-2b3d-414c-9aca-948cbe61891a"], Cell[TextData[Cell[BoxData[
