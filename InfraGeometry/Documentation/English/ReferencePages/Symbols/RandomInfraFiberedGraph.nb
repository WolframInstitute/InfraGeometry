     "3f62f8e0-ec0f-44eb-ba93-559f7f5ec69d"], Cell["\<\
Max[n,m] through n m; every vertex has a transverse neighbour\
\>", "TableText",ExpressionUUID->"66eb0977-d4d7-46cb-ba42-8bddd8aa85b4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "16a968fb-783d-4063-b97b-1daef90d9cb9"], Cell[TextData[Cell[
    BoxData["\"\<AtMostOneEdgeLift\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "98fcb2f6-7d42-45c0-a68e-b70452ba372c"]], "TableText",ExpressionUUID->
     "707f664b-3c50-4e96-b0d0-35e13f894b64"], Cell[
    "1 through Min[n,m]; the edges form a matching", "TableText",
     ExpressionUUID->"41efdf1f-38ef-4cdf-9c09-f7f65aab5e16"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d0649274-50b5-4d93-a37e-ee088fbd7864"], Cell[TextData[{
     Cell[BoxData["\"\<UniqueEdgeLifting\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5a9b7a6d-3127-4dd5-b2af-8fdee45b9d9b"],
     ", or both ",
     Cell[BoxData["\"\<Fibration\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9731de93-0b39-4831-b20a-d37c7769170c"],
     " and ",
     Cell[BoxData["\"\<AtMostOneEdgeLift\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6f07e06c-1bad-4c49-890a-c1ac8dec6853"]
    }], "TableText",ExpressionUUID->"ab96e413-17c6-44bf-9a58-4e7f66ec4ba1"], 
    Cell["n, with n = m; a perfect matching", "TableText",ExpressionUUID->
     "a727badd-0181-4ead-b44c-ad1af0b2b464"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "31f64988-2379-46a7-b864-0ae9b6d0e34a"], Cell[TextData[Cell[
    BoxData["\"\<FiberBundle\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "143b266b-8efb-4194-bf13-1d1f7220dd8b"]], "TableText",ExpressionUUID->
     "5462e636-349d-4ae7-b67d-99c37f90c193"], Cell[
    "n, with n = m; the matching preserves fiber adjacency", "TableText",
     ExpressionUUID->"04d3ca15-2c56-4bc2-afb9-0a8e195325a4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f381beb6-b497-42fa-a503-3c04787b74c2"], Cell[TextData[Cell[
    BoxData["\"\<Covering\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9b9ac0b1-dfa3-4733-b228-3a9787e58af6"]], "TableText",ExpressionUUID->
     "cca0709b-5706-4b9c-a569-298a0dbc9268"], Cell[
    "n, with n = m and no vertical edges", "TableText",ExpressionUUID->
     "27c45fb5-420d-4cd5-ad52-d47e9e81a93b"]}
  }]], "2ColumnTableMod",ExpressionUUID->"52750e3a-417a-4e6c-877f-\
6b2e3ee143eb"],

Cell[TextData[{
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44418714-bf45-4f3d-ad23-5ae60907dac5"],
 " draws a feasible count and constructs edges satisfying the properties. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef7fc852-ee41-40df-b17d-01437325d74f"],
 " uses the complete join of adjacent fibers; it is accepted only when this \
satisfies every requested property. In particular, a complete join with \
unique lifting requires both adjacent fibers to be singletons."
}], "Notes",ExpressionUUID->"b90c198a-5744-499d-87f1-1057604c332b"]
}, Open  ]],

