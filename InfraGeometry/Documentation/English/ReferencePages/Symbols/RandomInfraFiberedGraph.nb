   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "21f33e4e-fba4-48bf-82be-78b88c2c5f72"],
 " whose base is the graph ",
 StyleBox["base", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"34e666b5-226f-4cf7-8ffd-308a7e77eb98"],

Cell[TextData[{
 "The fiber over a base vertex ",
 StyleBox["p", "TI"],
 " has the vertices {",
 StyleBox["p", "TI"],
 ", 1}, \[Ellipsis], {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["n", "TI"],
 "}, ",
 StyleBox["n \[GreaterEqual] 1", "TI"],
 ", and random vertical edges. Transverse edges lie only over base edges, at \
least one over each, so the base of the result is exactly ",
 StyleBox["base", "TI"],
 "."
}], "Notes",ExpressionUUID->"896c7b05-ae81-40c6-8a85-01f5d4493e76"],

Cell[TextData[{
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "183a6bdb-88c7-40f9-8b3b-5d0435a32411"],
 " is a list of conditions, all imposed:"
}], "Notes",ExpressionUUID->"533b83af-7d1f-4810-8d83-935d374ed0bf"],

