Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fib", " ", "=", " ", 
        RowBox[{"RandomInfraFiberedGraph", "[", 
         RowBox[{
          RowBox[{"GridGraph", "[", 
           RowBox[{"{", 
            RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
          RowBox[{"Properties", " ", "->", " ", 
           RowBox[{"{", "prop", "}"}]}], ",", " ", 
          RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
           RowBox[{"{", "3", "}"}]}], ",", "\n", "      ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"counts", " ", "=", " ", 
        RowBox[{"Catenate", "[", 
         RowBox[{"Values", " ", "/@", " ", 
          RowBox[{"Values", " ", "@", " ", 
           RowBox[{"InfraEdgeLiftMultiplicity", "[", "fib", "]"}]}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraFiberedGraphHighlight", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"Union", "[", "counts", "]"}]}]}], "]"}]}], "]"}], ",", "\n",
     "  ", 
    RowBox[{"{", 
     RowBox[{"prop", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Fibration\>\"", ",", " ", "\"\<AtMostOneEdgeLift\>\"", ",",
         " ", "\"\<UniqueEdgeLifting\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
