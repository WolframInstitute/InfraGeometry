fc357e40ae26"],

Cell[TextData[{
 "A count is ",
 StyleBox["n", "TI"],
 " (at most ",
 StyleBox["n", "TI"],
 "), {",
 StyleBox["n", "TI"],
 "} (exactly ",
 StyleBox["n", "TI"],
 ") or {",
 StyleBox["lo", "TI"],
 ", ",
 StyleBox["hi", "TI"],
 "} (uniform between ",
 StyleBox["lo", "TI"],
 " and ",
 StyleBox["hi", "TI"],
 "). Over an edge with fibers of sizes ",
 StyleBox["n", "TI"],
 ", ",
 StyleBox["m", "TI"],
 " there are 1 to ",
 StyleBox["nm", "TI"],
 " transverse edges, at least max(",
 StyleBox["n", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ") with ",
 Cell[BoxData["\"\<Fibration\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8c27a5b-a929-4247-9472-71de93db293e"],
 ", at most min(",
 StyleBox["n", "TI"],
 ", ",
 StyleBox["m", "TI"],
 ") with ",
 Cell[BoxData["\"\<AtMostOneEdgeLift\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "218fc68e-9d2e-4c58-b717-4229820b9fd5"],
 ", and ",
 StyleBox["n = m", "TI"],
 " with unique edge lifting. An infeasible request stays unevaluated."
}], "Notes",ExpressionUUID->"c2ea7278-2f7c-4dea-b089-ea662c55e4d1"],

Cell["\<\
The graph is not uniform among the graphs with the drawn counts.\
\>", "Notes",ExpressionUUID->"1013ed9c-21b5-441d-a6fc-cbda5d83a551"],

