Cell["\<\
An exact vertical edge is incompatible with a vertex-count cap that permits \
singleton fibers. The call remains unevaluated even if some size draws could \
support that edge.\
\>", "ExampleText",ExpressionUUID->"7919ff97-adba-4713-9f24-c8a685a7d117"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RandomInfraFiberedGraph", "[", " ", 
  RowBox[{
   RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}], ",", " ", 
   RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", "3"}], ",", " ", 
   RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", 
    RowBox[{"{", " ", "1", " ", "}"}]}]}], " ", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b0a3e02b-c098-47b5-adb9-ef5c7517e363"],

Cell[BoxData[
 RowBox[{"RandomInfraFiberedGraph", "[", 
  RowBox[{
   GraphicsBox[
    NamespaceBox["NetworkGraphics",
     DynamicModuleBox[{Typeset`graph = HoldComplete[
       Graph[{1, 2, 3, 4}, {Null, 
         SparseArray[
         Automatic, {4, 4}, 0, {
          1, {{0, 2, 4, 6, 8}, {{2}, {4}, {1}, {3}, {2}, {4}, {1}, {3}}}, 
           Pattern}]}, {GraphLayout -> "CircularEmbedding"}]]}, 
      TagBox[
       GraphicsGroupBox[
        GraphicsComplexBox[{{-1., 
         1.0106430996148606`*^-15}, {-7.044813998280222*^-16, 1.}, {
         1., -1.133107779529596*^-15}, {6.049014748177263*^-16, -1.}}, {
          {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], Arrowheads[0.],
            ArrowBox[{{1, 2}, {1, 4}, {2, 3}, {3, 4}}, 
            0.02261146496815286]}, 
          {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
           DiskBox[1, 0.02261146496815286], DiskBox[2, 0.02261146496815286], 
           DiskBox[3, 0.02261146496815286], 
           DiskBox[4, 0.02261146496815286]}}]],
       MouseAppearanceTag["NetworkGraphics"]],
      AllowKernelInitialization->False]],
    DefaultBaseStyle->"NetworkGraphics",
    FormatType->TraditionalForm,
    FrameTicks->None], ",", 
   RowBox[{"\<\"VerticalVertexCount\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"VerticalEdgeCount\"\>", "\[Rule]", 
    RowBox[{"{", "1", "}"}]}]}], "]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e9a5b81e-0947-41be-bfff-13a7d564aa60"]
}, Open  ]],

Cell["\<\
Complete joins of two-point fibers do not have unique edge lifting.\
\>", "ExampleText",ExpressionUUID->"5ea849ea-dc5a-4a23-a8e4-b4966ecb413b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RandomInfraFiberedGraph", "[", " ", 
