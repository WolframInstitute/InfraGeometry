Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraFiberedGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a0eee881-f600-4de3-925c-0a470df77151"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraFiberedGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFiberedGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["base", "TI"], ",", " ", 
    StyleBox["options", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd3d60f9-373e-48d8-b461-f00f32cbbdac"],
 "\[LineSeparator]",
 "gives a random ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f2de450e-caac-4793-834a-d942caaa4046"],
 " with the prescribed reconstructed base and selected properties.",
 "\n"
}], "Usage",ExpressionUUID->"5a6bea5b-b5f0-4d32-98f2-783dc1706398"],

Cell["\<\
The base is a finite simple undirected unweighted untagged graph, including \
isolated vertices and the empty graph.\
\>", "Notes",ExpressionUUID->"7e70592e-a397-4b39-a221-7c46c0eb5f74"],

Cell[TextData[{
 "Every base vertex has a nonempty fiber. Total vertices are pairs {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["k", "TI"],
 "}, with ",
 StyleBox["p", "TI"],
 " a literal base vertex."
}], "Notes",ExpressionUUID->"c97c8f41-1e91-4ca0-85d2-4ffcb0d7db20"],

Cell["\<\
Transverse edges occur only over base edges. At least one transverse edge is \
retained over every base edge, so the reconstructed base has exactly the \
supplied vertices and edges.\
\>", "Notes",ExpressionUUID->"3e97cf54-5237-4b9c-8ff4-3f37ec31db73"],

Cell[TextData[{
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "352d412d-f379-430a-9e37-03b7bc9360f2"],
 " is a flat list interpreted by conjunction. The allowed strings are ",
 Cell[BoxData["\"\<EqualFiberSizes\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93dc5fea-8de2-45a8-bfc9-60dbe2c42982"],
 ", ",
 Cell[BoxData["\"\<IsomorphicFibers\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20e9a33b-8bb9-4dec-b679-a56c2f58943c"],
 ", ",
 Cell[BoxData["\"\<Fibration\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ae63235-b144-4af8-a90b-ba29e194d748"],
 ", ",
 Cell[BoxData["\"\<AtMostOneEdgeLift\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19dd728d-4fae-4f46-ad13-83604dee5a90"],
 ", ",
 Cell[BoxData["\"\<UniqueEdgeLifting\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "599cf68a-824f-4c36-87dd-9d884e2e01eb"],
 ", ",
 Cell[BoxData["\"\<FiberBundle\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "489cbb92-16d7-45d7-87a4-bf394de147bc"],
 " and ",
 Cell[BoxData["\"\<Covering\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4095b2b7-d26e-4b1d-b34a-f1554f2e4391"],
 ". Order and repetition do not change the constraints."
}], "Notes",ExpressionUUID->"576e6f00-c694-483a-bfbe-1ff84af89865"],

Cell["\<\
The empty property list requests a general fibered graph. It does not require \
lift existence or equal fiber sizes.\
\>", "Notes",ExpressionUUID->"12825d27-7d7e-4251-adc1-02e1cdd6d9e5"],

Cell[TextData[{
 "A scalar count ",
 StyleBox["n", "TI"],
 " is an upper bound. A singleton {",
 StyleBox["n", "TI"],
 "} requests exactly ",
 StyleBox["n", "TI"],
 ". A pair {",
 StyleBox["lo", "TI"],
 ", ",
 StyleBox["hi", "TI"],
 "} requests a discrete uniform integer in the inclusive range."
}], "Notes",ExpressionUUID->"c01e17da-c395-47ca-960c-9f40aedd9b24"],

Cell["\<\
Fiber vertex counts have minimum one. Vertical edge counts have minimum zero.\
\
\>", "Notes",ExpressionUUID->"6255dbeb-79f5-494b-a252-064e163d697f"],

Cell["\<\
Scalar edge caps are intersected with the property-feasible count interval. \
Exact and range edge specifications must be feasible for every permitted \
fiber size; they are never clipped or silently conditioned on the draw.\
\>", "Notes",ExpressionUUID->"1eb5b127-8834-4cff-b04d-e9748776030f"],

Cell["\<\
Counts are discrete uniform on their admissible interval. The constructive \
graph distribution is not asserted to be uniform over all graphs with those \
counts.\
\>", "Notes",ExpressionUUID->"45818cda-a77b-492a-be8a-89196eedc10b"],

Cell[TextData[{
 "The ambient random stream is controlled by external ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bb1f180a-f63b-42c8-9f20-7c64ad4960a7"],
 ". There is no per-call seed option."
}], "Notes",ExpressionUUID->"8c90389b-382a-4a76-bcc4-1ba964cb14ff"],

Cell["\<\
Unsupported options, property names, graph domains and jointly infeasible \
specifications leave the call unevaluated.\
\>", "Notes",ExpressionUUID->"fa49dd73-0461-4115-a297-ba468ca5f980"],

Cell[TextData[{
 "Drawing coordinates are computed separately by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraphHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraphHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8312c6f8-8a94-4f3d-ad64-0f4e4d54ca62"],
 "."
}], "Notes",ExpressionUUID->"e182aa85-13b9-4e07-94f3-d3463c169e9d"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "eae1b4ca-8764-4c1b-8477-2d990f0a361e"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"2740916c-da19-4781-93ad-388b3866945b"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"a015d011-bebb-41dd-b3a9-a3c3389a1c75"],
