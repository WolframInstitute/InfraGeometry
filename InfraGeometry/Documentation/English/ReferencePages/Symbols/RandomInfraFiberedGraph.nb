A complete join between equal fibers supports every section choice and every \
fiber matching.\
\>", "ExampleText",ExpressionUUID->"8453d33d-e5a4-438d-b84b-ded300cda8bd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "6", " ", "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "3", " ", "}"}]}], ",", " ", 
