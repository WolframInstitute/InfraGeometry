Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraFiberedGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ee59b86d-37b3-407a-8f65-e025b099940f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraFiberedGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFiberedGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["base", "TI"], ",", " ", 
    StyleBox["options", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3e370c6-3c77-4499-b81f-528401e4137c"],
 "\[LineSeparator]",
 "gives a random ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dd71a1c1-536d-4d6b-b334-dcd6aa2ed6aa"],
 " with the prescribed reconstructed base and selected properties.",
 "\n"
}], "Usage",ExpressionUUID->"b11249d5-a9e7-419e-90c9-099c8bbf5072"],

Cell["\<\
The base is a finite simple undirected unweighted untagged graph, including \
isolated vertices and the empty graph.\
\>", "Notes",ExpressionUUID->"db4e6930-42aa-4b70-a86b-a24ca4754ce2"],

Cell[TextData[{
 "Every base vertex has a nonempty fiber. Total vertices are pairs {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["k", "TI"],
 "}, with ",
 StyleBox["p", "TI"],
 " a literal base vertex."
}], "Notes",ExpressionUUID->"07bcc739-7583-4436-be38-207e87cd4f81"],

Cell["\<\
Transverse edges occur only over base edges. At least one transverse edge is \
retained over every base edge, so the reconstructed base has exactly the \
supplied vertices and edges.\
\>", "Notes",ExpressionUUID->"1cbdb91e-be46-4abd-b9a8-59d3eb614849"],

Cell[TextData[{
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61609713-1b49-477f-b064-e25e2568bb53"],
 " is a flat list interpreted by conjunction. The allowed strings are ",
 Cell[BoxData["\"\<EqualFiberSizes\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e4fd3c1-91dc-49c4-9e4a-9d684e54d6ec"],
 ", ",
 Cell[BoxData["\"\<IsomorphicFibers\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3c8c7eb-ad3e-44eb-b5ca-d4c03d57d305"],
 ", ",
 Cell[BoxData["\"\<Fibration\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9ef8505-b8da-4db6-abf6-6429dcdc2368"],
 ", ",
 Cell[BoxData["\"\<AtMostOneEdgeLift\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51af4fcd-94f9-46a6-b708-dae5a5466923"],
 ", ",
 Cell[BoxData["\"\<UniqueEdgeLifting\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec6deba0-3ed1-4a9b-a151-d4da3e751f00"],
 ", ",
 Cell[BoxData["\"\<FiberBundle\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2924bef-078e-4fba-97cc-136c0868fb3a"],
 " and ",
 Cell[BoxData["\"\<Covering\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8729b693-1de2-4900-ba0d-a9645604463e"],
 ". Order and repetition do not change the constraints."
}], "Notes",ExpressionUUID->"22a2b361-d010-48f3-8015-b07249edbdb9"],

Cell["\<\
The empty property list requests a general fibered graph. It does not require \
lift existence or equal fiber sizes.\
\>", "Notes",ExpressionUUID->"5eb147ef-c8e1-45a9-b949-b84ae263c965"],

Cell[TextData[{
 "A scalar count ",
 StyleBox["n", "TI"],
 " is an upper bound. A singleton {",
 StyleBox["n", "TI"],
 "} requests exactly ",
 StyleBox["n", "TI"],
 ". A pair {",
 StyleBox["lo", "TI"],
 ", ",
 StyleBox["hi", "TI"],
 "} requests a discrete uniform integer in the inclusive range."
}], "Notes",ExpressionUUID->"0053aee8-045e-4086-a18b-863428a27f35"],

Cell["\<\
Fiber vertex counts have minimum one. Vertical edge counts have minimum zero.\
\
\>", "Notes",ExpressionUUID->"6774c107-44b0-410a-a5ac-b61532064355"],

Cell["\<\
Scalar edge caps are intersected with the property-feasible count interval. \
Exact and range edge specifications must be feasible for every permitted \
fiber size; they are never clipped or silently conditioned on the draw.\
\>", "Notes",ExpressionUUID->"7f183765-7c29-476b-bef5-3414fc8cad32"],

Cell["\<\
Counts are discrete uniform on their admissible interval. The constructive \
graph distribution is not asserted to be uniform over all graphs with those \
counts.\
\>", "Notes",ExpressionUUID->"2dc93e74-2cd3-4f58-a4c8-0dc3303a4804"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomSeeding", " ", "->", " ", "Automatic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "430b3088-e18b-4350-9ef1-6aff22173e16"],
 " (default) seeds each call afresh, independently of ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "abd06cbc-53d5-4362-ae06-5c9888640d2e"],
 "; an integer or string gives a reproducible draw, and ",
 Cell[BoxData["Inherited"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8f091ab-875c-449d-8d4a-72c94e7727dc"],
 " a local snapshot of the current state. The outer random state is restored \
afterward, as with ",
 ButtonBox["RandomInstance",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/RandomInstance.html"], 
    None}],
 "."
}], "Notes",ExpressionUUID->"21d1f51c-fee4-428a-8701-5bf825af7c63"],

Cell["\<\
Unsupported options, property names, graph domains and jointly infeasible \
specifications leave the call unevaluated.\
\>", "Notes",ExpressionUUID->"7bdf22ae-72cd-448c-bed0-cdac7dd5d938"],

Cell[TextData[{
 "Drawing coordinates are computed separately by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraphHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraphHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "48aa0110-dad5-492f-a05f-2bf83587d324"],
 "."
}], "Notes",ExpressionUUID->"f50ccf99-ea1f-4932-b064-400f494ebecb"],

