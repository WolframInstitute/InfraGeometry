Notebook[{

Cell[CellGroupData[{
Cell["BranchingSequenceTree", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6b6a6a46-797d-4ffc-be15-20af333683e2"],
 Cell[BoxData[
  RowBox[{"BranchingSequenceTree", "[", 
   StyleBox["b", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d20c1ec-c7a8-44cc-9d66-b1ea420037ee"],
 "\[LineSeparator]",
 "gives the rooted tree in which every vertex at depth ",
 StyleBox["l", "TI"],
 " has ",
 StyleBox["b", "TI"],
 "\:27e6",
 StyleBox["l", "TI"],
 " + 1\:27e7 children.",
 "\n"
}], "Usage",ExpressionUUID->"76043022-8569-4976-833e-fe34fbd77684"],

Cell[TextData[{
 "The tree is spherically symmetric: all vertices at one depth have the same \
number of children, so the tree looks the same from every vertex of a shell. \
It has ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Length"]], "paclet:ref/Length"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5fa8cfc3-f1f1-4472-ac9f-7597f33dd86b"],
 "[",
 StyleBox["b", "TI"],
 "] + 1 levels, and the shell at depth ",
 StyleBox["k", "TI"],
 " has ",
 StyleBox["b", "TI"],
 "\:2081 ",
 StyleBox["b", "TI"],
 "\:2082 \[CenterEllipsis] ",
 StyleBox["b", "TI"],
 "\:2096 vertices, the list ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FoldList"]], "paclet:ref/FoldList"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7b64ba4e-4eaf-46c4-aea0-c3d82d50b5cb"],
 "[Times",
 ", 1, ",
 StyleBox["b", "TI"],
 "]. The sequence ",
 StyleBox["b", "TI"],
 " is the growth profile of the balls about the root."
}], "Notes",ExpressionUUID->"823a5676-6ff7-4fec-a0c7-e3b164c5ca73"],

Cell[TextData[{
 "A vertex is a pair {",
 StyleBox["l", "TI"],
 ", ",
 StyleBox["p", "TI"],
 "}, its depth and its position in the shell; the root is {0, 1}. The \
children of {",
 StyleBox["l", "TI"],
 ", ",
 StyleBox["p", "TI"],
 "} are {",
 StyleBox["l", "TI"],
 " + 1, (",
 StyleBox["p", "TI"],
 " \[Minus] 1) ",
 StyleBox["c", "TI"],
 " + 1}, \[Ellipsis], {",
 StyleBox["l", "TI"],
 " + 1, ",
 StyleBox["p c", "TI"],
 "}, ",
 StyleBox["c", "TI"],
 " = ",
 StyleBox["b", "TI"],
 "\:27e6",
 StyleBox["l", "TI"],
 " + 1\:27e7."
}], "Notes",ExpressionUUID->"fb7a4b01-7332-44b5-8269-263ba9599f9d"],

Cell[TextData[{
 "A constant sequence gives a complete tree, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CompleteKaryTree"]], "paclet:ref/CompleteKaryTree"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6509e3ea-20d5-48f6-a039-a7b51a79b1ff"],
 ". ",
 Cell[BoxData["BetheGraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5acecbc0-8543-41cc-a2d3-acd88a99e721"],
 " fixes the degree of every vertex instead of the number of children."
}], "Notes",ExpressionUUID->"00f26409-4677-4e11-9bf0-0450033226b7"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "67e246dd-0a87-43a8-ab55-47e823a12696"],
 " options are passed on to the graph."
}], "Notes",ExpressionUUID->"d99e7095-430d-4e29-a103-654ecb4d676d"]
}, Open  ]],

