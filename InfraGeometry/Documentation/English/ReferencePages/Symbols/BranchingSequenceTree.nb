 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "3", ",", " ", "1", ",", " ", "2", ",", " ", "1", ",", " ", "2"}], 
      "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"BranchingSequenceTree", "[", "b", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
