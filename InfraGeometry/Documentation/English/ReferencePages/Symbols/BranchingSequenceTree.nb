Cell["\<\
A constant sequence gives the complete tree, and {3, 2, 2, 2} the Bethe \
lattice with four shells:\
\>", "ExampleText",ExpressionUUID->"594ec04b-1ed3-45cb-a051-f38b8a548f27"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"IsomorphicGraphQ", "[", 
    RowBox[{
     RowBox[{"BranchingSequenceTree", "[", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}], "]"}], ",", " ", 
     RowBox[{"CompleteKaryTree", "[", 
      RowBox[{"4", ",", " ", "2"}], "]"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"IsomorphicGraphQ", "[", 
    RowBox[{
     RowBox[{"BranchingSequenceTree", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2", ",", " ", "2", ",", " ", "2"}], "}"}], 
      "]"}], ",", " ", 
     RowBox[{"BetheGraph", "[", 
      RowBox[{"4", ",", " ", "3"}], "]"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"aa5cfb31-fda9-43b9-add1-e2a7c9a171ab"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"457d05ee-d73d-4fab-b5f4-a254e2e2134a"]
}, Open  ]],

Cell[TextData[{
 "The substrate ",
 Cell[BoxData["\"\<DilutedTreeGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d08f67c0-bbbf-476f-be1f-d5788ad6356c"],
 " branches in two at the depths 0, 3, 8 and 15 and nowhere else. Its shell \
at depth ",
 StyleBox["k", "TI"],
 " has ",
 StyleBox["2\:1d50", "TI"],
 " vertices, ",
 StyleBox["m = \[LeftFloor]\[Sqrt]k\[RightFloor]", "TI"],
 ", so its balls grow faster than any polynomial and slower than any \
exponential:"
}], "ExampleText",ExpressionUUID->"7c8d6f03-4ec6-4c49-bc44-bcbbc0a17ed7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"IntegerQ", " ", "@", " ", 
          RowBox[{"Sqrt", "[", "l", "]"}]}], ",", " ", "2", ",", " ", "1"}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"l", ",", " ", "16"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"IsomorphicGraphQ", "[", 
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"\"\<DilutedTreeGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
         " ", "\"\<Default\>\""}], "]"}], ",", " ", 
       RowBox[{"BranchingSequenceTree", "[", "b", "]"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"Rest", " ", "@", " ", 
       RowBox[{"FoldList", "[", 
        RowBox[{"Times", ",", " ", "1", ",", " ", "b"}], "]"}]}], " ", "==", 
      " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"2", "^", 
         RowBox[{"Floor", "[", 
          RowBox[{"Sqrt", "[", "k", "]"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "16"}], "}"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0cf4d938-6e6a-4dc4-a058-6c454a6f76ca"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"a587b3f9-adfa-4a9a-bb9e-e11cd64132b6"]
}, Open  ]]
