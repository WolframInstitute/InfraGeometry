Cell[CellGroupData[{
Cell["BranchingSequenceTree", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"dc0d44a6-1b93-49d1-94b8-a10e38cdcfb4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BranchingSequenceTree"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BranchingSequenceTree", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["b\:2081", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
     StyleBox["b\:2099", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86178b44-3531-4b7c-83b4-160f508c3d11"],
 "\[LineSeparator]",
 "gives the spherically symmetric rooted tree in which every vertex at depth ",
 StyleBox["l", "TI"],
 " has ",
 StyleBox["b\:2097\:208a\:2081", "TI"],
 " children.",
 "\n"
}], "Usage",ExpressionUUID->"33b3af7f-b2cd-4690-ab73-bcd47795f319"],

Cell[TextData[{
 "The shell at depth ",
 StyleBox["k", "TI"],
 " has ",
 StyleBox["|S\:2096| = b\:2081 b\:2082 \[CenterEllipsis] b\:2096", "TI"],
 " vertices, so the shell sizes are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FoldList"]], "paclet:ref/FoldList"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f2771acb-0532-4953-b751-2411f6b12e78"],
 "[Times",
 ", 1, ",
 StyleBox["b", "TI"],
 "]. The tree has ",
 StyleBox["n", "TI"],
 " + 1 levels."
}], "Notes",ExpressionUUID->"5530f476-183f-416c-86c6-3125622d3908"],

Cell[TextData[{
 "All vertices of a shell look alike: the sequence ",
 StyleBox["b", "TI"],
 " is the growth profile of the balls about the root, and any profile can be \
realized."
}], "Notes",ExpressionUUID->"37b30168-9dc2-4dc2-81f2-1a2ccf9a80e9"],

Cell[TextData[{
 "A vertex is a pair {",
 StyleBox["l", "TI"],
 ", ",
 StyleBox["p", "TI"],
 "}, its depth and its position in the shell; the root is {0, 1}. The \
children of {",
 StyleBox["l", "TI"],
 ", ",
 StyleBox["p", "TI"],
 "} are {",
 StyleBox["l", "TI"],
 " + 1, (",
 StyleBox["p", "TI"],
 " \[Minus] 1)",
 StyleBox["c", "TI"],
 " + 1}, \[Ellipsis], {",
 StyleBox["l", "TI"],
 " + 1, ",
 StyleBox["p c", "TI"],
 "}, with ",
 StyleBox["c", "TI"],
 " = ",
 StyleBox["b\:2097\:208a\:2081", "TI"],
 "."
}], "Notes",ExpressionUUID->"c49a1259-f49a-4bd5-81dc-93b1607b854d"],

Cell[TextData[{
 "A constant sequence {",
 StyleBox["k", "TI"],
 ", \[Ellipsis], ",
 StyleBox["k", "TI"],
 "} gives the complete ",
 StyleBox["k", "TI"],
 "-ary tree, and {",
 StyleBox["z", "TI"],
 ", ",
 StyleBox["z", "TI"],
 " \[Minus] 1, \[Ellipsis], ",
 StyleBox["z", "TI"],
 " \[Minus] 1} the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BetheGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BetheGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6fbf5021-56b5-4c32-9014-8d5de6903e87"],
 " of coordination number ",
 StyleBox["z", "TI"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b9f45afa-16ad-4678-aa5b-59ab2d6b7025"],
 " options are passed on."
}], "Notes",ExpressionUUID->"fc069fcb-d9cc-4d41-8d53-fb5517ddeeec"]
}, Open  ]],

