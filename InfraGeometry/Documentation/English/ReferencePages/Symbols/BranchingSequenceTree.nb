Cell[TextData[{
 "The substrate ",
 Cell[BoxData["\"\<DilutedTreeGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15d38db3-c2c3-46e7-abc5-e786db4a7e7a"],
 " of ",
 Cell[BoxData["InfraSubstrate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1fdb5e5-62c5-4890-a299-a0c90cb1ae73"],
 " is the tree in which a vertex has two children at the depths 0, 3, 8 and \
15, one less than the squares, and one child elsewhere. Its shell at depth ",
 StyleBox["k", "TI"],
 " has 2^\[LeftFloor]\[Sqrt]",
 StyleBox["k", "TI"],
 "\[RightFloor] vertices, so its balls grow more slowly than any \
exponential."
}], "ExampleText",ExpressionUUID->"da49bd02-a0f7-469c-bac5-f2a58ca48181"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<DilutedTreeGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", "\"\<Default\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"g", ",", " ", 
     RowBox[{"IsomorphicGraphQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"BranchingSequenceTree", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "4", ",", " ", "9", ",", " ", "16"}], 
               "}"}], ",", " ", "level"}], "]"}], ",", " ", "2", ",", " ", 
            "1"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"level", ",", " ", "16"}], "}"}]}], "]"}], "]"}]}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"0675671e-89a5-41f5-be33-646b7ba76970"],

