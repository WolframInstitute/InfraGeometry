Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"extDag", " ", "=", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"41", ",", " ", "42"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{
    RowBox[{"Sort", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Rest", "[", 
        RowBox[{"Last", " ", "/@", " ", 
         RowBox[{"VertexList", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
       " ", 
      RowBox[{"ExtendInfraGeodesic", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"41", ",", " ", "42"}], "}"}], ",", " ", "Infinity", ",", 
        " ", 
        RowBox[{"{", "3", "}"}], ",", " ", "All", ",", " ", 
        RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<Forward\>\""}]}], 
       "]"}]}], "]"}], " ", "===", "\n", "    ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Catenate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"FindPath", "[", 
           RowBox[{"extDag", ",", " ", "42", ",", " ", "#", ",", " ", 
            RowBox[{"{", "3", "}"}], ",", " ", "All"}], "]"}], " ", "&"}], 
         " ", "/@", " ", 
         RowBox[{"VertexList", "[", "extDag", "]"}]}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "4"}], " ", 
        "&"}]}], "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d8478a50-1b82-4a86-bf0d-432b01e703c9"],

