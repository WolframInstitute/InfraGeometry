Notebook[{

Cell[CellGroupData[{
Cell["ExtendInfraGeodesic", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1a54d3b5-7591-496b-872c-de99ba96d804"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seed", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba634c10-950a-40b2-a33d-9990f2d04084"],
 "\[LineSeparator]",
 "continues the walk ",
 StyleBox["seed", "TI"],
 " at both ends as a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 ", by a budget of ",
 StyleBox["kspec", "TI"],
 " edges.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6d7c24da-347b-4739-8777-eea6bb802c84"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seed", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dbd5b77-6664-4f35-8e1e-d831b3291322"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da3edd6f-b787-4669-86b1-52d8a814fd29"],
 " of exactly ",
 StyleBox["n", "TI"],
 " extensions or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15567af8-c081-4b56-94d1-f83f31186e9e"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5093b92f-5e1a-4106-8fd5-fcb20e2ae027"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec3521bc-7ac9-425a-9ddd-f3842b1a1969"],
 " gives every one."
}], "Usage",ExpressionUUID->"d98a7f50-355e-4d22-94f9-04823fa35252"],

Cell[TextData[{
 "Definition: an extension of ",
 StyleBox["seed", "TI"],
 " at infra-scale ",
 StyleBox["s", "TI"],
 " is a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " that contains ",
 StyleBox["seed", "TI"],
 " as a consecutive stretch: every window of ",
 StyleBox["s", "TI"],
 " consecutive vertices together with the next one is a shortest path, the \
windows inside the seed included."
}], "Notes",ExpressionUUID->"022c36ec-dc47-4f82-94ac-30d67de8803a"],

Cell[TextData[{
 "This is the continuation of a geodesic as a Riemannian observer sees it. A \
geodesic on a manifold continues uniquely from its velocity; on a graph the \
continuation branches, and the scale says how much of the past the next step \
must respect. At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2510dba3-25ba-47ff-be3f-9e3ee660b2a0"],
 " the whole walk stays a shortest path, which is Euclid's second postulate \
read on a graph."
}], "Notes",ExpressionUUID->"c0cc022c-7110-41a8-89a1-39c8767de972"],

Cell[TextData[{
 "The seed is a vertex list, a walk graph, or a list of either. A seed that \
is not itself a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " has no extension. Grown at both ends, the walk is checked across the seed, \
so the two sides cannot meet in a window that is not a shortest path."
}], "Notes",ExpressionUUID->"312efbff-1e44-4039-b206-98342e6e7400"],

Cell[TextData[{
 StyleBox["kspec", "TI"],
 " is the budget of added edges: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0df9b245-5e2e-48ba-8c54-3de5e13f8218"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46993125-3d45-453f-8cd7-1d8d67732684"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0606b0ef-5304-41ba-8c72-ca3a2bdb78cf"],
 " or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ddb90c82-76d2-41ad-8eb5-e878a5dd8425"],
 ", as for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "69cbf52f-c733-4e8d-8f85-c14f001a4b2c"],
 ". At both ends it counts the edges added on the longer side. At a finite \
scale the class is infinite, so a finite budget is required."
}], "Notes",ExpressionUUID->"50969e6e-222c-4497-a2fe-50f450fc93a8"],

Cell[TextData[{
 "An extension is a walk graph: ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ee882bc-e930-4bcc-8dcc-04967181d3c3"],
 " is its vertex sequence. The count-less call returns one extension, found \
greedily."
}], "Notes",ExpressionUUID->"4944d72f-0c7f-4005-a96c-0ee5032b5b45"],

Cell[TextData[{
 Cell[BoxData["ExtendInfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ef7906e-5ece-458a-9f35-b41845bc9232"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExtendInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d3fa4560-be0d-48ee-a0e1-bb48dd5f8a08"],
 " at ",
 Cell[BoxData[
  RowBox[{"\"\<InfraScale\>\"", " ", "->", " ", "s"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e9807eb-4b87-494d-9548-62504de4da06"],
 " with ",
 Cell[BoxData["\"\<Minimizing\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b81afb8-7467-4846-b864-0d8cb7432085"],
 " added to the rules. The options:"
}], "Notes",ExpressionUUID->"a1cd575b-7de2-4358-909f-2dc8f4aafea9"],

