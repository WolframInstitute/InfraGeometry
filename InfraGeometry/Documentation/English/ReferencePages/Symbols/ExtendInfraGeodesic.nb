   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fcd5d563-24fa-4a9b-8fa7-9c376a8a9efd"],
 " at ",
 Cell[BoxData[
  RowBox[{"\"\<InfraScale\>\"", " ", "->", " ", "s"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47d3e5f3-51c8-4906-ba1a-49d87c9193b9"],
 " with ",
 Cell[BoxData["\"\<Minimizing\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86af763d-4d78-436d-bea3-da1ca088fc3d"],
 " added to the rules. The options:"
}], "Notes",ExpressionUUID->"074a4259-a9d1-44fb-ac76-7b2e924499d2"],

