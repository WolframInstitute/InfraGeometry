Cell[TextData[{
 "Every forward extension of an edge at the centre of the square tiling by \
three edges, at infra-scales 2, 3 and ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59140ca4-5596-41d3-a18c-a613211fe043"],
 ". The fan narrows as the observer sees further back."
}], "ExampleText",ExpressionUUID->"b2309e3e-6cda-45da-8a7e-208a08acbd6b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seed", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Row", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"extList", " ", "=", " ", 
          RowBox[{"ExtendInfraGeodesic", "[", 
           RowBox[{"g", ",", " ", "seed", ",", " ", "sc", ",", " ", 
            RowBox[{"{", "3", "}"}], ",", " ", "All", ",", " ", 
            
            RowBox[{"\"\<Direction\>\"", " ", "->", 
             " ", "\"\<Forward\>\""}]}], "]"}]}], "}"}], ",", "\n", "      ", 
        
        RowBox[{"Labeled", "[", "\n", "        ", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"extList", ",", " ", 
              RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
              RowBox[{"InfraWalk", "[", "seed", "]"}]}], "}"}]}], "]"}], ",", 
          "\n", "        ", 
          RowBox[{"Row", "[", 
