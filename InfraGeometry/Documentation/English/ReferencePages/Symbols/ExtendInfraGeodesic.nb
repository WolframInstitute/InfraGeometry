Cell["\<\
A seed that steps back is a geodesic at scale 1 and not at scale 2, so it has \
extensions at scale 1 and none at scale 2.\
\>", "ExampleText",ExpressionUUID->"a2ffe920-c0bb-4cb5-b572-04d64e11ba02"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"backStep", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "1"}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ExtendInfraGeodesic", "[", 
          RowBox[{"g", ",", " ", "backStep", ",", " ", "1", ",", " ", 
           RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
         RowBox[{"InfraWalk", "[", "backStep", "]"}]}], "}"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"ExtendInfraGeodesic", "[", 
      RowBox[{"g", ",", " ", "backStep", ",", " ", "2", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3054560b-0cb9-49ab-8703-c66443285c0b"],

