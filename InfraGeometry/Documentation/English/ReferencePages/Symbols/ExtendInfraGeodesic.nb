Cell[TextData[{
 "At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "703b1d34-9090-4c75-95ea-ff96e65a4398"],
 " the forward extensions are the paths from the seed's end in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GeodesicExtensionGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8b434176-2e61-409c-ac49-d6dbe3d62074"],
 ", drawn beneath them."
}], "ExampleText",ExpressionUUID->"5e2d48d2-cd73-46d0-930b-f884e558909c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seed", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"extDag", " ", "=", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
