   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "01875ebc-7111-42bd-9373-a8731c04a859"],
 " at ",
 Cell[BoxData[
  RowBox[{"\"\<InfraScale\>\"", " ", "->", " ", "s"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0959f46-241a-4991-9c21-37ac83016bb5"],
 " with ",
 Cell[BoxData["\"\<Minimizing\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48da2e91-d214-4d3a-bf81-ffdef9308f43"],
 " added to the rules. The options:"
}], "Notes",ExpressionUUID->"520b43c6-e8d2-434c-b3f5-170df24558ca"],

