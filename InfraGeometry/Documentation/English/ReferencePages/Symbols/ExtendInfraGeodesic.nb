Cell[CellGroupData[{
Cell["ExtendInfraGeodesic", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"811af3bb-bc5e-4f63-90bb-2fd4abf52e0e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seed", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9b9269b-1d39-4c32-8123-9056a1dab9af"],
 "\[LineSeparator]",
 "continues the walk ",
 StyleBox["seed", "TI"],
 " at both ends as a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 ", by a budget of ",
 StyleBox["kspec", "TI"],
 " edges.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d2ca0162-b7b3-47b1-a1dc-f7efa2b2aa82"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seed", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8fb32344-8624-406a-8d0e-5cfec765b17e"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd9cca69-1b5f-40ed-bf06-78e841bd6917"],
 " of exactly ",
 StyleBox["n", "TI"],
 " extensions or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d47ddbe1-b870-4e6d-8c77-f32ae9542baa"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "534037c1-898a-4eec-b1ca-f5253f202d26"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c0e87e8-c9b5-46ec-82d2-619259af6407"],
 " gives every one."
}], "Usage",ExpressionUUID->"02844f90-84e7-4518-b858-17a089e5b57b"],

Cell[TextData[{
 "Definition: an extension of ",
 StyleBox["seed", "TI"],
 " at infra-scale ",
 StyleBox["s", "TI"],
 " is a walk that contains ",
 StyleBox["seed", "TI"],
 " as a consecutive stretch and whose every added step keeps its window a \
shortest path: the last ",
 StyleBox["s", "TI"],
 " vertices before the new one, together with it, are at distance ",
 StyleBox["s", "TI"],
 " apart."
}], "Notes",ExpressionUUID->"6e33cb0c-642a-471d-88f2-258f8f05d27e"],

Cell[TextData[{
 "This is the continuation of a geodesic as a Riemannian observer sees it. A \
geodesic on a manifold continues uniquely from its velocity; on a graph the \
continuation branches, and the scale says how much of the past the next step \
must respect. At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "518cdb1f-d43c-41fe-b0ad-c5b3a1d61048"],
 " the whole walk stays a shortest path, which is Euclid's second postulate \
read on a graph."
}], "Notes",ExpressionUUID->"d6e2e200-5e50-45bc-b3f7-3168d0cd4f58"],

Cell["\<\
The seed is a vertex list, a walk graph, or a list of either. It is taken as \
given: the rule is checked on the steps added, not on the seed.\
\>", "Notes",ExpressionUUID->"c2ffcdae-8fc3-48eb-b155-5ff69701d1f1"],

Cell[TextData[{
 StyleBox["kspec", "TI"],
 " is the budget of added edges: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fcc9ee4-c622-435f-b789-33c705d336a5"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e793ca9-061c-4e35-8890-ebd3da738d28"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cf45831-4f64-46bc-9beb-4655330f9513"],
 " or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "989e034c-665b-48aa-a62c-f141ad158d66"],
 ", as for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8bb6c7fe-9e3d-4d36-9dc0-a5abddecb355"],
 ". At both ends it counts the edges added on the longer side. At a finite \
scale the class is infinite, so a finite budget is required."
}], "Notes",ExpressionUUID->"82292301-d704-4f90-9817-69e86bc4e0fb"],

Cell[TextData[{
 "An extension is a walk graph: ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fec7f4a-a5a0-4a16-ac89-0acf27d3db63"],
 " is its vertex sequence. The count-less call returns one extension, found \
greedily."
}], "Notes",ExpressionUUID->"27da08eb-9b12-4808-b4e0-07de9e33af12"],

Cell[TextData[{
 Cell[BoxData["ExtendInfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d345805f-d05c-4b27-8135-529d03adb6d8"],
