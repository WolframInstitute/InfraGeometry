Cell["\<\
One extension at both ends, two edges on the longer side, beside its vertex \
sequence.\
\>", "ExampleText",ExpressionUUID->"035507ae-e41e-4ce6-b5fb-523708567877"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seed", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ext", " ", "=", " ", 
     RowBox[{"ExtendInfraGeodesic", "[", 
      RowBox[{"g", ",", " ", "seed", ",", " ", "Infinity", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"ext", ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
         RowBox[{"InfraWalk", "[", "seed", "]"}]}], "}"}]}], "]"}], ",", " ", 
     
     RowBox[{"Last", " ", "/@", " ", 
      RowBox[{"VertexList", "[", "ext", "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e8fe3d0f-e2b1-4523-ac95-4a1531f2b90c"],

