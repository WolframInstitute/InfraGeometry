Cell[CellGroupData[{
Cell["ExtendInfraGeodesic", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"974165eb-e173-4a57-ac4d-8f1cf8cfda27"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seed", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef815bfc-d0fb-4f0c-b23c-de45c9c6077f"],
 "\[LineSeparator]",
 "continues the walk ",
 StyleBox["seed", "TI"],
 " at both ends as a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 ", by a budget of ",
 StyleBox["kspec", "TI"],
 " edges.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5d3dea9b-e7c6-4488-a5ec-b9f0046acf36"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seed", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "113c5ba7-d6e3-4d47-a42e-1726a110eaca"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4215dd67-f9ff-4cbd-afcd-8a89937662d8"],
 " of exactly ",
 StyleBox["n", "TI"],
 " extensions or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7496ae9-8de6-4beb-bdb6-3b199f99763e"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "697aeb10-92f7-4b9c-a26f-472a1c67d5a8"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ddc641c3-1fab-4697-9afb-f5bf8759bd4b"],
 " gives every one."
}], "Usage",ExpressionUUID->"cf79e807-b903-45b4-a317-ef40d5d47718"],

Cell[TextData[{
 "Definition: an extension of ",
 StyleBox["seed", "TI"],
 " at infra-scale ",
 StyleBox["s", "TI"],
 " is a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " that contains ",
 StyleBox["seed", "TI"],
 " as a consecutive stretch: every window of ",
 StyleBox["s", "TI"],
 " consecutive vertices together with the next one is a shortest path, the \
windows inside the seed included."
}], "Notes",ExpressionUUID->"150c5b19-bce2-4f69-8434-6c08bb1cb822"],

Cell[TextData[{
 "This is the continuation of a geodesic as a Riemannian observer sees it. A \
geodesic on a manifold continues uniquely from its velocity; on a graph the \
continuation branches, and the scale says how much of the past the next step \
must respect. At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5ac3b28-de11-4dc9-88be-b7fed1092fd7"],
 " the whole walk stays a shortest path, which is Euclid's second postulate \
read on a graph."
}], "Notes",ExpressionUUID->"48407ac8-9907-48d1-9806-b0a90cb2c88c"],

Cell[TextData[{
 "The seed is a vertex list, a walk graph, or a list of either. A seed that \
is not itself a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " has no extension. Grown at both ends, the walk is checked across the seed, \
so the two sides cannot meet in a window that is not a shortest path."
}], "Notes",ExpressionUUID->"31da5ac2-5af7-4dd3-a286-515bd0cf3e73"],

Cell[TextData[{
 StyleBox["kspec", "TI"],
 " is the budget of added edges: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6288f4f9-9b76-4739-aca5-b343808d2d8d"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cfd60b8-e9be-4915-98a2-54406e835b60"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "efa4f516-f274-425e-975c-9afe7041cbbe"],
 " or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1053534c-a3a7-4fca-8060-5eea63920a15"],
 ", as for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "45e5010c-4d7c-4c55-8685-10ba84fb8901"],
 ". At both ends it counts the edges added on the longer side. At a finite \
scale the class is infinite, so a finite budget is required."
}], "Notes",ExpressionUUID->"ae471d93-b158-406c-8443-3142b6955800"],

Cell[TextData[{
 "An extension is a walk graph: ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81b887a4-8659-4cbe-848b-c602a70253aa"],
 " is its vertex sequence. The count-less call returns one extension, found \
greedily."
}], "Notes",ExpressionUUID->"7ed5bf44-62f4-416b-a114-a2afd3b5c604"],

Cell[TextData[{
 Cell[BoxData["ExtendInfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
