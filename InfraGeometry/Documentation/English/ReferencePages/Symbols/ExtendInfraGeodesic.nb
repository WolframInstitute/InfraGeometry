Cell[TextData[{
 "Every forward extension of the edge from 41 to 42 by three edges, at \
infra-scales 2, 3 and ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de2887ab-c63b-44f5-9f58-295aa8db4973"],
 ". The fan narrows as the observer sees further back."
}], "ExampleText",ExpressionUUID->"a459026b-6486-4b4c-90f8-3fe1b84b1838"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Row", "[", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"extList", " ", "=", " ", 
          RowBox[{"ExtendInfraGeodesic", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"41", ",", " ", "42"}], "}"}], ",", " ", "sc", ",", " ", 
            
            RowBox[{"{", "3", "}"}], ",", " ", "All", ",", " ", 
            
            RowBox[{"\"\<Direction\>\"", " ", "->", 
             " ", "\"\<Forward\>\""}]}], "]"}]}], "}"}], ",", "\n", "      ", 
        
        RowBox[{"Labeled", "[", "\n", "        ", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"extList", ",", " ", 
              RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
              RowBox[{"InfraWalk", "[", 
               RowBox[{"{", 
                RowBox[{"41", ",", " ", "42"}], "}"}], "]"}]}], "}"}], ",", 
            " ", 
            RowBox[{"ImageSize", " ", "->", " ", "180"}]}], "]"}], ",", "\n", 
          "        ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<scale \>\"", ",", " ", "sc", ",", " ", "\"\<: \>\"", 
             ",", " ", 
