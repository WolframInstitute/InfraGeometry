Cell[CellGroupData[{
Cell["ExtendInfraGeodesic", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b6c78980-fca3-417c-b7cb-6c417ab0820a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seed", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0adfc320-fe88-4b25-9e0a-8ab0fa93d10f"],
 "\[LineSeparator]",
 "continues the walk ",
 StyleBox["seed", "TI"],
 " at both ends as a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 ", by a budget of ",
 StyleBox["kspec", "TI"],
 " edges.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"38839a4d-288d-41d5-ba00-9235364d4108"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seed", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5886fea-6c92-4aa9-8f43-8068f17bf809"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf5a2825-e6a1-4681-8a02-4f1937ee02a2"],
 " of exactly ",
 StyleBox["n", "TI"],
 " extensions or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78d41c82-dc55-414a-a0f5-392acb4f0abb"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56bc7418-6d30-4ddb-b6d5-d7f9287891f6"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "810fcca5-a5ec-460d-a685-fd8596915d7e"],
 " gives every one."
}], "Usage",ExpressionUUID->"9ec94341-e68b-40a0-ae02-f44504d9df27"],

Cell[TextData[{
 "Definition: an extension of ",
 StyleBox["seed", "TI"],
 " at infra-scale ",
 StyleBox["s", "TI"],
 " is a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " that contains ",
 StyleBox["seed", "TI"],
 " as a consecutive stretch: every window of ",
 StyleBox["s", "TI"],
 " consecutive vertices together with the next one is a shortest path, the \
windows inside the seed included."
}], "Notes",ExpressionUUID->"8affe99a-f0e0-4b03-bba6-0ec0f70809b4"],

Cell[TextData[{
 "This is the continuation of a geodesic as a Riemannian observer sees it. A \
geodesic on a manifold continues uniquely from its velocity; on a graph the \
continuation branches, and the scale says how much of the past the next step \
must respect. At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b37a0d3d-d37d-4a89-a1ea-123e0e0ab0e3"],
 " the whole walk stays a shortest path, which is Euclid's second postulate \
read on a graph."
}], "Notes",ExpressionUUID->"cc4a8491-2a4c-41ab-8597-a1682fedfd52"],

Cell[TextData[{
 "The seed is a vertex list, a walk graph, or a list of either. A seed that \
is not itself a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " has no extension. Grown at both ends, the walk is checked across the seed, \
so the two sides cannot meet in a window that is not a shortest path."
}], "Notes",ExpressionUUID->"a045b63a-30c9-4872-b4b4-da76384dfb41"],

Cell[TextData[{
 StyleBox["kspec", "TI"],
 " is the budget of added edges: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "752730dc-20ee-4272-bfe4-581a02e130fb"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7799d3f4-35c0-4b9a-837b-97c4e32bda90"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "164bfee2-6527-4671-858e-b685080a4d69"],
 " or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5a82afd-944b-4e2e-b528-f404d5bc1a60"],
 ", as for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f336228e-f628-4ed5-8159-d9c355fe0b7b"],
 ". At both ends it counts the edges added on the longer side. At a finite \
scale the class is infinite, so a finite budget is required."
}], "Notes",ExpressionUUID->"cae123e6-b7e7-40bb-985c-a4a4f1a03e00"],

Cell[TextData[{
 "An extension is a walk graph: ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "060a14a2-196b-4aeb-923c-bd6f6a3c0f05"],
 " is its vertex sequence. The count-less call returns one extension, found \
greedily."
}], "Notes",ExpressionUUID->"784b35aa-849f-44b4-ae5d-60a9d450b528"],

Cell[TextData[{
 Cell[BoxData["ExtendInfraGeodesic"], "InlineFormula",
