  "b68b3977-6c6b-423d-afdb-c4a28da71af8"],
 " at ",
 Cell[BoxData[
  RowBox[{"\"\<InfraScale\>\"", " ", "->", " ", "s"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ecfb3898-5918-41c0-9106-6695478ba0bc"],
 " with ",
 Cell[BoxData["\"\<Minimizing\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a960b37-8788-400e-9ec6-b19e6adb675c"],
 " added to the rules. The options:"
}], "Notes",ExpressionUUID->"9fd365aa-98ad-479a-8b0f-fcb92845a07a"],

