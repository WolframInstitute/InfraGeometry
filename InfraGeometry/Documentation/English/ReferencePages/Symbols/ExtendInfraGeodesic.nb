Cell[TextData[{
 "Every forward extension of the edge from 41 to 42 by three edges, at \
infra-scales 2, 3 and ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0252731c-6383-4e00-aad7-2d28ead59ac3"],
 ". The fan narrows as the observer sees further back."
}], "ExampleText",ExpressionUUID->"dd7df4c2-b5fa-4a08-8893-5dfdfac00c38"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Row", "[", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"extList", " ", "=", " ", 
          RowBox[{"ExtendInfraGeodesic", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"41", ",", " ", "42"}], "}"}], ",", " ", "sc", ",", " ", 
            
            RowBox[{"{", "3", "}"}], ",", " ", "All", ",", " ", 
            
            RowBox[{"\"\<Direction\>\"", " ", "->", 
             " ", "\"\<Forward\>\""}]}], "]"}]}], "}"}], ",", "\n", "      ", 
        
        RowBox[{"Labeled", "[", "\n", "        ", 
         RowBox[{
          RowBox[{"InfraHighlightGraph", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"extList", ",", " ", 
              RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
              RowBox[{"InfraWalk", "[", 
               RowBox[{"{", 
                RowBox[{"41", ",", " ", "42"}], "}"}], "]"}]}], "}"}], ",", 
            " ", 
            RowBox[{"ImageSize", " ", "->", " ", "180"}]}], "]"}], ",", "\n", 
          "        ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<scale \>\"", ",", " ", "sc", ",", " ", "\"\<: \>\"", 
             ",", " ", 
