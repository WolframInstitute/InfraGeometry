Cell[TextData[{
 "At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2868b546-aad1-4fcf-8178-3c0a6d988afd"],
 " the forward extensions are the paths from the seed's end in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GeodesicExtensionGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5ca981e1-306d-4807-b386-24d8bf3a9320"],
 ", drawn beneath them."
}], "ExampleText",ExpressionUUID->"473217a9-32a1-4fc8-8c12-587798d02c39"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seed", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"extDag", " ", "=", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
      RowBox[{"g", ",", " ", "seed"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"extList", " ", "=", " ", 
     RowBox[{"ExtendInfraGeodesic", "[", 
      RowBox[{"g", ",", " ", "seed", ",", " ", "Infinity", ",", " ", 
       RowBox[{"{", "3", "}"}], ",", " ", "All", ",", " ", 
       RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<Forward\>\""}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"extDag", ",", " ", "extList"}], "}"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Rest", "[", 
          RowBox[{"Last", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
         " ", "extList"}], "]"}], " ", "===", "\n", "     ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Catenate", "[", 
          RowBox[{
           RowBox[{
