   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e2efbabb-b992-432d-934e-b4ef76345e46"],
 " at ",
 Cell[BoxData[
  RowBox[{"\"\<InfraScale\>\"", " ", "->", " ", "s"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e94818a9-202c-4089-8818-88a5b0988643"],
 " with ",
 Cell[BoxData["\"\<Minimizing\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9412e26c-9f9d-49d4-949c-f0b79cea1395"],
 " added to the rules. The options:"
}], "Notes",ExpressionUUID->"8bb8fd10-5cbe-4786-82cd-900749f29f07"],

