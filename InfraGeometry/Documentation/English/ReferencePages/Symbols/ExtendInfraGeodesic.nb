 "The extensions of an edge by two edges forward, backward and at both ends, \
at infra-scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e01e33b5-9493-410c-9d8c-5282bcab5ffc"],
 "."
}], "ExampleText",ExpressionUUID->"0e12ded5-b908-4f40-9bb9-7111162ede01"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seed", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Row", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ExtendInfraGeodesic", "[", 
             RowBox[{"g", ",", " ", "seed", ",", " ", "Infinity", ",", " ", 
              RowBox[{"{", "2", "}"}], ",", " ", "All", ",", " ", 
              RowBox[{"\"\<Direction\>\"", " ", "->", " ", "dir"}]}], "]"}], ",",
             " ", 
            RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
            RowBox[{"InfraWalk", "[", "seed", "]"}]}], "}"}]}], "]"}], ",", 
        "\n", "      ", "dir"}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"dir", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Forward\>\"", ",", " ", "\"\<Backward\>\"", ",", 
          " ", "\"\<BothSides\>\""}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f7d93afb-2461-4e82-bd14-0da0d5ce7c07"],

