Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seed", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Row", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ExtendInfraGeodesic", "[", 
             RowBox[{"g", ",", " ", "seed", ",", " ", "Infinity", ",", " ", 
              RowBox[{"{", "2", "}"}], ",", " ", "All", ",", " ", 
              RowBox[{"\"\<Direction\>\"", " ", "->", " ", "dir"}]}], "]"}], ",",
             " ", 
            RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
            RowBox[{"InfraWalk", "[", "seed", "]"}]}], "}"}]}], "]"}], ",", 
        "\n", "      ", "dir"}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"dir", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Forward\>\"", ",", " ", "\"\<Backward\>\"", ",", 
          " ", "\"\<BothSides\>\""}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f58b0684-aea4-4896-ace0-6445e1de3737"],

