   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "664d5442-ae0f-4e41-ba0e-bdbac134709d"],
 " at ",
 Cell[BoxData[
  RowBox[{"\"\<InfraScale\>\"", " ", "->", " ", "s"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da82b522-c71d-4b37-8fe0-dd276cabd9de"],
 " with ",
 Cell[BoxData["\"\<Minimizing\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "983de72e-fac2-40c0-909d-b7fdefafab35"],
 " added to the rules. The options:"
}], "Notes",ExpressionUUID->"1954a15d-7a1a-4226-96b6-e87d80aa84fe"],

