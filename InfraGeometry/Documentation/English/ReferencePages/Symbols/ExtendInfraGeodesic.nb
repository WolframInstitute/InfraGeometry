   "  ", 
   RowBox[{
    RowBox[{"Sort", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Rest", "[", 
        RowBox[{"Last", " ", "/@", " ", 
         RowBox[{"VertexList", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
       " ", 
      RowBox[{"ExtendInfraGeodesic", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"41", ",", " ", "42"}], "}"}], ",", " ", "Infinity", ",", 
        " ", 
        RowBox[{"{", "3", "}"}], ",", " ", "All", ",", " ", 
        RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<Forward\>\""}]}], 
       "]"}]}], "]"}], " ", "===", "\n", "    ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Catenate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"FindPath", "[", 
           RowBox[{"extDag", ",", " ", "42", ",", " ", "#", ",", " ", 
            RowBox[{"{", "3", "}"}], ",", " ", "All"}], "]"}], " ", "&"}], 
         " ", "/@", " ", 
         RowBox[{"VertexList", "[", "extDag", "]"}]}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "4"}], " ", 
        "&"}]}], "]"}]}]}]}], "]"}]], "Input",
