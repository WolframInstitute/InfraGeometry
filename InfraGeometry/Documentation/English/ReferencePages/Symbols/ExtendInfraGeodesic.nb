Cell[TextData[{
 "Every forward extension of the edge from 41 to 42 by three edges, at \
infra-scales 2, 3 and ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90daf0ed-73f1-4fcd-bf7b-be9e55904218"],
 ". The fan narrows as the observer sees further back."
}], "ExampleText",ExpressionUUID->"55078b14-e051-4ad1-94fc-cb4bc34da2f5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Row", "[", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"extList", " ", "=", " ", 
          RowBox[{"ExtendInfraGeodesic", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"41", ",", " ", "42"}], "}"}], ",", " ", "sc", ",", " ", 
            
            RowBox[{"{", "3", "}"}], ",", " ", "All", ",", " ", 
            
            RowBox[{"\"\<Direction\>\"", " ", "->", 
             " ", "\"\<Forward\>\""}]}], "]"}]}], "}"}], ",", "\n", "      ", 
        
        RowBox[{"Labeled", "[", "\n", "        ", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"extList", ",", " ", 
              RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
              RowBox[{"InfraWalk", "[", 
               RowBox[{"{", 
                RowBox[{"41", ",", " ", "42"}], "}"}], "]"}]}], "}"}], ",", 
            " ", 
            RowBox[{"ImageSize", " ", "->", " ", "180"}]}], "]"}], ",", "\n", 
          "        ", 
