Notebook[{

Cell[CellGroupData[{
Cell["ExtendInfraGeodesic", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4e38bee5-c778-4556-8056-539eaf6ef86b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seed", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5e3c26e-424c-4233-ae92-acace3154bc3"],
 "\[LineSeparator]",
 "continues the walk ",
 StyleBox["seed", "TI"],
 " at both ends as a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 ", by a budget of ",
 StyleBox["kspec", "TI"],
 " edges.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"17630d83-99a8-45c8-8946-0c33cf8c8839"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seed", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d700155-1ec7-481e-8ab3-54b14fd7b807"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c4d9a92-bf32-46fc-954e-71a73ae81f37"],
 " of exactly ",
 StyleBox["n", "TI"],
 " extensions or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed07b048-5401-4d45-b687-d548249e50b1"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "625ea584-661f-4794-8430-2a3c88dda6ab"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7524116-3e19-4684-916a-3ffc530c4f98"],
 " gives every one."
}], "Usage",ExpressionUUID->"c0172cde-bdb5-416b-b9a6-ba1e8ee3fc6e"],

Cell[TextData[{
 "Definition: an extension of ",
 StyleBox["seed", "TI"],
 " at infra-scale ",
 StyleBox["s", "TI"],
 " is a walk that contains ",
 StyleBox["seed", "TI"],
 " as a consecutive stretch and whose every added step keeps its window a \
shortest path: the last ",
 StyleBox["s", "TI"],
 " vertices before the new one, together with it, are at distance ",
 StyleBox["s", "TI"],
 " apart."
}], "Notes",ExpressionUUID->"53147e25-ff6a-435e-9f2a-4b0e49f78c4a"],

Cell[TextData[{
 "This is the continuation of a geodesic as a Riemannian observer sees it. A \
geodesic on a manifold continues uniquely from its velocity; on a graph the \
continuation branches, and the scale says how much of the past the next step \
must respect. At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eeccd625-ae4e-40cd-872a-fe891943d949"],
 " the whole walk stays a shortest path, which is Euclid's second postulate \
read on a graph."
}], "Notes",ExpressionUUID->"1f7c00c5-9443-474f-9cae-276869bf1fec"],

Cell["\<\
The seed is a vertex list, a walk graph, or a list of either. It is taken as \
given: the rule is checked on the steps added, not on the seed.\
\>", "Notes",ExpressionUUID->"68885b99-28ab-4129-9965-6708b64e0af5"],

Cell[TextData[{
 StyleBox["kspec", "TI"],
 " is the budget of added edges: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "999a39cf-98b8-46ac-9dd9-e34abf0b4d27"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9f68201-76b8-4d68-b1a4-b27b1267de86"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1850df99-158b-49d9-bab0-52678bde9667"],
 " or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe968711-03bb-4b2f-bf6e-dd6764f33c7e"],
 ", as for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0226d264-6dab-4e84-88d4-613b70ee576d"],
 ". At both ends it counts the edges added on the longer side. At a finite \
scale the class is infinite, so a finite budget is required."
}], "Notes",ExpressionUUID->"c99f88f7-c892-4fcc-b438-e27ba0eefc90"],

Cell[TextData[{
 "An extension is a walk graph: ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e527665-b183-44e5-a36d-d8eab1861880"],
 " is its vertex sequence. The count-less call returns one extension, found \
greedily."
}], "Notes",ExpressionUUID->"00b63d75-d07a-4ee0-ad5f-3b739375bddf"],

Cell[TextData[{
 Cell[BoxData["ExtendInfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c8764ad-08c1-4fc5-ac62-fff157968585"],
