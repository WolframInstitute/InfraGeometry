Cell["\<\
The germ at a vertex is its value on the empty tuple: 0 at the centre, 1 at a \
neighbour of the centre and 5 at a vertex of the rim.\
\>", "ExampleText",ExpressionUUID->"693358d8-69cf-45c3-91ec-4d343c6ec881"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"center", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"form", " ", "=", " ", 
     RowBox[{"ZeroForm", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", "center", ",", " ", "#"}], "]"}], " ", 
        "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"center", ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", "center"}], "]"}]}], ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"MaximalBy", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "center", ",", " ", "#"}], "]"}], " ", 
           "&"}]}], "]"}]}]}], "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", "corners"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"FormValue", "[", 
        RowBox[{"form", ",", " ", "#", ",", " ", 
         RowBox[{"{", "}"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
      "corners"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7ac8bf20-7369-4df0-a191-d2b45da9b685"],

