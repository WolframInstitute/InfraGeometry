Cell[TextData[{
 "An association as the function. The coordinate ",
 StyleBox["x", "TI"],
 " of the mesh, and its gradient on the steps from the centre, the \
differences of ",
 StyleBox["x", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"e6f9854a-d3c3-4d92-82dd-eeb4e3d11c95"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"x", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"FormDifferential", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"ZeroForm", "[", 
        RowBox[{"g", ",", " ", "x"}], "]"}]}], "]"}], "[", "c", "]"}], " ", "==",
     " ", 
    RowBox[{"AssociationMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"First", " ", "@", " ", "#"}], "]"}], " ", "-", " ", 
        RowBox[{"x", "[", "c", "]"}]}], " ", "&"}], ",", " ", 
      RowBox[{"List", " ", "/@", " ", 
       RowBox[{"AdjacencyList", "[", 
        RowBox[{"g", ",", " ", "c"}], "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0ff5e9f5-f4dc-46f4-bac3-a1026abf5b7d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9c214a7d-2916-4aa4-be5d-afaecfda7bab"]
}, Open  ]]
