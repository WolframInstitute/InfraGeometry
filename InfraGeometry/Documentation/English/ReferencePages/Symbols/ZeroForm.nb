Cell["\<\
The distance from the centre as a 0-form on the square, the hexagonal and the \
triangular tiling. Each vertex is drawn by its value.\
\>", "ExampleText",ExpressionUUID->"dfcbd4b2-4f12-48d5-8ca4-930ba4f896ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graphs", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"#", ",", " ", "\"\<Small\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}],
        " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"forms", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ZeroForm", "[", 
        RowBox[{"substrate", ",", " ", 
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"substrate", ",", " ", 
            RowBox[{"InfraCenter", "[", "substrate", "]"}], ",", " ", "#"}], 
           "]"}], " ", "&"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"substrate", ",", " ", "graphs"}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraSubstrateHighlight", "[", 
        RowBox[{"#1", ",", " ", 
         RowBox[{"First", " ", "/@", " ", "#2"}]}], "]"}], " ", "&"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"graphs", ",", " ", "forms"}], "}"}]}], "]"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fdc98ef7-7a35-494a-9539-197c29ea46a6"],

