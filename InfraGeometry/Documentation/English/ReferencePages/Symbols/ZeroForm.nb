Cell["\<\
The differential of a 0-form is its gradient. The distance from the centre \
rises by 1 on every step away from the centre, drawn as a blue arc, and falls \
by 1 on every step towards it, an orange arc; on a step inside a shell it \
does not change.\
\>", "ExampleText",ExpressionUUID->"14904749-9318-4e6c-b7b0-f15a56dc3999"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"gradient", " ", "=", " ", 
     RowBox[{"FormDifferential", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"ZeroForm", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "#"}], "]"}],
           " ", "&"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Catenate", " ", "@*", " ", "Keys", " ", "@*", " ", 
          RowBox[{"Select", "[", "Positive", "]"}]}], ",", " ", "gradient"}], 
        "]"}], ",", " ", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Catenate", " ", "@*", " ", "Keys", " ", "@*", " ", 
          RowBox[{"Select", "[", "Negative", "]"}]}], ",", " ", "gradient"}], 
        "]"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"baae5538-b95b-430e-b4a9-fa0a66233713"],

