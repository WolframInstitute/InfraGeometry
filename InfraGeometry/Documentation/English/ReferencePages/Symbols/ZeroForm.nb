Cell[CellGroupData[{
Cell["ZeroForm", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b0f232e6-f723-4ca3-bd7c-cda733cb6bd4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ZeroForm"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ZeroForm", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["f", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a15159a4-2125-4bac-b34c-e96182b09118"],
 "\[LineSeparator]",
 "gives the vertex function ",
 StyleBox["f", "TI"],
 ", an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a03a0c94-05d6-46ac-8003-3a4be6f4eba8"],
 " or a function, as a 0-form on ",
 StyleBox["g", "TI"],
 ": its germ at the vertex ",
 StyleBox["v", "TI"],
 " is the value ",
 StyleBox["f", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") on the empty tuple.",
 "\n"
}], "Usage",ExpressionUUID->"532e2203-9e0d-45be-beee-bab9b3dd86a2"],

Cell[TextData[{
 "Definition: a ",
 StyleBox["k", "TI"],
 "-form ",
 StyleBox["\[Omega]", "TI"],
 " on a graph assigns to every vertex ",
 StyleBox["v", "TI"],
 " an alternating function ",
 StyleBox["\[Omega](v; w\:2081, \[Ellipsis], w\:2096)", "TI"],
 " on the ",
 StyleBox["k", "TI"],
 "-tuples of distinct neighbours ",
 StyleBox["w\:2081, \[Ellipsis], w\:2096", "TI"],
 " of ",
 StyleBox["v", "TI"],
 ", its germ at ",
 StyleBox["v", "TI"],
 ". For ",
 StyleBox["k", "TI"],
 " = 0 the only tuple is the empty one, so a 0-form is a function on the \
vertices."
}], "Notes",ExpressionUUID->"39296d4c-69f1-4579-800e-0a73b9288c7e"],

Cell[TextData[{
 "A form is stored as ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", 
    RowBox[{"<|", 
     RowBox[{"tuple", " ", "->", " ", "value"}], "|>"}]}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2987dacf-0686-4087-bad6-7aec412d299b"],
 ", each tuple sorted, and the 0-form of ",
 StyleBox["f", "TI"],
 " is ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"{", "}"}], " ", "->", " ", 
      RowBox[{"f", 
       RowBox[{"(", "v", ")"}]}]}], "|>"}]}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bb8f52f-1c0a-4009-9212-32a67b1748c9"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FormValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FormValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "08397c83-b491-467e-837f-6887a79431d0"],
 " reads it: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FormValue"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FormValue", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["\[Omega]", "TR"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    RowBox[{"{", "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58fac059-30f4-4d7e-a94d-da488d24f792"],
 " is ",
 StyleBox["f", "TI"],
 "(",
 StyleBox["v", "TI"],
 ")."
}], "Notes",ExpressionUUID->"39caed51-debc-4023-9065-3593e22e4c6d"],

Cell[TextData[{
 "An ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4cf27144-f62d-4242-96d9-3d476e1b2493"],
 " has to give a value at every vertex of ",
 StyleBox["g", "TI"],
 ": at a vertex it misses, the germ holds the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Missing"]], "paclet:ref/Missing"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "eb4fdd18-0e80-43a7-bf72-d9f98e7c515d"],
 " of the lookup."
}], "Notes",ExpressionUUID->"3165007d-1294-4f74-acd7-addf603cfbc5"],

Cell[TextData[{
 "A 0-form and a 0-cochain carry the same values: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IntegrationMap"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/IntegrationMap", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "221ed310-67ec-4cd4-891b-260ccf626bf7"],
 " reads a 0-form as the 0-cochain ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"{", "v", "}"}], " ", "->", " ", 
    RowBox[{"f", 
     RowBox[{"(", "v", ")"}]}]}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df1236da-f25c-45f8-b934-2eca93024f7e"],
 " on the one-vertex cliques, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RestrictionMap"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RestrictionMap", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0483afa5-7308-4487-b46d-9dd536003010"],
 " reads that back. The differential of a 0-form is its gradient, ",
 StyleBox["(df)(v; w) = f(w) \[Minus] f(v)", "TI"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FormDifferential"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FormDifferential", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0983a4e3-480e-4c71-88bf-7dd403c46ca5"],
 "), and the wedge of two 0-forms is their product (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FormWedge"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FormWedge", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "98097771-6be8-4139-bb6c-88fef076fd52"],
 ")."
}], "Notes",ExpressionUUID->"6843b317-dde3-4efb-aff5-91dd143b66cc"]
}, Open  ]],

