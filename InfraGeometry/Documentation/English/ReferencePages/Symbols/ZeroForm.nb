    RowBox[{"form", " ", "=", " ", 
     RowBox[{"ZeroForm", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "#"}], "]"}], 
        " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cochain", " ", "=", " ", 
     RowBox[{"IntegrationMap", "[", 
      RowBox[{"g", ",", " ", "form"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"KeyMap", "[", 
        RowBox[{"First", ",", " ", "cochain"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"Normal", "[", "cochain", "]"}], ",", " ", "4"}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"FormValue", "[", 
          RowBox[{
