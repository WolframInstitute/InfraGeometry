          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "center", ",", " ", "#"}], "]"}], "^", 
          "2"}]}], " ", "&"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
