Cell[TextData[{
 "A 0-form and a 0-cochain carry the same values. ",
 Cell[BoxData["IntegrationMap"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd3a6790-22fb-4175-a152-388d539f1c43"],
 " gives the 0-cochain on the one-vertex cliques, where the value 0 at the \
centre is not stored, and ",
 Cell[BoxData["RestrictionMap"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ba43a51-eb16-458c-848a-1ffac463c130"],
 " reads back the value at every vertex."
}], "ExampleText",ExpressionUUID->"a019ee88-58ae-43c3-97e6-50d5d8354e70"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"form", " ", "=", " ", 
     RowBox[{"ZeroForm", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "#"}], "]"}], " ",
         "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cochain", " ", "=", " ", 
     RowBox[{"IntegrationMap", "[", 
      RowBox[{"g", ",", " ", "form"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"KeyMap", "[", 
        RowBox[{"First", ",", " ", "cochain"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"Normal", "[", "cochain", "]"}], ",", " ", "4"}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"FormValue", "[", 
          RowBox[{
           RowBox[{"RestrictionMap", "[", 
            RowBox[{"g", ",", " ", "cochain"}], "]"}], ",", " ", "#", ",", 
           " ", 
           RowBox[{"{", "}"}]}], "]"}], " ", "==", " ", 
         RowBox[{"FormValue", "[", 
          RowBox[{"form", ",", " ", "#", ",", " ", 
           RowBox[{"{", "}"}]}], "]"}]}], " ", "&"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a7f399bc-5b2a-4d68-a4b9-561f3a8cff59"],

