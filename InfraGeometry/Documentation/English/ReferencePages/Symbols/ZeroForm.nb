Cell[TextData[{
 "A 0-form and a 0-cochain carry the same values. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IntegrationMap"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/IntegrationMap", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c8237a1d-0d30-4e16-b4a1-30483a55f14f"],
 " gives the 0-cochain on the one-vertex cliques, where the value 0 at the \
centre is not stored, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RestrictionMap"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RestrictionMap", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "23f63c24-5a96-4410-9ccd-44326e85994e"],
 " reads back the value at every vertex."
}], "ExampleText",ExpressionUUID->"2c1faafc-8796-4a4b-9224-a95758401bf5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
