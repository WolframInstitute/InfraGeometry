Cell[CellGroupData[{
Cell["ZeroForm", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3645b033-658b-42b1-b54e-c83db2a89d39"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ZeroForm"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ZeroForm", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["f", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f90a744-6e93-4122-8782-4a513b0f2e31"],
 "\[LineSeparator]",
 "gives the vertex function ",
 StyleBox["f", "TI"],
 ", an association or a function, as a 0-form on ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"602c76ac-b654-405f-88cd-465c387c9b5d"],

Cell[TextData[{
 "A ",
 StyleBox["k", "TI"],
 "-form ",
 StyleBox["\[Omega]", "TI"],
 " on a graph gives every vertex ",
 StyleBox["v", "TI"],
 " an alternating function ",
 StyleBox["\[Omega](v; w\:2081, \[Ellipsis], w\:2096)", "TI"],
 " of ",
 StyleBox["k", "TI"],
 " distinct neighbours of ",
 StyleBox["v", "TI"],
 ", its germ at ",
 StyleBox["v", "TI"],
 ". For ",
 StyleBox["k = 0", "TI"],
 " the only argument is the empty tuple, and a 0-form is a function on the \
vertices: ",
 StyleBox["\[Omega](v; ) = f(v)", "TI"],
 "."
}], "Notes",ExpressionUUID->"aed21e47-afa4-4ea0-9111-a000c4282669"],

Cell[TextData[{
 "A form is stored as ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", 
    RowBox[{"<|", 
     RowBox[{"tuple", " ", "->", " ", "value"}], "|>"}]}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6d3bb09-df46-4ec5-a1e2-5491da9a7658"],
 ", and the 0-form of ",
 StyleBox["f", "TI"],
 " as ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"{", "}"}], " ", "->", " ", 
      RowBox[{"f", 
       RowBox[{"(", "v", ")"}]}]}], "|>"}]}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39a11e2a-0c3f-40b1-9ed2-ecc062dc997e"],
 ". ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FormValue"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FormValue", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["\[Omega]", "TR"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    RowBox[{"{", "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76bec7d4-a37c-4456-addd-b5f2810464ef"],
 " reads ",
 StyleBox["f(v)", "TI"],
 "."
}], "Notes",ExpressionUUID->"69088560-a7ef-4c15-ab28-a34f1f4f128c"],

Cell[TextData[{
 "A 0-form and a 0-cochain carry the same values: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IntegrationMap"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/IntegrationMap", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5603c959-3e5b-42d6-bf0f-eba2d87a0cc6"],
 " gives the 0-cochain ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"{", "v", "}"}], " ", "->", " ", 
    RowBox[{"f", 
     RowBox[{"(", "v", ")"}]}]}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bda96010-e4e1-4e44-9398-e2b1e1601b0f"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RestrictionMap"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RestrictionMap", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1c0032be-6b80-4f34-847a-6fa1f527da18"],
 " gives the 0-form back. The differential of a 0-form is its gradient, ",
 StyleBox["(df)(v; w) = f(w) \[Minus] f(v)", "TI"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FormDifferential"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FormDifferential", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3fe6a80c-7de3-4c0b-9201-c4d93ee7a64b"],
 "), and the wedge of two 0-forms is their product (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FormWedge"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FormWedge", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d8214c70-92d8-4d1f-97f4-9c293b59aef2"],
 ")."
}], "Notes",ExpressionUUID->"00b8ca5e-7f6e-4609-b0e9-0cf3197d5724"],

Cell["An association must give a value at every vertex.", "Notes",ExpressionUUID->"649e6cc6-b397-4095-856f-22f477dca1ee"]
}, Open  ]],

