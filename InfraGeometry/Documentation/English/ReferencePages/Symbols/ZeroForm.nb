Cell["\<\
The germ at the centre, at a neighbour of the centre and at a farthest vertex:\
\>", "ExampleText",ExpressionUUID->"8b3b38c7-cb14-4213-9a5f-545c9acf2944"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"ZeroForm", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "&"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", "[", "c", "]"}], ",", " ", 
     RowBox[{"f", "[", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"AdjacencyList", "[", 
        RowBox[{"g", ",", " ", "c"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"f", "[", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"MaximalBy", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "&"}]}], 
        "]"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5163116a-5441-431a-9bba-c40242b3284b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"{", "}"}], "\[Rule]", "0"}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"{", "}"}], "\[Rule]", "1"}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"{", "}"}], "\[Rule]", "6"}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"6b94ea6d-77cf-4031-b9c6-9b40a09e45ee"]
}, Open  ]]
}, Open  ]],

