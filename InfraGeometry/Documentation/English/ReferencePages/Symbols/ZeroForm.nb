Cell["\<\
The differential of a 0-form is its gradient. The distance from the centre \
rises by 1 on every step away from the centre, drawn as a blue arc, and falls \
by 1 on every step towards it, an orange arc; on a step inside a shell it \
does not change.\
\>", "ExampleText",ExpressionUUID->"69ab20a1-87d7-4903-b9ac-900a525504b7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"gradient", " ", "=", " ", 
     RowBox[{"FormDifferential", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"ZeroForm", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "#"}], "]"}], 
          " ", "&"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Catenate", " ", "@*", " ", "Keys", " ", "@*", " ", 
          RowBox[{"Select", "[", "Positive", "]"}]}], ",", " ", "gradient"}], 
        "]"}], ",", " ", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Catenate", " ", "@*", " ", "Keys", " ", "@*", " ", 
          RowBox[{"Select", "[", "Negative", "]"}]}], ",", " ", "gradient"}], 
        "]"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6e4187a5-dc22-439e-8c84-b06d9a0eb5f8"],

