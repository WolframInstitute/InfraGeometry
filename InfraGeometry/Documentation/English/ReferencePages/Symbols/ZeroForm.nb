Cell["\<\
The distance from the centre as a 0-form on the square, the hexagonal and the \
triangular tiling. Each vertex is drawn by its value.\
\>", "ExampleText",ExpressionUUID->"e4d57fdf-7635-4e88-807a-2a5ac31f6930"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graphs", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"#", ",", " ", "\"\<Small\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}],
        " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"forms", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ZeroForm", "[", 
        RowBox[{"substrate", ",", " ", 
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"substrate", ",", " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"GraphCenter", "[", "substrate", "]"}]}], ",", " ", 
            "#"}], "]"}], " ", "&"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"substrate", ",", " ", "graphs"}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraSubstrateHighlight", "[", 
        RowBox[{"#1", ",", " ", 
         RowBox[{"First", " ", "/@", " ", "#2"}]}], "]"}], " ", "&"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"graphs", ",", " ", "forms"}], "}"}]}], "]"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ba3b86a6-fb4f-4101-81ea-794c6fa18516"],

