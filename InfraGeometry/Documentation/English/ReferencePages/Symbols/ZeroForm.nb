Cell[CellGroupData[{
Cell["ZeroForm", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d5341bee-9b40-4a24-b27b-590399b466cc"],
 Cell[BoxData[
  RowBox[{"ZeroForm", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["f", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b38a649-052c-4f9d-97de-ee25ed60e5a6"],
 "\[LineSeparator]",
 "gives the vertex function ",
 StyleBox["f", "TI"],
 ", an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1bcd05f4-57d0-4371-b577-df62f9d2c65e"],
 " or a function, as a 0-form on ",
 StyleBox["g", "TI"],
 ": its germ at the vertex ",
 StyleBox["v", "TI"],
 " is the value ",
 StyleBox["f", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") on the empty tuple.",
 "\n"
}], "Usage",ExpressionUUID->"3a499833-eea3-4695-a6a7-4a7e109c0aa6"],

Cell[TextData[{
 "Definition: a ",
 StyleBox["k", "TI"],
 "-form ",
 StyleBox["\[Omega]", "TI"],
 " on a graph assigns to every vertex ",
 StyleBox["v", "TI"],
 " an alternating function ",
 StyleBox["\[Omega](v; w\:2081, \[Ellipsis], w\:2096)", "TI"],
 " on the ",
 StyleBox["k", "TI"],
 "-tuples of distinct neighbours ",
 StyleBox["w\:2081, \[Ellipsis], w\:2096", "TI"],
 " of ",
 StyleBox["v", "TI"],
 ", its germ at ",
 StyleBox["v", "TI"],
 ". For ",
 StyleBox["k", "TI"],
 " = 0 the only tuple is the empty one, so a 0-form is a function on the \
vertices."
}], "Notes",ExpressionUUID->"14c01dec-67b5-47a4-a9d0-72bb52e40649"],

Cell[TextData[{
 "A form is stored as ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", 
    RowBox[{"<|", 
     RowBox[{"tuple", " ", "->", " ", "value"}], "|>"}]}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e10671ed-7878-4d85-8914-7e221d7eb3c8"],
 ", each tuple sorted, and the 0-form of ",
 StyleBox["f", "TI"],
 " is ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"{", "}"}], " ", "->", " ", 
      RowBox[{"f", 
       RowBox[{"(", "v", ")"}]}]}], "|>"}]}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2812b9f-dab2-41a1-855e-ed4c6ba0b646"],
 ". ",
 Cell[BoxData["FormValue"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "886a1356-e397-4636-b35c-267b368d527e"],
 " reads it: ",
 Cell[BoxData[
  RowBox[{"FormValue", "[", 
   RowBox[{
    StyleBox["\[Omega]", "TR"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    RowBox[{"{", "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a14d9537-89d1-4a0f-b622-5affd17f73b9"],
 " is ",
 StyleBox["f", "TI"],
 "(",
 StyleBox["v", "TI"],
 ")."
}], "Notes",ExpressionUUID->"cf5925dd-e5f4-4140-a936-98a631a97e05"],

Cell[TextData[{
 "An ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c13d00a0-df8f-4d0d-ba78-0e51dd0f78f0"],
 " has to give a value at every vertex of ",
 StyleBox["g", "TI"],
 ": at a vertex it misses, the germ holds the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Missing"]], "paclet:ref/Missing"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f2381adb-7f98-4ddb-90ad-7b7ebeb3397e"],
 " of the lookup."
}], "Notes",ExpressionUUID->"5eb68eb3-daf7-4461-8d52-e51d325acbcf"],

Cell[TextData[{
 "A 0-form and a 0-cochain carry the same values: ",
 Cell[BoxData["IntegrationMap"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10f32b5d-7854-49da-9e89-eec52d1502ff"],
 " reads a 0-form as the 0-cochain ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"{", "v", "}"}], " ", "->", " ", 
    RowBox[{"f", 
     RowBox[{"(", "v", ")"}]}]}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cce2b73f-9e06-4801-b7d3-f7a653ec0ec7"],
 " on the one-vertex cliques, and ",
 Cell[BoxData["RestrictionMap"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fbe9aef-9b7a-4a2a-a69c-29bf7c4ea7fa"],
 " reads that back. The differential of a 0-form is its gradient, ",
 StyleBox["(df)(v; w) = f(w) \[Minus] f(v)", "TI"],
 " (",
 Cell[BoxData["FormDifferential"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63a6b64e-3302-4587-85fd-b9f3faaabb45"],
 "), and the wedge of two 0-forms is their product (",
 Cell[BoxData["FormWedge"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a5713fc-debe-4a94-916b-82334b56c9f2"],
 ")."
}], "Notes",ExpressionUUID->"af16c0fa-7b8f-46b9-9b7f-6de3fbb4b251"]
}, Open  ]],

