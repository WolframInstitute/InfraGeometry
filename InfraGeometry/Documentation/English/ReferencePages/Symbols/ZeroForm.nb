Cell["\<\
The gradient of the distance from the centre is 1 on each step outward and \
\[Minus]1 on each step inward; on a step inside a shell it is 0 and not \
stored. On the mesh 173 of the 255 edges join two shells:\
\>", "ExampleText",ExpressionUUID->"93f2a180-1038-4638-9756-ccfedfae1609"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Counts", " ", "@", " ", 
    RowBox[{"Catenate", "[", 
     RowBox[{"Values", " ", "/@", " ", 
      RowBox[{"Values", " ", "@", " ", 
       RowBox[{"FormDifferential", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"ZeroForm", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "&"}]}],
           "]"}]}], "]"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"db41eaad-25d0-4781-b008-bf5c529d8ca6"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "173"}], ",", 
   RowBox[{
    RowBox[{"-", "1"}], "\[Rule]", "173"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"fa5824f8-e017-46ed-800f-94bc260dd679"]
}, Open  ]],

Cell["\<\
A 0-form and a 0-cochain carry the same values. The value 0 at the centre is \
not stored in the cochain:\
\>", "ExampleText",ExpressionUUID->"79599149-db23-48d5-b7f4-9f9ec738c1d5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"ZeroForm", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "&"}]}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"cochain", " ", "=", " ", 
     RowBox[{"IntegrationMap", "[", 
      RowBox[{"g", ",", " ", "f"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"KeySort", "[", "cochain", "]"}], " ", "==", " ", 
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"AssociationThread", "[", 
          RowBox[{
           RowBox[{"List", " ", "/@", " ", 
            RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c"}], "]"}]}], "]"}], ",", " ", "0"}], 
        "]"}]}]}], ",", "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"FormValue", "[", 
          RowBox[{
           RowBox[{"RestrictionMap", "[", 
            RowBox[{"g", ",", " ", "cochain"}], "]"}], ",", " ", "#", ",", 
           " ", 
           RowBox[{"{", "}"}]}], "]"}], " ", "==", " ", 
         RowBox[{"FormValue", "[", 
          RowBox[{"f", ",", " ", "#", ",", " ", 
           RowBox[{"{", "}"}]}], "]"}]}], " ", "&"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7116b043-ee7e-48ea-b24e-72dc4b03a3eb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"60cdbc20-0c79-4241-bccc-8c915ee0d6aa"]
}, Open  ]],

Cell["The wedge of two 0-forms is their product:", "ExampleText",ExpressionUUID->"9ab58647-1c24-4134-bed0-0b2f4a5db8b4"],

