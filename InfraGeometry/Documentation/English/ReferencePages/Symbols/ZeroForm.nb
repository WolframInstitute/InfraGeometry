            RowBox[{"g", ",", " ", "cochain"}], "]"}], ",", " ", "#", ",", 
           " ", 
           RowBox[{"{", "}"}]}], "]"}], " ", "==", " ", 
         RowBox[{"FormValue", "[", 
          RowBox[{"form", ",", " ", "#", ",", " ", 
           RowBox[{"{", "}"}]}], "]"}]}], " ", "&"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
