Cell["The rotation of the 12-cycle by one step and three times it.", \
"ExampleText",ExpressionUUID->"b831a2e9-8152-4eae-88ea-94ef4d88f85d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
