Cell["\<\
On the cycle a third of three times the rotation is the rotation.\
\>", "ExampleText",ExpressionUUID->"dd0f708a-42ec-4228-bfff-d6569a9b38c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rotation", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"third", " ", "=", " ", 
     RowBox[{"DisplacementScale", "[", 
