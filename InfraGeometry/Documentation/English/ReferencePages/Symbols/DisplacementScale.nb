Notebook[{

Cell[CellGroupData[{
Cell["DisplacementScale", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6f3c6971-61bb-434b-b5d7-31e60f77ea29"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementScale"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementScale", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d", "TI"], ",", " ", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bf2f2c9-5517-4b30-b0a6-59e77eba7644"],
 "\[LineSeparator]",
 "is the displacement ",
 StyleBox["d", "TI"],
 " scaled by ",
 StyleBox["t", "TI"],
 ": each step is carried along the shortest paths of ",
 StyleBox["g", "TI"],
 " to ",
 StyleBox["|t|", "TI"],
 " times its length, through its base vertex for ",
 StyleBox["t", "TI"],
 " < 0.",
 "\n"
}], "Usage",ExpressionUUID->"93eda8f7-895a-4e6d-8cce-1d7e61e07577"],

Cell[TextData[{
 "Let ",
 StyleBox["a", "TI"],
 " \[RightArrow] ",
 StyleBox["b", "TI"],
 " be a step of ",
 StyleBox["D", "TI"],
 ". For ",
 StyleBox["t \[GreaterEqual] 0", "TI"],
 " the candidates are the vertices ",
 StyleBox["x", "TI"],
 " on a shortest path from ",
 StyleBox["a", "TI"],
 " through ",
 StyleBox["b", "TI"],
 ", ",
 StyleBox["d(a, x) + d(x, b) = d(a, b)", "TI"],
 " or ",
 StyleBox["d(a, x) = d(a, b) + d(b, x)", "TI"],
 ". For ",
 StyleBox["t < 0", "TI"],
 " they are the vertices on a shortest path from ",
 StyleBox["b", "TI"],
 " through ",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["d(b, x) = d(b, a) + d(a, x)", "TI"],
 "."
}], "Notes",ExpressionUUID->"6286d6d9-4c71-4d15-b02a-74385f4bed30"],

Cell[TextData[{
 "Of the candidates, ",
 StyleBox["tD(a)", "TI"],
 " keeps those with ",
 StyleBox["d(a, x)", "TI"],
 " nearest to ",
 StyleBox["|t| d(a, b)", "TI"],
 ", and of these the straightest. The straightest ",
 StyleBox["x", "TI"],
 " carries the largest share of shortest paths through the middle vertex of \
the triple, ",
 StyleBox["\[Sigma](p, q) \[Sigma](q, s) / \[Sigma](p, s)", "TI"],
 " for the triple ",
 StyleBox["p, q, s", "TI"],
 " with ",
 StyleBox["q", "TI"],
 " in the middle, ",
 StyleBox["\[Sigma]", "TI"],
 " the number of shortest paths. On the square grid this continues a step \
straight on."
}], "Notes",ExpressionUUID->"0a10a6a2-e83f-42d2-a8db-1ea781057a1c"],

Cell["\<\
Ties are kept, so a scaled step can have several values. Half a step of \
length 1 is both of its ends.\
\>", "Notes",ExpressionUUID->"a51abc33-8e5e-4a2a-8670-e7799358b845"],

Cell[TextData[{
 StyleBox["t", "TI"],
 " = 1 gives ",
 StyleBox["D", "TI"],
 ", ",
 StyleBox["t", "TI"],
 " = 0 the identity and ",
 StyleBox["t", "TI"],
 " = \[Minus]1 is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementNegative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementNegative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "479a9c38-8a89-458d-aaf1-a899b65c5432"],
 "."
}], "Notes",ExpressionUUID->"ac1ea95a-9b16-4529-9a49-9029afa8addd"],

Cell[TextData[{
 "In the plane ",
 StyleBox["s(tX) = (st)X", "TI"],
 ". On a graph scaling is not exactly multiplicative, and ",
 StyleBox["tD", "TI"],
 " is not the ",
 StyleBox["t", "TI"],
 "-fold composite of ",
 StyleBox["D", "TI"],
 "."
}], "Notes",ExpressionUUID->"6852dc65-45d5-4a37-81a9-a8d76bdcb030"]
}, Open  ]],

