Cell["\<\
One step from the centre scaled by 1, 2, 3 and 4, on the square grid and on \
the square mesh. On the grid the multiples go straight on; on the mesh they \
fork:\
\>", "ExampleText",ExpressionUUID->"fad20070-3c09-46a4-937b-10f1ddac11b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"DisplacementPlot", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"DisplacementScale", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"<|", 
             RowBox[{"c", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"First", " ", "@", " ", 
                RowBox[{"AdjacencyList", "[", 
                 RowBox[{"g", ",", " ", "c"}], "]"}]}], "}"}]}], "|>"}], ",", 
            " ", "t"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}]}], "]"}], ",",
     "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"8678e342-6c38-44c5-b452-ad52a2300882"],

