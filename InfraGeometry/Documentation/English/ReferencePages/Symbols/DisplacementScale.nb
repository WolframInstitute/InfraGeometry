Cell["\<\
The magnitude grows with the factor while the shortest paths last. On the \
12-cycle they end at the opposite vertex, at distance 6, so 7 times the \
rotation is the map to the opposite vertex, as 6 times is.\
\>", "ExampleText",ExpressionUUID->"aa257a14-edde-42e1-aeda-c99b1f398244"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rotation", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"DisplacementScale", "[", 
        RowBox[{"g", ",", " ", "rotation", ",", " ", "7"}], "]"}]}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"DisplacementMagnitude", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"DisplacementScale", "[", 
          RowBox[{"g", ",", " ", "rotation", ",", " ", "t"}], "]"}]}], "]"}], 
       ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "1", ",", " ", "7"}], "}"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"DisplacementScale", "[", 
       RowBox[{"g", ",", " ", "rotation", ",", " ", "7"}], "]"}], " ", "===", 
      " ", 
      RowBox[{"DisplacementScale", "[", 
       RowBox[{"g", ",", " ", "rotation", ",", " ", "6"}], "]"}]}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"00bd1cd6-676f-4b7e-bffd-d7fce4bbee47"],

