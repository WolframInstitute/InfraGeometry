Cell["\<\
A single step from the centre, scaled by 1, 2, 3 and 4, on the square, \
triangular and hexagonal tilings. On the first two the multiples go straight \
on; on the hexagonal tiling they fork.\
\>", "ExampleText",ExpressionUUID->"e5e7cdc4-6b8c-4124-b84b-0cc91e2219a6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"step", " ", "=", " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", "g", "]"}]}], " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"AdjacencyList", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"First", " ", "@", " ", 
               RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}], "}"}]}], 
         "|>"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"DisplacementPlot", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"DisplacementScale", "[", 
           RowBox[{"g", ",", " ", "step", ",", " ", "t"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}]}], "]"}], ",",
     "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f4108288-e022-42bb-be01-5fe4d8caeda7"],

