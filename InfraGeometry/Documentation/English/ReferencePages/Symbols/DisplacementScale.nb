Cell["\<\
Scaling is not composition. At the vertex 75 of the grid three times the step \
right, in blue, bends to the two pendant vertices at distance 3; three steps \
right, in red, stop at the pendant vertex at distance 2:\
\>", "ExampleText",ExpressionUUID->"78072a9d-f8c1-472a-9af0-e66b989772c0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"right", " ", "=", " ", 
     RowBox[{"TranslationDisplacement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"tripled", " ", "=", " ", 
      RowBox[{"DisplacementScale", "[", 
       RowBox[{"g", ",", " ", "right", ",", " ", "3"}], "]"}]}], ",", " ", 
     RowBox[{"composite", " ", "=", " ", 
      RowBox[{"DisplacementCompose", "[", 
       RowBox[{"right", ",", " ", "right", ",", " ", "right"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"KeyTake", "[", 
        RowBox[{"tripled", ",", " ", 
         RowBox[{"{", "75", "}"}]}], "]"}], ",", " ", 
       RowBox[{"KeyTake", "[", 
        RowBox[{"composite", ",", " ", 
         RowBox[{"{", "75", "}"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"tripled", "[", "75", "]"}], ",", " ", 
        RowBox[{"composite", "[", "75", "]"}]}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"208cbee4-74ad-42b8-a928-03a3c3763fde"],

