Notebook[{

Cell[CellGroupData[{
Cell["DisplacementScale", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"74d88db1-8cb4-4818-b319-f908e1fff705"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementScale"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementScale", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d", "TI"], ",", " ", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af7bc9bc-1f77-4ec3-a182-45745dd0b9e9"],
 "\[LineSeparator]",
 "scales the displacement ",
 StyleBox["d", "TI"],
 " by ",
 StyleBox["t", "TI"],
 ": each step from ",
 StyleBox["v", "TI"],
 " to a vertex ",
 StyleBox["w", "TI"],
 " of ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") is carried along the shortest paths of ",
 StyleBox["g", "TI"],
 " from ",
 StyleBox["v", "TI"],
 " through ",
 StyleBox["w", "TI"],
 " to the vertices nearest the distance |",
 StyleBox["t", "TI"],
 "| ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["w", "TI"],
 "), and for ",
 StyleBox["t", "TI"],
 " < 0 through ",
 StyleBox["v", "TI"],
 " in the opposite direction.",
 "\n"
}], "Usage",ExpressionUUID->"b2c8ca9b-c39c-4359-b8d2-da0b331fb37e"],

Cell[TextData[{
 "Definition: let ",
 StyleBox["a", "TI"],
 " \[RightArrow] ",
 StyleBox["b", "TI"],
 " be a step of ",
 StyleBox["D", "TI"],
 ". For ",
 StyleBox["t \[GreaterEqual] 0", "TI"],
 " the candidates are the vertices on a shortest path from ",
 StyleBox["a", "TI"],
 " through ",
 StyleBox["b", "TI"],
 ": the interval, ",
 StyleBox["d(a, x) + d(x, b) = d(a, b)", "TI"],
 ", and the vertices beyond ",
 StyleBox["b", "TI"],
 ", ",
 StyleBox["d(a, x) = d(a, b) + d(b, x)", "TI"],
 ". For ",
 StyleBox["t < 0", "TI"],
 " they are the vertices beyond ",
 StyleBox["a", "TI"],
 " on a shortest path from ",
 StyleBox["b", "TI"],
 ", ",
 StyleBox["d(b, x) = d(b, a) + d(a, x)", "TI"],
 ". Of the candidates, ",
 StyleBox["tD", "TI"],
 " keeps those whose distance from ",
 StyleBox["a", "TI"],
 " is nearest to ",
 StyleBox["|t| d(a, b)", "TI"],
 ", and of these the straightest. The value of ",
 StyleBox["tD", "TI"],
 " at ",
 StyleBox["a", "TI"],
 " is the union over the steps from ",
 StyleBox["a", "TI"],
 "."
}], "Notes",ExpressionUUID->"37c98aae-6f94-46ee-a9b8-e13363e1d30c"],

Cell[TextData[{
 "The straightest candidates are those through which the largest fraction of \
the shortest paths between the two outer vertices of the aligned triple pass: \
",
 StyleBox["\[Sigma](p, q) \[Sigma](q, s) / \[Sigma](p, s)", "TI"],
 " for the triple ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ", ",
 StyleBox["s", "TI"],
 " with ",
 StyleBox["q", "TI"],
 " in the middle, ",
 StyleBox["\[Sigma]", "TI"],
 " the number of shortest paths. On the square and triangular tilings this \
continues a step straight on. On the hexagonal tiling no shortest path goes \
straight through a vertex, and twice a step has two values."
}], "Notes",ExpressionUUID->"cc60099b-bbfd-4370-b6d4-0b47d1c7f83b"],

Cell["\<\
Ties are kept. Half a step of length 1 is both of its ends, since 0 and 1 are \
equally near 1/2. Where the straight continuation leaves the graph, at the \
rim, the step bends to the straightest vertices still reached; where every \
continuation ends, at the far side of a cycle, it stops there.\
\>", "Notes",ExpressionUUID->"4934670a-d287-4eff-9152-95e64e4d013e"],

Cell[TextData[{
 StyleBox["t", "TI"],
 " = 1 gives ",
 StyleBox["D", "TI"],
 ", ",
 StyleBox["t", "TI"],
 " = 0 the identity and ",
 StyleBox["t", "TI"],
 " = \[Minus]1 is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementNegative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementNegative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0d02ed77-f74c-4b34-ba22-b0b7f471769f"],
 ". Scaling is not exactly multiplicative: ",
 StyleBox["s(tD)", "TI"],
 " and ",
 StyleBox["(st)D", "TI"],
 " can differ where the shortest paths end or fork."
}], "Notes",ExpressionUUID->"bbaf531f-396e-4b59-93cb-d19f409eb33b"]
}, Open  ]],

