Cell["\<\
The step right on the 6 \[Times] 6 grid scaled by 2, by \[Minus]1 and by 1/2. \
In the interior the doubled step goes two steps right. Next to the right \
column the straight continuation leaves the grid, and the doubled step turns \
to the two vertices beyond the last step. The halved step has both ends of \
the step as its values; the vertex itself is not drawn.\
\>", "ExampleText",ExpressionUUID->"37cf52ee-2e07-477c-84bd-08039cdb57db"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "6"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"right", " ", "=", " ", 
     RowBox[{"TranslationDisplacement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"DisplacementPlot", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"DisplacementScale", "[", 
         RowBox[{"g", ",", " ", "right", ",", " ", "t"}], "]"}]}], "]"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", 
          RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}]}], "]"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6ef8d949-b132-4e6b-9107-3f8b9eb6068e"],

