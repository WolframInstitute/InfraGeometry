Cell["\<\
Scaling is not exactly multiplicative. On the mesh twice the double of a step \
is not four times the step:\
\>", "ExampleText",ExpressionUUID->"c97dea33-277a-4849-9fa1-a7b86e223e48"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"step", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{"c", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"AdjacencyList", "[", 
          RowBox[{"g", ",", " ", "c"}], "]"}]}], "}"}]}], "|>"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"DisplacementScale", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"DisplacementScale", "[", 
         RowBox[{"g", ",", " ", "step", ",", " ", "2"}], "]"}], ",", " ", 
        "2"}], "]"}], "[", "c", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"DisplacementScale", "[", 
       RowBox[{"g", ",", " ", "step", ",", " ", "4"}], "]"}], "[", "c", 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"39033342-380b-4ce1-80b8-0f756698cdb2"],

