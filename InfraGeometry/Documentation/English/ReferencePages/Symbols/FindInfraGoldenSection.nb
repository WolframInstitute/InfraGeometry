Cell["FindInfraGoldenSection", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"74521683-173f-432e-89d2-d04c60135b32"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraGoldenSection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGoldenSection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10338484-861f-4d6c-84c8-809513b8c87c"],
 "\[LineSeparator]",
 "gives the density <|v -> m, \[Ellipsis]|> of the vertices at the golden \
index 1 + (n-1)/GoldenRatio along every geodesic from p1 to p2, m counting \
the geodesics.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"44dfc432-9f0d-415d-a8aa-3b11b1c10579"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraGoldenSection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGoldenSection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["walk1", "TI"], ",", " ", "..."}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d98adb40-eafd-4607-b81b-4a5d09947ed5"],
 "\[LineSeparator]",
 "and ",
 Cell[BoxData[
  RowBox[{"FindInfraGoldenSection", "[", 
   RowBox[{"graph", ",", " ", "walk"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f07cbb2-8ffe-40c2-875e-b8542b0508ee"],
 " use the supplied walks \[LongDash] vertex lists or walk graphs."
}], "Usage",ExpressionUUID->"850abe3d-7d44-4790-bafc-cf3348a6a437"],

