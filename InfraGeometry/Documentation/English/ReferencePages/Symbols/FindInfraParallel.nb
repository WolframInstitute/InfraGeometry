Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"0ae57158-c3dc-4c4d-a8ae-38b63cad1b6f"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8c55ded7-64fa-4228-907a-f0501b658ee1"], Cell["System", "TableText",
     FontWeight->Bold,ExpressionUUID->"5868bff3-bb4c-47c0-89cb-75a82cfda361"],
