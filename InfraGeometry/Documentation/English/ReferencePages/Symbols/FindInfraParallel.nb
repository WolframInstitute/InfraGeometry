   {Cell["      ", "ModInfo",ExpressionUUID->
     "2d83f5e6-3511-4b70-8fce-c7bdba0ace50"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "138f9b0b-76d4-49be-8089-ec35f85430fe"], Cell[
    "Postulate 5", "TableText",ExpressionUUID->
     "465ccc91-9d82-466b-a67f-d8b3d3c9a260"], Cell["\<\
The parallel postulate: two lines cut by a transversal making internal angles \
less than two right angles meet on that side.\
\>", "TableText",ExpressionUUID->"ec25ac06-ac77-4c63-843e-3cc28fc0f165"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "606acd66-1160-477b-8ffc-f459481b1a49"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "a96a27d9-6d18-4208-a3f6-048000f20b07"], Cell[
    "Proposition I.31", "TableText",ExpressionUUID->
     "08c2ebbb-8454-4d52-8490-fb92b75a2d73"], Cell["\<\
To draw a line through a given point parallel to a given line.\
\>", "TableText",ExpressionUUID->"ee89de68-d8ef-4cb1-b38b-cb260ec579b6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "cb0575d9-fbd1-418d-87c2-758f8c8a998a"], Cell[
    "Hilbert", "TableText",ExpressionUUID->
     "c6fcc88f-baba-4d4c-bbdc-43a8c0894cd2"], Cell[
    "Group IV", "TableText",ExpressionUUID->
     "bddb4061-10cf-4130-907d-d26834c652c5"], Cell["\<\
Playfair's axiom: through a point not on a line there is exactly one parallel.\
\>", "TableText",ExpressionUUID->"fe48a7fe-38f9-425a-9dad-42e44562ef27"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "74645586-0238-483a-b998-69ac100b75a4"], Cell[
    "Tarski", "TableText",ExpressionUUID->
     "23285fee-0c18-46c1-bd1c-e90731fbaaf1"], Cell[
    "A10, Euclid's axiom", "TableText",ExpressionUUID->
     "bd7a5599-dc55-40ee-8f2f-ccdac4b9e27e"], Cell["\<\
The Euclidean axiom, stated with betweenness and equidistance.\
\>", "TableText",ExpressionUUID->"10c2f56a-6f38-4da7-829f-df9b09e57a77"]}
  }]], "3ColumnTableMod",ExpressionUUID->"1e428937-9760-422d-a348-\
