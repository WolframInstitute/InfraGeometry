Cell[TextData[{
 "Every parallel is a geodesic, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraParallelQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "02339964-8840-49e7-81e3-73c20e24431d"],
 " accepts it \[LongDash] as it accepts two concentric shells, which no \
geodesic could be."
}], "ExampleText",ExpressionUUID->"510df5cf-98d1-41cd-9ef9-acb14360dc83"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"row", " ", "=", " ", 
     RowBox[{"FindInfraParallel", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Range", "[", "5", "]"}], ",", " ", "13"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSegmentQ", "[", 
      RowBox[{"g", ",", " ", "row"}], "]"}], ",", " ", 
     RowBox[{"InfraParallelQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Range", "[", "5", "]"}], ",", " ", "row"}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"InfraParallelQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "13", ",", " ", "1"}], "]"}], ",", " ", 
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "13", ",", " ", "2"}], "]"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e5ca6525-c11d-47c3-bf26-7a8478174c6f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"aad60170-58f7-46e6-a717-73eba5efde39"]
}, Open  ]],

Cell["\<\
Parallelism runs both ways: the first row is the parallel to the third row \
through a vertex of the first.\
\>", "ExampleText",ExpressionUUID->"7ea0734b-830d-4e09-aea6-ba1e093904fb"],

