Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"799692b5-965b-4421-bcc8-13711e2d4ee1"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4483f496-6af5-4f54-8a00-4488fb56cb1c"], Cell["System", "TableText",
