      "af2b7ab2-f14d-4b06-8516-3531227b2946"]
    }], "TableText",ExpressionUUID->"1435ed3a-2ca2-4852-a376-7425fe2111b0"], 
    Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "674e14aa-4922-4cb6-b978-c81b3836eef9"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "827b771a-5b87-4c96-9fcb-e8146b90c66e"],
     " to ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3f63fb6f-d8d9-4572-a7f8-ef745a28c3c2"],
     ", a bounded or absent count to ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "614d8ed8-4ff0-4a60-b34f-95f82c4d9b9a"],
     ". The class is the same under every value; ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ed652678-6440-483e-a332-8c110a35b5e3"],
     " and ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3c40d860-6030-4b6a-a03d-883176b83ee2"],
     " take the end pairs and the branches of each DAG in candidate order, ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3414e323-8f63-457f-833c-6a82eafc01ac"],
     " in random order, seeded by an ambient ",
     Cell[BoxData["SeedRandom"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6e6d19ed-406d-4ed1-9cf9-0136807b44d1"],
     ". ",
