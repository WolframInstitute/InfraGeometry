Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"e7cf36b4-d02d-48be-8ae4-23df6961e055"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "93042548-5a01-4fa3-889f-96243cb0fd66"], Cell["System", "TableText",
     FontWeight->Bold,ExpressionUUID->"7e7fcbea-4751-4783-a0e9-96f9bf435232"],
