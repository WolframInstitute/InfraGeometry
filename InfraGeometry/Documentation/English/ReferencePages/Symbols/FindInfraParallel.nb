Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"4cb96aca-2f72-48a5-a80a-72a67cab7f87"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fb7b7f8c-65b2-4f1f-89be-87f4b19d44ab"], Cell["System", "TableText",
