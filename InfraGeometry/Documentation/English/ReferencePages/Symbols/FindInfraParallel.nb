Cell["\<\
The class is the same under every next-vertex function; only the order in \
which parallels come off the pool differs.\
\>", "ExampleText",ExpressionUUID->"03731804-f44c-401d-8c3f-27a414559cc5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "4"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
            " ", "2"}], " ", "&&", " ", 
           RowBox[{"!", " ", 
            RowBox[{"MemberQ", "[", 
             RowBox[{"line", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], 
        "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"SameQ", " ", "@@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"VertexList", " ", "/@", " ", 
         RowBox[{"FindInfraParallel", "[", 
          RowBox[{"g", ",", " ", "line", ",", " ", "p", ",", " ", 
           RowBox[{"UpTo", "[", "100", "]"}], ",", " ", 
           RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "#"}]}], 
          "]"}]}], "]"}], " ", "&"}], " ", "/@", "\n", "     ", 
      RowBox[{"{", 
       RowBox[{"Identity", ",", " ", "RandomSample"}], "}"}]}], ")"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"707d2628-992c-4bb6-b442-714070141139"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"acd86ffc-f445-4d42-bcb5-e56eebe73cc4"]
}, Open  ]]
