Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"c39b1b41-52b8-42bd-b2c9-60985b26c800"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7f98a38c-170e-4a25-bd32-bd6e99475001"], Cell["System", "TableText",
