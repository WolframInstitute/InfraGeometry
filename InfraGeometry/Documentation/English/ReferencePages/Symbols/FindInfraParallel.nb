Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"f3167359-6a14-4684-a820-e3ada1e7c55d"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e1503c9d-2e14-44b0-a97b-cafd2203de65"], Cell["System", "TableText",
