     Cell["Statement", "TableText",
     FontWeight->Bold,ExpressionUUID->"9431908e-2ed9-4285-b326-b6ff6d627391"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c07129cc-971a-4f24-b05b-51bdd23ff706"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "228cf720-3453-48f8-ae5e-97d4d5e2921c"], Cell[
    "Postulate 5", "TableText",ExpressionUUID->
     "cc91f31e-98c0-4a31-a084-4f77a2ccf6f8"], Cell["\<\
The parallel postulate: two lines cut by a transversal making internal angles \
less than two right angles meet on that side.\
\>", "TableText",ExpressionUUID->"18dce66b-3ae0-449c-a92e-c02e8e0177d7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "038cdc1c-74a9-402c-a828-d72bed22be1c"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "bb17ecd6-11fa-4cb8-ac31-51baf30f6ea9"], Cell[
    "Proposition I.31", "TableText",ExpressionUUID->
     "8e271211-37d8-4d47-9f1c-53cb620e3b9d"], Cell["\<\
To draw a line through a given point parallel to a given line.\
\>", "TableText",ExpressionUUID->"d18407ba-96a1-428e-8fb3-9d5d120a075e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b58daaa5-417a-4c85-aff1-4eda0d59cfa8"], Cell[
    "Hilbert", "TableText",ExpressionUUID->
     "153d5d66-9fab-43dc-9f45-c94ca2518aa9"], Cell[
    "Group IV", "TableText",ExpressionUUID->
     "edb44b70-35e1-409c-ab91-8aca0557bc66"], Cell["\<\
Playfair's axiom: through a point not on a line there is exactly one parallel.\
\>", "TableText",ExpressionUUID->"8b8789c5-8a6d-4b6b-87ee-d25346758c4a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7449f265-9b73-46bb-bbb0-e1435dc9b344"], Cell[
    "Tarski", "TableText",ExpressionUUID->
     "5de95d15-1ba0-4fff-b009-32aa3aadd39d"], Cell[
    "A10, Euclid's axiom", "TableText",ExpressionUUID->
     "7744b70e-3e31-45b7-a9a8-600611667e11"], Cell["\<\
The Euclidean axiom, stated with betweenness and equidistance.\
\>", "TableText",ExpressionUUID->"bff42780-4f4f-4f0e-bcc8-47eb10af0174"]}
  }]], "3ColumnTableMod",ExpressionUUID->"83ec8708-0009-40df-95be-\
