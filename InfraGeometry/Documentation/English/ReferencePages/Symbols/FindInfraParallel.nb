       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "4"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
            " ", "2"}], " ", "&&", " ", 
           RowBox[{"!", " ", 
            RowBox[{"MemberQ", "[", 
             RowBox[{"line", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], 
        "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"SameQ", " ", "@@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"VertexList", " ", "/@", " ", 
         RowBox[{"FindInfraParallel", "[", 
          RowBox[{"g", ",", " ", "line", ",", " ", "p", ",", " ", 
           RowBox[{"UpTo", "[", "100", "]"}], ",", " ", 
           RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "#"}]}], 
          "]"}]}], "]"}], " ", "&"}], " ", "/@", "\n", "     ", 
      RowBox[{"{", 
       RowBox[{"Identity", ",", " ", "RandomSample"}], "}"}]}], ")"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a415bcc2-25aa-4e1e-bd57-a79831342122"],

