   {Cell["      ", "ModInfo",ExpressionUUID->
     "35d56655-2c86-4e99-b7e0-b27898e6d49b"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "50e58087-ffa6-43d7-b0ec-b3e56a6555fd"], Cell[
    "Postulate 5", "TableText",ExpressionUUID->
     "b3693523-4d54-4884-b707-9a8ff24e3515"], Cell["\<\
The parallel postulate: two lines cut by a transversal making internal angles \
less than two right angles meet on that side.\
\>", "TableText",ExpressionUUID->"ccc4a090-6823-4ebc-875f-fe16096e9ead"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8ea2645d-00ac-4072-941b-9afd0c712b76"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "1555499a-8f77-4727-946a-b022639cdbe7"], Cell[
    "Proposition I.31", "TableText",ExpressionUUID->
     "159fb8bf-3a8c-466c-b409-a741e9d7ff97"], Cell["\<\
To draw a line through a given point parallel to a given line.\
\>", "TableText",ExpressionUUID->"24aa0406-969f-42de-9417-f3ff5d9f8bf2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9c7ee22a-3efe-47e7-a48b-207999243fa9"], Cell[
    "Hilbert", "TableText",ExpressionUUID->
     "81ebb90c-1aee-4f7e-86ca-c6e2de9df707"], Cell[
    "Group IV", "TableText",ExpressionUUID->
     "45fa827c-8732-41e2-a736-724d4675d890"], Cell["\<\
Playfair's axiom: through a point not on a line there is exactly one parallel.\
\>", "TableText",ExpressionUUID->"7bdc5784-16c0-4976-b4b2-fb1558efab8c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b0a0f5b7-7a68-4df4-ab92-e03cf713ca2d"], Cell[
    "Tarski", "TableText",ExpressionUUID->
