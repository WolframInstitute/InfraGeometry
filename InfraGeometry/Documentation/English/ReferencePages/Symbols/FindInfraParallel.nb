     "64a5e0c2-4774-4cf4-8bb0-2558cb848f1d"], Cell["\<\
The Euclidean axiom, stated with betweenness and equidistance.\
\>", "TableText",ExpressionUUID->"2353714b-fdf8-4c22-9b9a-514a45b66345"]}
  }]], "3ColumnTableMod",ExpressionUUID->"fd2f5cb3-e26f-4425-abb0-\
