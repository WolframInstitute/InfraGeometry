    }], "TableText",ExpressionUUID->"64891bbf-16f3-4b0a-8182-5ef2e652d2a1"], 
    Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6e809bc5-f84b-42aa-a6a1-456e4b6ccd29"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c9381cea-01b8-477f-beab-f6b85a023ff1"],
     " to ",
