Cell["\<\
A line through the centre of each substrate and a vertex at distance 4, and \
the parallels to it through a vertex at distance 2 off the line: one edge \
count per parallel.\
\>", "ExampleText",ExpressionUUID->"c8d0abe2-c3e7-4f8a-97d5-1ebc60942654"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{"far", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Sort", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"GraphDistance", "[", 
                RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==",
                " ", "4"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{"line", " ", "=", " ", 
         RowBox[{"FindInfraLine", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
       "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"p", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Sort", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"GraphDistance", "[", 
                 RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==",
                 " ", "2"}], " ", "&&", " ", 
               RowBox[{"!", " ", 
                RowBox[{"MemberQ", "[", 
                 RowBox[{"line", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], 
            "]"}]}]}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"EdgeCount", " ", "/@", " ", 
        RowBox[{"FindInfraParallel", "[", 
         RowBox[{"g", ",", " ", "line", ",", " ", "p", ",", " ", 
          RowBox[{"UpTo", "[", "10", "]"}]}], "]"}]}]}], "]"}]}], ",", "\n", 
    "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
