     FontWeight->Bold,ExpressionUUID->"d1bb79c2-1b72-4e44-8a5f-1e8b71b4a290"],
     Cell["Statement", "TableText",
     FontWeight->Bold,ExpressionUUID->"0d2686f9-b543-4c7a-80e5-40b25656335a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fa214d53-89d8-4f63-abba-7bd07b6216c0"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "6b46c135-5ff0-4049-8452-6952c7aa1dd8"], Cell[
    "Postulate 5", "TableText",ExpressionUUID->
     "6c1a15a6-2b08-41ed-ac1d-158c16a87c8d"], Cell["\<\
The parallel postulate: two lines cut by a transversal making internal angles \
less than two right angles meet on that side.\
\>", "TableText",ExpressionUUID->"6b77e9cf-fb4c-497e-b0f3-751ca83b0960"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a186307f-80ac-419a-9801-fab8e02d16ae"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "929a8a02-d82f-4e2d-ab9c-459da0cf2e73"], Cell[
    "Proposition I.31", "TableText",ExpressionUUID->
     "91aecbd9-1e2f-4e2b-a5de-c3194d4c74e8"], Cell["\<\
To draw a line through a given point parallel to a given line.\
\>", "TableText",ExpressionUUID->"1d675709-feb8-4067-9fd8-edc08c0df5c7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f483c77a-8443-4d24-94b2-31cc4e8dc0d1"], Cell[
    "Hilbert", "TableText",ExpressionUUID->
     "9e0e0dc6-7c2d-485e-8cd6-61c67dc4675c"], Cell[
    "Group IV", "TableText",ExpressionUUID->
     "201dc36e-ef24-45c8-b9c2-246d1affd9ee"], Cell["\<\
Playfair's axiom: through a point not on a line there is exactly one parallel.\
\>", "TableText",ExpressionUUID->"dda2b419-de00-45c6-b4c9-79b8ca70c726"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9b4063ab-e396-48dd-a3e4-917fb667171a"], Cell[
    "Tarski", "TableText",ExpressionUUID->
     "b545890b-8ef8-42ab-b428-7605a5185fc8"], Cell[
    "A10, Euclid's axiom", "TableText",ExpressionUUID->
     "8d8f0704-6210-4058-a22b-9a27971d3824"], Cell["\<\
The Euclidean axiom, stated with betweenness and equidistance.\
\>", "TableText",ExpressionUUID->"a4d0b26f-04c6-42d6-ad5c-caaefc99cfc9"]}
  }]], "3ColumnTableMod",ExpressionUUID->"73df3c87-3110-4140-a563-\
c3f0e5844dd0"]
