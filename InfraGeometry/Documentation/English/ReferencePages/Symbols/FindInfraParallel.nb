Cell["\<\
A line through the centre of each substrate and a vertex at distance 4, and \
the parallels to it through a vertex at distance 2 off the line: one edge \
count per parallel.\
\>", "ExampleText",ExpressionUUID->"f8f0843a-d7a8-4ac0-ac68-891e6cc57e10"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{"far", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Sort", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"GraphDistance", "[", 
                RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==",
                " ", "4"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{"line", " ", "=", " ", 
         RowBox[{"FindInfraLine", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
       "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"p", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Sort", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"GraphDistance", "[", 
                 RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==",
                 " ", "2"}], " ", "&&", " ", 
               RowBox[{"!", " ", 
                RowBox[{"MemberQ", "[", 
                 RowBox[{"line", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], 
            "]"}]}]}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"EdgeCount", " ", "/@", " ", 
        RowBox[{"FindInfraParallel", "[", 
         RowBox[{"g", ",", " ", "line", ",", " ", "p", ",", " ", 
          RowBox[{"UpTo", "[", "10", "]"}]}], "]"}]}]}], "]"}]}], ",", "\n", 
    "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"510619f0-9c6a-44fc-b0cb-2ed8dfe8489c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"SquareMeshGraph\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"4", ",", "5"}], "}"}]}], ",", 
   RowBox[{"\<\"SquareTilingGraph\"\>", "\[Rule]", 
    RowBox[{"{", "10", "}"}]}], ",", 
   RowBox[{"\<\"HexagonalTilingGraph\"\>", "\[Rule]", 
    RowBox[{"{", "1", "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"fcdff399-6ac0-48c0-9733-abd357a2ce7b"]
}, Open  ]],

Cell["The line and its one parallel on the square tiling.", "ExampleText",ExpressionUUID->"3f55f91b-8822-4403-a0ee-9781af48b9ce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "4"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
            " ", "2"}], " ", "&&", " ", 
           RowBox[{"!", " ", 
            RowBox[{"MemberQ", "[", 
             RowBox[{"line", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], 
        "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"line", " ", "->", " ", "$InfraLineColor"}], ",", "\n", 
       "     ", 
       RowBox[{
        RowBox[{"FindInfraParallel", "[", 
         RowBox[{"g", ",", " ", "line", ",", " ", "p"}], "]"}], " ", "->", 
        " ", "$InfraSegmentColor"}], ",", "\n", "     ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "p"}], "}"}], " ", "->", " ", 
        "$InfraPointColor"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "15"}], ",", "\n", 
     "    ", 
     RowBox[{"VertexShapeFunction", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
          RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}], ",",
      "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "340"}]}], "]"}]}], "]"}]], "Input",\

