    }], "TableText",ExpressionUUID->"a8e30802-c0a5-41c6-a0f8-5a9420ee8eef"], 
    Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4760818c-3a48-47c0-a545-a86a61e7ea08"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0dcc5fa5-532b-4037-b695-a124b953758f"],
     " to ",
