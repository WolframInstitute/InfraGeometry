     Cell["Statement", "TableText",
     FontWeight->Bold,ExpressionUUID->"de2cc25e-9a76-4449-9075-b2ad6bf29605"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e8ebd5dc-12d3-4049-81b7-77f40c41178a"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "0528b6f0-18b7-40c7-9dfa-0b720eac1728"], Cell[
    "Postulate 5", "TableText",ExpressionUUID->
     "feea5517-37eb-4251-a24b-8117cf0c64a8"], Cell["\<\
The parallel postulate: two lines cut by a transversal making internal angles \
less than two right angles meet on that side.\
\>", "TableText",ExpressionUUID->"82b6e427-dd65-435b-98fe-6a86ad87ad0a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ab427543-f1b7-4e7a-a1bb-54f5372c960a"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "a0dafcbc-e7ab-49c3-9264-e30ad6a3da42"], Cell[
    "Proposition I.31", "TableText",ExpressionUUID->
     "b0837d76-4b79-4b23-aaa7-927af1eb25d3"], Cell["\<\
To draw a line through a given point parallel to a given line.\
\>", "TableText",ExpressionUUID->"824c57f4-fe76-4f2f-97e2-6e1d8c038306"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e9d4d736-71b2-46ff-b7fa-e3d02f92015d"], Cell[
    "Hilbert", "TableText",ExpressionUUID->
     "60fa5d61-3f3c-4120-b0c1-684c92c97ebf"], Cell[
    "Group IV", "TableText",ExpressionUUID->
     "a5cfbc07-11d2-4ea2-b7ec-156719b6fc3a"], Cell["\<\
Playfair's axiom: through a point not on a line there is exactly one parallel.\
\>", "TableText",ExpressionUUID->"3aeef441-4b91-4f28-8d44-b77f3b622203"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7de8aaba-13e3-40a9-aeb6-6404cca633dc"], Cell[
    "Tarski", "TableText",ExpressionUUID->
     "7ded34db-5ada-4cd9-a371-e9d8db7371b9"], Cell[
    "A10, Euclid's axiom", "TableText",ExpressionUUID->
     "e1b360b2-92dc-477c-b91c-cb5273085f81"], Cell["\<\
The Euclidean axiom, stated with betweenness and equidistance.\
\>", "TableText",ExpressionUUID->"d5d8ff15-2b80-4668-9a45-bd9ce4034342"]}
  }]], "3ColumnTableMod",ExpressionUUID->"b3b53465-c1c7-4260-991c-\
