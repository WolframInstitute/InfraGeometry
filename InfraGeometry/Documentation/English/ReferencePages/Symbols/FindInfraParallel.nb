Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"a419e442-9286-4642-89b2-30ef92672ef3"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "38163b8f-a3e3-48eb-a44b-9686d4ef4d91"], Cell["System", "TableText",
     FontWeight->Bold,ExpressionUUID->"90f8a013-cfa5-4938-9748-08c4186edc72"],
