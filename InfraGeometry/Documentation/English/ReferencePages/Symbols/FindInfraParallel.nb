    }], "TableText",ExpressionUUID->"4d43a264-134d-4e15-ac22-9740fcee201f"], 
    Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2480094a-7219-43b9-a318-ebd96c10e881"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4443c8f8-095a-48c4-9b33-0da8690b8ded"],
     " to ",
