     FontWeight->Bold,ExpressionUUID->"666ae204-765d-4ad3-bd9f-82bb49fb32f3"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "11ce9ca3-ab43-424d-92be-1272f9e4cf45"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "22b5cbfe-9d89-44ac-bcaf-e923b7c67be7"], Cell[
    "Postulate 5", "TableText",ExpressionUUID->
     "0daaef42-4a14-439d-b9b2-e013bba0f6ae"], Cell["\<\
The parallel postulate: two lines cut by a transversal making internal angles \
less than two right angles meet on that side.\
\>", "TableText",ExpressionUUID->"ef4c44a7-075c-41e9-b138-6a4e29937f37"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3093440d-47a2-4226-8b60-7d251bfb0f8d"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "c794500a-5282-4942-8589-60ca300122bd"], Cell[
    "Proposition I.31", "TableText",ExpressionUUID->
     "248e1550-8d0e-4e1a-8ff8-37b266c95c1a"], Cell["\<\
To draw a line through a given point parallel to a given line.\
\>", "TableText",ExpressionUUID->"8bc52ad2-2353-4023-975e-d13e2b41de11"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0349f732-4cf3-4aef-ac59-69e59d1a7087"], Cell[
    "Hilbert", "TableText",ExpressionUUID->
     "73d30e7b-8846-4a77-8d98-cac1ba1e6122"], Cell[
    "Group IV", "TableText",ExpressionUUID->
     "676c7cba-8406-42e7-baad-b4b49b193923"], Cell["\<\
Playfair's axiom: through a point not on a line there is exactly one parallel.\
\>", "TableText",ExpressionUUID->"023eb1f3-4258-44ec-877d-2953d35b2fc7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "884c33e1-e941-483c-b730-849e8ce49351"], Cell[
