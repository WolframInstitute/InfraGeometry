   {Cell["      ", "ModInfo",ExpressionUUID->
     "f9f0d6d3-1dff-476a-9b02-8b4bd5fdd037"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "5e65bfb1-9a2a-4698-a0e9-986276590842"], Cell[
    "Postulate 5", "TableText",ExpressionUUID->
     "6595f329-8c10-4ec4-8e58-26cfc391a16c"], Cell["\<\
The parallel postulate: two lines cut by a transversal making internal angles \
less than two right angles meet on that side.\
\>", "TableText",ExpressionUUID->"cd7af326-30d9-4226-a520-8e329571dea7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1782a6fb-bc3b-43b2-ac94-12dd9f29233e"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "69286d32-a36b-4ae1-89e7-93c048342df6"], Cell[
    "Proposition I.31", "TableText",ExpressionUUID->
     "78f2ecea-ab94-4d10-93a0-529c575f8732"], Cell["\<\
To draw a line through a given point parallel to a given line.\
\>", "TableText",ExpressionUUID->"885371f8-1ef6-4122-9e80-2ed09d1dae47"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "425f6168-6cb0-45e2-99d9-b164d325bd81"], Cell[
    "Hilbert", "TableText",ExpressionUUID->
     "e8284f6f-2de9-4f5a-a033-a575e97bbf8a"], Cell[
    "Group IV", "TableText",ExpressionUUID->
     "3f9dd931-39c4-42cf-943e-41a9337d9fa6"], Cell["\<\
Playfair's axiom: through a point not on a line there is exactly one parallel.\
\>", "TableText",ExpressionUUID->"8527636d-0faf-4c87-86f3-d752760ae734"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5caded22-5759-47e3-973d-faa17d751155"], Cell[
