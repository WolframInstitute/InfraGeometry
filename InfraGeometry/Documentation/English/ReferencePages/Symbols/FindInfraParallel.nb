    }], "TableText",ExpressionUUID->"08fe4275-7308-4efd-adbc-de93b030f523"], 
    Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9be4e7a6-7875-474a-881d-dbb9810450e9"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7ade7fcb-28da-4e15-a657-8ce6302c834f"],
     " to ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "d8d251af-d69f-4245-b4da-f70bb17a2d07"],
     ", a bounded or absent count to ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f9612f75-e91f-40ba-8bea-9b6652862cb1"],
     ". The class is the same under every value; ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "d436d3b2-316e-486c-8c65-7f6e18a88205"],
     " and ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "28940e71-0d82-4581-a6c8-7ef2c1e7a04d"],
     " take the end pairs and the branches of each DAG in candidate order, ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "01c9feca-dcda-4815-8a12-69e16daf43fd"],
     " in random order, seeded by an ambient ",
     Cell[BoxData["SeedRandom"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c1459976-9765-4fce-b20b-a78dc6707349"],
     ". ",
     Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7c5e20c8-b54f-43ad-84cc-e829173617e8"],
     " is accepted and inert: the pool has no frontier to cap."
    }], "TableText",ExpressionUUID->"891cb4c3-ceb6-4ad0-8db9-8beec058772f"]},
