   {Cell["      ", "ModInfo",ExpressionUUID->
     "ce990a3a-0cca-4f05-8d81-f3d3f5429381"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "8ef824d4-cdb7-4e27-b094-77965323156b"], Cell[
    "Postulate 5", "TableText",ExpressionUUID->
     "475de861-e8db-4b1f-b2e0-731cb9cb4cc3"], Cell["\<\
The parallel postulate: two lines cut by a transversal making internal angles \
less than two right angles meet on that side.\
\>", "TableText",ExpressionUUID->"bc658d11-8f42-4e34-bef5-ab09bf8e6fb5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ae820b1d-772a-4c75-8f1b-bef1c381dbb4"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "9b47d3c8-0171-45cb-95ff-05dd052d19c6"], Cell[
    "Proposition I.31", "TableText",ExpressionUUID->
     "5f366084-bdb4-46f2-9683-88b4bfdbaa68"], Cell["\<\
To draw a line through a given point parallel to a given line.\
\>", "TableText",ExpressionUUID->"ff6a00c7-37d5-431c-a55b-b5819660f609"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0309f020-efd2-4ad2-acfc-55f8cffc68cc"], Cell[
    "Hilbert", "TableText",ExpressionUUID->
     "1c20b48b-f211-4a10-be2b-da057963aa62"], Cell[
    "Group IV", "TableText",ExpressionUUID->
     "4af74a37-676c-4c7c-b2b6-693505e83df9"], Cell["\<\
Playfair's axiom: through a point not on a line there is exactly one parallel.\
\>", "TableText",ExpressionUUID->"5cc1b1ff-f154-4bef-a05f-2d135f78ea12"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "70af6310-6452-4156-84c7-c261516a71ba"], Cell[
