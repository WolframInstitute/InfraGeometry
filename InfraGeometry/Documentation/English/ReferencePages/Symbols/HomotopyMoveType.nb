Cell["The three types:", "ExampleText",ExpressionUUID->"168316ab-7b54-4e1c-94c2-be84517a2551"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HomotopyMoveType", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"HomotopyMoveType", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"HomotopyMoveType", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "4", ",", " ", "3"}], "}"}]}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"117d599d-9da0-46ae-863a-a32da7b75bc9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Contract\"\>", ",", "\<\"Extend\"\>", ",", "\<\"Lateral\"\>"}],
   "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c769ac7f-0c87-425c-8198-1568fce68816"]
}, Open  ]],

Cell["\<\
The move across a filled square of the grid swaps two sides of equal length, \
a lateral move:\
\>", "ExampleText",ExpressionUUID->"49086411-0066-4d1b-92e1-dfc3584af9dd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"HomotopyMoveType", " ", "@@", " ", 
    RowBox[{"FindInfraHomotopy", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"First", " ", "@", " ", "members"}], ",", " ", 
      RowBox[{"Last", " ", "@", " ", "members"}], ",", " ", 
      RowBox[{"\"\<NullHomotopicCycles\>\"", " ", "->", " ", "4"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"af205b2d-8b63-4e39-aafc-61f9f5943965"],

Cell[BoxData["\<\"Lateral\"\>"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"016c24fd-64e0-44cf-9720-73135874a008"]
}, Open  ]]
}, Open  ]],

