Notebook[{

Cell[CellGroupData[{
Cell["HomotopyMoveType", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d6d1f1b7-b343-436a-b998-635ce52fd912"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HomotopyMoveType"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/HomotopyMoveType", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["w1", "TI"], ",", " ", 
    StyleBox["w2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e78b911-c2bc-484b-9ed1-02a9154775c3"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["\"\<Contract\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc76c454-6bdc-4694-8f0d-ce2425e4d84a"],
 ", ",
 Cell[BoxData["\"\<Extend\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8136e595-40c3-48f0-aaed-3227ad864ce4"],
 " or ",
 Cell[BoxData["\"\<Lateral\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd1ff6bb-7883-47a7-9e0a-e3ee881c082b"],
 " as the walk ",
 StyleBox["w2", "TI"],
 " is shorter than, longer than or as long as the walk ",
 StyleBox["w1", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"f3cb5e77-a1b6-4e51-ace6-8b3a1cc1b2b1"],

Cell[TextData[{
 "The type compares the numbers of vertices of the two walks: ",
 Cell[BoxData["\"\<Contract\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a57423b5-effe-4759-bc39-32d0aa1adb6f"],
 " when ",
 StyleBox["w2", "TI"],
 " has fewer, ",
 Cell[BoxData["\"\<Extend\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e42f22e-8479-43b1-b348-9378c1b87595"],
 " when it has more, ",
 Cell[BoxData["\"\<Lateral\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b92b89a4-cb95-4bce-b175-a5a50490033f"],
 " when they have the same number."
}], "Notes",ExpressionUUID->"0c21cdd7-3bab-4ac2-8b5c-8550a66ca7a2"],

Cell[TextData[{
 "It is meant for one elementary move of a homotopy chain. Deleting a \
repeated vertex or a backtrack contracts, inserting one extends. A face move \
replaces an arc of ",
 StyleBox["a", "TI"],
 " edges of a filled ",
 StyleBox["k", "TI"],
 "-cycle by the other ",
 StyleBox["k \[Minus] a", "TI"],
 ": it is lateral exactly when ",
 StyleBox["k = 2a", "TI"],
 ", so on a triangle it never is, and on a square of the grid swapping two \
sides is."
}], "Notes",ExpressionUUID->"09758c28-287b-4666-8757-10c524bf7670"],

Cell[TextData[{
 "The walks can be vertex lists or walk graphs. Only the lengths are \
compared; nothing checks that ",
 StyleBox["w2", "TI"],
 " is one move away from ",
 StyleBox["w1", "TI"],
 "."
}], "Notes",ExpressionUUID->"00bcb695-52c0-49f2-bc9e-cf107390e76e"]
}, Open  ]],

