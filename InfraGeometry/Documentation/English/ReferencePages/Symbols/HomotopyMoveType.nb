Cell["\<\
On the mesh a move across a triangle changes the length. The two shortest \
paths around a pair of triangles are joined by an extension and a contraction:\
\>", "ExampleText",ExpressionUUID->"bd9ee91c-9c47-4712-8ced-8d5d72bc413f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"chain", " ", "=", " ", 
     RowBox[{"FindInfraHomotopy", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"First", " ", "@", " ", "members"}], ",", " ", 
       RowBox[{"Last", " ", "@", " ", "members"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"HomotopyMoveType", "[", 
      RowBox[{
       RowBox[{"chain", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
       RowBox[{"chain", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"HomotopyMoveType", "[", 
      RowBox[{
       RowBox[{"chain", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
       RowBox[{"chain", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"efedbad5-e67f-43f5-a800-aaef604194fb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Extend\"\>", ",", "\<\"Contract\"\>"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"4b7ca746-9a7c-4bf0-af2a-1b6b1364798e"]
}, Open  ]]
}, Open  ]],

