Cell["\<\
On the mesh a move across a triangle changes the length. The two shortest \
paths around a pair of triangles are joined by an extension and a contraction:\
\>", "ExampleText",ExpressionUUID->"fafa700f-84f6-47c6-b94c-efc8f3eccffd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"chain", " ", "=", " ", 
     RowBox[{"FindInfraHomotopy", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"First", " ", "@", " ", "members"}], ",", " ", 
       RowBox[{"Last", " ", "@", " ", "members"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"HomotopyMoveType", "[", 
      RowBox[{
       RowBox[{"chain", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
       RowBox[{"chain", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"HomotopyMoveType", "[", 
      RowBox[{
       RowBox[{"chain", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
       RowBox[{"chain", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ca1c7d2f-ce1e-4308-8353-4de03a66c9a2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Extend\"\>", ",", "\<\"Contract\"\>"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a7bfcf0f-f167-4c00-b007-aa1536351ad5"]
}, Open  ]]
}, Open  ]],

