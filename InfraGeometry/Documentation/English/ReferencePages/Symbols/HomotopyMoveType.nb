Notebook[{

Cell[CellGroupData[{
Cell["HomotopyMoveType", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"69a08a10-6d65-42b1-b7b6-9ca54783673c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HomotopyMoveType"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/HomotopyMoveType", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["w1", "TI"], ",", " ", 
    StyleBox["w2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c87b32a-8f7a-4464-b45b-2229288a2543"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["\"\<Contract\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b966e12-56f8-428b-a115-44dc988a6cbd"],
 ", ",
 Cell[BoxData["\"\<Extend\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e038167-3ed1-4a1d-8f65-30cadb085cc5"],
 " or ",
 Cell[BoxData["\"\<Lateral\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6976f0b2-03a3-4531-9722-fa90de0c0ca1"],
 " as the walk ",
 StyleBox["w2", "TI"],
 " is shorter than, longer than or as long as the walk ",
 StyleBox["w1", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"6ee1eb73-5d62-4766-87a7-8dd69c9cfad6"],

Cell[TextData[{
 "The type compares the numbers of vertices of the two walks: ",
 Cell[BoxData["\"\<Contract\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cae09b32-067c-4fbf-b675-81fb92c432e3"],
 " when ",
 StyleBox["w2", "TI"],
 " has fewer, ",
 Cell[BoxData["\"\<Extend\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb5bbfb8-632c-45d2-bf62-60d78bb97a33"],
 " when it has more, ",
 Cell[BoxData["\"\<Lateral\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d3fc639-e095-4e97-b063-9aed182787c1"],
 " when they have the same number."
}], "Notes",ExpressionUUID->"167e9395-1693-49e0-b5dc-6992994bf6ef"],

Cell[TextData[{
 "It is meant for one elementary move of a homotopy chain. Deleting a \
repeated vertex or a backtrack contracts, inserting one extends. A face move \
replaces an arc of ",
 StyleBox["a", "TI"],
 " edges of a filled ",
 StyleBox["k", "TI"],
 "-cycle by the other ",
 StyleBox["k \[Minus] a", "TI"],
 ": it is lateral exactly when ",
 StyleBox["k = 2a", "TI"],
 ", so on a triangle it never is, and on a square of the grid swapping two \
sides is."
}], "Notes",ExpressionUUID->"6347e916-d7ba-4989-9868-fbdeb8d57d10"],

Cell[TextData[{
 "The walks can be vertex lists or walk graphs. Only the lengths are \
compared; nothing checks that ",
 StyleBox["w2", "TI"],
 " is one move away from ",
 StyleBox["w1", "TI"],
 "."
}], "Notes",ExpressionUUID->"94da25b5-e2b3-4205-8b6e-bcf1a4310325"]
}, Open  ]],

