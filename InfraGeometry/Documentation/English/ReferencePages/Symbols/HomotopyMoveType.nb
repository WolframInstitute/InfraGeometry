Cell["The three types:", "ExampleText",ExpressionUUID->"6363d70a-b3b9-45c2-ba9a-f4a499052b0d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HomotopyMoveType", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"HomotopyMoveType", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"HomotopyMoveType", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "4", ",", " ", "3"}], "}"}]}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"99af361a-9bf1-4e52-9e81-711868a5baa3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Contract\"\>", ",", "\<\"Extend\"\>", ",", "\<\"Lateral\"\>"}],
   "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0f7099f2-b5a8-4f20-88ca-0dcfaaf88f69"]
}, Open  ]],

Cell["\<\
The move across a filled square of the grid swaps two sides of equal length, \
a lateral move:\
\>", "ExampleText",ExpressionUUID->"8d06830e-1a1f-499e-ad7c-a5e3fb5c4eae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"HomotopyMoveType", " ", "@@", " ", 
    RowBox[{"FindInfraHomotopy", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"First", " ", "@", " ", "members"}], ",", " ", 
      RowBox[{"Last", " ", "@", " ", "members"}], ",", " ", 
      RowBox[{"\"\<NullHomotopicCycles\>\"", " ", "->", " ", "4"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"32e06263-44da-45d7-81f9-9ec6c255d594"],

Cell[BoxData["\<\"Lateral\"\>"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"08a95414-a511-4936-a762-5be5478108ad"]
}, Open  ]]
}, Open  ]],

