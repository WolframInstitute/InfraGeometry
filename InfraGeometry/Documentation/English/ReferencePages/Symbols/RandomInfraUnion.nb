Cell[CellGroupData[{
Cell["RandomInfraUnion", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2603b03a-3408-4541-8ac6-badfbdecfa5b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraUnion"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraUnion", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraUnion", "[", 
     RowBox[{
      StyleBox["obj1", "TI"], ",", " ", 
      StyleBox["obj2", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7522094-3e6e-4d87-b432-bca059cb7eb9"],
 "\[LineSeparator]",
 "samples one point from the union of complete operand supports on graph ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"84f32f6c-9d2f-4140-942a-f3e5a21a7d8d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraUnion"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraUnion", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraUnion", "[", 
     RowBox[{
      StyleBox["obj1", "TI"], ",", " ", 
      StyleBox["obj2", "TI"]}], "]"}], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df0cc3c2-c4c4-47cc-a547-03fc2f4951a1"],
 "\[LineSeparator]",
 "requests ",
 Cell[BoxData["count"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbd74858-14b3-4c7d-b9a4-018340a6c3b2"],
 " representatives. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d2be533-8b5b-4c34-8cf3-031c47ce6776"],
 " enumerates the full pool; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12597d07-5472-4f2a-9df9-ca2ad2f6ec98"],
 " returns at most ",
 StyleBox["n", "TI"],
 "."
}], "Usage",ExpressionUUID->"220cdc7a-90b0-4d8b-b501-51a30f4f88c5"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomInfraUnion", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"{", 
     RowBox[{"obj1", ",", " ", "obj2"}], "}"}], ",", " ", "count"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3974d930-fd0f-470d-b2ee-90ac226c77c9"],
 " uses the direct operand-list form."
}], "Notes",ExpressionUUID->"d9e28285-48d7-41d2-9f42-7148f27cbcd4"],

Cell[TextData[{
 "The sampler has the same token geometry as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6e78b363-0c74-4ba2-82cd-f473574c4f90"],
 ". An omitted or ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33740099-beba-4b5b-a4f0-81616cb099a4"],
 " count returns one representative. An integer count requests exactly that \
many distinct representatives and returns ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff7c4b21-e503-4802-894a-188e5922ce64"],
 " when too few exist."
}], "Notes",ExpressionUUID->"3858b173-46c1-4825-bd5b-92d55b6ece06"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24bac3d9-b770-4355-8571-4b77e08177e0"],
 " selects deterministically. Default ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a2d2960-845c-4534-a531-48789b8282de"],
 " does not advance random state. Seed an ordinary draw with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b08489f8-1072-4ac5-86d0-d3ec14206c8a"],
 "."
}], "Notes",ExpressionUUID->"fc434f8e-26ea-46d3-899e-f8eaa14ae57c"],

Cell[TextData[{
