Cell[TextData[{
 "On the square grid the closed arc through a vertex at distance ",
 StyleBox["r", "TI"],
 ", with the band {",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["r", "TI"],
 " + 1}, is one circle of length ",
 StyleBox["8r", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"2837da3f-503b-4c20-89dd-195c8f668c04"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraArc", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraShell", "[", 
             RowBox[{"c", ",", " ", "r"}], "]"}], ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], "}"}], ",",
          " ", 
         RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "1"}]}], "]"}], ",", 
       "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"\"\<Cardinality\>\"", ",", " ", "\"\<Length\>\""}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "1", ",", " ", "7"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"eeb83685-c766-47e6-8a80-18c5876a94b7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Cardinality\"\>", "\[Rule]", "1"}], ",", 
     RowBox[{"\<\"Length\"\>", "\[Rule]", "8"}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Cardinality\"\>", "\[Rule]", "1"}], ",", 
     RowBox[{"\<\"Length\"\>", "\[Rule]", "16"}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Cardinality\"\>", "\[Rule]", "1"}], ",", 
     RowBox[{"\<\"Length\"\>", "\[Rule]", "24"}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Cardinality\"\>", "\[Rule]", "1"}], ",", 
     RowBox[{"\<\"Length\"\>", "\[Rule]", "32"}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Cardinality\"\>", "\[Rule]", "1"}], ",", 
     RowBox[{"\<\"Length\"\>", "\[Rule]", "40"}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Cardinality\"\>", "\[Rule]", "1"}], ",", 
     RowBox[{"\<\"Length\"\>", "\[Rule]", "48"}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Cardinality\"\>", "\[Rule]", "1"}], ",", 
     RowBox[{"\<\"Length\"\>", "\[Rule]", "56"}]}], "\[RightAssociation]"}]}],
   "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"091f6461-2eb0-4a1c-b5d9-8af53cc44255"]
}, Open  ]],

Cell[TextData[{
 "The closed arc through ",
 StyleBox["p", "TI"],
 " has the circles of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6084225d-089d-448b-95a1-d8609d9d8f3a"],
 " that pass through ",
 StyleBox["p", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"a7c4ac4c-d715-45e7-8967-b80dac4f8fe3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"closed", " ", "=", " ", 
     RowBox[{"RandomInfraArc", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraArc", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"{", "p", "}"}], ",", " ", 
         RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "1"}]}], "]"}], ",", 
       " ", "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circles", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"RandomInfraCircle", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCircle", "[", 
          RowBox[{"c", ",", " ", 
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", "All"}], 
        "]"}], ",", " ", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{"#", ",", " ", "p"}], "]"}], " ", "&"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", "[", 
     RowBox[{"Sort", " ", "/@", " ", "closed"}], "]"}], " ", "===", " ", 
    RowBox[{"Sort", "[", 
     RowBox[{"Sort", " ", "/@", " ", "circles"}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"47359068-d3b3-4a6f-9090-b0f0e20e4fdd"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"1efdab5d-d4b0-4735-a237-998bdfabbdbf"]
