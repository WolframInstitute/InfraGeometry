Cell[TextData[{
 "The closed arc: the circles through a vertex at distance 2 from the centre, \
the band of ",
 StyleBox["p", "TI"],
 " widened two steps outward, on the square, hexagonal and triangular tilings."
}], "ExampleText",ExpressionUUID->"731ff4ff-ee65-47ba-9d52-d99597d2e50b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraArc", "[", 
            RowBox[{"c", ",", " ", 
             RowBox[{"{", "p", "}"}], ",", " ", 
             RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "2"}]}], "]"}], 
           " ", "->", " ", "$InfraCircleColor"}], ",", " ", 
          RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c", 
          ",", " ", "p"}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"db148a4a-d9a7-4c6d-aca5-895257a1a13b"],

