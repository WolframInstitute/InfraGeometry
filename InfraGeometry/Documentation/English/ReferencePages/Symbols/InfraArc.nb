Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "50e5eac3-da56-4996-9ba8-674939e6e211"],
 " searches the band directly and finds the same arcs."
}], "ExampleText",ExpressionUUID->"111ce14f-bf30-4a15-9a74-d6ac82320a49"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"found", " ", "=", " ", 
     RowBox[{"FindInfraArc", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "q"}], "}"}], ",", " ", "All", ",", " ", 
       RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}]}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"found", " ", "->", " ", "$InfraCircleColor"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c", ",",
          " ", "p", ",", " ", "q"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", "found"}], " ", "===", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"FindInfraRepresentative", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraArc", "[", 
          RowBox[{"c", ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "q"}], "}"}], ",", " ", 
           RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "1"}], "}"}]}]}], "]"}], ",", " ", 
         "All"}], "]"}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f656a1cb-b580-42db-ab1d-fa5425f81083"],

