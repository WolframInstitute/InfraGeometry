Cell["\<\
The two half-rings between antipodes of the radius-2 hexagon of the \
triangular tiling.\
\>", "ExampleText",ExpressionUUID->"bf104771-6962-48f6-9509-14935e7dd852"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ring", " ", "=", " ", 
     RowBox[{"FindInfraShell", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", "ring"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{"ring", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{
            RowBox[{"Subgraph", "[", 
             RowBox[{"g", ",", " ", "ring"}], "]"}], ",", " ", "p", ",", " ", 
            "#"}], "]"}], " ", "==", " ", "6"}], " ", "&"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"arc", " ", "=", " ", 
     RowBox[{"InfraArc", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "q"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"arc", " ", "->", " ", "$InfraCircleColor"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c", ",",
          " ", "p", ",", " ", "q"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "arc", ",", " ", "\"\<Cardinality\>\""}], "]"}], 
     ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "arc", ",", " ", "\"\<Length\>\""}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"e0ad3d96-3f71-4041-8aab-740cefd097d5"],

