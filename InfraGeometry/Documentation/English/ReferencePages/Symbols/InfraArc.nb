Cell["\<\
On the square tiling, the number of these circles and their length, beside \
the picture.\
\>", "ExampleText",ExpressionUUID->"93295fba-b46c-4fb8-b8a5-4afe7411eac6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"InfraArc", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "p"}], "}"}], ",", " ", 
       RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "2"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"circle", ",", " ", "c", ",", " ", "p"}], "}"}]}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "circle", ",", " ", "\"\<Cardinality\>\""}], 
      "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "circle", ",", " ", "\"\<Length\>\""}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"2046c56c-dba9-45e9-a1fd-acb6a60bf622"],

