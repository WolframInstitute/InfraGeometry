Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d92877b1-d300-45e4-8ead-8de7cb494a2a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
