Cell["RadiusDelta", "ExampleSubsection",ExpressionUUID->"d9f2e82f-2938-4bec-82f1-6971cbfc6cf4"],

Cell["\<\
The bare shell of the grid carries no arc. The band {3, 4} carries one, the \
band {2, 4} a shorter family that cuts inside:\
\>", "ExampleText",ExpressionUUID->"7260137c-6550-4691-a5aa-62e55face3e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"pq", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "2", ",", " ", 
       RowBox[{"\"\<PairwiseDistance\>\"", " ", "->", " ", "\"\<Max\>\""}], ",",
        " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraArc", "[", 
           RowBox[{"c", ",", " ", "pq", ",", " ", 
            RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "delta"}]}], "]"}],
           ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "pq"}], "}"}], ",", 
        "\n", "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraArc", "[", 
            RowBox[{"c", ",", " ", "pq", ",", " ", 
             RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "delta"}]}], 
            "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<Cardinality\>\"", ",", " ", "\"\<Length\>\""}], 
            "}"}]}], "]"}]}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"delta", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1", ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}]}], "}"}]}], "]"}]}]}],
   "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4b6e04e5-5be5-4484-b2ff-589a3bb50e44"],

