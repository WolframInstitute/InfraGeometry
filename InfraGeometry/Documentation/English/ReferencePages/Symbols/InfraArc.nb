Cell[TextData[{
 "Every circle through ",
 StyleBox["p", "TI"],
 ", found by the search, each drawn as its directed cycle."
}], "ExampleText",ExpressionUUID->"8853a856-ecaf-43ce-b8a6-07695c4499d6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"allCircles", " ", "=", " ", 
     RowBox[{"RandomInfraArc", "[", " ", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraArc", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "p"}], "}"}], ",", " ", 
         RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "2"}]}], "]"}], ",", 
       " ", "All"}], " ", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Graph", "[", 
            RowBox[{"DirectedEdge", " ", "@@@", " ", 
             RowBox[{"Partition", "[", 
              RowBox[{
              "oneCircle", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], 
              "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"oneCircle", ",", " ", "allCircles"}], "}"}]}], "]"}], ",",
          " ", "c", ",", " ", "p"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Length", " ", "@", " ", "allCircles"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"67bbc3e3-69d8-428f-a145-eb6da33b43ba"],

