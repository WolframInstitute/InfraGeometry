Notebook[{

Cell[CellGroupData[{
Cell["InfraArc", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d5f6263d-3182-41a5-b68e-4afbacb4dd41"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac5421c3-4dea-4a65-9667-acd39f094a2a"],
 "\[LineSeparator]",
 "is the arc around ",
 StyleBox["c", "TI"],
 " from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ": the minor arcs of the circle through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ". It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "adbbd11e-e69f-445a-8433-f3873a6689ed"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6d780e2b-6be0-42c8-b54a-dbb8e1bd08d4"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"875879ec-91c6-45f1-bdf5-9e6997cada8f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pk", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01cf5ade-8463-45ab-aa69-bffbbd9da26a"],
 "\[LineSeparator]",
 "is the polyline of the minor arcs from each point to the next.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e8aeb11c-ed50-4a4f-97d5-adab3cd854dc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f264f4d-ec9d-4550-b8e3-f91ed77aad8e"],
 "\[LineSeparator]",
 "is the closed arc: the circles around ",
 StyleBox["c", "TI"],
 " through ",
 StyleBox["p", "TI"],
 ". ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     StyleBox["p", "TI"], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "adfceab9-26de-4a47-8901-97b21fdca3ce"],
 " is its shorthand, and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pk", "TI"], ",", " ", 
      StyleBox["p1", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "735959ce-189f-440e-8735-b0f51d11b7fe"],
 " the circles through all the points."
}], "Usage",ExpressionUUID->"0ad14c3b-a5fd-4c48-a92a-de83f1a65632"],

Cell[TextData[{
 "Definition: with ",
 StyleBox["r", "TI"],
 " = ",
 StyleBox["d(c, p)", "TI"],
 ", the band ",
 StyleBox["W", "TI"],
 " is the shell { ",
 StyleBox["v", "TI"],
 " : ",
 StyleBox["d(c, v)", "TI"],
 " = ",
 StyleBox["r", "TI"],
 " }, widened by ",
 Cell[BoxData["\"\<RadiusDelta\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5891d54d-c2df-4f89-a97e-c086211c6b64"],
 ". A minor arc from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is a shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " of the subgraph induced on ",
 StyleBox["W", "TI"],
 "."
}], "Notes",ExpressionUUID->"1320547a-603d-4e4f-962f-74d7bee3d284"],

Cell[TextData[{
 "Option ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b2c3a25-1627-44e8-bbf5-2c1da8ced363"],
 " widens the band to ",
 StyleBox["r", "TI"],
 " \[Minus] ",
 StyleBox["deltaIn", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["r", "TI"],
 " + ",
 StyleBox["deltaOut", "TI"],
 ". A scalar ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "delta"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fb9c93a-6e76-4d88-a9eb-d15dadb18016"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "361e4500-4807-4f9a-8be2-ffc0f33f5800"],
 ", outward only. The default is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42e9ad03-0223-4d3f-a171-0268946941fd"],
 "."
}], "Notes",ExpressionUUID->"cc711422-b364-4466-a859-cb3fc020acea"],

Cell[TextData[{
 "Its graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["arc", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4761ea9f-d791-4257-8335-48c1afd40e02"],
 " \[LongDash] is the interval of shortest paths of the band from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", with arrows of rising band distance from ",
 StyleBox["p", "TI"],
 ". It is the same object ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c5b96276-c915-4798-b10d-1706d8069f50"],
 " is on the whole graph. Its chains are those shortest paths, all of one \
length."
}], "Notes",ExpressionUUID->"1f2df3a9-540e-4dbe-ad97-e89b52bb6dac"],

Cell[TextData[{
 "That they are exactly the minor arcs needs the winding functional on the \
substrate, and ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " on a common circle. Nothing here certifies either, so ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "454cf896-5ded-4730-a5b1-17d4c576da46"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f693d894-979e-44a9-9fd5-6480c1365df7"],
 "."
}], "Notes",ExpressionUUID->"71e8d607-9ac8-4666-a31c-9b4d4e94df74"],

Cell[TextData[{
 "The arc is empty when ",
 StyleBox["q", "TI"],
 " leaves the band or the band disconnects ",
 StyleBox["p", "TI"],
 " from ",
 StyleBox["q", "TI"],
 ". On a lattice the bare shell has no two adjacent vertices, so it joins no \
two of its points: widen the band."
}], "Notes",ExpressionUUID->"f282b534-8837-4e57-9448-04df388b89b7"],

Cell[TextData[{
 StyleBox["An arc need not be unique.",
  FontWeight->"Bold"],
 " Between two points of a band there are in general many shortest paths, and \
through a point many circles; a trailing count of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b3861b78-6729-4491-a2df-a53f863e6e40"],
 " gives them all."
}], "Notes",ExpressionUUID->"d7085555-611e-4f58-aaf5-3041fce116d5"],

Cell[TextData[{
 StyleBox["The closed arc.",
  FontWeight->"Bold"],
 " A list that returns to its first point names a closed arc, not a polyline \
there and back. It is the circle through ",
 StyleBox["p", "TI"],
 ", the compass opened to ",
 StyleBox["p", "TI"],
 " (Euclid's third postulate): ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}], ",", " ", 
    RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
     StyleBox["delta", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a17d762-4f90-44c2-a88b-5e0f2d7a2556"],
 " has the members of the circle of the band of ",
 StyleBox["p", "TI"],
 " that pass through ",
 StyleBox["p", "TI"],
 ". It is not empty, though a shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["p", "TI"],
 " is trivial: its members are cycles that leave ",
 StyleBox["p", "TI"],
 " and return to ",
 StyleBox["p", "TI"],
 " around ",
 StyleBox["c", "TI"],
 ", separating ",
 StyleBox["c", "TI"],
 " from everything beyond the band. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00cd49f8-9f7d-410e-8fae-607034c33012"],
 " keeps those that pass through ",
 StyleBox["q", "TI"],
 " too. Its members are cyclic vertex lists whose first vertex is not \
repeated, and its ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2907779e-56c7-4751-b2f3-2e66245ffe85"],
 " counts the closing edge."
}], "Notes",ExpressionUUID->"4240a99b-54bb-467f-908b-8a1f6ee3cdc0"],

Cell[TextData[{
 "Its graph is the circle's shape: the atom at ",
 StyleBox["p", "TI"],
 " of the band unrolled along a seam through ",
 StyleBox["p", "TI"],
 ", a DAG from ",
 StyleBox["p", "TI"],
 " to a copy ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"p", ",", " ", 
    RowBox[{"3", "/", "2"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b0ac231-7e81-45c5-b07f-8afb1071c8e4"],
 " of ",
 StyleBox["p", "TI"],
 " whose chains are the circles through ",
 StyleBox["p", "TI"],
 ". It is that atom only where the unrolled band applies (its cut band is \
connected and its seam has two sides) and ",
 StyleBox["p", "TI"],
 " lies on a circle of its band. Off a circle the paths of the unrolled band \
from ",
 StyleBox["p", "TI"],
 " to its copy include closed walks that run out to a circle and back, which \
are no circles, so the graph is the necklaces of that seam whose run meets ",
 StyleBox["p", "TI"],
 ", again closed on a copy ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"s1", ",", " ", 
    RowBox[{"3", "/", "2"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9c88b4d-b2f3-415b-bd95-9cdda11eb95f"],
 " of their source. Where the unrolled band does not apply the graph is those \
necklaces too. A necklace needs the circle to meet its seam in one run, so it \
can miss a circle."
}], "Notes",ExpressionUUID->"9adf7e47-9f3e-4f01-a1e1-3f13c501d77d"],

Cell[TextData[{
 "On a bipartite substrate the bare shell has no circle: use ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48a65b62-891d-4f7c-b83b-7b8c8606c88a"],
 "."
}], "Notes",ExpressionUUID->"223f9048-a8a5-416f-8ce8-59cc4fbf63e8"],

Cell[TextData[{
 "A list that does not return to its first point is the open polyline, as \
before; a point repeated in a row inside it counts once, so ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef7388f0-222e-4b76-ad3b-0a7898767e6a"],
 " is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eb745d8-e9b5-4492-9049-cfe9b1c983a5"],
 "."
}], "Notes",ExpressionUUID->"fbb40640-9ddf-45b5-a33b-ec88598362bc"],

Cell[TextData[{
 "A polyline arc reads each piece on the band of the circle through its own \
first point. Its members concatenate one arc per piece, so its ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a8c6c6d-80bf-4ca8-a35b-bc0a55638c64"],
 " is the product over the pieces. Through an intermediate point ",
 StyleBox["m", "TI"],
 " at the radius of ",
 StyleBox["p", "TI"],
 " that lies on a minor arc from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", the members of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09002172-a461-44e0-9d21-97198967d8fc"],
 " are the minor arcs from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " through ",
 StyleBox["m", "TI"],
 "."
}], "Notes",ExpressionUUID->"262108c4-3fd0-4c60-88d5-f5fcfafba831"],

Cell[TextData[{
 StyleBox["The search.",
  FontWeight->"Bold"],
 " On an open arc, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "833723a6-071e-4d98-bc8b-9462713c9016"],
 " reads the members off the graph. On a closed arc it sweeps the band \
directly: for ",
 StyleBox["k", "TI"],
 " = 3, 4, \[Ellipsis] it takes every cycle of length ",
 StyleBox["k", "TI"],
 " of the band (",
 Cell[BoxData["FindCycle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e01341ab-64a3-4de0-86f4-c7a95a01a742"],
 ") and keeps those through ",
 StyleBox["p", "TI"],
 " whose removal leaves ",
 StyleBox["c", "TI"],
 " in a component reaching no further than the band; the first ",
 StyleBox["k", "TI"],
 " with a survivor gives the circles, and the members are those through every \
point of the list. It does not read the graph, so it is the check on it. Each \
length is enumerated in full before the filter, so the sweep is fast on a \
band one or two vertices thick and slow on a wide one."
}], "Notes",ExpressionUUID->"c5dd399d-80db-4be9-8e12-774eb19132a4"]
}, Open  ]],

Cell[CellGroupData[{

