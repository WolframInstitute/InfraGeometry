Cell["\<\
The closed arc through a point at distance 3. On the grid it is one circle, \
on the mesh many:\
\>", "ExampleText",ExpressionUUID->"216dfaf6-793d-4a33-a7db-c53f6f31e603"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"circle", " ", "=", " ", 
        RowBox[{"InfraArc", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{"{", "p", "}"}], ",", " ", 
          RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "1"}]}], "]"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"circle", ",", " ", "c", ",", " ", "p"}], "}"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", "circle", ",", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<Cardinality\>\"", ",", " ", "\"\<Length\>\""}], 
            "}"}]}], "]"}]}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"c78061d1-5a48-4fb6-80d8-1746f87b3bcf"],

