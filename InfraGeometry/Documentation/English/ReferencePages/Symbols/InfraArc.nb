Notebook[{

Cell[CellGroupData[{
Cell["InfraArc", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"caa31cf7-39b5-4e87-a621-4f9ef6633679"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b8cf006-8345-4968-b29d-a5fc9e9e1318"],
 "\[LineSeparator]",
 "is the arc around ",
 StyleBox["c", "TI"],
 " from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ": the minor arcs of the circle through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ". It is a symbolic object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ae3f9313-8097-4e0d-9a59-37c6da419c62"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "48f7288b-d2a8-4ba3-95da-8e6b57113d7c"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"99d46091-a4ad-431e-907f-53924c4b3d10"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pk", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b880ab81-f0f9-41c2-bf4a-595f4e148f03"],
 "\[LineSeparator]",
 "is the polyline of the minor arcs from each point to the next.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"196760dd-7eaf-41fe-9f2e-753b1bf5c704"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d831044-b20f-4446-9a64-8f00a68bd055"],
 "\[LineSeparator]",
 "is the closed arc: the circles around ",
 StyleBox["c", "TI"],
 " through ",
 StyleBox["p", "TI"],
 ". ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     StyleBox["p", "TI"], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e121e997-1c08-46ed-bf84-226df4cec934"],
 " is its shorthand, and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pk", "TI"], ",", " ", 
      StyleBox["p1", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bf7028e-ef55-4738-8d44-05f5ba1db7b4"],
 " the circles through all the points."
}], "Usage",ExpressionUUID->"3add5efe-2942-4db4-8348-d7c43c9e828c"],

Cell[TextData[{
 "Definition: with ",
 StyleBox["r", "TI"],
 " = ",
 StyleBox["d(c, p)", "TI"],
 ", the band ",
 StyleBox["W", "TI"],
 " is the shell { ",
 StyleBox["v", "TI"],
 " : ",
 StyleBox["d(c, v)", "TI"],
 " = ",
 StyleBox["r", "TI"],
 " }, widened by ",
 Cell[BoxData["\"\<RadiusDelta\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9951185b-97b2-4532-903d-2a9bcdc8e619"],
 ". A minor arc from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is a shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " of the subgraph induced on ",
 StyleBox["W", "TI"],
 "."
}], "Notes",ExpressionUUID->"955900a0-3ae2-49f8-a862-f122eca8ee3b"],

Cell[TextData[{
 "Option ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b732013d-7a87-4431-b3c3-041dd564b78a"],
 " widens the band to ",
 StyleBox["r", "TI"],
 " \[Minus] ",
 StyleBox["deltaIn", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["r", "TI"],
 " + ",
 StyleBox["deltaOut", "TI"],
 ". A scalar ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "delta"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8fb44ac4-2a51-44eb-848a-90a45d532032"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9696e0c5-2751-4642-9e78-c52508741a52"],
 ", outward only. The default is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dca46387-c677-496c-8a27-3417a22aa431"],
 "."
}], "Notes",ExpressionUUID->"6294974b-dc97-42a9-a111-39cb62a711dd"],

Cell[TextData[{
 "Its graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["arc", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fe14aed-054c-497d-b6ee-af0fb789e782"],
 " \[LongDash] is the interval of shortest paths of the band from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", with arrows of rising band distance from ",
 StyleBox["p", "TI"],
 ". It is the same object ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "17fbb5d5-0809-4d3f-b5a0-3372c20d83e8"],
 " is on the whole graph. Its chains are those shortest paths, all of one \
length."
}], "Notes",ExpressionUUID->"7e609421-6d2a-462f-85ae-24b828933741"],

Cell[TextData[{
 "That they are exactly the minor arcs needs the winding functional on the \
substrate, and ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " on a common circle. Nothing here certifies either, so ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8bc92a76-0407-43b4-adc4-35a67cb1222f"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6dcb4cbe-33a2-4ec7-9692-35fdeb9c1817"],
 "."
}], "Notes",ExpressionUUID->"d183d0bf-7e66-4a3f-8a27-939a99afa01c"],

Cell[TextData[{
 "The arc is empty when ",
 StyleBox["q", "TI"],
 " leaves the band or the band disconnects ",
 StyleBox["p", "TI"],
 " from ",
 StyleBox["q", "TI"],
 ". On a lattice the bare shell has no two adjacent vertices, so it joins no \
two of its points: widen the band."
}], "Notes",ExpressionUUID->"12a5d821-8551-482e-b6f8-0f657682c0bb"],

Cell[TextData[{
 StyleBox["An arc need not be unique.",
  FontWeight->"Bold"],
 " Between two points of a band there are in general many shortest paths, and \
through a point many circles; a trailing count of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "140b7361-0521-4376-80d6-9699da2be0fd"],
 " gives them all."
}], "Notes",ExpressionUUID->"2a10ef07-bad0-4040-9a27-7b46b04d8a51"],

Cell[TextData[{
 StyleBox["The closed arc.",
  FontWeight->"Bold"],
 " A list that returns to its first point names a closed arc, not a polyline \
there and back. It is the circle through ",
 StyleBox["p", "TI"],
 ", the compass opened to ",
 StyleBox["p", "TI"],
 " (Euclid's third postulate): ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}], ",", " ", 
    RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
     StyleBox["delta", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0da460b3-afcb-4cad-a6ac-7e90e3694593"],
 " has the members of the circle of the band of ",
 StyleBox["p", "TI"],
 " that pass through ",
 StyleBox["p", "TI"],
 ". It is not empty, though a shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["p", "TI"],
 " is trivial: its members are cycles that leave ",
 StyleBox["p", "TI"],
 " and return to ",
 StyleBox["p", "TI"],
 " around ",
 StyleBox["c", "TI"],
 ", separating ",
 StyleBox["c", "TI"],
 " from everything beyond the band. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6f77c13-558a-458b-8434-f18410123cdd"],
 " keeps those that pass through ",
 StyleBox["q", "TI"],
 " too. Its members are cyclic vertex lists whose first vertex is not \
repeated, and its ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e6aadcc-decf-4ef6-ab27-0c44c56ca29d"],
 " counts the closing edge."
}], "Notes",ExpressionUUID->"218812fa-9be9-4d25-903b-7da2c09a99c3"],

Cell[TextData[{
 "Its graph is the circle's shape: the atom at ",
 StyleBox["p", "TI"],
 " of the band unrolled along a seam through ",
 StyleBox["p", "TI"],
 ", a DAG from ",
 StyleBox["p", "TI"],
 " to a copy ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"p", ",", " ", 
    RowBox[{"3", "/", "2"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0c29562-d79f-4c7f-a7b8-6df0c8f063ae"],
 " of ",
 StyleBox["p", "TI"],
 " whose chains are the circles through ",
 StyleBox["p", "TI"],
 ". It is that atom only where the unrolled band applies (its cut band is \
connected and its seam has two sides) and ",
 StyleBox["p", "TI"],
 " lies on a circle of its band. Off a circle the paths of the unrolled band \
from ",
 StyleBox["p", "TI"],
 " to its copy include closed walks that run out to a circle and back, which \
are no circles, so the graph is the necklaces of that seam whose run meets ",
 StyleBox["p", "TI"],
 ", again closed on a copy ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"s1", ",", " ", 
    RowBox[{"3", "/", "2"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "094f10bd-7bdd-4a45-8f1f-9a6aaa6722e9"],
 " of their source. Where the unrolled band does not apply the graph is those \
necklaces too. A necklace needs the circle to meet its seam in one run, so it \
can miss a circle."
}], "Notes",ExpressionUUID->"e1b13d07-5220-4e43-ac7a-8f5b86cd2e2e"],

Cell[TextData[{
 "On a bipartite substrate the bare shell has no circle: use ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e3fc813-5664-42f3-9e6d-fad646f280a7"],
 "."
}], "Notes",ExpressionUUID->"49829b06-dc91-4d16-9da1-a347af428e02"],

Cell[TextData[{
 "A list that does not return to its first point is the open polyline, as \
before; a point repeated in a row inside it counts once, so ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "709aff8c-e84e-43fc-9c9d-f22eee1ed9bd"],
 " is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fcfb4e51-2d50-4d0e-9e50-4d2108b04be9"],
 "."
}], "Notes",ExpressionUUID->"9000bfb6-e688-4a20-956b-71bfd5af8171"],

Cell[TextData[{
 "A polyline arc reads each piece on the band of the circle through its own \
first point. Its members concatenate one arc per piece, so its ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8ff31c9-7cf1-4b92-84f0-cf094a82da16"],
 " is the product over the pieces. Through an intermediate point ",
 StyleBox["m", "TI"],
 " at the radius of ",
 StyleBox["p", "TI"],
 " that lies on a minor arc from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", the members of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1b07af8-573c-49eb-8194-bc526f8fa3aa"],
 " are the minor arcs from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " through ",
 StyleBox["m", "TI"],
 "."
}], "Notes",ExpressionUUID->"19d07842-18ed-4342-bc4c-16bb5fa31fd7"],

Cell[TextData[{
 StyleBox["The search.",
  FontWeight->"Bold"],
 " On an open arc, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "707ce2f5-c6ac-4be3-9eec-19522f3899d5"],
 " reads the members off the graph. On a closed arc it sweeps the band \
directly: for ",
 StyleBox["k", "TI"],
 " = 3, 4, \[Ellipsis] it takes every cycle of length ",
 StyleBox["k", "TI"],
 " of the band (",
 Cell[BoxData["FindCycle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fab82b03-6d57-427e-b20a-d68ac327a00e"],
 ") and keeps those through ",
 StyleBox["p", "TI"],
 " whose removal leaves ",
 StyleBox["c", "TI"],
 " in a component reaching no further than the band; the first ",
 StyleBox["k", "TI"],
 " with a survivor gives the circles, and the members are those through every \
point of the list. It does not read the graph, so it is the check on it. Each \
length is enumerated in full before the filter, so the sweep is fast on a \
band one or two vertices thick and slow on a wide one."
}], "Notes",ExpressionUUID->"ada6fa7c-e306-4c09-bd43-567e999c4fd0"]
}, Open  ]],

Cell[CellGroupData[{

