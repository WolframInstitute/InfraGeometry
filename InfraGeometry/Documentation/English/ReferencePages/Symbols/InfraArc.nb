Notebook[{

Cell[CellGroupData[{
Cell["InfraArc", "ObjectName",ExpressionUUID->"ded9a3fe-3088-43b8-937a-4d5bb7fd5470"],

Cell["LLM generated.", "Notes",ExpressionUUID->"7f35c8c3-af53-4b76-910b-e9d9e998106b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6be025d7-6a6b-449c-a7bc-3e730f65b9bc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "249c9d47-d0b1-42cc-9e84-b1bf15a3f133"],
 "\[LineSeparator]",
 "is the arc around ",
 StyleBox["c", "TI"],
 " from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ": the minor arcs of the circle through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ". It is a symbolic object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7f65fe6d-92bd-4b96-b6b5-0ccd1a1975b9"],
 " evaluates it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"30f067d1-4e24-4236-aced-582e157a10df"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pk", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9a82b03-e44d-403a-9237-702100bc33eb"],
 "\[LineSeparator]",
 "is the polyline of the minor arcs from each point to the next.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2488d374-08a0-4cae-ba13-fbac3188974d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e073121-dfa7-4470-8bf7-40432aa9ecc9"],
 "\[LineSeparator]",
 "is the closed arc: the circles around ",
 StyleBox["c", "TI"],
 " through ",
 StyleBox["p", "TI"],
 ". ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     StyleBox["p", "TI"], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13c7f3be-c115-40e5-9d39-a6ba1607130b"],
 " is its shorthand, and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pk", "TI"], ",", " ", 
      StyleBox["p1", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b6cbedd-865a-446d-96ae-307d57b6543d"],
 " the circles through all the points."
}], "Usage",ExpressionUUID->"9d604bcf-1eaf-4a08-8e82-5158ad6af603"],

Cell[TextData[{
 "Definition: with ",
 StyleBox["r", "TI"],
 " = ",
 StyleBox["d(c, p)", "TI"],
 ", the band ",
 StyleBox["W", "TI"],
 " is the shell { ",
 StyleBox["v", "TI"],
 " : ",
 StyleBox["d(c, v)", "TI"],
 " = ",
 StyleBox["r", "TI"],
 " }, widened by ",
 Cell[BoxData["\"\<RadiusDelta\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41d5ccb0-4963-4263-9d7a-f243e056b8b8"],
 ". A minor arc from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is a shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " of the subgraph induced on ",
 StyleBox["W", "TI"],
 "."
}], "Notes",ExpressionUUID->"6ac176f3-a49e-424a-ba20-de3db0763645"],

Cell[TextData[{
 "Option ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c89a50da-243f-4529-9653-42482988a6ea"],
 " widens the band to ",
 StyleBox["r", "TI"],
 " \[Minus] ",
 StyleBox["deltaIn", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["r", "TI"],
 " + ",
 StyleBox["deltaOut", "TI"],
 ". A scalar ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "delta"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1126721-355e-4e1e-b14e-092106dc142c"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa5908fe-cf7f-4981-879a-08be5a86c814"],
 ", outward only. The default is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5dfd377-b2d6-4ac3-aa55-3765f2ada7f2"],
 "."
}], "Notes",ExpressionUUID->"a6f3953d-8b18-483e-8331-d94979084e70"],

Cell[TextData[{
 "Its graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["arc", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7af131ff-58ee-436b-a441-4df8eb5d820a"],
 " \[LongDash] is the interval of shortest paths of the band from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", with arrows of rising band distance from ",
 StyleBox["p", "TI"],
 ". It is the same object ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0e527f61-1a2b-4fa5-8805-5721112ba303"],
 " is on the whole graph. Its chains are those shortest paths, all of one \
length."
}], "Notes",ExpressionUUID->"34c74491-e05a-44f9-925e-82b46f3d8e65"],

Cell[TextData[{
 "That they are exactly the minor arcs needs the winding functional on the \
substrate, and ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " on a common circle. Nothing here certifies either, so ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f960819-6b12-4b97-b65e-6b4911dee806"],
 " stays unevaluated."
}], "Notes",ExpressionUUID->"f64504ce-4c15-4848-8675-b32267d974ac"],

Cell[TextData[{
 "The arc is empty when ",
 StyleBox["q", "TI"],
 " leaves the band or the band disconnects ",
 StyleBox["p", "TI"],
 " from ",
 StyleBox["q", "TI"],
 ". On a lattice the bare shell has no two adjacent vertices, so it joins no \
two of its points: widen the band."
}], "Notes",ExpressionUUID->"0239048d-2dfe-4a2c-9fa9-581d15a35e38"],

Cell[TextData[{
 StyleBox["An arc need not be unique.",
  FontWeight->"Bold"],
 " Between two points of a band there are in general many shortest paths, and \
through a point many circles; a trailing count of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "75f4e30c-9d71-4677-a28e-fdc63ef8ec61"],
 " gives them all."
}], "Notes",ExpressionUUID->"c58542e7-0c9f-4b89-81ac-d0505523bc12"],

Cell[TextData[{
 StyleBox["The closed arc.",
  FontWeight->"Bold"],
 " A list that returns to its first point names a closed arc, not a polyline \
there and back. It is the circle through ",
 StyleBox["p", "TI"],
 ", the compass opened to ",
 StyleBox["p", "TI"],
 " (Euclid's third postulate): ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}], ",", " ", 
    RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
     StyleBox["delta", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1f880c0-6f41-484e-bb8b-f84d12f18b9f"],
 " has the members of the circle of the band of ",
 StyleBox["p", "TI"],
 " that pass through ",
 StyleBox["p", "TI"],
 ". It is not empty, though a shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["p", "TI"],
 " is trivial: its members are cycles that leave ",
 StyleBox["p", "TI"],
 " and return to ",
 StyleBox["p", "TI"],
 " around ",
 StyleBox["c", "TI"],
 ", separating ",
 StyleBox["c", "TI"],
 " from everything beyond the band. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7c08deb-58fb-4ea1-a431-3c3f7458f438"],
 " keeps those that pass through ",
 StyleBox["q", "TI"],
 " too. Its members are cyclic vertex lists whose first vertex is not \
repeated, and its ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f797ab9-5f10-4105-839c-5e0572979c68"],
 " counts the closing edge."
}], "Notes",ExpressionUUID->"cf3c6d36-9a59-4d37-ae39-c3ed2e328ac0"],

Cell[TextData[{
 "Its graph is the circle's shape: the atom at ",
 StyleBox["p", "TI"],
 " of the band unrolled along a seam through ",
 StyleBox["p", "TI"],
 ", a DAG from ",
 StyleBox["p", "TI"],
 " to a copy ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"p", ",", " ", 
    RowBox[{"3", "/", "2"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22a5cda2-3c78-43a5-afc6-5ee1296995cd"],
 " of ",
 StyleBox["p", "TI"],
 " whose chains are the circles through ",
 StyleBox["p", "TI"],
 ". It is that atom only where the unrolled band applies (its cut band is \
connected and its seam has two sides) and ",
 StyleBox["p", "TI"],
 " lies on a circle of its band. Off a circle the paths of the unrolled band \
from ",
 StyleBox["p", "TI"],
 " to its copy include closed walks that run out to a circle and back, which \
are no circles, so the graph is the necklaces of that seam whose run meets ",
 StyleBox["p", "TI"],
 ", again closed on a copy ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"s1", ",", " ", 
    RowBox[{"3", "/", "2"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cae186af-efa5-4ac7-bae6-c42b0d6a10c8"],
 " of their source. Where the unrolled band does not apply the graph is those \
necklaces too. A necklace needs the circle to meet its seam in one run, so it \
can miss a circle."
}], "Notes",ExpressionUUID->"9f38ef75-e696-4255-84b6-7fcedde0bb8a"],

Cell[TextData[{
 "On a bipartite substrate the bare shell has no circle: use ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bde1f806-376f-472d-83b9-92391dd284d0"],
 "."
}], "Notes",ExpressionUUID->"012a632f-b0e6-438e-80b4-ca4b748204b6"],

Cell[TextData[{
 "A list that does not return to its first point is the open polyline, as \
before; a point repeated in a row inside it counts once, so ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2c21738-bdc5-4780-aa18-fbf25deaa71a"],
 " is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3da0033-1f89-4865-80bb-a6ce6ad1364b"],
 "."
}], "Notes",ExpressionUUID->"82560703-7327-4943-8446-f2dc6be324f9"],

Cell[TextData[{
 "A polyline arc reads each piece on the band of the circle through its own \
first point. Its members concatenate one arc per piece, so its ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "855cd325-3335-4ad5-af4c-a1f8b2db0185"],
 " is the product over the pieces. Through an intermediate point ",
 StyleBox["m", "TI"],
 " at the radius of ",
 StyleBox["p", "TI"],
 " that lies on a minor arc from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", the members of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0eca77f2-7c7a-4ca7-a3de-19e9ca32aeae"],
 " are the minor arcs from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " through ",
 StyleBox["m", "TI"],
 "."
}], "Notes",ExpressionUUID->"9b780455-6f0e-4c22-93a3-53569600d395"],

Cell[TextData[{
 StyleBox["The search.",
  FontWeight->"Bold"],
 " On an open arc, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "76bb844d-4248-4dd6-abe2-9d9303457e60"],
 " reads the members off the graph. On a closed arc it sweeps the band \
directly: for ",
 StyleBox["k", "TI"],
 " = 3, 4, \[Ellipsis] it takes every cycle of length ",
 StyleBox["k", "TI"],
 " of the band (",
 Cell[BoxData["FindCycle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8252e58-dd16-4b2f-ab2f-c9b832ae78df"],
 ") and keeps those through ",
 StyleBox["p", "TI"],
 " whose removal leaves ",
 StyleBox["c", "TI"],
 " in a component reaching no further than the band; the first ",
 StyleBox["k", "TI"],
 " with a survivor gives the circles, and the members are those through every \
point of the list. It does not read the graph, so it is the check on it. Each \
length is enumerated in full before the filter, so the sweep is fast on a \
band one or two vertices thick and slow on a wide one."
}], "Notes",ExpressionUUID->"de6e9430-c984-4bbb-ab7c-32778b44a6a5"]
}, Open  ]],

