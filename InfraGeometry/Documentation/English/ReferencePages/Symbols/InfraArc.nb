    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fe27c24c-1f6c-47fc-af40-bacd036cc208"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "be3105c1-a3a7-4b2a-a73e-fbe7e777dbbb"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7062deb9-4aa3-43a6-bc81-cb7d332548cf"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "26dbde8e-b620-4431-aec7-08ba90e7811d"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
