Cell[CellGroupData[{
Cell["InfraArc", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bc8fead9-a880-48e5-8d39-bc1f993c112a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba6046a6-7271-42ed-ac48-48ac7fc6d5f2"],
 "\[LineSeparator]",
 "is the arc around ",
 StyleBox["c", "TI"],
 " from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ": the minor arcs of the circle through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ". It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7e5e95a0-98b9-4265-bd77-adffe6726c0d"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraVertexList", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7ffbd3af-b3a5-49ff-88e9-ed6a5fbf59e5"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"cfd9f28d-c04b-47b1-b3f5-5e5831253b49"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pk", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8be04a97-37ce-4dad-8d74-3affd41d814e"],
 "\[LineSeparator]",
 "is the polyline of the minor arcs from each point to the next."
}], "Usage",ExpressionUUID->"b13d4ad9-405c-4eb5-ae75-6a2f304d4aed"],

Cell[TextData[{
 "Definition: with ",
 StyleBox["r", "TI"],
 " = ",
 StyleBox["d(c, p)", "TI"],
 ", the band ",
 StyleBox["W", "TI"],
 " is the shell { ",
 StyleBox["v", "TI"],
 " : ",
 StyleBox["d(c, v)", "TI"],
 " = ",
 StyleBox["r", "TI"],
 " }, widened by ",
 Cell[BoxData["\"\<RadiusDelta\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "efd408d3-6d56-4309-b661-b84a596b7b84"],
 ". A minor arc from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is a shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " of the subgraph induced on ",
 StyleBox["W", "TI"],
 "."
}], "Notes",ExpressionUUID->"3e4e3d3d-fd86-4bf5-9bb8-98f5da120407"],

Cell[TextData[{
 "Option ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c8b8c17-c2c6-4911-8e71-8370ff022d9f"],
 " widens the band to ",
 StyleBox["r", "TI"],
 " \[Minus] ",
 StyleBox["deltaIn", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["r", "TI"],
 " + ",
 StyleBox["deltaOut", "TI"],
 ". A scalar ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "delta"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8e20844-a527-4f3e-a8b2-187ea3909745"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a6f2e28-8569-4d27-b898-7fc9dd135f47"],
 ", outward only. The default is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b04f9b5b-d156-4952-82c8-f5bab56ac349"],
 "."
}], "Notes",ExpressionUUID->"7087d865-2411-49d0-a879-1631bc14df9a"],

Cell[TextData[{
 "Its graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["arc", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "297d17df-f0b1-4eed-9b11-85efd236ebb1"],
 " \[LongDash] is the interval of shortest paths of the band from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", with arrows of rising band distance from ",
 StyleBox["p", "TI"],
 ". It is the same object ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6b6bb538-5f52-467d-9d97-f8616b0395ef"],
 " is on the whole graph. Its chains are those shortest paths, all of one \
length."
}], "Notes",ExpressionUUID->"b8e7c2f3-d2a9-4a3c-a976-31d1dce8dd39"],

Cell[TextData[{
 "That they are exactly the minor arcs needs the winding functional on the \
substrate, and ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " on a common circle. Nothing here certifies either, so ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1a09050-4578-432d-930c-719d5ec82a93"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8a0792d9-be23-43af-af0f-9ff9259d5cf1"],
 "."
}], "Notes",ExpressionUUID->"358f09f9-dc9d-42d2-89f1-ebb3256c920e"],

Cell[TextData[{
 "The arc is empty when ",
 StyleBox["q", "TI"],
 " leaves the band or the band disconnects ",
 StyleBox["p", "TI"],
 " from ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"58fcdba2-2ad2-47dc-9880-e77bbf9df4c5"],

Cell[TextData[{
 "A polyline arc reads each piece on the band of the circle through its own \
first point. Its members concatenate one arc per piece, so its ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "926ec04f-21a8-471c-8cc1-2e57fb96c396"],
 " is the product over the pieces."
}], "Notes",ExpressionUUID->"97cc0e54-8383-4522-b630-22ed7012ff21"]
}, Open  ]],

