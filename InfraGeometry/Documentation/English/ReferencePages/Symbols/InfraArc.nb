Cell[TextData[{
 "A polyline through an intermediate vertex ",
 StyleBox["m", "TI"],
 " at distance 3 keeps the arcs that pass through ",
 StyleBox["m", "TI"],
 ". Its cardinality is the number of arcs through ",
 StyleBox["m", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"c8b68142-bc67-4e20-a430-2bedae46ae37"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"pq", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "2", ",", " ", 
       RowBox[{"\"\<PairwiseDistance\>\"", " ", "->", " ", "\"\<Max\>\""}], ",",
        " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"density", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraArc", "[", 
        RowBox[{"c", ",", " ", "pq", ",", " ", 
         RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "1"}]}], "]"}], ",", 
       " ", "\"\<VertexDensity\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"m", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"MinimalBy", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Keys", "[", "density", "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
            " ", "3"}], " ", "&"}]}], "]"}], ",", " ", "density"}], "]"}]}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"polyline", " ", "=", " ", 
     RowBox[{"InfraArc", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"First", "[", "pq", "]"}], ",", " ", "m", ",", " ", 
         RowBox[{"Last", "[", "pq", "]"}]}], "}"}], ",", " ", 
       RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "1"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"polyline", ",", " ", "c", ",", " ", "pq", ",", " ", "m"}], 
      "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", "polyline", ",", " ", "\"\<Cardinality\>\""}],
          "]"}], ",", " ", 
        RowBox[{"density", "[", "m", "]"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"12fa46bd-4c8b-4515-bd7e-3dcc58de3312"],

