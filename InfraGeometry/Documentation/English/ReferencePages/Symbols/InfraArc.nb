Cell[TextData[{
 "Through a second point the circles are fewer; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     StyleBox["p", "TI"], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da5b209d-c0df-4140-8779-e9c8d4abdf59"],
 " is the same as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65937281-056a-4828-8d41-77c76b306666"],
 "."
}], "ExampleText",ExpressionUUID->"e96d6f3d-362f-4783-8d14-5f40b796b044"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"both", " ", "=", " ", 
     RowBox[{"InfraArc", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "q", ",", " ", "p"}], "}"}], ",", " ", 
       RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "2"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"both", " ", "->", " ", "$InfraCircleColor"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c", ",",
          " ", "p", ",", " ", "q"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "both", ",", " ", "\"\<Cardinality\>\""}], "]"}],
      ",", "\n", "   ", 
     RowBox[{
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraArc", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{"{", "p", "}"}], ",", " ", 
          RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "2"}]}], "]"}], ",", 
        " ", "\"\<Cardinality\>\""}], "]"}], " ", "==", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraArc", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{"{", 
           RowBox[{"p", ",", " ", "p"}], "}"}], ",", " ", 
          RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "2"}]}], "]"}], ",", 
        " ", "\"\<Cardinality\>\""}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"1c2a6d6b-f582-45f8-a88c-3552e779890b"],

