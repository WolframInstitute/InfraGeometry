Notebook[{

Cell[CellGroupData[{
Cell["InfraArc", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7214660a-0670-403d-aa67-deb415f07ae2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c43a1510-b8ed-44ec-a02b-6ca2e2d4ecb4"],
 "\[LineSeparator]",
 "is the arc around ",
 StyleBox["c", "TI"],
 " from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ": the minor arcs of the circle through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ". It is a symbolic object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "16318f5f-5172-4d21-ba44-a7863abb0add"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ddb5372d-37dc-4d7b-b319-1488a3c191e6"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"48427287-02f4-468a-8c0f-96d453cff9c5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pk", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cc730f2-2c66-4ee7-a5f8-a55ab2eadd39"],
 "\[LineSeparator]",
 "is the polyline of the minor arcs from each point to the next.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7a185c43-51b1-42fe-87e3-8e497414914a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b2e6002-c204-440c-bd7a-9714c18001ac"],
 "\[LineSeparator]",
 "is the closed arc: the circles around ",
 StyleBox["c", "TI"],
 " through ",
 StyleBox["p", "TI"],
 ". ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     StyleBox["p", "TI"], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d81d4aea-626c-4a6c-acac-a58332d7af8e"],
 " is its shorthand, and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pk", "TI"], ",", " ", 
      StyleBox["p1", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60691c30-15c3-455e-9f2c-1a7383a19627"],
 " the circles through all the points."
}], "Usage",ExpressionUUID->"78306440-3f32-4c56-9242-796bfb27744a"],

Cell[TextData[{
 "Definition: with ",
 StyleBox["r", "TI"],
 " = ",
 StyleBox["d(c, p)", "TI"],
 ", the band ",
 StyleBox["W", "TI"],
 " is the shell { ",
 StyleBox["v", "TI"],
 " : ",
 StyleBox["d(c, v)", "TI"],
 " = ",
 StyleBox["r", "TI"],
 " }, widened by ",
 Cell[BoxData["\"\<RadiusDelta\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e0e8ca8-16e7-4f80-9fbf-b83d08995433"],
 ". A minor arc from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is a shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " of the subgraph induced on ",
 StyleBox["W", "TI"],
 "."
}], "Notes",ExpressionUUID->"2052abbb-54f3-41e1-90a8-11a67b7a6d4d"],

Cell[TextData[{
 "Option ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bf91bc2-d1a3-4c7a-a490-5d4678c43d01"],
 " widens the band to ",
 StyleBox["r", "TI"],
 " \[Minus] ",
 StyleBox["deltaIn", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["r", "TI"],
 " + ",
 StyleBox["deltaOut", "TI"],
 ". A scalar ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "delta"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "248015ac-c674-4f1c-b6a0-fd1d14917b4c"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f468f809-a133-454a-926f-18e1e8bc8662"],
 ", outward only. The default is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3430c9d3-63ea-4618-931d-e4ade18259ed"],
 "."
}], "Notes",ExpressionUUID->"058d44fb-685c-4dba-a597-68f494498590"],

Cell[TextData[{
 "Its graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["arc", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "240bcb80-681d-43ae-8590-20a990a3d139"],
 " \[LongDash] is the interval of shortest paths of the band from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", with arrows of rising band distance from ",
 StyleBox["p", "TI"],
 ". It is the same object ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4b3618bc-3bc0-45f0-8821-69a4baa7aac3"],
 " is on the whole graph. Its chains are those shortest paths, all of one \
length."
}], "Notes",ExpressionUUID->"af5773e7-981d-4cd4-b5f8-b8f4548c8886"],

Cell[TextData[{
 "That they are exactly the minor arcs needs the winding functional on the \
substrate, and ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " on a common circle. Nothing here certifies either, so ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da4e1090-5dc1-4c80-bcdf-fea38a753c72"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "52c8ee45-b318-4ced-ada6-a0c840234c02"],
 "."
}], "Notes",ExpressionUUID->"323017b0-0c36-424d-98ba-cd8036c2c1c4"],

Cell[TextData[{
 "The arc is empty when ",
 StyleBox["q", "TI"],
 " leaves the band or the band disconnects ",
 StyleBox["p", "TI"],
 " from ",
 StyleBox["q", "TI"],
 ". On a lattice the bare shell has no two adjacent vertices, so it joins no \
two of its points: widen the band."
}], "Notes",ExpressionUUID->"91300d0c-091e-437d-8285-5604274d4232"],

Cell[TextData[{
 StyleBox["An arc need not be unique.",
  FontWeight->"Bold"],
 " Between two points of a band there are in general many shortest paths, and \
through a point many circles; a trailing count of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6fe7f94f-747c-4223-9b5e-787019a29bb0"],
 " gives them all."
}], "Notes",ExpressionUUID->"35383f8e-0daf-414a-96e8-de2740ded0f0"],

Cell[TextData[{
 StyleBox["The closed arc.",
  FontWeight->"Bold"],
 " A list that returns to its first point names a closed arc, not a polyline \
there and back. It is the circle through ",
 StyleBox["p", "TI"],
 ", the compass opened to ",
 StyleBox["p", "TI"],
 " (Euclid's third postulate): ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}], ",", " ", 
    RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
     StyleBox["delta", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e2d7e86-5b1a-4a07-a711-cc21b3286ef9"],
 " has the members of the circle of the band of ",
 StyleBox["p", "TI"],
 " that pass through ",
 StyleBox["p", "TI"],
 ". It is not empty, though a shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["p", "TI"],
 " is trivial: its members are cycles that leave ",
 StyleBox["p", "TI"],
 " and return to ",
 StyleBox["p", "TI"],
 " around ",
 StyleBox["c", "TI"],
 ", separating ",
 StyleBox["c", "TI"],
 " from everything beyond the band. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8449bd8-cae1-4500-b1fe-642e8c0b7e31"],
 " keeps those that pass through ",
 StyleBox["q", "TI"],
 " too. Its members are cyclic vertex lists whose first vertex is not \
repeated, and its ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01176c4f-d707-415b-a4d2-db20296db807"],
 " counts the closing edge."
}], "Notes",ExpressionUUID->"7e6fc8ff-9667-411c-8f7e-23c7d6975911"],

Cell[TextData[{
 "Its graph is the circle's shape: the atom at ",
 StyleBox["p", "TI"],
 " of the band unrolled along a seam through ",
 StyleBox["p", "TI"],
 ", a DAG from ",
 StyleBox["p", "TI"],
 " to a copy ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"p", ",", " ", 
    RowBox[{"3", "/", "2"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fda2376-3a16-416a-b49d-cb9730a55cf9"],
 " of ",
 StyleBox["p", "TI"],
 " whose chains are the circles through ",
 StyleBox["p", "TI"],
 ". It is that atom only where the unrolled band applies (its cut band is \
connected and its seam has two sides) and ",
 StyleBox["p", "TI"],
 " lies on a circle of its band. Off a circle the paths of the unrolled band \
from ",
 StyleBox["p", "TI"],
 " to its copy include closed walks that run out to a circle and back, which \
are no circles, so the graph is the necklaces of that seam whose run meets ",
 StyleBox["p", "TI"],
 ", again closed on a copy ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"s1", ",", " ", 
    RowBox[{"3", "/", "2"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cabbca95-af1f-4cdd-9e63-96f4282251c4"],
 " of their source. Where the unrolled band does not apply the graph is those \
necklaces too. A necklace needs the circle to meet its seam in one run, so it \
can miss a circle."
}], "Notes",ExpressionUUID->"65e20e6b-3b50-4068-b5da-23e3b39f92d7"],

Cell[TextData[{
 "On a bipartite substrate the bare shell has no circle: use ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48220f58-5487-4329-b06a-b66b18934b4a"],
 "."
}], "Notes",ExpressionUUID->"56d5c5cb-98be-45ab-8db4-ba71857cce5f"],

Cell[TextData[{
 "A list that does not return to its first point is the open polyline, as \
before; a point repeated in a row inside it counts once, so ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae0a4c85-b871-416b-a1d8-d7da1f5cfc5f"],
 " is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38f95b38-cad2-4f84-8c77-2bdbd524aec2"],
 "."
}], "Notes",ExpressionUUID->"c172806f-b67f-4943-8da1-66de10222ec3"],

Cell[TextData[{
 "A polyline arc reads each piece on the band of the circle through its own \
first point. Its members concatenate one arc per piece, so its ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30102720-b9e3-4217-8974-b1d1ae9b72a1"],
 " is the product over the pieces. Through an intermediate point ",
 StyleBox["m", "TI"],
 " at the radius of ",
 StyleBox["p", "TI"],
 " that lies on a minor arc from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", the members of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2637a10c-a39e-48f7-a07e-4ed841fba2d7"],
 " are the minor arcs from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " through ",
 StyleBox["m", "TI"],
 "."
}], "Notes",ExpressionUUID->"278032e4-a00d-47d9-ac5b-635adab2bc2b"],

Cell[TextData[{
 StyleBox["The search.",
  FontWeight->"Bold"],
 " On an open arc, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c3ec7ae1-591e-4a5a-a572-503d5bdb8864"],
 " reads the members off the graph. On a closed arc it sweeps the band \
directly: for ",
 StyleBox["k", "TI"],
 " = 3, 4, \[Ellipsis] it takes every cycle of length ",
 StyleBox["k", "TI"],
 " of the band (",
 Cell[BoxData["FindCycle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87546c50-71be-44da-b276-47e53ab41f8a"],
 ") and keeps those through ",
 StyleBox["p", "TI"],
 " whose removal leaves ",
 StyleBox["c", "TI"],
 " in a component reaching no further than the band; the first ",
 StyleBox["k", "TI"],
 " with a survivor gives the circles, and the members are those through every \
point of the list. It does not read the graph, so it is the check on it. Each \
length is enumerated in full before the filter, so the sweep is fast on a \
band one or two vertices thick and slow on a wide one."
}], "Notes",ExpressionUUID->"7da74786-8be0-47b2-99f4-b2d217b5bf82"]
}, Open  ]],

Cell[CellGroupData[{

