Cell["\<\
An arc of the circle of radius 3 about the centre, on the band widened one \
step each way, on the square, hexagonal and triangular tilings. An edge is \
drawn as strongly as the number of minor arcs through it.\
\>", "ExampleText",ExpressionUUID->"f91b0871-5c69-438e-bf36-07273eeeaf88"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"arc", " ", "=", " ", 
        RowBox[{"InfraArc", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{"{", 
           RowBox[{"p", ",", " ", "q"}], "}"}], ",", " ", 
          RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "1"}], "}"}]}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"arc", ",", " ", "c", ",", " ", "p", ",", " ", "q"}], 
         "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fe0a416f-22ad-4ac5-9c75-bd7660f697bd"],

