Notebook[{

Cell[CellGroupData[{
Cell["InfraArc", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"20df24ec-3581-4b12-b2b9-07272fb58fbe"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fdd26ef2-d534-471d-bacc-c49c13d675ad"],
 "\[LineSeparator]",
 "is the arc around ",
 StyleBox["c", "TI"],
 " from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ": the minor arcs of the circle through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ". It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "be4fef27-10e9-43fe-b59b-d3ccb6c90f42"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2be9582b-efda-4d7d-b40c-10016b2f7db0"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2aab6550-0f5a-41f4-ab6d-4d5f4997aa93"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pk", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2286341f-2944-4aef-8c36-9a1c9f8b0b95"],
 "\[LineSeparator]",
 "is the polyline of the minor arcs from each point to the next.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"82aefd39-359c-4857-a182-33b9688e1b12"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2177eef3-92af-4b40-b930-46fe9ba3137b"],
 "\[LineSeparator]",
 "is the closed arc: the circles around ",
 StyleBox["c", "TI"],
 " through ",
 StyleBox["p", "TI"],
 ". ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     StyleBox["p", "TI"], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "abdd6457-ac55-45d1-9544-8a9135004b32"],
 " is its shorthand, and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pk", "TI"], ",", " ", 
      StyleBox["p1", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a24f138-f530-4e95-ad85-f475a3169c6b"],
 " the circles through all the points."
}], "Usage",ExpressionUUID->"6c387974-519b-467e-8a30-71ae79a6f9e3"],

Cell[TextData[{
 "Definition: with ",
 StyleBox["r", "TI"],
 " = ",
 StyleBox["d(c, p)", "TI"],
 ", the band ",
 StyleBox["W", "TI"],
 " is the shell { ",
 StyleBox["v", "TI"],
 " : ",
 StyleBox["d(c, v)", "TI"],
 " = ",
 StyleBox["r", "TI"],
 " }, widened by ",
 Cell[BoxData["\"\<RadiusDelta\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8b018e5-9b0b-4800-87d3-a50183b57581"],
 ". A minor arc from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is a shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " of the subgraph induced on ",
 StyleBox["W", "TI"],
 "."
}], "Notes",ExpressionUUID->"d4cef190-3e3c-448f-af0a-6eae9c208530"],

Cell[TextData[{
 "Option ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b581c664-0882-4732-93ce-8ebbf6f165a6"],
 " widens the band to ",
 StyleBox["r", "TI"],
 " \[Minus] ",
 StyleBox["deltaIn", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["r", "TI"],
 " + ",
 StyleBox["deltaOut", "TI"],
 ". A scalar ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "delta"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9de6e2f9-8875-491a-9873-64a8e34dce0c"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "408aa3d6-4625-40b6-a37b-ef7cc58bdf04"],
 ", outward only. The default is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fdbd4ab-6977-45de-8e92-c641b420a73c"],
 "."
}], "Notes",ExpressionUUID->"dd72743e-a9ba-4b53-b4f2-b0af96da1c10"],

Cell[TextData[{
 "Its graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["arc", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8069fed5-d46b-40f4-8c19-bf4f7ae2ea38"],
 " \[LongDash] is the interval of shortest paths of the band from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", with arrows of rising band distance from ",
 StyleBox["p", "TI"],
 ". It is the same object ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ebfb98e0-519c-414f-8e3f-fc001d2d3406"],
 " is on the whole graph. Its chains are those shortest paths, all of one \
length."
}], "Notes",ExpressionUUID->"d1813881-8cdd-424f-b5e6-0f70a75025aa"],

Cell[TextData[{
 "That they are exactly the minor arcs needs the winding functional on the \
substrate, and ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " on a common circle. Nothing here certifies either, so ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b37414a-b9bd-4a25-b603-00ccee553ae5"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a8fad512-d0cb-4162-a64a-b07361640c9b"],
 "."
}], "Notes",ExpressionUUID->"b7e0e21d-58a6-411e-af23-a27371ebbc69"],

Cell[TextData[{
 "The arc is empty when ",
 StyleBox["q", "TI"],
 " leaves the band or the band disconnects ",
 StyleBox["p", "TI"],
 " from ",
 StyleBox["q", "TI"],
 ". On a lattice the bare shell has no two adjacent vertices, so it joins no \
two of its points: widen the band."
}], "Notes",ExpressionUUID->"10d331fd-0168-4ac9-aa96-cb76d8faba87"],

Cell[TextData[{
 StyleBox["An arc need not be unique.",
  FontWeight->"Bold"],
 " Between two points of a band there are in general many shortest paths, and \
through a point many circles; a trailing count of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3b3c39ee-f189-404c-a292-247562ca1067"],
 " gives them all."
}], "Notes",ExpressionUUID->"e0dbe108-bacd-49f5-9256-97904d061c41"],

Cell[TextData[{
 StyleBox["The closed arc.",
  FontWeight->"Bold"],
 " A list that returns to its first point names a closed arc, not a polyline \
there and back. It is the circle through ",
 StyleBox["p", "TI"],
 ", the compass opened to ",
 StyleBox["p", "TI"],
 " (Euclid's third postulate): ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}], ",", " ", 
    RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
     StyleBox["delta", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61e59fb8-1615-4031-af18-d806f3a894c5"],
 " has the members of the circle of the band of ",
 StyleBox["p", "TI"],
 " that pass through ",
 StyleBox["p", "TI"],
 ". It is not empty, though a shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["p", "TI"],
 " is trivial: its members are cycles that leave ",
 StyleBox["p", "TI"],
 " and return to ",
 StyleBox["p", "TI"],
 " around ",
 StyleBox["c", "TI"],
 ", separating ",
 StyleBox["c", "TI"],
 " from everything beyond the band. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7952815-b220-4214-8821-ecba0d39f0ff"],
 " keeps those that pass through ",
 StyleBox["q", "TI"],
 " too. Its members are cyclic vertex lists whose first vertex is not \
repeated, and its ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dfa5065-f869-4b2c-9e2d-8bd763955e9b"],
 " counts the closing edge."
}], "Notes",ExpressionUUID->"65c03162-4050-48cb-aa92-a143a121ecae"],

Cell[TextData[{
 "Its graph is the circle's shape: the atom at ",
 StyleBox["p", "TI"],
 " of the band unrolled along a seam through ",
 StyleBox["p", "TI"],
 ", a DAG from ",
 StyleBox["p", "TI"],
 " to a copy ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"p", ",", " ", 
    RowBox[{"3", "/", "2"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ef0d7eb-84d7-420f-9638-87c6cb9e0f6a"],
 " of ",
 StyleBox["p", "TI"],
 " whose chains are the circles through ",
 StyleBox["p", "TI"],
 ". It is that atom only where the unrolled band applies (its cut band is \
connected and its seam has two sides) and ",
 StyleBox["p", "TI"],
 " lies on a circle of its band. Off a circle the paths of the unrolled band \
from ",
 StyleBox["p", "TI"],
 " to its copy include closed walks that run out to a circle and back, which \
are no circles, so the graph is the necklaces of that seam whose run meets ",
 StyleBox["p", "TI"],
 ", again closed on a copy ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"s1", ",", " ", 
    RowBox[{"3", "/", "2"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97db32a8-4240-455e-b2f3-b877ab2a9dcc"],
 " of their source. Where the unrolled band does not apply the graph is those \
necklaces too. A necklace needs the circle to meet its seam in one run, so it \
can miss a circle."
}], "Notes",ExpressionUUID->"bb82c434-947a-4765-bcc0-712e4d102f1f"],

Cell[TextData[{
 "On a bipartite substrate the bare shell has no circle: use ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55ff6165-7610-4a0e-a922-90b46f287a83"],
 "."
}], "Notes",ExpressionUUID->"82a2d6e4-bd9c-4c75-b7da-c23233cb208a"],

Cell[TextData[{
 "A list that does not return to its first point is the open polyline, as \
before; a point repeated in a row inside it counts once, so ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ad0295e-262d-4eea-80fa-88f554f05cd0"],
 " is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e172480-97c9-47bb-8ab4-4a7af6af24b8"],
 "."
}], "Notes",ExpressionUUID->"7dad9d23-6b16-48ac-bbab-f16eb55db756"],

Cell[TextData[{
 "A polyline arc reads each piece on the band of the circle through its own \
first point. Its members concatenate one arc per piece, so its ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f3354e8-6009-44fc-be15-0873eb3e8f64"],
 " is the product over the pieces. Through an intermediate point ",
 StyleBox["m", "TI"],
 " at the radius of ",
 StyleBox["p", "TI"],
 " that lies on a minor arc from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", the members of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "248d38bb-1621-45b8-996d-c9e8689131bb"],
 " are the minor arcs from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " through ",
 StyleBox["m", "TI"],
 "."
}], "Notes",ExpressionUUID->"392b86f0-7616-46d2-81ca-dc68fc76613d"],

Cell[TextData[{
 StyleBox["The search.",
  FontWeight->"Bold"],
 " On an open arc, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "58265458-521d-4ad2-9f47-ad1233a41141"],
 " reads the members off the graph. On a closed arc it sweeps the band \
directly: for ",
 StyleBox["k", "TI"],
 " = 3, 4, \[Ellipsis] it takes every cycle of length ",
 StyleBox["k", "TI"],
 " of the band (",
 Cell[BoxData["FindCycle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "afe8a93e-ccdb-4494-b12a-1ae2caf5e11a"],
 ") and keeps those through ",
 StyleBox["p", "TI"],
 " whose removal leaves ",
 StyleBox["c", "TI"],
 " in a component reaching no further than the band; the first ",
 StyleBox["k", "TI"],
 " with a survivor gives the circles, and the members are those through every \
point of the list. It does not read the graph, so it is the check on it. Each \
length is enumerated in full before the filter, so the sweep is fast on a \
band one or two vertices thick and slow on a wide one."
}], "Notes",ExpressionUUID->"80a58b61-ac37-4a83-b3ca-759ad830d218"]
}, Open  ]],

Cell[CellGroupData[{

