   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c80f2d12-69fa-4dff-98cb-b827e24c909e"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f57c4dfc-04b0-49f6-ae58-e50ac4a8d18d"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "865a111e-94fc-4a37-a35b-3a16dc91d3eb"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c726b24c-377b-4502-a0a5-712157d3e65c"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ac3111ae-6884-447f-9df1-cbae3371f47e"],
 " \[FilledVerySmallSquare] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
