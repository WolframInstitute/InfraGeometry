    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbcb5e42-a083-41f4-8026-260b755f3e09"],
 "\[LineSeparator]",
 "is the arc around ",
 StyleBox["c", "TI"],
 " from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ": the shortest paths from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " inside the band of the circle through ",
 StyleBox["p", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d6b482af-4345-49ab-a111-09ffc38b53a0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pk", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fade12c5-35d4-4438-9885-e6f89edf2b36"],
 "\[LineSeparator]",
 "is the polyline of the arcs from each point to the next.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e8fe6d3b-01c8-4ae1-9b16-0346d053068b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f1173106-40f8-4137-9659-fb8ad9bb20c6"],
 "\[LineSeparator]",
 "or ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     StyleBox["p", "TI"], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f77ce7a-84b5-4056-97c3-af2ad19dc8b3"],
 " is the closed arc: the circles around ",
 StyleBox["c", "TI"],
 " through ",
 StyleBox["p", "TI"],
 "."
}], "Usage",ExpressionUUID->"40f8f9d5-4a9b-4092-bd95-e69216268c8b"],

Cell[TextData[{
 "With ",
 StyleBox["r = d(c, p)", "TI"],
 " the band is ",
 StyleBox["W = {v : r \[Minus] \[Delta]\:1d62\:2099 \[LessEqual] d(c, v) \
\[LessEqual] r + \[Delta]\:2092\:1d64\:209c}", "TI"],
 ". An arc from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is a shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " in the subgraph induced on ",
 StyleBox["W", "TI"],
 ". It is empty when ",
 StyleBox["q", "TI"],
 " is not in ",
 StyleBox["W", "TI"],
 " or ",
 StyleBox["W", "TI"],
 " does not connect ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"332b7ee0-089f-4349-ae6a-abf43f563b19"],

Cell["\<\
On a bipartite graph, such as the square grid, no two vertices of one shell \
are adjacent, so the bare shell carries no arc. Widen the band.\
\>", "Notes",ExpressionUUID->"92e7dbed-7cd3-42fe-9384-5d493916782b"],

Cell[TextData[{
 "The closed arc is the family of the circles of the band through ",
 StyleBox["p", "TI"],
 ": the shortest cycles of ",
 StyleBox["W", "TI"],
 " through ",
 StyleBox["p", "TI"],
 " whose removal cuts ",
 StyleBox["c", "TI"],
 " off from everything beyond the band. These are the members of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "794c8674-41a2-4e20-9ff8-8cfc85afc03c"],
 " through ",
 StyleBox["p", "TI"],
 ". ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b9fadad-32c1-4e76-aa15-8881ecd9f342"],
 " keeps the circles through ",
 StyleBox["q", "TI"],
 " as well."
}], "Notes",ExpressionUUID->"d0f65acc-d55b-4b8c-adbc-f1b57ddfcfa0"],

Cell[TextData[{
 "Arcs are not unique. On the square grid with the band {",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["r", "TI"],
 " + 1}, away from the rim, the circle through a vertex at distance ",
 StyleBox["r", "TI"],
 " is unique and has length ",
 StyleBox["8r", "TI"],
 ": the circle of the \[ScriptL]\.b9 norm, whose circumference is 8 times its \
radius, not 2\[Pi]."
}], "Notes",ExpressionUUID->"54697c4b-b2dc-4b36-aa27-f1c47019e45b"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "482692a5-b033-4812-b652-c808be355569"],
 " is a symbolic object: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "62124c3a-1501-4349-99e3-e7a186d0b299"],
 " evaluates it on a graph and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "211e5bf1-95e1-4832-a2d8-0419085345c8"],
 " draws members. A member is a vertex list; a closed member does not repeat \
its first vertex, and its length counts the closing edge."
}], "Notes",ExpressionUUID->"08172bf5-2836-45a1-85c9-d05530bb79d3"],

