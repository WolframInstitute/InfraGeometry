Cell[CellGroupData[{
Cell["InfraArc", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"384bcf05-1dce-4ce4-b55a-94cd3c5b092f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7192a309-ed5b-467d-ae09-977652dc31f5"],
 "\[LineSeparator]",
 "is the arc around ",
 StyleBox["c", "TI"],
 " from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ": the minor arcs of the circle through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ". It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "378c3f36-9bdd-4983-a1bd-1caf36f5917d"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8a5db5c3-26f1-4968-b0e4-ae145aacadbc"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c9b6a4c0-775b-43b6-b819-95aba2ce587e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pk", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "278cba77-fea5-4800-b539-e7537fdf2307"],
 "\[LineSeparator]",
 "is the polyline of the minor arcs from each point to the next.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ce511c90-9bd6-429d-838a-93a647f10cca"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86efc708-ad14-40a0-901b-441fbd1a0f1d"],
 "\[LineSeparator]",
 "is the closed arc: the circles around ",
 StyleBox["c", "TI"],
 " through ",
 StyleBox["p", "TI"],
 ". ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     StyleBox["p", "TI"], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c4a82b3-5f8d-4ece-b76e-87f45a182380"],
 " is its shorthand, and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pk", "TI"], ",", " ", 
      StyleBox["p1", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9312d558-bedd-4e32-8da8-0c619750131f"],
 " the circles through all the points."
}], "Usage",ExpressionUUID->"c1358fec-c4c5-476f-bad0-ed8ddbfc8686"],

Cell[TextData[{
 "Definition: with ",
 StyleBox["r", "TI"],
 " = ",
 StyleBox["d(c, p)", "TI"],
 ", the band ",
 StyleBox["W", "TI"],
 " is the shell { ",
 StyleBox["v", "TI"],
 " : ",
 StyleBox["d(c, v)", "TI"],
 " = ",
 StyleBox["r", "TI"],
 " }, widened by ",
 Cell[BoxData["\"\<RadiusDelta\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76373c4f-4565-4054-a656-b12c8d6dc3ef"],
 ". A minor arc from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is a shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " of the subgraph induced on ",
 StyleBox["W", "TI"],
 "."
}], "Notes",ExpressionUUID->"83249d1b-f304-4c2b-a321-a2217465ec73"],

Cell[TextData[{
 "Option ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5592a8ea-4f2c-4730-8a0f-88896835e2cc"],
 " widens the band to ",
 StyleBox["r", "TI"],
 " \[Minus] ",
 StyleBox["deltaIn", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["r", "TI"],
 " + ",
 StyleBox["deltaOut", "TI"],
 ". A scalar ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "delta"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39e0dbfb-92cc-4386-ae7e-e274269babb6"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2061e121-2e03-42e0-8ef4-0a68ca84af7e"],
 ", outward only. The default is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "91ee5c2b-35bb-43a3-a487-2a29d9382394"],
 "."
}], "Notes",ExpressionUUID->"491d7c0a-9f85-4336-9d38-33599089e58a"],

Cell[TextData[{
 "Its graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["arc", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "453a3c33-4a67-4b29-a53b-7a8299cd19ae"],
 " \[LongDash] is the interval of shortest paths of the band from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", with arrows of rising band distance from ",
 StyleBox["p", "TI"],
 ". It is the same object ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "39a6ead6-7388-4fbd-a8a6-0221ce4368ec"],
 " is on the whole graph. Its chains are those shortest paths, all of one \
length."
}], "Notes",ExpressionUUID->"1ad0ff39-cc2b-44a8-b8ac-38f51b3056fe"],

Cell[TextData[{
 "That they are exactly the minor arcs needs the winding functional on the \
substrate, and ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " on a common circle. Nothing here certifies either, so ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f53ecf0c-9664-4404-b860-31800d0b89ac"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5545cbde-bf09-4ca9-9b63-c8c25f583610"],
 "."
}], "Notes",ExpressionUUID->"b8e907b5-5943-4682-bbc8-66deb662dc30"],

Cell[TextData[{
 "The arc is empty when ",
 StyleBox["q", "TI"],
 " leaves the band or the band disconnects ",
 StyleBox["p", "TI"],
 " from ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"d3240a53-3760-40f8-9a12-b0ca2777776a"],

Cell[TextData[{
 StyleBox["The closed arc.",
  FontWeight->"Bold"],
 " A list that returns to its first point names a closed arc, not a polyline \
there and back. It is the circle through ",
 StyleBox["p", "TI"],
 ", the compass opened to ",
 StyleBox["p", "TI"],
 " (Euclid's third postulate): ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}], ",", " ", 
    RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
     StyleBox["delta", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2edd6a3d-82ac-49ee-8abc-961ee05ecce5"],
 " has the members of the circle of the band of ",
 StyleBox["p", "TI"],
 " that pass through ",
 StyleBox["p", "TI"],
 ". It is not empty, though a shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["p", "TI"],
 " is trivial: its members are cycles that leave ",
 StyleBox["p", "TI"],
 " and return to ",
 StyleBox["p", "TI"],
 " around ",
 StyleBox["c", "TI"],
 ", separating ",
 StyleBox["c", "TI"],
 " from everything beyond the band. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c43f38f8-cbf2-4790-b95c-d861d3c09a0d"],
 " keeps those that pass through ",
 StyleBox["q", "TI"],
 " too. Its members are cyclic vertex lists whose first vertex is not \
repeated, and its ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42f22d3b-e1e3-4fe2-ac50-38e48aa4cbc3"],
 " counts the closing edge. On a bipartite substrate the bare shell has no \
circle: use ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f812d5e-03b6-47ed-b86d-9bf9acefd97c"],
 "."
}], "Notes",ExpressionUUID->"a5265319-94f5-4c75-a5f1-f9fd292b493e"],

Cell["\<\
A list that does not return to its first point is the open polyline, as \
before.\
\>", "Notes",ExpressionUUID->"3d30529d-5cb5-4fa3-80c8-42c3e3d4a4a6"],

Cell[TextData[{
 "A polyline arc reads each piece on the band of the circle through its own \
first point. Its members concatenate one arc per piece, so its ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62776366-c792-4518-a3ab-9578273023ad"],
 " is the product over the pieces."
}], "Notes",ExpressionUUID->"ac7e40b8-f07b-4507-83a8-09e33e1eb876"]
}, Open  ]],

