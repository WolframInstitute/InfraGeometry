Cell[TextData[{
 "The closed arc through ",
 StyleBox["p", "TI"],
 " has the members of the circle of the same band that pass through ",
 StyleBox["p", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"75173d37-f81c-4af4-989d-b9e2520966cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"InfraCircle", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"InfraArc", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{"{", 
             RowBox[{"p", ",", " ", "p"}], "}"}], ",", " ", 
            RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "2"}]}], "]"}], 
          " ", "->", " ", "$InfraCircleColor"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c", ",",
          " ", "p"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraArc", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "p"}], "}"}], ",", " ", 
         RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "2"}]}], "]"}], ",", 
       " ", "\"\<Cardinality\>\""}], "]"}], ",", "\n", "   ", 
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{"FindInfraRepresentative", "[", 
        RowBox[{"g", ",", " ", "circle", ",", " ", "All"}], "]"}], ",", " ", 
       RowBox[{"_", "?", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"#", ",", " ", "p"}], "]"}], " ", "&"}], ")"}]}]}], "]"}], 
     ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "circle", ",", " ", "\"\<Cardinality\>\""}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0e98f033-d9d6-4902-acb8-435050e4f047"],

