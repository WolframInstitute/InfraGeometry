Cell["\<\
At radius 1 on the grid the only arrows go from a rim vertex to its \
neighbours of degree 1:\
\>", "ExampleText",ExpressionUUID->"aac2fedc-13ef-419c-8c1b-8772c1c73c99"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"ends", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexDegree", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}], " ", "==", " ", "1"}], " ", 
        "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"EdgeList", " ", "@", " ", 
      RowBox[{"BallTopology", "[", 
       RowBox[{"g", ",", " ", "1"}], "]"}]}]}], " ", "===", " ", 
    RowBox[{"Sort", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"DirectedEdge", "[", 
        RowBox[{
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"AdjacencyList", "[", 
           RowBox[{"g", ",", " ", "#"}], "]"}]}], ",", " ", "#"}], "]"}], " ",
        "&"}], " ", "/@", " ", "ends"}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"794a6546-4498-41f2-b939-b41e4c2cd43d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"19e3ba6b-2077-43a4-989f-24dd280da9d6"]
}, Open  ]],

Cell["\<\
On a path the balls shrink towards each end. At radius 2 each end carries a \
chain, and the middle vertex is isolated:\
\>", "ExampleText",ExpressionUUID->"6957b473-59de-4997-be53-787d0b823533"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EdgeList", " ", "@", " ", 
  RowBox[{"BallTopology", "[", 
   RowBox[{
    RowBox[{"PathGraph", "[", 
     RowBox[{"Range", "[", "7", "]"}], "]"}], ",", " ", "2"}], 
   "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"fba4c4d4-0d78-4258-bd76-21767fdac7b8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"2", "\[DirectedEdge]", "1"}], ",", 
   RowBox[{"3", "\[DirectedEdge]", "2"}], ",", 
   RowBox[{"5", "\[DirectedEdge]", "6"}], ",", 
   RowBox[{"6", "\[DirectedEdge]", "7"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"e45b6e53-a3fb-472f-aac2-25cee911bfc6"]
}, Open  ]]
}, Open  ]],

