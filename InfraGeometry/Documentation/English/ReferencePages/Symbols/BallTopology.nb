Cell[TextData[{
 "The ball topology at radius 2 on the discretized plane, the square tiling \
and the hexagonal tiling. An arrow ",
 StyleBox["q", "TI"],
 " \[RightArrow] ",
 StyleBox["p", "TI"],
 " says that the ball at ",
 StyleBox["q", "TI"],
 " contains the ball at ",
 StyleBox["p", "TI"],
 ". The balls nest only near the rim; inside, every vertex is open and closed."
}], "ExampleText",ExpressionUUID->"29577cbb-3b16-4605-b2bf-263b6ecc9dbe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"TopologyGraph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"BallTopology", "[", 
         RowBox[{"g", ",", " ", "2"}], "]"}]}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6400a9fc-7d27-4777-a03c-0f117ef51870"],

