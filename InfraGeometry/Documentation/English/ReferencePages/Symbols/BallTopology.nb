Cell[TextData[{
 "The closure of a vertex is the intersection of the balls of radius ",
 StyleBox["r", "TI"],
 " that contain it, the balls about the vertices of its own ball."
}], "ExampleText",ExpressionUUID->"61692cc1-a5b5-49f4-8ce1-cdc629d366e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"corner", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"VertexDegree", "[", 
           RowBox[{"g", ",", " ", "#"}], "]"}], " ", "==", " ", "1"}], " ", 
         "&"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"closure", " ", "=", " ", 
     RowBox[{"TopologicalClosure", "[", 
      RowBox[{
       RowBox[{"BallTopology", "[", 
        RowBox[{"g", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"{", "corner", "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Complement", "[", 
           RowBox[{"closure", ",", " ", 
            RowBox[{"{", "corner", "}"}]}], "]"}], " ", "->", " ", 
          "StandardRed"}], ",", " ", 
         RowBox[{"corner", " ", "->", " ", "StandardBlue"}]}], "}"}]}], "]"}],
      ",", "\n", "   ", 
     RowBox[{"closure", " ", "==", " ", 
      RowBox[{"Intersection", " ", "@@", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"FindInfraRepresentative", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraBall", "[", 
             RowBox[{"#", ",", " ", "3"}], "]"}]}], "]"}], " ", "&"}], " ", "/@",
          " ", 
         RowBox[{"FindInfraRepresentative", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraBall", "[", 
            RowBox[{"corner", ",", " ", "3"}], "]"}]}], "]"}]}], ")"}]}]}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6647949f-9d28-4941-be98-d34a94c1fb93"],

