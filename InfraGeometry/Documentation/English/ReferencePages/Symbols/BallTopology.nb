Cell[TextData[{
 Cell[BoxData["\"\<Dual\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a0095a7-bdc9-40ff-977f-fd3066cc0b0f"],
 " -> ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0da22f1-c16d-4c0f-b28d-3059d19ddb6b"],
 " reverses every arrow: in the dual topology the closure of a vertex is the \
set of vertices whose ball lies inside its ball."
}], "ExampleText",ExpressionUUID->"6e2f3411-9358-422b-be13-16e2465e3a74"],

