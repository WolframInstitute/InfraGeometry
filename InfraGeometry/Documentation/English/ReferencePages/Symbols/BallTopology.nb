Cell["\<\
At radius 0 there are no edges. At the diameter 16 of the grid all balls are \
the whole grid, and the 96 edges form one directed cycle through the 96 \
vertices:\
\>", "ExampleText",ExpressionUUID->"e611324a-f55d-43fc-a954-8948a2cc2904"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"EdgeCount", " ", "@", " ", 
      RowBox[{"BallTopology", "[", 
       RowBox[{"g", ",", " ", "0"}], "]"}]}], ",", " ", 
     RowBox[{"EdgeCount", " ", "@", " ", 
      RowBox[{"BallTopology", "[", 
       RowBox[{"g", ",", " ", "16"}], "]"}]}], ",", " ", 
     RowBox[{"VertexCount", "[", "g", "]"}], ",", "\n", "   ", 
     RowBox[{"ConnectedGraphQ", " ", "@", " ", 
      RowBox[{"BallTopology", "[", 
       RowBox[{"g", ",", " ", "16"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"72603643-a1d1-46d6-9c99-3d008c6aafb1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "96", ",", "96", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"3eba576f-0970-4ce9-b33b-87af12c61770"]
}, Open  ]]
}, Open  ]],

