Cell[TextData[{
 "The topology gets coarser with the radius: every comparable pair at radius ",
 StyleBox["r", "TI"],
 " is comparable at ",
 StyleBox["r", "TI"],
 " + 1:"
}], "ExampleText",ExpressionUUID->"64c05185-01e6-4f72-9c78-d7af8dd2fdc4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"pairs", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"EdgeList", " ", "@", " ", 
        RowBox[{"TransitiveClosureGraph", " ", "@", " ", 
         RowBox[{"BallTopology", "[", 
          RowBox[{"g", ",", " ", "r"}], "]"}]}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "16"}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{"MapThread", "[", 
     RowBox[{"SubsetQ", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Rest", "[", "pairs", "]"}], ",", " ", 
        RowBox[{"Most", "[", "pairs", "]"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"003aeb31-9ee2-4ecb-b544-91873199f26f"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"eecb5be5-3ac3-4c86-af8e-af313e614e7d"]
}, Open  ]],

Cell["\<\
The share of ordered pairs of distinct vertices that are comparable rises to \
1 at the diameter:\
\>", "ExampleText",ExpressionUUID->"1dbc6fc0-b4cf-4b1c-94f3-9cd3b5a62943"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"n", " ", "=", " ", 
         RowBox[{"VertexCount", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", ",", " ", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"EdgeCount", "[", 
              RowBox[{"TransitiveClosureGraph", " ", "@", " ", 
               RowBox[{"BallTopology", "[", 
                RowBox[{"g", ",", " ", "r"}], "]"}]}], "]"}], " ", "/", " ", 
             RowBox[{"(", 
              RowBox[{"n", " ", 
               RowBox[{"(", 
                RowBox[{"n", " ", "-", " ", "1"}], ")"}]}], ")"}]}], "]"}]}], 
          "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "0", ",", " ", 
           RowBox[{"GraphDiameter", "[", "g", "]"}]}], "}"}]}], "]"}]}], 
      "]"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"name", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<SquareGridGraph\>\"", ",", 
         " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}], ",", "\n",
    "  ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<SquareMeshGraph\>\""}],
      "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d37973d3-f00c-4031-9027-a69f12035fa0"],

