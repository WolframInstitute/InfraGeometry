Cell["\<\
At radius 0 the topology is discrete. At the diameter it is indiscrete, one \
directed cycle through all vertices.\
\>", "ExampleText",ExpressionUUID->"9a38f921-c11f-419e-8e6b-54e8f834009d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"KaryTree", "[", "15", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"TopologyGraph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"BallTopology", "[", 
         RowBox[{"g", ",", " ", "0"}], "]"}]}], "]"}], ",", " ", 
      RowBox[{"TopologyGraph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"BallTopology", "[", 
