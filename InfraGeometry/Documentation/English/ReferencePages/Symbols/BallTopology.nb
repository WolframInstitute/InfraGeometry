Notebook[{

Cell[CellGroupData[{
Cell["BallTopology", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d0d2ea4a-010a-4573-8e4f-48e3a66c7665"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallTopology"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallTopology", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2eadfa1-79e7-42b8-841f-5c85ffe784c2"],
 "\[LineSeparator]",
 "gives the topology on the vertices of ",
 StyleBox["g", "TI"],
 " whose closed sets are generated by the balls of radius ",
 StyleBox["r", "TI"],
 ", as a digraph with an edge ",
 StyleBox["q", "TI"],
 " \[RightArrow] ",
 StyleBox["p", "TI"],
 " when ",
 StyleBox["B\:1d63(p) \[SubsetEqual] B\:1d63(q)", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"9aeb58fb-391e-4de2-b3ba-1b6c3d479577"],

Cell[TextData[{
 "The balls ",
 StyleBox["B\:1d63(v) = {u : d(u, v) \[LessEqual] r}", "TI"],
 " are a subbasis of the closed sets. The closure of a vertex is the \
intersection of the balls that contain it, ",
 StyleBox["cl(p) = {q : B\:1d63(p) \[SubsetEqual] B\:1d63(q)}", "TI"],
 "."
}], "Notes",ExpressionUUID->"697175ed-875a-46c8-8f14-63f74585dd43"],

Cell[TextData[{
 "A finite topology is the same as its specialization preorder, ",
 StyleBox["q \[LessEqual] p", "TI"],
 " when ",
 StyleBox["q \[Element] cl(p)", "TI"],
 ". The digraph has an edge ",
 StyleBox["q", "TI"],
 " \[RightArrow] ",
 StyleBox["p", "TI"],
 " for ",
 StyleBox["q \[LessEqual] p", "TI"],
 ", ",
 StyleBox["q \[NotEqual] p", "TI"],
 ", with the edges implied by transitivity removed. A closed set is a set \
closed under going down the edges; an open set, under going up. Vertices with \
equal balls lie on one directed cycle."
}], "Notes",ExpressionUUID->"a6455186-2410-4160-b68e-8e8b10e37298"],

Cell[TextData[{
 "The digraph has every vertex of ",
 StyleBox["g", "TI"],
 ", so it carries the whole topology. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologicalClosure"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TopologicalClosure", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4f08cc3e-16a8-4ea7-9509-4d2b39cee460"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologicalInterior"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TopologicalInterior", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "94f3b4c8-c100-4a3e-9d29-f733d1b90df9"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologicalBoundary"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TopologicalBoundary", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3a4a776d-0f98-4f0f-89a5-f7028cf45b8e"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologicalNeighborhood"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TopologicalNeighborhood", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6e13d5ef-6136-4aab-bd29-d5b86d292713"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ContinuousMapQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ContinuousMapQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d8ad74c5-dcec-49fb-8ab4-ccb38e516d3f"],
 " take it, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologyGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TopologyGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a46ca3bf-6e33-45fd-a428-53d9df662355"],
 " draws it."
}], "Notes",ExpressionUUID->"6cbffd4b-561a-494d-9a15-00ec64d876d6"],

Cell[TextData[{
 "At radius 0 the topology is discrete. From the diameter of a connected \
graph on it is indiscrete. In between it gets coarser as ",
 StyleBox["r", "TI"],
 " grows: ",
 StyleBox["B\:1d63\:208a\:2081(v)", "TI"],
 " is the set of vertices within distance 1 of ",
 StyleBox["B\:1d63(v)", "TI"],
 ", so ",
 StyleBox["B\:1d63(p) \[SubsetEqual] B\:1d63(q)", "TI"],
 " implies ",
 StyleBox["B\:1d63\:208a\:2081(p) \[SubsetEqual] B\:1d63\:208a\:2081(q)", 
  "TI"],
 "."
}], "Notes",ExpressionUUID->"fef261bc-4ab1-49e8-b32d-bc8718339fd4"],

Cell[TextData[{
 "On ",
 StyleBox["Z\.b2", "TI"],
 " no ball lies in another ball of the same radius. On a patch of the grid \
every edge comes from the rim, and a vertex far from the rim is open and \
closed. A vertex of degree 1 has its ball inside the ball of its neighbour at \
every radius."
}], "Notes",ExpressionUUID->"b9b228eb-4a0e-4e14-9f95-c59eddacade8"],

