      FontSize->0.9 Inherited,ExpressionUUID->
      "a87d0e74-8334-4c64-91f2-774740200b61"],
     " reverses the digraph: the dual topology, whose open sets are the \
closed sets of this one"
    }], "TableText",ExpressionUUID->"4238914e-60d0-4a83-84aa-bea074b65efd"]}
  }]], "3ColumnTableMod",ExpressionUUID->"b547e62a-b907-47f2-b75e-\
7feffe2a74e1"]
}, Open  ]],

