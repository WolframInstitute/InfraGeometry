Notebook[{

Cell[CellGroupData[{
Cell["BallTopology", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1e24db73-9f89-4682-a15e-05d561dcfdab"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallTopology"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallTopology", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d99e91d-d8aa-47a4-8008-272368df9c8d"],
 "\[LineSeparator]",
 "gives the topology on the vertices of ",
 StyleBox["g", "TI"],
 " generated by the closed balls of radius ",
 StyleBox["r", "TI"],
 ", as a digraph: an edge ",
 StyleBox["q", "TI"],
 " \[RightArrow] ",
 StyleBox["p", "TI"],
 " when the ball at ",
 StyleBox["p", "TI"],
 " lies inside the ball at ",
 StyleBox["q", "TI"],
 ", transitive edges removed.",
 "\n"
}], "Usage",ExpressionUUID->"cb9289d2-e979-423a-871f-164af1bbcc01"],

Cell[TextData[{
 "Definition: the closed ball is ",
 StyleBox["B_r(v) = {u : d(u, v) \[LessEqual] r}", "TI"],
 ". The closed balls of radius ",
 StyleBox["r", "TI"],
 " are a subbasis for the closed sets of a topology on the vertices, the ",
 StyleBox["ball topology", "TI"],
 ". The closure of a vertex ",
 StyleBox["p", "TI"],
 " is the intersection of the balls that contain it, ",
 StyleBox["cl(p) = {q : B_r(p) \[SubsetEqual] B_r(q)}", "TI"],
 "."
}], "Notes",ExpressionUUID->"4c5cdece-bfe1-483d-b063-c2d6da0a16bb"],

Cell[TextData[{
 "A finite topology is its ",
 StyleBox["specialization preorder", "TI"],
 ", ",
 StyleBox["q \[LessEqual] p", "TI"],
 " when ",
 StyleBox["q \[Element] cl(p)", "TI"],
 ": the closed sets are the sets closed under going down, the open sets the \
sets closed under going up. The digraph has an edge ",
 StyleBox["q", "TI"],
 " \[RightArrow] ",
 StyleBox["p", "TI"],
 " for each such pair with ",
 StyleBox["q \[NotEqual] p", "TI"],
 ", transitive edges removed. Vertices with equal balls lie on one directed \
cycle."
}], "Notes",ExpressionUUID->"740b2fab-c8e3-4a66-a2d1-387f1cb45311"],

Cell[TextData[{
 "Every vertex of ",
 StyleBox["g", "TI"],
 " is a vertex of the digraph, so the digraph alone carries the topology. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologicalClosure"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TopologicalClosure", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f41b28cc-8f98-40d2-b194-c3616408f9ae"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologicalInterior"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TopologicalInterior", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e2f16f04-b372-4342-af9c-31996f865d79"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologicalBoundary"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TopologicalBoundary", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d5ff0614-7e65-4b0a-91a7-1ab4a4b16a67"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologicalNeighborhood"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TopologicalNeighborhood", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "339228b7-ced6-44fc-b713-eabd7e999279"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ContinuousMapQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ContinuousMapQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "515366ea-44cc-4c92-b349-b458dfb0c25c"],
 " read it, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologyGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TopologyGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "af776cc6-b18e-460b-a1a9-4bc07bfcf249"],
 " draws it."
}], "Notes",ExpressionUUID->"0699fffd-4c67-40bc-ba6e-e76549d8504b"],

Cell[TextData[{
 "At radius 0 the topology is discrete: no edges. At a radius of at least the \
diameter of a connected graph it is indiscrete: one directed cycle through \
every vertex. In between it only coarsens. The ball ",
 StyleBox["B_(r+1)(v)", "TI"],
 " is the set of vertices within distance 1 of ",
 StyleBox["B_r(v)", "TI"],
 ", so ",
 StyleBox["B_r(p) \[SubsetEqual] B_r(q)", "TI"],
 " gives ",
 StyleBox["B_(r+1)(p) \[SubsetEqual] B_(r+1)(q)", "TI"],
 "."
}], "Notes",ExpressionUUID->"fc36ef90-9888-41db-afce-529a348fef21"],

Cell[TextData[{
 "In a tiling no ball lies inside another ball of the same radius. On a patch \
of a tiling, therefore, an edge ",
 StyleBox["q", "TI"],
 " \[RightArrow] ",
 StyleBox["p", "TI"],
 " needs the ball at ",
 StyleBox["p", "TI"],
 " cut by the rim, and the topology is discrete away from the rim. On a tree \
the balls nest along every branch."
}], "Notes",ExpressionUUID->"5e26e087-e93e-4e6c-ae61-32f349bf9418"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["\"\<Dual\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "009e7ddf-eb4a-479f-8236-a5525f1c2824"],
 " -> ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4de3518c-8a58-4e37-89d3-67963cc2cc27"],
 " reverses the digraph. That is the preorder of the dual topology, whose \
open sets are the closed sets of this one."
}], "Notes",ExpressionUUID->"e7906156-1866-41b6-8680-e24e76c6ab21"]
}, Open  ]],

