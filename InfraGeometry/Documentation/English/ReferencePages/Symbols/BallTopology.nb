Cell["\<\
On a binary tree the balls nest along every branch, at radii 1, 2 and 3. From \
radius 2 on, two leaves with one parent have equal balls and form a directed \
2-cycle.\
\>", "ExampleText",ExpressionUUID->"be80b068-8048-4828-9325-a12b1c99dc80"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"KaryTree", "[", "31", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"TopologyGraph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"BallTopology", "[", 
         RowBox[{"g", ",", " ", "r"}], "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
