Cell["\<\
The topology coarsens as the radius grows. The fraction of ordered pairs of \
distinct vertices that are comparable rises to 1 at the diameter.\
\>", "ExampleText",ExpressionUUID->"4ebef2c9-0f8d-4418-b9e4-156ad5558823"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
       "\n", "      ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", ",", " ", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"EdgeCount", "[", 
              RowBox[{"TransitiveClosureGraph", " ", "@", " ", 
               RowBox[{"BallTopology", "[", 
                RowBox[{"g", ",", " ", "r"}], "]"}]}], "]"}], " ", "/", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"VertexCount", "[", "g", "]"}], " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"VertexCount", "[", "g", "]"}], " ", "-", " ", "1"}],
                 ")"}]}], ")"}]}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "0", ",", " ", 
           RowBox[{"GraphDiameter", "[", "g", "]"}]}], "}"}]}], "]"}]}], 
      "]"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"name", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
         " ", "\"\<SquareTilingGraph\>\"", ",", 
         " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], ",", 
   "\n", "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
       ",", " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<r\>\"", ",", " ", "\"\<comparable\>\""}], "}"}]}]}], 
  "]"}]], "Input",
