Cell[TextData[{
 "The ball topology of radius 2 on the square grid and on the square mesh. An \
arrow ",
 StyleBox["q", "TI"],
 " \[RightArrow] ",
 StyleBox["p", "TI"],
 " says that the ball at ",
 StyleBox["q", "TI"],
 " contains the ball at ",
 StyleBox["p", "TI"],
 ". The arrows stay near the rim:"
}], "ExampleText",ExpressionUUID->"4baca290-cb15-44e1-ac8c-8f5a23318cec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"TopologyGraph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"BallTopology", "[", 
         RowBox[{"g", ",", " ", "2"}], "]"}]}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"5875363c-b40e-4351-b864-a372de9c8e83"],

