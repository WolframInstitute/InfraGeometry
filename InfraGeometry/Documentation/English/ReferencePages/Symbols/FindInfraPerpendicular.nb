Cell[CellGroupData[{

Cell["Radius", "ExampleSubsection",ExpressionUUID->"f99b1fd0-db07-4bb1-85ea-f28080beb49e"],

Cell["\<\
On the square grid a point at distance 2 from a line has 548 perpendiculars. \
Built inside the balls of radius 2, 3 and 4 about the point, there are 0, 6 \
and 12. The ball of radius 2 holds the two nearest vertices of the line but \
not the centre of the base they span, so it holds no foot:\
\>", "ExampleText",ExpressionUUID->"9429b356-e99d-4e42-bb18-09a49ca11ab8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"RandomInfraInfiniteLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "q", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"line", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Append", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"r", " ", "->", " ", 
        RowBox[{"Length", " ", "@", " ", 
         RowBox[{"FindInfraPerpendicular", "[", 
          RowBox[{"g", ",", " ", "line", ",", " ", "p", ",", " ", 
           RowBox[{"UpTo", "[", "1000", "]"}], ",", " ", 
           RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]}], "]"}]}]}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "2", ",", " ", "4"}], "}"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"All", " ", "->", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"FindInfraPerpendicular", "[", 
        RowBox[{"g", ",", " ", "line", ",", " ", "p"}], "]"}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b53622bd-90b4-49b5-b311-a532674d1b32"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"2", "\[Rule]", "0"}], ",", 
   RowBox[{"3", "\[Rule]", "6"}], ",", 
   RowBox[{"4", "\[Rule]", "12"}], ",", 
   RowBox[{"All", "\[Rule]", "548"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"15875e67-57b8-413d-8698-6719e910a1b3"]
}, Open  ]],

Cell["\<\
When the ball meets the line only in its nearest vertex, that vertex is the \
foot. On the 5 \[Times] 5 grid the ball of radius 2 about the centre 13 meets \
the side 1, \[Ellipsis], 5 only in 3, and every perpendicular passes through \
3:\
\>", "ExampleText",ExpressionUUID->"be50e352-0970-485b-b12d-5cb1005ced5f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"perpendiculars", " ", "=", " ", 
     RowBox[{"FindInfraPerpendicular", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Range", "[", "5", "]"}], ",", " ", "13", ",", " ", 
       RowBox[{"UpTo", "[", "10", "]"}], ",", " ", 
       RowBox[{"\"\<Radius\>\"", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Range", "[", "5", "]"}], ",", " ", "perpendiculars", ",", " ",
        "13"}], "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Length", "[", "perpendiculars", "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"fecb785f-a184-4c09-b1a8-1103c81b6e10"],

