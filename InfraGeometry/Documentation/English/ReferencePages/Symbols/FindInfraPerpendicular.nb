Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "91ad2cf0-ce78-49e0-882e-be462d5c102a"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73ececd3-719f-447d-8662-85538d1b526e"],
 " or ",
