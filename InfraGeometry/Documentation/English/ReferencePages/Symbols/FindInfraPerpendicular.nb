Notebook[{

Cell[CellGroupData[{
Cell["FindInfraPerpendicular", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"94304f55-dcf6-4f05-80dd-4540efd7d974"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPerpendicular"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["point", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d7a3997-9755-41c6-ad6b-4c8f91bc0c14"],
 "\[LineSeparator]",
 "gives the lines through ",
 StyleBox["point", "TI"],
 " perpendicular to ",
 StyleBox["line", "TI"],
 ", as a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d9be03c-4adc-41d9-a22a-37d6a8f824b6"],
 " of directed path graphs.",
 "\n",
 "A count ",
 StyleBox["n", "TI"],
 " gives exactly ",
 StyleBox["n", "TI"],
 " or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a301102-f69b-4311-8df5-a5c4e350bc33"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5123a4c8-b555-4c4a-b0b5-a4077df391aa"],
 " up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a58b4a9-28a4-46a6-92f5-bcd930938214"],
 " all of them."
}], "Usage",ExpressionUUID->"53b3c2cf-f870-431c-a52d-e197b35facaf"],

Cell[TextData[{
 "Definition, with the default ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Metric\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5de8fc44-4126-4098-b4b7-7be183e24767"],
 ": this is Euclid I.12. Take an isosceles base on the line, find its \
midpoint \[LongDash] the foot \[LongDash] and return the maximal lines \
through the foot and the point."
}], "Notes",ExpressionUUID->"a85e4538-bd11-4231-9c71-a38954ba7c4e"],

Cell["Two consequences follow from that construction.", "Notes",ExpressionUUID->"922e99ec-1e47-4b37-89d2-15388f51f36a"],

Cell[TextData[{
 "It returns nothing when ",
 StyleBox["point", "TI"],
 " lies ",
 StyleBox["on",
  FontWeight->"Bold"],
 " ",
 StyleBox["line", "TI"],
 ". The construction needs a foot distinct from the point, and there is none. \
Erecting a perpendicular at a point of the line is Euclid I.11, a different \
proposition."
}], "Notes",ExpressionUUID->"c1d540e7-a706-42a6-94db-1f4c27a01acb"],

Cell[TextData[{
 "The count is very large. On an 81-vertex square patch, a point off a line \
admits 6381 perpendiculars. This is the same combinatorial explosion as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraInfiniteLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraInfiniteLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "83b877eb-5870-4b0f-8e06-632c40a46040"],
 ", and it has the same cause: a maximal shortest path on a lattice has many \
admissible continuations."
}], "Notes",ExpressionUUID->"fe25c2df-e3dd-4c0f-889f-9832f0fd581f"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["\"\<Radius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a74dde1a-3f38-42b7-8454-26d23cfd82ba"],
 " is the lever that makes it usable. ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8aad8c42-775f-4bbe-9db1-bde0972b8f87"],
 " localises both the candidate enumeration and the test to the ",
 StyleBox["r", "TI"],
 "-neighbourhood of the point. On that same patch the count falls to 110 at \
radius 3 and 26 at radius 2. Perpendicularity is a local notion, so \
localising it is not a compromise."
}], "Notes",ExpressionUUID->"21642b1f-bce2-400d-8d8b-5b08ce19adbc"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98de5ea8-727e-49f8-a915-943bdc15ca86"],
 " also takes the ",
 Cell[BoxData["Q"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb919754-4a0a-4212-93b2-0763ca793069"],
 "-side families \[LongDash] ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a91d44d-91ab-453b-a52f-39174f3fbbbb"],
 ", ",
 Cell[BoxData["\"\<Coordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2d08923-672c-4c99-a75e-b02bea3434c7"],
 ", ",
 Cell[BoxData["\"\<Arclength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c698842-af9b-4654-9a9f-fd2503bb1fb2"],
 ", ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cae1f12e-f1a0-4cc7-b5e8-5ce686427eb2"],
 " \[LongDash] which enumerate maximal shortest paths through the point and \
filter them with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f8db9ac4-563f-4ab9-8329-ef679150d9b3"],
 ". Sub-options belong inside the method spec and are passed through."
}], "Notes",ExpressionUUID->"19ab7437-83a2-4268-809e-644c232115d2"],

Cell[TextData[{
 "The result need not satisfy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9d7b419f-5eb5-4075-8f1d-d2a9a4c9e87f"],
 " under its default settings. The default ",
 Cell[BoxData["\"\<Metric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1f60f4f-afee-4cad-9cd7-4fd17138d22e"],
 " construction is Euclid's, while the predicate tests a projection \
condition, and on a lattice the two do not coincide. See that page for which \
equality setting reconciles them."
}], "Notes",ExpressionUUID->"5fd90e62-98ed-4de1-897c-01a272ba8f44"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"dc89e854-2233-445f-8597-879722e15a5f"],

