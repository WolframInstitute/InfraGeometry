Cell["\<\
A perpendicular can run along the line. On the square grid one of the 548 \
perpendiculars above shares 8 vertices with the line:\
\>", "ExampleText",ExpressionUUID->"8d0208e8-4468-48d6-917a-1a1a406a522c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"RandomInfraInfiniteLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "q", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"line", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"shared", " ", "=", " ", 
     RowBox[{
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"Intersection", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "#", "]"}], ",", " ", "line"}], "]"}]}], 
      " ", "&"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"widest", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"MaximalBy", "[", 
       RowBox[{
        RowBox[{"FindInfraPerpendicular", "[", 
         RowBox[{"g", ",", " ", "line", ",", " ", "p"}], "]"}], ",", " ", 
        "shared"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"line", ",", " ", "widest", ",", " ", "p"}], "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"shared", "[", "widest", "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"87aa2c2b-6dd4-451e-866d-d80f4144ecc0"],

