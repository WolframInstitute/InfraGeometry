Cell["\<\
A point on the line yields nothing. That is Euclid I.11, not I.12.\
\>", "ExampleText",ExpressionUUID->"e7b01a62-a5cb-490b-ac9a-dcefd32ca204"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Length", " ", "@", " ", 
    RowBox[{"FindInfraPerpendicular", "[", 
     RowBox[{"g", ",", " ", "line", ",", " ", "c", ",", " ", "All"}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2e562b72-e1f0-4210-ae3b-37db1d852e1d"],

Cell[BoxData["0"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c2243433-6ffe-4f59-918a-3e1e45e1be24"]
}, Open  ]],

Cell[TextData[{
 "Off the line, the family is large, and ",
 Cell[BoxData["\"\<Radius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a59f8dab-cc29-4017-86cf-af1ffae0ad5c"],
 " controls it."
}], "ExampleText",ExpressionUUID->"f016e2b7-5167-4622-9864-87b62780a26f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ",
           "2"}], " ", "&&", " ", 
         RowBox[{"!", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"line", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Association", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"r", " ", "->", " ", 
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"FindInfraPerpendicular", "[", 
         RowBox[{
         "g", ",", " ", "line", ",", " ", "p", ",", " ", "All", ",", " ", 
          RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]}], "]"}]}]}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c692d744-e2e4-4e1b-b706-6b8324ed4f09"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"2", "\[Rule]", "26"}], ",", 
   RowBox[{"3", "\[Rule]", "110"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"0952809c-56e3-44c2-9599-88bc4a038467"]
}, Open  ]],

Cell["\<\
Three perpendiculars through a point, drawn with the line they cross.\
\>", "ExampleText",ExpressionUUID->"311505e2-1a10-4f68-bc2e-a7bad91b4099"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
