Cell["\<\
A point on the line yields nothing. That is Euclid I.11, not I.12.\
\>", "ExampleText",ExpressionUUID->"d939672f-d3e4-490d-b471-6d528c66c0cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Length", " ", "@", " ", 
    RowBox[{"FindInfraPerpendicular", "[", 
     RowBox[{"g", ",", " ", "line", ",", " ", "c", ",", " ", "All"}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"dbed0d82-069e-441c-8e8c-faa8edeb83a7"],

Cell[BoxData["0"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"bb32da9f-8d29-4853-bb25-3d320ffb8dc0"]
}, Open  ]],

Cell[TextData[{
 "Off the line, the family is large, and ",
 Cell[BoxData["\"\<Radius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3654211b-2873-470c-bbef-227af819ce03"],
 " controls it."
}], "ExampleText",ExpressionUUID->"5af843b8-ef2e-4084-9f13-239f56911552"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ",
           "2"}], " ", "&&", " ", 
         RowBox[{"!", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"line", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Association", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"r", " ", "->", " ", 
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"FindInfraPerpendicular", "[", 
         RowBox[{
         "g", ",", " ", "line", ",", " ", "p", ",", " ", "All", ",", " ", 
          RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]}], "]"}]}]}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3fad3f2e-7256-459f-9c4d-1110103e6410"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"2", "\[Rule]", "26"}], ",", 
   RowBox[{"3", "\[Rule]", "110"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"b93f02da-850f-41bf-bde8-8d6267f0adbb"]
}, Open  ]],

Cell["\<\
Three perpendiculars through a point, drawn with the line they cross.\
\>", "ExampleText",ExpressionUUID->"b48a4d03-bb46-4861-acd8-e3f770044ddf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", "\"\<Gray\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
