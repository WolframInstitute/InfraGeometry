    }], "TableText",ExpressionUUID->"2a0f5fa3-1b3d-4b6f-9e45-e8881eedebc9"]}
  }]], "3ColumnTableMod",ExpressionUUID->"d00b700f-a86a-418e-9c7b-\
23f1b95c005e"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14ed51ff-3617-4a35-83ef-a067ad3a085d"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fee06142-6203-4c7a-94dc-1e87a49022ba"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f27d5d59-680a-4fd6-868a-0660a7b272cc"],
 ", the default. Fewer than ",
 StyleBox["n", "TI"],
 " perpendiculars give ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41b00db4-d5a0-4477-b9c1-a430866ce39d"],
 ", and ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "021dd837-3f86-4bb5-9753-954a7646b398"],
 " with a single perpendicular gives that graph rather than a list."
}], "Notes",ExpressionUUID->"a0919fd0-f9c6-403c-9397-92d5f9466e4c"],

