Notebook[{

Cell[CellGroupData[{
Cell["FindInfraPerpendicular", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e50b65eb-e5cf-4477-8776-2cced4ecfe68"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPerpendicular"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a790a24-71ea-4f1b-a7bd-2b2bbcf17960"],
 "\[LineSeparator]",
 "gives the lines through the vertex ",
 StyleBox["p", "TI"],
 " perpendicular to ",
 StyleBox["line", "TI"],
 ", as a list of directed path graphs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"633bfeba-6c19-464c-84ca-106cf2cac4a9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPerpendicular"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "365870e8-afd1-47c4-855b-112817bc379e"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["n", "TI"],
 " of them."
}], "Usage",ExpressionUUID->"8fce0336-c108-4a2a-a04b-10acec8dc56b"],

Cell[TextData[{
 "The default construction is Euclid I.12. Two vertices ",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["b", "TI"],
 " of the line at the same distance from ",
 StyleBox["p", "TI"],
 " are the base of an isosceles triangle; the midpoint of the base along the \
line is a foot ",
 StyleBox["f", "TI"],
 ". When one vertex of the line is nearest to ",
 StyleBox["p", "TI"],
 " it is a foot too: the circle about ",
 StyleBox["p", "TI"],
 " through it touches the line there. The perpendiculars are the longest \
lines through a foot ",
 StyleBox["f", "TI"],
 " and ",
 StyleBox["p", "TI"],
 "; a shorter line through ",
 StyleBox["f", "TI"],
 " and ",
 StyleBox["p", "TI"],
 " is not returned."
}], "Notes",ExpressionUUID->"02cebd36-66a6-46bd-91ef-ff94b03b92f3"],

Cell[TextData[{
 "When ",
 StyleBox["p", "TI"],
 " lies on the line there is no foot apart from ",
 StyleBox["p", "TI"],
 ", and the result is ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca285735-1550-4a3c-88c6-995aad4fcefe"],
 ". Erecting a perpendicular at a point of the line is Euclid I.11."
}], "Notes",ExpressionUUID->"dce6fc63-490b-4a02-901c-bddd6c6363a9"],

Cell[TextData[{
 "A point off a line has many perpendiculars. They need not satisfy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "402b5db1-66e8-4907-9e38-3ce33ef6c838"],
 ", which tests a projection condition instead."
}], "Notes",ExpressionUUID->"caf1a905-2fbe-4914-81d3-a1c829683881"],

