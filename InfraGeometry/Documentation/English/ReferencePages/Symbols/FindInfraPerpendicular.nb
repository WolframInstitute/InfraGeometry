Notebook[{

Cell[CellGroupData[{
Cell["FindInfraPerpendicular", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4aa18de4-54d7-46b1-8224-2b39a0d06591"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPerpendicular"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["point", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c11850f-dbff-4c32-9ade-be612083a2fc"],
 "\[LineSeparator]",
 "gives the lines through ",
 StyleBox["point", "TI"],
 " perpendicular to ",
 StyleBox["line", "TI"],
 ", as a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df02201f-6d7b-4489-bf3d-d78ab1faa657"],
 " of directed path graphs.",
 "\n",
 "A count ",
 StyleBox["n", "TI"],
 " gives exactly ",
 StyleBox["n", "TI"],
 " or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "494bb49d-5a0d-42c4-82bc-840552705ffa"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba77e7a3-a256-4782-a822-c37f9efbb217"],
 " up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93e88e54-6c7c-4e31-92ef-14e526a8775a"],
 " all of them."
}], "Usage",ExpressionUUID->"3d707e99-3c3d-45f8-b2bc-ef43c8c50bc7"],

Cell[TextData[{
 "Definition, with the default ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Metric\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "004f40aa-9d46-44cc-8903-1b2b29bc9114"],
 ": this is Euclid I.12. Take an isosceles base on the line, find its \
midpoint \[LongDash] the foot \[LongDash] and return the maximal lines \
through the foot and the point."
}], "Notes",ExpressionUUID->"c3f7a888-cb3f-44df-8ebe-66cabfe42205"],

Cell["Two consequences follow from that construction.", "Notes",ExpressionUUID->"be7651db-d16f-4ff7-9883-fd60381102e0"],

Cell[TextData[{
 "It returns nothing when ",
 StyleBox["point", "TI"],
 " lies ",
 StyleBox["on",
  FontWeight->"Bold"],
 " ",
 StyleBox["line", "TI"],
 ". The construction needs a foot distinct from the point, and there is none. \
Erecting a perpendicular at a point of the line is Euclid I.11, a different \
proposition."
}], "Notes",ExpressionUUID->"de09a532-b210-40af-8787-a45470d145e6"],

Cell[TextData[{
 "The count is very large. On an 81-vertex square patch, a point off a line \
admits 6381 perpendiculars. This is the same combinatorial explosion as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4394c6bd-47ff-4858-9d8b-e30823ed7fd5"],
 ", and it has the same cause: a maximal geodesic on a lattice has many \
admissible continuations."
}], "Notes",ExpressionUUID->"626ccd88-dd34-43da-b7e7-62f6246288aa"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["\"\<Radius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58eda86e-56c8-4d51-9665-709effed2085"],
 " is the lever that makes it usable. ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa862a8b-bef1-4037-bb8d-43438cee1421"],
 " localises both the candidate enumeration and the test to the ",
 StyleBox["r", "TI"],
 "-neighbourhood of the point. On that same patch the count falls to 110 at \
radius 3 and 26 at radius 2. Perpendicularity is a local notion, so \
localising it is not a compromise."
}], "Notes",ExpressionUUID->"bb9d8486-dda7-4b30-9fae-4f4e7bcdd3b6"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff7743fa-0dd5-4a07-8535-42e7ea105d01"],
 " also takes the ",
 Cell[BoxData["Q"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c09f1664-ac0c-428b-8328-0e759e953872"],
 "-side families \[LongDash] ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e36f3da-af3a-4b18-8b10-938ee13ab879"],
 ", ",
 Cell[BoxData["\"\<Coordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b954102-d0ee-4715-920b-42ae22851f6b"],
 ", ",
 Cell[BoxData["\"\<Arclength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca0c74a2-0954-4a7b-ab5a-cf95ddf50cc3"],
 ", ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1cfabb5-45f8-4420-be08-b0b8847aac0f"],
 " \[LongDash] which enumerate maximal geodesics through the point and filter \
them with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "348753f8-bc4c-4e52-828f-eb0f8212906f"],
 ". Sub-options belong inside the method spec and are passed through."
}], "Notes",ExpressionUUID->"8c128d53-0bc8-4558-810c-6020d7fcb706"],

Cell[TextData[{
 "The result need not satisfy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9ecdea3b-fa96-4090-a591-08f546cd51ce"],
 " under its default settings. The default ",
 Cell[BoxData["\"\<Metric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6b4a972-c29a-46cf-abfd-c0b52e93beb8"],
 " construction is Euclid's, while the predicate tests a projection \
condition, and on a lattice the two do not coincide. See that page for which \
equality setting reconciles them."
}], "Notes",ExpressionUUID->"82c52cba-2529-439a-a4b1-dad6189822ae"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"b57d8327-b232-48ea-8d4c-6cf1213e2ea9"],

