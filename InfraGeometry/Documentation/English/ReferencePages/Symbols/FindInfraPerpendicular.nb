Notebook[{

Cell[CellGroupData[{
Cell["FindInfraPerpendicular", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9f8ff747-095e-41b4-aaef-0be67d9e1ff5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPerpendicular"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["point", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b406aa4-e443-4c44-b8e9-c0d30852fb8d"],
 "\[LineSeparator]",
 "gives the lines through ",
 StyleBox["point", "TI"],
 " perpendicular to ",
 StyleBox["line", "TI"],
 ", as a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ad5fdfd-0f15-4843-8d14-f9284921de87"],
 " of directed path graphs.",
 "\n",
 "A count ",
 StyleBox["n", "TI"],
 " gives exactly ",
 StyleBox["n", "TI"],
 " or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3469764f-954d-40f5-b21b-2c6429055633"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53196e9d-180e-441a-a2c8-47e17457a23e"],
 " up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e99da8ea-fa22-4c6d-89f6-1eabafd25a13"],
 " all of them."
}], "Usage",ExpressionUUID->"c4db86a1-ce3f-44af-ad5a-d95a633ac871"],

Cell[TextData[{
 "Definition, with the default ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Metric\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "906d4f7a-f000-4217-97db-b94d87aeac34"],
 ": this is Euclid I.12. Take an isosceles base on the line, find its \
midpoint \[LongDash] the foot \[LongDash] and return the maximal lines \
through the foot and the point."
}], "Notes",ExpressionUUID->"fd06ebe0-0b7b-4217-bee9-3b66045646c7"],

Cell["Two consequences follow from that construction.", "Notes",ExpressionUUID->"0af65782-2a37-4cb8-9ab4-0d1bc9cb4d72"],

Cell[TextData[{
 "It returns nothing when ",
 StyleBox["point", "TI"],
 " lies ",
 StyleBox["on",
  FontWeight->"Bold"],
 " ",
 StyleBox["line", "TI"],
 ". The construction needs a foot distinct from the point, and there is none. \
Erecting a perpendicular at a point of the line is Euclid I.11, a different \
proposition."
}], "Notes",ExpressionUUID->"b3256b7c-543f-4ba4-a528-36b07678a1af"],

Cell[TextData[{
 "The count is very large. On an 81-vertex square patch, a point off a line \
admits 6381 perpendiculars. This is the same combinatorial explosion as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0b8b0392-34ca-429b-aecf-7bdf9c69dceb"],
 ", and it has the same cause: a maximal shortest path on a lattice has many \
admissible continuations."
}], "Notes",ExpressionUUID->"b051557e-f9d7-47a1-9e0c-a07d3b3f289d"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["\"\<Radius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec0c31be-0d72-4443-9627-41237fbe55de"],
 " is the lever that makes it usable. ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75a4175e-12e0-452f-823d-8c5f87d3e993"],
 " localises both the candidate enumeration and the test to the ",
 StyleBox["r", "TI"],
 "-neighbourhood of the point. On that same patch the count falls to 110 at \
radius 3 and 26 at radius 2. Perpendicularity is a local notion, so \
localising it is not a compromise."
}], "Notes",ExpressionUUID->"5fca722f-a0ea-4a50-b5f1-030702d3d71a"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5113229-41b2-4ffe-90a9-899aac371aca"],
 " also takes the ",
 Cell[BoxData["Q"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd880767-7c13-427f-9627-6ecfe0d6ed91"],
 "-side families \[LongDash] ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "062f1ae8-5b7f-4be4-97a2-b77d4e3bd902"],
 ", ",
 Cell[BoxData["\"\<Coordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d13c9223-be51-4d36-a6af-501cd251cc1d"],
 ", ",
 Cell[BoxData["\"\<Arclength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e210467-4dd9-425a-9607-10d2c589a9f8"],
 ", ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ff2595d-dbdb-4f70-8cf8-ef0164894af4"],
 " \[LongDash] which enumerate maximal shortest paths through the point and \
filter them with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d845dba4-4138-4c35-ada7-8cfe75ae348e"],
 ". Sub-options belong inside the method spec and are passed through."
}], "Notes",ExpressionUUID->"b90a693d-7052-4601-a3f8-7ffff07afb78"],

Cell[TextData[{
 "The result need not satisfy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6f87e82f-5787-46f0-9442-46c2292d74ba"],
 " under its default settings. The default ",
 Cell[BoxData["\"\<Metric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d8fa63e-4ca5-4ffa-ae29-d001d2a45039"],
 " construction is Euclid's, while the predicate tests a projection \
condition, and on a lattice the two do not coincide. See that page for which \
equality setting reconciles them."
}], "Notes",ExpressionUUID->"935c4105-5a5f-444e-9c48-9bf0647d89ab"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"ba526cd2-3a0b-4391-8ebd-950b884d5912"],

