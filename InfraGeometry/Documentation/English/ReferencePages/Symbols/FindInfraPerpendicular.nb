Cell[CellGroupData[{

Cell["Radius", "ExampleSubsection",ExpressionUUID->"9459aaad-5b8b-4a60-80d6-e0462ebc656f"],

Cell["\<\
On the square grid a point at distance 2 from a line has 548 perpendiculars. \
Built inside the balls of radius 2, 3 and 4 about the point, there are 0, 6 \
and 12. The ball of radius 2 holds the two nearest vertices of the line but \
not the midpoint of the base they span, so it holds no foot:\
\>", "ExampleText",ExpressionUUID->"e3c809f3-0c2e-4786-9cac-49c9593ac16c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"RandomInfraInfiniteLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "q", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"line", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Append", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"r", " ", "->", " ", 
        RowBox[{"Length", " ", "@", " ", 
         RowBox[{"FindInfraPerpendicular", "[", 
          RowBox[{"g", ",", " ", "line", ",", " ", "p", ",", " ", 
           RowBox[{"UpTo", "[", "1000", "]"}], ",", " ", 
           RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]}], "]"}]}]}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "2", ",", " ", "4"}], "}"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"All", " ", "->", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"FindInfraPerpendicular", "[", 
        RowBox[{"g", ",", " ", "line", ",", " ", "p"}], "]"}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2bcf3622-5164-483b-a1ea-86a975f4f935"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"2", "\[Rule]", "0"}], ",", 
   RowBox[{"3", "\[Rule]", "6"}], ",", 
   RowBox[{"4", "\[Rule]", "12"}], ",", 
   RowBox[{"All", "\[Rule]", "548"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"70dc6a13-e792-4454-bfbd-15cc09d7209c"]
}, Open  ]],

Cell["\<\
When the ball meets the line only in its nearest vertex, that vertex is the \
foot. On the 5 \[Times] 5 grid the ball of radius 2 about the centre 13 meets \
the side 1, \[Ellipsis], 5 only in 3, and every perpendicular passes through \
3:\
\>", "ExampleText",ExpressionUUID->"2a77cc13-ea5e-416e-b3d6-737985e0be4d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"perpendiculars", " ", "=", " ", 
     RowBox[{"FindInfraPerpendicular", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Range", "[", "5", "]"}], ",", " ", "13", ",", " ", 
       RowBox[{"UpTo", "[", "10", "]"}], ",", " ", 
       RowBox[{"\"\<Radius\>\"", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Range", "[", "5", "]"}], ",", " ", "perpendiculars", ",", " ",
        "13"}], "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Length", "[", "perpendiculars", "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"bc95ee76-aae6-4d08-9d9b-6d308d6b09a4"],

