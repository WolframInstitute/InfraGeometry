Notebook[{

Cell[CellGroupData[{
Cell["FindInfraPerpendicular", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"daf24bd7-6809-41f5-ab08-c0777210756e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPerpendicular"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ff6b1bb-c46f-4462-b7f2-5e7979698cca"],
 "\[LineSeparator]",
 "gives the lines through the vertex ",
 StyleBox["p", "TI"],
 " perpendicular to ",
 StyleBox["line", "TI"],
 ", as a list of directed path graphs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"9f239e49-1c74-4826-8dbb-468aa6f23419"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPerpendicular"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14418015-9a18-451d-93dd-73d26bd8beb8"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["n", "TI"],
 " of them."
}], "Usage",ExpressionUUID->"4b672b90-d051-4664-b5ed-4cc43b77f25c"],

Cell[TextData[{
 "The default construction is Euclid I.12. Two vertices ",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["b", "TI"],
 " of the line at the same distance from ",
 StyleBox["p", "TI"],
 " are the base of an isosceles triangle; the centre vertex of the base along \
the line is a foot ",
 StyleBox["f", "TI"],
 ", and a base with an even number of vertices has two. When one vertex of \
the line is nearest to ",
 StyleBox["p", "TI"],
 " it is a foot too: the circle about ",
 StyleBox["p", "TI"],
 " through it touches the line there. The perpendiculars are the longest \
lines through a foot ",
 StyleBox["f", "TI"],
 " and ",
 StyleBox["p", "TI"],
 "; a shorter line through ",
 StyleBox["f", "TI"],
 " and ",
 StyleBox["p", "TI"],
 " is not returned."
}], "Notes",ExpressionUUID->"48318ce2-5d37-46b6-a8b8-57ab90962b27"],

Cell[TextData[{
 "When ",
 StyleBox["p", "TI"],
 " lies on the line there is no foot apart from ",
 StyleBox["p", "TI"],
 ", and the result is ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8091eae-6608-444e-81b8-395a4d5fafaf"],
 ". Erecting a perpendicular at a point of the line is Euclid I.11."
}], "Notes",ExpressionUUID->"6e5aa01c-12c6-4193-9aca-2aae77b13504"],

Cell[TextData[{
 "A point off a line has many perpendiculars. They need not satisfy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fb6a0330-d004-4b19-807e-f06af0cea443"],
 ", which tests a projection condition instead."
}], "Notes",ExpressionUUID->"4afc6003-29f2-42b5-9019-8b0a42967bee"],

