Notebook[{

Cell[CellGroupData[{
Cell["FindInfraPerpendicular", "ObjectName",ExpressionUUID->"89d120d9-25ab-4018-b2f9-083135c3d0d0"],

Cell["LLM generated.", "Notes",ExpressionUUID->"0e0201d9-3489-4735-ab40-48a4c5d508dc"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"518762ad-373b-46a0-9277-d75013c62333"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPerpendicular"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["point", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fa20c37-f32b-47fc-bbbb-32de93400140"],
 "\[LineSeparator]",
 "gives the lines through ",
 StyleBox["point", "TI"],
 " perpendicular to ",
 StyleBox["line", "TI"],
 ", as a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0acd52fb-9eac-447a-967c-af737d04cbaa"],
 " of directed path graphs.",
 "\n",
 "A count ",
 StyleBox["n", "TI"],
 " gives exactly ",
 StyleBox["n", "TI"],
 " or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f573e8ff-db9e-4b24-8757-14d303a46c05"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de211e77-9aca-4947-84ed-0365ca3b1c1f"],
 " up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bda9199-9119-4533-94f9-6ce0abfcf658"],
 " all of them."
}], "Usage",ExpressionUUID->"02014931-e48f-4700-8291-09effbdbc3fd"],

Cell[TextData[{
 "Definition, with the default ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Metric\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4134c4aa-2cf5-400f-8b8a-a4b6a3d42557"],
 ": this is Euclid I.12. Take an isosceles base on the line, find its \
midpoint \[LongDash] the foot \[LongDash] and return the maximal lines \
through the foot and the point."
}], "Notes",ExpressionUUID->"6eb44ef0-293c-4253-9c21-3b705bb848a7"],

Cell["Two consequences follow from that construction.", "Notes",ExpressionUUID->"4b655b48-f078-4c77-ba18-02752d05f2d4"],

Cell[TextData[{
 "It returns nothing when ",
 StyleBox["point", "TI"],
 " lies ",
 StyleBox["on",
  FontWeight->"Bold"],
 " ",
 StyleBox["line", "TI"],
 ". The construction needs a foot distinct from the point, and there is none. \
Erecting a perpendicular at a point of the line is Euclid I.11, a different \
proposition."
}], "Notes",ExpressionUUID->"d1857982-5964-42a9-976e-ce26dea708a0"],

Cell[TextData[{
 "The count is very large. On an 81-vertex square patch, a point off a line \
admits 6381 perpendiculars. This is the same combinatorial explosion as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraInfiniteLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraInfiniteLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d8fc9dda-b070-48c4-b58e-5c1afd2acc79"],
 ", and it has the same cause: a maximal shortest path on a lattice has many \
admissible continuations."
}], "Notes",ExpressionUUID->"95d30ff8-3ceb-4407-aa7f-17baaf4df125"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["\"\<Radius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "592c199b-4352-4def-b1e3-195bc4551998"],
 " is the lever that makes it usable. ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94e3aa6d-9853-4bfd-b30a-9ca4abd46934"],
 " localises both the candidate enumeration and the test to the ",
 StyleBox["r", "TI"],
 "-neighbourhood of the point. On that same patch the count falls to 110 at \
radius 3 and 26 at radius 2. Perpendicularity is a local notion, so \
localising it is not a compromise."
}], "Notes",ExpressionUUID->"feadf3a1-d42d-4ec9-a3d5-febbec6a5e62"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9efc477b-00cc-4197-be9a-6cd658f544ee"],
 " also takes the ",
 Cell[BoxData["Q"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "036d12bc-2efe-4ca0-9e41-7675728442e8"],
 "-side families \[LongDash] ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe3a30d5-1076-4317-9308-a3d6b2f5d759"],
 ", ",
 Cell[BoxData["\"\<Coordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2872d34a-9720-40e1-8283-6b639bb95a5f"],
 ", ",
 Cell[BoxData["\"\<Arclength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6eb27678-d4c2-47a1-854e-bd28f62fb404"],
 ", ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "760e89f9-8ccf-4bd3-a38e-8ac7362da476"],
 " \[LongDash] which enumerate maximal shortest paths through the point and \
filter them with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d2bbaa46-e2de-4d5d-bf32-e5b28e8f8e78"],
 ". Sub-options belong inside the method spec and are passed through."
}], "Notes",ExpressionUUID->"4eec39a8-c2b5-452c-a404-8a91418e3973"],

Cell[TextData[{
 "The result need not satisfy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5aa0daba-fbd4-4122-8124-17f5fbdb8ec2"],
 " under its default settings. The default ",
 Cell[BoxData["\"\<Metric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29fc9a7a-cc56-4a0d-83e8-3d5d7899aa69"],
 " construction is Euclid's, while the predicate tests a projection \
condition, and on a lattice the two do not coincide. See that page for which \
equality setting reconciles them."
}], "Notes",ExpressionUUID->"616d7dba-307e-43b4-9bdb-0482bc83fc8a"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"e8b95b04-17c8-4645-8036-f4ce82fef18e"],

