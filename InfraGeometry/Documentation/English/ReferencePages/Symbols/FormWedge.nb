Notebook[{

Cell[CellGroupData[{
Cell["FormWedge", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a1cd2c02-a781-49b2-9998-8f616de7dbe9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FormWedge"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FormWedge", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["\[Omega]", "TR"], ",", " ", 
    StyleBox["\[Eta]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51cca56e-6ce7-40ce-abc8-de9cb450fa48"],
 "\[LineSeparator]",
 "gives the wedge product ",
 StyleBox["\[Omega] \[And] \[Eta]", "TI"],
 " of the forms ",
 StyleBox["\[Omega]", "TI"],
 " and ",
 StyleBox["\[Eta]", "TI"],
 ", the exterior product of their germs at every vertex.",
 "\n"
}], "Usage",ExpressionUUID->"538ca90b-b46c-4e1d-aed9-9f6789e86907"],

Cell[TextData[{
 "Definition: for a ",
 StyleBox["p", "TI"],
 "-form ",
 StyleBox["\[Omega]", "TI"],
 " and a ",
 StyleBox["q", "TI"],
 "-form ",
 StyleBox["\[Eta]", "TI"],
 ", with ",
 StyleBox["n", "TI"],
 " = ",
 StyleBox["p", "TI"],
 " + ",
 StyleBox["q", "TI"],
 ", ",
 StyleBox["(\[Omega] \[And] \[Eta])(v; w\:2081, \[Ellipsis], w\:2099) = \
\[CapitalSigma] sgn(\[Sigma]) \[Omega](v; w\[Sigma](1), \[Ellipsis], \
w\[Sigma](p)) \[Eta](v; w\[Sigma](p+1), \[Ellipsis], w\[Sigma](n))", "TI"],
 ", the sum over the shuffles ",
 StyleBox["\[Sigma]", "TI"],
 ", the permutations that keep the first ",
 StyleBox["p", "TI"],
 " and the last ",
 StyleBox["q", "TI"],
 " places in order. For two 1-forms ",
 StyleBox["(\[Omega] \[And] \[Eta])(v; w\:2081, w\:2082) = \[Omega](v; \
w\:2081) \[Eta](v; w\:2082) \[Minus] \[Omega](v; w\:2082) \[Eta](v; w\:2081)",
   "TI"],
 "."
}], "Notes",ExpressionUUID->"b5c96b10-5eae-4d70-b85e-19be4a82182f"],

Cell[TextData[{
 "On 0-forms it is the product of functions, and a 0-form times a ",
 StyleBox["k", "TI"],
 "-form multiplies the germ at each vertex by the value there."
}], "Notes",ExpressionUUID->"852ac457-736f-4b93-aae5-60bb0e41fdd6"],

Cell[TextData[{
 "It is associative and graded-commutative, ",
 StyleBox["\[Eta] \[And] \[Omega] = (\[Minus]1)^(pq) \[Omega] \[And] \[Eta]", 
  "TI"],
 ": at each vertex it is the exterior product of the alternating functions of \
the steps from the vertex. In particular ",
 StyleBox["\[Omega] \[And] \[Omega] = 0", "TI"],
 " for a 1-form."
}], "Notes",ExpressionUUID->"88987c22-538b-4f48-a027-1295d3e9e343"],

Cell[TextData[{
 "The differential is not a derivation for it. On 0-forms ",
 StyleBox["d(f \[And] g) \[Minus] df \[And] g \[Minus] f \[And] dg = df \
\[CircleDot] dg", "TI"],
 ", the product of the two gradients step by step, ",
 StyleBox["(f(w) \[Minus] f(v))(g(w) \[Minus] g(v))", "TI"],
 "; it is of second order in the increments and has no smooth counterpart."
}], "Notes",ExpressionUUID->"b99f402d-b2b0-478f-a2d9-e019425d38fd"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IntegrationMap"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/IntegrationMap", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8ce50684-76bd-43bb-b6a8-a4802095ece6"],
 " does not carry it to the cup product: for cochains ",
 StyleBox["\[Alpha]", "TI"],
 ", ",
 StyleBox["\[Beta]", "TI"],
 " of degrees ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ", ",
 StyleBox["I(R\[Alpha] \[And] R\[Beta]) = ((p + q)!/(p! q!)) \[Alpha] \:222a \
\[Beta]", "TI"],
 " on every graph tried (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e73f4d10-cf4b-424f-b10d-2d9c029bcd17"],
 "), a factor 2 for two 1-cochains."
}], "Notes",ExpressionUUID->"11414128-9382-4dbf-8a7e-c1e0a8e7f298"],

Cell["\<\
The product keeps the vertices at which both forms have a germ.\
\>", "Notes",ExpressionUUID->"e0a56330-1063-4cc1-8368-1b5f1857a3e4"]
}, Open  ]],

