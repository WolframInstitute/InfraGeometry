Cell[TextData[{
 "On the triangulated mesh of a square the integral of the same 2-form is \
twice the cup of the coboundaries of the coordinates, which is the signed \
area of each triangle: the factor (",
 StyleBox["p", "TI"],
 " + ",
 StyleBox["q", "TI"],
 ")!/(",
 StyleBox["p", "TI"],
 "! ",
 StyleBox["q", "TI"],
 "!) = 2."
}], "ExampleText",ExpressionUUID->"aee84a68-db8e-42aa-8de6-88f7b2db0883"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"positions", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"xCoordinate", " ", "=", " ", 
      RowBox[{"positions", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", 
     RowBox[{"yCoordinate", " ", "=", " ", 
      RowBox[{"positions", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"integral", " ", "=", " ", 
      RowBox[{"IntegrationMap", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"FormWedge", "[", 
         RowBox[{
          RowBox[{"FormDifferential", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"ZeroForm", "[", 
             RowBox[{"g", ",", " ", "xCoordinate"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"FormDifferential", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"ZeroForm", "[", 
             RowBox[{"g", ",", " ", "yCoordinate"}], "]"}]}], "]"}]}], 
         "]"}]}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"cup", " ", "=", " ", 
      RowBox[{"CochainCup", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"Coboundary", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"KeyMap", "[", 
           RowBox[{"List", ",", " ", "xCoordinate"}], "]"}]}], "]"}], ",", 
        " ", 
        RowBox[{"Coboundary", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"KeyMap", "[", 
           RowBox[{"List", ",", " ", "yCoordinate"}], "]"}]}], "]"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Values", "[", "cup", "]"}], ",", " ", 
          RowBox[{"Lookup", "[", 
           RowBox[{"integral", ",", " ", 
            RowBox[{"Keys", "[", "cup", "]"}], ",", " ", "0"}], "]"}]}], 
         "}"}], "]"}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Delta]x \:222a \[Delta]y\>\"", ",", 
          " ", "\"\<I(dx \[And] dy)\>\""}], "}"}]}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"MinMax", "[", 
      RowBox[{
       RowBox[{"Lookup", "[", 
        RowBox[{"integral", ",", " ", 
         RowBox[{"Keys", "[", "cup", "]"}], ",", " ", "0"}], "]"}], " ", "/", 
       " ", 
       RowBox[{"Values", "[", "cup", "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7f05594e-83a9-4a56-a426-17c0ceabe9a4"],

