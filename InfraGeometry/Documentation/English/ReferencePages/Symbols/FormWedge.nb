Cell["\<\
The wedge is graded-commutative. For the gradients of the distances from the \
centre of the triangular tiling and from a vertex three steps away, \
exchanging the factors changes the sign, and the wedge of a gradient with \
itself is 0. The germ of their wedge at the centre is drawn as a matrix over \
the ordered pairs of neighbours.\
\>", "ExampleText",ExpressionUUID->"92f3cc13-155b-413b-b050-3309f6b8bf0f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"center", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"apex", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"center", ",", " ", "3"}], "]"}]}], "]"}]}], ")"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"gradient", " ", "=", " ", 
      RowBox[{"FormDifferential", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"ZeroForm", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "center", ",", " ", "#"}], "]"}], " ", 
           "&"}]}], "]"}]}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"otherGradient", " ", "=", " ", 
      RowBox[{"FormDifferential", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"ZeroForm", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "apex", ",", " ", "#"}], "]"}], " ", 
           "&"}]}], "]"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MatrixPlot", "[", 
      RowBox[{"Table", "[", "\n", "     ", 
       RowBox[{
        RowBox[{"FormValue", "[", 
         RowBox[{
          RowBox[{"FormWedge", "[", 
           RowBox[{"gradient", ",", " ", "otherGradient"}], "]"}], ",", " ", 
          "center", ",", " ", 
          RowBox[{"{", 
           RowBox[{"nbr", ",", " ", "neighbour"}], "}"}]}], "]"}], ",", "\n", 
        "     ", 
        RowBox[{"{", 
         RowBox[{"nbr", ",", " ", 
          RowBox[{"AdjacencyList", "[", 
           RowBox[{"g", ",", " ", "center"}], "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"neighbour", ",", " ", 
          RowBox[{"AdjacencyList", "[", 
           RowBox[{"g", ",", " ", "center"}], "]"}]}], "}"}]}], "]"}], "]"}], 
     ",", "\n", "   ", 
     RowBox[{
      RowBox[{"KeySort", "[", 
       RowBox[{"KeySort", " ", "/@", " ", 
        RowBox[{"FormWedge", "[", 
         RowBox[{"otherGradient", ",", " ", "gradient"}], "]"}]}], "]"}], " ",
       "===", " ", 
      RowBox[{"KeySort", "[", 
       RowBox[{"KeySort", " ", "/@", " ", 
        RowBox[{"-", 
         RowBox[{"FormWedge", "[", 
          RowBox[{"gradient", ",", " ", "otherGradient"}], "]"}]}]}], "]"}]}],
      ",", "\n", "   ", 
     RowBox[{"Union", "[", 
      RowBox[{"Length", " ", "/@", " ", 
       RowBox[{"Values", "[", 
        RowBox[{"FormWedge", "[", 
         RowBox[{"gradient", ",", " ", "gradient"}], "]"}], "]"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a2394b98-4507-42a7-92ae-d7d4abeb4dce"],

