Cell[TextData[{
 "The differential fails the Leibniz rule. For the distance ",
 StyleBox["f", "TI"],
 " from the centre, ",
 StyleBox["d(f \[And] f) \[Minus] 2 f \[And] df", "TI"],
 " is the square of the gradient: 1 on every step between two shells, in both \
directions."
}], "ExampleText",ExpressionUUID->"9e746447-8a15-4536-827b-57c5b37eb130"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"form", " ", "=", " ", 
     RowBox[{"ZeroForm", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "#"}], "]"}], 
        " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"gradient", " ", "=", " ", 
     RowBox[{"FormDifferential", "[", 
      RowBox[{"g", ",", " ", "form"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"leibniz", " ", "=", " ", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{"Merge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"FormDifferential", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"FormWedge", "[", 
              RowBox[{"form", ",", " ", "form"}], "]"}]}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"-", "2"}], " ", 
            RowBox[{"FormWedge", "[", 
             RowBox[{"form", ",", " ", "gradient"}], "]"}]}]}], "}"}], ",", 
         " ", 
         RowBox[{
          RowBox[{"Merge", "[", 
           RowBox[{"#", ",", " ", "Total"}], "]"}], " ", "&"}]}], "]"}], ",", 
       " ", "0", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Catenate", " ", "@*", " ", "Keys", " ", "@*", " ", 
          RowBox[{"Select", "[", "Positive", "]"}]}], ",", " ", "leibniz"}], 
        "]"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"KeySort", "[", 
       RowBox[{"KeySort", " ", "/@", " ", "leibniz"}], "]"}], " ", "===", " ", 
      RowBox[{"KeySort", "[", 
       RowBox[{
        RowBox[{"KeySort", " ", "/@", " ", "gradient"}], "^", "2"}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6c2b143c-e48d-4b2b-a183-ea5cf2f0ff0f"],

