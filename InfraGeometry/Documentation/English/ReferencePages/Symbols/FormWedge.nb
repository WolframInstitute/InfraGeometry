Cell[TextData[{
 "The wedge of the gradients of the two coordinates of the square tiling. At \
a vertex ",
 StyleBox["v", "TI"],
 " its value on two neighbours ",
 StyleBox["w\:2081", "TI"],
 ", ",
 StyleBox["w\:2082", "TI"],
 " is the determinant of ",
 StyleBox["w\:2081 \[Minus] v", "TI"],
 " and ",
 StyleBox["w\:2082 \[Minus] v", "TI"],
 ", twice the signed area of the triangle ",
 StyleBox["v w\:2081 w\:2082", "TI"],
 ": \[PlusMinus]2 on two perpendicular steps, 0 on two opposite ones. The \
germ at the centre, as a matrix over the ordered pairs of neighbours, beside \
its integral: the square tiling has no triangles, so every 2-cochain on it is \
0, while the 2-form is not."
}], "ExampleText",ExpressionUUID->"184b44e8-ee5d-4b05-b48e-1c96dfe419c4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"positions", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"center", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"GraphCenter", "[", "g", "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"wedge", " ", "=", " ", 
     RowBox[{"FormWedge", "[", 
      RowBox[{
       RowBox[{"FormDifferential", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"ZeroForm", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"positions", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], "]"}], ",",
        " ", 
       RowBox[{"FormDifferential", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"ZeroForm", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"positions", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], "]"}]}],
       "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MatrixPlot", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"FormValue", "[", 
         RowBox[{"wedge", ",", " ", "center", ",", " ", 
          RowBox[{"{", 
           RowBox[{"nbr", ",", " ", "neighbour"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"nbr", ",", " ", 
          RowBox[{"AdjacencyList", "[", 
           RowBox[{"g", ",", " ", "center"}], "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"neighbour", ",", " ", 
          RowBox[{"AdjacencyList", "[", 
           RowBox[{"g", ",", " ", "center"}], "]"}]}], "}"}]}], "]"}], "]"}], 
     ",", "\n", "   ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"IntegrationMap", "[", 
       RowBox[{"g", ",", " ", "wedge"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"dde95548-6176-4351-b83c-166e89f186c1"],

