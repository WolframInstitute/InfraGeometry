 CellLabel->"Out[1]= ",ExpressionUUID->"8859e9e3-568c-4afb-b847-b9bac2b430d2"]
}, Open  ]],

Cell[TextData[{
 "On the mesh the integral of ",
 StyleBox["dx \[And] dy", "TI"],
 " is twice the cup ",
 StyleBox["\[Delta]x \:222a \[Delta]y", "TI"],
 " on every triangle:"
}], "ExampleText",ExpressionUUID->"1e524ead-9687-43fd-b2af-9360f2f82493"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{
         RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{"y", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{
         RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"integral", " ", "=", " ", 
      RowBox[{"IntegrationMap", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"FormWedge", "[", 
         RowBox[{
          RowBox[{"FormDifferential", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"ZeroForm", "[", 
             RowBox[{"g", ",", " ", "x"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"FormDifferential", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"ZeroForm", "[", 
             RowBox[{"g", ",", " ", "y"}], "]"}]}], "]"}]}], "]"}]}], "]"}]}],
      ",", "\n", "   ", 
     RowBox[{"cup", " ", "=", " ", 
      RowBox[{"CochainCup", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"Coboundary", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"KeyMap", "[", 
           RowBox[{"List", ",", " ", "x"}], "]"}]}], "]"}], ",", " ", 
        RowBox[{"Coboundary", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"KeyMap", "[", 
           RowBox[{"List", ",", " ", "y"}], "]"}]}], "]"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "cup", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Max", " ", "@", " ", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"Lookup", "[", 
          RowBox[{"integral", ",", " ", 
           RowBox[{"Keys", "[", "cup", "]"}]}], "]"}], " ", "-", " ", 
         RowBox[{"2", " ", 
          RowBox[{"Values", "[", "cup", "]"}]}]}], "]"}]}], " ", "<", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "12"}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"04fc339e-a4cd-40fb-916c-00e4540ec8a5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"154", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"b3fb8c6b-81ea-4124-9417-071dc3c074dd"]
}, Open  ]]
}, Open  ]],

