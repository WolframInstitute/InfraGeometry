Cell[TextData[{
 "The differential fails the Leibniz rule. For the distance ",
 StyleBox["f", "TI"],
 " from the centre of the grid, ",
 StyleBox["d(f \[And] f) \[Minus] 2 f \[And] df", "TI"],
 " is the square of the gradient, 1 on every step:"
}], "ExampleText",ExpressionUUID->"b5388ea9-5a94-4456-a47f-50619d76b396"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"ZeroForm", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"df", " ", "=", " ", 
     RowBox[{"FormDifferential", "[", 
      RowBox[{"g", ",", " ", "f"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"defect", " ", "=", " ", 
     RowBox[{"Merge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"FormDifferential", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"FormWedge", "[", 
            RowBox[{"f", ",", " ", "f"}], "]"}]}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"-", "2"}], " ", 
          RowBox[{"FormWedge", "[", 
           RowBox[{"f", ",", " ", "df"}], "]"}]}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"Merge", "[", 
         RowBox[{"#", ",", " ", "Total"}], "]"}], " ", "&"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Union", " ", "@", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Values", " ", "/@", " ", 
        RowBox[{"Values", "[", "defect", "]"}]}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"KeySort", " ", "/@", " ", "defect"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"KeySort", " ", "/@", " ", "df"}], "^", "2"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c58feb75-76f7-4044-bd04-5dedd876489a"],

