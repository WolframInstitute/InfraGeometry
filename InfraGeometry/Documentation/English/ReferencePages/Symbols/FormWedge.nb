Cell[TextData[{
 "The germ of ",
 StyleBox["dx \[And] dy", "TI"],
 " at the centre of the grid, over the ordered pairs of its four neighbours, \
and the integral of the 2-form, which is 0:"
}], "ExampleText",ExpressionUUID->"d4e735e7-cb8f-43aa-8b32-78c770be1104"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", " ", "=", " ", 
      RowBox[{"ZeroForm", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], "]"}]}], 
     ",", "\n", "   ", 
     RowBox[{"y", " ", "=", " ", 
      RowBox[{"ZeroForm", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"wedge", " ", "=", " ", 
     RowBox[{"FormWedge", "[", 
      RowBox[{
       RowBox[{"FormDifferential", "[", 
        RowBox[{"g", ",", " ", "x"}], "]"}], ",", " ", 
       RowBox[{"FormDifferential", "[", 
        RowBox[{"g", ",", " ", "y"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MatrixForm", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"FormValue", "[", 
         RowBox[{"wedge", ",", " ", "c", ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "w"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"u", ",", " ", 
          RowBox[{"AdjacencyList", "[", 
           RowBox[{"g", ",", " ", "c"}], "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"w", ",", " ", 
          RowBox[{"AdjacencyList", "[", 
           RowBox[{"g", ",", " ", "c"}], "]"}]}], "}"}]}], "]"}]}], ",", "\n",
      "   ", 
     RowBox[{"IntegrationMap", "[", 
      RowBox[{"g", ",", " ", "wedge"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a180ce7d-093f-4259-b0e9-de4283367935"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TagBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0", "1.`", 
        RowBox[{"-", "1.`"}], "0"},
       {
        RowBox[{"-", "1.`"}], "0", "0", "1.`"},
       {"1.`", "0", "0", 
        RowBox[{"-", "1.`"}]},
       {"0", 
        RowBox[{"-", "1.`"}], "1.`", "0"}
      },
