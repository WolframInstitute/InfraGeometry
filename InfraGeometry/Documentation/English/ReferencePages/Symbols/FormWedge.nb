Cell["\<\
The wedge is graded-commutative. For the gradients of the distances from the \
centre and from a vertex at distance 4 on the mesh, exchanging the factors \
changes the sign, and the wedge of a gradient with itself is 0:\
\>", "ExampleText",ExpressionUUID->"78733112-97f2-486c-b144-3210be06cdb9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"df", " ", "=", " ", 
      RowBox[{"FormDifferential", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"ZeroForm", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"AssociationThread", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "c"}], "]"}]}], "]"}]}], "]"}]}], "]"}]}],
      ",", "\n", "   ", 
     RowBox[{"dh", " ", "=", " ", 
      RowBox[{"FormDifferential", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"ZeroForm", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"AssociationThread", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "b"}], "]"}]}], "]"}]}], "]"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"KeySort", " ", "/@", " ", 
       RowBox[{"FormWedge", "[", 
        RowBox[{"dh", ",", " ", "df"}], "]"}]}], " ", "==", " ", 
      RowBox[{"KeySort", " ", "/@", " ", 
       RowBox[{"-", 
        RowBox[{"FormWedge", "[", 
         RowBox[{"df", ",", " ", "dh"}], "]"}]}]}]}], ",", " ", 
     RowBox[{"Union", " ", "@", " ", 
      RowBox[{"Values", " ", "@", " ", 
       RowBox[{"FormWedge", "[", 
        RowBox[{"df", ",", " ", "df"}], "]"}]}]}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"e094e4ff-7c48-40f9-9fc4-e50df2a2532b"],

