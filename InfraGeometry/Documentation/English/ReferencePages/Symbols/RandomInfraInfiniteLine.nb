Cell[TextData[{
 "A line is an inextensible shortest path: a shortest path ",
 StyleBox["a = v\:2080, \[Ellipsis], v\:2096 = b", "TI"],
 ", ",
 StyleBox["k = d(a, b)", "TI"],
 ", such that no neighbour of ",
 StyleBox["a", "TI"],
 " or of ",
 StyleBox["b", "TI"],
 " lies farther from the other end. The predicate is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraInfiniteLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraInfiniteLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9f60eda1-fd9e-499f-98a8-430e867c7a1c"],
 "."
}], "Notes",ExpressionUUID->"63fd0eb8-f9a7-49ce-88e0-2c01b99ab0ce"],

Cell[TextData[{
 "A line need not reach the rim: on the mesh it can end at an inner vertex \
none of whose neighbours is farther from the other end. A line through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " passes ",
 StyleBox["p", "TI"],
 " before ",
 StyleBox["q", "TI"],
 ". Its ends must be admissible as a pair: an end that is admissible on its \
own side can fail together with the other end."
}], "Notes",ExpressionUUID->"789307ac-caea-4a0b-aaa8-0242f08afaa7"],

Cell["\<\
In the plane two points lie on one line. On a graph they lie on many: two \
vertices at distance 2 lie on 9800 lines of the small square grid and on 210 \
of the small square mesh.\
\>", "Notes",ExpressionUUID->"886d03c8-acc6-4f64-a7a9-45f3f88c3c03"],

Cell[TextData[{
 "The lines through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " are the lines through the shortest paths from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", each line through exactly one of them."
}], "Notes",ExpressionUUID->"3b66ab01-11ab-410d-91be-8857f00a02c5"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
