Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"path", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "p", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"p", ",", " ", "3"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraWalk", "[", 
        RowBox[{"RandomInfraInfiniteLine", "[", 
         RowBox[{"g", ",", " ", "path", ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], "]"}], ",",
        " ", "path"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cd7b50f7-e3e2-474f-9372-8699dbb9d912"],

