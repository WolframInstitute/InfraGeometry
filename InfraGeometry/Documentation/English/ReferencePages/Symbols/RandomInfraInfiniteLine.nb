 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell["\<\
On the 4-cycle the edge 1, 2 extends to 4, 1, 2 and to 1, 2, 3, but not to 4, \
1, 2, 3: two lines through one shortest path, and neither contains the other:\
\
\>", "ExampleText",ExpressionUUID->"c4737213-2758-43ab-916f-bd970baf0c0e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RandomInfraInfiniteLine", "[", 
  RowBox[{
   RowBox[{"CycleGraph", "[", "4", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "All"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2327a90d-fcac-478a-a4ef-f28884d89cb3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", "1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"76207332-db99-4e82-9021-9820b3384483"]
}, Open  ]],

Cell["\<\
On the hexagon three lines pass through the edge from 1 to 2, not four. The \
line can end at 5 on one side and at 4 on the other, but not at both: 5, 6, \
1, 2, 3, 4 is not a shortest path:\
\>", "ExampleText",ExpressionUUID->"0c4949f4-6115-46e9-baf4-eea4d821eb5d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RandomInfraInfiniteLine", "[", 
  RowBox[{
   RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "All"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6bc859cf-7368-411a-b1ae-affa1a6c086e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"6", ",", "1", ",", "2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "6", ",", "1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"f5b81f2f-a8f6-4ebb-ae84-664a3eeec133"]
}, Open  ]]
}, Open  ]],

