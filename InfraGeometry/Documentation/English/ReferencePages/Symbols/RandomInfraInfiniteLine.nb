     "585d98e6-ca01-4968-b6df-098966011617"], Cell[
    "The parallel postulate quantifies over lines.", "TableText",
     ExpressionUUID->"66f4776b-5975-4abc-9726-c0a52b9adc56"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6ea0378d-5985-4f55-8173-ebe0d6b13418"], Cell[
