Cell[TextData[{
 "The lines through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " split by the shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " they contain. On the mesh there are two such paths:"
}], "ExampleText",ExpressionUUID->"e6dac003-a127-400e-baa7-bd8ddf1e2ffe"],

