Cell[TextData[{
 "A line is an inextensible shortest path: a shortest path ",
 StyleBox["a = v\:2080, \[Ellipsis], v\:2096 = b", "TI"],
 ", ",
 StyleBox["k = d(a, b)", "TI"],
 ", such that no neighbour of ",
 StyleBox["a", "TI"],
 " or of ",
 StyleBox["b", "TI"],
 " lies farther from the other end. The predicate is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraInfiniteLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraInfiniteLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "71963b04-4f83-4834-9ac9-7d4e4dd3a138"],
 "."
}], "Notes",ExpressionUUID->"68412ef4-89bb-47b6-a604-ce2e7cda9225"],

Cell[TextData[{
 "A line need not reach the rim: on the mesh it can end at an inner vertex \
none of whose neighbours is farther from the other end. A line through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " passes ",
 StyleBox["p", "TI"],
 " before ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"16484595-1a66-45a4-a9dd-44ea3c3e6e10"],

Cell[TextData[{
 "A shortest path has no unique line through it: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraInfiniteLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraInfiniteLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["path", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94c4d27b-69bc-4b74-8f58-6bacee601f23"],
 " is a family. Its ends are admissible only as a pair: an end that is \
admissible on its own side can fail together with the other end, so the \
family is smaller than the product of the two extension sets."
}], "Notes",ExpressionUUID->"d4ef15d2-855f-4dee-8337-235d51bf539d"],

Cell["\<\
In the plane two points lie on one line. On a graph they lie on many: two \
vertices at distance 2 lie on 9800 lines of the small square grid and on 210 \
of the small square mesh.\
\>", "Notes",ExpressionUUID->"d479ab34-672f-48ca-b040-debf304d4792"],

Cell[TextData[{
 "The lines through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " are the lines through the shortest paths from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", each line through exactly one of them."
}], "Notes",ExpressionUUID->"f141b15e-c5ad-4713-a579-4ab1bced1b28"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec4e3f38-bd9e-4993-a16c-0ff8f93660eb"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bc8cda9-caf9-4ac8-9f97-d35d8e1e6057"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77b8f1d3-b31d-46b0-8dac-5ea4f13b5984"],
 ". A count above the number of lines gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6a3f563-c31d-4c48-b597-9441945ca678"],
 "."
}], "Notes",ExpressionUUID->"ee8e91f3-52ac-4ce8-81a7-c43accad9e76"],

