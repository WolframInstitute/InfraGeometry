Cell[TextData[{
 "A line is an inextensible shortest path: a shortest path ",
 StyleBox["a = v\:2080, \[Ellipsis], v\:2096 = b", "TI"],
 ", ",
 StyleBox["k = d(a, b)", "TI"],
 ", such that no neighbour of ",
 StyleBox["a", "TI"],
 " or of ",
 StyleBox["b", "TI"],
 " lies farther from the other end. The predicate is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraInfiniteLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraInfiniteLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "455a41aa-a21b-4db3-840f-2a4f61171671"],
 "."
}], "Notes",ExpressionUUID->"229b9b2d-2c8b-46a4-b771-f8d92d383b97"],

Cell[TextData[{
 "A line need not reach the rim: on the mesh it can end at an inner vertex \
none of whose neighbours is farther from the other end. A line through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " passes ",
 StyleBox["p", "TI"],
 " before ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"248028a4-0f67-47d3-8dd6-dc137a8dba93"],

Cell[TextData[{
 "A shortest path has no unique line through it: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraInfiniteLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraInfiniteLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["path", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e154d472-5727-4875-9080-446ae47f3c1c"],
 " is a family. Its ends are admissible only as a pair: an end that is \
admissible on its own side can fail together with the other end, so the \
family is smaller than the product of the two extension sets."
}], "Notes",ExpressionUUID->"9eb4eabe-5fc7-4eda-a859-067190f74bbc"],

Cell["\<\
In the plane two points lie on one line. On a graph they lie on many: two \
vertices at distance 2 lie on 9800 lines of the small square grid and on 210 \
of the small square mesh.\
\>", "Notes",ExpressionUUID->"1ff16dba-c5e0-4102-ae27-c007bbb487f3"],

Cell[TextData[{
 "The lines through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " are the lines through the shortest paths from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", each line through exactly one of them."
}], "Notes",ExpressionUUID->"bbfc1d43-e83d-480b-9e37-760b68669571"],

Cell["\<\
A line through a shortest path grows on both sides in turn, the shorter side \
first. A side that cannot continue stays stopped, and the other side \
continues alone.\
\>", "Notes",ExpressionUUID->"2f563921-0831-4c20-8910-545eb3c6167a"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bdc5c1a4-f020-4c93-96fa-98ed55f93c09"],
 " before the count, each side stops after ",
 StyleBox["k", "TI"],
 " added vertices; a side ends earlier only where the stretch cannot \
continue. Without it there is no limit. A token with ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ccee1757-94a8-40cc-8058-8c6d2734c127"],
 " is grown from its shortest paths, not drawn uniformly from its lines."
}], "Notes",ExpressionUUID->"684d9029-3a19-470c-95fb-33b352448ba0"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1162cc05-0073-4bd2-be99-d0fb2fdda7d9"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9d88bae-8833-4ded-9a11-27f85ff66fc7"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbc2f815-b92d-4f5b-908c-eb2cabcf8574"],
 ". A count above the number of lines gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fab03fcb-4c87-40e8-87e0-20ffbbc65216"],
 "."
}], "Notes",ExpressionUUID->"f7a05573-c21d-4a44-954e-74a4e68163bf"],

