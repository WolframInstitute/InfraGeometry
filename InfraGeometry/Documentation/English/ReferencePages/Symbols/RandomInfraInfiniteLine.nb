Cell[TextData[{
 "The lines through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " split by the shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " they contain. On the mesh there are two such paths:"
}], "ExampleText",ExpressionUUID->"be7d4f84-22af-4ac7-ac74-02601df8dee0"],

