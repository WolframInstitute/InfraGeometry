  FontSize->0.9 Inherited,ExpressionUUID->
  "095eb2fd-73ce-4c58-ae0d-8f969be41ab6"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd73b6b7-5522-47c1-b128-af913e94fcfc"],
 ". A count above the number of lines gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48125555-69f1-4752-ad9d-7b13ab5a9c28"],
 "."
}], "Notes",ExpressionUUID->"6fb5fa1e-9b01-4001-ad4d-ee59c19775aa"],

