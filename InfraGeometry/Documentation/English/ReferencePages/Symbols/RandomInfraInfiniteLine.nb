Cell["\<\
The number of lines through the two points, on the grid and on the mesh:\
\>", "ExampleText",ExpressionUUID->"3faac429-012a-4d6e-bd08-b66cd0b66dda"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
     
     RowBox[{"{", 
      RowBox[{"q", " ", "=", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"p", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraInfiniteLine", "[", 
        RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
       " ", "\"\<Cardinality\>\""}], "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", 
       " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"85739123-2e0d-45a1-8b20-dcbc8e41cde9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"9800", ",", "210"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"9fd709a6-d0eb-4143-95f7-1c725141cef4"]
}, Open  ]],

Cell["Three lines through the same two points of the mesh:", "ExampleText",ExpressionUUID->"5ceec29e-7b9d-47e9-af3a-238e23428916"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"p", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraWalk", "[", "line", "]"}], ",", " ", "p", ",", " ", 
          "q"}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"line", ",", " ", 
        RowBox[{"RandomInfraInfiniteLine", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraInfiniteLine", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "3", ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"1f281f72-9b28-4a65-a02c-5c5e5f306ee7"],

