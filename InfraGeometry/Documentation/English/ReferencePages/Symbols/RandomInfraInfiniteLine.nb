 "The lines through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " split by the shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " they contain. On the mesh there are two such paths:"
}], "ExampleText",ExpressionUUID->"b3d9e490-80f0-48fb-8a62-919a2f304c9d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"p", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"RandomInfraInfiniteLine", "[", 
         RowBox[{"g", ",", " ", "#", ",", " ", "All"}], "]"}]}], " ", "&"}], 
      " ", "/@", " ", 
      RowBox[{"RandomInfraSegment", "[", 
       RowBox[{"g", ",", " ", "p", ",", " ", "q", ",", " ", "All"}], "]"}]}], 
     ",", "\n", "   ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"RandomInfraInfiniteLine", "[", 
       RowBox[{"g", ",", " ", "p", ",", " ", "q", ",", " ", "All"}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9d8a0e7c-fb46-46d7-938c-a6fd9f51cfd9"],

