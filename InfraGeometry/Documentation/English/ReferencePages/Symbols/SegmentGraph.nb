Cell[TextData[{
 "The vertices are the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MetricInterval"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/MetricInterval", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aa861477-0128-498f-911f-07b0dd1d2d5b"],
 ", the paths are the shortest paths that ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f93c1910-4ba6-4b5c-a0f9-78e296907c8f"],
 " finds, and the graph is that of the segment head."
}], "ExampleText",ExpressionUUID->"c4a4c218-89cc-4ff2-b2aa-b5d59c4d03a8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "5"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"intervalDag", " ", "=", " ", 
     RowBox[{"SegmentGraph", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"intervalDag", ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "a", ",",
          " ", "b"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"VertexList", "[", "intervalDag", "]"}]}], " ", "===", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"MetricInterval", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}]}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"FindPath", "[", 
        RowBox[{
        "intervalDag", ",", " ", "a", ",", " ", "b", ",", " ", "Infinity", ",",
          " ", "All"}], "]"}]}], " ", "===", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"FindInfraSegment", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], 
        "]"}]}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"EdgeList", "[", "intervalDag", "]"}]}], " ", "===", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"EdgeList", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
         "]"}]}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3fec8ee2-c6e4-4cbb-bf20-993dc7c389ea"],

