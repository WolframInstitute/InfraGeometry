Cell[TextData[{
 "The vertices are the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MetricInterval"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/MetricInterval", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5d964a68-6183-4e80-85a0-064b41203ea2"],
 ", the paths are the geodesics that ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "67a632c3-1d9c-44b2-80b7-2c059ae397bf"],
 " finds, and the graph is that of the segment head."
}], "ExampleText",ExpressionUUID->"c7d05d67-a922-425c-8f9e-50ca1acf4680"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"intervalDag", " ", "=", " ", 
     RowBox[{"SegmentGraph", "[", 
      RowBox[{"g", ",", " ", "41", ",", " ", "61"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"VertexList", "[", "intervalDag", "]"}]}], " ", "===", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"MetricInterval", "[", 
        RowBox[{"g", ",", " ", "41", ",", " ", "61"}], "]"}]}]}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"FindPath", "[", 
        RowBox[{
        "intervalDag", ",", " ", "41", ",", " ", "61", ",", " ", "Infinity", ",",
          " ", "All"}], "]"}]}], " ", "===", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"FindInfraSegment", "[", 
        RowBox[{"g", ",", " ", "41", ",", " ", "61", ",", " ", "All"}], 
        "]"}]}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"EdgeList", "[", "intervalDag", "]"}]}], " ", "===", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"EdgeList", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"41", ",", " ", "61"}], "]"}], ",", " ", "\"\<Graph\>\""}],
          "]"}]}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"15e1972a-b3fa-41d3-a527-4f4d218054f3"],

