Cell[CellGroupData[{
Cell["SegmentGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6daddec9-aaf4-42f7-9582-252b2b8d4138"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SegmentGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SegmentGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48022e52-cca3-48cf-a0ed-d5fe69899e1e"],
 "\[LineSeparator]",
 "gives the metric interval between ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " as a directed acyclic graph whose directed paths from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " are exactly the shortest paths from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"1396575d-cdb7-4513-862b-cdbcea381b6f"],

Cell[TextData[{
 "Definition: the metric interval is ",
 StyleBox["I(u, v) = {w : d(u, w) + d(w, v) = d(u, v)}", "TI"],
 ", the vertices on some shortest path from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ". The graph has these vertices, and an edge ",
 StyleBox["w \[RightArrow] x", "TI"],
 " for every edge of ",
 StyleBox["g", "TI"],
 " between two of them with ",
 StyleBox["d(u, x) = d(u, w) + 1", "TI"],
 "."
}], "Notes",ExpressionUUID->"37453567-b44a-4ef8-81eb-ce5de5aea96a"],

Cell[TextData[{
 "Every shortest path from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " is a directed path of the graph, and every directed path from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " is a shortest path, each exactly once. So the graph holds the whole family \
without listing it."
}], "Notes",ExpressionUUID->"de1f87b1-744d-4eec-8676-233938e1d1dc"],

Cell[TextData[{
 "It is built from the two distance fields ",
 StyleBox["d(u, \[CenterDot])", "TI"],
 " and ",
 StyleBox["d(v, \[CenterDot])", "TI"],
 " and never enumerates a path. Its size is at most that of ",
 StyleBox["g", "TI"],
 ", while the number of shortest paths can be exponential in ",
 StyleBox["d(u, v)", "TI"],
 "."
}], "Notes",ExpressionUUID->"997ddeb5-7e7b-43d6-9671-156130366c1f"],

Cell[TextData[{
 "On a square grid the interval is the rectangle spanned by ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 ", and the shortest paths are the lattice paths through it. Where ",
 StyleBox["g", "TI"],
 " is disconnected between ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " the graph is empty."
}], "Notes",ExpressionUUID->"1ff71f4d-a479-4265-bf8e-f39042e2af30"],

Cell[TextData[{
 "The graph of the head ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "70488f5a-82e9-489d-ac51-df335d0497d7"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"u", ",", " ", "v"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20e7e909-b0e8-43c5-9625-e2adf39ae728"],
 " is this graph."
}], "Notes",ExpressionUUID->"feeb6e3f-ba78-4ae2-8c0c-d0e638a401fd"]
}, Open  ]],

