Cell[CellGroupData[{
Cell["SegmentGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"82ba6aa2-1204-4757-83aa-ef7873b300a3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SegmentGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SegmentGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10afa814-6d94-479b-babc-db6f2de37769"],
 "\[LineSeparator]",
 "gives the metric interval between ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " as a directed acyclic graph whose directed paths from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " are exactly the geodesics from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"2b261e9e-71f0-4339-85a8-deb239b760a8"],

Cell[TextData[{
 "Definition: the metric interval is ",
 StyleBox["I(u, v) = {w : d(u, w) + d(w, v) = d(u, v)}", "TI"],
 ", the vertices on some geodesic from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ". The graph has these vertices, and an edge ",
 StyleBox["w \[RightArrow] x", "TI"],
 " for every edge of ",
 StyleBox["g", "TI"],
 " between two of them with ",
 StyleBox["d(u, x) = d(u, w) + 1", "TI"],
 "."
}], "Notes",ExpressionUUID->"e62a384e-3c03-452b-9943-8d5e62c5fc4d"],

Cell[TextData[{
 "Every geodesic from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " is a directed path of the graph, and every directed path from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " is a geodesic, each exactly once. So the graph holds the whole family \
without listing it."
}], "Notes",ExpressionUUID->"7b54ea59-c61f-4c04-95e0-d7734cc7b3d0"],

Cell[TextData[{
 "It is built from the two distance fields ",
 StyleBox["d(u, \[CenterDot])", "TI"],
 " and ",
 StyleBox["d(v, \[CenterDot])", "TI"],
 " and never enumerates a path. Its size is at most that of ",
 StyleBox["g", "TI"],
 ", while the number of geodesics can be exponential in ",
 StyleBox["d(u, v)", "TI"],
 "."
}], "Notes",ExpressionUUID->"b590ed20-0275-4f64-99b7-2b1bbf4badad"],

Cell[TextData[{
 "On a square grid the interval is the rectangle spanned by ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 ", and the geodesics are the lattice paths through it. Where ",
 StyleBox["g", "TI"],
 " is disconnected between ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " the graph is empty."
}], "Notes",ExpressionUUID->"aa09ff4d-0053-4d8a-a89b-3588b6f8e73f"],

Cell[TextData[{
 "The graph of the head ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c30acc11-385f-46fd-b27d-0389145627b5"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"u", ",", " ", "v"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86867c49-878b-4592-aab1-aa26a88175eb"],
 " is this graph."
}], "Notes",ExpressionUUID->"02a395d0-fb83-4032-ae32-d9dbb2f8f9c1"]
}, Open  ]],

