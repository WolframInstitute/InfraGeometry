Cell["\<\
Away from the rim a ball is open. The ball of radius 4 about the centre of \
the square tiling is its own interior at radius 2, while its combinatorial \
interior, drawn beside it, drops the outer shell.\
\>", "ExampleText",ExpressionUUID->"573f7443-424e-4af6-9dea-527ca49b9852"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{
         RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "4"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"TopologicalInterior", "[", 
           RowBox[{
            RowBox[{"BallTopology", "[", 
             RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", "ball"}], "]"}], 
          " ", "->", " ", "StandardGreen"}], "}"}]}], "]"}], ",", "\n", 
      "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraInterior", "[", 
           RowBox[{"g", ",", " ", "ball"}], "]"}], " ", "->", " ", 
          "StandardGreen"}], "}"}]}], "]"}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7478a936-addf-4f2f-bfe6-c3775d697e17"],

