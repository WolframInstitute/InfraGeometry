   RowBox[{"{", 
    RowBox[{"topo", " ", "=", " ", 
     RowBox[{"BallTopology", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{
         RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "4"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"interior", " ", "=", " ", 
     RowBox[{"TopologicalInterior", "[", 
      RowBox[{"topo", ",", " ", "ball"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"interior", " ", "->", " ", "StandardGreen"}], ",", " ", 
         RowBox[{
          RowBox[{"Complement", "[", 
           RowBox[{"ball", ",", " ", "interior"}], "]"}], " ", "->", " ", 
          "StandardBlue"}]}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"TopologicalInterior", "[", 
       RowBox[{"topo", ",", " ", "interior"}], "]"}], " ", "==", " ", 
      "interior"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"TopologicalNeighborhood", "[", 
       RowBox[{"topo", ",", " ", "interior"}], "]"}], " ", "==", " ", 
      "interior"}], ",", "\n", "   ", 
     RowBox[{"interior", " ", "==", " ", 
      RowBox[{"InfraInterior", "[", 
       RowBox[{"g", ",", " ", "ball", ",", " ", 
        RowBox[{"Method", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Alexandrov\>\"", ",", " ", 
           RowBox[{"\"\<Radius\>\"", " ", "->", " ", "2"}]}], "}"}]}]}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
