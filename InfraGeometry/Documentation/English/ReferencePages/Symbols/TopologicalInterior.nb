Cell[CellGroupData[{
Cell["TopologicalInterior", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"76e04ea6-4a81-4ae7-848d-f4998c22d482"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TopologicalInterior"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TopologicalInterior", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["topo", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30154ef3-4707-4701-891c-e00ab7c9427e"],
 "\[LineSeparator]",
 "gives the interior of the vertex list ",
 StyleBox["s", "TI"],
 " in the topology of the digraph ",
 StyleBox["topo", "TI"],
 ": the vertices of ",
 StyleBox["s", "TI"],
 " from which no directed path leaves ",
 StyleBox["s", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"ecd589e9-b720-4636-b002-1e47326cec4d"],

Cell[TextData[{
 "Definition: ",
 StyleBox["int(s) = V \[Backslash] cl(V \[Backslash] s)", "TI"],
 ", where ",
 StyleBox["V", "TI"],
 " is the vertex set of ",
 StyleBox["topo", "TI"],
 " and ",
 StyleBox["cl", "TI"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologicalClosure"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TopologicalClosure", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "25442a67-3bda-42f5-b801-8ba12a1adbef"],
 ". It is the largest open set inside ",
 StyleBox["s", "TI"],
 "."
}], "Notes",ExpressionUUID->"ee0b72b3-05ec-4abf-bd9d-b09b7185e878"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallTopology"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallTopology", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d53a782f-134a-4de8-ae58-f5e529785a6c"],
 " a vertex ",
 StyleBox["p", "TI"],
 " of ",
 StyleBox["s", "TI"],
 " is interior when every vertex whose ball lies inside the ball at ",
 StyleBox["p", "TI"],
 " belongs to ",
 StyleBox["s", "TI"],
 "."
}], "Notes",ExpressionUUID->"a9b6a277-99c2-40f0-a826-7f5ddb164bb7"],

Cell[TextData[{
 "The interior lies in ",
 StyleBox["s", "TI"],
 ", the interior of the interior is the interior, and the interior of an \
intersection is the intersection of the interiors. A set is open when it \
equals its interior."
}], "Notes",ExpressionUUID->"a0ca4cf7-9d61-455b-8268-9ae267f31a54"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraInterior"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraInterior", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Alexandrov\>\"", ",", " ", 
       RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
        StyleBox["r", "TI"]}]}], "}"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef331011-c3ec-423f-9217-fe8eb334da33"],
 " is this interior in the ball topology of radius ",
 StyleBox["r", "TI"],
 ". The default method of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraInterior"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraInterior", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e7abbe53-f1ea-497c-9d62-ba0c93b71dbe"],
 " is the combinatorial interior: the vertices of ",
 StyleBox["s", "TI"],
 " all of whose neighbours lie in ",
 StyleBox["s", "TI"],
 "."
}], "Notes",ExpressionUUID->"5ee88902-3925-461b-9652-da1d5f441904"],

Cell["The result is a sorted vertex list.", "Notes",ExpressionUUID->"22ba1cb4-929d-4c43-b29d-16776f771fb0"]
}, Open  ]],

