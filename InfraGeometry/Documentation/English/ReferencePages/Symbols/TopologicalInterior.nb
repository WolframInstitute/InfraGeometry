Cell["\<\
The interior of a ball about the centre that reaches within two steps of the \
rim, in the ball topology of radius 2, on the discretized plane, the square \
tiling and the hexagonal tiling. The interior is green. The rest of the ball \
is blue: the vertices whose ball contains the ball of a vertex outside.\
\>", "ExampleText",ExpressionUUID->"222b1c5f-ca1a-4294-975e-64954aabb3a0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"region", " ", "=", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{
             RowBox[{"VertexEccentricity", "[", 
              RowBox[{"g", ",", " ", "c"}], "]"}], " ", "-", " ", "2"}]}], 
           "]"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"interior", " ", "=", " ", 
        RowBox[{"TopologicalInterior", "[", 
         RowBox[{
          RowBox[{"BallTopology", "[", 
           RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", "region"}], "]"}]}],
        "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"interior", " ", "->", " ", "StandardGreen"}], ",", " ", 
          RowBox[{
           RowBox[{"Complement", "[", 
            RowBox[{"region", ",", " ", "interior"}], "]"}], " ", "->", " ", 
           "StandardBlue"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8c634f3b-2d1b-40cf-a49f-70b582eb84d5"],

