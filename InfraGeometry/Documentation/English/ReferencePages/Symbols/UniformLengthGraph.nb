Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"BlockRandom", "[", 
      RowBox[{
       RowBox[{"UniformLengthGraph", "[", 
        RowBox[{
         RowBox[{"RegionBoundary", " ", "@", " ", 
          RowBox[{"BoundaryDiscretizeRegion", " ", "@", " ", 
           RowBox[{"Ellipsoid", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
