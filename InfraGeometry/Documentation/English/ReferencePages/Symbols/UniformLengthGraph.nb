Notebook[{

Cell[CellGroupData[{
Cell["UniformLengthGraph", "ObjectName",ExpressionUUID->"355e851f-130b-4ea3-b150-317692d01eba"],

Cell["LLM generated.", "Notes",ExpressionUUID->"99c34003-3fe9-4377-8c23-62bdbbc2a62e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"50e73ef7-2f5a-4d5a-b7d6-a85f3f57ca95"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["UniformLengthGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/UniformLengthGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["region", "TI"], ",", " ", 
    StyleBox["h", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92dc8c26-9e07-4841-b280-60fd872151ca"],
 "\[LineSeparator]",
 "gives the contact graph of a packing of ",
 StyleBox["region", "TI"],
 " by spheres of diameter ",
 StyleBox["h", "TI"],
 ": two centres are joined when their distance is ",
 StyleBox["h", "TI"],
 " up to the contact tolerance.",
 "\n"
}], "Usage",ExpressionUUID->"14fe70c8-2d6b-4d59-8f02-1572596af1cf"],

Cell[TextData[{
 "The region is taken as given, by its ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RegionDimension"]], "paclet:ref/RegionDimension"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "63c64262-665d-497e-88c1-5b78a9906fb6"],
 ": a curve, a surface or a solid. A ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BoundaryMeshRegion"]], "paclet:ref/BoundaryMeshRegion"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d5a8f9ef-8ee1-4d0d-894f-599759441a60"],
 " is the solid it bounds; its surface is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RegionBoundary"]], "paclet:ref/RegionBoundary"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "adda7659-12d2-45c9-937d-75be9313a001"],
 " of it, as in ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegionBoundary",
    BaseStyle->"Link"], " ", "@", " ", 
   RowBox[{
    ButtonBox["BoundaryDiscretizeRegion",
     BaseStyle->"Link"], " ", "@", " ", 
    RowBox[{
     ButtonBox["Ellipsoid",
      BaseStyle->"Link"], "[", "\[Ellipsis]", "]"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29f795dd-f1de-4615-9003-c5e2beb32a03"],
 "."
}], "Notes",ExpressionUUID->"8a6a97fc-f442-4357-b161-450ffafea0ef"],

Cell[TextData[{
 "The number of spheres follows from ",
 StyleBox["h", "TI"],
 " and the measure ",
 StyleBox["C", "TI"],
 " of the region: ",
 StyleBox["C", "TI"],
 "/",
 StyleBox["h", "TI"],
 " on a closed curve, ",
 StyleBox["C", "TI"],
 "/",
 StyleBox["h", "TI"],
 " + 1 on an open curve, 2",
 StyleBox["C", "TI"],
 "/(\[Sqrt]3 ",
 StyleBox["h", "TI"],
 "\.b2) on a surface, the count of a hexagonal packing, and ",
 StyleBox["C", "TI"],
 " (1.12/",
 StyleBox["h", "TI"],
 ")\.b3 in a solid, rounded, and at least 1."
}], "Notes",ExpressionUUID->"180ac218-a2d9-492b-894e-b9811ac965a8"],

Cell[TextData[{
 "On a curve the centres lie at equal arclength along a fine discretization \
of the curve, ",
 StyleBox["C", "TI"],
 "/",
 StyleBox["n", "TI"],
 " apart, the length nearest to ",
 StyleBox["h", "TI"],
 " that divides the curve evenly. A closed curve gives a cycle, an open curve \
a path."
}], "Notes",ExpressionUUID->"3fdb2b38-91ed-490d-ad66-50fab9d80da0"],

Cell[TextData[{
 "On a surface or in a solid the centres start at random points of the region \
and are relaxed: each pair closer than ",
 StyleBox["h", "TI"],
 " is pushed apart to ",
 StyleBox["h", "TI"],
 ", and every centre is moved to the nearest point of the region, until no \
centre moves farther than ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Tolerance"]], "paclet:ref/Tolerance"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1ae2a33b-21dc-463d-8579-c572358176ce"],
 " or for at most ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaxIterations"]], "paclet:ref/MaxIterations"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "751b94cc-e432-426f-a687-5c22e9468a06"],
 " steps."
}], "Notes",ExpressionUUID->"3581d880-3dc5-4a5d-808f-2eff863ac5e5"],

Cell[TextData[{
 "Two centres are joined when their distance lies within ",
 Cell[BoxData["\"\<ContactTolerance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6ca41e5-a9d1-4b6a-9e3e-bcd2bd8c141a"],
 " \[Times] ",
 StyleBox["h", "TI"],
 " of ",
 StyleBox["h", "TI"],
 ". Every edge has a length between (1 \[Minus] ",
 StyleBox["t", "TI"],
 ") ",
 StyleBox["h", "TI"],
 " and (1 + ",
 StyleBox["t", "TI"],
 ") ",
 StyleBox["h", "TI"],
 ", ",
 StyleBox["t", "TI"],
 " the tolerance."
}], "Notes",ExpressionUUID->"fe0be4ae-a93c-4495-978c-97efa5d28d7b"],

Cell[TextData[{
 "The vertices are 1, \[Ellipsis], ",
 StyleBox["n", "TI"],
 ". The centres are dropped and the graph is laid out by springs, unless ",
 Cell[BoxData["\"\<KeepCoordinates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fed289c9-ad2f-4515-a2bd-9162ba9b547c"],
 " -> ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0bae3321-bee9-48f4-aadc-954f5b4abba7"],
 " keeps them as the vertex coordinates."
}], "Notes",ExpressionUUID->"27f86005-f428-465e-b889-daebaca93d08"],

Cell[TextData[{
 "The start is drawn with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomPoint"]], "paclet:ref/RandomPoint"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f46d5c86-7ff8-4765-bb46-464298a209c2"],
 ", so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "eeed766a-9f13-49ec-8352-aed40f2b2b4e"],
 " fixes the graph. ",
 Cell[BoxData["\"\<InitialPoints\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f61a813-6538-4027-af35-79d3961de457"],
 " gives the start instead, and then the number of spheres is the number of \
points. A curve has no random start."
}], "Notes",ExpressionUUID->"3520f539-f742-439b-87f0-932867f9c0f7"],

