Cell[TextData[{
 "Fewer steps leave the spheres overlapping: the closest pair of centres over \
",
 StyleBox["h", "TI"],
 " after 1, 10 and 200 steps on the disk."
}], "ExampleText",ExpressionUUID->"0594d598-9757-48a2-902f-644f07e9f909"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"UniformLengthGraph", "[", 
          RowBox[{
           RowBox[{"Disk", "[", "]"}], ",", " ", "0.15", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}], ",", 
           " ", 
           RowBox[{"MaxIterations", " ", "->", " ", "steps"}]}], "]"}]}], 
        ")"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"Min", "[", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"Flatten", " ", "@", " ", 
          RowBox[{"DistanceMatrix", " ", "@", " ", 
           RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], ",", " ", "0."}], 
        "]"}], "]"}], " ", "/", " ", "0.15"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"steps", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "10", ",", " ", "200"}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3af980d4-4834-4fc7-9b69-7c7d9c73cf31"],

