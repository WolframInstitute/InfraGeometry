Cell[TextData[{
 "A boundary mesh region is a solid. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BoundaryDiscretizeRegion"]], 
    "paclet:ref/BoundaryDiscretizeRegion"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "41e592e5-4577-4a56-86e8-343993673c2c"],
 " of a ball bounds the solid ball, so the spheres fill it rather than mesh \
its surface; the distances of the centres from the origin, for the mesh and \
for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Sphere"]], "paclet:ref/Sphere"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "21a3558c-36e4-476d-a8ed-ce5f9a14fe63"],
 ":"
}], "ExampleText",ExpressionUUID->"3f8ce882-b0b7-43c3-9e13-195699b70232"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"solid", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"UniformLengthGraph", "[", 
        RowBox[{
         RowBox[{"BoundaryDiscretizeRegion", "[", 
          RowBox[{"Ball", "[", "]"}], "]"}], ",", " ", "100", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"surface", " ", "=", " ", 
     RowBox[{"UniformLengthGraph", "[", 
      RowBox[{
       RowBox[{"Sphere", "[", "]"}], ",", " ", "100", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{"solid", ",", " ", "surface"}], "}"}], "]"}], ",", " ", 
     RowBox[{"MinMax", "[", 
      RowBox[{"Norm", " ", "/@", " ", 
       RowBox[{"GraphEmbedding", "[", "solid", "]"}]}], "]"}], ",", " ", 
     RowBox[{"MinMax", "[", 
      RowBox[{"Norm", " ", "/@", " ", 
       RowBox[{"GraphEmbedding", "[", "surface", "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"61ca97ca-2c81-4cb8-b0a9-adee6b646240"],

