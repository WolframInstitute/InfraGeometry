Cell["\<\
The surface of a prolate ellipsoid. Most centres have six neighbours, at the \
waist and at the tips alike:\
\>", "ExampleText",ExpressionUUID->"56b70887-768d-4029-b9cb-5a0c7a2cc56f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"BlockRandom", "[", 
      RowBox[{
       RowBox[{"UniformLengthGraph", "[", 
        RowBox[{
         RowBox[{"RegionBoundary", " ", "@", " ", 
          RowBox[{"BoundaryDiscretizeRegion", " ", "@", " ", 
           RowBox[{"Ellipsoid", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"5", ",", " ", "1", ",", " ", "1"}], "}"}]}], "]"}]}]}],
          ",", " ", "0.44", ",", "\n", "      ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}],
        ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Graph", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"Counts", "[", 
        RowBox[{"VertexDegree", "[", "g", "]"}], "]"}]}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a0bc0861-ce55-4962-9674-43690b3b452f"],

