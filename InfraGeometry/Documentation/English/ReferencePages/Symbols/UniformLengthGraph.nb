Cell["\<\
Spheres of diameter 0.25 packed in a disk, on a sphere and in a ball, and the \
shortest and the longest edge over 0.25.\
\>", "ExampleText",ExpressionUUID->"920fd335-cac4-48e3-8307-0850cb8b29a3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"packings", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"UniformLengthGraph", "[", 
         RowBox[{"region", ",", " ", "0.25", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"region", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Disk", "[", "]"}], ",", " ", 
           RowBox[{"Sphere", "[", "]"}], ",", " ", 
           RowBox[{"Ball", "[", "]"}]}], "}"}]}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", "packings", "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"MinMax", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"EuclideanDistance", " ", "@@", " ", 
            RowBox[{
             RowBox[{"GraphEmbedding", "[", "packing", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
           "&"}], " ", "/@", " ", 
          RowBox[{"EdgeList", "[", "packing", "]"}]}], "]"}], " ", "/", " ", 
        "0.25"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"packing", ",", " ", "packings"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b0b219a2-bbb7-45c2-b51d-014a39572513"],

