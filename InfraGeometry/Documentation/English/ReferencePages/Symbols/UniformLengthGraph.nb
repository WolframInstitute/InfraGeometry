Cell[TextData[{
 "The graph distance times ",
 StyleBox["h", "TI"],
 " approximates the distance in the region: from the northernmost to the \
southernmost centre of the unit sphere, against \[Pi]:"
}], "ExampleText",ExpressionUUID->"59917c14-a7dd-427b-83c4-7c889aeb7826"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"BlockRandom", "[", 
      RowBox[{
       RowBox[{"UniformLengthGraph", "[", 
        RowBox[{
         RowBox[{"Sphere", "[", "]"}], ",", " ", "0.2", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}],
        ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"z", " ", "=", " ", 
     RowBox[{
      RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "3"}], "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"0.2", " ", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"Ordering", "[", 
          RowBox[{"z", ",", " ", 
           RowBox[{"-", "1"}]}], "]"}]}], ",", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"Ordering", "[", 
          RowBox[{"z", ",", " ", "1"}], "]"}]}]}], "]"}]}], ",", " ", 
     RowBox[{"N", "[", "Pi", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0af236a2-87c0-482f-bace-023ba7ffc5b4"],

