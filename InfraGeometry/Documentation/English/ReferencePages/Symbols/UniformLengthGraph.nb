Cell[TextData[{
 "The uniform-length ellipsoids of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ab90683b-3b0d-4199-ba33-195abc876594"],
 " are these graphs on the region bounded by a discretized ellipsoid, with \
100, 300 or 1000 spheres."
}], "ExampleText",ExpressionUUID->"004e4af4-9d2c-4008-a907-2493c66d6695"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"UniformLengthGraph", "[", 
        RowBox[{
         RowBox[{"BoundaryDiscretizeRegion", " ", "@", " ", 
          RowBox[{"Ellipsoid", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"5", ",", " ", "1", ",", " ", "1"}], "}"}]}], "]"}]}], ",",
          " ", "100", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"substrate", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"\"\<UniformLengthProlateEllipsoidGraph\>\"", ",", 
         " ", "\"\<Small\>\"", ",", " ", "\"\<Default\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"g", ",", " ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"EdgeList", "[", "g", "]"}], "]"}], " ", "===", " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"EdgeList", "[", "substrate", "]"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f4f87904-1ba7-499f-90e6-6ff5d1cc57b9"],

