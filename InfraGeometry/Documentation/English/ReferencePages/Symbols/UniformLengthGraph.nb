Cell[TextData[{
 "A corner of a curve shortens the chord across it. At a right angle the \
chord falls below ",
 StyleBox["(1 \[Minus] t)h", "TI"],
 " and the path breaks there:"
}], "ExampleText",ExpressionUUID->"c7fafe11-7960-4b4b-9abb-5dc2786ea642"],

