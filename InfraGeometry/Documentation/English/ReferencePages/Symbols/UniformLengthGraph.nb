     "7ee348cc-ee28-4f02-a4fc-85507c3cc567"], Cell[TextData[StyleBox[
    "C(1.12/h)\.b3", "TI"]], "TableText",ExpressionUUID->
     "e4e88476-267f-4cee-8d18-184bd5f380e8"], Cell[
    "random start, relaxed", "TableText",ExpressionUUID->
     "cd7b8d03-59b2-4a8e-95fc-1c9d0b90341c"]}
  }]], "3ColumnTableMod",ExpressionUUID->"a9b02b4d-556a-4aa6-a181-\
337f2200e85b"],

Cell[TextData[{
 "The relaxation pushes every pair closer than ",
 StyleBox["h", "TI"],
 " apart to ",
 StyleBox["h", "TI"],
 " and moves each centre to the nearest point of the region, until no centre \
moves more than ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Tolerance"]], "paclet:ref/Tolerance"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a866f8f3-2798-460a-b01d-ba1c207d17cb"],
 " or for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaxIterations"]], "paclet:ref/MaxIterations"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ccc08543-f7e6-4247-baab-db1f0eec46f8"],
 " steps. The random start uses the current random state, so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c8488cfd-e911-46cf-b1dd-688e2540cca2"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BlockRandom"]], "paclet:ref/BlockRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4fe925f1-a8e6-497e-b481-2f565b273f18"],
 " fixes the graph."
}], "Notes",ExpressionUUID->"4a4f5d2f-2075-4eb5-9a47-91da3455818d"],

