Cell[TextData[{
 "A disk, a sphere and a ball at ",
 StyleBox["h", "TI"],
 " = 0.25, labelled with the shortest and the longest edge over ",
 StyleBox["h", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"fcb28ab4-8e42-4e92-9a83-39fa0f3b84d2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"UniformLengthGraph", "[", 
           RowBox[{"region", ",", " ", "0.25", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"Graph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"Round", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"MinMax", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"EuclideanDistance", " ", "@@", " ", 
                RowBox[{
                 RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
               "&"}], " ", "/@", " ", 
              RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}], "/", "0.25"}], ",",
            " ", "0.01"}], "]"}]}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"region", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Disk", "[", "]"}], ",", " ", 
        RowBox[{"Sphere", "[", "]"}], ",", " ", 
        RowBox[{"Ball", "[", "]"}]}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5bb8515f-8d3c-4dc0-ad9c-faa5e0bee907"],

