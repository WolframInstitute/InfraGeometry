Cell["InitialPoints", "ExampleSubsection",ExpressionUUID->"e14ecdf9-e78d-41fd-93b5-d8fe405cc7a9"],

Cell["\<\
Four, six and twelve points on the sphere, relaxed at the edge lengths of the \
inscribed tetrahedron, octahedron and icosahedron, touch as these solids:\
\>", "ExampleText",ExpressionUUID->"05f5a5b0-7c10-4698-a37a-2d2419c9c1b8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lengths", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"8", "/", "3"}], "]"}], ",", " ", 
       RowBox[{"Sqrt", "[", "2", "]"}], ",", " ", 
       RowBox[{"4", "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"10", " ", "+", " ", 
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", "5", "]"}]}]}], "]"}]}]}], "}"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"packings", " ", "=", " ", 
     RowBox[{"BlockRandom", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"UniformLengthGraph", "[", 
           RowBox[{
            RowBox[{"Sphere", "[", "]"}], ",", " ", "#1", ",", " ", 
            RowBox[{"\"\<InitialPoints\>\"", " ", "->", " ", 
             RowBox[{"RandomPoint", "[", 
              RowBox[{
               RowBox[{"Sphere", "[", "]"}], ",", " ", "#2"}], "]"}]}], ",", 
            " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}], " ", "&"}], ",", "\n", "      ", 
         RowBox[{"{", 
          RowBox[{"lengths", ",", " ", 
           RowBox[{"{", 
            RowBox[{"4", ",", " ", "6", ",", " ", "12"}], "}"}]}], "}"}]}], 
        "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Graph", "[", 
        RowBox[{"#1", ",", " ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"IsomorphicGraphQ", "[", 
           RowBox[{"#1", ",", " ", 
            RowBox[{"TessellationGraph", "[", 
             RowBox[{"{", 
              RowBox[{"3", ",", " ", "#2"}], "}"}], "]"}]}], "]"}]}]}], "]"}],
        " ", "&"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"packings", ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}]}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e89eb843-c2ac-46e1-abf9-f9f439f5823d"],

