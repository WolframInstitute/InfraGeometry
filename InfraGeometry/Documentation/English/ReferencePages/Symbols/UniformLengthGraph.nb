Cell["ContactTolerance", "ExampleSubsection",ExpressionUUID->"64f30b7e-a0dc-42a4-9feb-af45200c8bf9"],

Cell["\<\
A wider band joins more centres: the tolerance 0.1, 0.25 and 0.4 on the disk, \
and the number of edges.\
\>", "ExampleText",ExpressionUUID->"cff4728b-1ccb-42ce-b503-9557e8b5e3e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"packings", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"UniformLengthGraph", "[", 
         RowBox[{
          RowBox[{"Disk", "[", "]"}], ",", " ", "0.15", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}], ",", 
          " ", 
          RowBox[{"\"\<ContactTolerance\>\"", " ", "->", " ", "tolerance"}]}],
          "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"tolerance", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0.1", ",", " ", "0.25", ",", " ", "0.4"}], "}"}]}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
