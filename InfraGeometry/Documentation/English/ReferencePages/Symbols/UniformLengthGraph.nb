Notebook[{

Cell[CellGroupData[{
Cell["UniformLengthGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"93383f7b-44f7-45f2-a9ab-e210b60e936a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["UniformLengthGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/UniformLengthGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["region", "TI"], ",", " ", 
    StyleBox["h", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f862365d-d3ea-4584-a428-8151829340ad"],
 "\[LineSeparator]",
 "gives the contact graph of a packing of ",
 StyleBox["region", "TI"],
 " by spheres of diameter ",
 StyleBox["h", "TI"],
 ": two centres are joined when their distance is ",
 StyleBox["h", "TI"],
 " up to the contact tolerance.",
 "\n"
}], "Usage",ExpressionUUID->"660d76d7-798f-4cc0-bf19-d0b4d68e73e5"],

Cell[TextData[{
 "The vertices are the centres ",
 StyleBox["x\:2081", "TI"],
 ", \[Ellipsis], ",
 StyleBox["x\:2099", "TI"],
 " in the region, and ",
 StyleBox["x\:1d62x\:2c7c", "TI"],
 " is an edge when ",
 StyleBox["|\:2016x\:1d62 \[Minus] x\:2c7c\:2016 \[Minus] h| \[LessEqual] t \
h", "TI"],
 ", with ",
 StyleBox["t", "TI"],
 " the contact tolerance. Every edge has a length between ",
 StyleBox["(1 \[Minus] t)h", "TI"],
 " and ",
 StyleBox["(1 + t)h", "TI"],
 ", so the graph distance times ",
 StyleBox["h", "TI"],
 " approximates the distance in the region."
}], "Notes",ExpressionUUID->"ce42836d-3e59-4025-bd91-a024923974f2"],

Cell[TextData[{
 "The region is taken by its ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RegionDimension"]], "paclet:ref/RegionDimension"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1a700dc5-acca-4cda-9d0a-00bd96625bce"],
 ": a curve, a surface or a solid. A surface given by an equation is passed \
as ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegionBoundary",
    BaseStyle->"Link"], " ", "@", " ", 
   RowBox[{
    ButtonBox["BoundaryDiscretizeRegion",
     BaseStyle->"Link"], "[", "\[Ellipsis]", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27746723-a7d7-4fdf-b9c3-a2e936bf2226"],
 "."
}], "Notes",ExpressionUUID->"755c362d-2ac8-4f48-8c63-77106d93e347"],

Cell[TextData[{
 "The number of centres follows from ",
 StyleBox["h", "TI"],
 " and the measure ",
 StyleBox["C", "TI"],
 " of the region:"
}], "Notes",ExpressionUUID->"3b7bf230-2e5b-41b7-a0fe-1316b1e768af"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "029fe128-5712-4a4b-a94f-2a68834e210d"], Cell["Region", "TableText",
     FontWeight->Bold,ExpressionUUID->"1560bbc6-5bb4-4b70-a74d-b3117f023ae1"],
