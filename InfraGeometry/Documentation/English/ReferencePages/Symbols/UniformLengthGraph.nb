Cell["\<\
Spheres of diameter 0.25 packed in a disk, on a sphere and in a ball, and the \
shortest and the longest edge over 0.25.\
\>", "ExampleText",ExpressionUUID->"2be6e5ee-4b75-40ed-ba82-48191c4e7346"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"packings", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"UniformLengthGraph", "[", 
         RowBox[{"region", ",", " ", "0.25", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"region", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Disk", "[", "]"}], ",", " ", 
           RowBox[{"Sphere", "[", "]"}], ",", " ", 
           RowBox[{"Ball", "[", "]"}]}], "}"}]}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", "packings", "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"MinMax", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"EuclideanDistance", " ", "@@", " ", 
            RowBox[{
             RowBox[{"GraphEmbedding", "[", "packing", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
           "&"}], " ", "/@", " ", 
          RowBox[{"EdgeList", "[", "packing", "]"}]}], "]"}], " ", "/", " ", 
        "0.25"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"packing", ",", " ", "packings"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ffb5be70-3f78-419d-ad9e-d4b725f8adff"],

