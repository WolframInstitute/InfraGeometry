          RowBox[{"IsomorphicGraphQ", "[", 
           RowBox[{"#1", ",", " ", 
            RowBox[{"TessellationGraph", "[", 
             RowBox[{"{", 
              RowBox[{"3", ",", " ", "#2"}], "}"}], "]"}]}], "]"}]}]}], "]"}],
        " ", "&"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"packings", ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}]}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
