          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", "5", "]"}]}]}], "]"}]}]}], "}"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"packings", " ", "=", " ", 
     RowBox[{"BlockRandom", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"UniformLengthGraph", "[", 
