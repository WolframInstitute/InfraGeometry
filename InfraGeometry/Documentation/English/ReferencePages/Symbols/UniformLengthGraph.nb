Notebook[{

Cell[CellGroupData[{
Cell["UniformLengthGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"94af33b8-30ae-47de-97e9-cc96c966e7cc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["UniformLengthGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/UniformLengthGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["region", "TI"], ",", " ", 
    StyleBox["h", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3b58be5-0bcf-46e7-aa92-e364740095f1"],
 "\[LineSeparator]",
 "gives the contact graph of a packing of ",
 StyleBox["region", "TI"],
 " by spheres of diameter ",
 StyleBox["h", "TI"],
 ": two centres are joined when their distance is ",
 StyleBox["h", "TI"],
 " up to the contact tolerance.",
 "\n"
}], "Usage",ExpressionUUID->"4a44371b-6196-4706-b863-b630f3f18224"],

Cell[TextData[{
 "The vertices are the centres ",
 StyleBox["x\:2081", "TI"],
 ", \[Ellipsis], ",
 StyleBox["x\:2099", "TI"],
 " in the region, and ",
 StyleBox["x\:1d62x\:2c7c", "TI"],
 " is an edge when ",
 StyleBox["|\:2016x\:1d62 \[Minus] x\:2c7c\:2016 \[Minus] h| \[LessEqual] t \
h", "TI"],
 ", with ",
 StyleBox["t", "TI"],
 " the contact tolerance. Every edge has a length between ",
 StyleBox["(1 \[Minus] t)h", "TI"],
 " and ",
 StyleBox["(1 + t)h", "TI"],
 ", so the graph distance times ",
 StyleBox["h", "TI"],
 " approximates the distance in the region."
}], "Notes",ExpressionUUID->"7adbdbeb-356a-4c99-8389-813f4d2981fa"],

Cell[TextData[{
 "The region is taken by its ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RegionDimension"]], "paclet:ref/RegionDimension"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "34737113-1e49-4a6e-89d8-c24f4729ffea"],
 ": a curve, a surface or a solid. A surface given by an equation is passed \
as ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegionBoundary",
    BaseStyle->"Link"], " ", "@", " ", 
   RowBox[{
    ButtonBox["BoundaryDiscretizeRegion",
     BaseStyle->"Link"], "[", "\[Ellipsis]", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ddbcc4dd-bd82-49bb-bb0e-7e0fb3f77445"],
 "."
}], "Notes",ExpressionUUID->"6e62ebdd-ccd6-4069-92e4-08bf56151952"],

Cell[TextData[{
 "The number of centres follows from ",
 StyleBox["h", "TI"],
 " and the measure ",
 StyleBox["C", "TI"],
 " of the region:"
}], "Notes",ExpressionUUID->"36ecec73-95d2-4aca-9aa2-92f6d8c3a982"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e2721a7c-7c34-4491-8a13-57a3d5c526e0"], Cell["Region", "TableText",
     FontWeight->Bold,ExpressionUUID->"b735ee4b-04a0-49bf-9c76-9e5522acf2ab"],
     Cell["Centres", "TableText",
     FontWeight->Bold,ExpressionUUID->"4769fdf2-71db-4e51-8c57-e184075ff3f3"],
     Cell["Placement", "TableText",
     FontWeight->Bold,ExpressionUUID->"8f9dec28-003c-4781-bfe2-29679a0ec024"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "60dd8541-7915-4ff3-8ee0-c2995a2979da"], Cell[
    "closed curve", "TableText",ExpressionUUID->
     "4b60e5c2-2608-4419-9ad8-fea73b2bcd75"], Cell[TextData[{
     StyleBox["C/h", "TI"],
     ", rounded"
    }], "TableText",ExpressionUUID->"80cd7562-73ae-428b-8f2b-d81d56381f26"], 
    Cell["equal arclength; the graph is a cycle", "TableText",ExpressionUUID->
     "cb6c04ed-1a7b-4bba-9cc4-89db81e83030"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "48d1c3cc-dc18-4a1c-bc6a-053a12ae278b"], Cell[
    "open curve", "TableText",ExpressionUUID->
     "89248831-f6d3-48e4-a793-57536dff3355"], Cell[TextData[StyleBox[
    "C/h + 1", "TI"]], "TableText",ExpressionUUID->
     "8e4aba43-d7db-4378-a275-ec89deb2b2b4"], Cell[
    "equal arclength; the graph is a path", "TableText",ExpressionUUID->
     "6c131c1d-9606-46ee-894a-bb98941bc803"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9bd5b3eb-3396-46ff-9292-7c8ae331c620"], Cell[
    "surface", "TableText",ExpressionUUID->
     "2be02471-a95a-4bb2-bc54-4cbf775a8bfc"], Cell[TextData[{
     StyleBox["2C/(\[Sqrt]3 h\.b2)", "TI"],
     ", the hexagonal packing"
    }], "TableText",ExpressionUUID->"72c1d75d-3ca3-408a-bfa5-b26f1fa1f328"], 
    Cell["random start, relaxed", "TableText",ExpressionUUID->
     "f8623ff6-27e6-4b02-a2ed-0a91a2ccb955"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "aeb92641-ae2a-461c-b0d6-7fa0656761d1"], Cell[
    "solid", "TableText",ExpressionUUID->
     "b58e2042-513c-4430-bb6c-0ab9291e7081"], Cell[TextData[StyleBox[
    "C(1.12/h)\.b3", "TI"]], "TableText",ExpressionUUID->
     "a36a98f8-85ee-42fa-8a2a-fd82bc9749cb"], Cell[
    "random start, relaxed", "TableText",ExpressionUUID->
     "f31a3c68-cc1a-4e12-bbba-8fb4e5b6960d"]}
  }]], "3ColumnTableMod",ExpressionUUID->"c30e727e-932d-44e3-a148-\
afad96b9df57"],

Cell[TextData[{
 "The relaxation pushes every pair closer than ",
 StyleBox["h", "TI"],
 " apart to ",
 StyleBox["h", "TI"],
 " and moves each centre to the nearest point of the region, until no centre \
moves more than ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Tolerance"]], "paclet:ref/Tolerance"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8888d7ca-630d-4bfd-8226-99ce9b60eace"],
 " or for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaxIterations"]], "paclet:ref/MaxIterations"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d384f5f0-f67b-46e4-bf4b-f911e054859e"],
 " steps. The random start uses the current random state, so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "79a460da-9525-455a-afc6-45cec24da440"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BlockRandom"]], "paclet:ref/BlockRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "022b211a-7dac-4641-9323-124e71897bdc"],
 " fixes the graph."
}], "Notes",ExpressionUUID->"30519ddf-d4ab-4795-9e4f-f8fc221b0985"],

