Cell[TextData[{
 "The unit sphere packed by spheres of diameter 0.5, 0.3 and 0.2, labelled \
with the number of centres, ",
 StyleBox["8\[Pi]/(\[Sqrt]3 h\.b2)", "TI"],
 " rounded:"
}], "ExampleText",ExpressionUUID->"a59c47c8-bccc-4ee0-b7fb-d52b2bf5d94d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"UniformLengthGraph", "[", 
           RowBox[{
            RowBox[{"Sphere", "[", "]"}], ",", " ", "h", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"Graph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"VertexCount", "[", "g", "]"}], ",", " ", 
           RowBox[{"Round", "[", 
            RowBox[{"8", " ", 
             RowBox[{"Pi", "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Sqrt", "[", "3", "]"}], " ", 
                RowBox[{"h", "^", "2"}]}], ")"}]}]}], "]"}]}], "}"}]}]}], 
       "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"h", ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.5", ",", " ", "0.3", ",", " ", "0.2"}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e3e14cff-48b0-4318-8813-a8993737dfdc"],

