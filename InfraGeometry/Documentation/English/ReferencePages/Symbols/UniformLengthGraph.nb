      RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "3"}], "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
