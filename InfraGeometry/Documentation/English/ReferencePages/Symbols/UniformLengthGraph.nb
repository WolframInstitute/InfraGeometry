Notebook[{

Cell[CellGroupData[{
Cell["UniformLengthGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c48490a1-e550-4f7a-8dbb-073cf2809b32"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["UniformLengthGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/UniformLengthGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["region", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0d1f95f-e5b0-4ae6-8908-30db32a29553"],
 "\[LineSeparator]",
 "gives the contact graph of ",
 StyleBox["n", "TI"],
 " equal hard spheres packed in ",
 StyleBox["region", "TI"],
 ": two centres are joined when their spheres touch.",
 "\n"
}], "Usage",ExpressionUUID->"d316659f-c851-4c31-9e7d-2d82870beeb8"],

Cell[TextData[{
 "Construction: ",
 StyleBox["n", "TI"],
 " centres are seeded in ",
 StyleBox["region", "TI"],
 ", on a sphere or the surface of an ellipsoid along a Fibonacci spiral, \
elsewhere at random. Then they are relaxed: each pair closer than 2",
 StyleBox["r", "TI"],
 " is pushed apart to 2",
 StyleBox["r", "TI"],
 ", and the centres are projected back to ",
 StyleBox["region", "TI"],
 ", until no centre moves or for at most ",
 Cell[BoxData["\"\<MaxIterations\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5543ec9-745d-4dc5-8f0c-bcd0bc211191"],
 " steps. Two centres are joined when their distance is 2",
 StyleBox["r", "TI"],
 " up to ",
 Cell[BoxData["\"\<ContactTolerance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "044e8fb2-45b7-4c1f-9a8c-b0c408841083"],
 " \[Times] 2",
 StyleBox["r", "TI"],
 "."
}], "Notes",ExpressionUUID->"eb383122-36b6-417e-8064-1a2fcc0b676b"],

Cell[TextData[{
 "A solid region is filled and a surface is meshed. The edges have one \
length, 2",
 StyleBox["r", "TI"],
 ", up to the tolerance, so the graph distance times 2",
 StyleBox["r", "TI"],
 " approximates the distance in ",
 StyleBox["region", "TI"],
 "."
}], "Notes",ExpressionUUID->"4c338580-dd70-45c9-9448-186bff9d1f50"],

Cell[TextData[{
 "The radius spaces the spheres to cover the content ",
 StyleBox["C", "TI"],
 " of ",
 StyleBox["region", "TI"],
 ": on a surface 2",
 StyleBox["r", "TI"],
 " = \[Sqrt](2",
 StyleBox["C", "TI"],
 "/(",
 StyleBox["n", "TI"],
 "\[Sqrt]3)), the spacing of a hexagonal packing, and in a solid 2",
 StyleBox["r", "TI"],
 " = 1.12 (",
 StyleBox["C", "TI"],
 "/",
 StyleBox["n", "TI"],
 ")^(1/3). ",
 Cell[BoxData["\"\<Overpack\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "567b357e-de56-46eb-8460-8fef7b60f0c0"],
 " multiplies ",
 StyleBox["r", "TI"],
 ", and ",
 Cell[BoxData["\"\<Radius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1283eb6-e9d7-497c-ad8a-66a094d6afea"],
 " gives ",
 StyleBox["r", "TI"],
 " outright."
}], "Notes",ExpressionUUID->"a2510ba2-bbad-42bd-8117-675b0ba6c5a1"],

Cell[TextData[{
 "The vertices are 1, \[Ellipsis], ",
 StyleBox["n", "TI"],
 ". The packing is dropped and the graph is laid out by springs, unless ",
 Cell[BoxData["\"\<KeepCoordinates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "227a322a-f234-4f60-8377-c5cf75c87f21"],
 " -> ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "36fd74fa-749c-4f58-9b16-ddfdcb7b3584"],
 " stores it as the vertex coordinates."
}], "Notes",ExpressionUUID->"d683819b-d77d-4813-90f7-79406a3622c4"],

Cell[TextData[{
 "A random seed is drawn with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomPoint"]], "paclet:ref/RandomPoint"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "72860df2-7cd6-4e9b-a865-7a38bee2f58d"],
 ", so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "eb45a578-a63e-4041-b9dc-f84daf5a4464"],
 " fixes the graph; on a sphere or an ellipsoid surface the graph is the same \
every time."
}], "Notes",ExpressionUUID->"ffec1b66-7166-4a65-aa67-f948bacac8e7"],

