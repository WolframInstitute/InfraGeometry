Cell[TextData[{
 "The number of vertices follows from ",
 StyleBox["h", "TI"],
 ": on the unit sphere it is 8\[Pi]/(\[Sqrt]3 ",
 StyleBox["h", "TI"],
 "\.b2), rounded."
}], "ExampleText",ExpressionUUID->"4ea610fa-59cf-49c3-96a9-ced67e57789c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", ",", " ", 
     RowBox[{
      RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
      RowBox[{"VertexCount", " ", "@", " ", 
       RowBox[{"UniformLengthGraph", "[", 
        RowBox[{
         RowBox[{"Sphere", "[", "]"}], ",", " ", "h"}], "]"}]}]}], ",", " ", 
     RowBox[{"Round", "[", 
      RowBox[{"8", " ", 
       RowBox[{"Pi", " ", "/", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"h", " ", "^", " ", "2"}]}], ")"}]}]}], "]"}]}], "}"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"h", ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", " ", "0.3", ",", " ", "0.2"}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"536b261f-26f1-4fe5-ae80-cd319dc4b4bd"],

