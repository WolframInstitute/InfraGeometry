Cell["\<\
A surface given by an equation is passed discretized: the surface of a \
prolate ellipsoid. Most centres have six neighbours, at the waist and at the \
tips alike.\
\>", "ExampleText",ExpressionUUID->"def71dcf-9482-4c58-bc74-90e5994ac60e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"UniformLengthGraph", "[", 
        RowBox[{
         RowBox[{"RegionBoundary", " ", "@", " ", 
          RowBox[{"BoundaryDiscretizeRegion", " ", "@", " ", 
           RowBox[{"Ellipsoid", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"5", ",", " ", "1", ",", " ", "1"}], "}"}]}], "]"}]}]}],
          ",", " ", "0.44", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"g", ",", " ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"Counts", "[", 
        RowBox[{"VertexDegree", "[", "g", "]"}], "]"}]}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"249cd78a-459c-421c-8699-fce1abd3dd29"],

