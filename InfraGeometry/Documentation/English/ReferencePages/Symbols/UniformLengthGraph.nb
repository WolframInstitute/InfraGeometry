Cell[TextData[{
 "A disk, a sphere and a ball at ",
 StyleBox["h", "TI"],
 " = 0.25, labelled with the shortest and the longest edge over ",
 StyleBox["h", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"9b4e7f44-b543-47aa-a5f8-11ae5d5848f4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"UniformLengthGraph", "[", 
           RowBox[{"region", ",", " ", "0.25", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"Graph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"Round", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"MinMax", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"EuclideanDistance", " ", "@@", " ", 
                RowBox[{
                 RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
               "&"}], " ", "/@", " ", 
              RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}], "/", "0.25"}], ",",
            " ", "0.01"}], "]"}]}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"region", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Disk", "[", "]"}], ",", " ", 
        RowBox[{"Sphere", "[", "]"}], ",", " ", 
        RowBox[{"Ball", "[", "]"}]}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9f8fb835-256c-45f3-abde-45841989f6b4"],

