Cell["\<\
Spheres of diameter 0.25 packed in a disk, on a sphere and in a ball, and the \
shortest and the longest edge over 0.25.\
\>", "ExampleText",ExpressionUUID->"9ec7d1de-bab8-45d9-a3e6-e61886655325"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"packings", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"UniformLengthGraph", "[", 
         RowBox[{"region", ",", " ", "0.25", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"region", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Disk", "[", "]"}], ",", " ", 
           RowBox[{"Sphere", "[", "]"}], ",", " ", 
           RowBox[{"Ball", "[", "]"}]}], "}"}]}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", "packings", "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"MinMax", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"EuclideanDistance", " ", "@@", " ", 
            RowBox[{
             RowBox[{"GraphEmbedding", "[", "packing", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
           "&"}], " ", "/@", " ", 
          RowBox[{"EdgeList", "[", "packing", "]"}]}], "]"}], " ", "/", " ", 
        "0.25"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"packing", ",", " ", "packings"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1ca02392-2ef7-4400-92de-4c8973a8a31e"],

