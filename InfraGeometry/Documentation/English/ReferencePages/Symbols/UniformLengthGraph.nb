Cell["\<\
A surface given by an equation is passed discretized: the surface of a \
prolate ellipsoid. Most centres have six neighbours, at the waist and at the \
tips alike.\
\>", "ExampleText",ExpressionUUID->"3631e995-ceed-43d2-8a66-ed661ff44518"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"UniformLengthGraph", "[", 
        RowBox[{
         RowBox[{"RegionBoundary", " ", "@", " ", 
          RowBox[{"BoundaryDiscretizeRegion", " ", "@", " ", 
           RowBox[{"Ellipsoid", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"5", ",", " ", "1", ",", " ", "1"}], "}"}]}], "]"}]}]}],
          ",", " ", "0.44", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"g", ",", " ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"Counts", "[", 
        RowBox[{"VertexDegree", "[", "g", "]"}], "]"}]}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4ad849f4-732d-456f-8388-2d09819a5c25"],

