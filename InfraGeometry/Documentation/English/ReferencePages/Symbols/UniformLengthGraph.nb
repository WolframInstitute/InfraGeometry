Cell[CellGroupData[{

Cell["ContactTolerance", "ExampleSubsection",ExpressionUUID->"8a9fb1d5-f9ec-4fcc-bc96-9dea1a159608"],

Cell["\<\
A wider band joins more centres: the tolerance 0.1, 0.25 and 0.4 on the disk, \
and the number of edges.\
\>", "ExampleText",ExpressionUUID->"b7484ec9-b7e6-4279-8926-6e17ed4f463b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"packings", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"UniformLengthGraph", "[", 
         RowBox[{
          RowBox[{"Disk", "[", "]"}], ",", " ", "0.15", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}], ",", 
          " ", 
          RowBox[{"\"\<ContactTolerance\>\"", " ", "->", " ", "tolerance"}]}],
          "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"tolerance", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0.1", ",", " ", "0.25", ",", " ", "0.4"}], "}"}]}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", "packings", "]"}], ",", " ", 
     RowBox[{"EdgeCount", " ", "/@", " ", "packings"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"026babd6-edce-4e56-b7f1-ea69813a62ce"],

