Cell[TextData[{
 "The graph distance times ",
 StyleBox["h", "TI"],
 " approximates the distance in the region: from the northernmost to the \
southernmost centre of the unit sphere, against \[Pi]:"
}], "ExampleText",ExpressionUUID->"8521b374-f138-46c9-bc59-65f7596e4996"],

