     "829ccf09-9e26-47f2-84b2-0d545ec6f890"], Cell[TextData[StyleBox[
    "C/h + 1", "TI"]], "TableText",ExpressionUUID->
     "570a2734-d644-4a81-9b3f-162b67dde28b"], Cell[
    "equal arclength; the graph is a path", "TableText",ExpressionUUID->
     "bc0b3004-8810-4b5f-9600-826d874eedc1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fe17a8e8-8b85-4c0d-b63a-ef62fad7c491"], Cell[
    "surface", "TableText",ExpressionUUID->
     "5cc55bcc-399f-48b1-84a1-a8ef9f998b6a"], Cell[TextData[{
     StyleBox["2C/(\[Sqrt]3 h\.b2)", "TI"],
     ", the hexagonal packing"
    }], "TableText",ExpressionUUID->"e3131ace-3eb2-4f6c-8b83-0c016b8a57e2"], 
    Cell["random start, relaxed", "TableText",ExpressionUUID->
     "0217a0d7-657b-4520-835b-e4f104f197d4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8944dc2d-8d6d-4811-8bcf-42fe4f22a2a4"], Cell[
