Cell[TextData[{
 "The number of vertices follows from ",
 StyleBox["h", "TI"],
 ": on the unit sphere it is 8\[Pi]/(\[Sqrt]3 ",
 StyleBox["h", "TI"],
 "\.b2), rounded."
}], "ExampleText",ExpressionUUID->"70e7f815-7682-4ff1-b5ef-53af6273701d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", ",", " ", 
     RowBox[{
      RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
      RowBox[{"VertexCount", " ", "@", " ", 
       RowBox[{"UniformLengthGraph", "[", 
        RowBox[{
         RowBox[{"Sphere", "[", "]"}], ",", " ", "h"}], "]"}]}]}], ",", " ", 
     RowBox[{"Round", "[", 
      RowBox[{"8", " ", 
       RowBox[{"Pi", " ", "/", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"h", " ", "^", " ", "2"}]}], ")"}]}]}], "]"}]}], "}"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"h", ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", " ", "0.3", ",", " ", "0.2"}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"70dbe93f-4f79-4f11-8abf-bb89660b9ddb"],

