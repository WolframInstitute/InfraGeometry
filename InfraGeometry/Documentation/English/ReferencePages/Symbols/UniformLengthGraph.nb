Cell[TextData[{
 "The number of vertices follows from ",
 StyleBox["h", "TI"],
 ": on the unit sphere it is 8\[Pi]/(\[Sqrt]3 ",
 StyleBox["h", "TI"],
 "\.b2), rounded."
}], "ExampleText",ExpressionUUID->"7f17060d-4224-4d57-86ab-31f7732de729"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", ",", " ", 
     RowBox[{
      RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
      RowBox[{"VertexCount", " ", "@", " ", 
       RowBox[{"UniformLengthGraph", "[", 
        RowBox[{
         RowBox[{"Sphere", "[", "]"}], ",", " ", "h"}], "]"}]}]}], ",", " ", 
     RowBox[{"Round", "[", 
      RowBox[{"8", " ", 
       RowBox[{"Pi", " ", "/", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"h", " ", "^", " ", "2"}]}], ")"}]}]}], "]"}]}], "}"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"h", ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", " ", "0.3", ",", " ", "0.2"}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"eb845324-b49c-4d7f-894c-7dc85c3906a0"],

