      RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}], ",",
     " ", 
    RowBox[{"{", 
     RowBox[{"curve", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Circle", "[", "]"}], ",", " ", 
