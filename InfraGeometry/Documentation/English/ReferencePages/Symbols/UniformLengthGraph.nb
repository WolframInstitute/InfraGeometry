}, Open  ]],

Cell[TextData[{
 "The graph distance times ",
 StyleBox["h", "TI"],
 " approximates the distance in the region: from the northernmost to the \
southernmost centre of the unit sphere, against \[Pi]."
}], "ExampleText",ExpressionUUID->"036a38d1-3f1d-49ce-a6b5-e97362b71501"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"UniformLengthGraph", "[", 
        RowBox[{
         RowBox[{"Sphere", "[", "]"}], ",", " ", "0.2", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"heights", " ", "=", " ", 
     RowBox[{
      RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
      RowBox[{"[", 
