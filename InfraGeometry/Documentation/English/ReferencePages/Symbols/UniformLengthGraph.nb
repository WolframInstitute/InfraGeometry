Cell[TextData[{
 "The unit sphere packed by spheres of diameter 0.5, 0.3 and 0.2, labelled \
with the number of centres, ",
 StyleBox["8\[Pi]/(\[Sqrt]3 h\.b2)", "TI"],
 " rounded:"
}], "ExampleText",ExpressionUUID->"5cdd829e-5c91-4642-86e1-4f6e6e1e90ce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"UniformLengthGraph", "[", 
           RowBox[{
            RowBox[{"Sphere", "[", "]"}], ",", " ", "h", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"Graph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"VertexCount", "[", "g", "]"}], ",", " ", 
           RowBox[{"Round", "[", 
            RowBox[{"8", " ", 
             RowBox[{"Pi", "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Sqrt", "[", "3", "]"}], " ", 
                RowBox[{"h", "^", "2"}]}], ")"}]}]}], "]"}]}], "}"}]}]}], 
       "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"h", ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.5", ",", " ", "0.3", ",", " ", "0.2"}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3e3905af-2083-43b5-a0cd-cc18fdeb81ca"],

