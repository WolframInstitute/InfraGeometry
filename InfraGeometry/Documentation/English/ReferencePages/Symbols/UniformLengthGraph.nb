Cell["\<\
On a curve the relaxation does not finish: some neighbours stay apart, and \
the contact graph of 150 spheres on a circle falls apart into paths.\
\>", "ExampleText",ExpressionUUID->"0d9f9bb2-3c63-457d-bf53-5388159304e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"UniformLengthGraph", "[", 
        RowBox[{
         RowBox[{"Circle", "[", "]"}], ",", " ", "150", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"g", ",", " ", 
     RowBox[{"ConnectedGraphQ", "[", "g", "]"}], ",", " ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"Counts", "[", 
        RowBox[{"VertexDegree", "[", "g", "]"}], "]"}]}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"a0f50068-9045-438f-8bf1-18de9fa5c369"],

