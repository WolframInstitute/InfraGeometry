Notebook[{

Cell[CellGroupData[{
Cell["UniformLengthGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b65d5ccd-6867-4bfd-a957-ec3365163a04"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["UniformLengthGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/UniformLengthGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["region", "TI"], ",", " ", 
    StyleBox["h", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d44bd4c8-c666-4600-8d22-fa23de5b66a6"],
 "\[LineSeparator]",
 "gives the contact graph of a packing of ",
 StyleBox["region", "TI"],
 " by spheres of diameter ",
 StyleBox["h", "TI"],
 ": two centres are joined when their distance is ",
 StyleBox["h", "TI"],
 " up to the contact tolerance.",
 "\n"
}], "Usage",ExpressionUUID->"155c932f-5b41-4f18-81ab-6e892f021e8f"],

Cell[TextData[{
 "The vertices are the centres ",
 StyleBox["x\:2081", "TI"],
 ", \[Ellipsis], ",
 StyleBox["x\:2099", "TI"],
 " in the region, and ",
 StyleBox["x\:1d62x\:2c7c", "TI"],
 " is an edge when ",
 StyleBox["|\:2016x\:1d62 \[Minus] x\:2c7c\:2016 \[Minus] h| \[LessEqual] t \
h", "TI"],
 ", with ",
 StyleBox["t", "TI"],
 " the contact tolerance. Every edge has a length between ",
 StyleBox["(1 \[Minus] t)h", "TI"],
 " and ",
 StyleBox["(1 + t)h", "TI"],
 ", so the graph distance times ",
 StyleBox["h", "TI"],
 " approximates the distance in the region."
}], "Notes",ExpressionUUID->"c6079ac2-805b-4e50-9241-4161e4eb0234"],

Cell[TextData[{
 "The region is taken by its ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RegionDimension"]], "paclet:ref/RegionDimension"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5e0a9fae-eb65-403d-8767-653370790225"],
 ": a curve, a surface or a solid. A surface given by an equation is passed \
as ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegionBoundary",
    BaseStyle->"Link"], " ", "@", " ", 
   RowBox[{
    ButtonBox["BoundaryDiscretizeRegion",
     BaseStyle->"Link"], "[", "\[Ellipsis]", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "706f6c65-b743-46db-a8d4-1ca77c52ee87"],
 "."
}], "Notes",ExpressionUUID->"c19ddea6-0da6-4915-98df-4fb83aa08c8d"],

Cell[TextData[{
 "The number of centres follows from ",
 StyleBox["h", "TI"],
 " and the measure ",
 StyleBox["C", "TI"],
 " of the region:"
}], "Notes",ExpressionUUID->"9be4e946-dcd9-42ef-9d34-2d54834af712"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e6659ed9-d67f-4549-b06a-9817e819462a"], Cell["Region", "TableText",
     FontWeight->Bold,ExpressionUUID->"2bd3f829-2d1d-48ba-a51f-1cded2770ad3"],
     Cell["Centres", "TableText",
     FontWeight->Bold,ExpressionUUID->"3ea96c42-f993-44e9-b178-b1f3529dd361"],
     Cell["Placement", "TableText",
     FontWeight->Bold,ExpressionUUID->"38649820-3334-4013-acb6-ef55af48e31f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "198e731d-1b89-4cdf-84b7-ed89e12c40a9"], Cell[
    "closed curve", "TableText",ExpressionUUID->
     "da5a7bb9-61e6-4a0d-9b1e-5baeb62b7702"], Cell[TextData[{
     StyleBox["C/h", "TI"],
     ", rounded"
    }], "TableText",ExpressionUUID->"a1d511d1-e754-4b42-bf37-b6ce8369839c"], 
    Cell["equal arclength; the graph is a cycle", "TableText",ExpressionUUID->
     "dee73e81-88c5-4e49-a283-8f9a98d2fc77"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "296b74bb-07a5-439e-8900-1099c959cf07"], Cell[
    "open curve", "TableText",ExpressionUUID->
     "6c6e6b5f-2547-4d1b-bd5d-3d49575c18a6"], Cell[TextData[StyleBox[
    "C/h + 1", "TI"]], "TableText",ExpressionUUID->
     "1c9ad73c-888f-424e-9a6d-97d70279aa1b"], Cell[
    "equal arclength; the graph is a path", "TableText",ExpressionUUID->
     "3db8b4da-e6e7-49e6-afa9-ab6860802b4d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "76c05ff5-276c-4284-9d08-e3c1064fe6a6"], Cell[
    "surface", "TableText",ExpressionUUID->
     "584d9a08-83cb-4234-b4e1-974da6588def"], Cell[TextData[{
     StyleBox["2C/(\[Sqrt]3 h\.b2)", "TI"],
     ", the hexagonal packing"
    }], "TableText",ExpressionUUID->"b0e0efc7-cec4-4ef4-abe5-45cf94707175"], 
    Cell["random start, relaxed", "TableText",ExpressionUUID->
     "3476586e-395f-4c5b-9695-6c852032bc19"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "91f20541-e4a1-4d96-9e20-f822e2bcb9f3"], Cell[
    "solid", "TableText",ExpressionUUID->
     "806196ff-451a-461d-8068-bb5b4bcfb8f9"], Cell[TextData[StyleBox[
    "C(1.12/h)\.b3", "TI"]], "TableText",ExpressionUUID->
     "7fbb722d-7124-4caf-a44c-a121e5b4b9fd"], Cell[
    "random start, relaxed", "TableText",ExpressionUUID->
     "ae207a28-6130-450a-92e5-863b2fc34972"]}
  }]], "3ColumnTableMod",ExpressionUUID->"f2bc60bb-1d9e-4b0a-8285-\
236e7f3f4f3b"],

Cell[TextData[{
 "The relaxation pushes every pair closer than ",
 StyleBox["h", "TI"],
 " apart to ",
 StyleBox["h", "TI"],
 " and moves each centre to the nearest point of the region, until no centre \
moves more than ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Tolerance"]], "paclet:ref/Tolerance"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9facf5e1-c628-45e5-9e63-b7462f1a54ca"],
 " or for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaxIterations"]], "paclet:ref/MaxIterations"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7d010506-6adc-412e-9083-76cb61b442dc"],
 " steps. The random start uses the current random state, so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "97a3197d-b19f-4951-a066-515c740dc9d3"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BlockRandom"]], "paclet:ref/BlockRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2ad68282-9a2f-4e83-9f66-9be446e962c9"],
 " fixes the graph."
}], "Notes",ExpressionUUID->"1589f81a-3cda-4dc2-aa65-1032e72015e8"],

