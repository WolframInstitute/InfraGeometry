Cell["\<\
The surface of a torus. Most centres have six neighbours, on the inner side \
of the ring as on the outer side:\
\>", "ExampleText",ExpressionUUID->"4721566d-f38e-4041-9a23-91053a036865"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"BlockRandom", "[", 
      RowBox[{
       RowBox[{"UniformLengthGraph", "[", 
        RowBox[{
         RowBox[{"DiscretizeRegion", " ", "@", " ", 
          RowBox[{"Torus", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}]}], ",", " ", "0.44",
          ",", "\n", "      ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}],
        ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Graph", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"Counts", "[", 
        RowBox[{"VertexDegree", "[", "g", "]"}], "]"}]}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cf37a130-e94c-433c-b6c1-2635d737fc12"],

