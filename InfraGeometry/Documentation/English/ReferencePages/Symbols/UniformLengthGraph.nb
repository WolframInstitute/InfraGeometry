Cell[CellGroupData[{

Cell["ContactTolerance", "ExampleSubsection",ExpressionUUID->"068e524c-6949-45d8-b7bb-f67234f94790"],

Cell["\<\
A wider band joins more centres: the tolerance 0.1, 0.25 and 0.4 on the disk, \
and the number of edges.\
\>", "ExampleText",ExpressionUUID->"e2bc04b4-ae8d-4042-9e9a-df9d6429fbad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"packings", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"UniformLengthGraph", "[", 
         RowBox[{
          RowBox[{"Disk", "[", "]"}], ",", " ", "150", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}], ",", 
          " ", 
          RowBox[{"\"\<ContactTolerance\>\"", " ", "->", " ", "tolerance"}]}],
          "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"tolerance", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0.1", ",", " ", "0.25", ",", " ", "0.4"}], "}"}]}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", "packings", "]"}], ",", " ", 
     RowBox[{"EdgeCount", " ", "/@", " ", "packings"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f547633f-6566-49af-a229-f28446028e78"],

