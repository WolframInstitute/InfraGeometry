Cell[BoxData[
 InterpretationBox[Cell[
  "Possible Issues", "ExampleSection",ExpressionUUID->
   "dda06a82-eb41-4b48-8510-6cb821647761"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell[TextData[{
 "The edges have length 2",
 StyleBox["r", "TI"],
 " only up to the contact tolerance, and the relaxation leaves small \
overlaps. On the disk of 150 spheres 2",
 StyleBox["r", "TI"],
 " is about 0.156; the edge lengths:"
}], "ExampleText",ExpressionUUID->"4ce030c2-9d67-41eb-a49d-a388dfa15bd1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"UniformLengthGraph", "[", 
        RowBox[{
         RowBox[{"Disk", "[", "]"}], ",", " ", "150", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Histogram", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"EuclideanDistance", " ", "@@", " ", 
        RowBox[{
         RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", "&"}], 
      " ", "/@", " ", 
      RowBox[{"EdgeList", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<length\>\"", ",", " ", "\"\<edges\>\""}], "}"}]}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5e847e7a-0841-4e52-af41-47ff8e41c91e"],

