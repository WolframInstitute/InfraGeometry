Cell[TextData[{
 "Fewer steps leave the spheres overlapping: the closest pair of centres over \
",
 StyleBox["h", "TI"],
 " after 1, 10 and 200 steps on the disk."
}], "ExampleText",ExpressionUUID->"9e10bca3-66a8-4bcc-9998-bc83b93ddd4e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"UniformLengthGraph", "[", 
          RowBox[{
           RowBox[{"Disk", "[", "]"}], ",", " ", "0.15", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}], ",", 
           " ", 
           RowBox[{"MaxIterations", " ", "->", " ", "steps"}]}], "]"}]}], 
        ")"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"Min", "[", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"Flatten", " ", "@", " ", 
          RowBox[{"DistanceMatrix", " ", "@", " ", 
           RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], ",", " ", "0."}], 
        "]"}], "]"}], " ", "/", " ", "0.15"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"steps", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "10", ",", " ", "200"}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a5e1bdc6-94d7-4599-8649-735160c1f906"],

