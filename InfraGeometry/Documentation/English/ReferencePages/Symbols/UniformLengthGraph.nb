Cell[CellGroupData[{

Cell["MaxIterations", "ExampleSubsection",ExpressionUUID->"f534790b-41db-423d-90eb-a04ede654f84"],

Cell[TextData[{
 "Fewer steps leave the spheres overlapping: the closest pair of centres over \
",
 StyleBox["h", "TI"],
 " after 1, 10 and 200 steps on the disk."
}], "ExampleText",ExpressionUUID->"bbdf48b8-6480-4b56-b1ee-b4681b4463b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"UniformLengthGraph", "[", 
          RowBox[{
           RowBox[{"Disk", "[", "]"}], ",", " ", "0.15", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}], ",", 
           " ", 
           RowBox[{"MaxIterations", " ", "->", " ", "steps"}]}], "]"}]}], 
        ")"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"Min", "[", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"Flatten", " ", "@", " ", 
          RowBox[{"DistanceMatrix", " ", "@", " ", 
           RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], ",", " ", "0."}], 
        "]"}], "]"}], " ", "/", " ", "0.15"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"steps", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "10", ",", " ", "200"}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a46529c2-986e-4cc7-a656-61280dd10cc1"],

