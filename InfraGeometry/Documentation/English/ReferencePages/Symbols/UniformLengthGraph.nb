Cell["\<\
A surface: 200 spheres on an ellipsoid. Most centres have six neighbours.\
\>", "ExampleText",ExpressionUUID->"f42c3d7a-cf93-46a4-b7f5-8e2ce80bae82"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"UniformLengthGraph", "[", 
      RowBox[{
       RowBox[{"RegionBoundary", "[", 
        RowBox[{"Ellipsoid", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "1", ",", " ", "1"}], "}"}]}], "]"}], "]"}],
        ",", " ", "200", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"g", ",", " ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"Counts", "[", 
