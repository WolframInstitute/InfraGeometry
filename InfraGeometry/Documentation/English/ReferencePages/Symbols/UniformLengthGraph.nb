Cell["\<\
150 spheres packed in a disk, on a sphere and in a ball, and the shortest and \
the longest edge of each.\
\>", "ExampleText",ExpressionUUID->"2d1600f8-5b31-430e-b6ef-1f189a753bc9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"packings", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"UniformLengthGraph", "[", 
         RowBox[{"region", ",", " ", "150", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"region", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Disk", "[", "]"}], ",", " ", 
           RowBox[{"Sphere", "[", "]"}], ",", " ", 
           RowBox[{"Ball", "[", "]"}]}], "}"}]}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", "packings", "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"MinMax", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"EuclideanDistance", " ", "@@", " ", 
           RowBox[{
            RowBox[{"GraphEmbedding", "[", "packing", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
          "&"}], " ", "/@", " ", 
         RowBox[{"EdgeList", "[", "packing", "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"packing", ",", " ", "packings"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2c60b0a8-ce38-4a62-a41c-283fec924eb1"],

