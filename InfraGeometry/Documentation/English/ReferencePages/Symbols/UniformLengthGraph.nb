Cell[TextData[{
 "The graph distance times ",
 StyleBox["h", "TI"],
 " approximates the distance in the region: from the northernmost to the \
southernmost centre of the unit sphere, against \[Pi]:"
}], "ExampleText",ExpressionUUID->"de3461b6-75de-437d-b706-e768b382b0fb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"BlockRandom", "[", 
      RowBox[{
       RowBox[{"UniformLengthGraph", "[", 
        RowBox[{
         RowBox[{"Sphere", "[", "]"}], ",", " ", "0.2", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}],
        ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"z", " ", "=", " ", 
     RowBox[{
      RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "3"}], "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"0.2", " ", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"Ordering", "[", 
          RowBox[{"z", ",", " ", 
           RowBox[{"-", "1"}]}], "]"}]}], ",", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"Ordering", "[", 
          RowBox[{"z", ",", " ", "1"}], "]"}]}]}], "]"}]}], ",", " ", 
     RowBox[{"N", "[", "Pi", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9edec016-a9fb-4f5e-a17b-6565025d19df"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3.`", ",", "3.141592653589793`"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"50be8318-c90e-4a80-87a1-9aeaa409ba65"]
