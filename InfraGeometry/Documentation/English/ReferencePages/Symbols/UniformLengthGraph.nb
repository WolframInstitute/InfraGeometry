Cell[CellGroupData[{

Cell["InitialPoints", "ExampleSubsection",ExpressionUUID->"713db4e5-ae9b-495e-87e2-4e85b5e0ee5e"],

Cell["\<\
Four, six and twelve random points on a sphere, relaxed at the edge length of \
the tetrahedron, the octahedron and the icosahedron inscribed in it, touch as \
these solids.\
\>", "ExampleText",ExpressionUUID->"1e6be263-ca59-4d9f-9da4-3d3e107a26af"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lengths", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"8", " ", "/", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"Sqrt", "[", "2", "]"}], ",", " ", 
       RowBox[{"4", " ", "/", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"10", " ", "+", " ", 
