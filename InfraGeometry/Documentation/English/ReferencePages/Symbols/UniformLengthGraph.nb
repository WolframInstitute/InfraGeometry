Cell["\<\
Four, six and twelve random points on a sphere, relaxed at the edge length of \
the tetrahedron, the octahedron and the icosahedron inscribed in it, touch as \
these solids.\
\>", "ExampleText",ExpressionUUID->"390eb23d-9f54-4930-9fe4-03208fa5be3f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lengths", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"8", " ", "/", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"Sqrt", "[", "2", "]"}], ",", " ", 
       RowBox[{"4", " ", "/", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"10", " ", "+", " ", 
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", "5", "]"}]}]}], "]"}]}]}], "}"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"packings", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"UniformLengthGraph", "[", 
           RowBox[{
            RowBox[{"Sphere", "[", "]"}], ",", " ", "#1", ",", " ", 
            RowBox[{"\"\<InitialPoints\>\"", " ", "->", " ", 
             RowBox[{"RandomPoint", "[", 
              RowBox[{
               RowBox[{"Sphere", "[", "]"}], ",", " ", "#2"}], "]"}]}], ",", 
            " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}], " ", "&"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"lengths", ",", " ", 
           RowBox[{"{", 
            RowBox[{"4", ",", " ", "6", ",", " ", "12"}], "}"}]}], "}"}]}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", "packings", "]"}], ",", " ", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"IsomorphicGraphQ", "[", 
         RowBox[{"#1", ",", " ", 
          RowBox[{"TessellationGraph", "[", 
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "#2"}], "}"}], "]"}]}], "]"}], " ", "&"}], 
       ",", " ", 
       RowBox[{"{", 
        RowBox[{"packings", ",", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}]}], "}"}]}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"99fb9e64-4798-4796-ba27-8d5deadf8d00"],

