Cell["\<\
A wider band joins more centres. The disk at the tolerances 0.1, 0.25 and \
0.4, labelled with the number of edges:\
\>", "ExampleText",ExpressionUUID->"fa7d6ddf-56d4-4b17-8470-c970ebe18ea1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"UniformLengthGraph", "[", 
           RowBox[{
            RowBox[{"Disk", "[", "]"}], ",", " ", "0.15", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}], ",", 
            " ", 
            RowBox[{"\"\<ContactTolerance\>\"", " ", "->", " ", "t"}]}], 
           "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"Graph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"EdgeCount", "[", "g", "]"}]}]}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"t", ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.1", ",", " ", "0.25", ",", " ", "0.4"}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d2cb58e3-4da6-45f3-a198-a05360228527"],

