Cell[TextData[{
 "The graph distance times ",
 StyleBox["h", "TI"],
 " approximates the distance in the region: from the northernmost to the \
southernmost centre of the unit sphere, against \[Pi]."
}], "ExampleText",ExpressionUUID->"85fe0aae-4798-4035-ae1b-11772fac9d2b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"UniformLengthGraph", "[", 
