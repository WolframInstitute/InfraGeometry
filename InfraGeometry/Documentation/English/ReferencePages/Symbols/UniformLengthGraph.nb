Cell["A curve in space: a helix gives a path.", "ExampleText",ExpressionUUID->"71cb98ba-d100-4151-8799-ed171c061478"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"UniformLengthGraph", "[", 
      RowBox[{
       RowBox[{"ParametricRegion", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "t", "]"}], ",", " ", 
           RowBox[{"Sin", "[", "t", "]"}], ",", " ", 
           RowBox[{"t", " ", "/", " ", "5"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "0", ",", " ", 
            RowBox[{"4", " ", "Pi"}]}], "}"}], "}"}]}], "]"}], ",", " ", 
       "0.3", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"g", ",", " ", 
     RowBox[{"PathGraphQ", "[", "g", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"471720f7-abfc-419e-aa75-dd2eefc26383"],

