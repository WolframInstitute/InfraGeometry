Cell[TextData[{
 "A disk, a sphere and a ball at ",
 StyleBox["h", "TI"],
 " = 0.25, labelled with the shortest and the longest edge over ",
 StyleBox["h", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"cbb0c2e0-1b36-45be-8e64-b7f09fd2a37b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"UniformLengthGraph", "[", 
           RowBox[{"region", ",", " ", "0.25", ",", " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"Graph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"Round", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"MinMax", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"EuclideanDistance", " ", "@@", " ", 
                RowBox[{
                 RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
               "&"}], " ", "/@", " ", 
              RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}], "/", "0.25"}], ",",
            " ", "0.01"}], "]"}]}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"region", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Disk", "[", "]"}], ",", " ", 
        RowBox[{"Sphere", "[", "]"}], ",", " ", 
        RowBox[{"Ball", "[", "]"}]}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2ee85b10-6490-4ac5-9f66-5cb3358afe32"],

