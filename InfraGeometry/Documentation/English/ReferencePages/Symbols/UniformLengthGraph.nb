Cell["\<\
On a curve the centres lie at equal arclength: a circle gives a cycle and a \
zigzag a path, with edges of one length close to 0.2.\
\>", "ExampleText",ExpressionUUID->"5d5d60bf-93b3-4bd3-b8a8-59071989dab2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graphs", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"UniformLengthGraph", "[", 
        RowBox[{"curve", ",", " ", "0.2", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}],
        ",", " ", 
       RowBox[{"{", 
        RowBox[{"curve", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Circle", "[", "]"}], ",", " ", 
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"2", ",", " ", "0"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"3", ",", " ", "1"}], "}"}]}], "}"}], "]"}]}], "}"}]}],
         "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", "graphs", "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"MinMax", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"EuclideanDistance", " ", "@@", " ", 
           RowBox[{
            RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
          "&"}], " ", "/@", " ", 
         RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"g", ",", " ", "graphs"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"daf32110-fc03-42f7-8e0b-5fdc18603932"],

