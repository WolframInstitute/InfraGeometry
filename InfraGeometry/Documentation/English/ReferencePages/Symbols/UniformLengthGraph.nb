Cell[CellGroupData[{

Cell["InitialPoints", "ExampleSubsection",ExpressionUUID->"91302952-a793-49aa-b175-ca292e46240d"],

Cell["\<\
Four, six and twelve points on the sphere, relaxed at the edge lengths of the \
inscribed tetrahedron, octahedron and icosahedron, touch as these solids:\
\>", "ExampleText",ExpressionUUID->"843145b8-b735-46f0-9749-b22821ea3222"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lengths", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"8", "/", "3"}], "]"}], ",", " ", 
       RowBox[{"Sqrt", "[", "2", "]"}], ",", " ", 
       RowBox[{"4", "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"10", " ", "+", " ", 
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", "5", "]"}]}]}], "]"}]}]}], "}"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"packings", " ", "=", " ", 
     RowBox[{"BlockRandom", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"UniformLengthGraph", "[", 
           RowBox[{
            RowBox[{"Sphere", "[", "]"}], ",", " ", "#1", ",", " ", 
            RowBox[{"\"\<InitialPoints\>\"", " ", "->", " ", 
             RowBox[{"RandomPoint", "[", 
              RowBox[{
               RowBox[{"Sphere", "[", "]"}], ",", " ", "#2"}], "]"}]}], ",", 
            " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}], " ", "&"}], ",", "\n", "      ", 
         RowBox[{"{", 
          RowBox[{"lengths", ",", " ", 
           RowBox[{"{", 
            RowBox[{"4", ",", " ", "6", ",", " ", "12"}], "}"}]}], "}"}]}], 
        "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Graph", "[", 
        RowBox[{"#1", ",", " ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"IsomorphicGraphQ", "[", 
           RowBox[{"#1", ",", " ", 
            RowBox[{"TessellationGraph", "[", 
             RowBox[{"{", 
              RowBox[{"3", ",", " ", "#2"}], "}"}], "]"}]}], "]"}]}]}], "]"}],
        " ", "&"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"packings", ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}]}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"74f3c3a2-1b59-4ff7-a97d-9a5f44828337"],

Cell[BoxData[
 GraphicsBox[{{}, {InsetBox[
     FormBox[
      Graphics3DBox[
       NamespaceBox["NetworkGraphics",
        DynamicModuleBox[{Typeset`graph = HoldComplete[
          
          Graph[{1, 2, 3, 4}, {
           Null, {{1, 2}, {1, 3}, {1, 4}, {2, 3}, {2, 4}, {3, 4}}}, {
           GraphLayout -> {"Dimension" -> 2}, PlotLabel -> True, 
            VertexCoordinates -> {{0.8549398421865363, -0.4496842266833042, 
