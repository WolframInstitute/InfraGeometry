Notebook[{

Cell[CellGroupData[{
Cell["UniformLengthGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d9a028db-d100-4d36-b7f5-e6d63d5cea47"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["UniformLengthGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/UniformLengthGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["region", "TI"], ",", " ", 
    StyleBox["h", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a32cadf-d8f9-4df1-a2e5-e4c93c3760d3"],
 "\[LineSeparator]",
 "gives the contact graph of a packing of ",
 StyleBox["region", "TI"],
 " by spheres of diameter ",
 StyleBox["h", "TI"],
 ": two centres are joined when their distance is ",
 StyleBox["h", "TI"],
 " up to the contact tolerance.",
 "\n"
}], "Usage",ExpressionUUID->"1f52def6-e0d8-4e15-a76d-5616ae4a1b3f"],

Cell[TextData[{
 "The region is taken as given, by its ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RegionDimension"]], "paclet:ref/RegionDimension"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "efe4a8fd-3e06-44fa-b7ae-4f0a4178c483"],
 ": a curve, a surface or a solid. A ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BoundaryMeshRegion"]], "paclet:ref/BoundaryMeshRegion"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "66ba5018-6b72-4c52-8227-f826b050aafa"],
 " is the solid it bounds; its surface is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RegionBoundary"]], "paclet:ref/RegionBoundary"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0bd27b43-99b6-45ac-9c73-ecc521e802c6"],
 " of it, as in ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegionBoundary",
    BaseStyle->"Link"], " ", "@", " ", 
   RowBox[{
    ButtonBox["BoundaryDiscretizeRegion",
     BaseStyle->"Link"], " ", "@", " ", 
    RowBox[{
     ButtonBox["Ellipsoid",
      BaseStyle->"Link"], "[", "\[Ellipsis]", "]"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce0571e0-8112-4a9f-909d-04829aed598a"],
 "."
}], "Notes",ExpressionUUID->"8d926403-cdd6-4b0a-b34b-82601f3a0fb5"],

Cell[TextData[{
 "The number of spheres follows from ",
 StyleBox["h", "TI"],
 " and the measure ",
 StyleBox["C", "TI"],
 " of the region: ",
 StyleBox["C", "TI"],
 "/",
 StyleBox["h", "TI"],
 " on a closed curve, ",
 StyleBox["C", "TI"],
 "/",
 StyleBox["h", "TI"],
 " + 1 on an open curve, 2",
 StyleBox["C", "TI"],
 "/(\[Sqrt]3 ",
 StyleBox["h", "TI"],
 "\.b2) on a surface, the count of a hexagonal packing, and ",
 StyleBox["C", "TI"],
 " (1.12/",
 StyleBox["h", "TI"],
 ")\.b3 in a solid, rounded, and at least 1."
}], "Notes",ExpressionUUID->"904b0537-5d3b-4e6e-99e5-4f6bb36e6921"],

Cell[TextData[{
 "On a curve the centres lie at equal arclength along a fine discretization \
of the curve, ",
 StyleBox["C", "TI"],
 "/",
 StyleBox["n", "TI"],
 " apart, the length nearest to ",
 StyleBox["h", "TI"],
 " that divides the curve evenly. A closed curve gives a cycle, an open curve \
a path."
}], "Notes",ExpressionUUID->"a5122243-345e-43f4-a218-88e22ebcaaa2"],

Cell[TextData[{
 "On a surface or in a solid the centres start at random points of the region \
and are relaxed: each pair closer than ",
 StyleBox["h", "TI"],
 " is pushed apart to ",
 StyleBox["h", "TI"],
 ", and every centre is moved to the nearest point of the region, until no \
centre moves farther than ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Tolerance"]], "paclet:ref/Tolerance"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "73af3190-98d5-46fc-a391-b2c26700f18e"],
 " or for at most ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MaxIterations"]], "paclet:ref/MaxIterations"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4f975893-c38a-4eee-ba6b-1dd18663988a"],
 " steps."
}], "Notes",ExpressionUUID->"0a14bb84-ef57-4243-ad51-6d42127dd0b3"],

Cell[TextData[{
 "Two centres are joined when their distance lies within ",
 Cell[BoxData["\"\<ContactTolerance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b1686bb-e8e8-4f8e-9041-556d7640abd7"],
 " \[Times] ",
 StyleBox["h", "TI"],
 " of ",
 StyleBox["h", "TI"],
 ". Every edge has a length between (1 \[Minus] ",
 StyleBox["t", "TI"],
 ") ",
 StyleBox["h", "TI"],
 " and (1 + ",
 StyleBox["t", "TI"],
 ") ",
 StyleBox["h", "TI"],
 ", ",
 StyleBox["t", "TI"],
 " the tolerance."
}], "Notes",ExpressionUUID->"cc62b1e0-ab74-4fac-bf6e-d77b35074603"],

Cell[TextData[{
 "The vertices are 1, \[Ellipsis], ",
 StyleBox["n", "TI"],
 ". The centres are dropped and the graph is laid out by springs, unless ",
 Cell[BoxData["\"\<KeepCoordinates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fa7ac8e-f301-48b9-bfec-5ac0af81e015"],
 " -> ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "04bb2d43-66c0-4308-ab7c-0868eb5b26cf"],
 " keeps them as the vertex coordinates."
}], "Notes",ExpressionUUID->"a8901309-07ea-47b2-b1c8-90735aea3bc2"],

Cell[TextData[{
 "The start is drawn with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomPoint"]], "paclet:ref/RandomPoint"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1f279c53-a327-4f52-8c48-3db93c24846d"],
 ", so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "90cd931b-304a-4392-a982-e8958b79f0fb"],
 " fixes the graph. ",
 Cell[BoxData["\"\<InitialPoints\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7132a84f-8544-46c9-a0f4-ff77b3e444a6"],
 " gives the start instead, and then the number of spheres is the number of \
points. A curve has no random start."
}], "Notes",ExpressionUUID->"70fe6c98-e18a-45e8-92dc-3c830ee62781"],

