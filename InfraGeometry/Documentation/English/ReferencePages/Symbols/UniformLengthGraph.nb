Cell[CellGroupData[{

Cell["InitialPoints", "ExampleSubsection",ExpressionUUID->"68d573c1-a61f-4693-b6a4-cefa21a15f9b"],

Cell["\<\
Four, six and twelve random points on a sphere, relaxed at the edge length of \
the tetrahedron, the octahedron and the icosahedron inscribed in it, touch as \
these solids.\
\>", "ExampleText",ExpressionUUID->"83512dea-5f12-4c4d-9213-fdf06bd7b287"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lengths", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"8", " ", "/", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"Sqrt", "[", "2", "]"}], ",", " ", 
       RowBox[{"4", " ", "/", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"10", " ", "+", " ", 
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", "5", "]"}]}]}], "]"}]}]}], "}"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"packings", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"UniformLengthGraph", "[", 
           RowBox[{
            RowBox[{"Sphere", "[", "]"}], ",", " ", "#1", ",", " ", 
            RowBox[{"\"\<InitialPoints\>\"", " ", "->", " ", 
             RowBox[{"RandomPoint", "[", 
              RowBox[{
               RowBox[{"Sphere", "[", "]"}], ",", " ", "#2"}], "]"}]}], ",", 
            " ", 
            RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
           "]"}], " ", "&"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"lengths", ",", " ", 
           RowBox[{"{", 
            RowBox[{"4", ",", " ", "6", ",", " ", "12"}], "}"}]}], "}"}]}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", "packings", "]"}], ",", " ", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"IsomorphicGraphQ", "[", 
         RowBox[{"#1", ",", " ", 
          RowBox[{"TessellationGraph", "[", 
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "#2"}], "}"}], "]"}]}], "]"}], " ", "&"}], 
       ",", " ", 
       RowBox[{"{", 
        RowBox[{"packings", ",", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}]}], "}"}]}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"12b3b833-9b6e-4680-8935-5a0381079479"],

