Cell["\<\
A shortest path between other points is a segment, but not a member of this \
one.\
\>", "ExampleText",ExpressionUUID->"1f7c33b4-6681-465e-87bc-0dcb571717a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"a", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"other", " ", "=", " ", 
     RowBox[{"RandomInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"a", ",", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"AdjacencyList", "[", 
           RowBox[{"g", ",", " ", "a"}], "]"}]}]}], "]"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraSegment", "[", 
          RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
         RowBox[{"InfraWalk", "[", "other", "]"}]}], "}"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"InfraSegmentQ", "[", 
      RowBox[{"g", ",", " ", "other"}], "]"}], ",", " ", 
     RowBox[{"InfraMemberQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "other"}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4fcc2937-42c1-4765-8c86-819664a6b479"],

