Cell["\<\
A circle's member is recognised up to rotation and direction.\
\>", "ExampleText",ExpressionUUID->"1a27c488-5c3d-49f1-862d-32c23ebac702"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"InfraCircle", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"turned", " ", "=", " ", 
     RowBox[{"RotateLeft", "[", 
      RowBox[{
       RowBox[{"Reverse", " ", "@", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", "circle"}], "]"}]}], ",", " ", "3"}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"InfraWalk", "[", 
           RowBox[{"Append", "[", 
            RowBox[{"turned", ",", " ", 
             RowBox[{"First", " ", "@", " ", "turned"}]}], "]"}], "]"}], " ", 
          "->", " ", "$InfraCircleColor"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c"}],
         "}"}], ",", " ", 
       RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"InfraMemberQ", "[", 
      RowBox[{"g", ",", " ", "circle", ",", " ", "turned"}], "]"}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"9611a5ff-e3c1-4937-968a-07f952cdf193"],

