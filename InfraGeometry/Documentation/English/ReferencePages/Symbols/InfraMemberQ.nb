Cell["A half-line and a line drawn by their samplers are members:", \
"ExampleText",ExpressionUUID->"183c62dc-83d5-458b-bb8e-763f93cf008c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMemberQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraHalfLine", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
       RowBox[{"RandomInfraHalfLine", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"InfraMemberQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraInfiniteLine", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
       RowBox[{"RandomInfraInfiniteLine", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1b63ee86-8cb0-4667-bd0b-33c95c11752b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"7d63b65a-f122-4bb0-ac89-10d748f7283d"]
}, Open  ]],

Cell["\<\
A region has one member, its vertex set in any order. The tube of radius 1 \
about a vertex is the vertex and its neighbours:\
\>", "ExampleText",ExpressionUUID->"c1be8b73-0a78-4cfe-950a-b8f9d3d61e80"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraMemberQ", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"InfraTube", "[", 
      RowBox[{"c", ",", " ", "1"}], "]"}], ",", " ", 
     RowBox[{"Reverse", " ", "@", " ", 
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", "c"}], "]"}], ",", " ", "c"}], "]"}]}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"3f166a66-14c1-49cf-8c60-d1a0f77a47b6"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"3de17f22-f840-4464-81b5-1aabed22ba7b"]
}, Open  ]],

Cell["\<\
The ball of radius 2, the tube of radius 2 about its centre and the band of \
radii 0 to 2 are one region:\
\>", "ExampleText",ExpressionUUID->"410aa867-7649-4075-9648-41f314c17048"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{"c", ",", " ", "2"}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"InfraMemberQ", "[", 
      RowBox[{"g", ",", " ", "#", ",", " ", "ball"}], "]"}], " ", "&"}], " ", 
    "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraBall", "[", 
       RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
      RowBox[{"InfraTube", "[", 
       RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
      RowBox[{"InfraShell", "[", 
       RowBox[{"c", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "2"}], "}"}]}], "]"}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"4fe26ecd-e425-476a-a4fe-3e726e4d884a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"d93c83be-32a9-4a7d-bf44-ced47cf70ab0"]
}, Open  ]],

Cell[TextData[{
 "A sphere in the band of radii 1 and 2 on the grid. A member drawn by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "62ddfb15-e74f-43a6-a3ac-bfc9019f9da1"],
 " passes; the whole band separates the centre too, but it is not minimal:"
}], "ExampleText",ExpressionUUID->"0c2ca604-7b20-4a04-b029-b0db589a26f1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sphere", " ", "=", " ", 
     RowBox[{"InfraSphere", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"{", 
