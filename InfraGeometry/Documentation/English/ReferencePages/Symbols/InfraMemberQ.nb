Cell["InfraMemberQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"115248fd-e7fb-40a5-b599-035dd6094847"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMemberQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", 
    StyleBox["path", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cde1edab-dfea-44d3-b4ea-c0a47353d70a"],
 "\[LineSeparator]",
 "tests whether the vertex list ",
 StyleBox["path", "TI"],
 " is a member of the Euclidean head ",
 StyleBox["obj", "TI"],
 " on ",
 StyleBox["graph", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"ee1217b2-0df0-480c-8556-d86b9b1bcbeb"],

Cell[TextData[{
 StyleBox["path", "TI"],
 " is a member exactly when it is a source-to-sink chain of ",
 StyleBox["obj", "TI"],
 "'s graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4603f3c7-bc87-4e8d-8ead-27a4eeb5bc4c"],
 " \[LongDash] for a circle, up to rotation and direction. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "26e5b72f-b3f4-45fa-818b-f097edf9fe34"],
 " agrees with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraVertexList", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b82e4a12-f783-4340-a7f4-722534188b87"],
 " by construction: every vertex list ",
 Cell[BoxData["InfraVertexList"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5d76b7f-ad4f-4162-99bd-a1595dc39dd7"],
 " returns passes ",
 Cell[BoxData["InfraMemberQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7fb5a68-db19-4b68-bc47-4c0c66ed3dbc"],
 ", and conversely."
}], "Notes",ExpressionUUID->"f7ed1e8e-cf0e-473a-89ce-cb3d68f384a9"],

Cell[TextData[{
 "Unlike ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegmentQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a0f4e306-f9d2-4021-ae0c-4ba3467f2ffc"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a3531ca0-4a56-4e5c-8cd7-27822085018d"],
 ", which test ",
 StyleBox["path", "TI"],
 " against the general definition of the class on ",
 StyleBox["graph", "TI"],
 ", ",
 Cell[BoxData["InfraMemberQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fbc93021-3f76-4e0c-8cd8-fa249130d683"],
 " tests it against one specific head \[LongDash] so it also distinguishes, \
say, one line through two points from another line through the same points on \
a graph where several exist."
}], "Notes",ExpressionUUID->"655a61cd-226f-4c6e-98d2-2b1f13d52b96"]
}, Open  ]],

