Cell[TextData[{
 "A ball and a shell have no membership test, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1cbdc73c-da4d-4770-b5e1-3d53353c1b82"],
 " stays unevaluated. The tube about the centre is the same region and has \
one:"
}], "ExampleText",ExpressionUUID->"826c99d4-092c-49da-ba26-1700db0e02c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{"c", ",", " ", "2"}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"BooleanQ", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraMemberQ", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", "ball"}], "]"}], ",", 
      " ", 
      RowBox[{"InfraMemberQ", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraTube", "[", 
         RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", "ball"}], "]"}]}], 
     "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"719b35d3-82b7-4905-8ce0-3c7aa6251f03"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"676a5d48-356b-4f8e-955d-388a87e98d7d"]
}, Open  ]]
