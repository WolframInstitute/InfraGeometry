      RowBox[{"{", 
       RowBox[{
       "41", ",", " ", "42", ",", " ", "43", ",", " ", "44", ",", " ", "53", ",",
         " ", "62", ",", " ", "61"}], "}"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraWalk", "[", "member", "]"}], ",", " ", 
         RowBox[{"InfraWalk", "[", "detour", "]"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "41", 
         ",", " ", "61"}], "}"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"InfraMemberQ", "[", 
      RowBox[{"g", ",", " ", "seg", ",", " ", "member"}], "]"}], ",", " ", 
     RowBox[{"InfraMemberQ", "[", 
      RowBox[{"g", ",", " ", "seg", ",", " ", "detour"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
