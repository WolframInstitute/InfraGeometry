Cell[TextData[{
 "A geodesic found independently by ",
 Cell[BoxData["FindInfraSegment"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "adc302d9-67b5-4661-a530-bfbd546fd0c3"],
 " is a member of the matching segment head; an arbitrary longer walk between \
the same endpoints is not."
}], "ExampleText",ExpressionUUID->"777ab43a-aad3-4c42-9d95-9548f24dc10c"],

