Cell["\<\
A circle in the band of radii 3 and 4, and the same circle reversed and \
rotated, are both members:\
\>", "ExampleText",ExpressionUUID->"f25c8f29-3fcb-43f9-b544-cec3bcaab794"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"RandomInfraCircle", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraWalk", "[", 
        RowBox[{"Append", "[", 
         RowBox[{"circle", ",", " ", 
          RowBox[{"First", " ", "@", " ", "circle"}]}], "]"}], "]"}], ",", 
       " ", "c"}], "}"}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraMemberQ", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraCircle", "[", 
            RowBox[{"c", ",", " ", 
             RowBox[{"{", 
              RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", "#"}], 
          "]"}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"{", 
         RowBox[{"circle", ",", " ", 
          RowBox[{"RotateLeft", "[", 
           RowBox[{
            RowBox[{"Reverse", " ", "@", " ", "circle"}], ",", " ", "3"}], 
           "]"}]}], "}"}]}], ")"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ca825e13-9671-433b-9e58-3330a102dd78"],

