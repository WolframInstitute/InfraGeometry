Cell["\<\
A circle in the band of radii 3 and 4, and the same circle reversed and \
rotated, are both members:\
\>", "ExampleText",ExpressionUUID->"bd8612b5-f7e5-42e9-87a5-e664711f4252"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"RandomInfraCircle", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraWalk", "[", 
        RowBox[{"Append", "[", 
         RowBox[{"circle", ",", " ", 
          RowBox[{"First", " ", "@", " ", "circle"}]}], "]"}], "]"}], ",", 
       " ", "c"}], "}"}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraMemberQ", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraCircle", "[", 
            RowBox[{"c", ",", " ", 
             RowBox[{"{", 
              RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", "#"}], 
          "]"}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"{", 
         RowBox[{"circle", ",", " ", 
          RowBox[{"RotateLeft", "[", 
           RowBox[{
            RowBox[{"Reverse", " ", "@", " ", "circle"}], ",", " ", "3"}], 
           "]"}]}], "}"}]}], ")"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c2249edb-383f-44ba-9e20-e0b2749dddf2"],

