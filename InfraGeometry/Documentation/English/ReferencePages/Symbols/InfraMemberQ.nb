Cell[CellGroupData[{
Cell["InfraMemberQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b7722154-4497-4052-9b75-31f9446810a3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMemberQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", 
    StyleBox["path", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a2454d8-d0b3-4fac-9758-333bb924f459"],
 "\[LineSeparator]",
 "tests whether the vertex list ",
 StyleBox["path", "TI"],
 " is a member of the Euclidean head ",
 StyleBox["obj", "TI"],
 " on ",
 StyleBox["graph", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"83bfbb15-6439-4547-a2c7-dbdb43603b8f"],

Cell[TextData[{
 StyleBox["path", "TI"],
 " is a member exactly when it is a source-to-sink chain of ",
 StyleBox["obj", "TI"],
 "'s graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "112c7d5b-8606-4cd7-a17d-2f8cc2bb1198"],
 " \[LongDash] for a circle, up to rotation and direction. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4bfbdb03-1a14-4709-8fa6-5dd0992f339d"],
 " agrees with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "197d30ca-713a-43e0-88c9-341f3342757e"],
 " on every head it reads off a graph: every vertex list it returns there \
passes ",
 Cell[BoxData["InfraMemberQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ded19778-bce0-4549-9066-0c3ab2e3f314"],
 ", and conversely. A circle's representative is found by the sweep instead, \
which can find a circle the necklaces miss."
}], "Notes",ExpressionUUID->"7e9e934d-7a13-474d-844d-5bf4f0e48807"],

Cell[TextData[{
 "Unlike ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegmentQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7931899c-505a-4f01-a09b-57d12e487c3e"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f8d98dfe-c683-4f5b-9310-5f9b49db61c1"],
 ", which test ",
 StyleBox["path", "TI"],
 " against the general definition of the class on ",
 StyleBox["graph", "TI"],
 ", ",
 Cell[BoxData["InfraMemberQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f778f68-946e-4d94-ace8-f79e98cdc0f6"],
 " tests it against one specific head \[LongDash] so it also distinguishes, \
say, one line through two points from another line through the same points on \
a graph where several exist."
}], "Notes",ExpressionUUID->"8eacfb5a-b096-4f4e-a53a-09c790a0002a"]
}, Open  ]],

