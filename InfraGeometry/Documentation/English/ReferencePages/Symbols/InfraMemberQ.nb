Cell["\<\
A circle's member is recognised up to rotation and direction.\
\>", "ExampleText",ExpressionUUID->"76f95881-13bd-4ce0-b026-34ba0238313f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"InfraCircle", "[", 
      RowBox[{"41", ",", " ", 
       RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "4"}], "}"}]}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"InfraMemberQ", "[", 
    RowBox[{"g", ",", " ", "circle", ",", " ", 
     RowBox[{"RotateLeft", "[", 
      RowBox[{
       RowBox[{"Reverse", " ", "@", " ", 
        RowBox[{"InfraVertexList", "[", 
         RowBox[{"g", ",", " ", "circle"}], "]"}]}], ",", " ", "3"}], "]"}]}],
     "]"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"b57a3b56-1a76-4a76-8df1-1073159d06c3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"9ceb69f7-13c6-4c82-acf4-9dd2b0809724"]
