Cell["\<\
A circle's member is recognised up to rotation and direction.\
\>", "ExampleText",ExpressionUUID->"2d1a3692-50e2-4171-8a67-f58aec349a70"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"InfraCircle", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"turned", " ", "=", " ", 
     RowBox[{"RotateLeft", "[", 
      RowBox[{
       RowBox[{"Reverse", " ", "@", " ", 
        RowBox[{"RandomInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", "circle"}], "]"}]}], ",", " ", "3"}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraWalk", "[", 
          RowBox[{"Append", "[", 
           RowBox[{"turned", ",", " ", 
            RowBox[{"First", " ", "@", " ", "turned"}]}], "]"}], "]"}], ",", 
         " ", "c"}], "}"}], ",", " ", 
       RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"InfraMemberQ", "[", 
      RowBox[{"g", ",", " ", "circle", ",", " ", "turned"}], "]"}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"a6d1ce7b-2c80-4b62-ba13-7149e3d14269"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   GraphicsBox[
