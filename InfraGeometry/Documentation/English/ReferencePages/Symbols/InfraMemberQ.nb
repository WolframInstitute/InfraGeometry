Cell["\<\
Two walks from the centre of a grid to a vertex two steps up and two across: \
a geodesic, which is a member of the segment, and a detour of length 6, which \
is not.\
\>", "ExampleText",ExpressionUUID->"9f91a453-6c97-4410-9c00-518749fb140c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"41", ",", " ", "61"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"member", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
       "41", ",", " ", "42", ",", " ", "51", ",", " ", "52", ",", " ", "61"}],
        "}"}]}], ",", " ", 
