Cell["\<\
A shortest path from the centre to a vertex at distance 4 is a member of the \
segment; a detour through a third vertex is not:\
\>", "ExampleText",ExpressionUUID->"1ac56c02-40fe-4add-beb3-cc4cd4597375"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"x", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "4"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"paths", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RandomInfraSegment", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       RowBox[{"RandomInfraSegment", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSegment", "[", 
          RowBox[{"a", ",", " ", "x", ",", " ", "b"}], "]"}], ",", " ", 
