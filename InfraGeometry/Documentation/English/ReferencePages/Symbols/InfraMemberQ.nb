      RowBox[{"InfraShell", "[", 
       RowBox[{"c", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "2"}], "}"}]}], "]"}]}], "}"}]}]}], 
  "]"}]], "Input",
