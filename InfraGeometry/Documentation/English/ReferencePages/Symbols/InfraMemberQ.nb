Cell[CellGroupData[{
Cell["InfraMemberQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cc0ecf3e-ee16-4933-88cf-47db21c569da"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMemberQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", 
    StyleBox["path", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5495e7e7-e03f-4f82-a372-8d0cf200838f"],
 "\[LineSeparator]",
 "tests whether the vertex list ",
 StyleBox["path", "TI"],
 " is a member of the Euclidean head ",
 StyleBox["obj", "TI"],
 " on ",
 StyleBox["graph", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"1348e8e2-c904-4191-9145-49eb9e26a0f7"],

Cell[TextData[{
 StyleBox["path", "TI"],
 " is a member exactly when it is a source-to-sink chain of ",
 StyleBox["obj", "TI"],
 "'s graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2214e529-f266-4d33-8d0f-aeba941d408f"],
 " \[LongDash] for a circle, up to rotation and direction. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c41bc3b1-1c10-448a-bde7-d60e78a4c4e7"],
 " agrees with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0c3d9f3e-8f2a-43ff-b654-50af5d5ec0fa"],
 " on every head it reads off a graph: every vertex list it returns there \
passes ",
 Cell[BoxData["InfraMemberQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d82c7e76-615c-4b5f-a605-4eb09fcb1e56"],
 ", and conversely. A circle's, and a closed arc's, representative is found \
by the sweep instead, which can find a circle the graph misses: where the cut \
band is disconnected, the graph is the necklaces, and a necklace needs the \
circle to meet the seam in one run. For a circle or a closed arc a member is \
a chain with the copy of the source dropped, read up to rotation and \
direction."
}], "Notes",ExpressionUUID->"97f7048b-d57a-411a-a395-8d822880314f"],

Cell[TextData[{
 "Unlike ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegmentQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "045aca42-ce36-440d-b74a-4472fedc585a"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e5c1fdbd-03fe-45e5-9c11-fd9f9a9ab472"],
 ", which test ",
 StyleBox["path", "TI"],
 " against the general definition of the class on ",
 StyleBox["graph", "TI"],
 ", ",
 Cell[BoxData["InfraMemberQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a73cebc-009d-4ac8-a291-001bdd50c659"],
 " tests it against one specific head \[LongDash] so it also distinguishes, \
say, one line through two points from another line through the same points on \
a graph where several exist."
}], "Notes",ExpressionUUID->"836bcc3e-eb00-400c-bce9-9a92a567d235"]
}, Open  ]],

