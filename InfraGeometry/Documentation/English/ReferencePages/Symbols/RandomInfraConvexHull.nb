Cell["RandomInfraConvexHull", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5a0d7ab0-426a-4315-b10b-e8663a414d38"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraConvexHull"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraConvexHull", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraConvexHull", "[", 
     RowBox[{
      StyleBox["seeds", "TI"], ",", " ", 
      StyleBox["rounds", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07ee9a76-5812-4790-93ed-fcdfdda212bc"],
 "\[LineSeparator]",
 "samples a sorted vertex set on graph ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0f787726-67e6-42ff-ad37-35bf604eaae6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraConvexHull"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraConvexHull", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraConvexHull", "[", 
     RowBox[{
      StyleBox["seeds", "TI"], ",", " ", 
      StyleBox["rounds", "TI"]}], "]"}], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "881e48ce-ae9e-463a-b719-31306177a288"],
 "\[LineSeparator]",
 "requests ",
 Cell[BoxData["count"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1616c97-d97d-481c-840d-ed97706f6a10"],
 " representatives. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05f15886-2c58-4f61-b34e-f827f1ad3334"],
 " enumerates the full pool; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fec89677-a2af-4b64-8925-4adf20f64d05"],
 " returns at most ",
 StyleBox["n", "TI"],
 "."
}], "Usage",ExpressionUUID->"04435dfc-6d4c-4f11-bbb9-dcfd7a134a6b"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomInfraConvexHull", "[", 
   RowBox[{"g", ",", " ", "seeds", ",", " ", "rounds", ",", " ", "count"}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35f6d2a4-a89a-4065-8584-8972adf45aa0"],
 " uses the direct form. With rounds omitted, the direct form is singular; \
use ",
 Cell[BoxData[
  RowBox[{"InfraConvexHull", "[", "seeds", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "668372b7-ce86-4d57-9d44-3b8cb38b8cdd"],
 " when supplying a count without rounds."
}], "Notes",ExpressionUUID->"6bf4f740-171e-4bf3-a6e4-d915979b612f"],

Cell[TextData[{
 "The sampler has the same token geometry as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConvexHull"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConvexHull", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b2901cc2-71bf-4ed4-8a7d-1e5cb53ff705"],
 ". An omitted or ",
