Cell["\<\
Covering the ball of radius 4 about the centre of the grid by balls of radius \
0 to 4. Its four corners are pairwise 8 apart, so radius 3 still needs four \
balls:\
\>", "ExampleText",ExpressionUUID->"97f40d17-fa53-46b6-b9db-70e07357c8cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"BallCoverNumber", "[", 
      RowBox[{"g", ",", " ", "r", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{"c", ",", " ", "4"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5f8d2b05-b943-47c9-bde1-3693d7e726d8"],

