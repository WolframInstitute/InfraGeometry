           RowBox[{"GraphRadius", "[", " ", "graph", " ", "]"}]}], " ", 
          "}"}]}], " ", "]"}]}], " ", "]"}], ",", "\n", "\t\t", 
     RowBox[{"{", " ", 
      RowBox[{"name", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
         " ", "\"\<SquareTilingGraph\>\"", ",", 
         " ", "\"\<HexagonalTilingGraph\>\""}], " ", "}"}]}], " ", "}"}]}], 
    " ", "]"}], ",", "\n", "\t", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", "\n", "\t", 
   RowBox[{"PlotLegends", " ", "->", " ", 
