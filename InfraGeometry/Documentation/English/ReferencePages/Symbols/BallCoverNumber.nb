Cell[TextData[{
 "On a cycle or a path with ",
 StyleBox["n", "TI"],
 " vertices, the covering number is the ceiling of ",
 StyleBox["n", "TI"],
 " divided by ",
 StyleBox["2r + 1", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"d4282ec0-6287-440f-9c21-b8b637b1dbd3"],

