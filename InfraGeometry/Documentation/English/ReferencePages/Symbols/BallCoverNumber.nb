Cell[TextData[{
 StyleBox["N(0)", "TI"],
 " is the number of vertices. The least ",
 StyleBox["N(r)", "TI"],
 " does not increase with ",
 StyleBox["r", "TI"],
 ", and it is 1 from the radius of the graph, the least eccentricity, on."
}], "Notes",ExpressionUUID->"05d2b3d2-9616-4ab1-961f-6ca4398dd267"],

Cell[TextData[{
 "How fast ",
 StyleBox["N(r)", "TI"],
 " falls as ",
 StyleBox["r", "TI"],
 " grows is a measure of dimension."
}], "Notes",ExpressionUUID->"f19d4a8e-4ed7-4f45-9b1e-a78a3c80d495"]
