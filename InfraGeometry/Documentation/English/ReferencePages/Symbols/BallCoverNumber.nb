Cell[TextData[{
 "The greedy count is at hand where the exact program is slow. The greedy ",
 StyleBox["N(r)", "TI"],
 " against the radius on the discretized plane of medium size."
}], "ExampleText",ExpressionUUID->"04bccb88-273c-4f67-9e7e-35a2f39772ab"],

