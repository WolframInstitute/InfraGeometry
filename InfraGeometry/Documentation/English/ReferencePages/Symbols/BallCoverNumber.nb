Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Automatic"]], "paclet:ref/Automatic"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9f024a29-fc3f-4ae8-bcb1-348337abff38"],
 " and ",
 Cell[BoxData["\"\<IntegerLinearProgramming\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d34eb4f-b0e1-4347-a045-509b636a06a2"],
 " solve the exact integer program. ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd506bf3-8b45-42fa-a642-74b832a3c2ab"],
 " remains a migration alias. ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c28ce9d4-0aef-4ba2-9dba-db996999cc19"],
 " and ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75425c27-2e50-44d0-9c82-8397ad905a63"],
 " are unsupported: the covering number is always the minimum. Obtain a \
greedy upper bound by taking the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Length"]], "paclet:ref/Length"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5cdda84e-3e5a-468f-b866-989e5857fda4"],
 " of a ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1543427b-3d79-4bd9-9ddf-e7e2d036c3ca"],
 " ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindBallCover"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindBallCover", 
    "WolframInstitute/InfraGeometry Package Symbol"},
