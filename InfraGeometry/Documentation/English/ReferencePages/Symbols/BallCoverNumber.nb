            RowBox[{"Method", " ", "->", " ", "\"\<Greedy\>\""}]}], " ", 
           "]"}]}]}], " ", "}"}]}], " ", "}"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}]}], " ", "]"}]}], " ", 
