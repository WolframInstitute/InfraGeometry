Cell["\<\
The greedy cover supplies an upper bound; on the cuboctahedron it needs an \
extra ball:\
\>", "ExampleText",ExpressionUUID->"51240df1-4b44-41df-8da2-4d29a8b2648f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "\t", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{
     "GraphData", "[", " ", "\"\<CuboctahedralGraph\>\"", " ", "]"}]}], " ", 
    "}"}], ",", "\n", "\t", 
   RowBox[{"Grid", "[", " ", 
    RowBox[{
     RowBox[{"{", " ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"\"\<Minimum\>\"", ",", " ", "\"\<Greedy upper bound\>\""}], 
        " ", "}"}], ",", "\n", "\t\t", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"BallCoverNumber", "[", " ", 
          RowBox[{"graph", ",", " ", "1"}], " ", "]"}], ",", " ", 
         RowBox[{"Length", " ", "@", " ", 
          RowBox[{"FindBallCover", "[", " ", 
