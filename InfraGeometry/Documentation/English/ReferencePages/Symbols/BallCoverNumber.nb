Cell["\<\
The greedy cover supplies an upper bound; on the cuboctahedron it needs an \
extra ball:\
\>", "ExampleText",ExpressionUUID->"a302f8fe-69b3-4346-be75-0686ee18d147"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "\t", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{
     "GraphData", "[", " ", "\"\<CuboctahedralGraph\>\"", " ", "]"}]}], " ", 
    "}"}], ",", "\n", "\t", 
   RowBox[{"Grid", "[", " ", 
    RowBox[{
     RowBox[{"{", " ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"\"\<Minimum\>\"", ",", " ", "\"\<Greedy upper bound\>\""}], 
        " ", "}"}], ",", "\n", "\t\t", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"BallCoverNumber", "[", " ", 
          RowBox[{"graph", ",", " ", "1"}], " ", "]"}], ",", " ", 
         RowBox[{"Length", " ", "@", " ", 
          RowBox[{"FindBallCover", "[", " ", 
           RowBox[{"graph", ",", " ", "1", ",", " ", 
            RowBox[{"Method", " ", "->", " ", "\"\<Greedy\>\""}]}], " ", 
           "]"}]}]}], " ", "}"}]}], " ", "}"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}]}], " ", "]"}]}], " ", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"da463479-b47b-4942-bb4e-1dc683f3605e"],

