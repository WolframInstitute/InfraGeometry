     RowBox[{
     "GraphData", "[", " ", "\"\<CuboctahedralGraph\>\"", " ", "]"}]}], " ", 
    "}"}], ",", "\n", "\t", 
   RowBox[{"Grid", "[", " ", 
    RowBox[{
     RowBox[{"{", " ", 
      RowBox[{
       RowBox[{"{", " ", 
