Cell["\<\
The greedy cover supplies an upper bound; on the cuboctahedron it needs an \
extra ball:\
\>", "ExampleText",ExpressionUUID->"8ee8771f-db80-46b9-8dfc-e44acecea53f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "\t", 
  RowBox[{
   RowBox[{"{", " ", 
