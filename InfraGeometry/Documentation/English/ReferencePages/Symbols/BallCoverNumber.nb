Cell[TextData[{
 "On a cycle and on a path with ",
 StyleBox["n", "TI"],
 " vertices, ",
 StyleBox["N(r)", "TI"],
 " is ",
 StyleBox["\[LeftCeiling]n/(2r + 1)\[RightCeiling]", "TI"],
 ": each ball holds at most ",
 StyleBox["2r + 1", "TI"],
 " vertices."
}], "ExampleText",ExpressionUUID->"9eddfbf3-0a38-438f-b340-e7952062dfbf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "12", "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraBall", "[", 
        RowBox[{"#", ",", " ", "1"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"FindBallCover", "[", 
       RowBox[{
        RowBox[{"CycleGraph", "[", "12", "]"}], ",", " ", "1"}], "]"}]}]}], 
    "]"}], ",", "\n", " ", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{"Flatten", " ", "@", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"BallCoverNumber", "[", 
         RowBox[{
          RowBox[{"CycleGraph", "[", "n", "]"}], ",", " ", "r"}], "]"}], " ", 
        "==", " ", 
        RowBox[{"Ceiling", "[", 
         RowBox[{"n", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "r"}], " ", "+", " ", "1"}], ")"}]}], "]"}]}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "3", ",", " ", "20"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}]}]}], ",", 
   "\n", " ", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{"Flatten", " ", "@", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"BallCoverNumber", "[", 
         RowBox[{
          RowBox[{"PathGraph", "[", 
           RowBox[{"Range", "[", "n", "]"}], "]"}], ",", " ", "r"}], "]"}], 
        " ", "==", " ", 
        RowBox[{"Ceiling", "[", 
         RowBox[{"n", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "r"}], " ", "+", " ", "1"}], ")"}]}], "]"}]}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "2", ",", " ", "20"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}]}]}]}], 
  "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"806a0b18-a3fe-489a-a3d2-204656d3107b"],

