Cell[CellGroupData[{
Cell["BallCoverNumber", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cebfb6e4-490e-4a2d-acfc-09a83ce147b0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallCoverNumber"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallCoverNumber", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d17c5810-4a3c-4b53-b2da-3d2f78a5dffb"],
 "\[LineSeparator]",
 "gives the least number of balls of radius ",
 StyleBox["r", "TI"],
 " that cover the vertices of ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"577288e7-9042-4142-ae92-ac7fc0dd6a9d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallCoverNumber"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallCoverNumber", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["target", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0287f5da-fabe-4b99-ba77-a400cf55a828"],
 "\[LineSeparator]",
 "gives the least number of balls of radius ",
 StyleBox["r", "TI"],
 " about vertices of ",
 StyleBox["g", "TI"],
 " that cover the vertices of ",
 StyleBox["target", "TI"],
 "."
}], "Usage",ExpressionUUID->"d752819c-e69c-41f2-a570-986e6a15135d"],

Cell[TextData[{
 "The covering number is ",
 StyleBox["N\:1d63(T) = min {|C| : T \[SubsetEqual] \[Union] B\:1d63(c), c \
\[Element] C}", "TI"],
 ", with the centres ",
 StyleBox["C", "TI"],
 " anywhere in ",
 StyleBox["g", "TI"],
 ". For ",
 StyleBox["T", "TI"],
 " the whole graph it is the ",
 StyleBox["r", "TI"],
 "-domination number of ",
 StyleBox["g", "TI"],
 "; at ",
 StyleBox["r", "TI"],
 " = 1 it is the domination number."
}], "Notes",ExpressionUUID->"b6484e82-2e56-4d1c-866d-61f5a1b2079c"],

Cell[TextData[{
 "The target can be a vertex, a vertex list, a density or a region such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bbced1df-5041-4edd-9eee-f821e4a3a3ab"],
 ". Only its vertices count. It defaults to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "138371e6-91ab-4b93-888a-76e4c30a2f08"],
 ", and the radius defaults to 1."
}], "Notes",ExpressionUUID->"fd0b2b41-615d-4790-9911-3173a10851e8"],

Cell[TextData[{
 "A ball holds at most ",
 StyleBox["m = max\:1d65 |B\:1d63(v)|", "TI"],
 " vertices, so ",
 StyleBox["N\:1d63(T) \[GreaterEqual] |T| / m", "TI"],
 ". On the square grid ",
 StyleBox["m = 2r\.b2 + 2r + 1", "TI"],
 "."
}], "Notes",ExpressionUUID->"921d0ed0-84d0-421c-b5f4-0d7ba0c823c6"],

Cell[TextData[{
 "At radius 0 the number is the number of vertices of the target. It does not \
increase with the radius. On a connected graph it is 1 exactly from the \
radius of the graph on. On a cycle or a path with ",
 StyleBox["n", "TI"],
 " vertices it is ",
 StyleBox["\[LeftCeiling]n / (2r + 1)\[RightCeiling]", "TI"],
 "."
}], "Notes",ExpressionUUID->"1aa2f4b5-9fed-4dfb-b6a0-3995d9e93665"],

Cell["\<\
The graph is undirected and unweighted, the radius a nonnegative integer. The \
number is always the minimum:\
\>", "Notes",ExpressionUUID->"91c59b22-4600-4a87-b144-208a9bdc4c44"],

