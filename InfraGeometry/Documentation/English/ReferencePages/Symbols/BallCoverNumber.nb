Cell[TextData[{
 "Definition: ",
 StyleBox["N(r)", "TI"],
 " is the length of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindBallCover"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindBallCover", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
