   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", " ", 
     RowBox[{"\"\<r\>\"", ",", " ", "\"\<N(r)\>\""}], " ", "}"}]}]}], " ", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8c0f3860-9700-4143-9a22-186b245502a9"],

