Cell["\<\
The covering number falls with radius on the plane mesh, square tiling and \
hexagonal tiling:\
\>", "ExampleText",ExpressionUUID->"735abfc5-69ad-4630-823a-e2111962ef91"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLogPlot", "[", "\n", "\t", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "\t\t", 
    RowBox[{
     RowBox[{"With", "[", "\n", "\t\t\t", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"graph", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", " ", 
          RowBox[{"name", ",", " ", "\"\<Small\>\""}], " ", "]"}]}], " ", 
        "}"}], ",", "\n", "\t\t\t", 
       RowBox[{"Table", "[", " ", 
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{"r", ",", " ", 
           RowBox[{"BallCoverNumber", "[", " ", 
            RowBox[{"graph", ",", " ", "r"}], " ", "]"}]}], " ", "}"}], ",", 
         " ", 
         RowBox[{"{", " ", 
