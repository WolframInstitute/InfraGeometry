Cell["\<\
A greedy cover gives an upper bound. At radius 4 on the grid it uses 7 balls \
where 4 suffice:\
\>", "ExampleText",ExpressionUUID->"7fa37f65-27a7-4725-ba12-3d58871f5120"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"cover", " ", "=", " ", 
          RowBox[{"FindBallCover", "[", 
           RowBox[{"g", ",", " ", "4", ",", " ", 
            RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}]}], "}"}], ",", 
        "\n", "      ", 
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"InfraBall", "[", 
             RowBox[{"#", ",", " ", "4"}], "]"}], " ", "&"}], " ", "/@", " ", 
           "cover"}], ",", " ", 
          RowBox[{"PlotLabel", " ", "->", " ", 
           RowBox[{"Length", "[", "cover", "]"}]}]}], "]"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "\"\<Greedy\>\""}], "}"}]}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"55474923-81eb-430c-a961-0652f0f43d89"],

