Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Automatic"]], "paclet:ref/Automatic"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1e478e48-ab83-4b0d-9458-bc14be977c53"],
 " and ",
 Cell[BoxData["\"\<IntegerLinearProgramming\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c76c352c-76b7-49d9-a715-7b3adcce8394"],
 " solve the exact integer program. ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ed1df7c-3f1b-490c-9aee-238d77fb7c68"],
 " remains a migration alias. ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5cb1f80-b554-4bf7-a300-4ea1d7746f46"],
 " and ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29d71120-1345-4bb8-a240-f31f1e4a4884"],
 " are unsupported: the covering number is always the minimum. Obtain a \
greedy upper bound by taking the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Length"]], "paclet:ref/Length"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dc041212-9b0b-4e44-a453-3fd3580039fe"],
 " of a ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ad817d4-05aa-4967-8507-1d188b969d02"],
 " ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindBallCover"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindBallCover", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "be36dece-875c-4ef8-aeba-c61b9b6bae46"],
 " result."
}], "Notes",ExpressionUUID->"a60f345b-1c68-43ac-985a-af8bfd7606de"],

Cell["\<\
At radius zero the number is the size of the target support. It is zero for \
an empty target and does not increase with radius. For a nonempty connected \
graph covered in full, it is one from the graph radius onward.\
\>", "Notes",ExpressionUUID->"6a264e4e-3e48-4c80-b8ad-ff2d3f03a1c1"]
}, Open  ]],

