Cell["\<\
A smallest cover by balls of radius 3, on the square grid and on the square \
mesh. The number of balls is the label:\
\>", "ExampleText",ExpressionUUID->"0a6e9191-b61e-4d69-8551-3bcb9139d1ab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"InfraBall", "[", 
           RowBox[{"#", ",", " ", "3"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"FindBallCover", "[", 
          RowBox[{"g", ",", " ", "3"}], "]"}]}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"BallCoverNumber", "[", 
          RowBox[{"g", ",", " ", "3"}], "]"}]}]}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"177e7dd4-3920-4523-b074-a71622c5fdb7"],

