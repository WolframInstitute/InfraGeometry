Cell[BoxData[
 RowBox[{"ListLogPlot", "[", "\n", "\t", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "\t\t", 
    RowBox[{
     RowBox[{"With", "[", "\n", "\t\t\t", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"graph", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", " ", 
          RowBox[{"name", ",", " ", "\"\<Small\>\""}], " ", "]"}]}], " ", 
        "}"}], ",", "\n", "\t\t\t", 
       RowBox[{"Table", "[", " ", 
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{"r", ",", " ", 
