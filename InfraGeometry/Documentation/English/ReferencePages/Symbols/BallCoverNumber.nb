   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", " ", 
     RowBox[{"\"\<r\>\"", ",", " ", "\"\<N(r)\>\""}], " ", "}"}]}]}], " ", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fab33652-3566-4584-9e19-40ca4546c63a"],

