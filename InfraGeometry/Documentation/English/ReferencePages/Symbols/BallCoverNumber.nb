 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"073c135b-9752-4302-beb4-2ba964ec0674"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallCoverNumber"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallCoverNumber", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f62a9969-14e5-4ee2-8e70-325090b82390"],
 "\[LineSeparator]",
 "gives the minimum number of closed balls of radius ",
 StyleBox["r", "TI"],
 " needed to cover every vertex of ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"fc241f1b-9bc5-40b1-842c-1bd55912e26d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
