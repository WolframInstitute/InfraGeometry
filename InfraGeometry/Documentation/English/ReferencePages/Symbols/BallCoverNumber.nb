Cell[TextData[{
 "On a cycle or a path with ",
 StyleBox["n", "TI"],
 " vertices, the covering number is the ceiling of ",
 StyleBox["n", "TI"],
 " divided by ",
 StyleBox["2r + 1", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"fd7f4dc0-a545-424e-a38f-a36f08348f35"],

