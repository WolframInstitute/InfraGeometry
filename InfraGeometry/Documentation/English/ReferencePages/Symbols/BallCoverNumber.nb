Cell[TextData[{
 "On a cycle and on a path with ",
 StyleBox["n", "TI"],
 " vertices the covering number is ",
 StyleBox["\[LeftCeiling]n / (2r + 1)\[RightCeiling]", "TI"],
 ", here at ",
 StyleBox["r", "TI"],
 " = 1:"
}], "ExampleText",ExpressionUUID->"1d3c995d-a7be-4785-8fe5-2e57418e4de5"],

