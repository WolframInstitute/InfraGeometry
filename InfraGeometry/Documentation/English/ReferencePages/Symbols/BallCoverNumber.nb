Cell[TextData[{
 "On a cycle or a path with ",
 StyleBox["n", "TI"],
 " vertices, the covering number is the ceiling of ",
 StyleBox["n", "TI"],
 " divided by ",
 StyleBox["2r + 1", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"75d5f56e-ba13-4ba4-a207-daaaf487b49d"],

