Cell["\<\
With targets: the number of balls of radius 2 that cover the ball of radius 4 \
about the centre.\
\>", "ExampleText",ExpressionUUID->"22e0708c-48e8-4d43-842b-52a365909258"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"target", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "4"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"target", " ", "->", " ", "StandardGray"}], ",", " ", 
         RowBox[{
          RowBox[{"FindBallCover", "[", 
           RowBox[{"g", ",", " ", "2", ",", " ", "target"}], "]"}], " ", "->",
           " ", "StandardRed"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"BallCoverNumber", "[", 
      RowBox[{"g", ",", " ", "2", ",", " ", "target"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9dd4cc71-31c4-456b-bd86-67c3bcd1f073"],

