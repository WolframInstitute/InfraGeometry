 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2b5b45bc-5725-40df-a5f5-455980e34da8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
