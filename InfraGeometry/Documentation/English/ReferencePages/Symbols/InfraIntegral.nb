Cell["\<\
The mean along a family is the mean of the value density, and the cardinality \
its total.\
\>", "ExampleText",ExpressionUUID->"d20e7c69-a16a-4b27-9b81-d5edf4585828"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "3", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"line", " ", "=", " ", 
      RowBox[{"InfraInfiniteLine", "[", 
       RowBox[{"p", ",", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"p", ",", " ", "2"}], "]"}]}], "]"}]}], "]"}]}], ",", " ", 
     
     RowBox[{"f", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "9"}], ",", " ", "9"}], "}"}], ",", " ", 
          RowBox[{"VertexCount", "[", "g", "]"}]}], "]"}]}], "]"}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"density", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraIntegral", "[", 
        RowBox[{"f", ",", " ", "line"}], "]"}], ",", 
       " ", "\"\<ValueDensity\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraIntegral", "[", 
         RowBox[{"f", ",", " ", "line"}], "]"}], ",", " ", "\"\<Mean\>\""}], 
       "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"Keys", "[", "density", "]"}], " ", 
         RowBox[{"Values", "[", "density", "]"}]}], "]"}], " ", "/", " ", 
       RowBox[{"Total", "[", "density", "]"}]}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraIntegral", "[", 
         RowBox[{"f", ",", " ", "line"}], "]"}], ",", 
        " ", "\"\<Cardinality\>\""}], "]"}], " ", "==", " ", 
      RowBox[{"Total", "[", "density", "]"}], " ", "==", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "line", ",", " ", "\"\<Cardinality\>\""}], 
       "]"}]}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5047144a-b087-40d5-8e78-a0c95d4a58d6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f8172ce2-5a58-45ab-aaf9-596a51da41a4"]
}, Open  ]],

Cell["\<\
Gauss: the integral of the codifferential over a region is the flux through \
its boundary.\
\>", "ExampleText",ExpressionUUID->"57e8fb4b-7521-4bdc-a690-b9af94a762bb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "4", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"omega", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"DirectedEdge", " ", "@@@", " ", 
         RowBox[{"EdgeList", "[", "g", "]"}]}], ",", " ", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", " ", 
          RowBox[{"EdgeCount", "[", "g", "]"}]}], "]"}]}], "]"}]}], ",", " ", 
     
     RowBox[{"region", " ", "=", " ", 
      RowBox[{"InfraShell", "[", 
       RowBox[{
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraIntegral", "[", 
        RowBox[{
         RowBox[{"InfraCodifferential", "[", "omega", "]"}], ",", " ", 
         "region"}], "]"}], ",", " ", "\"\<Value\>\""}], "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraIntegral", "[", 
        RowBox[{"omega", ",", " ", "region"}], "]"}], ",", 
       " ", "\"\<Flux\>\""}], "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3d6d1e9f-80b4-41d2-b974-98e17a7810f5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"22", ",", "22"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"8a4932fb-5a11-4a2d-90b7-e2bcb53f730a"]
}, Open  ]],

Cell["\<\
The uniform-chain antiderivative from an origin is the mean along the \
shortest paths from it, and the zeta antiderivative the sum over the interval.\
\>", "ExampleText",ExpressionUUID->"a3738a9a-f7c4-48ff-8698-f1c08cb8f645"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "5", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"c", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "9"}], ",", " ", "9"}], "}"}], ",", " ", 
          RowBox[{"VertexCount", "[", "g", "]"}]}], "]"}]}], "]"}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "4"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraAntiderivative", "[", 
          RowBox[{"f", ",", " ", 
           RowBox[{"Method", " ", "->", " ", "\"\<UniformChain\>\""}], ",", 
           " ", 
           RowBox[{"\"\<Origin\>\"", " ", "->", " ", "c"}]}], "]"}], ",", 
         " ", "\"\<Function\>\""}], "]"}], "[", "q", "]"}], " ", "==", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraIntegral", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"c", ",", " ", "q"}], "]"}]}], "]"}], ",", 
        " ", "\"\<Mean\>\""}], "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraAntiderivative", "[", 
          RowBox[{"f", ",", " ", 
           RowBox[{"\"\<Origin\>\"", " ", "->", " ", "c"}]}], "]"}], ",", 
         " ", "\"\<Function\>\""}], "]"}], "[", "q", "]"}], " ", "==", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraIntegral", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSegment", "[", 
             RowBox[{"c", ",", " ", "q"}], "]"}], ",", 
            " ", "\"\<VertexDensity\>\""}], "]"}]}], "]"}], ",", 
        " ", "\"\<Value\>\""}], "]"}]}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"58c4e7c9-3315-4e8a-a762-6bb2e9909481"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"49535872-0b5d-4810-b326-8628d091b0dd"]
}, Open  ]]
}, Open  ]],

