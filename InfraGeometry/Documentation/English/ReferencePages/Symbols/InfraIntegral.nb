Cell["\<\
The integral of a function along the same segment of the grid takes many \
values. Its value density counts the shortest paths with each value:\
\>", "ExampleText",ExpressionUUID->"e009f246-d644-41ce-aa1f-3d627aea6aa2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"p", ",", " ", "5"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"density", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraIntegral", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{"#", ",", " ", "4"}], "]"}], " ", "&"}], ",", " ", 
         RowBox[{"InfraSegment", "[", 
          RowBox[{"p", ",", " ", "q"}], "]"}]}], "]"}], ",", 
       " ", "\"\<ValueDensity\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"BarChart", "[", 
    RowBox[{
     RowBox[{"Values", "[", "density", "]"}], ",", " ", 
     RowBox[{"ChartLabels", " ", "->", " ", 
      RowBox[{"Keys", "[", "density", "]"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"cd451288-9c92-41da-a4f3-4ae14be080f7"],

