Cell["\<\
Over a region the integral is the sum over its support: the integral of 1 \
over a ball is its volume.\
\>", "ExampleText",ExpressionUUID->"6f7dca49-7bc9-46bb-b649-6f336edfa2c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"InfraBall", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "3"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraIntegral", "[", 
        RowBox[{
         RowBox[{"1", " ", "&"}], ",", " ", "ball"}], "]"}], ",", 
       " ", "\"\<Value\>\""}], "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "ball", ",", " ", "\"\<CountingMeasure\>\""}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"04000bc2-50cc-4fab-b431-ba881b88b1c8"],

