   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2950197d-3a44-4835-b61d-aa89063b2ae5"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraAntiderivative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraAntiderivative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8a4618e8-84b6-4cb2-ac14-d44c69235a2f"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDerivative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDerivative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0937c0ff-544d-4b93-b396-57a88a3bf70e"],
 " are 0-forms."
}], "Notes",ExpressionUUID->"2cdbb7d6-9714-4e72-a75f-6917267e539f"],

