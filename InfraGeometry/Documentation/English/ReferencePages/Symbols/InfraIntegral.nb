Cell[TextData[{
 "Any head whose ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef0195ee-b8f8-4ce3-9d66-400d767a9bf5"],
 " is a directed acyclic graph is integrated along its chains. Here a head \
named in this example gives the chains of the light-cone lattice from (0, 0) \
to (6, 6): the differential of ",
 StyleBox["f(i, j) = i j", "TI"],
 " has the value 36 on all 924 of them."
}], "ExampleText",ExpressionUUID->"38ba5208-92ec-456b-bf04-852755e84173"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "chainsHead", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"chainsHead", " ", "/:", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"graph_Graph", ",", " ", 
     RowBox[{"chainsHead", "[", 
      RowBox[{"p_", ",", " ", "q_"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
    "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"TransitiveReductionGraph", " ", "@", " ", 
    RowBox[{"Subgraph", "[", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"Intersection", "[", 
       RowBox[{
        RowBox[{"VertexOutComponent", "[", 
         RowBox[{"graph", ",", " ", 
          RowBox[{"{", "p", "}"}]}], "]"}], ",", " ", 
        RowBox[{"VertexInComponent", "[", 
         RowBox[{"graph", ",", " ", 
          RowBox[{"{", "q", "}"}]}], "]"}]}], "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lattice", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "0", ",", " ", "6"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}], ",", 
         " ", "1"}], "]"}], ",", "\n", "     ", 
       RowBox[{"Flatten", " ", "@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"i", " ", "<", " ", "6"}], ",", " ", 
              RowBox[{"DirectedEdge", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "j"}], "}"}]}],
                "]"}], ",", " ", "Nothing"}], "]"}], ",", " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"j", " ", "<", " ", "6"}], ",", " ", 
              RowBox[{"DirectedEdge", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", 
                  RowBox[{"j", " ", "+", " ", "1"}]}], "}"}]}], "]"}], ",", 
              " ", "Nothing"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "0", ",", " ", "6"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Normal", " ", "@", " ", 
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"lattice", ",", " ", 
      RowBox[{"InfraIntegral", "[", 
       RowBox[{
        RowBox[{"InfraDifferential", "[", 
         RowBox[{"Apply", "[", "Times", "]"}], "]"}], ",", " ", 
        RowBox[{"chainsHead", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"6", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}], ",", 
      " ", "\"\<ValueDensity\>\""}], "]"}]}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e927c79d-db1a-4783-9645-ff6a4e9f2360"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"36", "\[Rule]", "924"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"a9016b46-351a-453c-bdf7-7e221b78f333"]
}, Open  ]]
}, Open  ]],

