Cell["\<\
The mean along a family is the mean of its value density, and the cardinality \
is the total of the density:\
\>", "ExampleText",ExpressionUUID->"31afdabe-4b6c-4341-a1bf-bcc59f6a014c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ray", " ", "=", " ", 
     RowBox[{"InfraHalfLine", "[", 
      RowBox[{"p", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"p", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"integral", " ", "=", " ", 
     RowBox[{"InfraIntegral", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"#", "^", "2"}], ",", " ", "11"}], "]"}], " ", "&"}], ",", 
       " ", "ray"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"density", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "integral", ",", " ", "\"\<ValueDensity\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "integral", ",", " ", "\"\<Mean\>\""}], "]"}], 
      " ", "==", " ", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"Keys", "[", "density", "]"}], " ", 
         RowBox[{"Values", "[", "density", "]"}]}], "]"}], " ", "/", " ", 
       RowBox[{"Total", "[", "density", "]"}]}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "integral", ",", " ", "\"\<Cardinality\>\""}], 
       "]"}], " ", "==", " ", 
      RowBox[{"Total", "[", "density", "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"49b47d6c-4222-4631-93d8-7ecf80589d5c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"dc21f4bf-75d9-4460-baf0-aa2b9de5f23d"]
}, Open  ]],

Cell["\<\
Gauss: the integral of the codifferential over a region is the flux into it:\
\>", "ExampleText",ExpressionUUID->"a6d0d518-29a4-4565-ba54-492007c530ce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"region", " ", "=", " ", 
     RowBox[{"InfraShell", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"omega", " ", "=", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"3", " ", 
             RowBox[{"First", "[", "#", "]"}]}], " ", "+", " ", 
            RowBox[{"Last", "[", "#", "]"}]}], ",", " ", "7"}], "]"}], " ", "-",
          " ", "3"}], " ", "&"}], ",", " ", 
       RowBox[{"DirectedEdge", " ", "@@@", " ", 
        RowBox[{"EdgeList", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraIntegral", "[", 
        RowBox[{
         RowBox[{"InfraCodifferential", "[", "omega", "]"}], ",", " ", 
         "region"}], "]"}], ",", " ", "\"\<Value\>\""}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraIntegral", "[", 
        RowBox[{"omega", ",", " ", "region"}], "]"}], ",", 
       " ", "\"\<Flux\>\""}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5e7a1888-acbc-4b79-950d-da5cca8efe43"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"5", ",", "5"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"c056b050-4551-4ccd-bc0b-3e794d0af151"]
}, Open  ]],

Cell[TextData[{
 "From an origin ",
 StyleBox["c", "TI"],
 ", the zeta antiderivative at ",
 StyleBox["q", "TI"],
 " is the integral over the support of the segment from ",
 StyleBox["c", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", and the uniform-chain antiderivative is the mean along the segment:"
}], "ExampleText",ExpressionUUID->"b5fa5e24-14e8-4b37-8811-63158417bcb6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"c", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"#", "^", "2"}], ",", " ", "11"}], "]"}], " ", "&"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraAntiderivative", "[", 
          RowBox[{"f", ",", " ", 
           RowBox[{"\"\<Origin\>\"", " ", "->", " ", "c"}]}], "]"}], ",", 
         " ", "\"\<Function\>\""}], "]"}], "[", "q", "]"}], " ", "==", "\n", 
      "     ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraIntegral", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSegment", "[", 
             RowBox[{"c", ",", " ", "q"}], "]"}], ",", 
            " ", "\"\<VertexDensity\>\""}], "]"}]}], "]"}], ",", 
        " ", "\"\<Value\>\""}], "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraAntiderivative", "[", 
          RowBox[{"f", ",", " ", 
           RowBox[{"Method", " ", "->", " ", "\"\<UniformChain\>\""}], ",", 
           " ", 
           RowBox[{"\"\<Origin\>\"", " ", "->", " ", "c"}]}], "]"}], ",", 
         " ", "\"\<Function\>\""}], "]"}], "[", "q", "]"}], " ", "==", "\n", 
      "     ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraIntegral", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"c", ",", " ", "q"}], "]"}]}], "]"}], ",", 
        " ", "\"\<Mean\>\""}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"5222b9a3-9364-4444-ae59-591adc963295"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"30b9c7a3-eed2-4ccc-882e-798a1bfe03b3"]
}, Open  ]]
}, Open  ]],

