Cell[TextData[{
 "The fundamental theorem: ",
 StyleBox["\[Integral] df = f(q) \[Minus] f(p)", "TI"],
 " along every walk from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ", so the integral of a differential along a segment has one value."
}], "Notes",ExpressionUUID->"986d2b32-79f3-451b-be21-dbe9ef2c1385"]
}, Open  ]],

