Cell[CellGroupData[{
Cell["InfraIntegral", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"02fcc0d6-f1c7-4610-a2fd-e66defea899e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraIntegral"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraIntegral", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["f", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dae569b4-a681-4d3e-a3a2-766807e07a53"],
 "\[LineSeparator]",
 "is the integral of the 0-form or 1-form ",
 StyleBox["f", "TI"],
 " over the object ",
 StyleBox["obj", "TI"],
 ": one sum over a region, or one sum along each member of a family of walks.",
 "\n"
}], "Usage",ExpressionUUID->"d3d49f66-ec20-4499-a2cb-839cf466546e"],

Cell[TextData[{
 "Over a region ",
 StyleBox["R", "TI"],
 " the integral of a 0-form is ",
 StyleBox["\[CapitalSigma] f(v)", "TI"],
 ", the sum over the vertices ",
 StyleBox["v", "TI"],
 " of ",
 StyleBox["R", "TI"],
 ". Along a walk ",
 StyleBox["\[Gamma] = (v\:2080, \[Ellipsis], v\:2096)", "TI"],
 " a 0-form gives ",
 StyleBox["\[CapitalSigma] f(v\:1d62)", "TI"],
 ", both ends included, and a 1-form gives ",
 StyleBox["\[CapitalSigma] \[Omega](v\:1d62\:208b\:2081 \[RightArrow] \
v\:1d62)", "TI"],
 "."
}], "Notes",ExpressionUUID->"b180f998-bf7a-40c8-ac34-deb135c25177"],

Cell[TextData[{
 "The domain is any object that ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "36a01cd7-129a-497d-a582-720e16308b8d"],
 " reads:"
}], "Notes",ExpressionUUID->"3f9568bc-b812-4740-8104-237fcc73bbde"],

