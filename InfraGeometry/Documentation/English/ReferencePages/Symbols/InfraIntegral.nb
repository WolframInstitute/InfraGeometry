Cell[TextData[{
 "The integral of a differential along a segment, on the discretized plane, \
the square grid and the hexagonal tiling: every shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " has the integral ",
 StyleBox["f(q) \[Minus] f(p)", "TI"],
 ", so the value density is a single atom carrying all of them."
}], "ExampleText",ExpressionUUID->"86eb6181-834e-4a34-b914-656d2175df04"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"q", " ", "=", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"p", ",", " ", "5"}], "]"}]}], "]"}]}], ",", " ", 
        RowBox[{"f", " ", "=", " ", 
         RowBox[{"AssociationThread", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{"RandomInteger", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "9"}], ",", " ", "9"}], "}"}], ",", " ", 
             RowBox[{"VertexCount", "[", "g", "]"}]}], "]"}]}], "]"}]}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"Labeled", "[", 
       RowBox[{
