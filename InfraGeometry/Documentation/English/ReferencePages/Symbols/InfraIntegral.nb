Cell[TextData[{
 "The integral of a differential along a segment. Each of its shortest paths \
has the integral ",
 StyleBox["f(q) \[Minus] f(p)", "TI"],
 ", so the value density is one atom, carrying all of them:"
}], "ExampleText",ExpressionUUID->"bd7a060b-1bd3-4acb-951b-0479b98560af"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"q", " ", "=", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"p", ",", " ", "5"}], "]"}], ",", " ", 
           RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], ",", 
        " ", 
        RowBox[{"f", " ", "=", " ", 
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"#", "^", "2"}], ",", " ", "11"}], "]"}], " ", "&"}]}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraSegment", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "p", ",", " ", 
          "q"}], "}"}], ",", "\n", "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraIntegral", "[", 
            RowBox[{
             RowBox[{"InfraDifferential", "[", "f", "]"}], ",", " ", 
             RowBox[{"InfraSegment", "[", 
              RowBox[{"p", ",", " ", "q"}], "]"}]}], "]"}], ",", 
           " ", "\"\<ValueDensity\>\""}], "]"}]}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"892d1073-03dd-4aab-9cb9-832103a81ac6"],

Cell[BoxData[
 GraphicsBox[{{}, {InsetBox[
     FormBox[
      GraphicsBox[
