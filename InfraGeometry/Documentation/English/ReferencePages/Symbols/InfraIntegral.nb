Cell[TextData[{
 "A ray has many far ends. Along each member the integral of a differential \
is ",
 StyleBox["f(end) \[Minus] f(p)", "TI"],
 ", so the value density has one atom per value of ",
 StyleBox["f", "TI"],
 " at the far ends:"
}], "ExampleText",ExpressionUUID->"3d940275-0b26-4148-8f81-e9d0a8cf8c9e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ray", " ", "=", " ", 
         RowBox[{"InfraHalfLine", "[", 
          RowBox[{"p", ",", " ", 
           RowBox[{"RandomInfraPoint", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraShell", "[", 
              RowBox[{"p", ",", " ", "2"}], "]"}], ",", " ", 
             RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], 
          "]"}]}], ",", " ", 
        RowBox[{"f", " ", "=", " ", 
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"#", "^", "2"}], ",", " ", "11"}], "]"}], " ", "&"}]}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"ray", ",", " ", "p"}], "}"}], ",", "\n", "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraIntegral", "[", 
            RowBox[{
             RowBox[{"InfraDifferential", "[", "f", "]"}], ",", " ", "ray"}], 
            "]"}], ",", " ", "\"\<ValueDensity\>\""}], "]"}]}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"8b6da880-caab-48fa-bca4-65b7b8093639"],

