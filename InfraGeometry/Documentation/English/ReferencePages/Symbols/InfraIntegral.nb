Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8703c7d-3439-4d72-b85c-0a190d466fff"],
 " gives the readings that apply. The value density is computed by one \
forward sweep of the graph, which carries the distribution of the partial \
integrals at every vertex, never by enumerating the members. The mean reads \
the occupation densities of the object."
}], "Notes",ExpressionUUID->"cf30f00c-6636-4665-b9ed-f9eaf1e7cf46"],

Cell[TextData[{
 "Along a family of walks the integral is itself a multi-object, one value \
per member, which the value density records. The integral of a differential \
has one value: ",
 StyleBox["\[Integral]_\[Gamma] df = f(q) \[Minus] f(p)", "TI"],
 " on every member from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"c257e2ae-25e4-49b4-b3f7-704fbfe72e45"]
}, Open  ]],

