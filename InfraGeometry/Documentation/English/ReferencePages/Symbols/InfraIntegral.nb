Cell["\<\
A polyline is not a family of alternatives, and its integral stays \
unevaluated. Integrate its pieces one by one:\
\>", "ExampleText",ExpressionUUID->"92630f53-7809-4c25-800e-171af2bec85a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraIntegral", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"#", "^", "2"}], ",", " ", "11"}], "]"}], " ", "&"}], ",",
           " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"a", ",", " ", "c", ",", " ", "b"}], "]"}]}], "]"}], ",", 
        " ", "\"\<Value\>\""}], "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraIntegral", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"#", "^", "2"}], ",", " ", "11"}], "]"}], " ", "&"}], ",",
            " ", 
           RowBox[{"InfraSegment", " ", "@@", " ", "#"}]}], "]"}], ",", 
         " ", "\"\<Value\>\""}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "c"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "b"}], "}"}]}], "}"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5b8ba02c-5427-4e3b-87c9-203568a972fb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"InfraMeasurement", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"6", ",", "10", ",", "18"}], "}"}], ",", "6"}], "}"}]}], 
  "}"}]], "Output",
