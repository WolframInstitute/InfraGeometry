   {Cell["      ", "ModInfo",ExpressionUUID->
     "70822437-b597-4892-8d61-15da000be580"], Cell["\<\
a region: a ball, shell, tube, a vertex, a vertex list, a density\
\>", "TableText",ExpressionUUID->"46cedd48-ef0c-4c4a-8078-f28648494702"], 
    Cell["one value, the sum over its support", "TableText",ExpressionUUID->
