Cell["\<\
On a directed acyclic graph a 1-form lives on the links. A walk along an \
implied edge, which a longer chain also joins, finds no value there and \
counts 0: integrate along the chains of the order, as the heads of a causal \
set do.\
\>", "ExampleText",ExpressionUUID->"26467049-5b0b-43cc-8724-f623493497bb"],

Cell["\<\
A polyline is not a family of alternatives, and its integral stays \
unevaluated. Integrate its pieces one by one.\
\>", "ExampleText",ExpressionUUID->"c9ec99a3-2444-49d0-a75f-4bab21eb798d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraIntegral", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "^", "2"}], " ", "&"}], ",", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"1", ",", " ", "13", ",", " ", "25"}], "]"}]}], "]"}], ",",
         " ", "\"\<Value\>\""}], "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraIntegral", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "^", "2"}], " ", "&"}], ",", " ", 
           RowBox[{"InfraSegment", " ", "@@", " ", "#"}]}], "]"}], ",", 
         " ", "\"\<Value\>\""}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "13"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"13", ",", " ", "25"}], "}"}]}], "}"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"34fde75b-bf14-49a2-91be-44ce54f98f7d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"InfraMeasurement", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "247", ",", "287", ",", "319", ",", "367", ",", "399", ",", "471"}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
      "1615", ",", "1751", ",", "1879", ",", "1927", ",", "2055", ",", 
       "2223"}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b7f61654-f2e2-4b7c-9c1d-4c64dbcb9b19"]
}, Open  ]]
