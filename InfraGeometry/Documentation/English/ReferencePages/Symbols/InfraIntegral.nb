Cell["\<\
The integral of a function along the same segment of the square grid is a \
multi-object: its value density, one bar per value, counts the shortest paths \
with each value.\
\>", "ExampleText",ExpressionUUID->"90d9b301-498c-45c8-b4d7-f576f87e517e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"q", " ", "=", " ", 
      RowBox[{"RandomInfraPoint", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraShell", "[", 
         RowBox[{"p", ",", " ", "5"}], "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "9"}], ",", " ", "9"}], "}"}], ",", " ", 
          RowBox[{"VertexCount", "[", "g", "]"}]}], "]"}]}], "]"}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"density", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraIntegral", "[", 
        RowBox[{"f", ",", " ", 
         RowBox[{"InfraSegment", "[", 
          RowBox[{"p", ",", " ", "q"}], "]"}]}], "]"}], ",", 
       " ", "\"\<ValueDensity\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"BarChart", "[", 
    RowBox[{
     RowBox[{"Values", "[", "density", "]"}], ",", " ", 
     RowBox[{"ChartLabels", " ", "->", " ", 
      RowBox[{"Keys", "[", "density", "]"}]}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3d17a760-6b33-4111-a8a8-9ddaa1cd488a"],

