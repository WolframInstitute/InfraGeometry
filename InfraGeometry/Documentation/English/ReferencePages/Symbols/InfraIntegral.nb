Cell[CellGroupData[{
Cell["InfraIntegral", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"540bbb3c-b6e4-4b63-a41f-e939052de567"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraIntegral"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraIntegral", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["f", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02b167db-fa96-435a-bd09-3493b3d3a512"],
 "\[LineSeparator]",
 "is the integral of the 0-form or 1-form ",
 StyleBox["f", "TI"],
 " over the object ",
 StyleBox["obj", "TI"],
 ": one sum over a region, or one sum along each member of a family of walks. \
It is a symbolic object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9b55f6aa-19a7-4a3a-8c9c-1c07cf3d1761"],
 " evaluates it on a graph.",
 "\n"
}], "Usage",ExpressionUUID->"cf20fba0-46e8-4097-8d01-f13d5e2c373f"],

Cell[TextData[{
 "Definition: over a region ",
 StyleBox["R", "TI"],
 ", ",
 StyleBox["\[Integral]", "TI"],
 StyleBox["R f = \[CapitalSigma]", "TI", "TI"],
 StyleBox["(v \[Element] R) f(v)", "TI"],
 ". Along a walk ",
 StyleBox["\[Gamma] = (v_0, \[Ellipsis], v_k)", "TI"],
 ", a 0-form gives ",
 StyleBox["\[Integral]_\[Gamma] f = \[CapitalSigma]_i f(v_i)", "TI"],
 ", both ends included, and a 1-form gives ",
 StyleBox["\[Integral]", "TI"],
 StyleBox["\[Gamma] \[Omega] = \[CapitalSigma]_i \[Omega](v", "TI", "TI"],
 StyleBox["(i\[Minus]1) \[RightArrow] v_i)", "TI"],
 "."
}], "Notes",ExpressionUUID->"33fa29a4-8bd5-4745-bef0-d559e7e435af"],

Cell[TextData[{
 StyleBox["obj", "TI"],
 " is any object ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "937fb114-caa0-468d-9e96-aaf96ed01d82"],
 " reads, with no new head for the domain:"
}], "Notes",ExpressionUUID->"81c01b29-7412-4091-ac5c-789065bc2182"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4c99300d-ea4a-46c9-b81f-41361750552b"], Cell[TextData[StyleBox[
    "obj", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"8cb2aa0c-5f98-49b7-9737-0ac43aaf7c60"],
     Cell["Integral", "TableText",
     FontWeight->Bold,ExpressionUUID->"b59cf7fc-e206-41cf-8009-398d8367cd80"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "305b1a18-2441-4ff3-b185-1c03a1846f76"], Cell["\<\
a region: a ball, shell, tube or other set head, a vertex, a vertex list, a \
density\
\>", "TableText",ExpressionUUID->"bc024db8-9a3b-46a1-883b-69c0df3057dc"], 
    Cell[TextData[{
     "one value, the sum over its support, the keys of its ",
     Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f8837858-3b26-40f9-a064-620bb8708354"]
    }], "TableText",ExpressionUUID->"01a7bc48-7c6a-4d8f-b245-de5f5291336e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "faec2c73-394c-4b6f-8107-804c2247b518"], Cell[TextData[{
     "a family of walks: a segment, ray, line, open arc, or any head whose ",
     Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f16c2d65-3b29-44a8-8ee6-d0ace42474a6"],
     " is a directed acyclic graph or a ",
     Cell[BoxData["List"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "dfab211c-a7b9-43e8-b23c-0828e44ace47"],
     " of alternative ones"
    }], "TableText",ExpressionUUID->"3dfd364d-6b78-4428-acc2-5c972cd58c14"], 
    Cell["\<\
one value per member, a chain of the graph from a source to a sink\
\>", "TableText",ExpressionUUID->"d48282af-4bc0-4f12-bfb2-77427ed9b2a2"]}
  }]], "2ColumnTableMod",ExpressionUUID->"6893107d-12e0-4c8b-b4f6-\
20007b97b9e4"],

Cell[TextData[{
 "A head of another paclet works the same way when that paclet is loaded, \
such as the light cones and worldlines of InfraCausality. Polylines, closed \
arcs and circles stay unevaluated: their ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ada611e-5c71-4d20-a1fd-6d63b1b19105"],
 " of graphs holds factors of one member, or a copy of a vertex."
}], "Notes",ExpressionUUID->"d0394991-7ebb-4187-9db7-5f2b5d1dd7b6"],

