  }]], "2ColumnTableMod",ExpressionUUID->"9c8704f2-b09e-4a16-b4ef-\
137283039da3"],

Cell["\<\
Polylines, closed arcs and circles are not families of alternative walks, and \
their integrals stay unevaluated.\
\>", "Notes",ExpressionUUID->"3a096fd7-383d-410f-89f1-3b3e702ba616"],

Cell[TextData[{
 StyleBox["f", "TI"],
 " is a 0-form, an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1a3744f7-e291-4773-80f8-f1823cd8437b"],
 " ",
 StyleBox["v", "TI"],
 " -> ",
 StyleBox["x", "TI"],
 " or a function applied to each vertex, or a 1-form, an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "638bd310-5184-44e9-a8ba-b8929e851f99"],
 " ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"DirectedEdge", "[", 
    RowBox[{"u", ",", " ", "v"}], "]"}], " ", "->", " ", "x"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1352879-a4d4-4719-899c-6dc8da8a88cd"],
 " read antisymmetrically. A missing key counts as 0. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDifferential"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDifferential", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
