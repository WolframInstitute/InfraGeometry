    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6680ae7f-1a22-4244-9033-1e726b42f6bd"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53c839a8-96d6-407f-9910-9943775ffd3c"],
 " if ",
 StyleBox["fib", "TI"],
 " is a fibered graph: a total graph with a projection defined on all its \
vertices.",
 "\n"
}], "Usage",ExpressionUUID->"378601b8-e24a-4487-943c-c04a8c02a5c1"],

Cell[TextData[{
 "A fibered graph is a graph ",
 StyleBox["E", "TI"],
 " with a map ",
 StyleBox["\[Pi]", "TI"],
 " on its vertices. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraphQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraphQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "33e9efcc-dd9d-48ef-b015-fec3fb6b1301"],
 " tests only that ",
 StyleBox["\[Pi]", "TI"],
 " is defined on every vertex of ",
 StyleBox["E", "TI"],
 "."
}], "Notes",ExpressionUUID->"d8da8f54-9180-4514-b9d7-6d6871d7f065"],

Cell[TextData[{
 "The total graph must be finite, simple, undirected, unweighted and without \
edge tags. The projection is an association with one key for each vertex, or \
a function. A projection that is not a function, such as a string or a list, \
leaves its values as unevaluated applications ",
 StyleBox["\[Pi]", "TI"],
 "[",
 StyleBox["v", "TI"],
 "], and gives ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "184866c6-d2c6-43c3-b9a7-ac635846cd7e"],
 "."
}], "Notes",ExpressionUUID->"c64214b2-bc5f-4563-bd89-7b1091c0dffc"],

Cell[TextData[{
 "No further condition is tested. Fibers of different sizes, vertical edges \
and vertices without lifts are allowed; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibrationQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d92eac25-fc91-45e1-bee1-1041524676c5"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberBundleQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberBundleQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "096c93e9-80ee-4d58-8db4-c6d077e06cb7"],
 " test those."
}], "Notes",ExpressionUUID->"8c6a77f4-8293-41b8-aa30-b8ad0d80d0da"],

Cell["Accepted heads:", "Notes",ExpressionUUID->"849e99ac-ddc1-4e04-8570-268cbb4a2745"],

