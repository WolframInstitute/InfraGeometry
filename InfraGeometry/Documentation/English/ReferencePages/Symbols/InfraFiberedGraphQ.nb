Notebook[{

Cell[CellGroupData[{
Cell["InfraFiberedGraphQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4b97204a-2af9-4924-a5f6-ee8d741da968"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFiberedGraphQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraphQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7975e7f1-c6f3-46ee-b9d7-5655145a5007"],
 "\[LineSeparator]",
 "recognizes a supported fibered graph.",
 "\n"
}], "Usage",ExpressionUUID->"bd1740ff-5b8b-4adb-8149-88d84af18b7e"],

Cell["\<\
A supported object has a finite simple undirected unweighted untagged total \
graph and a projection defined on exactly its vertices.\
\>", "Notes",ExpressionUUID->"418487c4-cce3-4465-ad08-e3dd6dfd7339"],

Cell[TextData[{
 "Both the canonical ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a408d70a-854e-4b9e-b0e7-e416d200d6e8"],
 " head and the legacy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7adce08e-0e80-4365-baa9-76bdec714d37"],
 " head are accepted."
}], "Notes",ExpressionUUID->"a4322bcb-fa91-4f90-9c72-d4270b960929"],

Cell["\<\
The predicate imposes no restriction on fiber cardinalities, vertical edges \
or edge lifting.\
\>", "Notes",ExpressionUUID->"9081a75f-bb21-4b2f-811f-513b237a94c8"],

Cell["\<\
A valid empty literal graph with empty projection gives True.\
\>", "Notes",ExpressionUUID->"2afc9b5e-382c-4e30-ae87-a8d29dc5f9ed"],

Cell["\<\
Malformed projections, unsupported graph domains and unrecognized inputs \
remain unevaluated. An unevaluated result is not False.\
\>", "Notes",ExpressionUUID->"1c2dc1a5-f85c-4590-b746-a8107cdf0e7b"],

Cell["\<\
A nonempty list is tested by conjunction. An empty list gives False; it \
denotes no supplied objects.\
\>", "Notes",ExpressionUUID->"aff68f81-94ec-4be7-b2b9-4ffff59b7782"],

Cell[TextData[{
 "Supported Experimental models have explicit category methods that \
materialize the construction once and apply the predicate to the resulting \
literal object. Manual materialization with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6d2326df-0310-4fa8-87e2-677c52f83610"],
 " is optional."
}], "Notes",ExpressionUUID->"70e46e2a-c324-4968-a656-a90526334dca"]
}, Open  ]],

