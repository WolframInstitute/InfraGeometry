Notebook[{

Cell[CellGroupData[{
Cell["InfraFiberedGraphQ", "ObjectName",ExpressionUUID->"e4442378-e039-4671-bcc9-bd044ef307d1"],

Cell["LLM generated.", "Notes",ExpressionUUID->"99174486-421b-471b-b561-4784192f9023"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a77851bf-16ba-4f44-95be-cfd8417f5de8"],
 Cell[BoxData[
  RowBox[{"InfraFiberedGraphQ", "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2739561-5258-42bd-96b9-32f23caba5f4"],
 "\[LineSeparator]",
 "recognizes a supported fibered graph.",
 "\n"
}], "Usage",ExpressionUUID->"89be06d4-6f45-44e1-a6b5-bcb1374265d3"],

Cell["\<\
A supported object has a finite simple undirected unweighted untagged total \
graph and a projection defined on exactly its vertices.\
\>", "Notes",ExpressionUUID->"29dead69-527e-4f1d-b098-942038064bdf"],

Cell[TextData[{
 "Both the canonical ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "44668601-c38f-4109-8a2b-4bfcdf04b8ba"],
 " head and the legacy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "349087a7-25ab-4388-a148-a793659d0421"],
 " head are accepted."
}], "Notes",ExpressionUUID->"c02f605c-757c-404d-b16f-b3dc68b51291"],

Cell["\<\
The predicate imposes no restriction on fiber cardinalities, vertical edges \
or edge lifting.\
\>", "Notes",ExpressionUUID->"d4abd5a9-26ec-4515-91b2-b84cd2f4ff0e"],

Cell["\<\
A valid empty literal graph with empty projection gives True.\
\>", "Notes",ExpressionUUID->"d2a41136-fb83-4655-b6dc-f539138f874b"],

Cell["\<\
Malformed projections, unsupported graph domains and unrecognized inputs \
remain unevaluated. An unevaluated result is not False.\
\>", "Notes",ExpressionUUID->"dec609d2-cdea-42f4-a219-22b1cb92dea3"],

Cell["\<\
A nonempty list is tested by conjunction. An empty list gives False; it \
denotes no supplied objects.\
\>", "Notes",ExpressionUUID->"a998635c-29e6-4240-beb8-21ec1a88a3a6"],

Cell[TextData[{
 "Supported Experimental models have explicit category methods that \
materialize the construction once and apply the predicate to the resulting \
literal object. Manual materialization with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ad726e49-69c8-4f11-b700-af18cc796958"],
 " is optional."
}], "Notes",ExpressionUUID->"79d14a1e-7998-433b-9c72-a4097552a104"]
}, Open  ]],

