Cell["\<\
A fibered graph need not have lifts. The vertices 2 and 4 have no neighbour \
in the other fiber, so it is not a fibration:\
\>", "ExampleText",ExpressionUUID->"38ae51f8-4eb9-45eb-a3ed-2ebea9cdf12a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"Graph", "[", 
        RowBox[{
         RowBox[{"Range", "[", "4", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", " ", "<->", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<q\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<q\>\""}]}], "|>"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraFiberedGraphQ", "[", "fib", "]"}], ",", " ", 
        RowBox[{"InfraFibrationQ", "[", "fib", "]"}]}], "}"}]}], ",", "\n", 
     "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"65533b79-9b6a-4eb4-bd52-198119e915b1"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3, 4}, {Null, {{1, 3}}}, {
      GraphLayout -> {"Dimension" -> 2}, ImageSize -> Medium, 
       PlotLabel -> {True, False}, 
       VertexCoordinates -> {{1.3333333333333333`, 0.}, {0.6666666666666667, 
        0.}, {-0.6666666666666667, 0.}, {-1.3333333333333333`, 0.}}, 
       VertexStyle -> {
        2 -> RGBColor[0.9057646, 0.6405292, 0.55], 1 -> 
         RGBColor[0.9057646, 0.6405292, 0.55], 3 -> 
         RGBColor[0.63647065, 0.72470575, 0.91352935], 4 -> 
         RGBColor[0.63647065, 0.72470575, 0.91352935]}}]]}, 
    TagBox[
     GraphicsGroupBox[
      GraphicsComplexBox[{{1.3333333333333333`, 0.}, {0.6666666666666667, 
