Cell["InfraFiberedGraphQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5472fc1e-55ce-4d62-a4f1-f4fc1504e170"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
