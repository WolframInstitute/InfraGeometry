Cell["\<\
A fibered graph need not have lifts. The vertices 2 and 4 have no neighbour \
in the other fiber, so it is not a fibration:\
\>", "ExampleText",ExpressionUUID->"4856cd95-4bf7-42be-bda9-45081e9f388d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"Graph", "[", 
        RowBox[{
         RowBox[{"Range", "[", "4", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", " ", "<->", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<q\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<q\>\""}]}], "|>"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraFiberedGraphQ", "[", "fib", "]"}], ",", " ", 
        RowBox[{"InfraFibrationQ", "[", "fib", "]"}]}], "}"}]}], ",", "\n", 
     "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3e006e75-8b03-4aa2-a71a-243b5f070333"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3, 4}, {Null, {{1, 3}}}, {
      GraphLayout -> {"Dimension" -> 2}, ImageSize -> Medium, 
       PlotLabel -> {True, False}, 
       VertexCoordinates -> {{1.3333333333333333`, 0.}, {0.6666666666666667, 
        0.}, {-0.6666666666666667, 0.}, {-1.3333333333333333`, 0.}}, 
       VertexStyle -> {
        2 -> RGBColor[0.9057646, 0.6405292, 0.55], 1 -> 
         RGBColor[0.9057646, 0.6405292, 0.55], 3 -> 
         RGBColor[0.63647065, 0.72470575, 0.91352935], 4 -> 
         RGBColor[0.63647065, 0.72470575, 0.91352935]}}]]}, 
    TagBox[
     GraphicsGroupBox[
      GraphicsComplexBox[{{1.3333333333333333`, 0.}, {0.6666666666666667, 
       0.}, {-0.6666666666666667, 0.}, {-1.3333333333333333`, 0.}}, {
        {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], 
         {Arrowheads[0.], ArrowBox[{1, 3}, 0.027800407331975557`]}}, 
        {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
         {RGBColor[0.9057646, 0.6405292, 0.55], 
          DiskBox[1, 0.027800407331975557]}, 
         {RGBColor[0.9057646, 0.6405292, 0.55], 
          DiskBox[2, 0.027800407331975557]}, 
         {RGBColor[0.63647065, 0.72470575, 0.91352935], 
          DiskBox[3, 0.027800407331975557]}, 
         {RGBColor[0.63647065, 0.72470575, 0.91352935], 
          DiskBox[4, 0.027800407331975557]}}}]],
     MouseAppearanceTag["NetworkGraphics"]],
    AllowKernelInitialization->False]],
  DefaultBaseStyle->"NetworkGraphics",
  FormatType->TraditionalForm,
  FrameTicks->None,
  ImageSize->Medium,
  PlotLabel->FormBox[
    RowBox[{"{", 
      RowBox[{"True", ",", "False"}], "}"}], TraditionalForm]]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"02818fd1-27bb-4ee6-84c9-6a51213c77f9"]
}, Open  ]],

