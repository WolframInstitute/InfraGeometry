         {Arrowheads[0.], ArrowBox[{1, 3}, 0.027800407331975557`]}}, 
        {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
         {RGBColor[0.9057646, 0.6405292, 0.55], 
          DiskBox[1, 0.027800407331975557]}, 
         {RGBColor[0.9057646, 0.6405292, 0.55], 
          DiskBox[2, 0.027800407331975557]}, 
         {RGBColor[0.63647065, 0.72470575, 0.91352935], 
          DiskBox[3, 0.027800407331975557]}, 
