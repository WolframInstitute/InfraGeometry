Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"Graph", "[", " ", 
        RowBox[{
         RowBox[{"Range", "[", " ", "4", " ", "]"}], ",", " ", 
         RowBox[{"{", " ", 
          RowBox[{"UndirectedEdge", "[", " ", 
           RowBox[{"1", ",", " ", "3"}], " ", "]"}], " ", "}"}]}], " ", "]"}],
        ",", " ", 
       RowBox[{"<|", " ", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<q\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<q\>\""}]}], " ", "|>"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", " ", "fib", " ", "]"}], ",", 
     " ", 
     RowBox[{"InfraFiberedGraphQ", "[", " ", "fib", " ", "]"}], ",", " ", 
     RowBox[{"InfraFibrationQ", "[", " ", "fib", " ", "]"}]}], " ", "}"}]}], 
  " ", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b7cc7c38-e16e-4432-a920-97930f1cbb67"],

