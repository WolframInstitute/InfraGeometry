Cell["\<\
The square grid with the projection to its columns, and the tangent bundle of \
a grid:\
\>", "ExampleText",ExpressionUUID->"faf87eb4-0c55-4cef-8b52-fa6be22d0465"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"columns", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"Round", " ", "@", " ", 
        RowBox[{
         RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraFiberedGraphQ", "[", 
      RowBox[{"InfraFiberedGraph", "[", 
       RowBox[{"g", ",", " ", "columns"}], "]"}], "]"}], ",", "\n", "   ", 
     RowBox[{"InfraFiberedGraphQ", "[", 
      RowBox[{"InfraTangentBundle", "[", 
       RowBox[{
        RowBox[{"GridGraph", "[", 
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", "2"}], "]"}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3edd79f8-21e1-450f-809a-fa1a60b76fb0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"09b33e84-18f3-433b-9729-fe2a96047562"]
}, Open  ]]
}, Open  ]],

