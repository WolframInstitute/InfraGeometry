Cell["\<\
The square grid with the projection to its columns, and the tangent bundle of \
a grid:\
\>", "ExampleText",ExpressionUUID->"0a270592-5b55-4dd1-83ad-4648b08d88bd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"columns", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"Round", " ", "@", " ", 
        RowBox[{
         RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraFiberedGraphQ", "[", 
      RowBox[{"InfraFiberedGraph", "[", 
       RowBox[{"g", ",", " ", "columns"}], "]"}], "]"}], ",", "\n", "   ", 
     RowBox[{"InfraFiberedGraphQ", "[", 
      RowBox[{"InfraTangentBundle", "[", 
       RowBox[{
        RowBox[{"GridGraph", "[", 
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", "2"}], "]"}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fe2934e0-3036-4d19-8f3d-b740f870f2db"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2147cde9-1fb6-48cd-a4b4-b8937441ed47"]
}, Open  ]]
}, Open  ]],

