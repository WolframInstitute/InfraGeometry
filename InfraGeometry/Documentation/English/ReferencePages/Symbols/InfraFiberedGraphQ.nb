Cell["\<\
The square grid with the projection to its columns, and the tangent bundle of \
a grid:\
\>", "ExampleText",ExpressionUUID->"9d2840db-24bc-4ca8-a0b1-41825237ed41"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"columns", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"Round", " ", "@", " ", 
        RowBox[{
         RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraFiberedGraphQ", "[", 
      RowBox[{"InfraFiberedGraph", "[", 
       RowBox[{"g", ",", " ", "columns"}], "]"}], "]"}], ",", "\n", "   ", 
     RowBox[{"InfraFiberedGraphQ", "[", 
      RowBox[{"InfraTangentBundle", "[", 
       RowBox[{
        RowBox[{"GridGraph", "[", 
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", "2"}], "]"}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b0319df5-7f47-4674-afc1-0cc5e73793f1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"88072ea3-a56d-4a3a-9f39-dfca4d516d3c"]
}, Open  ]],

Cell["\<\
A string is not a map, and the object is not a fibered graph, nor a fibration:\
\>", "ExampleText",ExpressionUUID->"36788e85-eb68-4635-8765-a1283c27f779"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "4", "]"}], ",", " ", "\"\<bad\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraFiberedGraphQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"8d25973e-e09a-4580-b58e-69008c0e5848"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"9a95c188-1001-4bb7-8510-4ca1dcfa722e"]
}, Open  ]]
}, Open  ]],

