Cell["\<\
A segment on a grid and its support thickened by one step: 9 vertices, then \
21.\
\>", "ExampleText",ExpressionUUID->"1b9c3aeb-8ec2-478b-ba19-506d449637bf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"41", ",", " ", "61"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"VertexList", " ", "@", " ", 
          RowBox[{"InfraSubgraph", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"seg", " ", "->", " ", "1"}]}], "]"}]}], ",", " ", 
         "seg"}], "}"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"VertexCount", " ", "@", " ", 
      RowBox[{"InfraSubgraph", "[", 
       RowBox[{"g", ",", " ", "seg"}], "]"}]}], ",", " ", 
     RowBox[{"VertexCount", " ", "@", " ", 
      RowBox[{"InfraSubgraph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"seg", " ", "->", " ", "1"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2de9e0bb-1d1d-4f6e-890f-3def2dd127b3"],

