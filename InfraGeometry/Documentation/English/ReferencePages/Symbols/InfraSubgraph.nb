Cell[TextData[{
 "Same as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", "\"\<Subgraph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6897b8da-a7bb-437c-8f0f-fcdf1cc7dd3a"],
 "; the support itself is ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Keys",
    BaseStyle->"Link"], " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{
     StyleBox["graph", "TI"], ",", " ", 
     StyleBox["obj", "TI"], ",", " ", "\"\<VertexDensity\>\""}], "]"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d94f8340-fd63-4521-b401-364af675ec1f"],
 ". Works on ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "71743038-8d48-4359-b616-ba0b64b63d94"],
 " and ",
