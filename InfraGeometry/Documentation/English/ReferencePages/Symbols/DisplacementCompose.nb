Cell[TextData[{
 "A bijection composed with its inverse is the identity, which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementPlot"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementPlot", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4b78b2b0-7c9c-4789-a291-4a9cb7768d2b"],
 " draws as the bare graph."
}], "ExampleText",ExpressionUUID->"2842094a-d52f-40fd-a012-aa5233101f5d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rotation", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"identity", " ", "=", " ", 
     RowBox[{"DisplacementCompose", "[", 
      RowBox[{"rotation", ",", " ", 
       RowBox[{"DisplacementInverse", "[", "rotation", "]"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", "identity"}], "]"}], ",", " ", 
     RowBox[{"identity", " ", "===", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{"List", ",", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"08a8c7ec-b75b-4e5f-9071-cc5b0fcf6e12"],

