Notebook[{

Cell[CellGroupData[{
Cell["DisplacementCompose", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2763633a-2d06-4ed0-8103-a74969114e30"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementCompose"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementCompose", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"], ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71b724ef-f721-4406-a75b-f39ef92b8b8f"],
 "\[LineSeparator]",
 "composes the displacements as flows, ",
 StyleBox["d1", "TI"],
 " acting first: the value at ",
 StyleBox["v", "TI"],
 " collects the values of ",
 StyleBox["d2", "TI"],
 " at every vertex of ",
 StyleBox["d1", "TI"],
 "(",
 StyleBox["v", "TI"],
 "), and so on.",
 "\n"
}], "Usage",ExpressionUUID->"63749a43-bcf3-4a72-8b4c-5a4f8077b1a2"],

Cell[TextData[{
 "Definition: a displacement is a map ",
 StyleBox["D", "TI"],
 " from the vertices to sets of vertices, given as an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c795b62f-3f0d-40ed-8130-42516a1a9b3d"],
 " ",
 StyleBox["v", "TI"],
 " -> {",
 StyleBox["w1", "TI"],
 ", ",
 StyleBox["w2", "TI"],
 ", \[Ellipsis]}. The composite of ",
 StyleBox["D1", "TI"],
 " and ",
 StyleBox["D2", "TI"],
 " is the relation composite ",
 StyleBox["(D2 \[SmallCircle] D1)(v) = \:222a { D2(u) : u \[Element] D1(v) }",
   "TI"],
 ". More arguments compose from the left: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementCompose"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementCompose", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"], ",", " ", 
    StyleBox["d3", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c917747-c740-44bb-9d2b-863e4e382d64"],
 " is ",
 StyleBox["D3 \[SmallCircle] D2 \[SmallCircle] D1", "TI"],
 "."
}], "Notes",ExpressionUUID->"9038a44b-0a56-4f20-b4bf-d5799dd8bcd7"],

Cell[TextData[{
 "Composition needs no graph. It is associative, the identity ",
 StyleBox["v", "TI"],
 " -> {",
 StyleBox["v", "TI"],
 "} is its unit, and it is not commutative. A composite of single-valued \
displacements is single-valued."
}], "Notes",ExpressionUUID->"ca897df2-236c-4c4b-ac0a-88710b4e7aa1"],

Cell[TextData[{
 "Composition is not addition. For the flows of two vector fields the Baker\
\[Dash]Campbell\[Dash]Hausdorff formula gives ",
 StyleBox["\[CapitalPhi]_Y \[SmallCircle] \[CapitalPhi]_X = exp(X + Y + [X, \
Y]/2 + \[CenterEllipsis])", "TI"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementSum"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementSum", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fcb3eccd-8566-4742-a01c-91c1a2ff8e86"],
 " removes the bracket term by taking the midpoints of the two orders, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementCommutator"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementCommutator", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cd5a325e-fcc6-420d-a1d1-782b073c8b51"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementBracket"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementBracket", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "63e4bff5-dff1-4cc0-b356-00d558d84bbe"],
 " measure it."
}], "Notes",ExpressionUUID->"d3a59859-ccd2-42b4-bfb3-d6b65fd75719"],

Cell[TextData[{
 "The magnitude is subadditive, ",
 StyleBox["\:2016D2 \[SmallCircle] D1\:2016 \[LessEqual] \:2016D1\:2016 + \
\:2016D2\:2016", "TI"],
 ", by the triangle inequality (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementMagnitude"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementMagnitude", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b0ffa21b-1f25-438f-9301-94243f0a3291"],
 ")."
}], "Notes",ExpressionUUID->"ca17bc38-7eab-4659-9f99-a9437a1806b3"],

Cell[TextData[{
 "The keys of the composite are the keys of ",
 StyleBox["d1", "TI"],
 ". Each later displacement needs a value at every vertex the earlier ones \
reach."
}], "Notes",ExpressionUUID->"9c50092a-da97-48b3-8dc9-2376dd391bd6"]
}, Open  ]],

