Cell["\<\
The order matters. The rotation of the 12-cycle followed by a reflection, and \
the reflection followed by the rotation, are reflections about different axes.\
\>", "ExampleText",ExpressionUUID->"47d5f7d1-1eb3-4ae3-86cc-ed26b1916a78"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rotation", " ", "=", " ", 
      RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"reflection", " ", "=", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"2", " ", "-", " ", "#"}], ",", " ", "12", ",", " ", 
            "1"}], "]"}], "}"}], " ", "&"}], ",", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"DisplacementPlot", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"DisplacementCompose", "[", 
           RowBox[{"rotation", ",", " ", "reflection"}], "]"}]}], "]"}], ",", 
        " ", 
        RowBox[{"DisplacementPlot", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"DisplacementCompose", "[", 
           RowBox[{"reflection", ",", " ", "rotation"}], "]"}]}], "]"}]}], 
       "}"}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"DisplacementCompose", "[", 
       RowBox[{"rotation", ",", " ", "reflection"}], "]"}], " ", "===", " ", 
      RowBox[{"DisplacementCompose", "[", 
       RowBox[{"reflection", ",", " ", "rotation"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fcce9311-fe10-4c96-ae7e-4a2c57655c88"],

