Cell["\<\
The magnitude is subadditive. Two random displacements of the mesh, of \
magnitudes 1 and 2, and their composite:\
\>", "ExampleText",ExpressionUUID->"a47465b2-8f72-477d-a57e-04de543dda80"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"d1", " ", "=", " ", 
      RowBox[{"RandomDisplacement", "[", 
       RowBox[{"g", ",", " ", "1", ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], ",", " ", 
     RowBox[{"d2", " ", "=", " ", 
      RowBox[{"RandomDisplacement", "[", 
       RowBox[{"g", ",", " ", "2", ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"DisplacementMagnitude", "[", 
      RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"d1", ",", " ", "d2", ",", " ", 
      RowBox[{"DisplacementCompose", "[", 
       RowBox[{"d1", ",", " ", "d2"}], "]"}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3de28948-3b10-4193-9d4e-7a3c3036b9ff"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"25bc9ab6-3aa4-4976-bf7e-c3e9e2e0478d"]
}, Open  ]],

Cell["\<\
The composite of 1-continuous single-valued displacements is 1-continuous and \
single-valued:\
\>", "ExampleText",ExpressionUUID->"61dfcdf3-d02c-4eca-8d1d-f9708c79ec10"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"d", " ", "=", " ", 
     RowBox[{"DisplacementCompose", "[", 
      RowBox[{
       RowBox[{"RandomDisplacement", "[", 
        RowBox[{"g", ",", " ", "1", ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       RowBox[{"RandomDisplacement", "[", 
        RowBox[{"g", ",", " ", "2", ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ContinuousDisplacementQ", "[", 
      RowBox[{"g", ",", " ", "d"}], "]"}], ",", " ", 
     RowBox[{"DisplacementSingleValuedQ", "[", "d", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"0363cc2c-2bf5-4783-ae8a-86187e4863ba"],

