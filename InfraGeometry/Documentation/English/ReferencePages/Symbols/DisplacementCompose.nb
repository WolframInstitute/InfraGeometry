Cell["\<\
The magnitude of a composite is at most the sum of the magnitudes. Two random \
displacements of the square tiling, of magnitudes 2 and 1, compose to \
magnitude 3.\
\>", "ExampleText",ExpressionUUID->"26947baa-b307-4528-82d0-fc1385d8af28"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"first", " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"RandomDisplacement", "[", 
         RowBox[{"g", ",", " ", "2"}], "]"}]}], ")"}]}], ",", " ", 
     RowBox[{"second", " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
        RowBox[{"RandomDisplacement", "[", 
         RowBox[{"g", ",", " ", "1"}], "]"}]}], ")"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"DisplacementCompose", "[", 
        RowBox[{"first", ",", " ", "second"}], "]"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"DisplacementMagnitude", "[", 
      RowBox[{"g", ",", " ", "first"}], "]"}], ",", " ", 
     RowBox[{"DisplacementMagnitude", "[", 
      RowBox[{"g", ",", " ", "second"}], "]"}], ",", " ", 
     RowBox[{"DisplacementMagnitude", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"DisplacementCompose", "[", 
        RowBox[{"first", ",", " ", "second"}], "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a82d0b9c-77d3-4ce7-9532-471c21ae5406"],

