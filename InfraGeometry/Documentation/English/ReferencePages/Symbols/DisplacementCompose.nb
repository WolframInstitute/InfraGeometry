Cell["\<\
On the 12-cycle the least symmetry is the rotation by one step. Three of them \
compose to the rotation by three steps, blue and orange.\
\>", "ExampleText",ExpressionUUID->"ef1fab29-a220-4bdb-bbc4-7f7429f37520"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rotation", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"composite", " ", "=", " ", 
     RowBox[{"DisplacementCompose", "[", 
      RowBox[{"rotation", ",", " ", "rotation", ",", " ", "rotation"}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"rotation", ",", " ", "composite"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"composite", "[", "1", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"28e21155-2770-4701-9fa7-2d918b927c99"],

