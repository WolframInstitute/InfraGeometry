Cell["\<\
Values collect over every intermediate vertex. Two outward steps reach every \
vertex two steps further out: from the centre of the square tiling the eight \
vertices at distance 2, from the vertex 12, off the axes, three vertices. The \
composite is drawn at these two vertices only.\
\>", "ExampleText",ExpressionUUID->"911e8219-afc4-41cb-97db-61cd1fa9ef7a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"radial", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"PolarDisplacements", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"twoSteps", " ", "=", " ", 
     RowBox[{"DisplacementCompose", "[", 
      RowBox[{"radial", ",", " ", "radial"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"KeyTake", "[", 
        RowBox[{"twoSteps", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "12"}], 
          "}"}]}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"twoSteps", "[", "12", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5f3dce04-7faa-45c1-aeb8-f3cae3c519f1"],

