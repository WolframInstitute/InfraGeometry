Cell["\<\
The step right followed by the step up, on the square grid and on the square \
mesh:\
\>", "ExampleText",ExpressionUUID->"9d7da050-7ba6-4e49-bc3b-359b5fdfd882"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"KeyValueMap", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name", ",", " ", "s"}], "}"}], " ", "|->", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"DisplacementPlot", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"DisplacementCompose", "[", 
          RowBox[{
           RowBox[{"TranslationDisplacement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", 
              RowBox[{"s", ",", " ", "0"}], "}"}]}], "]"}], ",", " ", 
           RowBox[{"TranslationDisplacement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "s"}], "}"}]}], "]"}]}], "]"}]}], 
        "]"}]}], "]"}]}], ",", "\n", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<SquareGridGraph\>\"", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"\"\<SquareMeshGraph\>\"", " ", "->", " ", 
       RowBox[{"1", "/", "8"}]}]}], "|>"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"55063449-386e-402d-bc2c-19867365a949"],

