Cell["\<\
Values collect over the intermediate vertices. Two outward radial steps from \
the centre of the grid reach the 8 vertices at distance 2:\
\>", "ExampleText",ExpressionUUID->"26da1f5e-495d-45ba-9236-b4dcab183466"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"radial", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"PolarDisplacements", "[", 
       RowBox[{"g", ",", " ", "c"}], "]"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"twoSteps", " ", "=", " ", 
     RowBox[{"DisplacementCompose", "[", 
      RowBox[{"radial", ",", " ", "radial"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"KeyTake", "[", 
      RowBox[{"twoSteps", ",", " ", 
       RowBox[{"{", "c", "}"}]}], "]"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Length", "[", 
       RowBox[{"twoSteps", "[", "c", "]"}], "]"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"95b78228-b551-445b-945e-2766752def10"],

