Cell["\<\
The order matters. The steps right and up commute on the grid except at 2 \
vertices of the rim; on the mesh the two orders differ at 51 of the 102 \
vertices, drawn in red:\
\>", "ExampleText",ExpressionUUID->"739e8271-d4f7-448e-b8ed-f6afa0bcb5a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"KeyValueMap", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name", ",", " ", "s"}], "}"}], " ", "|->", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"right", " ", "=", " ", 
          RowBox[{"TranslationDisplacement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"s", ",", " ", "0"}], "}"}]}], "]"}]}], ",", " ", 
         RowBox[{"up", " ", "=", " ", 
          RowBox[{"TranslationDisplacement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "s"}], "}"}]}], "]"}]}]}], "}"}], ",", 
       "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"differ", " ", "=", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"DisplacementCompose", "[", 
               RowBox[{"right", ",", " ", "up"}], "]"}], "[", "#", "]"}], " ",
              "=!=", " ", 
             RowBox[{
              RowBox[{"DisplacementCompose", "[", 
               RowBox[{"up", ",", " ", "right"}], "]"}], "[", "#", "]"}]}], 
            " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"InfraSubstrateHighlight", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", "differ", "}"}], ",", " ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"Length", "[", "differ", "]"}]}]}], "]"}]}], "]"}]}], ",", 
    "\n", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<SquareGridGraph\>\"", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"\"\<SquareMeshGraph\>\"", " ", "->", " ", 
       RowBox[{"1", "/", "8"}]}]}], "|>"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"19eb4600-2ccd-4a41-ab3a-f5e0deb4991a"],

