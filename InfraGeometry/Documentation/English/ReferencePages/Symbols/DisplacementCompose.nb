Notebook[{

Cell[CellGroupData[{
Cell["DisplacementCompose", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"77619901-10d9-41d2-a81a-94eb3271fdf0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementCompose"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementCompose", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d8d131d-f324-4a0b-ab1b-24c90ae1bc79"],
 "\[LineSeparator]",
 "is the composite of the displacements, ",
 StyleBox["d1", "TI"],
 " acting first.",
 "\n"
}], "Usage",ExpressionUUID->"dd909c2c-84d9-45ac-9f93-3e9dfa99c395"],

Cell[TextData[{
 "The composite is ",
 StyleBox["(D\:2082 \[SmallCircle] D\:2081)(v) = \[Union] {D\:2082(u) : u \
\[Element] D\:2081(v)}", "TI"],
 ": the values collect over every intermediate vertex. More arguments compose \
in turn, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementCompose"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementCompose", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"], ",", " ", 
    StyleBox["d3", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b84ce91b-248a-44dc-be78-63e7195009b3"],
 " = ",
 StyleBox["D\:2083 \[SmallCircle] D\:2082 \[SmallCircle] D\:2081", "TI"],
 "."
}], "Notes",ExpressionUUID->"237df119-ecbc-44c6-b49e-aa58d0cc3026"],

Cell[TextData[{
 "Composition needs no graph. It is associative, the identity ",
 StyleBox["v", "TI"],
 " -> {",
 StyleBox["v", "TI"],
 "} is its unit, and it is not commutative."
}], "Notes",ExpressionUUID->"4d835215-656b-4782-adda-7a83fe52f11d"],

Cell[TextData[{
 "A composite of single-valued displacements is single-valued, and a \
composite of 1-continuous displacements is 1-continuous (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ContinuousDisplacementQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ContinuousDisplacementQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "96c331ac-ad9a-428e-baec-02183b67b060"],
 ")."
}], "Notes",ExpressionUUID->"55892cfe-37fd-4373-b978-7e674612aee3"],

Cell[TextData[{
 "The magnitude is subadditive, ",
 StyleBox["\:2016D\:2082 \[SmallCircle] D\:2081\:2016 \[LessEqual] \:2016D\
\:2081\:2016 + \:2016D\:2082\:2016", "TI"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementMagnitude"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementMagnitude", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8bae729e-6c9c-4ffe-95a3-137027d901fd"],
 ")."
}], "Notes",ExpressionUUID->"da669bf2-da33-4350-b1e3-5f7a84dc4fb8"],

Cell[TextData[{
 "Composition is not addition. For two flows the two orders differ by the \
bracket of the fields; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementSum"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementSum", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "000f0aa8-4f52-42be-b8dd-e3934382c4ef"],
 " takes the midpoints of the two orders, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementCommutator"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementCommutator", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2338486c-b353-40be-be96-4d87a2daf908"],
 " measures the difference."
}], "Notes",ExpressionUUID->"a3075430-c149-4d0b-81e3-2ee4b2c075ea"],

Cell[TextData[{
 "Each later displacement needs a value at every vertex the earlier ones \
reach. The keys of the composite are those of ",
 StyleBox["d1", "TI"],
 "."
}], "Notes",ExpressionUUID->"9e21be17-263b-4d93-93fc-6a3a6aaec31e"]
}, Open  ]],

