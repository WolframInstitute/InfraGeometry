Cell["\<\
The hull of two vertices of a path graph is the interval between them, and \
one round of two vertices is already the interval.\
\>", "ExampleText",ExpressionUUID->"f9db1c9a-f3a3-45fd-ab0c-e72618f1fc21"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"PathGraph", "[", 
      RowBox[{"Range", "[", "10", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Keys", " ", "@", " ", 
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraConvexHull", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "7"}], "}"}], ",", " ", "1"}], "]"}], ",", 
      " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6d1dc267-a86f-44ac-9072-f2d4291b3d69"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "4", ",", "5", ",", "6", ",", "7"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"87e221c6-8867-4593-b7d1-d1b9e1cd79ef"]
}, Open  ]],

Cell["\<\
The hull is geodesically convex: it is its own hull, and it contains every \
round.\
\>", "ExampleText",ExpressionUUID->"0d5301b2-ddec-4c12-baab-e9178a7163bd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"7", ",", " ", "7"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"hull", " ", "=", " ", 
     RowBox[{"RandomInfraConvexHull", "[", " ", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraConvexHull", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "6", ",", " ", "40"}], "}"}], "]"}]}], " ", 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"RandomInfraConvexHull", "[", " ", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraConvexHull", "[", "hull", "]"}]}], " ", "]"}], " ", "===",
       " ", "hull"}], ",", " ", 
     RowBox[{"SubsetQ", "[", 
      RowBox[{"hull", ",", " ", 
       RowBox[{"RandomInfraConvexHull", "[", " ", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraConvexHull", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "6", ",", " ", "40"}], "}"}], ",", " ", 
           "1"}], "]"}]}], " ", "]"}]}], "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b8bdb553-bf3e-4d28-a00c-2b3aa28f8225"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"569f2ef1-fd7f-4e55-8d15-1dacb2413683"]
}, Open  ]],

Cell["\<\
The convex hull and the ball hull of the same pair on the 7 \[Times] 7 grid.\
\>", "ExampleText",ExpressionUUID->"681e4022-68ca-4fc1-b199-857104f0ab0d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"7", ",", " ", "7"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"#", ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "6"}], "}"}]}], "}"}]}], "]"}], " ", "&"}], 
     " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraConvexHull", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "6"}], "}"}], "]"}], ",", " ", 
       RowBox[{"InfraBallHull", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "6"}], "}"}], "]"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"25c5100a-ff4e-40c0-8489-cb95a52eb128"],

