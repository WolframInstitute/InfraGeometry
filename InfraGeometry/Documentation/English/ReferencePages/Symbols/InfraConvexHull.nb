Cell["On the grid the hull is the bounding box of the points:", "ExampleText",ExpressionUUID->"fc07dbe7-17c3-4a91-95e7-8f278dcbc9d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"pts", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{"c", ",", " ", "6"}], "]"}], ",", " ", "3", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"xy", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"Round", "[", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}], "]"}]}], "]"}]}], "}"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"ranges", " ", "=", " ", 
     RowBox[{"MinMax", " ", "/@", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"xy", " ", "/@", " ", "pts"}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"And", " ", "@@", " ", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"IntervalMemberQ", "[", 
            RowBox[{
             RowBox[{"Interval", "[", "#2", "]"}], ",", " ", "#1"}], "]"}], 
           " ", "&"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"xy", "[", "#", "]"}], ",", " ", "ranges"}], "}"}]}], 
         "]"}]}], " ", "&"}]}], "]"}], " ", "===", "\n", "    ", 
    RowBox[{"Keys", " ", "@", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraConvexHull", "[", "pts", "]"}], ",", 
       " ", "\"\<VertexDensity\>\""}], "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7dd52059-6439-4b5c-91da-5135a82e55d5"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"cd1fce6e-cf41-4f92-b0d0-fba14f3cccf7"]
}, Open  ]],

Cell["The hull is its own hull and contains every round:", "ExampleText",ExpressionUUID->"9f4764d5-1fc3-47b3-b07e-f30cfd4a3d3a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"pts", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", "4", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"hull", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraConvexHull", "[", "pts", "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraConvexHull", "[", "hull", "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], "]"}]}], " ", "===", " ", "hull"}], ",",
      "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"SubsetQ", "[", 
         RowBox[{"hull", ",", " ", 
          RowBox[{"Keys", " ", "@", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraConvexHull", "[", 
              RowBox[{"pts", ",", " ", "#"}], "]"}], ",", 
             " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}], " ", "&"}]}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"953daa90-69bf-4746-a3d4-373f5ddc28ce"],

