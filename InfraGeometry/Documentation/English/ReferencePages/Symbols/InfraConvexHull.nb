Cell["\<\
The rounds 0, 1 and 2 of the interval closure of three vertices of the shell \
of radius 5, on the irregular mesh, the square grid and the hexagonal tiling.\
\
\>", "ExampleText",ExpressionUUID->"725787e2-cfa6-4819-881b-37b02d3779d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Large\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"shell", " ", "=", " ", 
        RowBox[{"FindInfraShell", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "5"}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"seeds", " ", "=", " ", 
        RowBox[{"shell", "[", 
         RowBox[{"[", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", 
            RowBox[{"Round", "[", 
             RowBox[{
              RowBox[{"Length", "[", "shell", "]"}], " ", "/", " ", "3"}], 
             "]"}], ",", " ", 
            RowBox[{"Round", "[", 
             RowBox[{"2", " ", 
              RowBox[{
               RowBox[{"Length", "[", "shell", "]"}], " ", "/", " ", "3"}]}], 
             "]"}]}], "}"}], " ", "]"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraConvexHull", "[", 
           RowBox[{"seeds", ",", " ", "round"}], "]"}], ",", " ", "seeds"}], 
         "}"}], ",", " ", 
        RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "17"}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"round", ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1", ",", " ", "2"}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"54f2bd6a-abb4-40be-9f55-d97b417bd860"],

