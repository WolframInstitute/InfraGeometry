Notebook[{

Cell[CellGroupData[{
Cell["InfraConvexHull", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2a39faf3-63f0-4c28-aeb1-cd3f4447277c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraConvexHull"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraConvexHull", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"S", ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8ef7b94-647e-4faa-a39b-1586e8407974"],
 "\[LineSeparator]",
 "is the ",
 StyleBox["k", "TI"],
 "-th round of the interval closure of ",
 StyleBox["S", "TI"],
 ": round 0 is ",
 StyleBox["S", "TI"],
 ", and each round adds every shortest path between two of its vertices. It \
is a symbolic object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c2115f80-ea45-40ae-80cc-7fce5864353b"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraConvexHull"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraConvexHull", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5f2f3490-3617-4118-8166-49a90ad7a87e"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b60bd0a3-ea38-4a86-8626-35516daaaf46"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraConvexHull"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraConvexHull", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "S", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e238d407-b662-4997-ab4d-5a5010097d1c"],
 "\[LineSeparator]",
 "is the convex hull: the fixed point of the rounds, the smallest set \
containing ",
 StyleBox["S", "TI"],
 " and every shortest path between two of its vertices."
}], "Usage",ExpressionUUID->"c0dbba37-800c-4fce-a007-d2bea696f2c9"],

Cell[TextData[{
 "Definition: with the metric interval ",
 StyleBox["I(u, v) = {w : d(u, w) + d(w, v) = d(u, v)}", "TI"],
 ", round ",
 StyleBox["k + 1", "TI"],
 " of ",
 StyleBox["S", "TI"],
 " is the union of the intervals ",
 StyleBox["I(u, v)", "TI"],
 " over the vertices ",
 StyleBox["u, v", "TI"],
 " of round ",
 StyleBox["k", "TI"],
 ". ",
 StyleBox["S", "TI"],
 " is read as the core of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTube"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1d281cd4-4ce3-4c84-9aa4-f6387740b286"],
 " is: a vertex, a vertex list, a density, a subgraph, or a Euclidean head \
through its support."
}], "Notes",ExpressionUUID->"301b7ca6-1809-4036-b1a9-f916ff731b49"],

Cell[TextData[{
 "A set that is its own hull is ",
 StyleBox["geodesically convex", "TI"],
 "; this is the test that takes the place of a predicate."
}], "Notes",ExpressionUUID->"7d5e0ce6-2610-4ed4-951d-c1b54bba46c6"],

Cell["\<\
The rounds increase and are bounded by the graph, so the convex hull is \
reached after finitely many. On the substrates below it is reached after two \
rounds; on the Petersen graph it takes three.\
\>", "Notes",ExpressionUUID->"919ebb91-1384-4b93-b6de-95a88579c772"],

Cell[TextData[{
 "The head computes nothing. A hull has one member, the vertex set. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "257edca0-4899-4651-8d22-336185a1bf82"],
 " reads ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e9a86f0-f523-4d26-afc5-331152713cb3"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00385eed-d388-4e80-b134-26e029bcfbdb"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bee39cd-1fb1-45ba-9dc0-b53a211bb150"],
 ", ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f107eb6d-4328-4130-873e-71988c003944"],
 " and ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb149488-01a1-462d-97c9-3d682fb29cd3"],
 ", and the two measures; all rounds are read off one distance matrix."
}], "Notes",ExpressionUUID->"9d583032-c486-400b-932c-1c3f954cd3a1"]
}, Open  ]],

