Cell[CellGroupData[{
Cell["InfraConvexHull", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"83ae98d7-9be0-41d1-90ee-3a76f439e59f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraConvexHull"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraConvexHull", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "S", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5d231dc-eefc-4400-b96e-bbcb36d96167"],
 "\[LineSeparator]",
 "is the convex hull of the vertex set ",
 StyleBox["S", "TI"],
 ": the smallest set that contains ",
 StyleBox["S", "TI"],
 " and every shortest path between two of its vertices.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3be08de3-2542-423b-8677-3dd851efa877"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraConvexHull"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraConvexHull", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"S", ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0935d109-67f0-42f9-a43c-4c4ca6c82cc0"],
 "\[LineSeparator]",
 "is the ",
 StyleBox["k", "TI"],
 "-th round of the interval closure of ",
 StyleBox["S", "TI"],
 "."
}], "Usage",ExpressionUUID->"b4933396-c44b-4810-a576-aeebd3f4dd02"],

Cell[TextData[{
 "With the interval ",
 StyleBox["I(u, v) = {w : d(u, w) + d(w, v) = d(u, v)}", "TI"],
 ", round 0 is ",
 StyleBox["S", "TI"],
 " and round ",
 StyleBox["k + 1", "TI"],
 " is the union of the intervals ",
 StyleBox["I(u, v)", "TI"],
 " over the vertices ",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 " of round ",
 StyleBox["k", "TI"],
 ". The rounds grow until they stop; the last one is the convex hull."
}], "Notes",ExpressionUUID->"719f27ec-ef4b-4d61-893e-8d58fd442143"],

Cell["A set equal to its convex hull is geodesically convex.", "Notes",ExpressionUUID->"72d4ab30-4357-4e10-ab44-683fe111a57d"],

Cell[TextData[{
 "On the square grid, away from the rim, the convex hull of ",
 StyleBox["S", "TI"],
 " is the smallest box with sides parallel to the axes that contains ",
 StyleBox["S", "TI"],
 ". On other graphs the hull can need several rounds, and it can jump: a few \
points of the mesh have a thin hull, one more point a thick one."
}], "Notes",ExpressionUUID->"ad52c7b7-25ae-4435-ae52-83584f15409b"],

Cell[TextData[{
 StyleBox["S", "TI"],
 " is a vertex, a vertex list, a density, a subgraph, or a geometric object \
through its vertices."
}], "Notes",ExpressionUUID->"c68363d9-4a4c-49ce-b2ac-bec5416fc368"],

