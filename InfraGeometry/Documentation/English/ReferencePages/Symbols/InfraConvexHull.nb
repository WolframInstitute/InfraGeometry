Cell["\<\
The sizes of the rounds of three vertices of the Petersen graph.\
\>", "ExampleText",ExpressionUUID->"e6e5fd83-0040-4cdf-9a8b-d9c716ad14fe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"PetersenGraph", "[", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"RandomInfraConvexHull", "[", " ", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraConvexHull", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "8"}], "}"}], ",", " ", 
          "#"}], "]"}]}], " ", "]"}]}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "4"}], "]"}]}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0d72e8de-6aa4-4797-973f-54aacfe8f141"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "6", ",", "9", ",", "10", ",", "10"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"9f1fbf26-3162-4b4f-b3bc-c726f2c4ca9d"]
}, Open  ]]
}, Open  ]],

