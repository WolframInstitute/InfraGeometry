Cell[CellGroupData[{
Cell["InfraLineQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bdb7d1d6-d842-45b7-b642-9cd445810f76"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLineQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d33b11c0-a54b-4890-8e5c-1c2b79214f82"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["walk", "TI"],
 " is a line in ",
 StyleBox["g", "TI"],
 ": a shortest path that no neighbour of either endpoint prolongs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"bd39d774-7d59-4423-8f9d-bf2121dcb94e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLineQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["lines", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "965e7fea-6d82-4bb1-90da-628fe86489c0"],
 "\[LineSeparator]",
 "tests every line of an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dc041625-8d15-4dd4-a84f-f6c462c6f4dc"],
 " bundle or pool."
}], "Usage",ExpressionUUID->"4d8cce54-e8f3-444c-92ae-5fbeb2245713"],

Cell[TextData[{
 "This is the legacy compatibility spelling. New code uses ",
 Cell[BoxData["InfraInfiniteLineQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5af3ca8-88e2-4bc5-9a7b-3941ba52271c"],
 "."
}], "Notes",ExpressionUUID->"65b72918-553f-49a9-af40-06fc9c2a45db"],

Cell[TextData[{
 "Two conditions: the sequence is a shortest path (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegmentQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "48eace62-7e14-4d68-90b5-56cb10dacef8"],
 "), and stepping off either end to a neighbour gives a walk that is no \
longer a shortest path \[LongDash] no neighbour of the first vertex lies one \
step farther from the last, and no neighbour of the last lies one step \
farther from the first. Both tests are single distance lookups."
}], "Notes",ExpressionUUID->"6e6ffd70-58dc-4d1d-886e-9b2dae0b9f2c"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "066024e4-03f8-40f7-b42a-71e50e962add"],
 "."
}], "Notes",ExpressionUUID->"e7c97d54-12b9-4df9-97a5-a5b342463dfb"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "75513181-e978-475e-aae0-e5d117b4c00d"],
 ", and every line that finder returns satisfies it under every ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd295ec0-42ea-4052-9594-62fb44329847"],
 "."
}], "Notes",ExpressionUUID->"2c387904-5ed2-4c46-a169-83d0ca545f1d"]
}, Open  ]],

