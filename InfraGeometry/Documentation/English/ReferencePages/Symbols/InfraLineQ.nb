Cell["\<\
On a path the whole graph is a line; any proper stretch is not, since it can \
still be prolonged.\
\>", "ExampleText",ExpressionUUID->"a1ed881b-1b30-411f-8eb3-49403c5634ce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"InfraLineQ", "[", 
    RowBox[{
     RowBox[{"PathGraph", "[", 
      RowBox[{"Range", "[", "5", "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "5"}], 
      "}"}]}], "]"}], ",", " ", 
   RowBox[{"InfraLineQ", "[", 
    RowBox[{
     RowBox[{"PathGraph", "[", 
      RowBox[{"Range", "[", "5", "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5aa10883-9754-4401-861b-e74ef7e05092"],

