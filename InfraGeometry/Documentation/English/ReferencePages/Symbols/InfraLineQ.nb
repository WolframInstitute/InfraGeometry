Cell[CellGroupData[{
Cell["InfraLineQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9e908677-a69d-4bdb-836b-4a8876845010"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLineQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b93fe1e-bcab-4ea5-83c5-23c09c4b66d0"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["walk", "TI"],
 " is a line in ",
 StyleBox["g", "TI"],
 ": a geodesic that no neighbour of either endpoint prolongs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6928d6d9-9304-42fb-a2cd-2413dd33781f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLineQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["lines", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "efcc3fef-13b5-4686-846c-150af5777dd8"],
 "\[LineSeparator]",
 "tests every line of an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3d7916ae-c23a-4d89-b2de-783cc55c1a6d"],
 " bundle or pool."
}], "Usage",ExpressionUUID->"fa81a2ce-8b9d-4001-8bec-899947da951b"],

Cell[TextData[{
 "Two conditions: the sequence is a geodesic (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegmentQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bfbfb80f-34d1-4797-a2f4-f92936a599ab"],
 "), and stepping off either end to a neighbour gives a walk that is no \
longer a shortest path \[LongDash] no neighbour of the first vertex lies one \
step farther from the last, and no neighbour of the last lies one step \
farther from the first. Both tests are single distance lookups."
}], "Notes",ExpressionUUID->"542bad97-36ef-4e20-a005-6feafb447418"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61e19d96-16f6-441d-9a82-8c0afe2c8e65"],
 "."
}], "Notes",ExpressionUUID->"6ebb4e1b-9741-4191-9004-13e5005638e1"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "13a2a25f-f7f2-4285-b652-9ea90bff34d2"],
 ", and every line that finder returns satisfies it under every ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0655d2d8-c657-4d06-9abd-c0788e24ee67"],
 "."
}], "Notes",ExpressionUUID->"9a7de66c-ffd4-4f62-8cf9-a783989a3b2c"]
}, Open  ]],

