      RowBox[{
      "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "5"}], 
      "}"}]}], "]"}], ",", " ", 
   RowBox[{"InfraLineQ", "[", 
    RowBox[{
     RowBox[{"PathGraph", "[", 
