Cell[CellGroupData[{
Cell["InfraLineQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d4f4c35d-8554-498e-b5e8-8a4b407cbe95"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLineQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36b3e3bd-8bf9-4313-83d8-2866ac66a228"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["walk", "TI"],
 " is a line in ",
 StyleBox["g", "TI"],
 ": a shortest path that no neighbour of either endpoint prolongs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"132f601b-577b-474b-bbae-7bcc3380ec54"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLineQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["lines", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7541724d-47e5-4ca1-bad3-2fbf2f991f9a"],
 "\[LineSeparator]",
 "tests every line of an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6df86e21-9420-46ab-b9d5-0e91c55f0a09"],
 " bundle or pool."
}], "Usage",ExpressionUUID->"c03dad8d-866f-4731-be46-e4cb27cb469c"],

Cell[TextData[{
 "Two conditions: the sequence is a shortest path (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegmentQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0ef720af-5cae-4999-8153-0551160f4eb0"],
 "), and stepping off either end to a neighbour gives a walk that is no \
longer a shortest path \[LongDash] no neighbour of the first vertex lies one \
step farther from the last, and no neighbour of the last lies one step \
farther from the first. Both tests are single distance lookups."
}], "Notes",ExpressionUUID->"18c89164-0dac-49a0-9987-a8f5ff423d6c"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46f83913-aa63-408c-83c4-ddfb0c0ef3f5"],
 "."
}], "Notes",ExpressionUUID->"47bbe572-dc00-4266-9ebd-129fc780c5df"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4ad43217-d9c6-4ebc-9f4d-20cfd2b30d63"],
 ", and every line that finder returns satisfies it under every ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a8917e9-0f81-4560-bdb1-58bcd4a63b4f"],
 "."
}], "Notes",ExpressionUUID->"8386ffe9-cfd6-464e-8b17-7cc5ca489ff3"]
}, Open  ]],

