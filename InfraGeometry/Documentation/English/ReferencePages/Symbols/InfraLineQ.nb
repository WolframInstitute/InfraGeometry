Cell[CellGroupData[{
Cell["InfraLineQ", "ObjectName",ExpressionUUID->"c21e5b12-cc7e-49ac-b547-d8e45303dd65"],

Cell["LLM generated.", "Notes",ExpressionUUID->"56ccb9af-f8ab-499b-8d4d-70c3143caaca"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"addbd7bf-34cb-4d95-8fed-cb40470a71d3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLineQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af34a1de-c7c4-436f-bf7e-c55e23740cc1"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["walk", "TI"],
 " is a line in ",
 StyleBox["g", "TI"],
 ": a shortest path that no neighbour of either endpoint prolongs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"644ee519-684b-4c89-a426-3523d831b600"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLineQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["lines", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "761581b4-eb74-45a2-9116-b70a5f885d97"],
 "\[LineSeparator]",
 "tests every line of an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "171d7994-a55f-47f6-b8a2-0198b672b2a0"],
 " bundle or pool."
}], "Usage",ExpressionUUID->"0ae986c7-a31c-4380-9fb9-0bbcd20da2fe"],

Cell[TextData[{
 "This is the legacy compatibility spelling. New code uses ",
 Cell[BoxData["InfraInfiniteLineQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3df94494-aae6-4f4d-ba68-e3d1fd4c9a6f"],
 "."
}], "Notes",ExpressionUUID->"023cfe09-1bc0-486c-b6ba-c14fc7275594"],

Cell[TextData[{
 "Two conditions: the sequence is a shortest path (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegmentQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "56a98782-840e-4d62-b5f5-5b57368a1cad"],
 "), and stepping off either end to a neighbour gives a walk that is no \
longer a shortest path \[LongDash] no neighbour of the first vertex lies one \
step farther from the last, and no neighbour of the last lies one step \
farther from the first. Both tests are single distance lookups."
}], "Notes",ExpressionUUID->"ed06bcd6-c9c2-412c-9943-c588122bf50b"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39267d16-b323-47a1-9bc5-df8ffe82cda9"],
 "."
}], "Notes",ExpressionUUID->"a9baa0aa-96d5-4709-9aa3-43d25c5c0315"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "897a1aa8-bd76-4b96-a945-0b368b1b1743"],
 ", and every line that finder returns satisfies it under every ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a196098c-cc90-4bd9-9f4c-2c80ac0f83f2"],
 "."
}], "Notes",ExpressionUUID->"b3b88134-45b6-406f-b2bd-d281b3301697"]
}, Open  ]],

