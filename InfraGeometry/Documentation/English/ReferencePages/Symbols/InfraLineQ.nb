Cell[CellGroupData[{
Cell["InfraLineQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3d179d58-d1af-4121-9237-035196e7cfa2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLineQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3867de67-60f9-4c4c-9aaf-8a2198c3c3d1"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["walk", "TI"],
 " is a line in ",
 StyleBox["g", "TI"],
 ": a geodesic that no neighbour of either endpoint prolongs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"fa4287ed-81ef-4ec7-b21b-723b558941ab"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLineQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["lines", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d20d0cbe-e7bb-4cc2-8f92-a6e6ef4318f2"],
 "\[LineSeparator]",
 "tests every line of an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3cda0208-f323-4ee3-8cd0-b150d005aa49"],
 " bundle or pool."
}], "Usage",ExpressionUUID->"a1112f29-6d1e-4639-95ff-b0b013be8be4"],

Cell[TextData[{
 "Two conditions: the sequence is a geodesic (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegmentQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6e1ba90d-1066-4237-9ae1-3f706a9e6e1a"],
 "), and stepping off either end to a neighbour gives a walk that is no \
longer a shortest path \[LongDash] no neighbour of the first vertex lies one \
step farther from the last, and no neighbour of the last lies one step \
farther from the first. Both tests are single distance lookups."
}], "Notes",ExpressionUUID->"18220139-3394-4b2a-be8e-617cbae171ac"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d7aab70b-ce28-46f8-b65e-5c47b8d728b1"],
 "."
}], "Notes",ExpressionUUID->"e44447e5-9edc-41fe-ac28-fdeb125c5b2c"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "861976a0-d83c-449f-ae77-096f13c9806d"],
 ", and every line that finder returns satisfies it under every ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f1c140e-7392-45be-88f3-7bc205cb5600"],
 "."
}], "Notes",ExpressionUUID->"7a94b50f-4ed1-4306-a9d2-64c1834d17f8"]
}, Open  ]],

