Cell["\<\
The gradient of the distance from the centre integrates to the coboundary of \
the distance, on the square grid and on the square mesh:\
\>", "ExampleText",ExpressionUUID->"f0d21364-6486-45e6-8b92-f4d66861d08c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
     
     RowBox[{
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"IntegrationMap", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"FormDifferential", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"ZeroForm", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{
              RowBox[{"GraphDistance", "[", 
               RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", 
              "&"}]}], "]"}]}], "]"}]}], "]"}]}], " ", "==", "\n", "      ", 
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"AssociationThread", "[", 
          RowBox[{
           RowBox[{"List", " ", "/@", " ", 
            RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c"}], "]"}]}], "]"}]}], "]"}]}]}]}], 
    "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", 
       " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5831b5e3-1d57-4d42-941f-62ffe7c73321"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7da4bac9-3f62-401f-beaf-3af9d4ba4b06"]
}, Open  ]],

Cell["\<\
On a random 1-form on the mesh the integral is the antisymmetric part across \
each edge:\
\>", "ExampleText",ExpressionUUID->"145489d7-8211-45c3-ba35-2b53aa620679"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"germ", " ", "=", " ", 
     RowBox[{"v", " ", "|->", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"List", " ", "/@", " ", 
         RowBox[{"AdjacencyList", "[", 
          RowBox[{"g", ",", " ", "v"}], "]"}]}], ",", " ", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"VertexDegree", "[", 
           RowBox[{"g", ",", " ", "v"}], "]"}]}], "]"}]}], "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"w", " ", "=", " ", 
     RowBox[{"BlockRandom", "[", 
      RowBox[{
       RowBox[{"AssociationMap", "[", 
        RowBox[{"germ", ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"iw", " ", "=", " ", 
     RowBox[{"IntegrationMap", "[", 
      RowBox[{"g", ",", " ", "w"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Sort", " ", "/@", " ", 
      RowBox[{"List", " ", "@@@", " ", 
       RowBox[{"EdgeList", "[", "g", "]"}]}]}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"CochainValue", "[", 
        RowBox[{"iw", ",", " ", "#"}], "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"FormValue", "[", 
           RowBox[{"w", ",", " ", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "}"}]}], "]"}], " ", "-", " ", 
          RowBox[{"FormValue", "[", 
           RowBox[{"w", ",", " ", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "}"}]}], "]"}]}], ")"}], "/", 
        "2"}]}], " ", "&"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"959e438c-ef2d-4772-b1a1-2742512efc71"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"ef67f6b6-b4cd-414a-b582-bb8ca1c1cf28"]
}, Open  ]]
}, Open  ]],

