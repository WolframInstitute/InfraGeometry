Cell[CellGroupData[{
Cell["IntegrationMap", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"824dfcf1-9248-4d1f-b1a7-97b34bad6707"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["IntegrationMap"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/IntegrationMap", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["\[Omega]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed118a9d-aaf2-462c-816b-1ed280be9c61"],
 "\[LineSeparator]",
 "gives the alternating cochain ",
 StyleBox["I\[Omega]", "TI"],
 " of the ",
 StyleBox["k", "TI"],
 "-form ",
 StyleBox["\[Omega]", "TI"],
 ": on each ",
 StyleBox["(k + 1)", "TI"],
 "-clique, the signed mean of the germs at its vertices.",
 "\n"
}], "Usage",ExpressionUUID->"29370fe0-aa11-4646-bea6-ae474d9d03d7"],

Cell[TextData[{
 StyleBox["(I\[Omega])(v\:2080, \[Ellipsis], v\:2096) = (1/(k + 1)) \
\[CapitalSigma]\:1d62 (\[Minus]1)\:2071 \[Omega](v\:1d62; v\:2080, \
\[Ellipsis], v\:0302\:1d62, \[Ellipsis], v\:2096)", "TI"],
 ", the sum over ",
 StyleBox["i = 0, \[Ellipsis], k", "TI"],
 ". ",
 StyleBox["I", "TI"],
 " maps the ",
 StyleBox["k", "TI"],
 "-forms to the ",
 StyleBox["k", "TI"],
 "-cochains."
}], "Notes",ExpressionUUID->"25fd708d-0cea-49ee-9253-1ab8a44e8f23"],

Cell[TextData[{
 "On a 1-form it is the antisymmetric part across each edge, ",
 StyleBox["(I\[Omega])(u, v) = (\[Omega](u; v) \[Minus] \[Omega](v; u))/2", 
  "TI"],
 ". On a 0-form it is the 0-cochain of the same values."
}], "Notes",ExpressionUUID->"60b8be4a-c764-427d-bd63-bd478c4146e0"],

