Cell[TextData[{
 StyleBox["I(R\[Alpha]) = \[Alpha]", "TI"],
 ": a random 1-cochain with values \[PlusMinus]1 and \[PlusMinus]2 against \
the integral of its restriction, edge by edge, on the diagonal."
}], "ExampleText",ExpressionUUID->"4ce92ec2-4a16-4eaf-a16b-be184a6b435a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cochain", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"AssociationMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"RandomChoice", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", " ", 
             RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "2"}], "}"}], "]"}],
           " ", "&"}], ",", " ", 
         RowBox[{"Sort", " ", "/@", " ", 
          RowBox[{"List", " ", "@@@", " ", 
           RowBox[{"EdgeList", "[", "g", "]"}]}]}]}], "]"}]}], ")"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"integral", " ", "=", " ", 
     RowBox[{"IntegrationMap", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"RestrictionMap", "[", 
        RowBox[{"g", ",", " ", "cochain"}], "]"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Values", "[", "cochain", "]"}], ",", " ", 
        RowBox[{"Lookup", "[", 
         RowBox[{"integral", ",", " ", 
          RowBox[{"Keys", "[", "cochain", "]"}], ",", " ", "0"}], "]"}]}], 
       "}"}], "]"}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Alpha]\>\"", ",", " ", "\"\<I(R\[Alpha])\>\""}], 
       "}"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"89e6c9c1-86d0-4e2a-ad26-a53feaa4f847"],

