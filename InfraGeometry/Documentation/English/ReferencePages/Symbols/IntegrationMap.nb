Cell["\<\
Stokes and the naive differential, for a random 1-form on the mesh:\
\>", "ExampleText",ExpressionUUID->"d11365ee-87ec-4756-8023-69fa92b4305d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"germ", " ", "=", " ", 
     RowBox[{"v", " ", "|->", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"List", " ", "/@", " ", 
         RowBox[{"AdjacencyList", "[", 
          RowBox[{"g", ",", " ", "v"}], "]"}]}], ",", " ", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"VertexDegree", "[", 
           RowBox[{"g", ",", " ", "v"}], "]"}]}], "]"}]}], "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"w", " ", "=", " ", 
     RowBox[{"BlockRandom", "[", 
      RowBox[{
       RowBox[{"AssociationMap", "[", 
        RowBox[{"germ", ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"exact", " ", "=", " ", 
     RowBox[{"KeySort", " ", "@", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"IntegrationMap", "[", 
         RowBox[{"g", ",", " ", "w"}], "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"IntegrationMap", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"FormDifferential", "[", 
          RowBox[{"g", ",", " ", "w"}], "]"}]}], "]"}]}], " ", "==", " ", 
      "exact"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"IntegrationMap", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"NaiveDifferential", "[", 
          RowBox[{"g", ",", " ", "w"}], "]"}]}], "]"}]}], " ", "==", " ", 
      RowBox[{
       RowBox[{"2", "/", "3"}], " ", "exact"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2d2f10c7-7cb7-4abe-ba93-71b1e7e9ff98"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"9b1145d4-bb7c-4368-9396-7ad2109d481d"]
}, Open  ]],

Cell[TextData[{
 StyleBox["I(R\[Alpha]) = \[Alpha]", "TI"],
 ", and the integral of a wedge of restrictions is twice the cup product, for \
random 1-cochains on the mesh:"
}], "ExampleText",ExpressionUUID->"018ae7f9-001b-44a6-baaa-624b31610aef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"edges", " ", "=", " ", 
     RowBox[{"Sort", " ", "/@", " ", 
      RowBox[{"List", " ", "@@@", " ", 
       RowBox[{"EdgeList", "[", "g", "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"edges", ",", " ", 
        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"RandomChoice", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "2"}], ",", " ", 
              RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "2"}], "}"}], ",", 
            " ", 
            RowBox[{"Length", "[", "edges", "]"}]}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}]}], 
     ",", "\n", "   ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"edges", ",", " ", 
        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"RandomChoice", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "2"}], ",", " ", 
              RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "2"}], "}"}], ",", 
            " ", 
            RowBox[{"Length", "[", "edges", "]"}]}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"IntegrationMap", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"RestrictionMap", "[", 
          RowBox[{"g", ",", " ", "a"}], "]"}]}], "]"}]}], " ", "==", " ", 
      RowBox[{"KeySort", "[", "a", "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"IntegrationMap", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"FormWedge", "[", 
          RowBox[{
           RowBox[{"RestrictionMap", "[", 
            RowBox[{"g", ",", " ", "a"}], "]"}], ",", " ", 
           RowBox[{"RestrictionMap", "[", 
            RowBox[{"g", ",", " ", "b"}], "]"}]}], "]"}]}], "]"}]}], " ", "==",
       "\n", "     ", 
      RowBox[{"2", " ", 
       RowBox[{"KeySort", " ", "@", " ", 
        RowBox[{"CochainCup", "[", 
         RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}]}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"66071cc6-7ad8-4aca-9545-4fd56cbaf08a"],

