Cell[TextData[{
 StyleBox["R(I\[Omega])", "TI"],
 " is not ",
 StyleBox["\[Omega]", "TI"],
 " in general. In degree 1 it is the antisymmetric part of ",
 StyleBox["\[Omega]", "TI"],
 " across each edge, the orthogonal projection onto the image of ",
 StyleBox["R", "TI"],
 "."
}], "Notes",ExpressionUUID->"11327bbe-9697-456d-9519-ac44957f9655"],

