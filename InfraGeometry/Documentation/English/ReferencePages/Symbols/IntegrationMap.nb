Notebook[{

Cell[CellGroupData[{
Cell["IntegrationMap", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c3869a87-2451-42fb-9de3-023bc63e3a5b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["IntegrationMap"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/IntegrationMap", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["\[Omega]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6e6b45c-1258-4942-8790-ef51a320004b"],
 "\[LineSeparator]",
 "gives the alternating cochain ",
 StyleBox["I\[Omega]", "TI"],
 " of the ",
 StyleBox["k", "TI"],
 "-form ",
 StyleBox["\[Omega]", "TI"],
 ": on each (",
 StyleBox["k", "TI"],
 " + 1)-clique of ",
 StyleBox["g", "TI"],
 ", the mean over its vertices of the germ at the vertex on the others, with \
the sign of its position.",
 "\n"
}], "Usage",ExpressionUUID->"de39af6f-0571-4556-b4be-959a10587c87"],

Cell[TextData[{
 "Definition: ",
 StyleBox["(I\[Omega])(v\:2080, \[Ellipsis], v\:2096) = (1/(k + 1)) \
\[CapitalSigma]\:1d62 (\[Minus]1)\:2071 \[Omega](v\:1d62; v\:2080, \
\[Ellipsis], v\:0302\:1d62, \[Ellipsis], v\:2096)", "TI"],
 ", the sum over the positions ",
 StyleBox["i", "TI"],
 " = 0, \[Ellipsis], ",
 StyleBox["k", "TI"],
 ". It maps the ",
 StyleBox["k", "TI"],
 "-forms to the ",
 StyleBox["k", "TI"],
 "-cochains."
}], "Notes",ExpressionUUID->"678531f2-407c-4193-8655-d08c2a7dbc83"],

Cell[TextData[{
 "On a 1-form it is the antisymmetric part across each edge, ",
 StyleBox["(I\[Omega])(u, v) = (\[Omega](u; v) \[Minus] \[Omega](v; u))/2", 
  "TI"],
 ". On a 0-form it is the 0-cochain of the same values."
}], "Notes",ExpressionUUID->"ac479850-2ae2-412f-ad44-706dd5ee4ddb"],

Cell[TextData[{
 StyleBox["I(R\[Alpha]) = \[Alpha]", "TI"],
 " for every cochain ",
 StyleBox["\[Alpha]", "TI"],
 " and in every degree, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RestrictionMap"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RestrictionMap", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "727c33be-e873-4f3a-8149-71f44a1bf380"],
 " being ",
 StyleBox["R", "TI"],
 ": moving ",
 StyleBox["v\:1d62", "TI"],
 " to the front of ",
 StyleBox["(v\:2080, \[Ellipsis], v\:2096)", "TI"],
 " costs (\[Minus]1)\:2071, so each term of the mean is ",
 StyleBox["\[Alpha](v\:2080, \[Ellipsis], v\:2096)", "TI"],
 ". So ",
 StyleBox["I", "TI"],
 " is onto. From degree 1 on, ",
 StyleBox["R(I\[Omega])", "TI"],
 " is not ",
 StyleBox["\[Omega]", "TI"],
 " in general: ",
 StyleBox["I", "TI"],
 " reads a germ only on the tuples that span a clique with its vertex. On \
1-forms ",
 StyleBox["R(I\[Omega])", "TI"],
 " is the antisymmetrisation of ",
 StyleBox["\[Omega]", "TI"],
 " across each edge, the orthogonal projection onto the image of ",
 StyleBox["R", "TI"],
 "."
}], "Notes",ExpressionUUID->"c62e8dcb-4219-438e-a4e7-7c4caf5fdf7f"],

Cell[TextData[{
 StyleBox["I", "TI"],
 " is a chain map, ",
 StyleBox["I(d\[Omega]) = \[Delta](I\[Omega])", "TI"],
 ", the discrete Stokes theorem of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FormDifferential"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FormDifferential", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0f542a7a-1c8b-42eb-80da-f57c779a8e48"],
 "; for the naive differential the integral is (",
 StyleBox["k", "TI"],
 " + 1)/(",
 StyleBox["k", "TI"],
 " + 2) of ",
 StyleBox["\[Delta](I\[Omega])", "TI"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NaiveDifferential"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/NaiveDifferential", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "36085e36-2c49-4b68-8b1e-0b004c750e23"],
 "). It is not a ring map: for cochains ",
 StyleBox["\[Alpha]", "TI"],
 ", ",
 StyleBox["\[Beta]", "TI"],
 " of degrees ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ", ",
 StyleBox["I(R\[Alpha] \[And] R\[Beta]) = ((p + q)!/(p! q!)) \[Alpha] \:222a \
\[Beta]", "TI"],
 " on every graph tried (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FormWedge"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FormWedge", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3740462a-8368-4ba1-9020-d8db0110fca5"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "693d237f-c552-4243-9ebc-2b679654aeac"],
 ")."
}], "Notes",ExpressionUUID->"afae1da0-a236-4378-bf5e-f31b51bdf139"],

Cell["A value 0 is not stored in the cochain.", "Notes",ExpressionUUID->"83471ca1-7e2c-4290-8765-e46e36600333"]
}, Open  ]],

