Cell[TextData[{
 "A random 1-form, left, and the restriction of its integral, right, each \
drawn by an arc from ",
 StyleBox["v", "TI"],
 " to ",
 StyleBox["w", "TI"],
 " where the germ at ",
 StyleBox["v", "TI"],
 " is positive on the step to ",
 StyleBox["w", "TI"],
 ", blue, or negative, orange. The integral keeps the antisymmetric part \
across each edge; the restriction back to the forms keeps about half of the \
energy, the sum of the squares of the germ values."
}], "ExampleText",ExpressionUUID->"3b27b361-d1e2-4df6-b641-73ab9dd68cb5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"form", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"AssociationMap", "[", 
        RowBox[{
         RowBox[{"node", " ", "|->", " ", 
          RowBox[{"AssociationMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"RandomInteger", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], "]"}], " ", "&"}],
             ",", " ", 
            RowBox[{"List", " ", "/@", " ", 
             RowBox[{"AdjacencyList", "[", 
              RowBox[{"g", ",", " ", "node"}], "]"}]}]}], "]"}]}], ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"projected", " ", "=", " ", 
     RowBox[{"RestrictionMap", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"IntegrationMap", "[", 
        RowBox[{"g", ",", " ", "form"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\n", "     ", 
       RowBox[{
        RowBox[{"DisplacementPlot", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{"Catenate", " ", "@*", " ", "Keys", " ", "@*", " ", 
               RowBox[{"Select", "[", "Positive", "]"}]}], ",", " ", "form"}],
              "]"}], ",", " ", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{"Catenate", " ", "@*", " ", "Keys", " ", "@*", " ", 
               RowBox[{"Select", "[", "Negative", "]"}]}], ",", " ", "form"}],
              "]"}]}], "}"}]}], "]"}], ",", "\n", "     ", 
        RowBox[{"DisplacementPlot", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{"Catenate", " ", "@*", " ", "Keys", " ", "@*", " ", 
               RowBox[{"Select", "[", "Positive", "]"}]}], ",", " ", 
              "projected"}], "]"}], ",", " ", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{"Catenate", " ", "@*", " ", "Keys", " ", "@*", " ", 
               RowBox[{"Select", "[", "Negative", "]"}]}], ",", " ", 
              "projected"}], "]"}]}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"Catenate", "[", 
          RowBox[{"Values", " ", "/@", " ", 
           RowBox[{"Values", "[", "projected", "]"}]}], "]"}], "^", "2"}], 
        "]"}], " ", "/", " ", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"Catenate", "[", 
          RowBox[{"Values", " ", "/@", " ", 
           RowBox[{"Values", "[", "form", "]"}]}], "]"}], "^", "2"}], "]"}]}],
       "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"33807043-1574-4c8c-a121-329013d192ec"],

