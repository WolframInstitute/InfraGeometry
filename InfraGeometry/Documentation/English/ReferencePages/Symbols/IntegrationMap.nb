Cell["\<\
Restricting the integral keeps the antisymmetric part only. For 100 random \
1-forms on the mesh the part of the energy, the sum of the squares of the \
germ values, it keeps is about 1/2:\
\>", "ExampleText",ExpressionUUID->"62ed931d-0dee-4270-a2b6-bbbea3fa6125"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"germ", " ", "=", " ", 
     RowBox[{"v", " ", "|->", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"List", " ", "/@", " ", 
         RowBox[{"AdjacencyList", "[", 
          RowBox[{"g", ",", " ", "v"}], "]"}]}], ",", " ", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{
