Cell[TextData[{
 "The energy that the restriction of the integral keeps, over 100 random \
1-forms on the triangular tiling, concentrates near 1/2: on an edge with germ \
values ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " it keeps (",
 StyleBox["a", "TI"],
 " \[Minus] ",
 StyleBox["b", "TI"],
 ")\.b2/2 of ",
 StyleBox["a", "TI"],
 "\.b2 + ",
 StyleBox["b", "TI"],
 "\.b2."
}], "ExampleText",ExpressionUUID->"35101577-a9c4-4f45-bea2-4a713a17e39d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Histogram", "[", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"form", " ", "=", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "seedNumber", "]"}], ";", "\n", 
            "        ", 
            RowBox[{"AssociationMap", "[", 
             RowBox[{
              RowBox[{"node", " ", "|->", " ", 
               RowBox[{"AssociationMap", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"RandomInteger", "[", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], "]"}], " ", 
                  "&"}], ",", " ", 
                 RowBox[{"List", " ", "/@", " ", 
                  RowBox[{"AdjacencyList", "[", 
                   RowBox[{"g", ",", " ", "node"}], "]"}]}]}], "]"}]}], ",", 
              " ", 
              RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], ")"}]}], 
         "}"}], ",", "\n", "      ", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"Catenate", "[", 
             RowBox[{"Values", " ", "/@", " ", 
              RowBox[{"Values", "[", 
               RowBox[{"RestrictionMap", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{"IntegrationMap", "[", 
                  RowBox[{"g", ",", " ", "form"}], "]"}]}], "]"}], "]"}]}], 
             "]"}], "^", "2"}], "]"}], " ", "/", " ", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"Catenate", "[", 
             RowBox[{"Values", " ", "/@", " ", 
              RowBox[{"Values", "[", "form", "]"}]}], "]"}], "^", "2"}], 
           "]"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"seedNumber", ",", " ", "100"}], "}"}]}], "]"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"bf2f2b2b-b098-4bba-b7e7-27b07776f53e"],

