Cell["\<\
The projection may be an association instead of a function. Both give the \
same base.\
\>", "ExampleText",ExpressionUUID->"30ccbb46-b0ba-4ced-95af-900fed93320e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"byFunction", " ", "=", " ", 
     RowBox[{"InfraFibration", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
       RowBox[{"i", " ", "|->", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{"i", ",", " ", "4", ",", " ", "1"}], "]"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"byAssociation", " ", "=", " ", 
     RowBox[{"InfraFibration", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"Range", "[", "8", "]"}], ",", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"Range", "[", "8", "]"}], ",", " ", "4", ",", " ", "1"}], 
          "]"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraBaseGraph", "[", "byAssociation", "]"}], ",", " ", 
     RowBox[{"IsomorphicGraphQ", "[", 
      RowBox[{
       RowBox[{"InfraBaseGraph", "[", "byFunction", "]"}], ",", " ", 
       RowBox[{"InfraBaseGraph", "[", "byAssociation", "]"}]}], "]"}]}], 
    "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"35211af0-e7c2-4bb0-ac9a-02a3b2b97fdf"],

