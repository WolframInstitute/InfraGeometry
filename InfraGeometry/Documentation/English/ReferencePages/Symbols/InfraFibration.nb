   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "702c9d1c-8fd5-4b3e-8557-6394f70b337f"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibrationAssociation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationAssociation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f52982a0-dc6c-4b7b-b616-c119835186b5"],
 "."
}], "Notes",ExpressionUUID->"dd577341-3eda-48fa-b3f4-4effd98c729e"],

