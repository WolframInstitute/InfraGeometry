Cell["\<\
The projection may be an association instead of a function. Both give the \
same base.\
\>", "ExampleText",ExpressionUUID->"ecd88d3b-d4b0-4a00-93cd-ee9c121a41aa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"byFunction", " ", "=", " ", 
     RowBox[{"InfraFibration", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
       RowBox[{"i", " ", "|->", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{"i", ",", " ", "4", ",", " ", "1"}], "]"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"byAssociation", " ", "=", " ", 
     RowBox[{"InfraFibration", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"Range", "[", "8", "]"}], ",", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"Range", "[", "8", "]"}], ",", " ", "4", ",", " ", "1"}], 
          "]"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraBaseGraph", "[", "byAssociation", "]"}], ",", " ", 
     RowBox[{"IsomorphicGraphQ", "[", 
      RowBox[{
       RowBox[{"InfraBaseGraph", "[", "byFunction", "]"}], ",", " ", 
       RowBox[{"InfraBaseGraph", "[", "byAssociation", "]"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"01cd504c-d325-4f9b-8398-58ce76a738ee"],

