Cell[TextData[{
 "The cycle of length 8 over the square, the vertex ",
 StyleBox["i", "TI"],
 " over ",
 StyleBox["i", "TI"],
 " mod 4. The fiber over 1 is drawn."
}], "ExampleText",ExpressionUUID->"8371ffc0-bc8e-497f-86e2-297478d81133"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFibration", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
       RowBox[{"i", " ", "|->", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{"i", ",", " ", "4", ",", " ", "1"}], "]"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"total", ",", " ", 
     RowBox[{"{", 
      RowBox[{"InfraDensity", "[", 
       RowBox[{"total", ",", " ", 
        RowBox[{"VertexList", " ", "@", " ", 
         RowBox[{"InfraFiber", "[", 
          RowBox[{"fib", ",", " ", "1"}], "]"}]}]}], "]"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ee869fe9-d091-483e-8225-5ed7483f9bcc"],

