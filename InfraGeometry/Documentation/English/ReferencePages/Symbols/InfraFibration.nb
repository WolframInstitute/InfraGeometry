   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "48922194-3943-48c1-b14b-5f061c106336"],
 ", computing its total graph once."
}], "Usage",ExpressionUUID->"07ebb530-d091-4951-adfe-3a1d8e71d9bd"],

Cell[TextData[{
 "A fibration is a graph ",
 StyleBox["total", "TI"],
 ", the total graph, with a map ",
 StyleBox["proj", "TI"],
 " from its vertices to the vertices of a base graph. The fiber over a base \
vertex ",
 StyleBox["p", "TI"],
 " is the subgraph of ",
 StyleBox["total", "TI"],
 " on the vertices that ",
 StyleBox["proj", "TI"],
 " sends to ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"d7bbeeeb-5b0a-4faf-bd59-944bf971f042"],

Cell[TextData[{
 "The base graph is not stored. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBaseGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBaseGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9276ea72-f1a4-48ab-94ad-5099b336b130"],
 " reconstructs it from the projection: two base vertices are adjacent iff \
some total edge projects onto them."
}], "Notes",ExpressionUUID->"d32aef90-721b-47e8-895d-351f9f0b1287"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "09bf895a-979b-408d-ad2a-15173f252f37"],
 " is inert. It holds the graph and the projection, and every function of the \
Infra Fiber Bundles guide reads them through ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTotalGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTotalGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f7a83889-089d-48f2-8302-33561585882c"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibrationAssociation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationAssociation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "175c7d86-b56e-4702-adb7-8865d9e36fc2"],
 "."
}], "Notes",ExpressionUUID->"cc3cbed9-3d72-4539-ac17-36d265d4a9d2"],

Cell[TextData[{
 "The constructions ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTangentBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTangentBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
