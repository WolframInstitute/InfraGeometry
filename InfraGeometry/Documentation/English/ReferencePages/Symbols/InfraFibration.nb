Cell["\<\
The projection may be an association instead of a function. Both give the \
same base.\
\>", "ExampleText",ExpressionUUID->"4c250299-ef24-4ff2-a836-674a03b3d6b3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"byFunction", " ", "=", " ", 
     RowBox[{"InfraFibration", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
       RowBox[{"i", " ", "|->", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{"i", ",", " ", "4", ",", " ", "1"}], "]"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"byAssociation", " ", "=", " ", 
     RowBox[{"InfraFibration", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"Range", "[", "8", "]"}], ",", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"Range", "[", "8", "]"}], ",", " ", "4", ",", " ", "1"}], 
          "]"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraBaseGraph", "[", "byAssociation", "]"}], ",", " ", 
     RowBox[{"IsomorphicGraphQ", "[", 
      RowBox[{
       RowBox[{"InfraBaseGraph", "[", "byFunction", "]"}], ",", " ", 
       RowBox[{"InfraBaseGraph", "[", "byAssociation", "]"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"88f586bb-4708-4104-9c59-4c5836d1b543"],

