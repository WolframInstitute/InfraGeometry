Cell["\<\
A construction converted to a literal fibration keeps its total graph.\
\>", "ExampleText",ExpressionUUID->"4b15846c-6374-42d0-bba8-4688cff7fb3c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bundle", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridDisplacementBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFibration", "[", "bundle", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}], ",", " ", 
     RowBox[{"Head", "[", "fib", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"InfraTotalGraph", "[", "fib", "]"}], " ", "===", " ", 
      RowBox[{"InfraTotalGraph", "[", "bundle", "]"}]}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"586a532a-7598-4b3a-b922-1fcc1a5c0790"],

