Cell["The readers do not see the head:", "ExampleText",ExpressionUUID->"6ae514fd-c69c-4b12-90fe-95a571348fde"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"old", " ", "=", " ", 
     RowBox[{"InfraFibration", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
       RowBox[{"v", " ", "|->", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{"v", ",", " ", "4", ",", " ", "1"}], "]"}]}]}], "]"}]}], 
    "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"new", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", "old"}], ",", " ", 
       RowBox[{"Last", " ", "@", " ", "old"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraFibers", "[", "old", "]"}], " ", "===", " ", 
      RowBox[{"InfraFibers", "[", "new", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"InfraProjection", "[", "old", "]"}], " ", "===", " ", 
      RowBox[{"InfraProjection", "[", "new", "]"}]}], ",", " ", 
     RowBox[{"InfraFibrationQ", "[", "old", "]"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"29e30987-1114-40e7-a5b4-610a82c4265b"],

