Cell["\<\
The cycle of length 8 over the cycle of length 4, with the fiber over 1:\
\>", "ExampleText",ExpressionUUID->"2f2c2673-95ca-4eb6-8be3-aa1020f8a434"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFibration", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
       RowBox[{"v", " ", "|->", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{"v", ",", " ", "4", ",", " ", "1"}], "]"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", 
      RowBox[{"InfraFiber", "[", 
       RowBox[{"fib", ",", " ", "1"}], "]"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"04cc635c-dcb1-4a99-9be5-dcf525ed5344"],

