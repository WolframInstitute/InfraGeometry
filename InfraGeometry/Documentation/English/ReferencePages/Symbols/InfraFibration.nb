Cell["\<\
A construction converted to a literal fibration keeps its total graph.\
\>", "ExampleText",ExpressionUUID->"f7a2dc8f-78a4-4beb-a184-58cd0c80c473"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bundle", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridDisplacementBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFibration", "[", "bundle", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}], ",", " ", 
     RowBox[{"Head", "[", "fib", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"InfraTotalGraph", "[", "fib", "]"}], " ", "===", " ", 
      RowBox[{"InfraTotalGraph", "[", "bundle", "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6c5001cb-2766-4d00-a8ac-160493867af7"],

