Cell["\<\
A literal fibration from the catalogue, the Moebius ladder over a cycle, each \
fiber in its own colour.\
\>", "ExampleText",ExpressionUUID->"ee605b1f-5981-4112-8441-a2c01fcff58d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<MoebiusLadderCover\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"total", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraDensity", "[", 
        RowBox[{"total", ",", " ", 
         RowBox[{"VertexList", " ", "@", " ", "#"}]}], "]"}], " ", "&"}], " ",
       "/@", " ", 
      RowBox[{"Values", " ", "@", " ", 
       RowBox[{"InfraFibers", "[", "fib", "]"}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"085bcd48-6e37-474c-b319-5b5a474bf256"],

