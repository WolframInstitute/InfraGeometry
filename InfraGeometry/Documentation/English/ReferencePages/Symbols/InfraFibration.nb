Cell["\<\
A construction converted to a literal fibration keeps its total graph.\
\>", "ExampleText",ExpressionUUID->"4a48009b-3538-446c-97a0-c175653e5b37"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bundle", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridDisplacementBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFibration", "[", "bundle", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}], ",", " ", 
     RowBox[{"Head", "[", "fib", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"InfraTotalGraph", "[", "fib", "]"}], " ", "===", " ", 
      RowBox[{"InfraTotalGraph", "[", "bundle", "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"dd490fbd-102c-4615-948c-76ab17ceb119"],

