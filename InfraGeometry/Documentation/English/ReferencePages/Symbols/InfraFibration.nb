Cell["A construction gives a literal object under either name:", "ExampleText",ExpressionUUID->"067947e7-2d7c-4070-85e0-9f9aa3848bbc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"model", " ", "=", " ", 
     RowBox[{"InfraDisplacementBundle", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", "1"}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"InfraFibration", "[", "model", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"InfraFibers", "[", 
       RowBox[{"InfraFibration", "[", "model", "]"}], "]"}], " ", "===", " ", 
      
      RowBox[{"InfraFibers", "[", 
       RowBox[{"InfraFiberedGraph", "[", "model", "]"}], "]"}]}]}], "}"}]}], 
