   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "07613a26-2be1-4ea6-911f-bbade9c4e841"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCotangentBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCotangentBundle", 
