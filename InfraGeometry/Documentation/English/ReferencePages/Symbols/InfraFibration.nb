Cell["\<\
General evaluators support finite simple undirected unweighted total graphs. \
Unsupported graph domains remain unevaluated.\
\>", "Notes",ExpressionUUID->"29bdf3fd-7865-4c17-a683-4661b352fb77"],

Cell[TextData[{
 "An association projection has exactly one key for every total vertex. \
List-valued and pattern-like vertex labels are literal keys; readers use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Key"]], "paclet:ref/Key"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "14de4f1c-d1b8-4664-b328-264cd5b70f8f"],
 " for lookup."
}], "Notes",ExpressionUUID->"17d6e663-c9fa-4324-81cb-133d2cdd65bd"],

Cell["\<\
The reconstructed base includes projection values represented by isolated \
total vertices.\
\>", "Notes",ExpressionUUID->"912bd2ba-46e6-432a-a0be-6ddddc7ff391"]
}, Open  ]],

