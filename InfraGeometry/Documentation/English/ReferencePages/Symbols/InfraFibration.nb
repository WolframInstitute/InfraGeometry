  FontSize->0.9 Inherited,ExpressionUUID->
  "da5af743-3e88-43e1-a97c-7f8ba84b1228"],
 "\[LineSeparator]",
 "gives the construction ",
 StyleBox["fib", "TI"],
 ", such as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTangentBundle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTangentBundle", 
