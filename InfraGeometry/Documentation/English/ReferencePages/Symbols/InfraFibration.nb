   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "36fffad2-7ad2-4b1f-a834-1e93b14b7486"],
 " for new code. Both literal heads are accepted by the structural readers, \
predicates, sections, connections and drawing functions."
}], "Notes",ExpressionUUID->"aa0f80aa-60ee-4583-ac93-cdb45b56309e"],

