Cell[CellGroupData[{
Cell["DisplacementNegative", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"036de5cc-d733-49f0-afbb-a0cb0b27226f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementNegative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementNegative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27bf42a3-f4b3-466a-9543-b76e52afdbaf"],
 "\[LineSeparator]",
 "is the metric negative of the displacement ",
 StyleBox["d", "TI"],
 ": each step from ",
 StyleBox["v", "TI"],
 " to a vertex ",
 StyleBox["w", "TI"],
 " of ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") is reflected through ",
 StyleBox["v", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"a36b2821-0a2a-4301-81af-528bc2bc2840"],

Cell[TextData[{
 "Definition: ",
 StyleBox["\[Minus]D", "TI"],
 " = ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementScale"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementScale", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d", "TI"], ",", " ", 
    RowBox[{"-", "1"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c454571-3878-4562-a3dd-e4b34231b430"],
 ". For a step ",
 StyleBox["a", "TI"],
 " \[RightArrow] ",
 StyleBox["b", "TI"],
 " the candidates are the vertices beyond ",
 StyleBox["a", "TI"],
 " on a shortest path from ",
 StyleBox["b", "TI"],
 ", ",
 StyleBox["d(b, x) = d(b, a) + d(a, x)", "TI"],
 "; ",
 StyleBox["\[Minus]D(a)", "TI"],
 " keeps those at the distance from ",
 StyleBox["a", "TI"],
 " nearest to ",
 StyleBox["d(a, b)", "TI"],
 ", and of these the straightest, as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementScale"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementScale", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9b205032-3e94-4eea-a187-6f8414895707"],
 "."
}], "Notes",ExpressionUUID->"6cbeb0ea-b560-4fbd-9ff1-662cee2f37de"],

Cell[TextData[{
 "The negative is not the inverse. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementInverse"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementInverse", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c286cfb5-0462-4d92-b31d-cdaab399b3b2"],
 " reverses the relation and needs no metric; the negative reflects each step \
through its base vertex and needs no injectivity. For a rotation of a cycle \
the two agree."
}], "Notes",ExpressionUUID->"d2d09d78-bb11-47a7-8623-ea79872f1e46"],

Cell[TextData[{
 "Where no shortest path from ",
 StyleBox["b", "TI"],
 " continues straight beyond ",
 StyleBox["a", "TI"],
 ", at the rim, the reflected step takes the straightest of the vertices that \
are still on such a path. On a grid these are the neighbours of ",
 StyleBox["a", "TI"],
 " beside the step."
}], "Notes",ExpressionUUID->"31c058a8-42e6-4a1f-8e12-7e884deb9996"]
}, Open  ]],

