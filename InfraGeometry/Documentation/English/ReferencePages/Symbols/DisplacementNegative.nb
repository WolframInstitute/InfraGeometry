Cell["\<\
The vertices where the negative of the step right is the step left. On the \
grid that is 50 of 96, away from the rim; on the mesh 26 of 102:\
\>", "ExampleText",ExpressionUUID->"ef2377bb-e465-4167-9a4c-768d699fd616"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"KeyValueMap", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name", ",", " ", "s"}], "}"}], " ", "|->", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"negative", " ", "=", " ", 
         RowBox[{"DisplacementNegative", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"TranslationDisplacement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", 
              RowBox[{"s", ",", " ", "0"}], "}"}]}], "]"}]}], "]"}]}], "}"}], 
       ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"left", " ", "=", " ", 
         RowBox[{"TranslationDisplacement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "s"}], ",", " ", "0"}], "}"}]}], "]"}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"agree", " ", "=", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"negative", "[", "#", "]"}], " ", "===", " ", 
             RowBox[{"left", "[", "#", "]"}]}], " ", "&"}]}], "]"}]}], "}"}], 
       ",", "\n", "    ", 
       RowBox[{"InfraSubstrateHighlight", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", "agree", "}"}], ",", " ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"Length", "[", "agree", "]"}]}]}], "]"}]}], "]"}]}], ",", 
    "\n", "  ", 
