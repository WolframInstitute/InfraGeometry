Cell["\<\
The negative of the translation by one step on the discretized plane, the \
square tiling and the hexagonal tiling. On the two tilings it is the \
translation in the opposite direction, except at the rim. On the discretized \
plane, whose shortest paths are irregular, the reflected steps point \
backwards only roughly.\
\>", "ExampleText",ExpressionUUID->"20898291-3bfc-4ebb-993f-dfb9f782074b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{
          RowBox[{"First", "[", "pair", "]"}], ",", " ", "\"\<Small\>\"", ",",
           " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"DisplacementPlot", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"DisplacementNegative", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"TranslationDisplacement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Last", "[", "pair", "]"}]}], "]"}]}], "]"}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"pair", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.1", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"1.5", ",", " ", 
            RowBox[{
             RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}]}], "}"}]}], "}"}]}], 
       "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a4183e31-c91e-463d-a903-53701e4a056e"],

