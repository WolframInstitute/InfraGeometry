Cell["The negative is the scale by \[Minus]1:", "ExampleText",ExpressionUUID->"1d96cb61-0035-4513-a6f8-d070ba2435de"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"TranslationDisplacement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "8"}], ",", " ", "0"}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{
    RowBox[{"DisplacementNegative", "[", 
     RowBox[{"g", ",", " ", "t"}], "]"}], " ", "===", " ", 
    RowBox[{"DisplacementScale", "[", 
     RowBox[{"g", ",", " ", "t", ",", " ", 
      RowBox[{"-", "1"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b1f6a4b3-ef74-4a80-8f5f-54bef1c3ce85"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"4e309a05-aeb9-4084-81f3-a73df1fb7167"]
}, Open  ]],

Cell["On a 12-cycle the negative of a rotation is its inverse:", "ExampleText",ExpressionUUID->"273770ea-830b-4bdf-b46c-c67a2528bcc2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"rotation", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{
    RowBox[{"DisplacementNegative", "[", 
     RowBox[{"g", ",", " ", "rotation"}], "]"}], " ", "===", " ", 
    RowBox[{"DisplacementInverse", "[", "rotation", "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"dc4f3e8c-1404-47da-9f13-7da33ecc29fd"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"fc9d4aa3-f31c-409c-8e2e-aadf1021b12d"]
}, Open  ]],

Cell["\<\
The negative of the negative is the displacement only away from the rim. The \
52 vertices of the grid where it differs from the step right:\
\>", "ExampleText",ExpressionUUID->"42dd094c-05e4-4464-a380-3e156170a398"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"right", " ", "=", " ", 
     RowBox[{"TranslationDisplacement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"twice", " ", "=", " ", 
     RowBox[{"DisplacementNegative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"DisplacementNegative", "[", 
        RowBox[{"g", ",", " ", "right"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"differ", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"twice", "[", "#", "]"}], " ", "=!=", " ", 
         RowBox[{"right", "[", "#", "]"}]}], " ", "&"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", "differ", "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Length", "[", "differ", "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"ae97efa9-b707-4fbb-9fe6-c8cfabfcab32"],

