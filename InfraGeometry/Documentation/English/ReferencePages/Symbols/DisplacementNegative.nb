Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rotation", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"rotation", ",", " ", 
         RowBox[{"DisplacementNegative", "[", 
          RowBox[{"g", ",", " ", "rotation"}], "]"}]}], "}"}]}], "]"}], ",", 
     " ", 
     RowBox[{
      RowBox[{"DisplacementNegative", "[", 
       RowBox[{"g", ",", " ", "rotation"}], "]"}], " ", "===", " ", 
      RowBox[{"DisplacementInverse", "[", "rotation", "]"}]}]}], "}"}]}], 
