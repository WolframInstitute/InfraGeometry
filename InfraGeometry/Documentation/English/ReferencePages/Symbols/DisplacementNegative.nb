Cell["\<\
The step right in blue and its negative in red, on the square grid and on the \
square mesh:\
\>", "ExampleText",ExpressionUUID->"feba6741-856b-4e88-b401-8e4250bd7afb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"KeyValueMap", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name", ",", " ", "s"}], "}"}], " ", "|->", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"t", " ", "=", " ", 
         RowBox[{"TranslationDisplacement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", 
            RowBox[{"s", ",", " ", "0"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"DisplacementPlot", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", 
           RowBox[{"DisplacementNegative", "[", 
            RowBox[{"g", ",", " ", "t"}], "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
    ",", "\n", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<SquareGridGraph\>\"", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"\"\<SquareMeshGraph\>\"", " ", "->", " ", 
       RowBox[{"1", "/", "8"}]}]}], "|>"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f5c150da-9bb3-4d92-b48e-c819debfae83"],

