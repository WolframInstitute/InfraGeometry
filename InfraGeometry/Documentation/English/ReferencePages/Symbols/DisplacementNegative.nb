Cell["\<\
On the 6 \[Times] 6 grid the negative of the step right is the step left. In \
the left column no shortest path from the right neighbour continues straight, \
and the reflected step goes to the vertical neighbours.\
\>", "ExampleText",ExpressionUUID->"cfc944d9-5f87-45a9-a693-5c69919e09d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "6"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"right", " ", "=", " ", 
     RowBox[{"TranslationDisplacement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"right", ",", " ", 
       RowBox[{"DisplacementNegative", "[", 
        RowBox[{"g", ",", " ", "right"}], "]"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f139bb1b-b869-4350-bb4e-ed4f2cd2bdf6"],

