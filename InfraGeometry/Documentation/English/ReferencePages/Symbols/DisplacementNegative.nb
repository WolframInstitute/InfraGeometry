Notebook[{

Cell[CellGroupData[{
Cell["DisplacementNegative", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"aa682df3-f78c-4124-b10d-63a88ba07690"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementNegative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementNegative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1120bdd-efda-47bb-a373-cf1f97f528ad"],
 "\[LineSeparator]",
 "is the metric negative of the displacement ",
 StyleBox["d", "TI"],
 ": each step is reflected through its base vertex.",
 "\n"
}], "Usage",ExpressionUUID->"156fd034-d1b2-4882-993a-6a17133abf76"],

Cell[TextData[{
 "For a step ",
 StyleBox["a", "TI"],
 " \[RightArrow] ",
 StyleBox["b", "TI"],
 " the candidates are the vertices ",
 StyleBox["x", "TI"],
 " that continue a shortest path from ",
 StyleBox["b", "TI"],
 " through ",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["d(b, x) = d(b, a) + d(a, x)", "TI"],
 ". The negative ",
 StyleBox["\[Minus]D(a)", "TI"],
 " keeps those with ",
 StyleBox["d(a, x)", "TI"],
 " nearest to ",
 StyleBox["d(a, b)", "TI"],
 ", and of these the straightest. It is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementScale"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementScale", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d", "TI"], ",", " ", 
    RowBox[{"\[Minus]", "1"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cd796a9-f7b3-432d-b419-379a2ed914d0"],
 ", where the straightest candidates are defined."
}], "Notes",ExpressionUUID->"18a0fcc5-f503-46b0-8ebd-b27112b65f09"],

Cell[TextData[{
 "In the plane the negative of the flow of ",
 StyleBox["X", "TI"],
 " for time ",
 StyleBox["r", "TI"],
 " is the flow of ",
 StyleBox["\[Minus]X", "TI"],
 ". On a graph the reflected step can have several values, or none beyond the \
base vertex: then the vertex stays."
}], "Notes",ExpressionUUID->"66aef127-dce1-4dac-b92b-4388982f2470"],

Cell[TextData[{
 "The negative is not the inverse. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementInverse"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementInverse", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bb869d81-3d77-421a-88e1-002a79ca4bbf"],
 " reverses the relation and needs no metric; the negative needs no \
injectivity. On a cycle the two agree for a rotation."
}], "Notes",ExpressionUUID->"a7395dc6-266e-454a-a372-220806aac017"]
}, Open  ]],

