Cell["\<\
The vertex 85 of the grid steps right to a pendant vertex. Every way on from \
a pendant vertex is equally straight, so the negative has three values:\
\>", "ExampleText",ExpressionUUID->"3a7b818c-44ff-4595-b03d-798a227a7e37"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"right", " ", "=", " ", 
     RowBox[{"TranslationDisplacement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"negative", " ", "=", " ", 
     RowBox[{"DisplacementNegative", "[", 
      RowBox[{"g", ",", " ", "right"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"KeyTake", "[", 
        RowBox[{"right", ",", " ", 
         RowBox[{"{", "85", "}"}]}], "]"}], ",", " ", 
       RowBox[{"KeyTake", "[", 
        RowBox[{"negative", ",", " ", 
         RowBox[{"{", "85", "}"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"negative", "[", "85", "]"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"bbfb0939-b509-4452-a125-e5b0d8d3fa0c"],

