Cell["\<\
Three vertices in a row reduce to the middle one; two vertices stay. Two \
outward steps from the vertex 12 of the square tiling end at three vertices \
in a row, and one outward step at two.\
\>", "ExampleText",ExpressionUUID->"bfc27331-d2b4-498d-848b-a95b820283cf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"radial", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"PolarDisplacements", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"twoSteps", " ", "=", " ", 
      RowBox[{"KeyTake", "[", 
       RowBox[{
        RowBox[{"DisplacementCompose", "[", 
         RowBox[{"radial", ",", " ", "radial"}], "]"}], ",", " ", 
        RowBox[{"{", "12", "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"oneStep", " ", "=", " ", 
      RowBox[{"KeyTake", "[", 
       RowBox[{"radial", ",", " ", 
        RowBox[{"{", "12", "}"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"twoSteps", ",", " ", 
         RowBox[{"DisplacementReduce", "[", 
          RowBox[{"g", ",", " ", "twoSteps"}], "]"}]}], "}"}]}], "]"}], ",", 
     " ", 
     RowBox[{"twoSteps", "[", "12", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"DisplacementReduce", "[", 
       RowBox[{"g", ",", " ", "twoSteps"}], "]"}], "[", "12", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"DisplacementReduce", "[", 
       RowBox[{"g", ",", " ", "oneStep"}], "]"}], "[", "12", "]"}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"279f8a3d-9c27-41c3-8845-28a7c3ebe75a"],

