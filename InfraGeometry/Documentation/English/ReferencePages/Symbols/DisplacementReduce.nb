Cell["\<\
A step from the centre to a vertex at distance 3 and its neighbours, in blue, \
contracts to that vertex, in red, on the square grid and on the square mesh:\
\>", "ExampleText",ExpressionUUID->"477392d8-e42d-4ed3-899a-7ec6cd696470"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"t", " ", "=", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"blurred", " ", "=", " ", 
        RowBox[{"<|", 
         RowBox[{"c", " ", "->", " ", 
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{"AdjacencyList", "[", 
             RowBox[{"g", ",", " ", "t"}], "]"}], ",", " ", "t"}], "]"}]}], 
         "|>"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"DisplacementPlot", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"blurred", ",", " ", 
          RowBox[{"DisplacementReduce", "[", 
           RowBox[{"g", ",", " ", "blurred"}], "]"}]}], "}"}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"723ba34f-4eb0-44f9-a767-1472e5065cbd"],

