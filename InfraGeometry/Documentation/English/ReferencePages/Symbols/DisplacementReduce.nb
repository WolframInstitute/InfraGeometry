Notebook[{

Cell[CellGroupData[{
Cell["DisplacementReduce", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"15506405-6f8d-426f-9419-dda29826200a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementReduce"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementReduce", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9445acea-4c83-4fff-853f-b413b8e052c2"],
 "\[LineSeparator]",
 "contracts each value of the displacement ",
 StyleBox["d", "TI"],
 " to its metric centre, repeated until nothing changes.",
 "\n"
}], "Usage",ExpressionUUID->"f563a497-88ba-475e-b7f4-5a2b2eb8a3b0"],

Cell[TextData[{
 "For a set ",
 StyleBox["S", "TI"],
 " of vertices let ",
 StyleBox["c(S)", "TI"],
 " be the vertices of ",
 StyleBox["S", "TI"],
 " of least eccentricity within ",
 StyleBox["S", "TI"],
 ", those minimizing ",
 StyleBox["max {d(x, y) : y \[Element] S}", "TI"],
 ". The reduced value at ",
 StyleBox["v", "TI"],
 " is the fixed point of ",
 StyleBox["S \[RightTeeArrow] c(S)", "TI"],
 " starting from ",
 StyleBox["D(v)", "TI"],
 "."
}], "Notes",ExpressionUUID->"a151376e-17c0-4cde-a369-7647902988b2"],

Cell["\<\
Each reduced value is a subset of the original one, so no step becomes \
longer. A single vertex stays.\
\>", "Notes",ExpressionUUID->"5823fe9f-53b6-4d55-8583-f01b5e2a1e8f"],

Cell["\<\
A set whose vertices are all equally central stays as it is: a tie the metric \
does not break. Any two vertices are such a tie, and so is the circle of \
radius 2 on the square grid.\
\>", "Notes",ExpressionUUID->"6cce766b-748a-45fe-8142-654d2d6fb8b0"],

Cell[TextData[{
 "The values of a displacement are sets where the metric does not decide: \
half a step, the midpoints of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementSum"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementSum", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "724850e6-ef07-4af7-94a7-6614d9c7e73d"],
 ", the outward neighbours of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PolarDisplacements"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/PolarDisplacements", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b6c0538e-aa1a-40b6-94d0-fc1f18926e78"],
 ". The reduction keeps what the metric decides."
}], "Notes",ExpressionUUID->"8972898d-94ba-474e-8c3a-e52bc42b69c5"]
}, Open  ]],

