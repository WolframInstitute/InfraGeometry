Cell["\<\
The step right of the 6 \[Times] 6 grid, its values blurred to the target and \
its neighbours, comes back under the reduction.\
\>", "ExampleText",ExpressionUUID->"e127dbdf-babb-41e1-be69-8c602441e6bf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "6"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"right", " ", "=", " ", 
     RowBox[{"TranslationDisplacement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"blurred", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Union", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"AdjacencyList", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"First", "[", "#", "]"}]}], "]"}]}], "]"}], " ", "&"}], ",",
        " ", "right"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"DisplacementPlot", "[", 
         RowBox[{"g", ",", " ", "blurred"}], "]"}], ",", " ", 
        RowBox[{"DisplacementPlot", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"DisplacementReduce", "[", 
           RowBox[{"g", ",", " ", "blurred"}], "]"}]}], "]"}]}], "}"}], "]"}],
      ",", " ", 
     RowBox[{
      RowBox[{"DisplacementReduce", "[", 
       RowBox[{"g", ",", " ", "blurred"}], "]"}], " ", "===", " ", 
      "right"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"43f7874d-0bef-4191-9644-34c1f3a52bba"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   GraphicsBox[{{}, {InsetBox[
       GraphicsBox[{
         NamespaceBox[{
           {GrayLevel[0.85], Opacity[0.4], CapForm["Round"], 
