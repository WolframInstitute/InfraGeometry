Cell["\<\
Ties stay. Half a step is its two ends, and two outward radial steps from the \
centre of the grid reach the 8 vertices of the circle of radius 2, all \
equally central:\
\>", "ExampleText",ExpressionUUID->"78ea5525-3b36-4c19-8b2b-5508b89e4155"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"half", " ", "=", " ", 
     RowBox[{"DisplacementScale", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"<|", 
        RowBox[{"c", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"AdjacencyList", "[", 
            RowBox[{"g", ",", " ", "c"}], "]"}]}], "}"}]}], "|>"}], ",", " ", 
       
       RowBox[{"1", "/", "2"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"radial", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"PolarDisplacements", "[", 
       RowBox[{"g", ",", " ", "c"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"twoSteps", " ", "=", " ", 
     RowBox[{"KeyTake", "[", 
      RowBox[{
       RowBox[{"DisplacementCompose", "[", 
        RowBox[{"radial", ",", " ", "radial"}], "]"}], ",", " ", 
       RowBox[{"{", "c", "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"DisplacementReduce", "[", 
       RowBox[{"g", ",", " ", "half"}], "]"}], " ", "===", " ", "half"}], ",",
      " ", 
     RowBox[{
      RowBox[{"DisplacementReduce", "[", 
       RowBox[{"g", ",", " ", "twoSteps"}], "]"}], " ", "===", " ", 
      "twoSteps"}], ",", " ", 
     RowBox[{"Length", "[", 
      RowBox[{"twoSteps", "[", "c", "]"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7fb05f90-732f-4810-b2d5-de6831b43931"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a026fd08-6554-4e6b-be87-93a2c24f5beb"]
}, Open  ]]
}, Open  ]],

