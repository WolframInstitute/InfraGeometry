Cell["\<\
A step from the centre to a ball of radius 1, blue, contracts to the centre \
of the ball, orange, on the discretized plane, the square tiling and the \
hexagonal tiling.\
\>", "ExampleText",ExpressionUUID->"71026fd8-db46-4545-8915-018e4c577221"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"target", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraShell", "[", 
             RowBox[{"c", ",", " ", "3"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"blurred", " ", "=", " ", 
        RowBox[{"<|", 
         RowBox[{"c", " ", "->", " ", 
          RowBox[{"RandomInfraRepresentative", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraBall", "[", 
             RowBox[{"target", ",", " ", "1"}], "]"}]}], "]"}]}], "|>"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"DisplacementPlot", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"blurred", ",", " ", 
          RowBox[{"DisplacementReduce", "[", 
           RowBox[{"g", ",", " ", "blurred"}], "]"}]}], "}"}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"07247c0f-5e4b-419e-aadb-1aeb23268be1"],

