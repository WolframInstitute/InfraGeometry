Cell["\<\
Each reduced value is a subset of the original one. The numbers of values of \
the outward radial displacement of the mesh, with their counts, before and \
after:\
\>", "ExampleText",ExpressionUUID->"9911138c-39fd-4507-8151-bd00b5318465"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"radial", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"PolarDisplacements", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"reduced", " ", "=", " ", 
     RowBox[{"DisplacementReduce", "[", 
      RowBox[{"g", ",", " ", "radial"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"SubsetQ", "[", 
         RowBox[{
          RowBox[{"radial", "[", "#", "]"}], ",", " ", 
          RowBox[{"reduced", "[", "#", "]"}]}], "]"}], " ", "&"}]}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"KeySort", " ", "@", " ", 
      RowBox[{"Counts", "[", 
       RowBox[{"Length", " ", "/@", " ", "radial"}], "]"}]}], ",", " ", 
     RowBox[{"KeySort", " ", "@", " ", 
      RowBox[{"Counts", "[", 
       RowBox[{"Length", " ", "/@", " ", "reduced"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a50d2172-925d-4121-9d14-6c7c24ca9559"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"1", "\[Rule]", "40"}], ",", 
     RowBox[{"2", "\[Rule]", "36"}], ",", 
     RowBox[{"3", "\[Rule]", "22"}], ",", 
     RowBox[{"4", "\[Rule]", "2"}], ",", 
     RowBox[{"5", "\[Rule]", "1"}], ",", 
     RowBox[{"7", "\[Rule]", "1"}]}], "\[RightAssociation]"}], ",", 
