     RowBox[{"3", "\[Rule]", "5"}], ",", 
     RowBox[{"4", "\[Rule]", "2"}], ",", 
     RowBox[{"5", "\[Rule]", "1"}], ",", 
     RowBox[{"7", "\[Rule]", "1"}]}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ad96b54d-c47b-48b7-ad04-4c14bfa144fe"]
}, Open  ]]
