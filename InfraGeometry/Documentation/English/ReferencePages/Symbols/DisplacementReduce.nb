Cell["\<\
A tie survives. The two outward neighbours of a vertex off the axes of the \
square tiling are equally central, so the outward radial displacement is \
already reduced.\
\>", "ExampleText",ExpressionUUID->"441c122e-2959-4244-8f0c-f7f0b37fcd47"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"radial", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"PolarDisplacements", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", "radial"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"DisplacementReduce", "[", 
       RowBox[{"g", ",", " ", "radial"}], "]"}], " ", "===", " ", "radial"}], 
     ",", " ", 
     RowBox[{"DisplacementSingleValuedQ", "[", "radial", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7773427c-1e8f-4a05-b1ce-8d89903a1ade"],

