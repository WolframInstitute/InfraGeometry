Cell["\<\
Three vertices on a circle reduce to the middle one. Two outward radial steps \
from the vertex 56 of the grid:\
\>", "ExampleText",ExpressionUUID->"3dee6206-877f-4f39-8f89-7f1fe057a05a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"radial", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"PolarDisplacements", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"twoSteps", " ", "=", " ", 
     RowBox[{"KeyTake", "[", 
      RowBox[{
       RowBox[{"DisplacementCompose", "[", 
        RowBox[{"radial", ",", " ", "radial"}], "]"}], ",", " ", 
       RowBox[{"{", "56", "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"twoSteps", ",", " ", 
       RowBox[{"DisplacementReduce", "[", 
        RowBox[{"g", ",", " ", "twoSteps"}], "]"}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"twoSteps", "[", "56", "]"}], ",", " ", 
        RowBox[{
         RowBox[{"DisplacementReduce", "[", 
          RowBox[{"g", ",", " ", "twoSteps"}], "]"}], "[", "56", "]"}]}], 
       "}"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f487d680-334d-457d-8c88-d19e4b4217c6"],

