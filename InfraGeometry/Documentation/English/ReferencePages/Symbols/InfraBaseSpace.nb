Cell["\<\
The tangent bundle at scale 2 and the displacement bundle at scale 1 of the \
square mesh have the mesh as base:\
\>", "ExampleText",ExpressionUUID->"efd8085c-2726-487f-ac74-b7d6e488a869"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"Sort", " ", "/@", " ", 
        RowBox[{"EdgeList", " ", "@", " ", 
         RowBox[{"InfraBaseSpace", "[", "fib", "]"}]}]}], "]"}], " ", "===", 
      " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"Sort", " ", "/@", " ", 
        RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraTangentBundle", "[", 
          RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"InfraDisplacementBundle", "[", 
          RowBox[{"g", ",", " ", "1"}], "]"}]}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a4edb021-bf47-4955-bdb7-2907474168b1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ecfa5c18-867a-40b1-9a32-956338318d06"]
}, Open  ]]
}, Open  ]],

