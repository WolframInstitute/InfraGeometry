Cell["\<\
The prism over the cycle of length 8 has 24 edges. Its 8 rungs are vertical, \
and its base is the cycle with 8 edges:\
\>", "ExampleText",ExpressionUUID->"9004f410-97c3-455e-a531-c36bc89985f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<CycleProductBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"EdgeCount", " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraTotalSpace", "[", "fib", "]"}], ",", " ", 
         RowBox[{"InfraBaseSpace", "[", "fib", "]"}]}], "}"}]}]}], ",", "\n", 
     "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b7813926-76eb-4925-b8c1-2beb1b77e089"],

