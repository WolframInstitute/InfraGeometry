Cell[CellGroupData[{
Cell["InfraBaseSpace", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"500c57d4-d449-4b4d-8e67-fc2476ec5f0b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBaseSpace"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBaseSpace", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b6ffa2e-da6a-467a-ae49-b9cd825dcdb2"],
 "\[LineSeparator]",
 "gives the base graph of the fibered graph ",
 StyleBox["fib", "TI"],
 ": the projected vertices, two of them adjacent when a total edge joins \
their fibers.",
 "\n"
}], "Usage",ExpressionUUID->"f63a9c4e-82cc-48c8-a002-ccafea0b4a71"],

Cell[TextData[{
 "For a total graph ",
 StyleBox["E", "TI"],
 " and a projection ",
 StyleBox["\[Pi]", "TI"],
 ", the base ",
 StyleBox["B", "TI"],
 " has the vertices ",
 StyleBox["\[Pi](V(E))", "TI"],
 ", and ",
 StyleBox["p \[NotEqual] q", "TI"],
 " are adjacent iff some edge ",
 StyleBox["{x, y}", "TI"],
 " of ",
 StyleBox["E", "TI"],
 " has ",
 StyleBox["\[Pi](x) = p", "TI"],
 " and ",
 StyleBox["\[Pi](y) = q", "TI"],
 "."
}], "Notes",ExpressionUUID->"87baca33-bac3-429f-ad38-207259bc22fa"],

Cell[TextData[{
 "The base is reconstructed from ",
 StyleBox["E", "TI"],
 " and ",
 StyleBox["\[Pi]", "TI"],
 ", never stored. A vertical edge, inside one fiber, gives no base edge. A \
projected vertex with no edge to another fiber is an isolated base vertex."
}], "Notes",ExpressionUUID->"440fae3e-cf4c-479a-9e05-73be1c297fc1"],

Cell["\<\
A base edge exists only if some total edge lies over it. Deleting the total \
edges over a base edge deletes the base edge.\
\>", "Notes",ExpressionUUID->"4a27d426-e23c-4c44-b78f-2fc9349d8c7a"],

Cell[TextData[{
 "The construction heads ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTangentBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTangentBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a5702f89-d16e-4210-8922-55d759c0cdca"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCotangentBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCotangentBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "229f532e-0b3d-4512-b291-4b069a958df2"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDisplacementBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4f4ae65a-e61a-4376-8731-d4d95aacad62"],
 " are fibered graphs too, and their base is the graph they are built on."
}], "Notes",ExpressionUUID->"8d74283a-6b90-46c5-9271-e30fbff61132"]
}, Open  ]],

