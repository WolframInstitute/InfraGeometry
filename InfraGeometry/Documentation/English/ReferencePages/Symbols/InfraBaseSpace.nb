Cell["\<\
The base of a double cover of the square grid is the grid. A total graph with \
288 edges gives a base with 144:\
\>", "ExampleText",ExpressionUUID->"708b3ac7-d0ce-475c-9dfb-72837d54c49e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Covering\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"base", " ", "=", " ", 
     RowBox[{"InfraBaseSpace", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"EdgeCount", " ", "@", " ", 
      RowBox[{"InfraTotalSpace", "[", "fib", "]"}]}], ",", " ", 
     RowBox[{"EdgeCount", "[", "base", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"EdgeList", "[", "base", "]"}]}], " ", "===", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"EdgeList", "[", "g", "]"}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a12ce90b-dd2a-445c-aa88-e88c738b9172"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"288", ",", "144", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"2b358f7b-0146-4803-acc7-d4f583a98c45"]
}, Open  ]]
}, Open  ]],

