Cell["\<\
Deleting the two total edges over an edge at the centre of the grid deletes \
that base edge. The result is still a fibration, over the smaller base:\
\>", "ExampleText",ExpressionUUID->"4d413e95-361a-43e5-8501-06116c97d367"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"AdjacencyList", "[", 
       RowBox[{"g", ",", " ", "c"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Covering\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalSpace", "[", "fib", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"over", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"EdgeList", "[", "total", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Sort", "[", 
          RowBox[{"First", " ", "/@", " ", 
           RowBox[{"List", " ", "@@", " ", "#"}]}], "]"}], " ", "==", " ", 
         RowBox[{"Sort", "[", 
          RowBox[{"{", 
           RowBox[{"c", ",", " ", "q"}], "}"}], "]"}]}], " ", "&"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cut", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"EdgeDelete", "[", 
        RowBox[{"total", ",", " ", "over"}], "]"}], ",", " ", "First"}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"EdgeCount", " ", "@", " ", 
      RowBox[{"InfraBaseSpace", "[", "cut", "]"}]}], ",", " ", 
     RowBox[{"EdgeQ", "[", 
      RowBox[{
       RowBox[{"InfraBaseSpace", "[", "cut", "]"}], ",", " ", 
       RowBox[{"c", " ", "<->", " ", "q"}]}], "]"}], ",", " ", 
     RowBox[{"InfraFibrationQ", "[", "cut", "]"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"2dee149f-61ea-41fe-a4bf-e1ee050d3655"],

