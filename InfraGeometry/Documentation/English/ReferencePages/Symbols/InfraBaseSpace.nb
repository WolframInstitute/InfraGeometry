Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"Graph", "[", 
        RowBox[{
         RowBox[{"Range", "[", "5", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", " ", "<->", " ", "2"}], ",", " ", 
           RowBox[{"2", " ", "<->", " ", "3"}]}], "}"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<a\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<a\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<b\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<b\>\""}], ",", " ", 
         RowBox[{"5", " ", "->", " ", "\"\<c\>\""}]}], "|>"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraFiberedGraphHighlight", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"VertexLabels", " ", "->", " ", "Automatic"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"InfraBaseSpace", "[", "fib", "]"}], ",", " ", 
        RowBox[{"VertexLabels", " ", "->", " ", "Automatic"}]}], "]"}]}], 
     "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b130cf73-7637-41c5-9900-d4a09f89f039"],

