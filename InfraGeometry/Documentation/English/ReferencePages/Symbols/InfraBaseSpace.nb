Cell[CellGroupData[{
Cell["InfraBaseSpace", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"50dee832-3c72-4361-9d05-fea8d2af7127"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBaseSpace"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBaseSpace", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb223104-e6d7-4ca9-b8bd-b182e160e975"],
 "\[LineSeparator]",
 "gives the graph reconstructed from the projection values and the transverse \
total edges of ",
 StyleBox["fib", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"0205ced7-0c7e-4c6a-b66c-6272217d06d2"],

Cell["\<\
The base is reconstructed, not stored as an independent argument.\
\>", "Notes",ExpressionUUID->"96a714e1-1f92-4780-8c78-2709935d62f0"],

Cell["\<\
Every projection value is a base vertex. Distinct values are adjacent exactly \
when some total edge joins their preimages.\
\>", "Notes",ExpressionUUID->"fe1e292c-4a44-4431-990f-a30180da415a"],

Cell["\<\
A vertical edge has equal projection values at its endpoints and contributes \
no base edge.\
\>", "Notes",ExpressionUUID->"cfd04299-c884-46ae-b7fd-c640cf3103ab"],

Cell["\<\
Isolated projection values remain in the base. A value absent from the \
projection cannot be a base vertex.\
\>", "Notes",ExpressionUUID->"1471290d-5800-42fd-903b-f0551957a0b3"],

Cell["\<\
The projection is onto this reconstructed vertex set by construction.\
\>", "Notes",ExpressionUUID->"982455ac-97cf-434c-9e9d-e06d97f6d0bb"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBaseGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBaseGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2269ff96-1e96-4f32-8ea0-35f453c6c610"],
 " is the compatibility spelling."
}], "Notes",ExpressionUUID->"519fdeca-dba9-468d-90b5-a0ab65b3f35d"]
}, Open  ]],

