Notebook[{

Cell[CellGroupData[{
Cell["InfraBaseSpace", "ObjectName",ExpressionUUID->"333af258-3295-4c8b-b0f2-0d0ec5af7da4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e24dcfec-fc12-4d67-b492-8374b631ec16"],
 Cell[BoxData[
  RowBox[{"InfraBaseSpace", "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbf21552-eb13-45b8-bf0a-b0f0dddbe4e3"],
 "\[LineSeparator]",
 "gives the graph reconstructed from the projection values and the transverse \
total edges of ",
 StyleBox["fib", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"9d2a401a-3535-44d3-844e-18b399b9d091"],

Cell["\<\
The base is reconstructed, not stored as an independent argument.\
\>", "Notes",ExpressionUUID->"f743ce58-efac-47fc-b23b-6e45dadc2572"],

Cell["\<\
Every projection value is a base vertex. Distinct values are adjacent exactly \
when some total edge joins their preimages.\
\>", "Notes",ExpressionUUID->"a6fce695-d620-4e01-b40e-856d028dc09a"],

Cell["\<\
A vertical edge has equal projection values at its endpoints and contributes \
no base edge.\
\>", "Notes",ExpressionUUID->"a1f1de5d-9da3-4ea5-a2a1-65b52e6a6903"],

Cell["\<\
Isolated projection values remain in the base. A value absent from the \
projection cannot be a base vertex.\
\>", "Notes",ExpressionUUID->"4e6a80de-7357-4ade-8689-b20452d96f52"],

Cell["\<\
The projection is onto this reconstructed vertex set by construction.\
\>", "Notes",ExpressionUUID->"665da702-78fd-4b09-9505-673275ad5249"],

