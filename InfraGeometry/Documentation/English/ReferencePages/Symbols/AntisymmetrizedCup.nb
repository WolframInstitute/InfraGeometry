}], "Usage",ExpressionUUID->"05d7d9bf-6117-4938-8874-e70a8184c3b9"],

Cell[TextData[{
 "Definition: the Alexander\[Dash]Whitney product averaged with signs over \
all orderings of each clique, ",
 StyleBox["(\[Alpha] \:222a \[Beta])(v\:2080, \[Ellipsis], v\:2099) = (1/(n + \
1)!) \[CapitalSigma] sgn(\[Sigma]) \[Alpha](\[Sigma]\:2080, \[Ellipsis], \
\[Sigma]\:209a) \[Beta](\[Sigma]\:209a, \[Ellipsis], \[Sigma]\:2099)", "TI"],
 ", as on the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "68ed49e5-6849-43c1-af9d-49b62c9988a5"],
 " page."
}], "Notes",ExpressionUUID->"49b41d34-166a-4f0f-aefc-80ecd9038543"],

