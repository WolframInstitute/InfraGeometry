Cell[TextData[{
 "The thickness needed follows the girth: on the hexagonal tiling the band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", " ", "5"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c4b493-c9cd-496d-97cc-04dc4f5db9c3"],
 " is still empty, and ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", " ", "6"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33beb9ee-3852-475d-a604-787cac0b11d5"],
 " carries the circles."
}], "ExampleText",ExpressionUUID->"88d059a6-dd92-4007-a1f3-d9257be64cc9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
           " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"circles", " ", "=", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"c", ",", " ", "band"}], "]"}], ",", " ", "All"}], "]"}]}],
        "}"}], ",", "\n", "    ", 
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", "\n", "        ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"FindInfraShell", "[", 
              RowBox[{"g", ",", " ", "c", ",", " ", "band"}], "]"}], " ", "->",
              " ", "$InfraShellColor"}], ",", "\n", "         ", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"Graph", "[", 
                RowBox[{"DirectedEdge", " ", "@@@", " ", 
                 RowBox[{"Partition", "[", 
                  RowBox[{
                  "oneCircle", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], 
                  "]"}]}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"oneCircle", ",", " ", "circles"}], "}"}]}], "]"}], 
             " ", "->", " ", "$InfraCircleColor"}]}], "}"}]}], "]"}], ",", 
        "\n", "      ", 
        RowBox[{"Length", " ", "@", " ", "circles"}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"band", ",", " ", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "5"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "6"}], "}"}]}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"f2ae3f18-7cbb-466e-a972-3d376aa2efe0"],

