Cell[TextData[{
 "The band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "4"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3aabfdd-0d8b-42f4-ab0a-c85eeed1ed82"],
 " on the square tiling: the number of circles, their length and the number \
of necklaces carrying them, beside the picture."
}], "ExampleText",ExpressionUUID->"8423db20-d32e-40ab-885b-401b2d312aa8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"InfraCircle", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"circle", " ", "->", " ", "$InfraCircleColor"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c"}],
         "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "circle", ",", " ", "\"\<Cardinality\>\""}], 
      "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "circle", ",", " ", "\"\<Length\>\""}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "circle", ",", " ", "\"\<Graph\>\""}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7f226c15-7a9d-45ce-87b8-e75503edf0b2"],

