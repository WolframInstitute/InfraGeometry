Cell[TextData[{
 "Every circle of the band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "4"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "322e974f-09c0-486d-9123-0bdc7aa67dd7"],
 " on the square tiling, drawn at once. A bounded count gives a list, and a \
strict count that cannot be met gives ",
 Cell[BoxData[
  RowBox[{"{", " ", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02a3b978-be82-49f3-bf11-0898e05c4549"],
 "."
}], "ExampleText",ExpressionUUID->"8e4f43e3-a1f7-4d91-932f-d467360d378c"],

