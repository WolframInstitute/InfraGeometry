Cell[CellGroupData[{
Cell["InfraCircle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"91030690-4efd-489c-9890-6c9ec403336a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "093012cb-c221-43d8-a0d0-c32fdbb9e9e0"],
 "\[LineSeparator]",
 "is the circle around ",
 StyleBox["c", "TI"],
 " through ",
 StyleBox["p", "TI"],
 ". It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "305d76ec-35f5-4670-bf18-ff85d1df5c6a"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraVertexList", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "22a74ea5-ee7f-4624-b3e4-074415e921b6"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f451378a-3bdc-4897-9717-be82cd105c43"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
     StyleBox["r", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15af35a0-73bb-45c3-9274-5c655f6c812c"],
 "\[LineSeparator]",
 "is the family of circles around ",
 StyleBox["c", "TI"],
 " at radius ",
 StyleBox["r", "TI"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["r", "TI"], ",", " ", 
       StyleBox["s", "TI"]}], "}"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ed2bbb4-83d3-4ea1-a3ac-770f24863ab0"],
 " the family in the band ",
 StyleBox["r", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["s", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2b738c7f-d9ac-408d-bccd-9c5a2d22690d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26592bc5-9343-43b6-a23d-64694fc535cf"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ff142809-8e01-4a0f-a1b7-af57ce257d67"],
 " is the circle construction token by radius; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "be64e10a-2e93-4d75-8f24-4616f3dc7455"],
 " is the search."
}], "Usage",ExpressionUUID->"47e44b02-3754-4b05-b807-9d54cc95fc65"],

Cell[TextData[{
 "Definition: a circle of the band ",
 StyleBox["W", "TI"],
 " around ",
 StyleBox["c", "TI"],
 " is a shortest cycle of the subgraph induced on ",
 StyleBox["W", "TI"],
 " whose removal leaves ",
 StyleBox["c", "TI"],
 " in a component that reaches no further than the band."
}], "Notes",ExpressionUUID->"8b0f8688-9aa7-444e-aa88-a7b251a3f81b"],

Cell[TextData[{
 "The point form takes the band at ",
 StyleBox["d(c, p)", "TI"],
 " and keeps the circles through ",
 StyleBox["p", "TI"],
 ". Option ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b1ff8e9-3d5e-4cbb-8c37-35271e8ce4c7"],
 " widens it to ",
 StyleBox["d(c, p)", "TI"],
 " \[Minus] ",
 StyleBox["deltaIn", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, p)", "TI"],
 " + ",
 StyleBox["deltaOut", "TI"],
 ". A scalar ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "delta"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86411cea-46e3-4f62-b995-241bcef31d57"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20572ccc-93c8-4656-a9a6-976d4d769128"],
 ", outward only. The default is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9fa01e53-1f12-4263-8c14-930d28121c78"],
 "."
}], "Notes",ExpressionUUID->"514acb17-b670-4bb4-bb2a-e25bf93aeb36"],

Cell[TextData[{
 StyleBox["A circle need not exist.",
  FontWeight->"Bold"],
 " On a lattice a single distance shell has no two adjacent vertices, so it \
spans no cycle and the family is empty. Widening the radius to a band fixes \
it."
}], "Notes",ExpressionUUID->"a3bac0ad-f643-4f1d-be95-3b739be91ffe"],

Cell[TextData[{
 "Its graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["circle", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29bd047a-2d18-4f67-adae-51e4b335930c"],
 " \[LongDash] is a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d37f35cb-44d2-4a79-9109-c0d25b0cd9ea"],
 " of necklaces, cut from the band along a radial seam: a geodesic from ",
 StyleBox["c", "TI"],
 " to just outside the band. A necklace is a DAG with one source ",
 StyleBox["s1", "TI"],
 " and one sink ",
 StyleBox["u", "TI"],
 ". It is the cycle family ",
 StyleBox["opened",
  FontWeight->"Bold"],
 " at its closing arrow ",
 StyleBox["u", "TI"],
 " -> ",
 StyleBox["s1", "TI"],
 ", which is left out, so the DAG is acyclic."
}], "Notes",ExpressionUUID->"4a59b2df-f302-4cbb-a567-d32f97efdc5f"],

Cell[TextData[{
 "A member is the open chain ",
 StyleBox["s1", "TI"],
 " \[Ellipsis] ",
 StyleBox["u", "TI"],
 ", read cyclically: a cyclic vertex list whose first vertex is not repeated. \
Its ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4778d182-120b-4b44-8992-b1c951b4d53e"],
 " counts the closing edge too, so a circle of ",
 StyleBox["k", "TI"],
 " vertices has length ",
 StyleBox["k", "TI"],
 "."
}], "Notes",ExpressionUUID->"d8a61e46-6f99-4ca2-bbe5-a637ea4c6cc1"],

Cell[TextData[{
 "Every member separates. That the necklaces carry every circle exactly once \
needs two hypotheses on the substrate \[LongDash] the winding functional and \
the one-run hypothesis \[LongDash] which nothing here certifies. So ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85651c61-013a-4bc8-9999-0d37a2497c57"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "66a74855-af50-416c-9440-da4096c5e1ac"],
 "."
}], "Notes",ExpressionUUID->"351f3c10-e4e1-4aec-a7c0-0e69fefda1fc"],

Cell[TextData[{
 "Inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "44e59667-a925-461c-83f6-d56f2fb267e7"],
 ", the token ",
 Cell[BoxData[
  RowBox[{"InfraCircle", "[", 
   RowBox[{"c", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3903656a-98ba-4f28-98af-b4591c08c353"],
 " still reads ",
 StyleBox["r", "TI"],
 " as a radius, unlike the head, where a bare second argument is always a \
point. This is an open inconsistency."
}], "Notes",ExpressionUUID->"d189358a-3a5d-4d8e-8e9b-b856fac2b0ce"]
}, Open  ]],

