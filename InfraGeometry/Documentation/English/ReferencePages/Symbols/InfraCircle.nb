Cell[TextData[{
 "The circles of the band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "4"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12f00b1d-fc59-45ed-90f0-a39ea029f005"],
 " about the centre of a grid: sixteen of them, each of length 16. An edge is \
drawn as strongly as the number of circles through it."
}], "ExampleText",ExpressionUUID->"657cab39-0d21-4527-9bb9-4f9817ce3dae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"InfraCircle", "[", 
      RowBox[{"41", ",", " ", 
       RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "4"}], "}"}]}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraHighlightGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"circle", " ", "->", " ", "$InfraCircleColor"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
         "41"}], "}"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "circle", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Cardinality\>\"", ",", " ", "\"\<Length\>\""}], "}"}]}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0306dea0-50ac-4188-9db5-e1f9793fa262"],

