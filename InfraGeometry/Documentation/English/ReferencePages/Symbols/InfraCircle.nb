Cell["\<\
A circle lies in its band, and consecutive vertices are adjacent, the last \
and the first too.\
\>", "ExampleText",ExpressionUUID->"ab7fcfd3-9461-4b60-b2b2-c29111e80416"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"band", " ", "=", " ", 
     RowBox[{"FindInfraShell", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"closedWalk", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"band", " ", "->", " ", "$InfraShellColor"}], ",", " ", 
         RowBox[{
          RowBox[{"InfraWalk", "[", 
           RowBox[{"Append", "[", 
            RowBox[{"closedWalk", ",", " ", 
             RowBox[{"First", " ", "@", " ", "closedWalk"}]}], "]"}], "]"}], 
          " ", "->", " ", "$InfraCircleColor"}]}], "}"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"SubsetQ", "[", 
      RowBox[{"band", ",", " ", "closedWalk"}], "]"}], ",", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Partition", "[", 
        RowBox[{"closedWalk", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], 
        "]"}], ",", " ", 
       RowBox[{
        RowBox[{"EdgeQ", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"UndirectedEdge", " ", "@@", " ", "#"}]}], "]"}], " ", 
        "&"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1c538a34-9525-478c-8dd4-c6dba56cf900"],

