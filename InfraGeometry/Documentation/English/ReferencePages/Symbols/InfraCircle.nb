Cell[TextData[{
 "On the square grid the bands {",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["r", "TI"],
 " + 1} and {",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["r", "TI"],
 " + 2}: one circle and ",
 StyleBox["16\:02b3\:207b\.b9", "TI"],
 " circles, of length ",
 StyleBox["8r", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"45c37dab-f338-4822-a510-24a9b1ba4c79"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCircle", "[", 
          RowBox[{"c", ",", " ", 
           RowBox[{"{", 
            RowBox[{"r", ",", " ", 
             RowBox[{"r", " ", "+", " ", "1"}]}], "}"}]}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}], ",", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCircle", "[", 
          RowBox[{"c", ",", " ", 
           RowBox[{"{", 
            RowBox[{"r", ",", " ", 
             RowBox[{"r", " ", "+", " ", "2"}]}], "}"}]}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}], ",", "\n", "    ", 
       RowBox[{"16", "^", 
        RowBox[{"(", 
         RowBox[{"r", " ", "-", " ", "1"}], ")"}]}], ",", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCircle", "[", 
          RowBox[{"c", ",", " ", 
           RowBox[{"{", 
            RowBox[{"r", ",", " ", 
             RowBox[{"r", " ", "+", " ", "2"}]}], "}"}]}], "]"}], ",", 
         " ", "\"\<Length\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "1", ",", " ", "5"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f6673c6e-47b3-4783-ad05-43d6199f6a98"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "16", ",", "16", ",", "16"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "256", ",", "256", ",", "24"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "4096", ",", "4096", ",", "32"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "65536", ",", "65536", ",", "40"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d18189d5-9292-4a01-9b26-beb0adf1cb38"]
}, Open  ]],

Cell[TextData[{
 "Every circle separates: without it, the vertices still joined to ",
 StyleBox["c", "TI"],
 " lie within distance 3, inside the band {3, 4}:"
}], "ExampleText",ExpressionUUID->"1d793ff0-72dc-481b-8028-11dde7c0ecaa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Union", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Max", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "&"}], " ",
         "/@", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"ConnectedComponents", "[", 
          RowBox[{
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "circle"}], "]"}], ",", " ", 
           RowBox[{"{", "c", "}"}]}], "]"}]}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"circle", ",", " ", 
        RowBox[{"RandomInfraCircle", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{"{", 
             RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", "All"}], 
         "]"}]}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"33bd519d-2538-4883-91dd-539790b8c377"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"ce974353-10a1-4913-bc1b-7dc436825f49"]
}, Open  ]],

Cell[TextData[{
 "The members of the closed arc through ",
 StyleBox["p", "TI"],
 " are the circles through ",
 StyleBox["p", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"383e24a2-1ae7-40bf-8284-7e150e355dcc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", "[", 
     RowBox[{"Sort", " ", "/@", " ", 
      RowBox[{"RandomInfraArc", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraArc", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{"{", "p", "}"}], ",", " ", 
          RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "1"}]}], "]"}], ",", 
        " ", "All"}], "]"}]}], "]"}], " ", "===", "\n", "    ", 
    RowBox[{"Sort", "[", 
     RowBox[{"Sort", " ", "/@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"RandomInfraCircle", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{"{", 
             RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", "All"}], 
         "]"}], ",", " ", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"#", ",", " ", "p"}], "]"}], " ", "&"}]}], "]"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"890a1fa5-d50e-481e-aa20-ad65c785cd5b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"719db9b8-291b-42ba-b25b-9325a6b23c74"]
}, Open  ]]
