Cell["\<\
The search sweeps the band directly and finds as many circles as the atoms \
carry.\
\>", "ExampleText",ExpressionUUID->"31c56c77-ab90-46db-970d-95dcaa02ca5c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"InfraCircle", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"circle", ",", " ", "c"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "circle", ",", " ", "\"\<Cardinality\>\""}], 
      "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"Replace", "[", " ", 
       RowBox[{"circle", ",", " ", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"token_InfraPoint", " ", ":>", " ", 
           RowBox[{"RandomInfraPoint", "[", " ", 
            RowBox[{"g", ",", " ", "token", ",", " ", "All"}], " ", "]"}]}], ",",
           " ", 
          RowBox[{"token_InfraSegment", " ", ":>", " ", 
           RowBox[{"RandomInfraSegment", "[", " ", 
            RowBox[{"g", ",", " ", "token", ",", " ", "All"}], " ", "]"}]}], ",",
           " ", 
          RowBox[{"token_InfraHalfLine", " ", ":>", " ", 
           RowBox[{"RandomInfraHalfLine", "[", " ", 
            RowBox[{"g", ",", " ", "token", ",", " ", "All"}], " ", "]"}]}], ",",
           " ", 
          RowBox[{"token_InfraInfiniteLine", " ", ":>", " ", 
           RowBox[{"RandomInfraInfiniteLine", "[", " ", 
            RowBox[{"g", ",", " ", "token", ",", " ", "All"}], " ", "]"}]}], ",",
           " ", 
          RowBox[{"token_InfraCircle", " ", ":>", " ", 
           RowBox[{"RandomInfraCircle", "[", " ", 
            RowBox[{"g", ",", " ", "token", ",", " ", "All"}], " ", "]"}]}], ",",
           " ", 
