Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "98e30a26-4bc7-4912-b547-228e6be1da58"],
 " searches the band directly and finds as many circles."
}], "ExampleText",ExpressionUUID->"476c0987-8f30-41c8-945f-01b6c206b5c6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"InfraCircle", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"circle", " ", "->", " ", "$InfraCircleColor"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c"}],
         "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "circle", ",", " ", "\"\<Cardinality\>\""}], 
      "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraCircle", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", "All"}], "]"}]}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1a96e798-6281-4784-84f3-5951758793df"],

