Cell["\<\
At a single radius the circle exists on the irregular mesh and not on the two \
lattices: their shell has no two adjacent vertices. Each picture shows the \
shell and the circles found in it, labelled by their number.\
\>", "ExampleText",ExpressionUUID->"af692460-7c57-490f-8e42-8efb85bcb94e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"Row", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"circles", " ", "=", " ", 
        RowBox[{"RandomInfraCircle", "[", " ", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", "All"}], " ", 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", "\n", "        ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"FindInfraShell", "[", 
             RowBox[{"g", ",", " ", "c", ",", " ", "4"}], "]"}], ",", "\n", 
            "         ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Graph", "[", 
               RowBox[{"DirectedEdge", " ", "@@@", " ", 
                RowBox[{"Partition", "[", 
                 RowBox[{
                 "oneCircle", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], 
                 "]"}]}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"oneCircle", ",", " ", "circles"}], "}"}]}], "]"}]}], 
           "}"}]}], "]"}], ",", "\n", "      ", 
        RowBox[{"Length", " ", "@", " ", "circles"}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"ff4cec56-ad8e-49fe-adcb-62fd75c08441"],

