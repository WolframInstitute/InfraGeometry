Notebook[{

Cell[CellGroupData[{
Cell["InfraCircle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a6a1a021-b297-4042-8a75-974353ecb871"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa26eae8-5c58-4f90-a28c-868c5fb92029"],
 "\[LineSeparator]",
 "is the family of circles around ",
 StyleBox["c", "TI"],
 " at radius ",
 StyleBox["r", "TI"],
 ". It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "eac3921e-3be3-4f63-a29f-de71796c6875"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "355ecbb1-29a5-48d8-8a9b-07780928aad2"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a1028279-1990-4519-97ae-69a71a2198ac"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4741cc01-b42c-41e9-8d2c-94808d1eca9e"],
 "\[LineSeparator]",
 "is the family in the band ",
 StyleBox["r", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["s", "TI"],
 "; a scalar ",
 StyleBox["r", "TI"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "r"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ac2066a-8f5c-452a-8042-ce5897fc11e3"],
 ".",
 "\n",
 "The same expression inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7f541ddc-1cfd-4abb-9f7b-4d0b09613bf6"],
 " is the circle construction token; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ae1d787a-eb6d-42ed-abfc-d3ded4d87b27"],
 " is the search."
}], "Usage",ExpressionUUID->"ce294e15-f7f8-4fdb-af29-e900f4e3c15b"],

Cell[TextData[{
 "Definition: a circle of the band ",
 StyleBox["W", "TI"],
 " around ",
 StyleBox["c", "TI"],
 " is a shortest cycle of the subgraph induced on ",
 StyleBox["W", "TI"],
 " whose removal leaves ",
 StyleBox["c", "TI"],
 " in a component that reaches no further than the band."
}], "Notes",ExpressionUUID->"0b3b32d1-b406-46bf-b327-cca5a42b1412"],

Cell["\<\
The second argument is always a radius or a band, never a point, so a vertex \
label that is an integer or a pair cannot be mistaken for one. There are no \
options.\
\>", "Notes",ExpressionUUID->"ba158852-9cdb-4cca-b222-22e67191f591"],

Cell[TextData[{
 "Euclid's third postulate describes a circle with any centre and distance: \
the circle is named by its radius. The circle through a point ",
 StyleBox["p", "TI"],
 " is drawn by a compass opened to ",
 StyleBox["p", "TI"],
 ", an arc that closes: it is the closed arc ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "356d7d8a-17b5-400f-b3da-7f0968190b5f"],
 ", the circles of the band of ",
 StyleBox["p", "TI"],
 " that pass through ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"d3847b89-82c8-42d1-967c-4df6794a15f7"],

Cell[TextData[{
 StyleBox["A circle need not exist.",
  FontWeight->"Bold"],
 " On a lattice a single distance shell has no two adjacent vertices, so it \
spans no cycle and the family is empty. Widening the radius to a band fixes \
it."
}], "Notes",ExpressionUUID->"4deaff04-0f6c-47c8-b3dc-a9cac2106022"],

Cell[TextData[{
 "Its graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["circle", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea2b90e7-cd20-4399-ad9c-1af54a9bce74"],
 " \[LongDash] is a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2fa650c-f6a5-40b3-b79e-900a26fa53a8"],
 " of necklaces, cut from the band along a radial seam: a shortest path from ",
 StyleBox["c", "TI"],
 " to just outside the band. A necklace is a DAG with one source ",
 StyleBox["s1", "TI"],
 " and one sink ",
 StyleBox["u", "TI"],
 ". It is the cycle family ",
 StyleBox["opened",
  FontWeight->"Bold"],
 " at its closing arrow ",
 StyleBox["u", "TI"],
 " -> ",
 StyleBox["s1", "TI"],
 ", which is left out, so the DAG is acyclic."
}], "Notes",ExpressionUUID->"5b3f6954-268f-4d00-8ad2-bfccb041f1b9"],

Cell[TextData[{
 "A member is the open chain ",
 StyleBox["s1", "TI"],
 " \[Ellipsis] ",
 StyleBox["u", "TI"],
 ", read cyclically: a cyclic vertex list whose first vertex is not repeated. \
Its ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a090355-a67c-4ffa-9807-21aa3d8c5409"],
 " counts the closing edge too, so a circle of ",
 StyleBox["k", "TI"],
 " vertices has length ",
 StyleBox["k", "TI"],
 "."
}], "Notes",ExpressionUUID->"3ee9b49f-d3b6-432a-a855-d50a7653e193"],

Cell[TextData[{
 "Every member separates. That the necklaces carry every circle exactly once \
needs two hypotheses on the substrate \[LongDash] the winding functional and \
the one-run hypothesis \[LongDash] which nothing here certifies. So ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a2bcb4b-7613-4263-9ee3-060d9ff3d731"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e606c39e-b602-427a-979b-d51f01f198db"],
 "."
}], "Notes",ExpressionUUID->"1caca28d-af64-4bd5-94f7-478818f5d7af"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"8a214fea-b04a-4504-b08a-87d27b98ba68"],

