Cell[TextData[{
 "Every circle of the band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "4"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a52aa8d9-3293-48cd-ae84-27ed5e87d26f"],
 " on the square tiling, drawn at once. A bounded count gives a list, and a \
strict count that cannot be met gives ",
 Cell[BoxData[
  RowBox[{"{", " ", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1cb552a-9ede-4b97-8441-3e2dbe51b229"],
 "."
}], "ExampleText",ExpressionUUID->"4d67573f-a145-4cde-97f9-6a637be09b37"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"InfraCircle", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"circles", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", "circle", ",", " ", "All"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Graph", "[", 
            RowBox[{"DirectedEdge", " ", "@@@", " ", 
             RowBox[{"Partition", "[", 
              RowBox[{
              "oneCircle", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], 
              "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"oneCircle", ",", " ", "circles"}], "}"}]}], "]"}], " ", "->",
          " ", "$InfraCircleColor"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Length", " ", "@", " ", "circles"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", "circle", ",", " ", "3"}], "]"}]}], ",", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", "circle", ",", " ", "20"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8a15a141-e8cc-45ac-8ca6-8154ca7bc36b"],

