Cell["\<\
A member is a cyclic vertex list. Drawn as a walk, it closes back on its \
first vertex.\
\>", "ExampleText",ExpressionUUID->"067f7cff-170a-4d79-afc8-120ba34b157a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"closedWalk", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraWalk", "[", 
         RowBox[{"Append", "[", 
          RowBox[{"closedWalk", ",", " ", 
           RowBox[{"First", " ", "@", " ", "closedWalk"}]}], "]"}], "]"}], 
        " ", "->", " ", "$InfraCircleColor"}], ",", " ", 
       RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c"}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"4d402f45-2164-4bbd-ac13-9194bd88be03"],

