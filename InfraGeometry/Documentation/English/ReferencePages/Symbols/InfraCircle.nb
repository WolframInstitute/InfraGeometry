Cell["\<\
A member is a cyclic vertex list. Drawn as a walk, it closes back on its \
first vertex.\
\>", "ExampleText",ExpressionUUID->"cf2a9fb3-fdcd-44bb-9e35-cc2b50973a96"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"closedWalk", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraWalk", "[", 
         RowBox[{"Append", "[", 
          RowBox[{"closedWalk", ",", " ", 
           RowBox[{"First", " ", "@", " ", "closedWalk"}]}], "]"}], "]"}], 
        " ", "->", " ", "$InfraCircleColor"}], ",", " ", 
       RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c"}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"6a3fa696-cce2-4b95-bbfd-335f5bb0d3e8"],

