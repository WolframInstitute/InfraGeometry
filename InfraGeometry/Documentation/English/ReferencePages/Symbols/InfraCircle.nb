Cell["\<\
One circle about the centre of each lattice, at the band each one needs, \
drawn as its directed cycle.\
\>", "ExampleText",ExpressionUUID->"649b5b9f-43d0-4efa-916a-a9069edc5f05"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", "spec"}], ",", " ", "\"\<Small\>\"",
           ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"oneCircle", " ", "=", " ", 
        RowBox[{"RandomInfraCircle", "[", " ", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{"Last", " ", "@", " ", "spec"}]}], "]"}]}], " ", "]"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Graph", "[", 
           RowBox[{"DirectedEdge", " ", "@@@", " ", 
            RowBox[{"Partition", "[", 
             RowBox[{
             "oneCircle", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], 
             "]"}]}], "]"}], ",", " ", "c"}], "}"}], ",", "\n", "      ", 
        RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"spec", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "5"}], "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "6"}], "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "4"}], "}"}]}], 
       "}"}]}], "}"}]}], "]"}]}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"3f6d8991-71ea-40d1-84c3-8cf58e5c3c4f"],

