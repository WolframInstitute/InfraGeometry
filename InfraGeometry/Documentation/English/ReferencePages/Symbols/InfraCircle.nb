Cell[CellGroupData[{
Cell["InfraCircle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1f2dee91-8ecc-4778-9adb-790c169a6ea4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63dc4c20-3eee-402f-8c6a-0004fd441204"],
 "\[LineSeparator]",
 "is the circle around ",
 StyleBox["c", "TI"],
 " through ",
 StyleBox["p", "TI"],
 ". It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1f3cae8f-8e8c-47c4-be0b-3891cd7fdcd6"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraVertexList", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5b191099-2691-43a2-9723-35555462fe1f"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c745c153-f2f5-423e-be2b-5bd5d6512b16"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
     StyleBox["r", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a501315-b9e1-430c-8835-224b55c80d17"],
 "\[LineSeparator]",
 "is the family of circles around ",
 StyleBox["c", "TI"],
 " at radius ",
 StyleBox["r", "TI"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["r", "TI"], ",", " ", 
       StyleBox["s", "TI"]}], "}"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3357724-f06e-424d-8254-a7c811ce0857"],
 " the family in the band ",
 StyleBox["r", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["s", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"cabac9e0-681c-496c-b068-d5b1486bb655"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0a60db2-0a62-497d-b806-2528d0c62286"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0d14b046-c825-4ca0-8648-8775b61e9fda"],
 " is the circle construction token by radius; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d66579b7-3227-48c4-b75c-dc871d712232"],
 " is the search."
}], "Usage",ExpressionUUID->"bf5ae423-0a49-427b-987c-f51ae937f08d"],

Cell[TextData[{
 "Definition: a circle of the band ",
 StyleBox["W", "TI"],
 " around ",
 StyleBox["c", "TI"],
 " is a shortest cycle of the subgraph induced on ",
 StyleBox["W", "TI"],
 " whose removal leaves ",
 StyleBox["c", "TI"],
 " in a component that reaches no further than the band."
}], "Notes",ExpressionUUID->"845089f8-5fa1-4d91-83f4-a6c5c97d6c7f"],

Cell[TextData[{
 "The point form takes the band at ",
 StyleBox["d(c, p)", "TI"],
 " and keeps the circles through ",
 StyleBox["p", "TI"],
 ". Option ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21e63320-ca32-4c92-954f-c6fef84245db"],
 " widens it to ",
 StyleBox["d(c, p)", "TI"],
 " \[Minus] ",
 StyleBox["deltaIn", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, p)", "TI"],
 " + ",
 StyleBox["deltaOut", "TI"],
 ". A scalar ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "delta"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a039204-5936-4e3a-a14a-03be4741d992"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23572bd1-075f-4094-905e-51c749db1a37"],
 ", outward only. The default is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14cca692-eae1-4612-bcf2-88d5e5040d43"],
 "."
}], "Notes",ExpressionUUID->"79fe75e2-8b9a-47a6-a3d4-189fe7c21941"],

Cell[TextData[{
 StyleBox["A circle need not exist.",
  FontWeight->"Bold"],
 " On a lattice a single distance shell has no two adjacent vertices, so it \
spans no cycle and the family is empty. Widening the radius to a band fixes \
it."
}], "Notes",ExpressionUUID->"3d205cbb-493a-4c15-aa47-d3e23e606dd3"],

Cell[TextData[{
 "Its graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["circle", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4965675-89f4-4e48-9dfc-3c882d7003d4"],
 " \[LongDash] is a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c8f8997-e03e-4402-b2ad-489e4d992608"],
 " of necklaces, cut from the band along a radial seam: a geodesic from ",
 StyleBox["c", "TI"],
 " to just outside the band. A necklace is a DAG with one source ",
 StyleBox["s1", "TI"],
 " and one sink ",
 StyleBox["u", "TI"],
 ". It is the cycle family ",
 StyleBox["opened",
  FontWeight->"Bold"],
 " at its closing arrow ",
 StyleBox["u", "TI"],
 " -> ",
 StyleBox["s1", "TI"],
 ", which is left out, so the DAG is acyclic."
}], "Notes",ExpressionUUID->"fd9dcbea-6907-45fb-97a5-519c9f946c4c"],

Cell[TextData[{
 "A member is the open chain ",
 StyleBox["s1", "TI"],
 " \[Ellipsis] ",
 StyleBox["u", "TI"],
 ", read cyclically: a cyclic vertex list whose first vertex is not repeated. \
Its ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a491b99-e4fb-44ca-9dc3-893b65936971"],
 " counts the closing edge too, so a circle of ",
 StyleBox["k", "TI"],
 " vertices has length ",
 StyleBox["k", "TI"],
 "."
}], "Notes",ExpressionUUID->"ed7f9851-1a57-45cb-813b-6a724f3b5593"],

Cell[TextData[{
 "Every member separates. That the necklaces carry every circle exactly once \
needs two hypotheses on the substrate \[LongDash] the winding functional and \
the one-run hypothesis \[LongDash] which nothing here certifies. So ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "acf70a11-2c18-45be-9147-15ed01b6b112"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bfb7d291-d8e5-4635-aa9c-7ac7fcde090e"],
 "."
}], "Notes",ExpressionUUID->"a8567a09-86a8-4551-958c-7423dbdcfc5a"],

Cell[TextData[{
 "Inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1d0c5778-64f2-4e02-82e8-59b4cd59a78b"],
 ", the token ",
 Cell[BoxData[
  RowBox[{"InfraCircle", "[", 
   RowBox[{"c", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd1080ae-a2a9-4659-8da6-3c9d2b44d763"],
 " still reads ",
 StyleBox["r", "TI"],
 " as a radius, unlike the head, where a bare second argument is always a \
point. This is an open inconsistency."
}], "Notes",ExpressionUUID->"0bc90dd1-d5a7-4dbf-b34e-e6056ed8a539"]
}, Open  ]],

