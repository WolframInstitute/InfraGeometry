Cell["\<\
At a single radius the circle exists on the irregular mesh and not on the two \
lattices: their shell has no two adjacent vertices. Each picture shows the \
shell and the circles found in it, labelled by their number.\
\>", "ExampleText",ExpressionUUID->"85e31f6b-b238-4fcc-8fc3-897459dabcc9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"circles", " ", "=", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", "All"}], "]"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", "\n", "        ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"FindInfraShell", "[", 
              RowBox[{"g", ",", " ", "c", ",", " ", "4"}], "]"}], " ", "->", 
             " ", "$InfraShellColor"}], ",", "\n", "         ", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"Graph", "[", 
                RowBox[{"DirectedEdge", " ", "@@@", " ", 
                 RowBox[{"Partition", "[", 
                  RowBox[{
                  "oneCircle", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], 
                  "]"}]}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"oneCircle", ",", " ", "circles"}], "}"}]}], "]"}], 
             " ", "->", " ", "$InfraCircleColor"}]}], "}"}]}], "]"}], ",", 
        "\n", "      ", 
        RowBox[{"Length", " ", "@", " ", "circles"}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"088ebfc5-df7b-4fae-b39c-aa8ebe0d4992"],

