    "Postulate 3", "TableText",ExpressionUUID->
     "9a772fa2-7b69-4324-b642-760e8e71fd47"], Cell[
    "To draw a circle with any center and radius.", "TableText",
     ExpressionUUID->"e735d115-09e4-4fbb-b352-b16e8c0406bf"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2845db38-af03-4109-9df5-6347d388d062"], Cell[
