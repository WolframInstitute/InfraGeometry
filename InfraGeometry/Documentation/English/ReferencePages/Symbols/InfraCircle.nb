Cell[TextData[{
 "The circles of the band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", " ", "5"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40368f10-05f6-4d74-a0d1-dbed00db84f5"],
 " that pass through a vertex at distance 4 are the closed arc through it, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7d996c88-f424-4bc8-9f65-ca2bc55040a6"],
 "."
}], "ExampleText",ExpressionUUID->"1948adab-be26-48e0-91f7-b5230a8779a9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "4"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"InfraArc", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "p"}], "}"}], ",", " ", 
       RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "1"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"circle", " ", "->", " ", "$InfraCircleColor"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c", ",",
          " ", "p"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "circle", ",", " ", "\"\<Cardinality\>\""}], 
      "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "circle", ",", " ", "\"\<Length\>\""}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"c3f09ddf-9bb1-4ef9-81c7-469d8b1e22ea"],

