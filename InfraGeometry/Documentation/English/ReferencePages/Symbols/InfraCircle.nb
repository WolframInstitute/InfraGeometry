Cell["\<\
One circle about the centre of each lattice, at the band each one needs, \
drawn as its directed cycle.\
\>", "ExampleText",ExpressionUUID->"443a6fca-220d-404f-b624-9261e71aa1c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", "spec"}], ",", " ", "\"\<Small\>\"",
           ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"oneCircle", " ", "=", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{"Last", " ", "@", " ", "spec"}]}], "]"}]}], "]"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Graph", "[", 
            RowBox[{"DirectedEdge", " ", "@@@", " ", 
             RowBox[{"Partition", "[", 
              RowBox[{
              "oneCircle", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], 
              "]"}]}], "]"}], " ", "->", " ", "$InfraCircleColor"}], ",", " ", 
          RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
          "c"}], "}"}], ",", "\n", "      ", 
        RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"spec", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "5"}], "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "6"}], "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "4"}], "}"}]}], 
       "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"8df62934-ca72-4c11-ad95-d5c6032552c1"],

