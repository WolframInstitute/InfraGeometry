Cell["\<\
A circle lies in its band, and consecutive vertices are adjacent, the last \
and the first too.\
\>", "ExampleText",ExpressionUUID->"20ff7d86-367c-4dc0-9795-127a49738e13"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cyc", " ", "=", " ", 
     RowBox[{"InfraVertexList", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"41", ",", " ", 
         RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4"}], "}"}]}]}], "]"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"SubsetQ", "[", 
      RowBox[{
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "41", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", "cyc"}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Partition", "[", 
        RowBox[{"cyc", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], "]"}], ",",
        " ", 
       RowBox[{
        RowBox[{"EdgeQ", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"UndirectedEdge", " ", "@@", " ", "#"}]}], "]"}], " ", 
        "&"}]}], "]"}]}], "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b8b90ef6-8c24-4439-9b42-813079333255"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"988d2033-3570-4df7-a2dc-219408210040"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "df6afa00-f179-4103-ac73-eb367cd1a4ef"],
 " searches the band directly and finds as many circles."
}], "ExampleText",ExpressionUUID->"ae1a95c1-22be-48de-bded-ab786c7c1c05"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"41", ",", " ", 
         RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4"}], "}"}]}]}], "]"}], ",", 
       " ", "\"\<Cardinality\>\""}], "]"}], ",", "\n", "   ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraCircle", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", 
        RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}]}], ",", " ", "All"}], "]"}]}]}],
     "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"66c8a900-bab2-4fe0-a1af-5f237ce48f69"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"16", ",", "16"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"ddef02a5-df7d-4bdf-a6ad-f013e106b134"]
}, Open  ]],

Cell["\<\
The necklace is acyclic, and its closing arrow runs from its sink back to its \
source.\
\>", "ExampleText",ExpressionUUID->"9c27f5e8-1214-4851-9427-3f751675e58c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"neck", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{
        RowBox[{"GridGraph", "[", 
         RowBox[{"{", 
          RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
        RowBox[{"InfraCircle", "[", 
         RowBox[{"13", ",", " ", 
          RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}]}]}], "]"}], ",", 
        " ", "\"\<Graph\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"AcyclicGraphQ", "[", "neck", "]"}], ",", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "neck", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexInDegree", "[", 
          RowBox[{"neck", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], " ", 
        "&"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "neck", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexOutDegree", "[", 
          RowBox[{"neck", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], " ", 
        "&"}]}], "]"}]}], "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"a5e8723e-b9cf-408d-aadd-bf2d99e98e8a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"{", "8", "}"}], ",", 
   RowBox[{"{", "7", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"c59f3ac3-e900-4648-a721-544c3c0540ab"]
}, Open  ]]
}, Open  ]],

