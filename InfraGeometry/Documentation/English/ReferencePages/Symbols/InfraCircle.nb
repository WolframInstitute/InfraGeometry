 "\[LineSeparator]",
 "is the family of circles around ",
 StyleBox["c", "TI"],
 " in the shell of radius ",
 StyleBox["r", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"fddcfcfb-17c1-4e7d-ad3f-e011a29b4a78"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
