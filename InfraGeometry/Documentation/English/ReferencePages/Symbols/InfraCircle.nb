     "d73ade50-3331-41df-9b3d-382d09c7b365"], Cell["\<\
The locus of points equidistant from a centre, from the four-place congruence \
relation.\
\>", "TableText",ExpressionUUID->"a1e97b22-bfae-4046-b553-1f97577266f6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3a0d4da3-cf0a-4784-84b3-7c791e244788"], Cell[
    "Birkhoff", "TableText",ExpressionUUID->
     "97844d50-f6d0-4f23-841b-41c7cf531d87"], Cell[
    "Ruler postulate", "TableText",ExpressionUUID->
     "9d5c736b-a290-4bf1-8799-ea742aed3f0d"], Cell[
    "The locus at fixed ruler distance from a point.", "TableText",
     ExpressionUUID->"cb7cbe39-bf7a-4db9-8fe3-1951152cffc3"]}
  }]], "3ColumnTableMod",ExpressionUUID->"4907a4f3-6df3-46fe-87d8-\
efaa51b0b688"]
}, Open  ]],

