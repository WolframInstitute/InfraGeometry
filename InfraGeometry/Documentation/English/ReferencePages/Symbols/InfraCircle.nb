Cell["\<\
A necklace is acyclic: it is the circles opened at their closing arrow, from \
its one source to its one sink.\
\>", "ExampleText",ExpressionUUID->"8e6ef0a0-7118-4547-915f-64c2a537d6ab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"necklace", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCircle", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}], ",", 
        " ", "\"\<Graph\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"necklace", " ", "->", " ", "$InfraCircleColor"}], ",", " ", 
         
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c"}],
         "}"}], ",", " ", 
       RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"AcyclicGraphQ", "[", "necklace", "]"}], ",", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "necklace", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexInDegree", "[", 
          RowBox[{"necklace", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], 
        " ", "&"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "necklace", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexOutDegree", "[", 
          RowBox[{"necklace", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], 
        " ", "&"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"419bd975-4789-4c43-a768-16a1ad740b1d"],

