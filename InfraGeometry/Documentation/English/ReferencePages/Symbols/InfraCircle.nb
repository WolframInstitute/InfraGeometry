Cell[TextData[{
 "An atom is acyclic: its chains run from the seam vertex ",
 StyleBox["x", "TI"],
 " to the copy ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"x", ",", " ", 
    RowBox[{"3", "/", "2"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9b3e837-3196-47a7-aaaa-cface72e448e"],
 " of it, the circles through ",
 StyleBox["x", "TI"],
 " opened at ",
 StyleBox["x", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"413eef07-97db-4864-b63b-55a3ed4b9ae9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"atom", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCircle", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}], ",", 
        " ", "\"\<Graph\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"atom", ",", " ", "c"}], "}"}], ",", " ", 
       RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"AcyclicGraphQ", "[", "atom", "]"}], ",", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "atom", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexInDegree", "[", 
          RowBox[{"atom", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], " ", 
        "&"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "atom", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexOutDegree", "[", 
          RowBox[{"atom", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], " ", 
        "&"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"ddfdba20-c1eb-4929-b0ef-85c5012b7da2"],

