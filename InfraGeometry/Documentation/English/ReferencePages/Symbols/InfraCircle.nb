Cell["\<\
A circle lies in its band, and consecutive vertices are adjacent, the last \
and the first too.\
\>", "ExampleText",ExpressionUUID->"317ded1f-1da6-4af8-89a7-3b321048766e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cyc", " ", "=", " ", 
     RowBox[{"InfraVertexList", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"41", ",", " ", 
         RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4"}], "}"}]}]}], "]"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"SubsetQ", "[", 
      RowBox[{
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "41", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", "cyc"}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Partition", "[", 
        RowBox[{"cyc", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], "]"}], ",",
        " ", 
       RowBox[{
        RowBox[{"EdgeQ", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"UndirectedEdge", " ", "@@", " ", "#"}]}], "]"}], " ", 
        "&"}]}], "]"}]}], "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b27acc55-a2cc-46ff-935a-238ae0227951"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"02d4a417-6fac-4fb4-b2bb-d39d685093c0"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6a48bb4a-d398-4481-8df5-7cc885b68d89"],
 " searches the band directly and finds as many circles."
}], "ExampleText",ExpressionUUID->"4c15772e-461d-40ff-b0fa-aea77eddb444"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"41", ",", " ", 
         RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4"}], "}"}]}]}], "]"}], ",", 
       " ", "\"\<Cardinality\>\""}], "]"}], ",", "\n", "   ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraCircle", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", 
        RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}]}], ",", " ", "All"}], "]"}]}]}],
     "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"348fa425-7c5c-4111-8ef3-eb40044983c3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"16", ",", "16"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"248ca9e8-ae82-41f1-9fe1-79bb3891654c"]
}, Open  ]],

Cell["\<\
The necklace is acyclic, and its closing arrow runs from its sink back to its \
source.\
\>", "ExampleText",ExpressionUUID->"1c805f80-08e4-4b14-a7ec-9560b092ee3e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"neck", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{
        RowBox[{"GridGraph", "[", 
         RowBox[{"{", 
          RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
        RowBox[{"InfraCircle", "[", 
         RowBox[{"13", ",", " ", 
          RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}]}]}], "]"}], ",", 
        " ", "\"\<Graph\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"AcyclicGraphQ", "[", "neck", "]"}], ",", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "neck", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexInDegree", "[", 
          RowBox[{"neck", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], " ", 
        "&"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "neck", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexOutDegree", "[", 
          RowBox[{"neck", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], " ", 
        "&"}]}], "]"}]}], "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"cfca0e93-5f24-46cf-b433-bc873739e602"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"{", "8", "}"}], ",", 
   RowBox[{"{", "7", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"1ab2caac-8304-40c3-89ef-4062ca13c2cb"]
}, Open  ]]
}, Open  ]],

