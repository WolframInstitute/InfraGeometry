     "f64e7c4a-9156-41ae-9ce1-57801aa4fae6"], Cell[
    "Euclid's axiom, stated with betweenness and equidistance.", "TableText",
     ExpressionUUID->"e3620321-7f02-4ca5-9469-758b864827c4"]}
  }]], "3ColumnTableMod",ExpressionUUID->"f3eb95b4-8cda-423f-8bf4-\
8cf2ee5d71ba"]
}, Open  ]],

