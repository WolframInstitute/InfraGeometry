     "f1f56514-4d39-478f-9657-7fb78ff0505d"], Cell[
    "Euclid's axiom, stated with betweenness and equidistance.", "TableText",
     ExpressionUUID->"b9048d77-4926-4f58-91d0-6ef3bcf1beef"]}
  }]], "3ColumnTableMod",ExpressionUUID->"de61ed23-ce09-4f38-b587-\
