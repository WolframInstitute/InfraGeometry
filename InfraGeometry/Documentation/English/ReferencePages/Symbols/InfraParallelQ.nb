Cell["\<\
A line is not parallel to itself, because parallels must not meet.\
\>", "ExampleText",ExpressionUUID->"5186422b-2a71-42d9-80c2-dd767441ee69"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraParallelQ", "[", 
    RowBox[{"g", ",", " ", "line", ",", " ", "line"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"304326fc-547c-42cf-b68d-19cedd0b10cd"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"398eead4-feca-4601-b302-bd9e3c0e443d"]
}, Open  ]],

Cell["\<\
Concentric shells are parallel. Each vertex of the outer one is at the same \
distance from the inner one.\
\>", "ExampleText",ExpressionUUID->"b674472d-8ddb-4c12-b1c5-a1b57edeb917"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sh2", " ", "=", " ", 
     RowBox[{"FindInfraShell", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"sh3", " ", "=", " ", 
     RowBox[{"FindInfraShell", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"sh4", " ", "=", " ", 
     RowBox[{"FindInfraShell", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "4"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<shell 3 to shell 2\>\"", " ", "->", " ", 
      RowBox[{"InfraParallelQ", "[", 
       RowBox[{"g", ",", " ", "sh2", ",", " ", "sh3"}], "]"}]}], ",", "\n", 
     "    ", 
     RowBox[{"\"\<shell 4 to shell 2\>\"", " ", "->", " ", 
      RowBox[{"InfraParallelQ", "[", 
       RowBox[{"g", ",", " ", "sh2", ",", " ", "sh4"}], "]"}]}], ",", "\n", 
     "    ", 
     RowBox[{"\"\<distances 3 to 2\>\"", " ", "->", " ", 
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "v", ",", " ", "#"}], "]"}], " ", "&"}], 
           " ", "/@", " ", "sh2"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "sh3"}], "}"}]}], "]"}]}]}], ",", "\n", 
     "    ", 
     RowBox[{"\"\<distances 4 to 2\>\"", " ", "->", " ", 
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "v", ",", " ", "#"}], "]"}], " ", "&"}], 
           " ", "/@", " ", "sh2"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "sh4"}], "}"}]}], "]"}]}]}]}], "|>"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f83ebf6b-44b4-4200-b752-d97d6556b53e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"shell 3 to shell 2\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"shell 4 to shell 2\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"distances 3 to 2\"\>", "\[Rule]", 
    RowBox[{"{", "1", "}"}]}], ",", 
   RowBox[{"\<\"distances 4 to 2\"\>", "\[Rule]", 
    RowBox[{"{", "2", "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"3f38f2e6-49a3-4f07-928b-7f869176bc2a"]
}, Open  ]],

Cell["\<\
Neither shell is a line, which shows the predicate does not require one.\
\>", "ExampleText",ExpressionUUID->"bdd8b1a4-2a42-42c7-98df-9700cbc95c3f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraLineQ", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"FindInfraShell", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"32b0c79f-ba48-44c6-90c8-2c9a2d880799"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"09391780-c777-4e50-ab32-d3e0ecf897ba"]
}, Open  ]],

Cell["\<\
Two maximal geodesics chosen independently are generally not parallel, \
because the distance between them varies along their length.\
\>", "ExampleText",ExpressionUUID->"ad85d9ff-12a0-485e-acd4-fef200be4238"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line1", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ",
           "2"}], " ", "&&", " ", 
         RowBox[{"!", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"line1", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line2", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "p", ",", " ", 
       RowBox[{"SelectFirst", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "p", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "4"}], " ", "&"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<parallel\>\"", " ", "->", " ", 
      RowBox[{"InfraParallelQ", "[", 
       RowBox[{"g", ",", " ", "line1", ",", " ", "line2"}], "]"}]}], ",", 
     "\n", "    ", 
     RowBox[{"\"\<distances from line2 to line1\>\"", " ", "->", " ", 
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "v", ",", " ", "#"}], "]"}], " ", "&"}], 
           " ", "/@", " ", "line1"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "line2"}], "}"}]}], "]"}]}]}]}], "|>"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"2d08c026-5db1-4acd-8c7e-1e1c6da91f30"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"parallel\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"distances from line2 to line1\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
