    "Euclid", "TableText",ExpressionUUID->
     "0e3876f5-f936-4b86-84cc-b99f73dcfbe6"], Cell[
    "Definition 23", "TableText",ExpressionUUID->
     "7a5592c1-d20d-4648-a926-7caf4ea4df9b"], Cell["\<\
Parallel lines are those in a plane which do not meet, however far produced.\
\>", "TableText",ExpressionUUID->"553b3733-270c-438d-aeaf-15b54e03731d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "99818c13-fcb2-43de-8086-9b51cd6de73f"], Cell[
