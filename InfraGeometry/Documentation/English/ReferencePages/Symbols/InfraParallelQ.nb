     "42f9d926-89e6-44fc-8984-5618e6e07b20"], Cell[
    "Euclid's axiom, stated with betweenness and equidistance.", "TableText",
     ExpressionUUID->"e7a0207e-5708-4e9c-be5a-bd5e74feeaf7"]}
  }]], "3ColumnTableMod",ExpressionUUID->"24803719-4f21-47e7-b573-\
bccbf1d63c67"]
}, Open  ]],

