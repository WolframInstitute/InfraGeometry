Cell["\<\
Two rows of the square grid, two apart. Their end vertices on the rim are at \
distance 3 from the other row, the rest at distance 2. They are parallel up \
to 1:\
\>", "ExampleText",ExpressionUUID->"8db500bb-cf8d-4c53-9155-ccd7b7ada82c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"y", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"row", " ", "=", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"y", "[", "#", "]"}], " ", "==", " ", 
          RowBox[{"y", "[", "c", "]"}]}], " ", "&"}]}], "]"}]}], ",", " ", 
     RowBox[{"other", " ", "=", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"y", "[", "#", "]"}], " ", "==", " ", 
          RowBox[{
           RowBox[{"y", "[", "c", "]"}], " ", "+", " ", "2"}]}], " ", "&"}]}],
        "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"row", ",", " ", "other"}], "}"}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraParallelQ", "[", 
         RowBox[{"g", ",", " ", "row", ",", " ", "other"}], "]"}], ",", " ", 
        RowBox[{"InfraParallelQ", "[", 
         RowBox[{"g", ",", " ", "row", ",", " ", "other", ",", " ", "1"}], 
         "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"05a2b1a8-332d-478c-9eeb-47cfcf3234d2"],

