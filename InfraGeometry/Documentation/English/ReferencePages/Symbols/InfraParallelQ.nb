     "4fe01024-b7f0-4dee-aced-9df2bff0794d"], Cell[
    "The parallel postulate.", "TableText",ExpressionUUID->
     "a4669dc9-a811-45b6-be16-8ab4d029d195"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1ddaf5f5-eb0e-4440-a69d-5aa42d329af5"], Cell[
