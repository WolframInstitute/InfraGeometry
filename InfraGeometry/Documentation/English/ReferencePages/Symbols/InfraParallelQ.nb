Cell["\<\
The shells of radius 4 and 2 about the centre are parallel: every vertex of \
the outer one is at distance 2 from the inner one. Neither is a line:\
\>", "ExampleText",ExpressionUUID->"6e37ea4e-5e8e-4f68-b640-9e91c55e2fb0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"outer", " ", "=", " ", 
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", "4"}], "]"}], ",", 
           " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"inner", " ", "=", " ", 
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", "2"}], "]"}], ",", 
           " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"outer", ",", " ", "inner"}], "}"}], ",", "\n", "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraParallelQ", "[", 
            RowBox[{"g", ",", " ", "outer", ",", " ", "inner"}], "]"}], ",", 
           " ", 
           RowBox[{"InfraInfiniteLineQ", "[", 
            RowBox[{"g", ",", " ", "outer"}], "]"}]}], "}"}]}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"66d142a9-0553-4f9c-ab06-351309c028df"],

