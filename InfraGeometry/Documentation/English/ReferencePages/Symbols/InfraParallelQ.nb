Cell["\<\
A line is not parallel to itself, because parallels must not meet.\
\>", "ExampleText",ExpressionUUID->"a0264c8b-0479-4049-8bd5-ed9444de9ae3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraParallelQ", "[", 
    RowBox[{"g", ",", " ", "line", ",", " ", "line"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a290ebcf-44f1-4a71-a679-f279acb577f7"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b8a34061-d7fd-462c-902e-37b204699a0d"]
}, Open  ]],

Cell["\<\
Concentric shells are parallel. Each vertex of the outer one is at the same \
distance from the inner one.\
\>", "ExampleText",ExpressionUUID->"2d5f0f13-c6f9-45d6-8a3d-f957ddb3247f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sh2", " ", "=", " ", 
     RowBox[{"FindInfraShell", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"sh3", " ", "=", " ", 
     RowBox[{"FindInfraShell", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"sh4", " ", "=", " ", 
     RowBox[{"FindInfraShell", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "4"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<shell 3 to shell 2\>\"", " ", "->", " ", 
      RowBox[{"InfraParallelQ", "[", 
       RowBox[{"g", ",", " ", "sh2", ",", " ", "sh3"}], "]"}]}], ",", "\n", 
     "    ", 
     RowBox[{"\"\<shell 4 to shell 2\>\"", " ", "->", " ", 
      RowBox[{"InfraParallelQ", "[", 
       RowBox[{"g", ",", " ", "sh2", ",", " ", "sh4"}], "]"}]}], ",", "\n", 
     "    ", 
     RowBox[{"\"\<distances 3 to 2\>\"", " ", "->", " ", 
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "v", ",", " ", "#"}], "]"}], " ", "&"}], 
           " ", "/@", " ", "sh2"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "sh3"}], "}"}]}], "]"}]}]}], ",", "\n", 
     "    ", 
     RowBox[{"\"\<distances 4 to 2\>\"", " ", "->", " ", 
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "v", ",", " ", "#"}], "]"}], " ", "&"}], 
           " ", "/@", " ", "sh2"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "sh4"}], "}"}]}], "]"}]}]}]}], "|>"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9071b7b1-d43b-4988-818d-294ef3c11597"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"shell 3 to shell 2\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"shell 4 to shell 2\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"distances 3 to 2\"\>", "\[Rule]", 
    RowBox[{"{", "1", "}"}]}], ",", 
   RowBox[{"\<\"distances 4 to 2\"\>", "\[Rule]", 
    RowBox[{"{", "2", "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"6302d556-976a-4d95-af6c-044814b8b465"]
}, Open  ]],

Cell["\<\
Neither shell is a line, which shows the predicate does not require one.\
\>", "ExampleText",ExpressionUUID->"f24a8ffa-2c89-4ef5-878d-eb01f351af81"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraLineQ", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"FindInfraShell", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"56ec845c-2a41-43a6-abb0-dde4b8f369df"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"ce6f35cc-8d0d-4382-af63-69a2419202b7"]
}, Open  ]],

Cell["\<\
Two maximal geodesics chosen independently are generally not parallel, \
because the distance between them varies along their length.\
\>", "ExampleText",ExpressionUUID->"5cb1558f-16da-451a-9ada-681c13e64b85"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line1", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ",
           "2"}], " ", "&&", " ", 
         RowBox[{"!", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"line1", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line2", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "p", ",", " ", 
       RowBox[{"SelectFirst", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "p", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "4"}], " ", "&"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<parallel\>\"", " ", "->", " ", 
      RowBox[{"InfraParallelQ", "[", 
       RowBox[{"g", ",", " ", "line1", ",", " ", "line2"}], "]"}]}], ",", 
     "\n", "    ", 
     RowBox[{"\"\<distances from line2 to line1\>\"", " ", "->", " ", 
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "v", ",", " ", "#"}], "]"}], " ", "&"}], 
           " ", "/@", " ", "line1"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "line2"}], "}"}]}], "]"}]}]}]}], "|>"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"a752939a-89e9-474f-b125-316e3d5413e8"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"parallel\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"distances from line2 to line1\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
