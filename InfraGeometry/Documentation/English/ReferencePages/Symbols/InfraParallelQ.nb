Cell["\<\
A line is not parallel to itself, because parallels must not meet.\
\>", "ExampleText",ExpressionUUID->"69143d82-95f7-40b3-873a-50404824a3d1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraParallelQ", "[", 
    RowBox[{"g", ",", " ", "line", ",", " ", "line"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"54c884c4-4453-4491-b75a-7be0608ae2ad"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"fc64334a-a1a0-48cd-a330-c0b4c920e4db"]
}, Open  ]],

Cell["\<\
Concentric shells are parallel. Each vertex of the outer one is at the same \
distance from the inner one.\
\>", "ExampleText",ExpressionUUID->"8071b334-c080-43b5-b307-0f41b21e0ca2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sh2", " ", "=", " ", 
     RowBox[{"FindInfraShell", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"sh3", " ", "=", " ", 
     RowBox[{"FindInfraShell", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"sh4", " ", "=", " ", 
     RowBox[{"FindInfraShell", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "4"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<shell 3 to shell 2\>\"", " ", "->", " ", 
      RowBox[{"InfraParallelQ", "[", 
       RowBox[{"g", ",", " ", "sh2", ",", " ", "sh3"}], "]"}]}], ",", "\n", 
     "    ", 
     RowBox[{"\"\<shell 4 to shell 2\>\"", " ", "->", " ", 
      RowBox[{"InfraParallelQ", "[", 
       RowBox[{"g", ",", " ", "sh2", ",", " ", "sh4"}], "]"}]}], ",", "\n", 
     "    ", 
     RowBox[{"\"\<distances 3 to 2\>\"", " ", "->", " ", 
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "v", ",", " ", "#"}], "]"}], " ", "&"}], 
           " ", "/@", " ", "sh2"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "sh3"}], "}"}]}], "]"}]}]}], ",", "\n", 
     "    ", 
     RowBox[{"\"\<distances 4 to 2\>\"", " ", "->", " ", 
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "v", ",", " ", "#"}], "]"}], " ", "&"}], 
           " ", "/@", " ", "sh2"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "sh4"}], "}"}]}], "]"}]}]}]}], "|>"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"48cd97ee-79ef-44b6-b218-e8a8ae860ba8"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"shell 3 to shell 2\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"shell 4 to shell 2\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"distances 3 to 2\"\>", "\[Rule]", 
    RowBox[{"{", "1", "}"}]}], ",", 
   RowBox[{"\<\"distances 4 to 2\"\>", "\[Rule]", 
    RowBox[{"{", "2", "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"e1ec4ccd-3f9d-4292-9442-d2024202cb2b"]
}, Open  ]],

Cell["\<\
Neither shell is a line, which shows the predicate does not require one.\
\>", "ExampleText",ExpressionUUID->"d87f5f4a-3755-4de7-b929-b8b2b369f4ca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraLineQ", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"FindInfraShell", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"de2e879b-d1af-4c3e-afec-9ef90a6487e4"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"54a346b0-6b38-455e-9044-406811cf59f7"]
}, Open  ]],

Cell["\<\
Two maximal geodesics chosen independently are generally not parallel, \
because the distance between them varies along their length.\
\>", "ExampleText",ExpressionUUID->"d82fb016-b19e-4feb-903c-fb309009a8d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line1", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ",
           "2"}], " ", "&&", " ", 
         RowBox[{"!", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"line1", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line2", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "p", ",", " ", 
       RowBox[{"SelectFirst", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "p", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "4"}], " ", "&"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<parallel\>\"", " ", "->", " ", 
      RowBox[{"InfraParallelQ", "[", 
       RowBox[{"g", ",", " ", "line1", ",", " ", "line2"}], "]"}]}], ",", 
     "\n", "    ", 
     RowBox[{"\"\<distances from line2 to line1\>\"", " ", "->", " ", 
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "v", ",", " ", "#"}], "]"}], " ", "&"}], 
           " ", "/@", " ", "line1"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "line2"}], "}"}]}], "]"}]}]}]}], "|>"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"117a7dfb-7e41-4dab-a67e-c4443eb320bc"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"parallel\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"distances from line2 to line1\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
