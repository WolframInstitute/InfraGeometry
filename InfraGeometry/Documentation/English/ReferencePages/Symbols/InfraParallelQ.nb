Cell["\<\
The test is not symmetric. Every vertex of a short piece of a row is at \
distance 2 from the row two above, but the vertices of that row are at \
different distances from the piece:\
\>", "ExampleText",ExpressionUUID->"c971bfc1-e4bf-4682-aaa9-6828d240f328"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"y", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"piece", " ", "=", " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"y", "[", "#", "]"}], " ", "==", " ", 
           RowBox[{"y", "[", "c", "]"}]}], " ", "&"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"other", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "[", "#", "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"y", "[", "c", "]"}], " ", "+", " ", "2"}]}], " ", "&"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"piece", ",", " ", "other"}], "}"}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraParallelQ", "[", 
         RowBox[{"g", ",", " ", "piece", ",", " ", "other"}], "]"}], ",", " ", 
        RowBox[{"InfraParallelQ", "[", 
         RowBox[{"g", ",", " ", "other", ",", " ", "piece"}], "]"}]}], 
       "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ac2ecd31-1e7a-4dfa-9e1a-47ed82586661"],

