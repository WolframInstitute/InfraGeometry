Cell["InfraParallelQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ce3c3057-1d3a-474f-8870-b7f31e2eedf5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["l\:2081", "TI"], ",", " ", 
    StyleBox["l\:2082", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d4fb639-76da-43a4-b0b1-dd13b32cdc6a"],
 "\[LineSeparator]",
 "tests whether the vertex list ",
 StyleBox["l\:2081", "TI"],
 " is parallel to ",
 StyleBox["l\:2082", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ": disjoint from it, with every vertex of ",
 StyleBox["l\:2081", "TI"],
 " at the same distance from ",
 StyleBox["l\:2082", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"76f75225-de2a-41f1-8a27-82fdf021f0c3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["l\:2081", "TI"], ",", " ", 
    StyleBox["l\:2082", "TI"], ",", " ", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f75e07c5-75b6-4b1e-b784-05e1668de13d"],
 "\[LineSeparator]",
 "allows that distance to vary by up to ",
 StyleBox["t", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1b72a5b3-41ba-4895-be20-a2074f34a220"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["m", "TI"], ",", " ", 
    StyleBox["i\:2081", "TI"], ",", " ", 
    StyleBox["i\:2082", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8bac0b9-aa8e-4fcb-be91-c00e24cc15f4"],
 "\[LineSeparator]",
 "reads the distances from the matrix ",
 StyleBox["m", "TI"],
 ", with ",
 StyleBox["i\:2081", "TI"],
 " and ",
 StyleBox["i\:2082", "TI"],
 " lists of row indices."
}], "Usage",ExpressionUUID->"f0fc6f46-9c25-4f86-877b-ae791956ca21"],

Cell[TextData[{
 StyleBox["l\:2081", "TI"],
 " is parallel to ",
 StyleBox["l\:2082", "TI"],
 " when they are disjoint and ",
 StyleBox["d(v, l\:2082)", "TI"],
 " is the same for every ",
 StyleBox["v", "TI"],
 " in ",
 StyleBox["l\:2081", "TI"],
 ", where ",
 StyleBox["d(v, l\:2082)", "TI"],
 " is the least distance from ",
 StyleBox["v", "TI"],
 " to a vertex of ",
 StyleBox["l\:2082", "TI"],
 "."
}], "Notes",ExpressionUUID->"345befd1-7863-411c-8ade-915d107608be"],

Cell["\<\
Disjointness is Euclid's Definition 23: parallels do not meet. So a line is \
not parallel to itself, and two sets that share one vertex are not parallel.\
\>", "Notes",ExpressionUUID->"f4b90762-6b66-4034-9e1e-3c6fef1c9572"],

Cell[TextData[{
 "The test is not symmetric: it measures from ",
 StyleBox["l\:2081", "TI"],
 " to ",
 StyleBox["l\:2082", "TI"],
 ", and ",
 StyleBox["l\:2081", "TI"],
 " lies on a level set of ",
 StyleBox["l\:2082", "TI"],
 ". The arguments need not be lines; concentric shells are parallel. Test \
lines separately with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraInfiniteLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraInfiniteLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b5e22b87-a9ff-4361-94f7-682f45797783"],
 "."
}], "Notes",ExpressionUUID->"d9272f81-91a1-4bbb-9f3f-97887022f8cb"],

Cell[TextData[{
 "A set in another component of ",
 StyleBox["g", "TI"],
 " is at constant distance ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82f8b2b2-f5d5-4d2f-83e5-5a9ac2c02d0b"],
 " from ",
 StyleBox["l\:2082", "TI"],
 ", so it is parallel to ",
 StyleBox["l\:2082", "TI"],
 "; the empty set is parallel to every set, and every set to the empty set."
}], "Notes",ExpressionUUID->"2ce53c8f-b87b-4c8b-9e8d-aa71f0decc04"],

Cell[TextData[{
 "A walk graph, or a list of them, is read as its walks, and every walk of ",
 StyleBox["l\:2081", "TI"],
 " is tested against every walk of ",
 StyleBox["l\:2082", "TI"],
 "."
}], "Notes",ExpressionUUID->"91a0e691-ddd5-40c3-ac56-0455ec9fe4d2"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraParallel"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraParallel", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ab4b2074-8e02-4ceb-9174-9ec2eff6c641"],
 " constructs a parallel through a point of a level set of the line, so its \
parallel is parallel to the line."
}], "Notes",ExpressionUUID->"215cc4a7-992c-49e9-84ce-698bf7dce5b9"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"ccae6422-ff82-44ee-a42f-61c3f189ed49"],

