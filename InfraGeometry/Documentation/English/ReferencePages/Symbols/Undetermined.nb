Notebook[{

Cell[CellGroupData[{
Cell["Undetermined", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fc3c8b0c-92a9-4a08-a527-333354de37a2"],
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "936951f8-5d85-4da9-81ad-1e22b959d372"],
 "\[LineSeparator]",
 "is the value of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", "\"\<Faithful\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fce75d93-1539-4a98-ac9e-aecdaa8963c8"],
 " on a head whose graph is faithful \[LongDash] its chains are exactly its \
intended members \[LongDash] only under a hypothesis this paclet does not \
certify.",
 "\n"
}], "Usage",ExpressionUUID->"2b37648e-ce31-4c00-ac4f-c8e0dc15ae32"],

Cell[TextData[{
 "Every Euclidean head has a graph, and \"Faithful\" states whether every \
chain of that graph is genuinely a member of the head and every member a \
chain of it. For a segment, a ray or a line this is a proved theorem and ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07a098f3-b73e-4d6a-a3c3-dca5d8fc0d58"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5240a0c-b61c-4998-8153-1a2d24637310"],
 ". For ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1c2dddc0-fd98-4771-af7b-8b4550a9f7e3"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "93640721-f028-4081-a77a-19d30adb0b19"],
 " the analogous statement needs a geometric hypothesis on the substrate \
\[LongDash] for the circle the winding functional (W) and the one-run \
hypothesis (T), for the arc (W) together with ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " lying on a common circle \[LongDash] that no computation here checks, so \
the honest answer is neither ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d1e61bc-c899-409c-887e-ccf083e02203"],
 " nor ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a512527-c2f4-4d9b-90df-3f568032883a"],
 " but ",
 Cell[BoxData["Undetermined"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f37c12a-8c01-4f00-987f-e6b24c9acfbf"],
 ": the question is open on this call, not answered no."
}], "Notes",ExpressionUUID->"b7525e9e-19fc-4ba6-9b48-89e99e63f801"],

Cell[TextData[{
 Cell[BoxData["Undetermined"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "178e4860-d0a3-4da2-b223-30e9f7e6d8c6"],
 " carries no further structure; it is a plain symbol, not a function."
}], "Notes",ExpressionUUID->"59b33ab1-fda7-40a6-8b21-67947e3ae313"]
}, Open  ]],

