Cell[TextData[{
 "The circle's \"Faithful\" is always ",
 Cell[BoxData["Undetermined"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0760ff1-c6db-482d-aec2-b61751675525"],
