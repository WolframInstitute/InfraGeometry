Notebook[{

Cell[CellGroupData[{
Cell["Undetermined", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d4a61080-fae5-4d4a-89bd-a46598d8af97"],
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59d802bc-b641-4181-b10e-2f50ed77e35e"],
 "\[LineSeparator]",
 "is the value of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", "\"\<Faithful\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f520cc94-a8a7-45b1-8b7f-995903966d5a"],
 " on a head whose graph is faithful \[LongDash] its chains are exactly its \
intended members \[LongDash] only under a hypothesis this paclet does not \
certify.",
 "\n"
}], "Usage",ExpressionUUID->"e8d85c9e-0f6c-4f76-a721-83025ac60e8f"],

Cell[TextData[{
 "Every Euclidean head has a graph, and \"Faithful\" states whether every \
chain of that graph is genuinely a member of the head and every member a \
chain of it. For a segment, a ray or a line this is a proved theorem and ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2212e78-fcba-42a5-a1ab-99c42790e238"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a45abbc2-8ea0-4ec3-a6ce-45ef5b10ff9b"],
 ". For ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1cf720ff-831e-4fe9-9c1d-ae7ebb099412"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f2ac9083-d0f7-47b0-b678-7db250a6c658"],
 " the analogous statement needs a geometric hypothesis on the substrate \
\[LongDash] for the circle the winding functional (W) and the one-run \
hypothesis (T), for the arc (W) together with ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " lying on a common circle \[LongDash] that no computation here checks, so \
the honest answer is neither ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2cc5e21-a6eb-4b8b-919a-9ecf0ded0e09"],
 " nor ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cf40891-e535-426d-b99b-18881222adb6"],
 " but ",
 Cell[BoxData["Undetermined"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e14d4862-5d65-414d-aa0a-e0fe86df972a"],
 ": the question is open on this call, not answered no."
}], "Notes",ExpressionUUID->"d730886b-8cfe-4f90-b234-29beac10c8b4"],

Cell[TextData[{
 Cell[BoxData["Undetermined"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad00f2ad-7884-496b-8afb-120db177c2c0"],
 " carries no further structure; it is a plain symbol, not a function."
}], "Notes",ExpressionUUID->"b7ac57a5-0a77-4c9c-afe3-fdd30a67f49a"]
}, Open  ]],

