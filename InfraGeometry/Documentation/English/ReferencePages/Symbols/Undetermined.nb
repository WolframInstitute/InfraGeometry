       RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"InfraMeasurement", "[", 
