 "."
}], "Notes",ExpressionUUID->"51fb6082-1dea-47e3-8d11-ba86ac545510"],

Cell["\<\
An invalid or incomplete connection leaves the call unevaluated.\
\>", "Notes",ExpressionUUID->"913bc339-8959-4ffa-95aa-4858cfe3c827"],

Cell["\<\
This predicate reads the specified connection and consumes no random draws.\
\>", "Notes",ExpressionUUID->"55342057-8391-45e0-a776-264c0d2d0806"]
