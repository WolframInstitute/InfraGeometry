Cell[TextData[{
 "A section ",
 StyleBox["s", "TI"],
 " is parallel when ",
 StyleBox["\[Tau]\:209aq(s(p)) = s(q)", "TI"],
 " for every base edge ",
 StyleBox["pq", "TI"],
 " with both ends in its domain, where ",
 StyleBox["\[Tau]\:209aq", "TI"],
 " is the parallel transport of ",
 StyleBox["conn", "TI"],
 " along ",
 StyleBox["pq", "TI"],
 ". Equivalently, every edge ",
 StyleBox["s(p)s(q)", "TI"],
 " belongs to ",
 StyleBox["conn", "TI"],
 "."
}], "Notes",ExpressionUUID->"e53a0cf2-7a10-43a2-ae22-ccb53a561f09"],

Cell["\<\
A parallel section is continuous. A continuous section need not be parallel: \
it may use transverse edges the connection does not choose.\
\>", "Notes",ExpressionUUID->"932b3e59-946f-4048-a980-b45c521a3ca2"],

Cell["\<\
The horizontal lift of a path that visits each vertex once is a parallel \
section over the path. Around a closed walk a parallel section is fixed by \
the holonomy.\
\>", "Notes",ExpressionUUID->"54d61b01-4d5b-425a-a6eb-b27b59d01209"],

Cell[TextData[{
 "The connection must satisfy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "239af7ba-54df-4d47-8022-d975aa58ffb0"],
 ". Otherwise the call stays unevaluated. The empty section is parallel; an \
empty list gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ed6aa78a-4622-4d10-86f4-9ca28eee756e"],
 "."
}], "Notes",ExpressionUUID->"ae9f6b7f-3082-485b-a392-242825f9e6b1"]
}, Open  ]],

