Cell["\<\
The connection chooses one of the available lifts. A section following \
another lift remains continuous but is not parallel.\
\>", "ExampleText",ExpressionUUID->"d707b34b-2282-47d6-933f-6ba921bd68b7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFibration", "[", 
      RowBox[{
       RowBox[{"Graph", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{"1", ",", " ", "3"}], "]"}], ",", " ", 
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{"1", ",", " ", "4"}], "]"}], ",", " ", 
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{"2", ",", " ", "3"}], "]"}], ",", " ", 
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{"2", ",", " ", "4"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<a\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<a\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<b\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<b\>\""}]}], "|>"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"connection", " ", "=", " ", 
      RowBox[{"InfraConnection", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"UndirectedEdge", "[", 
          RowBox[{"1", ",", " ", "3"}], "]"}], ",", " ", 
         RowBox[{"UndirectedEdge", "[", 
          RowBox[{"2", ",", " ", "4"}], "]"}]}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"section", " ", "=", " ", 
      RowBox[{"InfraSection", "[", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<a\>\"", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\"\<b\>\"", " ", "->", " ", "4"}]}], "|>"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"{", 
        RowBox[{"connection", ",", " ", "section"}], "}"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"InfraContinuousSectionQ", "[", 
      RowBox[{"fib", ",", " ", "section"}], "]"}], ",", " ", 
     RowBox[{"InfraParallelSectionQ", "[", 
      RowBox[{"fib", ",", " ", "connection", ",", " ", "section"}], "]"}]}], 
    "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"46047621-5d5f-4f97-9021-d7a58ee2004b"],

