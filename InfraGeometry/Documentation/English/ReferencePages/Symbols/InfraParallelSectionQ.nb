 "."
}], "Notes",ExpressionUUID->"895bf13c-bd21-4a89-8561-8b7bd4c3d87e"],

Cell["\<\
Only base edges with both endpoints among the section's keys are checked.\
\>", "Notes",ExpressionUUID->"13990ceb-a8af-4ca0-8164-8de688488f30"],

Cell["\<\
A parallel section is continuous in the ambient total graph. A continuous \
section need not be parallel for the chosen connection.\
\>", "Notes",ExpressionUUID->"8740d498-ad7e-4d5b-9cdc-0479c24027d1"],

Cell[TextData[{
 "The empty partial section is parallel. An empty collection returns ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
