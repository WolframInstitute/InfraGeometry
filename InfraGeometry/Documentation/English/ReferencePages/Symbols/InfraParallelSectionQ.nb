Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2562d880-753e-4b31-8d65-94efe8fe3326"],
 Cell[BoxData[
  RowBox[{"InfraParallelSectionQ", "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["connection", "TI"], ",", " ", 
    RowBox[{"InfraSection", "[", 
     StyleBox["s", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b09cfefc-be3d-4370-bc45-214881eff2b8"],
 "\[LineSeparator]",
 "tests whether transport along every base edge in the domain of ",
 StyleBox["s", "TI"],
 " carries its first value to its second.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1741a369-3a95-4fb7-9d0b-564a62cea779"],
 Cell[BoxData[
  RowBox[{"InfraParallelSectionQ", "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["connection", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["section1", "TI"], ",", " ", 
      StyleBox["section2", "TI"], ",", " ", "..."}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa4d249a-c36b-4b73-b52b-9b4335214b1e"],
 "\[LineSeparator]",
 "tests every section in a nonempty collection."
}], "Usage",ExpressionUUID->"7c897ae3-cf01-4a51-8073-fca866251b1d"],

Cell[TextData[{
 "The connection must satisfy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9f991f8c-1f94-429a-8074-c91050d0dcac"],
 ", which requires a perfect matching over each base edge."
}], "Notes",ExpressionUUID->"08271b68-9c74-4842-a619-c11add657999"],

Cell[TextData[{
