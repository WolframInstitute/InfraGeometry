Cell["\<\
Fibers of two vertices over the 4 \[Times] 4 grid, joined completely, with a \
random connection. The lift of a path along two sides of the grid is a \
parallel section over the path:\
\>", "ExampleText",ExpressionUUID->"3c7f722b-09db-4d0a-aa7e-db5f23eb1b8f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       "\n", "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"path", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "8", ",", 
       " ", "12", ",", " ", "16"}], "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"s", " ", "=", " ", 
     RowBox[{"InfraSection", "[", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"path", ",", " ", 
        RowBox[{"InfraHorizontalLift", "[", 
         RowBox[{"fib", ",", " ", "conn", ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", "path"}], "]"}]}], 
       "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", 
      RowBox[{"conn", ",", " ", "s"}], "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"InfraParallelSectionQ", "[", 
       RowBox[{"fib", ",", " ", "conn", ",", " ", "s"}], "]"}]}], ",", "\n", 
     "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7bd88456-e3e3-430b-932e-7a05bfe01316"],

