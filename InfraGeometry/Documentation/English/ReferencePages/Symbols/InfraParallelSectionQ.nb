Cell["\<\
Only base edges with both endpoints among the section's keys are checked.\
\>", "Notes",ExpressionUUID->"47d4b2fb-1964-4845-8627-e39a70ffb0b0"],

Cell["\<\
A parallel section is continuous in the ambient total graph. A continuous \
section need not be parallel for the chosen connection.\
\>", "Notes",ExpressionUUID->"e7f1a596-fe89-4d9c-8c53-868a7b08c82d"],

