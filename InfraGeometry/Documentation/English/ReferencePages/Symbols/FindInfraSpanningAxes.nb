  "fdac348c-c59b-4f8d-bf4c-62e069e63022"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "403dd461-1769-4190-87ac-6d43a88d2460"],
 ". Fewer than ",
 StyleBox["n", "TI"],
 " axes give ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ba66340-b6a6-4084-977a-544b665b889d"],
 "."
}], "Notes",ExpressionUUID->"9fe82476-147c-44b7-8e9e-52ac751dc32d"],

