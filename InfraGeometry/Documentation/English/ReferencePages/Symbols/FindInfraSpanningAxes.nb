       RowBox[{"g", ",", " ", "2", ",", " ", 
        RowBox[{"\"\<MinLength\>\"", " ", "->", " ", "10"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
