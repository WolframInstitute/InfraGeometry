Cell[CellGroupData[{
Cell["FindInfraSpanningAxes", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"36226f2a-b3fc-44a1-afea-a3b1674f0bc7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraSpanningAxes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSpanningAxes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7993729e-abe2-4019-8e6e-6beebd0332b2"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["n", "TI"],
 " well-separated shortest paths across ",
 StyleBox["g", "TI"],
 " of the length of its diameter, each a vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e13ae44d-f649-4597-9aa9-88fffa9215e5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraSpanningAxes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSpanningAxes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b501b717-9887-4ac9-8a86-158ad5101e5a"],
 "\[LineSeparator]",
 "gives one such path."
}], "Usage",ExpressionUUID->"77d0187c-394a-40f5-bd13-631803d19380"],

Cell[TextData[{
 "The candidates are the shortest paths between two vertices at distance at \
least ",
 Cell[BoxData["\"\<MinLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b7f68d9-4a5e-4dd1-a61a-670f3d3d4850"],
 ", by default the diameter of ",
 StyleBox["g", "TI"],
 ". The first candidate is taken; each next axis is the candidate farthest \
from those chosen, by ",
 Cell[BoxData["\"\<AxisDistance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee84580f-ca6d-4036-8cf6-1d8822e99f71"],
 ". The choice stops when the best candidate is closer than ",
 Cell[BoxData["\"\<MinSeparation\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6d805fb-1a6a-4d9e-8f80-695a1576c251"],
 "."
}], "Notes",ExpressionUUID->"da6139d6-0be4-4803-98c1-7cb3464b9bd9"],

Cell[TextData[{
 "Unlike ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "110126a2-6905-4e42-9d31-54fee571a497"],
 " the axes have no common centre: they span the whole graph."
}], "Notes",ExpressionUUID->"1692dc76-31a1-450d-b1f4-da2f297d6fa8"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
