Cell[CellGroupData[{

Cell["AxisDistance", "ExampleSubsection",ExpressionUUID->"8a07eabc-1850-4ecd-9012-490ec9fcfc44"],

Cell["\<\
On the 5 \[Times] 5 grid the two diagonal pairs of corners give the \
candidates. Ends apart keep two axes; vertices apart keep one, since every \
two candidates meet:\
\>", "ExampleText",ExpressionUUID->"6797aa7e-99d8-4f7d-9d94-9f2023733f35"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Length", " ", "@", " ", 
    RowBox[{"FindInfraSpanningAxes", "[", 
     RowBox[{
      RowBox[{"GridGraph", "[", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", "All", ",", " ", 
      RowBox[{"\"\<AxisDistance\>\"", " ", "->", " ", "m"}]}], "]"}]}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"m", ",", " ", 
