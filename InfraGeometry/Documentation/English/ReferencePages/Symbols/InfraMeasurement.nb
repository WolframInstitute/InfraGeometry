 "measures each object in the list."
}], "Usage",ExpressionUUID->"3e924e2e-5270-4493-91f3-5f036329968f"],

Cell[TextData[{
 "Definition: ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", 
    StyleBox["property", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73fd51bd-b21b-4cda-b570-4c0275f5daff"],
 " is the value of ",
 StyleBox["property", "TI"],
 " of the object ",
 StyleBox["obj", "TI"],
 " on ",
 StyleBox["graph", "TI"],
 ". The support of ",
 StyleBox["obj", "TI"],
 " is the set ",
 StyleBox["A", "TI"],
 " of vertices its members pass through, ",
 Cell[BoxData[
  RowBox[{"Keys", " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"graph", ",", " ", "obj", ",", " ", "\"\<VertexDensity\>\""}], 
    "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "763ec5b3-a8e3-4a97-8708-400bd80b2c13"],
 ". The two measures of ",
 StyleBox["obj", "TI"],
 " are measures of ",
 StyleBox["A", "TI"],
 ":"
}], "Notes",ExpressionUUID->"24c6785f-c955-4327-ab92-4cb6fa6e89ee"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0199ab94-7dd2-402e-9133-7a5b592db65b"], Cell["Measure", "TableText",
     FontWeight->Bold,ExpressionUUID->"67b5b9d9-df70-4362-96a6-5cf2daf9f6f6"],
