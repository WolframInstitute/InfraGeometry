Cell[TextData[{
 "A region has no ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2992cd40-d00b-4aba-97bd-02035b2a1985"],
 " and no ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27d71fae-3672-4a0a-8ff1-8afad4f3e726"],
 "; its density is 1 on the support. The density of an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fdf18b41-de5b-4ef9-a56f-d58649135628"],
 " is the product of the densities of its parts, that of an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3ab2b2bd-d247-4a1d-baf9-ddf6e107c354"],
 " the sum."
}], "Notes",ExpressionUUID->"e79fc803-30ab-4ff1-bc13-0656fedb6903"],

Cell[TextData[{
 StyleBox["A\[Degree]", "TI"],
 " is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraInterior"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraInterior", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "07872924-a38b-4648-949d-c9b54b580344"],
 " of ",
 StyleBox["A", "TI"],
 ". On a manifold the boundary of a region has measure zero; on a graph it \
does not, and for a ball of radius ",
 StyleBox["r", "TI"],
 " the two measures differ by a share of order ",
 StyleBox["1/r", "TI"],
 ". The rim of a finite graph is not a boundary."
}], "Notes",ExpressionUUID->"33144cff-fbca-46ae-a9f5-355e95f9defd"],

Cell[TextData[{
 "For the ",
 StyleBox["s", "TI"],
 "-neighbourhood ",
 StyleBox["T\:209b(X)", "TI"],
 " of a vertex set ",
 StyleBox["X", "TI"],
 " and ",
 StyleBox["s \[GreaterEqual] 1", "TI"],
 ", ",
 StyleBox["T\:209b(X)\[Degree] = T\:209b\:208b\:2081(X) \:222a {w : d(w, X) = \
s, no neighbour of w at distance s + 1}", "TI"],
 ": the Riemannian measure of a ball or tube is the counting measure one step \
thinner, plus the dead ends of the outer layer."
}], "Notes",ExpressionUUID->"1f5b64f7-c1b9-46d2-b34e-fb3ab62fc1bc"],

Cell[TextData[{
 "On the square grid, away from the rim, with a segment whose interval is an \
(",
 StyleBox["a", "TI"],
 " + 1) \[Times] (",
 StyleBox["b", "TI"],
 " + 1) rectangle:"
}], "Notes",ExpressionUUID->"cc733562-ad16-4dab-a25c-ba3d8e182871"],

