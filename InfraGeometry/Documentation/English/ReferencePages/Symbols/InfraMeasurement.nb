     "d853f85c-786a-4547-b35a-8a1b121d555f"], Cell[
    "the number of members", "TableText",ExpressionUUID->
     "8b9797e9-0d86-4d8a-99ac-cf6696f2dcbb"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2ead2023-9b3f-4968-bb39-f22513ba7f9d"], Cell[TextData[Cell[
    BoxData["\"\<Length\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0d928196-0252-47c7-b65f-e339e57d1643"]], "TableText",ExpressionUUID->
     "49a4ed15-9b0e-4dfe-87f6-2612f5f30683"], Cell[TextData[{
     "the common length of the members, or a ",
     Cell[BoxData["List"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c21dc547-bbbd-4460-97ba-d4679290b755"],
     " of lengths when they differ"
    }], "TableText",ExpressionUUID->"49148d0d-e3b2-4747-920a-c74940af039d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "acebac2d-c265-4f1c-af0c-1421143f7041"], Cell[TextData[Cell[
    BoxData["\"\<VertexDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0c88710a-49f4-4f65-8799-8cebf39b5dfb"]], "TableText",ExpressionUUID->
     "dd8b4a30-1111-423f-b707-9275feb74744"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"<|", 
       RowBox[{"v", " ", "->", " ", 
        RowBox[{"occ", 
         RowBox[{"(", "v", ")"}]}]}], "|>"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "04cbc3d9-2e6a-4431-a143-26da70625d99"],
     ", the number of members through ",
     StyleBox["v", "TI"],
     "; on a polyline, the sum of the piece densities"
    }], "TableText",ExpressionUUID->"40c76bfc-9469-44bf-910a-5688c84a7c60"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1fe38f0a-1aab-441f-832e-b1784f9a56d4"], Cell[TextData[Cell[
    BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7855cda0-a0b9-4e65-8ba5-0a90b9789cf2"]], "TableText",ExpressionUUID->
     "63655676-0108-4648-b816-7a9e9b2cc998"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"v", " ", "\[DirectedEdge]", " ", "w"}], " ", "->", " ", 
        RowBox[{"occ", 
         RowBox[{"(", 
          RowBox[{"v", " ", "->", " ", "w"}], ")"}]}]}], "|>"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1684a896-9e4f-4f01-baab-aa3097e8bc4c"],
     ", the number of members through the arrow; on a polyline, the sum of \
the piece densities"
    }], "TableText",ExpressionUUID->"0ff314c4-56c0-43c0-a2bc-e40a2b190505"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8ea1ae98-11af-4543-934b-c65eaaa2e873"], Cell[TextData[Cell[
    BoxData["\"\<Subgraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5eb19d44-497f-4974-9f32-e01a1f34ccb7"]], "TableText",ExpressionUUID->
     "4fc1b14a-73da-4313-a5bc-0eb9ab65f22a"], Cell[TextData[{
     "the induced subgraph of the support, same as ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSubgraph"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSubgraph", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "4fb53ca5-26fa-4389-a65e-290cb329a791"]
    }], "TableText",ExpressionUUID->"7f07fdda-8a73-4606-9b45-cbb02959443a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "20a77c88-ae95-4a01-8029-f59908ba0cd2"], Cell[TextData[Cell[
    BoxData["\"\<Faithful\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6c60fef4-5287-45ac-ae19-bd9e72dd5025"]], "TableText",ExpressionUUID->
     "6b8125a3-28f6-4461-b238-3c712cbec800"], Cell[TextData[{
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ce02df6d-7663-48c3-b7b5-d3f60387091e"],
     " on a segment, ray or line; ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Undetermined"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "1d00d058-7b17-4d85-a425-298e392bb9d1"],
     " on a circle or an arc, whose graph is proved faithful only under a \
hypothesis this paclet does not certify, except that a circle whose cut band \
is connected but whose seam has one side only gives ",
     Cell[BoxData["False"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9c9f4a5b-a84e-4ba6-8a76-613e93001f09"]
    }], "TableText",ExpressionUUID->"45c08d79-6664-47b6-9803-8c50b93f7623"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b7b61d64-bb67-4bd1-a947-97a1a7f23c1a"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2685e0d0-fc02-4777-89f5-cc9665e6eb68"]], "TableText",ExpressionUUID->
     "4a0f96a4-e363-44f5-baf3-64c3735579d1"], Cell[
    "the number of vertices of the support", "TableText",ExpressionUUID->
     "b2769887-f555-470a-8fac-8ae175486c64"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b7fd59a8-5fae-4445-b2a0-87b33aab15d3"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "579fdf3a-552c-4b44-9003-7d491189b070"]], "TableText",ExpressionUUID->
     "f80cceae-795f-4daa-b678-a5d8aeeb8731"], Cell["\<\
the number of vertices of the support all of whose neighbours lie in the \
support\
\>", "TableText",ExpressionUUID->"7ea4c8d8-4cfc-4e66-b741-b4ee806e9663"]}
  }]], "2ColumnTableMod",ExpressionUUID->"b302c1da-8088-4aaa-abbe-\
7c343a9897af"],

Cell[TextData[{
 "A region \[LongDash] a ball, shell, tube, cylinder or cone \[LongDash] has \
one member, its vertex set, and every vertex of the support has density 1. It \
has no ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65d1624b-97eb-480a-86fb-83c1f7cc85f4"],
 " and no ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4240f806-0277-466c-ae67-9c10d33a9d6c"],
 ". A sphere is a family, searched rather than read off a graph; its ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cefeaed-d3fc-4920-a420-13ebe62127e6"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "133014dc-7afd-4cbc-a60e-637cd6b45838"],
 "."
}], "Notes",ExpressionUUID->"6db75f1c-e8a0-4418-a797-2118946c7962"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "047f9cbd-4d52-42a9-adcc-9ef210089d8b"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b1b8b594-27d9-4dec-9a9d-2eb2971a15d7"],
 " are heads on heads: neither is a family of walks, so neither has a ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d7edb869-c83a-485d-a6e8-d904932bd0d8"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0245047-3f5c-4082-ab4a-5861f7e6303a"],
 ", ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46bd3412-9586-4004-afa2-8d0d01769c39"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1aa3596f-95ed-40ac-a9c5-74530167cd98"],
 " or ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe5afd99-1427-4717-ae19-d9485ab33e1c"],
 ", and their ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22fa6567-7251-42dd-84db-b73a142b0c39"],
 " lists only the density, the subgraph and the two measures. The \
intersection's ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "653bc8fa-bd71-46a8-99ab-b3c671ce1047"],
 " is the product of the two objects' densities on their common vertices, the \
union's the sum."
}], "Notes",ExpressionUUID->"98249976-bc03-4185-b6c3-010b39311f0a"],

Cell[TextData[{
 "A circle takes a radius ",
 Cell[BoxData["r"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9fdfa64-c8a4-4bb6-b8ce-2088ee228c38"],
 " or a band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "s"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b48cb0b-2c78-468c-b81f-376be3b7adaf"],
 ", a scalar ",
 Cell[BoxData["r"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33762cec-f255-45a2-9e7b-7b36a1ea0022"],
 " meaning ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "r"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "999a1f9f-9829-4b35-a3d5-9a0b2bfc56fe"],
 ". The circle through a point is the closed arc ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f090dca2-c6ea-44e4-a73f-b860234464e1"],
 ", which widens the band of ",
 StyleBox["p", "TI"],
 " with ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"delta", " ", "|", " ", 
    RowBox[{"{", 
     RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25d3ab9b-734b-488d-8418-9b84c89ee339"],
 " (default ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6de8c539-a16c-4883-88a4-c411494cc3b4"],
 "). A scalar ",
 StyleBox["delta", "TI"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "422b3002-6b8f-4401-b4c5-826d283b9d31"],
 ", outward only."
}], "Notes",ExpressionUUID->"7fe8cfb1-2209-4d75-88bf-637ad3e95f4e"],

Cell[TextData[{
 "On a polyline ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39199a2c-8aac-464a-b987-fd5927d7f07d"],
 " the densities are not member counts: they are the sums of the piece \
densities. On the 5 \[Times] 5 grid, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"1", ",", " ", "13", ",", " ", "25"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b6da114-af8a-46fb-b1f4-b35ebe4988db"],
 " has 36 members, while its density at the centre 13 is 12."
}], "Notes",ExpressionUUID->"a1bd9851-6f2e-44eb-9d7a-e17fa2025a09"]
}, Open  ]],

