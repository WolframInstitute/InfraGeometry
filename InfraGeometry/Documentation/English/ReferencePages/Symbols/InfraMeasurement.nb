      FontSize->0.9 Inherited,ExpressionUUID->
      "86c7342e-559d-4a56-851c-4cb838857e15"],
     ", the number of members through ",
     StyleBox["v", "TI"],
     "; on a polyline, the sum of the piece densities"
    }], "TableText",ExpressionUUID->"e0af87a0-b41d-45b1-8e22-8070b0e5c01d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "375ebee6-5983-49a9-88ff-11541faf971b"], Cell[TextData[Cell[
    BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "67004d80-9a5c-4fa6-80a0-dc2c51ad949c"]], "TableText",ExpressionUUID->
     "6d94268e-0d62-41f6-8b05-6828dd06cddb"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"v", " ", "\[DirectedEdge]", " ", "w"}], " ", "->", " ", 
        RowBox[{"occ", 
         RowBox[{"(", 
          RowBox[{"v", " ", "->", " ", "w"}], ")"}]}]}], "|>"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "36a9baee-9909-4ddd-bde7-b4f8e89406d7"],
     ", the number of members through the arrow; on a polyline, the sum of \
the piece densities"
    }], "TableText",ExpressionUUID->"0823b0e9-9872-4070-8818-3aed831973f2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "55df1b51-39cc-489f-a834-8732b40f8025"], Cell[TextData[Cell[
    BoxData["\"\<Subgraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "dec52cc8-0bf4-4c01-a585-22dea8050ff7"]], "TableText",ExpressionUUID->
     "dc2ee8fc-5179-4270-8ea7-bcbcbc55e672"], Cell[TextData[{
     "the induced subgraph of the support, same as ",
     Cell[BoxData["InfraSubgraph"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f6e65f75-3e95-4d51-9933-58ae632c721d"]
    }], "TableText",ExpressionUUID->"278c94c0-d88f-490b-841a-60eb783571f0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5b6ac96d-48b4-4121-b68b-623b47673f5d"], Cell[TextData[Cell[
    BoxData["\"\<Faithful\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "434fae1f-ffe5-45a0-a598-7a46610a96bf"]], "TableText",ExpressionUUID->
     "06a1cef3-bbb6-4521-9818-517cb0119dd3"], Cell[TextData[{
