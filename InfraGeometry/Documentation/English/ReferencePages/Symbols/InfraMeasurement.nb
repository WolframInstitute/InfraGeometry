Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "#", ",", " ", "All"}], "]"}]}], " ", "&"}], 
    " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraSegment", "[", 
       RowBox[{"c", ",", " ", "49"}], "]"}], ",", " ", 
      RowBox[{"InfraBall", "[", 
       RowBox[{"c", ",", " ", "3"}], "]"}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fef9fada-4763-46fb-8f97-d40099a97a20"],

