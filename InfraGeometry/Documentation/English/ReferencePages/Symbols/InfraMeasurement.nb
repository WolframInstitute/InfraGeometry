Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "4"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"support", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<VertexDensity\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", "support", "}"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Length", " ", "@", " ", "support"}], " ", "===", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<Volume\>\""}], "]"}]}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1acca93c-941f-4aed-9847-3d16cd6a0668"],

