   {Cell["      ", "ModInfo",ExpressionUUID->
     "ef49339a-93ce-4f4e-8bee-ab6b3de19026"], Cell[TextData[Cell[
    BoxData["\"\<Graph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "92a896e3-b46d-452f-ab82-6bc20018ef35"]], "TableText",ExpressionUUID->
     "c4655b7c-65aa-4bc8-93b1-d5e7fd2e49d7"], Cell[TextData[{
     "the object's own graph: one ",
     Cell[BoxData["Graph"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4e09b431-9f9e-43c3-891c-2509e140ab1d"],
     ", or a ",
     Cell[BoxData["List"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "dc0df7df-4a72-4ab1-979b-82bd8ee60ec9"],
     " of them for a family of alternatives (the DAGs of a line or a ray, the \
necklaces of a circle) or for the pieces of a polyline"
    }], "TableText",ExpressionUUID->"7c70bf10-b476-4016-bb69-7e3edc66e911"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "bbd2e6a8-4059-47ee-bad8-d684c723def2"], Cell[TextData[Cell[
    BoxData["\"\<Cardinality\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "706b9ca0-45ba-4584-8ca4-4d4d40f01211"]], "TableText",ExpressionUUID->
     "6de45658-e280-4182-ad19-d3a97a72411d"], Cell[
    "the number of members", "TableText",ExpressionUUID->
     "af7057ce-0476-4736-a422-29ef56e8ea42"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5ac2617b-0797-4f18-9dd6-6ecf929572ac"], Cell[TextData[Cell[
    BoxData["\"\<Length\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7d8157f6-4eaa-4d62-a9d8-2e0ba90f5555"]], "TableText",ExpressionUUID->
     "e8caae15-a8b5-4408-8732-d322b8b93c10"], Cell[TextData[{
     "the common length of the members, or a ",
     Cell[BoxData["List"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9503881a-61e4-4c0e-a2ef-bdd75477a5d7"],
     " of lengths when they differ"
    }], "TableText",ExpressionUUID->"22590f31-56f6-4dd6-82e3-a4a6121dd886"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "20acde86-0805-43a1-9cf7-1ef8c86c1911"], Cell[TextData[Cell[
    BoxData["\"\<VertexDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a79aa3ba-3c11-4cd6-acd4-f7be080a322c"]], "TableText",ExpressionUUID->
     "2f53dba9-8d18-4709-8400-9a8f02de5f59"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"<|", 
       RowBox[{"v", " ", "->", " ", 
        RowBox[{"occ", 
         RowBox[{"(", "v", ")"}]}]}], "|>"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0d8465af-16d8-44df-9d73-7dc6fb65bb71"],
     ", the number of members through ",
     StyleBox["v", "TI"],
     "; on a polyline, the sum of the piece densities"
    }], "TableText",ExpressionUUID->"08bfd788-9ae9-4946-b180-86057de13132"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e001fc9e-7ab5-40b8-aee6-2b28388fcf19"], Cell[TextData[Cell[
    BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ba9b35f3-b5b8-4800-91ca-533b9ce2a57b"]], "TableText",ExpressionUUID->
     "5f95f3ed-ded2-4a07-bdf7-6c3933aa0a55"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"v", " ", "\[DirectedEdge]", " ", "w"}], " ", "->", " ", 
        RowBox[{"occ", 
         RowBox[{"(", 
          RowBox[{"v", " ", "->", " ", "w"}], ")"}]}]}], "|>"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7526720b-7d5b-4d3d-9f82-93572bb7862b"],
     ", the number of members through the arrow; on a polyline, the sum of \
the piece densities"
    }], "TableText",ExpressionUUID->"d52727c1-8fc0-4f57-a096-2a9f4c84fbec"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "713288cf-afd5-4c19-80c1-1f13fd64a3b0"], Cell[TextData[Cell[
    BoxData["\"\<Subgraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "fe5a3378-3588-4538-b6ea-d057ec39dbd7"]], "TableText",ExpressionUUID->
     "b5a17c76-5913-4a61-9b52-d2f1c11b3249"], Cell[TextData[{
     "the induced subgraph of the support, same as ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSubgraph"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSubgraph", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "b64f256f-5077-4f9e-b12c-a6af59681e1a"]
    }], "TableText",ExpressionUUID->"898e1842-8fde-4893-b4f4-2567ed133bc2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e0ce8176-f230-48a2-aea2-9c15541e218f"], Cell[TextData[Cell[
    BoxData["\"\<Faithful\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "84436011-7c5a-430b-96e7-d6deeef90592"]], "TableText",ExpressionUUID->
     "046f64fc-1057-4906-9543-7e1588949f82"], Cell[TextData[{
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "80839b66-bf28-423e-848a-e365faab31c4"],
     " on a segment, ray or line; ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Undetermined"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "ab36235c-d8be-4d17-971b-b571d3da24f9"],
     " on a circle or an arc, whose graph is proved faithful only under a \
hypothesis this paclet does not certify"
    }], "TableText",ExpressionUUID->"b591d845-fe3d-4224-84a0-e7e258ce320f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "114e5398-0f87-4245-88d7-27a10cc0238f"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "207a1373-f8a8-49ec-a108-7c4bd4fb8790"]], "TableText",ExpressionUUID->
     "fc0f2b4a-4296-4d75-af59-c7e90a838442"], Cell[
    "the number of vertices of the support", "TableText",ExpressionUUID->
     "04d4ecf3-5cb5-4107-bf6b-6350f9077bbe"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "cb5c2b0b-df90-4816-8798-9b3774debd05"], Cell[TextData[Cell[
