Cell[TextData[{
 "Definition: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", 
    StyleBox["property", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b2465d2-a573-441a-9457-e07f8f035ea4"],
 " is the value of ",
 StyleBox["property", "TI"],
 " of the object ",
 StyleBox["obj", "TI"],
 " on ",
 StyleBox["graph", "TI"],
 ". The support of ",
 StyleBox["obj", "TI"],
 " is the set ",
 StyleBox["A", "TI"],
 " of vertices its members pass through, ",
 Cell[BoxData[
  RowBox[{"Keys", " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"graph", ",", " ", "obj", ",", " ", "\"\<VertexDensity\>\""}], 
    "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62a3ca05-85ab-46ca-8c3f-e40cd22c6aac"],
 ". The two measures of ",
 StyleBox["obj", "TI"],
 " are measures of ",
 StyleBox["A", "TI"],
 ":"
}], "Notes",ExpressionUUID->"d5e42a9c-6572-4975-920f-dff8d09cb329"],

