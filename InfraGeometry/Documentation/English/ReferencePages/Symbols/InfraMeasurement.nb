  FontSize->0.9 Inherited,ExpressionUUID->
  "23f2d2ef-e742-431d-bb0d-eeb1a366b81d"],
 " is the value of ",
 StyleBox["property", "TI"],
 " of the object ",
 StyleBox["obj", "TI"],
 " on ",
 StyleBox["graph", "TI"],
 ". The support of ",
 StyleBox["obj", "TI"],
 " is the set ",
 StyleBox["A", "TI"],
 " of vertices its members pass through, ",
 Cell[BoxData[
  RowBox[{"Keys", " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"graph", ",", " ", "obj", ",", " ", "\"\<VertexDensity\>\""}], 
    "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c15474f-de0b-41f7-8d31-0e896c430c6f"],
 ". The two measures of ",
 StyleBox["obj", "TI"],
 " are measures of ",
 StyleBox["A", "TI"],
 ":"
}], "Notes",ExpressionUUID->"e2f94506-c684-4818-8cd0-b2bd31d65c53"],

