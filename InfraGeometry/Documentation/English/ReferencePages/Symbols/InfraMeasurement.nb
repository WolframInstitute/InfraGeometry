Cell[TextData[{
 "The symbol page of each region carries its counts on the other lattices and \
its continuum expansion. A profile, the list of a measure over the size, is \
read by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LogDifferenceQuotients"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/LogDifferenceQuotients", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "beb42e43-a780-4680-b8ba-f8fee6bea519"],
 ". The quotients of the counting profile from ",
 StyleBox["r = 0", "TI"],
 " and of the Riemannian profile from ",
 StyleBox["r = 1", "TI"],
 " coincide on a lattice, and they are the curves of the technical \
introduction, section 4.5: on ",
 StyleBox["Z^d", "TI"],
 " they approach the dimension as ",
 StyleBox["d + d/(2r)", "TI"],
 ", from above, while the counting profile from ",
 StyleBox["r = 1", "TI"],
 " approaches it as ",
 StyleBox["d \[Minus] d/(2r)", "TI"],
 ", from below."
}], "Notes",ExpressionUUID->"5393aed9-3e8b-4c0f-afae-d7ffc535b67f"],

Cell[TextData[{
 "A Euclidean head is inert: it holds its points and options and computes \
nothing on its own. ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "777ca0af-aa7a-4475-991f-6ef46546180b"],
 " is what evaluates it, reading every property off the head's ",
 StyleBox["graph",
  FontWeight->"Bold"],
 " \[LongDash] an acyclic directed graph whose source-to-sink chains are \
exactly the head's members \[LongDash] by one forward and one backward sweep \
of a dynamic-programming count, never by enumeration. A circle's graph is a \
",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f4d6aec-9ef5-4caf-bc78-80b6d6858555"],
 " of atoms of the unrolled band along a radial seam (necklaces where the cut \
band is disconnected or the seam has one side only; see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5541dd7f-c38d-401e-9783-82520f6f760e"],
 "). Each is an acyclic DAG from a seam vertex ",
 StyleBox["x", "TI"],
 " to a copy ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"x", ",", " ", 
    RowBox[{"3", "/", "2"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66bea6e3-0a40-4201-9630-b8b80362dfae"],
 " of it, so a circle is a chain read as a closed walk, ",
 StyleBox["opened",
  FontWeight->"Bold"],
 " at ",
 StyleBox["x", "TI"],
 ". A circle's member is the chain with the copy dropped, a cyclic vertex \
list whose first vertex is not repeated. The closed arc has the same shape on \
the atom at its point."
}], "Notes",ExpressionUUID->"ab46edb9-d650-4d91-a8a6-9ced77d599f7"],

Cell["The properties:", "Notes",ExpressionUUID->"8277cbae-40c8-4d68-8da7-56c46755fb87"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c04d6500-2e7d-4bd6-a62d-d5462b79fdbd"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"8a3498d9-6bb8-4d97-bc00-d57835f0f330"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"83cea212-2a46-4384-82da-cb8c4ba3a063"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0105d60e-318c-4051-9ac1-5ad2151a4396"], Cell[TextData[Cell[
    BoxData["\"\<Graph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a54afe52-46ff-46a0-9d38-bace800ca517"]], "TableText",ExpressionUUID->
     "ecdffb19-6d2d-41d7-b4a1-69eb296f93eb"], Cell[TextData[{
     "the object's own graph: one ",
     Cell[BoxData["Graph"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "bda6d661-6713-4197-89fe-69fe1ddbb075"],
     ", or a ",
     Cell[BoxData["List"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "abd7bf7a-1a9d-4006-96b3-411ba18af1a9"],
     " of them for a family of alternatives (the DAGs of a line or a ray, the \
atoms of a circle) or for the pieces of a polyline"
    }], "TableText",ExpressionUUID->"3e73069c-f2a1-4452-9ef6-a0ca7a170ca5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "056a7a44-e445-46e0-abfc-1151147ebb61"], Cell[TextData[Cell[
    BoxData["\"\<Cardinality\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a186a6f6-2fb5-4979-9c9f-0a331622b728"]], "TableText",ExpressionUUID->
     "41a396ad-3038-4a84-a9a7-4fdaa4e4619f"], Cell[
    "the number of members", "TableText",ExpressionUUID->
     "68008cd4-eaf6-4467-a739-811dd90766d6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fd754d9c-0fc2-400e-81bd-c32619f10b3a"], Cell[TextData[Cell[
    BoxData["\"\<Length\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b7b33e2f-7fcb-4e42-9df3-db940ab9b588"]], "TableText",ExpressionUUID->
     "5c2b0d31-427c-4592-b206-3445bf125897"], Cell[TextData[{
     "the common length of the members, or a ",
     Cell[BoxData["List"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ea7a2f2e-f159-4ca8-89cc-fc30c2db8b79"],
     " of lengths when they differ"
    }], "TableText",ExpressionUUID->"12f8e54e-c52d-4fd6-92e2-59f17f5a94e7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "11a18e5d-571a-4212-a0a2-7ef48eb3d89b"], Cell[TextData[Cell[
    BoxData["\"\<VertexDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f25c1a45-3fa0-4389-9db2-b15787e6a4e5"]], "TableText",ExpressionUUID->
     "3f882285-2ce4-4e5c-983e-e3e8eeef8188"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"<|", 
       RowBox[{"v", " ", "->", " ", 
        RowBox[{"occ", 
         RowBox[{"(", "v", ")"}]}]}], "|>"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "88dedbc1-2b19-42d9-83c1-bbae32651de4"],
     ", the number of members through ",
     StyleBox["v", "TI"],
     "; on a polyline, the sum of the piece densities"
    }], "TableText",ExpressionUUID->"746f137a-7d7c-4447-8317-3994ecc7a3df"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ae0122c9-a7ad-4861-95d6-042dca8a4f5f"], Cell[TextData[Cell[
    BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5c36e777-9f8e-4a40-83bf-1224b36caf68"]], "TableText",ExpressionUUID->
     "f0f540dc-83c4-4952-a109-008ed32d2c6a"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"v", " ", "\[DirectedEdge]", " ", "w"}], " ", "->", " ", 
        RowBox[{"occ", 
         RowBox[{"(", 
          RowBox[{"v", " ", "->", " ", "w"}], ")"}]}]}], "|>"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b2fdceb3-4c79-48a3-9880-c9a6fc78be7d"],
     ", the number of members through the arrow; on a polyline, the sum of \
the piece densities"
    }], "TableText",ExpressionUUID->"88473241-c2ae-49d3-ab40-f386f4afb072"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "78460ee8-aa85-46f1-bb91-f1d9149b3c80"], Cell[TextData[Cell[
    BoxData["\"\<Subgraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5f93342d-e991-4281-8bb1-05768d634242"]], "TableText",ExpressionUUID->
     "363910be-2ca7-4446-b2ba-23a617125dc7"], Cell[TextData[{
     "the induced subgraph of the support, same as ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSubgraph"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSubgraph", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "7a7a8c8c-f904-4f4c-a057-8dc58cbcd5ab"]
    }], "TableText",ExpressionUUID->"84b8a1d2-275a-4d97-8be4-ee821cf553e0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "02a5ad8d-1406-42ed-acea-996d34faa10a"], Cell[TextData[Cell[
    BoxData["\"\<Faithful\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a96cd4af-7c14-4db0-90b2-448ef9ade0ea"]], "TableText",ExpressionUUID->
     "2a625d08-886f-490b-9fc7-e090d95ac43f"], Cell[TextData[{
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ba5b3757-0c3f-4c17-be7a-98c04874a747"],
     " on a segment, ray or line; ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Undetermined"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "3e54e165-487c-4821-85f7-b750e39ed5e9"],
     " on a circle or an arc, whose graph is proved faithful only under a \
hypothesis this paclet does not certify, except that a circle whose cut band \
is connected but whose seam has one side only gives ",
     Cell[BoxData["False"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "d5b07083-0954-4972-bca5-818b61859b52"]
    }], "TableText",ExpressionUUID->"2d68457c-61f6-40b8-9f90-febdd926dcd4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d8eb8638-9c9a-407d-979d-7ce580e3ab9b"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3c3c8d04-c29c-4c0e-b2a7-d7f1e5064a3c"]], "TableText",ExpressionUUID->
     "520c4632-30f4-4bb7-9b2e-61a2ebcf6650"], Cell[
    "the number of vertices of the support", "TableText",ExpressionUUID->
     "6d32964c-4e64-44d9-abba-53db09a7bb37"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "14773c95-b399-439f-86c9-0a6961a0559b"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ff2ba32c-57b1-4eae-bf9f-cb27c7a10867"]], "TableText",ExpressionUUID->
     "b97b2edc-04c6-4cca-8ef1-ea6f5582772c"], Cell["\<\
the number of vertices of the support all of whose neighbours lie in the \
support\
\>", "TableText",ExpressionUUID->"a1c9cb89-35ba-4bdb-b4d5-01274a8efdc1"]}
  }]], "2ColumnTableMod",ExpressionUUID->"42cb593b-71c4-486e-bbab-\
c3477fa96be2"],

Cell[TextData[{
 "A region \[LongDash] a ball, shell, tube, cylinder or cone \[LongDash] has \
one member, its vertex set, and every vertex of the support has density 1. It \
has no ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "746d41d9-a1a6-473f-aec4-171c19d34a2c"],
 " and no ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "772c76e8-998f-4437-b3f1-ba8c7a96d511"],
 ". A sphere is a family, searched rather than read off a graph; its ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b5f2574-2eb4-4cd6-b111-601f0c8c2fb0"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "02addcd3-0178-42cb-8ad1-264639bf5657"],
 "."
}], "Notes",ExpressionUUID->"f3d17fff-72f9-4b7f-ab1f-1c35fde6d037"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "77347e67-7231-4436-902c-529a7619f2da"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f80ca2b5-ddcf-4a5f-800d-d9d97cf326a8"],
 " are heads on heads: neither is a family of walks, so neither has a ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42730e23-a633-47d4-a1cc-f22d389e0aa8"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "220bc0e5-ac30-4b5e-ba5f-dd9ee31faafb"],
 ", ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc4af617-bd38-405e-8ab4-90ca74291e48"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52efb2e2-7f6b-4eda-a1a4-a381fa301bcf"],
 " or ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d0f59e0-c95c-4270-8437-faa1af270440"],
 ", and their ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dccd4afc-76de-48a8-b6c3-70dcbca3a98f"],
 " lists only the density, the subgraph and the two measures. The \
intersection's ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01fdb097-702c-4c92-91da-099ff7fcb686"],
 " is the product of the two objects' densities on their common vertices, the \
union's the sum."
}], "Notes",ExpressionUUID->"07950d7b-782e-42cc-8385-956d3ee43b41"],

Cell[TextData[{
 "A density, an association of vertex masses, is an object too: its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "adba5488-8ae4-42b4-8787-51b2d2d00aa8"],
 " is itself. So a union or an intersection may take densities as parts, and \
their masses may be negative: the union of a density ",
 StyleBox["d", "TI"],
 " and its negative ",
 Cell[BoxData["-"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66566183-a023-43ac-bc41-6d00c9688115"],
 StyleBox["d", "TI"],
 " is zero at every vertex of ",
 StyleBox["d", "TI"],
 "."
}], "Notes",ExpressionUUID->"941692df-1ed7-4ed2-b44b-9cab72547755"],

Cell[TextData[{
 "A circle takes a radius ",
 Cell[BoxData["r"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1888471-7129-49b0-99b1-53bfbb32e311"],
 " or a band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "s"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03bc721e-0a90-4dbb-8925-3b644992e4fc"],
 ", a scalar ",
 Cell[BoxData["r"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "787592aa-1c66-4f8b-b05d-13a3cfdf677d"],
 " meaning ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "r"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c6c1d3e-1bdf-45b2-b455-1b0e5cb0a136"],
 ". The circle through a point is the closed arc ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3860ed71-0007-43ab-a63b-417a08e8314d"],
 ", which widens the band of ",
 StyleBox["p", "TI"],
 " with ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"delta", " ", "|", " ", 
    RowBox[{"{", 
     RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80cdf656-2844-4076-9d31-7f6d89d099cb"],
 " (default ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b256d4d4-9469-4a0f-a5eb-ca1646d47f3d"],
 "). A scalar ",
 StyleBox["delta", "TI"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d45d714-c41a-4e30-8cd6-812b03a21665"],
 ", outward only."
}], "Notes",ExpressionUUID->"faad534e-d3d5-400d-b633-5f3a2cd933e2"],

Cell[TextData[{
 "On a polyline ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "efcf053b-7c46-4950-b89e-8b35b9e51403"],
 " the densities are not member counts: they are the sums of the piece \
densities. On the 5 \[Times] 5 grid, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"1", ",", " ", "13", ",", " ", "25"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53b790e0-ae1d-4abe-acef-4a8f3d582898"],
 " has 36 members, while its density at the centre 13 is 12."
}], "Notes",ExpressionUUID->"7eb7e1ff-c9a8-49d0-9a51-f3a380245ffe"]
}, Open  ]],

