     "14d59380-f26c-446f-87b9-feafb093154c"], Cell[
    "the number of members", "TableText",ExpressionUUID->
     "49446ca5-4699-4a66-b833-1af7506da663"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e0e94c45-011d-47dd-b23e-d7ba14637c81"], Cell[TextData[Cell[
    BoxData["\"\<Length\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5872ba1a-d383-4d77-9605-cf5494c356ec"]], "TableText",ExpressionUUID->
     "e34c932e-96a6-4520-a241-8e2a3e722d04"], Cell[TextData[{
     "the common length of the members, or a ",
     Cell[BoxData["List"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "99bce9e3-fd03-4d49-bf6a-e780087218e4"],
     " of lengths when they differ"
    }], "TableText",ExpressionUUID->"b72c9556-2990-4549-80a4-6fdc2e8e90f0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d0da9fb7-08e7-4b29-b8c5-3ab3a62c549a"], Cell[TextData[Cell[
    BoxData["\"\<VertexDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1f0b329a-cd45-4b21-98b1-b9df8cb09d46"]], "TableText",ExpressionUUID->
     "813670c5-82d1-4fed-9e10-9945cdc40660"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"<|", 
       RowBox[{"v", " ", "->", " ", 
        RowBox[{"occ", 
         RowBox[{"(", "v", ")"}]}]}], "|>"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "88caf08d-54d7-418a-91ed-aaedd67f2259"],
     ", the number of members through ",
     StyleBox["v", "TI"],
     "; on a polyline, the sum of the piece densities"
    }], "TableText",ExpressionUUID->"456c523f-25c0-4521-9c55-97280ae257c8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3ce73964-35dd-4f69-93d9-4f0088dee172"], Cell[TextData[Cell[
    BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2c588328-22d0-46b1-9242-3ec1a0abab85"]], "TableText",ExpressionUUID->
     "2b33f031-cb38-4ea5-9412-c90d386f4c7a"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"v", " ", "\[DirectedEdge]", " ", "w"}], " ", "->", " ", 
        RowBox[{"occ", 
         RowBox[{"(", 
          RowBox[{"v", " ", "->", " ", "w"}], ")"}]}]}], "|>"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3a451e78-7261-4c7d-86a4-30b03af81a80"],
     ", the number of members through the arrow; on a polyline, the sum of \
the piece densities"
    }], "TableText",ExpressionUUID->"55b4fed4-6f77-43e2-9c40-d96963807eb5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ff3b54b6-8e0c-4a41-a0b1-bb78b5d44b0c"], Cell[TextData[Cell[
    BoxData["\"\<Subgraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f5a8d6a2-ff1c-4746-9fef-4aa434c6f648"]], "TableText",ExpressionUUID->
     "3300a5e4-9ed7-4f85-b878-6b8c0090f89e"], Cell[TextData[{
     "the induced subgraph of the support, same as ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSubgraph"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSubgraph", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "bb536980-986c-4dfb-bd0e-0e0e7c602e28"]
    }], "TableText",ExpressionUUID->"58205b78-db02-442a-9bf6-77714a51e22f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "49a0bb5f-5022-482a-ac52-116d0edbf495"], Cell[TextData[Cell[
    BoxData["\"\<Faithful\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "12bb8684-9bcc-428f-ab91-e6fe9dc0137a"]], "TableText",ExpressionUUID->
     "9dbbeeb6-7963-4486-b740-8333cd8234a3"], Cell[TextData[{
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e331c951-bd11-48d8-8d72-d4f339f9fc73"],
     " on a segment, ray or line; ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Undetermined"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "a3014958-9ab1-483b-943e-dba4100a40be"],
     " on a circle or an arc, whose graph is proved faithful only under a \
hypothesis this paclet does not certify, except that a circle whose cut band \
is connected but whose seam has one side only gives ",
     Cell[BoxData["False"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0ec08b9e-8366-4f6f-9fe5-68e9def7cc29"]
    }], "TableText",ExpressionUUID->"e0b0fa8f-1e0d-439f-b727-b37cf1dbf41f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "981d0e01-fd14-4eb2-bf98-e5b4c213f951"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "76df066a-7b43-4684-b468-9af9d5f8b908"]], "TableText",ExpressionUUID->
     "fba72843-a818-4f13-834e-8ec7087e4276"], Cell[
    "the number of vertices of the support", "TableText",ExpressionUUID->
     "3a7c877f-8e2d-4bbf-891b-1be579800916"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "eeabc6eb-21ad-4a70-aef6-f25eabc0bdeb"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "583a12c7-85d2-426d-a99b-4643c2a144f9"]], "TableText",ExpressionUUID->
     "bf909b77-77a6-4fe6-b693-fe60b5a1e278"], Cell["\<\
the number of vertices of the support all of whose neighbours lie in the \
support\
\>", "TableText",ExpressionUUID->"452d572a-dd03-4a35-8595-0f121961f0cc"]}
  }]], "2ColumnTableMod",ExpressionUUID->"1d572b1a-87cc-440d-a10d-\
6cbe13e856f3"],

Cell[TextData[{
 "A region \[LongDash] a ball, shell, tube, cylinder or cone \[LongDash] has \
one member, its vertex set, and every vertex of the support has density 1. It \
has no ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9704bddc-443b-4edc-afc6-534e0fe6da95"],
 " and no ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dab31fdf-b869-4905-bb89-054267604596"],
 ". A sphere is a family, searched rather than read off a graph; its ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d653c230-1bf3-4383-bb23-53fcabc60daa"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4c827a1d-13a2-4cac-aaea-8394883e9772"],
 "."
}], "Notes",ExpressionUUID->"05b361a3-bea8-40ef-9871-8023a59bec88"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "27dac024-584b-4aa1-b80b-c7bae9421a48"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "92378547-c20f-4932-b527-7b43e87f97c0"],
 " are heads on heads: neither is a family of walks, so neither has a ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dff19ced-5c81-49d0-97e0-a98b6f7542fc"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4c335b0-5cf2-4c20-957b-08498551c2f7"],
 ", ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "777cf826-478b-4b96-a6e1-d76521058b2b"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f988de1d-a3d5-4923-98d4-fc0472a3c484"],
 " or ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59b4465d-7eec-4ead-9d2a-77aab55641fc"],
 ", and their ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbfa6c56-967d-49df-bb66-b3dbf1764c23"],
 " lists only the density, the subgraph and the two measures. The \
intersection's ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b283f41-27ad-4ba5-9e13-181c5e17f083"],
 " is the product of the two objects' densities on their common vertices, the \
union's the sum."
}], "Notes",ExpressionUUID->"064c3df9-ca94-4244-a8c1-68dd8e53ec1d"],

Cell[TextData[{
 "A circle takes a radius ",
 Cell[BoxData["r"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cfb7c912-7d07-413f-9016-9ae43861f1fb"],
 " or a band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "s"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d20e593-30e7-424b-863c-ca8f25d77f33"],
 ", a scalar ",
 Cell[BoxData["r"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79425435-6fc1-470b-a8c2-7bac11c2edcd"],
 " meaning ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "r"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ca89295-1618-4a6e-bf73-40f2a304f0ca"],
 ". The circle through a point is the closed arc ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33b497da-1d2e-478e-8258-17f08a38ba73"],
 ", which widens the band of ",
 StyleBox["p", "TI"],
 " with ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"delta", " ", "|", " ", 
    RowBox[{"{", 
     RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8951768a-8ae8-4e0e-aa77-a0cd0910f2d8"],
 " (default ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f96d3f34-02cd-4283-b4a3-07b4f14df411"],
 "). A scalar ",
 StyleBox["delta", "TI"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21b32ef4-cf87-478e-a13c-b44407fe8648"],
 ", outward only."
}], "Notes",ExpressionUUID->"0fe16ea3-c125-4162-ba41-074b23a502b0"],

Cell[TextData[{
 "On a polyline ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ac61c35-540d-4ca1-8f82-447244435c05"],
 " the densities are not member counts: they are the sums of the piece \
densities. On the 5 \[Times] 5 grid, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"1", ",", " ", "13", ",", " ", "25"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7470ae3c-1193-414c-8482-e6460366e140"],
 " has 36 members, while its density at the centre 13 is 12."
}], "Notes",ExpressionUUID->"c15d3dae-f203-44f7-92bc-a730fbc9ee6f"]
}, Open  ]],

