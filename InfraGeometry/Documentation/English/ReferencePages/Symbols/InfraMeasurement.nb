Cell["\<\
The graph of the segment: its source-to-sink chains are the shortest paths.\
\>", "ExampleText",ExpressionUUID->"da678944-851d-4017-96a2-e01899f61ac2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"a", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"3eef4032-6701-4774-9e1d-9f493ccba43d"],

