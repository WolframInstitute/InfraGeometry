Cell[TextData[{
 "The tube about a segment on the square grid, against ",
 StyleBox["(a + 1)(b + 1) + 2s(a + b + 2) + 2s(s \[Minus] 1)", "TI"],
 " with ",
 StyleBox["a", "TI"],
 " = 3, ",
 StyleBox["b", "TI"],
 " = 2:"
}], "ExampleText",ExpressionUUID->"67f51d9e-6c56-4864-af33-c49e177f301b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"xy", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{"xy", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"#", " ", "-", " ", 
            RowBox[{"xy", "[", "c", "]"}]}], " ", "==", " ", 
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "2"}], "}"}]}], " ", "&"}]}], "]"}]}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"InfraTube", "[", 
         RowBox[{
          RowBox[{"InfraSegment", "[", 
           RowBox[{"c", ",", " ", "b"}], "]"}], ",", " ", "s"}], "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"s", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], ",", 
      " ", "\"\<CountingMeasure\>\""}], "]"}], " ", "==", "\n", "    ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"12", " ", "+", " ", 
       RowBox[{"14", " ", "s"}], " ", "+", " ", 
       RowBox[{"2", " ", "s", " ", 
        RowBox[{"(", 
         RowBox[{"s", " ", "-", " ", "1"}], ")"}]}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"s", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7d64b113-bcda-40ba-9521-652cdab603a6"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"db01c7c9-6fcf-47c7-8217-324ec89909fb"]
}, Open  ]],

Cell[TextData[{
 "The Riemannian measure of the ball of radius ",
 StyleBox["r", "TI"],
 " minus the counting measure of the ball of radius ",
 StyleBox["r \[Minus] 1", "TI"],
 ". It is 0 on the grid; on the mesh the dead ends of the outer layer add to \
the interior:"
}], "ExampleText",ExpressionUUID->"804b29c5-d8d0-40cc-8af9-60ed8d653d31"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraBall", "[", 
             RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
            " ", "\"\<RiemannianMeasure\>\""}], "]"}], " ", "-", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraBall", "[", 
             RowBox[{"c", ",", " ", 
              RowBox[{"r", " ", "-", " ", "1"}]}], "]"}], ",", 
            " ", "\"\<CountingMeasure\>\""}], "]"}]}], ",", "\n", "      ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "7"}], "}"}]}], "]"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"{", 
      RowBox[{"name", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<SquareGridGraph\>\"", ",", 
         " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}], ",", "\n",
    "  ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<SquareMeshGraph\>\""}],
      "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"46ae5c38-22f7-4cf1-89d5-892dcde09f1a"],

