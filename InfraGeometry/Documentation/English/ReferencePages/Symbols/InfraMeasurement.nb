  FontSize->0.9 Inherited,ExpressionUUID->
  "e3c8d656-11de-42d4-82b1-2b3743874492"],
 " is the value of ",
 StyleBox["property", "TI"],
 " of the object ",
 StyleBox["obj", "TI"],
 " on ",
 StyleBox["graph", "TI"],
 ". The support of ",
 StyleBox["obj", "TI"],
 " is the set ",
 StyleBox["A", "TI"],
 " of vertices its members pass through, ",
 Cell[BoxData[
  RowBox[{"Keys", " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"graph", ",", " ", "obj", ",", " ", "\"\<VertexDensity\>\""}], 
    "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62020d94-ebe3-403c-b319-1b6b23488b88"],
 ". The two measures of ",
 StyleBox["obj", "TI"],
 " are measures of ",
 StyleBox["A", "TI"],
 ":"
}], "Notes",ExpressionUUID->"d9912fd8-c8cb-440d-b0aa-4bcae95c202d"],

