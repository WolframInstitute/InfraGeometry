Cell["\<\
The profiles of the regions about the centre of the square grid, under the \
counting measure on the left and the Riemannian measure on the right: the \
ball and the shell over the radius, the fat and the thin tube about a segment \
of length 5 over the thickness.\
\>", "ExampleText",ExpressionUUID->"8f16ec2f-da63-49f5-9d36-224094f64fb6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fat", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "5"}], "]"}]}], ")"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"geodesic", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", "fat"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"{", "\n", "      ", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"InfraBall", "[", 
               RowBox[{"c", ",", " ", "r"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], ",",
             " ", "measure"}], "]"}], ",", "\n", "      ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"InfraShell", "[", 
               RowBox[{"c", ",", " ", "r"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], ",",
             " ", "measure"}], "]"}], ",", "\n", "      ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"InfraTube", "[", 
               RowBox[{"fat", ",", " ", "s"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"s", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], ",",
             " ", "measure"}], "]"}], ",", "\n", "      ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"InfraTube", "[", 
               RowBox[{"geodesic", ",", " ", "s"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"s", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], ",",
             " ", "measure"}], "]"}]}], "}"}], ",", "\n", "      ", 
        RowBox[{"DataRange", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "5"}], "}"}]}], ",", " ", 
        RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
        RowBox[{"PlotLegends", " ", "->", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<ball\>\"", ",", " ", "\"\<shell\>\"", ",", 
           " ", "\"\<fat tube\>\"", ",", " ", "\"\<thin tube\>\""}], 
          "}"}]}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"measure", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<CountingMeasure\>\"", ",", 
          " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "}"}]}], "]"}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5be974b4-bda0-489c-98f0-46c15d42cb80"],

