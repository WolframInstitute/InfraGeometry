Cell[TextData[{
 "A region \[LongDash] a ball, shell, tube, cylinder or cone \[LongDash] has \
one member, its vertex set, and every vertex of the support has density 1. It \
has no ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "581eda5e-d435-4f06-8cd0-54f124691ddd"],
 " and no ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb8e7e1e-4c41-4bec-a283-028749a47391"],
 ". A sphere is a family, searched rather than read off a graph; its ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba1d0bda-0b1a-443d-95de-0b03b4e3094d"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a8f0e129-052b-4c8d-8258-c62590a37c20"],
 "."
}], "Notes",ExpressionUUID->"16225c19-1499-498c-a93b-aef67d686fc5"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5931e4f7-0ff8-46e0-a2f8-69b57f73aacb"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c11820a2-e158-4e42-b5f0-0579151a4500"],
 " are heads on heads: neither is a family of walks, so neither has a ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7660cf9c-5af2-4b18-a2a3-dd1242209ae9"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d2251c9-bb4f-4148-95c3-2d03f095ce55"],
 ", ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b647736-a728-4f54-8420-2663588c5d47"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68654f1c-517f-4d98-8145-fb7cfa76b9b8"],
 " or ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14953095-85cc-4a7f-8204-9325a14efe24"],
 ", and their ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52630b7a-e140-4cad-a916-d5d2e0db9a33"],
 " lists only the density, the subgraph and the two measures. The \
intersection's ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c68cdcf9-a80a-4d3f-a2f4-485980ae4a53"],
 " is the product of the two objects' densities on their common vertices, the \
union's the sum."
}], "Notes",ExpressionUUID->"ccb855ca-3d8a-4e0f-bb21-74150f2374d5"],

Cell[TextData[{
 "A circle or a circle band takes ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
   RowBox[{"r", " ", "|", " ", 
    RowBox[{"{", 
     RowBox[{"r", ",", " ", "s"}], "}"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "221202b5-47cd-4551-98ef-62ad1a712da8"],
 " in place of a point, or widens the circle through a point with ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"delta", " ", "|", " ", 
    RowBox[{"{", 
     RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "adc3c09c-ffff-4bb7-a8a8-382294070d85"],
 " (default ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a82c9204-0d94-4cc3-81d5-8519f4b3bc89"],
 "). A scalar ",
 StyleBox["delta", "TI"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6affeea-2ddc-46c9-91f9-aed2eeedb68b"],
 ", outward only."
}], "Notes",ExpressionUUID->"6434cdd4-db5e-44cb-bc2e-1c7d712b7ae0"],

Cell[TextData[{
 "On a polyline ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f9c60e3-1e3e-4377-a5cb-4605b418d153"],
 " the densities are not member counts: they are the sums of the piece \
densities. On the 5 \[Times] 5 grid, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"1", ",", " ", "13", ",", " ", "25"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "349b7d40-39bd-47d1-bf2c-12e51e1f34b8"],
 " has 36 members, while its density at the centre 13 is 12."
}], "Notes",ExpressionUUID->"03908df9-eadf-4b4c-a40a-66ff7ce8f17a"]
}, Open  ]],

