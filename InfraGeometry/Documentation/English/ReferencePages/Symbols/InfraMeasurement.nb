     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"InfraBall", "[", 
        RowBox[{"c", ",", " ", "r"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}], ",", 
     " ", "\"\<CountingMeasure\>\""}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3b54f02e-51f2-4376-aa9a-422dad711735"],

