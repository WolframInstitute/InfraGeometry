    BoxData["\"\<Graph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3a248fba-7871-42f5-b313-c637e4cc1aad"]], "TableText",ExpressionUUID->
     "3b566612-f2bc-499b-b540-62ab563f0a9b"], Cell[TextData[{
     "the object's own graph: one ",
     Cell[BoxData["Graph"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "399ae014-1874-43c6-9080-be8e7bb673e1"],
