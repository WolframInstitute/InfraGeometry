Cell["\<\
A shell of the square grid has no two adjacent vertices, so it carries no \
circle. The band of radii 3 and 4 carries one:\
\>", "ExampleText",ExpressionUUID->"b776e5d3-a6df-4fbf-9808-818999b65ef1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
          " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", "band"}], "]"}], ",", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"c", ",", " ", "band"}], "]"}]}], "}"}], ",", "\n", 
        "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraCircle", "[", 
            RowBox[{"c", ",", " ", "band"}], "]"}], ",", 
           " ", "\"\<Cardinality\>\""}], "]"}]}]}], "]"}]}], "]"}], ",", "\n",
     "  ", 
    RowBox[{"{", 
     RowBox[{"band", ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c0794f88-7f93-4104-9d16-930e666ae037"],

