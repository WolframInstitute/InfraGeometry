Cell[TextData[{
 "The support of every object \[LongDash] what ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be3c36e4-961a-4937-a09b-6578f17e344e"],
 " and the four volumes read \[LongDash] is ",
 Cell[BoxData[
  RowBox[{"Keys", " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"graph", ",", " ", "obj", ",", " ", "\"\<VertexDensity\>\""}], 
    "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2e0034e-7338-414c-9f72-963faf3a52f7"],
 "."
}], "Notes",ExpressionUUID->"006c9582-fd3b-477d-98a5-4f6a9d17e44b"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e881755a-dbf7-4892-8026-40b034ffb2c7"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8672f63a-8261-461b-9ce8-5cf30ec9257c"],
 " are heads on heads: neither is a family of walks, so neither has a ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "031ca085-47f4-44c1-bd00-1e9424ca47e6"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "000d6717-cb1f-4a64-908f-11473aaf33e3"],
 ", ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e34c76e-ffed-402b-8c96-87dca553042a"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dbc8571-315a-4e70-a014-e1846a40bf8a"],
 " or ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32048042-cf33-4ec3-9974-7d5b48679611"],
 ", and their ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62b3a4fb-c127-4eed-a92d-4fe440e075b2"],
 " lists only the density, the subgraph and the four volumes. The \
intersection's ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c3b2fcf-b803-4ffa-b5a9-71f856c20c7f"],
 " is the product of the two objects' densities on their common vertices, the \
union's the sum."
}], "Notes",ExpressionUUID->"aec5ce4b-022d-4165-8c36-0c346743e24c"],

Cell[TextData[{
 "A circle or a circle band takes ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
   RowBox[{"r", " ", "|", " ", 
    RowBox[{"{", 
     RowBox[{"r", ",", " ", "s"}], "}"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc3c6e72-2ecb-4433-bb54-0a74303951f2"],
 " in place of a point, or widens the circle through a point with ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"delta", " ", "|", " ", 
    RowBox[{"{", 
     RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e03b7b3f-f0c9-47f7-a9a7-6df8174b9c7e"],
 " (default ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b257962-8e05-4cec-a7f5-3e9fc458c668"],
 "). A scalar ",
 StyleBox["delta", "TI"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58c74f45-46da-4016-8946-39d809cfe0a1"],
 ", outward only."
}], "Notes",ExpressionUUID->"e1f17299-eb9f-4baa-90ca-3bba3ab4338a"],

Cell[TextData[{
 "On a polyline ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c37bb3cd-4e4c-409e-89b1-254f7c4f5e63"],
 " the densities are not member counts: they are the sums of the piece \
densities. On the 5 \[Times] 5 grid, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"1", ",", " ", "13", ",", " ", "25"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d47b0353-d7e1-4628-8fce-4f22032f9238"],
 " has 36 members, while its density at the centre 13 is 12."
}], "Notes",ExpressionUUID->"a7267115-9f35-4f8f-9528-bb1fc7bfcb15"]
}, Open  ]],

