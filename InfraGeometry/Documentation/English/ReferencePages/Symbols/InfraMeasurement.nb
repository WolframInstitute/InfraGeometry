Cell[TextData[{
 "The support of every object \[LongDash] what ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0811d8bd-7490-4f48-8479-d411a49e4d0b"],
 " and the four volumes read \[LongDash] is ",
 Cell[BoxData[
  RowBox[{"Keys", " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"graph", ",", " ", "obj", ",", " ", "\"\<VertexDensity\>\""}], 
    "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84c726c0-47f5-45ab-9c53-0494c615ef47"],
 "."
}], "Notes",ExpressionUUID->"5864ea6e-b803-45ef-a9af-7381562f49df"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7a9362a1-07ff-4e5c-befd-c8d400475f30"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "23c8e7aa-0a60-49a9-9741-8995ec9bf048"],
 " are heads on heads: neither is a family of walks, so neither has a ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40b7804e-841d-4d81-a50c-64509c083195"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fece00c6-9d60-4b62-b69e-63d847173c52"],
 ", ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b67868e-b9bf-4c9b-8734-cc9d06d22deb"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ff9a9a8-b1d5-415a-8990-ef324527d890"],
 " or ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b093cb5-2605-4955-add8-f3d118252006"],
 ", and their ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "458763c6-e105-4dc2-9aa5-3cf73ec61c6d"],
 " lists only the density, the subgraph and the four volumes. The \
intersection's ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32cd01f2-86be-49de-9be4-16a8e55bb02d"],
 " is the product of the two objects' densities on their common vertices, the \
union's the sum."
}], "Notes",ExpressionUUID->"c8121cf3-cd98-499f-a9a9-af0c8eca7372"],

Cell[TextData[{
 "A circle or a circle band takes ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
   RowBox[{"r", " ", "|", " ", 
    RowBox[{"{", 
     RowBox[{"r", ",", " ", "s"}], "}"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "616d235b-dcd9-4c8b-9a18-ddf1ddf2277b"],
 " in place of a point, or widens the circle through a point with ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"delta", " ", "|", " ", 
    RowBox[{"{", 
     RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a2587bf-0a44-4021-8f1a-b0fb0e6d9070"],
 " (default ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8e39bda-d9b8-4f5c-bdd3-ab10c7e4494a"],
 "). A scalar ",
 StyleBox["delta", "TI"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd82c933-a913-49fd-b507-3e838af4848d"],
 ", outward only."
}], "Notes",ExpressionUUID->"00cc5f76-62ea-4419-a4e0-7af9858f7b4c"],

Cell[TextData[{
 "On a polyline ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64e8d36c-817d-415b-917d-8e57ab7f7205"],
 " the densities are not member counts: they are the sums of the piece \
densities. On the 5 \[Times] 5 grid, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"1", ",", " ", "13", ",", " ", "25"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b8fe0c4-48a0-43af-b976-a1714400fbe9"],
 " has 36 members, while its density at the centre 13 is 12."
}], "Notes",ExpressionUUID->"f060551e-bd0f-431e-a300-8c7ac3f8dede"]
}, Open  ]],

