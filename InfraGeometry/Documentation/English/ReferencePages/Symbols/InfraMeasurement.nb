     "cad60bc0-556a-4050-9ed8-e408561fd522"], Cell[
    "the number of members", "TableText",ExpressionUUID->
     "bfc88510-5363-4778-b6f8-001b64986d22"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6b6739d8-8e46-4540-9f1f-1e7c850db207"], Cell[TextData[Cell[
    BoxData["\"\<Length\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "bbe634d4-e237-46d6-99fd-1c095913fc18"]], "TableText",ExpressionUUID->
     "3b69dd3a-f497-416f-89ef-4312f301f0e4"], Cell[TextData[{
     "the common length of the members, or a ",
     Cell[BoxData["List"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5988c856-ba30-4b42-a57d-8dd6b5da5d97"],
     " of lengths when they differ"
    }], "TableText",ExpressionUUID->"8002bfd1-a520-45a0-8071-b7701976c945"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b762975a-b284-405e-ac41-4119c46aaed7"], Cell[TextData[Cell[
    BoxData["\"\<VertexDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7e68367b-08df-48b2-aba0-7b61333e48d8"]], "TableText",ExpressionUUID->
     "52f549a7-2fc4-4c54-979c-17e5cd0890c2"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"<|", 
       RowBox[{"v", " ", "->", " ", 
        RowBox[{"occ", 
         RowBox[{"(", "v", ")"}]}]}], "|>"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4c4de88e-9eea-4f1f-8d3f-5852f2bc72a3"],
     ", the number of members through ",
     StyleBox["v", "TI"],
     "; on a polyline, the sum of the piece densities"
    }], "TableText",ExpressionUUID->"f38947c0-65eb-4cc2-9b26-de96ebf39cab"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "dca459a5-0a8a-4823-b107-905b1ed423d8"], Cell[TextData[Cell[
    BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0c6d8466-6b04-4b5e-b107-396547ff6444"]], "TableText",ExpressionUUID->
     "35b37102-5c1d-4a06-a9f6-9273fa852202"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"v", " ", "\[DirectedEdge]", " ", "w"}], " ", "->", " ", 
        RowBox[{"occ", 
         RowBox[{"(", 
          RowBox[{"v", " ", "->", " ", "w"}], ")"}]}]}], "|>"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3c5b1b35-3404-4461-9085-b01eaaea5d21"],
     ", the number of members through the arrow; on a polyline, the sum of \
the piece densities"
    }], "TableText",ExpressionUUID->"a579cd68-9b5c-4d9b-9b89-cc8de402a7bd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f6614596-2ede-4b03-9ac5-c2bd7c90e3af"], Cell[TextData[Cell[
    BoxData["\"\<Subgraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0fe29833-c5f6-4221-8901-706ae9e787ae"]], "TableText",ExpressionUUID->
     "b5a787ab-9fc5-4598-b1fe-9989df505aa8"], Cell[TextData[{
     "the induced subgraph of the support, same as ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSubgraph"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSubgraph", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "865843f5-49ac-42fe-814f-119f656f5b00"]
    }], "TableText",ExpressionUUID->"0960f3e9-f5a4-4eaa-a5a1-ebb7a358d75e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1583ddf9-011a-4ba0-9317-4e4e1439bdbf"], Cell[TextData[Cell[
    BoxData["\"\<Faithful\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "83991867-08dd-40bc-bf00-aff24e4400a6"]], "TableText",ExpressionUUID->
     "62928d80-ad74-443d-bf90-d9e5b12fa720"], Cell[TextData[{
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f443a1ba-1281-4701-95fe-cf99c37bc6ab"],
     " on a segment, ray or line; ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Undetermined"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "ea4d87fa-36e2-4b70-bb37-7ddd0b912a14"],
     " on a circle or an arc, whose graph is proved faithful only under a \
hypothesis this paclet does not certify, except that a circle whose cut band \
is connected but whose seam has one side only gives ",
     Cell[BoxData["False"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "905e9d2e-861d-47b7-b6fa-8f964a7dbd99"]
    }], "TableText",ExpressionUUID->"e1e6bd59-07ee-48a1-8ed9-400a822f3f3a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9f5c2464-4909-44a1-a087-8f6259edb781"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "38ab201a-f8be-453b-8233-fe990e13ae50"]], "TableText",ExpressionUUID->
     "798d9ed6-a4d4-4511-9f05-0275c3ef5f5f"], Cell[
    "the number of vertices of the support", "TableText",ExpressionUUID->
     "2ab0edd1-eceb-4578-b829-df6837826019"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ff449e3f-ad01-4b16-b03d-5b98ceaf209e"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "e61f57c9-1ab3-4f4d-b465-428927d9b89f"]], "TableText",ExpressionUUID->
     "fda03d91-1109-4c1f-bead-7daba832b3f9"], Cell["\<\
the number of vertices of the support all of whose neighbours lie in the \
support\
\>", "TableText",ExpressionUUID->"ca11bab2-7679-400d-b99f-0a100b3d11f3"]}
  }]], "2ColumnTableMod",ExpressionUUID->"ee92354c-d29a-40a3-af06-\
7a5053477c6b"],

Cell[TextData[{
 "A region \[LongDash] a ball, shell, tube, cylinder or cone \[LongDash] has \
one member, its vertex set, and every vertex of the support has density 1. It \
has no ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ea440b9-f46c-4436-9733-c2a3628f7378"],
 " and no ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d318087a-aefc-4446-968c-e2e57567aaa1"],
 ". A sphere is a family, searched rather than read off a graph; its ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d108fb77-8604-48eb-aa0f-c90de3171927"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fec8c42e-6503-4378-9a37-cb6547842d40"],
 "."
}], "Notes",ExpressionUUID->"aceb65a7-d0c0-4ae4-bd04-721acd5a72f4"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9fe01bcd-e6e7-4699-b94f-6af0d867eea2"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "228f8321-fc11-413d-ab79-fd5518eb0df0"],
 " are heads on heads: neither is a family of walks, so neither has a ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c4a8f63-f48f-4d52-9c15-c4f442cbe74b"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aebec00d-2516-4b77-a53b-bbccce581f67"],
 ", ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c79a4bb7-77e4-4cfd-ba90-cca868e53a18"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "517163be-f421-4c34-9a98-731ed7d60217"],
 " or ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3bcdd47-6010-4c97-a3f7-5949a4bd47bd"],
 ", and their ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3f096ea-b45e-4509-b884-e1c18f626d85"],
 " lists only the density, the subgraph and the two measures. The \
intersection's ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47fb391e-ad2e-44c0-a22d-c9c1493155ae"],
 " is the product of the two objects' densities on their common vertices, the \
union's the sum."
}], "Notes",ExpressionUUID->"efc399c0-99cb-44a0-8dc1-2e70deaafe1f"],

Cell[TextData[{
 "A circle takes a radius ",
 Cell[BoxData["r"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "836472fa-f7f7-41bb-8ad9-8bb7c9feab0b"],
 " or a band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "s"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bdfb817-48eb-48eb-8deb-ff823084985e"],
 ", a scalar ",
 Cell[BoxData["r"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "041cec75-8460-4140-a8da-d594005d253f"],
 " meaning ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "r"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1d16ce7-a14d-406a-be22-ce5f544c778a"],
 ". The circle through a point is the closed arc ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61fa78f8-88fb-4999-8826-85d314144934"],
 ", which widens the band of ",
 StyleBox["p", "TI"],
 " with ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"delta", " ", "|", " ", 
    RowBox[{"{", 
     RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd6f8b05-6a1b-4d56-8a42-35d6ea41f68c"],
 " (default ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f21c2331-c773-4251-854e-f5bfb8f0200d"],
 "). A scalar ",
 StyleBox["delta", "TI"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96a4ba57-001b-4cdf-9802-f6b147169a55"],
 ", outward only."
}], "Notes",ExpressionUUID->"7a59cf63-867a-45ad-8435-2d512280b4f0"],

Cell[TextData[{
 "On a polyline ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4e57a08-bb6b-4b26-951a-a7c418d67e26"],
 " the densities are not member counts: they are the sums of the piece \
densities. On the 5 \[Times] 5 grid, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"1", ",", " ", "13", ",", " ", "25"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a47dd1a6-962e-4d26-9185-af34308649d0"],
 " has 36 members, while its density at the centre 13 is 12."
}], "Notes",ExpressionUUID->"eb6b24c7-9132-45df-8bc7-38e361217ee2"]
}, Open  ]],

