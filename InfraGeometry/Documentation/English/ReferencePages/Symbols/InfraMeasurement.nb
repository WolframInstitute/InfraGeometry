Cell["\<\
A ball, a band and a tube, each with its interior drawn over it. The counting \
measure counts the region, the Riemannian measure its interior:\
\>", "ExampleText",ExpressionUUID->"9536e835-7022-4cc3-a730-706678e8f1b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"region", ",", " ", 
          RowBox[{"InfraInterior", "[", 
           RowBox[{"g", ",", " ", "region"}], "]"}]}], "}"}], ",", "\n", 
        "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"Values", " ", "@", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", "region", ",", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<CountingMeasure\>\"", ",", 
              " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "]"}]}]}]}], "]"}],
       ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"region", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraBall", "[", 
           RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"InfraTube", "[", 
           RowBox[{"seg", ",", " ", "1"}], "]"}]}], "}"}]}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"765a6cda-5814-4ceb-9a72-f0f8da25ad3f"],

