ball does not:"
}], "ExampleText",ExpressionUUID->"7498ff55-f4a2-40cb-af53-33a5150596ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "#", ",", " ", "All"}], "]"}]}], " ", "&"}], 
    " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraSegment", "[", 
       RowBox[{"c", ",", " ", "49"}], "]"}], ",", " ", 
      RowBox[{"InfraBall", "[", 
       RowBox[{"c", ",", " ", "3"}], "]"}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"dc8f4566-816b-4522-bb98-d16fb156c486"],

