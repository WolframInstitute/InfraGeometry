    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7bdababd-332e-4035-8191-472f3f54dbb9"]], "TableText",ExpressionUUID->
     "26b925fc-ad15-4991-8ee6-74146b9742a5"], Cell[TextData[{
     StyleBox["|A|", "TI"],
     ", the number of vertices of the support"
    }], "TableText",ExpressionUUID->"e1615024-3dce-44d7-8de7-d2f8249f1682"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c5e103dc-8379-4997-8e56-66396124b397"], Cell[TextData[Cell[
