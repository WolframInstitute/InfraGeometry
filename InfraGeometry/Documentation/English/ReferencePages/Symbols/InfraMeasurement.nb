Cell["\<\
The support is the key set of the vertex density. The counting measure is its \
size, the Riemannian measure the size of its interior.\
\>", "ExampleText",ExpressionUUID->"ff076bc9-6bca-4016-b2ff-807ba8566d8e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"InfraBall", "[", 
      RowBox[{
       RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "4"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"support", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "ball", ",", " ", "\"\<VertexDensity\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Length", " ", "@", " ", "support"}], ",", " ", 
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"InfraInterior", "[", 
         RowBox[{"g", ",", " ", "support"}], "]"}]}]}], "}"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "ball", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<CountingMeasure\>\"", ",", 
         " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"63b5d556-ef01-4873-9d52-bf7aaf3d2dba"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"41", ",", "25"}], "}"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"CountingMeasure\"\>", "\[Rule]", "41"}], ",", 
     RowBox[{"\<\"RiemannianMeasure\"\>", "\[Rule]", "25"}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"fa0802cc-3b09-4f1c-80ce-2b76779cb709"]
}, Open  ]],

Cell[TextData[{
 "On the square grid and the hexagonal tiling the Riemannian measure of the \
ball of radius ",
 StyleBox["r", "TI"],
 " is the counting measure of the ball of radius ",
 StyleBox["r \[Minus] 1", "TI"],
 ", and their difference is 0. On the discretized plane it is not: a vertex \
at distance ",
 StyleBox["r", "TI"],
 " with no neighbour at distance ",
 StyleBox["r + 1", "TI"],
 " is inside the ball."
}], "ExampleText",ExpressionUUID->"46ccabea-0e94-431d-8a1c-6f2d9f615bc1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"names", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
        ",", " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"ListLinePlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"name", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], ",",
          "\n", "        ", 
         RowBox[{"{", 
          RowBox[{"c", " ", "=", " ", 
           RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", 
         "        ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraBall", "[", 
               RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
              " ", "\"\<RiemannianMeasure\>\""}], "]"}], " ", "-", " ", 
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraBall", "[", 
               RowBox[{"c", ",", " ", 
                RowBox[{"r", " ", "-", " ", "1"}]}], "]"}], ",", 
              " ", "\"\<CountingMeasure\>\""}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"r", ",", " ", "1", ",", " ", "7"}], "}"}]}], "]"}]}], 
        "]"}], ",", "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", "names"}], "}"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"DataRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "7"}], "}"}]}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", "names"}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<r\>\"", ",", " ", "None"}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1e602221-05ab-4afd-8eaa-e8877e423fca"],

