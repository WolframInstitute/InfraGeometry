    BoxData["\"\<Graph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "35128f50-b061-469d-8249-c748d107f9b2"]], "TableText",ExpressionUUID->
     "fdf005da-05ab-4bd4-b33b-4836b0f9ba07"], Cell[TextData[{
     "the object's own graph: one ",
     Cell[BoxData["Graph"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "558de038-56d9-452a-9933-9739ef297f31"],
     ", or a ",
