  FontSize->0.9 Inherited,ExpressionUUID->
  "55be9ff9-7c8e-4328-b1bf-33f0e0989db6"],
 " is the value of ",
 StyleBox["property", "TI"],
 " of the object ",
 StyleBox["obj", "TI"],
 " on ",
 StyleBox["graph", "TI"],
 ". The support of ",
 StyleBox["obj", "TI"],
 " is the set ",
 StyleBox["A", "TI"],
 " of vertices its members pass through, ",
 Cell[BoxData[
  RowBox[{"Keys", " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"graph", ",", " ", "obj", ",", " ", "\"\<VertexDensity\>\""}], 
    "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "906316e4-7f41-4c0a-b583-394f5840a7d0"],
 ". The two measures of ",
 StyleBox["obj", "TI"],
 " are measures of ",
 StyleBox["A", "TI"],
 ":"
}], "Notes",ExpressionUUID->"3d05dc18-9ab9-489d-a7dd-829ea490dd2c"],

