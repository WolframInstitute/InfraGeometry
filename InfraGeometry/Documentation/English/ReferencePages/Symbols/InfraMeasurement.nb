Cell["\<\
A segment between opposite corners of a grid fills it, and the rim of the \
grid is not a boundary: both measures are 25.\
\>", "ExampleText",ExpressionUUID->"d2070861-ba4c-4a70-954c-f96a81c6a861"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraMeasurement", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
   RowBox[{"InfraSegment", "[", 
    RowBox[{"1", ",", " ", "25"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Cardinality\>\"", ",", " ", "\"\<CountingMeasure\>\"", ",", 
     " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"1306e7ab-55b9-4412-b2bb-4df543a5611d"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Cardinality\"\>", "\[Rule]", "70"}], ",", 
   RowBox[{"\<\"CountingMeasure\"\>", "\[Rule]", "25"}], ",", 
   RowBox[{"\<\"RiemannianMeasure\"\>", "\[Rule]", "25"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"34a61752-dba9-4b53-b5b9-11d43eed68bf"]
}, Open  ]],

Cell["\<\
An intersection of two heads has no members, only a support and a density, \
the product of the two. The segment and the circles, then their intersection.\
\
\>", "ExampleText",ExpressionUUID->"d275528a-72a5-4179-a99f-ec6b3eeb9bf4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"a", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"InfraCircle", "[", 
      RowBox[{"a", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"density", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraIntersection", "[", 
        RowBox[{"seg", ",", " ", "circle"}], "]"}], ",", 
       " ", "\"\<VertexDensity\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{"seg", ",", " ", "circle"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", "density", "}"}]}], "]"}]}], "}"}], "]"}], ",", " ", 
     "density"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"6f1f1a22-148b-4d68-aa73-80f0fdce9afc"],

