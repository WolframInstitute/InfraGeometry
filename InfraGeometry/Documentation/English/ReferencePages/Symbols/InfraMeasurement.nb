Cell["\<\
The graph of the same segment: its source-to-sink chains are the shortest \
paths.\
\>", "ExampleText",ExpressionUUID->"f18ae161-599c-4407-92ff-5917605ffdaf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
