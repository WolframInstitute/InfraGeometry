Cell["A list of heads is measured head by head.", "ExampleText",ExpressionUUID->"fc1f172b-7a56-421c-af76-34404a77582b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "4"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"heads", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraSegment", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"a", ",", " ", 
         RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4"}], "}"}]}]}], "]"}]}], "}"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", "heads"}], "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "heads", ",", " ", "\"\<Cardinality\>\""}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"dacb5ef8-8cf4-41bc-9cd6-d3ba63890f1b"],

