Cell[TextData[{
 "A region \[LongDash] a ball, shell, tube, cylinder or cone \[LongDash] has \
one member, its vertex set, and every vertex of the support has density 1. It \
has no ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe685a78-25c9-4e4d-9d1a-830bd3716080"],
 " and no ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fda08038-0b9c-4a67-9af6-813cf43b3c87"],
 ". A sphere is a family, searched rather than read off a graph; its ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7321cba4-0ff5-4c16-a77e-0952f3684257"],
 " is ",
 Cell[BoxData["Undetermined"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e567a987-ea39-4d08-b20e-f1fbe4b63c4c"],
 "."
}], "Notes",ExpressionUUID->"f0fdd603-fb48-407b-8c52-5af51945946f"],

Cell[TextData[{
 Cell[BoxData["InfraIntersection"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d24f9a1d-dc5b-40c7-b50f-c455d43b9bc4"],
 " and ",
 Cell[BoxData["InfraUnion"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "91c69250-6796-4df1-b2f7-48bbf5f76044"],
 " are heads on heads: neither is a family of walks, so neither has a ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6ec98b7-f724-40d7-a40b-bdaad6d831d2"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5620005-2129-41ab-aa36-30eb2295a358"],
 ", ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8cbbd186-d626-44f7-84c6-115dcce2c433"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c568cc6-8a61-4643-a22c-fc6ccca92a01"],
 " or ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c72c16c-5965-42b4-b9e6-665b1711b7ae"],
 ", and their ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aca9e35b-7b35-419f-b652-5fcb7695659f"],
 " lists only the density, the subgraph and the two measures. The \
intersection's ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e1684e7-aee4-462a-b8bf-def2b70e7f56"],
 " is the product of the two objects' densities on their common vertices, the \
union's the sum."
}], "Notes",ExpressionUUID->"8beccc4e-e3a4-425b-bd1c-747fa219e4e7"],

Cell[TextData[{
 "A circle takes a radius ",
 Cell[BoxData["r"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2b8c9b9-d63a-442f-bc66-71506204d4df"],
 " or a band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "s"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf028958-da6a-4c80-b729-379391d02cf7"],
 ", a scalar ",
 Cell[BoxData["r"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1126d8a-b4bd-458d-9665-7f4dab173933"],
 " meaning ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "r"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e1225a9-aa08-4824-aced-61df89027ed3"],
 ". The circle through a point is the closed arc ",
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bd3f063-c2dc-432a-b385-a17c0920ec99"],
 ", which widens the band of ",
 StyleBox["p", "TI"],
 " with ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"delta", " ", "|", " ", 
    RowBox[{"{", 
     RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5121be13-9481-475d-b123-4aa0c3ad3e89"],
 " (default ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f18ca70-8c42-4b78-ad7b-b618104fbb54"],
 "). A scalar ",
 StyleBox["delta", "TI"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "727b4990-0395-4e79-ba1c-4ce3fd4b3b4f"],
 ", outward only."
}], "Notes",ExpressionUUID->"f9276fc1-0720-4400-b77d-904e3922856e"],

Cell[TextData[{
 "On a polyline ",
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "951f608d-1ee8-4a94-82cf-b5800c3804d2"],
 " the densities are not member counts: they are the sums of the piece \
densities. On the 5 \[Times] 5 grid, ",
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   RowBox[{"1", ",", " ", "13", ",", " ", "25"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce2cf39c-eb5e-4f1a-8eb0-02b3033a79b4"],
 " has 36 members, while its density at the centre 13 is 12."
}], "Notes",ExpressionUUID->"e2848943-1466-44b1-a99b-888527b03f9b"]
}, Open  ]],

