Cell["\<\
A segment from the centre to a vertex four steps away on the discretized \
plane, the square grid and the hexagonal tiling, drawn by its densities, \
beside its number of shortest paths, their length and its two measures.\
\>", "ExampleText",ExpressionUUID->"2ecf1353-804c-4667-a34b-2eaaf79687ab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", "a", ",", " ", "4"}], "]"}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"seg", " ", "=", " ", 
        RowBox[{"InfraSegment", "[", 
         RowBox[{"a", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{"seg", ",", " ", 
            RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
            "a", ",", " ", "b"}], "}"}]}], "]"}], ",", "\n", "      ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", "seg", ",", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Cardinality\>\"", ",", " ", "\"\<Length\>\"", ",", 
            " ", "\"\<CountingMeasure\>\"", ",", 
            " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "]"}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b62d660a-82fd-4366-937e-1051ab40e843"],

