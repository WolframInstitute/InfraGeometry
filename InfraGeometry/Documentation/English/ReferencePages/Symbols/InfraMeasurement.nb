Cell[TextData[{
 "The symbol page of each region carries its counts on the other lattices and \
its continuum expansion. A profile, the list of a measure over the size, is \
read by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LogDifferenceQuotients"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/LogDifferenceQuotients", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0c188eb1-bdd7-4da2-8452-9e51306fba9b"],
 ". The quotients of the counting profile from ",
 StyleBox["r = 0", "TI"],
 " and of the Riemannian profile from ",
 StyleBox["r = 1", "TI"],
 " coincide on a lattice, and they are the curves of the technical \
introduction, section 4.5: on ",
 StyleBox["Z^d", "TI"],
 " they approach the dimension as ",
 StyleBox["d + d/(2r)", "TI"],
 ", from above, while the counting profile from ",
 StyleBox["r = 1", "TI"],
 " approaches it as ",
 StyleBox["d \[Minus] d/(2r)", "TI"],
 ", from below."
}], "Notes",ExpressionUUID->"fd4cc301-eb6f-4978-85e3-1f375f01d26a"],

Cell[TextData[{
 "A Euclidean head is inert: it holds its points and options and computes \
nothing on its own. ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd0320e0-aa5e-4e2f-9274-bf0021f8f9be"],
 " is what evaluates it, reading every property off the head's ",
 StyleBox["graph",
  FontWeight->"Bold"],
 " \[LongDash] an acyclic directed graph whose source-to-sink chains are \
exactly the head's members \[LongDash] by one forward and one backward sweep \
of a dynamic-programming count, never by enumeration. A circle's graph is a \
",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2bb1774-f167-4a76-a71f-cd77ff76d95c"],
 " of atoms of the unrolled band along a radial seam (necklaces where the cut \
band is disconnected or the seam has one side only; see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "14029eef-31ff-4588-a9c8-80cbfebdfc75"],
 "). Each is an acyclic DAG from a seam vertex ",
 StyleBox["x", "TI"],
 " to a copy ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"x", ",", " ", 
    RowBox[{"3", "/", "2"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f960c4b8-768d-414c-ab1f-520c5d78c7ec"],
 " of it, so a circle is a chain read as a closed walk, ",
 StyleBox["opened",
  FontWeight->"Bold"],
 " at ",
 StyleBox["x", "TI"],
 ". A circle's member is the chain with the copy dropped, a cyclic vertex \
list whose first vertex is not repeated. The closed arc has the same shape on \
the atom at its point."
}], "Notes",ExpressionUUID->"e01f2ee7-9d10-4f80-b1bd-8270dd7c003c"],

Cell["The properties:", "Notes",ExpressionUUID->"908cab52-1041-49b6-8f18-ec154d5ed74c"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "cd94b35c-5dd2-4890-ba4c-0b03604f9efa"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"0c3b182e-d1a2-4606-9ca0-4a91030bffa2"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"57838117-841a-4b7c-ba8a-cac1fbab7dc5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2564d36c-7256-4ae4-a1ee-dbcee448920a"], Cell[TextData[Cell[
    BoxData["\"\<Graph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f0ba8045-051e-4d53-90d9-040a7b7b605a"]], "TableText",ExpressionUUID->
     "c8df8593-e84c-4bd6-b01a-8bf324344ed4"], Cell[TextData[{
     "the object's own graph: one ",
     Cell[BoxData["Graph"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9b919226-f169-41db-bb54-88b9074889d9"],
     ", or a ",
     Cell[BoxData["List"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "23ec6c6a-2abf-4da0-9cdd-7155f5ed720b"],
     " of them for a family of alternatives (the DAGs of a line or a ray, the \
atoms of a circle) or for the pieces of a polyline"
    }], "TableText",ExpressionUUID->"ecfb959c-ba2b-4180-9a6d-ea19275e21f5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b474a09f-c14f-4a59-a554-b40baebda492"], Cell[TextData[Cell[
    BoxData["\"\<Cardinality\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "47b5b541-dc4c-489e-a17c-51d1feedb2d5"]], "TableText",ExpressionUUID->
     "a91af0dc-e1d8-4917-bd95-25634d45e644"], Cell[
    "the number of members", "TableText",ExpressionUUID->
     "7c9329b7-2454-4c3b-bca7-10273c493fd9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1ab4fa71-e0f0-4a08-943c-47bad77ea7ba"], Cell[TextData[Cell[
    BoxData["\"\<Length\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "aa1a004a-d664-4b17-ba50-dae3c428fac0"]], "TableText",ExpressionUUID->
     "21798f7d-9a9c-4db6-9705-c1bfce5a527b"], Cell[TextData[{
     "the common length of the members, or a ",
     Cell[BoxData["List"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "70aefb54-4416-4f5e-825d-136944f774c6"],
     " of lengths when they differ"
    }], "TableText",ExpressionUUID->"89c6bc8d-3c6a-4184-b920-f34a875d0817"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "bca772f1-24b2-44ce-92be-9011dcc0f6ca"], Cell[TextData[Cell[
    BoxData["\"\<VertexDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7d0bdc10-2093-4724-a369-2c9927f0e668"]], "TableText",ExpressionUUID->
     "8bcf1917-64dc-4bda-bd71-deb7382fb804"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"<|", 
       RowBox[{"v", " ", "->", " ", 
        RowBox[{"occ", 
         RowBox[{"(", "v", ")"}]}]}], "|>"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1d598b1b-624f-4e40-b206-2483033f5df7"],
     ", the number of members through ",
     StyleBox["v", "TI"],
     "; on a polyline, the sum of the piece densities"
    }], "TableText",ExpressionUUID->"ae3e9e01-e950-445e-8f8e-45c2c1730d49"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8e7dd4bf-8f90-4088-b10e-7f4b30e81cc3"], Cell[TextData[Cell[
    BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "28eea5de-9375-452c-aefc-5ed80135fc72"]], "TableText",ExpressionUUID->
     "33bb8604-a011-405f-bcc4-8918ac6ce239"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"v", " ", "\[DirectedEdge]", " ", "w"}], " ", "->", " ", 
        RowBox[{"occ", 
         RowBox[{"(", 
          RowBox[{"v", " ", "->", " ", "w"}], ")"}]}]}], "|>"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3d5dfce3-b8af-4c5f-b383-eb399aa8310b"],
     ", the number of members through the arrow; on a polyline, the sum of \
the piece densities"
    }], "TableText",ExpressionUUID->"d6f2dcfd-3cc1-4790-9f7b-e21c3ebe733f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "73781fa7-f3e4-4dcb-b7ac-2dccd548f12d"], Cell[TextData[Cell[
    BoxData["\"\<Subgraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f1ec1fd5-ed68-4f63-93f9-7652cfbd940d"]], "TableText",ExpressionUUID->
     "b8d1dab7-8fea-4144-be20-7d6d5063e35f"], Cell[TextData[{
     "the induced subgraph of the support, same as ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSubgraph"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSubgraph", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "5f2bbdea-6337-4398-809c-edd6c70302af"]
    }], "TableText",ExpressionUUID->"2d793c11-2d93-4c39-b4fb-5ea4597b58f9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b1f727eb-651c-451d-a2cc-f31da3c07006"], Cell[TextData[Cell[
    BoxData["\"\<Faithful\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c1a13974-e80a-485b-b072-b2e3cc9fbdae"]], "TableText",ExpressionUUID->
     "0254ec41-9246-473b-8c04-f1ea8ee80fcd"], Cell[TextData[{
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "fd2c7672-ef75-4777-b175-408c199639b0"],
     " on a segment, ray or line; ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Undetermined"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "a192e374-8573-4fbf-a01f-85634098643d"],
     " on a circle or an arc, whose graph is proved faithful only under a \
hypothesis this paclet does not certify, except that a circle whose cut band \
is connected but whose seam has one side only gives ",
     Cell[BoxData["False"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3db0f068-9cd8-4819-9c21-305b162203c6"]
    }], "TableText",ExpressionUUID->"961c7b50-1fff-4b8c-b198-d1a425b0a229"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e3ac4838-f1c7-48b0-80c0-5003fff0baa6"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0792d5e3-9e96-4405-a39c-4765c9b43016"]], "TableText",ExpressionUUID->
     "5b9bb0df-bffa-4c3a-88f6-33eae155f3d2"], Cell[
    "the number of vertices of the support", "TableText",ExpressionUUID->
     "e9b0d03e-b376-4173-9a47-a465fd324e54"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "773eaa39-09bf-4756-be82-c81ef781506e"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "bf7fb13f-7bf3-4e57-9717-0a9e75aaaa40"]], "TableText",ExpressionUUID->
     "d3ebd12d-80ed-49f9-b660-8679d58e3a1c"], Cell["\<\
the number of vertices of the support all of whose neighbours lie in the \
support\
\>", "TableText",ExpressionUUID->"935219ad-4682-4799-89aa-1ceb1e001c26"]}
  }]], "2ColumnTableMod",ExpressionUUID->"6f23e125-6bce-43c2-ac23-\
0cdefc2d2a1a"],

Cell[TextData[{
 "A region \[LongDash] a ball, shell, tube, cylinder or cone \[LongDash] has \
one member, its vertex set, and every vertex of the support has density 1. It \
has no ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72383212-da84-46ef-ae3e-815b0ad82200"],
 " and no ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f8f2457-eef4-40da-8e3c-6893a55f8a37"],
 ". A sphere is a family, searched rather than read off a graph; its ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22a340ae-d81a-4df7-946e-33f02b7a91fb"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0c0c18fe-1792-4160-8835-06fd2b01d47b"],
 "."
}], "Notes",ExpressionUUID->"27c07fe3-82b9-446a-b3fb-c186ece7804b"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8a356175-47ef-4a23-9889-44f0fb1a762f"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "12219df2-9777-40fb-9d24-5621b2c76830"],
 " are heads on heads: neither is a family of walks, so neither has a ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed5f3032-9ff4-418e-8fd1-5167889c8d75"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eaf79545-db0e-4610-9e14-ea88b55cf875"],
 ", ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f81631b1-43f9-4cba-bca3-0efc1827128e"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c55d76fd-f1b0-49a2-8061-bd7c27e9c3cc"],
 " or ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6762b80-1b71-4007-ba92-f124e56899bc"],
 ", and their ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9cd65629-2ba4-43dd-97b4-de404f5b5575"],
 " lists only the density, the subgraph and the two measures. The \
intersection's ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ccf4aa1-6ce2-49ad-91d6-6e9cfcb36bde"],
 " is the product of the two objects' densities on their common vertices, the \
union's the sum."
}], "Notes",ExpressionUUID->"99843163-9af0-4c7b-a8b1-a6b35bc08127"],

Cell[TextData[{
 "A density, an association of vertex masses, is an object too: its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a52c506f-e985-4c99-a7a5-70875e908d53"],
 " is itself. So a union or an intersection may take densities as parts, and \
their masses may be negative: the union of a density ",
 StyleBox["d", "TI"],
 " and its negative ",
 Cell[BoxData["-"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58be233c-35c8-4a88-af29-d6928cc00f1e"],
 StyleBox["d", "TI"],
 " is zero at every vertex of ",
 StyleBox["d", "TI"],
 "."
}], "Notes",ExpressionUUID->"949225cb-0e57-4fcd-91fd-52de257be821"],

Cell[TextData[{
 "A circle takes a radius ",
 Cell[BoxData["r"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4846b821-ad4c-4d78-9e70-44422e7b736b"],
 " or a band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "s"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68e5067b-35c3-474a-a595-972bc137123d"],
 ", a scalar ",
 Cell[BoxData["r"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c889f592-2ea4-40d4-9357-9f6cbb6ce43d"],
 " meaning ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "r"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9d9687e-7059-4abd-9a34-60eb016716fe"],
 ". The circle through a point is the closed arc ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c169a2e-7094-4e70-a93c-8522cbe52fca"],
 ", which widens the band of ",
 StyleBox["p", "TI"],
 " with ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"delta", " ", "|", " ", 
    RowBox[{"{", 
     RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74244e9c-fb22-44ee-a572-2d5d199472d5"],
 " (default ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61a033ff-1fe5-4cb5-a34b-a2b377d9d0cb"],
 "). A scalar ",
 StyleBox["delta", "TI"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8bd1975-d4dc-4747-938e-33e08f642c76"],
 ", outward only."
}], "Notes",ExpressionUUID->"3be04b66-2bcd-4f79-aa69-43ef2c8889a6"],

Cell[TextData[{
 "On a polyline ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5748675a-e3c2-431f-9227-502113580664"],
 " the densities are not member counts: they are the sums of the piece \
densities. On the 5 \[Times] 5 grid, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"1", ",", " ", "13", ",", " ", "25"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b808418-c608-4bb7-9474-9512f9bc6678"],
 " has 36 members, while its density at the centre 13 is 12."
}], "Notes",ExpressionUUID->"f0ba2125-3fff-4928-9fa2-f9dceac99822"]
}, Open  ]],

