       RowBox[{"InfraTube", "[", 
        RowBox[{"seg", ",", " ", "1"}], "]"}], ",", " ", 
       RowBox[{"InfraCylinder", "[", 
        RowBox[{"axis", ",", " ", "1"}], "]"}], ",", " ", 
       RowBox[{"InfraCone", "[", 
        RowBox[{"axis", ",", " ", "1"}], "]"}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"supports", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"FindInfraRepresentative", "[", 
        RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
