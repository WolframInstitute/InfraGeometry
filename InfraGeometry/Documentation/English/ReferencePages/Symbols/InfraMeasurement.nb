Cell[TextData[{
 "On the square grid and the hexagonal tiling the Riemannian measure of the \
ball of radius ",
 StyleBox["r", "TI"],
 " is the counting measure of the ball of radius ",
 StyleBox["r \[Minus] 1", "TI"],
 ", and their difference is 0. On the discretized plane it is not: a vertex \
at distance ",
 StyleBox["r", "TI"],
 " with no neighbour at distance ",
 StyleBox["r + 1", "TI"],
 " is inside the ball."
}], "ExampleText",ExpressionUUID->"7401e20b-8189-4735-9081-a539cf098586"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"names", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
        ",", " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"ListLinePlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"name", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], ",",
          "\n", "        ", 
         RowBox[{"{", 
          RowBox[{"c", " ", "=", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
         "        ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraBall", "[", 
               RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
              " ", "\"\<RiemannianMeasure\>\""}], "]"}], " ", "-", " ", 
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraBall", "[", 
               RowBox[{"c", ",", " ", 
                RowBox[{"r", " ", "-", " ", "1"}]}], "]"}], ",", 
              " ", "\"\<CountingMeasure\>\""}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"r", ",", " ", "1", ",", " ", "7"}], "}"}]}], "]"}]}], 
        "]"}], ",", "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", "names"}], "}"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"DataRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "7"}], "}"}]}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", "names"}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<r\>\"", ",", " ", "None"}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"0a4c54b6-072f-4334-b15f-4d0a114da279"],

