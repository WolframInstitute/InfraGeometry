Cell["\<\
The two measures of five regions about one centre and one shortest path on \
the square grid: a ball, a band of two radii, a tube, a cylinder and a cone. \
Each is drawn with its inner vertices in green and its boundary in blue; the \
counting measure counts both, the Riemannian measure the green ones.\
\>", "ExampleText",ExpressionUUID->"6deed8ef-27e3-42b6-b6f7-bb2dd100267e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", "seg"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"regions", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraBall", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"InfraTube", "[", 
        RowBox[{"seg", ",", " ", "1"}], "]"}], ",", " ", 
       RowBox[{"InfraCylinder", "[", 
        RowBox[{"axis", ",", " ", "1"}], "]"}], ",", " ", 
       RowBox[{"InfraCone", "[", 
        RowBox[{"axis", ",", " ", "1"}], "]"}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"supports", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"FindInfraRepresentative", "[", 
        RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
      "regions"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"InfraInterior", "[", 
              RowBox[{"g", ",", " ", "#"}], "]"}], " ", "->", " ", 
             "StandardGreen"}], ",", " ", 
            RowBox[{
             RowBox[{"InfraBoundary", "[", 
              RowBox[{"g", ",", " ", "#"}], "]"}], " ", "->", " ", 
             "StandardBlue"}]}], "}"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
       "supports"}], "]"}], ",", "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "regions", ",", " ", "\"\<CountingMeasure\>\""}],
       "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{
      "g", ",", " ", "regions", ",", " ", "\"\<RiemannianMeasure\>\""}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"42755af7-367e-4035-8fa5-5926ec710910"],

