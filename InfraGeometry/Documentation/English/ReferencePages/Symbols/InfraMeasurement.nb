Cell[TextData[{
 "The symbol page of each region carries its counts on the other lattices and \
its continuum expansion. A profile, the list of a measure over the size, is \
read by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LogDifferenceQuotients"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/LogDifferenceQuotients", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8b4b6728-957d-4a06-a4de-14379c0500dd"],
 ". The quotients of the counting profile from ",
 StyleBox["r = 0", "TI"],
 " and of the Riemannian profile from ",
 StyleBox["r = 1", "TI"],
 " coincide on a lattice, and they are the curves of the technical \
introduction, section 4.5: on ",
 StyleBox["Z^d", "TI"],
 " they approach the dimension as ",
 StyleBox["d + d/(2r)", "TI"],
 ", from above, while the counting profile from ",
 StyleBox["r = 1", "TI"],
 " approaches it as ",
 StyleBox["d \[Minus] d/(2r)", "TI"],
 ", from below."
}], "Notes",ExpressionUUID->"2ac553df-9703-46c5-bbd8-3932c23d497e"],

Cell[TextData[{
 "A Euclidean head is a ",
 StyleBox["symbolic abstract representation",
  FontWeight->"Bold"],
 " of an object: it holds its points and options, with ",
 StyleBox["evaluation postponed",
  FontWeight->"Bold"],
 " until a graph is supplied. ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4eb1731-e805-4516-a634-e61d986763b7"],
 " evaluates its properties on that graph, reading every property off the \
head's ",
 StyleBox["graph",
  FontWeight->"Bold"],
 " \[LongDash] an acyclic directed graph whose source-to-sink chains are \
exactly the head's members \[LongDash] by one forward and one backward sweep \
of a dynamic-programming count, never by enumeration. A circle's graph is a \
",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d7ed36c6-1284-473a-a63e-38d9616bec13"],
 " of atoms of the unrolled band along a radial seam (necklaces where the cut \
band is disconnected or the seam has one side only; see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "88af1ce5-21ed-41d3-82ec-80879259c8f5"],
 "). Each is an acyclic DAG from a seam vertex ",
 StyleBox["x", "TI"],
 " to a copy ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"x", ",", " ", 
    RowBox[{"3", "/", "2"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b32d3cfc-d92c-4da7-9fb7-83cebfa44f73"],
 " of it, so a circle is a chain read as a closed walk, ",
 StyleBox["opened",
  FontWeight->"Bold"],
 " at ",
 StyleBox["x", "TI"],
 ". A circle's member is the chain with the copy dropped, a cyclic vertex \
list whose first vertex is not repeated. The closed arc has the same shape on \
the atom at its point."
}], "Notes",ExpressionUUID->"18ad7316-c606-400b-b797-85d7e8e9957c"],

Cell["The properties:", "Notes",ExpressionUUID->"18de2209-7494-4de7-b825-e7a45f68d41e"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a7a9d8d8-cac8-4444-ac49-664e76e75102"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"b860a69d-315e-4c88-b155-8b0ad044507d"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"ca19c31d-c449-4cd3-814c-06c910e96709"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ef84d135-ede2-459b-8efb-180ec8b7f944"], Cell[TextData[Cell[
    BoxData["\"\<Graph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ad831d36-bc1d-4fe2-a78c-5e47c175f928"]], "TableText",ExpressionUUID->
     "83998ee6-b4fe-4603-ba26-7508f9dc4a80"], Cell[TextData[{
     "the object's own graph: one ",
     Cell[BoxData["Graph"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "86ca249d-c5d9-42d2-922c-f7fd6978c4a3"],
     ", or a ",
     Cell[BoxData["List"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f2e4ff1b-9e91-4ca6-8f7c-35349b6f4ba1"],
     " of them for a family of alternatives (the DAGs of a line or a ray, the \
atoms of a circle) or for the pieces of a polyline"
    }], "TableText",ExpressionUUID->"5987424e-cf7f-47e6-bc9d-5d39ef39e522"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ac3260b1-d649-4765-ac93-b7d96c8e5c5d"], Cell[TextData[Cell[
    BoxData["\"\<Cardinality\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "034fa1ee-240f-4e3a-bfe4-a1a5ecaf11e7"]], "TableText",ExpressionUUID->
     "d9e915d2-b426-40a7-87a3-fd65d44acc1e"], Cell[
    "the number of members", "TableText",ExpressionUUID->
     "4bacc139-5575-4296-a379-e019415d4de8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "cec42dae-69b2-42d9-ad2a-39f1d55b7691"], Cell[TextData[Cell[
    BoxData["\"\<Length\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "21150a87-e995-4efa-8064-ab681b030d25"]], "TableText",ExpressionUUID->
     "3563f4c2-52cb-4b48-995e-c08dfc393a49"], Cell[TextData[{
     "the common length of the members, or a ",
     Cell[BoxData["List"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1d84bf5d-206a-4a8d-92e9-24df2f83d5b7"],
     " of lengths when they differ"
    }], "TableText",ExpressionUUID->"3b07eeb7-6294-485e-a236-6d3ae79ce321"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "17372a35-10cb-4f9b-8f4f-57d262020790"], Cell[TextData[Cell[
    BoxData["\"\<VertexDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "07f55085-422f-417b-ba81-4b6c293a6b4c"]], "TableText",ExpressionUUID->
     "0c01509a-a75a-49a7-b9c1-f3489fc0e1c9"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"<|", 
       RowBox[{"v", " ", "->", " ", 
        RowBox[{"occ", 
         RowBox[{"(", "v", ")"}]}]}], "|>"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c62f8ba2-e6f6-4e69-8248-1cf2600f73d0"],
     ", the number of members through ",
     StyleBox["v", "TI"],
     "; on a polyline, the sum of the piece densities"
    }], "TableText",ExpressionUUID->"bcbf6dbc-8d1b-4948-a84c-f34f22c7170f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ef2a4d38-030c-4503-8553-7ba0ec33d1f2"], Cell[TextData[Cell[
    BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7150812d-a67a-4981-bf4c-ba27d9f7cb53"]], "TableText",ExpressionUUID->
     "57d8e98f-8026-4915-8783-5d069da7e79c"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"v", " ", "\[DirectedEdge]", " ", "w"}], " ", "->", " ", 
        RowBox[{"occ", 
         RowBox[{"(", 
          RowBox[{"v", " ", "->", " ", "w"}], ")"}]}]}], "|>"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "aa0f0dc7-3069-4316-93d8-0391d622573c"],
     ", the number of members through the arrow; on a polyline, the sum of \
the piece densities"
    }], "TableText",ExpressionUUID->"97644c08-05eb-4840-bc40-96273666227a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "293625f5-e3b3-4b68-8231-9c0acf7ed999"], Cell[TextData[Cell[
    BoxData["\"\<Subgraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "193a9272-028d-4e90-8229-4e9b204b9f2e"]], "TableText",ExpressionUUID->
     "8ef67a16-2187-4a5a-b5b9-daaf785c9bf7"], Cell[TextData[{
     "the induced subgraph of the support, same as ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSubgraph"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSubgraph", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "ebdbd412-ff8b-465b-848a-c85cb896b774"]
    }], "TableText",ExpressionUUID->"16104184-d944-43dc-9f7b-2e992b0b079b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "cae9746b-e676-42bd-a7a6-26442ccff474"], Cell[TextData[Cell[
    BoxData["\"\<Faithful\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "34cd5774-4fbb-4adb-b1f5-6f2b380107c9"]], "TableText",ExpressionUUID->
     "38204bd7-3b41-41e0-bbc0-adc950dc6e3f"], Cell[TextData[{
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8442cb6f-bc15-4272-a9d6-ad64eceef22b"],
     " on a segment, ray or line; ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Undetermined"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "6145b688-cef0-44f1-8347-29b323e0eb41"],
     " on a circle or an arc, whose graph is proved faithful only under a \
hypothesis this paclet does not certify, except that a circle whose cut band \
is connected but whose seam has one side only gives ",
     Cell[BoxData["False"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c1c132af-43ca-4130-a99f-52b521895b9e"]
    }], "TableText",ExpressionUUID->"59339509-1073-49aa-80aa-3be52ad7a704"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "be4ea18a-2477-4316-959f-46deba7df308"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "be7277fd-ebee-47cd-a501-011afa32e584"]], "TableText",ExpressionUUID->
     "52953cf5-c95b-4e15-a695-ce4ae7146f00"], Cell[
    "the number of vertices of the support", "TableText",ExpressionUUID->
     "f6dee739-aa78-40c0-84f4-12e1be9c5e40"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b72bcfac-d8f2-4cdb-994e-df245c3e0b48"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c2391a2e-7aed-442b-b6aa-d983b482cae1"]], "TableText",ExpressionUUID->
     "91693c77-30cb-43a3-aa1b-649ebe20fd17"], Cell["\<\
the number of vertices of the support all of whose neighbours lie in the \
support\
\>", "TableText",ExpressionUUID->"816847c4-9f51-4f3a-8088-766865d178bb"]}
  }]], "2ColumnTableMod",ExpressionUUID->"28193596-bdfd-4857-937e-\
83e2fa0b4a65"],

Cell[TextData[{
 "A region \[LongDash] a ball, shell, tube, cylinder or cone \[LongDash] has \
one member, its vertex set, and every vertex of the support has density 1. It \
has no ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20a255cf-8f91-40ba-9f49-42f89d1ffa9c"],
 " and no ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1496463f-6955-4ba8-b89b-d112608d6653"],
 ". A sphere is a family, searched rather than read off a graph; its ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5cf6022-8f60-48eb-bcd7-d9dae0fd25ac"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3045d58d-2758-48b5-933c-97865c80557d"],
 "."
}], "Notes",ExpressionUUID->"71997847-6832-4bc6-b075-6e778cc1c4cc"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3ec02992-8165-4bbc-9613-913a4aca18ae"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9e3a5978-9546-48fe-a040-255f859db7c2"],
 " are heads on heads: neither is a family of walks, so neither has a ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99f89bce-8e78-495e-bfd1-c6af3274e55d"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6085ab2-ac77-4c56-987b-ee1547397ef4"],
 ", ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08060632-9dfd-4ac3-b5db-e911e6a48237"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f44d55ec-0aca-43f4-bceb-ff4fdd5ec253"],
 " or ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aec2146c-12f7-423b-b923-a79e1766a166"],
 ", and their ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0164f04f-176b-481e-9f65-5de90cbf348e"],
 " lists only the density, the subgraph and the two measures. The \
intersection's ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a128dbef-45d7-4878-b9f0-1a59103fb4ff"],
 " is the product of the two objects' densities on their common vertices, the \
union's the sum."
}], "Notes",ExpressionUUID->"cc06e54d-575d-4330-875c-6709fa3ad5c4"],

Cell[TextData[{
 "A density, an association of vertex masses, is an object too: its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6165568e-5393-4524-8991-2888efba124f"],
 " is itself. So a union or an intersection may take densities as parts, and \
their masses may be negative: the union of a density ",
 StyleBox["d", "TI"],
 " and its negative ",
 Cell[BoxData["-"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1568073-18d5-4dc6-bed4-53b0c3a7cc25"],
 StyleBox["d", "TI"],
 " is zero at every vertex of ",
 StyleBox["d", "TI"],
 "."
}], "Notes",ExpressionUUID->"4bdb2990-5486-4870-ae0e-7e40dd230cd6"],

Cell[TextData[{
 "A circle takes a radius ",
 Cell[BoxData["r"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f525750d-7067-49ab-ae6b-4fa938754e2b"],
 " or a band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "s"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "463bbd42-fef2-4a26-ab9b-64429f746b2f"],
 ", a scalar ",
 Cell[BoxData["r"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7268876c-6594-4ec2-89b9-678f34434c3c"],
 " meaning ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "r"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fbd6636-b354-4126-9e74-f679f4187fb2"],
 ". The circle through a point is the closed arc ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ef2fb19-42df-4508-a7dd-b3fea54ad5e2"],
 ", which widens the band of ",
 StyleBox["p", "TI"],
 " with ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"delta", " ", "|", " ", 
    RowBox[{"{", 
     RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de5abf5d-9d36-44ad-a082-3853684fb8a4"],
 " (default ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9bd02d08-134a-45f8-9aff-721b597dc31c"],
 "). A scalar ",
 StyleBox["delta", "TI"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46b73b11-ec05-4438-a9eb-deeb8e5e2aef"],
 ", outward only."
}], "Notes",ExpressionUUID->"8f50d6c8-0496-45c9-b1bd-d86d9da145c9"],

Cell[TextData[{
 "On a polyline ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f1f4ff34-603f-4dfa-aea7-7565213cafc7"],
 " the densities are not member counts: they are the sums of the piece \
densities. On the 5 \[Times] 5 grid, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"1", ",", " ", "13", ",", " ", "25"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9ae7e19-16b4-45df-9cb4-a8b1274e0d60"],
 " has 36 members, while its density at the centre 13 is 12."
}], "Notes",ExpressionUUID->"7c04c56b-0e37-45da-90bb-578e8169a1bd"]
}, Open  ]],

