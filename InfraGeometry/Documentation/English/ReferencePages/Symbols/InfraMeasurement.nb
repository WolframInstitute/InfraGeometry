      FontSize->0.9 Inherited,ExpressionUUID->
      "72c25ebe-c132-4eec-9e07-a2a8bd7b3fcb"],
     " of them for a family of alternatives (the DAGs of a line or a ray, the \
atoms of a circle) or for the pieces of a polyline"
    }], "TableText",ExpressionUUID->"9060291f-1d67-41fc-8c5b-c71134d8a6ea"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "81a73b76-b65d-4b6c-a7f3-66e9b0b062d2"], Cell[TextData[Cell[
    BoxData["\"\<Cardinality\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5b3b0628-ddfd-4043-82fa-a48ee2999fca"]], "TableText",ExpressionUUID->
     "988bedb5-3b0e-439b-8656-150dd1ce6b23"], Cell[
    "the number of members", "TableText",ExpressionUUID->
     "fb77149b-9aa1-4b0f-ae81-3f4b96025a1b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "120412ae-153b-42ff-9339-52381e26d004"], Cell[TextData[Cell[
    BoxData["\"\<Length\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "123f68c2-1876-482e-8f6d-959667e3864d"]], "TableText",ExpressionUUID->
     "ae34b54f-2d10-4a45-b7ed-dc2e5d8478ad"], Cell[TextData[{
     "the common length of the members, or a ",
     Cell[BoxData["List"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4af2d87d-fbd8-42a8-822d-10cfcae7160d"],
     " of lengths when they differ"
    }], "TableText",ExpressionUUID->"07039e50-536a-42f5-b5b9-c5edf14a4655"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2178a432-41f2-4948-86f4-443ab1375eaa"], Cell[TextData[Cell[
    BoxData["\"\<VertexDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7618d2ac-f54d-4279-9af9-d1bdd73deec7"]], "TableText",ExpressionUUID->
     "69bd1c24-3656-473f-b813-a08028f56cca"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"<|", 
       RowBox[{"v", " ", "->", " ", 
        RowBox[{"occ", 
         RowBox[{"(", "v", ")"}]}]}], "|>"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "d9b71f9e-fa22-4045-93d2-e47187966fda"],
     ", the number of members through ",
     StyleBox["v", "TI"],
     "; on a polyline, the sum of the piece densities"
    }], "TableText",ExpressionUUID->"d1303c0f-8809-4390-9aeb-e1a7c3a48413"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1019946e-fe22-43ad-b225-add4aa1a2535"], Cell[TextData[Cell[
    BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "dc43d904-7ce0-4312-8609-01652b29a4f5"]], "TableText",ExpressionUUID->
     "55d502db-1a67-4b27-a4be-ebc394a69e52"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"v", " ", "\[DirectedEdge]", " ", "w"}], " ", "->", " ", 
        RowBox[{"occ", 
         RowBox[{"(", 
          RowBox[{"v", " ", "->", " ", "w"}], ")"}]}]}], "|>"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8683e6e0-f5ac-4651-bcdd-e9f617321e66"],
     ", the number of members through the arrow; on a polyline, the sum of \
the piece densities"
    }], "TableText",ExpressionUUID->"fb3fe43e-bfb8-4d31-9b75-a7b8a9fa949e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "73894b16-9524-43f3-8408-217f519d40d2"], Cell[TextData[Cell[
    BoxData["\"\<Subgraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "05009c09-d76e-41b3-9f15-c1d10deacd3c"]], "TableText",ExpressionUUID->
     "2275c5d4-e7dc-4cd2-9d76-2d34a62df025"], Cell[TextData[{
     "the induced subgraph of the support, same as ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSubgraph"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSubgraph", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "9aabbdf5-c8f3-4204-a320-39231ac7e3ae"]
    }], "TableText",ExpressionUUID->"fc98ff55-e517-4e5b-838b-10428b3adad4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f13cb114-fe27-428e-b996-c3bdc38e04ac"], Cell[TextData[Cell[
    BoxData["\"\<Faithful\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "909ad6ec-5617-4533-8b33-b412e44c18c5"]], "TableText",ExpressionUUID->
     "a6970723-1128-4589-bb28-ec65e5dc31b6"], Cell[TextData[{
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2b7a354d-0807-4f68-82b5-c81e8b7973c8"],
     " on a segment, ray or line; ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Undetermined"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "7d241e55-0c36-4535-bf7b-fb0b0980b5da"],
     " on a circle or an arc, whose graph is proved faithful only under a \
hypothesis this paclet does not certify, except that a circle whose cut band \
is connected but whose seam has one side only gives ",
     Cell[BoxData["False"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "59ee8236-5302-423e-ba5d-a18df8c69dc2"]
    }], "TableText",ExpressionUUID->"ea2df16d-b1cd-4137-8d26-314a6bc21097"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "977da8a9-e4ea-4ec2-bb63-52f8553eaef4"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0a994921-1ba5-475e-9e18-97d2c512e9e1"]], "TableText",ExpressionUUID->
     "e7acf5db-7bd1-42a8-ae46-c6154adbc5c9"], Cell[
    "the number of vertices of the support", "TableText",ExpressionUUID->
     "2300ee82-a6eb-4912-bb90-1c83cf6c211f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "03474a05-d899-41d5-a944-84bc811323f3"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7cbf8111-41e6-43d6-80ee-6ad0eaf3a495"]], "TableText",ExpressionUUID->
     "08224e11-c5f0-428f-b051-9dddc3aa7c66"], Cell["\<\
the number of vertices of the support all of whose neighbours lie in the \
support\
\>", "TableText",ExpressionUUID->"322f905f-2b41-41e6-9ac4-c531d2be4e3f"]}
  }]], "2ColumnTableMod",ExpressionUUID->"f5dd8e47-d401-4200-b336-\
dbd3bfc9f055"],

Cell[TextData[{
 "A region \[LongDash] a ball, shell, tube, cylinder or cone \[LongDash] has \
one member, its vertex set, and every vertex of the support has density 1. It \
has no ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c455b429-4aa9-4969-9ac3-1d32acb8bbe1"],
 " and no ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd34c3cf-408c-4cd0-824b-8b91aaa0b45b"],
 ". A sphere is a family, searched rather than read off a graph; its ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9378bdbd-6604-4ceb-a241-97657b56026d"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Undetermined"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Undetermined", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4ca8a58b-5b5e-4025-973a-e6548474335f"],
 "."
}], "Notes",ExpressionUUID->"670939e7-e668-4d5d-b89e-16ca82c2ab76"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9d51447c-8e43-45c7-a8df-dea882bf8c6d"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1fae79fe-9d8c-4985-bc3f-3e7c929990d0"],
 " are heads on heads: neither is a family of walks, so neither has a ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1715ac62-96ce-4db5-b28e-1e5f9886cc01"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39cbf13b-1e44-460b-ba1b-9fef9c30abee"],
 ", ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "267be3e3-8649-4212-9846-0691b81aeb99"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c4e65341-de50-4734-94ed-89846dc3ae87"],
 " or ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01a36707-737d-4d69-b0b0-ff64ce4c9a5b"],
 ", and their ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b463b8b-e355-44af-9ff7-13c798386007"],
 " lists only the density, the subgraph and the two measures. The \
intersection's ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e19f405-1144-4504-9f70-751417e9bef9"],
 " is the product of the two objects' densities on their common vertices, the \
union's the sum."
}], "Notes",ExpressionUUID->"2e88a5ee-a0d3-4ee5-bd1d-2a8cbfab345d"],

Cell[TextData[{
 "A circle takes a radius ",
 Cell[BoxData["r"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9d124fe-95eb-4f33-a8ab-80b2aff88d7a"],
 " or a band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "s"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fcc18da-139b-463d-866b-37322b165c97"],
 ", a scalar ",
 Cell[BoxData["r"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7da2afa-21fe-426a-92c0-7c8db09e721e"],
 " meaning ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "r"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f5d74e4-54b8-4a7c-85b1-adf57662ed66"],
 ". The circle through a point is the closed arc ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44d202a1-9927-444b-998b-4ff6892c1d89"],
 ", which widens the band of ",
 StyleBox["p", "TI"],
 " with ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"delta", " ", "|", " ", 
    RowBox[{"{", 
     RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5de8f40-6012-4f18-8e16-bc423042191a"],
 " (default ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb805ab5-0990-4630-a0bb-6997ed1cee48"],
 "). A scalar ",
 StyleBox["delta", "TI"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ca5ae0f-6c0d-4a40-964e-c45aec8b22fa"],
 ", outward only."
}], "Notes",ExpressionUUID->"c37ff658-8705-4487-8879-9eef10b200b8"],

Cell[TextData[{
 "On a polyline ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6799eb54-8fc5-4867-bfd1-7eefa9767229"],
 " the densities are not member counts: they are the sums of the piece \
densities. On the 5 \[Times] 5 grid, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"1", ",", " ", "13", ",", " ", "25"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "980332ec-918f-4c1e-ab10-d556efb3c3b1"],
 " has 36 members, while its density at the centre 13 is 12."
}], "Notes",ExpressionUUID->"cbc079e1-3ab6-4c28-ac4e-ebf6c27fafcc"]
}, Open  ]],

