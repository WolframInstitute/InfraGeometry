              RowBox[{"g", ",", " ", "#"}], "]"}], " ", "->", " ", 
             "$InfraCircleColor"}]}], "}"}]}], "]"}], " ", "&"}], " ", "/@", 
       " ", "supports"}], "]"}], ",", "\n", "   ", 
