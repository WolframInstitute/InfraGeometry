Cell[TextData[{
 "The support of every object \[LongDash] what ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1c5a04a-fc1a-4777-8020-254e47c2b832"],
 " and the four volumes read \[LongDash] is ",
 Cell[BoxData[
  RowBox[{"Keys", " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"graph", ",", " ", "obj", ",", " ", "\"\<VertexDensity\>\""}], 
    "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e5a93f2-607a-48be-b01a-ed6fab57ef8a"],
 "."
}], "Notes",ExpressionUUID->"0ebce59f-9c0c-4f0a-ae23-1bf4ae6aaf8d"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3c2a5137-0489-45e8-a8f3-8a486fe5405e"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "607aaff7-b450-4822-b888-59a12da23edf"],
 " are heads on heads: neither is a family of walks, so neither has a ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b59a7604-7750-421d-a1d5-aebaeadc9b0b"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8cc00d3b-c7a0-4222-9953-927edb3c35e3"],
 ", ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35b11b33-ca6f-474e-ad01-60c4a67cf230"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2930e9b-adb6-4d2d-8b6e-be584351b1d4"],
 " or ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "879af466-2173-454e-a972-306617ddf02b"],
 ", and their ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6757ca90-98b5-4647-b180-c08a9042d815"],
 " lists only the density, the subgraph and the four volumes. The \
intersection's ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dedc878-2129-46e3-80a9-146f646cb12e"],
 " is the product of the two objects' densities on their common vertices, the \
union's the sum."
}], "Notes",ExpressionUUID->"d7e1908f-a7ac-4ef2-ba73-6fc86c7be2de"],

Cell[TextData[{
 "A circle or a circle band takes ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
   RowBox[{"r", " ", "|", " ", 
    RowBox[{"{", 
     RowBox[{"r", ",", " ", "s"}], "}"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98212d29-cd21-4230-a412-e832481a827e"],
 " in place of a point, or widens the circle through a point with ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"delta", " ", "|", " ", 
    RowBox[{"{", 
     RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ccd3dea5-8331-49d7-8905-577f5aba2414"],
 " (default ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8c64152-b143-4e5d-8676-e2fb524583e3"],
 "). A scalar ",
 StyleBox["delta", "TI"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "275c4412-8a35-4f90-a748-54ca70f17ef3"],
 ", outward only."
}], "Notes",ExpressionUUID->"0f89b632-a934-4cc7-a1d6-68ee9675d148"],

Cell[TextData[{
 "On a polyline ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29574c29-80be-45e3-b435-31a6c7bc1985"],
 " the densities are not member counts: they are the sums of the piece \
densities. On the 5 \[Times] 5 grid, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"1", ",", " ", "13", ",", " ", "25"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f1b6b4b-a6e8-415d-98f5-30b8f334cc70"],
 " has 36 members, while its density at the centre 13 is 12."
}], "Notes",ExpressionUUID->"0cb10b54-20c2-40e3-a616-0114245d961a"]
}, Open  ]],

