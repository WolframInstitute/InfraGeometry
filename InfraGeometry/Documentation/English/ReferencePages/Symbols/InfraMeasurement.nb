     "9eaeac5a-e2eb-4dc5-96bb-213dd7f81a1a"]], "TableText",ExpressionUUID->
     "dc258358-30bd-427a-92f1-8b797623613e"], Cell[TextData[{
     "the object's own graph: one ",
     Cell[BoxData["Graph"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "64c16ddb-a937-47ba-878a-b55a90d21169"],
     ", or a ",
     Cell[BoxData["List"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3a22b8df-1e3c-434f-94b1-d0c16c324c68"],
     " of them for a family of alternatives (the DAGs of a line or a ray, the \
atoms of a circle) or for the pieces of a polyline"
    }], "TableText",ExpressionUUID->"42587fb7-c563-4579-9796-ba718fc269bd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fbc9316e-f8e3-4901-82ed-459317910b0b"], Cell[TextData[Cell[
    BoxData["\"\<Cardinality\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
