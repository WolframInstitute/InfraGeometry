Cell[TextData[{
 "A vertex, a vertex list, an association of masses and a walk graph also \
have a ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33cccffe-e990-4620-9288-1a3995f5b18b"],
 ". A list of vertex lists or walk graphs has the sum of their densities."
}], "Notes",ExpressionUUID->"a310abdf-631e-48d5-a6e6-48f9ef80c10e"]
}, Open  ]],

