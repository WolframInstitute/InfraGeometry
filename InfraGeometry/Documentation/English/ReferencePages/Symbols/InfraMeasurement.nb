Cell["\<\
The two measures are the sizes of the support and of its interior:\
\>", "ExampleText",ExpressionUUID->"0a12721b-f09d-43ad-92ca-487253924d5d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"InfraBall", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "3"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"support", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "ball", ",", " ", "\"\<VertexDensity\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Length", " ", "@", " ", "support"}], ",", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"InfraInterior", "[", 
        RowBox[{"g", ",", " ", "support"}], "]"}]}]}], "}"}], " ", "==", "\n",
     "    ", 
    RowBox[{"Values", " ", "@", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "ball", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<CountingMeasure\>\"", ",", 
         " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"2fbbd4ad-1159-481a-9a3a-3305f85ddafc"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"697bba03-15d3-49ee-9184-51484d9bf37a"]
}, Open  ]]
