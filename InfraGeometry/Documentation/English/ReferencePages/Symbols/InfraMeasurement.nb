Cell[TextData[{
 "The support of every object \[LongDash] what ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3ab2c3f-4262-4e6d-b151-17e6c288b20a"],
 " and the four volumes read \[LongDash] is ",
 Cell[BoxData[
  RowBox[{"Keys", " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"graph", ",", " ", "obj", ",", " ", "\"\<VertexDensity\>\""}], 
    "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f69d5cc-8383-4500-9bab-aadcd74b2353"],
 "."
}], "Notes",ExpressionUUID->"fbe5c89e-4376-488c-9abd-15b89840b5d2"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "481de224-90fe-4a8b-8cfc-ca528f9e2395"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5535bd7b-967a-4e21-89a2-7e2f296aec03"],
 " are heads on heads: neither is a family of walks, so neither has a ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54a8358b-774a-422d-9a9f-9828d325d9c4"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62d02c0e-bf11-4d51-b4d9-a379462c5070"],
 ", ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a3cf48f-9c51-482c-ae05-6bfe11094abc"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e580db87-6f22-4c8a-9796-748660705d26"],
 " or ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e9043d1-0f10-4411-9d05-61af11ecd6ee"],
 ", and their ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3414c87-b6f7-4755-b693-ef656f2f2036"],
 " lists only the density, the subgraph and the four volumes. The \
intersection's ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39cfa807-11f3-4608-bf2f-dc08a98ec37b"],
 " is the product of the two objects' densities on their common vertices, the \
union's the sum."
}], "Notes",ExpressionUUID->"a532f4ba-6af9-48e7-9838-9640f96c3568"],

Cell[TextData[{
 "A circle takes a radius ",
 Cell[BoxData["r"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "992d8aef-e328-415b-8a05-9ddfdcd78440"],
 " or a band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "s"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6d98fa5-6796-4180-a74c-b436090358cf"],
 ", a scalar ",
 Cell[BoxData["r"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2df61211-6888-46a8-8ec9-0909b5c6331b"],
 " meaning ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "r"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1df6209-3f3a-4032-b432-fc8719945899"],
 ". The circle through a point is the closed arc ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b72290c-1d88-4156-a9f1-6c8b3a3194d6"],
 ", which widens the band of ",
 StyleBox["p", "TI"],
 " with ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"delta", " ", "|", " ", 
    RowBox[{"{", 
     RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2cc062c-f1cf-401a-94b9-400cb00c1921"],
 " (default ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cbc9eb2f-b014-4485-94d2-5b8966be1550"],
 "). A scalar ",
 StyleBox["delta", "TI"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4cf7e524-66e8-4e4b-b348-33a59c3e7558"],
 ", outward only."
}], "Notes",ExpressionUUID->"3d27e4a4-29b3-4cdd-baa0-309abb431533"],

Cell[TextData[{
 "On a polyline ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "451f2b69-8599-467c-97f3-3ca1c945d97e"],
 " the densities are not member counts: they are the sums of the piece \
densities. On the 5 \[Times] 5 grid, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"1", ",", " ", "13", ",", " ", "25"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d399b03-3b2d-4053-b3d7-aaa35914f0a2"],
 " has 36 members, while its density at the centre 13 is 12."
}], "Notes",ExpressionUUID->"fcaac4c9-c4da-4678-9fa6-8e33c8ce4bad"]
}, Open  ]],

