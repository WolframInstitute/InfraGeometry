Cell["\<\
The graph of the same segment: its source-to-sink chains are the shortest \
paths.\
\>", "ExampleText",ExpressionUUID->"5a2548f7-7124-4dae-afda-520bdca18ec3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
