Cell[TextData[{
 "Definition: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", 
    StyleBox["property", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bee63bd8-526e-414c-bf08-544ffc99e962"],
 " is the value of ",
 StyleBox["property", "TI"],
 " of the object ",
 StyleBox["obj", "TI"],
 " on ",
 StyleBox["graph", "TI"],
 ". The support of ",
 StyleBox["obj", "TI"],
 " is the set ",
 StyleBox["A", "TI"],
 " of vertices its members pass through, ",
 Cell[BoxData[
  RowBox[{"Keys", " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"graph", ",", " ", "obj", ",", " ", "\"\<VertexDensity\>\""}], 
    "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0d273e5-11b7-46ee-a0c2-958af0edd275"],
 ". The two measures of ",
 StyleBox["obj", "TI"],
 " are measures of ",
 StyleBox["A", "TI"],
 ":"
}], "Notes",ExpressionUUID->"9718a55a-600e-4f66-9968-d3583173e30d"],

