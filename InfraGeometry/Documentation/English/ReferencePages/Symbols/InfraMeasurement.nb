Cell["\<\
The profiles of the regions about the centre of the square grid, under the \
counting measure on the left and the Riemannian measure on the right: the \
ball and the shell over the radius, the fat and the thin tube about a segment \
of length 5 over the thickness.\
\>", "ExampleText",ExpressionUUID->"7f65a959-10cd-452a-92fc-0449893d6fa9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fat", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", "5"}], "]"}]}], "]"}]}], ")"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"geodesic", " ", "=", " ", 
     RowBox[{"RandomInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", "fat"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"{", "\n", "      ", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"InfraBall", "[", 
               RowBox[{"c", ",", " ", "r"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], ",",
             " ", "measure"}], "]"}], ",", "\n", "      ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"InfraShell", "[", 
               RowBox[{"c", ",", " ", "r"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], ",",
             " ", "measure"}], "]"}], ",", "\n", "      ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"InfraTube", "[", 
               RowBox[{"fat", ",", " ", "s"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"s", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], ",",
             " ", "measure"}], "]"}], ",", "\n", "      ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
