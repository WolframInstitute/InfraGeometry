Cell["\<\
A segment from the centre to a vertex four steps away on the discretized \
plane, the square grid and the hexagonal tiling, drawn by its densities, \
beside its number of shortest paths, their length and its two measures.\
\>", "ExampleText",ExpressionUUID->"c51bf958-d9f1-4dc5-b3ab-43df4fd287d2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"FindInfraPoint", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraShell", "[", 
             RowBox[{"a", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"seg", " ", "=", " ", 
        RowBox[{"InfraSegment", "[", 
         RowBox[{"a", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{"seg", ",", " ", "a", ",", " ", "b"}], "}"}]}], "]"}], ",",
         "\n", "      ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", "seg", ",", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Cardinality\>\"", ",", " ", "\"\<Length\>\"", ",", 
            " ", "\"\<CountingMeasure\>\"", ",", 
            " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "]"}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7bd01742-8258-40c1-882a-4804be734c05"],

