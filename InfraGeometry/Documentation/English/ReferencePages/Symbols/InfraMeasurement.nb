Cell["A list of heads is measured head by head.", "ExampleText",ExpressionUUID->"d7750a14-5895-47cd-adfb-4cbf920e6214"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "4"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"heads", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraSegment", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"a", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "}"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", "heads"}], "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "heads", ",", " ", "\"\<Cardinality\>\""}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d235cb49-8b22-42c1-a5fb-3b717d565035"],

