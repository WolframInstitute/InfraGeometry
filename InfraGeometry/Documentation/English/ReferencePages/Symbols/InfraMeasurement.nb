     ExpressionUUID->"ad261567-34bf-482a-afe2-007b4bd411f5"], Cell[TextData[{
     "the count at ",
     StyleBox["s \[Minus] 1", "TI"],
     ", for ",
     StyleBox["s \[GreaterEqual] 1", "TI"]
    }], "TableText",ExpressionUUID->"d8aea99d-f93c-42d5-93a6-0ea12d51dce7"]}
  }]], "3ColumnTableMod",ExpressionUUID->"94bcc09e-71e6-417b-9c8e-\
9785e91bdf91"],

Cell[TextData[{
 "A vertex, an association of masses and a walk graph also have a ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a426558-8b10-44b4-8c03-c4c990ea57ab"],
 ", and so do the tokens ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "51f6c843-807d-46a0-9992-61423a15b60e"],
 ", its number of visits to each vertex, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "130d6bea-4df4-43e5-9706-918eaeaf1e4b"],
 ", 1 on the vertices it can be. A list of vertex lists or walk graphs has \
the sum of their densities."
}], "Notes",ExpressionUUID->"cb1a48ce-9261-4c92-874a-c3a3fea09686"],

Cell[TextData[{
 "A list of vertices is one vertex set for every property: its density counts \
repeated vertices, and its ",
 Cell[BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c054335-f210-4282-a1cf-f9440e37e853"],
 ", ",
 Cell[BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "efe4ef11-85b0-4f84-bd1b-e4fb6024b4e4"],
 " and ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "735677c5-9802-4794-aa01-7edd3d7a9150"],
 " are those of the set. Any other list is measured object by object."
}], "Notes",ExpressionUUID->"17e9ecef-74a5-4da3-91ea-61cbf2c93384"],

Cell[TextData[{
 "The members of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9db22de-2463-424c-8fe7-7f9b01254d68"],
 " are listed to read its ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "caf656ad-b1a1-4bad-9191-fd06addb4cb7"],
 ", ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f457e248-e490-4eb8-9645-271bed3b953e"],
 " and densities; its ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2db5d382-ae54-412d-be75-6b02b8f62bde"],
 " is a window graph, not a graph of the members."
}], "Notes",ExpressionUUID->"d26c727c-cdba-4bd8-9bbc-7131a90f0149"]
}, Open  ]],

