Cell[TextData[{
 "The vertex label is carried verbatim, including a list label such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "j"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1479f46b-70a8-4255-a39e-48fbca5e220b"],
 " on a grid or tessellation."
}], "Notes",ExpressionUUID->"efa1204f-19a5-4b48-8ef4-13c64b665cf3"],

Cell[TextData[{
 "Invariants are functions of the graph and a vertex, not accessors: ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"InfraBall", "[", 
     RowBox[{"v", ",", " ", "r"}], "]"}], ",", 
    " ", "\"\<CountingMeasure\>\""}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d75464e-31c4-4842-9f23-db9b6e9a05f7"],
 " gives the bare number for one vertex, and the list of regions one number \
per vertex."
}], "Notes",ExpressionUUID->"aa3acf8d-1c10-4d53-a475-5dbc76cd1774"]
}, Open  ]],

