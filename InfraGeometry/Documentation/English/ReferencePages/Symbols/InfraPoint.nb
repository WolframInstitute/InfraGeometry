Cell["A point finder returns vertices \[LongDash] one, or a list.", \
"ExampleText",ExpressionUUID->"ec141250-cad1-4fbb-98a9-4d16fbb53c7c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FindInfraPoint", "[", 
      RowBox[{"g", ",", " ", "All", ",", " ", 
       RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], "]"}], ",",
      " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraPoint", "[", 
       RowBox[{"g", ",", " ", "3"}], "]"}]}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"17df80ca-acd4-4e1f-99ac-b28a1e5b7c65"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", "3"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"56859353-80be-4796-b23f-8daefdf6acd6"]
}, Open  ]],

Cell["\<\
A vertex answers invariants with bare numbers; a list of regions answers with \
one number each.\
\>", "ExampleText",ExpressionUUID->"aff7ad5f-df19-4f86-8c4d-10dd15984491"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", 
       " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"GraphPeriphery", "[", "g", "]"}]}], ",", " ", "3"}], 
          "]"}]}], "}"}], ",", " ", "\"\<CountingMeasure\>\""}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"9136f038-248c-4f48-937a-23382729c796"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"25", ",", 
   RowBox[{"{", 
    RowBox[{"25", ",", "14"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"17243f1c-0bf7-4e86-932b-71495011191d"]
}, Open  ]],

Cell[TextData[{
 "In a scene the token is solved on the graph. Here ",
 StyleBox["a", "TI"],
 " is the centre of a 5 \[Times] 5 grid, ",
 StyleBox["b", "TI"],
 " any of the 8 vertices at distance 3 from it, and ",
 StyleBox["c", "TI"],
 " any of the 4 corners: 32 instances."
}], "ExampleText",ExpressionUUID->"424f0ea6-f09d-4aaa-843e-d6996f4c813e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], ",", "\n", "  ", 
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"scene", " ", "=", " ", 
       RowBox[{"InfraScene", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], ",", "\n", 
         "       ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraStep", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"a", " ", "==", " ", 
               RowBox[{"InfraPoint", "[", "\"\<Center\>\"", "]"}]}], "}"}], ",",
              " ", "\"\<a\>\""}], "]"}], ",", "\n", "        ", 
           RowBox[{"InfraStep", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"b", " ", "==", " ", 
               RowBox[{"InfraPoint", "[", 
                RowBox[{"a", ",", " ", "3"}], "]"}]}], "}"}], ",", 
             " ", "\"\<b\>\""}], "]"}], ",", "\n", "        ", 
           RowBox[{"InfraStep", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"c", " ", "==", " ", 
               RowBox[{"InfraPoint", "[", "\"\<Periphery\>\"", "]"}]}], "}"}],
              ",", " ", "\"\<c\>\""}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"instances", " ", "=", " ", 
       RowBox[{"FindInfraScene", "[", 
        RowBox[{"scene", ",", " ", 
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Length", "[", "instances", "]"}], ",", " ", 
       RowBox[{"InfraSceneInstance", "[", 
        RowBox[{
         RowBox[{"First", "[", "instances", "]"}], ",", " ", "a"}], "]"}], ",",
        " ", 
       RowBox[{"InfraSceneInstance", "[", 
        RowBox[{
         RowBox[{"First", "[", "instances", "]"}], ",", " ", "b"}], "]"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"d5644b01-d814-47e6-b66c-87237a6e7dc4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"32", ",", "13", ",", "2"}], "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"f7d34dca-e40b-44b3-b36a-50c8ae37e29e"]
}, Open  ]]
}, Open  ]],

