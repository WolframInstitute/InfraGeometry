Cell[TextData[{
 "The vertex label is carried verbatim, including a list label such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "j"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88cdabe8-4fcd-417c-a21d-c12cff335500"],
 " on a grid or tessellation."
}], "Notes",ExpressionUUID->"51e372e0-b043-4c91-af92-fb54809c3257"],

Cell[TextData[{
 "Invariants are functions of the graph and a vertex, not accessors: ",
 Cell[BoxData[
  RowBox[{"BallVolumes", "[", 
   RowBox[{"g", ",", " ", "v", ",", " ", 
    RowBox[{"{", 
     RowBox[{"rmin", ",", " ", "rmax"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66ffe0d4-b25f-469f-b88e-52d051800b43"],
 " gives the bare numbers for one vertex, and one row per vertex for a vertex \
list."
}], "Notes",ExpressionUUID->"b476141e-a050-4797-92fa-7a0b2f88bd1b"]
}, Open  ]],

