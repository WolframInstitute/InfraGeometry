Cell["A point finder returns vertices \[LongDash] one, or a list.", \
"ExampleText",ExpressionUUID->"59305f99-3384-4728-887c-236c5dffd44b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FindInfraPoint", "[", 
      RowBox[{"g", ",", " ", "All", ",", " ", 
       RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], "]"}], ",",
      " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraPoint", "[", 
       RowBox[{"g", ",", " ", "3"}], "]"}]}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b7b68aea-4f25-41ef-8f45-a01c7336dc7e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", "3"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"86937f24-5b20-4ca0-acfc-3dfca1b29507"]
}, Open  ]],

Cell["\<\
A vertex answers invariants with bare numbers; a list of vertices answers \
with one row each.\
\>", "ExampleText",ExpressionUUID->"111746ba-5006-4dde-9119-a7fb6e70c466"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"BallVolumes", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"BallVolumes", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphPeriphery", "[", "g", "]"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "3"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"cdebb2b5-a91b-4ce0-ac81-d4691f1495d4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "5", ",", "13", ",", "25"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "5", ",", "13", ",", "25"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3", ",", "8", ",", "14"}], "}"}]}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"00be865b-b574-4723-8d34-92475edd745d"]
}, Open  ]],

Cell[TextData[{
 "In a scene the token is solved on the graph. Here ",
 StyleBox["a", "TI"],
 " is the centre of a 5 \[Times] 5 grid, ",
 StyleBox["b", "TI"],
 " any of the 8 vertices at distance 3 from it, and ",
 StyleBox["c", "TI"],
 " any of the 4 corners: 32 instances."
}], "ExampleText",ExpressionUUID->"38518b0a-56a3-44a0-9f30-9fb8cb951376"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], ",", "\n", "  ", 
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"scene", " ", "=", " ", 
       RowBox[{"InfraScene", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], ",", "\n", 
         "       ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraStep", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"a", " ", "==", " ", 
               RowBox[{"InfraPoint", "[", "\"\<Center\>\"", "]"}]}], "}"}], ",",
              " ", "\"\<a\>\""}], "]"}], ",", "\n", "        ", 
           RowBox[{"InfraStep", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"b", " ", "==", " ", 
               RowBox[{"InfraPoint", "[", 
                RowBox[{"a", ",", " ", "3"}], "]"}]}], "}"}], ",", 
             " ", "\"\<b\>\""}], "]"}], ",", "\n", "        ", 
           RowBox[{"InfraStep", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"c", " ", "==", " ", 
               RowBox[{"InfraPoint", "[", "\"\<Periphery\>\"", "]"}]}], "}"}],
              ",", " ", "\"\<c\>\""}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"instances", " ", "=", " ", 
       RowBox[{"FindInfraScene", "[", 
        RowBox[{"scene", ",", " ", 
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Length", "[", "instances", "]"}], ",", " ", 
       RowBox[{"InfraSceneInstance", "[", 
        RowBox[{
         RowBox[{"First", "[", "instances", "]"}], ",", " ", "a"}], "]"}], ",",
        " ", 
       RowBox[{"InfraSceneInstance", "[", 
        RowBox[{
         RowBox[{"First", "[", "instances", "]"}], ",", " ", "b"}], "]"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"d9f8b23e-ecb7-4c1b-b186-97a1e71571ae"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"32", ",", "13", ",", "2"}], "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"1d2a5129-40df-46bb-a85d-6ee3e49ed1ef"]
}, Open  ]]
}, Open  ]],

