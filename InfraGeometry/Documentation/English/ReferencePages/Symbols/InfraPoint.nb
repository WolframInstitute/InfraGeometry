Cell["\<\
A point is a vertex, and several candidate points are a vertex list. The \
centre of a grid and three random points at distance 4 from it.\
\>", "ExampleText",ExpressionUUID->"e2d0669c-a5f6-4262-8baf-b1bd4df61e55"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"centre", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"picks", " ", "=", " ", 
     RowBox[{"FindInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"centre", ",", " ", "4"}], "]"}], ",", " ", "3"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"centre", ",", " ", "picks"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}]}], "]"}]}], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"a486288d-489d-49cd-ae48-416879c1d5e8"],

