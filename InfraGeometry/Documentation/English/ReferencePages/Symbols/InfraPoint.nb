Cell["\<\
A point is a vertex, and several candidate points are a vertex list. The \
centre of a grid and three random points at distance 4 from it.\
\>", "ExampleText",ExpressionUUID->"6d464e88-9726-4d45-9f05-2981ff226648"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"centre", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"picks", " ", "=", " ", 
     RowBox[{"FindInfraPoint", "[", 
      RowBox[{"g", ",", " ", "3", ",", " ", 
       RowBox[{"\"\<From\>\"", " ", "->", " ", 
        RowBox[{"centre", " ", "->", " ", "4"}]}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraHighlightGraph", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"centre", ",", " ", "picks"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}]}], "]"}]}], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"6d182224-adfb-4d46-a1e8-649335225a6c"],

