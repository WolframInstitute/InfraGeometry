     " \[LongDash] a plain list"
    }], "TableText",ExpressionUUID->"8763d881-8b55-4b2e-8cff-25f613d7c632"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7d81699c-3d3e-4d06-a1fa-1627432dc794"], Cell[
    "a measure on vertices", "TableText",ExpressionUUID->
