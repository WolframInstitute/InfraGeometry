Cell["\<\
Definition: an infra-point is one vertex of the substrate, carried by its \
label verbatim.\
\>", "Notes",ExpressionUUID->"d56f1b6d-0920-4c25-bbe7-51f81d8737c5"],

Cell[TextData[{
 "A point is a vertex. The head is a token of the scene language, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fdd5da48-93d5-4d38-8a8a-b4d097f63a58"],
 " without the graph, and holds no value of its own. A construction on a \
graph rarely has one answer, but the multiplicity does not live in this head: \
a family of candidate points is a vertex ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "556f5040-1419-4081-bafa-a5137d25c5ad"],
 ", and a measure on vertices is a density ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", "m"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2deb7861-8f16-47f6-885a-a0d9861dd10e"],
 "."
}], "Notes",ExpressionUUID->"0946cb26-78d4-4675-9b44-9f438b2425a3"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "51f08ce3-8d51-466f-a6a5-46c69e898ee1"], Cell["you have", "TableText",
