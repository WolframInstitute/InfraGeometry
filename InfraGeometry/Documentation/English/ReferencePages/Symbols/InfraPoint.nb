Cell["\<\
Definition: an infra-point is one vertex of the substrate, carried by its \
label verbatim.\
\>", "Notes",ExpressionUUID->"a82ea887-358e-4f0e-83d6-cb2496f36591"],

Cell[TextData[{
 "A point is a vertex. The head is a token of the scene language, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e6fdb782-d073-4bc1-b840-ef791cd8e557"],
 " without the graph, and holds no value of its own. A construction on a \
graph rarely has one answer, but the multiplicity does not live in this head: \
a family of candidate points is a vertex ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "169262fb-8a09-4b0a-8546-8c644b2b8f77"],
 ", and a measure on vertices is a density ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", "m"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b51e586-b718-4464-9450-52debf480044"],
 "."
}], "Notes",ExpressionUUID->"7ec9107d-6d89-4ea7-9e18-ef4bdef09710"],

