Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"GraphCenter", "[", "g", "]"}], ",", " ", "All"}], "]"}], ",", 
     " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"RandomInfraPoint", "[", 
       RowBox[{"g", ",", " ", "3"}], "]"}]}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e5bd5feb-2a2c-474a-92ae-14876ec2e5fe"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", "3"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"e28206f8-8967-4c50-9afb-b33c535aafc2"]
}, Open  ]],

Cell["\<\
A vertex answers invariants with bare numbers; a list of regions answers with \
one number each.\
\>", "ExampleText",ExpressionUUID->"a4f967de-80cc-42d0-be99-601aef9dade6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", 
       " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"GraphPeriphery", "[", "g", "]"}]}], ",", " ", "3"}], 
          "]"}]}], "}"}], ",", " ", "\"\<CountingMeasure\>\""}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"90099a62-98cf-44ba-8b27-ab0736818f9a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"25", ",", 
   RowBox[{"{", 
    RowBox[{"25", ",", "14"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"84281319-c080-4f71-9373-4371ba9e653c"]
}, Open  ]],

Cell[TextData[{
 "In a scene the token is solved on the graph. Here ",
 StyleBox["a", "TI"],
 " is the centre of a 5 \[Times] 5 grid, ",
 StyleBox["b", "TI"],
 " any of the 8 vertices at distance 3 from it, and ",
 StyleBox["c", "TI"],
 " any of the 4 vertices at distance 4 from it, the corners: 32 instances."
}], "ExampleText",ExpressionUUID->"edc9fa47-7f88-42b0-ac22-802c7abff94a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], ",", "\n", "  ", 
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"scene", " ", "=", " ", 
       RowBox[{"InfraScene", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], ",", "\n", 
         "       ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraStep", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"a", " ", "==", " ", 
               RowBox[{"InfraPoint", "[", "13", "]"}]}], "}"}], ",", 
             " ", "\"\<a\>\""}], "]"}], ",", "\n", "        ", 
           RowBox[{"InfraStep", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"b", " ", "==", " ", 
                RowBox[{"InfraPoint", "[", "]"}]}], ",", " ", 
               RowBox[{
                RowBox[{"InfraDistance", "[", 
                 RowBox[{"a", ",", " ", "b"}], "]"}], " ", "==", " ", "3"}]}],
               "}"}], ",", " ", "\"\<b\>\""}], "]"}], ",", "\n", "        ", 
           RowBox[{"InfraStep", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"c", " ", "==", " ", 
                RowBox[{"InfraPoint", "[", "]"}]}], ",", " ", 
               RowBox[{
                RowBox[{"InfraDistance", "[", 
                 RowBox[{"a", ",", " ", "c"}], "]"}], " ", "==", " ", "4"}]}],
               "}"}], ",", " ", "\"\<c\>\""}], "]"}]}], "}"}]}], "]"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"instances", " ", "=", " ", 
       RowBox[{"RandomInfraInstance", "[", 
        RowBox[{"scene", ",", " ", 
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Length", "[", "instances", "]"}], ",", " ", 
       RowBox[{"InfraSceneInstance", "[", 
        RowBox[{
         RowBox[{"First", "[", "instances", "]"}], ",", " ", "a"}], "]"}], ",",
        " ", 
       RowBox[{"InfraSceneInstance", "[", 
        RowBox[{
         RowBox[{"First", "[", "instances", "]"}], ",", " ", "b"}], "]"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"a1f87d82-ee76-468e-9cdd-4b84c05c3c3d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"32", ",", "13", ",", "2"}], "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"ee0aacb8-8dcc-45da-984d-60cac9224c0b"]
}, Open  ]]
}, Open  ]],

