692b62fe376c"],

Cell[TextData[{
 "The vertex label is carried verbatim, including a list label such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "j"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16f3f932-7c67-4440-94c9-d9cc77199e09"],
 " on a grid or tessellation."
}], "Notes",ExpressionUUID->"5732ac6e-4fb1-49be-9158-7390213cdb7e"],

Cell[TextData[{
 "Invariants are functions of the graph and a vertex, not accessors: ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"InfraBall", "[", 
     RowBox[{"v", ",", " ", "r"}], "]"}], ",", 
    " ", "\"\<CountingMeasure\>\""}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0929ea49-7d48-4f30-b973-63bb8106de96"],
 " gives the bare number for one vertex, and the list of regions one number \
per vertex."
}], "Notes",ExpressionUUID->"956aaa97-2421-4689-a658-56c53a9379ab"]
}, Open  ]],

