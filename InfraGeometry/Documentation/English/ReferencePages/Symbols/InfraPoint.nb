     Cell[BoxData[
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"v", " ", "->", " ", "m"}], ",", " ", "\[Ellipsis]"}], 
       "|>"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ad39302d-44e5-41dc-a7ee-145ab40d5a28"],
     ", see ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraDensity"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraDensity", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "c58c724c-56b8-48d2-90ae-5c455d55c599"]
