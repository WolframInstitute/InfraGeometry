4ffb694e6dd9"],

Cell[TextData[{
 "The vertex label is carried verbatim, including a list label such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "j"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b718b20d-a303-4070-bc8b-15722d46f769"],
 " on a grid or tessellation."
}], "Notes",ExpressionUUID->"2c730768-16bf-4090-8eef-0d537b0e0983"],

Cell[TextData[{
 "Invariants are functions of the graph and a vertex, not accessors: ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"InfraBall", "[", 
     RowBox[{"v", ",", " ", "r"}], "]"}], ",", 
    " ", "\"\<CountingMeasure\>\""}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c5015fc-e2b5-47dc-b298-dbe39e28cdf5"],
 " gives the bare number for one vertex, and the list of regions one number \
per vertex."
}], "Notes",ExpressionUUID->"9773b6e2-3de5-4a4a-a318-07b58ecb58d2"]
}, Open  ]],

