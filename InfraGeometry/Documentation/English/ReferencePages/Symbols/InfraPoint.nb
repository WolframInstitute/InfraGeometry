Cell[TextData[{
 "The vertex label is carried verbatim, including a list label such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "j"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd42801b-44eb-499b-ae4c-e25672519f9d"],
 " on a grid or tessellation."
}], "Notes",ExpressionUUID->"347d2f17-8dda-4769-a9fb-85e1ee6ad820"],

Cell[TextData[{
 "Invariants are functions of the graph and a vertex, not accessors: ",
 Cell[BoxData[
  RowBox[{"BallVolumes", "[", 
   RowBox[{"g", ",", " ", "v", ",", " ", 
    RowBox[{"{", 
     RowBox[{"rmin", ",", " ", "rmax"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "260b7413-acbf-4b08-b84c-6f3eea06ba5f"],
 " gives the bare numbers for one vertex, and one row per vertex for a vertex \
list."
}], "Notes",ExpressionUUID->"d68362f9-2a18-4507-bea1-91fed3ecbadf"]
}, Open  ]],

