Cell["A point finder returns vertices \[LongDash] one, or a list.", \
"ExampleText",ExpressionUUID->"efa13e5e-c753-475d-8277-4a464d3eae8f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FindInfraPoint", "[", 
      RowBox[{"g", ",", " ", "All", ",", " ", 
       RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], "]"}], ",",
      " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraPoint", "[", 
       RowBox[{"g", ",", " ", "3"}], "]"}]}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4eaf605f-5eed-47ed-bada-7f3d89dd5cf0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", "3"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"1e285e39-41d6-4a91-a16a-d287a0ce0ead"]
}, Open  ]],

Cell["\<\
A vertex answers invariants with bare numbers; a list of regions answers with \
one number each.\
\>", "ExampleText",ExpressionUUID->"d51b971d-4d9d-4abe-aef7-947c46c5cdde"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", 
       " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"GraphPeriphery", "[", "g", "]"}]}], ",", " ", "3"}], 
          "]"}]}], "}"}], ",", " ", "\"\<CountingMeasure\>\""}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"5a81ac65-283a-446f-9b05-67b392b26544"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"25", ",", 
   RowBox[{"{", 
    RowBox[{"25", ",", "14"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"9956eb40-84dc-4363-9646-34292d9d22c9"]
}, Open  ]],

Cell[TextData[{
 "In a scene the token is solved on the graph. Here ",
 StyleBox["a", "TI"],
 " is the centre of a 5 \[Times] 5 grid, ",
 StyleBox["b", "TI"],
 " any of the 8 vertices at distance 3 from it, and ",
 StyleBox["c", "TI"],
 " any of the 4 corners: 32 instances."
}], "ExampleText",ExpressionUUID->"641b3abe-c8c3-4ebb-823d-1f0810712424"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], ",", "\n", "  ", 
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"scene", " ", "=", " ", 
       RowBox[{"InfraScene", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], ",", "\n", 
         "       ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraStep", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"a", " ", "==", " ", 
               RowBox[{"InfraPoint", "[", "\"\<Center\>\"", "]"}]}], "}"}], ",",
              " ", "\"\<a\>\""}], "]"}], ",", "\n", "        ", 
           RowBox[{"InfraStep", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"b", " ", "==", " ", 
               RowBox[{"InfraPoint", "[", 
                RowBox[{"a", ",", " ", "3"}], "]"}]}], "}"}], ",", 
             " ", "\"\<b\>\""}], "]"}], ",", "\n", "        ", 
           RowBox[{"InfraStep", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"c", " ", "==", " ", 
               RowBox[{"InfraPoint", "[", "\"\<Periphery\>\"", "]"}]}], "}"}],
              ",", " ", "\"\<c\>\""}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"instances", " ", "=", " ", 
       RowBox[{"FindInfraScene", "[", 
        RowBox[{"scene", ",", " ", 
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Length", "[", "instances", "]"}], ",", " ", 
       RowBox[{"InfraSceneInstance", "[", 
        RowBox[{
         RowBox[{"First", "[", "instances", "]"}], ",", " ", "a"}], "]"}], ",",
        " ", 
       RowBox[{"InfraSceneInstance", "[", 
        RowBox[{
         RowBox[{"First", "[", "instances", "]"}], ",", " ", "b"}], "]"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"1df1abd6-61af-4c27-9564-24ff69451d9f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"32", ",", "13", ",", "2"}], "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"cca6c104-ce53-4d4f-9770-8f19f974e00c"]
}, Open  ]]
}, Open  ]],

