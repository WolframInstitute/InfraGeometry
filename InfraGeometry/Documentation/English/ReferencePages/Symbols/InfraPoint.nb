Cell["\<\
A point is a vertex, and several candidate points are a vertex list. The \
centre of a grid and three random points at distance 4 from it.\
\>", "ExampleText",ExpressionUUID->"5c239791-4b5d-440f-b861-ea9ddf76906c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"centre", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"picks", " ", "=", " ", 
     RowBox[{"FindInfraPoint", "[", 
      RowBox[{"g", ",", " ", "3", ",", " ", 
       RowBox[{"\"\<From\>\"", " ", "->", " ", 
        RowBox[{"centre", " ", "->", " ", "4"}]}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"centre", ",", " ", "picks"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}]}], "]"}]}], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"7fa006e8-4092-4e13-84b5-f15dee4a1473"],

