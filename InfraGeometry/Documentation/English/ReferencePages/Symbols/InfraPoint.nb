Cell[TextData[{
 "The vertex label is carried verbatim, including a list label such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "j"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd15ca72-f7ea-460e-872d-dc6c7ca0fa45"],
 " on a grid or tessellation."
}], "Notes",ExpressionUUID->"7805a3e3-5c2d-4f7e-8254-3db06d0aaa7a"],

Cell[TextData[{
 "Invariants are functions of the graph and a vertex, not accessors: ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"InfraBall", "[", 
     RowBox[{"v", ",", " ", "r"}], "]"}], ",", 
    " ", "\"\<CountingMeasure\>\""}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90ad59c5-fd55-4432-9fe7-0ec647b7fb68"],
 " gives the bare number for one vertex, and the list of regions one number \
per vertex."
}], "Notes",ExpressionUUID->"191b7bc6-2d1a-4098-b641-56828dc5c7f3"]
}, Open  ]],

