       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FindInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"GraphCenter", "[", "g", "]"}], ",", " ", "All"}], "]"}], ",", 
     " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraPoint", "[", 
       RowBox[{"g", ",", " ", "3"}], "]"}]}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"77405f24-f148-4f2d-bd47-d79a608fc61c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", "3"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"eb7c21a0-57a6-4859-8e83-3f96700bc22f"]
}, Open  ]],

Cell["\<\
A vertex answers invariants with bare numbers; a list of regions answers with \
one number each.\
\>", "ExampleText",ExpressionUUID->"673e1256-b2c3-474a-a9b9-ad84ce79b698"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", 
       " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"GraphPeriphery", "[", "g", "]"}]}], ",", " ", "3"}], 
          "]"}]}], "}"}], ",", " ", "\"\<CountingMeasure\>\""}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"68aeae33-9008-4bc5-a5f5-db1f9d94a1b5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"25", ",", 
   RowBox[{"{", 
    RowBox[{"25", ",", "14"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"59ee58c4-2144-4f45-9b75-eccb2a47e73a"]
}, Open  ]],

Cell[TextData[{
 "In a scene the token is solved on the graph. Here ",
 StyleBox["a", "TI"],
 " is the centre of a 5 \[Times] 5 grid, ",
 StyleBox["b", "TI"],
 " any of the 8 vertices at distance 3 from it, and ",
 StyleBox["c", "TI"],
 " any of the 4 vertices at distance 4 from it, the corners: 32 instances."
}], "ExampleText",ExpressionUUID->"b49fbd78-bfdf-41db-8968-d566dd3b682c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], ",", "\n", "  ", 
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"scene", " ", "=", " ", 
       RowBox[{"InfraScene", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], ",", "\n", 
         "       ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraStep", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"a", " ", "==", " ", 
               RowBox[{"InfraPoint", "[", "13", "]"}]}], "}"}], ",", 
             " ", "\"\<a\>\""}], "]"}], ",", "\n", "        ", 
           RowBox[{"InfraStep", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"b", " ", "==", " ", 
                RowBox[{"InfraPoint", "[", "]"}]}], ",", " ", 
               RowBox[{
                RowBox[{"InfraDistance", "[", 
                 RowBox[{"a", ",", " ", "b"}], "]"}], " ", "==", " ", "3"}]}],
               "}"}], ",", " ", "\"\<b\>\""}], "]"}], ",", "\n", "        ", 
           RowBox[{"InfraStep", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"c", " ", "==", " ", 
                RowBox[{"InfraPoint", "[", "]"}]}], ",", " ", 
               RowBox[{
                RowBox[{"InfraDistance", "[", 
                 RowBox[{"a", ",", " ", "c"}], "]"}], " ", "==", " ", "4"}]}],
               "}"}], ",", " ", "\"\<c\>\""}], "]"}]}], "}"}]}], "]"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"instances", " ", "=", " ", 
       RowBox[{"FindInfraScene", "[", 
        RowBox[{"scene", ",", " ", 
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Length", "[", "instances", "]"}], ",", " ", 
       RowBox[{"InfraSceneInstance", "[", 
        RowBox[{
         RowBox[{"First", "[", "instances", "]"}], ",", " ", "a"}], "]"}], ",",
        " ", 
       RowBox[{"InfraSceneInstance", "[", 
        RowBox[{
         RowBox[{"First", "[", "instances", "]"}], ",", " ", "b"}], "]"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"c83b0ee6-e2cd-468c-b2a6-511a7a0d2a03"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"32", ",", "13", ",", "2"}], "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"0e98de7e-7927-49a1-ac72-4bf179e608fd"]
}, Open  ]]
}, Open  ]],

