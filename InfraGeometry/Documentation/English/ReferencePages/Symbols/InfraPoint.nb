Cell["A point finder returns vertices \[LongDash] one, or a list.", \
"ExampleText",ExpressionUUID->"b9699f7e-47e9-4e66-8792-73ac8a677500"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FindInfraPoint", "[", 
      RowBox[{"g", ",", " ", "All", ",", " ", 
       RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], "]"}], ",",
      " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraPoint", "[", 
       RowBox[{"g", ",", " ", "3"}], "]"}]}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3148c6b3-81c5-45da-848f-159ec1507abf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", "3"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"04b3079c-83fd-4275-9c2a-2f561d157df9"]
}, Open  ]],

Cell["\<\
A vertex answers invariants with bare numbers; a list of vertices answers \
with one row each.\
\>", "ExampleText",ExpressionUUID->"cb5ad0d2-79c4-40e0-9e23-730b55edb086"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"BallVolumes", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"BallVolumes", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphPeriphery", "[", "g", "]"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "3"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"ffe88720-751a-4548-be66-e08afd7aa4b0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "5", ",", "13", ",", "25"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "5", ",", "13", ",", "25"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3", ",", "8", ",", "14"}], "}"}]}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"276d18de-05ec-4a2b-a979-068e000924f3"]
}, Open  ]],

Cell[TextData[{
 "In a scene the token is solved on the graph. Here ",
 StyleBox["a", "TI"],
 " is the centre of a 5 \[Times] 5 grid, ",
 StyleBox["b", "TI"],
 " any of the 8 vertices at distance 3 from it, and ",
 StyleBox["c", "TI"],
 " any of the 4 corners: 32 instances."
}], "ExampleText",ExpressionUUID->"ecc7a9fd-1243-47c7-8bd0-54d23b8eef68"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], ",", "\n", "  ", 
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"scene", " ", "=", " ", 
       RowBox[{"InfraScene", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], ",", "\n", 
         "       ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraGeometricStep", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"a", " ", "==", " ", 
               RowBox[{"InfraPoint", "[", "\"\<Center\>\"", "]"}]}], "}"}], ",",
              " ", "\"\<a\>\""}], "]"}], ",", "\n", "        ", 
           RowBox[{"InfraGeometricStep", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"b", " ", "==", " ", 
               RowBox[{"InfraPoint", "[", 
                RowBox[{"a", ",", " ", "3"}], "]"}]}], "}"}], ",", 
             " ", "\"\<b\>\""}], "]"}], ",", "\n", "        ", 
           RowBox[{"InfraGeometricStep", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"c", " ", "==", " ", 
               RowBox[{"InfraPoint", "[", "\"\<Periphery\>\"", "]"}]}], "}"}],
              ",", " ", "\"\<c\>\""}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"instances", " ", "=", " ", 
       RowBox[{"FindInfraScene", "[", 
        RowBox[{"scene", ",", " ", 
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Length", "[", "instances", "]"}], ",", " ", 
       RowBox[{"InfraSceneInstance", "[", 
        RowBox[{
         RowBox[{"First", "[", "instances", "]"}], ",", " ", "a"}], "]"}], ",",
        " ", 
       RowBox[{"InfraSceneInstance", "[", 
        RowBox[{
         RowBox[{"First", "[", "instances", "]"}], ",", " ", "b"}], "]"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"6801e1ab-50bb-4514-bede-44ce866018fa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"32", ",", "13", ",", "2"}], "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"a7176a07-7330-472c-aeec-39abace101be"]
}, Open  ]]
}, Open  ]],

