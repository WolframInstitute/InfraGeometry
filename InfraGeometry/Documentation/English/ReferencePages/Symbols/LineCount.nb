Notebook[{

Cell[CellGroupData[{
Cell["LineCount", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1197d30b-b258-4075-9356-4f65f96d67a2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LineCount"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/LineCount", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40d114a8-6a5c-4dc7-a869-be32fb538ca4"],
 "\[LineSeparator]",
 "gives the number of distinct lines in ",
 StyleBox["g", "TI"],
 " \[LongDash] inextensible geodesics, counted up to reversal.",
 "\n"
}], "Usage",ExpressionUUID->"bbff6ea9-ad5b-4b30-aa99-b6eb732c6bef"],

Cell[TextData[{
 "A line and its reverse are one line. The count enumerates ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e513cb1-6bf9-471c-8359-9701b68d7447"],
 " over every pair of vertices and deduplicates, so it is exponential on \
lattices; it is meant for small graphs, where it is the coarsest invariant of \
the incidence structure."
}], "Notes",ExpressionUUID->"6d051f1f-bda8-4a42-9d05-27767f192e44"]
}, Open  ]],

