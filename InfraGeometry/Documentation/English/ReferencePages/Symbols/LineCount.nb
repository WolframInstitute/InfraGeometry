Notebook[{

Cell[CellGroupData[{
Cell["LineCount", "ObjectName",ExpressionUUID->"8880b219-acef-4aff-bb50-e80a674c967c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3529760f-ecd7-447c-a261-f7c7487da4ab"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LineCount"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/LineCount", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de05c52e-a2ae-4ef5-b2a6-5c21a6133cc3"],
 "\[LineSeparator]",
 "gives the number of distinct lines in ",
 StyleBox["g", "TI"],
 " \[LongDash] inextensible shortest paths, counted up to reversal.",
 "\n"
}], "Usage",ExpressionUUID->"4cbfa262-b8a9-4490-980c-863fd4cfe313"],

Cell[TextData[{
 "A line and its reverse are one line. The count enumerates ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraInfiniteLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraInfiniteLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9afe248d-d3ec-4c8d-89a5-477699897b28"],
 " over every pair of vertices and deduplicates, so it is exponential on \
lattices; it is meant for small graphs, where it is the coarsest invariant of \
the incidence structure."
}], "Notes",ExpressionUUID->"cf96343f-2cd1-4d00-bf40-429a108712e3"]
}, Open  ]],

