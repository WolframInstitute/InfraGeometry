Cell["\<\
The 6-cycle has six lines, one per antipodal pair of ends; a path has one.\
\>", "ExampleText",ExpressionUUID->"6d6b0a01-59c8-4f3a-8463-d4ccd3c06861"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"LineCount", "[", 
    RowBox[{"CycleGraph", "[", "6", "]"}], "]"}], ",", " ", 
   RowBox[{"LineCount", "[", 
    RowBox[{"PathGraph", "[", 
     RowBox[{"Range", "[", "5", "]"}], "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2a1f0359-898f-438b-8472-c72f48941786"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "1"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c76e2c17-394a-4e26-ad31-167aa1779a9f"]
}, Open  ]],

Cell["The 3 \[Times] 3 grid has twelve.", "ExampleText",ExpressionUUID->"4646a602-5ec1-4e66-9f93-e1f2c6e49b9d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LineCount", "[", 
  RowBox[{"GridGraph", "[", 
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4cce3c55-47a3-4bca-a224-6006c501a5b1"],

Cell[BoxData["12"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"35a597c7-b262-43c4-ab2e-4d272a2d87f8"]
}, Open  ]]
}, Open  ]],

