Cell["\<\
The 6-cycle has six lines, one per antipodal pair of ends; a path has one.\
\>", "ExampleText",ExpressionUUID->"4c62dce9-ed7c-48d7-8329-599cc3266870"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"LineCount", "[", 
    RowBox[{"CycleGraph", "[", "6", "]"}], "]"}], ",", " ", 
   RowBox[{"LineCount", "[", 
    RowBox[{"PathGraph", "[", 
     RowBox[{"Range", "[", "5", "]"}], "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cd1fac0e-4f5a-47e6-a62f-89e255df82c6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "1"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a91a35db-78cc-4698-bce9-42afe37d0152"]
}, Open  ]],

Cell["The 3 \[Times] 3 grid has twelve.", "ExampleText",ExpressionUUID->"f4d39e27-4e90-4e21-a571-c470b4406113"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LineCount", "[", 
  RowBox[{"GridGraph", "[", 
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3bc99f85-28e0-4009-989e-80c2a673a000"],

Cell[BoxData["12"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"9aa964ec-6965-4b24-9321-56ac7ef66c0f"]
}, Open  ]]
}, Open  ]],

