Notebook[{

Cell[CellGroupData[{
Cell["LineCount", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2e68ead4-264a-4503-a851-bfa230690b23"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LineCount"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/LineCount", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0878d493-783a-4c67-9ee9-333a837c57dd"],
 "\[LineSeparator]",
 "gives the number of distinct lines in ",
 StyleBox["g", "TI"],
 " \[LongDash] inextensible geodesics, counted up to reversal.",
 "\n"
}], "Usage",ExpressionUUID->"3dda30ef-3eca-4295-afc0-625af12ec583"],

Cell[TextData[{
 "A line and its reverse are one line. The count enumerates ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5676e7bd-5c7b-40d9-a4cb-445b4870cc45"],
 " over every pair of vertices and deduplicates, so it is exponential on \
lattices; it is meant for small graphs, where it is the coarsest invariant of \
the incidence structure."
}], "Notes",ExpressionUUID->"b1280b93-f05f-4430-9420-94e5589d5013"]
}, Open  ]],

