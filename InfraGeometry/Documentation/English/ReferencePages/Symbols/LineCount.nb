Notebook[{

Cell[CellGroupData[{
Cell["LineCount", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"25ba7578-50e0-4994-bcd6-89a0b48cefef"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LineCount"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/LineCount", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b1cd09c-ad10-4072-90fc-199bb2d441e4"],
 "\[LineSeparator]",
 "gives the number of distinct lines in ",
 StyleBox["g", "TI"],
 " \[LongDash] inextensible geodesics, counted up to reversal.",
 "\n"
}], "Usage",ExpressionUUID->"2a187e10-7b27-4889-a6eb-2c788c0fb97e"],

Cell[TextData[{
 "A line and its reverse are one line. The count enumerates ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0343426-a027-4406-b494-1ef0b9472633"],
 " over every pair of vertices and deduplicates, so it is exponential on \
lattices; it is meant for small graphs, where it is the coarsest invariant of \
the incidence structure."
}], "Notes",ExpressionUUID->"66db7a7f-cbe6-4d16-9e27-b2dae8412bac"]
}, Open  ]],

