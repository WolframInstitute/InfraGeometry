Cell[TextData[{
 "A line is a shortest path ",
 StyleBox["(v\:2080, \[Ellipsis], v\:2096)", "TI"],
 " such that no neighbour ",
 StyleBox["w", "TI"],
 " of ",
 StyleBox["v\:2096", "TI"],
 " has ",
 StyleBox["d(v\:2080, w) = k + 1", "TI"],
 ", and likewise at ",
 StyleBox["v\:2080", "TI"],
 ". The lines are the members of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraInfiniteLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraInfiniteLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d50a10e-2fd1-4ada-a2bb-e3287f97c605"],
 " over all pairs ",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"b30f90e3-8c48-4527-ad11-76c4da16494c"],

Cell["Closed forms:", "Notes",ExpressionUUID->"0101d9a6-c4d6-4f0b-bd52-9f7f47442676"],

