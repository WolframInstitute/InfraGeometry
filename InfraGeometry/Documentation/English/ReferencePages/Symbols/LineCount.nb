Cell[TextData[{
 "On a grid graph a row or a column is not a line: it can be prolonged at a \
turn. The number of lines grows exponentially with the size of a lattice, so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LineCount"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/LineCount", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "25819b67-0127-47ee-ac34-0faedcad44d1"],
 " is for small graphs."
}], "Notes",ExpressionUUID->"50a79100-cb60-44fd-a153-f821dc7a3e0e"]
}, Open  ]],

