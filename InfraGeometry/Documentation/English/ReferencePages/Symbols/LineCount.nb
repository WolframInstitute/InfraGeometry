Cell["\<\
The 6-cycle has six lines, one per antipodal pair of ends; a path has one.\
\>", "ExampleText",ExpressionUUID->"d4b7cf35-82f1-41a2-941f-4f17323080f7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"LineCount", "[", 
    RowBox[{"CycleGraph", "[", "6", "]"}], "]"}], ",", " ", 
   RowBox[{"LineCount", "[", 
    RowBox[{"PathGraph", "[", 
     RowBox[{"Range", "[", "5", "]"}], "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0ea409da-620a-4ce0-9bd0-5fa1cae2605d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "1"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b632a5f2-5904-4513-8df9-1ef4bbf14168"]
}, Open  ]],

Cell["The 3 \[Times] 3 grid has twelve.", "ExampleText",ExpressionUUID->"92747ec5-1931-460e-84d4-863a8d50c647"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LineCount", "[", 
  RowBox[{"GridGraph", "[", 
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"bc9ae6fb-e510-40ed-8637-709be4f20f9a"],

Cell[BoxData["12"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"24bdcb3e-872b-40ea-b510-99c5830d31f7"]
}, Open  ]]
}, Open  ]],

