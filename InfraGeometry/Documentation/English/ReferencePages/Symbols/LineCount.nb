Cell["\<\
On the 4 \[Times] 4 grid graph a side can be prolonged around the corner, so \
it is not a line; the prolonged walk, from corner to opposite corner, is:\
\>", "ExampleText",ExpressionUUID->"618cd0a2-ae3a-42ae-a585-49538b3d64a8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"side", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}]}], ",",
      " ", 
     RowBox[{"line", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
       "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "8", ",", 
        " ", "12", ",", " ", "16"}], "}"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"InfraWalk", "[", "w", "]"}], "}"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraInfiniteLineQ", "[", 
          RowBox[{"g", ",", " ", "w"}], "]"}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"w", ",", " ", 
        RowBox[{"{", 
         RowBox[{"side", ",", " ", "line"}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"81857c0b-69b6-42c8-8a57-3d023990ac84"],

