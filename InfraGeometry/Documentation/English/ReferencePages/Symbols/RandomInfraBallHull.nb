    RowBox[{"InfraBallHull", "[", 
     RowBox[{
      StyleBox["seeds", "TI"], ",", " ", 
      StyleBox["band", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f297ff21-3849-4569-9eeb-af0e8a06f488"],
 "\[LineSeparator]",
 "samples a sorted vertex set on graph ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"17c0e53a-df26-430f-914d-1e913d71edfc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraBallHull"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraBallHull", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraBallHull", "[", 
     RowBox[{
      StyleBox["seeds", "TI"], ",", " ", 
      StyleBox["band", "TI"]}], "]"}], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77026549-2396-4366-8912-055d5b90dce6"],
 "\[LineSeparator]",
 "requests ",
 Cell[BoxData["count"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b77deb99-d862-44cd-9b38-17930a45c7c1"],
 " representatives. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "106a2294-71d9-4223-881e-4b1f8a9788e9"],
 " enumerates the full pool; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98f7ecd8-114c-48d0-b204-2dac90ed627d"],
 " returns at most ",
 StyleBox["n", "TI"],
 "."
}], "Usage",ExpressionUUID->"b86bd0e5-ad13-4199-a9bb-1377ccb8135a"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomInfraBallHull", "[", 
   RowBox[{"g", ",", " ", "seeds", ",", " ", "band", ",", " ", "count"}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53a835ae-64f9-4b39-9d21-6d41c01c2a2f"],
 " uses the direct form. With the band omitted, the direct form is singular; \
use ",
 Cell[BoxData[
  RowBox[{"InfraBallHull", "[", "seeds", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a948a455-e7ee-49fc-813a-7725c67ec94d"],
 " when supplying a count without a band."
}], "Notes",ExpressionUUID->"a8213068-f3bb-4539-9ed8-0384f930b4f1"],

Cell[TextData[{
 "The sampler has the same token geometry as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBallHull"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBallHull", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cb1a3c7a-a939-4472-8c85-fadec5cf8535"],
 ". An omitted or ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "233e8631-bf97-4a76-ae33-f67559b8b196"],
 " count returns one representative. An integer count requests exactly that \
many distinct representatives and returns ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae3cc008-c432-42c3-b1c5-c174305a5238"],
 " when too few exist."
}], "Notes",ExpressionUUID->"64dbadf3-a8a8-43d7-833e-c2612d35951d"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b573b61-3d23-4a99-9445-873d89308ff9"],
 " selects deterministically. Default ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5d42a05-8a70-43a4-b360-18e9c4828319"],
 " does not advance random state. Seed an ordinary draw with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a849c5bc-6b1a-45b3-8413-ca56802b84e8"],
 "."
}], "Notes",ExpressionUUID->"c10b839d-64b6-4cc0-8674-3263733826a7"],

