Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5fe91d9e-89b2-4ddf-b8a3-5991bc1562a5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraBallHull"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraBallHull", 
