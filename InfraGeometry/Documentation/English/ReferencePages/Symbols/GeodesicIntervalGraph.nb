Cell[CellGroupData[{
Cell["GeodesicIntervalGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ec810bc9-8945-443f-953d-99f7fa776dd0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicIntervalGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicIntervalGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bd3f16e-202b-4982-a417-b3c4bb69a172"],
 "\[LineSeparator]",
 "gives the metric interval between ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " as a directed acyclic graph whose directed paths from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " are exactly the geodesics from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"405bc1ad-baf4-4f09-82ac-f50ac411ea1c"],

Cell[TextData[{
 "Definition: the metric interval is ",
 StyleBox["I(u, v) = {w : d(u, w) + d(w, v) = d(u, v)}", "TI"],
 ", the vertices on some geodesic from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ". The graph has these vertices, and an edge ",
 StyleBox["w \[RightArrow] x", "TI"],
 " for every edge of ",
 StyleBox["g", "TI"],
 " between two of them with ",
 StyleBox["d(u, x) = d(u, w) + 1", "TI"],
 "."
}], "Notes",ExpressionUUID->"775ea855-5584-4a3e-964a-0c1e36550aca"],

Cell[TextData[{
 "Every geodesic from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " is a directed path of the graph, and every directed path from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " is a geodesic, each exactly once. So the graph holds the whole family \
without listing it."
}], "Notes",ExpressionUUID->"e99d9b68-187f-4b46-92cd-d8aecf6c5b63"],

Cell[TextData[{
 "It is built from the two distance fields ",
 StyleBox["d(u, \[CenterDot])", "TI"],
 " and ",
 StyleBox["d(v, \[CenterDot])", "TI"],
 " and never enumerates a path. Its size is at most that of ",
 StyleBox["g", "TI"],
 ", while the number of geodesics can be exponential in ",
 StyleBox["d(u, v)", "TI"],
 "."
}], "Notes",ExpressionUUID->"010fca25-9d61-43ac-932e-10b933b05589"],

Cell[TextData[{
 "On a square grid the interval is the rectangle spanned by ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 ", and the geodesics are the lattice paths through it. Where ",
 StyleBox["g", "TI"],
 " is disconnected between ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " the graph is empty."
}], "Notes",ExpressionUUID->"8dc8d6f1-31fa-474f-9810-e598da47130d"],

Cell[TextData[{
 "The graph of the head ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4a5c8f2e-4b5e-4e47-823e-f6b0f0cc0feb"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"u", ",", " ", "v"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84f52dae-4bba-404b-8531-772bb74415f1"],
 " is this graph."
}], "Notes",ExpressionUUID->"8d4f2c79-2d8c-462d-be99-f5c0be80b8f3"]
}, Open  ]],

