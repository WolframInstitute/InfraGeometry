    RowBox[{
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"VertexList", "[", "intervalDag", "]"}]}], " ", "===", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"MetricInterval", "[", 
        RowBox[{"g", ",", " ", "41", ",", " ", "61"}], "]"}]}]}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", 
