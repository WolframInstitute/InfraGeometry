Cell[CellGroupData[{
Cell["GeodesicIntervalGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"69f67fb4-3664-4307-b4c1-5aa18bec28a5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicIntervalGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicIntervalGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8dd75c20-e0bc-41b2-822e-d5ab01b73786"],
 "\[LineSeparator]",
 "gives the metric interval between ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " as a directed acyclic graph whose directed paths from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " are exactly the geodesics from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"1fd769e9-e510-45dc-bdad-f882286e35ab"],

Cell[TextData[{
 "Definition: the metric interval is ",
 StyleBox["I(u, v) = {w : d(u, w) + d(w, v) = d(u, v)}", "TI"],
 ", the vertices on some geodesic from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ". The graph has these vertices, and an edge ",
 StyleBox["w \[RightArrow] x", "TI"],
 " for every edge of ",
 StyleBox["g", "TI"],
 " between two of them with ",
 StyleBox["d(u, x) = d(u, w) + 1", "TI"],
 "."
}], "Notes",ExpressionUUID->"d133b40c-1adf-4efc-a853-ceaf7c58c8a6"],

Cell[TextData[{
 "Every geodesic from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " is a directed path of the graph, and every directed path from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " is a geodesic, each exactly once. So the graph holds the whole family \
without listing it."
}], "Notes",ExpressionUUID->"ec9e0ab0-1d5c-4466-a2ae-3f58a3e29282"],

Cell[TextData[{
 "It is built from the two distance fields ",
 StyleBox["d(u, \[CenterDot])", "TI"],
 " and ",
 StyleBox["d(v, \[CenterDot])", "TI"],
 " and never enumerates a path. Its size is at most that of ",
 StyleBox["g", "TI"],
 ", while the number of geodesics can be exponential in ",
 StyleBox["d(u, v)", "TI"],
 "."
}], "Notes",ExpressionUUID->"114c998b-c9e8-495f-b2a5-69352d8eee0c"],

Cell[TextData[{
 "On a square grid the interval is the rectangle spanned by ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 ", and the geodesics are the lattice paths through it. Where ",
 StyleBox["g", "TI"],
 " is disconnected between ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " the graph is empty."
}], "Notes",ExpressionUUID->"9b94bc7e-47f1-44d1-af55-5d7751a352e2"],

Cell[TextData[{
 "The graph of the head ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "de25d36b-4998-4337-8dd2-15c42dafbd10"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"u", ",", " ", "v"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01f93ca8-75ea-4479-8ac9-a61b00a481fe"],
 " is this graph."
}], "Notes",ExpressionUUID->"1d3b791c-f42f-44ec-be4e-df7be7f6a930"]
}, Open  ]],

