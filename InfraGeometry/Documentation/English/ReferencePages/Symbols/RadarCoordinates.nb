        RowBox[{"Normal", "[", "radar", "]"}]}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"CountDistinct", "[", 
      RowBox[{"Values", "[", "radar", "]"}], "]"}], ",", " ", 
     RowBox[{"VertexCount", "[", "g", "]"}], ",", " ", 
     RowBox[{"ResolvingSetQ", "[", 
      RowBox[{"g", ",", " ", "stations"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"89704c3f-8f41-4bea-9bd5-ec134beafc81"],

