Cell["\<\
Two corners of one side of a grid resolve it. Drawn at its radar coordinates \
from them, the grid is itself again, turned by 45 degrees.\
\>", "ExampleText",ExpressionUUID->"a8cf7174-40a9-4565-a86c-4218f109c70a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "6"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"stations", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "6"}], "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", "stations", "}"}]}], "]"}], ",", "\n", "     ", 
        RowBox[{"Graph", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", 
           RowBox[{"Normal", "[", 
            RowBox[{"RadarCoordinates", "[", 
             RowBox[{"g", ",", " ", "stations"}], "]"}], "]"}]}]}], "]"}]}], 
       "}"}], "]"}], ",", "\n", "   ", 
     RowBox[{"ResolvingSetQ", "[", 
      RowBox[{"g", ",", " ", "stations"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9ac6f32a-fc9a-4918-abdf-97abc87bf720"],

