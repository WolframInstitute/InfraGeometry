Cell["AnchorAggregation", "ExampleSubsection",ExpressionUUID->"d5ad773c-c28d-40af-a2e9-fc77b77f3819"],

Cell[TextData[{
 "A station of two vertices six steps apart, read three ways on the square \
tiling. Each level set of the coordinate has its own colour, the least one \
red. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Min"]], "paclet:ref/Min"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4ad2fc01-8650-4bb5-8154-0f6ab991c08d"],
 " gives the distance to the nearer vertex: its level sets are the outer \
shells of the unions of two balls, starting at the two vertices. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Max"]], "paclet:ref/Max"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bcca0247-178d-4e8d-a33b-b3f013447597"],
 " gives the distance to the farther vertex: its level sets are the outer \
shells of the intersections of two balls, starting at the midpoints. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Total"]], "paclet:ref/Total"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9e3a7f56-07e4-46f6-9c99-01fe48ccd72f"],
 " gives the sum of the two distances: its level sets are the infra-ellipses \
with the two vertices as foci, starting at the interval between them."
}], "ExampleText",ExpressionUUID->"d1424b02-da16-4bed-bd72-094758dc2970"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"foci", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "3"}], "]"}]}], 
        ")"}], ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "3"}], "]"}]}], 
        ")"}]}], "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"readings", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"RadarCoordinates", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"AssociationThread", "[", 
           RowBox[{"foci", ",", " ", "1"}], "]"}], "}"}], ",", " ", 
         RowBox[{"\"\<AnchorAggregation\>\"", " ", "->", " ", 
          "aggregation"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"aggregation", ",", " ", 
         RowBox[{"{", 
          RowBox[{"Min", ",", " ", "Max", ",", " ", "Total"}], "}"}]}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"Values", " ", "@", " ", 
           RowBox[{"KeySort", " ", "@", " ", 
            RowBox[{"GroupBy", "[", 
             RowBox[{
              RowBox[{"Keys", "[", "#", "]"}], ",", " ", "#"}], "]"}]}]}]}], 
         "]"}], " ", "&"}], " ", "/@", " ", "readings"}], "]"}], ",", " ", 
     RowBox[{"GraphDistance", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Sequence", " ", "@@", " ", "foci"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"41d23f6a-c36c-4d52-a14c-eea0b35582af"],

