Cell["AnchorAggregation", "ExampleSubsection",ExpressionUUID->"55c3b0a7-9dec-4887-871f-c0b5322f405e"],

Cell[TextData[{
 "A station of two vertices 6 apart, read three ways on the square grid. The \
vertices at ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Min"]], "paclet:ref/Min"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9df03fc5-0b50-43fb-b628-4536707b8ba8"],
 " distance 3 are the outer layer of the union of two balls of radius 3, \
those at ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Max"]], "paclet:ref/Max"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f0d2c74d-d9d7-497e-b47a-258ee1164232"],
 " distance 4 the outer layer of the intersection of two balls of radius 4, \
those at ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Total"]], "paclet:ref/Total"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cde6f477-6d7e-4109-bc48-4a99c6c5ddd5"],
 " distance 8 the ellipse with the two vertices as foci:"
}], "ExampleText",ExpressionUUID->"dab7f869-40d7-44cd-9a2f-b80b01f6d2a1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"foci", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "2", ",", " ", 
       RowBox[{"\"\<PairwiseDistance\>\"", " ", "->", " ", "6"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"KeyValueMap", "[", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"f", ",", " ", "level"}], "}"}], " ", "|->", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"d", " ", "=", " ", 
           RowBox[{"First", " ", "/@", " ", 
            RowBox[{"RadarCoordinates", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"{", "foci", "}"}], ",", " ", 
              RowBox[{"\"\<AnchorAggregation\>\"", " ", "->", " ", "f"}]}], 
             "]"}]}]}], "}"}], ",", "\n", "      ", 
         RowBox[{"InfraSubstrateHighlight", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Keys", " ", "@", " ", 
              RowBox[{"Select", "[", 
               RowBox[{"d", ",", " ", 
                RowBox[{
                 RowBox[{"#", " ", "==", " ", "level"}], " ", "&"}]}], 
               "]"}]}], ",", " ", "foci"}], "}"}], ",", " ", 
           RowBox[{"PlotLabel", " ", "->", " ", "f"}]}], "]"}]}], "]"}]}], ",",
       "\n", "    ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"Min", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"Max", " ", "->", " ", "4"}], ",", " ", 
        RowBox[{"Total", " ", "->", " ", "8"}]}], "|>"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3287415c-1797-4b56-9025-70e9bc8ea095"],

