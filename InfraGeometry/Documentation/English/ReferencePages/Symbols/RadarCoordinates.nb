Cell["\<\
Two corners of the square tiling do not resolve it. Drawn at its radar \
coordinates from them, the tiling folds along the line through the two \
corners onto half of itself: 113 vertices land on 64 points.\
\>", "ExampleText",ExpressionUUID->"db567928-b933-434a-8069-ea363db3a998"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"stations", " ", "=", " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"FindResolvingSet", "[", "g", "]"}]}], ",", " ", "2"}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"radar", " ", "=", " ", 
     RowBox[{"RadarCoordinates", "[", 
      RowBox[{"g", ",", " ", "stations"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Graph", "[", 
