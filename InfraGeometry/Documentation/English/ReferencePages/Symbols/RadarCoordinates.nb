Cell["\<\
Two opposite corners do not resolve a grid graph. Every vertex lies on a \
shortest path between them, so its two coordinates add up to 10, and the 6 \
\[Times] 6 grid collapses onto 11 points of a line:\
\>", "ExampleText",ExpressionUUID->"b64560d5-a0a1-4fd9-8f4b-843a026aebec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "6"}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"radar", " ", "=", " ", 
     RowBox[{"RadarCoordinates", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "36"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"Graph", "[", 
    RowBox[{
     RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
     RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
     RowBox[{"VertexCoordinates", " ", "->", " ", 
      RowBox[{"Normal", "[", "radar", "]"}]}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
