Cell["RadarCoordinates", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cd8aab5c-8205-4878-ae5d-10f238a66baf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RadarCoordinates"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RadarCoordinates", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["basis", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5039b006-ce9d-41d1-92f9-ac811c2e06e1"],
 "\[LineSeparator]",
 "gives the distances (",
 StyleBox["d", "TI"],
 "(",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["b", "TI"],
 "\:2081), \[Ellipsis], ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["b", "TI"],
 "\:2096)) of the vertex ",
 StyleBox["v", "TI"],
 " of ",
 StyleBox["g", "TI"],
 " from the stations ",
 StyleBox["b", "TI"],
 "\:2081, \[Ellipsis], ",
 StyleBox["b", "TI"],
 "\:2096 of ",
 StyleBox["basis", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"245634ee-b872-439d-804f-5dfb02b167e5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RadarCoordinates"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RadarCoordinates", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["basis", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "030d0fa0-bf89-48e7-a3bc-c1af0662ade5"],
 "\[LineSeparator]",
 "gives the association of every vertex of ",
 StyleBox["g", "TI"],
 " with its radar coordinates."
}], "Usage",ExpressionUUID->"39e4103a-5f16-47f6-a9ec-cd89ba99fac1"],

Cell[TextData[{
 "Definition: the radar coordinates of a vertex ",
 StyleBox["v", "TI"],
 " from a basis (",
 StyleBox["b", "TI"],
 "\:2081, \[Ellipsis], ",
 StyleBox["b", "TI"],
 "\:2096) are its distances (",
 StyleBox["d", "TI"],
 "(",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["b", "TI"],
 "\:2081), \[Ellipsis], ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["b", "TI"],
 "\:2096)). The vertices of the basis are radar stations, and each vertex is \
located by its distances to them, as in trilateration."
}], "Notes",ExpressionUUID->"b15f3508-0642-418f-bafb-12fad1d7150a"],

Cell[TextData[{
 "The coordinates tell every two vertices apart exactly when the basis is a \
resolving set, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ResolvingSetQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ResolvingSetQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "37608d00-2b6c-46af-9fad-f9cf301618c2"],
 ". A smallest resolving set is found by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindResolvingSet"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindResolvingSet", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fe4b3569-8938-48f4-8a12-941d3d761502"],
 ", and its size is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MetricDimension"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/MetricDimension", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1e537858-9877-4289-a475-5fb70dc2155c"],
 "."
}], "Notes",ExpressionUUID->"48e1d3ba-97f2-46bb-8ae2-71ffa241a2e5"],

Cell[TextData[{
 "A station may also be a set of vertices, given as a density or as a walk \
graph. Its coordinate is the list of distances to its vertices, reduced to \
one number by the option ",
 Cell[BoxData["\"\<AnchorAggregation\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6123875c-99e0-4c5f-b666-d9fc3f33bea3"],
 ": ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Min"]], "paclet:ref/Min"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a320ff96-3b2c-46a4-aa54-5d9792ab5f23"],
 " (the default) gives the distance to the nearest vertex of the set, and any \
function of a list may be given."
}], "Notes",ExpressionUUID->"f79093b0-a285-4a1b-9355-40f87914e7f9"],

Cell[TextData[{
 "The point ",
 StyleBox["v", "TI"],
 " may also be a density; the result is then the list of the coordinates of \
its vertices."
}], "Notes",ExpressionUUID->"abb87d88-2144-49d9-9767-1a96bf82384f"],

