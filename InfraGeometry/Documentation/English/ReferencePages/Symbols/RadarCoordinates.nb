Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"depth", " ", "=", " ", 
        RowBox[{"First", " ", "/@", " ", 
         RowBox[{"RadarCoordinates", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", 
            RowBox[{"GraphExteriorBoundary", "[", "g", "]"}], "}"}]}], 
          "]"}]}]}], "}"}], ",", "\n", "    ", 
