Cell[TextData[{
 "A vertex list as a station is read as a set only by the three-argument \
form. The two-argument form hands the list to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphDistance"]], "paclet:ref/GraphDistance"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "187769c2-2105-4fe8-b66a-0b12d2b28876"],
 ", which leaves it unevaluated with a message. A density works in both forms."
}], "ExampleText",ExpressionUUID->"09cdf474-59cc-410f-aed9-9b48262a866f"],

