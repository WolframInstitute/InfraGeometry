Cell["\<\
Three stations at three corners of the square, hexagonal and triangular \
tilings, a vertex two steps from the centre, and a shortest path from it to \
each station. Its coordinates are the lengths of the three paths, in the \
order of the stations.\
\>", "ExampleText",ExpressionUUID->"7285c996-74c9-473b-b6e4-f7380a58fa1b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"panels", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "       ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
             RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
            "]"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{"stations", " ", "=", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"FindResolvingSet", "[", "g", "]"}]}]}], "}"}], ",", "\n",
          "       ", 
         RowBox[{"{", 
          RowBox[{"site", " ", "=", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
             RowBox[{"RandomInfraPoint", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "2"}], 
              "]"}]}], ")"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraSubstrateHighlight", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"InfraWalk", "[", 
                  RowBox[{"FindShortestPath", "[", 
                   RowBox[{"g", ",", " ", "site", ",", " ", "#"}], "]"}], 
                  "]"}], " ", "&"}], " ", "/@", " ", "stations"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"stations", ",", " ", "site"}], "}"}]}], "]"}]}], 
            "]"}], ",", "\n", "        ", 
           RowBox[{"RadarCoordinates", "[", 
            RowBox[{"g", ",", " ", "stations", ",", " ", "site"}], "]"}]}], 
          "}"}]}], "]"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
           " ", "\"\<HexagonalTilingGraph\>\"", ",", 
           " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"First", " ", "/@", " ", "panels"}], "]"}], ",", " ", 
     RowBox[{"Last", " ", "/@", " ", "panels"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"574f0c1f-c94c-4a3f-93bc-f8624a9764a6"],

