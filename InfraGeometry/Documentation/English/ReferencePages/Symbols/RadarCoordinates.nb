Cell["\<\
A station may be a set of vertices, given as a density. With the rim of each \
tiling as the one station, the coordinate is the depth of each vertex. Its \
level sets are rings, and the centre lies deepest, at the radius of the \
tiling.\
\>", "ExampleText",ExpressionUUID->"3eabfd7a-5999-473e-9049-a5335bb5a569"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"panels", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "       ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
             RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
            "]"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{"depth", " ", "=", " ", 
           RowBox[{"RadarCoordinates", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", 
              RowBox[{"AssociationThread", "[", 
               RowBox[{
                RowBox[{"GraphExteriorBoundary", "[", 
                 RowBox[{"g", ",", " ", 
                  RowBox[{"Method", " ", "->", " ", "\"\<MaxDegree\>\""}]}], 
                 "]"}], ",", " ", "1"}], "]"}], "}"}]}], "]"}]}], "}"}], ",", 
         "\n", "       ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraSubstrateHighlight", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"Values", " ", "@", " ", 
              RowBox[{"KeySort", " ", "@", " ", 
               RowBox[{"GroupBy", "[", 
                RowBox[{
                 RowBox[{"Keys", "[", "depth", "]"}], ",", " ", "depth"}], 
                "]"}]}]}]}], "]"}], ",", " ", 
           RowBox[{"depth", "[", 
            RowBox[{"InfraCenter", "[", "g", "]"}], "]"}]}], "}"}]}], "]"}], ",",
        "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
           " ", "\"\<HexagonalTilingGraph\>\"", ",", 
           " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"First", " ", "/@", " ", "panels"}], "]"}], ",", " ", 
     RowBox[{"Last", " ", "/@", " ", "panels"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9e58155c-a0b5-4330-960e-da48f0e881ac"],

