Cell[TextData[{
 "A window past the eccentricity pads with ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92a3d227-a98e-4837-be77-53e4129df333"],
 ", the empty shell: at the centre of the small square tiling the \
eccentricity is 7."
}], "ExampleText",ExpressionUUID->"31f1b79b-7a3f-4e81-8b44-7632b43b046f"],

