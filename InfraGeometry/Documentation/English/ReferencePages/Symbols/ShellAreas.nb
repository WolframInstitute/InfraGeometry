Cell["\<\
The area at radius 1 is the degree: the shell of radius 1 is the \
neighbourhood, drawn here on the discretized plane.\
\>", "ExampleText",ExpressionUUID->"83e12ddc-1b9f-4b92-a0bc-e92cf63bf426"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"FindInfraShell", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "1"}], "]"}], " ", "->", " ",
           "$InfraShellColor"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c"}],
         "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"ShellAreas", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "1"}], "]"}], " ", "===", " ", 
      RowBox[{"VertexDegree", "[", 
       RowBox[{"g", ",", " ", "c"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"a3fc0b02-a469-4eee-9e21-428d569e58bb"],

