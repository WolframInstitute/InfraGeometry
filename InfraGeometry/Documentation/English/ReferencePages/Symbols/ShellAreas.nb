Cell["ShellAreas", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2920eb1e-65e9-4c52-ac44-ce831dc72c16"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ShellAreas"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ShellAreas", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49da3cb5-721e-447f-b454-191dee6b5d7d"],
 "\[LineSeparator]",
 "gives the shell-area profile {",
 StyleBox["A", "TI"],
 "(0), ",
 StyleBox["A", "TI"],
 "(1), \[Ellipsis], ",
 StyleBox["A", "TI"],
 "(",
 StyleBox["e", "TI"],
 ")} at the vertex ",
 StyleBox["v", "TI"],
 ", where ",
 StyleBox["A", "TI"],
 "(",
 StyleBox["r", "TI"],
 ") = ",
 StyleBox["V", "TI"],
 "(",
 StyleBox["r", "TI"],
 ") \[Minus] ",
 StyleBox["V", "TI"],
 "(",
 StyleBox["r", "TI"],
 " \[Minus] 1) for the ball volumes ",
 StyleBox["V", "TI"],
 " and ",
 StyleBox["e", "TI"],
 " is the eccentricity of ",
 StyleBox["v", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e486e635-4455-4866-a138-511573007d69"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ShellAreas"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ShellAreas", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "408fb063-4602-485d-9728-45aadbba4b21"],
 "\[LineSeparator]",
 "gives the single area ",
 StyleBox["A", "TI"],
 "(",
 StyleBox["r", "TI"],
 "); ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ShellAreas"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ShellAreas", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["rmin", "TI"], ",", " ", 
      StyleBox["rmax", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9362391d-3b26-40a3-9c0e-52b18f69c633"],
 " the areas for the radii ",
 StyleBox["rmin", "TI"],
 " to ",
 StyleBox["rmax", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d337fa45-c1de-4754-b767-acb5e328c95e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ShellAreas"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ShellAreas", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v1", "TI"], ",", " ", 
      StyleBox["v2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    "\[Ellipsis]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1007b63b-ffbe-472b-9005-24525f22ce6e"],
 "\[LineSeparator]",
 "gives one profile per vertex; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "badeaf12-3d05-45ef-a03b-e143e3b9935a"],
 " takes every vertex."
}], "Usage",ExpressionUUID->"56bab1ac-34b6-465f-bc09-f594fbcc8f60"],

Cell[TextData[{
 "Definition: the shell area at radius ",
 StyleBox["r", "TI"],
 " is the radial difference of the ball volume, ",
 StyleBox["A(r) = V(r) \[Minus] V(r \[Minus] 1)", "TI"],
 " with ",
 StyleBox["V(\[Minus]1) = 0", "TI"],
 ". Under the default measure it is the number of vertices of the shell ",
 StyleBox["S_r(v) = {w : d(v, w) = r}", "TI"],
 "."
}], "Notes",ExpressionUUID->"d26ead88-89d0-42fc-8daa-c671d008ff2e"],

Cell[TextData[{
 "It is the area of the geodesic sphere as the observer counts it. On a \
Riemannian manifold, ",
 StyleBox["Area S_r = \[Sigma]_(d\[Minus]1) r^(d\[Minus]1) (1 \[Minus] R \
r\.b2 / (6d) + O(r\:2074))", "TI"],
 ": the exponent is one less than the dimension, and the curvature enters \
with ",
 StyleBox["6d", "TI"],
 " where the ball has ",
 StyleBox["6(d + 2)", "TI"],
 ". The ball and the shell are therefore two independent probes of the same \
dimension and curvature."
}], "Notes",ExpressionUUID->"6d677030-07f5-4c14-8359-3d687f4db7e7"],

Cell[TextData[{
 "Under ",
 Cell[BoxData["\"\<FullCount\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23e58e75-da5e-491d-b741-611754e49f78"],
 " the profile is the coordination sequence of crystallography, and ",
 StyleBox["A(1)", "TI"],
 " is the degree of ",
 StyleBox["v", "TI"],
 ", the coordination number. On a flat lattice it is linear: ",
 StyleBox["4r", "TI"],
 " on the square grid, ",
 StyleBox["3r", "TI"],
 " on the hexagonal tiling."
}], "Notes",ExpressionUUID->"b795f325-9dde-4de5-a588-f54c6f82a1cd"],

Cell[TextData[{
 "Every option value of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallVolumes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallVolumes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b56ead01-5328-441b-a985-544e9358c541"],
 " is available, and the areas are the differences of those volumes, so ",
 Cell[BoxData["Accumulate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73336800-c6dd-4dac-be09-8ff4b5672fef"],
 " of the areas is the volume profile under the same measure. Each value is \
counted directly:"
}], "Notes",ExpressionUUID->"28da9646-0e0b-4d33-b82d-964aa620a353"],

