Cell["\<\
On a closed surface the shell does not keep growing. On the square torus it \
grows linearly, levels off once it has wrapped round the short way, and \
shrinks as it closes up on the far side.\
\>", "ExampleText",ExpressionUUID->"cd722896-355e-4a81-8c49-4172fd737f36"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Large\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"areas", " ", "=", " ", 
     RowBox[{"ShellAreas", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"First", " ", "@", " ", 
