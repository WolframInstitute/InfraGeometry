   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "707d9736-4e7c-47a1-8528-06c3354fff88"],
 "\[LineSeparator]",
 "gives the shell-area profile {",
 StyleBox["A", "TI"],
 "(0), ",
 StyleBox["A", "TI"],
 "(1), \[Ellipsis], ",
 StyleBox["A", "TI"],
 "(",
 StyleBox["e", "TI"],
 ")} at the vertex ",
 StyleBox["v", "TI"],
 ", where ",
 StyleBox["A", "TI"],
 "(",
 StyleBox["r", "TI"],
 ") = ",
 StyleBox["V", "TI"],
 "(",
 StyleBox["r", "TI"],
 ") \[Minus] ",
 StyleBox["V", "TI"],
 "(",
 StyleBox["r", "TI"],
 " \[Minus] 1) for the ball volumes ",
 StyleBox["V", "TI"],
 " and ",
 StyleBox["e", "TI"],
 " is the eccentricity of ",
 StyleBox["v", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"dd848df9-de42-4d3b-8a28-dbc1791caa4e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ShellAreas"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ShellAreas", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55320349-7d73-4cb9-addc-7246cd9b8500"],
 "\[LineSeparator]",
 "gives the single area ",
 StyleBox["A", "TI"],
 "(",
 StyleBox["r", "TI"],
 "); ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ShellAreas"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ShellAreas", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["rmin", "TI"], ",", " ", 
      StyleBox["rmax", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00b00565-9126-4919-bc60-69b675eadd21"],
 " the areas for the radii ",
 StyleBox["rmin", "TI"],
 " to ",
 StyleBox["rmax", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a5256a3d-6acd-497e-a24d-81b8e600b415"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ShellAreas"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ShellAreas", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
