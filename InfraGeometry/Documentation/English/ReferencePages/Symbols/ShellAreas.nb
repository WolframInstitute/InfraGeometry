Cell["The four measures at the centre of the square tiling.", "ExampleText",ExpressionUUID->"c35ee512-0152-4cf7-93d4-071f2238fa40"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Large\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"m", " ", "->", " ", 
      RowBox[{"ShellAreas", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "6"}], "}"}], ",", " ", 
        RowBox[{"\"\<Measure\>\"", " ", "->", " ", "m"}]}], "]"}]}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<FullCount\>\"", ",", " ", "\"\<WithoutBoundary\>\"", ",",
          " ", "\"\<HalfBoundary\>\"", ",", " ", "\"\<ExpandingFront\>\""}], 
        "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9ccfdd1c-8b02-4119-9e5e-553318635e25"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"FullCount\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "1", ",", "4", ",", "8", ",", "12", ",", "16", ",", "20", ",", "24"}], 
     "}"}]}], ",", 
   RowBox[{"\<\"WithoutBoundary\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "0", ",", "1", ",", "4", ",", "8", ",", "12", ",", "16", ",", "20"}], 
     "}"}]}], ",", 
   RowBox[{"\<\"HalfBoundary\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["1", "2"], ",", 
      FractionBox["5", "2"], ",", "6", ",", "10", ",", "14", ",", "18", ",", 
      "22"}], "}"}]}], ",", 
   RowBox[{"\<\"ExpandingFront\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "1", ",", "4", ",", "8", ",", "12", ",", "16", ",", "20", ",", "24"}], 
     "}"}]}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d80a66af-595e-4663-9587-882b7ca15e40"]
}, Open  ]]
}, Open  ]]
