  "7756afe2-d1b6-464e-bc99-bb1785048366"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"e11f05f4-0d5c-41a8-b2f7-f69628c003b4"],

Cell[TextData[{
 "The \[CapitalCHacek]ech filtration is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionFiltration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionFiltration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["radii", "TI"], ",", " ", 
    ButtonBox["Infinity",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb07b070-8c41-4b63-84b9-e217e390aa38"],
 ": the nested \[CapitalCHacek]ech complexes over the sorted radii. It takes \
the options of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallIntersectionComplex"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a0a2961e-2b3a-4ed2-b0b8-d9142a0e5baf"],
 "."
}], "Notes",ExpressionUUID->"4917ae89-6379-4a5b-b5e0-fb09f221f3d5"],

Cell[TextData[{
 "For Euclidean points a simplex enters at the radius of its smallest \
enclosing ball, its ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MiniballRadius"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/MiniballRadius", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2552ad9c-71de-41fe-8807-53966e043cef"],
 ". By the nerve theorem each complex has the homotopy type of the union of \
its balls."
}], "Notes",ExpressionUUID->"beda8fc5-4113-4447-9566-f91091c9ae39"]
}, Open  ]],

