    StyleBox["data", "TI"], ",", " ", 
    StyleBox["radii", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97a34c1f-4026-4019-825a-a7df6dcc49ec"],
 "\[LineSeparator]",
 "gives an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2dd5daee-dd10-4bb1-926c-2cea9e802259"],
 " from each radius ",
 StyleBox["r", "TI"],
 " of ",
 StyleBox["radii", "TI"],
 ", in increasing order, to the \[CapitalCHacek]ech complex ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CechComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/CechComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
