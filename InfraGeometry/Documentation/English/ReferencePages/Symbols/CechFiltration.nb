Cell[TextData[{
 "The Euler characteristic of the \[CapitalCHacek]ech complex of the lattice \
points of the ball of radius 3, against the radius. It is 25, the number of \
points, below 1/2. From 1/2 the disks meet along the 36 edges of the grid and \
the union has 12 holes, one in each square: ",
 StyleBox["25 \[Minus] 36 = 1 \[Minus] 12", "TI"],
 ". From ",
 StyleBox["\[Sqrt]2/2", "TI"],
 " the squares fill and it is 1:"
}], "ExampleText",ExpressionUUID->"93149011-3591-4018-b297-7b6a207dbf1e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "3"}], ",", " ", "3"}], "]"}], ",", " ", "2"}], "]"}],
        ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"Abs", "[", "#", "]"}], "]"}], " ", "<=", " ", "3"}], " ", 
        "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"filtration", " ", "=", " ", 
     RowBox[{"CechFiltration", "[", 
      RowBox[{"points", ",", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0.05", ",", " ", "1.2", ",", " ", "0.05"}], "]"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"KeyValueMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#1", ",", " ", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Length", " ", "/@", " ", "#2"}], " ", "-", " ", "1"}], 
             ")"}]}], "]"}]}], "}"}], " ", "&"}], ",", " ", "filtration"}], 
      "]"}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d7732507-7bfa-468e-a030-e1f49516f86c"],

