Cell[TextData[{
 "For Euclidean points a simplex enters at the radius of its smallest \
enclosing ball, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MiniballRadius"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/MiniballRadius", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ccb88981-5343-42a5-9223-5fc6f9605796"],
 ". By the nerve theorem each complex has the homotopy type of the union of \
its balls."
}], "Notes",ExpressionUUID->"30cdd5ba-ba30-4640-9dce-21c374858b36"]
}, Open  ]],

