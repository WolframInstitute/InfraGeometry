Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"16", ",", " ", "2"}], "}"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"radii", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0.02", ",", " ", "0.3", ",", " ", "0.02"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"KeyValueMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#1", ",", " ", 
            RowBox[{"Length", "[", "#2", "]"}]}], "}"}], " ", "&"}], ",", " ", 
         RowBox[{"CechFiltration", "[", 
          RowBox[{"points", ",", " ", "radii"}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<r\>\"", ",", " ", "\"\<simplices\>\""}], "}"}]}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"CechFiltration", "[", 
       RowBox[{"points", ",", " ", "radii"}], "]"}], " ", "==", " ", 
      RowBox[{"BallIntersectionFiltration", "[", 
       RowBox[{"points", ",", " ", "radii", ",", " ", "Infinity"}], "]"}]}]}],
     "}"}]}], "]"}]], "Input",
