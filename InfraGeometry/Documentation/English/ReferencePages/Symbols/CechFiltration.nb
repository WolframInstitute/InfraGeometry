Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2fa2337-44d2-43bb-9263-f1c14f73ed2c"],
 " the data are vertices of a graph. The number of simplices of the vertices \
within distance 2 of the centre of the grid, at radii 0 to 2. At radius 2 the \
centre lies within 2 of all 13 points, and every nonempty subset is a \
simplex, 2\.b9\.b3 \[Minus] 1 of them:"
}], "ExampleText",ExpressionUUID->"98f48846-fdbc-49e1-9b71-8cfb965fab10"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"data", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "2"}], "]"}], ",",
         " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Length", " ", "/@", " ", 
    RowBox[{"CechFiltration", "[", 
     RowBox[{"data", ",", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", " ", "2"}], "]"}], ",", " ", 
      RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6df79d06-7d04-4656-a8ef-e18dcbc59531"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
