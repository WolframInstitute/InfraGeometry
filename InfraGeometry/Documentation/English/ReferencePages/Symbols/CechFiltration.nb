Cell["\<\
At radius 0.15 the union of the disks has three pieces and one hole, and the \
Euler characteristic is 2.\
\>", "ExampleText",ExpressionUUID->"c933f68d-c716-458c-aca3-76c0271d0fc5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"16", ",", " ", "2"}], "}"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"complex", " ", "=", " ", 
     RowBox[{
      RowBox[{"CechFiltration", "[", 
       RowBox[{"points", ",", " ", 
