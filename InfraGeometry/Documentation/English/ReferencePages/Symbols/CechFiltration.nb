Cell["\<\
The Euler characteristic of the \[CapitalCHacek]ech complex of sixteen random \
points, the alternating count of its simplices, against the radius. It starts \
at the number of points and ends at 1. Between, it is the number of pieces of \
the union of the disks minus the number of its holes.\
\>", "ExampleText",ExpressionUUID->"f3370296-e7ec-4a7d-a8d1-02e64ca5dd5b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"16", ",", " ", "2"}], "}"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"filtration", " ", "=", " ", 
     RowBox[{"CechFiltration", "[", 
      RowBox[{"points", ",", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0.01", ",", " ", "0.4", ",", " ", "0.01"}], "]"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"KeyValueMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#1", ",", " ", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Length", " ", "/@", " ", "#2"}], " ", "-", " ", "1"}], 
             ")"}]}], "]"}]}], "}"}], " ", "&"}], ",", " ", "filtration"}], 
      "]"}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<r\>\"", ",", " ", "\"\<\[Chi]\>\""}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c494a4f7-ec11-4e44-af9a-3c656520f982"],

