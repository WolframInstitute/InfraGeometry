Cell[TextData[{
 "A simplex enters at its miniball radius. The corners of a unit square: a \
side enters at 1/2, the whole square at ",
 StyleBox["\[Sqrt]2/2 \[TildeTilde] 0.707", "TI"],
 ". The largest simplex at each radius:"
}], "ExampleText",ExpressionUUID->"25eaafd2-455f-4c2a-8b58-bfc84c0e5afd"],

