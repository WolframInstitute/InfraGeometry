 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1bb52420-e163-4aee-992a-2b27ad9dbd83"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CechFiltration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/CechFiltration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
