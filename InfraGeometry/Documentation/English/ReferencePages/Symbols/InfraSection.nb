Cell["\<\
The same inert section is read in the context of its fibered graph.\
\>", "ExampleText",ExpressionUUID->"82bfee5f-cdec-4e22-83b6-2f759ed68e4b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"Graph", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{"1", ",", " ", "3"}], "]"}], ",", " ", 
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{"2", ",", " ", "4"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<a\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<a\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<b\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<b\>\""}]}], "|>"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"section", " ", "=", " ", 
     RowBox[{"InfraSection", "[", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<a\>\"", " ", "->", " ", "1"}], ",", " ", 
        RowBox[{"\"\<b\>\"", " ", "->", " ", "3"}]}], "|>"}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", 
      RowBox[{"fib", ",", " ", "section"}], "]"}], ",", " ", 
     RowBox[{"InfraSectionQ", "[", 
      RowBox[{"fib", ",", " ", "section"}], "]"}], ",", " ", 
     RowBox[{"InfraContinuousSectionQ", "[", 
      RowBox[{"fib", ",", " ", "section"}], "]"}]}], "}"}]}], "]"}]}], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"15c19a29-ac29-4258-bce3-c15a3a3f843d"],

