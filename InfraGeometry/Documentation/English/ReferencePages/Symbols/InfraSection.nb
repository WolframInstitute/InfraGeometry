Cell["\<\
A partial section with values over 6 and 7. It is a section, but the edge 6\
\[Dash]7 does not go to a total edge, so it is not continuous:\
\>", "ExampleText",ExpressionUUID->"a51869c3-bacb-4230-a644-21f6963b3552"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GraphProduct", "[", 
        RowBox[{
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
         RowBox[{"Graph", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
           RowBox[{"{", "}"}]}], "]"}], ",", " ", "\"\<Cartesian\>\""}], 
        "]"}], ",", " ", "First"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"s", " ", "=", " ", 
     RowBox[{"InfraSection", "[", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"6", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"6", ",", " ", "1"}], "}"}]}], ",", " ", 
        RowBox[{"7", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"7", ",", " ", "2"}], "}"}]}]}], "|>"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", "s", "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraSectionQ", "[", 
         RowBox[{"fib", ",", " ", "s"}], "]"}], ",", " ", 
        RowBox[{"InfraContinuousSectionQ", "[", 
         RowBox[{"fib", ",", " ", "s"}], "]"}]}], "}"}]}], ",", "\n", "    ", 
     
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b199c88e-1106-4431-88a5-5f798726be44"],

