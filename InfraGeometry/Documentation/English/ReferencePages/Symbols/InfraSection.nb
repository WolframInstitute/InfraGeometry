Cell["\<\
The same section in the total graph: its values, with the total edges between \
them.\
\>", "ExampleText",ExpressionUUID->"0b03c77a-3995-4b2c-be65-0c842dd35b0e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
