Cell["\<\
The up field is a section, and it is continuous: every base edge between its \
keys goes to a total edge.\
\>", "ExampleText",ExpressionUUID->"74c54a7e-d398-4ad1-b655-26cff4641f48"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridDisplacementBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"up", " ", "=", " ", 
     RowBox[{"InfraSection", " ", "@", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{"p", " ", "|->", " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", 
           RowBox[{"p", " ", "+", " ", "1"}]}], "}"}]}], ",", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Range", "[", "16", "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{"#", ",", " ", "4"}], "]"}], " ", "!=", " ", "0"}], " ", 
           "&"}]}], "]"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSectionQ", "[", 
      RowBox[{"fib", ",", " ", "up"}], "]"}], ",", " ", 
     RowBox[{"InfraContinuousSectionQ", "[", 
      RowBox[{"fib", ",", " ", "up"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"beebc581-513a-4361-ae47-480b5189ff21"],

