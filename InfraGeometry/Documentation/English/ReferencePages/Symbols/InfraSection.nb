  FontSize->0.9 Inherited,ExpressionUUID->
  "c30296c9-b537-4024-8070-956c1bf90fb2"],
 "\[LineSeparator]",
 "describes a section by an association from base vertices to total vertices; \
it carries no graph.",
 "\n"
}], "Usage",ExpressionUUID->"92d79a11-6c81-4f94-8b24-d92111a1eb8a"],

Cell[TextData[{
 "The head is inert. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ce7d949f-5e14-4cf3-bcc0-74ee294e4e41"],
 " checks the right-inverse condition in a specified fibered graph."
}], "Notes",ExpressionUUID->"29ac8b7f-55c8-4d7f-8292-40d9c1475af5"],

Cell[TextData[{
 "The keys of ",
 StyleBox["s", "TI"],
 " give its domain, which may be a subset of the reconstructed base."
}], "Notes",ExpressionUUID->"e7a8d3d5-6388-4af0-9df9-589ff6f678d7"],

