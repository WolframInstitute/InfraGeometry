       RowBox[{"\<\"VerticalEdgeCount\"\>", "\[Rule]", 
        RowBox[{"{", "0", "}"}]}], ",", 
       RowBox[{"\<\"HorizontalEdgeCount\"\>", "\[Rule]", "All"}]}], "]"}], ",", 
