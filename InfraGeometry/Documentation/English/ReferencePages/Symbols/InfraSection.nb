Notebook[{

Cell[CellGroupData[{
Cell["InfraSection", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"78c49862-aa85-48c1-9675-e64c9e90f9c8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["s", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e57a4143-8b41-4222-b40b-73cc9ae216a6"],
 "\[LineSeparator]",
 "is the section given by the association ",
 StyleBox["s", "TI"],
 " from base vertices ",
 StyleBox["p", "TI"],
 " to total vertices ",
 StyleBox["s(p)", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"34b28115-81c2-413b-8647-f698da3f4bd6"],

Cell[TextData[{
 "A section of a fibered graph is a choice of one vertex in each fiber: ",
 StyleBox["\[Pi](s(p)) = p", "TI"],
 " for every ",
 StyleBox["p", "TI"],
 " in its domain, as for a section ",
 StyleBox["s : B \[RightArrow] E", "TI"],
 " of a fiber bundle. The keys of ",
 StyleBox["s", "TI"],
 " are the domain, which may be part of the base; such a section is partial."
}], "Notes",ExpressionUUID->"d3c861de-275c-4810-8301-7b023b697817"],

Cell[TextData[{
 "A section is continuous when every base edge ",
 StyleBox["pq", "TI"],
 " between keys goes to a total edge ",
 StyleBox["s(p)s(q)", "TI"],
 ". A continuous section over the whole base is a copy of the base inside the \
total graph."
}], "Notes",ExpressionUUID->"722e8b98-5f7e-4f07-91e8-6739d4c0eb31"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a47d3b37-960e-4f19-8e2d-8ab440a93753"],
 " is a symbolic object and carries no graph. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d2161c3f-4b7c-41ab-8146-0a33ace6d484"],
 " checks it against a fibered graph, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraContinuousSectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraContinuousSectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "43f64da9-0059-471b-9526-4da2acb877bb"],
 " checks continuity, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraParallelSectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelSectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2c13f37d-fae4-452e-9103-f8077c0af514"],
 " checks that it follows a connection, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a2459c0b-579d-4d96-9838-b0f024536f5b"],
 " draws one and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraphHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraphHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "627b2aad-0674-445f-bd0f-158521b46e82"],
 " draws it."
}], "Notes",ExpressionUUID->"eb05f995-1c40-4110-bfa5-1b1b0e88b278"],

Cell[TextData[{
 "The empty association gives the empty section, ",
 Cell[BoxData[
  RowBox[{"InfraSection", "[", 
   RowBox[{"<|", "|>"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "83340afa-55dd-4c86-8ccc-845ab36836ba"],
 "."
}], "Notes",ExpressionUUID->"45a431cc-47da-4e64-ad31-ef360083a3fd"],

Cell[TextData[{
 "On a covering, the holonomy of every loop at ",
 StyleBox["p", "TI"],
 " fixes the value ",
 StyleBox["s(p)", "TI"],
 " of a continuous section. So a double covering with a loop that exchanges \
the sheets has no continuous section over the whole base."
}], "Notes",ExpressionUUID->"2a0dbb34-e2a6-4efe-bbe1-8e93ea0a9c93"]
}, Open  ]],

