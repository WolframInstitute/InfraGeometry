Cell["\<\
The up field on the grid: every vertex below the top row moved one step up, a \
section of the displacement bundle at scale 1. On the grid it reads as the \
vertical edges.\
\>", "ExampleText",ExpressionUUID->"cd330b58-efc8-433d-ae2b-08114d14d070"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"InfraFiberedSubstrate", "[", 
       RowBox[{"\"\<GridDisplacementBundle\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"up", " ", "=", " ", 
     RowBox[{"InfraSection", " ", "@", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{"p", " ", "|->", " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", 
           RowBox[{"p", " ", "+", " ", "1"}]}], "}"}]}], ",", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Range", "[", "16", "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{"#", ",", " ", "4"}], "]"}], " ", "!=", " ", "0"}], " ", 
           "&"}]}], "]"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"InfraWalk", " ", "/@", " ", 
        RowBox[{"Values", " ", "@", " ", 
         RowBox[{"First", " ", "@", " ", "up"}]}]}], ",", " ", 
       RowBox[{"Directive", "[", "StandardBlue", "]"}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9e7c1f5d-cdb9-4368-8a17-71d303ff4757"],

