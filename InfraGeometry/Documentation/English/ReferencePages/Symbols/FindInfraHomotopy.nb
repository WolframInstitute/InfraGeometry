Cell[TextData[{
 "An inert ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHomotopy"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHomotopy", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["relationOptions", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c67d2109-f943-4a6e-a26b-639b53b0d949"],
 " can replace the separate input walks. Pass search options to the finder. A \
bounded search can miss a homotopy whose intermediate walks exceed its \
limits. The search budgets bound face search; exact reduction and \
free-endpoint constructions can bypass them."
}], "Notes",ExpressionUUID->"9083b9fb-722d-4592-9875-146c3ccbdc6e"]
}, Open  ]],

