Cell["\<\
On the grid there is no chain until the squares are filled; then one move \
swaps the two sides of the square:\
\>", "ExampleText",ExpressionUUID->"a7bf0fc1-1c47-455a-89c4-c81fded7a26d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FindInfraHomotopy", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"First", " ", "@", " ", "members"}], ",", " ", 
       RowBox[{"Last", " ", "@", " ", "members"}]}], "]"}], ",", "\n", "   ", 
     
     RowBox[{"Map", "[", 
      RowBox[{"Last", ",", " ", 
       RowBox[{"VertexList", " ", "/@", " ", 
        RowBox[{"FindInfraHomotopy", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"First", " ", "@", " ", "members"}], ",", " ", 
          RowBox[{"Last", " ", "@", " ", "members"}], ",", " ", 
          RowBox[{"\"\<NullHomotopicCycles\>\"", " ", "->", " ", "4"}]}], 
         "]"}]}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6e6e0d8f-aa98-4e4a-8dbb-39fe2f196231"],

