Cell[CellGroupData[{
Cell["FindInfraHomotopy", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e5fd86d0-5190-4e6e-89d8-c7a081efca25"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraHomotopy"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraHomotopy", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33d931d1-bb7b-414e-b52b-de4d611e9fbd"],
 "\[LineSeparator]",
 "gives a chain of elementary moves from the walk ",
 StyleBox["a", "TI"],
 " to the walk ",
 StyleBox["b", "TI"],
 ", as the list of walk graphs it passes through.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"fe72d6eb-377f-4bce-bb7e-724ea0c6f8d5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraHomotopy"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraHomotopy", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81e94f69-5a36-49f0-94ac-f58e36a0a861"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " chains."
}], "Usage",ExpressionUUID->"17f94cf7-eaa4-4419-9954-ace18d1b0988"],

Cell[TextData[{
 "The moves are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HomotopicQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/HomotopicQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1795e7c0-4e75-4a98-8649-cc343a64f9fd"],
 ": insert or delete a repeated vertex, insert or delete a backtrack ",
 StyleBox["u v u", "TI"],
 ", and replace an arc of a filled cycle by the rest of that cycle. Each walk \
of the chain differs from the next by one move. With the default method the \
chain has the fewest moves."
}], "Notes",ExpressionUUID->"ed3edabd-5df1-4699-82c2-75d7947baf95"],

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ebb584a-5e6f-47ea-9ce2-aefd5c1c5ac2"],
 " when there is no chain within ",
 Cell[BoxData["\"\<MaxLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ec95ef9-4018-4d59-a9b3-f16d97fb1d11"],
 ". Both walks must be open or both closed. Each walk of a chain is a \
directed path graph, or a directed cycle graph for closed walks, with \
vertices {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "}."
}], "Notes",ExpressionUUID->"38877e38-4c0a-45f4-867d-73bf1b045a04"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7b39713-95aa-4fb8-800a-8b3b179d2a80"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "118d93bf-5a73-44b1-b597-0bc0574ca70f"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "156b68b9-541b-42e3-a348-0d2ee2f7b876"],
 ". Without a count the result is one chain."
}], "Notes",ExpressionUUID->"be85d248-c548-4c26-9d26-2b0c2d7f8744"],

