Notebook[{

Cell[CellGroupData[{
Cell["FindInfraHomotopy", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"94d6cc55-fcfc-4e56-9b73-a62d9f228882"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraHomotopy"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraHomotopy", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7522c385-637e-471b-8588-62fd10c5e969"],
 "\[LineSeparator]",
 "gives a chain of elementary moves from the walk ",
 StyleBox["a", "TI"],
 " to the walk ",
 StyleBox["b", "TI"],
 ", as the list of walk graphs it passes through.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"87c54cf8-a57b-4168-a130-0caf75247842"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraHomotopy"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraHomotopy", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "267fdfb9-7a35-479a-9945-25a8a4227c50"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " chains.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"9f4a927a-6e8b-4efb-8c40-b3c15d797845"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraHomotopy"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraHomotopy", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"], ",", " ", 
    ButtonBox["Automatic",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66b591a2-9245-4ceb-9153-33b8d5b6e9de"],
 "\[LineSeparator]",
 "finds a chain to a certified shortest representative of ",
 StyleBox["walk", "TI"],
 "."
}], "Usage",ExpressionUUID->"318619f8-07c6-41c9-93a8-b411f8f6d76f"],

Cell[TextData[{
 "The moves are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HomotopicQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/HomotopicQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b7bbe8d1-0858-41f0-a2de-cd80aa1d4380"],
 ": insert or delete a repeated vertex, insert or delete a backtrack ",
 StyleBox["u v u", "TI"],
 ", and replace an arc of a filled cycle by the rest of that cycle. Each walk \
of the chain differs from the next by one move. Exact reductions can \
construct a witness directly. Otherwise ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Exhaustive\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34150512-230c-4167-90eb-a062bde0d1d8"],
 " explores the bounded state graph breadth first. Returned witnesses are not \
promised to use the fewest moves."
}], "Notes",ExpressionUUID->"dd7942c7-8275-4abb-8d85-019c03e208a6"],

Cell[TextData[{
 "The call remains unevaluated when bounded search is inconclusive. For a \
single pair, ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef7c3d3b-6eef-4a9b-8efb-a2bfccc7b71e"],
 " certifies that no homotopy exists in the specified relation. Both walks \
must be open or both closed. Each walk of a chain is a directed path graph, \
or a directed cycle graph for closed walks, with vertices {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "}."
}], "Notes",ExpressionUUID->"55f8cfd9-450c-4026-a673-c072b2447af3"],

Cell[TextData[{
 "For closed walks with ",
 Cell[BoxData[
  RowBox[{"\"\<FreeHomotopy\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75df5c3c-2496-4b89-ba83-6791a3846773"],
 ", certificates are taken modulo cyclic reparametrization. The first and \
last displayed cycles may be rotations of the supplied inputs; even a \
singleton canonical cycle can certify that two parametrizations represent the \
same free loop."
}], "Notes",ExpressionUUID->"0f4f0da4-2975-4fab-998e-d72af94f0722"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05fd04c7-6f16-4a62-b208-c75243fa6198"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba8076ea-245c-4ef3-b87b-991f6a10461f"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8e19bcf-c81d-46ba-bab7-010af54bdd32"],
 ". Without a count the result is one chain. For families of input walks, at \
most one witness is found for each pair of realisations. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd690e46-0e68-4e5f-bbb4-92543d5f15ee"],
 " collects those witnesses; it does not enumerate all possible homotopies \
between one pair. An exact integer count returns ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f1277d35-d391-461a-ab9b-b7580e03492f"],
 " on a proved shortage of witnesses and remains unevaluated if the shortage \
is unresolved."
}], "Notes",ExpressionUUID->"c75a1c6e-a042-4d65-a8a3-87a300001a68"],

