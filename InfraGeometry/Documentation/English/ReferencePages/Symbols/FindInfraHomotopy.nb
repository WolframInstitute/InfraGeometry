        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Length", " ", "@", " ", 
    RowBox[{"FindInfraHomotopy", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"First", " ", "@", " ", "members"}], ",", " ", 
      RowBox[{"Last", " ", "@", " ", "members"}], ",", " ", 
      RowBox[{"Method", " ", "->", " ", "\"\<Greedy\>\""}], ",", " ", 
      RowBox[{"\"\<NullHomotopicCycles\>\"", " ", "->", " ", "4"}]}], 
     "]"}]}]}], "]"}]], "Input",
