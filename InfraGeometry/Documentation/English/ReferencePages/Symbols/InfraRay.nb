Cell["\<\
Five rays leave 6 through 7 on a 4 \[Times] 4 grid. Two stop at the corner 4 \
after three steps, three reach the corner 16 after four.\
\>", "ExampleText",ExpressionUUID->"8e89289b-5487-4c54-a040-cef084a707e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ray", " ", "=", " ", 
     RowBox[{"InfraRay", "[", 
      RowBox[{"6", ",", " ", "7"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "ray", ",", " ", "\"\<Cardinality\>\""}], "]"}], 
     ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "ray", ",", " ", "\"\<Length\>\""}], "]"}]}], 
    "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d85d8802-8796-4ee6-84f5-4d78ace21258"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"5", ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"12562314-3de8-4b63-966b-35b37ccbef69"]
}, Open  ]],

