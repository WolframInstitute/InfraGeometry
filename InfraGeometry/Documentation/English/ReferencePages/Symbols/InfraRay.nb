Cell["InfraRay", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"eddefcdf-1d32-44da-abe6-a7242a246f53"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48bc0202-4819-4239-bd43-6e4f1f753e0c"],
 "\[LineSeparator]",
 "is the ray from ",
 StyleBox["p", "TI"],
 " through ",
 StyleBox["q", "TI"],
 ": every shortest path from ",
 StyleBox["p", "TI"],
 " through ",
 StyleBox["q", "TI"],
 " that cannot be prolonged past its last vertex. It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9e0cc28e-e134-46ea-9011-56d711377461"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1ea2a0a9-e39d-44b6-ab46-c50b08494dd7"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d322ff21-f261-4ab0-a5da-a4c3c22dc0fb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34ba66b6-fb6d-41b1-8af6-5279611e234e"],
 "\[LineSeparator]",
 "is the pencil at ",
 StyleBox["p", "TI"],
 ": every ray from ",
 StyleBox["p", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f3401fef-299f-4288-8634-96750fee59e9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c527239-8ec6-47b7-8e7b-8f49ad0f993c"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5233e1a9-feee-4246-837c-5b1ce2ff9093"],
 " is the ray construction token; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRay"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a69b6299-0a2d-4de9-99d3-f2bcee02dbb2"],
 " is the search."
}], "Usage",ExpressionUUID->"2585e6cd-3658-40c0-900b-b9a62d0ae992"],

Cell[TextData[{
 "Its graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ray", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "baf95219-9402-484b-b0ed-7a8b782d61e2"],
 " \[LongDash] is one DAG with source ",
 StyleBox["p", "TI"],
 ": the interval of shortest paths from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " glued at ",
 StyleBox["q", "TI"],
 " to ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d531d47a-83c7-4c46-9d46-923652bea013"],
 ". Its sinks are exactly the inextensible ends, so its source-to-sink chains \
are exactly the rays, and ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a541b0e6-a1df-4c94-8242-19357d41de9a"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c0c4da5-a2df-466f-9f47-a0fa15b51f93"],
 "."
}], "Notes",ExpressionUUID->"3ded33d6-3d0d-4c68-8ede-b2a68a8d4495"],

Cell[TextData[{
 "Rays to different sinks differ in length, so ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9eb456c7-7dbb-450e-87e2-e7b5f0c0777c"],
 " is a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c081832-f6b2-41a0-9984-44528f730f9f"],
 " of the lengths present."
}], "Notes",ExpressionUUID->"6ad940f4-433a-4b62-b609-18109176ef19"],

Cell[TextData[{
 "Every member begins at ",
