    RowBox[{"ray", " ", "=", " ", 
     RowBox[{"InfraRay", "[", 
      RowBox[{"6", ",", " ", "7"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "ray", ",", " ", "\"\<VertexDensity\>\""}], 
      "]"}], "[", "6", "]"}], " ", "===", " ", 
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"g", ",", " ", "ray", ",", " ", "\"\<Cardinality\>\""}], 
     "]"}]}]}], "\n", "]"}]], "Input",
