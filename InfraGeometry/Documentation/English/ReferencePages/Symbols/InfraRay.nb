Cell[CellGroupData[{
Cell["InfraRay", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"23dc67f0-1c68-40f6-982a-0c578110c205"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9af33798-e326-4ae4-b5c3-287b0617ceb5"],
 "\[LineSeparator]",
 "is the ray from ",
 StyleBox["p", "TI"],
 " through ",
 StyleBox["q", "TI"],
 ": every geodesic from ",
 StyleBox["p", "TI"],
 " through ",
 StyleBox["q", "TI"],
 " that cannot be prolonged past its last vertex. It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ecc8db51-34d4-480d-955d-5f00183d6042"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraVertexList", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5b10ad4d-e328-4fbd-ad00-8c5f59742233"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e0cf72d9-b844-4ba9-8adc-a1373490c3bd"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8bef7a69-3ffc-4e60-a6fb-dc9b046aaf7f"],
 "\[LineSeparator]",
 "is the pencil at ",
 StyleBox["p", "TI"],
 ": every ray from ",
 StyleBox["p", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"476d7c5b-1901-48f0-85f0-15781a6a7f93"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9989b0b8-9a1d-4ae5-8bbd-b2aa72e9e82f"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d2bacfdb-8e04-4fa7-b3eb-588d1932d660"],
 " is the ray construction token; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRay"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ce0a13d7-e401-4ed0-ad64-91da5efb49c9"],
 " is the search."
}], "Usage",ExpressionUUID->"210b91d1-bb26-49b0-8fea-f565b023e129"],

Cell[TextData[{
 "Its graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ray", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef379125-8eed-4282-9974-4d336ea3d1fc"],
 " \[LongDash] is one DAG with source ",
 StyleBox["p", "TI"],
 ": the geodesic interval from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " glued at ",
 StyleBox["q", "TI"],
 " to ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33e51053-1905-40f9-927a-eb669fa779cd"],
 ". Its sinks are exactly the inextensible ends, so its source-to-sink chains \
are exactly the rays, and ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34d24fd4-2238-4768-92d6-d9e08f525ae8"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e61c54d-931c-411f-97ea-62d46442536d"],
 "."
}], "Notes",ExpressionUUID->"e1ad361e-dffc-4888-9801-bfda6366e636"],

Cell[TextData[{
 "Rays to different sinks differ in length, so ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "363f90ff-2907-4f8f-824f-afaa78d9d768"],
 " is a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "edabee77-61fb-44e8-804c-fc188ec78941"],
 " of the lengths present."
}], "Notes",ExpressionUUID->"c14fd8d5-9003-41e7-98fe-bddfc34766c5"],

Cell[TextData[{
 "Every member begins at ",
 StyleBox["p", "TI"],
 ". A member is a vertex list; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraVertexList", 
    "WolframInstitute/InfraGeometry Package Symbol"},
