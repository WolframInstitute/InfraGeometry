Cell["The number of rays and their length, beside the picture.", "ExampleText",ExpressionUUID->"41cd81ef-bcb3-4331-a53b-986c0f8f3b48"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"o", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"through", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "o", ",", " ", "2"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ray", " ", "=", " ", 
     RowBox[{"InfraRay", "[", 
      RowBox[{"o", ",", " ", "through"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ray", " ", "->", " ", "$InfraRayColor"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "o", ",",
          " ", "through"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "ray", ",", " ", "\"\<Cardinality\>\""}], "]"}], 
     ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "ray", ",", " ", "\"\<Length\>\""}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"890d7c35-e86f-4760-9ead-ad3984bd2403"],

