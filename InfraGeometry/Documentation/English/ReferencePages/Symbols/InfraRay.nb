   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c6455419-2a02-401b-beb0-a90c453bec8d"],
 " reads one, several or all of them."
}], "Notes",ExpressionUUID->"7febcc75-acee-4806-b117-1fa038373e24"]
