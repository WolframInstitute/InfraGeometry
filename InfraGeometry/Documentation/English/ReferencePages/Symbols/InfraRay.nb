Cell["\<\
Five rays leave 6 through 7 on a 4 \[Times] 4 grid. Two stop at the corner 4 \
after three steps, three reach the corner 16 after four.\
\>", "ExampleText",ExpressionUUID->"d44f2d15-5b49-480a-b118-5ffd038ff1ad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ray", " ", "=", " ", 
     RowBox[{"InfraRay", "[", 
      RowBox[{"6", ",", " ", "7"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "ray", ",", " ", "\"\<Cardinality\>\""}], "]"}], 
     ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "ray", ",", " ", "\"\<Length\>\""}], "]"}]}], 
    "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b048bd3a-bd3c-4666-b326-f05a2ad875c5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"5", ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"b796d3d6-564f-443c-8e36-b58a926f9bda"]
}, Open  ]],

