  FontSize->0.9 Inherited,ExpressionUUID->
  "5d0e4163-8a07-447a-8130-d404e03fbee7"],
 "\[LineSeparator]",
 "is the pencil at ",
 StyleBox["p", "TI"],
 ": every ray from ",
 StyleBox["p", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"73991354-3d43-4ca5-9829-e32db2daaa12"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRay"]], 
