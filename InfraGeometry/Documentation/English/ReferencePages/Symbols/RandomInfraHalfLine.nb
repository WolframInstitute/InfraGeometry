Cell[TextData[{
 "A ray from ",
 StyleBox["p", "TI"],
 " through ",
 StyleBox["q", "TI"],
 " is a shortest path ",
 StyleBox["p = v\:2080, \[Ellipsis], q, \[Ellipsis], v\:2096 = e", "TI"],
 " with ",
 StyleBox["d(p, e) = k", "TI"],
 " that no edge prolongs: no neighbour of ",
 StyleBox["e", "TI"],
 " is farther from ",
 StyleBox["p", "TI"],
 " than ",
 StyleBox["e", "TI"],
 ". The predicate is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraHalfLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraHalfLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "48b5084f-2bdc-4acc-be3c-c456d9a4ad84"],
 "."
}], "Notes",ExpressionUUID->"efab2535-7a43-452a-8e6d-1e17cafdf9a1"],

Cell["\<\
The rays of a direction end at different distances. On a finite substrate \
they end on the rim.\
\>", "Notes",ExpressionUUID->"fb48f485-2ff7-4194-a92f-82e2cdd7b53a"],

