}], "Notes",ExpressionUUID->"ba944c59-ff30-4abb-99d6-75fdf16646ea"],

Cell[TextData[{
 "With vertex arguments the ray is a random shortest path to ",
 StyleBox["q", "TI"],
 ", prolonged one random outward step at a time. This draw is not uniform \
over the rays. The ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraHalfLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraHalfLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "be634419-74bd-4f87-ab05-336d1c77fcda"],
 " form draws uniformly."
}], "Notes",ExpressionUUID->"faa88c57-4ab4-493b-9702-5d042f308b45"],

