       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"DisplacementSingleValuedQ", "[", 
    RowBox[{"FindKillingDisplacement", "[", "g", "]"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f3e6cdcd-2c23-423b-8204-9de3498a5b99"],

