Cell[TextData[{
 StyleBox["D", "TI"],
 " is single-valued when ",
 StyleBox["|D(v)| = 1", "TI"],
 " for every vertex ",
 StyleBox["v", "TI"],
 ". It is then a map of the vertices."
}], "Notes",ExpressionUUID->"8f2dda62-8501-4ec3-8fd0-2a5a69645e95"],

Cell[TextData[{
 "A displacement is set-valued where the metric or the coordinates do not \
decide between several vertices. Composition keeps single values; the \
inverse, the negative, scaling and the sum do not in general. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementReduce"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementReduce", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "48295a98-7e4a-42cb-a661-bb773be1d4c1"],
 " contracts the sets the metric decides."
}], "Notes",ExpressionUUID->"5eb89d4f-fe60-4c45-ada0-381d5fd011dc"],

Cell["An empty value is not a single vertex.", "Notes",ExpressionUUID->"48cb648a-0fbb-43aa-af84-153bcd460bb8"]
}, Open  ]],

