Cell["\<\
On the square tiling a random displacement is single-valued; the outward \
radial displacement is not, since a vertex off the axes has two neighbours \
further out.\
\>", "ExampleText",ExpressionUUID->"cd485cf7-992c-4b7c-89aa-52c9e11171d9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"field", " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"RandomDisplacement", "[", 
         RowBox[{"g", ",", " ", "2"}], "]"}]}], ")"}]}], ",", " ", 
     RowBox[{"radial", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"PolarDisplacements", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCenter", "[", "g", "]"}]}], "]"}]}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"DisplacementPlot", "[", 
         RowBox[{"g", ",", " ", "field"}], "]"}], ",", " ", 
        RowBox[{"DisplacementPlot", "[", 
         RowBox[{"g", ",", " ", "radial"}], "]"}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"DisplacementSingleValuedQ", "[", "field", "]"}], ",", " ", 
     RowBox[{"DisplacementSingleValuedQ", "[", "radial", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d5d6186f-dcd8-4754-9725-75220f362f07"],

