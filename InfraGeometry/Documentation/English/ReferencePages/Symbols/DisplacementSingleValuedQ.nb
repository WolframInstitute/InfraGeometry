Cell["\<\
A translation of the hexagonal tiling by a vector of its lattice is \
single-valued. Half of a step of the square tiling lands between two \
vertices, and both are kept.\
\>", "ExampleText",ExpressionUUID->"5116c235-241f-42db-b3fb-b3d8adfff160"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"hexagonal", " ", "=", " ", 
      RowBox[{"InfraSubstrate", "[", 
       RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
         " ", 
        RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
       "]"}]}], ",", " ", 
     RowBox[{"square", " ", "=", " ", 
      RowBox[{"InfraSubstrate", "[", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
        " ", 
        RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"whole", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"hexagonal", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"3", "/", "2"}], ",", " ", 
          RowBox[{
           RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}]}], "}"}]}], "]"}]}], ",",
      " ", 
     RowBox[{"half", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"square", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "2"}], ",", " ", 
          RowBox[{"1", "/", "2"}]}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"DisplacementPlot", "[", 
         RowBox[{"hexagonal", ",", " ", "whole"}], "]"}], ",", " ", 
        RowBox[{"DisplacementPlot", "[", 
         RowBox[{"square", ",", " ", "half"}], "]"}]}], "}"}], "]"}], ",", 
     " ", 
     RowBox[{"DisplacementSingleValuedQ", "[", "whole", "]"}], ",", " ", 
     RowBox[{"DisplacementSingleValuedQ", "[", "half", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a9fa19bf-617f-4359-85ae-b2d3954a7d0d"],

