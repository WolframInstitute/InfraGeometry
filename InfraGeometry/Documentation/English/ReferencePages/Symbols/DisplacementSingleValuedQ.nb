Cell["A composite of single-valued displacements is single-valued:", \
"ExampleText",ExpressionUUID->"342b025b-a591-432c-9241-abac1cefb513"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"d1", " ", "=", " ", 
      RowBox[{"RandomDisplacement", "[", 
       RowBox[{"g", ",", " ", "1", ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], ",", " ", 
     RowBox[{"d2", " ", "=", " ", 
      RowBox[{"RandomDisplacement", "[", 
       RowBox[{"g", ",", " ", "2", ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"DisplacementSingleValuedQ", "[", 
    RowBox[{"DisplacementCompose", "[", 
     RowBox[{"d1", ",", " ", "d2"}], "]"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"bd3c68dc-1411-4d55-b10a-47a1dd26579b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"4e0d31ae-1f9e-4ff8-b8ce-5f54f9c4024b"]
}, Open  ]],

Cell["A symmetry of the graph is single-valued:", "ExampleText",ExpressionUUID->"3c4ca1b4-aac1-4eab-9b15-7f5d719801e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
