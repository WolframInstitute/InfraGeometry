Cell["\<\
A translation can tie. At the pendant vertices 81 and 90, at the right end of \
the bottom and the top rows of the grid, the translated point is equally near \
two vertices:\
\>", "ExampleText",ExpressionUUID->"b834b70a-a3de-449f-81f3-08a7d3a8dbca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"right", " ", "=", " ", 
     RowBox[{"TranslationDisplacement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementSingleValuedQ", "[", "right", "]"}], ",", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"right", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "#", "]"}], " ", ">", " ", "1"}], " ", 
        "&"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"dea25040-7bf8-4575-835d-9c881561cbd2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"81", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"81", ",", "92"}], "}"}]}], ",", 
     RowBox[{"90", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"90", ",", "99"}], "}"}]}]}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"cdf265f9-1326-47e5-8c27-77116e782f7e"]
}, Open  ]],

Cell["\<\
An empty value is not single. The inverse of the step right is empty where \
nothing arrives:\
\>", "ExampleText",ExpressionUUID->"31f230b2-0d5b-4191-9112-f9961441aa73"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inverse", " ", "=", " ", 
     RowBox[{"DisplacementInverse", "[", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementSingleValuedQ", "[", "inverse", "]"}], ",", " ", 
     RowBox[{"Count", "[", 
      RowBox[{"inverse", ",", " ", 
       RowBox[{"{", "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3f1041c4-06ae-4c4a-b00b-10d6922c0bca"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "10"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"7be3d5e2-6b72-4b3e-a319-042e6861c22c"]
}, Open  ]]
}, Open  ]],

