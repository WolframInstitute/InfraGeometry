Cell["\<\
The outward radial displacement is not: a vertex of the grid off the axes \
through the centre has two neighbours further out:\
\>", "ExampleText",ExpressionUUID->"c1e25899-9b67-44c3-b9bc-ce28d3ed4013"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"radial", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"PolarDisplacements", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", "radial", ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"DisplacementSingleValuedQ", "[", "radial", "]"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0d4e5248-3f36-47c2-878d-f1bd607fefaa"],

