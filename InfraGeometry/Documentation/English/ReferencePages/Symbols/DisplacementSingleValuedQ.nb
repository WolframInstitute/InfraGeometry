Cell[CellGroupData[{
Cell["DisplacementSingleValuedQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"14035790-25f5-477c-8bf2-cfb8048fee94"],
 Cell[BoxData[
  RowBox[{"DisplacementSingleValuedQ", "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43d00a26-ac4c-4cd5-9847-35d3a81106c5"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "162019de-15d2-41fb-87fd-baf421b75714"],
 " when every value of the displacement ",
 StyleBox["d", "TI"],
 " is a single vertex, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "01b616a4-dee8-4017-9a84-b7a04c21eb34"],
 " otherwise.",
 "\n"
}], "Usage",ExpressionUUID->"0eeff1c8-8d5a-4ce6-ad21-82f9ed5d518c"],

Cell[TextData[{
 "Definition: ",
 StyleBox["D", "TI"],
 " is single-valued when ",
 StyleBox["|D(v)| = 1", "TI"],
 " for every vertex ",
 StyleBox["v", "TI"],
 ". It is then a map of the vertices."
}], "Notes",ExpressionUUID->"d3e9302b-c524-46c8-b7e9-797b86b9286b"],

Cell[TextData[{
 "A displacement is set-valued by design: where the metric does not decide \
between several vertices, all are kept. Composition preserves single values; \
the inverse, the negative, scaling and the sum do not in general. ",
 Cell[BoxData["DisplacementReduce"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "775aa4c5-afc1-49b3-a0d8-022469844611"],
 " contracts the ties the metric breaks."
}], "Notes",ExpressionUUID->"b89c0767-60df-469d-b662-20ffdad7dfab"],

Cell["\<\
An empty value is not a single vertex, so the inverse of a map that is not \
onto is not single-valued.\
\>", "Notes",ExpressionUUID->"1a287e01-96f0-4414-b50e-ae41ae23fc03"]
}, Open  ]],

