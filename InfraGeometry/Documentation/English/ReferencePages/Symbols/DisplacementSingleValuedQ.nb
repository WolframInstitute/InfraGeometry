Cell[TextData[{
 "A symmetry of a graph, as ",
 Cell[BoxData["FindKillingDisplacement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f4e39f5-5ae3-4eac-a991-393a58a22037"],
 " gives it, is single-valued."
}], "ExampleText",ExpressionUUID->"81b76e97-df2c-4ba2-90b6-5c6de97b63b1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"killing", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", "killing"}], "]"}], ",", " ", 
     RowBox[{"DisplacementSingleValuedQ", "[", "killing", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8fd5a0a4-9d2a-459b-9339-ea8a0d2ce7df"],

