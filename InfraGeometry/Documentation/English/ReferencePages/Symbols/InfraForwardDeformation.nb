     "ce07788f-270a-449b-9c18-d605b98ba1e0"]], "TableText",ExpressionUUID->
     "f5585b70-6cc6-40d8-81b8-31f6c14f873a"], Cell[TextData[{
     "nonnegative integer distance from the reference vertex set, or ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0f922b0b-cd09-4987-8be4-ba8382f74763"]
    }], "TableText",ExpressionUUID->"20fafe49-2ffa-4a21-ab98-36081e65d03e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "31272afa-dcb3-4327-a99b-4438a31154bb"], Cell[TextData[Cell[
    BoxData["\"\<FirstArrival\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6693f3c6-bf9a-4295-aec1-b46a97638ced"]], "TableText",ExpressionUUID->
     "2323f4e2-bf1c-4c42-b46f-7ded1cf2c257"], Cell[TextData[Cell[BoxData[
    "True"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "8c05066d-f3ba-4ce8-9f94-ea35bef82760"]], "TableText",ExpressionUUID->
     "3fd64141-38c0-4213-a210-cfbe046c8972"], Cell[TextData[{
     "stop at the first visit to the target; ",
