2a73c3621491"],

Cell["The bounds are nonnegative integers.", "Notes",ExpressionUUID->"0caa7408-d619-46e7-9009-bfdc23046343"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "54a1b6c6-4c7a-47e4-bdfb-2439bfcf989b"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"0e647c70-52e8-4eba-b2ab-a0c77509b54f"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"0d378873-a5a7-4aad-9a0e-8da617716a68"],
     Cell["Meaning", "TableText",
     FontWeight->Bold,ExpressionUUID->"affa7195-3fb3-49da-988e-7e058597885d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9fc3b980-3ede-4c4f-8eef-63739b375c90"], Cell[TextData[Cell[
    BoxData["\"\<TubeRadius\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c6cdd7f8-b026-4dc0-b79b-aefd8c69b37c"]], "TableText",ExpressionUUID->
