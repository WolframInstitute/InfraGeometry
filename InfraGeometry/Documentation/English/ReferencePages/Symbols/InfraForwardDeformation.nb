Notebook[{

Cell[CellGroupData[{
Cell["InfraForwardDeformation", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cd707f37-106f-4ed7-82bc-4326e68da3bc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraForwardDeformation"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraForwardDeformation", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["reference", "TI"], ",", " ", 
    StyleBox["excess", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "923c1f3a-b9fe-4d07-a7d2-242f39461fcf"],
 "\[LineSeparator]",
 "represents forward walks near the shortest path ",
 StyleBox["reference", "TI"],
 ", with the specified excess length.",
 "\n"
}], "Usage",ExpressionUUID->"9425cc79-ccaa-4584-8b81-566ea1327fe5"],

Cell[TextData[{
 "The object is inert. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraForwardDeformation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraForwardDeformation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f167ebca-af24-45f4-8f1a-e576254aed58"],
 " finds its walks on a substrate; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "27e7864e-e391-4398-86f9-ca01bddba36b"],
 " reads its graph, cardinality, lengths and visit densities. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "276077bc-e497-493b-8d8d-48c4d744ec13"],
 " tests whether a complete vertex-list walk belongs to the family."
}], "Notes",ExpressionUUID->"42da873a-db78-41a6-8a20-47fc011cac97"],

Cell[TextData[{
 "The substrate must be a simple undirected unweighted graph, and ",
 StyleBox["reference", "TI"],
 " a vertex list forming a shortest path from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 ". Write ",
 StyleBox["L = d(a,b)", "TI"],
 ". A forward walk never decreases its distance from ",
 StyleBox["a", "TI"],
 ". It stays within the graph-distance tube about the vertex set of ",
 StyleBox["reference", "TI"],
 " and ends at ",
 StyleBox["b", "TI"],
 "."
}], "Notes",ExpressionUUID->"f86059a3-3b66-47d2-8862-8b010a06c062"],

Cell[TextData[{
 "Each forward walk has exactly ",
 StyleBox["L", "TI"],
 " steps between successive distance shells. Its remaining steps stay in one \
shell, so their number is its excess length over ",
 StyleBox["L", "TI"],
 ". Vertices and edges may repeat."
}], "Notes",ExpressionUUID->"685d3624-9e87-42e2-b84e-1f4f87da111c"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "04d35213-7488-4591-bb4b-5d3fe35a2011"], Cell[
    "Excess specification", "TableText",
     FontWeight->Bold,ExpressionUUID->"4aeb1ad9-1acf-4e32-a821-0e911c61b4b4"],
