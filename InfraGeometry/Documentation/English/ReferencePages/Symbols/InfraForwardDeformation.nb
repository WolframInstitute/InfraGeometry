       RowBox[{"{", "0", "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "family", ",", " ", "\"\<VertexDensity\>\""}], 
      "]"}], ",", " ", 
     RowBox[{"InfraMemberQ", "[", 
      RowBox[{"g", ",", " ", "family", ",", " ", 
