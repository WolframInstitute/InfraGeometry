Cell["\<\
The two shortest routes around a square lie in the radius-1 tube:\
\>", "ExampleText",ExpressionUUID->"c2983d08-461e-44f0-995e-7a4f59071fce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "4", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"family", " ", "=", " ", 
     RowBox[{"InfraForwardDeformation", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", "0", "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"g", ",", " ", "family", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Cardinality\>\"", ",", " ", "\"\<Length\>\""}], "}"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7f933504-a396-480a-aa38-373e8604ce92"],

Cell[BoxData[
