Cell[CellGroupData[{
Cell["InfraParallelTransport", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"803950fc-70e7-4aef-ae73-78a9a8beaa84"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["conn", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "651de396-e9eb-46a1-9f89-85f61ec61196"],
 "\[LineSeparator]",
 "gives the parallel transport along the base walk ",
 StyleBox["walk", "TI"],
 " for the connection ",
 StyleBox["conn", "TI"],
 ": the association from each vertex of the first fiber to the end of its \
horizontal lift.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"cd625281-a08a-484d-a184-30534de9c0e0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8485b0c0-03b6-41ae-8975-463e17a8b680"],
 "\[LineSeparator]",
 "gives the list of Levi-Civita transports along ",
 StyleBox["walk", "TI"],
 " in the displacement bundle of ",
 StyleBox["g", "TI"],
 " at scale ",
 StyleBox["r", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ffc1bb98-3044-4db4-a020-5349e4b55741"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["conn", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d6dad68-2396-4b14-8308-8c79b731597f"],
 "\[LineSeparator]",
 "gives the transport along ",
 StyleBox["walk", "TI"],
 " for a partial connection ",
 StyleBox["conn", "TI"],
 " of the displacement bundle, leaving out the directions whose lift is \
blocked."
}], "Usage",ExpressionUUID->"938c0e48-4229-4ba3-b46d-b829f359cd70"],

Cell[TextData[{
 "For a walk ",
 StyleBox["\[Gamma]", "TI"],
 " from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " the transport is the map ",
 StyleBox["\[Tau]_\[Gamma] : F\:209a \[RightArrow] F_q", "TI"],
 " sending ",
 StyleBox["x", "TI"],
 " to the end of the horizontal lift of ",
 StyleBox["\[Gamma]", "TI"],
 " from ",
 StyleBox["x", "TI"],
 ". For a complete connection it is a bijection."
}], "Notes",ExpressionUUID->"b65286c4-5a0d-4a67-8071-048b18fb0186"],

Cell[TextData[{
 "Transport composes along walks, ",
 StyleBox["\[Tau]", "TI"],
 StyleBox["{\[Gamma]\[Delta]} = \[Tau]", "TI", "TI"],
 StyleBox["\[Delta] \[SmallCircle] \[Tau]_\[Gamma]", "TI"],
 "; the reversed walk gives the inverse map, and a walk of length 0 the \
identity. Transports along two walks with the same ends differ iff the loop \
formed by them has a nontrivial holonomy."
}], "Notes",ExpressionUUID->"4d4fb6d7-190f-486f-a3c5-c699f5d22d5c"],

Cell[TextData[{
 "The connection must satisfy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "eac0a6fd-6ebc-4488-a707-9ea06277c38f"],
 ". Otherwise the call stays unevaluated."
}], "Notes",ExpressionUUID->"a2cda6cb-5255-4691-b07c-4b83b4417dea"],

Cell[TextData[{
 "In the displacement bundle at scale ",
 StyleBox["r", "TI"],
 " the fiber over ",
 StyleBox["p", "TI"],
 " is the sphere ",
 StyleBox["S\:1d63(p)", "TI"],
 ". Over each step ",
 StyleBox["p \[RightArrow] q", "TI"],
 ", the Levi-Civita transports are the injections ",
 StyleBox["S\:1d63(p) \[RightArrow] S\:1d63(q)", "TI"],
 " that best preserve the angles between directions, with the directions \
along a geodesic through ",
 StyleBox["q", "TI"],
 " sent to their straightest continuation. There are usually several; the \
result lists every composite along the walk."
}], "Notes",ExpressionUUID->"770e96d3-804e-42b0-9a0d-1cec5095e0a3"],

Cell["Option of the displacement-bundle form:", "Notes",ExpressionUUID->"93fc3aff-972e-4536-b2df-9ea64af99248"],

