Cell["\<\
The displacement bundle of the 4 \[Times] 4 grid at scale 1, its fibers the \
four directions at a vertex. The Levi-Civita transports over the step from 6 \
to 7:\
\>", "ExampleText",ExpressionUUID->"eaa67a94-edfa-46ec-9f59-00a24d8f277d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraParallelTransport", "[", 
  RowBox[{
   RowBox[{"InfraDisplacementBundle", "[", 
    RowBox[{
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", "1"}], "]"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"6", ",", " ", "7"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9439dc26-f989-4942-881f-ee8175e2357b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"6", ",", "2"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"7", ",", "3"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"6", ",", "5"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"7", ",", "6"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"6", ",", "7"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"7", ",", "8"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"6", ",", "10"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"7", ",", "11"}], "}"}]}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"6", ",", "2"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"7", ",", "11"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"6", ",", "5"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"7", ",", "6"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"6", ",", "7"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"7", ",", "8"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"6", ",", "10"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"7", ",", "3"}], "}"}]}]}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"3f9818f4-df33-4933-91f6-74035512710b"]
}, Open  ]],

Cell["\<\
With the Levi-Civita connection of the grid, transport around a square is the \
identity:\
\>", "ExampleText",ExpressionUUID->"57086a73-e3ba-4808-a225-277e101115c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraDisplacementBundle", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", "1"}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"InfraParallelTransport", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "6", ",", " ", "7", ",", " ", "11", ",", " ", "10", ",", " ", "6"}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9255c799-154e-4219-988f-8c286a83e521"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"6", ",", "2"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"6", ",", "2"}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"6", ",", "5"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"6", ",", "5"}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"6", ",", "7"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"6", ",", "7"}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"6", ",", "10"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"6", ",", "10"}], "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"3cca146d-9243-4e52-81b4-fff90e5e7f66"]
}, Open  ]]
}, Open  ]],

