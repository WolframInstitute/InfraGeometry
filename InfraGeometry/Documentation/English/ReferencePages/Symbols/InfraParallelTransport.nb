Cell["\<\
The two lifts of the base cycle exchange the sheets of a double covering.\
\>", "ExampleText",ExpressionUUID->"28124e6c-b106-44f8-a0e8-55191acba416"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"fib", " ", "=", " ", 
      RowBox[{"InfraFiberedGraph", "[", " ", 
       RowBox[{"total", ",", " ", 
        RowBox[{"vertex", " ", "|->", " ", 
         RowBox[{"Mod", "[", " ", 
          RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
       " ", "]"}]}], ",", "\n", "    ", 
     RowBox[{"connection", " ", "=", " ", 
      RowBox[{"InfraConnection", "[", " ", 
       RowBox[{"EdgeList", " ", "@", " ", "total"}], " ", "]"}]}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"loop", " ", "=", " ", 
     RowBox[{"{", " ", 
      RowBox[{
      "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "1"}], " ", 
      "}"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"lifts", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraHorizontalLift", "[", " ", 
        RowBox[{
        "fib", ",", " ", "connection", ",", " ", "#", ",", " ", "loop"}], " ",
         "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", " ", 
       RowBox[{"1", ",", " ", "5"}], " ", "}"}]}]}], " ", "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"InfraWalk", " ", "/@", " ", "lifts"}]}], " ", "]"}], ",", 
     "\n", "    ", 
     RowBox[{"InfraParallelTransport", "[", " ", 
      RowBox[{"fib", ",", " ", "connection", ",", " ", "loop"}], " ", "]"}]}],
     " ", "}"}]}], "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7fd43335-f5bb-46fc-8abe-f287f6c98a5d"],

