Cell["\<\
The reverse transport is the inverse map. A zero-length walk is the identity.\
\
\>", "ExampleText",ExpressionUUID->"f2cb74e3-f554-490c-8710-ea5ff41dd7db"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"fib", " ", "=", " ", 
      RowBox[{"InfraFiberedGraph", "[", " ", 
       RowBox[{"total", ",", " ", 
        RowBox[{"vertex", " ", "|->", " ", 
         RowBox[{"Mod", "[", " ", 
          RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
       " ", "]"}]}], ",", "\n", "    ", 
     RowBox[{"connection", " ", "=", " ", 
      RowBox[{"InfraConnection", "[", " ", 
       RowBox[{"EdgeList", " ", "@", " ", "total"}], " ", "]"}]}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"walk", " ", "=", " ", 
     RowBox[{"{", " ", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], " ", "}"}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"forward", " ", "=", " ", 
      RowBox[{"InfraParallelTransport", "[", " ", 
       RowBox[{"fib", ",", " ", "connection", ",", " ", "walk"}], " ", 
       "]"}]}], ",", "\n", "    ", 
     RowBox[{"backward", " ", "=", " ", 
      RowBox[{"InfraParallelTransport", "[", " ", 
       RowBox[{"fib", ",", " ", "connection", ",", " ", 
        RowBox[{"Reverse", " ", "@", " ", "walk"}]}], " ", "]"}]}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"KeyValueMap", "[", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{"source", ",", " ", "target"}], " ", "}"}], " ", "|->", " ", 
         RowBox[{
          RowBox[{"Lookup", "[", " ", 
           RowBox[{"backward", ",", " ", 
            RowBox[{"Key", " ", "@", " ", "target"}]}], " ", "]"}], " ", "===",
           " ", "source"}]}], ",", " ", "forward"}], " ", "]"}]}], ",", "\n", 
     "    ", 
     RowBox[{"InfraParallelTransport", "[", " ", 
      RowBox[{"fib", ",", " ", "connection", ",", " ", 
       RowBox[{"{", " ", "1", " ", "}"}]}], " ", "]"}]}], " ", "}"}]}], "\n", 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"325a4040-7c01-42a2-ac64-718c952f0e93"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"1", "\[Rule]", "1"}], ",", 
     RowBox[{"5", "\[Rule]", "5"}]}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"5789fa32-65ab-4111-beec-4becab2caffc"]
}, Open  ]]
}, Open  ]],

