Cell["\<\
The Levi-Civita transports of the directions at 1 around a face of the \
octahedron. There are four, each drawn as the face with every direction \
joined to its image.\
\>", "ExampleText",ExpressionUUID->"67d61c23-3eae-4a89-ad8b-f45ad1722fbc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"oct", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", "fib"}]}], ",", " ", 
     RowBox[{"face", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "1"}], "}"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"transports", " ", "=", " ", 
     RowBox[{"InfraParallelTransport", "[", 
      RowBox[{"fib", ",", " ", "face"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", "\n", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"oct", ",", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"InfraWalk", "[", "face", "]"}], ",", " ", 
            RowBox[{"Directive", "[", "StandardBlue", "]"}]}], "}"}], ",", 
          "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"InfraWalk", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Last", " ", "@", " ", 
                RowBox[{"First", " ", "@", " ", "#"}]}], ",", " ", 
               RowBox[{"Last", " ", "@", " ", 
                RowBox[{"Last", " ", "@", " ", "#"}]}]}], "}"}], "]"}], " ", 
            "&"}], " ", "/@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Normal", " ", "@", " ", "#"}], ",", " ", 
