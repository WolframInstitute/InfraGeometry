Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1239cf7e-eea4-429f-933b-a78f16ad4813"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["connection", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "119ba59f-dfca-4b47-b48b-536d34dfdbfe"],
 "\[LineSeparator]",
 "gives the total fiber bijection along a base walk as an association from \
each starting vertex to the endpoint of its horizontal lift.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e8688cda-b7f2-426e-a22c-49fb38c4bd72"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["graph", "TI"], ",", " ", 
      StyleBox["radius", "TI"]}], "]"}], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "689e210d-9a04-4e7d-af1a-e881c58f323e"],
 "\[LineSeparator]",
 "gives the list of metric-selected transports in the Experimental \
displacement-bundle model.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d9a9de42-4fd3-4e81-ac71-e5545fec1fc3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
