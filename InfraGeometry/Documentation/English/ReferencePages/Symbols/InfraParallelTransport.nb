Cell["\<\
So the transports from 6 to 11 along the two sides of the square differ:\
\>", "ExampleText",ExpressionUUID->"d7a061ca-9880-41a0-bbab-2595ccab30b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", "\n", "    ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Covering\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraParallelTransport", "[", 
      RowBox[{"fib", ",", " ", "conn", ",", " ", 
       RowBox[{"{", 
        RowBox[{"6", ",", " ", "7", ",", " ", "11"}], "}"}]}], "]"}], ",", 
     " ", 
     RowBox[{"InfraParallelTransport", "[", 
      RowBox[{"fib", ",", " ", "conn", ",", " ", 
       RowBox[{"{", 
        RowBox[{"6", ",", " ", "10", ",", " ", "11"}], "}"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ce87bddb-08d7-4dc7-b0be-7866e07cab2c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"6", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"11", ",", "2"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"6", ",", "2"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"11", ",", "1"}], "}"}]}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"6", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"11", ",", "1"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"6", ",", "2"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"11", ",", "2"}], "}"}]}]}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"032d3369-6893-49c0-9a06-4149ceba8b29"]
}, Open  ]]
