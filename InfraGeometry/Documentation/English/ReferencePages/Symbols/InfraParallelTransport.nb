Notebook[{

Cell[CellGroupData[{
Cell["InfraParallelTransport", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f066fbd9-5ba7-4e48-ab42-cab8057e5e36"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["conn", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c525838-fd66-4cac-96d6-932d26567d60"],
 "\[LineSeparator]",
 "gives the transport <|x -> y, \[Ellipsis]|> along walk of the fiber over \
its first vertex; blocked vertices are dropped.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"24e8138d-3350-4967-ad33-7ea3f5c75fb5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46868002-7bce-4e9a-82cc-643f7668a380"],
 "\[LineSeparator]",
 "gives the Levi-Civita transports along walk, a list with one transport for \
each choice among the best angle-isometries over its edges."
}], "Usage",ExpressionUUID->"8f07d05b-0eea-4e1e-964b-b4db8d9e42d6"]
}, Open  ]],

