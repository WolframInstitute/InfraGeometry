Cell["\<\
The reverse transport is the inverse map. A zero-length walk is the identity.\
\
\>", "ExampleText",ExpressionUUID->"9abe408b-64ff-43d7-b24f-9e65af5989d6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"fib", " ", "=", " ", 
      RowBox[{"InfraFibration", "[", " ", 
       RowBox[{"total", ",", " ", 
        RowBox[{"vertex", " ", "|->", " ", 
         RowBox[{"Mod", "[", " ", 
          RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
       " ", "]"}]}], ",", "\n", "    ", 
     RowBox[{"connection", " ", "=", " ", 
      RowBox[{"InfraConnection", "[", " ", 
       RowBox[{"EdgeList", " ", "@", " ", "total"}], " ", "]"}]}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"walk", " ", "=", " ", 
     RowBox[{"{", " ", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], " ", "}"}]}], " ", "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"forward", " ", "=", " ", 
      RowBox[{"InfraParallelTransport", "[", " ", 
       RowBox[{"fib", ",", " ", "connection", ",", " ", "walk"}], " ", 
       "]"}]}], ",", "\n", "    ", 
     RowBox[{"backward", " ", "=", " ", 
      RowBox[{"InfraParallelTransport", "[", " ", 
       RowBox[{"fib", ",", " ", "connection", ",", " ", 
        RowBox[{"Reverse", " ", "@", " ", "walk"}]}], " ", "]"}]}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"KeyValueMap", "[", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{"source", ",", " ", "target"}], " ", "}"}], " ", "|->", " ", 
         RowBox[{
          RowBox[{"Lookup", "[", " ", 
           RowBox[{"backward", ",", " ", 
            RowBox[{"Key", " ", "@", " ", "target"}]}], " ", "]"}], " ", "===",
           " ", "source"}]}], ",", " ", "forward"}], " ", "]"}]}], ",", "\n", 
     "    ", 
     RowBox[{"InfraParallelTransport", "[", " ", 
      RowBox[{"fib", ",", " ", "connection", ",", " ", 
       RowBox[{"{", " ", "1", " ", "}"}]}], " ", "]"}]}], " ", "}"}]}], "\n", 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f6903686-87f1-4749-b129-701e6830ed5e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"1", "\[Rule]", "1"}], ",", 
     RowBox[{"5", "\[Rule]", "5"}]}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"06cff9d7-7e2e-4bf3-8d05-223eaba67428"]
}, Open  ]]
}, Open  ]],

