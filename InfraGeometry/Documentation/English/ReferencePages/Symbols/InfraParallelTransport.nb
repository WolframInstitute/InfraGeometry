Cell["\<\
A partial matching is not a complete connection. The call stays unevaluated:\
\>", "ExampleText",ExpressionUUID->"d9a88472-d373-4bc7-9704-1a5d1591ee7f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"Graph", "[", 
        RowBox[{
         RowBox[{"Range", "[", "4", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"UndirectedEdge", "[", 
           RowBox[{"1", ",", " ", "3"}], "]"}], "}"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<q\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<q\>\""}]}], "|>"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Head", " ", "@", " ", 
    RowBox[{"InfraParallelTransport", "[", 
     RowBox[{"fib", ",", " ", 
      RowBox[{"InfraConnection", "[", 
       RowBox[{"{", 
        RowBox[{"UndirectedEdge", "[", 
         RowBox[{"1", ",", " ", "3"}], "]"}], "}"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<p\>\"", ",", " ", "\"\<q\>\""}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"db5998fc-8a2c-4f90-b21f-4b26f67db34c"],

Cell[BoxData["InfraParallelTransport"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9194ab7a-21e4-4310-bd04-45bd804df02d"]
}, Open  ]]
}, Open  ]],

