Cell[CellGroupData[{
Cell["InfraParallelTransport", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"aa2f6833-8dc6-48ea-839c-ae33824b9076"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["conn", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c17ee8e-abee-4129-8e2b-614771459bd2"],
 "\[LineSeparator]",
 "gives the transport along ",
 StyleBox["walk", "TI"],
 " of the fiber over its first vertex, an association from each fiber vertex \
to the end of its horizontal lift; vertices whose lift is blocked are \
dropped.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8f2057b9-61d0-49ea-932a-1d6d772b59e5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80b8f1bd-4a02-40de-9b23-f6b1277966dc"],
 "\[LineSeparator]",
 "gives the Levi-Civita transports along ",
 StyleBox["walk", "TI"],
 ", a list with one transport for each choice among the best angle-isometries \
over its edges."
}], "Usage",ExpressionUUID->"289e253f-b869-40f9-8796-2c36eae46be6"],

Cell[TextData[{
 "With a connection, a fiber vertex follows the unique edge of ",
 StyleBox["conn", "TI"],
 " over each step of ",
 StyleBox["walk", "TI"],
 "."
}], "Notes",ExpressionUUID->"6d01d364-dc3a-4062-bb63-7cb06d9a01ac"],

Cell[TextData[{
 "Without a connection, over each step ",
 StyleBox["p", "TI"],
 " -> ",
 StyleBox["q", "TI"],
 " the transports are the injections of the direction sphere at ",
 StyleBox["p", "TI"],
 " into the direction sphere at ",
 StyleBox["q", "TI"],
 " that best match their angles, with the geodesics through ",
 StyleBox["q", "TI"],
 " kept straight. There are usually several. The list holds every composite \
along ",
 StyleBox["walk", "TI"],
 ", without duplicates."
}], "Notes",ExpressionUUID->"7f3b78fc-6358-4a8b-8970-a47b370cd8af"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraLeviCivitaConnection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraLeviCivitaConnection",
