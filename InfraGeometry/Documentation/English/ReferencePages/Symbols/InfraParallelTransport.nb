Cell["\<\
A partial matching is not a complete connection, so it is not accepted by \
this reader.\
\>", "ExampleText",ExpressionUUID->"7244343b-4c26-4a31-92c9-24d727ceb8b6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"Graph", "[", " ", 
        RowBox[{
         RowBox[{"Range", "[", " ", "4", " ", "]"}], ",", " ", 
         RowBox[{"{", " ", 
          RowBox[{"UndirectedEdge", "[", " ", 
           RowBox[{"1", ",", " ", "3"}], " ", "]"}], " ", "}"}]}], " ", "]"}],
        ",", "\n", "      ", 
       RowBox[{"<|", " ", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<q\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<q\>\""}]}], " ", "|>"}]}], "\n", 
      "    ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"Head", " ", "@", " ", 
    RowBox[{"InfraParallelTransport", "[", " ", 
     RowBox[{"fib", ",", " ", 
      RowBox[{"InfraConnection", "[", " ", 
       RowBox[{"{", " ", 
        RowBox[{"UndirectedEdge", "[", " ", 
         RowBox[{"1", ",", " ", "3"}], " ", "]"}], " ", "}"}], " ", "]"}], ",",
       " ", 
      RowBox[{"{", " ", 
       RowBox[{"\"\<p\>\"", ",", " ", "\"\<q\>\""}], " ", "}"}]}], " ", 
     "]"}]}]}], "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e5ba75c2-3085-4645-90fb-d63595125a95"],

Cell[BoxData["InfraParallelTransport"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"bbe0b4ce-3c9e-4899-bf8a-31d5a516fc52"]
}, Open  ]]
}, Open  ]],

