Cell["\<\
The two lifts of the base cycle exchange the sheets of a double covering.\
\>", "ExampleText",ExpressionUUID->"73cc72d7-fd05-44cd-a502-3a1602fb96c6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"fib", " ", "=", " ", 
      RowBox[{"InfraFiberedGraph", "[", " ", 
       RowBox[{"total", ",", " ", 
        RowBox[{"vertex", " ", "|->", " ", 
         RowBox[{"Mod", "[", " ", 
          RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
       " ", "]"}]}], ",", "\n", "    ", 
     RowBox[{"connection", " ", "=", " ", 
      RowBox[{"InfraConnection", "[", " ", 
       RowBox[{"EdgeList", " ", "@", " ", "total"}], " ", "]"}]}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"loop", " ", "=", " ", 
     RowBox[{"{", " ", 
      RowBox[{
      "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "1"}], " ", 
      "}"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"lifts", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraHorizontalLift", "[", " ", 
        RowBox[{
        "fib", ",", " ", "connection", ",", " ", "#", ",", " ", "loop"}], " ",
         "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", " ", 
       RowBox[{"1", ",", " ", "5"}], " ", "}"}]}]}], " ", "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"InfraWalk", " ", "/@", " ", "lifts"}]}], " ", "]"}], ",", 
     "\n", "    ", 
     RowBox[{"InfraParallelTransport", "[", " ", 
      RowBox[{"fib", ",", " ", "connection", ",", " ", "loop"}], " ", "]"}]}],
     " ", "}"}]}], "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1085880d-d0cf-4b16-9397-c3a3774f2a6a"],

