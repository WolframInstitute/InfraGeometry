Cell["InfraParallelTransport", "ObjectName",ExpressionUUID->"e57213f3-7368-4040-a501-d3fbefe9e32b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"80219fe8-f1af-4361-9f86-4441369342eb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
     "WolframInstitute/InfraGeometry Package Symbol"},
