Cell[CellGroupData[{
Cell["InfraParallelTransport", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"735644a6-bb39-4521-b0fa-cb7c65460e3b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["conn", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "553b467f-7461-49eb-a938-f79a8d0516e8"],
 "\[LineSeparator]",
 "gives the transport along ",
 StyleBox["walk", "TI"],
 " of the fiber over its first vertex, an association from each fiber vertex \
to the end of its horizontal lift; vertices whose lift is blocked are \
dropped.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ec64fe8f-b224-4158-908e-06ff00545a6c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b2faa0b-681b-41b4-bf0e-d4f6267e6f10"],
 "\[LineSeparator]",
 "gives the Levi-Civita transports along ",
 StyleBox["walk", "TI"],
 ", a list with one transport for each choice among the best angle-isometries \
over its edges."
}], "Usage",ExpressionUUID->"64a90f80-e166-4e13-a5f0-3c2cb2148335"],

Cell[TextData[{
 "With a connection, a fiber vertex follows the unique edge of ",
 StyleBox["conn", "TI"],
 " over each step of ",
 StyleBox["walk", "TI"],
 "."
}], "Notes",ExpressionUUID->"df1d7308-65aa-4b2d-8bb2-a62481754ebb"],

Cell[TextData[{
 "Without a connection, over each step ",
 StyleBox["p", "TI"],
 " -> ",
 StyleBox["q", "TI"],
 " the transports are the injections of the direction sphere at ",
 StyleBox["p", "TI"],
 " into the direction sphere at ",
 StyleBox["q", "TI"],
 " that best match their angles, with the geodesics through ",
 StyleBox["q", "TI"],
 " kept straight. There are usually several. The list holds every composite \
along ",
 StyleBox["walk", "TI"],
 ", without duplicates."
}], "Notes",ExpressionUUID->"b987d5a3-eb87-43d1-a053-6105808e874b"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraLeviCivitaConnection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraLeviCivitaConnection",
