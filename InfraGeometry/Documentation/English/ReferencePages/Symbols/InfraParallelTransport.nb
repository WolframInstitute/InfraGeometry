Cell["\<\
The two lifts of the base cycle exchange the sheets of a double covering.\
\>", "ExampleText",ExpressionUUID->"655ee516-1e2d-4cd0-b2f7-48485591dd8e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"fib", " ", "=", " ", 
      RowBox[{"InfraFibration", "[", " ", 
       RowBox[{"total", ",", " ", 
        RowBox[{"vertex", " ", "|->", " ", 
         RowBox[{"Mod", "[", " ", 
          RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
       " ", "]"}]}], ",", "\n", "    ", 
     RowBox[{"connection", " ", "=", " ", 
      RowBox[{"InfraConnection", "[", " ", 
       RowBox[{"EdgeList", " ", "@", " ", "total"}], " ", "]"}]}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"loop", " ", "=", " ", 
     RowBox[{"{", " ", 
      RowBox[{
      "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "1"}], " ", 
      "}"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"lifts", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraHorizontalLift", "[", " ", 
        RowBox[{
        "fib", ",", " ", "connection", ",", " ", "#", ",", " ", "loop"}], " ",
         "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", " ", 
       RowBox[{"1", ",", " ", "5"}], " ", "}"}]}]}], " ", "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"InfraWalk", " ", "/@", " ", "lifts"}]}], " ", "]"}], ",", 
     "\n", "    ", 
     RowBox[{"InfraParallelTransport", "[", " ", 
      RowBox[{"fib", ",", " ", "connection", ",", " ", "loop"}], " ", "]"}]}],
     " ", "}"}]}], "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fd087b7d-3fde-4620-92d1-b422e5534e3b"],

