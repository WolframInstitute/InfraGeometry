Cell["\<\
On the Moebius ladder the transport around the cycle swaps the two sheets. \
The two lifts are drawn.\
\>", "ExampleText",ExpressionUUID->"ab48b744-1b2e-428a-a5bf-cae461bb4a74"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<MoebiusLadderCover\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"InfraConnection", " ", "@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"EdgeList", "[", "total", "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"First", " ", "@", " ", "#"}]}], " ", "=!=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Last", " ", "@", " ", "#"}]}]}], " ", "&"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"loop", " ", "=", " ", 
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{"Range", "[", "8", "]"}], ",", " ", "1"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"total", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraWalk", " ", "@", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"FindInfraHorizontalLift", "[", 
            RowBox[{
            "fib", ",", " ", "conn", ",", " ", "#", ",", " ", "loop", ",", 
             " ", "1"}], "]"}]}]}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2"}], "}"}]}], "}"}]}]}], "]"}], ",", "\n",
      "    ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"InfraParallelTransport", "[", 
       RowBox[{"fib", ",", " ", "conn", ",", " ", "loop"}], "]"}]}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"24158650-78c6-4bb6-aa4c-6a65f3c846b4"],

