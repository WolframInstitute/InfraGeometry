Cell["\<\
A partial matching is not a complete connection, so it is not accepted by \
this reader.\
\>", "ExampleText",ExpressionUUID->"c231d4de-778c-4509-a551-547e6aa818e9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFibration", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"Graph", "[", " ", 
        RowBox[{
         RowBox[{"Range", "[", " ", "4", " ", "]"}], ",", " ", 
         RowBox[{"{", " ", 
          RowBox[{"UndirectedEdge", "[", " ", 
           RowBox[{"1", ",", " ", "3"}], " ", "]"}], " ", "}"}]}], " ", "]"}],
        ",", "\n", "      ", 
       RowBox[{"<|", " ", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<q\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<q\>\""}]}], " ", "|>"}]}], "\n", 
      "    ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"Head", " ", "@", " ", 
    RowBox[{"InfraParallelTransport", "[", " ", 
     RowBox[{"fib", ",", " ", 
      RowBox[{"InfraConnection", "[", " ", 
       RowBox[{"{", " ", 
        RowBox[{"UndirectedEdge", "[", " ", 
         RowBox[{"1", ",", " ", "3"}], " ", "]"}], " ", "}"}], " ", "]"}], ",",
       " ", 
      RowBox[{"{", " ", 
       RowBox[{"\"\<p\>\"", ",", " ", "\"\<q\>\""}], " ", "}"}]}], " ", 
     "]"}]}]}], "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5b040a35-7186-4304-9ab9-694f2383dbc6"],

Cell[BoxData["InfraParallelTransport"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"886346e0-446f-45f5-9435-ffa34cbf54c7"]
}, Open  ]]
}, Open  ]],

