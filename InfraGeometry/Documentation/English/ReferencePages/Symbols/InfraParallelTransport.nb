Cell["\<\
A random double covering of the 4 \[Times] 4 grid. Transport around the \
square 6, 7, 11, 10 exchanges the two vertices of the fiber over 6:\
\>", "ExampleText",ExpressionUUID->"9c9c179f-e808-4782-a59c-ac4a5d88f1d9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", "\n", "    ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Covering\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"loop", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "6", ",", " ", "7", ",", " ", "11", ",", " ", "10", ",", " ", "6"}], 
      "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraWalk", "[", 
        RowBox[{"InfraHorizontalLift", "[", 
         RowBox[{"fib", ",", " ", "conn", ",", " ", "#", ",", " ", "loop"}], 
         "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "2"}], "}"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"InfraParallelTransport", "[", 
       RowBox[{"fib", ",", " ", "conn", ",", " ", "loop"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ba9d2844-0ed9-47c7-8661-47e46300ce1a"],

