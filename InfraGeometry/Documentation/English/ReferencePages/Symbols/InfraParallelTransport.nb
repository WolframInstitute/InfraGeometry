Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Scope", "ExampleSection",ExpressionUUID->
   "32e79d70-f7af-47ff-bb41-513374ef55db"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1293636265,ExpressionUUID->"6d08f999-4c69-4709-9b28-82906be6ee75"],

Cell["\<\
The single Levi-Civita connection transports along one of the realisations. \
Over an edge of the octahedron there are two, and the connection takes the \
first.\
\>", "ExampleText",ExpressionUUID->"e0b40ceb-db51-41df-ac45-94b2a4fa3cb5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraParallelTransport", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"InfraParallelTransport", "[", 
       RowBox[{"fib", ",", " ", "conn", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], " ", "===", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"InfraParallelTransport", "[", 
        RowBox[{"fib", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2d32c640-c319-40fb-b56b-24a5e4417410"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e85667bc-4e3e-48b3-afcb-ec877ab8e548"]
}, Open  ]]
}, Open  ]],

