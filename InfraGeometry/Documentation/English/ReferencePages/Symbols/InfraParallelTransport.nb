Cell["InfraParallelTransport", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5373bf4d-0963-4d39-bcec-4ef784606f18"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["connection", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3ccbcea-7ad5-4d03-8fe7-4ff78a428a61"],
 "\[LineSeparator]",
 "gives the total fiber bijection along a base walk as an association from \
each starting vertex to the endpoint of its horizontal lift.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"cf393ea4-0747-4ad6-82ac-85cf4940ddec"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["graph", "TI"], ",", " ", 
      StyleBox["radius", "TI"]}], "]"}], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "370b99cb-2762-4ed8-9b46-21644684602c"],
 "\[LineSeparator]",
 "gives the list of metric-selected transports in the Experimental \
displacement-bundle model.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"faefad4b-d1f7-4e5e-affe-7fb995d3c144"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["graph", "TI"], ",", " ", 
      StyleBox["radius", "TI"]}], "]"}], ",", " ", 
    StyleBox["connection", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b472d498-c048-4e18-8af3-144457b6e036"],
 "\[LineSeparator]",
 "retains the Experimental model's partial transport, omitting starting \
directions whose lift is blocked."
}], "Usage",ExpressionUUID->"5d8eecfd-8c4e-4ee5-b13c-b44a9d50c10b"],

Cell["\<\
The general fibered-graph reader requires a valid complete connection and a \
nonempty base walk. It never drops blocked vertices or chooses between \
ambiguous lifts.\
\>", "Notes",ExpressionUUID->"a7395566-aa91-4632-9e33-b75912fca109"],

Cell[TextData[{
 "Keys follow ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["VertexList",
    BaseStyle->"Link"], "[", 
   RowBox[{"InfraFiber", "[", 
    RowBox[{
     StyleBox["fib", "TI"], ",", " ", 
     RowBox[{
      ButtonBox["First",
       BaseStyle->"Link"], "[", 
      StyleBox["walk", "TI"], "]"}]}], "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59f56b6d-271a-4e9d-bd45-8de1080da736"],
 ". List-valued and expression-valued vertices are literal association keys."
}], "Notes",ExpressionUUID->"c5270a10-73b1-4c8b-a3be-ad8e5b282670"],

Cell["\<\
A one-vertex walk gives the identity association. Concatenating walks \
composes their transports; reversing a walk gives the inverse bijection.\
\>", "Notes",ExpressionUUID->"1d29af3a-3fc4-4d26-93f4-a1de3f195129"],

Cell["\<\
The readers with an explicit connection consume no random draws and take no \
options. Unsupported input remains unevaluated.\
\>", "Notes",ExpressionUUID->"44e956c6-9829-482a-a63e-39c66d71abdb"],

Cell["\<\
The Experimental displacement overload with an explicit connection accepts \
partial matchings. Each surviving lift is unique; ambiguous matchings remain \
unevaluated. Converting the model to a literal InfraFibration selects the \
general complete-connection contract.\
\>", "Notes",ExpressionUUID->"e2386c35-17fd-463b-95fb-56d415967044"],

Cell["\<\
The Experimental two-argument displacement form lists every composite of its \
best angle-matching injections, without duplicates. It is a particular model \
and may have several results.\
\>", "Notes",ExpressionUUID->"66caf45a-e349-436b-a3c1-87676a22e191"],

Cell["Options of the Experimental displacement form:", "Notes",ExpressionUUID->"f798c9f9-6323-43d2-915d-75feb9d3aacf"],

