Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Scope", "ExampleSection",ExpressionUUID->
   "32e79d70-f7af-47ff-bb41-513374ef55db"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1293636265,ExpressionUUID->"6d08f999-4c69-4709-9b28-82906be6ee75"],

Cell["\<\
The single Levi-Civita connection transports along one of the realisations. \
Over an edge of the octahedron there are two, and the connection takes the \
first.\
\>", "ExampleText",ExpressionUUID->"6ecac363-4b21-4f01-835b-0f77f4ed23b0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraParallelTransport", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"InfraParallelTransport", "[", 
       RowBox[{"fib", ",", " ", "conn", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], " ", "===", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"InfraParallelTransport", "[", 
        RowBox[{"fib", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e86c1963-dfcb-4d4c-9cbe-511fbcb8db57"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b0c4e499-11ab-4f6b-a45d-94e791e63b0a"]
}, Open  ]]
}, Open  ]],

