Cell["\<\
The reversed walk gives the inverse map, and a walk of length 0 the identity:\
\
\>", "ExampleText",ExpressionUUID->"daab580f-931c-4346-a01a-85b0ed67042c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       "\n", "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"forward", " ", "=", " ", 
      RowBox[{"InfraParallelTransport", "[", 
       RowBox[{"fib", ",", " ", "conn", ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "7", ",", " ", "11", ",", " ", "12"}], 
         "}"}]}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"backward", " ", "=", " ", 
      RowBox[{"InfraParallelTransport", "[", 
       RowBox[{"fib", ",", " ", "conn", ",", " ", 
        RowBox[{"{", 
         RowBox[{"12", ",", " ", "11", ",", " ", "7", ",", " ", "6"}], 
         "}"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Lookup", "[", 
       RowBox[{"backward", ",", " ", 
        RowBox[{"Key", " ", "/@", " ", 
         RowBox[{"Values", "[", "forward", "]"}]}]}], "]"}], " ", "===", " ", 
      
      RowBox[{"Keys", "[", "forward", "]"}]}], ",", " ", 
     RowBox[{"InfraParallelTransport", "[", 
      RowBox[{"fib", ",", " ", "conn", ",", " ", 
       RowBox[{"{", "6", "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"84138f84-d55e-4f0a-bbe7-6c05d15fe8c3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"6", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"6", ",", "1"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"6", ",", "2"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"6", ",", "2"}], "}"}]}]}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"62e2d0dd-0a45-4b63-9c60-2d93366ca889"]
}, Open  ]],

Cell["\<\
Transport along a walk is the composite of the transports along its parts:\
\>", "ExampleText",ExpressionUUID->"ca0114f3-ec9b-4e88-a9f4-fd81e6cfc048"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       "\n", "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"first", " ", "=", " ", 
      RowBox[{"InfraParallelTransport", "[", 
       RowBox[{"fib", ",", " ", "conn", ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "7", ",", " ", "11"}], "}"}]}], "]"}]}], ",", 
     "\n", "   ", 
     RowBox[{"second", " ", "=", " ", 
      RowBox[{"InfraParallelTransport", "[", 
       RowBox[{"fib", ",", " ", "conn", ",", " ", 
        RowBox[{"{", 
         RowBox[{"11", ",", " ", "12", ",", " ", "16"}], "}"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Lookup", "[", 
     RowBox[{"second", ",", " ", 
      RowBox[{"Key", " ", "/@", " ", 
       RowBox[{"Values", "[", "first", "]"}]}]}], "]"}], " ", "===", " ", 
    RowBox[{"Values", "[", 
     RowBox[{"InfraParallelTransport", "[", 
      RowBox[{"fib", ",", " ", "conn", ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "6", ",", " ", "7", ",", " ", "11", ",", " ", "12", ",", " ", "16"}], 
        "}"}]}], "]"}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b6bd7086-662f-4226-bd4f-6c69e351b218"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"6c7ca391-2583-42c7-ac3f-cb85bdea981d"]
}, Open  ]]
}, Open  ]],

