Cell["\<\
The magnitude is subadditive. Two random displacements of the mesh, of \
magnitudes 1 and 2, and their composite:\
\>", "ExampleText",ExpressionUUID->"e7b0ca33-bb43-4a5f-9dba-7c519bf74dd9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"d1", " ", "=", " ", 
      RowBox[{"RandomDisplacement", "[", 
       RowBox[{"g", ",", " ", "1", ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], ",", " ", 
     RowBox[{"d2", " ", "=", " ", 
      RowBox[{"RandomDisplacement", "[", 
       RowBox[{"g", ",", " ", "2", ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"DisplacementMagnitude", "[", 
      RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"d1", ",", " ", "d2", ",", " ", 
      RowBox[{"DisplacementCompose", "[", 
       RowBox[{"d1", ",", " ", "d2"}], "]"}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8557d1c8-3f16-4a43-816f-819329349fb6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6d2d0700-aa96-40dd-8498-6a5cad518f4d"]
}, Open  ]],

