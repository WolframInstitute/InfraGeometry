Notebook[{

Cell[CellGroupData[{
Cell["DisplacementMagnitude", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e5857843-cfd7-4c64-9710-56cf1ca34d67"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementMagnitude"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementMagnitude", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30e517d5-c301-4ddd-ad4a-7dfefd3840e7"],
 "\[LineSeparator]",
 "is the magnitude of the displacement ",
 StyleBox["d", "TI"],
 ": the length of its longest step in ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"bfd7e010-8159-434e-b21b-b0e5d95552c6"],

Cell[TextData[{
 "The magnitude is ",
 StyleBox["\:2016D\:2016 = max {d(v, w) : w \[Element] D(v)}", "TI"],
 ", the maximum over all vertices ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"a173bc1f-936b-4729-89f4-e9191afc48e8"],

Cell[TextData[{
 "It is the scale of the displacement, the time ",
 StyleBox["r", "TI"],
 " of a flow of a unit vector field. The identity has magnitude 0."
}], "Notes",ExpressionUUID->"e851b487-7cd2-456c-8a86-734b939236f8"],

Cell[TextData[{
 "It is subadditive under composition, ",
 StyleBox["\:2016D\:2082 \[SmallCircle] D\:2081\:2016 \[LessEqual] \:2016D\
\:2081\:2016 + \:2016D\:2082\:2016", "TI"],
 "."
}], "Notes",ExpressionUUID->"915366f6-e8ac-4e22-aa28-ccd250f8a2de"],

Cell["\<\
The longest step decides, so a single step at the rim can set the magnitude.\
\>", "Notes",ExpressionUUID->"4f0bcbf0-20b1-40a2-a2bb-f137b846b2cb"],

Cell[TextData[{
 "The least magnitude of a symmetry of ",
 StyleBox["g", "TI"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KillingDisplacementMagnitude"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/KillingDisplacementMagnitude", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "10c41c65-20e2-4f2e-85a3-23f7b1d90493"],
 "."
}], "Notes",ExpressionUUID->"56c2ef2b-e9f0-4f22-bf99-4c31e8d7afb5"]
}, Open  ]],

