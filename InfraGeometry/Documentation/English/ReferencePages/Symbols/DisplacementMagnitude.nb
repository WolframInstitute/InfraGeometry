Cell["\<\
The magnitude of the step right, on the square grid and on the square mesh. \
On the grid a pendant vertex of the top or the bottom row steps to the next \
pendant vertex, three steps away:\
\>", "ExampleText",ExpressionUUID->"cde7e345-e423-49b0-8c7e-1f9b2aca9aaf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"KeyValueMap", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name", ",", " ", "s"}], "}"}], " ", "|->", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"t", " ", "=", " ", 
         RowBox[{"TranslationDisplacement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", 
            RowBox[{"s", ",", " ", "0"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"DisplacementPlot", "[", 
        RowBox[{"g", ",", " ", "t", ",", " ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"DisplacementMagnitude", "[", 
           RowBox[{"g", ",", " ", "t"}], "]"}]}]}], "]"}]}], "]"}]}], ",", 
    "\n", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<SquareGridGraph\>\"", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"\"\<SquareMeshGraph\>\"", " ", "->", " ", 
       RowBox[{"1", "/", "8"}]}]}], "|>"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ce2c7b18-16cd-4f94-af0c-990244cb2a10"],

