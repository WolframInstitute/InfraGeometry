Cell["\<\
The steps from the centre scaled by 0, 1, \[Ellipsis], 6 have magnitude 0, 1, \
\[Ellipsis], 6, on the grid and on the mesh:\
\>", "ExampleText",ExpressionUUID->"23ef13ab-a31a-4ed1-acd7-aff975890d24"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
        "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
     
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"DisplacementMagnitude", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"DisplacementScale", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"<|", 
            RowBox[{"c", " ", "->", " ", 
             RowBox[{"AdjacencyList", "[", 
              RowBox[{"g", ",", " ", "c"}], "]"}]}], "|>"}], ",", " ", "t"}], 
          "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], "]"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", 
       " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"27cb6247-aad9-4c81-8bf7-f57932bb6ed4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6"}],
     "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6"}],
     "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"0742ce91-b684-4351-a69c-e829e40ce07b"]
}, Open  ]]
}, Open  ]],

