Cell["\<\
At a neighbour of the centre the gradient is \[Minus]1 on the step back to \
the centre, an orange arc, 0 on the two steps inside its shell, and 1 on the \
three steps outward, blue arcs.\
\>", "ExampleText",ExpressionUUID->"e1ac6e16-f23f-49e6-9132-5df5ee17396d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"center", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"gradient", " ", "=", " ", 
     RowBox[{"FormDifferential", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"ZeroForm", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "center", ",", " ", "#"}], "]"}], " ", 
          "&"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"node", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"AdjacencyList", "[", 
       RowBox[{"g", ",", " ", "center"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", "\n", "     ", 
        RowBox[{
         RowBox[{"<|", 
          RowBox[{"node", " ", "->", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"AdjacencyList", "[", 
              RowBox[{"g", ",", " ", "node"}], "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"FormValue", "[", 
                RowBox[{"gradient", ",", " ", "node", ",", " ", 
                 RowBox[{"{", "#", "}"}]}], "]"}], " ", ">", " ", "0"}], " ", 
              "&"}]}], "]"}]}], "|>"}], ",", "\n", "     ", 
         RowBox[{"<|", 
          RowBox[{"node", " ", "->", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"AdjacencyList", "[", 
              RowBox[{"g", ",", " ", "node"}], "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"FormValue", "[", 
                RowBox[{"gradient", ",", " ", "node", ",", " ", 
                 RowBox[{"{", "#", "}"}]}], "]"}], " ", "<", " ", "0"}], " ", 
              "&"}]}], "]"}]}], "|>"}]}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"FormValue", "[", 
          RowBox[{"gradient", ",", " ", "node", ",", " ", 
           RowBox[{"{", "#", "}"}]}], "]"}], " ", "&"}], ",", " ", 
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", "node"}], "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3daca083-ba2f-43ae-9675-482231e007de"],

