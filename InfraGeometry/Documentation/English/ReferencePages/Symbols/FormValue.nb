Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"center", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"gradient", " ", "=", " ", 
     RowBox[{"FormDifferential", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"ZeroForm", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "center", ",", " ", "#"}], "]"}], " ", 
          "&"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"<|", 
        RowBox[{"center", " ", "->", " ", 
         RowBox[{"Take", "[", 
          RowBox[{
           RowBox[{"AdjacencyList", "[", 
            RowBox[{"g", ",", " ", "center"}], "]"}], ",", " ", "2"}], 
          "]"}]}], "|>"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"FormValue", "[", 
        RowBox[{"gradient", ",", " ", "center", ",", " ", 
         RowBox[{"Take", "[", 
          RowBox[{
           RowBox[{"AdjacencyList", "[", 
            RowBox[{"g", ",", " ", "center"}], "]"}], ",", " ", "1"}], 
          "]"}]}], "]"}], ",", " ", 
       RowBox[{"FormValue", "[", 
        RowBox[{"gradient", ",", " ", "center", ",", " ", 
         RowBox[{"Take", "[", 
          RowBox[{
           RowBox[{"AdjacencyList", "[", 
            RowBox[{"g", ",", " ", "center"}], "]"}], ",", " ", "2"}], 
          "]"}]}], "]"}]}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e95e0e1f-e7a7-431a-aa33-36f59c4d99d1"],

