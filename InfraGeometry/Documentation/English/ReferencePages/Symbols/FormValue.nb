Cell["\<\
At a neighbour of the centre the gradient is \[Minus]1 on the step back to \
the centre, an orange arc, 0 on the two steps inside its shell, and 1 on the \
three steps outward, blue arcs.\
\>", "ExampleText",ExpressionUUID->"9673debb-8e5a-4df7-823b-a84e1c1abe2e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"center", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"gradient", " ", "=", " ", 
     RowBox[{"FormDifferential", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"ZeroForm", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "center", ",", " ", "#"}], "]"}], " ", 
          "&"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"node", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"AdjacencyList", "[", 
       RowBox[{"g", ",", " ", "center"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", "\n", "     ", 
        RowBox[{
         RowBox[{"<|", 
          RowBox[{"node", " ", "->", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"AdjacencyList", "[", 
              RowBox[{"g", ",", " ", "node"}], "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"FormValue", "[", 
                RowBox[{"gradient", ",", " ", "node", ",", " ", 
                 RowBox[{"{", "#", "}"}]}], "]"}], " ", ">", " ", "0"}], " ", 
              "&"}]}], "]"}]}], "|>"}], ",", "\n", "     ", 
         RowBox[{"<|", 
          RowBox[{"node", " ", "->", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"AdjacencyList", "[", 
              RowBox[{"g", ",", " ", "node"}], "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"FormValue", "[", 
                RowBox[{"gradient", ",", " ", "node", ",", " ", 
                 RowBox[{"{", "#", "}"}]}], "]"}], " ", "<", " ", "0"}], " ", 
              "&"}]}], "]"}]}], "|>"}]}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"FormValue", "[", 
          RowBox[{"gradient", ",", " ", "node", ",", " ", 
           RowBox[{"{", "#", "}"}]}], "]"}], " ", "&"}], ",", " ", 
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", "node"}], "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"faa712d4-c6ea-4f8b-a44f-d882119539e4"],

