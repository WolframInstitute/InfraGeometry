 CellID->1293636265,ExpressionUUID->"6d08f999-4c69-4709-9b28-82906be6ee75"],

Cell[TextData[{
 "A tuple is read in any order, with the sign of its sorting permutation. The \
germ of ",
 StyleBox["dx \[And] dy", "TI"],
 " at the centre of the grid, over the ordered pairs of the four neighbours: \
the determinant of the two steps, \[PlusMinus]1 on perpendicular steps and 0 \
on opposite ones:"
}], "ExampleText",ExpressionUUID->"57a7279d-c4ca-4b79-8529-21cae0b889fb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", " ", "=", " ", 
      RowBox[{"ZeroForm", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], "]"}]}], 
     ",", "\n", "   ", 
     RowBox[{"y", " ", "=", " ", 
      RowBox[{"ZeroForm", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"wedge", " ", "=", " ", 
     RowBox[{"FormWedge", "[", 
      RowBox[{
       RowBox[{"FormDifferential", "[", 
        RowBox[{"g", ",", " ", "x"}], "]"}], ",", " ", 
       RowBox[{"FormDifferential", "[", 
        RowBox[{"g", ",", " ", "y"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"MatrixForm", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"FormValue", "[", 
       RowBox[{"wedge", ",", " ", "c", ",", " ", 
        RowBox[{"{", 
         RowBox[{"u", ",", " ", "w"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"u", ",", " ", 
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", "c"}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"w", ",", " ", 
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", "c"}], "]"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"183693f0-1555-458a-a47e-54975401cfad"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", "1.`", 
      RowBox[{"-", "1.`"}], "0"},
     {
      RowBox[{"-", "1.`"}], "0", "0", "1.`"},
     {"1.`", "0", "0", 
      RowBox[{"-", "1.`"}]},
     {"0", 
      RowBox[{"-", "1.`"}], "1.`", "0"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"264866d9-dec7-406f-9228-6ed563e94bf2"]
}, Open  ]],

Cell["\<\
A tuple of another length than the degree gives 0. The gradient, a 1-form, on \
one neighbour and on two:\
\>", "ExampleText",ExpressionUUID->"0c035d0e-5990-4ead-8ed3-54616d15b7b7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"df", " ", "=", " ", 
     RowBox[{"FormDifferential", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"ZeroForm", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"AssociationThread", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c"}], "]"}]}], "]"}]}], "]"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FormValue", "[", 
      RowBox[{"df", ",", " ", "c", ",", " ", 
       RowBox[{"Take", "[", 
        RowBox[{
         RowBox[{"AdjacencyList", "[", 
          RowBox[{"g", ",", " ", "c"}], "]"}], ",", " ", "1"}], "]"}]}], 
      "]"}], ",", " ", 
     RowBox[{"FormValue", "[", 
      RowBox[{"df", ",", " ", "c", ",", " ", 
       RowBox[{"Take", "[", 
        RowBox[{
         RowBox[{"AdjacencyList", "[", 
          RowBox[{"g", ",", " ", "c"}], "]"}], ",", " ", "2"}], "]"}]}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"15e734e3-5d94-487e-a8fa-6edd2df0066c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "0"}], "}"}]], "Output",
