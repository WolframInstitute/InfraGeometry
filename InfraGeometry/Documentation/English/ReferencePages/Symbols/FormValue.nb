Cell["\<\
The length of the tuple is not checked, and a tuple of another length than \
the degree gives 0, the value of the component of that degree. The gradient \
of the distance, a 1-form, read on one neighbour and on a pair of neighbours.\
\
\>", "ExampleText",ExpressionUUID->"4d41a1d6-ef42-4e71-9b0e-4cbe9daca819"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"center", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"gradient", " ", "=", " ", 
     RowBox[{"FormDifferential", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"ZeroForm", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "center", ",", " ", "#"}], "]"}], " ", 
          "&"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"<|", 
        RowBox[{"center", " ", "->", " ", 
         RowBox[{"Take", "[", 
          RowBox[{
           RowBox[{"AdjacencyList", "[", 
            RowBox[{"g", ",", " ", "center"}], "]"}], ",", " ", "2"}], 
          "]"}]}], "|>"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"FormValue", "[", 
        RowBox[{"gradient", ",", " ", "center", ",", " ", 
         RowBox[{"Take", "[", 
          RowBox[{
           RowBox[{"AdjacencyList", "[", 
            RowBox[{"g", ",", " ", "center"}], "]"}], ",", " ", "1"}], 
          "]"}]}], "]"}], ",", " ", 
       RowBox[{"FormValue", "[", 
        RowBox[{"gradient", ",", " ", "center", ",", " ", 
         RowBox[{"Take", "[", 
          RowBox[{
           RowBox[{"AdjacencyList", "[", 
            RowBox[{"g", ",", " ", "center"}], "]"}], ",", " ", "2"}], 
          "]"}]}], "]"}]}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"eaea6303-ee3e-43e6-a9ab-5eb1a524aed0"],

