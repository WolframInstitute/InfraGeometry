Notebook[{

Cell[CellGroupData[{
Cell["FormValue", "ObjectName",ExpressionUUID->"47a418cc-9034-454e-8507-0c1def59d9cb"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"33f5d167-fa52-4707-9846-f6ff429dc495"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FormValue"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FormValue", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["\[Omega]", "TR"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["w\:2081", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["w\:2096", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58f2c9fd-964d-4b8b-b01b-53adcbadc66a"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["\[Omega](v; w\:2081, \[Ellipsis], w\:2096)", "TI"],
 ", the value of the germ of the ",
 StyleBox["k", "TI"],
 "-form ",
 StyleBox["\[Omega]", "TI"],
 " at the vertex ",
 StyleBox["v", "TI"],
 " on a tuple of neighbours of ",
 StyleBox["v", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"7920b307-9699-4788-b458-411e7c31420d"],

Cell[TextData[{
 "Definition: a ",
 StyleBox["k", "TI"],
 "-form ",
 StyleBox["\[Omega]", "TI"],
 " assigns to every vertex ",
 StyleBox["v", "TI"],
 " an alternating function on the ",
 StyleBox["k", "TI"],
 "-tuples of distinct neighbours of ",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["\[Omega](v; w\[Sigma](1), \[Ellipsis], w\[Sigma](k)) = \
sgn(\[Sigma]) \[Omega](v; w\:2081, \[Ellipsis], w\:2096)", "TI"],
 " for every permutation ",
 StyleBox["\[Sigma]", "TI"],
 "."
}], "Notes",ExpressionUUID->"acf5c016-2c10-4af6-9f71-86415172dc9b"],

Cell[TextData[{
 "A germ is stored on the sorted tuples, ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"w1", ",", " ", "...", ",", " ", "wk"}], "}"}], " ", "->", " ",
       "value"}], "|>"}]}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c9df65a-00c9-43b1-b0a8-8b1b157366a2"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FormValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FormValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "92f11697-eb67-40fd-a06d-d076c2d42aee"],
 " sorts the tuple, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Sort"]], "paclet:ref/Sort"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1beef35a-c6f1-4f27-879c-75c861825e73"],
 " orders the vertex names, and multiplies the stored value by the sign of \
the sorting permutation. A tuple with a repeated vertex gives 0, and so does \
a tuple that is not stored, of any length: a value 0 is not stored, and a \
vertex that is not a neighbour of ",
 StyleBox["v", "TI"],
 " carries no value. A form is read as an element of the whole exterior \
algebra, whose components of every other degree are 0."
}], "Notes",ExpressionUUID->"1409a0f5-8739-4f3b-9d55-e5df143528da"],

Cell[TextData[{
 "The tuple need not span a clique. From degree 2 on, a germ also takes \
values on tuples of neighbours that span no clique, where every cochain \
vanishes; that is what separates the forms from the cochains read by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4da7f56c-3f52-4657-bac5-c378b460bd0a"],
 "."
}], "Notes",ExpressionUUID->"ee59bf95-685e-4dd2-b822-24ef8518e2f1"],

Cell[TextData[{
 "At scale 1 a tangent vector at ",
 StyleBox["v", "TI"],
 " is a step from ",
 StyleBox["v", "TI"],
 " to a neighbour ",
 StyleBox["w", "TI"],
 ". A 1-form germ is a linear function of the steps from ",
 StyleBox["v", "TI"],
 ": ",
 StyleBox["\[Omega](v; w)", "TI"],
 " is its value on the step to ",
 StyleBox["w", "TI"],
 ". For a 0-form the tuple is {}."
}], "Notes",ExpressionUUID->"be06053c-ccf6-4b42-b4bb-7bc71593599d"]
}, Open  ]],

