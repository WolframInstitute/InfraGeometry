            "&"}]}], "]"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"matrix", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"FormValue", "[", 
        RowBox[{"twoForm", ",", " ", "center", ",", " ", 
