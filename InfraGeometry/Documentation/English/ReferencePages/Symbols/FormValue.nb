Cell["\<\
The gradient of the distance from the centre of the triangular tiling, at the \
centre: 1 on the step to every neighbour.\
\>", "ExampleText",ExpressionUUID->"4e6ae459-07b8-48ee-a6cd-dc47f913b5cc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"center", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"gradient", " ", "=", " ", 
     RowBox[{"FormDifferential", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"ZeroForm", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "center", ",", " ", "#"}], "]"}], " ", 
          "&"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"<|", 
        RowBox[{"center", " ", "->", " ", 
         RowBox[{"AdjacencyList", "[", 
          RowBox[{"g", ",", " ", "center"}], "]"}]}], "|>"}]}], "]"}], ",", 
     " ", 
     RowBox[{
      RowBox[{
       RowBox[{"FormValue", "[", 
        RowBox[{"gradient", ",", " ", "center", ",", " ", 
         RowBox[{"{", "#", "}"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"AdjacencyList", "[", 
       RowBox[{"g", ",", " ", "center"}], "]"}]}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"1b5c1e41-58fc-4f8a-b4fd-588234e19ccb"],

