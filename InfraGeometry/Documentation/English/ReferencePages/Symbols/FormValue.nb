Cell[CellGroupData[{
Cell["FormValue", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"500250e0-7220-4bf3-a537-af301bebf349"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FormValue"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FormValue", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["\[Omega]", "TR"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["w\:2081", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["w\:2096", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e47a4d45-f4ab-441f-95cd-c42510fa4ebe"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["\[Omega](v; w\:2081, \[Ellipsis], w\:2096)", "TI"],
 ", the value of the germ of the ",
 StyleBox["k", "TI"],
 "-form ",
 StyleBox["\[Omega]", "TI"],
 " at the vertex ",
 StyleBox["v", "TI"],
 " on a tuple of neighbours of ",
 StyleBox["v", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"36d43778-4ffa-4996-8cd0-157399e0f0e1"],

Cell[TextData[{
 "A ",
 StyleBox["k", "TI"],
 "-form assigns to every vertex ",
 StyleBox["v", "TI"],
 " a germ: an alternating function of the ",
 StyleBox["k", "TI"],
 "-tuples of distinct neighbours of ",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["\[Omega](v; w\[Sigma]\:208d\:2081\:208e, \[Ellipsis], w\[Sigma]\
\:208d\:2096\:208e) = sgn(\[Sigma]) \[Omega](v; w\:2081, \[Ellipsis], \
w\:2096)", "TI"],
 "."
}], "Notes",ExpressionUUID->"69c764b1-066b-4eb2-b0d7-ec7a2914646f"],

Cell[TextData[{
 "A step from ",
 StyleBox["v", "TI"],
 " to a neighbour ",
 StyleBox["w", "TI"],
 " is a tangent vector at ",
 StyleBox["v", "TI"],
 ". A 1-form germ is a function of the steps, ",
 StyleBox["\[Omega](v; w)", "TI"],
 " its value on the step to ",
 StyleBox["w", "TI"],
 ". A 0-form is read on the empty tuple {}."
}], "Notes",ExpressionUUID->"d31a868d-abb5-4484-88a1-00a01ef2a276"],

Cell[TextData[{
 "A form is stored as ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"v", " ", "->", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"w1", ",", " ", "\[Ellipsis]", ",", " ", "wk"}], "}"}], " ", 
        "->", " ", "value"}], ",", " ", "\[Ellipsis]"}], "|>"}]}], ",", " ", 
    "\[Ellipsis]"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bf52554-4ddc-46c7-8868-fc133d9b56ac"],
 " on the sorted tuples. The value on any tuple is the stored value on the \
sorted tuple times the sign of the sorting permutation."
}], "Notes",ExpressionUUID->"b98a5805-6051-4fd7-ab77-61a0bac1b363"],

Cell["\<\
The value is 0 on a tuple with a repeated vertex, on a vertex that is not a \
neighbour, on a tuple whose stored value is 0 and on a tuple of another \
length than the degree.\
\>", "Notes",ExpressionUUID->"40331975-b239-437f-9672-adf451c0ac17"],

Cell[TextData[{
 "The tuple need not span a clique. On the square grid no two neighbours of a \
vertex are adjacent, so every 2-cochain is 0 while a 2-form need not be. This \
is what separates forms from cochains (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c3d7c8eb-85a9-4b38-bf3d-92117e57a9cc"],
 ")."
}], "Notes",ExpressionUUID->"261341cc-9b68-48ea-b470-93afbb5274ad"]
}, Open  ]],

