Cell[TextData[{
 "The gradient of the distance from the centre at a vertex ",
 StyleBox["v", "TI"],
 " at distance 2, as a density on the neighbours of ",
 StyleBox["v", "TI"],
 ": a dot on a step outward, value 1, a ring on a step inward, value \
\[Minus]1. On the mesh a step inside the shell has value 0 and is not drawn:"
}], "ExampleText",ExpressionUUID->"55217f58-a38b-4d16-83e9-f02641613ab2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"df", " ", "=", " ", 
         RowBox[{"FormDifferential", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"ZeroForm", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"AssociationThread", "[", 
              RowBox[{
               RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
               RowBox[{"GraphDistance", "[", 
                RowBox[{"g", ",", " ", "c"}], "]"}]}], "]"}]}], "]"}]}], 
          "]"}]}], ",", "\n", "     ", 
        RowBox[{"v", " ", "=", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
           RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}]}], "}"}],
       ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "v", ",", " ", 
          RowBox[{"AssociationMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"FormValue", "[", 
              RowBox[{"df", ",", " ", "v", ",", " ", 
               RowBox[{"{", "#", "}"}]}], "]"}], " ", "&"}], ",", " ", 
            RowBox[{"AdjacencyList", "[", 
             RowBox[{"g", ",", " ", "v"}], "]"}]}], "]"}]}], "}"}]}], "]"}]}],
      "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"13ca20ae-7994-4cf8-881e-d665f5af8eb8"],

