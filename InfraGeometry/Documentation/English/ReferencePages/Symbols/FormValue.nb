Notebook[{

Cell[CellGroupData[{
Cell["FormValue", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a5558f66-94c3-47ed-8072-2868d0eac2eb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FormValue"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FormValue", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["\[Omega]", "TR"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["w\:2081", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["w\:2096", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "518b7475-241d-4dbe-8eb1-2e6bfb3f6236"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["\[Omega](v; w\:2081, \[Ellipsis], w\:2096)", "TI"],
 ", the value of the germ of the ",
 StyleBox["k", "TI"],
 "-form ",
 StyleBox["\[Omega]", "TI"],
 " at the vertex ",
 StyleBox["v", "TI"],
 " on a tuple of neighbours of ",
 StyleBox["v", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"2a2c75a7-7455-43cb-9c8e-cdc94889786c"],

Cell[TextData[{
 "Definition: a ",
 StyleBox["k", "TI"],
 "-form ",
 StyleBox["\[Omega]", "TI"],
 " assigns to every vertex ",
 StyleBox["v", "TI"],
 " an alternating function on the ",
 StyleBox["k", "TI"],
 "-tuples of distinct neighbours of ",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["\[Omega](v; w\[Sigma](1), \[Ellipsis], w\[Sigma](k)) = \
sgn(\[Sigma]) \[Omega](v; w\:2081, \[Ellipsis], w\:2096)", "TI"],
 " for every permutation ",
 StyleBox["\[Sigma]", "TI"],
 "."
}], "Notes",ExpressionUUID->"2b6b50a1-5974-4112-8ead-c7b9c748cf08"],

Cell[TextData[{
 "A germ is stored on the sorted tuples, ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"w1", ",", " ", "...", ",", " ", "wk"}], "}"}], " ", "->", " ",
       "value"}], "|>"}]}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9882034-239c-4293-bf1e-3d94afc7290f"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FormValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FormValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "80a6567f-9239-4370-ad2b-9f133bcb4f1d"],
 " sorts the tuple, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Sort"]], "paclet:ref/Sort"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "20753acc-638c-4db5-8fe2-e7e07eeb7495"],
 " orders the vertex names, and multiplies the stored value by the sign of \
the sorting permutation. A tuple with a repeated vertex gives 0, and so does \
a tuple that is not stored, of any length: a value 0 is not stored, and a \
vertex that is not a neighbour of ",
 StyleBox["v", "TI"],
 " carries no value. A form is read as an element of the whole exterior \
algebra, whose components of every other degree are 0."
}], "Notes",ExpressionUUID->"43702cd9-3ef3-4ebb-a955-47e587ced87e"],

Cell[TextData[{
 "The tuple need not span a clique. From degree 2 on, a germ also takes \
values on tuples of neighbours that span no clique, where every cochain \
vanishes; that is what separates the forms from the cochains read by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9610f9d1-4bbf-4e55-b121-1bb0dd2acca4"],
 "."
}], "Notes",ExpressionUUID->"ad0f679b-52ae-4dc6-996b-3f96191909bc"],

Cell[TextData[{
 "At scale 1 a tangent vector at ",
 StyleBox["v", "TI"],
 " is a step from ",
 StyleBox["v", "TI"],
 " to a neighbour ",
 StyleBox["w", "TI"],
 ". A 1-form germ is a linear function of the steps from ",
 StyleBox["v", "TI"],
 ": ",
 StyleBox["\[Omega](v; w)", "TI"],
 " is its value on the step to ",
 StyleBox["w", "TI"],
 ". For a 0-form the tuple is {}."
}], "Notes",ExpressionUUID->"2f465d75-46cf-46e6-987e-21d0fc163db7"]
}, Open  ]],

