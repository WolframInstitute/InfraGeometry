Cell[TextData[{
 "The value of the gradient ",
 StyleBox["df", "TI"],
 " on the step from ",
 StyleBox["v", "TI"],
 " to ",
 StyleBox["w", "TI"],
 " is ",
 StyleBox["f(w) \[Minus] f(v)", "TI"],
 ". The coordinate ",
 StyleBox["x", "TI"],
 " on the mesh:"
}], "ExampleText",ExpressionUUID->"965e8647-9d8a-482b-a07a-8833f52ff067"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"x", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"dx", " ", "=", " ", 
     RowBox[{"FormDifferential", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"ZeroForm", "[", 
        RowBox[{"g", ",", " ", "x"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"FormValue", "[", 
        RowBox[{"dx", ",", " ", 
         RowBox[{"First", "[", "#", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"Last", "[", "#", "]"}], "}"}]}], "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"Last", "[", "#", "]"}], "]"}], " ", "-", " ", 
        RowBox[{"x", "[", 
         RowBox[{"First", "[", "#", "]"}], "]"}]}]}], " ", "&"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"57837f72-c8c7-4427-8eab-1a357e4b6402"],

