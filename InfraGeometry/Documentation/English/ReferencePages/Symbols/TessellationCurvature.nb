Cell[CellGroupData[{
Cell["TessellationCurvature", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6c95954c-6c92-4ab9-88a8-212ef6d47b21"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationCurvature"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationCurvature", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["p", "TI"], ",", " ", 
     StyleBox["q", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d654a35-0c76-48f5-8587-a0ee33d09817"],
 "\[LineSeparator]",
 "gives the combinatorial curvature at a vertex of the tiling by ",
 StyleBox["p", "TI"],
 "-gons, ",
 StyleBox["q", "TI"],
 " at every vertex.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"dc67c727-4e4c-43f2-8150-63f2f4e07236"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationCurvature"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationCurvature", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["config", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c306612-56a0-455e-b7f2-77b5050f6547"],
 "\[LineSeparator]",
 "gives the curvature at a vertex with the vertex configuration ",
 StyleBox["config", "TI"],
 "."
}], "Usage",ExpressionUUID->"3c1124c1-1df9-4cc5-85bc-1fea8997c5fc"],

Cell[TextData[{
 "Definition: at a vertex surrounded by ",
 StyleBox["k", "TI"],
 " faces with ",
 StyleBox["f", "TI"],
 "\:2081, \[Ellipsis], ",
 StyleBox["f", "TI"],
 "\:2096 sides, the combinatorial curvature is ",
 StyleBox["\[Kappa] = \[CapitalSigma]\:1d62 1/f\:1d62 \[Minus] (k \[Minus] \
2)/2", "TI"],
 ". For {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} it is ",
 StyleBox["\[Kappa] = q/p \[Minus] (q \[Minus] 2)/2 = (4 \[Minus] (p \[Minus] \
2)(q \[Minus] 2))/(2p)", "TI"],
 "."
}], "Notes",ExpressionUUID->"58b18a49-e3f0-4758-a8d6-c786b5e3ea30"],

Cell[TextData[{
 "When the faces are regular polygons, 2\[Pi]",
 StyleBox["\[Kappa]", "TI"],
 " is the angle defect at the vertex: 2\[Pi] less the sum of the face angles \
\[Pi](1 \[Minus] 2/",
 StyleBox["f\:1d62", "TI"],
 "). Its sign says where the tiling lives: ",
 StyleBox["\[Kappa]", "TI"],
 " > 0 on the sphere, ",
 StyleBox["\[Kappa]", "TI"],
 " = 0 in the plane or on a flat torus, ",
 StyleBox["\[Kappa]", "TI"],
 " < 0 in the hyperbolic plane."
}], "Notes",ExpressionUUID->"30e01931-3f14-424d-8964-ae2b8f7a8e7e"],

Cell[TextData[{
 "On a closed map the curvatures of the vertices add up to the Euler \
characteristic, a discrete Gauss\[Dash]Bonnet theorem. Each face has ",
 StyleBox["f", "TI"],
 " corners, each counted 1/",
 StyleBox["f", "TI"],
 ", so the first terms add up to ",
 StyleBox["F", "TI"],
 "; the degrees add up to 2",
 StyleBox["E", "TI"],
 ", so the second terms add up to ",
 StyleBox["E \[Minus] V", "TI"],
 ". Hence the curvatures of all the vertices add up to ",
 StyleBox["V \[Minus] E + F", "TI"],
 ". When every vertex has the same configuration, ",
 StyleBox["V \[Kappa]", "TI"],
 " is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationEulerCharacteristic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/\
TessellationEulerCharacteristic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c6fab614-86d9-4c5d-9579-fae4e3963ec6"],
 "."
}], "Notes",ExpressionUUID->"b000f416-f861-4b29-9b58-9deb3bcbb51f"],

Cell["\<\
The curvature is a function of the configuration. It is not read off a graph, \
since one graph can carry maps of different types.\
\>", "Notes",ExpressionUUID->"a9221b54-7266-4739-b02a-cc7796858ce0"]
}, Open  ]],

