Cell[TextData[{
 "A list of two numbers is a symbol {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "}, never a configuration of two faces. The dihedron {5, 2} has two \
pentagons at every vertex, while {5, 5} is the type with five pentagons at \
every vertex."
}], "ExampleText",ExpressionUUID->"defa6faf-9bc6-4414-a5a2-0a80dd3f65cd"],

