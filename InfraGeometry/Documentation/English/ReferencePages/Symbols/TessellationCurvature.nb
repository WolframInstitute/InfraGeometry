Cell[CellGroupData[{
Cell["TessellationCurvature", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ae7e4efe-e9c5-4198-a492-cf2b29f8cb97"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationCurvature"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationCurvature", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["p", "TI"], ",", " ", 
     StyleBox["q", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee1c96d1-0038-4b42-b9f6-53809c1cdfaa"],
 "\[LineSeparator]",
 "gives the combinatorial curvature at a vertex of the tiling by ",
 StyleBox["p", "TI"],
 "-gons, ",
 StyleBox["q", "TI"],
 " at every vertex.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"fcdb0298-b157-4706-86a0-b80b7bfe4ec3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationCurvature"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationCurvature", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["config", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb023b48-e586-43d3-8bef-cfd3822be0b1"],
 "\[LineSeparator]",
 "gives the curvature at a vertex with the vertex configuration ",
 StyleBox["config", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"702f6d70-d8cb-4042-a38a-6508f6e60dec"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationCurvature"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationCurvature", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fecade0-a627-4811-9f90-18d85d732e83"],
 "\[LineSeparator]",
 "reads a regular configuration off the graph ",
 StyleBox["g", "TI"],
 " of a closed map."
}], "Usage",ExpressionUUID->"1825cb3d-e23a-4893-ad47-7a230d6999b4"],

Cell[TextData[{
 "Definition: at a vertex surrounded by ",
 StyleBox["k", "TI"],
 " faces with ",
 StyleBox["f", "TI"],
 "\:2081, \[Ellipsis], ",
 StyleBox["f", "TI"],
 "\:2096 sides, the combinatorial curvature is ",
 StyleBox["\[Kappa] = \[CapitalSigma]\:1d62 1/f\:1d62 \[Minus] (k \[Minus] \
2)/2", "TI"],
 ". For {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} it is ",
 StyleBox["\[Kappa] = q/p \[Minus] (q \[Minus] 2)/2 = (4 \[Minus] (p \[Minus] \
2)(q \[Minus] 2))/(2p)", "TI"],
 "."
}], "Notes",ExpressionUUID->"7149d274-8a69-4dd2-8ede-653ba4107d21"],

Cell[TextData[{
 "When the faces are regular polygons, 2\[Pi]",
 StyleBox["\[Kappa]", "TI"],
 " is the angle defect at the vertex: 2\[Pi] less the sum of the face angles \
\[Pi](1 \[Minus] 2/",
 StyleBox["f\:1d62", "TI"],
 "). Its sign says where the tiling lives: ",
 StyleBox["\[Kappa]", "TI"],
 " > 0 on the sphere, ",
 StyleBox["\[Kappa]", "TI"],
 " = 0 in the plane or on a flat torus, ",
 StyleBox["\[Kappa]", "TI"],
 " < 0 in the hyperbolic plane."
}], "Notes",ExpressionUUID->"e6d6a2d1-8d40-432d-83d9-b6f063f8ada1"],

Cell[TextData[{
 "On a closed map the curvatures of the vertices add up to the Euler \
characteristic, a discrete Gauss\[Dash]Bonnet theorem. Each face has ",
 StyleBox["f", "TI"],
 " corners, each counted 1/",
 StyleBox["f", "TI"],
 ", so the first terms add up to ",
 StyleBox["F", "TI"],
 "; the degrees add up to 2",
 StyleBox["E", "TI"],
 ", so the second terms add up to ",
 StyleBox["E \[Minus] V", "TI"],
 ". Hence the curvatures of all the vertices add up to ",
 StyleBox["V \[Minus] E + F", "TI"],
 ". When every vertex has the same configuration, ",
 StyleBox["V \[Kappa]", "TI"],
 " is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationEulerCharacteristic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/\
TessellationEulerCharacteristic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "743d1556-4615-4f78-b48d-13f609046d64"],
 "."
}], "Notes",ExpressionUUID->"f1738717-72c0-4c53-9a7a-28fb53f5f43b"],

Cell[TextData[{
 "The graph form reads the configuration as {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} with ",
 StyleBox["p", "TI"],
 " the girth of ",
 StyleBox["g", "TI"],
 ", the length of its shortest cycle, and ",
 StyleBox["q", "TI"],
 " its least degree. That is right for a regular map whose faces are its \
shortest cycles."
}], "Notes",ExpressionUUID->"a54fc741-08da-49aa-aba8-3efc4ab7fb93"]
}, Open  ]],

