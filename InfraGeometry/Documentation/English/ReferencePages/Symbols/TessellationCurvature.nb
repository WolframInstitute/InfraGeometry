Cell[TextData[{
 "The curvature of the regular tilings {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} against ",
 StyleBox["q", "TI"],
 ". It is positive for the five Platonic solids, zero for {4, 4}, {3, 6} and \
{6, 3}, and negative everywhere else."
}], "ExampleText",ExpressionUUID->"15614547-bff0-4275-9fe8-9c370a129f52"],

