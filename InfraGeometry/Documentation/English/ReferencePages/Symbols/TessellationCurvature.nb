Cell[TextData[{
 "So the genus of a map is 1 \[Minus] ",
 StyleBox["V \[Kappa]", "TI"],
 "/2, the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationGenus"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationGenus", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "671d7f58-ec08-4d73-92e4-def6eb4fdc08"],
 " of its type and size: 3 for the Klein quartic, 24 vertices of curvature \
\[Minus]1/6."
}], "ExampleText",ExpressionUUID->"4beb8e0f-84fe-4c44-9368-21130beda6e9"],

