    "\n", "\t", 
   RowBox[{"{", " ", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", " ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"a", ",", " ", "b"}], " ", "}"}], ",", " ", 
       RowBox[{"{", " ", 
