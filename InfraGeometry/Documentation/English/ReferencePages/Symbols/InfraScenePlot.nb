Cell["\<\
The default display follows declaration order, omits unbound objects and \
excludes extra initial bindings. Explicitly requested unresolved names remain \
unevaluated.\
\>", "Notes",ExpressionUUID->"c3f5738a-a7d2-4b70-a4af-9c86fe8650b4"],

Cell[TextData[{
 "A named side draws its saved walk. An explicit ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e87d7f5-4705-43df-9d1c-649ae51d43bd"],
 " draws all shortest paths between its saved endpoint values. Further \
assertions on the sampled side are not reapplied to this family."
}], "Notes",ExpressionUUID->"605e8566-a968-4afa-aee9-76d9540fd3e9"],

Cell[TextData[{
 "Object kinds come from the scene declarations. Literal vertex labels and \
saved values are preserved; an undeclared list binding needs an explicit \
interpretation such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
