Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "101", " ", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", " ", 
   RowBox[{"a", ",", " ", "b", ",", " ", "ab"}], " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "\t", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", " ", 
      RowBox[{"{", " ", 
       RowBox[{"3", ",", " ", "3"}], " ", "}"}], " ", "]"}]}], " ", "}"}], ",",
    "\n", "\t", 
   RowBox[{"{", " ", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", " ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{"a", ",", " ", "b", ",", " ", "ab"}], " ", "}"}], ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"a", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", " ", "]"}]}], ",", " ", 
         RowBox[{"b", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", " ", "]"}]}], ",", " ", 
         RowBox[{"ab", " ", "==", " ", 
          RowBox[{"InfraSegment", "[", " ", 
           RowBox[{"a", ",", " ", "b"}], " ", "]"}]}]}], " ", "}"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "\t", 
   RowBox[{"{", " ", 
    RowBox[{"instance", " ", "=", " ", 
     RowBox[{"InfraSceneInstance", "[", " ", 
      RowBox[{"<|", " ", 
       RowBox[{
        RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
        RowBox[{"b", " ", "->", " ", "9"}], ",", " ", 
        RowBox[{"ab", " ", "->", " ", 
         RowBox[{"{", " ", 
          RowBox[{
          "1", ",", " ", "2", ",", " ", "3", ",", " ", "6", ",", " ", "9"}], 
          " ", "}"}]}]}], " ", "|>"}], " ", "]"}]}], " ", "}"}], ",", "\n", 
   "\t", 
   RowBox[{"InfraScenePlot", "[", " ", 
    RowBox[{"scene", ",", " ", "g", ",", " ", "instance"}], " ", "]"}]}], " ",
   "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"25bc678b-c69d-483c-9250-66a24403fec0"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3, 4, 5, 6, 7, 8, 9}, {Null, 
       SparseArray[
       Automatic, {9, 9}, 0, {
        1, {{0, 2, 5, 7, 10, 14, 17, 19, 22, 24}, {{2}, {4}, {1}, {3}, {5}, {
          2}, {6}, {1}, {5}, {7}, {2}, {4}, {6}, {8}, {3}, {5}, {9}, {4}, {
          8}, {5}, {7}, {9}, {6}, {8}}}, Pattern}]}, {
      EdgeShapeFunction -> {
        UndirectedEdge[2, 3] -> ({}& ), UndirectedEdge[3, 6] -> ({}& ), 
         UndirectedEdge[1, 2] -> ({
           JoinForm["Round"], 
           CapForm["Round"], 
           If[
            And[
             MatchQ[
              Part[{{
                 UndirectedEdge[1, 2], 
                 UndirectedEdge[2, 3], 
                 UndirectedEdge[3, 6], 
                 UndirectedEdge[6, 9]}, {{1., 1.}, {1., 2.}, {1., 3.}, {2., 
                3.}, {3., 3.}}, True, None}, 4], 
              Blank[Arrowheads]], 
             Part[{{
                UndirectedEdge[1, 2], 
                UndirectedEdge[2, 3], 
                UndirectedEdge[3, 6], 
                UndirectedEdge[6, 9]}, {{1., 1.}, {1., 2.}, {1., 3.}, {2., 
               3.}, {3., 3.}}, True, None}, 3]], 
            Apply[Sequence, {
              Part[{{
                 UndirectedEdge[1, 2], 
                 UndirectedEdge[2, 3], 
                 UndirectedEdge[3, 6], 
                 UndirectedEdge[6, 9]}, {{1., 1.}, {1., 2.}, {1., 3.}, {2., 
                3.}, {3., 3.}}, True, None}, 4], 
              Arrow[
               Part[{{
                  UndirectedEdge[1, 2], 
                  UndirectedEdge[2, 3], 
                  UndirectedEdge[3, 6], 
                  UndirectedEdge[6, 9]}, {{1., 1.}, {1., 2.}, {1., 3.}, {2., 
                 3.}, {3., 3.}}, True, None}, 2]]}], 
            Line[
             Part[{{
                UndirectedEdge[1, 2], 
                UndirectedEdge[2, 3], 
                UndirectedEdge[3, 6], 
                UndirectedEdge[6, 9]}, {{1., 1.}, {1., 2.}, {1., 3.}, {2., 
               3.}, {3., 3.}}, True, None}, 2]]]}& ), 
         UndirectedEdge[6, 9] -> ({}& )}, 
       EdgeStyle -> {UndirectedEdge[6, 9] -> Directive[
           RGBColor[1., 0.607843, 0.], 
           Opacity[1], 
           AbsoluteThickness[1.]], UndirectedEdge[2, 3] -> Directive[
           RGBColor[1., 0.607843, 0.], 
           Opacity[1], 
           AbsoluteThickness[1.]], UndirectedEdge[1, 2] -> Directive[
           RGBColor[1., 0.607843, 0.], 
           Opacity[1], 
           AbsoluteThickness[1.]], UndirectedEdge[3, 6] -> Directive[
           RGBColor[1., 0.607843, 0.], 
           Opacity[1], 
           AbsoluteThickness[1.]]}, GraphHighlight -> {6, 1, 9, 3, 2}, 
       GraphHighlightStyle -> {1 -> {VertexStyle -> {
             Directive[
              RGBColor[1., 0.607843, 0.], 
              Opacity[1]]}}, 3 -> {VertexStyle -> {
             Directive[
              RGBColor[1., 0.607843, 0.], 
              Opacity[1]]}}, 9 -> {VertexStyle -> {
             Directive[
              RGBColor[1., 0.607843, 0.], 
              Opacity[1]]}}, 2 -> {VertexStyle -> {
             Directive[
              RGBColor[1., 0.607843, 0.], 
              Opacity[1]]}}, 6 -> {VertexStyle -> {
             Directive[
              RGBColor[1., 0.607843, 0.], 
