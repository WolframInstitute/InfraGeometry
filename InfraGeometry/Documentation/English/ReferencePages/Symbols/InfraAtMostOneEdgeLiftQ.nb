Cell["\<\
Random fibered graphs with two vertices in every fiber and at most one lift \
of each base edge, over the square grid and the square mesh. Some total \
vertices have no lift, so they are not fibrations:\
\>", "ExampleText",ExpressionUUID->"580f7771-3fd9-493d-8dc3-07d7302d14fc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"xy", " ", "=", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"fib", " ", "=", " ", 
        RowBox[{"RandomInfraFiberedGraph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"Properties", " ", "->", " ", 
           RowBox[{"{", "\"\<AtMostOneEdgeLift\>\"", "}"}]}], ",", " ", 
          RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
           RowBox[{"{", "2", "}"}]}], ",", "\n", "      ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraFiberedGraphHighlight", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"{", "}"}], ",", " ", 
        RowBox[{"\"\<BaseVertexCoordinates\>\"", " ", "->", " ", "xy"}], ",", 
        "\n", "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraAtMostOneEdgeLiftQ", "[", "fib", "]"}], ",", " ", 
           RowBox[{"InfraFibrationQ", "[", "fib", "]"}]}], "}"}]}]}], "]"}]}],
      "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"5d2e13eb-4b9a-46e7-84ae-b661ff2743be"],

