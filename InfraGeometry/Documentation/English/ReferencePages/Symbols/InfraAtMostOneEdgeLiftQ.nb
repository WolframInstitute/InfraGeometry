Notebook[{

Cell[CellGroupData[{
Cell["InfraAtMostOneEdgeLiftQ", "ObjectName",ExpressionUUID->"20581570-3a3b-463c-9721-c7113e52c732"],

Cell["LLM generated.", "Notes",ExpressionUUID->"ad681a14-9060-45ee-92bf-ecd17c1b3c40"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b7c0c74d-8517-4d00-b200-d8a7941a1d0e"],
 Cell[BoxData[
  RowBox[{"InfraAtMostOneEdgeLiftQ", "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d5f720d-45f6-4b78-9e16-1fc453429435"],
 "\[LineSeparator]",
 "tests whether each total vertex has at most one neighbour over each \
adjacent base vertex.",
 "\n"
}], "Usage",ExpressionUUID->"88257b24-6eff-4d78-b350-405d738537a7"],

Cell["\<\
Only transverse neighbours are counted. Vertical edges do not affect the \
condition.\
\>", "Notes",ExpressionUUID->"22432543-151a-4c58-92d2-3d5f98623498"],

Cell["\<\
Over each base edge, the transverse edges form a matching, possibly \
incomplete.\
\>", "Notes",ExpressionUUID->"6713b775-641b-46c9-8009-68d8b86d6ce1"],

Cell["\<\
In the transverse neighbourhood, the projection is locally injective. This \
says nothing about injectivity within a fiber.\
\>", "Notes",ExpressionUUID->"6a9f5094-093e-4860-becb-0fa48b52d4d7"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibrationQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9d362495-182c-4d71-bc41-78f18e06cba4"],
 " adds existence. Together the two conditions are ",
 Cell[BoxData["InfraUniqueEdgeLiftingQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed38fa6f-9c9f-4a19-87d6-e5526247cf72"],
 "."
}], "Notes",ExpressionUUID->"668ac3c9-afa0-48ec-a330-2ffa5d59d8f6"],

Cell["The empty fibered graph satisfies the condition vacuously.", "Notes",ExpressionUUID->"c4f59774-e317-445c-a8cc-5b5e396c3809"],

Cell["\<\
A nonempty list is tested by conjunction; an empty list gives False. \
Unsupported inputs remain unevaluated.\
\>", "Notes",ExpressionUUID->"bd649114-f522-4e38-8798-3f9c05aa1965"]
}, Open  ]],

