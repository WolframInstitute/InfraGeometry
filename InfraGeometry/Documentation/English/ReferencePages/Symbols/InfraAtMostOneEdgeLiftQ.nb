Cell[CellGroupData[{
Cell["InfraAtMostOneEdgeLiftQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7bf77a34-a657-445a-971a-07594bc21d46"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraAtMostOneEdgeLiftQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraAtMostOneEdgeLiftQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9634035-1a44-4d9b-ae8d-dec5d7f80923"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e806ca12-8bb3-425a-a9a2-a9e979c92030"],
 " if every total vertex of the fibered graph ",
 StyleBox["fib", "TI"],
 " has at most one neighbour over each neighbour of its base vertex.",
 "\n"
}], "Usage",ExpressionUUID->"e9d1ee8c-3c80-4721-8d2e-519c46e8fa8a"],

Cell[TextData[{
 "The condition is ",
 StyleBox["|N(x) \:2229 F(q)| \[LessEqual] 1", "TI"],
 " for every total vertex ",
 StyleBox["x", "TI"],
 " over ",
 StyleBox["p", "TI"],
 " and every base neighbour ",
 StyleBox["q", "TI"],
 " of ",
 StyleBox["p", "TI"],
 ", with ",
 StyleBox["N(x)", "TI"],
 " the neighbours of ",
 StyleBox["x", "TI"],
 " and ",
 StyleBox["F(q)", "TI"],
 " the fiber over ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"dde13b97-b3b5-420f-8dd9-c1c9af11062d"],

Cell["\<\
Over every base edge the total edges then form a matching between the two \
fibers, possibly not perfect. Vertical edges, inside one fiber, do not count.\
\
\>", "Notes",ExpressionUUID->"ebdbb366-416d-414f-b918-738f5e3beaea"],

Cell[TextData[{
 "The projection is injective on the neighbours of ",
 StyleBox["x", "TI"],
 " outside its fiber. Nothing is said about injectivity inside a fiber."
}], "Notes",ExpressionUUID->"cf4d86b1-5ae6-4057-bce2-3c05b99cbdd4"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
