Cell[TextData[{
 "The displacement bundle of the grid at scale 1 fails the condition. A pair \
{",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "} has 4 lifts over ",
 StyleBox["v", "TI"],
 ", 2 over each base neighbour of ",
 StyleBox["p", "TI"],
 " across the direction and 1 over the one behind ",
 StyleBox["p", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"b0d39616-998a-496e-93ca-83b22fcf9d9f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"fib", " ", "=", " ", 
      RowBox[{"InfraDisplacementBundle", "[", 
       RowBox[{"g", ",", " ", "1"}], "]"}]}], ",", " ", 
     RowBox[{"v", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"AdjacencyList", "[", 
        RowBox[{"g", ",", " ", "c"}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraAtMostOneEdgeLiftQ", "[", "fib", "]"}], ",", " ", "v", ",",
      " ", 
     RowBox[{
      RowBox[{"InfraEdgeLiftMultiplicity", "[", "fib", "]"}], "[", 
      RowBox[{"{", 
       RowBox[{"c", ",", " ", "v"}], "}"}], "]"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[3]:= ",ExpressionUUID->"a6e29ba5-3c5c-46f3-ab89-6a4b9835d057"],

