Cell["\<\
The number of lifts over each base neighbour, counted over all total vertices \
of the first example. Every count is 0 or 1:\
\>", "ExampleText",ExpressionUUID->"95d75244-f15e-4563-8062-2c7485722289"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<AtMostOneEdgeLift\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", "\n", "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Counts", " ", "@", " ", 
    RowBox[{"Catenate", "[", 
     RowBox[{"Values", " ", "/@", " ", 
      RowBox[{"Values", " ", "@", " ", 
       RowBox[{"InfraEdgeLiftMultiplicity", "[", "fib", "]"}]}]}], "]"}]}]}], 
  "]"}]], "Input",
