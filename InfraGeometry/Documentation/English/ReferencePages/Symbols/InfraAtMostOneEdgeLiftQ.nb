Cell[CellGroupData[{
Cell["InfraAtMostOneEdgeLiftQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1871dafc-d113-4b82-ab44-643559f10c2c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraAtMostOneEdgeLiftQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraAtMostOneEdgeLiftQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "905c65a4-472f-4c03-baae-4dd208c0d2e5"],
 "\[LineSeparator]",
 "tests whether each total vertex has at most one neighbour over each \
adjacent base vertex.",
 "\n"
}], "Usage",ExpressionUUID->"6dd6d6dd-4356-4103-ab90-f1b95ffb1b45"],

Cell["\<\
Only transverse neighbours are counted. Vertical edges do not affect the \
condition.\
\>", "Notes",ExpressionUUID->"022f9c7e-7d81-4ee2-b975-28121718657e"],

Cell["\<\
Over each base edge, the transverse edges form a matching, possibly \
incomplete.\
\>", "Notes",ExpressionUUID->"26ecd65f-a37f-4c09-b12e-d36408700eb5"],

Cell["\<\
In the transverse neighbourhood, the projection is locally injective. This \
says nothing about injectivity within a fiber.\
\>", "Notes",ExpressionUUID->"651973d6-5fc1-4872-b03c-74f420f40588"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibrationQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "edfa26e2-fd39-4ca5-8ef5-7a92e282f265"],
 " adds existence. Together the two conditions are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUniqueEdgeLiftingQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUniqueEdgeLiftingQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a2be460d-76ce-43eb-8378-dc487d0ce1ba"],
 "."
}], "Notes",ExpressionUUID->"c72317e6-6edc-4bd5-a764-24d211a123ad"],

Cell["The empty fibered graph satisfies the condition vacuously.", "Notes",ExpressionUUID->"507f9517-5e6d-4936-b79b-d8c64e182808"],

Cell["\<\
A nonempty list is tested by conjunction; an empty list gives False. \
Unsupported inputs remain unevaluated.\
\>", "Notes",ExpressionUUID->"5079f6f8-b9ec-45e9-a32f-4519f16e3ac3"]
}, Open  ]],

