Cell[TextData[{
 "A fibration with at most one lift has exactly one. On the catalogue entries \
over the cycle of length 8, the condition and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibrationQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "06e04624-fb84-4760-b06b-27865b3d55fc"],
 " together give ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUniqueEdgeLiftingQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUniqueEdgeLiftingQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "82ca51e5-d3f7-4143-a498-ca41b0c5efe8"],
 ":"
}], "ExampleText",ExpressionUUID->"60a38879-ad22-4fb8-b5d0-5ead638d48d8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fib", " ", "=", " ", 
       RowBox[{"InfraFiberedSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
       RowBox[{"InfraAtMostOneEdgeLiftQ", "[", "fib", "]"}], ",", " ", 
       RowBox[{"InfraUniqueEdgeLiftingQ", "[", "fib", "]"}]}], "}"}]}], "]"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<CycleProductBundle\>\"", ",", 
       " ", "\"\<MoebiusLadderCover\>\"", ",", 
       " ", "\"\<BranchedCycleFibration\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5bab1e20-5f5e-4061-9416-b224eb004f4d"],

