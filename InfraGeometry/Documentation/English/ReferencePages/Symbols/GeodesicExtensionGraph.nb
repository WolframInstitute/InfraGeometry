Cell["The two sides of a line through the edge 1\[Dash]2 of the 6-cycle.", \
"ExampleText",ExpressionUUID->"5a607830-5174-4e3f-8cb7-a3e7847dae8f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Sort", " ", "@", " ", 
    RowBox[{"VertexList", " ", "@", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "1"}], "}"}]}], "]"}]}]}], ",", "\n", " ", 
   RowBox[{"Sort", " ", "@", " ", 
    RowBox[{"VertexList", " ", "@", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}]}]}], "}"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"bf9dbb5d-0d2e-4733-be5c-cb92d2f20b6d"],

