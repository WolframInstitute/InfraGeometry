  "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"58fb6309-2421-48dc-9eff-25324f735415"]
}, Open  ]],

Cell["\<\
Beyond the diagonal from the corner 1 through the centre 5, only the far \
quadrant remains, and the single sink is the opposite corner.\
\>", "ExampleText",ExpressionUUID->"244de6a3-97f5-4496-a373-d08dab70e252"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"VertexList", "[", "h", "]"}]}], ",", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "h", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexOutDegree", "[", 
          RowBox[{"h", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], " ", 
        "&"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"980d87d7-5f82-49f4-9545-a05c7d0232df"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
