Notebook[{

Cell[CellGroupData[{
Cell["GeodesicExtensionGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c4b13df9-027c-43aa-8328-12e955ec3a54"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "279bdfd9-731e-4db6-9d7c-f11d91ec9528"],
 "\[LineSeparator]",
 "gives the DAG of all geodesic extensions of the segment ",
 StyleBox["p1", "TI"],
 " \[RightArrow] ",
 StyleBox["p2", "TI"],
 " beyond ",
 StyleBox["p2", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"343a365f-cf6e-4992-b435-b842f87d5df5"],

Cell[TextData[{
 "The vertex set is {",
 StyleBox["e", "TI"],
 " : ",
 StyleBox["d(p1, e) = d(p1, p2) + d(p2, e)", "TI"],
 "} \[LongDash] the vertices that some geodesic from ",
 StyleBox["p1", "TI"],
 " through ",
 StyleBox["p2", "TI"],
 " reaches beyond ",
 StyleBox["p2", "TI"],
 " \[LongDash] and the edges are the edges of ",
 StyleBox["g", "TI"],
 " along increasing distance from ",
 StyleBox["p1", "TI"],
 ". The source is ",
 StyleBox["p2", "TI"],
 "."
}], "Notes",ExpressionUUID->"01e797d0-c3ff-4ed1-b0dc-041116c9f01b"],

Cell[TextData[{
 "The set is closed under such a step: if ",
 StyleBox["u", "TI"],
 " is in it and ",
 StyleBox["v", "TI"],
 " is a neighbour of ",
 StyleBox["u", "TI"],
 " one step farther from ",
 StyleBox["p1", "TI"],
 ", then ",
 StyleBox["v", "TI"],
 " is in it too. So the directed paths from ",
 StyleBox["p2", "TI"],
 " are exactly the geodesics from ",
 StyleBox["p2", "TI"],
 " that stay geodesic behind any ",
 StyleBox["p1", "TI"],
 " \[RightArrow] ",
 StyleBox["p2", "TI"],
 " geodesic, and the ",
 StyleBox["sinks",
  FontWeight->"Bold"],
 " are the vertices past which no such geodesic can be prolonged \[LongDash] \
the ends of the rays from ",
 StyleBox["p1", "TI"],
 " through ",
 StyleBox["p2", "TI"],
 "."
}], "Notes",ExpressionUUID->"ad3f35d5-c179-4d39-be9a-f9430dbdef3d"],

Cell[TextData[{
 "This is the shared engine of the distance-matrix family. The graph of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3b148d1-8d86-421f-adfc-5b287f422391"],
 " is the geodesic interval from ",
 StyleBox["p1", "TI"],
 " to ",
 StyleBox["p2", "TI"],
 " glued at ",
 StyleBox["p2", "TI"],
 " to this DAG. The two sides of a line through ",
 StyleBox["p1", "TI"],
 " and ",
 StyleBox["p2", "TI"],
 " are ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p2", "TI"], ",", " ", 
      StyleBox["p1", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cdb2ab77-1a56-4387-a870-89dd2da3851c"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "506771c9-f663-4877-8b73-da588cd1a1f8"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b57c137-e512-4352-8259-53ac821da7d2"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExtendInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7893d0f6-fc33-46a2-b8a6-91c348ce5f0a"],
 " pick their ends from these two, subject to joint geodesicity."
}], "Notes",ExpressionUUID->"7694eb9b-5f6f-445c-b0d7-9b8d3a943d58"],

Cell[TextData[{
 "With ",
 StyleBox["p1", "TI"],
 " = ",
 StyleBox["p2", "TI"],
 " the condition is empty and the result is the whole spray, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicSprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicSprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30961a4b-c5ef-49d2-9274-883069d3da04"],
 "."
}], "Notes",ExpressionUUID->"557dfe1d-2ce3-4b3d-b7a8-b403f5bea046"],

Cell[TextData[{
 "A density anchor ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", "m"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a23575a2-c9ac-41fd-953f-fa7d8b6a510f"],
 " spreads to one DAG per pair of anchor vertices, returned as a list. A bare \
vertex list is one anchor, not a family."
}], "Notes",ExpressionUUID->"b8fb1974-b312-48a1-ab8c-f1052dfa14cd"],

Cell[TextData[{
 "The graph keeps the embedding coordinates of ",
 StyleBox["g", "TI"],
 ", so it draws in place."
}], "Notes",ExpressionUUID->"24643b56-2b71-45a5-84ff-78e08fa7bed7"]
}, Open  ]],

