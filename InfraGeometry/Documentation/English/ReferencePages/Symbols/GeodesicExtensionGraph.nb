Cell["The two sides of a line through the edge 1\[Dash]2 of the 6-cycle.", \
"ExampleText",ExpressionUUID->"26365648-789f-4c40-9bdb-4f28acf06640"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Sort", " ", "@", " ", 
    RowBox[{"VertexList", " ", "@", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "1"}], "}"}]}], "]"}]}]}], ",", "\n", " ", 
   RowBox[{"Sort", " ", "@", " ", 
    RowBox[{"VertexList", " ", "@", " ", 
