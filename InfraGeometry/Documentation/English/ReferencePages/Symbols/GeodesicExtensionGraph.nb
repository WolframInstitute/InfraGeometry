Notebook[{

Cell[CellGroupData[{
Cell["GeodesicExtensionGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9926189a-2740-493b-ad6a-9c4b4d1c8c1b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ccfb792-19c7-4099-898d-f9286b74ee36"],
 "\[LineSeparator]",
 "gives the DAG of all geodesic extensions of the segment ",
 StyleBox["p1", "TI"],
 " \[RightArrow] ",
 StyleBox["p2", "TI"],
 " beyond ",
 StyleBox["p2", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"82ceb9c4-eb94-4225-9964-bfea1db2962e"],

Cell[TextData[{
 "The vertex set is {",
 StyleBox["e", "TI"],
 " : ",
 StyleBox["d(p1, e) = d(p1, p2) + d(p2, e)", "TI"],
 "} \[LongDash] the vertices that some geodesic from ",
 StyleBox["p1", "TI"],
 " through ",
 StyleBox["p2", "TI"],
 " reaches beyond ",
 StyleBox["p2", "TI"],
 " \[LongDash] and the edges are the edges of ",
 StyleBox["g", "TI"],
 " along increasing distance from ",
 StyleBox["p1", "TI"],
 ". The source is ",
 StyleBox["p2", "TI"],
 "."
}], "Notes",ExpressionUUID->"45fe4654-3a02-49eb-a4e3-0fe697960828"],

Cell[TextData[{
 "The set is closed under such a step: if ",
 StyleBox["u", "TI"],
 " is in it and ",
 StyleBox["v", "TI"],
 " is a neighbour of ",
 StyleBox["u", "TI"],
 " one step farther from ",
 StyleBox["p1", "TI"],
 ", then ",
 StyleBox["v", "TI"],
 " is in it too. So the directed paths from ",
 StyleBox["p2", "TI"],
 " are exactly the geodesics from ",
 StyleBox["p2", "TI"],
 " that stay geodesic behind any ",
 StyleBox["p1", "TI"],
 " \[RightArrow] ",
 StyleBox["p2", "TI"],
 " geodesic, and the ",
 StyleBox["sinks",
  FontWeight->"Bold"],
 " are the vertices past which no such geodesic can be prolonged \[LongDash] \
the ends of the rays from ",
 StyleBox["p1", "TI"],
 " through ",
 StyleBox["p2", "TI"],
 "."
}], "Notes",ExpressionUUID->"53905763-8f42-4c31-ba0d-cc6883371d77"],

Cell[TextData[{
 "This is the shared engine of the distance-matrix family. The graph of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87d1b69d-2637-4bc3-be97-1fbc1a7a92a4"],
 " is the geodesic interval from ",
 StyleBox["p1", "TI"],
 " to ",
 StyleBox["p2", "TI"],
 " glued at ",
 StyleBox["p2", "TI"],
 " to this DAG. The two sides of a line through ",
 StyleBox["p1", "TI"],
 " and ",
 StyleBox["p2", "TI"],
 " are ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p2", "TI"], ",", " ", 
      StyleBox["p1", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64ad4083-4359-4ba9-8988-2a2c7af7fda8"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12407c12-882b-4ec4-bb26-6f819c74352c"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32a6e513-480e-4e9a-9a16-54a619616e97"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExtendInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4bc9ba6f-aff9-4cf3-ad1b-07654f4d2e3d"],
 " pick their ends from these two, subject to joint geodesicity."
}], "Notes",ExpressionUUID->"2c25ac95-bc09-4aa4-b045-0609e8848ecc"],

Cell[TextData[{
 "With ",
 StyleBox["p1", "TI"],
 " = ",
 StyleBox["p2", "TI"],
 " the condition is empty and the result is the whole spray, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9db381f4-e65f-4f20-8b75-e9014196e342"],
 "."
}], "Notes",ExpressionUUID->"8922d0f9-b8bd-445a-8a55-48151c1fe722"],

Cell[TextData[{
 "A density anchor ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", "m"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20a063f1-7c50-4c40-8911-da93a1ffce87"],
 " spreads to one DAG per pair of anchor vertices, returned as a list. A bare \
vertex list is one anchor, not a family."
}], "Notes",ExpressionUUID->"3a370829-7c5b-4f1e-961a-dbbe293bda33"],

Cell[TextData[{
 "The graph keeps the embedding coordinates of ",
 StyleBox["g", "TI"],
 ", so it draws in place."
}], "Notes",ExpressionUUID->"819d3b20-b653-4018-9131-2812df878f2a"]
}, Open  ]],

