       RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "1"}], "}"}]}], "]"}]}]}], ",", "\n", " ", 
   RowBox[{"Sort", " ", "@", " ", 
