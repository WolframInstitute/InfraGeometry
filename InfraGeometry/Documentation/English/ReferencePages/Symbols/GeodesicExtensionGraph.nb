Cell["The two sides of a line through the edge 1\[Dash]2 of the 6-cycle.", \
"ExampleText",ExpressionUUID->"e5e7aadc-ace6-4a8c-9d3c-5d5aaa66b44f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Sort", " ", "@", " ", 
    RowBox[{"VertexList", " ", "@", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
