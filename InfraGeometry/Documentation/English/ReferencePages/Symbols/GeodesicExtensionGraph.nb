Cell["\<\
With the anchor as its own direction the extension graph is the spray.\
\>", "ExampleText",ExpressionUUID->"2bbb9078-4c8e-4b98-b7bc-eec06a710778"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"EdgeList", " ", "@", " ", 
      RowBox[{"GeodesicExtensionGraph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "5"}], "}"}]}], "]"}]}]}], " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"EdgeList", " ", "@", " ", 
      RowBox[{"SprayGraph", "[", 
       RowBox[{"g", ",", " ", "5"}], "]"}]}]}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8294cdb2-d1de-405b-b959-20e332fe7d16"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"fd6743e6-50d9-49b2-88f2-48d54e12a099"]
}, Open  ]],

Cell[TextData[{
 "The vertex set is closed under a farther step: every neighbour of a vertex \
in the graph that lies one step farther from ",
 StyleBox["p1", "TI"],
 " is in the graph."
}], "ExampleText",ExpressionUUID->"aefaa6be-aea7-4b99-b86f-4282fe3403c4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"VertexList", "[", "h", "]"}], ",", "\n", "    ", 
     RowBox[{"vx", " ", "|->", " ", 
      RowBox[{"AllTrue", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"AdjacencyList", "[", 
           RowBox[{"g", ",", " ", "vx"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "1", ",", " ", "#"}], "]"}], " ", "==", 
            " ", 
            RowBox[{
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", "1", ",", " ", "vx"}], "]"}], " ", "+", 
             " ", "1"}]}], " ", "&"}]}], "]"}], ",", "\n", "      ", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "h", "]"}], ",", " ", "#"}], "]"}], " ",
          "&"}]}], "]"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"390ca94a-cc51-4528-9227-0efd4b33e74d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"a83cc872-eb7a-4eb7-9c1d-0287a13a3dec"]
}, Open  ]],

Cell[TextData[{
 "The sinks are the ends of the rays from ",
 StyleBox["p1", "TI"],
 " through ",
 StyleBox["p2", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"2970a291-f549-4282-b1b5-c3cb21f4fbc1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"6", ",", " ", "7"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "h", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexOutDegree", "[", 
          RowBox[{"h", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], " ", 
        "&"}]}], "]"}]}], " ", "===", "\n", "    ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"Last", " ", "/@", " ", 
       RowBox[{"FindInfraRay", "[", 
        RowBox[{"g", ",", " ", "6", ",", " ", "7", ",", " ", "All"}], "]"}]}],
       "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"85dead53-2b91-4640-bdb8-4ae6d258ebbe"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"4e19fcc6-0e9c-4280-936e-b87479c3ccad"]
}, Open  ]]
}, Open  ]],

