Notebook[{

Cell[CellGroupData[{
Cell["GeodesicExtensionGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"077028bb-997c-435d-b253-9807bd94bf60"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1e81bb5-9daf-43d7-9e4f-0193432655a5"],
 "\[LineSeparator]",
 "gives the DAG of all geodesic extensions of the segment ",
 StyleBox["p1", "TI"],
 " \[RightArrow] ",
 StyleBox["p2", "TI"],
 " beyond ",
 StyleBox["p2", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"b46aedde-9ec1-4166-97f3-b14fbed52dd4"],

Cell[TextData[{
 "The vertex set is {",
 StyleBox["e", "TI"],
 " : ",
 StyleBox["d(p1, e) = d(p1, p2) + d(p2, e)", "TI"],
 "} \[LongDash] the vertices that some geodesic from ",
 StyleBox["p1", "TI"],
 " through ",
 StyleBox["p2", "TI"],
 " reaches beyond ",
 StyleBox["p2", "TI"],
 " \[LongDash] and the edges are the edges of ",
 StyleBox["g", "TI"],
 " along increasing distance from ",
 StyleBox["p1", "TI"],
 ". The source is ",
 StyleBox["p2", "TI"],
 "."
}], "Notes",ExpressionUUID->"1fd339e6-26dd-4ab1-8d29-ebe21280cbe5"],

Cell[TextData[{
 "The set is closed under such a step: if ",
 StyleBox["u", "TI"],
 " is in it and ",
 StyleBox["v", "TI"],
 " is a neighbour of ",
 StyleBox["u", "TI"],
 " one step farther from ",
 StyleBox["p1", "TI"],
 ", then ",
 StyleBox["v", "TI"],
 " is in it too. So the directed paths from ",
 StyleBox["p2", "TI"],
 " are exactly the geodesics from ",
 StyleBox["p2", "TI"],
 " that stay geodesic behind any ",
 StyleBox["p1", "TI"],
 " \[RightArrow] ",
 StyleBox["p2", "TI"],
 " geodesic, and the ",
 StyleBox["sinks",
  FontWeight->"Bold"],
 " are the vertices past which no such geodesic can be prolonged \[LongDash] \
the ends of the rays from ",
 StyleBox["p1", "TI"],
 " through ",
 StyleBox["p2", "TI"],
 "."
}], "Notes",ExpressionUUID->"a3962838-88c8-4bb0-8a0e-dd0557a865ae"],

Cell[TextData[{
 "This is the shared engine of the distance-matrix family. The graph of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ec91f99-7f95-4d0d-b09d-bb2257fa52b3"],
 " is the geodesic interval from ",
 StyleBox["p1", "TI"],
 " to ",
 StyleBox["p2", "TI"],
 " glued at ",
 StyleBox["p2", "TI"],
 " to this DAG. The two sides of a line through ",
 StyleBox["p1", "TI"],
 " and ",
 StyleBox["p2", "TI"],
 " are ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p2", "TI"], ",", " ", 
      StyleBox["p1", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe147773-a550-4028-9503-d410fcd953f2"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5bba1eb-a0cb-4988-b25b-5afa94402f95"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b922ebe4-db9d-43f8-aa01-11a1d999114e"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExtendInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5f54a324-ea22-47e3-94b3-b59ac45cb53f"],
 " pick their ends from these two, subject to joint geodesicity."
}], "Notes",ExpressionUUID->"4e342238-7fe8-4558-8de2-901388235b76"],

Cell[TextData[{
 "With ",
 StyleBox["p1", "TI"],
 " = ",
 StyleBox["p2", "TI"],
 " the condition is empty and the result is the whole spray, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ce1df87-70d2-4acd-8d90-cd8631191b67"],
 "."
}], "Notes",ExpressionUUID->"a41a5043-6603-474b-8d9e-1d6bac822b5c"],

Cell[TextData[{
 "A density anchor ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", "m"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "094d1f28-844e-487f-8208-8eea96a824d2"],
 " spreads to one DAG per pair of anchor vertices, returned as a list. A bare \
vertex list is one anchor, not a family."
}], "Notes",ExpressionUUID->"274d838e-99b5-4356-ae69-77c49aff9e18"],

Cell[TextData[{
 "The graph keeps the embedding coordinates of ",
 StyleBox["g", "TI"],
 ", so it draws in place."
}], "Notes",ExpressionUUID->"8203b47f-12d4-414a-bfab-d3500bf665f2"]
}, Open  ]],

