Cell["\<\
With the anchor as its own direction the extension graph is the spray.\
\>", "ExampleText",ExpressionUUID->"6d991cfc-44ab-4d23-af91-e31ab6a108f4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"EdgeList", " ", "@", " ", 
      RowBox[{"GeodesicExtensionGraph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "5"}], "}"}]}], "]"}]}]}], " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"EdgeList", " ", "@", " ", 
      RowBox[{"GeodesicSprayGraph", "[", 
       RowBox[{"g", ",", " ", "5"}], "]"}]}]}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"76112584-cc7a-4983-bf2a-8e1c98ac6fc8"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6f274895-3e50-483a-aeda-aec068db267a"]
}, Open  ]],

Cell[TextData[{
 "The vertex set is closed under a farther step: every neighbour of a vertex \
in the graph that lies one step farther from ",
 StyleBox["p1", "TI"],
 " is in the graph."
}], "ExampleText",ExpressionUUID->"1fdaf53c-4d9e-4224-b899-8617820006cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"VertexList", "[", "h", "]"}], ",", "\n", "    ", 
     RowBox[{"vx", " ", "|->", " ", 
      RowBox[{"AllTrue", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"AdjacencyList", "[", 
           RowBox[{"g", ",", " ", "vx"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "1", ",", " ", "#"}], "]"}], " ", "==", 
            " ", 
            RowBox[{
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", "1", ",", " ", "vx"}], "]"}], " ", "+", 
             " ", "1"}]}], " ", "&"}]}], "]"}], ",", "\n", "      ", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "h", "]"}], ",", " ", "#"}], "]"}], " ",
          "&"}]}], "]"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"71ef265f-019e-42e6-878a-3eb4b4953c49"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"3a8e9d99-3e01-4950-a824-90127778ca0d"]
}, Open  ]],

Cell[TextData[{
 "The sinks are the ends of the rays from ",
 StyleBox["p1", "TI"],
 " through ",
 StyleBox["p2", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"9770c0c7-d58d-4013-904d-af325b1d56b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"6", ",", " ", "7"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "h", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexOutDegree", "[", 
          RowBox[{"h", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], " ", 
        "&"}]}], "]"}]}], " ", "===", "\n", "    ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"Last", " ", "/@", " ", 
       RowBox[{"FindInfraRay", "[", 
        RowBox[{"g", ",", " ", "6", ",", " ", "7", ",", " ", "All"}], "]"}]}],
       "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"33d73050-7026-48ea-9a8f-6de66f560a82"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"be292f74-dfad-45ef-b0a6-6620f42375ad"]
}, Open  ]]
}, Open  ]],

