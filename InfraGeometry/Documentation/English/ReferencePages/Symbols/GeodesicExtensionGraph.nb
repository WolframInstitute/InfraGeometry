Notebook[{

Cell[CellGroupData[{
Cell["GeodesicExtensionGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"522f041d-6391-4a1e-9c62-387cf624ce9f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f2e235b-162e-4af4-8171-8667efcc9d69"],
 "\[LineSeparator]",
 "gives the DAG of all geodesic extensions of the segment ",
 StyleBox["p1", "TI"],
 " \[RightArrow] ",
 StyleBox["p2", "TI"],
 " beyond ",
 StyleBox["p2", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"df5ea30c-57ec-4d6f-9539-904235520aeb"],

Cell[TextData[{
 "The vertex set is {",
 StyleBox["e", "TI"],
 " : ",
 StyleBox["d(p1, e) = d(p1, p2) + d(p2, e)", "TI"],
 "} \[LongDash] the vertices that some geodesic from ",
 StyleBox["p1", "TI"],
 " through ",
 StyleBox["p2", "TI"],
 " reaches beyond ",
 StyleBox["p2", "TI"],
 " \[LongDash] and the edges are the edges of ",
 StyleBox["g", "TI"],
 " along increasing distance from ",
 StyleBox["p1", "TI"],
 ". The source is ",
 StyleBox["p2", "TI"],
 "."
}], "Notes",ExpressionUUID->"6ed5b05f-777b-4b47-a6b0-0bdad11d9e70"],

Cell[TextData[{
 "The set is closed under such a step: if ",
 StyleBox["u", "TI"],
 " is in it and ",
 StyleBox["v", "TI"],
 " is a neighbour of ",
 StyleBox["u", "TI"],
 " one step farther from ",
 StyleBox["p1", "TI"],
 ", then ",
 StyleBox["v", "TI"],
 " is in it too. So the directed paths from ",
 StyleBox["p2", "TI"],
 " are exactly the geodesics from ",
 StyleBox["p2", "TI"],
 " that stay geodesic behind any ",
 StyleBox["p1", "TI"],
 " \[RightArrow] ",
 StyleBox["p2", "TI"],
 " geodesic, and the ",
 StyleBox["sinks",
  FontWeight->"Bold"],
 " are the vertices past which no such geodesic can be prolonged \[LongDash] \
the ends of the rays from ",
 StyleBox["p1", "TI"],
 " through ",
 StyleBox["p2", "TI"],
 "."
}], "Notes",ExpressionUUID->"b0dcb40d-bea1-408c-b88e-5a74465dffa5"],

Cell[TextData[{
 "This is the shared engine of the distance-matrix family. The graph of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92a0985a-afa2-4869-8528-a477a7ed09f9"],
 " is the geodesic interval from ",
 StyleBox["p1", "TI"],
 " to ",
 StyleBox["p2", "TI"],
 " glued at ",
 StyleBox["p2", "TI"],
 " to this DAG. The two sides of a line through ",
 StyleBox["p1", "TI"],
 " and ",
 StyleBox["p2", "TI"],
 " are ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p2", "TI"], ",", " ", 
      StyleBox["p1", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eeb8e19d-ce11-4a66-9de9-0b5bfa53a2b9"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82039066-99c2-4818-a096-fbee86934b83"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d9cb66b-085e-44af-8826-e8fefbb846ba"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExtendInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "27080763-5196-449f-981b-26c1cbd94d18"],
 " pick their ends from these two, subject to joint geodesicity."
}], "Notes",ExpressionUUID->"946ed0a8-b311-4bda-b4b8-e7bf7c99523e"],

Cell[TextData[{
 "With ",
 StyleBox["p1", "TI"],
 " = ",
 StyleBox["p2", "TI"],
 " the condition is empty and the result is the whole spray, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20ad92be-de0c-49ab-b5ce-5746a9bb8da4"],
 "."
}], "Notes",ExpressionUUID->"0d842e5a-4645-45a0-8b7a-0d38390eb69e"],

Cell[TextData[{
 "A density anchor ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", "m"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba8a24de-ced2-48bd-9e52-2c819c5584d2"],
 " spreads to one DAG per pair of anchor vertices, returned as a list. A bare \
vertex list is one anchor, not a family."
}], "Notes",ExpressionUUID->"0fbd2c49-0b8f-452e-9128-1c8e78512a9c"],

Cell[TextData[{
 "The graph keeps the embedding coordinates of ",
 StyleBox["g", "TI"],
 ", so it draws in place."
}], "Notes",ExpressionUUID->"83069a28-c3b8-4f46-ab71-dfe46659e23f"]
}, Open  ]],

