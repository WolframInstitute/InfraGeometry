        RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}]}]}], "}"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a0b1abcd-9852-45ee-9f7c-aebdbb34e487"],

