Cell["The two sides of a line through the edge 1\[Dash]2 of the 6-cycle.", \
"ExampleText",ExpressionUUID->"14c122f1-880c-4420-b24e-8bcacc1f4d77"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Sort", " ", "@", " ", 
    RowBox[{"VertexList", " ", "@", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "1"}], "}"}]}], "]"}]}]}], ",", "\n", " ", 
   RowBox[{"Sort", " ", "@", " ", 
    RowBox[{"VertexList", " ", "@", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}]}]}], "}"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b992a9b8-95bd-449b-8fc2-6d1f9d13b441"],

