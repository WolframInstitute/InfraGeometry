Cell["\<\
With the anchor as its own direction the extension graph is the spray.\
\>", "ExampleText",ExpressionUUID->"25223cee-1663-4c04-b939-4363e20bf93a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"EdgeList", " ", "@", " ", 
      RowBox[{"GeodesicExtensionGraph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "5"}], "}"}]}], "]"}]}]}], " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"EdgeList", " ", "@", " ", 
      RowBox[{"GeodesicSprayGraph", "[", 
       RowBox[{"g", ",", " ", "5"}], "]"}]}]}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d3f00129-7961-4d0a-a003-15059f14d2a3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"afc93ee7-bcb6-4e98-b81a-7ed46fdaecc3"]
}, Open  ]],

Cell[TextData[{
 "The vertex set is closed under a farther step: every neighbour of a vertex \
in the graph that lies one step farther from ",
 StyleBox["p1", "TI"],
 " is in the graph."
}], "ExampleText",ExpressionUUID->"8c7d7436-deee-42b1-a66c-67ad47e9e2af"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"VertexList", "[", "h", "]"}], ",", "\n", "    ", 
     RowBox[{"vx", " ", "|->", " ", 
      RowBox[{"AllTrue", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"AdjacencyList", "[", 
           RowBox[{"g", ",", " ", "vx"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "1", ",", " ", "#"}], "]"}], " ", "==", 
            " ", 
            RowBox[{
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", "1", ",", " ", "vx"}], "]"}], " ", "+", 
             " ", "1"}]}], " ", "&"}]}], "]"}], ",", "\n", "      ", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "h", "]"}], ",", " ", "#"}], "]"}], " ",
          "&"}]}], "]"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b7c717f9-1a6d-4fbc-aa92-6f20664b7b8f"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"af9cce4c-b723-41a1-bb6f-b7d9c1c49663"]
}, Open  ]],

Cell[TextData[{
 "The sinks are the ends of the rays from ",
 StyleBox["p1", "TI"],
 " through ",
 StyleBox["p2", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"30e218dd-9655-4287-ab55-e6cb55bb5427"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"6", ",", " ", "7"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "h", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexOutDegree", "[", 
          RowBox[{"h", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], " ", 
        "&"}]}], "]"}]}], " ", "===", "\n", "    ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"Last", " ", "/@", " ", 
       RowBox[{"FindInfraRay", "[", 
        RowBox[{"g", ",", " ", "6", ",", " ", "7", ",", " ", "All"}], "]"}]}],
       "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"1058465a-65e0-49ea-a8f4-51de56143055"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"a25e5fc8-f97f-41c4-866f-92d951336a8b"]
}, Open  ]]
}, Open  ]],

