  "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"57575b00-dab1-45dd-bda2-7cd06f2eb680"]
}, Open  ]],

Cell["\<\
Beyond the diagonal from the corner 1 through the centre 5, only the far \
quadrant remains, and the single sink is the opposite corner.\
\>", "ExampleText",ExpressionUUID->"f0869c82-df55-4a01-addf-c0ba86948c84"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"VertexList", "[", "h", "]"}]}], ",", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "h", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexOutDegree", "[", 
          RowBox[{"h", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], " ", 
        "&"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"e09b98e4-3f23-4873-bece-f145c4825d18"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"5", ",", "6", ",", "8", ",", "9"}], "}"}], ",", 
   RowBox[{"{", "9", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"5d1ec80d-36b7-4d01-b1c2-a2905fdd9d50"]
}, Open  ]]
}, Open  ]],

