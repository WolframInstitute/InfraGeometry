Notebook[{

Cell[CellGroupData[{
Cell["InfraUniqueEdgeLiftingQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6a1fbfbb-3b6c-4586-ac1b-76117af5b876"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraUniqueEdgeLiftingQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraUniqueEdgeLiftingQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5a59e2f-fe8f-432b-9dda-f56a567f2680"],
 "\[LineSeparator]",
 "tests whether each total vertex has exactly one neighbour over each \
adjacent base vertex.",
 "\n"
}], "Usage",ExpressionUUID->"f8b21d78-47a4-4f23-b22f-7d9e307eb77e"],

Cell["\<\
Over every base edge, the transverse edges are a perfect matching between the \
two whole fibers.\
\>", "Notes",ExpressionUUID->"1f52db11-b2b9-49d3-961a-6f394007772a"],

Cell[TextData[{
 "The condition is the conjunction of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibrationQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e8e56a95-5538-4c73-bb33-7568e6ddf0bd"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraAtMostOneEdgeLiftQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraAtMostOneEdgeLiftQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d7d9474e-0dc8-45d5-9c46-069ed38444a0"],
 "."
}], "Notes",ExpressionUUID->"2b5212f4-7c87-441a-a62c-601e53b6b7fd"],

Cell["\<\
Fiber sizes agree within each connected base component. Different components \
may have different sizes.\
\>", "Notes",ExpressionUUID->"559a71eb-ea5e-4042-b919-0ed921b49d9f"],

Cell["\<\
Vertical edges are allowed. The matching need not preserve their adjacency.\
\>", "Notes",ExpressionUUID->"9970d8b1-0fc6-4850-8cbc-a74a3d2eea46"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberBundleQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberBundleQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "17ccea8c-bcd5-4b99-b19d-67a6c58b0ef8"],
 " adds mutually isomorphic fibers and adjacency-preserving matchings. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCoveringQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCoveringQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0064fc81-03a7-4bd9-99fb-0153a9ffc014"],
 " requires edgeless fibers instead."
}], "Notes",ExpressionUUID->"2ef2e807-532c-4bfc-95b9-d108fae405ff"],

Cell["The empty fibered graph satisfies the condition vacuously.", "Notes",ExpressionUUID->"a0c33b2e-e230-438e-8960-b76e475b1bc0"],

Cell["\<\
A nonempty list is tested by conjunction; an empty list gives False. \
Unsupported inputs remain unevaluated.\
\>", "Notes",ExpressionUUID->"ae626956-831b-4c42-a983-9360e4539544"]
}, Open  ]],

