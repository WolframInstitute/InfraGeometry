Cell[CellGroupData[{
Cell["InfraUniqueEdgeLiftingQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"221c689b-81af-45f4-a989-59b1c2ace494"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraUniqueEdgeLiftingQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraUniqueEdgeLiftingQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ada9ec3-fb5c-44a5-a88f-ecb0c97fe752"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3f0ceb54-8ceb-46ef-8593-650ddd3f526a"],
 " if every total vertex has exactly one neighbour over each base neighbour \
of its base vertex, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2e60d554-005d-495d-9f08-e13370f3b1c6"],
 " otherwise.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"398d37eb-2b4f-4ed9-800a-e067b14c6de4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraUniqueEdgeLiftingQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraUniqueEdgeLiftingQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["fib\:2081", "TI"], ",", " ", 
     StyleBox["fib\:2082", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12e17078-c303-4647-877c-88293b055e47"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f7680968-2a75-4982-85b6-1307fe9ca386"],
 " if every ",
 StyleBox["fib\:1d62", "TI"],
 " has unique edge lifting."
}], "Usage",ExpressionUUID->"93b1a9c4-4228-4b7b-8ff7-5dbb39f814b7"],

Cell[TextData[{
 "The condition is: for every total vertex ",
 StyleBox["x", "TI"],
 " over ",
 StyleBox["p", "TI"],
 " and every base edge ",
 StyleBox["pq", "TI"],
 " there is exactly one total edge ",
 StyleBox["xy", "TI"],
 " with ",
 StyleBox["y", "TI"],
 " over ",
 StyleBox["q", "TI"],
 ". Equivalently, over every base edge ",
 StyleBox["pq", "TI"],
 " the transverse edges are a perfect matching between the fibers ",
 StyleBox["F\:209a", "TI"],
 " and ",
 StyleBox["F_q", "TI"],
 "."
}], "Notes",ExpressionUUID->"75ea173b-f0b5-4945-96f2-d02e9f68ac68"],

Cell[TextData[{
 "It is the conjunction of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibrationQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3e2c620e-c926-43e8-92bb-57a5d68971bb"],
 " (at least one lift) and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraAtMostOneEdgeLiftQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraAtMostOneEdgeLiftQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "36423594-c162-4565-8937-58c9f01b7bc2"],
 " (at most one lift). Then every base walk has exactly one lift from each \
start, as for a covering map."
}], "Notes",ExpressionUUID->"9845d6a2-79ae-46fd-ab1d-4d38ee850357"],

Cell["\<\
Neighbouring fibers have equal size, so the fiber size is constant on each \
connected component of the base. Different components may have different \
sizes.\
\>", "Notes",ExpressionUUID->"5c745724-5305-4c48-a0e6-5720ad903587"],

Cell[TextData[{
 "Vertical edges are allowed, and the matchings need not preserve them. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCoveringQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCoveringQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "62e0f3e2-e038-4462-b34e-a032a36eefdc"],
 " asks for no vertical edges, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberBundleQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberBundleQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a2c6b3ac-c030-451b-b11a-26b971ca9685"],
 " for isomorphic fibers and matchings that preserve the fiber edges."
}], "Notes",ExpressionUUID->"56533c6f-38d1-41cb-8db8-d317dd2d3289"],

Cell[TextData[{
 "The empty fibered graph has unique edge lifting. An empty list gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "91c96e1c-684a-4ea5-9396-49386fca89a3"],
 "."
}], "Notes",ExpressionUUID->"67997d02-cd85-4e3d-a3a8-e9c3176f4d8e"]
}, Open  ]],

