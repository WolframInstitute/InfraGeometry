Cell["\<\
Vertical edges are allowed. The product of the grid with an edge has unique \
edge lifting and is a fiber bundle, but not a covering:\
\>", "ExampleText",ExpressionUUID->"31c73377-3bb0-4365-b065-22cc18b442e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GraphProduct", "[", 
        RowBox[{
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
         RowBox[{"PathGraph", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], ",", 
         " ", "\"\<Cartesian\>\""}], "]"}], ",", " ", "First"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraUniqueEdgeLiftingQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraFiberBundleQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraCoveringQ", "[", "fib", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7982a640-f35d-4934-b7aa-9dd7b9ab8253"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False"}], "}"}]], "Output",
