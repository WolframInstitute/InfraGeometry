Cell["\<\
A random double covering of the 4 \[Times] 4 grid has unique edge lifting. A \
random fibered graph with fibers of the same size does not:\
\>", "ExampleText",ExpressionUUID->"c16355e6-b039-4227-91e1-4c4a2c57ee14"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fib", " ", "=", " ", 
        RowBox[{"RandomInfraFiberedGraph", "[", 
         RowBox[{
          RowBox[{"GridGraph", "[", 
           RowBox[{"{", 
            RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
          RowBox[{"Properties", " ", "->", " ", "props"}], ",", " ", 
          RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
           RowBox[{"{", "2", "}"}]}], ",", "\n", "      ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraFiberedGraphHighlight", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraUniqueEdgeLiftingQ", "[", "fib", "]"}]}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"props", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "\"\<Covering\>\"", "}"}], ",", " ", 
        RowBox[{"{", "}"}]}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1770cb37-bc27-4891-af13-6849c65e7e4c"],

