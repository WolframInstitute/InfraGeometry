Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Properties & Relations", "ExampleSection",ExpressionUUID->
   "d18b1e1f-4c4c-49a5-bb54-1e5e145ddf4e"],
  $Line = 0; Null]], "ExampleSection",
 CellID->2123667759,ExpressionUUID->"0e0d5f37-f3c9-4474-a22b-9f10dcc8b438"],

Cell["\<\
The fiber size is constant on each component of the base. Two copies of a \
square, with fibers of 2 or 3 vertices:\
\>", "ExampleText",ExpressionUUID->"d10e91d1-6755-4f41-8b8d-89bd49bf305b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GraphDisjointUnion", "[", 
        RowBox[{
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "2"}], "}"}], "]"}], ",", " ", 
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "2"}], "}"}], "]"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<UniqueEdgeLifting\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraUniqueEdgeLiftingQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"VertexCount", " ", "/@", " ", 
      RowBox[{"InfraFibers", "[", "fib", "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"bcc0e9dc-693b-4343-9e7e-f874f7b278ff"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"1", "\[Rule]", "3"}], ",", 
     RowBox[{"2", "\[Rule]", "3"}], ",", 
     RowBox[{"3", "\[Rule]", "3"}], ",", 
     RowBox[{"4", "\[Rule]", "3"}], ",", 
     RowBox[{"5", "\[Rule]", "2"}], ",", 
     RowBox[{"6", "\[Rule]", "2"}], ",", 
     RowBox[{"7", "\[Rule]", "2"}], ",", 
     RowBox[{"8", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7685e992-328b-4dc7-9f15-f2760276e9a2"]
}, Open  ]],

Cell["\<\
Unique edge lifting is lift existence together with lift uniqueness:\
\>", "ExampleText",ExpressionUUID->"e1a10fe8-4701-4b2b-a969-8025359815ac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", "\n", "    ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Covering\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraAtMostOneEdgeLiftQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraUniqueEdgeLiftingQ", "[", "fib", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c0a599fe-d924-486b-9f6d-65f0d02895b0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"339c94f1-354f-4a6c-91a4-93de62aa087d"]
}, Open  ]],

Cell["\<\
The tangent bundle of the grid is a fibration without unique edge lifting: a \
ray has several neighbours over a base edge:\
\>", "ExampleText",ExpressionUUID->"04cef439-3fd1-4167-9cb1-1c46a27d9111"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraTangentBundle", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", "2"}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraUniqueEdgeLiftingQ", "[", "fib", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"69231d85-b7b3-4656-bfd6-2c0b950e3279"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"f60371ba-0a03-4e0f-9fbb-09ea3ebd12e9"]
}, Open  ]]
}, Open  ]],

