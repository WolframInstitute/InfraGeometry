Cell["\<\
The number of neighbours of a total vertex over a base neighbour is always 1 \
for the covering, and 0, 1 or 2 for the random fibered graph:\
\>", "ExampleText",ExpressionUUID->"8e3b78c6-14bf-4dd0-a927-6870b75fce40"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fib", " ", "=", " ", 
       RowBox[{"RandomInfraFiberedGraph", "[", 
        RowBox[{
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
         RowBox[{"Properties", " ", "->", " ", "props"}], ",", " ", 
         RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
          RowBox[{"{", "2", "}"}]}], ",", "\n", "      ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"Counts", " ", "@", " ", 
      RowBox[{"Catenate", "[", 
       RowBox[{"Values", " ", "/@", " ", 
        RowBox[{"Values", " ", "@", " ", 
         RowBox[{"InfraEdgeLiftMultiplicity", "[", "fib", "]"}]}]}], 
       "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"props", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "\"\<Covering\>\"", "}"}], ",", " ", 
       RowBox[{"{", "}"}]}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"884b5fb0-3736-4804-8f86-a484e5f5fdec"],

