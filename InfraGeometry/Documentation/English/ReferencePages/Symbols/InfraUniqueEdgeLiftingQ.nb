Cell["\<\
A product with a vertical edge has unique transverse lifts, but its fibers \
are not discrete.\
\>", "ExampleText",ExpressionUUID->"73cfc86a-8a4e-424a-bbf9-bf7262ed4af2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"GraphProduct", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}], ",", " ", 
       RowBox[{"PathGraph", "[", " ", 
        RowBox[{"{", " ", 
         RowBox[{"1", ",", " ", "2"}], " ", "}"}], " ", "]"}], ",", 
       " ", "\"\<Cartesian\>\""}], " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{"total", ",", " ", "First"}], " ", "]"}]}], " ", "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", " ", "fib", " ", "]"}], ",", 
     " ", 
     RowBox[{"InfraUniqueEdgeLiftingQ", "[", " ", "fib", " ", "]"}], ",", " ", 
     RowBox[{"InfraCoveringQ", "[", " ", "fib", " ", "]"}]}], " ", "}"}]}], 
  " ", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ea256ba5-74bf-4a96-9a72-e756bc88aab6"],

