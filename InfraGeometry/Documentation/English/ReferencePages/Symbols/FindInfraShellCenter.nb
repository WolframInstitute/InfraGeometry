Cell["\<\
The votes for the centre of the shell of radius 3. They pile up at the true \
centre, with 45 votes on the triangular tiling and 15 on the hexagonal tiling:\
\>", "ExampleText",ExpressionUUID->"3cefd70f-5777-41be-99c7-d1811c5aa651"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"votes", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"Last", " ", "@", " ", 
          RowBox[{"FindInfraShellCenter", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraShell", "[", 
                RowBox[{"c", ",", " ", "3"}], "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}]}]}]}], "}"}], 
      ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "votes"}], "}"}], ",",
         " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"MaximalBy", "[", 
          RowBox[{
           RowBox[{"Normal", " ", "@", " ", "votes"}], ",", " ", "Last"}], 
          "]"}]}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"22eca62b-3c74-471d-bdfa-4ecd815755b7"],

