Cell["\<\
The equidistant points of the shell are its centre alone, at radius 3:\
\>", "ExampleText",ExpressionUUID->"0b7d867c-d73e-4831-bb62-d9adad21a5c2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
     
     RowBox[{"{", 
      RowBox[{"c", ",", " ", 
       RowBox[{"FindInfraShellCenter", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraShell", "[", 
             RowBox[{"c", ",", " ", "3"}], "]"}], ",", 
            " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<EquidistantPoints\>\""}]}], 
        "]"}]}], "}"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", 
       " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4e0d1ab1-dfe3-43a5-9866-2c735a7e8fad"],

