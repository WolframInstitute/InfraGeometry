Notebook[{

Cell[CellGroupData[{
Cell["FindInfraShellCenter", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5b9f9123-2226-4b62-9415-bb1beae868a2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraShellCenter"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraShellCenter", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d308806f-7eed-40e4-9bdf-42f4dc0a567c"],
 "\[LineSeparator]",
 "gives the candidate centres and radii of the vertex set ",
 StyleBox["s", "TI"],
 ", as a list of pairs {",
 StyleBox["density", "TI"],
 ", ",
 StyleBox["r", "TI"],
 "}.",
 "\n"
}], "Usage",ExpressionUUID->"9fdf4186-bcfa-4a99-a413-5a7dd370d259"],

Cell[TextData[{
 "The default method follows Euclid III.1: the centre of a circle lies on the \
perpendicular bisector of every chord, so it is the midpoint of every \
diameter. For each vertex ",
 StyleBox["u", "TI"],
 " of ",
 StyleBox["s", "TI"],
 ", its farthest vertices ",
 StyleBox["v", "TI"],
 " in ",
 StyleBox["s", "TI"],
 " give chords ",
 StyleBox["uv", "TI"],
 ". Each midpoint ",
 StyleBox["m", "TI"],
 " of a chord, ",
 StyleBox["d(u, m) + d(m, v) = d(u, v)", "TI"],
 " with ",
 StyleBox["d(u, m) = \[LeftFloor]d(u, v)/2\[RightFloor]", "TI"],
 " or ",
 StyleBox["\[LeftCeiling]d(u, v)/2\[RightCeiling]", "TI"],
 ", gets one vote, as a candidate centre at radius ",
 StyleBox["d(u, m)", "TI"],
 ". The result groups the votes by radius: ",
 StyleBox["density", "TI"],
 " counts the votes of each vertex."
}], "Notes",ExpressionUUID->"83c168f0-02bf-481b-bd10-93c9bf5b57d3"],

Cell["\<\
On a graph the midpoints of the diameters need not be one vertex, so the \
votes spread; the centre is where they pile up.\
\>", "Notes",ExpressionUUID->"97f3ab1b-17a3-4a76-a067-22e1ada260a8"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<EquidistantPoints\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0c3a991-a2da-4f69-9a12-a2e2418e9b9f"],
 " gives instead the vertices at one common distance ",
 StyleBox["r > 0", "TI"],
 " from every vertex of ",
 StyleBox["s", "TI"],
 ", each with weight 1."
}], "Notes",ExpressionUUID->"ef2ff3a9-e326-49f5-9239-6733fd046bde"],

