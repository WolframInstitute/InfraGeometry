Notebook[{

Cell[CellGroupData[{
Cell["FindInfraShellCenter", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b033ed1c-a620-44f2-a9e0-2f458a9e7a6a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraShellCenter"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraShellCenter", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ec72bdb-86fb-4568-a282-e3b3311cf4eb"],
 "\[LineSeparator]",
 "gives the candidate centres and radii of the vertex set ",
 StyleBox["s", "TI"],
 ", as a list of pairs {",
 StyleBox["density", "TI"],
 ", ",
 StyleBox["r", "TI"],
 "}.",
 "\n"
}], "Usage",ExpressionUUID->"1a935b39-4c40-43a0-a6ed-cb058c33ad55"],

Cell[TextData[{
 "The default method follows Euclid III.1: the centre of a circle lies on the \
perpendicular bisector of every chord, so it is the midpoint of every \
diameter. For each vertex ",
 StyleBox["u", "TI"],
 " of ",
 StyleBox["s", "TI"],
 ", its farthest vertices ",
 StyleBox["v", "TI"],
 " in ",
 StyleBox["s", "TI"],
 " give chords ",
 StyleBox["uv", "TI"],
 ". Each midpoint ",
 StyleBox["m", "TI"],
 " of a chord, ",
 StyleBox["d(u, m) + d(m, v) = d(u, v)", "TI"],
 " with ",
 StyleBox["d(u, m) = \[LeftFloor]d(u, v)/2\[RightFloor]", "TI"],
 " or ",
 StyleBox["\[LeftCeiling]d(u, v)/2\[RightCeiling]", "TI"],
 ", gets one vote, as a candidate centre at radius ",
 StyleBox["d(u, m)", "TI"],
 ". The result groups the votes by radius: ",
 StyleBox["density", "TI"],
 " counts the votes of each vertex."
}], "Notes",ExpressionUUID->"9bc484d7-3427-49d3-aeda-c36a025f7ce3"],

Cell["\<\
On a graph the midpoints of the diameters need not be one vertex, so the \
votes spread; the centre is where they pile up.\
\>", "Notes",ExpressionUUID->"77a51cba-abf1-4045-a0f4-f824ac68e8af"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<EquidistantPoints\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58f3c99e-4387-46eb-a465-101b83532425"],
 " gives instead the vertices at one common distance ",
 StyleBox["r > 0", "TI"],
 " from every vertex of ",
 StyleBox["s", "TI"],
 ", each with weight 1."
}], "Notes",ExpressionUUID->"8344f464-8587-45e7-aac3-6803f2fbae91"],

