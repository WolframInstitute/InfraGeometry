Cell["\<\
On the mesh some diameters have odd length, and their midpoints also vote at \
radius 2. Even chords only leave radius 3:\
\>", "ExampleText",ExpressionUUID->"f42ff9c3-de83-4c12-832b-d36477d390e8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"shell", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraShell", "[", 
         RowBox[{"c", ",", " ", "3"}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Last", " ", "/@", " ", 
      RowBox[{"FindInfraShellCenter", "[", 
       RowBox[{"g", ",", " ", "shell", ",", " ", 
        RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<MaximalChordsBisectors\>\"", ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<MaximalChordsBisectors\>\"", ",", " ", 
           RowBox[{"\"\<Parity\>\"", " ", "->", " ", "\"\<Even\>\""}]}], 
          "}"}]}], "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"01a08736-384b-4d6a-bce6-a9fee1fbfd46"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
