Cell["\<\
The equidistant points of the shell are its centre alone, at radius 3:\
\>", "ExampleText",ExpressionUUID->"551f0447-6513-4d8c-b9e9-3e24376ac158"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
     
     RowBox[{"{", 
      RowBox[{"c", ",", " ", 
       RowBox[{"FindInfraShellCenter", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraShell", "[", 
             RowBox[{"c", ",", " ", "3"}], "]"}], ",", 
            " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<EquidistantPoints\>\""}]}], 
        "]"}]}], "}"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", 
       " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6ddb6461-9325-4993-9627-017e85ddc215"],

