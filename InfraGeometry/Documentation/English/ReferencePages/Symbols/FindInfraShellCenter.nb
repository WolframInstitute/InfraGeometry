Cell["Method", "ExampleSubsection",ExpressionUUID->"3363e4d1-e444-44e4-af24-99dd8e31d397"],

Cell["\<\
On the mesh some diameters have odd length, and their midpoints also vote at \
radius 2. Even chords only leave radius 3:\
\>", "ExampleText",ExpressionUUID->"9edcee2e-1e9c-4d64-99e7-c67b991c0291"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"shell", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraShell", "[", 
         RowBox[{"c", ",", " ", "3"}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Last", " ", "/@", " ", 
      RowBox[{"FindInfraShellCenter", "[", 
       RowBox[{"g", ",", " ", "shell", ",", " ", 
        RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<MaximalChordsBisectors\>\"", ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<MaximalChordsBisectors\>\"", ",", " ", 
           RowBox[{"\"\<Parity\>\"", " ", "->", " ", "\"\<Even\>\""}]}], 
          "}"}]}], "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"be07d6c0-c20c-4437-bb3f-1eccbde8e2cc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", "3", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a7675b74-6666-4755-92fc-0464748af845"]
