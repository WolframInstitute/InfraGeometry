Cell["\<\
The votes for the centre of the shell of radius 3. They pile up at the true \
centre, with 30 votes on the grid and 48 on the mesh:\
\>", "ExampleText",ExpressionUUID->"7cb0dbad-8529-44f0-aca5-1d43997dbd62"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"votes", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"Last", " ", "@", " ", 
          RowBox[{"FindInfraShellCenter", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraShell", "[", 
                RowBox[{"c", ",", " ", "3"}], "]"}], ",", 
               " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}]}]}]}], "}"}], 
      ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "votes"}], "}"}], ",",
         " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"MaximalBy", "[", 
          RowBox[{
           RowBox[{"Normal", " ", "@", " ", "votes"}], ",", " ", "Last"}], 
          "]"}]}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"f8ade991-cdc7-4055-a68d-eabe67968564"],

