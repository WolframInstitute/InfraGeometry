Notebook[{

Cell[CellGroupData[{
Cell["DisplacementBracket", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"01870ef5-29e6-4775-883d-e5084467fef7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementBracket"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementBracket", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c310d6d4-9aea-4641-a70d-553f97f53650"],
 "\[LineSeparator]",
 "is the metric bracket of the displacements ",
 StyleBox["d1", "TI"],
 " and ",
 StyleBox["d2", "TI"],
 ": the loop of ",
 StyleBox["d1", "TI"],
 ", ",
 StyleBox["d2", "TI"],
 " and their metric negatives.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0de93153-6274-4ad1-b343-99bf6f63703e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementBracket"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementBracket", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a469d2d-7fc6-47c1-992f-7c268bb84a11"],
 "\[LineSeparator]",
 "gives its value at the vertex ",
 StyleBox["v", "TI"],
 "."
}], "Usage",ExpressionUUID->"fa9adde1-64b1-4126-aa89-8416fc562c74"],

Cell[TextData[{
 "The bracket is the loop ",
 StyleBox["[D\:2081, D\:2082] = (\[Minus]D\:2082) \[SmallCircle] (\[Minus]D\
\:2081) \[SmallCircle] D\:2082 \[SmallCircle] D\:2081", "TI"],
 ", each negative ",
 StyleBox["\[Minus]D", "TI"],
 " that of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementNegative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementNegative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5aa92f1e-5d09-4aaa-bc04-a4fb00e7759d"],
 " for the step at the vertex the loop has reached. It is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementCommutator"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementCommutator", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Negative\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f14e23f5-b856-4d9b-987d-427d97b3a0c4"],
 "."
}], "Notes",ExpressionUUID->"89af2ae7-f343-4f50-a4be-63c6c3873470"],

Cell[TextData[{
 "For the flows of two vector fields ",
 StyleBox["X", "TI"],
 ", ",
 StyleBox["Y", "TI"],
 " at scale ",
 StyleBox["r", "TI"],
 " the loop moves each point by ",
 StyleBox["r\.b2[X, Y] + O(r\.b3)", "TI"],
 ". Where the bracket vanishes the loop closes; where it does not, the loop \
is a short step along the bracket."
}], "Notes",ExpressionUUID->"5817971b-28dc-4583-a055-c5844db3e45a"],

Cell["\<\
The loop needs no inverse, so it applies to any displacement, single-valued \
or not.\
\>", "Notes",ExpressionUUID->"b7bb8e09-cfcd-43b4-aaca-205d5f81d465"],

Cell[TextData[{
 "Near the rim a negative can turn sideways, and the loop need not close \
there: ",
 StyleBox["[D, D]", "TI"],
 " need not be the identity."
}], "Notes",ExpressionUUID->"b8f303ce-f4d1-4fda-8378-bab83d9261d6"]
}, Open  ]],

