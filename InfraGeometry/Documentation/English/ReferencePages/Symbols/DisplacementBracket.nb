Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"27e7e025-53f3-474a-8cbf-ad870de4d0eb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementBracket"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementBracket", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
