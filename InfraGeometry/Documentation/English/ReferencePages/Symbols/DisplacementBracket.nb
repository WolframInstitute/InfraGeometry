Cell["\<\
The bracket of a displacement with itself need not be the identity. On a \
path, the step left stops at the end 1, and its bracket with itself moves 2 \
and 3 to 1: at the end the negative of the step is the end itself, and the \
loop does not come back.\
\>", "ExampleText",ExpressionUUID->"268c1419-17b4-49ff-9ac3-31607a05968f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"PathGraph", "[", 
      RowBox[{"Range", "[", "5", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"left", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"1", " ", "->", " ", 
        RowBox[{"{", "1", "}"}]}], ",", " ", 
       RowBox[{"2", " ", "->", " ", 
        RowBox[{"{", "1", "}"}]}], ",", " ", 
       RowBox[{"3", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"4", " ", "->", " ", 
        RowBox[{"{", "3", "}"}]}], ",", " ", 
       RowBox[{"5", " ", "->", " ", 
        RowBox[{"{", "4", "}"}]}]}], "|>"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"DisplacementBracket", "[", 
        RowBox[{"g", ",", " ", "left", ",", " ", "left"}], "]"}]}], "]"}], ",",
      " ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"DisplacementBracket", "[", 
       RowBox[{"g", ",", " ", "left", ",", " ", "left"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"33a31c49-1108-41ca-bd74-c11dc8ca31d2"],

