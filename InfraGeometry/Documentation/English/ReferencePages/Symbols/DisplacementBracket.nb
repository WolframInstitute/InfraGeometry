 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5aab5666-37d0-4174-8966-6b8ed5a260dd"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementBracket"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementBracket", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c674a1c-b2cd-44b4-91a5-f6d4610244bb"],
 "\[LineSeparator]",
 "is the metric bracket of the displacements ",
 StyleBox["d1", "TI"],
 " and ",
 StyleBox["d2", "TI"],
 ": the loop of ",
 StyleBox["d1", "TI"],
 ", ",
 StyleBox["d2", "TI"],
 " and their metric negatives, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementCommutator"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementCommutator", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Negative\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26dc6618-f435-4fea-8d04-5fdc3968eff6"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"cb0de72f-84b5-4ca9-9550-45224f507567"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementBracket"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementBracket", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29088a23-c42f-4a9c-8f27-759e9ad2d62a"],
 "\[LineSeparator]",
 "gives its value at the vertex ",
 StyleBox["v", "TI"],
 "."
}], "Usage",ExpressionUUID->"81e7fa24-2a7c-4a0b-83e8-741dc7dfb088"],

Cell[TextData[{
 "Definition: ",
 StyleBox["[D1, D2] = (\[Minus]D2) \[SmallCircle] (\[Minus]D1) \[SmallCircle] \
D2 \[SmallCircle] D1", "TI"],
 ", where ",
 StyleBox["\[Minus]D", "TI"],
 " is the metric negative given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementNegative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementNegative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3ca6385f-24b0-4bb5-b132-a4eb8ad04441"],
 ", taken at the vertex the loop has reached."
}], "Notes",ExpressionUUID->"4827092a-2516-4e3f-9346-606f7043ed7f"],

Cell[TextData[{
 "For the flows of two vector fields at scale ",
 StyleBox["r", "TI"],
 " the loop moves each point by ",
 StyleBox["r\.b2", "TI"],
 " times the Lie bracket, up to ",
 StyleBox["O(r\.b3)", "TI"],
 ": where the bracket vanishes the loop closes, and where it does not, the \
loop is a short step in the direction of the bracket. The metric loop needs \
no inverse, so it applies to any displacement, single-valued or not."
}], "Notes",ExpressionUUID->"fd21ddcb-ea6e-4626-b289-27216ce82cf9"],

Cell[TextData[{
 "On a graph the bracket depends on the scale of the displacements, and it \
need not be antisymmetric: ",
 StyleBox["[D2, D1]", "TI"],
 " need not be the negative of ",
 StyleBox["[D1, D2]", "TI"],
 ", and ",
 StyleBox["[D, D]", "TI"],
 " need not be the identity. Near the rim the negative of a clamped step is \
the vertex itself, and the loop does not close."
}], "Notes",ExpressionUUID->"f2b2e779-0edb-4ae6-b6b1-2fd01bd28618"]
}, Open  ]],

