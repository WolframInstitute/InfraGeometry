Cell["\<\
On the 12-cycle the bracket of the rotation with itself is the identity.\
\>", "ExampleText",ExpressionUUID->"6b46ff3a-a94d-4cd5-b1a1-8347887aebae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rotation", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"DisplacementBracket", "[", 
        RowBox[{"g", ",", " ", "rotation", ",", " ", "rotation"}], "]"}]}], 
      "]"}], ",", " ", 
     RowBox[{
      RowBox[{"DisplacementBracket", "[", 
       RowBox[{"g", ",", " ", "rotation", ",", " ", "rotation"}], "]"}], " ", 
      "===", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{"List", ",", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
