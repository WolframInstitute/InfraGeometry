Cell["\<\
A shear: the step up, switched on from the fourth column, orange, beside the \
step right, blue. Their bracket moves the third column one step up, the jump \
of the coefficient of the step up; the vertices next to the top row and the \
right column move as for the coordinate steps.\
\>", "ExampleText",ExpressionUUID->"044a24de-4791-415c-9018-e3fda6590fd9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "6"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"right", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"up", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"shear", " ", "=", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{"v", " ", "|->", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"v", " ", ">", " ", "18"}], ",", " ", 
          RowBox[{"up", "[", "v", "]"}], ",", " ", 
          RowBox[{"{", "v", "}"}]}], "]"}]}], ",", " ", 
       RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"DisplacementPlot", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"right", ",", " ", "shear"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"DisplacementPlot", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"DisplacementBracket", "[", 
         RowBox[{"g", ",", " ", "right", ",", " ", "shear"}], "]"}]}], 
       "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6507e148-1bfa-4e07-aa2d-eacfa49b1936"],

