Cell["\<\
The steps right and up of the 6 \[Times] 6 grid have a vanishing bracket: the \
loop closes on 25 of the 36 vertices. The other 11 lie next to the top row \
and the right column, where the step is clamped and its negative is the \
vertex itself.\
\>", "ExampleText",ExpressionUUID->"4bb67d2e-e51f-4dc0-bac9-a46ac5b83d21"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "6"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"right", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"up", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"bracket", " ", "=", " ", 
     RowBox[{"DisplacementBracket", "[", 
      RowBox[{"g", ",", " ", "right", ",", " ", "up"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", "bracket"}], "]"}], ",", " ", 
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{"Keys", "[", "bracket", "]"}], ",", " ", 
       RowBox[{"v_", " ", "/;", " ", 
        RowBox[{
         RowBox[{"bracket", "[", "v", "]"}], " ", "===", " ", 
         RowBox[{"{", "v", "}"}]}]}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"06382f61-132e-42a8-90a5-cd812bf90700"],

