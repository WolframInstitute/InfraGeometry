Cell["\<\
The bracket is the commutator loop with the metric negatives:\
\>", "ExampleText",ExpressionUUID->"cfedd86c-6bc1-496e-ba09-3be56048175a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"right", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"up", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{
    RowBox[{"DisplacementBracket", "[", 
     RowBox[{"g", ",", " ", "right", ",", " ", "up"}], "]"}], " ", "===", " ", 
    RowBox[{"DisplacementCommutator", "[", 
     RowBox[{"g", ",", " ", "right", ",", " ", "up", ",", " ", 
      RowBox[{"Method", " ", "->", " ", "\"\<Negative\>\""}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cacc04e3-dbcf-4259-870d-2dc98a3cd4cc"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"5248151d-1fc0-4f34-b622-feeb1310b6c9"]
}, Open  ]],

Cell["\<\
Exchanging the two displacements reverses the step at the jump, the step up \
becoming the step down:\
\>", "ExampleText",ExpressionUUID->"3f0b8d0b-5e41-4fbd-8639-3a540e4508fb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
