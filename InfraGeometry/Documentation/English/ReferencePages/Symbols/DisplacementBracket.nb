Cell["\<\
The bracket of the steps right and up, on the square grid and on the square \
mesh, with the number of vertices where the loop closes. On the grid it \
closes away from the rim; on the mesh the two steps do not commute:\
\>", "ExampleText",ExpressionUUID->"014f97a4-f4d7-42bc-8c62-647826dae2e7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"KeyValueMap", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name", ",", " ", "s"}], "}"}], " ", "|->", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"bracket", " ", "=", " ", 
         RowBox[{"DisplacementBracket", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"TranslationDisplacement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", 
              RowBox[{"s", ",", " ", "0"}], "}"}]}], "]"}], ",", " ", 
           RowBox[{"TranslationDisplacement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "s"}], "}"}]}], "]"}]}], "]"}]}], "}"}], 
       ",", "\n", "    ", 
       RowBox[{"DisplacementPlot", "[", 
        RowBox[{"g", ",", " ", "bracket", ",", " ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"Count", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{"v_", " ", "/;", " ", 
             RowBox[{
              RowBox[{"bracket", "[", "v", "]"}], " ", "===", " ", 
              RowBox[{"{", "v", "}"}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}], ",",
     "\n", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<SquareGridGraph\>\"", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"\"\<SquareMeshGraph\>\"", " ", "->", " ", 
       RowBox[{"1", "/", "8"}]}]}], "|>"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ad9121f5-5d29-4c0b-b0a9-e9e81464ec8d"],

