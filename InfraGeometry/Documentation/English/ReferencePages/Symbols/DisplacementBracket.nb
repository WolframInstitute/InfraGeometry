Cell["\<\
The bracket of a displacement with itself need not be the identity. On a \
path, the step left stops at the end 1, and its bracket with itself moves 2 \
and 3 to 1: at the end the negative of the step is the end itself, and the \
loop does not come back.\
\>", "ExampleText",ExpressionUUID->"f4c6a7d1-31b9-42df-b064-4b773b0949f5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"PathGraph", "[", 
      RowBox[{"Range", "[", "5", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"left", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"1", " ", "->", " ", 
        RowBox[{"{", "1", "}"}]}], ",", " ", 
       RowBox[{"2", " ", "->", " ", 
        RowBox[{"{", "1", "}"}]}], ",", " ", 
       RowBox[{"3", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"4", " ", "->", " ", 
        RowBox[{"{", "3", "}"}]}], ",", " ", 
       RowBox[{"5", " ", "->", " ", 
        RowBox[{"{", "4", "}"}]}]}], "|>"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"DisplacementBracket", "[", 
        RowBox[{"g", ",", " ", "left", ",", " ", "left"}], "]"}]}], "]"}], ",",
      " ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"DisplacementBracket", "[", 
       RowBox[{"g", ",", " ", "left", ",", " ", "left"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9b1913b4-7403-4621-b75a-411454043c83"],

