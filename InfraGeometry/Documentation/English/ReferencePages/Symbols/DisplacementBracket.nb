Cell[CellGroupData[{
Cell["DisplacementBracket", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0bd5160c-2c48-44b6-b4d8-4d3a2b9a35f6"],
 Cell[BoxData[
  RowBox[{"DisplacementBracket", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "525251ad-11d0-4b74-89ab-e4667726cc90"],
 "\[LineSeparator]",
 "is the metric bracket of the displacements ",
 StyleBox["d1", "TI"],
 " and ",
 StyleBox["d2", "TI"],
 ": the loop of ",
 StyleBox["d1", "TI"],
 ", ",
 StyleBox["d2", "TI"],
 " and their metric negatives, ",
 Cell[BoxData[
  RowBox[{"DisplacementCommutator", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Negative\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a539ed74-676d-4f2f-9294-f00be87fdc2a"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f9ec4053-ce5a-48ff-9315-805fc62bcbea"],
 Cell[BoxData[
  RowBox[{"DisplacementBracket", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74848476-fb21-460e-bf2d-a8436282852e"],
 "\[LineSeparator]",
 "gives its value at the vertex ",
 StyleBox["v", "TI"],
 "."
}], "Usage",ExpressionUUID->"3d8dc684-1c2d-4051-bcfe-cd731eaac642"],

Cell[TextData[{
 "Definition: ",
 StyleBox["[D1, D2] = (\[Minus]D2) \[SmallCircle] (\[Minus]D1) \[SmallCircle] \
D2 \[SmallCircle] D1", "TI"],
 ", where ",
 StyleBox["\[Minus]D", "TI"],
 " is the metric negative given by ",
 Cell[BoxData["DisplacementNegative"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29591edd-ac8d-485b-ac95-e39b35b7b923"],
 ", taken at the vertex the loop has reached."
}], "Notes",ExpressionUUID->"e6258c65-7312-470d-9dd3-4232e19f2b2a"],

Cell[TextData[{
 "For the flows of two vector fields at scale ",
 StyleBox["r", "TI"],
 " the loop moves each point by ",
 StyleBox["r\.b2", "TI"],
 " times the Lie bracket, up to ",
 StyleBox["O(r\.b3)", "TI"],
 ": where the bracket vanishes the loop closes, and where it does not, the \
loop is a short step in the direction of the bracket. The metric loop needs \
no inverse, so it applies to any displacement, single-valued or not."
}], "Notes",ExpressionUUID->"8d092bc3-72bd-4351-b611-2ba9dca1a259"],

Cell[TextData[{
 "On a graph the bracket depends on the scale of the displacements, and it \
need not be antisymmetric: ",
 StyleBox["[D2, D1]", "TI"],
 " need not be the negative of ",
 StyleBox["[D1, D2]", "TI"],
 ", and ",
 StyleBox["[D, D]", "TI"],
 " need not be the identity. Near the rim the negative of a clamped step is \
the vertex itself, and the loop does not close."
}], "Notes",ExpressionUUID->"4d586b35-527f-4533-b284-742bf34084ff"]
}, Open  ]],

