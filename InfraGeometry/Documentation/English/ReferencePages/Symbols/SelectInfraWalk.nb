Cell[CellGroupData[{

Cell["RandomSeeding", "ExampleSubsection",ExpressionUUID->"f344340d-de4a-4a5b-825a-b83bc4b0261d"],

Cell["\<\
With a finite count and several eligible walks the draw is random. Twenty \
draws of one central member give several walks; with a seed they give one:\
\>", "ExampleText",ExpressionUUID->"4b0475e9-fff0-4b49-9ec7-fbdb74a7dc47"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"45", ",", " ", "78"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"VertexList", " ", "/@", " ", 
          RowBox[{"SelectInfraWalk", "[", 
           RowBox[{"g", ",", " ", "seg", ",", " ", 
            RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], 
           "]"}]}], ",", " ", 
         RowBox[{"{", "20", "}"}]}], "]"}]}]}], ",", "\n", "   ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"VertexList", " ", "/@", " ", 
          RowBox[{"SelectInfraWalk", "[", 
           RowBox[{"g", ",", " ", "seg", ",", " ", 
            RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}], ",", 
            " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], ",", 
         " ", 
         RowBox[{"{", "20", "}"}]}], "]"}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6517f7ac-9687-4e7a-9164-e2c2bb0778d0"],

