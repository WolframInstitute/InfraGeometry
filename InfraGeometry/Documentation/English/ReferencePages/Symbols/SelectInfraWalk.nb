Cell["\<\
The central members of a segment: the shortest paths closest to all the \
others, on the square grid and on the square mesh:\
\>", "ExampleText",ExpressionUUID->"cb0cd7e9-94f2-4ea1-8be6-94d004be5b13"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"seg", " ", "=", " ", 
        RowBox[{"InfraSegment", "[", 
         RowBox[{"a", ",", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraShell", "[", 
             RowBox[{"a", ",", " ", "6"}], "]"}], ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"central", " ", "=", " ", 
        RowBox[{"SelectInfraWalk", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<Graph\>\""}], "]"}], ",",
           " ", "All", ",", " ", 
          RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"seg", ",", " ", "central"}], "}"}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"e5e103de-a4c7-463a-9ec0-dc7b5dce3492"],

