Cell["SelectInfraWalk", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"de2f7705-d8a0-420a-82cd-bc0c3a996c7f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SelectInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SelectInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walks", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74cc5765-ead9-4055-9a91-dbc39be89b0e"],
 "\[LineSeparator]",
 "gives a list of one walk drawn from ",
 StyleBox["walks", "TI"],
 ", read as points of a metric space.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"086408e3-b1b7-4f32-ac18-4cbb791e55e3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SelectInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SelectInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walks", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0050b467-3927-4aac-9b53-350a3c1ab50f"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["n", "TI"],
 " walks; ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c1e697-afa7-4725-b9c9-2af77eb26404"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac376e3c-a2cb-4e18-a42b-2035d1d9e839"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5737dc14-7a81-4249-8968-f1bd66087f56"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SelectInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SelectInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29367d5e-7b24-498b-b9e0-02a1af569103"],
 "\[LineSeparator]",
 "is the operator form."
}], "Usage",ExpressionUUID->"d9b6cf07-2010-4795-ae15-98d6c93c9381"],

Cell[TextData[{
 "The distance between two walks is the Hausdorff distance of their vertex \
sets in ",
 StyleBox["g", "TI"],
 " by default. ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d8aae39-d6af-4a61-a0da-fb8e9e2bd115"],
 " says which walks are eligible, ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56b3db64-a4d2-4d6b-90f8-dda820568c44"],
 " how far apart the chosen ones must be."
}], "Notes",ExpressionUUID->"fae82750-3c86-4441-9764-46b6495ba228"],

Cell[TextData[{
 StyleBox["walks", "TI"],
 " is a list of vertex lists or walk graphs, a list of cycle graphs, read as \
closed walks, or one directed acyclic graph, such as the graph of a segment, \
read as its paths from source to sink. The result has the same form: vertex \
lists, walk graphs or path graphs."
}], "Notes",ExpressionUUID->"562cb754-d674-4608-aae4-ef23ac0fcbf6"],

