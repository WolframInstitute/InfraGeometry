Cell[CellGroupData[{

Cell["RandomSeeding", "ExampleSubsection",ExpressionUUID->"2b5dc650-fe84-44dd-ab69-a0e600435b09"],

Cell["\<\
With a finite count and several eligible walks the draw is random. Twenty \
draws of one central member give several walks; with a seed they give one:\
\>", "ExampleText",ExpressionUUID->"1265e5c9-8eb2-4aa8-8ffb-5e7c8fdbae07"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"45", ",", " ", "78"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"VertexList", " ", "/@", " ", 
          RowBox[{"SelectInfraWalk", "[", 
           RowBox[{"g", ",", " ", "seg", ",", " ", 
            RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], 
           "]"}]}], ",", " ", 
         RowBox[{"{", "20", "}"}]}], "]"}]}]}], ",", "\n", "   ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"VertexList", " ", "/@", " ", 
          RowBox[{"SelectInfraWalk", "[", 
           RowBox[{"g", ",", " ", "seg", ",", " ", 
            RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}], ",", 
            " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], ",", 
         " ", 
         RowBox[{"{", "20", "}"}]}], "]"}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"403dae0f-e218-4fa8-a646-8120bd634b3e"],

