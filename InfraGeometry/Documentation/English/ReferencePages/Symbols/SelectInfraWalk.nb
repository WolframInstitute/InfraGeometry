Cell["SelectInfraWalk", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e0ca6239-f976-4504-80c7-447ccba7abbd"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SelectInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SelectInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walks", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6511e75e-acc0-4b2b-adb2-464cbdcb515e"],
 "\[LineSeparator]",
 "gives a list of one walk drawn from ",
 StyleBox["walks", "TI"],
 ", read as points of a metric space.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4a556717-c437-4235-9df4-432c231c6df7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SelectInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SelectInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walks", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d453151-9fcf-4e39-9eb3-99fd55daaa57"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["n", "TI"],
 " walks; ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de8c6a8e-496d-4075-bdcd-45a11aac68e7"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea6e6a36-9440-42ab-a9ca-9c9c8069b4f0"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c0c11e48-6c85-466f-8b8e-92a6436f0730"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SelectInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SelectInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71621845-7d9e-49ef-95e7-51d8ee3273ac"],
 "\[LineSeparator]",
 "is the operator form."
}], "Usage",ExpressionUUID->"8381d58d-3c60-4783-9dfe-24dd7fbc782f"],

Cell[TextData[{
 "The distance between two walks is the Hausdorff distance of their vertex \
sets in ",
 StyleBox["g", "TI"],
 " by default. ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ee929e4-ff3b-47dd-9952-8f267a361059"],
 " says which walks are eligible, ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3678c15-e97a-42ff-9145-9293be4c5c98"],
 " how far apart the chosen ones must be."
}], "Notes",ExpressionUUID->"d15ac858-cad7-42be-9e24-c652a90aa65c"],

Cell[TextData[{
 StyleBox["walks", "TI"],
 " is a list of vertex lists or walk graphs, a list of cycle graphs, read as \
closed walks, or one directed acyclic graph, such as the graph of a segment, \
read as its paths from source to sink. The result has the same form: vertex \
lists, walk graphs or path graphs."
}], "Notes",ExpressionUUID->"d67ec1ef-9edb-4a62-b2bf-44548f44fe52"],

