Cell["\<\
With a finite count and several eligible walks, the draw is random, and there \
is no seed. Twenty draws of one central member give several different walks:\
\>", "ExampleText",ExpressionUUID->"51bfd1fd-763d-425e-83df-f09c6e3d44de"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"45", ",", " ", "78"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Length", " ", "@", " ", 
     RowBox[{"Union", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"VertexList", " ", "/@", " ", 
         RowBox[{"SelectInfraWalk", "[", 
          RowBox[{"g", ",", " ", "seg", ",", " ", 
           RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], 
          "]"}]}], ",", " ", 
        RowBox[{"{", "20", "}"}]}], "]"}]}]}], " ", ">", " ", "1"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"57634c22-d69c-40c6-a1b1-07d68ab8a14f"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"dbf5ef2d-1959-4740-852a-a9dc9c760abc"]
}, Open  ]]
}, Open  ]],

