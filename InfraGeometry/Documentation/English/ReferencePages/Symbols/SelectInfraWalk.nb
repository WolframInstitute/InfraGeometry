  FontSize->0.9 Inherited,ExpressionUUID->
  "b06c9c35-ca02-437f-80bf-b80dc9848ebd"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["n", "TI"],
 " walks; ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6906e91b-c333-4b6d-b8be-3088a86c0192"],
 " or ",
