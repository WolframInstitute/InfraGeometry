Cell["\<\
The central, peripheral and most-visited members of a segment on the grid. \
The most-visited ones keep to the diagonal:\
\>", "ExampleText",ExpressionUUID->"4cb6333f-611b-4167-8321-7ddb99007dfd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"45", ",", " ", "78"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"SelectInfraWalk", "[", 
          RowBox[{"g", ",", " ", "seg", ",", " ", "All", ",", " ", 
           RowBox[{"\"\<From\>\"", " ", "->", " ", "f"}]}], "]"}], "}"}], ",",
         " ", 
        RowBox[{"PlotLabel", " ", "->", " ", "f"}]}], "]"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"f", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Center\>\"", ",", " ", "\"\<Periphery\>\"", ",", 
          " ", "\"\<MostVisited\>\""}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a0197c11-996f-447e-9e27-7973e7aa8a76"],

