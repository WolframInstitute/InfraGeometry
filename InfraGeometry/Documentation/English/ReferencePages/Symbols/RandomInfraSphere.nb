Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraSphere", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d2ff203f-d1ed-4913-816e-255cd598c273"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6de27e0e-fec4-4905-a1a4-e1fee986012c"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51f57076-c74d-4331-ad64-b411f9eaff22"],
 " of exactly ",
 StyleBox["n", "TI"],
 " inclusion-minimal connected subsets of the shell of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " that separate the side of ",
 StyleBox["c", "TI"],
 " from the far side.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"53d96be6-e64d-4c50-a59d-68c4ba959a23"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "022845ee-1ef1-4f82-a249-f42eb030a5b4"],
 "\[LineSeparator]",
 "takes the band from ",
 StyleBox["r", "TI"],
 " to ",
 StyleBox["s", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8433af18-e680-41e6-87b1-ea910a9c6fef"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0052651b-c298-4189-bfa8-a148a5e702e3"],
 "\[LineSeparator]",
 "draws one such subset."
}], "Usage",ExpressionUUID->"e8fb403b-d11d-4942-8dd8-553d4df509ab"],

Cell[TextData[{
 "The default draw is random. Seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a04b9da8-61ad-455c-9179-1c1f21022417"],
 " to reproduce it. Give ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d49c1b8d-dbd5-4cfb-be0b-392698fa844d"],
 " for deterministic descent. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cbc78b7-2a5b-48e1-aad2-c914b5d8fc1e"],
 " with ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5815d6d0-5086-4aca-9297-c3088c774f88"],
 " keeps the full enumeration without drawing."
}], "Notes",ExpressionUUID->"ed1342ff-14d2-4225-8011-3dff1429f2a1"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " may be ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db3c6223-5d37-41a2-bd6c-437b529288e0"],
 ", which gives up to ",
 StyleBox["n", "TI"],
 ", or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58671c68-860d-4f2f-b78e-6eec3d62cf69"],
 "."
}], "Notes",ExpressionUUID->"a724f148-2ad6-401d-9777-b3bd97f21362"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52aee7f7-959a-46d2-85c1-c1e8a7d26143"],
 " takes ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0795a66e-1b57-4603-b4ba-b836de84f58c"],
 " (default), ",
 Cell[BoxData[
  RowBox[{"{", "\"\<Separating\>\"", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41f0e38d-9f04-400e-8547-397cef1708af"],
 " for the inclusion-minimal separating subsets that need not be connected, \
or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32af5d44-fc2b-4b8e-bf8e-fc89f575749d"],
 " for the level set as the one member."
}], "Notes",ExpressionUUID->"7eefd95c-6e28-4a1b-b90a-49d9c80ae0cb"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7f9b0c9-25ff-4fb8-8d5b-1b8794eee6f8"],
 " sees the vertices that can be peeled next and gives the ones to try, in \
order. ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40f731f0-169e-497c-a3b9-7595fea99771"],
 " (default) peels in random order. ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b179146d-1f82-4ad3-9ba3-0afcbfc3c1fa"],
 " gives the canonical peel; ambient ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5663341-4b55-4589-84f7-27f82adb7ea9"],
 " reproduces a draw; ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"RandomSample", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"UpTo", "[", "n", "]"}]}], "]"}], " ", "&"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae118b81-3c17-40e5-9141-0bf986a253cf"],
 " keeps at most ",
 StyleBox["n", "TI"],
 " branches per node, and the result is then minimal among the survivors."
}], "Notes",ExpressionUUID->"292bd7c9-f3e6-487d-a9f7-916ed21cd0dd"],

Cell[TextData[{
 "The search peels the shell vertex by vertex while it keeps separating. It \
is the specialised search behind ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6b586e25-e186-4ef7-b4c3-10bb997dda2d"],
 ", whose ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "55a577af-0a49-4f51-8ba2-e464b7769222"],
 " clause calls it. The family can be large: all members on a medium tiling \
take long."
}], "Notes",ExpressionUUID->"b7668464-efb9-4ad5-9e44-3c6ed7283aeb"],

Cell[TextData[{
 "When the shell does not separate, as on a torus band that wraps, the result \
is ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8cc79c8e-dc80-4ee3-93fc-864987e091d7"],
 "."
}], "Notes",ExpressionUUID->"6fde015e-42cd-45e8-bd42-2fb472c93764"]
}, Open  ]],

