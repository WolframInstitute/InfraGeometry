    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be64860b-a20f-4076-a127-d0132ae77c73"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " distinct walls.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4d334cf7-876f-480a-a0c3-11e75fb2f8b0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
