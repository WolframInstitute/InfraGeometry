Cell["A pruning function caps the branches tried per node.", "ExampleText",ExpressionUUID->"e9463ec2-ad4d-40ea-b2ab-007de5241f22"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"RandomInfraSphere", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", "13", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "All", ",", " ", 
   RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"RandomSample", "[", 
       RowBox[{"#", ",", " ", 
        RowBox[{"UpTo", "[", "1", "]"}]}], "]"}], " ", "&"}], ")"}]}]}], 
  "]"}]}], "Input",
