Cell["\<\
All four minimal connected separating subsets of the band 1 to 2 about the \
centre of a 5 by 5 grid.\
\>", "ExampleText",ExpressionUUID->"3066be72-9286-473e-b57c-a425f26ee426"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"RandomInfraSphere", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", "13", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "All"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f69db189-8720-4452-b664-f1d4d51c6522"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "8", ",", "9", ",", "12", ",", "14", ",", "17", ",", "18", ",", "19"}], 
    "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
    "7", ",", "8", ",", "12", ",", "14", ",", "17", ",", "18", ",", "19"}], 
    "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
    "7", ",", "8", ",", "9", ",", "12", ",", "14", ",", "18", ",", "19"}], 
    "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
    "7", ",", "8", ",", "9", ",", "12", ",", "14", ",", "17", ",", "18"}], 
    "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"bb853bdb-3f30-4841-a886-951c0bd5f20f"]
}, Open  ]],

Cell["\<\
Three separating subsets of the shell of radius 3, each drawn in its own \
colour on the hexagonal tiling.\
\>", "ExampleText",ExpressionUUID->"465e32d1-fc89-4e0e-8e05-2b77a5c7c33c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"RandomInfraSphere", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "3", ",", " ", 
       RowBox[{"UpTo", "[", "3", "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"23688dae-194f-4dc6-836f-e6c5ba552f7c"],

