Cell["RandomInfraSphere", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"09c4509a-4bce-47e4-9710-a9fe5c365f70"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c28f758-e8cc-41ae-8a93-eb6fd10926cf"],
 "\[LineSeparator]",
 "gives a random sphere of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ", as a sorted vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c24223da-5eb9-47fd-b7d4-566f9fc88fa6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e2e8ba8-fa60-4a28-b10d-169a898c117c"],
 "\[LineSeparator]",
 "gives a random sphere in the band of radii ",
 StyleBox["r", "TI"],
 " to ",
 StyleBox["s", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"02fd6134-8421-44d6-a3e3-254b234bd625"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dad6ca41-5c32-47ad-b499-1c355dd173cf"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " distinct spheres.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"95d2ecf2-58c4-41cf-8d11-d88e653bd71f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSphere", "[", 
     RowBox[{
      StyleBox["c", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d429ff8-3164-420f-ada9-192e8b64ed45"],
 "\[LineSeparator]",
 "and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSphere", "[", 
     RowBox[{
      StyleBox["c", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4338fff-8f95-4cf4-9e57-7fa9ee7852ef"],
 " are the same with the sphere given as a token."
}], "Usage",ExpressionUUID->"e3c7b0be-1388-4de6-9ccf-0b4a1e938eea"],

Cell[TextData[{
 "The band is ",
 StyleBox["L = {v \[NotEqual] c : r \[LessEqual] d(c, v) \[LessEqual] s}", 
  "TI"],
 ", the shell for ",
 StyleBox["s = r", "TI"],
 ", and the exterior is ",
 StyleBox["E = {v : d(c, v) > s}", "TI"],
 ". A sphere is a connected subset ",
 StyleBox["S", "TI"],
 " of ",
 StyleBox["L", "TI"],
 " that separates ",
 StyleBox["c", "TI"],
 " from ",
 StyleBox["E", "TI"],
 ", so that every path from ",
 StyleBox["c", "TI"],
 " to ",
 StyleBox["E", "TI"],
 " meets ",
 StyleBox["S", "TI"],
 ", and is minimal: no proper subset of ",
 StyleBox["S", "TI"],
 " separates."
}], "Notes",ExpressionUUID->"7f9dfeb5-8d50-49b0-a7c5-6967e22406bb"],

Cell["\<\
On the square mesh a shell is a ring and is its own sphere. A band of two \
radii has many spheres, all connected: 60 for {1, 2} about the centre, 2100 \
for {2, 3}.\
\>", "Notes",ExpressionUUID->"8192f1d3-682b-4678-a68a-cc65ac7627de"],

Cell[TextData[{
 "On the square grid the minimal separators about the centre are not \
connected, and the result is ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1716fd1e-25c5-4dfd-8b0c-780817b1166d"],
 ". ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "\"\<Separating\>\"", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bdccf4f5-3621-4a26-8a07-7a6d3ed8ab75"],
 " gives the minimal separators themselves."
}], "Notes",ExpressionUUID->"aebfd1b5-7584-47d0-a4a0-7c0fb26163f8"],

Cell[TextData[{
 "When nothing lies beyond the band, ",
 StyleBox["E", "TI"],
 " is empty, and the only minimal separator is the empty set."
}], "Notes",ExpressionUUID->"af25a046-fe3d-4851-8c42-da88932221ef"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "186aaa62-7b04-445a-af04-d86351f41eea"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6aa742e2-7995-4e97-9a87-7d9c140cd97c"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "449d225a-1aec-45a3-84f7-417fba1cfd53"],
 ". A draw is uniform over all the spheres; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f8796bc-6e4a-43d4-88df-f1523842f804"],
 " gives them sorted."
}], "Notes",ExpressionUUID->"f97ec9ad-b351-4295-aa20-f7be3ee1163a"],

