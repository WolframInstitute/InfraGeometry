Cell["A pruning function caps the branches tried per node.", "ExampleText",ExpressionUUID->"a5750a37-722f-4a30-8763-b257bb9859c4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"RandomInfraSphere", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", "13", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "All", ",", " ", 
   RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"RandomSample", "[", 
       RowBox[{"#", ",", " ", 
        RowBox[{"UpTo", "[", "1", "]"}]}], "]"}], " ", "&"}], ")"}]}]}], 
  "]"}]}], "Input",
