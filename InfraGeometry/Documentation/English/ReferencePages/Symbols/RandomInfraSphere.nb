Cell["\<\
All four minimal connected separating subsets of the band 1 to 2 about the \
centre of a 5 by 5 grid.\
\>", "ExampleText",ExpressionUUID->"ddbe684f-0e96-484d-b7ba-7fc105d85ee1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"RandomInfraSphere", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", "13", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "All"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"72e3c21c-4b38-41a4-92e4-2a7f9305170f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
