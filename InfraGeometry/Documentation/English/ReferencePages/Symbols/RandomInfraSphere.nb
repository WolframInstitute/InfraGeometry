Cell["\<\
All four minimal connected separating subsets of the band 1 to 2 about the \
centre of a 5 by 5 grid.\
\>", "ExampleText",ExpressionUUID->"d696556d-2d0b-4911-ad39-888aef4511a8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"RandomInfraSphere", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", "13", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "All"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a26ddb54-44d7-4362-9c07-f719d2ae7f8d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
