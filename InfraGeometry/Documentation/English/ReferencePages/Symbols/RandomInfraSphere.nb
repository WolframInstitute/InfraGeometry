Cell["\<\
On the grid the bands {1, 2} and {2, 3} have 16 and 161 minimal separators, \
and none is connected:\
\>", "ExampleText",ExpressionUUID->"d31eda44-0aff-4f72-80b2-61e173522a9b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"RandomInfraSphere", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "b", ",", " ", "All", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", "p"}]}], "]"}]}], ",", "\n", 
     "    ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "\"\<Separating\>\"", "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], 
          "}"}]}], "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a48704bd-28e1-4153-bcf9-bd42fdb76437"],

