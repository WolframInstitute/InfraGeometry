    "8", ",", "9", ",", "12", ",", "14", ",", "17", ",", "18", ",", "19"}], 
    "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
    "7", ",", "8", ",", "12", ",", "14", ",", "17", ",", "18", ",", "19"}], 
    "}"}], ",", 
