      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"ConnectedComponents", " ", "@", " ", 
        RowBox[{"Subgraph", "[", 
         RowBox[{"g", ",", " ", "wall"}], "]"}]}]}]}], ",", "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"aacd8d68-6592-44bb-9835-d9c2b2720341"],

