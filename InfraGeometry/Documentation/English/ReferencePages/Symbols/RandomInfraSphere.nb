Cell["\<\
On the mesh the shell of radius 3 is a cycle, and the sphere is the whole \
shell, the vertices of the circle of radius 3:\
\>", "ExampleText",ExpressionUUID->"06ef2ed7-ab7f-4c83-8e89-10ddc7bc9bdb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sphere", " ", "=", " ", 
     RowBox[{"RandomInfraSphere", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "3", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"sphere", ",", " ", "c"}], "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "sphere", "]"}], ",", " ", 
        RowBox[{"sphere", " ", "===", " ", 
         RowBox[{"Sort", " ", "@", " ", 
          RowBox[{"RandomInfraCircle", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}]}]}], "}"}]}], 
     ",", "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f1499b28-d421-401b-a645-a7cf2a4d9a2c"],

