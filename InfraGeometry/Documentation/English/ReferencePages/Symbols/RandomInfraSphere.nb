Cell["\<\
Three separating subsets of the shell of radius 3, each drawn in its own \
colour on the hexagonal tiling.\
\>", "ExampleText",ExpressionUUID->"b2aef1bb-e6ee-483b-8d05-351a65f0269a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"RandomInfraSphere", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "3", ",", " ", 
       RowBox[{"UpTo", "[", "3", "]"}]}], "]"}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"501c3c41-15d7-4b14-93d0-541d691331f1"],

