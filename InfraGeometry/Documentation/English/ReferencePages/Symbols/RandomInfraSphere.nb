Cell["Properties", "ExampleSubsection",ExpressionUUID->"ab4bd807-7cd9-4fc8-bf9d-da7c7e3673e5"],

Cell["\<\
On the grid the shell of radius 3 separates but has no edges. Without \
connectedness the sphere is the whole shell of 12 vertices; with it there is \
none:\
\>", "ExampleText",ExpressionUUID->"eb7cf07a-d614-4e3e-af99-f3ce27f4dd79"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sphere", " ", "=", " ", 
     RowBox[{"RandomInfraSphere", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "3", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Separating\>\"", "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"sphere", ",", " ", "c"}], "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "sphere", "]"}], ",", " ", 
        RowBox[{"RandomInfraSphere", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}], "}"}]}], ",", 
     " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"00c81475-e44a-4095-9af3-d786aea1af02"],

