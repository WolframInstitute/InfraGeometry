 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell["\<\
On the mesh nothing lies beyond radius 6. The empty set is then the only \
minimal separator, and it is not connected:\
\>", "ExampleText",ExpressionUUID->"e00a3207-901f-415a-8910-9ed730e59179"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"RandomInfraSphere", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "6", ",", " ", "All", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", "#"}]}], "]"}], " ", "&"}], " ", 
    "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "\"\<Separating\>\"", "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], "}"}]}],
      "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3bb83f30-2bb5-4032-b0bf-f3bb504cb4ed"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", "}"}], "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"5907a5a1-17dd-4322-9e0b-c36ec65e571e"]
}, Open  ]]
}, Open  ]],

