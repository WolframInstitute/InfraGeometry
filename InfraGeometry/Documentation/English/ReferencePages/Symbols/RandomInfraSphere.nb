Cell[CellGroupData[{
Cell["RandomInfraSphere", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"58d0b4af-c1d4-4c52-917a-93d30b9a8ee3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ced800a-4995-4496-8d92-6af9694453d6"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4c669a6-471c-4381-b1e1-326397d24fe4"],
 " of exactly ",
 StyleBox["n", "TI"],
 " inclusion-minimal connected subsets of the shell of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " that separate the side of ",
 StyleBox["c", "TI"],
 " from the far side.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3931abc6-4b1a-496f-9d70-24f6ec94d852"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fed8665-8c5b-4932-9387-cf1aaa14ec8c"],
 "\[LineSeparator]",
 "takes the band from ",
 StyleBox["r", "TI"],
 " to ",
 StyleBox["s", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1fb3eec2-0844-4052-9837-9935cb0865a0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c545aee3-563e-4933-a36d-4471d547c477"],
 "\[LineSeparator]",
 "draws one such subset."
}], "Usage",ExpressionUUID->"19af8114-6f65-4399-9d85-ba763bf9ca6f"],

Cell[TextData[{
 "The default draw is random. Seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "376ce01a-5bce-4b77-9110-a58f31d1f933"],
 " to reproduce it. Give ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09fbda40-b921-4901-a4a1-89f8fe2035fe"],
 " for deterministic descent. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1729d42-cc6f-4c6a-8b38-218ea2e833cb"],
 " with ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01b1b903-41a4-499f-b8de-89ca80fa6f89"],
 " keeps the full enumeration without drawing."
}], "Notes",ExpressionUUID->"4e445cbb-6542-4851-ab28-fa062458fb06"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " may be ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66edf520-c5fa-4dfb-a476-f924f65ba562"],
 ", which gives up to ",
 StyleBox["n", "TI"],
 ", or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ac96000-1d7e-4e2d-9a83-a398c6f0cd0e"],
 "."
}], "Notes",ExpressionUUID->"bad9a430-9771-45bd-a117-36fa0c661dbf"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e606bd53-b9a6-4dc9-9193-f3aa70c9670f"],
 " takes ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08880ddf-7c47-44d5-844f-89f7d7c17d67"],
 " (default), ",
 Cell[BoxData[
  RowBox[{"{", "\"\<Separating\>\"", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34e63515-9161-40c1-b777-fb78d5512581"],
 " for the inclusion-minimal separating subsets that need not be connected, \
or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab8bf276-9b77-4cd2-a8d1-9818e15e8d07"],
 " for the level set as the one member."
}], "Notes",ExpressionUUID->"897a01fb-9d3a-4fc4-bfb9-df043bd9438e"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bd01e01-f602-464f-a5e8-29f4a6051ddd"],
 " sees the vertices that can be peeled next and gives the ones to try, in \
order. ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7f7972a-f204-45d0-87bd-bdef6cf8f293"],
 " (default) peels in random order. ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe5474e0-984e-4536-8aa1-9d986c5200cc"],
 " gives the canonical peel; ambient ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45f49377-fced-4211-972a-051258c98d1c"],
 " reproduces a draw; ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"RandomSample", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"UpTo", "[", "n", "]"}]}], "]"}], " ", "&"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "399293e6-cc09-4465-a681-adddc4268806"],
 " keeps at most ",
 StyleBox["n", "TI"],
 " branches per node, and the result is then minimal among the survivors."
}], "Notes",ExpressionUUID->"135d82de-0eb4-4793-8d53-896246363744"],

Cell[TextData[{
 "The search peels the shell vertex by vertex while it keeps separating. It \
is the specialised search behind ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "28942bf6-f500-43ad-a7eb-7694e3e32591"],
 ", whose ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "540e156e-8259-4114-a778-72b90ea03fb8"],
 " clause calls it. The family can be large: all members on a medium tiling \
take long."
}], "Notes",ExpressionUUID->"d956f040-e794-461b-9044-582cd4e506b6"],

Cell[TextData[{
 "When the shell does not separate, as on a torus band that wraps, the result \
is ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b0c16be-8aae-449a-afec-c7754906afbe"],
 "."
}], "Notes",ExpressionUUID->"d1984c09-f63c-4b74-837e-c75a791ab1e5"]
}, Open  ]],

