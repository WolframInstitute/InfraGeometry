Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "\"\<Separating\>\"", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd2a3284-3238-4013-982f-05104cd3e6f9"],
 " the subsets need not be connected, so they can be smaller."
}], "ExampleText",ExpressionUUID->"a6776f21-c231-4e2b-b7bc-d13b883b1de9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"7", ",", " ", "7"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "/@", " ", 
      RowBox[{"RandomInfraSphere", "[", 
       RowBox[{"g", ",", " ", "25", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"UpTo", "[", "3", "]"}], ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", "\"\<Separating\>\"", "}"}]}]}], "]"}]}], ",", "\n", 
     "   ", 
