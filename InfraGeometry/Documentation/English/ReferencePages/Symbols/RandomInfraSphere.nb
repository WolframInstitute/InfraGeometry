Cell["\<\
All four minimal connected separating subsets of the band 1 to 2 about the \
centre of a 5 by 5 grid.\
\>", "ExampleText",ExpressionUUID->"5a799f4e-80c1-45e4-b2ec-e12727cfbddb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"RandomInfraSphere", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", "13", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "All"}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6b9c4ec3-c25b-4f44-9283-17cab606ea56"],

