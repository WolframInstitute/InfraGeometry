Cell[CellGroupData[{
Cell["RandomInfraSphere", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7a250321-7285-4534-9afa-ed08131cfa1e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c427f5b-5b8b-4333-a16c-06665f429102"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c56cf2dc-ffb4-4aba-8065-9da2943426b5"],
 " of exactly ",
 StyleBox["n", "TI"],
 " inclusion-minimal connected subsets of the shell of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " that separate the side of ",
 StyleBox["c", "TI"],
 " from the far side.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c92283ea-2188-447c-adf5-ead041a0947b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5246cbc2-50cf-4d4e-8944-9309dd01e209"],
 "\[LineSeparator]",
 "takes the band from ",
 StyleBox["r", "TI"],
 " to ",
 StyleBox["s", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"bd809c3e-9b5c-4e78-9741-50b5d70ea0f4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c9d87a1-2c5b-4f7d-b66a-a807bedf85ef"],
 "\[LineSeparator]",
 "gives one such subset, the first by the default method."
}], "Usage",ExpressionUUID->"551509ee-5a0d-4997-ab61-d777eebda278"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " may be ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01ec0561-b353-4b6c-9bac-d6788dcdfaac"],
 ", which gives up to ",
 StyleBox["n", "TI"],
 ", or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166b1db0-af41-454c-ac6f-d697c88c948a"],
 "."
}], "Notes",ExpressionUUID->"43eadd27-a7fa-4005-a844-11ee2b477cdd"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29a74e17-dfb4-4d3b-8aec-af1311d57517"],
 " takes ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd88bd85-922b-4e97-b50a-6084464a556f"],
 " (default), ",
 Cell[BoxData[
  RowBox[{"{", "\"\<Separating\>\"", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb90f4b7-5fd0-4a37-a666-d76076b1eff7"],
 " for the inclusion-minimal separating subsets that need not be connected, \
or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "668457e3-bb16-415d-8a6e-c42cea6e828b"],
 " for the level set as the one member."
}], "Notes",ExpressionUUID->"16fd9a04-e7df-4572-b911-f08604e47600"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1ecb524-026d-4c1e-a970-bf04e72798a5"],
 " sees the vertices that can be peeled next and gives the ones to try, in \
order. ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cef902f2-e529-4738-be93-dd5a9b799785"],
 " (default) is the canonical peel, so the count-less call is one minimal \
subset, deterministic; ",
 Cell[BoxData["RandomSample"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "adb48742-68e8-48fb-9613-a1235c09d6b3"],
 " peels in random order, seeded by an ambient ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c84e1bd-89a0-4dc1-b68d-f592a8044144"],
 "; ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"RandomSample", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"UpTo", "[", "n", "]"}]}], "]"}], " ", "&"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1029e8a9-5ee5-4e65-8d90-0d8f399181dc"],
 " keeps at most ",
 StyleBox["n", "TI"],
 " branches per node, and the result is then minimal among the survivors."
}], "Notes",ExpressionUUID->"3911e606-fe46-4b9a-9c73-f28c52052bbe"],

Cell[TextData[{
 "The search peels the shell vertex by vertex while it keeps separating. It \
is the specialised search behind ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a86879b2-6cd4-4da5-b594-39828ee60ef9"],
 ", whose ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2e0f3346-daa4-466d-8dd0-7dd6b46e8ec7"],
 " clause calls it. The family can be large: all members on a medium tiling \
take long."
}], "Notes",ExpressionUUID->"894eca69-0d1d-408e-9fa3-7fbb3b60392b"],

Cell[TextData[{
 "When the shell does not separate, as on a torus band that wraps, the result \
is ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ef107f6-d842-482f-91a1-4bbaf64a2e2a"],
 "."
}], "Notes",ExpressionUUID->"07dec0df-3b38-4038-a9ca-794847c29b16"]
}, Open  ]],

