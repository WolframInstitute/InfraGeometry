Cell["Three spheres of the band {2, 3} on the mesh:", "ExampleText",ExpressionUUID->"d39efe49-8e03-4a49-9e19-5336b2bc7243"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"sphere", ",", " ", "c"}], "}"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"Length", "[", "sphere", "]"}]}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"sphere", ",", " ", 
        RowBox[{"RandomInfraSphere", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", "3", ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"026c5743-972d-4c69-9384-21a834abd3a9"],

