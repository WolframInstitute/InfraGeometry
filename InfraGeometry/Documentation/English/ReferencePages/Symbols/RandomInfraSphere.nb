Cell["\<\
Removing a sphere of the band {3, 4} leaves the centre with vertices within \
distance 3 only:\
\>", "ExampleText",ExpressionUUID->"c6561955-213c-454d-af54-a75459c66e26"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sphere", " ", "=", " ", 
     RowBox[{"RandomInfraSphere", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@",
      " ", 
     RowBox[{"VertexComponent", "[", 
      RowBox[{
       RowBox[{"VertexDelete", "[", 
        RowBox[{"g", ",", " ", "sphere"}], "]"}], ",", " ", "c"}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e862b647-d6ea-4f57-a2ea-b8e1efc6b132"],

Cell[BoxData["3"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c2227753-6003-4a8f-8455-b86893b02ada"]
}, Open  ]],

Cell["Every draw is a member of the family:", "ExampleText",ExpressionUUID->"a3c2ba63-3538-4cde-8d7a-a2d0687af626"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"RandomInfraSphere", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", "5", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"InfraMemberQ", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraSphere", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", "#"}], 
       "]"}], " ", "&"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3e2c06df-b9ff-418d-bf3f-22c7f7881035"],

