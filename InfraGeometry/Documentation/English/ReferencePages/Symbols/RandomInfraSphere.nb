         RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"UpTo", "[", "3", "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cff4943b-ad84-44eb-a559-df32522afef5"],

