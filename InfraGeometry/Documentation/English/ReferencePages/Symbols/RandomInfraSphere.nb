Cell["\<\
A minimal separator in the band {2, 3} about the centre of the square grid, \
and a sphere in the same band of the square mesh:\
\>", "ExampleText",ExpressionUUID->"f3dae386-ab76-4489-ac41-89d8ca3d0e64"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", "spec"}], ",", " ", "\"\<Small\>\"",
           ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"sphere", " ", "=", " ", 
        RowBox[{"RandomInfraSphere", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"Properties", " ", "->", " ", 
           RowBox[{"Last", " ", "@", " ", "spec"}]}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", "sphere",
           ",", " ", "c"}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"spec", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", 
          RowBox[{"{", "\"\<Separating\>\"", "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], 
           "}"}]}], "}"}]}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"36e954b5-8d69-4616-94f7-915af43558ad"],

