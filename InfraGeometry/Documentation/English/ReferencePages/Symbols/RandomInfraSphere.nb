Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraSphere", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c25c4bc9-8672-4301-8cf6-11b90471c90c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a12ad0e-981e-481c-9c58-718c18188cb6"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48234006-f25e-4ad4-be2e-307aeb59f51f"],
 " of exactly ",
 StyleBox["n", "TI"],
 " inclusion-minimal connected subsets of the shell of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " that separate the side of ",
 StyleBox["c", "TI"],
 " from the far side.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c0319084-bfbc-49a4-b563-350b2d00f87f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d61fe1fd-165b-43a3-9829-6c328dcb0ba8"],
 "\[LineSeparator]",
 "takes the band from ",
 StyleBox["r", "TI"],
 " to ",
 StyleBox["s", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"75a36ffe-38ac-4398-b49b-0bb33cf3245c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "761241f5-f69f-40a8-a0ed-7a018288adc1"],
 "\[LineSeparator]",
 "draws one such subset."
}], "Usage",ExpressionUUID->"adee3795-c0f0-47b5-94f2-89491995bb12"],

Cell[TextData[{
 "The default draw is random. Seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4319f646-5517-4c67-b617-db87686ed6a6"],
 " to reproduce it. Give ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55e8ab29-9130-4ee3-84e9-a770b06d3bc3"],
 " for deterministic descent. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f693896-b2d2-4992-8341-c34e8cd6d9a6"],
 " with ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c4319ae-939f-43dc-be86-d4250afad8c0"],
 " keeps the full enumeration without drawing."
}], "Notes",ExpressionUUID->"4c9fb749-8cc5-4697-851b-90de4fa509c9"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " may be ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f86b008b-88d8-4e76-a671-c874af63393b"],
 ", which gives up to ",
 StyleBox["n", "TI"],
 ", or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bcd81267-01fa-4701-9ea0-1843c53caf46"],
 "."
}], "Notes",ExpressionUUID->"37917e3c-855e-40ad-a9f1-1dce0b365af1"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4e9ae20-1498-4ebd-963b-382efe5750d3"],
 " takes ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b7d56af-6528-4330-be60-c673e3775f6a"],
 " (default), ",
 Cell[BoxData[
  RowBox[{"{", "\"\<Separating\>\"", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80037801-78ce-4623-ac34-f899580e744c"],
 " for the inclusion-minimal separating subsets that need not be connected, \
or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9f99dee-7dde-4379-90c4-49dc77cfac66"],
 " for the level set as the one member."
}], "Notes",ExpressionUUID->"e30b9fda-350b-4fa5-969a-cd8ecc15db68"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3bb2fee-5ad7-46b9-ad7c-8368d0148a6a"],
 " sees the vertices that can be peeled next and gives the ones to try, in \
order. ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b75f01c-16e1-4b17-ab88-487d27ba58db"],
 " (default) peels in random order. ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82211045-728e-4fa3-b392-46819a14f90f"],
 " gives the canonical peel; ambient ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ea412c6-b384-49de-ba2b-01e61d07a88b"],
 " reproduces a draw; ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"RandomSample", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"UpTo", "[", "n", "]"}]}], "]"}], " ", "&"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7af89ad-e0de-41fd-9fe4-1e881c661821"],
 " keeps at most ",
 StyleBox["n", "TI"],
 " branches per node, and the result is then minimal among the survivors."
}], "Notes",ExpressionUUID->"072c177b-d813-45f8-9ab5-e171a4f4df78"],

Cell[TextData[{
 "The search peels the shell vertex by vertex while it keeps separating. It \
is the specialised search behind ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "42c47d45-6d35-437c-8737-005759cfe61b"],
 ", whose ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "01435f29-918d-49e6-b5ea-925a23e80dc4"],
 " clause calls it. The family can be large: all members on a medium tiling \
take long."
}], "Notes",ExpressionUUID->"05ba7e8f-7feb-4fbd-947e-ad4594456486"],

Cell[TextData[{
 "When the shell does not separate, as on a torus band that wraps, the result \
is ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ded7737e-b757-48cb-95ee-b19fc45dcd61"],
 "."
}], "Notes",ExpressionUUID->"7f2ba237-ef4c-45a3-b82d-38a9ca530ed6"]
}, Open  ]],

