Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"61aa4425-16e5-4905-a056-b6264ea13c3e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c063d728-6a78-4084-9285-64f54bef300a"],
 "\[LineSeparator]",
 "gives a random sphere of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ", a wall in the shell of radius ",
 StyleBox["r", "TI"],
 ", as a sorted vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"82065963-8f05-4583-88d6-f60bacb550a6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dc32da8-2685-4177-8d1e-30815ff20e29"],
 "\[LineSeparator]",
 "gives a random wall in the band of radii ",
 StyleBox["r", "TI"],
 " to ",
 StyleBox["s", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e4b6b034-3770-4fc0-adcd-7899f5033c39"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraSphere"]], 
