 InterpretationBox[Cell[
  "Properties & Relations", "ExampleSection",ExpressionUUID->
   "d18b1e1f-4c4c-49a5-bb54-1e5e145ddf4e"],
  $Line = 0; Null]], "ExampleSection",
 CellID->2123667759,ExpressionUUID->"0e0d5f37-f3c9-4474-a22b-9f10dcc8b438"],

Cell["\<\
A sphere of the band {1, 2} separates the centre from every vertex beyond \
distance 2, and no vertex can be removed from it:\
\>", "ExampleText",ExpressionUUID->"bcb76ae8-9c47-41d2-bc88-1a84c64ad63e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sphere", " ", "=", " ", 
     RowBox[{"RandomInfraSphere", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", ">", " ", 
         "2"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"separatesQ", " ", "=", " ", 
     RowBox[{"s", " ", "|->", " ", 
      RowBox[{"!", " ", 
       RowBox[{"IntersectingQ", "[", 
        RowBox[{
         RowBox[{"VertexComponent", "[", 
          RowBox[{
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "s"}], "]"}], ",", " ", "c"}], "]"}], ",", 
         " ", "far"}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"separatesQ", "[", "sphere", "]"}], ",", " ", 
     RowBox[{"NoneTrue", "[", 
      RowBox[{"sphere", ",", " ", 
       RowBox[{
        RowBox[{"separatesQ", "[", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{"sphere", ",", " ", "#"}], "]"}], "]"}], " ", "&"}]}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"03ead9e5-24fe-405d-b324-02015c475605"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"87609533-61ee-45b5-9c7f-5cdad29066fd"]
}, Open  ]],

Cell["The token form gives the same draw:", "ExampleText",ExpressionUUID->"be0b0f03-9947-4a00-b077-e45e6421e82f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"RandomInfraSphere", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraSphere", "[", 
       RowBox[{"c", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], " ", "===", 
    " ", 
    RowBox[{"RandomInfraSphere", "[", 
     RowBox[{"g", ",", " ", "c", ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"95bbd175-e23d-4d7d-90df-967a21ec4a68"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"83bb41eb-d76f-4a0e-b477-64f0563a395d"]
}, Open  ]]
}, Open  ]],

