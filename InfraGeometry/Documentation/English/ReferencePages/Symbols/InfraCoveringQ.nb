Cell["\<\
The displacement bundle of the grid is a fibration but not a covering: a pair \
has several lifts over a base edge.\
\>", "ExampleText",ExpressionUUID->"3677392f-124d-42fd-ae81-ac788411ab0d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraDisplacementBundle", "[", 
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}],
        ",", " ", "1"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraAtMostOneEdgeLiftQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraCoveringQ", "[", "fib", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"74505634-f2cd-4c44-b643-33d9bbe2dc88"],

