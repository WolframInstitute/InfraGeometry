Cell["The hexagon covers the triangle with two sheets.", "ExampleText",ExpressionUUID->"622edc80-228d-4dc3-88b5-4503bb5da9f6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "6", " ", "]"}], ",", " ", 
       RowBox[{"vertex", " ", "|->", " ", 
        RowBox[{"Mod", "[", " ", 
         RowBox[{"vertex", ",", " ", "3", ",", " ", "1"}], " ", "]"}]}]}], 
      " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", " ", "fib", " ", "]"}], ",", 
     " ", 
     RowBox[{"InfraCoveringQ", "[", " ", "fib", " ", "]"}]}], " ", "}"}]}], 
  " ", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"44d15396-85aa-4e30-9489-767607d573d7"],

