Notebook[{

Cell[CellGroupData[{
Cell["InfraCoveringQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6a6dbfcf-6f69-4a19-825c-d3722d69ec48"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCoveringQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCoveringQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce6b8ead-69f3-4bd5-8bb9-bb6baf1cb594"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["fib", "TI"],
 " has unique edge lifting and edgeless fibers.",
 "\n"
}], "Usage",ExpressionUUID->"758a1551-6ba2-4a18-950e-3d1474002a90"],

Cell["\<\
The projection gives a bijection from the total neighbours of each vertex \
onto the neighbours of its base vertex.\
\>", "Notes",ExpressionUUID->"6ed92fa2-52c4-435d-8815-4eaa8b446b2b"],

Cell["\<\
The number of sheets is constant on each connected base component. It may \
differ between disconnected components.\
\>", "Notes",ExpressionUUID->"d65f51fd-c310-43b3-a4f8-1ed21ea09d72"],

Cell[TextData[{
 "A covering over a connected base is a graph bundle with a discrete fiber. \
On a disconnected base, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberBundleQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberBundleQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0d870c1a-bd1f-4207-b978-a2c46050022f"],
 " additionally requires the same fiber size across components."
}], "Notes",ExpressionUUID->"2c7facfd-a24b-4f9b-a4c8-f4b77302357e"],

Cell["\<\
Nontrivial monodromy is allowed. A connected double cover of a cycle is a \
covering.\
\>", "Notes",ExpressionUUID->"0bf3f255-6f43-42c9-868a-bb4fa4f3c01c"],

Cell["The empty fibered graph satisfies the condition vacuously.", "Notes",ExpressionUUID->"d72d5652-109b-4cc0-8a46-004d4d9121b2"],

Cell["\<\
A nonempty list is tested by conjunction; an empty list gives False. \
Unsupported inputs remain unevaluated.\
\>", "Notes",ExpressionUUID->"7d05b94f-b740-4d57-8d30-86835dba12d6"]
}, Open  ]],

