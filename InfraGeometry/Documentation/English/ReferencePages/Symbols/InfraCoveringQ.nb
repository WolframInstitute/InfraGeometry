Cell["\<\
Every total vertex has exactly one neighbour over each base neighbour, and \
the double cover of the grid is connected:\
\>", "ExampleText",ExpressionUUID->"98e45f33-17d7-4032-9b91-3accf10f63e7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Covering\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Union", " ", "@", " ", 
      RowBox[{"Catenate", "[", 
       RowBox[{"Values", " ", "/@", " ", 
        RowBox[{"Values", " ", "@", " ", 
         RowBox[{"InfraEdgeLiftMultiplicity", "[", "fib", "]"}]}]}], "]"}]}], 
     ",", " ", 
     RowBox[{"ConnectedGraphQ", " ", "@", " ", 
      RowBox[{"InfraTotalSpace", "[", "fib", "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"de1baba5-466d-45e0-9454-4e66a8cc0425"],

