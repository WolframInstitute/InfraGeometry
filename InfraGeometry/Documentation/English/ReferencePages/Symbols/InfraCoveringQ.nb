Notebook[{

Cell[CellGroupData[{
Cell["InfraCoveringQ", "ObjectName",ExpressionUUID->"70e31079-1bcf-4c89-bcb4-587870d63757"],

Cell["LLM generated.", "Notes",ExpressionUUID->"85647c75-d7e5-4503-b9bc-6c1b3974db07"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"afb1288d-553b-4f02-a5a9-2db10d20343d"],
 Cell[BoxData[
  RowBox[{"InfraCoveringQ", "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cd73576-a5f8-460c-a6cf-90e1b1057067"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["fib", "TI"],
 " has unique edge lifting and edgeless fibers.",
 "\n"
}], "Usage",ExpressionUUID->"667a89d0-11a8-410e-8eb4-f016f365d79e"],

Cell["\<\
The projection gives a bijection from the total neighbours of each vertex \
onto the neighbours of its base vertex.\
\>", "Notes",ExpressionUUID->"28591ba9-c12b-4461-8d56-b54fabae7a0e"],

Cell["\<\
The number of sheets is constant on each connected base component. It may \
differ between disconnected components.\
\>", "Notes",ExpressionUUID->"a0ff5cc9-884a-4a48-9c36-fee7a7a9a2fe"],

Cell[TextData[{
 "A covering over a connected base is a graph bundle with a discrete fiber. \
On a disconnected base, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberBundleQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberBundleQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6efaed6f-cfff-48ba-b839-7808c860624f"],
 " additionally requires the same fiber size across components."
}], "Notes",ExpressionUUID->"a06b4274-a71c-4629-b3c8-61c02caa4161"],

Cell["\<\
Nontrivial monodromy is allowed. A connected double cover of a cycle is a \
covering.\
\>", "Notes",ExpressionUUID->"67f21f4e-0d52-4424-ae5b-3696185400cf"],

Cell["The empty fibered graph satisfies the condition vacuously.", "Notes",ExpressionUUID->"af665ab1-f543-4f8f-a271-d2fef4689ecd"],

Cell["\<\
A nonempty list is tested by conjunction; an empty list gives False. \
Unsupported inputs remain unevaluated.\
\>", "Notes",ExpressionUUID->"db81a09b-6b64-4728-aabb-76d893eafb25"]
}, Open  ]],

