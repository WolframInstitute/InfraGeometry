Cell[CellGroupData[{
Cell["InfraCoveringQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f4894eb2-856d-49fc-b82c-b26c9a93fdfe"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCoveringQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCoveringQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "465faf81-166f-4021-9ce1-7ad3810d182c"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b9f7c479-fee6-4fe6-98b8-9c2cc7955271"],
 " if the fibered graph ",
 StyleBox["fib", "TI"],
 " is a covering: every total vertex has exactly one neighbour over each \
neighbour of its base vertex, and no total edge is vertical.",
 "\n"
}], "Usage",ExpressionUUID->"6c36bb1d-ac33-42da-91c8-fcaf156a2379"],

Cell[TextData[{
 StyleBox["fib", "TI"],
 " is a covering when, for every total vertex ",
 StyleBox["x", "TI"],
 " over ",
 StyleBox["p", "TI"],
 " and every base neighbour ",
 StyleBox["q", "TI"],
 " of ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["x", "TI"],
 " has exactly one neighbour over ",
 StyleBox["q", "TI"],
 ", and every fiber ",
 StyleBox["F\:209a", "TI"],
 " has no edges. The projection then maps the neighbours of ",
 StyleBox["x", "TI"],
 " one to one onto the neighbours of ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"00036fbd-129f-44d8-8333-ec5680fe0a37"],

Cell["\<\
On a connected base every fiber has the same number of vertices, the number \
of sheets.\
\>", "Notes",ExpressionUUID->"a18d0e35-03b9-46ac-8ba3-9b1473c486b9"],

Cell[TextData[{
 "A covering is a graph bundle whose fiber has no edges: over a connected \
base it satisfies ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberBundleQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberBundleQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6776c4e7-211b-4f22-90b0-f5c7123fc90f"],
 "."
}], "Notes",ExpressionUUID->"0d51ccc4-871b-47d2-8eeb-fb60398c993d"],

Cell["\<\
Coverings see the cycles of the graph, not the topology of the space it \
models. The plane has no connected double cover, but the square grid has \
many: going once around a cycle of the base may end on the other sheet.\
\>", "Notes",ExpressionUUID->"baae95bd-1bee-4549-a8c0-e303dfbe856b"],

Cell[TextData[{
 "A list of fibered graphs gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3f021e9e-4968-4c76-abba-c217c083eac7"],
 " when every member is a covering; the empty list gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4044bf45-c072-47fa-8bb0-cac4363179cc"],
 "."
}], "Notes",ExpressionUUID->"d9e72aeb-6d3b-4c8f-9928-7a87a0b72f1e"]
}, Open  ]],

