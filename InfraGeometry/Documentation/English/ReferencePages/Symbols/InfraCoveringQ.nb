Cell["\<\
Three fibered graphs over the cycle of length 8 with two vertices in every \
fiber. All have unique edge lifting; the prism and the M\[ODoubleDot]bius \
ladder have vertical edges, the rungs, and are not coverings:\
\>", "ExampleText",ExpressionUUID->"689d601c-46c7-4c00-94ff-0edf2dd044c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fib", " ", "=", " ", 
        RowBox[{"InfraFiberedSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraFiberedGraphHighlight", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraUniqueEdgeLiftingQ", "[", "fib", "]"}], ",", " ", 
           RowBox[{"InfraCoveringQ", "[", "fib", "]"}]}], "}"}]}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<CycleProductBundle\>\"", ",", 
        " ", "\"\<CycleDoubleCover\>\"", ",", 
        " ", "\"\<MoebiusLadderCover\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"36a1d5fb-6d63-4f07-8a3a-33fed5e98133"],

