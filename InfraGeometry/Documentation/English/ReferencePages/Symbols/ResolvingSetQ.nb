Cell["\<\
Two corners of the square, hexagonal and triangular tilings, red, tell apart \
only the vertices on the line between them: every other vertex, orange, has a \
mirror image at the same two distances. Three corners resolve each tiling.\
\>", "ExampleText",ExpressionUUID->"186774b7-5144-4b03-a4c2-3cb30eb74c2f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"panels", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "       ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
             RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
            "]"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{"stations", " ", "=", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"FindResolvingSet", "[", "g", "]"}]}]}], "}"}], ",", "\n",
          "       ", 
         RowBox[{"{", 
          RowBox[{"twoStations", " ", "=", " ", 
           RowBox[{"Take", "[", 
            RowBox[{"stations", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", 
         "       ", 
         RowBox[{"{", 
          RowBox[{"unresolved", " ", "=", " ", 
           RowBox[{"Catenate", " ", "@", " ", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"Values", " ", "@", " ", 
               RowBox[{"GroupBy", "[", 
                RowBox[{
                 RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
                 RowBox[{
                  RowBox[{"RadarCoordinates", "[", 
                   RowBox[{"g", ",", " ", "twoStations", ",", " ", "#"}], 
                   "]"}], " ", "&"}]}], "]"}]}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", "#", "]"}], " ", ">", " ", "1"}], " ", 
               "&"}]}], "]"}]}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraSubstrateHighlight", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"AssociationThread", "[", 
                 RowBox[{"unresolved", ",", " ", "1"}], "]"}], " ", "->", " ",
                 "StandardOrange"}], ",", " ", 
               RowBox[{"twoStations", " ", "->", " ", "StandardRed"}]}], 
              "}"}]}], "]"}], ",", "\n", "        ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ResolvingSetQ", "[", 
              RowBox[{"g", ",", " ", "twoStations"}], "]"}], ",", " ", 
             RowBox[{"ResolvingSetQ", "[", 
              RowBox[{"g", ",", " ", "stations"}], "]"}]}], "}"}]}], "}"}]}], 
        "]"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
           " ", "\"\<HexagonalTilingGraph\>\"", ",", 
           " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"First", " ", "/@", " ", "panels"}], "]"}], ",", " ", 
     RowBox[{"Last", " ", "/@", " ", "panels"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"83524f5b-1b0e-4281-8067-ad4b6227ca8b"],

