Cell["\<\
A metric basis of the square mesh has three vertices. Without any one of them \
it no longer resolves:\
\>", "ExampleText",ExpressionUUID->"d2d59818-f0f0-4d7b-91a6-9d2a1d47c864"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"basis", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FindResolvingSet", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", "basis", "}"}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ResolvingSetQ", "[", 
         RowBox[{"g", ",", " ", "basis"}], "]"}], ",", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"ResolvingSetQ", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Delete", "[", 
             RowBox[{"basis", ",", " ", "k"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], "}"}]}], ",", "\n",
      "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"148e585f-957b-4c4f-ab52-8bc22f4884fe"],

