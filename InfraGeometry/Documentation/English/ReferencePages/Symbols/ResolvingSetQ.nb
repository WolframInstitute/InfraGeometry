Cell["\<\
The rim vertices of the square grid are leaves, and the two leaves at a \
corner are twins. All the other vertices together do not resolve the grid; \
with one of the two added they do:\
\>", "ExampleText",ExpressionUUID->"1ca4efb7-6f5d-4f60-80d9-2b4cc65e4024"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"vertexAt", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"Round", " ", "@", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}], ",", " ", 
       RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"twins", " ", "=", " ", 
     RowBox[{"vertexAt", " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "1"}], "}"}]}], "}"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"others", " ", "=", " ", 
     RowBox[{"Complement", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "twins"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", "twins", "}"}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ResolvingSetQ", "[", 
         RowBox[{"g", ",", " ", "others"}], "]"}], ",", " ", 
        RowBox[{"ResolvingSetQ", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"Append", "[", 
           RowBox[{"others", ",", " ", 
            RowBox[{"First", " ", "@", " ", "twins"}]}], "]"}]}], "]"}]}], 
       "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6e19fb1f-51b2-4005-92a4-5fba458d08f8"],

