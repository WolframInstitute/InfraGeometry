Cell[CellGroupData[{
Cell["ResolvingSetQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0a173d9b-b584-4e42-95c8-451847d0bcb8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ResolvingSetQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ResolvingSetQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["b1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["bk", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "400391fc-473f-42f3-8d87-9c0d50ffd7c1"],
 "\[LineSeparator]",
 "tests whether every vertex of ",
 StyleBox["g", "TI"],
 " is determined by its distances to the vertices ",
 StyleBox["b1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["bk", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"3a9a2af3-528f-44c3-85ae-9bb6d966c965"],

Cell[TextData[{
 "A list ",
 StyleBox["B = (b\:2081, \[Ellipsis], b\:2096)", "TI"],
 " of vertices resolves ",
 StyleBox["g", "TI"],
 " when the map ",
 StyleBox["v \[RightTeeArrow] (d(v, b\:2081), \[Ellipsis], d(v, b\:2096))", 
  "TI"],
 " is injective on the vertices of ",
 StyleBox["g", "TI"],
 ": for every two vertices ",
 StyleBox["u \[NotEqual] v", "TI"],
 " some ",
 StyleBox["b\:1d62", "TI"],
 " has ",
 StyleBox["d(u, b\:1d62) \[NotEqual] d(v, b\:1d62)", "TI"],
 ". The map is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RadarCoordinates"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RadarCoordinates", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e7fa5e67-0396-43aa-a416-8694c5438771"],
 "."
}], "Notes",ExpressionUUID->"9bd01f22-c6f9-4954-9ed1-2fd0ce684b2f"],

Cell[TextData[{
 "A list that contains a resolving set resolves. A smallest resolving set is \
a metric basis, found by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindResolvingSet"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindResolvingSet", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "404eac78-0b47-4162-8c10-c81f88a136c5"],
 "; its size is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MetricDimension"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/MetricDimension", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7b0b913b-b654-4f99-a80d-2ff960c89368"],
 "."
}], "Notes",ExpressionUUID->"c0742668-f354-4852-913c-1fe3485473be"],

Cell["\<\
Two vertices at the same distance from every other vertex are twins, and only \
a list that contains one of them can tell them apart.\
\>", "Notes",ExpressionUUID->"22c2f50c-3910-46b0-9865-ec6df7c38345"],

Cell[TextData[{
 "The basis must consist of vertices. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RadarCoordinates"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RadarCoordinates", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7d7aeca4-6f6d-4b61-9608-0f6b51d660b5"],
 " also accepts sets of vertices as stations."
}], "Notes",ExpressionUUID->"cc04924b-b271-4373-a2db-93d3f981354e"]
}, Open  ]],

