Cell["\<\
One vertex resolves a path only from an end, and it resolves no other graph.\
\>", "ExampleText",ExpressionUUID->"0270c1ff-d781-4892-874a-7d87244b5f27"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"PathGraph", "[", 
      RowBox[{"Range", "[", "6", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"ResolvingSetQ", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", "#", "}"}]}], "]"}], " ", "&"}]}], "]"}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ResolvingSetQ", "[", 
