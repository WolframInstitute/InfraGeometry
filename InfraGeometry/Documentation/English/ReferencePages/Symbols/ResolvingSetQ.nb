Cell["\<\
A list resolves exactly when the radar coordinates from it are distinct:\
\>", "ExampleText",ExpressionUUID->"74a8ff42-153f-4d0e-879b-0c135cb5c100"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"basis", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FindResolvingSet", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"CountDistinct", "[", 
        RowBox[{"Values", "[", 
         RowBox[{"RadarCoordinates", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"Take", "[", 
            RowBox[{"basis", ",", " ", "k"}], "]"}]}], "]"}], "]"}], "]"}], ",",
        " ", 
       RowBox[{"ResolvingSetQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Take", "[", 
          RowBox[{"basis", ",", " ", "k"}], "]"}]}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7c699820-4fb3-4066-90d9-4be6cc3c8eef"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"11", ",", "False"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"70", ",", "False"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"102", ",", "True"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"716a80a2-5382-4d23-b88a-16ba08f00ed2"]
}, Open  ]],

