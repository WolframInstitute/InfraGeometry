Cell[TextData[{
 "Thickening the radius to a band produces a genuine circle, and the \
thickness needed follows the girth: ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", " ", "5"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7b8ca1e-8c55-42e1-91c0-6faff0587763"],
 " suffices on the square grid, while the hexagonal tiling needs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", " ", "6"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81a537fd-b516-4f61-b771-09a88094f26c"],
 "."
}], "ExampleText",ExpressionUUID->"8f36f069-08c7-4161-be5e-53d8ba982cf9"],

