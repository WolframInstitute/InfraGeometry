Notebook[{

Cell[CellGroupData[{
Cell["FindInfraCircle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4e37ea5b-aec8-4d5c-9cf8-e2cef552cac8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e8d7802-25b5-4247-8f9e-1e43957b9425"],
 "\[LineSeparator]",
 "gives one circle around ",
 StyleBox["c", "TI"],
 " through the point ",
 StyleBox["p", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ", as a cyclic vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5f75428a-2156-48ec-be58-9372e9f12c97"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
     StyleBox["r", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8bc7759-136d-4268-82c4-abdf4f42ac42"],
 "\[LineSeparator]",
 "gives one circle around ",
 StyleBox["c", "TI"],
 " at radius ",
 StyleBox["r", "TI"],
 "; ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"r", ",", " ", "s"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35b27610-4e15-4a6d-bb2e-7400febac6a7"],
 " takes the band ",
 StyleBox["r", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["s", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"695ecbf3-167c-4a6d-a0e9-7c7df910d90b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["spec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45431585-0ef8-43cc-88ef-df59805db32e"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d661164-186a-4d89-b4ce-b8ffd85c0fb7"],
 " of exactly ",
 StyleBox["n", "TI"],
 " circles or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c845ee77-1458-4aa9-aaf7-fe76b0110a7e"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4322bb54-9e25-467e-88f2-dcfaf9f2cd45"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc9a11a4-830e-422c-9c00-9b69397a7a83"],
 " gives every circle."
}], "Usage",ExpressionUUID->"273152f5-8065-48fe-9a02-afa9f0c88e98"],

Cell[TextData[{
 "The band around ",
 StyleBox["c", "TI"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["v", "TI"], ":", 
     StyleBox["r", "TI"], "\[LessEqual]", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["c", "TI"], ",", 
       StyleBox["v", "TI"]}], ")"}], "\[LessEqual]", 
     StyleBox["s", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1d26470-b3c5-48ff-8197-e38a7d7d6bf4"],
 ". A circle is a shortest cycle of the subgraph induced on the band whose \
removal leaves ",
 StyleBox["c", "TI"],
 " in a component reaching no further than the band. The point form takes the \
band at ",
 StyleBox["d(c, p)", "TI"],
 " and keeps the circles through ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"79cad180-b96f-4462-9a52-09e2698f270e"],

Cell["\<\
A circle is returned as a cyclic vertex list: the edge from the last vertex \
back to the first is implicit, and the first vertex is not repeated.\
\>", "Notes",ExpressionUUID->"ba0ad463-fd2a-4834-895a-4955e208ba93"],

Cell[TextData[{
 StyleBox["A circle need not exist.",
  FontWeight->"Bold"],
 " On a lattice a single distance shell contains no two adjacent vertices, so \
it spans no cycle at all and the result is empty. This is not a defect of the \
definition \[LongDash] it is what a sphere of one-vertex thickness is on a \
lattice."
}], "Notes",ExpressionUUID->"f606667a-e6ec-4520-bec4-26197b1cecff"],

Cell[TextData[{
 "Thickening the radius to a band fixes it, and ",
 StyleBox["the band thickness that suffices tracks the girth of the tiling",
  FontWeight->"Bold"],
 ". On the square grid, girth 4, a two-thick band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", 
    RowBox[{"r", "+", "1"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1abfa5b-5009-4835-8615-73dbaa64d7f1"],
 " already carries a cycle. On the hexagonal tiling, girth 6, it does not: ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", 
    RowBox[{"r", "+", "1"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0339a2e5-d900-43c8-949b-3a730a95274d"],
 " is still empty and the band has to reach ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", 
    RowBox[{"r", "+", "2"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3a81a39-7f39-472e-85b9-9a14a3428ffc"],
 ". On an irregular mesh a single shell usually works, since its vertices are \
adjacent by accident of the triangulation."
}], "Notes",ExpressionUUID->"f56e8efa-5e39-4053-a6e6-e9ad2d006a3f"],

Cell[TextData[{
 "The search sweeps the band directly, length by length with ",
 Cell[BoxData["FindCycle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02f6131a-86bf-418e-b6e5-261a18067805"],
 ". It does not read the necklaces of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "259de10b-9900-45b3-a311-d7dd7ff8533b"],
 ", so it is the check on them, and it still answers where no seam cuts the \
band open, or where nothing lies beyond the band and separation is vacuous. \
It returns exactly the shapes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraVertexList", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c8013743-e7d6-4206-9d48-c1076a316845"],
 " gives for that head. To count circles without enumerating them, use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4d44062d-23f4-4bf8-b0b7-bb20d0f92bd0"],
 "."
}], "Notes",ExpressionUUID->"8b99d654-fcdf-411d-9961-626c2e6f3319"],

Cell[TextData[{
 "Option ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dd62fa6-6dd5-42cd-bfda-998988a44fe6"],
 " widens the band of the point form to ",
 StyleBox["d(c, p)", "TI"],
 " \[Minus] ",
 StyleBox["deltaIn", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, p)", "TI"],
 " + ",
 StyleBox["deltaOut", "TI"],
 ". A scalar ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "delta"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05f500f6-a60e-439d-813e-f6da38a74f26"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5e60234-39f9-4870-9f77-9657daeb249a"],
 ", outward only. The default is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4515080-b783-4c96-a8e8-2509d739266b"],
 ". There is no ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c015055-9169-4035-9f17-d0866539a069"],
 " and no ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bedf324-f7b8-4b7d-99fa-a924a40b4442"],
 "."
}], "Notes",ExpressionUUID->"86a2ebad-b088-45ef-ada5-330f54a60b40"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"9816581a-1c2e-47a7-9c03-5467a777c684"],

