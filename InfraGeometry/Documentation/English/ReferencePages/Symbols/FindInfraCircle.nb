Cell["\<\
A circle around the centre of each lattice, at the band each one needs, drawn \
as its directed cycle.\
\>", "ExampleText",ExpressionUUID->"190092ce-bcce-4da1-b819-98bc4b5c1800"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "     ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{
          RowBox[{"First", "[", "spec", "]"}], ",", " ", "\"\<Medium\>\"", ",",
           " ", "\"\<Gray\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "     ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
      "     ", 
      RowBox[{"{", 
       RowBox[{"circle", " ", "=", " ", 
        RowBox[{"FindInfraCircle", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", 
          RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
           RowBox[{"Last", "[", "spec", "]"}]}]}], "]"}]}], "}"}], ",", "\n", 
      "     ", 
      RowBox[{"Labeled", "[", "\n", "       ", 
       RowBox[{
        RowBox[{"InfraHighlightGraph", "[", 
         RowBox[{"g", ",", "\n", "         ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Graph", "[", 
              RowBox[{"DirectedEdge", " ", "@@@", " ", 
               RowBox[{"Partition", "[", 
                RowBox[{
                "circle", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], 
                "]"}]}], "]"}], " ", "->", " ", "$InfraCircleColor"}], ",", 
            " ", 
            RowBox[{
             RowBox[{"{", "c", "}"}], " ", "->", " ", "$InfraPointColor"}]}], 
           "}"}], ",", "\n", "         ", 
          RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "15"}], ",", "\n",
           "         ", 
          RowBox[{"VertexShapeFunction", " ", "->", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
               RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}],
           ",", "\n", "         ", 
          RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
        "       ", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"First", "[", "spec", "]"}], " ", "<>", 
          " ", "\"\<, band \>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"Last", "[", "spec", "]"}], "]"}]}], "]"}]}], "]"}]}], 
     "]"}], ",", "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"spec", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "5"}], "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "6"}], "}"}]}], "}"}]}], "}"}]}], "}"}]}], 
   "]"}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"1efcf29e-54bb-4b7c-ae61-7662275707ae"],

