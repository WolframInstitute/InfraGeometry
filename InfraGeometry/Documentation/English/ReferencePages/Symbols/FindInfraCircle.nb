Cell["\<\
At a single radius the circle exists on the irregular mesh and is empty on \
both lattices \[LongDash] the shell has no two adjacent vertices to make a \
cycle from.\
\>", "ExampleText",ExpressionUUID->"64f916ec-3a9a-46bc-aa4e-13b38c81a605"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"FindInfraCircle", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", 
          RowBox[{"\"\<Radius\>\"", " ", "->", " ", "4"}], ",", " ", "All"}], 
         "]"}]}]}], "]"}]}], ",", "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"43b95f66-0fb5-456b-8fb4-feaeb368d1de"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"SquareMeshGraph\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"SquareTilingGraph\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"HexagonalTilingGraph\"\>", "\[Rule]", "0"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f84e8d8b-fa0f-43a0-bcd7-cd8cab81922c"]
}, Open  ]],

Cell[TextData[{
 "Thickening the radius to a band produces a genuine circle, and the \
thickness needed follows the girth: ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", " ", "5"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8062b522-4cb7-43d2-a9c7-c511135a5913"],
