Cell["\<\
A circle lies in its band, and its last vertex is adjacent to its first.\
\>", "ExampleText",ExpressionUUID->"32332a1c-89df-47e1-830a-75ebe53ca61f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"FindInfraCircle", "[", 
      RowBox[{"g", ",", " ", "41", ",", " ", 
       RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "4"}], "}"}]}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"SubsetQ", "[", 
      RowBox[{
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "41", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", "circle"}], 
      "]"}], ",", " ", 
     RowBox[{"EdgeQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"UndirectedEdge", "[", 
        RowBox[{
         RowBox[{"Last", " ", "@", " ", "circle"}], ",", " ", 
         RowBox[{"First", " ", "@", " ", "circle"}]}], "]"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6981d71f-68d1-4825-849f-335b98cc344e"],

