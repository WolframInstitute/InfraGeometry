Notebook[{

Cell[CellGroupData[{
Cell["FindInfraCircle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6b5a161a-571f-4d25-b9aa-16a82e04dbd8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c16c4dc6-a107-41c9-9838-bb8a80874802"],
 "\[LineSeparator]",
 "gives one circle around ",
 StyleBox["c", "TI"],
 " through the point ",
 StyleBox["p", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ", as a cyclic vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"55f3c9b9-00d4-47b1-b73d-1a7516f7ab5f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
     StyleBox["r", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b712fd42-f188-4498-99c4-8e831b90e742"],
 "\[LineSeparator]",
 "gives one circle around ",
 StyleBox["c", "TI"],
 " at radius ",
 StyleBox["r", "TI"],
 "; ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"r", ",", " ", "s"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9f3c440-0ba1-4713-afc0-067bc79a3613"],
 " takes the band ",
 StyleBox["r", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["s", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a8ff9ee9-8360-4c4f-ac6a-4e95015f1d5c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["spec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66004b33-2e37-4263-a782-64a93e188f7d"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e794004-21b6-40fc-a04f-301353a8b95d"],
 " of exactly ",
 StyleBox["n", "TI"],
 " circles or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45a984cf-fbb9-4e34-ab64-c59717347f54"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61dd8e8d-55d9-4a50-94c7-381c0ba2e18f"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71424eaf-e074-4991-bdb6-45e6ba450e0f"],
 " gives every circle."
}], "Usage",ExpressionUUID->"f3a41893-d8f7-4aef-901c-af139706ff9c"],

Cell[TextData[{
 "The band around ",
 StyleBox["c", "TI"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["v", "TI"], ":", 
     StyleBox["r", "TI"], "\[LessEqual]", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["c", "TI"], ",", 
       StyleBox["v", "TI"]}], ")"}], "\[LessEqual]", 
     StyleBox["s", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "122ece68-2f5b-45c9-9b4c-d07bcbe3d625"],
 ". A circle is a shortest cycle of the subgraph induced on the band whose \
removal leaves ",
 StyleBox["c", "TI"],
 " in a component reaching no further than the band. The point form takes the \
band at ",
 StyleBox["d(c, p)", "TI"],
 " and keeps the circles through ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"f6b94086-ad43-48a8-a6e3-638c72eab213"],

Cell["\<\
A circle is returned as a cyclic vertex list: the edge from the last vertex \
back to the first is implicit, and the first vertex is not repeated.\
\>", "Notes",ExpressionUUID->"2ec5dbaf-69cf-437b-9be9-becf132cdbbe"],

Cell[TextData[{
 StyleBox["A circle need not exist.",
  FontWeight->"Bold"],
 " On a lattice a single distance shell contains no two adjacent vertices, so \
it spans no cycle at all and the result is empty. This is not a defect of the \
definition \[LongDash] it is what a sphere of one-vertex thickness is on a \
lattice."
}], "Notes",ExpressionUUID->"7252dec2-1d50-4496-ad17-62c860e34e28"],

Cell[TextData[{
 "Thickening the radius to a band fixes it, and ",
 StyleBox["the band thickness that suffices tracks the girth of the tiling",
  FontWeight->"Bold"],
 ". On the square grid, girth 4, a two-thick band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", 
    RowBox[{"r", "+", "1"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88fddc8b-0b9d-464a-8ed4-89f190251f2a"],
 " already carries a cycle. On the hexagonal tiling, girth 6, it does not: ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", 
    RowBox[{"r", "+", "1"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2da45453-5da1-44bf-90a7-286e3b533d5c"],
 " is still empty and the band has to reach ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", 
    RowBox[{"r", "+", "2"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e31010c3-62bb-4bf3-b1cb-98db96c1b0b2"],
 ". On an irregular mesh a single shell usually works, since its vertices are \
adjacent by accident of the triangulation."
}], "Notes",ExpressionUUID->"caa2f182-d645-47db-9dd8-f9376e448ce2"],

Cell[TextData[{
 "The search sweeps the band directly, length by length with ",
 Cell[BoxData["FindCycle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00e02914-8cae-41eb-b298-a935b5ecd73e"],
 ". It does not read the necklaces of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1989b8e-ce4a-447b-b476-1d68931a903d"],
 ", so it is the check on them, and it still answers where no seam cuts the \
band open, or where nothing lies beyond the band and separation is vacuous. \
It returns exactly the shapes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraVertexList", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "87b86e51-3978-46f6-b1f4-3ac1603c005e"],
 " gives for that head. To count circles without enumerating them, use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c0451b50-4a8f-4f83-ac4f-9567e8021cd4"],
 "."
}], "Notes",ExpressionUUID->"bfd15a0f-ee13-4edf-8892-d5629945816e"],

Cell[TextData[{
 "Option ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8cf25fa-9117-42cb-b1d9-5c91be7c2f3e"],
 " widens the band of the point form to ",
 StyleBox["d(c, p)", "TI"],
 " \[Minus] ",
 StyleBox["deltaIn", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, v)", "TI"],
 " \[LessEqual] ",
 StyleBox["d(c, p)", "TI"],
 " + ",
 StyleBox["deltaOut", "TI"],
 ". A scalar ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "delta"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ebefd9a-d049-455c-90ad-3a7ac5eb0498"],
 " means ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "delta"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22a9e041-4c9b-4098-8867-927333ae0e54"],
 ", outward only. The default is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6fe0bcb-8880-40a0-bacc-fa9b75d4b33b"],
 ". There is no ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99896cbd-09db-4fdd-b778-ad34d0a96183"],
 " and no ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75d3d7e9-89bc-418c-bf4e-78d4f2cfffe6"],
 "."
}], "Notes",ExpressionUUID->"d75d9874-55ac-4685-bcb9-cabc6945f07c"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"843b7a05-4b9f-41f2-85d2-0b69510eff8c"],

