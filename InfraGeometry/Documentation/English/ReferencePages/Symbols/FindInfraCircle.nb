Cell[TextData[{
 "Sixteen circles lie in the band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "4"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "907425f3-dd00-4288-8478-5a0c649be77e"],
 " around the centre of a 9 \[Times] 9 grid. A bounded count gives a list, \
and a strict count that cannot be met is ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fbe3f62-56a6-433a-bda5-1e877c993bdf"],
 "."
}], "ExampleText",ExpressionUUID->"6ec198f0-8c5b-40b9-a13c-68bb82cd5125"],

