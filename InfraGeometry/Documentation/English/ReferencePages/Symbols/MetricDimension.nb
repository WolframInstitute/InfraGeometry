Cell[CellGroupData[{
Cell["MetricDimension", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"98def86f-14e6-4ead-888e-7ffe6dedb3a4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MetricDimension"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/MetricDimension", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f8b73bd-da2c-4f19-b49e-cad2e036fd3c"],
 "\[LineSeparator]",
 "gives the metric dimension of ",
 StyleBox["g", "TI"],
 ": the least number of vertices whose distances determine every vertex.",
 "\n"
}], "Usage",ExpressionUUID->"4c694541-68f2-4d75-8f42-e77f559ac64a"],

Cell[TextData[{
 "Definition: the metric dimension of ",
 StyleBox["g", "TI"],
 " is the least size of a resolving set, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ResolvingSetQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ResolvingSetQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "73ac80bf-bb9a-49b6-88d1-097297f4d513"],
 ": the length of a metric basis, ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Length",
    BaseStyle->"Link"], "[", 
   RowBox[{
    ButtonBox["First",
     BaseStyle->"Link"], "[", 
    RowBox[{"FindResolvingSet", "[", 
     StyleBox["g", "TI"], "]"}], "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c09dcd96-dfef-41d3-8b36-c5f7930c6651"],
 ". A metric basis of ",
 StyleBox["k", "TI"],
 " vertices gives every vertex its own point of \:2124\:1d4f, its ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RadarCoordinates"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RadarCoordinates", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9409293d-6c03-491c-b3c5-cb44b62b0312"],
 "."
}], "Notes",ExpressionUUID->"8e7aa3e9-a05d-4667-99ea-d009a3bab456"],

Cell[TextData[{
 "The metric dimension is 0 on the graph of one vertex, whose empty set \
resolves it, 1 exactly on paths, 2 on cycles and on grids, and ",
 StyleBox["n", "TI"],
 " \[Minus] 1 on the complete graph with ",
 StyleBox["n", "TI"],
 " vertices. On a tree that is not a path, a branch vertex, of degree 3 or \
more, with ",
 StyleBox["k", "TI"],
 " legs ending in leaves needs a station on ",
 StyleBox["k", "TI"],
 " \[Minus] 1 of them, and these suffice (Slater; Harary and Melter)."
}], "Notes",ExpressionUUID->"35dcd1d3-9b28-4eb2-8bf1-dfb3ebead045"],

Cell[TextData[{
 "The value comes from the exhaustive search of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindResolvingSet"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindResolvingSet", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c05eceac-e66c-47f5-a478-68dcc0f055ec"],
 ", which is slow when the metric dimension is large."
}], "Notes",ExpressionUUID->"308b9c3f-255f-4345-9671-fd2a794ae631"]
}, Open  ]],

