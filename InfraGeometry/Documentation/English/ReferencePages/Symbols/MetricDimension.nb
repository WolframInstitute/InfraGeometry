Cell[TextData[{
 "The one-vertex graph has metric dimension 0: the empty set resolves it, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ResolvingSetQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ResolvingSetQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "44962364-d845-4286-bd7f-31b60c860874"],
 " says, and the first set ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindResolvingSet"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindResolvingSet", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ad8a0cfd-c298-4321-aae9-f0d0ef3f4add"],
 " returns is empty. The graph of two vertices has 1."
}], "ExampleText",ExpressionUUID->"29228e92-c036-4a09-b0bd-5e3708da3dc6"],

