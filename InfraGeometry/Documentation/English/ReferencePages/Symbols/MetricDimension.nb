     RowBox[{"KaryTree", "[", "15", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindResolvingSet", "[", "g", "]"}]}], "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"MetricDimension", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0ce21398-bd22-4839-98f3-8b53d0320f4b"],

