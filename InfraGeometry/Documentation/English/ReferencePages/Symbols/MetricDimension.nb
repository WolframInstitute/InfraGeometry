        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"{", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"FindResolvingSet", "[", "#", "]"}]}], "}"}]}], "]"}], 
        " ", "&"}], " ", "/@", " ", "graphs"}], "]"}], ",", " ", 
     RowBox[{"MetricDimension", " ", "/@", " ", "graphs"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"38b734ef-ea43-4f33-a194-e05e7f483a11"],

