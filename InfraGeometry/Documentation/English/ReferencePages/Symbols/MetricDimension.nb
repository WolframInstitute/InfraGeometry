Cell["\<\
The square grid has metric dimension 4, not 2: its rim vertices are leaves, \
and the two leaves at each corner are twins. One leaf of each pair resolves \
the graph:\
\>", "ExampleText",ExpressionUUID->"09a81216-3456-48a3-bd6f-2d540b56387c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"leaves", " ", "=", " ", 
     RowBox[{"Pick", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"VertexDegree", "[", "g", "]"}], ",", " ", "1"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"twins", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Subsets", "[", 
        RowBox[{"leaves", ",", " ", 
         RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
       RowBox[{"pair", " ", "|->", " ", 
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"Complement", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "pair"}], "]"}], 
          ",", "\n", "    ", 
          RowBox[{"w", " ", "|->", " ", 
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"pair", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", " ", "w"}], "]"}], " ", "==",
             " ", 
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"pair", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", " ", "w"}], "]"}]}]}]}], 
         "]"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Catenate", "[", "twins", "]"}], ",", " ", 
       RowBox[{"First", " ", "/@", " ", "twins"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"ResolvingSetQ", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"First", " ", "/@", " ", "twins"}]}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0425ba28-cee5-41c6-aa84-896a95c761f2"],

