Cell["\<\
The Petersen graph has metric dimension 3, and no two of its vertices resolve \
it:\
\>", "ExampleText",ExpressionUUID->"42be903d-37e4-4bc0-bd50-c2633d5879ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"PetersenGraph", "[", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MetricDimension", "[", "g", "]"}], ",", " ", 
     RowBox[{"FindResolvingSet", "[", 
      RowBox[{"g", ",", " ", "1", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Subsets", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"ResolvingSetQ", "[", 
         RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1270e292-835c-4d56-924c-d949299dce36"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"abe3cc29-ab96-477c-a8ef-24471981537f"]
}, Open  ]],

Cell["\<\
The one-vertex graph has metric dimension 0: the empty set resolves it.\
\>", "ExampleText",ExpressionUUID->"f1b1ba93-1f8a-496e-9eb5-bc775617d113"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", " ", 
       RowBox[{"{", "}"}]}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MetricDimension", "[", "g", "]"}], ",", " ", 
     RowBox[{"ResolvingSetQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2cfce9c5-bc87-4e51-9806-8b7df1cfaa47"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"52df22a9-72e4-45f2-8704-a90ff18f4ae7"]
}, Open  ]]
}, Open  ]],

