Cell[TextData[{
 "On a tree that is not a path, a vertex of degree at least 3 with ",
 StyleBox["k", "TI"],
 " legs ending in leaves needs a vertex on ",
 StyleBox["k \[Minus] 1", "TI"],
 " of them, and these suffice (Slater; Harary and Melter)."
}], "Notes",ExpressionUUID->"d557eacc-d30a-423d-ae7b-8c86ffbdeb7a"],

Cell["\<\
Two vertices at the same distance from every other vertex are twins. A \
resolving set contains one of every two twins.\
\>", "Notes",ExpressionUUID->"6ab41793-e707-4b1c-b91c-fd79709ac3f6"],

Cell["\<\
The value comes from an exhaustive search over the vertex sets of increasing \
size, which is slow when the metric dimension is large.\
\>", "Notes",ExpressionUUID->"e6504784-a664-4341-a720-fbded5929436"]
}, Open  ]],

