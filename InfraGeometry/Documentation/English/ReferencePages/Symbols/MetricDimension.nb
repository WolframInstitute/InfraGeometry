Cell["MetricDimension", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"98a01417-cb3c-4bc5-b00f-28160b715361"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MetricDimension"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/MetricDimension", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a777ba1c-4c80-48b5-b6ea-2ca0d0154488"],
 "\[LineSeparator]",
 "gives the metric dimension of ",
 StyleBox["g", "TI"],
 ": the least number of vertices whose distances determine every vertex.",
 "\n"
}], "Usage",ExpressionUUID->"0145f837-dc20-469d-b0e5-7caf1ad4ce92"],

Cell[TextData[{
 "The metric dimension is ",
 StyleBox["dim(g) = min |B|", "TI"],
 " over the resolving sets ",
 StyleBox["B", "TI"],
 " of ",
 StyleBox["g", "TI"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ResolvingSetQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ResolvingSetQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "484696df-78b0-438a-b975-15e73d603f11"],
 ". A smallest resolving set is a metric basis, found by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindResolvingSet"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindResolvingSet", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b6e432e9-33aa-46e9-8ff2-5c60292d566b"],
 ". A basis of ",
 StyleBox["k", "TI"],
 " vertices gives every vertex its own point of ",
 StyleBox["\:2124\:1d4f", "TI"],
 ", its ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RadarCoordinates"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RadarCoordinates", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "638642a0-d542-4266-9b03-2953411aeab6"],
 "."
}], "Notes",ExpressionUUID->"0d461c39-ed32-4f65-b8f1-25a8d17af43c"],

