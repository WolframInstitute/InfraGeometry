Cell[TextData[{
 "The metric dimension against the number of vertices: 1 on paths, 2 on \
cycles, ",
 StyleBox["n", "TI"],
 " \[Minus] 1 on the complete graphs, and 1, 2, 3, 4, 4 on the hypercubes of \
dimension 1 to 5."
}], "ExampleText",ExpressionUUID->"29667305-671f-4017-859a-a8a6355691d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", " ", 
         RowBox[{"MetricDimension", "[", 
          RowBox[{"PathGraph", "[", 
           RowBox[{"Range", "[", "n", "]"}], "]"}], "]"}]}], "}"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "2", ",", " ", "32"}], "}"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", " ", 
         RowBox[{"MetricDimension", "[", 
          RowBox[{"CycleGraph", "[", "n", "]"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "3", ",", " ", "32"}], "}"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", " ", 
         RowBox[{"MetricDimension", "[", 
          RowBox[{"CompleteGraph", "[", "n", "]"}], "]"}]}], "}"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "2", ",", " ", "12"}], "}"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", "^", "d"}], ",", " ", 
         RowBox[{"MetricDimension", "[", 
          RowBox[{"HypercubeGraph", "[", "d", "]"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"d", ",", " ", "1", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<path\>\"", ",", " ", "\"\<cycle\>\"", ",", 
      " ", "\"\<complete graph\>\"", ",", " ", "\"\<hypercube\>\""}], "}"}]}],
    ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<vertices\>\"", ",", " ", "\"\<metric dimension\>\""}], 
     "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"503a61b3-5ac3-4dcf-a0c9-f51c0be440c1"],

