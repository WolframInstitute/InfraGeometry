Cell[TextData[{
 "The metric dimension is the size of the first set ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindResolvingSet"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindResolvingSet", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e314802d-890d-40b7-a39d-c876218c8207"],
 " returns, and no smaller set resolves: the Petersen graph has metric \
dimension 3, and no two of its vertices resolve it."
}], "ExampleText",ExpressionUUID->"1ef4a2ee-f444-4ac2-a329-5530af35a4df"],

