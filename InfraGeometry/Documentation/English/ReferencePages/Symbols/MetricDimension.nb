Cell["\<\
A metric basis of the 8 \[Times] 8 grid graph, two corners of one side, and \
of the square mesh:\
\>", "ExampleText",ExpressionUUID->"aff56485-de77-444b-b146-474ecaf45f2a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"InfraSubstrateHighlight", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"{", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"FindResolvingSet", "[", "g", "]"}]}], "}"}], ",", " ", 
      RowBox[{"PlotLabel", " ", "->", " ", 
       RowBox[{"MetricDimension", "[", "g", "]"}]}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"g", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GridGraph", "[", 
         RowBox[{"{", 
          RowBox[{"8", ",", " ", "8"}], "}"}], "]"}], ",", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
          " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"bacfad5f-c015-43fa-9c0a-9b46a8a0623b"],

