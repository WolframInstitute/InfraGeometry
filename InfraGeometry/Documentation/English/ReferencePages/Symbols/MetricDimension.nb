Cell[TextData[{
 "The metric dimension against the number of vertices: 1 on paths, 2 on \
cycles, ",
 StyleBox["n \[Minus] 1", "TI"],
 " on complete graphs, and 1, 2, 3, 4, 4 on the hypercubes:"
}], "ExampleText",ExpressionUUID->"e5d0f575-339d-497b-95bf-197387f44314"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", " ", 
         RowBox[{"MetricDimension", "[", 
          RowBox[{"PathGraph", "[", 
           RowBox[{"Range", "[", "n", "]"}], "]"}], "]"}]}], "}"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "2", ",", " ", "32"}], "}"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", " ", 
         RowBox[{"MetricDimension", "[", 
          RowBox[{"CycleGraph", "[", "n", "]"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "3", ",", " ", "32"}], "}"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", " ", 
         RowBox[{"MetricDimension", "[", 
          RowBox[{"CompleteGraph", "[", "n", "]"}], "]"}]}], "}"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "2", ",", " ", "12"}], "}"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", "^", "d"}], ",", " ", 
         RowBox[{"MetricDimension", "[", 
          RowBox[{"HypercubeGraph", "[", "d", "]"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"d", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<path\>\"", ",", " ", "\"\<cycle\>\"", ",", 
      " ", "\"\<complete graph\>\"", ",", " ", "\"\<hypercube\>\""}], 
     "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d9df89d1-e43b-410a-b61f-020bf66549e0"],

