Cell["\<\
A member of a circle is a circle of the sweep, as a cyclic vertex list: the \
closing edge is implicit, and drawn as a walk it is added back.\
\>", "ExampleText",ExpressionUUID->"2f99a20e-cb81-4192-a474-02602c730d25"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"closedWalk", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraWalk", "[", 
          RowBox[{"Append", "[", 
           RowBox[{"closedWalk", ",", " ", 
            RowBox[{"First", " ", "@", " ", "closedWalk"}]}], "]"}], "]"}], ",",
          " ", "c"}], "}"}]}], "]"}], ",", " ", "closedWalk"}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"bd22e080-f360-4a4e-b39f-10ad3fed1de5"],

