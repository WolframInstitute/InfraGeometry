Notebook[{

Cell[CellGroupData[{
Cell["FindInfraRepresentative", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ca2ad434-1d4e-476c-814c-424068be96cc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbd3a002-905c-4132-9218-3e0f8f8431e8"],
 "\[LineSeparator]",
 "gives one member of the inert ",
 StyleBox["head", "TI"],
 " as a vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4ea9ed0b-f0e2-49c8-b6b2-beffeebed439"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"], ",", " ", 
    RowBox[{
     StyleBox["n", "TI"], " ", "|", " ", 
     RowBox[{
      ButtonBox["UpTo",
       BaseStyle->"Link"], "[", 
      StyleBox["n", "TI"], "]"}], " ", "|", " ", 
     ButtonBox["All",
      BaseStyle->"Link"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba18d6fe-f3c9-4433-9914-bf15c48d9f84"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b57302c-8db9-4d5e-a3b4-d435648fc487"],
 " of ",
 StyleBox["n", "TI"],
 ", at most ",
 StyleBox["n", "TI"],
 ", or every member."
}], "Usage",ExpressionUUID->"b7b07e65-be1c-44cd-b79a-c82a4ff050b5"],

Cell["\<\
The head names the notion; this function finds its members. Where the head \
has a faithful graph theorem, a member is read off it; otherwise the head's \
own search runs at its defaults.\
\>", "Notes",ExpressionUUID->"18db4af3-7467-443a-b4f6-c51f2cfa8c4d"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10fdf5d2-cd9b-472f-b45b-4c4ca495cc10"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraRay", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e07211d-c49b-428a-8c3b-49548cd1fdf0"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraLine", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea0a34c4-78fb-4107-8f85-a179d686999c"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraLine", "[", "germ", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebe1394f-a90a-45cf-9fb0-fc2d1dac7328"],
 " and ",
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "q"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ce165c7-69b3-453f-baf1-e2543b2f0ca7"],
 ": a member is a source-to-sink chain of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bf3cf85-3acb-4ca2-8151-9201a2fb7d83"],
 ", read off in lexicographic order. A polyline ",
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   RowBox[{"p1", ",", " ", "...", ",", " ", "pk"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fa560de-ba0c-4908-a635-10226ec65914"],
 " and a multi-point arc concatenate the members of their pieces."
}], "Notes",ExpressionUUID->"62a5b541-26f8-4281-a0de-f87114d8f99b"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraCircle", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"r", " ", "|", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "s"}], "}"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4aa442b0-dc61-442c-81cb-9d9bcc948e37"],
 ": a member is a circle found by sweeping the band, length by length with ",
 Cell[BoxData["FindCycle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d520281-e1f4-4377-a834-d89ae156a77c"],
 " (see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "17cdc268-8b39-4505-a32e-c607309d5ec4"],
 "), as a cyclic vertex list whose first vertex is not repeated. The atoms \
stay what ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef5b7e3e-194d-4a7d-9c45-22619957d09d"],
 " measures; the sweep is the check on them."
}], "Notes",ExpressionUUID->"acbc563c-1c22-4113-accf-8998d3f1ea6f"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "p"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2753cb4b-5296-4bfe-b804-ac569114b20b"],
 ", the closed arc: the same sweep, not the atom of its graph, keeping the \
circles through ",
 StyleBox["p", "TI"],
 ", and through every point of ",
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "q", ",", " ", "...", ",", " ", "p"}], "}"}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6fdae57-8682-47b3-9a27-11830a549a24"],
 " (see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f61f7123-73e2-46ae-b88c-af66df8f6ddc"],
 ")."
}], "Notes",ExpressionUUID->"4a2f45d8-2835-4e2e-b3af-2ff90e489675"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraGeodesic", "[", 
   RowBox[{"germ", ",", " ", "s"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97efe0ec-135a-432e-a0a8-a1ad2a7dd5a5"],
 ", the geodesics at infra-scale ",
 StyleBox["s", "TI"],
 " through the germ: a member is an inextensible simple geodesic, the result \
of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d4ee72e1-988e-401d-a06c-1305b421c9bc"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{
   "g", ",", " ", "germ", ",", " ", "s", ",", " ", "Infinity", ",", " ", "n", 
    ",", " ", 
    RowBox[{"Properties", " ", "->", " ", 
     RowBox[{"{", "\"\<Simple\>\"", "}"}]}], ",", " ", 
    RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<BothSides\>\""}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a84fd29-4096-4134-b1d2-7c1182fc8bac"],
 ". The germ is a vertex list; a one-vertex list is grown on both sides, so \
it gives every geodesic through the vertex."
}], "Notes",ExpressionUUID->"0734aca1-7f08-4f95-b256-b6f19e13034c"],

Cell[TextData[{
 "The scene tokens ",
 Cell[BoxData["InfraShell"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d0e5489-4f1f-469a-af1f-f5b68f2439be"],
 ", ",
 Cell[BoxData["InfraBall"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "210ff1ec-f11f-460c-9335-d9e99341baaa"],
 ", ",
 Cell[BoxData["InfraPlane"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "153afc73-d31c-40e5-a0a3-729749aa7235"],
 ", ",
 Cell[BoxData["InfraPolygon"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65c6c36d-7339-4d23-9c70-4ec569931d1a"],
 ", ",
 Cell[BoxData["InfraTriangle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1aaa05b0-7940-45c6-8427-dfc58434228f"],
 ", ",
 Cell[BoxData["InfraPolyline"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d30b6f6-c2e1-441f-a534-05ffd1134b91"],
 ", ",
 Cell[BoxData["InfraRevolution"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebd6b5db-19ee-41fc-9e02-d5d0f32f593b"],
 ", ",
 Cell[BoxData["InfraWalk"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "743b5f55-86ab-48df-b6ad-336f591158e2"],
 " and ",
 Cell[BoxData["InfraPoint"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db9fa2d5-e321-4873-89aa-4051f44a5a32"],
 ": a member is a result of the token's search at its defaults. A set head \
such as ",
 Cell[BoxData[
  RowBox[{"InfraBall", "[", 
   RowBox[{"c", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4051ef6c-09f1-4a77-90df-47451c710227"],
 " has one member, its sorted vertex list."
}], "Notes",ExpressionUUID->"46191d5d-dc98-4935-aec0-c51d9d512cbb"],

Cell[TextData[{
 "The walk searches (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "30559fea-d73d-49bc-8ad0-ab971f78f21f"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "528bcc0e-3c74-4a37-9cf6-61fde6cdd6b6"],
 ") take a germ, a budget and options of their own; the head ",
 Cell[BoxData["InfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "770d3c55-79c1-4f6d-906a-a2b81bfccb02"],
 " fixes them to the inextensible simple class."
}], "Notes",ExpressionUUID->"ba9cc1b4-c164-450b-9e4e-5cdbc3aea749"],

Cell[TextData[{
 "A closed count under a non-negative integer ",
 StyleBox["n", "TI"],
 " that exceeds the number of members gives ",
 Cell[BoxData[
  RowBox[{"{", " ", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eeaa592b-e66d-4513-9b55-5336c8938676"],
 "."
}], "Notes",ExpressionUUID->"c6d2ded6-203a-42dd-b40f-a508db6b51df"],

Cell["Two modifiers, given after the count:", "Notes",ExpressionUUID->"fffba14f-0ccb-4619-8c07-21dec9b04799"],

Cell[TextData[{
 Cell[BoxData["\"\<RandomChoice\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ebb952c-9271-4335-821a-8e238c89625d"],
 " gives random members. On a graph it walks the chains choosing the next \
arrow ",
 StyleBox["v", "TI"],
 " -> ",
 StyleBox["w", "TI"],
 " with probability proportional to the backward count at ",
 StyleBox["w", "TI"],
 ", so every member is drawn with probability ",
 Cell[BoxData[
  RowBox[{"1", " ", "/", " ", "Cardinality"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58652806-89af-4c20-a7b8-b33297baa9bf"],
 "; on a search it is ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "RandomSample"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11500d3d-5243-4422-a5c1-a172186ce905"],
 "; otherwise it draws from the search's members. ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb40e946-a967-42ab-9f31-e5aca29eec6b"],
 " in front reproduces the draw."
}], "Notes",ExpressionUUID->"3842a1ef-9612-4edc-b2e3-d86b676207cb"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5da26422-96ef-4be9-b41b-907f8e051ac3"],
 ", under ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "638755f0-581b-40ff-b910-7e4a0066d530"],
 ", discards a random fraction ",
 StyleBox["q", "TI"],
 " of the candidates at each step of an otherwise exhaustive enumeration; on \
a search it is the next-vertex function ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"RandomSample", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"UpTo", "[", "q", "]"}]}], "]"}], " ", "&"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e2d588a-d56e-4e95-a5ab-4dbfc85f19e2"],
 " for an integer ",
 StyleBox["q", "TI"],
 ", keeping a fraction ",
 StyleBox["q", "TI"],
 " of the candidates per node for ",
 StyleBox["q", "TI"],
 " < 1."
}], "Notes",ExpressionUUID->"2b26b01a-5417-49cd-841f-6b2567864d6c"],

Cell[TextData[{
 "The specialised searches (",
 Cell[BoxData["FindInfraSegment"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d539f71-e9a6-4a44-a9fc-0c1bdcb42b2e"],
 ", ",
 Cell[BoxData["FindInfraSphere"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ec5727d-abb6-4f24-96e7-795197523cc2"],
 ", ",
 Cell[BoxData["FindInfraShell"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb107f28-23ad-4ebe-ae64-12793215014d"],
 ", ",
 Cell[BoxData["FindInfraWalk"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "603ce4fc-0536-4a85-80e2-91b2ce31f370"],
 ", ",
 Cell[BoxData["FindInfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2c82bbc-8af4-491a-9d33-47217eb83a1a"],
 ", \[Ellipsis]) keep their own parameters; this function takes none of \
them."
}], "Notes",ExpressionUUID->"7c659312-19ff-44d3-8cfe-d8b736d1b59c"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"FindInfraRepresentative", "[", 
   RowBox[{"graph", ",", " ", "head"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "372978b2-b996-484c-87c2-03e6b5c31e0c"],
 " (no count) is the same as ",
 Cell[BoxData[
  RowBox[{"FindInfraRepresentative", "[", 
   RowBox[{"graph", ",", " ", "head", ",", " ", "Automatic"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7ddbf56-9fd6-42a2-aed1-cbeadf47962c"],
 ", the first member in canonical order."
}], "Notes",ExpressionUUID->"abd80235-18ad-40af-98c5-c83e9381efc8"]
}, Open  ]],

