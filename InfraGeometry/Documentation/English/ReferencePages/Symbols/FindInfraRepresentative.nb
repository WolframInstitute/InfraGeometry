Notebook[{

Cell[CellGroupData[{
Cell["FindInfraRepresentative", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3bf10e52-91f8-4b62-a942-da46da937c6a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fd205e8-c0f3-4581-9a62-292e6d7b5c5f"],
 "\[LineSeparator]",
 "gives one member of the inert ",
 StyleBox["head", "TI"],
 " as a vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3c785e28-9fb9-497e-8d7c-6c1f401ba5d9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"], ",", " ", 
    RowBox[{
     StyleBox["n", "TI"], " ", "|", " ", 
     RowBox[{
      ButtonBox["UpTo",
       BaseStyle->"Link"], "[", 
      StyleBox["n", "TI"], "]"}], " ", "|", " ", 
     ButtonBox["All",
      BaseStyle->"Link"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82916897-a80e-4c7d-9b51-fab8ecf2348d"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9a61b9f-929b-4cfb-aedb-3dcb9ced5e23"],
 " of ",
 StyleBox["n", "TI"],
 ", at most ",
 StyleBox["n", "TI"],
 ", or every member."
}], "Usage",ExpressionUUID->"387501c5-536e-4648-8a74-6983b01a4569"],

Cell["\<\
The head names the notion; this function finds its members. Where the head \
has a faithful graph theorem, a member is read off it; otherwise the head's \
own search runs at its defaults.\
\>", "Notes",ExpressionUUID->"803ae831-10a6-42c1-8566-c5c62d859a6a"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "877071c8-7cdc-44e1-83e0-fce8ab69e410"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraRay", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a06bd0c-7eb0-4dbe-9d96-a256efd37449"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraLine", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "796bde77-59aa-438c-bcba-ce3a5f0b6cc5"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraLine", "[", "germ", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09b440d0-e3a4-464b-be42-099c22a93f8c"],
 " and ",
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "q"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e819da4-2aa5-45f4-aadf-5f605a8e1b1a"],
 ": a member is a source-to-sink chain of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9509cfe-ed16-4464-93a8-74a5fdbbc0b9"],
 ", read off in lexicographic order. A polyline ",
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   RowBox[{"p1", ",", " ", "...", ",", " ", "pk"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07174e47-1879-4df2-ab20-f54eff2a1fc1"],
 " and a multi-point arc concatenate the members of their pieces."
}], "Notes",ExpressionUUID->"c0e23d3b-28ba-4757-ac3c-c38209479920"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraCircle", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"r", " ", "|", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "s"}], "}"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9613c57d-1b45-4422-9515-bd3818c8ead0"],
 ": a member is a circle found by sweeping the band, length by length with ",
 Cell[BoxData["FindCycle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3168fa69-cc94-4037-9b55-11ba8233caee"],
 " (see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d644054f-0367-48e4-9fa8-4efaa97a778c"],
 "), as a cyclic vertex list whose first vertex is not repeated. The atoms \
stay what ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8980fbe5-2652-4806-ad2f-7c519fd711b9"],
 " measures; the sweep is the check on them."
}], "Notes",ExpressionUUID->"3e520f3c-2737-4ec8-a8ba-33ac28c434cf"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "p"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2417bbc3-a362-4138-b416-e90567d41ab2"],
 ", the closed arc: the same sweep, not the atom of its graph, keeping the \
circles through ",
 StyleBox["p", "TI"],
 ", and through every point of ",
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "q", ",", " ", "...", ",", " ", "p"}], "}"}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15bd4ba4-9b0f-420f-a394-9da6df914b7f"],
 " (see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "08d85f67-049f-4487-98e6-94a7e8bc591a"],
 ")."
}], "Notes",ExpressionUUID->"404c824a-2266-495b-b9e4-75d72d42803f"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraGeodesic", "[", 
   RowBox[{"germ", ",", " ", "s"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40cae7c7-0839-421a-b33c-0f75b919f573"],
 ", the geodesics at infra-scale ",
 StyleBox["s", "TI"],
 " through the germ: a member is an inextensible simple geodesic, the result \
of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "79acd288-dcf8-4612-9cd6-9013ec608c3c"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{
   "g", ",", " ", "germ", ",", " ", "s", ",", " ", "Infinity", ",", " ", "n", 
    ",", " ", 
    RowBox[{"Properties", " ", "->", " ", 
     RowBox[{"{", "\"\<Simple\>\"", "}"}]}], ",", " ", 
    RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<BothSides\>\""}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "781e112c-98d0-4849-8200-5ffed6973255"],
 ". The germ is a vertex list; a one-vertex list is grown on both sides, so \
it gives every geodesic through the vertex."
}], "Notes",ExpressionUUID->"ab5ff9fc-c9e5-4f66-a949-23ea707f5987"],

Cell[TextData[{
 "The scene tokens ",
 Cell[BoxData["InfraShell"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f026bfc0-136b-4c46-a42c-d234f7260f22"],
 ", ",
 Cell[BoxData["InfraBall"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02fd9e47-f901-4793-814f-45d588d8858d"],
 ", ",
 Cell[BoxData["InfraPlane"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39a54798-b127-4c7d-b668-9be3b5286a76"],
 ", ",
 Cell[BoxData["InfraPolygon"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ba80ba6-aec6-40d5-bcc1-108a1d122bda"],
 ", ",
 Cell[BoxData["InfraWalk"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "873305c2-4fc1-4d0e-9aa1-1eead64e94b9"],
 " and ",
 Cell[BoxData["InfraPoint"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3b6ac27-3950-48ae-94c6-651fae1dc70e"],
 ": a member is a result of the token's search at its defaults. A set head \
such as ",
 Cell[BoxData[
  RowBox[{"InfraBall", "[", 
   RowBox[{"c", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c9407c1-459b-4781-ae2b-0e0b8e26f603"],
 " has one member, its sorted vertex list."
}], "Notes",ExpressionUUID->"8b4e823c-9102-463d-be0d-15188b2b645f"],

Cell[TextData[{
 "The walk searches (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "61ac3b79-a581-4d32-ab63-2ae0d64836b2"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a5479baf-7463-4f54-997b-20c3a73f62d8"],
 ") take a germ, a budget and options of their own; the head ",
 Cell[BoxData["InfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "deac4c4c-40fb-4c57-b108-762c2e822a34"],
 " fixes them to the inextensible simple class."
}], "Notes",ExpressionUUID->"51916ac6-456e-4dd0-8b24-2cdf28a495d3"],

Cell[TextData[{
 "A closed count under a non-negative integer ",
 StyleBox["n", "TI"],
 " that exceeds the number of members gives ",
 Cell[BoxData[
  RowBox[{"{", " ", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9721cc5c-adfd-4e53-ad26-9aca0a1c756d"],
 "."
}], "Notes",ExpressionUUID->"520b9ba7-d62f-4321-a6b7-96844c498b68"],

Cell["Two modifiers, given after the count:", "Notes",ExpressionUUID->"de746a0d-9f81-455a-8cf5-489095044ad4"],

Cell[TextData[{
 Cell[BoxData["\"\<RandomChoice\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7ff89ea-9683-427c-8932-e62b5bed9020"],
 " gives random members. On a graph it walks the chains choosing the next \
arrow ",
 StyleBox["v", "TI"],
 " -> ",
 StyleBox["w", "TI"],
 " with probability proportional to the backward count at ",
 StyleBox["w", "TI"],
 ", so every member is drawn with probability ",
 Cell[BoxData[
  RowBox[{"1", " ", "/", " ", "Cardinality"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f90d7573-3ac0-46ca-83c8-be6fa02d2d26"],
 "; on a search it is ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "RandomSample"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dfc0acc-427f-4ae0-a06c-76665bf18a8c"],
 "; otherwise it draws from the search's members. ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb90780a-e99e-42bb-ad13-c967a73e15e7"],
 " in front reproduces the draw."
}], "Notes",ExpressionUUID->"fd36e849-dbf1-42a3-80f8-19eea067134f"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb7ba020-90ef-4ca3-8cbb-bc14decd1f2d"],
 ", under ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0834eca-8d79-45d4-8f81-c86cb9d708e8"],
 ", discards a random fraction ",
 StyleBox["q", "TI"],
 " of the candidates at each step of an otherwise exhaustive enumeration; on \
a search it is the next-vertex function ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"RandomSample", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"UpTo", "[", "q", "]"}]}], "]"}], " ", "&"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a36d75c-9245-41f7-9a5f-124dce70c2b2"],
 " for an integer ",
 StyleBox["q", "TI"],
 ", keeping a fraction ",
 StyleBox["q", "TI"],
 " of the candidates per node for ",
 StyleBox["q", "TI"],
 " < 1."
}], "Notes",ExpressionUUID->"34b62b67-345c-4302-adb7-b8cc869f802c"],

Cell[TextData[{
 "The specialised searches (",
 Cell[BoxData["FindInfraSegment"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ea4882b-7396-4a32-a2c3-d65763f1cbe1"],
 ", ",
 Cell[BoxData["FindInfraSphere"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "399b47e8-9ffa-45e3-9200-b5adf6f5c9b2"],
 ", ",
 Cell[BoxData["FindInfraShell"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e88b1b63-07e2-49ca-8f6d-9a7317de65fb"],
 ", ",
 Cell[BoxData["FindInfraWalk"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab32a28e-f87b-46f6-b2e6-b89bb8e1b9c2"],
 ", ",
 Cell[BoxData["FindInfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c43b089-f901-4948-b564-8e6995568d96"],
 ", \[Ellipsis]) keep their own parameters; this function takes none of \
them."
}], "Notes",ExpressionUUID->"b9fb824e-e5b0-4dbb-9215-1eaddb0026f1"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"FindInfraRepresentative", "[", 
   RowBox[{"graph", ",", " ", "head"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "602442fb-5c20-47cc-8bcf-682808a76dd9"],
 " (no count) is the same as ",
 Cell[BoxData[
  RowBox[{"FindInfraRepresentative", "[", 
   RowBox[{"graph", ",", " ", "head", ",", " ", "Automatic"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6dc9800-a1cc-4937-8b66-0ef7753da6d9"],
 ", the first member in canonical order."
}], "Notes",ExpressionUUID->"bd996e28-d3dc-4129-ac28-c4b8d2146ef7"]
}, Open  ]],

