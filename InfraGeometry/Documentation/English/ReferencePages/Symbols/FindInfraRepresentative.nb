Notebook[{

Cell[CellGroupData[{
Cell["FindInfraRepresentative", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9d1eeedf-8487-450a-b234-568bd54cb02c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "725bfb01-9524-45f0-91c3-c6dcf488d93e"],
 "\[LineSeparator]",
 "gives one member of the inert ",
 StyleBox["head", "TI"],
 " as a vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6215c927-e180-4a1e-ab00-d532987464eb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"], ",", " ", 
    RowBox[{
     StyleBox["n", "TI"], " ", "|", " ", 
     RowBox[{
      ButtonBox["UpTo",
       BaseStyle->"Link"], "[", 
      StyleBox["n", "TI"], "]"}], " ", "|", " ", 
     ButtonBox["All",
      BaseStyle->"Link"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4aa5a204-5088-4b68-af24-d18618f928c3"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb140891-8445-452f-97ca-40c0a63d7e97"],
 " of ",
 StyleBox["n", "TI"],
 ", at most ",
 StyleBox["n", "TI"],
 ", or every member."
}], "Usage",ExpressionUUID->"7307319e-0cf6-401b-b4a9-527b5ad1cc24"],

Cell["\<\
The head names the notion; this function finds its members. Where the head \
has a faithful graph theorem, a member is read off it; otherwise the head's \
own search runs at its defaults.\
\>", "Notes",ExpressionUUID->"b1f58e0f-93a2-4ce7-9e8d-a6d4a1bcd4a4"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b85303b0-2bba-4cc3-a11f-cda03f01306f"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraRay", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9164302c-0736-4462-9962-742f1b192fb1"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraLine", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c9d6ffbd-9f70-4b48-95cb-319694f4e123"],
 " and ",
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "q"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f849b688-6843-4e58-9589-99f39861bc0d"],
 ": a member is a source-to-sink chain of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b68a0e28-9c9c-45d1-aa47-dc519959d62b"],
 ", read off in lexicographic order. A polyline ",
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   RowBox[{"p1", ",", " ", "...", ",", " ", "pk"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e0f858d-827a-4d7b-8179-8c52a73dd29b"],
 " and a multi-point arc concatenate the members of their pieces."
}], "Notes",ExpressionUUID->"99d79bc7-9cc9-454f-8fd0-99ab83efe3cd"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraCircle", "[", 
   RowBox[{"c", ",", " ", "p"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0c7057a-a508-464c-a42c-246511a0cb99"],
 " and ",
 Cell[BoxData[
  RowBox[{"InfraCircle", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d7fb39f4-248b-48e5-a939-2a4daf5c9e22"],
 ": a member is a circle found by the sweep, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe37618a-5155-4cbe-a6dd-162b7f09f10c"],
 " at its defaults, as a cyclic vertex list whose first vertex is not \
repeated. The necklace graph stays what ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84079a47-f519-4685-b552-6952ac9231ee"],
 " measures."
}], "Notes",ExpressionUUID->"3f24e144-98c9-41b2-b220-7034b0176b87"],

Cell[TextData[{
 "The scene tokens ",
 Cell[BoxData["InfraShell"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37fdbd8c-4f9e-4bf2-ac59-4ed930c0d936"],
 ", ",
 Cell[BoxData["InfraBall"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a970b5c1-c825-4c41-b9a1-3dbf0bb509cd"],
 ", ",
 Cell[BoxData["InfraPlane"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a128989f-a440-4743-b007-caa5d832af9a"],
 ", ",
 Cell[BoxData["InfraPolygon"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a005e045-7043-41f4-be50-3ca8021f7944"],
 ", ",
 Cell[BoxData["InfraTriangle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2679925-3032-42f7-a441-263432f922a9"],
 ", ",
 Cell[BoxData["InfraPolyline"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "968b9f22-f9e9-4619-a6e7-acec49613dac"],
 ", ",
 Cell[BoxData["InfraRevolution"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c11dfccb-dded-49c7-be29-56298558ee99"],
 ", ",
 Cell[BoxData["InfraWalk"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ec414eb-12d8-4dbb-a36b-ae2a7a3ea9b7"],
 ", ",
 Cell[BoxData["InfraPoint"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df2426b2-ec80-4ff7-aa23-c679818631b3"],
 " and ",
 Cell[BoxData[
  RowBox[{"InfraLine", "[", "path", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa7470dd-ae8e-49b5-a9b8-f010dc19a962"],
 ": a member is a result of the token's search at its defaults. A set head \
such as ",
 Cell[BoxData[
  RowBox[{"InfraBall", "[", 
   RowBox[{"c", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20f595d0-98c5-4d1d-a3ad-7a9436053274"],
 " has one member, its sorted vertex list."
}], "Notes",ExpressionUUID->"73cab099-4a2b-4c9a-a4f9-0be82b22b143"],

Cell[TextData[{
 "A closed count under a non-negative integer ",
 StyleBox["n", "TI"],
 " that exceeds the number of members gives ",
 Cell[BoxData[
  RowBox[{"{", " ", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "049fb146-42d9-455c-a865-10b63b99940d"],
 "."
}], "Notes",ExpressionUUID->"fc58364d-2daf-4925-8c0e-b80b85fcdd77"],

Cell["Two modifiers, given after the count:", "Notes",ExpressionUUID->"d30f1002-c6b9-4b9b-afa6-39b03e80a805"],

Cell[TextData[{
 Cell[BoxData["\"\<RandomChoice\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af04e6be-035a-41f7-8f30-72bbed047c34"],
 " gives random members. On a graph it walks the chains choosing the next \
arrow ",
 StyleBox["v", "TI"],
 " -> ",
 StyleBox["w", "TI"],
 " with probability proportional to the backward count at ",
 StyleBox["w", "TI"],
 ", so every member is drawn with probability ",
 Cell[BoxData[
  RowBox[{"1", " ", "/", " ", "Cardinality"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cc7079d-44bd-4c5f-a46d-8382615056ab"],
 "; on a search with a method ladder it is ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<RandomGreedy\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15d0adc1-a194-4d02-b2cf-9cc8b43f5ab1"],
 "; otherwise it draws from the search's members. ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9028219-446d-4388-8fba-0ded0399951b"],
 " in front reproduces the draw."
}], "Notes",ExpressionUUID->"d7aa8c1a-0290-4504-8b32-950c589b6d8c"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d88f75d-1a37-4995-8fc3-3f7fae7445f2"],
 ", under ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07b8b080-c23f-48ca-aa17-2a7bd82e87e8"],
 ", discards a random fraction ",
 StyleBox["q", "TI"],
 " of the candidates at each step of an otherwise exhaustive enumeration; on \
a search with a method ladder it is ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
     RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "q"}]}], "}"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2da9a898-72df-4019-94a7-16e3cffacf06"],
 "."
}], "Notes",ExpressionUUID->"84077f5a-dff1-434f-9ca6-3277b53253a6"],

Cell[TextData[{
 "The specialised searches (",
 Cell[BoxData["FindInfraSegment"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e02838f0-5274-4a40-82fb-f04eb3339155"],
 ", ",
 Cell[BoxData["FindInfraCircle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02f1c491-ca45-4b6a-b42c-82ed936ea06c"],
 ", ",
 Cell[BoxData["FindInfraShell"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82c3de45-b00d-473e-ad5b-268f385753c4"],
 ", ",
 Cell[BoxData["FindInfraWalk"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52778c13-3f0e-4060-a019-92f4b2af9f4c"],
 ", \[Ellipsis]) keep their own parameters; this function takes none of \
them."
}], "Notes",ExpressionUUID->"b9125315-8fa3-4070-95de-c05261183b96"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"FindInfraRepresentative", "[", 
   RowBox[{"graph", ",", " ", "head"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0697b8a7-a170-4376-a7cc-13803401a9a8"],
 " (no count) is the same as ",
 Cell[BoxData[
  RowBox[{"FindInfraRepresentative", "[", 
   RowBox[{"graph", ",", " ", "head", ",", " ", "Automatic"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0ff1489-ae0f-48c5-8bea-61d1404a9d76"],
 ", the first member in canonical order."
}], "Notes",ExpressionUUID->"1cca2594-9651-4b11-8093-56d91440e87e"]
