Cell["\<\
A member of a circle is a circle of the sweep, as a cyclic vertex list: the \
closing edge is implicit, and drawn as a walk it is added back.\
\>", "ExampleText",ExpressionUUID->"784c2888-f0bc-4f18-9b58-6427f8706a60"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"closedWalk", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"InfraWalk", "[", 
           RowBox[{"Append", "[", 
            RowBox[{"closedWalk", ",", " ", 
             RowBox[{"First", " ", "@", " ", "closedWalk"}]}], "]"}], "]"}], 
          " ", "->", " ", "$InfraCircleColor"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c"}],
         "}"}]}], "]"}], ",", " ", "closedWalk"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"d0348a84-22f2-4a5b-8529-8ae4890865f6"],

