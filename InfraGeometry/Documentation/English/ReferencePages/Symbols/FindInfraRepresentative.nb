Notebook[{

Cell[CellGroupData[{
Cell["FindInfraRepresentative", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d65b8874-9636-4f03-b44c-0110b577a569"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d206c93c-e9fe-4cd8-b6a4-e11f2737e766"],
 "\[LineSeparator]",
 "gives one member of the inert ",
 StyleBox["head", "TI"],
 " as a vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e64ef94b-5c42-4a8a-8d3b-cf8249901f97"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"], ",", " ", 
    RowBox[{
     StyleBox["n", "TI"], " ", "|", " ", 
     RowBox[{
      ButtonBox["UpTo",
       BaseStyle->"Link"], "[", 
      StyleBox["n", "TI"], "]"}], " ", "|", " ", 
     ButtonBox["All",
      BaseStyle->"Link"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c37ba9b9-1307-43dd-88c7-705bc0886312"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d84c2474-60af-48d1-8553-cd5fca5a68c8"],
 " of ",
 StyleBox["n", "TI"],
 ", at most ",
 StyleBox["n", "TI"],
 ", or every member."
}], "Usage",ExpressionUUID->"afef4ace-2dd2-4c44-a632-542c7f3399c2"],

Cell["\<\
The head names the notion; this function finds its members. Where the head \
has a faithful graph theorem, a member is read off it; otherwise the head's \
own search runs at its defaults.\
\>", "Notes",ExpressionUUID->"42aaebdb-6658-430b-b59f-b3b52b8998cc"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c84ca63-2929-4870-bb59-e5408f6fb948"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraRay", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2a8a700-4ca8-4261-bb07-79e904485a53"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraLine", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d53b21ad-1b6d-4b71-8d3d-9a2407d277d6"],
 " and ",
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "q"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04df9b35-3d7e-42eb-8874-d391ecc48e2e"],
 ": a member is a source-to-sink chain of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b18ca24d-95cd-46c0-8340-a99e1bc279dd"],
 ", read off in lexicographic order. A polyline ",
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   RowBox[{"p1", ",", " ", "...", ",", " ", "pk"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ad351fd-6243-4fe0-8b8b-46b30de807ad"],
 " and a multi-point arc concatenate the members of their pieces."
}], "Notes",ExpressionUUID->"cc8d2fcd-cb11-4a5d-8781-218ce5108392"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraCircle", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"r", " ", "|", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "s"}], "}"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fad13f4-8942-4d5b-8a6f-9fd1353dc4e9"],
 ": a member is a circle found by sweeping the band, length by length with ",
 Cell[BoxData["FindCycle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30f18383-f653-4490-9f00-fddfdefd530c"],
 " (see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b2f3f568-c1f5-4a81-ae71-e36a7b18b94e"],
 "), as a cyclic vertex list whose first vertex is not repeated. The necklace \
graph stays what ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa9f9892-3787-42d8-948f-ee343df3b483"],
 " measures."
}], "Notes",ExpressionUUID->"a3eb3d9e-308d-46eb-93df-1f23cb1daf18"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "p"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88c682e7-f82b-4dd7-8456-1fb361bb40ed"],
 ", the closed arc: the same sweep, keeping the circles through ",
 StyleBox["p", "TI"],
 ", and through every point of ",
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "q", ",", " ", "...", ",", " ", "p"}], "}"}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76f84dae-3527-4bb4-8c78-86a5aea158c5"],
 " (see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "67cef871-f86f-4b34-acf1-4b656696fedd"],
 ")."
}], "Notes",ExpressionUUID->"a70813af-ebe1-4d5d-b99a-acca8c49484c"],

Cell[TextData[{
 "The scene tokens ",
 Cell[BoxData["InfraShell"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b1da399-4e4d-49e0-a742-e93bf905f840"],
 ", ",
 Cell[BoxData["InfraBall"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a134697c-ca56-48fe-97e9-18a8b289d2d5"],
 ", ",
 Cell[BoxData["InfraPlane"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "329e5e3b-dd3a-4b23-8d72-ecd97d55ff8a"],
 ", ",
 Cell[BoxData["InfraPolygon"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7936c2f3-f10a-42a7-b6f6-81dc46cfde99"],
 ", ",
 Cell[BoxData["InfraTriangle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cedae021-e4e8-4bb2-8d35-7c760da45cd4"],
 ", ",
 Cell[BoxData["InfraPolyline"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5276cc86-e1b5-4cc3-9755-744bfefcde78"],
 ", ",
 Cell[BoxData["InfraRevolution"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c2b9f5f-e1f4-4945-b952-b3007d769511"],
 ", ",
 Cell[BoxData["InfraWalk"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a741a4b-09bc-4016-8fdf-8b47efd91d09"],
 ", ",
 Cell[BoxData["InfraPoint"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05e6d471-6a96-4535-af2e-2cb682bfc2da"],
 " and ",
 Cell[BoxData[
  RowBox[{"InfraLine", "[", "path", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6cb6c59-a222-476b-b521-9564a8d83756"],
 ": a member is a result of the token's search at its defaults. A set head \
such as ",
 Cell[BoxData[
  RowBox[{"InfraBall", "[", 
   RowBox[{"c", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60105c90-824a-4a1d-b8d0-42168e749df2"],
 " has one member, its sorted vertex list."
}], "Notes",ExpressionUUID->"c08db1b9-bcfc-4115-a2ff-b8b9e0b49c81"],

Cell[TextData[{
 "A closed count under a non-negative integer ",
 StyleBox["n", "TI"],
 " that exceeds the number of members gives ",
 Cell[BoxData[
  RowBox[{"{", " ", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "301db94f-7141-4fdc-9fa5-06fee2c5bde6"],
 "."
}], "Notes",ExpressionUUID->"d5889363-eb91-4e1f-bdc6-67c19e836488"],

Cell["Two modifiers, given after the count:", "Notes",ExpressionUUID->"d980ab02-5d89-487e-b27a-10f70e8a1b26"],

Cell[TextData[{
 Cell[BoxData["\"\<RandomChoice\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a32fa4a4-b29f-4e37-bd79-da3618f53b68"],
 " gives random members. On a graph it walks the chains choosing the next \
arrow ",
 StyleBox["v", "TI"],
 " -> ",
 StyleBox["w", "TI"],
 " with probability proportional to the backward count at ",
 StyleBox["w", "TI"],
 ", so every member is drawn with probability ",
 Cell[BoxData[
  RowBox[{"1", " ", "/", " ", "Cardinality"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ad8f7d-0472-42ec-897c-64e6edec043f"],
 "; on a search with a method ladder it is ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<RandomGreedy\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61bf1a49-9aac-484e-87c4-fd1fbc57c620"],
 "; otherwise it draws from the search's members. ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17a351e7-7a94-4e0a-b061-8f4197f832c2"],
 " in front reproduces the draw."
}], "Notes",ExpressionUUID->"36dfeedc-298c-4187-8e09-9bdd47913cad"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "194e1d79-1d2f-456d-a677-ddf389f4fef8"],
 ", under ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75443124-e8da-40d4-854c-1862e4132da6"],
 ", discards a random fraction ",
 StyleBox["q", "TI"],
 " of the candidates at each step of an otherwise exhaustive enumeration; on \
a search with a method ladder it is ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
     RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "q"}]}], "}"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eab6f78b-79b3-4a02-92f1-1b9705d1c37e"],
 "."
}], "Notes",ExpressionUUID->"79946342-5ca8-4af7-a6c0-9da5336c19ba"],

Cell[TextData[{
 "The specialised searches (",
 Cell[BoxData["FindInfraSegment"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0717714-726d-4b97-a4d1-2034ac4dbe6d"],
 ", ",
 Cell[BoxData["FindInfraSphere"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8be1a70-0bad-44cb-8ab1-c5eaf617fa2d"],
 ", ",
 Cell[BoxData["FindInfraShell"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88f26e89-454b-401f-9b9a-8764daa2a0c0"],
 ", ",
 Cell[BoxData["FindInfraWalk"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a016b0b1-6493-4495-9542-b9f4aff8f2e8"],
 ", \[Ellipsis]) keep their own parameters; this function takes none of \
them."
}], "Notes",ExpressionUUID->"62a39ee1-27a0-4fdd-8149-5a308a76ebdc"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"FindInfraRepresentative", "[", 
   RowBox[{"graph", ",", " ", "head"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0fe5551-c5b7-49a8-9531-2c46803c75d4"],
 " (no count) is the same as ",
 Cell[BoxData[
  RowBox[{"FindInfraRepresentative", "[", 
   RowBox[{"graph", ",", " ", "head", ",", " ", "Automatic"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd03a5d7-ce2e-44d8-9954-87de967649d0"],
 ", the first member in canonical order."
}], "Notes",ExpressionUUID->"c51d4be7-704f-4a6d-a746-c2ca1e8ff733"]
}, Open  ]],

