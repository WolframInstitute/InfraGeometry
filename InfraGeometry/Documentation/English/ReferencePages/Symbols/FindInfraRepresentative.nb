Every member is a member, and there are as many as the head counts.\
\>", "ExampleText",ExpressionUUID->"5ebc8b94-e4cd-4566-a448-c2557b54ab3b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "4"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", "seg", ",", " ", "All"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", "members", "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"members", ",", " ", 
       RowBox[{
        RowBox[{"InfraMemberQ", "[", 
         RowBox[{"g", ",", " ", "seg", ",", " ", "#"}], "]"}], " ", "&"}]}], 
      "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Length", " ", "@", " ", "members"}], " ", "===", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<Cardinality\>\""}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8605c221-5962-4f40-909c-6ab28a089bf1"],

