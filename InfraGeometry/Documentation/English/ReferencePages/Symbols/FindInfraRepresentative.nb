Cell[TextData[{
 "A closed count that cannot be met is ",
 Cell[BoxData[
  RowBox[{"{", " ", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6fa28b0-39a1-4888-a161-21a45976c0fe"],
 "; ",
 Cell[BoxData["UpTo"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f163505-d84b-4bdf-893c-80f5ae8d73fe"],
 " takes what there is."
}], "ExampleText",ExpressionUUID->"a36d1fd8-abc5-44b6-82bf-fcc84434ce33"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "4"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", "seg", ",", " ", 
          RowBox[{"UpTo", "[", "20", "]"}]}], "]"}], "}"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", "seg", ",", " ", "20"}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", 
        RowBox[{"UpTo", "[", "20", "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"ad6ae89e-11ba-480f-b1ed-05ed523a6ff0"],

