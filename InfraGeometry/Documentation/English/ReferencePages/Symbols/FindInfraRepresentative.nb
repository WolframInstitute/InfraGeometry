Cell[TextData[{
 "A uniformly random shortest path of a segment, drawn over the whole family. \
",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da0b6598-f701-4c6a-855b-5f42dc12125b"],
 " in front fixes the draw."
}], "ExampleText",ExpressionUUID->"73c3075b-d6f8-4fb8-a38c-7d2c015f69b0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "4"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"pick", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{
         "g", ",", " ", "seg", ",", " ", "1", ",", 
          " ", "\"\<RandomChoice\>\""}], "]"}]}]}], ")"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"seg", ",", " ", 
         RowBox[{"InfraWalk", "[", "pick", "]"}]}], "}"}]}], "]"}], ",", " ", 
     "pick"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1473608e-3be6-427f-bb17-3010555fca0a"],

