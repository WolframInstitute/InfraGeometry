Cell["\<\
A member of a circle is a circle of the sweep, as a cyclic vertex list: the \
closing edge is implicit, and drawn as a walk it is added back.\
\>", "ExampleText",ExpressionUUID->"debd471a-ef91-4c46-9d7a-52cdbe0affdb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"closedWalk", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"\"\<Radius\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4"}], "}"}]}]}], "]"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"InfraWalk", "[", 
           RowBox[{"Append", "[", 
            RowBox[{"closedWalk", ",", " ", 
             RowBox[{"First", " ", "@", " ", "closedWalk"}]}], "]"}], "]"}], 
          " ", "->", " ", "$InfraCircleColor"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c"}],
         "}"}]}], "]"}], ",", " ", "closedWalk"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"1533074b-f6aa-4ef0-bacb-bf0fc167db24"],

