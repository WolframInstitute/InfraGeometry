Notebook[{

Cell[CellGroupData[{
Cell["FindInfraRepresentative", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ac077f0c-4f5f-4986-833f-ef122448619b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bcdf0585-9913-4e7c-a11b-615ba1e3c689"],
 "\[LineSeparator]",
 "gives one member of the inert ",
 StyleBox["head", "TI"],
 " as a vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"237dbf5d-0e00-465e-b815-b3e99081c36f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"], ",", " ", 
    RowBox[{
     StyleBox["n", "TI"], " ", "|", " ", 
     RowBox[{
      ButtonBox["UpTo",
       BaseStyle->"Link"], "[", 
      StyleBox["n", "TI"], "]"}], " ", "|", " ", 
     ButtonBox["All",
      BaseStyle->"Link"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ec42636-9052-4173-ad9d-c212f5b0010f"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "719e8b1d-21d9-4690-9161-7e4d20f9cdd6"],
 " of ",
 StyleBox["n", "TI"],
 ", at most ",
 StyleBox["n", "TI"],
 ", or every member."
}], "Usage",ExpressionUUID->"51dd6c25-6f07-4698-9416-71fa1b477e97"],

Cell["\<\
The head names the notion; this function finds its members. Where the head \
has a faithful graph theorem, a member is read off it; otherwise the head's \
own search runs at its defaults.\
\>", "Notes",ExpressionUUID->"d3162085-a4e5-434c-a795-2393cfc9e1e2"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ab8843c-4b36-4613-a746-36b6ec59ab9e"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraRay", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e02f17df-dae1-4b18-b86b-8c99eccdb9fd"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraLine", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2c118ae-9e5d-4c09-ba70-ad1a99d51397"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraLine", "[", "germ", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62117159-b1d0-424e-88a4-c0817f715c4b"],
 " and ",
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "q"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a2a3c2a-e284-4d38-ad8c-0ec4a44c6d64"],
 ": a member is a source-to-sink chain of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3566f859-fe5f-4a2f-a24d-d3be2f465fbb"],
 ", read off in lexicographic order. A polyline ",
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   RowBox[{"p1", ",", " ", "...", ",", " ", "pk"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b191a40-631a-4544-abbf-a963aaedeff3"],
 " and a multi-point arc concatenate the members of their pieces."
}], "Notes",ExpressionUUID->"2b45b0ef-8beb-43d3-8dac-e1c3b212c15f"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraCircle", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"r", " ", "|", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "s"}], "}"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d37e5eb-677c-4d62-b919-1833f8f2b3dc"],
 ": a member is a circle found by sweeping the band, length by length with ",
 Cell[BoxData["FindCycle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "411fcc89-e6ae-49c4-9697-302c70372bcc"],
 " (see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "22a65adf-7571-4da5-ae2e-6a51b9d931dc"],
 "), as a cyclic vertex list whose first vertex is not repeated. The atoms \
stay what ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc45b40b-7138-4319-b29d-f3948d083572"],
 " measures; the sweep is the check on them."
}], "Notes",ExpressionUUID->"e456dc76-be87-4a50-91a5-820329cc0d0c"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "p"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "148dd396-af96-4631-991e-949f376b4197"],
 ", the closed arc: the same sweep, not the atom of its graph, keeping the \
circles through ",
 StyleBox["p", "TI"],
 ", and through every point of ",
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "q", ",", " ", "...", ",", " ", "p"}], "}"}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dcc2bba-9c56-431c-932e-b1ac9b9dd85a"],
 " (see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4ee16214-d540-4fed-b621-87040562435a"],
 ")."
}], "Notes",ExpressionUUID->"15501ae1-3390-4b72-a34d-94172ec73c4b"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraGeodesic", "[", 
   RowBox[{"germ", ",", " ", "s"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c263b65-a512-44d8-a503-240f70bfb7dc"],
 ", the geodesics at infra-scale ",
 StyleBox["s", "TI"],
 " through the germ: a member is an inextensible simple geodesic, the result \
of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c0224bbc-91c9-4a34-b78e-b1f206c034f1"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{
   "g", ",", " ", "germ", ",", " ", "s", ",", " ", "Infinity", ",", " ", "n", 
    ",", " ", 
    RowBox[{"Properties", " ", "->", " ", 
     RowBox[{"{", "\"\<Simple\>\"", "}"}]}], ",", " ", 
    RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<BothSides\>\""}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9183f162-530c-4bf4-ac5a-7e8bada61032"],
 ". The germ is a vertex list; a one-vertex list is grown on both sides, so \
it gives every geodesic through the vertex."
}], "Notes",ExpressionUUID->"5a8d05e6-956c-498a-b7fa-598443ba0a93"],

Cell[TextData[{
 "The scene tokens ",
 Cell[BoxData["InfraShell"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec799e50-ed8c-453d-bfca-1eeb729e5413"],
 ", ",
 Cell[BoxData["InfraBall"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d76c6a42-2563-4985-8106-15908bc825f5"],
 ", ",
 Cell[BoxData["InfraPlane"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "230c851a-b5de-463d-8d6a-b64320f1c9e8"],
 ", ",
 Cell[BoxData["InfraPolygon"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e10202a4-d25c-4935-9fc2-dfa1512366d2"],
 ", ",
 Cell[BoxData["InfraWalk"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "060481d7-41bd-47eb-949f-cfee9117c4b7"],
 " and ",
 Cell[BoxData["InfraPoint"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3173cb1b-6029-4c7a-9833-42ef6daee148"],
 ": a member is a result of the token's search at its defaults. A set head \
such as ",
 Cell[BoxData[
  RowBox[{"InfraBall", "[", 
   RowBox[{"c", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f28c1dd-eedb-4deb-9797-948cb8151154"],
 " has one member, its sorted vertex list."
}], "Notes",ExpressionUUID->"caa31187-c0bb-4ae1-af9d-7b866c01552c"],

Cell[TextData[{
 "The walk searches (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0266929a-e2c1-419f-90ec-33c092978005"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "14dd0e1f-45df-40c4-a690-34cf058cde59"],
 ") take a germ, a budget and options of their own; the head ",
 Cell[BoxData["InfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "537be1dc-549a-4a1c-a952-5d26c3562abf"],
 " fixes them to the inextensible simple class."
}], "Notes",ExpressionUUID->"2776b650-4101-4aa5-9439-7f1cb0f395be"],

Cell[TextData[{
 "A closed count under a non-negative integer ",
 StyleBox["n", "TI"],
 " that exceeds the number of members gives ",
 Cell[BoxData[
  RowBox[{"{", " ", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "430df1e5-10ca-4ea1-b2c4-607265b4d594"],
 "."
}], "Notes",ExpressionUUID->"eb83589b-a100-42d5-abe8-efc722883b3b"],

Cell["Two modifiers, given after the count:", "Notes",ExpressionUUID->"b9109a1f-b932-4f66-bbbc-1156b1b9185d"],

Cell[TextData[{
 Cell[BoxData["\"\<RandomChoice\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e08ae88-5d52-4a0a-ba80-cc17f9e02091"],
 " gives random members. On a graph it walks the chains choosing the next \
arrow ",
 StyleBox["v", "TI"],
 " -> ",
 StyleBox["w", "TI"],
 " with probability proportional to the backward count at ",
 StyleBox["w", "TI"],
 ", so every member is drawn with probability ",
 Cell[BoxData[
  RowBox[{"1", " ", "/", " ", "Cardinality"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "840990e8-4508-420d-9a9e-885b511b7fa6"],
 "; on a search it is ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "RandomSample"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8624deb-99a0-415f-b986-b02d95577835"],
 "; otherwise it draws from the search's members. ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51bc4c2a-55a7-4d50-9851-8450d6eb8488"],
 " in front reproduces the draw."
}], "Notes",ExpressionUUID->"569fa627-c549-4da0-b585-6228470752f5"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "785f6dbf-0ce5-4bca-93f6-30a8c89f97b0"],
 ", under ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d911f926-727a-43b1-bf5c-702816873285"],
 ", discards a random fraction ",
 StyleBox["q", "TI"],
 " of the candidates at each step of an otherwise exhaustive enumeration; on \
a search it is the next-vertex function ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"RandomSample", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"UpTo", "[", "q", "]"}]}], "]"}], " ", "&"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8703b33-62b2-483d-a19d-983d184a5421"],
 " for an integer ",
 StyleBox["q", "TI"],
 ", keeping a fraction ",
 StyleBox["q", "TI"],
 " of the candidates per node for ",
 StyleBox["q", "TI"],
 " < 1."
}], "Notes",ExpressionUUID->"8c21aab1-0599-4eae-9ea0-8e537f8fa075"],

Cell[TextData[{
 "The specialised searches (",
 Cell[BoxData["FindInfraSegment"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "094e025d-3713-495d-bf68-8146da68f88b"],
 ", ",
 Cell[BoxData["FindInfraSphere"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "356af70b-a76c-4619-aa69-d461d0e5192e"],
 ", ",
 Cell[BoxData["FindInfraShell"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9aa512c-8734-481c-9bd1-b828d1516b6f"],
 ", ",
 Cell[BoxData["FindInfraWalk"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46bb2ad3-5ce6-453b-9820-9f7c03587e31"],
 ", ",
 Cell[BoxData["FindInfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ecc8d44-bd90-4b55-af14-3d26be8699ee"],
 ", \[Ellipsis]) keep their own parameters; this function takes none of \
them."
}], "Notes",ExpressionUUID->"e868e3d2-3d50-49af-ad01-217f40e32b88"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"FindInfraRepresentative", "[", 
   RowBox[{"graph", ",", " ", "head"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b66f8786-e0a4-4b45-91ae-6246b0f1ca51"],
 " (no count) is the same as ",
 Cell[BoxData[
  RowBox[{"FindInfraRepresentative", "[", 
   RowBox[{"graph", ",", " ", "head", ",", " ", "Automatic"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c0c4c29-d8c6-41ac-aa9c-14f1a6820fa4"],
 ", the first member in canonical order."
}], "Notes",ExpressionUUID->"5a3e6659-aba8-4ad2-90bf-5a786d9a7a74"]
}, Open  ]],

