Notebook[{

Cell[CellGroupData[{
Cell["InfraHolonomyAngle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bfc713f3-a2a7-43bb-b9aa-d33e20447474"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHolonomyAngle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHolonomyAngle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["conn", "TI"], ",", " ", 
    StyleBox["loop", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29488e1c-ea65-4552-815c-610fa0b22ae2"],
 "\[LineSeparator]",
 "gives the unsigned rotation angle of the directions around loop under conn: \
the mean angle between each moved direction and its image, in arc radians.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"44a299c9-af6a-43d3-91fa-c3d10fd404c5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHolonomyAngle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHolonomyAngle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["loop", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0804e5e5-02a3-407f-9dcc-9460532b880e"],
 "\[LineSeparator]",
 "gives the least such angle over the Levi-Civita transports of \
InfraParallelTransport."
}], "Usage",ExpressionUUID->"6779c1a6-5927-450c-b589-3f5921fa4add"],

Cell["Options:", "Notes",ExpressionUUID->"4e9abaa6-0ae8-4179-a285-6e41f416a0fa"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fa42e9dc-273f-4122-8830-0ae0bb2eb4de"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"fce6a02d-38ce-4429-b2e7-10e6143c4db3"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"c84c7de2-d4cf-4441-a8d7-2bc09a512008"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e627e176-0ec9-4b59-975b-68c294dd0a83"], Cell[TextData[Cell[BoxData[
    "Method"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "4d3e4698-d3e3-4b69-a288-6a5f212031aa"]], "TableText",ExpressionUUID->
     "2eff19a3-9e02-48be-9eb8-9b30db578010"], Cell["\<\
\"Arclength\" (default): the angle between two directions at p is their \
distance in the graph with the open ball of radius r around p deleted, over \
r; \"Alexandrov\": the comparison angle of the polar form\
\>", "TableText",ExpressionUUID->"7c9b5c49-8df2-4919-b607-802539458bb5"]}
  }]], "2ColumnTableMod",ExpressionUUID->"c2cdc32a-e97b-42da-9fcc-\
ad2e274a22a0"],

Cell["\<\
The angle is a mean of unsigned angles, so it does not tell the sense of the \
rotation. The two-argument form is InfraGaugeTheory's InfraHolonomyAngle: the \
least angle over every choice among the best angle-isometries along the loop.\
\
\>", "Notes",ExpressionUUID->"c7fea390-c650-4201-92a2-22e98541c938"]
}, Open  ]],

