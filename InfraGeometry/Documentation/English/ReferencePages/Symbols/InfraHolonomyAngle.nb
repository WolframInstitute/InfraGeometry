    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["conn", "TI"], ",", " ", 
    StyleBox["loop", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dee1f25-f1ce-4dea-8ded-914e182988d8"],
 "\[LineSeparator]",
 "gives the angle by which transport along ",
 StyleBox["loop", "TI"],
 " under ",
 StyleBox["conn", "TI"],
 " turns the directions at the start of ",
 StyleBox["loop", "TI"],
 ": the mean angle between each moved direction and its image.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7ece713e-aae5-4f9a-9c87-b85f7fa3325d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHolonomyAngle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHolonomyAngle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["loop", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ecee5900-c901-405c-9161-e5aa5c5b8658"],
 "\[LineSeparator]",
 "gives the least such angle over the Levi-Civita transports along ",
 StyleBox["loop", "TI"],
 "."
}], "Usage",ExpressionUUID->"b1d87860-079a-4a19-8440-ce16e1ae1fcf"],

Cell[TextData[{
 "The fiber of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDisplacementBundle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4af06ab3-e6a0-4e89-9e1a-21ee73a52630"],
 " over ",
 StyleBox["p", "TI"],
 " is the set of directions at ",
 StyleBox["p", "TI"],
 ": the pairs {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "} with ",
 StyleBox["d(p, v) = r", "TI"],
 ". Transport around a loop at ",
 StyleBox["p", "TI"],
 " sends each direction ",
 StyleBox["u", "TI"],
 " to a direction ",
 StyleBox["\[Sigma](u)", "TI"],
 "."
}], "Notes",ExpressionUUID->"1e9e4ffc-350b-4204-b667-05138b4b2aa6"],

Cell[TextData[{
 "The holonomy angle is the mean of ",
 StyleBox["\[Angle](u, \[Sigma](u))", "TI"],
 " over the directions with ",
 StyleBox["\[Sigma](u) \[NotEqual] u", "TI"],
 ". It is 0 when no direction moves. Directions whose transport is blocked \
are left out."
}], "Notes",ExpressionUUID->"e6002dc8-5982-4abe-9d96-276614ca4f1b"],

Cell["\<\
The angle is unsigned: it does not tell the sense of the rotation.\
\>", "Notes",ExpressionUUID->"8731cfad-85c2-46c8-b2cf-599ee734b2b3"],

Cell[TextData[{
 "The angle between two directions ",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["w", "TI"],
 " at ",
 StyleBox["p", "TI"],
 ":"
}], "Notes",ExpressionUUID->"e10a62ab-ab8b-44c0-b009-28369db62fb4"],

