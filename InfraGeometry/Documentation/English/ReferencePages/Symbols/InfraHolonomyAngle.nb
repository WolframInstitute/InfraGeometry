Cell["All eight faces of the octahedron give 1:", "ExampleText",ExpressionUUID->"374aaba0-cafe-48ed-be7a-96d57b5d689b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"InfraHolonomyAngle", "[", 
      RowBox[{"fib", ",", " ", "conn", ",", " ", 
       RowBox[{"Append", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"First", " ", "@", " ", "#"}]}], "]"}]}], "]"}], " ", "&"}], 
    " ", "/@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"First", " ", "/@", " ", "#"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"FindCycle", "[", 
       RowBox[{
        RowBox[{"First", " ", "@", " ", "fib"}], ",", " ", 
        RowBox[{"{", "3", "}"}], ",", " ", "All"}], "]"}]}], ")"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"19b4819d-0269-42db-be50-6693db033e22"],

