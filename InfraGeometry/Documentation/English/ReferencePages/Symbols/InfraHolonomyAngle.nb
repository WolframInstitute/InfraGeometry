      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraHolonomyAngle", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "1"}], "}"}], ",", 
     " ", 
     RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3de50992-5324-44aa-adda-afaec2924e48"],

