Cell["\<\
The Levi-Civita connection of the octahedron and a face: the directions at 1 \
turn by one arc radian.\
\>", "ExampleText",ExpressionUUID->"37ad0d05-9fb3-4255-b8ac-f3bd35819ed9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"face", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "1"}], "}"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", "fib"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraWalk", "[", "face", "]"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"InfraHolonomyAngle", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}], ",", " ", 
       "face"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"41d573ab-0f07-4dbc-92c5-6e4877c1dc62"],

