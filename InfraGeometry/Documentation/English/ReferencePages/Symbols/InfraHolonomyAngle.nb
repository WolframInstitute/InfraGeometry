Cell["\<\
Around a face of the octahedron the four directions at the vertex 1 turn by \
one step, an angle of 1:\
\>", "ExampleText",ExpressionUUID->"ef2b8fad-e3ee-47c6-b088-c1e8ed32aa23"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"face", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "1"}], "}"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{
     RowBox[{"First", " ", "@", " ", "fib"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"InfraWalk", "[", "face", "]"}], "}"}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"InfraHolonomyAngle", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}], ",", " ", 
        "face"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"eabc9763-8c08-4846-ac3b-19f784ce2c6c"],

