Cell["\<\
The Levi-Civita connection of the octahedron and a face: the directions at 1 \
turn by one arc radian.\
\>", "ExampleText",ExpressionUUID->"837772f3-9289-4e85-806b-63c482ab9f5b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"face", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "1"}], "}"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", "fib"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraWalk", "[", "face", "]"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"InfraHolonomyAngle", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}], ",", " ", 
       "face"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"643d949c-672f-4202-8428-024070716cda"],

