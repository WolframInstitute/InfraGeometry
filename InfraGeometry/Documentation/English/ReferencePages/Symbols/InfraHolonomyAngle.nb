Cell["\<\
The least angle over the four Levi-Civita transports around the same face.\
\>", "ExampleText",ExpressionUUID->"d13e13c3-c2b3-45b3-a93f-32feaba8b5e0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"face", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "1"}], "}"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", "fib"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraWalk", "[", "face", "]"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraParallelTransport", "[", 
       RowBox[{"fib", ",", " ", "face"}], "]"}]}], ",", " ", 
     RowBox[{"InfraHolonomyAngle", "[", 
      RowBox[{"fib", ",", " ", "face"}], "]"}]}], "}"}]}], "]"}]], "Input",
