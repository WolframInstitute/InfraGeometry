Cell["\<\
The two probes on the same substrates: the ball quotients and the sphere \
quotients plus one, both tending to the dimension 2, beside the fitted \
numbers and the windows.\
\>", "ExampleText",ExpressionUUID->"9d40e8b7-d84e-4864-93e3-52061a7b92a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"names", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
        ",", " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"obsList", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"gr", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"#", ",", " ", "\"\<Large\>\""}], "]"}]}], "}"}], ",", 
         " ", 
         RowBox[{"VolumeGrowthObservables", "[", 
          RowBox[{"gr", ",", " ", 
           RowBox[{"InfraCenter", "[", "gr", "]"}]}], "]"}]}], "]"}], " ", 
       "&"}], " ", "/@", " ", "names"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"MapThread", "[", "\n", "     ", 
       RowBox[{
        RowBox[{
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"#1", "[", "\"\<BallLogDifferenceQuotients\>\"", "]"}], ",",
              " ", 
