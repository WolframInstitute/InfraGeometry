Cell["A window given explicitly is fitted as it stands.", "ExampleText",ExpressionUUID->"1c5a0d30-e672-4b5a-b621-779359e55575"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"KeyTake", "[", 
     RowBox[{
      RowBox[{"VolumeGrowthObservables", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "10"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<BallDimension\>\"", ",", 
        " ", "\"\<BallScalarCurvature\>\"", ",", " ", "\"\<BallWindow\>\""}], 
       "}"}]}], "]"}], " ", "//", " ", "Normal"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e0b4f7fd-aa20-4321-b2b1-43c2feb1eb76"],

