Cell["\<\
The ball probe on the flat 15 \[Times] 15 grid under three measures; the \
sphere probe, on the full shell count, is the same in all three.\
\>", "ExampleText",ExpressionUUID->"031feccb-c339-4539-aa81-848c9d4a5e86"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"m", " ", "->", " ", 
     RowBox[{"KeyTake", "[", 
      RowBox[{
       RowBox[{"VolumeGrowthObservables", "[", 
        RowBox[{
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"15", ",", " ", "15"}], "}"}], "]"}], ",", " ", "113", ",",
          " ", 
         RowBox[{"\"\<Measure\>\"", " ", "->", " ", "m"}]}], "]"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"\"\<BallDimension\>\"", ",", 
         " ", "\"\<SphereDimension\>\""}], "}"}]}], "]"}]}], " ", "//", " ", 
    "Normal"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"m", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<FullCount\>\"", ",", " ", "\"\<WithoutBoundary\>\"", ",", 
       " ", "\"\<HalfBoundary\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ea8c780d-6d77-4613-8d0c-f3e59550683c"],

