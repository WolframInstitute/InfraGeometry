    Cell["the scalar curvature read by each probe", "TableText",
     ExpressionUUID->"f75edbc8-ae05-402c-ac8e-6758943f92fc"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "19fa04c9-9c2f-4234-b5fa-7b18e1369283"], Cell[TextData[{
