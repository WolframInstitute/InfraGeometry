               RowBox[{"win", "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", ";;", " ", 
               RowBox[{"win", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}]}], "}"}], ",", 
          " ", 
          RowBox[{"PlotRange", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"All", ",", " ", 
             RowBox[{"{", 
