   RowBox[{"\<\"FullCount\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\<\"BallDimension\"\>", "\[Rule]", "1.6240736696322202`"}], ",", 
      RowBox[{"\<\"SphereDimension\"\>", "\[Rule]", "1.9999999999999996`"}]}],
      "}"}]}], ",", 
   RowBox[{"\<\"WithoutBoundary\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\<\"BallDimension\"\>", "\[Rule]", "2.331088290564098`"}], ",", 
      RowBox[{"\<\"SphereDimension\"\>", "\[Rule]", "1.9999999999999996`"}]}],
      "}"}]}], ",", 
