Cell[TextData[{
 "The profiles in the result are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallVolumes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallVolumes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "da835812-c99d-4066-b095-500fabc08c39"],
 " under the half-boundary measure and of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ShellAreas"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ShellAreas", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8aa8599b-ab0f-44b0-88ba-35cb90766e94"],
 " under the full count."
}], "ExampleText",ExpressionUUID->"af24acfc-b7f7-4f63-bd00-3b392c46dedc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ctr", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"obs", " ", "=", " ", 
       RowBox[{"VolumeGrowthObservables", "[", 
        RowBox[{"g", ",", " ", "ctr"}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"obs", "[", "\"\<BallVolumes\>\"", "]"}], " ", "===", " ", 
        RowBox[{"BallVolumes", "[", 
         RowBox[{"g", ",", " ", "ctr", ",", " ", 
          
          RowBox[{"\"\<Measure\>\"", " ", "->", 
