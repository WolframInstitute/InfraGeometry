Cell["A window given explicitly is fitted as it stands.", "ExampleText",ExpressionUUID->"6222cec4-529d-46a2-9a1d-a6f3027060e7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"KeyTake", "[", 
     RowBox[{
      RowBox[{"VolumeGrowthObservables", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "10"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<BallDimension\>\"", ",", 
        " ", "\"\<BallScalarCurvature\>\"", ",", " ", "\"\<BallWindow\>\""}], 
       "}"}]}], "]"}], " ", "//", " ", "Normal"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"bfb54519-3821-4734-b9f8-03a779d6c1c1"],

