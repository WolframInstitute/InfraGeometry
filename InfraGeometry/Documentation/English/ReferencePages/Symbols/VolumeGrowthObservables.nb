Cell[CellGroupData[{

Cell["Dimension", "ExampleSubsection",ExpressionUUID->"4413756d-97f2-4f9e-aadc-6ec7c2d02e56"],

Cell["\<\
With the dimension fixed at 2, only the curvature is fitted: the free line in \
gray, the line through the intercept 2 dashed, at the centre of the sphere \
mesh.\
\>", "ExampleText",ExpressionUUID->"ef9a6d5a-19bd-440b-943b-d52caa649865"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SphereMeshGraph\>\"", ",", " ", "\"\<Large\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"free", " ", "=", " ", 
     RowBox[{"VolumeGrowthObservables", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCenter", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"fixed", " ", "=", " ", 
     RowBox[{"VolumeGrowthObservables", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", 
       RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"quots", " ", "=", " ", 
      RowBox[{"free", "[", "\"\<BallLogDifferenceQuotients\>\"", "]"}]}], ",",
      " ", 
     RowBox[{"win", " ", "=", " ", 
      RowBox[{"free", "[", "\"\<BallWindow\>\"", "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"scatter", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rad", " ", 
          RowBox[{"(", 
           RowBox[{"rad", " ", "+", " ", "1"}], ")"}]}], ",", " ", 
         RowBox[{"quots", "[", 
          RowBox[{"[", "rad", "]"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"rad", ",", " ", 
         RowBox[{"win", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{"win", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Show", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"ListPlot", "[", 
        RowBox[{"scatter", ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"All", ",", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}]}], ",", " ", 
         RowBox[{"AxesLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<r(r+1)\>\"", ",", " ", "\"\<q\>\""}], "}"}]}]}], 
        "]"}], ",", "\n", "     ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"free", "[", "\"\<BallDimension\>\"", "]"}], " ", "-", 
            " ", 
            RowBox[{
             RowBox[{"free", "[", "\"\<BallScalarCurvature\>\"", "]"}], " ", 
             RowBox[{"x", "/", 
              RowBox[{"(", 
               RowBox[{"3", " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"free", "[", "\"\<BallDimension\>\"", "]"}], " ", "+",
                   " ", "2"}], ")"}]}], ")"}]}]}]}], ",", " ", 
           RowBox[{"2", " ", "-", " ", 
            RowBox[{
             RowBox[{"fixed", "[", "\"\<BallScalarCurvature\>\"", "]"}], " ", 
             
             RowBox[{"x", "/", "12"}]}]}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "0", ",", " ", 
           RowBox[{"Max", "[", 
            RowBox[{"scatter", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}]}], "}"}], ",",
          " ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"Gray", ",", " ", "Dashed"}], "}"}]}]}], "]"}]}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"KeyTake", "[", 
      RowBox[{"fixed", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<BallDimension\>\"", ",", 
         " ", "\"\<BallScalarCurvature\>\""}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
