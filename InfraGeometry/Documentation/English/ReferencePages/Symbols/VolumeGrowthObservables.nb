        RowBox[{"g", ",", " ", "ctr"}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"obs", "[", "\"\<BallVolumes\>\"", "]"}], " ", "===", " ", 
        RowBox[{"BallVolumes", "[", 
         RowBox[{"g", ",", " ", "ctr", ",", " ", 
          
