Cell["\<\
The quotients of the two probes at the centre of the square grid, the sphere \
quotients raised by 1. The sphere quotients are exactly 2 until the shells \
reach the rim; the ball quotients stay above 2:\
\>", "ExampleText",ExpressionUUID->"e0a62a3b-6e3a-4804-ba33-944453d1c42b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"obs", " ", "=", " ", 
     RowBox[{"VolumeGrowthObservables", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"obs", "[", "\"\<BallLogDifferenceQuotients\>\"", "]"}], ",", 
       " ", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"obs", "[", "\"\<SphereLogDifferenceQuotients\>\"", "]"}]}]}],
       "}"}], ",", "\n", "    ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<ball\>\"", ",", " ", "\"\<sphere\>\""}], "}"}]}], ",", 
     " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", "2", "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "3"}], "}"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"462af619-8ce8-4939-8611-9039c2a7b114"],

