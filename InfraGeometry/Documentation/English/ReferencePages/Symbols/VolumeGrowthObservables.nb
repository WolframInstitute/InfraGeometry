Cell["\<\
The shells at the two ends of the sphere window, with the dimension and the \
scalar curvature read there. The square grid is flat; the sphere mesh has \
positive curvature:\
\>", "ExampleText",ExpressionUUID->"e5c80fb3-454b-4fd3-90ae-c94eebb2fe54"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Medium\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"obs", " ", "=", " ", 
        RowBox[{"VolumeGrowthObservables", "[", 
         RowBox[{"g", ",", " ", "c"}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"window", " ", "=", " ", 
        RowBox[{"obs", "[", "\"\<SphereWindow\>\"", "]"}]}], "}"}], ",", "\n",
       "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{"window", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{"window", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", "c"}], "}"}], 
        ",", "\n", "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"Round", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"obs", "[", "\"\<SphereDimension\>\"", "]"}], ",", " ", 
             RowBox[{"obs", "[", "\"\<SphereScalarCurvature\>\"", "]"}]}], 
            "}"}], ",", " ", "0.01"}], "]"}]}]}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SphereMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"464b1085-c3f7-44f8-a7d3-4f33027c8a6f"],

