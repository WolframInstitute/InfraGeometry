Cell["\<\
The balls at the two ends of the fitted ball window on the square tiling, \
beside the keys of the result.\
\>", "ExampleText",ExpressionUUID->"1640e8b9-38fb-48c8-94d0-e09bef1c655f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"obs", " ", "=", " ", 
     RowBox[{"VolumeGrowthObservables", "[", 
      RowBox[{"g", ",", " ", "c"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"FindInfraRepresentative", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraBall", "[", 
            RowBox[{"c", ",", " ", 
             RowBox[{"Last", " ", "@", " ", 
              RowBox[{"obs", "[", "\"\<BallWindow\>\"", "]"}]}]}], "]"}]}], 
          "]"}], ",", " ", 
         RowBox[{"FindInfraRepresentative", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraBall", "[", 
            RowBox[{"c", ",", " ", 
             RowBox[{"First", " ", "@", " ", 
              RowBox[{"obs", "[", "\"\<BallWindow\>\"", "]"}]}]}], "]"}]}], 
          "]"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c"}],
         "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"obs", "[", "\"\<BallWindow\>\"", "]"}], ",", " ", 
     RowBox[{"Keys", " ", "@", " ", "obs"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"e437d132-8f96-4c67-b0ea-8d971f592b48"],

