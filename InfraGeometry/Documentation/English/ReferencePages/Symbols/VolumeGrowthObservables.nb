Cell["\<\
The four fitted numbers and the two windows on the same substrates.\
\>", "ExampleText",ExpressionUUID->"f39de7a4-07d2-4bf2-ba21-0f77f9f5cd52"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Dataset", " ", "@", " ", 
  RowBox[{"AssociationMap", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"gr", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"#", ",", " ", "\"\<Large\>\""}], "]"}]}], "}"}], ",", "\n",
        "    ", 
       RowBox[{"KeyTake", "[", 
        RowBox[{
         RowBox[{"VolumeGrowthObservables", "[", 
          RowBox[{"gr", ",", " ", 
           RowBox[{"InfraCenter", "[", "gr", "]"}]}], "]"}], ",", "\n", 
         "      ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<BallDimension\>\"", ",", " ", "\"\<SphereDimension\>\"",
            ",", " ", "\"\<BallScalarCurvature\>\"", ",", 
           " ", "\"\<SphereScalarCurvature\>\"", ",", 
           " ", "\"\<BallWindow\>\"", ",", " ", "\"\<SphereWindow\>\""}], 
          "}"}]}], "]"}]}], "]"}], " ", "&"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
       ",", " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"fe96f210-fc0b-4362-a5ab-50eaba44e8e6"],

