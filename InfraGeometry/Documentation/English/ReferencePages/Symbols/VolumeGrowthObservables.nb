Cell[TextData[{
 "Ball quotients against ",
 StyleBox["r(r + 1)", "TI"],
 " at the centre of the discretized plane, the square tiling and the \
hexagonal tiling, the fitted window in orange, and the fitted line. All three \
read a dimension a little above 2, as the Riemannian measure does, and \
curvature close to 0."
}], "ExampleText",ExpressionUUID->"8591040f-ac89-4621-aa83-11d9d2c9bd4a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"gr", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"nm", ",", " ", "\"\<Large\>\""}], "]"}]}], "}"}], ",", "\n",
       "    ", 
      RowBox[{"{", 
       RowBox[{"obs", " ", "=", " ", 
        RowBox[{"VolumeGrowthObservables", "[", 
         RowBox[{"gr", ",", " ", 
          RowBox[{"InfraCenter", "[", "gr", "]"}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"quots", " ", "=", " ", 
         RowBox[{"obs", "[", "\"\<BallLogDifferenceQuotients\>\"", "]"}]}], ",",
         " ", 
        RowBox[{"win", " ", "=", " ", 
         RowBox[{"obs", "[", "\"\<BallWindow\>\"", "]"}]}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"scatter", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"rad", " ", 
             RowBox[{"(", 
              RowBox[{"rad", " ", "+", " ", "1"}], ")"}]}], ",", " ", 
            RowBox[{"quots", "[", 
             RowBox[{"[", "rad", "]"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"rad", ",", " ", 
            RowBox[{"Length", " ", "@", " ", "quots"}]}], "}"}]}], "]"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"Show", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"scatter", ",", " ", 
            RowBox[{"scatter", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"win", "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", ";;", " ", 
               RowBox[{"win", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}]}], "}"}], ",", 
          " ", 
          RowBox[{"PlotRange", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"All", ",", " ", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}]}], ",", " ", 
          RowBox[{"AxesLabel", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<r(r+1)\>\"", ",", " ", "\"\<q\>\""}], "}"}]}], ",", 
          " ", 
          RowBox[{"PlotLabel", " ", "->", " ", "nm"}]}], "]"}], ",", "\n", 
        "      ", 
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"obs", "[", "\"\<BallDimension\>\"", "]"}], " ", "-", " ", 
           
           RowBox[{
            RowBox[{"obs", "[", "\"\<BallScalarCurvature\>\"", "]"}], " ", 
            RowBox[{"x", "/", 
             RowBox[{"(", 
              RowBox[{"3", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"obs", "[", "\"\<BallDimension\>\"", "]"}], " ", "+",
                  " ", "2"}], ")"}]}], ")"}]}]}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "0", ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"scatter", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}]}], "}"}], ",",
           "\n", "        ", 
          RowBox[{"PlotStyle", " ", "->", " ", "Gray"}]}], "]"}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"nm", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"14034932-8a02-4f2c-be47-8d1450c393c9"],

