Cell["A window given explicitly is fitted as it stands.", "ExampleText",ExpressionUUID->"a88bdfc0-535e-4ac3-a509-9f89b792f0a3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
