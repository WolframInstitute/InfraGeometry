Notebook[{

Cell[CellGroupData[{
Cell["VolumeGrowthObservables", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3b5ec787-10fe-4dc3-b97c-6c75bb89f3e7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VolumeGrowthObservables"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "568f8851-ef1b-4194-8e70-445b223d9089"],
 "\[LineSeparator]",
 "fits the dimension and the scalar curvature to the growth of the balls and \
of the shells at ",
 StyleBox["v", "TI"],
 ", and gives the profiles, the quotients, the fits and the windows used as \
one ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08cf5ae1-cb97-427a-a2c2-c3022c5d130b"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"04707083-c31a-416e-af71-dbcbc5ac2398"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VolumeGrowthObservables"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["rmin", "TI"], ",", " ", 
      StyleBox["rmax", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cd53ff7-4f34-403c-93dd-fa04970079b3"],
 "\[LineSeparator]",
 "fits over the given window of radii; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12cb8add-bb31-4db4-918d-74eaa800b522"],
 " fits every radius, ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63283cb5-159d-4970-9396-f60b0982f64b"],
 " chooses the window.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"97e8f522-c049-4533-937c-9dd71864548d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VolumeGrowthObservables"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v1", "TI"], ",", " ", 
      StyleBox["v2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    "\[Ellipsis]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2d1f1a1-9c43-4605-9b71-0e318b79d4b8"],
 "\[LineSeparator]",
 "gives one ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a9a1212-d968-4eb4-98a9-002936e0f904"],
 " per vertex; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e219942-99d7-4a7a-a5eb-f5f452983717"],
 " takes every vertex."
}], "Usage",ExpressionUUID->"9bbd3389-8c98-4882-ab7b-511bf8350ac6"],

Cell[TextData[{
 "Definition: at ",
 StyleBox["v", "TI"],
 " the ball probe regresses the log-difference quotient of the ball volumes, \
and the sphere probe that of the shell areas, on ",
 StyleBox["r(r + 1)", "TI"],
 " by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DimensionCurvatureFit"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5dd98984-941c-4170-8b64-6078e060e95f"],
 ". The ball reads ",
 StyleBox["d", "TI"],
 " from the intercept and ",
 StyleBox["R", "TI"],
 " = \[Minus]3(",
 StyleBox["d", "TI"],
 " + 2) times the slope; the sphere reads ",
 StyleBox["d", "TI"],
 " \[Minus] 1 from the intercept and ",
 StyleBox["R", "TI"],
 " = \[Minus]3",
 StyleBox["d", "TI"],
 " times the slope."
}], "Notes",ExpressionUUID->"fc5762e7-9fc4-40c0-a147-44a796447308"],

Cell[TextData[{
 "The two probes measure the same pair independently, since ",
 StyleBox["Vol B_r \[Proportional] r^d (1 \[Minus] R r\.b2 / (6(d + 2)))", 
  "TI"],
 " while ",
 StyleBox["Area S_r \[Proportional] r^(d\[Minus]1) (1 \[Minus] R r\.b2 / \
(6d))", "TI"],
 ". Their agreement is the check that the substrate behaves like a manifold \
near ",
 StyleBox["v", "TI"],
 "; where they disagree, trust the sphere, since the ball accumulates the \
small-radius artefacts."
}], "Notes",ExpressionUUID->"71be5f74-18c6-4262-8382-cf471bff33d8"],

Cell[TextData[{
 "The quotient is affine in ",
 StyleBox["r(r + 1)", "TI"],
 " only over a middle window: at small radius it carries the discretisation, \
and past the peak of the shell count the ball fills the graph instead of \
growing. The ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72718235-cd54-405d-9ce8-98ce87e05d71"],
 " window is the longest run of radii up to that peak whose least-squares \
residual stays within twice the noise floor. The windows used are reported."
}], "Notes",ExpressionUUID->"abcb1464-3644-40d1-844c-3a371feda8d9"],

Cell[TextData[{
 "The ball volume is a count of vertices, and at the radii fitted the \
boundary of the ball is not negligible. The ball probe reads it under the ",
 Cell[BoxData["\"\<Measure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df718767-b5f0-4828-946d-e162a00bcd27"],
 " option, through ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3327afbd-e555-469c-9c35-8a460bdf3e89"],
 " on ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2b9f17cf-6b3f-446d-aece-70afd4ee9e15"],
 ": the ",
 Cell[BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6b9b781-18be-46f8-982f-3821c40cd2c4"],
 ", the default, leaves out the vertices with a neighbour outside the ball, \
the ",
 Cell[BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6811b984-1d7b-4fea-af45-75f621e9210e"],
 " keeps them. On the square grid they are ",
 StyleBox["2 r^2 \[Minus] 2 r + 1", "TI"],
 " and ",
 StyleBox["2 r^2 + 2 r + 1", "TI"],
 ". The term of order ",
 StyleBox["r^(d \[Minus] 1)", "TI"],
 " has opposite signs in the two, so on a flat lattice the ball probe reads \
the dimension from above under the Riemannian measure and from below under \
the counting measure. The sphere probe reads the shells under the counting \
measure in both cases, since the Riemannian measure of a shell is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40bf87b6-78d5-4d5e-ade5-b6e9a27723eb"],
 "."
}], "Notes",ExpressionUUID->"e14f1e5e-8a01-4147-bac7-27e863cec2bd"],

Cell["The keys of the result:", "Notes",ExpressionUUID->"69711e21-6134-4ed9-9656-4efd8d1ea1ec"],

