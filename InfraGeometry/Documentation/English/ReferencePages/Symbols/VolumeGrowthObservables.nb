   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "84c6f64c-17d2-4e9f-aa4f-17e2f44a0989"],
 " under the full count."
}], "ExampleText",ExpressionUUID->"0b8ad966-2fb1-4f60-9b9d-97b2c28fca0d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ctr", " ", "=", " ", 
