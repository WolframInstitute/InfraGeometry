            RowBox[{"x", "/", 
             RowBox[{"(", 
              RowBox[{"3", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"obs", "[", "\"\<BallDimension\>\"", "]"}], " ", "+",
                  " ", "2"}], ")"}]}], ")"}]}]}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "0", ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"scatter", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}]}], "}"}], ",",
           "\n", "        ", 
          RowBox[{"PlotStyle", " ", "->", " ", "Gray"}]}], "]"}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
