    }], "TableText",ExpressionUUID->"db830e90-9f03-40a6-a988-152ab8a3bb6c"], 
    Cell[TextData[{
     "the comparison with flat space at each radius: ",
     StyleBox["6(d + 2)/r\.b2 (1 \[Minus] V(r)/V_flat(r))", "TI"],
     " and ",
     StyleBox["6d/r\.b2 (1 \[Minus] A(r)/A_flat(r))", "TI"]
