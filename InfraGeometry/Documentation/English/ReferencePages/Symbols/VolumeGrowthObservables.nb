        RowBox[{"{", 
         RowBox[{"All", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "4"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<r\>\"", ",", " ", "\"\<q\>\""}], "}"}]}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{"measures", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"KeyTake", "[", 
