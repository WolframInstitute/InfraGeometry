Cell["\<\
The two probes on the same substrates: the ball quotients and the sphere \
quotients plus one, both tending to the dimension 2, beside the fitted \
numbers and the windows.\
\>", "ExampleText",ExpressionUUID->"4b46a258-c8b0-4a93-9e0e-9e8602114531"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"names", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
        ",", " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"obsList", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"gr", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"#", ",", " ", "\"\<Large\>\""}], "]"}]}], "}"}], ",", 
         " ", 
         RowBox[{"VolumeGrowthObservables", "[", 
          RowBox[{"gr", ",", " ", 
           RowBox[{"InfraCenter", "[", "gr", "]"}]}], "]"}]}], "]"}], " ", 
       "&"}], " ", "/@", " ", "names"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"MapThread", "[", "\n", "     ", 
       RowBox[{
        RowBox[{
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"#1", "[", "\"\<BallLogDifferenceQuotients\>\"", "]"}], ",",
              " ", 
             RowBox[{
              RowBox[{
              "#1", "[", "\"\<SphereLogDifferenceQuotients\>\"", "]"}], " ", "+",
               " ", "1"}]}], "}"}], ",", " ", 
           RowBox[{"PlotRange", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"All", ",", " ", 
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "3.5"}], "}"}]}], "}"}]}], ",", "\n", 
           "       ", 
           RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
           RowBox[{"PlotLabel", " ", "->", " ", "#2"}], ",", " ", 
           RowBox[{"AxesLabel", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"\"\<r\>\"", ",", " ", "\"\<q\>\""}], "}"}]}]}], "]"}], 
         " ", "&"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"obsList", ",", " ", "names"}], "}"}]}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{"Dataset", " ", "@", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"names", ",", "\n", "     ", 
        RowBox[{
         RowBox[{
          RowBox[{"KeyTake", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<BallDimension\>\"", ",", 
              " ", "\"\<SphereDimension\>\"", ",", 
              " ", "\"\<BallScalarCurvature\>\"", ",", 
              " ", "\"\<SphereScalarCurvature\>\"", ",", 
              " ", "\"\<BallWindow\>\"", ",", " ", "\"\<SphereWindow\>\""}], 
             "}"}]}], "]"}], " ", "&"}], " ", "/@", " ", "obsList"}]}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6ce448d0-5ab9-4713-a602-34e4963f522a"],

