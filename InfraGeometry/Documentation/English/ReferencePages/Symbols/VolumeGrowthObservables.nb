Cell["\<\
On curved substrates the sign of the curvature shows: positive at the centre \
of a sphere mesh, negative on a hyperbolic tiling. The dimension read on the \
hyperbolic tiling is not 2: its balls grow exponentially, and only four radii \
fit before the rim.\
\>", "ExampleText",ExpressionUUID->"400e1e0d-61db-4912-8228-6d97605efda4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Dataset", " ", "@", " ", 
  RowBox[{"AssociationMap", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"gr", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"#", ",", " ", "\"\<Large\>\""}], "]"}]}], "}"}], ",", "\n",
        "    ", 
       RowBox[{"KeyTake", "[", 
        RowBox[{
         RowBox[{"VolumeGrowthObservables", "[", 
          RowBox[{"gr", ",", " ", 
           RowBox[{"InfraCenter", "[", "gr", "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<BallDimension\>\"", ",", 
           " ", "\"\<BallScalarCurvature\>\""}], "}"}]}], "]"}]}], "]"}], " ",
      "&"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"\"\<SphereMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
       ",", " ", "\"\<HyperbolicTilingGraph\>\""}], "}"}]}], "]"}]}]], "Input",\

