Cell[CellGroupData[{
Cell["VolumeGrowthObservables", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"07878e64-cffd-4129-ad60-5601f7e40eb1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VolumeGrowthObservables"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6f3c77a-22f1-4d2a-8aae-fd4f6dea992c"],
 "\[LineSeparator]",
 "fits the dimension and the scalar curvature to the growth of the balls and \
of the shells at ",
 StyleBox["v", "TI"],
 ", and gives the profiles, the quotients, the fits and the windows used as \
one ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc89791d-c2b5-43a6-a34b-4705f42e88bb"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"cb22c9a1-6585-415e-87c1-1d7cd89a18c7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VolumeGrowthObservables"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["rmin", "TI"], ",", " ", 
      StyleBox["rmax", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f62eb8d1-1c62-41d0-a4b7-cfd21b2ac3e8"],
 "\[LineSeparator]",
 "fits over the given window of radii; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7991f19-d994-41a4-bef1-efb3c0be578b"],
 " fits every radius, ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27ecf4e9-4482-435d-af50-bb5bc4f92101"],
 " chooses the window.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"95631d69-4e39-48be-af9b-d942bfb22865"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VolumeGrowthObservables"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v1", "TI"], ",", " ", 
      StyleBox["v2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    "\[Ellipsis]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc645059-ca83-4856-b366-03537041fbba"],
 "\[LineSeparator]",
 "gives one ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad625d9f-21ef-4ab4-8d6c-b2cfbe400ed5"],
 " per vertex; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68a1dcf2-610f-4c32-bd16-5d199bc0518e"],
 " takes every vertex."
}], "Usage",ExpressionUUID->"d79152e2-4a81-44ba-b911-e1d9b9d75fa6"],

Cell[TextData[{
 "Definition: at ",
 StyleBox["v", "TI"],
 " the ball probe regresses the log-difference quotient of the ball volumes, \
and the sphere probe that of the shell areas, on ",
 StyleBox["r(r + 1)", "TI"],
 " by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DimensionCurvatureFit"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "777571b2-8fa1-4f8f-8e68-63e9033f840b"],
 ". The ball reads ",
 StyleBox["d", "TI"],
 " from the intercept and ",
 StyleBox["R", "TI"],
 " = \[Minus]3(",
 StyleBox["d", "TI"],
 " + 2) times the slope; the sphere reads ",
 StyleBox["d", "TI"],
 " \[Minus] 1 from the intercept and ",
 StyleBox["R", "TI"],
 " = \[Minus]3",
 StyleBox["d", "TI"],
 " times the slope."
}], "Notes",ExpressionUUID->"859b67da-f834-441d-94a1-07ea00a9dc70"],

Cell[TextData[{
 "The two probes measure the same pair independently, since ",
 StyleBox["Vol B_r \[Proportional] r^d (1 \[Minus] R r\.b2 / (6(d + 2)))", 
  "TI"],
 " while ",
 StyleBox["Area S_r \[Proportional] r^(d\[Minus]1) (1 \[Minus] R r\.b2 / \
(6d))", "TI"],
 ". Their agreement is the check that the substrate behaves like a manifold \
near ",
 StyleBox["v", "TI"],
 "; where they disagree, trust the sphere, since the ball accumulates the \
small-radius artefacts."
}], "Notes",ExpressionUUID->"7fd14d9e-ac37-4fdb-a65a-3ed9bf631572"],

Cell[TextData[{
 "The quotient is affine in ",
 StyleBox["r(r + 1)", "TI"],
 " only over a middle window: at small radius it carries the discretisation, \
and past the peak of the shell count the ball fills the graph instead of \
growing. The ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ea5247a-9e38-41b7-a711-bd3b1b36e6fd"],
 " window is the longest run of radii up to that peak whose least-squares \
residual stays within twice the noise floor. The windows used are reported."
}], "Notes",ExpressionUUID->"4d2a9877-a2d6-45d3-b26d-7b03f1e6c5a1"],

Cell["The keys of the result:", "Notes",ExpressionUUID->"d129a03a-a692-43f8-b7cc-ae3a20fd10eb"],

