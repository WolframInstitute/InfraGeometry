Cell[TextData[{
 "Two probes read the same pair ",
 StyleBox["(d, R)", "TI"],
 " at ",
 StyleBox["v", "TI"],
 ", by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DimensionCurvatureFit"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6ad53069-b529-433c-a123-0f905c5c9635"],
 " on the log-difference quotients against ",
 StyleBox["r(r + 1)", "TI"],
 ":"
}], "Notes",ExpressionUUID->"d6a5f979-b03d-4abb-a1bf-f8956825c33e"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "23b6dddf-b3a2-4212-8c69-fe2e7d028fc3"], Cell["Probe", "TableText",
     FontWeight->Bold,ExpressionUUID->"98982bf5-a3a9-4ec5-b3d4-76835a69c3b8"],
     Cell["Profile", "TableText",
     FontWeight->Bold,ExpressionUUID->"abfc9485-9721-4e0a-82e0-7cd471e1fe96"],
     Cell["Expansion on a manifold", "TableText",
     FontWeight->Bold,ExpressionUUID->"c7ffa449-6b28-468a-a71d-cbe94ac567de"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b55379a3-b05d-4a9f-b6a1-7fc5a50973f2"], Cell[
    "ball", "TableText",ExpressionUUID->
     "2c9a2b62-029b-4557-b3b8-cf1554fed45f"], Cell[TextData[{
     StyleBox["V(r)", "TI"],
     ", the measure of the ball"
    }], "TableText",ExpressionUUID->"0ed6ddda-54dd-4a24-b325-2eb4928bf762"], 
    Cell[TextData[StyleBox[
    "V \[Proportional] r\:1d48 (1 \[Minus] R r\.b2 / (6(d + 2)))", "TI"]], 
     "TableText",ExpressionUUID->"7053b4e6-c118-473d-b9d7-5e8d1bcb4bed"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7e19986d-9ce9-4d7b-b705-d437ae997033"], Cell[
    "sphere", "TableText",ExpressionUUID->
     "a4ce712b-be21-448c-a2a8-8f17b0b898aa"], Cell[TextData[{
     StyleBox["A(r)", "TI"],
     ", the number of vertices of the shell"
    }], "TableText",ExpressionUUID->"f74e55fd-9e9d-4831-8cda-7ca33a1c0d29"], 
    Cell[TextData[StyleBox[
    "A \[Proportional] r\:1d48\:207b\.b9 (1 \[Minus] R r\.b2 / (6d))", "TI"]],
      "TableText",ExpressionUUID->"8b860362-bc7f-45ea-81c8-21537f979777"]}
  }]], "3ColumnTableMod",ExpressionUUID->"ba3df283-73a4-4add-9c97-\
d8a6347dc4f8"],

Cell[TextData[{
 "The sphere probe is the reliable one on a graph. The ball volume counts its \
boundary, which at small radius is a large share of the ball. On the square \
grid the sphere probe reads ",
 StyleBox["d", "TI"],
 " = 2 and ",
 StyleBox["R", "TI"],
 " = 0 exactly, since the shells have ",
 StyleBox["4r", "TI"],
 " vertices; the ball probe reads the dimension above 2 under the Riemannian \
measure and below 2 under the counting measure."
}], "Notes",ExpressionUUID->"d54ede8c-790b-44a8-9cc6-9971b07a34f2"],

Cell[TextData[{
 "The window can be a pair {",
 StyleBox["rmin", "TI"],
 ", ",
 StyleBox["rmax", "TI"],
 "}, ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6aeae23a-6f17-4be8-a295-0d9e125cd342"],
 " for every radius, or ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "570e6ade-3498-4262-adc7-c827330c87a4"],
 ", the default. The ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c883174c-19a5-4f3a-a790-9b2283a9b56e"],
 " window is the longest run of radii, up to the peak of ",
 StyleBox["A(r)", "TI"],
 ", on which the quotients lie on a line within twice the noise."
}], "Notes",ExpressionUUID->"9cd3f589-4595-4884-9b40-1c6eb8cc6d35"],

