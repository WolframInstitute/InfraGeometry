Cell["\<\
The comparison with flat space at each radius, and the fitted numbers. On \
curved substrates the sign of the curvature shows: positive at the centre of \
a sphere mesh, negative on a hyperbolic tiling. The dimension read on the \
hyperbolic tiling is not 2: its balls grow exponentially, and only a few \
radii fit before the rim.\
\>", "ExampleText",ExpressionUUID->"5ec18595-71ff-477f-9675-aa0bc324a0b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"names", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SphereMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
        ",", " ", "\"\<HyperbolicTilingGraph\>\""}], "}"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"obsList", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"gr", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"#", ",", " ", "\"\<Large\>\""}], "]"}]}], "}"}], ",", 
         " ", 
         RowBox[{"VolumeGrowthObservables", "[", 
          RowBox[{"gr", ",", " ", 
           RowBox[{"InfraCenter", "[", "gr", "]"}]}], "]"}]}], "]"}], " ", 
       "&"}], " ", "/@", " ", "names"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<BallCurvatureByRadius\>\"", "]"}], " ", "&"}],
         " ", "/@", " ", "obsList"}], ",", " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", "names"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"All", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "3"}], ",", " ", "1"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<r\>\"", ",", " ", "\"\<R(r)\>\""}], "}"}]}]}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"Dataset", " ", "@", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"names", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"KeyTake", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<BallDimension\>\"", ",", 
              " ", "\"\<BallScalarCurvature\>\""}], "}"}]}], "]"}], " ", 
          "&"}], " ", "/@", " ", "obsList"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c90010d0-22f3-4660-b548-2826864d7901"],

