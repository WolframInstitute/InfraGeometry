Cell["\<\
The ball probe on the flat 15 \[Times] 15 grid under three measures; the \
sphere probe, on the full shell count, is the same in all three.\
\>", "ExampleText",ExpressionUUID->"25903124-5173-4af3-8b33-d95e51d62f2b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"m", " ", "->", " ", 
     RowBox[{"KeyTake", "[", 
      RowBox[{
       RowBox[{"VolumeGrowthObservables", "[", 
        RowBox[{
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"15", ",", " ", "15"}], "}"}], "]"}], ",", " ", "113", ",",
          " ", 
         RowBox[{"\"\<Measure\>\"", " ", "->", " ", "m"}]}], "]"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"\"\<BallDimension\>\"", ",", 
         " ", "\"\<SphereDimension\>\""}], "}"}]}], "]"}]}], " ", "//", " ", 
    "Normal"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"m", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<FullCount\>\"", ",", " ", "\"\<WithoutBoundary\>\"", ",", 
       " ", "\"\<HalfBoundary\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1d7269c6-10d0-4714-994e-1fa4e813a758"],

