Cell["\<\
The four fitted numbers and the two windows on the same substrates.\
\>", "ExampleText",ExpressionUUID->"2792d6e1-df93-476a-b17e-b784c4472f42"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Dataset", " ", "@", " ", 
  RowBox[{"AssociationMap", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"gr", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"#", ",", " ", "\"\<Large\>\""}], "]"}]}], "}"}], ",", "\n",
        "    ", 
       RowBox[{"KeyTake", "[", 
        RowBox[{
         RowBox[{"VolumeGrowthObservables", "[", 
          RowBox[{"gr", ",", " ", 
           RowBox[{"InfraCenter", "[", "gr", "]"}]}], "]"}], ",", "\n", 
         "      ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<BallDimension\>\"", ",", " ", "\"\<SphereDimension\>\"",
            ",", " ", "\"\<BallScalarCurvature\>\"", ",", 
           " ", "\"\<SphereScalarCurvature\>\"", ",", 
           " ", "\"\<BallWindow\>\"", ",", " ", "\"\<SphereWindow\>\""}], 
          "}"}]}], "]"}]}], "]"}], " ", "&"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
       ",", " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"040b4e98-a759-4569-b8f2-3741bf733188"],

