    }], "TableText",ExpressionUUID->"005fc725-dad3-4928-9385-39938bdbd7a8"], 
    Cell[TextData[{
     "the quotients ",
     StyleBox["q(r)", "TI"],
     " at ",
     StyleBox["r", "TI"],
     " = 1, 2, \[Ellipsis], taken between the radii ",
     StyleBox["r", "TI"],
     " and ",
     StyleBox["r", "TI"],
     " + 1"
    }], "TableText",ExpressionUUID->"b4dc826b-345b-4250-aeef-435d538d940e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ebfed13e-19f5-4515-842d-ad1e35539ec9"], Cell[TextData[{
