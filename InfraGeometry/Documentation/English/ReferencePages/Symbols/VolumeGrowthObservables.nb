Cell["\<\
The comparison with flat space at each radius, and the fitted numbers. On \
curved substrates the sign of the curvature shows: positive at the centre of \
a sphere mesh, negative on a hyperbolic tiling. The dimension read on the \
hyperbolic tiling is not 2: its balls grow exponentially, and only a few \
radii fit before the rim.\
\>", "ExampleText",ExpressionUUID->"e27f3e6c-a408-460f-a570-254feec1e1b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"names", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SphereMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
        ",", " ", "\"\<HyperbolicTilingGraph\>\""}], "}"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"obsList", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"gr", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"#", ",", " ", "\"\<Large\>\""}], "]"}]}], "}"}], ",", 
         " ", 
         RowBox[{"VolumeGrowthObservables", "[", 
          RowBox[{"gr", ",", " ", 
           RowBox[{"InfraCenter", "[", "gr", "]"}]}], "]"}]}], "]"}], " ", 
       "&"}], " ", "/@", " ", "names"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<BallCurvatureByRadius\>\"", "]"}], " ", "&"}],
         " ", "/@", " ", "obsList"}], ",", " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", "names"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"All", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "3"}], ",", " ", "1"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<r\>\"", ",", " ", "\"\<R(r)\>\""}], "}"}]}]}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"Dataset", " ", "@", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"names", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"KeyTake", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<BallDimension\>\"", ",", 
              " ", "\"\<BallScalarCurvature\>\""}], "}"}]}], "]"}], " ", 
          "&"}], " ", "/@", " ", "obsList"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4040470f-9fee-4c90-aeca-1281be338f68"],

