Cell[TextData[{
 "Ball quotients against ",
 StyleBox["r(r + 1)", "TI"],
 " at the centre of the discretized plane, the square tiling and the \
hexagonal tiling, the fitted window in orange, and the fitted line. All three \
read dimension 2 and curvature close to 0."
}], "ExampleText",ExpressionUUID->"38eacfa2-8c64-45a8-8048-e548b507013f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"gr", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"nm", ",", " ", "\"\<Large\>\""}], "]"}]}], "}"}], ",", "\n",
       "    ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"obs", " ", "=", " ", 
          RowBox[{"VolumeGrowthObservables", "[", 
           RowBox[{"gr", ",", " ", 
            RowBox[{"InfraCenter", "[", "gr", "]"}]}], "]"}]}], "}"}], ",", 
        "\n", "      ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"quots", " ", "=", " ", 
             RowBox[{
             "obs", "[", "\"\<BallLogDifferenceQuotients\>\"", "]"}]}], ",", 
            " ", 
            RowBox[{"win", " ", "=", " ", 
             RowBox[{"obs", "[", "\"\<BallWindow\>\"", "]"}]}]}], "}"}], ",", 
          "\n", "        ", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"scatter", " ", "=", " ", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"rad", " ", 
                   RowBox[{"(", 
                    RowBox[{"rad", " ", "+", " ", "1"}], ")"}]}], ",", " ", 
                  RowBox[{"quots", "[", 
                   RowBox[{"[", "rad", "]"}], "]"}]}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"rad", ",", " ", 
                  RowBox[{"Length", " ", "@", " ", "quots"}]}], "}"}]}], 
               "]"}]}], "}"}], ",", "\n", "          ", 
            RowBox[{"Show", "[", "\n", "            ", 
             RowBox[{
              RowBox[{"ListPlot", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"scatter", ",", " ", 
                  RowBox[{"scatter", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"win", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], " ", ";;", " ", 
                    RowBox[{"win", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}]}], "}"}], ",",
                 " ", 
                RowBox[{"PlotRange", " ", "->", " ", 
                 RowBox[{"{", 
                  RowBox[{"All", ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}]}], ",", "\n",
                 "              ", 
                RowBox[{"AxesLabel", " ", "->", " ", 
                 RowBox[{"{", 
                  RowBox[{"\"\<r(r+1)\>\"", ",", " ", "\"\<q\>\""}], "}"}]}], 
                ",", " ", 
                RowBox[{"PlotLabel", " ", "->", " ", "nm"}]}], "]"}], ",", 
              "\n", "            ", 
              RowBox[{"Plot", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"obs", "[", "\"\<BallDimension\>\"", "]"}], " ", "-",
                  " ", 
                 RowBox[{
                  RowBox[{"obs", "[", "\"\<BallScalarCurvature\>\"", "]"}], " ", 
                  RowBox[{"x", "/", 
                   RowBox[{"(", 
                    RowBox[{"3", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"obs", "[", "\"\<BallDimension\>\"", "]"}], " ", "+",
                     " ", "2"}], ")"}]}], ")"}]}]}]}], ",", "\n", 
                "              ", 
                RowBox[{"{", 
                 RowBox[{"x", ",", " ", "0", ",", " ", 
                  RowBox[{"Max", "[", 
                   RowBox[{"scatter", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}]}], 
                 "}"}], ",", " ", 
                RowBox[{"PlotStyle", " ", "->", " ", "Gray"}]}], "]"}], ",", 
              "\n", "            ", 
              RowBox[{"ImageSize", " ", "->", " ", "200"}]}], "]"}]}], 
           "]"}]}], "]"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"nm", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], 
  "]"}]], "Input",
