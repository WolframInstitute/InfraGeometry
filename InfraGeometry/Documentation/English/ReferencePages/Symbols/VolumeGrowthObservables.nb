     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"obs", " ", "=", " ", 
     RowBox[{"VolumeGrowthObservables", "[", 
      RowBox[{"g", ",", " ", "c"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"radii", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"VertexEccentricity", "[", 
        RowBox[{"g", ",", " ", "c"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"obs", "[", "\"\<BallVolumes\>\"", "]"}], " ", "==", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
          " ", "\"\<RiemannianMeasure\>\""}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r", ",", " ", "radii"}], "}"}]}], "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"obs", "[", "\"\<ShellAreas\>\"", "]"}], " ", "==", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
          " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r", ",", " ", "radii"}], "}"}]}], "]"}]}]}], "}"}]}], 
