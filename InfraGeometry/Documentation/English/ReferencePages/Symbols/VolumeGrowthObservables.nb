       RowBox[{"{", 
        RowBox[{"gr", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"#", ",", " ", "\"\<Large\>\""}], "]"}]}], "}"}], ",", "\n",
        "    ", 
       RowBox[{"KeyTake", "[", 
        RowBox[{
         RowBox[{"VolumeGrowthObservables", "[", 
          RowBox[{"gr", ",", " ", 
           RowBox[{"InfraCenter", "[", "gr", "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<BallDimension\>\"", ",", 
           " ", "\"\<BallScalarCurvature\>\""}], "}"}]}], "]"}]}], "]"}], " ",
      "&"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"\"\<SphereMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
       ",", " ", "\"\<HyperbolicTilingGraph\>\""}], "}"}]}], "]"}]}]], "Input",\

