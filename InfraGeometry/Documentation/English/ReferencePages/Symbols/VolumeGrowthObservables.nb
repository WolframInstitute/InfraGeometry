          " ", 
          RowBox[{"PlotLabel", " ", "->", " ", "nm"}]}], "]"}], ",", "\n", 
        "      ", 
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"obs", "[", "\"\<BallDimension\>\"", "]"}], " ", "-", " ", 
           
           RowBox[{
