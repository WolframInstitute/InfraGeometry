Cell[TextData[{
 "The profiles in the result are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallVolumes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallVolumes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b506ae9f-f9f7-41b2-81ea-576f08d73bf2"],
 " under the half-boundary measure and of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ShellAreas"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ShellAreas", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0d2707e8-cc55-453f-898b-7176b6248912"],
 " under the full count."
}], "ExampleText",ExpressionUUID->"85da5511-bc46-48be-8a31-af238aa6b947"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ctr", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"obs", " ", "=", " ", 
     RowBox[{"VolumeGrowthObservables", "[", 
      RowBox[{"g", ",", " ", "ctr"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"obs", "[", "\"\<BallVolumes\>\"", "]"}], ",", " ", 
         RowBox[{"obs", "[", "\"\<ShellAreas\>\"", "]"}]}], "}"}], ",", " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<ball\>\"", ",", " ", "\"\<shell\>\""}], "}"}]}], ",", 
       " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<r + 1\>\"", ",", " ", "None"}], "}"}]}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"obs", "[", "\"\<BallVolumes\>\"", "]"}], " ", "===", " ", 
        RowBox[{"BallVolumes", "[", 
         RowBox[{"g", ",", " ", "ctr", ",", " ", 
          
          RowBox[{"\"\<Measure\>\"", " ", "->", 
           " ", "\"\<HalfBoundary\>\""}]}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"obs", "[", "\"\<ShellAreas\>\"", "]"}], " ", "===", " ", 
        RowBox[{"ShellAreas", "[", 
         RowBox[{"g", ",", " ", "ctr"}], "]"}]}]}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"deca7c14-e9db-4575-b6c6-8af40bbb5f23"],

