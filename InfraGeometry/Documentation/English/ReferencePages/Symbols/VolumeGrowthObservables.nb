Cell["\<\
The four fitted numbers and the two windows on the same substrates.\
\>", "ExampleText",ExpressionUUID->"28f45f56-2f76-42de-8613-8c4160cb03fa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Dataset", " ", "@", " ", 
  RowBox[{"AssociationMap", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"gr", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"#", ",", " ", "\"\<Large\>\""}], "]"}]}], "}"}], ",", "\n",
        "    ", 
       RowBox[{"KeyTake", "[", 
        RowBox[{
         RowBox[{"VolumeGrowthObservables", "[", 
          RowBox[{"gr", ",", " ", 
           RowBox[{"InfraCenter", "[", "gr", "]"}]}], "]"}], ",", "\n", 
         "      ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<BallDimension\>\"", ",", " ", "\"\<SphereDimension\>\"",
            ",", " ", "\"\<BallScalarCurvature\>\"", ",", 
           " ", "\"\<SphereScalarCurvature\>\"", ",", 
           " ", "\"\<BallWindow\>\"", ",", " ", "\"\<SphereWindow\>\""}], 
          "}"}]}], "]"}]}], "]"}], " ", "&"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
       ",", " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"93f5fa6b-9f4b-4312-9e93-00606b3687a6"],

