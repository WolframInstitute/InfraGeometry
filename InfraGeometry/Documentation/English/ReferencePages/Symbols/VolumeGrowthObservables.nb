Cell[CellGroupData[{
Cell["VolumeGrowthObservables", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3b60f2f2-98ee-4cf2-908e-344ac93c7852"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VolumeGrowthObservables"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f7e8bd1-5352-4e8c-b672-5923b76f8845"],
 "\[LineSeparator]",
 "fits the dimension and the scalar curvature to the growth of the balls and \
of the shells at ",
 StyleBox["v", "TI"],
 ", and gives the profiles, the quotients, the fits and the windows used as \
one ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3139c5d1-79af-4161-a3ac-26b8fd0493eb"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b1c9eeb1-99da-4c10-819f-ac095f5d3644"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VolumeGrowthObservables"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["rmin", "TI"], ",", " ", 
      StyleBox["rmax", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eff1cecc-478a-47ee-944c-761257a64d12"],
 "\[LineSeparator]",
 "fits over the given window of radii; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cc16c6c-0fd7-45e2-ba29-4c40706c60d5"],
 " fits every radius, ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74be399a-4551-4d27-9886-2140209ce679"],
 " chooses the window.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"04453216-327b-4ad5-b831-63a583e8eab4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VolumeGrowthObservables"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v1", "TI"], ",", " ", 
      StyleBox["v2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    "\[Ellipsis]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e119f9e2-b172-43aa-882f-dcd4d147f705"],
 "\[LineSeparator]",
 "gives one ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1b396ee-b414-4462-83a3-f25ff36112b3"],
 " per vertex; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c21c0b7b-3478-49a4-b76c-b42bc21dd131"],
 " takes every vertex."
}], "Usage",ExpressionUUID->"46ce38dd-03dd-4fda-b098-7087ce1f993a"],

Cell[TextData[{
 "Definition: at ",
 StyleBox["v", "TI"],
 " the ball probe regresses the log-difference quotient of the ball volumes, \
and the sphere probe that of the shell areas, on ",
 StyleBox["r(r + 1)", "TI"],
 " by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DimensionCurvatureFit"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9dad510a-fdb3-4ab5-b25a-53da872a7ccf"],
 ". The ball reads ",
 StyleBox["d", "TI"],
 " from the intercept and ",
 StyleBox["R", "TI"],
 " = \[Minus]3(",
 StyleBox["d", "TI"],
 " + 2) times the slope; the sphere reads ",
 StyleBox["d", "TI"],
 " \[Minus] 1 from the intercept and ",
 StyleBox["R", "TI"],
 " = \[Minus]3",
 StyleBox["d", "TI"],
 " times the slope."
}], "Notes",ExpressionUUID->"14ee6c75-f9b9-40fb-a362-63f5cfe56059"],

Cell[TextData[{
 "The two probes measure the same pair independently, since ",
 StyleBox["Vol B_r \[Proportional] r^d (1 \[Minus] R r\.b2 / (6(d + 2)))", 
  "TI"],
 " while ",
 StyleBox["Area S_r \[Proportional] r^(d\[Minus]1) (1 \[Minus] R r\.b2 / \
(6d))", "TI"],
 ". Their agreement is the check that the substrate behaves like a manifold \
near ",
 StyleBox["v", "TI"],
 "; where they disagree, trust the sphere, since the ball accumulates the \
small-radius artefacts."
}], "Notes",ExpressionUUID->"f9adf2a2-e2ba-40b7-8ed2-98e158f72cc7"],

Cell[TextData[{
 "The quotient is affine in ",
 StyleBox["r(r + 1)", "TI"],
 " only over a middle window: at small radius it carries the discretisation, \
and past the peak of the shell count the ball fills the graph instead of \
growing. The ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "855f76e2-42db-4081-9c1e-75e271f19beb"],
 " window is the longest run of radii up to that peak whose least-squares \
residual stays within twice the noise floor. The windows used are reported."
}], "Notes",ExpressionUUID->"a8a96ed1-672a-4b69-bba6-870f9e775a8e"],

Cell["The keys of the result:", "Notes",ExpressionUUID->"ffc0c11a-a69d-4035-9ae5-558b294ee461"],

