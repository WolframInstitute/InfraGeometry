Notebook[{

Cell[CellGroupData[{
Cell["VolumeGrowthObservables", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"082dafef-2e64-42a0-a2ed-89ddd50ce60f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VolumeGrowthObservables"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "840b3675-b4d8-4492-9b2b-5585274d0f3a"],
 "\[LineSeparator]",
 "fits the dimension and the scalar curvature to the growth of the balls and \
of the shells at ",
 StyleBox["v", "TI"],
 ", and gives the profiles, the quotients, the fits and the windows used as \
one ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1920be07-309e-44b2-a3a8-d6249f547ff6"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3e0b3849-8558-45ab-bebb-4d005c8fc1d7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VolumeGrowthObservables"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["rmin", "TI"], ",", " ", 
      StyleBox["rmax", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd7bc735-a1e8-49b4-a338-56f75ffd7db0"],
 "\[LineSeparator]",
 "fits over the given window of radii; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8155e0b2-a627-4de2-a5c7-5b5fb5316ce9"],
 " fits every radius, ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5713981f-f010-46ba-b4f8-b2f9139c0a7c"],
 " chooses the window.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d3a7bb16-1d47-41c2-abda-8ffd9da592e2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["VolumeGrowthObservables"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v1", "TI"], ",", " ", 
      StyleBox["v2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    "\[Ellipsis]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4562e1fe-52cc-47ab-81c3-432331a804d5"],
 "\[LineSeparator]",
 "gives one ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2616212-3217-4f50-b249-b42949466f03"],
 " per vertex; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38f292bf-6865-4bbb-aba4-6d339d5537c0"],
 " takes every vertex."
}], "Usage",ExpressionUUID->"ca941a79-1e97-4ab0-a1b7-15b1aa7b1314"],

Cell[TextData[{
 "Definition: at ",
 StyleBox["v", "TI"],
 " the ball probe regresses the log-difference quotient of the ball volumes, \
and the sphere probe that of the shell areas, on ",
 StyleBox["r(r + 1)", "TI"],
 " by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DimensionCurvatureFit"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f9840d50-3463-46e3-9fae-e622e622054a"],
 ". The ball reads ",
 StyleBox["d", "TI"],
 " from the intercept and ",
 StyleBox["R", "TI"],
 " = \[Minus]3(",
 StyleBox["d", "TI"],
 " + 2) times the slope; the sphere reads ",
 StyleBox["d", "TI"],
 " \[Minus] 1 from the intercept and ",
 StyleBox["R", "TI"],
 " = \[Minus]3",
 StyleBox["d", "TI"],
 " times the slope."
}], "Notes",ExpressionUUID->"c90d6f3e-bbbe-4e9a-84aa-0a5e856aec56"],

Cell[TextData[{
 "The two probes measure the same pair independently, since ",
 StyleBox["Vol B_r \[Proportional] r^d (1 \[Minus] R r\.b2 / (6(d + 2)))", 
  "TI"],
 " while ",
 StyleBox["Area S_r \[Proportional] r^(d\[Minus]1) (1 \[Minus] R r\.b2 / \
(6d))", "TI"],
 ". Their agreement is the check that the substrate behaves like a manifold \
near ",
 StyleBox["v", "TI"],
 "; where they disagree, trust the sphere, since the ball accumulates the \
small-radius artefacts."
}], "Notes",ExpressionUUID->"9f5e50ee-0884-4960-9a17-8edf99fb46e4"],

Cell[TextData[{
 "The quotient is affine in ",
 StyleBox["r(r + 1)", "TI"],
 " only over a middle window: at small radius it carries the discretisation, \
and past the peak of the shell count the ball fills the graph instead of \
growing. The ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9439023c-c2de-42f8-be83-f33d02913a0b"],
 " window is the longest run of radii up to that peak whose least-squares \
residual stays within twice the noise floor. The windows used are reported."
}], "Notes",ExpressionUUID->"c97cacb7-0ccc-45c3-b56e-bc648f0e9256"],

Cell["The keys of the result:", "Notes",ExpressionUUID->"ec3b2180-46aa-44af-addf-3181f123a360"],

