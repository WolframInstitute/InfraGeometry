Cell[TextData[{
 "The profiles in the result are the ",
 Cell[BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "944d25a8-d455-42ea-87c3-69a3b3765e87"],
 " of the balls and the ",
 Cell[BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "152c7a8e-e0fc-48c5-971d-912d5eb67866"],
 " of the shells, read at every radius."
}], "ExampleText",ExpressionUUID->"089e8479-32b6-499d-aea4-4277430ed2bf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ctr", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"obs", " ", "=", " ", 
     RowBox[{"VolumeGrowthObservables", "[", 
      RowBox[{"g", ",", " ", "ctr"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"obs", "[", "\"\<BallVolumes\>\"", "]"}], ",", " ", 
         RowBox[{"obs", "[", "\"\<ShellAreas\>\"", "]"}]}], "}"}], ",", " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<ball\>\"", ",", " ", "\"\<shell\>\""}], "}"}]}], ",", 
       " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<r + 1\>\"", ",", " ", "None"}], "}"}]}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"obs", "[", "\"\<BallVolumes\>\"", "]"}], " ", "===", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraBall", "[", 
             RowBox[{"ctr", ",", " ", "r"}], "]"}], ",", 
            " ", "\"\<RiemannianMeasure\>\""}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "0", ",", " ", 
            RowBox[{
             RowBox[{"Length", " ", "@", " ", 
              RowBox[{"obs", "[", "\"\<BallVolumes\>\"", "]"}]}], " ", "-", 
             " ", "1"}]}], "}"}]}], "]"}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"obs", "[", "\"\<ShellAreas\>\"", "]"}], " ", "===", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraShell", "[", 
             RowBox[{"ctr", ",", " ", "r"}], "]"}], ",", 
            " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "0", ",", " ", 
            RowBox[{
             RowBox[{"Length", " ", "@", " ", 
              RowBox[{"obs", "[", "\"\<ShellAreas\>\"", "]"}]}], " ", "-", 
             " ", "1"}]}], "}"}]}], "]"}]}]}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"721d946b-9664-43e6-af95-285d136baeb4"],

