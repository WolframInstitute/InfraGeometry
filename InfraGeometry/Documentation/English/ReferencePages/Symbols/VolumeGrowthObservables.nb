          RowBox[{"InfraCenter", "[", "gr", "]"}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"quots", " ", "=", " ", 
         RowBox[{"obs", "[", "\"\<BallLogDifferenceQuotients\>\"", "]"}]}], ",",
         " ", 
        RowBox[{"win", " ", "=", " ", 
         RowBox[{"obs", "[", "\"\<BallWindow\>\"", "]"}]}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"scatter", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"rad", " ", 
             RowBox[{"(", 
              RowBox[{"rad", " ", "+", " ", "1"}], ")"}]}], ",", " ", 
            RowBox[{"quots", "[", 
             RowBox[{"[", "rad", "]"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"rad", ",", " ", 
            RowBox[{"Length", " ", "@", " ", "quots"}]}], "}"}]}], "]"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"Show", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"scatter", ",", " ", 
            RowBox[{"scatter", "[", 
