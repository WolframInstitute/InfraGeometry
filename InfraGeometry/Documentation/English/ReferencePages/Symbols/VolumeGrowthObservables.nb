      FontSize->0.9 Inherited,ExpressionUUID->
      "51273dc8-9ad9-4a01-a703-e92d413e2ba0"]
    }], "TableText",ExpressionUUID->"6807b133-4004-4575-b81d-33efe27586b5"], 
