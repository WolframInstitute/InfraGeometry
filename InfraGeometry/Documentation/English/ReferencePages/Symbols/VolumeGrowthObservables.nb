Cell[TextData[{
 "The profiles in the result are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallVolumes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallVolumes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e92c9612-63bc-4d4b-81f0-2837a1f0549e"],
 " under the half-boundary measure and of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ShellAreas"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ShellAreas", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "545e4ab7-34ba-4c92-9a35-a93bc4818f63"],
 " under the full count."
}], "ExampleText",ExpressionUUID->"17225579-4fce-452e-8adc-5304ff1111a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ctr", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"obs", " ", "=", " ", 
       RowBox[{"VolumeGrowthObservables", "[", 
        RowBox[{"g", ",", " ", "ctr"}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"obs", "[", "\"\<BallVolumes\>\"", "]"}], " ", "===", " ", 
        RowBox[{"BallVolumes", "[", 
         RowBox[{"g", ",", " ", "ctr", ",", " ", 
          
          RowBox[{"\"\<Measure\>\"", " ", "->", 
           " ", "\"\<HalfBoundary\>\""}]}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"obs", "[", "\"\<ShellAreas\>\"", "]"}], " ", "===", " ", 
        RowBox[{"ShellAreas", "[", 
         RowBox[{"g", ",", " ", "ctr"}], "]"}]}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d94eacb8-05e6-42d1-8ab9-79b8fbd2cc8d"],

