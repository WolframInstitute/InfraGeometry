Cell[TextData[{
 "Ball quotients against ",
 StyleBox["r(r + 1)", "TI"],
 " at the centre of the discretized plane, the square tiling and the \
hexagonal tiling, the fitted window in orange, and the fitted line. All three \
read dimension 2 and curvature close to 0."
}], "ExampleText",ExpressionUUID->"ae3bb832-b42d-4676-89df-a0c52c9a0a44"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"gr", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"nm", ",", " ", "\"\<Large\>\""}], "]"}]}], "}"}], ",", "\n",
       "    ", 
      RowBox[{"{", 
       RowBox[{"obs", " ", "=", " ", 
        RowBox[{"VolumeGrowthObservables", "[", 
