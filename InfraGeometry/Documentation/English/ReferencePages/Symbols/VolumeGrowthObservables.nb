Cell["\<\
The four fitted numbers and the two windows on the same substrates.\
\>", "ExampleText",ExpressionUUID->"017f026d-71db-43ee-a254-3da3ce3ceee2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Dataset", " ", "@", " ", 
  RowBox[{"AssociationMap", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"gr", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"#", ",", " ", "\"\<Large\>\""}], "]"}]}], "}"}], ",", "\n",
        "    ", 
       RowBox[{"KeyTake", "[", 
        RowBox[{
         RowBox[{"VolumeGrowthObservables", "[", 
          RowBox[{"gr", ",", " ", 
           RowBox[{"InfraCenter", "[", "gr", "]"}]}], "]"}], ",", "\n", 
         "      ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<BallDimension\>\"", ",", " ", "\"\<SphereDimension\>\"",
            ",", " ", "\"\<BallScalarCurvature\>\"", ",", 
           " ", "\"\<SphereScalarCurvature\>\"", ",", 
           " ", "\"\<BallWindow\>\"", ",", " ", "\"\<SphereWindow\>\""}], 
          "}"}]}], "]"}]}], "]"}], " ", "&"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
       ",", " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"bce78724-5bc7-4e60-b177-221db718a79f"],

