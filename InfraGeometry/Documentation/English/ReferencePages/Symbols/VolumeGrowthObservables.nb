Cell["\<\
The ball probe on the flat 15 \[Times] 15 grid under three measures; the \
sphere probe, on the full shell count, is the same in all three.\
\>", "ExampleText",ExpressionUUID->"99597ade-27ab-4d99-ae0a-9eef66fcccd3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"m", " ", "->", " ", 
     RowBox[{"KeyTake", "[", 
      RowBox[{
       RowBox[{"VolumeGrowthObservables", "[", 
        RowBox[{
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"15", ",", " ", "15"}], "}"}], "]"}], ",", " ", "113", ",",
          " ", 
         RowBox[{"\"\<Measure\>\"", " ", "->", " ", "m"}]}], "]"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"\"\<BallDimension\>\"", ",", 
         " ", "\"\<SphereDimension\>\""}], "}"}]}], "]"}]}], " ", "//", " ", 
    "Normal"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"m", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<FullCount\>\"", ",", " ", "\"\<WithoutBoundary\>\"", ",", 
       " ", "\"\<HalfBoundary\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"62f9bda6-30f1-41d1-9da3-1840bf4249d9"],

