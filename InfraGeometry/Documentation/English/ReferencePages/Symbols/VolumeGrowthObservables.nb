Cell["\<\
The ball probe on the flat 15 \[Times] 15 grid under three measures; the \
sphere probe, on the full shell count, is the same in all three.\
\>", "ExampleText",ExpressionUUID->"09ff2ee9-b8b7-46c6-871d-25607a4e065e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"m", " ", "->", " ", 
     RowBox[{"KeyTake", "[", 
      RowBox[{
       RowBox[{"VolumeGrowthObservables", "[", 
        RowBox[{
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"15", ",", " ", "15"}], "}"}], "]"}], ",", " ", "113", ",",
          " ", 
         RowBox[{"\"\<Measure\>\"", " ", "->", " ", "m"}]}], "]"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"\"\<BallDimension\>\"", ",", 
         " ", "\"\<SphereDimension\>\""}], "}"}]}], "]"}]}], " ", "//", " ", 
    "Normal"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"m", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<FullCount\>\"", ",", " ", "\"\<WithoutBoundary\>\"", ",", 
       " ", "\"\<HalfBoundary\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d4904f79-3f41-472c-8f9b-5127d79f30ea"],

