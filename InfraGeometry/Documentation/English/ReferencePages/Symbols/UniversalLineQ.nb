Cell["\<\
On the 3 \[Times] 4 grid the line through two adjacent vertices, or through \
opposite corners, is universal; the line through two vertices on a short \
diagonal is not:\
\>", "ExampleText",ExpressionUUID->"dd088ec8-a1d9-472c-b3b4-80bc25f56570"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"UniversalLineQ", "[", 
      RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"5", ",", " ", "8"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "12"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "5"}], "}"}]}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6ed2a756-8e52-4baf-80c8-0537f2b7f3ef"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e636dfa2-ef20-4064-a850-b7881b787a36"]
}, Open  ]],

Cell["\<\
The pairs that span a universal line, drawn as edges: the 17 edges of the \
grid and the two long diagonals, 19 of the 66 pairs:\
\>", "ExampleText",ExpressionUUID->"6f474541-db8b-40cd-b2ca-2c4261d93b9a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"pairs", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Subsets", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"UniversalLineQ", "[", 
         RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"Graph", "[", 
    RowBox[{
     RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
     RowBox[{"UndirectedEdge", " ", "@@@", " ", "pairs"}], ",", " ", 
     RowBox[{"VertexCoordinates", " ", "->", " ", 
      RowBox[{"GraphEmbedding", "[", "g", "]"}]}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Length", "[", "pairs", "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0cd6378e-b6d4-4b1d-a149-be735cb48622"],

