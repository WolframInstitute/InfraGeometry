Cell["\<\
On the 3 \[Times] 4 grid the line through two adjacent vertices, or through \
opposite corners, is universal; the line through two vertices on a short \
diagonal is not:\
\>", "ExampleText",ExpressionUUID->"fef08815-8856-43c8-a67a-420d74adf7d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"UniversalLineQ", "[", 
      RowBox[{"g", ",", " ", "p"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"5", ",", " ", "8"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "12"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "5"}], "}"}]}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7c0ad19b-1062-4196-8acc-c52373bf8038"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"04c1a2c5-2fcc-4090-9d96-be3627ec574a"]
}, Open  ]],

Cell["\<\
The pairs that span a universal line, drawn as edges: the 17 edges of the \
grid and the two long diagonals, 19 of the 66 pairs:\
\>", "ExampleText",ExpressionUUID->"1fd5b929-8e9a-4ef5-9ae2-5344e24ebde4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"pairs", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Subsets", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"UniversalLineQ", "[", 
         RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"Graph", "[", 
    RowBox[{
     RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
     RowBox[{"UndirectedEdge", " ", "@@@", " ", "pairs"}], ",", " ", 
     RowBox[{"VertexCoordinates", " ", "->", " ", 
      RowBox[{"GraphEmbedding", "[", "g", "]"}]}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Length", "[", "pairs", "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"037c6895-8495-4d25-8d40-ddfc3d75dc2f"],

