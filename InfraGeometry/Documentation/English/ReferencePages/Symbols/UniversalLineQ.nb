Cell["\<\
Which small graphs have a universal line. Two antipodal vertices of an even \
cycle span one, and so do the centre and a leaf of a star; an odd cycle, the \
Petersen graph and a complete graph have none:\
\>", "ExampleText",ExpressionUUID->"4ccc47d8-bec8-44e7-9783-461459691b4c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"UniversalLineQ", " ", "/@", " ", 
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<C5\>\"", " ", "->", " ", 
     RowBox[{"CycleGraph", "[", "5", "]"}]}], ",", " ", 
    RowBox[{"\"\<C6\>\"", " ", "->", " ", 
     RowBox[{"CycleGraph", "[", "6", "]"}]}], ",", " ", 
    RowBox[{"\"\<Petersen\>\"", " ", "->", " ", 
     RowBox[{"PetersenGraph", "[", "]"}]}], ",", "\n", "  ", 
    RowBox[{"\"\<K4\>\"", " ", "->", " ", 
     RowBox[{"CompleteGraph", "[", "4", "]"}]}], ",", " ", 
    RowBox[{"\"\<star\>\"", " ", "->", " ", 
     RowBox[{"StarGraph", "[", "5", "]"}]}]}], "|>"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3ce9cb71-dded-430a-b7a9-d3fcb9645c06"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"C5\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"C6\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"Petersen\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"K4\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"star\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"def9f836-33b9-4584-adce-79ca07987c13"]
}, Open  ]],

