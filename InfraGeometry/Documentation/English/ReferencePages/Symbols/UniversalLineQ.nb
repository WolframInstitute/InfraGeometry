Notebook[{

Cell[CellGroupData[{
Cell["UniversalLineQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"64b7cc2f-15ca-4f72-b141-54c6b74ba261"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["UniversalLineQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/UniversalLineQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["u", "TI"], ",", " ", 
      StyleBox["v", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cbeed62d-29c1-49d8-8b59-8bc34f26027c"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "779c8238-e39a-4ff5-bf11-0716589cf06d"],
 " if the line through ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " is the whole connected component of ",
 StyleBox["g", "TI"],
 " containing them.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"9b1b529e-eae6-445e-a585-bf1f46bd85c8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["UniversalLineQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/UniversalLineQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c15a5292-d32f-481c-8eef-9733eabf932d"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f03f031f-60d0-4031-a2f7-7af2ee3635fd"],
 " if some two vertices of ",
 StyleBox["g", "TI"],
 " span such a universal line."
}], "Usage",ExpressionUUID->"17e3236b-f200-4604-bd8b-405d11ae8635"],

Cell[TextData[{
 "The line through ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " is the set of the vertices ",
 StyleBox["w", "TI"],
 " such that one of ",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["w", "TI"],
 " lies between the other two: ",
 StyleBox["d(u, w) + d(w, v) = d(u, v)", "TI"],
 ", ",
 StyleBox["d(w, u) + d(u, v) = d(w, v)", "TI"],
 " or ",
 StyleBox["d(u, v) + d(v, w) = d(u, w)", "TI"],
 ". It is the union of the maximal geodesics through ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"5ca0d584-19ba-4838-9ca7-30973cf9d646"],

Cell[TextData[{
 "In the plane a line through two points misses almost every point. In a \
graph a line can contain every vertex; it is then universal. On a full grid \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GridGraph"]], "paclet:ref/GridGraph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e9644867-0649-40a9-abc6-46b1cafb3e20"],
 " the line through any two adjacent vertices is universal."
}], "Notes",ExpressionUUID->"928747f8-7979-4b60-bd3e-5b472570038c"],

Cell[TextData[{
 "Chen and Chv\[AAcute]tal conjectured that a metric space on ",
 StyleBox["n", "TI"],
 " points with no universal line has at least ",
 StyleBox["n", "TI"],
 " distinct lines, the metric form of the de Bruijn\[Dash]Erd\[ODoubleAcute]s \
theorem."
}], "Notes",ExpressionUUID->"ecbb3945-e562-44a0-ba98-706a22b88d3a"],

Cell[TextData[{
 "The test reads every maximal geodesic of ",
 StyleBox["g", "TI"],
 ", and is slow on graphs beyond a few dozen vertices."
}], "Notes",ExpressionUUID->"f77834a1-b450-45b7-a534-44880f3f9ca1"]
}, Open  ]],

