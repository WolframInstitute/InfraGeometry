Cell["\<\
Two fibers of three vertices, one with an edge and one without. The sizes are \
equal, the fibers are not isomorphic:\
\>", "ExampleText",ExpressionUUID->"016de74c-76d1-4d6e-be18-4e03fd95fb47"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"Graph", "[", 
        RowBox[{
         RowBox[{"Range", "[", "6", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", " ", "<->", " ", "2"}], ",", " ", 
           RowBox[{"3", " ", "<->", " ", "4"}]}], "}"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
