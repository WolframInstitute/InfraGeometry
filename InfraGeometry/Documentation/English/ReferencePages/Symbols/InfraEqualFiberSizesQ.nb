Cell[CellGroupData[{
Cell["InfraEqualFiberSizesQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ec4f848e-b88b-4fff-9422-8f71def43e18"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraEqualFiberSizesQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraEqualFiberSizesQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51aae4ba-bb57-4cea-936a-d5e681d65663"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "782c2b8e-7a24-4de8-bd68-a84992bdc0ff"],
 " if all fibers of ",
 StyleBox["fib", "TI"],
 " have the same number of vertices.",
 "\n"
}], "Usage",ExpressionUUID->"58b6c90d-1bf6-4ad9-baa1-5edc1630a35b"],

Cell[TextData[{
 "The condition is ",
 StyleBox["|F(p)| = |F(q)|", "TI"],
 " for all base vertices ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ", also when they lie in different components of the base."
}], "Notes",ExpressionUUID->"f0bde4f1-a980-4b45-9d73-c2e6026b5dcf"],

Cell[TextData[{
 "Only sizes are compared. Fibers of equal size can have different edges; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIsomorphicFibersQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIsomorphicFibersQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "000d22f5-92a5-443e-8e61-8e04f38f4151"],
 " compares the fibers as graphs."
}], "Notes",ExpressionUUID->"85d48e36-8626-4715-b09b-98b78593daca"],

Cell["\<\
Unique edge lifting matches the fibers over the two ends of every base edge, \
so it gives equal sizes on each connected component of the base, not across \
components.\
\>", "Notes",ExpressionUUID->"7bdf0db2-654a-4891-9193-b65794e3794c"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDisplacementBundle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11d79551-2f8d-42b8-80d3-1e281d313887"],
 " the fiber over ",
 StyleBox["p", "TI"],
 " is the sphere of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["p", "TI"],
 ". The sizes are equal when all spheres of radius ",
 StyleBox["r", "TI"],
 " have the same size, as on the square torus; on the square grid they are \
not."
}], "Notes",ExpressionUUID->"ca014f5c-0827-4df5-9f35-905a6fee3f07"],

Cell[TextData[{
 "The empty fibered graph has equal fiber sizes. A list of objects gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "afc55228-0178-408b-bffe-e3adbf02af69"],
 " when every member does; the empty list gives ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "654c93d1-0b63-47b7-813a-9a31230cd84a"],
 "."
}], "Notes",ExpressionUUID->"54d0cafa-37c0-4817-adc1-0f1cd30d4c20"]
}, Open  ]],

