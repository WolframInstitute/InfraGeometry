         RowBox[{"5", " ", "->", " ", "\"\<q\>\""}], ",", " ", 
         RowBox[{"6", " ", "->", " ", "\"\<q\>\""}]}], "|>"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraEqualFiberSizesQ", "[", "fib", "]"}], ",", " ", 
        RowBox[{"InfraIsomorphicFibersQ", "[", "fib", "]"}]}], "}"}]}], ",", 
     "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9c023f37-0ba2-44ed-8a6c-307302eb6b36"],

