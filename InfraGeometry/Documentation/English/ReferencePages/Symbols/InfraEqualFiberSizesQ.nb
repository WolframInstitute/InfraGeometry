Notebook[{

Cell[CellGroupData[{
Cell["InfraEqualFiberSizesQ", "ObjectName",ExpressionUUID->"b87c6f5f-6bd3-4099-9a75-6c2d7f22ca95"],

Cell["LLM generated.", "Notes",ExpressionUUID->"c7a48046-7552-4899-a8e8-928d5c3f5600"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9db381e2-1e9b-4b35-8f20-222598f198b9"],
 Cell[BoxData[
  RowBox[{"InfraEqualFiberSizesQ", "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed73fa2f-9b81-406b-8efb-bcd9b648a5ab"],
 "\[LineSeparator]",
 "tests whether all fibers of ",
 StyleBox["fib", "TI"],
 " have the same number of vertices.",
 "\n"
}], "Usage",ExpressionUUID->"3c89bb00-6afa-40c4-af7b-3ee82f7b4042"],

Cell["\<\
Equality is required across the whole reconstructed base, including different \
connected components.\
\>", "Notes",ExpressionUUID->"2a0773ad-e0c4-42e3-b49c-519996e3f994"],

Cell["\<\
Equal cardinalities do not require isomorphic fiber graphs or a complete \
connection.\
\>", "Notes",ExpressionUUID->"61b5fed2-7a4f-4068-be9c-820dda4c41c8"],

Cell["\<\
Isomorphic fibers imply equal sizes. Unique edge lifting implies equal sizes \
within each connected base component only.\
\>", "Notes",ExpressionUUID->"e67772fd-ccdf-4af2-91c4-e17bab6e84d5"],

Cell["The empty fibered graph satisfies the condition vacuously.", "Notes",ExpressionUUID->"13afbda8-d6b3-4a83-b30e-54327bf5def0"],

Cell["\<\
A nonempty list is tested by conjunction; an empty list gives False. \
Unsupported inputs remain unevaluated.\
\>", "Notes",ExpressionUUID->"224fc1c2-bd42-4535-8d55-43f30b803e9f"]
}, Open  ]],

