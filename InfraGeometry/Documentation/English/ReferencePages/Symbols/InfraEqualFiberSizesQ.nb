Cell[TextData[{
 "The fiber sizes of the displacement bundle at ",
 StyleBox["r", "TI"],
 " = 3, drawn on the base. They vary on the square grid and are all 12 on the \
square torus:"
}], "ExampleText",ExpressionUUID->"4ef54d51-9d1f-4b60-bf7c-c6b29868d071"],

