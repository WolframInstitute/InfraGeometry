Notebook[{

Cell[CellGroupData[{
Cell["InfraEqualFiberSizesQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9927e1c4-82c3-41c3-8f9c-ad5e56a96d15"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraEqualFiberSizesQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraEqualFiberSizesQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c4dc9f80-5ce8-417f-a341-81175960be36"],
 "\[LineSeparator]",
 "tests whether all fibers of ",
 StyleBox["fib", "TI"],
 " have the same number of vertices.",
 "\n"
}], "Usage",ExpressionUUID->"b9fbc7f5-a5c2-4679-9e3c-20cc4e1865b4"],

Cell["\<\
Equality is required across the whole reconstructed base, including different \
connected components.\
\>", "Notes",ExpressionUUID->"a658a92a-bc70-4d4f-832b-b3bca4f6c4d7"],

Cell["\<\
Equal cardinalities do not require isomorphic fiber graphs or a complete \
connection.\
\>", "Notes",ExpressionUUID->"82b70f7e-bb11-412e-9030-6a98ccdf1748"],

Cell["\<\
Isomorphic fibers imply equal sizes. Unique edge lifting implies equal sizes \
within each connected base component only.\
\>", "Notes",ExpressionUUID->"a066650b-1f50-491a-b33c-4affe6a243ef"],

Cell["The empty fibered graph satisfies the condition vacuously.", "Notes",ExpressionUUID->"7277a571-a27a-415c-afb7-7dc99104f3fa"],

Cell["\<\
A nonempty list is tested by conjunction; an empty list gives False. \
Unsupported inputs remain unevaluated.\
\>", "Notes",ExpressionUUID->"e6162e91-f109-4a79-94e6-f1501c5fbec8"]
}, Open  ]],

