Cell["\<\
A covering with two sheets over the square and one sheet over the triangle. \
Each component has equal sizes, the whole does not:\
\>", "ExampleText",ExpressionUUID->"79b2b42d-cfa9-49d0-8205-52623ebacf3b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GraphDisjointUnion", "[", 
        RowBox[{
         RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
         RowBox[{"CycleGraph", "[", "3", "]"}]}], "]"}], ",", "\n", "    ", 
       RowBox[{"v", " ", "|->", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"v", " ", "<=", " ", "8"}], ",", " ", 
          RowBox[{"Mod", "[", 
           RowBox[{"v", ",", " ", "4", ",", " ", "1"}], "]"}], ",", " ", 
          "v"}], "]"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"VertexCount", " ", "/@", " ", 
      RowBox[{"InfraFibers", "[", "fib", "]"}]}], ",", " ", 
     RowBox[{"InfraCoveringQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraEqualFiberSizesQ", "[", "fib", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b172570d-a539-4686-b508-2befabc50f6b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"1", "\[Rule]", "2"}], ",", 
     RowBox[{"2", "\[Rule]", "2"}], ",", 
     RowBox[{"3", "\[Rule]", "2"}], ",", 
     RowBox[{"4", "\[Rule]", "2"}], ",", 
     RowBox[{"9", "\[Rule]", "1"}], ",", 
     RowBox[{"10", "\[Rule]", "1"}], ",", 
     RowBox[{"11", "\[Rule]", "1"}]}], "\[RightAssociation]"}], ",", "True", ",",
    "False"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f4967265-04ed-4aa8-ae1b-8272ff2211a5"]
}, Open  ]]
