The two isolated total vertices have zero lifts over the existing base edge.\
\>", "ExampleText",ExpressionUUID->"95664837-b8d1-49a4-886d-0ebab0c14129"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"Graph", "[", " ", 
        RowBox[{
         RowBox[{"Range", "[", " ", "4", " ", "]"}], ",", " ", 
         RowBox[{"{", " ", 
          RowBox[{"UndirectedEdge", "[", " ", 
           RowBox[{"1", ",", " ", "3"}], " ", "]"}], " ", "}"}]}], " ", "]"}],
        ",", " ", 
       RowBox[{"<|", " ", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<q\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<q\>\""}]}], " ", "|>"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", " ", "fib", " ", "]"}], ",", 
     " ", 
     RowBox[{"InfraEdgeLiftMultiplicity", "[", " ", "fib", " ", "]"}]}], " ", 
    "}"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"40974bc7-bb7f-4450-9e19-c95ca246a40e"],

