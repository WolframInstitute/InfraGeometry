Cell[CellGroupData[{
Cell["InfraEdgeLiftMultiplicity", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"895387db-e039-4865-a436-0c6eb80ab5fc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraEdgeLiftMultiplicity"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraEdgeLiftMultiplicity", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e32f6b82-d536-45c6-801b-99bdec749e4e"],
 "\[LineSeparator]",
 "gives, for each total vertex ",
 StyleBox["x", "TI"],
 ", the association from each base neighbour ",
 StyleBox["q", "TI"],
 " of ",
 StyleBox["\[Pi](x)", "TI"],
 " to the number of neighbours of ",
 StyleBox["x", "TI"],
 " over ",
 StyleBox["q", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"37b1b7e1-df8c-47ed-8ccc-3447d2666414"],

Cell[TextData[{
 "The multiplicity is ",
 StyleBox["m(x, q) = |N(x) \:2229 F(q)|", "TI"],
 ", for every ",
 StyleBox["q", "TI"],
 " adjacent to ",
 StyleBox["\[Pi](x)", "TI"],
 " in the base. It counts the lifts at ",
 StyleBox["x", "TI"],
 " of the base edge ",
 StyleBox["\[Pi](x) q", "TI"],
 "."
}], "Notes",ExpressionUUID->"350f3feb-2828-4bd9-8030-c7ab4f48206d"],

Cell[TextData[{
 "Zero counts are kept: a zero is a base edge with no lift at ",
 StyleBox["x", "TI"],
 ". Vertical neighbours are not counted. A vertex over an isolated base \
vertex has an empty association."
}], "Notes",ExpressionUUID->"dc7da147-5ae9-49cd-85f3-372a3771b63c"],

Cell["The lifting conditions read off the multiplicities:", "Notes",ExpressionUUID->"4c49257b-c05e-411a-ae25-8f8719cec11c"],

