Cell["\<\
In the displacement bundle of the square grid, the step from the centre to \
its upper neighbour has one lift backwards, two sideways and four forwards:\
\>", "ExampleText",ExpressionUUID->"7705dc11-9080-4a40-9e94-1eaf84b3713e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"m", " ", "=", " ", 
     RowBox[{
      RowBox[{"InfraEdgeLiftMultiplicity", "[", 
       RowBox[{"InfraDisplacementBundle", "[", 
        RowBox[{"g", ",", " ", "1"}], "]"}], "]"}], "[", 
      RowBox[{"{", 
       RowBox[{"c", ",", " ", 
        RowBox[{"c", " ", "+", " ", "1"}]}], "}"}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraWalk", "[", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", 
          RowBox[{"c", " ", "+", " ", "1"}]}], "}"}], "]"}], ",", " ", "m"}], 
      "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", "m"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0526cbae-bd5a-4fa3-9e7e-8877e6d5f461"],

