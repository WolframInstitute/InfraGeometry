Cell[CellGroupData[{
Cell["InfraEdgeLiftMultiplicity", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"19bed134-f989-4fd7-9ef7-aae4b427e9ca"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraEdgeLiftMultiplicity"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraEdgeLiftMultiplicity", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32ab5bb9-70e8-458b-8b90-667d51eb5209"],
 "\[LineSeparator]",
 "gives the numbers of transverse neighbours as a nested association from \
each total vertex to each adjacent base vertex.",
 "\n"
}], "Usage",ExpressionUUID->"698298bb-da80-4215-aa06-1086cfca3343"],

Cell[TextData[{
 "For a total vertex ",
 StyleBox["x", "TI"],
 " over ",
 StyleBox["p", "TI"],
 ", the inner association has one key ",
 StyleBox["q", "TI"],
 " for every neighbour of ",
 StyleBox["p", "TI"],
 " in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBaseSpace"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBaseSpace", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bff6b2b7-e06b-4bfd-868d-9318c85d25c8"],
 ". Its value counts neighbours of ",
 StyleBox["x", "TI"],
 " in the fiber over ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"d4b24683-1482-4ea1-a259-a256ada4d512"],

Cell["\<\
Zero counts are included. They record a missing lift over an existing base \
edge.\
\>", "Notes",ExpressionUUID->"1a95348c-038c-4ff1-b8f5-a928d7b542a3"],

Cell["\<\
Vertical neighbours are not counted. A vertex over an isolated base vertex \
has an empty inner association.\
\>", "Notes",ExpressionUUID->"7a64369e-1458-4e4a-a7a0-eaaf1dd8be3d"],

Cell["The empty fibered graph gives an empty outer association.", "Notes",ExpressionUUID->"73d638d5-5ee2-4b30-9397-0afd6354659c"],

Cell[TextData[{
 "All counts positive is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibrationQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1cd35e7d-b6d3-4f5d-9c58-063124cc9b00"],
 ". All counts at most one is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraAtMostOneEdgeLiftQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraAtMostOneEdgeLiftQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "22c4e420-8834-4d88-82a2-88fee578bf0f"],
 ". All counts one is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUniqueEdgeLiftingQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUniqueEdgeLiftingQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5b308348-57bb-445e-93c8-a1eb213ec40b"],
 "."
}], "Notes",ExpressionUUID->"2dd5ace2-9bad-4870-a388-40e86b237e8c"],

Cell["\<\
Constant inner associations within each fiber express transverse equitable \
multiplicity. A full equitable partition additionally requires constant \
vertical degree within each fiber.\
\>", "Notes",ExpressionUUID->"4f8389d2-1c03-4022-9e67-9b153b5286fd"],

Cell["\<\
The reader consumes no random draws. Unsupported objects remain unevaluated.\
\>", "Notes",ExpressionUUID->"2830fc5b-2ad8-4e57-88c4-faf21bb20d44"]
}, Open  ]],

