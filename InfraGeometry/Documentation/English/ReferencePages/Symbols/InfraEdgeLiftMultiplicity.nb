      RowBox[{"{", "3", "}"}]}], ",", 
     RowBox[{"\<\"HorizontalEdgeCount\"\>", "\[Rule]", "All"}]}], "]"}], ",", 
   
   RowBox[{"{", 
    RowBox[{"InfraEdgeLiftMultiplicity", "[", 
     RowBox[{"Total", "[", 
      RowBox[{"Values", "[", 
       RowBox[{"RandomInfraFiberedGraph", "[", 
        RowBox[{
         GraphicsBox[
          NamespaceBox["NetworkGraphics",
           DynamicModuleBox[{Typeset`graph = HoldComplete[
