Cell["\<\
The two isolated total vertices have zero lifts over the existing base edge.\
\>", "ExampleText",ExpressionUUID->"14bab9a0-341b-49d3-87eb-33d03febf103"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"Graph", "[", " ", 
        RowBox[{
         RowBox[{"Range", "[", " ", "4", " ", "]"}], ",", " ", 
         RowBox[{"{", " ", 
          RowBox[{"UndirectedEdge", "[", " ", 
           RowBox[{"1", ",", " ", "3"}], " ", "]"}], " ", "}"}]}], " ", "]"}],
        ",", " ", 
       RowBox[{"<|", " ", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<q\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<q\>\""}]}], " ", "|>"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", " ", "fib", " ", "]"}], ",", 
     " ", 
     RowBox[{"InfraEdgeLiftMultiplicity", "[", " ", "fib", " ", "]"}]}], " ", 
    "}"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a1245681-4575-4917-813f-45ba17cc358b"],

