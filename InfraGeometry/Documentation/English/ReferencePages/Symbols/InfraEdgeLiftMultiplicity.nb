Cell[CellGroupData[{
Cell["InfraEdgeLiftMultiplicity", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"10d11f7a-d929-4400-9d00-83f20c5c5b59"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraEdgeLiftMultiplicity"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraEdgeLiftMultiplicity", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5762b070-27a8-49df-a0c6-858cd2cc569b"],
 "\[LineSeparator]",
 "gives the numbers of transverse neighbours as a nested association from \
each total vertex to each adjacent base vertex.",
 "\n"
}], "Usage",ExpressionUUID->"97e12a28-892a-4560-a794-cb28c568c8db"],

Cell[TextData[{
 "For a total vertex ",
 StyleBox["x", "TI"],
 " over ",
 StyleBox["p", "TI"],
 ", the inner association has one key ",
 StyleBox["q", "TI"],
 " for every neighbour of ",
 StyleBox["p", "TI"],
 " in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBaseSpace"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBaseSpace", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fafdd2e7-04a3-4a7f-88e7-6a011e6f2c53"],
 ". Its value counts neighbours of ",
 StyleBox["x", "TI"],
 " in the fiber over ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"66fa9dfc-f865-4caf-8c1a-699d211de235"],

Cell["\<\
Zero counts are included. They record a missing lift over an existing base \
edge.\
\>", "Notes",ExpressionUUID->"b68985b4-a913-47ec-bbe1-77203bd0a9d4"],

Cell["\<\
Vertical neighbours are not counted. A vertex over an isolated base vertex \
has an empty inner association.\
\>", "Notes",ExpressionUUID->"3586cc0c-675e-490e-92be-27675e417cc1"],

Cell["The empty fibered graph gives an empty outer association.", "Notes",ExpressionUUID->"81df6325-652a-408b-be1b-3d65df12efca"],

Cell[TextData[{
 "All counts positive is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibrationQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d41022b3-b10d-40bd-aa3e-0808ea900123"],
 ". All counts at most one is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraAtMostOneEdgeLiftQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraAtMostOneEdgeLiftQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b9956771-28de-4aac-b3d2-d697a698ad53"],
 ". All counts one is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUniqueEdgeLiftingQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUniqueEdgeLiftingQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "317dd6c1-e39c-4ca8-b2ad-f7fd238fbd92"],
 "."
}], "Notes",ExpressionUUID->"4ae1cfad-2cf0-4f82-846d-5fce7005c2ef"],

Cell["\<\
Constant inner associations within each fiber express transverse equitable \
multiplicity. A full equitable partition additionally requires constant \
vertical degree within each fiber.\
\>", "Notes",ExpressionUUID->"b18bfc70-ea89-4532-9b43-f792286a89a3"],

Cell["\<\
The reader consumes no random draws. Unsupported objects remain unevaluated.\
\>", "Notes",ExpressionUUID->"be0ee3f3-af56-4370-ad22-a56392f31e3a"]
}, Open  ]],

