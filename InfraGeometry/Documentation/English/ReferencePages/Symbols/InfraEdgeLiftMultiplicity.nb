Notebook[{

Cell[CellGroupData[{
Cell["InfraEdgeLiftMultiplicity", "ObjectName",ExpressionUUID->"e7128a01-c77e-4cdd-b5d2-39bad93dab0a"],

Cell["LLM generated.", "Notes",ExpressionUUID->"ece1c488-abcf-4736-bcac-6faccf45eee8"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0155e72e-42c8-4ca2-a462-67ab76f79862"],
 Cell[BoxData[
  RowBox[{"InfraEdgeLiftMultiplicity", "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8c57ec7-a8ca-4ba7-84b8-5d8abf185551"],
 "\[LineSeparator]",
 "gives the numbers of transverse neighbours as a nested association from \
each total vertex to each adjacent base vertex.",
 "\n"
}], "Usage",ExpressionUUID->"32776f65-86d2-4c82-8cee-2e09d556f065"],

Cell[TextData[{
 "For a total vertex ",
 StyleBox["x", "TI"],
 " over ",
 StyleBox["p", "TI"],
 ", the inner association has one key ",
 StyleBox["q", "TI"],
 " for every neighbour of ",
 StyleBox["p", "TI"],
 " in ",
 Cell[BoxData["InfraBaseSpace"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c80ad4a5-b3a2-4c05-8e7e-78c4955928ca"],
 ". Its value counts neighbours of ",
 StyleBox["x", "TI"],
 " in the fiber over ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"d1b6fa36-221e-4efe-9b5e-3201537cea68"],

Cell["\<\
Zero counts are included. They record a missing lift over an existing base \
edge.\
\>", "Notes",ExpressionUUID->"6909ff01-659b-4c09-8d56-703254f7dd1f"],

Cell["\<\
Vertical neighbours are not counted. A vertex over an isolated base vertex \
has an empty inner association.\
\>", "Notes",ExpressionUUID->"389920ff-9afa-4616-ae75-3a08918ddfc2"],

Cell["The empty fibered graph gives an empty outer association.", "Notes",ExpressionUUID->"5c3b085b-0c2b-4e2f-82e0-8642c10bdb78"],

Cell[TextData[{
 "All counts positive is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibrationQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibrationQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0c17dc63-0091-4634-8103-8dff2dfdff66"],
 ". All counts at most one is ",
 Cell[BoxData["InfraAtMostOneEdgeLiftQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ff5347d-49e1-44d9-8451-0aadd957ec4e"],
 ". All counts one is ",
 Cell[BoxData["InfraUniqueEdgeLiftingQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35f54160-65f1-4c16-9b54-3f203f9783c1"],
 "."
}], "Notes",ExpressionUUID->"b33b43a1-f030-48e7-972b-d9049fd8b4dd"],

Cell["\<\
Constant inner associations within each fiber express transverse equitable \
multiplicity. A full equitable partition additionally requires constant \
vertical degree within each fiber.\
\>", "Notes",ExpressionUUID->"052fb5c6-757c-4c5a-860c-aefcc47d9aaf"],

Cell["\<\
The reader consumes no random draws. Unsupported objects remain unevaluated.\
\>", "Notes",ExpressionUUID->"5f8b47ca-a43f-467e-81b0-fd60a2147140"]
}, Open  ]],

