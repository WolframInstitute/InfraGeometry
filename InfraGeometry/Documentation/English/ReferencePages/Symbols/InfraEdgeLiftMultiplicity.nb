Cell["\<\
Complete joins between equal fibers have constant transverse multiplicity.\
\>", "ExampleText",ExpressionUUID->"8d999068-a3e5-4ece-a3ce-c6a79ed94d04"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "3", " ", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"multiplicities", " ", "=", " ", 
     RowBox[{"InfraEdgeLiftMultiplicity", "[", " ", "fib", " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", " ", 
      RowBox[{"Map", "[", " ", 
       RowBox[{
        RowBox[{"counts", " ", "|->", " ", 
         RowBox[{"Total", " ", "@", " ", 
          RowBox[{"Values", "[", " ", "counts", " ", "]"}]}]}], ",", " ", 
        "multiplicities"}], " ", "]"}], " ", "}"}]}], " ", "]"}]}], " ", 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0d26db81-f32e-44c2-8430-1ca09463d06e"],

