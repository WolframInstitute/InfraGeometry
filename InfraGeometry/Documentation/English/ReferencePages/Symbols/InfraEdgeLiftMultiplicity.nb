Cell["\<\
The branched fibration joins adjacent fibers completely, so a multiplicity is \
the size of the neighbouring fiber, 1 or 2. All are positive, so it is a \
fibration:\
\>", "ExampleText",ExpressionUUID->"f9172118-35f3-4be9-94f8-0bd63d050099"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<BranchedGridFibration\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"m", " ", "=", " ", 
     RowBox[{"InfraEdgeLiftMultiplicity", "[", "fib", "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m", "[", 
      RowBox[{"{", 
