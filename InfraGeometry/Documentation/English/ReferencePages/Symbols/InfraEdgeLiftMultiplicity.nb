Cell["\<\
Complete joins between equal fibers have constant transverse multiplicity.\
\>", "ExampleText",ExpressionUUID->"464f6c73-9296-4a45-95c7-81fb97249c28"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "3", " ", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"multiplicities", " ", "=", " ", 
     RowBox[{"InfraEdgeLiftMultiplicity", "[", " ", "fib", " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", " ", 
      RowBox[{"Map", "[", " ", 
       RowBox[{
        RowBox[{"counts", " ", "|->", " ", 
         RowBox[{"Total", " ", "@", " ", 
          RowBox[{"Values", "[", " ", "counts", " ", "]"}]}]}], ",", " ", 
        "multiplicities"}], " ", "]"}], " ", "}"}]}], " ", "]"}]}], " ", 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c1cfb2af-29c3-4f35-b2bc-3e8946703221"],

