  FontSize->0.9 Inherited,ExpressionUUID->
  "6e9b7e15-1afc-424e-ae93-644e0962beb0"],
 "\[LineSeparator]",
 "gives the directed acyclic graph whose paths from ",
 StyleBox["p", "TI"],
 " to a sink are exactly the rays from ",
 StyleBox["p", "TI"],
 " through ",
 StyleBox["q", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d6f8bbab-948c-4327-b8e5-b2ba1c1b1022"],
