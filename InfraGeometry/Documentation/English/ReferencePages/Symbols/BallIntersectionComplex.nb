Cell[CellGroupData[{

Cell["IntersectionTest", "ExampleSubsection",ExpressionUUID->"d53ae3bb-8063-4720-b788-9da89fbdacd5"],

Cell["\<\
At radius 0.6 the three disks about the triangle meet in a small region. \
Asking for a common region of area more than 0.05 drops the triangle.\
\>", "ExampleText",ExpressionUUID->"466fe7d7-ce50-47b6-b67e-6fd9ff412c56"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"CirclePoints", "[", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", "3", "]"}]}], ",", " ", "3"}], "]"}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"StandardBlue", ",", " ", 
          RowBox[{"Opacity", "[", "0.15", "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Disk", "[", 
             RowBox[{"#", ",", " ", "0.6"}], "]"}], " ", "&"}], " ", "/@", 
           " ", "points"}]}], "}"}], ",", " ", 
        RowBox[{"Point", "[", "points", "]"}]}], "}"}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"BallIntersectionComplex", "[", 
      RowBox[{"points", ",", " ", "0.6", ",", " ", "Infinity", ",", " ", 
       RowBox[{"\"\<IntersectionTest\>\"", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"RegionMeasure", "[", "#", "]"}], " ", ">", " ", "0.05"}], 
          " ", "&"}], ")"}]}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fb80ca21-2533-4cb2-b4eb-53746a04363b"],

