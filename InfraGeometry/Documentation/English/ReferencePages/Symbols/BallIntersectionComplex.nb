     "70512ac6-d884-4686-a66d-f2b6ce4b1bf3"]], "TableText",ExpressionUUID->
     "280e1e1f-350d-473c-bfdf-2c2ef47988bf"], Cell[TextData[{
     "a function of the common region of Euclidean balls that must give ",
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "14fcd47d-505a-447f-a196-0c15834bc70c"]
    }], "TableText",ExpressionUUID->"78609f54-c451-4f3a-bcc3-a8aa4fd1a9e0"], 
