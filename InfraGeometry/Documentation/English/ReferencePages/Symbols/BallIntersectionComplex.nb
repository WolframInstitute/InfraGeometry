     StyleBox["g", "TI"]
    }], "TableText",ExpressionUUID->"964f36b7-4394-4f84-880f-9449f17c3341"], 
    Cell[TextData[{
     "some vertex of ",
     StyleBox["g", "TI"],
     ", in ",
     StyleBox["data", "TI"],
     " or not, lies within ",
     StyleBox["r", "TI"],
     " of every centre"
    }], "TableText",ExpressionUUID->"31171361-b686-4b16-8bc8-202a7d957c05"], 
    Cell[TextData[{
     "the Vietoris\[Dash]Rips complex at ",
     StyleBox["2r", "TI"],
     " for integer ",
     StyleBox["r", "TI"],
     "; two vertices at distance ",
     StyleBox["d", "TI"],
     " have meeting balls from ",
     StyleBox["r", "TI"],
     " = \[LeftCeiling]",
     StyleBox["d", "TI"],
     "/2\[RightCeiling], so ",
     StyleBox["r", "TI"],
     " = 1/2 gives no edge"
    }], "TableText",ExpressionUUID->"65972b02-1858-433e-a1ba-5c5ab6675df9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "451f873c-08b6-4f8e-bcb8-610928cc735c"], Cell[
