Cell["\<\
The balls of radius 1 about the four corners of a square of the square tiling \
meet three at a time, at a corner, but not all four. The four corners are a \
simplex of order 3 and not of order 4.\
\>", "ExampleText",ExpressionUUID->"5f583d8f-1e42-4366-aac8-1e5101c3e94f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"First", " ", "/@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindCycle", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", ",", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", "4", "}"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraBall", "[", 
          RowBox[{"#", ",", " ", "1"}], "]"}], " ", "&"}], " ", "/@", " ", 
        "corners"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"BallIntersectionComplex", "[", 
        RowBox[{"corners", ",", " ", "1", ",", " ", "3", ",", " ", 
         RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"BallIntersectionComplex", "[", 
        RowBox[{"corners", ",", " ", "1", ",", " ", "4", ",", " ", 
         RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}]}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2f1b4eda-5126-41c2-b6ce-baa0d59ee0ef"],

