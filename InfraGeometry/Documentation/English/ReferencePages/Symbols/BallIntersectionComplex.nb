Notebook[{

Cell[CellGroupData[{
Cell["BallIntersectionComplex", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"88c31f76-9515-4e75-b8b9-2a175b4db010"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9115f23f-e7be-47ad-93e6-a756099d2928"],
 "\[LineSeparator]",
 "gives the order-",
 StyleBox["k", "TI"],
 " complex of the closed balls of radius ",
 StyleBox["r", "TI"],
 " about the points of ",
 StyleBox["data", "TI"],
 ": a set of balls is a simplex when every ",
 StyleBox["k", "TI"],
 " of them have a common point.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a229aa12-4338-4dfc-95e3-ac0f066c3240"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80e6871a-4dde-457e-84ec-ae3a3d61ed4d"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["k", "TI"],
 " = ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ba380911-cf05-4568-b1aa-380be9c49d2d"],
 ", the \[CapitalCHacek]ech complex."
}], "Usage",ExpressionUUID->"3cc458fe-9bf2-4c16-8732-657a05dc6b3d"],

Cell[TextData[{
 "Definition: let ",
 StyleBox["B_i", "TI"],
 " be the closed ball of radius ",
 StyleBox["r", "TI"],
 " about the ",
 StyleBox["i", "TI"],
 "-th point. A set ",
 StyleBox["\[Sigma]", "TI"],
 " of positions is a simplex of ",
 StyleBox["C^(k)_r", "TI"],
 " when every subset of ",
 StyleBox["\[Sigma]", "TI"],
 " with ",
 StyleBox["min(k, |\[Sigma]|)", "TI"],
 " elements has balls with a common point."
}], "Notes",ExpressionUUID->"2e107476-cdb9-4b59-864e-efabeab4c6dc"],

Cell[TextData[{
 "At ",
 StyleBox["k = 2", "TI"],
 " every pair of balls meets. For Euclidean points that is the \
Vietoris\[Dash]Rips complex at scale ",
 StyleBox["2r", "TI"],
 ", the pairs at distance at most ",
 StyleBox["2r", "TI"],
 " and every set all of whose pairs are such. At ",
 StyleBox["k", "TI"],
 " = ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5490d0bb-6d5f-4229-aade-432da3004ef6"],
 " all the balls of ",
 StyleBox["\[Sigma]", "TI"],
 " meet: the \[CapitalCHacek]ech complex, the nerve of the balls. In between \
the complexes are nested, ",
 StyleBox["C^(2) \[SupersetEqual] C^(3) \[SupersetEqual] \[Ellipsis] \
\[SupersetEqual]", "TI"],
 " \[CapitalCHacek]ech."
}], "Notes",ExpressionUUID->"94af33b9-394f-4301-b9c8-b0b041287242"],

Cell[TextData[{
 "Balls in ",
 StyleBox["\:211d^d", "TI"],
 " are convex, and by Helly's theorem the ladder stops at ",
 StyleBox["k = d + 1", "TI"],
 ": in the plane order 3 is already \[CapitalCHacek]ech. On a graph it may go \
further."
}], "Notes",ExpressionUUID->"f40905a0-5561-4ff9-95f0-707c5f089a55"],

Cell[TextData[{
 "A simplex is a sorted list of positions in ",
 StyleBox["data", "TI"],
 ", not of the points themselves. The complex is built level by level, a set \
being tested only when all its faces are in, so it is closed under faces."
}], "Notes",ExpressionUUID->"f572735e-2bb7-44f0-927f-722f7e942497"],

Cell[TextData[{
 "Euclidean balls about the points have a common point when their centres fit \
in a ball of radius ",
 StyleBox["r", "TI"],
 ", the test of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MiniballRadius"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/MiniballRadius", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5a870729-eaa8-4e29-8085-b0b56ffbaa25"],
 "."
}], "Notes",ExpressionUUID->"27c0560a-27a6-4b2d-9302-fd33b4cf50c4"],

Cell["Options:", "Notes",ExpressionUUID->"9f0cc90f-57c7-4da2-be79-0a3b654e79b5"],

