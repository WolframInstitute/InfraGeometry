Cell[TextData[{
 "The edges of order 2 are the pairs at distance at most ",
 StyleBox["2r", "TI"],
 ", and in the plane order 3 is the \[CapitalCHacek]ech complex. Order 2 has \
one triangle more."
}], "ExampleText",ExpressionUUID->"0879997d-72be-41cb-b05e-573a73e97669"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"16", ",", " ", "2"}], "}"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rips", " ", "=", " ", 
     RowBox[{"BallIntersectionComplex", "[", 
      RowBox[{"points", ",", " ", "0.15", ",", " ", "2"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cech", " ", "=", " ", 
     RowBox[{"BallIntersectionComplex", "[", 
      RowBox[{"points", ",", " ", "0.15", ",", " ", "Infinity"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{"{", "\n", "     ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"StandardBlue", ",", " ", 
          RowBox[{"Opacity", "[", "0.15", "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Disk", "[", 
             RowBox[{"#", ",", " ", "0.15"}], "]"}], " ", "&"}], " ", "/@", 
           " ", "points"}]}], "}"}], ",", "\n", "     ", 
        RowBox[{"{", 
         RowBox[{"StandardRed", ",", " ", 
          RowBox[{"Opacity", "[", "0.4", "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Polygon", "[", 
             RowBox[{"points", "[", 
              RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "&"}], " ", "/@", 
           " ", 
           RowBox[{"Complement", "[", 
            RowBox[{"rips", ",", " ", "cech"}], "]"}]}]}], "}"}], ",", "\n", 
        "     ", 
        RowBox[{"{", 
         RowBox[{"StandardRed", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"points", "[", 
              RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "&"}], " ", "/@", 
           " ", 
           RowBox[{"Select", "[", 
            RowBox[{"rips", ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "2"}], " ", 
              "&"}]}], "]"}]}]}], "}"}], ",", "\n", "     ", 
        RowBox[{"Point", "[", "points", "]"}]}], "}"}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{"rips", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "2"}], " ", 
         "&"}]}], "]"}], " ", "==", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Subsets", "[", 
         RowBox[{
          RowBox[{"Range", "[", "16", "]"}], ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"EuclideanDistance", " ", "@@", " ", 
