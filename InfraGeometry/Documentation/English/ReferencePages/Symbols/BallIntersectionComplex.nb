     RowBox[{"BallIntersectionComplex", "[", 
      RowBox[{"points", ",", " ", "0.15", ",", " ", "2"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cech", " ", "=", " ", 
     RowBox[{"BallIntersectionComplex", "[", 
      RowBox[{"points", ",", " ", "0.15", ",", " ", "Infinity"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{"{", "\n", "     ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"StandardBlue", ",", " ", 
          RowBox[{"Opacity", "[", "0.15", "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Disk", "[", 
             RowBox[{"#", ",", " ", "0.15"}], "]"}], " ", "&"}], " ", "/@", 
           " ", "points"}]}], "}"}], ",", "\n", "     ", 
        RowBox[{"{", 
         RowBox[{"StandardRed", ",", " ", 
          RowBox[{"Opacity", "[", "0.4", "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Polygon", "[", 
             RowBox[{"points", "[", 
              RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "&"}], " ", "/@", 
           " ", 
           RowBox[{"Complement", "[", 
            RowBox[{"rips", ",", " ", "cech"}], "]"}]}]}], "}"}], ",", "\n", 
        "     ", 
        RowBox[{"{", 
         RowBox[{"StandardRed", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"points", "[", 
              RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "&"}], " ", "/@", 
           " ", 
           RowBox[{"Select", "[", 
            RowBox[{"rips", ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "2"}], " ", 
              "&"}]}], "]"}]}]}], "}"}], ",", "\n", "     ", 
        RowBox[{"Point", "[", "points", "]"}]}], "}"}], "]"}], ",", "\n", 
     "   ", 
