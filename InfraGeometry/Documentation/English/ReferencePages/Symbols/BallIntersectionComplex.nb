Cell[CellGroupData[{

Cell["Metric", "ExampleSubsection",ExpressionUUID->"5ead171f-13bd-4b0f-9d21-f98b59645a30"],

Cell["\<\
On a path two vertices at distance 2 have balls of radius 1 that meet at the \
vertex between them. With the distance matrix of the two vertices alone that \
vertex is not a candidate, and the balls do not meet.\
\>", "ExampleText",ExpressionUUID->"5a66a61b-e687-4b56-ac4a-98f734f2ae60"],

Cell[CellGroupData[{

