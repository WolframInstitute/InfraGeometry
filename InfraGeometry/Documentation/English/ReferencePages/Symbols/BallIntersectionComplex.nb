Cell[CellGroupData[{

Cell["IntersectionTest", "ExampleSubsection",ExpressionUUID->"aaa1379a-a023-4529-b628-82e37202d510"],

Cell["\<\
At radius 0.6 the three disks about the triangle meet in a small region. \
Asking for a common region of area more than 0.05 drops the triangle.\
\>", "ExampleText",ExpressionUUID->"ef6de57a-09fd-454c-8457-21ab90d26cf4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"CirclePoints", "[", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", "3", "]"}]}], ",", " ", "3"}], "]"}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"StandardBlue", ",", " ", 
          RowBox[{"Opacity", "[", "0.15", "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Disk", "[", 
             RowBox[{"#", ",", " ", "0.6"}], "]"}], " ", "&"}], " ", "/@", 
           " ", "points"}]}], "}"}], ",", " ", 
        RowBox[{"Point", "[", "points", "]"}]}], "}"}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"BallIntersectionComplex", "[", 
      RowBox[{"points", ",", " ", "0.6", ",", " ", "Infinity", ",", " ", 
       RowBox[{"\"\<IntersectionTest\>\"", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"RegionMeasure", "[", "#", "]"}], " ", ">", " ", "0.05"}], 
          " ", "&"}], ")"}]}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"78803933-1498-4ddb-8c90-0219aac9873e"],

