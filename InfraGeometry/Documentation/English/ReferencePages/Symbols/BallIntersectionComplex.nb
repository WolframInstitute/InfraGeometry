Cell["\<\
The three corners of an equilateral triangle of side 1, with disks of radius \
0.55. Every pair of disks meets, so the triangle is a simplex of order 2; the \
three have no common point, so it is not one of the \[CapitalCHacek]ech \
complex.\
\>", "ExampleText",ExpressionUUID->"ff38daa6-930e-48d1-813d-a866f98a5b64"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"CirclePoints", "[", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", "3", "]"}]}], ",", " ", "3"}], "]"}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"complex", " ", "=", " ", 
          RowBox[{"BallIntersectionComplex", "[", 
           RowBox[{"points", ",", " ", "0.55", ",", " ", "k"}], "]"}]}], 
         "}"}], ",", "\n", "      ", 
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"{", "\n", "        ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"StandardBlue", ",", " ", 
              RowBox[{"Opacity", "[", "0.15", "]"}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Disk", "[", 
                 RowBox[{"#", ",", " ", "0.55"}], "]"}], " ", "&"}], " ", "/@",
                " ", "points"}]}], "}"}], ",", "\n", "        ", 
            RowBox[{"{", 
             RowBox[{"StandardRed", ",", " ", 
              RowBox[{"Opacity", "[", "0.4", "]"}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Polygon", "[", 
                 RowBox[{"points", "[", 
                  RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "&"}], " ", "/@",
                " ", 
               RowBox[{"Select", "[", 
                RowBox[{"complex", ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "3"}], 
