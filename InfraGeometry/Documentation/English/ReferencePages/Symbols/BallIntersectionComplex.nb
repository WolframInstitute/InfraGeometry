       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraBall", "[", 
          RowBox[{"1", ",", " ", "1"}], "]"}], ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{"3", ",", " ", "1"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
     "   ", 
