Cell["\<\
An equilateral triangle of side 1 with disks of radius 0.55. The disks meet \
in pairs but have no common point: the triangle is a simplex of order 2, not \
of order 3:\
\>", "ExampleText",ExpressionUUID->"4cfe6829-b53d-4edb-8f38-9352743609e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"CirclePoints", "[", 
       RowBox[{
        RowBox[{"1", " ", "/", " ", 
         RowBox[{"Sqrt", "[", "3", "]"}]}], ",", " ", "3"}], "]"}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"complex", " ", "=", " ", 
          RowBox[{"BallIntersectionComplex", "[", 
           RowBox[{"points", ",", " ", "0.55", ",", " ", "k"}], "]"}]}], 
         "}"}], ",", "\n", "      ", 
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"StandardBlue", ",", " ", 
              RowBox[{"Opacity", "[", "0.15", "]"}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Disk", "[", 
                 RowBox[{"#", ",", " ", "0.55"}], "]"}], " ", "&"}], " ", "/@",
                " ", "points"}]}], "}"}], ",", "\n", "        ", 
            RowBox[{"{", 
             RowBox[{"StandardRed", ",", " ", 
              RowBox[{"Opacity", "[", "0.4", "]"}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Polygon", "[", 
                 RowBox[{"points", "[", 
                  RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "&"}], " ", "/@",
                " ", 
               RowBox[{"Select", "[", 
                RowBox[{"complex", ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "3"}], 
                  " ", "&"}]}], "]"}]}]}], "}"}], ",", " ", 
            RowBox[{"Point", "[", "points", "]"}]}], "}"}], ",", "\n", 
          "        ", 
          RowBox[{"PlotLabel", " ", "->", " ", "k"}]}], "]"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6784e660-27e8-4312-bdad-c2a5f1f689c8"],

