      RowBox[{"Select", "[", 
       RowBox[{"rips", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "2"}], " ", 
         "&"}]}], "]"}], " ", "==", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Subsets", "[", 
         RowBox[{
          RowBox[{"Range", "[", "16", "]"}], ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"EuclideanDistance", " ", "@@", " ", 
           RowBox[{"points", "[", 
            RowBox[{"[", "#", "]"}], "]"}]}], " ", "<=", " ", "0.3"}], " ", 
         "&"}]}], "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"BallIntersectionComplex", "[", 
       RowBox[{"points", ",", " ", "0.15", ",", " ", "3"}], "]"}], " ", "==", 
      " ", "cech"}], ",", "\n", "   ", 
     RowBox[{"Complement", "[", 
      RowBox[{"rips", ",", " ", "cech"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"52064572-fcda-4beb-bf6e-b2f488accbcc"],

