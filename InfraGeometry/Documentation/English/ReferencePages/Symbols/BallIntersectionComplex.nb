Cell[CellGroupData[{

Cell["Metric", "ExampleSubsection",ExpressionUUID->"d86a2a9d-d8ac-481e-b96f-82316dd82dd7"],

Cell["\<\
On a path two vertices at distance 2 have balls of radius 1 that meet at the \
vertex between them. With the distance matrix of the two vertices alone that \
vertex is not a candidate, and the balls do not meet.\
\>", "ExampleText",ExpressionUUID->"3eeeb738-808a-4e62-aad3-b825941a2d1f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"PathGraph", "[", 
      RowBox[{"Range", "[", "5", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraBall", "[", 
          RowBox[{"1", ",", " ", "1"}], "]"}], ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{"3", ",", " ", "1"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"BallIntersectionComplex", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", "1", ",", " ", "2", ",",
        " ", 
       RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"BallIntersectionComplex", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", "1", ",", " ", "2", ",",
        " ", 
       RowBox[{"\"\<Metric\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "2"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "0"}], "}"}]}], "}"}]}]}], "]"}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"60c0f03a-5b97-4e66-b8a2-1a188e2a0c11"],

