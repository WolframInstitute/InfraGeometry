     "66f502b5-1b17-454d-a6e0-980fbbf18e35"]], "TableText",ExpressionUUID->
     "8ff18891-5577-44fe-bed0-fb4a7d07ce0f"], Cell[TextData[{
     "a function of the common region of Euclidean balls that must give ",
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "adfba08f-2ee0-44c0-aad3-86bc4ad10902"]
    }], "TableText",ExpressionUUID->"b01bf7e7-e347-4bf8-89b6-4f2973b7447e"], 
