Cell["\<\
The three corners of an equilateral triangle of side 1, with disks of radius \
0.55. Every pair of disks meets, so the triangle is a simplex of order 2; the \
three have no common point, so it is not one of the \[CapitalCHacek]ech \
complex.\
\>", "ExampleText",ExpressionUUID->"331899bc-70a4-43de-ab21-ab4e3981d8d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"CirclePoints", "[", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", "3", "]"}]}], ",", " ", "3"}], "]"}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"complex", " ", "=", " ", 
          RowBox[{"BallIntersectionComplex", "[", 
           RowBox[{"points", ",", " ", "0.55", ",", " ", "k"}], "]"}]}], 
         "}"}], ",", "\n", "      ", 
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"{", "\n", "        ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"StandardBlue", ",", " ", 
              RowBox[{"Opacity", "[", "0.15", "]"}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Disk", "[", 
                 RowBox[{"#", ",", " ", "0.55"}], "]"}], " ", "&"}], " ", "/@",
                " ", "points"}]}], "}"}], ",", "\n", "        ", 
            RowBox[{"{", 
             RowBox[{"StandardRed", ",", " ", 
              RowBox[{"Opacity", "[", "0.4", "]"}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Polygon", "[", 
                 RowBox[{"points", "[", 
                  RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "&"}], " ", "/@",
                " ", 
               RowBox[{"Select", "[", 
                RowBox[{"complex", ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "3"}], 
                  " ", "&"}]}], "]"}]}]}], "}"}], ",", "\n", "        ", 
            RowBox[{"{", 
             RowBox[{"StandardRed", ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Line", "[", 
                 RowBox[{"points", "[", 
                  RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "&"}], " ", "/@",
                " ", 
               RowBox[{"Select", "[", 
                RowBox[{"complex", ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "2"}], 
                  " ", "&"}]}], "]"}]}]}], "}"}], ",", "\n", "        ", 
            RowBox[{"Point", "[", "points", "]"}]}], "}"}], ",", "\n", 
          "        ", 
          RowBox[{"PlotLabel", " ", "->", " ", "k"}]}], "]"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "Infinity"}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"580bdd49-1618-426f-99cd-f80fa021355e"],

