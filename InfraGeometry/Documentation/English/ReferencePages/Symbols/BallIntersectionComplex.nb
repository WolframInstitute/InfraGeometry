         RowBox[{
          RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "2"}], " ", 
         "&"}]}], "]"}], " ", "==", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Subsets", "[", 
