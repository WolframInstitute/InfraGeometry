Cell["The common point of the balls depends on the metric:", "Notes",ExpressionUUID->"abad8549-19de-443d-a26b-cb432f885bac"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7bcbfe99-e548-49fd-9138-fb24f3c07220"], Cell[TextData[Cell[
    BoxData["\"\<Metric\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "14d7cdc4-4af8-4ce7-a002-4ac69a257401"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"a5c2dc41-2fc9-47e4-aed3-8ee9f25fe608"],
     Cell["the balls meet when", "TableText",
     FontWeight->Bold,ExpressionUUID->"d3404a94-d99d-4a30-b8d1-f9959e3dcd6e"],
     Cell["order 2", "TableText",
     FontWeight->Bold,ExpressionUUID->"4796420a-c385-4895-a5c2-896d58c8a79a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e3031d48-4371-42ff-a0eb-bea9a2e28c98"], Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["Automatic"]], "paclet:ref/Automatic"},
      "RefLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "be6d6052-1b82-47eb-86aa-6162a64b84ab"]], "TableText",ExpressionUUID->
     "c60b2c2d-a4f0-47cf-8b67-8503aafdef15"], Cell[TextData[{
     "some point of space lies within ",
     StyleBox["r", "TI"],
     " of every centre"
    }], "TableText",ExpressionUUID->"554d6e78-d135-4634-adbe-73c1dc59393b"], 
    Cell[TextData[{
     "the Vietoris\[Dash]Rips complex at ",
     StyleBox["2r", "TI"]
    }], "TableText",ExpressionUUID->"42d308f8-fed1-45ba-9eeb-ebae7e9364b9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ba302bb2-1015-4d53-9ee6-ae21540dac06"], Cell[TextData[{
