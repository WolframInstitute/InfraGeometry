  }]], "3ColumnTableMod",ExpressionUUID->"5bacefbc-61a9-442c-a8e0-\
221764fa4a0d"],

Cell["The common point of the balls depends on the metric:", "Notes",ExpressionUUID->"b78ef0ac-dc0b-4563-bd9e-306f37bc56ad"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "40ce7860-3635-498c-96da-7ba07fd2190d"], Cell[TextData[Cell[
    BoxData["\"\<Metric\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9607704c-1f3f-4d63-be75-18cf7bb19a60"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"8546441b-a6aa-4381-be24-0deeaf715409"],
     Cell["the balls meet when", "TableText",
     FontWeight->Bold,ExpressionUUID->"50209bdb-68e9-4e67-8a45-6bff458bff94"],
     Cell["order 2", "TableText",
     FontWeight->Bold,ExpressionUUID->"3aaf0154-ee7a-4433-8511-0fccdfca8ee1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2a679986-8f73-41f8-bf5a-bc94b34e758d"], Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["Automatic"]], "paclet:ref/Automatic"},
      "RefLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "acd10c4f-e589-40aa-85ef-3a8c42860976"]], "TableText",ExpressionUUID->
     "d1762036-a878-42e4-8308-235b7da59f44"], Cell[TextData[{
     "some point of space lies within ",
     StyleBox["r", "TI"],
     " of every centre"
    }], "TableText",ExpressionUUID->"4ffbab98-f0fe-4079-896b-80c399b8a69d"], 
    Cell[TextData[{
     "the Vietoris\[Dash]Rips complex at ",
     StyleBox["2r", "TI"]
    }], "TableText",ExpressionUUID->"0dfc2ef2-aeeb-4d8b-a914-14a4e98312cf"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b7089583-8649-425b-8545-a842727d9f90"], Cell[TextData[{
     "a ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Graph"]], "paclet:ref/Graph"},
       "RefLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "bc2e0a49-7d09-4e89-a726-9ddd20e17a5b"],
