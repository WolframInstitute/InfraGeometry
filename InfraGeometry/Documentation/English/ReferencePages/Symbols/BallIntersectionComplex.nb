Cell[TextData[{
 "The edges of order 2 are the pairs at distance at most ",
 StyleBox["2r", "TI"],
 ", and in the plane order 3 is the \[CapitalCHacek]ech complex. Order 2 has \
one triangle more."
}], "ExampleText",ExpressionUUID->"6dbf951a-2a5c-40fd-afbf-821aad352ca1"],

