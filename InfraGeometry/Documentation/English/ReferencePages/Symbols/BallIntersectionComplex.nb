Cell[CellGroupData[{
Cell["BallIntersectionComplex", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c6ac40a9-7f95-4d1b-aafd-e83e328dae66"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "afca8913-7f35-4faf-ab03-6b2dcdea9103"],
 "\[LineSeparator]",
 "gives the order-",
 StyleBox["k", "TI"],
 " complex of the closed balls of radius ",
 StyleBox["r", "TI"],
 " about the points of ",
 StyleBox["data", "TI"],
 ": a set of balls is a simplex when every ",
 StyleBox["k", "TI"],
 " of them have a common point.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d5d8f00d-5b6a-4318-a2d7-e8a52a548547"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b82dcec1-38ed-4920-a69b-475602ae6eec"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["k", "TI"],
 " = ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "432c80de-f9da-4de0-978f-bbef5d08eb93"],
 ", the \[CapitalCHacek]ech complex."
}], "Usage",ExpressionUUID->"7243ca30-f253-4211-b37e-c435e96fa3e5"],

Cell[TextData[{
 "Definition: let ",
 StyleBox["B_i", "TI"],
 " be the closed ball of radius ",
 StyleBox["r", "TI"],
 " about the ",
 StyleBox["i", "TI"],
 "-th point. A set ",
 StyleBox["\[Sigma]", "TI"],
 " of positions is a simplex of ",
 StyleBox["C^(k)_r", "TI"],
 " when every subset of ",
 StyleBox["\[Sigma]", "TI"],
 " with ",
 StyleBox["min(k, |\[Sigma]|)", "TI"],
 " elements has balls with a common point."
}], "Notes",ExpressionUUID->"67c57028-42d1-45a0-9d70-c5b7d1e262b4"],

Cell[TextData[{
 "At ",
 StyleBox["k = 2", "TI"],
 " every pair of balls meets: the Vietoris\[Dash]Rips complex at scale ",
 StyleBox["2r", "TI"],
 ", the pairs at distance at most ",
 StyleBox["2r", "TI"],
 " and every set all of whose pairs are such. At ",
 StyleBox["k", "TI"],
 " = ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "975f7a81-1022-4fc3-84f7-3a6b5490d5d5"],
 " all the balls of ",
 StyleBox["\[Sigma]", "TI"],
 " meet: the \[CapitalCHacek]ech complex, the nerve of the balls. In between \
the complexes are nested, ",
 StyleBox["C^(2) \[SupersetEqual] C^(3) \[SupersetEqual] \[Ellipsis] \
\[SupersetEqual]", "TI"],
 " \[CapitalCHacek]ech."
}], "Notes",ExpressionUUID->"8cd28138-7c5b-41ef-8f7d-cfd41e961bbf"],

Cell[TextData[{
 "Balls in ",
 StyleBox["\:211d^d", "TI"],
 " are convex, and by Helly's theorem the ladder stops at ",
 StyleBox["k = d + 1", "TI"],
 ": in the plane order 3 is already \[CapitalCHacek]ech. On a graph it may go \
further."
}], "Notes",ExpressionUUID->"7ca90dfa-5888-4e36-b598-f74657b49e9d"],

Cell[TextData[{
 "A simplex is a sorted list of positions in ",
 StyleBox["data", "TI"],
 ", not of the points themselves. The complex is built level by level, a set \
being tested only when all its faces are in, so it is closed under faces."
}], "Notes",ExpressionUUID->"3c18b09a-8eda-45e9-905a-635bb9d46bab"],

Cell[TextData[{
 "Euclidean balls about the points have a common point when their centres fit \
in a ball of radius ",
 StyleBox["r", "TI"],
 ", the test of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MiniballRadius"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/MiniballRadius", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1d6ea192-1c48-47eb-a59b-5dc460e9427c"],
 "."
}], "Notes",ExpressionUUID->"f12932c0-a6f3-4bbd-a41d-e6f341f94676"],

Cell["Options:", "Notes",ExpressionUUID->"17ea6375-add4-4e68-aa61-9c748bea7598"],

