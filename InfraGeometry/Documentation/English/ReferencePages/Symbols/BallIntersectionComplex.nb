Cell["\<\
The balls of radius 1 about the four corners of a square of the grid. Every \
three meet, at a corner, but the four have no common vertex: the square is a \
simplex of order 3, not of order 4:\
\>", "ExampleText",ExpressionUUID->"990815f1-fd71-4090-8c9f-59925a83216d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"First", " ", "/@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindCycle", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", ",", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", "4", "}"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraBall", "[", 
        RowBox[{"#", ",", " ", "1"}], "]"}], " ", "&"}], " ", "/@", " ", 
      "corners"}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"BallIntersectionComplex", "[", 
           RowBox[{"corners", ",", " ", "1", ",", " ", "k", ",", " ", 
            RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}]}], "]"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], 
           "}"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", 
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}]}], "]"}]}], ",", "\n",
      "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6edeacc7-78d5-4987-84af-95fe01739610"],

