Notebook[{

Cell[CellGroupData[{
Cell["BallIntersectionComplex", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"dda2e7f6-87a1-4bc1-a3bf-5ac96ba4c858"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77b9ec8d-e2fe-4f68-b936-50d61e895a85"],
 "\[LineSeparator]",
 "gives the order-",
 StyleBox["k", "TI"],
 " complex of the balls of radius ",
 StyleBox["r", "TI"],
 " about the points of ",
 StyleBox["data", "TI"],
 ": a set of balls is a simplex when every ",
 StyleBox["k", "TI"],
 " of them have a common point.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"22a81196-920e-4fcf-ae30-130fcf7a748b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f95de785-3c05-4c0a-8a7f-83cf920b3ce9"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["k", "TI"],
 " = ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a8e69f22-9b88-4d8f-9fcc-64de14dc6295"],
 ": the \[CapitalCHacek]ech complex."
}], "Usage",ExpressionUUID->"89efb650-1315-47c5-8623-6b8ec8cfbba8"],

Cell[TextData[{
 "Let ",
 StyleBox["B\:1d62", "TI"],
 " be the closed ball of radius ",
 StyleBox["r", "TI"],
 " about the ",
 StyleBox["i", "TI"],
 "-th point. A set ",
 StyleBox["\[Sigma]", "TI"],
 " of positions is a simplex of ",
 StyleBox["C\:1d63\:207d\:1d4f\:207e", "TI"],
 " when every subset of ",
 StyleBox["\[Sigma]", "TI"],
 " with ",
 StyleBox["min(k, |\[Sigma]|)", "TI"],
 " elements has balls with a common point."
}], "Notes",ExpressionUUID->"99505b6b-df18-4e34-910c-ff15176e672a"],

Cell[TextData[{
 "At ",
 StyleBox["k", "TI"],
 " = 2 it is the Vietoris\[Dash]Rips complex of the pairs at distance at most \
",
 StyleBox["2r", "TI"],
 ", for Euclidean points and for a graph at integer ",
 StyleBox["r", "TI"],
 ". At ",
 StyleBox["k", "TI"],
 " = ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "48846b4f-fd51-4d07-9512-bb6cc232d37f"],
 " it is the \[CapitalCHacek]ech complex, the nerve of the balls. In between, \
",
 StyleBox["C\:207d\.b2\:207e \[SupersetEqual] C\:207d\.b3\:207e \
\[SupersetEqual] \[Ellipsis] \[SupersetEqual] C\:207d\[Infinity]\:207e", "TI"],
 "."
}], "Notes",ExpressionUUID->"ce4169db-bcd3-4b34-945a-8628677cec27"],

Cell[TextData[{
 "Balls in ",
 StyleBox["\:211d\:1d48", "TI"],
 " are convex, and by Helly's theorem the sequence stops at ",
 StyleBox["k = d + 1", "TI"],
 ". On a graph it can go on, already on the square grid."
}], "Notes",ExpressionUUID->"7e64d5a0-2d3d-4344-91c8-912dcd93e02c"],

Cell[TextData[{
 "A simplex is a sorted list of positions in ",
 StyleBox["data", "TI"],
 "."
}], "Notes",ExpressionUUID->"b3da66a1-618b-49a1-9489-a6ab1e58178b"],

