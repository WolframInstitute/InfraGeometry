Cell[CellGroupData[{

Cell["Metric", "ExampleSubsection",ExpressionUUID->"e60a424b-b185-41b4-b35d-74093b026b6c"],

Cell["\<\
On a path two vertices at distance 2 have balls of radius 1 that meet at the \
vertex between them. With the distance matrix of the two vertices alone that \
vertex is not a candidate, and the balls do not meet.\
\>", "ExampleText",ExpressionUUID->"48467baf-7056-4e75-a56c-6642224ffb57"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
