Cell[TextData[{
 "The edges of order 2 are the pairs at distance at most ",
 StyleBox["2r", "TI"],
 ", and in the plane order 3 is the \[CapitalCHacek]ech complex. Order 2 has \
one triangle more."
}], "ExampleText",ExpressionUUID->"04092854-7c2d-404a-84ee-4b9b049a76dc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"16", ",", " ", "2"}], "}"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
