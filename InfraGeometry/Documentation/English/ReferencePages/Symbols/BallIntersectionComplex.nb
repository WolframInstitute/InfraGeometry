Notebook[{

Cell[CellGroupData[{
Cell["BallIntersectionComplex", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"743d586f-9da2-4195-bfc6-e4a9e94d16e7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9dfe723-9dc0-448f-a3a8-cccfa25a731e"],
 "\[LineSeparator]",
 "gives the order-",
 StyleBox["k", "TI"],
 " complex of the closed balls of radius ",
 StyleBox["r", "TI"],
 " about the points of ",
 StyleBox["data", "TI"],
 ": a set of balls is a simplex when every ",
 StyleBox["k", "TI"],
 " of them have a common point.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2ab72216-7f1b-40f4-8040-4a9c2a19fef4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19326a86-de15-4e3e-8e8f-738660a86aab"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["k", "TI"],
 " = ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6d45df78-b5c7-4971-abe8-af17d52cf282"],
 ", the \[CapitalCHacek]ech complex."
}], "Usage",ExpressionUUID->"7d0912cf-f45d-4c84-adcd-0aec8002ce8d"],

Cell[TextData[{
 "Definition: let ",
 StyleBox["B_i", "TI"],
 " be the closed ball of radius ",
 StyleBox["r", "TI"],
 " about the ",
 StyleBox["i", "TI"],
 "-th point. A set ",
 StyleBox["\[Sigma]", "TI"],
 " of positions is a simplex of ",
 StyleBox["C^(k)_r", "TI"],
 " when every subset of ",
 StyleBox["\[Sigma]", "TI"],
 " with ",
 StyleBox["min(k, |\[Sigma]|)", "TI"],
 " elements has balls with a common point."
}], "Notes",ExpressionUUID->"7c7482ad-d179-42cf-972a-c9439350c0ac"],

Cell[TextData[{
 "At ",
 StyleBox["k = 2", "TI"],
 " every pair of balls meets: the Vietoris\[Dash]Rips complex at scale ",
 StyleBox["2r", "TI"],
 ", the pairs at distance at most ",
 StyleBox["2r", "TI"],
 " and every set all of whose pairs are such. At ",
 StyleBox["k", "TI"],
 " = ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1b7b0016-1f22-4aab-b388-7f3ae0914f89"],
 " all the balls of ",
 StyleBox["\[Sigma]", "TI"],
 " meet: the \[CapitalCHacek]ech complex, the nerve of the balls. In between \
the complexes are nested, ",
 StyleBox["C^(2) \[SupersetEqual] C^(3) \[SupersetEqual] \[Ellipsis] \
\[SupersetEqual]", "TI"],
 " \[CapitalCHacek]ech."
}], "Notes",ExpressionUUID->"68058a0a-97fe-46f1-aac1-8c85cffb427d"],

Cell[TextData[{
 "Balls in ",
 StyleBox["\:211d^d", "TI"],
 " are convex, and by Helly's theorem the ladder stops at ",
 StyleBox["k = d + 1", "TI"],
 ": in the plane order 3 is already \[CapitalCHacek]ech. On a graph it may go \
further."
}], "Notes",ExpressionUUID->"c4204d7d-ac0c-41fd-b130-7d8532ff58b0"],

Cell[TextData[{
 "A simplex is a sorted list of positions in ",
 StyleBox["data", "TI"],
 ", not of the points themselves. The complex is built level by level, a set \
being tested only when all its faces are in, so it is closed under faces."
}], "Notes",ExpressionUUID->"5114cac3-6647-4368-9cd4-a1433c85ed27"],

Cell[TextData[{
 "Euclidean balls about the points have a common point when their centres fit \
in a ball of radius ",
 StyleBox["r", "TI"],
 ", the test of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MiniballRadius"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/MiniballRadius", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e1897f5a-4836-4e62-a9ef-f5cdda359914"],
 "."
}], "Notes",ExpressionUUID->"bf534372-4c1a-4915-82fd-3656cb4d5c0f"],

Cell["Options:", "Notes",ExpressionUUID->"de19fe0f-8e97-48b2-8498-a670acc98ddd"],

