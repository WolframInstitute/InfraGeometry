Notebook[{

Cell[CellGroupData[{
Cell["BallIntersectionComplex", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fa35e540-dfe1-4e0b-8ecb-bb966671dce0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fdadc4f8-09bd-4f63-8782-56f5be4c897e"],
 "\[LineSeparator]",
 "gives the order-",
 StyleBox["k", "TI"],
 " complex of the closed balls of radius ",
 StyleBox["r", "TI"],
 " about the points of ",
 StyleBox["data", "TI"],
 ": a set of balls is a simplex when every ",
 StyleBox["k", "TI"],
 " of them have a common point.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3dc26b84-acca-4c0f-b742-742b20cd88aa"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf915394-f987-4cbd-a9c4-893cb17384bd"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["k", "TI"],
 " = ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "17b76bc9-f2a2-4b27-bee5-763a096c7105"],
 ", the \[CapitalCHacek]ech complex."
}], "Usage",ExpressionUUID->"92fdda60-cba7-40db-9902-8729b1d310fa"],

Cell[TextData[{
 "Definition: let ",
 StyleBox["B_i", "TI"],
 " be the closed ball of radius ",
 StyleBox["r", "TI"],
 " about the ",
 StyleBox["i", "TI"],
 "-th point. A set ",
 StyleBox["\[Sigma]", "TI"],
 " of positions is a simplex of ",
 StyleBox["C^(k)_r", "TI"],
 " when every subset of ",
 StyleBox["\[Sigma]", "TI"],
 " with ",
 StyleBox["min(k, |\[Sigma]|)", "TI"],
 " elements has balls with a common point."
}], "Notes",ExpressionUUID->"ae06cc5b-385d-4b2f-a71f-5c626395c8bb"],

Cell[TextData[{
 "At ",
 StyleBox["k = 2", "TI"],
 " every pair of balls meets: the Vietoris\[Dash]Rips complex at scale ",
 StyleBox["2r", "TI"],
 ", the pairs at distance at most ",
 StyleBox["2r", "TI"],
 " and every set all of whose pairs are such. At ",
 StyleBox["k", "TI"],
 " = ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "87e54694-11b5-4d35-bff1-3f7c127348f2"],
 " all the balls of ",
 StyleBox["\[Sigma]", "TI"],
 " meet: the \[CapitalCHacek]ech complex, the nerve of the balls. In between \
the complexes are nested, ",
 StyleBox["C^(2) \[SupersetEqual] C^(3) \[SupersetEqual] \[Ellipsis] \
\[SupersetEqual]", "TI"],
 " \[CapitalCHacek]ech."
}], "Notes",ExpressionUUID->"e120f950-056c-4b4e-a6ad-926afcea3da1"],

Cell[TextData[{
 "Balls in ",
 StyleBox["\:211d^d", "TI"],
 " are convex, and by Helly's theorem the ladder stops at ",
 StyleBox["k = d + 1", "TI"],
 ": in the plane order 3 is already \[CapitalCHacek]ech. On a graph it may go \
further."
}], "Notes",ExpressionUUID->"32ae2801-9a44-42a7-9762-c19daed777de"],

Cell[TextData[{
 "A simplex is a sorted list of positions in ",
 StyleBox["data", "TI"],
 ", not of the points themselves. The complex is built level by level, a set \
being tested only when all its faces are in, so it is closed under faces."
}], "Notes",ExpressionUUID->"f4734f8c-7406-48bf-b12c-14c8b1993448"],

Cell[TextData[{
 "Euclidean balls about the points have a common point when their centres fit \
in a ball of radius ",
 StyleBox["r", "TI"],
 ", the test of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MiniballRadius"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/MiniballRadius", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6812d639-e612-4d7f-8bbd-67dac85ee667"],
 "."
}], "Notes",ExpressionUUID->"36d20b43-dd01-470b-8317-1f007989770d"],

Cell["Options:", "Notes",ExpressionUUID->"82e49de4-18e9-4952-aa86-cbdf02402e67"],

