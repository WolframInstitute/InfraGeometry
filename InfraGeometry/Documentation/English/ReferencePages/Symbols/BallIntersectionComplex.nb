     StyleBox["g", "TI"]
    }], "TableText",ExpressionUUID->"b74317ed-83ac-4642-9d57-4eb025ffc90a"], 
    Cell[TextData[{
     "some vertex of ",
     StyleBox["g", "TI"],
     ", in ",
     StyleBox["data", "TI"],
     " or not, lies within ",
     StyleBox["r", "TI"],
     " of every centre"
    }], "TableText",ExpressionUUID->"f7f1ce32-c142-4e3c-bda0-a9681c5d1cca"], 
    Cell[TextData[{
     "the Vietoris\[Dash]Rips complex at ",
     StyleBox["2r", "TI"],
     " for integer ",
     StyleBox["r", "TI"],
     "; two vertices at distance ",
     StyleBox["d", "TI"],
     " have meeting balls from ",
     StyleBox["r", "TI"],
     " = \[LeftCeiling]",
     StyleBox["d", "TI"],
     "/2\[RightCeiling], so ",
     StyleBox["r", "TI"],
     " = 1/2 gives no edge"
    }], "TableText",ExpressionUUID->"3c80b8cb-2000-4666-b4df-9e1a097e9ad2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "cfc159c5-9bd7-4ba8-bf2d-cf62127fdec3"], Cell[
