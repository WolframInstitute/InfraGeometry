Cell["\<\
The balls of radius 1 about the four corners of a square of the square tiling \
meet three at a time, at a corner, but not all four. The four corners are a \
simplex of order 3 and not of order 4.\
\>", "ExampleText",ExpressionUUID->"1a1529f4-638e-4cc8-ae65-639be58c98d0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"First", " ", "/@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindCycle", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", "4", "}"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraBall", "[", 
          RowBox[{"#", ",", " ", "1"}], "]"}], " ", "&"}], " ", "/@", " ", 
        "corners"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"BallIntersectionComplex", "[", 
        RowBox[{"corners", ",", " ", "1", ",", " ", "3", ",", " ", 
         RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"BallIntersectionComplex", "[", 
        RowBox[{"corners", ",", " ", "1", ",", " ", "4", ",", " ", 
         RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}]}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9b01b86a-7477-4908-8b9b-15c0fe23eed6"],

