Cell["\<\
Two vertices of the grid at distance 2. With the graph their balls of radius \
1 meet at a vertex between them; with the distance matrix of the two alone \
they do not:\
\>", "ExampleText",ExpressionUUID->"b6dd7e5b-6b4e-4538-a69b-42ac13f7badc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"pair", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"BallIntersectionComplex", "[", 
      RowBox[{"pair", ",", " ", "1", ",", " ", "2", ",", " ", 
       RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}]}], "]"}], ",", " ", 
     RowBox[{"BallIntersectionComplex", "[", 
      RowBox[{"pair", ",", " ", "1", ",", " ", "2", ",", " ", 
       RowBox[{"\"\<Metric\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "2"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "0"}], "}"}]}], "}"}]}]}], "]"}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ff3d8f05-2c85-43ab-8274-de99e445261d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", 
     RowBox[{"{", "2", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", 
     RowBox[{"{", "2", "}"}]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"fbf1cc1c-4483-42b7-999f-1d479da3ff97"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["IntersectionTest", "ExampleSubsection",ExpressionUUID->"0b1721d5-60b0-4413-b538-97eb02d462b8"],

Cell["\<\
At radius 0.6 the three disks about the triangle meet in a small region. \
Asking for an area above 0.05 drops the triangle:\
\>", "ExampleText",ExpressionUUID->"5a69787a-5946-4bda-a83a-f41d78b21d57"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"CirclePoints", "[", 
       RowBox[{
        RowBox[{"1", " ", "/", " ", 
         RowBox[{"Sqrt", "[", "3", "]"}]}], ",", " ", "3"}], "]"}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"BallIntersectionComplex", "[", 
        RowBox[{"points", ",", " ", "0.6", ",", " ", "Infinity", ",", " ", 
         RowBox[{"\"\<IntersectionTest\>\"", " ", "->", " ", "test"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"test", ",", " ", 
       RowBox[{"{", 
        RowBox[{"Automatic", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"RegionMeasure", "[", "#", "]"}], " ", ">", " ", "0.05"}], 
          " ", "&"}]}], "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7ed2986b-b9ce-4e29-bab6-b50806365133"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2d79e4ab-38d7-4ab9-a57e-a437d19b4175"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["MaxDimension", "ExampleSubsection",ExpressionUUID->"1aeb2812-1279-4f83-a9c9-e6a9967904a0"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<MaxDimension\>\"", " ", "->", " ", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d19b20f-7b27-4d86-86fa-b3c6b05b7881"],
 " keeps the vertices and the edges:"
}], "ExampleText",ExpressionUUID->"f9a35222-e7b8-4e8a-89bc-e69a97e93765"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"data", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "3"}], "]"}], ",",
         " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Counts", "[", 
    RowBox[{"Length", " ", "/@", " ", 
     RowBox[{"BallIntersectionComplex", "[", 
      RowBox[{"data", ",", " ", "1", ",", " ", "2", ",", " ", 
       RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}], ",", " ", 
       RowBox[{"\"\<MaxDimension\>\"", " ", "->", " ", "1"}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"09c1599d-ab65-4a72-8b2d-2e0a33014481"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "25"}], ",", 
   RowBox[{"2", "\[Rule]", "98"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"832271f5-3030-4e80-a6d9-439014d70f66"]
}, Open  ]]
