    }], "TableText",ExpressionUUID->"b6b97885-2539-42ec-b6c2-40b38676dabf"], 
    Cell[TextData[{
     "in general neither: a pair is an edge only when a third point or one of \
the two lies within ",
     StyleBox["r", "TI"],
     " of both"
    }], "TableText",ExpressionUUID->"15a69066-fc30-48c0-8cd2-edbd2ad874e1"]}
