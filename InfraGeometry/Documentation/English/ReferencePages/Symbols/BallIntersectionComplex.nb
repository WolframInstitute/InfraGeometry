     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["Automatic"]], "paclet:ref/Automatic"},
       "RefLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "c813240c-50da-4af6-8b69-d7442a2b1aec"],
     ", the region is not empty"
    }], "TableText",ExpressionUUID->"bba4cef0-8fac-4af4-a44a-c404ce60290a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
