Cell[CellGroupData[{

Cell["Metric", "ExampleSubsection",ExpressionUUID->"78a68417-fbab-4dca-bc67-4cc988af7c7c"],

Cell["\<\
On a path two vertices at distance 2 have balls of radius 1 that meet at the \
vertex between them. With the distance matrix of the two vertices alone that \
vertex is not a candidate, and the balls do not meet.\
\>", "ExampleText",ExpressionUUID->"474bc7a2-1e5c-4148-b0f5-aa7320d41073"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"PathGraph", "[", 
      RowBox[{"Range", "[", "5", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraBall", "[", 
          RowBox[{"1", ",", " ", "1"}], "]"}], ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{"3", ",", " ", "1"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"BallIntersectionComplex", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", "1", ",", " ", "2", ",",
        " ", 
       RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"BallIntersectionComplex", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", "1", ",", " ", "2", ",",
        " ", 
       RowBox[{"\"\<Metric\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "2"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "0"}], "}"}]}], "}"}]}]}], "]"}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"24d86351-ceb9-4f19-acf4-15b2447b8e38"],

