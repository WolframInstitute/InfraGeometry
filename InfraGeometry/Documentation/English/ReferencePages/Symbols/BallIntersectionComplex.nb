Notebook[{

Cell[CellGroupData[{
Cell["BallIntersectionComplex", "ObjectName",ExpressionUUID->"1addc257-6d3f-4fad-b3a7-63a6d2b2844a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d73c504d-715b-4270-978b-12efb9ff1430"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cdb70c03-89b4-44f4-9f5d-2036b01a7d59"],
 "\[LineSeparator]",
 "gives the order-",
 StyleBox["k", "TI"],
 " complex of the closed balls of radius ",
 StyleBox["r", "TI"],
 " about the points of ",
 StyleBox["data", "TI"],
 ": a set of balls is a simplex when every ",
 StyleBox["k", "TI"],
 " of them have a common point.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e8be00d9-073f-4a37-a354-c913768f2970"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff8fac33-e0c2-4982-aba2-e47bf076cec2"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["k", "TI"],
 " = ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5183ca3f-a5a6-4530-af68-7e29e43e4ce8"],
 ", the \[CapitalCHacek]ech complex."
}], "Usage",ExpressionUUID->"c9cbe6e2-200d-4633-8f55-1f119724ce59"],

Cell[TextData[{
 "Definition: let ",
 StyleBox["B_i", "TI"],
 " be the closed ball of radius ",
 StyleBox["r", "TI"],
 " about the ",
 StyleBox["i", "TI"],
 "-th point. A set ",
 StyleBox["\[Sigma]", "TI"],
 " of positions is a simplex of ",
 StyleBox["C^(k)_r", "TI"],
 " when every subset of ",
 StyleBox["\[Sigma]", "TI"],
 " with ",
 StyleBox["min(k, |\[Sigma]|)", "TI"],
 " elements has balls with a common point."
}], "Notes",ExpressionUUID->"fde9a491-274a-445b-9479-edb8f2b770eb"],

Cell[TextData[{
 "At ",
 StyleBox["k = 2", "TI"],
 " every pair of balls meets. For Euclidean points that is the \
Vietoris\[Dash]Rips complex at scale ",
 StyleBox["2r", "TI"],
 ", the pairs at distance at most ",
 StyleBox["2r", "TI"],
 " and every set all of whose pairs are such. At ",
 StyleBox["k", "TI"],
 " = ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5d085201-e65c-4122-84e1-019142cef7c0"],
 " all the balls of ",
 StyleBox["\[Sigma]", "TI"],
 " meet: the \[CapitalCHacek]ech complex, the nerve of the balls. In between \
the complexes are nested, ",
 StyleBox["C^(2) \[SupersetEqual] C^(3) \[SupersetEqual] \[Ellipsis] \
\[SupersetEqual]", "TI"],
 " \[CapitalCHacek]ech."
}], "Notes",ExpressionUUID->"fbce7f9f-f643-454c-bd25-8e4840da9662"],

Cell[TextData[{
 "Balls in ",
 StyleBox["\:211d^d", "TI"],
 " are convex, and by Helly's theorem the ladder stops at ",
 StyleBox["k = d + 1", "TI"],
 ": in the plane order 3 is already \[CapitalCHacek]ech. On a graph it may go \
further."
}], "Notes",ExpressionUUID->"ae42b09d-d035-417d-b0e8-5c30c775510b"],

Cell[TextData[{
 "A simplex is a sorted list of positions in ",
 StyleBox["data", "TI"],
 ", not of the points themselves. The complex is built level by level, a set \
being tested only when all its faces are in, so it is closed under faces."
}], "Notes",ExpressionUUID->"e21162cf-b2e4-4501-b6b1-ccbff6e8b455"],

Cell[TextData[{
 "Euclidean balls about the points have a common point when their centres fit \
in a ball of radius ",
 StyleBox["r", "TI"],
 ", the test of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MiniballRadius"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/MiniballRadius", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3fe30eb1-18c7-4727-acce-390e224a120b"],
 "."
}], "Notes",ExpressionUUID->"610de639-9880-4ed7-a0ca-62420b8f244a"],

Cell["Options:", "Notes",ExpressionUUID->"c646b7a3-cb2a-4c59-bf90-13d2687caf19"],

