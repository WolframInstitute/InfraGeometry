Cell[TextData[{
 "The edges of order 2 are the pairs at distance at most ",
 StyleBox["2r", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"77bd8d34-a8e2-4194-a8ae-1f79b5473f7f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"data", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "3"}], "]"}], ",",
         " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"BallIntersectionComplex", "[", 
       RowBox[{"data", ",", " ", "1", ",", " ", "2", ",", " ", 
        RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}]}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "2"}], " ", 
       "&"}]}], "]"}], " ", "===", "\n", "    ", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"Subsets", "[", 
       RowBox[{
        RowBox[{"Range", " ", "@", " ", 
         RowBox[{"Length", "[", "data", "]"}]}], ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "##"}], "]"}], " ", "<=", " ", "2"}], " ", 
         "&"}], " ", "@@", " ", 
        RowBox[{"data", "[", 
         RowBox[{"[", "#", "]"}], "]"}]}], " ", "&"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0b4acb14-f708-4149-963b-b931271be4a4"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f80c7bf0-94c2-4d1b-9def-b92163205341"]
}, Open  ]],

Cell["\<\
For points in the plane order 3 is the \[CapitalCHacek]ech complex. The \
lattice points of the ball of radius 3, at radius 1.2:\
\>", "ExampleText",ExpressionUUID->"fc4d50f8-bb72-4466-acfa-55e97e09261b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "3"}], ",", " ", "3"}], "]"}], ",", " ", "2"}], "]"}],
        ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"Abs", "[", "#", "]"}], "]"}], " ", "<=", " ", "3"}], " ", 
        "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"BallIntersectionComplex", "[", 
       RowBox[{"points", ",", " ", "1.2", ",", " ", "3"}], "]"}], " ", "===", 
      " ", 
      RowBox[{"BallIntersectionComplex", "[", 
       RowBox[{"points", ",", " ", "1.2"}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"Length", " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"BallIntersectionComplex", "[", 
         RowBox[{"points", ",", " ", "1.2", ",", " ", "2"}], "]"}], ",", " ", 
        
        RowBox[{"BallIntersectionComplex", "[", 
         RowBox[{"points", ",", " ", "1.2"}], "]"}]}], "}"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4f6b31ee-0c8b-449d-873d-0984a9657b0e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"{", 
    RowBox[{"1759", ",", "1247"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"7f4a22bf-f369-4a57-b79e-3dd1202a74f5"]
