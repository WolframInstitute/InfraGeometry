Cell[TextData[{
 "With a graph ",
 StyleBox["g", "TI"],
 " the balls meet when some vertex of ",
 StyleBox["g", "TI"],
 " lies within ",
 StyleBox["r", "TI"],
 " of every centre, so order 2 is again the Vietoris\[Dash]Rips complex at ",
 StyleBox["2r", "TI"],
 ". With a matrix or a function the common point must be a point of ",
 StyleBox["data", "TI"],
 "."
}], "Notes",ExpressionUUID->"a756dc08-3a4e-4108-af14-72a5c236a267"]
}, Open  ]],

