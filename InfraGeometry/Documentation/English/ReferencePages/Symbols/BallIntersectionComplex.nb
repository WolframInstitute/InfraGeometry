Cell[TextData[{
 "The vertices within distance 3 of the centre of the grid, at radius 1, with \
the graph metric. The number of simplices of each size at orders 2, 3, 4 and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "54fa8007-2b6c-4d65-8fa8-4f0c6543f38c"],
 ". Orders 2 and 3 agree, and so do 4 and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5e748e2a-b939-441e-9afc-1d4548826164"],
 "; the 12 sets of four between them are the squares of the grid:"
}], "ExampleText",ExpressionUUID->"ec45db62-4be4-46a4-82c5-3826639a8483"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"data", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "3"}], "]"}], ",",
         " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Counts", "[", 
      RowBox[{"Length", " ", "/@", " ", 
       RowBox[{"BallIntersectionComplex", "[", 
        RowBox[{"data", ",", " ", "1", ",", " ", "k", ",", " ", 
         RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}]}], "]"}]}], "]"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3", ",", " ", "4", ",", " ", "Infinity"}], 
        "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"44ce884e-95eb-43db-8769-ea5fcadbed26"],

