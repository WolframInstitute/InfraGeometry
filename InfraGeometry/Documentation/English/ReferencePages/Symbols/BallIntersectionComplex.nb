Cell[CellGroupData[{

Cell["IntersectionTest", "ExampleSubsection",ExpressionUUID->"c6517c49-92c3-422c-83e1-81a8bf320a93"],

Cell["\<\
At radius 0.6 the three disks about the triangle meet in a small region. \
Asking for a common region of area more than 0.05 drops the triangle.\
\>", "ExampleText",ExpressionUUID->"92fb5319-6e60-4318-9c94-37576d674fae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"CirclePoints", "[", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", "3", "]"}]}], ",", " ", "3"}], "]"}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"StandardBlue", ",", " ", 
          RowBox[{"Opacity", "[", "0.15", "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Disk", "[", 
             RowBox[{"#", ",", " ", "0.6"}], "]"}], " ", "&"}], " ", "/@", 
           " ", "points"}]}], "}"}], ",", " ", 
        RowBox[{"Point", "[", "points", "]"}]}], "}"}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"BallIntersectionComplex", "[", 
      RowBox[{"points", ",", " ", "0.6", ",", " ", "Infinity", ",", " ", 
       RowBox[{"\"\<IntersectionTest\>\"", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"RegionMeasure", "[", "#", "]"}], " ", ">", " ", "0.05"}], 
          " ", "&"}], ")"}]}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"18044f21-2ed7-4730-a654-e4ec31b335e7"],

