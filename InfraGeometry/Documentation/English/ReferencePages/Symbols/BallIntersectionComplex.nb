Cell[CellGroupData[{

Cell["Metric", "ExampleSubsection",ExpressionUUID->"989a4385-2c4e-4e38-8a6f-4440428b6f68"],

Cell["\<\
On a path two vertices at distance 2 have balls of radius 1 that meet at the \
vertex between them. With the distance matrix of the two vertices alone that \
vertex is not a candidate, and the balls do not meet.\
\>", "ExampleText",ExpressionUUID->"1a01fc97-ffe8-4bda-b20a-ede205891c8d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
