      FontSize->0.9 Inherited,ExpressionUUID->
      "09f15bff-2a7f-4eef-9e2e-54c94078e028"],
     " draws the substrate in its own embedding"
    }], "TableText",ExpressionUUID->"8ffa989d-6c76-478d-a65a-239932e5e154"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f2855196-e2b6-4a0a-8898-4481b47805db"], Cell[TextData[Cell[
    BoxData["\"\<Inflate\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a9338d7b-56cb-4d40-bd53-ac280b387a7a"]], "TableText",ExpressionUUID->
     "26192854-2fe6-4da5-84c7-2145def9af90"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "41b43306-589a-4adf-b101-16a4af788a16"]], "TableText",ExpressionUUID->
     "f7e3718a-88c3-4cf8-80e0-7a87c32ad2d2"], Cell[TextData[{
     "a number of extra vertices over every vertex, a range ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"min", ",", " ", "max"}], "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8b3bc928-2998-423a-aef8-6289971d8b5f"],
