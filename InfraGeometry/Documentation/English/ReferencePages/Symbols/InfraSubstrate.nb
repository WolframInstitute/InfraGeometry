Cell[TextData[{
 "The square torus substrate is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TorusTessellation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TorusTessellation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "23d24b8c-3bdd-4210-8baa-730090d66bff"],
 " graph, placed in space."
}], "ExampleText",ExpressionUUID->"7f286b15-08d7-4f0e-aa32-53481ebae1ce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"g", ",", " ", 
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"EdgeList", "[", "g", "]"}]}], " ", "===", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"EdgeList", " ", "@", " ", 
        RowBox[{"TorusTessellation", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"10", ",", " ", "10"}], "}"}], ",", 
          " ", "\"\<Square\>\""}], "]"}]}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5c197b5d-0c47-4d7b-9044-a3ecef2a8713"],

