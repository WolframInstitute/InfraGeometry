     FontSize->0.9 Inherited,ExpressionUUID->
     "5753fe32-b752-43ac-9186-9b637877bf9a"]], "TableText",ExpressionUUID->
     "972d9949-8e3c-49b1-980c-531edd76e47b"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "eaa10467-a3a6-4e62-ad2e-fad26ad673ed"]], "TableText",ExpressionUUID->
     "09f66941-5d0c-48ba-86dc-fac824f950b4"], Cell[TextData[{
     "a number of extra vertices over every vertex, a range ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"min", ",", " ", "max"}], "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9e98c2e4-0414-4c33-a748-545a3c09a326"],
