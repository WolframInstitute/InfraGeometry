Cell[TextData[{
 "The rim cuts large balls. On the small grid the ball about the centre has \
",
 StyleBox["2r\.b2 + 2r + 1", "TI"],
 " vertices only up to radius 4:"
}], "ExampleText",ExpressionUUID->"7ea47cf9-52d5-4b98-b25d-9a608fe5b6e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
        " ", "\"\<CountingMeasure\>\""}], "]"}], " ", "-", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"r", "^", "2"}]}], " ", "+", " ", 
        RowBox[{"2", " ", "r"}], " ", "+", " ", "1"}], ")"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "0", ",", " ", "7"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1f914107-ac10-4d7c-a417-4790ff45386b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", 
   RowBox[{"-", "2"}], ",", 
   RowBox[{"-", "10"}], ",", 
   RowBox[{"-", "26"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f5d7f614-a938-4321-8c66-fcbac06fa573"]
}, Open  ]]
