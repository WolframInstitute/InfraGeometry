     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f8864fb6-00ae-44db-b97a-d40277fed9e6"],
     " draws the substrate in its own embedding"
    }], "TableText",ExpressionUUID->"cfb277af-4a14-4c07-874b-8e32ba3465a6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5fa7a904-3735-4ab4-8792-a31915db89b7"], Cell[TextData[Cell[
    BoxData["\"\<Inflate\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "943beb73-e081-4caa-97dd-663f797ac81c"]], "TableText",ExpressionUUID->
     "719b739c-ab00-4590-b398-c8a775463093"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6f54c268-3d05-4dcc-b266-c462078186df"]], "TableText",ExpressionUUID->
     "c83d33d5-7f97-47bf-b07c-17ab0787c226"], Cell[TextData[{
     "a number of extra vertices over every vertex, a range ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"min", ",", " ", "max"}], "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "60f0568f-e775-45a4-8b2c-f75fe76ffe85"],
     ", or an option list for ",
     Cell[BoxData["InflateGraph"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "626e54c9-7d64-496a-b1c8-a33d7a687cc4"]
    }], "TableText",ExpressionUUID->"ffc909a5-709e-4a7d-9b84-3ae405c43081"]}
  }]], "3ColumnTableMod",ExpressionUUID->"7bd54688-4074-4411-bd29-\
ea0d7a84d21e"],

Cell[TextData[{
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d311330d-42ff-422a-abf7-9c1df424a6be"],
 " options are passed on to the graph. The backdrop style is the substrate \
style of the size: gray edges and small gray vertices, lighter as the \
substrate grows."
}], "Notes",ExpressionUUID->"06de6b67-2d27-4c19-ba50-d8a7f02551b0"]
}, Open  ]],

