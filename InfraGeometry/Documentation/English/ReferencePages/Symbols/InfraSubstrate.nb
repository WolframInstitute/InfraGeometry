Cell[TextData[{
 "By default the discretized square is laid out by springs. With ",
 Cell[BoxData[
  RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c97d254c-de13-4faa-8244-11019626908f"],
 " it is drawn in the unit square it was cut from."
}], "ExampleText",ExpressionUUID->"c38f013f-0fec-40f7-8f67-7b9b3a173327"],

