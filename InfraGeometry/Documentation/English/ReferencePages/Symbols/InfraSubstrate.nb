     "f33fe45c-9501-401e-b049-91e41472f732"], Cell[TextData[{
     "a number of extra vertices over every vertex, a range ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"min", ",", " ", "max"}], "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f66f3a8e-c571-4a34-bf31-c32bd35e072d"],
