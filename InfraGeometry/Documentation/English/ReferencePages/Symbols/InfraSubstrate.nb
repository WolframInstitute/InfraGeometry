Cell["\<\
The square grid is a grid graph without its corners and its border edges:\
\>", "ExampleText",ExpressionUUID->"30894975-d452-4f78-b87c-1e35d09469e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"10", ",", " ", "10"}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"border", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "h", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexDegree", "[", 
          RowBox[{"h", ",", " ", "#"}], "]"}], " ", "<", " ", "4"}], " ", 
        "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"IsomorphicGraphQ", "[", 
    RowBox[{
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}], ",",
      "\n", "    ", 
     RowBox[{"VertexDelete", "[", 
      RowBox[{
       RowBox[{"EdgeDelete", "[", 
        RowBox[{"h", ",", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"EdgeList", "[", "h", "]"}], ",", " ", 
           RowBox[{
            RowBox[{"SubsetQ", "[", 
             RowBox[{"border", ",", " ", 
              RowBox[{"List", " ", "@@", " ", "#"}]}], "]"}], " ", "&"}]}], 
          "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "10", ",", " ", "91", ",", " ", "100"}], 
        "}"}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0e092d3b-dd2a-4cb3-acac-bcd86070e15a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c2b9b32a-07dd-4587-8813-540573f637c0"]
}, Open  ]],

Cell[TextData[{
 "The square torus is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TorusTessellation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TorusTessellation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "874bcc6b-4fcd-4fa8-b67c-9e3bea881223"],
 " graph:"
}], "ExampleText",ExpressionUUID->"8e6e5f6d-786b-46bf-a7fa-d74335b3194d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{"EdgeList", " ", "@", " ", 
    RowBox[{"InfraSubstrate", "[", 
     RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\""}], 
     "]"}]}]}], " ", "===", " ", 
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{"EdgeList", " ", "@", " ", 
    RowBox[{"TorusTessellation", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"10", ",", " ", "10"}], "}"}], ",", " ", "\"\<Square\>\""}], 
     "]"}]}]}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e8f19ceb-21e9-455c-89d7-50f798f356d4"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"32c54db6-43ec-474e-9469-b14047ff8c15"]
}, Open  ]]
