Cell[TextData[{
 "The rim cuts large balls. On the small grid the ball about the centre has \
",
 StyleBox["2r\.b2 + 2r + 1", "TI"],
 " vertices only up to radius 4:"
}], "ExampleText",ExpressionUUID->"168b37f2-531e-45f2-b886-49633023adc4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
