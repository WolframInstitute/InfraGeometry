     FontSize->0.9 Inherited,ExpressionUUID->
     "0d08ba3c-0a48-41e4-a717-1ccfd0899d76"]], "TableText",ExpressionUUID->
     "972225cf-6341-4569-95e6-c06dfd9b8524"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
