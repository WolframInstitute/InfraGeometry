Cell[TextData[{
 "The three tilings of the plane are cut from the infinite tiling as \
graph-distance balls. The three tori are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TorusTessellation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TorusTessellation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fa1667ea-b501-464c-afd4-eaf9d188d3ae"],
 " graphs placed on a torus of revolution."
}], "Notes",ExpressionUUID->"34267867-ed2e-4813-9c91-6b797b2b5c73"],

Cell[TextData[{
 "A Wolfram-model universe is named ",
 Cell[BoxData["\"\<wm\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b87079bc-1034-4ec6-ae4d-c294bb324396"],
 " followed by its number in the Registry of Notable Universes. Any of the \
947 entries resolves, through ",
 Cell[BoxData[
  RowBox[{"ResourceFunction", "[", "\"\<WolframModelData\>\"", "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8224344c-478f-4b5e-870d-cd9cdf644e1f"],
 ", so this needs the network."
}], "Notes",ExpressionUUID->"cf9b1d3d-32e6-492b-bcbb-3e7260f8ae17"],

Cell[TextData[{
 StyleBox["size", "TI"],
 " may also be a raw value: the cell measure of a mesh, the radius of a \
tiling, the dimensions of a grid, the generation count of a Wolfram model or \
a fractal."
}], "Notes",ExpressionUUID->"eb910ece-595d-4c82-9b46-1a6e34b3177d"],

Cell[TextData[{
 "A substrate is ",
 StyleBox["bare combinatorics",
  FontWeight->"Bold"],
 " by default. A stored embedding is discarded, and a spring layout of the \
substrate's own dimension places the vertices. ",
 Cell[BoxData[
  RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5497c6bd-a8d9-4a6e-b3c4-b6bf636b6cee"],
 " draws the substrate where it lives. Every figure on a patch of the plane \
sets it."
}], "Notes",ExpressionUUID->"6a9f0d1b-c20e-4dbe-b8e3-d672b9e442d2"],

Cell[TextData[{
 "A patch has a rim, and the rim is not geometry. Anchor a construction at \
the centre, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCenter"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCenter", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "73a181f6-22a2-440e-a261-9c46a7f87ca6"],
 ", and keep it well inside the patch, or the figure shows boundary effects."
}], "Notes",ExpressionUUID->"37cdbdcb-d2fb-4061-9bd8-b35a82a799c5"],

Cell[TextData[{
 "A substrate built by a random construction \[LongDash] a uniform-length \
ellipsoid, or any substrate with ",
 Cell[BoxData["\"\<Inflate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d4f25f1-4399-407c-968a-5d4e482a1f8e"],
 " \[LongDash] is seeded from outside. ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "992ea17c-5418-4c65-aa00-a0f2f71a0911"],
 " in front of the call gives the same graph again."
}], "Notes",ExpressionUUID->"08a5da92-959b-4881-a642-4fc155ee4aaa"],

Cell["Options:", "Notes",ExpressionUUID->"da59164c-5d71-4cbb-bb19-107c77aa07d3"],

