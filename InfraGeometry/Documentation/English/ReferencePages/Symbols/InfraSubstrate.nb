Cell["KeepCoordinates", "ExampleSubsection",ExpressionUUID->"e217c24e-d22e-42fc-8256-20b36dc9dbd9"],

Cell[TextData[{
 "By default the discretized square is laid out by springs. With ",
 Cell[BoxData[
  RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b1012d8-4af8-4f27-bdaf-b85ae5e5e655"],
 " it is drawn in the unit square it was cut from."
}], "ExampleText",ExpressionUUID->"820df03b-46f9-41c2-9e95-2810d2824e5c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"{", "\n", "  ", 
   RowBox[{
    RowBox[{"InfraSubstrate", "[", 
     RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
