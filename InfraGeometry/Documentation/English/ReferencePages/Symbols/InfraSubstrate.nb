 RowBox[{
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{"EdgeList", " ", "@", " ", 
    RowBox[{"InfraSubstrate", "[", 
     RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\""}], 
     "]"}]}]}], " ", "===", "\n", "  ", 
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{"EdgeList", " ", "@", " ", 
    RowBox[{"TorusTessellation", "[", 
     RowBox[{
      RowBox[{"{", 
