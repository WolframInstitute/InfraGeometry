    BoxData["\"\<Inflate\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f0fac5e4-af8f-455c-864e-ba09a988adb1"]], "TableText",ExpressionUUID->
     "5aa72037-5a2b-4284-b6d5-97120acde075"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2cb57703-b9c0-45f1-a873-5378af5bcbeb"]], "TableText",ExpressionUUID->
     "ac07c974-3354-4f47-b4c3-4a1e8a86c69d"], Cell[TextData[{
     "a number of extra vertices over every vertex, a range ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"min", ",", " ", "max"}], "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "961abf17-4e59-41f2-99bc-31f60bc5ab54"],
