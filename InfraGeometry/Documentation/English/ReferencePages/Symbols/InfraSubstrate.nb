Cell["\<\
The shell of radius 4 about the centre, on the discretized plane, the square \
tiling and the hexagonal tiling. The same definition gives three different \
shapes.\
\>", "ExampleText",ExpressionUUID->"206a6e51-e323-4db9-ad4c-33d03149c62d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Labeled", "[", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"FindInfraShell", "[", 
             RowBox[{"g", ",", " ", "c", ",", " ", "4"}], "]"}], ",", " ", 
            "c"}], "}"}]}], "]"}], ",", " ", "name"}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"efd388d5-cf64-463a-8bde-5a941d4eb65e"],

