      "ca839a4e-0b78-4eec-a3bf-4c33fde5f4d6"]
    }], "TableText",ExpressionUUID->"d69c0c30-6c61-4237-854f-7500ea0057a0"]}
  }]], "3ColumnTableMod",ExpressionUUID->"e2773207-f045-4527-840c-\
8e9c776cb6ca"],

Cell[TextData[{
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a0d6c65-a80d-472d-b168-278d83cbde48"],
 " options are passed on to the graph. The backdrop style is the substrate \
style of the size: gray edges and small gray vertices, lighter as the \
substrate grows."
}], "Notes",ExpressionUUID->"670d80ae-5841-4513-baaa-343c13e9f3d1"]
}, Open  ]],

