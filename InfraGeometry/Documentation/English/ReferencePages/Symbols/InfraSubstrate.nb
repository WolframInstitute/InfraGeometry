Cell["\<\
The square grid is a grid graph without its corners and its border edges:\
\>", "ExampleText",ExpressionUUID->"080d1c8f-ea4c-434e-87ff-0f65fb5c9c72"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"10", ",", " ", "10"}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"border", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "h", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexDegree", "[", 
          RowBox[{"h", ",", " ", "#"}], "]"}], " ", "<", " ", "4"}], " ", 
        "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"IsomorphicGraphQ", "[", 
    RowBox[{
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}], ",",
      "\n", "    ", 
     RowBox[{"VertexDelete", "[", 
      RowBox[{
       RowBox[{"EdgeDelete", "[", 
        RowBox[{"h", ",", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"EdgeList", "[", "h", "]"}], ",", " ", 
           RowBox[{
            RowBox[{"SubsetQ", "[", 
             RowBox[{"border", ",", " ", 
              RowBox[{"List", " ", "@@", " ", "#"}]}], "]"}], " ", "&"}]}], 
          "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "10", ",", " ", "91", ",", " ", "100"}], 
        "}"}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2806c612-64b8-4f4e-a1cc-bb6e48ee47fe"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ecc1fa88-3a59-4136-bcf7-975e90468352"]
}, Open  ]],

Cell[TextData[{
 "The square torus is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TorusTessellation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TorusTessellation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2ff59849-da98-4383-bf95-de3862cb3b8d"],
 " graph:"
}], "ExampleText",ExpressionUUID->"e16400d0-3af9-46e4-9eff-cf278ffa1f95"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{"EdgeList", " ", "@", " ", 
    RowBox[{"InfraSubstrate", "[", 
     RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\""}], 
     "]"}]}]}], " ", "===", " ", 
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{"EdgeList", " ", "@", " ", 
    RowBox[{"TorusTessellation", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"10", ",", " ", "10"}], "}"}], ",", " ", "\"\<Square\>\""}], 
     "]"}]}]}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5cc99252-8eae-41d9-8f90-bebf49cdbf08"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"486e01b8-8e60-4f3b-9870-23949c373360"]
}, Open  ]]
}, Open  ]],

