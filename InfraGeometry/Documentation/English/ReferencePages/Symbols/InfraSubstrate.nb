Cell["KeepCoordinates", "ExampleSubsection",ExpressionUUID->"112a713c-fd82-497c-82b5-63aeaca36459"],

Cell[TextData[{
 "By default the discretized square is laid out by springs. With ",
 Cell[BoxData[
  RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e37d0797-e189-47c3-82fd-b0596e0cd527"],
 " it is drawn in the unit square it was cut from."
}], "ExampleText",ExpressionUUID->"68d4634d-3b4d-4926-8f5a-1e733ea1c0ba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"{", "\n", "  ", 
   RowBox[{
    RowBox[{"InfraSubstrate", "[", 
     RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
      RowBox[{"ImageSize", " ", "->", " ", "200"}]}], "]"}], ",", "\n", "  ", 
    
