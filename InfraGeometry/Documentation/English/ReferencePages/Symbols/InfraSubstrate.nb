Cell[TextData[{
 "The square grid of side ",
 StyleBox["n", "TI"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GridGraph"]], "paclet:ref/GridGraph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2c42d830-33d1-4b05-b35f-0d9766b9da01"],
 "[{",
 StyleBox["n", "TI"],
 ", ",
 StyleBox["n", "TI"],
 "}] without its corners and without the edges along its border, so every rim \
vertex has one neighbour; Small is ",
 StyleBox["n", "TI"],
 " = 10, Medium ",
 StyleBox["n", "TI"],
 " = 17. The pendant rim is intended: the small grid has 32 vertices of \
degree 1, and the 64 others have the four neighbours of the plane lattice. \
Its vertex coordinates are integers and its distance is the \[ScriptL]\.b9 \
distance. The square mesh is an irregular triangulation of the unit square."
}], "Notes",ExpressionUUID->"302707d3-3236-486a-9a71-5eee42c3d5c9"],

Cell[TextData[{
 "A patch has a rim, and the rim is not geometry. Anchor a construction at \
the centre, ",
 Cell[BoxData[
  RowBox[{"First", " ", "@", " ", 
   RowBox[{"GraphCenter", "[", "g", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9e74a85-76fb-4928-a48b-829f1f4064ea"],
 ", and keep it inside. A closed surface, such as ",
 Cell[BoxData["\"\<SphereMeshGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f9a8374-4a2c-42c8-bb6a-bd9c408ff8a5"],
 " or a torus, has no rim."
}], "Notes",ExpressionUUID->"8585f12c-1d4d-42da-b8a5-026cfc7c041f"],

Cell[TextData[{
 StyleBox["size", "TI"],
 " can also be a raw value: the dimensions of a grid or a torus, or one \
number ",
 StyleBox["n", "TI"],
 " for the side ",
 StyleBox["n", "TI"],
 " in every direction, the cell measure of a mesh, the radius of a tiling, a \
generation count. A Wolfram model universe ",
 Cell[BoxData["\"\<wm\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79919835-5b59-4578-af3f-93b6f437eeb7"],
 " followed by its number in the Registry of Notable Universes needs the \
network."
}], "Notes",ExpressionUUID->"99cdc558-ecf6-4934-9315-72da3f3aed3f"],

Cell[TextData[{
 "A substrate built by a random construction is seeded with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "35caa49f-0f7c-425a-b56c-b6dac868c1a6"],
 " in front of the call."
}], "Notes",ExpressionUUID->"2b19008f-a9ad-4480-a7fc-b78b3d85ec4a"],

