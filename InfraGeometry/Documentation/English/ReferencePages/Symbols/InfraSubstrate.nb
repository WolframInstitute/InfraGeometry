Cell[TextData[{
 "The square grid of side ",
 StyleBox["n", "TI"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GridGraph"]], "paclet:ref/GridGraph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "13a937f0-b58b-4f3c-93ce-4d2260dc8838"],
 "[{",
 StyleBox["n", "TI"],
 ", ",
 StyleBox["n", "TI"],
 "}] without its corners and without the edges along its border, so every rim \
vertex has one neighbour; Small is ",
 StyleBox["n", "TI"],
 " = 10, Medium ",
 StyleBox["n", "TI"],
 " = 17. Its vertex coordinates are integers and its distance is the \
\[ScriptL]\.b9 distance. The square mesh is an irregular triangulation of the \
unit square."
}], "Notes",ExpressionUUID->"a22a518c-3bcd-4643-8281-04782d790c55"],

Cell[TextData[{
 "A patch has a rim, and the rim is not geometry. Anchor a construction at \
the centre, ",
 Cell[BoxData[
  RowBox[{"First", " ", "@", " ", 
   RowBox[{"GraphCenter", "[", "g", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f05b6ae-9f4e-45a9-9d69-95de4f044279"],
 ", and keep it inside. A closed surface, such as ",
 Cell[BoxData["\"\<SphereMeshGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42316133-96f8-402a-bedd-d7c39a28fb23"],
 " or a torus, has no rim."
}], "Notes",ExpressionUUID->"631858e2-c5ba-4ed0-960c-b3c1436888f9"],

Cell[TextData[{
 StyleBox["size", "TI"],
 " can also be a raw value: the dimensions of a grid, the cell measure of a \
mesh, the radius of a tiling, a generation count. A Wolfram model universe ",
 Cell[BoxData["\"\<wm\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a22a572-a698-441b-a04e-9555fbf67c32"],
 " followed by its number in the Registry of Notable Universes needs the \
network."
}], "Notes",ExpressionUUID->"2435a982-364d-4e8f-b327-c1fa191e0534"],

Cell[TextData[{
 "A substrate built by a random construction is seeded with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9d9f2c26-8a2b-451b-8a77-2c8527bd1ead"],
 " in front of the call."
}], "Notes",ExpressionUUID->"a6183f18-1c80-457c-aab9-33f8f37cec00"],

