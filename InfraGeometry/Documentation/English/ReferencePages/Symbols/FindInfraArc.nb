 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"15b8df3c-4d2d-4d92-84a8-b74261b43196"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57fa71a4-e0a2-489d-b459-1b3fae9de65a"],
 "\[LineSeparator]",
 "gives one minor arc around ",
 StyleBox["c", "TI"],
 " from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ", as a vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"423080ba-34a6-422c-a2d2-8f779f0c7c4b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pk", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8637e783-b1ef-43b7-bf04-3ff98e53a6dc"],
 "\[LineSeparator]",
 "gives one polyline of minor arcs, from each point to the next.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"48816c0d-512c-48a7-bf28-3ecc0150a124"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea9d11c9-3442-465f-b2a3-3b2c4b8863ce"],
 "\[LineSeparator]",
 "gives one circle around ",
 StyleBox["c", "TI"],
 " through ",
 StyleBox["p", "TI"],
 ", as a cyclic vertex list: the closed arc ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["p", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cfbdee7c-1912-46ea-ac3f-d3017bff6959"],
 " read as a search.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d1720af3-29ee-48f9-bf29-bc2e8ed557d7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraArc"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraArc", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["points", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a7735ba-6b31-4a67-81b9-b9beddfdec84"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0417a198-c1eb-44ff-bf34-c15f439f7c9e"],
 " of exactly ",
 StyleBox["n", "TI"],
 " arcs, or ",
 Cell[BoxData[
  RowBox[{"{", " ", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97ba018d-fc53-4941-8499-4dc6539c77df"],
 " when there are fewer; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
