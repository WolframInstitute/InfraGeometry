Cell["\<\
One of the eight minor arcs of a quarter circle of radius 3 about the centre \
of a grid, on the band widened one step each way, drawn as a walk.\
\>", "ExampleText",ExpressionUUID->"56d7d895-cb93-43fc-afdf-e2266e17d506"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"found", " ", "=", " ", 
     RowBox[{"FindInfraArc", "[", 
      RowBox[{"g", ",", " ", "41", ",", " ", 
       RowBox[{"{", 
        RowBox[{"14", ",", " ", "44"}], "}"}], ",", " ", 
       RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}]}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"InfraWalk", "[", "found", "]"}], " ", "->", " ", 
          "$InfraCircleColor"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "41", 
         ",", " ", "14", ",", " ", "44"}], "}"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
     "   ", "found"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9cb2689f-510e-4659-8157-1f2d345dc008"],

