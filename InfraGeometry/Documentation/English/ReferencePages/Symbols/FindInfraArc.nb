Cell["\<\
A minor arc of the circle of radius 3 about the centre, on the band widened \
one step each way, on the square, hexagonal and triangular tilings.\
\>", "ExampleText",ExpressionUUID->"b8a0969b-b5b2-4879-9349-a0a8d84034ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"oneArc", " ", "=", " ", 
        RowBox[{"FindInfraArc", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", 
          RowBox[{"{", 
           RowBox[{"p", ",", " ", "q"}], "}"}], ",", " ", 
          RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "1"}], "}"}]}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraWalk", "[", "oneArc", "]"}], " ", "->", " ", 
           "$InfraCircleColor"}], ",", " ", 
          RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c", 
          ",", " ", "p", ",", " ", "q"}], "}"}]}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a99cb4ba-5f75-4f43-9d77-536eaba03fcc"],

