     RowBox[{"p1", ",", " ", "...", ",", " ", "pk"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aebc44a9-66fc-4224-afc0-976ed5b5f7f7"],
 "."
}], "Notes",ExpressionUUID->"34e693a4-35d1-41be-ab74-6b958048f45d"],

