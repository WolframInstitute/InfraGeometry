   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e357b58b-de0d-43a0-b202-bd52475bda6b"],
 " uses for a closed arc."
}], "Notes",ExpressionUUID->"aebd08d3-ff36-4156-a1fc-9175873fbda7"],

