Cell[TextData[{
 "Searches the band graph directly \[LongDash] ",
 Cell[BoxData["FindPath"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "592b6d2c-5fd0-4d1b-a569-60da0db8f688"],
 " at the band distance between consecutive points, folded together at the \
knots \[LongDash] independently of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
