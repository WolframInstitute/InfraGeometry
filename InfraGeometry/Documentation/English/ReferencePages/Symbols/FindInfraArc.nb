Cell["\<\
One of the eight minor arcs of a quarter circle of radius 3 about the centre \
of a grid, on the band widened one step each way, drawn as a walk.\
\>", "ExampleText",ExpressionUUID->"08a5df6b-cf7a-4a48-8b92-865333a7bdca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"found", " ", "=", " ", 
     RowBox[{"FindInfraArc", "[", 
      RowBox[{"g", ",", " ", "41", ",", " ", 
       RowBox[{"{", 
        RowBox[{"14", ",", " ", "44"}], "}"}], ",", " ", 
       RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}]}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraHighlightGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"InfraWalk", "[", "found", "]"}], " ", "->", " ", 
          "$InfraCircleColor"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "41", 
         ",", " ", "14", ",", " ", "44"}], "}"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
     "   ", "found"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"51034fae-b87d-479d-a842-ac9420521d45"],

