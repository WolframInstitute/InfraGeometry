 "."
}], "Notes",ExpressionUUID->"90ef076c-2bf8-47b2-ba9a-3538e043dc7e"],

Cell[TextData[{
 "The closed form ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"p", ",", " ", "p"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "433b8294-7a03-4eb7-87ed-26e463d2f29f"],
