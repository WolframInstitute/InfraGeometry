Cell[TextData[{
 "A walk ",
 StyleBox["(v\:2080, \[Ellipsis], v\:2096)", "TI"],
 " is a shortest path when consecutive vertices are adjacent and ",
 StyleBox["k = d(v\:2080, v\:2096)", "TI"],
 "."
}], "Notes",ExpressionUUID->"b7faf8f1-7dc9-41dc-b7be-72a9cf347079"],

Cell[TextData[{
 "A walk of one vertex gives ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a70249d7-49e6-4acb-ace4-c0e6c819150e"],
 "."
}], "Notes",ExpressionUUID->"87aa7a1d-8d74-4e7f-adf3-62f16dc25713"],

Cell[TextData[{
 "The predicate takes walks, not objects: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "91ec54bb-7699-4788-af96-d8951cc4bfda"],
 " stays unevaluated. To test whether a walk is a member of a given segment, \
use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "01523498-f459-422d-a207-6017232e3329"],
 "."
}], "Notes",ExpressionUUID->"efc5fc0a-b47c-46ad-a7ac-4ba4936f55c4"],

Cell[TextData[{
 "A walk can be given as a path graph, and the graph of a segment, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26f71d58-2a32-408d-a9a8-904c4b1e20dd"],
 ", is a DAG whose source-to-sink paths are its members."
}], "Notes",ExpressionUUID->"821bc13c-7988-4a0b-a4f1-025845d08031"],

