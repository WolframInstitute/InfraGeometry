Cell["InfraSegmentQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5df2ef5c-f665-4d74-a8db-a2d757b38fa4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c29c549-6b23-4b0a-acef-603191f944fa"],
 "\[LineSeparator]",
 "tests whether the vertex list ",
 StyleBox["walk", "TI"],
 " is a geodesic of ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"240663e9-747e-4f0f-80cf-fb52969b1c3c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["walk1", "TI"], ",", " ", 
      StyleBox["walk2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52d81684-1aa5-4b02-9205-3ed783791b34"],
 "\[LineSeparator]",
 "tests whether every walk in the list is a geodesic.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a0b84089-8127-405d-a43f-358161a4c0e8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["dag", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "161ddbf0-2bc9-48bc-b58a-d26a77950c87"],
 "\[LineSeparator]",
 "tests a walk graph or a directed acyclic graph: every source-to-sink path \
must be a geodesic."
}], "Usage",ExpressionUUID->"5a774b1c-5b80-40c5-ac12-bdccf6a68131"],

Cell[TextData[{
 "A walk {",
 StyleBox["v0", "TI"],
 ", \[Ellipsis], ",
 StyleBox["vk", "TI"],
 "} is a geodesic when consecutive vertices are adjacent and ",
 StyleBox["k", "TI"],
 " = ",
 StyleBox["d(v0, vk)", "TI"],
 ": no shorter walk joins its ends."
}], "Notes",ExpressionUUID->"b7763dcb-2e64-4869-bcc6-738779be36eb"],

Cell[TextData[{
 "The predicate takes a walk, never an object. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59cd81d2-7f12-4752-bc0b-2de62d433b67"],
 " stays unevaluated. Test a member of the segment, or the segment's graph, \
or ask ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b9aaff22-13f1-4314-a248-1b8d38fafdc0"],
 " whether a walk belongs to one particular segment."
}], "Notes",ExpressionUUID->"f6ad77a9-01b4-421a-b389-09e26628b0ab"],

Cell[TextData[{
 "A single vertex is not a segment, so a walk of one vertex gives ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56879625-7267-4c14-a1b4-90c9adf95cdc"],
 "."
}], "Notes",ExpressionUUID->"09a3b77d-5d01-4f6e-99d6-e2fd3c7b546c"],

Cell[TextData[{
 "A list of walks is the shape ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9e57215f-051b-43cb-bd5b-ad4f96048ff1"],
 " returns with a count, and the graph of a segment, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a18531b-24e0-4caf-a831-7605e50a82ff"],
 ", is a DAG. So the output of either can be passed straight in."
}], "Notes",ExpressionUUID->"59b160b9-ce59-466a-bd03-f45a37b1a9b3"],

Cell[TextData[{
 "Inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "92e8575e-7ccd-434e-a5f7-ace0296f8bd5"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraSegmentQ", "[", "s", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67c5ff39-5782-470e-9d50-f01ff0df6fb8"],
 " with one argument is the assertion that the binding ",
 StyleBox["s", "TI"],
 " is a geodesic. The scene supplies the graph."
}], "Notes",ExpressionUUID->"76b85a3e-149f-44f6-9a28-0f98b42426e4"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraGeodesicQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraGeodesicQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d76e9287-1be0-4fd1-8368-654f488052f7"],
 " is the local version: every window of a given number of steps is a \
geodesic. At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f391f468-4294-4ff7-b8ef-85f21a442645"],
 " it is this predicate."
}], "Notes",ExpressionUUID->"4b64aba5-296e-4bce-bb54-b8e36d30e4c2"]
