Cell["A list of walks, and the graph of a segment.", "ExampleText",ExpressionUUID->"69be4163-87c5-453a-8582-64d93259f351"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSegmentQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"RandomInfraSegment", "[", 
        RowBox[{"g", ",", " ", "1", ",", " ", "13", ",", " ", "All"}], 
        "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"InfraSegmentQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSegment", "[", 
          RowBox[{"1", ",", " ", "13"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
        "]"}]}], "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f10c363e-6b4e-4a7b-bd31-57eeecafcb8b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"8833fb23-475e-44db-a2c3-2ed3daddac45"]
}, Open  ]]
}, Open  ]],

