Cell["\<\
Two walks from the same start to the same end. The first is a geodesic; the \
second makes a detour.\
\>", "ExampleText",ExpressionUUID->"6eb32eeb-d50b-4732-9e0d-1dda39381987"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Row", "[", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"InfraWalk", "[", "w", "]"}], ",", " ", 
            RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
            RowBox[{"First", "[", "w", "]"}], ",", " ", 
            RowBox[{"Last", "[", "w", "]"}]}], "}"}], ",", "\n", "        ", 
          RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}], ",", " ", 
          RowBox[{"ImageSize", " ", "->", " ", "180"}]}], "]"}], ",", "\n", 
        "      ", 
        RowBox[{"InfraSegmentQ", "[", 
         RowBox[{"g", ",", " ", "w"}], "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"w", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "1", ",", " ", "2", ",", " ", "3", ",", " ", "8", ",", " ", "13"}],
            "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
           "1", ",", " ", "6", ",", " ", "7", ",", " ", "2", ",", " ", "3", ",",
             " ", "8", ",", " ", "13"}], "}"}]}], "}"}]}], "}"}]}], "]"}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f9bb19bb-4141-412f-8d93-711886f96cb1"],

