Cell["\<\
Two walks from the same start to the same end. The first is a shortest path; \
the second makes a detour.\
\>", "ExampleText",ExpressionUUID->"1bd626cb-9b1f-4641-84a7-976c82077be0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Row", "[", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"InfraWalk", "[", "w", "]"}], ",", " ", 
            RowBox[{"First", "[", "w", "]"}], ",", " ", 
            RowBox[{"Last", "[", "w", "]"}]}], "}"}], ",", "\n", "        ", 
          RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}], ",", " ", 
          RowBox[{"ImageSize", " ", "->", " ", "180"}]}], "]"}], ",", "\n", 
        "      ", 
        RowBox[{"InfraSegmentQ", "[", 
         RowBox[{"g", ",", " ", "w"}], "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"w", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "1", ",", " ", "2", ",", " ", "3", ",", " ", "8", ",", " ", "13"}],
            "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
           "1", ",", " ", "6", ",", " ", "7", ",", " ", "2", ",", " ", "3", ",",
             " ", "8", ",", " ", "13"}], "}"}]}], "}"}]}], "}"}]}], "]"}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0cbaf8be-b33a-4008-a14c-f28d1acaa8cc"],

