Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cbe6a441-3443-4d06-9368-5d9330377216"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
