Cell["\<\
A shortest path from the centre to a vertex at distance 4, and a walk between \
the same two vertices through a vertex off the segment:\
\>", "ExampleText",ExpressionUUID->"148e9929-e2ab-4df6-95b4-2033a019ae9c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"x", " ", "=", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraIntersection", "[", 
           RowBox[{
            RowBox[{"InfraShell", "[", 
             RowBox[{"a", ",", " ", "3"}], "]"}], ",", " ", 
            RowBox[{"InfraShell", "[", 
             RowBox[{"b", ",", " ", "3"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"path", " ", "=", " ", 
         RowBox[{"FindShortestPath", "[", 
          RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}], ",", " ", 
        RowBox[{"detour", " ", "=", " ", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"FindShortestPath", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "x"}], "]"}], ",", " ", 
           RowBox[{"Rest", " ", "@", " ", 
            RowBox[{"FindShortestPath", "[", 
             RowBox[{"g", ",", " ", "x", ",", " ", "b"}], "]"}]}]}], 
          "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraWalk", "[", "path", "]"}], ",", " ", 
          RowBox[{"InfraWalk", "[", "detour", "]"}], ",", " ", "a", ",", " ", 
          "b"}], "}"}], ",", "\n", "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraSegmentQ", "[", 
            RowBox[{"g", ",", " ", "path"}], "]"}], ",", " ", 
           RowBox[{"InfraSegmentQ", "[", 
            RowBox[{"g", ",", " ", "detour"}], "]"}]}], "}"}]}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"f0717325-f223-4a7f-ab03-cceb9826d1be"],

