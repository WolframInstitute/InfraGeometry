Cell["\<\
A detour can be geodesic at every small scale and still not be a geodesic. \
Every two-step window of the second walk above is a shortest path.\
\>", "ExampleText",ExpressionUUID->"8bb97f2e-ba10-455f-9e31-9b65383e910b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"g", " ", "=", " ", 
      RowBox[{"GridGraph", "[", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"w", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
       "1", ",", " ", "6", ",", " ", "7", ",", " ", "2", ",", " ", "3", ",", 
        " ", "8", ",", " ", "13"}], "}"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraGeodesicQ", "[", 
      RowBox[{"g", ",", " ", "w", ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"InfraSegmentQ", "[", 
      RowBox[{"g", ",", " ", "w"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"282f086f-0307-4f67-ab38-d07229ef304c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"dd16c4e7-353e-42b2-858f-9a505afa0f02"]
}, Open  ]],

Cell["Every line is a geodesic.", "ExampleText",ExpressionUUID->"00134afb-2c40-493a-bfe8-c31741eada62"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSegmentQ", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "6", ",", " ", "7", ",", " ", "All"}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8f616a9c-0d33-4a42-8c95-62206c51aa48"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"94d1b17a-99e3-4039-bade-2bc361f42391"]
}, Open  ]],

Cell["\<\
On the 6-cycle the walk halfway round is a geodesic; one step more is not.\
\>", "ExampleText",ExpressionUUID->"425646ac-951e-4c47-b070-bc9fcd8db1b1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"InfraSegmentQ", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}]}], 
    "]"}], ",", " ", 
   RowBox[{"InfraSegmentQ", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "5"}], 
      "}"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"a85536dc-1643-4daf-931b-9f4573a8797a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"4b5f0ee8-571d-440f-8aae-bffd793020de"]
}, Open  ]]
}, Open  ]],

