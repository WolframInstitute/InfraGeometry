Cell["InfraSegmentQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"26662b74-70e7-4fcc-9478-d16350fc0f41"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f6d92ac-82cd-468b-ab47-37bf8efb8e10"],
 "\[LineSeparator]",
 "tests whether the vertex list ",
 StyleBox["walk", "TI"],
 " is a geodesic of ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6cfe692f-7a06-4223-a5a7-849dab00f8dc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["walk1", "TI"], ",", " ", 
      StyleBox["walk2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86c8470f-6004-4723-8ce8-c849fbe9d7bb"],
 "\[LineSeparator]",
 "tests whether every walk in the list is a geodesic.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4efa5203-0461-4e02-9b6d-df69e298e6d0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["dag", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5be42c84-8d5b-4445-8daa-52992e96d215"],
 "\[LineSeparator]",
 "tests a walk graph or a directed acyclic graph: every source-to-sink path \
must be a geodesic."
}], "Usage",ExpressionUUID->"c6605c64-316c-4837-adc1-15fb04eecddf"],

Cell[TextData[{
 "A walk {",
 StyleBox["v0", "TI"],
 ", \[Ellipsis], ",
 StyleBox["vk", "TI"],
 "} is a geodesic when consecutive vertices are adjacent and ",
 StyleBox["k", "TI"],
 " = ",
 StyleBox["d(v0, vk)", "TI"],
 ": no shorter walk joins its ends."
}], "Notes",ExpressionUUID->"b5fcdf3e-2b1f-40e5-8ea5-5ddce14c3ffb"],

Cell[TextData[{
 "The predicate takes a walk, never an object. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9cb6b01a-caa8-4d05-b002-37e6559a7341"],
 " stays unevaluated. Test a member of the segment, or the segment's graph, \
or ask ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f137de3f-ec99-4e1d-975a-3a8f1e4b15c9"],
 " whether a walk belongs to one particular segment."
}], "Notes",ExpressionUUID->"a7f08961-0e14-4530-9cdb-ed1d8bb7b12e"],

Cell[TextData[{
 "A single vertex is not a segment, so a walk of one vertex gives ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e3875df-17b7-44cc-8a84-a71284301e1e"],
 "."
}], "Notes",ExpressionUUID->"bfd2dd6d-f5b2-403f-997f-9c1ef39ed688"],

Cell[TextData[{
 "A list of walks is the shape ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8e7f94e3-d0e1-4503-aab4-e7164b609464"],
 " returns with a count, and the graph of a segment, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9dece9a9-ac71-45c1-9bf6-687370de50be"],
 ", is a DAG. So the output of either can be passed straight in."
}], "Notes",ExpressionUUID->"0f14e44e-a1a8-4414-96c8-c1e7220725c1"],

Cell[TextData[{
 "Inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "db57064d-78e0-4b4d-8053-0a0f2830f662"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraSegmentQ", "[", "s", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8926a4e8-1596-42a1-a682-4d289afe12b0"],
 " with one argument is the assertion that the binding ",
 StyleBox["s", "TI"],
 " is a geodesic. The scene supplies the graph."
}], "Notes",ExpressionUUID->"6d9c72fd-355d-40c3-bfca-4a8b2d6a7564"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraGeodesicQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraGeodesicQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "888b8ecc-dab3-4f13-8d82-8dcfadcea4f1"],
 " is the local version: every window of a given number of steps is a \
geodesic. At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d20b8f3c-62ec-419d-bbfa-b25387ca32b6"],
 " it is this predicate."
}], "Notes",ExpressionUUID->"62dcb236-7294-44b1-867b-6f8629b92485"]
