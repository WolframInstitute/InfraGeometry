Cell["\<\
A detour can be geodesic at every small scale and still not be a geodesic. \
Every two-step window of the second walk above is a shortest path.\
\>", "ExampleText",ExpressionUUID->"b7557722-b1c9-453e-883b-d136b9b9a901"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"g", " ", "=", " ", 
      RowBox[{"GridGraph", "[", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"w", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
       "1", ",", " ", "6", ",", " ", "7", ",", " ", "2", ",", " ", "3", ",", 
        " ", "8", ",", " ", "13"}], "}"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraGeodesicQ", "[", 
      RowBox[{"g", ",", " ", "w", ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"InfraSegmentQ", "[", 
      RowBox[{"g", ",", " ", "w"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"27a1ed6b-c530-4988-b173-974623109287"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"538a8198-4796-42b5-8fb0-1a2564826e72"]
}, Open  ]],

Cell["Every line is a geodesic.", "ExampleText",ExpressionUUID->"41efe837-8cec-4335-9864-406af0fc7fa1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSegmentQ", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "6", ",", " ", "7", ",", " ", "All"}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"04039bdf-8f21-4a1c-b173-60dc62fb5311"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"ad4e4112-fde0-4a50-8aae-61649a0b88a2"]
}, Open  ]],

Cell["\<\
On the 6-cycle the walk halfway round is a geodesic; one step more is not.\
\>", "ExampleText",ExpressionUUID->"0aceea52-4a3c-4f89-ac64-7fb77cec8240"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"InfraSegmentQ", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}]}], 
    "]"}], ",", " ", 
   RowBox[{"InfraSegmentQ", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "5"}], 
      "}"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"6f556fc8-6f84-44fe-83c4-39de7253ca9d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"56a8ad5c-2f96-487b-8ae9-9eca58ee0137"]
}, Open  ]]
}, Open  ]],

