  FontSize->0.9 Inherited,ExpressionUUID->
  "3da2f416-effe-47a8-9ff8-7f5ddbf73cdf"],
 "\[LineSeparator]",
 "tests whether the vertex list ",
 StyleBox["walk", "TI"],
 " is a shortest path of ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"331be9d5-2321-4301-9702-05d00edaddca"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["walk1", "TI"], ",", " ", 
      StyleBox["walk2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96d249b3-ebb4-40ea-a260-5223e4356b13"],
 "\[LineSeparator]",
 "tests whether every walk in the list is a shortest path.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"aba9434e-ff69-43e3-b054-710104996977"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["dag", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6771cadf-4ffd-4be6-8d04-166c6163c11f"],
 "\[LineSeparator]",
 "tests a walk graph or a directed acyclic graph: every source-to-sink path \
must be a shortest path."
}], "Usage",ExpressionUUID->"a87c9679-9c9d-4f72-b796-15374ca55276"],

Cell[TextData[{
 "A walk {",
 StyleBox["v0", "TI"],
 ", \[Ellipsis], ",
 StyleBox["vk", "TI"],
 "} is a shortest path when consecutive vertices are adjacent and ",
 StyleBox["k", "TI"],
 " = ",
 StyleBox["d(v0, vk)", "TI"],
 ": no shorter walk joins its ends."
}], "Notes",ExpressionUUID->"3cfb8499-b41c-4aa8-b324-78a2ce5c9602"],

Cell[TextData[{
 "The predicate takes a walk, never an object. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e57cc00-a700-44bb-bf71-c979486adb61"],
 " stays unevaluated. Test a member of the segment, or the segment's graph, \
or ask ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "089b9b19-399f-4913-9a20-02a8d04b97a6"],
 " whether a walk belongs to one particular segment."
}], "Notes",ExpressionUUID->"a2fa9935-3ca3-46a5-8984-45982d39cc95"],

Cell[TextData[{
 "A single vertex is not a segment, so a walk of one vertex gives ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "705eca7a-b816-4d66-91d4-3cf7362ad3e6"],
 "."
}], "Notes",ExpressionUUID->"08102c4b-a062-4400-834d-280c68dbf76d"],

Cell[TextData[{
 "A list of walks is the shape ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "23f62009-ec09-4655-bfc2-74c9482e3a09"],
 " returns with a count, and the graph of a segment, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a791d9ea-86d9-4ba1-80ee-976101135eab"],
 ", is a DAG. So the output of either can be passed straight in."
}], "Notes",ExpressionUUID->"264f80d8-95ef-4651-aca1-6dfc905bdeb0"],

Cell[TextData[{
 "Inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4f442d00-293b-4f21-b35b-a47e3f1a0f2e"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraSegmentQ", "[", "s", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db898056-eb3c-4e37-8517-c623166e669b"],
 " with one argument is the assertion that the binding ",
 StyleBox["s", "TI"],
 " is a shortest path. The scene supplies the graph."
}], "Notes",ExpressionUUID->"b769cbf7-92e9-4376-8c5f-d3f76ab86591"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraGeodesicQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraGeodesicQ", 
