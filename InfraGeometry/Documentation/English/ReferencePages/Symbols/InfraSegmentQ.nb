Cell["\<\
Two walks from the same start to the same end. The first is a geodesic; the \
second makes a detour.\
\>", "ExampleText",ExpressionUUID->"29ddb58a-afe1-4950-9217-121f914bb081"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Row", "[", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"InfraWalk", "[", "w", "]"}], ",", " ", 
            RowBox[{"First", "[", "w", "]"}], ",", " ", 
            RowBox[{"Last", "[", "w", "]"}]}], "}"}], ",", "\n", "        ", 
          RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}], ",", " ", 
          RowBox[{"ImageSize", " ", "->", " ", "180"}]}], "]"}], ",", "\n", 
        "      ", 
        RowBox[{"InfraSegmentQ", "[", 
         RowBox[{"g", ",", " ", "w"}], "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"w", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "1", ",", " ", "2", ",", " ", "3", ",", " ", "8", ",", " ", "13"}],
            "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
           "1", ",", " ", "6", ",", " ", "7", ",", " ", "2", ",", " ", "3", ",",
             " ", "8", ",", " ", "13"}], "}"}]}], "}"}]}], "}"}]}], "]"}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6c263593-6d95-4b3b-a472-2e463a2a47cb"],

