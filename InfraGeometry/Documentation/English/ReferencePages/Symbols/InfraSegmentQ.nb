Cell["InfraSegmentQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b424d0d2-aa35-4340-be83-1679bc8e9dcf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63be5957-02c6-4e8a-b71d-51c43c7a3af6"],
 "\[LineSeparator]",
 "tests whether the vertex list ",
 StyleBox["walk", "TI"],
 " is a geodesic of ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3477f493-148b-4b5e-9bb9-a26a8c6246d7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["walk1", "TI"], ",", " ", 
      StyleBox["walk2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c313a67b-b19a-4751-be12-fd2306632cdc"],
 "\[LineSeparator]",
 "tests whether every walk in the list is a geodesic.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"36c3d198-0cdc-438d-83e4-bd285c5b462e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["dag", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec47fc14-526d-4e32-a8e1-cfd7a6c953ec"],
 "\[LineSeparator]",
 "tests a walk graph or a directed acyclic graph: every source-to-sink path \
must be a geodesic."
}], "Usage",ExpressionUUID->"cd5e8db3-0cb3-4a4f-8ebf-c25a65b26e36"],

Cell[TextData[{
 "A walk {",
 StyleBox["v0", "TI"],
 ", \[Ellipsis], ",
 StyleBox["vk", "TI"],
 "} is a geodesic when consecutive vertices are adjacent and ",
 StyleBox["k", "TI"],
 " = ",
 StyleBox["d(v0, vk)", "TI"],
 ": no shorter walk joins its ends."
}], "Notes",ExpressionUUID->"e483bc09-d2dd-4ccd-99cc-922a07b89421"],

Cell[TextData[{
 "The predicate takes a walk, never an object. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14ee9cb6-10b4-4c06-9e80-735a18babce1"],
 " stays unevaluated. Test a member of the segment, or the segment's graph, \
or ask ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b02a932f-ae4e-456a-b71c-6a30b604b6cb"],
 " whether a walk belongs to one particular segment."
}], "Notes",ExpressionUUID->"8632af10-d524-4970-9e33-8b57be6aba02"],

Cell[TextData[{
 "A single vertex is not a segment, so a walk of one vertex gives ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ccdff20-146d-4d16-8a2b-47c48c80cd82"],
 "."
}], "Notes",ExpressionUUID->"66d90ac9-e816-4bb4-8e16-6fae6e8c9200"],

Cell[TextData[{
 "A list of walks is the shape ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3eb11467-2103-4e89-83b9-baa5e050bbac"],
 " returns with a count, and the graph of a segment, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dfbc2c9d-93d7-42cf-a969-0dd8158e0fbf"],
 ", is a DAG. So the output of either can be passed straight in."
}], "Notes",ExpressionUUID->"cb5381ed-89e2-4f0d-9dbd-29c7dbf65274"],

Cell[TextData[{
 "Inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "45095f67-b17b-45d9-b95d-5f4c969e7939"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraSegmentQ", "[", "s", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8bd2fdd-7202-4df1-a12c-9f613e4a2d8c"],
 " with one argument is the assertion that the binding ",
 StyleBox["s", "TI"],
 " is a geodesic. The scene supplies the graph."
}], "Notes",ExpressionUUID->"ba92b0e1-ef08-4499-9e59-938e6a65b099"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraGeodesicQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraGeodesicQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a486f0c6-510d-4cf9-8b32-53c9c1d189f6"],
 " is the local version: every window of a given number of steps is a \
geodesic. At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bf78e73-2767-4339-9b0e-9b3d2023a2cf"],
 " it is this predicate."
}], "Notes",ExpressionUUID->"a61ff7b9-e5a0-4917-ae7f-a9cae67185a4"]
