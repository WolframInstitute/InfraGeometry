Cell["InfraSegmentQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fdc3025a-0068-48e9-8d81-cb34ff837965"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9e12216-2d3d-4f15-b501-c016ef1b1b47"],
 "\[LineSeparator]",
 "tests whether the vertex list ",
 StyleBox["walk", "TI"],
 " is a geodesic of ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"893a6572-5113-4492-acea-09d3af4162d6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["walk1", "TI"], ",", " ", 
      StyleBox["walk2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e6467b6-25b6-49b2-9681-ea9c3d157509"],
 "\[LineSeparator]",
 "tests whether every walk in the list is a geodesic.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b388f662-95af-43a3-9c1f-31a8e67c6a1a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["dag", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94d2c912-da99-4e7b-9ae0-e8dbd1f491b4"],
 "\[LineSeparator]",
 "tests a walk graph or a directed acyclic graph: every source-to-sink path \
must be a geodesic."
}], "Usage",ExpressionUUID->"0d893611-66bf-405f-9fab-4cb59f3684b2"],

Cell[TextData[{
 "A walk {",
 StyleBox["v0", "TI"],
 ", \[Ellipsis], ",
 StyleBox["vk", "TI"],
 "} is a geodesic when consecutive vertices are adjacent and ",
 StyleBox["k", "TI"],
 " = ",
 StyleBox["d(v0, vk)", "TI"],
 ": no shorter walk joins its ends."
}], "Notes",ExpressionUUID->"db0c4e17-23ed-4ad2-8a34-c1fbd66bd38b"],

Cell[TextData[{
 "The predicate takes a walk, never an object. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegmentQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69ba0268-31d6-48c5-95dd-d8ccf5f930d1"],
 " stays unevaluated. Test a member of the segment, or the segment's graph, \
or ask ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7b32349e-3312-480d-908e-ad0b424ded5e"],
 " whether a walk belongs to one particular segment."
}], "Notes",ExpressionUUID->"89f7d171-33b4-4e27-8d57-d0b90b8414af"],

Cell[TextData[{
 "A single vertex is not a segment, so a walk of one vertex gives ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70c2795f-9602-42da-82d8-95ee5416165f"],
 "."
}], "Notes",ExpressionUUID->"3f312fe7-02e4-410d-8cff-4238d9c9d2d7"],

Cell[TextData[{
 "A list of walks is the shape ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "22820037-8694-4b2c-bf0f-e047072882cc"],
 " returns with a count, and the graph of a segment, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "310d1f51-d8e8-4b45-9a1c-db776c8ed118"],
 ", is a DAG. So the output of either can be passed straight in."
}], "Notes",ExpressionUUID->"5cb5d7cb-b1ab-40ee-b2ba-85b78ef78dbe"],

Cell[TextData[{
 "Inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "358bbc2f-d3e4-42d6-9b16-abe6f54acc16"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraSegmentQ", "[", "s", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cbbef0f-b837-4e08-b8b1-7a4b401e6bad"],
 " with one argument is the assertion that the binding ",
 StyleBox["s", "TI"],
 " is a geodesic. The scene supplies the graph."
}], "Notes",ExpressionUUID->"3be55e32-7028-43d7-8964-d949b5c23f5f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraGeodesicQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraGeodesicQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "444171d8-8dcf-4c3e-a091-8350d95be9b6"],
 " is the local version: every window of a given number of steps is a \
geodesic. At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dee5946c-6239-4d00-a21d-fe991dd4614d"],
 " it is this predicate."
}], "Notes",ExpressionUUID->"a85dfa8e-f48b-489c-9eaf-70be4a493a76"]
