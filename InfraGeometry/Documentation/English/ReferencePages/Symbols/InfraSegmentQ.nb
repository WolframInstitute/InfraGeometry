Cell["\<\
A detour can be geodesic at every small scale and still not be a geodesic. \
Every two-step window of the second walk above is a shortest path.\
\>", "ExampleText",ExpressionUUID->"7b537190-c44d-4fe2-aa08-4627c157bb69"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"g", " ", "=", " ", 
      RowBox[{"GridGraph", "[", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"w", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
       "1", ",", " ", "6", ",", " ", "7", ",", " ", "2", ",", " ", "3", ",", 
        " ", "8", ",", " ", "13"}], "}"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraGeodesicQ", "[", 
      RowBox[{"g", ",", " ", "w", ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"InfraSegmentQ", "[", 
      RowBox[{"g", ",", " ", "w"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ab138d79-4ce6-48dc-b04d-c6df76198256"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a7537c50-24ad-4aad-8019-7cc089d47c80"]
}, Open  ]],

Cell["Every line is a geodesic.", "ExampleText",ExpressionUUID->"39084bff-c420-4c42-b3c1-0642fe3e309b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSegmentQ", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "6", ",", " ", "7", ",", " ", "All"}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d287969e-bf17-4803-92bd-a0aa85c71374"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"c0dcdea3-f583-4a23-b0c9-4956c81db5ed"]
}, Open  ]],

Cell["\<\
On the 6-cycle the walk halfway round is a geodesic; one step more is not.\
\>", "ExampleText",ExpressionUUID->"5b7d84e6-9c37-45c2-893c-498a7536945a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"InfraSegmentQ", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}]}], 
    "]"}], ",", " ", 
   RowBox[{"InfraSegmentQ", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "5"}], 
      "}"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"ac67fd7f-f0d4-42a0-af66-534f59a50092"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"9b15a254-4ad7-45f9-930c-21915486b2ff"]
}, Open  ]]
}, Open  ]],

