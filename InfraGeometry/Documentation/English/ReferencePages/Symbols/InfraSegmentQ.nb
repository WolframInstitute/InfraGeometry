Cell["\<\
A detour can be geodesic at every small scale and still not be a geodesic. \
Every two-step window of the second walk above is a shortest path.\
\>", "ExampleText",ExpressionUUID->"4ef7b8a5-78f1-461b-a6d2-d7a0c98a7643"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"g", " ", "=", " ", 
      RowBox[{"GridGraph", "[", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"w", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
       "1", ",", " ", "6", ",", " ", "7", ",", " ", "2", ",", " ", "3", ",", 
        " ", "8", ",", " ", "13"}], "}"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraGeodesicQ", "[", 
      RowBox[{"g", ",", " ", "w", ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"InfraSegmentQ", "[", 
      RowBox[{"g", ",", " ", "w"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"666043ab-398f-47f7-867f-ca6b8ef4333b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1dd20312-9596-4bc6-bd4d-37fb2b79fc73"]
}, Open  ]],

Cell["Every line is a geodesic.", "ExampleText",ExpressionUUID->"01fcccc0-e8d8-427f-9ec9-60709cae70ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSegmentQ", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "6", ",", " ", "7", ",", " ", "All"}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"339fa754-ec17-436b-80c6-2e559bc65a7f"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"c31c710d-3f74-49ff-bdb3-ee842df2db60"]
}, Open  ]],

Cell["\<\
On the 6-cycle the walk halfway round is a geodesic; one step more is not.\
\>", "ExampleText",ExpressionUUID->"7f142d24-64c6-49c4-99d6-246960381ef4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"InfraSegmentQ", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}]}], 
    "]"}], ",", " ", 
   RowBox[{"InfraSegmentQ", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "5"}], 
      "}"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"7fafe089-7175-4f64-bb9c-4a67f019455f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"1621e3f2-d95f-4e71-a358-f15dfe0ab0c9"]
}, Open  ]]
}, Open  ]],

