Cell["\<\
A detour can be geodesic at every small scale and still not be a geodesic. \
Every two-step window of the second walk above is a shortest path.\
\>", "ExampleText",ExpressionUUID->"77300962-8458-475d-bc10-22482829fc6c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"g", " ", "=", " ", 
      RowBox[{"GridGraph", "[", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"w", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
       "1", ",", " ", "6", ",", " ", "7", ",", " ", "2", ",", " ", "3", ",", 
        " ", "8", ",", " ", "13"}], "}"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraGeodesicQ", "[", 
      RowBox[{"g", ",", " ", "w", ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"InfraSegmentQ", "[", 
      RowBox[{"g", ",", " ", "w"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7a493875-f10a-44fd-854a-38714b50264b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"3d09f63c-b8b6-46b4-9f56-03b426c1c71e"]
}, Open  ]],

Cell["Every line is a geodesic.", "ExampleText",ExpressionUUID->"2761e4de-5373-4842-aa65-e88041882d12"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSegmentQ", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "6", ",", " ", "7", ",", " ", "All"}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2114287f-e3c6-40de-9ae4-93e42d05b6ea"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"99dfab81-0041-4bcb-bcfc-4299cb83080b"]
}, Open  ]],

Cell["\<\
On the 6-cycle the walk halfway round is a geodesic; one step more is not.\
\>", "ExampleText",ExpressionUUID->"caee42de-d190-4337-985b-2f16c7dfc77b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"InfraSegmentQ", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}]}], 
    "]"}], ",", " ", 
   RowBox[{"InfraSegmentQ", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "5"}], 
      "}"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"7abd8b83-eb11-4607-a35a-e6910a26e388"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"0563eb12-5d93-4c8e-a5a8-b67e0490f2ff"]
}, Open  ]]
}, Open  ]],

