Cell["A list of walks, and the graph of a segment.", "ExampleText",ExpressionUUID->"3b4475b4-1270-4b34-8f15-66a5573fabfe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSegmentQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"FindInfraSegment", "[", 
        RowBox[{"g", ",", " ", "1", ",", " ", "13", ",", " ", "All"}], 
        "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"InfraSegmentQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSegment", "[", 
          RowBox[{"1", ",", " ", "13"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
        "]"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f5c460d4-fba0-4382-a321-63417577d803"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"c8a334d2-5de8-4556-bd97-84d16004fdc8"]
}, Open  ]]
}, Open  ]],

