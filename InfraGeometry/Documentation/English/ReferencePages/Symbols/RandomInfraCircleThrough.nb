Cell["\<\
Choose two of the three minimum circles through four prescribed vertices.\
\>", "ExampleText",ExpressionUUID->"d836548c-8888-43d4-813a-01eb0cbd15a9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CompleteGraph", "[", "5", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"InfraCircleThrough", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3", ",", " ", "4", ",", " ", "5"}], "}"}], ",",
        " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"RandomInfraCircleThrough", "[", 
    RowBox[{"g", ",", " ", "circle", ",", " ", "2"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"86802b24-4561-48c3-a847-9d4d1db9d52d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "4", ",", "3", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "5", ",", "4"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"967a5b2e-b13b-43ec-8c4c-9f6069b8ced5"]
}, Open  ]],

Cell["Reuse the native carrier for repeated sampling.", "ExampleText",ExpressionUUID->"e826e2cd-8511-476c-9ade-7b3355dc2eb5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
