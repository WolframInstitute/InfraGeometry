  FontSize->0.9 Inherited,ExpressionUUID->
  "4115d0ab-b68e-42c5-b0e9-6f71badafaf3"],
 "\[LineSeparator]",
 "samples a saved native carrier Graph returned by ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{"g", ",", " ", "token", ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bca3fadc-365f-46e4-8198-072d6ab969e9"],
 "."
}], "Usage",ExpressionUUID->"23f92b40-1bbd-4534-b183-62f97bba0bcd"],

Cell[TextData[{
 "The token is ",
 Cell[BoxData[
  RowBox[{"InfraCircleThrough", "[", 
   RowBox[{"points", ",", " ", 
    RowBox[{"InfraCircle", "[", 
     RowBox[{"c", ",", " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "s"}], "}"}]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9279a4e-b631-4b54-be96-960ebad634b6"],
 ". Every requested point and the simplicity and separation constraints are \
imposed before minimizing circumference. All distinct minimum circles \
survive, with one representative per rotation/reversal class."
}], "Notes",ExpressionUUID->"10478290-466e-4510-a40b-6924027723f7"],

Cell[TextData[{
 "Omitted or ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e28c63bd-d232-4f8c-b079-178834bcaa95"],
 " count returns one cyclic vertex list. An integer returns exactly that many \
distinct representatives, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "efd33375-fe53-4f6f-8245-eedebe0a3582"],
 " on shortage. ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58674a62-9c60-4a29-abf9-c23c832639b9"],
 " returns at most ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20bd5c06-f236-48c2-a63e-1917d5df0f5d"],
 ", and ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1789808-60b7-4687-a720-cd9e92d3814e"],
 " enumerates the complete family. A valid empty family gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6d7f301-3348-44c7-b08a-239a19f7728d"],
 "."
}], "Notes",ExpressionUUID->"f5ed199f-8878-4b90-abca-41e387218c4f"],

Cell[TextData[{
 "The option ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f619b77-4168-4529-9d81-cbe6df91a441"],
 " chooses the first ranks deterministically. The default ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f546d43d-53bf-4ff1-b9f1-d8f1dd8c4abb"],
 " samples distinct ranks uniformly without replacement. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c132395a-6a79-4181-939b-c7724e0c5104"],
 " is deterministic. ",
 Cell[BoxData[
  RowBox[{"RandomSeeding", " ", "->", " ", "Automatic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a90de27-309f-4b83-89c6-748ae419294d"],
 " (default) seeds each call afresh, independently of ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c91719d7-90bd-43cd-9307-be2f35e094f3"],
 "; an integer or string gives a reproducible draw, and ",
 Cell[BoxData["Inherited"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05f340c7-64e7-4ca1-84c1-6a4b594b16ec"],
 " a local snapshot of the current state. The outer random state is restored \
afterward, as with ",
 ButtonBox["RandomInstance",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/RandomInstance.html"], 
    None}],
 "."
}], "Notes",ExpressionUUID->"8507028b-39a3-4f34-944d-e77161578099"],

Cell[TextData[{
 "Integer suffix counts support rank decoding and sampling without expanding \
the full family. Saving the native carrier lets repeated samples reuse the \
compiled graph. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4c0d3a7-3473-46a3-a747-9a66c824a3b0"],
 " expands every member."
}], "Notes",ExpressionUUID->"1377bf1a-4e3a-4668-ba54-66fda10fc1e3"]
}, Open  ]],

