  FontSize->0.9 Inherited,ExpressionUUID->
  "b45d71d8-55e6-46a1-9759-c94dcfc3d908"],
 "\[LineSeparator]",
 "gives one uniformly sampled circle from the family denoted by ",
 Cell[BoxData["token"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d33d9c22-d5d3-4680-9c87-f3c814a50519"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e9ff41cc-6f1a-4b03-bca0-81144bca81a3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraCircleThrough"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraCircleThrough", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["token", "TI"], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "558e33ce-d8d5-401a-a551-7a79e24d4149"],
 "\[LineSeparator]",
 "requests a list of distinct circles.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b10dbf88-ecc8-48fd-81ad-6cb78a68073b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraCircleThrough"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraCircleThrough", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["points", "TI"], ",", " ", 
    RowBox[{"InfraCircle", "[", 
     RowBox[{
      StyleBox["c", "TI"], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["r", "TI"], ",", " ", 
        StyleBox["s", "TI"]}], "}"}]}], "]"}], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c56a18c-8a0f-4263-8710-80e7c23f2ad5"],
 "\[LineSeparator]",
 "is the direct form.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"379d0594-695e-4419-a5fc-8474e275f168"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraCircleThrough"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraCircleThrough", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
