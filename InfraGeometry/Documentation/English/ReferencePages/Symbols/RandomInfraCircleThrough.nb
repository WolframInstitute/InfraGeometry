Cell["The graph of the family can be saved and drawn from again:", \
"ExampleText",ExpressionUUID->"bcf40750-ff1b-4e20-9f34-658fda6a798e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"carrier", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCircleThrough", "[", 
        RowBox[{
         RowBox[{"{", "p", "}"}], ",", " ", 
         RowBox[{"InfraCircle", "[", 
          RowBox[{"c", ",", " ", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}], ",", 
       " ", "\"\<Graph\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"RandomInfraCircleThrough", "[", 
       RowBox[{"carrier", ",", " ", "All"}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"RandomInfraCircleThrough", "[", 
       RowBox[{"carrier", ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], " ", "===", 
      "\n", "    ", 
      RowBox[{"RandomInfraCircleThrough", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCircleThrough", "[", 
         RowBox[{
          RowBox[{"{", "p", "}"}], ",", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
        
        RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a46ef396-eadc-4034-b000-4cebfbbf1a16"],

