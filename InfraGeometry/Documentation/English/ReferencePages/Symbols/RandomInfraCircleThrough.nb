Cell["\<\
Choose two of the three minimum circles through four prescribed vertices.\
\>", "ExampleText",ExpressionUUID->"6eebfabb-2eed-430b-83cc-2da2063c80fb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CompleteGraph", "[", "5", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"InfraCircleThrough", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3", ",", " ", "4", ",", " ", "5"}], "}"}], ",",
        " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"RandomInfraCircleThrough", "[", 
    RowBox[{"g", ",", " ", "circle", ",", " ", "2", ",", " ", 
     RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b15aa0bf-0b5b-4f7c-a243-0f92920d23f9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "4", ",", "3", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "5", ",", "4"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"401535d1-eb56-4ac6-8072-77f53093bb4e"]
}, Open  ]],

