Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"04890e41-f99a-4ffa-853c-d9bfdcea91e0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraCircleThrough"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraCircleThrough", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["token", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26f38b22-1a6c-4a6a-947d-043c1fc5d89e"],
 "\[LineSeparator]",
 "gives one uniformly sampled circle from the family denoted by ",
 Cell[BoxData["token"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05ceb52c-1c32-49a6-a59c-fa6bb4d63a1f"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e65158a0-a2c0-4b04-b377-8ba5b5668cc5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraCircleThrough"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraCircleThrough", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["token", "TI"], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "661cbdeb-e7be-443a-985d-8e5db3a2a26b"],
 "\[LineSeparator]",
 "requests a list of distinct circles.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4b8e3e81-0e48-4585-891c-05b558f0716e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraCircleThrough"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraCircleThrough", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["points", "TI"], ",", " ", 
    RowBox[{"InfraCircle", "[", 
     RowBox[{
      StyleBox["c", "TI"], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["r", "TI"], ",", " ", 
        StyleBox["s", "TI"]}], "}"}]}], "]"}], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ffc9143-bd43-473c-8a1e-caf955f9aaac"],
 "\[LineSeparator]",
 "is the direct form.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3cc52f2e-9226-483f-92e0-9c9e8a6747f6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraCircleThrough"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraCircleThrough", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["carrier", "TI"], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "124c1ad6-cc09-4e1c-9e82-3bc9a010ca8a"],
 "\[LineSeparator]",
 "samples a saved native carrier Graph returned by ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{"g", ",", " ", "token", ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b1ee58b-6724-4a9e-87fd-e9e79bd5dfcb"],
 "."
}], "Usage",ExpressionUUID->"9cda8204-d492-4d02-95e6-1335e77c615f"],

Cell[TextData[{
 "The token is ",
 Cell[BoxData[
  RowBox[{"InfraCircleThrough", "[", 
   RowBox[{"points", ",", " ", 
    RowBox[{"InfraCircle", "[", 
     RowBox[{"c", ",", " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "s"}], "}"}]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9a00d558-9934-4248-a06d-a6d0ae959508"],
 ". Every requested point and the simplicity and separation constraints are \
imposed before minimizing circumference. All distinct minimum circles \
survive, with one representative per rotation/reversal class."
}], "Notes",ExpressionUUID->"c7144e72-7a49-46f2-a0a1-7efe74a0f0f5"],

Cell[TextData[{
 "Omitted or ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db9a7048-8ed0-45b8-b7ca-d78da278f244"],
 " count returns one cyclic vertex list. An integer returns exactly that many \
distinct representatives, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4b5cb10-4553-4d08-834f-02c90c947214"],
 " on shortage. ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70f4bdc6-a34e-4f72-86a0-02e29c33b46f"],
 " returns at most ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb6442b1-7686-41ed-b03d-15f8dfc01c17"],
 ", and ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa207f36-dda4-4083-a08d-2c15e5405c78"],
 " enumerates the complete family. A valid empty family gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f699227d-26f0-44ca-a683-a2d275fbef16"],
 "."
}], "Notes",ExpressionUUID->"5034f193-c11d-414f-9f27-6e3c784dab43"],

Cell[TextData[{
 "The option ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b228efb-6760-48df-8581-9e034bb6612a"],
 " chooses the first ranks deterministically. The default ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9349dc1b-4897-4ba2-81d7-4a32beaa3613"],
 " samples distinct ranks uniformly without replacement. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6c4e98c-dbde-4fdf-a09e-ca5a953d4229"],
 " is deterministic and does not advance the random state."
}], "Notes",ExpressionUUID->"f2e0cd24-9ec8-4f6c-9831-00fe5462906d"],

Cell[TextData[{
 "Integer suffix counts support rank decoding and sampling without expanding \
the full family. Saving the native carrier lets repeated samples reuse the \
compiled graph. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2924f72-1c5a-43c0-9eab-e849d16256ab"],
 " expands every member."
}], "Notes",ExpressionUUID->"5a07b2c6-9afe-48ee-85f4-01910109756a"]
}, Open  ]],

