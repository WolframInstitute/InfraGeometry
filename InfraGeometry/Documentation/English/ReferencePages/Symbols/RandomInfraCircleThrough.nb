}], "Usage",ExpressionUUID->"bab8f252-f0b1-4975-8215-a96b2406865e"],

Cell[TextData[{
 "With ",
 StyleBox["W = {v : r \[LessEqual] d(c, v) \[LessEqual] s}", "TI"],
 ", a member is a simple cycle in ",
 StyleBox["W", "TI"],
 " that contains every ",
 StyleBox["p\:1d62", "TI"],
 " and whose removal cuts ",
 StyleBox["c", "TI"],
 " off from the vertices beyond ",
 StyleBox["W", "TI"],
 ". Among these cycles the shortest are kept."
}], "Notes",ExpressionUUID->"9c79ed44-b4ad-4a67-9cab-1d5f44d2d761"],

Cell[TextData[{
 "The points come first and the length second. So the circles through the \
points can be longer than the circles of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc65b99e-5c5d-45a9-af0f-d5e7ca2848ce"],
 "."
}], "Notes",ExpressionUUID->"e349d4f1-4e1e-445d-813d-2aa8da4151d2"],

Cell[TextData[{
 "A point outside the band, or one with fewer than two neighbours in it, \
gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0557a172-7546-4663-bf28-631f1a05f507"],
 "."
}], "Notes",ExpressionUUID->"61765060-b832-4194-85e3-dfc40bf6d230"],

Cell[TextData[{
 "The draw is uniform over the circles. A circle is a vertex list ",
 StyleBox["v\:2081, \[Ellipsis], v\:2096", "TI"],
 ", the edge ",
 StyleBox["v\:2096v\:2081", "TI"],
 " closing it."
}], "Notes",ExpressionUUID->"6cc6fa94-dda2-4498-bf51-e48c2b341113"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e1fdba1-df2c-4379-a757-4d6a49558838"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea78e875-c9fd-49e3-a5ce-6152bf8f2386"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d5b0515-abc1-4e6a-9ecc-b902d6261a7d"],
 ". The search runs over vertex sets and can take very long on a wide band."
}], "Notes",ExpressionUUID->"3e3e7452-9e8c-4acb-a65e-b8facba416e6"],

