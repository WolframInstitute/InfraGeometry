Cell["\<\
Two lines through the centre. On the grid they share two vertices, on the \
mesh only the centre:\
\>", "ExampleText",ExpressionUUID->"4a5a72ed-4be3-4a91-ad15-3f070212e147"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"l1", " ", "=", " ", 
         RowBox[{"RandomInfraInfiniteLine", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", 
           RowBox[{"RandomInfraPoint", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraShell", "[", 
              RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
             RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", 
           " ", 
           RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], ",", 
        "\n", "     ", 
        RowBox[{"l2", " ", "=", " ", 
         RowBox[{"RandomInfraInfiniteLine", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", 
           RowBox[{"RandomInfraPoint", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraShell", "[", 
              RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
             RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}], ",", 
           " ", 
           RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}]}], "}"}],
       ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraWalk", "[", "l1", "]"}], ",", " ", 
          RowBox[{"InfraWalk", "[", "l2", "]"}], ",", " ", 
          RowBox[{"FindInfraCommonPoint", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"l1", ",", " ", "l2"}], "}"}]}], "]"}]}], "}"}], ",", 
        "\n", "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"FindInfraCommonPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", 
            RowBox[{"l1", ",", " ", "l2"}], "}"}]}], "]"}]}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"9c83d2f5-7851-4949-92f1-27fcd70ea746"],

