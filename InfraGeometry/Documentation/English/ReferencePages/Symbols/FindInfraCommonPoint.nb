Cell["\<\
A list of walks counts as one line, the union of its members. Each member \
must be its own entry to intersect them:\
\>", "ExampleText",ExpressionUUID->"50583350-ae43-46ad-ace3-afadd645e58b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "5"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraCommonPoint", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", "members", "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"FindInfraCommonPoint", "[", 
      RowBox[{"g", ",", " ", "members"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"54f886f9-4549-4ca9-85e4-7fe9a0d4f777"],

