  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a28a8cb4-1141-4838-9b44-1498ef985d4d"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c6a9ea4-e382-45e9-ab55-e657e55e7d59"],
 ", the default. Fewer than ",
 StyleBox["n", "TI"],
 " common points give ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "704f8cab-670b-4809-adb4-e9ceb2504faf"],
 "."
}], "Notes",ExpressionUUID->"f63e2b28-6ffd-4592-a887-9212e89f0687"],

Cell["Corresponding notion in the classical axiom systems:", "Notes",ExpressionUUID->"65ba675d-f517-4b11-b9e1-ecfbb1827909"],

