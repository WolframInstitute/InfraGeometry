Cell[CellGroupData[{
Cell["InfraShell", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4e8ffc9e-a7d1-42ea-b426-8d02a8fa879c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8f52e5c-7b13-44f7-a4e6-f98fff83daba"],
 "\[LineSeparator]",
 "is the shell about ",
 StyleBox["c", "TI"],
 ": the vertices at distance between ",
 StyleBox["r", "TI"],
 " and ",
 StyleBox["s", "TI"],
 ". It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3f7ba850-1b01-4173-896e-6a8128333c52"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "00bbfbeb-17df-44c6-b77e-cda3f4ed34de"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2c3a3a0a-1c8b-4341-8ccf-05e63fa7aba9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c8660f3-bdf2-4ce1-87c2-fa2449844920"],
 "\[LineSeparator]",
 "is the band {",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["r", "TI"],
 "}: the vertices at distance exactly ",
 StyleBox["r", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"54ae1a7d-c486-4f02-b8a1-493cb8957016"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2369a93e-73bb-4bbc-b792-1c3010f4847f"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "60dfba0a-d0c3-4527-9e28-e3744bed1c71"],
 " is the shell construction token."
}], "Usage",ExpressionUUID->"f3f6c639-caba-4d51-ad29-60b1251cc0f5"],

Cell[TextData[{
 "Definition: the shell of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " is ",
 StyleBox["S_r(c) = {v : d(c, v) = r}", "TI"],
 ", a level set of the distance from ",
 StyleBox["c", "TI"],
 "; the band is ",
 StyleBox["{v : r \[LessEqual] d(c, v) \[LessEqual] s}", "TI"],
 ". ",
 StyleBox["c", "TI"],
 " is a vertex or a vertex list, and then ",
 StyleBox["d(v, C) = min d(v, c)", "TI"],
 "."
}], "Notes",ExpressionUUID->"0ffc4f01-919b-4d21-997c-95db84dac090"],

Cell[TextData[{
 "The head holds the centre and the band and computes nothing. A shell has \
one member, the vertex set, so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0faaac90-9dcf-411a-a20a-f644ee578023"],
 " gives it as a sorted vertex list. It owns the same seven properties as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "97d4f61d-c29f-4f36-8116-e2455b2429af"],
 ", the measures among them; the shell area ",
 StyleBox["A(r)", "TI"],
 " is the ",
 Cell[BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbce174e-30c7-4d3e-a35f-cb224ce4a1ab"],
 " of the shell, and its ",
 Cell[BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1237a733-d0bc-4672-9573-f288167cae66"],
 " is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5aff31eb-bd25-47b1-b986-d884cb92000b"],
 ", since every vertex of a shell touches the complement."
}], "Notes",ExpressionUUID->"5d6c317b-7bbb-44dc-bf31-edd9dec49065"],

Cell[TextData[{
 "A shell is a set of points. The connected subsets of it that separate the \
centre from the outside are the family ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a2547077-5548-4a79-b0a8-bbc6b2177910"],
 "."
}], "Notes",ExpressionUUID->"40194a78-395f-4584-895e-51fea3613320"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aeb6adb1-3bfd-4601-bc08-791d0db0a578"],
 " is the level set as a function; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9fccdf6e-4dbe-4c4e-aa0c-cfd0be3ab101"],
 " reads the area of the shell at every radius. At ",
 StyleBox["r = 1", "TI"],
 " it is the degree of the centre, and over ",
 StyleBox["r", "TI"],
 " on a lattice the coordination sequence of crystallography: ",
 StyleBox["4 r", "TI"],
 " on the square grid, ",
 StyleBox["3 r", "TI"],
 " on the hexagonal tiling."
}], "Notes",ExpressionUUID->"fe6b93fb-029c-4e3a-88b4-5e592350af7f"]
}, Open  ]],

