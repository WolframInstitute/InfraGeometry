Notebook[{

Cell[CellGroupData[{
Cell["InfraShell", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7cc345e1-120e-4b70-830c-fc7e8ddc8a69"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42248574-5cd7-450a-a8be-681abbae693c"],
 "\[LineSeparator]",
 "is the shell about ",
 StyleBox["c", "TI"],
 ": the vertices at distance between ",
 StyleBox["r", "TI"],
 " and ",
 StyleBox["s", "TI"],
 ". It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2c530305-f3fd-4aa9-84bf-08fe90a421b1"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fddbc622-cb7b-41d2-bb87-ddd872557b6a"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3b7cda66-d321-4a8e-bda2-b6a08e911e9a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97c18a69-5538-4ba2-8ebd-53e53ad52cb2"],
 "\[LineSeparator]",
 "is the band {",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["r", "TI"],
 "}: the vertices at distance exactly ",
 StyleBox["r", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d5e34f92-d94b-478c-bd20-cef08c79a12c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d934c46-8d10-4609-b92f-7b56c7c267d7"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7b266b38-0266-460b-8dc0-ed85be52ef40"],
 " is the shell construction token."
}], "Usage",ExpressionUUID->"cfafad24-51bf-4795-8b05-77e488cbf75c"],

Cell[TextData[{
 "Definition: the shell of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " is ",
 StyleBox["S_r(c) = {v : d(c, v) = r}", "TI"],
 ", a level set of the distance from ",
 StyleBox["c", "TI"],
 "; the band is ",
 StyleBox["{v : r \[LessEqual] d(c, v) \[LessEqual] s}", "TI"],
 ". ",
 StyleBox["c", "TI"],
 " is a vertex or a vertex list, and then ",
 StyleBox["d(v, C) = min d(v, c)", "TI"],
 "."
}], "Notes",ExpressionUUID->"aec4ef2a-90e6-4d3e-a969-f4a8c217b748"],

Cell[TextData[{
 "The shell is not a curve. On the square grid no two of its vertices are \
adjacent. The connected subsets of it that separate the centre from the \
outside are the family ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3a74f01c-3f4b-4c19-b11c-a95edfc211f1"],
 ", which may be empty."
}], "Notes",ExpressionUUID->"b53d9b8e-0c67-4841-b989-01f3916c5d7b"],

Cell[TextData[{
 "A shell is all boundary. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "519ffe1f-64ba-4e0c-aa39-cacc3c5d4853"],
 " gives two measures, and they part completely on it:"
}], "Notes",ExpressionUUID->"1195f5f1-2fa3-4582-91b7-0b2f951b1a38"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1723a949-88af-48f9-a642-f36e18f4738f"], Cell["Measure", "TableText",
     FontWeight->Bold,ExpressionUUID->"c0f45288-15d7-490f-8c45-5044720173b6"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"a0067f21-02eb-45bd-8a9e-61fcd6965c76"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ae87cabd-75ac-4210-b48f-7e1a6399b15b"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a34a432f-a3f8-4ccc-8fe4-6a580cb5aadd"]], "TableText",ExpressionUUID->
     "85aea5ce-e98a-4d98-82f9-893216928792"], Cell[TextData[{
     StyleBox["|S_r(c)|", "TI"],
     ", the shell area ",
     StyleBox["A(r)", "TI"]
    }], "TableText",ExpressionUUID->"3e14e5ee-38be-4ff8-9489-f60c2754dd1c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "398c48ab-327e-42d0-a66d-dc76accb45a3"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a33045ae-cc87-4747-ad00-37630854344b"]], "TableText",ExpressionUUID->
     "cacb43df-a5f7-4451-a02a-2abfc0ec7944"], Cell[TextData[{
     Cell[BoxData["0"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9cf1c42c-9828-44f6-a953-b24413799af4"],
     " for a single shell: every vertex of it has a neighbour at distance ",
     StyleBox["r \[Minus] 1", "TI"],
     ", and the neighbours of the centre lie at distance 1"
    }], "TableText",ExpressionUUID->"31552464-1394-431d-9de8-b5f04b958b9c"]}
  }]], "2ColumnTableMod",ExpressionUUID->"907b6d50-5418-48c2-8e47-\
7f650d1bffab"],

Cell[TextData[{
 "The shell area at ",
 StyleBox["r = 1", "TI"],
 " is the degree of the centre. Over ",
 StyleBox["r", "TI"],
 " on a lattice it is the coordination sequence of crystallography, the \
difference of consecutive ball counts, ",
 StyleBox["A(r) = L(r) \[Minus] L(r \[Minus] 1)", "TI"],
 " for ",
 StyleBox["r \[GreaterEqual] 1", "TI"],
 ", with ",
 StyleBox["L", "TI"],
 " the lattice count of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fb6fcf83-6409-4753-8c38-93cc6cbf4a36"],
 ", and ",
 StyleBox["A(0) = 1", "TI"],
 ":"
}], "Notes",ExpressionUUID->"420af3b2-38d4-4469-baac-76699870523e"],

