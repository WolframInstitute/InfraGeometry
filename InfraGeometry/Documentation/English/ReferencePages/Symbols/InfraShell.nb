Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraShell", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}], " ", "->", " ", 
        "$InfraShellColor"}], ",", " ", 
       RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c"}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
