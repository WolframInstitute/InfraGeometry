Cell[CellGroupData[{
Cell["InfraShell", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d2d1abec-e3ca-434e-906c-0e1d54d6a4a1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14609e02-4748-414a-9b3b-b3599dd69552"],
 "\[LineSeparator]",
 "is the shell about ",
 StyleBox["c", "TI"],
 ": the vertices at distance between ",
 StyleBox["r", "TI"],
 " and ",
 StyleBox["s", "TI"],
 ". It is a symbolic object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8429df9e-ae9a-4dc0-99b8-c5457c919d5c"],
 " evaluates it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b41aa1d6-4aa7-4549-87d1-dbfe07db790a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f299b80f-277c-4c48-ae0c-7aaf2c2c6916"],
 "\[LineSeparator]",
 "is the band {",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["r", "TI"],
 "}: the vertices at distance exactly ",
 StyleBox["r", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"31bf006c-2283-4478-9e4a-cde9ea78e372"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1613659c-68f2-4156-9c86-2ce6650bf232"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7e33d6d7-4037-4c28-a553-0ddfe2dcf4d9"],
 " is the shell construction token."
}], "Usage",ExpressionUUID->"804f5afb-5e87-4b5d-96fb-0817fc1019d6"],

Cell[TextData[{
 "Definition: the shell of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " is ",
 StyleBox["S_r(c) = {v : d(c, v) = r}", "TI"],
 ", a level set of the distance from ",
 StyleBox["c", "TI"],
 "; the band is ",
 StyleBox["{v : r \[LessEqual] d(c, v) \[LessEqual] s}", "TI"],
 ". ",
 StyleBox["c", "TI"],
 " is a vertex or a vertex list, and then ",
 StyleBox["d(v, C) = min d(v, c)", "TI"],
 "."
}], "Notes",ExpressionUUID->"fbe69b30-efc2-414c-96c9-db0ad5c4a6a1"],

Cell[TextData[{
 "The shell is not a curve. On the square grid no two of its vertices are \
adjacent. The connected subsets of it that separate the centre from the \
outside are the family ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "211304f0-ec99-4749-8639-657dd9728548"],
 ", which may be empty."
}], "Notes",ExpressionUUID->"df43ae7e-0e0c-4f7f-a4f1-6f629728a732"],

Cell[TextData[{
 "A shell is all boundary. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dd650b28-d12b-4003-949d-bf5ce41dfa2f"],
 " gives two measures, and they part completely on it:"
}], "Notes",ExpressionUUID->"433f0742-e0af-42a9-af8c-d96620fb89be"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b9891dab-4fbd-427b-94d5-d24636681cd0"], Cell["Measure", "TableText",
     FontWeight->Bold,ExpressionUUID->"642444c8-071c-430e-9cb9-42c449b0f83e"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"28786657-21a5-4dcf-9e11-9287673e4ce0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ddca1d1e-7a2f-4056-924e-fada4d8404d4"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "85b44b8d-101c-4f06-9ec2-036afd16dd82"]], "TableText",ExpressionUUID->
     "a2c98dda-a8cf-4de0-9bb6-442eece2c54e"], Cell[TextData[{
     StyleBox["|S_r(c)|", "TI"],
     ", the shell area ",
     StyleBox["A(r)", "TI"]
    }], "TableText",ExpressionUUID->"36617f82-c084-4bbf-9ea6-06a51e46189c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f69bf96d-d90b-4953-91dd-665e9e547f0d"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "abf14e5f-f938-4e9a-98b3-7cc64ca52843"]], "TableText",ExpressionUUID->
     "ca5bac14-2cf1-4fb4-83f9-f1a5861d964e"], Cell[TextData[{
     Cell[BoxData["0"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "95bbe20b-ca05-4423-a48a-ea1576bd7a62"],
     " for a single shell: every vertex of it has a neighbour at distance ",
     StyleBox["r \[Minus] 1", "TI"],
     ", and the neighbours of the centre lie at distance 1"
    }], "TableText",ExpressionUUID->"d9b592c9-86e6-49fe-9a8c-012d782240ac"]}
  }]], "2ColumnTableMod",ExpressionUUID->"2be34e8b-89a1-41c2-ab13-\
a3ac803ca468"],

Cell[TextData[{
 "The shell area at ",
 StyleBox["r = 1", "TI"],
 " is the degree of the centre. Over ",
 StyleBox["r", "TI"],
 " on a lattice it is the coordination sequence of crystallography, the \
difference of consecutive ball counts, ",
 StyleBox["A(r) = L(r) \[Minus] L(r \[Minus] 1)", "TI"],
 " for ",
 StyleBox["r \[GreaterEqual] 1", "TI"],
 ", with ",
 StyleBox["L", "TI"],
 " the lattice count of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d410acdb-b94c-4c58-a155-759d0a8110eb"],
 ", and ",
 StyleBox["A(0) = 1", "TI"],
 ":"
}], "Notes",ExpressionUUID->"a8973c20-3282-437b-b316-3fb81e4c701d"],

