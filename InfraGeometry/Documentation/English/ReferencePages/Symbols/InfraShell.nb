Cell["The shell areas are the differences of the ball volumes:", "ExampleText",ExpressionUUID->"55f83edd-a544-4fc9-ad2e-bf50b17b6c61"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
         " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"Differences", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
          " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cc3e1ad1-587d-45a5-a434-fb77cab42bfe"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
