}], "ExampleText",ExpressionUUID->"27dcd26a-22e7-435f-bbd1-c15520d84bf8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", "[", 
  RowBox[{"MapThread", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"substrate", ",", " ", "maxRadius", ",", " ", "shellArea"}], 
      "}"}], " ", "|->", " ", 
     RowBox[{"Show", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{"shellArea", ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "1", ",", " ", "maxRadius"}], "}"}]}], "]"}],
        ",", "\n", "    ", 
       RowBox[{"ListPlot", "[", "\n", "      ", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"substrate", ",", " ", 
             RowBox[{"InfraShell", "[", 
              RowBox[{
               RowBox[{"InfraCenter", "[", "substrate", "]"}], ",", " ", 
               "r"}], "]"}], ",", " ", "\"\<CountingMeasure\>\""}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"r", ",", " ", "1", ",", " ", "maxRadius"}], "}"}]}], 
          "]"}], ",", "\n", "      ", 
         RowBox[{"DataRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "maxRadius"}], "}"}]}], ",", " ", 
         RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}]}], "]"}]}], 
      "]"}]}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\"\<TriangularTilingGraph\>\"", ",", 
          " ", "\"\<Medium\>\""}], "]"}], ",", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\"\<CubicGridGraph\>\"", ",", " ", "\"\<Large\>\""}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"6", " ", "r"}], ",", " ", 
        RowBox[{
         RowBox[{"4", " ", 
          RowBox[{"r", "^", "2"}]}], " ", "+", " ", "2"}]}], "}"}]}], "}"}]}],
    "]"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9535ae06-063c-4c26-a563-091eac39cfd7"],

