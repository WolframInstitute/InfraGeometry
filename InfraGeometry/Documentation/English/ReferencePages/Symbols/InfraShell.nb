    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "444fe84f-785b-4bfc-a6e1-81e1ecfbc29a"],
 "\[LineSeparator]",
 "is the shell of radius ",
 StyleBox["r", "TI"],
 " about the vertex ",
 StyleBox["c", "TI"],
 ": the vertices at distance exactly ",
 StyleBox["r", "TI"],
 " from ",
 StyleBox["c", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6faef157-99b2-43d1-8e2e-4c389b504ed4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9afbb02c-bc2f-45fa-bc2c-3dd3d8ab8ac7"],
 "\[LineSeparator]",
 "is the band of the vertices at distance between ",
 StyleBox["r", "TI"],
 " and ",
 StyleBox["s", "TI"],
 " from ",
 StyleBox["c", "TI"],
 "."
}], "Usage",ExpressionUUID->"a6ff5616-4439-4857-aaf2-a4e5ae5ae871"],

Cell[TextData[{
 "The shell is ",
 StyleBox["S\:1d63(c) = {v : d(c, v) = r}", "TI"],
 ", a level set of the distance from ",
 StyleBox["c", "TI"],
 ". The band is ",
 StyleBox["{v : r \[LessEqual] d(c, v) \[LessEqual] s}", "TI"],
 "."
}], "Notes",ExpressionUUID->"d1131682-d290-42d2-98d9-9c2d9f5b5549"],

Cell[TextData[{
 "The centre can be a vertex list ",
 StyleBox["C", "TI"],
 ". Then ",
 StyleBox["d(v, C) = min d(v, c)", "TI"],
 " over ",
 StyleBox["c", "TI"],
 " in ",
 StyleBox["C", "TI"],
 "."
}], "Notes",ExpressionUUID->"d6b79afa-9c62-44e9-9026-eefc4b8f9fe9"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
