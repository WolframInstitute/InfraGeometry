Cell["\<\
The band of radii 2 to 4 about the centre of the discretized plane, the \
square grid and the hexagonal tiling. The Riemannian measure keeps the middle \
shell, in green; the two rims, in blue, are boundary.\
\>", "ExampleText",ExpressionUUID->"013898a6-e506-41dc-a9b2-69cc51c0a51f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"band", " ", "=", " ", 
        RowBox[{"InfraShell", "[", 
         RowBox[{
          RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"support", " ", "=", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", "band"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"InfraInterior", "[", 
              RowBox[{"g", ",", " ", "support"}], "]"}], " ", "->", " ", 
             "$InfraBallColor"}], ",", " ", 
            RowBox[{
             RowBox[{"InfraBoundary", "[", 
              RowBox[{"g", ",", " ", "support"}], "]"}], " ", "->", " ", 
             "$InfraCircleColor"}]}], "}"}]}], "]"}], ",", "\n", "      ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", "band", ",", " ", 
          RowBox[{"{", 
           
