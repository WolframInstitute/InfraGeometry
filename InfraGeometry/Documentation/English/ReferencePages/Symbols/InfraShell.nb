Cell[TextData[{
 "Past the eccentricity the shell is empty. The substrates are finite \
patches, and a shell follows the table while it stays inside the patch: on \
the medium cubic grid, to ",
 StyleBox["r = 3", "TI"],
 "."
}], "Notes",ExpressionUUID->"3c33b590-27e4-49d0-9da2-5271abe2f1e5"],

Cell[TextData[{
 "In the continuum the reference is the area of the geodesic sphere. On a \
Riemannian manifold of dimension ",
 StyleBox["n", "TI"],
 ", with ",
 StyleBox["\[Omega]_n", "TI"],
 " the volume of the Euclidean unit ball and ",
 StyleBox["Scal(c)", "TI"],
 " the scalar curvature at the centre, ",
 StyleBox["Vol \[PartialD]B_r(c) = n \[Omega]_n r^(n\[Minus]1) (1 \[Minus] \
Scal(c) r\.b2 / (6n) + O(r\:2074))", "TI"],
 ", the derivative in ",
 StyleBox["r", "TI"],
 " of the ball's expansion. On a lattice the shell is the boundary of a \
polygon, not of a round ball, as on ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "57de74a9-5408-4b33-a1d6-cb6c64778540"],
 "."
}], "Notes",ExpressionUUID->"503ee023-3098-46ef-b920-0816949de1a0"],

Cell[TextData[{
 "The Riemannian measure of a band ",
 StyleBox["{r, s}", "TI"],
 " with ",
 StyleBox["r \[GreaterEqual] 1", "TI"],
 " drops its two rims: it counts the band ",
 StyleBox["{r + 1, s \[Minus] 1}", "TI"],
 " and the vertices at distance ",
 StyleBox["s", "TI"],
 " that have no neighbour at distance ",
 StyleBox["s + 1", "TI"],
 ". On the square and the triangular grids, away from the rim, there are \
none, and it is the counting measure of the band ",
 StyleBox["{r + 1, s \[Minus] 1}", "TI"],
 "; on the hexagonal tiling this is measured."
}], "Notes",ExpressionUUID->"d0651e26-2f22-4053-94a9-2b892dd19438"],

Cell[TextData[{
 "How the number is measured: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraShell", "[", 
     RowBox[{
      StyleBox["c", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", "\"\<CountingMeasure\>\""}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2e49b98-b357-4688-a161-ee1ad548540c"],
 " counts the vertices at distance exactly ",
 StyleBox["r", "TI"],
 " from ",
 StyleBox["c", "TI"],
 ", one row of the distance matrix at the value ",
 StyleBox["r", "TI"],
 ". The profile over ",
 StyleBox["r", "TI"],
 " is the derivative of the ball profile, and its ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LogDifferenceQuotients"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/LogDifferenceQuotients", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7455fdee-c433-468b-b81b-1ce98e014755"],
 " tend to one less than the dimension."
}], "Notes",ExpressionUUID->"899c6bf1-4fda-46e2-85fd-79c5f0cfa964"],

Cell[TextData[{
 "The head holds the centre and the band and computes nothing. A shell has \
one member, the vertex set, so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "34173e27-6063-4649-ba42-5f04a8750f56"],
 " gives it as a sorted vertex list. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fa4b0e5e-474b-42dc-83b6-9a87bd6b1f38"],
 " also reads ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe790e30-4e24-4167-bdca-92053e954bf1"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31b68c5b-c228-4b35-8ab2-9cb7d48f1210"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27f0272f-5c44-4e28-98fc-8b883665d0f4"],
 ", ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f50fa062-e632-4b61-a64f-3184004d737f"],
 " and ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d50c012-1b93-4ce0-8c5f-0e97abfc764e"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "20351efe-398d-4422-a218-d36bbabbb588"],
 " is the level set as a function."
}], "Notes",ExpressionUUID->"6e4bc245-f80e-45ec-b03a-7c70c96b552c"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"c66a33d4-2e20-42a6-8e9b-eff2efdfd27e"],

