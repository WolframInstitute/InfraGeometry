Cell["\<\
A band of radii 2 to 3 about the centre: the two shells together.\
\>", "ExampleText",ExpressionUUID->"e0a7e459-1a15-46e6-93a6-0356ae7cc0c0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"pA", ",", " ", "shellA"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"constr", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "shellA"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "41", "]"}]}], ",", " ", 
         RowBox[{"shellA", " ", "==", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"pA", ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]}]}], "}"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"InfraSceneInstance", "[", 
     RowBox[{
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindInfraScene", "[", 
        RowBox[{"constr", ",", " ", "g"}], "]"}]}], ",", " ", "shellA"}], 
     "]"}], " ", "===", " ", 
    RowBox[{"Union", "[", 
     RowBox[{
      RowBox[{"FindInfraShell", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", "2"}], "]"}], ",", " ", 
      RowBox[{"FindInfraShell", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", "3"}], "]"}]}], "]"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b63b2bed-95ba-40b0-ac33-d8cc5fe427a1"],

