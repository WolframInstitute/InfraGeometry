Cell["\<\
The band of radii 1 to 3, with its interior drawn over it. The Riemannian \
measure counts the interior; on the grid it is the middle shell:\
\>", "ExampleText",ExpressionUUID->"8def5d19-6f9e-4191-a93e-ab9326ea77c2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"band", " ", "=", " ", 
        RowBox[{"InfraShell", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"band", ",", " ", 
          RowBox[{"InfraInterior", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{
              "g", ",", " ", "band", ",", " ", "\"\<VertexDensity\>\""}], 
              "]"}]}]}], "]"}]}], "}"}], ",", "\n", "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", "band", ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<CountingMeasure\>\"", ",", 
             " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "]"}]}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[3]:= ",ExpressionUUID->"599f9990-26ae-483c-a2de-bbf63d0454ff"],

