 " is the shell of radius ",
 StyleBox["r", "TI"],
 " about the object ",
 StyleBox["x", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"88b05126-9df2-4dbf-b8ac-f6851db14b21"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["x", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["rmin", "TI"], ",", " ", 
      StyleBox["rmax", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2197e02-e737-4a71-a15a-cb25773d71cb"],
 "\[LineSeparator]",
 "is the band of radii from ",
 StyleBox["rmin", "TI"],
 " to ",
 StyleBox["rmax", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1325e75f-bf73-41fa-85cf-78c1244f83ad"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
