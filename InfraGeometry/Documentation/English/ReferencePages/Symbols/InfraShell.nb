 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "99770152-f5f7-4d10-9c59-466889292061"],
 " is the shell of radius ",
 StyleBox["r", "TI"],
 " about the object ",
 StyleBox["x", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"18639c5a-384b-45cc-b551-0e992457edec"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["x", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["rmin", "TI"], ",", " ", 
      StyleBox["rmax", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
