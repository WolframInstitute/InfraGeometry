Cell["\<\
The same construction on the square, hexagonal and triangular tilings.\
\>", "ExampleText",ExpressionUUID->"4d55876b-25bc-4f35-9e99-fe58c0e075bc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "pA", ",", " ", "pB", ",", " ", "shellA", ",", " ", "shellB", ",", " ", 
    "meet"}], "]"}], ";"}], "\n", 
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"constr", " ", "=", " ", 
        RowBox[{"InfraScene", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "pA", ",", " ", "pB", ",", " ", "shellA", ",", " ", "shellB", ",", 
            " ", "meet"}], "}"}], ",", "\n", "       ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"pA", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "c", "]"}]}], ",", " ", 
            RowBox[{"pB", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "b", "]"}]}], ",", "\n", "        ", 
            RowBox[{"shellA", " ", "==", " ", 
             RowBox[{"InfraShell", "[", 
              RowBox[{"pA", ",", " ", "2"}], "]"}]}], ",", " ", 
            RowBox[{"shellB", " ", "==", " ", 
             RowBox[{"InfraShell", "[", 
              RowBox[{"pB", ",", " ", "2"}], "]"}]}], ",", "\n", "        ", 
            RowBox[{"meet", " ", "==", " ", 
             RowBox[{"InfraIntersection", "[", 
              RowBox[{"shellA", ",", " ", "shellB"}], "]"}]}]}], "}"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"solved", " ", "=", " ", 
        RowBox[{"FindInfraScene", "[", 
         RowBox[{"constr", ",", " ", "g"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", "\n", "      ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"InfraSceneInstance", "[", 
              RowBox[{
               RowBox[{"First", " ", "@", " ", "solved"}], ",", " ", 
               "shellA"}], "]"}], " ", "->", " ", "$InfraShellColor"}], ",", 
            "\n", "            ", 
            RowBox[{
             RowBox[{"InfraSceneInstance", "[", 
              RowBox[{
               RowBox[{"First", " ", "@", " ", "solved"}], ",", " ", 
               "shellB"}], "]"}], " ", "->", " ", "$InfraCircleColor"}], ",", 
            "\n", "            ", 
            RowBox[{"Directive", "[", "$InfraPointColor", "]"}]}], "}"}], ",",
           "\n", "        ", 
          RowBox[{
           RowBox[{
            RowBox[{"InfraSceneInstance", "[", 
             RowBox[{"#", ",", " ", "meet"}], "]"}], " ", "&"}], " ", "/@", 
           " ", "solved"}]}], "]"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2dd2533e-ec56-42fa-9c61-7062808cf695"],

