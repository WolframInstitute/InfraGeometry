Notebook[{

Cell[CellGroupData[{
Cell["InfraShell", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0371950c-a623-40f8-afe6-571ba1bba5c0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34ad501e-3e81-4c6f-98f9-e081a332a12c"],
 "\[LineSeparator]",
 "is the shell about ",
 StyleBox["c", "TI"],
 ": the vertices at distance between ",
 StyleBox["r", "TI"],
 " and ",
 StyleBox["s", "TI"],
 ". It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ab510821-b727-448e-b40d-4767026b3e67"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d4242f5a-efd6-447b-b2fd-62cef2b2e01e"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"755fc6d3-698a-4cb5-b68b-40c0e54b0908"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1524908c-1a77-4d78-acac-942eeecb06f6"],
 "\[LineSeparator]",
 "is the band {",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["r", "TI"],
 "}: the vertices at distance exactly ",
 StyleBox["r", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5683f0f1-eb06-47be-a52c-6b4ca3193991"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bf5f18e-dc70-4f97-8988-baa755ef747e"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4a42eae2-e05b-4c2d-b59b-1a76ec8467e3"],
 " is the shell construction token."
}], "Usage",ExpressionUUID->"6806a848-7d54-44e1-a639-31c58c78608f"],

Cell[TextData[{
 "Definition: the shell of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " is ",
 StyleBox["S_r(c) = {v : d(c, v) = r}", "TI"],
 ", a level set of the distance from ",
 StyleBox["c", "TI"],
 "; the band is ",
 StyleBox["{v : r \[LessEqual] d(c, v) \[LessEqual] s}", "TI"],
 ". ",
 StyleBox["c", "TI"],
 " is a vertex or a vertex list, and then ",
 StyleBox["d(v, C) = min d(v, c)", "TI"],
 "."
}], "Notes",ExpressionUUID->"d5a1369e-46fb-4772-bfcc-2e96c252c1b9"],

Cell[TextData[{
 "The shell is not a curve. On the square grid no two of its vertices are \
adjacent. The connected subsets of it that separate the centre from the \
outside are the family ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "afb694ea-603f-418b-b6b0-505defad20a8"],
 ", which may be empty."
}], "Notes",ExpressionUUID->"2460646c-020b-4f23-a278-b2ea9629842f"],

Cell[TextData[{
 "A shell is all boundary. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d6babb79-5e9a-49b8-874b-331fdde72b37"],
 " gives two measures, and they part completely on it:"
}], "Notes",ExpressionUUID->"ca5310a2-f46d-4528-947b-d8dff7fe31bc"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6e072b5a-6e66-4032-ba92-400d9883a714"], Cell["Measure", "TableText",
     FontWeight->Bold,ExpressionUUID->"5692db5a-5f0d-49e1-b4ca-108f74da7bc9"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"3f2e8194-7e82-4b50-8765-ac219f355d98"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b99ad9f1-fb8d-4bf6-8767-846a15af6e64"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "779880a0-fa96-4c30-978d-0860c330fe05"]], "TableText",ExpressionUUID->
     "f813db91-d54b-4c5b-844c-289305daadb8"], Cell[TextData[{
     StyleBox["|S_r(c)|", "TI"],
     ", the shell area ",
     StyleBox["A(r)", "TI"]
    }], "TableText",ExpressionUUID->"f59cff53-8216-41fa-a032-f349a66e954a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "41a04d26-0d44-419b-a166-73279879f466"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "456f9f4d-a22f-4ef7-b062-408a67aae74f"]], "TableText",ExpressionUUID->
     "de9a1d28-ec75-49ad-b7e6-8bb6e39eeb26"], Cell[TextData[{
     Cell[BoxData["0"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "46f6901d-ab05-4fd8-93ba-34c351d8d505"],
     " for a single shell: every vertex of it has a neighbour at distance ",
     StyleBox["r \[Minus] 1", "TI"],
     ", and the neighbours of the centre lie at distance 1"
    }], "TableText",ExpressionUUID->"8dffda38-4396-42de-8569-7456f133dd54"]}
  }]], "2ColumnTableMod",ExpressionUUID->"ba7cb811-759b-4dc4-ae44-\
a901eebed466"],

Cell[TextData[{
 "The shell area at ",
 StyleBox["r = 1", "TI"],
 " is the degree of the centre; over ",
 StyleBox["r", "TI"],
 " on a lattice it is the coordination sequence of crystallography, ",
 StyleBox["4 r", "TI"],
 " on the square grid and ",
 StyleBox["3 r", "TI"],
 " on the hexagonal tiling. Past the eccentricity the shell is empty."
}], "Notes",ExpressionUUID->"21ebb99c-c9df-4eb7-81c7-f03c78369e46"],

Cell[TextData[{
 "The Riemannian measure of a band ",
 StyleBox["{r, s}", "TI"],
 " drops its two rims. On the square, triangular and hexagonal lattices, away \
from the rim, it is the counting measure of the band ",
 StyleBox["{r + 1, s \[Minus] 1}", "TI"],
 "."
}], "Notes",ExpressionUUID->"5b914ae1-ce32-4903-a386-e36d2dce4d6d"],

Cell[TextData[{
 "The head holds the centre and the band and computes nothing. A shell has \
one member, the vertex set, so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4f414c59-48ca-4a0d-8833-2c9a53e1256e"],
 " gives it as a sorted vertex list. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1c443396-85ab-49a9-a970-30c6e5ac4a22"],
 " also reads ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "643576d7-c03c-4141-9c48-387d27802074"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba4b235f-e99c-4c5d-ad1f-082afa645eee"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a577a005-e15b-443d-b04d-1339b5e4b77a"],
 ", ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "079f7cfb-32e3-4c32-be91-b2d932f84003"],
 " and ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "edbffb47-1f47-4b0f-8c0e-cc2b1453ae7f"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6a0ad1e9-28f4-4762-99a7-1270f5d701f1"],
 " is the level set as a function."
}], "Notes",ExpressionUUID->"3885ecae-5add-4db0-85ba-0cbbb542b68f"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"fbf560dc-4e21-46e1-ad1e-15abf7a6a072"],

