Cell["\<\
The shells of radius 1 to 5 about the centre of the grid. Each has Riemannian \
measure 0:\
\>", "ExampleText",ExpressionUUID->"dbafeebe-e13d-4131-9788-93a13caf6083"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"shells", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "r"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "1", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", "shells", ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{
       "g", ",", " ", "shells", ",", " ", "\"\<RiemannianMeasure\>\""}], 
       "]"}]}], ",", "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"60c1c6c5-f38b-4c7e-bf60-6368b3a960b1"],

