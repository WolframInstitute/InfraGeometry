Cell["\<\
The shells of radius 2 about two points two steps apart on a grid, and the \
two vertices where they meet, one per branch.\
\>", "ExampleText",ExpressionUUID->"1b962713-c340-418d-b1f5-641e5c49c8fb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "pA", ",", " ", "pB", ",", " ", "shellA", ",", " ", "shellB", ",", " ", 
    "meet"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"constr", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "pA", ",", " ", "pB", ",", " ", "shellA", ",", " ", "shellB", ",", 
         " ", "meet"}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "41", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "43", "]"}]}], ",", "\n", "      ", 
         RowBox[{"shellA", " ", "==", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"pA", ",", " ", "2"}], "]"}]}], ",", " ", 
         RowBox[{"shellB", " ", "==", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"pB", ",", " ", "2"}], "]"}]}], ",", "\n", "      ", 
         RowBox[{"meet", " ", "==", " ", 
          RowBox[{"InfraIntersection", "[", 
           RowBox[{"shellA", ",", " ", "shellB"}], "]"}]}]}], "}"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"solved", " ", "=", " ", 
       RowBox[{"FindInfraScene", "[", 
        RowBox[{"constr", ",", " ", "g"}], "]"}]}], "}"}], ",", "\n", "    ", 
     
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", "\n", "      ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"InfraSceneInstance", "[", 
             RowBox[{
              RowBox[{"First", " ", "@", " ", "solved"}], ",", " ", 
              "shellA"}], "]"}], " ", "->", " ", "$InfraShellColor"}], ",", 
           "\n", "            ", 
           RowBox[{
            RowBox[{"InfraSceneInstance", "[", 
             RowBox[{
              RowBox[{"First", " ", "@", " ", "solved"}], ",", " ", 
              "shellB"}], "]"}], " ", "->", " ", "$InfraCircleColor"}], ",", 
           "\n", "            ", 
           RowBox[{"Directive", "[", "$InfraPointColor", "]"}]}], "}"}], ",", 
         "\n", "        ", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraSceneInstance", "[", 
            RowBox[{"#", ",", " ", "meet"}], "]"}], " ", "&"}], " ", "/@", 
          " ", "solved"}]}], "]"}], ",", "\n", "      ", 
       RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}]}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cecab307-d006-490d-b111-ee7aab68bd1b"],

