Cell[TextData[{
 "The shell area against the radius on the same three substrates: ",
 StyleBox["4 r", "TI"],
 " on the square grid, ",
 StyleBox["3 r", "TI"],
 " on the hexagonal tiling, and no formula on the mesh."
}], "ExampleText",ExpressionUUID->"4a86f457-d28f-4ad6-899b-db4288f92ce5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"names", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
        ",", " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"ListLinePlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"name", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], ",",
          " ", 
