 " is the shell of radius ",
 StyleBox["r", "TI"],
 " about the object ",
 StyleBox["x", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7e0270a8-19ba-4a96-96d8-bceb73248f01"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["x", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["rmin", "TI"], ",", " ", 
      StyleBox["rmax", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "243f3d5c-c261-41bf-af59-0726340a8086"],
 "\[LineSeparator]",
 "is the band of radii from ",
 StyleBox["rmin", "TI"],
 " to ",
 StyleBox["rmax", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d980643d-7a36-4a38-9cbc-401d5260da35"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
