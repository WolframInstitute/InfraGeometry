Cell[TextData[{
 "The shell area against the radius on the same three substrates: ",
 StyleBox["4 r", "TI"],
 " on the square grid, ",
 StyleBox["3 r", "TI"],
 " on the hexagonal tiling, and no formula on the mesh."
}], "ExampleText",ExpressionUUID->"c7cd8d40-bf59-40c4-9cb6-56130b2153c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"names", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
        ",", " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"ListLinePlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"name", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], ",",
          " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraShell", "[", 
              RowBox[{
               RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "r"}], "]"}],
              ",", " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"r", ",", " ", "1", ",", " ", "7"}], "}"}]}], "]"}]}], 
        "]"}], ",", "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", "names"}], "}"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"DataRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "7"}], "}"}]}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", "names"}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<r\>\"", ",", " ", "\"\<A(r)\>\""}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"86994cfa-4ba2-4e35-a36f-269262721d8c"],

