Cell["\<\
A band of radii 2 to 3 about the centre: the two shells together.\
\>", "ExampleText",ExpressionUUID->"afa8df70-058f-4d31-9ff8-b1b1ead9c0b6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"pA", ",", " ", "shellA"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"constr", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "shellA"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "41", "]"}]}], ",", " ", 
         RowBox[{"shellA", " ", "==", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"pA", ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]}]}], "}"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"InfraSceneInstance", "[", 
     RowBox[{
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindInfraScene", "[", 
        RowBox[{"constr", ",", " ", "g"}], "]"}]}], ",", " ", "shellA"}], 
