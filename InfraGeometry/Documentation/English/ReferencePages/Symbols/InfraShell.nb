Cell[TextData[{
 "Definition: the shell of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " is ",
 StyleBox["S_r(c) = {v : d(c, v) = r}", "TI"],
 ", a level set of the distance from ",
 StyleBox["c", "TI"],
 "; the band is ",
 StyleBox["{v : rmin \[LessEqual] d(c, v) \[LessEqual] rmax}", "TI"],
 "."
}], "Notes",ExpressionUUID->"f1df4f56-09e0-4ac5-960a-3fa4293afcaa"],

Cell[TextData[{
 Cell[BoxData["InfraShell"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74ae5c4c-199b-4068-aeba-36206175d5a4"],
 " is a scene token. It names the shell in a construction ",
 Cell[BoxData[
  RowBox[{"x", " ", "==", " ", 
   RowBox[{"InfraShell", "[", 
    RowBox[{"y", ",", " ", "r"}], "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffbf2a83-20ef-48e6-ae9e-3c2f4f2b2707"],
 ", where ",
 StyleBox["y", "TI"],
 " is an object of the scene, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "efdb17b9-62d3-469c-90c8-e859f0011b8c"],
 " solves it: each branch binds ",
 StyleBox["x", "TI"],
 " to one realisation, a sorted vertex list. Without ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "628fe996-a6b5-4716-bbc9-7cef04854ded"],
 " the realisation is the whole level set, so the token adds no branches. \
With ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "\"\<Separating\>\"", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1364039a-ac4c-422c-af35-e89255a53282"],
 " the realisations are the minimal subsets of the shell that separate ",
 StyleBox["y", "TI"],
 " from the outside, one branch each."
}], "Notes",ExpressionUUID->"0fe22e71-80d4-4a3d-bd03-fec9755ee9d1"],

Cell[TextData[{
 "A shell itself is a sorted vertex list, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dbce02e6-c256-4505-bd68-8874783e6c96"],
 " computes it. Outside a scene the head is inert."
}], "Notes",ExpressionUUID->"2b66c49f-705f-4c9b-86a7-38e6ff70a5e2"],

Cell[TextData[{
 "The shell is the sphere of the graph metric and the probe of the shell-area \
measurement. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ShellAreas"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ShellAreas", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4a433a36-882c-45ce-83eb-ebfa141d88c9"],
 " counts shells at every radius without building them."
}], "Notes",ExpressionUUID->"a6ab859a-85cd-40b1-9eb6-020176a7fc13"]
}, Open  ]],

