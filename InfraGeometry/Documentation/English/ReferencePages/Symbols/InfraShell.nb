Cell[TextData[{
 "Inside a scene the token names the shell about a point, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "23b0187d-ea9b-4d14-810c-30b89cd43731"],
 " binds it to the same vertex set. Two shells meet in a few vertices, one \
per branch."
}], "ExampleText",ExpressionUUID->"df593e92-6d2b-49e1-98dd-68df35ab82f5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "pA", ",", " ", "pB", ",", " ", "shellA", ",", " ", "shellB", ",", " ", 
    "meet"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"constr", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "pA", ",", " ", "pB", ",", " ", "shellA", ",", " ", "shellB", ",", 
         " ", "meet"}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "c", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "b", "]"}]}], ",", "\n", "      ", 
         RowBox[{"shellA", " ", "==", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"pA", ",", " ", "2"}], "]"}]}], ",", " ", 
         RowBox[{"shellB", " ", "==", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"pB", ",", " ", "2"}], "]"}]}], ",", "\n", "      ", 
         RowBox[{"meet", " ", "==", " ", 
          RowBox[{"InfraIntersection", "[", 
           RowBox[{"shellA", ",", " ", "shellB"}], "]"}]}]}], "}"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"solved", " ", "=", " ", 
     RowBox[{"FindInfraScene", "[", 
      RowBox[{"constr", ",", " ", "g"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", "\n", "    ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraSceneInstance", "[", 
          RowBox[{
           RowBox[{"First", " ", "@", " ", "solved"}], ",", " ", "shellA"}], 
          "]"}], ",", "\n", "          ", 
         RowBox[{"InfraSceneInstance", "[", 
          RowBox[{
           RowBox[{"First", " ", "@", " ", "solved"}], ",", " ", "shellB"}], 
          "]"}]}], "}"}], ",", "\n", "      ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraSceneInstance", "[", 
          RowBox[{"#", ",", " ", "meet"}], "]"}], " ", "&"}], " ", "/@", " ", 
        "solved"}]}], "]"}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7c3ad064-3ca6-49cd-b0dd-3e2a5e6b3d73"],

