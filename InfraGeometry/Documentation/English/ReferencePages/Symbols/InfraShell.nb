Cell["\<\
A band of radii 2 to 3 about the centre: the two shells together.\
\>", "ExampleText",ExpressionUUID->"7a6ced85-5a6f-47cd-9055-27ef4d29f970"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"pA", ",", " ", "shellA"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"constr", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "shellA"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "c", "]"}]}], ",", " ", 
         RowBox[{"shellA", " ", "==", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"pA", ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]}]}], "}"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"band", " ", "=", " ", 
     RowBox[{"InfraSceneInstance", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"FindInfraScene", "[", 
         RowBox[{"constr", ",", " ", "g"}], "]"}]}], ",", " ", "shellA"}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"band", " ", "->", " ", "$InfraShellColor"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c"}],
         "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"band", " ", "===", " ", 
      RowBox[{"Union", "[", 
       RowBox[{
        RowBox[{"FindInfraShell", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}], ",", " ", 
        RowBox[{"FindInfraShell", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}], "]"}]}]}], 
    "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f6283043-bbbe-411a-bdd0-0b57196b40ea"],

