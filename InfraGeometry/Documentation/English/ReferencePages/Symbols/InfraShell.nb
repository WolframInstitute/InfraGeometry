Cell[TextData[{
 "The shell area is the ",
 Cell[BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62f93cb1-23d5-4db5-9a36-6cdefb8c170a"],
 " of the head. On the square grid it is ",
 StyleBox["4 r", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"6ce65bf8-7974-42c3-bd19-714e2f14dbf0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraShell", "[", 
         RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
        " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}], " ", "===",
     " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"4", " ", "r"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3e150ec6-d441-4083-80fa-18f732519420"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"55eef008-2aa2-48d3-87b0-870425116b71"]
}, Open  ]],

Cell[TextData[{
 "Inside a scene the token names the shell about a point, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1fe2e4bd-6f19-47c1-9bfc-93c5ab2eae75"],
 " binds it to the same vertex set. Two shells meet in a few vertices, one \
per branch."
}], "ExampleText",ExpressionUUID->"535bcfc2-9933-4ab2-a171-27cfe457138c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "pA", ",", " ", "pB", ",", " ", "shellA", ",", " ", "shellB", ",", " ", 
    "meet"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"constr", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "pA", ",", " ", "pB", ",", " ", "shellA", ",", " ", "shellB", ",", 
         " ", "meet"}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "c", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "b", "]"}]}], ",", "\n", "      ", 
         RowBox[{"shellA", " ", "==", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"pA", ",", " ", "2"}], "]"}]}], ",", " ", 
         RowBox[{"shellB", " ", "==", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"pB", ",", " ", "2"}], "]"}]}], ",", "\n", "      ", 
         RowBox[{"meet", " ", "==", " ", 
          RowBox[{"InfraIntersection", "[", 
           RowBox[{"shellA", ",", " ", "shellB"}], "]"}]}]}], "}"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"solved", " ", "=", " ", 
     RowBox[{"FindInfraScene", "[", 
      RowBox[{"constr", ",", " ", "g"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", "\n", "    ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"InfraSceneInstance", "[", 
           RowBox[{
            RowBox[{"First", " ", "@", " ", "solved"}], ",", " ", "shellA"}], 
           "]"}], " ", "->", " ", "$InfraShellColor"}], ",", "\n", 
         "          ", 
         RowBox[{
          RowBox[{"InfraSceneInstance", "[", 
           RowBox[{
            RowBox[{"First", " ", "@", " ", "solved"}], ",", " ", "shellB"}], 
           "]"}], " ", "->", " ", "$InfraCircleColor"}], ",", "\n", 
         "          ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}]}], "}"}], ",", 
       "\n", "      ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraSceneInstance", "[", 
          RowBox[{"#", ",", " ", "meet"}], "]"}], " ", "&"}], " ", "/@", " ", 
        "solved"}]}], "]"}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8c18bdae-a84b-46a9-a56a-5452fb2116e3"],

