Cell[TextData[{
 "The shell area of the triangular tiling and of the large cubic grid, as \
points, against ",
 StyleBox["6r", "TI"],
 " and ",
 StyleBox["4r\.b2 + 2", "TI"],
 ", as curves."
}], "ExampleText",ExpressionUUID->"7089dcb7-91c3-469c-8631-e25fcc982d59"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", "[", 
  RowBox[{"MapThread", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"substrate", ",", " ", "maxRadius", ",", " ", "shellArea"}], 
      "}"}], " ", "|->", " ", 
     RowBox[{"Show", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{"shellArea", ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "1", ",", " ", "maxRadius"}], "}"}]}], "]"}],
        ",", "\n", "    ", 
       RowBox[{"ListPlot", "[", "\n", "      ", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"substrate", ",", " ", 
             RowBox[{"InfraShell", "[", 
              RowBox[{
               RowBox[{"First", " ", "@", " ", 
                RowBox[{"GraphCenter", "[", "substrate", "]"}]}], ",", " ", 
               "r"}], "]"}], ",", " ", "\"\<CountingMeasure\>\""}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"r", ",", " ", "1", ",", " ", "maxRadius"}], "}"}]}], 
          "]"}], ",", "\n", "      ", 
         RowBox[{"DataRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "maxRadius"}], "}"}]}], ",", " ", 
         RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}]}], "]"}]}], 
      "]"}]}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\"\<TriangularTilingGraph\>\"", ",", 
          " ", "\"\<Medium\>\""}], "]"}], ",", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\"\<CubicGridGraph\>\"", ",", " ", "\"\<Large\>\""}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"6", " ", "r"}], ",", " ", 
        RowBox[{
         RowBox[{"4", " ", 
          RowBox[{"r", "^", "2"}]}], " ", "+", " ", "2"}]}], "}"}]}], "}"}]}],
    "]"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3a632053-d44b-4fe6-b92b-fe54c800745c"],

