Notebook[{

Cell[CellGroupData[{
Cell["FindResolvingSet", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"39903961-23fe-4630-856f-5d79aaf1b826"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindResolvingSet"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindResolvingSet", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ada17540-c069-41b0-a5a1-18f20bf50186"],
 "\[LineSeparator]",
 "gives a list holding one smallest resolving set of ",
 StyleBox["g", "TI"],
 ", a metric basis.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"98810e7e-05fa-4417-8245-49e583fa6e4e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindResolvingSet"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindResolvingSet", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ae1ed6f-83ff-4505-89bc-ea540b5a01c2"],
 "\[LineSeparator]",
 "gives up to ",
 StyleBox["n", "TI"],
 " resolving sets in order of size, the smallest first.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d0723838-6519-4aa1-b247-01d1d706fff6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindResolvingSet"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindResolvingSet", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["m", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db200d71-2403-477c-ab62-2932fa0a2bf7"],
 "\[LineSeparator]",
 "takes the sizes of the sets from ",
 StyleBox["m", "TI"],
 ": ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "33cd6b23-1cd6-47e6-ae41-a894bcf7dd61"],
 ", a largest size ",
 StyleBox["k", "TI"],
 ", {",
 StyleBox["min", "TI"],
 ", ",
 StyleBox["max", "TI"],
 "}, or {",
 StyleBox["k", "TI"],
 "} for the size ",
 StyleBox["k", "TI"],
 " only."
}], "Usage",ExpressionUUID->"e75b5b9c-7da8-4e8b-8583-48127efbaafb"],

Cell[TextData[{
 "A set ",
 StyleBox["B", "TI"],
 " of vertices resolves ",
 StyleBox["g", "TI"],
 " when every vertex is determined by its distances to the vertices of ",
 StyleBox["B", "TI"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ResolvingSetQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ResolvingSetQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cfd2b416-bd74-4492-b588-fc94c3083f26"],
 "). A smallest resolving set is a metric basis, and its size is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MetricDimension"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/MetricDimension", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ef945a63-8aad-490f-8a12-31dd822e58ed"],
 "."
}], "Notes",ExpressionUUID->"d9b6b5a7-c51d-4968-a76c-1bb2905f0124"],

Cell[TextData[{
 "The search is exhaustive. It tests every set of each size in turn, from the \
empty set on, and stops when it holds ",
 StyleBox["n", "TI"],
 " sets. A metric basis of ",
 StyleBox["k", "TI"],
 " vertices out of ",
 StyleBox["N", "TI"],
 " costs up to ",
 StyleBox["C(N, k)", "TI"],
 " tests at the size ",
 StyleBox["k", "TI"],
 ": fast when the metric dimension is small, slow otherwise."
}], "Notes",ExpressionUUID->"79931546-777f-48f1-9130-95f6df5e334d"],

Cell["\<\
Two vertices with the same neighbours, twins, have the same distance to every \
other vertex. A resolving set holds one of every pair of twins.\
\>", "Notes",ExpressionUUID->"72323d51-425f-42e7-9962-29400fd88cfd"],

Cell[TextData[{
 "The sets of the smallest size are metric bases; later ones need not be \
minimal. The empty set resolves only the graph of one vertex. When no set of \
the sizes ",
 StyleBox["m", "TI"],
 " resolves ",
 StyleBox["g", "TI"],
 ", the result is {}."
}], "Notes",ExpressionUUID->"495fce80-4b85-467d-85f5-023a6d584cf6"]
}, Open  ]],

