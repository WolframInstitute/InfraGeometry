Cell[TextData[{
 "Up to ",
 StyleBox["n", "TI"],
 " sets of a given size. The 6-cycle has 12 metric bases, every pair of \
vertices but the three opposite pairs:"
}], "ExampleText",ExpressionUUID->"4b1c91b8-0783-4e59-81e2-8aeff4adae6f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "6", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"bases", " ", "=", " ", 
     RowBox[{"FindResolvingSet", "[", 
      RowBox[{"g", ",", " ", "20", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "bases", "]"}], ",", " ", 
     RowBox[{"Complement", "[", 
      RowBox[{
       RowBox[{"Subsets", "[", 
        RowBox[{
         RowBox[{"Range", "[", "6", "]"}], ",", " ", 
         RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
       RowBox[{"Sort", " ", "/@", " ", "bases"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d3d011cb-1858-4102-9eff-4c41ee05db9e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"12", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "6"}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"271ea090-eb67-417e-a2e2-7d8fc5254b2b"]
}, Open  ]],

Cell["\<\
The empty set resolves the graph of one vertex and comes first. On two \
vertices one vertex resolves, and the empty set does not:\
\>", "ExampleText",ExpressionUUID->"e7bccbdf-acf5-4bb9-9492-b9d64a1d1de3"],

