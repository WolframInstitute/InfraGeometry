Cell["A metric basis of the square mesh, three vertices:", "ExampleText",ExpressionUUID->"e22524c2-a2ea-4774-a4ae-dda33e47bffc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"basis", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FindResolvingSet", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", "basis", "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", "basis"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"46d6ab4e-ccca-42d7-a71b-1daa7dff7565"],

