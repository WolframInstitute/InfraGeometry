Cell["\<\
A metric basis of the 8 \[Times] 8 grid graph: two corners of one side. Every \
vertex is determined by its distances to two corners:\
\>", "ExampleText",ExpressionUUID->"c36a5e64-c9d8-4300-b243-7a55514a72dd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"8", ",", " ", "8"}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"basis", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FindResolvingSet", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", "basis", "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", "basis"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0d33eba9-0405-4524-ac58-5ed1e0906358"],

