Cell["\<\
The sizes: no two vertices resolve the square tiling, and 728 sets of three \
do. Three of them, chosen at random, are drawn.\
\>", "ExampleText",ExpressionUUID->"a44d0a29-cbd2-49b8-b7cd-335b890c09a2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"pairs", " ", "=", " ", 
      RowBox[{"FindResolvingSet", "[", 
       RowBox[{"g", ",", " ", "1000", ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"triples", " ", "=", " ", 
      RowBox[{"FindResolvingSet", "[", 
       RowBox[{"g", ",", " ", "1000", ",", " ", 
        RowBox[{"{", "3", "}"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", "#", "}"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomSample", "[", 
          RowBox[{"triples", ",", " ", "3"}], "]"}]}], ")"}]}], "]"}], ",", 
     " ", 
     RowBox[{"Length", "[", "pairs", "]"}], ",", " ", 
     RowBox[{"Length", "[", "triples", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"37af3255-1418-4375-9089-3ee594ce3daf"],

