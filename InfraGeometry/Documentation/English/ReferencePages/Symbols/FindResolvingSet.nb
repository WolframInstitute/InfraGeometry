Cell[TextData[{
 "Every set found resolves the graph, and the first has ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MetricDimension"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/MetricDimension", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e025d841-39ed-497d-bf06-f4ea4581a9fc"],
 " vertices. The Petersen graph:"
}], "ExampleText",ExpressionUUID->"b9d38f46-ee79-4ed9-961c-90efba5ae002"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"PetersenGraph", "[", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"bases", " ", "=", " ", 
     RowBox[{"FindResolvingSet", "[", 
      RowBox[{"g", ",", " ", "6"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"AllTrue", "[", 
      RowBox[{"bases", ",", " ", 
       RowBox[{
        RowBox[{"ResolvingSetQ", "[", 
         RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Length", "[", 
       RowBox[{"First", " ", "@", " ", "bases"}], "]"}], " ", "==", " ", 
      RowBox[{"MetricDimension", "[", "g", "]"}]}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"15d6ab8b-36a0-43d6-a119-c6eb44613eb4"],

