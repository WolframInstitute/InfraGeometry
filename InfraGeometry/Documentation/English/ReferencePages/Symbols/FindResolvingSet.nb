Cell[CellGroupData[{
Cell["FindResolvingSet", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9e5a80e1-49a5-4765-8ea0-dd99068be034"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindResolvingSet"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindResolvingSet", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "efc5e04d-5ffe-4bef-9277-da3c29ac59b8"],
 "\[LineSeparator]",
 "gives a list holding one smallest resolving set of ",
 StyleBox["g", "TI"],
 ", a metric basis.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1b80b5ab-0c22-4989-aad2-f19eabfc0f16"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindResolvingSet"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindResolvingSet", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e793f17-3544-46e2-aef2-8cddad13b513"],
 "\[LineSeparator]",
 "gives up to ",
 StyleBox["n", "TI"],
 " resolving sets, the smallest first.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"89f28903-349d-4917-8b10-eec62c1d673a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindResolvingSet"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindResolvingSet", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["m", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "981c5e60-50c9-4e85-af5b-6c81a3e47fa1"],
 "\[LineSeparator]",
 "takes the sizes of the sets from ",
 StyleBox["m", "TI"],
 ": ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "048184d7-bd33-4875-a1de-7e89e3941333"],
 ", a largest size ",
 StyleBox["k", "TI"],
 ", {",
 StyleBox["min", "TI"],
 ", ",
 StyleBox["max", "TI"],
 "}, or {",
 StyleBox["k", "TI"],
 "} for the size ",
 StyleBox["k", "TI"],
 " only."
}], "Usage",ExpressionUUID->"8ed46a93-e609-42cd-8e61-157bddac294e"],

Cell[TextData[{
 "Definition: a set ",
 StyleBox["B", "TI"],
 " of vertices resolves ",
 StyleBox["g", "TI"],
 " when every vertex is determined by its distances to the vertices of ",
 StyleBox["B", "TI"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ResolvingSetQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ResolvingSetQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c8bd8262-1efa-4262-8358-54503a2e2fff"],
 ". A smallest resolving set is a metric basis, and its size is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MetricDimension"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/MetricDimension", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "979c2724-02ed-4ec0-9f8d-f4a6c395d4f3"],
 "."
}], "Notes",ExpressionUUID->"a2c2be3f-d9fa-4fb2-ac34-8705e5c17bff"],

Cell[TextData[{
 "The search is exhaustive. It tries every set of each size in turn, from the \
smallest size on, and stops once it holds ",
 StyleBox["n", "TI"],
 " sets. A metric basis of ",
 StyleBox["k", "TI"],
 " vertices out of ",
 StyleBox["N", "TI"],
 " is found after at most (",
 StyleBox["N", "TI"],
 " choose ",
 StyleBox["k", "TI"],
 ") tests at the size ",
 StyleBox["k", "TI"],
 ", so the search is fast when the metric dimension is small, and slow \
otherwise."
}], "Notes",ExpressionUUID->"0231d948-c79f-4f13-ae67-85b0adf0e15a"],

Cell[TextData[{
 "After the sets of the smallest size come larger ones, and those may contain \
smaller resolving sets. When no set of the sizes ",
 StyleBox["m", "TI"],
 " resolves ",
 StyleBox["g", "TI"],
 ", the result is {}."
}], "Notes",ExpressionUUID->"f3115947-3f29-439f-a749-ed1f43d88163"]
}, Open  ]],

