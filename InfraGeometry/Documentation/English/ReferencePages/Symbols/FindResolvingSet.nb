Cell["\<\
Twins raise the metric dimension. The square grid substrate is the 8 \[Times] \
8 grid with a pendant vertex at both ends of every row and column, so two \
pendant vertices hang from each corner. No three vertices resolve it, while \
one vertex from each of the four pairs of twins does:\
\>", "ExampleText",ExpressionUUID->"3c287589-592c-4d1f-8e1e-8024261006c2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"leaves", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexDegree", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}], " ", "==", " ", "1"}], " ", 
        "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"twins", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Subsets", "[", 
        RowBox[{"leaves", ",", " ", 
         RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"AdjacencyList", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "==", " ", 
         RowBox[{"AdjacencyList", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"Last", "[", "#", "]"}]}], "]"}]}], " ", "&"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", "twins", ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"FindResolvingSet", "[", 
