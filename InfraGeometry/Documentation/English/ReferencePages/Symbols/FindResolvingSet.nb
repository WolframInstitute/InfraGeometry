Cell["\<\
A metric basis of the square, hexagonal and triangular tilings: three corners.\
\>", "ExampleText",ExpressionUUID->"bf463502-fe16-440f-88f6-3580b9806b21"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graphs", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"#", ",", " ", "\"\<Small\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}],
        " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"bases", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"FindResolvingSet", "[", "#", "]"}]}], " ", "&"}], " ", "/@", 
      " ", "graphs"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraSubstrateHighlight", "[", 
          RowBox[{"#1", ",", " ", 
           RowBox[{"{", "#2", "}"}]}], "]"}], " ", "&"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"graphs", ",", " ", "bases"}], "}"}]}], "]"}], "]"}], ",", 
     " ", "bases"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b16e01ae-8959-4b8f-87ff-81eee8cf9cdd"],

