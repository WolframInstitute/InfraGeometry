Cell[TextData[{
 "Up to ",
 StyleBox["n", "TI"],
 " sets: the 6-cycle has twelve metric bases, every pair of vertices except \
the three opposite pairs."
}], "ExampleText",ExpressionUUID->"0f64396b-a53d-455b-89c4-cddf9a699801"],

