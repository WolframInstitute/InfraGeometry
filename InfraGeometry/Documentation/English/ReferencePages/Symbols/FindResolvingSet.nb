Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"PetersenGraph", "[", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"bases", " ", "=", " ", 
     RowBox[{"FindResolvingSet", "[", 
      RowBox[{"g", ",", " ", "6"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", "#", "}"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
       "bases"}], "]"}], ",", "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"bases", ",", " ", 
       RowBox[{
        RowBox[{"ResolvingSetQ", "[", 
         RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Length", "[", 
       RowBox[{"First", "[", "bases", "]"}], "]"}], " ", "==", " ", 
      RowBox[{"MetricDimension", "[", "g", "]"}]}]}], "}"}]}], "]"}]], "Input",\

