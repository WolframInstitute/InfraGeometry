 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mesh", " ", "=", " ", 
     RowBox[{"DiscretizeRegion", "[", 
      RowBox[{
       RowBox[{"Rectangle", "[", "]"}], ",", " ", 
       RowBox[{"MaxCellMeasure", " ", "->", " ", "0.0085"}]}], "]"}]}], "}"}],
    ",", " ", 
   RowBox[{"{", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"IndexGraph", " ", "@", " ", 
      RowBox[{"MeshConnectivityGraph", "[", 
       RowBox[{"mesh", ",", " ", "0"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", "[", 
     RowBox[{"Sort", " ", "/@", " ", 
      RowBox[{"EdgeList", " ", "@", " ", 
       RowBox[{"BoundarylessGraph", "[", "graph", "]"}]}]}], "]"}], " ", "===",
     " ", 
    RowBox[{"Sort", "[", 
     RowBox[{"Sort", " ", "/@", " ", 
      RowBox[{"EdgeList", " ", "@", " ", 
       RowBox[{"BoundarylessGraph", "[", "mesh", "]"}]}]}], "]"}]}]}], 
