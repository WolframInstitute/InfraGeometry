Cell["\<\
The removed edges are the edges among the rim vertices, drawn thick.\
\>", "ExampleText",ExpressionUUID->"8ab5e96e-78e7-4a69-ac7f-0d2a687859b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"TessellationNeighborhoodGraph", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "6"}], "}"}], ",", " ", "4"}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rim", " ", "=", " ", 
     RowBox[{"GraphExteriorBoundary", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", "rim", "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"EdgeCount", "[", "g", "]"}], " ", "-", " ", 
       RowBox[{"EdgeCount", "[", 
