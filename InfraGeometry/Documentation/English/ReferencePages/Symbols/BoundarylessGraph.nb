Cell["\<\
The 8 \[Times] 8 grid, a ball of the triangular tiling and a triangulated \
disk with the rim contour removed, and the number of edges removed from each.\
\
\>", "ExampleText",ExpressionUUID->"bee36c0f-406f-4753-9aa2-3132ab038cce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mesh", " ", "=", " ", 
     RowBox[{"DiscretizeRegion", "[", 
      RowBox[{
       RowBox[{"Disk", "[", "]"}], ",", " ", 
       RowBox[{"MaxCellMeasure", " ", "->", " ", "0.01"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"graphs", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"8", ",", " ", "8"}], "}"}], "]"}], ",", " ", 
       RowBox[{"TessellationNeighborhoodGraph", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "6"}], "}"}], ",", " ", "4"}], "]"}], ",", 
       " ", 
       RowBox[{"MeshConnectivityGraph", "[", 
        RowBox[{"mesh", ",", " ", "0"}], "]"}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"windows", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"BoundarylessGraph", "[", 
        RowBox[{"graphs", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"BoundarylessGraph", "[", 
        RowBox[{"graphs", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"BoundarylessGraph", "[", "mesh", "]"}]}], "}"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", "windows", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"EdgeCount", " ", "/@", " ", "graphs"}], " ", "-", " ", 
      RowBox[{"EdgeCount", " ", "/@", " ", "windows"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b0b62809-713c-42d3-a23d-7035aa192025"],

