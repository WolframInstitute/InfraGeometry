Cell["\<\
The 10 \[Times] 10 grid and a triangulated square without their contours, \
labelled with the number of edges removed:\
\>", "ExampleText",ExpressionUUID->"fcf200ef-01c8-4c5f-9e93-a693c8785936"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mesh", " ", "=", " ", 
     RowBox[{"DiscretizeRegion", "[", 
      RowBox[{
       RowBox[{"Rectangle", "[", "]"}], ",", " ", 
       RowBox[{"MaxCellMeasure", " ", "->", " ", "0.0085"}]}], "]"}]}], "}"}],
    ",", " ", 
   RowBox[{"{", 
    RowBox[{"grid", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"10", ",", " ", "10"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"BoundarylessGraph", "[", "grid", "]"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{
          RowBox[{"EdgeCount", "[", "grid", "]"}], " ", "-", " ", 
          RowBox[{"EdgeCount", "[", 
           RowBox[{"BoundarylessGraph", "[", "grid", "]"}], "]"}]}]}]}], 
       "]"}], ",", "\n", "    ", 
      RowBox[{"Graph", "[", 
       RowBox[{
