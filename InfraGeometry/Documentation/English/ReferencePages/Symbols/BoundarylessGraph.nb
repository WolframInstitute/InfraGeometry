Cell["\<\
The square grid substrate is the 10 \[Times] 10 grid without its contour, \
with 10\.b2 \[Minus] 4 vertices:\
\>", "ExampleText",ExpressionUUID->"41651b43-b23d-4824-aed9-83e6961c94c2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"window", " ", "=", " ", 
     RowBox[{"BoundarylessGraph", "[", 
      RowBox[{"GridGraph", "[", 
       RowBox[{"{", 
        RowBox[{"10", ",", " ", "10"}], "}"}], "]"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"VertexCount", "[", "window", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"EdgeList", "[", "window", "]"}]}], " ", "===", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"EdgeList", " ", "@", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], 
         "]"}]}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d7810050-73e8-4b4b-83b1-e661d6d66368"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"96", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"05d962ca-ef95-4564-9061-d0d1dbaf9b34"]
}, Open  ]],

