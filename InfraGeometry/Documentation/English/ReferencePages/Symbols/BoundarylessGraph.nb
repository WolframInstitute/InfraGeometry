Cell["\<\
The 8 \[Times] 8 grid, a ball of the triangular tiling and a triangulated \
disk with the rim contour removed, and the number of edges removed from each.\
\
\>", "ExampleText",ExpressionUUID->"f81d91f2-d75e-469b-a7e5-b71fc58ab5d2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mesh", " ", "=", " ", 
     RowBox[{"DiscretizeRegion", "[", 
      RowBox[{
       RowBox[{"Disk", "[", "]"}], ",", " ", 
       RowBox[{"MaxCellMeasure", " ", "->", " ", "0.01"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"graphs", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"8", ",", " ", "8"}], "}"}], "]"}], ",", " ", 
       RowBox[{"TessellationNeighborhoodGraph", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "6"}], "}"}], ",", " ", "4"}], "]"}], ",", 
       " ", 
       RowBox[{"MeshConnectivityGraph", "[", 
        RowBox[{"mesh", ",", " ", "0"}], "]"}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"windows", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"BoundarylessGraph", "[", 
        RowBox[{
         RowBox[{"graphs", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<MaxDegree\>\""}]}], "]"}], ",",
        " ", 
       RowBox[{"BoundarylessGraph", "[", 
        RowBox[{
         RowBox[{"graphs", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<MaxDegree\>\""}]}], "]"}], ",",
        " ", 
       RowBox[{"BoundarylessGraph", "[", "mesh", "]"}]}], "}"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", "windows", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"EdgeCount", " ", "/@", " ", "graphs"}], " ", "-", " ", 
      RowBox[{"EdgeCount", " ", "/@", " ", "windows"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a842c044-48d1-411d-b57e-31b849def523"],

