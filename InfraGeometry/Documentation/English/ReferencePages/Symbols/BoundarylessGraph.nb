Cell["\<\
The square tiling substrate is the ball of radius 7 of the square tiling \
without its rim contour.\
\>", "ExampleText",ExpressionUUID->"5bb37377-3563-45b6-9bb2-2f10f7ce3305"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"window", " ", "=", " ", 
     RowBox[{"BoundarylessGraph", "[", 
      RowBox[{
       RowBox[{"TessellationNeighborhoodGraph", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "4"}], "}"}], ",", " ", "7"}], "]"}], ",", 
       " ", 
       RowBox[{"Method", " ", "->", " ", "\"\<MaxDegree\>\""}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"window", ",", " ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"EdgeList", "[", "window", "]"}], "]"}], " ", "===", " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"EdgeList", " ", "@", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
         "]"}]}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"76f17b3a-9085-48cd-ab89-1d637ed6d4d1"],

