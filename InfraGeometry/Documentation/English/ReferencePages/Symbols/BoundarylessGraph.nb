          RowBox[{"MeshCellCount", "[", 
           RowBox[{"mesh", ",", " ", "1"}], "]"}], " ", "-", " ", 
          RowBox[{"EdgeCount", "[", 
           RowBox[{"BoundarylessGraph", "[", "mesh", "]"}], "]"}]}]}]}], 
       "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4277242a-b624-4050-b693-5f0333dfe474"],

