Notebook[{

Cell[CellGroupData[{
Cell["BoundarylessGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"944b7d7d-13b5-4430-8bb3-d3e682b42f6a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BoundarylessGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BoundarylessGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "041b1466-48e3-4004-b94f-64da52519000"],
 "\[LineSeparator]",
 "deletes every edge of ",
 StyleBox["g", "TI"],
 " whose two ends lie on its rim, then the vertices this leaves without an \
edge.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"cc52996e-820e-4df6-b0a2-21d770da3313"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BoundarylessGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BoundarylessGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["mr", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cfd35603-feb3-4350-9cb4-24fe168e27a7"],
 "\[LineSeparator]",
 "does the same on the edges of the mesh region ",
 StyleBox["mr", "TI"],
 ", whose rim is its boundary."
}], "Usage",ExpressionUUID->"c616f44a-aa5e-4ec3-b881-2d59dbe5b914"],

Cell[TextData[{
 "Definition: let ",
 StyleBox["\[PartialD]g", "TI"],
 " be the rim, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GraphExteriorBoundary"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GraphExteriorBoundary", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f0feb27-6267-4263-ae98-c7ac400d8b73"],
 ". The result is ",
 StyleBox["g", "TI"],
 " without the edges {",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "} with ",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 " \[Element] ",
 StyleBox["\[PartialD]g", "TI"],
 ", and without the vertices that then have no edge."
}], "Notes",ExpressionUUID->"34630428-c1dd-442d-b0b2-e8f6a8fce5c4"],

Cell["\<\
The contour of the rim disappears, while a rim vertex with an edge inward \
stays as a whisker. The graph models an open window onto the geometry, a \
patch with no contour drawn round it.\
\>", "Notes",ExpressionUUID->"920d41e8-28ce-4bda-bffc-0cfb757b1801"],

Cell[TextData[{
 "The vertex coordinates are kept, in their own dimension; ",
 Cell[BoxData["\"\<KeepCoordinates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e186d0b1-f584-483c-8501-b0e55c4ddbaa"],
 " -> ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1b151b9e-3a23-4946-b4bf-65d2805e3d7b"],
 " drops them. The rim of a graph is the one of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphExteriorBoundary"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/GraphExteriorBoundary", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "76c48787-2fa5-4dee-9eef-2773f15b717d"],
 ", with no method to choose; the rim of a mesh region is exact, and its \
vertices are numbered as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MeshCoordinates"]], "paclet:ref/MeshCoordinates"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3a577f1b-a1b5-4e84-be6f-3f27da27feaf"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f0ae5306-5b03-4b30-9f19-63785b1feb8d"],
 " options are passed on to the graph."
}], "Notes",ExpressionUUID->"9417e067-d45b-43f9-a93f-3d3713c83200"],

Cell[TextData[{
 "The patches of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e486d509-0c6e-4900-9b61-6ca5ed4715aa"],
 " are made this way: the tilings from balls of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationNeighborhoodGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationNeighborhoodGraph",
     "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e433a92f-2085-42da-b8fb-6b3262e2971b"],
 ", the grids from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GridGraph"]], "paclet:ref/GridGraph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1bee1ad0-8d24-4b3c-ab77-826dab347dc9"],
 ", the meshes from their mesh regions."
}], "Notes",ExpressionUUID->"08053fe4-8f00-4e1c-b573-0b79817e49ed"]
}, Open  ]],

