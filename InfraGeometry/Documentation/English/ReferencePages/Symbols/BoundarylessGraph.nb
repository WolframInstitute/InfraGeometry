Notebook[{

Cell[CellGroupData[{
Cell["BoundarylessGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"32460dac-b29d-474b-b231-0162ce032fa8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BoundarylessGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BoundarylessGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9411aec-31e1-428f-a58d-954d7d854dc2"],
 "\[LineSeparator]",
 "deletes every edge of ",
 StyleBox["g", "TI"],
 " whose two ends lie on its rim, then the vertices this leaves without an \
edge.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3992825a-ecc7-4444-a048-315d968f6a2c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BoundarylessGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BoundarylessGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["mr", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45602158-ce4d-4e5e-940f-2ae2a8cbeead"],
 "\[LineSeparator]",
 "does the same on the edges of the mesh region ",
 StyleBox["mr", "TI"],
 ", whose rim is its boundary."
}], "Usage",ExpressionUUID->"8de1fce3-c6f7-4613-97ad-df215cb6ca37"],

Cell[TextData[{
 "Definition: let ",
 StyleBox["\[PartialD]g", "TI"],
 " be the rim, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GraphExteriorBoundary"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GraphExteriorBoundary", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef90b51b-bc6d-4b18-8da8-6028c5c8f5b2"],
 ". The result is ",
 StyleBox["g", "TI"],
 " without the edges {",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "} with ",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 " \[Element] ",
 StyleBox["\[PartialD]g", "TI"],
 ", and without the vertices that then have no edge."
}], "Notes",ExpressionUUID->"5e3ad2d7-dd0a-49a7-9de3-52ac76a30168"],

Cell["\<\
The contour of the rim disappears, while a rim vertex with an edge inward \
stays as a whisker. The graph models an open window onto the geometry, a \
patch with no contour drawn round it.\
\>", "Notes",ExpressionUUID->"e556b26f-3b43-4966-a9c5-da45541f1010"],

Cell[TextData[{
 "The vertex coordinates are kept, in their own dimension; ",
 Cell[BoxData["\"\<KeepCoordinates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9360245c-4850-45a0-807d-d512478f6ddf"],
 " -> ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "da8887d3-5463-49d4-b484-dc82c7613cc2"],
 " drops them. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Method"]], "paclet:ref/Method"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b5b305ca-4d1c-4be6-ba9c-9843c6ce7bed"],
 " goes to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphExteriorBoundary"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/GraphExteriorBoundary", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f638be4e-64bb-4500-b84e-1e1211cb1107"],
 " and decides the rim of a graph: ",
 Cell[BoxData["\"\<AverageDegree\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0e31830-4d48-4db8-878f-327224afaff0"],
 " by default, ",
 Cell[BoxData["\"\<MaxDegree\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "291e1b5e-989d-4992-b6a5-630c42633ef0"],
 " for lattices and tilings. The rim of a mesh region is exact, and its \
vertices are numbered as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MeshCoordinates"]], "paclet:ref/MeshCoordinates"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "751d673f-c990-4cdd-8856-f506b87bd8aa"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5db3e28d-e889-46e8-98ab-16f54ec39f31"],
 " options are passed on to the graph."
}], "Notes",ExpressionUUID->"5a3cc3f1-c3ac-4371-bfc0-ab009f19b6af"],

Cell[TextData[{
 "The patches of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "28477230-f4f3-4549-aba3-6ec27ae4e4b1"],
 " are made this way: the tilings from balls of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationNeighborhoodGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationNeighborhoodGraph",
     "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "83e07cb8-e51d-4f82-b5cd-b15166a09c50"],
 ", the grids from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GridGraph"]], "paclet:ref/GridGraph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a09bc76d-f1bc-4df2-a017-a36f8174b94b"],
 ", the meshes from their mesh regions."
}], "Notes",ExpressionUUID->"38a50be3-8f43-4022-ac3d-9effdd3eb869"]
}, Open  ]],

