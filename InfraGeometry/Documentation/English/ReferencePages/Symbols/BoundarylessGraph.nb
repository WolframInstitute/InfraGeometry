Notebook[{

Cell[CellGroupData[{
Cell["BoundarylessGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"75a0789e-fb86-4147-9293-e11242fdf1a6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BoundarylessGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BoundarylessGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc3d85fb-f24c-4a13-be71-90af8cf7c9bf"],
 "\[LineSeparator]",
 "deletes every edge of ",
 StyleBox["g", "TI"],
 " with both ends on its rim, then the vertices this leaves without an \
edge.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f3c1e967-8499-4540-9de9-9cef7952ea0f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BoundarylessGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BoundarylessGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["mr", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e37f078-7094-483c-a791-d2381c2705e8"],
 "\[LineSeparator]",
 "does the same on the edges of the mesh region ",
 StyleBox["mr", "TI"],
 ", whose rim is its boundary."
}], "Usage",ExpressionUUID->"8bbade0d-625f-47b7-9d04-32ab720a7c88"],

Cell[TextData[{
 "With ",
 StyleBox["\[PartialD]g", "TI"],
 " the rim, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GraphExteriorBoundary"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GraphExteriorBoundary", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9dfec1c-df74-49f2-9b41-78cd6d946754"],
 ", the result is ",
 StyleBox["g", "TI"],
 " \[Minus] {",
 StyleBox["uv", "TI"],
 " : ",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 " \[Element] ",
 StyleBox["\[PartialD]g", "TI"],
 "}, without its isolated vertices."
}], "Notes",ExpressionUUID->"ceb14b1a-b9b2-46bd-bee5-1abd35c582c9"],

Cell["\<\
The contour of the rim disappears, and a rim vertex with an edge inward stays \
as a whisker. The graph models an open subset of the plane or of space: a \
window onto the geometry with no curve drawn round it.\
\>", "Notes",ExpressionUUID->"f3b06b5a-bdd2-49e0-af94-248177a8535f"],

Cell[TextData[{
 "On the ",
 StyleBox["n", "TI"],
 " \[Times] ",
 StyleBox["n", "TI"],
 " grid the contour has 4(",
 StyleBox["n", "TI"],
 " \[Minus] 1) edges and the four corners are left isolated, so ",
 StyleBox["n", "TI"],
 "\.b2 \[Minus] 4 vertices remain."
}], "Notes",ExpressionUUID->"2b1b0b59-8dab-4ff6-86bc-0a67a2eb3b54"],

Cell[TextData[{
 "The patches of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "728645d2-fff6-4f65-80bd-e3ea0e4241d5"],
 " are made this way: the grids from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GridGraph"]], "paclet:ref/GridGraph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cc2d69a9-797a-4cf7-90c0-649d481b2672"],
 ", the tilings from balls of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationNeighborhoodGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationNeighborhoodGraph",
     "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "08fea21c-0617-4104-b378-aca987380cd6"],
 ", the meshes from their mesh regions."
}], "Notes",ExpressionUUID->"124b330b-a9d1-43ca-9717-b7f9abd01e56"],

