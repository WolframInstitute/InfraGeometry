Cell["\<\
On the graph of a mesh the degree test also marks vertices inside, and edges \
inside are removed. The mesh region itself has an exact rim. The disk without \
its rim from the graph and from the mesh region, and the numbers of edges \
removed:\
\>", "ExampleText",ExpressionUUID->"721c1732-cda8-4efb-99be-f63d6d86d0f6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mesh", " ", "=", " ", 
     RowBox[{"DiscretizeRegion", "[", 
      RowBox[{
       RowBox[{"Disk", "[", "]"}], ",", " ", 
       RowBox[{"MaxCellMeasure", " ", "->", " ", "0.01"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"MeshConnectivityGraph", "[", 
      RowBox[{"mesh", ",", " ", "0"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"windows", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"BoundarylessGraph", "[", "graph", "]"}], ",", " ", 
       RowBox[{"BoundarylessGraph", "[", "mesh", "]"}]}], "}"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", "windows", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"EdgeCount", "[", "graph", "]"}], " ", "-", " ", 
      RowBox[{"EdgeCount", " ", "/@", " ", "windows"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"46d03e5a-a2cf-4c3f-af99-236f0f0cb592"],

