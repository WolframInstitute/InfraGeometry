Cell["\<\
The graph of a mesh gives the same window as the mesh region: the disk \
without its rim from the graph and from the mesh region, and the numbers of \
edges removed.\
\>", "ExampleText",ExpressionUUID->"29020809-e620-4dcf-8993-68cb7f5bee06"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mesh", " ", "=", " ", 
     RowBox[{"DiscretizeRegion", "[", 
      RowBox[{
       RowBox[{"Disk", "[", "]"}], ",", " ", 
       RowBox[{"MaxCellMeasure", " ", "->", " ", "0.01"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"IndexGraph", " ", "@", " ", 
      RowBox[{"MeshConnectivityGraph", "[", 
       RowBox[{"mesh", ",", " ", "0"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"windows", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"BoundarylessGraph", "[", "graph", "]"}], ",", " ", 
       RowBox[{"BoundarylessGraph", "[", "mesh", "]"}]}], "}"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", "windows", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"EdgeCount", "[", "graph", "]"}], " ", "-", " ", 
      RowBox[{"EdgeCount", " ", "/@", " ", "windows"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"6626226e-f206-41e7-b604-3f67832e95ff"],

