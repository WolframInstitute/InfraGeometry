Cell["\<\
The square tiling substrate is the ball of radius 7 of the square tiling \
without its rim contour.\
\>", "ExampleText",ExpressionUUID->"29cf462a-bf59-4474-a326-c94b69b54907"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"window", " ", "=", " ", 
     RowBox[{"BoundarylessGraph", "[", 
      RowBox[{"TessellationNeighborhoodGraph", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], ",", " ", "7"}], "]"}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"window", ",", " ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"EdgeList", "[", "window", "]"}], "]"}], " ", "===", " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"EdgeList", " ", "@", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
         "]"}]}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ee7c6f59-428d-454f-9dc1-34f24ffef105"],

