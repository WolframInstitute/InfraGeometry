Notebook[{

Cell[CellGroupData[{
Cell["InfraSolidOfRevolution", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"52250876-53ee-4ed5-8d54-0751bbd99e2c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSolidOfRevolution"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSolidOfRevolution", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["profile", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2b025bf-3b5b-4217-97b2-07bfd0228c66"],
 "\[LineSeparator]",
 "is the solid about ",
 StyleBox["axis", "TI"],
 " whose radius along the axis is ",
 StyleBox["profile", "TI"],
 ": the vertices within the radius of the axis vertex they project to, with \
flat ends. It is a symbolic object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b62d5293-d75c-459c-b8d2-7103e74c7236"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSolidOfRevolution"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSolidOfRevolution", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f30f5016-00ba-4cdc-985e-1c70ecabec81"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7ae0cc77-5e90-4169-9bfa-bb54aef53e8d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSolidOfRevolution"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSolidOfRevolution", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["profile", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "119fe2d2-3c80-4ba5-aa47-4a00b8858534"],
 "\[LineSeparator]",
 "is the rounded solid, the union of the balls of radius ",
 StyleBox["r_i", "TI"],
 " about the axis vertices."
}], "Usage",ExpressionUUID->"e6834855-5e11-4559-baa7-f25ad55d545c"],

Cell[TextData[{
 "Definition: the solid of revolution of the profile ",
 StyleBox["r_1, \[Ellipsis], r_m", "TI"],
 " about the axis ",
 StyleBox["a_1, \[Ellipsis], a_m", "TI"],
 " is the sliced tube ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["profile", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Sliced\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80b06d75-a294-47ab-b801-b4b490f7d13f"],
 ". Slice ",
 StyleBox["i", "TI"],
 " is the set of vertices whose nearest axis vertex is ",
 StyleBox["a_i", "TI"],
 ", a tie lying in every nearest slice, and ",
 StyleBox["v", "TI"],
 " is in the solid when ",
 StyleBox["d(a_i, v) \[LessEqual] r_i", "TI"],
 " for its slice. The profile is read at the discrete foot of the \
perpendicular, so a jump of the profile is a sharp step."
}], "Notes",ExpressionUUID->"ded74071-cbb9-45aa-9f8a-55d5595e6ce3"],

Cell[TextData[{
 StyleBox["profile", "TI"],
 " is a list of radii or bands, one per axis vertex, or a function of the \
position ",
 StyleBox["i", "TI"],
 "; a band ",
 StyleBox["{s, t}", "TI"],
 " keeps the vertices at distance between ",
 StyleBox["s", "TI"],
 " and ",
 StyleBox["t", "TI"],
 ", and the band ",
 StyleBox["{r, r}", "TI"],
 " is the surface. A pair of numbers is a band constant along the axis."
}], "Notes",ExpressionUUID->"6be52e4d-5a71-4e6d-b4a4-af8baac16181"],

Cell["\<\
The axis is a walk: a vertex, a vertex list, or a path or cycle graph. It is \
prolonged straight on past both ends, and the vertices nearer a prolongation \
than the axis are cut, so the ends are flat. A closed axis has no ends.\
\>", "Notes",ExpressionUUID->"ec097674-a562-4bc0-8594-635a43526af1"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCylinder"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f6f4db3f-98c1-49f2-8626-d78e1ccf526a"],
 " is the constant profile and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCone"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCone", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aea3b441-3b31-4cc6-a42c-3578679c4fd4"],
 " the linear one, ",
 StyleBox["r_i = slope (i \[Minus] 1)", "TI"],
 ". ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b926b15-aa19-42ff-9970-cdc7a347a84c"],
 " drops the slicing."
}], "Notes",ExpressionUUID->"c7b78650-1865-4634-b58a-66435a147e60"],

Cell[TextData[{
 "The head computes nothing. A solid has one member, the vertex set. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6be4c781-8a94-416c-bbe2-259aa9da86cd"],
 " reads ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e2fb0ad-dbab-47e5-83d9-c2ff6170c983"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b8df912-560b-4f4e-8b1d-76fc246ad18e"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ec26af8-0c07-43c2-b13f-6532eb1c6f6b"],
 ", ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aad7833c-b1c8-4794-acbd-d5a6c676f815"],
 " and ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68624149-c828-4bc4-823a-b4a79e9b719f"],
 ", and the two measures."
}], "Notes",ExpressionUUID->"d9166a2f-bfa9-48a9-8fcb-c35130b99359"]
}, Open  ]],

