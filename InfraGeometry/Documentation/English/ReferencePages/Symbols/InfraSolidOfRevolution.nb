Cell["\<\
A strip of width 3 with one row of width 7, a sharp step, about a row of the \
square grid; the profile as a list, a function of the position, and rounded.\
\>", "ExampleText",ExpressionUUID->"0c13ecc7-a1ee-4276-8292-27a0466c6020"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"11", ",", " ", "11"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"55", " ", "+", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"2", ",", " ", "8"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraSolidOfRevolution", "[", 
           RowBox[{"axis", ",", " ", 
            RowBox[{"{", 
             RowBox[{
             "1", ",", " ", "1", ",", " ", "1", ",", " ", "3", ",", " ", "1", 
              ",", " ", "1", ",", " ", "1"}], "}"}]}], "]"}], ",", " ", 
          "axis"}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraSolidOfRevolution", "[", 
           RowBox[{"axis", ",", " ", 
            RowBox[{"i", " ", "|->", " ", 
             RowBox[{"1", " ", "+", " ", 
              RowBox[{"Floor", "[", 
               RowBox[{"3", " ", 
                RowBox[{"Sin", "[", 
                 RowBox[{"Pi", " ", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"i", " ", "-", " ", "1"}], ")"}], "/", "6"}]}], 
                 "]"}]}], "]"}]}]}]}], "]"}], ",", " ", "axis"}], "}"}]}], 
       "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraSolidOfRevolution", "[", 
           RowBox[{"axis", ",", " ", 
            RowBox[{"{", 
             RowBox[{
             "1", ",", " ", "1", ",", " ", "1", ",", " ", "3", ",", " ", "1", 
              ",", " ", "1", ",", " ", "1"}], "}"}], ",", " ", 
            RowBox[{"Method", " ", "->", " ", "\"\<Balls\>\""}]}], "]"}], ",",
           " ", "axis"}], "}"}]}], "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"270559c2-e979-4304-b92f-17fb2703e609"],

