Cell["\<\
The constant profile is the cylinder, and the linear profile the cone:\
\>", "ExampleText",ExpressionUUID->"e739596a-b035-4eb7-bece-954e72cf4747"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "6"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSolidOfRevolution", "[", 
          RowBox[{"axis", ",", " ", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"2", ",", " ", "7"}], "]"}]}], "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], "]"}]}], " ", "==", "\n", "     ", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCylinder", "[", 
          RowBox[{"axis", ",", " ", "2"}], "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], "]"}]}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSolidOfRevolution", "[", 
          RowBox[{"axis", ",", " ", 
           RowBox[{"i", " ", "|->", " ", 
            RowBox[{"i", " ", "-", " ", "1"}]}]}], "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], "]"}]}], " ", "==", "\n", "     ", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCone", "[", 
          RowBox[{"axis", ",", " ", "1"}], "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], "]"}]}]}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"7ddf663c-6804-43f5-9cdb-874fa38f1254"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b3abff59-fac2-485c-9d1a-8badeb162565"]
}, Open  ]],

Cell["The balls contain the sliced solid:", "ExampleText",ExpressionUUID->"7e85604f-8d01-42b8-a342-752bcb016aef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "6"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"SubsetQ", "[", 
    RowBox[{
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraSolidOfRevolution", "[", 
         RowBox[{"axis", ",", " ", 
          RowBox[{"{", 
           RowBox[{
           "1", ",", " ", "2", ",", " ", "3", ",", " ", "3", ",", " ", "3", ",",
             " ", "2", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<Balls\>\""}]}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraSolidOfRevolution", "[", 
         RowBox[{"axis", ",", " ", 
          RowBox[{"{", 
           RowBox[{
           "1", ",", " ", "2", ",", " ", "3", ",", " ", "3", ",", " ", "3", ",",
             " ", "2", ",", " ", "1"}], "}"}]}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5413e189-a773-48c8-a852-162dcb758021"],

