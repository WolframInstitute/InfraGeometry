Cell["\<\
A strip of width 3 with one row of width 7, a sharp step, about a row of the \
square grid; the profile as a list, a function of the position, and rounded.\
\>", "ExampleText",ExpressionUUID->"de8e4ef1-f123-48da-985e-f68721a6d969"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"11", ",", " ", "11"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"55", " ", "+", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"2", ",", " ", "8"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraSolidOfRevolution", "[", 
           RowBox[{"axis", ",", " ", 
            RowBox[{"{", 
             RowBox[{
             "1", ",", " ", "1", ",", " ", "1", ",", " ", "3", ",", " ", "1", 
              ",", " ", "1", ",", " ", "1"}], "}"}]}], "]"}], ",", " ", 
          "axis"}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraSolidOfRevolution", "[", 
           RowBox[{"axis", ",", " ", 
            RowBox[{"i", " ", "|->", " ", 
             RowBox[{"1", " ", "+", " ", 
              RowBox[{"Floor", "[", 
               RowBox[{"3", " ", 
                RowBox[{"Sin", "[", 
                 RowBox[{"Pi", " ", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"i", " ", "-", " ", "1"}], ")"}], "/", "6"}]}], 
                 "]"}]}], "]"}]}]}]}], "]"}], ",", " ", "axis"}], "}"}]}], 
       "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraSolidOfRevolution", "[", 
           RowBox[{"axis", ",", " ", 
            RowBox[{"{", 
             RowBox[{
             "1", ",", " ", "1", ",", " ", "1", ",", " ", "3", ",", " ", "1", 
              ",", " ", "1", ",", " ", "1"}], "}"}], ",", " ", 
            RowBox[{"Method", " ", "->", " ", "\"\<Balls\>\""}]}], "]"}], ",",
           " ", "axis"}], "}"}]}], "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ae8928e1-4c59-4c01-b36a-c099982f866d"],

