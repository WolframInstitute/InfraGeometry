Cell["\<\
A sharp step of the profile, sliced and as a union of balls. The balls round \
the ends and spread the step into a diamond:\
\>", "ExampleText",ExpressionUUID->"4b742c62-03fe-4dfe-b766-6f424d4b2ab8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "6"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraSolidOfRevolution", "[", 
           RowBox[{"axis", ",", " ", 
            RowBox[{"{", 
             RowBox[{
             "1", ",", " ", "1", ",", " ", "1", ",", " ", "3", ",", " ", "1", 
              ",", " ", "1", ",", " ", "1"}], "}"}], ",", " ", 
            RowBox[{"Method", " ", "->", " ", "method"}]}], "]"}], ",", " ", 
          "axis"}], "}"}], ",", "\n", "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSolidOfRevolution", "[", 
            RowBox[{"axis", ",", " ", 
             RowBox[{"{", 
              RowBox[{
              "1", ",", " ", "1", ",", " ", "1", ",", " ", "3", ",", " ", "1",
                ",", " ", "1", ",", " ", "1"}], "}"}], ",", " ", 
             RowBox[{"Method", " ", "->", " ", "method"}]}], "]"}], ",", 
           " ", "\"\<CountingMeasure\>\""}], "]"}]}]}], "]"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"method", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Sliced\>\"", ",", " ", "\"\<Balls\>\""}], "}"}]}], 
       "}"}]}], "]"}]}]}], "]"}]], "Input",
