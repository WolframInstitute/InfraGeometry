Notebook[{

Cell[CellGroupData[{
Cell["InfraSolidOfRevolution", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"58e87433-06ca-49aa-8567-35d17b2c33f6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSolidOfRevolution"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSolidOfRevolution", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["profile", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "afc2096a-607d-44fd-a3b4-402be3b0d341"],
 "\[LineSeparator]",
 "is the solid about the walk ",
 StyleBox["axis", "TI"],
 " whose radius at the ",
 StyleBox["i", "TI"],
 "-th axis vertex is the ",
 StyleBox["i", "TI"],
 "-th entry of ",
 StyleBox["profile", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"40e0139e-80ad-4fca-8d5e-ae5351bad947"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSolidOfRevolution"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSolidOfRevolution", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["profile", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61b15f7a-d1f2-4224-91e9-fe1ebb0acbcc"],
 "\[LineSeparator]",
 "is the union of the balls of the profile radii about the axis vertices."
}], "Usage",ExpressionUUID->"3f11e0a9-68e9-4f16-b114-5cc489a27cf9"],

Cell[TextData[{
 "For the axis ",
 StyleBox["a\:2081, \[Ellipsis], a\:2098", "TI"],
 " and the radii ",
 StyleBox["r\:2081, \[Ellipsis], r\:2098", "TI"],
 ", a vertex ",
 StyleBox["v", "TI"],
 " belongs to the solid when ",
 StyleBox["d(a\:1d62, v) \[LessEqual] r\:1d62", "TI"],
 " for an axis vertex ",
 StyleBox["a\:1d62", "TI"],
 " nearest to ",
 StyleBox["v", "TI"],
 ". The nearest axis vertex is the foot of the perpendicular from ",
 StyleBox["v", "TI"],
 ": the radius is read slice by slice, and a jump of the profile is a sharp \
step."
}], "Notes",ExpressionUUID->"b357ddc7-2953-44ff-b387-c396d44e8aa1"],

Cell[TextData[{
 "The axis is prolonged straight past both ends, and the vertices nearer a \
prolongation than the axis are cut, so the ends are flat. With ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Balls\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6c74b75-f2b5-4f8e-a9ac-db255d139233"],
 " the solid is the union of the balls ",
 StyleBox["B_{r\:1d62}(a\:1d62)", "TI"],
 ", with round ends and no sharp steps."
}], "Notes",ExpressionUUID->"954a70f6-941d-4b81-882c-a73164dcb69e"],

Cell[TextData[{
 StyleBox["profile", "TI"],
 " is a list with one entry per axis vertex, or a function of the position ",
 StyleBox["i", "TI"],
 ". An entry {",
 StyleBox["s", "TI"],
 ", ",
 StyleBox["t", "TI"],
 "} keeps the vertices at distance ",
 StyleBox["s", "TI"],
 " to ",
 StyleBox["t", "TI"],
 "; the constant band {",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["r", "TI"],
 "} gives the surface of revolution."
}], "Notes",ExpressionUUID->"0e125096-acf3-41fe-b38f-3a0fab4afad6"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCylinder"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "042443bd-d90b-4aaf-9b47-77771cd3ff11"],
