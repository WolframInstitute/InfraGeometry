Cell["\<\
The constant profile is the cylinder, and the linear profile the cone.\
\>", "ExampleText",ExpressionUUID->"72b88a0a-85ac-4cf9-9c73-a5099bb823a1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"11", ",", " ", "11"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"55", " ", "+", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"2", ",", " ", "8"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"FindInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraSolidOfRevolution", "[", 
         RowBox[{"axis", ",", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"1", ",", " ", "7"}], "]"}]}], "]"}]}], "]"}], " ", "===", 
      " ", 
      RowBox[{"FindInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCylinder", "[", 
         RowBox[{"axis", ",", " ", "1"}], "]"}]}], "]"}]}], ",", "\n", "   ", 
     
     RowBox[{
      RowBox[{"FindInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraSolidOfRevolution", "[", 
         RowBox[{"axis", ",", " ", 
          RowBox[{"i", " ", "|->", " ", 
           RowBox[{"i", " ", "-", " ", "1"}]}]}], "]"}]}], "]"}], " ", "===", 
      " ", 
      RowBox[{"FindInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCone", "[", 
         RowBox[{"axis", ",", " ", "1"}], "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cd1fd654-3487-4ea5-88c6-8f359f430e90"],

