Cell["\<\
The constant profile is the cylinder, and the linear profile the cone.\
\>", "ExampleText",ExpressionUUID->"192ea1a6-dbac-41a5-b569-5f87a7ae6e31"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"11", ",", " ", "11"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"55", " ", "+", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"2", ",", " ", "8"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", " ", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSolidOfRevolution", "[", 
          RowBox[{"axis", ",", " ", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"1", ",", " ", "7"}], "]"}]}], "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], " ", "]"}]}], " ", "===", " ", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", " ", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCylinder", "[", 
          RowBox[{"axis", ",", " ", "1"}], "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", " ", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSolidOfRevolution", "[", 
          RowBox[{"axis", ",", " ", 
           RowBox[{"i", " ", "|->", " ", 
            RowBox[{"i", " ", "-", " ", "1"}]}]}], "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], " ", "]"}]}], " ", "===", " ", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", " ", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCone", "[", 
          RowBox[{"axis", ",", " ", "1"}], "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8856eda2-6630-4678-be08-c1a0ec3aa91c"],

