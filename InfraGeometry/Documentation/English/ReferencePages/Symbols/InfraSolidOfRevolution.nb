Notebook[{

Cell[CellGroupData[{
Cell["InfraSolidOfRevolution", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8e27134d-635b-4473-a246-18adaca68d4f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSolidOfRevolution"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSolidOfRevolution", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["profile", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "274fc7b0-c5e8-48ce-bd14-6d45f695218e"],
 "\[LineSeparator]",
 "is the solid about ",
 StyleBox["axis", "TI"],
 " whose radius along the axis is ",
 StyleBox["profile", "TI"],
 ": the vertices within the radius of the axis vertex they project to, with \
flat ends. It is a symbolic object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1afe329a-badf-43cc-9554-e1f7a6ac0307"],
 " evaluates it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3bc1b5a9-d2d0-4ff4-861a-d4a55f392a75"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSolidOfRevolution"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSolidOfRevolution", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["profile", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ccd0512b-6202-42ae-9535-f6a28e2d2dd6"],
 "\[LineSeparator]",
 "is the rounded solid, the union of the balls of radius ",
 StyleBox["r_i", "TI"],
 " about the axis vertices."
}], "Usage",ExpressionUUID->"241de123-68cf-44b9-9b9c-ef1fb3bef0d5"],

Cell[TextData[{
 "Definition: the solid of revolution of the profile ",
 StyleBox["r_1, \[Ellipsis], r_m", "TI"],
 " about the axis ",
 StyleBox["a_1, \[Ellipsis], a_m", "TI"],
 " is the sliced tube ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["profile", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Sliced\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fb34da9-434c-4b18-ad2e-a816efcf2885"],
 ". Slice ",
 StyleBox["i", "TI"],
 " is the set of vertices whose nearest axis vertex is ",
 StyleBox["a_i", "TI"],
 ", a tie lying in every nearest slice, and ",
 StyleBox["v", "TI"],
 " is in the solid when ",
 StyleBox["d(a_i, v) \[LessEqual] r_i", "TI"],
 " for its slice. The profile is read at the discrete foot of the \
perpendicular, so a jump of the profile is a sharp step."
}], "Notes",ExpressionUUID->"cf3fd06b-413f-4cbd-a6d5-487744cc3f7b"],

Cell[TextData[{
 StyleBox["profile", "TI"],
 " is a list of radii or bands, one per axis vertex, or a function of the \
position ",
 StyleBox["i", "TI"],
 "; a band ",
 StyleBox["{s, t}", "TI"],
 " keeps the vertices at distance between ",
 StyleBox["s", "TI"],
 " and ",
 StyleBox["t", "TI"],
 ", and the band ",
 StyleBox["{r, r}", "TI"],
 " is the surface. A pair of numbers is a band constant along the axis."
}], "Notes",ExpressionUUID->"81fbffb5-4f03-4f63-80f2-2efb87449294"],

Cell["\<\
The axis is a walk: a vertex, a vertex list, or a path or cycle graph. It is \
prolonged straight on past both ends, and the vertices nearer a prolongation \
than the axis are cut, so the ends are flat. A closed axis has no ends.\
\>", "Notes",ExpressionUUID->"832d3483-d496-41ee-8bb1-5c73354dbaaa"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCylinder"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "595f5087-a03a-4c33-aa05-a1a8d9d97506"],
 " is the constant profile and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCone"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCone", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3a3d77cd-5dbd-46cd-8586-3918cb533c10"],
 " the linear one, ",
 StyleBox["r_i = slope (i \[Minus] 1)", "TI"],
 ". ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "086a6946-f67f-42db-a958-7a083b30f2d2"],
 " drops the slicing."
}], "Notes",ExpressionUUID->"bbbce40b-592a-49d8-9c1c-c5a8d6427e49"],

Cell[TextData[{
 "The head computes nothing. A solid has one member, the vertex set. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c30f631c-8e8b-4ea1-bfdc-fdb44a3e773d"],
 " reads ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67265700-6465-4495-89f0-8a2f706d3b1e"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8db08413-9e9d-42d6-8610-700cff6b2b52"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "838ae8fd-7b8e-4203-a55e-24e095f175b0"],
 ", ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6cccd83-7c63-48ce-83f1-825c82636d67"],
 " and ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f1d52d7-c195-4f15-ad96-399928658458"],
 ", and the two measures."
}], "Notes",ExpressionUUID->"4157c4cc-cca7-4e25-a16a-7a9c55bbfa3a"]
}, Open  ]],

