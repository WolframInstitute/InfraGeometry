Cell["\<\
The constant profile is the cylinder, and the linear profile the cone.\
\>", "ExampleText",ExpressionUUID->"bcd1377c-59be-4cb0-81f4-be9bb499113c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"11", ",", " ", "11"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"55", " ", "+", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"2", ",", " ", "8"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"FindInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraSolidOfRevolution", "[", 
         RowBox[{"axis", ",", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"1", ",", " ", "7"}], "]"}]}], "]"}]}], "]"}], " ", "===", 
      " ", 
      RowBox[{"FindInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCylinder", "[", 
         RowBox[{"axis", ",", " ", "1"}], "]"}]}], "]"}]}], ",", "\n", "   ", 
     
     RowBox[{
      RowBox[{"FindInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraSolidOfRevolution", "[", 
         RowBox[{"axis", ",", " ", 
          RowBox[{"i", " ", "|->", " ", 
           RowBox[{"i", " ", "-", " ", "1"}]}]}], "]"}]}], "]"}], " ", "===", 
      " ", 
      RowBox[{"FindInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCone", "[", 
         RowBox[{"axis", ",", " ", "1"}], "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b79d2877-9ab3-4b6d-ae1e-e906d29782a5"],

