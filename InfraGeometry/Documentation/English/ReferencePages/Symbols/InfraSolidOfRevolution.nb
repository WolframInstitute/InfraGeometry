Cell[CellGroupData[{
Cell["InfraSolidOfRevolution", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"22c0666b-6e1c-45f5-85bc-77d296633924"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSolidOfRevolution"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSolidOfRevolution", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["profile", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11d7aba1-2679-4224-bdbe-507fd4c0b40c"],
 "\[LineSeparator]",
 "is the solid about ",
 StyleBox["axis", "TI"],
 " whose radius along the axis is ",
 StyleBox["profile", "TI"],
 ": the vertices within the radius of the axis vertex they project to, with \
flat ends. It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0cc3b738-709c-4e1c-982a-a6a046b0b565"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dcd51b1a-96be-4883-890c-c963ee772985"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ed88b577-a5bd-43c0-9a0c-ef6c0eaa9ba2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSolidOfRevolution"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSolidOfRevolution", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["profile", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29153a06-c7c1-488a-937b-7f024a07c370"],
 "\[LineSeparator]",
 "is the rounded solid, the union of the balls of radius ",
 StyleBox["r_i", "TI"],
 " about the axis vertices."
}], "Usage",ExpressionUUID->"9ec08b48-2fd5-4373-9ca7-b61bf86d3214"],

Cell[TextData[{
 "Definition: the solid of revolution of the profile ",
 StyleBox["r_1, \[Ellipsis], r_m", "TI"],
 " about the axis ",
 StyleBox["a_1, \[Ellipsis], a_m", "TI"],
 " is the sliced tube ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["profile", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Sliced\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df7ade99-b6b4-43aa-beaa-c60697601d13"],
 ". Slice ",
 StyleBox["i", "TI"],
 " is the set of vertices whose nearest axis vertex is ",
 StyleBox["a_i", "TI"],
 ", a tie lying in every nearest slice, and ",
 StyleBox["v", "TI"],
 " is in the solid when ",
 StyleBox["d(a_i, v) \[LessEqual] r_i", "TI"],
 " for its slice. The profile is read at the discrete foot of the \
perpendicular, so a jump of the profile is a sharp step."
}], "Notes",ExpressionUUID->"fd9224cb-a337-4fdd-b724-096a34767938"],

Cell[TextData[{
 StyleBox["profile", "TI"],
 " is a list of radii or bands, one per axis vertex, or a function of the \
position ",
 StyleBox["i", "TI"],
 "; a band ",
 StyleBox["{s, t}", "TI"],
 " keeps the vertices at distance between ",
 StyleBox["s", "TI"],
 " and ",
 StyleBox["t", "TI"],
 ", and the band ",
 StyleBox["{r, r}", "TI"],
 " is the surface. A pair of numbers is a band constant along the axis."
}], "Notes",ExpressionUUID->"0ea5874e-6433-4e46-bac7-d5ab7998ac79"],

Cell["\<\
The axis is a walk: a vertex, a vertex list, or a path or cycle graph. It is \
prolonged straight on past both ends, and the vertices nearer a prolongation \
than the axis are cut, so the ends are flat. A closed axis has no ends.\
\>", "Notes",ExpressionUUID->"8af93eb7-320c-4b26-b39b-c3056298bf93"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCylinder"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d503f891-5894-4629-849d-fd00b65ccad5"],
 " is the constant profile and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCone"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCone", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c63951c8-a692-4c7f-86aa-56d0e7aa3117"],
 " the linear one, ",
 StyleBox["r_i = slope (i \[Minus] 1)", "TI"],
 ". ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d025da7-c303-48fa-be53-02854e724df6"],
 " drops the slicing."
}], "Notes",ExpressionUUID->"2836ed56-794e-4c34-a511-5926a2d84f0f"],

Cell[TextData[{
 "The head computes nothing. A solid has one member, the vertex set. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "25621ac9-09eb-46fe-9b60-30f52cfbaba8"],
 " reads ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98cbea5e-c025-4109-9b3a-1f4bdccd4c57"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5077e5c-ad32-4621-a5d1-17484ca8249b"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d83e34e4-94c9-4cc6-8c32-a39f34c0c7ab"],
 ", ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd6af479-5548-4306-800d-2502e3eb6ce2"],
 " and ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5fb049b-fd47-4d34-8952-e46915be96c5"],
 ", and the two measures."
}], "Notes",ExpressionUUID->"c39ea4ab-508f-4132-a2bb-97292a668a3c"]
}, Open  ]],

