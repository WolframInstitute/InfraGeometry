   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cc1b7e45-c51c-4bd5-9c74-c280529fa8a9"],
 " the linear profile ",
 StyleBox["r\:1d62 = m (i \[Minus] 1)", "TI"],
 "."
}], "Notes",ExpressionUUID->"72136e20-ea28-4720-a136-73a8b43518b4"],

Cell[TextData[{
