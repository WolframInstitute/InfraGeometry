Cell["\<\
The constant profile is the cylinder, and the linear profile the cone.\
\>", "ExampleText",ExpressionUUID->"223fedf2-2efe-4907-88fd-c22e191e9b99"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"11", ",", " ", "11"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"55", " ", "+", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"2", ",", " ", "8"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"RandomInfraSolidOfRevolution", "[", " ", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraSolidOfRevolution", "[", 
         RowBox[{"axis", ",", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"1", ",", " ", "7"}], "]"}]}], "]"}]}], " ", "]"}], " ", "===",
       " ", 
      RowBox[{"RandomInfraCylinder", "[", " ", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCylinder", "[", 
         RowBox[{"axis", ",", " ", "1"}], "]"}]}], " ", "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"RandomInfraSolidOfRevolution", "[", " ", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraSolidOfRevolution", "[", 
         RowBox[{"axis", ",", " ", 
          RowBox[{"i", " ", "|->", " ", 
           RowBox[{"i", " ", "-", " ", "1"}]}]}], "]"}]}], " ", "]"}], " ", "===",
       " ", 
      RowBox[{"RandomInfraCone", "[", " ", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCone", "[", 
         RowBox[{"axis", ",", " ", "1"}], "]"}]}], " ", "]"}]}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4e91792d-9977-45fd-8f1e-b332d9ecc6d6"],

