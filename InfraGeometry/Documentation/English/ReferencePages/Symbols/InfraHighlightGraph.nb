Cell[TextData[{
 "A scalar is the value at full strength. A pair is an envelope, interpolated \
by strength. An explicit ",
 Cell[BoxData["Opacity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "398632ea-abe1-4185-b5a6-f7501e5847a1"],
 ", thickness or point size in an object's style turns that object's range \
off. ",
 Cell[BoxData["VertexSize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49edf788-ff1e-4693-8d2a-4b90dcd0906f"],
 " is in graph units."
}], "Notes",ExpressionUUID->"68f37f61-f3b7-446b-a81b-1ead513558f7"]
