Cell[CellGroupData[{
Cell["InfraHighlightGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0888545f-7b24-4239-ae56-7e21c319b788"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHighlightGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHighlightGraph",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["obj1", "TI"], ",", " ", 
      StyleBox["obj2", "TI"], ",", " ", "..."}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2372f796-3e2c-41d5-a83a-59373c49ca93"],
 "\[LineSeparator]",
 "draws the sum of the objects' densities on ",
 StyleBox["g", "TI"],
 ", the ",
 StyleBox["i", "TI"],
 "-th object in the ",
 StyleBox["i", "TI"],
 "-th palette color.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"784b297e-0a41-40c8-bf6b-edc4fce31703"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHighlightGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHighlightGraph",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19934b71-109a-4403-96ee-e1abc4413fe6"],
 "\[LineSeparator]",
 "draws a single object."
}], "Usage",ExpressionUUID->"78eb24e3-a864-4314-aaaf-a5ed9f61db9f"],

Cell[TextData[{
 "This is the only rendering primitive in the paclet. Every viewer and every \
figure calls it. The name follows ",
 Cell[BoxData["HighlightGraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d97336ed-ebf4-4d7e-ae0e-e28de79a3dbf"],
 "."
}], "Notes",ExpressionUUID->"c2cefb0a-a2de-483c-a0b9-f1e1daf75ba2"],

Cell["Every object becomes a vertex density and an edge density:", "Notes",ExpressionUUID->"c566e913-7217-4560-885b-9a68cef7b33b"],

Cell[TextData[{
 "a vertex, or a density ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", "m"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6aedbd7-f93c-4f5a-b185-30041b36e6d7"],
 ": its own mass, no edges;"
}], "Notes",ExpressionUUID->"bef3d33c-c6a1-40e4-97c2-3b680eee30e5"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraWalk", "[", 
   RowBox[{"{", 
    RowBox[{"p1", ",", " ", "...", ",", " ", "pk"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d12c33e-2996-45df-84ba-d797927ce4f2"],
 ": visit counts and the traversal counts of its steps;"
}], "Notes",ExpressionUUID->"b9b68574-5370-40d5-b6c0-880150605fde"],

Cell[TextData[{
 "a Euclidean head \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c9019650-52be-4c14-807a-9db600e56891"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bf446472-916e-43de-bcf7-9c7d92021751"],
 " and the rest: its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a70534-a531-4f89-91ae-7ec7306e7f5c"],
 " and ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b90d6756-08de-49f6-b66b-1921e03f2ffc"],
 " from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ad571b47-6924-4320-b8d1-c102b5fd1851"],
 ";"
}], "Notes",ExpressionUUID->"90ffb457-0e84-4f9f-8b94-cf3a75bb8a95"],

Cell["a walk graph, a cycle graph or a DAG: its occupation;", "Notes",ExpressionUUID->"587c76e0-68fc-4e15-91a1-15c43ea839b6"],

Cell["\<\
a leg chain: the walk through its legs, with its knots drawn on top;\
\>", "Notes",ExpressionUUID->"6e454818-c143-4564-a8ce-203cb7c6addd"],

Cell[TextData[{
 "a vertex list: a region, ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33211b4f-a746-4925-b8eb-20f55d708e10"],
 " on its vertices and on the edges of its induced subgraph;"
}], "Notes",ExpressionUUID->"570ac9f9-6084-4cb9-a762-734bfcc1cdf9"],

Cell["a list of these: the sum of its members.", "Notes",ExpressionUUID->"7807918f-fdb5-4862-8a0c-d49d375b0974"],

Cell[TextData[{
 "Each object is divided by its own heaviest mass, so every object reaches \
full strength somewhere. The objects are then summed. At each vertex and edge \
the strength is the sum, capped at ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dde7f2cc-b104-4885-83a6-553840a0e327"],
 ", and the color is the blend of the objects' colors weighted by their \
masses. Where objects overlap, the figure shows both."
}], "Notes",ExpressionUUID->"de99713f-4655-47a9-a504-dedf452ad449"],

Cell["\<\
A head draws the edges its members use, never the chords of its support. An \
object with one member is drawn as one joined stroke; a family is drawn edge \
by edge.\
\>", "Notes",ExpressionUUID->"5b750f0f-b7a4-4c21-88e6-233d375befa2"],

Cell[TextData[{
 "The list is read like a ",
 Cell[BoxData["Graphics"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6d0458a-e52e-4eec-829e-afc489003b1c"],
 " list. A ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e75c62c-d5af-4b37-8d58-952b60a45036"],
 " styles every object after it, until the next ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "beecfff6-48fe-4044-8581-60a4f2ee5a3b"],
 ". An entry ",
 Cell[BoxData[
  RowBox[{"obj", " ", "->", " ", "style"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cb02590-187e-4fb7-abcc-464bc0915b93"],
 " styles one object. A color in either replaces the palette color."
}], "Notes",ExpressionUUID->"b1249fcb-eacc-4453-8f1a-3e244ebc000e"],

