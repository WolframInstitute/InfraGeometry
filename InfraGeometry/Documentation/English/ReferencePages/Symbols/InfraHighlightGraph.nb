Cell[CellGroupData[{
Cell["InfraHighlightGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2092e45c-7d1f-4bd6-89fe-eed359a04003"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHighlightGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHighlightGraph",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["obj1", "TI"], ",", " ", 
      StyleBox["obj2", "TI"], ",", " ", "..."}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec217fc1-b76d-4d1b-9abc-4d3f02ec45b5"],
 "\[LineSeparator]",
 "draws the sum of the objects' densities on ",
 StyleBox["g", "TI"],
 ", the ",
 StyleBox["i", "TI"],
 "-th object in the ",
 StyleBox["i", "TI"],
 "-th palette color.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2311fcb8-03a5-4f3d-a8b6-4e3748fc945b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHighlightGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHighlightGraph",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "873c046b-3baa-4fc2-9b0c-fa83e5d7151b"],
 "\[LineSeparator]",
 "draws a single object."
}], "Usage",ExpressionUUID->"7504f5b0-9703-4637-9213-776b23f86174"],

Cell[TextData[{
 "This is the only rendering primitive in the paclet. Every viewer and every \
figure calls it. The name follows ",
 Cell[BoxData["HighlightGraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae456a19-f11a-4ab7-be88-e9aad74998bc"],
 "."
}], "Notes",ExpressionUUID->"cc0340a6-d001-4bad-8c04-e5d2637d4e48"],

Cell["Every object becomes a vertex density and an edge density:", "Notes",ExpressionUUID->"4527ad09-fa01-4fd6-bc70-ec2542cd76bc"],

Cell[TextData[{
 "a vertex, or a density ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", "m"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd5650d8-0a9f-42e6-85c4-535f12b4acc4"],
 ": its own mass, no edges;"
}], "Notes",ExpressionUUID->"e6309670-1bc5-4310-bf9e-07155d7f368a"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraWalk", "[", 
   RowBox[{"{", 
    RowBox[{"p1", ",", " ", "...", ",", " ", "pk"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67fbd76c-1959-433e-95df-c33ba0ed8b53"],
 ": visit counts and the traversal counts of its steps;"
}], "Notes",ExpressionUUID->"2d0ca356-987a-44b3-bfcf-6249cfa65dad"],

Cell[TextData[{
 "a Euclidean head \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c5a13735-5c26-4f64-ad43-8e1a0c6d58eb"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "47659bfa-f83e-48d6-978d-893d1499e3cc"],
 " and the rest: its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be2e0b78-b3dd-4770-afb2-d9502c705b0d"],
 " and ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c73262ad-cff2-43a9-8b3b-c4880220a773"],
 " from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "636a687d-7384-44de-9ef6-310aa84fb631"],
 ";"
}], "Notes",ExpressionUUID->"8bd84a3a-59b2-40de-abe9-5d0db8d9e152"],

Cell["a walk graph, a cycle graph or a DAG: its occupation;", "Notes",ExpressionUUID->"763c9ea5-3929-4ee9-82bc-b846b44dc93a"],

Cell["\<\
a leg chain: the walk through its legs, with its knots drawn on top;\
\>", "Notes",ExpressionUUID->"2fe44280-e1de-4fb2-ab3c-d36c41302b02"],

Cell[TextData[{
 "a vertex list: a region, ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "797865ad-1430-49dd-b9f5-c8f92afa6187"],
 " on its vertices and on the edges of its induced subgraph;"
}], "Notes",ExpressionUUID->"531442a3-24ce-4e01-a462-12777d2a360c"],

Cell["\<\
a list of vertex lists or of graphs, such as the members of a head or a \
bundle: the sum of its members.\
\>", "Notes",ExpressionUUID->"fd785218-6840-4161-b9ba-e78a58a05449"],

Cell[TextData[{
 "A list of heads or of walks is not one object; give them as separate \
entries, styled alike with a ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cbaf5083-600f-4c3d-b7a9-7c96d511aa0b"],
 "."
}], "Notes",ExpressionUUID->"826ce1ff-6b2f-4a65-8654-0c867e82f67b"],

Cell[TextData[{
 "Each object is divided by its own heaviest mass, so every object reaches \
full strength somewhere. The objects are then summed. At each vertex and edge \
the strength is the sum, capped at ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b30c8ea-3077-45da-9470-dfc1acbd184d"],
 ", and the color is the blend of the objects' colors weighted by their \
masses. Where objects overlap, the figure shows both."
}], "Notes",ExpressionUUID->"0af671be-ea3f-4e73-b086-d7d930e75aa3"],

Cell["\<\
A head draws the edges its members use, never the chords of its support. An \
object with one member is drawn as one joined stroke; a family is drawn edge \
by edge.\
\>", "Notes",ExpressionUUID->"39eaf477-3d52-4041-89d7-48b1debb4e05"],

Cell[TextData[{
 "The list is read like a ",
 Cell[BoxData["Graphics"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9678791f-355c-4357-9d75-b991dbdc9cb2"],
 " list. A ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a4f22e1-b5fb-440d-8148-43a4d051e3e4"],
 " styles every object after it, until the next ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78343e4c-480c-473a-b4a9-2f8737fd67e7"],
 ". An entry ",
 Cell[BoxData[
  RowBox[{"obj", " ", "->", " ", "style"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f01aaf6-722c-42ea-a8e8-24ca469d5157"],
 " styles one object. A color in either replaces the palette color."
}], "Notes",ExpressionUUID->"6037cf6b-17a0-4edc-be33-da01bdcd2b17"],

