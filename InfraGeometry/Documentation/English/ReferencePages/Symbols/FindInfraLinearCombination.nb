Cell[CellGroupData[{

Cell["ScaleMethod", "ExampleSubsection",ExpressionUUID->"466339dd-f63e-48c8-a5a8-c5e5b9c7c64a"],

Cell["\<\
For 3/2 of an axis vector the three methods that apply agree:\
\>", "ExampleText",ExpressionUUID->"7e6288b0-ba36-4051-bb1f-f08bf65bff8b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"FindInfraLinearCombination", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"3", "/", "2"}], ",", " ", "65"}], "}"}], "}"}], ",", " ", 
       RowBox[{"\"\<ScaleMethod\>\"", " ", "->", " ", "m"}]}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "Automatic", ",", " ", "\"\<Metric\>\"", ",", " ", "\"\<Line\>\""}], 
        "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"90d54500-aada-49b6-94f5-4d357811b9c2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"64", ",", "66", ",", "75"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"64", ",", "66", ",", "75"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"64", ",", "66", ",", "75"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"3059e0a2-eccb-405d-aed5-037d09b167f7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["SumMethod", "ExampleSubsection",ExpressionUUID->"aaae7fff-edd6-4fdd-9110-6f963b67650b"],

Cell["\<\
On the grid the parallels are many, so the parallel sum has many \
realisations. On a 5 \[Times] 5 grid, the sum of the two axis steps from the \
centre:\
\>", "ExampleText",ExpressionUUID->"47b04994-cae9-4890-a8b3-729908277daa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Length", " ", "@", " ", 
    RowBox[{"FindInfraLinearCombination", "[", 
     RowBox[{
      RowBox[{"GridGraph", "[", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", "13", ",", " ", 
      
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "14"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "18"}], "}"}]}], "}"}], ",", " ", 
      RowBox[{"\"\<SumMethod\>\"", " ", "->", " ", "m"}]}], "]"}]}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"m", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Metric\>\"", ",", " ", "\"\<Parallel\>\""}], "}"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ee8c2ead-c917-42e4-af1f-54dbe99fa639"],

