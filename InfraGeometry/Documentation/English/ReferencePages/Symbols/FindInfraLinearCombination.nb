Cell["\<\
The sum is not unique. On the grid two axis vectors of length 2 from the \
centre 45, to 65 and to 47, have two sums, one and two diagonal steps away:\
\>", "ExampleText",ExpressionUUID->"78334c18-b020-4364-a409-3819a3c3e6e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sum", " ", "=", " ", 
     RowBox[{"FindInfraLinearCombination", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "65"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "47"}], "}"}]}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraSegment", "[", 
        RowBox[{"45", ",", " ", "65"}], "]"}], ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"45", ",", " ", "47"}], "]"}], ",", " ", "sum", ",", " ", 
       "45"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"604151a8-b812-4686-b113-863535968fd1"],

