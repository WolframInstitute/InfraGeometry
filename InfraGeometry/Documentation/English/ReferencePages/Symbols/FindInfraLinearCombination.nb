Cell["\<\
A graph has no vector addition, so a combination is realised by the vertices \
that satisfy its metric description. There may be several, or none.\
\>", "Notes",ExpressionUUID->"54d4041d-24cd-4512-8aa7-6e3891dd508c"],

Cell[TextData[{
 "A multiple ",
 StyleBox["\[Lambda]u", "TI"],
 " is realised by the vertices ",
 StyleBox["w", "TI"],
 " with ",
 StyleBox["d(o, w) = |\[Lambda]| d(o, u)", "TI"],
 " in the direction of ",
 StyleBox["u", "TI"],
 ": for ",
 StyleBox["\[Lambda]", "TI"],
 " > 0 ",
 StyleBox["w", "TI"],
 " lies on a shortest path from ",
 StyleBox["o", "TI"],
 " to ",
 StyleBox["u", "TI"],
 " or ",
 StyleBox["u", "TI"],
 " on one from ",
 StyleBox["o", "TI"],
 " to ",
 StyleBox["w", "TI"],
 "; for ",
 StyleBox["\[Lambda]", "TI"],
 " < 0, ",
 StyleBox["o", "TI"],
 " lies on a shortest path from ",
 StyleBox["w", "TI"],
 " to ",
 StyleBox["u", "TI"],
 "."
}], "Notes",ExpressionUUID->"0571c1a6-0e7c-4eec-b863-962d7dc2f379"],

Cell[TextData[{
 "A sum ",
 StyleBox["u + v", "TI"],
 " is realised by the vertices ",
 StyleBox["w", "TI"],
 " \[NotEqual] ",
 StyleBox["o", "TI"],
 " with ",
 StyleBox["d(u, w) = d(o, v)", "TI"],
 " and ",
 StyleBox["d(v, w) = d(o, u)", "TI"],
 ": the fourth corner of a parallelogram with opposite sides of equal \
length."
}], "Notes",ExpressionUUID->"205ba231-dfd5-43d6-a966-232c5285ff53"],

Cell["The terms are scaled, then summed from left to right.", "Notes",ExpressionUUID->"3017c455-48f1-406f-8378-5f40f05b90d9"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49d08325-3b8d-482e-a6cf-af047e3d9f27"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d149a06-7f66-4967-b4e6-68fc41def18c"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "89c93aeb-508e-4d8c-801d-baeaeb3d11ae"],
 ", the default. Fewer than ",
 StyleBox["n", "TI"],
 " realisations give ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "89991a8d-0b2e-4ef3-86ba-419ab344f29c"],
 "."
}], "Notes",ExpressionUUID->"babe3ac1-5fc9-46aa-9da8-7d6f97b34b67"],

