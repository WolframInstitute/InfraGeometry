Cell[TextData[{
 "Every realisation of ",
 StyleBox["u + v", "TI"],
 " closes a parallelogram: it lies at distance ",
 StyleBox["d(o, v)", "TI"],
 " from ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["d(o, u)", "TI"],
 " from ",
 StyleBox["v", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"9cb53fbf-82e0-4d12-a166-07c483d11512"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"o", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"u", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"o", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"o", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "3"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", "u", ",", " ", "w"}], "]"}], ",", " ", 
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", "v", ",", " ", "w"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"w", ",", " ", 
       RowBox[{"FindInfraLinearCombination", "[", 
        RowBox[{"g", ",", " ", "o", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "u"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "v"}], "}"}]}], "}"}]}], "]"}]}], "}"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"718179ed-6347-4c8d-992a-58fedb00097c"],

