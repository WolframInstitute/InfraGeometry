Cell[TextData[{
 "Twice a diagonal vector of the grid, and its negative. Each has three \
realisations, the vertices at distance 4 beyond ",
 StyleBox["u", "TI"],
 " and at distance 2 behind ",
 StyleBox["o", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"15c055c5-bd56-464b-ba40-a985c9bcede1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"double", " ", "=", " ", 
     RowBox[{"FindInfraLinearCombination", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "56"}], "}"}], "}"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"negative", " ", "=", " ", 
     RowBox[{"FindInfraLinearCombination", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "56"}], "}"}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "double", ",", " ", "negative", ",", " ", "56", ",", " ", "45"}], "}"}],
      ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"9246a493-1356-470d-9154-5f4e1754af33"],

