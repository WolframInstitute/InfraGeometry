Notebook[{

Cell[CellGroupData[{
Cell["FindInfraLinearCombination", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell["LLM generated.", "Notes",ExpressionUUID->"cba77c0d-762c-41fd-9fe3-dbf3516bb338"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3c773730-3c6a-49ad-bd49-5bb6bc6eab4b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraLinearCombination"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraLinearCombination", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["o", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox["lambda1", "TI"], ",", " ", 
        StyleBox["u1", "TI"]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["lambda2", "TI"], ",", " ", 
        StyleBox["u2", "TI"]}], "}"}], ",", " ", "..."}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88ec6fe1-6a68-42d9-a2d0-8ad1f9fb0583"],
 "\[LineSeparator]",
 "returns the vertex list {v1, \[Ellipsis]}, the multi-valued vertex \
realisation of sum_i lambda_i u_i with base point o, computed as \
scaled-then-pairwise-summed left-to-right.",
 "\n"
}], "Usage",ExpressionUUID->"4d0954c5-4ac6-40a5-81f9-4b7b4700da74"],

Cell["\<\
Options: \"ScaleMethod\" (Automatic (default), \"Metric\", \"Line\", \
\"Midpoint\"); \"SumMethod\" (\"Metric\" (default), \"Parallel\").\
\>", "Notes",ExpressionUUID->"0e490cbf-14e5-4dd9-881e-682363047dee"],

Cell["\<\
The count argument n / UpTo[n] / All (default) picks realisations, exact n \
failing with $Failed.\
\>", "Notes",ExpressionUUID->"437b96e0-8b1b-4397-9847-e44550f1a9a3"]
}, Open  ]],

