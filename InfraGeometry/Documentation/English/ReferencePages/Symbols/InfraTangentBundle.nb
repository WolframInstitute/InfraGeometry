Cell["\<\
On the grid, a triangle-free graph, a fiber of rays has no edges.\
\>", "ExampleText",ExpressionUUID->"7a03baa5-64b0-4932-ac60-efbb6b35915b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridTangentBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraFiber", "[", 
      RowBox[{"fib", ",", " ", "6"}], "]"}], ",", " ", 
     RowBox[{"EdgeCount", " ", "@", " ", 
      RowBox[{"InfraFiber", "[", 
       RowBox[{"fib", ",", " ", "6"}], "]"}]}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"82c61b48-50ed-4275-bafb-835481881fdc"],

