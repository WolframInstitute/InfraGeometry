    "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", 
       " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
