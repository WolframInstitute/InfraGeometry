Cell["\<\
On the grid, a triangle-free graph, a fiber of rays has no edges.\
\>", "ExampleText",ExpressionUUID->"1f678a5a-76e2-466e-ba8f-91d5eed691a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridTangentBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraFiber", "[", 
      RowBox[{"fib", ",", " ", "6"}], "]"}], ",", " ", 
     RowBox[{"EdgeCount", " ", "@", " ", 
      RowBox[{"InfraFiber", "[", 
       RowBox[{"fib", ",", " ", "6"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9e66042f-e49c-4efc-ba96-eb514e734001"],

