Notebook[{

Cell[CellGroupData[{
Cell["InfraTangentBundle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6fdb3537-d362-41b2-ad73-a4ae053418f7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTangentBundle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTangentBundle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4e4a139-4b9e-48ff-9118-a41ad030df1a"],
 "\[LineSeparator]",
 "is the tangent bundle of ",
 StyleBox["g", "TI"],
 " at scale ",
 StyleBox["r", "TI"],
 ": the total vertices are the rays of length ",
 StyleBox["r", "TI"],
 ", projected to their first vertex, two rays adjacent iff at every position \
their vertices are equal or adjacent.",
 "\n"
}], "Usage",ExpressionUUID->"b9a24f96-4a52-488a-8c2a-165c127d8f63"],

Cell["\<\
This is a particular Experimental construction in the Infra Fiber Bundles \
category. Its existing call forms remain available.\
\>", "Notes",ExpressionUUID->"3d177166-71cc-4472-828a-b464fdb2019e"],

Cell[TextData[{
 "A tangent vector at ",
 StyleBox["p", "TI"],
 " at scale ",
 StyleBox["r", "TI"],
 " is a ray of length ",
 StyleBox["r", "TI"],
 " from ",
 StyleBox["p", "TI"],
 ", as given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRays"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraRays", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "08ab7af9-05d1-4ef0-9673-3361fdf455db"],
 "."
}], "Notes",ExpressionUUID->"ba8021df-8cac-433d-a4fe-2dd65a8b33d6"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTangentBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTangentBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "722db30a-c200-4a03-ae6c-4ff8400b2034"],
 " is inert. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTotalSpace"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTotalSpace", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dde03078-9347-489f-8f94-18bc5adde7af"],
 " builds its total graph on every call; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFiberedGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e1787b1-fc7a-470a-b665-ad283c52b3c8"],
 " builds it once."
}], "Notes",ExpressionUUID->"5067829e-14d7-4ed8-a02c-d7f60be53846"],

Cell[TextData[{
 "The scale ",
 StyleBox["r", "TI"],
 " must be a positive integer."
}], "Notes",ExpressionUUID->"a5a24421-f5d5-4fc9-b867-1f93ad13e15e"],

Cell["\<\
At scale 1 a ray is an edge, and the tangent bundle has the same total graph \
as the displacement bundle at scale 1.\
\>", "Notes",ExpressionUUID->"f015a941-370c-44be-87ce-be197abfa4e0"]
}, Open  ]],

