Cell["\<\
The total graph over a grid: each fiber is a small cluster of rays around its \
base vertex.\
\>", "ExampleText",ExpressionUUID->"12b1a8bf-1706-4445-823c-bea1b62f8c8e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", " ", "@", " ", 
      RowBox[{"InfraTangentBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"VertexCount", " ", "@", " ", "total"}], ",", " ", 
     RowBox[{"EdgeCount", " ", "@", " ", "total"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"ca460515-8ef8-49cd-ae40-e8d362eec808"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"104", ",", "520"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f9c9103b-f1c0-4665-b0f9-dc43dd93579f"]
}, Open  ]]
}, Open  ]],

