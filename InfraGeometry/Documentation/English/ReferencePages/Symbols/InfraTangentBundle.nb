Notebook[{

Cell[CellGroupData[{
Cell["InfraTangentBundle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9f0f3fc6-58d8-4a0d-9a48-784bed004fd3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTangentBundle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTangentBundle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04c8dc7d-d0a1-495b-9b1d-10fe488ea1b2"],
 "\[LineSeparator]",
 "is the tangent bundle of ",
 StyleBox["g", "TI"],
 " at scale ",
 StyleBox["r", "TI"],
 ": its total vertices are the rays of length ",
 StyleBox["r", "TI"],
 ", each over its first vertex, and two rays are adjacent iff at every \
position their vertices are equal or adjacent.",
 "\n"
}], "Usage",ExpressionUUID->"6b1e4269-d0d9-4607-9f04-bb12a8ceb849"],

Cell[TextData[{
 "A tangent vector at ",
 StyleBox["p", "TI"],
 " at scale ",
 StyleBox["r", "TI"],
 " is a ray {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["u\:2081", "TI"],
 ", \[Ellipsis], ",
 StyleBox["u\:1d63", "TI"],
 "} with ",
 StyleBox["d(p, u\:1d62) = i", "TI"],
 ", as given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRays"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraRays", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0956e537-574a-4227-8331-5e30b82f9824"],
 ". The fiber over ",
 StyleBox["p", "TI"],
 " is the set of these rays."
}], "Notes",ExpressionUUID->"ac681550-5d23-4db1-ba49-3c19a24e6391"],

Cell[TextData[{
 "Two rays ",
 StyleBox["x", "TI"],
 ", ",
 StyleBox["y", "TI"],
 " are adjacent iff ",
 StyleBox["x\:1d62 = y\:1d62", "TI"],
 " or ",
 StyleBox["x\:1d62 ~ y\:1d62", "TI"],
 " for every ",
 StyleBox["i", "TI"],
 ". This rule makes the truncation to a shorter scale a bundle morphism."
}], "Notes",ExpressionUUID->"8a3f3deb-fe5a-4453-8782-99f7ee69bc97"],

Cell["\<\
On a triangle-free graph such as the square grid, the fibers have no edges.\
\>", "Notes",ExpressionUUID->"1c8ba868-eb74-4395-b9ab-9f97a910a4cb"],

Cell[TextData[{
 "The construction is a fibration on the full grid ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GridGraph"]], "paclet:ref/GridGraph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0a03c30e-545e-4e8c-ad23-8fc64035a84b"],
 ", but not a fiber bundle: fiber sizes differ between the corners, the rim \
and the interior, and a ray has several neighbours over a base edge."
}], "Notes",ExpressionUUID->"e9455eac-76a1-424e-9183-1d961ca63adf"],

Cell[TextData[{
 "At scale 1 a ray is a directed edge, and the total graph is that of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDisplacementBundle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", "1"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20e2019f-139e-452b-9457-153aa9242df8"],
 "."
}], "Notes",ExpressionUUID->"8e6332ed-d823-4272-8b66-90392bedcdc3"],

Cell[TextData[{
 "The object is symbolic: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTotalSpace"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTotalSpace", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "43c9b514-a0e5-4ed8-8adc-b50f76942df7"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraProjection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraProjection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5c9fdbcb-ad78-4e74-a882-91653e6ebeef"],
 " and the predicates evaluate it, and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFiberedGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c50b757a-53b8-4414-9eeb-2d87d823a38c"],
 " builds its total graph once. The scale ",
 StyleBox["r", "TI"],
 " is a positive integer."
}], "Notes",ExpressionUUID->"aa86213c-64f3-4f45-9455-3f2a5c6869e5"]
}, Open  ]],

