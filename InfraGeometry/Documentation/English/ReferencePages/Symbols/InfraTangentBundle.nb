Cell[CellGroupData[{
Cell["InfraTangentBundle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"45db68e4-3c94-4fcc-8053-886377db8ea3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTangentBundle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTangentBundle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe0930f1-1048-4ee2-9f95-58b99567d054"],
 "\[LineSeparator]",
 "is the tangent bundle of ",
 StyleBox["g", "TI"],
 " at scale ",
 StyleBox["r", "TI"],
 ": the total vertices are the rays of length ",
 StyleBox["r", "TI"],
 ", projected to their first vertex, two rays adjacent iff at every position \
their vertices are equal or adjacent.",
 "\n"
}], "Usage",ExpressionUUID->"2f0b81d2-e5ca-4960-8117-683a106fc25c"],

Cell[TextData[{
 "A tangent vector at ",
 StyleBox["p", "TI"],
 " at scale ",
 StyleBox["r", "TI"],
 " is a ray of length ",
 StyleBox["r", "TI"],
 " from ",
 StyleBox["p", "TI"],
 ", as given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRays"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraRays", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b0cbaef7-99b8-467a-ba39-650f0ecf5c66"],
 "."
}], "Notes",ExpressionUUID->"d3ad30a8-06d4-489c-aa5a-3d9a4d03168b"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTangentBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTangentBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e928f95b-3581-455c-b98f-f88f0edad2ca"],
 " is inert. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTotalGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTotalGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9b576961-8f89-4258-9b2c-a4906f1112d9"],
 " builds its total graph on every call; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFibration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5566ddbc-5a93-440d-8f84-282dec80aabb"],
 " builds it once."
}], "Notes",ExpressionUUID->"2c96944a-0124-43d3-bcdd-2976c818cb96"],

Cell[TextData[{
 "The scale ",
 StyleBox["r", "TI"],
 " must be a positive integer."
}], "Notes",ExpressionUUID->"90b5f2ad-9c86-467e-a8e4-8f9213a27e5b"],

Cell["\<\
At scale 1 a ray is an edge, and the tangent bundle has the same total graph \
as the displacement bundle at scale 1.\
\>", "Notes",ExpressionUUID->"b3736279-ee06-4d72-8cb7-3631f82fcf12"]
}, Open  ]],

