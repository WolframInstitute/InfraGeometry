Cell[CellGroupData[{
Cell["InfraTangentBundle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0db1f005-8b37-49df-bdb1-4b65fc02b017"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTangentBundle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTangentBundle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5d6f1ff-d430-4005-90c7-818ae24b9acd"],
 "\[LineSeparator]",
 "is the tangent bundle of ",
 StyleBox["g", "TI"],
 " at scale ",
 StyleBox["r", "TI"],
 ": the total vertices are the rays of length ",
 StyleBox["r", "TI"],
 ", projected to their first vertex, two rays adjacent iff at every position \
their vertices are equal or adjacent.",
 "\n"
}], "Usage",ExpressionUUID->"9ebf1402-9ee8-41c4-9d6d-9fd3ff48f111"],

Cell[TextData[{
 "A tangent vector at ",
 StyleBox["p", "TI"],
 " at scale ",
 StyleBox["r", "TI"],
 " is a ray of length ",
 StyleBox["r", "TI"],
 " from ",
 StyleBox["p", "TI"],
 ", as given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRays"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraRays", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6d3517ff-5146-4e57-a568-62ccff012b9c"],
 "."
}], "Notes",ExpressionUUID->"7ad3a891-91b1-4e4f-ad87-b2e25e3fe692"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTangentBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTangentBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d92168d9-77da-4914-9aee-dbf522d7d9cb"],
 " is inert. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTotalGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTotalGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "93214246-8ff9-464f-ab43-e68eaafb5a97"],
 " builds its total graph on every call; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFibration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e84dcecc-47fa-43df-90ab-3ac6ae215917"],
 " builds it once."
}], "Notes",ExpressionUUID->"01669263-57f1-4271-bc68-3412575f6a67"],

Cell[TextData[{
 "The scale ",
 StyleBox["r", "TI"],
 " must be a positive integer."
}], "Notes",ExpressionUUID->"8002f8a6-ac3e-4e02-b04f-e3356412450c"],

Cell["\<\
At scale 1 a ray is an edge, and the tangent bundle has the same total graph \
as the displacement bundle at scale 1.\
\>", "Notes",ExpressionUUID->"74c28d3b-d349-42ec-9b4b-b6784b6ac921"]
}, Open  ]],

