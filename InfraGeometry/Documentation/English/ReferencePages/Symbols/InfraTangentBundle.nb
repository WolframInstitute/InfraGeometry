Cell["\<\
At scale 1 the tangent and displacement bundles have the same vertices and \
edges:\
\>", "ExampleText",ExpressionUUID->"dd7708c5-2037-4b2e-ab3c-ad07b67c6ad9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"t", " ", "=", " ", 
      RowBox[{"InfraTotalSpace", "[", 
       RowBox[{"InfraTangentBundle", "[", 
        RowBox[{"g", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", 
     RowBox[{"d", " ", "=", " ", 
      RowBox[{"InfraTotalSpace", "[", 
       RowBox[{"InfraDisplacementBundle", "[", 
        RowBox[{"g", ",", " ", "1"}], "]"}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"VertexList", "[", "t", "]"}]}], " ", "===", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"VertexList", "[", "d", "]"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"Sort", " ", "/@", " ", 
        RowBox[{"EdgeList", "[", "t", "]"}]}], "]"}], " ", "===", " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"Sort", " ", "/@", " ", 
        RowBox[{"EdgeList", "[", "d", "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0871446d-bc2a-4f7f-81fd-929c89741275"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7d1b49dc-7edb-4b43-bc14-5d4f5f59edce"]
}, Open  ]]
}, Open  ]],

