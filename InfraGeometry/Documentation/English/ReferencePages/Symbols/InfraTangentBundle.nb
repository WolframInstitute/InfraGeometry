Cell["The truncation to a shorter scale is a bundle morphism.", "ExampleText",ExpressionUUID->"aaf8f478-b5cc-4a4c-914e-ec8cdb1fd68c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraBundleMorphismQ", "[", 
    RowBox[{
     RowBox[{"InfraTangentBundle", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"InfraTangentBundle", "[", 
      RowBox[{"g", ",", " ", "1"}], "]"}], ",", " ", 
     RowBox[{"ray", " ", "|->", " ", 
      RowBox[{"Take", "[", 
       RowBox[{"ray", ",", " ", "2"}], "]"}]}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7b445223-87e9-4831-a26a-66567ef5f688"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"8fc9fb23-4d81-4a87-a832-96806f8d1b03"]
