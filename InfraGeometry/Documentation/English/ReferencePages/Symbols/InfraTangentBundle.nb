Cell["\<\
The fiber sizes at scale 2, drawn as the size of the vertex, on the square \
grid and on the square mesh. Away from the rim of the grid every fiber has 12 \
rays:\
\>", "ExampleText",ExpressionUUID->"0bfca36d-4201-41dd-a864-18d61825e37f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"Counts", " ", "@", " ", 
          RowBox[{"Values", " ", "@", " ", 
           RowBox[{"InfraProjection", "[", 
            RowBox[{"InfraTangentBundle", "[", 
             RowBox[{"g", ",", " ", "2"}], "]"}], "]"}]}]}], "}"}]}], "]"}]}],
      "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"92378430-b2a3-41a5-a733-9f53356badc0"],

