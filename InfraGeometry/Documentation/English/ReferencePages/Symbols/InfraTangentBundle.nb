Cell["\<\
On the 4 \[Times] 4 grid the tangent bundle is a fibration, but its fibers \
differ in size, so it is not a fiber bundle:\
\>", "ExampleText",ExpressionUUID->"59edd250-2d9f-48d8-b9ab-090e9fe00a25"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraTangentBundle", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", "2"}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraEqualFiberSizesQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraFiberBundleQ", "[", "fib", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"eff4b2d0-fd52-4a47-8b02-7c97f1956ac5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9c213eae-395e-407f-902e-ad5303f6d3a0"]
}, Open  ]],

Cell["\<\
The ray {6, 7, 8} has several neighbours over the base neighbours 2, 7 and 10 \
of 6:\
\>", "ExampleText",ExpressionUUID->"98bd8b0f-636b-473f-8702-97e437b5f530"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"InfraEdgeLiftMultiplicity", "[", 
   RowBox[{"InfraFiberedGraph", " ", "@", " ", 
    RowBox[{"InfraTangentBundle", "[", 
     RowBox[{
      RowBox[{"GridGraph", "[", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", "2"}], "]"}]}], 
   "]"}], "[", 
  RowBox[{"{", 
   RowBox[{"6", ",", " ", "7", ",", " ", "8"}], "}"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"761072ed-b892-4628-a378-364111973a49"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"2", "\[Rule]", "3"}], ",", 
   RowBox[{"5", "\[Rule]", "1"}], ",", 
   RowBox[{"7", "\[Rule]", "4"}], ",", 
   RowBox[{"10", "\[Rule]", "3"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"0906b588-ca3a-42a3-baf0-58e7b3aa0d54"]
}, Open  ]],

Cell["\<\
A fiber has no edges on the grid. On the triangular tiling two rays at the \
centre can be adjacent:\
\>", "ExampleText",ExpressionUUID->"6d333f09-bef3-40d6-95df-7a254a54e43c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
