Cell["\<\
The total graph over a grid: each fiber is a small cluster of rays around its \
base vertex.\
\>", "ExampleText",ExpressionUUID->"4ee95360-b1d0-4dd7-9bc2-e054a5ccae65"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraTotalGraph", " ", "@", " ", 
    RowBox[{"InfraTangentBundle", "[", 
     RowBox[{"g", ",", " ", "2"}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3f06edf6-32ef-41a4-8184-712262341966"],

