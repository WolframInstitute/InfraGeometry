Cell["\<\
There are 15, the exchanges at any nonempty set of the four corners, all of \
magnitude 2. The one at all four corners:\
\>", "ExampleText",ExpressionUUID->"a65273ff-d31f-442d-9e6d-e11889947aff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"all", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", "[", 
      RowBox[{"g", ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"MaximalBy", "[", 
       RowBox[{"all", ",", " ", 
        RowBox[{
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"Keys", "[", "#", "]"}], ",", " ", 
           RowBox[{"v_", " ", "/;", " ", 
            RowBox[{
             RowBox[{"#", "[", "v", "]"}], " ", "=!=", " ", 
             RowBox[{"{", "v", "}"}]}]}]}], "]"}], " ", "&"}]}], "]"}]}], ",",
      "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "all", "]"}], ",", " ", 
        RowBox[{"Union", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"DisplacementMagnitude", "[", 
            RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
          "all"}], "]"}]}], "}"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"49ac820e-1cd4-44fa-ad48-1598ef00df78"],

