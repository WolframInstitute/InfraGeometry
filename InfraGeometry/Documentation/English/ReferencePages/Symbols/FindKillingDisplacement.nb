Cell[TextData[{
 "On a graph without symmetry, such as the discretized plane, there is no \
Killing displacement. The form with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "05e487d6-3bb0-4409-91e3-03a02e6dadc8"],
 " gives the empty list, and the one-argument form stays unevaluated, with no \
message."
}], "ExampleText",ExpressionUUID->"8f9b2b5d-fe15-41b7-9482-43f54eea51b1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"g", ",", " ", 
     RowBox[{"FindKillingDisplacement", "[", 
      RowBox[{"g", ",", " ", "All"}], "]"}], ",", " ", 
     RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"49f55ab3-388d-4fef-b2b8-0121124958bd"],

