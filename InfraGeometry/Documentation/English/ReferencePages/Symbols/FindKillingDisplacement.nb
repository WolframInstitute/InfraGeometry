Cell[CellGroupData[{
Cell["FindKillingDisplacement", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0aba4154-1475-4798-ae5b-dee20aead26a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindKillingDisplacement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindKillingDisplacement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb1981cb-e365-4034-b9bc-09ef4762c82d"],
 "\[LineSeparator]",
 "finds an automorphism of ",
 StyleBox["g", "TI"],
 " other than the identity of least magnitude, as a displacement.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"33a2c0b1-1f74-46a2-b12b-664ea5180244"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindKillingDisplacement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindKillingDisplacement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33199b0b-e4dd-4736-ad87-44b5ee125659"],
 "\[LineSeparator]",
 "gives every one of least magnitude."
}], "Usage",ExpressionUUID->"19030d80-db2d-4045-b958-9c922a77c665"],

Cell[TextData[{
 "Definition: among the automorphisms ",
 StyleBox["\[Sigma] \[NotEqual] id", "TI"],
 " of ",
 StyleBox["g", "TI"],
 ", those with the least magnitude ",
 StyleBox["max_v d(v, \[Sigma](v))", "TI"],
 ", each as the displacement ",
 StyleBox["v", "TI"],
 " -> {",
 StyleBox["\[Sigma](v)", "TI"],
 "}. They are the discrete Killing displacements (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementIsomorphismQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementIsomorphismQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8bea958b-95fc-47e6-b0fd-112d6c2636a5"],
 ") that move the vertices least, and their magnitude is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KillingDisplacementMagnitude"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/KillingDisplacementMagnitude", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fecfe2dc-d92b-44b6-8319-f605019ba41c"],
 "."
}], "Notes",ExpressionUUID->"37163a4d-997a-41e4-b403-2177d5b8e1bc"],

Cell[TextData[{
 "Every automorphism is listed, from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphAutomorphismGroup"]], "paclet:ref/GraphAutomorphismGroup"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f2d514e4-d622-4264-9dad-21f65be857cf"],
 ", so the group must be of moderate order."
}], "Notes",ExpressionUUID->"1219d2c7-4c9f-4fc2-9fa4-151f390b8d0b"],

Cell["\<\
On a cycle or a torus the least automorphisms are the translations by one \
step. On a finite patch of a tiling the only automorphisms are the symmetries \
of the patch, which move its rim far: by the diameter on the square and the \
hexagonal tilings.\
\>", "Notes",ExpressionUUID->"f34f9a00-f706-4067-99be-291aa8c0042c"]
}, Open  ]],

