Cell["\<\
A least automorphism is a Killing displacement: an automorphism and a \
1-continuous bijection.\
\>", "ExampleText",ExpressionUUID->"eacf8e61-3037-419b-98f8-5d9e57f2d7d1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"killing", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", "killing"}], "]"}], ",", " ", 
     RowBox[{"DisplacementIsomorphismQ", "[", 
      RowBox[{"g", ",", " ", "killing"}], "]"}], ",", " ", 
     RowBox[{"DisplacementBijectionQ", "[", "killing", "]"}], ",", " ", 
     RowBox[{"ContinuousDisplacementQ", "[", 
      RowBox[{"g", ",", " ", "killing"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d22e1fa2-bed8-40b2-b2d2-30c28203a39e"],

