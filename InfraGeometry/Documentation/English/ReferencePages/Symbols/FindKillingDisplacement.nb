Cell["\<\
The least automorphisms of the 12-cycle are the two rotations by one step.\
\>", "ExampleText",ExpressionUUID->"ac0bfdf3-ba41-49bc-9144-0452f355be90"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rotations", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", "[", 
      RowBox[{"g", ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", "rotations"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"DisplacementMagnitude", "[", 
        RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
      "rotations"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"47356600-e99d-48d8-8cea-bba4a4851e04"],

