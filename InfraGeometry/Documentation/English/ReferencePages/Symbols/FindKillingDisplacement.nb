Cell["\<\
The square torus has no rim. Its least automorphisms are the four \
translations by one step, drawn at a planar layout of the torus:\
\>", "ExampleText",ExpressionUUID->"07e80be6-4d19-4174-86af-7dd340331d10"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"translations", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", "[", 
      RowBox[{"g", ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"First", " ", "@", " ", "translations"}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "translations", "]"}], ",", " ", 
        RowBox[{"DisplacementMagnitude", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"First", " ", "@", " ", "translations"}]}], "]"}]}], 
       "}"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"eacc0dd7-28fa-4f9a-9a19-df01d98510db"],

