Cell["\<\
The square torus has no rim. Its least automorphisms are the four \
translations by one step, drawn at a planar layout of the torus.\
\>", "ExampleText",ExpressionUUID->"c11b4be4-ec6c-429c-95cd-b74a34f2b244"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"translations", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", "[", 
      RowBox[{"g", ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"First", "[", "translations", "]"}]}], "]"}], ",", " ", 
     RowBox[{"Length", "[", "translations", "]"}], ",", " ", 
     RowBox[{"DisplacementMagnitude", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"First", "[", "translations", "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d4e2a78f-9408-4307-b29f-19eab80d6657"],

