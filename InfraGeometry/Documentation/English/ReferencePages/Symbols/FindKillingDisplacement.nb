Notebook[{

Cell[CellGroupData[{
Cell["FindKillingDisplacement", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"04553711-8486-4fd2-8599-474634b71304"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindKillingDisplacement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindKillingDisplacement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a4f2699-3fde-425c-8bf2-2d9b22598d10"],
 "\[LineSeparator]",
 "gives an automorphism of ",
 StyleBox["g", "TI"],
 " other than the identity of least magnitude, as a displacement.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5f8a89fa-c698-4884-8c02-92b65971369e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindKillingDisplacement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindKillingDisplacement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "558e1310-a9d8-494e-bee1-00be8344c5ae"],
 "\[LineSeparator]",
 "gives all of least magnitude."
}], "Usage",ExpressionUUID->"26cfaf27-e72f-48e1-8a07-722d7425b828"],

Cell[TextData[{
 "The result is an automorphism ",
 StyleBox["\[Sigma] \[NotEqual] id", "TI"],
 " of ",
 StyleBox["g", "TI"],
 " minimizing ",
 StyleBox["max {d(v, \[Sigma](v))}", "TI"],
 ", as the displacement ",
 StyleBox["v", "TI"],
 " -> {",
 StyleBox["\[Sigma](v)", "TI"],
 "}. It is a discrete Killing displacement (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementIsomorphismQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementIsomorphismQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ee08af8d-1377-4aac-9ad9-a3160c90dbfb"],
 ") that moves the vertices least, and its magnitude is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KillingDisplacementMagnitude"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/KillingDisplacementMagnitude", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "da85a340-f56e-4f8a-afd3-3c91d8f088fa"],
 "."
}], "Notes",ExpressionUUID->"659c4da0-cbb7-4309-bdc1-f08597200aab"],

Cell["\<\
In the plane the translations by a small vector are isometries that move \
every point a little. On a torus the translations by one step play this part, \
of magnitude 1. A graph with a rim has fewer symmetries; on the square grid \
the least ones exchange pendant vertices at the corners.\
\>", "Notes",ExpressionUUID->"a585c006-a671-49ed-b84f-4aaa4398977d"],

Cell[TextData[{
 "A graph without symmetry has none: the form with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2450a2fa-460d-4a5e-b964-11eaaa3b4213"],
 " gives {}, and the form without stays unevaluated."
}], "Notes",ExpressionUUID->"da9b9e33-9dd2-4ad9-ba6b-dec0913964ff"],

Cell["\<\
The whole automorphism group is listed, so its order must be moderate.\
\>", "Notes",ExpressionUUID->"c712cc75-2910-460b-af7c-1f0da68e1d31"]
}, Open  ]],

