Cell["\<\
The least symmetry of the square grid exchanges two pendant vertices at a \
corner:\
\>", "ExampleText",ExpressionUUID->"dc9455ce-5b71-45e4-9080-5113ad6a4f4f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"killing", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", "killing", ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"DisplacementMagnitude", "[", 
       RowBox[{"g", ",", " ", "killing"}], "]"}]}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"013a31c0-b276-4b04-8743-79f1521a0669"],

