Cell["\<\
The least symmetry of the square, the triangular and the hexagonal tilings, \
and its magnitude. On the triangular tiling it is a rotation by a sixth of a \
turn; on the square tiling every symmetry moves a corner of the patch to \
another.\
\>", "ExampleText",ExpressionUUID->"6383da24-fa3a-4d14-b1bf-3d58a8d12a31"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graphs", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"#", ",", " ", "\"\<Small\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}],
        " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"killings", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", " ", "/@", " ", "graphs"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"MapThread", "[", 
       RowBox[{"DisplacementPlot", ",", " ", 
        RowBox[{"{", 
         RowBox[{"graphs", ",", " ", "killings"}], "}"}]}], "]"}], "]"}], ",",
      " ", 
     RowBox[{"MapThread", "[", 
      RowBox[{"DisplacementMagnitude", ",", " ", 
       RowBox[{"{", 
        RowBox[{"graphs", ",", " ", "killings"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"57612386-df91-4123-ae98-9fb5b48afa15"],

