Cell[TextData[{
 "The square mesh has no symmetry. The form with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2d850968-4a33-4833-86df-87409b5c0b2f"],
 " gives the empty list, and the form without stays unevaluated:"
}], "ExampleText",ExpressionUUID->"668984f5-3d60-4d43-a3ce-293014c0e29f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FindKillingDisplacement", "[", 
      RowBox[{"g", ",", " ", "All"}], "]"}], ",", " ", 
     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f156f02b-31bc-4ed5-94d0-7696f6e7748f"],

