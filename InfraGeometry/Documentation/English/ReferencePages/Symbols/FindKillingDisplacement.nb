Cell["A least automorphism is a 1-continuous bijection:", "ExampleText",ExpressionUUID->"6329c4b1-5117-4c83-981b-2d5f4a52b841"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"killing", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementIsomorphismQ", "[", 
      RowBox[{"g", ",", " ", "killing"}], "]"}], ",", " ", 
     RowBox[{"DisplacementBijectionQ", "[", "killing", "]"}], ",", " ", 
     RowBox[{"ContinuousDisplacementQ", "[", 
      RowBox[{"g", ",", " ", "killing"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5ecd3c14-c0a1-400d-b60f-32754aead542"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"8cc3b275-511a-41f4-9dae-5d82e270bca1"]
}, Open  ]]
}, Open  ]],

