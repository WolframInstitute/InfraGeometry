Notebook[{

Cell[CellGroupData[{
Cell["InfraIsomorphicFibersQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"98be6d4d-7b6e-48b2-97e8-31c74f5760a0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraIsomorphicFibersQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraIsomorphicFibersQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "145ac7f9-89d2-44b0-90f1-b1a0bb29528c"],
 "\[LineSeparator]",
 "tests whether the induced fiber graphs of ",
 StyleBox["fib", "TI"],
 " are mutually isomorphic.",
 "\n"
}], "Usage",ExpressionUUID->"1b82ffd9-38b0-4148-b71e-8ebe7cf88199"],

Cell["\<\
The comparison includes every fiber, including fibers over different \
connected base components.\
\>", "Notes",ExpressionUUID->"84db97c1-c01a-48f9-a103-816db023c885"],

Cell["\<\
Isomorphism is a property of the vertical fiber graphs. It imposes no lifting \
condition on transverse edges.\
\>", "Notes",ExpressionUUID->"59b6cef5-4933-40dc-99d1-6e5497e4eb20"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberBundleQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberBundleQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ef7fc569-80bf-44a2-b1a9-9c545815a1a0"],
 " also requires unique transverse matchings that preserve fiber adjacency."
}], "Notes",ExpressionUUID->"b4113c63-6c3d-44f9-9b6d-bbc0bc5abca0"],

Cell["The empty fibered graph satisfies the condition vacuously.", "Notes",ExpressionUUID->"2e23e7c7-462e-4eac-8791-ff569b4a843b"],

Cell["\<\
A nonempty list is tested by conjunction; an empty list gives False. \
Unsupported inputs remain unevaluated.\
\>", "Notes",ExpressionUUID->"5461b927-d6bb-45c6-b76a-af50b3896788"]
}, Open  ]],

