Cell["\<\
Isomorphic fibers with one transverse edge over each base edge do not form a \
fibration, nor a fiber bundle:\
\>", "ExampleText",ExpressionUUID->"37777846-8368-42cd-bfc4-e81682d1f75e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<IsomorphicFibers\>\"", "}"}]}], ",", "\n", "    ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "3", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", 
        RowBox[{"{", "1", "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraIsomorphicFibersQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraFiberBundleQ", "[", "fib", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"888d011b-eb6e-4939-88a2-07104fcbe5f5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0668518a-57ef-40da-a499-68c34dd8e249"]
}, Open  ]],

Cell["\<\
The tangent bundle of a cycle has isomorphic fibers, that of a grid does not:\
\
\>", "ExampleText",ExpressionUUID->"791b6e30-9fa5-471a-8bac-feb94d11de0b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"InfraIsomorphicFibersQ", "[", 
    RowBox[{"InfraTangentBundle", "[", 
     RowBox[{"#", ",", " ", "2"}], "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
    RowBox[{"GridGraph", "[", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"faa9b329-4a11-4a86-8cc0-644df452e30c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"81a33667-dee9-4537-8977-3b4a7db617a6"]
}, Open  ]]
}, Open  ]],

