  FontSize->0.9 Inherited,ExpressionUUID->
  "04f89be4-59d6-4250-aa72-073c0779930e"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "624c4283-0f28-4980-99c4-10fa8781d374"],
 " if the fibers of ",
 StyleBox["fib", "TI"],
 " are mutually isomorphic graphs, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f6e7f341-e461-4d83-9966-c46a27d97364"],
 " otherwise.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"116793c4-c63e-48ec-a576-b614aaa552db"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraIsomorphicFibersQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraIsomorphicFibersQ", 
