Cell["\<\
All fibers share a graph, while one transverse edge per base edge need not \
cover the whole fiber.\
\>", "ExampleText",ExpressionUUID->"fbe94e9b-46d5-4af2-8b5d-67b56ad2e801"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}], ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", " ", "\"\<IsomorphicFibers\>\"", " ", "}"}]}], ",", "\n",
        "    ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "4", " ", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "3", " ", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "1", " ", "}"}]}]}], " ", "]"}]}], " ", "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", " ", "fib", " ", "]"}]}], " ", 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f7d81fe4-de93-4d7c-8980-90dffe54de98"],

Cell[BoxData[
 RowBox[{"InfraFiberedGraphHighlight", "[", 
  RowBox[{"RandomInfraFiberedGraph", "[", 
   RowBox[{
    GraphicsBox[
     NamespaceBox["NetworkGraphics",
      DynamicModuleBox[{Typeset`graph = HoldComplete[
        Graph[{1, 2, 3, 4}, {Null, 
          SparseArray[
          Automatic, {4, 4}, 0, {
           1, {{0, 2, 4, 6, 8}, {{2}, {4}, {1}, {3}, {2}, {4}, {1}, {3}}}, 
            Pattern}]}, {GraphLayout -> "CircularEmbedding"}]]}, 
       TagBox[
        GraphicsGroupBox[
         GraphicsComplexBox[{{-1., 
          1.0106430996148606`*^-15}, {-7.044813998280222*^-16, 1.}, {
          1., -1.133107779529596*^-15}, {6.049014748177263*^-16, -1.}}, {
           {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], Arrowheads[
            0.], ArrowBox[{{1, 2}, {1, 4}, {2, 3}, {3, 4}}, 
             0.02261146496815286]}, 
           {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
            DiskBox[1, 0.02261146496815286], DiskBox[2, 0.02261146496815286], 
            DiskBox[3, 0.02261146496815286], 
            DiskBox[4, 0.02261146496815286]}}]],
        MouseAppearanceTag["NetworkGraphics"]],
       AllowKernelInitialization->False]],
     DefaultBaseStyle->"NetworkGraphics",
     FormatType->TraditionalForm,
     FrameTicks->None], ",", 
    RowBox[{"Properties", "\[Rule]", 
     RowBox[{"{", "\<\"IsomorphicFibers\"\>", "}"}]}], ",", 
    RowBox[{"\<\"VerticalVertexCount\"\>", "\[Rule]", 
     RowBox[{"{", "4", "}"}]}], ",", 
    RowBox[{"\<\"VerticalEdgeCount\"\>", "\[Rule]", 
     RowBox[{"{", "3", "}"}]}], ",", 
    RowBox[{"\<\"HorizontalEdgeCount\"\>", "\[Rule]", 
     RowBox[{"{", "1", "}"}]}]}], "]"}], "]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7c795393-c667-4d53-8b11-0b26464e76fb"]
}, Open  ]]
}, Open  ]],

