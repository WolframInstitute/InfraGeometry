Cell["\<\
Fibers of three vertices over the 3 \[Times] 3 grid: copies of one random \
graph, and independent random graphs:\
\>", "ExampleText",ExpressionUUID->"8a92bfab-23ab-4352-b454-fab9879623f5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fib", " ", "=", " ", 
        RowBox[{"RandomInfraFiberedGraph", "[", 
         RowBox[{
          RowBox[{"GridGraph", "[", 
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
          RowBox[{"Properties", " ", "->", " ", "props"}], ",", "\n", 
          "      ", 
          RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
           RowBox[{"{", "3", "}"}]}], ",", " ", 
          RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "3"}], "}"}]}], ",", " ", 
          RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", 
           RowBox[{"{", "1", "}"}]}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraFiberedGraphHighlight", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraIsomorphicFibersQ", "[", "fib", "]"}]}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"props", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "\"\<IsomorphicFibers\>\"", "}"}], ",", " ", 
        RowBox[{"{", "}"}]}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"edea25ce-c802-418e-b2f2-f17e17446e34"],

