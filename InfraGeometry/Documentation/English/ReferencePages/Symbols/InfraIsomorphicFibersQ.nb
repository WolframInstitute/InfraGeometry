Notebook[{

Cell[CellGroupData[{
Cell["InfraIsomorphicFibersQ", "ObjectName",ExpressionUUID->"e15866db-9b6b-4d9e-a325-c48ad1d4d394"],

Cell["LLM generated.", "Notes",ExpressionUUID->"3173168d-65a3-42b3-b1fb-0bd08963997a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9add45c9-1299-4ff0-b85d-d2ab3d088a9e"],
 Cell[BoxData[
  RowBox[{"InfraIsomorphicFibersQ", "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9ae2f5b-377f-48dd-85f7-46b67e54650d"],
 "\[LineSeparator]",
 "tests whether the induced fiber graphs of ",
 StyleBox["fib", "TI"],
 " are mutually isomorphic.",
 "\n"
}], "Usage",ExpressionUUID->"f5410278-c342-4560-9186-f67efcc54b2c"],

Cell["\<\
The comparison includes every fiber, including fibers over different \
connected base components.\
\>", "Notes",ExpressionUUID->"b2bca770-eaa2-494b-a372-33d1fa2c5faf"],

Cell["\<\
Isomorphism is a property of the vertical fiber graphs. It imposes no lifting \
condition on transverse edges.\
\>", "Notes",ExpressionUUID->"57b4c709-1039-41fd-8a42-e0c863f32d7b"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberBundleQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberBundleQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8386bfba-5522-4644-9c46-b18728cb9143"],
 " also requires unique transverse matchings that preserve fiber adjacency."
}], "Notes",ExpressionUUID->"1f495322-64e4-4aeb-904a-c5059a075503"],

Cell["The empty fibered graph satisfies the condition vacuously.", "Notes",ExpressionUUID->"35d75fab-140c-4ee6-9fb0-cf9e4a8bc3b6"],

Cell["\<\
A nonempty list is tested by conjunction; an empty list gives False. \
Unsupported inputs remain unevaluated.\
\>", "Notes",ExpressionUUID->"82fb8ccb-9a63-42ae-835b-6ae7ccb3ae95"]
}, Open  ]],

