  FontSize->0.9 Inherited,ExpressionUUID->
  "ffb0432c-e900-4b4c-9ed8-40ec2b4baa00"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
