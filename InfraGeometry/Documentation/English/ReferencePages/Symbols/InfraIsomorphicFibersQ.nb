   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4e1f3019-c9bb-4496-bd45-c4a5f0daf525"],
 " if every ",
 StyleBox["fib\:1d62", "TI"],
 " has isomorphic fibers."
}], "Usage",ExpressionUUID->"6e4c2550-fb5e-4ce1-a0e1-07db71c41f80"],

Cell[TextData[{
 "The condition is ",
 StyleBox["F\:209a \[TildeFullEqual] F_q", "TI"],
 " for all base vertices ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ", where ",
 StyleBox["F\:209a", "TI"],
 " is the subgraph of the total graph induced on ",
 StyleBox["\[Pi]\:207b\.b9(p)", "TI"],
 ". Every pair of fibers is compared, also over different connected \
components of the base."
}], "Notes",ExpressionUUID->"8a075419-52d7-4628-89dd-dd471b1fd11b"],

Cell["\<\
The condition concerns the vertical edges only. It says nothing about the \
transverse edges: a fibered graph with isomorphic fibers need not be a \
fibration.\
\>", "Notes",ExpressionUUID->"97c2c220-ebeb-4d19-b5ba-41191b0770f4"],

Cell[TextData[{
 "It is weaker than ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberBundleQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberBundleQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0fe657d5-3199-46fc-b131-068460007995"],
 ", which also asks for one transverse neighbour over every base edge and for \
matchings that preserve the fiber edges. It is stronger than ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEqualFiberSizesQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEqualFiberSizesQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ce139ede-9f44-4cd2-8323-01e97dd5ade0"],
 "."
}], "Notes",ExpressionUUID->"a2d54201-968c-4208-a9e4-cb3a4cb29262"],

Cell[TextData[{
 "The empty fibered graph has isomorphic fibers. An empty list gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "027a0c44-a6b3-4886-b79d-36829034abac"],
 "."
}], "Notes",ExpressionUUID->"e176776e-037f-4398-96f5-a49642cc7eac"]
}, Open  ]],

