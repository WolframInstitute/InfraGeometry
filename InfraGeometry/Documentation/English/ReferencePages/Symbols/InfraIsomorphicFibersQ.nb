Cell["\<\
Equal fiber sizes do not make the fibers isomorphic. The fibers below all \
have 3 vertices but different numbers of edges:\
\>", "ExampleText",ExpressionUUID->"189c9855-6964-491b-a1d3-7e566231309a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "3", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "3"}], "}"}]}], ",", "\n", "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraEqualFiberSizesQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraIsomorphicFibersQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"Values", "[", 
      RowBox[{"EdgeCount", " ", "/@", " ", 
       RowBox[{"InfraFibers", "[", "fib", "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c94878f8-1878-4457-9569-88468cf31ea2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", 
   RowBox[{"{", 
    RowBox[{
    "3", ",", "0", ",", "2", ",", "0", ",", "0", ",", "1", ",", "0", ",", "0",
      ",", "0"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"7da1dfa0-1513-491c-a69e-7ae35a460c80"]
}, Open  ]]
}, Open  ]],

