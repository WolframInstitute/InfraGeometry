Cell["InfraEllipse", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4a308b2b-66d8-4779-8be2-393b5f5ce89d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraEllipse"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraEllipse", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7de12a2c-6487-4613-a6c1-84593a5b75a0"],
 "\[LineSeparator]",
 "is the ellipse with foci ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " and distance sum ",
 StyleBox["s", "TI"],
 ": the shortest cycles on the level set ",
 StyleBox["d(p, v) + d(q, v) = s", "TI"],
 " that separate its inside from its outside.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b1bd9fe8-36c2-4e9d-8744-f4a91da0ee4d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraEllipse"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraEllipse", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s1", "TI"], ",", " ", 
      StyleBox["s2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d5a4dbf-4324-4728-b20c-40feeaf5c189"],
 "\[LineSeparator]",
 "is the ellipse on the band ",
 StyleBox["s1 \[LessEqual] d(p, v) + d(q, v) \[LessEqual] s2", "TI"],
 "."
}], "Usage",ExpressionUUID->"f3473053-7434-473e-9d9d-cfb3cfcdb8e4"],

Cell[TextData[{
 "The band is ",
 StyleBox["E = {v : s\:2081 \[LessEqual] d(p, v) + d(q, v) \[LessEqual] s\
\:2082}", "TI"],
 ". A member of the ellipse is a cycle of the subgraph induced on ",
 StyleBox["E", "TI"],
 ". By default it must separate a vertex with sum below ",
 StyleBox["s\:2081", "TI"],
 " from a vertex with sum above ",
 StyleBox["s\:2082", "TI"],
 ", and only the shortest such cycles count."
}], "Notes",ExpressionUUID->"8d871c57-3699-4b56-ad31-8407b65969f3"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEllipse"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEllipse", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4df6534b-798f-4eb6-8dc7-aaf954f0c7a6"],
 " is a symbolic object: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraEllipse"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraEllipse", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "db820cb9-560e-4a78-b068-d0ea5af5c05d"],
 " draws its members as directed cycle graphs, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5359095e-141e-416c-a6aa-f0d9c128f61a"],
 " reads it as the region of their vertices."
}], "Notes",ExpressionUUID->"9cd9f608-5d04-4f03-a164-cd6942cf47de"],

Cell["\<\
In the plane every level is a closed curve. On a graph an exact level often \
carries no separating cycle, and a band of width 1 or 2 does.\
\>", "Notes",ExpressionUUID->"899cb834-c099-4731-be0e-b27a1667d3bf"],

