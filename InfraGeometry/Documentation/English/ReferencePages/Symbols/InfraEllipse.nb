Cell["InfraEllipse", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell["LLM generated.", "Notes",ExpressionUUID->"4e72811e-339d-456e-b549-b193c4ded427"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0fc5965f-2110-4131-b9aa-d9b1a7fc12bf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraEllipse"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraEllipse", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}], ",", " ", 
    StyleBox["band", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa4dfebe-b5a6-411c-bcee-61ec2ca15885"],
 "\[LineSeparator]",
 "is an inert family of shortest separating cycles in a distance-sum level \
band.",
 "\n"
}], "Usage",ExpressionUUID->"ddbdf2f7-170c-4123-8660-25aaee2d272d"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraEllipse"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraEllipse", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "248d1c28-8a71-4fd8-a2f8-afbc7735e949"],
 " evaluates the family on a graph. A scalar band fixes one distance sum; a \
two-element band gives lower and upper bounds. One representative is a \
directed cycle Graph. This head does not wrap a List of realized cycles. \
Properties follow the existing ellipse sampler."
}], "Notes",ExpressionUUID->"41bc004e-6171-4f3d-b5be-622f576a7ff6"]
}, Open  ]],

