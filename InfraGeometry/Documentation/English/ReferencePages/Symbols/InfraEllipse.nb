Cell[TextData[{
 "With equal foci and sum ",
 StyleBox["2r", "TI"],
 " the ellipse is the circle of radius ",
 StyleBox["r", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"a80559b6-7865-44ed-aa6b-e36db6211eb9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", "[", 
     RowBox[{
      RowBox[{"Sort", " ", "@*", " ", "VertexList"}], " ", "/@", " ", 
      RowBox[{"RandomInfraEllipse", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraEllipse", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"c", ",", " ", "c"}], "}"}], ",", " ", "6"}], "]"}], ",", 
        " ", "All"}], "]"}]}], "]"}], " ", "==", "\n", "    ", 
    RowBox[{"Sort", "[", 
     RowBox[{"Sort", " ", "/@", " ", 
      RowBox[{"RandomInfraCircle", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCircle", "[", 
         RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "All"}], "]"}]}], 
     "]"}]}]}], "]"}]], "Input",
