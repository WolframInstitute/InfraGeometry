Cell[CellGroupData[{
Cell["InfraInterior", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a2953031-cf49-48f2-819a-456e7653ce0b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraInterior"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraInterior", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93a22708-0890-44f6-a49c-24fd9835f5fe"],
 "\[LineSeparator]",
 "gives the interior of the vertex set ",
 StyleBox["s", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ": the vertices of ",
 StyleBox["s", "TI"],
 " all of whose neighbours lie in ",
 StyleBox["s", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"7dda6c06-734a-4e64-ac24-968411489b67"],

Cell[TextData[{
 "The interior is ",
 StyleBox["int S = {v \[Element] S : every neighbour of v is in S}", "TI"],
 ", the set ",
 StyleBox["S", "TI"],
 " minus its ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBoundary"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBoundary", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2ec74095-14a5-428e-8870-3088564d6a3d"],
 "."
}], "Notes",ExpressionUUID->"ca3da1c2-2b97-45c0-bd93-bd58f4f7de10"],

Cell[TextData[{
 "The set ",
 StyleBox["s", "TI"],
 " can be a vertex list, a density, a region such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0dec2d1f-86bd-4ac0-a94b-ce1559ccc289"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5031dbc1-a68a-4a84-8a32-e642f725c0dd"],
 ", a walk ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["path", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71f14221-4881-4e79-9a04-9aa6deda609f"],
 ", a point token ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a2e92585-0d19-4137-8f01-aaadf06fff39"],
 ", or a graph. Only its vertices count."
}], "Notes",ExpressionUUID->"daf82524-25f3-4889-b6e7-6007b00e6409"],

Cell[TextData[{
 "The interior is what the ",
 Cell[BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e64f5b50-124c-470e-ab9d-4c2f87e21860"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2cd5f90a-a816-45b0-9526-6823a7045609"],
 " counts. On the square grid, away from the rim, the interior of the ball ",
 StyleBox["B\:1d63(c)", "TI"],
 " is the ball ",
 StyleBox["B\:1d63\:208b\:2081(c)", "TI"],
 ", with ",
 StyleBox["2r\.b2 \[Minus] 2r + 1", "TI"],
 " vertices. A curve has an empty interior. The whole graph is its own \
interior."
}], "Notes",ExpressionUUID->"4035f80a-0b06-4040-adec-63e04d68eac2"],

