Cell["Method", "ExampleSubsection",ExpressionUUID->"d342b78d-5748-4910-9a9c-bc559c1237d9"],

Cell["\<\
Away from the rim a ball is open in the ball topology. The ball of radius 5 \
on the grid has 61 vertices; its combinatorial interior has 41, its interior \
in the topology of radius 2 all 61:\
\>", "ExampleText",ExpressionUUID->"b62344df-5215-4141-a340-055005fefa45"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"InfraBall", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "5"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "ball", ",", " ", "\"\<CountingMeasure\>\""}], 
      "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraInterior", "[", 
       RowBox[{"g", ",", " ", "ball"}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraInterior", "[", 
       RowBox[{"g", ",", " ", "ball", ",", " ", 
        RowBox[{"Method", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Alexandrov\>\"", ",", " ", 
           RowBox[{"\"\<Radius\>\"", " ", "->", " ", "2"}]}], "}"}]}]}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1c7804ae-cc18-4ec4-ad69-2c0a7a5e8493"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"61", ",", "41", ",", "61"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"dcd3ce2a-c5df-4f24-ba86-ffd26b173b15"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

