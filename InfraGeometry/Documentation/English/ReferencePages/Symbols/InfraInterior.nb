Cell[TextData[{
 "On the grid the interior of the ball of radius ",
 StyleBox["r", "TI"],
 " has ",
 StyleBox["2r\.b2 \[Minus] 2r + 1", "TI"],
 " vertices while the ball stays off the rim:"
}], "ExampleText",ExpressionUUID->"1e68f684-1b99-45f5-bc71-c33cc52c5938"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"InfraInterior", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"c", ",", " ", "r"}], "]"}]}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"r", "^", "2"}]}], " ", "-", " ", 
        RowBox[{"2", " ", "r"}], " ", "+", " ", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "1", ",", " ", "7"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"afcbc26b-3c96-494e-b562-dd33f7bfb8ab"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"13", ",", "13"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"25", ",", "25"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"41", ",", "41"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"61", ",", "61"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"85", ",", "85"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a1e41122-5f98-4569-b3aa-cfc80f61552e"]
}, Open  ]],

Cell["\<\
The rim of the graph is not a boundary, so the whole graph is its own \
interior:\
\>", "ExampleText",ExpressionUUID->"a4a30a65-7b49-4167-835f-571c5ba728cf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{
    RowBox[{"InfraInterior", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"VertexList", "[", "g", "]"}]}], "]"}], " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"VertexList", "[", "g", "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"93afa47a-ecdf-4cb6-83a4-17a9010628cb"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"21a024f5-ed56-4972-851c-751a1156ea47"]
}, Open  ]],

Cell["\<\
A walk has the interior of its vertex set. A closed walk round a square of \
side 2 is a curve and has none; the square it bounds has its centre 56:\
\>", "ExampleText",ExpressionUUID->"35dd64ee-69f1-4fd9-9f79-78b99bb533b8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraInterior", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraWalk", "[", 
        RowBox[{"{", 
         RowBox[{
         "45", ",", " ", "46", ",", " ", "47", ",", " ", "57", ",", " ", "67",
           ",", " ", "66", ",", " ", "65", ",", " ", "55", ",", " ", "45"}], 
         "}"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"InfraInterior", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "45", ",", " ", "46", ",", " ", "47", ",", " ", "55", ",", " ", "56", 
         ",", " ", "57", ",", " ", "65", ",", " ", "66", ",", " ", "67"}], 
        "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"878ef119-9afa-4f84-b9d9-a9bdcbaf9d06"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "56", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"9bba644c-c220-4b3d-b6c8-6851954f63e4"]
}, Open  ]]
}, Open  ]],

