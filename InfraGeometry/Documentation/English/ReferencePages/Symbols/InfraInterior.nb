Cell["The number of interior vertices is the Riemannian measure:", \
"ExampleText",ExpressionUUID->"da41e6c4-102f-4532-aab8-6969b4e201ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"InfraInterior", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "r"}], "]"}]}], "]"}]}], " ", "==", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
        " ", "\"\<RiemannianMeasure\>\""}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"cf7dc441-f7ba-4485-91c6-8492ff4711ce"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "True", ",", "True", ",", "True", ",", "True", ",", "True", ",", "True", ",",
    "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"093a62e2-230b-44f5-b088-0032656baec1"]
}, Open  ]]
}, Open  ]],

