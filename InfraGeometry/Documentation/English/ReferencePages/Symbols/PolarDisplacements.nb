Cell["\<\
The radial displacement is 1-continuous on the three tilings; the angular one \
only where it fixes every vertex.\
\>", "ExampleText",ExpressionUUID->"8b198ef0-e0f0-4933-b267-12c127b59c36"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graphs", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"#", ",", " ", "\"\<Small\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}],
        " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"polars", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"PolarDisplacements", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"InfraCenter", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
       " ", "graphs"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"MapThread", "[", 
       RowBox[{"DisplacementPlot", ",", " ", 
        RowBox[{"{", 
         RowBox[{"graphs", ",", " ", "polars"}], "}"}]}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ContinuousDisplacementQ", "[", 
           RowBox[{"#1", ",", " ", 
            RowBox[{"First", "[", "#2", "]"}]}], "]"}], ",", " ", 
          RowBox[{"ContinuousDisplacementQ", "[", 
           RowBox[{"#1", ",", " ", 
            RowBox[{"Last", "[", "#2", "]"}]}], "]"}]}], "}"}], " ", "&"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"graphs", ",", " ", "polars"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3a2ebc5b-dccd-4f86-ae98-1094e21585ef"],

