Notebook[{

Cell[CellGroupData[{
Cell["PolarDisplacements", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"92277b3f-d714-412d-93ae-db78d3a48ff5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PolarDisplacements"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/PolarDisplacements", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d844e9f4-abcb-4638-854f-da5fd109db00"],
 "\[LineSeparator]",
 "gives the pair {",
 StyleBox["radial", "TI"],
 ", ",
 StyleBox["angular", "TI"],
 "} about the vertex ",
 StyleBox["c", "TI"],
 ": the radial displacement moves each vertex to its neighbours one step \
further from ",
 StyleBox["c", "TI"],
 ", the angular one to its neighbours at the same distance from ",
 StyleBox["c", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"684bcf27-4c02-4e24-a0a4-e7dff3f75566"],

Cell[TextData[{
 "With ",
 StyleBox["\[Rho](v) = d(c, v)", "TI"],
 ", the two displacements are"
}], "Notes",ExpressionUUID->"45363940-e0fc-4280-800c-db335347438a"],

Cell[TextData[{
 StyleBox["radial(v) = {u \[Tilde] v : \[Rho](u) = \[Rho](v) + 1}", "TI"],
 ","
}], "Notes",ExpressionUUID->"cc3e5c33-b255-49b8-b399-1e1fb79ef672"],

Cell[TextData[{
 StyleBox["angular(v) = {u \[Tilde] v : \[Rho](u) = \[Rho](v)}", "TI"],
 ","
}], "Notes",ExpressionUUID->"acd4dd7e-c4f4-4461-a33a-f8ab61c06ef7"],

Cell[TextData[{
 "and a vertex with no such neighbour stays. They are the discrete \
counterparts of the polar vector fields ",
 StyleBox["\[PartialD]\:1d68", "TI"],
 " and ",
 StyleBox["\[PartialD]_\[Theta]", "TI"],
 " at scale 1."
}], "Notes",ExpressionUUID->"d5c801c8-f24a-472c-a477-174ad1bd04c2"],

Cell[TextData[{
 "Both are multivalued. On the square grid an inner vertex off the axes \
through ",
 StyleBox["c", "TI"],
 " has two neighbours further out, a vertex on an axis three, and ",
 StyleBox["c", "TI"],
 " four."
}], "Notes",ExpressionUUID->"d043da96-ecc0-4e0b-8ac2-5d0e729c1577"],

Cell[TextData[{
 "On a bipartite graph, such as the square grid, no edge joins two vertices \
at the same distance from ",
 StyleBox["c", "TI"],
 ", and the angular displacement fixes every vertex."
}], "Notes",ExpressionUUID->"93914730-6e91-4956-9319-73103e945f62"],

Cell[TextData[{
 "The outward radial displacement is the gradient of ",
 StyleBox["\[Rho]", "TI"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradientDisplacement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/GradientDisplacement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "72252a4e-83f5-4f15-865c-ad3e6e1e99d7"],
 ")."
}], "Notes",ExpressionUUID->"895f259d-b2b3-4e65-a50f-93624b2057f0"],

Cell["Options:", "Notes",ExpressionUUID->"ffb6f83a-dedc-4ade-8f50-39c1ca528fda"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e58d8947-b16c-41e8-a042-885811d0e123"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"a097f0f6-3c0d-4a70-b72f-b87ae2a23f75"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"e99d8fd8-1fa7-4b4d-974f-8ed4223b2239"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"128c67f1-16bd-43d9-9eb1-45648cd05caf"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "223cfccf-a3a4-4d04-8771-6e05e3533de7"], Cell[TextData[Cell[
    BoxData["\"\<Direction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c95281e3-294d-4f4a-9440-f0e2a6c630a9"]], "TableText",ExpressionUUID->
     "80ff5207-c12d-4c5c-90de-4e5f2e494978"], Cell[TextData[Cell[
    BoxData["\"\<Outward\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "80ee5cfb-f4df-463c-a838-8889fe9428c8"]], "TableText",ExpressionUUID->
     "61468709-fd6b-4756-9a20-26ab48715639"], Cell[TextData[{
     Cell[BoxData["\"\<Inward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "472f5f95-4729-4273-a8b9-36e2678e8529"],
     " takes ",
     StyleBox["\[Rho](u) = \[Rho](v) \[Minus] 1", "TI"],
     " for the radial displacement; the angular one does not change"
    }], "TableText",ExpressionUUID->"8e98fa5a-4063-49a1-8389-fa73cc0ab275"]}
  }]], "3ColumnTableMod",ExpressionUUID->"9140973f-2a67-4bcf-885e-\
187ec34b6a35"]
}, Open  ]],

