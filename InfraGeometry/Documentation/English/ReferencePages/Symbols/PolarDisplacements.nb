Notebook[{

Cell[CellGroupData[{
Cell["PolarDisplacements", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2436c983-2ff9-4638-81a5-64106198f84f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PolarDisplacements"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/PolarDisplacements", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48818ef8-27c1-4a4c-8316-88fb133843a0"],
 "\[LineSeparator]",
 "gives the polar pair {",
 StyleBox["radial", "TI"],
 ", ",
 StyleBox["angular", "TI"],
 "} about the vertex ",
 StyleBox["c", "TI"],
 ": the radial displacement moves each vertex to its neighbours one step \
further from ",
 StyleBox["c", "TI"],
 ", the angular one to its neighbours at the same distance from ",
 StyleBox["c", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"fd810f1a-7a44-4f0f-bc45-ea2c25d4927e"],

Cell[TextData[{
 "Definition: with ",
 StyleBox["\[Rho](v) = d(c, v)", "TI"],
 ","
}], "Notes",ExpressionUUID->"a3ddd6f2-d04d-4daa-9585-d92fa2b13b58"],

Cell[TextData[{
 StyleBox["radial(v) = { u : u adjacent to v, \[Rho](u) = \[Rho](v) + 1 }", 
  "TI"],
 ","
}], "Notes",ExpressionUUID->"1894b2fe-6737-44ee-ae87-0dca9c50317e"],

Cell[TextData[{
 StyleBox["angular(v) = { u : u adjacent to v, \[Rho](u) = \[Rho](v) }", "TI"],
 ","
}], "Notes",ExpressionUUID->"60e88be7-8a09-4108-b7eb-cd6ba1e296d0"],

Cell[TextData[{
 "and a vertex with no such neighbour stays: its value is {",
 StyleBox["v", "TI"],
 "}. These are the discrete counterparts of the vector fields ",
 StyleBox["\[PartialD]_\[Rho]", "TI"],
 " and ",
 StyleBox["\[PartialD]_\[Theta]", "TI"],
 " of polar coordinates, at scale 1."
}], "Notes",ExpressionUUID->"3cc97395-d223-471f-ba14-0b52b6ec140e"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["\"\<Direction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e136950e-3cd3-4c28-886b-7cd05d0ecb70"],
 " -> ",
 Cell[BoxData["\"\<Inward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b73c1f0-54ac-411f-83c7-b0e26588dac6"],
 " takes ",
 StyleBox["\[Rho](u) = \[Rho](v) \[Minus] 1", "TI"],
 " for the radial displacement, so the centre stays; the default is ",
 Cell[BoxData["\"\<Outward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38dc78ca-4981-4b13-9afe-e48646aa09ed"],
 ". The angular displacement does not depend on it."
}], "Notes",ExpressionUUID->"1ecb88ca-a57d-44e9-9ab8-a931b06c2a4c"],

Cell[TextData[{
 "The outward radial displacement is the gradient of ",
 StyleBox["\[Rho]", "TI"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GradientDisplacement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/GradientDisplacement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e14e1d1c-510b-4b6c-9c7b-57c3b5d80f21"],
 "). On a bipartite graph, such as the square and the hexagonal tilings, no \
edge joins two vertices at the same distance from ",
 StyleBox["c", "TI"],
 ", so the angular displacement fixes every vertex."
}], "Notes",ExpressionUUID->"3bf8c5cf-50b9-44e4-ab5f-52a861f2d24a"]
}, Open  ]],

