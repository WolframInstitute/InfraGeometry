Cell["\<\
On the triangular tiling the angular displacement runs both ways round the \
hexagonal distance spheres.\
\>", "ExampleText",ExpressionUUID->"8c1f1d65-ef5d-4e1b-bbcf-443ce6025462"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"polar", " ", "=", " ", 
     RowBox[{"PolarDisplacements", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCenter", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"DisplacementPlot", "[", 
       RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
     "polar"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ffa95bdf-b38e-49a9-a673-24220fc3124c"],

