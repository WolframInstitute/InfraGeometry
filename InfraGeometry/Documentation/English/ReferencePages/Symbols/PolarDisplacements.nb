Cell["\<\
The outward radial displacement is the gradient of the distance from the \
centre:\
\>", "ExampleText",ExpressionUUID->"3ca34a2e-60e2-402a-8b5c-67ba744be653"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"First", " ", "@", " ", 
     RowBox[{"PolarDisplacements", "[", 
      RowBox[{"g", ",", " ", "c"}], "]"}]}], " ", "===", " ", 
    RowBox[{"GradientDisplacement", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", "c"}], "]"}]}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"da100495-80fb-4564-868e-c8445539eabc"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"22aba3c3-fcf2-46c9-94b4-e262bac0de7f"]
}, Open  ]],

Cell["\<\
The radial displacement is 1-continuous on the grid but not on the mesh. The \
angular displacement of the mesh is 2-continuous, not 1-continuous:\
\>", "ExampleText",ExpressionUUID->"14096b40-b4ab-4357-bbff-09cc5bd96196"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
        "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"polar", " ", "=", " ", 
       RowBox[{"PolarDisplacements", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ContinuousDisplacementQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"First", " ", "@", " ", "polar"}]}], "]"}], ",", " ", 
       RowBox[{"ContinuousDisplacementQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Last", " ", "@", " ", "polar"}]}], "]"}], ",", "\n", 
       "     ", 
       RowBox[{"ContinuousDisplacementQ", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Last", " ", "@", " ", "polar"}], ",", " ", "2"}], "]"}]}], 
      "}"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", 
       " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"bc2d6393-5deb-44e9-844d-43d75232a927"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"True", ",", "True", ",", "True"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"False", ",", "False", ",", "True"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"5e1e8b77-c40e-45d9-98a6-e4c8621d7251"]
}, Open  ]],

Cell["\<\
The numbers of values of the radial displacement of the grid, with their \
counts. The 32 pendant vertices have no neighbour further out and stay:\
\>", "ExampleText",ExpressionUUID->"bed5f8b6-a7cc-4fd1-9bcd-40078653e05e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"KeySort", " ", "@", " ", 
    RowBox[{"Counts", "[", 
     RowBox[{"Length", " ", "/@", " ", 
      RowBox[{"Values", " ", "@", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"PolarDisplacements", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}]}]}], "]"}]}]}],
   "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"2893f9ec-9596-4367-9aaf-8de27a84f1b8"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "32"}], ",", 
   RowBox[{"2", "\[Rule]", "49"}], ",", 
   RowBox[{"3", "\[Rule]", "14"}], ",", 
   RowBox[{"4", "\[Rule]", "1"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"694438cc-e063-4b66-9c29-ef1a8f7847d9"]
}, Open  ]]
}, Open  ]],

