Cell["\<\
Both displacements are multivalued: on the triangular tiling an inner vertex \
has two or three neighbours further out and two on its own distance sphere.\
\>", "ExampleText",ExpressionUUID->"9f104e7f-5ea5-4400-81ec-c80b5a1be1bb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"polar", " ", "=", " ", 
     RowBox[{"PolarDisplacements", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCenter", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", "polar"}], "]"}], ",", " ", 
     RowBox[{"DisplacementSingleValuedQ", " ", "/@", " ", "polar"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"ee14ddb9-4d80-42b4-88e6-ea3f5e1102ac"],

