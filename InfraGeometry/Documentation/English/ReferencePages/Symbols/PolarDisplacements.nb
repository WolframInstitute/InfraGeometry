Cell["\<\
The outward radial displacement is the gradient of the distance from the \
centre.\
\>", "ExampleText",ExpressionUUID->"66a3bf7e-19b2-493c-be9c-a28441848fa9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"radial", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"PolarDisplacements", "[", 
       RowBox[{"g", ",", " ", "c"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", "radial"}], "]"}], ",", " ", 
     RowBox[{"radial", " ", "===", " ", 
      RowBox[{"GradientDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c"}], "]"}]}], "]"}]}], "]"}]}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6fae3a39-6a9e-475f-88de-9e6d850029e3"],

