Cell["\<\
Any vertex can be the centre. A vertex of the periphery of the mesh, of \
largest eccentricity:\
\>", "ExampleText",ExpressionUUID->"15414f44-6495-485f-bb2b-58c0e2278cab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"PolarDisplacements", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphPeriphery", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5333212d-596a-43bb-9b6a-294d298df6d3"],

