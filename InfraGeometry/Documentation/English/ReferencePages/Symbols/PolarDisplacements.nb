Cell[CellGroupData[{

Cell["Direction", "ExampleSubsection",ExpressionUUID->"09732f1e-7f95-45cb-b95e-99e93a97a859"],

Cell["\<\
The inward radial displacement points to the centre, which stays:\
\>", "ExampleText",ExpressionUUID->"784ffe48-4a32-48d5-880f-ea06297255f7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inward", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"PolarDisplacements", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<Inward\>\""}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", "inward", ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"inward", "[", "c", "]"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"816d6783-0a11-493c-af06-ea212445a208"],

