Cell["The search agrees with the graph of the head.", "ExampleText",ExpressionUUID->"a37fe647-7f12-4f17-83b3-90c5b232476c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"RandomInfraLine", "[", 
      RowBox[{"g", ",", " ", "6", ",", " ", "7", ",", " ", "All"}], "]"}]}], 
    " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"RandomInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraLine", "[", 
        RowBox[{"6", ",", " ", "7"}], "]"}], ",", " ", "All"}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b49524b8-951f-45c3-9f69-5aaf36bce3ba"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"37a2be20-60c3-41c2-8f81-a9bf7de58993"]
}, Open  ]],

