Cell[CellGroupData[{
Cell["RandomInfraLine", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"55bb37fa-6c1d-4830-b545-cd953bc21b21"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9683aba-567d-46c0-87ad-3b6cb35cacb4"],
 "\[LineSeparator]",
 "gives one line through ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " \[LongDash] an inextensible geodesic containing both \[LongDash] as a \
vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"50b4ac78-4603-4f04-9b99-41a50f254562"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seq", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bdf6999-0d53-4a28-b141-e6d5e1cd6ecb"],
 "\[LineSeparator]",
 "gives one line containing the geodesic vertex list ",
 StyleBox["seq", "TI"],
 " as a contiguous subsequence.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"05248de0-d9c7-41cd-b665-d1b126ca001f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f79c8f0-7d1e-4a74-99c3-42ffade980d0"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "419194e5-1464-43aa-aab3-1b242b721c80"],
 " of exactly ",
 StyleBox["n", "TI"],
 " lines or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f7d7e94-4ad9-45e5-b70b-586ee150c457"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5741525a-e71d-4f69-9fd2-0e696035809b"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6fe9571-2675-4e3c-b539-deede9e6521b"],
 " gives every line."
}], "Usage",ExpressionUUID->"05dca26f-ab79-4b7b-b771-f077be1bf98e"],

Cell[TextData[{
 "A line is an ",
 StyleBox["inextensible geodesic",
  FontWeight->"Bold"],
 ": a shortest path that no neighbour of either endpoint prolongs. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "75fce104-5b99-479e-a6d2-2bd12ed605f0"],
 " is the predicate, and every line returned satisfies it."
}], "Notes",ExpressionUUID->"2a16db3c-7f81-4660-90f0-40a308af6bf9"],

Cell["\<\
That is the intrinsic reading of Euclid's second postulate \[LongDash] \
produce a finite straight line continuously \[LongDash] and it is where the \
analogy with the plane breaks hardest. In the plane two points determine one \
line. On a lattice they determine an enormous family: below, two vertices at \
distance 5 on a 313-vertex square-tiling patch lie on 5 242 880 lines, \
against 6144 on the hexagonal tiling and 1386 on the irregular mesh.\
\>", "Notes",ExpressionUUID->"d3f7beb2-2bd6-450c-a99a-b828339bb0d0"],

Cell[TextData[{
 "The search runs on the substrate directly: a geodesic from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 ", prolonged one geodesic step at a time, every prolongation at the back and \
then every prolongation at the front, kept when neither end can be prolonged. \
It does not read the graph of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "460fb840-0b10-48eb-8ae0-fb062c5c361e"],
 ", so it is the check on that graph, and it returns exactly the shapes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "977ef0ad-1681-4453-a3cc-3e5fb6172523"],
 " gives for that head."
}], "Notes",ExpressionUUID->"31eb3b4c-e478-406d-8c01-9946cf4b288d"],

Cell[TextData[{
 "The search enumerates. To count lines, use ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraLine", "[", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"]}], "]"}], ",", " ", "\"\<Cardinality\>\""}], "]"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "122e5ddd-dd56-45e4-888c-de5c9353f47b"],
 ", which reads the count off the head's graph without enumerating a line."
}], "Notes",ExpressionUUID->"be8c78e3-afbe-4455-9c6b-aa21ab790ac6"],

Cell[TextData[{
 "The count-less call is one line, deterministic. There is no ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c9c92f27-2676-4b31-a5c9-eed7920b00d3"],
 " and no ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f4860b5-f0e9-4a6d-819b-fd8ea9856555"],
 "."
}], "Notes",ExpressionUUID->"6acb9272-3416-49da-96aa-6e02e1f6d5a1"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"d3bba8f4-3d06-49ed-84d0-8ce62abf0713"],

