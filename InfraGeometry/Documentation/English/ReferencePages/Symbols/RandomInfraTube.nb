Cell[CellGroupData[{
Cell["RandomInfraTube", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"68a14577-2798-482d-817e-c4e7f10e723a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraTube", "[", 
     RowBox[{
      StyleBox["axis", "TI"], ",", " ", 
      StyleBox["profile", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60f05af6-aa7e-43f5-81f2-34dcea27f9d9"],
 "\[LineSeparator]",
 "samples a sorted vertex set on graph ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"bf048c49-c104-4b0c-bb80-35137c056db8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraTube", "[", 
     RowBox[{
      StyleBox["axis", "TI"], ",", " ", 
      StyleBox["profile", "TI"]}], "]"}], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed723f74-7a91-44cb-89f6-67d277282ebd"],
 "\[LineSeparator]",
 "requests ",
 Cell[BoxData["count"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f51a8383-b7fd-4c49-bc70-11fc4741eb69"],
 " representatives. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ec60bdc-d71b-4210-bccf-a250650bbc9b"],
 " enumerates the full pool; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27557bcc-d807-459d-91be-1f76c6bfdd63"],
 " returns at most ",
 StyleBox["n", "TI"],
 "."
}], "Usage",ExpressionUUID->"b97452f3-9299-4e76-9762-158f6a1ec236"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomInfraTube", "[", 
   RowBox[{"g", ",", " ", "axis", ",", " ", "profile", ",", " ", "count"}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aae239ed-6223-4f25-80b9-72d0f3ecbf50"],
 " uses the direct form. ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33ce858c-650f-4843-b989-d18d8c73255e"],
 " is a bare geometry option; use a rule inside the token for token \
geometry."
}], "Notes",ExpressionUUID->"3d7876ae-ae59-49bd-8d1c-713f56d95973"],

Cell[TextData[{
 "The sampler has the same token geometry as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTube"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c6e8b2a2-e948-4bcb-bb09-d9aa29ae0d51"],
 ". An omitted or ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9daa8f1e-2192-4a4f-8a15-93753bc861d0"],
 " count returns one representative. An integer count requests exactly that \
many distinct representatives and returns ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "442fb227-c2ca-4090-a077-eb8b098d206a"],
 " when too few exist."
}], "Notes",ExpressionUUID->"d13166d2-196a-4cac-9f90-8cdda217176b"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12dbf727-4186-4c21-b0e7-d6c0a81ed703"],
 " selects deterministically. Default ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cf4eebe-2cfc-453a-b7ca-f93024d35ac3"],
 " does not advance random state. Seed an ordinary draw with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44e8c6d1-4029-40af-83e8-2b181df5500c"],
 "."
}], "Notes",ExpressionUUID->"2ee955a5-f367-465c-811d-784334772091"],

