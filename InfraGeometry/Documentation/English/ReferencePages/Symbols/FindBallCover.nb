Cell["\<\
A cover found is a cover, and its length is the covering number:\
\>", "ExampleText",ExpressionUUID->"bbbfbdb5-87c4-477a-ab6e-263cb4dc4bd8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"cover", " ", "=", " ", 
         RowBox[{"FindBallCover", "[", 
          RowBox[{"g", ",", " ", "r"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"BallCoverQ", "[", 
         RowBox[{"g", ",", " ", "r", ",", " ", "cover"}], "]"}], " ", "&&", 
        " ", 
        RowBox[{
         RowBox[{"Length", "[", "cover", "]"}], " ", "==", " ", 
         RowBox[{"BallCoverNumber", "[", 
          RowBox[{"g", ",", " ", "r"}], "]"}]}]}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5901fbdf-20e7-4d23-b745-534369c3d081"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "True", ",", "True", ",", "True", ",", "True", ",", "True", ",", "True", ",",
    "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"596c8dcf-fe6e-424d-a8f9-d65b6b7579ff"]
}, Open  ]]
}, Open  ]],

