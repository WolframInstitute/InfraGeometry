A greedy cover can use more balls than a minimum cover; each picture shows \
its covering balls:\
\>", "ExampleText",ExpressionUUID->"79fff8de-0944-44d8-95c7-f18923924eb2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "\t", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{
     "GraphData", "[", " ", "\"\<CuboctahedralGraph\>\"", " ", "]"}]}], " ", 
    "}"}], ",", "\n", "\t", 
   RowBox[{"{", " ", 
    RowBox[{"methods", " ", "=", " ", 
     RowBox[{"{", " ", 
      RowBox[{"Automatic", ",", " ", "\"\<Greedy\>\""}], " ", "}"}]}], " ", 
    "}"}], ",", "\n", "\t", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Map", "[", "\n", "\t\t", 
     RowBox[{
      RowBox[{"method", " ", "|->", " ", 
       RowBox[{"With", "[", "\n", "\t\t\t", 
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{"centres", " ", "=", " ", 
           RowBox[{"FindBallCover", "[", " ", 
            RowBox[{"graph", ",", " ", "1", ",", " ", 
             RowBox[{"Method", " ", "->", " ", "method"}]}], " ", "]"}]}], 
          " ", "}"}], ",", "\n", "\t\t\t", 
         RowBox[{"Labeled", "[", " ", 
          RowBox[{
           RowBox[{"InfraSubstrateHighlight", "[", " ", 
            RowBox[{"graph", ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"InfraBall", "[", " ", 
                RowBox[{"#", ",", " ", "1"}], " ", "]"}], " ", "&"}], " ", "/@",
               " ", "centres"}]}], " ", "]"}], ",", "\n", "\t\t\t\t", 
           RowBox[{"Row", "[", " ", 
            RowBox[{"{", " ", 
             RowBox[{"method", ",", " ", "\"\<: \>\"", ",", " ", 
              RowBox[{"Length", "[", " ", "centres", " ", "]"}], ",", 
              " ", "\"\< balls\>\""}], " ", "}"}], " ", "]"}]}], " ", "]"}]}],
         " ", "]"}]}], ",", " ", "methods"}], " ", "]"}]}]}], " ", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2aaa4c81-7f99-49aa-9fcd-044ff3a79220"],

