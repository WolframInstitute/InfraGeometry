Cell["\<\
Cover a radius-four ball by radius-two balls, using the ambient graph for \
centres and distances:\
\>", "ExampleText",ExpressionUUID->"a60d599d-12ed-48f1-9e27-60ab5a0ccf4b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"With", "[", "\n", "\t\t", 
     RowBox[{
      RowBox[{"{", " ", 
       RowBox[{"graph", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", " ", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], " ", 
         "]"}]}], " ", "}"}], ",", "\n", "\t\t", 
      RowBox[{"{", " ", 
       RowBox[{"target", " ", "=", " ", 
        RowBox[{"InfraBall", "[", " ", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", " ", "graph", " ", "]"}]}], ",", " ", 
          "4"}], " ", "]"}]}], " ", "}"}], ",", "\n", "\t\t", 
      RowBox[{"InfraSubstrateHighlight", "[", " ", 
       RowBox[{"graph", ",", "\n", "\t\t\t", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"target", " ", "->", " ", "StandardGray"}], ",", " ", 
          RowBox[{
           RowBox[{"FindBallCover", "[", " ", 
            RowBox[{"graph", ",", " ", "2", ",", " ", "target"}], " ", "]"}], 
           " ", "->", " ", "StandardRed"}]}], " ", "}"}]}], " ", "]"}]}], " ",
      "]"}], ",", "\n", "\t", 
    RowBox[{"{", " ", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", " ", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], " ", "}"}]}], " ", "}"}]}], 
   " ", "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"db85ee9b-4ec8-41e9-b58e-6980206b1c36"],

