Cell[CellGroupData[{
Cell["FindBallCover", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ebc4d333-115f-4a53-a590-0d9f59e28d89"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindBallCover"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindBallCover", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d45b6f3-5a11-4221-b999-0ea213943ead"],
 "\[LineSeparator]",
 "gives a list of centres whose closed balls of radius ",
 StyleBox["r", "TI"],
 " cover every vertex of ",
 StyleBox["g", "TI"],
 ", minimizing their number by default.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6be48d83-ef57-41fd-90e4-9eb5ffc62e14"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindBallCover"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindBallCover", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["target", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "774d9899-e782-4f36-ae14-49e34338cf43"],
 "\[LineSeparator]",
 "covers the vertices of ",
 StyleBox["target", "TI"],
 ", using centres anywhere in ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7a9187b7-bf75-4ef3-9447-f670ff82854c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindBallCover"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindBallCover", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["target", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5beef26a-1283-49c6-bc0c-6a42b7da558c"],
 "\[LineSeparator]",
 "gives exactly ",
 StyleBox["n", "TI"],
 " different minimum covers, or an empty list if fewer exist.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"397b5ebf-cc0e-479e-be62-8c98ce94b1d7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindBallCover"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindBallCover", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["target", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["UpTo",
      BaseStyle->"Link"], "[", 
     StyleBox["n", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80d6f9bf-31ce-454a-8696-9f6def28653e"],
 "\[LineSeparator]",
 "gives at most ",
 StyleBox["n", "TI"],
 " different minimum covers.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1be3df3c-f108-4a45-9add-65ad7e477ec5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindBallCover"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindBallCover", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["target", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "902754e2-dcbb-4d0f-a058-19a03c8b937f"],
 "\[LineSeparator]",
 "gives every minimum cover."
}], "Usage",ExpressionUUID->"5ab8b83f-5de9-4d15-87b3-b629ce4462ab"],

Cell[TextData[{
 "A centre set ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c32824f0-c4d9-45f5-8863-9058708eb7b7"],
 " covers a target ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ded383ed-4fa9-42a8-948f-d00e416db042"],
 " when every target vertex is at graph distance at most ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "508b3910-9ceb-4489-8fb3-44234e858d22"],
 " from some centre. Its balls and distances are read on the ambient graph ",
 StyleBox["g", "TI"],
 ". The graph is finite, undirected and unweighted; the radius is a \
nonnegative integer, defaulting to 1. The target defaults to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3cdfa81c-2a5b-4d19-9acf-73355e172bb9"],
 "."
}], "Notes",ExpressionUUID->"ae7ca17d-0ae9-4d54-bc3e-e99f60feefd6"],

Cell[TextData[{
 "A target can be a vertex, a vertex list, a density association, a graph \
carrier or an abstract region such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ddc17daa-297c-4535-ac28-b08e21d56816"],
 ". Only its vertex support matters; density masses are ignored. A literal \
vertex of ",
 StyleBox["g", "TI"],
 " takes precedence over list interpretation. An association can specify a \
target set without this ambiguity."
}], "Notes",ExpressionUUID->"475e76ff-2b4c-43fe-be07-c84d1f013e18"],

