Cell["\<\
A smallest cover and a greedy cover at radius 4 on the grid. The greedy one \
needs 7 balls instead of 4:\
\>", "ExampleText",ExpressionUUID->"76b9990b-c779-460a-9a21-d334eccf1c0c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"cover", " ", "=", " ", 
          RowBox[{"FindBallCover", "[", 
           RowBox[{"g", ",", " ", "4", ",", " ", 
            RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}]}], "}"}], ",", 
        "\n", "      ", 
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"InfraBall", "[", 
             RowBox[{"#", ",", " ", "4"}], "]"}], " ", "&"}], " ", "/@", " ", 
           "cover"}], ",", " ", 
          RowBox[{"PlotLabel", " ", "->", " ", 
           RowBox[{"Length", "[", "cover", "]"}]}]}], "]"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "\"\<Greedy\>\""}], "}"}]}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7c2c6bcb-fbbc-4b89-975c-29b322a108c6"],

