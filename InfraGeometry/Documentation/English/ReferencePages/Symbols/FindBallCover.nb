896643f852ca"],

Cell[TextData[{
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac941f8f-12f8-4a87-af8d-9b1510b08207"],
 " remains a compatibility alias for ",
 Cell[BoxData["\"\<IntegerLinearProgramming\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6354d2fb-e6f7-43d6-a3e3-745e796de3fc"],
 "; it does not describe a separate brute-force algorithm. These strings are \
method values of this function, not solver method names of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LinearOptimization"]], "paclet:ref/LinearOptimization"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d96f7312-1ff2-4359-9f85-6f5815e642a0"],
 ". ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d60e8c4-aaa0-464b-8068-887fa3fa1cde"],
 " is unsupported because its restricted covers need not attain the ordinary \
covering number."
}], "Notes",ExpressionUUID->"a3b31dc2-dae8-44af-933b-e19e8132f621"],

Cell[TextData[{
 "The result without a count is one centre list. An explicit count gives a \
list of centre lists; in particular, explicit 1 gives a one-element list. \
Counts occupy the fourth argument, after the target. Exact methods enumerate \
distinct minimum centre sets. A single optimum is a solver-selected witness, \
not an intrinsic canonical choice; it need not be the first entry of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4b076462-683e-4a50-91f1-8ec056508d1a"],
 ". Calls with different counts are not promised to form nested prefixes. \
Enumeration can be expensive even when finding one cover is fast. Use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomBallCover"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomBallCover", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4fa18ba3-68a8-4226-97a2-bbcc3e835e4c"],
 " to sample uniformly from the minimum family."
}], "Notes",ExpressionUUID->"a80787ed-398e-46a5-9242-c2c9a43a6374"],

Cell[TextData[{
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d8b53cd-be65-4fce-94e7-285d59916180"],
 " supports only the form without a count. It breaks equal maximum-gain ties \
by the current candidate order, without random draws. Its result is feasible \
but need not be minimum or inclusion-minimal. An inclusion-minimal cover has \
no removable centre; a minimum cover has the fewest centres."
}], "Notes",ExpressionUUID->"fe177c0d-c247-4d12-a400-5a0b6ffc4748"],

Cell[TextData[{
 "The empty target has one minimum cover, the empty centre list. The \
count-less result is ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2045b3ea-ed84-4a7f-8421-6a2434036e47"],
 ", while explicit 1, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UpTo"]], "paclet:ref/UpTo"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4f2e4f2d-b690-450d-b597-1fbcba3a0516"],
 "[1] and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "091bcea4-8c67-4ae0-bc50-6e8da79c3e1f"],
 " give ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"{", "}"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "83074d40-5948-4d5c-85a6-74ee2e15e3cd"],
 ". An empty association ",
 Cell[BoxData[
  RowBox[{"<|", "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "788dbe0d-2027-47a8-894e-c7b5c50da356"],
 " specifies an empty target even when ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b829a50-06d3-4bb4-95e8-f9b51bb1d9da"],
 " is itself a vertex label."
}], "Notes",ExpressionUUID->"96aae3ae-2e2c-4ede-85a0-2dfef3b92473"]
}, Open  ]],

