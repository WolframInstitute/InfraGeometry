  }]], "3ColumnTableMod",ExpressionUUID->"57260a96-d321-4137-8a1f-\
c2b958f2306e"],

Cell[TextData[{
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f05c518-577d-481a-b17e-b949e0781f18"],
 " takes, again and again, the centre whose ball covers the most uncovered \
vertices. It gives a single cover and takes no count."
}], "Notes",ExpressionUUID->"d15d6b38-bfaa-4e4e-9351-e1adbc8bb38e"],

Cell["\<\
The graph is undirected and unweighted, the radius a nonnegative integer.\
\>", "Notes",ExpressionUUID->"d86bf75a-3dfd-4fb5-9e61-40c8611f8608"]
}, Open  ]],

