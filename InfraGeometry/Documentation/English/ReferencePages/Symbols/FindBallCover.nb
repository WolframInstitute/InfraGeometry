 "."
}], "ExampleText",ExpressionUUID->"abb8b61d-93c5-478d-976d-d6b6e8e26b11"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cover", " ", "=", " ", 
     RowBox[{"FindBallCover", "[", 
      RowBox[{"g", ",", " ", "3"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraBall", "[", 
          RowBox[{"#", ",", " ", "3"}], "]"}], " ", "&"}], " ", "/@", " ", 
        "cover"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"BallCoverQ", "[", 
      RowBox[{"g", ",", " ", "3", ",", " ", "cover"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Length", "[", "cover", "]"}], " ", "==", " ", 
      RowBox[{"DominationNumber", "[", 
       RowBox[{"g", ",", " ", "3"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"313a1204-6c88-4431-a972-35ee374af372"],

