Cell["Method", "ExampleSubsection",ExpressionUUID->"8a0a7d2c-6145-4cec-8bb0-dea6add217e7"],

Cell["\<\
The three methods on the hexagonal tiling at radius 2. Only the exhaustive \
cover is smallest.\
\>", "ExampleText",ExpressionUUID->"af67c0f5-a71f-4814-9213-abde3a582203"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"covers", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"FindBallCover", "[", 
        RowBox[{"g", ",", " ", "2", ",", " ", 
         RowBox[{"Method", " ", "->", " ", "method"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"method", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Exhaustive\>\"", ",", " ", "\"\<Greedy\>\"", ",", 
           " ", "\"\<Symmetric\>\""}], "}"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"InfraBall", "[", 
             RowBox[{"#", ",", " ", "2"}], "]"}], " ", "&"}], " ", "/@", " ", 
           "#"}]}], "]"}], " ", "&"}], " ", "/@", " ", "covers"}], "]"}], ",",
      " ", 
     RowBox[{"Length", " ", "/@", " ", "covers"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"61abe8a2-94ec-4c06-835f-57bbc5e28bf1"],

