Cell["FindBallCover", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"39e3863e-d249-4508-9154-3c7968f0d774"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindBallCover"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindBallCover", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0f5aefa-9b83-48b7-98f7-b4e21f3010c6"],
 "\[LineSeparator]",
 "gives a smallest list of centres whose balls of radius ",
 StyleBox["r", "TI"],
 " cover the vertices of ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5a1c3b9c-d01a-4382-9a18-0cb9f3b6ec13"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindBallCover"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindBallCover", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["target", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45d34575-3475-4f77-8e8b-c0ca59a93ab8"],
 "\[LineSeparator]",
 "gives a smallest list of centres in ",
 StyleBox["g", "TI"],
 " whose balls cover the vertices of ",
 StyleBox["target", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ca95deec-5fde-424d-a529-f3b5f036e45f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindBallCover"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindBallCover", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["target", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f68d475f-523d-4579-9c55-3bccacb36525"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["n", "TI"],
 " different smallest covers.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e71377ca-0396-4f72-baed-ac94b5d19f8c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindBallCover"]], 
