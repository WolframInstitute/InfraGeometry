Cell[BoxData[
 InterpretationBox[Cell[
  "Possible Issues", "ExampleSection",ExpressionUUID->
   "dda06a82-eb41-4b48-8510-6cb821647761"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell[TextData[{
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48b571bc-572a-4b9c-bc26-ddabfaa333ee"],
 " never places a centre at a vertex that every automorphism fixes. On a \
graph with no symmetry it finds no cover: it prints a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LinearOptimization"]], "paclet:ref/LinearOptimization"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3ccf5453-ea5c-471e-b395-e9e2f075603f"],
 " message and returns an empty list. The exhaustive cover of the discretized \
plane is drawn beside."
}], "ExampleText",ExpressionUUID->"a474bc40-6d6b-4e11-bc95-832d00866195"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraBall", "[", 
          RowBox[{"#", ",", " ", "2"}], "]"}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"FindBallCover", "[", 
         RowBox[{"g", ",", " ", "2"}], "]"}]}]}], "]"}], ",", " ", 
     RowBox[{"Quiet", " ", "@", " ", 
      RowBox[{"FindBallCover", "[", 
       RowBox[{"g", ",", " ", "2", ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<Symmetric\>\""}]}], "]"}]}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f7fad9cf-3999-4547-8867-76dbe8c2998d"],

