Cell[TextData[{
 "Definition: a list ",
 StyleBox["C", "TI"],
 " of vertices covers a set ",
 StyleBox["T", "TI"],
 " at radius ",
 StyleBox["r", "TI"],
 " when every ",
 StyleBox["t \[Element] T", "TI"],
 " has some ",
 StyleBox["c \[Element] C", "TI"],
 " with ",
 StyleBox["d(t, c) \[LessEqual] r", "TI"],
 ". A smallest such ",
 StyleBox["C", "TI"],
 " is a minimum ",
 StyleBox["r", "TI"],
 "-dominating set, and its size is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DominationNumber"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DominationNumber", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8bad3408-ded8-4227-8b23-430c60f70e9e"],
 ". The radius defaults to 1 and the targets to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3260fbd6-d6c7-4b5e-8bbb-e513a9c94d31"],
 "."
}], "Notes",ExpressionUUID->"1c1c8087-4d37-482b-9522-8c3b5d74fb00"],

Cell[TextData[{
 "Finding a smallest cover is NP-hard in general. Option ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Method"]], "paclet:ref/Method"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "21831fdb-570e-4e9c-80b0-e4123bce83ef"],
 " chooses how:"
}], "Notes",ExpressionUUID->"f99ef630-8815-4ca6-9099-5d2d9a7796d8"],

