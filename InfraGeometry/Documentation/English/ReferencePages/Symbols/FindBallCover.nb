b462289bb72c"],

Cell[TextData[{
 "With a count ",
 StyleBox["n", "TI"],
 " the smallest covers are found by testing every list of centres of the \
smallest size, which is feasible only on small graphs. Only ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e1a1179-e445-4dec-a528-e6fbcb34eea3"],
 " reads the count."
}], "Notes",ExpressionUUID->"a53632a0-00c5-4a9a-b5f7-03ae89302782"]
