Cell[CellGroupData[{

Cell["Method", "ExampleSubsection",ExpressionUUID->"5c5a3179-64bf-43cb-82c1-87ca14161ead"],

Cell["\<\
The three methods on the hexagonal tiling at radius 2. Only the exhaustive \
cover is smallest.\
\>", "ExampleText",ExpressionUUID->"38fd2b1f-908f-4ce8-a928-181bc014b1fd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"covers", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"FindBallCover", "[", 
        RowBox[{"g", ",", " ", "2", ",", " ", 
         RowBox[{"Method", " ", "->", " ", "method"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"method", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Exhaustive\>\"", ",", " ", "\"\<Greedy\>\"", ",", 
           " ", "\"\<Symmetric\>\""}], "}"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"InfraBall", "[", 
             RowBox[{"#", ",", " ", "2"}], "]"}], " ", "&"}], " ", "/@", " ", 
           "#"}]}], "]"}], " ", "&"}], " ", "/@", " ", "covers"}], "]"}], ",",
      " ", 
     RowBox[{"Length", " ", "/@", " ", "covers"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"8e994d6f-df89-48aa-9bf3-fad58782005b"],

