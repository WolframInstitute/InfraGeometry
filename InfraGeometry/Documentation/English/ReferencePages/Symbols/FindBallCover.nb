Cell[TextData[{
 "Definition: a list ",
 StyleBox["C", "TI"],
 " of vertices covers a set ",
 StyleBox["T", "TI"],
 " at radius ",
 StyleBox["r", "TI"],
 " when every ",
 StyleBox["t \[Element] T", "TI"],
 " has some ",
 StyleBox["c \[Element] C", "TI"],
 " with ",
 StyleBox["d(t, c) \[LessEqual] r", "TI"],
 ". A smallest such ",
 StyleBox["C", "TI"],
 " is a minimum ",
 StyleBox["r", "TI"],
 "-dominating set, and its size is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DominationNumber"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DominationNumber", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12a30b48-9773-4df0-8337-7fcfefc054b1"],
 ". The radius defaults to 1 and the targets to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fbbbbdc0-7021-48a3-9d87-742addf523dc"],
 "."
}], "Notes",ExpressionUUID->"92f2023f-d670-4448-80d0-4e74900a5616"],

Cell[TextData[{
 "Finding a smallest cover is NP-hard in general. Option ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Method"]], "paclet:ref/Method"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c8560eab-aea7-40f1-933f-79466b6731d5"],
 " chooses how:"
}], "Notes",ExpressionUUID->"cf23a373-f5ad-4e43-ae8a-e99644e9e364"],

