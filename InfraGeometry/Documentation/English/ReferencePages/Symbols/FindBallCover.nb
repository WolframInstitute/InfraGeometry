Cell["\<\
A smallest cover by balls of radius three on the plane mesh, square tiling \
and hexagonal tiling:\
\>", "ExampleText",ExpressionUUID->"42453236-d6b1-4e47-8640-2bdde1be26aa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"With", "[", "\n", "\t\t", 
     RowBox[{
      RowBox[{"{", " ", 
       RowBox[{"graph", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", " ", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
