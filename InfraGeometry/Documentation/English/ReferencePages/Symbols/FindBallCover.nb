Cell["\<\
A smallest cover by balls of radius 3, on the square grid and on the square \
mesh:\
\>", "ExampleText",ExpressionUUID->"7acf4e5f-29f0-46df-beab-b1028d67f27a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"InfraBall", "[", 
           RowBox[{"#", ",", " ", "3"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"FindBallCover", "[", 
          RowBox[{"g", ",", " ", "3"}], "]"}]}]}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"3e235e5c-ab3e-42a5-b2bf-9e02a87c43da"],

