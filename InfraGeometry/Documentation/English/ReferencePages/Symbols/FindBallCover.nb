Cell["\<\
The ball of radius 2 on the grid has 7 smallest covers by balls of radius 1. \
Three of them:\
\>", "ExampleText",ExpressionUUID->"a2988bf8-1e0d-4a3d-b3c9-306f197c3067"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{"cover", " ", "|->", " ", 
       RowBox[{"InfraSubstrateHighlight", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraBall", "[", 
            RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", "cover"}], "}"}]}],
         "]"}]}], ",", "\n", "    ", 
      RowBox[{"FindBallCover", "[", 
       RowBox[{"g", ",", " ", "1", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", "3"}], "]"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"94f2983e-534a-4dc0-9d83-e6f03f0a9b71"],

