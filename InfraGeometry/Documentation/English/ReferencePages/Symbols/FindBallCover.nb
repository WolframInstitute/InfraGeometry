  "8fdad008-cd7b-42d8-89aa-dcb2c0b09d3d"],
 "\[LineSeparator]",
 "gives all smallest covers."
}], "Usage",ExpressionUUID->"6298e167-fe78-4ba6-b671-d04b558043eb"],

Cell[TextData[{
 "A cover of ",
 StyleBox["T", "TI"],
 " at radius ",
 StyleBox["r", "TI"],
 " is a set ",
 StyleBox["C", "TI"],
 " of vertices with ",
 StyleBox["T \[SubsetEqual] \[Union] B\:1d63(c)", "TI"],
 ", ",
 StyleBox["c \[Element] C", "TI"],
 ". A smallest cover has ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallCoverNumber"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallCoverNumber", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ad3e2dc2-2c46-4809-b633-36f7f6d1bea3"],
 " centres. The centres may lie anywhere in ",
 StyleBox["g", "TI"],
 ", also outside the target."
}], "Notes",ExpressionUUID->"988c9c3a-a7bd-4565-b7a2-4bff9b4a0f2b"],

Cell[TextData[{
 "A smallest cover is not unique. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindBallCover"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindBallCover", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "21f9c887-d424-430f-b817-28604ab47ae7"],
 " gives one of them, with no preferred choice; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomBallCover"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomBallCover", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2ee0fb60-12c4-4348-a478-040cac567675"],
 " draws one uniformly."
}], "Notes",ExpressionUUID->"0b73adf7-2cee-4ed9-8c75-6fdfd6c3c700"],

Cell[TextData[{
 "The target can be a vertex, a vertex list, a density or a region such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c43ccc60-91bf-41c4-8c86-399f84ae2bcd"],
 ". Only its vertices count. It defaults to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8c7138bd-9444-4136-8933-779f9f55e919"],
 ", and the radius defaults to 1."
}], "Notes",ExpressionUUID->"30c2ad7f-f3d5-46ad-b9ce-13576f27a8d2"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 StyleBox["n", "TI"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UpTo"]], "paclet:ref/UpTo"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "81ac3b49-6fef-4818-bf57-85a494aa359c"],
 "[",
 StyleBox["n", "TI"],
 "] or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e4b97f51-5de9-4c98-8a40-72934f243c3f"],
 ". With a count the result is a list of covers, ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe5cf0e0-cade-493c-aeb5-9f938961c87d"],
 " when fewer than ",
 StyleBox["n", "TI"],
 " exist. An empty target has one cover, the empty list."
}], "Notes",ExpressionUUID->"c9ed2d39-d57c-4e28-87f1-76dd208e2050"],

