Cell["\<\
A smallest cover by balls of radius 3 of the discretized plane, the square \
tiling and the hexagonal tiling, each ball in its own colour.\
\>", "ExampleText",ExpressionUUID->"2af33771-5447-4db0-9889-ca4fe7bfe4a1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"InfraBall", "[", 
           RowBox[{"#", ",", " ", "3"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"FindBallCover", "[", 
          RowBox[{"g", ",", " ", "3"}], "]"}]}]}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"603a154d-ff5d-4b4c-bb9e-d887144b1417"],

