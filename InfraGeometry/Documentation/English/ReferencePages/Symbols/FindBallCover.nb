Cell["\<\
A smallest cover of the ball of radius 4 about the centre by balls of radius \
2. The target is drawn with the centres on top. On the mesh one centre lies \
outside the target:\
\>", "ExampleText",ExpressionUUID->"2f97a472-7690-4a6a-92ee-1cdc0f1f9e3b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"target", " ", "=", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{"c", ",", " ", "4"}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"cover", " ", "=", " ", 
        RowBox[{"FindBallCover", "[", 
         RowBox[{"g", ",", " ", "2", ",", " ", "target"}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"target", ",", " ", "cover"}], "}"}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"6066062c-2882-4534-8912-812742354da5"],

