Cell[TextData[{
 "With a count ",
 StyleBox["n", "TI"],
 " the smallest covers are found by testing every list of centres of the \
smallest size, which is feasible only on small graphs. Only ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5909642-1639-432e-bb59-fa19cf4fedc1"],
 " reads the count."
}], "Notes",ExpressionUUID->"b7aa498c-2582-4ec1-9273-2fce61de6bac"]
