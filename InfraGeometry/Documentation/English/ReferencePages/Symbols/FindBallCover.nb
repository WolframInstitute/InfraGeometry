Cell["\<\
The cycle with 9 vertices has three smallest covers by balls of radius 1, the \
three rotations of one:\
\>", "ExampleText",ExpressionUUID->"d4477104-241b-40cd-b772-287a50f43050"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FindBallCover", "[", 
  RowBox[{
   RowBox[{"CycleGraph", "[", "9", "]"}], ",", " ", "1", ",", " ", "All", ",",
    " ", "All"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5a1321a8-e6a4-483d-8ea5-0728c9813e2a"],

