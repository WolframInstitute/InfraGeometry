Cell[TextData[{
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "293d841e-fe83-42f0-991d-4cd565987baa"],
 " and ",
 Cell[BoxData["\"\<Symmetric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9079f500-fbdb-467b-aefc-ba85d9e9d3f8"],
 " ignore the count and return a single cover, not a list of covers."
}], "ExampleText",ExpressionUUID->"281f14c7-92ba-4636-9408-d124ee1302f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "6", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cover", " ", "=", " ", 
     RowBox[{"FindBallCover", "[", 
      RowBox[{
      "g", ",", " ", "1", ",", " ", "All", ",", " ", "All", ",", " ", 
       RowBox[{"Method", " ", "->", " ", "\"\<Greedy\>\""}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraBall", "[", 
          RowBox[{"#", ",", " ", "1"}], "]"}], " ", "&"}], " ", "/@", " ", 
        "cover"}]}], "]"}], ",", " ", "cover"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"897436f3-7b44-4f38-a765-dfaa7c521162"],

