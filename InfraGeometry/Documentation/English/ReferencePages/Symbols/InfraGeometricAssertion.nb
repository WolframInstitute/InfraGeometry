Cell[TextData[{
 "Two assertions about the centre ",
 StyleBox["a", "TI"],
 " of the square grid and a vertex ",
 StyleBox["b", "TI"],
 " at distance 4:"
}], "ExampleText",ExpressionUUID->"86350b10-cda9-4e5e-b4c9-40e41a523b0e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraGeometricTest", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraGeometricAssertion", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", " ", 
           RowBox[{"InfraSegment", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}]}], "}"}], ",", 
         " ", "\"\<Member\>\""}], "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"InfraGeometricTest", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraGeometricAssertion", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"b", ",", " ", 
           RowBox[{"InfraBall", "[", 
            RowBox[{"a", ",", " ", "3"}], "]"}]}], "}"}], ",", 
         " ", "\"\<Member\>\""}], "]"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4da96485-cc08-43c8-b7ce-4d2b6abc7254"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"715f5844-678c-460d-b352-4f1b57b79f57"]
}, Open  ]],

Cell[TextData[{
 "In a scene: the points ",
 StyleBox["p", "TI"],
 " of the circle of radius 4 about ",
 StyleBox["a", "TI"],
 " that are as far from ",
 StyleBox["b", "TI"],
 " as from ",
 StyleBox["a", "TI"],
 ". They are the apexes of the equilateral triangles on ",
 StyleBox["ab", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"f4bd5764-55ac-40a5-9689-714e2015a434"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", "p", "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"a", ",", " ", "4"}], "]"}], "]"}]}], ",", " ", 
         RowBox[{"InfraGeometricAssertion", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"a", ",", " ", "p"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"b", ",", " ", "p"}], "}"}]}], "}"}], ",", 
           " ", "\"\<EqualDistance\>\""}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"apexes", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraSceneInstance", "[", 
        RowBox[{"#", ",", " ", "p"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"RandomInfraSceneInstance", "[", 
       RowBox[{"scene", ",", " ", "g", ",", " ", "All"}], "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"b", ",", " ", "4"}], "]"}], ",", " ", "apexes", ",", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b"}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5df2b52c-1e7d-4a15-bfcc-0719a5a99c44"],

