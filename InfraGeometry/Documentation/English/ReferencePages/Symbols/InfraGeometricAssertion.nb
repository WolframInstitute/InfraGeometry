Cell[TextData[{
 "The assertion is symbolic. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraGeometricTest"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraGeometricTest", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "92ded40c-fe11-4b3e-a76e-650c96e6c113"],
 " decides it on a graph. In the hypotheses of an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b9dba6d1-fed4-4e45-b2ac-396bb143ff6c"],
 " the scene supplies the graph once the objects are bound, and keeps only \
the instances where the assertion holds."
}], "Notes",ExpressionUUID->"c5c7e151-51c5-4f72-a525-f1988a82b652"],

