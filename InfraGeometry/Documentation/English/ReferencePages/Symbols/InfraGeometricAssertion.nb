Cell["\<\
An unknown property is not decided, and the test stays unevaluated:\
\>", "ExampleText",ExpressionUUID->"7dd49d8d-3a6c-4593-b51f-1d5146fc878a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Head", " ", "@", " ", 
    RowBox[{"InfraGeometricTest", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraGeometricAssertion", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", " ", 
          RowBox[{"a", " ", "+", " ", "1"}]}], "}"}], ",", 
        " ", "\"\<Collinear\>\""}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"667c0ba3-900c-4e6e-9ac8-5e5a85e8c58f"],

