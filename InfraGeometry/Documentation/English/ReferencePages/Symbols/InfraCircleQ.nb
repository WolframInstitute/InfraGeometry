Cell["\<\
A cycle on part of a shell is not a circle. The boundary of a square face of \
the grid is a cycle, but not a shell:\
\>", "ExampleText",ExpressionUUID->"8aef5639-cb5a-49d1-82c1-733d73cc2840"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"square", " ", "=", " ", 
     RowBox[{"First", " ", "/@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindCycle", "[", 
        RowBox[{
         RowBox[{"NeighborhoodGraph", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"{", "4", "}"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"square", ",", " ", 
     RowBox[{"InfraCircleQ", "[", 
      RowBox[{"g", ",", " ", "square"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b4a2ef46-29e7-4946-8223-0cafb5a7087e"],

