      TextData["InfraCircleQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCircleQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["cycle", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ff55b24-dfb2-4d79-8526-f43d61f7d290"],
 " tests ",
 StyleBox["cycle", "TI"],
 " on the scene's graph."
}], "Notes",ExpressionUUID->"44f2e306-0d79-4dbd-b9cb-dac538b53c3d"]
}, Open  ]],

