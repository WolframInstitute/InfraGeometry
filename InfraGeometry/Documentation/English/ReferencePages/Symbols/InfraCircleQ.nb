Cell[CellGroupData[{
Cell["InfraCircleQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2e215ad2-9197-4948-a2d1-32a81d1036bf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircleQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCircleQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["cycle", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5ab6476-bc6e-4319-9536-47937659539a"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78074682-7351-4b3e-92ed-fdc28ee55833"],
 " if the closed walk ",
 StyleBox["cycle", "TI"],
 " is a circle of ",
 StyleBox["g", "TI"],
 ", and ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b083aba3-4f0a-4f8e-ba03-a550805491ee"],
 " otherwise.",
 "\n"
}], "Usage",ExpressionUUID->"b0451766-5caa-42b1-bdbe-b9dda7cb0210"],

Cell[TextData[{
 "A circle is a cycle whose vertex set is a shell ",
 StyleBox["S\:1d63(c) = {v : d(c, v) = r}", "TI"],
 ": the vertices are distinct, each is adjacent to the next and the last to \
the first, and together they are all the vertices at distance ",
 StyleBox["r", "TI"],
 " from some vertex ",
 StyleBox["c", "TI"],
 "."
}], "Notes",ExpressionUUID->"4aa82c2e-3f4b-4d69-ab2d-629d72a425f6"],

Cell[TextData[{
 "The cycle can be a vertex list, with or without the first vertex repeated \
at the end, or a cycle graph. A list of cycle graphs gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72953303-41b2-4a98-8515-420605e781ea"],
 " when every one is a circle."
}], "Notes",ExpressionUUID->"3a06a421-ccda-4856-9f1e-424cbd78f309"],

Cell[TextData[{
 "In the plane every sphere about a point is a circle. On a graph a shell \
need not be a cycle. On a bipartite graph such as the square grid, two \
vertices at the same distance from ",
 StyleBox["c", "TI"],
 " are never adjacent, so no cycle is a circle."
}], "Notes",ExpressionUUID->"03090fcf-98df-44cf-88e4-668aad40f84e"],

