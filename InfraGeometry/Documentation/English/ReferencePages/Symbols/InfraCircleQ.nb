Cell["On the grid the shell has no edges, so it carries no cycle:", \
"ExampleText",ExpressionUUID->"8a466e53-a4ea-4c67-a77a-5fa5301396cb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"shell", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraShell", "[", 
         RowBox[{"c", ",", " ", "3"}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"EdgeCount", " ", "@", " ", 
      RowBox[{"Subgraph", "[", 
       RowBox[{"g", ",", " ", "shell"}], "]"}]}], ",", " ", 
     RowBox[{"InfraCircleQ", "[", 
      RowBox[{"g", ",", " ", "shell"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"bc1581a2-fc17-4ff5-a3a2-09dbd62adfea"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"704a2ac5-b653-42eb-92f6-068329f396b5"]
}, Open  ]]
}, Open  ]],

