Cell["\<\
On the mesh the shell of radius 3 is a cycle, and the cycle is a circle:\
\>", "ExampleText",ExpressionUUID->"9f855957-ea46-4672-bd99-5f7da8a82223"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cycle", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"RandomInfraCircle", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCircle", "[", 
         RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "All"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraWalk", "[", 
        RowBox[{"Append", "[", 
         RowBox[{"cycle", ",", " ", 
          RowBox[{"First", " ", "@", " ", "cycle"}]}], "]"}], "]"}], ",", " ",
        "c"}], "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"InfraCircleQ", "[", 
       RowBox[{"g", ",", " ", "cycle"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c3a957c2-dc64-4ed6-a895-82365315b046"],

