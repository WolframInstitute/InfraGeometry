Cell["\<\
A 0-cochain, its coboundary and a cup on the triangular tiling, of degrees 0, \
1 and 2. The 0-cochain is the distance from the centre, drawn by its values; \
the 1-cochain is drawn by an arc along each edge in the direction in which it \
is positive; the 2-cochain, the cup of the coboundaries of the distances from \
the centre and from a vertex three steps away, is drawn on its triangles, \
blue where it is positive on the counterclockwise order of the corners and \
red where it is negative.\
\>", "ExampleText",ExpressionUUID->"48cca3ec-bbb4-46d5-961d-f05007a01df8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"center", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
     RowBox[{"positions", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"apex", " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"FindInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"center", ",", " ", "3"}], "]"}]}], "]"}]}], ")"}]}], ",", 
     " ", 
     RowBox[{"cochain", " ", "=", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "center", ",", " ", 
           RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
        RowBox[{"List", " ", "/@", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"edgeCochain", " ", "=", " ", 
     RowBox[{"Coboundary", "[", 
      RowBox[{"g", ",", " ", "cochain"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"triangleCochain", " ", "=", " ", 
     RowBox[{"CochainCup", "[", 
      RowBox[{"g", ",", " ", "edgeCochain", ",", " ", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"AssociationMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "apex", ",", " ", 
              RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
           RowBox[{"List", " ", "/@", " ", 
            RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\n", "     ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"KeyMap", "[", 
           RowBox[{"First", ",", " ", "cochain"}], "]"}]}], "]"}], ",", "\n", 
        "     ", 
        RowBox[{"DisplacementPlot", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"GroupBy", "[", 
           RowBox[{
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"Keys", " ", "@", " ", 
               RowBox[{"Select", "[", 
                RowBox[{"edgeCochain", ",", " ", "Positive"}], "]"}]}], ",", 
              " ", 
              RowBox[{"Reverse", " ", "/@", " ", 
               RowBox[{"Keys", " ", "@", " ", 
                RowBox[{"Select", "[", 
                 RowBox[{"edgeCochain", ",", " ", "Negative"}], "]"}]}]}]}], 
             "]"}], ",", " ", 
            RowBox[{"First", " ", "->", " ", "Last"}]}], "]"}]}], "]"}], ",", 
        "\n", "     ", 
        RowBox[{"Show", "[", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{"KeyValueMap", "[", "\n", "       ", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"triangle", ",", " ", "value"}], "}"}], " ", "|->", 
              " ", 
              RowBox[{"{", "\n", "         ", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"value", " ", 
                    RowBox[{"Det", "[", 
                    RowBox[{"Differences", "[", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"positions", ",", " ", "triangle"}], "]"}], "]"}],
                     "]"}]}], " ", ">", " ", "0"}], ",", " ", "StandardBlue", 
                  ",", " ", "StandardRed"}], "]"}], ",", "\n", "         ", 
                RowBox[{"Polygon", "[", 
                 RowBox[{"Lookup", "[", 
                  RowBox[{"positions", ",", " ", "triangle"}], "]"}], "]"}]}],
                "}"}]}], ",", "\n", "       ", "triangleCochain"}], "]"}], 
           "]"}], ",", " ", "g"}], "]"}]}], "}"}], "]"}], ",", "\n", "   ", 
     RowBox[{"CochainDegree", " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{
       "cochain", ",", " ", "edgeCochain", ",", " ", "triangleCochain"}], 
       "}"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"22339da2-ba96-4390-830d-33caa78607ff"],

