Cell["\<\
The empty cochain has no degree, and the call stays unevaluated. On the \
square grid, which has no triangles, the cup of two 1-cochains is empty:\
\>", "ExampleText",ExpressionUUID->"16a323eb-cc8c-4829-ae64-2ce1da658aea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"List", " ", "/@", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{"y", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"List", " ", "/@", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cup", " ", "=", " ", 
     RowBox[{"CochainCup", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", "x"}], "]"}], ",", " ", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", "y"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"cup", ",", " ", 
     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"CochainDegree", "[", "cup", "]"}]}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"fa7a6046-5b6a-4ba1-95d5-93527b94b97d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}], ",", 
   "CochainDegree"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f6200051-14d7-46cb-9c02-680787b4c4c3"]
}, Open  ]],

