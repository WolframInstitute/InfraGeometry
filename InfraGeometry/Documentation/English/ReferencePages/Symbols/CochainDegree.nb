   "dda06a82-eb41-4b48-8510-6cb821647761"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell[TextData[{
 "The empty cochain has no key to read. The coboundary of a coboundary is \
empty, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainDegree"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainDegree", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ccdd5634-3326-4c61-925e-db07c4e240f3"],
 " of it issues a message and returns 0; the call is wrapped in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Quiet"]], "paclet:ref/Quiet"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "781a36c2-8df0-4ea9-907e-8041e96417ef"],
 " here."
}], "ExampleText",ExpressionUUID->"f225287c-a181-4bef-aa36-9bf470df8336"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"edgeCochain", " ", "=", " ", 
     RowBox[{"Coboundary", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"AssociationMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", 
            RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
         RowBox[{"List", " ", "/@", " ", 
          RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"GroupBy", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Keys", " ", "@", " ", 
            RowBox[{"Select", "[", 
             RowBox[{"edgeCochain", ",", " ", "Positive"}], "]"}]}], ",", " ", 
           RowBox[{"Reverse", " ", "/@", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"Select", "[", 
              RowBox[{"edgeCochain", ",", " ", "Negative"}], "]"}]}]}]}], 
          "]"}], ",", " ", 
         RowBox[{"First", " ", "->", " ", "Last"}]}], "]"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", "edgeCochain"}], "]"}]}], ",", " ", 
     RowBox[{"Quiet", " ", "@", " ", 
      RowBox[{"CochainDegree", "[", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", "edgeCochain"}], "]"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a9d67f0f-8e7d-403c-b5f3-eb2f4cf2b6fd"],

