Cell[TextData[{
 "A 0-cochain, its coboundary and a cup product on the square mesh: the \
distance ",
 StyleBox["f", "TI"],
 " from the centre, ",
 StyleBox["\[Delta]f", "TI"],
 ", and ",
 StyleBox["\[Delta]f \:222a \[Delta]y", "TI"],
 " for the coordinate ",
 StyleBox["y", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"9e246b00-3856-4b63-ab1c-44ca103b8fd7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"List", " ", "/@", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], ",", 
     "\n", "   ", 
     RowBox[{"y", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"List", " ", "/@", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"CochainDegree", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"f", ",", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", "f"}], "]"}], ",", " ", 
      RowBox[{"CochainCup", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"Coboundary", "[", 
         RowBox[{"g", ",", " ", "f"}], "]"}], ",", " ", 
        RowBox[{"Coboundary", "[", 
         RowBox[{"g", ",", " ", "y"}], "]"}]}], "]"}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c57f58ba-a0f2-4a32-ba5d-bb0a67e8bf5d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "1", ",", "2"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"5221e0c6-0116-4d1b-a3f3-66af8d4a01ea"]
}, Open  ]]
}, Open  ]],

