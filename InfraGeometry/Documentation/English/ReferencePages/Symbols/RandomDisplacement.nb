Cell[TextData[{
 "The steps have length at most ",
 StyleBox["r", "TI"],
 ", not exactly ",
 StyleBox["r", "TI"],
 ". At ",
 StyleBox["r", "TI"],
 " = 2 most steps have length 2 and some have length 1, so the displacement \
is not a section of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDisplacementBundle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", "2"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c26cb6e3-6851-4b8e-9941-6ed416f66d3f"],
 ", whose sections move every vertex by exactly 2; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9deffcbe-2ebf-4be4-859f-6151de8c5c7b"],
 " draws such a section, continuous or not. The counts of the step lengths:"
}], "ExampleText",ExpressionUUID->"5ca477cb-ea7f-4248-84de-dc68876f3036"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"field", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomDisplacement", "[", 
        RowBox[{"g", ",", " ", "2"}], "]"}]}], ")"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", "field"}], "]"}], ",", " ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"Counts", "[", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "#1", ",", " ", 
             RowBox[{"First", "[", "#2", "]"}]}], "]"}], " ", "&"}], ",", " ",
           "field"}], "]"}], "]"}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c130ab45-9bd9-4a3d-b928-f9b54777cfb8"],

