Notebook[{

Cell[CellGroupData[{
Cell["RandomDisplacement", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3ecdde29-0b34-4ea6-a4fb-0213f405943f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomDisplacement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomDisplacement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f87cb4e7-dfff-4d5b-baa3-b125351417d6"],
 "\[LineSeparator]",
 "gives a random 1-continuous single-valued displacement of ",
 StyleBox["g", "TI"],
 " of magnitude at most ",
 StyleBox["r", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2cbfb710-2220-4fdc-8475-7d0517b5b040"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomDisplacement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomDisplacement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d535bb5-dddb-415c-85fa-82a7e947e054"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["r", "TI"],
 " = 1."
}], "Usage",ExpressionUUID->"9c10f6c8-ef44-4a9f-b048-7128e5c8c99a"],

Cell[TextData[{
 "The result ",
 StyleBox["D", "TI"],
 " has one value at each vertex, every step has length at most ",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["d(v, D(v)) \[LessEqual] r", "TI"],
 ", and ",
 StyleBox["D", "TI"],
 " is 1-continuous: the values at the ends of every edge are at most one step \
apart (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ContinuousDisplacementQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ContinuousDisplacementQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3f42e2ee-2269-4ac9-9a8a-47521fac7661"],
 "). It is the discrete counterpart of the flow of a random smooth vector \
field."
}], "Notes",ExpressionUUID->"e756d7aa-0aa8-4c97-bc7d-0fc687098501"],

Cell[TextData[{
 "The steps are not all of length ",
 StyleBox["r", "TI"],
 ". So the result is in general not a section of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDisplacementBundle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a2c8dfe-3022-4963-8251-96deb6a8e1fe"],
 ", whose sections move every vertex by exactly ",
 StyleBox["r", "TI"],
 "; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "468c98eb-4a91-44b2-a669-ef301d6ad473"],
 " draws those."
}], "Notes",ExpressionUUID->"9a015864-9e73-4d4d-aba7-7c2d657fc196"],

Cell["\<\
A random choice that is not 1-continuous is repaired a bounded number of \
times. When the repair fails, the call stays unevaluated.\
\>", "Notes",ExpressionUUID->"488b362c-20c9-4140-b5a2-1b1ddc0d934f"],

Cell["Options:", "Notes",ExpressionUUID->"9ca27afb-2e33-4cac-9fdc-783ea676269c"],

