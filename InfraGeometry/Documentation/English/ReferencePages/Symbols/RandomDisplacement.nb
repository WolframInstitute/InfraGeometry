Cell["The bounds 1, 2 and 3 on the grid, each with its magnitude:", \
"ExampleText",ExpressionUUID->"717a633f-ae29-4f72-b978-0d46b2ee6d23"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"d", " ", "=", " ", 
          RowBox[{"RandomDisplacement", "[", 
           RowBox[{"g", ",", " ", "r", ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], 
        ",", "\n", "      ", 
        RowBox[{"DisplacementPlot", "[", 
         RowBox[{"g", ",", " ", "d", ",", " ", 
          RowBox[{"PlotLabel", " ", "->", " ", 
           RowBox[{"DisplacementMagnitude", "[", 
            RowBox[{"g", ",", " ", "d"}], "]"}]}]}], "]"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"973f3335-ea97-475a-8b8b-bdb33bc83fda"],

