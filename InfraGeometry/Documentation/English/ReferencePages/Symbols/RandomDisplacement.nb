Notebook[{

Cell[CellGroupData[{
Cell["RandomDisplacement", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"38d3b949-03ee-45d2-b728-53e62cd9df8f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomDisplacement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomDisplacement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04253bb1-bf1e-4c90-92a0-2341b435e80e"],
 "\[LineSeparator]",
 "gives a random single-valued displacement of magnitude at most ",
 StyleBox["r", "TI"],
 ", built to be 1-continuous.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"68fbb887-f098-4c0e-a432-6d3ffd3db8b4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomDisplacement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomDisplacement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99570108-3ba9-417e-8043-292ce394b157"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["r", "TI"],
 " = 1."
}], "Usage",ExpressionUUID->"75af2c98-1c32-47ca-8782-f1fc0ac2f42c"],

Cell[TextData[{
 "Construction: the vertices are visited in breadth-first order from the \
first vertex of ",
 StyleBox["g", "TI"],
 ". Each takes a random vertex of its ball of radius ",
 StyleBox["r", "TI"],
 " that lies within one step of the targets already given to its neighbours, \
or, when there is none, a vertex of the ball that brings it closest to them. \
Then the vertices of every edge whose targets are more than one step apart \
are given new targets, closest to their neighbours' targets and to \
themselves, up to 50 times; the whole construction is tried up to 5 times."
}], "Notes",ExpressionUUID->"fdffc649-2c4c-467f-af6d-a3771d21720c"],

Cell[TextData[{
 "The result is single-valued and has magnitude at most ",
 StyleBox["r", "TI"],
 ". It is 1-continuous (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ContinuousDisplacementQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ContinuousDisplacementQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3e0250c1-fc3e-4c0e-907c-cf7287dc0684"],
 ") when the repair succeeds, which it does at small ",
 StyleBox["r", "TI"],
 "; it is not guaranteed."
}], "Notes",ExpressionUUID->"59b44a3c-0e46-47a0-b6b9-83245d6a836d"],

Cell[TextData[{
 "The construction draws with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomChoice"]], "paclet:ref/RandomChoice"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5dfeea42-696e-46f2-8e0e-ee6c12b73a67"],
 ", so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "83c43bb1-c588-4d85-b644-1157f8ad6fd1"],
 " fixes the result."
}], "Notes",ExpressionUUID->"2994556d-0752-4231-9cc3-a304a5194c51"]
}, Open  ]],

