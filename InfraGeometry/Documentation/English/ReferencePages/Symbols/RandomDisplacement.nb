     Cell[BoxData["Inherited"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5644c443-f648-42c1-b564-c2576686f687"],
     " to draw from the current random state"
    }], "TableText",ExpressionUUID->"38cae88b-2301-4722-a1c2-1ebc4056dade"]}
  }]], "3ColumnTableMod",ExpressionUUID->"ccacfb2b-507c-4a23-9edd-\
235e03f68f86"],

Cell[TextData[{
 "With the default every call draws afresh, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0fb9d218-1ded-4f75-b95b-b37990275f59"],
 " does not fix the result."
}], "Notes",ExpressionUUID->"3fc8210e-84a1-4b4e-961b-a812399c0a8f"]
}, Open  ]],

