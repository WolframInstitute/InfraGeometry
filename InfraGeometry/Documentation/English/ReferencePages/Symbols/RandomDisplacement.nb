Cell["\<\
The construction can fail. At magnitude 3 on the hexagonal tiling the repair \
does not always remove every discontinuity, and the result is not \
1-continuous.\
\>", "ExampleText",ExpressionUUID->"b5a645f3-54e5-41a3-9ff6-bd1814d750be"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"field", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomDisplacement", "[", 
        RowBox[{"g", ",", " ", "3"}], "]"}]}], ")"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", "field"}], "]"}], ",", " ", 
     RowBox[{"ContinuousDisplacementQ", "[", 
      RowBox[{"g", ",", " ", "field"}], "]"}], ",", " ", 
     RowBox[{"DisplacementMagnitude", "[", 
      RowBox[{"g", ",", " ", "field"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5fefc022-a6c1-4890-910b-54373a958f74"],

