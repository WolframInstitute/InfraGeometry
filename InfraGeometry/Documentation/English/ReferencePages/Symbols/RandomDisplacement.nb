Cell[TextData[{
 "A random displacement is single-valued, has magnitude at most ",
 StyleBox["r", "TI"],
 ", and here is 1-continuous."
}], "ExampleText",ExpressionUUID->"1e286a9b-4abf-4ae2-9f1c-7ac6bcd85cb5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"field", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomDisplacement", "[", 
        RowBox[{"g", ",", " ", "2"}], "]"}]}], ")"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", "field"}], "]"}], ",", " ", 
     RowBox[{"DisplacementSingleValuedQ", "[", "field", "]"}], ",", " ", 
     RowBox[{"DisplacementMagnitude", "[", 
      RowBox[{"g", ",", " ", "field"}], "]"}], ",", " ", 
     RowBox[{"ContinuousDisplacementQ", "[", 
      RowBox[{"g", ",", " ", "field"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0c8ee624-4112-460c-8de6-1e149b45bf6c"],

