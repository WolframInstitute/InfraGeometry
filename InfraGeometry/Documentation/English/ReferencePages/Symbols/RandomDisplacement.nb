Cell[TextData[{
 "The repair can fail, and the call then stays unevaluated. On the hexagonal \
tiling at ",
 StyleBox["r", "TI"],
 " = 3, six of the seeds 1 to 10 fail:"
}], "ExampleText",ExpressionUUID->"c697c912-e49b-40f2-9814-daea54b742fd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"RandomDisplacement", "[", 
       RowBox[{"g", ",", " ", "3", ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "seed"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"seed", ",", " ", "10"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8c48d868-5a21-4a7e-9d1b-c3ec31693cce"],

