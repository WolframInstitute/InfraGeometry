   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cc841562-45d7-466f-8846-b8a66c18ace8"],
 " is inert: it names a vertex and does not evaluate. Its first argument is \
the base vertex, its second the position in the fiber."
}], "Notes",ExpressionUUID->"d6c2ada2-2101-474b-8e56-7480bf5daedd"],

Cell[TextData[{
 "The fiber over ",
 StyleBox["v", "TI"],
 " is the set of vertices that match ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflatedVertex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflatedVertex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", "_"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e4b2069-ae80-4a00-b5b0-b7deced52eee"],
 ", and the projection onto the base graph replaces ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflatedVertex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflatedVertex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", "_"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48e68736-bbac-4f83-8c61-775bcd882622"],
 " by ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"189241e1-c557-410c-88a5-cb0bc19953d4"],

Cell[TextData[{
 "Inflating an inflated graph nests the names: the fiber over ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflatedVertex"]], 
