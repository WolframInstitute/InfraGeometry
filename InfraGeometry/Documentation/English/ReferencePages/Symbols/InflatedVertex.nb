Cell["Inflating twice nests the names.", "ExampleText",ExpressionUUID->"b39031db-7f24-4385-896b-4084470e9f03"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InflateGraph", "[", 
        RowBox[{
         RowBox[{"InflateGraph", "[", 
          RowBox[{
           RowBox[{"CycleGraph", "[", "3", "]"}], ",", " ", 
           RowBox[{"\"\<ExtraVertices\>\"", " ", "->", " ", "1"}]}], "]"}], ",",
          " ", 
         RowBox[{"\"\<ExtraVertices\>\"", " ", "->", " ", "1"}]}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", ",", " ", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "inflated", "]"}], ",", " ", 
       RowBox[{"InflatedVertex", "[", 
        RowBox[{"_InflatedVertex", ",", " ", "_"}], "]"}]}], "]"}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"35eb68f8-3f31-4591-83bf-60421a6f2248"],

