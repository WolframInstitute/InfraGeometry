Cell["\<\
Collapsing every fiber onto its base vertex gives the base graph back, up to \
loops and repeated edges, when the fibers reach radius 1.\
\>", "ExampleText",ExpressionUUID->"913a6c7e-ec93-49a8-8439-0f700ebdee16"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InflateGraph", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"\"\<ExtraVertices\>\"", " ", "->", " ", "2"}]}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"collapsed", " ", "=", " ", 
     RowBox[{"SimpleGraph", " ", "@", " ", 
      RowBox[{"VertexReplace", "[", 
       RowBox[{"inflated", ",", " ", 
        RowBox[{
         RowBox[{"InflatedVertex", "[", 
          RowBox[{"v_", ",", " ", "_"}], "]"}], " ", ":>", " ", "v"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"collapsed", ",", " ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"EdgeList", "[", "collapsed", "]"}], "]"}], " ", "===", " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"EdgeList", "[", "g", "]"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5d96db96-56df-40c5-8cd9-1ec011bb58d2"],

