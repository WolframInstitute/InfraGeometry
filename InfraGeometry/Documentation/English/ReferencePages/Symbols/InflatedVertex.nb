Cell["The fiber sizes, drawn between none and three.", "ExampleText",ExpressionUUID->"b2e08420-8473-4870-867a-fb399c8de14c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InflateGraph", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "3"}], "}"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sizes", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"Cases", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "inflated", "]"}], ",", " ", 
          RowBox[{"InflatedVertex", "[", 
           RowBox[{"v", ",", " ", "_"}], "]"}]}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"v", ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Histogram", "[", 
      RowBox[{"sizes", ",", " ", 
       RowBox[{"{", "1", "}"}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<fiber size\>\"", ",", " ", "\"\<vertices\>\""}], 
         "}"}]}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Counts", "[", "sizes", "]"}], " ", "//", " ", "KeySort"}], 
      " ", "//", " ", "Normal"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"985b2d6f-e616-4170-af41-799d7e6f6137"],

