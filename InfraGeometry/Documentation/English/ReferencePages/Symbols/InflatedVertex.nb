Cell["\<\
The name does not evaluate; its arguments are the base vertex and the \
position in the fiber.\
\>", "ExampleText",ExpressionUUID->"541fd3a9-4cf7-43dd-890f-589b65a223d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "6", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InflateGraph", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"\"\<ExtraVertices\>\"", " ", "->", " ", "1"}]}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", ",", " ", 
     RowBox[{"InflatedVertex", "[", 
      RowBox[{"1", ",", " ", "1"}], "]"}], ",", " ", 
     RowBox[{"First", " ", "/@", " ", 
      RowBox[{"Cases", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "inflated", "]"}], ",", " ", 
        "_InflatedVertex"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"596c8f29-6ffb-4048-a7f1-e8856ab93088"],

