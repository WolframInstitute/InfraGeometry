Cell["\<\
The projection onto the base gives the grid back, once loops and repeated \
edges are removed:\
\>", "ExampleText",ExpressionUUID->"a7d36cb2-bdac-46d9-88f9-eb0031f2a2ba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"BlockRandom", "[", 
      RowBox[{
       RowBox[{"InflateGraph", "[", 
        RowBox[{"g", ",", " ", "2", ",", " ", 
         RowBox[{"\"\<VerticalEdges\>\"", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\"\<HorizontalEdges\>\"", " ", "->", " ", "2"}]}], "]"}], ",",
        " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"EdgeList", " ", "@", " ", 
      RowBox[{"SimpleGraph", " ", "@", " ", 
       RowBox[{"VertexReplace", "[", 
        RowBox[{"inflated", ",", " ", 
         RowBox[{
          RowBox[{"InflatedVertex", "[", 
           RowBox[{"v_", ",", " ", "_"}], "]"}], " ", ":>", " ", "v"}]}], 
        "]"}]}]}]}], " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"EdgeList", "[", "g", "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fe9e1c8d-ca3a-416f-81b1-8bcd56681647"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f110df0a-99dd-4b2e-b719-3be3cc152b08"]
}, Open  ]],

Cell["\<\
Inflating twice nests the names over the new vertices and numbers on over the \
old ones:\
\>", "ExampleText",ExpressionUUID->"8fac5015-55cc-48e1-915a-50ac748e9ab9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"InflateGraph", "[", 
      RowBox[{"InflateGraph", "[", 
       RowBox[{"CycleGraph", "[", "3", "]"}], "]"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "inflated", "]"}], ",", " ", 
       RowBox[{"InflatedVertex", "[", 
        RowBox[{"_InflatedVertex", ",", " ", "_"}], "]"}]}], "]"}], ",", " ", 
     
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "inflated", "]"}], ",", " ", 
       RowBox[{"InflatedVertex", "[", 
        RowBox[{"1", ",", " ", "_"}], "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9ede6d6e-dfa7-4798-a609-0d8d9d400497"],

Cell[BoxData[
 RowBox[{"{", 
