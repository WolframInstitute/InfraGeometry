Cell["\<\
Collapsing every fiber onto its base vertex gives the base graph back, up to \
loops and repeated edges: a spoke and a vertical edge collapse to a loop, a \
horizontal edge onto the edge below it.\
\>", "ExampleText",ExpressionUUID->"fd50e32c-26e2-413b-b256-e51ea419b9be"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InflateGraph", "[", 
        RowBox[{"g", ",", " ", "2", ",", " ", 
         RowBox[{"\"\<VerticalEdges\>\"", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\"\<HorizontalEdges\>\"", " ", "->", " ", "2"}]}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"collapsed", " ", "=", " ", 
     RowBox[{"SimpleGraph", " ", "@", " ", 
      RowBox[{"VertexReplace", "[", 
       RowBox[{"inflated", ",", " ", 
        RowBox[{
         RowBox[{"InflatedVertex", "[", 
          RowBox[{"v_", ",", " ", "_"}], "]"}], " ", ":>", " ", "v"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"collapsed", ",", " ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"EdgeList", "[", "collapsed", "]"}], "]"}], " ", "===", " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"EdgeList", "[", "g", "]"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b992ee8c-95f7-41a5-a7fd-5346a235af37"],

