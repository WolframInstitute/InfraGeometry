Cell["\<\
The fiber over the centre of the discretized plane, the square tiling and the \
hexagonal tiling, inflated with two new vertices over every vertex.\
\>", "ExampleText",ExpressionUUID->"e1271899-399f-470e-a145-672eab8230ea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"inflated", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"InflateGraph", "[", 
           RowBox[{"g", ",", " ", "2"}], "]"}]}], ")"}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"inflated", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "inflated", "]"}], ",", " ", 
            RowBox[{"InflatedVertex", "[", 
             RowBox[{"c", ",", " ", "_"}], "]"}]}], "]"}], ",", " ", "c"}], 
         "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"831d98a2-aa61-4c79-a259-6a6bc799f3b7"],

