Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InflatedVertex"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InflatedVertex", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "392a2be6-61b5-4149-b98c-7fe1df0fc1cb"],
 " is inert: it names a vertex and does not evaluate."
}], "Notes",ExpressionUUID->"1637d864-9ffb-422f-af4d-d58576056d70"],

Cell[TextData[{
 "The fiber ",
 StyleBox["F(v)", "TI"],
 " over ",
 StyleBox["v", "TI"],
 " is the set of the vertices ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflatedVertex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflatedVertex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["i", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "657d6119-a5e9-44e6-89ef-46a465641e99"],
 ". The projection ",
 StyleBox["\[Pi]", "TI"],
 " onto the base graph sends ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflatedVertex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflatedVertex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["i", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f095fec1-f969-4142-9e23-e302c32005e2"],
 " to ",
 StyleBox["v", "TI"],
 " and fixes the vertices of the base."
}], "Notes",ExpressionUUID->"dcb09207-73ff-4581-bcdc-ab8d4d5fa0a3"],

Cell[TextData[{
 StyleBox["\[Pi]", "TI"],
 " maps every edge to an edge of the base or to a loop: a spoke and a \
vertical edge collapse to a loop at ",
 StyleBox["v", "TI"],
 ", a horizontal edge onto the edge below it."
}], "Notes",ExpressionUUID->"067c37f4-9683-48cd-ab60-8aec4cb797d6"],

Cell[TextData[{
 "Inflating an inflated graph nests the names: the fiber over ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflatedVertex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflatedVertex", 
