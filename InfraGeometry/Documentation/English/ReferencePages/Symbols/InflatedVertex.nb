        RowBox[{"neighbours", ",", " ", 
         RowBox[{"InflatedVertex", "[", 
          RowBox[{"15", ",", " ", "1"}], "]"}]}], "}"}]}], "]"}], ",", " ", 
     "neighbours"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b2780373-d552-487f-8243-63bc988b8480"],

