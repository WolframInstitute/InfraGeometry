Cell["\<\
The neighbours of a new vertex over a vertex of the 6 \[Times] 6 grid: its \
base vertex and, drawn at random, vertices nearby or new vertices over them.\
\>", "ExampleText",ExpressionUUID->"13da4698-0ea6-4eda-ae66-4bfbfd1bdac2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InflateGraph", "[", 
        RowBox[{
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"6", ",", " ", "6"}], "}"}], "]"}], ",", " ", 
         RowBox[{"\"\<ExtraVertices\>\"", " ", "->", " ", "2"}]}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"neighbours", " ", "=", " ", 
     RowBox[{"AdjacencyList", "[", 
      RowBox[{"inflated", ",", " ", 
       RowBox[{"InflatedVertex", "[", 
        RowBox[{"15", ",", " ", "1"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"inflated", ",", " ", 
       RowBox[{"{", 
        RowBox[{"neighbours", ",", " ", 
         RowBox[{"InflatedVertex", "[", 
          RowBox[{"15", ",", " ", "1"}], "]"}]}], "}"}]}], "]"}], ",", " ", 
     "neighbours"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8e30fdad-9a5a-4110-8722-164b244f8555"],

