Cell["\<\
Inflating twice nests the names over the new vertices and numbers on over the \
vertices of the triangle.\
\>", "ExampleText",ExpressionUUID->"06f07c64-a4df-4228-b6a9-8f22b930ec37"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"InflateGraph", "[", 
      RowBox[{"InflateGraph", "[", 
       RowBox[{"CycleGraph", "[", "3", "]"}], "]"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", ",", " ", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "inflated", "]"}], ",", " ", 
       RowBox[{"InflatedVertex", "[", 
        RowBox[{"_InflatedVertex", ",", " ", "_"}], "]"}]}], "]"}], ",", " ", 
     
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "inflated", "]"}], ",", " ", 
       RowBox[{"InflatedVertex", "[", 
        RowBox[{"1", ",", " ", "_"}], "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"b30d4110-fab9-473a-ac7e-54a17de54e57"],

