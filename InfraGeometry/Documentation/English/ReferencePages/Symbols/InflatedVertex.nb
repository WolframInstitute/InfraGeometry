  "dd34e4c9-aff8-4621-96b8-da5040ad931a"],
 " has the vertices ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflatedVertex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflatedVertex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
