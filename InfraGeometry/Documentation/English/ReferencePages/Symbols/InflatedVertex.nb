Cell["The fiber sizes, drawn between none and three.", "ExampleText",ExpressionUUID->"4fa2cbd4-2280-4579-a080-636366c5b57c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InflateGraph", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"\"\<ExtraVertices\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "3"}], "}"}]}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sizes", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"Cases", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "inflated", "]"}], ",", " ", 
          RowBox[{"InflatedVertex", "[", 
           RowBox[{"v", ",", " ", "_"}], "]"}]}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"v", ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Histogram", "[", 
      RowBox[{"sizes", ",", " ", 
       RowBox[{"{", "1", "}"}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<fiber size\>\"", ",", " ", "\"\<vertices\>\""}], 
         "}"}]}]}], "]"}], ",", " ", 
     RowBox[{
