Cell["\<\
The neighbours of a new vertex over a vertex of the 6 \[Times] 6 grid: its \
base vertex, a vertex of its own fiber, and new vertices over the neighbours \
of its base vertex, drawn at random.\
\>", "ExampleText",ExpressionUUID->"08f76547-c1c7-4215-84e6-febdcab3c517"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InflateGraph", "[", 
        RowBox[{
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"6", ",", " ", "6"}], "}"}], "]"}], ",", " ", "2", ",", 
         " ", 
         RowBox[{"\"\<VerticalEdges\>\"", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\"\<HorizontalEdges\>\"", " ", "->", " ", "2"}]}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"neighbours", " ", "=", " ", 
     RowBox[{"AdjacencyList", "[", 
      RowBox[{"inflated", ",", " ", 
       RowBox[{"InflatedVertex", "[", 
        RowBox[{"15", ",", " ", "1"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
