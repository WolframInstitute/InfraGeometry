Cell["\<\
The neighbours of a new vertex over the centre of the grid: its base vertex, \
a vertex of its own fiber and new vertices over the neighbours of the centre:\
\
\>", "ExampleText",ExpressionUUID->"94660ecf-b5e7-4b03-b243-132d20afa801"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"BlockRandom", "[", 
      RowBox[{
       RowBox[{"InflateGraph", "[", 
        RowBox[{"g", ",", " ", "2", ",", " ", 
         RowBox[{"\"\<VerticalEdges\>\"", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\"\<HorizontalEdges\>\"", " ", "->", " ", "2"}]}], "]"}], ",",
        " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"AdjacencyList", "[", 
    RowBox[{"inflated", ",", " ", 
     RowBox[{"InflatedVertex", "[", 
      RowBox[{"c", ",", " ", "1"}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"28ec00a6-aa79-4414-b83d-2442b9b412a8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"45", ",", 
   RowBox[{"InflatedVertex", "[", 
    RowBox[{"35", ",", "1"}], "]"}], ",", 
   RowBox[{"InflatedVertex", "[", 
    RowBox[{"44", ",", "1"}], "]"}], ",", 
   RowBox[{"InflatedVertex", "[", 
    RowBox[{"45", ",", "2"}], "]"}], ",", 
   RowBox[{"InflatedVertex", "[", 
    RowBox[{"46", ",", "1"}], "]"}], ",", 
   RowBox[{"InflatedVertex", "[", 
    RowBox[{"46", ",", "2"}], "]"}], ",", 
   RowBox[{"InflatedVertex", "[", 
    RowBox[{"55", ",", "1"}], "]"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"c257d83f-9d18-437d-a44b-968842ccd0c7"]
}, Open  ]]
}, Open  ]],

