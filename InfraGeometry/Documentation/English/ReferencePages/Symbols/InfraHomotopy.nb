Cell["The two routes across a filled triangle:", "ExampleText",ExpressionUUID->"c89603e2-d737-4881-91ad-ee8a36b39e04"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "3", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"homotopy", " ", "=", " ", 
     RowBox[{"InfraHomotopy", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"HomotopyMoveTypes", "[", 
    RowBox[{"FindInfraHomotopy", "[", 
     RowBox[{"g", ",", " ", "homotopy"}], "]"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"be784c43-24fd-43c1-b849-e55e2450d858"],

Cell[BoxData[
 RowBox[{"{", "\<\"Contract\"\>", "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"08af1d68-0a04-4ce3-913d-cf088af1f82b"]
}, Open  ]],

Cell["Fill a square to connect its two routes:", "ExampleText",ExpressionUUID->"0d2d0f8f-391e-4566-88dd-96dbc229ea7e"],

Cell[CellGroupData[{

