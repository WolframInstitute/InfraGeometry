Cell["\<\
In a scene the points must be adjacent. Two vertices at distance 2 have no \
walk between them:\
\>", "ExampleText",ExpressionUUID->"497fceb4-4977-4575-bf20-e177169ded34"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "pB", ",", " ", "w"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "45", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "47", "]"}]}], ",", " ", 
         RowBox[{"w", " ", "==", " ", 
          RowBox[{"InfraWalk", "[", 
           RowBox[{"pA", ",", " ", "pB"}], "]"}]}]}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"RandomInfraSceneInstance", "[", 
    RowBox[{"scene", ",", " ", "g", ",", " ", "All"}], "]"}]}], 
  "]"}]], "Input",
