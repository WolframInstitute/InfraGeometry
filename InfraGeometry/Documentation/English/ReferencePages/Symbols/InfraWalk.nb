Cell[TextData[{
 "A walk is a vertex sequence with each vertex adjacent to the next; vertices \
and edges may repeat. It is closed when it ends where it starts. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraWalkQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraWalkQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b2b75dd5-4222-472e-8a4a-cd771c81e074"],
 " tests the condition."
}], "Notes",ExpressionUUID->"77402e43-9102-480d-950d-affd147980ee"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "724c22d4-75f5-4f2f-a717-3bc7d406bf01"],
 " draws ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["v1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
     StyleBox["vk", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b799b3f0-c748-4522-a608-8561152e185a"],
 " along its edges, an edge run more than once the stronger. ",
 Cell[BoxData[
  RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bcef923-870a-4192-82bc-35abc0bf7e31"],
 " marks its direction."
}], "Notes",ExpressionUUID->"a9c70bbf-5a15-4dee-92b8-e08c76cfbcdc"],

Cell[TextData[{
 "In a scene, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81385002-6fea-4841-8258-8795f4d8b16f"],
 " is literal: its one realisation is the vertex list of the points, when \
consecutive points are adjacent, and there is none otherwise. Unlike ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "50e63a71-c341-4500-afeb-fd6482fb622a"],
 ", it does not join the points by shortest paths."
}], "Notes",ExpressionUUID->"67c41752-0d21-4187-bdd5-e4390763f718"],

