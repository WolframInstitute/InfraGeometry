Cell["\<\
In a scene: a point at distance 1 from the centre, a point at distance 2, and \
the walk through the three. Only adjacent points give a walk, so there are 12 \
instances on the grid, and each first step is shared by three of them:\
\>", "ExampleText",ExpressionUUID->"2d56c498-eb88-4ed0-a510-7bce9c283cd4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "pB", ",", " ", "pC", ",", " ", "w"}], "}"}], 
       ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "c", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"pA", ",", " ", "1"}], "]"}], "]"}]}], ",", "\n", "     ", 
         RowBox[{"pC", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"pA", ",", " ", "2"}], "]"}], "]"}]}], ",", " ", 
         RowBox[{"w", " ", "==", " ", 
          RowBox[{"InfraWalk", "[", 
           RowBox[{"pA", ",", " ", "pB", ",", " ", "pC"}], "]"}]}]}], "}"}]}],
       "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraSceneInstance", "[", 
        RowBox[{"#", ",", " ", "w"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"RandomInfraSceneInstance", "[", 
       RowBox[{"scene", ",", " ", "g", ",", " ", "All"}], "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraWalk", " ", "/@", " ", "walks"}], ",", " ", "c"}], "}"}],
      ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Length", "[", "walks", "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"00bcf308-4a01-4101-80d7-176ea7d9b636"],

