Cell["A closed walk round a square of side 2, with its direction:", \
"ExampleText",ExpressionUUID->"d6e0ac02-6f6f-4963-934f-c4832982886e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraWalk", "[", 
        RowBox[{"{", 
         RowBox[{
         "45", ",", " ", "46", ",", " ", "47", ",", " ", "57", ",", " ", "67",
           ",", " ", "66", ",", " ", "65", ",", " ", "55", ",", " ", "45"}], 
         "}"}], "]"}], ",", " ", "45"}], "}"}], ",", "\n", "    ", 
     RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cfb2950e-bf55-46b7-8742-1653e9e277ce"],

