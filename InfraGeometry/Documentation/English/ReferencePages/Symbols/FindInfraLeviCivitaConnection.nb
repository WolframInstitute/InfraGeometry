Cell["\<\
The list form gives every realisation. Around the face there are four; the \
connection follows one of them.\
\>", "ExampleText",ExpressionUUID->"6994699c-e6d2-4a71-899f-d786d26e9734"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"conn", " ", "=", " ", 
      RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}], ",", " ", 
     
     RowBox[{"face", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "1"}], "}"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraParallelTransport", "[", 
       RowBox[{"fib", ",", " ", "face"}], "]"}]}], ",", " ", 
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"InfraParallelTransport", "[", 
        RowBox[{"fib", ",", " ", "face"}], "]"}], ",", " ", 
       RowBox[{"InfraParallelTransport", "[", 
        RowBox[{"fib", ",", " ", "conn", ",", " ", "face"}], "]"}]}], "]"}]}],
     "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"30a831fc-4ba2-43da-a24d-f453372edee5"],

