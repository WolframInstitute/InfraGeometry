Cell[TextData[{
 "On the grid the connection is the translation on every edge whose ends are \
at distance at least 2 from the rim: a lift from ",
 StyleBox["(p, u)", "TI"],
 " to ",
 StyleBox["(q, w)", "TI"],
 " has ",
 StyleBox["w \[Minus] q = u \[Minus] p", "TI"],
 " in coordinates."
}], "ExampleText",ExpressionUUID->"942fc585-22c4-4a23-a908-11022941cbef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"xy", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"Round", " ", "@", " ", 
         RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "]"}]}], ",", " ", 
     RowBox[{"fib", " ", "=", " ", 
      RowBox[{"InfraDisplacementBundle", "[", 
       RowBox[{"g", ",", " ", "1"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inner", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Min", "[", 
           RowBox[{"xy", "[", "#", "]"}], "]"}], " ", ">=", " ", "3"}], " ", "&&",
          " ", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"xy", "[", "#", "]"}], "]"}], " ", "<=", " ", "8"}]}], " ",
         "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"lifts", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", "conn"}], ",", " ", 
       RowBox[{
        RowBox[{"SubsetQ", "[", 
         RowBox[{"inner", ",", " ", 
          RowBox[{"First", " ", "/@", " ", 
           RowBox[{"List", " ", "@@", " ", "#"}]}]}], "]"}], " ", "&"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "lifts", "]"}], ",", " ", 
     RowBox[{"Union", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"xy", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], "]"}], " ", "-", 
           " ", 
           RowBox[{"xy", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "]"}]}], ")"}], " ",
          "-", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"xy", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], "]"}], " ", "-", 
           " ", 
           RowBox[{"xy", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}]}], ")"}]}], 
        " ", "&"}], " ", "/@", " ", "lifts"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e2fdf910-a8b1-4b68-8451-f9abbc26a870"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"240", ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0"}], "}"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"34ae5272-62fa-429f-b930-e5453ff2fb18"]
}, Open  ]],

Cell["\<\
On the square torus, with no rim, the connection is flat. On the octahedron \
it is a connection but not flat:\
\>", "ExampleText",ExpressionUUID->"b2c7870e-8277-42f6-8c53-43a72dc23f75"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"torus", " ", "=", " ", 
     RowBox[{"InfraDisplacementBundle", "[", 
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\""}], 
        "]"}], ",", " ", "1"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"octahedron", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraConnectionQ", "[", 
          RowBox[{"fib", ",", " ", "#"}], "]"}], ",", " ", 
         RowBox[{"InfraFlatConnectionQ", "[", 
          RowBox[{"fib", ",", " ", "#"}], "]"}]}], "}"}], " ", "&"}], " ", "@",
       " ", 
      RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}], ",", "\n",
      "    ", 
     RowBox[{"{", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"{", 
        RowBox[{"torus", ",", " ", "octahedron"}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"b84b501b-a136-4bd3-8f73-e9e854cc3492"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"True", ",", "True"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"True", ",", "False"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"2fb3dff9-978f-4e7c-9067-d34d5567e9d3"]
}, Open  ]]
}, Open  ]],

