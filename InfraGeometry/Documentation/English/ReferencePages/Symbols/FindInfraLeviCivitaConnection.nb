Cell["\<\
The triangular torus from the catalogue: the hexagon around a vertex, with \
the Levi-Civita holonomy angle of the connection and the least angle over the \
realisations.\
\>", "ExampleText",ExpressionUUID->"e5b5b1a5-be2e-451f-b7c9-05d8119ae44e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<TriangularTorusDisplacementBundle\>\"", ",", 
       " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"torusGraph", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", "fib"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"torusVertex", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"VertexList", "[", "torusGraph", "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"hexagon", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Append", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"First", " ", "@", " ", "#"}]}], "]"}], " ", "&"}], " ", "@",
       " ", 
      RowBox[{
       RowBox[{"FindCycle", "[", 
        RowBox[{
         RowBox[{"Subgraph", "[", 
          RowBox[{"torusGraph", ",", " ", 
           RowBox[{"AdjacencyList", "[", 
            RowBox[{"torusGraph", ",", " ", "torusVertex"}], "]"}]}], "]"}], ",",
          " ", 
         RowBox[{"{", "6", "}"}], ",", " ", "1"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", " ", "All", ",", " ", "1"}], "]"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"torusGraph", ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraWalk", "[", "hexagon", "]"}], "}"}]}], "]"}], ",", " ", 
     
     RowBox[{"InfraHolonomyAngle", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}], ",", " ", 
       "hexagon"}], "]"}], ",", " ", 
     RowBox[{"InfraHolonomyAngle", "[", 
      RowBox[{"fib", ",", " ", "hexagon"}], "]"}]}], "}"}]}], "]"}]}], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"3333ffee-c6c0-47d6-b441-db6cb7d3c258"],

