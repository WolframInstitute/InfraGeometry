Cell[TextData[{
 "Under ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0d7fdc2-8390-49af-a874-8464cdcbb254"],
 " the octahedron gives the same connection."
}], "ExampleText",ExpressionUUID->"e3d22bbd-33dd-4fc5-a114-c80a4644d894"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FindInfraLeviCivitaConnection", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], "]"}]}]}],
     " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}]}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3b22286d-ae9f-4b60-b1a5-4e45daafa182"],

