FindInfraLeviCivitaConnection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"InfraDisplacementBundle", "[", 
    RowBox[{
     StyleBox["g", "TI"], ",", " ", 
     StyleBox["r", "TI"]}], "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0f0a938-5cf4-480e-b6c6-09eae5acaae7"],
 "\[LineSeparator]",
 "gives the Levi-Civita ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "abea9da4-10cc-4875-ae10-916e7886c606"],
 ": over each edge ",
 StyleBox["p", "TI"],
 " -> ",
 StyleBox["q", "TI"],
 " of ",
 StyleBox["g", "TI"],
 " the first of the best angle-isometries from the directions at ",
 StyleBox["p", "TI"],
 " to those at ",
 StyleBox["q", "TI"],
 " fixing the geodesics through ",
 StyleBox["q", "TI"],
 "; its lifts that are not total edges are dropped.",
 "\n"
}], "Usage",ExpressionUUID->"f8315d33-5603-4ac9-9f55-c4ebfa734ffd"],

Cell[TextData[{
 "The best angle-isometries over an edge are usually several. The connection \
keeps the first, as InfraGaugeTheory does. All of them are read by ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26da1eec-13ee-4d6c-b6db-a1b210c9c582"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHolonomyAngle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHolonomyAngle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["loop", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "efbee5c2-7e75-40cd-8578-da648303e5f7"],
 "."
}], "Notes",ExpressionUUID->"c0809b11-30a3-498f-899c-ef74bce188cd"],

