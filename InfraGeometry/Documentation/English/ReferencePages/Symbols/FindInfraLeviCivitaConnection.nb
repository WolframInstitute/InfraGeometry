Cell["FindInfraLeviCivitaConnection", "ObjectName",ExpressionUUID->"5e32b53c-3935-4335-9b7f-2d4660959cfc"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"026deca0-e6c3-4653-92b7-d8ec1c753595"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraLeviCivitaConnection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
FindInfraLeviCivitaConnection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"InfraDisplacementBundle", "[", 
    RowBox[{
     StyleBox["g", "TI"], ",", " ", 
     StyleBox["r", "TI"]}], "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75e514fc-d65c-47f1-b9eb-c0872283f552"],
 "\[LineSeparator]",
 "gives the Levi-Civita ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0919f81a-905e-4a99-8775-690b10f71b8a"],
 ": over each edge ",
 StyleBox["p", "TI"],
 " -> ",
 StyleBox["q", "TI"],
 " of ",
 StyleBox["g", "TI"],
 " the first of the best angle-isometries from the directions at ",
 StyleBox["p", "TI"],
 " to those at ",
 StyleBox["q", "TI"],
 " fixing the geodesics through ",
 StyleBox["q", "TI"],
 "; its lifts that are not total edges are dropped.",
 "\n"
}], "Usage",ExpressionUUID->"df7f4156-091d-4b78-b5f8-1e770cea7c49"],

Cell["\<\
This is a particular Experimental construction in the Infra Fiber Bundles \
category. Its existing call forms remain available.\
\>", "Notes",ExpressionUUID->"27a98c83-1c09-4493-b63d-c707c41a6e4b"],

Cell[TextData[{
 "The best angle-isometries over an edge are usually several. The connection \
keeps the first, as InfraGaugeTheory does. All of them are read by ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5be24d17-5645-412c-a73e-61412fe706f2"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHolonomyAngle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHolonomyAngle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["loop", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88ab60bf-f0e3-469b-bb4b-65047033e000"],
 "."
}], "Notes",ExpressionUUID->"d7b107ca-44bf-4a55-a277-821f55fca235"],

