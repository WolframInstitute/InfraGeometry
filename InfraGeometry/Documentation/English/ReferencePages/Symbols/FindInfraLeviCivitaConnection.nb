  FontSize->0.9 Inherited,ExpressionUUID->
  "d1a3aa75-c429-4249-9dd1-de4c7fa8df37"],
 " the octahedron gives the same connection."
}], "ExampleText",ExpressionUUID->"24a379a8-3619-4ea1-b373-27d65d7b8653"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FindInfraLeviCivitaConnection", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], "]"}]}]}],
     " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}]}]}]}], 
  "]"}]], "Input",
