Cell["\<\
The transport over an edge at the centre at scale 1, each direction and its \
image in one colour. On the grid each direction goes to the parallel one. On \
the mesh the centre has seven directions and its neighbour five, and only two \
lifts are edges of the bundle:\
\>", "ExampleText",ExpressionUUID->"462b5abf-417a-4df4-a74e-d0ecb39c4035"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"fib", " ", "=", " ", 
         RowBox[{"InfraDisplacementBundle", "[", 
          RowBox[{"g", ",", " ", "1"}], "]"}]}], ",", " ", 
        RowBox[{"q", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"AdjacencyList", "[", 
           RowBox[{"g", ",", " ", "c"}], "]"}]}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"transport", " ", "=", " ", 
        RowBox[{"InfraParallelTransport", "[", 
         RowBox[{"fib", ",", " ", 
          RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"c", ",", " ", "q"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"InfraWalk", "[", "#1", "]"}], ",", " ", 
             RowBox[{"InfraWalk", "[", "#2", "]"}]}], "}"}], " ", "&"}], ",", 
          " ", "transport"}], "]"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"a8ab52ec-874f-411e-9294-b003a3b190a2"],

