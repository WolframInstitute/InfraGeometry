Cell["\<\
On the octahedron, going around a face turns the four directions at its first \
vertex by one step, around the square they form:\
\>", "ExampleText",ExpressionUUID->"1a45e7e1-ba70-456a-bfa5-6da39d49c025"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"InfraFiber", "[", 
       RowBox[{"fib", ",", " ", "1"}], "]"}]}], ",", " ", 
     RowBox[{"InfraHolonomy", "[", 
      RowBox[{"fib", ",", " ", "conn", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "1"}], "}"}]}], 
      "]"}], ",", "\n", "    ", 
     RowBox[{"InfraHolonomyAngle", "[", 
      RowBox[{"fib", ",", " ", "conn", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "1"}], "}"}]}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0818db3a-5037-4a00-b743-a83df29f34ea"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "6"}], "}"}]}], "}"}], ",", 
   RowBox[{"Cycles", "[", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], "}"}], "]"}], ",", 
   "1"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9a1818c8-d4d5-4ac0-8a84-afbda81a8b80"]
}, Open  ]]
}, Open  ]],

