Cell["Method", "ExampleSubsection",ExpressionUUID->"fd8648f8-7ff9-4ff6-898f-c73f61657baf"],

Cell[TextData[{
 "Under ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38e870be-dcdf-4cb8-99fc-b2797c4734f7"],
 " the octahedron gives the same connection."
}], "ExampleText",ExpressionUUID->"ed3026c7-455e-45d0-ad41-8aaae4008c21"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FindInfraLeviCivitaConnection", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], "]"}]}]}],
     " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"60d08791-b8b4-4e5a-a84a-5bd0befe5d58"],

