Cell["\<\
The list form gives every realisation. Around the face there are four; the \
connection follows one of them.\
\>", "ExampleText",ExpressionUUID->"b846d4bb-b5ab-40ec-b9ed-421a88dbd541"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"conn", " ", "=", " ", 
      RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}], ",", " ", 
     
     RowBox[{"face", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "1"}], "}"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraParallelTransport", "[", 
       RowBox[{"fib", ",", " ", "face"}], "]"}]}], ",", " ", 
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"InfraParallelTransport", "[", 
        RowBox[{"fib", ",", " ", "face"}], "]"}], ",", " ", 
       RowBox[{"InfraParallelTransport", "[", 
        RowBox[{"fib", ",", " ", "conn", ",", " ", "face"}], "]"}]}], "]"}]}],
     "}"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b86a7af2-e652-4a8c-a7c4-c63ce687a137"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"6b081197-59ba-453a-9af4-61c7df2a5796"]
}, Open  ]]
}, Open  ]],

