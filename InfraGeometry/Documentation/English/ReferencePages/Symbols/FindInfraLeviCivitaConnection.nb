Cell["\<\
The list form gives every realisation. Around the face there are four; the \
connection follows one of them.\
\>", "ExampleText",ExpressionUUID->"c7be0fca-8d86-4243-98c4-1fac635e24c0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"conn", " ", "=", " ", 
      RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}], ",", " ", 
     
     RowBox[{"face", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "1"}], "}"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraParallelTransport", "[", 
       RowBox[{"fib", ",", " ", "face"}], "]"}]}], ",", " ", 
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"InfraParallelTransport", "[", 
        RowBox[{"fib", ",", " ", "face"}], "]"}], ",", " ", 
       RowBox[{"InfraParallelTransport", "[", 
        RowBox[{"fib", ",", " ", "conn", ",", " ", "face"}], "]"}]}], "]"}]}],
     "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"95b37f9b-2d86-42c6-b5d7-6cf669497d23"],

