Cell[CellGroupData[{
Cell["FindInfraLeviCivitaConnection", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ed5aaec1-b9de-4b55-82ea-44a0158b9ca0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraLeviCivitaConnection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
FindInfraLeviCivitaConnection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"InfraDisplacementBundle", "[", 
    RowBox[{
     StyleBox["g", "TI"], ",", " ", 
     StyleBox["r", "TI"]}], "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94205dd1-b939-435b-8a15-a1ef81fe2377"],
 "\[LineSeparator]",
 "gives the Levi-Civita ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fa29bf38-dc55-46d6-b470-10f83062e5ba"],
 " of the displacement bundle: over each edge ",
 StyleBox["p", "TI"],
 " \[Dash] ",
 StyleBox["q", "TI"],
 " of ",
 StyleBox["g", "TI"],
 ", a map of the directions at ",
 StyleBox["p", "TI"],
 " to the directions at ",
 StyleBox["q", "TI"],
 " that best keeps the angles between them and continues the geodesics \
through ",
 StyleBox["q", "TI"],
 " straight.",
 "\n"
}], "Usage",ExpressionUUID->"48e58e93-4e49-4c4f-8556-1f9ba8af3041"],

Cell[TextData[{
 "The directions at ",
 StyleBox["p", "TI"],
 " are the vertices of the sphere ",
 StyleBox["S\:1d63(p)", "TI"],
 ". Over an edge ",
 StyleBox["p", "TI"],
 " \[Dash] ",
 StyleBox["q", "TI"],
 " the candidates are the one-to-one maps from the smaller of ",
 StyleBox["S\:1d63(p)", "TI"],
 ", ",
 StyleBox["S\:1d63(q)", "TI"],
 " into the larger that send each direction whose geodesic passes through ",
 StyleBox["q", "TI"],
 " to its straightest continuation. The best change the angles between \
directions least, in the sum of squares."
}], "Notes",ExpressionUUID->"da71a248-08b2-408c-b6df-3172454a3117"],

Cell[TextData[{
 "The best maps are usually several. The connection keeps the first; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68ad27ee-ee91-4fab-b522-52572476bff8"],
 " gives all."
}], "Notes",ExpressionUUID->"60869540-a1c1-4362-a7bb-38c5584414b4"],

Cell[TextData[{
 "A lift ",
 StyleBox["(p, u) \[RightArrow] (q, w)", "TI"],
 " with ",
 StyleBox["u \[NotEqual] w", "TI"],
 " and ",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["w", "TI"],
 " not adjacent is not an edge of the displacement bundle and is dropped. \
Where lifts are dropped, or the spheres differ in size, the result is not a \
connection in the sense of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d78f53a0-a678-47b2-acdf-d1d72fe5bae2"],
 "."
}], "Notes",ExpressionUUID->"1b08f5f8-6d28-4025-8520-712f54263094"],

Cell[TextData[{
 "On the square grid at scale 1, away from the rim, the connection is the \
translation ",
 StyleBox["(p, p + e) \[RightArrow] (q, q + e)", "TI"],
 ", and it is flat. On the square torus it is a flat connection. On the \
octahedron it is a connection, and going around a face turns the four \
directions at a vertex by one step."
}], "Notes",ExpressionUUID->"21a3216c-9b2e-43c8-bb05-3cb0c4ab5aac"],

