Cell["\<\
The list form gives every realisation. Around the face there are four; the \
connection follows one of them.\
\>", "ExampleText",ExpressionUUID->"aca0c63a-a253-4675-befe-590babdc40a2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"conn", " ", "=", " ", 
      RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}], ",", " ", 
     
     RowBox[{"face", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "1"}], "}"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraParallelTransport", "[", 
       RowBox[{"fib", ",", " ", "face"}], "]"}]}], ",", " ", 
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"InfraParallelTransport", "[", 
        RowBox[{"fib", ",", " ", "face"}], "]"}], ",", " ", 
       RowBox[{"InfraParallelTransport", "[", 
        RowBox[{"fib", ",", " ", "conn", ",", " ", "face"}], "]"}]}], "]"}]}],
