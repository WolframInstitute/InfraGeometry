Cell[TextData[{
 "On the grid the connection is the translation on every edge whose ends are \
at distance at least 2 from the rim: a lift from ",
 StyleBox["(p, u)", "TI"],
 " to ",
 StyleBox["(q, w)", "TI"],
 " has ",
 StyleBox["w \[Minus] q = u \[Minus] p", "TI"],
 " in coordinates."
}], "ExampleText",ExpressionUUID->"d911e004-6e5f-4498-acc7-92c87b317ae8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"xy", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"Round", " ", "@", " ", 
         RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "]"}]}], ",", " ", 
     RowBox[{"fib", " ", "=", " ", 
      RowBox[{"InfraDisplacementBundle", "[", 
       RowBox[{"g", ",", " ", "1"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inner", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Min", "[", 
           RowBox[{"xy", "[", "#", "]"}], "]"}], " ", ">=", " ", "3"}], " ", "&&",
          " ", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"xy", "[", "#", "]"}], "]"}], " ", "<=", " ", "8"}]}], " ",
         "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"lifts", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", "conn"}], ",", " ", 
       RowBox[{
        RowBox[{"SubsetQ", "[", 
         RowBox[{"inner", ",", " ", 
          RowBox[{"First", " ", "/@", " ", 
           RowBox[{"List", " ", "@@", " ", "#"}]}]}], "]"}], " ", "&"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "lifts", "]"}], ",", " ", 
     RowBox[{"Union", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"xy", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], "]"}], " ", "-", 
           " ", 
           RowBox[{"xy", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "]"}]}], ")"}], " ",
          "-", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"xy", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], "]"}], " ", "-", 
           " ", 
           RowBox[{"xy", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}]}], ")"}]}], 
        " ", "&"}], " ", "/@", " ", "lifts"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b6fef189-8140-4f1f-bd88-ef3290dd16bb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"240", ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0"}], "}"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"0dcd8ee5-7524-4bc9-b95b-30c022e0e148"]
}, Open  ]],

Cell["\<\
On the square torus, with no rim, the connection is flat. On the octahedron \
it is a connection but not flat:\
\>", "ExampleText",ExpressionUUID->"592bc3d0-348b-49dd-86df-634f9c216161"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"torus", " ", "=", " ", 
     RowBox[{"InfraDisplacementBundle", "[", 
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\""}], 
        "]"}], ",", " ", "1"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"octahedron", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraConnectionQ", "[", 
          RowBox[{"fib", ",", " ", "#"}], "]"}], ",", " ", 
         RowBox[{"InfraTrivialMonodromyQ", "[", 
          RowBox[{"fib", ",", " ", "#"}], "]"}]}], "}"}], " ", "&"}], " ", "@",
       " ", 
      RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}], ",", "\n",
      "    ", 
     RowBox[{"{", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"{", 
        RowBox[{"torus", ",", " ", "octahedron"}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"96b6a578-f67a-49c7-ae73-adb7055bc066"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"True", ",", "True"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"True", ",", "False"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"2d38a04c-7b95-4072-826b-f7b030d654b2"]
}, Open  ]]
}, Open  ]],

