    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"InfraDisplacementBundle", "[", 
    RowBox[{
     StyleBox["g", "TI"], ",", " ", 
     StyleBox["r", "TI"]}], "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46cf2411-8546-4ac4-82c2-2b4bdf1f170f"],
 "\[LineSeparator]",
 "gives the Levi-Civita ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "436475e5-aa43-40ba-98ba-49f2d72f1e38"],
 ": over each edge ",
 StyleBox["p", "TI"],
 " -> ",
 StyleBox["q", "TI"],
 " of ",
 StyleBox["g", "TI"],
 " the first of the best angle-isometries from the directions at ",
 StyleBox["p", "TI"],
 " to those at ",
 StyleBox["q", "TI"],
 " fixing the geodesics through ",
 StyleBox["q", "TI"],
 "; its lifts that are not total edges are dropped.",
 "\n"
}], "Usage",ExpressionUUID->"df8e84f9-47ea-4063-9cb6-1dae862942a5"],

Cell[TextData[{
 "The best angle-isometries over an edge are usually several. The connection \
keeps the first, as InfraGaugeTheory does. All of them are read by ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "975a5f83-203f-4884-8473-246636be639a"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHolonomyAngle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHolonomyAngle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["loop", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69f3ce68-0b15-41c2-9b01-58fddcc1eac6"],
 "."
}], "Notes",ExpressionUUID->"c545584d-5b93-4472-b59d-66439ab7dccf"],

