Cell["\<\
The triangular torus from the catalogue: the hexagon around a vertex, with \
the Levi-Civita holonomy angle of the connection and the least angle over the \
realisations.\
\>", "ExampleText",ExpressionUUID->"64d9fd6d-34dc-4f90-9bb9-e03938613650"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<TriangularTorusDisplacementBundle\>\"", ",", 
       " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"torusGraph", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", "fib"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"torusVertex", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"VertexList", "[", "torusGraph", "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"hexagon", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Append", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"First", " ", "@", " ", "#"}]}], "]"}], " ", "&"}], " ", "@",
       " ", 
      RowBox[{
       RowBox[{"FindCycle", "[", 
        RowBox[{
         RowBox[{"Subgraph", "[", 
          RowBox[{"torusGraph", ",", " ", 
           RowBox[{"AdjacencyList", "[", 
            RowBox[{"torusGraph", ",", " ", "torusVertex"}], "]"}]}], "]"}], ",",
          " ", 
         RowBox[{"{", "6", "}"}], ",", " ", "1"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", " ", "All", ",", " ", "1"}], "]"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"torusGraph", ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraWalk", "[", "hexagon", "]"}], "}"}]}], "]"}], ",", " ", 
     
     RowBox[{"InfraHolonomyAngle", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}], ",", " ", 
       "hexagon"}], "]"}], ",", " ", 
     RowBox[{"InfraHolonomyAngle", "[", 
      RowBox[{"fib", ",", " ", "hexagon"}], "]"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"dbfc470e-9dda-4036-a112-754ff892bb1a"],

