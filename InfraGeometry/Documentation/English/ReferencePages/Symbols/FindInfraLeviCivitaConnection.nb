Cell["\<\
The triangular torus from the catalogue: the hexagon around a vertex, with \
the Levi-Civita holonomy angle of the connection and the least angle over the \
realisations.\
\>", "ExampleText",ExpressionUUID->"87f1c7bb-7dff-468b-a8b6-1c9ce207ce13"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<TriangularTorusDisplacementBundle\>\"", ",", 
       " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"torusGraph", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", "fib"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"torusVertex", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"VertexList", "[", "torusGraph", "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"hexagon", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Append", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"First", " ", "@", " ", "#"}]}], "]"}], " ", "&"}], " ", "@",
       " ", 
      RowBox[{
       RowBox[{"FindCycle", "[", 
        RowBox[{
         RowBox[{"Subgraph", "[", 
          RowBox[{"torusGraph", ",", " ", 
           RowBox[{"AdjacencyList", "[", 
            RowBox[{"torusGraph", ",", " ", "torusVertex"}], "]"}]}], "]"}], ",",
          " ", 
         RowBox[{"{", "6", "}"}], ",", " ", "1"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", " ", "All", ",", " ", "1"}], "]"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"torusGraph", ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraWalk", "[", "hexagon", "]"}], "}"}]}], "]"}], ",", " ", 
     
     RowBox[{"InfraHolonomyAngle", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}], ",", " ", 
       "hexagon"}], "]"}], ",", " ", 
     RowBox[{"InfraHolonomyAngle", "[", 
      RowBox[{"fib", ",", " ", "hexagon"}], "]"}]}], "}"}]}], "]"}]}], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"64bba133-16c6-4f0a-96cd-264f34906f84"],

