Notebook[{

Cell[CellGroupData[{
Cell["FindInfraLeviCivitaConnection", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9731d922-d13c-430e-b0c0-977195200aea"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraLeviCivitaConnection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
FindInfraLeviCivitaConnection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"InfraDisplacementBundle", "[", 
    RowBox[{
     StyleBox["g", "TI"], ",", " ", 
     StyleBox["r", "TI"]}], "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40c75125-b3e7-479e-9d90-5eff260f1503"],
 "\[LineSeparator]",
 "gives the Levi-Civita InfraConnection: over each edge p -> q of g the first \
of the best angle-isometries from the directions at p to those at q fixing \
the geodesics through q, its lifts that are not total edges dropped.",
 "\n"
}], "Usage",ExpressionUUID->"a05e1a61-01f8-4c49-af2d-a1cdece0ea63"],

Cell["Options:", "Notes",ExpressionUUID->"2c133c8b-5192-44d7-a887-794c20bf5486"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b67ff674-d8b0-4cd4-9745-f7b19a0deb57"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"a4ace818-13f9-48ac-beae-fc0f428affeb"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"9a06ad88-02c6-4723-95eb-ad636ae25d9a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b9bdb216-7d72-4576-a6de-f2e2f6eed8b6"], Cell[TextData[Cell[BoxData[
    "Method"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0d7d3c80-6b9c-4f2e-93c7-42c32e127ce4"]], "TableText",ExpressionUUID->
     "10d630c5-8bef-4484-8bdf-682445cc407e"], Cell["\<\
\"Arclength\" (default): the angle between two directions at p is their \
distance in the graph with the open ball of radius r around p deleted, over \
r; \"Alexandrov\": the comparison angle of the polar form\
\>", "TableText",ExpressionUUID->"56743542-140c-4cec-839f-aea398d3f46c"]}
  }]], "2ColumnTableMod",ExpressionUUID->"7cece7aa-2072-422e-b46f-\
9be3fe94b390"],

Cell["\<\
The best angle-isometries over an edge are usually several; the connection \
keeps the first, as InfraGaugeTheory does. All of them are read by \
InfraParallelTransport[InfraDisplacementBundle[g, r], walk] and \
InfraHolonomyAngle[InfraDisplacementBundle[g, r], loop].\
\>", "Notes",ExpressionUUID->"8cf56d1d-8e48-4893-961b-0d1a3a9dd93b"]
}, Open  ]],

