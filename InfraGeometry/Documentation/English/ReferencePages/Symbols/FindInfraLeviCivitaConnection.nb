Cell[TextData[{
 "Under ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea95acba-dc3a-4dae-ac3a-4c53c1e987b1"],
 " the octahedron gives the same connection."
}], "ExampleText",ExpressionUUID->"80e6575d-e825-4329-9c1e-a0d7330618e9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FindInfraLeviCivitaConnection", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], "]"}]}]}],
     " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"First", " ", "@", " ", 
