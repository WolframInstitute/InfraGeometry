Cell["\<\
The Levi-Civita connection of the octahedron is a connection of its \
displacement bundle, and it is not flat. Its holonomy around a face is drawn: \
the face, and every direction at 1 joined to its image.\
\>", "ExampleText",ExpressionUUID->"ec0af55f-df70-496b-ab74-a08c594f0104"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"conn", " ", "=", " ", 
      RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}], ",", " ", 
     
     RowBox[{"face", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "1"}], "}"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"transport", " ", "=", " ", 
     RowBox[{"InfraParallelTransport", "[", 
      RowBox[{"fib", ",", " ", "conn", ",", " ", "face"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", "fib"}], ",", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "face", "]"}], ",", " ", 
           RowBox[{"Directive", "[", "StandardBlue", "]"}]}], "}"}], ",", 
         "\n", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraWalk", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Last", " ", "@", " ", 
               RowBox[{"First", " ", "@", " ", "#"}]}], ",", " ", 
              RowBox[{"Last", " ", "@", " ", 
               RowBox[{"Last", " ", "@", " ", "#"}]}]}], "}"}], "]"}], " ", 
           "&"}], " ", "/@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Normal", " ", "@", " ", "transport"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"First", " ", "@", " ", "#"}], " ", "=!=", " ", 
              RowBox[{"Last", " ", "@", " ", "#"}]}], " ", "&"}]}], "]"}]}]}],
         "]"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"InfraConnectionQ", "[", 
      RowBox[{"fib", ",", " ", "conn"}], "]"}], ",", " ", 
     RowBox[{"InfraFlatConnectionQ", "[", 
      RowBox[{"fib", ",", " ", "conn"}], "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5f4d86df-0aa8-4b9f-8dfd-32a477664b80"],

