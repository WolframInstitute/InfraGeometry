Cell["Method", "ExampleSubsection",ExpressionUUID->"6fbf158d-06fb-4662-a15f-75a01ac34394"],

Cell[TextData[{
 "On the octahedron ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62b514b6-d19b-4579-8a37-1be07a7e2eb6"],
 " gives the same connection:"
}], "ExampleText",ExpressionUUID->"e83fc6d5-342b-475c-93ca-0a8511e01846"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FindInfraLeviCivitaConnection", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], "]"}]}]}],
     " ", "===", "\n", "    ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"37f69d7d-21c6-40d5-a948-f321ef08bea2"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f314478d-fd38-4b1c-948e-20b5cec8bb64"]
