Cell["FindInfraLeviCivitaConnection", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"17df199e-d6fb-41a4-b033-3ec68574e0a7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraLeviCivitaConnection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
FindInfraLeviCivitaConnection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"InfraDisplacementBundle", "[", 
    RowBox[{
     StyleBox["g", "TI"], ",", " ", 
     StyleBox["r", "TI"]}], "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5374bb1-201c-4499-9d82-860edca03103"],
 "\[LineSeparator]",
 "gives the Levi-Civita ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3c8b7a9e-472f-46d5-965d-7ca93e9216f9"],
 ": over each edge ",
 StyleBox["p", "TI"],
 " -> ",
 StyleBox["q", "TI"],
 " of ",
 StyleBox["g", "TI"],
 " the first of the best angle-isometries from the directions at ",
 StyleBox["p", "TI"],
 " to those at ",
 StyleBox["q", "TI"],
 " fixing the geodesics through ",
 StyleBox["q", "TI"],
 "; its lifts that are not total edges are dropped.",
 "\n"
}], "Usage",ExpressionUUID->"89c2e2f9-1766-4158-8678-37a0e06fdcbe"],

Cell["\<\
This is a particular Experimental construction in the Infra Fiber Bundles \
category. Its existing call forms remain available.\
\>", "Notes",ExpressionUUID->"c933ac6d-720a-477a-ac4e-97c90dc5ea3a"],

Cell[TextData[{
 "The best angle-isometries over an edge are usually several. The connection \
keeps the first, as InfraGaugeTheory does. All of them are read by ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraParallelTransport"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02cde5d2-6651-4b9b-993e-d29213cce810"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHolonomyAngle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHolonomyAngle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["loop", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35103b00-09a6-41f1-b830-beed748e88cf"],
 "."
}], "Notes",ExpressionUUID->"837bda62-ad5f-414e-a1ff-1b8e1d2963bf"],

