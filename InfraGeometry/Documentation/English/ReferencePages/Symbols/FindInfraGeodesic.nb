        RowBox[{"geos", ",", " ", "a"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"InfraGeodesicQ", "[", 
      RowBox[{"g", ",", " ", "geos", ",", " ", "3"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e9546acb-5fad-4b6e-a962-ec3ea067e1ba"],

