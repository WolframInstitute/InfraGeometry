Cell[TextData[{
 "All geodesics of 4 edges from the centre, as the scale grows: every walk at \
scale 1, the walks that never step back at scale 2, the shortest paths at \
scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c82c09-5d52-4bd6-b6ae-f8c4d45662e2"],
 "."
}], "ExampleText",ExpressionUUID->"2e7644b8-32a8-4387-9bfb-cac724b6a439"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Row", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"geos", " ", "=", " ", 
          RowBox[{"FindInfraGeodesic", "[", 
           RowBox[{"g", ",", " ", "a", ",", " ", "sc", ",", " ", 
            RowBox[{"{", "4", "}"}], ",", " ", "All"}], "]"}]}], "}"}], ",", 
        "\n", "      ", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"geos", ",", " ", "a"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<scale \>\"", ",", " ", "sc", ",", " ", "\"\<: \>\"", 
             ",", " ", 
             RowBox[{"Length", " ", "@", " ", "geos"}]}], "}"}], "]"}]}], 
         "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"sc", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "Infinity"}], "}"}]}], "}"}]}],
      "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"d521a183-35a6-4fb5-8517-ed2654904f19"],

