Cell[TextData[{
 "At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e02e40a9-fb8e-4d9c-85d5-1b0cbefc3633"],
 " the geodesics from the centre that end at ",
 StyleBox["b", "TI"],
 " are the members of the segment."
}], "ExampleText",ExpressionUUID->"63e7c9cb-6762-450a-be17-4c97344ebada"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"a", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"grown", " ", "=", " ", 
     RowBox[{"FindInfraGeodesic", "[", 
      RowBox[{
      "g", ",", " ", "a", ",", " ", "Infinity", ",", " ", "Infinity", ",", 
       " ", "All", ",", " ", 
       RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "b"}], " ", 
          "&"}], ")"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"geos", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"grown", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Last", " ", "@", " ", 
          RowBox[{"Last", " ", "@", " ", 
           RowBox[{"VertexList", " ", "@", " ", "#"}]}]}], " ", "===", " ", 
         "b"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"geos", ",", " ", "a", ",", " ", "b"}], "}"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Last", " ", "/@", " ", 
          RowBox[{"VertexList", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ",
         "geos"}], "]"}], " ", "===", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"FindInfraSegment", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], 
        "]"}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1aaa04b3-59b4-48f7-89d1-66cc524de2d2"],

