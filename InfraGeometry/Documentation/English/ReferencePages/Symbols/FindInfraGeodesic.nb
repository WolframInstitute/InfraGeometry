      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Quiet", " ", "@", " ", 
      RowBox[{"FindInfraGeodesic", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", "61", ",", " ", "Infinity"}], 
       "]"}]}], ",", " ", 
     RowBox[{"Last", " ", "/@", " ", 
      RowBox[{"VertexList", " ", "@", " ", 
       RowBox[{"FindInfraGeodesic", "[", 
        RowBox[{
        "g", ",", " ", "41", ",", " ", "61", ",", " ", "Infinity", ",", " ", 
         "Infinity"}], "]"}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8a62f568-5776-4fad-a811-fd9f3440f0a9"],

