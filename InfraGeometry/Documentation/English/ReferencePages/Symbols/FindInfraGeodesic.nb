Cell["Method", "ExampleSubsection",ExpressionUUID->"cca7a008-3f9c-45f1-8023-81911c49f9cf"],

Cell[TextData[{
 "Under ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bae703ae-8051-4342-85c3-94d7a8bf8aa0"],
 " the first geodesic found is a random one. Three geodesics at infra-scale 2 \
of 12 edges from the centre, one per seed."
}], "ExampleText",ExpressionUUID->"60205d9b-9793-4a4c-8d90-478d7ab4313d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
            RowBox[{"FindInfraGeodesic", "[", 
             RowBox[{"g", ",", " ", "a", ",", " ", "2", ",", " ", 
              RowBox[{"{", "12", "}"}], ",", " ", 
              RowBox[{"Method", " ", "->", " ", "\"\<RandomGreedy\>\""}]}], 
             "]"}]}], ")"}], ",", " ", 
          RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
          "a"}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"seed", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"73a43e86-de09-441f-9ad0-87f7e3446124"],

