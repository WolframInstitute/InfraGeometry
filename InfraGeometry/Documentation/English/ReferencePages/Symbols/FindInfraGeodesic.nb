Cell[TextData[{
 "On a substrate labelled by integers, ",
 Cell[BoxData[
  RowBox[{"FindInfraGeodesic", "[", 
   RowBox[{"g", ",", " ", "1", ",", " ", "3", ",", " ", "Infinity"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ae42737-fc7e-4c1c-b8ab-2c467e3444dd"],
 " fits two readings: the geodesics from 1 at scale 3 with no budget, and the \
geodesics from 1 to 3 at scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3aa4cc43-1d4e-49a2-ab76-2cb4db2468c8"],
 ". The first is an infinite class, so the call is the second. A rule in ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d81bb17-887c-4bb6-8d41-4c3736691047"],
 " that bounds the class, such as ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ba3a1eb-422f-4680-b7e8-8b835a952324"],
 ", makes the first reading finite, and then it wins: on a hexagon the simple \
geodesics at scale 3 run round to the far side."
}], "ExampleText",ExpressionUUID->"6060e981-6ea6-4565-b31f-88c53f3d13ff"],

