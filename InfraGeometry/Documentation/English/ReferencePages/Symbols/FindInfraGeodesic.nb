Cell[TextData[{
 "The geodesics of at most 8 edges from the centre of the square tiling to a \
vertex four steps away, at infra-scales 2, 3 and ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b24a11c0-5c47-49cd-a626-09574cca9483"],
 ". At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aba358d3-b443-46ea-bbe4-3cb64a930b66"],
 " they are the six shortest paths; at the smaller scales they include \
locally shortest walks that go round."
}], "ExampleText",ExpressionUUID->"864757ac-e2c4-4fd0-8848-ed284c6c6ea6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"a", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"Row", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"grown", " ", "=", " ", 
          RowBox[{"FindInfraGeodesic", "[", 
           RowBox[{"g", ",", " ", "a", ",", " ", "sc", ",", " ", 
            RowBox[{"UpTo", "[", "8", "]"}], ",", " ", "All", ",", " ", 
            RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "b"}], " ", 
               "&"}], ")"}]}]}], "]"}]}], "}"}], ",", "\n", "      ", 
        RowBox[{"{", 
         RowBox[{"geos", " ", "=", " ", 
          RowBox[{"Select", "[", 
           RowBox[{"grown", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Last", " ", "@", " ", 
               RowBox[{"Last", " ", "@", " ", 
                RowBox[{"VertexList", " ", "@", " ", "#"}]}]}], " ", "===", 
              " ", "b"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "      ", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"geos", ",", " ", "a", ",", " ", "b"}], "}"}]}], "]"}], ",",
           " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<scale \>\"", ",", " ", "sc", ",", " ", "\"\<: \>\"", 
             ",", " ", 
             RowBox[{"Length", " ", "@", " ", "geos"}]}], "}"}], "]"}]}], 
         "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"sc", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "Infinity"}], "}"}]}], "}"}]}],
      "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8ab11604-40e7-471d-8e23-bfa63226fa61"],

