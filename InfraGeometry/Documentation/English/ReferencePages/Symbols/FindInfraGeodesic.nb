Cell[TextData[{
 "All geodesics of 4 edges from the centre, as the scale grows: every walk at \
scale 1, the walks that never step back at scale 2, the shortest paths at \
scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65bc8ddd-424e-4df4-a04d-d7d141e701f4"],
 "."
}], "ExampleText",ExpressionUUID->"6c9b6b28-dd63-48ce-9f41-41e6198d51cc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Row", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"geos", " ", "=", " ", 
          RowBox[{"FindInfraGeodesic", "[", 
           RowBox[{"g", ",", " ", "a", ",", " ", "sc", ",", " ", 
            RowBox[{"{", "4", "}"}], ",", " ", "All"}], "]"}]}], "}"}], ",", 
        "\n", "      ", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"geos", ",", " ", "a"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<scale \>\"", ",", " ", "sc", ",", " ", "\"\<: \>\"", 
             ",", " ", 
             RowBox[{"Length", " ", "@", " ", "geos"}]}], "}"}], "]"}]}], 
         "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"sc", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "Infinity"}], "}"}]}], "}"}]}],
      "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"af5f2b85-f4ce-4b74-9f48-9fca167ddbe8"],

