Notebook[{

Cell[CellGroupData[{
Cell["FindInfraGeodesic", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3182ed17-80ed-4512-ad7c-6ec1e56bad0f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "593ed6e1-7da0-4dd4-bca3-94cae582a50b"],
 "\[LineSeparator]",
 "gives one geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " starting at ",
 StyleBox["p", "TI"],
 ", with a length inside the budget ",
 StyleBox["kspec", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d45e0517-1e4c-4046-b0b5-ce296d90862f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e733fa83-f212-45c4-a593-6eb69823d65c"],
 "\[LineSeparator]",
 "gives one geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"569bb034-e3bf-4f9b-bacc-91a41b0843c1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07cb47e7-249a-47a7-9826-2f7a5377cab5"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9920eea-1b2d-4b37-8a71-cbc36f44e9c2"],
 " of exactly ",
 StyleBox["n", "TI"],
 " geodesics or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d24455f-6a8c-410a-a308-fa7dc851bbcc"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9397b01-6a38-44e5-a291-461edbd1c7d2"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e381774-9424-4402-be83-6374810ecc61"],
 " gives every one."
}], "Usage",ExpressionUUID->"b029341c-ec18-4666-9542-5e6b48a86928"],

Cell[TextData[{
 "Definition: a walk ",
 StyleBox["v0", "TI"],
 ", ",
 StyleBox["v1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["vk", "TI"],
 " is a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " when every window of ",
 StyleBox["s", "TI"],
 " consecutive vertices together with the next one is a shortest path: ",
 StyleBox["d(v(i\[Minus]s), vi) = s", "TI"],
 " for every ",
 StyleBox["i \[GreaterEqual] s", "TI"],
 ", and ",
 StyleBox["d(v0, vi) = i", "TI"],
 " for ",
 StyleBox["i < s", "TI"],
 "."
}], "Notes",ExpressionUUID->"509feb43-4074-449f-ada9-db16c711c8a3"],

Cell[TextData[{
 "The scale is how far back the observer sees. At scale ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33b71933-79e4-4513-9484-b3bf77e27ab3"],
 " the condition asks only for adjacency, so every walk is a geodesic. At \
scale ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "195361c6-3a28-4110-a3af-e0dcd4031e2e"],
 " it forbids stepping back, and on a graph with triangles also cutting a \
triangle's corner. At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7077551-3cfd-4cb4-9e8e-a1328ff5b77e"],
 " the whole walk is a shortest path, a segment. In between, a geodesic is \
locally shortest and may be globally long: it can wind round a square at \
scale ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "704dabb5-d2ad-4378-80be-49245fa87a77"],
 ", and round a larger loop at scale ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7739797f-4eba-4483-aaa1-2e18f0c15361"],
 "."
}], "Notes",ExpressionUUID->"fccbe8e1-b915-43e6-b1c5-3d24c8c90ce0"],

Cell[TextData[{
 "This is the Riemannian geodesic read by an observer with a horizon. On a \
manifold a geodesic minimises length between nearby points only, and it need \
not be the shortest path between its ends. At infra-scale ",
 StyleBox["s", "TI"],
 " the same holds with \"nearby\" meaning \"fewer than ",
 StyleBox["s", "TI"],
 " steps apart\"."
}], "Notes",ExpressionUUID->"687a69a7-367c-4bcf-8eab-5cca804858fb"],

Cell[TextData[{
 StyleBox["kspec", "TI"],
 " is the length budget in edges: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "885df0b2-6ed3-4dfa-adcd-6c02f5bff96f"],
 " (at most ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "542b5327-4f2f-4e1e-8dcd-4a180532b185"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0356059f-0f3a-4832-a5c5-46d2d6af1702"],
 ", or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90a42459-9c29-4722-846d-a9c91fd5d6f9"],
 ". At a finite scale the class is infinite, so a finite budget is required; \
only scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94ecc3b9-65e0-43cc-a9e3-cc27e944b5cf"],
 " accepts ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4cde4912-3a6c-4e57-ae01-8fd3168938c6"],
 "."
}], "Notes",ExpressionUUID->"52f70cc5-d95a-4afd-8a02-d2fafe6cf48f"],

Cell[TextData[{
 "A geodesic is a walk graph: a directed path graph on the pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "v"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5f559bb-8d7a-4c79-ba1f-1c8da3a9849f"],
 ", the position and the vertex. ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb2f6e20-171e-4b7d-a4d7-3d885378f7d9"],
 " is its vertex sequence, and ",
 Cell[BoxData[
  RowBox[{"EdgeCount", "[", "w", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9e58556-6df7-44e6-9773-e94a1901988b"],
 " its length. The count-less call returns one walk graph, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe7848dd-1f27-42a6-ae33-457700ec6f41"],
 " when there is none."
}], "Notes",ExpressionUUID->"cf8f68e2-72d6-4a36-990e-7ffda17e6d7f"],

Cell[TextData[{
 "The search reads only the window, never the target. At a finite scale the \
two-point form keeps the walks that happen to end at ",
 StyleBox["q", "TI"],
 ", so a walk can pass ",
 StyleBox["q", "TI"],
 " and come back. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "54197479-5c28-43ef-aa15-beedb21d7d9a"],
 " is the target-aware search at scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd746395-6047-4f56-9202-61b0b3e89d11"],
 "."
}], "Notes",ExpressionUUID->"845d5730-7568-4745-95c0-3bb7cc481c73"],

Cell[TextData[{
 Cell[BoxData["FindInfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "004d4bed-7d7f-4ea9-b2cf-3474004545f8"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8f10b81a-37f1-42d4-a095-3af27e78eeb1"],
 " at ",
 Cell[BoxData[
  RowBox[{"\"\<InfraScale\>\"", " ", "->", " ", "s"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76d0120a-7365-4ab3-ae32-174533ed9d33"],
 " with ",
 Cell[BoxData["\"\<Minimizing\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e769b268-7116-49d1-b250-ab785220a362"],
 " added to the rules. The options are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "befb1b67-051a-455e-bd9c-3698f54a2f1b"],
 ":"
}], "Notes",ExpressionUUID->"7e32a33a-ddcf-4488-b726-fe06cc5dd56a"],

