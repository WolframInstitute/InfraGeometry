Notebook[{

Cell[CellGroupData[{
Cell["FindInfraGeodesic", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"77562700-486c-4cbe-8498-645991f1adcc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02a3d4b0-9836-46e4-a785-78e3d8ada861"],
 "\[LineSeparator]",
 "gives one geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " grown from ",
 StyleBox["germ", "TI"],
 ", with a length inside the budget ",
 StyleBox["kspec", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"9b33deec-f268-442c-9f18-11462f94b0a0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aaff80e1-8d78-4455-be73-7addc4474077"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e988854-3851-4054-8ce6-8b314621cfba"],
 " of exactly ",
 StyleBox["n", "TI"],
 " geodesics or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa15b351-5b60-4675-b165-f19c0081bdcc"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ac30aaa-d958-498d-88c4-3f2d2300f088"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc2f5da0-07e4-467a-9dfa-c4105556d45e"],
 " gives every one."
}], "Usage",ExpressionUUID->"4b024ec9-54d0-490a-bb5f-84bbeb724fd2"],

Cell[TextData[{
 "Definition: a walk ",
 StyleBox["v0", "TI"],
 ", ",
 StyleBox["v1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["vk", "TI"],
 " is a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " when every window of ",
 StyleBox["s", "TI"],
 " consecutive vertices together with the next one is a shortest path: ",
 StyleBox["d(v(i\[Minus]s), vi) = s", "TI"],
 " for every ",
 StyleBox["i \[GreaterEqual] s", "TI"],
 ", and ",
 StyleBox["d(v0, vi) = i", "TI"],
 " for ",
 StyleBox["i < s", "TI"],
 "."
}], "Notes",ExpressionUUID->"d28a617a-c454-40e5-9957-ef25181e2fc3"],

Cell[TextData[{
 "The scale is how far back the observer sees. At scale ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e205fef6-9e72-482f-a7ef-390450174a57"],
 " the condition asks only for adjacency, so every walk is a geodesic. At \
scale ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca88ddd7-10ef-4ccf-ad4b-0b549c7e0624"],
 " it forbids stepping back, and on a graph with triangles also cutting a \
triangle's corner. At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4da61062-7996-4dff-bc96-814057d3b95a"],
 " the whole walk is a shortest path, a segment. In between, a geodesic is \
locally shortest and may be globally long: it can wind round a square at \
scale ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc723ef0-c50e-41e0-ad56-4e921d8c4e19"],
 ", and round a larger loop at scale ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5b1af9e-a643-4949-9520-4fa67c5680b1"],
 "."
}], "Notes",ExpressionUUID->"7cb7e01e-d980-4f6f-8565-a2dae4eac9b1"],

Cell[TextData[{
 "This is the Riemannian geodesic read by an observer with a horizon. On a \
manifold a geodesic minimises length between nearby points only, and it need \
not be the shortest path between its ends. At infra-scale ",
 StyleBox["s", "TI"],
 " the same holds with \"nearby\" meaning \"fewer than ",
 StyleBox["s", "TI"],
 " steps apart\"."
}], "Notes",ExpressionUUID->"5054a7ee-0382-4317-a4d6-f1adb4f0ba94"],

Cell[TextData[{
 "The germ is a vertex, a vertex list, a walk graph, or a list of germs; a \
vertex is the one-vertex germ, and the germ must itself be a geodesic at \
scale ",
 StyleBox["s", "TI"],
 " for anything to grow. ",
 StyleBox["kspec", "TI"],
 " is the budget in edges added on each growing side: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a318486e-8f4a-4df4-bb4d-7e74e9ed2ab6"],
 " (at most ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30b079df-4dbb-41f3-8b96-cbc1f2be1d69"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2739dd71-7ff1-40cb-a359-a56f7fb91dc3"],
 ", or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eda345e9-c333-4f93-aae8-834500618c8d"],
 ". A bare integer is no ",
 StyleBox["kspec", "TI"],
 ". At a finite scale the class is infinite, so a finite budget is required; \
only scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c40f421e-284e-418b-948f-f4fc063530a9"],
 " accepts ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c5ff9cc-ff17-4b3a-9705-e19fa19d5801"],
 "."
}], "Notes",ExpressionUUID->"37a81afa-dd81-476a-b3d5-9a484b755f28"],

Cell[TextData[{
 "The default ",
 Cell[BoxData["\"\<Direction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e5121b8-f647-49a3-9b0e-cc1dd1ce154f"],
 " is ",
 Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e53a4a7a-2899-4caa-95c0-b7c35d44cd6d"],
 " on a one-vertex germ and ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6032251a-4fb5-4a4c-9603-a10be90b0a5a"],
 " on a longer one, as for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "53ff08e7-ba86-4f7b-9194-5e6ae088de7b"],
 ". At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e01d4685-4fca-4cee-a880-ade83baa9149"],
 " a walk germ grown on both sides gives the geodesics that contain it."
}], "Notes",ExpressionUUID->"354a6455-5953-4bfc-9669-bbfb37733b1f"],

Cell[TextData[{
 "A geodesic is a walk graph: a directed path graph on the pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "v"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92ec4845-5dc7-47f6-9445-b3e79ddcdffd"],
 ", the position and the vertex. ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad84822e-0f9f-4e7e-9ae8-9668404dee52"],
 " is its vertex sequence, and ",
 Cell[BoxData[
  RowBox[{"EdgeCount", "[", "w", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f2437d0-3bc4-456c-869c-761d1d1d45e1"],
 " its length. The count-less call returns one walk graph, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b712a2ed-b3a5-41e5-b81d-b4ceb6d7006e"],
 " when there is none."
}], "Notes",ExpressionUUID->"e36ef635-52fe-4000-a085-4ff49db47512"],

Cell[TextData[{
 "The search reads only the window, never a target. A target is a stopping \
condition: ",
 Cell[BoxData[
  RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "q"}], " ", "&"}], 
    ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6175a6ba-389a-43eb-b3c2-2f1bfdcdb3cd"],
 " stops each geodesic at its first arrival at ",
 StyleBox["q", "TI"],
 ", and the geodesics that end at ",
 StyleBox["q", "TI"],
 " are the ones left by ",
 Cell[BoxData["Select"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "596d0a50-d964-41aa-895a-36628128c348"],
 ". At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "987f8fe4-0c3f-475c-b2a0-22ff93ddfecc"],
 " the target-aware search is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "31e0385f-9d97-4fc5-8833-fa5d912e7052"],
 "."
}], "Notes",ExpressionUUID->"c7944e74-6f4d-42d4-86c6-cae8bd26e474"],

Cell[TextData[{
 Cell[BoxData["FindInfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1336c97-e778-43d1-b824-9600a98533aa"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3b7c3acf-0d6b-4fd0-a746-131e6f1ce2b4"],
 " at ",
 Cell[BoxData[
  RowBox[{"\"\<InfraScale\>\"", " ", "->", " ", "s"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b797686-ff9d-4f2c-bd28-c6c45d442ae4"],
 " with ",
 Cell[BoxData["\"\<Minimizing\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "418aa5ac-71e6-47c5-992a-7d2ab7b53fd4"],
 " added to the rules. The options are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "69767d63-8fa6-44f2-b517-18b556e1de46"],
 ":"
}], "Notes",ExpressionUUID->"dc001654-bc16-4b90-be32-97e6a379781b"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fbcef217-42a7-4b48-a912-6dae413068d0"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"19de94ad-bbd4-482d-bf64-3587323f951f"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"34b873cb-86f9-4434-9048-2dda28188051"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"bb84cdd7-f448-46b6-9dc2-3c2612b26b69"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "21d3919b-9968-40d0-bef9-a55124acaaa6"], Cell[TextData[Cell[BoxData[
    "Properties"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "576af38c-ea65-4b4c-b8fd-c7075cd5f7a4"]], "TableText",ExpressionUUID->
     "f53605a8-ac49-450a-bedd-0288762bd242"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "67cfdf49-e76d-415a-809b-60b1f1fd8711"]], "TableText",ExpressionUUID->
     "7c8f3bf6-1e71-48db-904c-0ed0055e7c9e"], Cell[TextData[{
     "further walk rules, each read on the window: ",
     Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a897e48a-ac2e-4218-b425-fde6a124704d"],
     ", ",
     Cell[BoxData["\"\<Immersed\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c82021fd-1444-4ba4-9bcd-2782f9f92f88"],
     ", ",
     Cell[BoxData["\"\<Generic\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "abe2c2c1-ae1c-4e3a-9cbd-0caf3dc19063"],
     ", ",
     Cell[BoxData[
      RowBox[{"\"\<Exclude\>\"", " ", "->", " ", "species"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ce0b884d-602b-4dda-beea-152ee92094c4"],
     ", or a predicate on the window"
    }], "TableText",ExpressionUUID->"3ffcb576-2678-48e2-a72a-6b7a2fd25f61"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "488125af-2201-4213-9c14-0590d6d41ba5"], Cell[TextData[Cell[
    BoxData["\"\<StoppingCondition\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c099a050-6d09-45da-b83e-4bb79e3bb479"]], "TableText",ExpressionUUID->
     "9f07529d-62af-48b0-9428-a0d59860c94d"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "911f9496-fe4e-4685-9b9b-18c3dc9c1d9e"]], "TableText",ExpressionUUID->
     "d3311c39-65c6-4a8f-a1ce-5c2d8ead3218"], Cell[TextData[{
     StyleBox["n", "TI"],
     " (stop at the ",
     StyleBox["n", "TI"],
     "-th return to a visited vertex), a predicate on the walk so far, or ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"spec", ",", " ", 
        RowBox[{"\"\<Delay\>\"", " ", "->", " ", "k"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4e5d6c9c-62ab-4f79-a312-d688379302ea"]
    }], "TableText",ExpressionUUID->"3f3a8efd-ca4d-46dd-9c0d-d5a250bc3f12"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9d6f2b64-83ee-41b2-9d9b-e19e7cd7e512"], Cell[TextData[Cell[
    BoxData["\"\<Direction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d184bf84-65db-4b41-b821-aa159d460216"]], "TableText",ExpressionUUID->
     "2b86e0ce-2b97-4b8d-85ee-a9dcd801b515"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2287c3f6-72bb-4701-8117-d3920542893b"]], "TableText",ExpressionUUID->
     "740e1d90-cd19-4e76-be4b-b53e093929b4"], Cell[TextData[{
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9f803da3-88f8-44ee-98e4-5b6247e75768"],
     ", ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "baf35967-1eed-4da9-8a58-3f391c4f3bcd"],
     " or ",
     Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e5cef588-6187-4a17-8da2-7c2705d7caec"]
    }], "TableText",ExpressionUUID->"e55f83dc-dfda-4d5b-95c2-13cb6f7187ec"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2b3710b3-2194-4ccd-811f-9c3c9e63d024"], Cell[TextData[Cell[
    BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "550cf630-3131-4a81-8a9e-8ae2378943f3"]], "TableText",ExpressionUUID->
     "2db40fdd-1008-4caa-a95b-b9db231d8ad1"], Cell[TextData[Cell[BoxData[
    "Identity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c3b64c54-4fa9-48b1-98d7-2aa019480b35"]], "TableText",ExpressionUUID->
     "dfa1462a-cf36-4b98-b81c-18dab9dc2ec2"], Cell[TextData[{
     "a function of the candidate windows -- the window with one admissible \
candidate appended -- giving the ones to pursue, in the order to try: ",
     Cell[BoxData["Identity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8ca40081-7f34-40db-9fb0-644c6cbc0e0a"],
     " the canonical order, ",
     Cell[BoxData["RandomSample"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c671e82d-31a4-4f54-b572-ada711fd9ebb"],
     " a random order, ",
     Cell[BoxData["RandomChoice"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "d729f6a8-b6de-47d3-8390-c35b727d78dd"],
     " the random walk, ",
     Cell[BoxData[
      RowBox[{"MinimalBy", "[", "f", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "85076f03-a999-4d31-b976-7b98f4f9e03c"],
     " the candidates least by ",
     Cell[BoxData[
      RowBox[{"f", "[", "window", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "fcf93eaf-dc04-4b36-bdc7-7421a5b051ec"],
     ", ",
     Cell[BoxData[
      RowBox[{
       RowBox[{"RandomSample", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"UpTo", "[", "n", "]"}]}], "]"}], " ", "&"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "64bddbb7-2062-4d06-ae6d-6d21b06a2fe7"],
     " a pruning to ",
     StyleBox["n", "TI"],
     " branches per node"
    }], "TableText",ExpressionUUID->"ac7ee598-2028-4aa9-b050-767fe9ce5b1f"]}
  }]], "3ColumnTableMod",ExpressionUUID->"f7699460-7c70-4f28-9a85-\
7989d7e57751"]
}, Open  ]],

