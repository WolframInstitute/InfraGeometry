Cell["\<\
One geodesic at infra-scale 3 of exactly 6 edges from the centre, beside its \
vertex sequence.\
\>", "ExampleText",ExpressionUUID->"13792595-fc68-4098-b62b-1537cc53dedc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"geo", " ", "=", " ", 
     RowBox[{"FindInfraGeodesic", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "3", ",", " ", 
       RowBox[{"{", "6", "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"geo", ",", " ", "a"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Last", " ", "/@", " ", 
      RowBox[{"VertexList", "[", "geo", "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"30aee000-c3e5-4333-8b20-5066a941162a"],

