Cell[TextData[{
 "At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26bd92c0-d733-4f24-bfed-b213a825e9fc"],
 " the geodesics from the centre that end at ",
 StyleBox["b", "TI"],
 " are the members of the segment."
}], "ExampleText",ExpressionUUID->"2d6eba37-a3e2-4c42-b058-6c3088bc69cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "4"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"grown", " ", "=", " ", 
     RowBox[{"FindInfraGeodesic", "[", 
      RowBox[{
      "g", ",", " ", "a", ",", " ", "Infinity", ",", " ", "Infinity", ",", 
       " ", "All", ",", " ", 
       RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "b"}], " ", 
          "&"}], ")"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"geos", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"grown", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Last", " ", "@", " ", 
          RowBox[{"Last", " ", "@", " ", 
           RowBox[{"VertexList", " ", "@", " ", "#"}]}]}], " ", "===", " ", 
         "b"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"geos", ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "a", ",",
          " ", "b"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Last", " ", "/@", " ", 
          RowBox[{"VertexList", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ",
         "geos"}], "]"}], " ", "===", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"FindInfraSegment", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], 
        "]"}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f342a9f9-7a30-4b54-ad3a-373d3f1d06d4"],

