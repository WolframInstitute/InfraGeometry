Cell["NextVertexFunction", "ExampleSubsection",ExpressionUUID->"48c28610-e6a0-4cc6-bae2-3d7dc83e908c"],

Cell[TextData[{
 "Under ",
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21c6d786-2a12-445d-9e9e-eebfec6d58d0"],
 " the geodesic is a random one, one uniform admissible step at a time. Three \
geodesics at infra-scale 2 of 12 edges from the centre, one per seed."
}], "ExampleText",ExpressionUUID->"49bb50d0-95a6-4cc6-8c41-c7c4bd4bd4f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
            RowBox[{"FindInfraGeodesic", "[", 
             RowBox[{"g", ",", " ", "a", ",", " ", "2", ",", " ", 
              RowBox[{"{", "12", "}"}], ",", " ", 
              
              RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
               "RandomChoice"}]}], "]"}]}], ")"}], ",", " ", 
          RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
          "a"}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"seed", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a25def06-a772-449b-a62a-41c82c211a6d"],

