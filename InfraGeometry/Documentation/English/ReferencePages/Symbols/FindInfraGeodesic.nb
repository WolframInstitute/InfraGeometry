     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Quiet", " ", "@", " ", 
      RowBox[{"FindInfraGeodesic", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", "61", ",", " ", "Infinity"}], 
       "]"}]}], ",", " ", 
     RowBox[{"Last", " ", "/@", " ", 
      RowBox[{"VertexList", " ", "@", " ", 
       RowBox[{"FindInfraGeodesic", "[", 
        RowBox[{
        "g", ",", " ", "41", ",", " ", "61", ",", " ", "Infinity", ",", " ", 
         "Infinity"}], "]"}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"11dfb74d-bb19-4d8a-b469-8df18542ffaf"],

