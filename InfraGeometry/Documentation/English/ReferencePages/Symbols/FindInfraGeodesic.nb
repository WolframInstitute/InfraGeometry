Cell["NextVertexFunction", "ExampleSubsection",ExpressionUUID->"c37a28bf-949f-4f30-a274-4dc83711b38e"],

Cell[TextData[{
 "Under ",
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5c7a4ba-05f8-435b-b4b0-f65c942c7ffa"],
 " the geodesic is a random one, one uniform admissible step at a time. Three \
geodesics at infra-scale 2 of 12 edges from the centre, one per seed."
}], "ExampleText",ExpressionUUID->"922d8d75-1fd6-4e43-99f0-cbe81e575e73"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
            RowBox[{"FindInfraGeodesic", "[", 
             RowBox[{"g", ",", " ", "a", ",", " ", "2", ",", " ", 
              RowBox[{"{", "12", "}"}], ",", " ", 
              
              RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
               "RandomChoice"}]}], "]"}]}], ")"}], ",", " ", "a"}], "}"}]}], 
       "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"seed", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"61b14e28-34aa-4727-b3a7-0f64c8cc93be"],

