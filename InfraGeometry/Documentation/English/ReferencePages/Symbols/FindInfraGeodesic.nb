Cell[TextData[{
 "On a substrate labelled by integers the third argument is read as the scale \
whenever the rest parses as a budget and a count. So ",
 Cell[BoxData[
  RowBox[{"FindInfraGeodesic", "[", 
   RowBox[{"g", ",", " ", "41", ",", " ", "61", ",", " ", "Infinity"}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab3caf70-7459-4000-84e1-20451395f75e"],
 " asks for geodesics from 41 at scale 61, with no budget, and is refused \
with a ",
 Cell[BoxData[
  RowBox[{"FindInfraWalk", "::", "unbounded"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d040e580-a9f8-4a28-a8c1-b3cc06f3463a"],
 " message. Give the budget explicitly in the two-point form."
}], "ExampleText",ExpressionUUID->"c25028a8-45ca-42cf-8d32-df572543a3ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Quiet", " ", "@", " ", 
      RowBox[{"FindInfraGeodesic", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", "61", ",", " ", "Infinity"}], 
       "]"}]}], ",", " ", 
     RowBox[{"Last", " ", "/@", " ", 
      RowBox[{"VertexList", " ", "@", " ", 
       RowBox[{"FindInfraGeodesic", "[", 
        RowBox[{
        "g", ",", " ", "41", ",", " ", "61", ",", " ", "Infinity", ",", " ", 
         "Infinity"}], "]"}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6ecf9edd-b358-48a7-8ad4-a3c81ae39544"],

