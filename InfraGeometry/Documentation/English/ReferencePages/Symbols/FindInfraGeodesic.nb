Cell[CellGroupData[{
Cell["FindInfraGeodesic", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ee023ddd-8cde-44e6-b3bd-3c5b6d1b6629"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48bf2bba-e37c-46ac-a7cf-e4fc52e52598"],
 "\[LineSeparator]",
 "gives one geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " starting at ",
 StyleBox["p", "TI"],
 ", with a length inside the budget ",
 StyleBox["kspec", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3b334487-c92d-4b92-8e62-55e22ab59a90"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bc0c7ad-7749-4aa4-92df-a33c24102141"],
 "\[LineSeparator]",
 "gives one geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"30482021-e751-424d-9202-81ad33c98571"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8be419a-b6e2-4dc2-b092-5d78f5a3be7f"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51cfb6fa-3284-4b29-957e-a4a0a1ab4b1f"],
 " of exactly ",
 StyleBox["n", "TI"],
 " geodesics or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9f1d124-f4d3-4874-a20a-1b4b43a58413"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce6e5d70-8375-4272-a4b8-82e8ccb048bd"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "401ad29d-a795-489b-ba17-f1a195b85a07"],
 " gives every one."
}], "Usage",ExpressionUUID->"d6a951fd-b127-4e56-9a18-46ff3ff769a0"],

Cell[TextData[{
 "Definition: a walk ",
 StyleBox["v0", "TI"],
 ", ",
 StyleBox["v1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["vk", "TI"],
 " is a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " when every window of ",
 StyleBox["s", "TI"],
 " consecutive vertices together with the next one is a shortest path: ",
 StyleBox["d(v(i\[Minus]s), vi) = s", "TI"],
 " for every ",
 StyleBox["i \[GreaterEqual] s", "TI"],
 ", and ",
 StyleBox["d(v0, vi) = i", "TI"],
 " for ",
 StyleBox["i < s", "TI"],
 "."
}], "Notes",ExpressionUUID->"b6958d8c-d874-4f24-a9dd-e8b3c72b393a"],

Cell[TextData[{
 "The scale is how far back the observer sees. At scale ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79271bc4-8e59-4e77-946e-5fa1c4a41dfa"],
 " the condition asks only for adjacency, so every walk is a geodesic. At \
scale ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43070fd2-10b5-402c-8e6f-b926066f27c1"],
 " it forbids stepping back, and on a graph with triangles also cutting a \
triangle's corner. At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d71b86a-09f2-4fad-a039-3c09bcf97810"],
 " the whole walk is a shortest path, a segment. In between, a geodesic is \
locally shortest and may be globally long: it can wind round a square at \
scale ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b405ba9-54a3-4d6f-b6c5-098d9c168213"],
 ", and round a larger loop at scale ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b94ee1d-0eaa-4857-80a2-c6ffd49e4d37"],
 "."
}], "Notes",ExpressionUUID->"f2a4bd21-63de-412d-a814-5aab74fae9a2"],

Cell[TextData[{
 "This is the Riemannian geodesic read by an observer with a horizon. On a \
manifold a geodesic minimises length between nearby points only, and it need \
not be the shortest path between its ends. At infra-scale ",
 StyleBox["s", "TI"],
 " the same holds with \"nearby\" meaning \"fewer than ",
 StyleBox["s", "TI"],
 " steps apart\"."
}], "Notes",ExpressionUUID->"443b7cfe-e866-4d2c-8cc0-6549613e1a99"],

Cell[TextData[{
 StyleBox["kspec", "TI"],
 " is the length budget in edges: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0075dcf2-02ff-4569-9416-c34e9f663d2e"],
 " (at most ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d77e653-c8a2-4d05-a74e-90b29087ccf0"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f264c8e8-bad7-4984-96ad-ad4e9fac6bd3"],
 ", or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36765696-b770-4b14-93c4-a2b8f3078f42"],
 ". At a finite scale the class is infinite, so a finite budget is required; \
only scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76e1aa1e-6b4a-4da3-8bbd-e112ee4f02fc"],
 " accepts ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42c5e437-d833-490a-a14e-7664df751bed"],
 "."
}], "Notes",ExpressionUUID->"e065cbc1-7fe4-499b-9718-ee433f5cfb89"],

Cell[TextData[{
 "A geodesic is a walk graph: a directed path graph on the pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "v"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7394c689-3631-4b61-9c33-5e459a0edbab"],
 ", the position and the vertex. ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be99ee0c-3739-40bc-b55b-ebb8515c277e"],
 " is its vertex sequence, and ",
 Cell[BoxData[
  RowBox[{"EdgeCount", "[", "w", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b5105ef-b242-4eae-b6ab-02aedc1de6b9"],
 " its length. The count-less call returns one walk graph, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f68202f-c541-4462-a8b5-4b29aeecd950"],
 " when there is none."
}], "Notes",ExpressionUUID->"78ffdabf-dd9b-4059-b2fe-6405e57a0fb0"],

Cell[TextData[{
 "The search reads only the window, never the target. At a finite scale the \
two-point form keeps the walks that happen to end at ",
 StyleBox["q", "TI"],
 ", so a walk can pass ",
 StyleBox["q", "TI"],
 " and come back. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5bc12cf6-683e-45d4-a787-bf3ce38c9d9c"],
 " is the target-aware search at scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe2b68d8-76ee-4e60-91fe-b4ac7a9a52ae"],
 "."
}], "Notes",ExpressionUUID->"b66da6e6-013c-4c93-b6f8-3ce4d797a663"],

Cell[TextData[{
 Cell[BoxData["FindInfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5b453b7-e0cd-4e01-bff6-10aa4c745cae"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
