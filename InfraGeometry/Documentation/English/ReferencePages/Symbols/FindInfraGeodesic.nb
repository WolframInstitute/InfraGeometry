Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "4"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"geos", " ", "=", " ", 
     RowBox[{"FindInfraGeodesic", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "3", ",", " ", 
       RowBox[{"UpTo", "[", "8", "]"}], ",", " ", "All"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"geos", ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "a", ",",
          " ", "b"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"InfraGeodesicQ", "[", 
      RowBox[{"g", ",", " ", "geos", ",", " ", "3"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f7e86846-6aa6-441f-a696-49bf3cac269b"],

