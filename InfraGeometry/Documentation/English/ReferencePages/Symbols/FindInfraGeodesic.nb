   {Cell["      ", "ModInfo",ExpressionUUID->
     "15667728-1f02-4984-b979-713b2e0c4e4b"], Cell[TextData[Cell[BoxData[
    "Properties"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5f6e6e4b-74cc-4c8a-9fd6-00510324652c"]], "TableText",ExpressionUUID->
     "d96a549d-4fef-4db3-81bd-4fa1a3ab2e08"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c74ee3af-a515-4887-9e0b-df651d46d54c"]], "TableText",ExpressionUUID->
     "5404eced-f6c9-4a5f-89e6-41626d354718"], Cell[TextData[{
     "further walk rules, each read on the window: ",
     Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7953f4e5-3e18-49e8-9ba1-37b9efee18ca"],
     ", ",
     Cell[BoxData["\"\<Immersed\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0caaa143-33b8-426a-8f5f-0b7127628bb0"],
     ", ",
     Cell[BoxData["\"\<Generic\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ca39ad14-390d-4b7a-8412-64cff936d6a3"],
     ", ",
     Cell[BoxData[
      RowBox[{"\"\<Exclude\>\"", " ", "->", " ", "species"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5aad828a-830b-4d50-a2fe-c614dbf1a581"],
     ", or a predicate on the window"
    }], "TableText",ExpressionUUID->"ec12554e-fe36-49e5-a2d2-a680a32e2ea7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f84776d0-5df8-4dbd-aa88-8e4328829b57"], Cell[TextData[Cell[
    BoxData["\"\<StoppingCondition\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9af6f540-8556-4c0e-b4f6-9b57270b95a3"]], "TableText",ExpressionUUID->
     "682ffa58-97ab-4776-8a03-c45a42fead41"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a632fba8-b0bd-4de8-af8c-15cc2aba5034"]], "TableText",ExpressionUUID->
     "567d2382-eedc-4533-b7a4-5106c98e6e18"], Cell[TextData[{
     StyleBox["n", "TI"],
     " (stop at the ",
     StyleBox["n", "TI"],
     "-th return to a visited vertex), a predicate on the walk so far, or ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"spec", ",", " ", 
        RowBox[{"\"\<Delay\>\"", " ", "->", " ", "k"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "19aa60e2-bfac-45c1-b89c-f1b7af8130e4"]
    }], "TableText",ExpressionUUID->"3a83bb80-4dc4-4cf0-ab6f-1b8e857b90cd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "943178ee-65c8-444b-843a-0f970a64ec58"], Cell[TextData[Cell[
    BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "53c9b4e5-59ed-4943-8a98-3019f9e2ccc1"]], "TableText",ExpressionUUID->
     "39ae99d8-a243-40b8-b650-f7cae3cec86c"], Cell[TextData[Cell[BoxData[
    "Identity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f4e95858-1040-48d9-81d7-b6f5886ca37d"]], "TableText",ExpressionUUID->
     "b90ffdb8-17c1-4850-98f3-da8c85b47a47"], Cell[TextData[{
     "a function of the candidate windows -- the window with one admissible \
candidate appended -- giving the ones to pursue, in the order to try: ",
     Cell[BoxData["Identity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5a31afbc-4c3d-4431-a198-83f3b9a068c6"],
     " the canonical order, ",
     Cell[BoxData["RandomSample"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c530b1de-b06c-4c94-a31f-a2ffee79ae33"],
     " a random order, ",
     Cell[BoxData["RandomChoice"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5fa38c02-f69c-4a9b-ac9b-6f6c9efb8c68"],
     " the random walk, ",
     Cell[BoxData[
      RowBox[{"MinimalBy", "[", "f", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "47422ce9-0d3c-4318-b1bf-072bd5ca2a92"],
     " the candidates least by ",
     Cell[BoxData[
      RowBox[{"f", "[", "window", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5213f91b-4104-43de-9f7e-e8cbf9c945b2"],
     ", ",
     Cell[BoxData[
      RowBox[{
       RowBox[{"RandomSample", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"UpTo", "[", "n", "]"}]}], "]"}], " ", "&"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1a733492-c60f-4513-a71c-34a0a1570fc7"],
     " a pruning to ",
     StyleBox["n", "TI"],
     " branches per node"
    }], "TableText",ExpressionUUID->"473d88db-a572-4a12-92c9-e1c9a7e6860a"]}
  }]], "3ColumnTableMod",ExpressionUUID->"723570ec-fbe8-4126-ae2a-\
5e00e7afe9b2"]
}, Open  ]],

