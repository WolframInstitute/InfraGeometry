Cell["\<\
One geodesic at infra-scale 3 of exactly 6 edges from the centre, beside its \
vertex sequence.\
\>", "ExampleText",ExpressionUUID->"7e5eb67a-828c-4370-b0ab-a93638be3d83"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"geo", " ", "=", " ", 
     RowBox[{"FindInfraGeodesic", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "3", ",", " ", 
       RowBox[{"{", "6", "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"geo", ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "a"}],
         "}"}]}], "]"}], ",", " ", 
     RowBox[{"Last", " ", "/@", " ", 
      RowBox[{"VertexList", "[", "geo", "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"09af481c-f7ff-425f-ab37-fd13f9f4ac3f"],

