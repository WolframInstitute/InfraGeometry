Cell[TextData[{
 "All geodesics of 4 edges from the centre, as the scale grows: every walk at \
scale 1, the walks that never step back at scale 2, the shortest paths at \
scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d939833a-c809-4127-aaef-dd358b381ede"],
 "."
}], "ExampleText",ExpressionUUID->"f862f529-dc07-4019-b747-341c12e867f4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Row", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"geos", " ", "=", " ", 
          RowBox[{"FindInfraGeodesic", "[", 
           RowBox[{"g", ",", " ", "a", ",", " ", "sc", ",", " ", 
            RowBox[{"{", "4", "}"}], ",", " ", "All"}], "]"}]}], "}"}], ",", 
        "\n", "      ", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"geos", ",", " ", 
              RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
              "a"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<scale \>\"", ",", " ", "sc", ",", " ", "\"\<: \>\"", 
             ",", " ", 
             RowBox[{"Length", " ", "@", " ", "geos"}]}], "}"}], "]"}]}], 
         "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"sc", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "Infinity"}], "}"}]}], "}"}]}],
      "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"707ed8e8-95f1-40b3-8fb9-4afee7b94a05"],

