   {Cell["      ", "ModInfo",ExpressionUUID->
     "34a440f4-35d6-4185-a81b-d6ea045e1c97"], Cell[TextData[Cell[BoxData[
    "Properties"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ffd28dc8-1b87-48ea-ac01-ffcfabfe3bbb"]], "TableText",ExpressionUUID->
     "87722982-f4c6-4614-9691-a0e4bef0d9ac"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "736ada4b-02f5-4e32-a4c8-f985d506263e"]], "TableText",ExpressionUUID->
     "1006cadc-d782-4ff2-805c-540e1e1005c9"], Cell[TextData[{
     "further walk rules, each read on the window: ",
     Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8cc6bf1a-cf76-402f-8a56-4d26a84b8efc"],
     ", ",
     Cell[BoxData["\"\<Immersed\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2e880fec-91de-4e45-8bef-c834fe0fe89c"],
     ", ",
     Cell[BoxData["\"\<Generic\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b7441a25-7428-42e4-a9a4-de199858a1d3"],
     ", ",
     Cell[BoxData[
      RowBox[{"\"\<Exclude\>\"", " ", "->", " ", "species"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "dce14842-564c-4cc3-9d74-bc840bbb30fb"],
     ", or a predicate on the window"
    }], "TableText",ExpressionUUID->"62786efa-30fd-4db6-9b3f-1db935bbbd93"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4ad0a553-1708-49cb-b82b-8ee88808651b"], Cell[TextData[Cell[
    BoxData["\"\<StoppingCondition\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9beed840-db23-4045-9897-497433fabb39"]], "TableText",ExpressionUUID->
     "35277f85-1a76-4041-9686-837b907c2763"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ad75f9df-1a75-450f-8030-b3930ef79817"]], "TableText",ExpressionUUID->
     "28c37907-ea9b-4ddd-9d2e-3f7c3e7f9f0f"], Cell[TextData[{
     StyleBox["n", "TI"],
     " (stop at the ",
     StyleBox["n", "TI"],
     "-th return to a visited vertex), a predicate on the walk so far, or ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"spec", ",", " ", 
        RowBox[{"\"\<Delay\>\"", " ", "->", " ", "k"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "77f6de24-7286-49e5-8364-21bb3126c799"]
    }], "TableText",ExpressionUUID->"407bb2c5-d032-4eac-b5a1-9a5af1d37de2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7d94a459-f165-425b-a7ed-c5f48f22027b"], Cell[TextData[Cell[
    BoxData["\"\<Direction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "01234142-14d3-4110-8cb1-9691cae26f16"]], "TableText",ExpressionUUID->
     "701468cc-0dcc-4294-b004-d555565eae5b"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0925dea5-d36c-4e8c-8c49-efb0f782eba5"]], "TableText",ExpressionUUID->
     "70311c79-8321-4f5d-b668-d7f9de3b0c4c"], Cell[TextData[{
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "29859d8e-39bd-48ce-9982-92322b64ace2"],
     ", ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "cedb9a11-de67-4833-8832-31147cf039ba"],
     " or ",
     Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "291eaac7-e0d6-443f-a131-c1ea35864068"]
    }], "TableText",ExpressionUUID->"665aed80-6a9e-4c05-ad43-7636753f9618"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "549b1632-74e3-495f-8244-88deeafa880d"], Cell[TextData[Cell[
    BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f8fe5fea-6fff-4c61-b326-4283ba84d181"]], "TableText",ExpressionUUID->
     "e391e2b1-e434-478a-901b-efcab1c21735"], Cell[TextData[Cell[BoxData[
    "Identity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c4fccf5e-84fe-46d0-9b5c-1da9a3fed702"]], "TableText",ExpressionUUID->
     "c9eef6b7-19db-4d6b-8c99-4ead87436193"], Cell[TextData[{
     "a function of the candidate windows -- the window with one admissible \
candidate appended -- giving the ones to pursue, in the order to try: ",
     Cell[BoxData["Identity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "93b81dab-b89e-4320-9c7a-89ecc2f1a879"],
     " the canonical order, ",
     Cell[BoxData["RandomSample"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "93d4de6e-2333-4a57-8435-fbd21d89b7a3"],
     " a random order, ",
     Cell[BoxData["RandomChoice"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6e1fac14-ef3a-4177-8339-f35873d26d36"],
     " the random walk, ",
     Cell[BoxData[
      RowBox[{"MinimalBy", "[", "f", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0e551b6d-9f48-45ad-beca-c5dcfc5d3a04"],
     " the candidates least by ",
     Cell[BoxData[
      RowBox[{"f", "[", "window", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "339818c0-22e5-4199-bf29-a5b8d8a39088"],
     ", ",
     Cell[BoxData[
      RowBox[{
       RowBox[{"RandomSample", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"UpTo", "[", "n", "]"}]}], "]"}], " ", "&"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "df2c2324-549b-4f39-9163-d6cd2496558a"],
     " a pruning to ",
     StyleBox["n", "TI"],
     " branches per node"
    }], "TableText",ExpressionUUID->"9d740ed6-5b82-45e7-a7b1-3d7e36bd6184"]}
  }]], "3ColumnTableMod",ExpressionUUID->"db6a0451-13cd-45cf-9854-\
830b8cd070fb"]
