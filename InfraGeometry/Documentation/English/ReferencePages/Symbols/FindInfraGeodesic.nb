Notebook[{

Cell[CellGroupData[{
Cell["FindInfraGeodesic", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"da5d6096-2070-44dc-8e02-239dbbdc2b97"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae89044a-d997-4a3d-b3cb-ea24a722a6b3"],
 "\[LineSeparator]",
 "gives one geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " grown from ",
 StyleBox["germ", "TI"],
 ", with a length inside the budget ",
 StyleBox["kspec", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d0ac17ce-1c0d-44c8-9219-2a710b4bbf42"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f52fd945-e992-4337-a3d3-72b77239a863"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "452c49f6-0b7b-49bc-8a49-9ff1c864df54"],
 " of exactly ",
 StyleBox["n", "TI"],
 " geodesics or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "407b5d92-f351-4736-ad4b-d91938216273"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3f4b3a4-c770-435b-b8cb-92cc9a396aa9"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "282704e8-49af-49e9-b91e-52a1ff30e8c0"],
 " gives every one."
}], "Usage",ExpressionUUID->"bb636488-89dc-4855-bf2d-080f0f50a394"],

Cell[TextData[{
 "Definition: a walk ",
 StyleBox["v0", "TI"],
 ", ",
 StyleBox["v1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["vk", "TI"],
 " is a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " when every window of ",
 StyleBox["s", "TI"],
 " consecutive vertices together with the next one is a shortest path: ",
 StyleBox["d(v(i\[Minus]s), vi) = s", "TI"],
 " for every ",
 StyleBox["i \[GreaterEqual] s", "TI"],
 ", and ",
 StyleBox["d(v0, vi) = i", "TI"],
 " for ",
 StyleBox["i < s", "TI"],
 "."
}], "Notes",ExpressionUUID->"186cf0cc-c83f-4634-99fc-b61bdc4775a8"],

Cell[TextData[{
 "The scale is how far back the observer sees. At scale ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cc0618d-c56a-4e53-9b37-ccfc869c6935"],
 " the condition asks only for adjacency, so every walk is a geodesic. At \
scale ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6290e53f-962f-43c7-aaaf-9ba11847949e"],
 " it forbids stepping back, and on a graph with triangles also cutting a \
triangle's corner. At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "630bcb48-8148-4341-a554-b05cf3dc6689"],
 " the whole walk is a shortest path, a segment. In between, a geodesic is \
locally shortest and may be globally long: it can wind round a square at \
scale ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e11d8a6-b39c-4c92-959d-21d5a2088ec1"],
 ", and round a larger loop at scale ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c84415c-e9e6-4976-929e-ea0ab98fcc2e"],
 "."
}], "Notes",ExpressionUUID->"27bedfa7-4e47-4da5-8cdc-dca2ace77488"],

Cell[TextData[{
 "This is the Riemannian geodesic read by an observer with a horizon. On a \
manifold a geodesic minimises length between nearby points only, and it need \
not be the shortest path between its ends. At infra-scale ",
 StyleBox["s", "TI"],
 " the same holds with \"nearby\" meaning \"fewer than ",
 StyleBox["s", "TI"],
 " steps apart\"."
}], "Notes",ExpressionUUID->"b2e5659c-af60-4fce-826f-f3039f633900"],

Cell[TextData[{
 "The germ is a vertex, a vertex list, a walk graph, or a list of germs; a \
vertex is the one-vertex germ, and the germ must itself be a geodesic at \
scale ",
 StyleBox["s", "TI"],
 " for anything to grow. ",
 StyleBox["kspec", "TI"],
 " is the budget in edges added on each growing side: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "546c80da-5b23-47da-be59-b7810cc7a43d"],
 " (at most ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc58cbf8-0243-4987-aef4-090712058459"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa261fc9-bea4-43a3-abb5-5dbb3196eff1"],
 ", or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6535678-431c-4859-bf3c-95641dd93ba0"],
 ". A bare integer is no ",
 StyleBox["kspec", "TI"],
 ". At a finite scale the class is infinite, so a finite budget is required; \
only scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f99d2770-013d-4a3d-83e0-50488926a580"],
 " accepts ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c18693e7-efbe-44e8-9a74-96f2cb10a548"],
 "."
}], "Notes",ExpressionUUID->"8533d8dd-50b7-4a64-ac9b-95ee6bfaeffa"],

Cell[TextData[{
 "The default ",
 Cell[BoxData["\"\<Direction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05f9d998-7a26-4950-9110-1e8894f35809"],
 " is ",
 Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ff0e8b5-66db-4615-9572-426256fae668"],
 " on a one-vertex germ and ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dca69c60-ee87-45aa-863d-8a585662791a"],
 " on a longer one, as for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ac13907d-3c6a-47fa-b655-1ad89fa51b68"],
 ". At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07208279-c2d9-4838-9340-9183b06d3671"],
 " a walk germ grown on both sides gives the geodesics that contain it."
}], "Notes",ExpressionUUID->"f89998e4-f39b-426d-b7c7-fca6ffc7a4ba"],

Cell[TextData[{
 "A geodesic is a walk graph: a directed path graph on the pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "v"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61734eb6-47b7-4cb5-9dbc-3cdde6212f88"],
 ", the position and the vertex. ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23a8dd48-73c4-4804-819a-2fbcbe95ad2d"],
 " is its vertex sequence, and ",
 Cell[BoxData[
  RowBox[{"EdgeCount", "[", "w", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "facbeee8-a4ad-45fd-bb18-30c9379e9d45"],
 " its length. The count-less call returns one walk graph, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e996194-1aed-4dc7-abea-db2616a755f9"],
 " when there is none."
}], "Notes",ExpressionUUID->"4efadd13-352f-4e5c-b666-3126c8cd6eb1"],

Cell[TextData[{
 "The search reads only the window, never a target. A target is a stopping \
condition: ",
 Cell[BoxData[
  RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "q"}], " ", "&"}], 
    ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e779b66c-e914-41e0-897b-39407874d532"],
 " stops each geodesic at its first arrival at ",
 StyleBox["q", "TI"],
 ", and the geodesics that end at ",
 StyleBox["q", "TI"],
 " are the ones left by ",
 Cell[BoxData["Select"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0ae44c5-6070-43cc-b2f7-a7956583c37d"],
 ". At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cd94367-4262-4c83-a482-b2f320de3559"],
 " the target-aware search is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3e4bc342-90ad-4b6d-80ab-c9dffa3eb361"],
 "."
}], "Notes",ExpressionUUID->"0768a7e1-75e3-4d08-8a92-23b6461ce4a4"],

Cell[TextData[{
 Cell[BoxData["FindInfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8681221-d7f9-4472-a110-ba3247b88549"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "376823e1-dc87-4641-8871-23e344fdab89"],
 " at ",
 Cell[BoxData[
  RowBox[{"\"\<InfraScale\>\"", " ", "->", " ", "s"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7da59230-eeda-4700-bab0-68e8319aa0d6"],
 " with ",
 Cell[BoxData["\"\<Minimizing\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5af2f08-1eca-470a-81d2-d412f936b47c"],
 " added to the rules. The options are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e57521b6-a9fc-473b-aa67-8ac53a25397e"],
 ":"
}], "Notes",ExpressionUUID->"7a386a2a-70db-416e-bac0-11cf3c92cd29"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6b6fcc49-8d73-4bd4-92f2-7ec2d3a3f8c0"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"f4367739-1ee3-48be-8f1d-962b806374a7"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"0f8e1320-c237-4e50-adfc-db4b36a0fc89"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"b3215195-0411-4bfa-a910-a660c0309ea9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0900b060-5677-4afa-8c31-a94886ed47cb"], Cell[TextData[Cell[BoxData[
    "Properties"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "06e77797-39e2-4dbc-8117-c5591c11f3c8"]], "TableText",ExpressionUUID->
     "1a30c691-9bfb-4870-9672-a84573d195f7"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1d410fda-490f-45d3-ba0b-04360aa792f4"]], "TableText",ExpressionUUID->
     "1651c630-2410-4e21-a50c-bb286febee59"], Cell[TextData[{
     "further walk rules, each read on the window: ",
     Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "92f93f7d-6aed-4961-ae10-5634bd3212d2"],
     ", ",
     Cell[BoxData["\"\<Immersed\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "db6a0779-ad5d-4d46-87df-de851244ad46"],
     ", ",
     Cell[BoxData["\"\<Generic\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "51d54d00-884b-4c2c-be9e-1b4653f06b25"],
     ", ",
     Cell[BoxData[
      RowBox[{"\"\<Exclude\>\"", " ", "->", " ", "species"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9b8e98cc-6414-46d2-9242-72551fdafdd3"],
     ", or a predicate on the window"
    }], "TableText",ExpressionUUID->"1e4a187d-79b7-4164-baaf-1998a935606b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "69d784ea-196a-49c4-9aff-d70606366bc0"], Cell[TextData[Cell[
    BoxData["\"\<StoppingCondition\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "fd10a635-7b90-4e8c-9f54-b4a28d32311a"]], "TableText",ExpressionUUID->
     "541e08fc-ba37-484b-9903-c64e20f06cda"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a084d926-4ff6-47c8-8e81-367baf09c613"]], "TableText",ExpressionUUID->
     "b24be1eb-b49c-4704-9db0-9c6a654b70c9"], Cell[TextData[{
     StyleBox["n", "TI"],
     " (stop at the ",
     StyleBox["n", "TI"],
     "-th return to a visited vertex), a predicate on the walk so far, or ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"spec", ",", " ", 
        RowBox[{"\"\<Delay\>\"", " ", "->", " ", "k"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c32dff3a-b1fb-45fe-9b7e-82810658d491"]
    }], "TableText",ExpressionUUID->"3ff8c527-0ddd-4be3-be04-5ef86a65a2b7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "59971d9b-58e0-4a7a-94ee-d79411f3f974"], Cell[TextData[Cell[
    BoxData["\"\<Direction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1f68bdad-8a16-4278-aea3-ab52a93b2cf8"]], "TableText",ExpressionUUID->
     "bebd0031-ae58-4efc-9950-df721d4fa123"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "37f34543-141c-411a-bbf9-a09acd10a896"]], "TableText",ExpressionUUID->
     "64b5b6ad-119b-49e1-bc83-bd53f6d3649d"], Cell[TextData[{
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "82d7b162-7e39-4977-8223-3d87913a184c"],
     ", ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "53dc78b1-3046-4986-93ea-300b3c2b2569"],
     " or ",
     Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b33a91ac-8a18-4baa-b535-398dbfa18b88"]
    }], "TableText",ExpressionUUID->"9f5f2ed6-61a0-4274-b641-5a00b3379e11"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "bf696cbe-78d7-4686-bc62-3dafadb83dd3"], Cell[TextData[Cell[
    BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ad7ede26-c60c-479d-8b35-1a86f59f5621"]], "TableText",ExpressionUUID->
     "9c3897af-6d6d-44cf-8011-8975867ac64f"], Cell[TextData[Cell[BoxData[
    "Identity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "32d63ea5-a42a-492e-9f4c-352b2d42655d"]], "TableText",ExpressionUUID->
     "039a07c4-1c37-4da3-ba48-f9a4277a0e35"], Cell[TextData[{
     "a function of the candidate windows -- the window with one admissible \
candidate appended -- giving the ones to pursue, in the order to try: ",
     Cell[BoxData["Identity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f442aea5-2aac-4941-919e-3949b927b9cb"],
     " the canonical order, ",
     Cell[BoxData["RandomSample"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e3d2f260-0e43-4947-a73a-8df2bc61f5c0"],
     " a random order, ",
     Cell[BoxData["RandomChoice"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0591b281-8ec4-4517-8a55-0dfc581df505"],
     " the random walk, ",
     Cell[BoxData[
      RowBox[{"MinimalBy", "[", "f", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "fb62d4a2-9be8-4d00-b5bd-5b72872c6b3e"],
     " the candidates least by ",
     Cell[BoxData[
      RowBox[{"f", "[", "window", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8898e05b-2aff-4bc3-9884-b5f6b080ecde"],
     ", ",
     Cell[BoxData[
      RowBox[{
       RowBox[{"RandomSample", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"UpTo", "[", "n", "]"}]}], "]"}], " ", "&"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c7041c3f-cd05-4e3f-b7b0-c8aae874a1c9"],
     " a pruning to ",
     StyleBox["n", "TI"],
     " branches per node"
    }], "TableText",ExpressionUUID->"13c4c154-df22-498b-bc95-0c5857936bbe"]}
  }]], "3ColumnTableMod",ExpressionUUID->"24d4aa6c-2be8-41ff-9b70-\
7c3cbc205b2a"]
}, Open  ]],

