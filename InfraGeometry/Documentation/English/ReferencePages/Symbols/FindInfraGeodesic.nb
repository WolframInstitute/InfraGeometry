Cell[TextData[{
 "A geodesic germ of scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8fbe5a14-1cbe-42c8-873e-6d67c04f4ed5"],
 " grown without a budget on both sides gives the lines through it: the \
vertex lists of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5aec549d-f169-4ee0-a1b7-24ffaa295cfd"],
 "."
}], "ExampleText",ExpressionUUID->"8881d9d4-f5dd-4e5f-8669-7eaae1c8bded"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"germ", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}]}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"geos", " ", "=", " ", 
     RowBox[{"FindInfraGeodesic", "[", 
      RowBox[{
      "g", ",", " ", "germ", ",", " ", "Infinity", ",", " ", "Infinity", ",", 
       " ", "All", ",", " ", 
       RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<BothSides\>\""}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"geos", ",", " ", "germ"}], "}"}]}], "]"}], ",", "\n", "   ", 
     
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Last", " ", "/@", " ", 
          RowBox[{"VertexList", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ",
         "geos"}], "]"}], " ", "===", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"FindInfraLine", "[", 
        RowBox[{"g", ",", " ", "germ", ",", " ", "All"}], "]"}]}]}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"8d50d201-a8da-4321-b35e-c26783a7593d"],

