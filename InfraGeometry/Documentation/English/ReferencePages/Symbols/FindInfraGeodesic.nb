Notebook[{

Cell[CellGroupData[{
Cell["FindInfraGeodesic", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f0374694-8316-421b-bcec-fc9fe36c17ed"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16db7e54-68e4-4f37-b5d8-174b5d2a0320"],
 "\[LineSeparator]",
 "gives one geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " starting at ",
 StyleBox["p", "TI"],
 ", with a length inside the budget ",
 StyleBox["kspec", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7a6573c2-6703-409b-9bca-aa5a90c9299b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "400799b1-deab-48aa-8f6c-cd75e7e31030"],
 "\[LineSeparator]",
 "gives one geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2e809c52-9b36-4b39-b1cd-4182d874dc19"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c21e08aa-6b0a-42a3-a0f3-aa93b86255f0"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c45c965-e358-43d5-9561-0876eba17882"],
 " of exactly ",
 StyleBox["n", "TI"],
 " geodesics or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2de9fde-c408-4ca2-bbc0-7c9d2bbb286b"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "325f1a9c-517d-456c-acc0-659aab2112bc"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "162d102d-7325-41c9-8483-e5610b89b484"],
 " gives every one."
}], "Usage",ExpressionUUID->"c9de48bc-f236-4447-bd1d-074e8af11552"],

Cell[TextData[{
 "Definition: a walk ",
 StyleBox["v0", "TI"],
 ", ",
 StyleBox["v1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["vk", "TI"],
 " is a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " when every window of ",
 StyleBox["s", "TI"],
 " consecutive vertices together with the next one is a shortest path: ",
 StyleBox["d(v(i\[Minus]s), vi) = s", "TI"],
 " for every ",
 StyleBox["i \[GreaterEqual] s", "TI"],
 ", and ",
 StyleBox["d(v0, vi) = i", "TI"],
 " for ",
 StyleBox["i < s", "TI"],
 "."
}], "Notes",ExpressionUUID->"c4f1a5fa-7c6c-43a4-a8e2-8c63d528532f"],

Cell[TextData[{
 "The scale is how far back the observer sees. At scale ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fb5ca86-04a3-4c61-b25e-69f9564ce6ba"],
 " the condition asks only for adjacency, so every walk is a geodesic. At \
scale ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59a11bdb-0d97-40b7-b6aa-2bf96aafd418"],
 " it forbids stepping back, and on a graph with triangles also cutting a \
triangle's corner. At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61cac60e-6f9c-4d06-b8a3-8f24c8f3eab3"],
 " the whole walk is a shortest path, a segment. In between, a geodesic is \
locally shortest and may be globally long: it can wind round a square at \
scale ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "91fcf191-4388-4dcf-85d7-9e6f39ffa62d"],
 ", and round a larger loop at scale ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "abea32dc-e558-465d-ad2b-0e29e2d04a59"],
 "."
}], "Notes",ExpressionUUID->"fab84354-899b-4e48-ae80-0eab3b341bf2"],

Cell[TextData[{
 "This is the Riemannian geodesic read by an observer with a horizon. On a \
manifold a geodesic minimises length between nearby points only, and it need \
not be the shortest path between its ends. At infra-scale ",
 StyleBox["s", "TI"],
 " the same holds with \"nearby\" meaning \"fewer than ",
 StyleBox["s", "TI"],
 " steps apart\"."
}], "Notes",ExpressionUUID->"3dbf198b-06ca-43e9-af5f-bf5c9c05c35f"],

Cell[TextData[{
 StyleBox["kspec", "TI"],
 " is the length budget in edges: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "045eef7f-1514-4062-bfca-4e2bef614abd"],
 " (at most ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70128096-ec1b-42de-b8a8-bc1315188f90"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79d7a8bc-2981-4128-892f-54cf34f360e1"],
 ", or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab49b22d-d9b7-4433-b2e4-9b78e66c274b"],
 ". At a finite scale the class is infinite, so a finite budget is required; \
only scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3d46c58-d53e-416e-bff4-be6d657ae982"],
 " accepts ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a827a693-be3a-4e83-bb93-e0cce29ff14a"],
 "."
}], "Notes",ExpressionUUID->"ffdad67e-da5e-46cc-9dbf-444e10e36759"],

Cell[TextData[{
 "A geodesic is a walk graph: a directed path graph on the pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "v"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22359830-2648-441a-92b1-5b11e32d16d4"],
 ", the position and the vertex. ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e12184d0-f8f8-4c83-9692-d257179ad619"],
 " is its vertex sequence, and ",
 Cell[BoxData[
  RowBox[{"EdgeCount", "[", "w", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f7a1dbc-6487-4671-8c40-b78dd22b80c9"],
 " its length. The count-less call returns one walk graph, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13a395be-5a79-445c-8edc-256d8c7b1e20"],
 " when there is none."
}], "Notes",ExpressionUUID->"1e5b1da9-2e89-46ae-8f0b-280d3552e784"],

Cell[TextData[{
 "The search reads only the window, never the target. At a finite scale the \
two-point form keeps the walks that happen to end at ",
 StyleBox["q", "TI"],
 ", so a walk can pass ",
 StyleBox["q", "TI"],
 " and come back. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dbb60406-1d97-4376-b623-04c8e8899189"],
 " is the target-aware search at scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66ed9eaf-946b-422b-81c2-91298928d3f0"],
 "."
}], "Notes",ExpressionUUID->"602cdada-f32f-4560-a38d-25835b6c6965"],

Cell[TextData[{
 Cell[BoxData["FindInfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "803fa051-f5db-4c17-be6a-b2007507df6a"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b6c1ddd4-961c-465c-b65d-00ac1daab216"],
 " at ",
 Cell[BoxData[
  RowBox[{"\"\<InfraScale\>\"", " ", "->", " ", "s"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b5042e8-4ab1-44c1-a785-66525fa9a766"],
 " with ",
 Cell[BoxData["\"\<Minimizing\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e6a9728-d43e-4bff-800c-cc5f7e1c12d1"],
 " added to the rules. The options are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f22cdf75-76f0-4476-a351-ac01fab71357"],
 ":"
}], "Notes",ExpressionUUID->"5a0b0006-b75e-4f99-950e-cb093aa83c3f"],

