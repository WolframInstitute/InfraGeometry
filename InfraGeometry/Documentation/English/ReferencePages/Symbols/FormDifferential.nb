Cell["\<\
Stokes: on a random 1-form on the triangular tiling, the integral of the \
differential against the coboundary of the integral, triangle by triangle, on \
the diagonal.\
\>", "ExampleText",ExpressionUUID->"9f8faf1e-4fb4-47ba-89d8-237ba9e8b3ba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"form", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"AssociationMap", "[", 
        RowBox[{
         RowBox[{"node", " ", "|->", " ", 
          RowBox[{"AssociationMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"RandomInteger", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], "]"}], " ", "&"}],
             ",", " ", 
            RowBox[{"List", " ", "/@", " ", 
             RowBox[{"AdjacencyList", "[", 
              RowBox[{"g", ",", " ", "node"}], "]"}]}]}], "]"}]}], ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"lhs", " ", "=", " ", 
      RowBox[{"IntegrationMap", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"FormDifferential", "[", 
         RowBox[{"g", ",", " ", "form"}], "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"exact", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"IntegrationMap", "[", 
         RowBox[{"g", ",", " ", "form"}], "]"}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Values", "[", "exact", "]"}], ",", " ", 
          RowBox[{"Lookup", "[", 
           RowBox[{"lhs", ",", " ", 
            RowBox[{"Keys", "[", "exact", "]"}], ",", " ", "0"}], "]"}]}], 
         "}"}], "]"}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Delta](I\[Omega])\>\"", ",", 
          " ", "\"\<I(d\[Omega])\>\""}], "}"}]}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"KeySort", "[", "lhs", "]"}], " ", "===", " ", 
      RowBox[{"KeySort", "[", "exact", "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ebd7b171-aad1-4769-8705-3e2532ff757e"],

