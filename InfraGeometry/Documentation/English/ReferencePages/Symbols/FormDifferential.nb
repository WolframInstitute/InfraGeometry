Cell["\<\
The differential of the gradient is not zero. At a vertex two steps from the \
centre of the triangular tiling, its germ, as a matrix over the ordered pairs \
of neighbours, is 0 on the pairs of adjacent neighbours and the difference of \
their distances from the centre on the others.\
\>", "ExampleText",ExpressionUUID->"a14e78d4-0ad4-49c1-b3c0-f34d234085e8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"center", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"twoForm", " ", "=", " ", 
      RowBox[{"FormDifferential", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"FormDifferential", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"ZeroForm", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", "center", ",", " ", "#"}], "]"}], " ", 
             "&"}]}], "]"}]}], "]"}]}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"node", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "center", ",", " ", "#"}], "]"}], " ", "==",
            " ", "2"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\n", "     ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{"node", ",", " ", 
            RowBox[{"AdjacencyList", "[", 
             RowBox[{"g", ",", " ", "node"}], "]"}]}], "}"}]}], "]"}], ",", 
        "\n", "     ", 
        RowBox[{"MatrixPlot", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"FormValue", "[", 
            RowBox[{"twoForm", ",", " ", "node", ",", " ", 
             RowBox[{"{", 
              RowBox[{"nbr", ",", " ", "neighbour"}], "}"}]}], "]"}], ",", 
           " ", 
           RowBox[{"{", 
            RowBox[{"nbr", ",", " ", 
             RowBox[{"AdjacencyList", "[", 
              RowBox[{"g", ",", " ", "node"}], "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"neighbour", ",", " ", 
             RowBox[{"AdjacencyList", "[", 
              RowBox[{"g", ",", " ", "node"}], "]"}]}], "}"}]}], "]"}], 
         "]"}]}], "}"}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", "center", ",", " ", "#"}], "]"}], " ", "&"}], 
      " ", "/@", " ", 
      RowBox[{"AdjacencyList", "[", 
       RowBox[{"g", ",", " ", "node"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5e79525b-f5c2-4f0c-8150-f2262cb1c345"],

