Notebook[{

Cell[CellGroupData[{
Cell["FormDifferential", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a08214d0-6cae-45bb-a2f0-53ce3bd781ad"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FormDifferential"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FormDifferential", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["f", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a5c7074-98c7-42ec-80d3-75f1ba935b10"],
 "\[LineSeparator]",
 "gives the gradient ",
 StyleBox["df", "TI"],
 " of the 0-form ",
 StyleBox["f", "TI"],
 ": ",
 StyleBox["(df)(v; w) = f(w) \[Minus] f(v)", "TI"],
 " on the step from ",
 StyleBox["v", "TI"],
 " to each neighbour ",
 StyleBox["w", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"134f8ffc-9394-43b2-a220-5a2f291ff997"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FormDifferential"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FormDifferential", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["\[Omega]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35343249-38db-44d5-b476-87f76ed463e0"],
 "\[LineSeparator]",
 "gives the differential ",
 StyleBox["d\[Omega]", "TI"],
 " of the 1-form ",
 StyleBox["\[Omega]", "TI"],
 ": ",
 StyleBox["(d\[Omega])(v; w\:2081, w\:2082) = \[Omega](v; w\:2081) \[Minus] \
\[Omega](v; w\:2082) + (\[Omega](w\:2081; w\:2082) \[Minus] \[Omega](w\:2082; \
w\:2081))/2", "TI"],
 "."
}], "Usage",ExpressionUUID->"180525cb-6d68-4acb-81ff-9d8aed8fb5cf"],

Cell[TextData[{
 "Definition: in degree ",
 StyleBox["k", "TI"],
 ", ",
 StyleBox["(d\[Omega])(v; w\:2081, \[Ellipsis], w\:2096\:208a\:2081) = \
\[CapitalSigma]\:1d62 (\[Minus]1)\:2071 \[Omega](v; w\:2081, \[Ellipsis], \
\:0175\:1d62, \[Ellipsis], w\:2096\:208a\:2081) + (I\[Omega])(w\:2081, \
\[Ellipsis], w\:2096\:208a\:2081)", "TI"],
 ", the sum over ",
 StyleBox["i", "TI"],
 " = 1, \[Ellipsis], ",
 StyleBox["k", "TI"],
 " + 1, where ",
 StyleBox["I", "TI"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IntegrationMap"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/IntegrationMap", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "40999c27-9c4d-4627-9543-1de6ad4db24a"],
 ". It is the coboundary read on the tuple ",
 StyleBox["(v, w\:2081, \[Ellipsis], w\:2096\:208a\:2081)", "TI"],
 ": each face through ",
 StyleBox["v", "TI"],
 " is read from the germ at ",
 StyleBox["v", "TI"],
 ", and the one face that misses ",
 StyleBox["v", "TI"],
 " is read by integration."
}], "Notes",ExpressionUUID->"527df3b7-236d-4e1f-b1eb-85084257c3f1"],

Cell[TextData[{
 "The last term is the transport term, the one place where the germ at ",
 StyleBox["v", "TI"],
 " is compared with the germs at its neighbours. It vanishes unless ",
 StyleBox["w\:2081, \[Ellipsis], w\:2096\:208a\:2081", "TI"],
 " span a clique. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NaiveDifferential"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/NaiveDifferential", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4ad08f84-3f4a-4f51-99a7-b47e0449ee00"],
 " drops it."
}], "Notes",ExpressionUUID->"7165f7c3-afb5-455b-98b2-b93b516497e4"],

Cell[TextData[{
 "Stokes: ",
 StyleBox["I(d\[Omega]) = \[Delta](I\[Omega])", "TI"],
 " in every degree, ",
 StyleBox["\[Delta]", "TI"],
 " being ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Coboundary"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Coboundary", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7400b659-fea8-4240-a2d1-3425174c734c"],
 ". The transport term is forced. With the transport term multiplied by ",
 StyleBox["\[Lambda]", "TI"],
 ", the integral of the differential is ((",
 StyleBox["k", "TI"],
 " + 1 + ",
 StyleBox["\[Lambda]", "TI"],
 ")/(",
 StyleBox["k", "TI"],
 " + 2)) ",
 StyleBox["\[Delta](I\[Omega])", "TI"],
 ", and since the germ values are independent coordinates, comparing their \
coefficients leaves only ",
 StyleBox["\[Lambda]", "TI"],
 " = 1."
}], "Notes",ExpressionUUID->"5f885836-9a4d-4437-be7c-b518ac6a7b67"],

Cell[TextData[{
 StyleBox["d(d\[Omega]) \[NotEqual] 0", "TI"],
 ". On the gradient of a 0-form ",
 StyleBox["f", "TI"],
 ", ",
 StyleBox["(d(df))(v; w\:2081, w\:2082)", "TI"],
 " is 0 when ",
 StyleBox["w\:2081", "TI"],
 " and ",
 StyleBox["w\:2082", "TI"],
 " are adjacent and ",
 StyleBox["f(w\:2081) \[Minus] f(w\:2082)", "TI"],
 " when they are not: the square of the differential sees the missing edges."
}], "Notes",ExpressionUUID->"fc88c718-953e-4737-a46b-2c1523bc88df"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FormDifferential"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FormDifferential", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d7c5f6be-9981-4937-ae00-158ec7593164"],
 " computes degrees 0 and 1."
}], "Notes",ExpressionUUID->"4bba3863-fa38-448e-8c24-ae42a8bc73c4"]
}, Open  ]],

