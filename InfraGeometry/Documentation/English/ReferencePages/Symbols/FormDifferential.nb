Cell[TextData[{
 "The germ of ",
 StyleBox["d(df)", "TI"],
 " at ",
 StyleBox["v", "TI"],
 " is 0 on adjacent neighbours and ",
 StyleBox["f(w\:2081) \[Minus] f(w\:2082)", "TI"],
 " on the others. The coordinate ",
 StyleBox["x", "TI"],
 " at the centre of the mesh:"
}], "ExampleText",ExpressionUUID->"3888a1ee-67cb-4c36-b73d-03ff60a06edf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"x", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ddx", " ", "=", " ", 
     RowBox[{"FormDifferential", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"FormDifferential", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"ZeroForm", "[", 
          RowBox[{"g", ",", " ", "x"}], "]"}]}], "]"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Subsets", "[", 
      RowBox[{
       RowBox[{"AdjacencyList", "[", 
        RowBox[{"g", ",", " ", "c"}], "]"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"FormValue", "[", 
        RowBox[{"ddx", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
       
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"EdgeQ", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"UndirectedEdge", " ", "@@", " ", "#"}]}], "]"}], ",", " ",
          "0", ",", " ", 
         RowBox[{
          RowBox[{"x", "[", 
           RowBox[{"First", "[", "#", "]"}], "]"}], " ", "-", " ", 
          RowBox[{"x", "[", 
           RowBox[{"Last", "[", "#", "]"}], "]"}]}]}], "]"}]}], " ", "&"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0bb502c3-7c69-4b7a-89bb-d7c4a6169386"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"345e499f-9e9f-4347-a9d2-6e92259a32f6"]
}, Open  ]],

Cell["\<\
Stokes in degree 1, for a random 1-form on the mesh, and the factor 2/3 lost \
without the transport term:\
\>", "ExampleText",ExpressionUUID->"525447cc-6505-4062-a24a-50ae080c05a2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"w", " ", "=", " ", 
     RowBox[{"BlockRandom", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"AssociationMap", "[", 
        RowBox[{
         RowBox[{"v", " ", "|->", " ", 
          RowBox[{"AssociationThread", "[", 
           RowBox[{
            RowBox[{"List", " ", "/@", " ", 
             RowBox[{"AdjacencyList", "[", 
              RowBox[{"g", ",", " ", "v"}], "]"}]}], ",", " ", 
            RowBox[{"RandomInteger", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", " ", 
              RowBox[{"VertexDegree", "[", 
               RowBox[{"g", ",", " ", "v"}], "]"}]}], "]"}]}], "]"}]}], ",", 
         " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}], ",", "\n", "     ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"exact", " ", "=", " ", 
     RowBox[{"KeySort", " ", "@", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"IntegrationMap", "[", 
         RowBox[{"g", ",", " ", "w"}], "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"IntegrationMap", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"FormDifferential", "[", 
          RowBox[{"g", ",", " ", "w"}], "]"}]}], "]"}]}], " ", "==", " ", 
      "exact"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"IntegrationMap", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"NaiveDifferential", "[", 
          RowBox[{"g", ",", " ", "w"}], "]"}]}], "]"}]}], " ", "==", " ", 
      RowBox[{
       RowBox[{"2", "/", "3"}], " ", "exact"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a057df49-782a-47cf-93d6-1aa940d85ad6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"561507f8-554f-490c-bb8a-e198e40fcd84"]
}, Open  ]]
}, Open  ]],

