Cell["\<\
Stokes in degree 0: the integral of the gradient of the distance from the \
centre is the coboundary of the distance:\
\>", "ExampleText",ExpressionUUID->"4db5e09e-9274-4427-ab0a-420eb2cac866"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"f", " ", "=", " ", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"IntegrationMap", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"FormDifferential", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"ZeroForm", "[", 
            RowBox[{"g", ",", " ", "f"}], "]"}]}], "]"}]}], "]"}]}], " ", "==",
       "\n", "      ", 
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"KeyMap", "[", 
          RowBox[{"List", ",", " ", "f"}], "]"}]}], "]"}]}]}]}], "]"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", 
       " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"114854bf-81ad-4018-9a57-2327fc0d33f6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"fcb51d55-00f5-4227-95fa-508f428ce7a0"]
}, Open  ]],

Cell[TextData[{
 "The differential of a gradient is not 0. The vertices where ",
 StyleBox["d(dx)", "TI"],
 " has a germ, for the coordinate ",
 StyleBox["x", "TI"],
 ": on the grid every vertex of degree at least 2, on the mesh 86 of the 102 \
vertices:"
}], "ExampleText",ExpressionUUID->"b1c01bf4-7dbf-4f47-8073-f2bcb1760341"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"x", " ", "=", " ", 
        RowBox[{"ZeroForm", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"AssociationThread", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"ddx", " ", "=", " ", 
        RowBox[{"FormDifferential", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"FormDifferential", "[", 
           RowBox[{"g", ",", " ", "x"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"support", " ", "=", " ", 
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"Select", "[", 
          RowBox[{"ddx", ",", " ", 
           RowBox[{
            RowBox[{"#", " ", "=!=", " ", 
             RowBox[{"<|", "|>"}]}], " ", "&"}]}], "]"}]}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", "support", "}"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"Length", "[", "support", "]"}]}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"efec6ad8-0bec-45b3-9bea-61a9d20c6a38"],

