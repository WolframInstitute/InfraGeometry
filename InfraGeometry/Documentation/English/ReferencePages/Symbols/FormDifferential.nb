Cell[TextData[{
 "The gradient of the distance from the centre on the square, the hexagonal \
and the triangular tiling, drawn by an arc from ",
 StyleBox["v", "TI"],
 " to ",
 StyleBox["w", "TI"],
 " where the germ at ",
 StyleBox["v", "TI"],
 " is positive on the step to ",
 StyleBox["w", "TI"],
 ", blue, or negative, orange: 1 on every step away from the centre, \
\[Minus]1 on every step towards it, 0 on a step inside a shell."
}], "ExampleText",ExpressionUUID->"bb3b1c2d-a6af-4466-b1d5-420f9f4c3a4b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graphs", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"#", ",", " ", "\"\<Small\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}],
        " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"forms", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"FormDifferential", "[", 
        RowBox[{"substrate", ",", " ", 
         RowBox[{"ZeroForm", "[", 
          RowBox[{"substrate", ",", " ", 
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"substrate", ",", " ", 
              RowBox[{"First", " ", "@", " ", 
               RowBox[{"GraphCenter", "[", "substrate", "]"}]}], ",", " ", 
              "#"}], "]"}], " ", "&"}]}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"substrate", ",", " ", "graphs"}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"MapThread", "[", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"DisplacementPlot", "[", 
        RowBox[{"#1", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{"Catenate", " ", "@*", " ", "Keys", " ", "@*", " ", 
              RowBox[{"Select", "[", "Positive", "]"}]}], ",", " ", "#2"}], 
            "]"}], ",", " ", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{"Catenate", " ", "@*", " ", "Keys", " ", "@*", " ", 
              RowBox[{"Select", "[", "Negative", "]"}]}], ",", " ", "#2"}], 
            "]"}]}], "}"}]}], "]"}], " ", "&"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"graphs", ",", " ", "forms"}], "}"}]}], "]"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7489b458-9f19-4a5d-adcc-89ed13db48ed"],

