Cell["\<\
The differential of a 2-form is not computed, and the call stays unevaluated:\
\
\>", "ExampleText",ExpressionUUID->"bacf44fc-1a83-496d-83b0-05077b273806"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"x", " ", "=", " ", 
     RowBox[{"ZeroForm", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ddx", " ", "=", " ", 
     RowBox[{"FormDifferential", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"FormDifferential", "[", 
        RowBox[{"g", ",", " ", "x"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FormDegree", "[", "ddx", "]"}], ",", " ", 
     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"FormDifferential", "[", 
       RowBox[{"g", ",", " ", "ddx"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"831e4d20-a6a1-4bef-9b1a-2c681ba8b44b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "FormDifferential"}], "}"}]], "Output",
