Cell["\<\
On the square tiling no two neighbours of a vertex are adjacent, so the \
differential of the gradient of the distance has a germ wherever a vertex has \
neighbours at two distances: at every vertex but the centre and the 28 \
vertices of the rim. Beside it, the number of vertices without a germ.\
\>", "ExampleText",ExpressionUUID->"fa58f06c-702d-4990-bf79-fb5aaa585672"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"twoForm", " ", "=", " ", 
     RowBox[{"FormDifferential", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"FormDifferential", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"ZeroForm", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"First", " ", "@", " ", 
               RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "#"}], 
             "]"}], " ", "&"}]}], "]"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{"twoForm", ",", " ", 
            RowBox[{
             RowBox[{"#", " ", "=!=", " ", 
              RowBox[{"<|", "|>"}]}], " ", "&"}]}], "]"}]}], ",", " ", "1"}], 
        "]"}]}], "]"}], ",", " ", 
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{"Values", "[", "twoForm", "]"}], ",", " ", 
       RowBox[{"<|", "|>"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"6a96ea65-18d7-4f18-9e9a-9614dc71e721"],

