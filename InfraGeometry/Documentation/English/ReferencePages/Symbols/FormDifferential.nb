Notebook[{

Cell[CellGroupData[{
Cell["FormDifferential", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"37ca0539-6a3f-493c-9e4b-39046eac2f86"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FormDifferential"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FormDifferential", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["f", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e5d23a2-fc3a-4c99-ad5f-d6983d77f4a7"],
 "\[LineSeparator]",
 "gives the gradient ",
 StyleBox["df", "TI"],
 " of the 0-form ",
 StyleBox["f", "TI"],
 ", ",
 StyleBox["(df)(v; w) = f(w) \[Minus] f(v)", "TI"],
 " on the step from ",
 StyleBox["v", "TI"],
 " to each neighbour ",
 StyleBox["w", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"643ca0e5-495f-4415-ad31-c2a5606190c6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FormDifferential"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FormDifferential", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["\[Omega]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8e817ad-32d0-419d-89b1-a6cce85a00aa"],
 "\[LineSeparator]",
 "gives the differential ",
 StyleBox["d\[Omega]", "TI"],
 " of the 1-form ",
 StyleBox["\[Omega]", "TI"],
 ", ",
 StyleBox["(d\[Omega])(v; w\:2081, w\:2082) = \[Omega](v; w\:2081) \[Minus] \
\[Omega](v; w\:2082) + (\[Omega](w\:2081; w\:2082) \[Minus] \[Omega](w\:2082; \
w\:2081))/2", "TI"],
 "."
}], "Usage",ExpressionUUID->"f9efc535-0f1e-4d79-8f2c-75e038d332de"],

Cell[TextData[{
 "The differential is the coboundary read on the tuple ",
 StyleBox["(v, w\:2081, \[Ellipsis], w\:2096\:208a\:2081)", "TI"],
 ": the faces through ",
 StyleBox["v", "TI"],
 " are read from the germ at ",
 StyleBox["v", "TI"],
 ", and the one face that misses ",
 StyleBox["v", "TI"],
 " is read by integration over its vertices (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IntegrationMap"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/IntegrationMap", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "29577fe2-38ff-4e16-8ebe-1270a695959d"],
 ")."
}], "Notes",ExpressionUUID->"07ea8239-1f82-4c6c-9850-3174109c2477"],

Cell[TextData[{
 "The last term of ",
 StyleBox["d\[Omega]", "TI"],
 " is the transport term, the one place where the germ at ",
 StyleBox["v", "TI"],
 " meets the germs at its neighbours. It is 0 unless ",
 StyleBox["w\:2081", "TI"],
 " and ",
 StyleBox["w\:2082", "TI"],
 " are adjacent. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NaiveDifferential"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/NaiveDifferential", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8f471322-1288-4f94-87b8-45de75872672"],
 " drops it."
}], "Notes",ExpressionUUID->"1ed7fe9a-cbf7-41b6-a571-25fdeb2bfc9f"],

Cell[TextData[{
 "Stokes: ",
 StyleBox["I(d\[Omega]) = \[Delta](I\[Omega])", "TI"],
 ", with ",
 StyleBox["I", "TI"],
 " the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IntegrationMap"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/IntegrationMap", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a5b90e97-e780-452e-8c9c-e444241ab6ad"],
 " and ",
 StyleBox["\[Delta]", "TI"],
 " the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Coboundary"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Coboundary", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "421157ed-2d90-4051-a9de-81fdce151d43"],
 ". Without the transport term the left side is ",
 StyleBox["(2/3) \[Delta](I\[Omega])", "TI"],
 "."
}], "Notes",ExpressionUUID->"944e4e91-7aea-498e-981a-23dbf9991b81"],

Cell[TextData[{
 StyleBox["d(df) \[NotEqual] 0", "TI"],
 ": ",
 StyleBox["(d(df))(v; w\:2081, w\:2082)", "TI"],
 " is 0 when ",
 StyleBox["w\:2081", "TI"],
 " and ",
 StyleBox["w\:2082", "TI"],
 " are adjacent and ",
 StyleBox["f(w\:2081) \[Minus] f(w\:2082)", "TI"],
 " when they are not. On the square grid no two neighbours of a vertex are \
adjacent."
}], "Notes",ExpressionUUID->"d0eb0999-f2f4-43da-81d1-ee4bd8383c71"],

Cell["\<\
Only degrees 0 and 1 are computed: on a form of degree 2 the call stays \
unevaluated.\
\>", "Notes",ExpressionUUID->"007ed5dd-045d-433a-8f7c-cc24623545a6"]
}, Open  ]],

