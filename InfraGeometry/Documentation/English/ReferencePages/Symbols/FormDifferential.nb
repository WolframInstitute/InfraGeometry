Cell["\<\
On a form of degree 2 or more the germs come out empty, with no message. The \
differential of the gradient of the distance on the triangular tiling is a \
2-form with a germ at the vertices drawn, and its differential is the zero \
form.\
\>", "ExampleText",ExpressionUUID->"21a445f8-63a0-45fa-abe5-d21d355dff54"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"twoForm", " ", "=", " ", 
     RowBox[{"FormDifferential", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"FormDifferential", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"ZeroForm", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"First", " ", "@", " ", 
               RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "#"}], 
             "]"}], " ", "&"}]}], "]"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{"twoForm", ",", " ", 
            RowBox[{
             RowBox[{"#", " ", "=!=", " ", 
              RowBox[{"<|", "|>"}]}], " ", "&"}]}], "]"}]}], ",", " ", "1"}], 
        "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"FormDegree", "[", "twoForm", "]"}], ",", " ", 
     RowBox[{"Union", "[", 
      RowBox[{"Length", " ", "/@", " ", 
       RowBox[{"Values", "[", 
        RowBox[{"FormDifferential", "[", 
         RowBox[{"g", ",", " ", "twoForm"}], "]"}], "]"}]}], "]"}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0ad426f9-fd8b-4194-9074-10e6befeb451"],

