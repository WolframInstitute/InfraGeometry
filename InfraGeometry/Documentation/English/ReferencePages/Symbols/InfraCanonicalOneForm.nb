Cell["InfraCanonicalOneForm", "ObjectName",ExpressionUUID->"46dc7e65-355d-470d-924c-167d4779b51c"],

Cell["LLM generated.", "Notes",ExpressionUUID->"3a28d8dc-384c-438a-840c-e431ff708dc2"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f0db4ade-00d7-48e9-8e82-1fb1318d96f8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCanonicalOneForm"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCanonicalOneForm", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["x", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["v", "TI"]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["y", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42c76598-ac86-4f92-a4df-53eb5bd286dd"],
 "\[LineSeparator]",
 "gives the canonical 1-form at the vector ",
 StyleBox["x", "TI"],
 " -> ",
 StyleBox["v", "TI"],
 " on the step to ",
 StyleBox["y", "TI"],
 ": the pairing (",
 StyleBox["d", "TI"],
 "(",
 StyleBox["x", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ")^2 + ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["x", "TI"],
 ", ",
 StyleBox["y", "TI"],
 ")^2 - ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["y", "TI"],
 ")^2)/2.",
 "\n"
}], "Usage",ExpressionUUID->"384ad147-7639-4146-91bb-328d7061327c"],

Cell["\<\
This is a particular Experimental construction in the Infra Fiber Bundles \
category. Its existing call forms remain available.\
\>", "Notes",ExpressionUUID->"85ac69e2-9c38-4699-8047-b438ccae88f5"],

Cell[TextData[{
 "Only the first and last vertices of the vector and the first vertex of the \
target are read, so a ray of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRays"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraRays", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4cb9ae20-db0d-463e-88b6-766b0481eda2"],
 " and a pair of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDisplacementBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c35a8bec-40cb-4095-9c86-6ba4f86efdb7"],
 " both work as the vector."
}], "Notes",ExpressionUUID->"48e67df6-30f1-4af8-a9f4-3dd6d032a4b5"],

Cell[TextData[{
 "The pairing is the polar form of the path metric at ",
 StyleBox["x", "TI"],
 "."
}], "Notes",ExpressionUUID->"7528ba1e-308d-4ae7-9c13-f2cc4560971c"]
}, Open  ]],

