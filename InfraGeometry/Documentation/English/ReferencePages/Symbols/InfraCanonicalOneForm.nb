Cell["\<\
The vector from 6 two steps up the grid, and its pairing with the four steps \
from 6.\
\>", "ExampleText",ExpressionUUID->"84a6039f-7130-4f34-8c17-9d529242f48a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"InfraFiberedSubstrate", "[", 
       RowBox[{"\"\<GridTangentBundle\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rayVector", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"6", ",", " ", "7", ",", " ", "8"}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "rayVector", "]"}], ",", " ", 
           RowBox[{"Directive", "[", "StandardBlue", "]"}]}], "}"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraWalk", "[", 
            RowBox[{"{", 
             RowBox[{"6", ",", " ", "#"}], "}"}], "]"}], " ", "&"}], " ", "/@",
           " ", 
          RowBox[{"AdjacencyList", "[", 
           RowBox[{"g", ",", " ", "6"}], "]"}]}]}], "]"}]}], "]"}], ",", "\n",
      "    ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{"y", " ", "|->", " ", 
         RowBox[{"InfraCanonicalOneForm", "[", 
          RowBox[{"g", ",", " ", "rayVector", ",", " ", 
           RowBox[{"{", "y", "}"}]}], "]"}]}], ",", " ", 
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", "6"}], "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"568a8526-3cfa-4a27-a3b6-ea1f3d795642"],

