Cell["\<\
The vector from 6 two steps up the grid, and its pairing with the four steps \
from 6.\
\>", "ExampleText",ExpressionUUID->"113bbd5d-c622-483a-bcbe-8dadf26491f4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"InfraFiberedSubstrate", "[", 
       RowBox[{"\"\<GridTangentBundle\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rayVector", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"6", ",", " ", "7", ",", " ", "8"}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "rayVector", "]"}], ",", " ", 
           RowBox[{"Directive", "[", "StandardBlue", "]"}]}], "}"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraWalk", "[", 
            RowBox[{"{", 
             RowBox[{"6", ",", " ", "#"}], "}"}], "]"}], " ", "&"}], " ", "/@",
           " ", 
          RowBox[{"AdjacencyList", "[", 
           RowBox[{"g", ",", " ", "6"}], "]"}]}]}], "]"}]}], "]"}], ",", "\n",
      "    ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{"y", " ", "|->", " ", 
         RowBox[{"InfraCanonicalOneForm", "[", 
          RowBox[{"g", ",", " ", "rayVector", ",", " ", 
           RowBox[{"{", "y", "}"}]}], "]"}]}], ",", " ", 
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", "6"}], "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d0a807ab-0e58-475c-9ded-c5a3a8ccc4c7"],

