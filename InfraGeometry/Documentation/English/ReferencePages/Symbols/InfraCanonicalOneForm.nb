Cell[CellGroupData[{
Cell["InfraCanonicalOneForm", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"28e49d72-8c34-4b45-b72d-0e0ad4a5494b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCanonicalOneForm"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCanonicalOneForm", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["x", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["v", "TI"]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["y", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8bdca840-b975-4079-bf97-d118e28a3b12"],
 "\[LineSeparator]",
 "gives the canonical 1-form at the vector ",
 StyleBox["x", "TI"],
 " -> ",
 StyleBox["v", "TI"],
 " on the step to ",
 StyleBox["y", "TI"],
 ": the pairing (",
 StyleBox["d", "TI"],
 "(",
 StyleBox["x", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ")^2 + ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["x", "TI"],
 ", ",
 StyleBox["y", "TI"],
 ")^2 - ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["y", "TI"],
 ")^2)/2.",
 "\n"
}], "Usage",ExpressionUUID->"8aaa19d2-275f-42cc-96d7-f6a52b6b9c2f"],

Cell[TextData[{
 "Only the first and last vertices of the vector and the first vertex of the \
target are read, so a ray of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRays"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraRays", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "800dd16a-f661-4e3d-a9b7-ba8c2b7071ba"],
 " and a pair of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDisplacementBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8c1d1545-19b7-4cc9-b129-c8dadec2d5b2"],
 " both work as the vector."
}], "Notes",ExpressionUUID->"8625407d-0f5e-48e3-827b-9e00a6fa21f4"],

Cell[TextData[{
 "The pairing is the polar form of the path metric at ",
 StyleBox["x", "TI"],
 "."
}], "Notes",ExpressionUUID->"3dc6bebf-c905-44eb-bbcc-dfd8e4e99571"]
}, Open  ]],

