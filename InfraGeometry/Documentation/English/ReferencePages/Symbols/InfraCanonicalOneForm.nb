Cell[TextData[{
 "A ray of length ",
 StyleBox["r", "TI"],
 " from the centre, paired with its own first step, gives ",
 StyleBox["r", "TI"],
 ", for every ray of length 1 and 2."
}], "ExampleText",ExpressionUUID->"a5deedb7-c2ef-4d4e-851e-158b0748e175"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Union", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraCanonicalOneForm", "[", 
         RowBox[{"g", ",", " ", "#", ",", " ", 
          RowBox[{"Rest", " ", "@", " ", "#"}]}], "]"}], " ", "&"}], " ", "/@",
        " ", 
       RowBox[{"InfraRays", "[", 
        RowBox[{"g", ",", " ", "13", ",", " ", "r"}], "]"}]}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "1", ",", " ", "2"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ab0ec13d-5b61-40ca-952e-6c729c11a48b"],

