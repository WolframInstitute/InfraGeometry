        RowBox[{"1", ",", " ", "3"}], "]"}], ",", " ", "\"\<Subgraph\>\""}], 
      "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6a0f8ede-59e0-4b09-83b8-06a8c1b6fd6d"],

