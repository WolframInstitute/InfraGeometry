Notebook[{

Cell[CellGroupData[{
Cell["PathSubgraph", "ObjectName",ExpressionUUID->"b04746f3-38fc-4ae8-bf32-03857236b95d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"85842e4f-15f0-47d9-8eba-1933ceadc096"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PathSubgraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/PathSubgraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c3eb2da-29ed-4369-bcc9-c400bf8a9440"],
 "\[LineSeparator]",
 "returns the union of all shortest u-v paths.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c9fb8e13-16e6-4f43-b378-7d7ca1d7028d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PathSubgraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/PathSubgraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6aaaea30-f402-4856-a0a5-4dd059e299a7"],
 "\[LineSeparator]",
 "(or UpTo[k]) caps path length; PathSubgraph[graph, u, v, All] returns the \
full simple-path subgraph."
}], "Usage",ExpressionUUID->"b03a11ab-41ef-4f03-adb9-feb999070b42"],

Cell[TextData[{
 "The option ",
 Cell[BoxData[
  RowBox[{"\"\<Directed\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3127a1b5-5cc6-475c-bba8-258fab67a5da"],
 " orients each path from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ". Use ",
 Cell[BoxData[
  RowBox[{"\"\<Directed\>\"", " ", "->", " ", "False"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32c8d93f-ed6a-44f7-a567-df788ce94713"],
 " for its undirected edge union."
}], "Notes",ExpressionUUID->"5ba2697f-c2b5-4b03-8329-19e8cde365fb"],

Cell[TextData[{
 "The length cap counts edges. The default equals the segment graph on an \
unweighted substrate. A larger cap adds detours, which the segment excludes. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a8355ed-4864-413f-8bc0-b438159646bf"],
 " includes every simple path between the endpoints."
}], "Notes",ExpressionUUID->"08a5698f-3969-47b4-b5e5-156ee47eed75"],

Cell[TextData[{
 "This is a union of path ",
 StyleBox["edges",
  FontWeight->"Bold"],
 ", not the subgraph induced on their vertices. The latter can contain \
additional edges that violate the cap. The graph does not retain which edges \
belonged to the same path."
}], "Notes",ExpressionUUID->"e3487617-4ce2-433e-b4eb-dd449ca4bb4d"],

Cell[TextData[{
 "The construction uses the built-ins ",
 Cell[BoxData["FindPath"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d68b3fe-6893-4d2e-9df2-74d5f5459d5e"],
 ", ",
 Cell[BoxData["PathGraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12a4f538-2deb-440b-b780-08c0c187dfd5"],
 " and ",
 Cell[BoxData["GraphUnion"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f8d887e-64e9-4217-be28-00a00341b02f"],
 ". Enumerating all simple paths can be expensive."
}], "Notes",ExpressionUUID->"0905da66-266b-4b40-8cd3-39b81832f388"]
}, Open  ]],

