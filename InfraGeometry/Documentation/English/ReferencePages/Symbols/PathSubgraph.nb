 CellLabel->"Out[1]= ",ExpressionUUID->"92533f19-707d-4ca3-a22f-965e2b406ef1"]
}, Open  ]],

Cell["\<\
The default segment has just the short route. Its support subgraph is \
available through the measurement API.\
\>", "ExampleText",ExpressionUUID->"458b5625-7e83-40bf-ad89-f2cb6cc04f03"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "6", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"PathSubgraph", "[", 
      RowBox[{"graph", ",", " ", "1", ",", " ", "3"}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"graph", ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"1", ",", " ", "3"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
