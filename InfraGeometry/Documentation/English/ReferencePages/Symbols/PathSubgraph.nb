Cell["\<\
On a six-cycle, the two routes from 1 to 3 have lengths 2 and 4. Increasing \
the cap adds the longer route.\
\>", "ExampleText",ExpressionUUID->"3c6be02c-4864-4823-84a3-fb885313ca21"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "6", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"PathSubgraph", "[", 
       RowBox[{"graph", ",", " ", "1", ",", " ", "3", ",", " ", "#", ",", " ", 
        RowBox[{"\"\<Directed\>\"", " ", "->", " ", "False"}]}], "]"}], " ", 
      "&"}], " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"09e773dd-1bbd-4156-b17f-1238b9c22f0f"],

Cell[BoxData[
 GraphicsBox[{{}, {InsetBox[
     FormBox[
      GraphicsBox[
       NamespaceBox["NetworkGraphics",
        DynamicModuleBox[{Typeset`graph = HoldComplete[
          Graph[{1, 2, 3}, {Null, {{1, 2}, {2, 3}}}]]}, 
         TagBox[
          GraphicsGroupBox[
           GraphicsComplexBox[{{0., 3.6739403974420594`*^-16}, {1., 
            2.4492935982947064`*^-16}, {2., 0.}}, {
             {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], Arrowheads[
              0.], ArrowBox[{{1, 2}, {2, 3}}, 0.02261146496815286]}, 
             {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
              DiskBox[1, 0.02261146496815286], 
              DiskBox[2, 0.02261146496815286], 
              DiskBox[3, 0.02261146496815286]}}]],
          MouseAppearanceTag["NetworkGraphics"]],
         AllowKernelInitialization->False]],
       DefaultBaseStyle->"NetworkGraphics",
       FormatType->TraditionalForm,
       FrameTicks->None],
      TraditionalForm], {160., -181.39847307544682}, {Center, Center}, {300., 342.79694615089363},
     
     BaseStyle->{Graphics3DBoxOptions -> {SphericalRegion -> False}}], 
    InsetBox[
     FormBox[
      GraphicsBox[
       NamespaceBox["NetworkGraphics",
        DynamicModuleBox[{Typeset`graph = HoldComplete[
          
          Graph[{1, 2, 3, 4, 5, 6}, {
           Null, {{1, 2}, {2, 3}, {1, 6}, {5, 6}, {4, 5}, {3, 4}}}]]}, 
         TagBox[
          GraphicsGroupBox[
           GraphicsComplexBox[{{-0.8660254037844389, 0.5000000000000008}, {
            1.8369701987210297`*^-16, 1.}, {0.8660254037844386, 
            0.4999999999999993}, {0.8660254037844389, -0.5000000000000012}, {
            3.8285686989269494`*^-16, -1.}, {-0.8660254037844384, \
-0.4999999999999994}}, {
             {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], Arrowheads[
              0.], ArrowBox[{{1, 2}, {1, 6}, {2, 3}, {3, 4}, {4, 5}, {5, 6}}, 
               0.02261146496815286]}, 
             {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
              DiskBox[1, 0.02261146496815286], 
              DiskBox[2, 0.02261146496815286], 
              DiskBox[3, 0.02261146496815286], 
              DiskBox[4, 0.02261146496815286], 
              DiskBox[5, 0.02261146496815286], 
              DiskBox[6, 0.02261146496815286]}}]],
          MouseAppearanceTag["NetworkGraphics"]],
         AllowKernelInitialization->False]],
       DefaultBaseStyle->"NetworkGraphics",
       FormatType->TraditionalForm,
       FrameTicks->None],
      TraditionalForm], {480., -181.39847307544682}, {Center, Center}, {300., 342.79694615089363},
     
     BaseStyle->{Graphics3DBoxOptions -> {SphericalRegion -> False}}]}, {}},
  ImageSize->{640., 362.79694615089363`},
