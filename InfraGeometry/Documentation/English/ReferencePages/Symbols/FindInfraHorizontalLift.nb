  FontSize->0.9 Inherited,ExpressionUUID->
  "b9f48e82-a6c0-42dd-896c-3dd4870714e5"],
 " gives every one."
}], "Usage",ExpressionUUID->"3864376b-91fd-4ff3-8888-2aa1f4ab5416"],

Cell[TextData[{
 "A lift is a list of total vertices, the ",
 StyleBox["i", "TI"],
 "-th over the ",
 StyleBox["i", "TI"],
 "-th vertex of ",
 StyleBox["walk", "TI"],
 ", consecutive ones joined by an edge of ",
 StyleBox["conn", "TI"],
 "."
}], "Notes",ExpressionUUID->"c2bf0f9a-289f-4337-9ab6-37ef14fc0777"],

Cell[TextData[{
 StyleBox["x", "TI"],
 " must lie over the first vertex of ",
 StyleBox["walk", "TI"],
 "; otherwise there is no lift."
}], "Notes",ExpressionUUID->"36d239b9-c27d-439f-bb54-fc7926109b63"],

Cell[TextData[{
 "With an exact count ",
 StyleBox["n", "TI"],
 ", the result is {} when fewer than ",
 StyleBox["n", "TI"],
 " lifts exist."
}], "Notes",ExpressionUUID->"e889cb89-ab71-4905-9265-c476a17a11cc"]
}, Open  ]],

