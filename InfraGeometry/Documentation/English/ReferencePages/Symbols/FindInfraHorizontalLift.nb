Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f3b4ead8-6b45-4e5c-bc00-d7960a8b0ed5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraHorizontalLift"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraHorizontalLift", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["conn", "TI"], ",", " ", 
    StyleBox["x", "TI"], ",", " ", 
    StyleBox["walk", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88605e08-76e3-400d-be7c-60daad7a44da"],
 "\[LineSeparator]",
 "gives a list of at most ",
 StyleBox["n", "TI"],
 " horizontal lifts of the base walk ",
 StyleBox["walk", "TI"],
 " starting at the total vertex ",
 StyleBox["x", "TI"],
 ", along the connection ",
 StyleBox["conn", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"f99f76df-988e-4fd7-993c-084ed5a47142"],

Cell[TextData[{
 "A connection gives one lift of a walk from each start, so the list has at \
most one member, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHorizontalLift"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHorizontalLift", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["conn", "TI"], ",", " ", 
    StyleBox["x", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "703682cb-dc10-4c18-8693-fa94340c6857"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraHorizontalLift"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraHorizontalLift", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "11986685-a4d8-4e2e-94fe-e21b522157be"],
 " returns that lift directly."
}], "Notes",ExpressionUUID->"ebec376e-268a-4797-a044-582e0e6591f4"],

