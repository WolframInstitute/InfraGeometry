Cell[CellGroupData[{
Cell["FindInfraHorizontalLift", "ObjectName",ExpressionUUID->"f8f41dcd-5e6a-4527-8763-1ca625fd30a6"],

Cell["LLM generated.", "Notes",ExpressionUUID->"9e5e9ae0-641f-4bda-a6e3-c86dd1757d9f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2b1ce49d-8d2b-4222-9dfd-4a0f24c74f9c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraHorizontalLift"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraHorizontalLift", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["connection", "TI"], ",", " ", 
    StyleBox["start", "TI"], ",", " ", 
    StyleBox["walk", "TI"], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52d57a44-9d7f-4986-b0d6-d86be2ac45a9"],
 "\[LineSeparator]",
 "is the legacy counted-list form of ",
 Cell[BoxData["InfraHorizontalLift"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fe14763-ce6c-4605-ad5a-08c3606548f7"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"e6a8627f-9d20-468f-ad21-3c3a532cf93e"],

Cell[TextData[{
 "New code uses ",
 Cell[BoxData[
  RowBox[{"InfraHorizontalLift", "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["connection", "TI"], ",", " ", 
    StyleBox["start", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a503d23b-8592-414c-be66-d58b26785ed5"],
 ", which returns the unique vertex sequence directly."
}], "Notes",ExpressionUUID->"285e781a-be5f-4f6e-b134-1c0eaeee8478"],

Cell["\<\
The connection must be complete, and the walk and starting vertex must be \
valid for that reader.\
\>", "Notes",ExpressionUUID->"48c260a7-e40f-45b2-9c69-7402ec367c8f"],

Cell[TextData[{
 "Count 1, UpTo[",
 StyleBox["n", "TI"],
 "] with positive ",
 StyleBox["n", "TI"],
 ", and All return a singleton list containing the unique lift. Count 0 and \
UpTo[0] return {}. An exact count above one returns {} on shortage."
}], "Notes",ExpressionUUID->"d09cf4c5-14e0-4f8c-bb62-4eaa2b15e8f3"],

Cell[TextData[{
 "The shim is deterministic and delegates to ",
 Cell[BoxData["InfraHorizontalLift"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40e2c30e-7ec4-4c89-8d3b-0ec7aa2abad8"],
 ". It does not search partial or ambiguous connections."
}], "Notes",ExpressionUUID->"54f7cea9-9b31-42a0-8948-da43373ca01b"],

Cell["Unsupported arguments remain unevaluated.", "Notes",ExpressionUUID->"01d2dc7f-7d98-48cd-a910-9693e2b38a5f"]
}, Open  ]],

