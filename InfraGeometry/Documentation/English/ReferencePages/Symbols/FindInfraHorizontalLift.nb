\>", "ExampleText",ExpressionUUID->"eaf549d2-8cdd-4763-b466-8f570073128f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"fib", " ", "=", " ", 
      RowBox[{"InfraFiberedGraph", "[", " ", 
       RowBox[{"total", ",", " ", 
        RowBox[{"vertex", " ", "|->", " ", 
         RowBox[{"Mod", "[", " ", 
          RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
       " ", "]"}]}], ",", "\n", "    ", 
     RowBox[{"connection", " ", "=", " ", 
      RowBox[{"InfraConnection", "[", " ", 
       RowBox[{"EdgeList", " ", "@", " ", "total"}], " ", "]"}]}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"loop", " ", "=", " ", 
     RowBox[{"{", " ", 
      RowBox[{
      "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "1"}], " ", 
      "}"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraHorizontalLift", "[", " ", 
      RowBox[{
      "fib", ",", " ", "connection", ",", " ", "1", ",", " ", "loop"}], " ", 
      "]"}], ",", "\n", "    ", 
     RowBox[{"FindInfraHorizontalLift", "[", " ", 
      RowBox[{
      "fib", ",", " ", "connection", ",", " ", "1", ",", " ", "loop", ",", 
       " ", "1"}], " ", "]"}], ",", "\n", "    ", 
     RowBox[{"FindInfraHorizontalLift", "[", " ", 
      RowBox[{
      "fib", ",", " ", "connection", ",", " ", "1", ",", " ", "loop", ",", 
       " ", "2"}], " ", "]"}]}], " ", "}"}]}], "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0abdd2b6-46d7-4f10-a36e-b2cee19d0eaf"],

