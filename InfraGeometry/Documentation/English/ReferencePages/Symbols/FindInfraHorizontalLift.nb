  FontSize->0.9 Inherited,ExpressionUUID->
  "c9ed5218-e709-489c-a1ae-d371631ccba5"],
 ":"
}], "ExampleText",ExpressionUUID->"60efe3aa-b8d5-44a5-ab0c-7302832fdf20"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Covering\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"conn", " ", "=", " ", 
      RowBox[{"InfraConnection", "[", 
       RowBox[{"EdgeList", " ", "@", " ", 
        RowBox[{"InfraTotalSpace", "[", "fib", "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"square", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
       "45", ",", " ", "46", ",", " ", "36", ",", " ", "35", ",", " ", "45"}],
        "}"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"FindInfraHorizontalLift", "[", 
       RowBox[{"fib", ",", " ", "conn", ",", " ", 
        RowBox[{"{", 
         RowBox[{"45", ",", " ", "1"}], "}"}], ",", " ", "square", ",", " ", 
        "All"}], "]"}], " ", "===", " ", 
      RowBox[{"{", 
       RowBox[{"InfraHorizontalLift", "[", 
        RowBox[{"fib", ",", " ", "conn", ",", " ", 
         RowBox[{"{", 
          RowBox[{"45", ",", " ", "1"}], "}"}], ",", " ", "square"}], "]"}], 
       "}"}]}], ",", "\n", "    ", 
     RowBox[{"FindInfraHorizontalLift", "[", 
      RowBox[{"fib", ",", " ", "conn", ",", " ", 
       RowBox[{"{", 
        RowBox[{"45", ",", " ", "1"}], "}"}], ",", " ", "square", ",", " ", 
       "2"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2ff4958e-13f5-4fc6-8aff-2cb94afac6a8"],

