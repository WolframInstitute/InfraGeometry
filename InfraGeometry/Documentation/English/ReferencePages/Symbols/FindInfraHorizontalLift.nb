Cell[CellGroupData[{
Cell["FindInfraHorizontalLift", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"510b3d56-6e0b-4f94-aaeb-97dfb88cf298"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraHorizontalLift"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraHorizontalLift", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["connection", "TI"], ",", " ", 
    StyleBox["start", "TI"], ",", " ", 
    StyleBox["walk", "TI"], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18163020-bb70-45b2-9e04-5fe38fc9ded3"],
 "\[LineSeparator]",
 "is the legacy counted-list form of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraHorizontalLift"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraHorizontalLift", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "70eeb1de-0958-4627-9add-7ef2d4cb1e56"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"f0699f4f-3402-4f9f-b37f-14fdc616c106"],

Cell[TextData[{
 "New code uses ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHorizontalLift"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHorizontalLift", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["connection", "TI"], ",", " ", 
    StyleBox["start", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e81275c-8822-4922-8134-dc908d1f666c"],
 ", which returns the unique vertex sequence directly."
}], "Notes",ExpressionUUID->"5fa14dbb-4f74-4ec0-ac0a-fb4dc997d848"],

Cell["\<\
The connection must be complete, and the walk and starting vertex must be \
valid for that reader.\
\>", "Notes",ExpressionUUID->"1942a1da-f575-4bae-9b5c-012a5faa29c4"],

Cell[TextData[{
 "Count 1, UpTo[",
 StyleBox["n", "TI"],
 "] with positive ",
 StyleBox["n", "TI"],
 ", and All return a singleton list containing the unique lift. Count 0 and \
UpTo[0] return {}. An exact count above one returns {} on shortage."
}], "Notes",ExpressionUUID->"be9b67bd-c767-4934-9cbd-3c4191564d43"],

Cell[TextData[{
 "The shim is deterministic and delegates to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraHorizontalLift"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraHorizontalLift", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "703e8657-488e-4bea-a2c2-733161bdb2e9"],
 ". It does not search partial or ambiguous connections."
}], "Notes",ExpressionUUID->"848302ca-2457-4141-bb18-3b5be7539b84"],

Cell["Unsupported arguments remain unevaluated.", "Notes",ExpressionUUID->"25257525-fc3e-45b9-b2a3-c376a46a177a"]
}, Open  ]],

