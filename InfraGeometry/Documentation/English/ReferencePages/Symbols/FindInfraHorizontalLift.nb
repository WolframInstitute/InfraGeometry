Cell["\<\
The endpoints of the lifts from every vertex of the first fiber are the \
parallel transport.\
\>", "ExampleText",ExpressionUUID->"39a48221-524d-431d-9f48-a4dd08748896"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<MoebiusLadderCover\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"InfraConnection", " ", "@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"EdgeList", " ", "@", " ", 
         RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"First", " ", "@", " ", "#"}]}], " ", "=!=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Last", " ", "@", " ", "#"}]}]}], " ", "&"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"loop", " ", "=", " ", 
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{"Range", "[", "8", "]"}], ",", " ", "1"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Last", " ", "@", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"FindInfraHorizontalLift", "[", 
          RowBox[{
          "fib", ",", " ", "conn", ",", " ", "#", ",", " ", "loop", ",", " ", 
           "1"}], "]"}]}]}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"InfraParallelTransport", "[", 
       RowBox[{"fib", ",", " ", "conn", ",", " ", "loop"}], "]"}]}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3182cdc6-6b93-463a-a316-1a9761d1cd85"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
