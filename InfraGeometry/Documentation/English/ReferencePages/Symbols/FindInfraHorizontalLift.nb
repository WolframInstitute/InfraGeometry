Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4394586d-d000-4e77-aa82-b99b330a0c5a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraHorizontalLift"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraHorizontalLift", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["conn", "TI"], ",", " ", 
    StyleBox["x", "TI"], ",", " ", 
    StyleBox["walk", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5339fb7e-ec02-4762-805b-559c9804980f"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["n", "TI"],
 " lifts of the base walk along the edges of ",
 StyleBox["conn", "TI"],
 ", each starting at the total vertex ",
 StyleBox["x", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1a9addd4-d5bc-4720-8ce3-45548b6e4df0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraHorizontalLift"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraHorizontalLift", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["conn", "TI"], ",", " ", 
    StyleBox["x", "TI"], ",", " ", 
    StyleBox["walk", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["UpTo",
      BaseStyle->"Link"], "[", 
     StyleBox["n", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a874c022-dfae-4b5e-a1bd-6f33c106c7e4"],
 "\[LineSeparator]",
 "gives at most ",
 StyleBox["n", "TI"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraHorizontalLift"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraHorizontalLift", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["conn", "TI"], ",", " ", 
    StyleBox["x", "TI"], ",", " ", 
