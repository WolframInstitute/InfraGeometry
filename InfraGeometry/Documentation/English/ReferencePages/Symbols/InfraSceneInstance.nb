Cell["\<\
One instance of Euclid I.1 on a grid: the two circles and the vertex where \
they meet, read out of the instance and drawn.\
\>", "ExampleText",ExpressionUUID->"3e40adc9-1378-47b0-b709-f0711048ad25"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "pA", ",", " ", "pB", ",", " ", "circleA", ",", " ", "circleB", ",", " ", 
    "meet"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"13", ",", " ", "13"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "pA", ",", " ", "pB", ",", " ", "circleA", ",", " ", "circleB", ",", 
         " ", "meet"}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "83", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "87", "]"}]}], ",", "\n", "      ", 
         RowBox[{"circleA", " ", "==", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"pA", ",", " ", 
            RowBox[{"{", 
             RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}], ",", " ", 
         RowBox[{"circleB", " ", "==", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"pB", ",", " ", 
            RowBox[{"{", 
             RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}], ",", "\n", 
         "      ", 
         RowBox[{"meet", " ", "==", " ", 
          RowBox[{"InfraIntersection", "[", 
           RowBox[{"circleA", ",", " ", "circleB"}], "]"}]}]}], "}"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"first", " ", "=", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"FindInfraScene", "[", 
         RowBox[{"scene", ",", " ", "g"}], "]"}]}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraSubstrateHighlight", "[", 
        RowBox[{"g", ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"InfraWalk", "[", 
              RowBox[{"Append", "[", 
               RowBox[{"#", ",", " ", 
                RowBox[{"First", " ", "@", " ", "#"}]}], "]"}], "]"}], " ", 
             "&"}], " ", "@", " ", 
            RowBox[{"InfraSceneInstance", "[", 
             RowBox[{"first", ",", " ", "circleA"}], "]"}]}], ",", "\n", 
           "        ", 
           RowBox[{
            RowBox[{
             RowBox[{"InfraWalk", "[", 
              RowBox[{"Append", "[", 
               RowBox[{"#", ",", " ", 
                RowBox[{"First", " ", "@", " ", "#"}]}], "]"}], "]"}], " ", 
             "&"}], " ", "@", " ", 
            RowBox[{"InfraSceneInstance", "[", 
             RowBox[{"first", ",", " ", "circleB"}], "]"}]}], ",", "\n", 
           "        ", 
           RowBox[{"InfraSceneInstance", "[", 
            RowBox[{"first", ",", " ", "pA"}], "]"}], ",", " ", 
           RowBox[{"InfraSceneInstance", "[", 
            RowBox[{"first", ",", " ", "pB"}], "]"}], ",", "\n", "        ", 
           RowBox[{"InfraSceneInstance", "[", 
            RowBox[{"first", ",", " ", "meet"}], "]"}]}], "}"}], ",", "\n", 
         "       ", 
         RowBox[{"\"\<ThicknessRange\>\"", " ", "->", " ", "4"}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
       "     ", 
       RowBox[{"InfraSceneInstance", "[", 
        RowBox[{"first", ",", " ", 
         RowBox[{"{", 
          RowBox[{"pA", ",", " ", "pB", ",", " ", "meet"}], "}"}]}], "]"}]}], 
      "}"}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"096165ce-3c02-4ecf-93c2-82531caa3700"],

