Cell["One instance of Euclid I.1 and the values of its points:", "ExampleText",ExpressionUUID->"b81921ef-ebaf-4fbe-a1cc-789d4654076a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "pA", ",", " ", "pB", ",", " ", "cA", ",", " ", "cB", ",", " ", 
         "meet"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "a", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "b", "]"}]}], ",", "\n", "     ", 
         RowBox[{"cA", " ", "==", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"pA", ",", " ", 
            RowBox[{"{", 
             RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], ",", " ", 
         RowBox[{"cB", " ", "==", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"pB", ",", " ", 
            RowBox[{"{", 
             RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], ",", " ", 
         RowBox[{"meet", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", 
           RowBox[{"InfraIntersection", "[", 
            RowBox[{"cA", ",", " ", "cB"}], "]"}], "]"}]}]}], "}"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSceneInstance", "[", 
    RowBox[{
     RowBox[{"RandomInfraSceneInstance", "[", 
      RowBox[{"scene", ",", " ", "g", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"pA", ",", " ", "pB", ",", " ", "meet"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2d5c37ec-c5dc-434c-a6e7-7dca6b451a84"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"145", ",", "196", ",", "181"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9a38fc4d-a953-4bd7-aa69-90c1e0f054d7"]
}, Open  ]],

Cell["\<\
The values of one instance, drawn. A circle is closed by repeating its first \
vertex:\
\>", "ExampleText",ExpressionUUID->"65a2a7c1-19fd-45e1-b7fd-1848bbeea6c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "pA", ",", " ", "pB", ",", " ", "cA", ",", " ", "cB", ",", " ", 
         "meet"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "a", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "b", "]"}]}], ",", "\n", "     ", 
         RowBox[{"cA", " ", "==", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"pA", ",", " ", "3"}], "]"}]}], ",", " ", 
         RowBox[{"cB", " ", "==", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"pB", ",", " ", "3"}], "]"}]}], ",", " ", 
         RowBox[{"meet", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", 
           RowBox[{"InfraIntersection", "[", 
            RowBox[{"cA", ",", " ", "cB"}], "]"}], "]"}]}]}], "}"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inst", " ", "=", " ", 
     RowBox[{"RandomInfraSceneInstance", "[", 
      RowBox[{"scene", ",", " ", "g", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", "\n", "    ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"InfraWalk", "[", 
          RowBox[{"Append", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"First", " ", "@", " ", "#"}]}], "]"}], "]"}], " ", "&"}],
         " ", "/@", " ", 
        RowBox[{"InfraSceneInstance", "[", 
         RowBox[{"inst", ",", " ", 
          RowBox[{"{", 
           RowBox[{"cA", ",", " ", "cB"}], "}"}]}], "]"}]}], ",", " ", 
       RowBox[{"InfraSceneInstance", "[", 
        RowBox[{"inst", ",", " ", 
         RowBox[{"{", 
          RowBox[{"pA", ",", " ", "pB", ",", " ", "meet"}], "}"}]}], "]"}]}], 
      "]"}], ",", "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"018677be-3fa9-47e2-bdcc-bac79ef74221"],

