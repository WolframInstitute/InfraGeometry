Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7ff729aa-3724-4acb-a8cd-e67249f272d4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSceneInstance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSceneInstance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
