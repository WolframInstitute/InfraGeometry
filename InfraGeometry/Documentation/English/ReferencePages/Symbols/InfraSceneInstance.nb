  FontSize->0.9 Inherited,ExpressionUUID->
  "f6b8382b-453e-4474-9fa9-77a774bde6e1"],
 "\[LineSeparator]",
 "is one solved branch of a scene: the ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c06bffa-1ba8-4e4c-a9c5-5a15aafd0a54"],
 " ",
 StyleBox["bindings", "TI"],
 " of its objects to their values.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b420451f-b547-416d-81bb-fa118ad6c418"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSceneInstance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSceneInstance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["inst", "TI"], ",", " ", 
    StyleBox["x", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0092207-25a2-4f8a-80c7-255e2c736968"],
 "\[LineSeparator]",
 "reads the value of the object ",
 StyleBox["x", "TI"],
 " out of the instance ",
 StyleBox["inst", "TI"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSceneInstance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSceneInstance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
