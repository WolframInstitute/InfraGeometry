true. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSceneInstance"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSceneInstance", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0405f09d-dd05-4e1d-aa3e-31731228d038"],
 " draws instances, one by default, a list with a count or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d852ed27-2c95-4146-a156-182ec7a78539"],
 "."
}], "Notes",ExpressionUUID->"265b15cc-b893-4121-9158-3020226f14e2"],

