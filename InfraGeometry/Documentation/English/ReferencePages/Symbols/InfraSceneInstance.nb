Cell["An instance holds an association:", "ExampleText",ExpressionUUID->"28b40cc9-461d-44fb-bd45-95143296619a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "pB", ",", " ", "seg"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "a", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"InfraDistance", "[", 
           RowBox[{"pA", ",", " ", "pB"}], "]"}], " ", "==", " ", "2"}], ",", 
         " ", 
         RowBox[{"seg", " ", "==", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"pA", ",", " ", "pB"}], "]"}]}]}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"RandomInfraSceneInstance", "[", 
    RowBox[{"scene", ",", " ", "g", ",", " ", 
     RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"83b5206d-602c-4879-b97e-d9779ee67186"],

Cell[BoxData[
 RowBox[{"InfraSceneInstance", "[", 
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"pA", "\[Rule]", "45"}], ",", 
    RowBox[{"pB", "\[Rule]", "47"}], ",", 
    RowBox[{"seg", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"45", ",", "46", ",", "47"}], "}"}]}]}], 
   "\[RightAssociation]"}], "]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ab4a37ac-249a-4ed3-a85c-eaaab85d85e1"]
}, Open  ]],

