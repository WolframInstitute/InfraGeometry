Cell["InfraSceneInstance", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"00fc0bab-ab15-4e4b-acf9-6c7f0c250c77"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSceneInstance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSceneInstance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["bindings", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff9dacbb-a016-4903-a3ba-b0b37b78bdc7"],
 "\[LineSeparator]",
 "is one solved branch of a scene: the ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d8561f1-f604-4afc-b3cc-9954731bfa59"],
 " ",
 StyleBox["bindings", "TI"],
 " of its objects to their values.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1342983f-1d2f-439c-bcad-191ef0ec1036"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSceneInstance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSceneInstance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["inst", "TI"], ",", " ", 
    StyleBox["x", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11a334f2-5390-41d7-9e69-eb5c8f8e8f72"],
 "\[LineSeparator]",
 "reads the value of the object ",
 StyleBox["x", "TI"],
 " out of the instance ",
 StyleBox["inst", "TI"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSceneInstance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSceneInstance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["inst", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["x1", "TI"], ",", " ", 
      StyleBox["x2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1af3f27f-5064-4463-a6ee-a2b2a2b6a965"],
 " the values of several."
}], "Usage",ExpressionUUID->"131942d2-1b9d-423c-be7a-d853759ce858"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraInstance"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraInstance", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f2281dd3-20c0-4bd9-979a-d14a2765e4cc"],
 " returns one instance by default, or a list when a count is given. An \
instance is a symbolic representation of a solved branch: it stores the \
bindings for later retrieval."
}], "Notes",ExpressionUUID->"455ebc22-bb40-4f7d-9605-3f6fde3bc8ab"],

Cell[TextData[{
 "A value is what the construction of the object realised on the graph: a \
vertex for a point or an intersection, a vertex list for a segment, a ray or \
a line, a cyclic vertex list for a circle. So an instance's objects are drawn \
by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ce69da34-a70b-42e1-8622-56334283bc80"],
 " directly, a circle once it is closed into a walk."
}], "Notes",ExpressionUUID->"a27c0cb3-3649-48a1-bcf7-0c8e02bab829"],

Cell[TextData[{
 "An object the instance does not bind reads as ",
 Cell[BoxData[
  RowBox[{"Missing", "[", 
   RowBox[{"\"\<KeyAbsent\>\"", ",", " ", "x"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f852853b-aad8-43f5-b36c-f116e8560399"],
 ". The second argument also reads a bare ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28f67af6-d64a-43f5-b200-f9deecd1af4f"],
 " of bindings."
}], "Notes",ExpressionUUID->"dceb9a9b-bbf1-449b-8c82-4ff825dad515"]
}, Open  ]],

