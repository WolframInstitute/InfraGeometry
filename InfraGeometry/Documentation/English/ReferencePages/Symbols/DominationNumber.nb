Cell[TextData[{
 "On a cycle and on a path with ",
 StyleBox["n", "TI"],
 " vertices, ",
 StyleBox["N(r)", "TI"],
 " is ",
 StyleBox["\[LeftCeiling]n/(2r + 1)\[RightCeiling]", "TI"],
 ": each ball holds at most ",
 StyleBox["2r + 1", "TI"],
 " vertices."
}], "ExampleText",ExpressionUUID->"a76197d3-05e9-4ca4-bfaa-6ee000877c12"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "12", "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraBall", "[", 
        RowBox[{"#", ",", " ", "1"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"FindBallCover", "[", 
       RowBox[{
        RowBox[{"CycleGraph", "[", "12", "]"}], ",", " ", "1"}], "]"}]}]}], 
    "]"}], ",", "\n", " ", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{"Flatten", " ", "@", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"DominationNumber", "[", 
         RowBox[{
          RowBox[{"CycleGraph", "[", "n", "]"}], ",", " ", "r"}], "]"}], " ", 
        "==", " ", 
        RowBox[{"Ceiling", "[", 
         RowBox[{"n", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "r"}], " ", "+", " ", "1"}], ")"}]}], "]"}]}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "3", ",", " ", "20"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}]}]}], ",", 
   "\n", " ", 
