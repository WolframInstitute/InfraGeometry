Cell[CellGroupData[{
Cell["DominationNumber", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c100f793-70a8-4420-974f-9c1c047bd216"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DominationNumber"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DominationNumber", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e3d091f-3db2-4dba-90d3-efb13eef67b0"],
 "\[LineSeparator]",
 "gives the least number ",
 StyleBox["N(r)", "TI"],
 " of closed balls of radius ",
 StyleBox["r", "TI"],
 " that cover every vertex of ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8b2c32aa-82b8-4247-bd27-0b4b8fb820dc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DominationNumber"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DominationNumber", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["targets", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26d9c4af-6e62-45d0-9276-d7e160560ef8"],
 "\[LineSeparator]",
 "gives the least number of such balls that cover the vertices of ",
 StyleBox["targets", "TI"],
 "."
}], "Usage",ExpressionUUID->"c4adca60-e7b4-418f-a73b-db5650673156"],

Cell[TextData[{
 "Definition: ",
 StyleBox["N(r)", "TI"],
 " is the size of a smallest ",
 StyleBox["r", "TI"],
 "-dominating set, the length of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindBallCover"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindBallCover", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cad4534-dd30-4edc-9953-5fd19a3ac5bd"],
 ", computed by its exact integer program. At ",
 StyleBox["r", "TI"],
 " = 1 it is the domination number of graph theory. The radius defaults to \
1."
}], "Notes",ExpressionUUID->"72c922e8-06fe-47e2-85dd-25db0bba9e7f"],

Cell[TextData[{
 StyleBox["N(0)", "TI"],
 " is the number of vertices. ",
 StyleBox["N(r)", "TI"],
 " does not increase with ",
 StyleBox["r", "TI"],
 ", and it is 1 from the radius of the graph, the least eccentricity, on."
}], "Notes",ExpressionUUID->"a796cea3-44bc-4094-b76c-a3e4678e77af"],

Cell[TextData[{
 "How fast ",
 StyleBox["N(r)", "TI"],
 " falls as ",
 StyleBox["r", "TI"],
 " grows is a measure of dimension."
}], "Notes",ExpressionUUID->"6fecd2ea-1495-4813-94ff-bbeed9d565ad"]
}, Open  ]],

