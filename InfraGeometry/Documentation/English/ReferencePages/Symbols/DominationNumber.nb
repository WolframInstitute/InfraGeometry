Cell["\<\
With targets: the number of balls of radius 2 that cover the ball of radius 4 \
about the centre.\
\>", "ExampleText",ExpressionUUID->"3ff4d31d-05f3-4e4d-bb85-bac9f614ff6a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"target", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{
         RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "4"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"target", " ", "->", " ", "StandardGray"}], ",", " ", 
         RowBox[{
          RowBox[{"FindBallCover", "[", 
           RowBox[{"g", ",", " ", "2", ",", " ", "target"}], "]"}], " ", "->",
           " ", "StandardRed"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"DominationNumber", "[", 
      RowBox[{"g", ",", " ", "2", ",", " ", "target"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"83a9763e-5cd9-477f-9054-ec7fcb0d72de"],

