Cell[BoxData[
 RowBox[{"ListLogPlot", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
       "\n", "      ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", ",", " ", 
           RowBox[{"DominationNumber", "[", 
            RowBox[{"g", ",", " ", "r"}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "0", ",", " ", 
           RowBox[{"GraphRadius", "[", "g", "]"}]}], "}"}]}], "]"}]}], "]"}], 
     ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"name", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
         " ", "\"\<SquareTilingGraph\>\"", ",", 
         " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], ",", 
   "\n", "  ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", "\n", "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
       ",", " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<r\>\"", ",", " ", "\"\<N(r)\>\""}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c147abbd-771f-4962-b23e-6b99f06ab715"],

