Cell["\<\
In degree 1 the coboundary lives on the triangles. The 1-cochain that is 1 on \
one edge at the centre has coboundary \[PlusMinus]1 on the two triangles at \
that edge, drawn blue where it is positive on the counterclockwise order of \
the corners and red where it is negative: the edge runs counterclockwise \
round one triangle and clockwise round the other.\
\>", "ExampleText",ExpressionUUID->"6cd02b79-803b-4116-9ab5-52daba69571a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"center", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
     RowBox[{"positions", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
