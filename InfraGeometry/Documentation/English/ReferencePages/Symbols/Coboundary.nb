Cell[TextData[{
 "The first Betti number of the clique complex, ",
 StyleBox["b\:2081 = dim ker \[Delta]\:2081 \[Minus] rank \[Delta]\:2080", 
  "TI"],
 ", from the matrices of the coboundary. On the grid it is 49, the number of \
square cells; on the mesh it is 0:"
}], "ExampleText",ExpressionUUID->"a608280d-4d03-4193-b51d-3197fead3d0e"],

