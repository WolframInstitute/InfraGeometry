Cell[TextData[{
 "The coboundary of the distance ",
 StyleBox["f", "TI"],
 " from the centre. On the grid every edge joins two shells, so ",
 StyleBox["\[Delta]f", "TI"],
 " is \[PlusMinus]1 on all 144 edges. On the mesh it is 0 on the 82 edges \
inside a shell, drawn:"
}], "ExampleText",ExpressionUUID->"22bad5dd-2874-4c1c-87a7-0089c8d8d7af"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"df", " ", "=", " ", 
        RowBox[{"Coboundary", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"AssociationThread", "[", 
           RowBox[{
            RowBox[{"List", " ", "/@", " ", 
             RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "c"}], "]"}]}], "]"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", 
          RowBox[{"InfraWalk", " ", "/@", " ", 
           RowBox[{"Complement", "[", 
            RowBox[{
             RowBox[{"Sort", " ", "/@", " ", 
              RowBox[{"List", " ", "@@@", " ", 
               RowBox[{"EdgeList", "[", "g", "]"}]}]}], ",", " ", 
             RowBox[{"Keys", "[", "df", "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
        "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Length", "[", "df", "]"}], ",", " ", 
           RowBox[{"EdgeCount", "[", "g", "]"}]}], "}"}]}]}], "]"}]}], "]"}], 
    ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"fd873d2f-9086-471e-b24b-2cea45643bbd"],

