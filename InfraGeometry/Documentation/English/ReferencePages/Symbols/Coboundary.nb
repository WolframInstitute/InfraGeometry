Notebook[{

Cell[CellGroupData[{
Cell["Coboundary", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ad337f40-770b-4270-a562-e5beef099d2e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Coboundary"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/Coboundary", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["\[Alpha]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb18a7d5-c6c1-479b-bdc0-cb8f15d9d904"],
 "\[LineSeparator]",
 "gives the coboundary ",
 StyleBox["\[Delta]\[Alpha]", "TI"],
 " of the ",
 StyleBox["k", "TI"],
 "-cochain ",
 StyleBox["\[Alpha]", "TI"],
 ", a (",
 StyleBox["k", "TI"],
 " + 1)-cochain on the (",
 StyleBox["k", "TI"],
 " + 2)-cliques of ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"9a0972f1-6a39-47fc-b056-ca71112e0091"],

Cell[TextData[{
 "The coboundary is ",
 StyleBox["(\[Delta]\[Alpha])(v\:2080, \[Ellipsis], v\:2096\:208a\:2081) = \
\[CapitalSigma]\:1d62 (\[Minus]1)\:2071 \[Alpha](v\:2080, \[Ellipsis], \
v\:0302\:1d62, \[Ellipsis], v\:2096\:208a\:2081)", "TI"],
 ", the sum over ",
 StyleBox["i", "TI"],
 " = 0, \[Ellipsis], ",
 StyleBox["k", "TI"],
 " + 1."
}], "Notes",ExpressionUUID->"8495ef84-5d40-481f-9aba-2683f89431cf"],

Cell[TextData[{
 "A ",
 StyleBox["k", "TI"],
 "-cochain lives on the ",
 StyleBox["k", "TI"],
 "-simplices of the clique complex of ",
 StyleBox["g", "TI"],
 ", its (",
 StyleBox["k", "TI"],
 " + 1)-cliques. It is an association ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v0", ",", " ", "\[Ellipsis]", ",", " ", "vk"}], "}"}], " ", "->",
      " ", "value"}], ",", " ", "\[Ellipsis]"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0298dedc-ccdc-470c-a91f-f77f11dfe28e"],
 " on the increasing vertex lists; a 0-cochain is ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{
     RowBox[{"{", "v", "}"}], " ", "->", " ", "value"}], ",", " ", 
    "\[Ellipsis]"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c79eceb-f456-4370-a2a5-b175439340de"],
 ". A value 0 is not stored."
}], "Notes",ExpressionUUID->"a01e0ab7-6f74-4be3-a31c-94add0f3b465"],

Cell[TextData[{
 "On a 0-cochain ",
 StyleBox["f", "TI"],
 ", ",
 StyleBox["(\[Delta]f)(u, v) = f(v) \[Minus] f(u)", "TI"],
 " on every edge."
}], "Notes",ExpressionUUID->"db0feb5c-ec3f-4619-a576-1cf7539bfc68"],

Cell[TextData[{
 StyleBox["\[Delta](\[Delta]\[Alpha]) = 0", "TI"],
 ", and the cohomology ",
 StyleBox["H\:1d4f", "TI"],
 " of the clique complex is the kernel of ",
 StyleBox["\[Delta]", "TI"],
 " in degree ",
 StyleBox["k", "TI"],
 " modulo the image of ",
 StyleBox["\[Delta]", "TI"],
 " from degree ",
 StyleBox["k", "TI"],
 " \[Minus] 1."
}], "Notes",ExpressionUUID->"fb5b003b-c4dd-45ad-b420-8904d7f7ab40"],

Cell[TextData[{
 "The square grid has no triangles. The coboundary of every 1-cochain on it \
is 0, and ",
 StyleBox["H\.b9", "TI"],
 " has one dimension for every square cell. The square mesh is a triangulated \
disk, and its ",
 StyleBox["H\.b9", "TI"],
 " is 0."
}], "Notes",ExpressionUUID->"893c6c9c-a757-458c-b8b8-c02d86796b9b"],

Cell[TextData[{
 "The coboundary is the same for alternating and for ordered cochains (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrderedCochainCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b8d6bb99-1c6d-4e6a-943c-36e1a219ab33"],
 ")."
}], "Notes",ExpressionUUID->"45b05c59-0cab-4780-b057-1026abcf9f0a"]
}, Open  ]],

