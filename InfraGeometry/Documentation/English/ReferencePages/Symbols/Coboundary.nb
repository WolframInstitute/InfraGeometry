Cell["\<\
The coboundary of the distance from the centre on the square, the hexagonal \
and the triangular tiling, drawn by an arc along each edge in the direction \
in which it is 1: every step from one shell to the next. Beside it, the \
number of edges with a value and the number of edges. The square and the \
hexagonal tiling are bipartite, and on the triangular tiling 60 edges lie \
inside a shell, where the coboundary is 0.\
\>", "ExampleText",ExpressionUUID->"bf5d2e41-a490-457a-a729-391e9f35f1ee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graphs", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"#", ",", " ", "\"\<Small\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}],
        " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"cochains", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"Coboundary", "[", 
        RowBox[{"substrate", ",", " ", 
         RowBox[{"AssociationMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"substrate", ",", " ", 
              RowBox[{"First", " ", "@", " ", 
               RowBox[{"GraphCenter", "[", "substrate", "]"}]}], ",", " ", 
              RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
           RowBox[{"List", " ", "/@", " ", 
            RowBox[{"VertexList", "[", "substrate", "]"}]}]}], "]"}]}], "]"}],
        ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"substrate", ",", " ", "graphs"}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"MapThread", "[", "\n", "     ", 
       RowBox[{
        RowBox[{
         RowBox[{"DisplacementPlot", "[", 
          RowBox[{"#1", ",", " ", 
           RowBox[{"GroupBy", "[", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"Keys", " ", "@", " ", 
                RowBox[{"Select", "[", 
                 RowBox[{"#2", ",", " ", "Positive"}], "]"}]}], ",", " ", 
               RowBox[{"Reverse", " ", "/@", " ", 
                RowBox[{"Keys", " ", "@", " ", 
                 RowBox[{"Select", "[", 
                  RowBox[{"#2", ",", " ", "Negative"}], "]"}]}]}]}], "]"}], ",",
              " ", 
             RowBox[{"First", " ", "->", " ", "Last"}]}], "]"}]}], "]"}], " ",
          "&"}], ",", "\n", "     ", 
        RowBox[{"{", 
         RowBox[{"graphs", ",", " ", "cochains"}], "}"}]}], "]"}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", " ", "/@", " ", "cochains"}], ",", " ", 
        RowBox[{"EdgeCount", " ", "/@", " ", "graphs"}]}], "}"}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"49683443-1f42-486a-82d1-0b1a3ec556ed"],

