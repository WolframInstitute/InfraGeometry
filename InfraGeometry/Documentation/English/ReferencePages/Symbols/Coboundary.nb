Cell["\<\
A vertex function keyed by the vertices themselves is no cochain, since a \
vertex name may be a list: the call stays unevaluated, with no message. Keyed \
by one-vertex lists it has 150 values.\
\>", "ExampleText",ExpressionUUID->"7ffb4469-354b-4606-91c7-af72b27f7c7e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"values", " ", "=", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "#"}], "]"}], 
        " ", "&"}], ",", " ", 
       RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", "values"}], "]"}], ",", " ", 
     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", "values"}], "]"}]}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"KeyMap", "[", 
         RowBox[{"List", ",", " ", "values"}], "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c983283a-ee69-4088-8a35-0f7b88cb28e6"],

