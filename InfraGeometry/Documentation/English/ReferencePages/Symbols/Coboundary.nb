Cell["\<\
The coboundary of a coboundary is 0. A random 0-cochain on the mesh:\
\>", "ExampleText",ExpressionUUID->"4353bc4d-d6e9-4023-8c7b-8abc38261eb1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"List", " ", "/@", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
       RowBox[{"BlockRandom", "[", 
        RowBox[{
         RowBox[{"RandomInteger", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", " ", "102"}], 
          "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", "f"}], "]"}], "]"}], ",", " ", 
     RowBox[{"Coboundary", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", "f"}], "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0a09e965-3082-497b-b0d8-004c28ccfe8c"],

