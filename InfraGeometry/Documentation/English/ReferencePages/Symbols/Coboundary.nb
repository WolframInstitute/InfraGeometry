               RowBox[{
                RowBox[{"{", "v", "}"}], " ", "->", " ", "1"}], "|>"}]}], 
             "]"}], ",", " ", "edges", ",", " ", "0"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"v", ",", " ", 
