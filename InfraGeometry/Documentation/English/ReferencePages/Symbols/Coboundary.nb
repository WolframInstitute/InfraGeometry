Notebook[{

Cell[CellGroupData[{
Cell["Coboundary", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b5550abe-2f2c-4ec7-8c60-175bfd3b08e2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Coboundary"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/Coboundary", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["\[Alpha]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56e4b109-81ad-47a4-8fd2-794f1ba39f6d"],
 "\[LineSeparator]",
 "gives the coboundary ",
 StyleBox["\[Delta]\[Alpha]", "TI"],
 " of the ",
 StyleBox["k", "TI"],
 "-cochain ",
 StyleBox["\[Alpha]", "TI"],
 ": on each (",
 StyleBox["k", "TI"],
 " + 2)-clique of ",
 StyleBox["g", "TI"],
 ", the alternating sum of ",
 StyleBox["\[Alpha]", "TI"],
 " over its faces.",
 "\n"
}], "Usage",ExpressionUUID->"88558e0b-dea2-43d6-9ac1-161c47165d90"],

Cell[TextData[{
 "Definition: ",
 StyleBox["(\[Delta]\[Alpha])(v\:2080, \[Ellipsis], v\:2096\:208a\:2081) = \
\[CapitalSigma]\:1d62 (\[Minus]1)\:2071 \[Alpha](v\:2080, \[Ellipsis], \
v\:0302\:1d62, \[Ellipsis], v\:2096\:208a\:2081)", "TI"],
 ", the sum over the positions ",
 StyleBox["i", "TI"],
 " = 0, \[Ellipsis], ",
 StyleBox["k", "TI"],
 " + 1. It maps the ",
 StyleBox["k", "TI"],
 "-cochains to the (",
 StyleBox["k", "TI"],
 " + 1)-cochains of the clique complex of ",
 StyleBox["g", "TI"],
 "."
}], "Notes",ExpressionUUID->"b8408622-ed46-4d21-b5fe-14e76916b16d"],

Cell[TextData[{
 "On a 0-cochain ",
 StyleBox["f", "TI"],
 ", ",
 StyleBox["(\[Delta]f)(u, v) = f(v) \[Minus] f(u)", "TI"],
 " on every edge."
}], "Notes",ExpressionUUID->"3710958e-5745-459a-8d4b-f97f5c25633c"],

Cell[TextData[{
 StyleBox["\[Delta](\[Delta]\[Alpha]) = 0", "TI"],
 ": in the double sum each pair of deleted vertices occurs twice, with \
opposite signs. The cohomology of the clique complex is the kernel of ",
 StyleBox["\[Delta]", "TI"],
 " modulo its image."
}], "Notes",ExpressionUUID->"46979ea5-72bc-4b58-ae15-321bb043d61b"],

Cell["\<\
The coboundary is the same in the alternating and in the ordered convention: \
it reads only the stored values on the faces of an increasing tuple, which \
are increasing.\
\>", "Notes",ExpressionUUID->"9d0453d9-9c7e-4bf7-b3be-cf5092cf2543"],

Cell[TextData[{
 "A ",
 StyleBox["k", "TI"],
 "-cochain is keyed by increasing (",
 StyleBox["k", "TI"],
 " + 1)-vertex lists, a 0-cochain by one-vertex lists, ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"{", "v", "}"}], " ", "->", " ", "value"}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f1453dfa-e935-4fa4-8aec-2b609a32711c"],
 "; an association keyed by anything else stays unevaluated. A value equal to \
0, a machine 0. too, is not stored."
}], "Notes",ExpressionUUID->"7ad62e02-34c2-4fd6-9dad-b40698d416d1"]
}, Open  ]],

