              RowBox[{"<|", 
               RowBox[{"e", " ", "->", " ", "1"}], "|>"}]}], "]"}], ",", " ", 
            "triangles", ",", " ", "0"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"e", ",", " ", "edges"}], "}"}]}], "]"}]}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{
      RowBox[{"Length", "[", "edges", "]"}], " ", "-", " ", 
      RowBox[{"MatrixRank", "[", "d1", "]"}], " ", "-", " ", 
      RowBox[{"MatrixRank", "[", "d0", "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", 
       " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
