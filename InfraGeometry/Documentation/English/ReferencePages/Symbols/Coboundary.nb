Cell["\<\
The coboundary of a coboundary is empty. The coboundary of a random 0-cochain \
on the triangular tiling has three values round each triangle that add up to \
0, so its own coboundary is empty.\
\>", "ExampleText",ExpressionUUID->"5444d279-c886-4884-932d-b77603e0f145"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cochain", " ", "=", " ", 
     RowBox[{"Coboundary", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"AssociationMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"RandomInteger", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], "]"}], " ", "&"}], 
           ",", " ", 
           RowBox[{"List", " ", "/@", " ", 
            RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], ")"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"GroupBy", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Keys", " ", "@", " ", 
            RowBox[{"Select", "[", 
             RowBox[{"cochain", ",", " ", "Positive"}], "]"}]}], ",", " ", 
           RowBox[{"Reverse", " ", "/@", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"Select", "[", 
              RowBox[{"cochain", ",", " ", "Negative"}], "]"}]}]}]}], "]"}], ",",
          " ", 
         RowBox[{"First", " ", "->", " ", "Last"}]}], "]"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", "cochain"}], "]"}]}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"dd62d78a-b628-412f-8b25-fa23d75a2352"],

