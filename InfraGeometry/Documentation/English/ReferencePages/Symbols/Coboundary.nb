Cell["\<\
In degree 1 the coboundary lives on the triangles. The 1-cochain that is 1 on \
one edge at the centre of the mesh has coboundary \[PlusMinus]1 on the two \
triangles at that edge: blue where it is positive on the counterclockwise \
order of the corners, red where it is negative. The edge runs \
counterclockwise round one triangle and clockwise round the other:\
\>", "ExampleText",ExpressionUUID->"6c7bd0c6-b17d-4c80-9622-7bc2833bd84c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"pos", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"edge", " ", "=", " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"AdjacencyList", "[", 
           RowBox[{"g", ",", " ", "c"}], "]"}]}]}], "}"}], "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cob", " ", "=", " ", 
     RowBox[{"Coboundary", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"<|", 
        RowBox[{"edge", " ", "->", " ", "1"}], "|>"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{"KeyValueMap", "[", "\n", "      ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "a"}], "}"}], " ", "|->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"a", " ", 
               RowBox[{"Det", "[", 
                RowBox[{"Differences", "[", 
                 RowBox[{"pos", " ", "/@", " ", "t"}], "]"}], "]"}]}], " ", ">",
               " ", "0"}], ",", " ", "StandardBlue", ",", " ", 
             "StandardRed"}], "]"}], ",", " ", 
           RowBox[{"Polygon", "[", 
            RowBox[{"pos", " ", "/@", " ", "t"}], "]"}]}], "}"}]}], ",", " ", 
        "cob"}], "]"}], "]"}], ",", "\n", "    ", 
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraWalk", "[", "edge", "]"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Normal", "[", "cob", "]"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2761d001-6632-414b-a147-1328dcc4e5ae"],

