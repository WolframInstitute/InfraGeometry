Notebook[{

Cell[CellGroupData[{
Cell["InfraRegionNearest", "ObjectName",ExpressionUUID->"87d8282d-3338-4685-aadf-536e53547185"],

Cell["LLM generated.", "Notes",ExpressionUUID->"0b849f34-8414-4f54-a7e2-57a578c82fca"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ce7e0f3c-b78c-49a7-8a53-76af9ece6511"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRegionNearest"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRegionNearest", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["object", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e46e7f44-9d95-4ffb-acc3-df353875d498"],
 "\[LineSeparator]",
 "is the family of vertices of ",
 StyleBox["object", "TI"],
 " nearest to the query vertex ",
 StyleBox["p", "TI"],
 " in graph distance, retaining all ties.",
 "\n"
}], "Usage",ExpressionUUID->"298d1d02-bdb9-49f1-beb6-f42745af3045"],

Cell[TextData[{
 "This is the metric projection of a point onto a region. Let ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "466cf44d-1ffe-41a7-9c22-2470498b110b"],
 " be the nonzero support of the vertex density of ",
 StyleBox["object", "TI"],
 ", and let ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb70ac2b-6cb0-4753-9f2b-979ed91ef384"],
 " be the vertices of ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca87a21f-f679-4f46-8ea2-4d2ed860fa59"],
 " reachable from ",
 StyleBox["p", "TI"],
 ". The family is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["v", "TI"], "\[Element]", 
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["p", "TI"]]}], ":", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["p", "TI"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    UnderscriptBox[
     StyleBox["min",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["u", "TI"], "\[Element]", 
      SubscriptBox[
       StyleBox["S", "TI"], 
       StyleBox["p", "TI"]]}],
     LimitsPositioning->False], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["p", "TI"], ",", 
     StyleBox["u", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "893ef0c3-f910-435a-9987-2d57f5b244c1"],
 ". It is empty when ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71e8636c-9d7d-416c-93b7-c355ccb3a6e4"],
 " is empty. Thus the first argument specifies where the answer must lie; the \
second argument is the point from which distance is measured."
}], "Notes",ExpressionUUID->"5c33200f-522f-49c1-b419-45a52794c494"],

Cell[TextData[{
 "For example, in the path 1--2--3--4--5, the nearest vertex of {1, 5} to 2 \
is 1. The nearest vertices of the same region to 3 are 1 and 5, tied at \
distance 2. If ",
 StyleBox["p", "TI"],
 " belongs to the region, it is the unique nearest vertex."
}], "Notes",ExpressionUUID->"577df074-4f3f-4bac-b9b0-ac195587433b"],

Cell[TextData[{
 "The head is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "769f0a08-0e09-4448-b1cc-ac47ec6a285d"],
 " gives the complete family with unit \"VertexDensity\". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraRegionNearest"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRegionNearest", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dbd84f2c-6bef-41d9-abdd-43866dc7cf5c"],
 " chooses one nearest vertex, or a requested number of distinct nearest \
vertices. One representative is a raw vertex label, including a List-valued \
label. Density weights determine the support but do not affect which vertices \
are nearest."
}], "Notes",ExpressionUUID->"09d2a3e2-3dca-48f2-a8ed-465c66216625"],

Cell[TextData[{
 "The region may be an inert object supported by \"VertexDensity\", a raw \
vertex, a vertex list, a numeric density association, or a graph carrier. The \
substrate must be finite, simple, undirected and unweighted, and ",
 StyleBox["p", "TI"],
 " must be one of its vertices. Empty or unreachable regions give an empty \
family. Unsupported arguments and properties stay unevaluated."
}], "Notes",ExpressionUUID->"62d36480-5658-49d7-ac28-16b1b05b37fb"],

Cell["\<\
Supported measurements are \"VertexDensity\", \"Cardinality\", \
\"CountingMeasure\", \"Subgraph\" and \"RiemannianMeasure\". \
\"RiemannianMeasure\" counts support vertices whose neighbours all belong to \
the support.\
\>", "Notes",ExpressionUUID->"6d98ece9-9af9-4c66-b506-4acb48459312"]
}, Open  ]],

