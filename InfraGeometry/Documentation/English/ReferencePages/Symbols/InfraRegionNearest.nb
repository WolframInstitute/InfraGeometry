Notebook[{

Cell[CellGroupData[{
Cell["InfraRegionNearest", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"eea94e0e-6bb9-49a0-9057-391ed59c8c3e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRegionNearest"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRegionNearest", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["object", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4ed3a7f-911b-4b43-902e-dd117b286c92"],
 "\[LineSeparator]",
 "is the point family of all nearest support vertices to ",
 StyleBox["p", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"a9c57d15-08bd-4525-8c44-b4034303e996"],

Cell["\<\
The graph must be finite, simple, undirected and unweighted, with valid \
vertex anchors. Unsupported arguments and properties stay unevaluated. The \
head is inert until a graph-aware reader or named sampler evaluates it.\
\>", "Notes",ExpressionUUID->"a632f6fc-9eb2-4a8e-88ae-6929c06fd9eb"],

Cell["\<\
One representative is one raw vertex label, including a List-valued label. \
The complete family has distinct vertices in graph vertex order and unit \
vertex density. Supported measurements are \"VertexDensity\", \
\"Cardinality\", \"CountingMeasure\", \"Subgraph\" and \"RiemannianMeasure\". \
The last measure uses the existing interior-support law. \"Graph\", \
\"EdgeDensity\", \"Length\", \"Area\" and \"Volume\" are unsupported for \
these point families.\
\>", "Notes",ExpressionUUID->"4ab100fd-4a48-4609-a961-5524c42918a5"],

Cell[TextData[{
 "The support is the nonzero supported vertex density of the object, or a \
supported raw vertex, vertex List, density Association or Graph carrier. \
Every finite-distance minimizer is retained. Empty or unreachable support \
gives an empty family. Unsupported support stays unevaluated. If ",
 StyleBox["p", "TI"],
 " is in the support, it is the unique nearest point."
}], "Notes",ExpressionUUID->"865735f8-6ef6-48b2-a530-877109ad31c9"]
}, Open  ]],

