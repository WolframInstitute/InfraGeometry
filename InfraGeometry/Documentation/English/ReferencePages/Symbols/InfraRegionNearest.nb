Notebook[{

Cell[CellGroupData[{
Cell["InfraRegionNearest", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3e500b71-5a62-4a0a-ab32-0553d2372af1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRegionNearest"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRegionNearest", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["object", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07bd45ce-4dca-41dc-9813-d1d00df7cde3"],
 "\[LineSeparator]",
 "is the family of vertices of ",
 StyleBox["object", "TI"],
 " nearest to the query vertex ",
 StyleBox["p", "TI"],
 " in graph distance, retaining all ties.",
 "\n"
}], "Usage",ExpressionUUID->"1b2d104f-3716-4f6f-86ec-e3441821844f"],

Cell[TextData[{
 "This is the metric projection of a point onto a region. Let ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "111a8a62-1a44-4371-834b-26ae7a918323"],
 " be the nonzero support of the vertex density of ",
 StyleBox["object", "TI"],
 ", and let ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19be952a-a2db-4184-8d45-dae721b23fcc"],
 " be the vertices of ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0ddb51c-f612-44dd-aa3b-330db0662976"],
 " reachable from ",
 StyleBox["p", "TI"],
 ". The family is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["v", "TI"], "\[Element]", 
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["p", "TI"]]}], ":", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["p", "TI"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    UnderscriptBox[
     StyleBox["min",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["u", "TI"], "\[Element]", 
      SubscriptBox[
       StyleBox["S", "TI"], 
       StyleBox["p", "TI"]]}],
     LimitsPositioning->False], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["p", "TI"], ",", 
     StyleBox["u", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ac80815-e71b-4b3d-bb50-db821596d122"],
 ". It is empty when ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539328fc-003f-4dd7-8467-af79a2295f71"],
 " is empty. Thus the first argument specifies where the answer must lie; the \
second argument is the point from which distance is measured."
}], "Notes",ExpressionUUID->"7c264d1f-e8f9-4dd1-b1e9-a1e2a5add078"],

Cell[TextData[{
 "For example, in the path 1--2--3--4--5, the nearest vertex of {1, 5} to 2 \
is 1. The nearest vertices of the same region to 3 are 1 and 5, tied at \
distance 2. If ",
 StyleBox["p", "TI"],
 " belongs to the region, it is the unique nearest vertex."
}], "Notes",ExpressionUUID->"48e03457-d62f-436b-8755-b74194978f9f"],

Cell[TextData[{
 "The head is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "18e3a44e-282c-414e-8497-6254eb07380a"],
 " gives the complete family with unit \"VertexDensity\". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraRegionNearest"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRegionNearest", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "68caaa39-ab9c-4139-8067-02f388e9b72b"],
 " chooses one nearest vertex, or a requested number of distinct nearest \
vertices. One representative is a raw vertex label, including a List-valued \
label. Density weights determine the support but do not affect which vertices \
are nearest."
}], "Notes",ExpressionUUID->"fa95fe9e-5eae-4bcd-a96b-c4901da314b8"],

Cell[TextData[{
 "The region may be an inert object supported by \"VertexDensity\", a raw \
vertex, a vertex list, a numeric density association, or a graph carrier. The \
substrate must be finite, simple, undirected and unweighted, and ",
 StyleBox["p", "TI"],
 " must be one of its vertices. Empty or unreachable regions give an empty \
family. Unsupported arguments and properties stay unevaluated."
}], "Notes",ExpressionUUID->"9ea9488c-9ca9-41a7-8515-63c2824e3cd4"],

Cell["\<\
Supported measurements are \"VertexDensity\", \"Cardinality\", \
\"CountingMeasure\", \"Subgraph\" and \"RiemannianMeasure\". \
\"RiemannianMeasure\" counts support vertices whose neighbours all belong to \
the support.\
\>", "Notes",ExpressionUUID->"88de152a-ef82-4875-a3e9-5f9119464a8b"]
}, Open  ]],

