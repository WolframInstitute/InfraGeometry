Cell["\<\
Find the point of {1, 5} nearest to 2. The density is <|1 -> 1|>.\
\>", "ExampleText",ExpressionUUID->"fb2a144a-28f3-4cdd-8ac8-ee9b011b24f6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"PathGraph", "[", " ", 
       RowBox[{"Range", "[", " ", "5", " ", "]"}], " ", "]"}]}], " ", "}"}], ",",
     "\n", "  ", 
    RowBox[{"InfraMeasurement", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"InfraRegionNearest", "[", " ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{"1", ",", " ", "5"}], " ", "}"}], ",", " ", "2"}], " ", 
       "]"}], ",", " ", "\"\<VertexDensity\>\""}], " ", "]"}]}], " ", 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"be9abd2f-f61d-449d-8f6a-d6cb161f9bc2"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{"1", "\[Rule]", "1"}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"4ab12efb-d914-482f-abff-193e766c4e03"]
}, Open  ]],

Cell["\<\
Retain both ties when the query point is 3. The density is <|1 -> 1, 5 -> 1|>.\
\>", "ExampleText",ExpressionUUID->"9a67d21a-ff07-40ed-8f83-7bc5709ac660"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
