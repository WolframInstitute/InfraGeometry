        TagBox[
         {RGBColor[0.790588, 0.201176, 0.], Opacity[1.], 
          DiskBox[{0., 1.102182119232618*^-15}, 0.04847715736040609]},
         "DynamicName",
         BoxID -> "VertexID$1"], 
        TagBox[
         {RGBColor[0.790588, 0.201176, 0.], Opacity[1.], 
          DiskBox[{1., 9.797174393178826*^-16}, 0.04847715736040609]},
         "DynamicName",
         BoxID -> "VertexID$2"], 
        TagBox[
         {RGBColor[0.192157, 0.388235, 0.807843], Opacity[1.], 
          DiskBox[{2., 8.572527594031472*^-16}, 0.04847715736040609]},
         "DynamicName",
         BoxID -> "VertexID$3"], 
        TagBox[DiskBox[{3., 7.347880794884119*^-16}, 0.04847715736040609],
         "DynamicName",
         BoxID -> "VertexID$4"], 
        TagBox[DiskBox[{4., 4.898587196589412*^-16}, 0.04847715736040609],
         "DynamicName",
         BoxID -> "VertexID$5"], 
        TagBox[DiskBox[{5., 2.449293598294706*^-16}, 0.04847715736040609],
         "DynamicName",
         BoxID -> "VertexID$6"], 
        TagBox[
         {RGBColor[1., 0.607843, 0.], Opacity[1.], 
          DiskBox[{6., 0.}, 0.04847715736040609]},
         "DynamicName",
         BoxID -> "VertexID$7"]}}],
     MouseAppearanceTag["NetworkGraphics"]],
    AllowKernelInitialization->False]],
  DefaultBaseStyle->"NetworkGraphics",
  FormatType->TraditionalForm,
  FrameTicks->None]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"dd0a96a2-9d60-4c20-8ba9-c141b2b726a1"]
}, Open  ]],

Cell["Choose one of the tied nearest vertices.", "ExampleText",ExpressionUUID->"d6f3100c-409f-442e-b092-6e7b8b9764f0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"PathGraph", "[", " ", 
       RowBox[{"Range", "[", " ", "5", " ", "]"}], " ", "]"}]}], " ", "}"}], ",",
     "\n", "  ", 
