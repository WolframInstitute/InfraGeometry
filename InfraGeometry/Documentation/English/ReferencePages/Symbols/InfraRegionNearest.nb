         RowBox[{"1", ",", " ", "5"}], " ", "}"}], ",", " ", "3"}], " ", 
       "]"}], ",", " ", 
      RowBox[{"RandomSeeding", " ", "->", " ", "71"}]}], " ", "]"}]}], " ", 
   "]"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"98b9493a-b3c1-4694-b3d4-a4a031ceb5fa"],

Cell[BoxData["1"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"d805d1e1-dac7-4135-8109-cc9b693afd5e"]
