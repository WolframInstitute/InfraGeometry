Cell["Draw the complete support.", "ExampleText",ExpressionUUID->"c4b24daa-7cb5-44e0-b4c6-b50cf20aa431"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"PathGraph", "[", " ", 
       RowBox[{"Range", "[", " ", "3", " ", "]"}], " ", "]"}]}], " ", "}"}], ",",
     "\n", "  ", 
    RowBox[{"InfraSubstrateHighlight", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"{", " ", 
       RowBox[{"InfraRegionNearest", "[", " ", 
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{"1", ",", " ", "3"}], " ", "}"}], ",", " ", "2"}], " ", 
        "]"}], " ", "}"}]}], " ", "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ce81712a-cead-47f2-b693-2660b693c203"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3}, {Null, {{1, 2}, {2, 3}}}, {
      VertexShapeFunction -> {3 -> (Append[{
            RGBColor[0.790588, 0.201176, 0.], 
            Opacity[1.]}, 
           Disk[#, 1 #3]]& ), 1 -> (Append[{
            RGBColor[0.790588, 0.201176, 0.], 
            Opacity[1.]}, 
           Disk[#, 1 #3]]& )}}]]}, 
    TagBox[GraphicsGroupBox[{
       {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], 
        LineBox[{{
          DynamicLocation["VertexID$1", Automatic, Center], DynamicLocation[
           "VertexID$2", Automatic, Center]}, {
          DynamicLocation["VertexID$2", Automatic, Center], DynamicLocation[
           "VertexID$3", Automatic, Center]}}]}, 
       {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
        TagBox[
         {RGBColor[0.790588, 0.201176, 0.], Opacity[1.], 
          DiskBox[{0., 3.6739403974420594`*^-16}, 0.02261146496815286]},
         "DynamicName",
         BoxID -> "VertexID$1"], 
        TagBox[DiskBox[{1., 2.4492935982947064`*^-16}, 0.02261146496815286],
         "DynamicName",
         BoxID -> "VertexID$2"], 
        TagBox[
         {RGBColor[0.790588, 0.201176, 0.], Opacity[1.], 
          DiskBox[{2., 0.}, 0.02261146496815286]},
         "DynamicName",
         BoxID -> "VertexID$3"]}}],
     MouseAppearanceTag["NetworkGraphics"]],
    AllowKernelInitialization->False]],
  DefaultBaseStyle->"NetworkGraphics",
  FormatType->TraditionalForm,
  FrameTicks->None]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"76abd35f-e0a6-4b9e-9dfc-cee1de19aa82"]
}, Open  ]],

