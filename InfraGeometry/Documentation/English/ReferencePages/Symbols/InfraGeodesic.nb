 " graph past the germ:"
}], "ExampleText",ExpressionUUID->"e600089d-5675-40ed-b78f-cfc2a983f7be"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"AdjacencyList", "[", 
       RowBox[{"g", ",", " ", "c"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ray", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraHalfLine", "[", 
        RowBox[{"c", ",", " ", "q"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"EdgeList", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraGeodesic", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"c", ",", " ", "q"}], "}"}], ",", " ", "Infinity"}], "]"}],
         ",", " ", "\"\<Graph\>\""}], "]"}]}]}], " ", "===", "\n", "    ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"EdgeList", " ", "@", " ", 
      RowBox[{"Subgraph", "[", 
       RowBox[{"ray", ",", " ", 
        RowBox[{"VertexOutComponent", "[", 
         RowBox[{"ray", ",", " ", "q"}], "]"}]}], "]"}]}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"867d493d-66b8-446b-84f1-5513c99250dc"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"a13c96d7-aff4-4749-8d9c-10b840aed99b"]
}, Open  ]],

Cell["\<\
On the 6-cycle the members at scale 2 through an edge are the five \
Hamiltonian paths that hold it, so every vertex lies on all five:\
\>", "ExampleText",ExpressionUUID->"3a1bf76d-4e98-4cf6-8a69-d52ecea48916"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraMeasurement", "[", 
  RowBox[{
   RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
   RowBox[{"InfraGeodesic", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "2"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Cardinality\>\"", ",", " ", "\"\<Length\>\"", ",", 
     " ", "\"\<VertexDensity\>\""}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"f1165f2c-69a6-4708-bcca-f9ede6b42d09"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Cardinality\"\>", "\[Rule]", "5"}], ",", 
   RowBox[{"\<\"Length\"\>", "\[Rule]", "5"}], ",", 
   RowBox[{"\<\"VertexDensity\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "5"}], ",", 
      RowBox[{"2", "\[Rule]", "5"}], ",", 
      RowBox[{"3", "\[Rule]", "5"}], ",", 
      RowBox[{"4", "\[Rule]", "5"}], ",", 
      RowBox[{"5", "\[Rule]", "5"}], ",", 
      RowBox[{"6", "\[Rule]", "5"}]}], "\[RightAssociation]"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"037e5a69-d918-48ba-b5b7-442c77cf3373"]
}, Open  ]]
