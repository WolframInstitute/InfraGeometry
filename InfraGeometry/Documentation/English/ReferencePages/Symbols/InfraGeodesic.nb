Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
          " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"germ", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"AdjacencyList", "[", 
            RowBox[{"g", ",", " ", "c"}], "]"}]}]}], "}"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"member", " ", "=", " ", 
        RowBox[{"RandomInfraGeodesic", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraGeodesic", "[", 
           RowBox[{"germ", ",", " ", "s"}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraWalk", "[", "member", "]"}], ",", " ", "germ"}], 
         "}"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", "s"}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"s", ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4", ",", " ", "Infinity"}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e2a9919f-3dcd-4d98-bc65-39cb6819451f"],

