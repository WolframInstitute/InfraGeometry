Notebook[{

Cell[CellGroupData[{
Cell["InfraGeodesic", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"82baa147-2af5-448b-9cbb-f1632bca3231"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa299d07-22f6-4af9-a68e-c0622e0966c0"],
 "\[LineSeparator]",
 "is the family of the geodesics at infra-scale ",
 StyleBox["s", "TI"],
 " through the vertex list ",
 StyleBox["germ", "TI"],
 " that are simple and cannot be extended.",
 "\n"
}], "Usage",ExpressionUUID->"e41a81b3-821b-4d1f-802c-a426bdcf50aa"],

Cell[TextData[{
 "A walk is a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " when every ",
 StyleBox["s", "TI"],
 " + 1 consecutive vertices form a shortest path, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraGeodesicQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraGeodesicQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1717d6d5-05e5-4338-a249-0202ce90cc12"],
 " tests. A member of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4cb9953-02a0-4322-be6d-f7fe25a917db"],
 " contains ",
 StyleBox["germ", "TI"],
 ", visits no vertex twice, and cannot be prolonged at either end without \
breaking one of the two conditions."
}], "Notes",ExpressionUUID->"00c438e9-0edf-4a15-9fcf-4e61a9514a85"],

Cell[TextData[{
 "The geodesic is the Riemannian geodesic seen by an observer who compares \
only points fewer than ",
 StyleBox["s", "TI"],
 " + 1 steps apart. At scale 1 every walk qualifies; at scale ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ed91136f-c050-4621-ab35-ca4244c0ab29"],
 " a member is a maximal shortest path through ",
 StyleBox["germ", "TI"],
 ". The larger the scale, the straighter the members."
}], "Notes",ExpressionUUID->"4fa9825d-d496-41f5-b077-b3720d23bb50"],

Cell[TextData[{
 "The germ must itself be a geodesic at scale ",
 StyleBox["s", "TI"],
 "."
}], "Notes",ExpressionUUID->"b632f485-e64f-471b-9abf-4a7369d47259"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6cc6c633-bf4c-42b5-8a4b-7df18b956683"],
 " is a symbolic object: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "40326883-96d8-4525-b00e-13aa58117e78"],
 " draws members, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a1075196-dff3-408f-b49d-6902b88cb693"],
 " gives its ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fa945fa-6beb-4bdb-bee6-91888a742bab"],
 ". The other readings of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f58fdb54-5587-4dcc-93fd-be858e9c19a0"],
 " are read off the list of all members: ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81ec18d0-1d50-42b5-92a4-eb842f5df575"],
 " their number, ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c9b70e9c-d235-4584-aed3-b64ce8e9ad5a"],
 " their lengths, ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43d6745c-89c0-4518-9349-d2ad274d1cf8"],
 " and ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c12bacf-3e4c-409c-ad7f-925bb000964d"],
 " the number of members through each vertex and each directed edge. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "acb78a91-df52-4cbf-832d-1a5cd97e4caf"],
 " tests a member."
}], "Notes",ExpressionUUID->"97f00fd6-eb99-4bad-b8db-c6e0b6eb9614"],

Cell[TextData[{
 "The ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4d045b0-b20a-4ac3-b0c5-9c8e9114741d"],
 " is the window graph of the forward extensions of ",
 StyleBox["germ", "TI"],
 ". A vertex is a window, the last ",
 StyleBox["s", "TI"],
 " vertices of a walk or fewer at the start. A window ",
 StyleBox["w\:2081", "TI"],
 ", \[Ellipsis], ",
 StyleBox["w\:2098", "TI"],
 " has an arrow to the window that appends ",
 StyleBox["v", "TI"],
 " when ",
 StyleBox["d(w\:2081, v) = m", "TI"],
 ". The walks of ",
 StyleBox["k", "TI"],
 " edges from the germ's window are the ",
 StyleBox["k", "TI"],
 "-step geodesic extensions of ",
 StyleBox["germ", "TI"],
 ", revisits included. At scale 1 the windows are vertices; at scale 2 they \
are directed edges. At scale ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "151401e1-02f6-4c24-98eb-2a2177dfdd87"],
 " the graph is the part of the graph of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHalfLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHalfLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1f4595e-018c-43f4-a9bf-dd2da7969cb3"],
 " past ",
 StyleBox["q", "TI"],
 ", with ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " the ends of the germ."
}], "Notes",ExpressionUUID->"38712005-83de-4944-9a00-4bae81bcba0c"]
}, Open  ]],

