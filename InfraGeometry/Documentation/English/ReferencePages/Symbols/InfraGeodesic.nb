Cell["\<\
The endpoints of the six-step extensions of a three-edge germ ending at the \
centre, sized by how many extensions end there, at scales 2, 4 and 8. At \
scale 2 they spread over a wide arc; from scale 4 on they gather.\
\>", "ExampleText",ExpressionUUID->"084198a2-5f2c-4230-bf7f-069475c403ad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
          " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"o", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"germ", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"FindInfraRepresentative", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSegment", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
               RowBox[{"FindInfraPoint", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{"InfraShell", "[", 
                  RowBox[{"o", ",", " ", "3"}], "]"}]}], "]"}]}], ")"}], ",", 
             " ", "o"}], "]"}], ",", " ", "1"}], "]"}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"windows", " ", "=", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraGeodesic", "[", 
           RowBox[{"germ", ",", " ", "scale"}], "]"}], ",", 
          " ", "\"\<Graph\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"from", " ", "=", " ", 
        RowBox[{"UnitVector", "[", 
         RowBox[{
          RowBox[{"VertexCount", "[", "windows", "]"}], ",", " ", 
          RowBox[{"VertexIndex", "[", 
           RowBox[{"windows", ",", " ", 
            RowBox[{"Take", "[", 
             RowBox[{"germ", ",", " ", 
              RowBox[{"-", 
               RowBox[{"Min", "[", 
                RowBox[{"scale", ",", " ", 
                 RowBox[{"Length", "[", "germ", "]"}]}], "]"}]}]}], "]"}]}], 
           "]"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"ends", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Merge", "[", 
           RowBox[{
            RowBox[{"Thread", "[", 
             RowBox[{
              RowBox[{"Last", " ", "/@", " ", 
               RowBox[{"VertexList", "[", "windows", "]"}]}], " ", "->", " ", 
              
              RowBox[{"from", " ", ".", " ", 
               RowBox[{"MatrixPower", "[", 
                RowBox[{
                 RowBox[{"AdjacencyMatrix", "[", "windows", "]"}], ",", " ", 
                 "6"}], "]"}]}]}], "]"}], ",", " ", "Total"}], "]"}], ",", 
          " ", "Positive"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"ends", ",", " ", 
          RowBox[{"InfraWalk", "[", "germ", "]"}]}], "}"}]}], "]"}]}], "]"}], 
    ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"scale", ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4", ",", " ", "8"}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f798146d-45e8-41f4-803c-f01cee73325b"],

