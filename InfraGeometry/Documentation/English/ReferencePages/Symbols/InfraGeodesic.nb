Notebook[{

Cell[CellGroupData[{
Cell["InfraGeodesic", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"571b9d66-35df-4cff-bf92-2d0f73d8a9ba"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee8907fc-b812-4892-aca3-56169aea5c2b"],
 "\[LineSeparator]",
 "is the geodesics at infra-scale ",
 StyleBox["s", "TI"],
 " through ",
 StyleBox["germ", "TI"],
 ", a vertex list: the walks extending ",
 StyleBox["germ", "TI"],
 " in which every ",
 StyleBox["s", "TI"],
 " consecutive vertices together with the next one form a shortest path. It \
is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5808ac26-aa1b-4af3-9d35-1602e929e91a"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9cf443c9-590e-4345-9ac8-9c96b0beadd4"],
 " evaluate it on a graph.",
 "\n"
}], "Usage",ExpressionUUID->"696f56a5-68ce-47f2-8bac-bd1befe6ec9c"],

Cell[TextData[{
 "Its graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraGeodesic", "[", 
     RowBox[{
      StyleBox["germ", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "]"}], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "412b39bf-8acf-4267-b4fd-1b12c0e82098"],
 " \[LongDash] is the window graph of the forward extensions. A vertex is a \
window, the last at most ",
 StyleBox["s", "TI"],
 " vertices of a walk, as a list. A window ",
 StyleBox["w", "TI"],
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "b8e49fa7-b9a2-4598-b4d7-5d2c61fb377a"],
 ", \[Ellipsis], ",
 StyleBox["w", "TI"],
 Cell[BoxData[
  SubscriptBox["", "m"]], "InlineFormula",ExpressionUUID->
  "8a0e676b-002b-49d5-b691-11a9bb0067c3"],
 " has an arrow to the window that appends ",
 StyleBox["v", "TI"],
 " whenever ",
 StyleBox["d(w", "TI"],
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula", "TI",ExpressionUUID->
  "9354073b-ea77-47cc-8a6b-3e9c10b231fc"],
 StyleBox[", v) = m", "TI"],
 ". The admissible step depends on the window alone, so the walks of ",
 StyleBox["k", "TI"],
 " edges from the germ's window are exactly the ",
 StyleBox["k", "TI"],
 "-step forward extensions of ",
 StyleBox["germ", "TI"],
 ": the germ followed by the last vertex of each window, revisits included."
}], "Notes",ExpressionUUID->"9bb3a98a-1b6a-4146-b57c-0fbeae7460f1"],

Cell[TextData[{
 "The graph carries no length budget. It is finite, and its cycles are the \
closed geodesics at scale ",
 StyleBox["s", "TI"],
 "; at scale 1 it is the graph with both orientations of every edge. The \
extensions of ",
 StyleBox["k", "TI"],
 " steps are read off the powers of its adjacency matrix rather than listed."
}], "Notes",ExpressionUUID->"dfcd7f71-07f4-476a-a3b4-ad23ba4ec7b7"],

Cell[TextData[{
 "At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6848ffed-ca26-4ced-851e-7b061bf4e3f7"],
 " the walk is a shortest path from the germ's first vertex ",
 StyleBox["p", "TI"],
 ", so the window collapses to its last vertex. The graph is then the part of \
the ray DAG of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb245b7a-029d-44b0-85ce-b3134c0ff5cf"],
 " reachable from the germ's last vertex ",
 StyleBox["q", "TI"],
 "; for a one-vertex germ it is the pencil at ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"c180dc14-0cab-4ecc-b8cd-e19573b89f63"],

Cell[TextData[{
 "The germ must itself be a geodesic at scale ",
 StyleBox["s", "TI"],
 "; otherwise the call stays unevaluated."
}], "Notes",ExpressionUUID->"c0c11f70-9645-47c4-8b38-c7e197126c41"],

Cell[TextData[{
 "A member read by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "13b479bb-cc2b-4a34-a6b2-e34258504428"],
 " is an inextensible simple geodesic through the germ, grown on both sides."
}], "Notes",ExpressionUUID->"e31c5db1-e3a3-465e-95d0-e170a4478f8d"]
}, Open  ]],

