Cell[TextData[{
 "At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbc146d3-faf5-4fe8-8a25-14b73d8ae387"],
 " the graph is the part of the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRay"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraRay", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "da1bf185-ec74-4777-a851-e0c06268bae1"],
 " graph past the germ."
}], "ExampleText",ExpressionUUID->"a07de782-e625-4709-ad0c-e592144b1ed5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"o", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"through", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"o", ",", " ", "2"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"germ", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FindInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraSegment", "[", 
         RowBox[{"o", ",", " ", "through"}], "]"}], ",", " ", "1"}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ray", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRay", "[", 
        RowBox[{"o", ",", " ", "through"}], "]"}], ",", 
       " ", "\"\<Graph\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"EdgeList", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraGeodesic", "[", 
         RowBox[{"germ", ",", " ", "Infinity"}], "]"}], ",", 
        " ", "\"\<Graph\>\""}], "]"}]}]}], " ", "===", "\n", "    ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"EdgeList", " ", "@", " ", 
      RowBox[{"Subgraph", "[", 
       RowBox[{"ray", ",", " ", 
        RowBox[{"VertexOutComponent", "[", 
         RowBox[{"ray", ",", " ", "through"}], "]"}]}], "]"}]}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c988ab5a-5e7d-4a5e-b530-a7352342582d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"2a5c53b5-2566-419b-834e-364399cfede5"]
}, Open  ]]
