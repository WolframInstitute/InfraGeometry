Cell["\<\
The number of windows at scales 1, 2 and 3 on the grid: the vertices, the \
directed edges reached, and the windows of three vertices reached:\
\>", "ExampleText",ExpressionUUID->"aae58bb9-ab22-4508-8ea4-01651cec2afd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"germ", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"c", ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", "c"}], "]"}]}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"VertexCount", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraGeodesic", "[", 
         RowBox[{"germ", ",", " ", "s"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
       "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2c3981b4-a811-4252-87a2-9b3ec5537874"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"96", ",", "256", ",", "657"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"5df4c988-9a94-4bc9-b25e-6a0e0293b151"]
}, Open  ]],

Cell[TextData[{
 "The ",
 StyleBox["k", "TI"],
 "-step extensions are the walks of ",
 StyleBox["k", "TI"],
 " edges from the germ's window: the powers of the adjacency matrix count \
what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2f0294a8-253f-4c17-8c0f-9bdde8637463"],
 " lists. At scale 2 with ",
 StyleBox["k", "TI"],
 " = 5:"
}], "ExampleText",ExpressionUUID->"20a45bd7-dff0-49f0-acdb-c9ae81d77307"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"germ", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"c", ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", "c"}], "]"}]}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"windows", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraGeodesic", "[", 
        RowBox[{"germ", ",", " ", "2"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"start", " ", "=", " ", 
     RowBox[{"UnitVector", "[", 
      RowBox[{
       RowBox[{"VertexCount", "[", "windows", "]"}], ",", " ", 
       RowBox[{"VertexIndex", "[", 
        RowBox[{"windows", ",", " ", "germ"}], "]"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{"start", " ", ".", " ", 
       RowBox[{"MatrixPower", "[", 
        RowBox[{
         RowBox[{"AdjacencyMatrix", "[", "windows", "]"}], ",", " ", "5"}], 
        "]"}]}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"RandomInfraGeodesic", "[", 
       RowBox[{"g", ",", " ", "germ", ",", " ", "2", ",", " ", 
        RowBox[{"{", "5", "}"}], ",", " ", "All"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2bd4c3f2-f359-4465-b6d5-51791a9e66ca"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"213", ",", "213"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"bc287916-4198-4ea4-8cb6-37c4096df0ed"]
}, Open  ]],

Cell[TextData[{
 "At scale ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
