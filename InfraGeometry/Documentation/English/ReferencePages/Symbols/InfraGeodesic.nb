Notebook[{

Cell[CellGroupData[{
Cell["InfraGeodesic", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"89f63850-4035-4960-acf3-b7052d8f2574"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47067252-733f-405d-b5d8-58ef629f114d"],
 "\[LineSeparator]",
 "is the geodesics at infra-scale ",
 StyleBox["s", "TI"],
 " through ",
 StyleBox["germ", "TI"],
 ", a vertex list: the walks extending ",
 StyleBox["germ", "TI"],
 " in which every ",
 StyleBox["s", "TI"],
 " consecutive vertices together with the next one form a shortest path. It \
is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "94977a13-8c12-4c78-840a-e29097d07d60"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8993e686-f858-42e8-b9d5-497f536eab9b"],
 " evaluate it on a graph.",
 "\n"
}], "Usage",ExpressionUUID->"d23a441b-497c-41c2-898f-a507d3731352"],

Cell[TextData[{
 "Its graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraGeodesic", "[", 
     RowBox[{
      StyleBox["germ", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "]"}], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16ead62c-bb2e-4370-bfb5-09b52726b325"],
 " \[LongDash] is the window graph of the forward extensions. A vertex is a \
window, the last at most ",
 StyleBox["s", "TI"],
 " vertices of a walk, as a list. A window ",
 StyleBox["w", "TI"],
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula",ExpressionUUID->
  "3c809345-fe65-425f-96f7-448dc328bdfc"],
 ", \[Ellipsis], ",
 StyleBox["w", "TI"],
 Cell[BoxData[
  SubscriptBox["", "m"]], "InlineFormula",ExpressionUUID->
  "f5076b79-97bb-40b8-89ef-10991bab9207"],
 " has an arrow to the window that appends ",
 StyleBox["v", "TI"],
 " whenever ",
 StyleBox["d(w", "TI"],
 Cell[BoxData[
  SubscriptBox["", "1"]], "InlineFormula", "TI",ExpressionUUID->
  "70ae6636-ff13-4057-913a-cba2b916a099"],
 StyleBox[", v) = m", "TI"],
 ". The admissible step depends on the window alone, so the walks of ",
 StyleBox["k", "TI"],
 " edges from the germ's window are exactly the ",
 StyleBox["k", "TI"],
 "-step forward extensions of ",
 StyleBox["germ", "TI"],
 ": the germ followed by the last vertex of each window, revisits included."
}], "Notes",ExpressionUUID->"ca8ce314-24c5-4814-931c-c0db92ab5346"],

Cell[TextData[{
 "The graph carries no length budget. It is finite, and its cycles are the \
closed geodesics at scale ",
 StyleBox["s", "TI"],
 "; at scale 1 it is the graph with both orientations of every edge. The \
extensions of ",
 StyleBox["k", "TI"],
 " steps are read off the powers of its adjacency matrix rather than listed."
}], "Notes",ExpressionUUID->"6c7338e8-a249-4342-9030-2265d9752f6f"],

Cell[TextData[{
 "At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08ac2779-8acc-4ef6-b753-54dea3517beb"],
 " the walk is a shortest path from the germ's first vertex ",
 StyleBox["p", "TI"],
 ", so the window collapses to its last vertex. The graph is then the part of \
the ray DAG of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e5c9dcc-11df-4e66-88d6-6f7983c80dd7"],
 " reachable from the germ's last vertex ",
 StyleBox["q", "TI"],
 "; for a one-vertex germ it is the pencil at ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"a6933226-6af8-4e9c-9eca-d7c666336cec"],

Cell[TextData[{
 "The germ must itself be a geodesic at scale ",
 StyleBox["s", "TI"],
 "; otherwise the call stays unevaluated."
}], "Notes",ExpressionUUID->"3078306f-d82b-49a5-9c6d-e1f74767bf0a"],

Cell[TextData[{
 "A member read by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e2f60f0d-d58c-4031-90a8-df883a92bc58"],
 " is an inextensible simple geodesic through the germ, grown on both sides."
}], "Notes",ExpressionUUID->"592a4a01-0bed-456e-8103-0e396265a3ac"]
}, Open  ]],

