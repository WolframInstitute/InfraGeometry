Cell[TextData[{
 "At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71d4824c-bf0e-4962-8f59-740031f3c482"],
 " the graph is drawn on the substrate beside the ray through the germ's \
ends: the same arrows past the germ."
}], "ExampleText",ExpressionUUID->"a61f6711-32b6-42dc-9e95-32f3f280710e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"o", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"through", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"o", ",", " ", "2"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"germ", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FindInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraSegment", "[", 
         RowBox[{"o", ",", " ", "through"}], "]"}], ",", " ", "1"}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"windows", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraGeodesic", "[", 
        RowBox[{"germ", ",", " ", "Infinity"}], "]"}], ",", 
       " ", "\"\<Graph\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"windows", ",", " ", 
          RowBox[{"InfraWalk", "[", "germ", "]"}]}], "}"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraRay", "[", 
           RowBox[{"o", ",", " ", "through"}], "]"}], ",", " ", 
          RowBox[{"InfraWalk", "[", "germ", "]"}]}], "}"}]}], "]"}]}], "}"}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"fcf9b906-cf05-48a6-8227-840d62bd1c22"],

