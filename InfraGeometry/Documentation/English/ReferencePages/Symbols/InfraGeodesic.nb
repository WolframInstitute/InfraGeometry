Cell[TextData[{
 "The walks of ",
 StyleBox["k", "TI"],
 " edges from the germ's window are the forward extensions ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3d6a143c-60e9-46b4-a715-7540b0a50510"],
 " lists with ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1477544f-9245-4d2f-bd26-9cf52e2d3692"],
 ". The number of windows, whether the graph has cycles, the number of \
six-step extensions read off the adjacency matrix, and the number listed."
}], "ExampleText",ExpressionUUID->"0ea375bb-0d31-4b22-b8a4-afe4ccaf28bc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"o", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"germ", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FindInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraSegment", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
            RowBox[{"FindInfraPoint", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraShell", "[", 
               RowBox[{"o", ",", " ", "3"}], "]"}]}], "]"}]}], ")"}], ",", 
          " ", "o"}], "]"}], ",", " ", "1"}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"windows", " ", "=", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraGeodesic", "[", 
            RowBox[{"germ", ",", " ", "scale"}], "]"}], ",", 
           " ", "\"\<Graph\>\""}], "]"}]}], "}"}], ",", "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"from", " ", "=", " ", 
         RowBox[{"UnitVector", "[", 
          RowBox[{
           RowBox[{"VertexCount", "[", "windows", "]"}], ",", " ", 
           RowBox[{"VertexIndex", "[", 
            RowBox[{"windows", ",", " ", 
             RowBox[{"Take", "[", 
              RowBox[{"germ", ",", " ", 
               RowBox[{"-", 
                RowBox[{"Min", "[", 
                 RowBox[{"scale", ",", " ", 
                  RowBox[{"Length", "[", "germ", "]"}]}], "]"}]}]}], "]"}]}], 
            "]"}]}], "]"}]}], "}"}], ",", "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"scale", ",", " ", 
         RowBox[{"VertexCount", "[", "windows", "]"}], ",", " ", 
         RowBox[{"AcyclicGraphQ", "[", "windows", "]"}], ",", " ", 
         RowBox[{"Total", "[", 
          RowBox[{"from", " ", ".", " ", 
           RowBox[{"MatrixPower", "[", 
            RowBox[{
             RowBox[{"AdjacencyMatrix", "[", "windows", "]"}], ",", " ", 
             "6"}], "]"}]}], "]"}], ",", "\n", "       ", 
         RowBox[{"Length", " ", "@", " ", 
          RowBox[{"FindInfraGeodesic", "[", 
           RowBox[{"g", ",", " ", "germ", ",", " ", "scale", ",", " ", 
            RowBox[{"{", "6", "}"}], ",", " ", "All", ",", " ", 
            RowBox[{"Properties", " ", "->", " ", 
             RowBox[{"{", "}"}]}], ",", " ", 
            
            RowBox[{"\"\<Direction\>\"", " ", "->", 
             " ", "\"\<Forward\>\""}]}], "]"}]}]}], "}"}]}], "]"}], ",", "\n",
      "    ", 
     RowBox[{"{", 
      RowBox[{"scale", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "4", ",", " ", "8"}], "}"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8d0352d3-f6c1-4baa-b7e0-ebc998a04054"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
