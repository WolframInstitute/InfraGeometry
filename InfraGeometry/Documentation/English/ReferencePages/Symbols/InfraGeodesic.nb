Cell[TextData[{
 "The walks of ",
 StyleBox["k", "TI"],
 " edges from the germ's window are the extensions ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dee427aa-d0a0-47f6-b038-af31b33bbce9"],
 " lists. The number of windows, whether the graph has cycles, the number of \
six-step extensions read off the adjacency matrix, and the number listed."
}], "ExampleText",ExpressionUUID->"a868e070-8e8d-4792-b4ab-65ed29f5be8f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"o", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"germ", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FindInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraSegment", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
            RowBox[{"FindInfraPoint", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraShell", "[", 
               RowBox[{"o", ",", " ", "3"}], "]"}]}], "]"}]}], ")"}], ",", 
          " ", "o"}], "]"}], ",", " ", "1"}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"windows", " ", "=", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraGeodesic", "[", 
            RowBox[{"germ", ",", " ", "scale"}], "]"}], ",", 
           " ", "\"\<Graph\>\""}], "]"}]}], "}"}], ",", "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"from", " ", "=", " ", 
         RowBox[{"UnitVector", "[", 
          RowBox[{
           RowBox[{"VertexCount", "[", "windows", "]"}], ",", " ", 
           RowBox[{"VertexIndex", "[", 
            RowBox[{"windows", ",", " ", 
             RowBox[{"Take", "[", 
              RowBox[{"germ", ",", " ", 
               RowBox[{"-", 
                RowBox[{"Min", "[", 
                 RowBox[{"scale", ",", " ", 
                  RowBox[{"Length", "[", "germ", "]"}]}], "]"}]}]}], "]"}]}], 
            "]"}]}], "]"}]}], "}"}], ",", "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"scale", ",", " ", 
         RowBox[{"VertexCount", "[", "windows", "]"}], ",", " ", 
         RowBox[{"AcyclicGraphQ", "[", "windows", "]"}], ",", " ", 
         RowBox[{"Total", "[", 
          RowBox[{"from", " ", ".", " ", 
           RowBox[{"MatrixPower", "[", 
            RowBox[{
             RowBox[{"AdjacencyMatrix", "[", "windows", "]"}], ",", " ", 
             "6"}], "]"}]}], "]"}], ",", "\n", "       ", 
         RowBox[{"Length", " ", "@", " ", 
          RowBox[{"FindInfraGeodesic", "[", 
           RowBox[{"g", ",", " ", "germ", ",", " ", "scale", ",", " ", 
            RowBox[{"{", "6", "}"}], ",", " ", "All"}], "]"}]}]}], "}"}]}], 
      "]"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"scale", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "4", ",", " ", "8"}], "}"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9d09344f-e8e6-416e-b905-ed050fea96a2"],

