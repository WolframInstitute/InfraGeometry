Cell[TextData[{
 "The readings other than ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "edc8c236-d5c5-4cf0-9d91-96d4c9891677"],
 " list every member. At small scales the members are nearly all simple walks \
through the germ, and their number grows exponentially with the size of the \
graph; at scale 1 on the Small grid the list takes more than a minute."
}], "ExampleText",ExpressionUUID->"2ba8d6e9-907b-4861-8f1d-3e7c1a8a6aac"],

Cell["\<\
A germ that is not a geodesic at the scale has no members, and its graph \
stays unevaluated. Stepping back fails at scale 2:\
\>", "ExampleText",ExpressionUUID->"edbb4a2f-855b-43c6-8c5d-128c9a845cc9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"RandomInfraGeodesic", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraGeodesic", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"45", ",", " ", "46", ",", " ", "45"}], "}"}], ",", " ", 
         "2"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraGeodesic", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"45", ",", " ", "46", ",", " ", "45"}], "}"}], ",", " ", 
          "2"}], "]"}], ",", " ", "\"\<Graph\>\""}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1d510a4d-5c54-4c25-afa5-6900f81450f6"],

Cell[BoxData[
