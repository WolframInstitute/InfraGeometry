Cell[TextData[{
 "Three walks from the centre of the square tiling and the scales, among 1 to \
4 and ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "005c888b-321e-4a4e-91bb-832f2e670c05"],
 ", at which each is a geodesic. Round a square, the walk is locally shortest \
at scale 2 only; round three sides of a larger square, up to scale 3; a \
staircase is shortest at every scale."
}], "ExampleText",ExpressionUUID->"e3dfe54e-8178-4dc5-9359-093dbec6510a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "1", ",", " ", "6", ",", " ", "5", ",", " ", "2", ",", " ", "1", ",", 
         " ", "6"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "1", ",", " ", "6", ",", " ", "14", ",", " ", "29", ",", " ", "47", ",",
          " ", "30", ",", " ", "23", ",", " ", "11"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "1", ",", " ", "6", ",", " ", "5", ",", " ", "15", ",", " ", "25", ",",
          " ", "41"}], "}"}]}], "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Row", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"InfraWalk", "[", "walk", "]"}], ",", " ", 
            RowBox[{"First", " ", "@", " ", "walk"}]}], "}"}]}], "]"}], ",", 
        "\n", "      ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", 
            "Infinity"}], "}"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraGeodesicQ", "[", 
            RowBox[{"g", ",", " ", "walk", ",", " ", "#"}], "]"}], " ", 
           "&"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"walk", ",", " ", "walks"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"366d3744-e7f8-4735-a739-91b2157370f4"],

