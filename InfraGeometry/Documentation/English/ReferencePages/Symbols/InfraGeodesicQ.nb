Cell["\<\
A geodesic interval graph passes as a whole, since all its paths from the \
source to the sink are shortest.\
\>", "ExampleText",ExpressionUUID->"7761b422-b4da-45c5-83dd-fb1daba29e7e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"a", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"dag", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"dag", ",", " ", "a", ",", " ", "b"}], "}"}]}], "]"}], ",", 
     " ", 
     RowBox[{"InfraGeodesicQ", "[", 
      RowBox[{"g", ",", " ", "dag"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"fc4606d7-ee85-47cc-894b-0d020549ca71"],

