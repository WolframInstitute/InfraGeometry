Cell[TextData[{
 "At scale 1 the test is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraWalkQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraWalkQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b2d399aa-0a9e-45ab-9e98-dfdda1abbc9e"],
 " and at scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "adb948a2-1406-4332-96c8-d9d8a4b7bcbe"],
 " it is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegmentQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9fca8dc7-242b-43ed-aa21-c932fc3176d4"],
 ", on every walk of 4 edges from the centre; those passing at scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4151a815-f760-455c-a479-5e4f07dff4dd"],
 " are drawn."
}], "ExampleText",ExpressionUUID->"8215439f-a491-4c88-9600-3f08fadb1dff"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walkGraphs", " ", "=", " ", 
     RowBox[{"RandomInfraGeodesic", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "1", ",", " ", 
       RowBox[{"{", "4", "}"}], ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"walkSeqs", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Last", " ", "/@", " ", 
        RowBox[{"VertexList", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ", 
      "walkGraphs"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"walkGraphs", ",", " ", 
           RowBox[{
            RowBox[{"InfraGeodesicQ", "[", 
             RowBox[{"g", ",", " ", "#", ",", " ", "Infinity"}], "]"}], " ", 
            "&"}]}], "]"}], ",", " ", "a"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"walkSeqs", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraGeodesicQ", "[", 
          RowBox[{"g", ",", " ", "#", ",", " ", "1"}], "]"}], " ", "===", " ", 
         RowBox[{"InfraWalkQ", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"walkSeqs", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraGeodesicQ", "[", 
          RowBox[{"g", ",", " ", "#", ",", " ", "Infinity"}], "]"}], " ", "===",
          " ", 
         RowBox[{"InfraSegmentQ", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}]}], 
    "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"57be0985-eedb-4e9d-b8ff-56f74ec86b96"],

