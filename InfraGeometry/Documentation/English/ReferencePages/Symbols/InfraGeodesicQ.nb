 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2004d711-79d5-4917-8e6a-5a7093687f3d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
