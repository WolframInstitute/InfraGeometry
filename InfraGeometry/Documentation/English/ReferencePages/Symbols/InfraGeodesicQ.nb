Cell[TextData[{
 "Three walks from the centre of a grid and the scales, among 1 to 4 and ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8cb32c8a-c905-4bd1-b654-2a79985e90fc"],
 ", at which each is a geodesic. Round a square, the walk is locally shortest \
at scale 2 only; round a larger loop, up to scale 3; a staircase is shortest \
at every scale."
}], "ExampleText",ExpressionUUID->"dbe76d9c-dd23-4a10-948b-d5b903ddc795"],

