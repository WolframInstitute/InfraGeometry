Cell[TextData[{
 "At scale 1 the test is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraWalkQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraWalkQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "848fd379-e4de-434b-9f5d-21003529c894"],
 " and at scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2df1aaf-54df-4b53-b4db-c49e150f6d86"],
 " it is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegmentQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e5023e52-be15-4522-bb9e-c13fc15e4d6f"],
 ", on every walk of 4 edges from the centre."
}], "ExampleText",ExpressionUUID->"740d770f-3d3d-4347-bf9e-0bfacea2525a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walkSeqs", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Last", " ", "/@", " ", 
        RowBox[{"VertexList", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"FindInfraGeodesic", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", "1", ",", " ", 
        RowBox[{"{", "4", "}"}], ",", " ", "All"}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"AllTrue", "[", 
      RowBox[{"walkSeqs", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraGeodesicQ", "[", 
          RowBox[{"g", ",", " ", "#", ",", " ", "1"}], "]"}], " ", "===", " ", 
         RowBox[{"InfraWalkQ", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"walkSeqs", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraGeodesicQ", "[", 
          RowBox[{"g", ",", " ", "#", ",", " ", "Infinity"}], "]"}], " ", "===",
          " ", 
         RowBox[{"InfraSegmentQ", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e31c93a0-ec73-4bd3-bdb7-5ac89bf28929"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"884c2b61-173a-42f1-b44d-a7a5a035f207"]
}, Open  ]],

