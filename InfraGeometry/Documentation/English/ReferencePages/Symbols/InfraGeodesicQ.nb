 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"646ab209-093a-41c5-b619-bc12646b55b2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
