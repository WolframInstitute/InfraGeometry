Cell[TextData[{
 "At scale 1 the test is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraWalkQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraWalkQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "43e6631e-615f-430f-ad40-901992b47ff4"],
 " and at scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc8eec09-0ce0-47b8-b2fb-09672982537c"],
 " it is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegmentQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e11aa4c8-774e-4c14-9b82-dd753c241910"],
 ", on every walk of 4 edges from the centre; those passing at scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "179433b9-b081-496e-99ef-a10997f1a644"],
 " are drawn."
}], "ExampleText",ExpressionUUID->"d4a75b9f-95db-4eb6-8be5-60f2da11b7bd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walkGraphs", " ", "=", " ", 
     RowBox[{"FindInfraGeodesic", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "1", ",", " ", 
       RowBox[{"{", "4", "}"}], ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"walkSeqs", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Last", " ", "/@", " ", 
        RowBox[{"VertexList", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ", 
      "walkGraphs"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"walkGraphs", ",", " ", 
           RowBox[{
            RowBox[{"InfraGeodesicQ", "[", 
             RowBox[{"g", ",", " ", "#", ",", " ", "Infinity"}], "]"}], " ", 
            "&"}]}], "]"}], ",", " ", "a"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"walkSeqs", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraGeodesicQ", "[", 
          RowBox[{"g", ",", " ", "#", ",", " ", "1"}], "]"}], " ", "===", " ", 
         RowBox[{"InfraWalkQ", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"walkSeqs", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraGeodesicQ", "[", 
          RowBox[{"g", ",", " ", "#", ",", " ", "Infinity"}], "]"}], " ", "===",
          " ", 
         RowBox[{"InfraSegmentQ", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"416f1e83-59ef-4c62-9c2e-770942ff8298"],

