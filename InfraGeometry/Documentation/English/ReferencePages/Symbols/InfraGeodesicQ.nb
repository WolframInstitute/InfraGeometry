Cell[TextData[{
 "Definition: a walk ",
 StyleBox["v0", "TI"],
 ", \[Ellipsis], ",
 StyleBox["vk", "TI"],
 " is a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " when every window of ",
 StyleBox["s", "TI"],
 " consecutive vertices together with the next one is a shortest path: ",
 StyleBox["d(v(i\[Minus]s), vi) = s", "TI"],
 " for ",
 StyleBox["i \[GreaterEqual] s", "TI"],
 ", and ",
 StyleBox["d(v0, vi) = i", "TI"],
 " for ",
 StyleBox["i < s", "TI"],
 "."
}], "Notes",ExpressionUUID->"3da3374d-7f16-415d-b158-6f753a3912e7"],

Cell[TextData[{
 "The condition gets stronger as ",
 StyleBox["s", "TI"],
 " grows, so a walk that passes at ",
 StyleBox["s", "TI"],
 " passes at every smaller scale. The ladder is exact at both ends: at scale ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0efe185-27d7-4fd7-a300-e3fe19e66b04"],
 " the test is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraWalkQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraWalkQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d6b1abb1-e11b-4dfe-b951-a4d0161828a8"],
 ", at scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11a91b54-d195-4d3f-afd2-060d96f3f918"],
 " it is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegmentQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8736c425-73df-470d-ae63-fc3a7e7c555f"],
 "."
}], "Notes",ExpressionUUID->"6f028034-60a3-4700-9a51-d51e17d32ed9"],

Cell[TextData[{
 StyleBox["walk", "TI"],
 " may be a vertex list, a walk graph such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f34da269-a99c-4b54-a9d9-c0db941a513d"],
 " returns, a list of walk graphs, or a directed acyclic graph. A DAG passes \
when every path from a source to a sink passes, so the interval and spray \
graphs can be tested without listing their paths one by one. A walk of fewer \
than two vertices is not a geodesic."
}], "Notes",ExpressionUUID->"72af7627-816a-419b-a1ea-45925fda17a2"]
}, Open  ]],

