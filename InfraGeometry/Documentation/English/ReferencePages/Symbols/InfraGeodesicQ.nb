  FontSize->0.9 Inherited,ExpressionUUID->
  "b46e0637-6421-40b5-912f-f1faf59e145d"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48dcf397-bedd-40f3-8cda-722f4e4ad0f3"],
 " if ",
 StyleBox["walk", "TI"],
 " is a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ", and ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "959c624e-8aaa-4ba3-936f-74bdd7cc9cd8"],
 " otherwise.",
