  "2c00f415-72a7-47af-befc-73c89202fd78"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44f7c055-4077-4928-81bb-6f669f58cc2f"],
 " if ",
 StyleBox["walk", "TI"],
