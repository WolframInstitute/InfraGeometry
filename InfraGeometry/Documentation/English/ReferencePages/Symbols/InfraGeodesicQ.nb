Cell[TextData[{
 "At scale 1 the test is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraWalkQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraWalkQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8949f9ad-4329-4d18-a0e0-485b57edfb7e"],
 " and at scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8174b9f2-2af8-42ab-93d0-e9dfcd2d33cb"],
 " it is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegmentQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "403ba3a3-0a23-484a-aae9-c3ebfaf434cb"],
 ", on every walk of 4 edges from the centre."
}], "ExampleText",ExpressionUUID->"65d408d3-f17a-4b9a-a942-abb0ee9c06ea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walkSeqs", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Last", " ", "/@", " ", 
        RowBox[{"VertexList", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"FindInfraGeodesic", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", "1", ",", " ", 
        RowBox[{"{", "4", "}"}], ",", " ", "All"}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"AllTrue", "[", 
      RowBox[{"walkSeqs", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraGeodesicQ", "[", 
          RowBox[{"g", ",", " ", "#", ",", " ", "1"}], "]"}], " ", "===", " ", 
         RowBox[{"InfraWalkQ", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"walkSeqs", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraGeodesicQ", "[", 
          RowBox[{"g", ",", " ", "#", ",", " ", "Infinity"}], "]"}], " ", "===",
          " ", 
         RowBox[{"InfraSegmentQ", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7ec31d6b-4d2c-4563-a8af-3d4abf477eb1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"aa5fa91a-c001-4bc4-8f8e-cae85089a2fd"]
}, Open  ]],

Cell["\<\
A geodesic interval graph passes as a whole, since all its paths from the \
source to the sink are shortest.\
\>", "ExampleText",ExpressionUUID->"81d335cb-c867-4504-a3ad-76c2371d601e"],

