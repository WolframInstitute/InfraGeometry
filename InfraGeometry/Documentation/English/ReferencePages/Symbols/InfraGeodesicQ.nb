Cell[TextData[{
 "Three walks from the centre of the square tiling and the scales, among 1 to \
4 and ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d26f5e57-7fa1-45ff-bfad-c2160fbed6e7"],
 ", at which each is a geodesic. Round a square, the walk is locally shortest \
at scale 2 only; round three sides of a larger square, up to scale 3; a \
staircase is shortest at every scale."
}], "ExampleText",ExpressionUUID->"5d794396-34af-4d0e-bbdc-df73bdc9bcdc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "1", ",", " ", "6", ",", " ", "5", ",", " ", "2", ",", " ", "1", ",", 
         " ", "6"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "1", ",", " ", "6", ",", " ", "14", ",", " ", "29", ",", " ", "47", ",",
          " ", "30", ",", " ", "23", ",", " ", "11"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "1", ",", " ", "6", ",", " ", "5", ",", " ", "15", ",", " ", "25", ",",
          " ", "41"}], "}"}]}], "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Row", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"InfraWalk", "[", "walk", "]"}], ",", " ", 
            RowBox[{"First", " ", "@", " ", "walk"}]}], "}"}]}], "]"}], ",", 
        "\n", "      ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", 
            "Infinity"}], "}"}], ",", " ", 
          RowBox[{
           RowBox[{"InfraGeodesicQ", "[", 
            RowBox[{"g", ",", " ", "walk", ",", " ", "#"}], "]"}], " ", 
           "&"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"walk", ",", " ", "walks"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"42ab92f7-a39f-40ff-9a0e-3912ff6146c3"],

