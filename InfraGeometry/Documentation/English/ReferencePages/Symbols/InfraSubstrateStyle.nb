Cell["\<\
The vertex size is a fraction of the diagonal of the drawing, so a vertex \
stays one small dot however many vertices there are.\
\>", "Notes",ExpressionUUID->"2dc19723-a190-430f-9c6a-4d7b942e1761"],

Cell[TextData[{
 "Every named substrate takes the style of its size. A substrate at a raw \
size takes the style of its vertex count: up to 250 ",
 Cell[BoxData["\"\<Small\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c588264-90fd-413b-8356-4f30b7b365a3"],
 ", up to 800 ",
 Cell[BoxData["\"\<Medium\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64bb0d73-6d00-4aad-ab8e-7cc65a5d7583"],
 ", more ",
 Cell[BoxData["\"\<Large\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "156b0fba-871b-46fd-8a3c-d7cc5f421502"],
 "."
}], "Notes",ExpressionUUID->"a40668fa-664a-4b2e-a8bd-25aa1953d861"],

Cell[TextData[{
 "A custom look for one substrate is one more definition ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"InfraSubstrateStyle", "[", 
    RowBox[{
     StyleBox["name", "TI"], ",", " ", 
     StyleBox["size", "TI"]}], "]"}], " ", "=", " ", "\[Ellipsis]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b43fc212-c1da-445a-bf49-e85d918060fc"],
 ", listed under ",
 Cell[BoxData["\"\<Custom\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34afbb78-5326-4a27-8eac-7b9b6e156752"],
 ". Any graph is drawn like a substrate by ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Graph",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Sequence",
      BaseStyle->"Link"], " ", "@@", " ", 
     RowBox[{"InfraSubstrateStyle", "[", 
      StyleBox["size", "TI"], "]"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8551e2ad-4522-4b92-954a-d6c8959d67a8"],
 "."
}], "Notes",ExpressionUUID->"99a7fc8b-d4f1-4b35-9db6-a6632022a20b"]
}, Open  ]],

