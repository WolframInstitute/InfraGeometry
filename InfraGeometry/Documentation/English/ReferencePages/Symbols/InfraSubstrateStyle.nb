Cell["\<\
The vertex size is a fraction of the diagonal of the drawing, so a vertex \
stays one small dot however many vertices the substrate has.\
\>", "Notes",ExpressionUUID->"6a8f17e1-e00c-4cc4-9199-df97791255fb"],

Cell[TextData[{
 "Every named substrate takes the style of its size. A custom look for one \
substrate is one more definition ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"InfraSubstrateStyle", "[", 
    RowBox[{
     StyleBox["name", "TI"], ",", " ", 
     StyleBox["size", "TI"]}], "]"}], " ", "=", " ", "\[Ellipsis]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5befb062-c9b8-4658-9793-26511b56412d"],
 ", and the listing then shows it under ",
 Cell[BoxData["\"\<Custom\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7687ca3-9eee-44c0-9cf2-08f9dec1168c"],
 "."
}], "Notes",ExpressionUUID->"ee155b7e-9d28-4c80-98ad-3c5d6f37f8bc"],

Cell[TextData[{
 "To draw a graph of one's own like a substrate, splice the style into it: ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Graph",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Sequence",
      BaseStyle->"Link"], " ", "@@", " ", 
     RowBox[{"InfraSubstrateStyle", "[", 
      StyleBox["size", "TI"], "]"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45289586-dd02-449e-a313-3ea58bd5cc37"],
 "."
}], "Notes",ExpressionUUID->"d8ac4f5f-3c1c-45fe-8098-1bffe6ae3101"]
}, Open  ]],

