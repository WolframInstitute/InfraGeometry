Cell["\<\
A ball of the hyperbolic tiling by squares, five at every vertex, with no \
style and in the three styles.\
\>", "ExampleText",ExpressionUUID->"30be78b3-466f-4137-96b8-ccaccec833a9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"TessellationNeighborhoodGraph", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "5"}], "}"}], ",", " ", "4"}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Graph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"Sequence", " ", "@@", " ", 
         RowBox[{"InfraSubstrateStyle", "[", "style", "]"}]}]}], "]"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"style", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Default\>\"", ",", " ", "\"\<Small\>\"", ",", 
          " ", "\"\<Medium\>\"", ",", " ", "\"\<Large\>\""}], "}"}]}], 
       "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"abf77da4-3261-4518-912f-c31b17afdd0b"],

