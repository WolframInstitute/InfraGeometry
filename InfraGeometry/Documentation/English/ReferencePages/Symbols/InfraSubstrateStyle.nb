Cell["\<\
The vertex size is a fraction of the diagonal of the drawing, so a vertex \
stays one small dot however many vertices there are.\
\>", "Notes",ExpressionUUID->"c931bddd-8b72-43c5-817a-3c3436d6b81c"],

Cell[TextData[{
 "Every named substrate takes the style of its size. A substrate at a raw \
size takes the style of its vertex count: up to 250 ",
 Cell[BoxData["\"\<Small\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66530d9f-75ef-45fa-8eed-bea7bb1c6050"],
 ", up to 800 ",
 Cell[BoxData["\"\<Medium\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "353e388b-1d2b-4e37-94e3-78ee44fb7e31"],
 ", more ",
 Cell[BoxData["\"\<Large\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "813766bc-24aa-428a-b9a2-aef7f89d2788"],
 "."
}], "Notes",ExpressionUUID->"cb999e66-26b6-4918-95e4-814526df8a75"],

Cell[TextData[{
 "A custom look for one substrate is one more definition ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"InfraSubstrateStyle", "[", 
    RowBox[{
     StyleBox["name", "TI"], ",", " ", 
     StyleBox["size", "TI"]}], "]"}], " ", "=", " ", "\[Ellipsis]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ebab374-5958-43c8-bfb2-a92267017fe4"],
 ", listed under ",
 Cell[BoxData["\"\<Custom\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bcdec09-fb12-4863-ab82-898eeaec2b30"],
 ". Any graph is drawn like a substrate by ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Graph",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Sequence",
      BaseStyle->"Link"], " ", "@@", " ", 
     RowBox[{"InfraSubstrateStyle", "[", 
      StyleBox["size", "TI"], "]"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "931c5901-de1e-48ce-8d74-86fcabbd56bc"],
 "."
}], "Notes",ExpressionUUID->"6dcf42b0-d6a2-4fc4-a1f4-afdb63322469"]
}, Open  ]],

