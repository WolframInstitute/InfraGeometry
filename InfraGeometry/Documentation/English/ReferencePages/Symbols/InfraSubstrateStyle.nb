Cell["The square mesh with no style and in the three styles:", "ExampleText",ExpressionUUID->"f5f50774-4760-4879-9bdc-d118b080be72"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", "\"\<Default\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Graph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"Sequence", " ", "@@", " ", 
         RowBox[{"InfraSubstrateStyle", "[", "style", "]"}]}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", "style"}]}], "]"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"style", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Default\>\"", ",", " ", "\"\<Small\>\"", ",", 
          " ", "\"\<Medium\>\"", ",", " ", "\"\<Large\>\""}], "}"}]}], 
       "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e4a3b9ef-de33-4be9-a0c2-6955a74b2fb6"],

