Cell[TextData[{
 "A substrate is a backdrop, and the construction drawn on it carries the \
colour. The style draws it in gray: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["StandardGray"]], "paclet:ref/StandardGray"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "847c2fff-7df1-4142-97b9-4b0d5f504e43"],
 " edges and faintly filled vertex disks with a dark outline, lighter as the \
substrate grows."
}], "Notes",ExpressionUUID->"7f790a84-9b51-404f-b3d1-3884fd6a0139"],

