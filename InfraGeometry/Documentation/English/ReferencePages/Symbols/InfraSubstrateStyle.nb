Cell["The square mesh with no style and in the three styles:", "ExampleText",ExpressionUUID->"f6de5b05-d762-4d3c-a318-f4a0641c88a1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", "\"\<Default\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Graph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"Sequence", " ", "@@", " ", 
         RowBox[{"InfraSubstrateStyle", "[", "style", "]"}]}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", "style"}]}], "]"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"style", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Default\>\"", ",", " ", "\"\<Small\>\"", ",", 
          " ", "\"\<Medium\>\"", ",", " ", "\"\<Large\>\""}], "}"}]}], 
       "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6eb6444b-bdfa-4828-85e6-20a3f2e04ee8"],

