Notebook[{

Cell[CellGroupData[{
Cell["FindInfraSegment", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"138f7dae-0436-412b-a7b4-83ea406d91bb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a38d0f12-8478-49f0-9450-88c52f485c6e"],
 "\[LineSeparator]",
 "gives one geodesic \[LongDash] a shortest path \[LongDash] from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ", as a vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6dab2c4d-2739-40cd-a7af-fbd31ca4f884"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad2b19df-12b9-4b4f-8812-b42e2be0660a"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01dd330b-a812-454c-a61a-cd053ad2295b"],
 " of exactly ",
 StyleBox["n", "TI"],
 " geodesics or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a286690-08b8-4b1c-a4f4-6ebba400a230"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c058b037-faa7-4a1e-afbb-994b6cb41021"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63a6af92-0172-4963-93b6-06e03bcfc719"],
 " gives every geodesic."
}], "Usage",ExpressionUUID->"20f4dc8e-00f2-4074-8e07-e35670f493a0"],

Cell[TextData[{
 "A segment from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 " is a geodesic: a path whose length realizes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "(", 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["b", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bed7ab68-cf3d-46d2-81e7-a7001d69c1f5"],
 "."
}], "Notes",ExpressionUUID->"6ab3f66a-6c87-4f3f-8752-a8b77b424324"],

Cell[TextData[{
 "In the Euclidean plane the segment between two points is unique. On a graph \
it is a ",
 StyleBox["set",
  FontWeight->"Bold"],
 " of paths, and uniqueness fails generically \[LongDash] a square grid has \
many geodesics between two vertices, because any interleaving of the \
horizontal and vertical steps is one."
}], "Notes",ExpressionUUID->"4973e71a-f28f-4b51-b63a-5b85e0aaabe4"],

Cell[TextData[{
 "The search runs on the substrate directly, with ",
 Cell[BoxData["FindPath"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0983245-5254-411b-a2ea-b888a525ce48"],
 " at the geodesic length. It does not read the graph of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "464b32ec-d884-4690-935b-0f8c5e63db2e"],
 ", so it is the check on that graph, and it returns exactly the shapes ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraVertexList"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraVertexList", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"]}], "]"}], ",", " ", "\[Ellipsis]"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3ffc168-2c7b-4779-ab06-a0731511dcd1"],
 " gives. To count the geodesics without enumerating them, use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4363bdef-5d97-45e2-9277-a4fbf6a417fa"],
 "."
}], "Notes",ExpressionUUID->"e1698bc6-e422-4833-9056-bc8f2a9e2962"],

Cell[TextData[{
 "The count-less call is one geodesic, deterministic. There is no ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2ae8d35-9e0c-4621-8021-49fffd973dd1"],
 " and no ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aaba7314-a039-4278-9f0d-cceeabfe669a"],
 "."
}], "Notes",ExpressionUUID->"53ea85b1-12a4-428a-a3e4-32546fd20700"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UniqueInfraSegmentQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/UniqueInfraSegmentQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5b4545f3-330e-45a1-8792-1e369f9ed1ff"],
 " tests whether the segment is unique, which is the graph-intrinsic shadow \
of Euclid's first postulate holding sharply."
}], "Notes",ExpressionUUID->"dc5ac13c-9d88-4cc1-960a-9525939c48ea"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"c0d3ea07-a24f-43f9-9676-09e5f4e79c15"],

