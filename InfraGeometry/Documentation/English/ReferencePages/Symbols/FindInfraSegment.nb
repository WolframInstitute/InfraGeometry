     "a73dae9c-8c59-451c-b807-544d013787a1"], Cell[
    "Ruler postulate", "TableText",ExpressionUUID->
     "bd2c86eb-44e7-40e7-a7ec-67c984d60462"], Cell["\<\
The points of a line correspond to the reals, and the segment is a closed \
coordinate interval.\
\>", "TableText",ExpressionUUID->"abc2c4ad-d167-41ec-8593-186614ce436a"]}
  }]], "3ColumnTableMod",ExpressionUUID->"253907f1-e5b0-4c0e-8316-\
