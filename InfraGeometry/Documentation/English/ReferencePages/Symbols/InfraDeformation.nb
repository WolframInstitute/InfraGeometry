Cell["\<\
An edge of a square and its longer route around the other three sides:\
\>", "ExampleText",ExpressionUUID->"8fed9916-165f-47f7-bf85-4aa45ce27c89"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "4", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"family", " ", "=", " ", 
     RowBox[{"InfraDeformation", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"UpTo", "[", "2", "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"g", ",", " ", "family", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<CountsByExcess\>\"", ",", " ", "\"\<Length\>\""}], "}"}]}],
     "]"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1588e942-65f0-48f6-b9db-32d220b64ef2"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"CountsByExcess\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"0", "\[Rule]", "1"}], ",", 
      RowBox[{"1", "\[Rule]", "0"}], ",", 
      RowBox[{"2", "\[Rule]", "1"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"Length\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "3"}], "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"68529409-6b2f-4bae-9271-85007aec457a"]
}, Open  ]],

Cell["\<\
The two paths stay inside the radius-1 tube, and both have fixed endpoints:\
\>", "ExampleText",ExpressionUUID->"36028687-556a-40cb-9538-3964bf1f0f70"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "4", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"RandomInfraDeformation", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"InfraDeformation", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"UpTo", "[", "2", "]"}]}], "]"}], ",", " ", "All", ",", " ", 
     RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7d3e774c-6308-4c99-9a47-8c0b5b1ec8c8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "4", ",", "3", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"ec59424c-16df-49df-a83c-477d79910a01"]
}, Open  ]]
}, Open  ]],

