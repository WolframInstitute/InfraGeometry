     FontSize->0.9 Inherited,ExpressionUUID->
     "08771290-2eb6-4bed-9f51-1e6f2265100e"]], "TableText",ExpressionUUID->
     "f26f81f6-c1da-49ef-8e5a-e75b94b0657e"], Cell["\<\
attained edge lengths; a scalar for one length, otherwise a list\
\>", "TableText",ExpressionUUID->"42925293-2efd-4072-bf18-b442a0be42c0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c81154b9-cf81-428f-8840-f37c8039f346"], Cell[TextData[Cell[
