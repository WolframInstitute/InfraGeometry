Cell["\<\
Larger excess is still counted exactly when the finite-history construction \
fits the state budget:\
\>", "ExampleText",ExpressionUUID->"1632a8b2-fd48-4deb-800b-3d93bfe1a90d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CompleteGraph", "[", "5", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"InfraDeformation", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"UpTo", "[", "3", "]"}]}], "]"}], ",", 
     " ", "\"\<CountsByExcess\>\""}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0d565584-aa55-4414-b1c2-05ab3398ff4b"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"0", "\[Rule]", "1"}], ",", 
   RowBox[{"1", "\[Rule]", "3"}], ",", 
   RowBox[{"2", "\[Rule]", "6"}], ",", 
   RowBox[{"3", "\[Rule]", "6"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b6a0f5d9-dafc-4808-b86d-9cf6f3f47b5a"]
}, Open  ]],

Cell["A radius-0 tube singles out the reference:", "ExampleText",ExpressionUUID->"f164c0b6-655b-442a-9826-2f65fa07708a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "4", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"RandomInfraDeformation", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"InfraDeformation", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"UpTo", "[", "4", "]"}], ",", " ", 
       RowBox[{"\"\<TubeRadius\>\"", " ", "->", " ", "0"}]}], "]"}], ",", " ",
      "All", ",", " ", 
     RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7d7851ba-2ace-4326-9ff2-8e5331e34210"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2", ",", "3"}], "}"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"e05aea3d-2dce-498c-b335-57139df48c86"]
}, Open  ]]
}, Open  ]],

