Notebook[{

Cell[CellGroupData[{
Cell["InfraDeformation", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b89c2fe7-6e85-4040-8f84-4d4f9c9fa4be"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDeformation"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDeformation", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["reference", "TI"], ",", " ", 
    StyleBox["excess", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f6afe3b-95ba-4531-83bc-b1ef5255ebd1"],
 "\[LineSeparator]",
 "represents the simple paths with the endpoints of the shortest path ",
 StyleBox["reference", "TI"],
 ", within a reference tube and the specified excess length.",
 "\n"
}], "Usage",ExpressionUUID->"3adbb6f2-8486-4ae1-b698-767e53040f80"],

Cell[TextData[{
 "The object is inert. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraDeformation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraDeformation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "737db92f-b191-4dfd-bb0a-1f05edf672c1"],
 " samples or enumerates its members, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2e2af938-41af-409a-802d-16ff19956480"],
 " reads its properties, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f041b6a4-b7c9-4079-8d31-7f1eae223b20"],
 " tests membership."
}], "Notes",ExpressionUUID->"cce689f9-9e46-4f53-b24e-458c6f02a1c4"],

Cell[TextData[{
 "The substrate is a simple undirected unweighted graph. ",
 StyleBox["reference", "TI"],
 " is a nonempty vertex list forming a shortest path. Write ",
 StyleBox["L", "TI"],
 " for its edge length. A member is a vertex list with no repeated vertex, \
the same ordered endpoints, and length ",
 StyleBox["L + k", "TI"],
 " for an allowed excess ",
 StyleBox["k", "TI"],
 ". Every vertex of the member is within the tube radius of some reference \
vertex, using graph distance."
}], "Notes",ExpressionUUID->"d07e9660-d791-4191-8835-32cb279cf26c"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "931c4d70-6524-4898-a461-7accd32d621d"], Cell[
    "Excess specification", "TableText",
     FontWeight->Bold,ExpressionUUID->"faecfaa9-9bd9-4272-9879-403d27b49b3d"],
     Cell["Allowed excess", "TableText",
     FontWeight->Bold,ExpressionUUID->"d1e12158-c7a9-4291-b485-76fd2b1ea8ea"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "84f088a8-e9b7-47e4-91f0-6535d77394a2"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "k", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "63ddda4a-bcd1-40aa-ae53-29ef2486a1b0"]], "TableText",ExpressionUUID->
     "1867662c-015f-46b8-84e1-00b0ea1bfe89"], Cell[TextData[{
     "exactly ",
     StyleBox["k", "TI"]
    }], "TableText",ExpressionUUID->"fb431fc3-4c42-4a42-83f1-d911214d0852"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "98289b8b-9eea-4459-905e-95bf4875dd1c"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", 
      RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "38248c73-1229-4ee3-84f7-3deda5b492a2"]], "TableText",ExpressionUUID->
     "dfb4050c-707d-4dfc-ab4a-f7b101eff0e2"], Cell[TextData[{
     "each integer from ",
     StyleBox["lo", "TI"],
     " through ",
     StyleBox["hi", "TI"]
    }], "TableText",ExpressionUUID->"28ab5252-0a3a-41c7-9fac-ce9cd3a902fa"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "753765de-7048-4009-80f6-6516d1840126"], Cell[TextData[Cell[BoxData[
     RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1390a6e8-26d7-444a-931c-17fb82080918"]], "TableText",ExpressionUUID->
     "d3df19c3-00df-4b1c-8127-2d353b630a4e"], Cell[TextData[{
     "0 through ",
     StyleBox["k", "TI"]
    }], "TableText",ExpressionUUID->"99f0294f-b87b-4f3b-995f-ac6685ec2318"]}
  }]], "2ColumnTableMod",ExpressionUUID->"59c6f028-8371-4183-b359-\
885e44854328"],

Cell["The bounds are nonnegative integers.", "Notes",ExpressionUUID->"d3706b2d-65af-44dd-a8b4-a97f8126cd4b"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d45f0481-65ea-4b22-a22a-e7d779d9b283"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"ba6555f4-e968-4b56-93be-2ccd4dca529c"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"ab5960e3-98b4-4951-91f0-a8181b460163"],
     Cell["Meaning", "TableText",
     FontWeight->Bold,ExpressionUUID->"3f9b564c-0503-4f9c-a9bb-186c263d6083"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f8fc438a-adb7-4a32-820d-c65c5db4ed2b"], Cell[TextData[Cell[
    BoxData["\"\<TubeRadius\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "82d73d10-9fed-4bc8-97e0-8519e840f6bd"]], "TableText",ExpressionUUID->
     "7d925728-3413-412a-816b-f51bd6871ce2"], Cell[TextData[Cell[BoxData[
    "1"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d13916de-2ad0-4398-975f-e55470fdb102"]], "TableText",ExpressionUUID->
     "ea5bbd37-66ed-471b-92c2-bfd92ae217de"], Cell[TextData[{
     "nonnegative integer graph distance from the reference vertex set, or ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9b9ac835-df1e-4f0c-9161-e0610ff4a2ed"]
    }], "TableText",ExpressionUUID->"ada23977-fbe7-4fe5-9359-3bcfa4d9a1d5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fdd7f348-8ddf-41c0-8b1b-9aef94e2ec45"], Cell[TextData[Cell[
    BoxData["\"\<MaxStates\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "320b78f0-7b18-4d48-ba9a-3142d19bcfa5"]], "TableText",ExpressionUUID->
     "2dd6b725-e6f4-4042-ad83-20ca8ab4bf6b"], Cell[TextData[Cell[BoxData[
    "100000"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c05e7ad6-19d7-4d62-83b4-b2ab7f5d6886"]], "TableText",ExpressionUUID->
     "3337d202-dfad-4b3d-bc52-b279aafd845b"], Cell[TextData[{
     "positive integer limit on construction states, or ",
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8e0b9d4a-df85-42ad-9ef3-e9618ef213bf"]
    }], "TableText",ExpressionUUID->"c4a2c294-c5a4-4418-9a87-0a3d8bddc097"]}
  }]], "3ColumnTableMod",ExpressionUUID->"ebd820b9-c0ca-4b81-9267-\
ff10a547f59b"],

Cell["\<\
A radius-0 tube contains only the reference when excess 0 is allowed. A wider \
tube can contain other shortest paths at excess 0. A one-vertex reference has \
only its constant path when excess 0 is allowed.\
\>", "Notes",ExpressionUUID->"e26e1e7c-0efd-4ad6-b140-aefc01f4a240"],

Cell[TextData[{
 "Members may move toward the starting vertex as well as away from it. This \
differs from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraForwardDeformation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraForwardDeformation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9e64d04a-e788-4a49-80c4-a20d32b3e3ab"],
 ", whose walks never decrease that distance and may repeat vertices."
}], "Notes",ExpressionUUID->"eb47f216-f46a-49d0-85dd-62c5e00fda7f"],

Cell[TextData[{
 "Membership describes proximity and length, not homotopy. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraDeformation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraDeformation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "822da736-0002-4119-8cdf-7e02158b9056"],
 " separately searches for a chain of elementary face moves that respects the \
bounds throughout."
}], "Notes",ExpressionUUID->"d563ab77-32b2-4607-a579-069b5d454dab"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5342e5f2-6d46-448c-8624-c1fb3d28d9df"], Cell["Property", "TableText",
