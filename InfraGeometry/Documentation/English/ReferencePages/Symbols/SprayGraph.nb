Cell[TextData[{
 "A layer of the spray is a shell: the vertices at depth ",
 StyleBox["r", "TI"],
 " are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "236fb6ee-2ee7-4672-8b54-d772bcfb3231"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a29c4176-0bf9-41dd-b018-cb232afb74d6"],
 ", and their number is the shell area."
}], "ExampleText",ExpressionUUID->"0498dd30-09b8-4128-b730-ec8328cba452"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sprayDag", " ", "=", " ", 
     RowBox[{"SprayGraph", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"\"\<AxisLength\>\"", " ", "->", " ", "3"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"sprayDag", ",", " ", 
         RowBox[{
          RowBox[{"FindInfraShell", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}], " ", "->", " ",
           "$InfraShellColor"}]}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "sprayDag", "]"}], ",", " ", 
         RowBox[{"FindInfraBall", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}]}], "]"}]}], " ", 
      "===", " ", 
      RowBox[{"FindInfraShell", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"VertexCount", "[", "sprayDag", "]"}], " ", "===", " ", 
      RowBox[{"BallVolumes", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7f8e9dce-431a-4a71-8156-34f1c8fb22e0"],

