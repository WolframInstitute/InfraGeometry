Cell["\<\
The sinks of the spray, where no step leads farther from the centre. They are \
the ends of the maximal shortest paths:\
\>", "ExampleText",ExpressionUUID->"64479f8d-3592-4cb6-a3ce-05e72dd5fb4b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"spray", " ", "=", " ", 
        RowBox[{"SprayGraph", "[", 
         RowBox[{"g", ",", " ", "c"}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"sinks", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "spray", "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"VertexOutDegree", "[", 
             RowBox[{"spray", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], 
           " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"sinks", ",", " ", "c"}], "}"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"Length", "[", "sinks", "]"}]}]}], "]"}]}], "]"}], ",", "\n",
     "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"30705dc4-0a21-4d94-834a-e51c5eafb327"],

