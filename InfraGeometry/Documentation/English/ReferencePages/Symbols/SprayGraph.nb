Cell[TextData[{
 "The shortest paths from ",
 StyleBox["c", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " are the paths of the spray from ",
 StyleBox["c", "TI"],
 " to ",
 StyleBox["v", "TI"],
 "; the ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c80e6074-a83c-46b8-9e96-6be00bf89a56"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ca4989fa-f0db-4733-aeb1-5beff92991d5"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{"c", ",", " ", "v"}], "]"}], ",", " ", "\"\<Graph\>\""}], "]"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d06cfbe-01a2-4983-9905-ae55d08f54c1"],
 " holds the same family."
}], "ExampleText",ExpressionUUID->"0c577ff9-9df2-4d4f-a429-9c541bd105ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"through", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSegment", "[", 
            RowBox[{"c", ",", " ", "through"}], "]"}], ",", 
           " ", "\"\<Graph\>\""}], "]"}], ",", " ", "c", ",", " ", 
         "through"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"FindPath", "[", 
        RowBox[{
         RowBox[{"SprayGraph", "[", 
          RowBox[{"g", ",", " ", "c"}], "]"}], ",", " ", "c", ",", " ", 
         "through", ",", " ", "Infinity", ",", " ", "All"}], "]"}]}], " ", "===",
       " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"FindPath", "[", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSegment", "[", 
            RowBox[{"c", ",", " ", "through"}], "]"}], ",", 
           " ", "\"\<Graph\>\""}], "]"}], ",", " ", "c", ",", " ", "through", 
         ",", " ", "Infinity", ",", " ", "All"}], "]"}]}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"936e5c3d-47da-4874-b849-ec88d9df044b"],

