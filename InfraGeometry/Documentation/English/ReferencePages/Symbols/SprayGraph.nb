}], "ExampleText",ExpressionUUID->"eb85a00e-dce4-4d3a-acb7-4372f30d3e06"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "5"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "6"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindPath", "[", 
       RowBox[{
        RowBox[{"SprayGraph", "[", 
         RowBox[{"g", ",", " ", "c"}], "]"}], ",", " ", "c", ",", " ", "v", ",",
         " ", "Infinity", ",", " ", "All"}], "]"}]}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"c", ",", " ", "v"}], "]"}], ",", 
       " ", "\"\<Cardinality\>\""}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"79b26578-09a0-43a9-9157-149e8f79a1e1"],

