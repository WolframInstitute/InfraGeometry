Cell[CellGroupData[{
Cell["SprayGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"08380a6e-30f1-47a3-aabb-82625868c787"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42e7f771-28d6-4356-bc24-d13acf0fa731"],
 "\[LineSeparator]",
 "gives the directed acyclic graph of all geodesics from ",
 StyleBox["c", "TI"],
 ": an edge ",
 StyleBox["u \[RightArrow] v", "TI"],
 " for every edge of ",
 StyleBox["g", "TI"],
 " with ",
 StyleBox["d(c, v) = d(c, u) + 1", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f41b88c2-37d3-4964-a145-854e917efa80"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["c1", "TI"], ",", " ", 
      StyleBox["c2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a9d6f7a-2f4d-4a6f-a1b4-73940e198078"],
 "\[LineSeparator]",
 "measures the distance from the nearest of the sources.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"59aba997-e45d-4072-8af1-f541cc700edf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox["u1", "TI"], ",", " ", 
        StyleBox["v1", "TI"]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["u2", "TI"], ",", " ", 
        StyleBox["v2", "TI"]}], "}"}], ",", " ", "\[Ellipsis]"}], "}"}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa85bc95-7978-4417-9701-96eb54fc1383"],
 "\[LineSeparator]",
 "gives the union of geodesics between the listed pairs."
}], "Usage",ExpressionUUID->"bbc0977e-4fc7-4641-ad12-d550d44e1c9b"],

Cell[TextData[{
 "Definition: the spray at ",
 StyleBox["c", "TI"],
 " orients every edge of ",
 StyleBox["g", "TI"],
 " that joins two consecutive shells about ",
 StyleBox["c", "TI"],
 " outward, from the shell of radius ",
 StyleBox["r", "TI"],
 " to that of radius ",
 StyleBox["r", "TI"],
 " + 1. Edges inside one shell are dropped."
}], "Notes",ExpressionUUID->"e2dd9482-0f0a-40e6-9251-4322fcebd754"],

Cell[TextData[{
 "Its directed paths starting at ",
 StyleBox["c", "TI"],
 " are exactly the geodesics from ",
 StyleBox["c", "TI"],
 ", each once, and the paths from ",
 StyleBox["c", "TI"],
 " to a sink are the maximal ones \[LongDash] the geodesics that cannot be \
continued away from ",
 StyleBox["c", "TI"],
 ". It is the graph analogue of the exponential map at ",
 StyleBox["c", "TI"],
 ": every direction the observer can walk in without turning back towards ",
 StyleBox["c", "TI"],
 ", with the branching left in."
}], "Notes",ExpressionUUID->"9d71a31a-9219-42ba-aac8-88411b6a9eac"],

Cell["\<\
With several sources the distance is to the nearest source, so the spray \
grows out of the whole set.\
\>", "Notes",ExpressionUUID->"6bcbdaf5-279f-4b21-9c13-04efddfb3e0c"],

Cell["\<\
The pair form picks geodesics between each pair and takes the union of their \
path graphs. It enumerates, unlike the other two forms.\
\>", "Notes",ExpressionUUID->"99c78ff5-7b9d-4173-8856-13f2efaefe0b"],

Cell["Options:", "Notes",ExpressionUUID->"b6a36d12-57de-4d93-9354-1b9d31cc7c62"],

