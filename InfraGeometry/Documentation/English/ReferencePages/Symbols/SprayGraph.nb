Cell[TextData[{
 "The vertices at depth ",
 StyleBox["r", "TI"],
 " are the shell of radius ",
 StyleBox["r", "TI"],
 ", so the spray to depth ",
 StyleBox["r", "TI"],
 " has the vertices of the ball:"
}], "ExampleText",ExpressionUUID->"2e71864b-ec49-4a94-b9f8-7f24f2c1820c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"VertexCount", " ", "@", " ", 
       RowBox[{"SprayGraph", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", 
         RowBox[{"\"\<AxisLength\>\"", " ", "->", " ", "r"}]}], "]"}]}], " ", 
      "==", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
        " ", "\"\<CountingMeasure\>\""}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"acf19571-df79-4592-af2a-36672f37b1f0"],

