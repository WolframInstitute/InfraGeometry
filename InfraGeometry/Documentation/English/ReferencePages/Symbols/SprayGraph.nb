Cell["\<\
The sinks of the spray, where no step leads farther from the centre. They are \
the ends of the maximal shortest paths:\
\>", "ExampleText",ExpressionUUID->"ec032225-e205-44fd-b071-e71f8a3c4364"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"spray", " ", "=", " ", 
        RowBox[{"SprayGraph", "[", 
         RowBox[{"g", ",", " ", "c"}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"sinks", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "spray", "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"VertexOutDegree", "[", 
             RowBox[{"spray", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], 
           " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"sinks", ",", " ", "c"}], "}"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"Length", "[", "sinks", "]"}]}]}], "]"}]}], "]"}], ",", "\n",
     "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"27d6558f-6f2c-4e6a-99b9-da5a84c47352"],

