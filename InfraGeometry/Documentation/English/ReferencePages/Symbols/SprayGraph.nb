Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"VertexCount", " ", "@", " ", 
       RowBox[{"SprayGraph", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", 
         RowBox[{"\"\<AxisLength\>\"", " ", "->", " ", "r"}]}], "]"}]}], " ", 
      "==", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
        " ", "\"\<CountingMeasure\>\""}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"11c8b6e2-248f-4e57-ad21-0928c9fc3968"],

