Cell["\<\
The spray from the centre covers the patch, and its sinks are the vertices of \
the rim where no step leads farther away.\
\>", "ExampleText",ExpressionUUID->"2e5587fd-75d0-47e9-b8b1-0a78c50a8c21"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sprayDag", " ", "=", " ", 
     RowBox[{"SprayGraph", "[", 
      RowBox[{"g", ",", " ", "c"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sinks", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "sprayDag", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexOutDegree", "[", 
          RowBox[{"sprayDag", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], 
        " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"sprayDag", ",", " ", 
         RowBox[{"sinks", " ", "->", " ", "$InfraPointColor"}]}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"VertexCount", "[", "sprayDag", "]"}], ",", " ", 
     RowBox[{"EdgeCount", "[", "sprayDag", "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "sinks"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d6cceda7-4c33-4d68-9604-1bcc77930d75"],

