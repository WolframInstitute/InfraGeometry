Cell[TextData[{
 "The shortest paths from ",
 StyleBox["c", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " are the paths of the spray from ",
 StyleBox["c", "TI"],
 " to ",
 StyleBox["v", "TI"],
 "; the ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f803a926-ed79-4f70-8988-e76c02f93352"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6efe2fd0-3a85-465e-b096-0b390e5c6650"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{"c", ",", " ", "v"}], "]"}], ",", " ", "\"\<Graph\>\""}], "]"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b7deffb-f999-4ce8-936b-88994442f4cd"],
 " holds the same family."
}], "ExampleText",ExpressionUUID->"949df0cf-debd-4b3c-b117-6e60af9ff50e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"through", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
