Cell["\<\
The grid is bipartite and its spray keeps all 144 edges. The mesh has \
triangles, and its spray keeps 173 of 255:\
\>", "ExampleText",ExpressionUUID->"525eba14-04f6-408a-a474-d8eacf7dd855"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
     
     RowBox[{"{", 
      RowBox[{
       RowBox[{"EdgeCount", " ", "@", " ", 
        RowBox[{"SprayGraph", "[", 
         RowBox[{"g", ",", " ", "c"}], "]"}]}], ",", " ", 
       RowBox[{"EdgeCount", "[", "g", "]"}]}], "}"}]}], "]"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", 
       " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"e3ed7e85-c05b-4a60-978c-6d27b6a98296"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"144", ",", "144"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"173", ",", "255"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"727e9679-aeb1-4467-a0bc-479e70c88c2f"]
}, Open  ]]
}, Open  ]],

