Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8bff6baf-c5c8-4fa3-9679-f0418ec86104"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
