Cell["\<\
The spray from the centre covers the patch, and its sinks are the vertices of \
the rim where no step leads farther away.\
\>", "ExampleText",ExpressionUUID->"b6f9b68d-267f-4931-8f7a-cf13c1639cd3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sprayDag", " ", "=", " ", 
     RowBox[{"SprayGraph", "[", 
      RowBox[{"g", ",", " ", "c"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sinks", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "sprayDag", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexOutDegree", "[", 
          RowBox[{"sprayDag", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], 
        " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"sprayDag", ",", " ", 
         RowBox[{"sinks", " ", "->", " ", "$InfraPointColor"}]}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"VertexCount", "[", "sprayDag", "]"}], ",", " ", 
     RowBox[{"EdgeCount", "[", "sprayDag", "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "sinks"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"675ffa36-0f98-4d6e-b51d-b16fceeb66f2"],

