       RowBox[{"SegmentGraph", "[", 
        RowBox[{"g", ",", " ", "41", ",", " ", "61"}], "]"}], ",", " ", "41", 
       ",", " ", "61", ",", " ", "Infinity", ",", " ", "All"}], "]"}]}]}]}], 
