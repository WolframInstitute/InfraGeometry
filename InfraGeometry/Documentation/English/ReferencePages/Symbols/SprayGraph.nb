Cell[CellGroupData[{
Cell["SprayGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ccaebae4-31fa-4655-8969-b4f9a28ce7cc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d59d38fa-364d-4dbb-a53e-7d8bfdceb96a"],
 "\[LineSeparator]",
 "gives the directed acyclic graph of all shortest paths from ",
 StyleBox["c", "TI"],
 ": an edge ",
 StyleBox["u \[RightArrow] v", "TI"],
 " for every edge of ",
 StyleBox["g", "TI"],
 " with ",
 StyleBox["d(c, v) = d(c, u) + 1", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2a6981df-5669-4bcd-8468-a083aa91f816"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["c1", "TI"], ",", " ", 
      StyleBox["c2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b4a2671-9d74-4230-9c36-bc7d16136514"],
 "\[LineSeparator]",
 "measures the distance from the nearest of the sources.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"138fba69-56ea-4b85-8784-e9acdc2927f7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox["u1", "TI"], ",", " ", 
        StyleBox["v1", "TI"]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["u2", "TI"], ",", " ", 
        StyleBox["v2", "TI"]}], "}"}], ",", " ", "\[Ellipsis]"}], "}"}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c4d1902-0b2e-4db7-9796-72ec8f19f6e1"],
 "\[LineSeparator]",
 "gives the union of shortest paths between the listed pairs."
}], "Usage",ExpressionUUID->"5fd2c946-0094-471c-93ed-f420186992e4"],

Cell[TextData[{
 "Definition: the spray at ",
 StyleBox["c", "TI"],
 " orients every edge of ",
 StyleBox["g", "TI"],
 " that joins two consecutive shells about ",
 StyleBox["c", "TI"],
 " outward, from the shell of radius ",
 StyleBox["r", "TI"],
 " to that of radius ",
 StyleBox["r", "TI"],
 " + 1. Edges inside one shell are dropped."
}], "Notes",ExpressionUUID->"e0717737-0249-4aae-b244-5397f45321b8"],

Cell[TextData[{
 "Its directed paths starting at ",
 StyleBox["c", "TI"],
 " are exactly the shortest paths from ",
 StyleBox["c", "TI"],
 ", each once, and the paths from ",
 StyleBox["c", "TI"],
 " to a sink are the maximal ones \[LongDash] the shortest paths that cannot \
be continued away from ",
 StyleBox["c", "TI"],
 ". It is the graph analogue of the exponential map at ",
 StyleBox["c", "TI"],
 ": every direction the observer can walk in without turning back towards ",
 StyleBox["c", "TI"],
 ", with the branching left in."
}], "Notes",ExpressionUUID->"6f263dd6-4f83-48de-86e9-e68f417384a8"],

Cell["\<\
With several sources the distance is to the nearest source, so the spray \
grows out of the whole set.\
\>", "Notes",ExpressionUUID->"32d7f7f4-0ea5-4e41-9719-f1ea2accb44c"],

Cell["\<\
The pair form picks shortest paths between each pair and takes the union of \
their path graphs. It enumerates, unlike the other two forms.\
\>", "Notes",ExpressionUUID->"80eeeef9-158e-4e10-9511-1040ca4d071f"],

Cell["Options:", "Notes",ExpressionUUID->"2bdb5378-ca5b-48d1-8152-5032cc1f742d"],

