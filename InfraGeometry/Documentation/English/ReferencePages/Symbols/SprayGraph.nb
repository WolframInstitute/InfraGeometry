Cell["\<\
The spray at the centre, drawn on the substrate by the maximal shortest paths \
through each edge, and the spray itself cut at depth 3.\
\>", "ExampleText",ExpressionUUID->"80a46b6d-deff-4f65-b33c-a5f5e1482699"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"SprayGraph", "[", 
           RowBox[{"g", ",", " ", "c"}], "]"}], ",", " ", "c"}], "}"}]}], 
       "]"}], ",", "\n", "    ", 
      RowBox[{"SprayGraph", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"\"\<AxisLength\>\"", " ", "->", " ", "3"}]}], "]"}]}], "}"}],
     "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c13c0d2e-d7f0-4e09-a5c2-9bf399d14bc4"],

