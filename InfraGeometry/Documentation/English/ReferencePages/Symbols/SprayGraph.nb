  "acd524d7-fe2e-49cb-8f5b-0b111e6312a4"],
 "\[LineSeparator]",
 "gives the spray of the vertex set, with the distance to the nearest ",
 StyleBox["ci", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8f62bb3b-9ed2-4a18-b295-503abf3d584f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
