Cell[TextData[{
 "The shortest paths from ",
 StyleBox["c", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " are the paths of the spray from ",
 StyleBox["c", "TI"],
 " to ",
 StyleBox["v", "TI"],
 "; the ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e7ca939-aabe-4464-a8b7-414ec0a9f25f"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "734cc80d-2320-4be8-9cad-a2e7eafb47ae"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{"c", ",", " ", "v"}], "]"}], ",", " ", "\"\<Graph\>\""}], "]"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5742410-a8a5-4bef-9600-b3a38583a9bb"],
 " holds the same family."
}], "ExampleText",ExpressionUUID->"652698ae-97ac-4c95-a6e5-5d07e65d4d37"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"through", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
