     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"FindPath", "[", 
      RowBox[{
       RowBox[{"SprayGraph", "[", 
        RowBox[{"g", ",", " ", "41"}], "]"}], ",", " ", "41", ",", " ", "61", 
       ",", " ", "Infinity", ",", " ", "All"}], "]"}]}], " ", "===", "\n", 
    "    ", 
    RowBox[{"Sort", " ", "@", " ", 
