Cell["\<\
The grid is bipartite and its spray keeps all 144 edges. The mesh has \
triangles, and its spray keeps 173 of 255:\
\>", "ExampleText",ExpressionUUID->"8630801a-4196-4017-9ec8-eec8c54bf47c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
     
     RowBox[{"{", 
      RowBox[{
       RowBox[{"EdgeCount", " ", "@", " ", 
        RowBox[{"SprayGraph", "[", 
         RowBox[{"g", ",", " ", "c"}], "]"}]}], ",", " ", 
       RowBox[{"EdgeCount", "[", "g", "]"}]}], "}"}]}], "]"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", 
       " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"56c23dd4-c8dc-4191-b0f6-f0d3f8a7bf3f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"144", ",", "144"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"173", ",", "255"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"85a72b9a-c36b-4f71-8f9d-8ad4bc8013cd"]
}, Open  ]]
}, Open  ]],

