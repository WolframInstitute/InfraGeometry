Cell[TextData[{
 "A layer of the spray is a shell: the vertices at depth ",
 StyleBox["r", "TI"],
 " are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "44111c3a-7711-442b-8fab-e954f87ed0df"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a006aaf-e968-4bd2-90b9-284f6a526262"],
 ", and their number is the shell area."
}], "ExampleText",ExpressionUUID->"00cea073-11db-4648-8a79-02bd5d29cf65"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sprayDag", " ", "=", " ", 
     RowBox[{"SprayGraph", "[", 
      RowBox[{"g", ",", " ", "41", ",", " ", 
       RowBox[{"\"\<AxisLength\>\"", " ", "->", " ", "3"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "sprayDag", "]"}], ",", " ", 
         RowBox[{"FindInfraBall", "[", 
          RowBox[{"g", ",", " ", "41", ",", " ", "2"}], "]"}]}], "]"}]}], " ",
       "===", " ", 
      RowBox[{"FindInfraShell", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", "3"}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"VertexCount", "[", "sprayDag", "]"}], " ", "===", " ", 
      RowBox[{"BallVolumes", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", "3"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6c71e37c-d14f-4004-ae34-35bee5c5ec9c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b57149c0-d716-434a-8eea-83f14af4491e"]
}, Open  ]],

Cell[TextData[{
 "The geodesics from ",
 StyleBox["c", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " are the paths of the spray from ",
 StyleBox["c", "TI"],
 " to ",
 StyleBox["v", "TI"],
 "; the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SegmentGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SegmentGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d1a89e3e-f705-4881-8f06-3a7c26c890bd"],
 " holds the same family."
}], "ExampleText",ExpressionUUID->"b7019f95-b748-41ee-86b4-56209ee7eedc"],

