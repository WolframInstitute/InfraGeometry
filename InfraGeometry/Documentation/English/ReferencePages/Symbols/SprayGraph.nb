Cell["\<\
The spray at the centre, drawn on the substrate by the maximal shortest paths \
through each edge, and the spray itself cut at depth 3.\
\>", "ExampleText",ExpressionUUID->"fda2a0b4-1c12-4aa6-908d-b3bf42b36783"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"SprayGraph", "[", 
           RowBox[{"g", ",", " ", "c"}], "]"}], ",", " ", "c"}], "}"}]}], 
       "]"}], ",", "\n", "    ", 
      RowBox[{"SprayGraph", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"\"\<AxisLength\>\"", " ", "->", " ", "3"}]}], "]"}]}], "}"}],
     "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"15dadcb9-4271-4101-b4d6-fcaa04c62bec"],

