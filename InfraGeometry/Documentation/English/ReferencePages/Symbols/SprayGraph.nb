Cell["SprayGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b4ae6401-1f3c-4e33-8c3c-38586fe3fd89"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb68c72d-5ace-4674-8142-757c6290a07f"],
 "\[LineSeparator]",
 "gives the directed acyclic graph of all shortest paths from ",
 StyleBox["c", "TI"],
 ": an edge ",
 StyleBox["u \[RightArrow] v", "TI"],
 " for every edge of ",
 StyleBox["g", "TI"],
 " with ",
 StyleBox["d(c, v) = d(c, u) + 1", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5e444045-ea8b-488f-8b4e-bcdc55bf1427"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["c1", "TI"], ",", " ", 
      StyleBox["c2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "371c962d-ee7c-4773-812a-bf43bb92d3d8"],
 "\[LineSeparator]",
 "measures the distance from the nearest of the sources.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3ed7551f-fdd2-46cf-95d7-d8c0dc757778"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox["u1", "TI"], ",", " ", 
        StyleBox["v1", "TI"]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["u2", "TI"], ",", " ", 
        StyleBox["v2", "TI"]}], "}"}], ",", " ", "\[Ellipsis]"}], "}"}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "936e5ed9-1622-4ead-ae7d-e81f87fcaa4d"],
 "\[LineSeparator]",
 "gives the union of shortest paths between the listed pairs."
}], "Usage",ExpressionUUID->"5b5313ca-8ee6-4116-9c1d-54684c5c5d3b"],

Cell[TextData[{
 "Definition: the spray at ",
 StyleBox["c", "TI"],
 " orients every edge of ",
 StyleBox["g", "TI"],
 " that joins two consecutive shells about ",
 StyleBox["c", "TI"],
 " outward, from the shell of radius ",
 StyleBox["r", "TI"],
 " to that of radius ",
 StyleBox["r", "TI"],
 " + 1. Edges inside one shell are dropped."
}], "Notes",ExpressionUUID->"ebf47e22-8a0c-4edb-bef7-13c673d5f4c4"],

Cell[TextData[{
 "Its directed paths starting at ",
 StyleBox["c", "TI"],
 " are exactly the shortest paths from ",
 StyleBox["c", "TI"],
 ", each once, and the paths from ",
 StyleBox["c", "TI"],
 " to a sink are the maximal ones \[LongDash] the shortest paths that cannot \
be continued away from ",
 StyleBox["c", "TI"],
 ". It is the graph analogue of the exponential map at ",
 StyleBox["c", "TI"],
 ": every direction the observer can walk in without turning back towards ",
 StyleBox["c", "TI"],
 ", with the branching left in."
}], "Notes",ExpressionUUID->"2971f884-b046-4284-9908-b18215c2b1ff"],

Cell["\<\
With several sources the distance is to the nearest source, so the spray \
grows out of the whole set.\
\>", "Notes",ExpressionUUID->"8c16b983-70f8-4769-9f78-556f17e29471"],

Cell["\<\
The pair form picks shortest paths between each pair and takes the union of \
their path graphs. It enumerates, unlike the other two forms.\
\>", "Notes",ExpressionUUID->"b7806016-adbb-4c2c-89a5-e015c7bbebb0"],

Cell["Options:", "Notes",ExpressionUUID->"7956181c-9275-44c2-8a3a-4c7b8296f647"],

