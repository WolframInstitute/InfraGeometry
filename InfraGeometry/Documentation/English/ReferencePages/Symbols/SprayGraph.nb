Cell["\<\
The spray at the centre, drawn on the substrate by the maximal shortest paths \
through each edge, and the spray itself cut at depth 3.\
\>", "ExampleText",ExpressionUUID->"2c595ad0-3e53-46c4-b466-7d3c763ab414"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"SprayGraph", "[", 
           RowBox[{"g", ",", " ", "c"}], "]"}], ",", " ", 
          RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
          "c"}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"SprayGraph", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"\"\<AxisLength\>\"", " ", "->", " ", "3"}]}], "]"}]}], "}"}],
     "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6001aa99-7dc4-4402-a6ba-9e910aed5c02"],

