Cell["PathThickness", "ExampleSubsection",ExpressionUUID->"dd8ebd2b-463a-4084-bdd8-0e7874db0097"],

Cell["\<\
One shortest path, those within Hausdorff distance 1 of it, and all 20 \
shortest paths between two vertices of the grid. The labels are the edge \
counts:\
\>", "ExampleText",ExpressionUUID->"e1b79824-6dac-4acf-b36b-5b0700364642"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "6"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"spray", " ", "=", " ", 
          RowBox[{"SprayGraph", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"a", ",", " ", "b"}], "}"}], "}"}], ",", " ", 
            RowBox[{"\"\<PathThickness\>\"", " ", "->", " ", "t"}]}], "]"}]}],
          "}"}], ",", "\n", "      ", 
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{"spray", ",", " ", "a", ",", " ", "b"}], "}"}], ",", " ", 
          RowBox[{"PlotLabel", " ", "->", " ", 
           RowBox[{"EdgeCount", "[", "spray", "]"}]}]}], "]"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1", ",", " ", "Infinity"}], "}"}]}], "}"}]}],
      "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"41093b63-bf21-4467-a22e-86ca1113ce5a"],

