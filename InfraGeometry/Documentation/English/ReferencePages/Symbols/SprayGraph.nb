Cell["\<\
The maximal shortest paths from the centre to one sink, each a path of the \
spray.\
\>", "ExampleText",ExpressionUUID->"6115f1fe-6a7d-44a7-9910-167f26462246"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sprayDag", " ", "=", " ", 
     RowBox[{"SprayGraph", "[", 
      RowBox[{"g", ",", " ", "c"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sink", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "sprayDag", "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"VertexOutDegree", "[", 
           RowBox[{"sprayDag", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], 
         " ", "&"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"paths", " ", "=", " ", 
     RowBox[{"FindPath", "[", 
      RowBox[{
      "sprayDag", ",", " ", "c", ",", " ", "sink", ",", " ", "Infinity", ",", 
       " ", "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"paths", ",", " ", "c", ",", " ", "sink"}], "}"}]}], "]"}], ",",
      " ", 
     RowBox[{"Length", " ", "@", " ", "paths"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"14fbc4d4-785b-4216-86b3-fdf4b9483839"],

