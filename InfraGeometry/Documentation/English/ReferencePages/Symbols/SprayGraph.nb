Cell[TextData[{
 "A layer of the spray is a shell: the vertices at depth ",
 StyleBox["r", "TI"],
 " are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3762dc35-75cb-4f65-8bbd-7b67852d2c1f"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d559535-96b3-4c8a-a27c-f3ca34ffc945"],
 ", and their number is the shell area."
}], "ExampleText",ExpressionUUID->"3d1ddb72-3b29-46d9-b687-145457473224"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sprayDag", " ", "=", " ", 
     RowBox[{"SprayGraph", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"\"\<AxisLength\>\"", " ", "->", " ", "3"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"sprayDag", ",", " ", 
         RowBox[{
          RowBox[{"FindInfraShell", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}], " ", "->", " ",
           "$InfraShellColor"}]}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "sprayDag", "]"}], ",", " ", 
         RowBox[{"FindInfraRepresentative", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraBall", "[", 
            RowBox[{"c", ",", " ", "2"}], "]"}]}], "]"}]}], "]"}]}], " ", "===",
       " ", 
      RowBox[{"FindInfraShell", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"VertexCount", "[", "sprayDag", "]"}], " ", "===", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{"c", ",", " ", "3"}], "]"}], ",", 
        " ", "\"\<CountingMeasure\>\""}], "]"}]}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"55a67c20-34a1-4cd3-907b-8d326bd86c99"],

