Cell["\<\
The spray from the centre covers the patch, and its sinks are the vertices of \
the rim where no step leads farther away.\
\>", "ExampleText",ExpressionUUID->"578b5274-119a-44f1-bf05-0530c952fdee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sprayDag", " ", "=", " ", 
     RowBox[{"SprayGraph", "[", 
      RowBox[{"g", ",", " ", "c"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sinks", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "sprayDag", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexOutDegree", "[", 
          RowBox[{"sprayDag", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], 
        " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"sprayDag", ",", " ", 
         RowBox[{"sinks", " ", "->", " ", "$InfraPointColor"}]}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"VertexCount", "[", "sprayDag", "]"}], ",", " ", 
     RowBox[{"EdgeCount", "[", "sprayDag", "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "sinks"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"28dad10e-0b25-4c45-914d-9aee19c70f7c"],

