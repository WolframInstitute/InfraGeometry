    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9701f33-a190-4d77-8766-23fe39af4486"],
 "\[LineSeparator]",
 "gives the directed acyclic graph of all shortest paths from ",
 StyleBox["c", "TI"],
 ": an edge ",
 StyleBox["u \[RightArrow] v", "TI"],
 " for every edge of ",
 StyleBox["g", "TI"],
 " with ",
 StyleBox["d(c, v) = d(c, u) + 1", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0de21834-684a-40ec-8b78-890c38b1ef7a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["c1", "TI"], ",", " ", 
      StyleBox["c2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49c8e177-83a0-4f25-bbec-ff192eb424ac"],
 "\[LineSeparator]",
 "measures the distance from the nearest of the sources.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"fddf6fe4-18ec-4988-a250-94a082dfe9fa"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
