Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "4"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sprays", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"SprayGraph", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "b"}], "}"}], "}"}], ",", " ", 
         RowBox[{"\"\<PathThickness\>\"", " ", "->", " ", "t"}]}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1", ",", " ", "Infinity"}], "}"}]}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{"spray", ",", " ", 
            RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
            "a", ",", " ", "b"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"spray", ",", " ", "sprays"}], "}"}]}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{"EdgeCount", " ", "/@", " ", "sprays"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5c75148a-31c2-45cc-be81-13d3e35d0bf8"],

