Cell[CellGroupData[{
Cell["SprayGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6f39c5c9-9475-4399-8a7e-a230c456b505"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7bf39c3-a936-464a-bd5c-f338b43aa2f0"],
 "\[LineSeparator]",
 "gives the directed acyclic graph of all shortest paths from ",
 StyleBox["c", "TI"],
 ": an edge ",
 StyleBox["u \[RightArrow] v", "TI"],
 " for every edge of ",
 StyleBox["g", "TI"],
 " with ",
 StyleBox["d(c, v) = d(c, u) + 1", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0611799a-73c1-44ce-a6f3-2792b5442d8c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["c1", "TI"], ",", " ", 
      StyleBox["c2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65145f87-c1aa-4f3b-bbb0-487d00ee6c4b"],
 "\[LineSeparator]",
 "measures the distance from the nearest of the sources.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"681fbb74-fd4d-42ef-9569-10ccaaac2b6a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox["u1", "TI"], ",", " ", 
        StyleBox["v1", "TI"]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["u2", "TI"], ",", " ", 
        StyleBox["v2", "TI"]}], "}"}], ",", " ", "\[Ellipsis]"}], "}"}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f268e26b-f955-4a93-bc84-b670b519195d"],
 "\[LineSeparator]",
 "gives the union of shortest paths between the listed pairs."
}], "Usage",ExpressionUUID->"132b7206-4eb9-4473-bb91-0f24d323097c"],

Cell[TextData[{
 "Definition: the spray at ",
 StyleBox["c", "TI"],
 " orients every edge of ",
 StyleBox["g", "TI"],
 " that joins two consecutive shells about ",
 StyleBox["c", "TI"],
 " outward, from the shell of radius ",
 StyleBox["r", "TI"],
 " to that of radius ",
 StyleBox["r", "TI"],
 " + 1. Edges inside one shell are dropped."
}], "Notes",ExpressionUUID->"b02f231c-1465-4413-bdb8-d7294e6c6246"],

Cell[TextData[{
 "Its directed paths starting at ",
 StyleBox["c", "TI"],
 " are exactly the shortest paths from ",
 StyleBox["c", "TI"],
 ", each once, and the paths from ",
 StyleBox["c", "TI"],
 " to a sink are the maximal ones \[LongDash] the shortest paths that cannot \
be continued away from ",
 StyleBox["c", "TI"],
 ". It is the graph analogue of the exponential map at ",
 StyleBox["c", "TI"],
 ": every direction the observer can walk in without turning back towards ",
 StyleBox["c", "TI"],
 ", with the branching left in."
}], "Notes",ExpressionUUID->"5e83d29a-7cec-4c6c-8d96-2b3d95f6700e"],

Cell["\<\
With several sources the distance is to the nearest source, so the spray \
grows out of the whole set.\
\>", "Notes",ExpressionUUID->"5eb955b8-5259-4372-998d-8cc879b25571"],

Cell["\<\
The pair form picks shortest paths between each pair and takes the union of \
their path graphs. It enumerates, unlike the other two forms.\
\>", "Notes",ExpressionUUID->"1b295c5a-86e4-4bd6-a80a-4727617d180b"],

Cell["Options:", "Notes",ExpressionUUID->"1eb2a0bc-f8fb-4598-9d24-851ed8e23f88"],

