Cell["\<\
On the cross of half-length 3 the coordinates take the 49 values {\[Minus]3, \
\[Ellipsis], 3}\.b2, and the base of the fibration over them is a 7 \[Times] \
7 grid:\
\>", "ExampleText",ExpressionUUID->"9dca5afc-491c-4911-9f2b-8e906c193182"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"coords", " ", "=", " ", 
     RowBox[{"OrthogonalCoordinates", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", 
       RowBox[{"FindInfraOrthogonalAxes", "[", 
        RowBox[{"g", ",", " ", "45", ",", " ", "3"}], "]"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Values", " ", "@", " ", "coords"}]}]}], ",", " ", 
     RowBox[{"VertexCount", " ", "@", " ", 
      RowBox[{"InfraBaseSpace", " ", "@", " ", 
       RowBox[{"InfraFiberedGraph", "[", 
        RowBox[{"g", ",", " ", "coords"}], "]"}]}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2c39f764-7f5c-41f7-8797-c8eae24f3c1c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"49", ",", "49"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c19d12aa-e084-4699-a05e-16b1795af84a"]
