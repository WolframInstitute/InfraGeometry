       "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"len", ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "2"}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0787a565-4f95-470c-8898-de99d0e960ce"],

