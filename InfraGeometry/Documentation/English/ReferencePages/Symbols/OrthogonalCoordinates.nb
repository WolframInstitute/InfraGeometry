 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "2", ",", "2"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"11879423-9138-482d-883f-9d8e7a7d2fc8"]
}, Open  ]],

