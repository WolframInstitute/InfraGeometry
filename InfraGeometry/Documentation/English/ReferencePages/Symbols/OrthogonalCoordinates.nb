Cell[TextData[{
 "The coordinates of the 9 x 9 grid on the straight cross through its centre: \
the centre 41 reads ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "0"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42e82d31-9e67-4c7c-ba88-ee526f4fd820"],
 ", the vertex 42 ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "1"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41d1925b-f35f-4e95-bb0b-f264772c9b43"],
 " and the vertex 50 ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "0"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d92936f3-2747-4bc0-b2fe-b73691b656c5"],
 "."
}], "ExampleText",ExpressionUUID->"b5c17a18-8be0-464b-96c3-c66d9eacd411"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axes", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{"g", ",", " ", "41", ",", " ", "4"}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"coords", " ", "=", " ", 
     RowBox[{"OrthogonalCoordinates", "[", 
      RowBox[{"g", ",", " ", "41", ",", " ", "axes"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"coords", "[", "41", "]"}], ",", " ", 
       RowBox[{"coords", "[", "42", "]"}], ",", " ", 
       RowBox[{"coords", "[", "50", "]"}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Values", " ", "@", " ", "coords"}]}], " ", "===", " ", 
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "4"}], ",", " ", "4"}], "]"}], ",", " ", "2"}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b6c86fb9-0160-4250-93c5-3895fdc62556"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", "True"}], "}"}]], "Output",\

 CellLabel->"Out[1]= ",ExpressionUUID->"4bc8dddb-4902-4ac4-a98b-8732314a567a"]
}, Open  ]],

