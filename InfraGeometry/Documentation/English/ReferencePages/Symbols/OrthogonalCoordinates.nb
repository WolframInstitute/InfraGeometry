     FontSize->0.9 Inherited,ExpressionUUID->
     "54d4c0a0-672e-4ca3-ab5a-b14de7e87c63"]], "TableText",ExpressionUUID->
     "b4f7b612-2bd6-4c3b-a83b-f3699908e149"], Cell[TextData[Cell[BoxData[
    "Median"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "715ab3c8-84a1-4c13-9b18-58b910843329"]], "TableText",ExpressionUUID->
     "de0b43b9-9265-4a6a-b555-ea65f8dd5241"], Cell[TextData[{
     "the function that reduces a tied projection to one position; ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "fbabfe93-2a6b-4c8b-b9c5-d99e2b63fba6"],
     " keeps them"
    }], "TableText",ExpressionUUID->"7f060408-cc59-4e32-82f2-507c0f45083e"]}
  }]], "3ColumnTableMod",ExpressionUUID->"1183f209-6725-4576-ac78-\
b01e453ff17c"],

Cell[TextData[{
 "The projection of a vertex can have several vertices. ",
 Cell[BoxData[
  RowBox[{"\"\<SelectCoordinate\>\"", " ", "->", " ", "f"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2d0b995-de4e-4b40-be8c-2c098169352e"],
 " applies ",
 StyleBox["f", "TI"],
 " to the list of their positions, and the same ",
 StyleBox["f", "TI"],
 " reduces the projection of the centre, so the centre reads 0 under every \
translation-equivariant ",
 StyleBox["f", "TI"],
 ": ",
 Cell[BoxData["Median"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f5e5ebb-5fec-4177-8784-ddb070130893"],
 ", ",
 Cell[BoxData["Mean"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79895705-e553-4770-92d2-eda5a9805e3d"],
 ", ",
 Cell[BoxData["Min"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20488232-166d-4ef1-86e4-063af6e0aeb9"],
 ", ",
 Cell[BoxData["Max"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b14ff71-72d8-4b9e-b0a0-31107ad00bce"],
 ", ",
 Cell[BoxData["First"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e9b336e-4bd0-4e2d-91b9-168cc50e0ab5"],
 ", ",
 Cell[BoxData["Last"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "334a58ef-e6e7-46a7-b53f-ddf8aebbf9ce"],
 ". ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "131df448-55ca-4c0f-8edc-f125e580319e"],
 " keeps the positions, so a coordinate is a list of them."
}], "Notes",ExpressionUUID->"b787c531-4fa0-4906-8e93-d0cbed5ec9b8"]
}, Open  ]],

