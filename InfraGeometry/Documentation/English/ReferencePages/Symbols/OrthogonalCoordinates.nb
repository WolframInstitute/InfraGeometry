Cell["\<\
On the four rays of the grid frame each vertex has four coordinates, one per \
ray:\
\>", "ExampleText",ExpressionUUID->"2d861ad9-7672-48fd-bbcc-b25645c13b7e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"OrthogonalCoordinates", "[", 
    RowBox[{"g", ",", " ", "45", ",", " ", 
     RowBox[{"FindInfraOrthogonalRays", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", "2"}], "]"}], ",", " ", "67"}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ec8bba4f-ae34-4733-82bf-3c7ccb5edb6a"],

