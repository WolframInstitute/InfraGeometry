             "]"}]}], "]"}]}], "}"}], ",", "\n", "      ", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"InfraBaseGraph", " ", "@", " ", "fib"}], ",", " ", 
