Cell[TextData[{
 "A vertex nearest to two neighbouring walk vertices has a half-integer \
coordinate under ",
 Cell[BoxData["Median"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b743f45b-69f1-46b2-816a-ab02662b5d3f"],
 ": the vertex 4 of the 4-cycle is nearest to 3 and to 1 on the walk ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"3", ",", " ", "1", ",", " ", "2"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7ca6b7-945b-4240-9e57-7cf32cafc00e"],
 "."
}], "ExampleText",ExpressionUUID->"ddc8bbc4-5d62-49b1-a1fe-7382d7fdc5e4"],

