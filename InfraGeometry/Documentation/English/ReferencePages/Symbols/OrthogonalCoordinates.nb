     FontWeight->Bold,ExpressionUUID->"62325aca-4413-4be0-8fc9-0d424894e6d3"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"dc0a6a9b-b0f2-4edc-9489-7f19e3aa53d1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6ac07f05-6db8-437b-aff1-a0a89b094318"], Cell[TextData[Cell[
    BoxData["\"\<SelectCoordinate\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "65473e7b-dfbe-4583-804f-011ee6469212"]], "TableText",ExpressionUUID->
     "cc0d1ffd-4e83-4656-8cc9-7591a659fa05"], Cell[TextData[Cell[BoxData[
    "Median"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ebf3123d-c4aa-4815-9a2c-36919a448cc3"]], "TableText",ExpressionUUID->
     "94c3f2f8-2e57-4def-80ef-321b6de6dd84"], Cell[TextData[{
     "the function that reduces a tied projection to one position; ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "bfdef91c-99e7-4c0e-b61f-01eb8ff82dd9"],
     " keeps them"
    }], "TableText",ExpressionUUID->"ea0790b2-21d8-43de-a72b-88d4b3e013d3"]}
  }]], "3ColumnTableMod",ExpressionUUID->"b4cfe01f-89da-4247-9a56-\
23b6a9dfbd05"],

Cell[TextData[{
 "The projection of a vertex can have several vertices. ",
 Cell[BoxData[
  RowBox[{"\"\<SelectCoordinate\>\"", " ", "->", " ", "f"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a376e71-f610-49f5-8e27-11fe4e7f4737"],
 " applies ",
 StyleBox["f", "TI"],
 " to the list of their positions, and the same ",
 StyleBox["f", "TI"],
 " reduces the projection of the centre, so the centre reads 0 under every \
translation-equivariant ",
 StyleBox["f", "TI"],
 ": ",
 Cell[BoxData["Median"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d06566e-f5f2-474d-a6dc-35669adb3f98"],
 ", ",
 Cell[BoxData["Mean"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "526d4f8b-6c7e-46b5-b063-fce9f3ef8e12"],
 ", ",
 Cell[BoxData["Min"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c357a1ca-da0c-4489-837a-2fa6589c4653"],
 ", ",
 Cell[BoxData["Max"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09ab85f3-d90a-4356-b79a-be9916eea6ec"],
 ", ",
 Cell[BoxData["First"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e90e5dbb-0d2a-46a7-b062-313937de6dbb"],
 ", ",
 Cell[BoxData["Last"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9de3ef04-8f12-4e08-8e55-a2003211fa1c"],
 ". ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a10008b-c6a3-4840-86f4-c889beea8a31"],
 " keeps the positions, so a coordinate is a list of them."
}], "Notes",ExpressionUUID->"3b23e0d1-a2fd-4c3d-a18a-3523204700a9"]
}, Open  ]],

