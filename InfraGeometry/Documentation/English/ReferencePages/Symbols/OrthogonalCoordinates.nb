Cell[TextData[{
 "The coordinates of the 9 x 9 grid on the straight cross through its centre: \
the centre 41 reads ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "0"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b6c1d12-bee4-4a03-b673-923141b386d7"],
 ", the vertex 42 ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "1"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6f1b3f0-e480-4e28-a0d0-87f5fba8a42d"],
 " and the vertex 50 ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "0"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c4628cd3-eba8-4dcf-9cf8-0eda42119692"],
 "."
}], "ExampleText",ExpressionUUID->"e7875218-99f1-442a-8263-58eddac58a38"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axes", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{"g", ",", " ", "41", ",", " ", "4"}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"coords", " ", "=", " ", 
     RowBox[{"OrthogonalCoordinates", "[", 
      RowBox[{"g", ",", " ", "41", ",", " ", "axes"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"coords", "[", "41", "]"}], ",", " ", 
       RowBox[{"coords", "[", "42", "]"}], ",", " ", 
       RowBox[{"coords", "[", "50", "]"}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Values", " ", "@", " ", "coords"}]}], " ", "===", " ", 
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "4"}], ",", " ", "4"}], "]"}], ",", " ", "2"}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8cec9412-c1b7-4071-b0d5-433563460642"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", "True"}], "}"}]], "Output",\

 CellLabel->"Out[1]= ",ExpressionUUID->"91a36d90-d453-4d80-a91f-7447ec5e95e3"]
}, Open  ]],

Cell["The same, for one vertex.", "ExampleText",ExpressionUUID->"5f7b3554-7700-43ef-b45a-a514406a448b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
