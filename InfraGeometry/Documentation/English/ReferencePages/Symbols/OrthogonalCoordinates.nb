Notebook[{

Cell[CellGroupData[{
Cell["OrthogonalCoordinates", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7e3e52ac-66d1-4b05-8f21-66534de9dbf5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OrthogonalCoordinates"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/OrthogonalCoordinates", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["walks", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20f1178c-694e-4ae1-9196-2814919ee1a9"],
 "\[LineSeparator]",
 "gives the association ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "j", ",", " ", "..."}], "}"}]}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9773eb47-c8fb-4e1c-89a4-d23270f776e7"],
 " over the vertices of ",
 StyleBox["g", "TI"],
 ": the signed position of the shortest-path projection of ",
 StyleBox["v", "TI"],
 " on each walk, counted from the projection of ",
 StyleBox["c", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b491ebdd-52dd-4511-aa8f-e7941bac1b0a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OrthogonalCoordinates"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/OrthogonalCoordinates", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["walks", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2361514c-25d8-4dd4-90fb-4a97d16f577f"],
 "\[LineSeparator]",
 "gives the coordinates ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "j", ",", " ", "..."}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e9f7c92-ea65-4b60-a76d-527384a901b8"],
 " of the vertex ",
 StyleBox["v", "TI"],
 "."
}], "Usage",ExpressionUUID->"1bf95b21-7d19-4bab-ad10-4accfef47972"],

Cell[TextData[{
 "A ",
 StyleBox["walk",
  FontWeight->"Bold"],
 " is a vertex list ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"w0", ",", " ", "w1", ",", " ", "...", ",", " ", "wk"}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45cef787-1c2c-4415-b8c4-c49913c51a4e"],
 ", such as a set of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "df322067-c5e1-4442-aa26-464d909aa2ae"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalRays"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalRays", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "20c12372-df92-48f3-8fe5-4405b38c7f19"],
 "; a walk graph is read as its vertex sequence. The walks need not be \
perpendicular, and need not pass through ",
 StyleBox["c", "TI"],
 ": the coordinates are defined for any list of walks."
}], "Notes",ExpressionUUID->"3804121c-2790-48eb-b90b-9e958664ef7a"],

Cell[TextData[{
 "The ",
 StyleBox["projection",
  FontWeight->"Bold"],
 " of a vertex ",
 StyleBox["v", "TI"],
 " on a walk is the set of walk vertices nearest to ",
 StyleBox["v", "TI"],
 " by the shortest-path distance. The coordinate of ",
 StyleBox["v", "TI"],
 " on the walk is the position of its projection, counted from the projection \
of ",
 StyleBox["c", "TI"],
 ", with the order of the walk as the sign: a position after the projection \
of ",
 StyleBox["c", "TI"],
 " is positive, a position before it negative, and reversing a walk flips the \
sign."
}], "Notes",ExpressionUUID->"d0030671-47d0-4f13-93ec-0a34a3b8c883"],

Cell[TextData[{
 StyleBox["c", "TI"],
 " is a vertex, a vertex list or an association ",
 Cell[BoxData[
  RowBox[{"<|", " ", 
   RowBox[{
    RowBox[{"v1", " ", "->", " ", "w1"}], ",", " ", "..."}], " ", "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51c8878e-99ae-489a-bfc7-af91588e7e6d"],
 " with the weights ignored. Its support is projected like a vertex, the \
distance to a walk vertex being the least over the support. The centre of two \
vertices on a walk sits between them: on the walk ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f741da02-6dba-4ac9-8665-3526399baf61"],
 " the centre ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "2"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4bc3a80-9f08-438d-9778-5de9280fe87b"],
 " is at ",
 Cell["1/2", "InlineCode",ExpressionUUID->
  "f1d76398-69c4-4092-877d-26d3c6b1a766"],
 " and the vertex 3 at ",
 Cell["3/2", "InlineCode",ExpressionUUID->
  "a68d03eb-9045-4735-b33d-01b9b62a1957"],
 "."
}], "Notes",ExpressionUUID->"288de8c7-94bd-453f-a59b-4cdaa549ab4b"],

Cell[TextData[{
 "On the walks of one set of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e73b1af5-bb92-4b5f-8757-a3e269b2d5b9"],
 " a vertex of one walk has the coordinate 0 on every other walk, with no \
tie, since ",
 StyleBox["c", "TI"],
 " is the only nearest vertex of each walk to the other. A vertex off the \
walks can still have a tie, near a bent axis."
}], "Notes",ExpressionUUID->"5baacfcc-ff5c-4222-9600-d39b47637463"],

Cell[TextData[{
 "The result is a map from the vertices of ",
 StyleBox["g", "TI"],
 " to the grid of positions. It is a projection for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c4f96de4-613e-4e38-8d42-91ef21c093a9"],
 ": ",
 Cell[BoxData[
  RowBox[{"InfraFibration", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"OrthogonalCoordinates", "[", 
     RowBox[{"g", ",", " ", "c", ",", " ", "walks"}], "]"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea121e21-adf4-4420-b356-d7a0e14408e5"],
 " fibres ",
 StyleBox["g", "TI"],
 " over the positions that occur, and ",
 Cell[BoxData["InfraBaseGraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5c1eb31-b959-4f20-9e9a-b965f67c56fd"],
 " of it is the grid."
}], "Notes",ExpressionUUID->"6b36398e-0c76-4ba7-8018-afd9c66a4eea"],

Cell[TextData[{
 "One ",
 Cell[BoxData["GraphDistance"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "038ff650-54c8-4b11-a45b-517816c0fe67"],
 " row per walk vertex is computed; the projections are read off those rows."
}], "Notes",ExpressionUUID->"37494188-a0c2-4924-bdea-f2b24a1ab525"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1577b9b1-2bcb-4045-97d7-a604f0945875"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"622dea6b-04ed-4522-b7b9-36d09a2af306"],
