Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Possible Issues", "ExampleSection",ExpressionUUID->
   "dda06a82-eb41-4b48-8510-6cb821647761"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell["\<\
The coordinates of a vertex off every walk are the positions of its nearest \
walk vertices, not of a point in a geometric chart; a vertex far from the \
walks is projected onto the walls of the cross, and the fibres over the \
boundary of the grid are large.\
\>", "ExampleText",ExpressionUUID->"1b9d7471-b783-4481-8963-43e98040310a"],

Cell[TextData[{
 "On a graph with several shortest paths from ",
 StyleBox["v", "TI"],
 " to the walk, the projection is the set of nearest walk vertices, not of \
the paths; that is the tie of ",
 Cell[BoxData["\"\<SelectCoordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d52b6943-352f-49f3-9af5-e94cf8586f37"],
 "."
}], "ExampleText",ExpressionUUID->"19a993ee-ba1c-4a5f-a10f-90cb13a070a2"]
}, Open  ]],

