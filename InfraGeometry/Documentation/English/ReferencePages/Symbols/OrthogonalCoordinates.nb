Cell[TextData[{
 "The coordinates over the cross of half-length 4 are a bijection of the 9 x \
9 grid onto ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "4"}], ",", " ", "...", ",", " ", "4"}], "}"}], "^", "2"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1df074c-166e-457d-b802-b9a2a0befad1"],
 ", so the fibration over them has the grid as its base and is trivial. Over \
the cross of half-length 2 a vertex beyond the window projects to the nearest \
end: the base is the 5 x 5 grid and its fibres are 3 x 3 blocks over the \
corners."
}], "ExampleText",ExpressionUUID->"78236cdb-96a5-4220-8588-610d564ce440"],

