Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RadarCoordinates"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RadarCoordinates", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "73d7e44c-17f0-44e5-8a2d-724e0a954cb4"],
 " are distances to a basis, positive and unsigned; the orthogonal \
coordinates are signed positions along walks. On a path with the endpoint as \
the walk they agree."
}], "ExampleText",ExpressionUUID->"024055f3-e888-453e-a7b0-f3b40d4d378a"],

