Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RadarCoordinates"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RadarCoordinates", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "03dc1466-1875-4a50-97f1-61bc9e254411"],
 " are distances to a basis, positive and unsigned; the orthogonal \
coordinates are signed positions along walks. On a path with the endpoint as \
the walk they agree."
}], "ExampleText",ExpressionUUID->"1155a695-427e-479a-ba3a-1c045651ae56"],

