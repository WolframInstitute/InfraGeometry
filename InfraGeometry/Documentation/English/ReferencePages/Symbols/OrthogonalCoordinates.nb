Cell[TextData[{
 "A vertex nearest to two neighbouring walk vertices has a half-integer \
coordinate under ",
 Cell[BoxData["Median"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "391ddc2d-cf50-4766-a1a4-f15464a9000b"],
 ": the vertex 4 of the 4-cycle is nearest to 3 and to 1 on the walk ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"3", ",", " ", "1", ",", " ", "2"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b47aa178-cca6-4e62-a319-b9f8bbfe0d8d"],
 "."
}], "ExampleText",ExpressionUUID->"cccf23bb-99ab-4202-bb3a-c66dc9e65380"],

