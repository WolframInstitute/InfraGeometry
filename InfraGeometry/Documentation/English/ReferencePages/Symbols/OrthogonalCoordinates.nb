Cell["\<\
The vertices whose first coordinate is 0, on the axis of 3 steps through the \
centre: on the grid the perpendicular line, on the mesh an irregular set:\
\>", "ExampleText",ExpressionUUID->"f24f3d40-3050-4dd3-a893-7a4e92ef9bbd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"axis", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"FindInfraOrthogonalAxes", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}]}], "}"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"coords", " ", "=", " ", 
        RowBox[{"OrthogonalCoordinates", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", 
          RowBox[{"{", "axis", "}"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraWalk", "[", "axis", "]"}], ",", " ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"coords", "[", "#", "]"}], " ", "==", " ", 
              RowBox[{"{", "0", "}"}]}], " ", "&"}]}], "]"}], ",", " ", "c"}],
          "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"6819fa4a-b9ad-4984-aeb3-75051ddb6f9a"],

