Cell[CellGroupData[{
Cell["OrthogonalCoordinates", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5ecf1f1d-4249-4066-9c60-bfe7a1af02f6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OrthogonalCoordinates"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/OrthogonalCoordinates", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["walks", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9eddad23-cdf5-428d-9113-b6742bbd845e"],
 "\[LineSeparator]",
 "gives the association ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"x1", ",", " ", "x2", ",", " ", "\[Ellipsis]"}], "}"}]}], 
   "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a24838e-c838-4a88-b9ad-45ac784c6294"],
 " of the coordinates of every vertex ",
 StyleBox["v", "TI"],
 " of ",
 StyleBox["g", "TI"],
 ": the signed position of the projection of ",
 StyleBox["v", "TI"],
 " on each walk, counted from the projection of ",
 StyleBox["c", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"cbd512ab-3dfa-4e25-b476-7132c8034ea8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OrthogonalCoordinates"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/OrthogonalCoordinates", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["walks", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b500315-515f-4492-9a6a-edec568eb7c7"],
 "\[LineSeparator]",
 "gives the coordinates of the vertex ",
 StyleBox["v", "TI"],
 "."
}], "Usage",ExpressionUUID->"712c9cd4-ceb2-4fd4-836e-63d5f946c143"],

Cell[TextData[{
 "The projection of ",
 StyleBox["v", "TI"],
 " on a walk is the set of walk vertices nearest to ",
 StyleBox["v", "TI"],
 ". Its coordinate on the walk is the position of the projection minus the \
position of the projection of ",
 StyleBox["c", "TI"],
 ": positive after it, negative before it."
}], "Notes",ExpressionUUID->"989ac7e2-3744-4f25-abe5-8c5153ffb46b"],

Cell[TextData[{
 "These are Cartesian coordinates read off a frame. The walks are usually a \
set of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c4bb8852-4cad-4238-a272-e8d7ab522777"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalRays"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalRays", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d7812ec8-636e-49e2-9bf7-f217adb4c2cb"],
 ", but any vertex lists or walk graphs will do."
}], "Notes",ExpressionUUID->"920f11f1-34b8-4396-8fe9-c63dbf90cb9b"],

Cell[TextData[{
 "On the square grid, with the straight cross of half-length ",
 StyleBox["k", "TI"],
 " through ",
 StyleBox["c", "TI"],
 ", the coordinates are the grid coordinates of ",
 StyleBox["v", "TI"],
 " relative to ",
 StyleBox["c", "TI"],
 ", clipped to {\[Minus]",
 StyleBox["k", "TI"],
 ", \[Ellipsis], ",
 StyleBox["k", "TI"],
 "}. A vertex beyond the cross projects to its nearest end."
}], "Notes",ExpressionUUID->"794d6014-78b0-41ce-bb19-a2baf1e22704"],

Cell[TextData[{
 StyleBox["c", "TI"],
 " can be a vertex, a vertex list or an association. A centre of several \
vertices is projected as one set."
}], "Notes",ExpressionUUID->"301add65-303f-4a70-938f-27901910e69a"],

Cell[TextData[{
 "A projection of several vertices is reduced to one position by ",
 Cell[BoxData["\"\<SelectCoordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b11cb563-f9ac-4bba-997d-617e4376ab36"],
 ". The same function reduces the projection of ",
 StyleBox["c", "TI"],
 ", so ",
 StyleBox["c", "TI"],
 " reads 0 under ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Median"]], "paclet:ref/Median"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e2b95b8d-c00a-46d9-b8b6-aabb9e4b853e"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Mean"]], "paclet:ref/Mean"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d157af42-03aa-46c8-9858-971e063f61bd"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Min"]], "paclet:ref/Min"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3e79524b-9f65-4000-ac51-73155011b2f9"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Max"]], "paclet:ref/Max"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "55b37f0f-3594-460d-857f-ca2ca5c01d41"],
 "."
}], "Notes",ExpressionUUID->"c92034bf-5fcd-4ed1-b015-3a51fde8ec2e"],

