Cell[TextData[{
 "Any list of walks: two walks that cross at a vertex other than ",
 StyleBox["c", "TI"],
 ", or are not perpendicular, give coordinates all the same, here a skew pair \
on the 9 x 9 grid."
}], "ExampleText",ExpressionUUID->"44fb0c1b-43ee-4e7a-af67-e89185ad3f14"],

