Notebook[{

Cell[CellGroupData[{
Cell["OrthogonalCoordinates", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell["LLM generated.", "Notes",ExpressionUUID->"5cfc28b3-67a6-4fac-aef0-b78e9b753c2a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ff807c16-0b26-4938-a80a-6b397829295b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OrthogonalCoordinates"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/OrthogonalCoordinates", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["walks", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4311333d-bdf0-4f8e-992d-7ca0f6499161"],
 "\[LineSeparator]",
 "gives the association ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "j", ",", " ", "..."}], "}"}]}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c44e5a-e3b6-4d40-8663-10ad946bdde2"],
 " over the vertices of ",
 StyleBox["g", "TI"],
 ": the signed position of the shortest-path projection of ",
 StyleBox["v", "TI"],
 " on each walk, counted from the projection of ",
 StyleBox["c", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3950b56e-1593-4d33-8e0e-5a79395cd09b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OrthogonalCoordinates"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/OrthogonalCoordinates", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["walks", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07254c75-86af-4581-bbe4-27a70369da52"],
 "\[LineSeparator]",
 "gives the coordinates ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "j", ",", " ", "..."}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d336cb6-b327-4a1a-851c-93da3b9c64e5"],
 " of the vertex ",
 StyleBox["v", "TI"],
 "."
}], "Usage",ExpressionUUID->"81d7f1ee-0cb4-4297-a374-d547cbc643cd"],

Cell[TextData[{
 "A ",
 StyleBox["walk",
  FontWeight->"Bold"],
 " is a vertex list ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"w0", ",", " ", "w1", ",", " ", "...", ",", " ", "wk"}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a141d14c-90d2-4ea0-bc8d-3ed68f76b41d"],
 ", such as a set of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e5155e09-8076-47ed-b4bb-d0a94c9bc368"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalRays"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalRays", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fc1a86eb-bfdc-4d52-aa89-abed2521619c"],
 "; a walk graph is read as its vertex sequence. The walks need not be \
perpendicular, and need not pass through ",
 StyleBox["c", "TI"],
 ": the coordinates are defined for any list of walks."
}], "Notes",ExpressionUUID->"80805879-77f8-4d7a-b0f6-03cc12dc556d"],

Cell[TextData[{
 "The ",
 StyleBox["projection",
  FontWeight->"Bold"],
 " of a vertex ",
 StyleBox["v", "TI"],
 " on a walk is the set of walk vertices nearest to ",
 StyleBox["v", "TI"],
 " by the shortest-path distance. The coordinate of ",
 StyleBox["v", "TI"],
 " on the walk is the position of its projection, counted from the projection \
of ",
 StyleBox["c", "TI"],
 ", with the order of the walk as the sign: a position after the projection \
of ",
 StyleBox["c", "TI"],
 " is positive, a position before it negative, and reversing a walk flips the \
sign."
}], "Notes",ExpressionUUID->"63f915f6-d9d9-4711-bbbd-0529f882fb8e"],

Cell[TextData[{
 StyleBox["c", "TI"],
 " is a vertex, a vertex list or an association ",
 Cell[BoxData[
  RowBox[{"<|", " ", 
   RowBox[{
    RowBox[{"v1", " ", "->", " ", "w1"}], ",", " ", "..."}], " ", "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f1657b9-662b-4253-91c3-3c985943d6a2"],
 " with the weights ignored. Its support is projected like a vertex, the \
distance to a walk vertex being the least over the support. The centre of two \
vertices on a walk sits between them: on the walk ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db6071b5-8f1c-4a34-b7e0-ece474c50fbd"],
 " the centre ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "2"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ac5b38c-ea7f-4ead-b8fc-0dcbc3b50d23"],
 " is at ",
 Cell["1/2", "InlineCode",ExpressionUUID->
  "9ab85998-40a7-4fad-9cb7-1584a35761e2"],
 " and the vertex 3 at ",
 Cell["3/2", "InlineCode",ExpressionUUID->
  "f35d31e6-6a2d-471e-9961-32e8152144a2"],
 "."
}], "Notes",ExpressionUUID->"0df58aa4-1e31-4e83-995f-d089300e2f55"],

Cell[TextData[{
 "On the walks of one set of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraOrthogonalAxes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraOrthogonalAxes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "511aefcf-5d15-41e0-8ada-338c847bd6fc"],
 " a vertex of one walk has the coordinate 0 on every other walk, with no \
tie, since ",
 StyleBox["c", "TI"],
 " is the only nearest vertex of each walk to the other. A vertex off the \
walks can still have a tie, near a bent axis."
}], "Notes",ExpressionUUID->"bd1729b8-d3e9-4910-a2a4-d1acbdc01b2f"],

Cell[TextData[{
 "The result is a map from the vertices of ",
 StyleBox["g", "TI"],
 " to the grid of positions. It is a projection for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3989c261-5412-420f-b1e6-67330302bef0"],
 ": ",
 Cell[BoxData[
  RowBox[{"InfraFibration", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"OrthogonalCoordinates", "[", 
     RowBox[{"g", ",", " ", "c", ",", " ", "walks"}], "]"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b7ad086-b4f4-456c-9f2d-11537b2a3268"],
 " fibres ",
 StyleBox["g", "TI"],
 " over the positions that occur, and ",
 Cell[BoxData["InfraBaseGraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f84caed-b7cf-4ac5-83a5-c66704c2118b"],
 " of it is the grid."
}], "Notes",ExpressionUUID->"0a9d9a48-eb13-4cd1-a470-6d5c74602fbc"],

Cell[TextData[{
 "One ",
 Cell[BoxData["GraphDistance"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35a5dd48-e794-4e23-a378-ba052f596039"],
 " row per walk vertex is computed; the projections are read off those rows."
}], "Notes",ExpressionUUID->"97a47ab6-b1a3-47f9-a4e6-e304cf67124a"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8304eeb2-4e55-48c0-ae89-c1e15d394871"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"e32711cb-ecce-4b03-9705-ab77673bc2fb"],
