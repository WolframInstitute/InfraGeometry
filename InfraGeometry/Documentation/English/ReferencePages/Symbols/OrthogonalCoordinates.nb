Cell["\<\
A vertex beyond the cross projects to the nearest end. On the grid the 8 \
vertices past the corner of the window all read {3, 3}:\
\>", "ExampleText",ExpressionUUID->"afcd16af-b78e-4b99-b9ce-e2799bf83c26"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axes", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", "3"}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"coords", " ", "=", " ", 
     RowBox[{"OrthogonalCoordinates", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", "axes"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"corner", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"coords", "[", "#", "]"}], " ", "==", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "3"}], "}"}]}], " ", "&"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{"InfraWalk", " ", "/@", " ", "axes"}], ",", " ", "corner"}], 
      "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8b6c0c3d-a50c-4d5c-8387-12eb72c5db7f"],

