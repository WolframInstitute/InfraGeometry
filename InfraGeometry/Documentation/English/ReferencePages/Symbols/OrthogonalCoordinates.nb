Cell[TextData[{
 "On the 4-cycle the walk through the vertex 1 is ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "1", ",", " ", "4"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6be189c-a1f1-4e90-ac68-215bcce7371e"],
 ", and the antipode 3 is at the same distance from 2 and from 4. ",
 Cell[BoxData["Median"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e1319df-8143-47ed-b165-2c2f32e928d4"],
 " puts it at 0, with the centre, as does ",
 Cell[BoxData["Mean"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe5c0686-5a22-45ca-bda2-64616f9fc422"],
 "; ",
 Cell[BoxData["Min"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "621310d3-0952-4649-a18a-f49d8d17253e"],
 " and ",
 Cell[BoxData["Max"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c70065eb-ec57-4014-9c91-31ef3b9f3a79"],
 " put it at an end; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c0edfe2-033f-4e6a-b983-c8f87eb5f80b"],
 " shows the tie. A rule symmetric under reversing the walk identifies the \
antipode with the centre: the tie is a property of the cycle, not of the rule."
}], "ExampleText",ExpressionUUID->"4ab3bb58-7399-4180-8797-b8fc30908e2f"],

