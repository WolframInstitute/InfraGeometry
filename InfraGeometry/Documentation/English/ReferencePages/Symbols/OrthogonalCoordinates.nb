Cell["\<\
On the cross of half-length 3 through the centre of the grid the coordinates \
are the grid coordinates. The centre, two neighbours and a vertex two steps \
along each axis:\
\>", "ExampleText",ExpressionUUID->"54300945-039f-4607-ba03-6e7d415d1e85"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"axes", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", "3"}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"OrthogonalCoordinates", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", "axes", ",", " ", "v"}], "]"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"v", ",", " ", 
       RowBox[{"{", 
        RowBox[{"45", ",", " ", "46", ",", " ", "55", ",", " ", "67"}], 
        "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"fac75a48-d33c-49da-b7e5-58571b2a707c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"e75ddc7a-3dff-4074-994f-3a93b53dbd9d"]
}, Open  ]],

Cell["The level sets of the first coordinate on the cross:", "ExampleText",ExpressionUUID->"cdee4490-1c16-497f-b0b9-99745e149dc7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axes", " ", "=", " ", 
     RowBox[{"FindInfraOrthogonalAxes", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", "3"}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"coords", " ", "=", " ", 
     RowBox[{"OrthogonalCoordinates", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", "axes"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"levels", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"coords", "[", "#", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "i"}], " ", 
          "&"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "2"}], ",", " ", "0", ",", " ", "3"}], "}"}]}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"InfraWalk", " ", "/@", " ", "axes"}], ",", " ", "levels"}], 
      "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"b8ef96f4-f55c-4b38-94c2-b127400a4b20"],

