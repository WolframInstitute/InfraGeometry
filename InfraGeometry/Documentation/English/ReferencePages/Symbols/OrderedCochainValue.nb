 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5f3617f3-87d0-4d28-bec9-5326b6b06e8b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
