 "\[LineSeparator]",
 "gives the value of the ordered cochain ",
 StyleBox["\[Alpha]", "TI"],
 " on the increasing tuple ",
 StyleBox["v\:2080 < \[Ellipsis] < v\:2096", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"60afab16-492d-4695-9de0-aa208cf78ecb"],

Cell[TextData[{
 "An ordered ",
 StyleBox["k", "TI"],
 "-cochain is a function on the increasing ",
 StyleBox["(k + 1)", "TI"],
 "-tuples of the cliques, in the order in which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Sort"]], "paclet:ref/Sort"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b039a813-51db-465c-b32f-31c70b208825"],
 " puts the vertex names. It is stored like an alternating cochain, ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"v0", ",", " ", "\[Ellipsis]", ",", " ", "vk"}], "}"}], " ", "->",
     " ", "value"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dda5f08d-2564-4a94-ab42-9faab3a59faa"],
 ", one value per clique, and a value 0 is not stored."
}], "Notes",ExpressionUUID->"e917d291-7e88-4a03-b183-0d830198b587"],

Cell[TextData[{
 "On an increasing tuple ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrderedCochainValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3d0985b5-3752-4da4-a394-79815c78670e"],
 " gives the stored value, or 0. On any other tuple it gives ",
 Cell[BoxData[
  RowBox[{"Missing", "[", 
   RowBox[{"\"\<NonIncreasingTuple\>\"", ",", " ", "tuple"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e7a0872-3d79-457a-a34c-aed9df40f9bd"],
 ": an ordered cochain has no value there. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "08fc4d1b-dd39-4452-9d2a-0c0ee19c7654"],
 " would extend it by the sign rule, which is right for alternating cochains \
only."
}], "Notes",ExpressionUUID->"6f1f5479-d12a-4e3f-8f34-2e31aebb6b5e"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrderedCochainCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b4384855-4558-4c5f-8ceb-ecb54dc68ad5"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainCupOne"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainCupOne", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d93b834e-5adc-42e0-9884-01fb0f3ab941"],
 " give ordered cochains."
}], "Notes",ExpressionUUID->"3b440449-054a-4539-9312-39f2bda16175"]
}, Open  ]],

