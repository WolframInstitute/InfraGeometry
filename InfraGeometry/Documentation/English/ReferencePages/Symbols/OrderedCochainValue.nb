Cell[TextData[{
 "On increasing tuples ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrderedCochainValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ec05de31-3c2e-4eea-a2e1-62099b66514b"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e1d2eaf2-382b-485c-a3a4-0d2e0eb1d6f0"],
 " agree. On the reversed tuples ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8f8a18e8-bc22-4335-9217-040e017d3d07"],
 " applies the sign of the permutation:"
}], "ExampleText",ExpressionUUID->"926e4dbf-9cb4-4fef-9cd9-66d794dbe372"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"dx", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], "]"}]}], 
     ",", "\n", "   ", 
     RowBox[{"dy", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cup", " ", "=", " ", 
     RowBox[{"OrderedCochainCup", "[", 
      RowBox[{"g", ",", " ", "dx", ",", " ", "dy"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Keys", "[", "cup", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"OrderedCochainValue", "[", 
          RowBox[{"cup", ",", " ", "#"}], "]"}], " ", "==", " ", 
         RowBox[{"CochainValue", "[", 
          RowBox[{"cup", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Keys", "[", "cup", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"CochainValue", "[", 
          RowBox[{"cup", ",", " ", 
           RowBox[{"Reverse", "[", "#", "]"}]}], "]"}], " ", "==", " ", 
         RowBox[{"-", 
          RowBox[{"cup", "[", "#", "]"}]}]}], " ", "&"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"Union", "[", 
      RowBox[{"Head", " ", "/@", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"OrderedCochainValue", "[", 
           RowBox[{"cup", ",", " ", 
            RowBox[{"Reverse", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
          " ", 
         RowBox[{"Keys", "[", "cup", "]"}]}], ")"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"795be14a-9d67-4113-b089-7bfe3c68fd74"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", 
   RowBox[{"{", "Missing", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"921f5a40-100d-411b-99c9-5f11e81ae75d"]
}, Open  ]]
