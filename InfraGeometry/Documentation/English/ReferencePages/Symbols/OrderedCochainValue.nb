Cell["\<\
The ordered cup of the coboundaries of the distances from the centre of the \
triangular tiling and from a vertex three steps away, drawn on its triangles, \
blue where it is positive and red where it is negative. On a triangle at the \
centre it has a value on the increasing ordering of the corners and none on \
the five others.\
\>", "ExampleText",ExpressionUUID->"312c4305-ebae-4ba2-9b25-771936aeb9ce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"center", " ", "=", " ", 
      RowBox[{"InfraCenter", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"positions", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"apex", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "center", ",", " ", "3"}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cup", " ", "=", " ", 
     RowBox[{"OrderedCochainCup", "[", 
      RowBox[{"g", ",", "\n", "     ", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"AssociationMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "center", ",", " ", 
              RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
           RowBox[{"List", " ", "/@", " ", 
            RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}], ",", 
       "\n", "     ", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"AssociationMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "apex", ",", " ", 
              RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
           RowBox[{"List", " ", "/@", " ", 
            RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"triangle", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Keys", "[", "cup", "]"}], ",", " ", 
        RowBox[{"MemberQ", "[", "center", "]"}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"simplex", ",", " ", "value"}], "}"}], " ", "|->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"value", " ", ">", " ", "0"}], ",", " ", 
               "StandardBlue", ",", " ", "StandardRed"}], "]"}], ",", " ", 
             RowBox[{"Polygon", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"positions", ",", " ", "simplex"}], "]"}], "]"}]}], 
            "}"}]}], ",", " ", "cup"}], "]"}], "]"}], ",", " ", "g"}], "]"}], 
     ",", "\n", "   ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"OrderedCochainValue", "[", 
          RowBox[{"cup", ",", " ", "#"}], "]"}], " ", "&"}], ",", " ", 
        RowBox[{"Permutations", "[", "triangle", "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3d08f71e-4e2c-4d0f-9731-ba3e19ef10d5"],

