Cell["\<\
On an increasing tuple the two readings agree, whatever the convention of the \
cochain.\
\>", "ExampleText",ExpressionUUID->"e755f57d-b3ac-4dc5-a25b-35eda5f18515"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"center", " ", "=", " ", 
      RowBox[{"InfraCenter", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"positions", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"apex", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "center", ",", " ", "3"}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cup", " ", "=", " ", 
     RowBox[{"OrderedCochainCup", "[", 
      RowBox[{"g", ",", "\n", "     ", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"AssociationMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "center", ",", " ", 
              RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
           RowBox[{"List", " ", "/@", " ", 
            RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}], ",", 
       "\n", "     ", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"AssociationMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "apex", ",", " ", 
              RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
           RowBox[{"List", " ", "/@", " ", 
            RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"{", 
         RowBox[{"StandardBlue", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Polygon", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"positions", ",", " ", "#"}], "]"}], "]"}], " ", "&"}], 
           " ", "/@", " ", 
           RowBox[{"Keys", "[", "cup", "]"}]}]}], "}"}], "]"}], ",", " ", 
       "g"}], "]"}], ",", "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Keys", "[", "cup", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"OrderedCochainValue", "[", 
          RowBox[{"cup", ",", " ", "#"}], "]"}], " ", "==", " ", 
         RowBox[{"CochainValue", "[", 
          RowBox[{"cup", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"18e563b5-6f00-47f7-bda5-c69571bbe938"],

