Cell["\<\
The cochain carries no graph, so an increasing tuple that spans no clique \
also gives 0. A tuple with a repeated vertex is not increasing:\
\>", "ExampleText",ExpressionUUID->"dbff2c55-fad4-47e2-b07d-46f53c78066c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"FindClique", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", "3", "}"}], ",", " ", "All"}], "]"}], ",", " ", 
         RowBox[{"MemberQ", "[", "c", "]"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"cup", " ", "=", " ", 
     RowBox[{"OrderedCochainCup", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"t", "[", 
          RowBox[{"[", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], "]"}], " ", "->", " ",
          "1"}], "|>"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"t", "[", 
          RowBox[{"[", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "3"}], "}"}], "]"}], "]"}], " ", "->", " ",
          "1"}], "|>"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"OrderedCochainValue", "[", 
      RowBox[{"cup", ",", " ", 
       RowBox[{"Take", "[", 
        RowBox[{
         RowBox[{"Sort", " ", "@", " ", 
          RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", "3"}], "]"}]}], 
      "]"}], ",", " ", 
     RowBox[{"OrderedCochainValue", "[", 
      RowBox[{"cup", ",", " ", 
       RowBox[{"t", "[", 
        RowBox[{"[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1", ",", " ", "2"}], "}"}], "]"}], "]"}]}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"24507f6d-1499-4056-bbd1-7de91d55b49f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{"Missing", "[", 
    RowBox[{"\<\"NonIncreasingTuple\"\>", ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "5", ",", "75"}], "}"}]}], "]"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b88cac46-8979-4532-a2ad-4459652e6816"]
