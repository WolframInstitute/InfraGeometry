Cell["\<\
An increasing tuple that is not stored gives 0. The product of the 1-cochain \
that is 1 on the front edge of a triangle with the one that is 1 on its back \
edge vanishes on every other triangle:\
\>", "ExampleText",ExpressionUUID->"236e3d0c-aa89-4980-896b-e6d68fbf2a0c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"triangles", " ", "=", " ", 
     RowBox[{"Sort", " ", "/@", " ", 
      RowBox[{"FindClique", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", "3", "}"}], ",", " ", "All"}], "]"}]}]}], "}"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{"triangles", ",", " ", 
        RowBox[{"MemberQ", "[", "c", "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"cup", " ", "=", " ", 
     RowBox[{"OrderedCochainCup", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"t", "[", 
          RowBox[{"[", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], "]"}], " ", "->", " ",
          "1"}], "|>"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"t", "[", 
          RowBox[{"[", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "3"}], "}"}], "]"}], "]"}], " ", "->", " ",
          "1"}], "|>"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", "t", "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Counts", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"OrderedCochainValue", "[", 
          RowBox[{"cup", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
        "triangles"}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6990e900-239f-4d64-9b84-79af28fb7f54"],

