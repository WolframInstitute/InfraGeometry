Cell[TextData[{
 "An increasing tuple that is not stored gives 0, not ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Missing"]], "paclet:ref/Missing"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "58701fac-f53c-4641-aa09-be67a497da42"],
 ": a triangle on which the ordered cup vanishes."
}], "ExampleText",ExpressionUUID->"04686568-cb56-471e-863e-bac3f0ca0ad8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"center", " ", "=", " ", 
      RowBox[{"InfraCenter", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"positions", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"apex", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "center", ",", " ", "3"}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cup", " ", "=", " ", 
     RowBox[{"OrderedCochainCup", "[", 
      RowBox[{"g", ",", "\n", "     ", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"AssociationMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "center", ",", " ", 
              RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
           RowBox[{"List", " ", "/@", " ", 
            RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}], ",", 
       "\n", "     ", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"AssociationMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "apex", ",", " ", 
              RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
           RowBox[{"List", " ", "/@", " ", 
            RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"triangle", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"Sort", " ", "/@", " ", 
         RowBox[{"FindClique", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", "3", "}"}], ",", " ", "All"}], "]"}]}], ",", " ", 
        RowBox[{"Keys", "[", "cup", "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"{", 
         RowBox[{"StandardBlue", ",", " ", 
          RowBox[{"Polygon", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"positions", ",", " ", "triangle"}], "]"}], "]"}]}], 
         "}"}], "]"}], ",", " ", "g"}], "]"}], ",", " ", 
     RowBox[{"OrderedCochainValue", "[", 
      RowBox[{"cup", ",", " ", "triangle"}], "]"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"12c67e4c-6c7d-42a8-9971-96422241c7ce"],

