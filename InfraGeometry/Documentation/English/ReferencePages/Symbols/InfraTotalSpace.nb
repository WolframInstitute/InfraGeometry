Cell["InfraTotalSpace", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"93b9de02-6459-4401-854e-6288fa03d5a5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTotalSpace"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTotalSpace", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2c5ab63-4a97-4193-87c0-0ab834ba558d"],
 "\[LineSeparator]",
 "gives the total graph ",
 StyleBox["E", "TI"],
 " of the fibered graph ",
 StyleBox["fib", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"038ca424-7c97-484d-8ac2-f948f34ae929"],

Cell[TextData[{
 "A fibered graph is a graph ",
 StyleBox["E", "TI"],
 " with a projection ",
 StyleBox["\[Pi]", "TI"],
 " from its vertices to the vertices of a base ",
 StyleBox["B", "TI"],
 ". ",
 StyleBox["E", "TI"],
 " is the total graph, and the fiber over ",
 StyleBox["p", "TI"],
 " is the subgraph of ",
 StyleBox["E", "TI"],
 " induced on ",
 StyleBox["\[Pi]\:207b\.b9(p)", "TI"],
 "."
}], "Notes",ExpressionUUID->"974f7053-1607-4cc1-a962-688d56d90f4c"],

Cell[TextData[{
 "An edge of ",
 StyleBox["E", "TI"],
 " is vertical when it lies in one fiber and transverse when it joins two \
fibers. The base is read off ",
 StyleBox["E", "TI"],
 ": ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " are adjacent in ",
 StyleBox["B", "TI"],
 " iff some transverse edge joins the fibers over ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"8afb22ed-fd04-4cce-9655-bd40330062f9"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFiberedGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    ButtonBox["E",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["\[Pi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fbb2187-9bf8-483b-96cb-6931e6480019"],
 " the result is ",
 StyleBox["E", "TI"],
 "; the projection is not checked, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraphQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraphQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "57c6fe9f-e6a1-4c27-b20e-336d30890e6e"],
 " checks it. For ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTangentBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTangentBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e6a36263-76f0-4cf9-9f81-f0993cc708f9"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCotangentBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCotangentBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f4003609-3b1f-4afc-ab2e-40d7c2886967"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDisplacementBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1aa42fd2-e842-47e2-aef9-8422bbee64d3"],
 " the total graph is built from the base on every call; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFiberedGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48bb75f0-12e7-48c9-85e4-1f53bfcb30bc"],
 " builds it once."
}], "Notes",ExpressionUUID->"d7532c98-8933-4e48-b8a6-a97272f4ada1"]
}, Open  ]],

