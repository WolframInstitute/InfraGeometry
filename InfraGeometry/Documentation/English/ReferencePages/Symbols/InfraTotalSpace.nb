Cell["\<\
A random double covering of the 4 \[Times] 4 grid: its total graph and its \
base.\
\>", "ExampleText",ExpressionUUID->"8159e69f-ec60-4b63-b6b3-c0c0cc577cea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", "\n", "    ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Covering\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraTotalSpace", "[", "fib", "]"}], ",", " ", 
      RowBox[{"InfraBaseSpace", "[", "fib", "]"}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"14af2d2d-e6a7-484e-88c0-6650fce07938"],

