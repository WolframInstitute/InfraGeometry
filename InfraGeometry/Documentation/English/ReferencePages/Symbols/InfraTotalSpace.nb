Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Properties & Relations", "ExampleSection",ExpressionUUID->
   "d18b1e1f-4c4c-49a5-bb54-1e5e145ddf4e"],
  $Line = 0; Null]], "ExampleSection",
 CellID->2123667759,ExpressionUUID->"0e0d5f37-f3c9-4474-a22b-9f10dcc8b438"],

Cell["\<\
The number of vertices of the total graph is the sum of the fiber sizes:\
\>", "ExampleText",ExpressionUUID->"a85bac9a-7882-438b-a6b8-a87933d38dbf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"VertexCount", "[", 
      RowBox[{"InfraTotalSpace", "[", "fib", "]"}], "]"}], ",", " ", 
     RowBox[{"Total", "[", 
      RowBox[{"VertexCount", " ", "/@", " ", 
       RowBox[{"InfraFibers", "[", "fib", "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"be6d44d2-e241-49f8-943d-fbea0355e710"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"25", ",", "25"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ca627f38-54cc-4923-981f-907621584cbd"]
}, Open  ]],

Cell["\<\
Projecting the transverse edges of the total graph gives the edges of the \
base:\
\>", "ExampleText",ExpressionUUID->"ef15467a-db96-4175-afdc-2c55b2be023c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", "2"}], ",", "\n", 
       "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"proj", " ", "=", " ", 
     RowBox[{"InfraProjection", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"edges", " ", "=", " ", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"Sort", " ", "/@", " ", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Lookup", "[", 
           RowBox[{"proj", ",", " ", 
            RowBox[{"Key", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
         RowBox[{"List", " ", "@@@", " ", 
          RowBox[{"EdgeList", "[", 
           RowBox[{"InfraTotalSpace", "[", "fib", "]"}], "]"}]}], ",", " ", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{
    RowBox[{"Sort", "[", 
     RowBox[{"Select", "[", 
      RowBox[{"edges", ",", " ", 
       RowBox[{"Apply", "[", "UnsameQ", "]"}]}], "]"}], "]"}], " ", "===", 
    " ", 
    RowBox[{"Sort", "[", 
     RowBox[{"List", " ", "@@@", " ", 
      RowBox[{"EdgeList", "[", 
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"cf848156-170b-49b2-8da7-b0919c954981"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"5c2a77ea-4744-4890-967f-c1686b22080f"]
}, Open  ]]
}, Open  ]],

