Cell["\<\
The total graph of the product double covering is two copies of the base. The \
random covering above is connected:\
\>", "ExampleText",ExpressionUUID->"0955cb5e-8ad5-4a9a-a153-b81e82c88235"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"prod", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GraphProduct", "[", 
        RowBox[{
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
         RowBox[{"Graph", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
           RowBox[{"{", "}"}]}], "]"}], ",", " ", "\"\<Cartesian\>\""}], 
        "]"}], ",", " ", "First"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"twisted", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", "\n", "    ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Covering\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"ConnectedComponents", "[", 
       RowBox[{"InfraTotalSpace", "[", "#", "]"}], "]"}]}], " ", "&"}], " ", "/@",
     " ", 
    RowBox[{"{", 
     RowBox[{"prod", ",", " ", "twisted"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f53e68df-a918-4b8c-b736-236814a86679"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "1"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"c0e9ed03-a968-4a1f-a8aa-93470346b09e"]
}, Open  ]]
}, Open  ]],

