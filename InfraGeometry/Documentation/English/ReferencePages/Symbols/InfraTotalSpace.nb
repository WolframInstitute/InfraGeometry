  "Scope", "ExampleSection",ExpressionUUID->
   "32e79d70-f7af-47ff-bb41-513374ef55db"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1293636265,ExpressionUUID->"6d08f999-4c69-4709-9b28-82906be6ee75"],

Cell["\<\
The total graph of a tangent bundle is built from the base. Its vertices are \
the rays: the 4 \[Times] 4 grid has 104 rays of length 2:\
\>", "ExampleText",ExpressionUUID->"f107b6eb-02ed-4589-b9ad-c17d7e7eb557"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalSpace", "[", 
      RowBox[{"InfraTangentBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"VertexCount", "[", "total", "]"}], ",", " ", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"InfraRays", "[", 
          RowBox[{"g", ",", " ", "#", ",", " ", "2"}], "]"}], "]"}], " ", 
        "&"}], " ", "/@", " ", 
       RowBox[{"VertexList", "[", "g", "]"}]}], "]"}], ",", " ", 
     RowBox[{"EdgeCount", "[", "total", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e007902c-faa2-4908-865a-4b696fd829aa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"104", ",", "104", ",", "520"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b5fddd1f-741a-4903-bef0-b5f563735412"]
}, Open  ]]
}, Open  ]],

