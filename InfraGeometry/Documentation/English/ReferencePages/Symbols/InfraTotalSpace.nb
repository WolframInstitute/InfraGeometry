Cell[BoxData[
 InterpretationBox[Cell[
  "Properties & Relations", "ExampleSection",ExpressionUUID->
   "d18b1e1f-4c4c-49a5-bb54-1e5e145ddf4e"],
  $Line = 0; Null]], "ExampleSection",
 CellID->2123667759,ExpressionUUID->"0e0d5f37-f3c9-4474-a22b-9f10dcc8b438"],

Cell["\<\
The number of vertices of the total graph is the sum of the fiber sizes:\
\>", "ExampleText",ExpressionUUID->"db8c6740-49f7-4256-b949-c05b3fc5db5b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"VertexCount", "[", 
      RowBox[{"InfraTotalSpace", "[", "fib", "]"}], "]"}], ",", " ", 
     RowBox[{"Total", "[", 
      RowBox[{"VertexCount", " ", "/@", " ", 
       RowBox[{"InfraFibers", "[", "fib", "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f9df13c5-0b8a-48b9-b52a-b3aac63e01c2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"25", ",", "25"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c94ed6c2-9787-4e5e-90ca-963693ccd60e"]
}, Open  ]],

Cell["\<\
Projecting the transverse edges of the total graph gives the edges of the \
base:\
\>", "ExampleText",ExpressionUUID->"2b589494-cd27-46be-b03b-914aac162b6b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", "2"}], ",", "\n", 
       "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"proj", " ", "=", " ", 
     RowBox[{"InfraProjection", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"edges", " ", "=", " ", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"Sort", " ", "/@", " ", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Lookup", "[", 
           RowBox[{"proj", ",", " ", 
            RowBox[{"Key", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
         RowBox[{"List", " ", "@@@", " ", 
          RowBox[{"EdgeList", "[", 
           RowBox[{"InfraTotalSpace", "[", "fib", "]"}], "]"}]}], ",", " ", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{
    RowBox[{"Sort", "[", 
     RowBox[{"Select", "[", 
      RowBox[{"edges", ",", " ", 
       RowBox[{"Apply", "[", "UnsameQ", "]"}]}], "]"}], "]"}], " ", "===", 
    " ", 
    RowBox[{"Sort", "[", 
     RowBox[{"List", " ", "@@@", " ", 
      RowBox[{"EdgeList", "[", 
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"06e3a139-5f5d-432e-a3f4-317126c79ef9"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"ddfc5f89-a0bf-422c-98ef-488889e921dc"]
}, Open  ]]
}, Open  ]],

