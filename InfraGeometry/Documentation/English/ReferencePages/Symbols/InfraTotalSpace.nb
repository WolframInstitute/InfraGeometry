Cell[CellGroupData[{
Cell["InfraTotalSpace", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"988f01b3-2b6c-450b-903a-c19b44a748d7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTotalSpace"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTotalSpace", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e42be92f-45c6-417f-b85f-af071fec93fc"],
 "\[LineSeparator]",
 "gives the total graph ",
 StyleBox["E", "TI"],
 " of the fibered graph ",
 StyleBox["fib", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"7b9000ec-9ae8-448e-bc91-5fc056985260"],

Cell[TextData[{
 "A fibered graph is a graph ",
 StyleBox["E", "TI"],
 " with a projection ",
 StyleBox["\[Pi]", "TI"],
 " from its vertices to the vertices of a base ",
 StyleBox["B", "TI"],
 ". ",
 StyleBox["E", "TI"],
 " is the total graph, and the fiber over ",
 StyleBox["p", "TI"],
 " is the subgraph of ",
 StyleBox["E", "TI"],
 " induced on ",
 StyleBox["\[Pi]\:207b\.b9(p)", "TI"],
 "."
}], "Notes",ExpressionUUID->"de0bdb98-59a2-4a7d-b05f-fc0f50d6f591"],

Cell[TextData[{
 "An edge of ",
 StyleBox["E", "TI"],
 " is vertical when it lies in one fiber and transverse when it joins two \
fibers. The base is read off ",
 StyleBox["E", "TI"],
 ": ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " are adjacent in ",
 StyleBox["B", "TI"],
 " iff some transverse edge joins the fibers over ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"9db1ef6c-0018-4961-9e00-7ff650171553"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFiberedGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    ButtonBox["E",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["\[Pi]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c8e215f-3082-4c0f-b217-8daab616f970"],
 " the result is ",
 StyleBox["E", "TI"],
 "; the projection is not checked, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraphQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraphQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "45130636-a67c-4977-a763-c8a4c670d60e"],
 " checks it. For ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTangentBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTangentBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1ebf8b82-6dba-4948-8cea-8c4c7da0d0e8"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCotangentBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCotangentBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f81cd31b-bcda-460a-8777-6569cf2e5bf7"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDisplacementBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8d53dea9-df7a-497a-943e-19000d5fc4bf"],
 " the total graph is built from the base on every call; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFiberedGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86032615-581b-4318-8ddc-4b061bc723c9"],
 " builds it once."
}], "Notes",ExpressionUUID->"8a7d7e84-9f69-4b56-8aa3-a667e684aa1b"],

