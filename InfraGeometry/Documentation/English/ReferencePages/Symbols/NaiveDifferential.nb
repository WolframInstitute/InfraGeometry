Cell["\<\
The germ values of the naive differential against those of the differential \
on the same 1-form, over every pair of neighbours of every vertex: the \
transport term is not a rescaling.\
\>", "ExampleText",ExpressionUUID->"4ff4ccdd-caba-4e88-98ee-34057006dc83"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"form", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"AssociationMap", "[", 
        RowBox[{
         RowBox[{"node", " ", "|->", " ", 
          RowBox[{"AssociationMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"RandomInteger", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], "]"}], " ", "&"}],
             ",", " ", 
            RowBox[{"List", " ", "/@", " ", 
             RowBox[{"AdjacencyList", "[", 
              RowBox[{"g", ",", " ", "node"}], "]"}]}]}], "]"}]}], ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"naive", " ", "=", " ", 
      RowBox[{"NaiveDifferential", "[", 
       RowBox[{"g", ",", " ", "form"}], "]"}]}], ",", " ", 
     RowBox[{"exact", " ", "=", " ", 
      RowBox[{"FormDifferential", "[", 
       RowBox[{"g", ",", " ", "form"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"ListPlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Catenate", " ", "@", " ", 
      RowBox[{"Table", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"FormValue", "[", 
           RowBox[{"naive", ",", " ", "node", ",", " ", "pairOf"}], "]"}], ",",
           " ", 
          RowBox[{"FormValue", "[", 
           RowBox[{"exact", ",", " ", "node", ",", " ", "pairOf"}], "]"}]}], 
         "}"}], ",", "\n", "      ", 
        RowBox[{"{", 
         RowBox[{"node", ",", " ", 
          RowBox[{"VertexList", "[", "g", "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"pairOf", ",", " ", 
          RowBox[{"Subsets", "[", 
           RowBox[{
            RowBox[{"Sort", " ", "@", " ", 
             RowBox[{"AdjacencyList", "[", 
              RowBox[{"g", ",", " ", "node"}], "]"}]}], ",", " ", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], "}"}]}], "]"}]}], ",", "\n", 
     "    ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<d\:2080\[Omega]\>\"", ",", " ", "\"\<d\[Omega]\>\""}], 
       "}"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f4516e9d-f225-47be-8eee-faeec7fb5fbb"],

