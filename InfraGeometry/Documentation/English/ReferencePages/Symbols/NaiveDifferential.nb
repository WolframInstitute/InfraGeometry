Cell["\<\
On a pair of neighbours that are not adjacent the transport term vanishes, \
and the two differentials agree there: on the square tiling, which has no \
triangles, they are equal.\
\>", "ExampleText",ExpressionUUID->"b1d62bd8-b994-4862-9ce1-4b1e3b920e70"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"form", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"AssociationMap", "[", 
        RowBox[{
         RowBox[{"node", " ", "|->", " ", 
          RowBox[{"AssociationMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"RandomInteger", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], "]"}], " ", "&"}],
             ",", " ", 
            RowBox[{"List", " ", "/@", " ", 
             RowBox[{"AdjacencyList", "[", 
              RowBox[{"g", ",", " ", "node"}], "]"}]}]}], "]"}]}], ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{"Catenate", " ", "@*", " ", "Keys", " ", "@*", " ", 
            RowBox[{"Select", "[", "Positive", "]"}]}], ",", " ", "form"}], 
          "]"}], ",", " ", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{"Catenate", " ", "@*", " ", "Keys", " ", "@*", " ", 
            RowBox[{"Select", "[", "Negative", "]"}]}], ",", " ", "form"}], 
          "]"}]}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"KeySort", "[", 
       RowBox[{"KeySort", " ", "/@", " ", 
        RowBox[{"NaiveDifferential", "[", 
         RowBox[{"g", ",", " ", "form"}], "]"}]}], "]"}], " ", "===", " ", 
      RowBox[{"KeySort", "[", 
       RowBox[{"KeySort", " ", "/@", " ", 
        RowBox[{"FormDifferential", "[", 
         RowBox[{"g", ",", " ", "form"}], "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"57235025-3279-4a1f-a1fc-67135a309ae6"],

