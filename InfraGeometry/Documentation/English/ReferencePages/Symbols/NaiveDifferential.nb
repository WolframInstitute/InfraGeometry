Cell["\<\
On a random 1-form on the triangular tiling, the integral of the naive \
differential against the coboundary of the integral, triangle by triangle: a \
line of slope 2/3.\
\>", "ExampleText",ExpressionUUID->"cd0e3d02-194b-482c-be7c-38390a2e4b4a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"form", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"AssociationMap", "[", 
        RowBox[{
         RowBox[{"node", " ", "|->", " ", 
          RowBox[{"AssociationMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"RandomInteger", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], "]"}], " ", "&"}],
             ",", " ", 
            RowBox[{"List", " ", "/@", " ", 
             RowBox[{"AdjacencyList", "[", 
              RowBox[{"g", ",", " ", "node"}], "]"}]}]}], "]"}]}], ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"naive", " ", "=", " ", 
      RowBox[{"IntegrationMap", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"NaiveDifferential", "[", 
         RowBox[{"g", ",", " ", "form"}], "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"exact", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"IntegrationMap", "[", 
         RowBox[{"g", ",", " ", "form"}], "]"}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Values", "[", "exact", "]"}], ",", " ", 
          RowBox[{"Lookup", "[", 
           RowBox[{"naive", ",", " ", 
            RowBox[{"Keys", "[", "exact", "]"}], ",", " ", "0"}], "]"}]}], 
         "}"}], "]"}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Delta](I\[Omega])\>\"", ",", 
          " ", "\"\<I(d\:2080\[Omega])\>\""}], "}"}]}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"Union", "[", 
      RowBox[{
       RowBox[{"Lookup", "[", 
        RowBox[{"naive", ",", " ", 
         RowBox[{"Keys", "[", "exact", "]"}], ",", " ", "0"}], "]"}], " ", "/",
        " ", 
       RowBox[{"Values", "[", "exact", "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"67890bbc-c1b0-46d9-9924-2f414583eb0a"],

