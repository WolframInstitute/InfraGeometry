Notebook[{

Cell[CellGroupData[{
Cell["NaiveDifferential", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"119f8d78-d7ff-44b7-b0d7-fcdce9626f85"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["NaiveDifferential"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/NaiveDifferential", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["\[Omega]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "095dafbe-3a1c-4eb4-9121-fb3abfa1a72b"],
 "\[LineSeparator]",
 "gives the naive differential of the 1-form ",
 StyleBox["\[Omega]", "TI"],
 ", the difference of germ values ",
 StyleBox["\[Omega](v; w\:2081) \[Minus] \[Omega](v; w\:2082)", "TI"],
 " on each pair of neighbours of ",
 StyleBox["v", "TI"],
 ": the form differential with its transport term dropped.",
 "\n"
}], "Usage",ExpressionUUID->"889cd79f-51fb-4eac-82a6-98ea4bf6cde2"],

Cell[TextData[{
 "Definition: the naive differential of a 1-form is ",
 StyleBox["(d\:2080\[Omega])(v; w\:2081, w\:2082) = \[Omega](v; w\:2081) \
\[Minus] \[Omega](v; w\:2082)", "TI"],
 ". In degree ",
 StyleBox["k", "TI"],
 " it is the sum ",
 StyleBox["\[CapitalSigma]\:1d62 (\[Minus]1)\:2071 \[Omega](v; w\:2081, \
\[Ellipsis], \:0175\:1d62, \[Ellipsis], w\:2096\:208a\:2081)", "TI"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FormDifferential"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FormDifferential", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6111d198-bfaa-4f6b-9694-57f9a8c840e4"],
 " without its transport term ",
 StyleBox["(I\[Omega])(w\:2081, \[Ellipsis], w\:2096\:208a\:2081)", "TI"],
 ": it reads only the germ at ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"ce93c8b5-9509-4a51-a1ef-4b3be0d20520"],

Cell[TextData[{
 "Integrating it loses a fixed fraction: ",
 StyleBox["I(d\:2080\[Omega]) = ((k + 1)/(k + 2)) \[Delta](I\[Omega])", 
  "TI"],
 ", two thirds in degree 1, where ",
 StyleBox["I", "TI"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IntegrationMap"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/IntegrationMap", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9db1be75-00dd-4244-948b-910445bf8e52"],
 " and ",
 StyleBox["\[Delta]", "TI"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Coboundary"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Coboundary", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5496ec09-636b-40e6-be38-d4324416ec37"],
 ". Of the ",
 StyleBox["k", "TI"],
 " + 2 faces of a (",
 StyleBox["k", "TI"],
 " + 1)-clique, the germ at a vertex reaches only the ",
 StyleBox["k", "TI"],
 " + 1 that contain the vertex."
}], "Notes",ExpressionUUID->"bee2ee83-4ad4-46e1-9bbc-94349c2ba5e4"],

Cell[TextData[{
 "The transport term is not a multiple of the naive difference: the germ \
values of ",
 StyleBox["d\[Omega]", "TI"],
 " and ",
 StyleBox["d\:2080\[Omega]", "TI"],
 " are not proportional, and only their integrals differ by a factor."
}], "Notes",ExpressionUUID->"05b6d10a-74a3-4499-a022-5b287bfba6ef"],

Cell[TextData[{
 "It is kept for the comparison with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FormDifferential"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FormDifferential", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d7a068a2-1d63-49f3-b392-bf123607f209"],
 "."
}], "Notes",ExpressionUUID->"0221058c-fe1c-4194-b0ba-5b11e4354135"]
}, Open  ]],

