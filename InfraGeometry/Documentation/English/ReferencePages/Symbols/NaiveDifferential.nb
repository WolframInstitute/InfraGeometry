Cell[TextData[{
 "On a 0-form the germs come out empty, with no message: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NaiveDifferential"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/NaiveDifferential", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "37b0e0ad-1fc3-48b8-83b9-ea35be0e97e8"],
 " computes degree 1 only. The naive differential of a 0-form ",
 StyleBox["f", "TI"],
 " would be ",
 StyleBox["\[Minus]f(v)", "TI"],
 " on each step from ",
 StyleBox["v", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"e1b5b6c1-da51-461f-9e1a-4c3e497ecb95"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"form", " ", "=", " ", 
     RowBox[{"ZeroForm", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "#"}], "]"}], 
        " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"First", " ", "/@", " ", "form"}]}], "]"}], ",", " ", 
     RowBox[{"Union", "[", 
      RowBox[{"Length", " ", "/@", " ", 
       RowBox[{"Values", "[", 
        RowBox[{"NaiveDifferential", "[", 
         RowBox[{"g", ",", " ", "form"}], "]"}], "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f5233ebe-37f5-4987-a848-872fea3272a5"],

