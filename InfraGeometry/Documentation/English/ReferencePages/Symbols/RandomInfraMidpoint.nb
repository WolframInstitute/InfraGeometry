Cell["Enumerate the complete point family.", "ExampleText",ExpressionUUID->"7092b815-0f77-43d9-9aee-45339312ad3b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"RandomInfraMidpoint", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"InfraMidpoint", "[", " ", 
       RowBox[{"1", ",", " ", "3"}], " ", "]"}], ",", " ", "All"}], " ", 
     "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fc5f948b-fca2-4755-aa89-57cfb10b3520"],

