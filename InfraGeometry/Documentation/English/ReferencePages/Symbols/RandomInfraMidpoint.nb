  FontSize->0.9 Inherited,ExpressionUUID->
  "99ea5b77-fd84-4655-a64f-ebfc8598f90f"],
 "\[LineSeparator]",
 "samples the central vertices of the oriented segment graph from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1b715d79-dacd-4a0a-888b-bf9602cf7744"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
