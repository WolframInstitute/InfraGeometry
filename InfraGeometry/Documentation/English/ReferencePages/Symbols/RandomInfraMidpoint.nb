length 4:"
}], "ExampleText",ExpressionUUID->"16b4a922-2f49-40cc-b26f-a704e263c486"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"xy", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q", " ", "=", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"p", ",", " ", "4"}], "]"}], ",", " ", 
           RowBox[{"RandomSeeding", " ", "->", " ", "k"}]}], "]"}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{
        RowBox[{"Round", " ", "@", " ", 
         RowBox[{"Sort", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"xy", "[", "q", "]"}], " ", "-", " ", 
            RowBox[{"xy", "[", "p", "]"}]}], "]"}], "]"}]}], " ", "->", " ", 
        RowBox[{"Length", " ", "@", " ", 
         RowBox[{"RandomInfraMidpoint", "[", 
          RowBox[{"g", ",", " ", "p", ",", " ", "q", ",", " ", "All"}], 
          "]"}]}]}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"bdf175f1-a65b-45b3-8aeb-d2a620271170"],

