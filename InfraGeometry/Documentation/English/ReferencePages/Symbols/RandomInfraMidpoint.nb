Cell["\<\
All midpoints of a segment from the centre to a vertex at distance 4, on the \
square grid and on the square mesh:\
\>", "ExampleText",ExpressionUUID->"ff03777a-2e97-4385-a693-3a096a038538"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"p", ",", " ", "4"}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraSegment", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", 
          RowBox[{"RandomInfraMidpoint", "[", 
           RowBox[{"g", ",", " ", "p", ",", " ", "q", ",", " ", "All"}], 
           "]"}], ",", " ", "p", ",", " ", "q"}], "}"}]}], "]"}]}], "]"}], ",",
     "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"1189e183-0d79-4472-8a9c-569fa61b84b5"],

