 RowBox[{"{", 
  RowBox[{"2", ",", "4"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2687c082-800d-4050-ad93-e49e8f6c55ab"]
}, Open  ]],

Cell["Draw and highlight one point.", "ExampleText",ExpressionUUID->"48e6549d-5a35-4629-9024-1af165acae77"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"{", " ", 
     RowBox[{"point", " ", "=", " ", 
      RowBox[{"RandomInfraMidpoint", "[", " ", 
       RowBox[{"graph", ",", " ", 
        RowBox[{"InfraMidpoint", "[", " ", 
         RowBox[{"1", ",", " ", "3"}], " ", "]"}]}], " ", "]"}]}], " ", "}"}],
     ",", "\n", "  ", 
    RowBox[{"InfraSubstrateHighlight", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"{", " ", 
       RowBox[{"<|", " ", 
        RowBox[{"point", " ", "->", " ", "1"}], " ", "|>"}], " ", "}"}]}], 
     " ", "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"589cabca-d743-40b6-8f62-d8cf34db28a3"],

