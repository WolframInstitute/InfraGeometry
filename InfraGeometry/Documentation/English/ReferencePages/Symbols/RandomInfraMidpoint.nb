Cell["Enumerate the complete point family.", "ExampleText",ExpressionUUID->"704f0f7d-1ea4-4eca-a671-d40d38399e5e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"RandomInfraMidpoint", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"InfraMidpoint", "[", " ", 
       RowBox[{"1", ",", " ", "3"}], " ", "]"}], ",", " ", "All"}], " ", 
     "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a34dd276-c6a5-423e-a17a-0b16ba488fc8"],

