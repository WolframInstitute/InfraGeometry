 CellLabel->"Out[1]= ",ExpressionUUID->"0702abfd-0e44-4ac1-95ee-08d0e6ec1745"]
}, Open  ]],

Cell["Draw and highlight one point.", "ExampleText",ExpressionUUID->"c0b92c4d-bb91-4566-a469-1be14795826b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"{", " ", 
     RowBox[{"point", " ", "=", " ", 
      RowBox[{"RandomInfraMidpoint", "[", " ", 
       RowBox[{"graph", ",", " ", 
        RowBox[{"InfraMidpoint", "[", " ", 
         RowBox[{"1", ",", " ", "3"}], " ", "]"}]}], " ", "]"}]}], " ", "}"}],
     ",", "\n", "  ", 
    RowBox[{"InfraSubstrateHighlight", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"{", " ", 
       RowBox[{"<|", " ", 
        RowBox[{"point", " ", "->", " ", "1"}], " ", "|>"}], " ", "}"}]}], 
     " ", "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"da36cb32-f94c-4c88-bd11-5dfef2baeb77"],

Cell[BoxData[
 GraphicsBox[
