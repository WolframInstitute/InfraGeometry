 "\[LineSeparator]",
 "gives a random midpoint of the segment from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5193b103-5cc2-45fa-853c-b5b5d6f48fb7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraMidpoint"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraMidpoint", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "886e250d-543b-4b08-acd6-8f7f506da8ea"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " distinct midpoints.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7b6cadd2-a9e7-458d-84db-382c34de89df"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraMidpoint"]], 
