Cell[TextData[{
 "At even distance ",
 StyleBox["2k", "TI"],
 " the midpoints are the common points of the circles of radius ",
 StyleBox["k", "TI"],
 " about ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"8a06607e-ed14-4e0f-b158-d4423cbf7729"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"p", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "3"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{"RandomInfraMidpoint", "[", 
     RowBox[{"g", ",", " ", "p", ",", " ", "q", ",", " ", "All"}], "]"}], " ",
     "===", "\n", "    ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraIntersection", "[", 
        RowBox[{
         RowBox[{"InfraShell", "[", 
          RowBox[{"p", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"q", ",", " ", "2"}], "]"}]}], "]"}], ",", " ", "All"}], 
      "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d4b4268f-ee50-4d85-b752-9f81ef476f8b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"8f1422e8-b535-4ff1-8495-27d1febdd79d"]
}, Open  ]]
}, Open  ]],

