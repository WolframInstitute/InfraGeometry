Cell["\<\
Two vertices in every fiber over a hexagon, adjacent fibers joined \
completely. A random connection picks one of the two matchings over each base \
edge.\
\>", "ExampleText",ExpressionUUID->"fce06c07-7cb5-426d-8eda-c09a95378c53"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
       RowBox[{"RandomInfraFibration", "[", 
        RowBox[{
         RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
         RowBox[{"\"\<VerticalVertices\>\"", " ", "->", " ", "2"}], ",", " ", 
         
         RowBox[{"\"\<IsomorphicFibers\>\"", " ", "->", " ", "True"}], ",", 
         " ", 
         RowBox[{"\"\<HorizontalEdgesDensity\>\"", " ", "->", " ", "2"}]}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraConnection", "[", "fib", "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"total", ",", " ", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"InfraWalk", " ", "/@", " ", 
          RowBox[{"List", " ", "@@@", " ", 
           RowBox[{"First", " ", "@", " ", "conn"}]}]}], ",", " ", 
         RowBox[{"Directive", "[", "StandardRed", "]"}]}], "]"}]}], "]"}], ",",
      "\n", "    ", 
     RowBox[{"InfraConnectionQ", "[", 
      RowBox[{"fib", ",", " ", "conn"}], "]"}], ",", " ", 
     RowBox[{"InfraHolonomy", "[", 
      RowBox[{"fib", ",", " ", "conn", ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "5", ",", 
         " ", "6", ",", " ", "1"}], "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"dc3763ff-5c89-4013-9196-3a69a8f69f89"],

