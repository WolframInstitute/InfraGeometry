           "]"}]}]}], " ", "]"}], ",", "\n", "      ", 
       RowBox[{"<|", " ", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<q\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<q\>\""}]}], " ", "|>"}]}], "\n", 
      "    ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
