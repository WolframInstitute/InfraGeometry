Cell[TextData[{
 "A complete connection chooses, over every base edge ",
 StyleBox["pq", "TI"],
 ", a perfect matching between the fibers ",
 StyleBox["F\:209a", "TI"],
 " and ",
 StyleBox["F_q", "TI"],
 " made of transverse edges. It moves every vertex of a fiber to a \
neighbouring fiber in exactly one way, so every base walk has one horizontal \
lift from each start."
}], "Notes",ExpressionUUID->"ecdb5f33-49b4-4727-a41b-bc9c5b5831b3"],

Cell[TextData[{
 "A connection exists iff every such matching exists: neighbouring fibers \
have equal size and, by Hall's theorem, every set of vertices of ",
 StyleBox["F\:209a", "TI"],
 " has at least as many neighbours in ",
 StyleBox["F_q", "TI"],
 "."
}], "Notes",ExpressionUUID->"7b2b79a9-b438-4e0a-89bd-5cefcaee2ab3"],

Cell[TextData[{
 "When the fibers over ",
 StyleBox["pq", "TI"],
 " are joined completely and have ",
 StyleBox["k", "TI"],
 " vertices, there are ",
 StyleBox["k!", "TI"],
 " matchings over ",
 StyleBox["pq", "TI"],
 ". A covering has exactly one connection, all its transverse edges."
}], "Notes",ExpressionUUID->"b92caf85-8367-4dfb-9fe8-ef1f10e2d853"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f842c9f0-b3ea-49fb-929e-8661a0697784"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2091366d-3f13-4324-84e2-eee6cacfaeaa"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a02adf0a-8ba3-48e2-bb4a-466206a2d0e1"],
 ". When no connection exists, or fewer than ",
 StyleBox["n", "TI"],
 ", the result is ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cdd8c35b-fe50-4090-973e-bbadcdae6743"],
 ". On an empty base the one connection is ",
 Cell[BoxData[
  RowBox[{"InfraConnection", "[", 
   RowBox[{"{", "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41df7e71-83cf-4768-b041-383b3a9d608e"],
 "."
}], "Notes",ExpressionUUID->"8fc77b18-6f75-499f-a351-460eebc20bc9"],

Cell["The draws are not uniform over the connections.", "Notes",ExpressionUUID->"ad53c296-1b36-4310-be1f-718f962179c7"],

