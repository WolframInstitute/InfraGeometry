Cell[TextData[{
 "Equal fiber sizes and transverse edges at every vertex do not give a \
perfect matching. Two vertices of the fiber over ",
 Cell[BoxData["\"\<p\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74a9da34-1985-4aa6-990e-4e88cef92eed"],
 " share their only neighbour:"
}], "ExampleText",ExpressionUUID->"6e9646ff-16cc-4b90-8188-be4d2c820d6f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"Graph", "[", 
        RowBox[{
         RowBox[{"Range", "[", "6", "]"}], ",", " ", 
         RowBox[{"UndirectedEdge", " ", "@@@", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"3", ",", " ", "5"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"3", ",", " ", "6"}], "}"}]}], "}"}]}]}], "]"}], ",", 
       "\n", "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<q\>\""}], ",", " ", 
         RowBox[{"5", " ", "->", " ", "\"\<q\>\""}], ",", " ", 
         RowBox[{"6", " ", "->", " ", "\"\<q\>\""}]}], "|>"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"RandomInfraConnection", "[", 
       RowBox[{"fib", ",", " ", "All"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"97105ffe-0f9f-423b-96a7-d84fc3e47155"],

