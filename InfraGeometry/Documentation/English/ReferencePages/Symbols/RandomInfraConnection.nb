Cell["\<\
Two vertices per fiber over a hexagon, with complete joins between adjacent \
fibers, admit complete connections.\
\>", "ExampleText",ExpressionUUID->"a5dfcef4-d9a6-4075-9aaa-ab3196cc91b8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "3", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "6", " ", "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "2", " ", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "0", " ", "}"}]}], ",", "\n", "      ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", " ", "\"\<IsomorphicFibers\>\"", " ", "}"}]}], ",", " ", 
       
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}]}], "\n",
       "    ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"connection", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", " ", "fib", " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
      RowBox[{"fib", ",", " ", "connection"}], " ", "]"}], ",", "\n", "    ", 
     
     RowBox[{"InfraConnectionQ", "[", " ", 
      RowBox[{"fib", ",", " ", "connection"}], " ", "]"}], ",", "\n", "    ", 
     
     RowBox[{"InfraHolonomy", "[", " ", 
      RowBox[{"fib", ",", " ", "connection", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{
        "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "5", ",", 
         " ", "6", ",", " ", "1"}], " ", "}"}]}], " ", "]"}]}], " ", "}"}]}], 
  "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cfff9cdf-2784-4fc1-a2fe-252ddc2730dc"],

