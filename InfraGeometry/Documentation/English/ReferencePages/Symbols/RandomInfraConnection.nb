         RowBox[{"fib", ",", " ", "#"}], " ", "]"}], " ", "&"}], " ", "/@", 
       " ", "connections"}], " ", "]"}], ",", "\n", "    ", 
     RowBox[{"Length", " ", "@", " ", "connections"}], ",", " ", 
     RowBox[{"RandomInfraConnection", "[", " ", 
      RowBox[{"fib", ",", " ", "3"}], " ", "]"}]}], " ", "}"}]}], "\n", 
  "]"}]}], "Input",
