Cell["\<\
A covering has one connection: its transverse edges, two over each of the 24 \
edges of the grid:\
\>", "ExampleText",ExpressionUUID->"f1464c34-808f-4da4-bff2-6b2b87358616"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", "\n", "    ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Covering\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"RandomInfraConnection", "[", 
       RowBox[{"fib", ",", " ", "All"}], "]"}]}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"RandomInfraConnection", "[", 
        RowBox[{"fib", ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}]}], ",", 
     "\n", "   ", 
     RowBox[{"2", " ", 
      RowBox[{"EdgeCount", "[", 
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a41932bc-5593-4fe1-8c34-d34285f91c6c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "48", ",", "48"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c8832ac0-1a9c-471a-aeee-3a819cea38cd"]
}, Open  ]],

Cell["\<\
Different connections on the same fibered graph have different holonomies. \
The holonomy around the square 6, 7, 11, 10 for six random connections:\
\>", "ExampleText",ExpressionUUID->"717ce371-855e-4bb6-aa20-4b0d0ab459e7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       "\n", "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraHolonomy", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomInfraConnection", "[", 
        RowBox[{"fib", ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "k"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "6", ",", " ", "7", ",", " ", "11", ",", " ", "10", ",", " ", "6"}], 
