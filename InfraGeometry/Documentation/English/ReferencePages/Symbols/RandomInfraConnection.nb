Cell["\<\
A complete connection chooses a perfect matching between the whole fibers \
over every base edge, using only transverse total edges.\
\>", "Notes",ExpressionUUID->"10205aa9-8e07-4d08-8bb8-0b7c7d536189"],

Cell["\<\
Unequal neighbouring fiber sizes or a perfect-matching obstruction give an \
empty result. An invalid partial matching is never returned as a connection.\
\>", "Notes",ExpressionUUID->"fa007598-a7d0-4312-aa36-bf2cc24b183e"],

Cell[TextData[{
 "Omitted count or Automatic returns one ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "57f079a1-bec5-4ecb-a6ff-be1796154ae3"],
 " directly. An integer ",
 StyleBox["n", "TI"],
 " returns exactly ",
 StyleBox["n", "TI"],
 " distinct connections, or {} on shortage. UpTo[",
 StyleBox["n", "TI"],
 "] returns at most ",
 StyleBox["n", "TI"],
 ". All enumerates the class."
}], "Notes",ExpressionUUID->"4ebecb1a-7574-4e52-962e-ace15b82c7c3"],

Cell[TextData[{
 "On an empty base there is one connection, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraConnection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraConnection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44d102ed-25a8-4dff-a69b-fa8634f4dac9"],
 ". An empty result list means that no member was returned."
}], "Notes",ExpressionUUID->"98f6b278-b448-4623-8017-8cf33713c422"],

Cell[TextData[{
 "The sampler uses the ambient random stream. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5d8298a5-fcbe-4d4e-a429-0cf1d57c0841"],
 " before a call makes it reproducible."
}], "Notes",ExpressionUUID->"ab4a580d-6ab0-49aa-a9ad-575bd3d8940c"],

Cell["\<\
Search processes base edges and source fiber vertices in their graph orders. \
At each step, candidates are unused target vertices whose choice admits a \
completion of that matching. A bounded search stops once it has enough \
members.\
\>", "Notes",ExpressionUUID->"aeb8f2d0-919d-4221-9e18-40ccc1d3719e"],

Cell["\<\
Random candidate order does not give a uniform distribution over completed \
connections.\
\>", "Notes",ExpressionUUID->"058dd77f-2677-4daf-a16b-02419f21dea5"],

