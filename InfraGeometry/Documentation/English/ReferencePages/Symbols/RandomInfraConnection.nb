Cell["\<\
Two vertices per fiber over a hexagon, with complete joins between adjacent \
fibers, admit complete connections.\
\>", "ExampleText",ExpressionUUID->"44cce3b4-61be-40c9-bb4e-e098477dd336"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "3", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFibration", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "6", " ", "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertices\>\"", " ", "->", " ", "2"}], ",", " ", 
       RowBox[{"\"\<VerticalEdges\>\"", " ", "->", " ", "0"}], ",", "\n", 
       "      ", 
       RowBox[{"\"\<IsomorphicFibers\>\"", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgesDensity\>\"", " ", "->", " ", "All"}]}], 
      "\n", "    ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"connection", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", " ", "fib", " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
      RowBox[{"fib", ",", " ", "connection"}], " ", "]"}], ",", "\n", "    ", 
     
     RowBox[{"InfraConnectionQ", "[", " ", 
      RowBox[{"fib", ",", " ", "connection"}], " ", "]"}], ",", "\n", "    ", 
     
     RowBox[{"InfraHolonomy", "[", " ", 
      RowBox[{"fib", ",", " ", "connection", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{
        "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "5", ",", 
         " ", "6", ",", " ", "1"}], " ", "}"}]}], " ", "]"}]}], " ", "}"}]}], 
  "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a0667a53-b930-4c10-a25b-68da68c7b569"],

