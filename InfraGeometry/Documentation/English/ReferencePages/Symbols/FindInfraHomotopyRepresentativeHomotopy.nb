Cell["\<\
The loop around a filled triangle contracts to its base point:\
\>", "ExampleText",ExpressionUUID->"5a840446-4a98-4401-bf76-8daba179c5be"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "3", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Map", "[", 
    RowBox[{"Last", ",", " ", 
     RowBox[{"VertexList", " ", "/@", " ", 
      RowBox[{"FindInfraHomotopyRepresentativeHomotopy", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "1"}], "}"}]}], 
       "]"}]}], ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cadf4fc1-5542-4088-8b2e-b45fd5791355"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "1"}], "}"}], ",", 
   RowBox[{"{", "1", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c28f796e-0253-43e7-b475-bfb607595990"]
}, Open  ]],

