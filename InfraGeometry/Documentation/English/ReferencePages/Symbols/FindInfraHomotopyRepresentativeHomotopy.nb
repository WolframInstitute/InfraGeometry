Cell["\<\
On the grid with the squares filled, the loop around a square shrinks in one \
move:\
\>", "ExampleText",ExpressionUUID->"986af8ce-4554-49a9-8784-d2123a6a1165"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"loop", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", "members"}], ",", " ", 
       RowBox[{"Rest", " ", "@", " ", 
        RowBox[{"Reverse", " ", "@", " ", 
         RowBox[{"Last", " ", "@", " ", "members"}]}]}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"Map", "[", 
    RowBox[{"Last", ",", " ", 
     RowBox[{"VertexList", " ", "/@", " ", 
      RowBox[{"FindInfraHomotopyRepresentativeHomotopy", "[", 
       RowBox[{"g", ",", " ", "loop", ",", " ", 
        RowBox[{"\"\<NullHomotopicCycles\>\"", " ", "->", " ", "4"}], ",", 
        " ", 
        RowBox[{"\"\<MaxLength\>\"", " ", "->", " ", "5"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"069365b4-b9ce-40e7-ad50-7b53508762c5"],

