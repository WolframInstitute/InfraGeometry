Cell["\<\
A walk that is already shortest gives the chain of that walk alone:\
\>", "ExampleText",ExpressionUUID->"10745a32-03a5-4fec-9c7d-5bb7299073b1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Map", "[", 
    RowBox[{"Last", ",", " ", 
     RowBox[{"VertexList", " ", "/@", " ", 
      RowBox[{"FindInfraHomotopyRepresentativeHomotopy", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"AdjacencyList", "[", 
            RowBox[{"g", ",", " ", "c"}], "]"}]}]}], "}"}], ",", " ", 
        RowBox[{"\"\<MaxLength\>\"", " ", "->", " ", "4"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b23e21b8-6468-4c31-8be2-356d56fb8d92"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"45", ",", "35"}], "}"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1268b4c1-88e8-45fe-8f8d-5884e06a8967"]
