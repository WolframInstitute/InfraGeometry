    RowBox[{"Last", ",", " ", 
     RowBox[{"VertexList", " ", "/@", " ", 
      RowBox[{"FindInfraHomotopyRepresentativeHomotopy", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
         "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "1"}], 
         "}"}], ",", "\n", "    ", 
        RowBox[{"\"\<NullHomotopicCycles\>\"", " ", "->", " ", "4"}], ",", 
        " ", 
        RowBox[{"\"\<MaxLength\>\"", " ", "->", " ", "5"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]], "Input",
