Cell[CellGroupData[{
Cell["FindInfraHomotopyRepresentativeHomotopy", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"45a121e2-824b-4a67-8538-d2613f18c294"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraHomotopyRepresentativeHomotopy"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
FindInfraHomotopyRepresentativeHomotopy", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2245cf6a-9073-425d-9b68-d24df83e64f0"],
 "\[LineSeparator]",
 "gives a chain of elementary moves from ",
 StyleBox["walk", "TI"],
 " to a certified shortest walk homotopic to it, as the list of walk graphs \
it passes through.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2c21f7d0-7ab7-42df-81db-c0ca164597c8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraHomotopyRepresentativeHomotopy"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
FindInfraHomotopyRepresentativeHomotopy", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57736e0c-c751-427b-ab52-b4d9c4d430c2"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " chains, one for each shortest walk reached."
}], "Usage",ExpressionUUID->"c11f7a4b-e2b6-4340-82bf-1d93ba2c5ddf"],

Cell[TextData[{
 "The chain consists of moves of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HomotopicQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/HomotopicQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "92818a38-0407-4e46-a0f4-ff3d4126884d"],
 " from ",
 StyleBox["walk", "TI"],
 " to a certified shortest representative from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraHomotopyRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/\
FindInfraHomotopyRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "40772913-ce3e-4d27-8c96-ad796d99794c"],
 ". Its first walk is ",
 StyleBox["walk", "TI"],
 ", its last a representative. The default method does not promise the fewest \
moves."
}], "Notes",ExpressionUUID->"24948d42-d4e3-476c-af75-267bc51a703a"],

Cell[TextData[{
 "Face search obeys ",
 Cell[BoxData["\"\<MaxLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6abfa9d0-bc97-478e-95e7-9d132f43b52c"],
 ", ",
 Cell[BoxData["\"\<MaxMoves\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34e0e695-af2c-4aea-8c41-32e5035f00ec"],
 " and ",
 Cell[BoxData["\"\<MaxStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87ac78f1-e65c-40f6-a30a-bdf3d66536f2"],
 "; exact reduction and free-endpoint constructions can bypass these search \
budgets. A bounded search minimum is not a certificate of global minimality. \
If minimality cannot be certified, the call remains unevaluated."
}], "Notes",ExpressionUUID->"ce0f494a-ce47-486e-9f6d-99be57e4e777"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b53b0b2d-b3bd-44b9-8a00-825afa5189a9"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "172afbbc-60fe-4c4d-9858-e58fc01e8116"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8028e63d-4ef4-4b8a-a6ff-6e2bac067405"],
 ". Without a count the result is one chain. The options are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HomotopicQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/HomotopicQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9262c233-0754-46a4-b7ff-b4c4b8689c5f"],
 ", with ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "Automatic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cee7a9e9-5e2f-4abe-8329-d7a586a95682"],
 " and ",
 Cell[BoxData[
  RowBox[{"\"\<MaxStates\>\"", " ", "->", " ", "1000"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e3598de-7a87-488f-86ca-20edd1375ba5"],
 ". ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a07b0f2-a386-4071-a120-7213b80fbd21"],
 " requires certification that every shortest representative has been found, \
and returns one chain per representative. It does not enumerate every chain \
to each representative. An unresolved completeness question leaves the call \
unevaluated."
}], "Notes",ExpressionUUID->"84035a5f-3cf3-46c4-a759-9b84a3b77ef7"],

Cell[TextData[{
 "An exact integer count requires that many certified shortest \
representatives. A proved shortage gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9231e41c-8ebd-49bd-8514-32700a4c7519"],
 "; an unresolved shortage leaves the call unevaluated."
}], "Notes",ExpressionUUID->"420c678f-4118-4507-8c28-ae595344fa37"]
}, Open  ]],

