Cell["\<\
A loop from the centre around two triangles of the mesh, shrunk to its base \
point in two moves:\
\>", "ExampleText",ExpressionUUID->"e3f0eda3-dc1d-4757-b83d-6b0b4be336d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"loop", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", "members"}], ",", " ", 
       RowBox[{"Rest", " ", "@", " ", 
        RowBox[{"Reverse", " ", "@", " ", 
         RowBox[{"Last", " ", "@", " ", "members"}]}]}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraSubstrateHighlight", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"#", ",", " ", "c"}], "}"}]}], "]"}], " ", "&"}], ",", " ", 
      
      RowBox[{"FindInfraHomotopyRepresentativeHomotopy", "[", 
       RowBox[{"g", ",", " ", "loop", ",", " ", 
        RowBox[{"\"\<MaxLength\>\"", " ", "->", " ", "5"}]}], "]"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"103a9680-fb29-4200-9d6a-1d6f54c30213"],

