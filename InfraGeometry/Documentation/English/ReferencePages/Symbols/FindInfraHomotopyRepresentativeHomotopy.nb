Cell["FindInfraHomotopyRepresentativeHomotopy", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9fcd1f2d-cf9b-41f2-a4c8-34f3c636585a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraHomotopyRepresentativeHomotopy"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
FindInfraHomotopyRepresentativeHomotopy", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ba33086-cdc4-42cb-9953-1f308ee3d2f9"],
 "\[LineSeparator]",
 "gives a chain of elementary moves from ",
 StyleBox["walk", "TI"],
 " to a shortest walk homotopic to it, as the list of walk graphs it passes \
through.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"88c389db-bacf-43c2-a518-f4a15e664847"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraHomotopyRepresentativeHomotopy"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
FindInfraHomotopyRepresentativeHomotopy", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b83d37a4-0b00-4a5f-a29c-4eab2c6126a8"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " chains, one for each shortest walk reached."
}], "Usage",ExpressionUUID->"c2d3c041-ef06-4d4b-87a5-99c7c7a734c6"],

Cell[TextData[{
 "The chain is a shortest chain of the moves of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HomotopicQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/HomotopicQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cd5a6d8d-b37c-494e-bc77-8373e74e9f9c"],
 " from ",
 StyleBox["walk", "TI"],
 " to a walk of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraHomotopyRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/\
FindInfraHomotopyRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ad126937-ac3c-4559-895a-17e9528cc751"],
 ". Its first walk is ",
 StyleBox["walk", "TI"],
 ", its last a representative."
}], "Notes",ExpressionUUID->"daac2d25-5123-4923-b739-16cad8ea163d"],

Cell[TextData[{
 "The search visits every walk of the homotopy class up to ",
 Cell[BoxData["\"\<MaxLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f66337c3-d9b4-4ed9-9632-c0e1197b66b2"],
 " vertices, so a small ",
 Cell[BoxData["\"\<MaxLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93a293a3-5225-4376-a904-09375bc7431c"],
 " keeps it fast."
}], "Notes",ExpressionUUID->"0a06d93b-2122-455c-8690-083922d8fd6e"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d374c735-302a-4e39-8732-1eecb0408774"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c0717b3-ea47-46b7-a3b1-5df92d455ac0"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b92ba224-9569-4417-bca1-8fa3098b880d"],
 ". Without a count the result is one chain. The options are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HomotopicQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/HomotopicQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "efd5d438-fc41-48a8-b1bc-31014c42cc8d"],
 "."
}], "Notes",ExpressionUUID->"da1040b5-d67c-449b-89d8-1d7413b9110b"]
}, Open  ]],

