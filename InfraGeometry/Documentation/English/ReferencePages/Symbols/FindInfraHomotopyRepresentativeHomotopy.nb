Cell["Both moves shorten the walk:", "ExampleText",ExpressionUUID->"321ff1c1-9639-4f32-9861-05580cb652d0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"loop", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", "members"}], ",", " ", 
       RowBox[{"Rest", " ", "@", " ", 
        RowBox[{"Reverse", " ", "@", " ", 
         RowBox[{"Last", " ", "@", " ", "members"}]}]}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"HomotopyMoveTypes", " ", "@", " ", 
    RowBox[{"FindInfraHomotopyRepresentativeHomotopy", "[", 
     RowBox[{"g", ",", " ", "loop", ",", " ", 
      RowBox[{"\"\<MaxLength\>\"", " ", "->", " ", "5"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5a7e5364-c2e0-4880-9b80-46bd0f8eaffa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Contract\"\>", ",", "\<\"Contract\"\>"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"17cff29b-95fb-444d-8f73-7814581c9a48"]
}, Open  ]]
}, Open  ]],

