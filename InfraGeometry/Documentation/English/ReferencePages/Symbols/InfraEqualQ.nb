Cell[CellGroupData[{
Cell["InfraEqualQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"dfd8c8e5-39c6-4be1-960f-8cbd4c10f44e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraEqualQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraEqualQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "377951e5-3b0c-4798-9793-22ad213a9d06"],
 "\[LineSeparator]",
 "tests whether the objects ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " are equal in ",
 StyleBox["g", "TI"],
 ": whether their vertex densities share more mass than they do not.",
 "\n"
}], "Usage",ExpressionUUID->"65fe9e83-c773-46bd-a9cb-d4fc0890a83c"],

Cell[TextData[{
 "An object ",
 StyleBox["A", "TI"],
 " has a vertex density ",
 StyleBox["\[Mu]", "TI"],
 " and an object ",
 StyleBox["B", "TI"],
 " a density ",
 StyleBox["\[Nu]", "TI"],
 ", their ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd8bb878-59a6-4327-a65d-1a4a3a02444c"],
 " in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b61df34c-5ff3-4db1-b7d2-a35004e7701b"],
 ". The common mass is ",
 StyleBox["|A \:2229 B| = \[CapitalSigma] min(\[Mu](v), \[Nu](v))", "TI"],
 ", the total masses are ",
 StyleBox["|A|", "TI"],
 " and ",
 StyleBox["|B|", "TI"],
 ", and ",
 StyleBox["|A \[CapitalDelta] B| = |A| + |B| \[Minus] 2|A \:2229 B|", "TI"],
 "."
}], "Notes",ExpressionUUID->"dc73733a-40de-43b7-8327-046a29ea42ff"],

Cell[TextData[{
 "The default test is ",
 StyleBox["|A \:2229 B| > |A \[CapitalDelta] B|", "TI"],
 ": the weighted Jaccard index ",
 StyleBox["|A \:2229 B| / (|A| + |B| \[Minus] |A \:2229 B|)", "TI"],
 " is more than 1/2."
}], "Notes",ExpressionUUID->"f90e4de7-7cdb-47c1-8d20-f7a46061530f"],

Cell["\<\
Equality of objects on a graph is a matter of degree, and the methods give \
four degrees, from the strictest:\
\>", "Notes",ExpressionUUID->"54a24a3e-b479-4af8-8a07-7f92dcbf85c8"],

