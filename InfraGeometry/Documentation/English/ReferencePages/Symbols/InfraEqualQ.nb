Cell["A segment and its reverse are equal under every method:", "ExampleText",ExpressionUUID->"f5fd6d4f-c97c-4a84-b216-45ffd3492fb3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"m", " ", "->", " ", 
      RowBox[{"InfraEqualQ", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraSegment", "[", 
         RowBox[{"c", ",", " ", "b"}], "]"}], ",", " ", 
        RowBox[{"InfraSegment", "[", 
         RowBox[{"b", ",", " ", "c"}], "]"}], ",", " ", 
        RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Multiset\>\"", ",", " ", "\"\<Set\>\"", ",", 
         " ", "\"\<Diffuse\>\"", ",", " ", "\"\<Overlap\>\""}], "}"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d096718c-ba9b-4bfc-a3fe-3e307003f1e6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
