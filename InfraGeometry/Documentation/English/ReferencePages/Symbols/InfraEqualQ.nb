Cell["\<\
The default test is a weighted Jaccard index above 1/2. Two balls of radius 3 \
whose centres lie 2 apart on the grid:\
\>", "ExampleText",ExpressionUUID->"d00af283-b2bd-4eae-b283-266ed0b71de6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"InfraBall", "[", 
      RowBox[{
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       "3"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{"c", ",", " ", "3"}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "ball", ",", " ", "\"\<VertexDensity\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"common", " ", "=", " ", 
     RowBox[{"Total", " ", "@", " ", 
      RowBox[{"Merge", "[", 
       RowBox[{
        RowBox[{"KeyIntersection", "[", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], ",", " ", "Min"}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"common", " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Total", "[", "a", "]"}], " ", "+", " ", 
        RowBox[{"Total", "[", "b", "]"}], " ", "-", " ", "common"}], ")"}]}], 
     ",", " ", 
     RowBox[{"InfraEqualQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "ball"}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"dd61a188-ad7a-44b8-9b41-30b731b99cc9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["9", "16"], ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"27f4ff67-cc43-4950-833d-790544027223"]
