 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraEqualQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraEqualQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38e04ec7-0249-4fc2-9df0-c5b55d31f91d"],
 "\[LineSeparator]",
 "tests equality of two Infra* wrappers via their diffusion diagrams (vertex \
-> total-occurrence multisets).",
 "\n"
}], "Usage",ExpressionUUID->"0bfd23df-658b-4bdf-b3bd-01515b8c3f4d"],

Cell["Options:", "Notes",ExpressionUUID->"ce424665-a429-4386-a144-d3a8b59845bb"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d8a9b0c3-080c-42dd-be9a-0b32f89ec923"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"abee12bb-29d8-4daa-b3aa-f2fbb2070d97"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"61a26bfa-5bd0-4049-9af5-cad21392477c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3a0c8b3b-893e-4a73-b216-2d1db8a53c34"], Cell[TextData[Cell[BoxData[
    "Method"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d67a7e5b-3da1-41fb-b35a-eb9ecd632f5d"]], "TableText",ExpressionUUID->
     "f8bca211-5bf2-452f-bf97-886ceabd9442"], Cell["\<\
\"Diffuse\" (default; |A cap B| > |A delta B|, equivalently weighted Jaccard \
> 1/2) | \"Overlap\" (at least one common vertex) | \"Set\" (vertex sets \
identical) | \"Multiset\" (diffusion diagrams identical)\
\>", "TableText",ExpressionUUID->"8748cb8b-872f-4ea1-9685-8ebe0ca086da"]}
  }]], "2ColumnTableMod",ExpressionUUID->"8e99a67b-d11c-44ad-a536-\
cab8dbae8ca6"],

