Cell["Method", "ExampleSubsection",ExpressionUUID->"34514dfd-8405-471c-8ced-d571e2627d7b"],

Cell["\<\
A segment and one of its members. They overlap, but the member carries 5 of \
the 20 units of mass of the segment, and the segment covers 8 vertices to the \
member's 5:\
\>", "ExampleText",ExpressionUUID->"85cc8ffe-64b4-4a01-9b0d-0d07edebd7c2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"path", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "b", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"methods", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Multiset\>\"", ",", " ", "\"\<Set\>\"", ",", 
       " ", "\"\<Diffuse\>\"", ",", " ", "\"\<Overlap\>\""}], "}"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraSegment", "[", 
        RowBox[{"c", ",", " ", "b"}], "]"}], ",", " ", "path"}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"InfraEqualQ", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"c", ",", " ", "b"}], "]"}], ",", " ", "path", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
