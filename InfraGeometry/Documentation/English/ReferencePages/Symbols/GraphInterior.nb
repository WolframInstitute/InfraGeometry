Cell["\<\
A subgraph counts only its own edges. The spray of radius 2 about the centre \
of the triangular tiling has no edge within a shell, so its interior is the \
centre alone, green. Read as a vertex set, the ball of radius 2 has the seven \
vertices of the ball of radius 1 inside.\
\>", "ExampleText",ExpressionUUID->"244b5d8c-9cc1-4595-b9a8-f60d198cc550"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"spray", " ", "=", " ", 
     RowBox[{"SprayGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", 
       RowBox[{"\"\<AxisLength\>\"", " ", "->", " ", "2"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"AssociationThread", "[", 
              RowBox[{
               RowBox[{"GraphInterior", "[", 
                RowBox[{"g", ",", " ", "#"}], "]"}], ",", " ", "1"}], "]"}], 
             " ", "->", " ", "StandardGreen"}], ",", " ", 
            RowBox[{
             RowBox[{"AssociationThread", "[", 
              RowBox[{
               RowBox[{"GraphBoundary", "[", 
                RowBox[{"g", ",", " ", "#"}], "]"}], ",", " ", "1"}], "]"}], 
             " ", "->", " ", "StandardBlue"}]}], "}"}]}], "]"}], " ", "&"}], 
       " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"spray", ",", " ", 
         RowBox[{"VertexList", "[", "spray", "]"}]}], "}"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"GraphInterior", "[", 
         RowBox[{"g", ",", " ", "#"}], "]"}], "]"}], " ", "&"}], " ", "/@", 
      " ", 
      RowBox[{"{", 
       RowBox[{"spray", ",", " ", 
        RowBox[{"VertexList", "[", "spray", "]"}]}], "}"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f9d1c72f-c681-4b4c-949e-52bdd22c0dae"],

