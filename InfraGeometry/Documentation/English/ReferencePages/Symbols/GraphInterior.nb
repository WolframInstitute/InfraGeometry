Cell["\<\
The interior of a ring, green, is a thinner ring: the ball of radius 4 less \
the ball of radius 1, its boundary blue.\
\>", "ExampleText",ExpressionUUID->"6c94c71b-aad8-4c52-8b23-04b721bf4460"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"region", " ", "=", " ", 
        RowBox[{"Complement", "[", 
         RowBox[{
          RowBox[{"FindInfraRepresentative", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraBall", "[", 
             RowBox[{
              RowBox[{"First", " ", "@", " ", 
               RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "4"}], 
             "]"}]}], "]"}], ",", " ", 
          RowBox[{"FindInfraRepresentative", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraBall", "[", 
             RowBox[{
              RowBox[{"First", " ", "@", " ", 
               RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "1"}], 
             "]"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphInterior", "[", 
            RowBox[{"g", ",", " ", "region"}], "]"}], " ", "->", " ", 
           "StandardGreen"}], ",", " ", 
          RowBox[{
           RowBox[{"GraphBoundary", "[", 
            RowBox[{"g", ",", " ", "region"}], "]"}], " ", "->", " ", 
           "StandardBlue"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c129eaf7-b479-4fb3-a9b4-30f0ee6bfd16"],

