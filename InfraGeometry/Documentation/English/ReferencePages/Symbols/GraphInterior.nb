 " whose neighbours in ",
 StyleBox["g", "TI"],
 " all lie in ",
 StyleBox["s", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"10488e1d-8c89-460e-b302-77eb770b49b6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
