Cell["\<\
The ball of radius 4 about the centre of the square, hexagonal and triangular \
tilings, and its interior taken again and again: the balls of radius 3, 2, 1 \
and 0. Each is drawn by its boundary, in its own colour.\
\>", "ExampleText",ExpressionUUID->"b9e7c25c-3414-4696-8ea5-32f2d215fc59"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"panels", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "       ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
             RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
            "]"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{"interiors", " ", "=", " ", 
           RowBox[{"NestList", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"GraphInterior", "[", 
               RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], ",", " ", 
             RowBox[{"FindInfraRepresentative", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraBall", "[", 
                RowBox[{
                 RowBox[{"First", " ", "@", " ", 
                  RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "4"}], 
                "]"}]}], "]"}], ",", " ", "4"}], "]"}]}], "}"}], ",", "\n", 
         "       ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraSubstrateHighlight", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"AssociationThread", "[", 
                RowBox[{
                 RowBox[{"GraphBoundary", "[", 
                  RowBox[{"g", ",", " ", "#"}], "]"}], ",", " ", "1"}], "]"}],
                " ", "&"}], " ", "/@", " ", "interiors"}]}], "]"}], ",", " ", 
           
           RowBox[{"Length", " ", "/@", " ", "interiors"}]}], "}"}]}], "]"}], 
       ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
           " ", "\"\<HexagonalTilingGraph\>\"", ",", 
           " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"First", " ", "/@", " ", "panels"}], "]"}], ",", " ", 
     RowBox[{"Last", " ", "/@", " ", "panels"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3909152f-0bf2-4f90-b42a-323d1e7d19d1"],

