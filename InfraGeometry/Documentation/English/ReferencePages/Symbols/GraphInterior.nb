Cell[TextData[{
 "The whole vertex set is its own interior: the rim of a substrate is no \
boundary in this sense. It is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphExteriorBoundary"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/GraphExteriorBoundary", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "33304544-b267-4225-9017-ac882431542a"],
 ", blue."
}], "ExampleText",ExpressionUUID->"5ced524b-5954-4e72-808f-aa6e1ee4b141"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"GraphExteriorBoundary", "[", "g", "]"}], " ", "->", " ", 
         "StandardBlue"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"GraphInterior", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}], "]"}], " ", "===", 
      " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"VertexList", "[", "g", "]"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"187653c5-90a0-4bfe-a33e-9e4f189a7f79"],

