Cell[TextData[{
 "The whole vertex set is its own interior: the rim of a substrate is no \
boundary in this sense. It is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphExteriorBoundary"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/GraphExteriorBoundary", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5a793ad4-0131-4631-8060-c6fc1d37291e"],
 ", blue."
}], "ExampleText",ExpressionUUID->"f5c985c8-a052-4330-b3dc-77bbc1d730a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"GraphExteriorBoundary", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"Method", " ", "->", " ", "\"\<MaxDegree\>\""}]}], "]"}], 
         " ", "->", " ", "StandardBlue"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"GraphInterior", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}], "]"}], " ", "===", 
      " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"VertexList", "[", "g", "]"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"66d0c567-9248-485a-9a95-1fb1773c8ef7"],

