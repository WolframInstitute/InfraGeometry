Cell["\<\
A subgraph counts only its own edges. The spray of radius 2 about the centre \
of the triangular tiling has no edge within a shell, so its interior is the \
centre alone, green. Read as a vertex set, the ball of radius 2 has the seven \
vertices of the ball of radius 1 inside.\
\>", "ExampleText",ExpressionUUID->"e751db99-78db-491b-a037-1b70447327fb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"spray", " ", "=", " ", 
     RowBox[{"SprayGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", 
       RowBox[{"\"\<AxisLength\>\"", " ", "->", " ", "2"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"AssociationThread", "[", 
              RowBox[{
               RowBox[{"GraphInterior", "[", 
                RowBox[{"g", ",", " ", "#"}], "]"}], ",", " ", "1"}], "]"}], 
             " ", "->", " ", "StandardGreen"}], ",", " ", 
            RowBox[{
             RowBox[{"AssociationThread", "[", 
              RowBox[{
               RowBox[{"GraphBoundary", "[", 
                RowBox[{"g", ",", " ", "#"}], "]"}], ",", " ", "1"}], "]"}], 
             " ", "->", " ", "StandardBlue"}]}], "}"}]}], "]"}], " ", "&"}], 
       " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"spray", ",", " ", 
         RowBox[{"VertexList", "[", "spray", "]"}]}], "}"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"GraphInterior", "[", 
         RowBox[{"g", ",", " ", "#"}], "]"}], "]"}], " ", "&"}], " ", "/@", 
      " ", 
      RowBox[{"{", 
       RowBox[{"spray", ",", " ", 
        RowBox[{"VertexList", "[", "spray", "]"}]}], "}"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"51d4ebaf-42a6-4139-8336-7c66b3203f4c"],

