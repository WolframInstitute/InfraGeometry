Cell["\<\
The interior and the boundary split the set: they are disjoint, and together \
they are the set.\
\>", "ExampleText",ExpressionUUID->"d270d201-7a6f-4693-99b0-fc33cfbf8d71"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"region", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
           RowBox[{"FindInfraPoint", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraShell", "[", 
              RowBox[{
               RowBox[{"First", " ", "@", " ", 
                RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "3"}], 
              "]"}]}], "]"}]}], ")"}], ",", " ", "4"}], "]"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"GraphInterior", "[", 
           RowBox[{"g", ",", " ", "region"}], "]"}], " ", "->", " ", 
          "StandardGreen"}], ",", " ", 
         RowBox[{
          RowBox[{"GraphBoundary", "[", 
           RowBox[{"g", ",", " ", "region"}], "]"}], " ", "->", " ", 
          "StandardBlue"}]}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Intersection", "[", 
      RowBox[{
       RowBox[{"GraphInterior", "[", 
        RowBox[{"g", ",", " ", "region"}], "]"}], ",", " ", 
       RowBox[{"GraphBoundary", "[", 
        RowBox[{"g", ",", " ", "region"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"GraphInterior", "[", 
          RowBox[{"g", ",", " ", "region"}], "]"}], ",", " ", 
         RowBox[{"GraphBoundary", "[", 
          RowBox[{"g", ",", " ", "region"}], "]"}]}], "]"}], "]"}], " ", "===",
       " ", 
      RowBox[{"Sort", "[", "region", "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"58d722cd-6f15-4948-9af5-350f13ba4a6c"],

