Cell[BoxData[
 InterpretationBox[Cell[
  "Possible Issues", "ExampleSection",ExpressionUUID->
   "dda06a82-eb41-4b48-8510-6cb821647761"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell["\<\
Where the graph ends, the interior of a ball is more than the smaller ball. \
The interior of the ball of radius 6 about a neighbour of the centre of the \
square tiling is the ball of radius 5, green, and the 11 vertices at distance \
6 that lie on the rim, orange: they have no neighbour outside the ball. The \
boundary, blue, lies on the far side only.\
\>", "ExampleText",ExpressionUUID->"53bae8e5-a8d9-476e-abe6-db1ff88bd94f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"offCentre", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"AdjacencyList", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"region", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{"offCentre", ",", " ", "6"}], "]"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"extra", " ", "=", " ", 
     RowBox[{"Complement", "[", 
      RowBox[{
       RowBox[{"GraphInterior", "[", 
        RowBox[{"g", ",", " ", "region"}], "]"}], ",", " ", 
       RowBox[{"FindInfraRepresentative", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{"offCentre", ",", " ", "5"}], "]"}]}], "]"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"AssociationThread", "[", 
           RowBox[{
            RowBox[{"FindInfraRepresentative", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraBall", "[", 
               RowBox[{"offCentre", ",", " ", "5"}], "]"}]}], "]"}], ",", " ",
             "1"}], "]"}], " ", "->", " ", "StandardGreen"}], ",", " ", 
         RowBox[{
          RowBox[{"AssociationThread", "[", 
           RowBox[{"extra", ",", " ", "1"}], "]"}], " ", "->", " ", 
          "StandardOrange"}], ",", " ", 
         RowBox[{
          RowBox[{"AssociationThread", "[", 
           RowBox[{
            RowBox[{"GraphBoundary", "[", 
             RowBox[{"g", ",", " ", "region"}], "]"}], ",", " ", "1"}], "]"}],
           " ", "->", " ", "StandardBlue"}]}], "}"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"Length", "[", "extra", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8a43a7b4-403f-4166-9470-b43d01034fa8"],

