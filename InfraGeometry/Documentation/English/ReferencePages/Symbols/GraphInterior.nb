Cell["\<\
The interior and the boundary split the set: they are disjoint, and together \
they are the set.\
\>", "ExampleText",ExpressionUUID->"592eae4c-762c-40b5-9e4e-c5de61e8efd0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"region", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
           RowBox[{"RandomInfraPoint", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "3"}], "]"}]}],
           ")"}], ",", " ", "4"}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"GraphInterior", "[", 
           RowBox[{"g", ",", " ", "region"}], "]"}], " ", "->", " ", 
          "StandardGreen"}], ",", " ", 
         RowBox[{
          RowBox[{"GraphBoundary", "[", 
           RowBox[{"g", ",", " ", "region"}], "]"}], " ", "->", " ", 
          "StandardBlue"}]}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Intersection", "[", 
      RowBox[{
       RowBox[{"GraphInterior", "[", 
        RowBox[{"g", ",", " ", "region"}], "]"}], ",", " ", 
       RowBox[{"GraphBoundary", "[", 
        RowBox[{"g", ",", " ", "region"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"GraphInterior", "[", 
          RowBox[{"g", ",", " ", "region"}], "]"}], ",", " ", 
         RowBox[{"GraphBoundary", "[", 
          RowBox[{"g", ",", " ", "region"}], "]"}]}], "]"}], "]"}], " ", "===",
       " ", 
      RowBox[{"Sort", "[", "region", "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f967a1f1-2e7d-4d2e-b30b-0ae607206a9a"],

