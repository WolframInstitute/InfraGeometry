Cell["\<\
The interior of a ring, green, is a thinner ring: the ball of radius 4 less \
the ball of radius 1, its boundary blue.\
\>", "ExampleText",ExpressionUUID->"c60b43b4-d402-46ed-a228-4d3f2dff035a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"region", " ", "=", " ", 
        RowBox[{"Complement", "[", 
         RowBox[{
          RowBox[{"FindInfraRepresentative", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraBall", "[", 
             RowBox[{
              RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "4"}], 
             "]"}]}], "]"}], ",", " ", 
          RowBox[{"FindInfraRepresentative", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraBall", "[", 
             RowBox[{
              RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "1"}], 
             "]"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphInterior", "[", 
            RowBox[{"g", ",", " ", "region"}], "]"}], " ", "->", " ", 
           "StandardGreen"}], ",", " ", 
          RowBox[{
