Cell["\<\
The ball of radius 4 about the centre of the square, hexagonal and triangular \
tilings, and its interior taken again and again: the balls of radius 3, 2, 1 \
and 0. Each is drawn by its boundary, in its own colour.\
\>", "ExampleText",ExpressionUUID->"81a9c5c0-0daa-48a9-b51f-98010bf31ed1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"panels", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "       ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
             RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
            "]"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{"interiors", " ", "=", " ", 
           RowBox[{"NestList", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"GraphInterior", "[", 
               RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], ",", " ", 
             RowBox[{"FindInfraRepresentative", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraBall", "[", 
                RowBox[{
                 RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "4"}], 
                "]"}]}], "]"}], ",", " ", "4"}], "]"}]}], "}"}], ",", "\n", 
         "       ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraSubstrateHighlight", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"AssociationThread", "[", 
                RowBox[{
                 RowBox[{"GraphBoundary", "[", 
                  RowBox[{"g", ",", " ", "#"}], "]"}], ",", " ", "1"}], "]"}],
                " ", "&"}], " ", "/@", " ", "interiors"}]}], "]"}], ",", " ", 
           
           RowBox[{"Length", " ", "/@", " ", "interiors"}]}], "}"}]}], "]"}], 
       ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
           " ", "\"\<HexagonalTilingGraph\>\"", ",", 
           " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"First", " ", "/@", " ", "panels"}], "]"}], ",", " ", 
     RowBox[{"Last", " ", "/@", " ", "panels"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b2fc52b7-9b1b-400c-ba3d-63ad75e6bcb4"],

