Cell["\<\
The smallest open set containing a ball about the centre that reaches within \
two steps of the rim, at radius 2, on the discretized plane, the square \
tiling and the hexagonal tiling. The ball is green. The neighbourhood adds \
the red vertices near the rim, whose balls lie inside the balls of the ball's \
vertices.\
\>", "ExampleText",ExpressionUUID->"437fc9fc-ec55-4418-83aa-9939f44d3564"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"region", " ", "=", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{
             RowBox[{"VertexEccentricity", "[", 
              RowBox[{"g", ",", " ", "c"}], "]"}], " ", "-", " ", "2"}]}], 
           "]"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"open", " ", "=", " ", 
        RowBox[{"TopologicalNeighborhood", "[", 
         RowBox[{
          RowBox[{"BallTopology", "[", 
           RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", "region"}], "]"}]}],
        "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"region", " ", "->", " ", "StandardGreen"}], ",", " ", 
          RowBox[{
           RowBox[{"Complement", "[", 
            RowBox[{"open", ",", " ", "region"}], "]"}], " ", "->", " ", 
           "StandardRed"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a1558818-c064-4005-a491-8dea3c0fc26f"],

