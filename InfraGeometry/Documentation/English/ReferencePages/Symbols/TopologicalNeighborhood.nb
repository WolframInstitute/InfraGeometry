Cell["\<\
The neighbourhood is open, its own interior. It is the closure in the dual \
topology, the reversed digraph.\
\>", "ExampleText",ExpressionUUID->"c7129d69-cdcf-451f-b238-2ac333648f44"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"topo", " ", "=", " ", 
     RowBox[{"BallTopology", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "4"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"open", " ", "=", " ", 
     RowBox[{"TopologicalNeighborhood", "[", 
      RowBox[{"topo", ",", " ", "ball"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ball", " ", "->", " ", "StandardGreen"}], ",", " ", 
         RowBox[{
          RowBox[{"Complement", "[", 
           RowBox[{"open", ",", " ", "ball"}], "]"}], " ", "->", " ", 
          "StandardRed"}]}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"TopologicalInterior", "[", 
       RowBox[{"topo", ",", " ", "open"}], "]"}], " ", "==", " ", "open"}], ",",
      "\n", "   ", 
     RowBox[{"open", " ", "==", " ", 
      RowBox[{"TopologicalClosure", "[", 
       RowBox[{
        RowBox[{"BallTopology", "[", 
         RowBox[{"g", ",", " ", "2", ",", " ", 
          RowBox[{"\"\<Dual\>\"", " ", "->", " ", "True"}]}], "]"}], ",", " ",
         "ball"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2f6efcc8-070f-45bb-8a35-b4e4ff9b3484"],

