Cell[CellGroupData[{
Cell["TopologicalNeighborhood", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"96bdad3d-89b5-4549-9274-41101ffcaa8e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TopologicalNeighborhood"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TopologicalNeighborhood", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["topo", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd95d453-8f30-4812-862e-7c56b59f7d69"],
 "\[LineSeparator]",
 "gives the smallest open set that contains the vertex list ",
 StyleBox["s", "TI"],
 " in the topology of the digraph ",
 StyleBox["topo", "TI"],
 ": the vertices that directed paths from ",
 StyleBox["s", "TI"],
 " reach.",
 "\n"
}], "Usage",ExpressionUUID->"51790386-50d3-47fd-b4e3-803665029eb2"],

Cell[TextData[{
 "In a finite topology the intersection of all open sets containing ",
 StyleBox["s", "TI"],
 " is open. It is the up-set ",
 StyleBox["U(s) = {q : p \[LessEqual] q for some p in s}", "TI"],
 ", with ",
 StyleBox["\[LessEqual]", "TI"],
 " the preorder of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologicalClosure"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TopologicalClosure", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f0c1e31b-5224-40bd-ade2-3b761517880b"],
 "."
}], "Notes",ExpressionUUID->"e77cb1dc-b11d-49f6-bf82-86eee936b5bd"],

Cell[TextData[{
 "In ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallTopology"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallTopology", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2351d6d-d2c4-4015-ae49-9a5008d70214"],
 " the smallest open set of a vertex is ",
 StyleBox["U(p) = {q : B\:1d63(q) \[SubsetEqual] B\:1d63(p)}", "TI"],
 ", the vertices whose ball lies inside the ball at ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"44e2080b-be4d-4caf-808f-c6ca7d097099"],

Cell[TextData[{
 "A set is open when it is its own smallest open neighbourhood. The \
neighbourhood in ",
 StyleBox["topo", "TI"],
 " is the closure in the reversed digraph, the dual topology."
}], "Notes",ExpressionUUID->"fc58dd8d-1808-4592-91e4-bfb865f2cd1b"],

Cell["\<\
On a patch of the grid a vertex far from the rim is open: its smallest \
neighbourhood is the vertex alone.\
\>", "Notes",ExpressionUUID->"bc16e071-b77e-4b57-b9c0-22885a645615"],

Cell["The result is a sorted vertex list.", "Notes",ExpressionUUID->"4da0a54a-33a8-44b2-88f5-eac51b2b9dc1"]
}, Open  ]],

