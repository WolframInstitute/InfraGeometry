Cell["\<\
On a binary tree, a child of the root is an open point at radii 1 and 2. At \
radius 3 its ball holds the ball of every vertex below it, and its smallest \
open neighbourhood is its whole branch.\
\>", "ExampleText",ExpressionUUID->"5a2c1c4d-fdcd-4f25-807f-a68f061934ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"KaryTree", "[", "31", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"3", " ", "->", " ", "StandardBlue"}], ",", " ", 
          RowBox[{
           RowBox[{"Complement", "[", 
            RowBox[{
             RowBox[{"TopologicalNeighborhood", "[", 
              RowBox[{
               RowBox[{"BallTopology", "[", 
                RowBox[{"g", ",", " ", "r"}], "]"}], ",", " ", 
               RowBox[{"{", "3", "}"}]}], "]"}], ",", " ", 
             RowBox[{"{", "3", "}"}]}], "]"}], " ", "->", " ", 
           "StandardRed"}]}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"265962dc-6a5b-41b0-9ed8-1d5236ad3526"],

