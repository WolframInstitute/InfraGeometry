Cell[CellGroupData[{
Cell["TopologicalNeighborhood", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2d70f0ab-94dc-412a-a901-ae3642c709f1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TopologicalNeighborhood"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TopologicalNeighborhood", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["topo", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d7d94f5-9e60-4c1a-9e21-6fe1146d35f9"],
 "\[LineSeparator]",
 "gives the smallest open set containing the vertex list ",
 StyleBox["s", "TI"],
 " in the topology of the digraph ",
 StyleBox["topo", "TI"],
 ": the vertices that directed paths from ",
 StyleBox["s", "TI"],
 " reach.",
 "\n"
}], "Usage",ExpressionUUID->"6e2720af-ffca-4234-9d04-fe4bdd692bde"],

Cell[TextData[{
 "Definition: in a finite topology the intersection of all open sets \
containing ",
 StyleBox["s", "TI"],
 " is open. It is the up-set of ",
 StyleBox["s", "TI"],
 ": ",
 StyleBox["s", "TI"],
 " and every vertex ",
 StyleBox["q", "TI"],
 " with a directed path from a vertex of ",
 StyleBox["s", "TI"],
 " to ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"5e8bf522-579d-4952-b9f3-d5c15d2ac5a3"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallTopology"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallTopology", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55326fdd-1d04-4907-b11f-258b9449aee1"],
 " it is the set of vertices whose ball lies inside the ball of a vertex of \
",
 StyleBox["s", "TI"],
 "."
}], "Notes",ExpressionUUID->"e1120c9d-30e5-4f28-9776-cac1dc0c5262"],

Cell[TextData[{
 "A set is open when it equals its neighbourhood. The neighbourhood in ",
 StyleBox["topo", "TI"],
 " is the closure in the reversed digraph, the dual topology."
}], "Notes",ExpressionUUID->"61fe59dc-c198-4943-af54-3aa481341554"],

Cell["The result is a sorted vertex list.", "Notes",ExpressionUUID->"f2151dc5-0ed1-4c0b-b58b-6b4e8a027826"]
}, Open  ]],

