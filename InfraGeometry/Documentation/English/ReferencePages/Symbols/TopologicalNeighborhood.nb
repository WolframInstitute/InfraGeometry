Cell["\<\
The smallest open set containing a ball about the centre that reaches within \
two steps of the rim, at radius 2, on the discretized plane, the square \
tiling and the hexagonal tiling. The ball is green. The neighbourhood adds \
the red vertices near the rim, whose balls lie inside the balls of the ball's \
vertices.\
\>", "ExampleText",ExpressionUUID->"afe8490b-3e2a-4353-8e59-95a03ce4dc3c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"region", " ", "=", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{
             RowBox[{"VertexEccentricity", "[", 
              RowBox[{"g", ",", " ", "c"}], "]"}], " ", "-", " ", "2"}]}], 
           "]"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"open", " ", "=", " ", 
        RowBox[{"TopologicalNeighborhood", "[", 
         RowBox[{
          RowBox[{"BallTopology", "[", 
           RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", "region"}], "]"}]}],
        "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"region", " ", "->", " ", "StandardGreen"}], ",", " ", 
          RowBox[{
           RowBox[{"Complement", "[", 
            RowBox[{"open", ",", " ", "region"}], "]"}], " ", "->", " ", 
           "StandardRed"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ff3dc8cf-8369-4e9e-98c1-91978de1fd61"],

