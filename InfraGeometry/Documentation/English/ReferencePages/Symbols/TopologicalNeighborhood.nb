Cell["\<\
A corner of the inner square of the small grid, at radii 1 to 4. At radius 1 \
its smallest open set holds the two vertices of degree 1 next to it; from \
radius 2 on, also the next two vertices of degree 1 along the rim:\
\>", "ExampleText",ExpressionUUID->"40bd8a6e-c899-4811-83ac-9a8025d8a4e6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"AdjacencyList", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"VertexDegree", "[", 
              RowBox[{"g", ",", " ", "#"}], "]"}], " ", "==", " ", "1"}], " ",
             "&"}]}], "]"}]}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"TopologicalNeighborhood", "[", 
           RowBox[{
            RowBox[{"BallTopology", "[", 
             RowBox[{"g", ",", " ", "r"}], "]"}], ",", " ", 
            RowBox[{"{", "v", "}"}]}], "]"}], ",", " ", "v"}], "}"}], ",", 
        " ", 
        RowBox[{"PlotLabel", " ", "->", " ", "r"}]}], "]"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "1", ",", " ", "4"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"90c8b03e-1360-4e9d-b7ab-d31183209485"],

