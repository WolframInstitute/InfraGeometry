Cell[CellGroupData[{
Cell["TopologicalNeighborhood", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4a892a6a-ad9f-41ba-a2a2-c3ef04bfd538"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TopologicalNeighborhood"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TopologicalNeighborhood", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["topo", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "568099ce-b0db-4fc4-8832-05afbbe7cc87"],
 "\[LineSeparator]",
 "gives the smallest open set containing the vertex list ",
 StyleBox["s", "TI"],
 " in the topology of the digraph ",
 StyleBox["topo", "TI"],
 ": the vertices that directed paths from ",
 StyleBox["s", "TI"],
 " reach.",
 "\n"
}], "Usage",ExpressionUUID->"5c7df4c1-c230-4cfa-b9df-9c1357f4473b"],

Cell[TextData[{
 "Definition: in a finite topology the intersection of all open sets \
containing ",
 StyleBox["s", "TI"],
 " is open. It is the up-set of ",
 StyleBox["s", "TI"],
 ": ",
 StyleBox["s", "TI"],
 " and every vertex ",
 StyleBox["q", "TI"],
 " with a directed path from a vertex of ",
 StyleBox["s", "TI"],
 " to ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"d68e15ca-b6e6-44f6-843e-3ca7abb0338b"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallTopology"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallTopology", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87b2becc-5771-4a3e-92e1-e1e99b26db56"],
 " it is the set of vertices whose ball lies inside the ball of a vertex of \
",
 StyleBox["s", "TI"],
 "."
}], "Notes",ExpressionUUID->"65164470-2311-4621-847c-a800ad716253"],

Cell[TextData[{
 "A set is open when it equals its neighbourhood. The neighbourhood in ",
 StyleBox["topo", "TI"],
 " is the closure in the reversed digraph, the dual topology."
}], "Notes",ExpressionUUID->"3b8d5938-a712-4448-8faf-c4df322296a0"],

Cell["The result is a sorted vertex list.", "Notes",ExpressionUUID->"250e4821-0ef8-4bc6-917e-4ecd2355e56e"]
}, Open  ]],

