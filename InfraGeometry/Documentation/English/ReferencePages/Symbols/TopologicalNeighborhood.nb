Cell["\<\
On a binary tree, a child of the root is an open point at radii 1 and 2. At \
radius 3 its ball holds the ball of every vertex below it, and its smallest \
open neighbourhood is its whole branch.\
\>", "ExampleText",ExpressionUUID->"a08bd109-3a22-44ea-a927-13f125919162"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"KaryTree", "[", "31", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"3", " ", "->", " ", "StandardBlue"}], ",", " ", 
          RowBox[{
           RowBox[{"Complement", "[", 
            RowBox[{
             RowBox[{"TopologicalNeighborhood", "[", 
              RowBox[{
               RowBox[{"BallTopology", "[", 
                RowBox[{"g", ",", " ", "r"}], "]"}], ",", " ", 
               RowBox[{"{", "3", "}"}]}], "]"}], ",", " ", 
             RowBox[{"{", "3", "}"}]}], "]"}], " ", "->", " ", 
           "StandardRed"}]}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"61fe3d10-f303-4f51-91b9-b7e780ad1a20"],

