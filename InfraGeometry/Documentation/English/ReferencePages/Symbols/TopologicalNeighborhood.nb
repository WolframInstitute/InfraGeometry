Cell["\<\
The smallest open set that contains a ball about the centre coming within two \
steps of the rim, at radius 2, on the square grid and on the square mesh. It \
adds the vertices near the rim whose balls lie inside the balls of vertices \
of the ball:\
\>", "ExampleText",ExpressionUUID->"1147427e-a4db-4a60-bf13-916efee66010"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Medium\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"ball", " ", "=", " ", 
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraBall", "[", 
            RowBox[{"c", ",", " ", 
             RowBox[{
              RowBox[{"VertexEccentricity", "[", 
               RowBox[{"g", ",", " ", "c"}], "]"}], " ", "-", " ", "2"}]}], 
            "]"}], ",", " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"TopologicalNeighborhood", "[", 
           RowBox[{
            RowBox[{"BallTopology", "[", 
             RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", "ball"}], "]"}], ",",
           " ", "ball"}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"586947f7-3db1-4f3a-8d1c-32911bc852c8"],

