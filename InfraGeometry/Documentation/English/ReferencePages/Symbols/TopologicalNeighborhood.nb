Cell["\<\
The neighbourhood is open, its own interior. It is the closure in the dual \
topology, the reversed digraph.\
\>", "ExampleText",ExpressionUUID->"79593f3b-eefc-4d64-95d6-461b7623f410"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"topo", " ", "=", " ", 
     RowBox[{"BallTopology", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{
         RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "4"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"open", " ", "=", " ", 
     RowBox[{"TopologicalNeighborhood", "[", 
      RowBox[{"topo", ",", " ", "ball"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ball", " ", "->", " ", "StandardGreen"}], ",", " ", 
         RowBox[{
          RowBox[{"Complement", "[", 
           RowBox[{"open", ",", " ", "ball"}], "]"}], " ", "->", " ", 
          "StandardRed"}]}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"TopologicalInterior", "[", 
       RowBox[{"topo", ",", " ", "open"}], "]"}], " ", "==", " ", "open"}], ",",
      "\n", "   ", 
     RowBox[{"open", " ", "==", " ", 
      RowBox[{"TopologicalClosure", "[", 
       RowBox[{
        RowBox[{"BallTopology", "[", 
         RowBox[{"g", ",", " ", "2", ",", " ", 
          RowBox[{"\"\<Dual\>\"", " ", "->", " ", "True"}]}], "]"}], ",", " ",
         "ball"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c2a6b124-6e00-4e9e-9bb4-78161248d63f"],

