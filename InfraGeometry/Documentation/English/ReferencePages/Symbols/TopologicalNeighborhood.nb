Cell["\<\
The neighbourhood is open, its own interior. It is the closure in the dual \
topology:\
\>", "ExampleText",ExpressionUUID->"68e4ea48-6e5f-4082-a795-9746a419fb12"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"topo", " ", "=", " ", 
     RowBox[{"BallTopology", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "8"}], "]"}], ",",
         " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"open", " ", "=", " ", 
     RowBox[{"TopologicalNeighborhood", "[", 
      RowBox[{"topo", ",", " ", "ball"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"TopologicalInterior", "[", 
       RowBox[{"topo", ",", " ", "open"}], "]"}], " ", "===", " ", "open"}], ",",
      " ", 
     RowBox[{"open", " ", "===", " ", 
      RowBox[{"TopologicalClosure", "[", 
       RowBox[{
        RowBox[{"BallTopology", "[", 
         RowBox[{"g", ",", " ", "2", ",", " ", 
          RowBox[{"\"\<Dual\>\"", " ", "->", " ", "True"}]}], "]"}], ",", " ",
         "ball"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e53222dd-5d8d-4420-a85c-8ca74f4ed2e3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"80883122-acf8-44a5-a87f-d9851a1d457a"]
}, Open  ]],

Cell["\<\
Away from the rim a vertex is open. The centre of the grid is its own \
smallest neighbourhood up to radius 4:\
\>", "ExampleText",ExpressionUUID->"fb7422ac-15ec-42be-bde0-1fc537fe8e88"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"TopologicalNeighborhood", "[", 
      RowBox[{
       RowBox[{"BallTopology", "[", 
        RowBox[{"g", ",", " ", "r"}], "]"}], ",", " ", 
       RowBox[{"{", "c", "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "1", ",", " ", "4"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2ff92774-2f13-4bb7-975e-0a63243b54f6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "45", "}"}], ",", 
   RowBox[{"{", "45", "}"}], ",", 
   RowBox[{"{", "45", "}"}], ",", 
   RowBox[{"{", "45", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"88dcee08-2950-4647-bdbc-757afd77ad16"]
}, Open  ]]
}, Open  ]],

