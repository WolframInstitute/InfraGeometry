  $Line = 0; Null]], "ExampleSection",
 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell["\<\
The identity needs cocycles. A random 1-cochain, whose coboundary is drawn on \
its triangles, is not closed, and with it the coboundary of the cup-1 is not \
the graded commutator.\
\>", "ExampleText",ExpressionUUID->"44ca40a6-6e33-4023-9ca1-abe828f555c9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"positions", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"cochain", " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"RandomInteger", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], "]"}], " ", "&"}], ",",
           " ", 
          RowBox[{"Sort", " ", "/@", " ", 
           RowBox[{"List", " ", "@@@", " ", 
            RowBox[{"EdgeList", "[", "g", "]"}]}]}]}], "]"}]}], ")"}]}], ",", 
     "\n", "   ", 
     RowBox[{"fromCenter", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"First", " ", "@", " ", 
              RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", 
             RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
          
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"KeyValueMap", "[", "\n", "     ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"triangle", ",", " ", "value"}], "}"}], " ", "|->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"value", " ", ">", " ", "0"}], ",", " ", 
               "StandardBlue", ",", " ", "StandardRed"}], "]"}], ",", " ", 
             RowBox[{"Polygon", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"positions", ",", " ", "triangle"}], "]"}], "]"}]}], 
            "}"}]}], ",", "\n", "     ", 
          RowBox[{"Coboundary", "[", 
           RowBox[{"g", ",", " ", "cochain"}], "]"}]}], "]"}], "]"}], ",", 
       " ", "g"}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"KeySort", "[", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"CochainCupOne", "[", 
          RowBox[{"g", ",", " ", "cochain", ",", " ", "fromCenter"}], "]"}]}],
         "]"}], "]"}], " ", "===", "\n", "     ", 
      RowBox[{"KeySort", "[", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"Merge", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"OrderedCochainCup", "[", 
              RowBox[{"g", ",", " ", "cochain", ",", " ", "fromCenter"}], 
              "]"}], ",", " ", 
             RowBox[{"OrderedCochainCup", "[", 
              RowBox[{"g", ",", " ", "fromCenter", ",", " ", "cochain"}], 
              "]"}]}], "}"}], ",", " ", "Total"}], "]"}], ",", " ", "0"}], 
        "]"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0540c3c2-17f7-42d5-91ff-ea4c80462431"],

