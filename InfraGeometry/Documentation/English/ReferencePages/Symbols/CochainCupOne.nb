Notebook[{

Cell[CellGroupData[{
Cell["CochainCupOne", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d656a3a8-f09b-4ebe-9e30-d49e4dce4ea5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CochainCupOne"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/CochainCupOne", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["\[Alpha]", "TR"], ",", " ", 
    StyleBox["\[Beta]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d7c16b6-d7ee-473e-87a6-6cbdb19a79da"],
 "\[LineSeparator]",
 "gives Steenrod's cup-1 product ",
 StyleBox["\[Alpha] \:222a\:2081 \[Beta]", "TI"],
 " of the ordered cochains ",
 StyleBox["\[Alpha]", "TI"],
 " and ",
 StyleBox["\[Beta]", "TI"],
 ", of degree ",
 StyleBox["p", "TI"],
 " + ",
 StyleBox["q", "TI"],
 " \[Minus] 1; for cocycles its coboundary is the graded commutator of the \
ordered cup.",
 "\n"
}], "Usage",ExpressionUUID->"e33c5068-b5fa-44bb-abfa-21066a97b33b"],

Cell[TextData[{
 "Definition: for ",
 StyleBox["\[Alpha]", "TI"],
 " of degree ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["\[Beta]", "TI"],
 " of degree ",
 StyleBox["q", "TI"],
 ", with ",
 StyleBox["n", "TI"],
 " = ",
 StyleBox["p", "TI"],
 " + ",
 StyleBox["q", "TI"],
 ", on each increasing tuple ",
 StyleBox["v\:2080 < \[Ellipsis] < v\:2099\:208b\:2081", "TI"],
 " of a clique, ",
 StyleBox["(\[Alpha] \:222a\:2081 \[Beta])(v\:2080, \[Ellipsis], \
v\:2099\:208b\:2081) = \[CapitalSigma]\:1d62 (\[Minus]1)^((p \[Minus] i)(q + \
1) + p + q + 1) \[Alpha](v\:2080, \[Ellipsis], v\:1d62, v\:2c7c, \[Ellipsis], \
v\:2099\:208b\:2081) \[Beta](v\:1d62, \[Ellipsis], v\:2c7c)", "TI"],
 ", the sum over ",
 StyleBox["i", "TI"],
 " = 0, \[Ellipsis], ",
 StyleBox["p", "TI"],
 " \[Minus] 1 with ",
 StyleBox["j", "TI"],
 " = ",
 StyleBox["i", "TI"],
 " + ",
 StyleBox["q", "TI"],
 ": ",
 StyleBox["\[Beta]", "TI"],
 " reads the ",
 StyleBox["q", "TI"],
 " + 1 consecutive vertices from ",
 StyleBox["v\:1d62", "TI"],
 ", and ",
 StyleBox["\[Alpha]", "TI"],
 " the others together with ",
 StyleBox["v\:1d62", "TI"],
 " and ",
 StyleBox["v\:2c7c", "TI"],
 "."
}], "Notes",ExpressionUUID->"800cd986-7d28-4bec-a487-4e20cfed9921"],

Cell[TextData[{
 "Steenrod's theorem, in the signs of this formula: for cocycles ",
 StyleBox["\[Alpha]", "TI"],
 " and ",
 StyleBox["\[Beta]", "TI"],
 ", ",
 StyleBox["\[Delta](\[Alpha] \:222a\:2081 \[Beta]) = \[Alpha] \:222a \[Beta] \
\[Minus] (\[Minus]1)^(pq) \[Beta] \:222a \[Alpha]", "TI"],
 ", with \:222a the ordered cup ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrderedCochainCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "90e35084-b46f-4ce3-b933-86130fb31f0a"],
 " and ",
 StyleBox["\[Delta]", "TI"],
 " the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Coboundary"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Coboundary", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6ddf0909-3557-4461-b8be-28fd06c64046"],
 ". So the ordered cup is graded-commutative up to an explicit coboundary. \
The sign matters: on a triangulated torus the plain difference of the ordered \
cups of the two generators of the first cohomology is not exact."
}], "Notes",ExpressionUUID->"f14c76fc-602d-4982-9ac4-4c5c41fcee98"],

Cell[TextData[{
 "It vanishes when ",
 StyleBox["\[Alpha]", "TI"],
 " has degree 0. For two 1-cochains it is minus their product, ",
 StyleBox["(\[Alpha] \:222a\:2081 \[Beta])(v\:2080, v\:2081) = \[Minus]\
\[Alpha](v\:2080, v\:2081) \[Beta](v\:2080, v\:2081)", "TI"],
 "."
}], "Notes",ExpressionUUID->"63b16323-646d-4f21-a477-845858257815"],

Cell[TextData[{
 "The result is an ordered cochain: read it with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrderedCochainValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b2cc9720-1025-4715-ade3-3e834b0819e4"],
 ". The cup ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "63c2bfe4-f93d-4166-a7c0-53ed50a63cc9"],
 " needs no such primitive, being graded-commutative."
}], "Notes",ExpressionUUID->"635d83cd-2a41-4628-813a-609351eea347"],

Cell[TextData[{
 "Reference: N. E. Steenrod, Products of cocycles and extensions of mappings, \
",
 StyleBox["Annals of Mathematics", "TI"],
 " 48 (1947), 290\[Dash]320."
}], "Notes",ExpressionUUID->"6cbccd71-339a-4165-a8a3-f3ae7129fc3c"]
}, Open  ]],

