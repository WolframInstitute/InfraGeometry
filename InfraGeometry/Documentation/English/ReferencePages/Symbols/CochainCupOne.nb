Cell[TextData[{
 "Steenrod's identity in the degrees ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 " = 1, 2, 3 on the complete graph on six vertices, for the coboundaries of \
random cochains:"
}], "ExampleText",ExpressionUUID->"2063a8be-93e8-49bc-aa7a-61d319fe31a8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CompleteGraph", "[", "6", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"cocycle", " ", "=", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "s"}], "}"}], " ", "|->", " ", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", "\n", "     ", 
         RowBox[{"AssociationThread", "[", 
          RowBox[{
           RowBox[{"Subsets", "[", 
            RowBox[{
             RowBox[{"Range", "[", "6", "]"}], ",", " ", 
             RowBox[{"{", "k", "}"}]}], "]"}], ",", " ", 
           RowBox[{"BlockRandom", "[", 
            RowBox[{
             RowBox[{"RandomInteger", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", " ", 
               RowBox[{"Binomial", "[", 
                RowBox[{"6", ",", " ", "k"}], "]"}]}], "]"}], ",", " ", 
             RowBox[{"RandomSeeding", " ", "->", " ", "s"}]}], "]"}]}], 
          "]"}]}], "]"}]}]}], ",", "\n", "   ", 
     RowBox[{"identity", " ", "=", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "e", ",", " ", "sign"}], "}"}], " ", "|->", 
       " ", 
       RowBox[{
        RowBox[{"KeySort", " ", "@", " ", 
         RowBox[{"Coboundary", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"CochainCupOne", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "e"}], "]"}]}], "]"}]}], 
        " ", "===", "\n", "     ", 
        RowBox[{"KeySort", " ", "@", " ", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"Merge", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"OrderedCochainCup", "[", 
                RowBox[{"g", ",", " ", "a", ",", " ", "e"}], "]"}], ",", " ", 
               
               RowBox[{
                RowBox[{"-", "sign"}], " ", 
                RowBox[{"OrderedCochainCup", "[", 
                 RowBox[{"g", ",", " ", "e", ",", " ", "a"}], "]"}]}]}], 
              "}"}], ",", " ", "Total"}], "]"}], ",", " ", "0"}], 
          "]"}]}]}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"identity", "[", 
      RowBox[{
       RowBox[{"cocycle", "[", 
        RowBox[{"p", ",", " ", "1"}], "]"}], ",", " ", 
       RowBox[{"cocycle", "[", 
        RowBox[{"q", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"p", " ", "q"}], ")"}]}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"q", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7da46ed8-855f-44dc-98c2-494788b95272"],

