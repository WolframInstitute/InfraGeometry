Cell[CellGroupData[{
Cell["CochainCupOne", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bafae21f-cbe0-4480-b52c-21b37969aac5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CochainCupOne"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/CochainCupOne", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["\[Alpha]", "TR"], ",", " ", 
    StyleBox["\[Beta]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42ef1709-50ca-466f-95ef-7e32cd63bc40"],
 "\[LineSeparator]",
 "gives Steenrod's cup-1 product ",
 StyleBox["\[Alpha] \:222a\:2081 \[Beta]", "TI"],
 " of the ordered cochains ",
 StyleBox["\[Alpha]", "TI"],
 " and ",
 StyleBox["\[Beta]", "TI"],
 ", a cochain of degree ",
 StyleBox["p", "TI"],
 " + ",
 StyleBox["q", "TI"],
 " \[Minus] 1.",
 "\n"
}], "Usage",ExpressionUUID->"a9bd451c-6360-4e8b-8b9b-5ee2be01c8d1"],

Cell[TextData[{
 "For ",
 StyleBox["\[Alpha]", "TI"],
 " of degree ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["\[Beta]", "TI"],
 " of degree ",
 StyleBox["q", "TI"],
 ", with ",
 StyleBox["n", "TI"],
 " = ",
 StyleBox["p", "TI"],
 " + ",
 StyleBox["q", "TI"],
 ", on each increasing tuple ",
 StyleBox["v\:2080 < \[Ellipsis] < v\:2099\:208b\:2081", "TI"],
 " of a clique, ",
 StyleBox["(\[Alpha] \:222a\:2081 \[Beta])(v\:2080, \[Ellipsis], \
v\:2099\:208b\:2081) = \[CapitalSigma]\:1d62 \[CurlyEpsilon]\:1d62 \[Alpha](v\
\:2080, \[Ellipsis], v\:1d62, v\:2c7c, \[Ellipsis], v\:2099\:208b\:2081) \
\[Beta](v\:1d62, \[Ellipsis], v\:2c7c)", "TI"],
 ", the sum over ",
 StyleBox["i", "TI"],
 " = 0, \[Ellipsis], ",
 StyleBox["p", "TI"],
 " \[Minus] 1 with ",
 StyleBox["j", "TI"],
 " = ",
 StyleBox["i", "TI"],
 " + ",
 StyleBox["q", "TI"],
 ". The sign ",
 StyleBox["\[CurlyEpsilon]\:1d62", "TI"],
 " is \[Minus]1 to the power ",
 StyleBox["(p \[Minus] i)(q + 1) + p + q + 1", "TI"],
 "."
}], "Notes",ExpressionUUID->"c61093d3-3bba-434b-9705-f454ce4c7ec2"],

Cell[TextData[{
 "Steenrod's identity: for cocycles ",
 StyleBox["\[Alpha]", "TI"],
 " and ",
 StyleBox["\[Beta]", "TI"],
 ", ",
 StyleBox["\[Delta](\[Alpha] \:222a\:2081 \[Beta]) = \[Alpha] \:222a \[Beta] \
\[Minus] \[Beta] \:222a \[Alpha]", "TI"],
 ", with a plus sign when ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " are both odd. Here \:222a is the ordered cup ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrderedCochainCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "708ce7d7-08ce-4d61-9c95-5b6f00d19974"],
 ". So the ordered cup is graded-commutative up to an explicit coboundary."
}], "Notes",ExpressionUUID->"df32a854-362b-41d4-8b0e-e0e5e3b70103"],

Cell[TextData[{
 "The cup-1 is 0 when ",
 StyleBox["\[Alpha]", "TI"],
 " has degree 0. For two 1-cochains it is minus their product, ",
 StyleBox["(\[Alpha] \:222a\:2081 \[Beta])(u, v) = \[Minus]\[Alpha](u, v) \
\[Beta](u, v)", "TI"],
 "."
}], "Notes",ExpressionUUID->"eaed9f72-b709-457e-8532-3db73850bd25"],

Cell[TextData[{
 "The result is an ordered cochain: read it with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrderedCochainValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "16235d21-daa2-4813-8156-faf3f29f3af7"],
 "."
}], "Notes",ExpressionUUID->"c0188c21-233e-418b-a612-fc186a038475"],

Cell[TextData[{
 "Reference: N. E. Steenrod, Products of cocycles and extensions of mappings, \
",
 StyleBox["Annals of Mathematics", "TI"],
 " 48 (1947), 290\[Dash]320."
}], "Notes",ExpressionUUID->"5d135173-b231-4079-8798-7faa089bf0fa"]
}, Open  ]],

