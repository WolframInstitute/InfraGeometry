Cell["\<\
The cup-1 vanishes when the first factor has degree 0: the distance from the \
centre against the coboundary of the distance from a vertex three steps away.\
\
\>", "ExampleText",ExpressionUUID->"ee78cf20-a786-49ed-9335-270acae23db9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"center", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"apex", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"center", ",", " ", "3"}], "]"}]}], "]"}]}], ")"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"values", " ", "=", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", "center", ",", " ", 
          RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
       RowBox[{"List", " ", "/@", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"KeyMap", "[", 
        RowBox[{"First", ",", " ", "values"}], "]"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"CochainCupOne", "[", 
       RowBox[{"g", ",", " ", "values", ",", " ", 
        RowBox[{"Coboundary", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"AssociationMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", "apex", ",", " ", 
               RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", 
            " ", 
            RowBox[{"List", " ", "/@", " ", 
             RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4e041499-bac8-4f1e-be78-23087642f624"],

