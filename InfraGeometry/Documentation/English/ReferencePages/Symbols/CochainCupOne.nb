Cell["\<\
The cup-1 vanishes when the first factor has degree 0: the distance from the \
centre against the coboundary of the distance from a vertex three steps away.\
\
\>", "ExampleText",ExpressionUUID->"b90d118f-f0a6-409a-8bb8-3cbc04d5a945"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"center", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"apex", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "center", ",", " ", "3"}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"values", " ", "=", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", "center", ",", " ", 
          RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
       RowBox[{"List", " ", "/@", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"KeyMap", "[", 
        RowBox[{"First", ",", " ", "values"}], "]"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"CochainCupOne", "[", 
       RowBox[{"g", ",", " ", "values", ",", " ", 
        RowBox[{"Coboundary", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"AssociationMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", "apex", ",", " ", 
               RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", 
            " ", 
            RowBox[{"List", " ", "/@", " ", 
             RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9cc42212-c1e9-4c1a-8ffe-7ba72a9716c6"],

