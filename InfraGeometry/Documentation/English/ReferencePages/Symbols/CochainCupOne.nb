Notebook[{

Cell[CellGroupData[{
Cell["CochainCupOne", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e1edc6bc-4ca4-4414-9970-11a72d976838"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CochainCupOne"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/CochainCupOne", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["\[Alpha]", "TR"], ",", " ", 
    StyleBox["\[Beta]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca2bbe46-17d6-4d62-8bc9-2daca8b5f3ce"],
 "\[LineSeparator]",
 "gives Steenrod's cup-1 product ",
 StyleBox["\[Alpha] \:222a\:2081 \[Beta]", "TI"],
 " of the ordered cochains ",
 StyleBox["\[Alpha]", "TI"],
 " and ",
 StyleBox["\[Beta]", "TI"],
 ", of degree ",
 StyleBox["p", "TI"],
 " + ",
 StyleBox["q", "TI"],
 " \[Minus] 1; for cocycles its coboundary is the graded commutator of the \
ordered cup.",
 "\n"
}], "Usage",ExpressionUUID->"280eace6-6512-405e-9158-faa7f6fc7b18"],

Cell[TextData[{
 "Definition: for ",
 StyleBox["\[Alpha]", "TI"],
 " of degree ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["\[Beta]", "TI"],
 " of degree ",
 StyleBox["q", "TI"],
 ", with ",
 StyleBox["n", "TI"],
 " = ",
 StyleBox["p", "TI"],
 " + ",
 StyleBox["q", "TI"],
 ", on each increasing tuple ",
 StyleBox["v\:2080 < \[Ellipsis] < v\:2099\:208b\:2081", "TI"],
 " of a clique, ",
 StyleBox["(\[Alpha] \:222a\:2081 \[Beta])(v\:2080, \[Ellipsis], \
v\:2099\:208b\:2081) = \[CapitalSigma]\:1d62 (\[Minus]1)^((p \[Minus] i)(q + \
1) + p + q + 1) \[Alpha](v\:2080, \[Ellipsis], v\:1d62, v\:2c7c, \[Ellipsis], \
v\:2099\:208b\:2081) \[Beta](v\:1d62, \[Ellipsis], v\:2c7c)", "TI"],
 ", the sum over ",
 StyleBox["i", "TI"],
 " = 0, \[Ellipsis], ",
 StyleBox["p", "TI"],
 " \[Minus] 1 with ",
 StyleBox["j", "TI"],
 " = ",
 StyleBox["i", "TI"],
 " + ",
 StyleBox["q", "TI"],
 ": ",
 StyleBox["\[Beta]", "TI"],
 " reads the ",
 StyleBox["q", "TI"],
 " + 1 consecutive vertices from ",
 StyleBox["v\:1d62", "TI"],
 ", and ",
 StyleBox["\[Alpha]", "TI"],
 " the others together with ",
 StyleBox["v\:1d62", "TI"],
 " and ",
 StyleBox["v\:2c7c", "TI"],
 "."
}], "Notes",ExpressionUUID->"7806f2d8-d770-462b-acb0-8f37ee7416ec"],

Cell[TextData[{
 "Steenrod's theorem, in the signs of this formula: for cocycles ",
 StyleBox["\[Alpha]", "TI"],
 " and ",
 StyleBox["\[Beta]", "TI"],
 ", ",
 StyleBox["\[Delta](\[Alpha] \:222a\:2081 \[Beta]) = \[Alpha] \:222a \[Beta] \
\[Minus] (\[Minus]1)^(pq) \[Beta] \:222a \[Alpha]", "TI"],
 ", with \:222a the ordered cup ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrderedCochainCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5612fd25-0907-49a6-bc96-97aa02e84e58"],
 " and ",
 StyleBox["\[Delta]", "TI"],
 " the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Coboundary"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/Coboundary", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7e9328ec-8686-4997-8ea1-2693b0a1c5f3"],
 ". So the ordered cup is graded-commutative up to an explicit coboundary. \
The sign matters: on a triangulated torus the plain difference of the ordered \
cups of the two generators of the first cohomology is not exact."
}], "Notes",ExpressionUUID->"c04d7b63-4fd8-40af-b34f-244b8ee1e1b8"],

Cell[TextData[{
 "It vanishes when ",
 StyleBox["\[Alpha]", "TI"],
 " has degree 0. For two 1-cochains it is minus their product, ",
 StyleBox["(\[Alpha] \:222a\:2081 \[Beta])(v\:2080, v\:2081) = \[Minus]\
\[Alpha](v\:2080, v\:2081) \[Beta](v\:2080, v\:2081)", "TI"],
 "."
}], "Notes",ExpressionUUID->"a5f46c9d-4d39-4f38-8e17-534dfcc5e9e0"],

Cell[TextData[{
 "The result is an ordered cochain: read it with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrderedCochainValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cd410ff2-ac5e-4d3e-8afe-9bad69e84bd2"],
 ". The cup ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f92b37a1-4519-4448-aa72-d4b1bcd71bf1"],
 " needs no such primitive, being graded-commutative."
}], "Notes",ExpressionUUID->"b2dda26e-e994-4ce8-aaeb-88af17e5defa"],

Cell[TextData[{
 "Reference: N. E. Steenrod, Products of cocycles and extensions of mappings, \
",
 StyleBox["Annals of Mathematics", "TI"],
 " 48 (1947), 290\[Dash]320."
}], "Notes",ExpressionUUID->"954b72ae-6c5d-409b-890f-b169bc5796ed"]
}, Open  ]],

