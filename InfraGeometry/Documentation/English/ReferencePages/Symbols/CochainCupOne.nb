Cell["The cup-1 is 0 when the first factor has degree 0:", "ExampleText",ExpressionUUID->"4c88614d-ef22-4d44-a596-c98942567be9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"List", " ", "/@", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"CochainCupOne", "[", 
    RowBox[{"g", ",", " ", "f", ",", " ", 
     RowBox[{"Coboundary", "[", 
      RowBox[{"g", ",", " ", "f"}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7f8a9083-c349-4dc8-99ab-8e2791aafca0"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"fcc79a0a-3e9b-4e58-b48d-8a431ab43163"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Possible Issues", "ExampleSection",ExpressionUUID->
   "dda06a82-eb41-4b48-8510-6cb821647761"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell["\<\
The identity needs cocycles. A random 1-cochain on the mesh has a nonzero \
coboundary, and the identity fails:\
\>", "ExampleText",ExpressionUUID->"609d0460-564f-4038-9c91-80f90cd704d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"edges", " ", "=", " ", 
     RowBox[{"Sort", " ", "/@", " ", 
      RowBox[{"List", " ", "@@@", " ", 
       RowBox[{"EdgeList", "[", "g", "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"edges", ",", " ", 
        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"RandomInteger", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", " ", 
            RowBox[{"Length", "[", "edges", "]"}]}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}]}], 
     ",", "\n", "   ", 
     RowBox[{"e", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"commutator", " ", "=", " ", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{"Merge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"OrderedCochainCup", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "e"}], "]"}], ",", " ", 
           RowBox[{"OrderedCochainCup", "[", 
            RowBox[{"g", ",", " ", "e", ",", " ", "a"}], "]"}]}], "}"}], ",", 
         " ", "Total"}], "]"}], ",", " ", "0"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", "a"}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"CochainCupOne", "[", 
          RowBox[{"g", ",", " ", "a", ",", " ", "e"}], "]"}]}], "]"}]}], " ", 
      "===", " ", 
      RowBox[{"KeySort", " ", "@", " ", "commutator"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e340daa4-7479-46fd-891a-2a732385bcd4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"146", ",", "False"}], "}"}]], "Output",
