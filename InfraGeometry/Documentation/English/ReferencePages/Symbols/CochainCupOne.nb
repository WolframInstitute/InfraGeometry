Cell["\<\
For two 1-cochains the cup-1 is minus their product, edge by edge. The \
coboundaries of the distances from the centre and from a vertex at distance 4 \
on the square grid:\
\>", "ExampleText",ExpressionUUID->"b4d1cd50-cc2b-44bc-ada2-4c0918481f3c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c"}], "]"}]}], "]"}]}], "]"}]}], ",", "\n",
      "   ", 
     RowBox[{"e", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "b"}], "]"}]}], "]"}]}], "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{
    RowBox[{"KeySort", " ", "@", " ", 
     RowBox[{"CochainCupOne", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "e"}], "]"}]}], " ", "===", " ", 
    RowBox[{"KeySort", " ", "@", " ", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "a"}], " ", "e"}], ",", " ", "0"}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7b77e822-d5f7-4dcf-a947-d0fd6b9c5f9d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9d1b1b6b-3668-4332-8e89-f3718474b2d8"]
}, Open  ]],

Cell["\<\
Steenrod's identity on the square mesh, for the same two cocycles: the \
coboundary of their cup-1 is the sum of their ordered cups in both orders, \
drawn on the triangles, blue where it is positive on the sorted corners and \
red where it is negative:\
\>", "ExampleText",ExpressionUUID->"5ea62cbd-b7bc-4755-a0d2-f3c61b351bc9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"pos", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c"}], "]"}]}], "]"}]}], "]"}]}], ",", "\n",
      "   ", 
     RowBox[{"e", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "b"}], "]"}]}], "]"}]}], "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"commutator", " ", "=", " ", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{"Merge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"OrderedCochainCup", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "e"}], "]"}], ",", " ", 
           RowBox[{"OrderedCochainCup", "[", 
            RowBox[{"g", ",", " ", "e", ",", " ", "a"}], "]"}]}], "}"}], ",", 
         " ", "Total"}], "]"}], ",", " ", "0"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{"KeyValueMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "x"}], "}"}], " ", "|->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"x", " ", ">", " ", "0"}], ",", " ", "StandardBlue", ",",
              " ", "StandardRed"}], "]"}], ",", " ", 
           RowBox[{"Polygon", "[", 
            RowBox[{"pos", " ", "/@", " ", "t"}], "]"}]}], "}"}]}], ",", " ", 
        "commutator"}], "]"}], "]"}], ",", "\n", "    ", 
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "b"}], "}"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"KeySort", " ", "@", " ", 
         RowBox[{"Coboundary", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"CochainCupOne", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "e"}], "]"}]}], "]"}]}], 
        " ", "===", " ", 
        RowBox[{"KeySort", " ", "@", " ", "commutator"}]}], ")"}]}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ed56e99a-e498-4c6c-b86b-f64465bad2b8"],

