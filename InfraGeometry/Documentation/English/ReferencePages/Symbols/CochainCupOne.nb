Cell["\<\
The cup-1 of the coboundaries of the distances from the centre of the \
triangular tiling and from a vertex three steps away, drawn by an arc along \
each edge in the direction in which it is positive: minus the product of the \
two coboundaries, edge by edge.\
\>", "ExampleText",ExpressionUUID->"6a5ceb52-cc19-4663-9ce9-c6fee5585348"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"center", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"apex", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"center", ",", " ", "3"}], "]"}]}], "]"}]}], ")"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"fromCenter", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "center", ",", " ", 
             RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
          
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], ",", 
     "\n", "   ", 
     RowBox[{"fromApex", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "apex", ",", " ", 
             RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
          
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cupOne", " ", "=", " ", 
     RowBox[{"CochainCupOne", "[", 
      RowBox[{"g", ",", " ", "fromCenter", ",", " ", "fromApex"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"GroupBy", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Keys", " ", "@", " ", 
            RowBox[{"Select", "[", 
             RowBox[{"cupOne", ",", " ", "Positive"}], "]"}]}], ",", " ", 
           RowBox[{"Reverse", " ", "/@", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"Select", "[", 
              RowBox[{"cupOne", ",", " ", "Negative"}], "]"}]}]}]}], "]"}], ",",
          " ", 
         RowBox[{"First", " ", "->", " ", "Last"}]}], "]"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"KeySort", "[", "cupOne", "]"}], " ", "===", " ", 
      RowBox[{"KeySort", "[", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"AssociationMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              RowBox[{"fromCenter", "[", "#", "]"}]}], " ", 
             RowBox[{"fromApex", "[", "#", "]"}]}], " ", "&"}], ",", " ", 
           RowBox[{"Intersection", "[", 
            RowBox[{
             RowBox[{"Keys", "[", "fromCenter", "]"}], ",", " ", 
             RowBox[{"Keys", "[", "fromApex", "]"}]}], "]"}]}], "]"}], ",", 
         " ", "0"}], "]"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0d671398-5ee4-429b-9e1d-3f65b7a5dd0e"],

