Cell["\<\
The two coboundaries are cocycles, and the coboundary of their cup-1 is the \
sum of their ordered cups in both orders, the graded commutator in degrees 1 \
and 1. It is drawn on its triangles, blue where its value on the sorted \
corners is positive and red where it is negative.\
\>", "ExampleText",ExpressionUUID->"2085f4f2-30aa-44ff-80a6-d3477d55dac0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"center", " ", "=", " ", 
      RowBox[{"InfraCenter", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"positions", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"apex", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "center", ",", " ", "3"}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"fromCenter", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "center", ",", " ", 
             RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
          
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], ",", 
     "\n", "   ", 
     RowBox[{"fromApex", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "apex", ",", " ", 
             RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
          
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"commutator", " ", "=", " ", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{"Merge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"OrderedCochainCup", "[", 
            RowBox[{"g", ",", " ", "fromCenter", ",", " ", "fromApex"}], 
            "]"}], ",", " ", 
           RowBox[{"OrderedCochainCup", "[", 
            RowBox[{"g", ",", " ", "fromApex", ",", " ", "fromCenter"}], 
            "]"}]}], "}"}], ",", " ", "Total"}], "]"}], ",", " ", "0"}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"KeyValueMap", "[", "\n", "     ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"triangle", ",", " ", "value"}], "}"}], " ", "|->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"value", " ", ">", " ", "0"}], ",", " ", 
               "StandardBlue", ",", " ", "StandardRed"}], "]"}], ",", " ", 
             RowBox[{"Polygon", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"positions", ",", " ", "triangle"}], "]"}], "]"}]}], 
            "}"}]}], ",", "\n", "     ", "commutator"}], "]"}], "]"}], ",", 
       " ", "g"}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"KeySort", "[", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"CochainCupOne", "[", 
          RowBox[{"g", ",", " ", "fromCenter", ",", " ", "fromApex"}], 
          "]"}]}], "]"}], "]"}], " ", "===", " ", 
      RowBox[{"KeySort", "[", "commutator", "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"13c8b23e-993f-4c39-b215-941d1be03dd6"],

