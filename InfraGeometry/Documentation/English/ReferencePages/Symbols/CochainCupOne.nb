Cell[TextData[{
 "Steenrod's identity in the degrees ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 " = 1, 2, 3 on the complete graph on six vertices, for random cocycles, the \
coboundaries of random cochains."
}], "ExampleText",ExpressionUUID->"1ffc653b-cf5f-434b-9eb6-4134787a0643"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CompleteGraph", "[", "6", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"g", ",", " ", 
     RowBox[{"Table", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"cocycle", " ", "=", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"SeedRandom", "[", "p", "]"}], ";", " ", 
              RowBox[{"Coboundary", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"AssociationMap", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"RandomInteger", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], "]"}], " ", 
                   "&"}], ",", " ", 
                  RowBox[{"Subsets", "[", 
                   RowBox[{
                    RowBox[{"Range", "[", "6", "]"}], ",", " ", 
                    RowBox[{"{", "p", "}"}]}], "]"}]}], "]"}]}], "]"}]}], 
             ")"}]}], ",", "\n", "       ", 
           RowBox[{"otherCocycle", " ", "=", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"SeedRandom", "[", 
               RowBox[{"10", " ", "+", " ", "q"}], "]"}], ";", " ", 
              RowBox[{"Coboundary", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"AssociationMap", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"RandomInteger", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], "]"}], " ", 
                   "&"}], ",", " ", 
                  RowBox[{"Subsets", "[", 
                   RowBox[{
                    RowBox[{"Range", "[", "6", "]"}], ",", " ", 
                    RowBox[{"{", "q", "}"}]}], "]"}]}], "]"}]}], "]"}]}], 
             ")"}]}]}], "}"}], ",", "\n", "      ", 
         RowBox[{
          RowBox[{"KeySort", "[", 
           RowBox[{"Coboundary", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"CochainCupOne", "[", 
              RowBox[{"g", ",", " ", "cocycle", ",", " ", "otherCocycle"}], 
              "]"}]}], "]"}], "]"}], " ", "===", "\n", "        ", 
          RowBox[{"KeySort", "[", 
           RowBox[{"DeleteCases", "[", 
            RowBox[{
             RowBox[{"Merge", "[", 
              RowBox[{
               RowBox[{"{", "\n", "          ", 
                RowBox[{
                 RowBox[{"OrderedCochainCup", "[", 
                  RowBox[{
                  "g", ",", " ", "cocycle", ",", " ", "otherCocycle"}], "]"}],
                  ",", "\n", "          ", 
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "^", 
                    RowBox[{"(", 
                    RowBox[{"p", " ", "q"}], ")"}]}]}], " ", 
                  RowBox[{"OrderedCochainCup", "[", 
                   RowBox[{
                   "g", ",", " ", "otherCocycle", ",", " ", "cocycle"}], 
                   "]"}]}]}], "}"}], ",", " ", "Total"}], "]"}], ",", " ", 
             "0"}], "]"}], "]"}]}]}], "]"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"q", ",", " ", "3"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b044d243-2e02-4cb3-95d0-82ced377a221"],

