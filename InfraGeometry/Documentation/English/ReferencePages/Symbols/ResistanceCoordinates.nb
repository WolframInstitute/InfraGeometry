           {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], Arrowheads[
            0.], ArrowBox[{{1, 2}, {2, 3}, {4, 5}}, 0.02261146421059973]}, 
           {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
            DiskBox[1, 0.02261146421059973], DiskBox[2, 0.02261146421059973], 
