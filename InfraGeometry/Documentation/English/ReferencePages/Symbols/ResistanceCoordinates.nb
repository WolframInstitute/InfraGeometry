Notebook[{

Cell[CellGroupData[{
Cell["ResistanceCoordinates", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"41d385c7-c536-4b5a-beee-3e0ae87eb235"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ResistanceCoordinates"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ResistanceCoordinates", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03ee9c77-af22-489b-becb-4a3690465980"],
 "\[LineSeparator]",
 "gives the association of every vertex ",
 StyleBox["v", "TI"],
 " of ",
 StyleBox["g", "TI"],
 " with a point \[CapitalPhi](",
 StyleBox["v", "TI"],
 ") whose squared distances are the effective resistances: \
\:2016\[CapitalPhi](",
 StyleBox["u", "TI"],
 ") \[Minus] \[CapitalPhi](",
 StyleBox["v", "TI"],
 ")\:2016\.b2 = ",
 StyleBox["R", "TI"],
 "(",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ").",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"702be913-e4ab-42e0-8273-d44f4ea95434"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ResistanceCoordinates"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ResistanceCoordinates", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12ac59cd-5e60-47a4-abf6-1384ffb0b2f9"],
 "\[LineSeparator]",
 "gives the point \[CapitalPhi](",
 StyleBox["v", "TI"],
 ") of the vertex ",
 StyleBox["v", "TI"],
 "."
}], "Usage",ExpressionUUID->"9dfd5d31-3847-4be4-8bf7-3e03124e7d39"],

Cell[TextData[{
 "Definition: let 0 = \[Lambda]\:2081 < \[Lambda]\:2082 \[LessEqual] \
\[Ellipsis] \[LessEqual] \[Lambda]\:2099 be the eigenvalues of the Laplacian ",
 StyleBox["L", "TI"],
 " = ",
 StyleBox["D", "TI"],
 " \[Minus] ",
 StyleBox["A", "TI"],
 " of a connected graph ",
 StyleBox["g", "TI"],
 " with ",
 StyleBox["n", "TI"],
 " vertices, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KirchhoffMatrix"]], "paclet:ref/KirchhoffMatrix"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "33fd7a34-1d51-4426-9889-48fb5f2b98f9"],
 ", and \[CurlyPhi]\:2081, \[Ellipsis], \[CurlyPhi]\:2099 orthonormal \
eigenvectors. Then \[CapitalPhi](",
 StyleBox["v", "TI"],
 ") = (\[CurlyPhi]\:2082(",
 StyleBox["v", "TI"],
 ")/\[Sqrt]\[Lambda]\:2082, \[Ellipsis], \[CurlyPhi]\:2099(",
 StyleBox["v", "TI"],
 ")/\[Sqrt]\[Lambda]\:2099), a point of \:211d\:207f\:207b\.b9."
}], "Notes",ExpressionUUID->"c91d7f55-f340-4e33-9b0e-3db9681030a2"],

Cell[TextData[{
 "Since the pseudoinverse of ",
 StyleBox["L", "TI"],
 " is ",
 StyleBox["L", "TI"],
 "\:207a = \[CapitalSigma]\:1d62 \[CurlyPhi]\:1d62 \[CurlyPhi]\:1d62\:1d40/\
\[Lambda]\:1d62 over ",
 StyleBox["i", "TI"],
 " \[GreaterEqual] 2, the inner products \:27e8\[CapitalPhi](",
 StyleBox["u", "TI"],
 "), \[CapitalPhi](",
 StyleBox["v", "TI"],
 ")\:27e9 are the entries of ",
 StyleBox["L", "TI"],
 "\:207a, and \:2016\[CapitalPhi](",
 StyleBox["u", "TI"],
 ") \[Minus] \[CapitalPhi](",
 StyleBox["v", "TI"],
 ")\:2016\.b2 = ",
 StyleBox["L", "TI"],
 "\:207a\:1d64\:1d64 + ",
 StyleBox["L", "TI"],
 "\:207a\:1d65\:1d65 \[Minus] 2",
 StyleBox["L", "TI"],
 "\:207a\:1d64\:1d65 is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["EffectiveResistance"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/EffectiveResistance", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aef499bd-0bf2-4cdb-b6a4-b080dd0745f1"],
 " ",
 StyleBox["R", "TI"],
 "(",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "). The points are centred, \[CapitalSigma]\:1d65 \[CapitalPhi](",
 StyleBox["v", "TI"],
 ") = 0, and unique up to an orthogonal map: the eigenvectors of a repeated \
eigenvalue may be rotated."
}], "Notes",ExpressionUUID->"02519007-db80-43fd-9c33-575e86a49117"],

Cell[TextData[{
 "The graph must be connected. On a graph with several components the \
resistance between two of them is infinite, no point set has infinite \
distances, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ResistanceCoordinates"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ResistanceCoordinates", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9b253708-9143-41a8-9b0b-a037842af7a9"],
 " stays unevaluated."
}], "Notes",ExpressionUUID->"198d3a4c-d56a-41ea-9e92-d89ab5387b0f"],

Cell[TextData[{
 "With ",
 Cell[BoxData["\"\<Dimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5883f6e3-a561-4237-a351-0d54b7ecb13e"],
 " -> ",
 StyleBox["k", "TI"],
 " only the ",
 StyleBox["k", "TI"],
 " slowest modes are kept. The points then give a spectral drawing of ",
 StyleBox["g", "TI"],
 ", and their squared distances are at most the resistances."
}], "Notes",ExpressionUUID->"56ea74f8-a695-446c-bb41-919f6a59e005"],

