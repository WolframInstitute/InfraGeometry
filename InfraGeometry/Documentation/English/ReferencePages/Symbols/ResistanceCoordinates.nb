Cell["\<\
The square, hexagonal and triangular tilings drawn at their two slowest \
modes, and the dimension of the whole embedding, one less than the number of \
vertices.\
\>", "ExampleText",ExpressionUUID->"01bdac25-1227-45a0-8900-237ce39a04d5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graphs", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"#", ",", " ", "\"\<Small\>\""}], "]"}], " ", "&"}], " ", "/@",
       " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Graph", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "#", "]"}], ",", " ", 
          RowBox[{"EdgeList", "[", "#", "]"}], ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", 
           RowBox[{"Normal", "[", 
            RowBox[{"ResistanceCoordinates", "[", 
             RowBox[{"#", ",", " ", 
              RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}]}], "]"}], 
            "]"}]}]}], "]"}], " ", "&"}], " ", "/@", " ", "graphs"}], "]"}], ",",
      "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"First", "[", 
         RowBox[{"ResistanceCoordinates", "[", "#", "]"}], "]"}], "]"}], " ", 
       "&"}], " ", "/@", " ", "graphs"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"88736b35-c81f-4ed5-99b7-a17535f74488"],

