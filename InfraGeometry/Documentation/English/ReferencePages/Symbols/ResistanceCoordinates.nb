Cell[CellGroupData[{

Cell["Origin", "ExampleSubsection",ExpressionUUID->"329e1cbc-4369-49a4-84f4-c985da6b0ed5"],

Cell["\<\
With the centre as the origin, the squared norm of each point is its \
resistance to the centre:\
\>", "ExampleText",ExpressionUUID->"b348e532-5745-4c0d-a34f-00995992b9c0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"phi", " ", "=", " ", 
     RowBox[{"ResistanceCoordinates", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"\"\<Origin\>\"", " ", "->", " ", "c"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{"phi", "[", "c", "]"}], "]"}], ",", " ", 
     RowBox[{"Chop", " ", "@", " ", 
      RowBox[{"Max", " ", "@", " ", 
       RowBox[{"Abs", " ", "@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{"phi", "[", "u", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
           RowBox[{"EffectiveResistance", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "u"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", 
            RowBox[{"VertexList", "[", "g", "]"}]}], "}"}]}], "]"}]}]}]}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"632bff70-1214-4085-a368-44f5be0df781"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.`", ",", "0"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"fc22d6dc-8b09-4c50-a5c3-373bf3c09574"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

