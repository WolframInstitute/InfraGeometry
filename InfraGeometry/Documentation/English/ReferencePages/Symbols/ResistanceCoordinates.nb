Cell["\<\
With fewer modes the squared distances fall below the resistances, and they \
approach them as modes are added: from the centre of the square tiling with \
2, 10 and 40 of its 112 modes, and with all of them.\
\>", "ExampleText",ExpressionUUID->"02688fa0-a876-4c38-a6ff-1402a5680207"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"ListPlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"embedding", " ", "=", " ", 
           RowBox[{"ResistanceCoordinates", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "k"}]}], "]"}]}], 
          "}"}], ",", "\n", "        ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"EffectiveResistance", "[", 
              RowBox[{"g", ",", " ", "c", ",", " ", "u"}], "]"}], ",", " ", 
             RowBox[{"Total", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"embedding", "[", "c", "]"}], " ", "-", " ", 
                 RowBox[{"embedding", "[", "u", "]"}]}], ")"}], "^", "2"}], 
              "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"u", ",", " ", 
             RowBox[{"VertexList", "[", "g", "]"}]}], "}"}]}], "]"}]}], "]"}],
        ",", "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "10", ",", " ", "40", ",", " ", "All"}], 
          "}"}]}], "}"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<2 modes\>\"", ",", " ", "\"\<10 modes\>\"", ",", 
        " ", "\"\<40 modes\>\"", ",", " ", "\"\<all modes\>\""}], "}"}]}], ",",
      " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<R\>\"", ",", 
        " ", "\"\<\:2016\[CapitalPhi](c) \[Minus] \
\[CapitalPhi](u)\:2016\.b2\>\""}], "}"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e5888b09-1c61-427c-b2fb-b7d1f2ec19f2"],

