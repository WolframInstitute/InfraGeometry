Cell["\<\
The inner products of the points are the entries of the pseudoinverse of the \
Laplacian.\
\>", "ExampleText",ExpressionUUID->"71e6d4b3-37b3-4b87-b389-80bd8761aade"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"gram", " ", "=", " ", 
     RowBox[{"Outer", "[", 
      RowBox[{"Dot", ",", " ", 
       RowBox[{"Values", "[", 
        RowBox[{"ResistanceCoordinates", "[", "g", "]"}], "]"}], ",", " ", 
       RowBox[{"Values", "[", 
        RowBox[{"ResistanceCoordinates", "[", "g", "]"}], "]"}], ",", " ", 
       "1"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MatrixPlot", "[", "gram", "]"}], ",", " ", 
     RowBox[{"Chop", "[", 
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"gram", " ", "-", " ", 
         RowBox[{"PseudoInverse", "[", 
          RowBox[{"N", "[", 
           RowBox[{"KirchhoffMatrix", "[", "g", "]"}], "]"}], "]"}]}], "]"}], 
       "]"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"bb424e91-6502-4fd2-b90d-3cb14af8071f"],

