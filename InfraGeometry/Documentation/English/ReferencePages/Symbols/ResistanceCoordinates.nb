Cell["\<\
The three slowest modes of the sphere mesh are coordinates in space. Drawn at \
them the sphere is round: every point lies at nearly the same distance from \
the origin:\
\>", "ExampleText",ExpressionUUID->"6399d82e-a888-4d65-8ae1-0569d1551032"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SphereMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"phi", " ", "=", " ", 
     RowBox[{"ResistanceCoordinates", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "3"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"Graph3D", "[", 
    RowBox[{
     RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
     RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
     RowBox[{"VertexCoordinates", " ", "->", " ", 
      RowBox[{"Normal", "[", "phi", "]"}]}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"MinMax", "[", 
       RowBox[{"Norm", " ", "/@", " ", 
        RowBox[{"Values", "[", "phi", "]"}]}], "]"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fd92111f-974e-40dd-8fcc-e1fce2c10f3c"],

