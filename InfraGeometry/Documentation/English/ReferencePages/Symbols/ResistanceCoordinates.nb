Cell["Dimension", "ExampleSubsection",ExpressionUUID->"f96213a4-2bbe-41e2-9687-19a4d1dd3870"],

Cell["\<\
With fewer modes the squared distances fall below the resistances. From the \
centre of the mesh with 2, 10 and 40 of its 101 modes:\
\>", "ExampleText",ExpressionUUID->"b4d285b8-c600-45d8-9922-e57cfc1e038a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"ListPlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"phi", " ", "=", " ", 
           RowBox[{"ResistanceCoordinates", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "k"}]}], "]"}]}], 
          "}"}], ",", "\n", "      ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"EffectiveResistance", "[", 
              RowBox[{"g", ",", " ", "c", ",", " ", "u"}], "]"}], ",", " ", 
             RowBox[{"Total", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"phi", "[", "c", "]"}], " ", "-", " ", 
                 RowBox[{"phi", "[", "u", "]"}]}], ")"}], "^", "2"}], "]"}]}],
             "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"u", ",", " ", 
             RowBox[{"VertexList", "[", "g", "]"}]}], "}"}]}], "]"}]}], "]"}],
        ",", "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "10", ",", " ", "40", ",", " ", "All"}], 
          "}"}]}], "}"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "10", ",", " ", "40", ",", " ", "All"}], 
       "}"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b782e02a-ab64-44a0-b7e1-0f5cdf905999"],

