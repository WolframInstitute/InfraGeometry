Cell[CellGroupData[{

Cell["Rescaling", "ExampleSubsection",ExpressionUUID->"c735fb50-9f9b-48a0-bda3-1e62fcd1bcb4"],

Cell["\<\
The two slowest modes of a 12 \[Times] 4 grid both run along its length, so \
each drawing is a curve. The plain eigenvectors weigh the two alike, the \
resistance matching weighs the faster one less, and the diffusion map at time \
5 less again:\
\>", "ExampleText",ExpressionUUID->"c1efaff8-dddf-4148-bf68-4d9b488e38dc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"12", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"phi", " ", "=", " ", 
          RowBox[{"ResistanceCoordinates", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}], ",", " ", 
            RowBox[{"\"\<Rescaling\>\"", " ", "->", " ", "r"}]}], "]"}]}], 
         "}"}], ",", "\n", "      ", 
        RowBox[{"Graph", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", 
           RowBox[{"Normal", "[", "phi", "]"}]}]}], "]"}]}], "]"}], ",", "\n",
       "    ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<None\>\"", ",", " ", "\"\<ResistanceMatching\>\"", ",", 
          " ", 
          RowBox[{"\"\<Diffusion\>\"", " ", "->", " ", "5"}]}], "}"}]}], 
       "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"09c4d5c1-770d-4777-8a41-9583368c85ec"],

