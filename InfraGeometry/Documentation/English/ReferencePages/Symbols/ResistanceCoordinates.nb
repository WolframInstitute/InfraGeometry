Cell["\<\
The squared distance from the point of the centre against the effective \
resistance, for every vertex of the mesh. The points lie on the diagonal:\
\>", "ExampleText",ExpressionUUID->"35c1a5ac-d758-4e6b-82ea-e931b5f840d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"c", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
     RowBox[{"phi", " ", "=", " ", 
      RowBox[{"ResistanceCoordinates", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"EffectiveResistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "u"}], "]"}], ",", " ", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"phi", "[", "c", "]"}], " ", "-", " ", 
             RowBox[{"phi", "[", "u", "]"}]}], ")"}], "^", "2"}], "]"}]}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"u", ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "}"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"AspectRatio", " ", "->", " ", "1"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"86c12c94-dadc-47a4-b562-5b0108222273"],

