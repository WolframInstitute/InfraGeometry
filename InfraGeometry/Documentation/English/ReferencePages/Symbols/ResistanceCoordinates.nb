Cell["\<\
A repeated eigenvalue leaves the points unique only up to a rotation of its \
eigenvectors. The four slowest modes of the square torus share one \
eigenvalue, and three of them draw an arbitrary projection of the torus.\
\>", "ExampleText",ExpressionUUID->"3790983b-f9da-4295-8ca6-69b7dd7ffc57"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Graph3D", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
       RowBox[{"VertexCoordinates", " ", "->", " ", 
        RowBox[{"Normal", "[", 
         RowBox[{"ResistanceCoordinates", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "3"}]}], "]"}], 
         "]"}]}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"N", "[", 
          RowBox[{"KirchhoffMatrix", "[", "g", "]"}], "]"}], "]"}], "]"}], ",",
        " ", "6"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1c377b84-78b6-4583-af9d-949341a3f2d3"],

