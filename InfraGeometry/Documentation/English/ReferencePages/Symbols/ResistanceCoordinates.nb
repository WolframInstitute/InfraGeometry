Cell["\<\
The inner products of the points are the entries of the pseudoinverse of the \
Laplacian:\
\>", "ExampleText",ExpressionUUID->"52f8b1cb-c1b8-46e6-8c8b-d80287442132"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"phi", " ", "=", " ", 
     RowBox[{"Values", " ", "@", " ", 
      RowBox[{"ResistanceCoordinates", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"Chop", " ", "@", " ", 
    RowBox[{"Max", " ", "@", " ", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"phi", " ", ".", " ", 
        RowBox[{"Transpose", "[", "phi", "]"}]}], " ", "-", " ", 
       RowBox[{"PseudoInverse", "[", 
        RowBox[{"N", " ", "@", " ", 
         RowBox[{"KirchhoffMatrix", "[", "g", "]"}]}], "]"}]}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"801a3bc6-27ec-41f6-a1c8-cfa9eed597fa"],

Cell[BoxData["0"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"3ff22129-fb72-4947-9ddc-7a50a8637e66"]
}, Open  ]]
}, Open  ]],

