Cell["\<\
The squared distance between the points of the centre and of each vertex of \
the square tiling against their effective resistance: the points lie on the \
diagonal.\
\>", "ExampleText",ExpressionUUID->"55aab3b9-1176-4175-a797-197a1e52bc4b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"embedding", " ", "=", " ", 
      RowBox[{"ResistanceCoordinates", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"c", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"GraphCenter", "[", "g", "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"pairs", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"EffectiveResistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "u"}], "]"}], ",", " ", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"embedding", "[", "c", "]"}], " ", "-", " ", 
             RowBox[{"embedding", "[", "u", "]"}]}], ")"}], "^", "2"}], 
          "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"u", ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{"pairs", ",", " ", 
       RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<R\>\"", ",", 
          " ", "\"\<\:2016\[CapitalPhi](c) \[Minus] \
\[CapitalPhi](u)\:2016\.b2\>\""}], "}"}]}]}], "]"}], ",", " ", 
     RowBox[{"Chop", "[", 
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"Subtract", " ", "@@@", " ", "pairs"}], "]"}], "]"}], "]"}]}],
     "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c6724310-df53-4a4d-8283-76a738288510"],

