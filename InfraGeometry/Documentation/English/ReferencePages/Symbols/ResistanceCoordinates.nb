Cell["\<\
On a graph with two components there are no coordinates, and the call stays \
unevaluated:\
\>", "ExampleText",ExpressionUUID->"80b5a72c-f6cb-4eda-9f94-42f0e63b2db5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GraphUnion", "[", 
      RowBox[{
       RowBox[{"PathGraph", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
       
       RowBox[{"PathGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "5"}], "}"}], "]"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"EffectiveResistance", "[", 
      RowBox[{"g", ",", " ", "1", ",", " ", "4"}], "]"}], ",", " ", 
     RowBox[{"ResistanceCoordinates", "[", "g", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3379715c-8ee2-4598-9f24-e2329d24c1fe"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\[Infinity]", ",", 
   RowBox[{"ResistanceCoordinates", "[", 
    GraphicsBox[
     NamespaceBox["NetworkGraphics",
      DynamicModuleBox[{Typeset`graph = HoldComplete[
        Graph[{1, 2, 3, 4, 5}, {Null, {{1, 2}, {2, 3}, {4, 5}}}]]}, 
       TagBox[
