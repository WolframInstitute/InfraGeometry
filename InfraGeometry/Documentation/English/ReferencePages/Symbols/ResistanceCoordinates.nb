Notebook[{

Cell[CellGroupData[{
Cell["ResistanceCoordinates", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d32218be-11f3-4ab4-bf99-0766658b749b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ResistanceCoordinates"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ResistanceCoordinates", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5d28590-ba81-4f93-8429-f287f7253bd0"],
 "\[LineSeparator]",
 "gives the association of every vertex ",
 StyleBox["v", "TI"],
 " of ",
 StyleBox["g", "TI"],
 " with a point ",
 StyleBox["\[CapitalPhi](v)", "TI"],
 " whose squared distances are the effective resistances, ",
 StyleBox["\:2016\[CapitalPhi](u) \[Minus] \[CapitalPhi](v)\:2016\.b2 = R(u, \
v)", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"884481f2-92b6-4e4f-901a-97c26c6192cc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ResistanceCoordinates"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ResistanceCoordinates", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "066bb5a3-e211-413c-af8b-52c9825914eb"],
 "\[LineSeparator]",
 "gives the point ",
 StyleBox["\[CapitalPhi](v)", "TI"],
 "."
}], "Usage",ExpressionUUID->"09600b58-f614-435f-a82b-0598c8cea019"],

Cell[TextData[{
 "Let ",
 StyleBox["0 = \[Lambda]\:2081 < \[Lambda]\:2082 \[LessEqual] \[Ellipsis] \
\[LessEqual] \[Lambda]\:2099", "TI"],
 " be the eigenvalues of the Laplacian ",
 StyleBox["L", "TI"],
 " = ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KirchhoffMatrix"]], "paclet:ref/KirchhoffMatrix"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7559bffe-7f0b-410d-9151-e7c328672712"],
 " of a connected graph with ",
 StyleBox["n", "TI"],
 " vertices, and ",
 StyleBox["\[CurlyPhi]\:2081, \[Ellipsis], \[CurlyPhi]\:2099", "TI"],
 " orthonormal eigenvectors. Then ",
 StyleBox["\[CapitalPhi](v) = (\[CurlyPhi]\:2082(v)/\[Sqrt]\[Lambda]\:2082, \
\[Ellipsis], \[CurlyPhi]\:2099(v)/\[Sqrt]\[Lambda]\:2099)", "TI"],
 ", a point of ",
 StyleBox["\:211d\:207f\:207b\.b9", "TI"],
 "."
}], "Notes",ExpressionUUID->"a520a65e-3fec-4674-b237-12776ff44f48"],

Cell[TextData[{
 "The inner products ",
 StyleBox["\:27e8\[CapitalPhi](u), \[CapitalPhi](v)\:27e9", "TI"],
 " are the entries of the pseudoinverse ",
 StyleBox["L\:207a", "TI"],
 ", so ",
 StyleBox["\:2016\[CapitalPhi](u) \[Minus] \[CapitalPhi](v)\:2016\.b2 = L\
\:207a\:1d64\:1d64 + L\:207a\:1d65\:1d65 \[Minus] 2L\:207a\:1d64\:1d65 = R(u, \
v)", "TI"],
 ", the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["EffectiveResistance"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/EffectiveResistance", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fa9f6390-3821-4be4-9db9-78294cc202fe"],
 ". The points are centred, ",
 StyleBox["\[CapitalSigma] \[CapitalPhi](v) = 0", "TI"],
 ", and unique up to an orthogonal map; a repeated eigenvalue lets its \
eigenvectors rotate."
}], "Notes",ExpressionUUID->"ed238dad-7189-45c6-be15-ed899d7eb66d"],

Cell["\<\
The graph must be connected: between two components the resistance is \
infinite.\
\>", "Notes",ExpressionUUID->"c42ca79a-5f8f-4e8c-8b8c-0805eac59a90"],

Cell[TextData[{
 "The point ",
 StyleBox["v", "TI"],
 " can be a density; the result is then the list of the points of its \
vertices."
}], "Notes",ExpressionUUID->"4d875b64-620c-4edc-8b96-49f3ec7399a4"],

