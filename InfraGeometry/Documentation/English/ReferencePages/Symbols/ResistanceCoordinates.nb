Cell[CellGroupData[{

Cell["Rescaling", "ExampleSubsection",ExpressionUUID->"7aff41f6-2e8d-436b-bb7e-15a215df5ddd"],

Cell["\<\
The two slowest modes of a 12 \[Times] 4 grid both run along its length, so \
each drawing is a curve, the second mode bending it. The plain eigenvectors \
weigh the two modes alike; the resistance matching weighs the faster one \
less, and the diffusion map at time 5 less again.\
\>", "ExampleText",ExpressionUUID->"4c4483dc-c623-45e2-9700-e1633b735258"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"12", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
        RowBox[{"VertexCoordinates", " ", "->", " ", 
         RowBox[{"Normal", "[", 
          RowBox[{"ResistanceCoordinates", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}], ",", " ", 
            RowBox[{"\"\<Rescaling\>\"", " ", "->", " ", "rescaling"}]}], 
           "]"}], "]"}]}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"rescaling", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<None\>\"", ",", " ", "\"\<ResistanceMatching\>\"", ",", 
          " ", 
          RowBox[{"\"\<Diffusion\>\"", " ", "->", " ", "5"}]}], "}"}]}], 
       "}"}]}], "]"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"84cbf0df-b648-406b-b164-165412205662"],

