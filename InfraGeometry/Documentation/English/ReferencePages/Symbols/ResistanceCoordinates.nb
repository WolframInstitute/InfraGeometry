Cell["\<\
On a graph with two components the resistances between them are infinite, so \
there are no coordinates: the call stays unevaluated.\
\>", "ExampleText",ExpressionUUID->"d8959a0a-6b06-42dd-a756-754acde766f9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GraphUnion", "[", 
      RowBox[{
       RowBox[{"PathGraph", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
       
       RowBox[{"PathGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "5"}], "}"}], "]"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"g", ",", " ", 
     RowBox[{"EffectiveResistance", "[", 
      RowBox[{"g", ",", " ", "1", ",", " ", "4"}], "]"}], ",", " ", 
     RowBox[{"ResistanceCoordinates", "[", "g", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"29a6d75a-f690-48cf-926d-6074d095facc"],

