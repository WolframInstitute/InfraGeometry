Cell[TextData[{
 "The point ",
 StyleBox["v", "TI"],
 " may also be a density; the result is then the list of the points of its \
vertices."
}], "Notes",ExpressionUUID->"ba8629ba-87c3-4753-bffa-4d18e16cdb69"]
}, Open  ]],

