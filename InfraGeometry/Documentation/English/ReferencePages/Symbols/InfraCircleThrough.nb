Notebook[{

Cell[CellGroupData[{
Cell["InfraCircleThrough", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"51c5b8dd-c81d-4852-a8da-fb00ff9c9b53"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircleThrough"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCircleThrough", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pk", "TI"]}], "}"}], ",", " ", 
    RowBox[{"InfraCircle", "[", 
     RowBox[{
      StyleBox["c", "TI"], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["r", "TI"], ",", " ", 
        StyleBox["s", "TI"]}], "}"}]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b98161fd-536b-4b8d-8c5f-2ad3e4351256"],
 "\[LineSeparator]",
 "is the family of the shortest circles around ",
 StyleBox["c", "TI"],
 " in the band {",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["s", "TI"],
 "} that pass through every point ",
 StyleBox["p\:1d62", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"04f1cf49-54b7-420c-a71e-bfbb3cc15b03"],

Cell[TextData[{
 "Let ",
 StyleBox["W = {v : r \[LessEqual] d(c, v) \[LessEqual] s}", "TI"],
 ". A member is a simple cycle in ",
 StyleBox["W", "TI"],
 " that contains every ",
 StyleBox["p\:1d62", "TI"],
 " and whose removal cuts ",
 StyleBox["c", "TI"],
 " off from every vertex beyond ",
 StyleBox["W", "TI"],
 ". Among those cycles the shortest are kept, all of them."
}], "Notes",ExpressionUUID->"f5739fe7-6726-4194-a1a4-26c28f8417ec"],

Cell[TextData[{
 "The points come first and the length second. So the circles through the \
points can be longer than the circles of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "043b1074-170d-4651-82c0-786b4814e981"],
 ", and when none of those passes through the points, filtering them gives \
nothing while ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircleThrough"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircleThrough", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2b6cfd7d-76a7-4cb0-a872-5ffb103451a0"],
 " still has members."
}], "Notes",ExpressionUUID->"118cda83-5ad5-4ced-99c3-ea58e474853a"],

Cell[TextData[{
 "The order and repetition of the points do not matter. The radii satisfy ",
 StyleBox["1 \[LessEqual] r \[LessEqual] s", "TI"],
 ". A point outside the band gives the empty family: cardinality 0 and length \
",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "383401f6-3839-4cbf-9f2b-b5f80abb9e26"],
 "."
}], "Notes",ExpressionUUID->"e1f64cd1-1f3a-4add-9d93-81f3211f5bbd"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircleThrough"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircleThrough", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f6bc1da5-9739-4440-bf93-e5b3378c6776"],
 " is a symbolic object: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c2a868b7-2f73-43f5-afb0-b8c4794e8a3d"],
 " evaluates it on a graph and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraCircleThrough"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraCircleThrough", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "143f9593-4e02-4eb5-9fe5-484608a1da6a"],
 " draws members. A member is a cyclic vertex list; its first vertex is not \
repeated."
}], "Notes",ExpressionUUID->"32b5c37c-e3ea-4870-a96c-420651f4a1b5"],

