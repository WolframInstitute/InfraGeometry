Notebook[{

Cell[CellGroupData[{
Cell["InfraCircleThrough", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell["LLM generated.", "Notes",ExpressionUUID->"0ce5bbaf-02f7-46b6-b81d-415aef85b0df"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"58314ccd-ce75-4c69-ac46-03d87019e644"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircleThrough"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCircleThrough", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["points", "TI"], ",", " ", 
    RowBox[{"InfraCircle", "[", 
     RowBox[{
      StyleBox["center", "TI"], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["r", "TI"], ",", " ", 
        StyleBox["s", "TI"]}], "}"}]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f5c36a9-40db-4ff8-a6e2-e24c60e00cc5"],
 "\[LineSeparator]",
 "denotes the shortest separating simple circles in the given band containing \
every prescribed point.",
 "\n",
 "The head is inert. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c29fbd2d-6953-4108-9804-436aacfa052f"],
 " reads its exact family on a graph, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraCircleThrough"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraCircleThrough", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "884123ec-19db-48a6-bc1b-7dd2bb0e64b3"],
 " samples its members."
}], "Usage",ExpressionUUID->"79dfff0b-aab9-4fba-a9f9-5fbbbb305444"],

Cell[TextData[{
 "Graphs are finite, simple, undirected and unweighted. The band has integer \
radii ",
 Cell[BoxData[
  RowBox[{"1", " ", "<=", " ", "r", " ", "<=", " ", "s"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "feefa98c-3b6f-4168-a7e9-915fd380a8fd"],
 ". ",
 Cell[BoxData["points"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb26c866-1649-4ce5-a73f-bdb5595c0d60"],
 " is a nonempty list of literal graph vertices, and ",
 Cell[BoxData["center"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a36635a-7105-4ba3-8af7-8b6ed55aaf56"],
 " is a literal graph vertex. The order and repetitions of the requested \
points have no effect."
}], "Notes",ExpressionUUID->"c167c1f4-37a0-434b-ba2e-2bfa177aec59"],

Cell[TextData[{
 "A member is a simple cycle contained in ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"v", " ", ":", " ", 
    RowBox[{"r", " ", "<=", " ", 
     RowBox[{"d", 
      RowBox[{"(", 
       RowBox[{"center", ",", " ", "v"}], ")"}]}], " ", "<=", " ", "s"}]}], 
   "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d44fa387-1cf4-4925-b081-ecf5682e66ae"],
 ". Deleting its vertices must separate the center from the vertices in its \
connected component whose distance exceeds ",
 Cell[BoxData["s"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "013baee1-a09a-4eec-8b66-4630ce9eb180"],
 ". An empty outside set makes this separation condition vacuous, as for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "34e0bd16-6cce-43d7-bc49-177e7eb307a2"],
 "."
}], "Notes",ExpressionUUID->"e30bcc46-0f9f-481d-b53b-ec9dbd16ff5f"],

Cell["\<\
First impose every requested point, simplicity and separation. Then minimize \
the length and retain every tie. This can yield a longer circle than the \
unconstrained shortest circles in the band. Filtering those unconstrained \
shortest circles afterward can incorrectly give an empty result.\
\>", "Notes",ExpressionUUID->"34d7a87d-c9e9-4dd5-b94d-492efb5b70ed"],

Cell[TextData[{
 "Representatives are open cyclic vertex lists, with an implicit \
last-to-first edge. Rotations and reversal identify the same circle. The \
first requested vertex in ",
 Cell[BoxData[
  RowBox[{"VertexList", "[", "graph", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21cd1c92-d31f-4787-b324-accc8c0d185c"],
 " order is the start; its second vertex precedes its last vertex in that \
graph order. Each distinct circle therefore has one canonical encoding."
}], "Notes",ExpressionUUID->"d1be2442-a8dc-4132-b2e8-86b00dfe932f"],

Cell[TextData[{
 "A valid request can have an empty family, including when a requested vertex \
is outside the band. Its cardinality is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de1bb344-56f4-4f64-bc67-a15b875250f0"],
 ", length is ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1e8975f-cc5b-47fe-888e-333353538fe3"],
 ", and carrier is an empty directed graph. Unsupported domains stay \
unevaluated."
}], "Notes",ExpressionUUID->"734a395d-0d6f-40ab-83fc-ece0f506041e"],

Cell[TextData[{
 "This construction keeps the center and band explicit. It does not infer a \
Euclidean circumcenter from arbitrary prescribed points. The existing closed ",
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "p"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c39e31d4-15ef-4fa8-824b-652aa7a3841e"],
 " describes circles through one point using that arc's radial-band \
construction; this head imposes an arbitrary prescribed set before \
minimization."
}], "Notes",ExpressionUUID->"b3356e4f-27bb-44d8-b7c3-bae17aed5a57"],

Cell["Measurements:", "Notes",ExpressionUUID->"9530ea38-0d94-4c05-aba6-0eb2122583e4"],

