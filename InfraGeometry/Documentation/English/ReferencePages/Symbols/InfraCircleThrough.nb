Cell["\<\
The rim of a wheel passes through both prescribed vertices and separates its \
center.\
\>", "ExampleText",ExpressionUUID->"f09f7b2c-97b7-4a71-bf6d-39300ab4fee8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"WheelGraph", "[", "5", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"InfraCircleThrough", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"circle", ",", " ", "1", ",", " ", "2", ",", " ", "4"}], 
        "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "circle", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Cardinality\>\"", ",", " ", "\"\<Length\>\""}], "}"}]}], 
      "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0f7a948e-a19f-4242-97e3-fac9f61eb183"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   GraphicsBox[
    NamespaceBox["NetworkGraphics",
     DynamicModuleBox[{Typeset`graph = HoldComplete[
       Graph[{1, 2, 3, 4, 5}, {Null, 
         SparseArray[
         Automatic, {5, 5}, 0, {
          1, {{0, 4, 7, 10, 13, 16}, {{2}, {3}, {4}, {5}, {1}, {3}, {5}, {
            1}, {2}, {4}, {1}, {3}, {5}, {1}, {2}, {4}}}, Pattern}]}, {
        EdgeShapeFunction -> {UndirectedEdge[2, 3] -> ({
             JoinForm["Round"], 
             CapForm["Round"], 
             If[
              And[
               MatchQ[
                Part[{{
                   UndirectedEdge[2, 3], 
                   UndirectedEdge[3, 4], 
                   UndirectedEdge[4, 5], 
                   UndirectedEdge[2, 5]}, {{6.049014748177263*^-16, -1.}, {
                  1., -1.133107779529596*^-15}, {-7.044813998280222*^-16, 
                  1.}, {-1., 3.6739403974420594`*^-16}, {
                  6.049014748177263*^-16, -1.}}, True, None}, 4], 
                Blank[Arrowheads]], 
