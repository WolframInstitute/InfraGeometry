Cell["\<\
Four prescribed rim vertices of a complete graph admit three distinct minimum \
circles.\
\>", "ExampleText",ExpressionUUID->"f218ff15-ae81-4847-8bc9-8b7df3965a4e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CompleteGraph", "[", "5", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"InfraCircleThrough", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3", ",", " ", "4", ",", " ", "5"}], "}"}], ",",
        " ", 
       RowBox[{"InfraCircle", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "circle", ",", " ", "\"\<Cardinality\>\""}], 
      "]"}], ",", " ", 
     RowBox[{"RandomInfraCircleThrough", "[", 
      RowBox[{"g", ",", " ", "circle", ",", " ", "All"}], "]"}]}], "}"}]}], 
  "]"}]}], "Input",
