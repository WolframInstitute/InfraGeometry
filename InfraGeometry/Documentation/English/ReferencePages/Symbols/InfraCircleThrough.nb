Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97a3226c-d227-48e3-9cff-9b3148502caf"],
 " returns these properties in an Association. Counts and densities are \
computed from carrier path counts without expanding every circle."
}], "Notes",ExpressionUUID->"a9a29009-4462-42e3-8d89-c60396401ea0"],

Cell[TextData[{
 "The carrier is an ordinary Graph. Its vertices have the form ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"stateID", ",", " ", "substrateVertex"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "694361c3-7b9e-49e9-8e88-beab480ea356"],
 ". Its unique source and sink project to the same requested start vertex. A \
complete source-to-sink path decodes to a circle by ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"Most", "[", "path", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd230509-8c21-4fc1-9de2-aa96711275ae"],
 ". Arbitrary carrier subpaths are partial walks. The compiler remembers \
visited vertex sets, removes dead states and merges equal continuation \
families; its construction can take exponential time."
}], "Notes",ExpressionUUID->"96708421-1c72-4766-b0c5-a2d89255abf0"]
}, Open  ]],

