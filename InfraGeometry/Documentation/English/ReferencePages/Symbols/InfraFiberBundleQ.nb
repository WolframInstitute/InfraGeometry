Cell["\<\
The products and the coverings of the catalogue are bundles, the branched \
fibrations are not:\
\>", "ExampleText",ExpressionUUID->"9a774b99-9874-4229-99d4-0bf5dd9561eb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"name", " ", "->", " ", 
    RowBox[{"InfraFiberBundleQ", " ", "@", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}]}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"Join", " ", "@@", " ", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"InfraFiberedSubstrate", "[", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Trivial\>\"", ",", " ", "\"\<Covering\>\"", ",", 
          " ", "\"\<NonBundle\>\""}], "}"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4780875b-0104-4cf3-b0a5-1297800ee90f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"CycleProductBundle\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"GridProductBundle\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"CycleDoubleCover\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"MoebiusLadderCover\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"TriangularTorusDoubleCover\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"BranchedCycleFibration\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"BranchedGridFibration\"\>", "\[Rule]", "False"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"75bd060e-69b9-4ff6-91a8-7e8f11528869"]
}, Open  ]]
}, Open  ]],

