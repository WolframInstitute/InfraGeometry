Cell[TextData[{
 "The cycle of length 8 over the square and the cycle of length 6 over the \
triangle, each vertex ",
 StyleBox["i", "TI"],
 " over ",
 StyleBox["i", "TI"],
 " mod ",
 StyleBox["n", "TI"],
 ". Over the square every ball of radius 1 is a path, and the cover is \
trivial over it. Over the triangle the ball is the whole triangle, and the \
cover is not trivial over it."
}], "ExampleText",ExpressionUUID->"b6b0cbda-2e6b-469a-9736-538e3fd7830f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"square", " ", "=", " ", 
     RowBox[{"InfraFibration", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
       RowBox[{"i", " ", "|->", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{"i", ",", " ", "4", ",", " ", "1"}], "]"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"triangle", " ", "=", " ", 
     RowBox[{"InfraFibration", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
       RowBox[{"i", " ", "|->", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{"i", ",", " ", "3", ",", " ", "1"}], "]"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraTotalGraph", "[", "square", "]"}], ",", " ", 
     RowBox[{"InfraFiberBundleQ", "[", "square", "]"}], ",", " ", 
     RowBox[{"InfraTotalGraph", "[", "triangle", "]"}], ",", " ", 
     RowBox[{"InfraFiberBundleQ", "[", "triangle", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7db296bf-a67c-44d8-938e-01d4d8e31f74"],

