Cell["\<\
With exactly one lift of every base edge, the horizontal edges over a ball \
form a covering of the ball. The bundle is trivial over the ball iff each \
component of this covering projects injectively.\
\>", "Notes",ExpressionUUID->"70914600-799c-4f5d-8371-690d8b09f02c"],

Cell[TextData[{
 "The ball is the closed ball of radius 1 of the reconstructed ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBaseGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBaseGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f63f8d24-a31b-4935-9a28-fa3aea0478d6"],
 "."
}], "Notes",ExpressionUUID->"72210f63-9c0e-4dd7-b87a-21c21a1e90ef"]
}, Open  ]],

