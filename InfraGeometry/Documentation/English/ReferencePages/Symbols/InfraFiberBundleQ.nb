Cell["\<\
The cycle of length 8 over the square and the cycle of length 6 over the \
triangle are both twisted double coverings and hence bundles.\
\>", "ExampleText",ExpressionUUID->"853d10b7-1f63-4146-aa1a-5235dd2c4536"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"square", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
       RowBox[{"i", " ", "|->", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{"i", ",", " ", "4", ",", " ", "1"}], "]"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"triangle", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
       RowBox[{"i", " ", "|->", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{"i", ",", " ", "3", ",", " ", "1"}], "]"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", "square", "]"}], ",", " ", 
     RowBox[{"InfraFiberBundleQ", "[", "square", "]"}], ",", " ", 
     RowBox[{"InfraFiberedGraphHighlight", "[", "triangle", "]"}], ",", " ", 
     RowBox[{"InfraFiberBundleQ", "[", "triangle", "]"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"767b8ab3-5611-4384-84bf-a9269d94aabb"],

