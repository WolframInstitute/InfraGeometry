Cell[CellGroupData[{
Cell["InfraFiberBundleQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"92925343-fa01-4b82-9a48-5b5672588b22"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFiberBundleQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberBundleQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d63b5137-9b60-45c0-8bc1-f484eae5aa04"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["fib", "TI"],
 " has a common fiber graph and an adjacency-preserving matching over every \
base edge.",
 "\n"
}], "Usage",ExpressionUUID->"263f650d-b195-4ad2-bd70-5e6094a235d3"],

Cell["\<\
The fibers must be mutually isomorphic, including across disconnected base \
components.\
\>", "Notes",ExpressionUUID->"86a7e12b-8b69-4979-b033-7929dd752f56"],

Cell["\<\
Every total vertex has exactly one transverse neighbour over each adjacent \
base vertex. Each resulting fiber bijection preserves vertical adjacency.\
\>", "Notes",ExpressionUUID->"68ab62c6-c3cf-4fcd-9304-d25e547b4dd3"],

Cell[TextData[{
 "Twisted coverings are bundles. Trivial monodromy is a separate question, \
tested for a selected connection by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFlatConnectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFlatConnectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d966b292-9fd6-417f-a7f3-03013cf7a134"],
 "."
}], "Notes",ExpressionUUID->"396045d1-3692-416d-8cce-60ba87eee808"],

Cell["\<\
A nonempty list is tested by conjunction. An empty list is False; the empty \
fibered graph is a bundle.\
\>", "Notes",ExpressionUUID->"3f486b24-b674-47c7-b5c7-1729bd7ad691"]
}, Open  ]],

