Cell[TextData[{
 "The cycle of length 8 over the square and the cycle of length 6 over the \
triangle, each vertex ",
 StyleBox["i", "TI"],
 " over ",
 StyleBox["i", "TI"],
 " mod ",
 StyleBox["n", "TI"],
 ". Over the square every ball of radius 1 is a path, and the cover is \
trivial over it. Over the triangle the ball is the whole triangle, and the \
cover is not trivial over it."
}], "ExampleText",ExpressionUUID->"6d92e45f-ab30-4116-95df-1ddaa0d0bfc0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"square", " ", "=", " ", 
     RowBox[{"InfraFibration", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
       RowBox[{"i", " ", "|->", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{"i", ",", " ", "4", ",", " ", "1"}], "]"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"triangle", " ", "=", " ", 
     RowBox[{"InfraFibration", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
       RowBox[{"i", " ", "|->", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{"i", ",", " ", "3", ",", " ", "1"}], "]"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraTotalGraph", "[", "square", "]"}], ",", " ", 
     RowBox[{"InfraFiberBundleQ", "[", "square", "]"}], ",", " ", 
     RowBox[{"InfraTotalGraph", "[", "triangle", "]"}], ",", " ", 
     RowBox[{"InfraFiberBundleQ", "[", "triangle", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2211c76e-99cc-4d99-85c1-064528a4ab3f"],

