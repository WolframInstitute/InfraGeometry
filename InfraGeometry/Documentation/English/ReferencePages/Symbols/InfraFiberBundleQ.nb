Cell[TextData[{
 "Isomorphic fibers and unique lifting are not enough. Here the fiber is a \
path ",
 StyleBox["a \[Minus] b \[Minus] c", "TI"],
 ", and the matching sends ",
 StyleBox["a, b, c", "TI"],
 " to ",
 StyleBox["a, c, b", "TI"],
 ", which breaks the edge ",
 StyleBox["ab", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"74b9dad7-4a5a-4724-ad8d-375297481985"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"Graph", "[", 
        RowBox[{"{", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<p\>\"", ",", " ", "\"\<a\>\""}], "}"}], " ", "<->", 
           " ", 
           RowBox[{"{", 
            RowBox[{"\"\<p\>\"", ",", " ", "\"\<b\>\""}], "}"}]}], ",", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<p\>\"", ",", " ", "\"\<b\>\""}], "}"}], " ", "<->", 
           " ", 
           RowBox[{"{", 
            RowBox[{"\"\<p\>\"", ",", " ", "\"\<c\>\""}], "}"}]}], ",", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<q\>\"", ",", " ", "\"\<a\>\""}], "}"}], " ", "<->", 
           " ", 
           RowBox[{"{", 
            RowBox[{"\"\<q\>\"", ",", " ", "\"\<b\>\""}], "}"}]}], ",", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<q\>\"", ",", " ", "\"\<b\>\""}], "}"}], " ", "<->", 
           " ", 
           RowBox[{"{", 
            RowBox[{"\"\<q\>\"", ",", " ", "\"\<c\>\""}], "}"}]}], ",", "\n", 
          "    ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<p\>\"", ",", " ", "\"\<a\>\""}], "}"}], " ", "<->", 
           " ", 
           RowBox[{"{", 
            RowBox[{"\"\<q\>\"", ",", " ", "\"\<a\>\""}], "}"}]}], ",", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<p\>\"", ",", " ", "\"\<b\>\""}], "}"}], " ", "<->", 
           " ", 
           RowBox[{"{", 
            RowBox[{"\"\<q\>\"", ",", " ", "\"\<c\>\""}], "}"}]}], ",", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<p\>\"", ",", " ", "\"\<c\>\""}], "}"}], " ", "<->", 
           " ", 
           RowBox[{"{", 
            RowBox[{"\"\<q\>\"", ",", " ", "\"\<b\>\""}], "}"}]}]}], "}"}], 
        "]"}], ",", " ", "First"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraIsomorphicFibersQ", "[", "fib", "]"}], ",", " ", 
        RowBox[{"InfraUniqueEdgeLiftingQ", "[", "fib", "]"}], ",", " ", 
        RowBox[{"InfraFiberBundleQ", "[", "fib", "]"}]}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"73184f8f-b851-46c8-96fa-d00373da6d7a"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{{"p", "a"}, {"p", "b"}, {"p", "c"}, {"q", "a"}, {"q", "b"}, {
       "q", "c"}}, {
      Null, {{1, 2}, {2, 3}, {4, 5}, {5, 6}, {1, 4}, {2, 6}, {3, 5}}}, {
