Cell[CellGroupData[{
Cell["InfraFiberBundleQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"dd9de4c9-437c-45f8-907b-1ad26ca7e981"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFiberBundleQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberBundleQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "248cf6d6-b2df-426b-b86c-5a391db8f695"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3376bcef-c19d-4cf6-b497-21c453409244"],
 " if ",
 StyleBox["fib", "TI"],
 " is a fiber bundle: its fibers are copies of one graph, and over every base \
edge the transverse edges match the two fibers by a graph isomorphism.",
 "\n"
}], "Usage",ExpressionUUID->"1c891728-6581-42e4-9a09-d2339b2dafab"],

Cell["The conditions are:", "Notes",ExpressionUUID->"fe45c860-be5d-45f4-8566-b6e79e496c14"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d09f9a76-e2e5-4bc2-9c51-6d2689dba75c"], Cell["Condition", "TableText",
     FontWeight->Bold,ExpressionUUID->"a608daae-808a-4c41-9516-7202a42aa020"],
     Cell["Test", "TableText",
     FontWeight->Bold,ExpressionUUID->"d181094e-888f-4e6a-a3ca-ca03332192ad"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5e6a2d7d-8e6c-4d51-8680-598804ea514b"], Cell[TextData[{
     "all fibers isomorphic to one graph ",
     StyleBox["F", "TI"]
    }], "TableText",ExpressionUUID->"9f420e3a-796b-49ef-995e-b70ee6706ecb"], 
    Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["InfraIsomorphicFibersQ"]], 
       "paclet:WolframInstitute/InfraGeometry/ref/InfraIsomorphicFibersQ", 
       "WolframInstitute/InfraGeometry Package Symbol"},
      "PackageLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "73c0d5b5-cc85-49e9-a096-3df3d5987f4a"]], "TableText",ExpressionUUID->
     "47709bda-021a-4436-b7b2-86c4eb887ebb"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fb9433ed-5369-40ac-a2b4-dd84c3caee6f"], Cell[TextData[{
     "at every vertex over ",
     StyleBox["p", "TI"],
     ", exactly one lift of each base edge ",
     StyleBox["pq", "TI"]
    }], "TableText",ExpressionUUID->"2ae9317a-e03f-4d39-8c1d-0caef76afda1"], 
    Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["InfraUniqueEdgeLiftingQ"]], 
       "paclet:WolframInstitute/InfraGeometry/ref/InfraUniqueEdgeLiftingQ", 
       "WolframInstitute/InfraGeometry Package Symbol"},
      "PackageLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "a9b3102e-efbe-4d14-b813-5eac73a5bb39"]], "TableText",ExpressionUUID->
     "f60d4787-e90e-4374-bf65-f8776d964d2a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "dfedf225-593d-4f3a-ad7a-c111547ffd30"], Cell[TextData[{
     "the matching ",
     StyleBox["F(p) \[RightArrow] F(q)", "TI"],
     " maps the edges of ",
     StyleBox["F(p)", "TI"],
     " onto the edges of ",
     StyleBox["F(q)", "TI"]
    }], "TableText",ExpressionUUID->"1bc08e92-fa52-4a6f-a19a-d8b74f8e3fda"], 
    Cell["", "TableText",ExpressionUUID->
     "3123f4b2-334a-4a16-ba69-981f36b18f18"]}
  }]], "2ColumnTableMod",ExpressionUUID->"b1443b3b-6b06-4b24-b190-\
f31760e5a29d"],

Cell[TextData[{
 "Over each base edge the bundle is then a product: the part over ",
 StyleBox["pq", "TI"],
 " is the Cartesian product of the edge with ",
 StyleBox["F", "TI"],
 "."
}], "Notes",ExpressionUUID->"c073ccab-36e8-47ce-a244-3678137a02b0"],

Cell[TextData[{
 "The product need not be global. Composing the matchings around a base cycle \
gives a permutation of a fiber, the holonomy, which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraHolonomy"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraHolonomy", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1be63602-1718-4e77-99dc-7535b231f03a"],
 " computes; it can be nontrivial. The prism and the Moebius ladder are both \
bundles over a cycle with fiber an edge."
}], "Notes",ExpressionUUID->"c94908c7-97ae-4e5c-871f-5ab7b98bcfb0"],

Cell[TextData[{
 "A bundle with fibers without edges is a covering (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCoveringQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCoveringQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0b95e87c-37ee-46b5-aa96-39d1d39b29a3"],
 "). A covering whose base components carry different numbers of sheets is \
not a bundle, since its fibers are not all isomorphic."
}], "Notes",ExpressionUUID->"7cc4d82f-7dea-417e-a58d-cecbeb946425"],

Cell[TextData[{
 "The empty fibered graph is a bundle. A list of objects gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12bf68df-6b0c-4655-b8a7-ec735f44ad1e"],
 " when every member is a bundle; the empty list gives ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ccd7e0aa-cf2a-4031-9ce3-e8ad94468893"],
 "."
}], "Notes",ExpressionUUID->"5fe427c9-7cc4-48ff-a7ef-7bd0b5eb8043"]
}, Open  ]],

