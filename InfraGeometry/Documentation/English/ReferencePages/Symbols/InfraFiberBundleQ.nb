 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell["\<\
The displacement bundles are fibrations but not bundles. Over the grid the \
fibers differ in size; over the triangular torus they agree, but a base edge \
has several lifts at a vertex:\
\>", "ExampleText",ExpressionUUID->"545c6577-b7dd-4e98-9f1e-894f13eed8fc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fib", " ", "=", " ", 
       RowBox[{"InfraFiberedSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"name", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraEqualFiberSizesQ", "[", "fib", "]"}], ",", " ", 
        RowBox[{"InfraUniqueEdgeLiftingQ", "[", "fib", "]"}], ",", " ", 
        RowBox[{"InfraFiberBundleQ", "[", "fib", "]"}]}], "}"}]}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<GridDisplacementBundle\>\"", ",", 
       " ", "\"\<TriangularTorusDisplacementBundle\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d98c1244-e0b9-48d2-8751-ebdace4dec83"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"GridDisplacementBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"False", ",", "False", ",", "False"}], "}"}]}], ",", 
   RowBox[{"\<\"TriangularTorusDisplacementBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False", ",", "False"}], "}"}]}]}], "}"}]], "Output",\

 CellLabel->"Out[1]= ",ExpressionUUID->"e69e897d-4dc4-4757-b369-152c749527e5"]
}, Open  ]]
}, Open  ]],

