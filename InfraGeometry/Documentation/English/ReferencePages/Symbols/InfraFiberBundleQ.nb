Cell["\<\
The trivial and covering entries of the catalogue are fiber bundles, the \
branched ones are not.\
\>", "ExampleText",ExpressionUUID->"116e2a1e-ddb1-4122-a8e7-3c5ab4c466ab"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"name", " ", "->", " ", 
    RowBox[{"InfraFiberBundleQ", " ", "@", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}]}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"Join", " ", "@@", " ", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"InfraFiberedSubstrate", "[", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Trivial\>\"", ",", " ", "\"\<Covering\>\"", ",", 
          " ", "\"\<NonBundle\>\""}], "}"}]}], "]"}]}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"22f02001-8770-4660-8d34-ffac54c7844e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"CycleProductBundle\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"GridProductBundle\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"CycleDoubleCover\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"MoebiusLadderCover\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"TriangularTorusDoubleCover\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"BranchedCycleFibration\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"BranchedGridFibration\"\>", "\[Rule]", "False"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"e40b8cba-9dad-410b-99da-f04d5ce7415f"]
}, Open  ]]
}, Open  ]],

