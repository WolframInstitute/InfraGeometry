Cell[TextData[{
 "The prism and the Moebius ladder over the cycle of length 8. Both are \
bundles with an edge as fiber. They differ only by a twist over one base \
edge, which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraHolonomy"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraHolonomy", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0ffc4b3a-a66b-4288-a412-cc531203807c"],
 " detects:"
}], "ExampleText",ExpressionUUID->"6f835c45-8ed1-49e9-8963-77f0ed251612"],

