Cell[TextData[{
 "The ball is round in the graph metric, not in the shape of the patch. On \
the square mesh a negative count trims the corners first, and ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c9be64b7-f4bd-4cf6-bcc4-b9dc774077be"],
 ", ",
 Cell[BoxData[
  RowBox[{"-", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e60c49d-934b-4110-b3f0-bc48845010cd"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae3dbe5a-2e43-4307-9f3b-fa98a460305b"],
 " still reach the sides."
}], "ExampleText",ExpressionUUID->"9164e8a8-927c-45a6-8d2a-2e55a385f453"],

