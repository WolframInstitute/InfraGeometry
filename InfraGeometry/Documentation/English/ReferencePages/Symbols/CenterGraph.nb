Cell[TextData[{
 "A bare fraction is not a count of hops, and the call stays unevaluated. The \
fraction is ",
 Cell[BoxData[
  RowBox[{"Scaled", "[", "q", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23dca8a2-c93c-436b-869c-2933e076ae84"],
 "."
}], "ExampleText",ExpressionUUID->"766e3a8f-0a3d-4769-b2d0-a9aa0db1b4a9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"CenterGraph", "[", 
       RowBox[{"g", ",", " ", "0.9"}], "]"}]}], ",", " ", 
     RowBox[{"VertexCount", " ", "@", " ", 
      RowBox[{"CenterGraph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"Scaled", "[", "0.9", "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2d18265b-1e5b-4af9-acdf-87aac872c48b"],

