Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"r", " ", "=", " ", 
     RowBox[{"GraphRadius", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"ListStepPlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"VertexCount", " ", "@", " ", 
          RowBox[{"CenterGraph", "[", 
           RowBox[{"g", ",", " ", "k"}], "]"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"-", "r"}], ",", " ", "r"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<k\>\"", ",", " ", "\"\<vertices\>\""}], "}"}]}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"bf270c0e-0c38-40cd-9b78-33c7b49ab047"],

