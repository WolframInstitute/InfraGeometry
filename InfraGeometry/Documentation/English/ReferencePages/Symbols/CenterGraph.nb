Cell["\<\
A construction made on the cut stays off the rim and draws on the whole \
substrate: three points drawn from the ball two hops short of the radius.\
\>", "ExampleText",ExpressionUUID->"968ddc30-428d-4277-b057-18d4bf468da2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"core", " ", "=", " ", 
     RowBox[{"CenterGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"-", "2"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"core", ",", " ", "3"}], "]"}]}], ")"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"VertexList", " ", "@", " ", "core"}], ",", " ", "points"}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f731025c-e5a4-4bf1-a5a0-239a1ce955f4"],

