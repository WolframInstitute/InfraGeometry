Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"r", " ", "=", " ", 
     RowBox[{"GraphRadius", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"ListStepPlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"VertexCount", " ", "@", " ", 
          RowBox[{"CenterGraph", "[", 
           RowBox[{"g", ",", " ", "k"}], "]"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"-", "r"}], ",", " ", "r"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<k\>\"", ",", " ", "\"\<vertices\>\""}], "}"}]}]}], 
    "]"}]}], "]"}]], "Input",
