Cell[TextData[{
 "The centre is ",
 Cell[BoxData[
  RowBox[{"GraphCenter", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a349c5d4-9eea-4612-a7ca-323c3eb53a00"],
 ", the vertices of least eccentricity, and the radius ",
 Cell[BoxData[
  RowBox[{"GraphRadius", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9928a192-158f-4156-8d38-634b0e3d5f71"],
 " is that eccentricity. ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", "k"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ceddcfdb-2c70-4c86-90c9-cad2e92b9cb5"],
 " is ",
 Cell[BoxData[
  RowBox[{"NeighborhoodGraph", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"GraphCenter", "[", "g", "]"}], ",", " ", "k"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad1f7e75-e278-4207-b5a3-194103a36f8c"],
 ", the subgraph induced on the vertices within ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bc1476f-10f0-4bd7-8c28-caee08132eb5"],
 " hops of the centre."
}], "Notes",ExpressionUUID->"3b06058c-eb1c-4e11-9f00-c26a6c3d1d99"],

Cell[TextData[{
 "A negative ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe4b5acc-37cc-4d6a-80d0-87f9fb611e8d"],
 " gives the radius ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"GraphRadius", "[", "g", "]"}], " ", "+", " ", "k"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26f0b85e-4c71-4f3f-88c3-63f6f0d7f2c0"],
 ", never below 0. On a patch that is itself a ball about its centre, as the \
tilings are, ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"-", "1"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "218a7a39-0b98-453d-94d0-a94aa801ff41"],
 " is the patch without its rim."
}], "Notes",ExpressionUUID->"4c758e8f-3401-44f5-b751-44c9d4599747"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Scaled", "[", "q", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14beeec1-3d88-41d7-bb83-d333b0114228"],
 " gives the radius ",
 Cell[BoxData[
  RowBox[{"Floor", "[", 
   RowBox[{"q", " ", 
    RowBox[{"GraphRadius", "[", "g", "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33ae248e-c319-4321-84f0-577f8b7f5656"],
 ", with ",
 Cell[BoxData["q"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b92aec7-9a77-4e3a-b023-f14cf940d393"],
 " clipped to ",
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"0", ",", " ", "1"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc50cfca-e461-4ffa-89d1-e0fe772d4926"],
 ": the same fraction of the radius on every size of a substrate."
}], "Notes",ExpressionUUID->"010a972b-fd07-46ff-b107-a26401e03cfb"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"k", " ", ">=", " ", 
   RowBox[{"GraphRadius", "[", "g", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2f595ee-c5eb-4284-90c2-b5d0b4acf75d"],
 " and ",
 Cell[BoxData[
  RowBox[{"Scaled", "[", "1", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8ba634d-1a56-46d8-bbe7-46e8c17103f4"],
 " give the whole graph; ",
 Cell[BoxData[
  RowBox[{"k", " ", "=", " ", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39ac4e80-5fc5-4a0c-9401-258ae62768e3"],
 " and ",
 Cell[BoxData[
  RowBox[{"Scaled", "[", "0", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b44b8eb2-8b3f-4268-b87d-28aee303af79"],
 " give the centre."
}], "Notes",ExpressionUUID->"29944ac2-89cc-46f9-b146-503050fcca8b"],

Cell[TextData[{
 "The cut keeps the vertex labels and coordinates of ",
 Cell[BoxData["g"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3ee107d-c59d-4f6c-af0a-959e09c8b772"],
 ", so a construction made on it draws on ",
 Cell[BoxData["g"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b7b29ff-2e19-468e-84ce-9eaaae3561c5"],
 "."
}], "Notes",ExpressionUUID->"a9417414-f6d5-4fab-b629-4e673daad46f"],

Cell["\<\
A disconnected graph is returned whole. On a vertex-transitive graph every \
vertex is a centre, so every cut is the whole graph.\
\>", "Notes",ExpressionUUID->"90216137-16b1-4542-bc0e-f695b1c83dcd"]
}, Open  ]],

