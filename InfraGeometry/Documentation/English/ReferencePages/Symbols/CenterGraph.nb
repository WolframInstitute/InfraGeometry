Cell[TextData[{
 "A bare fraction is not a count of hops, and the call stays unevaluated. The \
fraction is ",
 Cell[BoxData[
  RowBox[{"Scaled", "[", "q", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81dcbe37-4750-4344-8e7c-f2e77f06f010"],
 "."
}], "ExampleText",ExpressionUUID->"55237aa7-c55a-458d-80d0-89df8cafab13"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"CenterGraph", "[", 
       RowBox[{"g", ",", " ", "0.9"}], "]"}]}], ",", " ", 
     RowBox[{"VertexCount", " ", "@", " ", 
      RowBox[{"CenterGraph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"Scaled", "[", "0.9", "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1965aaa1-40bd-4a17-92e7-0d040e5c1e17"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"CenterGraph", ",", "85"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6e534bf2-4b23-4b0c-8116-6a35b346dabf"]
}, Open  ]],

Cell[TextData[{
 "The ball is round in the graph metric, not in the shape of the patch. On \
the square mesh a negative count trims the corners first, and ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff7c77ea-8248-4f0c-8324-4d5c38b82afd"],
 ", ",
 Cell[BoxData[
  RowBox[{"-", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f1a5340-0c4d-4984-a5d1-b5f9f35da4f5"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fd99504-4c36-4612-a8e0-893dc3a911b4"],
 " still reach the sides."
}], "ExampleText",ExpressionUUID->"cc356474-941e-430d-8858-64904e2643ea"],

