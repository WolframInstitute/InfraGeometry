Cell[TextData[{
 "The centre is ",
 Cell[BoxData[
  RowBox[{"GraphCenter", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dabb78e1-92f1-46b0-8b19-aa7d6177f12e"],
 ", the vertices of least eccentricity, and the radius ",
 Cell[BoxData[
  RowBox[{"GraphRadius", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e679602f-a09b-440a-87d8-ad1371286690"],
 " is that eccentricity. ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", "k"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7bcb811-95f4-43d0-b9fd-13bb6142668d"],
 " is ",
 Cell[BoxData[
  RowBox[{"NeighborhoodGraph", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"GraphCenter", "[", "g", "]"}], ",", " ", "k"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85cbfe4c-8ade-454e-984b-f92322292465"],
 ", the subgraph induced on the vertices within ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "184b41d0-dca1-499b-ad7a-7227f2427a39"],
 " hops of the centre."
}], "Notes",ExpressionUUID->"69148917-beb5-4b27-b891-42a1bd60e310"],

Cell[TextData[{
 "A negative ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bd2dd6b-1e54-4f46-b6b6-03a6e3bed029"],
 " gives the radius ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"GraphRadius", "[", "g", "]"}], " ", "+", " ", "k"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7e352d6-d617-4462-abd0-332d98889278"],
 ", never below 0. On a patch that is itself a ball about its centre, as the \
tilings are, ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"-", "1"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81c794ce-314b-42ec-9715-d677f8340aa1"],
 " is the patch without its rim."
}], "Notes",ExpressionUUID->"e546a268-1e16-4836-b53b-ba40242e31e3"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Scaled", "[", "q", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "260ec717-9098-4820-b127-ac363402da9a"],
 " gives the radius ",
 Cell[BoxData[
  RowBox[{"Floor", "[", 
   RowBox[{"q", " ", 
    RowBox[{"GraphRadius", "[", "g", "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8694a3f-2678-4bd3-955e-fd62a58f41cf"],
 ", with ",
 Cell[BoxData["q"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20d7fd39-75a8-41a4-8d64-4ccfa7ac29fa"],
 " clipped to ",
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"0", ",", " ", "1"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7581dce-ebc3-4f9e-b584-0bcb5bdbb596"],
 ": the same fraction of the radius on every size of a substrate."
}], "Notes",ExpressionUUID->"4a3a27f3-57ff-46a0-8a86-664c4cfd2254"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"k", " ", ">=", " ", 
   RowBox[{"GraphRadius", "[", "g", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08b32b4a-1dd7-4093-a5bb-28c2d0a7ec83"],
 " and ",
 Cell[BoxData[
  RowBox[{"Scaled", "[", "1", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2464ce33-a5c7-4f54-b59d-93603023d5a9"],
 " give the whole graph; ",
 Cell[BoxData[
  RowBox[{"k", " ", "=", " ", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20a0541f-7d09-418c-804e-3be505c8979c"],
 " and ",
 Cell[BoxData[
  RowBox[{"Scaled", "[", "0", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "071be75a-d25e-4d73-aaa0-72832d254e85"],
 " give the centre."
}], "Notes",ExpressionUUID->"b856a541-0b52-402d-a220-75907cb75d67"],

Cell[TextData[{
 "The cut keeps the vertex labels and coordinates of ",
 Cell[BoxData["g"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99933e56-d31e-438a-9990-450d4cac8b6c"],
 ", so a construction made on it draws on ",
 Cell[BoxData["g"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3229619-c23d-4701-b52e-0c67a9560d73"],
 "."
}], "Notes",ExpressionUUID->"eb53e85f-c5a9-4c69-a878-a91b71309d7f"],

Cell["\<\
A disconnected graph is returned whole. On a vertex-transitive graph every \
vertex is a centre, so every cut is the whole graph.\
\>", "Notes",ExpressionUUID->"40f06315-9aba-40f1-b2ce-2339243efe4a"]
}, Open  ]],

