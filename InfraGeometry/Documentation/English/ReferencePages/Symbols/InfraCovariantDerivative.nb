Cell["\<\
The field must have a value at both ends of a step. Without a value at 65 the \
derivative at 55 is missing:\
\>", "ExampleText",ExpressionUUID->"3c152cd7-750c-4d71-98e6-6908fe647de9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraDisplacementBundle", "[", 
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}],
        ",", " ", "1"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"partial", " ", "=", " ", 
     RowBox[{"InfraSection", "[", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"45", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"45", ",", " ", "46"}], "}"}]}], ",", " ", 
        RowBox[{"55", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"55", ",", " ", "56"}], "}"}]}]}], "|>"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraCovariantDerivative", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}], ",", " ", 
     "partial", ",", " ", 
     RowBox[{"{", 
      RowBox[{"45", ",", " ", "55", ",", " ", "65"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d0f428a3-17a1-46c5-ba09-a126eb5ce932"],

