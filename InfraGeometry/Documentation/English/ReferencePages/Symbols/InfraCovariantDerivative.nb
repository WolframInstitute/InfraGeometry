Cell["\<\
A field that points up at 45 and to the right at 55 and 65. Its derivative at \
45 is the vector from 45 to 54, one step right and one down, the difference \
of the two vectors; at 55 it is zero:\
\>", "ExampleText",ExpressionUUID->"b6754efa-f641-48f2-8ad7-4617a752691e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"fib", " ", "=", " ", 
      RowBox[{"InfraDisplacementBundle", "[", 
       RowBox[{"g", ",", " ", "1"}], "]"}]}], ",", " ", 
     RowBox[{"walk", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"45", ",", " ", "55", ",", " ", "65"}], "}"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"turn", " ", "=", " ", 
     RowBox[{"InfraSection", "[", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"45", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"45", ",", " ", "46"}], "}"}]}], ",", " ", 
        RowBox[{"55", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"55", ",", " ", "65"}], "}"}]}], ",", " ", 
        RowBox[{"65", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"65", ",", " ", "75"}], "}"}]}]}], "|>"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"derivative", " ", "=", " ", 
     RowBox[{"InfraCovariantDerivative", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}], ",", " ", 
       "turn", ",", " ", "walk"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraWalk", "[", "walk", "]"}], ",", " ", 
       RowBox[{"InfraWalk", " ", "/@", " ", 
        RowBox[{"Values", "[", 
         RowBox[{"First", " ", "@", " ", "turn"}], "]"}]}], ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"45", ",", " ", 
         RowBox[{"derivative", "[", "45", "]"}]}], "]"}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", "derivative"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1e17a164-44b7-446e-b972-3da18449071b"],

