Cell[CellGroupData[{
Cell["InfraCovariantDerivative", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"dfd10b17-1df8-4d24-a976-435eb7cbab76"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCovariantDerivative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCovariantDerivative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["conn", "TI"], ",", " ", 
    RowBox[{"InfraSection", "[", 
     StyleBox["s", "TI"], "]"}], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f32a89d-ff2a-4b02-ba03-b9ed6638d8c2"],
 "\[LineSeparator]",
 "gives the covariant derivative of the vector field ",
 StyleBox["s", "TI"],
 " along ",
 StyleBox["walk", "TI"],
 ": an association from each vertex ",
 StyleBox["p", "TI"],
 " of ",
 StyleBox["walk", "TI"],
 " but the last to a vertex ",
 StyleBox["x", "TI"],
 ", the derivative being the vector ",
 StyleBox["p", "TI"],
 " \[RightArrow] ",
 StyleBox["x", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"fad8378e-519e-4f99-8c8e-8d11fb758dcd"],

Cell[TextData[{
 "The field ",
 StyleBox["s", "TI"],
 " sends a vertex ",
 StyleBox["p", "TI"],
 " to a pair {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "}, the vector ",
 StyleBox["p", "TI"],
 " \[RightArrow] ",
 StyleBox["v", "TI"],
 ". For a step ",
 StyleBox["p", "TI"],
 " \[RightArrow] ",
 StyleBox["q", "TI"],
 " of the walk:"
}], "Notes",ExpressionUUID->"17fa5323-3e28-44c8-b1f5-4a5995d02b5d"],

Cell[TextData[{
 StyleBox["conn", "TI"],
 " carries ",
 StyleBox["s(q)", "TI"],
 " back to a vector ",
 StyleBox["p", "TI"],
 " \[RightArrow] ",
 StyleBox["v\[Prime]", "TI"],
 " at ",
 StyleBox["p", "TI"],
 ";"
}], "Notes",ExpressionUUID->"b8475652-c912-4069-b5a5-297ffb31a056"],

Cell[TextData[{
 "the arrow ",
 StyleBox["v", "TI"],
 " \[RightArrow] ",
 StyleBox["v\[Prime]", "TI"],
 " is carried to ",
 StyleBox["p", "TI"],
 " along a shortest path from ",
 StyleBox["v", "TI"],
 ", by the Levi-Civita transports at its own length ",
 StyleBox["d(v, v\[Prime])", "TI"],
 ";"
}], "Notes",ExpressionUUID->"9f0ba6e2-9f32-4294-b4fc-a02581573c53"],

Cell[TextData[{
 StyleBox["x", "TI"],
 " is the endpoint of the carried arrow nearest to ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"3955e512-38e5-4d90-bfc7-3712ff84f334"],

Cell[TextData[{
 "The derivative is zero, ",
 StyleBox["x = p", "TI"],
 ", exactly when ",
 StyleBox["conn", "TI"],
 " carries ",
 StyleBox["s(q)", "TI"],
 " back to ",
 StyleBox["s(p)", "TI"],
 "."
}], "Notes",ExpressionUUID->"9bd49e3a-93fc-40e7-bbf2-6dd38271e19f"],

Cell[TextData[{
 "At the centre of the square grid the Levi-Civita connection is the \
translation, and in the examples below the derivative is the difference of \
the vectors: ",
 StyleBox["x \[Minus] p = s(q) \[Minus] s(p)", "TI"],
 " in coordinates."
}], "Notes",ExpressionUUID->"8176f915-102e-4898-8aec-80f12bc4ccbe"],

Cell[TextData[{
 "The arrow is carried by the Levi-Civita transports whatever ",
 StyleBox["conn", "TI"],
 " is. A vertex where ",
 StyleBox["s", "TI"],
 " has no value gets ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Missing"]], "paclet:ref/Missing"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6465d1d0-8c13-4424-871b-261fdac3dd86"],
 "."
}], "Notes",ExpressionUUID->"f3766b25-ac38-450b-ad89-5f79fec844a8"],

