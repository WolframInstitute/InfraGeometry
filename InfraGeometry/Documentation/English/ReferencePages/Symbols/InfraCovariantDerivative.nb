Cell["\<\
The up field on the grid along a walk to the right: the Levi-Civita \
connection carries each value to the next, and the derivative is zero at \
every step.\
\>", "ExampleText",ExpressionUUID->"8c213941-5406-480f-9c8d-fc4abf110fd3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridDisplacementBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"g", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", "fib"}]}], ",", " ", 
     RowBox[{"conn", " ", "=", " ", 
      RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"up", " ", "=", " ", 
     RowBox[{"InfraSection", " ", "@", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{"p", " ", "|->", " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", 
           RowBox[{"p", " ", "+", " ", "1"}]}], "}"}]}], ",", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Range", "[", "16", "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{"#", ",", " ", "4"}], "]"}], " ", "!=", " ", "0"}], " ", 
           "&"}]}], "]"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walk", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "6", ",", " ", "10"}], "}"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "walk", "]"}], ",", " ", 
           RowBox[{"Directive", "[", "StandardBlue", "]"}]}], "}"}], ",", " ", 
         RowBox[{"InfraWalk", " ", "/@", " ", 
          RowBox[{"Lookup", "[", 
           RowBox[{
            RowBox[{"First", " ", "@", " ", "up"}], ",", " ", "walk"}], 
           "]"}]}]}], "]"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"InfraCovariantDerivative", "[", 
       RowBox[{"fib", ",", " ", "conn", ",", " ", "up", ",", " ", "walk"}], 
       "]"}]}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7b91b099-149f-42b5-9dee-e6f34458e995"],

