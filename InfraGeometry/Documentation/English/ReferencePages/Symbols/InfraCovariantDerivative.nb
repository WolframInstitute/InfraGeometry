Cell[TextData[{
 "In the numbering of the small square grid, ",
 StyleBox["p", "TI"],
 " + 1 is the vertex above ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["p", "TI"],
 " + 10 the vertex to its right; 45 is the centre. The field pointing up, \
along a walk to the right, has derivative zero at every step:"
}], "ExampleText",ExpressionUUID->"0f273fad-fc17-419a-9e57-339473a3a3ba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"fib", " ", "=", " ", 
      RowBox[{"InfraDisplacementBundle", "[", 
       RowBox[{"g", ",", " ", "1"}], "]"}]}], ",", " ", 
     RowBox[{"walk", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"45", ",", " ", "55", ",", " ", "65", ",", " ", "75"}], 
       "}"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"up", " ", "=", " ", 
     RowBox[{"InfraSection", " ", "@", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{"p", " ", "|->", " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", 
           RowBox[{"p", " ", "+", " ", "1"}]}], "}"}]}], ",", " ", "walk"}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"derivative", " ", "=", " ", 
     RowBox[{"InfraCovariantDerivative", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}], ",", " ", 
       "up", ",", " ", "walk"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraWalk", "[", "walk", "]"}], ",", " ", 
       RowBox[{"InfraWalk", " ", "/@", " ", 
        RowBox[{"Values", "[", 
         RowBox[{"First", " ", "@", " ", "up"}], "]"}]}]}], "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", "derivative"}], ",", "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5d5dc03a-5868-4561-971a-73525f2b89c5"],

