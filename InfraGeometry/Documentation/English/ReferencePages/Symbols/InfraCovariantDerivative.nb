Cell["\<\
A field that turns from up to the right between the first two vertices of the \
walk has a nonzero derivative there, and zero after.\
\>", "ExampleText",ExpressionUUID->"9c32eae2-c966-41c2-a30c-ab07c06ed3a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridDisplacementBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"g", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", "fib"}]}], ",", " ", 
     RowBox[{"conn", " ", "=", " ", 
      RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"turn", " ", "=", " ", 
     RowBox[{"InfraSection", "[", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"2", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", " ", 
        RowBox[{"6", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"6", ",", " ", "10"}], "}"}]}], ",", " ", 
        RowBox[{"10", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"10", ",", " ", "14"}], "}"}]}]}], "|>"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walk", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "6", ",", " ", "10"}], "}"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "walk", "]"}], ",", " ", 
           RowBox[{"Directive", "[", "StandardBlue", "]"}]}], "}"}], ",", " ", 
         RowBox[{"InfraWalk", " ", "/@", " ", 
          RowBox[{"Values", " ", "@", " ", 
           RowBox[{"First", " ", "@", " ", "turn"}]}]}]}], "]"}]}], "]"}], ",",
      "\n", "    ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"InfraCovariantDerivative", "[", 
       RowBox[{"fib", ",", " ", "conn", ",", " ", "turn", ",", " ", "walk"}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f67b09f6-ff66-4f03-b0dd-6c0be6b74216"],

