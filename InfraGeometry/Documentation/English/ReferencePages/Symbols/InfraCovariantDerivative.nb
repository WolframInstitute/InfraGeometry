Cell["InfraCovariantDerivative", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ca57d10a-f5b7-4f12-94bb-234ebe931f75"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCovariantDerivative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCovariantDerivative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["conn", "TI"], ",", " ", 
    RowBox[{"InfraSection", "[", 
     StyleBox["s", "TI"], "]"}], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a071b8ac-4f39-48b0-b057-00eb7f77a5c9"],
 "\[LineSeparator]",
 "gives an association from each vertex ",
 StyleBox["p", "TI"],
 " of ",
 StyleBox["walk", "TI"],
 " but the last to a vertex ",
 StyleBox["x", "TI"],
 ": for the step ",
 StyleBox["p", "TI"],
 " -> ",
 StyleBox["q", "TI"],
 ", ",
 StyleBox["conn", "TI"],
 " carries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "[", 
   StyleBox["q", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "476325ac-0c08-4e19-bf51-b56223a20abd"],
 " back to ",
 StyleBox["p", "TI"],
 ", the arrow from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b24d2e4-f736-4c4f-bf57-e22bda26db30"],
 " to that image is carried to ",
 StyleBox["p", "TI"],
 " by the Levi-Civita transports at its own length, and ",
 StyleBox["x", "TI"],
 " is the endpoint nearest to ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["x", "TI"],
 " = ",
 StyleBox["p", "TI"],
 " for zero.",
 "\n"
}], "Usage",ExpressionUUID->"72ac51f9-ecfb-4bc8-b768-2f77f5048a68"],

Cell[TextData[{
 "The derivative at ",
 StyleBox["p", "TI"],
 " is the displacement ",
 StyleBox["p", "TI"],
 " -> ",
 StyleBox["x", "TI"],
 ". It is zero, ",
 StyleBox["x", "TI"],
 " = ",
 StyleBox["p", "TI"],
 ", when ",
 StyleBox["conn", "TI"],
 " carries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "[", 
   StyleBox["q", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b4d2e86-1484-4116-bb74-499b674156d5"],
 " back to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39df580d-f1a9-4f3e-80ca-a2c609c4efe7"],
 "."
}], "Notes",ExpressionUUID->"a3c861bf-e647-430a-beeb-f331ca993291"],

Cell[TextData[{
 "The arrow is carried by the Levi-Civita transports whatever ",
 StyleBox["conn", "TI"],
 " is. For a ",
 StyleBox["conn", "TI"],
 " other than ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraLeviCivitaConnection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraLeviCivitaConnection",
     "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bab51fe6-2ce7-424c-878a-a66292401d7e"],
 " the result mixes the two connections."
}], "Notes",ExpressionUUID->"ce870e4f-c256-479d-a4c8-ee8efb4051af"],

Cell[TextData[{
 "A vertex where ",
