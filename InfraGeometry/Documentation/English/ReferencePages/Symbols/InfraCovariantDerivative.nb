Cell[TextData[{
 "On the grid the derivative over the step 45 \[RightArrow] 55 is ",
 StyleBox["s(55) \[Minus] s(45)", "TI"],
 " in coordinates. With ",
 StyleBox["s(45)", "TI"],
 " pointing up and ",
 StyleBox["s(55)", "TI"],
 " pointing up, right, down and left:"
}], "ExampleText",ExpressionUUID->"edc35037-e7d2-49e8-b6f4-2f85b45deb6e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"xy", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"Round", " ", "@", " ", 
         RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "]"}]}], ",", " ", 
     RowBox[{"fib", " ", "=", " ", 
      RowBox[{"InfraDisplacementBundle", "[", 
       RowBox[{"g", ",", " ", "1"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"xy", "[", 
         RowBox[{
          RowBox[{"InfraCovariantDerivative", "[", 
           RowBox[{"fib", ",", " ", "conn", ",", " ", 
            RowBox[{"InfraSection", "[", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"45", " ", "->", " ", 
                RowBox[{"{", 
                 RowBox[{"45", ",", " ", "46"}], "}"}]}], ",", " ", 
               RowBox[{"55", " ", "->", " ", 
                RowBox[{"{", 
                 RowBox[{"55", ",", " ", "w"}], "}"}]}]}], "|>"}], "]"}], ",",
             " ", 
            RowBox[{"{", 
             RowBox[{"45", ",", " ", "55"}], "}"}]}], "]"}], "[", "45", "]"}],
          "]"}], " ", "-", " ", 
        RowBox[{"xy", "[", "45", "]"}]}], ",", "\n", "      ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"xy", "[", "w", "]"}], " ", "-", " ", 
          RowBox[{"xy", "[", "55", "]"}]}], ")"}], " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"xy", "[", "46", "]"}], " ", "-", " ", 
          RowBox[{"xy", "[", "45", "]"}]}], ")"}]}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"{", 
      RowBox[{"w", ",", " ", 
       RowBox[{"{", 
        RowBox[{"56", ",", " ", "65", ",", " ", "54", ",", " ", "45"}], 
        "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b85d8f4a-2aba-4a70-88d7-4c86d919c15c"],

