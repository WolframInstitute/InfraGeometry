Cell[CellGroupData[{
Cell["InfraCovariantDerivative", "ObjectName",ExpressionUUID->"d1bf133a-4acd-445d-a096-9dddf9546543"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"22be5352-24b3-4652-b164-d7c7731c4def"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCovariantDerivative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCovariantDerivative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["conn", "TI"], ",", " ", 
    RowBox[{"InfraSection", "[", 
     StyleBox["s", "TI"], "]"}], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ed1dead-35c9-4714-a0e3-c8b58bffab4a"],
 "\[LineSeparator]",
 "gives an association from each vertex ",
 StyleBox["p", "TI"],
 " of ",
 StyleBox["walk", "TI"],
 " but the last to a vertex ",
 StyleBox["x", "TI"],
 ": for the step ",
 StyleBox["p", "TI"],
 " -> ",
 StyleBox["q", "TI"],
 ", ",
 StyleBox["conn", "TI"],
 " carries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "[", 
   StyleBox["q", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "059584d5-58b3-4f08-9b0e-7ee5727b8fd5"],
 " back to ",
 StyleBox["p", "TI"],
 ", the arrow from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02377a5e-799d-4be3-b022-027236a400aa"],
 " to that image is carried to ",
 StyleBox["p", "TI"],
 " by the Levi-Civita transports at its own length, and ",
 StyleBox["x", "TI"],
 " is the endpoint nearest to ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["x", "TI"],
 " = ",
 StyleBox["p", "TI"],
 " for zero.",
 "\n"
}], "Usage",ExpressionUUID->"4967bc47-9ccc-4bb1-9016-72ef07ba5b16"],

Cell["\<\
This is a particular Experimental construction in the Infra Fiber Bundles \
category. Its existing call forms remain available.\
\>", "Notes",ExpressionUUID->"b3e3d3e0-35d5-4b06-95ae-537ae574c561"],

Cell[TextData[{
 "The derivative at ",
 StyleBox["p", "TI"],
 " is the displacement ",
 StyleBox["p", "TI"],
 " -> ",
 StyleBox["x", "TI"],
 ". It is zero, ",
 StyleBox["x", "TI"],
 " = ",
 StyleBox["p", "TI"],
 ", when ",
 StyleBox["conn", "TI"],
 " carries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "[", 
   StyleBox["q", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0316a82-d580-4f74-a385-d34c777bd228"],
 " back to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74e0c72e-1875-4116-913f-df6a885e61d0"],
 "."
}], "Notes",ExpressionUUID->"915fe259-39b1-46fa-82a0-b55b2ecd8aa3"],

Cell[TextData[{
 "The arrow is carried by the Levi-Civita transports whatever ",
 StyleBox["conn", "TI"],
 " is. For a ",
 StyleBox["conn", "TI"],
 " other than ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraLeviCivitaConnection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraLeviCivitaConnection",
     "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "661f3f4d-1629-4f18-aaf2-e2e19fc72569"],
 " the result mixes the two connections."
}], "Notes",ExpressionUUID->"0372266d-9f86-47e9-abfd-4ab9c88bc68a"],

