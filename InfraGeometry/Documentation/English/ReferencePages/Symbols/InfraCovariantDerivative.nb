Cell[CellGroupData[{
Cell["InfraCovariantDerivative", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"426d187a-8912-4437-9ee4-1ddda2388e02"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCovariantDerivative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCovariantDerivative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["conn", "TI"], ",", " ", 
    RowBox[{"InfraSection", "[", 
     StyleBox["s", "TI"], "]"}], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dda59d4-90eb-402b-b14d-731c2aedd92a"],
 "\[LineSeparator]",
 "gives an association from each vertex ",
 StyleBox["p", "TI"],
 " of ",
 StyleBox["walk", "TI"],
 " but the last to a vertex ",
 StyleBox["x", "TI"],
 ": for the step ",
 StyleBox["p", "TI"],
 " -> ",
 StyleBox["q", "TI"],
 ", ",
 StyleBox["conn", "TI"],
 " carries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "[", 
   StyleBox["q", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53275478-87bb-4764-85aa-35a893170086"],
 " back to ",
 StyleBox["p", "TI"],
 ", the arrow from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f93e82c-cb56-4bf4-8376-aab0eae1b7c8"],
 " to that image is carried to ",
 StyleBox["p", "TI"],
 " by the Levi-Civita transports at its own length, and ",
 StyleBox["x", "TI"],
 " is the endpoint nearest to ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["x", "TI"],
 " = ",
 StyleBox["p", "TI"],
 " for zero.",
 "\n"
}], "Usage",ExpressionUUID->"f9a62ec0-1561-4605-8e53-8e71e74cd0c0"],

Cell[TextData[{
 "The derivative at ",
 StyleBox["p", "TI"],
 " is the displacement ",
 StyleBox["p", "TI"],
 " -> ",
 StyleBox["x", "TI"],
 ". It is zero, ",
 StyleBox["x", "TI"],
 " = ",
 StyleBox["p", "TI"],
 ", when ",
 StyleBox["conn", "TI"],
 " carries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "[", 
   StyleBox["q", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "817d71f0-bfa4-4980-9735-a7f7d90a15e4"],
 " back to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df85a1ee-3e8d-4a09-b37f-616480684c07"],
 "."
}], "Notes",ExpressionUUID->"c6ed83e9-2514-4005-a66d-d8a8263de9c3"],

Cell[TextData[{
 "The arrow is carried by the Levi-Civita transports whatever ",
 StyleBox["conn", "TI"],
 " is. For a ",
 StyleBox["conn", "TI"],
 " other than ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraLeviCivitaConnection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraLeviCivitaConnection",
     "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6f7cbbc9-f765-4545-b2e3-fb5bf6f55cea"],
 " the result mixes the two connections."
}], "Notes",ExpressionUUID->"726115ce-63c2-4064-b116-87f150d41281"],

Cell[TextData[{
 "A vertex where ",
 StyleBox["s", "TI"],
 " has no value, or where the transport is blocked, gets ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Missing"]], "paclet:ref/Missing"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
