Cell["\<\
A field that turns from up to the right between the first two vertices of the \
walk has a nonzero derivative there, and zero after.\
\>", "ExampleText",ExpressionUUID->"61be7b84-2dfc-480b-9cc7-0c9e1f6b7369"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridDisplacementBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"g", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", "fib"}]}], ",", " ", 
     RowBox[{"conn", " ", "=", " ", 
      RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"turn", " ", "=", " ", 
     RowBox[{"InfraSection", "[", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"2", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", " ", 
        RowBox[{"6", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"6", ",", " ", "10"}], "}"}]}], ",", " ", 
        RowBox[{"10", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"10", ",", " ", "14"}], "}"}]}]}], "|>"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walk", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "6", ",", " ", "10"}], "}"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraWalk", "[", "walk", "]"}], ",", " ", 
           RowBox[{"Directive", "[", "StandardBlue", "]"}]}], "}"}], ",", " ", 
         RowBox[{"InfraWalk", " ", "/@", " ", 
          RowBox[{"Values", " ", "@", " ", 
           RowBox[{"First", " ", "@", " ", "turn"}]}]}]}], "]"}]}], "]"}], ",",
      "\n", "    ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"InfraCovariantDerivative", "[", 
       RowBox[{"fib", ",", " ", "conn", ",", " ", "turn", ",", " ", "walk"}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"75c18fde-3356-4dab-b56a-15fcac5e286f"],

