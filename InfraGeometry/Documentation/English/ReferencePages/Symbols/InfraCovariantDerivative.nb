Cell[CellGroupData[{

Cell["Method", "ExampleSubsection",ExpressionUUID->"08e5561a-cd39-44cb-953d-af1f0171178b"],

Cell["On the grid the comparison angle gives the same derivative:", \
"ExampleText",ExpressionUUID->"96623e56-baeb-4c34-b92c-5376fbf61c3b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraDisplacementBundle", "[", 
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}],
        ",", " ", "1"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"conn", " ", "=", " ", 
      RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}], ",", " ", 
     
     RowBox[{"turn", " ", "=", " ", 
      RowBox[{"InfraSection", "[", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"45", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"45", ",", " ", "46"}], "}"}]}], ",", " ", 
         RowBox[{"55", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"55", ",", " ", "65"}], "}"}]}], ",", " ", 
         RowBox[{"65", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"65", ",", " ", "75"}], "}"}]}]}], "|>"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraCovariantDerivative", "[", 
      RowBox[{"fib", ",", " ", "conn", ",", " ", "turn", ",", " ", 
       RowBox[{"{", 
        RowBox[{"45", ",", " ", "55", ",", " ", "65"}], "}"}], ",", " ", 
       RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Arclength\>\"", ",", " ", "\"\<Alexandrov\>\""}], 
        "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"238b2357-f734-4458-9f02-9cd90a713b0f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"45", "\[Rule]", "54"}], ",", 
     RowBox[{"55", "\[Rule]", "55"}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"45", "\[Rule]", "54"}], ",", 
     RowBox[{"55", "\[Rule]", "55"}]}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"617783a9-eb1f-4a69-83e3-17c6df098481"]
