Cell[CellGroupData[{
Cell["InfraCovariantDerivative", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"17c8cbdc-852e-4419-af7a-bd0876ce1e68"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCovariantDerivative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCovariantDerivative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"InfraDisplacementBundle", "[", 
     RowBox[{
      StyleBox["g", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["conn", "TI"], ",", " ", 
    RowBox[{"InfraSection", "[", 
     StyleBox["s", "TI"], "]"}], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c1206b5-c6a1-455b-84e5-59db588dfe33"],
 "\[LineSeparator]",
 "gives an association from each vertex ",
 StyleBox["p", "TI"],
 " of ",
 StyleBox["walk", "TI"],
 " but the last to a vertex ",
 StyleBox["x", "TI"],
 ": for the step ",
 StyleBox["p", "TI"],
 " -> ",
 StyleBox["q", "TI"],
 ", ",
 StyleBox["conn", "TI"],
 " carries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "[", 
   StyleBox["q", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c6b1fd0-b7e5-4d2d-871f-4bf0516751ca"],
 " back to ",
 StyleBox["p", "TI"],
 ", the arrow from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5d85c83-2913-4d42-a9d0-24069bcbda0b"],
 " to that image is carried to ",
 StyleBox["p", "TI"],
 " by the Levi-Civita transports at its own length, and ",
 StyleBox["x", "TI"],
 " is the endpoint nearest to ",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["x", "TI"],
 " = ",
 StyleBox["p", "TI"],
 " for zero.",
 "\n"
}], "Usage",ExpressionUUID->"5eca90bf-b4a8-4cca-8ebd-ebdec31dd0b2"],

Cell[TextData[{
 "The derivative at ",
 StyleBox["p", "TI"],
 " is the displacement ",
 StyleBox["p", "TI"],
 " -> ",
 StyleBox["x", "TI"],
 ". It is zero, ",
 StyleBox["x", "TI"],
 " = ",
 StyleBox["p", "TI"],
 ", when ",
 StyleBox["conn", "TI"],
 " carries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "[", 
   StyleBox["q", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4df89d0-d0bd-455c-8314-a593a66a9e6d"],
 " back to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a15214c-7d1c-4691-882a-99bfc0e6e86d"],
 "."
}], "Notes",ExpressionUUID->"d4c91f28-5588-46a2-aad9-7be9f8156ac8"],

Cell[TextData[{
 "The arrow is carried by the Levi-Civita transports whatever ",
 StyleBox["conn", "TI"],
 " is. For a ",
 StyleBox["conn", "TI"],
 " other than ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraLeviCivitaConnection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraLeviCivitaConnection",
     "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4509d7c8-5264-4893-b5a8-d2ebb6f495f1"],
 " the result mixes the two connections."
}], "Notes",ExpressionUUID->"286297a0-5864-48c2-bd7f-fa6fe79d9e23"],

Cell[TextData[{
 "A vertex where ",
 StyleBox["s", "TI"],
 " has no value, or where the transport is blocked, gets ",
