Cell[TextData[{
 "The M\[ODoubleDot]bius function of the diamond ",
 StyleBox["1 < 2, 3 < 4", "TI"],
 ": it reaches from the top past the links to the bottom."
}], "ExampleText",ExpressionUUID->"8b1e1a6b-43dd-4fc7-a246-b30eb297a3a9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Normal", " ", "@", " ", 
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    RowBox[{"Graph", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"2", " ", "->", " ", "4"}], ",", " ", 
        RowBox[{"3", " ", "->", " ", "4"}]}], "}"}]}], "]"}], ",", " ", 
    RowBox[{"InfraDerivative", "[", 
     RowBox[{"0", " ", "&"}], "]"}], ",", " ", "\"\<Kernel\>\""}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5fd27f59-f41a-4971-8c24-7f503abee7ea"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", "1"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
