Cell["\<\
The zeta and the path-count derivative of the same function differ at the top \
by its value at the bottom.\
\>", "ExampleText",ExpressionUUID->"cecc9f37-f577-46ff-a75a-d4a08bb49e59"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"diamond", " ", "=", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
          RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
          RowBox[{"2", " ", "->", " ", "4"}], ",", " ", 
          RowBox[{"3", " ", "->", " ", "4"}]}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"2", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
        RowBox[{"4", " ", "->", " ", "7"}]}], "|>"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"Normal", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"diamond", ",", " ", 
        RowBox[{"InfraDerivative", "[", "f", "]"}], ",", 
        " ", "\"\<Function\>\""}], "]"}], ",", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"diamond", ",", " ", 
        RowBox[{"InfraDerivative", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<PathCount\>\""}]}], "]"}], ",",
         " ", "\"\<Function\>\""}], "]"}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"89817720-79bc-49e6-bed3-812084332b9d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "\[Rule]", "2"}], ",", 
     RowBox[{"2", "\[Rule]", "1"}], ",", 
     RowBox[{"3", "\[Rule]", "3"}], ",", 
     RowBox[{"4", "\[Rule]", "1"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "\[Rule]", "2"}], ",", 
     RowBox[{"2", "\[Rule]", "1"}], ",", 
     RowBox[{"3", "\[Rule]", "3"}], ",", 
     RowBox[{"4", "\[Rule]", 
      RowBox[{"-", "1"}]}]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"f107c728-cbf2-473c-8ae7-07d5ab5d6c47"]
}, Open  ]],

Cell["\<\
The derivative undoes the antiderivative from the centre of the discretized \
plane, the square grid and the hexagonal tiling, for every method.\
\>", "ExampleText",ExpressionUUID->"4db30792-80d0-44c4-8265-ef4fb3d40909"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
       RowBox[{"f", " ", "=", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{"RandomInteger", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "9"}], ",", " ", "9"}], "}"}], ",", " ", 
            RowBox[{"VertexCount", "[", "g", "]"}]}], "]"}]}], "]"}]}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<Zeta\>\"", ",", " ", "\"\<PathCount\>\"", ",", 
         " ", "\"\<BackwardRandomWalk\>\"", ",", " ", "\"\<UniformChain\>\"", 
         ",", " ", "\"\<ForwardRandomWalk\>\""}], "}"}], ",", "\n", "      ", 
       
       RowBox[{
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
