        Cell[
         TextData["Association"]], "paclet:ref/Association"},
       "RefLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "72e31a8c-9e81-404b-b602-68b73ae8771d"],
     " ",
     Cell[BoxData[
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "v"}], "}"}], " ", "->", " ", 
       RowBox[{
        RowBox[{"K", "^", 
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}]}], 
        RowBox[{"(", 
         RowBox[{"u", ",", " ", "v"}], ")"}]}]}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5674c272-9746-449d-a2c7-12963da8db51"],
     " over the pairs ",
     StyleBox["u \[PrecedesEqual] v", "TI"],
     " with a nonzero value; for ",
     Cell[BoxData["\"\<Zeta\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "26d448aa-a1ea-4b81-b16a-683bdedbc0f9"],
     " the M\[ODoubleDot]bius function"
    }], "TableText",ExpressionUUID->"9b8a1167-765e-4ed3-bc53-a4fefa736ece"]}
  }]], "2ColumnTableMod",ExpressionUUID->"648d24a7-dcba-404f-986b-\
d739abe6181b"],

