Cell[CellGroupData[{
Cell["InfraDerivative", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"27a502a0-a635-4bb3-80c0-b5c7a981c823"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDerivative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDerivative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "F", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "012cc050-cc59-42e4-b719-0b77b345582a"],
 "\[LineSeparator]",
 "is the derivative of the vertex function ",
 StyleBox["F", "TI"],
 ", the inverse of the zeta antiderivative: the M\[ODoubleDot]bius inversion ",
 StyleBox["f(v) = \[CapitalSigma]_(u \[PrecedesEqual] v) \[Mu](u, v) F(u)", 
  "TI"],
 ". It is a symbolic object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aa52819c-c3cc-4575-86b4-d44eb1df1fd5"],
 " evaluates it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"10e81fa1-3bef-4796-a84b-973293dea47f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDerivative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDerivative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"F", ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", 
     StyleBox["m", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0701a5df-041b-401d-a5fe-a1f02000353b"],
 "\[LineSeparator]",
 "is the inverse of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraAntiderivative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraAntiderivative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["f", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", 
     StyleBox["m", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92b6724e-b43a-4e1e-bd17-32cbae5b487b"],
 "."
}], "Usage",ExpressionUUID->"f0b14026-d55a-4b40-a696-a2d500812196"],

Cell[TextData[{
 "Definition: the derivative of a method with kernel ",
 StyleBox["K", "TI"],
 " is the antiderivative with the inverse kernel, ",
 StyleBox["D_K = I_(K^(\[Minus]1))", "TI"],
 ", so that ",
 StyleBox["D_K I_K f = f", "TI"],
 " and ",
 StyleBox["I_K D_K F = F", "TI"],
 " exactly."
}], "Notes",ExpressionUUID->"e2c2d288-07d4-4901-a2e6-0e2611dbff8b"],

Cell[TextData[{
 "It takes the options of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraAntiderivative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraAntiderivative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e7d5eecd-c717-485b-ac4a-0dafbaf73b5a"],
 ", ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72509868-92e5-4f78-b913-edfe67965fff"],
 ", ",
 Cell[BoxData["\"\<Origin\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e337a70-1c48-414d-8933-56fdc34d3279"],
 " and ",
 Cell[BoxData["\"\<Direction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ecda5df-3d82-41c1-a5c6-70628cd1179f"],
 ", with the same defaults and the same order on the substrate."
}], "Notes",ExpressionUUID->"256f429a-45d1-4c2c-9da4-c9d8b7f37857"],

Cell[TextData[{
 "A path kernel ",
 StyleBox["K = (1 \[Minus] W)^(\[Minus]1)", "TI"],
 " has the local inverse ",
 StyleBox["1 \[Minus] W", "TI"],
 ": ",
 StyleBox["(D F)(v) = F(v) \[Minus] \[CapitalSigma]_(u \:22d6 v) W(u, v) \
F(u)", "TI"],
 ", a finite difference over the links into ",
 StyleBox["v", "TI"],
 ". For ",
 Cell[BoxData["\"\<PathCount\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "381408b1-a2a8-4291-ab34-a6e6014c9e88"],
 " it is ",
 StyleBox["F(v)", "TI"],
 " minus the sum of ",
 StyleBox["F", "TI"],
 " over the vertices just below ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"0f215365-f3aa-40aa-9fe1-ab73038e5025"],

Cell[TextData[{
 "The ",
 Cell[BoxData["\"\<Zeta\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc9e1227-6725-46e3-a65a-a8d57e205326"],
 " kernel is the zeta function of the order, and its inverse is the M\
\[ODoubleDot]bius function ",
 StyleBox["\[Mu]", "TI"],
 ". The M\[ODoubleDot]bius derivative is local exactly when every interval of \
the order is a chain. An interval that is not a chain, with every proper \
subinterval a chain, has two or more atoms; with ",
 StyleBox["c", "TI"],
 " atoms, ",
 StyleBox["\[Mu] = c \[Minus] 1 \[NotEqual] 0", "TI"],
 " there. The smallest case is the diamond, where ",
 StyleBox["\[Mu]", "TI"],
 " of the bottom and the top is 1."
}], "Notes",ExpressionUUID->"4eb1b7e7-2d08-4820-9a12-adecc4fd0bee"],

