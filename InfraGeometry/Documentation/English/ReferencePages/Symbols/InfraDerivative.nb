     Cell[BoxData[
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "v"}], "}"}], " ", "->", " ", 
       RowBox[{
        RowBox[{"K", "^", 
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}]}], 
        RowBox[{"(", 
         RowBox[{"u", ",", " ", "v"}], ")"}]}]}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f15aad9d-7eac-4bcc-b6a5-f223a035b352"],
     " over the pairs ",
     StyleBox["u \[PrecedesEqual] v", "TI"],
     " with a nonzero value; for ",
     Cell[BoxData["\"\<Volume\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e442b043-a90b-4542-9f3f-d126c5ca0b31"],
     " the M\[ODoubleDot]bius function"
    }], "TableText",ExpressionUUID->"38f19fcf-b7bb-4c55-9fd4-dce1d282975c"]}
  }]], "2ColumnTableMod",ExpressionUUID->"a8f7b5d6-0188-4491-9648-\
7199e64f32fc"],

