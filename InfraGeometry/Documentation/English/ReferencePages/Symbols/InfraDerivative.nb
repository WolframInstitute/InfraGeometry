Cell[TextData[{
 "On the product order of ",
 StyleBox["Z\.b2", "TI"],
 ", the light-cone lattice, the M\[ODoubleDot]bius derivative is the mixed \
second difference ",
 StyleBox["F(i, j) \[Minus] F(i \[Minus] 1, j) \[Minus] F(i, j \[Minus] 1) + \
F(i \[Minus] 1, j \[Minus] 1)", "TI"],
 ": in the null coordinates ",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 " the discrete wave operator."
}], "ExampleText",ExpressionUUID->"d20e4aea-1b56-4b94-ae64-20cc389af93e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lattice", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "0", ",", " ", "4"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}], ",", 
         " ", "1"}], "]"}], ",", "\n", "     ", 
       RowBox[{"Flatten", " ", "@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"i", " ", "<", " ", "4"}], ",", " ", 
              RowBox[{"DirectedEdge", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "j"}], "}"}]}],
                "]"}], ",", " ", "Nothing"}], "]"}], ",", " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"j", " ", "<", " ", "4"}], ",", " ", 
              RowBox[{"DirectedEdge", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", 
                  RowBox[{"j", " ", "+", " ", "1"}]}], "}"}]}], "]"}], ",", 
              " ", "Nothing"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "0", ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"bigF", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "lattice", "]"}], ",", " ", 
       RowBox[{"Prime", "[", 
        RowBox[{"Range", "[", "25", "]"}], "]"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"lattice", ",", " ", 
      RowBox[{"InfraDerivative", "[", "bigF", "]"}], ",", 
      " ", "\"\<Function\>\""}], "]"}], " ", "===", "\n", "    ", 
    RowBox[{"AssociationMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Lookup", "[", 
         RowBox[{"bigF", ",", " ", 
          RowBox[{"Key", "[", "#", "]"}], ",", " ", "0"}], "]"}], " ", "-", 
        " ", 
        RowBox[{"Lookup", "[", 
         RowBox[{"bigF", ",", " ", 
          RowBox[{"Key", "[", 
           RowBox[{"#", " ", "-", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}], ",", " ", "0"}], 
         "]"}], " ", "-", " ", 
        RowBox[{"Lookup", "[", 
         RowBox[{"bigF", ",", " ", 
          RowBox[{"Key", "[", 
           RowBox[{"#", " ", "-", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}], ",", " ", "0"}], 
         "]"}], " ", "+", " ", 
        RowBox[{"Lookup", "[", 
         RowBox[{"bigF", ",", " ", 
          RowBox[{"Key", "[", 
           RowBox[{"#", " ", "-", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}], ",", " ", "0"}], 
         "]"}]}], " ", "&"}], ",", " ", 
      RowBox[{"VertexList", "[", "lattice", "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"acd12903-f826-457c-b63e-472e8c0fd528"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a020f4c3-a85b-43d8-a6b7-0718ccda62c1"]
}, Open  ]],

Cell[TextData[{
 "P. Hall's theorem: the M\[ODoubleDot]bius derivative of 1 at ",
 StyleBox["v", "TI"],
 " is ",
 StyleBox["1 \[Minus] \[Chi]", "TI"],
 ", ",
 StyleBox["\[Chi]", "TI"],
 " the Euler characteristic of the order complex of the strict past of ",
 StyleBox["v", "TI"],
 ". Over a crown, whose order complex is a circle, it is 1."
}], "ExampleText",ExpressionUUID->"c1de6cc0-2af3-4b85-836e-1f54d528079f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"crown", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "5", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
         RowBox[{"1", " ", "->", " ", "4"}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "3"}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "4"}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "5"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Normal", " ", "@", " ", 
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"crown", ",", " ", 
      RowBox[{"InfraDerivative", "[", 
       RowBox[{"1", " ", "&"}], "]"}], ",", " ", "\"\<Function\>\""}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"84b4b5e6-64ed-4404-9fbe-3ed56883c8fb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "1"}], ",", 
   RowBox[{"2", "\[Rule]", "1"}], ",", 
   RowBox[{"3", "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{"4", "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{"5", "\[Rule]", "1"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"50cfe137-e127-4c22-b926-a02f04f519fc"]
}, Open  ]],

Cell["\<\
The path derivatives are local: their kernels live on the diagonal and the \
links. The M\[ODoubleDot]bius derivative is local only where no two chains \
share their ends.\
\>", "ExampleText",ExpressionUUID->"0a8dcfab-a5bb-43bf-9408-0c12c6af9b9a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dag", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "6", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "3"}], ",", " ", 
         RowBox[{"1", " ", "->", " ", "4"}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "5"}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
         RowBox[{"5", " ", "->", " ", "6"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"links", " ", "=", " ", 
     RowBox[{"List", " ", "@@@", " ", 
      RowBox[{"EdgeList", "[", 
       RowBox[{"TransitiveReductionGraph", "[", "dag", "]"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"m", " ", "->", " ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"dag", ",", " ", 
           RowBox[{"InfraDerivative", "[", 
            RowBox[{
             RowBox[{"0", " ", "&"}], ",", " ", 
             RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", 
           " ", "\"\<Kernel\>\""}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"SameQ", " ", "@@", " ", "#"}], " ", "||", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"links", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}]}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Zeta\>\"", ",", " ", "\"\<PathCount\>\"", ",", 
         " ", "\"\<BackwardRandomWalk\>\"", ",", " ", "\"\<UniformChain\>\"", 
         ",", " ", "\"\<ForwardRandomWalk\>\""}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"2cd7a46e-cda7-4374-a2a0-27f10f3e78e1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Zeta\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"PathCount\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"BackwardRandomWalk\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"UniformChain\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"ForwardRandomWalk\"\>", "\[Rule]", "True"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"a89c355e-c9d3-4d6d-94ab-ac161fa5bf82"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<BackwardRandomWalk\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c1516f8-bf51-4329-b221-5f9b999f4dd4"],
 " and ",
 Cell[BoxData["\"\<UniformChain\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18e6a466-cc3c-429c-9c8f-a8f2acf925ea"],
 " kill the constants away from the minimal elements: the derivative of 1 is \
the indicator of the minimal elements."
}], "ExampleText",ExpressionUUID->"44c040c1-192f-4397-bd9b-98643c31f57b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "2", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dag", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "8", "]"}], ",", " ", 
       RowBox[{"DirectedEdge", " ", "@@@", " ", 
        RowBox[{"(", 
         RowBox[{"Sort", " ", "/@", " ", 
          RowBox[{"RandomSample", "[", 
           RowBox[{
            RowBox[{"Subsets", "[", 
             RowBox[{
              RowBox[{"Range", "[", "8", "]"}], ",", " ", 
              RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", "12"}], "]"}]}], 
         ")"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Values", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"dag", ",", " ", 
        RowBox[{"InfraDerivative", "[", 
         RowBox[{
          RowBox[{"1", " ", "&"}], ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<BackwardRandomWalk\>\""}]}], 
         "]"}], ",", " ", "\"\<Function\>\""}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"Values", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"dag", ",", " ", 
        RowBox[{"InfraDerivative", "[", 
         RowBox[{
          RowBox[{"1", " ", "&"}], ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<UniformChain\>\""}]}], "]"}],
         ",", " ", "\"\<Function\>\""}], "]"}]}], ",", " ", 
     RowBox[{"Boole", " ", "@", " ", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"VertexInDegree", "[", "dag", "]"}], " ", "==", " ", "0"}], 
       "]"}]}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"6796b8dc-e894-4d26-b097-9663b4182cd0"],

