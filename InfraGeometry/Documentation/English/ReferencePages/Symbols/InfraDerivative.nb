Cell[TextData[{
 "The M\[ODoubleDot]bius function of the diamond ",
 StyleBox["1 < 2, 3 < 4", "TI"],
 ": it reaches from the top past the links to the bottom."
}], "ExampleText",ExpressionUUID->"5e3f7595-9d1c-447a-9089-0d047e866011"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Normal", " ", "@", " ", 
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    RowBox[{"Graph", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"2", " ", "->", " ", "4"}], ",", " ", 
        RowBox[{"3", " ", "->", " ", "4"}]}], "}"}]}], "]"}], ",", " ", 
    RowBox[{"InfraDerivative", "[", 
     RowBox[{"0", " ", "&"}], "]"}], ",", " ", "\"\<Kernel\>\""}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d052bae8-c3a1-489a-818f-545e89d91922"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", "1"}], ",", 
   RowBox[{
    RowBox[{"{", 
