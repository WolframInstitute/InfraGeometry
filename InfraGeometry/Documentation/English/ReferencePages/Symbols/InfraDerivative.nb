      FontSize->0.9 Inherited,ExpressionUUID->
      "7bad17c2-a3f3-4982-8c2b-4d8f38fe1238"],
     " the M\[ODoubleDot]bius function"
    }], "TableText",ExpressionUUID->"40ce7bee-1bbe-43c0-9417-b521724c3b34"]}
  }]], "2ColumnTableMod",ExpressionUUID->"96d5c4e6-9a5f-4dcd-bc55-\
b422fd2b0c79"],

