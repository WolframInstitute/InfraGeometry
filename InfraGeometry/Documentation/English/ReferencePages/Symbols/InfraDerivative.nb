Cell[TextData[{
 "On the product order of ",
 StyleBox["Z\.b2", "TI"],
 ", the light-cone lattice, the M\[ODoubleDot]bius derivative is the mixed \
second difference ",
 StyleBox["F(i, j) \[Minus] F(i \[Minus] 1, j) \[Minus] F(i, j \[Minus] 1) + \
F(i \[Minus] 1, j \[Minus] 1)", "TI"],
 ": in the null coordinates ",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 " the discrete wave operator."
}], "ExampleText",ExpressionUUID->"6c3761f0-e44f-4ab2-9c2d-9dff94581fb3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lattice", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "0", ",", " ", "4"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}], ",", 
         " ", "1"}], "]"}], ",", "\n", "     ", 
       RowBox[{"Flatten", " ", "@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"i", " ", "<", " ", "4"}], ",", " ", 
              RowBox[{"DirectedEdge", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "j"}], "}"}]}],
                "]"}], ",", " ", "Nothing"}], "]"}], ",", " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"j", " ", "<", " ", "4"}], ",", " ", 
              RowBox[{"DirectedEdge", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", 
                  RowBox[{"j", " ", "+", " ", "1"}]}], "}"}]}], "]"}], ",", 
              " ", "Nothing"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "0", ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"bigF", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "lattice", "]"}], ",", " ", 
       RowBox[{"Prime", "[", 
        RowBox[{"Range", "[", "25", "]"}], "]"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"lattice", ",", " ", 
      RowBox[{"InfraDerivative", "[", "bigF", "]"}], ",", 
      " ", "\"\<Function\>\""}], "]"}], " ", "===", "\n", "    ", 
    RowBox[{"AssociationMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Lookup", "[", 
         RowBox[{"bigF", ",", " ", 
          RowBox[{"Key", "[", "#", "]"}], ",", " ", "0"}], "]"}], " ", "-", 
        " ", 
        RowBox[{"Lookup", "[", 
         RowBox[{"bigF", ",", " ", 
          RowBox[{"Key", "[", 
           RowBox[{"#", " ", "-", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}], ",", " ", "0"}], 
         "]"}], " ", "-", " ", 
        RowBox[{"Lookup", "[", 
         RowBox[{"bigF", ",", " ", 
          RowBox[{"Key", "[", 
           RowBox[{"#", " ", "-", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}], ",", " ", "0"}], 
         "]"}], " ", "+", " ", 
        RowBox[{"Lookup", "[", 
         RowBox[{"bigF", ",", " ", 
          RowBox[{"Key", "[", 
           RowBox[{"#", " ", "-", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}], ",", " ", "0"}], 
         "]"}]}], " ", "&"}], ",", " ", 
      RowBox[{"VertexList", "[", "lattice", "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"23d5e41e-9c56-4a44-add6-c39b5286879b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a60a0261-beb0-4e0e-9758-f788f25a33b3"]
}, Open  ]],

Cell[TextData[{
 "P. Hall's theorem: the M\[ODoubleDot]bius derivative of 1 at ",
 StyleBox["v", "TI"],
 " is ",
 StyleBox["1 \[Minus] \[Chi]", "TI"],
 ", ",
 StyleBox["\[Chi]", "TI"],
 " the Euler characteristic of the order complex of the strict past of ",
 StyleBox["v", "TI"],
 ". Over a crown, whose order complex is a circle, it is 1."
}], "ExampleText",ExpressionUUID->"25efb4bc-c73a-46ba-b89a-111be6221701"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"crown", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "5", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
         RowBox[{"1", " ", "->", " ", "4"}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "3"}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "4"}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "5"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Normal", " ", "@", " ", 
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"crown", ",", " ", 
      RowBox[{"InfraDerivative", "[", 
       RowBox[{"1", " ", "&"}], "]"}], ",", " ", "\"\<Function\>\""}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7a634b4f-368f-408e-94ce-70a45765c3e1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "1"}], ",", 
   RowBox[{"2", "\[Rule]", "1"}], ",", 
   RowBox[{"3", "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{"4", "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{"5", "\[Rule]", "1"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"262e1c8a-6fea-4574-ab43-3a74dfa55139"]
}, Open  ]],

Cell["\<\
The path derivatives are local: their kernels live on the diagonal and the \
links. The volume derivative is local only where no two chains share their \
ends.\
\>", "ExampleText",ExpressionUUID->"3c4dfc1d-fc8e-417b-84f2-e0ad959de8cc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dag", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "6", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "3"}], ",", " ", 
         RowBox[{"1", " ", "->", " ", "4"}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "5"}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
         RowBox[{"5", " ", "->", " ", "6"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"links", " ", "=", " ", 
     RowBox[{"List", " ", "@@@", " ", 
      RowBox[{"EdgeList", "[", 
       RowBox[{"TransitiveReductionGraph", "[", "dag", "]"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"m", " ", "->", " ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"dag", ",", " ", 
           RowBox[{"InfraDerivative", "[", 
            RowBox[{
             RowBox[{"0", " ", "&"}], ",", " ", 
             RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", 
           " ", "\"\<Kernel\>\""}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"SameQ", " ", "@@", " ", "#"}], " ", "||", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"links", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}]}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Volume\>\"", ",", " ", "\"\<Paths\>\"", ",", 
         " ", "\"\<Average\>\"", ",", " ", "\"\<Uniform\>\"", ",", 
         " ", "\"\<Flow\>\""}], "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"2b4681e9-2f7f-41c9-a9b3-f3ba5a639e1c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Volume\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"Paths\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"Average\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"Uniform\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"Flow\"\>", "\[Rule]", "True"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"21532cc6-a021-40cc-9d33-31af3c6f1e9e"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<Average\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3383df3-b7c5-4d16-bb56-efa846b3d7b7"],
 " and ",
 Cell[BoxData["\"\<Uniform\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3882b825-1912-4e3c-9391-fcdf38148b1f"],
 " kill the constants away from the minimal elements: the derivative of 1 is \
the indicator of the minimal elements."
}], "ExampleText",ExpressionUUID->"4ffc3fd2-5bd5-496a-b22a-d0859d41c52c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "2", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dag", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "8", "]"}], ",", " ", 
       RowBox[{"DirectedEdge", " ", "@@@", " ", 
        RowBox[{"(", 
         RowBox[{"Sort", " ", "/@", " ", 
          RowBox[{"RandomSample", "[", 
           RowBox[{
            RowBox[{"Subsets", "[", 
             RowBox[{
              RowBox[{"Range", "[", "8", "]"}], ",", " ", 
              RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", "12"}], "]"}]}], 
         ")"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Values", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"dag", ",", " ", 
        RowBox[{"InfraDerivative", "[", 
         RowBox[{
          RowBox[{"1", " ", "&"}], ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<Average\>\""}]}], "]"}], ",",
         " ", "\"\<Function\>\""}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"Values", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"dag", ",", " ", 
        RowBox[{"InfraDerivative", "[", 
         RowBox[{
          RowBox[{"1", " ", "&"}], ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<Uniform\>\""}]}], "]"}], ",",
         " ", "\"\<Function\>\""}], "]"}]}], ",", " ", 
     RowBox[{"Boole", " ", "@", " ", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"VertexInDegree", "[", "dag", "]"}], " ", "==", " ", "0"}], 
       "]"}]}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"3159719c-15c1-4304-b0be-28d8ce6d2b91"],

