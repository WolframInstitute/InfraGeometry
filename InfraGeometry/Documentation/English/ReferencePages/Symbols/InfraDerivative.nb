Cell[TextData[{
 "On the product order of ",
 StyleBox["Z\.b2", "TI"],
 ", the light-cone lattice, the M\[ODoubleDot]bius derivative is the mixed \
second difference ",
 StyleBox["F(i, j) \[Minus] F(i \[Minus] 1, j) \[Minus] F(i, j \[Minus] 1) + \
F(i \[Minus] 1, j \[Minus] 1)", "TI"],
 ": in the null coordinates ",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 " the discrete wave operator."
}], "ExampleText",ExpressionUUID->"4e3ed6df-80bb-43b5-b970-ec3acb00c1c0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lattice", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "0", ",", " ", "4"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}], ",", 
         " ", "1"}], "]"}], ",", "\n", "     ", 
       RowBox[{"Flatten", " ", "@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"i", " ", "<", " ", "4"}], ",", " ", 
              RowBox[{"DirectedEdge", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "j"}], "}"}]}],
                "]"}], ",", " ", "Nothing"}], "]"}], ",", " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"j", " ", "<", " ", "4"}], ",", " ", 
              RowBox[{"DirectedEdge", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", 
                  RowBox[{"j", " ", "+", " ", "1"}]}], "}"}]}], "]"}], ",", 
              " ", "Nothing"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "0", ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"bigF", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "lattice", "]"}], ",", " ", 
       RowBox[{"Prime", "[", 
        RowBox[{"Range", "[", "25", "]"}], "]"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"lattice", ",", " ", 
      RowBox[{"InfraDerivative", "[", "bigF", "]"}], ",", 
      " ", "\"\<Function\>\""}], "]"}], " ", "===", "\n", "    ", 
    RowBox[{"AssociationMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Lookup", "[", 
         RowBox[{"bigF", ",", " ", 
          RowBox[{"Key", "[", "#", "]"}], ",", " ", "0"}], "]"}], " ", "-", 
        " ", 
        RowBox[{"Lookup", "[", 
         RowBox[{"bigF", ",", " ", 
          RowBox[{"Key", "[", 
           RowBox[{"#", " ", "-", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}], ",", " ", "0"}], 
         "]"}], " ", "-", " ", 
        RowBox[{"Lookup", "[", 
         RowBox[{"bigF", ",", " ", 
          RowBox[{"Key", "[", 
           RowBox[{"#", " ", "-", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}], ",", " ", "0"}], 
         "]"}], " ", "+", " ", 
        RowBox[{"Lookup", "[", 
         RowBox[{"bigF", ",", " ", 
          RowBox[{"Key", "[", 
           RowBox[{"#", " ", "-", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}], ",", " ", "0"}], 
         "]"}]}], " ", "&"}], ",", " ", 
      RowBox[{"VertexList", "[", "lattice", "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f4e2d259-bdbe-4356-a418-8d293d20a9fd"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2394c223-ba2f-4f37-b98a-367d59f61aca"]
}, Open  ]],

Cell[TextData[{
 "P. Hall's theorem: the M\[ODoubleDot]bius derivative of 1 at ",
 StyleBox["v", "TI"],
 " is ",
 StyleBox["1 \[Minus] \[Chi]", "TI"],
 ", ",
 StyleBox["\[Chi]", "TI"],
 " the Euler characteristic of the order complex of the strict past of ",
 StyleBox["v", "TI"],
 ". Over a crown, whose order complex is a circle, it is 1."
}], "ExampleText",ExpressionUUID->"2523095f-6fe5-453d-9bc0-559f0ce7b9a1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"crown", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "5", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
         RowBox[{"1", " ", "->", " ", "4"}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "3"}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "4"}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "5"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Normal", " ", "@", " ", 
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"crown", ",", " ", 
      RowBox[{"InfraDerivative", "[", 
       RowBox[{"1", " ", "&"}], "]"}], ",", " ", "\"\<Function\>\""}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"01b0e2c5-5990-4f27-bca0-9c1495ed6365"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "1"}], ",", 
   RowBox[{"2", "\[Rule]", "1"}], ",", 
   RowBox[{"3", "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{"4", "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{"5", "\[Rule]", "1"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"d2f61f08-e954-4a25-85be-2a22447df416"]
}, Open  ]],

Cell["\<\
The path derivatives are local: their kernels live on the diagonal and the \
links. The M\[ODoubleDot]bius derivative is local only where no two chains \
share their ends.\
\>", "ExampleText",ExpressionUUID->"5e95581b-e506-452b-9dbe-6cd5c3854440"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dag", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "6", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "3"}], ",", " ", 
         RowBox[{"1", " ", "->", " ", "4"}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "5"}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
         RowBox[{"5", " ", "->", " ", "6"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"links", " ", "=", " ", 
     RowBox[{"List", " ", "@@@", " ", 
      RowBox[{"EdgeList", "[", 
       RowBox[{"TransitiveReductionGraph", "[", "dag", "]"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"m", " ", "->", " ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"dag", ",", " ", 
           RowBox[{"InfraDerivative", "[", 
            RowBox[{
             RowBox[{"0", " ", "&"}], ",", " ", 
             RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", 
           " ", "\"\<Kernel\>\""}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"SameQ", " ", "@@", " ", "#"}], " ", "||", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"links", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}]}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Zeta\>\"", ",", " ", "\"\<PathCount\>\"", ",", 
         " ", "\"\<BackwardRandomWalk\>\"", ",", " ", "\"\<UniformChain\>\"", 
         ",", " ", "\"\<ForwardRandomWalk\>\""}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"490c7bc0-7db9-46a5-9ecb-d4d355b8e1bf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Zeta\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"PathCount\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"BackwardRandomWalk\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"UniformChain\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"ForwardRandomWalk\"\>", "\[Rule]", "True"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"fcbf4fa1-ab5d-45fe-afd9-7ccf11e3276a"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<BackwardRandomWalk\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7f5a5cd-d9ca-4cc9-aabb-0cfd9a41411e"],
 " and ",
 Cell[BoxData["\"\<UniformChain\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "050a6dec-c424-4eb2-b882-98d50ca3638b"],
 " kill the constants away from the minimal elements: the derivative of 1 is \
the indicator of the minimal elements."
}], "ExampleText",ExpressionUUID->"f5d02f38-f646-486e-9844-f17caf4d70de"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "2", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dag", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "8", "]"}], ",", " ", 
       RowBox[{"DirectedEdge", " ", "@@@", " ", 
        RowBox[{"(", 
         RowBox[{"Sort", " ", "/@", " ", 
          RowBox[{"RandomSample", "[", 
           RowBox[{
            RowBox[{"Subsets", "[", 
             RowBox[{
              RowBox[{"Range", "[", "8", "]"}], ",", " ", 
              RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", "12"}], "]"}]}], 
         ")"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Values", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"dag", ",", " ", 
        RowBox[{"InfraDerivative", "[", 
         RowBox[{
          RowBox[{"1", " ", "&"}], ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<BackwardRandomWalk\>\""}]}], 
         "]"}], ",", " ", "\"\<Function\>\""}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"Values", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"dag", ",", " ", 
        RowBox[{"InfraDerivative", "[", 
         RowBox[{
          RowBox[{"1", " ", "&"}], ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<UniformChain\>\""}]}], "]"}],
         ",", " ", "\"\<Function\>\""}], "]"}]}], ",", " ", 
     RowBox[{"Boole", " ", "@", " ", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"VertexInDegree", "[", "dag", "]"}], " ", "==", " ", "0"}], 
       "]"}]}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"176d8556-5bac-427a-9806-62712887993d"],

