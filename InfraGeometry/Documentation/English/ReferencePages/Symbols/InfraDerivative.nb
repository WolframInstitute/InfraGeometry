      "2ca14030-c612-4a31-8da2-c3e87c6ed8c3"],
     " ",
     Cell[BoxData[
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "v"}], "}"}], " ", "->", " ", 
       RowBox[{
        RowBox[{"K", "^", 
