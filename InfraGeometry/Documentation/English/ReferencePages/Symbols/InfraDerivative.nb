Cell[CellGroupData[{
Cell["InfraDerivative", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1a8f9d57-d127-496d-bc63-0eaa10106202"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDerivative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDerivative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "F", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17e285e7-0eb3-46af-a8e2-af23482798c1"],
 "\[LineSeparator]",
 "is the derivative of the vertex function ",
 StyleBox["F", "TI"],
 ", the inverse of the volume antiderivative: the M\[ODoubleDot]bius \
inversion ",
 StyleBox["f(v) = \[CapitalSigma]_(u \[PrecedesEqual] v) \[Mu](u, v) F(u)", 
  "TI"],
 ". It is a symbolic object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0e17fe04-515d-4bd2-9c97-8b4b91b1b3c0"],
 " evaluates it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"415ac9a3-5ca3-46ed-9a3a-5e3e110b651e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDerivative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDerivative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"F", ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", 
     StyleBox["m", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ff45027-1bb7-4d69-bc48-8b8a798e8768"],
 "\[LineSeparator]",
 "is the inverse of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraAntiderivative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraAntiderivative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["f", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", 
     StyleBox["m", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84f7cf99-6977-4aef-ad16-247b80fd4e49"],
 "."
}], "Usage",ExpressionUUID->"d1f90d75-2aed-41bc-a18c-e4eb2096d094"],

Cell[TextData[{
 "Definition: the derivative of a method with kernel ",
 StyleBox["K", "TI"],
 " is the antiderivative with the inverse kernel, ",
 StyleBox["D_K = I_(K^(\[Minus]1))", "TI"],
 ", so that ",
 StyleBox["D_K I_K f = f", "TI"],
 " and ",
 StyleBox["I_K D_K F = F", "TI"],
 " exactly."
}], "Notes",ExpressionUUID->"cba8cc68-4d72-4b0f-9756-1605818e6555"],

Cell[TextData[{
 "It takes the options of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraAntiderivative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraAntiderivative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "89e98f97-0474-499b-883b-facd8afb2525"],
 ", ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0c498ca-d6df-4971-9ee3-d0605a0dd1a6"],
 ", ",
 Cell[BoxData["\"\<Origin\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4da37d6-1dcd-4653-8b58-0d5c4ef5e6bb"],
 " and ",
 Cell[BoxData["\"\<Direction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "010382e9-9531-4156-b8e5-a148094da843"],
 ", with the same defaults and the same order on the substrate."
}], "Notes",ExpressionUUID->"db756ead-06e1-45a1-b614-8b378202b7ec"],

Cell[TextData[{
 "A path kernel ",
 StyleBox["K = (1 \[Minus] W)^(\[Minus]1)", "TI"],
 " has the local inverse ",
 StyleBox["1 \[Minus] W", "TI"],
 ": ",
 StyleBox["(D F)(v) = F(v) \[Minus] \[CapitalSigma]_(u \:22d6 v) W(u, v) \
F(u)", "TI"],
 ", a finite difference over the links into ",
 StyleBox["v", "TI"],
 ". For ",
 Cell[BoxData["\"\<Paths\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef8ee36d-f28c-461b-a239-d4b6806eb83f"],
 " it is ",
 StyleBox["F(v)", "TI"],
 " minus the sum of ",
 StyleBox["F", "TI"],
 " over the vertices just below ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"42aede09-733e-4f65-ab6f-4d4d995d07e2"],

Cell[TextData[{
 "The volume kernel is the zeta function of the order, and its inverse is the \
M\[ODoubleDot]bius function ",
 StyleBox["\[Mu]", "TI"],
 ". The volume derivative is local exactly when every interval of the order \
is a chain. An interval that is not a chain, with every proper subinterval a \
chain, has two or more atoms; with ",
 StyleBox["c", "TI"],
 " atoms, ",
 StyleBox["\[Mu] = c \[Minus] 1 \[NotEqual] 0", "TI"],
 " there. The smallest case is the diamond, where ",
 StyleBox["\[Mu]", "TI"],
 " of the bottom and the top is 1."
}], "Notes",ExpressionUUID->"939d08d3-496b-4ece-989a-613dbadb2ace"],

