Cell[TextData[{
 "Associativity and the unit, for a random 0-cochain ",
 StyleBox["f", "TI"],
 " and random 1-cochains ",
 StyleBox["\[Alpha]", "TI"],
 ", ",
 StyleBox["\[Beta]", "TI"],
 " on the mesh:"
}], "ExampleText",ExpressionUUID->"384c3ede-1672-4d04-bd9a-a1fcf35e58bf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"edges", " ", "=", " ", 
      RowBox[{"Sort", " ", "/@", " ", 
       RowBox[{"List", " ", "@@@", " ", 
        RowBox[{"EdgeList", "[", "g", "]"}]}]}]}], ",", " ", 
     RowBox[{"vs", " ", "=", " ", 
      RowBox[{"List", " ", "/@", " ", 
       RowBox[{"VertexList", "[", "g", "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"edges", ",", " ", 
        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"RandomChoice", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "2"}], ",", " ", 
              RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "2"}], "}"}], ",", 
            " ", 
            RowBox[{"Length", "[", "edges", "]"}]}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}]}], 
     ",", "\n", "   ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"edges", ",", " ", 
        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"RandomChoice", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "2"}], ",", " ", 
              RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "2"}], "}"}], ",", 
            " ", 
            RowBox[{"Length", "[", "edges", "]"}]}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], "]"}]}], 
     ",", "\n", "   ", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"vs", ",", " ", 
        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"RandomChoice", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "2"}], ",", " ", 
              RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "2"}], "}"}], ",", 
            " ", 
            RowBox[{"Length", "[", "vs", "]"}]}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "3"}]}], "]"}]}], "]"}]}], 
     ",", "\n", "   ", 
     RowBox[{"one", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"vs", ",", " ", "1"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"OrderedCochainCup", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"OrderedCochainCup", "[", 
          RowBox[{"g", ",", " ", "f", ",", " ", "a"}], "]"}], ",", " ", "b"}],
         "]"}]}], " ", "==", "\n", "     ", 
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"OrderedCochainCup", "[", 
        RowBox[{"g", ",", " ", "f", ",", " ", 
         RowBox[{"OrderedCochainCup", "[", 
          RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}], "]"}]}]}], ",",
      "\n", "   ", 
     RowBox[{
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"OrderedCochainCup", "[", 
        RowBox[{"g", ",", " ", "one", ",", " ", "a"}], "]"}]}], " ", "==", 
      " ", 
      RowBox[{"KeySort", "[", "a", "]"}], " ", "==", " ", 
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"OrderedCochainCup", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "one"}], "]"}]}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f5cd0d52-be6c-449a-890a-8ef96070f4d0"],

