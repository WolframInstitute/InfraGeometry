Cell[TextData[{
 "The ordered cup of the coboundaries of the coordinates ",
 StyleBox["x", "TI"],
 " and ",
 StyleBox["y", "TI"],
 " of the square mesh, against the signed area of each triangle on its sorted \
corners. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0b864293-40d9-4bfc-9165-5b6076ce4a43"],
 " gives the area; the ordered cup depends on the order of the corners:"
}], "ExampleText",ExpressionUUID->"34d0ad0f-b87f-44f3-baaa-e9ec81d6d558"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"pos", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"dx", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], "]"}]}], 
     ",", "\n", "   ", 
     RowBox[{"dy", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"area", " ", "=", " ", 
     RowBox[{"t", " ", "|->", " ", 
      RowBox[{
       RowBox[{"Det", "[", 
        RowBox[{"Differences", "[", 
         RowBox[{"pos", " ", "/@", " ", "t"}], "]"}], "]"}], "/", "2"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"KeyValueMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"area", "[", "#1", "]"}], ",", " ", "#2"}], "}"}], " ", 
          "&"}], ",", " ", 
         RowBox[{"cup", "[", 
          RowBox[{"g", ",", " ", "dx", ",", " ", "dy"}], "]"}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"cup", ",", " ", 
         RowBox[{"{", 
          RowBox[{"CochainCup", ",", " ", "OrderedCochainCup"}], "}"}]}], 
        "}"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<CochainCup\>\"", ",", " ", "\"\<OrderedCochainCup\>\""}], 
       "}"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"34876263-ea87-44b1-aa9d-4a481807b587"],

