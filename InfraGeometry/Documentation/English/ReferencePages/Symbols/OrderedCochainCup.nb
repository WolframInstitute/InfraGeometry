Cell["\<\
The ordered cup is associative: for two random 1-cochains and a random \
0-cochain on the triangular tiling, both bracketings give the same 2-cochain, \
drawn on its triangles, blue where its value on the sorted corners is \
positive and red where it is negative.\
\>", "ExampleText",ExpressionUUID->"2e689e49-87a5-4671-b4e3-9578144ba3d1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"positions", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"firstCochain", " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"RandomInteger", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], "]"}], " ", "&"}], ",",
           " ", 
          RowBox[{"Sort", " ", "/@", " ", 
           RowBox[{"List", " ", "@@@", " ", 
            RowBox[{"EdgeList", "[", "g", "]"}]}]}]}], "]"}]}], ")"}]}], ",", 
     "\n", "   ", 
     RowBox[{"secondCochain", " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"RandomInteger", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], "]"}], " ", "&"}], ",",
           " ", 
          RowBox[{"Sort", " ", "/@", " ", 
           RowBox[{"List", " ", "@@@", " ", 
            RowBox[{"EdgeList", "[", "g", "]"}]}]}]}], "]"}]}], ")"}]}], ",", 
     "\n", "   ", 
     RowBox[{"values", " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"RandomInteger", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], "]"}], " ", "&"}], ",",
           " ", 
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], ")"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"product", " ", "=", " ", 
     RowBox[{"OrderedCochainCup", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"OrderedCochainCup", "[", 
        RowBox[{"g", ",", " ", "firstCochain", ",", " ", "secondCochain"}], 
        "]"}], ",", " ", "values"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"triangle", ",", " ", "value"}], "}"}], " ", "|->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"value", " ", ">", " ", "0"}], ",", " ", 
               "StandardBlue", ",", " ", "StandardRed"}], "]"}], ",", " ", 
             RowBox[{"Polygon", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"positions", ",", " ", "triangle"}], "]"}], "]"}]}], 
            "}"}]}], ",", " ", "product"}], "]"}], "]"}], ",", " ", "g"}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"KeySort", "[", "product", "]"}], " ", "===", " ", 
      RowBox[{"KeySort", "[", 
       RowBox[{"OrderedCochainCup", "[", 
        RowBox[{"g", ",", " ", "firstCochain", ",", " ", 
         RowBox[{"OrderedCochainCup", "[", 
          RowBox[{"g", ",", " ", "secondCochain", ",", " ", "values"}], 
          "]"}]}], "]"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"07912d68-8478-46cb-a39b-285690445f11"],

