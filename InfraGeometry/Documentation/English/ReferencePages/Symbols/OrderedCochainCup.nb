Cell[TextData[{
 "The product is not graded-commutative. On a triangle ",
 StyleBox["v\:2080 < v\:2081 < v\:2082", "TI"],
 " at the centre of the mesh, the 1-cochain that is 1 on ",
 StyleBox["(v\:2080, v\:2081)", "TI"],
 " times the one that is 1 on ",
 StyleBox["(v\:2081, v\:2082)", "TI"],
 " is 1; in the other order it is 0, which is not stored:"
}], "ExampleText",ExpressionUUID->"273d075c-d5bd-473a-9529-ed0f4fa0ff41"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"FindClique", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", "3", "}"}], ",", " ", "All"}], "]"}], ",", " ", 
         RowBox[{"MemberQ", "[", "c", "]"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"front", " ", "=", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"t", "[", 
         RowBox[{"[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], "]"}], " ", "->", " ", 
        "1"}], "|>"}]}], ",", " ", 
     RowBox[{"back", " ", "=", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"t", "[", 
         RowBox[{"[", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "3"}], "}"}], "]"}], "]"}], " ", "->", " ", 
        "1"}], "|>"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraWalk", "[", 
        RowBox[{"t", "[", 
         RowBox[{"[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"InfraWalk", "[", 
        RowBox[{"t", "[", 
         RowBox[{"[", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "3"}], "}"}], "]"}], "]"}], "]"}]}], "}"}], 
     ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"OrderedCochainCup", "[", 
         RowBox[{"g", ",", " ", "front", ",", " ", "back"}], "]"}], ",", " ", 
        
        RowBox[{"OrderedCochainCup", "[", 
         RowBox[{"g", ",", " ", "back", ",", " ", "front"}], "]"}]}], "}"}]}],
      ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b49203cb-a854-4752-b739-667cd53ba003"],

Cell[BoxData[
 GraphicsBox[
