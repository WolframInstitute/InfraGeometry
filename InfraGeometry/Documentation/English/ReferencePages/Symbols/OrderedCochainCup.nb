Cell["\<\
The ordered cup is not graded-commutative. On a triangle at the centre of the \
triangular tiling, the 1-cochain that is 1 on its front edge and the \
1-cochain that is 1 on its back edge multiply to 1 in this order and to 0 in \
the other.\
\>", "ExampleText",ExpressionUUID->"9bf4d5ba-5fef-477f-ab2c-7c693ffab530"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"center", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
     RowBox[{"positions", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"triangle", " ", "=", " ", 
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"FindClique", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", "3", "}"}], ",", " ", "All"}], "]"}], ",", " ", 
         RowBox[{"MemberQ", "[", "center", "]"}]}], "]"}]}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"front", " ", "=", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"triangle", "[", 
         RowBox[{"[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], "]"}], " ", "->", " ", 
        "1"}], "|>"}]}], ",", " ", 
     RowBox[{"back", " ", "=", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"triangle", "[", 
         RowBox[{"[", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "3"}], "}"}], "]"}], "]"}], " ", "->", " ", 
        "1"}], "|>"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"{", 
         RowBox[{"StandardBlue", ",", " ", 
          RowBox[{"Polygon", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"positions", ",", " ", "triangle"}], "]"}], "]"}]}], 
         "}"}], "]"}], ",", " ", "g"}], "]"}], ",", "\n", "   ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"OrderedCochainCup", "[", 
       RowBox[{"g", ",", " ", "front", ",", " ", "back"}], "]"}]}], ",", " ", 
     
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"OrderedCochainCup", "[", 
       RowBox[{"g", ",", " ", "back", ",", " ", "front"}], "]"}]}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9672f415-fc9e-457d-a7dc-37871468ccfe"],

