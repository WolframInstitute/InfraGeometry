Notebook[{

Cell[CellGroupData[{
Cell["OrderedCochainCup", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"050f4de7-6646-4173-a244-0f883915bdf2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OrderedCochainCup"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainCup", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["\[Alpha]", "TR"], ",", " ", 
    StyleBox["\[Beta]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d4dbc6f-f1c8-47bf-9adb-f055c3236493"],
 "\[LineSeparator]",
 "gives the ordered cup product of the ordered cochains ",
 StyleBox["\[Alpha]", "TI"],
 " and ",
 StyleBox["\[Beta]", "TI"],
 ", the Alexander\[Dash]Whitney formula ",
 StyleBox["\[Alpha](v\:2080, \[Ellipsis], v\:209a) \[Beta](v\:209a, \
\[Ellipsis], v\:2099)", "TI"],
 " on each increasing tuple ",
 StyleBox["v\:2080 < \[Ellipsis] < v\:2099", "TI"],
 " of a clique of ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"597cb65b-c11a-4bec-8dc1-79f90d05a53b"],

Cell[TextData[{
 "Definition: for ",
 StyleBox["\[Alpha]", "TI"],
 " of degree ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["\[Beta]", "TI"],
 " of degree ",
 StyleBox["q", "TI"],
 ", with ",
 StyleBox["n", "TI"],
 " = ",
 StyleBox["p", "TI"],
 " + ",
 StyleBox["q", "TI"],
 ", ",
 StyleBox["(\[Alpha] \:222a \[Beta])(v\:2080, \[Ellipsis], v\:2099) = \
\[Alpha](v\:2080, \[Ellipsis], v\:209a) \[Beta](v\:209a, \[Ellipsis], \
v\:2099)", "TI"],
 " on the increasing tuples, the front face of ",
 StyleBox["\[Alpha]", "TI"],
 " times the back face of ",
 StyleBox["\[Beta]", "TI"],
 ". The order of the vertices is the one in which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Sort"]], "paclet:ref/Sort"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c25596d0-1d08-45fb-854f-76119329fc68"],
 " puts their names."
}], "Notes",ExpressionUUID->"0fef0227-f309-457b-ab9d-b3ddbf8521f2"],

Cell["\<\
It is associative and unital: both bracketings of three factors read the \
three consecutive faces of the tuple, and the constant 0-cochain 1 is a unit. \
The coboundary is a derivation for it, so the ordered cochains form a \
differential graded algebra.\
\>", "Notes",ExpressionUUID->"6fae14ae-9bab-4878-82fb-04aad3248654"],

Cell[TextData[{
 "It is not graded-commutative. On a triangle ",
 StyleBox["v\:2080 < v\:2081 < v\:2082", "TI"],
 ", the 1-cochains ",
 StyleBox["\[Alpha]", "TI"],
 ", 1 on ",
 StyleBox["(v\:2080, v\:2081)", "TI"],
 ", and ",
 StyleBox["\[Beta]", "TI"],
 ", 1 on ",
 StyleBox["(v\:2081, v\:2082)", "TI"],
 ", have ",
 StyleBox["\[Alpha] \:222a \[Beta]", "TI"],
 " = 1 and ",
 StyleBox["\[Beta] \:222a \[Alpha]", "TI"],
 " = 0 there."
}], "Notes",ExpressionUUID->"a62a02bd-ad2d-4da8-b0c6-db79c3ba6e55"],

Cell[TextData[{
 "The product of two alternating cochains is not alternating, so the result \
is an ordered cochain: read it with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrderedCochainValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "707c016a-a6bb-4d37-9039-9cfc53178b16"],
 ", not with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b16de3f2-6905-48f9-ada8-c16ecc55449d"],
 ". Its antisymmetrisation is the cup ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c0a4a690-d383-4dcf-bbd7-192f292a7d7e"],
 ", and on cohomology the two agree: the ordered cup and the cup of two \
cocycles differ by a coboundary. On cocycles the graded commutator ",
 StyleBox["\[Alpha] \:222a \[Beta] \[Minus] (\[Minus]1)^(pq) \[Beta] \:222a \
\[Alpha]", "TI"],
 " is the coboundary of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainCupOne"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainCupOne", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "57e0fd60-064c-4768-974d-92599a1664ed"],
 "."
}], "Notes",ExpressionUUID->"998d54e5-8f3d-41d2-be0e-67ec5086ce18"]
}, Open  ]],

