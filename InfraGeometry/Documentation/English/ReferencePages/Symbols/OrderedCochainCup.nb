        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"RandomChoice", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "2"}], ",", " ", 
              RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "2"}], "}"}], ",", 
