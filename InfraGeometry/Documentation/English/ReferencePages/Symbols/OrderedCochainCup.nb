Cell[TextData[{
 "On the mesh of a square, the ordered cup of the coboundaries of the two \
coordinates against the signed area of each triangle on its sorted corners, \
beside the cup ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1ae0d00e-a835-4931-9931-53931c3ae09b"],
 " of the same two cochains. The cup is the area; the ordered cup depends on \
the order of the corners and is not."
}], "ExampleText",ExpressionUUID->"c96e3dd8-1db5-47bd-bd4e-bd718423fc6b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"positions", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"dx", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"KeyMap", "[", 
         RowBox[{"List", ",", " ", 
          RowBox[{"positions", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], "]"}]}], 
     ",", " ", 
     RowBox[{"dy", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"KeyMap", "[", 
         RowBox[{"List", ",", " ", 
          RowBox[{"positions", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"{", "\n", "     ", 
      RowBox[{
       RowBox[{"KeyValueMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"triangle", ",", " ", "value"}], "}"}], " ", "|->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Det", "[", 
              RowBox[{"Differences", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{"positions", ",", " ", "triangle"}], "]"}], "]"}], 
              "]"}], " ", "/", " ", "2"}], ",", " ", "value"}], "}"}]}], ",", 
         " ", 
         RowBox[{"CochainCup", "[", 
          RowBox[{"g", ",", " ", "dx", ",", " ", "dy"}], "]"}]}], "]"}], ",", 
       "\n", "     ", 
       RowBox[{"KeyValueMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"triangle", ",", " ", "value"}], "}"}], " ", "|->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Det", "[", 
              RowBox[{"Differences", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{"positions", ",", " ", "triangle"}], "]"}], "]"}], 
              "]"}], " ", "/", " ", "2"}], ",", " ", "value"}], "}"}]}], ",", 
         " ", 
         RowBox[{"OrderedCochainCup", "[", 
          RowBox[{"g", ",", " ", "dx", ",", " ", "dy"}], "]"}]}], "]"}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<cup\>\"", ",", " ", "\"\<ordered cup\>\""}], "}"}]}], ",",
      " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<signed area\>\"", ",", " ", "\"\<product\>\""}], 
       "}"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"166a6b1b-12ad-40e0-bd43-1be5df68f4f8"],

