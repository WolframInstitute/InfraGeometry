Cell["The constant 0-cochain 1 is a unit on either side.", "ExampleText",ExpressionUUID->"32636577-6261-4fc2-a343-d85a11182ce7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"cochain", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"First", " ", "@", " ", 
              RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", 
             RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
          
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], ",", 
     "\n", "   ", 
     RowBox[{"unit", " ", "=", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{"1", " ", "&"}], ",", " ", 
        RowBox[{"List", " ", "/@", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"GroupBy", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Keys", " ", "@", " ", 
            RowBox[{"Select", "[", 
             RowBox[{"cochain", ",", " ", "Positive"}], "]"}]}], ",", " ", 
           RowBox[{"Reverse", " ", "/@", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"Select", "[", 
              RowBox[{"cochain", ",", " ", "Negative"}], "]"}]}]}]}], "]"}], ",",
          " ", 
         RowBox[{"First", " ", "->", " ", "Last"}]}], "]"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"KeySort", "[", 
         RowBox[{"OrderedCochainCup", "[", 
          RowBox[{"g", ",", " ", "unit", ",", " ", "cochain"}], "]"}], "]"}], 
        " ", "===", " ", 
        RowBox[{"KeySort", "[", "cochain", "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"KeySort", "[", 
         RowBox[{"OrderedCochainCup", "[", 
          RowBox[{"g", ",", " ", "cochain", ",", " ", "unit"}], "]"}], "]"}], 
        " ", "===", " ", 
        RowBox[{"KeySort", "[", "cochain", "]"}]}]}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8a00a518-4b44-453d-a43a-0c99ba4aa97a"],

