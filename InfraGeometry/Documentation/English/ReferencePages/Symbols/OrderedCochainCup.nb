}], "ExampleText",ExpressionUUID->"fb814381-7f05-418b-bb38-2f39d55986c8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"dx", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], "]"}]}], 
     ",", "\n", "   ", 
     RowBox[{"dy", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"commutator", " ", "=", " ", 
     RowBox[{"Merge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"OrderedCochainCup", "[", 
          RowBox[{"g", ",", " ", "dx", ",", " ", "dy"}], "]"}], ",", " ", 
         RowBox[{"OrderedCochainCup", "[", 
          RowBox[{"g", ",", " ", "dy", ",", " ", "dx"}], "]"}]}], "}"}], ",", 
       " ", "Total"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Max", " ", "@", " ", 
     RowBox[{"Abs", "[", 
      RowBox[{"Values", " ", "@", " ", 
       RowBox[{"Merge", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"commutator", ",", " ", 
           RowBox[{"-", 
            RowBox[{"Coboundary", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"CochainCupOne", "[", 
               RowBox[{"g", ",", " ", "dx", ",", " ", "dy"}], "]"}]}], 
             "]"}]}]}], "}"}], ",", " ", "Total"}], "]"}]}], "]"}]}], " ", "<",
     " ", 
    RowBox[{"10", "^", 
     RowBox[{"-", "12"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"babb8bbd-5ef5-443d-a41d-004a8a73c6a7"],

