         RowBox[{"OrderedCochainCup", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"Coboundary", "[", 
            RowBox[{"g", ",", " ", "f"}], "]"}], ",", " ", "b"}], "]"}], ",", 
         " ", 
         RowBox[{"OrderedCochainCup", "[", 
          RowBox[{"g", ",", " ", "f", ",", " ", 
           RowBox[{"Coboundary", "[", 
            RowBox[{"g", ",", " ", "b"}], "]"}]}], "]"}]}], "}"}], ",", " ", 
       "Total"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"KeySort", " ", "@", " ", 
     RowBox[{"Coboundary", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"OrderedCochainCup", "[", 
        RowBox[{"g", ",", " ", "f", ",", " ", "b"}], "]"}]}], "]"}]}], " ", "==",
     " ", 
    RowBox[{"KeySort", " ", "@", " ", 
     RowBox[{"DeleteCases", "[", 
