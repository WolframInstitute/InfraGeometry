Cell[CellGroupData[{
Cell["OrderedCochainCup", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fb4434e5-b2bb-4128-9938-cd24739de185"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["OrderedCochainCup"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainCup", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["\[Alpha]", "TR"], ",", " ", 
    StyleBox["\[Beta]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "735667d5-acf4-4f9a-8c87-10fe91452aee"],
 "\[LineSeparator]",
 "gives the Alexander\[Dash]Whitney cup product ",
 StyleBox["\[Alpha] \[Cup] \[Beta]", "TI"],
 " of the cochains ",
 StyleBox["\[Alpha]", "TI"],
 " and ",
 StyleBox["\[Beta]", "TI"],
 " on the increasing tuples of the cliques of ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"ca0cc48b-402e-452e-976b-ad34029efb23"],

Cell[TextData[{
 "For ",
 StyleBox["\[Alpha]", "TI"],
 " of degree ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["\[Beta]", "TI"],
 " of degree ",
 StyleBox["q", "TI"],
 ", with ",
 StyleBox["n = p + q", "TI"],
 ", ",
 StyleBox["(\[Alpha] \[Cup] \[Beta])(v\:2080, \[Ellipsis], v\:2099) = \
\[Alpha](v\:2080, \[Ellipsis], v\:209a) \[Beta](v\:209a, \[Ellipsis], \
v\:2099)", "TI"],
 " on each increasing tuple ",
 StyleBox["v\:2080 < \[Ellipsis] < v\:2099", "TI"],
 " of a clique: the front face of ",
 StyleBox["\[Alpha]", "TI"],
 " times the back face of ",
 StyleBox["\[Beta]", "TI"],
 ". The order is the one in which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Sort"]], "paclet:ref/Sort"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fe3372e4-ad74-4c6a-869a-4deff47b8fbe"],
 " puts the vertex names."
}], "Notes",ExpressionUUID->"05e87dd2-5c1c-41da-83bb-4ce559e4f195"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e4ff4b47-5aee-45bb-87b8-f1ff71460220"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"ce8bb0c9-d585-45a2-b535-3d524721ed83"],
     Cell["Statement", "TableText",
     FontWeight->Bold,ExpressionUUID->"aa37ad7a-28a7-4852-aeee-6d668b6b7801"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "09826767-3374-4f04-8b88-c3c291c6bed4"], Cell[
    "associative", "TableText",ExpressionUUID->
     "e753453b-d011-4f97-9761-1189cb5f9799"], Cell[TextData[{
     StyleBox[
     "(\[Alpha] \[Cup] \[Beta]) \[Cup] \[Gamma] = \[Alpha] \[Cup] (\[Beta] \
\[Cup] \[Gamma])", "TI"],
     ": both read three consecutive faces"
    }], "TableText",ExpressionUUID->"16611f57-f4aa-4abc-8142-0501e8710de1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a1501d5b-3705-4d30-8547-952124e403d4"], Cell[
    "unit", "TableText",ExpressionUUID->
     "fae9bad0-1c1d-46f2-b1b2-b296f460518b"], Cell[
    "the constant 0-cochain 1", "TableText",ExpressionUUID->
     "04fd8217-ba2b-4b6d-b8bd-8cb579f1ee27"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "23bf9aa6-6070-47b9-955e-97c6c526328b"], Cell[
    "Leibniz rule", "TableText",ExpressionUUID->
     "1d9e7c45-a374-4dff-adc6-79826d46b06b"], Cell[TextData[StyleBox[
    "\[Delta](\[Alpha] \[Cup] \[Beta]) = \[Delta]\[Alpha] \[Cup] \[Beta] + (\
\[Minus]1)\:1d56 \[Alpha] \[Cup] \[Delta]\[Beta]", "TI"]], "TableText",
     ExpressionUUID->"d0369ce0-06b2-4a33-97fd-daa8328fbb6d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a048d252-b7ea-4e05-a72d-3974207dbbad"], Cell[
    "not graded-commutative", "TableText",ExpressionUUID->
     "e0cb7a56-8c8f-4213-a257-7f0a037ced74"], Cell[TextData[{
     "on cocycles ",
     StyleBox[
     "\[Alpha] \[Cup] \[Beta] \[Minus] \[Beta] \[Cup] \[Alpha] = \[Delta](\
\[Alpha] \[Cup]\:2081 \[Beta])", "TI"],
     ", with a plus sign when ",
     StyleBox["p", "TI"],
     " and ",
     StyleBox["q", "TI"],
     " are both odd and ",
     StyleBox["\[Cup]\:2081", "TI"],
     " the ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["CochainCupOne"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/CochainCupOne", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "cb2d5934-76c4-49b8-bada-f9c060c66e95"]
    }], "TableText",ExpressionUUID->"bb4aca13-1039-42e1-9b1e-5dfe57e1d512"]}
  }]], "2ColumnTableMod",ExpressionUUID->"bcfd7bac-45e8-4de4-8d1e-\
e77672fe8cda"],

Cell[TextData[{
 "The result is an ordered cochain, defined on the increasing tuples only: \
read it with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrderedCochainValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f5e4527e-099c-4fe4-b505-2fc80ae9ef0e"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1214bdd2-4ca5-4604-a6ff-640378adb130"],
 " averages the product over the orderings of each clique, and is alternating \
and graded-commutative but not associative."
}], "Notes",ExpressionUUID->"efa8b242-5eb0-4f08-a10f-1d6aba4ad985"],

Cell["\<\
On the square grid there are no triangles, and the product of two 1-cochains \
is empty.\
\>", "Notes",ExpressionUUID->"cc381034-7718-4131-9d39-74696f0960cd"]
}, Open  ]],

