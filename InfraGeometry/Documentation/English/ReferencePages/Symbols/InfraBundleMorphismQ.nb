    StyleBox["fib2", "TI"], ",", " ", "F"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74dfc9b1-ad7c-4f26-8018-bb911882e5fb"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["f", "TI"],
 " to be ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Identity"]], "paclet:ref/Identity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "74868508-18f8-432b-87e8-495a52d423e9"],
 "."
}], "Usage",ExpressionUUID->"e9ec0741-81c3-4b8a-8116-119ec10b0fcf"],

Cell[TextData[{
 StyleBox["F", "TI"],
 " covers ",
 StyleBox["f", "TI"],
 " when the projection of ",
 StyleBox["F", "TI"],
 "(",
 StyleBox["x", "TI"],
 ") is ",
 StyleBox["f", "TI"],
 "(",
 StyleBox["p", "TI"],
 ") for every total vertex ",
 StyleBox["x", "TI"],
 " over ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"9cd7e9dc-8bcf-4175-81b4-ad0cc86a074d"],

Cell[TextData[{
 "An edge may go to an edge or collapse to a vertex: ",
 StyleBox["F", "TI"],
 " is a homomorphism of the total graphs with loops added."
}], "Notes",ExpressionUUID->"e393bcb8-8472-4dde-bc05-742131727417"],

Cell[TextData[{
 StyleBox["F", "TI"],
 " and ",
 StyleBox["f", "TI"],
 " are functions applied to one vertex. A vertex of a literal catalogue entry \
is a pair {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["k", "TI"],
 "}, so ",
 StyleBox["F", "TI"],
 " takes one argument."
}], "Notes",ExpressionUUID->"ae5af512-3768-4e93-b1e4-9bbc82d4686c"]
}, Open  ]],

