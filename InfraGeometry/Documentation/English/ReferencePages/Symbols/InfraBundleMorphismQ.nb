Cell[CellGroupData[{
Cell["InfraBundleMorphismQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c4d66f94-3f6c-4ca9-869e-bd687cf9bc35"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBundleMorphismQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBundleMorphismQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib1", "TI"], ",", " ", 
    StyleBox["fib2", "TI"], ",", " ", "F", ",", " ", 
    StyleBox["f", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d4a9bd1-1093-4601-bde6-f36f1f84756f"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fe701e09-37a6-43b7-8127-fc7a9e3fdf22"],
 " if ",
 StyleBox["F", "TI"],
 " is a bundle morphism from ",
 StyleBox["fib1", "TI"],
 " to ",
 StyleBox["fib2", "TI"],
 " over the base map ",
 StyleBox["f", "TI"],
 ": it sends the fiber over ",
 StyleBox["p", "TI"],
 " into the fiber over ",
 StyleBox["f", "TI"],
 "(",
 StyleBox["p", "TI"],
 "), and every total edge to an edge or a vertex.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4eeea089-96ec-4e39-81e7-7595d08c3813"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBundleMorphismQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBundleMorphismQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib1", "TI"], ",", " ", 
    StyleBox["fib2", "TI"], ",", " ", "F"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45ac90b5-8de0-46d6-8ee2-c01fbf0f1897"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["f", "TI"],
 " to be ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Identity"]], "paclet:ref/Identity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "efefa9b6-3c9b-485d-8628-29319cbd3873"],
 "."
}], "Usage",ExpressionUUID->"a5fc25ad-4471-41c9-a759-d827f450bb9b"],

Cell[TextData[{
 StyleBox["F", "TI"],
 " is a bundle morphism over ",
 StyleBox["f", "TI"],
 " when ",
 StyleBox["\[Pi]\:2082(F(x)) = f(\[Pi]\:2081(x))", "TI"],
 " for every total vertex ",
 StyleBox["x", "TI"],
 " of ",
 StyleBox["fib1", "TI"],
 ", and for every total edge ",
 StyleBox["{x, y}", "TI"],
 " either ",
 StyleBox["F(x) = F(y)", "TI"],
 " or ",
 StyleBox["{F(x), F(y)}", "TI"],
 " is a total edge of ",
 StyleBox["fib2", "TI"],
 ". So ",
 StyleBox["F", "TI"],
 " is a graph homomorphism of the total graphs with loops added, and it \
covers ",
 StyleBox["f", "TI"],
 "."
}], "Notes",ExpressionUUID->"6786bb61-1a47-4bd4-8c58-ecf8a8298dae"],

Cell[TextData[{
 StyleBox["F", "TI"],
 " and ",
 StyleBox["f", "TI"],
 " are functions of one vertex, or associations. The total vertices of the \
bundles are lists, so ",
 StyleBox["F", "TI"],
 " takes the list as its one argument."
}], "Notes",ExpressionUUID->"d5f01986-659a-4ebc-8eff-70110fd0482a"],

Cell[TextData[{
 "The natural maps of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBundleMorphism"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBundleMorphism", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c7564fcc-23a9-4943-a7c8-6dd727523e23"],
 " are bundle morphisms over the identity. A symmetry ",
 StyleBox["\[Sigma]", "TI"],
 " of the base acts on the displacement bundle by ",
 StyleBox["{p, v} \[RightTeeArrow] {\[Sigma](p), \[Sigma](v)}", "TI"],
 ", a bundle morphism over ",
 StyleBox["\[Sigma]", "TI"],
 "."
}], "Notes",ExpressionUUID->"865c3dba-b06a-45ac-9106-d92dc3755b51"]
}, Open  ]],

