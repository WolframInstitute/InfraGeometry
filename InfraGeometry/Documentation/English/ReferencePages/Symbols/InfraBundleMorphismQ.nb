Cell["\<\
The first step of a ray of length 2 is a pair at distance 1. The map lands in \
the displacement bundle at scale 1, not at scale 2:\
\>", "ExampleText",ExpressionUUID->"b439f0c4-befd-467e-96e2-4fd563dc76b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"tangent", " ", "=", " ", 
     RowBox[{"InfraTangentBundle", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraBundleMorphismQ", "[", 
      RowBox[{"tangent", ",", " ", 
       RowBox[{"InfraDisplacementBundle", "[", 
        RowBox[{"g", ",", " ", "r"}], "]"}], ",", " ", 
       RowBox[{"ray", " ", "|->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", "ray"}], ",", " ", 
          RowBox[{"ray", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "1"}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c67fad6d-9615-44c3-addc-37b1c208ca59"],

