Cell["\<\
The endpoint map, a ray to the pair of its first and last vertex, from the \
tangent to the displacement bundle at scale 2:\
\>", "ExampleText",ExpressionUUID->"8aac72c7-7334-492f-9443-49ab035d14f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"InfraBundleMorphismQ", "[", 
      RowBox[{
       RowBox[{"InfraTangentBundle", "[", 
        RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"InfraDisplacementBundle", "[", 
        RowBox[{"g", ",", " ", "2"}], "]"}], ",", "\n", "      ", 
       RowBox[{"ray", " ", "|->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", "ray"}], ",", " ", 
          RowBox[{"Last", " ", "@", " ", "ray"}]}], "}"}]}]}], "]"}]}], "]"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", 
       " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9803597b-69a1-41d3-ac7b-3340b5ca28e1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"18add5b2-0a83-4bb2-a367-52966b5e85be"]
}, Open  ]],

Cell["\<\
The prism and the M\[ODoubleDot]bius ladder over the cycle of length 8. \
Exchanging the two vertices of every fiber is a bundle morphism of both. \
Turning the cycle by one step is a bundle morphism of the prism over the \
turn, but not of the M\[ODoubleDot]bius ladder, whose twist stays in place:\
\>", "ExampleText",ExpressionUUID->"28468712-ec17-4a20-81c3-d3c43293828e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"swap", " ", "=", " ", 
      RowBox[{"x", " ", "|->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"First", " ", "@", " ", "x"}], ",", " ", 
         RowBox[{"3", " ", "-", " ", 
          RowBox[{"Last", " ", "@", " ", "x"}]}]}], "}"}]}]}], ",", " ", 
     RowBox[{"turn", " ", "=", " ", 
      RowBox[{"x", " ", "|->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"First", " ", "@", " ", "x"}], " ", "+", " ", "1"}], ",", 
           " ", "8", ",", " ", "1"}], "]"}], ",", " ", 
         RowBox[{"Last", " ", "@", " ", "x"}]}], "}"}]}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fibers", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraFiberedSubstrate", "[", 
        RowBox[{"#", ",", " ", "\"\<Small\>\""}], "]"}], " ", "&"}], " ", "/@",
       " ", 
      RowBox[{"{", 
       RowBox[{"\"\<CycleProductBundle\>\"", ",", 
        " ", "\"\<MoebiusLadderCover\>\""}], "}"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraFiberedGraphHighlight", "[", 
       RowBox[{"fib", ",", "\n", "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraBundleMorphismQ", "[", 
            RowBox[{"fib", ",", " ", "fib", ",", " ", "swap"}], "]"}], ",", 
           " ", 
           RowBox[{"InfraBundleMorphismQ", "[", 
            RowBox[{"fib", ",", " ", "fib", ",", " ", "turn", ",", " ", 
             RowBox[{"i", " ", "|->", " ", 
              RowBox[{"Mod", "[", 
               RowBox[{
                RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "8", ",", " ", 
                "1"}], "]"}]}]}], "]"}]}], "}"}]}]}], "]"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"fib", ",", " ", "fibers"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"70a41adf-aa9d-4f8e-b6a2-3d5ea2e60fa1"],

