Cell[TextData[{
 "The natural maps of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBundleMorphism"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBundleMorphism", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2ff1e802-8493-4018-ace7-c961022a6924"],
 " pass the test. The reversal from the tangent to the cotangent bundle on \
the mesh:"
}], "ExampleText",ExpressionUUID->"8276ad4c-0c5f-4ee4-89eb-3b67d780d6c0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"tangent", " ", "=", " ", 
      RowBox[{"InfraTangentBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}]}], ",", " ", 
     RowBox[{"cotangent", " ", "=", " ", 
      RowBox[{"InfraCotangentBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraBundleMorphismQ", "[", 
    RowBox[{"tangent", ",", " ", "cotangent", ",", " ", 
     RowBox[{"InfraBundleMorphism", "[", 
      RowBox[{"tangent", ",", " ", "cotangent"}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e4ab3b5a-6e79-45ad-acd0-003f44265adf"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7235771d-6f9d-45c4-b4fa-94a6fe6b7c0a"]
