Cell["\<\
The endpoint map from the tangent bundle to the displacement bundle at scale \
2 is a bundle morphism. The rays over 6 and their images are drawn.\
\>", "ExampleText",ExpressionUUID->"9de86f4a-7af1-431f-a776-97d511d1795f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"InfraFiberedSubstrate", "[", 
       RowBox[{"\"\<GridTangentBundle\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"tangent", " ", "=", " ", 
      RowBox[{"InfraTangentBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}]}], ",", " ", 
     RowBox[{"displacementBundle", " ", "=", " ", 
      RowBox[{"InfraDisplacementBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"endpoint", " ", "=", " ", 
     RowBox[{"ray", " ", "|->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"First", " ", "@", " ", "ray"}], ",", " ", 
        RowBox[{"Last", " ", "@", " ", "ray"}]}], "}"}]}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"rays", " ", "=", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"InfraFiber", "[", 
       RowBox[{"tangent", ",", " ", "6"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{
          RowBox[{"InfraTotalSpace", "[", "tangent", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{
             RowBox[{"InfraTotalSpace", "[", "tangent", "]"}], ",", " ", 
             "rays", ",", " ", "\"\<VertexDensity\>\""}], " ", "]"}], "}"}]}],
          "]"}], ",", "\n", "      ", 
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{
          RowBox[{"InfraTotalSpace", "[", "displacementBundle", "]"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{
             RowBox[{"InfraTotalSpace", "[", "displacementBundle", "]"}], ",",
              " ", 
             RowBox[{"endpoint", " ", "/@", " ", "rays"}], ",", 
             " ", "\"\<VertexDensity\>\""}], " ", "]"}], "}"}]}], "]"}]}], 
       "}"}], "]"}], ",", "\n", "    ", 
     RowBox[{"InfraBundleMorphismQ", "[", 
      RowBox[{
      "tangent", ",", " ", "displacementBundle", ",", " ", "endpoint"}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8c450080-c312-4e35-a397-18a9271bbe78"],

