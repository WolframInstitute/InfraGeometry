Cell["\<\
Swapping the two sheets is a bundle morphism of the prism and of the Moebius \
ladder over the identity. Turning the cycle by one step is a bundle morphism \
of the prism over the turn, but not of the Moebius ladder, whose twist does \
not move with the turn.\
\>", "ExampleText",ExpressionUUID->"5398c031-189a-497b-a20b-68091a52ecb7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"prism", " ", "=", " ", 
      RowBox[{"InfraFiberedSubstrate", "[", 
       RowBox[{"\"\<CycleProductBundle\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}], ",", " ", 
     RowBox[{"moebius", " ", "=", " ", 
      RowBox[{"InfraFiberedSubstrate", "[", 
       RowBox[{"\"\<MoebiusLadderCover\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"swap", " ", "=", " ", 
      RowBox[{"totalVertex", " ", "|->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"First", " ", "@", " ", "totalVertex"}], ",", " ", 
         RowBox[{"3", " ", "-", " ", 
          RowBox[{"Last", " ", "@", " ", "totalVertex"}]}]}], "}"}]}]}], ",", 
     "\n", "    ", 
     RowBox[{"turn", " ", "=", " ", 
      RowBox[{"totalVertex", " ", "|->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"First", " ", "@", " ", "totalVertex"}], " ", "+", " ", 
            "1"}], ",", " ", "8", ",", " ", "1"}], "]"}], ",", " ", 
         RowBox[{"Last", " ", "@", " ", "totalVertex"}]}], "}"}]}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraTotalSpace", "[", "prism", "]"}], ",", " ", 
        RowBox[{"InfraTotalSpace", "[", "moebius", "]"}]}], "}"}], "]"}], ",",
      "\n", "    ", 
     RowBox[{"InfraBundleMorphismQ", "[", 
      RowBox[{"prism", ",", " ", "prism", ",", " ", "swap"}], "]"}], ",", " ", 
     RowBox[{"InfraBundleMorphismQ", "[", 
      RowBox[{"moebius", ",", " ", "moebius", ",", " ", "swap"}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"InfraBundleMorphismQ", "[", 
      RowBox[{"prism", ",", " ", "prism", ",", " ", "turn", ",", " ", 
       RowBox[{"i", " ", "|->", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "8", ",", " ", "1"}], 
         "]"}]}]}], "]"}], ",", " ", 
     RowBox[{"InfraBundleMorphismQ", "[", 
      RowBox[{"moebius", ",", " ", "moebius", ",", " ", "turn", ",", " ", 
       RowBox[{"i", " ", "|->", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "8", ",", " ", "1"}], 
         "]"}]}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8523cfca-542d-4e1c-930e-d9c0eb6338da"],

