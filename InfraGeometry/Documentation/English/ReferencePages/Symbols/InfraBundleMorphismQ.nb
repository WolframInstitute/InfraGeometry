Cell[TextData[{
 "The reflection ",
 StyleBox["\[Sigma]", "TI"],
 " of the square grid in its diagonal, lifted to the displacement bundle, is \
a bundle morphism over ",
 StyleBox["\[Sigma]", "TI"],
 ", not over the identity:"
}], "ExampleText",ExpressionUUID->"675700f4-aa37-4ff7-80a1-ec2cfb7aef52"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"xy", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"Round", " ", "@", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"at", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"Values", "[", "xy", "]"}], ",", " ", 
        RowBox[{"Keys", "[", "xy", "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"fib", " ", "=", " ", 
      RowBox[{"InfraDisplacementBundle", "[", 
       RowBox[{"g", ",", " ", "1"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"flip", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"Keys", "[", "xy", "]"}], ",", " ", 
       RowBox[{"Lookup", "[", 
        RowBox[{"at", ",", " ", 
         RowBox[{"Reverse", " ", "/@", " ", 
          RowBox[{"Values", "[", "xy", "]"}]}]}], "]"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraBundleMorphismQ", "[", 
      RowBox[{"fib", ",", " ", "fib", ",", " ", 
       RowBox[{"pair", " ", "|->", " ", 
        RowBox[{"flip", " ", "/@", " ", "pair"}]}], ",", " ", "flip"}], "]"}],
      ",", " ", 
     RowBox[{"InfraBundleMorphismQ", "[", 
      RowBox[{"fib", ",", " ", "fib", ",", " ", 
       RowBox[{"pair", " ", "|->", " ", 
        RowBox[{"flip", " ", "/@", " ", "pair"}]}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8cefc838-4c95-468f-b876-dbb662324e6d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a384dff3-4513-4cd2-8d87-c0add5c720b4"]
}, Open  ]]
}, Open  ]],

