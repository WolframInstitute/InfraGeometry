  FontSize->0.9 Inherited,ExpressionUUID->
  "aaaf3989-3a2f-4ecd-aeb4-2a8e0e2876b8"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["F", "TI"],
 " maps the total vertices of ",
 StyleBox["fib1", "TI"],
 " to total vertices of ",
 StyleBox["fib2", "TI"],
 " over ",
 StyleBox["f", "TI"],
 ", and edges to edges or vertices.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"204ef257-81be-4993-85b5-ad5198ab55c8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBundleMorphismQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBundleMorphismQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
