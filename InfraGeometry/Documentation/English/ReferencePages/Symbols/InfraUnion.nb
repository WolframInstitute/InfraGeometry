Cell["\<\
Inclusion\[Dash]exclusion on the grid: the union has 41 = 25 + 24 \[Minus] 8 \
vertices. The second ball meets the rim and has 24:\
\>", "ExampleText",ExpressionUUID->"a25801e9-c1fa-44e3-9948-f2557bcac5f7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ballA", " ", "=", " ", 
      RowBox[{"InfraBall", "[", 
       RowBox[{"a", ",", " ", "3"}], "]"}]}], ",", " ", 
     RowBox[{"ballB", " ", "=", " ", 
      RowBox[{"InfraBall", "[", 
       RowBox[{"b", ",", " ", "3"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "#", ",", " ", "\"\<CountingMeasure\>\""}], 
      "]"}], " ", "&"}], " ", "/@", "\n", "    ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraUnion", "[", 
       RowBox[{"ballA", ",", " ", "ballB"}], "]"}], ",", " ", "ballA", ",", 
      " ", "ballB", ",", " ", 
      RowBox[{"InfraIntersection", "[", 
       RowBox[{"ballA", ",", " ", "ballB"}], "]"}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"67ce57b9-f589-4552-9f25-5cbeb7f420d9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"41", ",", "25", ",", "24", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"61eee1ef-db6d-4a0d-b283-3869e1d7a798"]
}, Open  ]],

