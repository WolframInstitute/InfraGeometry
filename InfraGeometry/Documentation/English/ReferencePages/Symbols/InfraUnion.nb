Cell[TextData[{
 "With a graph, every vertex must be a vertex of ",
 StyleBox["g", "TI"],
 "; otherwise the call stays unevaluated. The corner 1 is not a vertex of the \
grid:"
}], "ExampleText",ExpressionUUID->"18679007-2bd6-4398-9c48-310fb8f49542"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"VertexQ", "[", 
      RowBox[{"g", ",", " ", "1"}], "]"}], ",", " ", 
     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"InfraUnion", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", "3", "}"}]}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ba29be1e-319e-44fc-baf8-5ce22beb9f55"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "InfraUnion"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1122dd19-cad7-43f0-b978-bcc249ffa0de"]
