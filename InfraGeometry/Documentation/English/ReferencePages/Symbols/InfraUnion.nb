Cell["\<\
In a scene, a point of the union of two unit balls takes every vertex of \
either ball:\
\>", "ExampleText",ExpressionUUID->"a62f6f41-f458-4531-85f5-c89fea955491"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ballA", ",", " ", "ballB", ",", " ", "p"}], "}"}], ",", "\n",
        "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ballA", " ", "==", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"a", ",", " ", "1"}], "]"}]}], ",", " ", 
         RowBox[{"ballB", " ", "==", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"b", ",", " ", "1"}], "]"}]}], ",", " ", 
         RowBox[{"p", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", 
           RowBox[{"InfraUnion", "[", 
            RowBox[{"ballA", ",", " ", "ballB"}], "]"}], "]"}]}]}], "}"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Sort", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraSceneInstance", "[", 
       RowBox[{"#", ",", " ", "p"}], "]"}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"RandomInfraSceneInstance", "[", 
      RowBox[{"scene", ",", " ", "g", ",", " ", "All"}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"df5b73c7-1949-4f24-b1c5-39a087b54a16"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "35", ",", "44", ",", "45", ",", "46", ",", "55", ",", "56", ",", "57", ",",
    "66"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"aaca605d-25b0-47b9-915c-241a0b3f6b99"]
}, Open  ]]
}, Open  ]],

