Cell["The union of two vertex lists.", "ExampleText",ExpressionUUID->"05349be6-523a-4943-880e-487a030a9071"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraUnion", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "8", ",", " ", "13"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0301b0e8-62c6-47b8-a87a-6d82790ef173"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "8", ",", "13"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1fa87ffb-77cf-477c-a8e0-358b4365b9d1"]
}, Open  ]],

Cell["\<\
Two crossing segments on a grid: the density of their union is the sum of \
theirs.\
\>", "ExampleText",ExpressionUUID->"bbe2401a-77bb-4622-b5f4-09c96035cf9f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraMeasurement", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
   RowBox[{"InfraUnion", "[", 
    RowBox[{
     RowBox[{"InfraSegment", "[", 
      RowBox[{"1", ",", " ", "13"}], "]"}], ",", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"7", ",", " ", "19"}], "]"}]}], "]"}], ",", 
   " ", "\"\<VertexDensity\>\""}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"55486e73-82c5-4916-b3a1-4a8b5aa57796"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "6"}], ",", 
   RowBox[{"2", "\[Rule]", "3"}], ",", 
   RowBox[{"3", "\[Rule]", "1"}], ",", 
   RowBox[{"6", "\[Rule]", "3"}], ",", 
   RowBox[{"7", "\[Rule]", "10"}], ",", 
   RowBox[{"8", "\[Rule]", "6"}], ",", 
   RowBox[{"9", "\[Rule]", "1"}], ",", 
   RowBox[{"11", "\[Rule]", "1"}], ",", 
   RowBox[{"12", "\[Rule]", "6"}], ",", 
   RowBox[{"13", "\[Rule]", "10"}], ",", 
   RowBox[{"14", "\[Rule]", "3"}], ",", 
   RowBox[{"17", "\[Rule]", "1"}], ",", 
   RowBox[{"18", "\[Rule]", "3"}], ",", 
   RowBox[{"19", "\[Rule]", "6"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"ff692b40-2843-46fb-a01b-5067b3d6d429"]
}, Open  ]],

Cell["\<\
Inside a scene the union is a token: every vertex of either ball is one \
instance.\
\>", "ExampleText",ExpressionUUID->"94e3370e-f316-47f1-91d2-922b79bfab5b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"ballA", ",", " ", "ballB", ",", " ", "either"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ballA", ",", " ", "ballB", ",", " ", "either"}], "}"}], ",", 
       "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ballA", " ", "==", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"7", ",", " ", "1"}], "]"}]}], ",", " ", 
         RowBox[{"ballB", " ", "==", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"9", ",", " ", "1"}], "]"}]}], ",", " ", 
         RowBox[{"either", " ", "==", " ", 
          RowBox[{"InfraUnion", "[", 
           RowBox[{"ballA", ",", " ", "ballB"}], "]"}]}]}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Sort", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraSceneInstance", "[", 
       RowBox[{"#", ",", " ", "either"}], "]"}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"RandomInfraInstance", "[", " ", 
      RowBox[{"scene", ",", " ", "g", ",", " ", "All"}], " ", "]"}]}], 
    "]"}]}], "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"b2c9841b-505d-4ee5-b6e8-e60df77f8a61"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "2", ",", "4", ",", "6", ",", "7", ",", "8", ",", "9", ",", "10", ",", "12",
    ",", "14"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"e1aefcde-6e5a-4cfe-ac14-a1d68bdedbaf"]
}, Open  ]]
}, Open  ]],

