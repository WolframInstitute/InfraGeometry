Cell["The points of a union are the vertices of its parts:", "ExampleText",ExpressionUUID->"f3215688-fad4-4423-b584-8123137ef6e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraUnion", "[", 
        RowBox[{
         RowBox[{"InfraShell", "[", 
          RowBox[{"a", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"b", ",", " ", "2"}], "]"}]}], "]"}], ",", " ", "All"}], 
      "]"}]}], " ", "===", "\n", "    ", 
    RowBox[{"InfraUnion", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"RandomInfraPoint", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraShell", "[", 
         RowBox[{"a", ",", " ", "2"}], "]"}], ",", " ", "All"}], "]"}], ",", 
      " ", 
      RowBox[{"RandomInfraPoint", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraShell", "[", 
         RowBox[{"b", ",", " ", "2"}], "]"}], ",", " ", "All"}], "]"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"04a69780-aa3d-4e42-8b82-17746f8ba33b"],

