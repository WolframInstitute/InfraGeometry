Cell["\<\
The density of the union is the sum of the densities. It is 2 on the 8 \
vertices the balls share, drawn larger:\
\>", "ExampleText",ExpressionUUID->"2d9bf1d4-bfde-4bee-84a9-74bad59376ab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"density", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraUnion", "[", 
        RowBox[{
         RowBox[{"InfraBall", "[", 
          RowBox[{"a", ",", " ", "3"}], "]"}], ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{"b", ",", " ", "3"}], "]"}]}], "]"}], ",", 
       " ", "\"\<VertexDensity\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", "density", "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Counts", "[", 
       RowBox[{"Values", "[", "density", "]"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e9cf5c4e-31c4-491a-b3f9-cda497988600"],

