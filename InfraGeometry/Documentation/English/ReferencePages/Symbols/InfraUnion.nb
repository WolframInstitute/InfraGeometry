Cell["\<\
In a scene, a point of the union of two unit balls takes every vertex of \
either ball:\
\>", "ExampleText",ExpressionUUID->"a796b5b4-606a-4124-9ff8-8ef81840cfa9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ballA", ",", " ", "ballB", ",", " ", "p"}], "}"}], ",", "\n",
        "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ballA", " ", "==", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"a", ",", " ", "1"}], "]"}]}], ",", " ", 
         RowBox[{"ballB", " ", "==", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"b", ",", " ", "1"}], "]"}]}], ",", " ", 
         RowBox[{"p", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", 
           RowBox[{"InfraUnion", "[", 
            RowBox[{"ballA", ",", " ", "ballB"}], "]"}], "]"}]}]}], "}"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Sort", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraSceneInstance", "[", 
       RowBox[{"#", ",", " ", "p"}], "]"}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"RandomInfraSceneInstance", "[", 
      RowBox[{"scene", ",", " ", "g", ",", " ", "All"}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3a45dd8b-d1f3-48b4-b37b-4a679bcac132"],

