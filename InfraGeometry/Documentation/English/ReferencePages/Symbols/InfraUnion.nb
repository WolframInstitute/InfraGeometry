Cell["The union of two vertex lists.", "ExampleText",ExpressionUUID->"951c9c8f-35ca-416b-ba7a-f6fb2f361887"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraUnion", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "8", ",", " ", "13"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0ec34702-3428-42ea-b904-f3c1238fec69"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "8", ",", "13"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d36a4f61-4f67-417b-b699-915d7cbc2bac"]
}, Open  ]],

Cell["\<\
Two crossing segments on a grid: the density of their union is the sum of \
theirs.\
\>", "ExampleText",ExpressionUUID->"566d8d87-3d12-4000-aeb6-6e9832348af4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraMeasurement", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
   RowBox[{"InfraUnion", "[", 
    RowBox[{
     RowBox[{"InfraSegment", "[", 
      RowBox[{"1", ",", " ", "13"}], "]"}], ",", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"7", ",", " ", "19"}], "]"}]}], "]"}], ",", 
   " ", "\"\<VertexDensity\>\""}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"53290a5a-e4e9-41e3-ab62-0bd49d32dd4d"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "6"}], ",", 
   RowBox[{"2", "\[Rule]", "3"}], ",", 
   RowBox[{"3", "\[Rule]", "1"}], ",", 
   RowBox[{"6", "\[Rule]", "3"}], ",", 
   RowBox[{"7", "\[Rule]", "10"}], ",", 
   RowBox[{"8", "\[Rule]", "6"}], ",", 
   RowBox[{"9", "\[Rule]", "1"}], ",", 
   RowBox[{"11", "\[Rule]", "1"}], ",", 
   RowBox[{"12", "\[Rule]", "6"}], ",", 
   RowBox[{"13", "\[Rule]", "10"}], ",", 
   RowBox[{"14", "\[Rule]", "3"}], ",", 
   RowBox[{"17", "\[Rule]", "1"}], ",", 
   RowBox[{"18", "\[Rule]", "3"}], ",", 
   RowBox[{"19", "\[Rule]", "6"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"86a0e62b-eac4-42c1-8cdc-ba82b5740126"]
}, Open  ]],

Cell["\<\
Inside a scene the union is a token: every vertex of either ball is one \
instance.\
\>", "ExampleText",ExpressionUUID->"2450a1c5-020a-47ee-8528-c3c77c507d16"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"ballA", ",", " ", "ballB", ",", " ", "either"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ballA", ",", " ", "ballB", ",", " ", "either"}], "}"}], ",", 
       "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ballA", " ", "==", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"7", ",", " ", "1"}], "]"}]}], ",", " ", 
         RowBox[{"ballB", " ", "==", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"9", ",", " ", "1"}], "]"}]}], ",", " ", 
         RowBox[{"either", " ", "==", " ", 
          RowBox[{"InfraUnion", "[", 
           RowBox[{"ballA", ",", " ", "ballB"}], "]"}]}]}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Sort", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraSceneInstance", "[", 
       RowBox[{"#", ",", " ", "either"}], "]"}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"FindInfraScene", "[", 
      RowBox[{"scene", ",", " ", "g"}], "]"}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"05dcad71-1271-4fc2-96ae-1bcb2a836b8c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "2", ",", "4", ",", "6", ",", "7", ",", "8", ",", "9", ",", "10", ",", "12",
    ",", "14"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"1168a048-b20f-4004-9f3c-c4727a585376"]
}, Open  ]]
}, Open  ]],

