Cell["\<\
Inclusion\[Dash]exclusion on the grid: the union has 41 = 25 + 24 \[Minus] 8 \
vertices. The second ball meets the rim and has 24:\
\>", "ExampleText",ExpressionUUID->"3c3f484d-5301-4644-afe6-c82f03d22155"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ballA", " ", "=", " ", 
      RowBox[{"InfraBall", "[", 
       RowBox[{"a", ",", " ", "3"}], "]"}]}], ",", " ", 
     RowBox[{"ballB", " ", "=", " ", 
      RowBox[{"InfraBall", "[", 
       RowBox[{"b", ",", " ", "3"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "#", ",", " ", "\"\<CountingMeasure\>\""}], 
      "]"}], " ", "&"}], " ", "/@", "\n", "    ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraUnion", "[", 
       RowBox[{"ballA", ",", " ", "ballB"}], "]"}], ",", " ", "ballA", ",", 
      " ", "ballB", ",", " ", 
      RowBox[{"InfraIntersection", "[", 
       RowBox[{"ballA", ",", " ", "ballB"}], "]"}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3099929a-dda0-4c15-a938-22b785d692fc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"41", ",", "25", ",", "24", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"a7ecebca-2403-4bce-8315-8bc6de619d49"]
}, Open  ]],

