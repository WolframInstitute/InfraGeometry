Cell[TextData[{
 "The counting measure obeys inclusion\[Dash]exclusion, ",
 StyleBox["|A \:222a B| = |A| + |B| \[Minus] |A \:2229 B|", "TI"],
 ". The density of a union of balls is 2 on their intersection."
}], "Notes",ExpressionUUID->"31631de4-d20f-4934-be92-e5080b1f4db1"],

