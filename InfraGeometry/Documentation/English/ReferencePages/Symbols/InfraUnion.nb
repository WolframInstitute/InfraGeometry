Notebook[{

Cell[CellGroupData[{
Cell["InfraUnion", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f2d05fb2-3371-42dd-9082-8787634e2a40"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraUnion"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj1", "TI"], ",", " ", 
    StyleBox["obj2", "TI"], ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd5c30cb-92d2-4c9f-bd86-0d6e18540c74"],
 "\[LineSeparator]",
 "returns the vertex-set union of the given shapes on graph \[LongDash] \
vertex lists, densities, walk graphs \[LongDash] as a sorted List.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f1cb0a0b-5ce9-4bf3-8d74-178f6b783d75"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraUnion"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["obj1", "TI"], ",", " ", 
    StyleBox["obj2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "848e29cc-71fc-4025-88ca-47a0aa2ddbe2"],
 "\[LineSeparator]",
 "of two Euclidean heads is itself an inert head; InfraMeasurement evaluates \
it on a graph."
}], "Usage",ExpressionUUID->"0ba4acd8-9852-4e7e-9c22-209e8d24f5cd"],

Cell["\<\
On heads, InfraMeasurement gives the union its \"VertexDensity\" \[LongDash] \
the sum of the two densities \[LongDash] its \"Subgraph\" and the four \
volumes. It is not a family of walks, so it has no \"Graph\", \
\"Cardinality\", \"Length\", \"EdgeDensity\" or \"Faithful\".\
\>", "Notes",ExpressionUUID->"ddc6693e-1b76-41c8-9c2a-4f5d18237ccf"],

Cell[TextData[{
 "Inside InfraScene hypotheses ",
 Cell[BoxData[
  RowBox[{"InfraUnion", "[", 
   RowBox[{"c1", ",", " ", "c2"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dea9eba9-5d7f-4b74-a6f8-5f1a4492dec7"],
 " is the union token: every vertex of either object is one branch. It stays \
inert until the bindings resolve, the engine supplying the graph."
}], "Notes",ExpressionUUID->"d995a5a8-5888-4949-bda1-c5bb4b99b3a3"]
}, Open  ]],

