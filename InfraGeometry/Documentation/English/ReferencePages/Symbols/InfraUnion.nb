Cell["The points of a union are the vertices of its parts:", "ExampleText",ExpressionUUID->"0ec69916-ecb0-40d8-83a2-107b637978b8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraUnion", "[", 
        RowBox[{
         RowBox[{"InfraShell", "[", 
          RowBox[{"a", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"b", ",", " ", "2"}], "]"}]}], "]"}], ",", " ", "All"}], 
      "]"}]}], " ", "===", "\n", "    ", 
    RowBox[{"InfraUnion", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"RandomInfraPoint", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraShell", "[", 
         RowBox[{"a", ",", " ", "2"}], "]"}], ",", " ", "All"}], "]"}], ",", 
      " ", 
      RowBox[{"RandomInfraPoint", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraShell", "[", 
         RowBox[{"b", ",", " ", "2"}], "]"}], ",", " ", "All"}], "]"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"12a50368-b6ef-46d4-8a28-509e62683043"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"48e48720-2b31-431e-9d4d-bc017dc53794"]
}, Open  ]]
}, Open  ]],

