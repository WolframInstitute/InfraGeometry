Cell["The union of two vertex lists.", "ExampleText",ExpressionUUID->"456b72df-a55c-4679-9b47-291885431f85"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraUnion", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "8", ",", " ", "13"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e8dda8be-8495-4d53-8ab3-dd41c3c5e840"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "8", ",", "13"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"dd1cc2e2-0edf-409f-9415-1477ac9194f0"]
}, Open  ]],

Cell["\<\
Two crossing segments on a grid: the density of their union is the sum of \
theirs.\
\>", "ExampleText",ExpressionUUID->"a19b1dfe-7eb4-46bb-8970-eabf1a2c624f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraMeasurement", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
   RowBox[{"InfraUnion", "[", 
    RowBox[{
     RowBox[{"InfraSegment", "[", 
      RowBox[{"1", ",", " ", "13"}], "]"}], ",", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"7", ",", " ", "19"}], "]"}]}], "]"}], ",", 
   " ", "\"\<VertexDensity\>\""}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d440d905-9f7e-460c-8543-5c6b1728aba9"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "6"}], ",", 
   RowBox[{"2", "\[Rule]", "3"}], ",", 
   RowBox[{"3", "\[Rule]", "1"}], ",", 
   RowBox[{"6", "\[Rule]", "3"}], ",", 
   RowBox[{"7", "\[Rule]", "10"}], ",", 
   RowBox[{"8", "\[Rule]", "6"}], ",", 
   RowBox[{"9", "\[Rule]", "1"}], ",", 
   RowBox[{"11", "\[Rule]", "1"}], ",", 
   RowBox[{"12", "\[Rule]", "6"}], ",", 
   RowBox[{"13", "\[Rule]", "10"}], ",", 
   RowBox[{"14", "\[Rule]", "3"}], ",", 
   RowBox[{"17", "\[Rule]", "1"}], ",", 
   RowBox[{"18", "\[Rule]", "3"}], ",", 
   RowBox[{"19", "\[Rule]", "6"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"0ddd4332-a67c-42ee-87ff-a5c71521b2be"]
}, Open  ]],

Cell["\<\
Inside a scene the union is a token: every vertex of either ball is one \
instance.\
\>", "ExampleText",ExpressionUUID->"bb23b67a-3adc-48d0-92c8-035c978d3c8b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"ballA", ",", " ", "ballB", ",", " ", "either"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ballA", ",", " ", "ballB", ",", " ", "either"}], "}"}], ",", 
       "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ballA", " ", "==", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"7", ",", " ", "1"}], "]"}]}], ",", " ", 
         RowBox[{"ballB", " ", "==", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"9", ",", " ", "1"}], "]"}]}], ",", " ", 
         RowBox[{"either", " ", "==", " ", 
          RowBox[{"InfraUnion", "[", 
           RowBox[{"ballA", ",", " ", "ballB"}], "]"}]}]}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Sort", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraSceneInstance", "[", 
       RowBox[{"#", ",", " ", "either"}], "]"}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"FindInfraScene", "[", 
      RowBox[{"scene", ",", " ", "g"}], "]"}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"83ace87c-8ce5-4edb-8219-3951b963868a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "2", ",", "4", ",", "6", ",", "7", ",", "8", ",", "9", ",", "10", ",", "12",
    ",", "14"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"26d9ed0a-16dc-45bd-a269-22fddbacb1bb"]
}, Open  ]]
}, Open  ]],

