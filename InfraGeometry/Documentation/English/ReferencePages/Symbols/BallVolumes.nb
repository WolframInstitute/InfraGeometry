Cell[TextData[{
 "The profile counts the balls that ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9b6c08f1-ceea-4874-b143-2149154156be"],
 " builds, drawn here at radii 2, 4 and 6."
}], "ExampleText",ExpressionUUID->"14934297-e668-4191-88e6-10875e96c67c"],

