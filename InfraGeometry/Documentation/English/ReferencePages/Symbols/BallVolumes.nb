    BoxData["\"\<WithoutBoundary\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d2803429-6b4b-4035-8609-a3ca30f8e7d3"]], "TableText",ExpressionUUID->
     "c59d9a90-fab8-4980-bcdf-3aa0994c372c"], Cell[TextData[{
     "that number less the number of vertices of \[PartialD]",
     StyleBox["B_r", "TI"],
     ": the vertices all of whose neighbours are in the ball; in the bulk of \
a lattice this is ",
     StyleBox["V(r \[Minus] 1)", "TI"]
    }], "TableText",ExpressionUUID->"86ed0b36-6104-4979-a523-fd3fe5eae4d2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e4c00abd-b7e8-42bf-8dec-d04d49cbce2c"], Cell[TextData[Cell[
    BoxData["\"\<HalfBoundary\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "392ab3cf-b86e-4f72-8ab7-bf0592e4e722"]], "TableText",ExpressionUUID->
     "f24bbe83-065f-420c-8926-010f56755989"], Cell[TextData[{
     "the full count less half the boundary: on a flat lattice the norm-ball \
volume with no ",
     StyleBox["r^(d\[Minus]1)", "TI"],
     " term, ",
     StyleBox["2r\.b2 + 1", "TI"],
     " on the square grid"
    }], "TableText",ExpressionUUID->"88172b72-654e-488e-b0f1-ad6309a38e5e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "bbab62bc-4ba7-4f9b-83bc-56fbc40f4476"], Cell[TextData[Cell[
    BoxData["\"\<ExpandingFront\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7ef2ca0c-91a6-4096-b2a9-54c6688bcf2f"]], "TableText",ExpressionUUID->
     "dbce3ba0-757d-43a9-94a6-c832fc9da614"], Cell[TextData[{
     "the passage count of ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["FindAdvancingInfraFront"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/FindAdvancingInfraFront", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "414a115b-9e54-4212-841a-d0bc8cbc3d1a"],
     ", which does not stop at the eccentricity; ",
     StyleBox["r", "TI"],
     " is then a step count, and ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3976db83-588c-4bd9-9328-3e98e30e644c"],
     " runs twice the eccentricity"
    }], "TableText",ExpressionUUID->"4016de43-7cf6-465c-87d5-6f898af4fb7f"]}
  }]], "2ColumnTableMod",ExpressionUUID->"49e8c98f-3c82-425a-9d07-\
3ab70534bb46"]
}, Open  ]],

