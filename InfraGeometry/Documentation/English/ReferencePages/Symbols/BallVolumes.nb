   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1105818-52fc-42be-92c1-1805e5eaf0f0"],
 "\[LineSeparator]",
 "gives the ball-volume profile {",
 StyleBox["V", "TI"],
 "(0), ",
 StyleBox["V", "TI"],
 "(1), \[Ellipsis], ",
 StyleBox["V", "TI"],
 "(",
 StyleBox["e", "TI"],
 ")} at the vertex ",
 StyleBox["v", "TI"],
 ", where ",
 StyleBox["V", "TI"],
 "(",
 StyleBox["r", "TI"],
 ") = |",
 StyleBox["B_r", "TI"],
 "(",
 StyleBox["v", "TI"],
 ")| and ",
 StyleBox["e", "TI"],
 " is the eccentricity of ",
 StyleBox["v", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b98cb0ca-dfb6-434c-abd8-c4ed07f81dd4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallVolumes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallVolumes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3c09b5c-d29c-4aa6-8360-ee949a4611da"],
 "\[LineSeparator]",
 "gives the single volume ",
 StyleBox["V", "TI"],
 "(",
 StyleBox["r", "TI"],
 ").",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b5014aba-8c76-4191-9144-0a18efffdd31"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallVolumes"]], 
