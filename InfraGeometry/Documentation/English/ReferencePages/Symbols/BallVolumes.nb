Cell["Measure", "ExampleSubsection",ExpressionUUID->"1ee8df54-3fea-4549-92c5-d8130b67e9f4"],

Cell[TextData[{
 "The four measures at the centre of the square tiling. Without the boundary \
the profile is shifted by one radius; at half weight it is ",
 StyleBox["2r\.b2 + 1", "TI"],
 " from radius 1 on."
}], "ExampleText",ExpressionUUID->"eb86edb9-0d9d-4eb1-8f9a-bb3fa22bf5f9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Large\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"measures", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<FullCount\>\"", ",", " ", "\"\<WithoutBoundary\>\"", ",", 
       " ", "\"\<HalfBoundary\>\"", ",", " ", "\"\<ExpandingFront\>\""}], 
      "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"BallVolumes", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "6"}], "}"}], ",", " ", 
         RowBox[{"\"\<Measure\>\"", " ", "->", " ", "m"}]}], "]"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "measures"}], "}"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"DataRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "6"}], "}"}]}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", "measures"}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<r\>\"", ",", " ", "\"\<V(r)\>\""}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
