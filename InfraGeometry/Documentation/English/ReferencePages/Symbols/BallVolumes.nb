Cell["\<\
Ball volume against radius at the centre of the discretized plane, the square \
tiling and the hexagonal tiling. All three grow quadratically; the \
coefficient belongs to the substrate.\
\>", "ExampleText",ExpressionUUID->"d1cb10eb-3b0d-4456-8696-62bfe4c92b32"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"names", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
        ",", " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"ListLinePlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"gr", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"nm", ",", " ", "\"\<Large\>\""}], "]"}]}], "}"}], ",", 
         " ", 
         RowBox[{"BallVolumes", "[", 
          RowBox[{"gr", ",", " ", 
           RowBox[{"InfraCenter", "[", "gr", "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "12"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"nm", ",", " ", "names"}], "}"}]}], "]"}], ",", "\n", "    ", 
     
     RowBox[{"DataRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "12"}], "}"}]}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", "names"}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<r\>\"", ",", " ", "\"\<V(r)\>\""}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e287cb86-0505-4fee-9f6f-763140f8b197"],

