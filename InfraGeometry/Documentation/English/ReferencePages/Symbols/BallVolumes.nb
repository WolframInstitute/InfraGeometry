Cell["Measure", "ExampleSubsection",ExpressionUUID->"6b46ea7b-f766-407f-8551-cf23740cc90b"],

Cell[TextData[{
 "The four measures at the centre of the square tiling. Without the boundary \
the profile is shifted by one radius; at half weight it is ",
 StyleBox["2r\.b2 + 1", "TI"],
 " from radius 1 on."
}], "ExampleText",ExpressionUUID->"1d918391-25ff-4be2-b9d0-4ea74e59f7c0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Large\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"measures", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<FullCount\>\"", ",", " ", "\"\<WithoutBoundary\>\"", ",", 
       " ", "\"\<HalfBoundary\>\"", ",", " ", "\"\<ExpandingFront\>\""}], 
      "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"BallVolumes", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "6"}], "}"}], ",", " ", 
         RowBox[{"\"\<Measure\>\"", " ", "->", " ", "m"}]}], "]"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "measures"}], "}"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"DataRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "6"}], "}"}]}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", "measures"}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<r\>\"", ",", " ", "\"\<V(r)\>\""}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
