Cell["\<\
A window past the eccentricity saturates, so the profiles of a vertex list \
line up: here at the centre and at a vertex near the rim of the square tiling.\
\>", "ExampleText",ExpressionUUID->"e6f01dd6-81fc-48e2-b762-3ca683ad5946"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rimPoint", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "6"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c", ",",
          " ", "rimPoint"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"BallVolumes", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"c", ",", " ", "rimPoint"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "14"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"DataRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "14"}], "}"}]}], ",", " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", 
       "     ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<centre\>\"", ",", " ", "\"\<near the rim\>\""}], 
         "}"}]}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<r\>\"", ",", " ", "\"\<V(r)\>\""}], "}"}]}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e1f3648d-74ad-46c3-a66e-a133056272ed"],

