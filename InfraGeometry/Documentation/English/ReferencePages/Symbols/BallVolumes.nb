Cell["\<\
On the square torus the ball fills the graph at its eccentricity, and the \
expanding front keeps going round.\
\>", "ExampleText",ExpressionUUID->"363825f8-2b04-481b-a737-2ed1a77d63b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"torusPoint", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"VertexList", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"BallVolumes", "[", 
        RowBox[{"g", ",", " ", "torusPoint"}], "]"}], ",", " ", 
       RowBox[{"BallVolumes", "[", 
        RowBox[{"g", ",", " ", "torusPoint", ",", " ", 
         RowBox[{"\"\<Measure\>\"", " ", "->", 
          " ", "\"\<ExpandingFront\>\""}]}], "]"}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<FullCount\>\"", ",", " ", "\"\<ExpandingFront\>\""}], 
       "}"}]}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<r\>\"", ",", " ", "\"\<V(r)\>\""}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"cc13846b-fc1c-49af-a05a-10548c4d2c52"],

