Cell["\<\
The shell areas are the differences of the volumes, under every measure.\
\>", "ExampleText",ExpressionUUID->"8c3ed947-a02f-4762-a6d0-e05fe9154224"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Accumulate", " ", "@", " ", 
       RowBox[{"ShellAreas", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", 
         RowBox[{"\"\<Measure\>\"", " ", "->", " ", "m"}]}], "]"}]}], " ", "===",
       " ", 
      RowBox[{"BallVolumes", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"\"\<Measure\>\"", " ", "->", " ", "m"}]}], "]"}]}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<FullCount\>\"", ",", " ", "\"\<WithoutBoundary\>\"", ",",
          " ", "\"\<HalfBoundary\>\""}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"b2d43b6c-a773-4955-a76c-59d98758024a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"ea537f4e-cf69-4388-a192-13d66856356d"]
}, Open  ]]
}, Open  ]],

