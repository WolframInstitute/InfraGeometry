Cell[TextData[{
 "The mean profile over a set of vertices near the centre of the discretized \
plane, carrying the spread as ",
 Cell[BoxData["Around"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d1b11fc-b334-4ee7-9413-414c48b31706"],
 " values, drawn as error bars."
}], "ExampleText",ExpressionUUID->"47e4f1d1-ebe4-49d6-963f-bea53676490a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sampleSet", " ", "=", " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"FindInfraBall", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
       " ", "5"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"meanProfile", " ", "=", " ", 
     RowBox[{"MeanAround", " ", "/@", " ", 
      RowBox[{"Transpose", " ", "@", " ", 
       RowBox[{"BallVolumes", "[", 
        RowBox[{"g", ",", " ", "sampleSet", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "5"}], "}"}]}], "]"}]}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{"meanProfile", ",", " ", 
       RowBox[{"DataRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "5"}], "}"}]}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<r\>\"", ",", " ", "\"\<V(r)\>\""}], "}"}]}]}], "]"}], ",",
      " ", "meanProfile"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"92017b53-26a0-420b-81a7-f92166163a0b"],

