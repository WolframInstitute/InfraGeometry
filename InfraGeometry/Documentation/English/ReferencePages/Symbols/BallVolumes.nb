    }], "TableText",ExpressionUUID->"2a285804-d234-4308-bf66-cb192f560cd5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c8fafb30-824d-45d6-8edc-648a4dcb25a6"], Cell[TextData[Cell[
    BoxData["\"\<WithoutBoundary\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ad885b21-7040-49b2-9a7d-bfdcd8bbd106"]], "TableText",ExpressionUUID->
     "0fa18542-3f71-4ef6-b1a0-9a15e9be132c"], Cell[TextData[{
     "that number less the number of vertices of \[PartialD]",
     StyleBox["B_r", "TI"],
     ": the vertices all of whose neighbours are in the ball; in the bulk of \
a lattice this is ",
     StyleBox["V(r \[Minus] 1)", "TI"]
    }], "TableText",ExpressionUUID->"d0e306af-f968-49dc-b856-3e7c0a1787b9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "90576adb-bfc9-4f75-9ee8-671b0d15d3f6"], Cell[TextData[Cell[
    BoxData["\"\<HalfBoundary\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0ac1f876-fe21-4c4f-8689-84473ec1420b"]], "TableText",ExpressionUUID->
     "a4a068c8-6173-4d85-b075-b0ef438c1813"], Cell[TextData[{
     "the full count less half the boundary: on a flat lattice the norm-ball \
volume with no ",
     StyleBox["r^(d\[Minus]1)", "TI"],
     " term, ",
     StyleBox["2r\.b2 + 1", "TI"],
     " on the square grid"
    }], "TableText",ExpressionUUID->"a38ce68a-0cea-402a-b3e9-99267421e2d0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e7a95a06-e567-418f-927f-ccab245b5f6e"], Cell[TextData[Cell[
    BoxData["\"\<ExpandingFront\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "65154b13-2d4e-4cfe-873f-19b3adf8f629"]], "TableText",ExpressionUUID->
     "17c3ea1b-4989-4d77-8f68-fd933b5199fa"], Cell[TextData[{
     "the passage count of ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["FindAdvancingInfraFront"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/FindAdvancingInfraFront", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "c58b205f-95d3-432e-af42-5593406ceeab"],
     ", which does not stop at the eccentricity; ",
     StyleBox["r", "TI"],
     " is then a step count, and ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "19af7ace-ce6d-4bb7-9043-19497229fe42"],
     " runs twice the eccentricity"
    }], "TableText",ExpressionUUID->"0cc09466-0091-471b-903e-eb293e195592"]}
  }]], "2ColumnTableMod",ExpressionUUID->"80f7a000-d4c4-4717-b8be-\
1b9995aaae98"]
}, Open  ]],

