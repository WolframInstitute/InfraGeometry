   {Cell["      ", "ModInfo",ExpressionUUID->
     "c0b2af4e-8ab8-44a5-947c-208b042e7ad2"], Cell[TextData[Cell[
    BoxData["\"\<WithoutBoundary\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "203bc05f-d1fc-4e83-a14d-f0969f4711f6"]], "TableText",ExpressionUUID->
     "8ebdbdaa-ce67-4d5f-889e-03d6b90573d7"], Cell[TextData[{
     "that number less the number of vertices of \[PartialD]",
     StyleBox["B_r", "TI"],
     ": the vertices all of whose neighbours are in the ball; in the bulk of \
a lattice this is ",
     StyleBox["V(r \[Minus] 1)", "TI"]
    }], "TableText",ExpressionUUID->"f150ed85-b924-4447-80c2-0fa4e026af7f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "87f5c32d-1689-4116-a88f-0643bbe9e6b9"], Cell[TextData[Cell[
    BoxData["\"\<HalfBoundary\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "07383e5b-2689-4cdf-9ef7-8919293f5a52"]], "TableText",ExpressionUUID->
     "7d0599b9-9121-45ff-ae96-7c3fb8936650"], Cell[TextData[{
     "the full count less half the boundary: on a flat lattice the norm-ball \
volume with no ",
     StyleBox["r^(d\[Minus]1)", "TI"],
     " term, ",
     StyleBox["2r\.b2 + 1", "TI"],
     " on the square grid"
    }], "TableText",ExpressionUUID->"981bbbb2-768b-449d-a208-70b746b775d2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "eedf8baa-56ff-410b-a0c9-056960e9666a"], Cell[TextData[Cell[
    BoxData["\"\<ExpandingFront\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3392b6ec-d754-4c7d-8e2c-7d8f6a7a33eb"]], "TableText",ExpressionUUID->
     "0ae48859-b065-457f-8867-3b74f20731fa"], Cell[TextData[{
     "the passage count of ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["FindAdvancingInfraFront"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/FindAdvancingInfraFront", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "8d451326-88cc-4b73-bb0a-01539a7d7a0a"],
     ", which does not stop at the eccentricity; ",
     StyleBox["r", "TI"],
     " is then a step count, and ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1d6d5049-e6c1-4ecd-bbb5-841ea17aeff5"],
     " runs twice the eccentricity"
    }], "TableText",ExpressionUUID->"a69b86b9-2138-4b61-8bf8-992467b3c434"]}
  }]], "2ColumnTableMod",ExpressionUUID->"10be6392-c506-4478-add0-\
d1bb7d833933"]
}, Open  ]],

