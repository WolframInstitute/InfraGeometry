Cell["\<\
The ball of radius 3 at the centre of the square tiling, with its boundary, \
the vertices that have a neighbour outside, drawn as points. The three \
measures count all of it, its interior, and the interior plus half the \
boundary.\
\>", "ExampleText",ExpressionUUID->"3b30db24-b69b-4b2f-8c53-58c7e1d2041b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ball", " ", "->", " ", "$InfraBallColor"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
         RowBox[{"Sequence", " ", "@@", " ", 
          RowBox[{"FindInfraShell", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}]}]}], "}"}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"BallVolumes", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "3", ",", " ", 
         RowBox[{"\"\<Measure\>\"", " ", "->", " ", "#"}]}], "]"}], " ", 
       "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<FullCount\>\"", ",", " ", "\"\<WithoutBoundary\>\"", ",", 
        " ", "\"\<HalfBoundary\>\""}], "}"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5c2505d2-aa42-4a7c-9b2d-c184c3fe0872"],

