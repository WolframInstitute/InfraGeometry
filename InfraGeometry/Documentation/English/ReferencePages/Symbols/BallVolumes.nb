Cell["\<\
On the square torus the ball fills the graph at its eccentricity, and the \
expanding front keeps going round.\
\>", "ExampleText",ExpressionUUID->"49a5b40a-24b2-4cb7-9e7e-2cb5c6a826f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"torusPoint", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"VertexList", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"BallVolumes", "[", 
        RowBox[{"g", ",", " ", "torusPoint"}], "]"}], ",", " ", 
       RowBox[{"BallVolumes", "[", 
        RowBox[{"g", ",", " ", "torusPoint", ",", " ", 
         RowBox[{"\"\<Measure\>\"", " ", "->", 
          " ", "\"\<ExpandingFront\>\""}]}], "]"}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<FullCount\>\"", ",", " ", "\"\<ExpandingFront\>\""}], 
       "}"}]}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<r\>\"", ",", " ", "\"\<V(r)\>\""}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6fec860f-725d-4cc1-9e71-e4285a27f4ae"],

