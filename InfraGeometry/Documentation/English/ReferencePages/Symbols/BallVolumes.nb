Cell["\<\
The shell areas are the differences of the volumes, under every measure.\
\>", "ExampleText",ExpressionUUID->"00468de8-56d9-4628-9ccd-cbde73a610bd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"measures", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<FullCount\>\"", ",", " ", "\"\<WithoutBoundary\>\"", ",", 
       " ", "\"\<HalfBoundary\>\""}], "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Accumulate", " ", "@", " ", 
          RowBox[{"ShellAreas", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", 
            RowBox[{"\"\<Measure\>\"", " ", "->", " ", "m"}]}], "]"}]}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "measures"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", 
       "     ", 
       RowBox[{"PlotLegends", " ", "->", " ", "measures"}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<r + 1\>\"", ",", " ", "\"\<V(r)\>\""}], "}"}]}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Accumulate", " ", "@", " ", 
         RowBox[{"ShellAreas", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", 
           RowBox[{"\"\<Measure\>\"", " ", "->", " ", "m"}]}], "]"}]}], " ", "===",
         " ", 
        RowBox[{"BallVolumes", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", 
          RowBox[{"\"\<Measure\>\"", " ", "->", " ", "m"}]}], "]"}]}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "measures"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"e4abaf9d-e486-4e21-9b66-b6fa049c902c"],

