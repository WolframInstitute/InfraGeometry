Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1c1a9c85-c2ee-4e6b-a3d7-e2d5cf0ae6d4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallVolumes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallVolumes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d47fd70b-1ab5-474e-ba81-8e6e29abf860"],
 "\[LineSeparator]",
 "gives the ball-volume profile {",
 StyleBox["V", "TI"],
 "(0), ",
 StyleBox["V", "TI"],
 "(1), \[Ellipsis], ",
 StyleBox["V", "TI"],
 "(",
 StyleBox["e", "TI"],
 ")} at the vertex ",
 StyleBox["v", "TI"],
 ", where ",
 StyleBox["V", "TI"],
 "(",
 StyleBox["r", "TI"],
 ") = |",
 StyleBox["B_r", "TI"],
 "(",
 StyleBox["v", "TI"],
 ")| and ",
 StyleBox["e", "TI"],
 " is the eccentricity of ",
 StyleBox["v", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"167c436c-d239-4d55-87fd-a9d42b051d7f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallVolumes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallVolumes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bad0459f-21bf-4fe0-ad8a-35f02f871c96"],
 "\[LineSeparator]",
 "gives the single volume ",
 StyleBox["V", "TI"],
 "(",
 StyleBox["r", "TI"],
 ").",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"72958b11-591e-4732-8ed4-01695c733909"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallVolumes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallVolumes", 
