  FontSize->0.9 Inherited,ExpressionUUID->
  "3b2e5f06-66f0-42e7-8994-62d0ae2414e7"],
 "\[LineSeparator]",
 "gives the ball-volume profile {",
 StyleBox["V", "TI"],
 "(0), ",
 StyleBox["V", "TI"],
 "(1), \[Ellipsis], ",
 StyleBox["V", "TI"],
 "(",
 StyleBox["e", "TI"],
 ")} at the vertex ",
 StyleBox["v", "TI"],
 ", where ",
 StyleBox["V", "TI"],
 "(",
 StyleBox["r", "TI"],
 ") = |",
 StyleBox["B_r", "TI"],
 "(",
 StyleBox["v", "TI"],
 ")| and ",
 StyleBox["e", "TI"],
 " is the eccentricity of ",
 StyleBox["v", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8e577626-90f6-400f-9696-48564b4f92b3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallVolumes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallVolumes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d4e6548-a46d-4c6c-9035-e6f2e602c9b9"],
 "\[LineSeparator]",
 "gives the single volume ",
 StyleBox["V", "TI"],
 "(",
 StyleBox["r", "TI"],
 ").",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0a319e3a-e34e-4ddc-8ea0-35634c7f89bc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
