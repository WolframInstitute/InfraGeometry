Cell[TextData[{
 "The square tiling's profile is the \[ScriptL]\.b9 ball ",
 StyleBox["2r\.b2 + 2r + 1", "TI"],
 ", the gray curve, up to its rim."
}], "ExampleText",ExpressionUUID->"6e52dcef-fbc3-4ae5-a002-1ad54c0fd509"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Large\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"prof", " ", "=", " ", 
     RowBox[{"BallVolumes", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCenter", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ListPlot", "[", 
        RowBox[{"prof", ",", " ", 
         RowBox[{"DataRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", 
            RowBox[{
             RowBox[{"Length", "[", "prof", "]"}], " ", "-", " ", "1"}]}], 
           "}"}]}], ",", " ", 
         RowBox[{"AxesLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<r\>\"", ",", " ", "\"\<V(r)\>\""}], "}"}]}]}], "]"}], 
       ",", "\n", "     ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"r", "^", "2"}]}], " ", "+", " ", 
          RowBox[{"2", " ", "r"}], " ", "+", " ", "1"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "0", ",", " ", 
           RowBox[{
            RowBox[{"Length", "[", "prof", "]"}], " ", "-", " ", "1"}]}], 
          "}"}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", "Gray"}]}], "]"}]}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"prof", " ", "===", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"r", "^", "2"}]}], " ", "+", " ", 
         RowBox[{"2", " ", "r"}], " ", "+", " ", "1"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r", ",", " ", "0", ",", " ", 
          RowBox[{
           RowBox[{"Length", "[", "prof", "]"}], " ", "-", " ", "1"}]}], 
         "}"}]}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"387cb458-db0d-45c1-a52f-f4ad5c48aa40"],

