   {Cell["      ", "ModInfo",ExpressionUUID->
     "d03fdbc7-eecc-465e-82aa-82715bd20400"], Cell[TextData[Cell[
    BoxData["\"\<WithoutBoundary\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "56d70456-fa94-42e3-852a-76addcaad374"]], "TableText",ExpressionUUID->
     "85c90742-b2a7-4ce6-9993-62d447597dde"], Cell[TextData[{
     "that number less the number of vertices of \[PartialD]",
     StyleBox["B_r", "TI"],
     ": the vertices all of whose neighbours are in the ball; in the bulk of \
a lattice this is ",
     StyleBox["V(r \[Minus] 1)", "TI"]
    }], "TableText",ExpressionUUID->"4ee08223-5d3c-41b0-bf0e-30f32d68d74c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ef45d7ab-9bc7-4df6-b7db-e72ee9d1c1e5"], Cell[TextData[Cell[
    BoxData["\"\<HalfBoundary\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2da1fe79-968a-4100-b0b6-0291f4c6579b"]], "TableText",ExpressionUUID->
     "6ee50db8-1970-43f8-80ef-0e65e3ab69f8"], Cell[TextData[{
     "the full count less half the boundary: on a flat lattice the norm-ball \
volume with no ",
     StyleBox["r^(d\[Minus]1)", "TI"],
     " term, ",
     StyleBox["2r\.b2 + 1", "TI"],
     " on the square grid"
    }], "TableText",ExpressionUUID->"ad354073-0860-46ef-8348-e5887b6057c1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8a649b62-bee1-42f3-81a2-e0ceddfbb488"], Cell[TextData[Cell[
    BoxData["\"\<ExpandingFront\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ba9b6e8a-84e4-4be0-a469-d1dd9e5095cc"]], "TableText",ExpressionUUID->
     "33b5a8b8-30dc-47b0-9464-bcb5e8060267"], Cell[TextData[{
     "the passage count of ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["FindAdvancingInfraFront"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/FindAdvancingInfraFront", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "ed4b44e5-0233-4b21-9211-2ad8dd4ad6b7"],
     ", which does not stop at the eccentricity; ",
     StyleBox["r", "TI"],
     " is then a step count, and ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "357ce12b-f2d4-4578-8834-2af9497233ed"],
     " runs twice the eccentricity"
    }], "TableText",ExpressionUUID->"212423bf-1a85-4ea9-a4a8-6d4f1bb93c80"]}
  }]], "2ColumnTableMod",ExpressionUUID->"7ad2fcb3-eb37-4ece-bf8f-\
ef5c535a6580"]
}, Open  ]],

