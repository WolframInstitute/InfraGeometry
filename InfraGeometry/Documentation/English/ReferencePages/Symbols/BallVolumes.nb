Cell["BallVolumes", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6e0599d7-26a7-4c08-851a-b62c64f57354"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallVolumes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallVolumes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c9dd99d9-3be6-482b-977a-80e963960451"],
 "\[LineSeparator]",
 "gives the ball-volume profile {",
 StyleBox["V", "TI"],
 "(0), ",
 StyleBox["V", "TI"],
 "(1), \[Ellipsis], ",
 StyleBox["V", "TI"],
 "(",
 StyleBox["e", "TI"],
 ")} at the vertex ",
 StyleBox["v", "TI"],
 ", where ",
 StyleBox["V", "TI"],
 "(",
 StyleBox["r", "TI"],
 ") = |",
 StyleBox["B_r", "TI"],
 "(",
 StyleBox["v", "TI"],
 ")| and ",
 StyleBox["e", "TI"],
 " is the eccentricity of ",
 StyleBox["v", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"12f996af-2245-4aed-a066-331772dc3230"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallVolumes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallVolumes", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74650dbf-49a8-404e-b9a6-9d72008b3e0e"],
 "\[LineSeparator]",
 "gives the single volume ",
 StyleBox["V", "TI"],
 "(",
 StyleBox["r", "TI"],
 ").",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"9c47c3b6-e6b2-4006-8a2e-2d5f771649b6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallVolumes"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallVolumes", 
