        RowBox[{"3", ",", " ", "3"}], " ", "}"}], " ", "]"}]}], " ", "}"}], ",",
     "\n", "  ", 
    RowBox[{"InfraMeasurement", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"InfraMidpoint", "[", " ", 
       RowBox[{"1", ",", " ", "9"}], " ", "]"}], ",", 
      " ", "\"\<VertexDensity\>\""}], " ", "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"a93e055c-86dd-4171-b135-bcd0803157da"],

