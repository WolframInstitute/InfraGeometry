Cell["\<\
On the grid, three steps along each axis: the midpoint is a diagonal of four \
vertices, with 1, 9, 9 and 1 shortest paths through them:\
\>", "ExampleText",ExpressionUUID->"6eb66e70-ac30-4c47-8f6b-d685cc0e2bcb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"xy", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", " ", 
   
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{"xy", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"#", " ", "-", " ", 
            RowBox[{"xy", "[", "p", "]"}]}], " ", "==", " ", 
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "3"}], "}"}]}], " ", "&"}]}], "]"}]}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"density", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraMidpoint", "[", 
        RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
       " ", "\"\<VertexDensity\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraSegment", "[", 
        RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "density", ",", " ", 
       "p", ",", " ", "q"}], "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Values", "[", "density", "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"881592e2-bec8-4f34-a676-1f74995ff918"],

