Cell["Read both middle layers of a segment with odd length.", "ExampleText",ExpressionUUID->"f7bd8fb0-3eb1-49c6-824c-c3167abd67c0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"PathGraph", "[", " ", 
       RowBox[{"Range", "[", " ", "4", " ", "]"}], " ", "]"}]}], " ", "}"}], ",",
     "\n", "  ", 
    RowBox[{"InfraMeasurement", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"InfraMidpoint", "[", " ", 
       RowBox[{"1", ",", " ", "4"}], " ", "]"}], ",", 
      " ", "\"\<VertexDensity\>\""}], " ", "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"285c6d62-5579-42ca-8d9e-0b664e6e9b8f"],

