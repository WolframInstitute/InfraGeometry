Notebook[{

Cell[CellGroupData[{
Cell["InfraMidpoint", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e937a2d1-e85c-49ec-9b2d-5e0e8123cebe"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMidpoint"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMidpoint", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "633cb8fa-4988-4143-baf1-db571e68768b"],
 "\[LineSeparator]",
 "is the midpoint of ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ": the central vertices of the shortest paths from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"a083da69-eb26-4b0e-a015-97cc09fe0c74"],

Cell[TextData[{
 "The midpoint is ",
 StyleBox["M(p, q) = {v \[Element] I(p, q) : max(d(p, v), d(v, q)) = \
\[LeftCeiling]d(p, q)/2\[RightCeiling]}", "TI"],
 ", with ",
 StyleBox["I(p, q)", "TI"],
 " the metric interval of ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"0078a44a-c48c-4811-ba05-4b8aa26d3c3e"],

Cell[TextData[{
 "For even ",
 StyleBox["d(p, q)", "TI"],
 " it is the middle layer of the interval, the vertices with ",
 StyleBox["d(p, v) = d(v, q)", "TI"],
 ". For odd ",
 StyleBox["d(p, q)", "TI"],
 " there is no such vertex, and the midpoint is the two central layers."
}], "Notes",ExpressionUUID->"ab6f0a03-692c-467a-b33d-dac33bd3428f"],

Cell[TextData[{
 "A midpoint is not unique. On the square grid, with ",
 StyleBox["a", "TI"],
 " steps from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " along one axis and ",
 StyleBox["b", "TI"],
 " along the other and ",
 StyleBox["a + b = 2k", "TI"],
 ", the middle layer is a diagonal of the rectangle between them. The number \
of shortest paths through its vertex ",
 StyleBox["i", "TI"],
 " steps along the first axis is ",
 StyleBox["C(k, i) C(k, a \[Minus] i)", "TI"],
 "."
}], "Notes",ExpressionUUID->"9e56df2e-bb49-4174-be83-ccd166c91b1b"],

