Cell[TextData[{
 "A constant map is continuous, but the test reports ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff86684e-c4c6-4f7c-8552-fb78ae7b1781"],
 " whenever ",
 StyleBox["f", "TI"],
 " sends both ends of an edge of ",
 StyleBox["topo1", "TI"],
 " to one vertex. For a constant map it gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6d9d885-514f-4194-b5dd-c9e1ab99d329"],
 " only when ",
 StyleBox["topo1", "TI"],
 " has no edges, as at radius 0."
}], "ExampleText",ExpressionUUID->"68a8e337-d3f4-4aa8-9ad1-9ea7af577ffd"],

