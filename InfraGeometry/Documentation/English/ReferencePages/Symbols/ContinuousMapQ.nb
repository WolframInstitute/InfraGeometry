Cell["\<\
The topology of a binary tree coarsens from radius 1 to radius 2. The \
identity is continuous from the finer to the coarser, not back.\
\>", "ExampleText",ExpressionUUID->"06f67759-9934-4961-92c4-15025e0c5619"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"KaryTree", "[", "31", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fine", " ", "=", " ", 
     RowBox[{"BallTopology", "[", 
      RowBox[{"g", ",", " ", "1"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"coarse", " ", "=", " ", 
     RowBox[{"BallTopology", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"TopologyGraph", "[", 
         RowBox[{"g", ",", " ", "fine"}], "]"}], ",", " ", 
        RowBox[{"TopologyGraph", "[", 
         RowBox[{"g", ",", " ", "coarse"}], "]"}]}], "}"}]}], ",", "\n", 
     "   ", 
     RowBox[{"ContinuousMapQ", "[", 
      RowBox[{"Identity", ",", " ", "fine", ",", " ", "coarse"}], "]"}], ",", 
     " ", 
     RowBox[{"ContinuousMapQ", "[", 
      RowBox[{"Identity", ",", " ", "coarse", ",", " ", "fine"}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c3e05bd2-35d6-4cf9-ac8d-fced7757aa05"],

