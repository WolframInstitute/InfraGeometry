Cell["\<\
Each of the eight symmetries of the square tiling is continuous in the ball \
topology of radius 2.\
\>", "ExampleText",ExpressionUUID->"4e2326e4-79c8-4c00-9e69-af73a3ddfe5d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"topo", " ", "=", " ", 
     RowBox[{"BallTopology", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"symmetries", " ", "=", " ", 
     RowBox[{"FindGraphIsomorphism", "[", 
      RowBox[{"g", ",", " ", "g", ",", " ", "All"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"TopologyGraph", "[", 
      RowBox[{"g", ",", " ", "topo"}], "]"}], ",", " ", 
     RowBox[{"Length", "[", "symmetries", "]"}], ",", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"symmetries", ",", " ", 
       RowBox[{
        RowBox[{"ContinuousMapQ", "[", 
         RowBox[{"#", ",", " ", "topo", ",", " ", "topo"}], "]"}], " ", 
        "&"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d73d62ee-25ef-448e-b131-fced75e3630b"],

