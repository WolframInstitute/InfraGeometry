Cell["\<\
The map may be a function, a list of rules or an association. The reflection \
of a path is continuous; the rotation by two steps is not.\
\>", "ExampleText",ExpressionUUID->"2eab0f41-1b24-4cab-af81-c72d6f4c62b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"PathGraph", "[", 
      RowBox[{"Range", "[", "7", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"topo", " ", "=", " ", 
     RowBox[{"BallTopology", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"TopologyGraph", "[", 
      RowBox[{"g", ",", " ", "topo"}], "]"}], ",", "\n", "   ", 
     RowBox[{"ContinuousMapQ", "[", 
      RowBox[{
       RowBox[{"v", " ", "|->", " ", 
        RowBox[{"8", " ", "-", " ", "v"}]}], ",", " ", "topo", ",", " ", 
       "topo"}], "]"}], ",", "\n", "   ", 
     RowBox[{"ContinuousMapQ", "[", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Range", "[", "7", "]"}], " ", "->", " ", 
         RowBox[{"Reverse", "[", 
          RowBox[{"Range", "[", "7", "]"}], "]"}]}], "]"}], ",", " ", "topo", 
       ",", " ", "topo"}], "]"}], ",", "\n", "   ", 
     RowBox[{"ContinuousMapQ", "[", 
      RowBox[{
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"Range", "[", "7", "]"}], ",", " ", 
         RowBox[{"Reverse", "[", 
          RowBox[{"Range", "[", "7", "]"}], "]"}]}], "]"}], ",", " ", "topo", 
       ",", " ", "topo"}], "]"}], ",", "\n", "   ", 
     RowBox[{"ContinuousMapQ", "[", 
      RowBox[{
       RowBox[{"v", " ", "|->", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"v", " ", "+", " ", "2"}], ",", " ", "7", ",", " ", "1"}], 
         "]"}]}], ",", " ", "topo", ",", " ", "topo"}], "]"}]}], "}"}]}], 
