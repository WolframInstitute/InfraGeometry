Cell["\<\
So the identity of the small grid is continuous from radius 1 to radius 2, \
not back:\
\>", "ExampleText",ExpressionUUID->"f2b89d26-481d-4229-afad-83c6a559077e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"fine", " ", "=", " ", 
      RowBox[{"BallTopology", "[", 
       RowBox[{"g", ",", " ", "1"}], "]"}]}], ",", " ", 
     RowBox[{"coarse", " ", "=", " ", 
      RowBox[{"BallTopology", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ContinuousMapQ", "[", 
      RowBox[{"Identity", ",", " ", "fine", ",", " ", "coarse"}], "]"}], ",", 
     " ", 
     RowBox[{"ContinuousMapQ", "[", 
      RowBox[{"Identity", ",", " ", "coarse", ",", " ", "fine"}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7f6e55e0-26b6-4d6b-a398-324d7c429ad9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"458e043f-0bc0-4227-97f9-49856a09d077"]
}, Open  ]],

Cell["\<\
The small grid has 128 automorphisms: the 8 symmetries of the square, and at \
each of the four corners the swap of its two vertices of degree 1. All are \
continuous at radius 2:\
\>", "ExampleText",ExpressionUUID->"7f2fe86d-6649-4c44-a83b-2ef08834690d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"topo", " ", "=", " ", 
     RowBox[{"BallTopology", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"symmetries", " ", "=", " ", 
     RowBox[{"FindGraphIsomorphism", "[", 
      RowBox[{"g", ",", " ", "g", ",", " ", "All"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "symmetries", "]"}], ",", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"symmetries", ",", " ", 
       RowBox[{
        RowBox[{"ContinuousMapQ", "[", 
         RowBox[{"#", ",", " ", "topo", ",", " ", "topo"}], "]"}], " ", 
        "&"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"7dae50e0-0a3c-467f-b9d1-d68ad70923c1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"128", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"3b23c13c-c58a-4b31-ac95-b6c6c68d194f"]
}, Open  ]]
}, Open  ]],

