 CellID->2123667759,ExpressionUUID->"0e0d5f37-f3c9-4474-a22b-9f10dcc8b438"],

Cell[TextData[{
 "Swapping a vertex ",
 StyleBox["e", "TI"],
 " of degree 1 with its neighbour ",
 StyleBox["n", "TI"],
 " is not continuous at radius 1: the ball of ",
 StyleBox["n", "TI"],
 " contains the ball of ",
 StyleBox["e", "TI"],
 ", not the other way round. Sending ",
 StyleBox["e", "TI"],
 " to ",
 StyleBox["n", "TI"],
 " and fixing the rest is continuous:"
}], "ExampleText",ExpressionUUID->"8e6bb593-9292-44d6-bf4c-199148271546"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"topo", " ", "=", " ", 
     RowBox[{"BallTopology", "[", 
      RowBox[{"g", ",", " ", "1"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"e", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"VertexDegree", "[", 
           RowBox[{"g", ",", " ", "#"}], "]"}], " ", "==", " ", "1"}], " ", 
         "&"}]}], "]"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"n", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"AdjacencyList", "[", 
       RowBox[{"g", ",", " ", "e"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ContinuousMapQ", "[", 
      RowBox[{
       RowBox[{"v", " ", "|->", " ", 
        RowBox[{"Replace", "[", 
         RowBox[{"v", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"e", " ", "->", " ", "n"}], ",", " ", 
            RowBox[{"n", " ", "->", " ", "e"}]}], "}"}]}], "]"}]}], ",", " ", 
       "topo", ",", " ", "topo"}], "]"}], ",", " ", 
     RowBox[{"ContinuousMapQ", "[", 
      RowBox[{
       RowBox[{"v", " ", "|->", " ", 
        RowBox[{"Replace", "[", 
         RowBox[{"v", ",", " ", 
          RowBox[{"e", " ", "->", " ", "n"}]}], "]"}]}], ",", " ", "topo", ",",
        " ", "topo"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cf5fd708-5bfd-49d8-b314-c77a760c0c74"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a93d7de7-956f-473d-bc9a-37dd62b40328"]
}, Open  ]],

Cell["\<\
Every map from the discrete topology of radius 0 is continuous, and so is a \
constant map:\
\>", "ExampleText",ExpressionUUID->"d43d9448-4b17-484d-a806-3e26a37dee87"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"topo", " ", "=", " ", 
     RowBox[{"BallTopology", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"VertexCount", "[", "g", "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ContinuousMapQ", "[", 
      RowBox[{"f", ",", " ", 
       RowBox[{"BallTopology", "[", 
        RowBox[{"g", ",", " ", "0"}], "]"}], ",", " ", "topo"}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"ContinuousMapQ", "[", 
      RowBox[{
       RowBox[{"v", " ", "|->", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", "topo", ",", 
       " ", "topo"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b8548c74-2654-4a06-994c-d2940178edd4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"8035e359-d6a1-43d2-8368-82e03338be8f"]
}, Open  ]]
}, Open  ]],

