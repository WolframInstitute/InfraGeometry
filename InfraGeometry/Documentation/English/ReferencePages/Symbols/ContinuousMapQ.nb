Cell[CellGroupData[{
Cell["ContinuousMapQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e582b1a2-b673-40ee-9bf5-af1946ee25fb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ContinuousMapQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ContinuousMapQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["f", "TI"], ",", " ", 
    StyleBox["topo1", "TI"], ",", " ", 
    StyleBox["topo2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90b249e9-247f-4b23-b3a8-ad2cfa4f1d4a"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a70734b8-a8af-4fc8-a05f-d14ad3f188d0"],
 " if the vertex map ",
 StyleBox["f", "TI"],
 " is continuous from the topology of the digraph ",
 StyleBox["topo1", "TI"],
 " to that of ",
 StyleBox["topo2", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"52c68a84-fcd2-4e80-a365-eda2fdd24461"],

Cell[TextData[{
 "A map between finite topologies is continuous exactly when it keeps the \
specialization preorder: ",
 StyleBox["q \[LessEqual] p", "TI"],
 " implies ",
 StyleBox["f(q) \[LessEqual] f(p)", "TI"],
 ". Equivalently ",
 StyleBox["f(cl(p)) \[SubsetEqual] cl(f(p))", "TI"],
 " for every vertex ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"99ff0078-b641-4836-a337-e8495733e641"],

Cell[TextData[{
 "So each edge ",
 StyleBox["q", "TI"],
 " \[RightArrow] ",
 StyleBox["p", "TI"],
 " of ",
 StyleBox["topo1", "TI"],
 " must go to two equal vertices or to a pair ",
 StyleBox["f(q)", "TI"],
 ", ",
 StyleBox["f(p)", "TI"],
 " joined by a directed path of ",
 StyleBox["topo2", "TI"],
 ". The two topologies may come from different graphs or different radii."
}], "Notes",ExpressionUUID->"898ddcb2-622c-4913-a163-a9c8ea495d65"],

Cell[TextData[{
 "The map ",
 StyleBox["f", "TI"],
 " is an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b3f0047e-f442-41f9-84e6-17801b2e7c26"],
 ", a list of rules or a function."
}], "Notes",ExpressionUUID->"b4d0c313-27d3-47a9-b9ec-2a6318739eb0"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallTopology"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallTopology", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e20a5f23-391e-4303-b8d9-ee971ce8cff5"],
 " every automorphism of the graph is continuous at every radius. The \
identity is continuous from radius ",
 StyleBox["r", "TI"],
 " to every larger radius, since the topology gets coarser. Every map is \
continuous from the discrete topology of radius 0, and every constant map is \
continuous."
}], "Notes",ExpressionUUID->"5d9f88f2-c53e-4f8b-9ced-2e2ab3062ee9"]
}, Open  ]],

