Cell[CellGroupData[{
Cell["ContinuousMapQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"66291ce0-b4c1-477c-9f27-1ca051a5d9cb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ContinuousMapQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ContinuousMapQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["f", "TI"], ",", " ", 
    StyleBox["topo1", "TI"], ",", " ", 
    StyleBox["topo2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41a10a15-f02c-4e5d-ad2a-0819358ab802"],
 "\[LineSeparator]",
 "tests whether the vertex map ",
 StyleBox["f", "TI"],
 " is continuous from the topology of the digraph ",
 StyleBox["topo1", "TI"],
 " to that of ",
 StyleBox["topo2", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"144886d4-cda3-4cb8-8d95-8250cdac5498"],

Cell[TextData[{
 "Definition: a map between finite topologies is continuous exactly when it \
is monotone for the specialization preorders, ",
 StyleBox["q \[LessEqual] p", "TI"],
 " implies ",
 StyleBox["f(q) \[LessEqual] f(p)", "TI"],
 ". Equivalently, ",
 StyleBox["f(cl(p)) \[SubsetEqual] cl(f(p))", "TI"],
 " for every vertex ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"218c696c-0389-4350-a095-d1a802c8d6bf"],

Cell[TextData[{
 "The test runs over the edges of ",
 StyleBox["topo1", "TI"],
 ": each edge ",
 StyleBox["q", "TI"],
 " \[RightArrow] ",
 StyleBox["p", "TI"],
 " must go to a pair ",
 StyleBox["f(q)", "TI"],
 ", ",
 StyleBox["f(p)", "TI"],
 " joined by a directed path of ",
 StyleBox["topo2", "TI"],
 ". The two topologies may come from different graphs or different radii."
}], "Notes",ExpressionUUID->"41333ef0-b9b9-4c20-90c2-5c3ca294c0e7"],

Cell[TextData[{
 StyleBox["f", "TI"],
 " is an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "df2a1d23-0f25-466d-aa93-827fd4c83bea"],
 ", a list of rules, or a function."
}], "Notes",ExpressionUUID->"23a786ba-4bf5-4186-bf29-88262a7edbc9"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallTopology"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallTopology", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5f8f718b-e2fb-4835-93e9-8cb539c1469f"],
 " a graph automorphism is continuous at every radius, and so is its inverse. \
The identity is continuous from radius ",
 StyleBox["r", "TI"],
 " to any larger radius, since the topology coarsens."
}], "Notes",ExpressionUUID->"83e76df1-6f52-45ff-a80c-c1730060996e"]
}, Open  ]],

