Cell["\<\
The map can be a function, a list of rules or an association. The reflection \
of a path is continuous; the rotation of its vertices by two steps is not:\
\>", "ExampleText",ExpressionUUID->"9e3280e9-ba77-4b64-bd0a-ecd706eac84f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"topo", " ", "=", " ", 
     RowBox[{"BallTopology", "[", 
      RowBox[{
       RowBox[{"PathGraph", "[", 
        RowBox[{"Range", "[", "7", "]"}], "]"}], ",", " ", "2"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ContinuousMapQ", "[", 
      RowBox[{
       RowBox[{"v", " ", "|->", " ", 
        RowBox[{"8", " ", "-", " ", "v"}]}], ",", " ", "topo", ",", " ", 
       "topo"}], "]"}], ",", " ", 
     RowBox[{"ContinuousMapQ", "[", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Range", "[", "7", "]"}], " ", "->", " ", 
         RowBox[{"Reverse", " ", "@", " ", 
          RowBox[{"Range", "[", "7", "]"}]}]}], "]"}], ",", " ", "topo", ",", 
       " ", "topo"}], "]"}], ",", "\n", "   ", 
     RowBox[{"ContinuousMapQ", "[", 
      RowBox[{
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"Range", "[", "7", "]"}], ",", " ", 
         RowBox[{"Reverse", " ", "@", " ", 
          RowBox[{"Range", "[", "7", "]"}]}]}], "]"}], ",", " ", "topo", ",", 
       " ", "topo"}], "]"}], ",", "\n", "   ", 
     RowBox[{"ContinuousMapQ", "[", 
      RowBox[{
       RowBox[{"v", " ", "|->", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"v", " ", "+", " ", "2"}], ",", " ", "7", ",", " ", "1"}], 
         "]"}]}], ",", " ", "topo", ",", " ", "topo"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
