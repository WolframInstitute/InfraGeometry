Notebook[{

Cell[CellGroupData[{
Cell["CochainCup", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1170f2e1-834e-4d64-b5f9-4f59f4d811d5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CochainCup"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/CochainCup", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["\[Alpha]", "TR"], ",", " ", 
    StyleBox["\[Beta]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13c5d7ca-e2d3-42fc-b206-fb359d2b0185"],
 "\[LineSeparator]",
 "gives the cup product ",
 StyleBox["\[Alpha] \:222a \[Beta]", "TI"],
 " of the alternating cochains ",
 StyleBox["\[Alpha]", "TI"],
 " and ",
 StyleBox["\[Beta]", "TI"],
 " on the clique complex of ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"a2bebf51-9f7d-4209-82de-26979ec880ce"],

Cell[TextData[{
 "For ",
 StyleBox["\[Alpha]", "TI"],
 " of degree ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["\[Beta]", "TI"],
 " of degree ",
 StyleBox["q", "TI"],
 ", with ",
 StyleBox["n", "TI"],
 " = ",
 StyleBox["p", "TI"],
 " + ",
 StyleBox["q", "TI"],
 ", the cup product is the Alexander\[Dash]Whitney product averaged over the \
orderings of each clique, ",
 StyleBox["(\[Alpha] \:222a \[Beta])(v\:2080, \[Ellipsis], v\:2099) = (1/(n + \
1)!) \[CapitalSigma] sgn(\[Sigma]) \[Alpha](\[Sigma]\:2080, \[Ellipsis], \
\[Sigma]\:209a) \[Beta](\[Sigma]\:209a, \[Ellipsis], \[Sigma]\:2099)", "TI"],
 ", the sum over the orderings ",
 StyleBox["\[Sigma]", "TI"],
 " of ",
 StyleBox["{v\:2080, \[Ellipsis], v\:2099}", "TI"],
 "."
}], "Notes",ExpressionUUID->"fd9c6c0f-dc48-465e-ae6f-59be710be16e"],

Cell["\<\
The product is again alternating and needs no order of the vertices.\
\>", "Notes",ExpressionUUID->"db51b894-730a-4cbc-b658-a9f415ede449"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "227045af-a4dd-4d8e-9086-bef3e709edde"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"59e540c0-e60a-4432-89af-2c621c2784ce"],
     Cell["Statement", "TableText",
     FontWeight->Bold,ExpressionUUID->"6e64dc4e-e749-4696-8c6f-d77b7388e8e7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6a4eda77-3b94-4d72-bc1b-453df99f6698"], Cell[
    "unit", "TableText",ExpressionUUID->
     "ec547121-22ea-452a-8345-3780737efa6c"], Cell[
    "the constant 0-cochain 1", "TableText",ExpressionUUID->
     "29ff36a4-ba80-4959-8f10-501f6cf99f24"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f1045ae4-9632-4e2e-b65b-6cb0d3f1d582"], Cell[
    "graded-commutative", "TableText",ExpressionUUID->
     "5aca4664-b2a6-4068-8817-30338a9558d6"], Cell[TextData[{
     StyleBox["\[Beta] \:222a \[Alpha] = \[Alpha] \:222a \[Beta]", "TI"],
     ", with a minus sign when ",
     StyleBox["p", "TI"],
     " and ",
     StyleBox["q", "TI"],
     " are both odd"
    }], "TableText",ExpressionUUID->"9b270af7-6af2-4c6c-ab76-e01fe39f4f06"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "50209986-355f-4841-84f1-e3636a448b34"], Cell[
    "Leibniz rule", "TableText",ExpressionUUID->
     "c37d7cc8-47e1-4eb8-81fb-16ef479e90dc"], Cell[TextData[StyleBox[
    "\[Delta](\[Alpha] \:222a \[Beta]) = \[Delta]\[Alpha] \:222a \[Beta] + (\
\[Minus]1)\:1d56 \[Alpha] \:222a \[Delta]\[Beta]", "TI"]], "TableText",
     ExpressionUUID->"461e9286-1b90-42e1-bc69-e503d56fe19f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "505f9a8c-a6f7-40ed-aeb3-ee1e82f34496"], Cell[
    "not associative", "TableText",ExpressionUUID->
     "c895cb40-4b64-4a8f-813f-76dd600d1e75"], Cell[TextData[{
     StyleBox[
     "((f \:222a h) \:222a \[Beta] \[Minus] f \:222a (h \:222a \[Beta]))(u, \
v) = (f(v) \[Minus] f(u))(h(v) \[Minus] h(u)) \[Beta](u, v)/4", "TI"],
     " for 0-cochains ",
     StyleBox["f", "TI"],
     ", ",
     StyleBox["h", "TI"]
    }], "TableText",ExpressionUUID->"ea7b833c-9f4b-4752-9614-21202b4869f5"]}
  }]], "2ColumnTableMod",ExpressionUUID->"0066531f-d059-4611-b1df-\
bbccea5f0eb1"],

Cell[TextData[{
 "The cup with a 0-cochain ",
 StyleBox["f", "TI"],
 " multiplies by the mean of ",
 StyleBox["f", "TI"],
 " over each clique. On cohomology the product agrees with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrderedCochainCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cb03e112-91fa-45e1-b447-137ae35746d1"],
 ", the associative Alexander\[Dash]Whitney product."
}], "Notes",ExpressionUUID->"56828d6d-b9ae-4873-a24c-3aa88831b413"],

Cell[TextData[{
 "On the square mesh, ",
 StyleBox["\[Delta]x \:222a \[Delta]y", "TI"],
 " for the coordinates ",
 StyleBox["x", "TI"],
 ", ",
 StyleBox["y", "TI"],
 " is the signed area of each triangle. On the square grid there are no \
triangles, and the cup of two 1-cochains is 0."
}], "Notes",ExpressionUUID->"840493d8-2df6-407c-84b2-2c39ae05005f"]
}, Open  ]],

