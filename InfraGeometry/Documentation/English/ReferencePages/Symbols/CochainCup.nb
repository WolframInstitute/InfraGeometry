Cell[TextData[{
 "On every triangle of the mesh, counterclockwise, ",
 StyleBox["\[Delta]x \:222a \[Delta]y", "TI"],
 " is the area. Its sum is the area of the mesh:"
}], "ExampleText",ExpressionUUID->"487a67ee-55fa-4ca7-8750-e28206bcfc20"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"pos", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"triangles", " ", "=", " ", 
      RowBox[{"FindClique", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", "3", "}"}], ",", " ", "All"}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], "]"}]}], 
     ",", "\n", "   ", 
     RowBox[{"y", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"counterclockwise", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Det", "[", 
           RowBox[{"Differences", "[", 
            RowBox[{"pos", " ", "/@", " ", "#"}], "]"}], "]"}], " ", ">", " ",
           "0"}], ",", " ", "#", ",", " ", 
         RowBox[{"Reverse", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@", 
      " ", "triangles"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"CochainValue", "[", 
         RowBox[{
          RowBox[{"CochainCup", "[", 
           RowBox[{"g", ",", " ", "x", ",", " ", "y"}], "]"}], ",", " ", 
          "#"}], "]"}], " ", "&"}], " ", "/@", " ", "counterclockwise"}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{"Area", " ", "@*", " ", "Polygon", " ", "@*", " ", 
        RowBox[{"Map", "[", "pos", "]"}]}], " ", "/@", " ", "triangles"}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9eff27bd-a778-494c-8c45-0994927243c5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.8210130242748892`", ",", "0.8210130242748892`"}], 
  "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"de3d416e-2562-4177-8a81-2e43539eed6e"]
}, Open  ]]
}, Open  ]],

