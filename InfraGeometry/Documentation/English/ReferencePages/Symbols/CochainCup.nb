Cell[TextData[{
 "The coboundary satisfies the Leibniz rule. For random 1-cochains ",
 StyleBox["\[Alpha]", "TI"],
 ", ",
 StyleBox["\[Beta]", "TI"],
 " on the complete graph on six vertices, ",
 StyleBox["\[Delta](\[Alpha] \:222a \[Beta]) = \[Delta]\[Alpha] \:222a \
\[Beta] \[Minus] \[Alpha] \:222a \[Delta]\[Beta]", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"8a3e8b13-6537-44af-873b-7f9a4dffa499"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CompleteGraph", "[", "6", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"Subsets", "[", 
         RowBox[{
          RowBox[{"Range", "[", "6", "]"}], ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"RandomInteger", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", " ", "15"}], 
           "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}]}], 
     ",", "\n", "   ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"Subsets", "[", 
         RowBox[{
          RowBox[{"Range", "[", "6", "]"}], ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"RandomInteger", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", " ", "15"}], 
           "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Coboundary", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"CochainCup", "[", 
       RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}], "]"}], " ", "==",
     "\n", "    ", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{
      RowBox[{"Merge", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"CochainCup", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Coboundary", "[", 
             RowBox[{"g", ",", " ", "a"}], "]"}], ",", " ", "b"}], "]"}], ",",
           " ", 
          RowBox[{"-", 
           RowBox[{"CochainCup", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", 
             RowBox[{"Coboundary", "[", 
              RowBox[{"g", ",", " ", "b"}], "]"}]}], "]"}]}]}], "}"}], ",", 
        " ", "Total"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"d6827904-8f65-4b94-8491-d686804c406f"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"4b3a903d-0e04-4f8b-b390-d69041d6104a"]
}, Open  ]]
}, Open  ]],

