Cell[TextData[{
 "On the mesh of a square the cup of the coboundaries of the two coordinates \
is the signed area of each triangle, ",
 StyleBox["det(v\:2081 \[Minus] v\:2080, v\:2082 \[Minus] v\:2080)/2", "TI"],
 " on its sorted corners: against it, the cup lies on the diagonal."
}], "ExampleText",ExpressionUUID->"d4988812-9851-42e2-8a07-4a751b6f1c8b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"positions", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"cup", " ", "=", " ", 
     RowBox[{"CochainCup", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"KeyMap", "[", 
          RowBox[{"List", ",", " ", 
           RowBox[{"positions", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], "]"}], ",",
        " ", 
       RowBox[{"Coboundary", "[", 
