Cell[TextData[{
 "The coboundary is a derivation. On the complete graph on six vertices, \
where the cup of two 1-cochains has a coboundary, for random 1-cochains ",
 StyleBox["\[Alpha]", "TI"],
 " and ",
 StyleBox["\[Beta]", "TI"],
 ": ",
 StyleBox["\[Delta](\[Alpha] \:222a \[Beta]) = \[Delta]\[Alpha] \:222a \
\[Beta] \[Minus] \[Alpha] \:222a \[Delta]\[Beta]", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"e4e2a887-3d0c-4b51-9c27-53ecabcd7aa2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CompleteGraph", "[", "6", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"firstCochain", " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"RandomInteger", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], "]"}], " ", "&"}], ",",
           " ", 
          RowBox[{"Subsets", "[", 
           RowBox[{
            RowBox[{"Range", "[", "6", "]"}], ",", " ", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]}], ")"}]}], ",", "\n", 
     "   ", 
     RowBox[{"secondCochain", " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"RandomInteger", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], "]"}], " ", "&"}], ",",
           " ", 
          RowBox[{"Subsets", "[", 
           RowBox[{
            RowBox[{"Range", "[", "6", "]"}], ",", " ", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]}], ")"}]}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"g", ",", " ", 
     RowBox[{
      RowBox[{"KeySort", "[", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"CochainCup", "[", 
          RowBox[{"g", ",", " ", "firstCochain", ",", " ", "secondCochain"}], 
          "]"}]}], "]"}], "]"}], " ", "===", "\n", "    ", 
      RowBox[{"KeySort", "[", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"Merge", "[", 
          RowBox[{
           RowBox[{"{", "\n", "      ", 
            RowBox[{
             RowBox[{"CochainCup", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"Coboundary", "[", 
                RowBox[{"g", ",", " ", "firstCochain"}], "]"}], ",", " ", 
               "secondCochain"}], "]"}], ",", "\n", "      ", 
             RowBox[{"-", 
              RowBox[{"CochainCup", "[", 
               RowBox[{"g", ",", " ", "firstCochain", ",", " ", 
                RowBox[{"Coboundary", "[", 
                 RowBox[{"g", ",", " ", "secondCochain"}], "]"}]}], "]"}]}]}],
             "}"}], ",", " ", "Total"}], "]"}], ",", " ", "0"}], "]"}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"9aeda390-6ee2-430b-a46d-b081490dcd2e"],

