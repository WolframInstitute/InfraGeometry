Cell["\<\
The cup is graded-commutative and unital: the cup of the two coboundaries \
above in the other order is its negative, and the cup with the constant 1 \
changes nothing.\
\>", "ExampleText",ExpressionUUID->"3067ea9b-8dea-46b8-8d98-0e482b0f33f7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"center", " ", "=", " ", 
      RowBox[{"InfraCenter", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"positions", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"apex", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "center", ",", " ", "3"}], "]"}]}], ")"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"fromCenter", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "center", ",", " ", 
             RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
          
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], ",", 
     "\n", "   ", 
     RowBox[{"fromApex", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "apex", ",", " ", 
             RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
          
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"KeyValueMap", "[", "\n", "     ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"triangle", ",", " ", "value"}], "}"}], " ", "|->", " ", 
           RowBox[{"{", "\n", "       ", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"value", " ", 
                 RowBox[{"Det", "[", 
                  RowBox[{"Differences", "[", 
                   RowBox[{"Lookup", "[", 
                    RowBox[{"positions", ",", " ", "triangle"}], "]"}], "]"}],
                   "]"}]}], " ", ">", " ", "0"}], ",", " ", "StandardBlue", ",",
                " ", "StandardRed"}], "]"}], ",", "\n", "       ", 
             RowBox[{"Polygon", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"positions", ",", " ", "triangle"}], "]"}], "]"}]}], 
            "}"}]}], ",", "\n", "     ", 
          RowBox[{"CochainCup", "[", 
           RowBox[{"g", ",", " ", "fromApex", ",", " ", "fromCenter"}], 
           "]"}]}], "]"}], "]"}], ",", " ", "g"}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"KeySort", "[", 
       RowBox[{"CochainCup", "[", 
        RowBox[{"g", ",", " ", "fromApex", ",", " ", "fromCenter"}], "]"}], 
       "]"}], " ", "===", " ", 
      RowBox[{"KeySort", "[", 
       RowBox[{"-", 
        RowBox[{"CochainCup", "[", 
         RowBox[{"g", ",", " ", "fromCenter", ",", " ", "fromApex"}], "]"}]}],
        "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"KeySort", "[", 
       RowBox[{"CochainCup", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"AssociationMap", "[", 
          RowBox[{
           RowBox[{"1", " ", "&"}], ",", " ", 
           RowBox[{"List", " ", "/@", " ", 
            RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}], ",", " ", 
         "fromCenter"}], "]"}], "]"}], " ", "===", " ", 
      RowBox[{"KeySort", "[", "fromCenter", "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"6575badd-e0a3-4c6b-8a9e-57bb93a242e7"],

