Cell[TextData[{
 "The cup with a 0-cochain multiplies by its mean over each edge. For the \
distance ",
 StyleBox["f", "TI"],
 " from the centre of the grid, ",
 StyleBox["f \:222a \[Delta]f = \[Delta](f\.b2/2)", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"dde30ea5-7c90-448b-b8d6-e0554fa71df5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"List", " ", "/@", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{
    RowBox[{"CochainCup", "[", 
     RowBox[{"g", ",", " ", "f", ",", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", "f"}], "]"}]}], "]"}], " ", "==", " ", 
    RowBox[{"Coboundary", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{
       RowBox[{"f", "^", "2"}], " ", "/", " ", "2"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3bf69dcd-3655-4f83-8ddf-de86f2ee17df"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2fe42875-1c1c-423b-9c0d-bda98c20d46f"]
}, Open  ]],

Cell[TextData[{
 "The cup is not associative. For the same ",
 StyleBox["f", "TI"],
 ", ",
 StyleBox["(f \:222a f) \:222a \[Delta]f \[Minus] f \:222a (f \:222a \
\[Delta]f) = (\[Delta]f)\.b3/4", "TI"],
 ", \[PlusMinus]1/4 on every edge:"
}], "ExampleText",ExpressionUUID->"f6fef1aa-7e52-4699-98f8-76c7f1932fb5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"List", " ", "/@", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"df", " ", "=", " ", 
     RowBox[{"Coboundary", "[", 
      RowBox[{"g", ",", " ", "f"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"associator", " ", "=", " ", 
     RowBox[{"Merge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"CochainCup", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"CochainCup", "[", 
            RowBox[{"g", ",", " ", "f", ",", " ", "f"}], "]"}], ",", " ", 
           "df"}], "]"}], ",", " ", 
         RowBox[{"-", 
          RowBox[{"CochainCup", "[", 
           RowBox[{"g", ",", " ", "f", ",", " ", 
            RowBox[{"CochainCup", "[", 
             RowBox[{"g", ",", " ", "f", ",", " ", "df"}], "]"}]}], "]"}]}]}],
         "}"}], ",", "\n", "     ", "Total"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Union", "[", 
      RowBox[{"Values", "[", "associator", "]"}], "]"}], ",", " ", 
     RowBox[{"associator", " ", "==", " ", 
      RowBox[{
       RowBox[{"df", "^", "3"}], " ", "/", " ", "4"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e13f0fd7-5fb9-44bb-a67d-d663227775c2"],

