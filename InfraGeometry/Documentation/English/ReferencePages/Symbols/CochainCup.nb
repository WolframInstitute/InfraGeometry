Cell["\<\
The cup is graded-commutative and has the unit 1. Two 1-cochains on the mesh:\
\
\>", "ExampleText",ExpressionUUID->"38e8729e-d60c-4619-8d6c-c1a841fa428d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], "]"}]}], 
     ",", "\n", "   ", 
     RowBox[{"y", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"one", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"List", " ", "/@", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", "1"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"CochainCup", "[", 
       RowBox[{"g", ",", " ", "y", ",", " ", "x"}], "]"}], " ", "==", " ", 
      RowBox[{"-", 
       RowBox[{"CochainCup", "[", 
        RowBox[{"g", ",", " ", "x", ",", " ", "y"}], "]"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"CochainCup", "[", 
       RowBox[{"g", ",", " ", "one", ",", " ", "x"}], "]"}], " ", "==", " ", 
      "x"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"05890187-fee7-4195-b952-9a46a3a974ff"],

