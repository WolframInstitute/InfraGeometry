Cell["\<\
The cup of the coboundaries of the distances from the centre and from a \
vertex at distance 4, on the square mesh. It is \[PlusMinus]1/2 on 95 of the \
154 triangles: blue where it is positive on the counterclockwise order of the \
corners, red where it is negative, one sign on each side of the line through \
the two vertices:\
\>", "ExampleText",ExpressionUUID->"92add451-0446-41cc-bd10-9b619197f276"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"pos", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"cup", " ", "=", " ", 
     RowBox[{"CochainCup", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"AssociationThread", "[", 
          RowBox[{
           RowBox[{"List", " ", "/@", " ", 
            RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c"}], "]"}]}], "]"}]}], "]"}], ",", "\n", 
       "     ", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"AssociationThread", "[", 
          RowBox[{
           RowBox[{"List", " ", "/@", " ", 
            RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "b"}], "]"}]}], "]"}]}], "]"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{"KeyValueMap", "[", "\n", "      ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "a"}], "}"}], " ", "|->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"a", " ", 
               RowBox[{"Det", "[", 
                RowBox[{"Differences", "[", 
                 RowBox[{"pos", " ", "/@", " ", "t"}], "]"}], "]"}]}], " ", ">",
               " ", "0"}], ",", " ", "StandardBlue", ",", " ", 
             "StandardRed"}], "]"}], ",", " ", 
           RowBox[{"Polygon", "[", 
            RowBox[{"pos", " ", "/@", " ", "t"}], "]"}]}], "}"}]}], ",", " ", 
        "cup"}], "]"}], "]"}], ",", "\n", "    ", 
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "b"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Union", " ", "@", " ", 
         RowBox[{"Values", "[", "cup", "]"}]}], ",", " ", 
        RowBox[{"Length", "[", "cup", "]"}]}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c0faeb23-d265-41ec-992d-5aefe12ea4b3"],

