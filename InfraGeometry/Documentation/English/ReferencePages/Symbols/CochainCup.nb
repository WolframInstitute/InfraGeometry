Cell[TextData[{
 "The cup with a 0-cochain multiplies by its mean over each edge. For the \
distance ",
 StyleBox["f", "TI"],
 " from the centre, ",
 StyleBox["f \:222a \[Delta]f = \[Delta](f\.b2/2)", "TI"],
 ", drawn by an arc along each edge in the direction in which it is positive: \
",
 StyleBox["(f(u) + f(v))/2", "TI"],
 " times ",
 StyleBox["f(v) \[Minus] f(u)", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"f597f7f3-a7ef-4dcc-a7a4-7df31f56a743"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"values", " ", "=", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", 
          RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
       RowBox[{"List", " ", "/@", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"product", " ", "=", " ", 
     RowBox[{"CochainCup", "[", 
      RowBox[{"g", ",", " ", "values", ",", " ", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", "values"}], "]"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"GroupBy", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Keys", " ", "@", " ", 
            RowBox[{"Select", "[", 
             RowBox[{"product", ",", " ", "Positive"}], "]"}]}], ",", " ", 
           RowBox[{"Reverse", " ", "/@", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"Select", "[", 
              RowBox[{"product", ",", " ", "Negative"}], "]"}]}]}]}], "]"}], ",",
          " ", 
         RowBox[{"First", " ", "->", " ", "Last"}]}], "]"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"KeySort", "[", "product", "]"}], " ", "===", " ", 
      RowBox[{"KeySort", "[", 
       RowBox[{"Coboundary", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{
          RowBox[{"values", "^", "2"}], " ", "/", " ", "2"}]}], "]"}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fb6dcf74-4596-4fde-80ea-8a9f0604ab29"],

