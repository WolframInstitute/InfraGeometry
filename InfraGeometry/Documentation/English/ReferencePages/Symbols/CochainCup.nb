Cell[TextData[{
 "The cup with a 0-cochain multiplies by its mean over each edge. For the \
distance ",
 StyleBox["f", "TI"],
 " from the centre of the grid, ",
 StyleBox["f \:222a \[Delta]f = \[Delta](f\.b2/2)", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"6a6089b7-12a9-4f49-a511-6499b0c59859"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"List", " ", "/@", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{
    RowBox[{"CochainCup", "[", 
     RowBox[{"g", ",", " ", "f", ",", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", "f"}], "]"}]}], "]"}], " ", "==", " ", 
    RowBox[{"Coboundary", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{
       RowBox[{"f", "^", "2"}], " ", "/", " ", "2"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"be21cb8e-9cbb-4424-a626-06c196d59977"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"55660807-b775-4bcc-a625-f43f2b0f2c7b"]
}, Open  ]],

Cell[TextData[{
 "The cup is not associative. For the same ",
 StyleBox["f", "TI"],
 ", ",
 StyleBox["(f \:222a f) \:222a \[Delta]f \[Minus] f \:222a (f \:222a \
\[Delta]f) = (\[Delta]f)\.b3/4", "TI"],
 ", \[PlusMinus]1/4 on every edge:"
}], "ExampleText",ExpressionUUID->"f4e49d24-6c8d-4cb0-9fdf-a63dbd700341"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"List", " ", "/@", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"df", " ", "=", " ", 
     RowBox[{"Coboundary", "[", 
      RowBox[{"g", ",", " ", "f"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"associator", " ", "=", " ", 
     RowBox[{"Merge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"CochainCup", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"CochainCup", "[", 
            RowBox[{"g", ",", " ", "f", ",", " ", "f"}], "]"}], ",", " ", 
           "df"}], "]"}], ",", " ", 
         RowBox[{"-", 
          RowBox[{"CochainCup", "[", 
           RowBox[{"g", ",", " ", "f", ",", " ", 
            RowBox[{"CochainCup", "[", 
             RowBox[{"g", ",", " ", "f", ",", " ", "df"}], "]"}]}], "]"}]}]}],
         "}"}], ",", "\n", "     ", "Total"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Union", "[", 
      RowBox[{"Values", "[", "associator", "]"}], "]"}], ",", " ", 
     RowBox[{"associator", " ", "==", " ", 
      RowBox[{
       RowBox[{"df", "^", "3"}], " ", "/", " ", "4"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"846d9fa1-c759-4b0c-af2e-0f8eb2efcee1"],

