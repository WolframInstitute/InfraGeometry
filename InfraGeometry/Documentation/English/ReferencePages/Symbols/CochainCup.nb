Cell[TextData[{
 "The coboundary satisfies the Leibniz rule. For random 1-cochains ",
 StyleBox["\[Alpha]", "TI"],
 ", ",
 StyleBox["\[Beta]", "TI"],
 " on the complete graph on six vertices, ",
 StyleBox["\[Delta](\[Alpha] \:222a \[Beta]) = \[Delta]\[Alpha] \:222a \
\[Beta] \[Minus] \[Alpha] \:222a \[Delta]\[Beta]", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"4c2e9791-c1d1-479c-8874-b495dc74cb21"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CompleteGraph", "[", "6", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"Subsets", "[", 
         RowBox[{
          RowBox[{"Range", "[", "6", "]"}], ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"RandomInteger", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", " ", "15"}], 
           "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}]}], 
     ",", "\n", "   ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"Subsets", "[", 
         RowBox[{
          RowBox[{"Range", "[", "6", "]"}], ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"RandomInteger", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", " ", "15"}], 
           "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Coboundary", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"CochainCup", "[", 
       RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}], "]"}], " ", "==",
     "\n", "    ", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{
      RowBox[{"Merge", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"CochainCup", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"Coboundary", "[", 
             RowBox[{"g", ",", " ", "a"}], "]"}], ",", " ", "b"}], "]"}], ",",
           " ", 
          RowBox[{"-", 
           RowBox[{"CochainCup", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", 
             RowBox[{"Coboundary", "[", 
              RowBox[{"g", ",", " ", "b"}], "]"}]}], "]"}]}]}], "}"}], ",", 
        " ", "Total"}], "]"}], ",", " ", "0"}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"70611b53-6149-4dfe-8ac4-a302fb747751"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"fcf7d12c-7a9a-43c6-9aab-b09a467590f5"]
}, Open  ]]
}, Open  ]],

