Notebook[{

Cell[CellGroupData[{
Cell["CochainCup", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"11a4556b-00e4-44ad-8d46-fe56f42cb8ae"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CochainCup"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/CochainCup", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["\[Alpha]", "TR"], ",", " ", 
    StyleBox["\[Beta]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dedeef88-34b0-4c97-84aa-ee4af800d45f"],
 "\[LineSeparator]",
 "gives the cup product ",
 StyleBox["\[Alpha] \:222a \[Beta]", "TI"],
 " of the alternating cochains ",
 StyleBox["\[Alpha]", "TI"],
 " and ",
 StyleBox["\[Beta]", "TI"],
 " on the clique complex of ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"63c6fbd4-08ec-4f34-a456-9c4a8cf9effe"],

Cell[TextData[{
 "For ",
 StyleBox["\[Alpha]", "TI"],
 " of degree ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["\[Beta]", "TI"],
 " of degree ",
 StyleBox["q", "TI"],
 ", with ",
 StyleBox["n", "TI"],
 " = ",
 StyleBox["p", "TI"],
 " + ",
 StyleBox["q", "TI"],
 ", the cup product is the Alexander\[Dash]Whitney product averaged over the \
orderings of each clique, ",
 StyleBox["(\[Alpha] \:222a \[Beta])(v\:2080, \[Ellipsis], v\:2099) = (1/(n + \
1)!) \[CapitalSigma] sgn(\[Sigma]) \[Alpha](\[Sigma]\:2080, \[Ellipsis], \
\[Sigma]\:209a) \[Beta](\[Sigma]\:209a, \[Ellipsis], \[Sigma]\:2099)", "TI"],
 ", the sum over the orderings ",
 StyleBox["\[Sigma]", "TI"],
 " of ",
 StyleBox["{v\:2080, \[Ellipsis], v\:2099}", "TI"],
 "."
}], "Notes",ExpressionUUID->"0f6260d6-ba4b-4096-9ece-00a062c179a3"],

Cell["\<\
The product is again alternating and needs no order of the vertices.\
\>", "Notes",ExpressionUUID->"fd4b39d2-568c-43fe-a456-30103968f1c3"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f260b90a-e059-4b63-b0ea-4f377bacf45f"], Cell["Property", "TableText",
     FontWeight->Bold,ExpressionUUID->"9dc0700f-6203-43d9-ae23-e4474689b7c8"],
     Cell["Statement", "TableText",
     FontWeight->Bold,ExpressionUUID->"89a474a8-4adf-4ebd-a2e3-eda671082f3a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d545d941-1eb7-4fe7-8a38-75a5a49291e5"], Cell[
    "unit", "TableText",ExpressionUUID->
     "98e274b1-faab-4bec-9aaa-00333f1c47ef"], Cell[
    "the constant 0-cochain 1", "TableText",ExpressionUUID->
     "340a9c63-1d5c-450c-bb41-2e8af08700dc"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2bb3f3df-4cae-4d84-a3ca-ab7c846bdda6"], Cell[
    "graded-commutative", "TableText",ExpressionUUID->
     "97fb8e22-f0ed-4683-909e-d46ff2f7e2a0"], Cell[TextData[{
     StyleBox["\[Beta] \:222a \[Alpha] = \[Alpha] \:222a \[Beta]", "TI"],
     ", with a minus sign when ",
     StyleBox["p", "TI"],
     " and ",
     StyleBox["q", "TI"],
     " are both odd"
    }], "TableText",ExpressionUUID->"89876b98-8901-4f50-afee-492d90d694eb"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "dd63aaef-48bd-440d-ac80-003b2e4ef240"], Cell[
    "Leibniz rule", "TableText",ExpressionUUID->
     "8226e3f0-be2f-425a-b636-fd775258695a"], Cell[TextData[StyleBox[
    "\[Delta](\[Alpha] \:222a \[Beta]) = \[Delta]\[Alpha] \:222a \[Beta] + (\
\[Minus]1)\:1d56 \[Alpha] \:222a \[Delta]\[Beta]", "TI"]], "TableText",
     ExpressionUUID->"5ce3119c-9622-45b0-b36d-2182f5a31e81"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "76e3a257-394c-4b0c-a90b-5e4412eb845d"], Cell[
    "not associative", "TableText",ExpressionUUID->
     "5da7765a-aa9e-444c-b1f4-e552e50a190e"], Cell[TextData[{
     StyleBox[
     "((f \:222a h) \:222a \[Beta] \[Minus] f \:222a (h \:222a \[Beta]))(u, \
v) = (f(v) \[Minus] f(u))(h(v) \[Minus] h(u)) \[Beta](u, v)/4", "TI"],
     " for 0-cochains ",
     StyleBox["f", "TI"],
     ", ",
     StyleBox["h", "TI"]
    }], "TableText",ExpressionUUID->"cf86b28b-7b66-47da-86f0-875ad10b3715"]}
  }]], "2ColumnTableMod",ExpressionUUID->"d9e4f5f6-e6e0-45fc-aeb1-\
2faa489ca5e1"],

Cell[TextData[{
 "The cup with a 0-cochain ",
 StyleBox["f", "TI"],
 " multiplies by the mean of ",
 StyleBox["f", "TI"],
 " over each clique. On cohomology the product agrees with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrderedCochainCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a8a78e95-e017-4eee-80dc-7fcf9489c018"],
 ", the associative Alexander\[Dash]Whitney product."
}], "Notes",ExpressionUUID->"1fb4b65b-7b8b-4199-a815-076642d57223"],

Cell[TextData[{
 "On the square mesh, ",
 StyleBox["\[Delta]x \:222a \[Delta]y", "TI"],
 " for the coordinates ",
 StyleBox["x", "TI"],
 ", ",
 StyleBox["y", "TI"],
 " is the signed area of each triangle. On the square grid there are no \
triangles, and the cup of two 1-cochains is 0."
}], "Notes",ExpressionUUID->"4ce71a83-c726-4b3d-97b9-22d84333f697"]
}, Open  ]],

