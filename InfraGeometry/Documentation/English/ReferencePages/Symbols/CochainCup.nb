Notebook[{

Cell[CellGroupData[{
Cell["CochainCup", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ed969f9f-f041-4faa-84b1-399bb5a616e3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CochainCup"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/CochainCup", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["\[Alpha]", "TR"], ",", " ", 
    StyleBox["\[Beta]", "TR"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69561cd5-f6f0-4777-9d76-29eca1eb7f28"],
 "\[LineSeparator]",
 "gives the cup product ",
 StyleBox["\[Alpha] \:222a \[Beta]", "TI"],
 " of the alternating cochains ",
 StyleBox["\[Alpha]", "TI"],
 " and ",
 StyleBox["\[Beta]", "TI"],
 ": the Alexander\[Dash]Whitney product averaged with signs over all \
orderings of each clique of ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"0c2ba857-eca6-45f9-8cee-8341380fda80"],

Cell[TextData[{
 "Definition: for ",
 StyleBox["\[Alpha]", "TI"],
 " of degree ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["\[Beta]", "TI"],
 " of degree ",
 StyleBox["q", "TI"],
 ", with ",
 StyleBox["n", "TI"],
 " = ",
 StyleBox["p", "TI"],
 " + ",
 StyleBox["q", "TI"],
 ", ",
 StyleBox["(\[Alpha] \:222a \[Beta])(v\:2080, \[Ellipsis], v\:2099) = (1/(n + \
1)!) \[CapitalSigma] sgn(\[Sigma]) \[Alpha](\[Sigma]\:2080, \[Ellipsis], \
\[Sigma]\:209a) \[Beta](\[Sigma]\:209a, \[Ellipsis], \[Sigma]\:2099)", "TI"],
 ", the sum over the orderings ",
 StyleBox["\[Sigma]", "TI"],
 " = ",
 StyleBox["(\[Sigma]\:2080, \[Ellipsis], \[Sigma]\:2099)", "TI"],
 " of the clique ",
 StyleBox["{v\:2080, \[Ellipsis], v\:2099}", "TI"],
 ", ",
 StyleBox["sgn(\[Sigma])", "TI"],
 " the sign of the ordering. The front face ends where the back face begins."
}], "Notes",ExpressionUUID->"e9f12af7-e59e-4080-be5f-7ecc27de53c2"],

Cell[TextData[{
 "It needs no order of the vertices: ",
 StyleBox["\[Alpha] \:222a \[Beta]", "TI"],
 " is again alternating."
}], "Notes",ExpressionUUID->"cd4b4fc8-dcd2-412f-8ec5-ba9003079b45"],

Cell[TextData[{
 "The constant 0-cochain 1 is a unit. The product is graded-commutative, ",
 StyleBox["\[Beta] \:222a \[Alpha] = (\[Minus]1)^(pq) \[Alpha] \:222a \
\[Beta]", "TI"],
 ", by reversing each ordering, and the coboundary is a derivation, ",
 StyleBox["\[Delta](\[Alpha] \:222a \[Beta]) = \[Delta]\[Alpha] \:222a \
\[Beta] + (\[Minus]1)^p \[Alpha] \:222a \[Delta]\[Beta]", "TI"],
 "."
}], "Notes",ExpressionUUID->"e2f57f7e-3404-4ab5-b7a9-f667d3b6cc05"],

Cell[TextData[{
 "It is not associative. The cup with a 0-cochain ",
 StyleBox["f", "TI"],
 " multiplies by the mean of ",
 StyleBox["f", "TI"],
 " over the clique, and the mean of a product is not the product of the \
means: in degrees 0, 0 and 1, ",
 StyleBox["((f \:222a g) \:222a \[Beta] \[Minus] f \:222a (g \:222a \
\[Beta]))(u, v) = (f(v) \[Minus] f(u))(g(v) \[Minus] g(u)) \[Beta](u, v)/4", 
  "TI"],
 " on every edge."
}], "Notes",ExpressionUUID->"00062654-931b-42ea-a79c-0c3f31524e83"],

Cell[TextData[{
 "The normalisation 1/(",
 StyleBox["n", "TI"],
 " + 1)! is the one under which the cup of two cocycles is cohomologous to \
their ordered cup, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrderedCochainCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c8c4c015-aec0-4ba6-b564-64a4107538f4"],
 ": with twice the cup the class changes, as on a triangulated torus. For the \
associative product use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrderedCochainCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0205d9b3-b769-4d86-97ae-cb98c2da41ed"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["AntisymmetrizedCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/AntisymmetrizedCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7de599c1-7a34-4916-8d48-5157d66f133b"],
 " is the same function."
}], "Notes",ExpressionUUID->"63555928-9abf-42c4-b4cd-205ff8afd521"]
}, Open  ]],

