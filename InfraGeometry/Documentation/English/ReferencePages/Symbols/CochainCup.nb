Cell[TextData[{
 "The cup is not associative. For the distance ",
 StyleBox["f", "TI"],
 " from the centre, ",
 StyleBox["(f \:222a f) \:222a \[Delta]f \[Minus] f \:222a (f \:222a \
\[Delta]f)", "TI"],
 " is ",
 StyleBox["(\[Delta]f)\.b3/4", "TI"],
 ", \[PlusMinus]1/4 on every edge between two shells."
}], "ExampleText",ExpressionUUID->"1e4576dd-86ce-4497-b779-5c226276b810"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"values", " ", "=", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", 
          RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
       RowBox[{"List", " ", "/@", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"associator", " ", "=", " ", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{"Merge", "[", 
        RowBox[{
         RowBox[{"{", "\n", "      ", 
          RowBox[{
           RowBox[{"CochainCup", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"CochainCup", "[", 
              RowBox[{"g", ",", " ", "values", ",", " ", "values"}], "]"}], ",",
              " ", 
             RowBox[{"Coboundary", "[", 
              RowBox[{"g", ",", " ", "values"}], "]"}]}], "]"}], ",", "\n", 
           "      ", 
           RowBox[{"-", 
            RowBox[{"CochainCup", "[", 
             RowBox[{"g", ",", " ", "values", ",", " ", 
              RowBox[{"CochainCup", "[", 
               RowBox[{"g", ",", " ", "values", ",", " ", 
                RowBox[{"Coboundary", "[", 
                 RowBox[{"g", ",", " ", "values"}], "]"}]}], "]"}]}], 
             "]"}]}]}], "}"}], ",", " ", "Total"}], "]"}], ",", " ", "0"}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"GroupBy", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Keys", " ", "@", " ", 
            RowBox[{"Select", "[", 
             RowBox[{"associator", ",", " ", "Positive"}], "]"}]}], ",", " ", 
           
           RowBox[{"Reverse", " ", "/@", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"Select", "[", 
              RowBox[{"associator", ",", " ", "Negative"}], "]"}]}]}]}], 
          "]"}], ",", " ", 
         RowBox[{"First", " ", "->", " ", "Last"}]}], "]"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"Union", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"Values", "[", "associator", "]"}], "]"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"KeySort", "[", "associator", "]"}], " ", "===", " ", 
      RowBox[{"KeySort", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Coboundary", "[", 
          RowBox[{"g", ",", " ", "values"}], "]"}], "^", "3"}], " ", "/", " ",
         "4"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ffcb1d2f-6f62-451b-aba7-d1330200d396"],

