     StyleBox["k", "TI"]
    }], "TableText",ExpressionUUID->"5b180899-c9da-469e-b4e3-2d5838c3fe92"]}
  }]], "3ColumnTableMod",ExpressionUUID->"0e8dbc40-71a9-49fd-a191-\
11818b3bd0af"]
}, Open  ]],

