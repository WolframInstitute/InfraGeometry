Cell["\<\
The comparison angle at the centre between a fixed vertex of the circle of \
radius 3 and each vertex of that circle, drawn as the size of the vertex:\
\>", "ExampleText",ExpressionUUID->"26a87253-41ea-4eec-8fa1-e88abe4d51fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"p", ",", " ", "3"}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"circle", " ", "=", " ", 
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"p", ",", " ", "3"}], "]"}], ",", 
           " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"AssociationMap", "[", 
           RowBox[{
            RowBox[{"v", " ", "|->", " ", 
             RowBox[{"N", " ", "@", " ", 
              RowBox[{"InfraComparisonAngle", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"q", ",", " ", "p", ",", " ", "v"}], "}"}]}], 
               "]"}]}]}], ",", " ", "circle"}], "]"}], ",", " ", "q", ",", 
          " ", "p"}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"3d1fd07a-3b41-4b04-8d5f-bfc4dace2323"],

