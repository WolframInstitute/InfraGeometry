Notebook[{

Cell[CellGroupData[{
Cell["InfraComparisonAngle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3babeb0d-15bf-410c-871a-2a73dcc93ab0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraComparisonAngle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraComparisonAngle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["q1", "TI"], ",", " ", 
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06a96283-5b0c-4eba-961b-67ba54d292e0"],
 "\[LineSeparator]",
 "gives the angle at ",
 StyleBox["p", "TI"],
 " of the Euclidean triangle whose sides are the graph distances between ",
 StyleBox["q1", "TI"],
 ", ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q2", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"5e6cc971-97d8-417d-8ee8-8b3faab9d65f"],

Cell[TextData[{
 "With ",
 StyleBox["a = d(q1, q2)", "TI"],
 ", ",
 StyleBox["b = d(p, q1)", "TI"],
 " and ",
 StyleBox["c = d(p, q2)", "TI"],
 ", the angle is ",
 StyleBox["\[Theta] = arccos((b\.b2 + c\.b2 \[Minus] a\.b2) / (2bc))", "TI"],
 ", in radians."
}], "Notes",ExpressionUUID->"15dde9e3-330e-4791-b12f-795e7f61148b"],

Cell["\<\
This is the Alexandrov comparison angle. It uses the three distances only and \
needs no tangent space.\
\>", "Notes",ExpressionUUID->"d7282640-a5c5-4a6d-b259-e41ffce47bed"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "k"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c98b3f93-8b29-45f3-aa3d-d54ea216c9a0"],
 " takes the triangle in the model plane of constant curvature ",
 StyleBox["k", "TI"],
 ": the spherical law of cosines for ",
 StyleBox["k", "TI"],
 " > 0, the hyperbolic one for ",
 StyleBox["k", "TI"],
 " < 0. For the same three sides a larger ",
 StyleBox["k", "TI"],
 " gives a larger angle."
}], "Notes",ExpressionUUID->"489671bb-eec5-4f73-8e02-eec36f8945d0"],

Cell[TextData[{
 "On the square grid the distance is the \[ScriptL]\.b9 distance. Two \
vertices on the two axes at distance ",
 StyleBox["r", "TI"],
 " from ",
 StyleBox["p", "TI"],
 " are ",
 StyleBox["2r", "TI"],
 " apart, so their comparison angle at ",
 StyleBox["p", "TI"],
 " is \[Pi], not \[Pi]/2."
}], "Notes",ExpressionUUID->"aa5d2276-f345-471c-8c03-f19eb9a4af42"],

Cell[TextData[{
 "Both arms must have positive length. For ",
 StyleBox["k", "TI"],
 " > 0 the triangle exists only when its perimeter is at most ",
 StyleBox["2\[Pi]/\[Sqrt]k", "TI"],
 "."
}], "Notes",ExpressionUUID->"3e55e828-86cf-49d7-beb4-b183e16b6cf3"],

