Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Properties & Relations", "ExampleSection",ExpressionUUID->
   "d18b1e1f-4c4c-49a5-bb54-1e5e145ddf4e"],
  $Line = 0; Null]], "ExampleSection",
 CellID->2123667759,ExpressionUUID->"0e0d5f37-f3c9-4474-a22b-9f10dcc8b438"],

Cell[TextData[{
 "The angle and the scalar product carry the same information: ",
 StyleBox["\:27e8u, v\:27e9\:209a = d(p, u) d(p, v) cos \[Theta]", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"68c95612-6f5f-421b-a161-4ff91f4885d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"u", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"p", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"p", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{"InfraScalarProduct", "[", 
     RowBox[{"g", ",", " ", "p", ",", " ", "u", ",", " ", "v"}], "]"}], " ", "==",
     " ", 
    RowBox[{"3", " ", "*", " ", "4", " ", "*", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"InfraComparisonAngle", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"u", ",", " ", "p", ",", " ", "v"}], "}"}]}], "]"}], 
      "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b34b5b0f-0a82-4379-979e-87725a094317"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e4afff9a-3b6b-489b-befc-256e64329d1d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Possible Issues", "ExampleSection",ExpressionUUID->
   "dda06a82-eb41-4b48-8510-6cb821647761"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell["\<\
A triangle too large for the spherical model has no comparison triangle, and \
the angle is complex. Three vertices of the 9-cycle, pairwise 3 apart, at \
curvature 1:\
\>", "ExampleText",ExpressionUUID->"3ea87c97-4816-41ac-b5af-179ca3de7f35"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", " ", "@", " ", 
  RowBox[{"InfraComparisonAngle", "[", 
   RowBox[{
    RowBox[{"CycleGraph", "[", "9", "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"4", ",", " ", "1", ",", " ", "7"}], "}"}], ",", " ", 
    RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "1"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"950f9317-51e8-445c-8485-8bc1dca08c73"],

Cell[BoxData[
 RowBox[{"3.141592653589793`", "\[VeryThinSpace]", "-", 
  RowBox[{"5.287483845622592`", " ", "\[ImaginaryI]"}]}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c61269cf-9de6-4749-9d30-b082b1ab1edd"]
}, Open  ]]
}, Open  ]],

