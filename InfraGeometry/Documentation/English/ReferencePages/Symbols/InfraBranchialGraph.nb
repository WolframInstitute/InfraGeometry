Cell["The two first-construction states share the root.", "ExampleText",ExpressionUUID->"ef8fa56c-c00f-432f-a0a6-c84e56ba0e3d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"PathGraph", "[", " ", 
       RowBox[{"Range", "[", " ", "3", " ", "]"}], " ", "]"}]}], " ", "}"}], ",",
     "\n", "  ", 
    RowBox[{"{", " ", 
     RowBox[{"scene", " ", "=", " ", 
      RowBox[{"InfraScene", "[", " ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{"p", ",", " ", "q"}], " ", "}"}], ",", " ", 
        RowBox[{"{", " ", 
         RowBox[{"InfraStep", "[", " ", 
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"p", " ", "==", " ", 
             RowBox[{"InfraMidpoint", "[", " ", 
              RowBox[{"1", ",", " ", "3"}], " ", "]"}]}], ",", " ", 
            RowBox[{"q", " ", "==", " ", 
             RowBox[{"InfraMidpoint", "[", " ", 
              RowBox[{"1", ",", " ", "1"}], " ", "]"}]}]}], " ", "}"}], " ", 
          "]"}], " ", "}"}]}], " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
    RowBox[{"{", " ", 
     RowBox[{"data", " ", "=", " ", 
      RowBox[{"InfraSceneMultiway", "[", " ", 
       RowBox[{"scene", ",", " ", "graph"}], " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{
     RowBox[{"InfraBranchialGraph", "[", " ", 
      RowBox[{"data", ",", " ", "1"}], " ", "]"}], "[", " ", "\"\<Graph\>\"", 
     " ", "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"89234667-936c-44b4-92a0-e54d68b42de9"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{2, 3}, {Null, {{1, 2}}}]]}, 
    TagBox[GraphicsGroupBox[GraphicsComplexBox[{{1., 0.}, {-1., 0.}}, {
        {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], 
