            RowBox[{"InfraPoint", "[", 
             RowBox[{"InfraShell", "[", 
              RowBox[{"a", ",", " ", "1"}], "]"}], "]"}]}], "}"}], "]"}], ",",
          " ", 
         RowBox[{"InfraSceneStep", "[", 
          RowBox[{"{", 
           RowBox[{"q", " ", "==", " ", 
            RowBox[{"InfraPoint", "[", 
             RowBox[{"InfraShell", "[", 
              RowBox[{"p", ",", " ", "1"}], "]"}], "]"}]}], "}"}], "]"}]}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"branchial", " ", "=", " ", 
