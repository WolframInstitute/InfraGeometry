Cell[TextData[{
 "Each edge has one witness at depth 2, the state after the choice of ",
 StyleBox["p", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"51857e04-54bb-4776-b052-449586ec4524"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "q"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraSceneStep", "[", 
          RowBox[{"{", 
           RowBox[{"p", " ", "==", " ", 
            RowBox[{"InfraPoint", "[", 
             RowBox[{"InfraShell", "[", 
              RowBox[{"a", ",", " ", "1"}], "]"}], "]"}]}], "}"}], "]"}], ",",
          " ", 
         RowBox[{"InfraSceneStep", "[", 
          RowBox[{"{", 
           RowBox[{"q", " ", "==", " ", 
            RowBox[{"InfraPoint", "[", 
             RowBox[{"InfraShell", "[", 
              RowBox[{"p", ",", " ", "1"}], "]"}], "]"}]}], "}"}], "]"}]}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"branchial", " ", "=", " ", 
     RowBox[{"InfraBranchialGraph", "[", 
      RowBox[{
       RowBox[{"InfraSceneMultiway", "[", 
        RowBox[{"scene", ",", " ", "g"}], "]"}], ",", " ", "2"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"EdgeCount", "[", 
      RowBox[{"branchial", "[", "\"\<Graph\>\"", "]"}], "]"}], ",", " ", 
     RowBox[{"Union", "[", 
      RowBox[{"Length", " ", "/@", " ", 
       RowBox[{"Values", "[", 
        RowBox[{"branchial", "[", "\"\<Witnesses\>\"", "]"}], "]"}]}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7f85b4b9-4fbf-4a2e-8478-3e61e9dd8368"],

Cell[BoxData[
 RowBox[{"{", 
