Cell["The two first-construction states share the root.", "ExampleText",ExpressionUUID->"4fb6cdd7-7e85-4b57-8280-42a67998faf3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"PathGraph", "[", " ", 
       RowBox[{"Range", "[", " ", "3", " ", "]"}], " ", "]"}]}], " ", "}"}], ",",
     "\n", "  ", 
    RowBox[{"{", " ", 
     RowBox[{"scene", " ", "=", " ", 
      RowBox[{"InfraScene", "[", " ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{"p", ",", " ", "q"}], " ", "}"}], ",", " ", 
        RowBox[{"{", " ", 
         RowBox[{"InfraSceneStep", "[", " ", 
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"p", " ", "==", " ", 
             RowBox[{"InfraMidpoint", "[", " ", 
              RowBox[{"1", ",", " ", "3"}], " ", "]"}]}], ",", " ", 
            RowBox[{"q", " ", "==", " ", 
             RowBox[{"InfraMidpoint", "[", " ", 
              RowBox[{"1", ",", " ", "1"}], " ", "]"}]}]}], " ", "}"}], " ", 
          "]"}], " ", "}"}]}], " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
    RowBox[{"{", " ", 
     RowBox[{"data", " ", "=", " ", 
      RowBox[{"InfraSceneMultiway", "[", " ", 
       RowBox[{"scene", ",", " ", "graph"}], " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{
     RowBox[{"InfraBranchialGraph", "[", " ", 
      RowBox[{"data", ",", " ", "1"}], " ", "]"}], "[", " ", "\"\<Graph\>\"", 
     " ", "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"af48b207-890c-4d57-80d4-fd38e4c0a1f1"],

