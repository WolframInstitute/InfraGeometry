Notebook[{

Cell[CellGroupData[{
Cell["InfraBranchialGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9c7a8a4e-ca6d-4117-a9ef-5c14091d9b0b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBranchialGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBranchialGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["depth", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f610f143-6463-43b2-9b77-41994214d79a"],
 "\[LineSeparator]",
 "gives the observed immediate-parent branchial relation at an event depth.",
 "\n"
}], "Usage",ExpressionUUID->"9650bf22-8220-48e6-8cca-4b29408f4fac"],

Cell["\<\
The input is a saved InfraSceneMultiway Association and a nonnegative event \
depth. The result contains \"Graph\", \"Witnesses\", \"Complete\" and \
\"Frontier\". Vertices are observed states at that depth, including isolated \
states. Two distinct states are adjacent when accepted or fixed incoming \
events share an immediate predecessor. Witnesses retain every common \
immediate parent. A distant common ancestor alone creates no edge. \
Completeness and frontier come from the saved exploration; missing edges in \
an incomplete layer do not prove nonadjacency. The function reads saved data \
without sampling or continuing exploration.\
\>", "Notes",ExpressionUUID->"a9b06a13-24e9-4719-9543-9801a419895a"]
}, Open  ]],

