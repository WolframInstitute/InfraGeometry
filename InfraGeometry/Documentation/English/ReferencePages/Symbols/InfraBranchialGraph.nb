Cell[TextData[{
 "The vertices are the states at depth ",
 StyleBox["d", "TI"],
 ". Two states are joined when they have a common immediate parent: a state \
one step earlier from which an accepted event leads to each. A common \
ancestor further back gives no edge."
}], "Notes",ExpressionUUID->"b1fec1d9-665c-4643-9e73-f5ab1b7eafc5"],

Cell["The result is an association:", "Notes",ExpressionUUID->"de5a4ddb-92e7-4251-b4fb-7ff6e7b30489"],

