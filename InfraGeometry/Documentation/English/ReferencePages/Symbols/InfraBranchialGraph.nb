Cell[TextData[{
 "A scene that picks a neighbour ",
 StyleBox["p", "TI"],
 " of the centre of the square grid, then a neighbour ",
 StyleBox["q", "TI"],
 " of ",
 StyleBox["p", "TI"],
 ". The four choices of ",
 StyleBox["p", "TI"],
 " share the root; the sixteen states (",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 ") form four groups, one per ",
 StyleBox["p", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"ba0001c6-2a77-4378-9a4f-0a4f0a6ef8e6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "q"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraSceneStep", "[", 
          RowBox[{"{", 
           RowBox[{"p", " ", "==", " ", 
            RowBox[{"InfraPoint", "[", 
             RowBox[{"InfraShell", "[", 
              RowBox[{"a", ",", " ", "1"}], "]"}], "]"}]}], "}"}], "]"}], ",",
          " ", 
         RowBox[{"InfraSceneStep", "[", 
          RowBox[{"{", 
           RowBox[{"q", " ", "==", " ", 
            RowBox[{"InfraPoint", "[", 
             RowBox[{"InfraShell", "[", 
              RowBox[{"p", ",", " ", "1"}], "]"}], "]"}]}], "}"}], "]"}]}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"data", " ", "=", " ", 
     RowBox[{"InfraSceneMultiway", "[", 
      RowBox[{"scene", ",", " ", "g"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraBranchialGraph", "[", 
        RowBox[{"data", ",", " ", "d"}], "]"}], "[", "\"\<Graph\>\"", "]"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"d", ",", " ", "1", ",", " ", "2"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"13723716-1329-4068-9806-5015e35e6d60"],

