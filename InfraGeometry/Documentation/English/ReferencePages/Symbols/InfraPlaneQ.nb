Cell["\<\
A plane of 45 and 47 passes; with one vertex removed it no longer separates:\
\>", "ExampleText",ExpressionUUID->"458c591b-6ae5-451c-8971-ff682acfce32"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"plane", " ", "=", " ", 
     RowBox[{"RandomInfraPlane", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraPlane", "[", 
        RowBox[{"45", ",", " ", "47"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"h", ",", " ", "45", ",", " ", "47"}], "}"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraPlaneQ", "[", 
          RowBox[{"g", ",", " ", "h", ",", " ", "45", ",", " ", "47"}], 
          "]"}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"h", ",", " ", 
        RowBox[{"{", 
         RowBox[{"plane", ",", " ", 
          RowBox[{"Rest", " ", "@", " ", "plane"}]}], "}"}]}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1728518d-2538-42e1-bea8-c89316e163e3"],

