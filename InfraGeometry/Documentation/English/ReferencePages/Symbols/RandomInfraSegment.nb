Cell[TextData[{
 "A shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is a walk ",
 StyleBox["p = v\:2080, v\:2081, \[Ellipsis], v\:2096 = q", "TI"],
 " with ",
 StyleBox["k = d(p, q)", "TI"],
 ". In the plane the segment is unique; on a graph there are usually many, \
and each is drawn with the same probability."
}], "Notes",ExpressionUUID->"a81bd704-f53c-4479-a4c2-c7323fbd8e1d"],

