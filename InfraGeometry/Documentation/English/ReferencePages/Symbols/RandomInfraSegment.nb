Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "5"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"paths", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"ListPlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Lookup", "[", 
        RowBox[{
         RowBox[{"Counts", " ", "@", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"RandomInfraSegment", "[", 
             RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", 
              RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "f"}], ",",
               " ", 
              RowBox[{"RandomSeeding", " ", "->", " ", "k"}]}], "]"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"k", ",", " ", "1000"}], "}"}]}], "]"}]}], ",", "\n", 
         "      ", "paths", ",", " ", "0"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"f", ",", " ", 
         RowBox[{"{", 
          RowBox[{"Automatic", ",", " ", "RandomChoice"}], "}"}]}], "}"}]}], 
      "]"}], ",", "\n", "    ", 
     RowBox[{"Filling", " ", "->", " ", "Axis"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "All"}], "}"}]}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Automatic\>\"", ",", " ", "\"\<RandomChoice\>\""}], 
       "}"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"94d3ebb5-a5bd-43dc-abed-039f714609dd"],

