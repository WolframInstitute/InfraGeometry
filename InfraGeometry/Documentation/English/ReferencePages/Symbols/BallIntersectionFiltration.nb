Cell["\<\
The number of edges, triangles and tetrahedra of the order-2 complex of the \
lattice points of the ball of radius 3, against the radius. The steps are at \
half the lattice distances 1, \[Sqrt]2, 2, \[Sqrt]5:\
\>", "ExampleText",ExpressionUUID->"60233da8-c381-4470-8e7e-67e978cd5c71"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "3"}], ",", " ", "3"}], "]"}], ",", " ", "2"}], "]"}],
        ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"Abs", "[", "#", "]"}], "]"}], " ", "<=", " ", "3"}], " ", 
        "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"filtration", " ", "=", " ", 
     RowBox[{"BallIntersectionFiltration", "[", 
      RowBox[{"points", ",", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0.4", ",", " ", "1.2", ",", " ", "0.05"}], "]"}], ",", " ", 
       "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"KeyValueMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#1", ",", " ", 
            RowBox[{"Count", "[", 
             RowBox[{"#2", ",", " ", 
              RowBox[{"s_", " ", "/;", " ", 
               RowBox[{
                RowBox[{"Length", "[", "s", "]"}], " ", "==", " ", "m"}]}]}], 
             "]"}]}], "}"}], " ", "&"}], ",", " ", "filtration"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "2", ",", " ", "4"}], "}"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<edges\>\"", ",", " ", "\"\<triangles\>\"", ",", 
        " ", "\"\<tetrahedra\>\""}], "}"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2a060035-2e92-46df-8f9d-a72fcff4a8c8"],

