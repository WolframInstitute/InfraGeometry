Cell[TextData[{
 "With ",
 Cell[BoxData["\"\<Metric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d36033cc-1b71-4ba4-91cd-878281253ee7"],
 " -> ",
 StyleBox["g", "TI"],
 " the data are vertices of a graph. The number of edges and triangles of the \
\[CapitalCHacek]ech filtration of the vertices within distance 3 of the \
centre of the hexagonal tiling, at integer radii."
}], "ExampleText",ExpressionUUID->"7d5cec93-7014-4fa7-8297-75dd657170c9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"data", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "3"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"filtration", " ", "=", " ", 
     RowBox[{"BallIntersectionFiltration", "[", 
      RowBox[{"data", ",", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", "3"}], "]"}], ",", " ", "Infinity", ",", " ", 
       RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}], ",", " ", 
       RowBox[{"\"\<MaxDimension\>\"", " ", "->", " ", "2"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"ListLinePlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"KeyValueMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#1", ",", " ", 
            RowBox[{"Count", "[", 
             RowBox[{"#2", ",", " ", 
              RowBox[{"simplex_", " ", "/;", " ", 
               RowBox[{
                RowBox[{"Length", "[", "simplex", "]"}], " ", "==", " ", 
                "m"}]}]}], "]"}]}], "}"}], " ", "&"}], ",", " ", 
         "filtration"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<edges\>\"", ",", " ", "\"\<triangles\>\""}], "}"}]}], ",",
      "\n", "    ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<r\>\"", ",", " ", "\"\<simplices\>\""}], "}"}]}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b3b76d56-9215-403c-b2a9-0c56e494a5a0"],

