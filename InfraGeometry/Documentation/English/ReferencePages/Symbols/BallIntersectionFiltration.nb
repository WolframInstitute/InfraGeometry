Cell["\<\
The number of edges, triangles and tetrahedra of the order-2 complex of \
sixteen random points against the radius.\
\>", "ExampleText",ExpressionUUID->"ecde6de8-7d42-407a-aa60-57c78e3b5c7a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"16", ",", " ", "2"}], "}"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"filtration", " ", "=", " ", 
     RowBox[{"BallIntersectionFiltration", "[", 
      RowBox[{"points", ",", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0.02", ",", " ", "0.3", ",", " ", "0.02"}], "]"}], ",", " ", 
       "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"ListLinePlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"KeyValueMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#1", ",", " ", 
            RowBox[{"Count", "[", 
             RowBox[{"#2", ",", " ", 
              RowBox[{"simplex_", " ", "/;", " ", 
               RowBox[{
                RowBox[{"Length", "[", "simplex", "]"}], " ", "==", " ", 
                "m"}]}]}], "]"}]}], "}"}], " ", "&"}], ",", " ", 
         "filtration"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "2", ",", " ", "4"}], "}"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<edges\>\"", ",", " ", "\"\<triangles\>\"", ",", 
        " ", "\"\<tetrahedra\>\""}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<r\>\"", ",", " ", "\"\<simplices\>\""}], "}"}]}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f0e0e37c-b87c-4921-b3c9-273413b1ce8a"],

