Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "3"}], ",", " ", "3"}], "]"}], ",", " ", "2"}], "]"}],
        ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"Abs", "[", "#", "]"}], "]"}], " ", "<=", " ", "3"}], " ", 
        "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"KeyValueMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "complex"}], "}"}], " ", "|->", "\n", "    ", 
       RowBox[{"Graphics", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"StandardBlue", ",", " ", 
             RowBox[{"Opacity", "[", "0.15", "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Disk", "[", 
                RowBox[{"#", ",", " ", "r"}], "]"}], " ", "&"}], " ", "/@", 
              " ", "points"}]}], "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"StandardRed", ",", " ", 
             RowBox[{"Opacity", "[", "0.3", "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Polygon", "[", 
                RowBox[{"points", "[", 
                 RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "&"}], " ", "/@",
               " ", 
              RowBox[{"Select", "[", 
               RowBox[{"complex", ",", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "3"}], 
                 " ", "&"}]}], "]"}]}]}], "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"StandardRed", ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Line", "[", 
                RowBox[{"points", "[", 
                 RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "&"}], " ", "/@",
               " ", 
              RowBox[{"Select", "[", 
               RowBox[{"complex", ",", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "2"}], 
                 " ", "&"}]}], "]"}]}]}], "}"}], ",", " ", 
           RowBox[{"Point", "[", "points", "]"}]}], "}"}], ",", " ", 
         RowBox[{"PlotLabel", " ", "->", " ", "r"}]}], "]"}]}], ",", "\n", 
      "    ", 
      RowBox[{"BallIntersectionFiltration", "[", 
       RowBox[{"points", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.5", ",", " ", "0.71", ",", " ", "1."}], "}"}], ",", " ", 
        "2"}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7bd4b3b8-dc68-4d04-902e-91e26703ee69"],

