Cell["\<\
Three stages of the same filtration, each complex containing the one before.\
\>", "ExampleText",ExpressionUUID->"bfee7327-3a2c-4212-8d43-f80465269288"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"16", ",", " ", "2"}], "}"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"radii", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0.08", ",", " ", "0.12", ",", " ", "0.16"}], "}"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"filtration", " ", "=", " ", 
     RowBox[{"BallIntersectionFiltration", "[", 
      RowBox[{"points", ",", " ", "radii", ",", " ", "2"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", "\n", "     ", 
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"{", "\n", "       ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"StandardBlue", ",", " ", 
              RowBox[{"Opacity", "[", "0.15", "]"}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Disk", "[", 
                 RowBox[{"#", ",", " ", "r"}], "]"}], " ", "&"}], " ", "/@", 
               " ", "points"}]}], "}"}], ",", "\n", "       ", 
            RowBox[{"{", 
             RowBox[{"StandardRed", ",", " ", 
              RowBox[{"Opacity", "[", "0.3", "]"}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Polygon", "[", 
                 RowBox[{"points", "[", 
                  RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "&"}], " ", "/@",
                " ", 
               RowBox[{"Select", "[", 
                RowBox[{
                 RowBox[{"filtration", "[", "r", "]"}], ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "3"}], 
                  " ", "&"}]}], "]"}]}]}], "}"}], ",", "\n", "       ", 
            RowBox[{"{", 
             RowBox[{"StandardRed", ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Line", "[", 
                 RowBox[{"points", "[", 
                  RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "&"}], " ", "/@",
                " ", 
               RowBox[{"Select", "[", 
                RowBox[{
                 RowBox[{"filtration", "[", "r", "]"}], ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "2"}], 
                  " ", "&"}]}], "]"}]}]}], "}"}], ",", "\n", "       ", 
            RowBox[{"Point", "[", "points", "]"}]}], "}"}], ",", "\n", 
          "       ", 
          RowBox[{"PlotLabel", " ", "->", " ", "r"}]}], "]"}], ",", "\n", 
        "     ", 
        RowBox[{"{", 
         RowBox[{"r", ",", " ", "radii"}], "}"}]}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"MapThread", "[", 
       RowBox[{"SubsetQ", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Rest", " ", "@", " ", 
           RowBox[{"Values", "[", "filtration", "]"}]}], ",", " ", 
          RowBox[{"Most", " ", "@", " ", 
           RowBox[{"Values", "[", "filtration", "]"}]}]}], "}"}]}], "]"}]}]}],
     "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7ec7ab46-39e4-48ae-802d-7be2c1a322cf"],

