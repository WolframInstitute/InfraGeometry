Cell[TextData[{
 "For ",
 StyleBox["r \[LessEqual] s", "TI"],
 " the complex at ",
 StyleBox["r", "TI"],
 " is a subcomplex of the complex at ",
 StyleBox["s", "TI"],
 ", so the complexes over the sorted radii form a filtration. A simplex ",
 StyleBox["\[Sigma]", "TI"],
 " enters at the first radius not below ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionFiltrationValue"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
BallIntersectionFiltrationValue", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["\[Sigma]", "TR"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea050e4d-23a7-462a-ad55-24932c8c6209"],
 "."
}], "Notes",ExpressionUUID->"043af211-39e8-4356-9b18-dc6056bfd61e"],

Cell[TextData[{
 "The options are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallIntersectionComplex"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
    "WolframInstitute/InfraGeometry Package Symbol"},
