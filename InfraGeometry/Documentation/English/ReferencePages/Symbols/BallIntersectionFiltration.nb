  FontSize->0.9 Inherited,ExpressionUUID->
  "068ff818-5b1d-43ce-b0ee-c94d269b0446"],
 ", ",
 Cell[BoxData["\"\<IntersectionTest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cca23b3-8c25-4211-9246-7a5d16358b02"],
 ", ",
 Cell[BoxData["\"\<MaxDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3218c3ec-c29b-42d7-9fc3-203a51804f35"],
 ". With ",
 Cell[BoxData[
  RowBox[{"\"\<Metric\>\"", " ", "->", " ", "g"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a7fc6e7-79a0-401e-b688-27363c494cfa"],
 " the value of every simplex is an integer, so integer radii suffice."
}], "Notes",ExpressionUUID->"fc597845-d6ca-4068-8a70-a8128bd8597a"]
}, Open  ]],

