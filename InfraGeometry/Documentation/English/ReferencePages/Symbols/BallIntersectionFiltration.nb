Cell["Each complex contains the one before:", "ExampleText",ExpressionUUID->"3feb1574-4799-4b68-be4e-268d677f8199"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "3"}], ",", " ", "3"}], "]"}], ",", " ", "2"}], "]"}],
        ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"Abs", "[", "#", "]"}], "]"}], " ", "<=", " ", "3"}], " ", 
        "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"filtration", " ", "=", " ", 
     RowBox[{"BallIntersectionFiltration", "[", 
      RowBox[{"points", ",", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0.4", ",", " ", "1.2", ",", " ", "0.1"}], "]"}], ",", " ", 
       "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{"MapThread", "[", 
     RowBox[{"SubsetQ", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Rest", " ", "@", " ", 
         RowBox[{"Values", "[", "filtration", "]"}]}], ",", " ", 
        RowBox[{"Most", " ", "@", " ", 
         RowBox[{"Values", "[", "filtration", "]"}]}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f95fd6c6-3be6-411d-9ec4-43d0bf7d8b38"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a94ec9da-17cc-4601-834d-5910972624cd"]
}, Open  ]],

Cell["\<\
The radii are sorted, and each complex is the ball intersection complex at \
its radius:\
\>", "ExampleText",ExpressionUUID->"66ae9cdb-d924-4d3d-8675-4b5d17c7c5d1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "2"}], ",", " ", "2"}], "]"}], ",", " ", "2"}], "]"}],
        ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"Abs", "[", "#", "]"}], "]"}], " ", "<=", " ", "2"}], " ", 
        "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"filtration", " ", "=", " ", 
     RowBox[{"BallIntersectionFiltration", "[", 
      RowBox[{"points", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0.5", ",", " ", "0.75"}], "}"}], ",", " ", 
       "3"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Keys", "[", "filtration", "]"}], ",", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Keys", "[", "filtration", "]"}], ",", " ", 
       RowBox[{"r", " ", "|->", " ", 
        RowBox[{
         RowBox[{"filtration", "[", "r", "]"}], " ", "===", " ", 
         RowBox[{"BallIntersectionComplex", "[", 
          RowBox[{"points", ",", " ", "r", ",", " ", "3"}], "]"}]}]}]}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ae775245-f0d9-4438-88d6-766e5930443c"],

