Cell["BallIntersectionFiltration", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8e779882-5465-4862-a8d0-1dc57ceea081"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionFiltration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionFiltration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["radii", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a40d3bd-c054-47b1-9e65-d3545dc2fdd4"],
 "\[LineSeparator]",
 "gives an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8895b769-d59d-4070-be6c-861440b1f0cf"],
 " from each radius ",
 StyleBox["r", "TI"],
 " of ",
 StyleBox["radii", "TI"],
 ", in increasing order, to the order-",
 StyleBox["k", "TI"],
 " complex ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionComplex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "641defd7-c51f-4156-b39b-19ae0d659d80"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"fccd5c47-3693-48f3-8bc7-1da4be949572"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionFiltration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionFiltration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["radii", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10e7ae49-c674-41d5-98b8-6b3a2c8e420c"],
 "\[LineSeparator]",
 "takes ",
 StyleBox["k", "TI"],
 " = ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3956cfb7-f91f-4ef0-bebd-7e442b518b65"],
 ", the \[CapitalCHacek]ech filtration."
}], "Usage",ExpressionUUID->"ee01e79c-1bbc-4974-a94f-5eb065ca13d5"],

Cell[TextData[{
 "Definition: for ",
 StyleBox["r \[LessEqual] s", "TI"],
 " the complex at ",
 StyleBox["r", "TI"],
 " is a subcomplex of the complex at ",
 StyleBox["s", "TI"],
 ", so the complexes over the sorted radii form a filtration. A simplex \
enters at the first radius not below its value ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallIntersectionFiltrationValue"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
BallIntersectionFiltrationValue", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", " ", 
    StyleBox["\[Sigma]", "TR"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74df1faa-5128-43c1-9688-9337aa89ba30"],
 "."
}], "Notes",ExpressionUUID->"8d6a1221-f877-4e0f-a579-5d23c3a250c7"],

Cell[TextData[{
 "The radii are sorted. The options are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallIntersectionComplex"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3496cb25-172f-4874-99ed-60912e930c50"],
 ": ",
 Cell[BoxData["\"\<Metric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8d1cc19-7810-4fbd-a8f6-8bc9de05f6a2"],
 ", ",
 Cell[BoxData["\"\<IntersectionTest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bae1618-53a8-406c-80b5-698326ddc2e2"],
 ", ",
 Cell[BoxData["\"\<MaxDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed934d22-e519-4ad0-b6b9-ab16ea12a4d6"],
 "."
}], "Notes",ExpressionUUID->"e02ffcab-cb56-4b6b-a0c3-1f65cdc4d3be"],

Cell[TextData[{
 "The association is the form a persistence computation reads. Under ",
 Cell[BoxData["\"\<MaxDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0300cb9-fdb2-4376-9ba3-8efc11a24bf4"],
 " -> ",
 StyleBox["m", "TI"],
 " nothing above dimension ",
 StyleBox["m", "TI"],
 " is there to fill an ",
 StyleBox["m", "TI"],
 "-cycle, so only the dimensions below ",
 StyleBox["m", "TI"],
 " carry persistence."
}], "Notes",ExpressionUUID->"315e9ce7-6be9-4aa4-a4bf-6d7d66e4e086"]
}, Open  ]],

