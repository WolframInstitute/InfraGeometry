Cell["\<\
Choose values in two fibers and extend them continuously across the whole \
cycle.\
\>", "ExampleText",ExpressionUUID->"948ec1c8-dea3-445c-875f-736a05d6fe24"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "3", " ", "}"}]}], ",", "\n", "    ", 
       RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "0", " ", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"partial", " ", "=", " ", 
     RowBox[{"RandomInfraSection", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"section", " ", "=", " ", 
     RowBox[{"RandomInfraSection", "[", 
      RowBox[{"fib", ",", " ", "partial", ",", " ", 
