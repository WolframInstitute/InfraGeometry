   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "43ab3531-3d05-484d-8586-ce73db082d49"],
 " returns the complete finite class."
}], "Notes",ExpressionUUID->"0764430c-b7a9-4453-ac70-84eed05f2f05"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Automatic"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed8de496-406e-4d9f-a793-186aa7e4209e"],
 " uses random candidate order for bounded searches. ",
 Cell[BoxData[
  RowBox[{"RandomSeeding", " ", "->", " ", "Automatic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7557ced-15a5-4153-9a5f-ed8079b193c5"],
 " (default) seeds each call afresh, independently of ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8992ba6-9d19-4223-bf4d-eeae47dc631f"],
 "; an integer or string gives a reproducible draw, and ",
 Cell[BoxData["Inherited"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12147a11-5073-4366-893c-f293225c7122"],
 " a local snapshot of the current state. The outer random state is restored \
afterward, as with ",
 ButtonBox["RandomInstance",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/RandomInstance.html"], 
    None}],
 "."
}], "Notes",ExpressionUUID->"af0cf9e4-8a0c-42f6-bce7-61bc8326fef9"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "026144c1-bd11-4990-9daa-9afaa9ef4b23"],
 " is deterministic. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1f7022a6-84a1-402f-b5ef-fe461cf4d923"],
 " with default ordering is also deterministic and consumes no sampler random \
draws."
}], "Notes",ExpressionUUID->"d038e062-d962-4ee7-80d4-afe355072e10"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomSample"]], "paclet:ref/RandomSample"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9ecb2e78-3154-4668-80ea-1a610ae31b36"],
 " randomizes candidate order with backtracking. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomChoice"]], "paclet:ref/RandomChoice"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2e144477-6106-41fb-832c-c4b39d485059"],
 " pursues one route without backtracking and is unsupported with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "95112106-789b-4206-9bc6-5fbbbbd37c2e"],
 "."
}], "Notes",ExpressionUUID->"d78898ca-ab12-484c-b83a-4e9fbff217ba"],

Cell["\<\
A callback receives the candidate total vertices of the next fiber. It may \
return one literal candidate or a duplicate-free list of candidates in the \
desired order. Returning a subset prunes the search.\
\>", "Notes",ExpressionUUID->"af240573-c3a4-4229-9998-e06557d0d7d7"],

Cell["\<\
A list that is itself a candidate vertex is interpreted as that single \
vertex. Otherwise a returned list specifies the candidate order.\
\>", "Notes",ExpressionUUID->"89495b6c-fc06-43a6-b1f2-4924867fd3f7"],

Cell["\<\
Bounded requests stop after enough sections are found. Randomized search \
order does not imply uniform sampling over continuous sections or extensions.\
\
\>", "Notes",ExpressionUUID->"c5da9f3c-2a44-4033-9d7d-7fb1d747fa3a"],

Cell[TextData[{
 Cell[BoxData[
