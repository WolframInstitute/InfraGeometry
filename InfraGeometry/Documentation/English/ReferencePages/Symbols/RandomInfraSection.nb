Cell[TextData[{
 "A section chooses one vertex ",
 StyleBox["s(p)", "TI"],
 " in the fiber over each ",
 StyleBox["p", "TI"],
 ". Without conditions there are ",
 StyleBox["\[Product]\:209a |F\:209a|", "TI"],
 " sections over the whole base."
}], "Notes",ExpressionUUID->"171f6eb3-d660-4562-bc66-156e1df996b5"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "\"\<Continuous\>\"", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20eba2da-bef0-4fa1-892b-2d829f7ffe55"],
 " every base edge ",
 StyleBox["pq", "TI"],
 " of the domain goes to a total edge ",
 StyleBox["s(p)s(q)", "TI"],
 ". A continuous section is a copy of its domain inside the total graph, and \
it may not exist."
}], "Notes",ExpressionUUID->"5ceaf9b9-3ab2-4835-948d-c52f5fb11663"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ff0e7e5-6fb6-4807-b038-840b972517fb"],
 ", ",
