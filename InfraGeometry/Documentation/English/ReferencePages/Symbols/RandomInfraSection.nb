Cell["\<\
A seed must be a valid partial section. A valid discontinuous seed has no \
continuous extension, but still has set-theoretic extensions.\
\>", "Notes",ExpressionUUID->"0e3e1d07-5f2b-420d-bae4-3c970c665ca1"],

Cell[TextData[{
 "A domain is a list of literal base vertices. A seed is wrapped in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b5b52ad2-1a33-4266-bf53-afa0c800cc57"],
 ", so these call forms are distinct."
}], "Notes",ExpressionUUID->"f096ba8d-2ab4-484c-9130-087ca5c88d48"],

Cell[TextData[{
 "An omitted count or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Automatic"]], "paclet:ref/Automatic"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "96333d94-4a11-4214-98f6-ae43e9cdd874"],
 " returns one section directly, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4db1ece1-f60d-49d3-98b4-4d3cf6623070"],
 " if none is found."
}], "Notes",ExpressionUUID->"69ed89e1-fb1a-4c8c-a287-c121d843c7f5"],

Cell[TextData[{
 "A nonnegative integer ",
 StyleBox["n", "TI"],
 " returns exactly ",
 StyleBox["n", "TI"],
 " distinct sections, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce7e17ce-aeaa-4491-abaf-d31a3d544aa1"],
 " on shortage. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UpTo"]], "paclet:ref/UpTo"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f608ddf0-f1e7-48d8-905b-1949e683d878"],
 "[",
 StyleBox["n", "TI"],
 "] returns at most ",
 StyleBox["n", "TI"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
