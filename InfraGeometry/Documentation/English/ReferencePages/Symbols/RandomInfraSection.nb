     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5eb7ed26-434e-4bad-ad8b-a8eb8a9ba951"],
 " returns the complete finite class."
}], "Notes",ExpressionUUID->"b015b230-3b81-4664-bc5c-01f5582aaec4"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Automatic"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05b98787-a375-4a72-a936-5ee68fa5f584"],
 " uses random candidate order for bounded searches. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3c945608-897c-48d7-82ec-33de5570c8ed"],
 " controls the ambient random stream."
}], "Notes",ExpressionUUID->"afd0b083-f3d1-4422-9a0a-7cc41c3569b9"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9f00ffe-0675-4327-9252-fd180fb4f941"],
 " is deterministic. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2da8140a-66da-42bc-8e50-31e41d9ebcaf"],
 " with default ordering is also deterministic and consumes no sampler random \
draws."
}], "Notes",ExpressionUUID->"8d047de7-ab04-4e7c-9124-0b927bf9a78b"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomSample"]], "paclet:ref/RandomSample"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fc3987aa-a003-4583-a317-7f5a6499fcae"],
 " randomizes candidate order with backtracking. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomChoice"]], "paclet:ref/RandomChoice"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3746e3ec-9066-4462-a9d9-8b61cca223e2"],
 " pursues one route without backtracking and is unsupported with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3e367620-ae13-4009-986e-04a13c90346d"],
 "."
}], "Notes",ExpressionUUID->"67b47468-dc94-4355-b52e-da6cef7c764a"],

Cell["\<\
A callback receives the candidate total vertices of the next fiber. It may \
return one literal candidate or a duplicate-free list of candidates in the \
desired order. Returning a subset prunes the search.\
\>", "Notes",ExpressionUUID->"6a92c6a4-c2d4-4a0c-946c-97ea5276fe7a"],

Cell["\<\
A list that is itself a candidate vertex is interpreted as that single \
vertex. Otherwise a returned list specifies the candidate order.\
\>", "Notes",ExpressionUUID->"54bbcfef-52f6-4b49-b77a-397854ac4dcc"],

Cell["\<\
Bounded requests stop after enough sections are found. Randomized search \
order does not imply uniform sampling over continuous sections or extensions.\
\
\>", "Notes",ExpressionUUID->"9627c6b1-c160-4270-affc-3806bf82452d"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00ec8246-256f-4476-a04b-ff1a29ddd728"],
 " denotes no result. The unique section over an empty domain is ",
 Cell[BoxData[
  RowBox[{"InfraSection", "[", 
   RowBox[{"<|", "|>"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d96903d-652f-4e29-8b14-c096a69296be"],
 "."
}], "Notes",ExpressionUUID->"d90a49ad-930c-4e97-bcf2-62c186d6a8f4"],

Cell["\<\
Unsupported options, data and callback results leave the call unevaluated.\
\>", "Notes",ExpressionUUID->"f86fd478-f16d-46fd-b524-65cc195abc85"],

