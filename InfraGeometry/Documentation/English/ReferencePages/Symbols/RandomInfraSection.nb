  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec35c0e5-454f-4991-9640-5c587b912454"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8ef58b7-70bb-4518-b316-0f228ec2c60b"],
 ". Without a count the result is one section; when none exists, or fewer \
than ",
 StyleBox["n", "TI"],
 ", the result is ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fdab202-e670-4454-a88b-a9dd00c481b3"],
 ". The section over an empty domain is ",
 Cell[BoxData[
  RowBox[{"InfraSection", "[", 
   RowBox[{"<|", "|>"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c0e5b55-203b-4acc-991a-45904dcc15d4"],
 "."
}], "Notes",ExpressionUUID->"df3729ea-8f3b-4c1a-863d-8d64eb3a064f"],

