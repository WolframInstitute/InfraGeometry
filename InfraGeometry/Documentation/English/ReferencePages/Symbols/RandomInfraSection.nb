}], "Notes",ExpressionUUID->"ca0e6639-35ff-4da1-8282-8af5c4b1605e"],

Cell["\<\
A seed must be a valid partial section. A valid discontinuous seed has no \
continuous extension, but still has set-theoretic extensions.\
\>", "Notes",ExpressionUUID->"7d4e82b8-25f7-424f-afc7-4a55fb000ff0"],

Cell[TextData[{
 "A domain is a list of literal base vertices. A seed is wrapped in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "511470f0-f086-4e70-9a40-b6a9355147c6"],
 ", so these call forms are distinct."
}], "Notes",ExpressionUUID->"2ef77434-75b3-46ec-99e6-49e12529e873"],

Cell[TextData[{
 "An omitted count or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Automatic"]], "paclet:ref/Automatic"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3a2909c3-19de-4c8a-a21c-e38fd95c0bd9"],
 " returns one section directly, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b60054ed-ec9a-49b3-8d2b-b4dcecaf1992"],
 " if none is found."
}], "Notes",ExpressionUUID->"648f0536-cebf-4510-b2cf-f0ac5c2b50c8"],

Cell[TextData[{
 "A nonnegative integer ",
 StyleBox["n", "TI"],
 " returns exactly ",
 StyleBox["n", "TI"],
 " distinct sections, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebf70ccd-4cd6-4fa0-8237-9a69ffbd224b"],
 " on shortage. ",
 Cell[BoxData[
  TemplateBox[{
