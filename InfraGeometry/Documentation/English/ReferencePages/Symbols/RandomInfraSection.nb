  "43974635-0314-42d1-9c9e-88576a8990ff"],
 " returns the complete finite class."
}], "Notes",ExpressionUUID->"2f186365-9d4b-4f48-a902-b6dddf98f637"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Automatic"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0179712-82b1-49d4-889c-39f52e53295f"],
 " uses random candidate order for bounded searches. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3294388f-5504-4ef8-b451-f117a8e92355"],
 " controls the ambient random stream."
}], "Notes",ExpressionUUID->"015d371c-c0fa-45b2-97fc-eff5b6e45864"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1643d158-270f-4b20-87e0-a916021acb20"],
 " is deterministic. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8a458bf5-b664-446a-ad7c-44d90dbdce52"],
 " with default ordering is also deterministic and consumes no sampler random \
draws."
}], "Notes",ExpressionUUID->"e497066d-dee8-4ab5-8d33-752cc7444cb2"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomSample"]], "paclet:ref/RandomSample"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2acec60a-fd42-4f64-b5f6-1bbbbd3df3c9"],
 " randomizes candidate order with backtracking. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomChoice"]], "paclet:ref/RandomChoice"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8ef15e8d-65b9-433e-91d8-d3258b5ff2d0"],
 " pursues one route without backtracking and is unsupported with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e76c1825-8e01-4acf-9c7a-000dbf61c722"],
 "."
}], "Notes",ExpressionUUID->"8f34c00b-a7fd-41b8-816a-6ff10d423f16"],

Cell["\<\
A callback receives the candidate total vertices of the next fiber. It may \
return one literal candidate or a duplicate-free list of candidates in the \
desired order. Returning a subset prunes the search.\
\>", "Notes",ExpressionUUID->"52b3133c-7079-48c8-a5ae-de4ef9970c77"],

Cell["\<\
A list that is itself a candidate vertex is interpreted as that single \
vertex. Otherwise a returned list specifies the candidate order.\
\>", "Notes",ExpressionUUID->"361de976-2ba9-4668-b03f-f5c539085703"],

Cell["\<\
Bounded requests stop after enough sections are found. Randomized search \
order does not imply uniform sampling over continuous sections or extensions.\
\
\>", "Notes",ExpressionUUID->"9ecf306e-efc0-48de-b4d9-73ac2fb4802f"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8def69de-89d2-4d3a-8fb5-c0d7f9cd10ed"],
 " denotes no result. The unique section over an empty domain is ",
 Cell[BoxData[
  RowBox[{"InfraSection", "[", 
   RowBox[{"<|", "|>"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47c1ee44-0ef0-44bc-8f4b-3f3a9bb95e2f"],
 "."
}], "Notes",ExpressionUUID->"fa8a5667-a05c-4588-ab87-3b40c86c56d8"],

Cell["\<\
Unsupported options, data and callback results leave the call unevaluated.\
\>", "Notes",ExpressionUUID->"d8ec870c-e7e5-4ec9-ab23-0b6fe57d2ccd"],

