  FontSize->0.9 Inherited,ExpressionUUID->
  "4377ca14-58a5-4fb4-860c-e426a5fbfffb"],
 " denotes no result. The unique section over an empty domain is ",
 Cell[BoxData[
  RowBox[{"InfraSection", "[", 
   RowBox[{"<|", "|>"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10ad07c1-a3e2-4a9d-8f29-a917dd934d0d"],
 "."
}], "Notes",ExpressionUUID->"7b5c3d61-92ea-4faf-92cb-24016b952e6a"],

Cell["\<\
Unsupported options, data and callback results leave the call unevaluated.\
\>", "Notes",ExpressionUUID->"03dd9307-a777-4bdc-9d32-e0eb36863240"],

