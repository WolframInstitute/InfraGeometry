Cell["\<\
A continuous partial section need not extend. The values below lie over two \
vertices that are not adjacent, so the partial section is continuous; they \
lie on different sheets, so no continuous section joins them. Without the \
condition the extension exists:\
\>", "ExampleText",ExpressionUUID->"d83a120f-ba2c-40b6-8219-76b0814bfe9c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GraphProduct", "[", 
        RowBox[{
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
         RowBox[{"Graph", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
           RowBox[{"{", "}"}]}], "]"}], ",", " ", "\"\<Cartesian\>\""}], 
        "]"}], ",", " ", "First"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"s", " ", "=", " ", 
     RowBox[{"InfraSection", "[", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"1", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1"}], "}"}]}], ",", " ", 
        RowBox[{"16", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"16", ",", " ", "2"}], "}"}]}]}], "|>"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraContinuousSectionQ", "[", 
      RowBox[{"fib", ",", " ", "s"}], "]"}], ",", " ", 
     RowBox[{"RandomInfraSection", "[", 
      RowBox[{"fib", ",", " ", "s", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Continuous\>\"", "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"InfraSectionQ", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomInfraSection", "[", 
        RowBox[{"fib", ",", " ", "s", ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}]}], 
