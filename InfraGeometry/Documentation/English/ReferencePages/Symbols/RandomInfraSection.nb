Cell["\<\
A continuous partial section can fail to extend. Values on opposite sheets at \
the ends of this path cannot be joined by a continuous section.\
\>", "ExampleText",ExpressionUUID->"9a66b62e-5d40-40f5-b1a1-9b2f7168e601"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GraphProduct", "[", 
        RowBox[{
         RowBox[{"PathGraph", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}], ",", 
         " ", 
         RowBox[{"Graph", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
           RowBox[{"{", "}"}]}], "]"}], ",", " ", "\"\<Cartesian\>\""}], 
        "]"}], ",", " ", "First"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"partial", " ", "=", " ", 
     RowBox[{"InfraSection", "[", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"1", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1"}], "}"}]}], ",", " ", 
        RowBox[{"3", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "2"}], "}"}]}]}], "|>"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraContinuousSectionQ", "[", 
      RowBox[{"fib", ",", " ", "partial"}], "]"}], ",", " ", 
     RowBox[{"RandomInfraSection", "[", 
      RowBox[{"fib", ",", " ", "partial", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Continuous\>\"", "}"}]}], ",", " ", 
