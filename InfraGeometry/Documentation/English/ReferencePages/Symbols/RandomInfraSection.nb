Cell["\<\
A seed must be a valid partial section. A valid discontinuous seed has no \
continuous extension, but still has set-theoretic extensions.\
\>", "Notes",ExpressionUUID->"8275ca7f-276d-4032-a837-064927260127"],

Cell[TextData[{
 "A domain is a list of literal base vertices. A seed is wrapped in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7b8435eb-28f2-49b2-a804-c3de69fdbdc5"],
 ", so these call forms are distinct."
}], "Notes",ExpressionUUID->"55b77865-a8bf-4db1-a9ab-4bb50b2f2c38"],

Cell[TextData[{
 "An omitted count or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Automatic"]], "paclet:ref/Automatic"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a8b7f48c-f2f7-448a-bc02-1be3ac0b75cc"],
 " returns one section directly, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71393cc7-33b4-43d4-8f90-fb8dede07233"],
 " if none is found."
}], "Notes",ExpressionUUID->"2d689e13-4837-42e4-8a56-eb8638824239"],

Cell[TextData[{
 "A nonnegative integer ",
 StyleBox["n", "TI"],
 " returns exactly ",
 StyleBox["n", "TI"],
 " distinct sections, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48630faa-41ee-4c0c-9d0f-03125baf0711"],
 " on shortage. ",
