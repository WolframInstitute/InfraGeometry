Cell["\<\
A random section of the prism is a section, and it is continuous only if it \
stays on one sheet.\
\>", "ExampleText",ExpressionUUID->"8d72c951-eabb-4e63-9dfc-53d1360b1559"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<CycleProductBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"section", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraSection", "[", "fib", "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"total", ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraDensity", "[", 
         RowBox[{"total", ",", " ", 
          RowBox[{"Values", " ", "@", " ", 
           RowBox[{"First", " ", "@", " ", "section"}]}]}], "]"}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"InfraSectionQ", "[", 
      RowBox[{"fib", ",", " ", "section"}], "]"}], ",", " ", 
     RowBox[{"InfraContinuousSectionQ", "[", 
      RowBox[{"fib", ",", " ", "section"}], "]"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"121739db-a0b1-4099-b1ff-1f26528d88f9"],

