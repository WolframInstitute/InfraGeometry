Cell["\<\
A random vector field at scale 2 on the grid: one ray of length 2 at every \
vertex.\
\>", "ExampleText",ExpressionUUID->"05b5dc86-aa3b-45d1-b252-de44a6753090"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridTangentBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"field", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraSection", "[", "fib", "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{
     RowBox[{"First", " ", "@", " ", "fib"}], ",", " ", 
     RowBox[{"InfraWalk", " ", "/@", " ", 
      RowBox[{"Values", " ", "@", " ", 
       RowBox[{"First", " ", "@", " ", "field"}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1e40b8b8-55ca-426d-8cda-81ec3d13bc78"],

