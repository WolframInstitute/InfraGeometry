}], "Notes",ExpressionUUID->"654960a2-1604-4a24-9c04-26f56e709372"],

Cell["\<\
A seed must be a valid partial section. A valid discontinuous seed has no \
continuous extension, but still has set-theoretic extensions.\
\>", "Notes",ExpressionUUID->"08754d3c-7c4a-4392-9bf2-278af17280b6"],

Cell[TextData[{
 "A domain is a list of literal base vertices. A seed is wrapped in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "58d55dab-f2a8-4225-84c1-e3f75be0d3e1"],
 ", so these call forms are distinct."
}], "Notes",ExpressionUUID->"02517ffc-e42f-4af8-ae01-96e4750396c6"],

Cell[TextData[{
 "An omitted count or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Automatic"]], "paclet:ref/Automatic"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "52e6af8b-2391-4bbb-9a96-9033ffa25028"],
 " returns one section directly, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "482fb91c-d08b-4850-9032-9106cc6c8568"],
 " if none is found."
}], "Notes",ExpressionUUID->"2327e4f3-786e-4c02-b0ec-5355afe191d8"],

Cell[TextData[{
 "A nonnegative integer ",
 StyleBox["n", "TI"],
 " returns exactly ",
 StyleBox["n", "TI"],
 " distinct sections, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf8023bb-46af-4987-a608-36e71bb4b0e9"],
 " on shortage. ",
