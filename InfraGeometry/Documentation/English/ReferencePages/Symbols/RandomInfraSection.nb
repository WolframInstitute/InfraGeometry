     TextData["UpTo"]], "paclet:ref/UpTo"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a33bb4ed-09c8-49cd-a7b9-5d440404efc6"],
 "[",
 StyleBox["n", "TI"],
 "] returns at most ",
 StyleBox["n", "TI"],
 ". ",
 Cell[BoxData[
