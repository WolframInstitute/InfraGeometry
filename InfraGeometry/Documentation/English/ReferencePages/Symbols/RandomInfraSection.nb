Cell["\<\
A domain restricts the target. A seed fixes values and extends across all \
base components.\
\>", "ExampleText",ExpressionUUID->"bed341d5-5c26-4b45-a817-7af6c3cc9935"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"Graph", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{"1", ",", " ", "3"}], "]"}], ",", " ", 
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{"2", ",", " ", "4"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<a\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<a\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<b\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<b\>\""}]}], "|>"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"partial", " ", "=", " ", 
     RowBox[{"RandomInfraSection", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"{", "\"\<a\>\"", "}"}], ",", " ", 
       RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}], ",",
        " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"partial", ",", " ", 
     RowBox[{"RandomInfraSection", "[", 
      RowBox[{"fib", ",", " ", "partial", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Continuous\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}], ",",
        " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], "]"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2257c632-7cd6-467d-858b-fd6d90eeab0f"],

Cell[BoxData[
 RowBox[{"{", 
