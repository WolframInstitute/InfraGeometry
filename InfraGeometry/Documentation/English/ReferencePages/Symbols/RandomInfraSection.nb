Cell["\<\
A random vector field at scale 2 on the grid: one ray of length 2 at every \
vertex.\
\>", "ExampleText",ExpressionUUID->"5f27a493-c02f-4101-b519-3cbababb11aa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridTangentBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"field", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraSection", "[", "fib", "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{
     RowBox[{"First", " ", "@", " ", "fib"}], ",", " ", 
     RowBox[{"InfraWalk", " ", "/@", " ", 
      RowBox[{"Values", " ", "@", " ", 
       RowBox[{"First", " ", "@", " ", "field"}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2416b49c-a9a2-44b6-b7cb-417bbb451232"],

