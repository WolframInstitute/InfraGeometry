Cell["\<\
The gradient of a random height on the mesh. The arrows run into the local \
maxima, which stay:\
\>", "ExampleText",ExpressionUUID->"b8979300-9de0-4c96-94e2-2b7986d2e8e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"1", ",", " ", 
           RowBox[{"VertexCount", "[", "g", "]"}]}], "]"}]}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"GradientDisplacement", "[", 
      RowBox[{"g", ",", " ", "f"}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c4789939-0c4e-4e8d-8b40-edf5d9d0233f"],

