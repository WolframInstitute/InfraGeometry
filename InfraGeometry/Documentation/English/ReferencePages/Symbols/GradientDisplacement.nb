Cell["\<\
The fixed points are the local maxima. Their numbers for a random height on \
the mesh:\
\>", "ExampleText",ExpressionUUID->"3ed639ff-8957-4574-a185-de442644f5d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"1", ",", " ", 
           RowBox[{"VertexCount", "[", "g", "]"}]}], "]"}]}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"gradient", " ", "=", " ", 
     RowBox[{"GradientDisplacement", "[", 
      RowBox[{"g", ",", " ", "f"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{"Keys", "[", "gradient", "]"}], ",", " ", 
       RowBox[{"v_", " ", "/;", " ", 
        RowBox[{
         RowBox[{"gradient", "[", "v", "]"}], " ", "===", " ", 
         RowBox[{"{", "v", "}"}]}]}]}], "]"}], ",", " ", 
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"v_", " ", "/;", " ", 
        RowBox[{
         RowBox[{"f", "[", "v", "]"}], " ", ">", " ", 
         RowBox[{"Max", "[", 
          RowBox[{"f", " ", "/@", " ", 
           RowBox[{"AdjacencyList", "[", 
            RowBox[{"g", ",", " ", "v"}], "]"}]}], "]"}]}]}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"20147bd2-adaa-485a-8cc6-5d524cdaa7ca"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"18", ",", "18"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"22498967-3e00-4977-9711-c04b2b6b7994"]
}, Open  ]],

Cell["\<\
The gradient of the distance from the centre is the outward radial \
displacement:\
\>", "ExampleText",ExpressionUUID->"fa98c9d1-09b6-43d0-9b65-c53da28bfba8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"GradientDisplacement", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", "c"}], "]"}]}], "]"}]}], "]"}], " ", "===", 
    " ", 
    RowBox[{"First", " ", "@", " ", 
     RowBox[{"PolarDisplacements", "[", 
      RowBox[{"g", ",", " ", "c"}], "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"46c053c1-f487-4ecb-9cb2-b2b767aab8a0"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"affbd2dd-7829-4878-8170-36ffb3635cf0"]
}, Open  ]]
}, Open  ]],

