Cell["\<\
The gradient of the first coordinate, on the square grid and on the square \
mesh. Each vertex moves to its neighbour furthest right. On the grid the \
right column and the pendant vertices of the top and bottom rows stay; on the \
mesh only 6 vertices of the right rim:\
\>", "ExampleText",ExpressionUUID->"8ae2ea44-e744-46df-af6b-f17ddd34cac8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"DisplacementPlot", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"GradientDisplacement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"AssociationThread", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{"First", " ", "/@", " ", 
             RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], 
       "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"cd491324-f383-479a-85ee-467d215bad24"],

