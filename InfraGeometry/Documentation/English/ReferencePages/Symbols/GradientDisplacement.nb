Cell[CellGroupData[{
Cell["GradientDisplacement", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1359192f-2fab-4b4b-b01c-2b09841534f8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GradientDisplacement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GradientDisplacement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["f", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "adde9745-046d-4ea8-a40a-627c16f5e509"],
 "\[LineSeparator]",
 "is the steepest-ascent displacement of the function ",
 StyleBox["f", "TI"],
 " on the vertices of ",
 StyleBox["g", "TI"],
 ", given as an association ",
 StyleBox["v", "TI"],
 " -> ",
 StyleBox["f", "TI"],
 "(",
 StyleBox["v", "TI"],
 ").",
 "\n"
}], "Usage",ExpressionUUID->"e09a8410-4105-4c72-a3d4-9a129b6f910d"],

Cell[TextData[{
 "The gradient is ",
 StyleBox["\[Del]f(v) = {u \[Tilde] v : f(u) is largest}", "TI"],
 " when that largest value exceeds ",
 StyleBox["f(v)", "TI"],
 ", and ",
 StyleBox["{v}", "TI"],
 " otherwise."
}], "Notes",ExpressionUUID->"d0025426-2722-4542-a952-52ba3026f384"],

Cell[TextData[{
 "The fixed points are the local maxima of ",
 StyleBox["f", "TI"],
 ": the vertices with no neighbour of larger value."
}], "Notes",ExpressionUUID->"73a5e711-115d-4725-80d8-ab01d384829b"],

Cell[TextData[{
 "Ties among the neighbours are kept. On the square grid the gradient of ",
 StyleBox["x + y", "TI"],
 " has two values at every inner vertex, the steps right and up; in the plane \
it is one vector, the diagonal."
}], "Notes",ExpressionUUID->"69e54b2e-3576-4eed-aa6c-6de3fef125cd"],

Cell[TextData[{
 "The gradient of the distance from a vertex ",
 StyleBox["c", "TI"],
 " is the outward radial displacement of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PolarDisplacements"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/PolarDisplacements", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "878e1169-f6a6-453b-92e2-2d9cf9d6ca9d"],
 "."
}], "Notes",ExpressionUUID->"32846b0f-f0aa-44b2-bec3-9e8b33745a3d"],

Cell[TextData[{
 StyleBox["f", "TI"],
 " needs a value at every vertex of ",
 StyleBox["g", "TI"],
 "."
}], "Notes",ExpressionUUID->"16af741e-81cb-45b2-b856-b33380555019"]
}, Open  ]],

