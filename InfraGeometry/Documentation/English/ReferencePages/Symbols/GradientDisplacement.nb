Cell[TextData[{
 "Ties are kept. The gradient of ",
 StyleBox["x + y", "TI"],
 " on the grid has two values at each of the 64 inner vertices:"
}], "ExampleText",ExpressionUUID->"fa8aa369-4762-43e7-9d1a-f859610a1f1b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"gradient", " ", "=", " ", 
     RowBox[{"GradientDisplacement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{"Total", " ", "/@", " ", 
          RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", "gradient", ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"KeySort", " ", "@", " ", 
       RowBox[{"Counts", "[", 
        RowBox[{"Length", " ", "/@", " ", "gradient"}], "]"}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"90415a4a-c723-401e-b66b-dd8578804c5e"],

