Cell[TextData[{
 "The quotients of the square tiling's ball volumes, ",
 StyleBox["2r\.b2 + 2r + 1", "TI"],
 ", stay above 2 and approach it slowly."
}], "ExampleText",ExpressionUUID->"fcfa2c09-fd70-467e-8bed-852135e9e3d0"],

