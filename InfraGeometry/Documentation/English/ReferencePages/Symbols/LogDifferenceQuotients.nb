Cell["\<\
The quotients of the shell areas of a planar lattice tend to 1, one less than \
those of the volumes.\
\>", "ExampleText",ExpressionUUID->"9224a3d9-e47d-4c57-9516-1cb6113a8704"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Large\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ctr", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ballQuots", " ", "=", " ", 
     RowBox[{"LogDifferenceQuotients", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"ctr", ",", " ", "r"}], "]"}], ",", 
          " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r", ",", " ", "0", ",", " ", "12"}], "}"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"shellQuots", " ", "=", " ", 
     RowBox[{"LogDifferenceQuotients", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"ctr", ",", " ", "r"}], "]"}], ",", 
          " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r", ",", " ", "1", ",", " ", "12"}], "}"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ballQuots", ",", " ", "shellQuots"}], "}"}], ",", " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<ball\>\"", ",", " ", "\"\<shell\>\""}], "}"}]}], ",", 
       " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "3.5"}], "}"}]}], ",", "\n", "     ", 
       RowBox[{"GridLines", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"None", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "Gray"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "Gray"}], "}"}]}], "}"}]}], "}"}]}], ",", 
       " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<r\>\"", ",", " ", "\"\<q(r)\>\""}], "}"}]}]}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Last", " ", "@", " ", "ballQuots"}], ",", " ", 
        RowBox[{"Last", " ", "@", " ", "shellQuots"}]}], "}"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"413ab05a-0f0b-49d5-a210-62d9bc477c36"],

