Cell[TextData[{
 "The shells of the square grid have ",
 StyleBox["4r", "TI"],
 " vertices for ",
 StyleBox["r", "TI"],
 " \[GreaterEqual] 1. Taken from radius 1, their quotients are exactly 1, one \
less than the dimension:"
}], "ExampleText",ExpressionUUID->"d4779f1b-ec16-44b6-82f0-88c1cfb840ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"areas", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
         " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "1", ",", " ", "8"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"areas", ",", " ", 
     RowBox[{"LogDifferenceQuotients", "[", "areas", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5607cccd-3b99-49ce-8fce-efdee2503270"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "4", ",", "8", ",", "12", ",", "16", ",", "20", ",", "24", ",", "28", ",",
      "32"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
    "1.`", ",", "1.`", ",", "1.`", ",", "0.9999999999999999`", ",", "1.`", ",",
      "1.`", ",", "1.`"}], "}"}]}], "}"}]], "Output",
