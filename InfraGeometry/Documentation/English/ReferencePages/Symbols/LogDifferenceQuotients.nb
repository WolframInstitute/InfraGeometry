Notebook[{

Cell[CellGroupData[{
Cell["LogDifferenceQuotients", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f2885be8-0f03-4a31-be01-2be905b769b6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LogDifferenceQuotients"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/LogDifferenceQuotients", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["w", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01cef716-fe75-46bb-b070-c3c046946f00"],
 "\[LineSeparator]",
 "gives the log-difference quotients {",
 StyleBox["q", "TI"],
 "(1), ",
 StyleBox["q", "TI"],
 "(2), \[Ellipsis]} of the sequence ",
 StyleBox["w", "TI"],
 " = {",
 StyleBox["w", "TI"],
 "(0), ",
 StyleBox["w", "TI"],
 "(1), \[Ellipsis]}, where ",
 StyleBox["q", "TI"],
 "(",
 StyleBox["r", "TI"],
 ") = (log ",
 StyleBox["w", "TI"],
 "(",
 StyleBox["r", "TI"],
 ") \[Minus] log ",
 StyleBox["w", "TI"],
 "(",
 StyleBox["r", "TI"],
 " \[Minus] 1)) / (log(",
 StyleBox["r", "TI"],
 " + 1) \[Minus] log ",
 StyleBox["r", "TI"],
 ").",
 "\n"
}], "Usage",ExpressionUUID->"a9512a7f-61d2-420c-a14a-5432631af39f"],

Cell[TextData[{
 "Definition: ",
 StyleBox["q(r) = (log w(r) \[Minus] log w(r \[Minus] 1)) / (log(r + 1) \
\[Minus] log r)", "TI"],
 " for ",
 StyleBox["r", "TI"],
 " = 1, 2, \[Ellipsis], the slope of the sequence on log-log axes between two \
consecutive positions. Position ",
 StyleBox["i", "TI"],
 " of ",
 StyleBox["w", "TI"],
 ", counted from 1, is placed at ",
 StyleBox["i", "TI"],
 ": so a sequence growing like ",
 StyleBox["(r + 1)^d", "TI"],
 " has every quotient equal to ",
 StyleBox["d", "TI"],
 "."
}], "Notes",ExpressionUUID->"e2bc5705-1bbe-49ca-8333-bd238805eeab"],

Cell[TextData[{
 "It is the discrete ",
 StyleBox["d log w / d log r", "TI"],
 ". Applied to a ball-volume profile, the quotient is the growth exponent at \
each radius, the volume-growth dimension: it tends to 2 on a planar lattice \
and to 3 on a cubic one. Applied to the shell areas it tends to one less."
}], "Notes",ExpressionUUID->"0900fce2-f1bf-4926-ba1f-91c9974b5f3d"],

Cell[TextData[{
 "The quotient is not constant on a finite graph. At small radius it carries \
the discretisation, and at large radius it falls as the ball meets the rim or \
wraps round. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DimensionCurvatureFit"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fcaff12b-17e7-4d42-a749-edc39adb32fe"],
 " regresses it on ",
 StyleBox["r(r + 1)", "TI"],
 " over a middle window to read the dimension and the curvature, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VolumeGrowthObservables"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "13c3dc4c-aa89-4545-99b7-e98dfb045dc9"],
 " chooses that window."
}], "Notes",ExpressionUUID->"f72f18ef-0178-46cf-93dc-5239a6f95e54"],

Cell[TextData[{
 StyleBox["w", "TI"],
 " may be any numeric sequence, or a sequence of ",
 Cell[BoxData["Around"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d2e761c-6c77-430c-90f0-404f1896f8e8"],
 " values; then the spread is carried into the quotients. The positions are \
fixed by the list, so a window of a profile starting at radius ",
 StyleBox["r0", "TI"],
 " is placed at 1, not at ",
 StyleBox["r0", "TI"],
 " + 1. ",
 Cell[BoxData["LogDifferenceQuotients"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c78ea99-8f88-466d-b562-eb050e6736fe"],
 " equals ",
 Cell[BoxData[
  RowBox[{"ResourceFunction", "[", "\"\<LogDifferences\>\"", "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d29d447-209e-493e-9cef-e4943566eafb"],
 "."
}], "Notes",ExpressionUUID->"eee21898-d2e8-4c9a-a92f-981d789004e9"]
}, Open  ]],

