Cell["\<\
The quotients of the ball volumes from radius 0 at the centre of the \
discretized plane, the square tiling and the hexagonal tiling, the curves of \
the technical introduction. All three approach 2, the dimension of the plane; \
the gray line.\
\>", "ExampleText",ExpressionUUID->"f4abc385-b83a-4ffb-815a-d069537f9f4c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"names", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
        ",", " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"ListLinePlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"gr", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"nm", ",", " ", "\"\<Large\>\""}], "]"}]}], "}"}], ",", 
         " ", 
         RowBox[{"LogDifferenceQuotients", " ", "@", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"InfraMeasurement", "[", 
             RowBox[{"gr", ",", " ", 
              RowBox[{"InfraBall", "[", 
               RowBox[{
                RowBox[{"InfraCenter", "[", "gr", "]"}], ",", " ", "r"}], 
               "]"}], ",", " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
            
            RowBox[{"{", 
             RowBox[{"r", ",", " ", "0", ",", " ", "12"}], "}"}]}], "]"}]}]}],
         "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"nm", ",", " ", "names"}], "}"}]}], "]"}], ",", "\n", "    ", 
     
     RowBox[{"DataRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "12"}], "}"}]}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", "names"}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<r\>\"", ",", " ", "\"\<q(r)\>\""}], "}"}]}], ",", "\n", 
     "    ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "Gray"}], "}"}], "}"}]}], "}"}]}], ",", " ", 
     
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "3.5"}], "}"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d06999e8-9575-4638-a162-2cc0af27ddd1"],

