Cell[TextData[{
 "A sequence of ",
 Cell[BoxData["Around"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f411f17-c497-437c-ada0-8187fbe90c73"],
 " values carries its spread into the quotients, drawn as error bars: here \
the mean ball-volume profile over five vertices near the centre of the \
discretized plane."
}], "ExampleText",ExpressionUUID->"52239fe6-95e2-412a-9c7f-64aea4fc7ab7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sampleSet", " ", "=", " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"FindInfraRepresentative", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{
           RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "2"}], "]"}]}], 
        "]"}], ",", " ", "5"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"quots", " ", "=", " ", 
     RowBox[{"LogDifferenceQuotients", "[", 
      RowBox[{"MeanAround", " ", "/@", " ", 
       RowBox[{"Transpose", " ", "@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraBall", "[", 
             RowBox[{"v", ",", " ", "r"}], "]"}], ",", 
            " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"v", ",", " ", "sampleSet"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "0", ",", " ", "8"}], "}"}]}], "]"}]}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{"quots", ",", " ", 
       RowBox[{"DataRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "8"}], "}"}]}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "3.5"}], "}"}]}], ",", " ", 
       RowBox[{"GridLines", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"None", ",", " ", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "Gray"}], "}"}], "}"}]}], "}"}]}], ",", 
       " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<r\>\"", ",", " ", "\"\<q(r)\>\""}], "}"}]}]}], "]"}], ",",
      " ", "quots"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"bf99e099-75eb-4b33-b191-15257e5771e2"],

