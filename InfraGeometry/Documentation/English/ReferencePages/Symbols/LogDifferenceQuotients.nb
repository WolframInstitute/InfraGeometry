Cell[TextData[{
 "A sequence of ",
 Cell[BoxData["Around"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "132f070d-21b9-4383-9274-a4c93ca79c88"],
 " values carries its spread into the quotients: here the mean ball-volume \
profile over five vertices near the centre of the discretized plane."
}], "ExampleText",ExpressionUUID->"da2bb00a-b348-4b05-9499-048dd1865c78"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sampleSet", " ", "=", " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"FindInfraBall", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
       " ", "5"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"LogDifferenceQuotients", "[", 
    RowBox[{"MeanAround", " ", "/@", " ", 
     RowBox[{"Transpose", " ", "@", " ", 
      RowBox[{"BallVolumes", "[", 
       RowBox[{"g", ",", " ", "sampleSet", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "5"}], "}"}]}], "]"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e2350ed9-33d8-4285-be28-5410233c6ac8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   InterpretationBox[
    TemplateBox[{"2.81", "0.09"},
     "Around"],
    Around[2.807354922057604, 0.09217040520655888]], ",", 
   InterpretationBox[
    TemplateBox[{"2.56", "0.21"},
     "Around"],
    Around[2.564392762416934, 0.2135831788136097]], ",", 
   InterpretationBox[
    TemplateBox[{"2.39", "0.24"},
     "Around"],
    Around[2.3918205008020794`, 0.23944551036007503`]], ",", 
   InterpretationBox[
    TemplateBox[{"2.31", "0.22"},
     "Around"],
    Around[2.311915010244285, 0.21981734827945695`]], ",", 
   InterpretationBox[
    TemplateBox[{"2.27", "0.25"},
     "Around"],
    Around[2.2680447038871714`, 0.24935825346789373`]]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0186c9c8-0966-4cfc-b4be-1f4e12605e3a"]
}, Open  ]]
}, Open  ]],

