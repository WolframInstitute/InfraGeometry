Notebook[{

Cell[CellGroupData[{
Cell["LogDifferenceQuotients", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"03467732-64f7-443e-a717-48fa052e8d0a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LogDifferenceQuotients"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/LogDifferenceQuotients", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["w", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64d235f7-6cd7-44e3-ac15-4616c0689b10"],
 "\[LineSeparator]",
 "gives the log-difference quotients {",
 StyleBox["q", "TI"],
 "(1), ",
 StyleBox["q", "TI"],
 "(2), \[Ellipsis]} of the sequence ",
 StyleBox["w", "TI"],
 " = {",
 StyleBox["w", "TI"],
 "(0), ",
 StyleBox["w", "TI"],
 "(1), \[Ellipsis]}.",
 "\n"
}], "Usage",ExpressionUUID->"5a0a0c97-34d9-4738-b442-f2a5c1d53791"],

Cell[TextData[{
 "The quotient is ",
 StyleBox["q(r) = (log w(r) \[Minus] log w(r \[Minus] 1)) / (log(r + 1) \
\[Minus] log r)", "TI"],
 ", the slope of ",
 StyleBox["w", "TI"],
 " on log-log axes between two consecutive positions. It is the discrete ",
 StyleBox["d log w / d log r", "TI"],
 "."
}], "Notes",ExpressionUUID->"76130073-ff83-4591-b4f0-589e0a277578"],

Cell[TextData[{
 "The ",
 StyleBox["i", "TI"],
 "-th entry of ",
 StyleBox["w", "TI"],
 ", counted from 1, sits at position ",
 StyleBox["i", "TI"],
 ". A sequence ",
 StyleBox["w(r) = (r + 1)\:1d48", "TI"],
 " has every quotient equal to ",
 StyleBox["d", "TI"],
 "."
}], "Notes",ExpressionUUID->"9c4223f3-677a-4665-92fe-c37d204da52d"],

Cell["\<\
Applied to the ball volumes about a vertex, the quotient is the growth \
exponent at each radius: it tends to the dimension, 2 on a planar graph. \
Applied to the shell sizes it tends to one less.\
\>", "Notes",ExpressionUUID->"715547f9-d031-4706-9728-6b3bd407e424"],

Cell[TextData[{
 "On a finite graph the quotient is not constant. At small radius it carries \
the discretization; once the ball meets the rim of the graph it falls. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DimensionCurvatureFit"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "db53bf5d-38fc-469a-bd48-54bc853efffe"],
 " reads the dimension and the curvature from a middle window, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VolumeGrowthObservables"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f0a6be0d-b33e-430e-9d17-7ac1ce4917ae"],
 " chooses the window."
}], "Notes",ExpressionUUID->"3a91ce82-8718-4874-b9e1-6c9199ff45ba"],

Cell[TextData[{
 "On the square grid the ball volume is ",
 StyleBox["2r\.b2 + 2r + 1", "TI"],
 ", and the quotient is ",
 StyleBox["2 + 1/r + O(1/r\.b2)", "TI"],
 ": it approaches 2 from above."
}], "Notes",ExpressionUUID->"0102b1b9-851a-4e4b-a676-25e19c0171b0"],

Cell[TextData[{
 StyleBox["w", "TI"],
 " may hold numbers or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Around"]], "paclet:ref/Around"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "168b182a-cfb6-4ebb-b90d-57781b88172a"],
 " values; the spread is carried into the quotients."
}], "Notes",ExpressionUUID->"5ab97e66-ad83-4a4f-a165-521f11bb877b"]
}, Open  ]],

