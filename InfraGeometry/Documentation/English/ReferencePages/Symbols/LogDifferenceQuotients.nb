Cell[TextData[{
 "A sequence indexed from 0 is placed from 1: the profile ",
 StyleBox["(r + 1)\.b2", "TI"],
 " has every quotient equal to 2."
}], "ExampleText",ExpressionUUID->"9728f05d-21c2-4fe7-be57-4e20888484ef"],

