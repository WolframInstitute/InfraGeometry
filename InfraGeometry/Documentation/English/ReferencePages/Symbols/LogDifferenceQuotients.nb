Cell[TextData[{
 "A sequence ",
 StyleBox["(r + 1)\.b2", "TI"],
 " has every quotient equal to 2:"
}], "ExampleText",ExpressionUUID->"69c34975-543e-4bc3-bc7c-f87f38847932"],

