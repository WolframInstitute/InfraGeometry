Notebook[{

Cell[CellGroupData[{
Cell["LogDifferenceQuotients", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"63273c74-463d-483b-8d83-7cb9b1e3edae"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LogDifferenceQuotients"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/LogDifferenceQuotients", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["w", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ca937d8-8334-4de6-b766-7355ca6e628a"],
 "\[LineSeparator]",
 "gives the log-difference quotients {",
 StyleBox["q", "TI"],
 "(1), ",
 StyleBox["q", "TI"],
 "(2), \[Ellipsis]} of the sequence ",
 StyleBox["w", "TI"],
 " = {",
 StyleBox["w", "TI"],
 "(0), ",
 StyleBox["w", "TI"],
 "(1), \[Ellipsis]}, where ",
 StyleBox["q", "TI"],
 "(",
 StyleBox["r", "TI"],
 ") = (log ",
 StyleBox["w", "TI"],
 "(",
 StyleBox["r", "TI"],
 ") \[Minus] log ",
 StyleBox["w", "TI"],
 "(",
 StyleBox["r", "TI"],
 " \[Minus] 1)) / (log(",
 StyleBox["r", "TI"],
 " + 1) \[Minus] log ",
 StyleBox["r", "TI"],
 ").",
 "\n"
}], "Usage",ExpressionUUID->"b72dc610-3393-4f08-aaed-fed8101e472a"],

Cell[TextData[{
 "Definition: ",
 StyleBox["q(r) = (log w(r) \[Minus] log w(r \[Minus] 1)) / (log(r + 1) \
\[Minus] log r)", "TI"],
 " for ",
 StyleBox["r", "TI"],
 " = 1, 2, \[Ellipsis], the slope of the sequence on log-log axes between two \
consecutive positions. Position ",
 StyleBox["i", "TI"],
 " of ",
 StyleBox["w", "TI"],
 ", counted from 1, is placed at ",
 StyleBox["i", "TI"],
 ": so a sequence growing like ",
 StyleBox["(r + 1)^d", "TI"],
 " has every quotient equal to ",
 StyleBox["d", "TI"],
 "."
}], "Notes",ExpressionUUID->"fd55834c-9b4c-4b9d-8ca3-d09b776f4338"],

Cell[TextData[{
 "It is the discrete ",
 StyleBox["d log w / d log r", "TI"],
 ". Applied to a ball-volume profile, the quotient is the growth exponent at \
each radius, the volume-growth dimension: it tends to 2 on a planar lattice \
and to 3 on a cubic one. Applied to the shell areas it tends to one less."
}], "Notes",ExpressionUUID->"2cf49a2c-27a1-4d3f-838e-47a21be628fb"],

Cell[TextData[{
 "Which radius a quotient is read at is a convention, and it moves the curve. \
A ball profile ",
 StyleBox["V(0), V(1), \[Ellipsis]", "TI"],
 " given from radius 0 has position ",
 StyleBox["i", "TI"],
 " at radius ",
 StyleBox["i \[Minus] 1", "TI"],
 ", so the quotient placed at ",
 StyleBox["r", "TI"],
 " is ",
 StyleBox["(log V(r) \[Minus] log V(r \[Minus] 1)) / (log(r + 1) \[Minus] log \
r)", "TI"],
 ": the quotient of the profile ",
 StyleBox["\[Rho] \[RightTeeArrow] V(\[Rho] \[Minus] 1)", "TI"],
 " at its own radius. On a lattice ",
 StyleBox["V(\[Rho] \[Minus] 1)", "TI"],
 " is the Riemannian measure of the ball of radius ",
 StyleBox["\[Rho]", "TI"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1d6f1126-1066-4575-9318-5a165c244ae7"],
 "), so this is the quotient of the ",
 Cell[BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1144a8c-60d6-437f-9931-b94cfb5e98ff"],
 " profile from radius 1, and it is the curve the Wolfram Physics technical \
introduction plots in section 4.5. The profile given from radius 1, ",
 StyleBox["V(1), V(2), \[Ellipsis]", "TI"],
 ", is the counting curve, each volume at its own radius."
}], "Notes",ExpressionUUID->"d790a001-9ce1-4b46-a0f7-c6c2a41f9ce0"],

Cell[TextData[{
 "The two curves part at the rate ",
 StyleBox["1/r", "TI"],
 ". For a polynomial profile of degree ",
 StyleBox["d", "TI"],
 " with leading coefficient ",
 StyleBox["c", "TI"],
 " and coefficient ",
 StyleBox["b", "TI"],
 " of ",
 StyleBox["r^(d\[Minus]1)", "TI"],
 ", ",
 StyleBox["q(r) = d \[Minus] (b/c)/r + O(1/r\.b2)", "TI"],
 ". For a ball count ",
 StyleBox["L(r)", "TI"],
 " of a lattice of dimension ",
 StyleBox["d", "TI"],
 ", the counting curve is ",
 StyleBox["d \[Minus] d/(2r) + O(1/r\.b2)", "TI"],
 " and the Riemannian curve, of ",
 StyleBox["L(r \[Minus] 1)", "TI"],
 ", is ",
 StyleBox["d + d/(2r) + O(1/r\.b2)", "TI"],
 ": one from below, one from above, with mean ",
 StyleBox["d + O(1/r\.b2)", "TI"],
 "."
}], "Notes",ExpressionUUID->"28138756-05c0-4b43-830c-3652d850905d"],

Cell[TextData[{
 "On a Riemannian manifold the ball's expansion ",
 StyleBox["\[Omega]_d r^d (1 \[Minus] Scal r\.b2 / (6(d + 2)))", "TI"],
 " makes the quotient affine in ",
 StyleBox["r(r + 1)", "TI"],
 ", with intercept ",
 StyleBox["d", "TI"],
 " and slope ",
 StyleBox["\[Minus]Scal / (3(d + 2))", "TI"],
 ", to first order in the curvature; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DimensionCurvatureFit"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "14ded751-5939-4898-ba71-28b08864b82d"],
 " fits that line."
}], "Notes",ExpressionUUID->"8d5b6fa1-413b-4d01-82c2-9858ed45a8e3"],

Cell[TextData[{
 "The quotient is not constant on a finite graph. At small radius it carries \
the discretisation, and at large radius it falls as the ball meets the rim or \
wraps round. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DimensionCurvatureFit"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "967577de-fabd-4608-b21a-a2d85dc94ab7"],
 " regresses it on ",
 StyleBox["r(r + 1)", "TI"],
 " over a middle window to read the dimension and the curvature, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VolumeGrowthObservables"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "868be801-a505-4c3b-b6f7-0f23e9572f26"],
 " chooses that window."
}], "Notes",ExpressionUUID->"79488d47-af91-4acc-a4c3-1429b9cebe07"],

Cell[TextData[{
 StyleBox["w", "TI"],
 " may be any numeric sequence, or a sequence of ",
 Cell[BoxData["Around"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58c3c8af-e336-4139-8a1d-58b397ff4bf9"],
 " values; then the spread is carried into the quotients. The positions are \
fixed by the list, so a window of a profile starting at radius ",
 StyleBox["r0", "TI"],
 " is placed at 1, not at ",
 StyleBox["r0", "TI"],
 " + 1. ",
 Cell[BoxData["LogDifferenceQuotients"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4455618d-0c5b-4ba9-9142-e65cb7de7e85"],
 " equals ",
 Cell[BoxData[
  RowBox[{"ResourceFunction", "[", "\"\<LogDifferences\>\"", "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79d30d22-3980-43c1-9382-350381914143"],
 "."
}], "Notes",ExpressionUUID->"e0ca31ab-745f-488c-be70-9e3107dc7473"]
}, Open  ]],

