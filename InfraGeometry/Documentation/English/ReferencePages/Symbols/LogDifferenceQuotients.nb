Cell[TextData[{
 "A sequence of ",
 Cell[BoxData["Around"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58945185-2eb1-4e1d-9407-5462817e1948"],
 " values carries its spread into the quotients, drawn as error bars: here \
the mean ball-volume profile over five vertices near the centre of the \
discretized plane."
}], "ExampleText",ExpressionUUID->"63a955a3-e7ad-4f51-838e-646906092a15"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sampleSet", " ", "=", " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"FindInfraRepresentative", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{
           RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "2"}], "]"}]}], 
        "]"}], ",", " ", "5"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"quots", " ", "=", " ", 
     RowBox[{"LogDifferenceQuotients", "[", 
      RowBox[{"MeanAround", " ", "/@", " ", 
       RowBox[{"Transpose", " ", "@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraBall", "[", 
             RowBox[{"v", ",", " ", "r"}], "]"}], ",", 
            " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"v", ",", " ", "sampleSet"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "0", ",", " ", "8"}], "}"}]}], "]"}]}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{"quots", ",", " ", 
       RowBox[{"DataRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "8"}], "}"}]}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "3.5"}], "}"}]}], ",", " ", 
       RowBox[{"GridLines", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"None", ",", " ", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "Gray"}], "}"}], "}"}]}], "}"}]}], ",", 
       " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<r\>\"", ",", " ", "\"\<q(r)\>\""}], "}"}]}]}], "]"}], ",",
      " ", "quots"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6d19828a-89f4-4b04-a7ac-baa98996fbc5"],

