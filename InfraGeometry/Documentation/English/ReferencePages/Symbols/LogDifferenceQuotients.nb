Cell["\<\
The quotients of the ball volumes at the centre of the discretized plane, the \
square tiling and the hexagonal tiling. All three approach 2, the dimension \
of the plane; the gray line.\
\>", "ExampleText",ExpressionUUID->"89fd910c-a690-4953-87b0-40c3644f70c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"names", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<SquareTilingGraph\>\"",
        ",", " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"ListLinePlot", "[", "\n", "    ", 
    RowBox[{
