Cell[TextData[{
 "The counting curve and the Riemannian curve of the balls about the centre \
of the large square tiling, as points, against ",
 StyleBox["2 \[Minus] 1/r", "TI"],
 " and ",
 StyleBox["2 + 1/r", "TI"],
 ", as curves. The Riemannian curve is also the quotient of the counting \
profile given from radius 0."
}], "ExampleText",ExpressionUUID->"2a95911c-acc6-4440-917a-d9bbfdbda5a9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Large\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"counting", " ", "=", " ", 
     RowBox[{"LogDifferenceQuotients", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
          " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r", ",", " ", "1", ",", " ", "13"}], "}"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"riemannian", " ", "=", " ", 
     RowBox[{"LogDifferenceQuotients", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
          " ", "\"\<RiemannianMeasure\>\""}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r", ",", " ", "1", ",", " ", "13"}], "}"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"shifted", " ", "=", " ", 
     RowBox[{"LogDifferenceQuotients", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
          " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r", ",", " ", "0", ",", " ", "12"}], "}"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Show", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", " ", "-", " ", 
            RowBox[{"1", "/", "r"}]}], ",", " ", 
           RowBox[{"2", " ", "+", " ", 
            RowBox[{"1", "/", "r"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "1", ",", " ", "12"}], "}"}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "3"}], "}"}]}]}], "]"}], ",", "\n", "     ", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"counting", ",", " ", "riemannian"}], "}"}], ",", " ", 
         RowBox[{"DataRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "12"}], "}"}]}], ",", " ", 
         RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}]}], "]"}], ",", 
       "\n", "     ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<r\>\"", ",", " ", "\"\<q(r)\>\""}], "}"}]}], ",", " ", 
       RowBox[{"GridLines", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"None", ",", " ", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "Gray"}], "}"}], "}"}]}], "}"}]}]}], "]"}],
      ",", "\n", "   ", 
     RowBox[{"riemannian", " ", "==", " ", "shifted"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"693b8a86-2396-4117-978c-db42e3084877"],

