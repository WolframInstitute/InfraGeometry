Cell["\<\
The positions come from the list, not from the radii. The same ball volumes \
of the grid, taken from radius 0 and from radius 1, give different quotients:\
\
\>", "ExampleText",ExpressionUUID->"0981d031-20e8-455d-964f-4e1d284a1d74"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"volumes", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
         " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "8"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"LogDifferenceQuotients", "[", "volumes", "]"}], ",", " ", 
       RowBox[{"LogDifferenceQuotients", "[", 
        RowBox[{"Rest", " ", "@", " ", "volumes"}], "]"}]}], "}"}], ",", " ", 
     
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", "    ", 
     
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<from radius 0\>\"", ",", " ", "\"\<from radius 1\>\""}], 
       "}"}]}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", "2", "}"}]}], "}"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0cb21680-e908-49fe-abeb-162b94d9ac22"],

