Notebook[{

Cell[CellGroupData[{
Cell["LogDifferenceQuotients", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"17ad8268-c0a0-434e-8b01-a34d34a08bf2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LogDifferenceQuotients"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/LogDifferenceQuotients", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["w", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "afd33b15-680b-48de-b5a5-a75f16001e99"],
 "\[LineSeparator]",
 "gives the log-difference quotients {",
 StyleBox["q", "TI"],
 "(1), ",
 StyleBox["q", "TI"],
 "(2), \[Ellipsis]} of the sequence ",
 StyleBox["w", "TI"],
 " = {",
 StyleBox["w", "TI"],
 "(0), ",
 StyleBox["w", "TI"],
 "(1), \[Ellipsis]}.",
 "\n"
}], "Usage",ExpressionUUID->"e8db3614-345d-4d52-80d6-87bf9a37896a"],

Cell[TextData[{
 "The quotient is ",
 StyleBox["q(r) = (log w(r) \[Minus] log w(r \[Minus] 1)) / (log(r + 1) \
\[Minus] log r)", "TI"],
 ", the slope of ",
 StyleBox["w", "TI"],
 " on log-log axes between two consecutive positions. It is the discrete ",
 StyleBox["d log w / d log r", "TI"],
 "."
}], "Notes",ExpressionUUID->"31df1130-a28f-4bee-905e-6adbabd69902"],

Cell[TextData[{
 "The ",
 StyleBox["i", "TI"],
 "-th entry of ",
 StyleBox["w", "TI"],
 ", counted from 1, sits at position ",
 StyleBox["i", "TI"],
 ". A sequence ",
 StyleBox["w(r) = (r + 1)\:1d48", "TI"],
 " has every quotient equal to ",
 StyleBox["d", "TI"],
 "."
}], "Notes",ExpressionUUID->"5e0524e8-663d-430a-87fe-5e739e21ab5b"],

Cell["\<\
Applied to the ball volumes about a vertex, the quotient is the growth \
exponent at each radius: it tends to the dimension, 2 on a planar graph. \
Applied to the shell sizes it tends to one less.\
\>", "Notes",ExpressionUUID->"a37f1b04-37c9-4b5c-b377-0bc3787dd6a6"],

Cell[TextData[{
 "On a finite graph the quotient is not constant. At small radius it carries \
the discretization; once the ball meets the rim of the graph it falls. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DimensionCurvatureFit"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c84bd278-9dd6-4511-8c9f-f10c0a32591a"],
 " reads the dimension and the curvature from a middle window, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VolumeGrowthObservables"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3cbe3483-d0cc-437f-81c0-ddc006e13986"],
 " chooses the window."
}], "Notes",ExpressionUUID->"8ee6ed13-d3ac-4723-8d9c-61f3356492bb"],

Cell[TextData[{
 "On the square grid the ball volume is ",
 StyleBox["2r\.b2 + 2r + 1", "TI"],
 ", and the quotient is ",
 StyleBox["2 + 1/r + O(1/r\.b2)", "TI"],
 ": it approaches 2 from above."
}], "Notes",ExpressionUUID->"8ef5112c-dcc0-4a99-8e0f-0e66384a8d3d"],

Cell[TextData[{
 StyleBox["w", "TI"],
 " may hold numbers or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Around"]], "paclet:ref/Around"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "047fc0e4-b093-4c8f-8fb9-f80ad8ea1b3b"],
 " values; the spread is carried into the quotients."
}], "Notes",ExpressionUUID->"1d7f1637-b783-4c93-8988-daf73d1bc503"]
}, Open  ]],

