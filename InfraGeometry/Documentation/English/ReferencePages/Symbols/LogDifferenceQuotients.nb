Cell["\<\
The quotients of the shell areas of a planar lattice tend to 1, one less than \
those of the volumes.\
\>", "ExampleText",ExpressionUUID->"6277fc27-9208-4ec9-b69b-63227efa2f4e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Large\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ctr", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Last", " ", "@", " ", 
      RowBox[{"LogDifferenceQuotients", " ", "@", " ", 
       RowBox[{"BallVolumes", "[", 
        RowBox[{"g", ",", " ", "ctr", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "12"}], "}"}]}], "]"}]}]}], ",", "\n", "   ", 
     RowBox[{"Last", " ", "@", " ", 
      RowBox[{"LogDifferenceQuotients", " ", "@", " ", 
       RowBox[{"ShellAreas", "[", 
        RowBox[{"g", ",", " ", "ctr", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "12"}], "}"}]}], "]"}]}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c71b4d8d-5fe6-4714-9023-1ef23ab9ce6c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2.079806760572272`", ",", "1.`"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"540a043a-cbc6-445c-af62-75a543ed7ecf"]
}, Open  ]],

Cell[TextData[{
 "A sequence indexed from 0 is placed from 1: the profile ",
 StyleBox["(r + 1)\.b2", "TI"],
 " has every quotient equal to 2."
}], "ExampleText",ExpressionUUID->"816f479b-7162-4936-81de-9ce03dbd7396"],

