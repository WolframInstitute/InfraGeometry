Cell[TextData[{
 "The ball volumes of the square grid, ",
 StyleBox["2r\.b2 + 2r + 1", "TI"],
 ", give quotients above 2, close to ",
 StyleBox["2 + 1/r", "TI"],
 " at large ",
 StyleBox["r", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"d020534b-fb3b-4117-83bd-504e4ea381ca"],

