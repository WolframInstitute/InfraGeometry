Cell[TextData[{
 "A sequence ",
 StyleBox["(r + 1)\.b2", "TI"],
 " has every quotient equal to 2:"
}], "ExampleText",ExpressionUUID->"6c23b005-b49f-4e80-9b30-c51080543c74"],

