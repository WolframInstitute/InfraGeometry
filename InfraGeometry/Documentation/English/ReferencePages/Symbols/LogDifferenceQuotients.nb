Cell[TextData[{
 "The ball volumes of the square grid, ",
 StyleBox["2r\.b2 + 2r + 1", "TI"],
 ", give quotients above 2, close to ",
 StyleBox["2 + 1/r", "TI"],
 " at large ",
 StyleBox["r", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"4d61f6df-2c1d-40ab-8249-ef3576a229a2"],

