Cell[TextData[{
 "A covector at ",
 StyleBox["p", "TI"],
 " is a ray arriving at ",
 StyleBox["p", "TI"],
 ", the reversal of a ray leaving ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"a656ea0d-0f21-459b-b370-3e00cc8ea307"],

Cell["\<\
The total graph is the tangent total graph with every ray reversed; only the \
projection differs.\
\>", "Notes",ExpressionUUID->"af791c08-d76c-4e1f-8e86-eedd01f1b626"]
}, Open  ]],

