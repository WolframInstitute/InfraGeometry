Cell["\<\
The reversal is a bundle morphism from the tangent bundle to the cotangent \
bundle.\
\>", "ExampleText",ExpressionUUID->"7f60fd8c-329f-483e-a677-f83827647cfd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraBundleMorphismQ", "[", 
    RowBox[{
     RowBox[{"InfraTangentBundle", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"InfraCotangentBundle", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", "Reverse"}], "]"}]}], 
  "]"}]], "Input",
