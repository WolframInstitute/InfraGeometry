Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"822f39b0-e412-4985-9a55-0c177e7f5f6e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCotangentBundle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCotangentBundle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d079fab1-0e4c-470d-8514-eebdf6b5e9b9"],
 "\[LineSeparator]",
 "is the cotangent bundle of ",
 StyleBox["g", "TI"],
 " at scale ",
 StyleBox["r", "TI"],
 ": the total vertices are the reversed rays of length ",
 StyleBox["r", "TI"],
 ", projected to their last vertex, with the adjacency of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTangentBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTangentBundle", 
