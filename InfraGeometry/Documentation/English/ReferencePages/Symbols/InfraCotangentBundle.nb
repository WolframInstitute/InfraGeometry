     RowBox[{"InfraTangentBundle", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"InfraCotangentBundle", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", "Reverse"}], "]"}]}], 
