}], "Usage",ExpressionUUID->"bf63ff1a-156a-4636-8d60-146513c4c9f6"],

Cell[TextData[{
 "A covector at ",
 StyleBox["p", "TI"],
 " is a ray arriving at ",
 StyleBox["p", "TI"],
 ", the reversal of a ray leaving ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"d273bd86-e8da-454b-9876-4f9c05fb084d"],

Cell["\<\
The total graph is the tangent total graph with every ray reversed; only the \
projection differs.\
\>", "Notes",ExpressionUUID->"6cf170c2-ebfd-4998-8c7e-03f30e2a1a62"]
}, Open  ]],

