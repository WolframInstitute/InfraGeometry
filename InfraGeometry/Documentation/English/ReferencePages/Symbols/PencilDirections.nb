Cell[CellGroupData[{
Cell["PencilDirections", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"08ff2e47-1c67-4c87-af58-2e4e57746f66"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PencilDirections"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/PencilDirections", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd857cf1-57a7-402c-a253-6bf40bee0365"],
 "\[LineSeparator]",
 "gives the pencil at ",
 StyleBox["O", "TI"],
 ": every ray from ",
 StyleBox["O", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ", as a list of vertex sequences.",
 "\n"
}], "Usage",ExpressionUUID->"279b2228-53e4-49f2-94f7-0b77e4d1f5bf"],

Cell[TextData[{
 "The pencil at a vertex ",
 StyleBox["O", "TI"],
 " is the set of rays from ",
 StyleBox["O", "TI"],
 " \[LongDash] the graph's analogue of the unit tangent sphere, one element \
per direction. A ray leaves ",
 StyleBox["O", "TI"],
 " through exactly one neighbour, so the pencil is the union of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["w", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "616c2e54-5f7b-4b1f-8a03-7d27a354d94b"],
 " over the neighbours ",
 StyleBox["w", "TI"],
 " of ",
 StyleBox["O", "TI"],
 ". It is computed as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d872fdff-0ec2-43c0-9488-6320efe6b76c"],
 ", the rays from ",
 StyleBox["O", "TI"],
 " with ",
 StyleBox["O", "TI"],
 " as its own direction."
}], "Notes",ExpressionUUID->"e5bc6906-0c55-4d1b-b771-4dbea14e85ad"],

Cell[TextData[{
 "Every element starts at ",
 StyleBox["O", "TI"],
 " and satisfies ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRayQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6c04091e-97c9-48b6-a4b3-2103eb39e029"],
 ". Opposite rays are distinct elements; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SameDirectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SameDirectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "527848c9-57fd-4cfb-a624-a99aecbfd540"],
 " is the predicate that identifies them."
}], "Notes",ExpressionUUID->"3caaa86b-0c3f-457b-aa5a-99f3fec09540"],

Cell[TextData[{
 "There is no pencil object. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PencilCardinality"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/PencilCardinality", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a9d37872-55d7-4760-8857-7eaf1f616f0b"],
 " gives the size of the pencil without enumerating it."
}], "Notes",ExpressionUUID->"504f902c-7374-44fc-bfdd-c840c5f49197"]
}, Open  ]],

