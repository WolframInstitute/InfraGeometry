Cell[TextData[{
 "Every element of the pencil starts at ",
 StyleBox["O", "TI"],
 " and is a ray."
}], "ExampleText",ExpressionUUID->"9c38978d-ba03-4807-b68b-db894627facd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"PencilDirections", "[", 
      RowBox[{"g", ",", " ", "5"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"First", "[", "#", "]"}], " ", "===", " ", "5"}], " ", "&&", 
       " ", 
       RowBox[{"InfraRayQ", "[", 
        RowBox[{"g", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"abbd5e93-4971-439d-b4aa-ca7b8ee2d27b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"fa806e8b-db2c-48f7-8a82-64fc801938d4"]
}, Open  ]],

