Cell["\<\
The pencil at the middle of a path has two rays, one to each leaf.\
\>", "ExampleText",ExpressionUUID->"9a6dc87a-5709-4160-9868-441d20bb0da7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PencilDirections", "[", 
  RowBox[{
   RowBox[{"PathGraph", "[", 
    RowBox[{"Range", "[", "7", "]"}], "]"}], ",", " ", "4"}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"86842f8c-2065-4207-90b0-c0e9e5677a0a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", "3", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "5", ",", "6", ",", "7"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"305a964d-4adc-4ed3-a4cd-fed9e3759422"]
}, Open  ]],

Cell["On the 6-cycle both rays from 1 end at the antipode.", "ExampleText",ExpressionUUID->"a9babc08-1356-49c5-b195-cb24a9882b70"],

