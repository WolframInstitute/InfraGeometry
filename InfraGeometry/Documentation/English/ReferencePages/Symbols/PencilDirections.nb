Cell["\<\
The pencil at the middle of a path has two rays, one to each leaf.\
\>", "ExampleText",ExpressionUUID->"cf8ece02-515b-410e-977e-6f65ced4485a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PencilDirections", "[", 
  RowBox[{
   RowBox[{"PathGraph", "[", 
    RowBox[{"Range", "[", "7", "]"}], "]"}], ",", " ", "4"}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"359c834a-31cf-43c7-a5de-3bd4743c7ce8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", "3", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "5", ",", "6", ",", "7"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b6ceb5f1-0bce-4262-a504-1941f0db5291"]
}, Open  ]],

Cell["On the 6-cycle both rays from 1 end at the antipode.", "ExampleText",ExpressionUUID->"61727f36-cc66-4d8d-9e60-ccda94e130a4"],

