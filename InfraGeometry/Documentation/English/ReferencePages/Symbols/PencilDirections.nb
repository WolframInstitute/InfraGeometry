Cell[TextData[{
 "Every element of the pencil starts at ",
 StyleBox["O", "TI"],
 " and is a ray."
}], "ExampleText",ExpressionUUID->"237eb89e-d6d7-493f-8fa6-4b1dd920ff14"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"PencilDirections", "[", 
      RowBox[{"g", ",", " ", "5"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"First", "[", "#", "]"}], " ", "===", " ", "5"}], " ", "&&", 
       " ", 
       RowBox[{"InfraRayQ", "[", 
        RowBox[{"g", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"df4e9078-5091-41f1-8477-83befa0d82bc"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9af4216a-508c-4c57-92bb-9097d97fd3b4"]
}, Open  ]],

