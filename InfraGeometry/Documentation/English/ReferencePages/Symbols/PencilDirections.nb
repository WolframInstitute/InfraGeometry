Notebook[{

Cell[CellGroupData[{
Cell["PencilDirections", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"def4f7ea-72b5-4d83-a3c7-aed7dcf121b5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PencilDirections"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/PencilDirections", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee3aa6df-bcd9-4387-88cf-77c7256c6199"],
 "\[LineSeparator]",
 "gives the pencil at ",
 StyleBox["O", "TI"],
 ": every ray from ",
 StyleBox["O", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ", as a list of vertex sequences.",
 "\n"
}], "Usage",ExpressionUUID->"f34e05b6-e434-489a-a196-c929110f11ea"],

Cell[TextData[{
 "The pencil at a vertex ",
 StyleBox["O", "TI"],
 " is the set of rays from ",
 StyleBox["O", "TI"],
 " \[LongDash] the graph's analogue of the unit tangent sphere, one element \
per direction. A ray leaves ",
 StyleBox["O", "TI"],
 " through exactly one neighbour, so the pencil is the union of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["w", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4bb3136-562d-4597-8be8-830e4d63684d"],
 " over the neighbours ",
 StyleBox["w", "TI"],
 " of ",
 StyleBox["O", "TI"],
 ". It is computed as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f365a789-0d80-4b8f-a0bc-5852b037fa06"],
 ", the rays from ",
 StyleBox["O", "TI"],
 " with ",
 StyleBox["O", "TI"],
 " as its own direction."
}], "Notes",ExpressionUUID->"68da158b-0dc2-4fe8-92ec-81e41a790fa0"],

Cell[TextData[{
 "Every element starts at ",
 StyleBox["O", "TI"],
 " and satisfies ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRayQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3ce49db0-874e-4c92-9599-0fd8fef17692"],
 ". Opposite rays are distinct elements; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SameDirectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SameDirectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "483a867d-401a-4c9f-a092-c755f9638600"],
 " is the predicate that identifies them."
}], "Notes",ExpressionUUID->"336125c3-a8dd-4b83-a8af-554342106dfc"],

Cell[TextData[{
 "There is no pencil object. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PencilCardinality"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/PencilCardinality", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "40c86e62-f207-4335-8388-c7ed0b8f07b2"],
 " gives the size of the pencil without enumerating it."
}], "Notes",ExpressionUUID->"6a33d511-da9b-4e67-9a75-e30ea2b60074"]
}, Open  ]],

