Notebook[{

Cell[CellGroupData[{
Cell["PencilDirections", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"69c10b04-a1b6-4822-8df5-40e8eae22d26"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PencilDirections"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/PencilDirections", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cdbaae3-aab5-491b-adfd-ecb28adbd772"],
 "\[LineSeparator]",
 "gives the pencil at ",
 StyleBox["O", "TI"],
 ": every ray from ",
 StyleBox["O", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ", as a list of vertex sequences.",
 "\n"
}], "Usage",ExpressionUUID->"6ce004d1-1074-410b-8f31-340ab22d4322"],

Cell[TextData[{
 "The pencil at a vertex ",
 StyleBox["O", "TI"],
 " is the set of rays from ",
 StyleBox["O", "TI"],
 " \[LongDash] the graph's analogue of the unit tangent sphere, one element \
per direction. A ray leaves ",
 StyleBox["O", "TI"],
 " through exactly one neighbour, so the pencil is the union of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["w", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aac032e6-e7e3-4601-9c1c-d62cd1ae47f8"],
 " over the neighbours ",
 StyleBox["w", "TI"],
 " of ",
 StyleBox["O", "TI"],
 ". It is computed as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04aef9c8-df87-4519-8bc3-353d58e4ac19"],
 ", the rays from ",
 StyleBox["O", "TI"],
 " with ",
 StyleBox["O", "TI"],
 " as its own direction."
}], "Notes",ExpressionUUID->"5c5761e1-6aae-4156-90db-84a46d3a45fe"],

Cell[TextData[{
 "Every element starts at ",
 StyleBox["O", "TI"],
 " and satisfies ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRayQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9e51fbe1-d7d0-439c-9003-d12e53bd422f"],
 ". Opposite rays are distinct elements; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SameDirectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SameDirectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "93be62dc-752c-47e7-bc41-6af84b7a237b"],
 " is the predicate that identifies them."
}], "Notes",ExpressionUUID->"31de131d-653d-45ba-a3d7-83304558bc92"],

Cell[TextData[{
 "There is no pencil object. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PencilCardinality"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/PencilCardinality", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c4bfd7d4-0131-4fb6-84d8-42a581f346cf"],
 " gives the size of the pencil without enumerating it."
}], "Notes",ExpressionUUID->"4f6c373c-6241-47da-9330-a9d8b5ac3252"]
}, Open  ]],

