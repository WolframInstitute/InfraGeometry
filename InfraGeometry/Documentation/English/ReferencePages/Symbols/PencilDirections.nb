Notebook[{

Cell[CellGroupData[{
Cell["PencilDirections", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a6c0c3ef-71c7-483a-9e61-3c4a816be65e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PencilDirections"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/PencilDirections", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "000ab30b-8c85-400a-b780-fad59d08ab6e"],
 "\[LineSeparator]",
 "gives the pencil at ",
 StyleBox["O", "TI"],
 ": every ray from ",
 StyleBox["O", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ", as a list of vertex sequences.",
 "\n"
}], "Usage",ExpressionUUID->"f4d5f977-f698-4914-a34a-58d331c4f5f9"],

Cell[TextData[{
 "The pencil at a vertex ",
 StyleBox["O", "TI"],
 " is the set of rays from ",
 StyleBox["O", "TI"],
 " \[LongDash] the graph's analogue of the unit tangent sphere, one element \
per direction. A ray leaves ",
 StyleBox["O", "TI"],
 " through exactly one neighbour, so the pencil is the union of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["w", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06206e7b-d98a-42bc-8f0e-da5576138ecc"],
 " over the neighbours ",
 StyleBox["w", "TI"],
 " of ",
 StyleBox["O", "TI"],
 ". It is computed as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRay", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d12725d4-2c6a-482c-8946-d44452a63629"],
 ", the rays from ",
 StyleBox["O", "TI"],
 " with ",
 StyleBox["O", "TI"],
 " as its own direction."
}], "Notes",ExpressionUUID->"cd8761a5-c5ce-4f58-9da7-650ca9b60d52"],

Cell[TextData[{
 "Every element starts at ",
 StyleBox["O", "TI"],
 " and satisfies ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRayQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraRayQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b6b8b4bd-56a3-4775-9865-d4a4f8203fdb"],
 ". Opposite rays are distinct elements; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SameDirectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SameDirectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "70d6967b-6e21-4b08-a4e8-37ef9aaadb95"],
 " is the predicate that identifies them."
}], "Notes",ExpressionUUID->"4ee08c2f-1b33-43ed-b192-7d3f6f2546b0"],

Cell[TextData[{
 "There is no pencil object. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PencilCardinality"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/PencilCardinality", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3713b6e8-373f-425b-a6a5-b7d4429b63fe"],
 " gives the size of the pencil without enumerating it."
}], "Notes",ExpressionUUID->"87bebb44-68fb-4a1b-a031-a9ee7e2dbd37"]
}, Open  ]],

