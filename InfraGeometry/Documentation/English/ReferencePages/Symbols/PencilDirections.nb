Cell["\<\
The pencil at the middle of a path has two rays, one to each leaf.\
\>", "ExampleText",ExpressionUUID->"4dad82f2-0306-403b-ac72-e091fd9861e7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PencilDirections", "[", 
  RowBox[{
   RowBox[{"PathGraph", "[", 
    RowBox[{"Range", "[", "7", "]"}], "]"}], ",", " ", "4"}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"8cdc430f-8f7d-4473-8443-8157b5f6e22c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", "3", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "5", ",", "6", ",", "7"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"651e7765-243a-40ef-be71-1e04668b8bc6"]
}, Open  ]],

Cell["On the 6-cycle both rays from 1 end at the antipode.", "ExampleText",ExpressionUUID->"6fda6a7e-93cf-4899-a64e-922b89ab406b"],

