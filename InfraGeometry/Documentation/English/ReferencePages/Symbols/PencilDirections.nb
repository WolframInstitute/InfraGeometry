Cell["\<\
The pencil at the middle of a path has two rays, one to each leaf.\
\>", "ExampleText",ExpressionUUID->"3d20ac93-687f-4608-9c2d-419628f12682"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PencilDirections", "[", 
  RowBox[{
   RowBox[{"PathGraph", "[", 
    RowBox[{"Range", "[", "7", "]"}], "]"}], ",", " ", "4"}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"df01e123-e54f-4608-a632-6ac3cf2b0cec"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", "3", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "5", ",", "6", ",", "7"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e596ad96-d6f1-4475-9610-da45432b00dc"]
}, Open  ]],

Cell["On the 6-cycle both rays from 1 end at the antipode.", "ExampleText",ExpressionUUID->"6338c049-cbc0-47dd-b866-0814702fbfa7"],

