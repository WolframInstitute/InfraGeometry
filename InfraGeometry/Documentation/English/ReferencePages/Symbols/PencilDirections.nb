Cell[TextData[{
 "Every element of the pencil starts at ",
 StyleBox["O", "TI"],
 " and is a ray."
}], "ExampleText",ExpressionUUID->"e770b937-59fc-4ee5-96ce-949f9dde1e65"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"PencilDirections", "[", 
      RowBox[{"g", ",", " ", "5"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"First", "[", "#", "]"}], " ", "===", " ", "5"}], " ", "&&", 
       " ", 
       RowBox[{"InfraRayQ", "[", 
        RowBox[{"g", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"229b0785-7e9f-4e65-ae7b-28a67868148d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a6be7f4a-c2a7-4d3d-bf8f-9367a5c05ed2"]
}, Open  ]],

