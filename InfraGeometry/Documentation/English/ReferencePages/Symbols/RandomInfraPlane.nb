Cell[CellGroupData[{
Cell["RandomInfraPlane", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell["LLM generated.", "Notes",ExpressionUUID->"c232dfa9-3578-47f0-87e9-fb3d908ff7da"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"82275037-fa33-42f6-a3a3-81b07d867a89"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraPlane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraPlane", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraPlane", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01857967-1049-43db-ba79-3d2931e6e797"],
 "\[LineSeparator]",
 "samples an inclusion-minimal separating vertex set on graph ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"58437873-7ff5-4309-bf5b-835e096a83a6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraPlane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraPlane", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraPlane", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93942054-6640-48d1-baeb-512e0574d638"],
 "\[LineSeparator]",
 "requests ",
 Cell[BoxData["count"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc5a90d0-4aa8-4e42-968d-9cabfe601633"],
 " representatives. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8002c04f-cc03-4561-8e83-6aa6b2b7f535"],
 " enumerates the full pool; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2077d8ff-2a69-4c1e-8173-f5d7ae5f17ca"],
 " returns at most ",
 StyleBox["n", "TI"],
 "."
}], "Usage",ExpressionUUID->"1870e08d-d499-40b8-93ae-2f8f408f0935"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomInfraPlane", "[", 
   RowBox[{"g", ",", " ", "p", ",", " ", "q", ",", " ", "count"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "954d275b-d9c6-468d-8984-b7ac2d6aa099"],
 " uses the direct form. The omitted window is ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", "0"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fd2a2a3-492e-45ec-bb63-52e4e0a8d837"],
 ". Plane sampling fixes ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "\"\<Separating\>\"", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f01e6559-002f-46bb-8af5-0db4d848cf03"],
 "; legacy rules inside the token are accepted and ignored."
}], "Notes",ExpressionUUID->"0f3d11e3-5678-4047-86ca-2fa55631f2d0"],

Cell[TextData[{
 "The sampler has the same token geometry as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPlane"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPlane", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "af79cc80-4b12-4afc-8924-0431ddb21f9d"],
 ". An omitted or ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7327d86-0662-47b7-a6da-68f0bea7d420"],
 " count returns one representative. An integer count requests exactly that \
many distinct representatives and returns ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb936a60-e146-47b3-aa8b-453996ae6abc"],
 " when too few exist."
}], "Notes",ExpressionUUID->"eb3df54f-7039-4ff6-8c90-b62c28eb684d"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0b7477a-8c12-42bd-a5a8-532c95924b11"],
 " selects deterministically. Default ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "661763c8-c4be-40d5-b515-b7bcec2de09b"],
 " does not advance random state. Seed an ordinary draw with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "effaaadc-5464-4da5-baab-4e40db172d95"],
 "."
}], "Notes",ExpressionUUID->"17f3f3ea-3358-4126-850a-d0c4c4209bb7"],

