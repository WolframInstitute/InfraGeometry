Cell["RandomInfraPlane", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"59fd9611-1808-4d9e-88b2-46766fa73095"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraPlane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraPlane", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraPlane", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f3f04e5-36a5-4d6a-b706-cc9b78c27628"],
 "\[LineSeparator]",
 "gives a random plane bisecting ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ", as a vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"aced9763-3951-4977-b652-7704f21016a0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraPlane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraPlane", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraPlane", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["lo", "TI"], ",", " ", 
        StyleBox["hi", "TI"]}], "}"}]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "932254bb-ba3f-40ec-97ca-09b3bf0872d0"],
 "\[LineSeparator]",
 "takes the plane inside the slab of distance differences ",
 StyleBox["lo", "TI"],
 " to ",
 StyleBox["hi", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b5ca9860-5aa5-4188-9b9d-a1e2bcac1462"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraPlane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraPlane", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["plane", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "611ad105-ebaa-4b30-a1af-847ae8149fbd"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " distinct planes.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6168d691-5454-47d4-9173-ab3a6fdfc9bb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraPlane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraPlane", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fee3e0b0-6c45-480f-848e-474ec74b0d5e"],
 "\[LineSeparator]",
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraPlane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraPlane", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["lo", "TI"], ",", " ", 
      StyleBox["hi", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed614642-3016-4a8a-80e4-b09b402f9d0a"],
 " and the same with a count ",
 StyleBox["n", "TI"],
 " give the plane with the points given directly."
}], "Usage",ExpressionUUID->"91d9a747-5a26-4bb8-9c8c-1e3578369614"],

Cell[TextData[{
 "The slab is ",
 StyleBox["B = {v : lo \[LessEqual] d(p, v) \[Minus] d(q, v) \[LessEqual] \
hi}", "TI"],
 " without ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 "; the default is {0, 0}, the equidistant set. A plane is an \
inclusion-minimal subset of ",
 StyleBox["B", "TI"],
 " that separates ",
 StyleBox["p", "TI"],
 " from ",
 StyleBox["q", "TI"],
 ": every path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " meets it, and no smaller subset does that."
}], "Notes",ExpressionUUID->"85c71a76-ac27-4422-b8b1-35bb9d3cdffa"],

Cell["\<\
The slab can be thick. On the square grid the equidistant set of a diagonal \
pair contains two quadrants, and a plane is a thin wall inside it. For an \
axis pair the equidistant set is a line, and the plane is that line.\
\>", "Notes",ExpressionUUID->"0bf76e28-1117-4709-9445-06e545707781"],

Cell[TextData[{
 "On a bipartite graph ",
 StyleBox["d(p, v) \[Minus] d(q, v)", "TI"],
 " has the parity of ",
 StyleBox["d(p, q)", "TI"],
 ". On the square grid the equidistant set of two points at odd distance is \
empty, and {\[Minus]1, 1} is the same slab as {0, 0} at even distance. On the \
mesh the equidistant set need not separate; the slab {\[Minus]1, 1} can."
}], "Notes",ExpressionUUID->"ff80f9fc-4494-4115-97a0-1bc60ce0a878"],

Cell["Adjacent points have no plane: no vertex set separates them.", "Notes",ExpressionUUID->"678b7e8a-60b8-4d97-8736-ad13c8f37359"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3e0e4dd-58b7-473d-9fb3-7451ee571135"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60a90fc3-2f6c-4285-91b2-d2c03b4c4e57"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "881586bd-3e9a-4c8e-a553-b1754e067486"],
 ". The draw is uniform over all the planes, and they can be many: a slab {\
\[Minus]1, 1} of the mesh has thousands."
}], "Notes",ExpressionUUID->"05209ac5-41a1-4120-8abe-7473ff90a1e3"],

