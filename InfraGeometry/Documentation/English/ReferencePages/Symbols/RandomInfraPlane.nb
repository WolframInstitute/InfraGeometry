Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraPlane", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"78dec5dd-8e97-400f-ae87-52862913ab9c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraPlane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraPlane", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraPlane", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ffc364f-038b-40b4-b377-aa1eafe451fc"],
 "\[LineSeparator]",
 "samples an inclusion-minimal separating vertex set on graph ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"08c68bd9-bdad-409d-8a82-6d7ba76f4acd"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraPlane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraPlane", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraPlane", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2119e580-b19f-4c31-9041-61d7ac7802a4"],
 "\[LineSeparator]",
 "requests ",
 Cell[BoxData["count"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f1ecf7db-f2a0-44a3-a7dc-3fcdd5fd5537"],
 " representatives. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "508d970a-b4b6-4dc8-aa77-ef96a7293062"],
 " enumerates the full pool; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45ea470c-3614-4e1a-b840-5a978e375fd9"],
 " returns at most ",
 StyleBox["n", "TI"],
 "."
}], "Usage",ExpressionUUID->"cab2994e-754d-414c-8982-c27488433b38"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomInfraPlane", "[", 
   RowBox[{"g", ",", " ", "p", ",", " ", "q", ",", " ", "count"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "579ba022-d2f4-44fe-8452-26af02f4f335"],
 " uses the direct form. The omitted window is ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", "0"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2533a5b-2850-47b9-b622-44641d8555e9"],
 ". Plane sampling fixes ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "\"\<Separating\>\"", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55cb26fb-e137-414e-984f-00b26a1e2119"],
 "; legacy rules inside the token are accepted and ignored."
}], "Notes",ExpressionUUID->"2c1db74f-5844-469c-a122-a19408e8db38"],

Cell[TextData[{
 "The sampler has the same token geometry as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPlane"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPlane", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "580522a2-92a8-421b-938d-416764983b48"],
 ". An omitted or ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb7fbd82-04de-4953-8152-a9a9ee31b8e7"],
 " count returns one representative. An integer count requests exactly that \
many distinct representatives and returns ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "498e86b0-f2a5-4558-9a71-63a477f070a4"],
 " when too few exist."
}], "Notes",ExpressionUUID->"98423a02-5129-46b8-b8ad-129142a03a6f"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11cb0936-dd0d-462c-9710-906f0bc4bb10"],
 " selects deterministically. Default ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "018eacfb-9ef6-4ef7-b6ce-eb1d0e4b5cdd"],
 " does not advance random state. Seed an ordinary draw with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8095c424-1b47-456e-8739-add8ec889b5c"],
 "."
}], "Notes",ExpressionUUID->"e1051b1e-b00b-4e16-adff-86874bbfc8ec"],

Cell[TextData[{
 "See ",
