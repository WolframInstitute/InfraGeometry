 CellLabel->"Out[1]= ",ExpressionUUID->"8dbc2cf9-2408-4771-8768-27a64f32e118"]
}, Open  ]],

Cell["\<\
On the mesh the 17 equidistant vertices of these two points do not separate \
them, and the slab {0, 0} gives no plane:\
\>", "ExampleText",ExpressionUUID->"249ff72d-1516-4bf7-84a4-48c4fe8229a1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"p", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"equidistant", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "p", ",", " ", "#"}], "]"}], " ", "==", " ", 
         
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "q", ",", " ", "#"}], "]"}]}], " ", "&"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"RandomInfraPlane", "[", 
      RowBox[{"g", ",", " ", "p", ",", " ", "q", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
     RowBox[{"Length", "[", "equidistant", "]"}], ",", "\n", "   ", 
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"VertexComponent", "[", 
        RowBox[{
         RowBox[{"VertexDelete", "[", 
          RowBox[{"g", ",", " ", "equidistant"}], "]"}], ",", " ", "p"}], 
        "]"}], ",", " ", "q"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f7b477bc-0581-4c6b-b671-232a67428427"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", "17", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"33c9ce62-87e2-4d28-b82e-6bc464a067f9"]
}, Open  ]]
}, Open  ]],

