Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraPlane", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"657bf996-8594-4f28-bb13-17642f553fb2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraPlane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraPlane", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraPlane", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d8840b1-0020-4373-b00f-dc2b216ead1a"],
 "\[LineSeparator]",
 "samples an inclusion-minimal separating vertex set on graph ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f62ea389-c5d6-4679-bdb4-a95da74d451c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraPlane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraPlane", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraPlane", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9f3dcd3-c940-451d-bf5d-e61fca56f0a4"],
 "\[LineSeparator]",
 "requests ",
 Cell[BoxData["count"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1181096-12d7-4c3d-ac7f-baa9ddf8213d"],
 " representatives. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "022aa122-10c1-4633-be9a-b6304ce45641"],
 " enumerates the full pool; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ba51e0d-3617-409e-8a22-e43a338dd257"],
 " returns at most ",
 StyleBox["n", "TI"],
 "."
}], "Usage",ExpressionUUID->"12b1d430-b893-4737-8d75-38a44dd16e0c"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomInfraPlane", "[", 
   RowBox[{"g", ",", " ", "p", ",", " ", "q", ",", " ", "count"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6459175-5015-4bb2-b936-6bff1b081015"],
 " uses the direct form. The omitted window is ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", "0"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c5422a6-c22f-4e1b-a116-d17104f976d7"],
 ". Plane sampling fixes ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "\"\<Separating\>\"", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee4dbf3a-9508-47af-a846-ec5019c5f842"],
 "; legacy rules inside the token are accepted and ignored."
}], "Notes",ExpressionUUID->"d6086c69-32be-443d-9a7e-bdf36dda4785"],

Cell[TextData[{
 "The sampler has the same token geometry as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPlane"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPlane", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ea744a97-0793-42b5-a86d-f865a68b4bfd"],
 ". An omitted or ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3406f40-9e5a-4b6d-a327-7cc7a0d96965"],
 " count returns one representative. An integer count requests exactly that \
many distinct representatives and returns ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab4c5868-d498-48e3-8aac-7c3943fdc4e7"],
 " when too few exist."
}], "Notes",ExpressionUUID->"807e72db-3c8b-4670-9df2-f7a061de3d40"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a3454b2-18a4-4085-94e3-b829a43f5464"],
 " selects deterministically; default ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43b985a9-58a8-4bd4-af59-9e888a89827d"],
 " makes no draw. ",
 Cell[BoxData[
  RowBox[{"RandomSeeding", " ", "->", " ", "Automatic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3f6f8f8-d46b-49eb-8a46-a1da5c9ca1db"],
 " (default) seeds each call afresh, independently of ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50bb2a98-ff11-4c40-9e29-ce17b4eabf1a"],
 "; an integer or string gives a reproducible draw, and ",
 Cell[BoxData["Inherited"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f40be361-cb9a-4de2-813f-029e791257ba"],
 " a local snapshot of the current state. The outer random state is restored \
afterward, as with ",
 ButtonBox["RandomInstance",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/RandomInstance.html"], 
    None}],
 "."
}], "Notes",ExpressionUUID->"97df0b9e-42f4-4152-9cc5-eca0bcd1ec32"],

Cell[TextData[{
 "See ",
 ButtonBox["Named construction samplers",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["../Tutorials/NamedConstructionSamplers.md"], None}],
 " for bare overloads, carrier differences and compatibility spellings."
}], "Notes",ExpressionUUID->"1fc862d1-c9f2-4975-a599-8c4a3a292a7b"]
}, Open  ]],

