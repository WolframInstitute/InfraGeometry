Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"p", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"plane", " ", "=", " ", 
     RowBox[{"RandomInfraPlane", "[", 
      RowBox[{"g", ",", " ", "p", ",", " ", "q", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"separatesQ", " ", "=", " ", 
     RowBox[{"h", " ", "|->", " ", 
      RowBox[{"!", " ", 
       RowBox[{"MemberQ", "[", 
        RowBox[{
         RowBox[{"VertexComponent", "[", 
          RowBox[{
           RowBox[{"VertexDelete", "[", 
            RowBox[{"g", ",", " ", "h"}], "]"}], ",", " ", "p"}], "]"}], ",", 
         " ", "q"}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"separatesQ", "[", "plane", "]"}], ",", " ", 
     RowBox[{"NoneTrue", "[", 
      RowBox[{"plane", ",", " ", 
       RowBox[{
        RowBox[{"separatesQ", "[", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{"plane", ",", " ", "#"}], "]"}], "]"}], " ", "&"}]}], "]"}],
      ",", " ", 
     RowBox[{"InfraPlaneQ", "[", 
      RowBox[{
      "g", ",", " ", "plane", ",", " ", "p", ",", " ", "q", ",", " ", "1"}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"65f8da71-a1f8-4cad-a74b-1d0dd0851281"],

