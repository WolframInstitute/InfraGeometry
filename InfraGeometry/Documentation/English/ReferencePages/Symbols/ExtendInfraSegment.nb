Notebook[{

Cell[CellGroupData[{
Cell["ExtendInfraSegment", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7e3f5bcf-7f5b-4718-9232-328f93be9fff"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1266d43c-a360-403d-b65d-9516ef307248"],
 "\[LineSeparator]",
 "gives one geodesic containing ",
 StyleBox["seg", "TI"],
 ", extended past its ends by at most ",
 StyleBox["kspec", "TI"],
 " edges on each side and inextensible within that budget, as a directed path \
graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e5d5d3c7-0396-4c88-9440-1c80541f4511"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7e9757-6209-4dd4-824d-8a6ce1199f6a"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb30392c-83b9-46e4-8680-5f2a6f2623ff"],
 " of exactly ",
 StyleBox["n", "TI"],
 " extensions or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "156b6425-5a0c-43f0-ae01-d2e44e361edf"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22d36f30-7778-4bc8-b814-607fb580a2b8"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "282c647d-f631-4123-acf3-7f8080ac96b0"],
 " gives the whole class as a pool of DAGs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"cdf3b0f3-794a-4500-b734-b56696289707"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "109b1f69-3539-4677-a700-4ad2b0116b62"],
 "\[LineSeparator]",
 "gives the vertices ",
 StyleBox["x", "TI"],
 " with ",
 StyleBox["b", "TI"],
 " between ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["x", "TI"],
 " and ",
 StyleBox["d(b, x) = d(c, d)", "TI"],
 " \[LongDash] Tarski's segment construction, axiom A4 \[LongDash] as a \
vertex list."
}], "Usage",ExpressionUUID->"4987b2a5-19be-49e4-b91d-52e2a5823c3e"],

Cell[TextData[{
 "The seed ",
 StyleBox["seg", "TI"],
 " is a geodesic vertex list, or a geodesic DAG such as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "]"}], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09175ed1-78bb-4e33-be4f-2f1c1b401e50"],
 ". A DAG extends ",
 StyleBox["as one object",
  FontWeight->"Bold"],
 ": the whole bundle from ",
 StyleBox["p1", "TI"],
 " to ",
 StyleBox["p2", "TI"],
 " gets the same ends."
}], "Notes",ExpressionUUID->"956c7582-be26-43ac-95ac-21c4c9954180"],

Cell[TextData[{
 "Everything is read off the distance matrix. With the seed running from ",
 StyleBox["p1", "TI"],
 " to ",
 StyleBox["p2", "TI"],
 ", a pair of ends (",
 StyleBox["s", "TI"],
 ", ",
 StyleBox["e", "TI"],
 ") is ",
 StyleBox["admissible",
  FontWeight->"Bold"],
 " when ",
 StyleBox["d(s, e) = d(s, p1) + d(p1, p2) + d(p2, e)", "TI"],
 " \[LongDash] the concatenation is a geodesic whichever geodesics are used, \
so the condition reads only the ends \[LongDash] when the larger of ",
 StyleBox["d(p1, s)", "TI"],
 " and ",
 StyleBox["d(p2, e)", "TI"],
 " passes ",
 StyleBox["kspec", "TI"],
 ", and when each free side is either at the budget or inextensible. The \
candidate ends are the vertices of the two extension graphs ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p2", "TI"], ",", " ", 
      StyleBox["p1", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b275b4c-da23-4409-ad2f-26cf522443cc"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8de3c35-3854-432f-bd3a-896f69cc0396"],
 ", cut at the budget."
}], "Notes",ExpressionUUID->"9f812a12-9d03-46aa-a69d-31338ff6013c"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3cca9352-3332-4998-8cb1-5b10ec9b714c"], Cell[TextData[StyleBox[
    "kspec", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"ad139728-8182-42ba-8126-e3ffa2b81f29"],
