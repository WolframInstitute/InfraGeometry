   {Cell["      ", "ModInfo",ExpressionUUID->
     "afea21b7-87d6-4921-978d-06038c52483e"], Cell[TextData[StyleBox[
    "kspec", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"61f40d97-f397-4e9d-a4e2-e5fc391f4f4d"],
