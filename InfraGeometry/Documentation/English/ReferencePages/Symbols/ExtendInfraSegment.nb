    "Method"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ef1300d3-959d-4e7c-886c-d4905d322bba"]], "TableText",ExpressionUUID->
     "b89fdc76-9a09-499b-a3aa-b2c48dee2c9d"], Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "142853c1-4372-407b-99aa-493727f85648"],
     " (default), ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "79224f76-ff7c-48cb-acc5-987ccf1f0fbe"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
        RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c119b686-17f4-4f1d-8213-69d18f7a5085"],
     ", ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b480735e-04ec-492e-92d3-980bde8241ac"],
     ", ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0fb5933c-a1d4-4905-9414-47ae9b73e0ba"]
    }], "TableText",ExpressionUUID->"bf9f60df-f42d-4d93-accf-b8b204a0232d"], 
    Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ea54629e-cd5b-481a-9893-c5da63eeaffe"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8eb7c0f3-33a8-4e15-94b2-59020784176d"],
     " to ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "77ab380c-e549-454c-85e2-b18a745f532c"],
     ", the pool; a bounded or absent count to ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "fb874a86-8482-428d-8bff-045a0ada3af1"],
     ", which takes the admissible pairs and the branches of each DAG in \
candidate order, so the count-less call is deterministic. ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1f2b949b-965c-4855-9265-26a2f2a0ccff"],
     " takes them in random order, seeded by an ambient ",
     Cell[BoxData["SeedRandom"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6b7000f5-5d3e-487f-8e1c-f214293f4deb"],
     ". The class is the same under every value; ",
     Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "01b2e371-6fd5-4960-a0ee-b49c20164339"],
     " is accepted and inert, the pool having no frontier to cap."
    }], "TableText",ExpressionUUID->"eaeeebf3-18cd-4e6a-b1f1-7064d84a50da"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3493aac1-798c-473c-8d3e-2fc523ca011b"], Cell[TextData[Cell[
    BoxData["\"\<Direction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "51431f1c-13ce-49f8-8b9b-eaff3887c3ac"]], "TableText",ExpressionUUID->
     "7a89d72b-a5d4-46c5-8b76-5ea3794c9295"], Cell[TextData[{
     Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0039de18-f9d0-407e-9f02-770dc2c85f23"],
     " (default), ",
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "01a3239e-604b-419a-95d7-a6cc686df833"],
     ", ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9ef4e939-3b95-447a-9427-f0b6adc36b70"]
    }], "TableText",ExpressionUUID->"67cb5ab8-8de7-4f7a-ab29-e1ff91fe2170"], 
    Cell[TextData[{
     "which ends may move: ",
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "43977375-17f7-4c0a-8391-ea6e96721b9d"],
     " keeps ",
     StyleBox["p1", "TI"],
     " and extends past ",
     StyleBox["p2", "TI"],
     " only, ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3d5d7b0f-d39d-4e92-9f47-e272d72c077a"],
     " the reverse."
    }], "TableText",ExpressionUUID->"1cd71c6e-75e3-4454-b6d3-b5b42e46dbbe"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9119025b-c0a4-43b6-b16a-2c4b47317ec9"], Cell[TextData[Cell[BoxData[
    "Properties"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ec0991e4-5be7-4b81-8e51-017bbcfdb068"]], "TableText",ExpressionUUID->
     "e718f914-ef43-4801-b1d0-d74c14e4134a"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9f4e9718-bd3e-4456-af5b-fe89796699a5"]], "TableText",ExpressionUUID->
     "de5080e8-9742-45ef-aaee-c8e7862c41c4"], Cell[TextData[{
     "only the empty list; a rule on the extension is a local law and lives \
on ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["ExtendInfraGeodesic"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/\
ExtendInfraGeodesic", 
