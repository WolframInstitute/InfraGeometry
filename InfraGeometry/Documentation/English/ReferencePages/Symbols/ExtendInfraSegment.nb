     "exactly ",
     StyleBox["k", "TI"],
     " edges"
    }], "TableText",ExpressionUUID->"21c2edc4-c637-4e20-b975-995882ede46d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "86ab848c-9e89-4ca8-832b-baa3c8fa8b67"], Cell[TextData[{
     "{",
     StyleBox["lo", "TI"],
     ", ",
     StyleBox["hi", "TI"],
     "}"
    }], "TableText",ExpressionUUID->"96f1ec58-7268-4ffc-aff7-e1fb186802dc"], 
    Cell[TextData[{
     "between ",
     StyleBox["lo", "TI"],
     " and ",
     StyleBox["hi", "TI"],
     " edges"
    }], "TableText",ExpressionUUID->"21047aba-ee2d-4cfb-8dad-a33a195f6830"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4ebda580-4403-4bd9-9f36-aff35d081bb1"], Cell[TextData[{
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4db31c03-9957-4715-8b91-1303545e4559"],
     " (default)"
    }], "TableText",ExpressionUUID->"2e336626-1a1f-4348-9dd0-29e74c44fbbe"], 
    Cell["unbounded \[LongDash] the lines through the seed", "TableText",
     ExpressionUUID->"f016c759-deb6-47b1-a1ef-0e7362c99674"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2268f0ec-84de-431b-99cd-8e85814f2d93"], Cell[
    "0", "TableText",ExpressionUUID->"d3841ed3-96a3-4e6d-a6e7-188b0c8fb570"], 
    Cell["none \[LongDash] the seed itself", "TableText",ExpressionUUID->
     "1cca35ba-f832-4bcb-ac54-2dfb0d09d9e3"]}
  }]], "2ColumnTableMod",ExpressionUUID->"7a7eed9a-d76d-462f-a8f2-\
37ae4be7a5c1"],

Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3538c482-52f3-471c-9e00-82f0a14f0ad5"],
 " returns the ",
 StyleBox["pool",
  FontWeight->"Bold"],
 ": a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7191ebf-2117-4962-86c1-515ed0a84534"],
 " of DAGs, one per admissible pair of ends, whose source-to-sink paths are \
exactly the extensions with those ends. A single admissible pair gives the \
one DAG, not a list. A bounded count streams extensions off the admissible \
pairs, each a directed path graph."
}], "Notes",ExpressionUUID->"ee9eea1c-ce0f-42fe-8903-f4d509084e6f"],

Cell[TextData[{
 "With the budget ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8158d938-f730-4a74-9cc2-69a4e1f527bf"],
 " the extensions are the lines through the seed, the family of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76458aa4-f690-45cc-b715-dd3395e3d2ce"],
 ", which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "569df417-6f64-4202-a62f-d515fd0c31ed"],
 " counts without enumerating."
}], "Notes",ExpressionUUID->"7d7bb073-6afd-48fe-b46c-6cec26e222a5"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a8d0d9d0-7e99-4111-bb31-f6cb0113aec5"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"c0cf0615-61b3-45cd-8a02-a35ef5dc467c"],
