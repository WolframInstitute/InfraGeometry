     "c2c03e87-77ea-44fe-bcfc-0e7a13c2de98"], Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9ebaf9a5-b490-4157-bc14-c5a794181349"],
     " (default), ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "958f1c84-e75e-40e2-8364-4db65dc1d621"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
        RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a66e92bf-d899-4e70-bb88-131118618548"],
     ", ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "75f14764-3ddc-4c39-9467-09fb934f2f56"],
     ", ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "dc3f6fc3-4851-49c2-bd3b-daa2043ca726"]
    }], "TableText",ExpressionUUID->"70e456bf-ac43-4b3c-bdb0-eb86c5e4c876"], 
    Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b86a2862-31f4-45f5-92c9-0ce49609c578"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "aa103a7d-cc16-4975-a2be-0d71d2762504"],
     " to ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "65801f4a-ff26-40cc-8f3a-60e6459b6d3b"],
     ", the pool; a bounded or absent count to ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b4ce6074-df1b-467a-b033-ac8df7cfc646"],
     ", which takes the admissible pairs and the branches of each DAG in \
candidate order, so the count-less call is deterministic. ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "13977b07-294d-4ca7-83c8-850a6f13fb9d"],
     " takes them in random order, seeded by an ambient ",
     Cell[BoxData["SeedRandom"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ea5d4ecc-ada0-40bd-96ab-bd19f33425d3"],
     ". The class is the same under every value; ",
     Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2fec231a-f710-4365-8b99-16615829fd0f"],
     " is accepted and inert, the pool having no frontier to cap."
    }], "TableText",ExpressionUUID->"a4a9f8c4-4bd1-450d-bf05-31aa0ff2c0c5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "77301d88-363d-400b-9527-82646e1cf0e3"], Cell[TextData[Cell[
    BoxData["\"\<Direction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "241a25c4-3de3-4d78-8f41-85200d19179a"]], "TableText",ExpressionUUID->
     "a7fb897e-6515-4de7-b455-d469ae065b7d"], Cell[TextData[{
     Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b83118a9-88ed-40a7-8d1f-1fb1821f0b0e"],
     " (default), ",
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "125e4239-3192-4508-b868-581c9560dade"],
     ", ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "cfb7d343-b77d-424d-9d59-de8df28ebdce"]
    }], "TableText",ExpressionUUID->"8167b721-fd94-4864-9cb2-3dba5d61e35a"], 
    Cell[TextData[{
     "which ends may move: ",
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "acb530cd-dacb-4aff-ba26-9c798abdbe3d"],
     " keeps ",
     StyleBox["p1", "TI"],
     " and extends past ",
     StyleBox["p2", "TI"],
     " only, ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "83896914-86d3-4c78-b01f-1b64f73b42d9"],
     " the reverse."
    }], "TableText",ExpressionUUID->"c464853f-6cd0-4362-a820-c03dd1f1eac2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b4db816c-5dba-4bea-a8dc-0c3ad7f9d60d"], Cell[TextData[Cell[BoxData[
    "Properties"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "74f9e4f6-7273-43b0-b067-0f69ef00a212"]], "TableText",ExpressionUUID->
     "17199091-e79e-4204-a508-ccd5867db912"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ba36aff9-759e-4a75-9969-bba0a96d5079"]], "TableText",ExpressionUUID->
     "80b05b50-cce4-4da4-9b94-bd85344d2518"], Cell[TextData[{
     "only the empty list; a rule on the extension is a local law and lives \
on ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["ExtendInfraGeodesic"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraGeodesic", 
