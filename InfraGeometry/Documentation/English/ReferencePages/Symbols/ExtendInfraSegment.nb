Cell["\<\
With no budget the pool carries the lines through the seed: two DAGs for the \
twelve lines through the edge.\
\>", "ExampleText",ExpressionUUID->"5aeafb73-10d2-47aa-8b99-2fe4fdd5186b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"ExtendInfraSegment", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "Infinity", ",", " ", 
        "All"}], "]"}]}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraLine", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "All"}], "]"}]}], ",",
      "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraLine", "[", 
        RowBox[{"6", ",", " ", "7"}], "]"}], ",", 
       " ", "\"\<Cardinality\>\""}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"168056d1-4c27-43b9-b00f-01ad41a6f5ae"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "12", ",", "12"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6560f841-0478-44ef-8f30-c8332524094f"]
}, Open  ]],

Cell["\<\
Exactly one step per side gives the same seven as at most one, since every \
one-step extension is inextensible within the budget.\
\>", "ExampleText",ExpressionUUID->"7e6d96e5-1a69-4d78-b194-3d750edfc37e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"ExtendInfraSegment", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", 
      RowBox[{"{", "1", "}"}], ",", " ", "All"}], "]"}], " ", "===", " ", 
    RowBox[{"ExtendInfraSegment", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "1", ",", " ", "All"}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"15321a50-0a63-4d55-801c-792662c2854d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"07653db3-ff27-4ef5-b27a-41889cad0fd0"]
}, Open  ]]
}, Open  ]],

