     "{",
     StyleBox["lo", "TI"],
     ", ",
     StyleBox["hi", "TI"],
     "}"
    }], "TableText",ExpressionUUID->"f92e4d35-1016-4e8a-8429-d6554923788b"], 
    Cell[TextData[{
     "between ",
     StyleBox["lo", "TI"],
     " and ",
     StyleBox["hi", "TI"],
     " edges"
    }], "TableText",ExpressionUUID->"4a169e5b-1b5d-4617-a75e-24e39497bf45"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a7c23485-4489-4908-aa88-b833679feaf4"], Cell[TextData[{
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "673673e5-2294-429d-911b-b7f14530f059"],
     " (default)"
    }], "TableText",ExpressionUUID->"75960adb-cae2-4758-b18b-1a37ea045b57"], 
    Cell["unbounded \[LongDash] the lines through the seed", "TableText",
     ExpressionUUID->"ad4cd9cf-9913-4fe0-9f88-e472072444d6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "925bca8c-a511-4607-a900-bcda0476855c"], Cell[
    "0", "TableText",ExpressionUUID->"023f77ae-8776-477e-9e6d-631403c0cef3"], 
    Cell["none \[LongDash] the seed itself", "TableText",ExpressionUUID->
     "714fe358-0e78-4d50-a00b-c24bfad89d25"]}
  }]], "2ColumnTableMod",ExpressionUUID->"684cfe9a-35f3-4580-990b-\
7e7188ff86f3"],

Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fdfa2e62-2a70-4013-aab8-8a80e78912f0"],
 " returns the ",
 StyleBox["pool",
  FontWeight->"Bold"],
 ": a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a857f0ad-2991-473c-9045-75d1bdbb4315"],
 " of DAGs, one per admissible pair of ends, whose source-to-sink paths are \
exactly the extensions with those ends. A single admissible pair gives the \
one DAG, not a list. A bounded count streams extensions off the admissible \
pairs, each a directed path graph."
}], "Notes",ExpressionUUID->"82b0f11e-b9bc-49da-bd0a-21d3ac3acd3c"],

Cell[TextData[{
 "With the budget ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34b6b671-82b3-490a-8604-92298f63d444"],
 " the extensions are the lines through the seed, the family of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b2b338d-66ad-49c9-a633-7996c8849851"],
 ", which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0ff2b591-15df-43c9-bedd-00bcd04aa259"],
 " counts without enumerating."
}], "Notes",ExpressionUUID->"c9bc42dc-b0cf-43b7-9bda-dff4369ba0eb"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b5966d12-f8b6-4d67-bad6-0682ec910d00"], Cell["Option", "TableText",
