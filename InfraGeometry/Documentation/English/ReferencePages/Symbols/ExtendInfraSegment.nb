Notebook[{

Cell[CellGroupData[{
Cell["ExtendInfraSegment", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"521c344d-b7ac-4e25-849b-361ba196ac56"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6656790a-d08a-464f-9e90-226b8e78005e"],
 "\[LineSeparator]",
 "gives one geodesic containing ",
 StyleBox["seg", "TI"],
 ", extended past its ends by at most ",
 StyleBox["kspec", "TI"],
 " edges on each side and inextensible within that budget, as a directed path \
graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"22cde118-f17c-48ee-a48f-95034d08d5ff"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ef97423-41c6-4547-a920-2fa92343b1a2"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f25780d-5556-4ac7-a2a1-831fd37ac225"],
 " of exactly ",
 StyleBox["n", "TI"],
 " extensions or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3815efc-e7b8-4e39-a7db-3694606151f4"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3682eca-86d7-48be-abf5-9e7d358bcdfa"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f1b6159-0295-48d2-9f2d-f5cb65cd8bf3"],
 " gives the whole class as a pool of DAGs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"34a58de1-6ba5-4c78-bea4-db7d58a80d40"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1b675f8-f7f6-4692-8fdf-fd3165b57ac3"],
 "\[LineSeparator]",
 "gives the vertices ",
 StyleBox["x", "TI"],
 " with ",
 StyleBox["b", "TI"],
 " between ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["x", "TI"],
 " and ",
 StyleBox["d(b, x) = d(c, d)", "TI"],
 " \[LongDash] Tarski's segment construction, axiom A4 \[LongDash] as a \
vertex list."
}], "Usage",ExpressionUUID->"106dadd2-1fc4-4c65-a9f9-8b1f719be18c"],

Cell[TextData[{
 "The seed ",
 StyleBox["seg", "TI"],
 " is a geodesic vertex list, or a geodesic DAG such as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "]"}], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a17d559d-6775-49be-86c7-25e974d94cc3"],
 ". A DAG extends ",
 StyleBox["as one object",
  FontWeight->"Bold"],
 ": the whole bundle from ",
 StyleBox["p1", "TI"],
 " to ",
 StyleBox["p2", "TI"],
 " gets the same ends."
}], "Notes",ExpressionUUID->"16f158ab-c924-4267-bcaf-7722bc7488a1"],

Cell[TextData[{
 "Everything is read off the distance matrix. With the seed running from ",
 StyleBox["p1", "TI"],
 " to ",
 StyleBox["p2", "TI"],
 ", a pair of ends (",
 StyleBox["s", "TI"],
 ", ",
 StyleBox["e", "TI"],
 ") is ",
 StyleBox["admissible",
  FontWeight->"Bold"],
 " when ",
 StyleBox["d(s, e) = d(s, p1) + d(p1, p2) + d(p2, e)", "TI"],
 " \[LongDash] the concatenation is a geodesic whichever geodesics are used, \
so the condition reads only the ends \[LongDash] when the larger of ",
 StyleBox["d(p1, s)", "TI"],
 " and ",
 StyleBox["d(p2, e)", "TI"],
 " passes ",
 StyleBox["kspec", "TI"],
 ", and when each free side is either at the budget or inextensible. The \
candidate ends are the vertices of the two extension graphs ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p2", "TI"], ",", " ", 
      StyleBox["p1", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97e35c3a-6e5b-4f10-9054-44529073e5e7"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7706406-358d-49d5-9062-8e02b527147e"],
 ", cut at the budget."
}], "Notes",ExpressionUUID->"1e4a10d5-61a0-4081-a634-c9391b250d02"],

