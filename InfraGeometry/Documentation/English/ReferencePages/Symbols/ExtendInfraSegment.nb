    }], "TableText",ExpressionUUID->"5f10f74d-f409-48b4-835d-0192c2440a09"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6371beed-ffa3-42e2-a8c7-bea9f9975230"], Cell[TextData[{
     "{",
     StyleBox["lo", "TI"],
     ", ",
     StyleBox["hi", "TI"],
     "}"
    }], "TableText",ExpressionUUID->"9ff33c70-1afa-4a21-98e2-c7be690a5ad2"], 
    Cell[TextData[{
     "between ",
     StyleBox["lo", "TI"],
     " and ",
     StyleBox["hi", "TI"],
     " edges"
    }], "TableText",ExpressionUUID->"9174b807-2f0e-4e9b-b2be-091389ffdef3"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3649b4d1-0a8f-4540-9fe6-ceb6e3ea6297"], Cell[TextData[{
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "bc447e15-68a9-4d79-b92e-ca088f2666eb"],
     " (default)"
    }], "TableText",ExpressionUUID->"7fbd618c-9be9-4b04-963b-a47a941dd80a"], 
    Cell["unbounded \[LongDash] the lines through the seed", "TableText",
     ExpressionUUID->"0bdd431b-9c12-44f1-b3e3-98b1fc80fee6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "57861800-fa0a-49f2-b24d-2b0ed171412a"], Cell[
    "0", "TableText",ExpressionUUID->"009049a9-107e-4f45-9b64-04f2f56f2854"], 
    Cell["none \[LongDash] the seed itself", "TableText",ExpressionUUID->
     "069f71a6-c90d-4328-8615-5bc081cc5dc8"]}
  }]], "2ColumnTableMod",ExpressionUUID->"a5e5d772-78b2-4e48-8734-\
de5220053d16"],

Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9773310c-52f3-4f30-9a11-333f78793d8f"],
 " returns the ",
 StyleBox["pool",
  FontWeight->"Bold"],
 ": a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cbc803b-8cfb-4b85-9b1e-713797556448"],
 " of DAGs, one per admissible pair of ends, whose source-to-sink paths are \
exactly the extensions with those ends. A single admissible pair gives the \
one DAG, not a list. A bounded count streams extensions off the admissible \
pairs, each a directed path graph."
}], "Notes",ExpressionUUID->"5f66ce58-5ef6-46d8-aee6-5f02aea19228"],

Cell[TextData[{
 "With the budget ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4de12cff-8265-4db9-bac6-70e47184b40b"],
 " the extensions are the lines through the seed, the family of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07afab62-0e19-4bfa-9a99-ca459ca61572"],
 ", which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fb9c42f2-615a-4c6c-9703-49b9e516f155"],
 " counts without enumerating."
}], "Notes",ExpressionUUID->"c94a3c83-761a-4d82-871b-2e7d5e5b45e7"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1b5c6eb6-6af6-45db-9062-2ffdded22534"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"a4f6adcc-8075-4446-a92f-329a90b55462"],
