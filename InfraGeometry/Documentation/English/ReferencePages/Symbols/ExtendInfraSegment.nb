    }], "TableText",ExpressionUUID->"df03bcf0-5d47-4115-b037-04e0b4465ff1"]}
  }]], "3ColumnTableMod",ExpressionUUID->"7b72a0fd-2f3c-468b-ace0-\
928ae45317fc"],

Cell[TextData[{
 "The five-argument form is Tarski's axiom A4: from ",
 StyleBox["a", "TI"],
 " through ",
 StyleBox["b", "TI"],
 ", lay off a segment congruent to ",
 StyleBox["cd", "TI"],
 ". It returns every vertex ",
 StyleBox["x", "TI"],
 " at distance ",
 StyleBox["d(c, d)", "TI"],
 " beyond ",
 StyleBox["b", "TI"],
 " on a geodesic from ",
 StyleBox["a", "TI"],
 "; a trailing count ",
 StyleBox["n", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ab93f50-3ebc-4482-9a5b-c4d356fb0a56"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f39bd8-d4bf-43b2-9cfc-78b2c67fee85"],
 " bounds the list."
}], "Notes",ExpressionUUID->"5e454980-c987-4693-b18e-ba73332e4faa"]
}, Open  ]],

