       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "8ad7364f-c88a-4276-99be-81f4468a336d"],
     "."
    }], "TableText",ExpressionUUID->"e928525d-04a4-4a34-9775-5fe472eadac6"]}
  }]], "3ColumnTableMod",ExpressionUUID->"12a70c69-d106-422b-995c-\
3bb76d188154"],

Cell[TextData[{
 "The five-argument form is Tarski's axiom A4: from ",
 StyleBox["a", "TI"],
 " through ",
 StyleBox["b", "TI"],
 ", lay off a segment congruent to ",
 StyleBox["cd", "TI"],
 ". It returns every vertex ",
 StyleBox["x", "TI"],
 " at distance ",
 StyleBox["d(c, d)", "TI"],
 " beyond ",
 StyleBox["b", "TI"],
 " on a geodesic from ",
 StyleBox["a", "TI"],
 "; a trailing count ",
 StyleBox["n", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b7ba542-75d3-482b-8e4a-bec83ae28cf6"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15ccfed6-9931-4a75-8d2f-7688153a2ba1"],
 " bounds the list."
}], "Notes",ExpressionUUID->"e7e89ea4-5681-4910-9d05-d7358ae84f25"]
}, Open  ]],

