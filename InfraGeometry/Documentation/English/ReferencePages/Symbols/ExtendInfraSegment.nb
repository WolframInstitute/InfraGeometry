     "at most ",
     StyleBox["k", "TI"],
     " edges"
    }], "TableText",ExpressionUUID->"0e02123c-e4d7-4239-aeb6-8bb717301220"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e4569646-4e01-43d9-9c35-0540cca2190b"], Cell[TextData[{
     "{",
     StyleBox["k", "TI"],
     "}"
    }], "TableText",ExpressionUUID->"fd5a6b24-8531-4c82-8034-e17d5f44d586"], 
    Cell[TextData[{
     "exactly ",
     StyleBox["k", "TI"],
     " edges"
    }], "TableText",ExpressionUUID->"0844bd84-d51a-447f-896f-f6f8eeab516b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9f7dd387-8124-4c8e-bcbb-375103c2094c"], Cell[TextData[{
     "{",
     StyleBox["lo", "TI"],
     ", ",
     StyleBox["hi", "TI"],
     "}"
    }], "TableText",ExpressionUUID->"163b965e-ad0a-4fd3-af19-a1d5cdae8cb6"], 
    Cell[TextData[{
     "between ",
     StyleBox["lo", "TI"],
     " and ",
     StyleBox["hi", "TI"],
     " edges"
    }], "TableText",ExpressionUUID->"3e9fb120-4b0e-40f0-8031-c2b00fb7fe3d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6e011002-aaae-4beb-8268-586220f5d80e"], Cell[TextData[{
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "80583977-700d-40ea-a384-1f569b64102c"],
     " (default)"
    }], "TableText",ExpressionUUID->"5f101d8e-348c-4440-b894-595cb645ae5a"], 
    Cell["unbounded \[LongDash] the lines through the seed", "TableText",
     ExpressionUUID->"6aeb119e-0ca1-4c96-86e0-169107c56fc5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "aa6acc9b-26e1-4cf9-9673-d15c2fe3e564"], Cell[
    "0", "TableText",ExpressionUUID->"ad6412e6-5729-4ad7-83ca-e8e127af3455"], 
    Cell["none \[LongDash] the seed itself", "TableText",ExpressionUUID->
     "0dfbf6c5-9de8-4220-8d51-ee4cdccc116f"]}
  }]], "2ColumnTableMod",ExpressionUUID->"526e775d-93c3-4359-b53a-\
5f68f111d3e9"],

Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28dca312-8ac4-4ac2-a4b2-b9ae42b747b2"],
 " returns the ",
 StyleBox["pool",
  FontWeight->"Bold"],
 ": a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "580bf3e0-fd7a-4dc4-9950-3c8a22f9d77f"],
 " of DAGs, one per admissible pair of ends, whose source-to-sink paths are \
exactly the extensions with those ends. A single admissible pair gives the \
one DAG, not a list. A bounded count streams extensions off the admissible \
pairs, each a directed path graph."
}], "Notes",ExpressionUUID->"d6a61627-099e-4c52-8a26-f39a7e070c36"],

Cell[TextData[{
 "With the budget ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0299292-3490-48d5-a086-b54e6fc46d92"],
 " the extensions are the lines through the seed, the family of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f365ed2a-4177-4428-a580-4ee9dad5e66a"],
 ", which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "67fb58db-c4a0-469c-8725-aab45eab1e34"],
 " counts without enumerating."
}], "Notes",ExpressionUUID->"cff0c6c1-aaff-4918-9c6e-cb3c67a9b44d"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "687ae9d9-03e1-4ac4-af87-70ae09ded47f"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"6163530c-2b6a-4da1-95c5-46d8cb1e061f"],
