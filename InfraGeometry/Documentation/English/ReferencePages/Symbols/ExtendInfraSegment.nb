Notebook[{

Cell[CellGroupData[{
Cell["ExtendInfraSegment", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"42161a67-e585-4add-8d3c-c7b463d586c7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b3cbe73-b2c0-4cb1-921f-e0b54b98d095"],
 "\[LineSeparator]",
 "gives one geodesic containing ",
 StyleBox["seg", "TI"],
 ", extended past its ends by at most ",
 StyleBox["kspec", "TI"],
 " edges on each side and inextensible within that budget, as a directed path \
graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"de8ed170-b4e9-4315-ac45-8f4b107609b8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6bd723d-b245-48cb-a28f-4c058652bb11"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cbf752dd-87ef-4a08-b6a3-091820ae3b31"],
 " of exactly ",
 StyleBox["n", "TI"],
 " extensions or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e915790-a135-4f66-9133-a1ad5962a7f0"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9769b9dd-bf28-4db2-8f13-45a3300778a6"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa7f00a3-0f8c-4273-ae42-19d28a6e1121"],
 " gives the whole class as a pool of DAGs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d59e2c4c-c399-4e16-ad8c-f8047b7e996f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "abfb8bd8-89a3-48d1-90b5-48220c939101"],
 "\[LineSeparator]",
 "gives the vertices ",
 StyleBox["x", "TI"],
 " with ",
 StyleBox["b", "TI"],
 " between ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["x", "TI"],
 " and ",
 StyleBox["d(b, x) = d(c, d)", "TI"],
 " \[LongDash] Tarski's segment construction, axiom A4 \[LongDash] as a \
vertex list."
}], "Usage",ExpressionUUID->"2ee51eed-2ff5-4b22-ad62-10281c0944e5"],

Cell[TextData[{
 "The seed ",
 StyleBox["seg", "TI"],
 " is a geodesic vertex list, or a geodesic DAG such as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "]"}], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f073a20-69c5-4e51-9538-025c23b91f0b"],
 ". A DAG extends ",
 StyleBox["as one object",
  FontWeight->"Bold"],
 ": the whole bundle from ",
 StyleBox["p1", "TI"],
 " to ",
 StyleBox["p2", "TI"],
 " gets the same ends."
}], "Notes",ExpressionUUID->"99079d07-37a6-4f80-b078-dcfa27f027a1"],

Cell[TextData[{
 "Everything is read off the distance matrix. With the seed running from ",
 StyleBox["p1", "TI"],
 " to ",
 StyleBox["p2", "TI"],
 ", a pair of ends (",
 StyleBox["s", "TI"],
 ", ",
 StyleBox["e", "TI"],
 ") is ",
 StyleBox["admissible",
  FontWeight->"Bold"],
 " when ",
 StyleBox["d(s, e) = d(s, p1) + d(p1, p2) + d(p2, e)", "TI"],
 " \[LongDash] the concatenation is a geodesic whichever geodesics are used, \
so the condition reads only the ends \[LongDash] when the larger of ",
 StyleBox["d(p1, s)", "TI"],
 " and ",
 StyleBox["d(p2, e)", "TI"],
 " passes ",
 StyleBox["kspec", "TI"],
 ", and when each free side is either at the budget or inextensible. The \
candidate ends are the vertices of the two extension graphs ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p2", "TI"], ",", " ", 
      StyleBox["p1", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66859af2-a220-4bd7-b760-95f45c0b450a"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d56e3938-9797-4a35-932e-f4910417c131"],
 ", cut at the budget."
}], "Notes",ExpressionUUID->"053a0e4f-a557-4794-9696-fa237a6bfcce"],

