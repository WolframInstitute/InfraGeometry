    }], "TableText",ExpressionUUID->"8cf810eb-e8d4-41df-9251-2a365739db6f"]}
  }]], "3ColumnTableMod",ExpressionUUID->"e65e8b71-0a18-4178-b657-\
7565aa935019"],

Cell[TextData[{
 "The five-argument form is Tarski's axiom A4: from ",
 StyleBox["a", "TI"],
 " through ",
 StyleBox["b", "TI"],
 ", lay off a segment congruent to ",
 StyleBox["cd", "TI"],
 ". It returns every vertex ",
 StyleBox["x", "TI"],
 " at distance ",
 StyleBox["d(c, d)", "TI"],
 " beyond ",
 StyleBox["b", "TI"],
 " on a geodesic from ",
 StyleBox["a", "TI"],
 "; a trailing count ",
 StyleBox["n", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "432003e1-1986-4b87-a7e9-2a55ff6e2c40"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71ce1384-f07a-4a65-acf9-f67ea2475c25"],
 " bounds the list."
}], "Notes",ExpressionUUID->"f6ef56b7-7bee-43a2-855f-45752fa4cb54"]
}, Open  ]],

