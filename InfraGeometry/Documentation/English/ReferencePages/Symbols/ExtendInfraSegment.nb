     " edges"
    }], "TableText",ExpressionUUID->"010c4500-ec1f-4ad4-b615-56abb80cfa05"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d0817328-2bc4-415d-a22e-e2c16c89b9c9"], Cell[TextData[{
     "{",
     StyleBox["lo", "TI"],
     ", ",
     StyleBox["hi", "TI"],
     "}"
    }], "TableText",ExpressionUUID->"1fc052c6-d672-45ce-9195-10c7ab16cef0"], 
    Cell[TextData[{
     "between ",
     StyleBox["lo", "TI"],
     " and ",
     StyleBox["hi", "TI"],
     " edges"
    }], "TableText",ExpressionUUID->"5835a707-d14b-44a7-9931-d076450b4e3b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6dce239e-cea5-4498-bd42-339fbcd0398c"], Cell[TextData[{
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "fde7c790-68db-41e1-85e6-0106011819d1"],
     " (default)"
    }], "TableText",ExpressionUUID->"48257899-e323-479e-84f7-1da38ad1a590"], 
    Cell["unbounded \[LongDash] the lines through the seed", "TableText",
     ExpressionUUID->"24a0c1a4-2cb7-4c98-8576-74e4e9b758e4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ee0e177d-51d5-4b86-ac5b-c774fb45a7d8"], Cell[
    "0", "TableText",ExpressionUUID->"a02c2ab9-26d7-42d4-9d25-756b83e54b47"], 
    Cell["none \[LongDash] the seed itself", "TableText",ExpressionUUID->
     "584d35f0-65c4-492d-b289-9e5b3e5b3a0a"]}
  }]], "2ColumnTableMod",ExpressionUUID->"1d6dedf1-1993-46ac-9a84-\
7b4a9536f0fe"],

Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca5448ff-530c-4298-bebd-4c336acfd545"],
 " returns the ",
 StyleBox["pool",
  FontWeight->"Bold"],
 ": a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dfe8819-4d90-498c-9cc5-6515fc441e97"],
 " of DAGs, one per admissible pair of ends, whose source-to-sink paths are \
exactly the extensions with those ends. A single admissible pair gives the \
one DAG, not a list. A bounded count streams extensions off the admissible \
pairs, each a directed path graph."
}], "Notes",ExpressionUUID->"d64f0801-8881-4df8-b6f4-ead7c1caedb9"],

Cell[TextData[{
 "With the budget ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22260e15-dac4-44f9-b32d-dd3189b1c0ef"],
 " the extensions are the lines through the seed, the family of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c351b08f-67d9-4db7-a872-43173a946029"],
 ", which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e572a51c-921c-422f-a6da-1a2d4a6112f4"],
 " counts without enumerating."
}], "Notes",ExpressionUUID->"51152f12-5730-424b-ac0f-e219b085476c"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "148994cc-a2af-4c55-904a-f51976ced588"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"7d185171-5831-4e5f-b1e8-b8708692c819"],
