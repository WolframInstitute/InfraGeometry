     "exactly ",
     StyleBox["k", "TI"],
     " edges"
    }], "TableText",ExpressionUUID->"c908be73-ab65-47a7-875f-7a9cb37d35d0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f1b7e3f4-68ab-40ca-89b0-2e328e64a3d2"], Cell[TextData[{
     "{",
     StyleBox["lo", "TI"],
     ", ",
     StyleBox["hi", "TI"],
     "}"
    }], "TableText",ExpressionUUID->"c3ecd431-c0ce-48d6-9b72-ef683f657465"], 
    Cell[TextData[{
     "between ",
     StyleBox["lo", "TI"],
     " and ",
     StyleBox["hi", "TI"],
     " edges"
    }], "TableText",ExpressionUUID->"02c13141-0418-43cc-bc32-8590f369be42"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1ab3ebd4-f32f-4377-8570-34b5d0573b7b"], Cell[TextData[{
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "cf068539-9676-4ba7-860d-07133ad28c09"],
     " (default)"
    }], "TableText",ExpressionUUID->"9662c973-5bb5-41b2-a367-7cbb99dbc128"], 
    Cell["unbounded \[LongDash] the lines through the seed", "TableText",
     ExpressionUUID->"da441e56-991a-4966-9018-a8a4252fe2cb"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6f218e14-40c4-4184-80ec-64b116e187e1"], Cell[
    "0", "TableText",ExpressionUUID->"e688568d-3b30-47ca-936b-127f4aa8a125"], 
    Cell["none \[LongDash] the seed itself", "TableText",ExpressionUUID->
     "058ffec7-8858-4ad9-8064-47a56234456b"]}
  }]], "2ColumnTableMod",ExpressionUUID->"80bd9543-0494-450d-8df0-\
bf5856a7ad3c"],

Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9843aa41-1c82-436c-a416-b02cb2acebc9"],
 " returns the ",
 StyleBox["pool",
  FontWeight->"Bold"],
 ": a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b789e570-4fd6-4cc8-b137-72cc79d8168b"],
 " of DAGs, one per admissible pair of ends, whose source-to-sink paths are \
exactly the extensions with those ends. A single admissible pair gives the \
one DAG, not a list. A bounded count streams extensions off the admissible \
pairs, each a directed path graph."
}], "Notes",ExpressionUUID->"b77c5fbc-4410-490f-b448-d91fa215427a"],

Cell[TextData[{
 "With the budget ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1383acf2-ed3f-474d-b842-416af046a603"],
 " the extensions are the lines through the seed, the family of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6595c97e-f1fd-4deb-9279-6890b5e7bc53"],
 ", which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "47ce0db2-5430-41f8-b504-f156bde6126e"],
 " counts without enumerating."
}], "Notes",ExpressionUUID->"ff274f68-d257-4a31-b979-c4007d9e64dd"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5a262ce6-f307-40a4-84fc-7f128ca047b9"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"e31356e3-5df7-47ed-972b-29df28f68bdd"],
