    }], "TableText",ExpressionUUID->"d2f334c6-6662-4ce1-816a-fef23bfcfcf5"]}
  }]], "3ColumnTableMod",ExpressionUUID->"83b4dd73-b5d7-4548-85c6-\
d2493e39d9a1"],

Cell[TextData[{
 "The five-argument form is Tarski's axiom A4: from ",
 StyleBox["a", "TI"],
 " through ",
 StyleBox["b", "TI"],
 ", lay off a segment congruent to ",
 StyleBox["cd", "TI"],
 ". It returns every vertex ",
 StyleBox["x", "TI"],
 " at distance ",
 StyleBox["d(c, d)", "TI"],
 " beyond ",
 StyleBox["b", "TI"],
 " on a geodesic from ",
 StyleBox["a", "TI"],
 "; a trailing count ",
 StyleBox["n", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b77cce30-aae0-4936-8f2d-6aa2429cfd6a"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39567522-124d-4441-bac5-c12dccef2098"],
 " bounds the list."
}], "Notes",ExpressionUUID->"52bf4dc2-3acb-443a-a729-7427d771a4c3"]
}, Open  ]],

