    }], "TableText",ExpressionUUID->"d0be5088-0b45-4ac4-904f-3d5406aebc9d"]}
  }]], "3ColumnTableMod",ExpressionUUID->"08e73e1e-ab91-4933-bea6-\
c2d4f4b31187"],

Cell[TextData[{
 "The five-argument form is Tarski's axiom A4: from ",
 StyleBox["a", "TI"],
 " through ",
 StyleBox["b", "TI"],
 ", lay off a segment congruent to ",
 StyleBox["cd", "TI"],
 ". It returns every vertex ",
 StyleBox["x", "TI"],
 " at distance ",
 StyleBox["d(c, d)", "TI"],
 " beyond ",
 StyleBox["b", "TI"],
 " on a geodesic from ",
 StyleBox["a", "TI"],
 "; a trailing count ",
 StyleBox["n", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c830a961-02d4-4062-a069-bae64df2e45a"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "728d87c8-ea89-4787-88b3-aabdbea1449f"],
 " bounds the list."
}], "Notes",ExpressionUUID->"fa80f293-94df-4202-a85a-e3a2d0192bbe"]
}, Open  ]],

