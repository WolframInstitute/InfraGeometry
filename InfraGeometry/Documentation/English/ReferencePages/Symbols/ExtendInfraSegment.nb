Cell["\<\
With no budget the pool carries the lines through the seed: two DAGs for the \
twelve lines through the edge.\
\>", "ExampleText",ExpressionUUID->"adefe670-10b0-4978-8cf0-905137eaca09"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"ExtendInfraSegment", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "Infinity", ",", " ", 
        "All"}], "]"}]}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraLine", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "All"}], "]"}]}], ",",
      "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraLine", "[", 
        RowBox[{"6", ",", " ", "7"}], "]"}], ",", 
       " ", "\"\<Cardinality\>\""}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8fda9fed-9675-41e5-958f-bd5588bb8380"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "12", ",", "12"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"54e34f98-989c-4f6a-9c03-f8f863ba9a81"]
}, Open  ]],

Cell["\<\
Exactly one step per side gives the same seven as at most one, since every \
one-step extension is inextensible within the budget.\
\>", "ExampleText",ExpressionUUID->"dd2699eb-2d2c-4dcc-97ae-e270d9f44407"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"ExtendInfraSegment", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", 
      RowBox[{"{", "1", "}"}], ",", " ", "All"}], "]"}], " ", "===", " ", 
    RowBox[{"ExtendInfraSegment", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "1", ",", " ", "All"}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b31edc9b-a3d7-4891-8ec7-ceee1e46497f"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"9a82bcf4-8d0b-4d9b-9808-37fd249da616"]
