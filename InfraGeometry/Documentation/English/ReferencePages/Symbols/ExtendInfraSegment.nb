     FontWeight->Bold,ExpressionUUID->"9aee215d-0bcc-41cf-8d31-fa5878117a49"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0903d3aa-78c6-4c75-b381-bf5b648c0f15"], Cell[TextData[StyleBox[
    "k", "TI"]], "TableText",ExpressionUUID->
     "69fd816d-bd60-4926-a6a1-8eca20713dfe"], Cell[TextData[{
     "at most ",
     StyleBox["k", "TI"],
     " edges"
    }], "TableText",ExpressionUUID->"a3a9a7ce-99cb-463d-a945-c93ca3791811"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "43c2e50b-1621-473b-adeb-ab6dd120c4ab"], Cell[TextData[{
     "{",
     StyleBox["k", "TI"],
     "}"
    }], "TableText",ExpressionUUID->"9fa831a1-ed93-459c-b23b-d72b8f27f202"], 
    Cell[TextData[{
     "exactly ",
     StyleBox["k", "TI"],
     " edges"
    }], "TableText",ExpressionUUID->"f26969e8-abc8-4c30-9320-5b2f1b434160"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "06d4a4d4-8db9-4377-a90c-3eebe172d20c"], Cell[TextData[{
     "{",
     StyleBox["lo", "TI"],
     ", ",
     StyleBox["hi", "TI"],
     "}"
    }], "TableText",ExpressionUUID->"828dc1c8-a6dd-4c40-bd27-004c6dba2442"], 
    Cell[TextData[{
     "between ",
     StyleBox["lo", "TI"],
     " and ",
     StyleBox["hi", "TI"],
     " edges"
    }], "TableText",ExpressionUUID->"d575b85f-b22e-4513-9f5b-7a662a4a04f3"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fd539072-4d6b-4b98-b770-04ff10100e02"], Cell[TextData[{
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a86fb344-b5ff-4975-86ca-6192ebfd3d7b"],
     " (default)"
    }], "TableText",ExpressionUUID->"0ecce66f-ac3e-4dd0-8762-27ffae94cf38"], 
    Cell["unbounded \[LongDash] the lines through the seed", "TableText",
     ExpressionUUID->"18da33db-38ed-4a4a-ae77-1e0f982fc801"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1c85457c-37f3-4ebf-ac27-9e42cd691adc"], Cell[
    "0", "TableText",ExpressionUUID->"f51f4295-9b2a-4455-9d6e-b5646d5b3dc1"], 
    Cell["none \[LongDash] the seed itself", "TableText",ExpressionUUID->
     "f7dd3241-6733-451d-a8b8-115e6a46bcb5"]}
  }]], "2ColumnTableMod",ExpressionUUID->"194f1755-0807-4777-81a2-\
bd325b399ac1"],

Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "91c75e2d-5d80-4b66-ade6-38dcd56e42dd"],
 " returns the ",
 StyleBox["pool",
  FontWeight->"Bold"],
 ": a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0003a79a-489d-4b6b-8774-d3901174c240"],
 " of DAGs, one per admissible pair of ends, whose source-to-sink paths are \
exactly the extensions with those ends. A single admissible pair gives the \
one DAG, not a list. A bounded count streams extensions off the admissible \
pairs, each a directed path graph."
}], "Notes",ExpressionUUID->"84821434-e23e-4d18-8c7c-7ea66d242fd6"],

Cell[TextData[{
 "With the budget ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ecd7eff9-7d89-4ef5-b8aa-ea918601a243"],
 " the extensions are the lines through the seed, the family of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4439fbca-7758-4544-8437-3d9cdc68993b"],
 ", which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "31ac6583-2294-4027-95ac-237332d59270"],
 " counts without enumerating."
}], "Notes",ExpressionUUID->"330cf294-315d-4b85-8b77-67853d46b404"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "39e24641-f029-4b4d-8e80-0dc61e2eccd1"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"a1918081-a8bb-4dc7-b9da-a341456b94cd"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"9255895e-2806-43de-9ef6-a3300b426d29"],
     Cell["Meaning", "TableText",
     FontWeight->Bold,ExpressionUUID->"06efa499-3463-4457-8dbb-e1f030cdf6fe"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f7039ddb-ac10-49e2-b078-bcc17967b2a6"], Cell[TextData[Cell[
    BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "947c02df-96fe-43b5-ae6b-36807ecee49f"]], "TableText",ExpressionUUID->
     "3cd9d33e-0a37-4ed2-bb67-bb36f8ca1d84"], Cell[TextData[{
     Cell[BoxData["Identity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c437b75e-2399-497c-bb8f-ffff2b2271a3"],
     " (default), ",
     Cell[BoxData["RandomSample"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8d617a01-001f-4c78-ab76-518870b0b04b"],
     ", any function"
    }], "TableText",ExpressionUUID->"8f038f7b-9fca-4b7c-8a6a-3be6ed8f200e"], 
    Cell[TextData[{
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e880abb3-22e6-4d20-bb4b-17c9b8eee497"],
     " gives the pool. A bounded or absent count takes the admissible pairs \
and the branches of each DAG in the order the function gives: ",
     Cell[BoxData["Identity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "891a1d91-6386-4d96-b4c6-ce2dc868e2b9"],
     " the canonical order, so the count-less call is deterministic; ",
     Cell[BoxData["RandomSample"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "da2c46ab-8920-440d-b808-37f2ee76e2af"],
     " a random order, seeded by an ambient ",
     Cell[BoxData["SeedRandom"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "86efce60-e87c-452a-8818-909e1e9cd1ad"],
     ". The class is the same under every value."
    }], "TableText",ExpressionUUID->"26fddee5-e02f-489f-8ac1-249cff9d8ae0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b3cdea8f-5dbe-44b7-85bf-1183e17443b5"], Cell[TextData[Cell[
    BoxData["\"\<Direction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "90f13378-b3cd-4a37-a63d-1554193ff519"]], "TableText",ExpressionUUID->
     "ce3d31fc-4449-4a59-803a-482fbbd49dc2"], Cell[TextData[{
     Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "12a9fb1c-d218-4f2f-bdc4-d202a1b59686"],
     " (default), ",
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "df027fb2-d8c9-4e4e-9e65-0f2d15222f60"],
     ", ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2d05aa3a-a100-4359-a028-7eb1c3866b2e"]
    }], "TableText",ExpressionUUID->"9c2ae2d3-e0d6-4a4b-be57-af92d5893f8e"], 
    Cell[TextData[{
     "which ends may move: ",
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0c85f5c6-ad4b-4055-82c5-b63da535eaa8"],
     " keeps ",
     StyleBox["p1", "TI"],
     " and extends past ",
     StyleBox["p2", "TI"],
     " only, ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "99dda4aa-74d9-4295-a3f9-9d1240cd2378"],
     " the reverse."
    }], "TableText",ExpressionUUID->"b4d6adce-a08c-4721-b37d-791a17c0f148"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f4a120a7-6c73-4bb9-9fcb-7b83f3ad3aee"], Cell[TextData[Cell[BoxData[
    "Properties"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "809727a4-e2dc-424c-9b06-2693cbd56bf5"]], "TableText",ExpressionUUID->
     "c0d61a70-a68d-4620-a679-7f548840a75b"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9886f444-8053-4060-860c-a0f0c48ea90b"]], "TableText",ExpressionUUID->
     "702d77b0-8af1-4abe-b1ac-f99adaf0236a"], Cell[TextData[{
     "only the empty list; a rule on the extension is a local law and lives \
on ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["ExtendInfraGeodesic"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraGeodesic", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "17093f34-a98e-4199-a830-1ac8545e110c"],
     "."
    }], "TableText",ExpressionUUID->"5ec38425-2280-4b9b-85fb-b97f6bc13946"]}
  }]], "3ColumnTableMod",ExpressionUUID->"f0f56c87-e485-4e85-9fa6-\
8d62ad667af7"],

Cell[TextData[{
 "The five-argument form is Tarski's axiom A4: from ",
 StyleBox["a", "TI"],
 " through ",
 StyleBox["b", "TI"],
 ", lay off a segment congruent to ",
 StyleBox["cd", "TI"],
 ". It returns every vertex ",
 StyleBox["x", "TI"],
 " at distance ",
 StyleBox["d(c, d)", "TI"],
 " beyond ",
 StyleBox["b", "TI"],
 " on a geodesic from ",
 StyleBox["a", "TI"],
 "; a trailing count ",
 StyleBox["n", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2befde8-99fb-44bb-a684-5a7d388ace03"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8985e4c-22aa-4ff1-b60f-5b67a0022d34"],
 " bounds the list."
}], "Notes",ExpressionUUID->"ccfb0aab-d922-45c3-840a-b9ada62e1a66"]
}, Open  ]],

