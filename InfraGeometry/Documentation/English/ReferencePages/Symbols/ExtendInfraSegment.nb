Cell["\<\
With no budget the pool carries the lines through the seed: two DAGs for the \
twelve lines through the edge.\
\>", "ExampleText",ExpressionUUID->"719c3c55-a11a-4578-91dd-e8fbcff3a022"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"ExtendInfraSegment", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "Infinity", ",", " ", 
        "All"}], "]"}]}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraLine", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "All"}], "]"}]}], ",",
      "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraLine", "[", 
        RowBox[{"6", ",", " ", "7"}], "]"}], ",", 
       " ", "\"\<Cardinality\>\""}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a6502030-8c69-48b9-9eea-c02ce7129939"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "12", ",", "12"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"be98793f-653a-4c9d-8da6-43aeaf00a9f6"]
}, Open  ]],

Cell["\<\
Exactly one step per side gives the same seven as at most one, since every \
one-step extension is inextensible within the budget.\
\>", "ExampleText",ExpressionUUID->"9f07656b-7bb9-4532-982f-7d87d46afdd4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"ExtendInfraSegment", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", 
      RowBox[{"{", "1", "}"}], ",", " ", "All"}], "]"}], " ", "===", " ", 
    RowBox[{"ExtendInfraSegment", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "1", ",", " ", "All"}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"aaa6faeb-c32e-45d5-a211-e8c7f0547542"],

Cell[BoxData["True"], "Output",
