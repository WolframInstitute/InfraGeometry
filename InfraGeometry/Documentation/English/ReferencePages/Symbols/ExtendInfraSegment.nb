Cell["\<\
With no budget the pool carries the lines through the seed: two DAGs for the \
twelve lines through the edge.\
\>", "ExampleText",ExpressionUUID->"96d9db1f-d10a-4697-ac46-d09cf2b435bd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"ExtendInfraSegment", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "Infinity", ",", " ", 
        "All"}], "]"}]}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraLine", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "All"}], "]"}]}], ",",
      "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraLine", "[", 
        RowBox[{"6", ",", " ", "7"}], "]"}], ",", 
       " ", "\"\<Cardinality\>\""}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7f16d2a8-b910-4a27-91aa-1fac20bc469e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "12", ",", "12"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"16eb55a5-2974-4c40-a851-d0d9fc3c9144"]
}, Open  ]],

Cell["\<\
Exactly one step per side gives the same seven as at most one, since every \
one-step extension is inextensible within the budget.\
\>", "ExampleText",ExpressionUUID->"9077e4bd-74da-4b88-9a14-ba17c90e4169"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"ExtendInfraSegment", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", 
      RowBox[{"{", "1", "}"}], ",", " ", "All"}], "]"}], " ", "===", " ", 
    RowBox[{"ExtendInfraSegment", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "1", ",", " ", "All"}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"444dac9e-6843-41df-8a45-2f486c9918fb"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"38e48a0f-d09e-43a9-a58a-f42c0f3f0aff"]
