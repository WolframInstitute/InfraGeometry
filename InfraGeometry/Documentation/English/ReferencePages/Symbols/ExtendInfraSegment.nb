       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "0f9a76d9-a09b-45b8-b1be-d4cc72e55cc9"],
     "."
    }], "TableText",ExpressionUUID->"e23ac287-a243-43ed-8719-310ea184aef3"]}
  }]], "3ColumnTableMod",ExpressionUUID->"b0bd8799-2076-4a43-aa56-\
d4c73fa71d1a"],

Cell[TextData[{
 "The five-argument form is Tarski's axiom A4: from ",
 StyleBox["a", "TI"],
 " through ",
 StyleBox["b", "TI"],
 ", lay off a segment congruent to ",
 StyleBox["cd", "TI"],
 ". It returns every vertex ",
 StyleBox["x", "TI"],
 " at distance ",
 StyleBox["d(c, d)", "TI"],
 " beyond ",
 StyleBox["b", "TI"],
 " on a geodesic from ",
 StyleBox["a", "TI"],
 "; a trailing count ",
 StyleBox["n", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebafff2d-8b58-443f-a9b9-26444520247a"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0a85132-ea01-4f05-80fa-314e8825ffa5"],
 " bounds the list."
}], "Notes",ExpressionUUID->"82469aaa-e538-43cd-91db-a7bacf456c6b"]
}, Open  ]],

