Notebook[{

Cell[CellGroupData[{
Cell["ExtendInfraSegment", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3eb9060f-28f1-4a52-abef-deb6304bc0f7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce952885-831d-409c-94dc-363452330ba4"],
 "\[LineSeparator]",
 "gives one geodesic containing ",
 StyleBox["seg", "TI"],
 ", extended past its ends by at most ",
 StyleBox["kspec", "TI"],
 " edges on each side and inextensible within that budget, as a directed path \
graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"047a6b3b-c815-4cbb-a912-cfae1b5393d1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f89b2666-64b8-4824-a1b2-1517b8b7ad49"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8cd19ddb-df59-4f2d-bd3d-7f65c9316d39"],
 " of exactly ",
 StyleBox["n", "TI"],
 " extensions or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac5839c6-a3b5-4562-85c3-009ac6af6a2f"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5aa3b4d-b3d5-43af-8e94-ce3e1297f079"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1701d82-9e89-4d8b-b63a-e894ddbf9e61"],
 " gives the whole class as a pool of DAGs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"23ab9190-89b9-4efa-9a66-f7a842dfef90"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28aa5be7-1acc-4700-96a7-86226b60b4e9"],
 "\[LineSeparator]",
 "gives the vertices ",
 StyleBox["x", "TI"],
 " with ",
 StyleBox["b", "TI"],
 " between ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["x", "TI"],
 " and ",
 StyleBox["d(b, x) = d(c, d)", "TI"],
 " \[LongDash] Tarski's segment construction, axiom A4 \[LongDash] as a \
vertex list."
}], "Usage",ExpressionUUID->"3681987f-a9ac-47a9-8c2d-534fb3a8a15e"],

Cell[TextData[{
 "The seed ",
 StyleBox["seg", "TI"],
 " is a geodesic vertex list, or a geodesic DAG such as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "]"}], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "743d34a0-0386-4074-8081-6c015c4d4802"],
 ". A DAG extends ",
 StyleBox["as one object",
  FontWeight->"Bold"],
 ": the whole bundle from ",
 StyleBox["p1", "TI"],
 " to ",
 StyleBox["p2", "TI"],
 " gets the same ends."
}], "Notes",ExpressionUUID->"d12ab0f9-3f0c-45af-a598-cb1f2594a6a9"],

Cell[TextData[{
 "Everything is read off the distance matrix. With the seed running from ",
 StyleBox["p1", "TI"],
 " to ",
 StyleBox["p2", "TI"],
 ", a pair of ends (",
 StyleBox["s", "TI"],
 ", ",
 StyleBox["e", "TI"],
 ") is ",
 StyleBox["admissible",
  FontWeight->"Bold"],
 " when ",
 StyleBox["d(s, e) = d(s, p1) + d(p1, p2) + d(p2, e)", "TI"],
 " \[LongDash] the concatenation is a geodesic whichever geodesics are used, \
so the condition reads only the ends \[LongDash] when the larger of ",
 StyleBox["d(p1, s)", "TI"],
 " and ",
 StyleBox["d(p2, e)", "TI"],
 " passes ",
 StyleBox["kspec", "TI"],
 ", and when each free side is either at the budget or inextensible. The \
candidate ends are the vertices of the two extension graphs ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p2", "TI"], ",", " ", 
      StyleBox["p1", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a729af41-0dea-4f43-9c94-f9cf5a0ab400"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicExtensionGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23da4237-9aa4-4c02-9149-7705dc9f58cb"],
 ", cut at the budget."
}], "Notes",ExpressionUUID->"16926dbe-9f5f-482b-924f-69f55f802404"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "96868627-4cfd-4ae0-8fa5-29581822c597"], Cell[TextData[StyleBox[
    "kspec", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"472438e5-80fd-4796-b820-fdcdc901526f"],
