     "710716d2-ed1c-419d-a70b-c5bcefd8acc7"], Cell[TextData[Cell[BoxData[
    "Method"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3923377d-b7d0-4e7f-b878-b552b74b8592"]], "TableText",ExpressionUUID->
     "ecaa2572-9fba-4f6f-8a4e-2a673df578d7"], Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "90106271-ea18-401b-862c-06d609cdf8ca"],
     " (default), ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "94e09408-27b3-4ed5-bf6f-e44cc9093a21"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
        RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "56ad4e1e-616c-499e-a138-8348e54768e5"],
     ", ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f417c5c3-989d-40d7-afb0-b6a04ad37f21"],
     ", ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e2e74fc7-c553-4a8a-a367-33feb2f41fe5"]
    }], "TableText",ExpressionUUID->"9a5fd9e1-7d46-49ba-b5ab-6abe0bd5970d"], 
    Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "69c93a56-9f92-4534-a417-44f13bd83936"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4ddc1edd-7dd3-4039-915b-9ffda9d15e90"],
     " to ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0e762d36-233c-4691-9c1a-69c6bf1a9827"],
     ", the pool; a bounded or absent count to ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8e37b146-b225-48c4-8d62-0d872f3b7fb3"],
     ", which takes the admissible pairs and the branches of each DAG in \
candidate order, so the count-less call is deterministic. ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9f100262-22f0-4855-85e8-eb194995059c"],
     " takes them in random order, seeded by an ambient ",
     Cell[BoxData["SeedRandom"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ae48c256-ccf3-40c6-9eac-cc5133d3e8dc"],
     ". The class is the same under every value; ",
     Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f9d992b3-d27f-4803-a693-c3c344cc8892"],
     " is accepted and inert, the pool having no frontier to cap."
    }], "TableText",ExpressionUUID->"2e78d602-89ce-48df-a88f-16581ed7b8df"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "50e29b23-e06c-49b1-880a-8eea0333d569"], Cell[TextData[Cell[
    BoxData["\"\<Direction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "451341e0-356b-4076-b8a4-283894f63878"]], "TableText",ExpressionUUID->
     "08ef697b-c4e7-4fa4-87b0-ebdf6aae3a4a"], Cell[TextData[{
     Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6c1e699f-60d0-4842-a0f2-f8526955b15e"],
     " (default), ",
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "488fc301-0e2d-45fe-9107-f832f72feeb7"],
     ", ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "02b72ebe-6f2b-4fd6-9c89-ca70b1dd047f"]
    }], "TableText",ExpressionUUID->"ccec24c9-3214-42e9-8099-b1969164dac7"], 
    Cell[TextData[{
     "which ends may move: ",
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "441a13e3-7cf0-4433-9fc7-7db0c978181a"],
     " keeps ",
     StyleBox["p1", "TI"],
     " and extends past ",
     StyleBox["p2", "TI"],
     " only, ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "21ccb6a6-e1be-49b6-b790-bcf3991ea31e"],
     " the reverse."
    }], "TableText",ExpressionUUID->"41c9a896-3b0b-4333-954b-b1405fbe5575"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7ac6f8a4-c88a-4496-8b48-efd277cba46c"], Cell[TextData[Cell[BoxData[
    "Properties"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2140c959-184e-4948-8e01-ebe77891c5f6"]], "TableText",ExpressionUUID->
     "0b89ff02-ef31-4ade-985f-5e2f71ef2d78"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3513598f-3553-4055-88f0-0e8f0b9e22ee"]], "TableText",ExpressionUUID->
     "9d644a94-36d1-4148-bb5c-b98b7323c3c5"], Cell[TextData[{
     "only the empty list; a rule on the extension is a local law and lives \
on ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["ExtendInfraGeodesic"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/ExtendInfraGeodesic", 
