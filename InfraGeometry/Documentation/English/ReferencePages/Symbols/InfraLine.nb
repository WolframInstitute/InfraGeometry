   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraLine", "[", 
         RowBox[{"1", ",", " ", "2"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
       "]"}]}], ",", " ", 
     RowBox[{"InfraVertexList", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraLine", "[", 
