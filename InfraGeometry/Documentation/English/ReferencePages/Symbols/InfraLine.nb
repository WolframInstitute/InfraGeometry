   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraLine", "[", 
         RowBox[{"1", ",", " ", "2"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
       "]"}]}], ",", " ", 
     RowBox[{"InfraVertexList", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraLine", "[", 
        RowBox[{"1", ",", " ", "2"}], "]"}], ",", " ", "All"}], "]"}]}], 
    "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"1f0fb4ef-1335-4e25-ac6b-165b683ce608"],

Cell[BoxData[
 RowBox[{"{", 
