Cell["\<\
The anchors lie on every line, so their density is the cardinality.\
\>", "ExampleText",ExpressionUUID->"db830741-0138-4370-9eab-b72ed7dec2f7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"density", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraLine", "[", 
        RowBox[{"6", ",", " ", "7"}], "]"}], ",", 
       " ", "\"\<VertexDensity\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"density", "[", "6", "]"}], ",", " ", 
     RowBox[{"density", "[", "7", "]"}], ",", " ", 
     RowBox[{"density", "[", "1", "]"}]}], "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fa6bbabd-492f-4830-a6d5-d0af023a47bb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"12", ",", "12", ",", "6"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e273e376-f91a-40c2-b89e-43e815d569d2"]
}, Open  ]],

