Cell["\<\
The anchors lie on every line, so their density is the cardinality.\
\>", "ExampleText",ExpressionUUID->"b6312031-ca5f-4ed6-8481-350eb0a2c309"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"density", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraLine", "[", 
        RowBox[{"6", ",", " ", "7"}], "]"}], ",", 
       " ", "\"\<VertexDensity\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"density", "[", "6", "]"}], ",", " ", 
     RowBox[{"density", "[", "7", "]"}], ",", " ", 
     RowBox[{"density", "[", "1", "]"}]}], "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0ec82a48-68a8-44cc-8522-b42cd687e625"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"12", ",", "12", ",", "6"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b76675a0-077b-4c2d-98ac-1c18af083263"]
}, Open  ]],

