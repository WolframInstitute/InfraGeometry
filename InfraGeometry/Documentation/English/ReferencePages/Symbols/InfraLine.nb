Cell["\<\
Through an edge of the 6-cycle there are three lines, one per DAG.\
\>", "ExampleText",ExpressionUUID->"d67d2b00-76f9-4adb-bd6a-14995dcb14c4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "6", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraLine", "[", 
         RowBox[{"1", ",", " ", "2"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
       "]"}]}], ",", " ", 
     RowBox[{"InfraVertexList", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraLine", "[", 
        RowBox[{"1", ",", " ", "2"}], "]"}], ",", " ", "All"}], "]"}]}], 
    "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"461b72cf-c553-499e-a1f3-b0680804793c"],

Cell[BoxData[
 RowBox[{"{", 
