  "80f030db-4706-4709-9531-7ec322c77542"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraVertexList", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "faa9a6a9-638d-47cc-9d4d-fc32501ea364"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"24025383-e642-43f6-95b0-69c6018ba16e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31b63905-b5ba-4864-89fe-f67cacefcccd"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
