Cell["\<\
The line through a geodesic germ, beside the line through its two ends. The \
ends of a bent germ lie on the lines of the rectangle between them, the germ \
on those that run along it.\
\>", "ExampleText",ExpressionUUID->"5e769091-f1ea-4bd8-b70b-6584a1b7e168"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "p", ",", " ", "2"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"germ", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FindInfraSegment", "[", 
       RowBox[{"g", ",", " ", "p", ",", " ", "q", ",", " ", "All"}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"{", "\n", "    ", 
       RowBox[{
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"InfraLine", "[", "germ", "]"}], ",", " ", 
              RowBox[{"InfraWalk", "[", "germ", "]"}], ",", " ", "p", ",", 
              " ", "q"}], "}"}]}], "]"}], ",", " ", "\"\<germ\>\""}], "]"}], ",",
         "\n", "    ", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"InfraLine", "[", 
               RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "p", ",", " ", 
              "q"}], "}"}]}], "]"}], ",", " ", "\"\<ends\>\""}], "]"}]}], 
       "}"}]}], ",", "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraLine", "[", "germ", "]"}], ",", 
       " ", "\"\<Cardinality\>\""}], "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraLine", "[", 
        RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
       " ", "\"\<Cardinality\>\""}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"001f75f4-7ea9-40f2-b4d2-f3451bba02fe"],

