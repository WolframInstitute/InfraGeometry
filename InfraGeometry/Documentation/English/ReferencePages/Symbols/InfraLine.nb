Notebook[{

Cell[CellGroupData[{
Cell["InfraLine", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"707baea7-df7b-4b7a-9317-450ff0678f92"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db1c90d2-8703-428e-b443-14e421b3df41"],
 "\[LineSeparator]",
 "is the line through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ": every inextensible shortest path through ",
 StyleBox["p", "TI"],
 " and then ",
 StyleBox["q", "TI"],
 ". It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f67f3b61-94ba-4092-849e-6cda3cc6e08a"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ba6b3e34-d7af-40a2-909b-b7162923cf88"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3c80ce12-3a27-4c0e-b706-b3f51e5fe200"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["germ", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d805943e-3528-4700-be9b-7b7da1b55b20"],
 "\[LineSeparator]",
 "is the line through a geodesic germ: every inextensible shortest path that \
contains the germ as a contiguous stretch. The germ is a vertex, a vertex \
list, a walk graph or a geodesic DAG.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"cf5a377f-aced-4ba1-9709-235dee27c993"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68f0ce1c-1615-4e6a-832b-ae3eeb801f2f"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "48695b8e-0e5f-4d1b-909e-465f3a7d1e33"],
 " is the line construction token; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bd0a6b4e-0ff8-4621-9b9a-c0c8f9f5b42b"],
 " is the search."
}], "Usage",ExpressionUUID->"1710acab-0170-46df-b8cd-b43d8344011a"],

Cell["\<\
Definition: a line is an inextensible shortest path, one that no neighbour of \
either end prolongs.\
\>", "Notes",ExpressionUUID->"b394c949-bdb2-453f-b38d-bb1564583003"],

Cell[TextData[{
 "Its graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54e739e4-327b-46c6-8a57-fe67b7e50b07"],
 " \[LongDash] is a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0594d1ab-bb0e-4f0d-a7b2-eb6ac4ebb5f9"],
 " of DAGs, one per pair of ends (",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["b", "TI"],
 ") that is compatible, ",
 StyleBox["d(a, b) = d(a, p) + d(p, q) + d(q, b)", "TI"],
 ", and maximal, no neighbour of ",
 StyleBox["a", "TI"],
 " or ",
 StyleBox["b", "TI"],
 " lengthening ",
 StyleBox["d(a, b)", "TI"],
 ". The DAG for (",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["b", "TI"],
 ") is the union of the intervals ",
 StyleBox["I(a, p)", "TI"],
 ", ",
 StyleBox["I(p, q)", "TI"],
 " and ",
 StyleBox["I(q, b)", "TI"],
 ". Its chains are exactly the lines with those ends, and every line is a \
chain of exactly one DAG, so ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f496c22-753f-4499-b4d8-77e7637e289f"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b4ae602-84f9-4af1-8314-9879c3491cd2"],
 "."
}], "Notes",ExpressionUUID->"7d562cee-dd90-4263-83ea-11942fa10332"],

Cell["\<\
The list is not optional. The union of the DAGs can carry chains that are not \
shortest paths: through the edge 1\[Dash]2 of the 6-cycle there are three \
DAGs and three lines, while their union would add a fourth path that is not a \
shortest path.\
\>", "Notes",ExpressionUUID->"d887b226-1f2f-49b0-8c88-fbb8da180359"],

Cell["\<\
The DAGs are alternatives, so the counts add across them. The family can be \
astronomical while the list stays small.\
\>", "Notes",ExpressionUUID->"b6f98cda-dee3-4ca2-a9a0-83eb009f8770"],

Cell[TextData[{
 "With ",
 StyleBox["p", "TI"],
 " = ",
 StyleBox["q", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c01d924-a29f-46ae-80a1-392672084de1"],
 " is every maximal shortest path through ",
 StyleBox["p", "TI"],
 ", once per orientation."
}], "Notes",ExpressionUUID->"b2aa8d44-354e-4f5a-a6c7-dda3172941bd"],

Cell[TextData[{
 "The germ form keeps the germ's own edges in the middle. Its DAG for the \
ends (",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["b", "TI"],
 ") is the union of the intervals ",
 StyleBox["I(a, p)", "TI"],
 " and ",
 StyleBox["I(q, b)", "TI"],
 " with the edges of the germ from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " in place of ",
 StyleBox["I(p, q)", "TI"],
 ". For a straight germ these are the DAGs of ",
 Cell[BoxData[
  RowBox[{"InfraLine", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e86fd5c-9abc-403a-aef6-5db53aae049a"],
 ". For a bent germ there are fewer, since ",
 StyleBox["I(p, q)", "TI"],
 " is a rectangle and the DAG keeps only the germ. A vertex germ is ",
 Cell[BoxData[
  RowBox[{"InfraLine", "[", 
   RowBox[{"p", ",", " ", "p"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce430c5c-b843-43cc-b0b1-c0d6b913c43b"],
 "."
}], "Notes",ExpressionUUID->"3ea977af-75ae-4456-859f-1c49a80cae90"]
}, Open  ]],

