Notebook[{

Cell[CellGroupData[{
Cell["InfraLine", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"004f5191-1c98-4af5-817c-45fb06efe5c8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb285cda-96c3-4a97-9f06-8662f9397641"],
 "\[LineSeparator]",
 "is the line through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ": every inextensible shortest path through ",
 StyleBox["p", "TI"],
 " and then ",
 StyleBox["q", "TI"],
 ". It is a symbolic object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "89a65ee7-e523-43ab-87de-8dcdb9e10c50"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraInfiniteLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraInfiniteLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b68a3a86-723c-4cae-a419-1eb9bc69ee00"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e0e51dce-36e5-496a-8a60-7d0ea2fcc3ef"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["germ", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "851b79cf-5c3c-4d45-91c4-822afa2dc9c2"],
 "\[LineSeparator]",
 "is the line through a shortest-path germ: every inextensible shortest path \
that contains the germ as a contiguous stretch. The germ is a vertex, a \
vertex list, a walk graph or a shortest-path DAG.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f4d9b923-0665-4571-a8ae-0f56b6d10200"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c78d6d43-ea95-46d8-b9f7-def62f139b2b"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5bb6a400-69b2-4579-a4ae-e1d8164b03fd"],
 " is the line construction token; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "00d23358-cba9-4e8b-b2fd-f8ed0be1568a"],
 " is the search."
}], "Usage",ExpressionUUID->"6c35718b-fe24-49b4-bb7b-ebb0a7fe2ecf"],

Cell[TextData[{
 "This is the legacy compatibility spelling. New code uses ",
 Cell[BoxData["InfraInfiniteLine"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8bac7594-8478-4b1f-985e-9f055826573e"],
 ".  & Options"
}], "Notes",ExpressionUUID->"ce5f7f62-7019-47c7-8d5d-9c88282eedd8"],

Cell["\<\
Definition: a line is an inextensible shortest path, one that no neighbour of \
either end prolongs.\
\>", "Notes",ExpressionUUID->"83ba544b-b5b0-45d7-8923-aed6fb6b52ba"],

Cell[TextData[{
 "Its graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e521fdc-35ae-4c07-bffd-bb21346e42f0"],
 " \[LongDash] is a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36687f80-a907-46e7-8a6c-b0d90f2ba695"],
 " of DAGs, one per pair of ends (",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["b", "TI"],
 ") that is compatible, ",
 StyleBox["d(a, b) = d(a, p) + d(p, q) + d(q, b)", "TI"],
 ", and maximal, no neighbour of ",
 StyleBox["a", "TI"],
 " or ",
 StyleBox["b", "TI"],
 " lengthening ",
 StyleBox["d(a, b)", "TI"],
 ". The DAG for (",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["b", "TI"],
 ") is the union of the intervals ",
 StyleBox["I(a, p)", "TI"],
 ", ",
 StyleBox["I(p, q)", "TI"],
 " and ",
 StyleBox["I(q, b)", "TI"],
 ". Its chains are exactly the lines with those ends, and every line is a \
chain of exactly one DAG, so ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cf52578-f302-465b-bb47-8eec618530d9"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15879f08-e96c-4944-9a8c-7bf6dcd8a928"],
 "."
}], "Notes",ExpressionUUID->"9c034b60-6a9e-46a2-9f0b-dd137ab1b6bd"],

Cell["\<\
The list is not optional. The union of the DAGs can carry chains that are not \
shortest paths: through the edge 1\[Dash]2 of the 6-cycle there are three \
DAGs and three lines, while their union would add a fourth path that is not a \
shortest path.\
\>", "Notes",ExpressionUUID->"264826a3-ca4e-4c6d-980a-c465235d6001"],

Cell["\<\
The DAGs are alternatives, so the counts add across them. The family can be \
astronomical while the list stays small.\
\>", "Notes",ExpressionUUID->"ffe09490-04c3-4ded-83fa-eeaa3f3a8758"],

Cell[TextData[{
 "With ",
 StyleBox["p", "TI"],
 " = ",
 StyleBox["q", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64253a4c-c9fa-4bbe-b928-ac2d3eb43dfe"],
 " is every maximal shortest path through ",
 StyleBox["p", "TI"],
 ", once per orientation."
}], "Notes",ExpressionUUID->"c38d348b-962f-4f9e-b41f-e9269d347a9c"],

Cell[TextData[{
 "The germ form keeps the germ's own edges in the middle. Its DAG for the \
ends (",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["b", "TI"],
 ") is the union of the intervals ",
 StyleBox["I(a, p)", "TI"],
 " and ",
 StyleBox["I(q, b)", "TI"],
 " with the edges of the germ from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " in place of ",
 StyleBox["I(p, q)", "TI"],
 ". For a straight germ these are the DAGs of ",
 Cell[BoxData[
  RowBox[{"InfraLine", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3493471-59d6-4f93-9ffb-091c9d477a2d"],
 ". For a bent germ there are fewer, since ",
 StyleBox["I(p, q)", "TI"],
 " is a rectangle and the DAG keeps only the germ. A vertex germ is ",
 Cell[BoxData[
  RowBox[{"InfraLine", "[", 
   RowBox[{"p", ",", " ", "p"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48398aad-e08c-4c42-a365-a85bff97aafa"],
 "."
}], "Notes",ExpressionUUID->"603eeab7-53c4-43f4-904f-20c2829cbd09"]
}, Open  ]],

