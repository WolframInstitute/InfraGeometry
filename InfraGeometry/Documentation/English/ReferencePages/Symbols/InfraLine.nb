    "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"84f9c7c5-98b3-42ae-9db0-b035cf4edc4b"],

Cell[BoxData[
 RowBox[{"{", 
