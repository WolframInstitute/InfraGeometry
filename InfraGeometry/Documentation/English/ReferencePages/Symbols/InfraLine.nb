Cell["\<\
The lines through an edge at the centre, and the first DAG of their list on \
its own. Each DAG carries the lines between one pair of ends.\
\>", "ExampleText",ExpressionUUID->"b58b7201-bbaf-4ee3-ad9b-bd43a461a1ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"AdjacencyList", "[", 
       RowBox[{"g", ",", " ", "p"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"InfraLine", "[", 
      RowBox[{"p", ",", " ", "q"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"line", ",", " ", "p", ",", " ", "q"}], "}"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", "line", ",", " ", "\"\<Graph\>\""}], 
            "]"}]}], ",", " ", "p", ",", " ", "q"}], "}"}]}], "]"}]}], "}"}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"4f6dfd01-dc03-4656-b6d0-ebe327791cbc"],

