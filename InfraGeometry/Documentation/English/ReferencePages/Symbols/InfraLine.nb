Cell["\<\
Twelve lines pass the interior edge 6\[Dash]7 of a 4 \[Times] 4 grid, carried \
by two DAGs.\
\>", "ExampleText",ExpressionUUID->"951c9965-41b1-4261-bfb7-fd91708b575f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"InfraLine", "[", 
      RowBox[{"6", ",", " ", "7"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "line", ",", " ", "\"\<Graph\>\""}], "]"}]}], ",",
      " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "line", ",", " ", "\"\<Cardinality\>\""}], "]"}],
      ",", "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "line", ",", " ", "\"\<Length\>\""}], "]"}]}], 
    "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5c358c20-8421-4c13-843a-a69ce053db92"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "12", ",", "6"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"433787b0-f4da-4f6b-96be-56b08630c48f"]
}, Open  ]],

