Cell["\<\
The anchors lie on every line, so their density is the cardinality. The \
vertex density, drawn alone, is heaviest at the two anchors.\
\>", "ExampleText",ExpressionUUID->"614906b7-e22e-4fbf-bff5-1849b28b3603"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "p", ",", " ", "2"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"density", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraLine", "[", 
        RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
       " ", "\"\<VertexDensity\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", "density", "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"density", "[", "p", "]"}], ",", " ", 
        RowBox[{"density", "[", "q", "]"}]}], "}"}], " ", "===", " ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraLine", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
          " ", "\"\<Cardinality\>\""}], "]"}], ",", " ", "2"}], "]"}]}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"dcb662ab-7c66-444e-be8b-2f113b7be8e3"],

