Cell[CellGroupData[{
Cell["InfraLine", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f1ab7c57-508c-46ae-98ec-3e8be0652381"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96ecb118-78a6-482d-8418-93ea3e89765a"],
 "\[LineSeparator]",
 "is the line through ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ": every inextensible shortest path through ",
 StyleBox["p", "TI"],
 " and then ",
 StyleBox["q", "TI"],
 ". It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3f315c6d-5fdb-4dd9-8793-fbe04e1571ed"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "38934dd0-f85c-4de1-a248-95cc1feaca60"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1a6ed7da-5119-45b6-8aa1-170958bb3bc1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70204b9f-605f-45cf-97bd-24b575a3f57e"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6a932a40-92e9-455f-9818-fe81bab58ca3"],
 " is the line construction token; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "29d5f1f6-9ee7-4dcd-95fa-961b0d7ed9ae"],
 " is the search."
}], "Usage",ExpressionUUID->"d526c377-73f6-49ae-912d-471d80f8b85d"],

Cell["\<\
Definition: a line is an inextensible shortest path, one that no neighbour of \
either end prolongs.\
\>", "Notes",ExpressionUUID->"b10466f9-f022-4527-b99e-aa011631ec3b"],

Cell[TextData[{
 "Its graph \[LongDash] ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "83339c90-1005-47ff-8dca-733a0b6612d9"],
 " \[LongDash] is a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c70c0aae-07f2-4ba3-8299-1565c868ec05"],
 " of DAGs, one per pair of ends (",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["b", "TI"],
 ") that is compatible, ",
 StyleBox["d(a, b) = d(a, p) + d(p, q) + d(q, b)", "TI"],
 ", and maximal, no neighbour of ",
 StyleBox["a", "TI"],
 " or ",
 StyleBox["b", "TI"],
 " lengthening ",
 StyleBox["d(a, b)", "TI"],
 ". The DAG for (",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["b", "TI"],
 ") is the union of the intervals ",
 StyleBox["I(a, p)", "TI"],
 ", ",
 StyleBox["I(p, q)", "TI"],
 " and ",
 StyleBox["I(q, b)", "TI"],
 ". Its chains are exactly the lines with those ends, and every line is a \
chain of exactly one DAG, so ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e47983c-ba6d-4267-8856-746992463f11"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07f8f873-b253-4e1f-92ac-b5a999e4f6b1"],
 "."
}], "Notes",ExpressionUUID->"e8ac7ec0-c6cc-4cf7-abcf-8e77462fb3de"],

Cell["\<\
The list is not optional. The union of the DAGs can carry chains that are not \
shortest paths: through the edge 1\[Dash]2 of the 6-cycle there are three \
DAGs and three lines, while their union would add a fourth path that is not a \
shortest path.\
\>", "Notes",ExpressionUUID->"d5bd3b89-18ca-4691-85de-a40dbcd05b01"],

Cell["\<\
The DAGs are alternatives, so the counts add across them. The family can be \
astronomical while the list stays small.\
\>", "Notes",ExpressionUUID->"6a5ec9d1-c151-485d-8638-1b2ebac42bb0"],

Cell[TextData[{
 "With ",
 StyleBox["p", "TI"],
 " = ",
 StyleBox["q", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3638398a-3c1f-4c29-8f49-dfcb37959621"],
 " is every maximal shortest path through ",
 StyleBox["p", "TI"],
 ", once per orientation."
}], "Notes",ExpressionUUID->"4f5d91b9-07f6-4b7e-ae45-6e288f15d354"]
}, Open  ]],

