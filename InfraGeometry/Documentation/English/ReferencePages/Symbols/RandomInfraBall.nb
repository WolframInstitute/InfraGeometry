Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"daeff368-95e2-4f67-bc33-fb13cddf0c53"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraBall", "[", 
     RowBox[{
      StyleBox["c", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf7fb9b8-b07b-4f24-886c-4dd70fa439d8"],
 "\[LineSeparator]",
 "samples a sorted vertex set on graph ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c62606a7-61e7-45d5-a7e4-9bb1402e87a1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraBall", "[", 
     RowBox[{
      StyleBox["c", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "]"}], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ddd27ccc-ee13-4813-83e9-bc083f4b52f3"],
 "\[LineSeparator]",
 "requests ",
 Cell[BoxData["count"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20625c2e-2dbe-4dac-8f88-5a96ca0f810c"],
 " representatives. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7514f29a-408d-45c9-bfa4-3cae3042bdf8"],
 " enumerates the full pool; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a79cd42-e8ce-43f1-978e-2d8bd8e1df46"],
 " returns at most ",
 StyleBox["n", "TI"],
 "."
}], "Usage",ExpressionUUID->"55da31e2-c277-44d8-80ec-dd81822c82ee"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomInfraBall", "[", 
   RowBox[{"g", ",", " ", "c", ",", " ", "r", ",", " ", "count"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af8a7f95-281a-4dbf-bcc4-aae2f6d2a3a9"],
 " uses the direct form."
}], "Notes",ExpressionUUID->"b05683c0-750c-495d-bfa5-5a5bffd0e28c"],

Cell[TextData[{
 "The sampler has the same token geometry as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1d108e37-372e-491c-ba84-3c2da0d7e677"],
 ". An omitted or ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8d730f5-814f-4c3f-bcad-83adbe34ee15"],
 " count returns one representative. An integer count requests exactly that \
many distinct representatives and returns ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8760bfd2-7198-45ce-82d2-0b056424a9c4"],
 " when too few exist."
}], "Notes",ExpressionUUID->"f9864216-240e-4ba6-969e-9e4ecdf0d5e0"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a06c2d3d-e6ac-4f0a-b625-f7e8313babe6"],
 " selects deterministically. Default ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd4926dc-7489-4293-980e-6a92ae29a2fa"],
 " does not advance random state. Seed an ordinary draw with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de949cd0-a1c4-4590-8385-fb71d0da6969"],
 "."
}], "Notes",ExpressionUUID->"bfd36f2e-f592-4443-8802-dbbcac5108e1"],

