Cell["\<\
Three configurations at the centre of a square grid. Opposite arms of a line \
give exactly \[Pi]. The same direction gives exactly 0.\
\>", "ExampleText",ExpressionUUID->"3e264a79-609a-4dd5-8691-aa0f5d20b632"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"i", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FirstPosition", "[", 
       RowBox[{"line", ",", " ", "c"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<opposite arms\>\"", " ", "->", " ", 
      RowBox[{"N", " ", "@", " ", 
       RowBox[{"InfraAngle", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"line", "[", 
            RowBox[{"[", 
             RowBox[{"i", " ", "-", " ", "4"}], "]"}], "]"}], ",", " ", "c", ",",
            " ", 
           RowBox[{"line", "[", 
            RowBox[{"[", 
             RowBox[{"i", " ", "+", " ", "4"}], "]"}], "]"}]}], "}"}], ",", 
         " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], 
        "]"}]}]}], ",", "\n", "    ", 
     RowBox[{"\"\<same direction\>\"", " ", "->", " ", 
      RowBox[{"N", " ", "@", " ", 
       RowBox[{"InfraAngle", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"line", "[", 
            RowBox[{"[", 
             RowBox[{"i", " ", "+", " ", "4"}], "]"}], "]"}], ",", " ", "c", ",",
            " ", 
           RowBox[{"line", "[", 
            RowBox[{"[", 
             RowBox[{"i", " ", "+", " ", "2"}], "]"}], "]"}]}], "}"}], ",", 
         " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], 
        "]"}]}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"84439137-b784-4862-a909-f087fac5bef7"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"opposite arms\"\>", "\[Rule]", "3.141592653589793`"}], ",", 
   RowBox[{"\<\"same direction\"\>", "\[Rule]", "0.`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"93ec6706-2955-4522-ac42-ca48a871338b"]
}, Open  ]],

Cell["\<\
The Alexandrov method is the closed form in three distances, and agrees with \
it exactly.\
\>", "ExampleText",ExpressionUUID->"db53da67-f557-4796-835e-fcc040d38f40"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"x1", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "4"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"x2", " ", "=", " ", 
     RowBox[{"Last", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "4"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"d1", " ", "=", " ", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "x1"}], "]"}]}], ",", " ", 
     RowBox[{"d2", " ", "=", " ", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "x2"}], "]"}]}], ",", " ", 
     RowBox[{"ch", " ", "=", " ", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", "x1", ",", " ", "x2"}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"InfraAngle", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"x1", ",", " ", "c", ",", " ", "x2"}], "}"}], ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], "]"}]}], ",",
      "\n", "   ", 
     RowBox[{"ArcCos", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"d1", "^", "2"}], " ", "+", " ", 
         RowBox[{"d2", "^", "2"}], " ", "-", " ", 
         RowBox[{"ch", "^", "2"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2.", " ", "d1", " ", "d2"}], ")"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0190cfef-6c73-4d21-954a-85fd716fbdb7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3.141592653589793`", ",", "3.141592653589793`"}], "}"}]], "Output",\

 CellLabel->"Out[2]= ",ExpressionUUID->"35a892f6-65ed-4ec4-a684-1b55824bdd7f"]
}, Open  ]],

Cell["\<\
The two methods answer different questions. On the straight-line case, \
arclength gives 3 where the comparison angle gives \[Pi].\
\>", "ExampleText",ExpressionUUID->"f270b5c2-7be6-475c-85a1-b63fb1991c07"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"i", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FirstPosition", "[", 
       RowBox[{"line", ",", " ", "c"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"arms", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"line", "[", 
        RowBox[{"[", 
         RowBox[{"i", " ", "-", " ", "4"}], "]"}], "]"}], ",", " ", "c", ",", 
       " ", 
       RowBox[{"line", "[", 
        RowBox[{"[", 
         RowBox[{"i", " ", "+", " ", "4"}], "]"}], "]"}]}], "}"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Arclength\>\"", " ", "->", " ", 
      RowBox[{"N", " ", "@", " ", 
       RowBox[{"InfraAngle", "[", 
        RowBox[{"g", ",", " ", "arms"}], "]"}]}]}], ",", " ", 
     RowBox[{"\"\<Alexandrov\>\"", " ", "->", " ", 
      RowBox[{"N", " ", "@", " ", 
       RowBox[{"InfraAngle", "[", 
        RowBox[{"g", ",", " ", "arms", ",", " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], 
        "]"}]}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"dbef7670-1aad-468b-b182-4046855a3983"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Arclength\"\>", "\[Rule]", "3.`"}], ",", 
   RowBox[{"\<\"Alexandrov\"\>", "\[Rule]", "3.141592653589793`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"eb713b0e-6fa4-4b2b-92bb-8638cb9ec40d"]
