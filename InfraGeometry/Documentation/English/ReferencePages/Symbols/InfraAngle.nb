Cell["\<\
Three configurations at the centre of a square grid. Opposite arms of a line \
give exactly \[Pi]. The same direction gives exactly 0.\
\>", "ExampleText",ExpressionUUID->"a573949c-a03c-494e-86f5-e06f207f6877"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"i", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FirstPosition", "[", 
       RowBox[{"line", ",", " ", "c"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<opposite arms\>\"", " ", "->", " ", 
      RowBox[{"N", " ", "@", " ", 
       RowBox[{"InfraAngle", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"line", "[", 
            RowBox[{"[", 
             RowBox[{"i", " ", "-", " ", "4"}], "]"}], "]"}], ",", " ", "c", ",",
            " ", 
           RowBox[{"line", "[", 
            RowBox[{"[", 
             RowBox[{"i", " ", "+", " ", "4"}], "]"}], "]"}]}], "}"}], ",", 
         " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], 
        "]"}]}]}], ",", "\n", "    ", 
     RowBox[{"\"\<same direction\>\"", " ", "->", " ", 
      RowBox[{"N", " ", "@", " ", 
       RowBox[{"InfraAngle", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"line", "[", 
            RowBox[{"[", 
             RowBox[{"i", " ", "+", " ", "4"}], "]"}], "]"}], ",", " ", "c", ",",
            " ", 
           RowBox[{"line", "[", 
            RowBox[{"[", 
             RowBox[{"i", " ", "+", " ", "2"}], "]"}], "]"}]}], "}"}], ",", 
         " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], 
        "]"}]}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ba283986-0baf-4fc3-b837-4fd6ff28e98b"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"opposite arms\"\>", "\[Rule]", "3.141592653589793`"}], ",", 
   RowBox[{"\<\"same direction\"\>", "\[Rule]", "0.`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"43f4fd74-ee86-4157-95c7-a97ea7c8f1ab"]
}, Open  ]],

Cell["\<\
The Alexandrov method is the closed form in three distances, and agrees with \
it exactly.\
\>", "ExampleText",ExpressionUUID->"4c565bd7-9b8e-4c0f-bf54-fcfb39ef7f36"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"x1", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "4"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"x2", " ", "=", " ", 
     RowBox[{"Last", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "4"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"d1", " ", "=", " ", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "x1"}], "]"}]}], ",", " ", 
     RowBox[{"d2", " ", "=", " ", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "x2"}], "]"}]}], ",", " ", 
     RowBox[{"ch", " ", "=", " ", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", "x1", ",", " ", "x2"}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"InfraAngle", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"x1", ",", " ", "c", ",", " ", "x2"}], "}"}], ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], "]"}]}], ",",
      "\n", "   ", 
     RowBox[{"ArcCos", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"d1", "^", "2"}], " ", "+", " ", 
         RowBox[{"d2", "^", "2"}], " ", "-", " ", 
         RowBox[{"ch", "^", "2"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2.", " ", "d1", " ", "d2"}], ")"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b6bf3202-fbac-4f52-88bf-8c2bb15e0bd4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3.141592653589793`", ",", "3.141592653589793`"}], "}"}]], "Output",\

 CellLabel->"Out[2]= ",ExpressionUUID->"63dfa29a-1a26-42f6-9c72-c62ffacfb6c0"]
}, Open  ]],

Cell["\<\
The two methods answer different questions. On the straight-line case, \
arclength gives 3 where the comparison angle gives \[Pi].\
\>", "ExampleText",ExpressionUUID->"86f3e2fb-d906-4fc4-97e1-048054bade40"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"i", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FirstPosition", "[", 
       RowBox[{"line", ",", " ", "c"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"arms", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"line", "[", 
        RowBox[{"[", 
         RowBox[{"i", " ", "-", " ", "4"}], "]"}], "]"}], ",", " ", "c", ",", 
       " ", 
       RowBox[{"line", "[", 
        RowBox[{"[", 
         RowBox[{"i", " ", "+", " ", "4"}], "]"}], "]"}]}], "}"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Arclength\>\"", " ", "->", " ", 
      RowBox[{"N", " ", "@", " ", 
       RowBox[{"InfraAngle", "[", 
        RowBox[{"g", ",", " ", "arms"}], "]"}]}]}], ",", " ", 
     RowBox[{"\"\<Alexandrov\>\"", " ", "->", " ", 
      RowBox[{"N", " ", "@", " ", 
       RowBox[{"InfraAngle", "[", 
        RowBox[{"g", ",", " ", "arms", ",", " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], 
        "]"}]}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"f922fcee-7b93-470d-823d-ee6789b36c22"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Arclength\"\>", "\[Rule]", "3.`"}], ",", 
   RowBox[{"\<\"Alexandrov\"\>", "\[Rule]", "3.141592653589793`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"7dc20c2f-58e0-491a-8126-557efde6e63b"]
}, Open  ]]
}, Open  ]],

