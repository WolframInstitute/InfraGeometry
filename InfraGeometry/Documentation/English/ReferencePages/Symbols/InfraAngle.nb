Notebook[{

Cell[CellGroupData[{
Cell["InfraAngle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2f6a8b17-4083-4c5d-9d75-00bec792a7cd"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraAngle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraAngle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["q1", "TI"], ",", " ", 
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b083b732-9796-48e4-81b8-a6e783d92ba6"],
 "\[LineSeparator]",
 "gives the angle at ",
 StyleBox["p", "TI"],
 " between the directions to ",
 StyleBox["q1", "TI"],
 " and ",
 StyleBox["q2", "TI"],
 ", in radians.",
 "\n"
}], "Usage",ExpressionUUID->"e412097e-3037-44fe-8421-1c915c48741d"],

Cell[TextData[{
 "Definition, with ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0621fdf0-e521-4bb0-a3b1-27b1b4d6c064"],
 ": the angle at ",
 StyleBox["p", "TI"],
 " is the angle at the corresponding corner of the Euclidean triangle with \
the same three side lengths."
}], "Notes",ExpressionUUID->"b20d1db6-adb8-47a1-af7c-c568d94154bd"],

Cell[TextData[{
 "Writing ",
 StyleBox["d1 = d(p,q1)", "TI"],
 ", ",
 StyleBox["d2 = d(p,q2)", "TI"],
 " and ",
 StyleBox["c = d(q1,q2)", "TI"],
 ", that is"
}], "Notes",ExpressionUUID->"6f5b8c14-508e-4a78-8e0d-16eed94d89c9"],

Cell[TextData[StyleBox["angle = ArcCos[(d1\.b2 + d2\.b2 \[Minus] c\.b2) / (2 \
d1 d2)]", "TI"]], "Notes",ExpressionUUID->"df760e93-40cf-42a4-9fcf-\
b31c8f440272"],

Cell[TextData[{
 "This is the comparison angle, and it is a closed form in three distances. \
Nothing else about the graph enters. It always lies in ",
 StyleBox["[0, \[Pi]]", "TI"],
 "."
}], "Notes",ExpressionUUID->"24ff516e-a8e0-4fe9-abf6-3f81b71e5218"],

Cell[TextData[{
 "Two values come out exactly right. If ",
 StyleBox["q1", "TI"],
 " and ",
 StyleBox["q2", "TI"],
 " lie on opposite arms of one shortest path through ",
 StyleBox["p", "TI"],
 ", then ",
 StyleBox["c = d1 + d2", "TI"],
 " and the angle is exactly \[Pi]. If ",
 StyleBox["q2", "TI"],
 " lies on a shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q1", "TI"],
 ", then ",
 StyleBox["c = |d1 \[Minus] d2|", "TI"],
 " and the angle is exactly 0."
}], "Notes",ExpressionUUID->"c84ed4f7-f171-46da-a38c-5e4444ca3003"],

Cell["\<\
Because only three distances enter, the comparison angle cannot separate \
configurations that share them. On a square grid the metric is \[ScriptL]\.b9 \
and the chord saturates early: two vertices on the same shell of radius 4 can \
be at distance 8 from each other without lying on a common line through the \
centre, and the angle then reads \[Pi] just as a straight line does. This is \
a property of the substrate, not an error.\
\>", "Notes",ExpressionUUID->"b0c1ca5a-af47-4852-979b-53bd732d2f19"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Alexandrov\>\"", ",", " ", 
     RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "k"}]}], "}"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d40e2d7-f236-4c9d-9699-cb74991372dd"],
 " compares in the model plane of curvature ",
 StyleBox["k", "TI"],
 " instead of the Euclidean one."
}], "Notes",ExpressionUUID->"ef7bb355-56ea-4fb9-9623-ebb159e776b1"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Arclength\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20437898-5b9a-4709-abce-831a1d676978"],
 " is the default and computes something different: it takes the arclength \
between the two directions on the boundary around ",
 StyleBox["p", "TI"],
 ", and divides by the radius. It is a synthetic radian measure, not a \
comparison angle, and the two methods do not agree. On a square grid the \
straight-line case gives 3 rather than \[Pi]. It also needs the two arms at \
equal radius to be meaningful, since the radius appears in the denominator."
}], "Notes",ExpressionUUID->"98d08c76-3370-4df4-ab2e-1464a15f99e4"],

Cell[TextData[{
 "The identity worth knowing is with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScalarProduct"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScalarProduct", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "18b64302-df6e-4962-aeac-b77316eb7343"],
 ": the Alexandrov angle at curvature ",
 StyleBox["k", "TI"],
 " is ",
 Cell[BoxData["ArcCos"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61161804-b3de-4d31-b460-451e2159c979"],
 " of the scalar product divided by the two lengths, for every ",
 StyleBox["k", "TI"],
 "."
}], "Notes",ExpressionUUID->"89a0d1e8-6ac8-4124-a8b8-4b9421e75953"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"19dc411e-be05-40b6-8fe9-619641d4f59f"],

