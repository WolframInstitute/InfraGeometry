Notebook[{

Cell[CellGroupData[{
Cell["InfraAngle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ab383493-458b-4ee1-8952-3f4050a16a77"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraAngle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraAngle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["q1", "TI"], ",", " ", 
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e752086-618f-48a7-b397-6755dec0a542"],
 "\[LineSeparator]",
 "gives the angle at ",
 StyleBox["p", "TI"],
 " between the directions to ",
 StyleBox["q1", "TI"],
 " and ",
 StyleBox["q2", "TI"],
 ", in radians.",
 "\n"
}], "Usage",ExpressionUUID->"02ccb219-c387-42e9-b689-951d3b8f3286"],

Cell[TextData[{
 "Definition, with ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9cd47f73-db0e-4576-92db-bf435928bb74"],
 ": the angle at ",
 StyleBox["p", "TI"],
 " is the angle at the corresponding corner of the Euclidean triangle with \
the same three side lengths."
}], "Notes",ExpressionUUID->"a73b1065-3722-4bbd-9f67-e9a1ac1c8e5b"],

Cell[TextData[{
 "Writing ",
 StyleBox["d1 = d(p,q1)", "TI"],
 ", ",
 StyleBox["d2 = d(p,q2)", "TI"],
 " and ",
 StyleBox["c = d(q1,q2)", "TI"],
 ", that is"
}], "Notes",ExpressionUUID->"5b035e93-c0cc-4c68-9cc4-4bbd2bd944e9"],

Cell[TextData[StyleBox["angle = ArcCos[(d1\.b2 + d2\.b2 \[Minus] c\.b2) / (2 \
d1 d2)]", "TI"]], "Notes",ExpressionUUID->"ca2db6e1-5b60-430f-93f3-\
c38c561b4598"],

Cell[TextData[{
 "This is the comparison angle, and it is a closed form in three distances. \
Nothing else about the graph enters. It always lies in ",
 StyleBox["[0, \[Pi]]", "TI"],
 "."
}], "Notes",ExpressionUUID->"984992ac-c08b-4240-ae2e-e41abd8c1903"],

Cell[TextData[{
 "Two values come out exactly right. If ",
 StyleBox["q1", "TI"],
 " and ",
 StyleBox["q2", "TI"],
 " lie on opposite arms of one shortest path through ",
 StyleBox["p", "TI"],
 ", then ",
 StyleBox["c = d1 + d2", "TI"],
 " and the angle is exactly \[Pi]. If ",
 StyleBox["q2", "TI"],
 " lies on a shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q1", "TI"],
 ", then ",
 StyleBox["c = |d1 \[Minus] d2|", "TI"],
 " and the angle is exactly 0."
}], "Notes",ExpressionUUID->"e4ce3e91-e36d-4b7d-a387-87ab13459bc5"],

Cell["\<\
Because only three distances enter, the comparison angle cannot separate \
configurations that share them. On a square grid the metric is \[ScriptL]\.b9 \
and the chord saturates early: two vertices on the same shell of radius 4 can \
be at distance 8 from each other without lying on a common line through the \
centre, and the angle then reads \[Pi] just as a straight line does. This is \
a property of the substrate, not an error.\
\>", "Notes",ExpressionUUID->"06e9a644-7ff2-453e-b528-ae9690246db9"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Alexandrov\>\"", ",", " ", 
     RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "k"}]}], "}"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a174edfd-6810-4baa-9166-bfb38d23ac1d"],
 " compares in the model plane of curvature ",
 StyleBox["k", "TI"],
 " instead of the Euclidean one."
}], "Notes",ExpressionUUID->"0b7ae468-69b2-45a3-b9e1-25ba65dad661"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Arclength\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f566bdd-635f-48db-8e52-f162c5bd23db"],
 " is the default and computes something different: it takes the arclength \
between the two directions on the boundary around ",
 StyleBox["p", "TI"],
 ", and divides by the radius. It is a synthetic radian measure, not a \
comparison angle, and the two methods do not agree. On a square grid the \
straight-line case gives 3 rather than \[Pi]. It also needs the two arms at \
equal radius to be meaningful, since the radius appears in the denominator."
}], "Notes",ExpressionUUID->"9f4e9161-a7c6-42c8-b404-c24144c0c750"],

Cell[TextData[{
 "The identity worth knowing is with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScalarProduct"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScalarProduct", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6a3eeed9-4629-40a9-83d7-9d1e08a124ba"],
 ": the Alexandrov angle at curvature ",
 StyleBox["k", "TI"],
 " is ",
 Cell[BoxData["ArcCos"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c19bf00b-6afe-47ae-bd3f-4183d54b16b4"],
 " of the scalar product divided by the two lengths, for every ",
 StyleBox["k", "TI"],
 "."
}], "Notes",ExpressionUUID->"feb4a1e5-de3f-4d8e-a87e-37a366d61752"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"7463f0a8-5938-45b1-bf7a-62b170119337"],

