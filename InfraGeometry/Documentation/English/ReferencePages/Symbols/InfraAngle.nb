Cell["\<\
An arc of length 6 at radius 3. The result is its edge length.\
\>", "ExampleText",ExpressionUUID->"55d6a9fc-0d27-4f40-85cd-40c6a3751d8a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"arc", " ", "=", " ", 
     RowBox[{"InfraArc", "[", 
      RowBox[{"1", ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "10"}], "}"}], ",", " ", 
       RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "3"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"arc", ",", " ", "1", ",", " ", "4", ",", " ", "10"}], 
        "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"InfraAngle", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "1", ",", " ", "10"}], "}"}], ",", " ", 
       RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "3"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "arc", ",", " ", "\"\<Length\>\""}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"547f4293-8ec9-467c-86c6-bb14ebb74461"],

