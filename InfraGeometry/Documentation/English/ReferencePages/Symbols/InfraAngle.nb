Cell["\<\
The Alexandrov method is the closed form in three distances, and agrees with \
it exactly. The triangle is drawn by its three segments.\
\>", "ExampleText",ExpressionUUID->"416ccdce-882e-40c3-bafa-160d77b09e5e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"x1", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"x2", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "4", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"d1", " ", "=", " ", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "x1"}], "]"}]}], ",", " ", 
     RowBox[{"d2", " ", "=", " ", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "x2"}], "]"}]}], ",", " ", 
     RowBox[{"chord", " ", "=", " ", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", "x1", ",", " ", "x2"}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraSegment", "[", 
          RowBox[{"c", ",", " ", "x1"}], "]"}], ",", " ", 
         RowBox[{"InfraSegment", "[", 
          RowBox[{"c", ",", " ", "x2"}], "]"}], ",", " ", 
         RowBox[{"InfraSegment", "[", 
          RowBox[{"x1", ",", " ", "x2"}], "]"}], ",", " ", "c", ",", " ", 
         "x1", ",", " ", "x2"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"InfraAngle", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"x1", ",", " ", "c", ",", " ", "x2"}], "}"}], ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], "]"}]}], ",",
      " ", 
     RowBox[{"ArcCos", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"d1", "^", "2"}], " ", "+", " ", 
         RowBox[{"d2", "^", "2"}], " ", "-", " ", 
         RowBox[{"chord", "^", "2"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2.", " ", "d1", " ", "d2"}], ")"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b90edfe1-2d00-46ef-8f80-7446e6e7f911"],

