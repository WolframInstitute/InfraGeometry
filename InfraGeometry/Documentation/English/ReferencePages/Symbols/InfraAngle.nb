Cell["\<\
The Alexandrov method is the closed form in three distances, and agrees with \
it exactly. The triangle is drawn by its three segments.\
\>", "ExampleText",ExpressionUUID->"1ec19e1a-bc57-4ed3-8ff3-a18b98b24128"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"x1", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "4"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"x2", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "4", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "4"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"d1", " ", "=", " ", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "x1"}], "]"}]}], ",", " ", 
     RowBox[{"d2", " ", "=", " ", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "x2"}], "]"}]}], ",", " ", 
     RowBox[{"chord", " ", "=", " ", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", "x1", ",", " ", "x2"}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraSegment", "[", 
          RowBox[{"c", ",", " ", "x1"}], "]"}], ",", " ", 
         RowBox[{"InfraSegment", "[", 
          RowBox[{"c", ",", " ", "x2"}], "]"}], ",", " ", 
         RowBox[{"InfraSegment", "[", 
          RowBox[{"x1", ",", " ", "x2"}], "]"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c", ",",
          " ", "x1", ",", " ", "x2"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"InfraAngle", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"x1", ",", " ", "c", ",", " ", "x2"}], "}"}], ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], "]"}]}], ",",
      " ", 
     RowBox[{"ArcCos", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"d1", "^", "2"}], " ", "+", " ", 
         RowBox[{"d2", "^", "2"}], " ", "-", " ", 
         RowBox[{"chord", "^", "2"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2.", " ", "d1", " ", "d2"}], ")"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"bbd410b2-6434-4395-9be8-3942ab4f73d0"],

