Cell["\<\
Two configurations at the centre of the square tiling, each arm drawn along \
the line. Opposite arms of a line give exactly \[Pi]. The same direction \
gives exactly 0.\
\>", "ExampleText",ExpressionUUID->"804e65f7-bcdb-4c3b-9aca-7a1ca101e985"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", "5"}], "]"}]}], "]"}]}], ")"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"i", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FirstPosition", "[", 
       RowBox[{"line", ",", " ", "c"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"opposite", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"line", "[", 
        RowBox[{"[", 
         RowBox[{"i", " ", "-", " ", "4"}], "]"}], "]"}], ",", " ", "c", ",", 
       " ", 
       RowBox[{"line", "[", 
        RowBox[{"[", 
         RowBox[{"i", " ", "+", " ", "4"}], "]"}], "]"}]}], "}"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"same", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"line", "[", 
        RowBox[{"[", 
         RowBox[{"i", " ", "+", " ", "4"}], "]"}], "]"}], ",", " ", "c", ",", 
       " ", 
       RowBox[{"line", "[", 
        RowBox[{"[", 
         RowBox[{"i", " ", "+", " ", "2"}], "]"}], "]"}]}], "}"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\n", "     ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"InfraWalk", "[", 
             RowBox[{"line", "[", 
              RowBox[{"[", 
               RowBox[{"i", " ", ";;", " ", 
                RowBox[{"i", " ", "-", " ", "4"}], " ", ";;", " ", 
                RowBox[{"-", "1"}]}], "]"}], "]"}], "]"}], ",", " ", 
            RowBox[{"InfraWalk", "[", 
             RowBox[{"line", "[", 
              RowBox[{"[", 
               RowBox[{"i", " ", ";;", " ", 
                RowBox[{"i", " ", "+", " ", "4"}]}], "]"}], "]"}], "]"}], ",",
             " ", 
            RowBox[{"Sequence", " ", "@@", " ", "opposite"}]}], "}"}]}], 
         "]"}], ",", "\n", "     ", 
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"InfraWalk", "[", 
             RowBox[{"line", "[", 
              RowBox[{"[", 
               RowBox[{"i", " ", ";;", " ", 
                RowBox[{"i", " ", "+", " ", "4"}]}], "]"}], "]"}], "]"}], ",",
             " ", 
            RowBox[{"InfraWalk", "[", 
             RowBox[{"line", "[", 
              RowBox[{"[", 
               RowBox[{"i", " ", ";;", " ", 
                RowBox[{"i", " ", "+", " ", "2"}]}], "]"}], "]"}], "]"}], ",",
             " ", 
            RowBox[{"Sequence", " ", "@@", " ", "same"}]}], "}"}]}], "]"}]}], 
       "}"}], "]"}], ",", "\n", "   ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"InfraAngle", "[", 
       RowBox[{"g", ",", " ", "opposite", ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], "]"}]}], ",",
      " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"InfraAngle", "[", 
       RowBox[{"g", ",", " ", "same", ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], "]"}]}]}],
     "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5de39b73-9497-485b-a2c1-2ea7977913e2"],

