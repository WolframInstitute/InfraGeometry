Notebook[{

Cell[CellGroupData[{
Cell["InfraAngle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"74310afe-24ab-43ef-9fdd-486106d3d518"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraAngle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraAngle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["q1", "TI"], ",", " ", 
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e297d59d-eae5-4092-b41e-3860eb4777c3"],
 "\[LineSeparator]",
 "gives the angle at ",
 StyleBox["p", "TI"],
 " between the directions to ",
 StyleBox["q1", "TI"],
 " and ",
 StyleBox["q2", "TI"],
 ", in radians.",
 "\n"
}], "Usage",ExpressionUUID->"bcb45b05-a080-4c7c-a3bf-159d047bcbc8"],

Cell[TextData[{
 "Definition, with ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46bb2ca2-cbdd-4976-b7ff-4278472d7f14"],
 ": the angle at ",
 StyleBox["p", "TI"],
 " is the angle at the corresponding corner of the Euclidean triangle with \
the same three side lengths."
}], "Notes",ExpressionUUID->"47853a2d-445b-4c22-9594-bf68223277dd"],

Cell[TextData[{
 "Writing ",
 StyleBox["d1 = d(p,q1)", "TI"],
 ", ",
 StyleBox["d2 = d(p,q2)", "TI"],
 " and ",
 StyleBox["c = d(q1,q2)", "TI"],
 ", that is"
}], "Notes",ExpressionUUID->"585bb80a-0101-4709-9b2a-6d8eb7c867ab"],

Cell[TextData[StyleBox["angle = ArcCos[(d1\.b2 + d2\.b2 \[Minus] c\.b2) / (2 \
d1 d2)]", "TI"]], "Notes",ExpressionUUID->"ee1cb4ee-b165-4c5b-805d-\
2b1ec8ae37e4"],

Cell[TextData[{
 "This is the comparison angle, and it is a closed form in three distances. \
Nothing else about the graph enters. It always lies in ",
 StyleBox["[0, \[Pi]]", "TI"],
 "."
}], "Notes",ExpressionUUID->"47dba09f-8bb4-45ac-adf9-d953804211a9"],

Cell[TextData[{
 "Two values come out exactly right. If ",
 StyleBox["q1", "TI"],
 " and ",
 StyleBox["q2", "TI"],
 " lie on opposite arms of one geodesic through ",
 StyleBox["p", "TI"],
 ", then ",
 StyleBox["c = d1 + d2", "TI"],
 " and the angle is exactly \[Pi]. If ",
 StyleBox["q2", "TI"],
 " lies on a geodesic from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q1", "TI"],
 ", then ",
 StyleBox["c = |d1 \[Minus] d2|", "TI"],
 " and the angle is exactly 0."
}], "Notes",ExpressionUUID->"b93b4701-cd81-4331-9f6c-69fdd97e4cbf"],

Cell["\<\
Because only three distances enter, the comparison angle cannot separate \
configurations that share them. On a square grid the metric is \[ScriptL]\.b9 \
and the chord saturates early: two vertices on the same shell of radius 4 can \
be at distance 8 from each other without lying on a common line through the \
centre, and the angle then reads \[Pi] just as a straight line does. This is \
a property of the substrate, not an error.\
\>", "Notes",ExpressionUUID->"2f6613c2-24f4-4e16-88e3-0be5bdeb20a4"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Alexandrov\>\"", ",", " ", 
     RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "k"}]}], "}"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ec53cf-dbad-467a-81d2-ddf5ce498d43"],
 " compares in the model plane of curvature ",
 StyleBox["k", "TI"],
 " instead of the Euclidean one."
}], "Notes",ExpressionUUID->"e61b9b66-8fb7-477f-8965-8def7f08ea63"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Arclength\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "394c56b1-0e08-4693-b4ef-81e8c7467201"],
 " is the default and computes something different: it takes the arclength \
between the two directions on the boundary around ",
 StyleBox["p", "TI"],
 ", and divides by the radius. It is a synthetic radian measure, not a \
comparison angle, and the two methods do not agree. On a square grid the \
straight-line case gives 3 rather than \[Pi]. It also needs the two arms at \
equal radius to be meaningful, since the radius appears in the denominator."
}], "Notes",ExpressionUUID->"a12cb6ab-52c4-43b7-b1ee-1acc157dc00c"],

Cell[TextData[{
 "The identity worth knowing is with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScalarProduct"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScalarProduct", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "afcd9251-6807-4e2e-bc2a-81df58a6a30b"],
 ": the Alexandrov angle at curvature ",
 StyleBox["k", "TI"],
 " is ",
 Cell[BoxData["ArcCos"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3ed8bc4-972e-4ca6-90c5-4d4d8fa3ccfd"],
 " of the scalar product divided by the two lengths, for every ",
 StyleBox["k", "TI"],
 "."
}], "Notes",ExpressionUUID->"5a4d17e5-3b8c-4ce0-a9c5-34de5131e6b6"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"1788622f-186c-48ca-a275-24071954c373"],

