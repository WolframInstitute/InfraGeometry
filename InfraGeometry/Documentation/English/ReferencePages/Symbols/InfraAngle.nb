Notebook[{

Cell[CellGroupData[{
Cell["InfraAngle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"03149465-25a2-42ca-bae7-96718c81c1fe"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraAngle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraAngle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["q1", "TI"], ",", " ", 
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e42c406-a7f9-47ce-ac9b-8a9ccd7a4d42"],
 "\[LineSeparator]",
 "gives the angle at ",
 StyleBox["p", "TI"],
 " between the directions to ",
 StyleBox["q1", "TI"],
 " and ",
 StyleBox["q2", "TI"],
 ", in radians.",
 "\n"
}], "Usage",ExpressionUUID->"5bce69e2-e0e1-45cd-b84a-787c00180dc6"],

Cell[TextData[{
 "Definition, with ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b276166-4870-47b9-95d7-0b1e98346446"],
 ": the angle at ",
 StyleBox["p", "TI"],
 " is the angle at the corresponding corner of the Euclidean triangle with \
the same three side lengths."
}], "Notes",ExpressionUUID->"41e8cb45-19ca-45a9-bb99-65bc39c63d34"],

Cell[TextData[{
 "Writing ",
 StyleBox["d1 = d(p,q1)", "TI"],
 ", ",
 StyleBox["d2 = d(p,q2)", "TI"],
 " and ",
 StyleBox["c = d(q1,q2)", "TI"],
 ", that is"
}], "Notes",ExpressionUUID->"d1078bc0-964b-4111-9fa4-f5003d5fb42a"],

Cell[TextData[StyleBox["angle = ArcCos[(d1\.b2 + d2\.b2 \[Minus] c\.b2) / (2 \
d1 d2)]", "TI"]], "Notes",ExpressionUUID->"01f29c58-d896-40fa-bf73-\
4f13e523a144"],

Cell[TextData[{
 "This is the comparison angle, and it is a closed form in three distances. \
Nothing else about the graph enters. It always lies in ",
 StyleBox["[0, \[Pi]]", "TI"],
 "."
}], "Notes",ExpressionUUID->"a4f00022-9c1b-46da-95ce-271453e2a707"],

Cell[TextData[{
 "Two values come out exactly right. If ",
 StyleBox["q1", "TI"],
 " and ",
 StyleBox["q2", "TI"],
 " lie on opposite arms of one geodesic through ",
 StyleBox["p", "TI"],
 ", then ",
 StyleBox["c = d1 + d2", "TI"],
 " and the angle is exactly \[Pi]. If ",
 StyleBox["q2", "TI"],
 " lies on a geodesic from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q1", "TI"],
 ", then ",
 StyleBox["c = |d1 \[Minus] d2|", "TI"],
 " and the angle is exactly 0."
}], "Notes",ExpressionUUID->"3a9e3d1f-6b98-47b6-b4bd-87aa7b179ea5"],

Cell["\<\
Because only three distances enter, the comparison angle cannot separate \
configurations that share them. On a square grid the metric is \[ScriptL]\.b9 \
and the chord saturates early: two vertices on the same shell of radius 4 can \
be at distance 8 from each other without lying on a common line through the \
centre, and the angle then reads \[Pi] just as a straight line does. This is \
a property of the substrate, not an error.\
\>", "Notes",ExpressionUUID->"53a69e48-121d-4e11-bb87-08d9c6498198"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Alexandrov\>\"", ",", " ", 
     RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "k"}]}], "}"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b4f36a1-1137-4aa4-a6a9-416b806b721b"],
 " compares in the model plane of curvature ",
 StyleBox["k", "TI"],
 " instead of the Euclidean one."
}], "Notes",ExpressionUUID->"ae6948a5-4201-4827-a54f-e4cf92711bce"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Arclength\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0982f9d0-cd99-47f4-a566-56cf348a8c11"],
 " is the default and computes something different: it takes the arclength \
between the two directions on the boundary around ",
 StyleBox["p", "TI"],
 ", and divides by the radius. It is a synthetic radian measure, not a \
comparison angle, and the two methods do not agree. On a square grid the \
straight-line case gives 3 rather than \[Pi]. It also needs the two arms at \
equal radius to be meaningful, since the radius appears in the denominator."
}], "Notes",ExpressionUUID->"06693bfb-9cba-422a-9ff3-1e566bd4025b"],

Cell[TextData[{
 "The identity worth knowing is with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScalarProduct"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScalarProduct", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2f66c95f-c97b-4feb-9e31-3cc49ca189b5"],
 ": the Alexandrov angle at curvature ",
 StyleBox["k", "TI"],
 " is ",
 Cell[BoxData["ArcCos"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3adb07a-fd8f-4201-a0a9-5c631a357f87"],
 " of the scalar product divided by the two lengths, for every ",
 StyleBox["k", "TI"],
 "."
}], "Notes",ExpressionUUID->"9204c73c-c836-4a31-83a7-8ba8d70c7653"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"230c904f-c8e2-4604-abf0-86fbfcf1da3c"],

