 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Arclength\"\>", "\[Rule]", "3.`"}], ",", 
   RowBox[{"\<\"Alexandrov\"\>", "\[Rule]", "3.141592653589793`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"b253ef7d-3a5e-44ad-83e6-6276e3c17af5"]
