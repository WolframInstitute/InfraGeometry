Cell[TextData[{
 "This is the length of the arc about ",
 Cell[BoxData["p"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0685a4d-ba01-4954-8f86-63585eda4791"],
 " from ",
 Cell[BoxData["q1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c88e2eaf-3b79-4a5c-9927-34fd0d05551e"],
 " to ",
 Cell[BoxData["q2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fe6a73f-2006-47a3-8fab-ccd5aecff9d8"],
 ", measured in graph edges. The arc definition and its supported domain are \
those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f8faf229-e637-4422-b290-30e9fc71b975"],
 ". All shortest arcs of the chosen band have the same length."
}], "Notes",ExpressionUUID->"4cc7d14d-cbab-4d96-8a18-7d97ee781b16"],

Cell[TextData[{
 "The default ",
 Cell[BoxData[
  RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18529e97-8a95-4869-9998-b91426f0e722"],
 " uses the exact distance shell of ",
 Cell[BoxData["q1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9f753a9-0161-4f66-b01f-43e21d44a3e9"],
 ". A scalar delta widens the band outward; ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"deltaIn", ",", " ", "deltaOut"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "124393ff-62f8-4672-b35f-078de76287bf"],
 " widens it in both directions. A thin shell can have no connecting path, \
especially on a bipartite graph. The result then follows the arc \
measurement's empty-family behavior."
}], "Notes",ExpressionUUID->"eaea5a3a-a60a-4157-97e0-5052ff6037cf"],

Cell["\<\
The value has no radius or circumference normalization. A convention turning \
it into a dimensionless angle remains unsettled; this function makes no \
radian claim. A normalization involving a containing circle requires a \
specified circle family and rules for its possible alternatives.\
\>", "Notes",ExpressionUUID->"878252d0-5318-4f17-9655-c806964d32d2"],

Cell[TextData[{
 "The former punched-ball detour divided by radius is a different observable. \
Comparison-triangle angles are now ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraComparisonAngle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraComparisonAngle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fa425636-6997-4f02-af61-a4bef1b21646"],
 " in the Riemannian branch."
}], "Notes",ExpressionUUID->"e9bd0bb5-e5c6-4ba4-a268-161ba245808d"]
}, Open  ]],

