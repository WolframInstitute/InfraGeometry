Cell["\<\
The two methods answer different questions. On the straight-line case, \
arclength gives 3 where the comparison angle gives \[Pi].\
\>", "ExampleText",ExpressionUUID->"824f9fd6-f29a-45ba-a946-f1c945f485ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"RandomInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", "5"}], "]"}]}], "]"}]}], ")"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"i", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FirstPosition", "[", 
       RowBox[{"line", ",", " ", "c"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"arms", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"line", "[", 
        RowBox[{"[", 
         RowBox[{"i", " ", "-", " ", "4"}], "]"}], "]"}], ",", " ", "c", ",", 
       " ", 
       RowBox[{"line", "[", 
        RowBox[{"[", 
         RowBox[{"i", " ", "+", " ", "4"}], "]"}], "]"}]}], "}"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraWalk", "[", 
          RowBox[{"line", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"i", " ", "-", " ", "4"}], " ", ";;", " ", 
             RowBox[{"i", " ", "+", " ", "4"}]}], "]"}], "]"}], "]"}], ",", 
         " ", 
         RowBox[{"Sequence", " ", "@@", " ", "arms"}]}], "}"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"InfraAngle", "[", 
       RowBox[{"g", ",", " ", "arms"}], "]"}]}], ",", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"InfraAngle", "[", 
       RowBox[{"g", ",", " ", "arms", ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], "]"}]}]}],
     "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"66fd8cb7-f33c-4156-aa39-da043e185b4e"],

