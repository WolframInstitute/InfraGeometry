 "."
}], "Usage",ExpressionUUID->"774cfcea-3a5a-4a6d-8b52-84f704c71c4c"],

Cell[TextData[{
 "Every member is a simple path with the reference's ordered endpoints, \
within its tube and excess-length bounds. Sampling a member does not certify \
homotopy to the reference; use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraDeformation"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraDeformation", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "86d486ad-50d1-48a6-853c-2bc95f71ffe4"],
 " for a move certificate."
}], "Notes",ExpressionUUID->"8a0daf2b-58c7-4570-a65a-7c02611fe64e"],

Cell[TextData[{
 "Without a count the result is one vertex list, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5542717e-cf3f-4b68-b9b6-9d810b161209"],
 " when the family is empty. An integer count gives exactly that many \
distinct members, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed2c44fc-c2ec-4303-b002-97b70a08096a"],
 " if fewer exist. ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a83dc3fd-50c8-4b87-bc05-2d0889ca4499"],
 " gives as many as available up to ",
 StyleBox["n", "TI"],
 ". ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf035b9d-d5af-40b4-b8dc-c968f9a2dcd3"],
 " enumerates every member in a deterministic order."
}], "Notes",ExpressionUUID->"9f162609-0d40-47aa-a85c-e9fbeeff7fbf"],

