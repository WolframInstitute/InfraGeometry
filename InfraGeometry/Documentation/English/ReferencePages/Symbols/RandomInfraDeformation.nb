Cell["\<\
Uniformity is over complete paths. The sampler counts suffix paths in the \
family graph, samples distinct integer ranks uniformly without replacement, \
and decodes the selected ranks. It does not choose each next substrate vertex \
uniformly.\
\>", "Notes",ExpressionUUID->"9e470e66-5262-4072-b1ff-80068c19077e"],

Cell[TextData[{
 "Exact counting precedes sampling; construction is bounded by the family's \
",
 Cell[BoxData["\"\<MaxStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c34c6f3-fd3e-41cb-9883-0087cb4ed484"],
 " option. If that construction is inconclusive, the sampling call remains \
unevaluated. A larger count does not relax the family constraints."
}], "Notes",ExpressionUUID->"677d816c-9e34-4850-9a92-51500e6e2ffd"],

Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fd8bf96-3b2c-4eb0-baf1-a6531756c69a"],
 " may have exponentially many results. Use ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["family", "TI"], ",", " ", "\"\<Cardinality\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "930f3556-19ad-4331-9b62-af6cc736dad3"],
 " when only the count is needed."
}], "Notes",ExpressionUUID->"f81e1679-9b08-44fa-8e5d-c78cb69abb4d"]
}, Open  ]],

