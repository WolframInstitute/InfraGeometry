Cell["\<\
Sample two distinct simple paths between two vertices of a complete graph:\
\>", "ExampleText",ExpressionUUID->"35a11172-7df0-4554-a46e-67effcb8d931"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CompleteGraph", "[", "4", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"RandomInfraDeformation", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"InfraDeformation", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"UpTo", "[", "2", "]"}]}], "]"}], ",", " ", "2", ",", " ", 
     RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8da59f47-7fe8-4bfe-9cad-820ea953a2d5"],

Cell[BoxData[
 RowBox[{"{", 
