 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"94df4cd4-892a-47a2-a017-75ecea44012c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraDeformation"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraDeformation", 
     "WolframInstitute/InfraGeometry Package Symbol"},
