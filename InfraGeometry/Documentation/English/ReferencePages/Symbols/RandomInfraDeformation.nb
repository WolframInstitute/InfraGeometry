Cell["Every sampled path is a member of the specified family:", "ExampleText",ExpressionUUID->"bd0999fa-fb36-4070-981c-d4e89d6bcad2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CompleteGraph", "[", "4", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"family", " ", "=", " ", 
     RowBox[{"InfraDeformation", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"UpTo", "[", "2", "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
