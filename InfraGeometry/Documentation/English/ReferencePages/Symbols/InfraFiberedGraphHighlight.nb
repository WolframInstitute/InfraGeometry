Cell[TextData[{
 "The result is a native ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a961d5d4-abf4-406c-b596-2071459d8caf"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph3D"]], "paclet:ref/Graph3D"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "52ff7826-6c57-4540-afdd-be6484a05237"],
 " with the same vertices and edges as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTotalGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTotalGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
