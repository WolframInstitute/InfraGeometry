Cell[TextData[{
 "The result is a native ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "57599135-5b22-445d-8686-75005704b862"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph3D"]], "paclet:ref/Graph3D"},
