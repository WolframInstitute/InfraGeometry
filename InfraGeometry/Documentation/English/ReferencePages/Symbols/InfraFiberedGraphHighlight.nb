        RowBox[{"{", "\"\<Fibration\>\"", "}"}]}], ",", "\n", "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "3"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"partial", " ", "=", " ", 
     RowBox[{"RandomInfraSection", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"{", 
