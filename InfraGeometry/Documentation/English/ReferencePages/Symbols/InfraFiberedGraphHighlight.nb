Cell[TextData[{
 Cell[BoxData["\"\<CircularFiber\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "403a6af6-51f7-4d6b-9910-4c0ed3620df3"],
 " arranges each fiber on a small circle around its base vertex. ",
 Cell[BoxData["\"\<3DFiber\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3040266c-2107-41b8-a548-35b78521f954"],
 " places the fiber on an upright ellipse above that vertex. ",
 Cell[BoxData["\"\<HighlightFiber\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c690993-b403-4f21-ae21-e7c74eb1d470"],
 " colors the fibers in the total graph's own layout. All three views draw \
every supplied overlay."
}], "Notes",ExpressionUUID->"cc0b74cb-be3b-44b4-b7ed-9cd2681895e2"],

Cell["\<\
Explicit base coordinates override the base layout. The automatic fiber \
radius is one third of the shortest positive drawn base-edge length, capped \
at one third. When the base has no positive drawn edge length, the radius is \
one third. The total-layout view computes neither a base embedding nor a \
fiber radius. Singleton fibers sit at the base point in the circular view, \
and above it in the three-dimensional view. The base-coordinate options do \
not change the total-layout view.\
\>", "Notes",ExpressionUUID->"bc2332de-4530-432d-a5c5-f17373256833"],

Cell[TextData[{
 "Graph options and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bdb033c8-0bc7-4ae5-bfb5-bf4f72fbd54e"],
 " options are forwarded with their ordinary meanings. The first occurrence \
of a repeated option takes precedence. Unsupported method names, malformed \
base-coordinate selectors and nonpositive fiber radii leave the call \
unevaluated."
}], "Notes",ExpressionUUID->"dfc86737-2cc5-48ca-923e-0366979a4654"],

Cell["\<\
The function performs no section or connection sampling. Any stochastic \
layout is presentation work; use explicit coordinates for a fixed drawing.\
\>", "Notes",ExpressionUUID->"6b07cd83-0682-4339-911a-0770b1a6af56"]
}, Open  ]],

