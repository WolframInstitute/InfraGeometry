Cell[CellGroupData[{

Cell["BaseVertexCoordinates", "ExampleSubsection",ExpressionUUID->"5df2c31a-48a9-4c8a-9b9b-13d4dcf8bdee"],

Cell["\<\
A random double covering of the square grid, drawn over the grid's own \
coordinates. Where two edges cross, the sheets are exchanged:\
\>", "ExampleText",ExpressionUUID->"4f32dca9-8cce-4331-b0ea-c55f52fc0355"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Covering\>\"", "}"}]}], ",", "\n", "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"\"\<BaseVertexCoordinates\>\"", " ", "->", " ", 
      RowBox[{"GraphEmbedding", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5b3f1edf-d40c-40cd-baff-dab6592db21f"],

