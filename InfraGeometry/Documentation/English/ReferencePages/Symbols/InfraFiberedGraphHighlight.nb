Cell["\<\
A list of alternative sections or connections draws separate members, not one \
mathematical section or connection. Styles around such a family apply to each \
member. Literal list-valued vertices, walks, densities and native graph \
aggregates retain their ordinary meaning.\
\>", "Notes",ExpressionUUID->"9805c4ce-e54f-418f-b935-3f867be0022c"],

Cell[TextData[{
 "Styling uses the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1488858b-35f9-4a95-b5c9-a53fad088b27"],
 " grammar. A ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Directive"]], "paclet:ref/Directive"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9389009e-676f-4171-a69e-7b30ba95076b"],
 " entry styles subsequent objects. ",
 Cell[BoxData[
  RowBox[{"Style", "[", 
   RowBox[{"object", ",", " ", "style"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77af8b3a-7e58-44ca-beb7-65bf75c5da25"],
 " and ",
 Cell[BoxData[
  RowBox[{"object", " ", "->", " ", "style"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c1d1b31-4c97-471c-ae87-79f105b62d02"],
 " style one object. Put an object-style rule inside the item list; top-level \
rules are options. The single-object form excludes lists and rules. For a \
list of options, supply the item list explicitly, as in ",
 Cell[BoxData[
  RowBox[{"InfraFiberedGraphHighlight", "[", 
   RowBox[{"fib", ",", " ", 
    RowBox[{"{", "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"Method", " ", "->", " ", "\"\<3DFiber\>\""}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09b86104-5ffe-45b8-b433-5e4967c3f5fa"],
 "."
}], "Notes",ExpressionUUID->"7b39137a-5c87-4042-9264-f4188762bcbb"],

