Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "4", "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "2", " ", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"connection", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"start", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"VertexList", " ", "@", " ", 
       RowBox[{"InfraFiber", "[", 
        RowBox[{"fib", ",", " ", "1"}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"lift", " ", "=", " ", 
     RowBox[{"InfraHorizontalLift", "[", 
      RowBox[{"fib", ",", " ", "connection", ",", " ", "start", ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "1", ",", " ", "2", ",", " ", "1", ",", " ", "2", ",", " ", "3"}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"connection", " ", "->", " ", "StandardBlue"}], ",", " ", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"InfraWalk", "[", "lift", "]"}], ",", " ", "StandardRed"}], 
        "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a487967c-75cc-4ff2-b28a-b815f1ab69ad"],

