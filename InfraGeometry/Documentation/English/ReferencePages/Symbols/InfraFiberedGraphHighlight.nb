   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f8363357-7b0b-4a14-b41b-b917e909f7b7"],
 " with the same vertices and edges as ",
 Cell[BoxData["InfraTotalSpace"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da010a8f-f6de-460c-bd80-45da4da062f1"],
