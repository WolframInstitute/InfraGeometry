Cell[TextData[{
 "The result is a native ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "50809e76-8b2a-4a32-9207-87a5a82667e3"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph3D"]], "paclet:ref/Graph3D"},
