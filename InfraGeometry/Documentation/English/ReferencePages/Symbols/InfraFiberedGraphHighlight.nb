Cell["The same structure in three views.", "ExampleText",ExpressionUUID->"d29ddb4c-cb35-44e0-a201-412833b67cbb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFibration", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertices\>\"", " ", "->", " ", "3"}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgesDensity\>\"", " ", "->", " ", "All"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"section", " ", "=", " ", 
     RowBox[{"RandomInfraSection", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Continuous\>\"", "}"}]}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"connection", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", "fib", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraFiberedGraphHighlight", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"{", 
         RowBox[{"section", ",", " ", "connection"}], "}"}], ",", " ", 
        RowBox[{"Method", " ", "->", " ", "#"}]}], "]"}], " ", "&"}], " ", "/@",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"\"\<CircularFiber\>\"", ",", " ", "\"\<3DFiber\>\"", ",", 
       " ", "\"\<HighlightFiber\>\""}], "}"}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"190de35d-1516-4bd9-9fef-222d935119a2"],

