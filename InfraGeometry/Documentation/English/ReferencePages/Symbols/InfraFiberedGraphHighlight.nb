Cell["Repeated traversals of a lifted walk retain their strength.", \
"ExampleText",ExpressionUUID->"3ed91855-ea7a-4de9-a53d-0d4453b4e22b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFibration", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "4", "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertices\>\"", " ", "->", " ", "2"}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgesDensity\>\"", " ", "->", " ", "All"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"connection", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", "fib", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"start", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"VertexList", " ", "@", " ", 
       RowBox[{"InfraFiber", "[", 
        RowBox[{"fib", ",", " ", "1"}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"lift", " ", "=", " ", 
     RowBox[{"InfraHorizontalLift", "[", 
      RowBox[{"fib", ",", " ", "connection", ",", " ", "start", ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "1", ",", " ", "2", ",", " ", "1", ",", " ", "2", ",", " ", "3"}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"connection", " ", "->", " ", "StandardBlue"}], ",", " ", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"InfraWalk", "[", "lift", "]"}], ",", " ", "StandardRed"}], 
        "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d194e02d-ac5c-425d-ab02-94e3f208bf8d"],

