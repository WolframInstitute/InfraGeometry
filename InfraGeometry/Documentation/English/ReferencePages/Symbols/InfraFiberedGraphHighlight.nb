Cell["The same structure in three views.", "ExampleText",ExpressionUUID->"e2ea2009-7dbd-43bb-a6d7-6d470fd724fa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "3", " ", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"section", " ", "=", " ", 
     RowBox[{"RandomInfraSection", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Continuous\>\"", "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"connection", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraFiberedGraphHighlight", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"{", 
         RowBox[{"section", ",", " ", "connection"}], "}"}], ",", " ", 
        RowBox[{"Method", " ", "->", " ", "#"}]}], "]"}], " ", "&"}], " ", "/@",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"\"\<CircularFiber\>\"", ",", " ", "\"\<3DFiber\>\"", ",", 
       " ", "\"\<HighlightFiber\>\""}], "}"}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9f662e07-765c-48c4-96cf-bdd61af5de30"],

