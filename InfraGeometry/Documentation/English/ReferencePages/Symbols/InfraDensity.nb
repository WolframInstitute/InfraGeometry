Cell[TextData[{
 "The result is key-sorted, so two densities built by different routes \
compare with ",
 Cell[BoxData["SameQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7e21154-2045-42f8-891a-1dcbcbdb9724"],
 "."
}], "Notes",ExpressionUUID->"d3dc7ec0-f69f-4faa-9ae2-524cdf1592ad"],

Cell[TextData[{
 "It is the one coercion of the API. ",
 Cell[BoxData["Keys"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fea7464d-ba2d-40ae-8521-8134c635b4a0"],
 " demotes a density to its support, and ",
 Cell[BoxData["Counts"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "131581e4-a9e5-4955-bebb-1d40bfbcb376"],
 " promotes a vertex list to a density."
}], "Notes",ExpressionUUID->"3cef1fdb-0168-4816-b6f5-f3dcf1c9a244"],

Cell[TextData[{
 "A Euclidean head is not a shape here: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDensity"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDensity", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e862bd6a-4f6b-415f-a4e7-f7ad0ecbb577"],
 " is ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"InfraSegment", "[", 
     RowBox[{"p", ",", " ", "q"}], "]"}], " ", "->", " ", "1"}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bffd41f9-0a7a-4c0e-bf7a-9fea3354a5ba"],
 ". The density of a head is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", "\"\<VertexDensity\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3633bfda-fc2d-459a-9494-c4b90d5e473f"],
 ", and it equals the density of the head's members."
}], "Notes",ExpressionUUID->"61330fc3-d1aa-4de1-a38a-5a2f8bf75d61"],

Cell[TextData[{
 "It is the raw marginal and takes no options. The two normalisations are one \
division away: ",
 Cell[BoxData[
  RowBox[{"d", " ", "/", " ", 
   RowBox[{"Max", "[", "d", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff7f2c57-5d43-4d24-853a-0324654e497a"],
 " is the occupation in [0, 1], and ",
 Cell[BoxData[
  RowBox[{"d", " ", "/", " ", 
   RowBox[{"Total", "[", "d", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d239ff8-3f85-45c4-863f-2798c0e83cd4"],
 " is the distribution summing to 1."
}], "Notes",ExpressionUUID->"1420bc00-0041-4523-9219-489100d3095e"]
}, Open  ]],

