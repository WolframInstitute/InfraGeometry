Cell["\<\
The shortest paths from the centre to a vertex four steps away, as a density: \
both end points are covered by every path, the middle vertices by fewer. Each \
vertex is drawn as large as its mass.\
\>", "ExampleText",ExpressionUUID->"8f078470-196e-45a5-ae09-4811885557cc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "4"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"density", " ", "=", " ", 
     RowBox[{"InfraDensity", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"FindInfraSegment", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], "]"}]}],
       "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", "density", "}"}], ",", " ", 
       RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "16"}], "}"}]}]}], "]"}], ",", " ", 
     "density"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0ced4699-f146-4c25-be42-e893a91b31cd"],

