Cell[CellGroupData[{
Cell["InfraDensity", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7322370e-3496-4fca-b294-e50c62856bc2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDensity"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDensity", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["x", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5bd8d8b-6e1f-4937-b682-c19d0c48cdd8"],
 "\[LineSeparator]",
 "gives the marginal of the shape ",
 StyleBox["x", "TI"],
 " to the vertex set of ",
 StyleBox["graph", "TI"],
 ", an ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6914f2dc-3369-453c-aa0a-a31ab56a0bf9"],
 " of vertices ",
 StyleBox["v", "TI"],
 " to masses ",
 StyleBox["m", "TI"],
 ", with respect to the counting measure.",
 "\n"
}], "Usage",ExpressionUUID->"d381473d-d0bc-46bd-afcf-c7ed948c8342"],

Cell["\<\
Definition: the density of a shape is the number of times it covers each \
vertex: once for a vertex, once per occurrence in a vertex list, and once per \
walk through the vertex for a family of walks.\
\>", "Notes",ExpressionUUID->"5c164af5-a044-4dec-bb0a-f8868a67575c"],

Cell["It reads every shape:", "Notes",ExpressionUUID->"a39e9019-ff4d-4488-8b37-603721cb050b"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0f844d41-60c7-4d13-8fea-bd1c777247b3"], Cell[TextData[StyleBox[
    "x", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"3c6a11d0-400a-4b11-aeb9-5b97dafc7649"],
     Cell[TextData[Cell[BoxData[
     RowBox[{
      TemplateBox[{
        Cell[
         TextData["InfraDensity"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraDensity", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"], "[", 
      RowBox[{
       StyleBox["graph", "TI"], ",", " ", 
       StyleBox["x", "TI"]}], "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "56bcc0a3-0a12-4d7a-9348-5be5131596de"]], "TableText",
