Cell[TextData[{
 "The density of a head's members is the head's ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bf9faa4-af0f-43a4-a021-6cbf5d31cc97"],
 ", and so is the density of the head's graph."
}], "ExampleText",ExpressionUUID->"7d7048ee-f83e-4e2f-9da7-1e411fcff0d5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "4"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraDensity", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"FindInfraRepresentative", "[", 
           RowBox[{"g", ",", " ", "seg", ",", " ", "All"}], "]"}]}], "]"}], 
        "}"}], ",", " ", 
       RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "16"}], "}"}]}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"InfraDensity", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", "seg", ",", " ", "All"}], "]"}]}], "]"}], " ",
       "===", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<VertexDensity\>\""}], 
       "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"InfraDensity", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<Graph\>\""}], "]"}]}], 
       "]"}], " ", "===", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<VertexDensity\>\""}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9107cfca-e93f-4719-a665-18e3d47f1fef"],

