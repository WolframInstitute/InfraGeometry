6b183f804d12"],

Cell[TextData[{
 "The result is key-sorted, so two densities built by different routes \
compare with ",
 Cell[BoxData["SameQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d847773f-0b89-4f13-b664-098b9c052829"],
 "."
}], "Notes",ExpressionUUID->"d33bc8f9-1810-40ad-a10e-0ab2a80f13f4"],

Cell[TextData[{
 "It is the one coercion of the API. ",
 Cell[BoxData["Keys"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9752bbfc-164a-4ac5-912f-22abf6a69b26"],
 " demotes a density to its support, and ",
 Cell[BoxData["Counts"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "efc9cb53-f5b7-4f8f-9d44-e49ad2f0b544"],
 " promotes a vertex list to a density."
}], "Notes",ExpressionUUID->"c77c7d08-8085-4963-bff1-da4f4f08b885"],

Cell[TextData[{
 "A Euclidean head is not a shape here: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDensity"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDensity", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "678dc13b-4850-45fc-8710-b472d0e06c5c"],
 " is ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"InfraSegment", "[", 
     RowBox[{"p", ",", " ", "q"}], "]"}], " ", "->", " ", "1"}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af279b9e-4eb9-462c-842e-ece00917c24c"],
 ". The density of a head is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", "\"\<VertexDensity\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "207cf65d-bdff-4ebe-8060-a11492c9e5a4"],
 ", and it equals the density of the head's members."
}], "Notes",ExpressionUUID->"02152524-8908-41d5-9679-f3d719cbc55f"],

Cell[TextData[{
 "It is the raw marginal and takes no options. The two normalisations are one \
division away: ",
 Cell[BoxData[
  RowBox[{"d", " ", "/", " ", 
   RowBox[{"Max", "[", "d", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c9fab305-ecbb-4e68-9b00-028e6d68ff52"],
 " is the occupation in [0, 1], and ",
 Cell[BoxData[
  RowBox[{"d", " ", "/", " ", 
   RowBox[{"Total", "[", "d", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b964cecc-3eb3-4f5b-bb67-91b16db90284"],
 " is the distribution summing to 1."
}], "Notes",ExpressionUUID->"f525baad-4439-4797-b43c-2ebbe0d25bd9"]
}, Open  ]],

