Cell[TextData[{
 "The density of a head's members is the head's ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a414c995-2ff0-4fb4-9f10-e3e036986f45"],
 ", and so is the density of the head's graph."
}], "ExampleText",ExpressionUUID->"7b6367f4-9160-486e-982c-4f6909c3acd0"],

