Cell["A vertex, a vertex list with a repeat, and a density.", "ExampleText",ExpressionUUID->"5339b032-e0fc-4149-bbc9-8cf4fdddfa09"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"AdjacencyList", "[", 
       RowBox[{"g", ",", " ", "a"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"densities", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraDensity", "[", 
        RowBox[{"g", ",", " ", "a"}], "]"}], ",", " ", 
       RowBox[{"InfraDensity", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"b", ",", " ", "a", ",", " ", "b"}], "}"}]}], "]"}], ",", 
       " ", 
       RowBox[{"InfraDensity", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"b", " ", "->", " ", "2"}], ",", " ", 
           RowBox[{"a", " ", "->", " ", "1"}]}], "|>"}]}], "]"}]}], "}"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", "density", "}"}], ",", " ", 
          RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"4", ",", " ", "16"}], "}"}]}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"density", ",", " ", "densities"}], "}"}]}], "]"}]}], ",", 
     " ", "densities"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"241bf003-4d84-4d0b-90f7-9e42b1850ff2"],

