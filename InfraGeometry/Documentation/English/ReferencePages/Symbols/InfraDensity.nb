Cell[TextData[{
 "The density of a head's members is the head's ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2baa3c93-b8e9-4645-aeda-9b7b6decba0f"],
 ", and so is the density of the head's graph."
}], "ExampleText",ExpressionUUID->"a506e52c-05c5-43ca-af43-c235b6e1700d"],

