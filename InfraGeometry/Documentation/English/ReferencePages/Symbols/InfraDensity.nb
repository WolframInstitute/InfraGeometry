Cell[TextData[{
 "The result is key-sorted, so two densities built by different routes \
compare with ",
 Cell[BoxData["SameQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b222fd21-255f-4ca6-a6ed-a9c18324b10f"],
 "."
}], "Notes",ExpressionUUID->"cd6b0f40-b670-4f59-8b63-259d1e5cbf65"],

Cell[TextData[{
 "It is the one coercion of the API. ",
 Cell[BoxData["Keys"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f14dd521-20a7-4466-bc9c-7ff2c1b2d277"],
 " demotes a density to its support, and ",
 Cell[BoxData["Counts"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e9005e1-32ea-48e6-81f5-59ed57658073"],
 " promotes a vertex list to a density."
}], "Notes",ExpressionUUID->"163f9f7e-e35e-482c-9b6c-7c5e79034953"],

Cell[TextData[{
 "A Euclidean head is not a shape here: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDensity"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDensity", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe26bd65-176d-490f-b9ca-147a39772a45"],
 " is ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"InfraSegment", "[", 
     RowBox[{"p", ",", " ", "q"}], "]"}], " ", "->", " ", "1"}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd878a7e-7567-4ecc-969a-c7462f177659"],
 ". The density of a head is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", "\"\<VertexDensity\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09a5bf23-7f79-4d1e-b382-f1a32811d61d"],
 ", and it equals the density of the head's members."
}], "Notes",ExpressionUUID->"c1c021e0-cac8-45c1-9fb7-124b2bcbb7d1"],

Cell[TextData[{
 "It is the raw marginal and takes no options. The two normalisations are one \
division away: ",
 Cell[BoxData[
  RowBox[{"d", " ", "/", " ", 
   RowBox[{"Max", "[", "d", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b00abd3a-824c-488f-bae8-8be1016d2d03"],
 " is the occupation in [0, 1], and ",
 Cell[BoxData[
  RowBox[{"d", " ", "/", " ", 
   RowBox[{"Total", "[", "d", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dcebf000-1c02-4b60-a03f-ac86711bb40d"],
 " is the distribution summing to 1."
}], "Notes",ExpressionUUID->"b1db99ee-013f-4acb-b8e0-82b87f264eb5"]
}, Open  ]],

