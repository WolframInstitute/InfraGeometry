    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["x", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58c05a0a-3f2f-4f40-9d2e-ce93b5b7f157"],
 "\[LineSeparator]",
 "gives the marginal of the shape ",
 StyleBox["x", "TI"],
 " to the vertex set of ",
 StyleBox["graph", "TI"],
 ", an ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7495f633-0aac-474b-839c-6bd9bd50623e"],
