Cell[CellGroupData[{
Cell["InfraDensity", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bb1bf83b-62ba-433b-93ed-6f70374c5b12"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDensity"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDensity", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["x", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23145fb5-55d5-43e1-bc7b-b0880c597624"],
 "\[LineSeparator]",
 "gives the marginal of the shape ",
 StyleBox["x", "TI"],
 " to the vertex set of ",
 StyleBox["graph", "TI"],
 ", an ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8fb8047b-d031-4aae-ac0d-3360b4a15173"],
 " of vertices ",
 StyleBox["v", "TI"],
 " to masses ",
 StyleBox["m", "TI"],
 ", with respect to the counting measure.",
 "\n"
}], "Usage",ExpressionUUID->"ebf8c711-17eb-4927-9dca-c1b7c848c145"],

Cell["\<\
Definition: the density of a shape is the number of times it covers each \
vertex: once for a vertex, once per occurrence in a vertex list, and once per \
walk through the vertex for a family of walks.\
\>", "Notes",ExpressionUUID->"759456cf-27a4-46fd-a413-212478b7fc02"],

Cell["It reads every shape:", "Notes",ExpressionUUID->"54a78a3f-fce9-44c9-b2a2-74f472961dc6"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2ea63a7a-11f9-4c50-901b-9c54917ec535"], Cell[TextData[StyleBox[
    "x", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"6b032efa-3e73-45c1-b892-1f7c2ec0ed8b"],
     Cell[TextData[Cell[BoxData[
