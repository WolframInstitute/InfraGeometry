Cell[CellGroupData[{
Cell["InfraDensity", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"79537eac-637f-4f6f-81e9-a85356c289e3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDensity"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDensity", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["x", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc6ae4da-f582-438f-92a8-345a82657458"],
 "\[LineSeparator]",
 "gives the marginal of the shape ",
 StyleBox["x", "TI"],
 " to the vertex set of ",
 StyleBox["graph", "TI"],
 ", an ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "888e7ebc-9810-47bb-8b45-942152806d77"],
 " of vertices ",
 StyleBox["v", "TI"],
 " to masses ",
 StyleBox["m", "TI"],
 ", with respect to the counting measure.",
 "\n"
}], "Usage",ExpressionUUID->"3dfea2e9-320a-4741-9f19-ae951d8aa9d9"],

Cell["\<\
Definition: the density of a shape is the number of times it covers each \
vertex: once for a vertex, once per occurrence in a vertex list, and once per \
walk through the vertex for a family of walks.\
\>", "Notes",ExpressionUUID->"432078d5-bc08-4045-b600-10d27288dbc6"],

Cell["It reads every shape:", "Notes",ExpressionUUID->"e88ecb05-7a30-4382-a8b3-390d7ccf92ea"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "85417e2f-20ec-4fd0-a5f3-833a4c269341"], Cell[TextData[StyleBox[
    "x", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"f16e87f5-07ce-452c-910a-0606acae5844"],
     Cell[TextData[Cell[BoxData[
     RowBox[{
      TemplateBox[{
        Cell[
         TextData["InfraDensity"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraDensity", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"], "[", 
      RowBox[{
       StyleBox["graph", "TI"], ",", " ", 
