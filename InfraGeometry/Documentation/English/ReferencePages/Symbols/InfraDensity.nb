      FontSize->0.9 Inherited,ExpressionUUID->
      "ccca4b0e-092f-490f-8441-f58566a2771e"]
    }], "TableText",ExpressionUUID->"db615bdd-dad8-4fa5-beeb-3699a2acbf87"], 
