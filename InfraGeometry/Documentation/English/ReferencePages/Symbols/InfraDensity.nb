Cell["InfraDensity", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d70fd587-d84e-44bb-b69b-fc25206cc291"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
