Cell[TextData[{
 "The density of a head's members is the head's ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd9f3521-712c-41a6-b5ec-874484c1f1f8"],
 ", and so is the density of the head's graph."
}], "ExampleText",ExpressionUUID->"5daab796-e189-4836-849a-1bfc5934e91a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"a", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraDensity", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"FindInfraRepresentative", "[", 
           RowBox[{"g", ",", " ", "seg", ",", " ", "All"}], "]"}]}], "]"}], 
        "}"}], ",", " ", 
       RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "16"}], "}"}]}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"InfraDensity", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", "seg", ",", " ", "All"}], "]"}]}], "]"}], " ",
       "===", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<VertexDensity\>\""}], 
       "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"InfraDensity", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<Graph\>\""}], "]"}]}], 
       "]"}], " ", "===", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<VertexDensity\>\""}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4c59efe6-3a69-44e0-bf0d-95b1afb838dc"],

