Cell["\<\
The two normalisations: by the heaviest mass, which the drawing uses, and by \
the total mass, a probability.\
\>", "ExampleText",ExpressionUUID->"11fa8b54-40c3-4f87-959e-d1e1409088dc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "4"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"density", " ", "=", " ", 
     RowBox[{"InfraDensity", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"FindInfraSegment", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], "]"}]}],
       "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"density", " ", "/", " ", 
         RowBox[{"Max", "[", "density", "]"}]}], "}"}], ",", " ", 
       RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "16"}], "}"}]}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Max", "[", 
      RowBox[{"density", " ", "/", " ", 
       RowBox[{"Max", "[", "density", "]"}]}], "]"}], ",", " ", 
     RowBox[{"Total", "[", 
      RowBox[{"density", " ", "/", " ", 
       RowBox[{"Total", "[", "density", "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"21c780e5-c990-441d-8890-19543c32fd9a"],

