Cell["A vertex, a vertex list with a repeat, and a density.", "ExampleText",ExpressionUUID->"95eb8e56-387c-4255-ac1a-749a8994bfa9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"AdjacencyList", "[", 
       RowBox[{"g", ",", " ", "a"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"densities", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraDensity", "[", 
        RowBox[{"g", ",", " ", "a"}], "]"}], ",", " ", 
       RowBox[{"InfraDensity", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"b", ",", " ", "a", ",", " ", "b"}], "}"}]}], "]"}], ",", 
       " ", 
       RowBox[{"InfraDensity", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"b", " ", "->", " ", "2"}], ",", " ", 
           RowBox[{"a", " ", "->", " ", "1"}]}], "|>"}]}], "]"}]}], "}"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", "density", "}"}], ",", " ", 
          RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"4", ",", " ", "16"}], "}"}]}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"density", ",", " ", "densities"}], "}"}]}], "]"}]}], ",", 
     " ", "densities"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7bb0dd17-70ce-4711-bfb0-f38a7a50c155"],

