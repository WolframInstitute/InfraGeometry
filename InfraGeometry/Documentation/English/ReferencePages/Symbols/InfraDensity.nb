Cell[TextData[{
 "The density of a head's members is the head's ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39e7d943-5d04-47f4-baf1-fa1cdc39781f"],
 ", and so is the density of the head's graph."
}], "ExampleText",ExpressionUUID->"66b4b598-8dfa-45ad-af91-78f397530ebc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"41", ",", " ", "61"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraDensity", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraVertexList", "[", 
         RowBox[{"g", ",", " ", "seg", ",", " ", "All"}], "]"}]}], "]"}], " ",
       "===", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<VertexDensity\>\""}], 
       "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"InfraDensity", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<Graph\>\""}], "]"}]}], 
       "]"}], " ", "===", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<VertexDensity\>\""}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1cf0c495-85ab-4b99-b371-efb7355e58d7"],

