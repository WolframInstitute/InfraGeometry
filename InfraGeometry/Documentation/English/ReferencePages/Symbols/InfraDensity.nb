    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["x", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8cb12788-65c6-4264-a4f1-37f05c19a6b5"],
 "\[LineSeparator]",
 "gives the marginal of the shape ",
 StyleBox["x", "TI"],
 " to the vertex set of ",
 StyleBox["graph", "TI"],
 ", an ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d895834d-f88b-4b85-8219-62c723619a94"],
 " of vertices ",
 StyleBox["v", "TI"],
 " to masses ",
 StyleBox["m", "TI"],
 ", with respect to the counting measure.",
 "\n"
}], "Usage",ExpressionUUID->"65459569-c61b-4d50-bf31-df1c9616ec43"],

Cell["\<\
Definition: the density of a shape is the number of times it covers each \
vertex: once for a vertex, once per occurrence in a vertex list, and once per \
walk through the vertex for a family of walks.\
\>", "Notes",ExpressionUUID->"0f7b3b1f-ed67-49d2-8812-ccbbfebd6381"],

Cell["It reads every shape:", "Notes",ExpressionUUID->"9a878c3b-45ed-4147-850b-3b9c96462f31"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b5f752a4-a01c-484c-9900-29067004f994"], Cell[TextData[StyleBox[
    "x", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"428f672e-9801-486d-96bb-a07f5a08a395"],
