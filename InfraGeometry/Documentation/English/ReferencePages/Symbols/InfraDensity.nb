Cell[TextData[{
 "The result is key-sorted, so two densities built by different routes \
compare with ",
 Cell[BoxData["SameQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "901e4b35-9869-4735-a10c-f574c2857416"],
 "."
}], "Notes",ExpressionUUID->"ac0a7bbb-814f-441d-9fb3-600acd8d5b85"],

Cell[TextData[{
 "It is the one coercion of the API. ",
 Cell[BoxData["Keys"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70cfad2c-232d-4c97-9de8-c6beff5e1147"],
 " demotes a density to its support, and ",
 Cell[BoxData["Counts"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02587c69-1a0f-4f2f-a61b-979d123119a8"],
 " promotes a vertex list to a density."
}], "Notes",ExpressionUUID->"e70eaa0e-335c-4182-8dfe-8c0b4b93b77b"],

Cell[TextData[{
 "A Euclidean head is not a shape here: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDensity"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDensity", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fdeb895-3bd7-4389-9a61-702cc822fe57"],
 " is ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"InfraSegment", "[", 
     RowBox[{"p", ",", " ", "q"}], "]"}], " ", "->", " ", "1"}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "696622a9-8255-41a8-b2a0-a296fe5e508d"],
 ". The density of a head is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", "\"\<VertexDensity\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15e120ea-3e2b-4250-a1d4-915e40dc0dad"],
 ", and it equals the density of the head's members."
}], "Notes",ExpressionUUID->"a39c555f-9cb1-4404-a1bb-12ad851a363a"],

Cell[TextData[{
 "It is the raw marginal and takes no options. The two normalisations are one \
division away: ",
 Cell[BoxData[
  RowBox[{"d", " ", "/", " ", 
   RowBox[{"Max", "[", "d", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "063c08ba-5c86-4e6c-b653-5a72859227f3"],
 " is the occupation in [0, 1], and ",
 Cell[BoxData[
  RowBox[{"d", " ", "/", " ", 
   RowBox[{"Total", "[", "d", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f3f8165-13c8-41ad-a944-45dee2c5c7f1"],
 " is the distribution summing to 1."
}], "Notes",ExpressionUUID->"5e938700-2a06-48b3-a76b-1244084e8d56"]
}, Open  ]],

