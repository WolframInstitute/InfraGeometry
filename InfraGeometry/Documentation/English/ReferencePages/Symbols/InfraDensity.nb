Cell["InfraDensity", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"99c87c6c-631a-4682-a7f7-48491ac1650b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDensity"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDensity", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["x", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80e50007-a8b2-4caf-bb7c-49dda8b3b763"],
 "\[LineSeparator]",
 "gives the marginal of the shape ",
 StyleBox["x", "TI"],
 " to the vertex set of ",
 StyleBox["graph", "TI"],
 ", an ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4eb17439-199e-4044-a7cd-5f77bcd87483"],
 " of vertices ",
