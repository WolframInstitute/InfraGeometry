Cell[CellGroupData[{
Cell["InfraDensity", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1030d3d4-1f7b-4ef6-9e10-4f51241b9ae8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDensity"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDensity", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["x", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38e47689-8597-46b3-9278-b6142848cdf1"],
 "\[LineSeparator]",
 "gives the marginal of the shape ",
 StyleBox["x", "TI"],
 " to the vertex set of ",
 StyleBox["graph", "TI"],
 ", an ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f9eb2a1-707a-4bad-835b-c92a44425c14"],
 " of vertices ",
 StyleBox["v", "TI"],
 " to masses ",
 StyleBox["m", "TI"],
 ", with respect to the counting measure.",
 "\n"
}], "Usage",ExpressionUUID->"b3e4d04a-a66b-4542-98f0-d95af3155541"],

Cell["\<\
Definition: the density of a shape is the number of times it covers each \
vertex: once for a vertex, once per occurrence in a vertex list, and once per \
walk through the vertex for a family of walks.\
\>", "Notes",ExpressionUUID->"7c9757be-3dcf-4cb0-a515-bc7c075e97f3"],

Cell["It reads every shape:", "Notes",ExpressionUUID->"5525974a-0578-463a-b5a3-3b16f52efef6"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8837f449-98e6-48ea-8988-4661bf3ee9ed"], Cell[TextData[StyleBox[
    "x", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"f4048543-0ae8-4157-b167-fd44ecac4886"],
     Cell[TextData[Cell[BoxData[
     RowBox[{
      TemplateBox[{
        Cell[
         TextData["InfraDensity"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraDensity", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"], "[", 
      RowBox[{
       StyleBox["graph", "TI"], ",", " ", 
