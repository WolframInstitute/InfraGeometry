Cell[TextData[{
 "The result is key-sorted, so two densities built by different routes \
compare with ",
 Cell[BoxData["SameQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f5a485c-c8a3-4fba-bbfc-6829d787c827"],
 "."
}], "Notes",ExpressionUUID->"b5eb04c8-eb4e-43f7-9cde-5c0c18fc89fe"],

Cell[TextData[{
 "It is the one coercion of the API. ",
 Cell[BoxData["Keys"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "511d49f9-cbc4-466b-82dc-c8feaa563e20"],
 " demotes a density to its support, and ",
 Cell[BoxData["Counts"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f41d8a18-764b-49bc-bd01-bcab828a2823"],
 " promotes a vertex list to a density."
}], "Notes",ExpressionUUID->"1876ee8e-9577-4e80-8015-bf7aa4f593fd"],

Cell[TextData[{
 "A Euclidean head is not a shape here: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDensity"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDensity", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "697af570-dc4a-48fb-8de5-7a05b04964bd"],
 " is ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"InfraSegment", "[", 
     RowBox[{"p", ",", " ", "q"}], "]"}], " ", "->", " ", "1"}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae4a9520-61d9-4d15-9f3f-570fcd8ea6ab"],
 ". The density of a head is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"], ",", " ", "\"\<VertexDensity\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6550cba-b860-4934-836e-140b1eb25608"],
 ", and it equals the density of the head's members."
}], "Notes",ExpressionUUID->"734e50e7-1d58-4b48-96ca-a8d693e281ba"],

Cell[TextData[{
 "It is the raw marginal and takes no options. The two normalisations are one \
division away: ",
 Cell[BoxData[
  RowBox[{"d", " ", "/", " ", 
   RowBox[{"Max", "[", "d", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e24ff246-c6f6-4872-957f-3401ead5d1e3"],
 " is the occupation in [0, 1], and ",
 Cell[BoxData[
  RowBox[{"d", " ", "/", " ", 
   RowBox[{"Total", "[", "d", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c89bf2fd-23d8-4dd3-be12-60dbf127c9ee"],
 " is the distribution summing to 1."
}], "Notes",ExpressionUUID->"a5e5dda9-1dc9-498f-8219-96269f3addbc"]
}, Open  ]],

