   {Cell["      ", "ModInfo",ExpressionUUID->
     "ae6482b2-911f-46cb-a948-c5b92431123e"], Cell[TextData[{
     "a vertex ",
     StyleBox["v", "TI"]
    }], "TableText",ExpressionUUID->"5f44c465-3398-4148-be5b-474875b65c28"], 
    Cell[TextData[Cell[BoxData[
     RowBox[{"<|", 
      RowBox[{"v", " ", "->", " ", "1"}], "|>"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "bd37263e-dbc2-4665-8fb0-37ee0c277023"]], "TableText",ExpressionUUID->
     "5a7da2aa-4b43-4cfe-8d12-359b4607f168"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9656d69d-9369-4723-b5e8-4cd366631b33"], Cell[
    "a vertex list", "TableText",ExpressionUUID->
     "a4ac1fd5-93dc-47ab-b92c-e7473a2188d5"], Cell[TextData[{
     "its ",
     Cell[BoxData["Counts"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2d74d734-9784-4c64-a4e9-68f8391e8799"]
    }], "TableText",ExpressionUUID->"70f0fde1-93b4-427e-96f3-765408593a8d"]},
