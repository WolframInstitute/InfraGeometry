Cell[TextData[{
 "The density of a head's members is the head's ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "205fa123-e465-4d26-822a-b00697e4650b"],
 ", and so is the density of the head's graph."
}], "ExampleText",ExpressionUUID->"d71f4f88-ea95-49cd-a617-ca892d4e21b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "4"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraDensity", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraVertexList", "[", 
           RowBox[{"g", ",", " ", "seg", ",", " ", "All"}], "]"}]}], "]"}], 
        "}"}], ",", " ", 
       RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "16"}], "}"}]}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"InfraDensity", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraVertexList", "[", 
         RowBox[{"g", ",", " ", "seg", ",", " ", "All"}], "]"}]}], "]"}], " ",
       "===", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<VertexDensity\>\""}], 
       "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"InfraDensity", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<Graph\>\""}], "]"}]}], 
       "]"}], " ", "===", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<VertexDensity\>\""}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"24e9f0e3-223f-4a81-b000-b2d872bf0cb8"],

