Cell["A vertex, a vertex list with a repeat, and a density.", "ExampleText",ExpressionUUID->"93758641-1c94-4d74-9eca-df1983cae93d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"AdjacencyList", "[", 
       RowBox[{"g", ",", " ", "a"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"densities", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraDensity", "[", 
        RowBox[{"g", ",", " ", "a"}], "]"}], ",", " ", 
       RowBox[{"InfraDensity", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"b", ",", " ", "a", ",", " ", "b"}], "}"}]}], "]"}], ",", 
       " ", 
       RowBox[{"InfraDensity", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"b", " ", "->", " ", "2"}], ",", " ", 
           RowBox[{"a", " ", "->", " ", "1"}]}], "|>"}]}], "]"}]}], "}"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", "density", "}"}], ",", " ", 
          RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"4", ",", " ", "16"}], "}"}]}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"density", ",", " ", "densities"}], "}"}]}], "]"}]}], ",", 
     " ", "densities"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"114a99d1-1f2d-4445-81a0-fdc2bc779dbe"],

