Cell[CellGroupData[{
Cell["InfraDensity", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"efa3b9d2-2422-4f2d-bac1-f237f2cc5ff4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDensity"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDensity", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["x", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fcfcf11b-0c42-4fd9-8140-0130243a2b94"],
 "\[LineSeparator]",
 "gives the marginal of the shape ",
 StyleBox["x", "TI"],
 " to the vertex set of ",
 StyleBox["graph", "TI"],
 ", an ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "583f44da-7a9a-457b-b15a-ab8e6f7e291d"],
 " of vertices ",
 StyleBox["v", "TI"],
 " to masses ",
 StyleBox["m", "TI"],
 ", with respect to the counting measure.",
 "\n"
}], "Usage",ExpressionUUID->"1e945371-2273-41e3-b875-95396a47f714"],

Cell["\<\
Definition: the density of a shape is the number of times it covers each \
vertex: once for a vertex, once per occurrence in a vertex list, and once per \
walk through the vertex for a family of walks.\
\>", "Notes",ExpressionUUID->"4a383d64-e039-433c-9f82-c02ca9ba54bf"],

Cell["It reads every shape:", "Notes",ExpressionUUID->"097a46f2-6ead-48e8-b919-ff4356e031b7"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b0b0773e-0804-4757-90cf-52cbd9822040"], Cell[TextData[StyleBox[
    "x", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"a153fe06-dbb3-49e8-9ce2-7659f96f2f6c"],
     Cell[TextData[Cell[BoxData[
     RowBox[{
      TemplateBox[{
        Cell[
         TextData["InfraDensity"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraDensity", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"], "[", 
      RowBox[{
       StyleBox["graph", "TI"], ",", " ", 
