Cell[CellGroupData[{
Cell["FindInfraHomotopyRepresentative", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b11ec033-7742-4b50-9d90-f52f4a216bcf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraHomotopyRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
FindInfraHomotopyRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb39c963-2933-48b4-bc04-7e282c74e90f"],
 "\[LineSeparator]",
 "gives certified shortest walks homotopic to ",
 StyleBox["walk", "TI"],
 ", as walk graphs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6185d857-0a22-47ba-893b-ea8f1b2c2a19"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraHomotopyRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
FindInfraHomotopyRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15d19a58-1ef5-4a87-a9d1-2ba952a8be7b"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["n", "TI"],
 " of them."
}], "Usage",ExpressionUUID->"f40eeb0f-27fc-4f54-a976-6e95e4e99b72"],

Cell[TextData[{
 "The homotopy class of a walk is the set of walks reached from it by the \
elementary moves of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HomotopicQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/HomotopicQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cd4f7573-630a-4635-9c55-0ab55a41aaf5"],
 ". An open walk keeps its endpoints, a closed walk its base point. A result \
is returned only when minimal length is certified. Exact reduction in the \
face-free relation, a constant free path, or attainment of the metric lower \
bound can supply such a certificate."
}], "Notes",ExpressionUUID->"28fb6d40-c5e7-42cb-b15c-63f691c6d362"],

Cell["\<\
There can be several shortest representatives, and a hole can prevent a walk \
from shrinking.\
\>", "Notes",ExpressionUUID->"356edc89-59f8-41ff-9ac4-27d7364604fb"],

Cell[TextData[{
 "Face search obeys ",
 Cell[BoxData["\"\<MaxLength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e275f97-1cfd-44fd-9b47-520ba75c1113"],
 ", ",
 Cell[BoxData["\"\<MaxMoves\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11723610-1201-4573-913f-d913add864d7"],
 " and ",
 Cell[BoxData["\"\<MaxStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86952b77-980e-486b-b92a-a17adc9696b6"],
 "; exact reduction and free-endpoint constructions can bypass these search \
budgets. A minimum in a bounded search is not automatically a minimum of the \
full homotopy class: reaching a shorter walk may require a longer \
intermediate walk. Without a certificate the call remains unevaluated."
}], "Notes",ExpressionUUID->"689d9fb2-258a-4eca-9e81-76b4f8e986da"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3200888-7b43-46da-8888-b9c5c44490bb"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f2bee2d-81c1-4eb6-9017-c3bb17107b14"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7de663d-3b5a-4c62-a7be-4896f2e84cbe"],
 ", the default. The options are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HomotopicQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/HomotopicQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a2a7a6ad-fbd7-40f9-966d-14cac1473510"],
 ", including ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "Automatic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8fea0ec-e53b-4b50-9d94-7038da9254b5"],
 " and ",
 Cell[BoxData[
  RowBox[{"\"\<MaxStates\>\"", " ", "->", " ", "1000"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9327a5b0-3a23-4177-9595-49b2b96434cf"],
 ". ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb8dad83-2cfc-46bb-92d2-5e733d2eba7a"],
 " returns a result only when completeness of the shortest-representative \
family is certified; otherwise the call remains unevaluated. ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b74d8ac2-88ee-4bab-b89c-b03dba439a49"],
 " can return found certified minima without claiming the family is \
complete."
}], "Notes",ExpressionUUID->"aa129f5c-743f-46d3-a62f-415625c5f961"],

Cell[TextData[{
 "An exact integer count requires that many certified shortest \
representatives. A proved shortage gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b409b265-1b85-477b-b792-29d449bd4bd5"],
 "; an unresolved shortage leaves the call unevaluated."
}], "Notes",ExpressionUUID->"6bdf68e0-3b50-47ee-a8b0-0d113257b2a8"]
}, Open  ]],

