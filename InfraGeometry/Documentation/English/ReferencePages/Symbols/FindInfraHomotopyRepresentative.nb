Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0f4ba4ee-475c-43b9-828f-73d11e639499"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraHomotopyRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
FindInfraHomotopyRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4cf27ef5-6e62-416a-9ccd-2f117da68c50"],
 "\[LineSeparator]",
 "returns {head[{w}]} for a length-shortest walk in obj's homotopy class \
(head matches the input wrapper; InfraCircle coerces to InfraString); n / \
UpTo[n] / All controls multiplicity.",
 "\n"
}], "Usage",ExpressionUUID->"5631c211-2a74-4d1c-aac4-3e64c07a8ff5"],

