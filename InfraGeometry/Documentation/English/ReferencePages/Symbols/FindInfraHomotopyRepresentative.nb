Cell["\<\
The last walk of a reduction chain is a shortest representative:\
\>", "ExampleText",ExpressionUUID->"2768530f-d85b-4467-a9db-fe1cdd76a033"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "3", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"walk", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"MemberQ", "[", 
    RowBox[{
     RowBox[{"FindInfraHomotopyRepresentative", "[", 
      RowBox[{"g", ",", " ", "walk"}], "]"}], ",", "\n", "    ", 
     RowBox[{"Last", " ", "@", " ", 
      RowBox[{"FindInfraHomotopyRepresentativeHomotopy", "[", 
       RowBox[{"g", ",", " ", "walk"}], "]"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f262698d-aa64-4601-a653-d51c3d3c483e"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0e63f036-590b-4ee3-a583-04c59f3c159f"]
}, Open  ]]
}, Open  ]],

