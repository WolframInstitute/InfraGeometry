  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"PathGraph", "[", 
      RowBox[{"Range", "[", "3", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Map", "[", 
    RowBox[{"Last", ",", " ", 
     RowBox[{"VertexList", " ", "/@", " ", 
      RowBox[{"FindInfraHomotopyRepresentative", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "2"}], "}"}]}], 
       "]"}]}], ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4aefbcbe-2d30-4c65-9698-7397ef287364"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2"}], "}"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"70950edf-e46d-4973-8b0b-bae4f9fb6eb7"]
}, Open  ]]
}, Open  ]],

