Cell["\<\
A triangle shortcut gives the unique shortest representative:\
\>", "ExampleText",ExpressionUUID->"69f92804-3a06-4341-b31e-ef8fe0dd11dc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "3", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Map", "[", 
    RowBox[{"Last", ",", " ", 
     RowBox[{"VertexList", " ", "/@", " ", 
      RowBox[{"FindInfraHomotopyRepresentative", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"67f73323-ce38-4c2c-8888-e2341de92263"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"1", ",", "3"}], "}"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0fc65e57-21b1-4588-86d7-d0c56102d6c1"]
}, Open  ]],

Cell["\<\
A square loop stays nontrivial when only triangles are filled. Declaring the \
square a face lets it contract:\
\>", "ExampleText",ExpressionUUID->"a44b9a53-f040-41d2-94b4-9de536125b69"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "4", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{"Last", ",", " ", 
       RowBox[{"VertexList", " ", "/@", " ", 
        RowBox[{"FindInfraHomotopyRepresentative", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
           "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "1"}], 
           "}"}], ",", "\n", "    ", 
          RowBox[{"\"\<NullHomotopicCycles\>\"", " ", "->", " ", "k"}], ",", 
          " ", 
          RowBox[{"\"\<MaxLength\>\"", " ", "->", " ", "5"}]}], "]"}]}], ",", 
       " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a062fd20-42fa-4850-bd57-68a32ef71b33"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "1"}], "}"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"{", "1", "}"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"89324d6f-4d98-46eb-9be5-344fd9bd1a8b"]
}, Open  ]]
}, Open  ]],

