Cell["\<\
With the square filled, its two shortest routes are both representatives. The \
search certifies the complete family:\
\>", "ExampleText",ExpressionUUID->"ad526447-2652-40fb-81ca-65fd74f7716e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "4", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Map", "[", 
    RowBox[{"Last", ",", " ", 
     RowBox[{"VertexList", " ", "/@", " ", 
      RowBox[{"FindInfraHomotopyRepresentative", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", "All", 
        ",", "\n", "    ", 
        RowBox[{"\"\<NullHomotopicCycles\>\"", " ", "->", " ", "4"}], ",", 
        " ", 
        RowBox[{"\"\<MaxLength\>\"", " ", "->", " ", "3"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3b4fb285-31b6-48b2-a866-7158d68bdf1a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "4", ",", "3"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"51e071c4-fc76-4a8d-b817-d3339d0e6a5f"]
}, Open  ]],

Cell["A backtrack reduces without any face relation:", "ExampleText",ExpressionUUID->"3487114b-827e-4e23-9a06-a2012aff0189"],

Cell[CellGroupData[{

Cell[BoxData[
