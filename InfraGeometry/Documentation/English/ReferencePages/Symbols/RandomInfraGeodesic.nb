Cell[TextData[{
 "The geodesics of at most 8 edges from the centre that end at a vertex 4 \
away, at scales 2, 3 and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9da893bf-58f2-4b2c-b1ad-7c3f852065ab"],
 ". At scale ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9e59c4cd-6e54-48e6-ae1d-98bc515f8e49"],
 " they are the 4 shortest paths; at smaller scales some go round:"
}], "ExampleText",ExpressionUUID->"281743a1-dd35-4cd1-93c5-a0b21176f588"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
          " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"grown", " ", "=", " ", 
        RowBox[{"RandomInfraGeodesic", "[", 
         RowBox[{"g", ",", " ", "a", ",", " ", "s", ",", " ", 
          RowBox[{"UpTo", "[", "8", "]"}], ",", " ", "All", ",", " ", 
          RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "b"}], " ", 
             "&"}], ")"}]}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"ending", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"grown", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Last", " ", "@", " ", 
             RowBox[{"Last", " ", "@", " ", 
              RowBox[{"VertexList", " ", "@", " ", "#"}]}]}], " ", "===", " ",
             "b"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"ending", ",", " ", "a", ",", " ", "b"}], "}"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"Length", "[", "ending", "]"}]}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"s", ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3", ",", " ", "Infinity"}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c9081478-9896-4bdd-a687-a8cd25add59e"],

