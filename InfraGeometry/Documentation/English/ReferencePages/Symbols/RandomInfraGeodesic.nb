      FontSize->0.9 Inherited,ExpressionUUID->
      "9293d35c-177f-4578-8ac9-cb516e8b6c75"],
     ", ",
     Cell[BoxData["RandomChoice"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "616007a3-ad7e-4699-a462-2f8f0a0188d6"],
     " (the random walk; the count is independent runs), or a function of the \
candidate windows giving the ones to pursue in order"
    }], "TableText",ExpressionUUID->"1ae1b4f7-e152-46ef-bf36-3a1780510ec9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "dc110aaa-17c2-48dd-b3ca-92183543f794"], Cell[TextData[Cell[
    BoxData["\"\<Direction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "fc36e606-a02e-4257-a197-9a0193dc4b30"]], "TableText",ExpressionUUID->
     "a4308a78-f5b4-4f3f-b936-070100e99848"], Cell[TextData[Cell[
    BoxData["\"\<Forward\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "40f1876e-b77d-4d58-91f8-d25c1fce1ada"]], "TableText",ExpressionUUID->
     "4e9adb9f-1b4e-4621-99a8-b035423a14c8"], Cell[TextData[{
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e77f835a-d0de-45a6-b871-b8a12d858b0b"],
     ", ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "926df5aa-272c-4791-99bd-3a7fc834d64e"],
     " or ",
     Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9dd55e7c-ff1d-435a-9520-baac899ad152"]
    }], "TableText",ExpressionUUID->"28388719-f40b-4b22-9909-76971ac679c0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "52468e8b-8a0f-432c-9d13-a0a0a9f46b5c"], Cell[TextData[Cell[
    BoxData["\"\<StoppingCondition\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "8cddf202-2a0c-4a84-9c2b-2f00cb67897d"]], "TableText",ExpressionUUID->
     "99a33b70-6893-424c-a701-579b981d8e32"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "e097549f-d2cb-4b67-9f32-95bbb13d9bc9"]], "TableText",ExpressionUUID->
     "8e0dc78b-21ed-4957-a96d-f7d3feeb15e2"], Cell[
    "a predicate on the walk so far", "TableText",ExpressionUUID->
     "d67ce415-36bd-49df-9bf9-0e693bf99661"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "be81882d-42a2-4138-ba4d-54bb9396ea7c"], Cell[TextData[Cell[BoxData[
    "RandomSeeding"], "InlineFormula",
