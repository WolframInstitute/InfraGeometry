  FontSize->0.9 Inherited,ExpressionUUID->
  "4134e629-6291-4369-807f-9f7363fe68aa"],
 " has set:"
}], "ExampleText",ExpressionUUID->"6d867017-c554-4914-ad96-4dbfd83e1149"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "k", "]"}], ";", " ", 
    RowBox[{"Last", " ", "/@", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"RandomInfraGeodesic", "[", 
       RowBox[{
        RowBox[{"GridGraph", "[", 
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", "1", ",", " ",
         "Infinity", ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], "]"}]}]}]}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "2"}], "}"}]}], "]"}]], "Input",
