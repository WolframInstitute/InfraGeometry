     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1f7ddf30-9515-40d6-90f4-3e34826d34b0"],
     " (random candidate order by the weights for bounded counts; canonical \
for ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "bf3a10d0-58d8-4078-a3fb-4c9de8dd5f41"],
