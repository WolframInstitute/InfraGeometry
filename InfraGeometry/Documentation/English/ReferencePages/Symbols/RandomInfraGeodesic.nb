      FontSize->0.9 Inherited,ExpressionUUID->
      "87ffadaf-7262-45e4-943a-4ea397dd6f0a"],
     ", or an energy function of the window"
    }], "TableText",ExpressionUUID->"f4d7b378-cd9a-448c-9678-577b1a1f9b38"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "97f3f619-5b56-4afc-a6d7-69ae475a8f3c"], Cell[TextData[Cell[
