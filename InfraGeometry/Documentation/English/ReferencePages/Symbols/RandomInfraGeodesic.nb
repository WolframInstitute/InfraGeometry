Cell[TextData[{
 "The geodesics of at most 8 edges from the centre of the square tiling to a \
vertex four steps away, at infra-scales 2, 3 and ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cda2c5a5-a7fe-4328-be1f-c713491f464d"],
 ". At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58719e4b-dc1c-4477-b756-de0de6715e4a"],
 " they are the six shortest paths; at the smaller scales they include \
locally shortest walks that go round."
}], "ExampleText",ExpressionUUID->"398fc8cc-a4ca-439f-94ed-ac8ec7ed3686"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"a", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"Row", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"grown", " ", "=", " ", 
          RowBox[{"RandomInfraGeodesic", "[", 
           RowBox[{"g", ",", " ", "a", ",", " ", "sc", ",", " ", 
            RowBox[{"UpTo", "[", "8", "]"}], ",", " ", "All", ",", " ", 
            RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "b"}], " ", 
               "&"}], ")"}]}]}], "]"}]}], "}"}], ",", "\n", "      ", 
        RowBox[{"{", 
         RowBox[{"geos", " ", "=", " ", 
          RowBox[{"Select", "[", 
           RowBox[{"grown", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Last", " ", "@", " ", 
               RowBox[{"Last", " ", "@", " ", 
                RowBox[{"VertexList", " ", "@", " ", "#"}]}]}], " ", "===", 
              " ", "b"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "      ", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"geos", ",", " ", "a", ",", " ", "b"}], "}"}]}], "]"}], ",",
           " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<scale \>\"", ",", " ", "sc", ",", " ", "\"\<: \>\"", 
             ",", " ", 
             RowBox[{"Length", " ", "@", " ", "geos"}]}], "}"}], "]"}]}], 
         "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"sc", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "Infinity"}], "}"}]}], "}"}]}],
      "]"}]}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d3b6dc0e-62fe-40eb-bbcd-894178417b25"],

