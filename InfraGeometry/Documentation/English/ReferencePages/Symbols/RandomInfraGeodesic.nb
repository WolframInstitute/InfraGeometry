Cell["\<\
One geodesic at infra-scale 3 of exactly 6 edges from the centre, beside its \
vertex sequence.\
\>", "ExampleText",ExpressionUUID->"b729e575-01b6-41b5-b2bb-8dc09c1d2400"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"geo", " ", "=", " ", 
     RowBox[{"RandomInfraGeodesic", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "3", ",", " ", 
       RowBox[{"{", "6", "}"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"geo", ",", " ", "a"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Last", " ", "/@", " ", 
      RowBox[{"VertexList", "[", "geo", "]"}]}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c6807e5c-a8fd-49c9-b610-a61debaf4a0f"],

