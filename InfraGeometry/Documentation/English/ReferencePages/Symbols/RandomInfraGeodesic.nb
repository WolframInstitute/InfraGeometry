      FontSize->0.9 Inherited,ExpressionUUID->
      "03898fc1-29ec-482b-aabd-6ea9b3cbf4f7"],
     ", or an energy function of the window"
    }], "TableText",ExpressionUUID->"35976684-b682-4c28-a58d-2c7bcdec41d4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
