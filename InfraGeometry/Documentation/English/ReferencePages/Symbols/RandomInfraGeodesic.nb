Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"geos", " ", "=", " ", 
     RowBox[{"RandomInfraGeodesic", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "3", ",", " ", 
       RowBox[{"{", "5", "}"}], ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"geos", ",", " ", "a"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"InfraGeodesicQ", "[", 
      RowBox[{"g", ",", " ", "geos", ",", " ", "3"}], "]"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c9171cc4-0bae-4653-89bb-79e1433310d2"],

