Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraGeodesic", "ObjectName",ExpressionUUID->"319f5eb7-27ae-40e1-beda-24b51ac9f52d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b9704566-5a80-49c9-b4c4-6cc65dbba3eb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04a3c409-3fca-4886-9178-b2bc5d3d0913"],
 "\[LineSeparator]",
 "gives one geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " grown from ",
 StyleBox["germ", "TI"],
 ", with a length inside the budget ",
 StyleBox["kspec", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f6b61bbe-2a5a-430b-84ba-824086c495fa"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd05390a-a00e-4739-9ec7-cef3f47bbe64"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef90d530-213a-488c-a5df-5344a6d9b89e"],
 " of exactly ",
 StyleBox["n", "TI"],
 " geodesics or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5a3a3ec-8811-4bec-8fa1-4eea94493ac6"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49421437-40f0-4b51-bca6-1209b29a83f7"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d711741c-50d6-431c-b10b-b7934b1ed667"],
 " gives every one."
}], "Usage",ExpressionUUID->"57ecbcd6-47f3-48b8-9e50-55a5cde2cc11"],

Cell[TextData[{
 "The default draw is random. Seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bb39044-374d-4825-a4c3-a81ad6e3f4d0"],
 " to reproduce it. Give ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3cd8003-0409-4889-aa7e-a915ac94daaf"],
 " for deterministic descent. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee9675e1-3c88-4818-87a7-b17788be6bb4"],
 " with ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fda6d6bf-6bb1-47cd-927f-a57df5e9060e"],
 " keeps the full enumeration without drawing."
}], "Notes",ExpressionUUID->"50b4e2e1-f39b-4a2d-bbdd-91ea2e985180"],

Cell[TextData[{
 "Definition: a walk ",
 StyleBox["v0", "TI"],
 ", ",
 StyleBox["v1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["vk", "TI"],
 " is a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " when every window of ",
 StyleBox["s", "TI"],
 " consecutive vertices together with the next one is a shortest path: ",
 StyleBox["d(v(i\[Minus]s), vi) = s", "TI"],
 " for every ",
 StyleBox["i \[GreaterEqual] s", "TI"],
 ", and ",
 StyleBox["d(v0, vi) = i", "TI"],
 " for ",
 StyleBox["i < s", "TI"],
 "."
}], "Notes",ExpressionUUID->"f6561cac-8d66-4c02-89c8-2a647df4b0b1"],

Cell[TextData[{
 "The scale is how far back the observer sees. At scale ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4db05926-61d7-4f58-aa26-f3f108847444"],
 " the condition asks only for adjacency, so every walk is a geodesic. At \
scale ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5c0f981-a99f-4737-9420-7a2080eedef4"],
 " it forbids stepping back, and on a graph with triangles also cutting a \
triangle's corner. At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7f42fae-b2fe-4221-98c8-e98d1af9b03c"],
 " the whole walk is a shortest path, a segment. In between, a geodesic is \
locally shortest and may be globally long: it can wind round a square at \
scale ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d066397-3712-4825-8217-398bccad2a80"],
 ", and round a larger loop at scale ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0de2ddaa-b3b1-4ab9-be81-cc5b09c8a47c"],
 "."
}], "Notes",ExpressionUUID->"25911184-39eb-4408-8c9d-1f335b25fec6"],

Cell[TextData[{
 "This is the Riemannian geodesic read by an observer with a horizon. On a \
manifold a geodesic minimises length between nearby points only, and it need \
not be the shortest path between its ends. At infra-scale ",
 StyleBox["s", "TI"],
 " the same holds with \"nearby\" meaning \"fewer than ",
 StyleBox["s", "TI"],
 " steps apart\"."
}], "Notes",ExpressionUUID->"e04dc8d7-b187-4fe4-ac19-5c6484144ec8"],

Cell[TextData[{
 "The germ is a vertex, a vertex list, a walk graph, or a list of germs; a \
vertex is the one-vertex germ, and the germ must itself be a geodesic at \
scale ",
 StyleBox["s", "TI"],
 " for anything to grow. ",
 StyleBox["kspec", "TI"],
 " is the budget in edges added on each growing side: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bfbe5ca-4023-40c8-b710-98278924e47d"],
 " (at most ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "038e4372-168a-4ad0-b0c7-30ed3ba1a9ae"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b145a6f4-68d5-4fbf-a2c0-8ad97052cc3a"],
 ", or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26c6cd03-e2fe-4472-8ceb-ec5e8791c644"],
 ". A bare integer is no ",
 StyleBox["kspec", "TI"],
 ". At a finite scale the class is infinite, so a finite budget is required; \
only scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52a1e427-3d22-4a5e-92c5-e42fce2ff584"],
 " accepts ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "457de320-87b9-4f9d-9159-12c404c0fa91"],
 "."
}], "Notes",ExpressionUUID->"d4c59c0c-47ab-458b-a6cc-055877b321bc"],

Cell[TextData[{
 "The default ",
 Cell[BoxData["\"\<Direction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aeaf5dae-73dc-4633-bb30-1ade84aafa0e"],
 " is ",
 Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "184d14c7-1397-4481-8997-0c2e33f1113e"],
 ", as for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3b32adc1-b62f-430d-9cf5-f1ff9c3a29fb"],
 ": the geodesics that continue the germ past its last vertex. ",
 Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8af2e312-5e8c-4006-9103-b8fe3226f689"],
 " grows before the first vertex and ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26ee8c0d-2ddf-46a5-9feb-670e51c3fb32"],
 " at both ends; at scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ba74d27-4ec4-459e-b7e8-2b81050c74f5"],
 " a walk germ grown on both sides gives the geodesics that contain it."
}], "Notes",ExpressionUUID->"b047a000-6d6c-44aa-bec6-e2b5dd184a82"],

Cell[TextData[{
 "A geodesic is a walk graph: a directed path graph on the pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "v"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22dc59d6-1d01-41f1-b4b7-06531ba7d9c5"],
 ", the position and the vertex. ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe2cc7e8-de86-4819-a39a-437a1e4c4740"],
 " is its vertex sequence, and ",
 Cell[BoxData[
  RowBox[{"EdgeCount", "[", "w", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78e0a730-c0fd-4400-9a12-4c4ac2bcbf2d"],
 " its length. The count-less call returns one walk graph, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48b12510-769d-40bd-82af-62427979097d"],
 " when there is none."
}], "Notes",ExpressionUUID->"cdfbf617-4287-4667-a835-bd7aa8a5e9fb"],

Cell[TextData[{
 "The search reads only the window, never a target. A target is a stopping \
condition: ",
 Cell[BoxData[
  RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "q"}], " ", "&"}], 
    ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66290c13-668e-40d0-abb4-b585241e9dfa"],
 " stops each geodesic at its first arrival at ",
 StyleBox["q", "TI"],
 ", and the geodesics that end at ",
 StyleBox["q", "TI"],
 " are the ones left by ",
 Cell[BoxData["Select"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ff55215-1944-4353-9280-4788a9b4c36d"],
 ". At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e2341d4-7d75-46e7-b758-3bbb24006844"],
 " the target-aware search is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f3290268-b92b-4f6f-afd1-9918f7c05d68"],
 "."
}], "Notes",ExpressionUUID->"1943e02b-3d8f-464d-9683-0a22a856479d"],

Cell[TextData[{
 Cell[BoxData["RandomInfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "995ec721-e424-420f-870b-a33c47587fd7"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1e5ef644-7ec9-4f7d-b1aa-64824c3b4243"],
 " with ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Shortest\>\"", ",", " ", "s"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7b861b8-404e-480d-bfe0-1ee63e281718"],
 " first among the rules. The options are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0898ef9c-c737-4d0a-a57f-fba8eadf4dde"],
 ":"
}], "Notes",ExpressionUUID->"e81c8f6e-fee3-4a11-bbba-fae90eedd942"],

