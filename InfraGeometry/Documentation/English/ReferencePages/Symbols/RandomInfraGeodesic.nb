Cell[TextData[{
 "A geodesic germ of scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e3c238d-8807-4c7a-b89b-174a52d48423"],
 " grown without a budget on both sides gives the lines through it: the \
vertex lists of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraInfiniteLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraInfiniteLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "84aba636-ed0d-4d82-9a0d-5bf09e151da1"],
 "."
}], "ExampleText",ExpressionUUID->"551bf731-0eb4-40b5-a928-92c266035aa3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"germ", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}]}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"geos", " ", "=", " ", 
     RowBox[{"RandomInfraGeodesic", "[", 
      RowBox[{
      "g", ",", " ", "germ", ",", " ", "Infinity", ",", " ", "Infinity", ",", 
       " ", "All", ",", " ", 
       RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<BothSides\>\""}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"geos", ",", " ", "germ"}], "}"}]}], "]"}], ",", "\n", "   ", 
     
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Last", " ", "/@", " ", 
          RowBox[{"VertexList", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ",
         "geos"}], "]"}], " ", "===", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"RandomInfraInfiniteLine", "[", 
        RowBox[{"g", ",", " ", "germ", ",", " ", "All"}], "]"}]}]}]}], 
    "}"}]}], "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"f1b65b9c-ea03-4944-803b-12f0c3d131ed"],

