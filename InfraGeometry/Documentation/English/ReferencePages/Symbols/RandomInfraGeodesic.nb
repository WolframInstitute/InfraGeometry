Cell[TextData[{
 "A walk is a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " when every ",
 StyleBox["s", "TI"],
 " + 1 consecutive vertices form a shortest path, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraGeodesicQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraGeodesicQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d6f739f3-de60-4a27-9811-6c1c1ba0d325"],
 " tests. At scale 1 every walk is a geodesic; at scale 2 a geodesic never \
steps back; at scale ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ee02c635-c5d5-4202-98aa-16e9551972aa"],
 " it is a shortest path."
}], "Notes",ExpressionUUID->"3b177942-0452-4b1f-8027-6b02a14a40bc"],

Cell["\<\
A geodesic at a finite scale is locally shortest and may be long overall: it \
can go round a square and come back to where it started.\
\>", "Notes",ExpressionUUID->"54fa7324-7173-4a64-8ef5-a16b18d8a2e6"],

Cell[TextData[{
 "The germ is a vertex or a vertex list, and must itself be a geodesic at \
scale ",
 StyleBox["s", "TI"],
 ". The walk continues it past its last vertex."
}], "Notes",ExpressionUUID->"80cabcd9-3f1b-4da3-8ee0-017e981afc03"],

Cell[TextData[{
 StyleBox["kspec", "TI"],
 " is the number of edges added: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab0c626a-f5f0-429f-a18e-cac5a07c57ba"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41d62a89-1695-4389-aed3-9bd537ae9858"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"kmin", ",", " ", "kmax"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4f8d8e6-db92-4e35-b334-e9a86f50160f"],
 ", or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9995b71c-6510-4e50-856c-6d176b06e06a"],
 ". At a finite scale the geodesics can be arbitrarily long, so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3747939b-9b40-42de-9345-574c64977cf4"],
 " needs scale ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "65245dcb-243c-4e94-85ea-41ac30d91d21"],
 "."
}], "Notes",ExpressionUUID->"561d1b0c-72a7-4056-a4a8-26601ec0916e"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2eee7cc-1ead-47eb-92ba-24786f37048e"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5eb322ea-9f21-4d0e-9ca8-ccfd90ec9b7f"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "447a2a74-3bbb-4060-8772-a61aea15ee96"],
 ". Fewer than ",
 StyleBox["n", "TI"],
 " geodesics give ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "157f840a-32dd-4b51-850e-ded74cdbf346"],
 "."
}], "Notes",ExpressionUUID->"20e442d0-e515-4545-a0ec-2d38ef8be173"],

Cell[TextData[{
 "A geodesic from the germ form is a walk graph: a directed path graph on the \
pairs {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "} of position and vertex. ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b05b54e-9d67-4f0c-9a1d-10b3b07dee8d"],
 " is its vertex sequence."
}], "Notes",ExpressionUUID->"e9afd676-a3eb-4b9c-9486-5d14af343e52"],

