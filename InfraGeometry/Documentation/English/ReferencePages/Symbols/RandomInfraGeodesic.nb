Cell["\<\
A geodesic germ of two vertices grown on both sides: the shortest paths that \
contain the edge and prolong it by at most 2 edges at each end.\
\>", "ExampleText",ExpressionUUID->"a8d8350c-ccc8-41f9-be3a-5c1f3240cf5c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"germ", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}]}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"geos", " ", "=", " ", 
     RowBox[{"RandomInfraGeodesic", "[", 
      RowBox[{"g", ",", " ", "germ", ",", " ", "Infinity", ",", " ", 
       RowBox[{"UpTo", "[", "2", "]"}], ",", " ", "All", ",", " ", 
       RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<BothSides\>\""}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
