     FontWeight->Bold,ExpressionUUID->"ba70ca75-ad6b-429d-9ee2-ef417a09f18a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "dc11bdcb-35d1-412b-bf64-d334d991d3bb"], Cell[TextData[Cell[BoxData[
    "Properties"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3b912775-3554-4999-8d44-f1e1b8ac4501"]], "TableText",ExpressionUUID->
     "a88ade57-cc86-4b2e-93a2-dd712aad630d"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "061d018c-48da-4f4c-ab7c-eeff4114dff7"]], "TableText",ExpressionUUID->
