Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraGeodesic", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6d450863-e14e-4273-81ef-f7f699c2dd3f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a965ac5c-4134-4745-9c9a-12188af53321"],
 "\[LineSeparator]",
 "gives one geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " grown from ",
 StyleBox["germ", "TI"],
 ", with a length inside the budget ",
 StyleBox["kspec", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ae4d447b-4bfe-4b56-ac97-5da39908dfd9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraGeodesic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["s", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb9c62ae-424b-455d-baff-10bf9e5d372b"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1986840b-e956-4802-8a9b-4bde62e0da4f"],
 " of exactly ",
 StyleBox["n", "TI"],
 " geodesics or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d341e836-9eac-4edb-95b9-d67ad5005e9b"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2356d6c1-2aef-426f-8730-4f2a0bab6f41"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "226ed5f9-8b61-4472-b30b-35229a3e4baf"],
 " gives every one."
}], "Usage",ExpressionUUID->"43ac805d-cd54-431c-ba6d-7fee1c5d466c"],

Cell[TextData[{
 "The default draw is random. Seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9fd7c39-b2b9-4b1c-a117-3250159410e8"],
 " to reproduce it. Give ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e176175-1e45-4a7e-b704-c2b30428165c"],
 " for deterministic descent. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eeffd7a1-2407-4797-a8b3-41e463baf2ff"],
 " with ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ada999a7-7212-41c7-94ad-093096d5118a"],
 " keeps the full enumeration without drawing."
}], "Notes",ExpressionUUID->"c73ec96a-e788-489e-bb36-a87a2e3c5b53"],

Cell[TextData[{
 "Definition: a walk ",
 StyleBox["v0", "TI"],
 ", ",
 StyleBox["v1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["vk", "TI"],
 " is a geodesic at infra-scale ",
 StyleBox["s", "TI"],
 " when every window of ",
 StyleBox["s", "TI"],
 " consecutive vertices together with the next one is a shortest path: ",
 StyleBox["d(v(i\[Minus]s), vi) = s", "TI"],
 " for every ",
 StyleBox["i \[GreaterEqual] s", "TI"],
 ", and ",
 StyleBox["d(v0, vi) = i", "TI"],
 " for ",
 StyleBox["i < s", "TI"],
 "."
}], "Notes",ExpressionUUID->"4e5d31a5-e4c0-4979-9844-08eab08c67a0"],

Cell[TextData[{
 "The scale is how far back the observer sees. At scale ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa035656-1509-42a8-99e2-0bd121fcb283"],
 " the condition asks only for adjacency, so every walk is a geodesic. At \
scale ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d4a9604-1c54-4b7c-b88c-15848def4a8b"],
 " it forbids stepping back, and on a graph with triangles also cutting a \
triangle's corner. At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15cb8e01-24df-40a7-a7bd-13ca5393ffe4"],
 " the whole walk is a shortest path, a segment. In between, a geodesic is \
locally shortest and may be globally long: it can wind round a square at \
scale ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21c8059c-eb09-49c0-8283-21f8e5ff287e"],
 ", and round a larger loop at scale ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c3b587d-6bb8-4213-8ee0-d4685e5a9f41"],
 "."
}], "Notes",ExpressionUUID->"071b6f1f-0c89-4e48-8de2-47c17b860bed"],

Cell[TextData[{
 "This is the Riemannian geodesic read by an observer with a horizon. On a \
manifold a geodesic minimises length between nearby points only, and it need \
not be the shortest path between its ends. At infra-scale ",
 StyleBox["s", "TI"],
 " the same holds with \"nearby\" meaning \"fewer than ",
 StyleBox["s", "TI"],
 " steps apart\"."
}], "Notes",ExpressionUUID->"51e60b00-774f-4a43-bfc8-38d753768d84"],

Cell[TextData[{
 "The germ is a vertex, a vertex list, a walk graph, or a list of germs; a \
vertex is the one-vertex germ, and the germ must itself be a geodesic at \
scale ",
 StyleBox["s", "TI"],
 " for anything to grow. ",
 StyleBox["kspec", "TI"],
 " is the budget in edges added on each growing side: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0440aab0-1abc-49b8-a74d-f5a3bd3ecce8"],
 " (at most ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67d54214-97d1-46b9-b55f-f4300744ff8c"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3323b68c-9829-4d6a-ac4d-1c0c077307f5"],
 ", or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14bcd1c8-72c7-4814-b865-48023803d88f"],
 ". A bare integer is no ",
 StyleBox["kspec", "TI"],
 ". At a finite scale the class is infinite, so a finite budget is required; \
only scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5201587-2194-4221-9cd8-5379850133f5"],
 " accepts ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6822f8c-c97d-4b43-a4e3-3d437e2ebb2e"],
 "."
}], "Notes",ExpressionUUID->"84cd5f90-e4a0-4797-a28e-988cd6c74888"],

Cell[TextData[{
 "The default ",
 Cell[BoxData["\"\<Direction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b420f9db-cf7d-446e-80f7-da8c1624e9a4"],
 " is ",
 Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a07a76c3-1067-43ab-af42-1af0dc1a1095"],
 ", as for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7bdf7fbb-3702-47a9-8c95-3da96acfdc70"],
 ": the geodesics that continue the germ past its last vertex. ",
 Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b585f06f-6e33-4f06-a6d5-e013b51f567b"],
 " grows before the first vertex and ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a4e75f9-760d-4579-9a57-712ade3180ab"],
 " at both ends; at scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "796cfbab-99c9-4280-9d99-3f6d9a3f9ed3"],
 " a walk germ grown on both sides gives the geodesics that contain it."
}], "Notes",ExpressionUUID->"dd55f0af-53e5-4c04-a67c-f4d282c7a6bf"],

Cell[TextData[{
 "A geodesic is a walk graph: a directed path graph on the pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "v"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f55eda70-95ab-4e25-a35a-269114a4e873"],
 ", the position and the vertex. ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d091a9b3-e1ce-423f-832b-88b5d3fd06a8"],
 " is its vertex sequence, and ",
 Cell[BoxData[
  RowBox[{"EdgeCount", "[", "w", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "368db9a3-79ee-4a97-9351-d5c64f1ea607"],
 " its length. The count-less call returns one walk graph, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bd05c39-bc5d-4efa-b0fc-d94a52ab2f11"],
 " when there is none."
}], "Notes",ExpressionUUID->"b2f8ce7e-bde0-43f2-b504-1b3f0f422f52"],

Cell[TextData[{
 "The search reads only the window, never a target. A target is a stopping \
condition: ",
 Cell[BoxData[
  RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "q"}], " ", "&"}], 
    ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "257b8753-61c0-4463-9f2f-4b1a21a327a9"],
 " stops each geodesic at its first arrival at ",
 StyleBox["q", "TI"],
 ", and the geodesics that end at ",
 StyleBox["q", "TI"],
 " are the ones left by ",
 Cell[BoxData["Select"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d8bda91-fa9c-4eb9-8bca-aa105c548863"],
 ". At scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d11d1592-21fc-48b6-893f-fdb0186419fe"],
 " the target-aware search is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f8172411-b45c-454b-b8c5-48b7b7746317"],
 "."
}], "Notes",ExpressionUUID->"9ab922b1-c390-47c4-a650-8c6a074aedff"],

Cell[TextData[{
 Cell[BoxData["RandomInfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c245835-74a1-4a63-98c3-3463585d20a4"],
 " is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d1142583-7232-456d-83c9-aaca92f51e04"],
 " with ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Shortest\>\"", ",", " ", "s"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da8d9fa0-855d-4146-be7c-2aa0eed76967"],
 " first among the rules. The options are those of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "546a418c-66ce-4705-a536-2187e359fbe1"],
 ":"
}], "Notes",ExpressionUUID->"c8875dc3-5d67-4834-9d06-f573a4cf5caf"],

