Cell[CellGroupData[{

Cell["NextVertexFunction", "ExampleSubsection",ExpressionUUID->"8965efbd-828b-4f80-8609-609ac8ea61b3"],

Cell[TextData[{
 "Under ",
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cdd4f9d6-87ea-49f6-bd19-c9e02b005802"],
 " each step is drawn uniformly among the admissible ones. Three geodesics at \
scale 2 of 12 edges from the centre:"
}], "ExampleText",ExpressionUUID->"69c592ad-0676-4cce-94e4-e732e9fd3ced"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
          " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"walk", " ", "=", " ", 
        RowBox[{"RandomInfraGeodesic", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "2", ",", " ", 
          RowBox[{"{", "12", "}"}], ",", " ", 
          
          RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
           "RandomChoice"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "k"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"walk", ",", " ", "c"}], "}"}]}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"617778a0-7e8a-4ebc-bf66-5b4402ea7d2e"],

