      FontSize->0.9 Inherited,ExpressionUUID->
      "94d560f0-a801-4544-82f5-942c43d686c9"],
     " with the window ",
     StyleBox["r", "TI"],
     " and the weight ",
     StyleBox["p", "TI"],
     ": ",
     Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6b39c93a-839b-4250-9595-3204aa3ab06c"],
     ", ",
     Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0a852346-7844-4171-820b-eeec5ee2a3d3"],
     ", ",
     Cell[BoxData["\"\<Stretched\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1343fc17-3169-4e2b-a6fd-d3e1177287a9"],
     ", or an energy function of the window"
    }], "TableText",ExpressionUUID->"cd20a8ab-c96c-4c2b-b89c-e5e1312487e2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2c8f94c2-c0d2-4e3a-8e14-013736445393"], Cell[TextData[Cell[
    BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "aabca04a-f70e-465e-9ebc-84daae467382"]], "TableText",ExpressionUUID->
     "2163d554-967c-4941-aa88-c3dd6d53bef0"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "4ef4f792-1d56-4b03-9a44-5c971e182535"]], "TableText",ExpressionUUID->
