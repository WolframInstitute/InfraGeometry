Cell["The boundary and the interior split the set:", "ExampleText",ExpressionUUID->"0aec505d-7a0f-439a-9ec7-f9e5d439f09c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "3"}], "]"}], ",",
         " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"bd", " ", "=", " ", 
      RowBox[{"InfraBoundary", "[", 
       RowBox[{"g", ",", " ", "ball"}], "]"}]}], ",", " ", 
     RowBox[{"int", " ", "=", " ", 
      RowBox[{"InfraInterior", "[", 
       RowBox[{"g", ",", " ", "ball"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Intersection", "[", 
      RowBox[{"bd", ",", " ", "int"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Union", "[", 
       RowBox[{"bd", ",", " ", "int"}], "]"}], " ", "===", " ", "ball"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"df3b3aab-0810-4fda-a9aa-9dffe28998f2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"67c7b4e8-6275-491a-8120-426c3c6041f8"]
}, Open  ]],

Cell[TextData[{
 "On the grid the boundary of the ball of radius ",
 StyleBox["r", "TI"],
 " has ",
 StyleBox["4r", "TI"],
 " vertices while the ball stays off the rim:"
}], "ExampleText",ExpressionUUID->"6cb76b7c-7faa-4505-9f26-7a0949d739ee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraBoundary", "[", 
       RowBox[{"g", ",", " ", 
