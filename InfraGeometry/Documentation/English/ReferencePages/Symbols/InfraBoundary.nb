Cell[CellGroupData[{
Cell["InfraBoundary", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4f493b02-2537-4892-808e-2278431ea5e6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBoundary"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBoundary", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a33c55d-2e18-4be8-ac15-24811779be60"],
 "\[LineSeparator]",
 "gives the boundary of the vertex set ",
 StyleBox["s", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ": the vertices of ",
 StyleBox["s", "TI"],
 " with a neighbour outside ",
 StyleBox["s", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"cfdb18f1-363c-483a-95ba-f0896e4377b5"],

Cell[TextData[{
 "The boundary is the inner vertex boundary ",
 StyleBox["\[PartialD]S = {v \[Element] S : some neighbour of v is not in S}",
   "TI"],
 ". The rest of ",
 StyleBox["S", "TI"],
 " is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraInterior"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraInterior", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f3bc8eaa-edef-4818-a487-c929270e4558"],
 ", and ",
 StyleBox["S", "TI"],
 " is the disjoint union of the two."
}], "Notes",ExpressionUUID->"ff3493c7-c9ed-41e9-98df-92c87d5c2ddd"],

Cell[TextData[{
 "The set ",
 StyleBox["s", "TI"],
 " can be a vertex list, a density, a region such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9470487c-84a7-4504-9dcf-c5724e01c4d9"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7ae67c3a-1b0b-46ab-b112-3b71316762b6"],
 ", or a graph. Only its vertices count."
}], "Notes",ExpressionUUID->"f3d8f76e-02ec-4dea-82a0-f6354c592b8d"],

Cell[TextData[{
 "On the square grid, away from the rim, the boundary of the ball ",
 StyleBox["B\:1d63(c)", "TI"],
 " is the circle ",
 StyleBox["S\:1d63(c)", "TI"],
 ", with ",
 StyleBox["4r", "TI"],
 " vertices. In general the boundary of a ball lies in its circle, and a \
vertex of the circle with no neighbour farther out is not on it. A curve is \
all boundary."
}], "Notes",ExpressionUUID->"8f69ec4c-ba57-4a56-9ce3-141fdcb9fb7b"],

Cell[TextData[{
 "The rim of ",
 StyleBox["g", "TI"],
 " is not a boundary: the whole graph has an empty boundary. The rim itself \
is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphExteriorBoundary"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/GraphExteriorBoundary", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5dc164ee-e5bb-4862-b170-9b8a8e3b1986"],
 "."
}], "Notes",ExpressionUUID->"655094d3-f272-4594-9c78-a1f636848a7b"],

