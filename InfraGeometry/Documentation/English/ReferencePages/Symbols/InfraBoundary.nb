Cell["\<\
Away from the rim a ball has no boundary in the ball topology. The ball of \
radius 5 on the grid, combinatorially and in the topology of radius 2:\
\>", "ExampleText",ExpressionUUID->"e6c91bf9-da2f-4f6a-939b-f223df95eed6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"InfraBall", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "5"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"InfraBoundary", "[", 
       RowBox[{"g", ",", " ", "ball"}], "]"}]}], ",", " ", 
     RowBox[{"InfraBoundary", "[", 
      RowBox[{"g", ",", " ", "ball", ",", " ", 
       RowBox[{"Method", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Alexandrov\>\"", ",", " ", 
          RowBox[{"\"\<Radius\>\"", " ", "->", " ", "2"}]}], "}"}]}]}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9a0331bc-7937-4880-a3a8-51b1396f05af"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"20", ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d9d613e3-f0c8-4c4e-8a04-91efdb2a9858"]
}, Open  ]]
}, Open  ]]
