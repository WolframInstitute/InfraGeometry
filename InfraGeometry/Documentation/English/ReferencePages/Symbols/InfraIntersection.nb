Cell["The common vertices of two vertex lists.", "ExampleText",ExpressionUUID->"09bb5340-9a86-47e8-8af3-26f82ac07d2c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraIntersection", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "8"}], "}"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "8", ",", " ", "13"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"185db318-1309-4f28-8c06-424ba8a7d401"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"28f99d24-d588-4e68-8fb8-d6ded5f9dea3"]
}, Open  ]],

Cell["\<\
Two crossing segments on a grid: the density of their intersection is the \
product of theirs.\
\>", "ExampleText",ExpressionUUID->"0b0cc847-635c-4cc0-902b-e10393725c9c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraMeasurement", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
   RowBox[{"InfraIntersection", "[", 
    RowBox[{
     RowBox[{"InfraSegment", "[", 
      RowBox[{"1", ",", " ", "13"}], "]"}], ",", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"7", ",", " ", "19"}], "]"}]}], "]"}], ",", 
   " ", "\"\<VertexDensity\>\""}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"86ad8ade-a222-4e70-9b86-df655a777cb9"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"7", "\[Rule]", "24"}], ",", 
   RowBox[{"8", "\[Rule]", "9"}], ",", 
   RowBox[{"12", "\[Rule]", "9"}], ",", 
   RowBox[{"13", "\[Rule]", "24"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"5e892eca-da25-46c5-a9ad-be18f5253745"]
}, Open  ]]
}, Open  ]],

