Notebook[{

Cell[CellGroupData[{
Cell["InfraIntersection", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cb7010ce-3c75-4ed6-a316-b65f29d8adf2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraIntersection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj1", "TI"], ",", " ", 
    StyleBox["obj2", "TI"], ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "690421e6-6cba-4753-8f18-c7e6f76c3be5"],
 "\[LineSeparator]",
 "returns the vertex-set intersection of the given shapes on graph \
\[LongDash] vertex lists, densities, walk graphs \[LongDash] as a sorted \
List.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7725a3ad-ab23-4e51-8182-fc538df06630"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraIntersection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["obj1", "TI"], ",", " ", 
    StyleBox["obj2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ad4f2ae-3b4b-4c7f-be67-d161d0aa2c80"],
 "\[LineSeparator]",
 "of two Euclidean heads is itself an inert head; InfraMeasurement evaluates \
it on a graph."
}], "Usage",ExpressionUUID->"403f7cc0-a51a-46c5-b2d1-ff4ac85b0689"],

Cell["\<\
On heads, InfraMeasurement gives the intersection its \"VertexDensity\" \
\[LongDash] the product of the two densities on their common vertices \
\[LongDash] its \"Subgraph\" and the four volumes. It is not a family of \
walks, so it has no \"Graph\", \"Cardinality\", \"Length\", \"EdgeDensity\" \
or \"Faithful\".\
\>", "Notes",ExpressionUUID->"9f8b5e5a-b684-47fe-a694-420c38d23f9c"],

Cell[TextData[{
 "Inside InfraScene hypotheses ",
 Cell[BoxData[
  RowBox[{"InfraIntersection", "[", 
   RowBox[{"c1", ",", " ", "c2"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a90242cd-2cd8-4a28-bff5-ba3b6c0eb3a3"],
 " is the token for where two named objects meet: every common vertex is one \
branch. It stays inert until the bindings resolve, the engine supplying the \
graph."
}], "Notes",ExpressionUUID->"a16e0a26-c464-42ec-bb7d-350971a0dac7"]
}, Open  ]],

