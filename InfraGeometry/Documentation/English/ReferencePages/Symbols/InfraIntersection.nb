Cell["The common vertices of two vertex lists.", "ExampleText",ExpressionUUID->"e1480a07-f8a7-4dc2-af97-3d7dc3631f00"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraIntersection", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "8"}], "}"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "8", ",", " ", "13"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b187d016-7836-4c0f-bd7a-3a606be91f5c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"06f4b0d8-a712-4ac6-bcf6-f9a1c86d5a68"]
}, Open  ]],

Cell["\<\
Two crossing segments on a grid: the density of their intersection is the \
product of theirs.\
\>", "ExampleText",ExpressionUUID->"c6f96ad5-b185-4526-9556-8b7f705ee14b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraMeasurement", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
   RowBox[{"InfraIntersection", "[", 
    RowBox[{
     RowBox[{"InfraSegment", "[", 
      RowBox[{"1", ",", " ", "13"}], "]"}], ",", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"7", ",", " ", "19"}], "]"}]}], "]"}], ",", 
   " ", "\"\<VertexDensity\>\""}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ecf9d624-6e7c-4c71-94a2-10dd8cc05219"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"7", "\[Rule]", "24"}], ",", 
   RowBox[{"8", "\[Rule]", "9"}], ",", 
   RowBox[{"12", "\[Rule]", "9"}], ",", 
   RowBox[{"13", "\[Rule]", "24"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"aa852801-141f-4652-a1d5-b620e1595e84"]
}, Open  ]]
}, Open  ]],

