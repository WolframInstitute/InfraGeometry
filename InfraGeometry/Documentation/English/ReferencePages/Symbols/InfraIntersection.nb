Cell["A density and a vertex list:", "ExampleText",ExpressionUUID->"f94cab09-32c4-4f5a-9e26-7f042f91beda"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"InfraIntersection", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"45", ",", " ", "46", ",", " ", "47"}], "}"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"46", " ", "->", " ", "2"}], ",", " ", 
       RowBox[{"47", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"48", " ", "->", " ", "3"}]}], "|>"}]}], "]"}]}], 
  "]"}]], "Input",
