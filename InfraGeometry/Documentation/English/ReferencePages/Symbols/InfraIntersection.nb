Notebook[{

Cell[CellGroupData[{
Cell["InfraIntersection", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"775e99b6-bdb2-4743-a169-0ed4034146fd"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraIntersection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["obj1", "TI"], ",", " ", 
    StyleBox["obj2", "TI"], ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c09c916-a92e-418e-bc64-c35911c271b3"],
 "\[LineSeparator]",
 "returns the vertex-set intersection of the given shapes on graph \
\[LongDash] vertex lists, densities, walk graphs \[LongDash] as a sorted \
List.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"79b0048c-c05e-4530-a7a0-f20c9d834770"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraIntersection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["obj1", "TI"], ",", " ", 
    StyleBox["obj2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0d4e9f1-b65a-4a54-95a9-2258d9b8831e"],
 "\[LineSeparator]",
 "of two Euclidean heads is itself an inert head; InfraMeasurement evaluates \
it on a graph."
}], "Usage",ExpressionUUID->"cff99c6b-7a18-4210-9271-15ce31c37fcf"],

Cell["\<\
On heads, InfraMeasurement gives the intersection its \"VertexDensity\" \
\[LongDash] the product of the two densities on their common vertices \
\[LongDash] its \"Subgraph\" and the four volumes. It is not a family of \
walks, so it has no \"Graph\", \"Cardinality\", \"Length\", \"EdgeDensity\" \
or \"Faithful\".\
\>", "Notes",ExpressionUUID->"9093176f-2e90-419a-9786-bd56459b62cf"],

Cell[TextData[{
 "Inside InfraScene hypotheses ",
 Cell[BoxData[
  RowBox[{"InfraIntersection", "[", 
   RowBox[{"c1", ",", " ", "c2"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ca1e64c-d4a3-455f-89e7-0098dfcfca65"],
 " is the token for where two named objects meet; it stays inert until the \
bindings resolve, the engine supplying the graph."
}], "Notes",ExpressionUUID->"c45b2452-b82b-4fca-af0c-d7b51faa60d4"]
}, Open  ]],

