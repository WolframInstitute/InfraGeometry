Cell["\<\
The density is a product. A segment met with its reverse has the squares of \
its counts:\
\>", "ExampleText",ExpressionUUID->"db272de3-fdf8-4a1e-a632-d4347252134f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraIntersection", "[", 
       RowBox[{
        RowBox[{"InfraSegment", "[", 
         RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
        RowBox[{"InfraSegment", "[", 
         RowBox[{"b", ",", " ", "a"}], "]"}]}], "]"}], ",", 
      " ", "\"\<VertexDensity\>\""}], "]"}], " ", "===", "\n", "    ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraSegment", "[", 
         RowBox[{"a", ",", " ", "b"}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}], "^", "2"}], ")"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e626c485-8341-4491-aab7-25b0364b3b22"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b5eb8c71-1804-4a2e-b3ec-2507e4c05eda"]
}, Open  ]],

Cell["\<\
The support of the symbolic intersection is the intersection of the supports:\
\
\>", "ExampleText",ExpressionUUID->"bf09f82f-697c-4ee4-9690-11098f0a702b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{"Keys", " ", "@", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraIntersection", "[", 
        RowBox[{
         RowBox[{"InfraShell", "[", 
          RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"b", ",", " ", "4"}], "]"}]}], "]"}], ",", 
       " ", "\"\<VertexDensity\>\""}], "]"}]}], " ", "===", "\n", "    ", 
    RowBox[{"InfraIntersection", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraShell", "[", 
         RowBox[{"a", ",", " ", "4"}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}], ",", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraShell", "[", 
         RowBox[{"b", ",", " ", "4"}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b2f40f81-e0f7-456d-8ccb-03500b0e4f51"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"dac27fb8-6814-4f86-8d49-26d80afe778e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Possible Issues", "ExampleSection",ExpressionUUID->
   "dda06a82-eb41-4b48-8510-6cb821647761"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell["\<\
With a graph the arguments are vertex sets. Geometric objects are not read, \
and the call stays unevaluated:\
\>", "ExampleText",ExpressionUUID->"6127d0d7-b07b-4da1-95e7-8061bb76558d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Head", " ", "@", " ", 
    RowBox[{"InfraIntersection", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraBall", "[", 
       RowBox[{"a", ",", " ", "2"}], "]"}], ",", " ", 
      RowBox[{"InfraBall", "[", 
       RowBox[{"a", ",", " ", "1"}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7edbd559-3e02-4e9b-807c-376f43bcccc4"],

Cell[BoxData["InfraIntersection"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"63302353-8e9c-4a76-86af-e84722ad44f7"]
}, Open  ]],

Cell[TextData[{
 "A vertex that is not in ",
 StyleBox["g", "TI"],
 " also leaves the call unevaluated. The corner 1 is not a vertex of the grid:"
}], "ExampleText",ExpressionUUID->"359cd963-de17-406a-b942-bdb8575bf393"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"VertexQ", "[", 
      RowBox[{"g", ",", " ", "1"}], "]"}], ",", " ", 
     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"InfraIntersection", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], "]"}]}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0291eb0c-8b20-41d8-9d9d-76a652357f17"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "InfraIntersection"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"a857c189-e213-4c8f-afa7-d358889f95cc"]
}, Open  ]]
}, Open  ]],

