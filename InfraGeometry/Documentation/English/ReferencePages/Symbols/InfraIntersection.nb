Cell[CellGroupData[{
Cell["InfraIntersection", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"77354123-3131-4752-92ef-96085e7bf0b2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraIntersection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["s1", "TI"], ",", " ", 
    StyleBox["s2", "TI"], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b043d45c-5a8e-4b49-875a-20408b04a66b"],
 "\[LineSeparator]",
 "gives the sorted list of the vertices of ",
 StyleBox["g", "TI"],
 " common to all the vertex sets ",
 StyleBox["s\:1d62", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7e066d7a-3271-4ec6-b11b-59e64a6c813a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraIntersection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["obj1", "TI"], ",", " ", 
    StyleBox["obj2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3296e405-4b4c-4749-b1c3-40aecbe09436"],
 "\[LineSeparator]",
 "is the intersection of two geometric objects, such as balls, shells and \
segments."
}], "Usage",ExpressionUUID->"0cce41cd-659b-479e-a365-9c89c7f44b2d"],

Cell[TextData[{
 "The intersection is ",
 StyleBox["S\:2081 \:2229 S\:2082 \:2229 \[Ellipsis]", "TI"],
 ". With a graph, each ",
 StyleBox["s\:1d62", "TI"],
 " is a vertex list, a density ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"v", " ", "->", " ", "m"}], ",", " ", "\[Ellipsis]"}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e114e5c5-b623-4a65-b866-c89f6d5c06e0"],
 " or a walk graph."
}], "Notes",ExpressionUUID->"2eb73948-5745-4f96-98d6-85fc7f2dd4fe"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2b9debb4-a1fd-4606-a0ea-d296e8b30f3d"],
 " of two objects is a symbolic object: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7e8c6d67-fee5-4f09-b431-76ae3fa43dc9"],
 " evaluates it on a graph. Its vertex density is the product of the two \
densities on the common vertices, so on a vertex it counts the pairs of \
members, one of each object, that pass through it."
}], "Notes",ExpressionUUID->"8ee6fc48-7a35-49e5-a41d-96a05fd8c8be"],

