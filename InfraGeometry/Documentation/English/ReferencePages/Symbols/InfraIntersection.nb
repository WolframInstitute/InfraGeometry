Cell[TextData[{
 "The circles of radius 4 about the centre ",
 StyleBox["a", "TI"],
 " and about a point ",
 StyleBox["b", "TI"],
 " at distance 4 meet in the apexes of the equilateral triangles on ",
 StyleBox["ab", "TI"],
 ", on the square grid and on the square mesh:"
}], "ExampleText",ExpressionUUID->"ef82bfe2-bf91-4b7e-a081-873cded6631f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraShell", "[", 
           RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"b", ",", " ", "4"}], "]"}], ",", " ", 
          RowBox[{"InfraIntersection", "[", 
           RowBox[{
            RowBox[{"InfraShell", "[", 
             RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
            RowBox[{"InfraShell", "[", 
             RowBox[{"b", ",", " ", "4"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "b"}], "}"}]}], "}"}]}], "]"}]}], "]"}], ",",
     "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"d9a0dfff-f4e4-43c7-ac92-6892d7f03b35"],

