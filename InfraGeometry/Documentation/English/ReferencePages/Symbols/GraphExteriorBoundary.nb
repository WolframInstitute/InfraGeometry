   {Cell["      ", "ModInfo",ExpressionUUID->
     "deec25f7-fab5-4f15-aaf6-46bc5071c2e0"], Cell["\<\
every vertex on a triangle, no such cycle (a mesh of tetrahedra)\
\>", "TableText",ExpressionUUID->"5257a5ce-7b9e-485c-9048-7c63922fb484"], 
    Cell[TextData[StyleBox[
    "{v : some edge of lk(v) lies on exactly one triangle of lk(v)}", "TI"]], 
