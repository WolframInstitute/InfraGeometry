Cell["\<\
The rim of the 10 \[Times] 10 grid and of the graph of a triangulated square, \
from which the two substrates are made. On the mesh the rim of the graph is \
the boundary of the region:\
\>", "ExampleText",ExpressionUUID->"aef81090-0775-41b9-9915-af716da23aaa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mesh", " ", "=", " ", 
     RowBox[{"DiscretizeRegion", "[", 
      RowBox[{
       RowBox[{"Rectangle", "[", "]"}], ",", " ", 
       RowBox[{"MaxCellMeasure", " ", "->", " ", "0.0085"}]}], "]"}]}], "}"}],
    ",", " ", 
   RowBox[{"{", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"IndexGraph", " ", "@", " ", 
      RowBox[{"MeshConnectivityGraph", "[", 
       RowBox[{"mesh", ",", " ", "0"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{
        RowBox[{"GridGraph", "[", 
         RowBox[{"{", 
          RowBox[{"10", ",", " ", "10"}], "}"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"GraphExteriorBoundary", " ", "@", " ", 
          RowBox[{"GridGraph", "[", 
           RowBox[{"{", 
            RowBox[{"10", ",", " ", "10"}], "}"}], "]"}]}], "}"}]}], "]"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"graph", ",", " ", 
        RowBox[{"{", 
         RowBox[{"GraphExteriorBoundary", "[", "graph", "]"}], "}"}], ",", 
        "\n", "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sort", " ", "@", " ", 
            RowBox[{"GraphExteriorBoundary", "[", "graph", "]"}]}], " ", "===",
            " ", 
           RowBox[{"Sort", " ", "@", " ", 
            RowBox[{"GraphExteriorBoundary", "[", "mesh", "]"}]}]}], 
          ")"}]}]}], "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c33d19a7-f7c6-4c51-a28d-eda449bcd84c"],

