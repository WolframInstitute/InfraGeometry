Cell["\<\
The rim of the square grid and of the square mesh. These substrates are \
windows with the contour removed, so the rim is what is left of it: on the \
grid the whiskers, on the mesh the old rim vertices and the vertices whose \
links lost an edge with the contour:\
\>", "ExampleText",ExpressionUUID->"3d16e1e4-4fc0-43f6-afb5-b199cac0643e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"rim", " ", "=", " ", 
        RowBox[{"GraphExteriorBoundary", "[", "g", "]"}]}], "}"}], ",", "\n", 
      "    ", 
