Cell["The rule depends on the graph:", "Notes",ExpressionUUID->"527300af-61c0-4706-8920-cdf1ca087841"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6e96ad4d-cb1f-4210-bf94-3cd8f7a34e5b"], Cell["Graph", "TableText",
