Cell["\<\
The boundary of a triangulated disk: the vertices on its circle.\
\>", "ExampleText",ExpressionUUID->"9865a628-838d-4c4d-90cc-d7cbf2895817"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mesh", " ", "=", " ", 
     RowBox[{"DiscretizeRegion", "[", 
      RowBox[{
       RowBox[{"Disk", "[", "]"}], ",", " ", 
       RowBox[{"MaxCellMeasure", " ", "->", " ", "0.01"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rim", " ", "=", " ", 
     RowBox[{"GraphExteriorBoundary", "[", "mesh", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{
       RowBox[{"IndexGraph", " ", "@", " ", 
        RowBox[{"MeshConnectivityGraph", "[", 
         RowBox[{"mesh", ",", " ", "0"}], "]"}]}], ",", " ", 
       RowBox[{"{", "rim", "}"}]}], "]"}], ",", " ", 
     RowBox[{"Length", "[", "rim", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ac29574f-f5c2-4c10-a3b3-7cd70b9bda63"],

