Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BoundarylessGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BoundarylessGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4439d3cb-32a9-42dc-bb64-1ae7253d1f04"],
 " deletes the edges between rim vertices, so the contour disappears and the \
vertices with an edge inward stay as whiskers."
}], "ExampleText",ExpressionUUID->"e58e57cc-939e-403c-aba8-d525eaf8c98a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"8", ",", " ", "8"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rim", " ", "=", " ", 
     RowBox[{"GraphExteriorBoundary", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Method", " ", "->", " ", "\"\<MaxDegree\>\""}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", "rim", "}"}]}], "]"}], ",", " ", 
        RowBox[{"BoundarylessGraph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<MaxDegree\>\""}]}], "]"}]}], 
       "}"}], "]"}], ",", " ", 
     RowBox[{"Length", "[", "rim", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7c2480ac-2280-40df-b9d4-f5c6825d7ee1"],

