Cell["\<\
A solid: the boundary of a tetrahedral mesh of the ball is the sphere.\
\>", "ExampleText",ExpressionUUID->"604eb35c-090e-4e85-a0c0-2a9de5b1e7e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mesh", " ", "=", " ", 
     RowBox[{"DiscretizeRegion", "[", 
      RowBox[{
       RowBox[{"Ball", "[", "]"}], ",", " ", 
       RowBox[{"MaxCellMeasure", " ", "->", " ", "0.05"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rim", " ", "=", " ", 
     RowBox[{"GraphExteriorBoundary", "[", "mesh", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Graph3D", "[", 
      RowBox[{"Subgraph", "[", 
       RowBox[{
        RowBox[{"IndexGraph", " ", "@", " ", 
         RowBox[{"MeshConnectivityGraph", "[", 
          RowBox[{"mesh", ",", " ", "0"}], "]"}]}], ",", " ", "rim"}], "]"}], 
      "]"}], ",", " ", 
     RowBox[{"MinMax", "[", 
      RowBox[{"Norm", " ", "/@", " ", 
       RowBox[{
        RowBox[{"MeshCoordinates", "[", "mesh", "]"}], "[", 
        RowBox[{"[", "rim", "]"}], "]"}]}], "]"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"2acd5a28-1c27-4a7d-83ec-7478242a8cb0"],

