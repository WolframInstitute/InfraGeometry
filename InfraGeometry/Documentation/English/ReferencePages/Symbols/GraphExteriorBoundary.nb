  }]], "2ColumnTableMod",ExpressionUUID->"1c6c6fc0-ce74-4334-8c89-\
24bacd0fd4cb"],

Cell[TextData[{
 "The link ",
 StyleBox["lk(v)", "TI"],
 " is the subgraph induced on the neighbours of ",
 StyleBox["v", "TI"],
 ". On a triangulated surface the link of an inner vertex is a cycle; in a \
mesh of tetrahedra it is a triangulated sphere, every edge on two triangles."
}], "Notes",ExpressionUUID->"5827ae2d-56b6-424f-8457-d9fcf98cddf1"],

Cell[TextData[{
 "For a mesh region of dimension ",
 StyleBox["d", "TI"],
 ", the rim is the set of vertices of the (",
 StyleBox["d", "TI"],
 " \[Minus] 1)-cells that lie on exactly one ",
 StyleBox["d", "TI"],
 "-cell, given as positions in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MeshCoordinates"]], "paclet:ref/MeshCoordinates"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c7e34921-45ab-41bc-a363-e34307204b14"],
 ". A region of dimension 1 or less has none."
}], "Notes",ExpressionUUID->"be155a7d-de32-4eb1-b3a0-207f4dc023ef"],

Cell[TextData[{
 "The rim belongs to the whole graph. The boundary of a set of vertices \
inside the graph is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBoundary"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBoundary", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "94040b03-0a4d-4aa4-8abf-11bed17010fc"],
 "."
}], "Notes",ExpressionUUID->"0514067a-d06a-4280-bdc4-77d7991bccf7"]
}, Open  ]],

