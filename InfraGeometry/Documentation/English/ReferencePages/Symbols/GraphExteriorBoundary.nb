Cell["\<\
On the graph of a mesh the degree test also marks vertices inside. The disk \
has 43 vertices on its circle; the mean degree marks 111.\
\>", "ExampleText",ExpressionUUID->"eb260390-59df-4501-8876-0d1c487ec380"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mesh", " ", "=", " ", 
     RowBox[{"DiscretizeRegion", "[", 
      RowBox[{
       RowBox[{"Disk", "[", "]"}], ",", " ", 
       RowBox[{"MaxCellMeasure", " ", "->", " ", "0.01"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"IndexGraph", " ", "@", " ", 
      RowBox[{"MeshConnectivityGraph", "[", 
       RowBox[{"mesh", ",", " ", "0"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rims", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"GraphExteriorBoundary", "[", "mesh", "]"}], ",", " ", 
       RowBox[{"GraphExteriorBoundary", "[", "graph", "]"}]}], "}"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"graph", ",", " ", 
          RowBox[{"{", "#", "}"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
       "rims"}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "/@", " ", "rims"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3771caeb-08d7-4601-96eb-7c9630b057ca"],

