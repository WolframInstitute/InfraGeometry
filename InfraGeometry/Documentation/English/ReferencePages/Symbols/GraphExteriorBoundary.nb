  "Scope", "ExampleSection",ExpressionUUID->
   "32e79d70-f7af-47ff-bb41-513374ef55db"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1293636265,ExpressionUUID->"6d08f999-4c69-4709-9b28-82906be6ee75"],

Cell["\<\
A solid. The rim of a tetrahedral mesh of the ball lies on the unit sphere, \
up to the faceting:\
\>", "ExampleText",ExpressionUUID->"2e1f6005-d715-4887-9a3f-d8f687a26e07"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mesh", " ", "=", " ", 
     RowBox[{"DiscretizeRegion", "[", 
      RowBox[{
       RowBox[{"ImplicitRegion", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"x", "^", "2"}], " ", "+", " ", 
           RowBox[{"y", "^", "2"}], " ", "+", " ", 
           RowBox[{"z", "^", "2"}]}], " ", "<=", " ", "1"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}], "]"}], ",", 
       " ", 
       RowBox[{"MaxCellMeasure", " ", "->", " ", "0.005"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rim", " ", "=", " ", 
     RowBox[{"GraphExteriorBoundary", "[", "mesh", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "rim", "]"}], ",", " ", 
     RowBox[{"MeshCellCount", "[", 
      RowBox[{"mesh", ",", " ", "0"}], "]"}], ",", " ", 
     RowBox[{"MinMax", "[", 
      RowBox[{"Norm", " ", "/@", " ", 
       RowBox[{
        RowBox[{"MeshCoordinates", "[", "mesh", "]"}], "[", 
        RowBox[{"[", "rim", "]"}], "]"}]}], "]"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"eec08620-df80-40ca-b4b1-6db210ae515d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"614", ",", "762", ",", 
   RowBox[{"{", 
    RowBox[{"0.9920335046608754`", ",", "1.00000000000011`"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"07091685-c292-4cff-b4e5-c072bf0f0dc2"]
}, Open  ]]
}, Open  ]],

