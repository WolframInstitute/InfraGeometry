Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BoundarylessGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BoundarylessGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "000c5eea-4742-4cd7-8b17-f654e9fe729c"],
 " deletes the edges between two rim vertices:"
}], "ExampleText",ExpressionUUID->"3e711046-39aa-4f49-8dd0-6a5bca1a617b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"10", ",", " ", "10"}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"rim", " ", "=", " ", 
     RowBox[{"GraphExteriorBoundary", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"EdgeCount", "[", "g", "]"}], " ", "-", " ", 
     RowBox[{"EdgeCount", "[", 
      RowBox[{"BoundarylessGraph", "[", "g", "]"}], "]"}]}], " ", "==", " ", 
    RowBox[{"EdgeCount", "[", 
     RowBox[{"Subgraph", "[", 
      RowBox[{"g", ",", " ", "rim"}], "]"}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4eb32efb-ab45-4f94-9122-9e420e76da0c"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1943b7f0-9c36-4ef8-baac-04d1e0f50a9b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Possible Issues", "ExampleSection",ExpressionUUID->
   "dda06a82-eb41-4b48-8510-6cb821647761"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell["\<\
The graph alone cannot always see the boundary. Three tetrahedra around an \
edge have the complete graph on five vertices as their graph. Every link is \
then the complete graph on four vertices, as at a vertex inside four \
tetrahedra, so the graph has no rim while the mesh region is all rim:\
\>", "ExampleText",ExpressionUUID->"ba43e8c0-e7df-4896-9024-4b9f94279fe1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mesh", " ", "=", " ", 
     RowBox[{"MeshRegion", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "1"}], "/", "2"}], ",", " ", 
           RowBox[{
            RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}], ",", " ", "0"}], 
          "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "1"}], "/", "2"}], ",", " ", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sqrt", "[", "3", "]"}]}], "/", "2"}], ",", " ", "0"}], 
          "}"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"Tetrahedron", " ", "/@", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], 
          ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "4", ",", " ", "5"}], "}"}], 
          ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "5", ",", " ", "3"}], 
           "}"}]}], "}"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"graph", " ", "=", " ", 
     RowBox[{"IndexGraph", " ", "@", " ", 
      RowBox[{"MeshConnectivityGraph", "[", 
       RowBox[{"mesh", ",", " ", "0"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphExteriorBoundary", "[", "mesh", "]"}], ",", " ", 
     RowBox[{"GraphExteriorBoundary", "[", "graph", "]"}], ",", " ", 
     RowBox[{"IsomorphicGraphQ", "[", 
      RowBox[{"graph", ",", " ", 
       RowBox[{"CompleteGraph", "[", "5", "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cf1d9b89-80dc-45e8-9e35-e139830b3b30"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}], ",", 
   RowBox[{"{", "}"}], ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a4b26f80-274d-489d-ac0a-22ecebdcab43"]
}, Open  ]]
}, Open  ]],

