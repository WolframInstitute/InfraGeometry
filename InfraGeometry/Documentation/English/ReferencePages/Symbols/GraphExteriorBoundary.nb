Cell[CellGroupData[{
Cell["GraphExteriorBoundary", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6efeed31-c84c-4456-9d0d-1a42ade765c2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GraphExteriorBoundary"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GraphExteriorBoundary", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cb13ad7-0e3b-4b87-9568-f9f1d67553c9"],
 "\[LineSeparator]",
 "gives the rim of the graph ",
 StyleBox["g", "TI"],
 ": the vertices whose degree is below the mean degree.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"271cefdc-fbde-4f62-9979-be3bef4cb352"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GraphExteriorBoundary"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GraphExteriorBoundary", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["mr", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2dcdd12-2487-46b7-83de-5d82d3040858"],
 "\[LineSeparator]",
 "gives the vertices on the boundary of the mesh region ",
 StyleBox["mr", "TI"],
 "."
}], "Usage",ExpressionUUID->"f4cb8d69-f12b-4098-907d-bdebb198882c"],

Cell[TextData[{
 "Definition: for a graph, the rim is the set of vertices whose degree is \
below a threshold, the mean degree with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Method"]], "paclet:ref/Method"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e965ff1c-5a5e-4013-8714-7b58223fd3d1"],
 " -> ",
 Cell[BoxData["\"\<AverageDegree\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9317ec8-4a1b-4287-a2b7-bb50b27765ec"],
 " (the default) or the largest degree with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Method"]], "paclet:ref/Method"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f0069271-01fc-4a46-a511-f025cc5bee7f"],
 " -> ",
 Cell[BoxData["\"\<MaxDegree\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69233889-bd8f-4e48-81ef-2635113a55c8"],
 ". For a mesh region of dimension ",
 StyleBox["d", "TI"],
 ", the rim is the set of vertices of the (",
 StyleBox["d", "TI"],
 " \[Minus] 1)-cells that lie in exactly one ",
 StyleBox["d", "TI"],
 "-cell: its exact boundary, given as positions in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MeshCoordinates"]], "paclet:ref/MeshCoordinates"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e0dc63ea-412c-4f8a-9f38-986295070694"],
 ". A region of dimension 1 or less has none."
}], "Notes",ExpressionUUID->"b518a623-5a50-4f14-a6e1-77f86f294b6b"],

Cell[TextData[{
 "Inside a lattice or a tiling every vertex has the largest degree, so ",
 Cell[BoxData["\"\<MaxDegree\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "baae1f77-ddda-422c-975f-bdad81821ff6"],
 " finds the rim exactly. Inside a mesh the degrees vary, and ",
 Cell[BoxData["\"\<AverageDegree\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5a58868-d8c8-4545-9aed-ad4458da561e"],
 " is a guess that also marks some vertices inside."
}], "Notes",ExpressionUUID->"9f3dae97-cfa4-45b6-9c1b-b7daf63b411c"],

Cell[TextData[{
 "The rim is that of the whole graph. The boundary of a set of vertices \
inside the graph is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBoundary"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBoundary", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9ea2dda5-2640-49a3-96ca-bc84a98693ad"],
 "."
}], "Notes",ExpressionUUID->"53f3d142-5122-4fb6-9b04-2a3a083fa487"]
}, Open  ]],

