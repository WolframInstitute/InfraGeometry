Cell["\<\
The closure of a vertex of least degree on the rim, at radius 3, on the \
square grid and on the square mesh. The closure is drawn with the vertex on \
top:\
\>", "ExampleText",ExpressionUUID->"9703f5cb-4c6f-409b-95c2-9cabc9aba3ac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"v", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"MinimalBy", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{
            RowBox[{"VertexDegree", "[", 
             RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}]}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"TopologicalClosure", "[", 
           RowBox[{
            RowBox[{"BallTopology", "[", 
             RowBox[{"g", ",", " ", "3"}], "]"}], ",", " ", 
            RowBox[{"{", "v", "}"}]}], "]"}], ",", " ", "v"}], "}"}]}], 
       "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"8f073929-5ac6-4320-98d3-6f3bdf06366e"],

