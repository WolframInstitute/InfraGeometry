Cell["\<\
The ring outside a ball about the centre is not closed: its closure adds the \
vertices of the ball whose ball contains the ball of a ring vertex. The \
closure of the closure is the closure.\
\>", "ExampleText",ExpressionUUID->"f9bab810-6e05-44cc-a7b6-51fcdce51041"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"topo", " ", "=", " ", 
     RowBox[{"BallTopology", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ring", " ", "=", " ", 
     RowBox[{"Complement", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"FindInfraRepresentative", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "6"}], 
          "]"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"closure", " ", "=", " ", 
     RowBox[{"TopologicalClosure", "[", 
      RowBox[{"topo", ",", " ", "ring"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ring", " ", "->", " ", "StandardBlue"}], ",", " ", 
         RowBox[{
          RowBox[{"Complement", "[", 
           RowBox[{"closure", ",", " ", "ring"}], "]"}], " ", "->", " ", 
          "StandardRed"}]}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"SubsetQ", "[", 
      RowBox[{"closure", ",", " ", "ring"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"TopologicalClosure", "[", 
       RowBox[{"topo", ",", " ", "closure"}], "]"}], " ", "==", " ", 
      "closure"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"48180d0a-3f41-439b-8f68-d355db161d15"],

