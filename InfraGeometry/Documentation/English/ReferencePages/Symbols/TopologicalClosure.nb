Cell[CellGroupData[{
Cell["TopologicalClosure", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c54bfe22-4637-4305-9afe-d1975ee05c6b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TopologicalClosure"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TopologicalClosure", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["topo", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e239ec4e-3bc3-48c6-bdd3-506909218b64"],
 "\[LineSeparator]",
 "gives the closure of the vertex list ",
 StyleBox["s", "TI"],
 " in the topology of the digraph ",
 StyleBox["topo", "TI"],
 ": the vertices from which a directed path leads into ",
 StyleBox["s", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"4d114033-4252-404f-8667-23c0a81fc366"],

Cell[TextData[{
 "The digraph ",
 StyleBox["topo", "TI"],
 " is read as the preorder ",
 StyleBox["q \[LessEqual] p", "TI"],
 " when ",
 StyleBox["q = p", "TI"],
 " or a directed path leads from ",
 StyleBox["q", "TI"],
 " to ",
 StyleBox["p", "TI"],
 ". The closure of a vertex is its down-set ",
 StyleBox["cl(p) = {q : q \[LessEqual] p}", "TI"],
 ", and the closure of a set is the union of the closures of its vertices."
}], "Notes",ExpressionUUID->"bc7a4f2c-769b-4439-b5a0-8e8e546cc466"],

Cell[TextData[{
 "In ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallTopology"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallTopology", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5fe9e08-78e7-478c-8463-05336d5fb0b2"],
 " the closure of a vertex is ",
 StyleBox["cl(p) = {q : B\:1d63(p) \[SubsetEqual] B\:1d63(q)}", "TI"],
 ", the intersection of the balls of radius ",
 StyleBox["r", "TI"],
 " that contain ",
 StyleBox["p", "TI"],
 ". It is the ball hull ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBallHull"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBallHull", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     StyleBox["p", "TI"], "}"}], ",", " ", 
    RowBox[{"{", 
     StyleBox["r", "TI"], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d7c2d030-8021-4200-8f3b-8aa2d8705b5f"],
 "."
}], "Notes",ExpressionUUID->"1ceecd4c-211c-4a81-9577-8279db4e299b"],

Cell[TextData[{
 "The closure contains ",
 StyleBox["s", "TI"],
 ". The closure of the closure is the closure, and the closure of a union is \
the union of the closures. A set is closed when it is its own closure."
}], "Notes",ExpressionUUID->"3d576d9e-90d5-440e-941b-c15db60008cc"],

Cell["On a patch of the grid a vertex far from the rim is closed.", "Notes",ExpressionUUID->"54eb0469-8445-4ec3-910c-6cb31489bf8a"],

Cell["The result is a sorted vertex list.", "Notes",ExpressionUUID->"631e9b2a-3abe-4430-a770-6e61753c1902"]
}, Open  ]],

