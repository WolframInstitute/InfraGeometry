Notebook[{

Cell[CellGroupData[{
Cell["TopologicalClosure", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a4170049-0eab-4098-9d1c-ad982c420df2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TopologicalClosure"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TopologicalClosure", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["topo", "TI"], ",", " ", 
    StyleBox["s", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86c16f23-098a-40c3-b590-ab18a6ba323f"],
 "\[LineSeparator]",
 "gives the closure of the vertex list ",
 StyleBox["s", "TI"],
 " in the topology of the digraph ",
 StyleBox["topo", "TI"],
 ": the vertices from which a directed path leads into ",
 StyleBox["s", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"5f71bb96-3cf2-4e72-9857-47b02351c309"],

Cell[TextData[{
 "Definition: ",
 StyleBox["topo", "TI"],
 " is read as the preorder ",
 StyleBox["q \[LessEqual] p", "TI"],
 " when ",
 StyleBox["q = p", "TI"],
 " or a directed path leads from ",
 StyleBox["q", "TI"],
 " to ",
 StyleBox["p", "TI"],
 ". The closure of a vertex is its down-set, and the closure of a set is the \
union of the closures of its vertices."
}], "Notes",ExpressionUUID->"15196cc4-4246-4214-b689-6bcc0838d5ee"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BallTopology"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BallTopology", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85757821-1ac9-4ad8-be2e-29476bf19d86"],
 " the closure of a vertex ",
 StyleBox["p", "TI"],
 " is ",
 StyleBox["cl(p) = {q : B_r(p) \[SubsetEqual] B_r(q)}", "TI"],
 ", the vertices whose ball contains the ball at ",
 StyleBox["p", "TI"],
 ". It is the intersection of the balls of radius ",
 StyleBox["r", "TI"],
 " that contain ",
 StyleBox["p", "TI"],
 ", so it equals the ball hull ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBallHull"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBallHull", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     StyleBox["p", "TI"], "}"}], ",", " ", 
    RowBox[{"{", 
     StyleBox["r", "TI"], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd971e8b-ecaa-43ed-bca4-48600c137bf6"],
 "."
}], "Notes",ExpressionUUID->"535f181b-369b-4dc9-9b84-f3d25d6301fe"],

Cell[TextData[{
 "The closure contains ",
 StyleBox["s", "TI"],
 ", the closure of the closure is the closure, and the closure of a union is \
the union of the closures. A set is closed when it equals its closure."
}], "Notes",ExpressionUUID->"7d1d3f55-c4b3-4777-bf66-98e72bc347ef"],

Cell["The result is a sorted vertex list.", "Notes",ExpressionUUID->"454103ab-1c0c-4639-8224-4a33386b9da9"]
}, Open  ]],

