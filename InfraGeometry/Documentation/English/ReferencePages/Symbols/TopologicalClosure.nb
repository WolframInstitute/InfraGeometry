Cell["\<\
The closure of a set. The vertices of degree 1 on the grid are not closed at \
radius 2; their closure takes in the two rings next to them:\
\>", "ExampleText",ExpressionUUID->"4362479e-3df8-4eda-a69e-5c284194e3ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ends", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexDegree", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}], " ", "==", " ", "1"}], " ", 
        "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"TopologicalClosure", "[", 
        RowBox[{
         RowBox[{"BallTopology", "[", 
          RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", "ends"}], "]"}], ",",
        " ", "ends"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6ac43cdd-4255-4204-a4af-3e660593074d"],

