Cell["\<\
The closure of a vertex of least degree on the rim, at radius 3, on the \
discretized plane, the square tiling and the hexagonal tiling. The vertex is \
blue; the rest of its closure, the vertices whose ball contains its ball, is \
red.\
\>", "ExampleText",ExpressionUUID->"7867b7ca-b4c2-4c02-a4e3-dea9cc76ec24"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"corner", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"MinimalBy", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{
            RowBox[{"VertexDegree", "[", 
             RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}]}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"closure", " ", "=", " ", 
        RowBox[{"TopologicalClosure", "[", 
         RowBox[{
          RowBox[{"BallTopology", "[", 
           RowBox[{"g", ",", " ", "3"}], "]"}], ",", " ", 
          RowBox[{"{", "corner", "}"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Complement", "[", 
            RowBox[{"closure", ",", " ", 
             RowBox[{"{", "corner", "}"}]}], "]"}], " ", "->", " ", 
           "StandardRed"}], ",", " ", 
          RowBox[{"corner", " ", "->", " ", "StandardBlue"}]}], "}"}]}], 
       "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0e034893-c0cc-4f55-bc76-33b7dfc113dd"],

