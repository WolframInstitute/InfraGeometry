Cell["\<\
The closure of a vertex in the ball topology is its ball hull at the same \
radius.\
\>", "ExampleText",ExpressionUUID->"011c9060-fb9a-4113-8ade-27ed56f91208"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"corner", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"MinimalBy", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{
         RowBox[{"VertexDegree", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"closure", " ", "=", " ", 
     RowBox[{"TopologicalClosure", "[", 
      RowBox[{
       RowBox[{"BallTopology", "[", 
        RowBox[{"g", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"{", "corner", "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Complement", "[", 
           RowBox[{"closure", ",", " ", 
            RowBox[{"{", "corner", "}"}]}], "]"}], " ", "->", " ", 
          "StandardRed"}], ",", " ", 
         RowBox[{"corner", " ", "->", " ", "StandardBlue"}]}], "}"}]}], "]"}],
      ",", "\n", "   ", 
     RowBox[{"closure", " ", "==", " ", 
      RowBox[{"FindInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBallHull", "[", 
         RowBox[{
          RowBox[{"{", "corner", "}"}], ",", " ", 
          RowBox[{"{", "3", "}"}]}], "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d15c794f-ca04-40e2-870f-158b60721c53"],

