Cell["\<\
The closure of a corner of the square tiling grows with the radius, here from \
1 to 4.\
\>", "ExampleText",ExpressionUUID->"38033e2e-6d82-4219-9a62-127e35f340e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"corner", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"VertexDegree", "[", 
           RowBox[{"g", ",", " ", "#"}], "]"}], " ", "==", " ", "1"}], " ", 
         "&"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Complement", "[", 
            RowBox[{
             RowBox[{"TopologicalClosure", "[", 
              RowBox[{
               RowBox[{"BallTopology", "[", 
                RowBox[{"g", ",", " ", "r"}], "]"}], ",", " ", 
               RowBox[{"{", "corner", "}"}]}], "]"}], ",", " ", 
             RowBox[{"{", "corner", "}"}]}], "]"}], " ", "->", " ", 
           "StandardRed"}], ",", " ", 
          RowBox[{"corner", " ", "->", " ", "StandardBlue"}]}], "}"}]}], 
       "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "1", ",", " ", "4"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0170564d-62eb-48b7-ac4f-3c7c72bbb575"],

