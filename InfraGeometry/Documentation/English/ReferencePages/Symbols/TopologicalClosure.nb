Cell["\<\
The closure of a vertex in the ball topology is its ball hull at the same \
radius:\
\>", "ExampleText",ExpressionUUID->"0a82c2d0-c38a-4a20-834b-b39afb6f54da"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"MinimalBy", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{
         RowBox[{"VertexDegree", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"TopologicalClosure", "[", 
       RowBox[{
        RowBox[{"BallTopology", "[", 
         RowBox[{"g", ",", " ", "r"}], "]"}], ",", " ", 
        RowBox[{"{", "v", "}"}]}], "]"}], " ", "===", " ", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraBallHull", "[", 
          RowBox[{
           RowBox[{"{", "v", "}"}], ",", " ", 
           RowBox[{"{", "r", "}"}]}], "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], "]"}]}]}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "1", ",", " ", "5"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"28ccd7ae-4598-4e17-b217-c7524a62ea8c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True", ",", "True", ",", "True"}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"df2b4143-1f4a-4721-8fe7-9209e1619c0d"]
}, Open  ]],

Cell["\<\
The closure is a closure operator: it contains the set, and the closure of \
the closure is the closure:\
\>", "ExampleText",ExpressionUUID->"b34b03da-0520-456b-ba89-600d8c7ecb5e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"topo", " ", "=", " ", 
     RowBox[{"BallTopology", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"s", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraShell", "[", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "5"}], "]"}], ",",
         " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cl", " ", "=", " ", 
     RowBox[{"TopologicalClosure", "[", 
      RowBox[{"topo", ",", " ", "s"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"SubsetQ", "[", 
      RowBox[{"cl", ",", " ", "s"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"TopologicalClosure", "[", 
       RowBox[{"topo", ",", " ", "cl"}], "]"}], " ", "===", " ", "cl"}], ",", 
     " ", 
     RowBox[{"Length", "[", "s", "]"}], ",", " ", 
     RowBox[{"Length", "[", "cl", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f096318b-4c04-47b7-96b7-ee6e945eced8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "27", ",", "58"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"e821ef44-6ecd-4835-88ab-bfddd2594a14"]
}, Open  ]],

Cell["\<\
Away from the rim every vertex is closed. The centre of the grid is its own \
closure at every radius up to 4:\
\>", "ExampleText",ExpressionUUID->"977408a1-b1f6-47df-bf16-80cc4e123db8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"TopologicalClosure", "[", 
      RowBox[{
       RowBox[{"BallTopology", "[", 
        RowBox[{"g", ",", " ", "r"}], "]"}], ",", " ", 
       RowBox[{"{", "c", "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "1", ",", " ", "4"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"4484cdbb-6341-41ec-a969-fdadf2f36fc8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "45", "}"}], ",", 
