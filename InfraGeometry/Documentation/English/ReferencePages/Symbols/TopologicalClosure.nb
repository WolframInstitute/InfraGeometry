Cell["\<\
The closure of that vertex of the grid grows with the radius, here from 1 to \
4:\
\>", "ExampleText",ExpressionUUID->"d4fc7677-2737-4201-8343-98858c233abb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"MinimalBy", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{
         RowBox[{"VertexDegree", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}]}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"TopologicalClosure", "[", 
           RowBox[{
            RowBox[{"BallTopology", "[", 
             RowBox[{"g", ",", " ", "r"}], "]"}], ",", " ", 
            RowBox[{"{", "v", "}"}]}], "]"}], ",", " ", "v"}], "}"}], ",", 
        " ", 
        RowBox[{"PlotLabel", " ", "->", " ", "r"}]}], "]"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "1", ",", " ", "4"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a618e08c-a47f-4872-a01c-5646d4a20c03"],

