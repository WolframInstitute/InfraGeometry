Cell["\<\
The centre of the square grid lies on a segment from it, and a vertex at \
distance 4 does not lie in the ball of radius 3:\
\>", "ExampleText",ExpressionUUID->"ef3bd0c8-6950-4f60-a3ac-cb12c0fe1bf9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraGeometricTest", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraGeometricAssertion", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", " ", 
           RowBox[{"InfraSegment", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}]}], "}"}], ",", 
         " ", "\"\<Member\>\""}], "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"InfraGeometricTest", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraGeometricAssertion", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"b", ",", " ", 
           RowBox[{"InfraBall", "[", 
            RowBox[{"a", ",", " ", "3"}], "]"}]}], "}"}], ",", 
         " ", "\"\<Member\>\""}], "]"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"50d74369-92a9-4e9b-9a6c-a78bf692a4cc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"756effa8-7553-4bd3-91f7-5319d7375a0e"]
}, Open  ]],

