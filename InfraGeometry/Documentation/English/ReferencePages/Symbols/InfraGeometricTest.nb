Cell["Compare two finite distances.", "ExampleText",ExpressionUUID->"4eda5ce8-d608-4a5e-8aa0-842a43735504"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"InfraGeometricTest", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"InfraGeometricAssertion", "[", " ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{"1", ",", " ", "2"}], " ", "}"}], ",", " ", 
          RowBox[{"{", " ", 
           RowBox[{"3", ",", " ", "4"}], " ", "}"}]}], " ", "}"}], ",", 
        " ", "\"\<EqualDistance\>\""}], " ", "]"}]}], " ", "]"}]}], " ", 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"36ded443-e04d-4831-bc62-ee5f3341f1d9"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2f0a02e3-4805-4ec3-8c5e-cc117e84870e"]
}, Open  ]],

Cell["Test exact-family support membership.", "ExampleText",ExpressionUUID->"c7c28634-c6c6-4773-889e-7c2c0f80bed1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
