     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"InfraGeometricTest", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"InfraGeometricAssertion", "[", " ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{"2", ",", " ", 
          RowBox[{"InfraMidpoint", "[", " ", 
           RowBox[{"1", ",", " ", "3"}], " ", "]"}]}], " ", "}"}], ",", 
        " ", "\"\<Member\>\""}], " ", "]"}]}], " ", "]"}]}], " ", 
   "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e1cd027e-c0db-4c99-8db2-0d7897b7a668"],

