Cell["Compare two finite distances.", "ExampleText",ExpressionUUID->"b9d83b32-5b9b-48bd-a898-94ec1a5f1f87"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"InfraGeometricTest", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"InfraGeometricAssertion", "[", " ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{"1", ",", " ", "2"}], " ", "}"}], ",", " ", 
          RowBox[{"{", " ", 
           RowBox[{"3", ",", " ", "4"}], " ", "}"}]}], " ", "}"}], ",", 
        " ", "\"\<EqualDistance\>\""}], " ", "]"}]}], " ", "]"}]}], " ", 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b23b4771-2e02-4d3a-b6be-16de08d34ebc"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"69345dca-49e5-4958-8da7-4edb9bdaac45"]
}, Open  ]],

