Notebook[{

Cell[CellGroupData[{
Cell["InfraEquidistantSet", "ObjectName",ExpressionUUID->"8b72f6c5-990d-44ab-8232-33baad82e415"],

Cell["LLM generated.", "Notes",ExpressionUUID->"fe250125-4af6-4422-a41d-cfe41209ed0c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"21da5ba7-4d8d-479b-8bb7-3af4deda4c89"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraEquidistantSet"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraEquidistantSet", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["p1", "TI"], ",", " ", "...", ",", " ", 
     StyleBox["pn", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "795d7712-6509-4484-aa8b-7bb22dfd5461"],
 "\[LineSeparator]",
 "is the inert locus of vertices at equal finite graph distance from all the \
anchors.",
 "\n"
}], "Usage",ExpressionUUID->"02729198-d80a-4c8f-be77-953023685f47"],

Cell[TextData[{
 "On a graph with path distance ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85f35b93-34bc-4736-ac78-fd2633bdadcc"],
 ", the locus is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["v", "TI"]}], ":", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], "1"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", "\[Ellipsis]", "=", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["n", "TI"]], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "<", "\[Infinity]", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb59a1e8-bb36-47a2-a100-b5a83e58fe7d"],
 ". It is one unique vertex set. There is no random equidistant-set \
constructor. The head is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ca267a8b-8fbe-42c5-b65b-283d31094fa7"],
 " reads it on a concrete graph."
}], "Notes",ExpressionUUID->"7515f74c-a845-45eb-abb1-973541cdb039"],

Cell[TextData[{
 "For two anchors it is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularBisector"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularBisector", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "516b675b-1484-4400-9f19-b7e5cd533542"],
 "[",
 StyleBox["p1", "TI"],
 ", ",
 StyleBox["p2", "TI"],
 "]. For three anchors it is the graph analogue of the circumcentre locus. \
For ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "\[GreaterEqual]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c5a39f7-2b89-4e15-8c85-38aecad63a45"],
 " anchors it is the intersection of the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5ae4a8d-b304-4eba-aeb9-9f18e44efccf"],
 " consecutive perpendicular bisectors. Repeated anchors do not change the \
locus. A single anchor gives its connected component. An empty anchor list \
gives every vertex of the graph. Anchors in distinct connected components \
give the empty locus."
}], "Notes",ExpressionUUID->"01b39b51-82e6-4179-ab7c-7247ba3b8a6c"],

Cell["\<\
The substrate must be finite, simple, undirected and unweighted, and all \
anchors must be vertices. List-valued vertex labels are supported: each \
anchor remains a single entry of the outer list. Unsupported arguments and \
properties stay unevaluated.\
\>", "Notes",ExpressionUUID->"51b22e08-09ce-49ab-9b67-01e6cde35b3c"],

Cell[TextData[{
 "\"VertexDensity\" gives weight 1 to each locus vertex. \"Cardinality\" is \
1, including when the locus is empty. \"CountingMeasure\" counts the locus \
vertices; \"Subgraph\" gives the subgraph induced on them. \
\"RiemannianMeasure\" counts locus vertices whose neighbours all lie in the \
locus. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bedef52a-0f15-4280-a680-97f1f65c0820"],
 "[",
 StyleBox["graph", "TI"],
 ", ",
 StyleBox["object", "TI"],
 ", ",
 StyleBox["vertices", "TI"],
 "] tests whether ",
 StyleBox["vertices", "TI"],
 " is the complete locus, independently of ordering or repetition."
}], "Notes",ExpressionUUID->"7164158b-d79f-43f6-9c18-828215a1ecdf"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "170fc443-6762-4c9b-b6c7-ae9cdb0c0d36"],
 " with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "242e98a3-8619-4fd8-a7a1-a89498ebfce1"],
 "[",
 StyleBox["object", "TI"],
 "] chooses a vertex of the locus. The older ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraEquidistantSet"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraEquidistantSet", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e2528e9b-8131-4771-aa0b-22a0ce8f1d34"],
 " returns an explicit vertex list and also supports a thickened \
distance-difference window."
}], "Notes",ExpressionUUID->"7f6bbc8e-595a-4e99-8343-541e7d289dc9"]
}, Open  ]],

