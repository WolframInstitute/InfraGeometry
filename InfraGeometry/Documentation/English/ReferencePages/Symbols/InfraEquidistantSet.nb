Cell["\<\
Read the vertices equidistant from 1, 2 and 3 in the complete graph on four \
vertices. The density is <|4 -> 1|>.\
\>", "ExampleText",ExpressionUUID->"36e7fb59-40fb-4777-ac09-06f37aa2111f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CompleteGraph", "[", " ", "4", " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"InfraMeasurement", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"InfraEquidistantSet", "[", " ", 
       RowBox[{"{", " ", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], " ", "}"}], " ", "]"}], ",",
       " ", "\"\<VertexDensity\>\""}], " ", "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8d39565c-2e86-492b-96b7-012dacb7c614"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{"4", "\[Rule]", "1"}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"adcc045a-0f4f-414c-88a5-fc1fa7750e19"]
}, Open  ]],

Cell["\<\
Draw the common equidistant locus of vertices 1 and 3 on a four-cycle.\
\>", "ExampleText",ExpressionUUID->"ff26ded7-19cf-4123-87f8-89db16ec65c9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"InfraSubstrateHighlight", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"{", " ", 
       RowBox[{
        RowBox[{"InfraEquidistantSet", "[", " ", 
         RowBox[{"{", " ", 
          RowBox[{"1", ",", " ", "3"}], " ", "}"}], " ", "]"}], ",", " ", 
        RowBox[{"{", " ", 
         RowBox[{"1", ",", " ", "3"}], " ", "}"}]}], " ", "}"}]}], " ", 
     "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4975aebb-47a1-4a62-b0b1-e40a0ee337c3"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3, 4}, {Null, 
       SparseArray[
       Automatic, {4, 4}, 0, {
        1, {{0, 2, 4, 6, 8}, {{2}, {4}, {1}, {3}, {2}, {4}, {1}, {3}}}, 
         Pattern}]}, {
      GraphLayout -> "CircularEmbedding", 
       VertexShapeFunction -> {3 -> (Append[{
            RGBColor[0.192157, 0.388235, 0.807843], 
            Opacity[1.]}, 
           Disk[#, 1 #3]]& ), 1 -> (Append[{
            RGBColor[0.192157, 0.388235, 0.807843], 
            Opacity[1.]}, 
           Disk[#, 1 #3]]& ), 4 -> (Append[{
            RGBColor[0.790588, 0.201176, 0.], 
            Opacity[1.]}, 
           Disk[#, 1 #3]]& ), 2 -> (Append[{
            RGBColor[0.790588, 0.201176, 0.], 
            Opacity[1.]}, 
           Disk[#, 1 #3]]& )}}]]}, 
    TagBox[GraphicsGroupBox[{
       {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], 
        LineBox[{{
          DynamicLocation["VertexID$1", Automatic, Center], DynamicLocation[
           "VertexID$2", Automatic, Center]}, {
          DynamicLocation["VertexID$1", Automatic, Center], DynamicLocation[
           "VertexID$4", Automatic, Center]}, {
          DynamicLocation["VertexID$2", Automatic, Center], DynamicLocation[
           "VertexID$3", Automatic, Center]}, {
          DynamicLocation["VertexID$3", Automatic, Center], DynamicLocation[
           "VertexID$4", Automatic, Center]}}]}, 
       {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
        TagBox[
         {RGBColor[0.192157, 0.388235, 0.807843], Opacity[1.], 
          DiskBox[{-1., 1.0106430996148606`*^-15}, 0.02261146496815286]},
         "DynamicName",
         BoxID -> "VertexID$1"], 
        TagBox[
         {RGBColor[0.790588, 0.201176, 0.], Opacity[1.], 
          DiskBox[{-7.044813998280222*^-16, 1.}, 0.02261146496815286]},
         "DynamicName",
         BoxID -> "VertexID$2"], 
        TagBox[
         {RGBColor[0.192157, 0.388235, 0.807843], Opacity[1.], 
          DiskBox[{1., -1.133107779529596*^-15}, 0.02261146496815286]},
         "DynamicName",
         BoxID -> "VertexID$3"], 
        TagBox[
         {RGBColor[0.790588, 0.201176, 0.], Opacity[1.], 
          DiskBox[{6.049014748177263*^-16, -1.}, 0.02261146496815286]},
         "DynamicName",
         BoxID -> "VertexID$4"]}}],
     MouseAppearanceTag["NetworkGraphics"]],
    AllowKernelInitialization->False]],
  DefaultBaseStyle->"NetworkGraphics",
  FormatType->TraditionalForm,
  FrameTicks->None]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"abc08df6-772f-45fb-826e-55b33cd0a84f"]
}, Open  ]],

Cell["\<\
Read the number of objects and their number of vertices separately. An empty \
bisector is one set with no vertices.\
\>", "ExampleText",ExpressionUUID->"8ffddc1c-3e44-4e34-abc4-6709c6e207e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"PathGraph", "[", " ", 
       RowBox[{"{", " ", 
        RowBox[{"1", ",", " ", "2"}], " ", "}"}], " ", "]"}]}], " ", "}"}], ",",
     "\n", "  ", 
    RowBox[{"{", " ", 
     RowBox[{"object", " ", "=", " ", 
      RowBox[{"InfraEquidistantSet", "[", " ", 
       RowBox[{"{", " ", 
        RowBox[{"1", ",", " ", "2"}], " ", "}"}], " ", "]"}]}], " ", "}"}], ",",
     "\n", "  ", 
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"InfraMeasurement", "[", " ", 
       RowBox[{"graph", ",", " ", "object", ",", " ", "\"\<Cardinality\>\""}],
        " ", "]"}], ",", " ", 
      RowBox[{"InfraMeasurement", "[", " ", 
       RowBox[{
       "graph", ",", " ", "object", ",", " ", "\"\<CountingMeasure\>\""}], 
       " ", "]"}]}], " ", "}"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"eb5acaa7-b766-4ebf-8748-44105d9ffbfb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "0"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"064a3269-99c2-4090-b037-d7a7aed8207b"]
}, Open  ]],

