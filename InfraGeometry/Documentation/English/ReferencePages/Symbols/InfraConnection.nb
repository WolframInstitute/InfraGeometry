Cell["\<\
An isolated base vertex needs no horizontal edges. The empty edge set can \
therefore be a complete connection.\
\>", "ExampleText",ExpressionUUID->"1e5acd2d-43fd-4551-b4a0-465bbf3b0756"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"Graph", "[", " ", 
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{"1", ",", " ", "2"}], " ", "}"}], ",", " ", 
         RowBox[{"{", " ", "}"}]}], " ", "]"}], ",", " ", 
       RowBox[{"<|", " ", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<p\>\""}]}], " ", "|>"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraConnectionQ", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"InfraConnection", "[", " ", 
        RowBox[{"{", " ", "}"}], " ", "]"}]}], " ", "]"}], ",", "\n", "    ", 
     
     RowBox[{"InfraParallelTransport", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"InfraConnection", "[", " ", 
        RowBox[{"{", " ", "}"}], " ", "]"}], ",", " ", 
       RowBox[{"{", " ", "\"\<p\>\"", " ", "}"}]}], " ", "]"}]}], " ", 
    "}"}]}], "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ec3bb3f3-efc6-44ee-84fe-cd34e6e96f73"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", 
   RowBox[{"DeleteMissing", "[", 
    RowBox[{"AssociationMap", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{
       "WolframInstitute`InfraGeometry`InfraConnection`PackagePrivate`x$", ",", 
        RowBox[{"Fold", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MissingQ", "[", "#1", "]"}], ",", "#1", ",", 
             RowBox[{
              RowBox[{"Function", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                 "WolframInstitute`InfraGeometry`InfraConnection`\
PackagePrivate`x$", ",", 
                  "WolframInstitute`InfraGeometry`InfraConnection`\
PackagePrivate`q$"}], "}"}], ",", 
                RowBox[{"First", "[", 
                 RowBox[{
                  RowBox[{"Select", "[", 
                   RowBox[{
                    RowBox[{"AdjacencyList", "[", 
                    RowBox[{
                    RowBox[{"Graph", "[", 
                    RowBox[{
                    RowBox[{"Keys", "[", 
                    RowBox[{"InfraFibrationAssociation", "[", 
                    RowBox[{"InfraFiberedGraph", "[", 
                    RowBox[{
                    GraphicsBox[
                    NamespaceBox["NetworkGraphics",
                    DynamicModuleBox[{Typeset`graph = HoldComplete[
                    Graph[{1, 2}, {}]]}, 
                    
                    TagBox[GraphicsGroupBox[
