Notebook[{

Cell[CellGroupData[{
Cell["InfraConnection", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a48056d5-f005-417a-9d67-9535a9d9f933"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraConnection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraConnection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["edges", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4aeb770-58b8-4816-b93a-f67f5eb8e970"],
 "\[LineSeparator]",
 "is a connection given by a list of total edges of a fibered graph: over \
every base edge they match the two fibers one to one.",
 "\n"
}], "Usage",ExpressionUUID->"39308100-4ac7-47ff-a288-7c3c145fc4d2"],

Cell[TextData[{
 "A connection on a fibered graph is a set ",
 StyleBox["H", "TI"],
 " of total edges such that, over every base edge ",
 StyleBox["{p, q}", "TI"],
 ", the edges of ",
 StyleBox["H", "TI"],
 " between ",
 StyleBox["F(p)", "TI"],
 " and ",
 StyleBox["F(q)", "TI"],
 " form a perfect matching. It has no vertical edges."
}], "Notes",ExpressionUUID->"4135b761-f5c2-4158-8018-4673c0d1afa0"],

Cell[TextData[{
 "A connection moves each vertex of ",
 StyleBox["F(p)", "TI"],
 " to one vertex of ",
 StyleBox["F(q)", "TI"],
 ": following ",
 StyleBox["H", "TI"],
 " along a base walk gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraHorizontalLift"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraHorizontalLift", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ee59cad3-679a-4e7c-9151-2d24a7792ff1"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraParallelTransport"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelTransport", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "096491ab-65c7-4161-b9de-2a6078f28814"],
 " and, around a closed walk, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraHolonomy"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraHolonomy", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "767b5221-ff72-4072-9200-9786004b1df2"],
 "."
}], "Notes",ExpressionUUID->"a2f6e6b1-55ec-4c73-b477-4e0160983856"],

Cell["\<\
A connection exists only if adjacent fibers have the same size and the total \
edges between them contain a perfect matching. A fibered graph can have many \
connections; a covering has exactly one, all its edges.\
\>", "Notes",ExpressionUUID->"03d0a712-5380-48fd-a059-d764432575a0"],

Cell[TextData[{
 "The connected components of ",
 StyleBox["H", "TI"],
 " are the horizontal leaves. The connection is flat, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFlatConnectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFlatConnectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f49e5493-f06a-41b2-a63e-b456d7327430"],
 ", when every leaf meets every fiber at most once."
}], "Notes",ExpressionUUID->"87db02ff-0b25-4d7d-bd9b-3286d20e8e16"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7427ed83-4b04-4922-b99b-52ec8a9e7348"],
 " is a symbolic object: it carries no graph. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1d476782-bbec-414a-85a6-395f9c6e72db"],
 " tests it against a fibered graph, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraConnection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraConnection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9440f388-931e-40e1-b189-041186e1284c"],
 " draws one and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraphHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraphHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cd2159f1-48ac-4974-9651-569a3ab7e87e"],
 " draws it."
}], "Notes",ExpressionUUID->"f8a05ba3-b114-443e-ba3f-2126b0593ec5"]
}, Open  ]],

