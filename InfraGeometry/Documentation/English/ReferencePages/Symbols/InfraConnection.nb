Cell["\<\
A double covering of a square has one horizontal leaf. A circuit around the \
square exchanges its two sheets.\
\>", "ExampleText",ExpressionUUID->"ed9c432b-e596-4c06-ab06-b457598cb64d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{"total", ",", " ", 
       RowBox[{"vertex", " ", "|->", " ", 
        RowBox[{"Mod", "[", " ", 
         RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
      " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"connection", " ", "=", " ", 
     RowBox[{"InfraConnection", "[", " ", 
      RowBox[{"EdgeList", " ", "@", " ", "total"}], " ", "]"}]}], " ", "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
      RowBox[{"fib", ",", " ", "connection"}], " ", "]"}], ",", "\n", "    ", 
     
     RowBox[{"InfraConnectionQ", "[", " ", 
      RowBox[{"fib", ",", " ", "connection"}], " ", "]"}], ",", "\n", "    ", 
     
     RowBox[{"InfraHolonomy", "[", " ", 
      RowBox[{"fib", ",", " ", "connection", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{
        "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "1"}], 
        " ", "}"}]}], " ", "]"}]}], " ", "}"}]}], "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a13c0143-c3e7-40c3-8f5f-272d00854730"],

