Cell["\<\
The holonomy around the four squares at the centre 45. Around the first two \
the transport exchanges the two vertices of the fiber:\
\>", "ExampleText",ExpressionUUID->"06bfdee1-58f0-4b64-a92c-3c0fa24130d0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraHolonomy", "[", 
      RowBox[{"fib", ",", " ", "conn", ",", " ", "square"}], "]"}], ",", "\n",
      "    ", 
     RowBox[{"{", 
      RowBox[{"square", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "45", ",", " ", "46", ",", " ", "36", ",", " ", "35", ",", " ", 
           "45"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
          "45", ",", " ", "35", ",", " ", "34", ",", " ", "44", ",", " ", 
           "45"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
          "45", ",", " ", "44", ",", " ", "54", ",", " ", "55", ",", " ", 
           "45"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
          "45", ",", " ", "55", ",", " ", "56", ",", " ", "46", ",", " ", 
           "45"}], "}"}]}], "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9d3fdb0b-e273-4abe-a5e8-40f01a8c0d3c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Cycles", "[", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], "}"}], "]"}], ",", 
   RowBox[{"Cycles", "[", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], "}"}], "]"}], ",", 
   RowBox[{"Cycles", "[", 
    RowBox[{"{", "}"}], "]"}], ",", 
   RowBox[{"Cycles", "[", 
    RowBox[{"{", "}"}], "]"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"c39f4b82-9091-401e-940a-d0f83c98acc8"]
}, Open  ]],

Cell["\<\
So the connection is not flat: its edges form a single horizontal leaf, which \
meets every fiber twice:\
\>", "ExampleText",ExpressionUUID->"e6565bfc-0e67-495b-9e65-411599b045bb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"leaves", " ", "=", " ", 
     RowBox[{"ConnectedComponents", " ", "@", " ", 
      RowBox[{"Graph", "[", 
       RowBox[{
        RowBox[{"VertexList", " ", "@", " ", 
         RowBox[{"InfraTotalSpace", "[", "fib", "]"}]}], ",", " ", 
        RowBox[{"First", " ", "@", " ", "conn"}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "leaves", "]"}], ",", " ", 
     RowBox[{"InfraFlatConnectionQ", "[", 
      RowBox[{"fib", ",", " ", "conn"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"2117ad4a-861c-4013-8337-d3583d11ce12"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"ade92197-db78-4902-a319-db2c76dff7f2"]
}, Open  ]]
}, Open  ]],

