Cell[CellGroupData[{
Cell["InfraConnection", "ObjectName",ExpressionUUID->"b89e95da-430e-4c92-bbf5-333a51241e81"],

Cell["LLM generated.", "Notes",ExpressionUUID->"32e5f880-a067-47c7-98a0-0d036e882637"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f4a04a42-fc09-4ada-9d23-9b79e8e4c370"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraConnection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraConnection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["edges", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50abc036-fdd2-4b8a-bc74-1596140be574"],
 "\[LineSeparator]",
 "is an inert description of horizontal edges chosen for transport in a \
fibered graph.",
 "\n"
}], "Usage",ExpressionUUID->"3d72ffbf-ddc3-4176-a2e7-b2d46c761168"],

Cell["\<\
The head carries no graph. Readers receive the fibered graph as a separate \
argument.\
\>", "Notes",ExpressionUUID->"0b446c57-e911-4b20-abad-200070ceef59"],

Cell["\<\
A complete connection chooses a perfect matching between the whole fibers \
over each base edge. It contains no vertical edges.\
\>", "Notes",ExpressionUUID->"566a2e56-e5be-4a01-bd78-054ae04f5ccb"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b33b7cf3-75c7-43bc-aa25-7a593baaf565"],
 " checks this condition, including total vertices with no available \
transverse edge."
}], "Notes",ExpressionUUID->"0c096ef0-18bf-4abd-8287-d843b0bbf747"],

Cell["\<\
The order and orientation of the undirected edges do not affect the \
connection. Repeated edges are not a matching.\
\>", "Notes",ExpressionUUID->"b840e68b-4949-4c37-9016-cc15c4f92cb7"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["Graph",
    BaseStyle->"Link"], "[", 
   RowBox[{
    RowBox[{
     ButtonBox["VertexList",
      BaseStyle->"Link"], "[", 
     RowBox[{"InfraTotalSpace", "[", 
      StyleBox["fib", "TI"], "]"}], "]"}], ",", " ", 
    StyleBox["edges", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "528a3a06-1acf-4dbd-aff2-fdf67530cf03"],
 " gives its graph. Its connected components are the horizontal leaves."
}], "Notes",ExpressionUUID->"d014d931-82d6-4d0b-ad55-8f675582d3d8"],

Cell["\<\
Connections are supported on finite simple undirected unweighted untagged \
total graphs.\
\>", "Notes",ExpressionUUID->"e50c6809-e787-4cfc-a66e-0875e29f0068"]
}, Open  ]],

