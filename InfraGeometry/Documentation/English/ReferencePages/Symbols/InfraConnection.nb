Cell["\<\
The same on the Moebius ladder: one horizontal leaf runs twice around the \
cycle.\
\>", "ExampleText",ExpressionUUID->"386bce13-10b1-4e36-9b6b-5f78a5492a05"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<MoebiusLadderCover\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"InfraConnection", " ", "@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"EdgeList", "[", "total", "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"First", " ", "@", " ", "#"}]}], " ", "=!=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Last", " ", "@", " ", "#"}]}]}], " ", "&"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"total", ",", " ", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"InfraWalk", " ", "/@", " ", 
        RowBox[{"List", " ", "@@@", " ", 
         RowBox[{"First", " ", "@", " ", "conn"}]}]}], ",", " ", 
       RowBox[{"Directive", "[", "StandardRed", "]"}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"452fd6ee-983a-46aa-8255-9cf2946ca906"],

