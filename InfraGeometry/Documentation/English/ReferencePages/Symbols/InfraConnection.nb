Cell[TextData[{
 "The Levi-Civita connection of the octahedron is an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2e197002-5473-4a42-9b1f-4201011828a0"],
 " of its displacement bundle."
}], "ExampleText",ExpressionUUID->"f60e2897-66e4-4ac8-a30d-22d0ef1f9b9a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{
     "InfraFiberedSubstrate", "[", "\"\<OctahedronDisplacementBundle\>\"", 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Head", "[", "conn", "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", "conn"}]}], ",", " ", 
     RowBox[{"InfraConnectionQ", "[", 
      RowBox[{"fib", ",", " ", "conn"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"37b92694-522b-4dc5-bf5b-16a719557799"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"InfraConnection", ",", "48", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"8ef5c5da-f031-45f9-8439-abdebbdad756"]
}, Open  ]]
}, Open  ]],

