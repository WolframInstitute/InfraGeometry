Cell["\<\
An isolated base vertex needs no horizontal edges. The empty edge set can \
therefore be a complete connection.\
\>", "ExampleText",ExpressionUUID->"d41f2e8e-663f-455d-a392-f6ced471fca1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"Graph", "[", " ", 
        RowBox[{
         RowBox[{"{", " ", 
          RowBox[{"1", ",", " ", "2"}], " ", "}"}], ",", " ", 
         RowBox[{"{", " ", "}"}]}], " ", "]"}], ",", " ", 
       RowBox[{"<|", " ", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<p\>\""}]}], " ", "|>"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraConnectionQ", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"InfraConnection", "[", " ", 
        RowBox[{"{", " ", "}"}], " ", "]"}]}], " ", "]"}], ",", "\n", "    ", 
     
     RowBox[{"InfraParallelTransport", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"InfraConnection", "[", " ", 
        RowBox[{"{", " ", "}"}], " ", "]"}], ",", " ", 
       RowBox[{"{", " ", "\"\<p\>\"", " ", "}"}]}], " ", "]"}]}], " ", 
    "}"}]}], "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e8a9e3e3-3987-46fb-829a-4b7b004b06d7"],

