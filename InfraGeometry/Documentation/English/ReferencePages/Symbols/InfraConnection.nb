Cell["InfraConnection", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6a8017b0-dfe7-43fd-80b9-46ed4d4e9f94"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraConnection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraConnection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["edges", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca24c95b-273f-4a55-b9bb-4f8b2408abb1"],
 "\[LineSeparator]",
 "is an inert description of horizontal edges chosen for transport in a \
fibered graph.",
 "\n"
}], "Usage",ExpressionUUID->"fb959a3d-919e-466e-af7e-311f14648de4"],

Cell["\<\
The head carries no graph. Readers receive the fibered graph as a separate \
argument.\
\>", "Notes",ExpressionUUID->"c74ee812-7425-47a0-ad66-1eb1af205818"],

Cell["\<\
A complete connection chooses a perfect matching between the whole fibers \
over each base edge. It contains no vertical edges.\
\>", "Notes",ExpressionUUID->"dbebf16c-4cf4-4efb-848d-63ca8f50f82f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f1316bc9-1176-4045-817c-2d8523668df5"],
 " checks this condition, including total vertices with no available \
transverse edge."
}], "Notes",ExpressionUUID->"e0145f0b-83d2-4c51-8b91-231662321c0f"],

Cell["\<\
The order and orientation of the undirected edges do not affect the \
connection. Repeated edges are not a matching.\
\>", "Notes",ExpressionUUID->"46d24565-4f03-44e3-ae02-4b81dc1c7fc9"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["Graph",
    BaseStyle->"Link"], "[", 
   RowBox[{
    RowBox[{
     ButtonBox["VertexList",
      BaseStyle->"Link"], "[", 
     RowBox[{"InfraTotalSpace", "[", 
      StyleBox["fib", "TI"], "]"}], "]"}], ",", " ", 
    StyleBox["edges", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2f78ac6-955a-4887-9ab1-b7ca4f480b3f"],
 " gives its graph. Its connected components are the horizontal leaves."
}], "Notes",ExpressionUUID->"f41b6a04-2b0d-4cb1-b87a-e3fd4902caef"],

Cell["\<\
Connections are supported on finite simple undirected unweighted untagged \
total graphs.\
\>", "Notes",ExpressionUUID->"64646b53-b26a-46fd-9bf3-b075305f99b7"]
}, Open  ]],

