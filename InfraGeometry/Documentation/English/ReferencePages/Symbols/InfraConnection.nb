}], "Usage",ExpressionUUID->"469f4393-c619-4a58-85c8-ae9a73cfbcaf"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "66921560-6eb8-4a74-836d-fcfdca9950ef"],
 " is inert and carries no graph. The fibration is given to each function \
that reads it."
}], "Notes",ExpressionUUID->"0b855831-6b1c-42c5-b6d4-37540149a347"],

Cell["\<\
An edge is horizontal when its endpoints lie over different base vertices.\
\>", "Notes",ExpressionUUID->"3b32c2d7-6fc9-4672-9b76-c492f1293c18"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["Graph",
    BaseStyle->"Link"], "[", 
   RowBox[{
    RowBox[{
     StyleBox["total", "TI"], " ", 
     StyleBox["vertices", "TI"]}], ",", " ", 
    StyleBox["edges", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b68c605-e2ad-4baf-b11e-d24b6e588498"],
 " is the connection graph. Its components are the horizontal leaves."
}], "Notes",ExpressionUUID->"d37a9617-1845-4ac7-897d-244bd9be5444"],

