   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4d21e13a-0073-4030-93f0-e80247bf928e"],
 " of its displacement bundle."
}], "ExampleText",ExpressionUUID->"24248a11-9676-48fc-b3c2-dd9336cdcf0b"],

