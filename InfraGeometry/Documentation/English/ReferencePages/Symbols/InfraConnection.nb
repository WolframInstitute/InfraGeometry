Cell["\<\
With two vertices in every fiber and all total edges, each base edge carries \
two matchings. Over the cycle of length 4 there are 2\:2074 = 16 connections, \
and the 8 with an even number of crossings are flat:\
\>", "ExampleText",ExpressionUUID->"60222476-feab-418c-878d-c48edc973774"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "4", "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       "\n", "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"all", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "all", "]"}], ",", " ", 
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"InfraFlatConnectionQ", "[", 
          RowBox[{"fib", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
        "all"}], ",", " ", "True"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7549c40f-bb36-46b5-822e-22f19387faf7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"16", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"47e95aef-3eb0-44c6-8071-56d1dac6d272"]
}, Open  ]],

Cell["A covering has one connection, the set of all its edges:", "ExampleText",ExpressionUUID->"cdbfd71d-a9c6-472a-9489-9a4b452fea9e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Covering\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"all", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "all", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"First", "[", "all", "]"}]}]}], " ", "===", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"EdgeList", " ", "@", " ", 
        RowBox[{"InfraTotalSpace", "[", "fib", "]"}]}]}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e5f6caf1-4eb5-49ef-a63f-80e427847b0a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"b2f54291-c542-4fae-a0e8-f7d16b649109"]
}, Open  ]]
}, Open  ]],

