Cell["\<\
A double covering of a square has one horizontal leaf. A circuit around the \
square exchanges its two sheets.\
\>", "ExampleText",ExpressionUUID->"0222ad5c-61a4-4e73-9c51-9a2247bf74cb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{"total", ",", " ", 
       RowBox[{"vertex", " ", "|->", " ", 
        RowBox[{"Mod", "[", " ", 
         RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
      " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"connection", " ", "=", " ", 
     RowBox[{"InfraConnection", "[", " ", 
      RowBox[{"EdgeList", " ", "@", " ", "total"}], " ", "]"}]}], " ", "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
      RowBox[{"fib", ",", " ", "connection"}], " ", "]"}], ",", "\n", "    ", 
     
     RowBox[{"InfraConnectionQ", "[", " ", 
      RowBox[{"fib", ",", " ", "connection"}], " ", "]"}], ",", "\n", "    ", 
     
     RowBox[{"InfraHolonomy", "[", " ", 
      RowBox[{"fib", ",", " ", "connection", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{
        "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "1"}], 
        " ", "}"}]}], " ", "]"}]}], " ", "}"}]}], "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5d0a8cda-bdb6-4b5e-9ffd-d03622cbd90c"],

