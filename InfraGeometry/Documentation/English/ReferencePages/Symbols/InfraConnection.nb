Cell["\<\
The horizontal edges of the prism form a connection: each vertex has one lift \
of each base edge.\
\>", "ExampleText",ExpressionUUID->"59d8ab5c-11f3-4659-9d84-ff3eaf50417f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<CycleProductBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"InfraConnection", " ", "@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"EdgeList", "[", "total", "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"First", " ", "@", " ", "#"}]}], " ", "=!=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Last", " ", "@", " ", "#"}]}]}], " ", "&"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"total", ",", " ", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"InfraWalk", " ", "/@", " ", 
        RowBox[{"List", " ", "@@@", " ", 
         RowBox[{"First", " ", "@", " ", "conn"}]}]}], ",", " ", 
       RowBox[{"Directive", "[", "StandardRed", "]"}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"753062a4-9f2d-440d-a685-c13fc885798d"],

