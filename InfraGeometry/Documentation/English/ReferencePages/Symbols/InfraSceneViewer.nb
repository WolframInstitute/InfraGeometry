Cell["Euclid I.1 on the square mesh, step by step:", "ExampleText",ExpressionUUID->"f5e4dec7-dd44-434e-ab32-aeb71c6c79bc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "pA", ",", " ", "pB", ",", " ", "cA", ",", " ", "cB", ",", " ", 
         "meet"}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraSceneStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"pA", " ", "==", " ", 
              RowBox[{"InfraPoint", "[", "a", "]"}]}], ",", " ", 
             RowBox[{"pB", " ", "==", " ", 
              RowBox[{"InfraPoint", "[", "b", "]"}]}]}], "}"}], ",", 
           " ", "\"\<two points\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraSceneStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"cA", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"pA", ",", " ", "3"}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle about A\>\""}], "]"}], ",", " ", 
         RowBox[{"InfraSceneStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"cB", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"pB", ",", " ", "3"}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle about B\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraSceneStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"meet", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", 
              RowBox[{"InfraIntersection", "[", 
               RowBox[{"cA", ",", " ", "cB"}], "]"}], "]"}]}], "}"}], ",", 
           " ", "\"\<where they meet\>\""}], "]"}]}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"InfraSceneViewer", "[", 
    RowBox[{"scene", ",", " ", "g"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"09a06b21-27ed-490f-80b6-09dfe0454a3c"],

Cell[BoxData[
 DynamicModuleBox[{
  WolframInstitute`InfraGeometry`InfraSceneInteractive`PackagePrivate`step$$ =
   1, WolframInstitute`InfraGeometry`InfraSceneInteractive`PackagePrivate`\
branch$$ = 1, 
  WolframInstitute`InfraGeometry`InfraSceneInteractive`PackagePrivate`mode$$ =
   "Branch", 
  WolframInstitute`InfraGeometry`InfraSceneInteractive`PackagePrivate`\
fixStack$$ = {}, 
  WolframInstitute`InfraGeometry`InfraSceneInteractive`PackagePrivate`\
hiddenSteps$$ = {}, 
  WolframInstitute`InfraGeometry`InfraSceneInteractive`PackagePrivate`shown$$ \
= {
   WolframInstitute`InfraGeometry`InfraSceneInstance[<|
    MTNB$x24iwxl2xr4n`pA -> 5, MTNB$x24iwxl2xr4n`pB -> 19|>]}, 
  WolframInstitute`InfraGeometry`InfraSceneInteractive`PackagePrivate`\
shownStep$$ = 1, 
  WolframInstitute`InfraGeometry`InfraSceneInteractive`PackagePrivate`deadQ$$ \
= False}, 
  PaneBox[
   TagBox[GridBox[{
      {
       TagBox[GridBox[{
          {
           TemplateBox[{30},
            "Spacer1"], 
           TemplateBox[{
             TagBox[
              TagBox[
               GraphicsBox[{{
                  LightDarkSwitched[
                   GrayLevel[0.9], 
                   GrayLevel[0.3]], 
                  
                  RectangleBox[{-1, -1.45}, {1, 1.45}, 
                   RoundingRadius -> {Left -> 0.5}]}, {
                  Thickness[Large], 
                  RGBColor[0.4, 0.6, 1], 
                  LineBox[{{0.25, 0.5}, {-0.25, 0}, {0.25, -0.5}}]}}, 
                ImageSize -> {20, 29.}, AspectRatio -> Full, PlotRangePadding -> 
                None], 
               
               EventHandlerTag[{
                "MouseClicked" :> 
                 Function[
                  WolframInstitute`InfraGeometry`InfraSceneInteractive`\
PackagePrivate`s$, 
                   WolframInstitute`InfraGeometry`InfraSceneInteractive`\
PackagePrivate`step$$ = 
                    Clip[WolframInstitute`InfraGeometry`InfraSceneInteractive`\
PackagePrivate`s$, {1, 4}]; 
                   WolframInstitute`InfraGeometry`InfraSceneInteractive`\
PackagePrivate`branch$$ = 1; (
