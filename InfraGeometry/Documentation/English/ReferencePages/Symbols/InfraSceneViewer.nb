Cell[TextData[{
 "A construction is a sequence, not a picture. The viewer solves the scene \
step by step and draws the objects bound so far with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a06182e6-680d-4a48-99ed-f2218ef1f9b3"],
 "."
}], "Notes",ExpressionUUID->"04de7785-3ae9-4bb1-9d52-ce6ffc4cf33f"],

