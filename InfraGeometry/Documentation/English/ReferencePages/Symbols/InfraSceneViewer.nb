     "b50ca5ed-c369-4d52-bbfd-a6d127425bf7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c8d681fe-074f-4253-9a9b-d2c5493a2d41"], Cell[
    "eye", "TableText",ExpressionUUID->
     "4ec1be10-c9bf-4422-8a07-b4329eed985d"], Cell[
    "hide or show the current step's object", "TableText",ExpressionUUID->
     "0d7e66ae-8fec-4246-bfb7-c0cce1f01e9f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2a47c866-bed4-446a-b378-e940d27a233a"], Cell[
