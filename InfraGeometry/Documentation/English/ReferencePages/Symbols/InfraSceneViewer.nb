Cell[TextData[{
 "A construction is a sequence, not a picture. The viewer solves the scene \
step by step and draws the objects bound so far with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a8606fbf-8b0a-4c98-b991-ae644224f48c"],
 "."
}], "Notes",ExpressionUUID->"44a472e3-f084-4018-a426-9b3a494121bf"],

