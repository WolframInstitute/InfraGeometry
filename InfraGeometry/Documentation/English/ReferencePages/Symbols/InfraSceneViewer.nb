Cell["Euclid I.1 on the square mesh, step by step:", "ExampleText",ExpressionUUID->"4581311d-47a2-412e-833e-d4abdecc9608"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "pA", ",", " ", "pB", ",", " ", "cA", ",", " ", "cB", ",", " ", 
         "meet"}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraSceneStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"pA", " ", "==", " ", 
              RowBox[{"InfraPoint", "[", "a", "]"}]}], ",", " ", 
             RowBox[{"pB", " ", "==", " ", 
              RowBox[{"InfraPoint", "[", "b", "]"}]}]}], "}"}], ",", 
           " ", "\"\<two points\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraSceneStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"cA", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"pA", ",", " ", "3"}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle about A\>\""}], "]"}], ",", " ", 
         RowBox[{"InfraSceneStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"cB", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"pB", ",", " ", "3"}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle about B\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraSceneStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"meet", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", 
              RowBox[{"InfraIntersection", "[", 
               RowBox[{"cA", ",", " ", "cB"}], "]"}], "]"}]}], "}"}], ",", 
           " ", "\"\<where they meet\>\""}], "]"}]}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"InfraSceneViewer", "[", 
    RowBox[{"scene", ",", " ", "g"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"582295c1-daad-4086-bd48-22f5bf86e9e6"],

