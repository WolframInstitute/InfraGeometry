Cell[TextData[{
 "Definition: the viewer solves the scene one step at a time and draws the \
objects bound so far, through ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraHighlightGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraHighlightGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a59bb7b6-f593-49b5-ad09-5d16cc68182e"],
 "."
}], "Notes",ExpressionUUID->"68f74f4c-a305-48de-869f-38a51ad7c340"],

Cell["\<\
It exists because a construction is a sequence, not a picture. Reading Euclid \
I.10 as a single figure hides the order; stepping it shows which object each \
later one depends on.\
\>", "Notes",ExpressionUUID->"23092bb8-0725-4b60-96a7-d51c96d5246f"],

Cell["Controls, in two rows.", "Notes",ExpressionUUID->"0509917f-66c1-4fc0-be03-1241010d5e9b"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "da9f538f-9d47-4282-8576-72538f0b9696"], Cell["Control", "TableText",
     FontWeight->Bold,ExpressionUUID->"ae0ee012-6527-40ff-93a7-49e0e3ef112a"],
     Cell["Does", "TableText",
     FontWeight->Bold,ExpressionUUID->"bd196456-6482-4a34-8751-dee74428ba53"]},
