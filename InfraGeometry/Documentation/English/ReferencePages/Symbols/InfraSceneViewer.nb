Cell[TextData[{
 "A construction is a sequence, not a picture. The viewer solves the scene \
step by step and draws the objects bound so far with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a2f4abdc-42b2-4118-b202-3707edb5d04d"],
 "."
}], "Notes",ExpressionUUID->"6fc5eddd-ae05-4d4d-9dcd-b4084f375ef1"],

