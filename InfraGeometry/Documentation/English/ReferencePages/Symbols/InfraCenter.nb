Notebook[{

Cell[CellGroupData[{
Cell["InfraCenter", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5543b16e-0200-4a17-b92f-2aa87a6cd40b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCenter"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCenter", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["graph", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b795e845-c44c-4442-9d64-e8bbbfad6ee9"],
 "\[LineSeparator]",
 "gives a vertex of least eccentricity.",
 "\n"
}], "Usage",ExpressionUUID->"4bb3fcba-4f34-43a5-b4af-ac0de384fa86"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraCenter", "[", "graph", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75ccf09e-1ffd-42ad-bbe7-c274455002b2"],
 " is ",
 Cell[BoxData[
  RowBox[{"First", " ", "@", " ", 
   RowBox[{"GraphCenter", "[", "graph", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "001c0ec1-6391-48fe-8212-4693e5133a15"],
 ": one representative of the built-in graph center, returned as a bare \
vertex rather than as the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92c2c576-a3db-4493-93d5-38378590d72e"],
 " ",
 Cell[BoxData["GraphCenter"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2e2a8f4-51ea-4431-b6ac-ab338bd8ce03"],
 " itself gives, since there may be several vertices of least eccentricity \
and a construction anchored at \"the\" center wants one."
}], "Notes",ExpressionUUID->"a9fbcbc3-612c-475a-adf6-13cbdd4b895a"]
}, Open  ]],

