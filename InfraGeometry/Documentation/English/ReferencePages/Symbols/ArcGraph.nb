Notebook[{

Cell[CellGroupData[{
Cell["ArcGraph", "ObjectName",ExpressionUUID->"c54e4070-65a3-422d-b2dc-c56b2fabaf30"],

Cell["LLM generated.", "Notes",ExpressionUUID->"6360e45c-49f7-41e4-85d9-3126b6649fd6"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e5c0fc01-e588-46da-9c34-7b56a8f06af8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ArcGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ArcGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["points", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9cd5700f-3ca7-49d2-a1b2-325c1db7039c"],
 "\[LineSeparator]",
 "gives the arc carrier around c through an ordered list of points.",
 "\n"
}], "Usage",ExpressionUUID->"7933bd74-6c6e-46ff-83e8-1588e9ca679c"],

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{"graph", ",", " ", 
    RowBox[{"InfraArc", "[", 
     RowBox[{"c", ",", " ", "points"}], "]"}], ",", " ", "\"\<Graph\>\""}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b40eccb1-c8e8-4ad0-94c4-2ade01218fa4"],
 "."
}], "Notes",ExpressionUUID->"149d3e0a-41b6-4f58-84df-c12f33d76815"],

Cell["\<\
Two distinct endpoints give the shortest-path interval DAG in the radial \
band. Additional points give consecutive carriers. Closed arcs use seam \
carriers. The option \"RadiusDelta\" widens the band, as for InfraArc. The \
arc hypotheses needed for geometric faithfulness are not certified; the \
object's \"Faithful\" reading stays unevaluated.\
\>", "Notes",ExpressionUUID->"8b9a3434-249f-438a-83ce-b5601ae03a2e"]
}, Open  ]],

