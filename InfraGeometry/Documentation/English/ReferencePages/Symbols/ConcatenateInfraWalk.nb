 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8429e21a-a2cc-42fc-9aca-86631947bff9"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e441809-8ad4-40a5-93b9-82c9eee0ef8e"],
 ", the default. Fewer than ",
 StyleBox["n", "TI"],
 " walks give ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "177d8d97-fbee-4a26-a21d-4d146dd085bb"],
 "."
}], "Notes",ExpressionUUID->"f0175418-a876-4dc2-9868-f1a7fb0b6bf7"]
