Cell["\<\
Two vertex lists that meet end to start, read back as a vertex sequence:\
\>", "ExampleText",ExpressionUUID->"3374ec17-a102-452b-b322-eabd172aedb1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Last", " ", "/@", " ", 
  RowBox[{"VertexList", "[", 
   RowBox[{"First", " ", "@", " ", 
    RowBox[{"ConcatenateInfraWalk", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b78498d1-f30c-4c04-afab-f59f2fa6d9c9"],

