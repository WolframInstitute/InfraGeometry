Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7c8d432d-6aed-4afd-995c-fc85ee52b7f7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ConcatenateInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ConcatenateInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["w1", "TI"], ",", " ", 
    StyleBox["w2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db60887e-a9ee-4a5c-87e5-e672dcda2c64"],
 "\[LineSeparator]",
 "gives the walks that run along ",
 StyleBox["w1", "TI"],
 " and then along ",
 StyleBox["w2", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2911dc80-4283-4c75-b774-f107979671a4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
