     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "1"}], "}"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"44009790-bf4d-4ed0-a36c-c18c2ec93690"],

