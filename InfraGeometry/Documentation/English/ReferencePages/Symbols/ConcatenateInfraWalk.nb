Cell[TextData[{
 "A vertex of a resulting walk graph is a pair {",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "} of a position and a vertex, so a walk can come back to a vertex. There is \
no graph argument, and the walks are not checked against a graph:"
}], "ExampleText",ExpressionUUID->"46dca744-3f02-41a0-bdfe-b9806c5eba48"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"VertexList", " ", "@", " ", 
