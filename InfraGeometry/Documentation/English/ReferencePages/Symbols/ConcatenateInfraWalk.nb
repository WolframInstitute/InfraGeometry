Cell[TextData[{
 "The members of the segment from ",
 StyleBox["a", "TI"],
 " to the centre joined to those from the centre to ",
 StyleBox["b", "TI"],
 ". They are the members of the polyline ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0379cffb-132e-40f0-9a54-06665727637f"],
 ", and the label compares the two counts:"
}], "ExampleText",ExpressionUUID->"3bedf505-ba2b-4ac3-9604-5c31f82f44c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", " ", "=", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
           RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], ",", 
        " ", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
           RowBox[{"RandomSeeding", " ", "->", " ", "4"}]}], "]"}]}]}], "}"}],
       ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"walks", " ", "=", " ", 
        RowBox[{"ConcatenateInfraWalk", "[", 
         RowBox[{
          RowBox[{"RandomInfraSegment", "[", 
           RowBox[{"g", ",", " ", "a", ",", " ", "c", ",", " ", "All"}], 
           "]"}], ",", " ", 
          RowBox[{"RandomInfraSegment", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "b", ",", " ", "All"}], 
           "]"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"walks", ",", " ", "a", ",", " ", "c", ",", " ", "b"}], 
         "}"}], ",", "\n", "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Length", "[", "walks", "]"}], ",", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraSegment", "[", 
              RowBox[{"a", ",", " ", "c", ",", " ", "b"}], "]"}], ",", 
             " ", "\"\<Cardinality\>\""}], "]"}]}], "}"}]}]}], "]"}]}], "]"}],
     ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"ace713d8-8fd2-4b6b-bd8e-78ed44ee5243"],

