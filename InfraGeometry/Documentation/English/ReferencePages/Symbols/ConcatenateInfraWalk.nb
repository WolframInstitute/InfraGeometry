Cell["\<\
The order matters. The second walk must start where the first ends:\
\>", "ExampleText",ExpressionUUID->"b8906c20-893c-406a-bc26-8e96c27a6227"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", " ", "@", " ", 
    RowBox[{"ConcatenateInfraWalk", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], ",", " ", 
   RowBox[{"ConcatenateInfraWalk", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"923ae5f0-065e-4e74-a69d-25cff030d1ae"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"08e5e33a-49ad-48b9-83f3-b1a9a5f81fd1"]
}, Open  ]],

Cell["\<\
The members of a segment of length 3 joined to their reverses go out and come \
back, along walks of length 6:\
\>", "ExampleText",ExpressionUUID->"74c8edf5-a0ce-40d1-91f4-10102ea62ea0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Union", "[", 
    RowBox[{"EdgeCount", " ", "/@", " ", 
     RowBox[{"ConcatenateInfraWalk", "[", 
      RowBox[{"members", ",", " ", 
       RowBox[{"Reverse", " ", "/@", " ", "members"}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ca314e53-9549-4f26-ba00-63957f958d3d"],

Cell[BoxData[
 RowBox[{"{", "6", "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"c6bb1d71-04bb-43fd-a62e-e3f21bcdac65"]
}, Open  ]]
}, Open  ]],

