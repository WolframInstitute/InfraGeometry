Cell[CellGroupData[{
Cell["InfraDistance", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8181f31c-77dd-4b7e-b024-eec9951352c8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDistance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDistance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c85af51-6ac9-48c9-8989-7850765877bb"],
 "\[LineSeparator]",
 "gives the distance in ",
 StyleBox["g", "TI"],
 " between ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ": the least graph distance from a vertex of ",
 StyleBox["p", "TI"],
 " to a vertex of ",
 StyleBox["q", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"68faa46e-c08f-42f0-a2f9-c3da487eebd1"],

Cell[TextData[{
 "For vertex sets ",
 StyleBox["P", "TI"],
 " and ",
 StyleBox["Q", "TI"],
 " the distance is ",
 StyleBox["d(P, Q) = min d(p, q)", "TI"],
 " over ",
 StyleBox["p", "TI"],
 " in ",
 StyleBox["P", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " in ",
 StyleBox["Q", "TI"],
 ". For two vertices it is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphDistance"]], "paclet:ref/GraphDistance"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f4d70267-9b46-4eb7-abe7-8c6e0ba5929b"],
 "."
}], "Notes",ExpressionUUID->"dd4cf43e-ebdd-4843-977d-02fb0c67b38e"],

Cell[TextData[{
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " can be vertices, vertex lists, densities ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"v", " ", "->", " ", "m"}], ",", " ", "\[Ellipsis]"}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d3f0489-0241-4b06-8db2-c7e08cd186d9"],
 " (the vertices with ",
 StyleBox["m", "TI"],
 " \[NotEqual] 0), subgraphs, or regions such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "26be4a28-884f-453d-b28a-e6437c06e0ca"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6faa984a-ceea-4944-84e0-7e63daeed1f8"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "761cc9d4-2a74-4426-9e18-3f5100accf32"],
 ". A list that is itself a vertex of ",
 StyleBox["g", "TI"],
 " is read as that vertex."
}], "Notes",ExpressionUUID->"d81a1ba9-55f5-46d5-bdd7-ef36e0f43f67"],

Cell[TextData[{
 "It is not a metric on sets: ",
 StyleBox["d(P, Q)", "TI"],
 " = 0 whenever ",
 StyleBox["P", "TI"],
 " and ",
 StyleBox["Q", "TI"],
 " meet, and the triangle inequality fails."
}], "Notes",ExpressionUUID->"42df2701-2f87-4054-b432-81cb3b7faacb"],

Cell[TextData[{
 "In any connected graph two balls are at distance ",
 StyleBox["max(0, d(a, b) \[Minus] r \[Minus] s)", "TI"],
 ": a shortest path from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 " leaves the first ball at step ",
 StyleBox["r", "TI"],
 " and enters the second ",
 StyleBox["s", "TI"],
 " steps before ",
 StyleBox["b", "TI"],
 "."
}], "Notes",ExpressionUUID->"a21e3f84-fe9c-4d8b-b193-c7b6bb418b45"],

Cell[TextData[{
 "An empty set, or sets in different components, are at distance ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5dbd254f-089f-49e5-97ae-c5f127095cb5"],
 "."
}], "Notes",ExpressionUUID->"f6a833f4-3707-4936-89b0-5fc16b4ab520"],

