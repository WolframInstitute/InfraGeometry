Notebook[{

Cell[CellGroupData[{
Cell["InfraDistance", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"78494852-8b7e-4f3e-b59b-754ae5f97e91"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDistance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDistance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0eadc8a-7089-4823-82b5-26be3cf2a638"],
 "\[LineSeparator]",
 "gives ambient graph distance between valid vertices, or aggregates pair \
distances between nonzero supported object supports.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3967805e-9307-4875-8775-09de9f18d5fd"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDistance"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDistance", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35133504-ddee-42a7-8312-737d4452a0ec"],
 "\[LineSeparator]",
 "is a deferred query inside an InfraScene."
}], "Usage",ExpressionUUID->"3200747f-f6fd-47f7-a04a-fed2bba4ffa1"],

Cell["\<\
The default \"Aggregation\" is Min. Empty or disconnected supports have \
minimum distance Infinity. Supported inputs include vertices, raw vertex \
Lists, densities, Graph carriers and construction objects with supported \
vertex densities. Literal graph-vertex membership takes precedence over \
interpreting a List as a collection. Readers do not sample. Unsupported \
support queries remain unevaluated.\
\>", "Notes",ExpressionUUID->"9fb5b8be-9275-4fad-92d2-a1aae5d53e10"]
}, Open  ]],

