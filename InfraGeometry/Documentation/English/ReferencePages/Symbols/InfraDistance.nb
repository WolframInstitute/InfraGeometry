Cell["\<\
The least, the greatest and the mean distance between two shells about the \
centre of the grid:\
\>", "ExampleText",ExpressionUUID->"d7a1e3e9-861d-4350-96ef-c773b9193992"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraDistance", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"\"\<Aggregation\>\"", " ", "->", " ", "f"}]}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"f", ",", " ", 
       RowBox[{"{", 
        RowBox[{"Min", ",", " ", "Max", ",", " ", "Mean"}], "}"}]}], "}"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"67e40217-d431-43af-b998-428c837de52e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "6", ",", 
   FractionBox["35", "8"]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"81fe50bf-f018-4ce8-86a7-1cd4f0f8e487"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

