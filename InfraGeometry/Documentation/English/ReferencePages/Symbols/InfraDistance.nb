Cell[TextData[{
 "The distance between balls is ",
 StyleBox["max(0, d(a, b) \[Minus] r \[Minus] s)", "TI"],
 ". On the mesh, for a vertex at distance 8 from the centre and all radii ",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["s", "TI"],
 " \[LessEqual] 4:"
}], "ExampleText",ExpressionUUID->"c595dc61-71fd-4eb3-bdb2-4019e74f3055"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "8"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{"Flatten", " ", "@", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraDistance", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"a", ",", " ", "r"}], "]"}], ",", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"b", ",", " ", "s"}], "]"}]}], "]"}], " ", "==", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"8", " ", "-", " ", "r", " ", "-", " ", "s"}]}], "]"}]}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"s", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c998198a-4587-40c3-9279-4d77172fb067"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"74a1f50c-4082-45ba-af25-fcbc19f85181"]
}, Open  ]]
}, Open  ]],

