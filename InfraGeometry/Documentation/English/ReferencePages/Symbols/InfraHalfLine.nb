Cell[TextData[{
 "On the grid a ray along a row fills a half-plane beyond ",
 StyleBox["q", "TI"],
 ", a diagonal ray a quadrant. The labels are the numbers of vertices covered:"
}], "ExampleText",ExpressionUUID->"67e704b5-1489-48d6-a41d-e3dc196841ab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"shell", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraShell", "[", 
         RowBox[{"p", ",", " ", "2"}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"row", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{"shell", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"RandomInfraSegment", "[", 
           RowBox[{"g", ",", " ", "p", ",", " ", "#", ",", " ", "All"}], 
           "]"}], "]"}], " ", "==", " ", "1"}], " ", "&"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"diagonal", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{"shell", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"RandomInfraSegment", "[", 
           RowBox[{"g", ",", " ", "p", ",", " ", "#", ",", " ", "All"}], 
           "]"}], "]"}], " ", "==", " ", "2"}], " ", "&"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraHalfLine", "[", 
           RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "p", ",", " ", 
          "q"}], "}"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraHalfLine", "[", 
            RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
           " ", "\"\<CountingMeasure\>\""}], "]"}]}]}], "]"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"q", ",", " ", 
        RowBox[{"{", 
         RowBox[{"row", ",", " ", "diagonal"}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cd0911ef-784b-4b66-876a-3d510566faf6"],

