Cell[TextData[{
 "The polar form is ",
 StyleBox["d(o, u) d(o, v) cos \[Theta]", "TI"],
 ", with ",
 StyleBox["\[Theta]", "TI"],
 " the comparison angle:"
}], "ExampleText",ExpressionUUID->"5f245653-d34b-4377-bb51-3bbae17644c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"o", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"u", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"o", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"o", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{"InfraScalarProduct", "[", 
     RowBox[{"g", ",", " ", "o", ",", " ", "u", ",", " ", "v"}], "]"}], " ", "==",
     " ", 
    RowBox[{"3", " ", "*", " ", "4", " ", "*", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"InfraComparisonAngle", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"u", ",", " ", "o", ",", " ", "v"}], "}"}]}], "]"}], 
      "]"}]}]}]}], "]"}]], "Input",
