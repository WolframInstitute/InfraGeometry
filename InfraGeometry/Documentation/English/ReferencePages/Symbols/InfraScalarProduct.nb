Cell["\<\
The polar form and the polarization of the realised parallelogram for two \
perpendicular axis vectors of the grid. The polarization takes several \
values, one of them 0:\
\>", "ExampleText",ExpressionUUID->"bf234593-a3b3-4fab-ad03-b782f627a78b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraScalarProduct", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", "65", ",", " ", "47", ",", " ", 
       RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Alexandrov\>\"", ",", " ", "\"\<Parallelogram\>\""}], 
        "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d300e1e9-493c-491e-a8e5-653b89b48343"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "4"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a2d4fd53-9104-4ed3-a842-8aa32967ea3c"]
}, Open  ]],

Cell["\<\
On the sphere mesh, the comparison angle in a positively curved model plane \
is larger, so the scalar product is smaller:\
\>", "ExampleText",ExpressionUUID->"c9c24962-6ecd-4a8c-9a9f-e67e9aa288b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SphereMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"o", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"u", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"o", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"o", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "3"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"InfraScalarProduct", "[", 
       RowBox[{"g", ",", " ", "o", ",", " ", "u", ",", " ", "v", ",", " ", 
        RowBox[{"Method", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Alexandrov\>\"", ",", " ", 
           RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "k"}]}], "}"}]}]}], 
       "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0.2"}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3b3e695d-16bd-4a7c-a838-24dbc78ae812"],

