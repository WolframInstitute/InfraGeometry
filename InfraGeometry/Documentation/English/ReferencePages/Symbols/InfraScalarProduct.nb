Cell[CellGroupData[{
Cell["InfraScalarProduct", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"99148fe9-2ac9-426b-a750-6100ac99d62f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraScalarProduct"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraScalarProduct", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["o", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dfe96d9b-d1b5-4cf9-9ec0-68c13b7600f8"],
 "\[LineSeparator]",
 "gives the scalar product ",
 StyleBox["\:27e8u, v\:27e9\:2092", "TI"],
 " of the vertices ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " seen from the base point ",
 StyleBox["o", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"177d3677-4c2e-4815-ac80-d7c9d309d2f1"],

Cell[TextData[{
 "The vertices are read as vectors from ",
 StyleBox["o", "TI"],
 ". The default is the polar form ",
 StyleBox["\:27e8u, v\:27e9\:2092 = (d(o, u)\.b2 + d(o, v)\.b2 \[Minus] d(u, \
v)\.b2) / 2", "TI"],
 ", equal to ",
 StyleBox["d(o, u) d(o, v) cos \[Theta]", "TI"],
 " with ",
 StyleBox["\[Theta]", "TI"],
 " the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraComparisonAngle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraComparisonAngle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fac3e061-9a63-4b40-94e2-6b4a09e44e6c"],
 " at ",
 StyleBox["o", "TI"],
 "."
}], "Notes",ExpressionUUID->"8b6821f5-59c7-4ac1-ab46-fb49943fb352"],

Cell[TextData[{
 "It is symmetric, and ",
 StyleBox["\:27e8u, u\:27e9\:2092 = d(o, u)\.b2", "TI"],
 ". It is not bilinear: a graph has no addition of vertices, and its \
triangles need not be flat."
}], "Notes",ExpressionUUID->"1fd5b5bf-d4f0-4456-8d2b-5288094c3aea"],

Cell[TextData[{
 "On the square grid the distance is \[ScriptL]\.b9. Two vertices at distance \
",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " on the two axes give ",
 StyleBox["\[Minus]ab", "TI"],
 ", the value of two opposite vectors, not 0."
}], "Notes",ExpressionUUID->"adc263a6-fce5-4dda-8d6e-290e18983e4c"],

Cell[TextData[{
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4cf6c8f4-0910-4f07-9ee8-f1420f108f44"],
 " chooses the construction:"
}], "Notes",ExpressionUUID->"41be4a27-adc0-4f05-aa4c-bfa49ec80aa0"],

