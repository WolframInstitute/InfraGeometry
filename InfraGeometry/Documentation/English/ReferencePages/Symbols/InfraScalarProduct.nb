Cell["\<\
On the grid two axis vectors of length 2 have the same scalar product, \
\[Minus]4, whether they are perpendicular or opposite. From the centre 45, \
the vertex 65 lies 2 steps along one axis, 47 2 steps along the other, and 25 \
2 steps the opposite way from 65:\
\>", "ExampleText",ExpressionUUID->"5bb950c3-d33d-4ce9-b1a5-aeb2832c7f69"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraScalarProduct", "[", 
      RowBox[{"g", ",", " ", "45", ",", " ", "65", ",", " ", "v"}], "]"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"v", ",", " ", 
       RowBox[{"{", 
        RowBox[{"47", ",", " ", "25"}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"cf7f1d84-73db-4924-9e64-9add2ac0a1e5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "4"}], ",", 
   RowBox[{"-", "4"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"a6aa1f37-98eb-4dfe-8c80-ac29883661ae"]
}, Open  ]],

Cell["\<\
The scalar product of a vertex with itself is the square of its distance:\
\>", "ExampleText",ExpressionUUID->"3c1fd3e6-b82b-4b49-81fb-758bfd4773c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"o", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"u", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"o", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraScalarProduct", "[", 
    RowBox[{"g", ",", " ", "o", ",", " ", "u", ",", " ", "u"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"f95499d2-5cbe-4639-9ee6-94fca12081eb"],

Cell[BoxData["16"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"18a88ac8-bf89-4f2f-bdc8-ba674e27e82b"]
}, Open  ]]
}, Open  ]],

