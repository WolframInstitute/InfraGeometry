21052835cb1a"],

Cell[TextData[{
 "The ",
 Cell[BoxData["\"\<Parallelogram\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e69b277-db17-4e17-8243-d537b93c5929"],
 " value is a list when the realisations give several values."
