Cell[TextData[{
 "The vertices of the circle of radius 3 about the centre with a positive \
scalar product with a fixed vertex ",
 StyleBox["u", "TI"],
 " of it, and those with a negative one:"
}], "ExampleText",ExpressionUUID->"2b9a9c3e-c32b-44aa-ba84-c7ba105b2cd9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"o", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"u", " ", "=", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"o", ",", " ", "3"}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"circle", " ", "=", " ", 
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"o", ",", " ", "3"}], "]"}], ",", 
           " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{"circle", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"InfraScalarProduct", "[", 
               RowBox[{"g", ",", " ", "o", ",", " ", "u", ",", " ", "#"}], 
               "]"}], " ", ">", " ", "0"}], " ", "&"}]}], "]"}], ",", "\n", 
          "      ", 
          RowBox[{"Select", "[", 
           RowBox[{"circle", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"InfraScalarProduct", "[", 
               RowBox[{"g", ",", " ", "o", ",", " ", "u", ",", " ", "#"}], 
               "]"}], " ", "<", " ", "0"}], " ", "&"}]}], "]"}], ",", " ", 
          "u", ",", " ", "o"}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"92fd9f33-98f0-4651-b3a7-f2f4e3cf5f8c"],

