Cell["\<\
A row of the matrix is the cardinality of the segments from one vertex:\
\>", "ExampleText",ExpressionUUID->"6d38694b-b63d-4aa4-af1f-5ea43fb705b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"ShortestPathMultiplicityMatrix", "[", "g", "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FirstPosition", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "c"}], "]"}]}], 
      "]"}], "]"}], " ", "==", "\n", "    ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSegment", "[", 
          RowBox[{"c", ",", " ", "#"}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"VertexList", "[", "g", "]"}]}], ")"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f2904a44-cbb5-4084-9fa3-beadb2f4b260"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"bd264467-dd4c-4b4c-ae00-744f1514096e"]
}, Open  ]],

Cell["\<\
On a tree and on an odd cycle every entry is 1; opposite vertices of an even \
cycle are joined by two shortest paths:\
\>", "ExampleText",ExpressionUUID->"30beda69-97c9-4e0f-a170-414f316eb157"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Union", " ", "@", " ", 
      RowBox[{"Flatten", " ", "@", " ", 
       RowBox[{"ShortestPathMultiplicityMatrix", "[", "g", "]"}]}]}], ",", 
     " ", 
     RowBox[{"UniqueInfraSegmentQ", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"KaryTree", "[", "15", "]"}], ",", " ", 
       RowBox[{"CycleGraph", "[", "7", "]"}], ",", " ", 
       RowBox[{"CycleGraph", "[", "6", "]"}]}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8396f38e-2b89-4d08-948d-691767e52e5a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", "True"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", "True"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", "False"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"e6e17290-a1ad-484e-882d-ab954abd92e2"]
}, Open  ]]
}, Open  ]],

