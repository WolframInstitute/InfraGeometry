Cell[TextData[{
 "On the 3 \[Times] 3 grid graph opposite corners are joined by ",
 StyleBox["C(4, 2) = 6", "TI"],
 " shortest paths:"
}], "ExampleText",ExpressionUUID->"f4373316-4736-4774-8624-e707583b1561"],

