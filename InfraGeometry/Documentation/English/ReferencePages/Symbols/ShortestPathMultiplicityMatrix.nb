Cell["\<\
The numbers of shortest paths on the 3 \[Times] 3 grid. The opposite corners \
are joined by 6 = C(4, 2) shortest paths.\
\>", "ExampleText",ExpressionUUID->"e3608757-0ced-492a-aad2-6ac6abaf552c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixForm", " ", "@", " ", 
  RowBox[{"ShortestPathMultiplicityMatrix", "[", 
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a7976695-62d7-4514-bfed-5b65087cc57a"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"1", "1", "1", "1", "2", "3", "1", "3", "6"},
     {"1", "1", "1", "2", "1", "2", "3", "1", "3"},
     {"1", "1", "1", "3", "2", "1", "6", "3", "1"},
     {"1", "2", "3", "1", "1", "1", "1", "2", "3"},
     {"2", "1", "2", "1", "1", "1", "2", "1", "2"},
     {"3", "2", "1", "1", "1", "1", "3", "2", "1"},
     {"1", "3", "6", "1", "2", "3", "1", "1", "1"},
     {"3", "1", "3", "2", "1", "2", "1", "1", "1"},
     {"6", "3", "1", "3", "2", "1", "1", "1", "1"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"14f6109e-4eb9-47af-82ec-126db61fe711"]
}, Open  ]],

Cell["\<\
The matrix of a cycle: the opposite vertices of a cycle of even length are \
joined by two shortest paths.\
\>", "ExampleText",ExpressionUUID->"5e07574b-28c3-4f44-8cc3-034dc09e2674"],

