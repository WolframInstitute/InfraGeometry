Cell["\<\
The numbers of shortest paths on the 3 \[Times] 3 grid. The opposite corners \
are joined by 6 = C(4, 2) shortest paths.\
\>", "ExampleText",ExpressionUUID->"8178b082-6865-4e2d-a7f1-ab2c2e3d7440"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixForm", " ", "@", " ", 
  RowBox[{"ShortestPathMultiplicityMatrix", "[", 
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"57f501f6-5212-42e7-80f3-d20b331a9e52"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"1", "1", "1", "1", "2", "3", "1", "3", "6"},
     {"1", "1", "1", "2", "1", "2", "3", "1", "3"},
     {"1", "1", "1", "3", "2", "1", "6", "3", "1"},
     {"1", "2", "3", "1", "1", "1", "1", "2", "3"},
     {"2", "1", "2", "1", "1", "1", "2", "1", "2"},
     {"3", "2", "1", "1", "1", "1", "3", "2", "1"},
     {"1", "3", "6", "1", "2", "3", "1", "1", "1"},
     {"3", "1", "3", "2", "1", "2", "1", "1", "1"},
     {"6", "3", "1", "3", "2", "1", "1", "1", "1"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"df111c73-2945-4611-bd51-6dd685945d4d"]
}, Open  ]],

Cell["\<\
The matrix of a cycle: the opposite vertices of a cycle of even length are \
joined by two shortest paths.\
\>", "ExampleText",ExpressionUUID->"cc78be78-72b8-4c51-a13c-c1681ea681b8"],

