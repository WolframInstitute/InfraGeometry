Cell["\<\
The matrix is the cardinality of the segment between every pair.\
\>", "ExampleText",ExpressionUUID->"6978b3b1-63ab-4f81-bb93-51af76866223"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ShortestPathMultiplicityMatrix", "[", "g", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "j"}], "]"}], "]"}], " ", "==", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSegment", "[", 
          RowBox[{"1", ",", " ", "j"}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", "2", ",", " ", "9"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e58a101b-bbb1-4df5-89aa-e398154144da"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d4149484-b4f3-4d50-b883-1e88f147aede"]
}, Open  ]],

Cell["On a path graph, or any tree, every entry is 1.", "ExampleText",ExpressionUUID->"ce53151a-74c7-42b1-b50e-80936bbdfc62"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Union", " ", "@", " ", 
  RowBox[{"Flatten", " ", "@", " ", 
   RowBox[{"ShortestPathMultiplicityMatrix", "[", 
    RowBox[{"PathGraph", "[", 
     RowBox[{"Range", "[", "6", "]"}], "]"}], "]"}]}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6dc32d24-c49b-48ec-b050-99f22c637f39"],

Cell[BoxData[
 RowBox[{"{", "1", "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"6031b580-79fb-44ff-935d-6bce1b71ba5e"]
}, Open  ]],

Cell["\<\
The matrix of a disconnected graph is zero between the components.\
\>", "ExampleText",ExpressionUUID->"815e27e5-dc00-4c93-b1ad-72f9edec1a90"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixForm", " ", "@", " ", 
  RowBox[{"ShortestPathMultiplicityMatrix", "[", 
   RowBox[{"Graph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", " ", "<->", " ", "2"}], ",", " ", 
       RowBox[{"3", " ", "<->", " ", "4"}]}], "}"}]}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"2460371f-4d96-4c3b-9aa4-f8d8692ffe4b"],

