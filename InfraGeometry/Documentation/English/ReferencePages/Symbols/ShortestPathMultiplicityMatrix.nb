Cell[TextData[{
 "The number of shortest paths from the centre to every vertex, drawn as the \
size of the vertex, on the square grid and on the square mesh. On the grid \
the largest is ",
 StyleBox["C(8, 4) = 70", "TI"],
 ", at the corner four steps right and four up:"
}], "ExampleText",ExpressionUUID->"75898a28-163f-49a1-a44d-7a860c1fdfe1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"row", " ", "=", " ", 
        RowBox[{
         RowBox[{"ShortestPathMultiplicityMatrix", "[", "g", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"FirstPosition", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "c"}], "]"}]}], 
          "]"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"AssociationThread", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "row"}], "]"}], ",",
           " ", "c"}], "}"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"Max", "[", "row", "]"}]}]}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"0f62c9a6-3ff3-4d6d-8242-e45de0e72d05"],

