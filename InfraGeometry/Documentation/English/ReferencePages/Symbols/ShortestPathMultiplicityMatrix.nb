Notebook[{

Cell[CellGroupData[{
Cell["ShortestPathMultiplicityMatrix", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c92e1285-8def-4688-a0af-9f1942adf6b5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ShortestPathMultiplicityMatrix"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
ShortestPathMultiplicityMatrix", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["graph", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df6622df-e09e-4f3c-bcf2-4117d5826836"],
 "\[LineSeparator]",
 "gives the matrix whose ",
 StyleBox["(i, j)", "TI"],
 " entry is the number of shortest paths from the ",
 StyleBox["i", "TI"],
 "-th to the ",
 StyleBox["j", "TI"],
 "-th vertex, 0 when there is none.",
 "\n"
}], "Usage",ExpressionUUID->"cefc4725-8d0e-4f41-85ea-7b0a3620bfbe"],

Cell[TextData[{
 "The vertices are taken in the order of ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["VertexList",
    BaseStyle->"Link"], "[", 
   StyleBox["graph", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d34812a6-ec3f-4191-bffb-6d80147943c4"],
 ". The diagonal is 1: the one path of length 0. Two vertices of different \
components have no path, and the entry is 0."
}], "Notes",ExpressionUUID->"a296adc0-1bc5-4822-b7a4-37dddf02277d"],

Cell[TextData[{
 "The matrix is symmetric for an undirected graph. The entry ",
 StyleBox["(i, j)", "TI"],
 " is the ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6a23dd5-5d6a-4786-90a4-f560b4725a86"],
 " of the segment from the ",
 StyleBox["i", "TI"],
 "-th to the ",
 StyleBox["j", "TI"],
 "-th vertex, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["u", "TI"], ",", " ", 
      StyleBox["v", "TI"]}], "]"}], ",", " ", "\"\<Cardinality\>\""}], "]"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e1f1ff9-32ae-4f0e-8ac2-cf3754bb28df"],
 ", for all pairs at once."
}], "Notes",ExpressionUUID->"793d0206-5e92-4559-8149-792aef28a9f3"],

Cell[TextData[{
 "The distance matrix is the built-in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphDistanceMatrix"]], "paclet:ref/GraphDistanceMatrix"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33aee002-d76f-4e50-a7fb-46c2483111e8"],
 "; the earlier release returned it beside the counts, as a pair, and this \
function returns the counts only."
}], "Notes",ExpressionUUID->"9198491a-8e13-407a-ab6b-ad2fa44103cb"]
}, Open  ]],

