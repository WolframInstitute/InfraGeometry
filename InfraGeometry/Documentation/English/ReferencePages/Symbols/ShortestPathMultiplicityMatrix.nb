Cell["\<\
The numbers of shortest paths on the 3 \[Times] 3 grid. The opposite corners \
are joined by 6 = C(4, 2) shortest paths.\
\>", "ExampleText",ExpressionUUID->"117c3c68-1ed9-4b9d-a303-218ef6a67548"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixForm", " ", "@", " ", 
  RowBox[{"ShortestPathMultiplicityMatrix", "[", 
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"abdedf1a-d0a2-4811-bdc5-8b8c71106793"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"1", "1", "1", "1", "2", "3", "1", "3", "6"},
     {"1", "1", "1", "2", "1", "2", "3", "1", "3"},
     {"1", "1", "1", "3", "2", "1", "6", "3", "1"},
     {"1", "2", "3", "1", "1", "1", "1", "2", "3"},
     {"2", "1", "2", "1", "1", "1", "2", "1", "2"},
     {"3", "2", "1", "1", "1", "1", "3", "2", "1"},
     {"1", "3", "6", "1", "2", "3", "1", "1", "1"},
     {"3", "1", "3", "2", "1", "2", "1", "1", "1"},
     {"6", "3", "1", "3", "2", "1", "1", "1", "1"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"3a6cbd8d-0e10-4933-87f3-fc5053d0bbf0"]
}, Open  ]],

Cell["\<\
The matrix of a cycle: the opposite vertices of a cycle of even length are \
joined by two shortest paths.\
\>", "ExampleText",ExpressionUUID->"b8a63d5e-9218-4cb4-bafa-cfaa46d8de00"],

