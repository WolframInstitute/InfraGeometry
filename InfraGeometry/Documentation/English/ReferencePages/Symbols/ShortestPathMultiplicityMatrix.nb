Notebook[{

Cell[CellGroupData[{
Cell["ShortestPathMultiplicityMatrix", "ObjectName",ExpressionUUID->"2ce4f315-895e-4738-8178-79d4a588a4b6"],

Cell["LLM generated.", "Notes",ExpressionUUID->"ee5fe2d6-eb22-4061-ae60-10515660286f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ff565ab5-58fd-4dfd-8362-99cb7dd8687a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ShortestPathMultiplicityMatrix"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
ShortestPathMultiplicityMatrix", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["graph", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dc05b3d-a07f-497d-a97b-926f1aab2b75"],
 "\[LineSeparator]",
 "gives the matrix whose ",
 StyleBox["(i, j)", "TI"],
 " entry is the number of shortest paths from the ",
 StyleBox["i", "TI"],
 "-th to the ",
 StyleBox["j", "TI"],
 "-th vertex, 0 when there is none.",
 "\n"
}], "Usage",ExpressionUUID->"f969a5ae-3368-467f-bc88-eee6472a6a2c"],

Cell[TextData[{
 "The vertices are taken in the order of ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["VertexList",
    BaseStyle->"Link"], "[", 
   StyleBox["graph", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da55bb7a-fec1-42b6-a6db-e61d8457c320"],
 ". The diagonal is 1: the one path of length 0. Two vertices of different \
components have no path, and the entry is 0."
}], "Notes",ExpressionUUID->"1d4c1eb2-35eb-452c-8227-55324aedfa3c"],

Cell[TextData[{
 "The matrix is symmetric for an undirected graph. The entry ",
 StyleBox["(i, j)", "TI"],
 " is the ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40607d76-ca99-4daa-9004-3df7ba36610f"],
 " of the segment from the ",
 StyleBox["i", "TI"],
 "-th to the ",
 StyleBox["j", "TI"],
 "-th vertex, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["u", "TI"], ",", " ", 
      StyleBox["v", "TI"]}], "]"}], ",", " ", "\"\<Cardinality\>\""}], "]"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e82db9a5-b33f-494d-8e50-c4b38372bdb6"],
 ", for all pairs at once."
}], "Notes",ExpressionUUID->"c5804497-9669-4fac-9fd1-092e45047e53"],

Cell[TextData[{
 "The distance matrix is the built-in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphDistanceMatrix"]], "paclet:ref/GraphDistanceMatrix"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f0e41a2-dc23-45b8-8d51-58055dd217ff"],
 "; the earlier release returned it beside the counts, as a pair, and this \
function returns the counts only."
}], "Notes",ExpressionUUID->"9a7661f6-b69f-4bff-87f0-f382ff76ab8b"]
}, Open  ]],

