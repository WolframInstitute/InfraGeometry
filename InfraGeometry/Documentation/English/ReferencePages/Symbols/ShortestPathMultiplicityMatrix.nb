Cell["\<\
The matrix is the cardinality of the segment between every pair.\
\>", "ExampleText",ExpressionUUID->"35b5a703-27de-4d92-b12e-52048ec51e0e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ShortestPathMultiplicityMatrix", "[", "g", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "j"}], "]"}], "]"}], " ", "==", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSegment", "[", 
          RowBox[{"1", ",", " ", "j"}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", "2", ",", " ", "9"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f6f67538-8019-4b52-8983-18174af0236f"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b34bfea0-f3a0-456d-9426-30d4ca7c044e"]
}, Open  ]],

Cell["On a path graph, or any tree, every entry is 1.", "ExampleText",ExpressionUUID->"f3012edd-4916-461b-ac00-7a27346c3718"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Union", " ", "@", " ", 
  RowBox[{"Flatten", " ", "@", " ", 
   RowBox[{"ShortestPathMultiplicityMatrix", "[", 
    RowBox[{"PathGraph", "[", 
     RowBox[{"Range", "[", "6", "]"}], "]"}], "]"}]}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8f7df53a-e1ac-47f9-ae05-63ecbcfbc6df"],

Cell[BoxData[
 RowBox[{"{", "1", "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"95cc6dbc-a90b-47b9-8b0b-3a502e32c8ec"]
}, Open  ]],

Cell["\<\
The matrix of a disconnected graph is zero between the components.\
\>", "ExampleText",ExpressionUUID->"e302b9ae-d7cd-4c44-95e7-944424fd26b3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixForm", " ", "@", " ", 
  RowBox[{"ShortestPathMultiplicityMatrix", "[", 
   RowBox[{"Graph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", " ", "<->", " ", "2"}], ",", " ", 
       RowBox[{"3", " ", "<->", " ", "4"}]}], "}"}]}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"b7f75998-ec7b-40ea-a3ca-c6eb1cd7a908"],

