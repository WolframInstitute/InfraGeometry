     RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3bb5a49f-dc2a-4925-830a-b652af9ad6f5"],

