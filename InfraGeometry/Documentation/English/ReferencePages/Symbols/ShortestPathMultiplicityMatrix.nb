Cell["\<\
The matrix is the cardinality of the segment between every pair.\
\>", "ExampleText",ExpressionUUID->"6189964b-d421-41f3-b9ab-1bd28b6ac88a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ShortestPathMultiplicityMatrix", "[", "g", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "j"}], "]"}], "]"}], " ", "==", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSegment", "[", 
          RowBox[{"1", ",", " ", "j"}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", "2", ",", " ", "9"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"771a3bf0-5f01-4b7b-9b0b-d92d6c4d8e58"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c4d16a77-c63b-46af-8daf-92aff1e8bf2b"]
}, Open  ]],

Cell["On a path graph, or any tree, every entry is 1.", "ExampleText",ExpressionUUID->"f16f69bd-5a20-49a8-bde8-466472ef7d34"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Union", " ", "@", " ", 
  RowBox[{"Flatten", " ", "@", " ", 
   RowBox[{"ShortestPathMultiplicityMatrix", "[", 
    RowBox[{"PathGraph", "[", 
     RowBox[{"Range", "[", "6", "]"}], "]"}], "]"}]}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1ac51853-1ac7-4cb2-b821-028738f7da1c"],

Cell[BoxData[
 RowBox[{"{", "1", "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"2a36b711-2cb7-4366-9b68-9ad7add569f1"]
}, Open  ]],

Cell["\<\
The matrix of a disconnected graph is zero between the components.\
\>", "ExampleText",ExpressionUUID->"ebef1aa7-f849-48f0-a395-baca31f39cdd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixForm", " ", "@", " ", 
  RowBox[{"ShortestPathMultiplicityMatrix", "[", 
   RowBox[{"Graph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", " ", "<->", " ", "2"}], ",", " ", 
       RowBox[{"3", " ", "<->", " ", "4"}]}], "}"}]}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"a3e6026d-6950-441b-8d87-70b0e27a3978"],

