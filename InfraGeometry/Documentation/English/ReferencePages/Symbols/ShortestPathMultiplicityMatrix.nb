Cell["ShortestPathMultiplicityMatrix", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b4b48060-b525-4e80-b5cb-e6b0b35b5b0d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ShortestPathMultiplicityMatrix"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
ShortestPathMultiplicityMatrix", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f65d60e1-8c87-4147-a3cb-8f0468404949"],
 "\[LineSeparator]",
 "gives the matrix whose entry ",
 StyleBox["(i, j)", "TI"],
 " is the number of shortest paths from the ",
 StyleBox["i", "TI"],
 "-th to the ",
 StyleBox["j", "TI"],
 "-th vertex of ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"e1a06b71-dd33-4ce0-9de9-dd1b9329dd5b"],

Cell[TextData[{
 "The entry ",
 StyleBox["\[Sigma](u, v)", "TI"],
 " is the number of shortest paths from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 ", the ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18151d22-97e0-49c2-884e-bb5622a3f4cc"],
 " of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2208995e-9924-4c70-94bb-20072a582d49"],
 ". The vertices are in the order of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VertexList"]], "paclet:ref/VertexList"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e31b9723-5a02-4f7c-90eb-2cdef4f26b03"],
 "."
}], "Notes",ExpressionUUID->"cf5f1f51-8ada-4681-9ea7-3c2f50671137"],

Cell["\<\
The diagonal is 1, the path of length 0. Between two components the entry is \
0. On an undirected graph the matrix is symmetric.\
\>", "Notes",ExpressionUUID->"1113e1f7-ee6a-44f0-b366-5ebee8087c26"],

Cell[TextData[{
 "On the square grid, with ",
 StyleBox["a", "TI"],
 " steps from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " along one axis and ",
 StyleBox["b", "TI"],
 " along the other, ",
 StyleBox["\[Sigma](u, v) = C(a + b, a)", "TI"],
 "."
}], "Notes",ExpressionUUID->"4081c5ae-a746-4e73-90c8-b798fd7eb1a9"],

Cell[TextData[{
 "All entries are 1 exactly when every two vertices are joined by one \
shortest path, as on a tree or an odd cycle; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UniqueInfraSegmentQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/UniqueInfraSegmentQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "99cda26d-549e-4ed3-90bf-0292eec82573"],
 " tests this."
}], "Notes",ExpressionUUID->"9b3d173f-2f2c-493e-83d7-dccf25267823"],

Cell[TextData[{
