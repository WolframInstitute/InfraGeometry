Notebook[{

Cell[CellGroupData[{
Cell["ShortestPathMultiplicityMatrix", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1bdecdcc-d887-4355-8433-03f4b9fa4be2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ShortestPathMultiplicityMatrix"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
ShortestPathMultiplicityMatrix", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["graph", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be5f3b6d-34c0-4480-8648-c17bc955def9"],
 "\[LineSeparator]",
 "gives the matrix whose ",
 StyleBox["(i, j)", "TI"],
 " entry is the number of shortest paths from the ",
 StyleBox["i", "TI"],
 "-th to the ",
 StyleBox["j", "TI"],
 "-th vertex, 0 when there is none.",
 "\n"
}], "Usage",ExpressionUUID->"e4de27c2-847a-4b50-a39c-9235a4e5b738"],

Cell[TextData[{
 "The vertices are taken in the order of ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["VertexList",
    BaseStyle->"Link"], "[", 
   StyleBox["graph", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "854e7e7a-9381-45b2-ae62-e8f06630f37b"],
 ". The diagonal is 1: the one path of length 0. Two vertices of different \
components have no path, and the entry is 0."
}], "Notes",ExpressionUUID->"8a01c3c2-7d42-4851-bf86-7f005ca64031"],

Cell[TextData[{
 "The matrix is symmetric for an undirected graph. The entry ",
 StyleBox["(i, j)", "TI"],
 " is the ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26afc382-6547-4c7a-ac57-595d811638e5"],
 " of the segment from the ",
 StyleBox["i", "TI"],
 "-th to the ",
 StyleBox["j", "TI"],
 "-th vertex, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["u", "TI"], ",", " ", 
      StyleBox["v", "TI"]}], "]"}], ",", " ", "\"\<Cardinality\>\""}], "]"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b24ac15-a307-4974-9752-a2f40621f5e0"],
 ", for all pairs at once."
}], "Notes",ExpressionUUID->"fd55a1cb-e94f-4e12-a15c-cc18fb9ddf8e"],

Cell[TextData[{
 "The distance matrix is the built-in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphDistanceMatrix"]], "paclet:ref/GraphDistanceMatrix"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26f2f2d2-4951-454d-8861-7409ae291424"],
 "; the earlier release returned it beside the counts, as a pair, and this \
function returns the counts only."
}], "Notes",ExpressionUUID->"827827ff-75e8-44ac-abd1-ca514036dc1e"]
}, Open  ]],

