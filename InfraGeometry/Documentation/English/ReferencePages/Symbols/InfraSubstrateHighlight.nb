Cell[TextData[{
 "A negative mass is an empty ring. The boundary of a walk from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is ",
 StyleBox["q", "TI"],
 " minus ",
 StyleBox["p", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"30502a89-4077-4c54-a953-fed35dd53f24"],

