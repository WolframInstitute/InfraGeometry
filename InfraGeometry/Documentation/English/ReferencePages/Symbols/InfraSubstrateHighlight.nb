        RowBox[{
         RowBox[{"InfraSegment", "[", 
          RowBox[{"c", ",", " ", "end"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"end", ",", " ", "ends"}], "}"}]}], "]"}]}], "]"}], ",", 
     " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"ColorData", "[", 
        RowBox[{"112", ",", " ", "\"\<ColorList\>\""}], "]"}], ",", " ", 
