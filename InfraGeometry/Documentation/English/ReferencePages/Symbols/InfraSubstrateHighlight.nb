Cell["\<\
The palette is Jeremy's strike-out sequence: three segments drawn in its \
first three colours.\
\>", "ExampleText",ExpressionUUID->"3e24c8ac-dadc-4733-bad2-b1501bbcf6d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ends", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "5"}], "]"}], ",", " ", "3"}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"InfraSegment", "[", 
          RowBox[{"c", ",", " ", "end"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"end", ",", " ", "ends"}], "}"}]}], "]"}]}], "]"}], ",", 
     " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"ColorData", "[", 
        RowBox[{"112", ",", " ", "\"\<ColorList\>\""}], "]"}], ",", " ", 
       "3"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2cc8f9fd-8bae-452e-b6e7-a9e0df889397"],

