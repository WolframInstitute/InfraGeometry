     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f8328754-7777-40d7-99cc-7a801999e15c"],
     ", ",
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1ceec651-4dcd-4a4d-a588-e798c26a2490"],
     ", or an ",
     Cell[BoxData["Arrowheads"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c7ca26ed-c8ae-4cb0-a2c4-3076f54ca08f"],
     " spec"
    }], "TableText",ExpressionUUID->"d1e7731f-75a9-4bfa-bda8-679ab24d76ec"], 
    Cell["off", "TableText",ExpressionUUID->
     "3e77aa35-7633-4f38-89d7-09b7467719de"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
