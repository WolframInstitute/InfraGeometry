   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "186aac80-ae05-435f-bb03-20b571fdb20f"],
 " spec there ends a walk with an open head in the walk's colour: ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Arrowheads",
    BaseStyle->"Link"], "[", 
