Cell[TextData[{
 "A negative mass is an empty ring. The boundary of a walk from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is ",
 StyleBox["q", "TI"],
 " minus ",
 StyleBox["p", "TI"],
 ": a dot at the end, a ring at the start, drawn with the walk."
}], "ExampleText",ExpressionUUID->"0a545c66-25c8-43aa-93b8-556e465f3b19"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walk", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", " ", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"p", ",", " ", "q"}], "]"}]}], " ", "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraWalk", "[", "walk", "]"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"q", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"p", " ", "->", " ", 
          RowBox[{"-", "1"}]}]}], "|>"}]}], "}"}]}], "]"}]}], "]"}]}], "Input",\

 CellLabel->"In[4]:= ",ExpressionUUID->"b93bac7f-5eac-4da9-82b9-244d7064f254"],

