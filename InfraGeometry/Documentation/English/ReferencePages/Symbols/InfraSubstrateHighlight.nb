Cell[CellGroupData[{
Cell["InfraSubstrateHighlight", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6f07c3f8-0043-459c-8a5a-c655f7a9f919"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubstrateHighlight"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["obj1", "TI"], ",", " ", 
      StyleBox["obj2", "TI"], ",", " ", "..."}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb892cd7-8c56-4e4e-a6b3-ea507ae83e6a"],
 "\[LineSeparator]",
 "draws the sum of the objects' densities on ",
 StyleBox["g", "TI"],
 ", the ",
 StyleBox["i", "TI"],
 "-th object in the ",
 StyleBox["i", "TI"],
 "-th palette color.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"eda01cd7-ab78-4424-a4cc-fbade6e3c08c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubstrateHighlight"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ead8b4d-abea-4898-bb95-251596daa635"],
 "\[LineSeparator]",
 "draws a single object."
}], "Usage",ExpressionUUID->"e8fe007a-6a39-4e66-902f-81a765979511"],

Cell[TextData[{
 "This is the only rendering primitive in the paclet. Every viewer and every \
figure calls it. The name follows ",
 Cell[BoxData["HighlightGraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7511e593-534d-4892-a0b7-7816dddb21bb"],
 "."
}], "Notes",ExpressionUUID->"4f646b33-b5b5-476e-91d4-bb2dc11ad081"],

Cell["Every object becomes a vertex density and an edge density:", "Notes",ExpressionUUID->"0be6e5d4-468c-4857-9705-e3803368e12e"],

Cell[TextData[{
 "a vertex, or a density ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", "m"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ad48516-5bee-45f6-86b8-9271745d32d1"],
 ": its own mass, no edges;"
}], "Notes",ExpressionUUID->"7d651888-47f1-48c9-b03f-76e6070e0db4"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraWalk", "[", 
   RowBox[{"{", 
    RowBox[{"p1", ",", " ", "...", ",", " ", "pk"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8027ae11-5cd4-4586-8103-d1f62f86b014"],
 ": visit counts and the traversal counts of its steps;"
}], "Notes",ExpressionUUID->"ee3317b4-1d41-4504-a4bd-f69cc64862f7"],

Cell[TextData[{
 "a Euclidean head \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9a576a3f-ee9f-472d-812a-63856b076a85"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "58d44ab1-2885-4094-b172-313118542ac7"],
 " and the rest: its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ddaaae3-5029-4a8e-95cb-a1308d9da161"],
 " and ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8b2724a-fb91-45dc-865d-2723f1ad7177"],
 " from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7d905bda-01fc-4b2f-97d6-c6de646bdb1e"],
 ";"
}], "Notes",ExpressionUUID->"e61c939a-f932-41a4-a885-96d044505572"],

Cell[TextData[{
 "a region head \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fcfcba55-9e3c-4785-81ec-ce627c5a251e"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c1b5029c-21ee-4bca-9b54-961801d6a73c"],
 " and the rest \[LongDash] or an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "20d5b038-59fd-4107-983d-1d08d2e19e91"],
 ": its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87248d7e-b9d4-4c29-b2bf-b5ada4850217"],
 ", no edges;"
}], "Notes",ExpressionUUID->"f0cb349e-edde-4982-aa9a-4aa23fe0cdea"],

Cell["a walk graph, a cycle graph or a DAG: its occupation;", "Notes",ExpressionUUID->"8f8ce73a-6c9e-45af-be70-fd799cbcb705"],

Cell["\<\
a leg chain: the walk through its legs, with its knots drawn on top;\
\>", "Notes",ExpressionUUID->"7aa6b335-24d9-49b6-82c5-c2ffe0459a55"],

Cell["\<\
a vertex list that is an induced path or an induced cycle in its own order, \
as every geodesic is: the walk through it;\
\>", "Notes",ExpressionUUID->"31707410-79a0-4b4d-8d60-a266e70b7cd4"],

Cell[TextData[{
 "any other vertex list: a set, ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f984968-19d8-4c47-bd47-1cca9dc79963"],
 " on its vertices, no edges;"
}], "Notes",ExpressionUUID->"6224d643-385e-41cf-a5e2-14b462616fb7"],

Cell[TextData[{
 "an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "28fcb42d-16ca-46f3-8e39-11fa99978f13"],
 " or any other list \[LongDash] of vertex lists, graphs, heads or walks, \
such as the members of a head or a bundle: the sum of its members, drawn in \
one color, with no edges when a member has none."
}], "Notes",ExpressionUUID->"bccbe94d-4b79-47b2-a51a-8f2967c3c1f5"],

Cell[TextData[{
 "An object with edges is a line, drawn by its edge counts. Any other object \
is drawn as dots, sized by its masses, with the edges between its vertices in \
its color, at the bottom of ",
 Cell[BoxData["\"\<OpacityRange\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80ac63c6-e3e5-478f-b25f-24e141ac2586"],
 " and at the base thickness. Where a line uses such an edge, the line's \
stroke wins."
}], "Notes",ExpressionUUID->"a7b397b7-81cb-4e7d-b947-2fceda2436b1"],

Cell[TextData[{
 "Density ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "611827d2-72d8-4c35-a522-537c48b81227"],
 " draws at the base: the substrate's own vertex size and edge thickness, in \
the object's color. Within one object the lightest mass draws at the base and \
the heaviest at the top, by default four times the base for a stroke and \
three times for a dot. An object whose masses are all equal, such as a set, a \
region or a walk that never repeats an edge, looks like the substrate itself, \
colored."
}], "Notes",ExpressionUUID->"7374464e-1d95-4386-9ac4-653be04207a1"],

Cell[TextData[{
 "The opacity follows each mass divided by the object's heaviest, along ",
 Cell[BoxData["\"\<OpacityRange\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95743fc8-c3ca-4d76-97fa-5af784e8d7ee"],
 ". A single walk is opaque, so a walk that reuses edges stays one path, its \
repeated edges thicker."
}], "Notes",ExpressionUUID->"d36f385a-970a-4685-bf19-f76d96ddcbe3"],

Cell[TextData[{
 "The objects are then summed. At each vertex and edge the strength is the \
sum, capped at ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e15d8c1-4db3-4666-a885-56a34dd1945c"],
 ", and the color is the blend of the objects' colors weighted by their \
masses. Where objects overlap, the figure shows both."
}], "Notes",ExpressionUUID->"15b62eb0-9845-4a04-8ab5-4ad1b8e68e3d"],

Cell["\<\
A head draws the edges its members use, never the chords of its support. An \
object with one member is drawn as one joined stroke; a family is drawn edge \
by edge.\
\>", "Notes",ExpressionUUID->"e212ed03-4a0f-4ca8-b884-d1efad2e855d"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8fd6885-dfbe-49c2-8870-2ecbc8ac76f9"],
 " puts a head on the last vertex of each walk, broader than long, its length \
growing with the stroke under it, black on a light stroke and gold on a dark \
one. An ",
 Cell[BoxData["Arrowheads"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3331e07b-8f81-4ddf-bfc2-eb5947ccd3b9"],
 " spec draws that spec instead."
}], "Notes",ExpressionUUID->"c6f6ee0a-24a8-41c1-9797-ab95b9c6d87e"],

Cell[TextData[{
 "The list is read like a ",
 Cell[BoxData["Graphics"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "056bd084-ef84-429b-bf40-09bae1ddeea7"],
 " list. A ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50826eb5-39c3-420a-abe9-e86b268726d7"],
 " styles every object after it, until the next ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0e6145b-126b-4b61-9d97-0929d3d97016"],
 ". An entry ",
 Cell[BoxData[
  RowBox[{"obj", " ", "->", " ", "style"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6acc44b4-cbbe-45e7-86c2-3c4932d61a48"],
 " styles one object. A color in either replaces the palette color."
}], "Notes",ExpressionUUID->"62950076-7f91-4a25-a6f6-821ed753216b"],

Cell["Options:", "Notes",ExpressionUUID->"04b627af-4c87-4cb1-ab7d-8b099508c53b"],

