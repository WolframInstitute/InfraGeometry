Cell["Arrowheads", "ExampleSubsection",ExpressionUUID->"6fad5488-7d8c-4cb8-9f53-a9d8c39074cc"],

Cell[TextData[{
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31ea83e7-8179-46cb-9735-e25f1a5b0f69"],
 " draws the head at a fixed size; an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Arrowheads"]], "paclet:ref/Arrowheads"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cddbbffd-e37f-4fc3-ae2a-07531345ed25"],
 " spec sizes it as for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Arrow"]], "paclet:ref/Arrow"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "40683545-d67e-45bc-ab0d-515d0aa67794"],
 ", here ",
 Cell[BoxData["Small"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "821c9bb2-55b5-436a-bade-c5767d9b9283"],
 " and ",
 Cell[BoxData["Large"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc1f87e8-e399-4418-a495-46b7400f8496"],
 ":"
}], "ExampleText",ExpressionUUID->"edfca70e-4005-4dd4-aa81-6dec27b82eca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"w", " ", "=", " ", 
     RowBox[{"InfraWalk", "[", 
      RowBox[{"RandomInfraSegment", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", "5"}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", "w", "}"}], ",", " ", 
        RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "#"}]}], "]"}], " ", 
      "&"}], " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{"True", ",", " ", 
       RowBox[{"Arrowheads", "[", "Small", "]"}], ",", " ", 
       RowBox[{"Arrowheads", "[", "Large", "]"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f3440e04-b04f-498d-a1ae-3287472aa080"],

