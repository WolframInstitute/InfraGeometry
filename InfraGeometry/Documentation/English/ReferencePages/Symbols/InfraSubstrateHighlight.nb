Cell[TextData[{
 "A size is in printer points, and ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fcabb1f5-803e-4a86-aae0-368b848c3ef4"],
 " is the substrate's own. For ",
 Cell[BoxData["\"\<OpacityRange\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "253f0bc5-fa7e-4094-b160-dfb0f5cb5c0a"],
 " a scalar is the value at full strength and a pair is an envelope, \
interpolated by strength."
}], "Notes",ExpressionUUID->"136f4d02-d8d0-4edc-9512-eb63c2729fa6"],

Cell[TextData[{
 "An object's own style beats the option, given in the call or by ",
 Cell[BoxData["SetOptions"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7718502-9629-45b8-8a81-f0ebc07801d3"],
 ", which beats the default. ",
 Cell[BoxData[
  RowBox[{"AbsoluteThickness", "[", "t", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16bc2bc2-f68a-4ab5-95fd-053adf6a5545"],
 " or ",
 Cell[BoxData[
  RowBox[{"AbsolutePointSize", "[", "s", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c093064-6622-467e-a9cb-227b8c0a7e85"],
 " in an object's style fixes that object's base. The option sizes the dots \
of the objects without edges; a line gets dots only from its own style. An \
explicit ",
 Cell[BoxData["Opacity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ce5ea9d-d06d-4931-bc2c-d837e383f175"],
 ", any other thickness or a ",
 Cell[BoxData["PointSize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bb45897-ac7c-42b8-87a1-b4a99590223d"],
 " turns that object's range off. ",
 Cell[BoxData["VertexSize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3c0b220-0b3e-48f8-a669-78261b5e2a5e"],
 " is in graph units."
}], "Notes",ExpressionUUID->"c7849f9b-928d-459b-920f-66f735ade8b9"]
}, Open  ]],

