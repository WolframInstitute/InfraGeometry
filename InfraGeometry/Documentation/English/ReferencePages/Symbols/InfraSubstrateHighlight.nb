Notebook[{

Cell[CellGroupData[{
Cell["InfraSubstrateHighlight", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6c737159-0523-4b21-a3d1-ace5d19917a0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubstrateHighlight"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["obj1", "TI"], ",", " ", 
      StyleBox["obj2", "TI"], ",", " ", "..."}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2ad8f8a-199b-4ccc-8915-85c87e498999"],
 "\[LineSeparator]",
 "draws the sum of the objects' densities on ",
 StyleBox["g", "TI"],
 ", the ",
 StyleBox["i", "TI"],
 "-th object in the ",
 StyleBox["i", "TI"],
 "-th palette color.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8b68e994-a9ce-407f-a6d2-b4f475b855a4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubstrateHighlight"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07534178-333d-4895-b722-45cbc114fb4d"],
 "\[LineSeparator]",
 "draws a single object."
}], "Usage",ExpressionUUID->"2828997b-c387-4392-80a4-73340497ca7e"],

Cell[TextData[{
 "This is the only rendering primitive in the paclet. Every viewer and every \
figure calls it. The name follows ",
 Cell[BoxData["HighlightGraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "300859dc-a12a-4b72-a9cb-51bef9937fdc"],
 "."
}], "Notes",ExpressionUUID->"fc96159f-95dd-403f-86c4-eb9101809caf"],

Cell["Every object becomes a vertex density and an edge density:", "Notes",ExpressionUUID->"55cbb4a4-32be-488a-9fcf-3c9aff9cbcab"],

Cell[TextData[{
 "a vertex, or a density ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", "m"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "340c2f4e-469c-4350-96a4-1dddc9df4541"],
 ": its own mass, no edges;"
}], "Notes",ExpressionUUID->"8ba1bbda-36b5-43e4-949c-c271557280e2"],

Cell["\<\
a native undirected edge belonging to the substrate: that edge, with no \
vertex mass;\
\>", "Notes",ExpressionUUID->"c0666de3-673f-407e-a2b5-8d45e7760b3d"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraWalk", "[", 
   RowBox[{"{", 
    RowBox[{"p1", ",", " ", "...", ",", " ", "pk"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04c0d21e-2806-41b0-ac96-92d95bfb4736"],
 ": visit counts and the traversal counts of its steps;"
}], "Notes",ExpressionUUID->"030ef31c-8db8-4e54-8c4f-2a1c4c56b387"],

Cell[TextData[{
 "a Euclidean head \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6b5b7f30-e58b-4b12-85c9-d9665d63d413"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "644cb2bc-eaaf-4196-a85e-69790af46da4"],
 " and the rest: its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54b78502-150d-4d88-8c4a-dffc2fbc5523"],
 " and ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c772de3f-45b1-48d0-b5ba-71d011f94f58"],
 " from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1c77dcb3-6d92-415c-a40f-700302b3d223"],
 ";"
}], "Notes",ExpressionUUID->"6786cdb3-78e1-491d-95c9-c364010ebe3d"],

Cell[TextData[{
 "a region head \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d40ea42e-c9ba-4ef5-a100-77b282a0ae2b"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "55f4545d-e0d2-44b3-818c-f9bfd3abac96"],
 " and the rest \[LongDash] or an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f8e6e697-ed96-466d-953f-d1e593718a48"],
 ": its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "675d56cf-c935-4522-9c85-b37526d76a6f"],
 ", no edges;"
}], "Notes",ExpressionUUID->"2a71107f-c156-4070-a708-31bc4a542268"],

Cell["\<\
a native undirected subgraph whose vertices belong literally to the \
substrate: its vertices and edges, once each;\
\>", "Notes",ExpressionUUID->"383f8aa0-9904-42be-aab9-a86023ebb615"],

Cell["a position-spelled walk graph or a DAG: its occupation;", "Notes",ExpressionUUID->"ce29f76d-979a-47bf-8257-eaf0b9e7e2e2"],

Cell["\<\
a leg chain: the walk through its legs, with its knots drawn on top;\
\>", "Notes",ExpressionUUID->"391eb535-37a1-4c07-a72f-9f2396671b1c"],

Cell["\<\
a vertex list that is an induced path or an induced cycle in its own order, \
as every shortest path is: the walk through it;\
\>", "Notes",ExpressionUUID->"31c1696c-22e1-4ef6-b6f3-9eacf24400a4"],

Cell[TextData[{
 "any other vertex list: a set, ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9171742-1296-45a7-99fb-820ddbbbd1bf"],
 " on its vertices, no edges;"
}], "Notes",ExpressionUUID->"c42f5602-89c5-4626-8254-1bfa15114ac1"],

Cell[TextData[{
 "an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4769b621-8242-47ec-ad11-1f02ac326d65"],
 " or any other list \[LongDash] of vertex lists, graphs, heads or walks, \
such as the members of a head or a bundle: the sum of its members, drawn in \
one color, with no edges when a member has none."
}], "Notes",ExpressionUUID->"c51552cb-ebc8-4e81-a6b0-ff3af0853a8e"],

Cell[TextData[{
 "An object with edges is a line, drawn by its edge counts. Any other object \
is drawn as dots, sized by its masses, with the edges between its vertices in \
its color, at the bottom of ",
 Cell[BoxData["\"\<OpacityRange\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da954585-442c-42b9-9d68-6205fc25a7ae"],
 " and at the base thickness. Where a line uses such an edge, the line's \
stroke wins."
}], "Notes",ExpressionUUID->"02009527-dd6c-4572-ae6a-bb2e4356aa36"],

Cell[TextData[{
 "Density ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4eb1f308-cf5a-4bf8-ae63-8fec4d5c0e77"],
 " draws at the base: the substrate's own vertex size and edge thickness, in \
the object's color. Within one object the lightest mass draws at the base and \
the heaviest at the top, by default four times the base for a stroke and \
three times for a dot. An object whose masses are all equal, such as a set, a \
region or a walk that never repeats an edge, looks like the substrate itself, \
colored."
}], "Notes",ExpressionUUID->"b8b02b8e-11c9-4ce8-8bed-b25e6f4bd326"],

Cell[TextData[{
 "The opacity follows each mass divided by the object's heaviest, along ",
 Cell[BoxData["\"\<OpacityRange\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be70c423-f4e7-404d-bc1a-428b90717817"],
 ". A single walk is opaque, so a walk that reuses edges stays one path, its \
repeated edges thicker. Use ",
 Cell[BoxData[
  RowBox[{"InfraWalk", "[", "walk", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b5124ec-5470-4a96-b1f0-77e4c481aa72"],
 " to specify an ordered traversal; a native undirected graph does not \
prescribe one."
}], "Notes",ExpressionUUID->"0dfc68ed-1dd2-4718-a9cd-72722407ae83"],

Cell["\<\
A density may carry negative masses. A positive mass is a filled dot and a \
negative mass an empty ring of the same size, both in the object's color; \
size and opacity follow the absolute mass, as above. A zero mass is not \
drawn: the vertex keeps the substrate's own style. Edges are not signed.\
\>", "Notes",ExpressionUUID->"2c9eb1eb-3e4c-4129-8d14-74a0a42ea6ff"],

Cell[TextData[{
 "The objects are then summed. At each vertex and edge the strength is the \
sum, capped at ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "411aa5a1-eeb6-4402-8c1a-872a368ecfe4"],
 ", and the color is the blend of the objects' colors weighted by their \
masses. Where objects overlap, the figure shows both."
}], "Notes",ExpressionUUID->"0897a62f-87d6-4b06-a26e-b6a98604d338"],

Cell["\<\
A head draws the edges its members use, never the chords of its support. An \
object with one member is drawn as one joined stroke; a family is drawn edge \
by edge.\
\>", "Notes",ExpressionUUID->"ee5f4afa-d0c4-456d-a888-b594fee8bd48"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a21f767-d38a-45a7-8f3b-366adc151e24"],
 " puts a head on the last vertex of each walk, broader than long, its length \
growing with the stroke under it, black on a light stroke and gold on a dark \
one. An ",
 Cell[BoxData["Arrowheads"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a887138d-7137-4701-8a41-b6f7e2dd5b13"],
 " spec draws that spec instead."
}], "Notes",ExpressionUUID->"c555740c-1a49-4ed4-8cc7-61ae60c6c91e"],

Cell[TextData[{
 "The list is read like a ",
 Cell[BoxData["Graphics"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27243b4e-954f-4ec1-9e52-b1b28d1483b9"],
 " list. A ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c929350-4cdf-4460-9f8f-d29f933c1818"],
 " styles every object after it, until the next ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34687872-c923-46e3-93e0-0b428e1a75da"],
 ". An entry ",
 Cell[BoxData[
  RowBox[{"obj", " ", "->", " ", "style"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "681e772a-3ec3-436e-92ea-523083a7a6c0"],
 " styles one object. A color in either replaces the palette color."
}], "Notes",ExpressionUUID->"0d19f6a5-8cf2-410c-9d5b-4d3691180aef"],

Cell["Options:", "Notes",ExpressionUUID->"ab4c938e-a58e-4145-bf68-d3d39d2604c9"],

