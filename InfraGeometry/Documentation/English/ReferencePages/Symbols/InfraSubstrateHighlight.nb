Cell["\<\
A list of vertex lists is one object, the sum of its members: here the \
shortest paths of a segment, which draw as the head does.\
\>", "ExampleText",ExpressionUUID->"3735a970-cd62-4150-a0ed-0374623f03df"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"a", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"RandomInfraSegment", "[", " ", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSegment", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], " ", 
          "]"}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"InfraSegment", "[", 
          RowBox[{"a", ",", " ", "b"}], "]"}], "}"}]}], "]"}]}], "}"}], 
    "]"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ac7564e9-7b39-462a-bd59-aa6924728d9b"],

