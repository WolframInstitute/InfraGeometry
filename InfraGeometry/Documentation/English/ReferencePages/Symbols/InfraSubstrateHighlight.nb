Cell[TextData[{
 "A negative mass is an empty ring. The boundary of a walk from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is ",
 StyleBox["q", "TI"],
 " minus ",
 StyleBox["p", "TI"],
 ": a dot at the end, a ring at the start, drawn with the walk."
}], "ExampleText",ExpressionUUID->"037a3c56-545e-441c-af7b-2f5e4b198fd2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walk", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", " ", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"p", ",", " ", "q"}], "]"}]}], " ", "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraWalk", "[", "walk", "]"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"q", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"p", " ", "->", " ", 
          RowBox[{"-", "1"}]}]}], "|>"}]}], "}"}]}], "]"}]}], "]"}]}], "Input",\

 CellLabel->"In[4]:= ",ExpressionUUID->"3e8c5a9d-3b57-4ec2-b136-080d5f59c5f3"],

