Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"w", " ", "=", " ", 
     RowBox[{"InfraWalk", "[", 
      RowBox[{"RandomInfraSegment", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", "5"}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"w", " ", "->", " ", "#"}], "}"}]}], "]"}], " ", "&"}], " ", 
     "/@", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Arrowheads", "[", "Automatic", "]"}], ",", " ", 
       RowBox[{"Arrowheads", "[", "Small", "]"}], ",", " ", 
       RowBox[{"Arrowheads", "[", "Large", "]"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"41fcf061-bc70-45ba-b81f-f088020054b2"],

