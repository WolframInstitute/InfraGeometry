Cell["\<\
The palette is Jeremy's strike-out sequence: three segments drawn in its \
first three colours.\
\>", "ExampleText",ExpressionUUID->"10c946fe-a978-4d31-8d7a-700a855ce298"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ends", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "5"}], "]"}], ",", " ", "3"}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"InfraSegment", "[", 
          RowBox[{"c", ",", " ", "end"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"end", ",", " ", "ends"}], "}"}]}], "]"}]}], "]"}], ",", 
     " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"ColorData", "[", 
        RowBox[{"112", ",", " ", "\"\<ColorList\>\""}], "]"}], ",", " ", 
       "3"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"859d3034-a57a-489f-9870-5c5176cc09dc"],

