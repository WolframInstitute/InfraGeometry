Cell[CellGroupData[{
Cell["InfraSubstrateHighlight", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f64aedeb-9ce3-4b04-acbe-74437e776103"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubstrateHighlight"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["obj1", "TI"], ",", " ", 
      StyleBox["obj2", "TI"], ",", " ", "..."}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9162d64-126a-4804-aecc-1e313d1bb083"],
 "\[LineSeparator]",
 "draws the sum of the objects' densities on ",
 StyleBox["g", "TI"],
 ", the ",
 StyleBox["i", "TI"],
 "-th object in the ",
 StyleBox["i", "TI"],
 "-th palette color.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d23f91b8-79e3-45a2-9bb0-8984d3221ccb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubstrateHighlight"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18d9b32d-7f8c-46d7-b3b5-db3b55956d9a"],
 "\[LineSeparator]",
 "draws a single object."
}], "Usage",ExpressionUUID->"5d93a0b1-01b7-4683-a51e-f6cdd87148dd"],

Cell[TextData[{
 "This is the only rendering primitive in the paclet. Every viewer and every \
figure calls it. The name follows ",
 Cell[BoxData["HighlightGraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3b3213b-4196-4388-b594-f0096926a9d1"],
 "."
}], "Notes",ExpressionUUID->"6b233d61-7257-4eba-9de1-13c9362648eb"],

Cell["Every object becomes a vertex density and an edge density:", "Notes",ExpressionUUID->"a2d31107-91c7-403d-a969-22a79598170d"],

Cell[TextData[{
 "a vertex, or a density ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", "m"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3212ea5-8d0c-41c0-954e-299f0c349061"],
 ": its own mass, no edges;"
}], "Notes",ExpressionUUID->"fa583f8c-28ea-409f-8e64-498c2b1a4e07"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraWalk", "[", 
   RowBox[{"{", 
    RowBox[{"p1", ",", " ", "...", ",", " ", "pk"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7cc271a-d9ef-44eb-9e36-4153670cc545"],
 ": visit counts and the traversal counts of its steps;"
}], "Notes",ExpressionUUID->"19184ac4-da2a-4207-8d74-1b3c41a7e05c"],

Cell[TextData[{
 "a Euclidean head \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a8b3224a-2883-4031-9623-8cc32db87a8f"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ed544e2b-0249-4302-b7a8-9788bc563f2b"],
 " and the rest: its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5fb0c29-c64c-4594-a033-c97e6f5d7fdf"],
 " and ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac900206-cda0-4d33-9e47-16ee6af1d6d1"],
 " from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a8024f11-2e27-4385-8ba0-64e6bb487abc"],
 ";"
}], "Notes",ExpressionUUID->"c1bb9a56-e3e1-4032-be13-cde160454909"],

Cell["a walk graph, a cycle graph or a DAG: its occupation;", "Notes",ExpressionUUID->"ae9b9bea-e63b-4646-a029-529dc0fd2c65"],

Cell["\<\
a leg chain: the walk through its legs, with its knots drawn on top;\
\>", "Notes",ExpressionUUID->"db09af4d-0cb0-46d8-86e9-ab3cc9644232"],

Cell[TextData[{
 "a vertex list: a region, ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19054c70-ab61-4b6e-9554-320ef7fb5b15"],
 " on its vertices and on the edges of its induced subgraph;"
}], "Notes",ExpressionUUID->"9ce8af3e-a9ca-407c-b322-c0ac254cbd55"],

Cell["\<\
a list of vertex lists or of graphs, such as the members of a head or a \
bundle: the sum of its members.\
\>", "Notes",ExpressionUUID->"fddf5187-b652-4566-a87b-bce010a07d10"],

Cell[TextData[{
 "A list of heads or of walks is not one object; give them as separate \
entries, styled alike with a ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92cfe46e-891a-4cd8-9830-6bd60fe35a74"],
 "."
}], "Notes",ExpressionUUID->"05d3ce8f-181d-4fc0-b33a-042ad7fd29f0"],

Cell[TextData[{
 "Each object is divided by its own heaviest mass, so every object reaches \
full strength somewhere. The objects are then summed. At each vertex and edge \
the strength is the sum, capped at ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1315fd8c-4b6c-4855-aed3-c4b5ea322d12"],
 ", and the color is the blend of the objects' colors weighted by their \
masses. Where objects overlap, the figure shows both."
}], "Notes",ExpressionUUID->"1b9daa91-38e7-4eb0-85a0-3fc8ee779663"],

Cell["\<\
A head draws the edges its members use, never the chords of its support. An \
object with one member is drawn as one joined stroke; a family is drawn edge \
by edge.\
\>", "Notes",ExpressionUUID->"eb6649e6-3202-4cf5-b117-eebc70041269"],

Cell[TextData[{
 "The list is read like a ",
 Cell[BoxData["Graphics"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c22376cd-725f-468d-9536-294b2f0ca91e"],
 " list. A ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee2ee528-9ecf-460f-b1a1-2881ad8accfe"],
 " styles every object after it, until the next ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0624f11b-c1b1-45e4-9f52-40eea8fab8d0"],
 ". An entry ",
 Cell[BoxData[
  RowBox[{"obj", " ", "->", " ", "style"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63ac3863-dbf0-473f-bdac-6c64cf7f8833"],
 " styles one object. A color in either replaces the palette color."
}], "Notes",ExpressionUUID->"5f30310b-39f5-4622-8a20-20248560c522"],

