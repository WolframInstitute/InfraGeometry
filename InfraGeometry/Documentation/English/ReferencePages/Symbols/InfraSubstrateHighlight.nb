     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "22f0f36b-8828-4b35-8b7b-b4f8e0547c04"],
     ", ",
     Cell[BoxData["None"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "cadc5c0c-aa71-4588-bf69-a06f70599746"],
     ", a base, or ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"base", ",", " ", "top"}], "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ed74ee56-9884-4a24-84ea-36118e9a656d"]
    }], "TableText",ExpressionUUID->"42416bcf-d24d-48a7-b3f4-cbb689d8129f"], 
    Cell["the substrate's own thickness, top four times it", "TableText",
     ExpressionUUID->"e80fcf6b-b35d-4bff-a1f5-d73a04168441"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "15c689b2-577b-4a74-84f2-d56e485669b8"], Cell[TextData[Cell[
    BoxData["\"\<PointSizeRange\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "21d8ee5d-0229-4c00-89c8-3254bdfe6718"]], "TableText",ExpressionUUID->
     "44a7fefb-b560-4f1c-888e-233d0dd684d1"], Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "aaa0d42a-05d0-43ab-9097-d4ca70d94a72"],
     ", ",
     Cell[BoxData["None"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "22c2793f-a786-4d4c-b641-65ac9f34ed20"],
     ", a base, or ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"base", ",", " ", "top"}], "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "938bf794-22d4-4c0c-86fc-b81989e7ea71"]
    }], "TableText",ExpressionUUID->"199327ee-4dae-4eee-85c2-fd363fc0ebb0"], 
    Cell["the substrate's own vertex size, top three times it", "TableText",
     ExpressionUUID->"1d6d9f53-7c7c-4106-9eab-165801efb3f8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "752aac3d-b64b-4b9c-a15f-a8bae9c00372"], Cell[TextData[Cell[
