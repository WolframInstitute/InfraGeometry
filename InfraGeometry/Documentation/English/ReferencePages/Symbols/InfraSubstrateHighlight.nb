Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ends", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", "3", ",", " ", 
         RowBox[{"\"\<From\>\"", " ", "->", " ", 
          RowBox[{"c", " ", "->", " ", "5"}]}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"InfraSegment", "[", 
          RowBox[{"c", ",", " ", "end"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"end", ",", " ", "ends"}], "}"}]}], "]"}]}], "]"}], ",", 
     " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"ColorData", "[", 
        RowBox[{"112", ",", " ", "\"\<ColorList\>\""}], "]"}], ",", " ", 
       "3"}], "]"}]}], "}"}]}], "]"}]], "Input",
