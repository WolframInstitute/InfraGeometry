Notebook[{

Cell[CellGroupData[{
Cell["InfraSubstrateHighlight", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f3ad3a29-0004-487c-b0fa-2d57e383386f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubstrateHighlight"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["obj1", "TI"], ",", " ", 
      StyleBox["obj2", "TI"], ",", " ", "..."}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "838be07e-84e3-497e-8b94-8247ad470a5b"],
 "\[LineSeparator]",
 "draws the sum of the objects' densities on ",
 StyleBox["g", "TI"],
 ", the ",
 StyleBox["i", "TI"],
 "-th object in the ",
 StyleBox["i", "TI"],
 "-th palette color.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3f2da691-cf26-4fed-af07-47cc1b742adf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubstrateHighlight"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9522c5e8-6aef-443c-8f9c-47fe8c881c4b"],
 "\[LineSeparator]",
 "draws a single object."
}], "Usage",ExpressionUUID->"3d2bdd63-9804-4632-b854-086f24aebd9a"],

Cell[TextData[{
 "This is the only rendering primitive in the paclet. Every viewer and every \
figure calls it. The name follows ",
 Cell[BoxData["HighlightGraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e603b803-cf25-4606-b34d-fb5cdf5ac5cb"],
 "."
}], "Notes",ExpressionUUID->"d4575050-7494-4757-9f8d-a3fc8a7698c2"],

Cell["Every object becomes a vertex density and an edge density:", "Notes",ExpressionUUID->"32a399f1-4f6c-4050-b563-569f99acb58e"],

Cell[TextData[{
 "a vertex, or a density ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", "m"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "462a5fd3-7855-4524-b1ef-867c698aee19"],
 ": its own mass, no edges;"
}], "Notes",ExpressionUUID->"06def722-6347-452e-a6fe-6414fbe396ba"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraWalk", "[", 
   RowBox[{"{", 
    RowBox[{"p1", ",", " ", "...", ",", " ", "pk"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3c5eb40-76a2-4ef1-9396-adcb54099e87"],
 ": visit counts and the traversal counts of its steps;"
}], "Notes",ExpressionUUID->"f9b3a65b-2655-4ead-b44f-f50bf0ab3064"],

Cell[TextData[{
 "a Euclidean head \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "550e1c4b-aa11-4abd-9a4f-3cbd807afad2"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f7858ca1-63e2-41d1-ab83-ca74fb47a532"],
 " and the rest: its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05d682f2-a422-4fe2-99a5-6cdb2a979f97"],
 " and ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25fa92eb-9ebe-4f72-8afa-36533d35bd48"],
 " from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a8743ccf-b4e5-44fd-a7ca-00884766a4f1"],
 ";"
}], "Notes",ExpressionUUID->"384ef1e3-08ec-481e-bf2d-015240fa1491"],

Cell[TextData[{
 "a region head \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1d71a75d-cf16-4c63-93fd-eb889e9d3d9c"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "10292f41-f2bf-4044-86ca-dff24c186b68"],
 " and the rest \[LongDash] or an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ee01b270-7442-4825-8da0-3a7ae6ea12ff"],
 ": its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eab33997-1346-4410-a1e5-4c014136a058"],
 ", no edges;"
}], "Notes",ExpressionUUID->"2a4cc00c-03a7-453a-b167-85dd846e8db2"],

Cell["a walk graph, a cycle graph or a DAG: its occupation;", "Notes",ExpressionUUID->"a373dd5c-2e0c-4619-b6f5-f89698dbbbae"],

Cell["\<\
a leg chain: the walk through its legs, with its knots drawn on top;\
\>", "Notes",ExpressionUUID->"1f1d8af4-3346-4b1a-925b-cf810f004807"],

Cell["\<\
a vertex list that is an induced path or an induced cycle in its own order, \
as every shortest path is: the walk through it;\
\>", "Notes",ExpressionUUID->"d9b5a626-b683-4038-9ac6-908e02ade901"],

Cell[TextData[{
 "any other vertex list: a set, ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7588abc-ec38-4615-a3e8-60c034924113"],
 " on its vertices, no edges;"
}], "Notes",ExpressionUUID->"b55fcde0-0267-49a8-82ba-9566e67bd076"],

Cell[TextData[{
 "an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1d8b8492-bfeb-4a61-a653-b6890ba438a4"],
 " or any other list \[LongDash] of vertex lists, graphs, heads or walks, \
such as the members of a head or a bundle: the sum of its members, drawn in \
one color, with no edges when a member has none."
}], "Notes",ExpressionUUID->"c59fe970-330e-4271-ae25-bf962cd3839b"],

Cell[TextData[{
 "An object with edges is a line, drawn by its edge counts. Any other object \
is drawn as dots, sized by its masses, with the edges between its vertices in \
its color, at the bottom of ",
 Cell[BoxData["\"\<OpacityRange\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9a04fd7-796b-4073-92ce-1b8fad0ce3ff"],
 " and at the base thickness. Where a line uses such an edge, the line's \
stroke wins."
}], "Notes",ExpressionUUID->"fd1f6cda-9b01-413e-9b4a-7874a40a22cf"],

Cell[TextData[{
 "Density ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d0ba5bf-7c97-4323-82c2-cd50155810db"],
 " draws at the base: the substrate's own vertex size and edge thickness, in \
the object's color. Within one object the lightest mass draws at the base and \
the heaviest at the top, by default four times the base for a stroke and \
three times for a dot. An object whose masses are all equal, such as a set, a \
region or a walk that never repeats an edge, looks like the substrate itself, \
colored."
}], "Notes",ExpressionUUID->"36250e1b-12dc-45ea-9fb7-7f6072a20ef9"],

Cell[TextData[{
 "The opacity follows each mass divided by the object's heaviest, along ",
 Cell[BoxData["\"\<OpacityRange\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe83aaf0-7f61-4674-aa4b-46df02bb2319"],
 ". A single walk is opaque, so a walk that reuses edges stays one path, its \
repeated edges thicker."
}], "Notes",ExpressionUUID->"9d15d99c-91a7-4e8d-8959-3a23a6525262"],

Cell["\<\
A density may carry negative masses. A positive mass is a filled dot and a \
negative mass an empty ring of the same size, both in the object's color; \
size and opacity follow the absolute mass, as above. A zero mass is not \
drawn: the vertex keeps the substrate's own style. Edges are not signed.\
\>", "Notes",ExpressionUUID->"3a7ad735-ae20-44bd-b3be-3bca2f1a99f9"],

Cell[TextData[{
 "The objects are then summed. At each vertex and edge the strength is the \
sum, capped at ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f49cf55-660e-4ffe-814a-f5f786e21c6f"],
 ", and the color is the blend of the objects' colors weighted by their \
masses. Where objects overlap, the figure shows both."
}], "Notes",ExpressionUUID->"78f27cb4-4b18-494c-ae62-d700b589e7a4"],

Cell["\<\
A head draws the edges its members use, never the chords of its support. An \
object with one member is drawn as one joined stroke; a family is drawn edge \
by edge.\
\>", "Notes",ExpressionUUID->"65b225b0-5655-45b6-a6d7-7d7eeb912944"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5682df03-b061-428d-82b1-052a9e4ded91"],
 " puts a head on the last vertex of each walk, broader than long, its length \
growing with the stroke under it, black on a light stroke and gold on a dark \
one. An ",
 Cell[BoxData["Arrowheads"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6da12178-f29e-4251-ab22-f1c4bdf813e2"],
 " spec draws that spec instead."
}], "Notes",ExpressionUUID->"64d1afc1-d925-4256-b4ae-6882552269b9"],

Cell[TextData[{
 "The list is read like a ",
 Cell[BoxData["Graphics"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7af7354-feed-48f2-9731-21ffea9275e1"],
 " list. A ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e37f407-be01-44db-a11f-4d543fa5893f"],
 " styles every object after it, until the next ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af7e89d1-2d74-4be7-93d2-222fd7cd37d0"],
 ". An entry ",
 Cell[BoxData[
  RowBox[{"obj", " ", "->", " ", "style"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4407032-78f4-4b2f-9eeb-e4cbcfafead2"],
 " styles one object. A color in either replaces the palette color."
}], "Notes",ExpressionUUID->"497b9f5b-768e-4ad1-884f-d2bc6846c0e4"],

Cell["Options:", "Notes",ExpressionUUID->"cca08ff3-48bd-4ca4-969d-1e4d403f8466"],

