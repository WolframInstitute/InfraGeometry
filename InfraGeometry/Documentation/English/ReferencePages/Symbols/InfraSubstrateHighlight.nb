Cell[CellGroupData[{
Cell["InfraSubstrateHighlight", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"19eeb2f5-bfe5-40b6-b1a2-f2cfc544d294"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubstrateHighlight"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["obj1", "TI"], ",", " ", 
      StyleBox["obj2", "TI"], ",", " ", "..."}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d646478-ded3-4adb-987b-5eca3e32d27c"],
 "\[LineSeparator]",
 "draws the sum of the objects' densities on ",
 StyleBox["g", "TI"],
 ", the ",
 StyleBox["i", "TI"],
 "-th object in the ",
 StyleBox["i", "TI"],
 "-th palette color.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ad42d461-5a81-4477-9be1-b7e43bf076c6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubstrateHighlight"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9a6ff28-f153-43a0-98d2-f66c28894f9d"],
 "\[LineSeparator]",
 "draws a single object."
}], "Usage",ExpressionUUID->"4d7cf73a-5b07-48af-8f71-bddc65f8d10c"],

Cell[TextData[{
 "This is the only rendering primitive in the paclet. Every viewer and every \
figure calls it. The name follows ",
 Cell[BoxData["HighlightGraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19b00d9c-d420-44d6-bbcc-82432caae7c9"],
 "."
}], "Notes",ExpressionUUID->"08ddcd55-a643-49f0-9c4b-84440d97d5a5"],

Cell["Every object becomes a vertex density and an edge density:", "Notes",ExpressionUUID->"c3d7ed12-3707-4767-a606-ba2097019be0"],

Cell[TextData[{
 "a vertex, or a density ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", "m"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3d3345d-809f-4621-94b5-b45bd00b0430"],
 ": its own mass, no edges;"
}], "Notes",ExpressionUUID->"1caa601e-faf8-4a47-9a89-5351fba6ad7d"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraWalk", "[", 
   RowBox[{"{", 
    RowBox[{"p1", ",", " ", "...", ",", " ", "pk"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "983c3e67-1dba-4ca5-abeb-619a477e5905"],
 ": visit counts and the traversal counts of its steps;"
}], "Notes",ExpressionUUID->"b75ddcac-2bfb-4f4b-9826-b7d0dc888327"],

Cell[TextData[{
 "a Euclidean head \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "11d607d6-8623-406f-b17a-3e1fe10924b3"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d08c79be-eb7f-49db-b190-acc6c6bd596b"],
 " and the rest: its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77a9bed4-b9ac-49b7-9827-aba27ac86995"],
 " and ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6ba8c23-450f-4f71-8761-2592c384fef8"],
 " from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8227ea2c-57cd-47b5-8045-81c263b17639"],
 ";"
}], "Notes",ExpressionUUID->"aa583d10-83f9-4e3c-bfe1-bbfd7471f121"],

Cell[TextData[{
 "a region head \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cd78005b-d565-4e31-9cbb-790a83eefdcc"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "09f233d6-792b-4503-a39b-50b593cd070b"],
 " and the rest \[LongDash] or an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d5d88649-853b-44bc-bce3-95dbe0584fd0"],
 ": its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42a56c43-5803-457a-ac6a-f1720e31fb25"],
 ", no edges;"
}], "Notes",ExpressionUUID->"778ae146-874d-4903-b93f-c06573bfbf0f"],

Cell["a walk graph, a cycle graph or a DAG: its occupation;", "Notes",ExpressionUUID->"3d62455a-8251-4297-9026-5b770630f8c7"],

Cell["\<\
a leg chain: the walk through its legs, with its knots drawn on top;\
\>", "Notes",ExpressionUUID->"1ec2353f-ac6c-4e5e-af5d-d34787091616"],

Cell["\<\
a vertex list that is an induced path or an induced cycle in its own order, \
as every geodesic is: the walk through it;\
\>", "Notes",ExpressionUUID->"583d6b09-67a3-4111-ae58-3b2ba1678def"],

Cell[TextData[{
 "any other vertex list: a set, ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50aa3439-4a76-441a-aa18-47d0539be146"],
 " on its vertices, no edges;"
}], "Notes",ExpressionUUID->"612ff19f-7bae-44f3-b17c-15d37482d26c"],

Cell[TextData[{
 "an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1b8540a0-2f73-4c99-ae91-4fd9583ed5b5"],
 " or any other list \[LongDash] of vertex lists, graphs, heads or walks, \
such as the members of a head or a bundle: the sum of its members, drawn in \
one color, with no edges when a member has none."
}], "Notes",ExpressionUUID->"75d67ca0-803c-4106-b421-8c471066fc2e"],

Cell[TextData[{
 "An object with edges is a line, drawn by its edge counts. Any other object \
is drawn as dots, sized by its masses, with the edges between its vertices in \
its color, at the bottom of ",
 Cell[BoxData["\"\<OpacityRange\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb48bd97-32c8-4e43-afe6-9eb29ba47214"],
 " and at the base thickness. Where a line uses such an edge, the line's \
stroke wins."
}], "Notes",ExpressionUUID->"eef308e2-b424-4af9-86aa-6eb2d82e2c01"],

Cell[TextData[{
 "Density ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d9dd18e-5440-4d16-bdfc-823c0f7c8858"],
 " draws at the base: the substrate's own vertex size and edge thickness, in \
the object's color. Within one object the lightest mass draws at the base and \
the heaviest at the top, by default four times the base for a stroke and \
three times for a dot. An object whose masses are all equal, such as a set, a \
region or a walk that never repeats an edge, looks like the substrate itself, \
colored."
}], "Notes",ExpressionUUID->"3f0fbecd-6e4f-4c4d-9b08-453681d5b312"],

Cell[TextData[{
 "The opacity follows each mass divided by the object's heaviest, along ",
 Cell[BoxData["\"\<OpacityRange\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2550bc51-98d4-430b-b3b6-919263db2177"],
 ". A single walk is opaque, so a walk that reuses edges stays one path, its \
repeated edges thicker."
}], "Notes",ExpressionUUID->"9f43bac2-e3fa-47f3-a197-92c3c99e121e"],

Cell["\<\
A density may carry negative masses. A positive mass is a filled dot and a \
negative mass an empty ring of the same size, both in the object's color; \
size and opacity follow the absolute mass, as above. A zero mass is not \
drawn: the vertex keeps the substrate's own style. Edges are not signed.\
\>", "Notes",ExpressionUUID->"c41289c5-f60b-4101-9ce8-e4a6c6bcfa41"],

Cell[TextData[{
 "The objects are then summed. At each vertex and edge the strength is the \
sum, capped at ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d544d6b-f739-4207-b6d0-f90d02afb67f"],
 ", and the color is the blend of the objects' colors weighted by their \
masses. Where objects overlap, the figure shows both."
}], "Notes",ExpressionUUID->"efbbf5fc-0769-497e-af0c-21f055051742"],

Cell["\<\
A head draws the edges its members use, never the chords of its support. An \
object with one member is drawn as one joined stroke; a family is drawn edge \
by edge.\
\>", "Notes",ExpressionUUID->"b3387ce6-1a82-47da-a781-68af95810469"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bf3e79b-5471-497f-a27a-a0e560e07425"],
 " puts a head on the last vertex of each walk, broader than long, its length \
growing with the stroke under it, black on a light stroke and gold on a dark \
one. An ",
 Cell[BoxData["Arrowheads"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48cd1279-6162-4029-834a-7f0c691f9a76"],
 " spec draws that spec instead."
}], "Notes",ExpressionUUID->"058f15ce-8f1e-4884-a8eb-f4532d541417"],

Cell[TextData[{
 "The list is read like a ",
 Cell[BoxData["Graphics"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d474e4c-fec9-45eb-9f4c-fab2d63777ba"],
 " list. A ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86c51a2d-fc1c-420f-a3b0-4da02d04af6b"],
 " styles every object after it, until the next ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee802775-7084-4d37-87dc-eae7e9fc3e1e"],
 ". An entry ",
 Cell[BoxData[
  RowBox[{"obj", " ", "->", " ", "style"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cbd419b-6ebd-4152-afc0-2fe956818237"],
 " styles one object. A color in either replaces the palette color."
}], "Notes",ExpressionUUID->"1ec574ea-6e56-468b-a4ee-ae7a4ba6db2a"],

Cell["Options:", "Notes",ExpressionUUID->"1184ccc2-0881-423e-a573-1ac6d9019977"],

