Cell[TextData[{
 "The difference of two balls is a density too: dots on the first ball, rings \
on the second. Where they overlap the masses cancel to ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "930557fa-750e-4dbc-883f-35737de45c04"],
 ", and a zero mass is not drawn."
}], "ExampleText",ExpressionUUID->"7439a614-7daf-45ac-8b39-984e6a2241a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"a", ",", " ", "3"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"InfraUnion", "[", 
       RowBox[{
        RowBox[{"InfraBall", "[", 
         RowBox[{"a", ",", " ", "3"}], "]"}], ",", " ", 
        RowBox[{"-", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraBall", "[", 
            RowBox[{"b", ",", " ", "3"}], "]"}], ",", 
           " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}], "}"}]}], "]"}]}],
   "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"47736f01-6d2f-4f49-b622-17cb4f459f9c"],

