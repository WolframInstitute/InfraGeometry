Cell["\<\
Two segments from the centre and a walk between their ends, with an arrowhead \
at its end. Where objects meet, their colours blend:\
\>", "ExampleText",ExpressionUUID->"fd2e1785-4be7-4046-b6e7-34552598da53"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "5"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "5"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "5"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraSegment", "[", 
        RowBox[{"c", ",", " ", "p"}], "]"}], ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"c", ",", " ", "q"}], "]"}], ",", " ", 
       RowBox[{"InfraWalk", "[", 
        RowBox[{"RandomInfraSegment", "[", 
         RowBox[{"g", ",", " ", "p", ",", " ", "q", ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], "]"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"209432b4-6556-4ec0-ad6c-8828c46b764d"],

