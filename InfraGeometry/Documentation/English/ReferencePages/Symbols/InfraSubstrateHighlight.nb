Cell[TextData[{
 "A negative mass is an empty ring. The boundary of a walk from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is ",
 StyleBox["q", "TI"],
 " minus ",
 StyleBox["p", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"21d50e4d-1232-4fbf-96c6-061e9c0fec63"],

