Cell[TextData[{
 "The difference of two balls is a density too: dots on the first ball, rings \
on the second. Where they overlap the masses cancel to ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96a60613-e3c1-4666-92f3-4b14e9d80290"],
 ", and a zero mass is not drawn."
}], "ExampleText",ExpressionUUID->"e6f1bd00-f202-4850-966e-e2bc97ec66cb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"a", ",", " ", "3"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"InfraUnion", "[", 
       RowBox[{
        RowBox[{"InfraBall", "[", 
         RowBox[{"a", ",", " ", "3"}], "]"}], ",", " ", 
        RowBox[{"-", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraBall", "[", 
            RowBox[{"b", ",", " ", "3"}], "]"}], ",", 
           " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}], "}"}]}], "]"}]}],
   "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"96970720-96a2-4930-b164-eaf95ad9d50c"],

