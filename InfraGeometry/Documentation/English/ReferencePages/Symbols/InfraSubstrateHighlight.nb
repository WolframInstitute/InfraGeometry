Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"42211913-4d4e-4fb7-9687-4ec6e6e8c51b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubstrateHighlight"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["obj1", "TI"], ",", " ", 
      StyleBox["obj2", "TI"], ",", " ", "..."}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2870bd03-5d9a-4f85-8c9a-1671a6f14b61"],
 "\[LineSeparator]",
 "draws the sum of the objects' densities on ",
 StyleBox["g", "TI"],
 ", the ",
 StyleBox["i", "TI"],
 "-th object in the ",
 StyleBox["i", "TI"],
 "-th palette color.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"65488f76-0324-41d3-9e23-676437905ce7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubstrateHighlight"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cbfcc92-5d4e-4a31-b905-a62880e94f16"],
 "\[LineSeparator]",
 "draws a single object."
}], "Usage",ExpressionUUID->"d5847493-4af5-4795-a283-77c1f56e6733"],

Cell[TextData[{
 "This is the only rendering primitive in the paclet. Every viewer and every \
figure calls it. The name follows ",
 Cell[BoxData["HighlightGraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef5ee468-5352-4d6d-8155-0477f4099a7f"],
 "."
}], "Notes",ExpressionUUID->"c20e880a-524d-403b-8667-98bb75841da5"],

Cell["Every object becomes a vertex density and an edge density:", "Notes",ExpressionUUID->"7f88ba76-79b6-4f22-a147-1d56f9d7da24"],

Cell[TextData[{
 "a vertex, or a density ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", "m"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6893bbdf-39b4-4396-91ac-7bda32a0ca76"],
 ": its own mass, no edges;"
}], "Notes",ExpressionUUID->"de5bd62b-e48f-4054-9662-c7f88b328fdc"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraWalk", "[", 
   RowBox[{"{", 
    RowBox[{"p1", ",", " ", "...", ",", " ", "pk"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f2d37f2-ce82-4107-841e-f1c344a043b8"],
 ": visit counts and the traversal counts of its steps;"
}], "Notes",ExpressionUUID->"af0d21bb-8e02-46cc-b967-2dfd603aeec7"],

Cell[TextData[{
 "a Euclidean head \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b61cb4e8-e218-49ba-8f3f-64cbb0512825"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a1cc19bc-4376-4ecc-a79f-0837218dab26"],
 " and the rest: its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ee06ed1-a385-4aeb-8629-24ed92601908"],
 " and ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f08ae4b7-e459-4509-a794-3c89296c2e32"],
 " from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "34c0190f-e7be-4ce2-884e-6d79193c98fe"],
 ";"
}], "Notes",ExpressionUUID->"f26b2dc4-e5ff-47b9-9e7c-3cbb7625d5da"],

Cell["a walk graph, a cycle graph or a DAG: its occupation;", "Notes",ExpressionUUID->"392ff159-8848-4b13-8d04-d7d8b08413be"],

Cell["\<\
a leg chain: the walk through its legs, with its knots drawn on top;\
\>", "Notes",ExpressionUUID->"d2861ad7-fa4d-4e9e-aad0-b4e1fdea8b8d"],

Cell[TextData[{
 "a vertex list: a region, ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7839897d-5d53-43bd-ba1d-074ded608341"],
 " on its vertices and on the edges of its induced subgraph;"
}], "Notes",ExpressionUUID->"1e4854bf-e0ca-43e9-8781-187c743a89c7"],

Cell["\<\
a list of vertex lists or of graphs, such as the members of a head or a \
bundle: the sum of its members.\
\>", "Notes",ExpressionUUID->"b8a5c827-b1cd-419c-b715-33279bee543e"],

Cell[TextData[{
 "A list of heads or of walks is not one object; give them as separate \
entries, styled alike with a ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e748147f-d947-45eb-aad9-069d668a3632"],
 "."
}], "Notes",ExpressionUUID->"eac8781d-c654-40ef-ad00-537197291b5b"],

Cell[TextData[{
 "Each object is divided by its own heaviest mass, so every object reaches \
full strength somewhere. The objects are then summed. At each vertex and edge \
the strength is the sum, capped at ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7112aa-1add-4769-ac6d-5965cba7533d"],
 ", and the color is the blend of the objects' colors weighted by their \
masses. Where objects overlap, the figure shows both."
}], "Notes",ExpressionUUID->"3826b6d0-a6b9-4970-8474-1520f8b9cdb1"],

Cell["\<\
A head draws the edges its members use, never the chords of its support. An \
object with one member is drawn as one joined stroke; a family is drawn edge \
by edge.\
\>", "Notes",ExpressionUUID->"eb5ae574-9997-47e7-adec-05c8da2a1b66"],

Cell[TextData[{
 "The list is read like a ",
 Cell[BoxData["Graphics"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1711710e-8fcc-44c4-8202-acea8389012e"],
 " list. A ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b7ed9fb-c4fa-45ce-bae7-6a9b6b9827e9"],
 " styles every object after it, until the next ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5617ae0e-9381-4145-92ac-3d1c01011e9e"],
 ". An entry ",
 Cell[BoxData[
  RowBox[{"obj", " ", "->", " ", "style"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eab9cead-ca80-4cd8-a09d-4896fea90c5c"],
 " styles one object. A color in either replaces the palette color."
}], "Notes",ExpressionUUID->"c2a1cc62-0a2d-485d-b1a9-92d8e135a8bd"],

