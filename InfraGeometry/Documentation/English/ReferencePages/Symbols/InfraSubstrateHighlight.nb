Cell["\<\
A list of vertex lists is one object, the sum of its members: here the \
shortest paths of a segment, which draw as the head does.\
\>", "ExampleText",ExpressionUUID->"86b69b0c-8477-4b36-8d5a-7362d533064e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"a", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"RandomInfraSegment", "[", " ", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSegment", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "All"}], " ", 
          "]"}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"InfraSegment", "[", 
          RowBox[{"a", ",", " ", "b"}], "]"}], "}"}]}], "]"}]}], "}"}], 
    "]"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"02086061-cbda-42ea-bab9-8eaa04c18898"],

