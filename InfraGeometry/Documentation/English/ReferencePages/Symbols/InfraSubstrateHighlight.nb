Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "5"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RandomInfraRepresentative", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "3"}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"InfraArc", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "p"}], "}"}], ",", " ", 
         RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "1"}]}], "]"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"458c9758-5e90-41c7-9fbe-81d3e709eb2e"],

