   {Cell["      ", "ModInfo",ExpressionUUID->
     "fcfb8aa8-667f-47bd-92e0-bb2cea8e79ce"], Cell[TextData[Cell[
    BoxData["\"\<ThicknessRange\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "df612d59-7a6e-4611-a1dd-efad3bfce2de"]], "TableText",ExpressionUUID->
