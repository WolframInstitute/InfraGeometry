Cell[CellGroupData[{
Cell["InfraSubstrateHighlight", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"29173eb5-9d99-47e8-a0cc-313b85703a95"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubstrateHighlight"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["obj1", "TI"], ",", " ", 
      StyleBox["obj2", "TI"], ",", " ", "..."}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d37e1fe2-3bfc-430b-992f-28911550b404"],
 "\[LineSeparator]",
 "draws the sum of the objects' densities on ",
 StyleBox["g", "TI"],
 ", the ",
 StyleBox["i", "TI"],
 "-th object in the ",
 StyleBox["i", "TI"],
 "-th palette color.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c71fa582-2996-4dc5-b2f7-ce8c68971c01"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubstrateHighlight"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d6349f7-731c-475b-91b7-4855f3627855"],
 "\[LineSeparator]",
 "draws a single object."
}], "Usage",ExpressionUUID->"34bc2413-8a5e-4d71-a508-eb3db2e474eb"],

Cell[TextData[{
 "This is the only rendering primitive in the paclet. Every viewer and every \
figure calls it. The name follows ",
 Cell[BoxData["HighlightGraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ce26ee6-cb6d-4ecd-a38d-c8e824fac278"],
 "."
}], "Notes",ExpressionUUID->"884942a3-3891-4e5d-b7bb-b6f77d2fc98a"],

Cell["Every object becomes a vertex density and an edge density:", "Notes",ExpressionUUID->"299e8005-0e92-42f6-9b8d-2609cc070cca"],

Cell[TextData[{
 "a vertex, or a density ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", "m"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "328a78a9-ad2e-4e2c-9520-d0b646cd6c47"],
 ": its own mass, no edges;"
}], "Notes",ExpressionUUID->"da81903a-d630-4613-8b31-c7fa33978b61"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraWalk", "[", 
   RowBox[{"{", 
    RowBox[{"p1", ",", " ", "...", ",", " ", "pk"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c988b564-e623-4323-a54d-28c50fdf947c"],
 ": visit counts and the traversal counts of its steps;"
}], "Notes",ExpressionUUID->"879fec6d-098d-4ab3-ba38-49cf9a32b6d4"],

Cell[TextData[{
 "a Euclidean head \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8e4b5a23-e30c-41df-9e55-201667707d08"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2b1b9230-5d88-4738-be59-159ea9bc1698"],
 " and the rest: its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b214b99e-9bb1-4555-a47d-e51ab1100cd9"],
 " and ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "447ef95c-d217-4b2b-a8a8-f8a5d49af8b8"],
 " from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "49d00118-510c-42a2-b2e5-f3fc4e0f5ab6"],
 ";"
}], "Notes",ExpressionUUID->"c02da048-8704-43d8-9afb-fdf28028d37f"],

Cell["a walk graph, a cycle graph or a DAG: its occupation;", "Notes",ExpressionUUID->"8bf7f2c6-a9d1-4cbe-88d0-1b8133c17b61"],

Cell["\<\
a leg chain: the walk through its legs, with its knots drawn on top;\
\>", "Notes",ExpressionUUID->"5989c1f3-ec65-4d90-9ebd-ff635594dbea"],

Cell[TextData[{
 "a vertex list: a region, ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b49b36ab-0fbf-4f6e-8955-76334dd58532"],
 " on its vertices and on the edges of its induced subgraph;"
}], "Notes",ExpressionUUID->"e8b6169f-fad5-432e-b2b6-dd77c988494f"],

Cell["\<\
any other list \[LongDash] of vertex lists, graphs, heads or walks, such as \
the members of a head or a bundle: the sum of its members, drawn in one color.\
\>", "Notes",ExpressionUUID->"3c2aa7a6-2ecd-43e7-8943-a91a701aaa0c"],

Cell[TextData[{
 "Each object is divided by its own heaviest mass, so every object reaches \
full strength somewhere. The objects are then summed. At each vertex and edge \
the strength is the sum, capped at ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4148d25-ab1d-4cfb-9ca6-29c4f26526a9"],
 ", and the color is the blend of the objects' colors weighted by their \
masses. Where objects overlap, the figure shows both."
}], "Notes",ExpressionUUID->"d379200e-2307-46db-958b-702479dfe247"],

Cell["\<\
A head draws the edges its members use, never the chords of its support. An \
object with one member is drawn as one joined stroke; a family is drawn edge \
by edge.\
\>", "Notes",ExpressionUUID->"d2485296-f3ef-4560-835d-4374d13f77e0"],

Cell[TextData[{
 "The list is read like a ",
 Cell[BoxData["Graphics"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e613c574-5625-4475-9c3f-fe77c52ee9e9"],
 " list. A ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f25c2cae-c2bc-41fb-bde9-756bca777376"],
 " styles every object after it, until the next ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c9d40c2-510c-4d1d-8e42-c43424a6c349"],
 ". An entry ",
 Cell[BoxData[
  RowBox[{"obj", " ", "->", " ", "style"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7162bbe2-0c46-4527-8f6f-7c9ce20cf967"],
 " styles one object. A color in either replaces the palette color."
}], "Notes",ExpressionUUID->"2dc67c7b-477b-46a4-a486-25a1a3bd2024"],

