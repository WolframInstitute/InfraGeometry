Notebook[{

Cell[CellGroupData[{
Cell["InfraSubstrateHighlight", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c549bdce-c96b-44b1-bdaf-d5fa90c84939"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubstrateHighlight"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["obj1", "TI"], ",", " ", 
      StyleBox["obj2", "TI"], ",", " ", "..."}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9fe700b8-960d-433b-8ea0-41c0ccd3f04b"],
 "\[LineSeparator]",
 "draws the sum of the objects' densities on ",
 StyleBox["g", "TI"],
 ", the ",
 StyleBox["i", "TI"],
 "-th object in the ",
 StyleBox["i", "TI"],
 "-th palette color.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2eb8ec60-8366-4fec-9f8f-b8d8b09c269d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSubstrateHighlight"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c1ba10d-eaee-4aa0-a498-1eae8a63dc45"],
 "\[LineSeparator]",
 "draws a single object."
}], "Usage",ExpressionUUID->"73a90a65-7733-4dae-a94d-384bb95552cf"],

Cell[TextData[{
 "This is the only rendering primitive in the paclet. Every viewer and every \
figure calls it. The name follows ",
 Cell[BoxData["HighlightGraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3514b817-432b-4f16-991d-3304938bacc3"],
 "."
}], "Notes",ExpressionUUID->"d67c44c6-85a4-426f-9c10-87b13430110c"],

Cell["Every object becomes a vertex density and an edge density:", "Notes",ExpressionUUID->"910fded3-0eb8-4007-98f2-145a966eda52"],

Cell[TextData[{
 "a vertex, or a density ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", "m"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5604b420-485f-4ec7-808c-fccefc4eb34a"],
 ": its own mass, no edges;"
}], "Notes",ExpressionUUID->"aa07925f-069f-4ea5-bbb4-973b4de65ea2"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraWalk", "[", 
   RowBox[{"{", 
    RowBox[{"p1", ",", " ", "...", ",", " ", "pk"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1fc91be-5d61-4928-9cfe-4997c9bfe1c9"],
 ": visit counts and the traversal counts of its steps;"
}], "Notes",ExpressionUUID->"7778006f-d925-4316-a70e-486b839a8379"],

Cell[TextData[{
 "a Euclidean head \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1a564ddc-1977-4964-af19-34d35b84d9e5"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "15f4ac4f-98a9-4188-850c-822222cbdb4a"],
 " and the rest: its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17dadd1e-935c-467d-932c-58445fad9108"],
 " and ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebdc2ba4-3673-4586-b7a8-6e09e57fd493"],
 " from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "90cbd57a-bfdb-432f-8431-a08b0865c277"],
 ";"
}], "Notes",ExpressionUUID->"7fe46b07-1751-4e8c-9908-db5e2ca742e3"],

Cell[TextData[{
 "a region head \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3200be2d-c223-4a55-8d78-9bc999dce78f"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "278811cc-6b75-4d89-987b-c7f3d752ca48"],
 " and the rest \[LongDash] or an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1c05666d-f9ab-4b91-b50e-2412963d4610"],
 ": its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "140c7277-c0ff-49f2-8272-a971029f28c2"],
 ", no edges;"
}], "Notes",ExpressionUUID->"1968f499-f825-45a6-aeca-b77916f5fc5e"],

Cell["a walk graph, a cycle graph or a DAG: its occupation;", "Notes",ExpressionUUID->"eea9e1ad-adc7-4851-8608-bec7587a3678"],

Cell["\<\
a leg chain: the walk through its legs, with its knots drawn on top;\
\>", "Notes",ExpressionUUID->"d6da5fee-25fb-438c-9550-db8be60f21dd"],

Cell["\<\
a vertex list that is an induced path or an induced cycle in its own order, \
as every shortest path is: the walk through it;\
\>", "Notes",ExpressionUUID->"2d3b5e85-6931-4a2f-9fb9-ecf077daddfc"],

Cell[TextData[{
 "any other vertex list: a set, ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4a5a8e9-100b-4e00-9888-3b9738dad550"],
 " on its vertices, no edges;"
}], "Notes",ExpressionUUID->"7fdb8fb3-4d54-4c79-8cfd-db958fef2511"],

Cell[TextData[{
 "an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraUnion"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraUnion", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "92bc28da-0213-4212-9338-ab307b005fe6"],
 " or any other list \[LongDash] of vertex lists, graphs, heads or walks, \
such as the members of a head or a bundle: the sum of its members, drawn in \
one color, with no edges when a member has none."
}], "Notes",ExpressionUUID->"99735fb0-f966-4b50-a3e5-c4e7010f774c"],

Cell[TextData[{
 "An object with edges is a line, drawn by its edge counts. Any other object \
is drawn as dots, sized by its masses, with the edges between its vertices in \
its color, at the bottom of ",
 Cell[BoxData["\"\<OpacityRange\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41970f0a-229c-47c5-bc85-2380345d791c"],
 " and at the base thickness. Where a line uses such an edge, the line's \
stroke wins."
}], "Notes",ExpressionUUID->"71f3d1d3-539e-477b-862e-71bfb5e04dfd"],

Cell[TextData[{
 "Density ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "463332e7-7a74-4293-ac42-9441086b8af3"],
 " draws at the base: the substrate's own vertex size and edge thickness, in \
the object's color. Within one object the lightest mass draws at the base and \
the heaviest at the top, by default four times the base for a stroke and \
three times for a dot. An object whose masses are all equal, such as a set, a \
region or a walk that never repeats an edge, looks like the substrate itself, \
colored."
}], "Notes",ExpressionUUID->"9a740b8a-e063-455f-b94f-9df18c0ddbd0"],

Cell[TextData[{
 "The opacity follows each mass divided by the object's heaviest, along ",
 Cell[BoxData["\"\<OpacityRange\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e38bca2b-1b45-4b36-8324-510ada9a7737"],
 ". A single walk is opaque, so a walk that reuses edges stays one path, its \
repeated edges thicker."
}], "Notes",ExpressionUUID->"b52c2168-d4f2-4824-96a2-04457d5c6f6c"],

Cell["\<\
A density may carry negative masses. A positive mass is a filled dot and a \
negative mass an empty ring of the same size, both in the object's color; \
size and opacity follow the absolute mass, as above. A zero mass is not \
drawn: the vertex keeps the substrate's own style. Edges are not signed.\
\>", "Notes",ExpressionUUID->"69d2cf31-8ea8-4eec-9e4e-856e12462f75"],

Cell[TextData[{
 "The objects are then summed. At each vertex and edge the strength is the \
sum, capped at ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ac5eb54-4f99-407a-85ce-8c13f7fc44ec"],
 ", and the color is the blend of the objects' colors weighted by their \
masses. Where objects overlap, the figure shows both."
}], "Notes",ExpressionUUID->"813c3b5b-95ef-408b-bbcb-7ffef25cea35"],

Cell["\<\
A head draws the edges its members use, never the chords of its support. An \
object with one member is drawn as one joined stroke; a family is drawn edge \
by edge.\
\>", "Notes",ExpressionUUID->"a4da1a98-c7c5-43e3-a4e6-add9faed9903"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28f99d22-f334-4186-a867-0a009468a8c8"],
 " puts a head on the last vertex of each walk, broader than long, its length \
growing with the stroke under it, black on a light stroke and gold on a dark \
one. An ",
 Cell[BoxData["Arrowheads"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bacef14f-9a41-4a47-9086-cb13c4f88de5"],
 " spec draws that spec instead."
}], "Notes",ExpressionUUID->"722f4a9f-726a-4e6e-b6bc-82fac919e30d"],

Cell[TextData[{
 "The list is read like a ",
 Cell[BoxData["Graphics"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3a413b7-48ae-487b-9610-5c1d627afe41"],
 " list. A ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b422cfc-82b1-4912-94ac-810657f9fb42"],
 " styles every object after it, until the next ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d889729a-2362-4518-be5a-17d4dc50d5f9"],
 ". An entry ",
 Cell[BoxData[
  RowBox[{"obj", " ", "->", " ", "style"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0275055c-7538-4925-b629-da59011291a2"],
 " styles one object. A color in either replaces the palette color."
}], "Notes",ExpressionUUID->"6db5a7d2-7a4b-4665-925e-0913a99eb68a"],

Cell["Options:", "Notes",ExpressionUUID->"a9f67b26-70f0-487f-802e-7459d35d9829"],

