    BaseStyle->"Link"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74b22abe-a833-4fd7-b95c-914c6fea16b0"],
 " at a fixed size, any other spec sized and placed as for ",
