Cell["\<\
The difference of two balls: dots on the first, rings on the second, nothing \
where they cancel:\
\>", "ExampleText",ExpressionUUID->"61576241-f32d-4f74-ae5d-9426db970365"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"InfraUnion", "[", 
       RowBox[{
        RowBox[{"InfraBall", "[", 
         RowBox[{"a", ",", " ", "3"}], "]"}], ",", " ", 
        RowBox[{"-", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraBall", "[", 
            RowBox[{"b", ",", " ", "3"}], "]"}], ",", 
           " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}], "}"}], ",", " ", 
     
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6f476c86-258d-4d81-9464-fd444f72a1ad"],

