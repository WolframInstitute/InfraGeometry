Cell[TextData[{
 "A ",
 Cell[BoxData["Directive"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b14bb4b7-10de-4bc8-ae0c-7a88e1399a05"],
 " colors the objects after it."
}], "ExampleText",ExpressionUUID->"7642ee48-d6c8-47bc-9e77-8a7164c7983e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "5"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"FindInfraRepresentative", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "3"}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"InfraArc", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "p"}], "}"}], ",", " ", 
         RowBox[{"\"\<RadiusDelta\>\"", " ", "->", " ", "1"}]}], "]"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5e1d90bc-0fa5-4c55-bf42-0dfc784a64ed"],

