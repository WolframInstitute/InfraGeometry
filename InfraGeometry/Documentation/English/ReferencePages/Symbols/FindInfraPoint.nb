Cell["\<\
Points at the same distance from two anchors: the intersection of two shells, \
here the anti-diagonal of a grid.\
\>", "ExampleText",ExpressionUUID->"9f31ae96-5003-4ab6-a631-90fd0186ab4b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"region", " ", "=", " ", 
     RowBox[{"InfraIntersection", "[", 
      RowBox[{
       RowBox[{"InfraShell", "[", 
        RowBox[{"1", ",", " ", "8"}], "]"}], ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"81", ",", " ", "8"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"FindInfraPoint", "[", 
      RowBox[{"g", ",", " ", "region", ",", " ", "All"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"HighlightGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
