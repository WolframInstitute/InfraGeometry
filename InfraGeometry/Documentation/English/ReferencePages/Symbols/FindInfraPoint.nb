Cell[TextData[{
 Cell[BoxData["\"\<Spread\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d51a1ef7-5e2b-4eef-a7bb-888338104e02"],
 " takes the tuple whose pairwise distances are the most alike: three points \
about the centre."
}], "ExampleText",ExpressionUUID->"9a42af14-f600-4c6f-83b2-72c41a0dbadf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"triple", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "3", ",", " ", 
         RowBox[{"\"\<PairwiseDistance\>\"", " ", "->", 
          " ", "\"\<Spread\>\""}]}], "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "triple"}], "}"}]}], 
      "]"}], ",", " ", "triple"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"a38ab07d-0928-4284-b9ed-e0c309c5ab28"],

