Cell["\<\
One point is a vertex; the calling triple gives a list of them.\
\>", "ExampleText",ExpressionUUID->"e3ea30cc-2ef4-434b-a7d0-736818d40f7d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FindInfraPoint", "[", "g", "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraPoint", "[", 
       RowBox[{"g", ",", " ", "All"}], "]"}]}], ",", " ", 
     RowBox[{"VertexCount", "[", "g", "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0725784e-cefb-4242-bd52-d7e3332fb9b1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"258", ",", "313", ",", "313"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"bda9c80d-3a4a-4451-bba0-487a33ecb756"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5a5ec36-3e2e-4fbf-9ff0-a6b950afcdab"],
 " selects the metrically special vertices. Here the centre is one vertex and \
the periphery is many."
}], "ExampleText",ExpressionUUID->"a556e929-0d1b-4c20-8849-8b07d046ecd5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<centre\>\"", " ", "->", " ", 
      RowBox[{"FindInfraPoint", "[", 
       RowBox[{"g", ",", " ", "All", ",", " ", 
        RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], "]"}]}],
      ",", "\n", "    ", 
     RowBox[{"\"\<periphery count\>\"", " ", "->", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", "All", ",", " ", 
         RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Periphery\>\""}]}], 
        "]"}]}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0a161194-f812-4798-b279-1c6956c4f3e3"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"centre\"\>", "\[Rule]", 
    RowBox[{"{", "1", "}"}]}], ",", 
   RowBox[{"\<\"periphery count\"\>", "\[Rule]", "48"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"1e6edfca-3009-4f3a-ac77-a29d0428e738"]
}, Open  ]],

Cell["\<\
Centre and periphery drawn together. The periphery of a patch is its rim.\
\>", "ExampleText",ExpressionUUID->"db4cae6e-5519-452d-b199-ff328871a455"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"InfraHighlightGraph", "[", 
    RowBox[{"g", ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"FindInfraPoint", "[", 
         RowBox[{"g", ",", " ", "All", ",", " ", 
          RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Periphery\>\""}]}], 
         "]"}], " ", "->", " ", "$InfraShellColor"}], ",", "\n", "     ", 
       RowBox[{
        RowBox[{"FindInfraPoint", "[", 
         RowBox[{"g", ",", " ", "All", ",", " ", 
          RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], "]"}],
         " ", "->", " ", "$InfraPointColor"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "16"}], ",", "\n", 
     "    ", 
     RowBox[{"VertexShapeFunction", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
          RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}], ",",
      "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "340"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[3]:= ",ExpressionUUID->"845a4a06-a7bd-4e2a-bb9f-7ccffae508e6"],

