Cell[CellGroupData[{
Cell["FindInfraPoint", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"31de3b7b-4e0d-49d5-90fa-f226e1da39a8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPoint", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b884d1ce-b7ce-4f1e-905c-c766015442d2"],
 "\[LineSeparator]",
 "gives one point of ",
 StyleBox["g", "TI"],
 ", as a vertex.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e56423bf-8ae4-4962-9798-88430a7ddc08"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPoint", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e3a1c67-2349-4f09-a6b2-053742fd6072"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["n", "TI"],
 " points, as a vertex list. Exactly ",
 StyleBox["n", "TI"],
 " or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e54ed85f-1cbb-43fd-932e-c65a31946845"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e9d8764-08c6-4ae9-8294-2798d61569a6"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b21deffe-4c00-415b-b804-b0b3962ba8d3"],
 " gives every vertex of the pool."
}], "Usage",ExpressionUUID->"c8746d3c-4ef1-41bd-9ab6-84c22bc30d4c"],

Cell[TextData[{
 "Definition: a point of ",
 StyleBox["g", "TI"],
 " drawn from the ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98968394-ed1b-46cf-beb5-fdb3bbe4db7f"],
 " candidate pool."
}], "Notes",ExpressionUUID->"d3aa05bf-23cf-402b-853e-1f8f6c42dd3d"],

Cell[TextData[{
 "The count always means ",
 StyleBox["how many points you get",
  FontWeight->"Bold"],
 "; the ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1aa9d9b-4579-4d88-b7b3-3eb4a21b0a32"],
 " option constrains ",
 StyleBox["which",
  FontWeight->"Bold"],
 " ones. With a distance condition the returned list is therefore one \
mutually-constrained tuple \[LongDash] three points pairwise at maximum \
distance is a joint condition, and a plain vertex list states it without \
ambiguity."
}], "Notes",ExpressionUUID->"ed0020aa-e8c1-4071-9737-86bd146fb398"],

Cell[TextData[{
 "The whole pool is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPoint", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99dc0314-5d21-4f8a-8b14-aae38ea7fda3"],
 ", a vertex list."
}], "Notes",ExpressionUUID->"90f8d3d6-6a82-4935-956a-00db708918aa"],

