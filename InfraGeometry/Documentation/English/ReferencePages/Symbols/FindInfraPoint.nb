Cell["\<\
The distance to a set is the least distance to one of its points: the shell \
about two vertices is the outer layer of the union of the two balls, and does \
not contain the vertices.\
\>", "ExampleText",ExpressionUUID->"6821289e-b6db-4808-b893-e0c9b8cde034"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"10", ",", " ", "10"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"shell", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"45", ",", " ", "47"}], "}"}], ",", " ", "2"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", "shell"}], ",", " ", 
     RowBox[{"MemberQ", "[", 
      RowBox[{"shell", ",", " ", "45"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7a354067-06db-4459-ae8b-e136038a04ae"],

