Cell["\<\
A tuple of three mutually most-distant points comes back as three vertices.\
\>", "ExampleText",ExpressionUUID->"d4ae2ad3-ad70-4994-a37b-dbbf56fb35b2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"FindInfraPoint", "[", 
      RowBox[{"g", ",", " ", "3", ",", " ", 
       RowBox[{"\"\<Distance\>\"", " ", "->", " ", "\"\<Max\>\""}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<count\>\"", " ", "->", " ", 
      RowBox[{"Length", "[", "t", "]"}]}], ",", " ", 
     RowBox[{"\"\<vertices\>\"", " ", "->", " ", "t"}]}], "|>"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"1196a4ce-e13e-4b76-b39e-6d447b697b51"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"count\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"vertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"243", ",", "363", ",", "324"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"29bd18fd-e81f-4d06-83a8-4e587963ffbc"]
}, Open  ]]
}, Open  ]],

