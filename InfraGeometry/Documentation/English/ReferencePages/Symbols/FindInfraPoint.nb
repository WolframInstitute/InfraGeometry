Cell[TextData[{
 Cell[BoxData["\"\<Center\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "015c3053-846d-4a6b-9579-2428f3243e25"],
 " and ",
 Cell[BoxData["\"\<Periphery\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2430bd1-5f50-4177-b0ef-4205e6a5550e"],
 " are meant in the graph-eccentricity sense. ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fce7950e-afe7-465a-a7c4-05107598f820"],
 " imposes a mutual-distance condition on a tuple."
}], "Notes",ExpressionUUID->"b2558d8b-bce3-4819-9154-e84a5cce2b0b"],

Cell[TextData[{
 "To keep a whole construction interior, not just its anchors, cut the \
substrate with ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6809ce3-2790-4a6e-bac5-e497b671dbc4"],
 " (from the DiscreteGeometry paclet) and work on that graph: it is the ball \
of radius ",
 Cell[BoxData[
  RowBox[{"Floor", "[", 
   RowBox[{"q", " ", 
    RowBox[{"GraphRadius", "[", "g", "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b0057f2-724e-4a3d-908d-83101b65b2d7"],
 " about ",
 Cell[BoxData[
  RowBox[{"GraphCenter", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e119dc9e-7970-45e7-8b65-ab0af8e64942"],
 ", carrying the same vertex labels and coordinates, so the result draws on \
the original. Restricting ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e36a1fc-63d1-491f-8546-ec6a422fe1f3"],
 " alone pins only the anchors; a construction with slack spends it outward."
}], "Notes",ExpressionUUID->"bb4ab0c7-ac89-4a79-9617-0a97bbd377ba"],

Cell[TextData[{
 "To narrow a bundle you already hold, use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SelectInfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SelectInfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "68cbc4bc-d00a-4a4b-a2d8-90183ed7cb80"],
 ". It takes the same ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f8fc4be-eb3c-4462-bbd4-1c9d016f41e8"],
 " and ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e9a5c84-14bd-4f2f-9480-dfea441fc278"],
 " vocabulary on a supplied vertex set."
}], "Notes",ExpressionUUID->"59041602-3d39-42cf-a9b4-9a22617a2c24"],

Cell[TextData[{
 "The draw is random: seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb045f96-af51-4aa4-8d1c-bd08172c4552"],
 " before the first call if you need a reproducible figure."
}], "Notes",ExpressionUUID->"3d5fd43b-876d-4f7f-8fb7-a44885839fdc"],

