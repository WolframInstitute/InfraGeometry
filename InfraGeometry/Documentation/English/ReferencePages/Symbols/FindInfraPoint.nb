Cell[TextData[{
 Cell[BoxData["\"\<Center\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f841b86-292f-4bfd-90f2-cf76844a0444"],
 " and ",
 Cell[BoxData["\"\<Periphery\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2260fc51-497c-4d0b-8521-62c88b0af8a7"],
 " are meant in the graph-eccentricity sense. ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8a83453-ffd8-44f0-99fa-d73d257da354"],
 " imposes a mutual-distance condition on a tuple."
}], "Notes",ExpressionUUID->"31157f67-a7c6-4a6c-aa14-d6d225d70552"],

Cell[TextData[{
 "To keep a whole construction interior, not just its anchors, cut the \
substrate with ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58993216-b91f-48ab-85d1-980c6c635bd1"],
 " (from the DiscreteGeometry paclet) and work on that graph: it is the ball \
of radius ",
 Cell[BoxData[
  RowBox[{"Floor", "[", 
   RowBox[{"q", " ", 
    RowBox[{"GraphRadius", "[", "g", "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e99a6898-21c3-4756-802c-6b7fbf3b0cd7"],
 " about ",
 Cell[BoxData[
  RowBox[{"GraphCenter", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ecc9781-8110-48e1-bec6-066a065367e2"],
 ", carrying the same vertex labels and coordinates, so the result draws on \
the original. Restricting ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19620a85-c86d-4b2c-82e7-9ea57abde549"],
 " alone pins only the anchors; a construction with slack spends it outward."
}], "Notes",ExpressionUUID->"c2d58d1b-be81-42aa-adfc-bea1ba85d584"],

Cell[TextData[{
 "To narrow a bundle you already hold, use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SelectInfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SelectInfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c17145b6-7eb8-4c78-b63b-3330bdc3c5f9"],
 ". It takes the same ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc3c14a1-68a1-4abd-b440-e0bd6abf01da"],
 " and ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "982fe22e-6812-4d46-8421-e6e90f597dd8"],
 " vocabulary on a supplied vertex set."
}], "Notes",ExpressionUUID->"9e495c43-06a2-42fe-b5be-a6e91eeac07d"],

Cell[TextData[{
 "The draw is random: seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31f12635-47a9-4b93-87e8-4d9edfd96080"],
 " before the first call if you need a reproducible figure."
}], "Notes",ExpressionUUID->"46fdd74a-2339-4f2c-a6f8-dd3303d2920b"],

