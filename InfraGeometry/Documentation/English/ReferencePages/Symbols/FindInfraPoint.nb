Cell[TextData[{
 Cell[BoxData["\"\<Center\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "167c55d6-a0a0-4712-879b-5851eb66e097"],
 " and ",
 Cell[BoxData["\"\<Periphery\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c51ee2b2-c665-4373-a8f6-89a263eee039"],
 " are meant in the graph-eccentricity sense. ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43ffa9d3-bc2b-470f-a81f-46dd936b3280"],
 " imposes a mutual-distance condition on a tuple."
}], "Notes",ExpressionUUID->"fa95f7f3-a4b7-4ca8-8abe-6c5ea76590db"],

Cell[TextData[{
 "To keep a whole construction interior, not just its anchors, cut the \
substrate with ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a51e7383-3014-40ad-8268-df226144d133"],
 " (from the DiscreteGeometry paclet) and work on that graph: it is the ball \
of radius ",
 Cell[BoxData[
  RowBox[{"Floor", "[", 
   RowBox[{"q", " ", 
    RowBox[{"GraphRadius", "[", "g", "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea1433fe-2ff5-4c43-b77c-6dac8150f440"],
 " about ",
 Cell[BoxData[
  RowBox[{"GraphCenter", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80001f5b-58d1-409c-af0d-f8a8a1e18e34"],
 ", carrying the same vertex labels and coordinates, so the result draws on \
the original. Restricting ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58790e9c-c264-4900-b210-2fb2555db4d5"],
 " alone pins only the anchors; a construction with slack spends it outward."
}], "Notes",ExpressionUUID->"cd461bb8-865a-4ac8-a449-81b3c61631f7"],

Cell[TextData[{
 "To narrow a bundle you already hold, use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SelectInfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SelectInfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b2432ee2-a891-41fa-af0e-593fb6c65bbd"],
 ". It takes the same ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbcdafb4-94c4-41e7-a520-6c27e8511868"],
 " and ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34c1d944-b6fd-4ed1-85aa-93fec457b47c"],
 " vocabulary on a supplied vertex set."
}], "Notes",ExpressionUUID->"2a3888cd-68da-416e-aa24-abd7f4e77c99"],

Cell[TextData[{
 "The draw is random: seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b527113-40ca-4492-b590-18f23a90eab4"],
 " before the first call if you need a reproducible figure."
}], "Notes",ExpressionUUID->"27f99afa-b1dc-4c27-b71e-bd0e7ded4c5d"],

