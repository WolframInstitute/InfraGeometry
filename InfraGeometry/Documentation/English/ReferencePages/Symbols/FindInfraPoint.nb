Cell[TextData[{
 "Any inert head that ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["reg", "TI"], ",", " ", "\"\<VertexDensity\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a0dac9c-a248-4060-acd0-8fc86f922642"],
 " reads is a region. A single vertex is ",
 Cell[BoxData[
  RowBox[{"{", "v", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1553c3d3-904a-4168-a903-3e07a8e80923"],
 ", never bare: a bare integer is a count."
}], "Notes",ExpressionUUID->"16653313-a5a6-435e-ab59-18328e04910d"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " is ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e978dc9-dabb-4072-a3ad-755acb2ae3dc"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15df966a-b326-4235-b8eb-d0aefc4d3a02"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5db7fd6-b676-472d-b454-2822f9a1fdb1"],
 ". The ",
 StyleBox["n", "TI"],
 " points are distinct. ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6800bb48-8980-45de-913b-6f441889a10a"],
 " gives at most ",
 StyleBox["n", "TI"],
 ", ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c2107e4-0a89-4fa6-81f6-4c599821255d"],
 " gives every vertex of the region. Without ",
 StyleBox["n", "TI"],
 " the result is one vertex, not a list."
}], "Notes",ExpressionUUID->"6137c415-0451-4dbc-829c-ed199f3c7738"],

Cell[TextData[{
 "An empty region gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e00ddbeb-a7cc-43fc-9e36-3132ad659e65"],
 ". So does a region with fewer than ",
 StyleBox["n", "TI"],
 " vertices."
}], "Notes",ExpressionUUID->"8a4a4c70-b25c-4603-9a97-9c789d17dea3"],

Cell[TextData[{
 "The distance from a vertex to a set ",
 StyleBox["C", "TI"],
 " is ",
 StyleBox["d(v, C) = min d(v, c)", "TI"],
 " over ",
 StyleBox["c", "TI"],
 " in ",
 StyleBox["C", "TI"],
 ". So ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["c1", "TI"], ",", " ", 
      StyleBox["c2", "TI"]}], "}"}], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93631c6a-0c62-4506-b885-37604b0bed2c"],
 " is the union of the two balls, and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["c1", "TI"], ",", " ", 
      StyleBox["c2", "TI"]}], "}"}], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c0e3478-05b4-4149-bdc8-53f927d732c9"],
 " is the outer layer of that union."
}], "Notes",ExpressionUUID->"3bd16930-27dd-4c79-9339-5bdca4b022ef"],

Cell["Options:", "Notes",ExpressionUUID->"ce2e6121-1432-4347-889c-d3cb76798fed"],

