Cell["\<\
One point is a vertex; the calling triple gives a list of them.\
\>", "ExampleText",ExpressionUUID->"b9546783-5494-4bbe-bfa1-44a90c4be951"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FindInfraPoint", "[", "g", "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraPoint", "[", 
       RowBox[{"g", ",", " ", "All"}], "]"}]}], ",", " ", 
     RowBox[{"VertexCount", "[", "g", "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9f072766-41c7-4ece-a1c8-16e009eebcc3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"258", ",", "313", ",", "313"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6fc81a0d-6030-43c4-8c4f-f75224a8102c"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5615cbb2-5cc3-4681-9d3f-905f2295eb80"],
 " selects the metrically special vertices. Here the centre is one vertex and \
the periphery is many."
}], "ExampleText",ExpressionUUID->"31367845-afac-461a-990e-2dafb9a4d286"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<centre\>\"", " ", "->", " ", 
      RowBox[{"FindInfraPoint", "[", 
       RowBox[{"g", ",", " ", "All", ",", " ", 
        RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], "]"}]}],
      ",", "\n", "    ", 
     RowBox[{"\"\<periphery count\>\"", " ", "->", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", "All", ",", " ", 
         RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Periphery\>\""}]}], 
        "]"}]}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5fa265d6-5c1f-4284-97ed-5670d583ba3b"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"centre\"\>", "\[Rule]", 
    RowBox[{"{", "1", "}"}]}], ",", 
   RowBox[{"\<\"periphery count\"\>", "\[Rule]", "48"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"8ec916c9-8c75-4c67-93c6-6608c4b0b741"]
}, Open  ]],

Cell["\<\
Centre and periphery drawn together. The periphery of a patch is its rim.\
\>", "ExampleText",ExpressionUUID->"c5a02069-91b6-4a9b-9853-4735702d5592"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"FindInfraPoint", "[", 
         RowBox[{"g", ",", " ", "All", ",", " ", 
          RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Periphery\>\""}]}], 
         "]"}], " ", "->", " ", "$InfraShellColor"}], ",", "\n", "     ", 
       RowBox[{
        RowBox[{"FindInfraPoint", "[", 
         RowBox[{"g", ",", " ", "All", ",", " ", 
          RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], "]"}],
         " ", "->", " ", "$InfraPointColor"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "16"}], ",", "\n", 
     "    ", 
     RowBox[{"VertexShapeFunction", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
          RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}], ",",
      "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "340"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[3]:= ",ExpressionUUID->"f49bf10d-cb3e-4750-87f6-e1f11becce84"],

