Cell[TextData[{
 Cell[BoxData["\"\<PairwiseDistance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65e60b16-668e-4612-b972-ea996d96993a"],
 " takes a distance: two points at distance 4 from each other."
}], "ExampleText",ExpressionUUID->"c4611bda-79b1-4f60-bb60-ed6e89a5d88e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"pair", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", "2", ",", " ", 
         RowBox[{"\"\<PairwiseDistance\>\"", " ", "->", " ", "4"}]}], "]"}]}],
       ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", "pair", "}"}]}], "]"}], ",", " ", 
     RowBox[{"GraphDistance", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"First", " ", "@", " ", "pair"}], ",", " ", 
       RowBox[{"Last", " ", "@", " ", "pair"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"246393a6-fe69-4055-9295-34615150e129"],

