Cell[TextData[{
 "Keeping a draw off the rim. The balls are a nested family, so ",
 Cell[BoxData["q"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d362a78-beb9-468e-9e06-84ac6e7c8c44"],
 " reads directly as the fraction of the way out a point is allowed to sit."
}], "ExampleText",ExpressionUUID->"30ece636-1419-4069-b379-05e74f8298d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"VertexList", " ", "@", " ", 
        RowBox[{"CenterGraph", "[", 
         RowBox[{"g", ",", " ", "0.8"}], "]"}]}], ",", "\n", "     ", 
       RowBox[{"VertexList", " ", "@", " ", 
        RowBox[{"CenterGraph", "[", 
         RowBox[{"g", ",", " ", "0.4"}], "]"}]}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"f9d2886d-080e-4892-8937-22aaf14724f3"],

