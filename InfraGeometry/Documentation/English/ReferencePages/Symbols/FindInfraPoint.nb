Cell[TextData[{
 Cell[BoxData["\"\<Center\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21d55eba-ce7c-4e3e-938a-0333cbdc0ca2"],
 " and ",
 Cell[BoxData["\"\<Periphery\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d1867d0-4e37-4e82-a409-97a2cab52c09"],
 " are meant in the graph-eccentricity sense. ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "296f418e-8965-4cfd-88d6-1c8f031eac2b"],
 " imposes a mutual-distance condition on a tuple."
}], "Notes",ExpressionUUID->"ddcc4796-d1fa-4e20-a499-f7a298a81d94"],

Cell[TextData[{
 "To keep a whole construction interior, not just its anchors, cut the \
substrate with ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cef7d20c-21ec-4ec2-a434-ff0cc3fd483d"],
 " (from the Infrageometry paclet) and work on that graph: it is the ball of \
radius ",
 Cell[BoxData[
  RowBox[{"Floor", "[", 
   RowBox[{"q", " ", 
    RowBox[{"GraphRadius", "[", "g", "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b37cfa3b-7e96-4ca0-ab22-b695c4374c38"],
 " about ",
 Cell[BoxData[
  RowBox[{"GraphCenter", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a659675-835d-4731-ab7a-03b08f2ae16c"],
 ", carrying the same vertex labels and coordinates, so the result draws on \
the original. Restricting ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6b8452a-5d8a-4f59-a7c3-a957c54536fd"],
 " alone pins only the anchors; a construction with slack spends it outward."
}], "Notes",ExpressionUUID->"3233ed5a-effa-4bcb-b78d-5a191e97f7f1"],

Cell[TextData[{
 "To narrow a bundle you already hold, use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SelectInfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SelectInfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "af3d508c-d5b7-4b93-af8d-697184895d53"],
 ". It takes the same ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43de13a4-4857-4d4a-8a1d-b59ce181cc14"],
 " and ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8996011-0175-4aa9-8638-64b6f6552a47"],
 " vocabulary on a supplied vertex set."
}], "Notes",ExpressionUUID->"360eaa80-70eb-402e-b3d5-5f92c71dc252"],

Cell[TextData[{
 "The draw is random: seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c53b5a0-63b5-488b-bf57-187856cff7cd"],
 " before the first call if you need a reproducible figure."
}], "Notes",ExpressionUUID->"6e6a3c7e-aa53-4369-a289-eeacd4eb23b2"],

