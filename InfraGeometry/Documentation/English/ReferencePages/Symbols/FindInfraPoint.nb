Cell["\<\
A tuple of three mutually most-distant points comes back as three vertices.\
\>", "ExampleText",ExpressionUUID->"ce73fee4-0f49-4167-b5dc-d6cdc9a21148"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"FindInfraPoint", "[", 
      RowBox[{"g", ",", " ", "3", ",", " ", 
       RowBox[{"\"\<Distance\>\"", " ", "->", " ", "\"\<Max\>\""}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<count\>\"", " ", "->", " ", 
      RowBox[{"Length", "[", "t", "]"}]}], ",", " ", 
     RowBox[{"\"\<vertices\>\"", " ", "->", " ", "t"}]}], "|>"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"9131d77e-a523-4ebf-b472-370b49ccdcb6"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"count\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"vertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"243", ",", "363", ",", "324"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"be4c9283-ebcb-4069-8aa4-79e7f9c07366"]
}, Open  ]]
}, Open  ]],

