Cell[TextData[{
 "Keeping a draw off the rim. The balls are a nested family, so ",
 Cell[BoxData["q"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b04c694-7b6e-4374-bfd8-7c5b95629c3a"],
 " reads directly as the fraction of the way out a point is allowed to sit."
}], "ExampleText",ExpressionUUID->"224d9d4b-a0fa-4e4c-892f-8fa1fa4c49ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"InfraHighlightGraph", "[", 
    RowBox[{"g", ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"VertexList", " ", "@", " ", 
         RowBox[{"CenterGraph", "[", 
          RowBox[{"g", ",", " ", "0.8"}], "]"}]}], " ", "->", " ", 
        "$InfraShellColor"}], ",", "\n", "     ", 
       RowBox[{
        RowBox[{"VertexList", " ", "@", " ", 
         RowBox[{"CenterGraph", "[", 
          RowBox[{"g", ",", " ", "0.4"}], "]"}]}], " ", "->", " ", 
        "$InfraPointColor"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "16"}], ",", "\n", 
     "    ", 
     RowBox[{"VertexShapeFunction", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
          RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}], ",",
      "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "340"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[4]:= ",ExpressionUUID->"7d938409-9458-4480-bf72-25a2dede6a61"],

