Cell[TextData[{
 Cell[BoxData["\"\<Center\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41dfe6d0-aebf-4a44-acd3-ee549aa22858"],
 " and ",
 Cell[BoxData["\"\<Periphery\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05743480-421c-4aaf-9a43-75b55a3cf99e"],
 " are meant in the graph-eccentricity sense. ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dce5f8d8-45d0-490f-afd8-bd51f4f1d9b8"],
 " imposes a mutual-distance condition on a tuple."
}], "Notes",ExpressionUUID->"74636379-1cd9-4a7a-aa7d-2dfa96a430e4"],

Cell[TextData[{
 "To keep a whole construction interior, not just its anchors, cut the \
substrate with ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e33a41e-ddbd-45d0-bfd5-61a1f5efddda"],
 " (from the DiscreteGeometry paclet) and work on that graph: it is the ball \
of radius ",
 Cell[BoxData[
  RowBox[{"Floor", "[", 
   RowBox[{"q", " ", 
    RowBox[{"GraphRadius", "[", "g", "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e958a9f-6c5d-4c49-8044-a85c2fe04587"],
 " about ",
 Cell[BoxData[
  RowBox[{"GraphCenter", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b9d2a3c-792b-4a48-a493-49c6871dd9f8"],
 ", carrying the same vertex labels and coordinates, so the result draws on \
the original. Restricting ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dbd80b0-07b2-45aa-94d3-0d0505d48985"],
 " alone pins only the anchors; a construction with slack spends it outward."
}], "Notes",ExpressionUUID->"cef130d5-817c-4491-a2e0-004283b7f8ad"],

Cell[TextData[{
 "To narrow a bundle you already hold, use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SelectInfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SelectInfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "86e239ad-01b0-492c-b506-e5373a3207fd"],
 ". It takes the same ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2e35175-c3a8-491f-b112-72ef974aa4b8"],
 " and ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "111f75d6-8be0-4759-9589-ae28a4c08723"],
 " vocabulary on a supplied vertex set."
}], "Notes",ExpressionUUID->"a64bd133-a151-495b-bae0-be882f1b54c6"],

Cell[TextData[{
 "The draw is random: seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "143fa341-49df-4ed2-a932-76311134ae20"],
 " before the first call if you need a reproducible figure."
}], "Notes",ExpressionUUID->"0e37a1ae-5631-442d-969f-6ca2085acc4f"],

