Cell["A tuple of three mutually most-distant points.", "ExampleText",ExpressionUUID->"4bb3406d-0970-4553-8fe0-2b811a3f5489"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", "3", ",", " ", 
         RowBox[{"\"\<Distance\>\"", " ", "->", " ", "\"\<Max\>\""}]}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", "corners", "}"}]}], "]"}], ",", " ", "corners"}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"826b6cc3-5666-43e5-a1a6-70c3e50f056c"],

