Cell["\<\
One point is a vertex; the calling triple gives a list of them.\
\>", "ExampleText",ExpressionUUID->"b757bb6c-4268-48db-ba85-ce6a0a3ca060"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FindInfraPoint", "[", "g", "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraPoint", "[", 
       RowBox[{"g", ",", " ", "All"}], "]"}]}], ",", " ", 
     RowBox[{"VertexCount", "[", "g", "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e50a4a2a-3397-481a-9704-9d4687db63a0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"258", ",", "313", ",", "313"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2137cb77-3305-4c00-a172-81a9eeb2532d"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "792925a9-5a3d-4daf-90d4-540dbd859c97"],
 " selects the metrically special vertices. Here the centre is one vertex and \
the periphery is many."
}], "ExampleText",ExpressionUUID->"b02e5b66-2eed-4e4f-91b8-9e588f0cfdcf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<centre\>\"", " ", "->", " ", 
      RowBox[{"FindInfraPoint", "[", 
       RowBox[{"g", ",", " ", "All", ",", " ", 
        RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], "]"}]}],
      ",", "\n", "    ", 
     RowBox[{"\"\<periphery count\>\"", " ", "->", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", "All", ",", " ", 
         RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Periphery\>\""}]}], 
        "]"}]}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3ea39355-d750-491a-a452-d52aff3aefb4"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"centre\"\>", "\[Rule]", 
    RowBox[{"{", "1", "}"}]}], ",", 
   RowBox[{"\<\"periphery count\"\>", "\[Rule]", "48"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"43a55cc1-53dd-41d1-87e9-4cde74bc92bb"]
}, Open  ]],

Cell["\<\
Centre and periphery drawn together. The periphery of a patch is its rim.\
\>", "ExampleText",ExpressionUUID->"db46415f-981d-4bb3-941e-c3fa53a4d5a8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"InfraHighlightGraph", "[", 
    RowBox[{"g", ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"FindInfraPoint", "[", 
         RowBox[{"g", ",", " ", "All", ",", " ", 
          RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Periphery\>\""}]}], 
         "]"}], " ", "->", " ", "$InfraShellColor"}], ",", "\n", "     ", 
       RowBox[{
        RowBox[{"FindInfraPoint", "[", 
         RowBox[{"g", ",", " ", "All", ",", " ", 
          RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], "]"}],
         " ", "->", " ", "$InfraPointColor"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "16"}], ",", "\n", 
     "    ", 
     RowBox[{"VertexShapeFunction", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
          RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}], ",",
      "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "340"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[3]:= ",ExpressionUUID->"849eed0c-19f3-41ab-a0bb-af6a7642a892"],

