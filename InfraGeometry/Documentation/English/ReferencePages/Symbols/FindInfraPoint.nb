Cell[TextData[{
 Cell[BoxData["\"\<Center\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbbf47f6-e6fa-4a5e-9508-94654b609c52"],
 " and ",
 Cell[BoxData["\"\<Periphery\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff1fd677-5c57-4c60-ac18-ca2a98ae2c11"],
 " are meant in the graph-eccentricity sense. ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9880b20-a1d7-42b3-8c97-78da089acea5"],
 " imposes a mutual-distance condition on a tuple."
}], "Notes",ExpressionUUID->"b6f9b882-c29c-42dc-88bc-26911c504681"],

Cell[TextData[{
 "To keep a whole construction interior, not just its anchors, cut the \
substrate with ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b26ad437-a542-4b7e-b7a8-b4874bb64bbc"],
 " (from the DiscreteGeometry paclet) and work on that graph: it is the ball \
of radius ",
 Cell[BoxData[
  RowBox[{"Floor", "[", 
   RowBox[{"q", " ", 
    RowBox[{"GraphRadius", "[", "g", "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a23a17db-2084-49a6-8ffc-bfc18e98128f"],
 " about ",
 Cell[BoxData[
  RowBox[{"GraphCenter", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "faa0552c-9932-4b2d-a503-58a5b398d1da"],
 ", carrying the same vertex labels and coordinates, so the result draws on \
the original. Restricting ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00ad846e-991b-4781-8b5c-c5bad0c926af"],
 " alone pins only the anchors; a construction with slack spends it outward."
}], "Notes",ExpressionUUID->"fc251998-b6e3-48f2-8aa4-179939328d46"],

Cell[TextData[{
 "To narrow a bundle you already hold, use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SelectInfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SelectInfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3d0cde4b-0a71-49a6-93cc-e49d3bc138dc"],
 ". It takes the same ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "827744b5-0226-4618-94b5-8daa14781227"],
 " and ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b823f33e-26aa-44f1-be4b-0718fa8f50e2"],
 " vocabulary on a supplied vertex set."
}], "Notes",ExpressionUUID->"e541eabd-0e78-4b40-9f9c-5bab144b9b00"],

Cell[TextData[{
 "The draw is random: seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71e8db18-3d23-40b5-b0db-b0c71fe41d37"],
 " before the first call if you need a reproducible figure."
}], "Notes",ExpressionUUID->"e7c996a5-04a1-4e6f-a929-fe74cefa6dbb"],

