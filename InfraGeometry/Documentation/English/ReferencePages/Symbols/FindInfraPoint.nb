Cell[TextData[{
 Cell[BoxData["\"\<Center\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98b4ccb8-d672-4826-bd41-f790edeae04e"],
 " and ",
 Cell[BoxData["\"\<Periphery\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b36e27e8-08be-42b3-808b-e65a9c512174"],
 " are meant in the graph-eccentricity sense. ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2a1ff24-211d-4ebb-b284-6159d19baf66"],
 " imposes a mutual-distance condition on a tuple."
}], "Notes",ExpressionUUID->"2bd3c343-e28c-434b-9c6a-19f13cdd4b51"],

Cell[TextData[{
 "To keep a whole construction interior, not just its anchors, cut the \
substrate with ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd7649c1-56c9-42b8-afd9-c787089fd904"],
 " (from the DiscreteGeometry paclet) and work on that graph: it is the ball \
of radius ",
 Cell[BoxData[
  RowBox[{"Floor", "[", 
   RowBox[{"q", " ", 
    RowBox[{"GraphRadius", "[", "g", "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50a0f67c-f9c3-4f17-956d-28d23254bed7"],
 " about ",
 Cell[BoxData[
  RowBox[{"GraphCenter", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023cd34a-711c-4217-bc5b-10af2af376fb"],
 ", carrying the same vertex labels and coordinates, so the result draws on \
the original. Restricting ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e762dba6-9d18-459d-943e-08f35261b91f"],
 " alone pins only the anchors; a construction with slack spends it outward."
}], "Notes",ExpressionUUID->"4a62862c-fb22-4833-8369-3da617f6d11a"],

Cell[TextData[{
 "To narrow a bundle you already hold, use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SelectInfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SelectInfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "41e7bb41-9645-45c0-b30b-e3af5589a775"],
 ". It takes the same ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9105169e-c9f0-4052-abc2-fb9170dbed0d"],
 " and ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b26ac40-9fcb-4093-975d-52551783e96f"],
 " vocabulary on a supplied vertex set."
}], "Notes",ExpressionUUID->"d0c4dc58-1108-4300-9355-9bf6155b976c"],

Cell[TextData[{
 "The draw is random: seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6ec2663-3a6c-43bc-9d35-d7ed9546990d"],
 " before the first call if you need a reproducible figure."
}], "Notes",ExpressionUUID->"61f2955a-c608-46b3-8c46-8d841f93f3f7"],

