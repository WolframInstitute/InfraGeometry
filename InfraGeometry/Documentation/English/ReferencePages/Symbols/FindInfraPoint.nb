Cell["\<\
A tuple of three mutually most-distant points comes back as three vertices.\
\>", "ExampleText",ExpressionUUID->"41acf913-308a-45ce-90c0-d71cc6991f8c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"FindInfraPoint", "[", 
      RowBox[{"g", ",", " ", "3", ",", " ", 
       RowBox[{"\"\<Distance\>\"", " ", "->", " ", "\"\<Max\>\""}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<count\>\"", " ", "->", " ", 
      RowBox[{"Length", "[", "t", "]"}]}], ",", " ", 
     RowBox[{"\"\<vertices\>\"", " ", "->", " ", "t"}]}], "|>"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"f487f0b9-4528-49ac-8e9f-51fe763d96aa"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"count\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"vertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"243", ",", "363", ",", "324"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"c9fbb7e0-e5fe-466a-981c-7fd0e51d6f71"]
}, Open  ]]
}, Open  ]],

