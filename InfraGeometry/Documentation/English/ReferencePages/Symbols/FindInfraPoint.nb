Cell[TextData[{
 Cell[BoxData["\"\<Center\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be774c35-d5e9-47f0-ac77-715175bf3e6f"],
 " and ",
 Cell[BoxData["\"\<Periphery\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25447bbc-e628-48d0-89b5-5e73d71a4c57"],
 " are meant in the graph-eccentricity sense. ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23af9f00-d4f6-49b3-9a22-df376dc22aae"],
 " imposes a mutual-distance condition on a tuple."
}], "Notes",ExpressionUUID->"9baa53d1-3b7d-4461-8959-cfffe7e0a87c"],

Cell[TextData[{
 "To keep a whole construction interior, not just its anchors, cut the \
substrate with ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", "k"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f36da825-eebf-4f7f-a262-65e75b949aa9"],
 " and work on that graph: it is the ball of ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f934ce17-a22d-48f2-96a1-3579f27f3321"],
 " hops about ",
 Cell[BoxData[
  RowBox[{"GraphCenter", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ec27924-5f1a-4653-821f-1f57450198e2"],
 ", a negative ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8531e3a0-498b-4b18-8e39-4d0c33c67f06"],
 " counting back from the radius and ",
 Cell[BoxData[
  RowBox[{"Scaled", "[", "q", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99f0cc31-34a8-42a2-96f2-1598069e2f3c"],
 " taking the fraction ",
 Cell[BoxData["q"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "887d7748-44ba-4a1c-9b36-ba67867b94e7"],
 " of it, and it carries the same vertex labels and coordinates, so the \
result draws on the original. Restricting ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc3d4f6e-3ce2-41f1-be4c-354df137ad2b"],
 " alone pins only the anchors; a construction with slack spends it outward."
}], "Notes",ExpressionUUID->"61c9ff16-6906-4a8b-87f3-25f83e80feda"],

Cell[TextData[{
 "To narrow a bundle you already hold, use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SelectInfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SelectInfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e6302f72-de56-43d9-8432-12837b0699e5"],
 ". It takes the same ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33f2abed-e2ed-45f8-9568-c4c25bef4c0a"],
 " and ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f586cc5a-9dfc-41ff-b470-325a0925be75"],
 " vocabulary on a supplied vertex set."
}], "Notes",ExpressionUUID->"6cd84af2-c29d-431f-8311-27517bad82bc"],

Cell[TextData[{
 "The draw is random: seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea14f1c6-bb36-40c8-90fd-fa361b279607"],
 " before the first call if you need a reproducible figure."
}], "Notes",ExpressionUUID->"8398cd7b-e7a5-45e1-9601-c51565e41eef"],

