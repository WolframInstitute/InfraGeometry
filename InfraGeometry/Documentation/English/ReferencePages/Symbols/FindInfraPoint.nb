Cell["\<\
The distance to a set is the least distance to one of its points: the shell \
about two vertices is the outer layer of the union of the two balls, and does \
not contain the vertices.\
\>", "ExampleText",ExpressionUUID->"4f644a69-7cc5-45b9-9931-7eca5823c706"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"10", ",", " ", "10"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"shell", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"45", ",", " ", "47"}], "}"}], ",", " ", "2"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", "shell"}], ",", " ", 
     RowBox[{"MemberQ", "[", 
      RowBox[{"shell", ",", " ", "45"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c00157e9-84ec-4203-91ba-b4eed4a611cd"],

