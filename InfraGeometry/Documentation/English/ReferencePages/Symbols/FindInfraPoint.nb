Cell[TextData[{
 "Keeping a draw off the rim. The balls about the centre are nested: ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f15cc9f-8271-412e-93e0-382c7fddb1af"],
 " drops the outer layer, ",
 Cell[BoxData[
  RowBox[{"Scaled", "[", "0.4", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe5a526e-6a52-4893-b5e9-eeb154b361a1"],
 " keeps the inner 40% of the radius."
}], "ExampleText",ExpressionUUID->"2256637a-e051-424f-b78a-d1f0cb770ace"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"VertexList", " ", "@", " ", 
        RowBox[{"CenterGraph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"-", "1"}]}], "]"}]}], ",", "\n", "     ", 
       RowBox[{"VertexList", " ", "@", " ", 
        RowBox[{"CenterGraph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"Scaled", "[", "0.4", "]"}]}], "]"}]}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"9ae74e07-3896-42a8-a1b1-dab2a8601cfb"],

