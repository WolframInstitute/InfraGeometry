Cell["\<\
The centre is one vertex and the periphery of a patch is its rim; both are \
vertex lists, so both are regions.\
\>", "ExampleText",ExpressionUUID->"e50f0ce9-5eb2-4d00-a7b8-a1c3906bb9e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"centre", " ", "=", " ", 
     RowBox[{"FindInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"GraphCenter", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"rim", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"GraphPeriphery", "[", "g", "]"}], ",", " ", "4"}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"GraphPeriphery", "[", "g", "]"}], ",", " ", "rim", ",", " ",
          "centre"}], "}"}]}], "]"}], ",", " ", "centre", ",", " ", "rim"}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5599263a-2b3a-4ece-953b-4d99b99f641c"],

