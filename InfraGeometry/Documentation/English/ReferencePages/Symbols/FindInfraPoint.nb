Cell["A tuple of three mutually most-distant points.", "ExampleText",ExpressionUUID->"7006d03e-d624-4db5-b555-d83d0c3e2eda"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", "3", ",", " ", 
         RowBox[{"\"\<Distance\>\"", " ", "->", " ", "\"\<Max\>\""}]}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", "corners", "}"}]}], "]"}], ",", " ", "corners"}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"dfa1a4b3-5bff-41ae-8cd8-fd4eacffd9b1"],

