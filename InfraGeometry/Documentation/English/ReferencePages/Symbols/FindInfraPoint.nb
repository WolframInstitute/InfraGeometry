Cell[TextData[{
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9a80dd6e-ad50-4715-8280-e7e964768431"],
 " selects the metrically special vertices. The centre is one vertex, and the \
periphery of a patch is its rim."
}], "ExampleText",ExpressionUUID->"d7bfa1f1-0115-4b03-9d36-aa8b7ef1422a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"centre", " ", "=", " ", 
     RowBox[{"FindInfraPoint", "[", 
      RowBox[{"g", ",", " ", "All", ",", " ", 
       RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"periphery", " ", "=", " ", 
     RowBox[{"FindInfraPoint", "[", 
      RowBox[{"g", ",", " ", "All", ",", " ", 
       RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Periphery\>\""}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"periphery", " ", "->", " ", "$InfraShellColor"}], ",", " ", 
         
         RowBox[{"centre", " ", "->", " ", "$InfraPointColor"}]}], "}"}]}], 
      "]"}], ",", "\n", "   ", "centre", ",", " ", 
     RowBox[{"Length", " ", "@", " ", "periphery"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"6dd067fd-65c8-4bdd-843c-0b8360e9d220"],

