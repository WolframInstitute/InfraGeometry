Cell[CellGroupData[{
Cell["FindInfraPoint", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4a2254c6-b4fc-4d14-8062-15629ae28c53"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPoint", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2181164-b18a-463a-9503-5f0f3f92eb84"],
 "\[LineSeparator]",
 "gives one point of ",
 StyleBox["g", "TI"],
 ", as a vertex.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0e78edf8-85fe-4cac-a748-87c8f5651c31"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPoint", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "493212c6-a9b3-47fe-a510-9a68fa165aec"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["n", "TI"],
 " points, as a vertex list. Exactly ",
 StyleBox["n", "TI"],
 " or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3094312-e2e7-497b-aa7d-02a3ee12b2f5"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6014b486-9484-4279-bacb-e6e9b725d3d5"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db8088e2-0322-443e-a1d7-93ca3aa21ddc"],
 " gives every vertex of the pool."
}], "Usage",ExpressionUUID->"4673e710-f9e6-4ced-88e9-6018169f8dc4"],

Cell[TextData[{
 "Definition: a point of ",
 StyleBox["g", "TI"],
 " drawn from the ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9291a65-11b3-461d-be43-23f4b18c0c51"],
 " candidate pool."
}], "Notes",ExpressionUUID->"8df9948e-85c3-4c59-8beb-d42553759a58"],

Cell[TextData[{
 "The count always means ",
 StyleBox["how many points you get",
  FontWeight->"Bold"],
 "; the ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1054ad1-7690-43cf-8e52-7a332a7e03e6"],
 " option constrains ",
 StyleBox["which",
  FontWeight->"Bold"],
 " ones. With a distance condition the returned list is therefore one \
mutually-constrained tuple \[LongDash] three points pairwise at maximum \
distance is a joint condition, and a plain vertex list states it without \
ambiguity."
}], "Notes",ExpressionUUID->"7f9b90e3-24ea-42b9-81bd-e89c26d270f6"],

Cell[TextData[{
 "The whole pool is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPoint", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e6803ac-00d4-4c90-bf8b-b7fcc1ce5c1c"],
 ", a vertex list."
}], "Notes",ExpressionUUID->"4f9a00c6-0f26-4e1e-a769-1dfdd473208e"],

