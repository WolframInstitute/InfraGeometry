Cell[CellGroupData[{
Cell["FindInfraPoint", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3493a100-eb52-47fd-9a98-5e35518a6f9f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPoint", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "225b7803-6543-4efc-bb93-80d7697d0f9f"],
 "\[LineSeparator]",
 "gives one point of ",
 StyleBox["g", "TI"],
 ", as a vertex.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e592cf8a-dddb-48c6-8079-fcefddfbdf9a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPoint", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81772593-252e-4b7b-80cd-c06366f07bb2"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["n", "TI"],
 " points, as a vertex list. Exactly ",
 StyleBox["n", "TI"],
 " or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3745cf1-8efe-4e05-8d1f-0e2b2d840aef"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1239fbc7-b77e-4264-b058-e4b35f9334ef"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df4bc818-2560-4882-9767-85ce6e1d4e3e"],
 " gives every vertex of the pool."
}], "Usage",ExpressionUUID->"0464be86-dbfd-4d05-b814-f70f1365f541"],

Cell[TextData[{
 "Definition: a point of ",
 StyleBox["g", "TI"],
 " drawn from the ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34e0e5f9-f82b-4ff6-be25-e247193b229d"],
 " candidate pool."
}], "Notes",ExpressionUUID->"6010eb9f-5c80-4ba0-a96a-f7d7c62ed60f"],

Cell[TextData[{
 "The count always means ",
 StyleBox["how many points you get",
  FontWeight->"Bold"],
 "; the ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b1581d9-e2b0-45f3-a5e6-06ffaf93dd80"],
 " option constrains ",
 StyleBox["which",
  FontWeight->"Bold"],
 " ones. With a distance condition the returned list is therefore one \
mutually-constrained tuple \[LongDash] three points pairwise at maximum \
distance is a joint condition, and a plain vertex list states it without \
ambiguity."
}], "Notes",ExpressionUUID->"659fcb51-2950-46e3-a270-7ab570088bf9"],

Cell[TextData[{
 "The whole pool is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPoint", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5daf76f-2fba-4668-b15f-4b7ba3620bda"],
 ", a vertex list."
}], "Notes",ExpressionUUID->"0350319a-bce8-4690-9167-9c441e718f7e"],

