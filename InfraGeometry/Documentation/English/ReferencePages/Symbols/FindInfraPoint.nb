Cell[CellGroupData[{
Cell["FindInfraPoint", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"65740d47-b87c-40ca-84e3-157ba51ac52b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPoint", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b8f5590-4968-4863-90ef-92cfc3909114"],
 "\[LineSeparator]",
 "gives one point of ",
 StyleBox["g", "TI"],
 ", as a vertex.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"21333b17-da08-49b0-90a1-b8d5bdda10e9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPoint", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ce0fff1-8a28-4575-b11e-5b8291f5f25e"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["n", "TI"],
 " points, as a vertex list. Exactly ",
 StyleBox["n", "TI"],
 " or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62aff61e-2a1f-4fde-988b-0798b13835e3"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31a6e31a-6ecf-4444-ab82-673727f66bd7"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "baef747d-7701-47e1-ace3-a224bf422387"],
 " gives every vertex of the pool."
}], "Usage",ExpressionUUID->"e8442934-7e77-45bf-98d5-708dee5ed3c4"],

Cell[TextData[{
 "Definition: a point of ",
 StyleBox["g", "TI"],
 " drawn from the ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f487111d-915d-478d-91b2-900ec66ae9ce"],
 " candidate pool."
}], "Notes",ExpressionUUID->"5069a5ef-3157-4ff4-ba26-c0cbc111d67e"],

Cell[TextData[{
 "The count always means ",
 StyleBox["how many points you get",
  FontWeight->"Bold"],
 "; the ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53ab10a5-c370-4e21-b15c-8ec717a0de9b"],
 " option constrains ",
 StyleBox["which",
  FontWeight->"Bold"],
 " ones. With a distance condition the returned list is therefore one \
mutually-constrained tuple \[LongDash] three points pairwise at maximum \
distance is a joint condition, and a plain vertex list states it without \
ambiguity."
}], "Notes",ExpressionUUID->"1c09b0fd-4445-4e61-9e30-dc088905d1f3"],

Cell[TextData[{
 "The whole pool is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPoint", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b89391b-7114-41f4-aca4-dc652d5787b1"],
 ", a vertex list."
}], "Notes",ExpressionUUID->"776ee667-ec43-4f05-a78a-2407341690eb"],

