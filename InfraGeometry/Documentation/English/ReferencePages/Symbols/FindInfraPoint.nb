Cell[TextData[{
 Cell[BoxData["\"\<Center\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf7b5de8-be19-4ff2-ba15-1c03b42605b2"],
 " and ",
 Cell[BoxData["\"\<Periphery\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08a5c702-77bc-4c71-8826-54448d4d6045"],
 " are meant in the graph-eccentricity sense. ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3bc9a5c-4318-41b2-9630-fd71e4b0d082"],
 " imposes a mutual-distance condition on a tuple."
}], "Notes",ExpressionUUID->"302308d2-e8dd-4413-95b8-4bac05b17133"],

Cell[TextData[{
 "To keep a whole construction interior, not just its anchors, cut the \
substrate with ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84efc08a-adb7-4d7a-9bce-859fbf38287f"],
 " (from the DiscreteGeometry paclet) and work on that graph: it is the ball \
of radius ",
 Cell[BoxData[
  RowBox[{"Floor", "[", 
   RowBox[{"q", " ", 
    RowBox[{"GraphRadius", "[", "g", "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30db6dbb-9f32-413c-b0c1-af41f7894638"],
 " about ",
 Cell[BoxData[
  RowBox[{"GraphCenter", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d58add9-3766-44bd-aaa3-2f77c8ac08ab"],
 ", carrying the same vertex labels and coordinates, so the result draws on \
the original. Restricting ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2fbb213-5fd4-4bd9-8a0b-3eb0afe694ba"],
 " alone pins only the anchors; a construction with slack spends it outward."
}], "Notes",ExpressionUUID->"bb6f0731-77e3-457e-8ba6-072a1e8e6360"],

Cell[TextData[{
 "To narrow a bundle you already hold, use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SelectInfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SelectInfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8e08912b-b5ee-4f9a-96ec-bbcaf94a8d9d"],
 ". It takes the same ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f561dfe8-6acb-44b7-a6ee-1506ca4751d7"],
 " and ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "89ebdd30-e037-483c-a705-ad0444e8e8ac"],
 " vocabulary on a supplied vertex set."
}], "Notes",ExpressionUUID->"d8f3c852-7a70-44aa-ac8f-daa7b5c30d4c"],

Cell[TextData[{
 "The draw is random: seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "135b25b5-4fd7-4a32-8d77-7c8ea2cade5b"],
 " before the first call if you need a reproducible figure."
}], "Notes",ExpressionUUID->"338add95-bc63-44bb-ab39-257334ac7f2a"],

