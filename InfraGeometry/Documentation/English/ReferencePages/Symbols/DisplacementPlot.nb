Cell[CellGroupData[{
Cell["DisplacementPlot", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c164d8a0-3db3-4af0-92f7-a1a765ae1f55"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementPlot"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementPlot", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e187ab48-9cb3-42da-9ce1-dc449c73adc8"],
 "\[LineSeparator]",
 "draws the displacement ",
 StyleBox["d", "TI"],
 " as bent arrows over the embedding of ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"47c188d4-34ba-4b3a-a0ce-2807e83a0128"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementPlot"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementPlot", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["d1", "TI"], ",", " ", 
      StyleBox["d2", "TI"], ",", " ", "..."}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f85612aa-d060-4330-91bd-78d1e004b013"],
 "\[LineSeparator]",
 "draws several displacements, the ",
 StyleBox["k", "TI"],
 "-th in the ",
 StyleBox["k", "TI"],
 "-th colour of the default plot palette."
}], "Usage",ExpressionUUID->"6be7b813-b984-4c9e-95fe-2f401bd984d4"],

Cell[TextData[{
 "Each step from ",
 StyleBox["v", "TI"],
 " to a vertex ",
 StyleBox["w \[NotEqual] v", "TI"],
 " of ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") is an arrow from the coordinates of ",
 StyleBox["v", "TI"],
 " to those of ",
 StyleBox["w", "TI"],
 ", bent to its right, so that the two arrows of an exchanged pair do not \
overlap. A vertex whose value is {",
 StyleBox["v", "TI"],
 "} draws nothing, and the identity draws the bare graph."
}], "Notes",ExpressionUUID->"a208ed81-98d2-4ffa-a163-0db8072a0037"],

Cell[TextData[{
 "The graph is drawn in light gray at the coordinates ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphEmbedding"]], "paclet:ref/GraphEmbedding"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "05bafc92-be70-4ee2-b087-44ebd59541a4"],
 " gives: its own ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VertexCoordinates"]], "paclet:ref/VertexCoordinates"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b64daec1-9e5c-4aa2-8172-49ede6eb9e70"],
 " when it has them, a computed layout otherwise. The colours are those of ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ColorData",
    BaseStyle->"Link"], "[", "97", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9ef9917-cb68-4887-bf7c-0449289d270d"],
 "."
}], "Notes",ExpressionUUID->"7d0c07a4-199b-4304-b0ce-9f3fc47a235b"],

