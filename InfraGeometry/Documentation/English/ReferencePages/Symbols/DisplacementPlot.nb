Cell["\<\
With three-dimensional coordinates the call stays unevaluated:\
\>", "ExampleText",ExpressionUUID->"aaf7b5a3-9c40-456d-baaf-76ebd4961eb6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<CubicGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"Head", " ", "@", " ", 
    RowBox[{"DisplacementPlot", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"RandomDisplacement", "[", 
       RowBox[{"g", ",", " ", "1", ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b6ae7c26-1d24-4c15-afe9-591d88d80cb0"],

Cell[BoxData["DisplacementPlot"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"e1c95113-0da0-4bb5-931b-ca0d65482979"]
}, Open  ]]
