Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PlotRange"]], "paclet:ref/PlotRange"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "65bf3857-57b8-42b8-99e4-a7a369ff092c"],
 " shows a part of the graph: the centre of the square tiling under a random \
displacement."
}], "ExampleText",ExpressionUUID->"06c1c9b6-66b6-485e-b124-fc677ad2d589"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomDisplacement", "[", 
        RowBox[{"g", ",", " ", "2"}], "]"}]}], ")"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "3"}], ",", " ", "5"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "4"}], ",", " ", "4"}], "}"}]}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a6e29651-4773-4ec6-b67d-755bd74c5ab8"],

