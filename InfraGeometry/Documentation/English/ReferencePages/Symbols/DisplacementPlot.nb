Cell["\<\
A displacement given at a few vertices draws only there. The four steps from \
the centre of the grid, scaled by 1, 2 and 3:\
\>", "ExampleText",ExpressionUUID->"ac2bfa7e-1125-40d3-bab1-49731becdbb7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"DisplacementScale", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"<|", 
          RowBox[{"c", " ", "->", " ", 
           RowBox[{"AdjacencyList", "[", 
            RowBox[{"g", ",", " ", "c"}], "]"}]}], "|>"}], ",", " ", "t"}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"186290b7-f2e4-4af6-98af-39267ce8579f"],

