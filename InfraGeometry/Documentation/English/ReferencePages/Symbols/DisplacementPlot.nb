Cell["\<\
A vertex that stays is not drawn. The angular displacement of the square \
tiling fixes every vertex, and only the radial one shows.\
\>", "ExampleText",ExpressionUUID->"2f69c924-febb-4bcf-9a16-f6485b1b44a9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"polar", " ", "=", " ", 
     RowBox[{"PolarDisplacements", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCenter", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", "polar"}], "]"}], ",", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Keys", "[", 
        RowBox[{"Last", "[", "polar", "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Last", "[", "polar", "]"}], "[", "#", "]"}], " ", "===", 
         " ", 
         RowBox[{"{", "#", "}"}]}], " ", "&"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"de87a6cd-11df-4c97-bcdb-7b1a5174b522"],

