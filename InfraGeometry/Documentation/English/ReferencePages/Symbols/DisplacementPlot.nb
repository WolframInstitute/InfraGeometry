Cell[CellGroupData[{
Cell["DisplacementPlot", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fc1eace2-2e48-4aa0-8325-5493cc17cc0c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementPlot"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementPlot", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ac96c86-14c3-45f5-8484-3a0afbdf40b1"],
 "\[LineSeparator]",
 "draws the displacement ",
 StyleBox["d", "TI"],
 " as arrows over the embedding of ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6d3e6595-046c-4f97-bd27-45a99697449e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementPlot"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementPlot", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["d1", "TI"], ",", " ", 
      StyleBox["d2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b336ec2-ff03-407a-afd8-7b48db77d93d"],
 "\[LineSeparator]",
 "draws several displacements, each in its own colour."
}], "Usage",ExpressionUUID->"f64a4dcc-3f21-4e56-8b83-77efdc59b3b4"],

Cell[TextData[{
 "Each step from ",
 StyleBox["v", "TI"],
 " to a vertex ",
 StyleBox["w \[NotEqual] v", "TI"],
 " of ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") is an arrow from ",
 StyleBox["v", "TI"],
 " to ",
 StyleBox["w", "TI"],
 ", bent to its right, so that the two arrows of an exchanged pair do not \
overlap. A vertex whose value is {",
 StyleBox["v", "TI"],
 "} draws nothing; the identity draws the bare graph."
}], "Notes",ExpressionUUID->"5caa242f-f7c3-49cb-91f4-02c9b035dcc8"],

