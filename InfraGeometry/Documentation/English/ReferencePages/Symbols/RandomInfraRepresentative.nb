Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraRepresentative", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"350810a6-827a-4e59-882c-b454511ba498"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffa5e4c6-4e6e-49f0-bd36-a3cde8334820"],
 "\[LineSeparator]",
 "gives one member of the symbolic object ",
 StyleBox["head", "TI"],
 " as a vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"efabb2c8-8b48-485f-9b1e-b72d9f8922eb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"], ",", " ", 
    RowBox[{
     StyleBox["n", "TI"], " ", "|", " ", 
     RowBox[{
      ButtonBox["UpTo",
       BaseStyle->"Link"], "[", 
      StyleBox["n", "TI"], "]"}], " ", "|", " ", 
     ButtonBox["All",
      BaseStyle->"Link"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af1ab051-be0f-4cc5-9d71-4018a7b32698"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "485d6419-d821-477a-959a-001f792be268"],
 " of ",
 StyleBox["n", "TI"],
 ", at most ",
 StyleBox["n", "TI"],
 ", or every member."
}], "Usage",ExpressionUUID->"d2e0952f-daa1-4ed5-b99f-2ced481839c3"],

Cell[TextData[{
 "The default draw is random; seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b09f0470-15b8-4d80-84d1-bf8726c8fd44"],
 " to reproduce it. Give ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d8d58fe-d783-42d8-8fd6-c59a824a0ea2"],
 " for the deterministic lexicographic descent."
}], "Notes",ExpressionUUID->"cd39c71e-38ad-4493-a0fe-b349d071bb2a"],

Cell["\<\
The head names the notion; this function draws its members. Where the head \
has a faithful graph theorem, a member is read off its graph; otherwise the \
head's own search runs at its defaults.\
\>", "Notes",ExpressionUUID->"1f3a8c90-3672-48bc-88f5-240957dfdb3d"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f54f0268-5f76-4009-ad8c-34f1e157ea80"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraRay", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29be43a9-df0b-416b-a134-a5680cae4a06"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraLine", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a62258a-b995-42e7-9292-710e0b027197"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraLine", "[", "germ", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "accdf576-27f4-4e97-896f-80d50cb20eb2"],
 " and ",
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "q"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dfe1abcc-4f93-4ad0-95d9-9b16e39b773a"],
 ": a member is a source-to-sink chain of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ecf92c2c-d3e2-43e2-ba47-5429439ec63a"],
 ". ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06fdbd9c-b9b3-4a82-ab31-536f93da35b1"],
 " gives the lexicographic descent. A polyline ",
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   RowBox[{"p1", ",", " ", "...", ",", " ", "pk"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8d84bb0-780f-4382-91ac-2b60b0a35a31"],
 " and a multi-point arc concatenate the members of their pieces."
}], "Notes",ExpressionUUID->"15d2cf83-55f8-4646-8001-c19650aae172"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraCircle", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"r", " ", "|", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "s"}], "}"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58629ec9-8173-4e8c-a9b1-8905e4a0b65b"],
 ": a member is a circle found by sweeping the band, length by length with ",
 Cell[BoxData["FindCycle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9dad88dc-4f8a-4767-bda8-aac5b1d09449"],
 " (see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "71a22f0c-fea2-4dd9-a053-7523f078a6db"],
 "), as a cyclic vertex list whose first vertex is not repeated. The atoms \
stay what ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aeb3026f-fdf7-4672-aa5a-9ed19b9ca5d1"],
 " measures; the sweep is the check on them."
}], "Notes",ExpressionUUID->"6e2a5f64-a0b8-4e28-80e6-ffc674fd693f"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "p"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49887398-522a-4401-9bd5-a04b0afab7e2"],
 ", the closed arc: the same sweep, not the atom of its graph, keeping the \
circles through ",
 StyleBox["p", "TI"],
 ", and through every point of ",
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "q", ",", " ", "...", ",", " ", "p"}], "}"}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7253cbfb-c864-412f-93a9-7152a58d251e"],
 " (see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "86cb457e-32a3-4df1-a1e5-4bc4ea6a4dd1"],
 ")."
}], "Notes",ExpressionUUID->"a30c1912-1254-4cc0-ab77-490d620f52a6"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraGeodesic", "[", 
   RowBox[{"germ", ",", " ", "s"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13a7d4de-a3b5-48e1-ac02-d1c2f328c373"],
 ", the geodesics at infra-scale ",
 StyleBox["s", "TI"],
 " through the germ: a member is an inextensible simple geodesic, the result \
of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "057d705f-0fd4-427a-9ed2-14c751eb8dde"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{
   "g", ",", " ", "germ", ",", " ", "s", ",", " ", "Infinity", ",", " ", "n", 
    ",", " ", 
    RowBox[{"Properties", " ", "->", " ", 
     RowBox[{"{", "\"\<Simple\>\"", "}"}]}], ",", " ", 
    RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<BothSides\>\""}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49386b16-a87a-403e-a1ec-649737230741"],
 ". The germ is a vertex list; a one-vertex list is grown on both sides, so \
it gives every geodesic through the vertex."
}], "Notes",ExpressionUUID->"fc1071bd-0843-46a3-8eb1-0a9b207be5ad"],

Cell[TextData[{
 "The scene tokens ",
 Cell[BoxData["InfraShell"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "427e5cff-e827-400f-94c8-60a6ce6ce295"],
 ", ",
 Cell[BoxData["InfraBall"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6405ef37-1182-4b87-afe3-b2e47ad0bec0"],
 ", ",
 Cell[BoxData["InfraPlane"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "347ce56a-e3df-4e77-b19a-b783cdc27fea"],
 ", ",
 Cell[BoxData["InfraPolygon"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b8b88f0-8ffe-456a-9f2c-94862167a389"],
 ", ",
 Cell[BoxData["InfraWalk"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b78eefca-e984-466f-9bd6-abb28b15be74"],
 " and ",
 Cell[BoxData["InfraPoint"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e7159b1-e5e1-40ad-a5c5-906078b178e1"],
 ": a member is a result of the token's search at its defaults. A set head \
such as ",
 Cell[BoxData[
  RowBox[{"InfraBall", "[", 
   RowBox[{"c", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0de95f2c-f02a-450c-95cb-049786f38780"],
 " has one member, its sorted vertex list."
}], "Notes",ExpressionUUID->"01bf3f78-8e0c-400c-ac0b-53eb2c71ceb1"],

Cell[TextData[{
 "The walk searches (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0b8fe022-a842-4ec6-831d-abd0633af75b"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4936d833-497f-435e-80b7-ab7b87a70b22"],
 ") take a germ, a budget and options of their own; the head ",
 Cell[BoxData["InfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32eddd68-4b3d-4c04-8fa6-7a45a1f6344e"],
 " fixes them to the inextensible simple class."
}], "Notes",ExpressionUUID->"b2d3cc9b-433a-4a2b-94fa-4a10124479c9"],

Cell[TextData[{
 "A closed count under a non-negative integer ",
 StyleBox["n", "TI"],
 " that exceeds the number of members gives ",
 Cell[BoxData[
  RowBox[{"{", " ", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f080bfd4-7095-4717-8be0-c49b3a99dac9"],
 "."
}], "Notes",ExpressionUUID->"138bb150-6a3b-4021-b24f-b81bd2886f6f"],

Cell[TextData[{
 "The ",
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ee03ead-1471-4521-891c-4cfa07d76a03"],
 " option controls the descent. ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12d18c59-0729-4c11-8401-7bc2293fd5ac"],
 " draws a uniformly random member from a graph; ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "159b6116-6900-4685-8216-b92d544e3d32"],
 " follows the first candidate at each step. A custom function receives the \
candidate list at each step. ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"RandomSample", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"UpTo", "[", "q", "]"}]}], "]"}], " ", "&"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28406789-e1c7-4baa-b444-45b1eadcc751"],
 " limits the candidates tried at each step to at most ",
 StyleBox["q", "TI"],
 ". ",
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e15d0dc-f370-411b-8251-cc577a402310"],
 " draws one candidate at each step and cannot be used with ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1f05f9d-2192-407e-86ec-9a152f0c3fc1"],
 "."
}], "Notes",ExpressionUUID->"3309ef6c-d2ec-49fc-b188-b0e7edd8958e"],

Cell["The former sampler names are:", "Notes",ExpressionUUID->"da3ea1e3-85de-45e8-9c3d-b10271c29d63"],

