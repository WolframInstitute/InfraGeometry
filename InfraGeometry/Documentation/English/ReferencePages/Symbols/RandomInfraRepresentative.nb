Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraRepresentative", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a552f802-7216-4250-8821-d381390a3e33"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c173cc6b-dd78-4062-bf93-1e9c4abe8b13"],
 "\[LineSeparator]",
 "gives one member of the symbolic object ",
 StyleBox["head", "TI"],
 " as a vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2652e898-78c9-4e42-a5fd-b7107a424951"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"], ",", " ", 
    RowBox[{
     StyleBox["n", "TI"], " ", "|", " ", 
     RowBox[{
      ButtonBox["UpTo",
       BaseStyle->"Link"], "[", 
      StyleBox["n", "TI"], "]"}], " ", "|", " ", 
     ButtonBox["All",
      BaseStyle->"Link"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3e71dbe-a42f-4263-9371-0cc1e0359405"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5295340a-66c7-4bca-a939-613f6c66b4e4"],
 " of ",
 StyleBox["n", "TI"],
 ", at most ",
 StyleBox["n", "TI"],
 ", or every member."
}], "Usage",ExpressionUUID->"8a446ed2-c9f0-4725-a811-42f8ae93a0a8"],

Cell[TextData[{
 "The default draw is random; seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "716fb4da-c21e-485b-9acb-83843359459b"],
 " to reproduce it. Give ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85ee46cd-d65a-4ea1-a593-3c70e48b8bac"],
 " for the deterministic lexicographic descent."
}], "Notes",ExpressionUUID->"8826fbe9-96e0-46fb-ba11-aaaa833a9bfd"],

Cell["\<\
The head names the notion; this function draws its members. Where the head \
has a faithful graph theorem, a member is read off its graph; otherwise the \
head's own search runs at its defaults.\
\>", "Notes",ExpressionUUID->"e0715052-46fb-4e16-9a86-cda7e2bb0d67"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55b2f169-5594-4068-aeca-0c8e69a864c8"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraRay", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c57f60eb-8c67-4d02-83c8-52a9894487d6"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraLine", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "944c33a0-d801-4b29-a15f-02ab35834c1b"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraLine", "[", "germ", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58f864ec-82b7-4b19-8611-bd85d98a262c"],
 " and ",
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "q"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35896de9-ad70-4577-b750-a1abf7f25278"],
 ": a member is a source-to-sink chain of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85fe0f23-dcb1-4451-812a-d6c4682c2213"],
 ". ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b473f8ac-bd3d-40f0-8769-0ebd24c6d37f"],
 " gives the lexicographic descent. A polyline ",
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   RowBox[{"p1", ",", " ", "...", ",", " ", "pk"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "91ef8b66-6a03-4d29-8126-7e1a203b2b24"],
 " and a multi-point arc concatenate the members of their pieces."
}], "Notes",ExpressionUUID->"1364ba5e-29e7-44e3-8173-eac1ec17063a"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraCircle", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"r", " ", "|", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "s"}], "}"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f43ec9c-6a75-4bf0-89a3-8a78070dda46"],
 ": a member is a circle found by sweeping the band, length by length with ",
 Cell[BoxData["FindCycle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d139461e-bd52-4975-8635-55f94a08009c"],
 " (see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fb696ad9-ac5b-46d7-9813-24627fadd675"],
 "), as a cyclic vertex list whose first vertex is not repeated. The atoms \
stay what ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "192918b4-6036-4bd5-98b7-16642b0220cf"],
 " measures; the sweep is the check on them."
}], "Notes",ExpressionUUID->"e917189b-57c9-4da8-93a4-d96945713edb"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "p"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "817ecae4-0eed-4e0c-8e76-9d725f272832"],
 ", the closed arc: the same sweep, not the atom of its graph, keeping the \
circles through ",
 StyleBox["p", "TI"],
 ", and through every point of ",
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "q", ",", " ", "...", ",", " ", "p"}], "}"}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "204e858a-c4d2-4175-8fd9-ec7dae7bdba2"],
 " (see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7263e250-1ec7-4a3b-86f4-eb024d2826b2"],
 ")."
}], "Notes",ExpressionUUID->"6196e071-f296-403b-a7c5-ea1110a738cd"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraGeodesic", "[", 
   RowBox[{"germ", ",", " ", "s"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67a5646b-a567-48a2-abce-907cb42a8dd7"],
 ", the geodesics at infra-scale ",
 StyleBox["s", "TI"],
 " through the germ: a member is an inextensible simple geodesic, the result \
of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c985bab9-c6a0-41bb-8f36-a3b78abfb818"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{
   "g", ",", " ", "germ", ",", " ", "s", ",", " ", "Infinity", ",", " ", "n", 
    ",", " ", 
    RowBox[{"Properties", " ", "->", " ", 
     RowBox[{"{", "\"\<Simple\>\"", "}"}]}], ",", " ", 
    RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<BothSides\>\""}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19fda606-6c23-4863-95ee-f07dfdd13d26"],
 ". The germ is a vertex list; a one-vertex list is grown on both sides, so \
it gives every geodesic through the vertex."
}], "Notes",ExpressionUUID->"82ff1829-bb0b-46c5-8c1a-955ffe30e4db"],

Cell[TextData[{
 "The scene tokens ",
 Cell[BoxData["InfraShell"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96d5ae66-8610-4555-b127-610477fe3f7b"],
 ", ",
 Cell[BoxData["InfraBall"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3164e848-3496-47d2-bdbd-01c864394066"],
 ", ",
 Cell[BoxData["InfraPlane"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3244ddd-7367-44d6-acd2-d0e5f726cb1e"],
 ", ",
 Cell[BoxData["InfraPolygon"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf17f3a1-76eb-44e8-8fb4-7982561f196b"],
 ", ",
 Cell[BoxData["InfraWalk"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c610c1a3-4c85-4433-a155-6cc4f37563ed"],
 " and ",
 Cell[BoxData["InfraPoint"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7f97876-18f7-403c-a771-27203971fe6d"],
 ": a member is a result of the token's search at its defaults. A set head \
such as ",
 Cell[BoxData[
  RowBox[{"InfraBall", "[", 
   RowBox[{"c", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00fc880a-d550-42e3-bd76-09799fa65129"],
 " has one member, its sorted vertex list."
}], "Notes",ExpressionUUID->"9d14193a-d4e7-4633-9279-c01e30bb5215"],

Cell[TextData[{
 "The walk searches (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7b2cabdc-ab3b-4b81-ae7d-f999cf68339a"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e7262236-1cbe-4a6d-aba9-be00fd68162b"],
 ") take a germ, a budget and options of their own; the head ",
 Cell[BoxData["InfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da555c6c-8c5b-4f21-9f8f-ad4ce81c0183"],
 " fixes them to the inextensible simple class."
}], "Notes",ExpressionUUID->"f81a537c-f209-475d-8b2a-aaec46a1ce54"],

Cell[TextData[{
 "A bounded count draws distinct members. An integer ",
 StyleBox["n", "TI"],
 " that exceeds the number of members gives ",
 Cell[BoxData[
  RowBox[{"{", " ", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2106f92-1313-4a67-933a-c6743b6cea0f"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ae23f19-50c7-4ea2-8975-d85c0b1546fa"],
 " returns the available members. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9fbae34-01d6-4fc8-8286-872d7730645a"],
 " preserves enumeration order without drawing."
}], "Notes",ExpressionUUID->"4f8d231f-639e-4075-ba61-46c2df621a07"],

Cell[TextData[{
 "The ",
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf9ce4f2-efd8-4b8b-b7f5-d6e5a3de300d"],
 " option controls the descent. ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fa669a8-4251-4063-a24a-c481783be39f"],
 " draws a uniformly random member from a graph; ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8456058-824f-4dc1-8e5a-552691d6f79e"],
 " follows the first candidate at each step. A custom function receives the \
candidate list at each step. ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"RandomSample", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"UpTo", "[", "q", "]"}]}], "]"}], " ", "&"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43bf2c4f-6e91-4795-9c86-e499cc3931ff"],
 " limits the candidates tried at each step to at most ",
 StyleBox["q", "TI"],
 ". ",
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97e0647e-763d-4508-8f1f-9c6c3e7708f3"],
 " draws one candidate at each step and cannot be used with ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03119b5a-0823-4d0b-a1f3-98ec0d2ed8f5"],
 "."
}], "Notes",ExpressionUUID->"d157c2e3-2e53-45f8-80c3-3ea8a75973ea"],

Cell["The former sampler names are:", "Notes",ExpressionUUID->"6c8ee5b1-46a1-45f9-8496-3c5c2ff4c982"],

