Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraRepresentative", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"00d4e8e2-8d9f-443c-ac4e-60344ae57151"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57befbc9-441a-4448-ad4e-ed7dc342d682"],
 "\[LineSeparator]",
 "gives one member of the symbolic object ",
 StyleBox["head", "TI"],
 " as a vertex list.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1cab351a-cc1c-4024-a378-815815b47b7f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"], ",", " ", 
    RowBox[{
     StyleBox["n", "TI"], " ", "|", " ", 
     RowBox[{
      ButtonBox["UpTo",
       BaseStyle->"Link"], "[", 
      StyleBox["n", "TI"], "]"}], " ", "|", " ", 
     ButtonBox["All",
      BaseStyle->"Link"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6839b9cb-a3fd-4c81-aaad-02282f773551"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "094fbaf9-0032-4e77-87d8-ab2df4021c61"],
 " of ",
 StyleBox["n", "TI"],
 ", at most ",
 StyleBox["n", "TI"],
 ", or every member."
}], "Usage",ExpressionUUID->"ec6f475d-8fbe-4637-a102-5c7dd99e1aa7"],

Cell[TextData[{
 "The draw is random: seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "245949a7-b831-4d6e-9063-cdc33fe20b66"],
 ". For a deterministic draw give ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0554b8bc-5bfb-43d5-9a25-f39d63d59ac5"],
 ". Formerly ",
 Cell[BoxData[
  RowBox[{"FindInfra", "..."}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "caba6b3e-873c-4cb0-8900-4c60ffafa4d5"],
 " (default deterministic); ",
 Cell[BoxData["FindInfraMidpoint"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a90f21e-6d8f-4501-89fe-cd7037b55e98"],
 " is now the ",
 Cell[BoxData["\"\<Midpoint\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eaafc1d6-e990-44ed-be18-e71b34b3efec"],
 " reader of ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "705f1661-ab61-42f7-b81a-3017b95e2888"],
 "."
}], "Notes",ExpressionUUID->"6a5ac1bf-118b-44ba-982f-f942ea7bb265"],

Cell["\<\
The head names the notion; this function finds its members. Where the head \
has a faithful graph theorem, a member is read off it; otherwise the head's \
own search runs at its defaults.\
\>", "Notes",ExpressionUUID->"aaa2acbb-f767-482c-85e4-83e629eae0e9"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43891148-10c5-4dae-bc32-45cf1b931529"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraRay", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eff0fc38-7eb7-4779-9bba-8e2d986b36d1"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraLine", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "882d20a9-049f-4eb8-858e-dae0d7df510c"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraLine", "[", "germ", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09d7bcbc-914e-46f5-8b6e-4d44ba0fd9fb"],
 " and ",
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "q"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c202559f-c723-43a9-bdb8-dde8100fbeab"],
 ": a member is a source-to-sink chain of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["head", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3408d6a4-36c0-4aa6-bb0d-0e90f7f1bc9d"],
 ", read off in lexicographic order. A polyline ",
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   RowBox[{"p1", ",", " ", "...", ",", " ", "pk"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc1788fd-f581-4d03-9dec-c966d3772343"],
 " and a multi-point arc concatenate the members of their pieces."
}], "Notes",ExpressionUUID->"1b224246-91ee-4b4c-8257-4325a985d4b5"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraCircle", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"r", " ", "|", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "s"}], "}"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4353d07-d7ba-4d5e-9f2d-92ffe2bda2a2"],
 ": a member is a circle found by sweeping the band, length by length with ",
 Cell[BoxData["FindCycle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58e85802-42ba-4470-b1dd-b6c8c991931f"],
 " (see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "448eccfa-cbe9-49bb-9ede-d2057ddb2711"],
 "), as a cyclic vertex list whose first vertex is not repeated. The atoms \
stay what ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5643d288-a2c0-4d7b-ac0e-b16fd3c9c956"],
 " measures; the sweep is the check on them."
}], "Notes",ExpressionUUID->"c6d357ef-c21b-428c-9267-95cfa087e416"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "p"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e242389c-4e79-4a51-bc20-1844ec06f61e"],
 ", the closed arc: the same sweep, not the atom of its graph, keeping the \
circles through ",
 StyleBox["p", "TI"],
 ", and through every point of ",
 Cell[BoxData[
  RowBox[{"InfraArc", "[", 
   RowBox[{"c", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "q", ",", " ", "...", ",", " ", "p"}], "}"}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30ac07ee-a422-4e58-b7a1-0d117fe9de84"],
 " (see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e3093617-d368-46b0-8804-a8cf8418b7d8"],
 ")."
}], "Notes",ExpressionUUID->"52d048e0-9390-4d90-8db3-cf191c00a664"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"InfraGeodesic", "[", 
   RowBox[{"germ", ",", " ", "s"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ba99aac-8621-4372-8403-b02a93ee2625"],
 ", the geodesics at infra-scale ",
 StyleBox["s", "TI"],
 " through the germ: a member is an inextensible simple geodesic, the result \
of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3195e640-8dd9-44a2-a76e-8d997714f6b7"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{
   "g", ",", " ", "germ", ",", " ", "s", ",", " ", "Infinity", ",", " ", "n", 
    ",", " ", 
    RowBox[{"Properties", " ", "->", " ", 
     RowBox[{"{", "\"\<Simple\>\"", "}"}]}], ",", " ", 
    RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<BothSides\>\""}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54613bac-e487-44f9-9c20-6b68a3ef928c"],
 ". The germ is a vertex list; a one-vertex list is grown on both sides, so \
it gives every geodesic through the vertex."
}], "Notes",ExpressionUUID->"89413ddf-5908-4ffd-8c8d-1e14159a2e57"],

Cell[TextData[{
 "The scene tokens ",
 Cell[BoxData["InfraShell"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "264275a8-39d1-4c1d-a2e1-c3f7f6ccb498"],
 ", ",
 Cell[BoxData["InfraBall"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35252d84-90ef-4e23-a559-b97890e8fdd5"],
 ", ",
 Cell[BoxData["InfraPlane"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4abbc059-dea8-4164-bb9f-50e692818ad7"],
 ", ",
 Cell[BoxData["InfraPolygon"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ef32ca0-ada3-4f0f-86e8-36e7a3e32a5b"],
 ", ",
 Cell[BoxData["InfraWalk"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c069d831-8e9f-4819-9d3b-7faa83124f41"],
 " and ",
 Cell[BoxData["InfraPoint"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff22670d-0341-49a8-8f6e-41f2a903b34c"],
 ": a member is a result of the token's search at its defaults. A set head \
such as ",
 Cell[BoxData[
  RowBox[{"InfraBall", "[", 
   RowBox[{"c", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2707376d-e1a8-4d73-a494-0fbbea58ca60"],
 " has one member, its sorted vertex list."
}], "Notes",ExpressionUUID->"f568b5aa-0b21-4deb-be1d-3458193edee9"],

Cell[TextData[{
 "The walk searches (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraWalk"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraWalk", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cd21389b-1796-4a81-b20d-e63ee042e85f"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e9165c62-a531-4078-955e-dc9d6b48f331"],
 ") take a germ, a budget and options of their own; the head ",
 Cell[BoxData["InfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bd53815-6f73-473d-ae01-f56271ef652e"],
 " fixes them to the inextensible simple class."
}], "Notes",ExpressionUUID->"f9854379-7ec1-4b2b-b7f6-d04876ed171f"],

Cell[TextData[{
 "A closed count under a non-negative integer ",
 StyleBox["n", "TI"],
 " that exceeds the number of members gives ",
 Cell[BoxData[
  RowBox[{"{", " ", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3011e7fe-f7ce-4db5-b26e-79bbfdb6ae51"],
 "."
}], "Notes",ExpressionUUID->"271c408f-c69a-42eb-b8c0-6b5781969d0c"],

Cell["Two modifiers, given after the count:", "Notes",ExpressionUUID->"59b88d85-3a90-4b3e-a78d-acf34bad4404"],

Cell[TextData[{
 Cell[BoxData["\"\<RandomChoice\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f102e819-830a-4b8b-82b7-c3702cc132d3"],
 " gives random members. On a graph it walks the chains choosing the next \
arrow ",
 StyleBox["v", "TI"],
 " -> ",
 StyleBox["w", "TI"],
 " with probability proportional to the backward count at ",
 StyleBox["w", "TI"],
 ", so every member is drawn with probability ",
 Cell[BoxData[
  RowBox[{"1", " ", "/", " ", "Cardinality"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3c54c7b-913b-4959-9cd9-b4ed5b3ebb0f"],
 "; on a search it is ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "RandomSample"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc2649ab-d40c-45b4-9c29-261cf7a18ace"],
 "; otherwise it draws from the search's members. ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73719cee-f8f8-4bcd-9dbc-4bf41fb111b7"],
 " in front reproduces the draw."
}], "Notes",ExpressionUUID->"33362d1d-f5ab-4d88-9258-2632abfce0f8"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e5d9a65-d41f-48f8-85fd-f9c4a5e3f39c"],
 ", under ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d13a0cdf-db08-4ed6-bd54-6964771a1e3f"],
 ", discards a random fraction ",
 StyleBox["q", "TI"],
 " of the candidates at each step of an otherwise exhaustive enumeration; on \
a search it is the next-vertex function ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"RandomSample", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"UpTo", "[", "q", "]"}]}], "]"}], " ", "&"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40e90e8a-303f-4849-a38c-3a2e74eafe33"],
 " for an integer ",
 StyleBox["q", "TI"],
 ", keeping a fraction ",
 StyleBox["q", "TI"],
 " of the candidates per node for ",
 StyleBox["q", "TI"],
 " < 1."
}], "Notes",ExpressionUUID->"942e1e85-fa43-494d-930e-9706daae596a"],

Cell[TextData[{
 "The specialised searches (",
 Cell[BoxData["RandomInfraSegment"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a712fd5-ed5d-454f-841b-56a1af161774"],
 ", ",
 Cell[BoxData["RandomInfraSphere"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae452d66-16ce-456d-8cc3-6e95735da51d"],
 ", ",
 Cell[BoxData["FindInfraShell"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5c02327-74e7-4df3-a10d-3acf85fcd37b"],
 ", ",
 Cell[BoxData["RandomInfraWalk"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07b418b8-f568-4e6d-84e1-eff67363a616"],
 ", ",
 Cell[BoxData["RandomInfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "176a606f-172c-4194-a65f-70d15e2bf463"],
 ", \[Ellipsis]) keep their own parameters; this function takes none of \
them."
}], "Notes",ExpressionUUID->"67397dbe-f5cf-4206-8cc2-6d324289e1c5"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomInfraRepresentative", "[", 
   RowBox[{"graph", ",", " ", "head"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12ebf215-6d14-4301-a558-be643c1e7938"],
 " (no count) is the same as ",
 Cell[BoxData[
  RowBox[{"RandomInfraRepresentative", "[", 
   RowBox[{"graph", ",", " ", "head", ",", " ", "Automatic"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bea4c286-135d-46d0-869f-11744534b781"],
 ", the first member in canonical order."
}], "Notes",ExpressionUUID->"e9a516dd-c8c4-43b6-9b5b-24427725770d"]
}, Open  ]],

