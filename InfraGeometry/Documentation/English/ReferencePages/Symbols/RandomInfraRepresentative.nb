     RowBox[{"RandomInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
