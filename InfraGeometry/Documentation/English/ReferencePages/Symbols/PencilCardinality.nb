Cell["The count equals the length of the enumerated pencil.", "ExampleText",ExpressionUUID->"8edb2a32-6ec8-4e20-8c77-8a4f7237a35f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"PencilCardinality", "[", 
      RowBox[{"g", ",", " ", "5"}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"PencilDirections", "[", 
       RowBox[{"g", ",", " ", "5"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9a6c58d7-269a-4b18-8072-0584610ac7c4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"8", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e6b8441c-1a58-4e1d-b48f-0a6f4e05468a"]
}, Open  ]],

Cell["It is at least the degree.", "ExampleText",ExpressionUUID->"81feebe8-7606-4170-ba41-9aaa1e9b53b6"],

