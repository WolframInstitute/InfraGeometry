Cell["The count equals the length of the enumerated pencil.", "ExampleText",ExpressionUUID->"233ca605-4a85-426c-9710-5a5d66de32a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"PencilCardinality", "[", 
      RowBox[{"g", ",", " ", "5"}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"PencilDirections", "[", 
       RowBox[{"g", ",", " ", "5"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1a8fe742-332a-4528-bd5c-8f47123388fb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"8", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2b2cc169-d859-4628-9ac7-0b87201525a8"]
}, Open  ]],

