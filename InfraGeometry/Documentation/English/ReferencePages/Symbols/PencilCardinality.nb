Cell[CellGroupData[{
Cell["PencilCardinality", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8a23f304-22dd-4f89-bc5f-c5f0ea5ede60"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PencilCardinality"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/PencilCardinality", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ad1e685-c550-4d99-9c10-efe387cf43de"],
 "\[LineSeparator]",
 "gives the number of rays from ",
 StyleBox["O", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"1f99c30e-8a33-40fd-801a-1c33d7bae3fc"],

Cell[TextData[{
 "The pencil at ",
 StyleBox["O", "TI"],
 " is the set of rays from ",
 StyleBox["O", "TI"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PencilDirections"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/PencilDirections", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fe92792a-90ad-4e9b-90ff-2276b4d788cf"],
 "). Its size is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraRay", "[", 
     RowBox[{
      ButtonBox["O",
       BaseStyle->"Link"], ",", " ", 
      ButtonBox["O",
       BaseStyle->"Link"]}], "]"}], ",", " ", "\"\<Cardinality\>\""}], "]"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4037332-d6e4-4aad-a153-d2f6199e73cd"],
 ": the chain count of the pencil's graph, read off by dynamic programming, \
never by enumerating rays."
}], "Notes",ExpressionUUID->"1617d8f1-3cfa-4615-95a1-bb2890bba98e"],

Cell[TextData[{
 "The count is at least the degree of ",
 StyleBox["O", "TI"],
 ", with equality when every direction continues uniquely to a unique end. \
Its excess over the degree measures how much the graph branches ahead of ",
 StyleBox["O", "TI"],
 "; on a lattice it is large."
}], "Notes",ExpressionUUID->"cae1d8e2-d863-4074-92ce-b90b801ed4dd"]
}, Open  ]],

