Cell["Two rays leave the middle of a path.", "ExampleText",ExpressionUUID->"2537001e-b8e5-4e0c-92fe-33696fecc714"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PencilCardinality", "[", 
  RowBox[{
   RowBox[{"PathGraph", "[", 
    RowBox[{"Range", "[", "7", "]"}], "]"}], ",", " ", "4"}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"653c20f4-0213-4f85-8265-7c8b5e3cecdd"],

Cell[BoxData["2"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"aa4afd5f-ee46-481e-9704-c54675a2cc5e"]
}, Open  ]],

Cell["\<\
Two leave a vertex of the 6-cycle \[LongDash] both end at the antipode \
\[LongDash] and eight leave the centre of a 3 \[Times] 3 grid.\
\>", "ExampleText",ExpressionUUID->"0c14656c-c420-4523-8ab0-cacc699f99c4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"PencilCardinality", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", "1"}], "]"}], ",", " ", 
   
   RowBox[{"PencilCardinality", "[", 
    RowBox[{
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], ",", " ", "5"}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3d5aa066-1895-44b7-8fc5-1bc12b8fb079"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"44284496-b3cd-4bf7-a34b-762ae91bf4ee"]
}, Open  ]],

Cell["\<\
On the 3-cube every geodesic from a vertex runs to the antipode, so the \
pencil has 3! = 6 rays.\
\>", "ExampleText",ExpressionUUID->"ff6e555b-1e17-48bf-904b-d9117d76a28a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PencilCardinality", "[", 
  RowBox[{
   RowBox[{"HypercubeGraph", "[", "3", "]"}], ",", " ", "1"}], "]"}]], "Input",\

 CellLabel->"In[3]:= ",ExpressionUUID->"24836537-135d-47f7-aaa2-696c94df2bfe"],

Cell[BoxData["6"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"c53d4c4f-3f4a-4884-b569-3f35aed13bf9"]
}, Open  ]],

Cell["\<\
The pencil at the centre of each substrate, counted without enumerating a ray.\
\>", "ExampleText",ExpressionUUID->"18d77b30-a0ab-4e06-8c1f-5e75f4c2b322"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"PencilCardinality", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], ",", 
    "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"1fa9942f-5824-4b09-8f67-a234d21eeb78"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"SquareMeshGraph\"\>", "\[Rule]", "1587"}], ",", 
   RowBox[{"\<\"SquareTilingGraph\"\>", "\[Rule]", "16380"}], ",", 
   RowBox[{"\<\"HexagonalTilingGraph\"\>", "\[Rule]", "762"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"f630e41f-6f7c-4d28-a052-fea2ff90e975"]
}, Open  ]]
}, Open  ]],

