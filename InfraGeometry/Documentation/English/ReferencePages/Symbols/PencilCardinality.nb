Cell["Two rays leave the middle of a path.", "ExampleText",ExpressionUUID->"c1b64088-5d67-4707-875c-5e9383a5eee3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PencilCardinality", "[", 
  RowBox[{
   RowBox[{"PathGraph", "[", 
    RowBox[{"Range", "[", "7", "]"}], "]"}], ",", " ", "4"}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"d2ae03dd-032d-46df-95c2-ee818f8dc3ce"],

Cell[BoxData["2"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"413c7a1f-f49e-4118-8ec1-041b89d3564e"]
}, Open  ]],

Cell["\<\
Two leave a vertex of the 6-cycle \[LongDash] both end at the antipode \
\[LongDash] and eight leave the centre of a 3 \[Times] 3 grid.\
\>", "ExampleText",ExpressionUUID->"9c709b31-d3da-4ede-a4e1-0f87c6e76703"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"PencilCardinality", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", "1"}], "]"}], ",", " ", 
   
   RowBox[{"PencilCardinality", "[", 
    RowBox[{
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], ",", " ", "5"}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0f7a2ddb-912f-4260-9cdf-683c1be91b1b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"e93f4313-1a9b-4e80-ba07-0a5cefb22aa5"]
}, Open  ]],

Cell["\<\
On the 3-cube every geodesic from a vertex runs to the antipode, so the \
pencil has 3! = 6 rays.\
\>", "ExampleText",ExpressionUUID->"3101c280-842e-42c2-aba1-238a294e4b89"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PencilCardinality", "[", 
  RowBox[{
   RowBox[{"HypercubeGraph", "[", "3", "]"}], ",", " ", "1"}], "]"}]], "Input",\

 CellLabel->"In[3]:= ",ExpressionUUID->"68949afc-bffc-4d7a-aff4-20de19c9f61c"],

Cell[BoxData["6"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"c7fb8abf-079c-4101-9222-316a63ec7de0"]
}, Open  ]],

Cell["\<\
The pencil at the centre of each substrate, counted without enumerating a ray.\
\>", "ExampleText",ExpressionUUID->"ea6b2cc4-b400-48ee-91ce-6dc0eafd52f9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"PencilCardinality", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], ",", 
    "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"0144e30f-a21f-4e8f-a1db-22f4869e7255"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"SquareMeshGraph\"\>", "\[Rule]", "1587"}], ",", 
   RowBox[{"\<\"SquareTilingGraph\"\>", "\[Rule]", "16380"}], ",", 
   RowBox[{"\<\"HexagonalTilingGraph\"\>", "\[Rule]", "762"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"0428d6f2-5c02-4220-b5dd-6a967f08593f"]
}, Open  ]]
}, Open  ]],

