Cell["Two rays leave the middle of a path.", "ExampleText",ExpressionUUID->"6ec80420-3b0c-41d3-9857-a4a4699e0c7a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PencilCardinality", "[", 
  RowBox[{
   RowBox[{"PathGraph", "[", 
    RowBox[{"Range", "[", "7", "]"}], "]"}], ",", " ", "4"}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"a90606ff-1128-4711-8645-11e5855ec256"],

Cell[BoxData["2"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"87b0a034-1d81-44ef-a084-bae24b4e819b"]
}, Open  ]],

Cell["\<\
Two leave a vertex of the 6-cycle \[LongDash] both end at the antipode \
\[LongDash] and eight leave the centre of a 3 \[Times] 3 grid.\
\>", "ExampleText",ExpressionUUID->"d48a1c02-cca2-4468-8988-86b8b21eeae0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"PencilCardinality", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", "1"}], "]"}], ",", " ", 
   
   RowBox[{"PencilCardinality", "[", 
    RowBox[{
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], ",", " ", "5"}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"28619e58-f915-483f-82e8-5435ad179c89"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"dd40b766-c0f2-4af5-aede-69fcca01431d"]
}, Open  ]],

Cell["\<\
On the 3-cube every geodesic from a vertex runs to the antipode, so the \
pencil has 3! = 6 rays.\
\>", "ExampleText",ExpressionUUID->"ac3fd069-c3c6-4867-94d7-e3f2988405d8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PencilCardinality", "[", 
  RowBox[{
   RowBox[{"HypercubeGraph", "[", "3", "]"}], ",", " ", "1"}], "]"}]], "Input",\

 CellLabel->"In[3]:= ",ExpressionUUID->"037dc2d4-2ab3-4fff-bf90-8fbbb14d7854"],

Cell[BoxData["6"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"92f80d05-1042-4ab5-b069-59d0bd5c8272"]
}, Open  ]],

Cell["\<\
The pencil at the centre of each substrate, counted without enumerating a ray.\
\>", "ExampleText",ExpressionUUID->"5c4a68b2-bde8-4d64-9409-e35d97085c31"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"PencilCardinality", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], ",", 
    "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"67dfc48f-7d29-48cb-b8cb-c226b8ddfc55"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"SquareMeshGraph\"\>", "\[Rule]", "1587"}], ",", 
   RowBox[{"\<\"SquareTilingGraph\"\>", "\[Rule]", "16380"}], ",", 
   RowBox[{"\<\"HexagonalTilingGraph\"\>", "\[Rule]", "762"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"39d0316b-22c1-4ae8-8907-36f332ba53b4"]
}, Open  ]]
}, Open  ]],

