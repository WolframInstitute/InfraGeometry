 CellLabel->"In[2]:= ",ExpressionUUID->"e9e7ac53-55e5-43df-a353-825259465d8d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "3"}], "}"}]], "Output",
