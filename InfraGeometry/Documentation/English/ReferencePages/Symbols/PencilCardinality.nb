Cell["The count equals the length of the enumerated pencil.", "ExampleText",ExpressionUUID->"8a3a18c4-68e7-44e3-ad12-ab8347b40a66"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"PencilCardinality", "[", 
      RowBox[{"g", ",", " ", "5"}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"PencilDirections", "[", 
       RowBox[{"g", ",", " ", "5"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1bbe76be-aba9-41b7-a182-3712e83d1d60"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"8", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"048ba8d6-2fde-4d00-9d5b-0e1a87bacdfa"]
}, Open  ]],

