Cell["Two rays leave the middle of a path.", "ExampleText",ExpressionUUID->"592908f4-7fdf-418b-a3b0-3315f7e94e94"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PencilCardinality", "[", 
  RowBox[{
   RowBox[{"PathGraph", "[", 
    RowBox[{"Range", "[", "7", "]"}], "]"}], ",", " ", "4"}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"056813b8-dd79-4cc6-8573-50a4d7306706"],

Cell[BoxData["2"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"3bc73ca0-6a87-4f91-9625-92ce362047d2"]
}, Open  ]],

Cell["\<\
Two leave a vertex of the 6-cycle \[LongDash] both end at the antipode \
\[LongDash] and eight leave the centre of a 3 \[Times] 3 grid.\
\>", "ExampleText",ExpressionUUID->"4a1605c2-391c-44e3-9494-bdfbc17f0bfb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"PencilCardinality", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", "1"}], "]"}], ",", " ", 
   
   RowBox[{"PencilCardinality", "[", 
    RowBox[{
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], ",", " ", "5"}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b3909766-c3ff-4b1c-8b94-1cd76245b48e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"03744554-61b2-43c5-9bf4-f63ff01b5305"]
}, Open  ]],

Cell["\<\
On the 3-cube every geodesic from a vertex runs to the antipode, so the \
pencil has 3! = 6 rays.\
\>", "ExampleText",ExpressionUUID->"0cfc9f9e-c297-4eca-a67f-1e8af84e722d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PencilCardinality", "[", 
  RowBox[{
   RowBox[{"HypercubeGraph", "[", "3", "]"}], ",", " ", "1"}], "]"}]], "Input",\

 CellLabel->"In[3]:= ",ExpressionUUID->"0d292051-cc49-4575-a986-b25f0ca69cd4"],

Cell[BoxData["6"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"ec929ce7-fbbe-4aaa-9540-0e173a9f792c"]
}, Open  ]],

Cell["\<\
The pencil at the centre of each substrate, counted without enumerating a ray.\
\>", "ExampleText",ExpressionUUID->"3759b491-71ff-4ead-828d-4a0148387294"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"PencilCardinality", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], ",", 
    "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"94afd9d1-efc2-45f6-8389-151e709b1f18"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"SquareMeshGraph\"\>", "\[Rule]", "1587"}], ",", 
   RowBox[{"\<\"SquareTilingGraph\"\>", "\[Rule]", "16380"}], ",", 
   RowBox[{"\<\"HexagonalTilingGraph\"\>", "\[Rule]", "762"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"b74ea6cc-3d5c-4a67-954c-dc3f3816d5a6"]
}, Open  ]]
}, Open  ]],

