Cell["\<\
The sum is often multivalued. The numbers of values of the sum of the steps \
right and up on the mesh, with their counts:\
\>", "ExampleText",ExpressionUUID->"34829fe8-5b65-4c65-a63b-9ed0b6010171"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"right", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "8"}], ",", " ", "0"}], "}"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{"up", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"1", "/", "8"}]}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"KeySort", " ", "@", " ", 
    RowBox[{"Counts", "[", 
     RowBox[{"Length", " ", "/@", " ", 
      RowBox[{"DisplacementSum", "[", 
       RowBox[{"g", ",", " ", "right", ",", " ", "up"}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1b98eb2e-c876-4570-b59b-14f0d4a50601"],

