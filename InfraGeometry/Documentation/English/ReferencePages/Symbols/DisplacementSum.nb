Cell["\<\
Where the two orders differ the sum takes their midpoints. On the 12-cycle \
the rotation followed by a reflection and the reflection followed by the \
rotation send 1 to 2 and to 12, and the sum sends 1 to the midpoint 1.\
\>", "ExampleText",ExpressionUUID->"1eb9862f-2b39-4a44-b159-7e45df3e00c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rotation", " ", "=", " ", 
      RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"reflection", " ", "=", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"2", " ", "-", " ", "#"}], ",", " ", "12", ",", " ", 
            "1"}], "]"}], "}"}], " ", "&"}], ",", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"DisplacementSum", "[", 
        RowBox[{"g", ",", " ", "rotation", ",", " ", "reflection"}], "]"}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"DisplacementCompose", "[", 
       RowBox[{"rotation", ",", " ", "reflection"}], "]"}], "[", "1", "]"}], ",",
      " ", 
     RowBox[{
      RowBox[{"DisplacementCompose", "[", 
       RowBox[{"reflection", ",", " ", "rotation"}], "]"}], "[", "1", "]"}], ",",
      " ", 
     RowBox[{
      RowBox[{"DisplacementSum", "[", 
       RowBox[{"g", ",", " ", "rotation", ",", " ", "reflection"}], "]"}], "[",
       "1", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"445d8097-f0d1-4851-b45e-7ca5aa5b2495"],

