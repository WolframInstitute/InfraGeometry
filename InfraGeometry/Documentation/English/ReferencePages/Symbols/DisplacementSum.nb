Cell["The sum is commutative:", "ExampleText",ExpressionUUID->"5b856278-8b01-4e32-aaf4-190b796f3735"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"right", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "8"}], ",", " ", "0"}], "}"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{"up", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"1", "/", "8"}]}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{
    RowBox[{"DisplacementSum", "[", 
     RowBox[{"g", ",", " ", "right", ",", " ", "up"}], "]"}], " ", "===", " ", 
    RowBox[{"DisplacementSum", "[", 
     RowBox[{"g", ",", " ", "up", ",", " ", "right"}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9c91791a-8766-4b4a-b5f5-d52e42c4daaf"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"5ba9468b-c9d8-4af6-b030-645394f962bc"]
}, Open  ]],

Cell["\<\
On the grid the two orders agree except at the rim, and the sum of the steps \
right and up is the diagonal step at 91 of the 96 vertices:\
\>", "ExampleText",ExpressionUUID->"5d7bf2c3-0b12-4f2a-900d-80e1dd28937d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sum", " ", "=", " ", 
     RowBox[{"DisplacementSum", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"TranslationDisplacement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"TranslationDisplacement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"diagonal", " ", "=", " ", 
     RowBox[{"TranslationDisplacement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"Count", "[", 
    RowBox[{
     RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
     RowBox[{"v_", " ", "/;", " ", 
      RowBox[{
       RowBox[{"sum", "[", "v", "]"}], " ", "===", " ", 
       RowBox[{"diagonal", "[", "v", "]"}]}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"fe9c251a-bd68-495a-8e68-33419ff717f0"],

Cell[BoxData["91"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"c0d8072b-209e-4304-96c9-e23267bfe528"]
}, Open  ]]
}, Open  ]],

