Cell["\<\
Two translations of the hexagonal tiling, blue and orange, their sum, and the \
translation by the sum of the two vectors. The sum is that translation at all \
but 10 of the 109 vertices, all at the rim.\
\>", "ExampleText",ExpressionUUID->"46f2a978-c721-4d6a-ba4d-9e31575fdfde"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"first", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"3", "/", "2"}], ",", " ", 
          RowBox[{
           RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}]}], "}"}]}], "]"}]}], ",",
      " ", 
     RowBox[{"second", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"3", "/", "2"}], ",", " ", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Sqrt", "[", "3", "]"}]}], "/", "2"}]}], "}"}]}], "]"}]}],
      ",", " ", 
     RowBox[{"both", " ", "=", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "0"}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"sum", " ", "=", " ", 
     RowBox[{"DisplacementSum", "[", 
      RowBox[{"g", ",", " ", "first", ",", " ", "second"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"DisplacementPlot", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{"first", ",", " ", "second"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"DisplacementPlot", "[", 
         RowBox[{"g", ",", " ", "sum"}], "]"}], ",", " ", 
        RowBox[{"DisplacementPlot", "[", 
         RowBox[{"g", ",", " ", "both"}], "]"}]}], "}"}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"v_", " ", "/;", " ", 
        RowBox[{
         RowBox[{"sum", "[", "v", "]"}], " ", "===", " ", 
         RowBox[{"both", "[", "v", "]"}]}]}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a311a225-ad99-4e58-a136-ffed8a4b75d3"],

