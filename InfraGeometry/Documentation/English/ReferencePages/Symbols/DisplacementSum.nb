Notebook[{

Cell[CellGroupData[{
Cell["DisplacementSum", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"36aea213-b21c-4690-80d4-208b90180b55"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementSum"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementSum", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87cabe9f-296b-4d46-ba49-c0898855f5e6"],
 "\[LineSeparator]",
 "is the sum of the displacements ",
 StyleBox["d1", "TI"],
 " and ",
 StyleBox["d2", "TI"],
 ": at each vertex the midpoints of the two orders of composition.",
 "\n"
}], "Usage",ExpressionUUID->"443ffc20-f5f3-4c93-8742-734094daf1c1"],

Cell[TextData[{
 "The sum ",
 StyleBox["(D\:2081 + D\:2082)(v)", "TI"],
 " is the union of the midpoints of ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ", over ",
 StyleBox["p \[Element] (D\:2082 \[SmallCircle] D\:2081)(v)", "TI"],
 " and ",
 StyleBox["q \[Element] (D\:2081 \[SmallCircle] D\:2082)(v)", "TI"],
 ". The midpoints are the vertices of the interval from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " nearest its middle, the straightest kept, as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementScale"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementScale", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      StyleBox["p", "TI"], " ", "->", " ", 
      RowBox[{"{", 
       StyleBox["q", "TI"], "}"}]}], "|>"}], ",", " ", 
    RowBox[{"1", "/", "2"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5996b718-b58f-4ed9-a026-d9b9bc4a9585"],
 " gives them."
}], "Notes",ExpressionUUID->"016fe2a2-be27-4388-a608-620a02cfef15"],

Cell[TextData[{
 "For two flows at scale ",
 StyleBox["r", "TI"],
 " the two orders are ",
 StyleBox["exp(X + Y \[PlusMinus] [X, Y]/2 + O(r\.b3))", "TI"],
 " by the Baker\[Dash]Campbell\[Dash]Hausdorff formula. Their midpoint is ",
 StyleBox["exp(X + Y)", "TI"],
 " up to ",
 StyleBox["O(r\.b3)", "TI"],
 ": the bracket cancels."
}], "Notes",ExpressionUUID->"387e3765-422e-4038-96f6-1ddee7234bc6"],

Cell["\<\
The sum is commutative. Where the two orders agree in a single vertex, the \
sum is that vertex.\
\>", "Notes",ExpressionUUID->"2339612e-c07a-4d7a-80b2-05e45cc4ca66"],

Cell[TextData[{
 "Ties are kept. Two vertices at odd distance have two midpoints, so the sum \
is often multivalued; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementReduce"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementReduce", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "89f5d6b3-cbc3-47ed-adaf-90e910969ffa"],
 " contracts what the metric decides."
}], "Notes",ExpressionUUID->"0c5e6844-6033-4611-95dc-d7caa267c782"]
}, Open  ]],

