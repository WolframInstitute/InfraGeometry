Cell["\<\
The sum of a displacement with itself is twice it where the shortest paths \
continue. On the cycle it is the rotation by two steps.\
\>", "ExampleText",ExpressionUUID->"8060a89a-2599-4743-9386-831d9c688b81"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"rotation", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"DisplacementSum", "[", 
        RowBox[{"g", ",", " ", "rotation", ",", " ", "rotation"}], "]"}]}], 
      "]"}], ",", " ", 
     RowBox[{
      RowBox[{"DisplacementSum", "[", 
       RowBox[{"g", ",", " ", "rotation", ",", " ", "rotation"}], "]"}], " ", 
      "===", " ", 
      RowBox[{"DisplacementScale", "[", 
       RowBox[{"g", ",", " ", "rotation", ",", " ", "2"}], "]"}]}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9e25053f-40f9-45a9-b385-7fd0bb76b647"],

