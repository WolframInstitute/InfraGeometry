Cell["\<\
The sum of the steps right and up, on the square grid and on the square mesh:\
\
\>", "ExampleText",ExpressionUUID->"18b24188-12c9-48a1-9baf-ce2d4ff8ab16"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"KeyValueMap", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name", ",", " ", "s"}], "}"}], " ", "|->", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"DisplacementPlot", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"DisplacementSum", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"TranslationDisplacement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", 
              RowBox[{"s", ",", " ", "0"}], "}"}]}], "]"}], ",", " ", 
           RowBox[{"TranslationDisplacement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "s"}], "}"}]}], "]"}]}], "]"}]}], 
        "]"}]}], "]"}]}], ",", "\n", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<SquareGridGraph\>\"", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"\"\<SquareMeshGraph\>\"", " ", "->", " ", 
       RowBox[{"1", "/", "8"}]}]}], "|>"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"26ef9b53-8ce4-413d-9514-b8fff180bc2c"],

