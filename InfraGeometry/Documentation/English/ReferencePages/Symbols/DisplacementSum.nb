Notebook[{

Cell[CellGroupData[{
Cell["DisplacementSum", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f695e573-121a-471b-93e5-9896a77df9c3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementSum"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementSum", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d1", "TI"], ",", " ", 
    StyleBox["d2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f6463ff-9192-4d24-a3f4-5ee40c66e2c8"],
 "\[LineSeparator]",
 "is the sum of the displacements ",
 StyleBox["d1", "TI"],
 " and ",
 StyleBox["d2", "TI"],
 ": at each vertex the midpoints between the two orders of composition, ",
 StyleBox["d2", "TI"],
 " after ",
 StyleBox["d1", "TI"],
 " and ",
 StyleBox["d1", "TI"],
 " after ",
 StyleBox["d2", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"a134294b-fcb3-47d9-82ff-edaf85f06b3b"],

Cell[TextData[{
 "Definition: ",
 StyleBox["(D1 + D2)(v)", "TI"],
 " is the union, over ",
 StyleBox["p \[Element] (D2 \[SmallCircle] D1)(v)", "TI"],
 " and ",
 StyleBox["q \[Element] (D1 \[SmallCircle] D2)(v)", "TI"],
 ", of the midpoints of ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ": the vertices of the interval from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " nearest its middle, the straightest kept, as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementScale"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementScale", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      StyleBox["p", "TI"], " ", "->", " ", 
      RowBox[{"{", 
       StyleBox["q", "TI"], "}"}]}], "|>"}], ",", " ", 
    RowBox[{"1", "/", "2"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae1a1d3b-a455-4d74-9fae-cd69c614945a"],
 " gives them."
}], "Notes",ExpressionUUID->"52cd89a0-d04b-45d7-a0d2-3829aea7c822"],

Cell[TextData[{
 "The reason is the Baker\[Dash]Campbell\[Dash]Hausdorff formula. For the \
flows of two vector fields at scale ",
 StyleBox["r", "TI"],
 " the two orders are ",
 StyleBox["exp(X + Y \[PlusMinus] [X, Y]/2 + O(r\.b3))", "TI"],
 ", so their midpoint is ",
 StyleBox["exp(X + Y)", "TI"],
 " up to ",
 StyleBox["O(r\.b3)", "TI"],
 ": the bracket terms cancel without being computed."
}], "Notes",ExpressionUUID->"2f7148ad-5004-4aa4-96d1-281c98c9c3e9"],

Cell[TextData[{
 "The sum is exactly commutative, ",
 StyleBox["D1 + D2 = D2 + D1", "TI"],
 ": swapping the summands swaps the two orders, and the midpoints of ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " are those of ",
 StyleBox["q", "TI"],
 " and ",
 StyleBox["p", "TI"],
 ". When the two orders agree at ",
 StyleBox["v", "TI"],
 ", the sum there is the composite."
}], "Notes",ExpressionUUID->"fe8605f3-c9b1-4557-8a2b-b6bf2e4ead5c"],

Cell[TextData[{
 "Ties are kept. When ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " are an odd distance apart, the vertices on both sides of the middle are \
equally near it, so the sum can have several values; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementReduce"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementReduce", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "388281e7-ca36-45be-a154-0bb7e2ab2587"],
 " contracts what the metric decides."
}], "Notes",ExpressionUUID->"671de22c-61cf-490b-afed-fecade31c963"]
}, Open  ]],

