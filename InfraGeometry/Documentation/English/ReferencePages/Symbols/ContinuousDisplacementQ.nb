Cell["\<\
Exchanging two neighbours of the grid is not 1-continuous: a third neighbour \
of one stays, two steps from the other. It is 2-continuous:\
\>", "ExampleText",ExpressionUUID->"ecaebd70-439f-4953-b732-0e8eb863e35d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"swap", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"AssociationMap", "[", 
        RowBox[{"List", ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"c", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"c", " ", "+", " ", "1"}], "}"}]}], ",", " ", 
         RowBox[{
          RowBox[{"c", " ", "+", " ", "1"}], " ", "->", " ", 
          RowBox[{"{", "c", "}"}]}]}], "|>"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ContinuousDisplacementQ", "[", 
      RowBox[{"g", ",", " ", "swap"}], "]"}], ",", " ", 
     RowBox[{"ContinuousDisplacementQ", "[", 
      RowBox[{"g", ",", " ", "swap", ",", " ", "2"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f38ad732-5141-4f55-b783-a1ca0e458895"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"44852589-d794-41f9-8386-25a7dc4dc466"]
}, Open  ]]
}, Open  ]],

