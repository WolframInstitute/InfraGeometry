Cell["\<\
A single-valued 1-continuous displacement increases no distance. A random \
displacement of the mesh, over all pairs of vertices:\
\>", "ExampleText",ExpressionUUID->"a418cce7-dc06-4b68-84bc-6d7da70e0d8f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"d", " ", "=", " ", 
     RowBox[{"RandomDisplacement", "[", 
      RowBox[{"g", ",", " ", "2", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"First", " ", "/@", " ", "d"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ContinuousDisplacementQ", "[", 
      RowBox[{"g", ",", " ", "d"}], "]"}], ",", "\n", "   ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Subsets", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"f", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{"f", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}], " ", "<=", " ", 
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], " ", "&"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cf3c5f04-516b-46c8-bc1d-7f327b19017d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b1ad4737-e4b1-4d58-bba2-46b2c7d51d84"]
}, Open  ]],

Cell["A composite of 1-continuous displacements is 1-continuous:", \
"ExampleText",ExpressionUUID->"86e94c62-e981-4837-9258-6de5f48cc51a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"d1", " ", "=", " ", 
      RowBox[{"RandomDisplacement", "[", 
       RowBox[{"g", ",", " ", "1", ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], ",", " ", 
     RowBox[{"d2", " ", "=", " ", 
      RowBox[{"RandomDisplacement", "[", 
       RowBox[{"g", ",", " ", "2", ",", " ", 
