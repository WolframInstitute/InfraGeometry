 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7820a408-1d34-45bd-83fe-3b35abb9f8db"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ContinuousDisplacementQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ContinuousDisplacementQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f402c613-951c-44ab-96d5-fc3180e38c78"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "70cefa01-9e3d-497b-b7ea-b67a1e4c74ed"],
 " when the displacement ",
 StyleBox["d", "TI"],
 " is 1-continuous: the values at the two ends of every edge of ",
 StyleBox["g", "TI"],
 " are at most one step apart.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d22ee965-ebc6-444c-9af3-395770a54f83"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ContinuousDisplacementQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ContinuousDisplacementQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f5e9437-7981-4197-bec0-6f4e4d990b02"],
 "\[LineSeparator]",
 "tests ",
 StyleBox["k", "TI"],
 "-continuity: at most ",
 StyleBox["k", "TI"],
 " steps apart."
}], "Usage",ExpressionUUID->"0c2511a2-c802-4c88-b57e-702e1a694bac"],

Cell[TextData[{
 StyleBox["D", "TI"],
 " is ",
 StyleBox["k", "TI"],
 "-continuous when ",
 StyleBox["\[Delta](D(u), D(v)) \[LessEqual] k", "TI"],
 " for every edge ",
 StyleBox["uv", "TI"],
 " of ",
 StyleBox["g", "TI"],
 ", with ",
 StyleBox["\[Delta]", "TI"],
 " a distance between sets of vertices."
}], "Notes",ExpressionUUID->"5f9cf227-e38f-4e3b-a1aa-f54c5d94b523"],

Cell[TextData[{
 "A single-valued displacement is 1-continuous exactly when it increases no \
distance, ",
 StyleBox["d(D(u), D(v)) \[LessEqual] d(u, v)", "TI"],
 ": the condition on edges carries along shortest paths. It is the discrete \
counterpart of a 1-Lipschitz map."
}], "Notes",ExpressionUUID->"e7231471-e5a0-4d63-82ab-106c278d3c39"],

Cell[TextData[{
 "Composites of 1-continuous displacements are 1-continuous. A 1-continuous \
bijection is an automorphism (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementIsomorphismQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementIsomorphismQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d2223d92-269e-4566-8db2-3fcee128b443"],
 ")."
}], "Notes",ExpressionUUID->"eb453475-6ef6-499a-9ad2-db96aea3b564"],

