Cell["\<\
The angular displacement about the centre of the mesh is 2-continuous, not \
1-continuous:\
\>", "ExampleText",ExpressionUUID->"eb6db339-1ed0-4461-a47c-008e8225a653"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"angular", " ", "=", " ", 
     RowBox[{"Last", " ", "@", " ", 
      RowBox[{"PolarDisplacements", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ContinuousDisplacementQ", "[", 
      RowBox[{"g", ",", " ", "angular", ",", " ", "k"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c5317857-e913-44ce-a281-3098e8940e0c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"54b6af5f-7fbf-48bb-b965-8343a95ca230"]
}, Open  ]]
}, Open  ]],

