Cell[CellGroupData[{

Cell["Method", "ExampleSubsection",ExpressionUUID->"e8ad83df-d50d-4d1e-9b56-47353a4bb666"],

Cell[TextData[{
 "The radial displacement of the grid has several values at most vertices. It \
is weakly 1-continuous, but in the Hausdorff and the strong sense only \
3-continuous; the rows are the methods, the columns ",
 StyleBox["k", "TI"],
 " = 1, 2, 3:"
}], "ExampleText",ExpressionUUID->"4bc20039-50cf-42f8-86c7-f6b4c8ef579e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"radial", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"PolarDisplacements", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ContinuousDisplacementQ", "[", 
      RowBox[{"g", ",", " ", "radial", ",", " ", "k", ",", " ", 
       RowBox[{"Method", " ", "->", " ", "method"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"method", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Weak\>\"", ",", " ", "\"\<Hausdorff\>\"", ",", 
         " ", "\"\<Strong\>\""}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e8071b34-e945-411a-9e1d-a671b41feffc"],

Cell[BoxData[
 RowBox[{"{", 
