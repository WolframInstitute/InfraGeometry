Cell[TextData[{
 "A ",
 StyleBox["k", "TI"],
 "-form has at every vertex ",
 StyleBox["v", "TI"],
 " a germ on the ",
 StyleBox["k", "TI"],
 "-tuples of neighbours of ",
 StyleBox["v", "TI"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FormValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FormValue", 
