Cell["\<\
The zero form has no degree, and the call stays unevaluated. Every germ of \
the gradient of a constant is empty:\
\>", "ExampleText",ExpressionUUID->"a347202b-df36-4a70-8d00-dc3cdbea3c5a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"df", " ", "=", " ", 
     RowBox[{"FormDifferential", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"ZeroForm", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"1", " ", "&"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Union", " ", "@", " ", 
      RowBox[{"Values", "[", "df", "]"}]}], ",", " ", 
     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"FormDegree", "[", "df", "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ec4524f3-a88e-4dc8-bbd2-3b75805c3e88"],

