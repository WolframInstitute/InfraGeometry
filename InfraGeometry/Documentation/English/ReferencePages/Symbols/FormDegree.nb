Cell[TextData[{
 "A 0-form, its gradient and a wedge of two gradients on the square grid. The \
grid has no triangles, yet the 2-form ",
 StyleBox["dx \[And] dy", "TI"],
 " is not 0:"
}], "ExampleText",ExpressionUUID->"939da93f-e7f4-4f85-a44e-2fc79fbd2d15"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", " ", "=", " ", 
      RowBox[{"ZeroForm", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], "]"}]}], 
     ",", "\n", "   ", 
     RowBox[{"y", " ", "=", " ", 
      RowBox[{"ZeroForm", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"FormDegree", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", 
      RowBox[{"FormDifferential", "[", 
       RowBox[{"g", ",", " ", "x"}], "]"}], ",", " ", 
      RowBox[{"FormWedge", "[", 
       RowBox[{
        RowBox[{"FormDifferential", "[", 
         RowBox[{"g", ",", " ", "x"}], "]"}], ",", " ", 
        RowBox[{"FormDifferential", "[", 
         RowBox[{"g", ",", " ", "y"}], "]"}]}], "]"}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9683d298-9122-4261-a982-71b6eefd72e8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "1", ",", "2"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"eaa16c12-4e5a-44ef-9103-f0488c3017f3"]
}, Open  ]]
}, Open  ]],

