Cell[TextData[{
 "The zero form has no degree to read: every germ of the gradient of a \
constant is empty. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FormDegree"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FormDegree", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "865cc45d-8ba9-4789-820f-b3a7eda70344"],
 " then issues messages and returns 1; the call is wrapped in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Quiet"]], "paclet:ref/Quiet"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1221cc80-133e-4cd4-a197-1ed95a84d83d"],
 " here."
}], "ExampleText",ExpressionUUID->"62d87c30-8f2f-47db-8848-e637f21143a6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"gradient", " ", "=", " ", 
     RowBox[{"FormDifferential", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"ZeroForm", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"1", " ", "&"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"AssociationMap", "[", 
        RowBox[{
         RowBox[{"1", " ", "&"}], ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"Union", "[", 
      RowBox[{"Length", " ", "/@", " ", 
       RowBox[{"Values", "[", "gradient", "]"}]}], "]"}], ",", " ", 
     RowBox[{"Quiet", " ", "@", " ", 
      RowBox[{"FormDegree", "[", "gradient", "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2fa72ae8-daab-434f-8003-6e4e10d57deb"],

