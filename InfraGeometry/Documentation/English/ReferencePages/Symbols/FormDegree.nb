   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d4819e89-dc9f-4e04-b409-06b12d74d816"],
 ")."
}], "Notes",ExpressionUUID->"dddfb23d-2d8c-4023-b5e6-53fc1a2fecd9"],

Cell["\<\
The degree is read off a germ that holds a value. The zero form, all of whose \
germs are empty, has no degree.\
\>", "Notes",ExpressionUUID->"b08cd1bb-5999-403c-aa9f-3d135d665873"],

