Cell[TextData[{
 "Definition: a ",
 StyleBox["k", "TI"],
 "-form takes its germs on the ",
 StyleBox["k", "TI"],
 "-tuples of neighbours of each vertex, and ",
 StyleBox["k", "TI"],
 " is its degree."
}], "Notes",ExpressionUUID->"9637bd0d-5713-4bef-a905-5a52f3ac5e99"],

Cell["\<\
The degree is read off the first germ that holds a value. A form whose germs \
hold tuples of different lengths is not a form of one degree.\
\>", "Notes",ExpressionUUID->"8c66c913-4d7f-49ae-8046-1883af27e838"],

