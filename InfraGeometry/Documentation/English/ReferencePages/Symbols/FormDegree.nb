Cell["\<\
A 0-form, its gradient and the wedge of two gradients on the triangular \
tiling, of degrees 0, 1 and 2. The 0-form is the distance from the centre, \
drawn by its values; the 1-form is drawn by its steps, blue where it is \
positive and orange where it is negative; the 2-form by its germ at the \
centre, a matrix over the pairs of neighbours.\
\>", "ExampleText",ExpressionUUID->"cdfa3cf3-77ed-4c0e-ad77-f4b9e875766b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"center", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"apex", " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"FindInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"center", ",", " ", "3"}], "]"}]}], "]"}]}], ")"}]}], ",", 
     " ", 
     RowBox[{"form", " ", "=", " ", 
      RowBox[{"ZeroForm", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "center", ",", " ", "#"}], "]"}], " ", 
         "&"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"gradient", " ", "=", " ", 
     RowBox[{"FormDifferential", "[", 
      RowBox[{"g", ",", " ", "form"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"twoForm", " ", "=", " ", 
     RowBox[{"FormWedge", "[", 
      RowBox[{"gradient", ",", " ", 
       RowBox[{"FormDifferential", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"ZeroForm", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "apex", ",", " ", "#"}], "]"}], " ", 
            "&"}]}], "]"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\n", "     ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"First", " ", "/@", " ", "form"}]}], "]"}], ",", "\n", 
        "     ", 
        RowBox[{"DisplacementPlot", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{"Catenate", " ", "@*", " ", "Keys", " ", "@*", " ", 
               RowBox[{"Select", "[", "Positive", "]"}]}], ",", " ", 
              "gradient"}], "]"}], ",", " ", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{"Catenate", " ", "@*", " ", "Keys", " ", "@*", " ", 
               RowBox[{"Select", "[", "Negative", "]"}]}], ",", " ", 
              "gradient"}], "]"}]}], "}"}]}], "]"}], ",", "\n", "     ", 
        RowBox[{"MatrixPlot", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"FormValue", "[", 
            RowBox[{"twoForm", ",", " ", "center", ",", " ", 
             RowBox[{"{", 
              RowBox[{"nbr", ",", " ", "neighbour"}], "}"}]}], "]"}], ",", 
           " ", 
           RowBox[{"{", 
            RowBox[{"nbr", ",", " ", 
             RowBox[{"AdjacencyList", "[", 
              RowBox[{"g", ",", " ", "center"}], "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"neighbour", ",", " ", 
             RowBox[{"AdjacencyList", "[", 
              RowBox[{"g", ",", " ", "center"}], "]"}]}], "}"}]}], "]"}], 
         "]"}]}], "}"}], "]"}], ",", "\n", "   ", 
     RowBox[{"FormDegree", " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"form", ",", " ", "gradient", ",", " ", "twoForm"}], "}"}]}]}],
     "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"65292860-6c4b-4b31-b29d-9ef14ad65fcb"],

