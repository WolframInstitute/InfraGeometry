Cell["\<\
Over a spanning tree of the 3 \[Times] 3 grid all 2\:2078 = 256 connections \
are flat:\
\>", "ExampleText",ExpressionUUID->"695e427a-7d73-48e6-ada4-a09c98003a1d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"FindSpanningTree", "[", 
        RowBox[{"GridGraph", "[", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", "\n", "    ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conns", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "conns", "]"}], ",", " ", 
     RowBox[{"InfraFlatConnectionQ", "[", 
      RowBox[{"fib", ",", " ", "conns"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"295b37aa-685e-4532-95f4-b16a04e731e2"],

