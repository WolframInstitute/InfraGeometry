Cell["\<\
All complete connections on this path base have trivial global monodromy.\
\>", "ExampleText",ExpressionUUID->"c450a610-023c-4c8e-a5c0-89ac17f60281"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"PathGraph", "[", " ", 
        RowBox[{"Range", "[", " ", "3", " ", "]"}], " ", "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "2", " ", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "0", " ", "}"}]}], ",", "\n", "      ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", " ", "\"\<IsomorphicFibers\>\"", " ", "}"}]}], ",", " ", 
       
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}]}], "\n",
       "    ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"connections", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", " ", 
      RowBox[{"fib", ",", " ", "All"}], " ", "]"}]}], " ", "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", "connections"}], ",", " ", 
     RowBox[{"InfraFlatConnectionQ", "[", " ", 
      RowBox[{"fib", ",", " ", "connections"}], " ", "]"}]}], " ", "}"}]}], 
  "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6eb2862e-da67-4ba3-af4f-be5ecf5b85af"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6c1718c5-4d9a-4667-8fcd-6540bec61299"]
}, Open  ]]
}, Open  ]],

