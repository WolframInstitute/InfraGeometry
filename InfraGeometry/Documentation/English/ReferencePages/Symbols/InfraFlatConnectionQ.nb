 CellID->2123667759,ExpressionUUID->"0e0d5f37-f3c9-4474-a22b-9f10dcc8b438"],

Cell["\<\
The horizontal leaves are the components of the connection graph. The prism \
has two leaves, each meeting every fiber once; the Moebius ladder has one, \
meeting every fiber twice:\
\>", "ExampleText",ExpressionUUID->"c377a1fb-b6f0-418d-a743-19a8c6973528"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fib", " ", "=", " ", 
       RowBox[{"InfraFiberedSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"conn", " ", "=", " ", 
       RowBox[{"RandomInfraConnection", "[", 
        RowBox[{"fib", ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"Length", " ", "/@", " ", 
      RowBox[{"ConnectedComponents", " ", "@", " ", 
       RowBox[{"Graph", "[", 
        RowBox[{
         RowBox[{"VertexList", " ", "@", " ", 
          RowBox[{"InfraTotalSpace", "[", "fib", "]"}]}], ",", " ", 
         RowBox[{"First", " ", "@", " ", "conn"}]}], "]"}]}]}]}], "]"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<CycleProductBundle\>\"", ",", 
       " ", "\"\<MoebiusLadderCover\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"78cb38a8-24dd-45df-becc-276d2463c819"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"8", ",", "8"}], "}"}], ",", 
   RowBox[{"{", "16", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"fe861d33-ee6e-48c0-b638-055ef2ba298a"]
}, Open  ]],

Cell["\<\
On the grid the two faces decide: a connection is flat exactly when its \
holonomy around both faces is the identity:\
\>", "ExampleText",ExpressionUUID->"23a10b61-4a45-4ebb-98b2-1754478c8c89"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       "\n", "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conns", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{"conns", ",", " ", 
     RowBox[{"conn", " ", "|->", " ", 
      RowBox[{
       RowBox[{"InfraFlatConnectionQ", "[", 
        RowBox[{"fib", ",", " ", "conn"}], "]"}], " ", "===", "\n", "    ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "1", ",", " ", "2", ",", " ", "4", ",", " ", "3", ",", " ", "1"}],
             "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
            "3", ",", " ", "4", ",", " ", "6", ",", " ", "5", ",", " ", "3"}],
             "}"}]}], "}"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraHolonomy", "[", 
            RowBox[{"fib", ",", " ", "conn", ",", " ", "#"}], "]"}], " ", "===",
            " ", 
           RowBox[{"Cycles", "[", 
            RowBox[{"{", "}"}], "]"}]}], " ", "&"}]}], "]"}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b910eb5e-89d6-4213-af03-4703e4e46294"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"2c6301a2-9562-4269-ac10-8b57a13bea94"]
}, Open  ]]
}, Open  ]],

