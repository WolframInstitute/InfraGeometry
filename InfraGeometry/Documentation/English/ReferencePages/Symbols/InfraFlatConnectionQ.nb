Cell["\<\
Two separate cycles give trivial monodromy. One cycle covering the base twice \
exchanges the sheets.\
\>", "ExampleText",ExpressionUUID->"1e63fdc3-9159-403b-8420-a2e32397eacf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"totals", " ", "=", " ", 
     RowBox[{"{", "\n", "      ", 
      RowBox[{
       RowBox[{"Graph", "[", " ", 
        RowBox[{
         RowBox[{"Range", "[", " ", "8", " ", "]"}], ",", " ", 
         RowBox[{"Join", "[", " ", 
          RowBox[{
           RowBox[{"EdgeList", " ", "@", " ", 
            RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}]}], ",", " ", 
           RowBox[{"EdgeList", " ", "@", " ", 
            RowBox[{"IndexGraph", "[", " ", 
             RowBox[{
              RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}], ",", " ", 
              "5"}], " ", "]"}]}]}], " ", "]"}]}], " ", "]"}], ",", "\n", 
       "      ", 
       RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}]}], "\n", "    ", 
      "}"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"fibrations", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraFiberedGraph", "[", " ", 
         RowBox[{"#", ",", " ", 
          RowBox[{"vertex", " ", "|->", " ", 
           RowBox[{"Mod", "[", " ", 
            RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
         " ", "]"}], " ", "&"}], " ", "/@", " ", "totals"}]}], ",", "\n", 
     "    ", 
     RowBox[{"connections", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraConnection", "[", " ", 
         RowBox[{"EdgeList", " ", "@", " ", "#"}], " ", "]"}], " ", "&"}], 
       " ", "/@", " ", "totals"}]}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"MapThread", "[", " ", 
       RowBox[{"InfraFiberedGraphHighlight", ",", " ", 
        RowBox[{"{", " ", 
         RowBox[{"fibrations", ",", " ", "connections"}], " ", "}"}]}], " ", 
       "]"}]}], ",", "\n", "    ", 
     RowBox[{"MapThread", "[", " ", 
      RowBox[{"InfraFlatConnectionQ", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"fibrations", ",", " ", "connections"}], " ", "}"}]}], " ", 
      "]"}]}], " ", "}"}]}], "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c9c42f11-0a4a-4574-a1e4-d4bbb8bc345b"],

