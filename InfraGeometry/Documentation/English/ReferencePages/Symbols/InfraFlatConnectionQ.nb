Cell["\<\
A walk in the connection graph projects to a walk of the base with the same \
transport. So every holonomy is trivial iff no horizontal leaf meets a fiber \
twice.\
\>", "Notes",ExpressionUUID->"49107770-338a-42e4-875c-101592fdb88e"],

Cell[TextData[{
 StyleBox["conn", "TI"],
 " must first satisfy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "24264897-6b23-4886-ac96-f410854c799e"],
 "."
}], "Notes",ExpressionUUID->"b5c883bf-9c29-471f-ba36-50d0e332c09d"]
}, Open  ]],

