Cell["\<\
Fibers of two points over the 2 \[Times] 3 grid, joined completely. Of the 2\
\:2077 = 128 connections, 2\:2075 = 32 are flat:\
\>", "ExampleText",ExpressionUUID->"8e39b37c-417a-40af-8a88-987bc6c96e2c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       "\n", "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conns", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "conns", "]"}], ",", " ", 
     RowBox[{"Count", "[", 
      RowBox[{"conns", ",", " ", 
       RowBox[{"conn_", " ", "/;", " ", 
        RowBox[{"InfraFlatConnectionQ", "[", 
         RowBox[{"fib", ",", " ", "conn"}], "]"}]}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"057c49f0-f7ea-47cd-86fb-13fb6fc5fcf7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"128", ",", "32"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"120c76de-1166-4d85-9e02-ed822ec68dbe"]
}, Open  ]]
}, Open  ]],

