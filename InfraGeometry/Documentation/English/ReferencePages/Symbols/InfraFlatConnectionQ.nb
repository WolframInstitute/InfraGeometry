Cell["\<\
Two separate cycles give trivial monodromy. One cycle covering the base twice \
exchanges the sheets.\
\>", "ExampleText",ExpressionUUID->"9ca5a205-4244-4543-828e-4e08d33677a6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"totals", " ", "=", " ", 
     RowBox[{"{", "\n", "      ", 
      RowBox[{
       RowBox[{"Graph", "[", " ", 
        RowBox[{
         RowBox[{"Range", "[", " ", "8", " ", "]"}], ",", " ", 
         RowBox[{"Join", "[", " ", 
          RowBox[{
           RowBox[{"EdgeList", " ", "@", " ", 
            RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}]}], ",", " ", 
           RowBox[{"EdgeList", " ", "@", " ", 
            RowBox[{"IndexGraph", "[", " ", 
             RowBox[{
              RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}], ",", " ", 
              "5"}], " ", "]"}]}]}], " ", "]"}]}], " ", "]"}], ",", "\n", 
       "      ", 
       RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}]}], "\n", "    ", 
      "}"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"fibrations", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraFiberedGraph", "[", " ", 
         RowBox[{"#", ",", " ", 
          RowBox[{"vertex", " ", "|->", " ", 
           RowBox[{"Mod", "[", " ", 
            RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
         " ", "]"}], " ", "&"}], " ", "/@", " ", "totals"}]}], ",", "\n", 
     "    ", 
     RowBox[{"connections", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraConnection", "[", " ", 
         RowBox[{"EdgeList", " ", "@", " ", "#"}], " ", "]"}], " ", "&"}], 
       " ", "/@", " ", "totals"}]}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"MapThread", "[", " ", 
       RowBox[{"InfraFiberedGraphHighlight", ",", " ", 
        RowBox[{"{", " ", 
         RowBox[{"fibrations", ",", " ", "connections"}], " ", "}"}]}], " ", 
       "]"}]}], ",", "\n", "    ", 
     RowBox[{"MapThread", "[", " ", 
      RowBox[{"InfraFlatConnectionQ", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"fibrations", ",", " ", "connections"}], " ", "}"}]}], " ", 
      "]"}]}], " ", "}"}]}], "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3204a7c8-2847-4a2c-b1cf-d6ae678a4aad"],

