Cell["\<\
The holonomy around the cycle is trivial on the prism and swaps the sheets on \
the Moebius ladder.\
\>", "ExampleText",ExpressionUUID->"14b50443-e4ce-4e7b-b6b8-29bc4003c503"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fib", " ", "=", " ", 
       RowBox[{"InfraFiberedSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"conn", " ", "=", " ", 
       RowBox[{"InfraConnection", " ", "@", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"EdgeList", " ", "@", " ", 
           RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"First", " ", "@", " ", "#"}]}], " ", "=!=", " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"Last", " ", "@", " ", "#"}]}]}], " ", "&"}]}], 
         "]"}]}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"name", " ", "->", " ", 
      RowBox[{"InfraHolonomy", "[", 
       RowBox[{"fib", ",", " ", "conn", ",", " ", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"Range", "[", "8", "]"}], ",", " ", "1"}], "]"}]}], 
       "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<CycleProductBundle\>\"", ",", 
       " ", "\"\<MoebiusLadderCover\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"69c3013a-7e84-44a3-9f57-603302c0af2d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"CycleProductBundle\"\>", "\[Rule]", 
    RowBox[{"Cycles", "[", 
     RowBox[{"{", "}"}], "]"}]}], ",", 
   RowBox[{"\<\"MoebiusLadderCover\"\>", "\[Rule]", 
    RowBox[{"Cycles", "[", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "}"}], "]"}]}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"dd6ccc11-a2b7-49e6-a828-692bb129cdc1"]
}, Open  ]]
}, Open  ]],

