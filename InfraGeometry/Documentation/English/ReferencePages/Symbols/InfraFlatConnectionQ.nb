Cell["\<\
The horizontal leaves of the prism, each in its own colour: two sheets, each \
meeting every fiber once. The connection is flat.\
\>", "ExampleText",ExpressionUUID->"02224b8d-89d4-4bd8-9c59-189af8ed037a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<CycleProductBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"InfraConnection", " ", "@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"EdgeList", "[", "total", "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"First", " ", "@", " ", "#"}]}], " ", "=!=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Last", " ", "@", " ", "#"}]}]}], " ", "&"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"total", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraDensity", "[", 
          RowBox[{"total", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"ConnectedComponents", " ", "@", " ", 
         RowBox[{"Graph", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "total", "]"}], ",", " ", 
           RowBox[{"First", " ", "@", " ", "conn"}]}], "]"}]}]}]}], "]"}], ",",
      "\n", "    ", 
     RowBox[{"InfraFlatConnectionQ", "[", 
      RowBox[{"fib", ",", " ", "conn"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"bce29dde-40d8-4ab8-8930-b7544e681d11"],

