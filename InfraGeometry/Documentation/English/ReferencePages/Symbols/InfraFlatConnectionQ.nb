Cell["\<\
All complete connections on this path base have trivial global monodromy.\
\>", "ExampleText",ExpressionUUID->"93823e10-038c-4255-b609-c2b96b817298"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"PathGraph", "[", " ", 
        RowBox[{"Range", "[", " ", "3", " ", "]"}], " ", "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "2", " ", "}"}]}], ",", " ", 
       RowBox[{"\"\<VerticalEdgeCount\>\"", " ", "->", " ", 
        RowBox[{"{", " ", "0", " ", "}"}]}], ",", "\n", "      ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", " ", "\"\<IsomorphicFibers\>\"", " ", "}"}]}], ",", " ", 
       
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], " ", "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"connections", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", " ", 
      RowBox[{"fib", ",", " ", "All"}], " ", "]"}]}], " ", "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", "connections"}], ",", " ", 
     RowBox[{"InfraFlatConnectionQ", "[", " ", 
      RowBox[{"fib", ",", " ", "connections"}], " ", "]"}]}], " ", "}"}]}], 
  "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a6d54024-c4d3-4ded-87ea-ea027878dbc6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2f798199-42ce-45cc-aa07-49011d9fa33d"]
}, Open  ]]
}, Open  ]],

