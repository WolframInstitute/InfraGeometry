Cell["\<\
The predicate tests identity holonomy around every closed base walk. It \
retains its existing behavior, including complete-connection validation and \
collection handling. The name does not denote a separate test for zero \
curvature on specified faces.\
\>", "Notes",ExpressionUUID->"8d88998c-7965-4dbe-aefa-fdaf6b7bf34d"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTrivialMonodromyQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTrivialMonodromyQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "987e1062-7c23-45ef-9fcc-bacfa33a237c"],
 " in new code."
}], "Notes",ExpressionUUID->"39a0be0a-2f7a-4ae9-92ee-6c1668f1cbbf"]
}, Open  ]],

