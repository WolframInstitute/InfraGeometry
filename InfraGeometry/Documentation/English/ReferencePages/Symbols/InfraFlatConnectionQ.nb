Cell["\<\
The prism and the Moebius ladder with their connections. The prism's \
connection is flat; on the Moebius ladder the transport around the cycle \
exchanges the two ends of the rung:\
\>", "ExampleText",ExpressionUUID->"6af6d632-63c2-4a21-b4a1-46cc03d47edf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fib", " ", "=", " ", 
        RowBox[{"InfraFiberedSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"conn", " ", "=", " ", 
        RowBox[{"RandomInfraConnection", "[", 
         RowBox[{"fib", ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraFiberedGraphHighlight", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"{", "conn", "}"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraFlatConnectionQ", "[", 
          RowBox[{"fib", ",", " ", "conn"}], "]"}]}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<CycleProductBundle\>\"", ",", 
        " ", "\"\<MoebiusLadderCover\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d99e6efc-8101-49e5-9e95-df206b006ecd"],

