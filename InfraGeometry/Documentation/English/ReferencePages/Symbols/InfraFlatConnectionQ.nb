Cell["\<\
On the Moebius ladder there is one leaf, and it meets every fiber twice. The \
connection is not flat.\
\>", "ExampleText",ExpressionUUID->"c27c38c6-7f21-40ac-8a4d-10a9e23d4f81"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<MoebiusLadderCover\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"InfraConnection", " ", "@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"EdgeList", "[", "total", "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"First", " ", "@", " ", "#"}]}], " ", "=!=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Last", " ", "@", " ", "#"}]}]}], " ", "&"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"total", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraDensity", "[", 
          RowBox[{"total", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"ConnectedComponents", " ", "@", " ", 
         RowBox[{"Graph", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "total", "]"}], ",", " ", 
           RowBox[{"First", " ", "@", " ", "conn"}]}], "]"}]}]}]}], "]"}], ",",
      "\n", "    ", 
     RowBox[{"InfraFlatConnectionQ", "[", 
      RowBox[{"fib", ",", " ", "conn"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"15518ffa-34f8-4aeb-8483-d94357570868"],

