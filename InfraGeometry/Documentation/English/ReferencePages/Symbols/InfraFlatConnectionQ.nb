  FontSize->0.9 Inherited,ExpressionUUID->
  "cfea6e95-1230-4852-b636-d33ca29d6f60"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["conn", "TI"],
 " is a connection whose horizontal leaves, the components of its edges, each \
project injectively to the base.",
 "\n"
}], "Usage",ExpressionUUID->"8a7bf4fb-191c-452b-93fe-3f77441ec7c8"],

Cell["\<\
A walk in the connection graph projects to a walk of the base with the same \
transport. So every holonomy is trivial iff no horizontal leaf meets a fiber \
twice.\
\>", "Notes",ExpressionUUID->"fb683618-836c-430a-ae5e-ae29db3d46eb"],

Cell[TextData[{
 StyleBox["conn", "TI"],
 " must first satisfy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "14f8c046-7914-4912-a5a2-551568900a21"],
 "."
}], "Notes",ExpressionUUID->"e30e0a9c-5d30-4c2e-9e3e-1320b914ca65"]
}, Open  ]],

