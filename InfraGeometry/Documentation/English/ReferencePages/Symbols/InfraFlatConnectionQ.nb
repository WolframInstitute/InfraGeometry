Cell["\<\
The two spellings give the same result on a connected double covering of a \
square.\
\>", "ExampleText",ExpressionUUID->"547c7407-82e3-4fca-b191-96c7d95e03dc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}], ",", " ", 
       RowBox[{"vertex", " ", "|->", " ", 
        RowBox[{"Mod", "[", " ", 
         RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
      " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"connection", " ", "=", " ", 
     RowBox[{"InfraConnection", "[", " ", 
      RowBox[{"EdgeList", " ", "@", " ", 
       RowBox[{"InfraTotalSpace", "[", " ", "fib", " ", "]"}]}], " ", "]"}]}],
     " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraFlatConnectionQ", "[", " ", 
      RowBox[{"fib", ",", " ", "connection"}], " ", "]"}], ",", " ", 
     RowBox[{"InfraTrivialMonodromyQ", "[", " ", 
      RowBox[{"fib", ",", " ", "connection"}], " ", "]"}]}], " ", "}"}]}], 
  " ", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"70e48683-43e8-4948-a28c-be9eb2398e39"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d4cb7357-52c2-49ff-958a-a6fb6f457a29"]
}, Open  ]]
}, Open  ]],

