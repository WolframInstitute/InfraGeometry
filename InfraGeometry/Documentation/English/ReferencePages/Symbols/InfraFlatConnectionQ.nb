Cell["\<\
The holonomy around the cycle is trivial on the prism and swaps the sheets on \
the Moebius ladder.\
\>", "ExampleText",ExpressionUUID->"f52ea249-e88f-43e0-8f92-66cea374b393"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fib", " ", "=", " ", 
       RowBox[{"InfraFiberedSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"conn", " ", "=", " ", 
       RowBox[{"InfraConnection", " ", "@", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"EdgeList", " ", "@", " ", 
           RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"First", " ", "@", " ", "#"}]}], " ", "=!=", " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"Last", " ", "@", " ", "#"}]}]}], " ", "&"}]}], 
         "]"}]}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"name", " ", "->", " ", 
      RowBox[{"InfraHolonomy", "[", 
       RowBox[{"fib", ",", " ", "conn", ",", " ", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"Range", "[", "8", "]"}], ",", " ", "1"}], "]"}]}], 
       "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<CycleProductBundle\>\"", ",", 
       " ", "\"\<MoebiusLadderCover\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"a03166c0-2334-4c2f-a259-7b04aff15117"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"CycleProductBundle\"\>", "\[Rule]", 
    RowBox[{"Cycles", "[", 
     RowBox[{"{", "}"}], "]"}]}], ",", 
   RowBox[{"\<\"MoebiusLadderCover\"\>", "\[Rule]", 
    RowBox[{"Cycles", "[", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "}"}], "]"}]}]}], "}"}]], "Output",
