Cell["\<\
On the 6-cycle the line through an edge has three DAGs, one line each. Their \
union carries the path 5, 6, 1, 2, 3, 4, which is not a shortest path, since \
5 and 4 are adjacent:\
\>", "ExampleText",ExpressionUUID->"349cdc57-e25e-4cab-a04e-88031666cba7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "6", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"dags", " ", "=", " ", 
     RowBox[{"BeamGraph", "[", 
      RowBox[{"g", ",", " ", "1", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "dags", "]"}], ",", " ", 
     RowBox[{"FindPath", "[", 
      RowBox[{
       RowBox[{"GraphUnion", " ", "@@", " ", "dags"}], ",", " ", "5", ",", 
       " ", "4"}], "]"}], ",", " ", 
     RowBox[{"GraphDistance", "[", 
      RowBox[{"g", ",", " ", "5", ",", " ", "4"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8ed05f44-ba84-471f-a2a6-d3d8ef71851e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"5", ",", "6", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}], 
    "}"}], ",", "1"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a4dcd4ea-cdfd-4e0c-8174-cfffc6ea8f7b"]
}, Open  ]],

Cell["\<\
Each DAG has one source and one sink. Its source-to-sink paths are the lines \
with those ends, so their total number is the cardinality of the line:\
\>", "ExampleText",ExpressionUUID->"603e20f2-4fb9-4281-975a-465430194b2a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"p", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Total", " ", "@", " ", 
      RowBox[{"Table", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Length", " ", "@", " ", 
         RowBox[{"FindPath", "[", 
          RowBox[{"dag", ",", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"VertexList", "[", "dag", "]"}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"VertexInDegree", "[", 
                 RowBox[{"dag", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}],
                " ", "&"}]}], "]"}]}], ",", "\n", "      ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"VertexList", "[", "dag", "]"}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"VertexOutDegree", "[", 
                 RowBox[{"dag", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}],
                " ", "&"}]}], "]"}]}], ",", " ", "Infinity", ",", " ", 
           "All"}], "]"}]}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"dag", ",", " ", 
          RowBox[{"BeamGraph", "[", 
           RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}]}], "}"}]}], 
       "]"}]}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraInfiniteLine", "[", 
        RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
       " ", "\"\<Cardinality\>\""}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"dc7d496b-cc5b-46e9-b039-260595b97f72"],

