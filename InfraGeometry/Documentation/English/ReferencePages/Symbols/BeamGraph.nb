Cell[TextData[{
 "The germ form keeps one shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " in the middle. On the grid each of the two germs between diagonal \
neighbours keeps all 64 pairs of ends, and half of the lines:"
}], "ExampleText",ExpressionUUID->"ebbead33-da8d-43e8-b6ee-b8e489bbd307"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"p", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"germs", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "p", ",", " ", "q", ",", " ", "All"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"BeamGraph", "[", 
       RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"BeamGraph", "[", 
         RowBox[{"g", ",", " ", "#"}], "]"}]}], " ", "&"}], " ", "/@", " ", 
      "germs"}], ",", "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraInfiniteLine", "[", 
        RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
       " ", "\"\<Cardinality\>\""}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraInfiniteLine", "[", "#", "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}], " ", "&"}], " ", "/@", " ", 
      "germs"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9981f472-4d17-4789-95c2-e349c0f9cd12"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"64", ",", 
   RowBox[{"{", 
    RowBox[{"64", ",", "64"}], "}"}], ",", "9800", ",", 
   RowBox[{"{", 
    RowBox[{"4900", ",", "4900"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a91f0ef0-3907-4aca-a2b4-5d50cead6574"]
}, Open  ]]
