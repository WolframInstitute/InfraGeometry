  FontSize->0.9 Inherited,ExpressionUUID->
  "05f6b67a-6375-43b8-8a19-7c8686f07463"],
 "\[LineSeparator]",
 "gives the list of directed acyclic graphs whose source-to-sink paths are \
the lines through ",
 StyleBox["p", "TI"],
 " and then ",
 StyleBox["q", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"774ea35b-ba33-4cf4-84f7-887b80694c6d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BeamGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BeamGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a168e251-383e-49e2-bb25-9365d76f514e"],
 "\[LineSeparator]",
 "gives the list of DAGs of the lines that contain the shortest path ",
 StyleBox["germ", "TI"],
 "."
}], "Usage",ExpressionUUID->"2aa56910-adb7-4d4b-a9e5-cea5725ff60a"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BeamGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BeamGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0b807ad-dc7c-495b-b029-285db5cf3f80"],
 " is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraInfiniteLine", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8e444fa-4756-40f3-8ea5-34da3747a1fc"],
 ". A line is an inextensible shortest path; see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraInfiniteLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraInfiniteLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8082d156-b6d9-4deb-a59f-d3613bad9352"],
 "."
}], "Notes",ExpressionUUID->"699be252-f3d9-4033-8d24-ac7311c16926"],

Cell[TextData[{
 "There is one DAG for each pair of ends ",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["b", "TI"],
 " with ",
 StyleBox["d(a, b) = d(a, p) + d(p, q) + d(q, b)", "TI"],
 " that no neighbour of ",
 StyleBox["a", "TI"],
 " or ",
 StyleBox["b", "TI"],
 " prolongs. The DAG is the union of the intervals ",
 StyleBox["I(a, p)", "TI"],
 ", ",
 StyleBox["I(p, q)", "TI"],
 " and ",
 StyleBox["I(q, b)", "TI"],
 ", from source ",
 StyleBox["a", "TI"],
 " to sink ",
 StyleBox["b", "TI"],
 "."
}], "Notes",ExpressionUUID->"93f319cb-f9fe-4a39-9d2f-b6bc61d11679"],

Cell["\<\
The list must not be merged. The union of two DAGs can carry a path from one \
end to another that is not a shortest path.\
\>", "Notes",ExpressionUUID->"61eb6abe-bd92-44fd-a593-d2a4ab04a69a"],

Cell[TextData[{
 "In the germ form the middle interval ",
 StyleBox["I(p, q)", "TI"],
 " is replaced by the germ itself."
}], "Notes",ExpressionUUID->"cd8d0bfc-d86e-4095-a4c3-4885ffb47098"]
}, Open  ]],

