Cell["\<\
Three of the DAGs on the square mesh, each drawn with its source and its sink:\
\>", "ExampleText",ExpressionUUID->"3be24ebc-26f6-4e19-a7d3-72768bacad2b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"p", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"dag", ",", " ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "dag", "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"VertexInDegree", "[", 
                RowBox[{"dag", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], 
              " ", "||", " ", 
              RowBox[{
               RowBox[{"VertexOutDegree", "[", 
                RowBox[{"dag", ",", " ", "#"}], "]"}], " ", "==", " ", 
               "0"}]}], " ", "&"}]}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"dag", ",", " ", 
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"BeamGraph", "[", 
           RowBox[{"g", ",", " ", "p", ",", " ", "q"}], "]"}], ",", " ", 
          "3"}], "]"}]}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5e22c292-f2f7-41d4-a0d0-6526fe2ee46f"],

