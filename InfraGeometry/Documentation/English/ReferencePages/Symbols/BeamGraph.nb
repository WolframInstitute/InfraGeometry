Cell[CellGroupData[{
Cell["BeamGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f5960372-e12c-429e-8212-bb3ab786c633"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BeamGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BeamGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf599d4f-7c02-47f8-8226-88a98c12af5b"],
 "\[LineSeparator]",
 "gives a list of directed acyclic graphs whose chains are the lines through \
p and q.",
 "\n"
}], "Usage",ExpressionUUID->"f05ae35f-e7f2-4a93-855b-d92e09f1752c"],

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{"graph", ",", " ", 
    RowBox[{"InfraLine", "[", 
     RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "\"\<Graph\>\""}], "]"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "021afc11-367a-4cc8-9de9-f1e2b59455a0"],
 "."
}], "Notes",ExpressionUUID->"96f40638-0797-43cd-85b9-528e6cf44926"],

Cell["\<\
Each DAG has one compatible pair of maximal endpoints. The list must not be \
merged: its union can introduce paths that are not lines. BeamGraph[graph, \
germ] instead keeps a specified shortest-path germ.\
\>", "Notes",ExpressionUUID->"a134b59d-aa22-4ebf-aee4-976ea29db9f7"]
}, Open  ]],

