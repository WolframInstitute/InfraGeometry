Cell[TextData[{
 Cell[BoxData["\"\<Spread\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d446931-9b0f-4095-bd20-6bb68054b590"],
 " takes the tuple whose pairwise distances are the most alike: three points \
about the centre."
}], "ExampleText",ExpressionUUID->"6fd97af8-73ec-4afb-9bd1-6aede3e6acd4"],

