       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", 
         "points"}], "}"}]}], "]"}], ",", " ", "points"}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"dd31baca-7bf2-4219-a0e9-c5645cdda18f"],

