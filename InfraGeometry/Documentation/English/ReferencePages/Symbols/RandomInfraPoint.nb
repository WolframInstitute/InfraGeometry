Cell[TextData[{
 "A point on a graph is a vertex, and that is what it returns. The \
three-argument form draws uniformly from the metric shell {",
 StyleBox["v", "TI"],
 " : ",
 StyleBox["d(p, v)", "TI"],
 " = ",
 StyleBox["d", "TI"],
 "}; it is ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomChoice",
    BaseStyle->"Link"], " ", "@", " ", 
   RowBox[{"FindInfraShell", "[", 
    RowBox[{
     StyleBox["graph", "TI"], ",", " ", 
     StyleBox["p", "TI"], ",", " ", 
     StyleBox["d", "TI"]}], "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "640f7f8d-ceb6-434e-85e7-3fdd63b2feed"],
 "."
}], "Notes",ExpressionUUID->"9f8dab2b-a783-4f5e-9336-2d31d9a3ec69"],

Cell[TextData[{
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d1e8c6e-cbab-49fc-b324-35adae3ceda1"],
 " in front reproduces the draw, as with every random construction in this \
paclet."
}], "Notes",ExpressionUUID->"e24209dd-47bf-48a4-a056-2bd703ee9b03"]
