Cell[TextData[{
 Cell[BoxData["\"\<Spread\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61e373ed-b281-4497-8aee-e6fb4d5e017b"],
 " takes the tuple whose pairwise distances are the most alike: three points \
about the centre."
}], "ExampleText",ExpressionUUID->"b57ea12c-79d5-455c-851c-3582dca24a2f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"triple", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "3", ",", " ", 
         RowBox[{"\"\<PairwiseDistance\>\"", " ", "->", 
          " ", "\"\<Spread\>\""}]}], "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "triple"}], "}"}]}], 
      "]"}], ",", " ", "triple"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"b7c9d5f3-2f53-4f35-92d7-2c51ff77e62c"],

