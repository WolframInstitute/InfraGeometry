 RowBox[{"{", 
  RowBox[{"34", ",", "34"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d80e6d29-bd59-40de-8811-a2db2a9b4495"]
}, Open  ]]
