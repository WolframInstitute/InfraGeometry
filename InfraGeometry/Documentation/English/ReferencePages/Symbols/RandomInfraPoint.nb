    }], "TableText",ExpressionUUID->"68cba916-3076-4c77-968a-c5de0ac3c347"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9c436f02-60e0-4a73-83fe-b2203cf1829e"], Cell[TextData[Cell[
    BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c1d13d9e-142c-4629-8877-6cda485613c6"]], "TableText",ExpressionUUID->
     "d854dc07-0ba5-4325-a66f-80e4b5f56a49"], Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "001d19db-5e4a-4a4b-86d6-3fbb63bcc4aa"],
     " (default), ",
     Cell[BoxData["Identity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "32ae19ae-0a3b-4466-a584-06cd4727ce59"]
    }], "TableText",ExpressionUUID->"11be258b-b112-4e89-a3fa-273679d5e58d"]}
  }]], "2ColumnTableMod",ExpressionUUID->"fd2a38c5-18fd-4475-80da-\
b03b8223fc4a"],

Cell[TextData[{
 Cell[BoxData["\"\<PairwiseDistance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db786a0f-6c12-4cc6-aaf7-025356034147"],
 " is a condition on the drawn tuple, not on a single point: the ",
 StyleBox["n", "TI"],
 " points are pairwise at distance ",
 StyleBox["d", "TI"],
 ", or in ",
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"dMin", ",", " ", "dMax"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5dc9ed4-36da-4dc9-a73a-c8f6358693cb"],
 ". ",
 Cell[BoxData["\"\<Max\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f68b9fd1-13ee-467f-8ed3-f545094f2041"],
 " takes the largest ",
 StyleBox["dMin", "TI"],
 " that still admits a tuple. ",
 Cell[BoxData["\"\<Spread\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "231c9ff2-a61e-4c53-8f33-599fecccf180"],
 " takes the tuple whose pairwise distances vary least. The condition makes \
the result one jointly constrained tuple, and ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1df7a103-44d0-42f2-bdec-91856ccebdaf"],
 " when none exists. ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55fc1ff4-d9dc-473c-8350-e7e1d5f39813"],
 " and ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b29f33cd-373f-4c19-a3eb-f6aa2b304123"],
 " under it ask for a tuple of ",
 Cell[BoxData[
  RowBox[{"Min", "[", 
   RowBox[{"n", ",", " ", 
    RowBox[{"Length", " ", "of", " ", "the", " ", "region"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a4ab88f-9ff9-4d03-a0d1-6654e719a305"],
 " points."
}], "Notes",ExpressionUUID->"93b3838e-bdfc-4c20-96ec-260bb719baef"],

Cell[TextData[{
 "To keep a whole construction interior, not just its anchors, cut the \
substrate with ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", "k"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f166805-9f03-48cc-8aef-96d6b943a4b3"],
 " and work on that graph: it is the ball of ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1024848e-8c4b-4171-b1ff-a299bae8e159"],
 " hops about ",
 Cell[BoxData[
  RowBox[{"GraphCenter", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76ed326e-a97a-4439-831f-16504e7a68dd"],
 ", a negative ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "110530e5-cdc0-448c-ac5e-19bfad5ee119"],
 " counting back from the radius and ",
 Cell[BoxData[
  RowBox[{"Scaled", "[", "q", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94918bfe-4314-4e1e-ba4e-e0d878eb36d5"],
 " taking the fraction ",
 Cell[BoxData["q"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ab7da18-98e4-4ddb-bbc6-2014561ad6ed"],
 " of it, and it carries the same vertex labels and coordinates, so the \
result draws on the original. Restricting the region alone pins only the \
anchors; a construction with slack spends it outward."
}], "Notes",ExpressionUUID->"33743221-6f37-4acd-98e6-dd69fde18048"],

Cell[TextData[{
 "The draw is random: seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bf77337-e81f-476f-b1bb-a4c4f8e31184"],
 " before the first call if you need a reproducible figure."
}], "Notes",ExpressionUUID->"15b162a7-f4ca-4bdd-8e9a-ee06816d25b6"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"6026aefa-0db6-48cb-b9d6-f918f42b3da1"],

