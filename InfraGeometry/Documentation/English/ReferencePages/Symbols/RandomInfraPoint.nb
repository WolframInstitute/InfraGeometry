Cell["\<\
Four points within distance 3 of the centre, drawn from a ball.\
\>", "ExampleText",ExpressionUUID->"d90d7635-a8a9-46cd-8a54-414472bde652"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "4"}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "points"}], "}"}]}], 
      "]"}], ",", " ", "points"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"b9f72b73-dd87-400f-bf98-294576f1db97"],

