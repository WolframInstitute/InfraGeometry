Cell["\<\
The distance to a set is the least distance to one of its points: the shell \
about two vertices is the outer layer of the union of the two balls, and does \
not contain the vertices.\
\>", "ExampleText",ExpressionUUID->"336e9c64-43a0-45ba-9044-a16888c5e031"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"10", ",", " ", "10"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"shell", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"45", ",", " ", "47"}], "}"}], ",", " ", "2"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", "shell"}], ",", " ", 
     RowBox[{"MemberQ", "[", 
      RowBox[{"shell", ",", " ", "45"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9f4d2380-588f-405a-a5fb-d8af51b9554e"],

