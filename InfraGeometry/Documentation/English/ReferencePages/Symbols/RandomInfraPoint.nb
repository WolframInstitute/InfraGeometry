Cell["\<\
Three points pairwise as far apart as the region allows: spread on the circle \
about the centre.\
\>", "ExampleText",ExpressionUUID->"f661bc4a-19dc-4f57-b2e5-4848463174a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", "3", ",", " ", 
         RowBox[{"\"\<PairwiseDistance\>\"", " ", "->", 
          " ", "\"\<Max\>\""}]}], "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", "corners"}], "}"}]}],
       "]"}], ",", " ", "corners"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"b53577f6-8324-46ed-b8e5-857ed44e290a"],

