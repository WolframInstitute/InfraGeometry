      "542ad46c-23eb-46f2-afa0-997cc315e010"]
    }], "TableText",ExpressionUUID->"2c132e81-7c8c-40e7-9aab-2ae0c32ea605"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "827848ff-9259-4c42-8443-032759307a5b"], Cell[TextData[Cell[
    BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7bdbb1e0-c211-4ff6-9ef0-d9216e00e705"]], "TableText",ExpressionUUID->
     "038f2238-7af0-42e3-b81a-6a3d252f2f8d"], Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "49fe6ef6-0b50-42bd-8c51-dd7889e44242"],
     " (default), ",
     Cell[BoxData["Identity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "43f11e9c-987a-4ef0-9bd3-fe160f095611"]
    }], "TableText",ExpressionUUID->"66cfbbeb-e3f2-4f90-9fee-d54130bad93f"]}
  }]], "2ColumnTableMod",ExpressionUUID->"6429b54e-e55a-4415-8832-\
ca075c10ab7e"],

Cell[TextData[{
 Cell[BoxData["\"\<PairwiseDistance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1ecfca9-c773-4407-99ef-00306173008d"],
 " is a condition on the drawn tuple, not on a single point: the ",
 StyleBox["n", "TI"],
 " points are pairwise at distance ",
 StyleBox["d", "TI"],
 ", or in ",
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"dMin", ",", " ", "dMax"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c36e6273-4db3-4da2-aab5-93758538fdda"],
 ". ",
 Cell[BoxData["\"\<Max\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3754cf50-a451-4c1b-b9f1-e0f0369f4ebe"],
 " takes the largest ",
 StyleBox["dMin", "TI"],
 " that still admits a tuple. ",
 Cell[BoxData["\"\<Spread\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e629b85-7280-4ea4-89dc-6a65ed5c3d5f"],
 " takes the tuple whose pairwise distances vary least. The condition makes \
the result one jointly constrained tuple, and ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebdc717f-748a-4cde-81e1-da4adc84c831"],
 " when none exists. ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "549e186e-65c2-47bf-895d-de94460a49a8"],
 " and ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a96454-2df6-40eb-b589-d395b1dcb186"],
 " under it ask for a tuple of ",
 Cell[BoxData[
  RowBox[{"Min", "[", 
   RowBox[{"n", ",", " ", 
    RowBox[{"Length", " ", "of", " ", "the", " ", "region"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58a64f4c-52b2-4f2f-8009-3d3de40422a8"],
 " points."
}], "Notes",ExpressionUUID->"b6d1c104-1062-4c40-82f2-3b8f4b439621"],

Cell[TextData[{
 "To keep a whole construction interior, not just its anchors, cut the \
substrate with ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", "k"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8452b2f3-2ba7-48b5-99d8-da315585a111"],
 " and work on that graph: it is the ball of ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34c86625-dff2-4d71-bb23-4e03ab10c9ae"],
 " hops about ",
 Cell[BoxData[
  RowBox[{"GraphCenter", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33874644-6edc-4112-a492-b2dc674af54d"],
 ", a negative ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a32cf6b9-1afb-45f7-9fdf-df0a95886e98"],
 " counting back from the radius and ",
 Cell[BoxData[
  RowBox[{"Scaled", "[", "q", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b67bde6e-a17e-4330-bc02-4bb7904e0da7"],
 " taking the fraction ",
 Cell[BoxData["q"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f3d4531-0228-434a-beb4-7139df5bb9dd"],
 " of it, and it carries the same vertex labels and coordinates, so the \
result draws on the original. Restricting the region alone pins only the \
anchors; a construction with slack spends it outward."
}], "Notes",ExpressionUUID->"890a4ef8-b3a2-4d15-a41c-34a7bcda33d6"],

Cell[TextData[{
 "The draw is random: seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9af81668-b9b5-4001-a090-4bbb322bc493"],
 " before the first call if you need a reproducible figure."
}], "Notes",ExpressionUUID->"e6f05465-cd72-4dcd-96a8-ae07d1aec605"],

