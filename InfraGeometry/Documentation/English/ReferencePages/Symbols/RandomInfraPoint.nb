  }]], "2ColumnTableMod",ExpressionUUID->"74585a14-3ab0-4bdb-a018-\
cbb2426623c8"],

Cell[TextData[{
 Cell[BoxData["\"\<PairwiseDistance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a8754ab-cf2e-42ef-bff2-b68d085e7cfe"],
 " is a condition on the drawn tuple, not on a single point: the ",
 StyleBox["n", "TI"],
 " points are pairwise at distance ",
 StyleBox["d", "TI"],
 ", or in ",
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"dMin", ",", " ", "dMax"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa61ecf6-4f0c-4926-b240-b73214ac747e"],
 ". ",
 Cell[BoxData["\"\<Max\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "791aba95-f882-4135-8d73-b61764608449"],
 " takes the largest ",
 StyleBox["dMin", "TI"],
 " that still admits a tuple. ",
 Cell[BoxData["\"\<Spread\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1f11837-4c56-4aaf-8ba7-977005f1c63d"],
 " takes the tuple whose pairwise distances vary least. The condition makes \
the result one jointly constrained tuple, and ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b56968da-acfe-47e5-88a3-d13d587ba523"],
 " when none exists. ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "116b6571-ff68-4c89-9f29-bd8b2b19aacc"],
 " and ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96b73544-0464-424a-a373-4f9c238c28fa"],
 " under it ask for a tuple of ",
 Cell[BoxData[
  RowBox[{"Min", "[", 
   RowBox[{"n", ",", " ", 
    RowBox[{"Length", " ", "of", " ", "the", " ", "region"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57714f43-dda3-455b-bebb-b668afefa2cb"],
 " points."
}], "Notes",ExpressionUUID->"4e90623c-6d5d-4bc0-9981-33769e742e02"],

Cell[TextData[{
 "To keep a whole construction interior, not just its anchors, cut the \
substrate with ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", "k"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "486c646f-f7c8-44b6-84d2-c30d9ead88bc"],
 " and work on that graph: it is the ball of ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e472c542-9165-4944-86bb-22257a8b4d17"],
 " hops about ",
 Cell[BoxData[
  RowBox[{"GraphCenter", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04957653-38df-4ab2-970c-53d702854094"],
 ", a negative ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "591f25f9-5250-4e27-a44f-faf3ef510c01"],
 " counting back from the radius and ",
 Cell[BoxData[
  RowBox[{"Scaled", "[", "q", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5be28f35-bed4-438f-8edf-076fdd102273"],
 " taking the fraction ",
 Cell[BoxData["q"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93f67d89-3fe6-4375-9fc0-c56f880d96f3"],
 " of it, and it carries the same vertex labels and coordinates, so the \
result draws on the original. Restricting the region alone pins only the \
anchors; a construction with slack spends it outward."
}], "Notes",ExpressionUUID->"c59fde9d-e3ef-4d8d-84d6-238ff6509057"],

Cell[TextData[{
 "The draw is random: give ",
 Cell[BoxData[
  RowBox[{"RandomSeeding", " ", "->", " ", "n"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a263a6d6-135d-46e6-bc71-881539ea52ba"],
 " for a reproducible figure."
}], "Notes",ExpressionUUID->"73142e0a-d3b5-491e-8bf0-c735bde8e1c4"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"69c14d43-c4d6-4528-a71f-d5a79f09adfa"],

