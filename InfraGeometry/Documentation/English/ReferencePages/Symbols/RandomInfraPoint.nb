Cell["\<\
The draw at a distance is a random choice from the shell; the same seed gives \
the same vertex.\
\>", "ExampleText",ExpressionUUID->"68cc6768-fe32-45f0-8bd8-82607bead1b1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
      RowBox[{"RandomInfraPoint", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", "3"}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
      RowBox[{"RandomChoice", " ", "@", " ", 
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "41", ",", " ", "3"}], "]"}]}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cbce7f95-daa4-47b9-a892-b924e28dc6e6"],

