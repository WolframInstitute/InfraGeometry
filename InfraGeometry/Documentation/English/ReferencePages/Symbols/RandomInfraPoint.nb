Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"triple", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "3", ",", " ", 
         RowBox[{"\"\<PairwiseDistance\>\"", " ", "->", 
          " ", "\"\<Spread\>\""}]}], "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "triple"}], "}"}]}], 
      "]"}], ",", " ", "triple"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"eda47053-76b4-485b-974c-f56f211326c3"],

