Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "6"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"region", ",", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", "region", ",", " ", "4", ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], 
         "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"region", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraBall", "[", 
           RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{"{", 
             RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"c", ",", " ", "b"}], "]"}]}], "}"}]}], "}"}]}], "]"}]}]}],
   "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f87c8517-f206-4b2b-b500-eeb474bc49d1"],

