Cell[TextData[{
 Cell[BoxData["\"\<PairwiseDistance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1954d9c9-c3e4-4a74-97ae-4d004d082bc5"],
 " is a condition on the drawn tuple, not on a single point: the ",
 StyleBox["n", "TI"],
 " points are pairwise at distance ",
 StyleBox["d", "TI"],
 ", or in ",
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"dMin", ",", " ", "dMax"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48e41057-69a7-47b8-9deb-b009f03af35c"],
 ". ",
 Cell[BoxData["\"\<Max\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a515dca7-ebe9-44b1-9b74-b2ba3756b360"],
 " takes the largest ",
 StyleBox["dMin", "TI"],
 " that still admits a tuple. ",
 Cell[BoxData["\"\<Spread\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "145812c5-d760-435e-8728-1a5a077dcee0"],
 " takes the tuple whose pairwise distances vary least. The condition makes \
the result one jointly constrained tuple, and ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "137b5e0a-dfdd-4b5f-a233-2c0bb3955116"],
 " when none exists. ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68937e84-3331-46b1-9607-6bc1007f38dd"],
 " and ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd72adbb-9437-4f8c-becd-bdf2d98ce80f"],
 " under it ask for a tuple of ",
 Cell[BoxData[
  RowBox[{"Min", "[", 
   RowBox[{"n", ",", " ", 
    RowBox[{"Length", " ", "of", " ", "the", " ", "region"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6fd98f0-78e6-42c3-88f4-c405cf3867c2"],
 " points."
}], "Notes",ExpressionUUID->"548b5eb8-decd-46ae-800a-7c73cdb1b7fd"],

Cell[TextData[{
 "To keep a whole construction interior, not just its anchors, cut the \
substrate with ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", "k"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "edcf1a8c-1be0-46c8-b6ce-bdf8c4723454"],
 " and work on that graph: it is the ball of ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40ad3124-551f-4191-9913-fa8ab06c9e08"],
 " hops about ",
 Cell[BoxData[
  RowBox[{"GraphCenter", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae1748df-2d7d-45c3-b256-595855103839"],
 ", a negative ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "737edf61-b38c-48a2-b0fc-10bc21372159"],
 " counting back from the radius and ",
 Cell[BoxData[
  RowBox[{"Scaled", "[", "q", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74fd20e1-6d4d-4e7d-80e6-e3b9b6174a68"],
 " taking the fraction ",
 Cell[BoxData["q"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55a9be3b-a11e-4c77-a9eb-3438854fdf57"],
 " of it, and it carries the same vertex labels and coordinates, so the \
result draws on the original. Restricting the region alone pins only the \
anchors; a construction with slack spends it outward."
}], "Notes",ExpressionUUID->"9c88827e-8ba7-4c31-95a4-983ded0451c8"],

Cell[TextData[{
 "The draw is random: seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "480ae90d-c83e-4d8e-8d2a-d8ac0b1f0029"],
 " before the first call if you need a reproducible figure."
}], "Notes",ExpressionUUID->"8136df75-a1d1-4a8d-b7ad-69f84f4d4dd0"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"71eb54a3-afff-4636-8973-1ffeac8f52c0"],

