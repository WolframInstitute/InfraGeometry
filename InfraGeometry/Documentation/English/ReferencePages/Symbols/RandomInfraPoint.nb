Cell[TextData[{
 "Any symbolic object that ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["reg", "TI"], ",", " ", "\"\<VertexDensity\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30e3f69a-5abf-4200-819a-936274c59a14"],
 " reads is a region. A single vertex is ",
 Cell[BoxData[
  RowBox[{"{", "v", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f0a4c92-a5a1-4dad-81f6-d3cf03e832dd"],
 ", never bare: a bare integer is a count."
}], "Notes",ExpressionUUID->"490ca96d-c624-411a-8a01-db822be8ed46"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " is ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d9551da-5719-4aa8-88dd-e4a0afb601cf"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f7e0aae-a9dd-4b47-ad55-ca56a28856db"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b83190b-748d-4692-86aa-460f9929d923"],
 ". The ",
 StyleBox["n", "TI"],
 " points are distinct. ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54d1ae0d-e41e-402f-aa16-3256316e4fef"],
 " gives at most ",
 StyleBox["n", "TI"],
 ", ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ca8a446-e2ae-4a7b-89e0-d12611d92af1"],
 " gives every vertex of the region. Without ",
 StyleBox["n", "TI"],
 " the result is one vertex, not a list."
}], "Notes",ExpressionUUID->"399db38a-dee1-4392-bc2b-32445cb9545e"],

Cell[TextData[{
 "Default ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66044a56-576c-42ed-adca-f9ca947b9f07"],
 " and ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f42e7222-d4f0-4f21-8340-b0771145f5d1"],
 " preserve the random state. The token form accepts only ",
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46cab52e-c203-4748-b958-42c050589522"],
 "; pairwise constraints belong to the bare point sampler."
}], "Notes",ExpressionUUID->"1c11117c-2087-432c-a981-40c3f69e5aec"],

Cell[TextData[{
 "An empty region gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20f8e0d0-59fe-41f9-8f82-a5561a397d07"],
 ". So does a region with fewer than ",
 StyleBox["n", "TI"],
 " vertices."
}], "Notes",ExpressionUUID->"70808769-e4db-44dd-aaf3-47753a1a1587"],

Cell[TextData[{
 "The distance from a vertex to a set ",
 StyleBox["C", "TI"],
 " is ",
 StyleBox["d(v, C) = min d(v, c)", "TI"],
 " over ",
 StyleBox["c", "TI"],
 " in ",
 StyleBox["C", "TI"],
 ". So ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["c1", "TI"], ",", " ", 
      StyleBox["c2", "TI"]}], "}"}], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1288161-b7a9-43d7-8e56-ea42b3de597a"],
 " is the union of the two balls, and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["c1", "TI"], ",", " ", 
      StyleBox["c2", "TI"]}], "}"}], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa4271b1-4b2b-4f04-b292-13a979015d86"],
 " is the outer layer of that union."
}], "Notes",ExpressionUUID->"25d6ac93-5333-476e-9ba2-a5a77c0767c0"],

