Cell["\<\
Points at the same distance from two anchors: the intersection of two shells, \
here the anti-diagonal of a grid.\
\>", "ExampleText",ExpressionUUID->"40dc261a-4bb8-4ec0-b928-784d184f6984"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"region", " ", "=", " ", 
     RowBox[{"InfraIntersection", "[", 
      RowBox[{
       RowBox[{"InfraShell", "[", 
        RowBox[{"1", ",", " ", "8"}], "]"}], ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"81", ",", " ", "8"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", "region", ",", " ", "All"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"HighlightGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
