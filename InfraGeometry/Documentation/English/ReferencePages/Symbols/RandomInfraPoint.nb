      "7188196b-9491-419c-8ba1-a13ac00b64ef"],
     ", ",
     Cell[BoxData["\"\<Spread\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a7bc6f9c-036e-4834-a74d-149f9d0b049e"]
    }], "TableText",ExpressionUUID->"6ac16315-4242-4c45-92a1-d27307f80653"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "01b682d8-7422-4311-8cf5-dc5dfd44b5d2"], Cell[TextData[Cell[
    BoxData["\"\<MaxCliques\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "68ad3873-e1b4-4d27-86cc-4c8e1c9ce4c7"]], "TableText",ExpressionUUID->
     "275b0747-4ff2-4536-bf94-8e94a69f1b7a"], Cell[TextData[{
     "bound on the clique search behind ",
     Cell[BoxData["\"\<PairwiseDistance\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "31336948-e39a-4c76-a1d3-54cac496833b"]
    }], "TableText",ExpressionUUID->"6c083d50-818d-43d2-bb95-37e0b2477d26"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "258caab2-652d-4872-81cf-0f711563a2ae"], Cell[TextData[Cell[
    BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b4ea21ed-eed4-4f62-9058-680e20125409"]], "TableText",ExpressionUUID->
     "4ab158f9-ff80-4d74-b34f-f1b2387f7bfd"], Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "235b1760-426c-4b0a-934b-64f49ad2488c"],
     " (default), ",
     Cell[BoxData["Identity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "80e0f279-110e-496c-bce1-444a487ee75f"]
    }], "TableText",ExpressionUUID->"422da284-7d88-49d8-89e0-aec685934dd6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3f044cdd-da4e-4fd3-8e85-f7d2325f3df9"], Cell[TextData[Cell[BoxData[
    "RandomSeeding"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3a947910-a63a-4a5f-a767-199216dfc319"]], "TableText",ExpressionUUID->
