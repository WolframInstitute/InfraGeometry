Cell["\<\
Five draws from the shell of radius 3 about the centre of a grid. Two of them \
fall on the same vertex.\
\>", "ExampleText",ExpressionUUID->"e2e63dd7-7d84-44fa-ac6f-47aebebbf574"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"draws", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}], ",", " ", "5"}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "3"}], "]"}], ",", " ", "c", ",",
        " ", "draws"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}]}], "]"}]}], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"f4b5a1f7-e9aa-4ad7-833d-40a5648b9d84"],

