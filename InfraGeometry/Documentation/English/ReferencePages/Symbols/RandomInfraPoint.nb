Cell[TextData[{
 "Any symbolic object that ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["reg", "TI"], ",", " ", "\"\<VertexDensity\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93ed075d-4b7c-409f-ae9e-c9a3cd993fb2"],
 " reads is a region. A single vertex is ",
 Cell[BoxData[
  RowBox[{"{", "v", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b9f1d61-0853-4a10-895b-1f13975079f5"],
 ", never bare: a bare integer is a count."
}], "Notes",ExpressionUUID->"258b1846-478f-4dd3-9637-e7ac8c632d38"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " is ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f6e39e5-6c18-4edd-9e6c-32061090bc2b"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "628f0024-8b81-49ba-be1e-d8f5e38a6830"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad849bcb-f1b0-4347-baee-b4ce5bf412c4"],
 ". The ",
 StyleBox["n", "TI"],
 " points are distinct. ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a25366db-368a-4ad0-bed2-97c2b480b85b"],
 " gives at most ",
 StyleBox["n", "TI"],
 ", ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e68aa3c-dd0b-4d07-b569-84f16efa6334"],
 " gives every vertex of the region. Without ",
 StyleBox["n", "TI"],
 " the result is one vertex, not a list."
}], "Notes",ExpressionUUID->"b986ca21-d983-4249-b9cb-f89ba2c0adff"],

Cell[TextData[{
 "An empty region gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fb2fbba-4797-4d9e-b33f-359213c9be65"],
 ". So does a region with fewer than ",
 StyleBox["n", "TI"],
 " vertices."
}], "Notes",ExpressionUUID->"95ec5a4c-28a6-4544-b908-85704c86c0b7"],

Cell[TextData[{
 "The distance from a vertex to a set ",
 StyleBox["C", "TI"],
 " is ",
 StyleBox["d(v, C) = min d(v, c)", "TI"],
 " over ",
 StyleBox["c", "TI"],
 " in ",
 StyleBox["C", "TI"],
 ". So ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["c1", "TI"], ",", " ", 
      StyleBox["c2", "TI"]}], "}"}], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f33dc120-6c4c-490b-b56f-26054c0fc557"],
 " is the union of the two balls, and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["c1", "TI"], ",", " ", 
      StyleBox["c2", "TI"]}], "}"}], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d30801e1-59c5-4898-a99a-cacb4e6abcaa"],
 " is the outer layer of that union."
}], "Notes",ExpressionUUID->"e1ffd955-3d64-487e-8567-4a6fd3fe2b9d"],

Cell["Options:", "Notes",ExpressionUUID->"b4fc7b4b-38a4-43cf-9966-387f07d71cfc"],

