Cell[TextData[{
 "Any inert head that ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["reg", "TI"], ",", " ", "\"\<VertexDensity\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0961791e-4f68-485b-935c-7b615ef50f3b"],
 " reads is a region. A single vertex is ",
 Cell[BoxData[
  RowBox[{"{", "v", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5244b80d-4001-4e7b-99d8-3ecdd322bbb3"],
 ", never bare: a bare integer is a count."
}], "Notes",ExpressionUUID->"b824a770-67b7-4aa7-8bfa-0e85e829f6cd"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " is ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e794ed8-6688-4a32-86c9-382de0d029cc"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20a22e3a-352a-47e0-ae60-3a6e92933534"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1df98e4e-9f9a-4e71-abe2-93d3e05107e3"],
 ". The ",
 StyleBox["n", "TI"],
 " points are distinct. ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6225e678-d749-4cc8-9a00-e28f5a5efe6f"],
 " gives at most ",
 StyleBox["n", "TI"],
 ", ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6802427d-6df1-4c43-aea5-db913792ecd1"],
 " gives every vertex of the region. Without ",
 StyleBox["n", "TI"],
 " the result is one vertex, not a list."
}], "Notes",ExpressionUUID->"fe754012-6d8e-4a2b-bd82-0d227d060b85"],

Cell[TextData[{
 "An empty region gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1769cf8e-d577-4550-a33a-1230cdfafdc8"],
 ". So does a region with fewer than ",
 StyleBox["n", "TI"],
 " vertices."
}], "Notes",ExpressionUUID->"037e1eff-8bc9-444c-b78f-1f63ccb136b6"],

Cell[TextData[{
 "The distance from a vertex to a set ",
 StyleBox["C", "TI"],
 " is ",
 StyleBox["d(v, C) = min d(v, c)", "TI"],
 " over ",
 StyleBox["c", "TI"],
 " in ",
 StyleBox["C", "TI"],
 ". So ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["c1", "TI"], ",", " ", 
      StyleBox["c2", "TI"]}], "}"}], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d590ccf3-2fb4-47fe-a106-4edc71d9cf8c"],
 " is the union of the two balls, and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["c1", "TI"], ",", " ", 
      StyleBox["c2", "TI"]}], "}"}], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d7b85d65-1209-4c23-ada3-a6a38d72573c"],
 " is the outer layer of that union."
}], "Notes",ExpressionUUID->"d6c7c220-7895-4742-af80-b8a0dfa970b0"],

Cell["Options:", "Notes",ExpressionUUID->"70895f40-a58b-48ef-8015-a8c703993be5"],

