Cell["\<\
Points at the same distance from two anchors: the intersection of two shells, \
here the anti-diagonal of a grid.\
\>", "ExampleText",ExpressionUUID->"0a7be029-a0cd-4a91-a0aa-a5618bdddb32"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"region", " ", "=", " ", 
     RowBox[{"InfraIntersection", "[", 
      RowBox[{
       RowBox[{"InfraShell", "[", 
        RowBox[{"1", ",", " ", "8"}], "]"}], ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"81", ",", " ", "8"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", "region", ",", " ", "All"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"HighlightGraph", "[", 
      RowBox[{"g", ",", " ", 
