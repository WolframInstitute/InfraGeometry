    }], "TableText",ExpressionUUID->"ee7a3553-3d03-4a81-ad96-69479f37b0f4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e7501499-c231-44ae-8b10-b4c76afc74b4"], Cell[TextData[Cell[
    BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d7d5d5a7-f0fd-4bee-9768-3a793ca2ce01"]], "TableText",ExpressionUUID->
     "645b466e-c956-475b-8592-eb523acc3662"], Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b7411892-c9e8-492f-ab56-20449826ab24"],
     " (default), ",
     Cell[BoxData["Identity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f9eafd75-281b-4e84-b13c-9c0b55b2485f"]
    }], "TableText",ExpressionUUID->"5d6c901e-9710-48ee-abe5-516533195a20"]}
  }]], "2ColumnTableMod",ExpressionUUID->"e1da1690-c063-4acf-920b-\
93d1f71b7c95"],

Cell[TextData[{
 Cell[BoxData["\"\<PairwiseDistance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02da0d8e-3282-4e12-b205-30b1f8c3d7e7"],
 " is a condition on the drawn tuple, not on a single point: the ",
 StyleBox["n", "TI"],
 " points are pairwise at distance ",
 StyleBox["d", "TI"],
 ", or in ",
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"dMin", ",", " ", "dMax"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "149f29d5-e137-4280-b9d5-96072cbe3438"],
 ". ",
 Cell[BoxData["\"\<Max\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "938bd38c-64c7-4a83-9859-8ddb536182c6"],
 " takes the largest ",
 StyleBox["dMin", "TI"],
 " that still admits a tuple. ",
 Cell[BoxData["\"\<Spread\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed0f3b67-a7fd-48e6-b883-ebfbaa138620"],
 " takes the tuple whose pairwise distances vary least. The condition makes \
the result one jointly constrained tuple, and ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78bf699d-193a-4f33-813c-1515bedf3324"],
 " when none exists. ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5cb772c-2431-4da8-8fee-13e05cd62df8"],
 " and ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b48c253b-1df0-433a-b6ef-14dec6ac96e1"],
 " under it ask for a tuple of ",
 Cell[BoxData[
  RowBox[{"Min", "[", 
   RowBox[{"n", ",", " ", 
    RowBox[{"Length", " ", "of", " ", "the", " ", "region"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53b791c2-be11-4971-929b-0ea5c42370f9"],
 " points."
}], "Notes",ExpressionUUID->"c4d84662-2f3d-49fc-9e54-7df08fd5126d"],

Cell[TextData[{
 "To keep a whole construction interior, not just its anchors, cut the \
substrate with ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", "k"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7383ebe-5215-4c68-b7e6-3060ef555d9d"],
 " and work on that graph: it is the ball of ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dce01bfe-dcd4-4779-80eb-3f191036ef7b"],
 " hops about ",
 Cell[BoxData[
  RowBox[{"GraphCenter", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "caae7846-6dca-430f-abfa-5a0ca392f123"],
 ", a negative ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07c4ffa0-ec67-416e-9120-ec09f2a45ce5"],
 " counting back from the radius and ",
 Cell[BoxData[
  RowBox[{"Scaled", "[", "q", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ddb92e72-539e-44fd-b890-80ca354c767a"],
 " taking the fraction ",
 Cell[BoxData["q"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e7d2dc0-77d0-4d70-9df9-722de1c772c0"],
 " of it, and it carries the same vertex labels and coordinates, so the \
result draws on the original. Restricting the region alone pins only the \
anchors; a construction with slack spends it outward."
}], "Notes",ExpressionUUID->"05f8f15d-6901-4de3-9715-52e204e69b5d"],

Cell[TextData[{
 "The draw is random: seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03f2431e-2a94-46af-8775-f30d5cf53406"],
 " before the first call if you need a reproducible figure."
}], "Notes",ExpressionUUID->"79f8c094-262d-435a-ad38-0d40c2276623"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"e419a9a8-62b7-4c26-9bc4-2bb59da56298"],

