Cell[TextData[{
 "Any symbolic object that ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["reg", "TI"], ",", " ", "\"\<VertexDensity\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "228b74c7-4bd0-44e1-978f-d2be193f8151"],
 " reads is a region. A single vertex is ",
 Cell[BoxData[
  RowBox[{"{", "v", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9c30e61-9ed6-476a-9920-1188998c9c6a"],
 ", never bare: a bare integer is a count."
}], "Notes",ExpressionUUID->"43440a37-0fef-4106-b88b-f736604898e4"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " is ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8148713e-0245-4387-9c76-0bd4cda60a61"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c629aee8-b068-46cf-af2e-8485f498038e"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ef3dd33-fac2-45a3-9b14-9bb2d7e2413c"],
 ". The ",
 StyleBox["n", "TI"],
 " points are distinct. ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f122e5a-9fd6-4927-85ff-27f09dc1d084"],
 " gives at most ",
 StyleBox["n", "TI"],
 ", ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05cb50fb-d425-4466-8676-0736d039a7b4"],
 " gives every vertex of the region. Without ",
 StyleBox["n", "TI"],
 " the result is one vertex, not a list."
}], "Notes",ExpressionUUID->"c43f693c-ac6b-48a7-8847-4638712521b8"],

Cell[TextData[{
 "Default ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e7ac52a-0eb4-4ba7-bcd6-41849c7b1aae"],
 " and ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82e0fc49-e687-49b1-bde5-b86212692a8e"],
 " preserve the random state. The token form accepts only ",
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fac7683-bf8c-4513-b82f-b4819dac8800"],
 "; pairwise constraints belong to the bare point sampler."
}], "Notes",ExpressionUUID->"18d10527-3940-4be1-87f3-fd6b3bd56615"],

Cell[TextData[{
 "An empty region gives ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12b1ba6a-9beb-4398-a20e-07d65e02754f"],
 ". So does a region with fewer than ",
 StyleBox["n", "TI"],
 " vertices."
}], "Notes",ExpressionUUID->"3eeac867-aaeb-4102-aeb1-5af25a0e9bd9"],

Cell[TextData[{
 "The distance from a vertex to a set ",
 StyleBox["C", "TI"],
 " is ",
 StyleBox["d(v, C) = min d(v, c)", "TI"],
 " over ",
 StyleBox["c", "TI"],
 " in ",
 StyleBox["C", "TI"],
 ". So ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["c1", "TI"], ",", " ", 
      StyleBox["c2", "TI"]}], "}"}], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa4b745c-5843-4447-b904-ac2df5930411"],
 " is the union of the two balls, and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["c1", "TI"], ",", " ", 
      StyleBox["c2", "TI"]}], "}"}], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58fe390e-b949-41ff-aa8f-91f218f3f58e"],
 " is the outer layer of that union."
}], "Notes",ExpressionUUID->"82af9596-f3a2-4c41-83f8-b45a48884189"],

