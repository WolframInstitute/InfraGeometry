Cell[TextData[{
 Cell[BoxData["\"\<PairwiseDistance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0039dd8-dd1d-451e-8bd2-fe69a91cc282"],
 " takes a distance: two points at distance 4 from each other."
}], "ExampleText",ExpressionUUID->"37faf442-7232-4996-92ed-8e708946bf5e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"pair", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "2", ",", " ", 
         RowBox[{"\"\<PairwiseDistance\>\"", " ", "->", " ", "4"}]}], "]"}]}],
       ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", "pair", "}"}]}], "]"}], ",", " ", 
     RowBox[{"GraphDistance", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"First", " ", "@", " ", "pair"}], ",", " ", 
       RowBox[{"Last", " ", "@", " ", "pair"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e5ff1434-2a56-42d1-ae57-4f6e16624233"],

