Cell["\<\
Three points on the circle of radius 4, pairwise as far apart as possible. On \
the grid they are 8 apart, twice the radius; in the plane the side of such a \
triangle is \[Sqrt]3 times the radius:\
\>", "ExampleText",ExpressionUUID->"1b291e76-3328-4b65-8a78-ae021e5eb8ee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", "3", ",", " ", 
       RowBox[{"\"\<PairwiseDistance\>\"", " ", "->", " ", "\"\<Max\>\""}], ",",
        " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", "corners"}], "}"}], ",",
      " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "##"}], "]"}], " ", "&"}], " ", "@@@", " ", 
        RowBox[{"Subsets", "[", 
         RowBox[{"corners", ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], ")"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"2c54fd67-ea83-47e6-8946-79c7e6896d62"],

