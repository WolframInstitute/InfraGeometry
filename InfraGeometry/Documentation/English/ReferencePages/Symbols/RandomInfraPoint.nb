Cell[TextData[{
 Cell[BoxData["\"\<PairwiseDistance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd416541-caea-4318-b78d-2b96b1fee954"],
 " takes a distance: two points at distance 4 from each other."
}], "ExampleText",ExpressionUUID->"be816086-3b8c-4522-868f-9bfec1298002"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"pair", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "2", ",", " ", 
         RowBox[{"\"\<PairwiseDistance\>\"", " ", "->", " ", "4"}]}], "]"}]}],
       ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", "pair", "}"}]}], "]"}], ",", " ", 
     RowBox[{"GraphDistance", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"First", " ", "@", " ", "pair"}], ",", " ", 
       RowBox[{"Last", " ", "@", " ", "pair"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7b19e24f-a160-4449-9239-681436ea971e"],

