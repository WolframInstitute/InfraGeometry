 Cell[BoxData["\"\<Spread\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9279eb6-cb83-4d39-88db-3a5ea7b1371c"],
 " takes the tuple whose pairwise distances are the most alike: three points \
about the centre."
}], "ExampleText",ExpressionUUID->"ce2098ee-3098-4e14-9aa2-016d51f50b0d"],

