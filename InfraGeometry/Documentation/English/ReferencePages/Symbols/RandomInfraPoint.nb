Cell[TextData[{
 Cell[BoxData["\"\<Spread\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fcfa892b-757b-4bf7-804e-80696ba70f6f"],
 " makes the pairwise distances as equal as possible. Three points of the \
circle of radius 3 on the mesh:"
}], "ExampleText",ExpressionUUID->"33d8a9e1-ce23-4b6b-9b66-f1c62655faf7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"triple", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "3", ",", " ", 
       RowBox[{"\"\<PairwiseDistance\>\"", " ", "->", " ", "\"\<Spread\>\""}],
        ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", "triple"}], "}"}], ",",
      " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "##"}], "]"}], " ", "&"}], " ", "@@@", " ", 
        RowBox[{"Subsets", "[", 
         RowBox[{"triple", ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], ")"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"44d55e77-a40e-4fc3-9d3d-e53aa1ea620f"],

