Cell["\<\
Points outside a region: take the complement as a vertex list.\
\>", "ExampleText",ExpressionUUID->"ef798c8c-b220-4085-822b-4b66a81152ec"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"outside", " ", "=", " ", 
     RowBox[{"Complement", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", " ", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"c", ",", " ", "6"}], "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", "outside", ",", " ", "3", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"outside", ",", " ", "points"}], "}"}]}], "]"}], ",", " ", 
     "points"}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"b6fb3e13-4ef3-4ae8-9d1a-423dc1c150cd"],

