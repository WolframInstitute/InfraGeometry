Notebook[{

Cell[CellGroupData[{
Cell["InfraPerpendicularQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"be0b74c1-2fd9-4d86-bfb9-33a5472eb381"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPerpendicularQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["l1", "TI"], ",", " ", 
    StyleBox["l2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99d6120a-672f-485a-ab17-80a0fd4fd62b"],
 "\[LineSeparator]",
 "tests whether the two lines are perpendicular.",
 "\n"
}], "Usage",ExpressionUUID->"b0086bea-8501-4d6b-bef9-3e28e7974eb6"],

Cell[TextData[{
 "Definition, with the default ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Projection\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5b46263-eb03-46cd-a094-aa0150deff0a"],
 ": at each common vertex, the foot of the perpendicular from one line onto \
the other must lie in the intersection of the two lines."
}], "Notes",ExpressionUUID->"47657b61-acce-4c48-85ba-d2c640e20141"],

Cell[TextData[{
 "The test is a conjunction over all common vertices. It is ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ccb4bf0-6557-4803-a4a2-2df2186c9b09"],
 " when the lines do not meet."
}], "Notes",ExpressionUUID->"bd1cbe9c-a0e4-453f-a515-dc530b0fcbc4"],

Cell[TextData[{
 "There is no single right definition of a right angle on a graph, so there \
are several methods and they are ",
 StyleBox["not",
  FontWeight->"Bold"],
 " equivalent."
}], "Notes",ExpressionUUID->"d8654206-f6cf-41de-b092-b9837a7767df"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1436b8d5-48c4-4885-b83b-026ff002e79c"], Cell["Method", "TableText",
     FontWeight->Bold,ExpressionUUID->"c62d57ba-7c92-4dd5-accd-018de0284e6b"],
     Cell["Tests", "TableText",
     FontWeight->Bold,ExpressionUUID->"8528523d-bcf5-45b3-88e3-8b1f9b44a5ef"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9be36fad-0d3c-4831-9243-841635256e7f"], Cell[TextData[{
     Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "11f8167d-c366-4b1d-9cb0-10af8a7bcc48"],
     " (default)"
    }], "TableText",ExpressionUUID->"d51a5436-3aad-4d77-ac82-5759a02caf6c"], 
    Cell["the foot of the perpendicular lies in the intersection", 
     "TableText",ExpressionUUID->"ba50bced-1eb6-4490-8bf2-288f805a25fa"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "49b7cbc7-ae58-445e-ad27-21a68d804a2f"], Cell[TextData[Cell[
    BoxData["\"\<Coordinate\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9db2831a-0c03-4fa8-8f54-7673d9d46105"]], "TableText",ExpressionUUID->
     "8f23c3f2-8a79-4380-be02-0c8d2c35eddb"], Cell["\<\
signed projection coordinates of the feet are centred on the meeting point\
\>", "TableText",ExpressionUUID->"251c2d81-fb8a-4b53-9ee2-c850a89325c6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8fc45276-9768-4f87-a184-c48efc54b192"], Cell[TextData[Cell[
    BoxData["\"\<Arclength\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ab205818-fa5c-4998-ad25-8b7a6022e4dd"]], "TableText",ExpressionUUID->
     "2c16ea99-3a90-4e2d-9f23-805fcc2f4544"], Cell["\<\
the four corner wedge angles at the meeting point are equal within a tolerance\
\>", "TableText",ExpressionUUID->"2a24c44c-465c-4076-a299-e132c7a7c706"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "87dfb4a0-eb68-419e-baed-c11343a19d33"], Cell[TextData[Cell[
    BoxData["\"\<Alexandrov\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5e059cb2-89b5-426e-a59b-ddcb98ff3d41"]], "TableText",ExpressionUUID->
     "7554f0c2-8146-4375-8933-97d523e7d599"], Cell[TextData[{
     "the same, with comparison angles in the model plane of curvature ",
     StyleBox["k", "TI"]
    }], "TableText",ExpressionUUID->"b267a70e-5550-4d33-8d6b-d35c43be015d"]}
  }]], "2ColumnTableMod",ExpressionUUID->"87251d5b-b582-424b-9f2c-\
56c1a4296823"],

Cell[TextData[{
 "Sub-options live inside the method spec, because their natural units differ \
per family. ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "977d66b5-f37b-4fc9-a7bc-e344b5af2c1c"],
 " takes ",
 Cell[BoxData["\"\<Equality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53b63bbf-cc95-4c57-ac16-273f54c4ea37"],
 ", forwarded to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEqualQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEqualQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6520b53f-27f2-4aba-bf4b-0e9d999326b3"],
 ": ",
 Cell[BoxData["\"\<Subset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1ee11f9-cf31-48fc-8246-88ff482f5ec1"],
 " is the default, and ",
 Cell[BoxData["\"\<Set\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "732b8ac9-87ca-4a23-b01e-08bbcec3c342"],
 ", ",
 Cell[BoxData["\"\<Multiset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14c43e04-60b6-482d-9206-b707a0939c47"],
 ", ",
 Cell[BoxData["\"\<Diffuse\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98dc2b1a-9557-499a-99bf-6cca83c4c849"],
 " and ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff973868-ad2b-4f35-b9b6-96d558699679"],
 " are also accepted. ",
 Cell[BoxData["\"\<Coordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd51ae83-f983-4425-b43b-3a832ebc978a"],
 " takes ",
 Cell[BoxData["\"\<ZeroTest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24617d03-fa34-4843-b420-6337a0681e1c"],
 ". ",
 Cell[BoxData["\"\<Arclength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d263d810-1013-4d9e-b3ed-5879f4ac8895"],
 " and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f79e09f-10e5-4577-a57d-254723e1dc31"],
 " take ",
 Cell[BoxData["\"\<Tolerance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99299689-4b2b-48dd-8d12-fa9d44884bbc"],
 " in radians, and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4de72764-2154-44b9-a8c8-851c5769cbb1"],
 " takes ",
 Cell[BoxData["\"\<Curvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e583b07d-5708-4bf2-aa3d-5f8cae16f19c"],
 ". Use ",
 Cell[BoxData[
  RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d82e36a-3f51-42ee-a229-979c5672c849"],
 " for the synthetic right-angle test."
}], "Notes",ExpressionUUID->"f7ef4283-efec-4fe9-baee-782bc6f40e5b"],

Cell[TextData[{
 "The top-level option ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "caa9a1f5-ccd4-41b3-98b1-f0e1725cfe90"],
 " localises the test to the ",
 StyleBox["r", "TI"],
 "-neighbourhood of the meeting point."
}], "Notes",ExpressionUUID->"942de895-aba5-4a41-b483-95eaf94f84ec"],

Cell[TextData[{
 StyleBox["The default is strict.",
  FontWeight->"Bold"],
 " A line produced by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPerpendicular"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7efe3ca0-9443-4ffb-a6ef-22a1c7e5361d"],
 " with its default Euclid I.12 construction is generally rejected by this \
predicate under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Subset\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d640f82e-9b2c-4844-ad25-6d6a59f6c63a"],
 ", and accepted under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Overlap\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f68b73ac-6c7c-4153-8314-90aae7654e1f"],
 ". The construction and the test are asking different questions: one lays \
off an isosceles base and takes its midpoint, the other demands that \
projections land exactly in the intersection. On a lattice those come apart. \
If you want the two to agree, pass ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37fd8697-8bd5-4afd-bbf8-8614d9e5aec2"],
 "."
}], "Notes",ExpressionUUID->"fbfd11cd-f093-4d1d-9992-9b5d33cda3c6"],

Cell["\<\
Two lines on a lattice can also meet in more than one vertex, which has no \
analogue in the plane, and the conjunction then has to hold at each of them.\
\>", "Notes",ExpressionUUID->"8dd0dee8-806f-450c-b03a-2a0978551ca1"]
}, Open  ]],

