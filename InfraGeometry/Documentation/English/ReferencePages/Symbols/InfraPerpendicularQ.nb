Notebook[{

Cell[CellGroupData[{
Cell["InfraPerpendicularQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"81ffe687-b46b-4688-8ff7-553e8288dca9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPerpendicularQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["l1", "TI"], ",", " ", 
    StyleBox["l2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb6694c5-9d71-4974-815d-ab202a97841b"],
 "\[LineSeparator]",
 "tests whether the lines ",
 StyleBox["l1", "TI"],
 " and ",
 StyleBox["l2", "TI"],
 " of ",
 StyleBox["g", "TI"],
 " meet in exactly one vertex and are perpendicular there.",
 "\n"
}], "Usage",ExpressionUUID->"e85e2213-a615-4b0c-90e6-1796a05f756b"],

Cell[TextData[{
 "With the default method, ",
 StyleBox["l1", "TI"],
 " and ",
 StyleBox["l2", "TI"],
 " are perpendicular at their common vertex when the feet of the \
perpendiculars from the vertices of each line onto the other lie in ",
 StyleBox["l1 \:2229 l2", "TI"],
 ". A foot of ",
 StyleBox["x", "TI"],
 " on a line is the midpoint, along the line, of two vertices of the line at \
equal distance from ",
 StyleBox["x", "TI"],
 ", or the nearest vertex of the line to ",
 StyleBox["x", "TI"],
 " when it is unique."
}], "Notes",ExpressionUUID->"febcd043-d880-444d-be77-7c26c12a43e3"],

Cell["\<\
Perpendicular lines meet in exactly one vertex. Lines that do not meet, or \
share two or more vertices, are not perpendicular under any method; in \
particular a line is not perpendicular to itself.\
\>", "Notes",ExpressionUUID->"d06f1044-440f-46ce-8478-c6e9718747f6"],

Cell["\<\
There is no single right angle on a graph. The methods are not equivalent:\
\>", "Notes",ExpressionUUID->"916d7aa2-97ff-49eb-a000-c7eb1f9f2248"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0ceb5c66-d493-483d-a1a3-935ddd357388"], Cell["Method", "TableText",
     FontWeight->Bold,ExpressionUUID->"ace01b06-2bb6-4d67-bb61-f37f0379beda"],
     Cell["Perpendicular when", "TableText",
     FontWeight->Bold,ExpressionUUID->"6e8ccbfe-b5f0-4c81-b687-9ab75a83b9d1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e508751e-34b4-4db2-9237-fdc4723771eb"], Cell[TextData[{
     Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "cca557d9-d433-4872-9e08-3043ce43a014"],
     " (default)"
    }], "TableText",ExpressionUUID->"72055223-10b0-44e0-b68d-b662f4719255"], 
    Cell["the feet lie in the intersection", "TableText",ExpressionUUID->
     "d962ad7b-b0b6-4520-b69d-e6a8cf018352"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "cefb97ef-37f8-476c-b4c1-24643c5bdd62"], Cell[TextData[Cell[
    BoxData["\"\<Coordinate\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3b091612-b657-4195-b380-355899624709"]], "TableText",ExpressionUUID->
     "29a0353d-5909-49bc-9729-2d1c51021dd3"], Cell["\<\
the feet are balanced about the meeting point, measured along each line\
\>", "TableText",ExpressionUUID->"d33d8fa6-9688-49d3-933b-131128429364"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "725a4516-fcfc-4b89-bc3d-878fc4adc732"], Cell[TextData[Cell[
    BoxData["\"\<Arclength\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7f2ab126-6d05-4c1f-90a0-0af0ecdec285"]], "TableText",ExpressionUUID->
     "15154238-454d-416c-a3d2-146844586719"], Cell["\<\
the four angles at the meeting point are equal, each measured as a detour \
around a ball, infinite when the ball cuts every detour\
\>", "TableText",ExpressionUUID->"07901efb-1dd8-494b-95bb-85d526e1fae6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "53a92c4f-b81e-4575-9a46-37b5aa4bc7be"], Cell[TextData[Cell[
    BoxData["\"\<Alexandrov\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "85c231cf-676f-41e6-afca-c990bd6b7084"]], "TableText",ExpressionUUID->
     "3922bf56-e98f-4884-ba4c-61465c435e4a"], Cell[
    "the four comparison angles at the meeting point are equal", "TableText",
     ExpressionUUID->"28056a0b-82da-4ebc-bf1f-8c1378d87467"]}
  }]], "2ColumnTableMod",ExpressionUUID->"afe44695-5822-40b3-89c2-\
b2eb6c58b09d"],

Cell[TextData[{
 "Sub-options go inside the method: ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Projection\>\"", ",", " ", 
    RowBox[{"\"\<Equality\>\"", " ", "->", " ", "e"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "abc8fb26-176f-4a43-84ab-edbbb026d431"],
 " compares the feet with the intersection by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEqualQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEqualQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fae246cc-525c-417e-8d2f-693ed15968b0"],
 ", with ",
 Cell[BoxData["e"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff086077-53da-4f1d-afa7-755eda5f5dfe"],
 " one of ",
 Cell[BoxData["\"\<Subset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fad5ee4c-2432-41da-b75e-942d1457747e"],
 " (default), ",
 Cell[BoxData["\"\<Set\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72556d19-5257-40c4-990b-aff5459d2a9d"],
 ", ",
 Cell[BoxData["\"\<Multiset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a48ecf30-6169-4273-8334-81d32fdc47f2"],
 ", ",
 Cell[BoxData["\"\<Diffuse\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a95b1c3c-8f26-485b-b81b-a6608baa300e"],
 ", ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e677411b-f690-45e0-99a5-5429b439e123"],
 "; ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Coordinate\>\"", ",", " ", 
    RowBox[{"\"\<ZeroTest\>\"", " ", "->", " ", "z"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70cb1aa2-c6bd-4b51-9161-f62b070cd17a"],
 "; ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Arclength\>\"", ",", " ", 
    RowBox[{"\"\<Tolerance\>\"", " ", "->", " ", "t"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "194b467c-ae00-42bb-92bd-686c19fa6210"],
 " and ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Alexandrov\>\"", ",", " ", 
    RowBox[{"\"\<Tolerance\>\"", " ", "->", " ", "t"}], ",", " ", 
    RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "k"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf869635-d5df-4a3f-9903-51574a54bbd8"],
 ", with ",
 StyleBox["t", "TI"],
 " in radians."
}], "Notes",ExpressionUUID->"babeaff2-d735-4495-a0c5-27342b8c8c8b"],

