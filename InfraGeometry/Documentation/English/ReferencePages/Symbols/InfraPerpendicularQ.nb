Cell["\<\
The row and the column through the centre of the square grid are \
perpendicular; the row and a staircase through the centre are not:\
\>", "ExampleText",ExpressionUUID->"89b59d4a-492c-4fa8-bd08-d133190c4003"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"vertexAt", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"Round", " ", "@", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}], ",", " ", 
       RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"row", " ", "=", " ", 
      RowBox[{"vertexAt", " ", "/@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "5"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "10"}], "}"}]}], "]"}]}]}], ",", " ", 
     RowBox[{"column", " ", "=", " ", 
      RowBox[{"vertexAt", " ", "/@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"5", ",", " ", "y"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"y", ",", " ", "10"}], "}"}]}], "]"}]}]}], ",", "\n", "   ", 
     RowBox[{"stairs", " ", "=", " ", 
      RowBox[{"vertexAt", " ", "/@", " ", 
       RowBox[{"Catenate", " ", "@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"k", ",", " ", 
              RowBox[{"k", " ", "+", " ", "1"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"k", " ", "+", " ", "1"}], ",", " ", 
              RowBox[{"k", " ", "+", " ", "1"}]}], "}"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "8"}], "}"}]}], "]"}]}]}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
