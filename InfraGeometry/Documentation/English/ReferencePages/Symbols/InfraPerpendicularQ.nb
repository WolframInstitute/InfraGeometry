Notebook[{

Cell[CellGroupData[{
Cell["InfraPerpendicularQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"70e8af7b-bf7e-4a05-b860-6d1792eb7277"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPerpendicularQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["l1", "TI"], ",", " ", 
    StyleBox["l2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dee986c-112d-48a0-93c2-5af0082e6c4a"],
 "\[LineSeparator]",
 "tests whether the two lines are perpendicular.",
 "\n"
}], "Usage",ExpressionUUID->"421b8440-3a5a-4d1b-8aa0-3f4cfce3e087"],

Cell[TextData[{
 "Definition, with the default ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Projection\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "600b5bc2-cdf9-4559-a3e4-4529645f9f18"],
 ": at each common vertex, the foot of the perpendicular from one line onto \
the other must lie in the intersection of the two lines."
}], "Notes",ExpressionUUID->"77520a50-3477-4292-90c7-c0d0460f4bf7"],

Cell[TextData[{
 "The test is a conjunction over all common vertices. It is ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef2f0be8-6f0a-40cc-80f2-a782aee235a2"],
 " when the lines do not meet."
}], "Notes",ExpressionUUID->"b2a97f4d-82dd-4f0b-8833-aded1cea45aa"],

Cell[TextData[{
 "There is no single right definition of a right angle on a graph, so there \
are several methods and they are ",
 StyleBox["not",
  FontWeight->"Bold"],
 " equivalent."
}], "Notes",ExpressionUUID->"de765710-e419-4629-a2db-7d6d60202e90"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ac1f539f-cc2a-4e18-b2d7-e150e00c9e03"], Cell["Method", "TableText",
     FontWeight->Bold,ExpressionUUID->"c49993e2-eccc-4232-bf09-1e0ea17ae2b7"],
     Cell["Tests", "TableText",
     FontWeight->Bold,ExpressionUUID->"656d7804-e4cf-4452-a970-08183181d0f7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "aacfc176-da6d-46b8-8d5b-73d28a70b887"], Cell[TextData[{
     Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6d2bebab-712b-488e-ae8c-b4e5c810aac6"],
     " (default)"
    }], "TableText",ExpressionUUID->"c22379cb-ed46-49c1-8f50-c9e62ee20bc8"], 
    Cell["the foot of the perpendicular lies in the intersection", 
     "TableText",ExpressionUUID->"f961b2a7-7587-4f46-8796-011a72124d38"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "443a0205-f54d-4b8b-bf02-b22c6347b770"], Cell[TextData[Cell[
    BoxData["\"\<Coordinate\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6dbad228-1196-4ccf-b473-7f2174fd62dd"]], "TableText",ExpressionUUID->
     "4ef6c714-7992-4c73-8b78-16abc3871dcb"], Cell["\<\
signed projection coordinates of the feet are centred on the meeting point\
\>", "TableText",ExpressionUUID->"d50f0437-7c4b-4ebc-8264-3f9690e08e31"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "621ac8c4-f4bf-4f88-93cf-5889470a8187"], Cell[TextData[Cell[
    BoxData["\"\<Arclength\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b7d96d09-4ad0-4de0-93c3-f12e3d5d4cd4"]], "TableText",ExpressionUUID->
     "d85368c3-95a8-4701-ad06-34b257f7bc23"], Cell["\<\
the four corner wedge angles at the meeting point are equal within a tolerance\
\>", "TableText",ExpressionUUID->"ccbaedae-6402-4f8f-ba0b-6df7ddb186c4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ec46b0b9-39b1-45b1-9004-ab5cc5ce837f"], Cell[TextData[Cell[
    BoxData["\"\<Alexandrov\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "33e3e34f-c420-4852-842d-4a62db7dda3c"]], "TableText",ExpressionUUID->
     "7127bd82-aa19-4bc6-9729-f3e3a326cb63"], Cell[TextData[{
     "the same, with comparison angles in the model plane of curvature ",
     StyleBox["k", "TI"]
    }], "TableText",ExpressionUUID->"350453e5-1127-471f-9477-302b83b96068"]}
  }]], "2ColumnTableMod",ExpressionUUID->"c73e1386-5612-4c0d-89e7-\
6ba18aa728b6"],

Cell[TextData[{
 "Sub-options live inside the method spec, because their natural units differ \
per family. ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12eadd84-6b9a-4345-aae0-9e0e8794b768"],
 " takes ",
 Cell[BoxData["\"\<Equality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0259d2db-8e57-4ea3-a6f9-392a7977e7ed"],
 ", forwarded to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEqualQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEqualQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ffb07df4-76bd-4c47-8e38-4203b59674e9"],
 ": ",
 Cell[BoxData["\"\<Subset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5f3af2f-e1d7-4361-89a7-e18420df6ccc"],
 " is the default, and ",
 Cell[BoxData["\"\<Set\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98eb5bec-4ef2-441e-b396-bd18f79dfe74"],
 ", ",
 Cell[BoxData["\"\<Multiset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21139bd2-02b8-4941-b591-4407df8438cc"],
 ", ",
 Cell[BoxData["\"\<Diffuse\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90d78c07-3559-471b-93e8-293e88b716ae"],
 " and ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62e4bf7f-8cd2-4573-bde5-20c43d5d2c5b"],
 " are also accepted. ",
 Cell[BoxData["\"\<Coordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3430d133-558d-492f-b347-b16c613d3264"],
 " takes ",
 Cell[BoxData["\"\<ZeroTest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4626ca0b-12b8-412d-8f38-71133eb0507c"],
 ". ",
 Cell[BoxData["\"\<Arclength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb9f700f-063f-4df1-b9a1-ddae526428f1"],
 " and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dc20f6d-63a5-4547-9486-8895ed6fb042"],
 " take ",
 Cell[BoxData["\"\<Tolerance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8cae321-5dff-4a16-9fba-74baf1403683"],
 " in radians, and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b391c5e0-2d6b-4294-8ba5-9363fa67ee45"],
 " takes ",
 Cell[BoxData["\"\<Curvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3877740-6452-43bd-b1e8-a13856f1bc28"],
 ". Use ",
 Cell[BoxData[
  RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a7c795b-a95a-41b7-a5d0-d128484bf9ea"],
 " for the synthetic right-angle test."
}], "Notes",ExpressionUUID->"2ebd860e-2520-445d-94a8-a1ee3ac77d35"],

Cell[TextData[{
 "The top-level option ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7d30015-6586-4031-9fde-1da4b63b810f"],
 " localises the test to the ",
 StyleBox["r", "TI"],
 "-neighbourhood of the meeting point."
}], "Notes",ExpressionUUID->"b751f709-9bee-418f-91ba-85b0185ddfef"],

Cell[TextData[{
 StyleBox["The default is strict.",
  FontWeight->"Bold"],
 " A line produced by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPerpendicular"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "84bbd523-c2d0-4d2a-9348-5ed56cb4f911"],
 " with its default Euclid I.12 construction is generally rejected by this \
predicate under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Subset\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9a222c04-1ee0-408c-910f-0e32ba1971ea"],
 ", and accepted under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Overlap\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "160f801f-4744-486e-a3f4-d6c227a2b254"],
 ". The construction and the test are asking different questions: one lays \
off an isosceles base and takes its midpoint, the other demands that \
projections land exactly in the intersection. On a lattice those come apart. \
If you want the two to agree, pass ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "020da28b-4289-4903-a45e-78fbe8f8d848"],
 "."
}], "Notes",ExpressionUUID->"6542ee66-2e2b-4482-8f1b-477a3b3c541d"],

Cell["\<\
Two lines on a lattice can also meet in more than one vertex, which has no \
analogue in the plane, and the conjunction then has to hold at each of them.\
\>", "Notes",ExpressionUUID->"da200140-e437-4747-956e-c1e328c93d71"]
}, Open  ]],

