Notebook[{

Cell[CellGroupData[{
Cell["InfraPerpendicularQ", "ObjectName",ExpressionUUID->"78e951d7-4cf6-4d1a-a3eb-f0d4cdbc342b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2a7723fb-888b-4cda-8f24-048b18025698"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPerpendicularQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["l1", "TI"], ",", " ", 
    StyleBox["l2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9f6bce4-fb0e-4e8a-bd25-98baf696a6c0"],
 "\[LineSeparator]",
 "tests whether the two lines are perpendicular.",
 "\n"
}], "Usage",ExpressionUUID->"2ef90e03-b8bf-42b1-b1e7-aa0a06280c8e"],

Cell[TextData[{
 "Definition, with the default ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Projection\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a4f5c1a-cec9-4b87-8744-9dc23ee98ee7"],
 ": at each common vertex, the foot of the perpendicular from one line onto \
the other must lie in the intersection of the two lines."
}], "Notes",ExpressionUUID->"9e31c14b-6603-4f08-9a67-4f04a41472ce"],

Cell[TextData[{
 "The test is a conjunction over all common vertices. It is ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e52c87fd-5e18-47d1-9fe8-ae37a570e9e8"],
 " when the lines do not meet."
}], "Notes",ExpressionUUID->"bcdb3fd5-fb0f-456a-9e8b-56d0c33e6190"],

Cell[TextData[{
 "There is no single right definition of a right angle on a graph, so there \
are several methods and they are ",
 StyleBox["not",
  FontWeight->"Bold"],
 " equivalent."
}], "Notes",ExpressionUUID->"5c16e6ab-1b1c-4838-963c-daa10c3f715e"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c3af0a41-e5c5-4155-84f3-0362e7ccc5c0"], Cell["Method", "TableText",
     FontWeight->Bold,ExpressionUUID->"46a2e3c4-3d05-47eb-b54b-1aaae15c3605"],
     Cell["Tests", "TableText",
     FontWeight->Bold,ExpressionUUID->"e1bb5304-2b4d-406b-9e79-a27cb8f821f9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3df7b6a4-7922-4897-92db-2860c9176b92"], Cell[TextData[{
     Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a6c38ca2-5a0e-4d1a-ac47-1f14285ce7f3"],
     " (default)"
    }], "TableText",ExpressionUUID->"424d52e4-2cfd-41a8-8319-eb3af8c0b330"], 
    Cell["the foot of the perpendicular lies in the intersection", 
     "TableText",ExpressionUUID->"bdbff683-cf93-4957-82e4-012b570d68ce"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0176f0ae-e216-4dee-ae49-cee063d0ff7d"], Cell[TextData[Cell[
    BoxData["\"\<Coordinate\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "411c8a41-cb6c-42e7-969a-60e41cb22ba7"]], "TableText",ExpressionUUID->
     "89cef256-d78b-45cb-b460-640c83122e0c"], Cell["\<\
signed projection coordinates of the feet are centred on the meeting point\
\>", "TableText",ExpressionUUID->"603f2fc6-1fa0-42c6-b2f9-af983a3ebed3"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1b949a5d-e2c9-4677-a8cb-32464eaf432d"], Cell[TextData[Cell[
    BoxData["\"\<Arclength\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3bce11bf-1dcf-4a20-ae89-c5ff370334a0"]], "TableText",ExpressionUUID->
     "31396b90-ca36-4455-9b66-799a1a0b623e"], Cell["\<\
the four corner wedge angles at the meeting point are equal within a tolerance\
\>", "TableText",ExpressionUUID->"22d4f632-1cb7-4930-8c54-1b00f0a4b67a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ca020b8a-13bf-49b5-8eb3-6818605dedb5"], Cell[TextData[Cell[
    BoxData["\"\<Alexandrov\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2a85dbf9-f9bc-4e26-a959-4bf083c87d81"]], "TableText",ExpressionUUID->
     "72981384-4b3a-4309-83ad-747e0b93b891"], Cell[TextData[{
     "the same, with comparison angles in the model plane of curvature ",
     StyleBox["k", "TI"]
    }], "TableText",ExpressionUUID->"33d637cf-f749-4e96-95eb-6b5a47c5df60"]}
  }]], "2ColumnTableMod",ExpressionUUID->"1915fb6c-5cf9-4845-a85a-\
934ac9b140c2"],

Cell[TextData[{
 "Sub-options live inside the method spec, because their natural units differ \
per family. ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2577881-ab3b-4702-9318-cca83abf0ca3"],
 " takes ",
 Cell[BoxData["\"\<Equality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd9513d5-0275-486a-ac6b-23038e71568c"],
 ", forwarded to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEqualQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEqualQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2c32cc54-eaed-4c88-a5ca-94634745b14e"],
 ": ",
 Cell[BoxData["\"\<Subset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34a9e79b-0891-486d-972d-6f795ef4e414"],
 " is the default, and ",
 Cell[BoxData["\"\<Set\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9c861dc-876e-40c6-a504-d5b2b927efcc"],
 ", ",
 Cell[BoxData["\"\<Multiset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4cdab16-838a-471f-a4dc-0ede00129e01"],
 ", ",
 Cell[BoxData["\"\<Diffuse\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "824702e1-0284-48af-8ec0-1c7a39e9a9e4"],
 " and ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6af62e9c-39d9-4dd5-b466-40f2c34a23a8"],
 " are also accepted. ",
 Cell[BoxData["\"\<Coordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d368e255-5466-40f0-9049-70ced42b7cc8"],
 " takes ",
 Cell[BoxData["\"\<ZeroTest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec9c4bfc-6616-4817-85e1-6ed73c0bbc02"],
 ". ",
 Cell[BoxData["\"\<Arclength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17fb4ee0-62d0-4aac-8cf4-f482c27cbee9"],
 " and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c40985a6-a619-4622-9e70-1b6aa0a86a20"],
 " take ",
 Cell[BoxData["\"\<Tolerance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fb7316d-07eb-42fe-8c5d-519c1260c8cd"],
 " in radians, and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88a97c98-619a-4c37-81fd-727291c22c6b"],
 " takes ",
 Cell[BoxData["\"\<Curvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fea5a27e-906b-4c96-9d1b-9e9cae59b8ee"],
 ". Use ",
 Cell[BoxData[
  RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d35ab64-3592-48fe-909a-2808650f88c3"],
 " for the synthetic right-angle test."
}], "Notes",ExpressionUUID->"03a028b2-3eaa-4812-8d94-6238e45a3c56"],

Cell[TextData[{
 "The top-level option ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53cb5011-4794-4a45-b5dd-635d9919f36a"],
 " localises the test to the ",
 StyleBox["r", "TI"],
 "-neighbourhood of the meeting point."
}], "Notes",ExpressionUUID->"0ba090ee-7956-43bd-a9e7-6c299b2be512"],

Cell[TextData[{
 StyleBox["The default is strict.",
  FontWeight->"Bold"],
 " A line produced by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPerpendicular"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "da874d6f-00c4-415f-998c-5375e6f95212"],
 " with its default Euclid I.12 construction is generally rejected by this \
predicate under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Subset\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cf17ecf-4a17-4da3-9fb3-97c49c319d89"],
 ", and accepted under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Overlap\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c595f037-d438-47c6-87eb-63b31375c279"],
 ". The construction and the test are asking different questions: one lays \
off an isosceles base and takes its midpoint, the other demands that \
projections land exactly in the intersection. On a lattice those come apart. \
If you want the two to agree, pass ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "929f12b4-9241-46b5-9232-bcd6d05a00ab"],
 "."
}], "Notes",ExpressionUUID->"086561eb-2ad9-45c1-80b7-3819c87db3f9"],

Cell["\<\
Two lines on a lattice can also meet in more than one vertex, which has no \
analogue in the plane, and the conjunction then has to hold at each of them.\
\>", "Notes",ExpressionUUID->"9bcb618b-c43a-44a9-b8c4-1c23ab9460a0"]
}, Open  ]],

