Cell[TextData[{
 "The four methods on the constructed perpendicular of the mesh. Only the ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6a57abb-273c-48c5-bd1b-dfc32209fa3c"],
 " equality accepts it:"
}], "ExampleText",ExpressionUUID->"f3b45879-d950-42bb-a13d-c907fca6c98d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"l1", " ", "=", " ", 
     RowBox[{"RandomInfraInfiniteLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "a", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", "All"}], "]"}], ",",
          " ", "l1"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"l2", " ", "=", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindInfraPerpendicular", "[", 
        RowBox[{"g", ",", " ", "l1", ",", " ", "p", ",", " ", "1", ",", " ", 
         RowBox[{"\"\<Radius\>\"", " ", "->", " ", "3"}]}], "]"}]}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraPerpendicularQ", "[", 
       RowBox[{"g", ",", " ", "l1", ",", " ", "l2", ",", " ", 
        RowBox[{"Method", " ", "->", " ", "#"}]}], "]"}], " ", "&"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"\"\<Projection\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Projection\>\"", ",", " ", 
         RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Overlap\>\""}]}], 
        "}"}], ",", " ", "\"\<Coordinate\>\"", ",", " ", "\"\<Arclength\>\"", 
       ",", " ", "\"\<Alexandrov\>\""}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"39c310fd-b0b2-47c5-9c30-05601a4a6061"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Projection\"\>", "\[Rule]", "False"}], ",", 
