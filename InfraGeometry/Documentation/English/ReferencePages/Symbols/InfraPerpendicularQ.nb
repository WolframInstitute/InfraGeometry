Cell[TextData[{
 "The default test is strict: a perpendicular built by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPerpendicular"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9d436df8-750f-40fe-ac9c-ff9367355d94"],
 " as in Euclid I.12 generally fails it, and ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Overlap\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1d423df-fd51-4d16-b6b9-055e6768952f"],
 " accepts it when it meets the line in one vertex."
}], "Notes",ExpressionUUID->"6f7fab5d-875c-42a5-b9ce-2755d2757f56"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"10dca2c7-4e26-4cd5-9082-3ba50ce27773"],

