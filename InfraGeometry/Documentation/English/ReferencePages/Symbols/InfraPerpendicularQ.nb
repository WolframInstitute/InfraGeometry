Notebook[{

Cell[CellGroupData[{
Cell["InfraPerpendicularQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"dd200c3b-f59b-460e-a81e-cc2fb8c5606a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPerpendicularQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["l1", "TI"], ",", " ", 
    StyleBox["l2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42e2fa93-760f-47b4-8af3-51e8102f7095"],
 "\[LineSeparator]",
 "tests whether the two lines are perpendicular.",
 "\n"
}], "Usage",ExpressionUUID->"8b22b91d-ecdf-4576-bb01-0cf1bf4cf5df"],

Cell[TextData[{
 "Definition, with the default ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Projection\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb6d3fbf-1bc9-40bc-b794-a9bb6595ef54"],
 ": at each common vertex, the foot of the perpendicular from one line onto \
the other must lie in the intersection of the two lines."
}], "Notes",ExpressionUUID->"fcd0af1c-0edc-40d4-a6cd-157fded3191c"],

Cell[TextData[{
 "The test is a conjunction over all common vertices. It is ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c9d04f71-c03b-41fe-bdc5-2818371285aa"],
 " when the lines do not meet."
}], "Notes",ExpressionUUID->"1d5f31a7-ccd3-46d4-896e-77c9c5dda615"],

Cell[TextData[{
 "There is no single right definition of a right angle on a graph, so there \
are several methods and they are ",
 StyleBox["not",
  FontWeight->"Bold"],
 " equivalent."
}], "Notes",ExpressionUUID->"979f00fd-135e-4119-8c32-c80e81071d30"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c52e4dc7-f401-4056-841b-e085d006b93d"], Cell["Method", "TableText",
     FontWeight->Bold,ExpressionUUID->"1a01378d-8a1c-4270-ae56-89f10e95ac5e"],
     Cell["Tests", "TableText",
     FontWeight->Bold,ExpressionUUID->"faf21d78-ec27-4248-b4c8-46de00b93100"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1f1d642f-94e4-4858-978d-aa885fa93609"], Cell[TextData[{
     Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a56217a8-775f-4ac5-82e7-bbb88d5f911a"],
     " (default)"
    }], "TableText",ExpressionUUID->"2905e24a-f082-4fb5-b6e4-fb44b372d6c8"], 
    Cell["the foot of the perpendicular lies in the intersection", 
     "TableText",ExpressionUUID->"c7d5fa9e-5c01-4671-b63a-39f7fc4cf3fc"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "dd41c0e0-eeb7-4b8d-9493-e33c034b979d"], Cell[TextData[Cell[
    BoxData["\"\<Coordinate\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f8097bc4-5e31-4f12-8542-f0d5a8d266b4"]], "TableText",ExpressionUUID->
     "0a8e5554-74ec-49df-9afe-b0f8656054a0"], Cell["\<\
signed projection coordinates of the feet are centred on the meeting point\
\>", "TableText",ExpressionUUID->"918b9bf5-bb68-4f36-b546-9e8c1a15854c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "cb797a18-b13d-40a4-95ff-cb2f2cd26fb7"], Cell[TextData[Cell[
    BoxData["\"\<Arclength\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "df48dc81-b542-41ff-bfd9-bde4b7aaf698"]], "TableText",ExpressionUUID->
     "dae6e589-6471-46cc-b96a-c1f8a7f01c6c"], Cell["\<\
the four corner wedge angles at the meeting point are equal within a tolerance\
\>", "TableText",ExpressionUUID->"486c04d9-9d90-434f-8b00-70bb11459100"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d852c01a-1f3f-49f6-9168-9203a10f71cd"], Cell[TextData[Cell[
    BoxData["\"\<Alexandrov\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "8ad5eacc-0c61-4bd9-842f-741589e20e3e"]], "TableText",ExpressionUUID->
     "daea4677-9282-4a2a-b3e8-c646a2cf1f59"], Cell[TextData[{
     "the same, with comparison angles in the model plane of curvature ",
     StyleBox["k", "TI"]
    }], "TableText",ExpressionUUID->"3c6253dd-3ac6-41cf-9325-ae9fe6b385a9"]}
  }]], "2ColumnTableMod",ExpressionUUID->"56c1cbfe-cb09-494b-8e57-\
dc20a5dc20de"],

Cell[TextData[{
 "Sub-options live inside the method spec, because their natural units differ \
per family. ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50d19c60-7116-4199-aea3-342aa06e9908"],
 " takes ",
 Cell[BoxData["\"\<Equality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7a7d2b3-6548-487d-832f-5b2b858bdab2"],
 ", forwarded to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEqualQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEqualQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7cecd545-9707-4aee-a4bb-3d1510510ade"],
 ": ",
 Cell[BoxData["\"\<Subset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c9f02ffe-7192-4a8e-ae0f-e179700b0d75"],
 " is the default, and ",
 Cell[BoxData["\"\<Set\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6113bf9e-e14f-4767-92b2-d754702aa9f5"],
 ", ",
 Cell[BoxData["\"\<Multiset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20ead49c-4682-4e1d-9d78-c80eb1bbd6c5"],
 ", ",
 Cell[BoxData["\"\<Diffuse\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "746f9492-3ba9-44a7-8c34-15805553327b"],
 " and ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a083666c-b24e-4ee8-9171-db708e826ea5"],
 " are also accepted. ",
 Cell[BoxData["\"\<Coordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac3dba42-8f85-4177-9f07-6fec6cd0ab79"],
 " takes ",
 Cell[BoxData["\"\<ZeroTest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c51086d8-0711-4a6c-871e-b03b862d21d0"],
 ". ",
 Cell[BoxData["\"\<Arclength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a20aad2b-6650-41da-a749-26b2aad78127"],
 " and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "122c5344-5186-4078-b867-24a3ca87dd41"],
 " take ",
 Cell[BoxData["\"\<Tolerance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4eb177bd-9d59-4b78-8169-c29823559d05"],
 " in radians, and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc3336fb-9dbb-41d5-9ed2-1cb1194533b2"],
 " takes ",
 Cell[BoxData["\"\<Curvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "faf04a55-2988-4ee8-8590-dfa9d03b70fb"],
 ". Use ",
 Cell[BoxData[
  RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f016dd0-e36e-4834-8095-30640c935bfd"],
 " for the synthetic right-angle test."
}], "Notes",ExpressionUUID->"f24f1106-d7cf-421d-8fae-779a5aa04115"],

Cell[TextData[{
 "The top-level option ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b8d8c14-56dc-4b0f-a6c6-a55f9a6b3129"],
 " localises the test to the ",
 StyleBox["r", "TI"],
 "-neighbourhood of the meeting point."
}], "Notes",ExpressionUUID->"3e460c34-d5f0-4a68-8e71-be9a04ba27ca"],

Cell[TextData[{
 StyleBox["The default is strict.",
  FontWeight->"Bold"],
 " A line produced by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPerpendicular"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9836c2d4-63ba-4f02-87d2-f614af55d2ca"],
 " with its default Euclid I.12 construction is generally rejected by this \
predicate under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Subset\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "347185f7-ab7a-4493-ad50-941cdf41ce04"],
 ", and accepted under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Overlap\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c61668b9-049e-47ed-b4f0-b61ffdcb1351"],
 ". The construction and the test are asking different questions: one lays \
off an isosceles base and takes its midpoint, the other demands that \
projections land exactly in the intersection. On a lattice those come apart. \
If you want the two to agree, pass ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c39b1726-71a4-435a-bb3a-318d333a1640"],
 "."
}], "Notes",ExpressionUUID->"76ee8472-9954-4419-875f-8722b2f11837"],

Cell["\<\
Two lines on a lattice can also meet in more than one vertex, which has no \
analogue in the plane, and the conjunction then has to hold at each of them.\
\>", "Notes",ExpressionUUID->"82f41820-03de-4145-98bf-aa820850e940"]
}, Open  ]],

