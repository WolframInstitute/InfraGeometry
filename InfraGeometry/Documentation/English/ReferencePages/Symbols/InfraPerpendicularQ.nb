Notebook[{

Cell[CellGroupData[{
Cell["InfraPerpendicularQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"64335ef8-0086-4d24-b630-288b70cad9c0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPerpendicularQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["l1", "TI"], ",", " ", 
    StyleBox["l2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76a13e5f-d5b4-411f-8f1b-0c8ff5efc5ed"],
 "\[LineSeparator]",
 "tests whether the two lines are perpendicular.",
 "\n"
}], "Usage",ExpressionUUID->"8133e595-a64e-464c-aa2d-3d68bb919e7b"],

Cell[TextData[{
 "Definition, with the default ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Projection\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a64b2cd-6a70-4e57-9f44-4ef2ba498f0d"],
 ": at each common vertex, the foot of the perpendicular from one line onto \
the other must lie in the intersection of the two lines."
}], "Notes",ExpressionUUID->"7d8a9c30-b4e1-43a5-b11f-a58fe792dc27"],

Cell[TextData[{
 "The test is a conjunction over all common vertices. It is ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "063d1ba7-3a67-4c1c-9d5f-fcda73b1ab14"],
 " when the lines do not meet."
}], "Notes",ExpressionUUID->"167d9d6a-be56-4b4f-ac86-80913c1ea405"],

Cell[TextData[{
 "There is no single right definition of a right angle on a graph, so there \
are several methods and they are ",
 StyleBox["not",
  FontWeight->"Bold"],
 " equivalent."
}], "Notes",ExpressionUUID->"cedcbefc-92f8-410d-ba3c-c3cbc6416540"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8f19088d-a805-4ff8-a8b3-959c69b344e1"], Cell["Method", "TableText",
     FontWeight->Bold,ExpressionUUID->"90185960-183d-4d29-905c-7f2f9e142d52"],
     Cell["Tests", "TableText",
     FontWeight->Bold,ExpressionUUID->"07400800-e441-40e5-b91e-cf922d69ea46"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e437526b-4b8f-47b9-93ab-6e7ba07a4045"], Cell[TextData[{
     Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8c7a8297-ce79-4da2-9568-88a761b64b28"],
     " (default)"
    }], "TableText",ExpressionUUID->"17ae2a6b-87f0-491d-8a34-52f44c50348c"], 
    Cell["the foot of the perpendicular lies in the intersection", 
     "TableText",ExpressionUUID->"c74a1335-cc44-4471-8919-b498eba6083f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a6824c2d-7404-4164-92b8-980c1d8685b6"], Cell[TextData[Cell[
    BoxData["\"\<Coordinate\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "da9d4f15-8a5f-42c6-a3ff-4aee427eb2af"]], "TableText",ExpressionUUID->
     "0697cc73-3ec3-4b60-9a79-d871c1f6ad8d"], Cell["\<\
signed projection coordinates of the feet are centred on the meeting point\
\>", "TableText",ExpressionUUID->"0c6b65ae-e1bc-4e68-a199-dbbe69fc4865"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5e270fac-076b-4878-8d1e-22adc398bbb5"], Cell[TextData[Cell[
    BoxData["\"\<Arclength\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "84af4ccd-f798-4daa-89e6-4daf5d57c708"]], "TableText",ExpressionUUID->
     "124d3ad8-73a3-4c4d-b346-58f727a7a0b6"], Cell["\<\
the four corner wedge angles at the meeting point are equal within a tolerance\
\>", "TableText",ExpressionUUID->"d126b365-2ab1-4af8-8847-be94b33c8705"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3473ca9a-386c-46f4-81eb-545c08f57385"], Cell[TextData[Cell[
    BoxData["\"\<Alexandrov\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ed4c337a-b9a1-4bf8-96cf-459a69814e78"]], "TableText",ExpressionUUID->
     "7ae873d0-1124-4ee5-a0fc-b81703d911ba"], Cell[TextData[{
     "the same, with comparison angles in the model plane of curvature ",
     StyleBox["k", "TI"]
    }], "TableText",ExpressionUUID->"caf51b72-d75d-4842-9b5b-e268c47473a4"]}
  }]], "2ColumnTableMod",ExpressionUUID->"ef4fa519-b71d-4bcb-b845-\
df042f555fd0"],

Cell[TextData[{
 "Sub-options live inside the method spec, because their natural units differ \
per family. ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e60ce468-6ef7-4cf7-912c-ffc7a844bea1"],
 " takes ",
 Cell[BoxData["\"\<Equality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "973b2b0d-d47a-4fe3-b9ff-723b3dd75a27"],
 ", forwarded to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEqualQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEqualQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1aeca711-19e7-4053-935a-fa8420866fa2"],
 ": ",
 Cell[BoxData["\"\<Subset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "660e0b87-1ca3-4442-81f1-4e0eda2c4b35"],
 " is the default, and ",
 Cell[BoxData["\"\<Set\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50ee5460-5283-4d73-aa40-eae215953262"],
 ", ",
 Cell[BoxData["\"\<Multiset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "363485a0-2ff9-47ed-8ec2-be0933000728"],
 ", ",
 Cell[BoxData["\"\<Diffuse\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f14bbf5c-183b-44fc-a629-e3c95518277f"],
 " and ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98297c5d-7d0b-4198-abdf-1c28a4022d8a"],
 " are also accepted. ",
 Cell[BoxData["\"\<Coordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87448a66-d482-419d-ad35-0b3dfc9272c7"],
 " takes ",
 Cell[BoxData["\"\<ZeroTest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "984df1c9-5aa0-4dcd-a7ef-1ce01d16f06b"],
 ". ",
 Cell[BoxData["\"\<Arclength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "afe617b8-8a9a-4e2a-ab6e-4ff14ed5044a"],
 " and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe4f8967-be1d-432b-9c76-9fc641ded6f1"],
 " take ",
 Cell[BoxData["\"\<Tolerance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7071d49a-8090-48aa-9045-e536b66de145"],
 " in radians, and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae126788-05fb-4abd-867e-0367e6b66810"],
 " takes ",
 Cell[BoxData["\"\<Curvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4eac8c9f-d33b-4d42-860c-1b5e9e869f4c"],
 ". Use ",
 Cell[BoxData[
  RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49aef64d-dc1e-4dfa-8177-93bc82ad4d02"],
 " for the synthetic right-angle test."
}], "Notes",ExpressionUUID->"c4968aa9-09b5-43a6-8578-9ee36b0c8326"],

Cell[TextData[{
 "The top-level option ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1148a2a2-82f5-46c5-a7f1-b9e3e3625825"],
 " localises the test to the ",
 StyleBox["r", "TI"],
 "-neighbourhood of the meeting point."
}], "Notes",ExpressionUUID->"a936993a-d7c0-44de-a6d3-185333c04c53"],

Cell[TextData[{
 StyleBox["The default is strict.",
  FontWeight->"Bold"],
 " A line produced by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPerpendicular"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4113114b-80e1-4867-a43d-5ba64cdc8901"],
 " with its default Euclid I.12 construction is generally rejected by this \
predicate under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Subset\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41d1490c-77d2-437a-95c4-80ae43e8ed57"],
 ", and accepted under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Overlap\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d746c48c-4735-4b57-8d65-92c78d6a7e81"],
 ". The construction and the test are asking different questions: one lays \
off an isosceles base and takes its midpoint, the other demands that \
projections land exactly in the intersection. On a lattice those come apart. \
If you want the two to agree, pass ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8da11a99-0305-4830-9f30-1b011b759114"],
 "."
}], "Notes",ExpressionUUID->"b5034b82-9d28-4273-80de-dc025765cbe0"],

Cell["\<\
Two lines on a lattice can also meet in more than one vertex, which has no \
analogue in the plane, and the conjunction then has to hold at each of them.\
\>", "Notes",ExpressionUUID->"f080f826-53bb-493c-bd58-b76bb723da07"]
}, Open  ]],

