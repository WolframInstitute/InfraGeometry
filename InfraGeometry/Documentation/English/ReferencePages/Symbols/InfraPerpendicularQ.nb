Cell[TextData[{
 "A perpendicular from a vertex to a line through the centre, constructed by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPerpendicular"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1cdc556e-8609-49e5-a389-edda25a0b725"],
 ". On the grid it shares two vertices with the line, and no test accepts it; \
on the mesh the default test rejects it and the ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dca0f658-6b74-45ac-85bb-78d430970b13"],
 " equality accepts it:"
}], "ExampleText",ExpressionUUID->"94b49949-b1d5-4498-9008-b1507fe13a8f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"l1", " ", "=", " ", 
        RowBox[{"RandomInfraInfiniteLine", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "a", ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"Complement", "[", 
           RowBox[{
            RowBox[{"RandomInfraPoint", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraShell", "[", 
               RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", "All"}], "]"}], 
            ",", " ", "l1"}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"l2", " ", "=", " ", 
        RowBox[{"VertexList", " ", "@", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"FindInfraPerpendicular", "[", 
           RowBox[{
           "g", ",", " ", "l1", ",", " ", "p", ",", " ", "1", ",", " ", 
            RowBox[{"\"\<Radius\>\"", " ", "->", " ", "3"}]}], "]"}]}]}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraWalk", "[", "l1", "]"}], ",", " ", 
          RowBox[{"InfraWalk", "[", "l2", "]"}], ",", " ", "p"}], "}"}], ",", 
        "\n", "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraPerpendicularQ", "[", 
            RowBox[{"g", ",", " ", "l1", ",", " ", "l2"}], "]"}], ",", "\n", 
           "        ", 
           RowBox[{"InfraPerpendicularQ", "[", 
            RowBox[{"g", ",", " ", "l1", ",", " ", "l2", ",", " ", 
             RowBox[{"Method", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<Projection\>\"", ",", " ", 
                
                RowBox[{"\"\<Equality\>\"", " ", "->", 
                 " ", "\"\<Overlap\>\""}]}], "}"}]}]}], "]"}]}], "}"}]}]}], 
       "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"fc42a4e1-53d1-4e96-bbb5-33f957481fcb"],

