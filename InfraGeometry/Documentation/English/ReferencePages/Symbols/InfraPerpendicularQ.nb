Cell["\<\
A line is not perpendicular to itself, and lines that do not meet are never \
perpendicular:\
\>", "ExampleText",ExpressionUUID->"8fa99dd5-c7fc-4f91-8fe4-7c07fa6266f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"vertexAt", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"Round", " ", "@", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}], ",", " ", 
       RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"row", " ", "=", " ", 
      RowBox[{"vertexAt", " ", "/@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "5"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "10"}], "}"}]}], "]"}]}]}], ",", " ", 
     RowBox[{"other", " ", "=", " ", 
      RowBox[{"vertexAt", " ", "/@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "7"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "10"}], "}"}]}], "]"}]}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraPerpendicularQ", "[", 
      RowBox[{"g", ",", " ", "row", ",", " ", "row"}], "]"}], ",", " ", 
     RowBox[{"InfraPerpendicularQ", "[", 
      RowBox[{"g", ",", " ", "row", ",", " ", "other"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
