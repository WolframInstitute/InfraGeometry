Notebook[{

Cell[CellGroupData[{
Cell["InfraPerpendicularQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"48427edf-e7bd-4b2e-9224-c03fc0721eff"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPerpendicularQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["l1", "TI"], ",", " ", 
    StyleBox["l2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de2eb09c-cebb-4c4d-bd17-a5cdecf3fa96"],
 "\[LineSeparator]",
 "tests whether the two lines are perpendicular.",
 "\n"
}], "Usage",ExpressionUUID->"0451507e-79dc-4a78-a092-86b15d29320d"],

Cell[TextData[{
 "Definition, with the default ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Projection\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99265fc3-ab12-451e-b116-6619c9d97f48"],
 ": at each common vertex, the foot of the perpendicular from one line onto \
the other must lie in the intersection of the two lines."
}], "Notes",ExpressionUUID->"5887d3ed-3ba8-4882-bb94-2212679b73a8"],

Cell[TextData[{
 "The test is a conjunction over all common vertices. It is ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a67b88c8-93fa-4b7b-82f3-d99fdad3c4df"],
 " when the lines do not meet."
}], "Notes",ExpressionUUID->"58e2d352-673b-4871-9914-902ef082dc0c"],

Cell[TextData[{
 "There is no single right definition of a right angle on a graph, so there \
are several methods and they are ",
 StyleBox["not",
  FontWeight->"Bold"],
 " equivalent."
}], "Notes",ExpressionUUID->"7c87f958-5693-4c69-87ff-db7f1f1a5c7c"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5c75aa8c-aa33-4d0c-9a10-d8c1059a5b28"], Cell["Method", "TableText",
     FontWeight->Bold,ExpressionUUID->"9c80b1ed-a608-4bf2-b72c-cd4c5a93acda"],
     Cell["Tests", "TableText",
     FontWeight->Bold,ExpressionUUID->"3b91dde8-0218-4603-99c3-90b7d2b388a5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b37247ac-8ed2-4729-baca-352fd81581c0"], Cell[TextData[{
     Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "14c6e537-9e14-4d0c-9c17-22e3cefcbdf0"],
     " (default)"
    }], "TableText",ExpressionUUID->"f1e447f5-1924-4404-bf27-f69cbc37a09c"], 
    Cell["the foot of the perpendicular lies in the intersection", 
     "TableText",ExpressionUUID->"c63956d8-b84f-4e91-a8d8-9720d8bf5560"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "43aefe19-65c1-4e2c-82da-0145cc8a10ec"], Cell[TextData[Cell[
    BoxData["\"\<Coordinate\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "390b1f9a-bf6b-491c-9d6b-926e8cb1ad68"]], "TableText",ExpressionUUID->
     "eb42bdd9-de9f-45bc-942a-de64b286d515"], Cell["\<\
signed projection coordinates of the feet are centred on the meeting point\
\>", "TableText",ExpressionUUID->"690bec5f-89be-4443-bd73-cbf29ed35373"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ecb626b5-134a-4154-99f1-433fca7f81ef"], Cell[TextData[Cell[
    BoxData["\"\<Arclength\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b6bf23d8-9aac-4097-9c77-702a78e2c086"]], "TableText",ExpressionUUID->
     "5e59dcd5-ce66-4707-8ed5-57c3eb5191f5"], Cell["\<\
the four corner wedge angles at the meeting point are equal within a tolerance\
\>", "TableText",ExpressionUUID->"fef40c21-6bdb-4bf0-af04-ce3970606d5c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5696f5ef-ddd6-4a2d-8dca-33c3616dbdca"], Cell[TextData[Cell[
    BoxData["\"\<Alexandrov\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5987b29b-df87-45be-8a0e-fe77e21cce48"]], "TableText",ExpressionUUID->
     "dbd5d953-ab44-4bda-a9b6-7d52d3349091"], Cell[TextData[{
     "the same, with comparison angles in the model plane of curvature ",
     StyleBox["k", "TI"]
    }], "TableText",ExpressionUUID->"b84f0ef1-7c0c-4bff-a024-f7f9b572410e"]}
  }]], "2ColumnTableMod",ExpressionUUID->"905f4382-d68f-4f92-a1ad-\
a443f7101702"],

Cell[TextData[{
 "Sub-options live inside the method spec, because their natural units differ \
per family. ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33994098-af1a-4fdd-a7c6-a891f3cbbe87"],
 " takes ",
 Cell[BoxData["\"\<Equality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a02a706d-8173-413e-b28d-c3ff1c394421"],
 ", forwarded to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEqualQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEqualQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cb50e6f9-a500-48cb-be06-55429214555b"],
 ": ",
 Cell[BoxData["\"\<Subset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67779398-97a3-4fa4-a5e4-801d9154ec6f"],
 " is the default, and ",
 Cell[BoxData["\"\<Set\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b20083be-296f-40dd-bbe3-604d085833b9"],
 ", ",
 Cell[BoxData["\"\<Multiset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd4ef8bc-57f2-49fe-b680-6e6152e34b4d"],
 ", ",
 Cell[BoxData["\"\<Diffuse\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c36aa876-fda7-44b5-9c3e-0e7169fd0293"],
 " and ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e21f4d66-f7bf-4e62-8341-a8df18814eb2"],
 " are also accepted. ",
 Cell[BoxData["\"\<Coordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b22238b-bfb8-4085-bc57-d1168fff9eaf"],
 " takes ",
 Cell[BoxData["\"\<ZeroTest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59e42456-e362-405b-a06b-598a9e450296"],
 ". ",
 Cell[BoxData["\"\<Arclength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b78c122-0296-4a5d-a2fb-33a9e73ff83f"],
 " and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04a75516-a42a-4185-95cb-265e86425637"],
 " take ",
 Cell[BoxData["\"\<Tolerance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f22f268-2703-4fb7-8b17-2dc187d8bb2a"],
 " in radians, and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11df095a-70d2-475b-a504-a34d2615d4eb"],
 " takes ",
 Cell[BoxData["\"\<Curvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9c4b921-d4f3-40cf-a676-736053409fb0"],
 ". Use ",
 Cell[BoxData[
  RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30972977-d0a4-4d7d-8671-9e77c8b79cde"],
 " for the synthetic right-angle test."
}], "Notes",ExpressionUUID->"6580b4ec-b2e8-4672-b054-2ae289fdb659"],

Cell[TextData[{
 "The top-level option ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3436b2cc-e5d1-4bf5-a313-46e0baafa9d5"],
 " localises the test to the ",
 StyleBox["r", "TI"],
 "-neighbourhood of the meeting point."
}], "Notes",ExpressionUUID->"38cb6e2f-8a68-4ac4-a2bc-47d4c350e6fb"],

Cell[TextData[{
 StyleBox["The default is strict.",
  FontWeight->"Bold"],
 " A line produced by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPerpendicular"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "84c2bce2-9a55-4acf-800c-32688064e27b"],
 " with its default Euclid I.12 construction is generally rejected by this \
predicate under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Subset\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b08eb8d-372a-4a4d-96d6-de56f580136d"],
 ", and accepted under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Overlap\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "261c6522-bcdb-4974-bca5-01ce5e8daf3d"],
 ". The construction and the test are asking different questions: one lays \
off an isosceles base and takes its midpoint, the other demands that \
projections land exactly in the intersection. On a lattice those come apart. \
If you want the two to agree, pass ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "780e2ad4-f367-40a8-9996-354bdaa8ca0d"],
 "."
}], "Notes",ExpressionUUID->"1242e41b-fb0f-4082-9dfe-7e8ce9e499db"],

Cell["\<\
Two lines on a lattice can also meet in more than one vertex, which has no \
analogue in the plane, and the conjunction then has to hold at each of them.\
\>", "Notes",ExpressionUUID->"0f9b1b03-73ca-4a6f-92c4-068c95c7bfab"]
}, Open  ]],

