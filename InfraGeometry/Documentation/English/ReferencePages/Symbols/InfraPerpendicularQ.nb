Notebook[{

Cell[CellGroupData[{
Cell["InfraPerpendicularQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c5ac82a4-8e62-4ec4-b92f-f343d10d61dc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPerpendicularQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["l1", "TI"], ",", " ", 
    StyleBox["l2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5ac819f-c42c-460c-bab9-eae32cfe6174"],
 "\[LineSeparator]",
 "tests whether the two lines are perpendicular.",
 "\n"
}], "Usage",ExpressionUUID->"d1e885f9-8b8f-4b5c-8ab2-6c30009968fe"],

Cell[TextData[{
 "Definition, with the default ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Projection\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa4c062e-a5f8-4155-a110-b667eb07e2dd"],
 ": at each common vertex, the foot of the perpendicular from one line onto \
the other must lie in the intersection of the two lines."
}], "Notes",ExpressionUUID->"f32a8474-bc70-4f64-bceb-c0dae90de997"],

Cell[TextData[{
 "The test is a conjunction over all common vertices. It is ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95ee9dd2-678a-4945-9507-96e6619d2499"],
 " when the lines do not meet."
}], "Notes",ExpressionUUID->"ca2f8824-d273-428c-9700-827e81e66724"],

Cell[TextData[{
 "There is no single right definition of a right angle on a graph, so there \
are several methods and they are ",
 StyleBox["not",
  FontWeight->"Bold"],
 " equivalent."
}], "Notes",ExpressionUUID->"54d8ee12-2e5e-4a49-867b-9b8f94e0ff33"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d8cb167a-bb2f-4d41-87a8-595c219ae3a4"], Cell["Method", "TableText",
     FontWeight->Bold,ExpressionUUID->"37a27a89-4e7e-4f6d-b8be-fc0f5040f3f6"],
     Cell["Tests", "TableText",
     FontWeight->Bold,ExpressionUUID->"eba5c99c-e37f-4d00-adb8-f6603c4a8c3b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "66646012-d6db-4fa0-99fd-12a498a6ed2e"], Cell[TextData[{
     Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2a68e827-727a-4e27-b46f-8878d6c7a4cf"],
     " (default)"
    }], "TableText",ExpressionUUID->"a46b694e-3f97-4ab7-b7e4-f3cfe66ddc48"], 
    Cell["the foot of the perpendicular lies in the intersection", 
     "TableText",ExpressionUUID->"4d3a1280-a64b-480f-b9b6-1f5c8ba894a4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e3244812-d742-437c-826d-5a66cef5540a"], Cell[TextData[Cell[
    BoxData["\"\<Coordinate\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2fd74682-1c9a-41b8-a57e-925140e8e1e0"]], "TableText",ExpressionUUID->
     "ee36b11d-2e42-434f-b6d1-e714cf7ebd9b"], Cell["\<\
signed projection coordinates of the feet are centred on the meeting point\
\>", "TableText",ExpressionUUID->"900b6401-ba76-4536-925f-6b31d29d7c48"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "dcdc8598-a7cd-467a-856c-a25db69188bf"], Cell[TextData[Cell[
    BoxData["\"\<Arclength\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "41975864-c90f-468d-8378-04f35848fef2"]], "TableText",ExpressionUUID->
     "0dfefa44-38b3-439c-8851-b5015a7b88ea"], Cell["\<\
the four corner wedge angles at the meeting point are equal within a tolerance\
\>", "TableText",ExpressionUUID->"649b3d59-7c71-483c-a1e9-9da25d86a52c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b843b215-97b0-4e46-bcc6-75483a96de98"], Cell[TextData[Cell[
    BoxData["\"\<Alexandrov\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "155c7b1d-7d26-41b8-830d-663329a57ced"]], "TableText",ExpressionUUID->
     "ea5e795a-fa32-4ba9-95ab-4675d5831613"], Cell[TextData[{
     "the same, with comparison angles in the model plane of curvature ",
     StyleBox["k", "TI"]
    }], "TableText",ExpressionUUID->"a2af0a3e-d7d9-4b4c-9cf9-5f5485848d6e"]}
  }]], "2ColumnTableMod",ExpressionUUID->"15237533-82e2-407b-bf0f-\
9dee852c5a73"],

Cell[TextData[{
 "Sub-options live inside the method spec, because their natural units differ \
per family. ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24d995e7-5c27-43b5-a459-c91f3bc19775"],
 " takes ",
 Cell[BoxData["\"\<Equality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7265bcf3-a1d2-4bd8-b285-26d52045d690"],
 ", forwarded to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEqualQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEqualQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "786819d1-6d3b-45b9-a7b0-d250e7f20265"],
 ": ",
 Cell[BoxData["\"\<Subset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1567b80f-593d-42de-82df-e596f1946198"],
 " is the default, and ",
 Cell[BoxData["\"\<Set\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9479699-4c34-487b-9743-0f780984eb01"],
 ", ",
 Cell[BoxData["\"\<Multiset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18cc66a1-e372-4131-8681-686838722b04"],
 ", ",
 Cell[BoxData["\"\<Diffuse\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "305eaaea-31db-4f80-99a8-d0039c993481"],
 " and ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d838aa1-1791-4913-8463-96b8b7070ab1"],
 " are also accepted. ",
 Cell[BoxData["\"\<Coordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e48cf66-62af-4919-b885-3278f8bc815c"],
 " takes ",
 Cell[BoxData["\"\<ZeroTest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c7f403d-d3fa-41c4-90e6-2cf98c339301"],
 ". ",
 Cell[BoxData["\"\<Arclength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c3e4426-a767-4ae4-9c42-e9deee553fdd"],
 " and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb6cbef8-86a5-4919-97dd-0f6e8b753a7c"],
 " take ",
 Cell[BoxData["\"\<Tolerance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "024561ba-058d-4712-9474-eaa20f6c7af2"],
 " in radians, and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7b80257-6d2a-4a86-9e1e-b9c94ca84a88"],
 " takes ",
 Cell[BoxData["\"\<Curvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f8c85d2-c9f9-4f57-9dd6-879f3037c321"],
 ". Use ",
 Cell[BoxData[
  RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0915cba-049c-496a-a475-90669c39e7f1"],
 " for the synthetic right-angle test."
}], "Notes",ExpressionUUID->"b4fb8bab-d2f8-4d7b-a316-d16fda27b162"],

Cell[TextData[{
 "The top-level option ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a4b0362-2da1-48de-b332-d0861a60bbb5"],
 " localises the test to the ",
 StyleBox["r", "TI"],
 "-neighbourhood of the meeting point."
}], "Notes",ExpressionUUID->"a771c599-a905-40d8-93ab-b10c7e1c132b"],

Cell[TextData[{
 StyleBox["The default is strict.",
  FontWeight->"Bold"],
 " A line produced by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPerpendicular"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/\
FindInfraPerpendicular", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5d29eae6-2404-43fa-82c5-0dad82b2367c"],
 " with its default Euclid I.12 construction is generally rejected by this \
predicate under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Subset\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b9b0501-26b1-4253-92a8-77ad702c3986"],
 ", and accepted under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Overlap\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ca37f71-2bca-441c-8e52-e52666985058"],
 ". The construction and the test are asking different questions: one lays \
off an isosceles base and takes its midpoint, the other demands that \
projections land exactly in the intersection. On a lattice those come apart. \
If you want the two to agree, pass ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3aeea80-8fa0-472e-bca9-25a5ac40c9b4"],
 "."
}], "Notes",ExpressionUUID->"5e1774ed-e11f-443f-bde0-ad32ed21724c"],

Cell["\<\
Two lines on a lattice can also meet in more than one vertex, which has no \
analogue in the plane, and the conjunction then has to hold at each of them.\
\>", "Notes",ExpressionUUID->"64bbe10e-ee4d-4b46-8be0-5cdf50c617bf"]
}, Open  ]],

