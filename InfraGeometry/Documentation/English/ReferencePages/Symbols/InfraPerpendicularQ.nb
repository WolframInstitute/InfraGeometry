Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
     
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"l1", " ", "=", " ", 
       RowBox[{"RandomInfraInfiniteLine", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "a", ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Complement", "[", 
          RowBox[{
           RowBox[{"RandomInfraPoint", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraShell", "[", 
              RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", "All"}], "]"}], ",",
            " ", "l1"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"perps", " ", "=", " ", 
       RowBox[{"VertexList", " ", "/@", " ", 
        RowBox[{"FindInfraPerpendicular", "[", 
         RowBox[{
         "g", ",", " ", "l1", ",", " ", "p", ",", " ", "All", ",", " ", 
          RowBox[{"\"\<Radius\>\"", " ", "->", " ", "3"}]}], "]"}]}]}], "}"}],
      ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Length", "[", "perps", "]"}], ",", " ", 
       RowBox[{"Count", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"InfraPerpendicularQ", "[", 
            RowBox[{"g", ",", " ", "l1", ",", " ", "#"}], "]"}], " ", "&"}], 
          " ", "/@", " ", "perps"}], ",", " ", "True"}], "]"}], ",", "\n", 
       "     ", 
       RowBox[{"Count", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"InfraPerpendicularQ", "[", 
            RowBox[{"g", ",", " ", "l1", ",", " ", "#", ",", " ", 
             RowBox[{"Method", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<Projection\>\"", ",", " ", 
                
                RowBox[{"\"\<Equality\>\"", " ", "->", 
                 " ", "\"\<Overlap\>\""}]}], "}"}]}]}], "]"}], " ", "&"}], 
          " ", "/@", " ", "perps"}], ",", " ", "True"}], "]"}], ",", "\n", 
       "     ", 
       RowBox[{"Count", "[", 
        RowBox[{"perps", ",", " ", 
         RowBox[{"l_", " ", "/;", " ", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"Intersection", "[", 
             RowBox[{"l1", ",", " ", "l"}], "]"}], "]"}], " ", "==", " ", 
           "1"}]}]}], "]"}]}], "}"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", 
       " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"431c88c9-ef4c-4527-9a53-8c2d24e338d3"],

