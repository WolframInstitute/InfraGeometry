Notebook[{

Cell[CellGroupData[{
Cell["InfraPerpendicularQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"326bab4b-fbec-42a4-b8f1-d51061c9b7ce"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPerpendicularQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["l1", "TI"], ",", " ", 
    StyleBox["l2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "91b1ddf5-e206-4c2f-9096-81579a73d97f"],
 "\[LineSeparator]",
 "tests whether the lines ",
 StyleBox["l1", "TI"],
 " and ",
 StyleBox["l2", "TI"],
 " of ",
 StyleBox["g", "TI"],
 " meet in exactly one vertex and are perpendicular there.",
 "\n"
}], "Usage",ExpressionUUID->"1e0c7782-94b2-4b17-b3aa-aa5f0a9e083b"],

Cell[TextData[{
 "With the default method, ",
 StyleBox["l1", "TI"],
 " and ",
 StyleBox["l2", "TI"],
 " are perpendicular at their common vertex when the feet of the \
perpendiculars from the vertices of each line onto the other lie in ",
 StyleBox["l1 \:2229 l2", "TI"],
 ". A foot of ",
 StyleBox["x", "TI"],
 " on a line is a centre vertex, along the line, of two vertices of the line \
at equal distance from ",
 StyleBox["x", "TI"],
 " (two when the piece between them has an even number of vertices), or the \
nearest vertex of the line to ",
 StyleBox["x", "TI"],
 " when it is unique."
}], "Notes",ExpressionUUID->"44358f56-f495-48b0-b94c-20d8528d382c"],

Cell["\<\
Perpendicular lines meet in exactly one vertex. Lines that do not meet, or \
share two or more vertices, are not perpendicular under any method; in \
particular a line is not perpendicular to itself.\
\>", "Notes",ExpressionUUID->"d40cb797-e7fa-4022-8d10-4f1e5eb40d64"],

Cell["\<\
There is no single right angle on a graph. The methods are not equivalent:\
\>", "Notes",ExpressionUUID->"5644d268-5f42-4fc5-8e01-e993cb8d37ca"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "76e8c285-cc98-4187-bf1d-f085247c2f87"], Cell["Method", "TableText",
     FontWeight->Bold,ExpressionUUID->"37f2474d-cd44-4812-a7cc-62fde2b3cd76"],
     Cell["Perpendicular when", "TableText",
     FontWeight->Bold,ExpressionUUID->"e82d927e-d778-45c9-9494-795c705e7ffd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a20bf13e-14e1-41b1-9ce9-cf3afdf46338"], Cell[TextData[{
     Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "eb653f0c-0176-4edb-808a-dfc27a7cdd8e"],
     " (default)"
    }], "TableText",ExpressionUUID->"d1cca3d6-dc31-4a40-a65e-76573c8ed66c"], 
    Cell["the feet lie in the intersection", "TableText",ExpressionUUID->
     "fd7cc2a6-e3de-4e8c-a0c2-19943c6c82fe"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "21b34824-827b-40be-b1dd-805f8c51d074"], Cell[TextData[Cell[
    BoxData["\"\<Coordinate\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "50b64f88-963d-43d5-9569-045f07793719"]], "TableText",ExpressionUUID->
     "732572b4-c79e-4888-832b-be749e777718"], Cell["\<\
the feet are balanced about the meeting point, measured along each line\
\>", "TableText",ExpressionUUID->"f5a4995c-9f25-4275-9c52-4561ce007e8e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "94d6637a-de12-46fb-98bf-6ee3416fec52"], Cell[TextData[Cell[
    BoxData["\"\<Arclength\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "07517346-8918-42b7-af1c-ede1f1f8a0e4"]], "TableText",ExpressionUUID->
     "fbf09b51-072c-47db-81c4-1ece9bc8c9f3"], Cell["\<\
the four angles at the meeting point are equal, each measured as a detour \
around a ball, infinite when the ball cuts every detour\
\>", "TableText",ExpressionUUID->"3a8cba93-fab6-4bd3-90ea-a679445a0538"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "66965d3a-7af1-407a-bf9a-6eba86f368dd"], Cell[TextData[Cell[
    BoxData["\"\<Alexandrov\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2ea327f3-1135-45ca-b4b8-e0809bedcb05"]], "TableText",ExpressionUUID->
     "de46db87-51ab-445c-a649-5deac7bf3a8c"], Cell[
    "the four comparison angles at the meeting point are equal", "TableText",
     ExpressionUUID->"5acf763b-4632-4b08-b14c-9b9c337a9ab1"]}
  }]], "2ColumnTableMod",ExpressionUUID->"3fa3f1b1-45fb-4bb7-8320-\
70c4c2d77d0e"],

Cell[TextData[{
 "Sub-options go inside the method: ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Projection\>\"", ",", " ", 
    RowBox[{"\"\<Equality\>\"", " ", "->", " ", "e"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93a20c8d-616f-454e-bae8-59fbd0b0d219"],
 " compares the feet with the intersection by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEqualQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEqualQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "69d077fd-7c28-4f62-b92f-20aa9e741d0e"],
 ", with ",
 Cell[BoxData["e"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "900ca891-cd6f-4d0b-b079-eb4b472709f4"],
 " one of ",
 Cell[BoxData["\"\<Subset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53263e30-d7db-47e8-8905-b2d583a39e7e"],
 " (default), ",
 Cell[BoxData["\"\<Set\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4d4a8ec-4427-4384-9d54-75fa9140d53a"],
 ", ",
 Cell[BoxData["\"\<Multiset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b510ac1-a342-4960-afd4-c78c82ef9a25"],
 ", ",
 Cell[BoxData["\"\<Diffuse\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39c50612-62f4-4e05-a838-ca74d6096eef"],
 ", ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60f767e4-feaf-492d-8fc3-10a6e14d9522"],
 "; ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Coordinate\>\"", ",", " ", 
    RowBox[{"\"\<ZeroTest\>\"", " ", "->", " ", "z"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5289e7b-887d-4e49-9390-37711eab0e63"],
 "; ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Arclength\>\"", ",", " ", 
    RowBox[{"\"\<Tolerance\>\"", " ", "->", " ", "t"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fd7e408-0bdb-4454-a112-abd7aa0951e1"],
 " and ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Alexandrov\>\"", ",", " ", 
    RowBox[{"\"\<Tolerance\>\"", " ", "->", " ", "t"}], ",", " ", 
    RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "k"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b7b5615-da52-46e4-9239-0e2845a316cf"],
 ", with ",
 StyleBox["t", "TI"],
 " in radians."
}], "Notes",ExpressionUUID->"067b5247-505b-4876-89f9-920e05b72f14"],

