Cell[TextData[{
 "A perpendicular from a vertex to a line through the centre, constructed by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPerpendicular"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ed97f1f3-4a32-4549-a091-8940b5d37c69"],
 ". On the grid it shares two vertices with the line, and no test accepts it; \
on the mesh the default test rejects it and the ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9cf89006-b6f1-4ed0-87ed-b638f6be7ae8"],
 " equality accepts it:"
}], "ExampleText",ExpressionUUID->"eb5bce99-9398-4cf1-8b7b-bd9918e5000f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"l1", " ", "=", " ", 
        RowBox[{"RandomInfraInfiniteLine", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "a", ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"Complement", "[", 
           RowBox[{
            RowBox[{"RandomInfraPoint", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraShell", "[", 
               RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", "All"}], "]"}], 
            ",", " ", "l1"}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"l2", " ", "=", " ", 
        RowBox[{"VertexList", " ", "@", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"FindInfraPerpendicular", "[", 
           RowBox[{
           "g", ",", " ", "l1", ",", " ", "p", ",", " ", "1", ",", " ", 
            RowBox[{"\"\<Radius\>\"", " ", "->", " ", "3"}]}], "]"}]}]}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraWalk", "[", "l1", "]"}], ",", " ", 
          RowBox[{"InfraWalk", "[", "l2", "]"}], ",", " ", "p"}], "}"}], ",", 
        "\n", "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraPerpendicularQ", "[", 
            RowBox[{"g", ",", " ", "l1", ",", " ", "l2"}], "]"}], ",", "\n", 
           "        ", 
           RowBox[{"InfraPerpendicularQ", "[", 
            RowBox[{"g", ",", " ", "l1", ",", " ", "l2", ",", " ", 
             RowBox[{"Method", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<Projection\>\"", ",", " ", 
                
                RowBox[{"\"\<Equality\>\"", " ", "->", 
                 " ", "\"\<Overlap\>\""}]}], "}"}]}]}], "]"}]}], "}"}]}]}], 
       "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"09581756-f632-41c4-83c2-9757c37a93e6"],

