Cell[TextData[{
 "The default test is strict: a perpendicular built by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPerpendicular"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "200c92c9-d10f-43ff-a8c1-90e70d42a857"],
 " as in Euclid I.12 generally fails it, and ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Overlap\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16fdd3c7-148a-492c-a0a6-2f42264ea03f"],
 " accepts it when it meets the line in one vertex."
}], "Notes",ExpressionUUID->"891299ba-3a4f-40e4-b406-85857b737329"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"795d7c2b-6d4f-412e-aa5c-6196a4b2aa09"],

