Cell[TextData[{
 "A line and a perpendicular to it, produced by the construction. The default \
test rejects it; the ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e01c5e12-31f9-412b-ac26-93998e62317a"],
 " equality accepts it."
}], "ExampleText",ExpressionUUID->"eba10bf3-3cb1-4abc-91e9-81a9cb375105"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"l1", " ", "=", " ", 
     RowBox[{"RandomInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ",
           "2"}], " ", "&&", " ", 
         RowBox[{"!", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"l1", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"l2", " ", "=", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindInfraPerpendicular", "[", 
        RowBox[{"g", ",", " ", "l1", ",", " ", "p", ",", " ", "1", ",", " ", 
         RowBox[{"\"\<Radius\>\"", " ", "->", " ", "3"}]}], "]"}]}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<default (Subset)\>\"", " ", "->", " ", 
      RowBox[{"InfraPerpendicularQ", "[", 
       RowBox[{"g", ",", " ", "l1", ",", " ", "l2"}], "]"}]}], ",", "\n", 
     "    ", 
     RowBox[{"\"\<Overlap\>\"", " ", "->", " ", 
      RowBox[{"InfraPerpendicularQ", "[", 
       RowBox[{"g", ",", " ", "l1", ",", " ", "l2", ",", " ", 
        RowBox[{"Method", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Projection\>\"", ",", " ", 
           RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Overlap\>\""}]}], 
          "}"}]}]}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<common vertices\>\"", " ", "->", " ", 
      RowBox[{"Intersection", "[", 
       RowBox[{"l1", ",", " ", "l2"}], "]"}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d2d02796-8e31-4932-b644-7a34aeba647e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"default (Subset)\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"Overlap\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"common vertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "4"}], "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"fff0e965-bf93-40b7-aa91-8e3db7fe9ac7"]
}, Open  ]],

Cell["\<\
The four methods on the same pair of lines. They are not equivalent, though \
on this pair all four reject.\
\>", "ExampleText",ExpressionUUID->"b87505aa-3116-4e1d-8164-051f8cb1c775"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"l1", " ", "=", " ", 
     RowBox[{"RandomInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ",
           "2"}], " ", "&&", " ", 
         RowBox[{"!", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"l1", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"l2", " ", "=", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindInfraPerpendicular", "[", 
        RowBox[{"g", ",", " ", "l1", ",", " ", "p", ",", " ", "1", ",", " ", 
         RowBox[{"\"\<Radius\>\"", " ", "->", " ", "3"}]}], "]"}]}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Association", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"ToString", "[", "m", "]"}], " ", "->", " ", 
       RowBox[{"InfraPerpendicularQ", "[", 
        RowBox[{"g", ",", " ", "l1", ",", " ", "l2", ",", " ", 
         RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}]}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Projection\>\"", ",", " ", "\"\<Coordinate\>\"", ",", 
          " ", "\"\<Arclength\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<Alexandrov\>\"", ",", " ", 
            RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "0"}]}], "}"}]}], 
         "}"}]}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"544e9ee5-9d7c-4354-938c-baa47e1c456c"],

