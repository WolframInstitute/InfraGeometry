     "9463546a-5fbf-4805-9f9b-cf82f47fbf55"], Cell[
    "All right angles are equal.", "TableText",ExpressionUUID->
     "f86cb501-10e3-49e3-a5cf-f56b0566f391"]}
  }]], "3ColumnTableMod",ExpressionUUID->"903aa841-8b92-4ea0-9090-\
