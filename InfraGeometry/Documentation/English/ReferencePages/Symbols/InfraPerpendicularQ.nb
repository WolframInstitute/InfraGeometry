Notebook[{

Cell[CellGroupData[{
Cell["InfraPerpendicularQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"145c8427-f4d1-4c06-a2d0-6d71d0ead878"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPerpendicularQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["l1", "TI"], ",", " ", 
    StyleBox["l2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa90cc8d-a7d5-4671-9fd3-65eb85f126aa"],
 "\[LineSeparator]",
 "tests whether the two lines are perpendicular.",
 "\n"
}], "Usage",ExpressionUUID->"559591db-8b26-45ed-b2f4-3188de5e4a42"],

Cell[TextData[{
 "Definition, with the default ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Projection\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d6bea65-647c-4a6a-bf36-21c2ef13f6eb"],
 ": at each common vertex, the foot of the perpendicular from one line onto \
the other must lie in the intersection of the two lines."
}], "Notes",ExpressionUUID->"728943a3-e6bb-4969-a387-b208af38c6e7"],

Cell[TextData[{
 "The test is a conjunction over all common vertices. It is ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e437f2d-fd69-43c0-8273-7c6de071b04a"],
 " when the lines do not meet."
}], "Notes",ExpressionUUID->"4bd7f7f3-d254-4ce4-8dcf-be0cfaae6879"],

Cell[TextData[{
 "There is no single right definition of a right angle on a graph, so there \
are several methods and they are ",
 StyleBox["not",
  FontWeight->"Bold"],
 " equivalent."
}], "Notes",ExpressionUUID->"de8a27a7-4f50-4d0b-a4fd-929baefc7898"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "08a5184d-5a5f-467b-a38e-dce6f8cc1d75"], Cell["Method", "TableText",
     FontWeight->Bold,ExpressionUUID->"4cd2ee67-9ee0-4047-b0fc-ee58d8896326"],
     Cell["Tests", "TableText",
     FontWeight->Bold,ExpressionUUID->"b1d3d04c-d171-4f21-ab6d-2e659ee8642d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "775a74b4-3974-48e4-ac4a-b8e3857b1b1d"], Cell[TextData[{
     Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "cfd23539-d2fc-4eb2-946f-6aa8249d3be1"],
     " (default)"
    }], "TableText",ExpressionUUID->"babe6ce7-7f68-44d9-a766-01da22bfb600"], 
    Cell["the foot of the perpendicular lies in the intersection", 
     "TableText",ExpressionUUID->"5a779034-9653-4a61-8924-b78d3b2d8e0b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "eac6f64e-91e5-470f-8f60-d6ef9d92e910"], Cell[TextData[Cell[
    BoxData["\"\<Coordinate\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3a78b134-685e-4c17-82ce-0a67f20bf364"]], "TableText",ExpressionUUID->
     "64560d50-612a-402f-8cb4-a048f2c98555"], Cell["\<\
signed projection coordinates of the feet are centred on the meeting point\
\>", "TableText",ExpressionUUID->"5f147ba5-453d-474b-9be5-ed5b4dd72b48"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "700f2e06-ba19-459b-9de6-c57b0471d476"], Cell[TextData[Cell[
    BoxData["\"\<Arclength\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "55926c2b-759e-4ec9-8204-13a212785377"]], "TableText",ExpressionUUID->
     "ca5c5148-cbeb-4b63-9ba8-550e9e57c8be"], Cell["\<\
the four corner wedge angles at the meeting point are equal within a tolerance\
\>", "TableText",ExpressionUUID->"a347d7df-a51f-4de6-b52e-0a4440e6b964"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "46fce944-79f0-44df-a819-de576d9c206e"], Cell[TextData[Cell[
    BoxData["\"\<Alexandrov\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0ddd2a05-b974-4ffd-8da9-97f04992512a"]], "TableText",ExpressionUUID->
     "202d8413-7bad-4033-bcfe-c8a1c50251df"], Cell[TextData[{
     "the same, with comparison angles in the model plane of curvature ",
     StyleBox["k", "TI"]
    }], "TableText",ExpressionUUID->"9b4b0175-d32a-491a-bdc4-6466fdd15844"]}
  }]], "2ColumnTableMod",ExpressionUUID->"4172206b-347f-4a55-b740-\
c8379a48d6d7"],

Cell[TextData[{
 "Sub-options live inside the method spec, because their natural units differ \
per family. ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f1240ab-eabf-4c7a-b1ef-d419dc160639"],
 " takes ",
 Cell[BoxData["\"\<Equality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f42de193-ce82-431c-8b96-0eeb720ada51"],
 ", forwarded to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEqualQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEqualQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e5f7750c-e667-499f-9f29-fa2bb671f745"],
 ": ",
 Cell[BoxData["\"\<Subset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf92ab29-7cb7-42c4-ac25-8283014f0d08"],
 " is the default, and ",
 Cell[BoxData["\"\<Set\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e677941-79c7-410f-852d-f706271ee8e4"],
 ", ",
 Cell[BoxData["\"\<Multiset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a614d868-3020-4bd1-923f-614221ec8672"],
 ", ",
 Cell[BoxData["\"\<Diffuse\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "efa78c92-f59b-43f4-a8bb-7e74b7eacc08"],
 " and ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4667d579-c7c8-4d8d-8209-4f8b69d903b2"],
 " are also accepted. ",
 Cell[BoxData["\"\<Coordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f78b26b6-481d-4066-8e5c-73de55cb10ae"],
 " takes ",
 Cell[BoxData["\"\<ZeroTest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd62f395-aad0-4a4c-b1ce-9c05f515f8b6"],
 ". ",
 Cell[BoxData["\"\<Arclength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80df8968-b7ff-46eb-bf0d-6809d375bb96"],
 " and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b53988f-d262-4687-bfde-138f23ca08a1"],
 " take ",
 Cell[BoxData["\"\<Tolerance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d7c3c068-9351-4abb-8eda-54658f779097"],
 " in radians, and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db1e0b48-3329-4667-98a6-40cfbe3bee89"],
 " takes ",
 Cell[BoxData["\"\<Curvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc2f8cbc-1aae-4c01-b6bb-f04715e3f6d6"],
 ". Use ",
 Cell[BoxData[
  RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bdc33668-cc9a-411b-9480-2c0fae37deb5"],
 " for the synthetic right-angle test."
}], "Notes",ExpressionUUID->"5e452632-af78-47fe-994d-3158af155a91"],

Cell[TextData[{
 "The top-level option ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d302f16-6003-4a74-86bf-c93b0de25265"],
 " localises the test to the ",
 StyleBox["r", "TI"],
 "-neighbourhood of the meeting point."
}], "Notes",ExpressionUUID->"659a9ee0-d026-4437-bdbc-ee20f7fb528f"],

Cell[TextData[{
 StyleBox["The default is strict.",
  FontWeight->"Bold"],
 " A line produced by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPerpendicular"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "433428c6-b07d-4167-911d-6914ae4e0145"],
 " with its default Euclid I.12 construction is generally rejected by this \
predicate under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Subset\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5258cf3-0469-4ec9-ab9d-001a250e9e05"],
 ", and accepted under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Overlap\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d357863-fa38-4cb7-a99c-33a44ba8e79f"],
 ". The construction and the test are asking different questions: one lays \
off an isosceles base and takes its midpoint, the other demands that \
projections land exactly in the intersection. On a lattice those come apart. \
If you want the two to agree, pass ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "849b5c55-d224-416a-9e2d-79de13fbf8cc"],
 "."
}], "Notes",ExpressionUUID->"9373ce02-04cf-4a6b-ba13-906c73467cf3"],

Cell["\<\
Two lines on a lattice can also meet in more than one vertex, which has no \
analogue in the plane, and the conjunction then has to hold at each of them.\
\>", "Notes",ExpressionUUID->"8626f780-740f-478c-abff-14efd939031f"]
}, Open  ]],

