Cell[TextData[{
 "A line and a perpendicular to it, produced by the construction. The default \
test rejects it; the ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ab25b13-acc5-4e66-a771-e43658abc20e"],
 " equality accepts it."
}], "ExampleText",ExpressionUUID->"05bb1789-3fd1-4857-8918-dd1fce7d3c33"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"l1", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ",
           "2"}], " ", "&&", " ", 
         RowBox[{"!", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"l1", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"l2", " ", "=", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindInfraPerpendicular", "[", 
        RowBox[{"g", ",", " ", "l1", ",", " ", "p", ",", " ", "1", ",", " ", 
         RowBox[{"\"\<Radius\>\"", " ", "->", " ", "3"}]}], "]"}]}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<default (Subset)\>\"", " ", "->", " ", 
      RowBox[{"InfraPerpendicularQ", "[", 
       RowBox[{"g", ",", " ", "l1", ",", " ", "l2"}], "]"}]}], ",", "\n", 
     "    ", 
     RowBox[{"\"\<Overlap\>\"", " ", "->", " ", 
      RowBox[{"InfraPerpendicularQ", "[", 
       RowBox[{"g", ",", " ", "l1", ",", " ", "l2", ",", " ", 
        RowBox[{"Method", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Projection\>\"", ",", " ", 
           RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Overlap\>\""}]}], 
          "}"}]}]}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<common vertices\>\"", " ", "->", " ", 
      RowBox[{"Intersection", "[", 
       RowBox[{"l1", ",", " ", "l2"}], "]"}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"94e30664-ab71-4c59-82c1-ea68c3ceaca5"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"default (Subset)\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"Overlap\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"common vertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "6"}], "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6af91520-6b30-4adb-82c6-a7a55cfbbd44"]
}, Open  ]],

Cell["\<\
The four methods on the same pair of lines. They are not equivalent, though \
on this pair all four reject.\
\>", "ExampleText",ExpressionUUID->"75756e40-abbc-4e7e-91ba-855d33e1292b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"l1", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ",
           "2"}], " ", "&&", " ", 
         RowBox[{"!", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"l1", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"l2", " ", "=", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindInfraPerpendicular", "[", 
        RowBox[{"g", ",", " ", "l1", ",", " ", "p", ",", " ", "1", ",", " ", 
         RowBox[{"\"\<Radius\>\"", " ", "->", " ", "3"}]}], "]"}]}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Association", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"ToString", "[", "m", "]"}], " ", "->", " ", 
       RowBox[{"InfraPerpendicularQ", "[", 
        RowBox[{"g", ",", " ", "l1", ",", " ", "l2", ",", " ", 
         RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}]}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Projection\>\"", ",", " ", "\"\<Coordinate\>\"", ",", 
          " ", "\"\<Arclength\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<Alexandrov\>\"", ",", " ", 
            RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "0"}]}], "}"}]}], 
         "}"}]}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7ed6dece-fd7c-4772-8306-4caaf9ad563d"],

