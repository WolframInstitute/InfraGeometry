Notebook[{

Cell[CellGroupData[{
Cell["InfraPerpendicularQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"325b8ad0-9c76-4369-a2b7-5561a7f28a30"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPerpendicularQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["l1", "TI"], ",", " ", 
    StyleBox["l2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72a2c899-7212-44fd-a0c5-ecd36abfc0e3"],
 "\[LineSeparator]",
 "tests whether the two lines are perpendicular.",
 "\n"
}], "Usage",ExpressionUUID->"bc54f3f8-b17d-441c-9111-d9265a0c74c1"],

Cell[TextData[{
 "Definition, with the default ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Projection\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2efb5f4-6205-4625-976e-d1dc5efae1cc"],
 ": at each common vertex, the foot of the perpendicular from one line onto \
the other must lie in the intersection of the two lines."
}], "Notes",ExpressionUUID->"f5e712aa-b82b-4735-8adb-a6d7938ccad6"],

Cell[TextData[{
 "The test is a conjunction over all common vertices. It is ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a69e12ce-6daf-4bc3-a352-60651780d5a4"],
 " when the lines do not meet."
}], "Notes",ExpressionUUID->"acafa715-40c6-481a-b0fc-62c0236565ae"],

Cell[TextData[{
 "There is no single right definition of a right angle on a graph, so there \
are several methods and they are ",
 StyleBox["not",
  FontWeight->"Bold"],
 " equivalent."
}], "Notes",ExpressionUUID->"a550b980-7989-428b-b424-8a0c271d5fa0"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "547fd4d5-fd9a-465d-8a75-3cec342705d3"], Cell["Method", "TableText",
     FontWeight->Bold,ExpressionUUID->"8c82d554-664e-4a85-a856-ae63c124d782"],
     Cell["Tests", "TableText",
     FontWeight->Bold,ExpressionUUID->"d86ad3f3-e69f-4b3d-8498-dde4e426d8d3"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5c79f9dd-85bc-44fe-82f2-df70f83e9f41"], Cell[TextData[{
     Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b831706d-ab5b-4e7c-9401-124d75eb9715"],
     " (default)"
    }], "TableText",ExpressionUUID->"57ed0988-93cf-4811-90e1-57e6c885cf06"], 
    Cell["the foot of the perpendicular lies in the intersection", 
     "TableText",ExpressionUUID->"e810e543-9045-48d3-bea7-947594bb9435"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fdad4e3d-7ea8-4e1e-9078-180ab8dbdb63"], Cell[TextData[Cell[
    BoxData["\"\<Coordinate\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "cf4a0aa0-db8e-44de-846d-ef1ec9af941e"]], "TableText",ExpressionUUID->
     "1a86dca1-f211-49b1-b4c7-5157e679e6d2"], Cell["\<\
signed projection coordinates of the feet are centred on the meeting point\
\>", "TableText",ExpressionUUID->"25b7bb23-7351-4e53-bcf2-017dcf362980"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3e94b6fe-a3e0-47ab-8414-f0333cf589a4"], Cell[TextData[Cell[
    BoxData["\"\<Arclength\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "cfd3ec2b-bba5-4aef-ba68-22a9d8536b41"]], "TableText",ExpressionUUID->
     "7a9768be-4431-4422-af3a-65841297f114"], Cell["\<\
the four corner wedge angles at the meeting point are equal within a tolerance\
\>", "TableText",ExpressionUUID->"8dc4e551-fa2d-42cd-85aa-e23945993933"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ea6100c8-58ba-40fc-981c-98eff46b5c51"], Cell[TextData[Cell[
    BoxData["\"\<Alexandrov\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "702d9575-bf8b-4f36-bddf-93e7ee73009b"]], "TableText",ExpressionUUID->
     "5ee236be-9308-48e0-8782-59f1ec94e6e2"], Cell[TextData[{
     "the same, with comparison angles in the model plane of curvature ",
     StyleBox["k", "TI"]
    }], "TableText",ExpressionUUID->"c80b53b1-c2f7-420d-bf14-81512de1e078"]}
  }]], "2ColumnTableMod",ExpressionUUID->"d771168a-47f8-41cc-b6be-\
ae021a9429e1"],

Cell[TextData[{
 "Sub-options live inside the method spec, because their natural units differ \
per family. ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "078bf9bb-84af-4d74-ae6b-484e8e6f0a35"],
 " takes ",
 Cell[BoxData["\"\<Equality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "130af8ab-7766-4313-be14-9c0db3ae3850"],
 ", forwarded to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEqualQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEqualQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4e2f4661-0811-48f2-b6d1-319449070117"],
 ": ",
 Cell[BoxData["\"\<Subset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d1a3d49-85df-4469-b888-e2b71299a999"],
 " is the default, and ",
 Cell[BoxData["\"\<Set\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12b8255d-ac8f-4367-8389-f3401be650fd"],
 ", ",
 Cell[BoxData["\"\<Multiset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29c1c826-a8d6-49ec-8503-5083a15cac4d"],
 ", ",
 Cell[BoxData["\"\<Diffuse\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef375d74-d825-462e-affb-9caec44b89e0"],
 " and ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe66494a-20a2-4aca-906c-13c643bae9a8"],
 " are also accepted. ",
 Cell[BoxData["\"\<Coordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99db358e-3a52-4757-8d1a-d50fcbb2d838"],
 " takes ",
 Cell[BoxData["\"\<ZeroTest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9e1152f-4d31-43c3-87ed-efcc74e36427"],
 ". ",
 Cell[BoxData["\"\<Arclength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af6c736f-412c-4308-ae1c-f14cff0a71ba"],
 " and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65761691-3193-4c78-b825-ab3d4a7d76d6"],
 " take ",
 Cell[BoxData["\"\<Tolerance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5c7a872-5b16-46ae-b970-add87fffd18f"],
 " in radians, and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cde70880-597e-4c17-924b-37ffddf1a635"],
 " takes ",
 Cell[BoxData["\"\<Curvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b605cf50-bf8c-4473-9673-3776ea24383c"],
 ". Use ",
 Cell[BoxData[
  RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d96d2556-9d9c-4e95-908d-9564c6c444f4"],
 " for the synthetic right-angle test."
}], "Notes",ExpressionUUID->"32810b23-5cb5-4eae-8c16-96843b4e5a6e"],

Cell[TextData[{
 "The top-level option ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d206109b-c585-462e-a1e3-eb33a9787be1"],
 " localises the test to the ",
 StyleBox["r", "TI"],
 "-neighbourhood of the meeting point."
}], "Notes",ExpressionUUID->"a5ac6b0b-2bb3-4026-8041-165bef26f7fa"],

Cell[TextData[{
 StyleBox["The default is strict.",
  FontWeight->"Bold"],
 " A line produced by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPerpendicular"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e1348a1f-dcbc-4fe6-b285-187dc3485c67"],
 " with its default Euclid I.12 construction is generally rejected by this \
predicate under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Subset\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a41deae-bb70-433b-acc9-fa6a2c641cb5"],
 ", and accepted under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Overlap\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61e07a7d-dc35-473f-9b89-f38dba895ed8"],
 ". The construction and the test are asking different questions: one lays \
off an isosceles base and takes its midpoint, the other demands that \
projections land exactly in the intersection. On a lattice those come apart. \
If you want the two to agree, pass ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6c43304-74ee-4e3f-8ed6-aaf0d185af41"],
 "."
}], "Notes",ExpressionUUID->"63138118-6e2b-4471-977f-d56ff9d26892"],

Cell["\<\
Two lines on a lattice can also meet in more than one vertex, which has no \
analogue in the plane, and the conjunction then has to hold at each of them.\
\>", "Notes",ExpressionUUID->"b84f94e8-8611-4a3a-8c45-6511e05175ed"]
}, Open  ]],

