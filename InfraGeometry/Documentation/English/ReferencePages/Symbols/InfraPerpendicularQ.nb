Notebook[{

Cell[CellGroupData[{
Cell["InfraPerpendicularQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"10064a30-07da-4de1-a98e-d8b5e3a81557"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPerpendicularQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["l1", "TI"], ",", " ", 
    StyleBox["l2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6870eae-d34d-424c-bbd9-a20adb7285db"],
 "\[LineSeparator]",
 "tests whether the two lines are perpendicular.",
 "\n"
}], "Usage",ExpressionUUID->"7f5a6d93-09de-4d75-8c96-73c00ff073a6"],

Cell[TextData[{
 "Definition, with the default ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Projection\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "535d2a37-bba1-4e16-8703-07b59475e24d"],
 ": at each common vertex, the foot of the perpendicular from one line onto \
the other must lie in the intersection of the two lines."
}], "Notes",ExpressionUUID->"8f6ab46d-5ac0-4504-ad72-134ed64c637c"],

Cell[TextData[{
 "The test is a conjunction over all common vertices. It is ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ae30b37-ff47-45a3-9494-94f3ca2f8f8f"],
 " when the lines do not meet."
}], "Notes",ExpressionUUID->"5a5c5545-1804-4323-934e-0fd3958761c2"],

Cell[TextData[{
 "There is no single right definition of a right angle on a graph, so there \
are several methods and they are ",
 StyleBox["not",
  FontWeight->"Bold"],
 " equivalent."
}], "Notes",ExpressionUUID->"25bb27d8-6fd0-46b5-b28c-e5b431760ee7"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e0a808d4-5c9e-4a62-9e54-f13bbaa73055"], Cell["Method", "TableText",
     FontWeight->Bold,ExpressionUUID->"b92a3f9f-a26f-46ff-bc5e-58d8e2f68928"],
     Cell["Tests", "TableText",
     FontWeight->Bold,ExpressionUUID->"46983940-28f5-47d8-9090-0162e34105ef"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "bf90cc3b-68cb-4983-ba7c-d92593e603cf"], Cell[TextData[{
     Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "09fd7da5-f9e3-447c-81df-eb740cd9e416"],
     " (default)"
    }], "TableText",ExpressionUUID->"c3baa894-72f1-4887-9d34-6bc76f06ce7b"], 
    Cell["the foot of the perpendicular lies in the intersection", 
     "TableText",ExpressionUUID->"79dfd341-1845-4ae8-a573-44ce7fc29685"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1b7179a0-b648-4ae7-aabb-45b2b558d34d"], Cell[TextData[Cell[
    BoxData["\"\<Coordinate\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a36005c0-9dce-444b-939d-bcae3f262f63"]], "TableText",ExpressionUUID->
     "b2e6f9c6-b007-4685-9600-b292344fa9ab"], Cell["\<\
signed projection coordinates of the feet are centred on the meeting point\
\>", "TableText",ExpressionUUID->"2649e52a-1263-4519-a77e-8e0687565943"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "690b7a83-cc00-48d1-86c7-61e423629194"], Cell[TextData[Cell[
    BoxData["\"\<Arclength\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9c71459c-76b3-486b-b59e-df168cafaf2d"]], "TableText",ExpressionUUID->
     "7ede2cf4-e26b-4cd7-b76f-8aef9e9e2545"], Cell["\<\
the four corner wedge angles at the meeting point are equal within a tolerance\
\>", "TableText",ExpressionUUID->"c7f4cc9e-6f49-4167-8a27-7a1920fda59f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f5bfaabf-ab52-4326-b2cd-56eabe222128"], Cell[TextData[Cell[
    BoxData["\"\<Alexandrov\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "310ef809-d478-429c-bd06-f44f89083a6a"]], "TableText",ExpressionUUID->
     "b0f080ac-24a9-4c64-b288-c450953de612"], Cell[TextData[{
     "the same, with comparison angles in the model plane of curvature ",
     StyleBox["k", "TI"]
    }], "TableText",ExpressionUUID->"214adcd8-71c5-4f89-b2af-b44ad39d9661"]}
  }]], "2ColumnTableMod",ExpressionUUID->"66dc5a5b-be21-4cf2-b2c0-\
a669a33f994e"],

Cell[TextData[{
 "Sub-options live inside the method spec, because their natural units differ \
per family. ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8cba16a-fee3-46bc-beb2-6b173570d5fa"],
 " takes ",
 Cell[BoxData["\"\<Equality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b43a1a5c-6776-447e-857a-50924fc9f6e1"],
 ", forwarded to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEqualQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEqualQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c6a8dcaf-2f82-40a5-a6d9-146caf35374c"],
 ": ",
 Cell[BoxData["\"\<Subset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f13148c3-df89-436f-ac21-8fda6840c440"],
 " is the default, and ",
 Cell[BoxData["\"\<Set\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9418bcd9-50d9-4fc9-9b81-6ee9befa1525"],
 ", ",
 Cell[BoxData["\"\<Multiset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8acf1ed7-6634-4d1c-8cdc-77719e1e9a16"],
 ", ",
 Cell[BoxData["\"\<Diffuse\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "657c281c-3a7c-4fcb-90e2-e07c989edda5"],
 " and ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65fc8cca-01cd-4db0-9b3b-dafd0df79934"],
 " are also accepted. ",
 Cell[BoxData["\"\<Coordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28f00644-c06c-4108-82b1-5a53b5aa3ee1"],
 " takes ",
 Cell[BoxData["\"\<ZeroTest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "832b8179-3b43-41ea-8e56-6ebd00ce7f1f"],
 ". ",
 Cell[BoxData["\"\<Arclength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dbb2bbd-8975-4e59-8a53-3c8b472f7836"],
 " and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f285dd3f-1fcd-4c91-9ea6-e788337c89d5"],
 " take ",
 Cell[BoxData["\"\<Tolerance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c215bd03-e429-410c-858c-3649ec7649c4"],
 " in radians, and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d85e0441-bff8-4fcf-adf3-246bbe45e2d7"],
 " takes ",
 Cell[BoxData["\"\<Curvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b99b94c-699b-4ce8-b508-b195c6da72b5"],
 ". Use ",
 Cell[BoxData[
  RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2aa4048-5dbe-42c2-8058-7c68a71e1f8c"],
 " for the synthetic right-angle test."
}], "Notes",ExpressionUUID->"13488606-4725-431c-b847-cf4ba6831e81"],

Cell[TextData[{
 "The top-level option ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "620e7ad5-590e-4837-8c83-0d1081c39ad4"],
 " localises the test to the ",
 StyleBox["r", "TI"],
 "-neighbourhood of the meeting point."
}], "Notes",ExpressionUUID->"24076774-eee4-427f-b909-b4f3d33162f7"],

Cell[TextData[{
 StyleBox["The default is strict.",
  FontWeight->"Bold"],
 " A line produced by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPerpendicular"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "26d72f14-696c-46ed-ae36-276734aca6da"],
 " with its default Euclid I.12 construction is generally rejected by this \
predicate under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Subset\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34cb9f73-aa3a-43b8-85e3-eb7b7bbf68df"],
 ", and accepted under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Overlap\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a29573dc-597c-449f-90b2-37440e143525"],
 ". The construction and the test are asking different questions: one lays \
off an isosceles base and takes its midpoint, the other demands that \
projections land exactly in the intersection. On a lattice those come apart. \
If you want the two to agree, pass ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64275650-7ad3-4344-aa0c-769d44964bed"],
 "."
}], "Notes",ExpressionUUID->"fcf1f19b-382a-4f7a-b6e1-60806b713e57"],

Cell["\<\
Two lines on a lattice can also meet in more than one vertex, which has no \
analogue in the plane, and the conjunction then has to hold at each of them.\
\>", "Notes",ExpressionUUID->"7c038ad9-dc7b-48eb-94cc-7271b776753b"]
}, Open  ]],

