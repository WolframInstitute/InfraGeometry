Cell[TextData[{
 "A line and a perpendicular to it, produced by the construction. The default \
test rejects it; the ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "262921ca-af09-4d5d-957b-29a57bf3cb9d"],
 " equality accepts it."
}], "ExampleText",ExpressionUUID->"4afe44d2-8376-4b38-ad57-815e6c7c5b33"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"l1", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ",
           "2"}], " ", "&&", " ", 
         RowBox[{"!", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"l1", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"l2", " ", "=", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindInfraPerpendicular", "[", 
        RowBox[{"g", ",", " ", "l1", ",", " ", "p", ",", " ", "1", ",", " ", 
         RowBox[{"\"\<Radius\>\"", " ", "->", " ", "3"}]}], "]"}]}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<default (Subset)\>\"", " ", "->", " ", 
      RowBox[{"InfraPerpendicularQ", "[", 
       RowBox[{"g", ",", " ", "l1", ",", " ", "l2"}], "]"}]}], ",", "\n", 
     "    ", 
     RowBox[{"\"\<Overlap\>\"", " ", "->", " ", 
      RowBox[{"InfraPerpendicularQ", "[", 
       RowBox[{"g", ",", " ", "l1", ",", " ", "l2", ",", " ", 
        RowBox[{"Method", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Projection\>\"", ",", " ", 
           RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Overlap\>\""}]}], 
          "}"}]}]}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<common vertices\>\"", " ", "->", " ", 
      RowBox[{"Intersection", "[", 
       RowBox[{"l1", ",", " ", "l2"}], "]"}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"13117f7b-4414-4248-841f-6210771fa4f2"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"default (Subset)\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"Overlap\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"common vertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "6"}], "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ef6e843f-9237-4e49-9afb-3da611af8c51"]
}, Open  ]],

Cell["\<\
The four methods on the same pair of lines. They are not equivalent, though \
on this pair all four reject.\
\>", "ExampleText",ExpressionUUID->"e0d6589c-5b09-43bb-9779-3b358bdf5f40"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"l1", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ",
           "2"}], " ", "&&", " ", 
         RowBox[{"!", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"l1", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"l2", " ", "=", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindInfraPerpendicular", "[", 
        RowBox[{"g", ",", " ", "l1", ",", " ", "p", ",", " ", "1", ",", " ", 
         RowBox[{"\"\<Radius\>\"", " ", "->", " ", "3"}]}], "]"}]}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Association", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"ToString", "[", "m", "]"}], " ", "->", " ", 
       RowBox[{"InfraPerpendicularQ", "[", 
        RowBox[{"g", ",", " ", "l1", ",", " ", "l2", ",", " ", 
         RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}]}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Projection\>\"", ",", " ", "\"\<Coordinate\>\"", ",", 
          " ", "\"\<Arclength\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<Alexandrov\>\"", ",", " ", 
            RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "0"}]}], "}"}]}], 
         "}"}]}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c6c58d15-e38d-46e3-a180-c5148e863801"],

