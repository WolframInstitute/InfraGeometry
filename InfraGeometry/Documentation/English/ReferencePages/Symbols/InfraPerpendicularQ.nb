Notebook[{

Cell[CellGroupData[{
Cell["InfraPerpendicularQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"643a89d7-a0f5-4b34-93ed-d819770c3038"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPerpendicularQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["l1", "TI"], ",", " ", 
    StyleBox["l2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0a9b5ca-90e6-4ed8-a0db-5bf857c4fdc4"],
 "\[LineSeparator]",
 "tests whether the two lines are perpendicular.",
 "\n"
}], "Usage",ExpressionUUID->"c959902c-5ae4-4dbb-8e19-8157518ada57"],

Cell[TextData[{
 "Definition, with the default ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Projection\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c53c91a-e518-4df1-8634-f4d0851b423f"],
 ": at each common vertex, the foot of the perpendicular from one line onto \
the other must lie in the intersection of the two lines."
}], "Notes",ExpressionUUID->"a76d5204-8966-4825-bffb-cef2d8ae3b8b"],

Cell[TextData[{
 "The test is a conjunction over all common vertices. It is ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5149735a-1994-4a48-94ec-c3ba977e6017"],
 " when the lines do not meet."
}], "Notes",ExpressionUUID->"a51ecc30-2c9b-4dab-ade8-3dffec2b1d8b"],

Cell[TextData[{
 "There is no single right definition of a right angle on a graph, so there \
are several methods and they are ",
 StyleBox["not",
  FontWeight->"Bold"],
 " equivalent."
}], "Notes",ExpressionUUID->"a8404e6e-3d5e-447c-9888-350d9721ba9c"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b8dcaa5a-1414-4415-afd0-0596c0fc7f56"], Cell["Method", "TableText",
     FontWeight->Bold,ExpressionUUID->"122fc5e7-2c6f-44f7-bf80-18d17b4fc4de"],
     Cell["Tests", "TableText",
     FontWeight->Bold,ExpressionUUID->"8b658341-2f02-4bbf-84f3-a1a89d515282"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b3ef7e60-7231-4be2-9a42-1a2cc9392255"], Cell[TextData[{
     Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "14eb513f-8dd0-485e-ae38-2c6147608ec4"],
     " (default)"
    }], "TableText",ExpressionUUID->"13fc5fb4-2405-4399-bb5f-c9b5e0c03b60"], 
    Cell["the foot of the perpendicular lies in the intersection", 
     "TableText",ExpressionUUID->"9e4e39c4-492f-424b-ad2d-3e1a3ed8549b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7c013ae2-2b4d-43c5-a104-e281193f7c2b"], Cell[TextData[Cell[
    BoxData["\"\<Coordinate\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0e3c4ca6-e663-4016-8b8e-d5570f1a17d0"]], "TableText",ExpressionUUID->
     "be98625d-2993-4ccd-abd5-4efa81ff03d6"], Cell["\<\
signed projection coordinates of the feet are centred on the meeting point\
\>", "TableText",ExpressionUUID->"ed97b3cb-6764-47f3-abc9-3b437f0e7c0c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3dcc1623-d57e-4f0e-a7ab-94507c1a3132"], Cell[TextData[Cell[
    BoxData["\"\<Arclength\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5331c424-95fe-420f-934d-bbd491df4ee8"]], "TableText",ExpressionUUID->
     "86c8bdf3-2f69-409d-8d5b-b852b5f08781"], Cell["\<\
the four corner wedge angles at the meeting point are equal within a tolerance\
\>", "TableText",ExpressionUUID->"b964d161-10b0-4be4-9b89-5e5ec225fc73"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2cc4088d-cead-4961-aebd-dc48d2662529"], Cell[TextData[Cell[
    BoxData["\"\<Alexandrov\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "84ede004-daf8-4ae1-90da-3e39a1f00569"]], "TableText",ExpressionUUID->
     "3400896f-1c4b-4ff7-bf7a-ba7999d037a4"], Cell[TextData[{
     "the same, with comparison angles in the model plane of curvature ",
     StyleBox["k", "TI"]
    }], "TableText",ExpressionUUID->"90a4b3da-ece4-48ad-b1a8-b9279087d040"]}
  }]], "2ColumnTableMod",ExpressionUUID->"dc14ff7b-f5cd-4f39-ac34-\
990b8559d656"],

Cell[TextData[{
 "Sub-options live inside the method spec, because their natural units differ \
per family. ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "352947a7-7a53-49cd-9c00-107afdebd65b"],
 " takes ",
 Cell[BoxData["\"\<Equality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "925562f7-7203-4d4c-aef2-852f4ae4e739"],
 ", forwarded to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEqualQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEqualQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "08b2ac43-e59c-4139-98d0-2ba93537dd46"],
 ": ",
 Cell[BoxData["\"\<Subset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf238470-6615-440e-bbf2-3fbdaa9d909f"],
 " is the default, and ",
 Cell[BoxData["\"\<Set\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a84791a1-691f-4c81-bfde-9c5708820c9d"],
 ", ",
 Cell[BoxData["\"\<Multiset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a70a5cb8-f080-470e-8ef2-e6b6ca57834c"],
 ", ",
 Cell[BoxData["\"\<Diffuse\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ee3b6cd-7dcf-4dfa-b8e9-351de9491a79"],
 " and ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f5f044f-037e-4804-abe9-0cc05242dc3e"],
 " are also accepted. ",
 Cell[BoxData["\"\<Coordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d5bb901-a4f7-4807-ab89-dea2ad20f3b3"],
 " takes ",
 Cell[BoxData["\"\<ZeroTest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47f3a67c-897b-4a8e-9333-d2d306832885"],
 ". ",
 Cell[BoxData["\"\<Arclength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b51eb3c1-c9a5-4f9a-9de3-bc57de7d6334"],
 " and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4210dd4d-370a-48de-827a-eb40aa551fc8"],
 " take ",
 Cell[BoxData["\"\<Tolerance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "793c43cf-63dc-41de-bd85-40a352280381"],
 " in radians, and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0e7dcdb-b228-4815-9bd4-89c70caf3204"],
 " takes ",
 Cell[BoxData["\"\<Curvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3088b17-56fb-43ff-bca2-c9ef9d4150f6"],
 ". Use ",
 Cell[BoxData[
  RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cd4cb94-7443-49f5-9d84-63f6f86970c1"],
 " for the synthetic right-angle test."
}], "Notes",ExpressionUUID->"a1b4ed27-9737-4525-9aca-d53fc7aa10c9"],

Cell[TextData[{
 "The top-level option ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "011ababb-f6af-4e21-b516-14eda98a7d4f"],
 " localises the test to the ",
 StyleBox["r", "TI"],
 "-neighbourhood of the meeting point."
}], "Notes",ExpressionUUID->"e41ab954-e919-46df-bc9f-cdbb44fbfad3"],

Cell[TextData[{
 StyleBox["The default is strict.",
  FontWeight->"Bold"],
 " A line produced by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPerpendicular"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPerpendicular", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "15b85f22-39f3-498c-8077-b6e64af3a7cf"],
 " with its default Euclid I.12 construction is generally rejected by this \
predicate under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Subset\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c59c354-767b-401a-bd8a-7ab0eef95b93"],
 ", and accepted under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Overlap\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d4e422c-64d8-4924-b891-8e4cae02c15f"],
 ". The construction and the test are asking different questions: one lays \
off an isosceles base and takes its midpoint, the other demands that \
projections land exactly in the intersection. On a lattice those come apart. \
If you want the two to agree, pass ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65ab4f9f-8c17-4f34-a762-53c7855a3135"],
 "."
}], "Notes",ExpressionUUID->"e8ba8ac8-4278-4604-b602-720dbd73e2ed"],

Cell["\<\
Two lines on a lattice can also meet in more than one vertex, which has no \
analogue in the plane, and the conjunction then has to hold at each of them.\
\>", "Notes",ExpressionUUID->"c05e079e-48ea-453d-b688-4d74a0c06f6c"]
}, Open  ]],

