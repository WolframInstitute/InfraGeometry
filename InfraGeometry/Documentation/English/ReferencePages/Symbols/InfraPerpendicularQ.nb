Cell[TextData[{
 "A line and a perpendicular to it, produced by the construction. The default \
test rejects it; the ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39f24e1f-d581-4fdc-a816-5c01ad3c8d46"],
 " equality accepts it."
}], "ExampleText",ExpressionUUID->"36c3254d-9c28-44c1-a24f-ed43158a8143"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"l1", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ",
           "2"}], " ", "&&", " ", 
         RowBox[{"!", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"l1", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"l2", " ", "=", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindInfraPerpendicular", "[", 
        RowBox[{"g", ",", " ", "l1", ",", " ", "p", ",", " ", "1", ",", " ", 
         RowBox[{"\"\<Radius\>\"", " ", "->", " ", "3"}]}], "]"}]}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<default (Subset)\>\"", " ", "->", " ", 
      RowBox[{"InfraPerpendicularQ", "[", 
       RowBox[{"g", ",", " ", "l1", ",", " ", "l2"}], "]"}]}], ",", "\n", 
     "    ", 
     RowBox[{"\"\<Overlap\>\"", " ", "->", " ", 
      RowBox[{"InfraPerpendicularQ", "[", 
       RowBox[{"g", ",", " ", "l1", ",", " ", "l2", ",", " ", 
        RowBox[{"Method", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Projection\>\"", ",", " ", 
           RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Overlap\>\""}]}], 
          "}"}]}]}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<common vertices\>\"", " ", "->", " ", 
      RowBox[{"Intersection", "[", 
       RowBox[{"l1", ",", " ", "l2"}], "]"}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4c7fca0e-3ae4-46cb-a136-5208e99347a7"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"default (Subset)\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"Overlap\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"common vertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "6"}], "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9a5e35f9-9c67-4d50-8b28-f32af479142a"]
}, Open  ]],

Cell["\<\
The four methods on the same pair of lines. They are not equivalent, though \
on this pair all four reject.\
\>", "ExampleText",ExpressionUUID->"1aa2b7e5-2491-4723-9175-85ce8b91597a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"l1", " ", "=", " ", 
     RowBox[{"FindInfraLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", " ",
           "2"}], " ", "&&", " ", 
         RowBox[{"!", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"l1", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"l2", " ", "=", " ", 
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindInfraPerpendicular", "[", 
        RowBox[{"g", ",", " ", "l1", ",", " ", "p", ",", " ", "1", ",", " ", 
         RowBox[{"\"\<Radius\>\"", " ", "->", " ", "3"}]}], "]"}]}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"Association", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"ToString", "[", "m", "]"}], " ", "->", " ", 
       RowBox[{"InfraPerpendicularQ", "[", 
        RowBox[{"g", ",", " ", "l1", ",", " ", "l2", ",", " ", 
         RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}]}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Projection\>\"", ",", " ", "\"\<Coordinate\>\"", ",", 
          " ", "\"\<Arclength\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<Alexandrov\>\"", ",", " ", 
            RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "0"}]}], "}"}]}], 
         "}"}]}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3f883488-3a67-4e46-aaeb-04d07b7b8e54"],

