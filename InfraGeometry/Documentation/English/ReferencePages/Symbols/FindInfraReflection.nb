Cell[TextData[{
 "The number of reflections of each point of the circle of radius 3 on the \
grid, ",
 StyleBox["r + 1 = 4", "TI"],
 " off the axes and ",
 StyleBox["2r + 1 = 7", "TI"],
 " on them:"
}], "ExampleText",ExpressionUUID->"4f77f05c-e4cc-49e9-b10e-3c197eaa5af4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"shell", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraShell", "[", 
         RowBox[{"c", ",", " ", "3"}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"AssociationMap", "[", 
        RowBox[{
         RowBox[{"x", " ", "|->", " ", 
          RowBox[{"Length", " ", "@", " ", 
           RowBox[{"FindInfraReflection", "[", 
            RowBox[{"g", ",", " ", "x", ",", " ", "c"}], "]"}]}]}], ",", " ", 
         "shell"}], "]"}], ",", " ", "c"}], "}"}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Counts", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", " ", "@", " ", 
          RowBox[{"FindInfraReflection", "[", 
           RowBox[{"g", ",", " ", "#", ",", " ", "c"}], "]"}]}], " ", "&"}], 
        " ", "/@", " ", "shell"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8e3bd55c-14dc-4ea7-bd92-9bac977f08d3"],

