Cell[TextData[{
 "Every reflection is at distance ",
 StyleBox["r", "TI"],
 " from ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["2r", "TI"],
 " from ",
 StyleBox["x", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"97a6a24d-cde5-415b-9828-c056dd8580b3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"x", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], ",", " ", 
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", "x", ",", " ", "#"}], "]"}]}], "}"}], " ", 
     "&"}], " ", "/@", " ", 
    RowBox[{"FindInfraReflection", "[", 
     RowBox[{"g", ",", " ", "x", ",", " ", "c"}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b85a27f0-cd1c-4893-b1f2-bda30df0fbdd"],

