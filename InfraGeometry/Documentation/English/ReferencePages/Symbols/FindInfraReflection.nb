Cell[CellGroupData[{
Cell["FindInfraReflection", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d658b1c4-1fb4-42ff-9bf2-f1eb0aadd92b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraReflection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraReflection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["x", "TI"], ",", " ", 
    StyleBox["a", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d502634-25b9-4bc8-9d33-e1bfa9c88cbb"],
 "\[LineSeparator]",
 "gives the reflections of the point ",
 StyleBox["x", "TI"],
 " through the point ",
 StyleBox["a", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6c2dcb2b-4435-44c9-8c8d-534564206041"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraReflection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraReflection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["x", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e063e068-3b70-4ade-8547-784dc70df3dc"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["n", "TI"],
 " of them."
}], "Usage",ExpressionUUID->"b19a3665-51ac-403d-b847-1f131ba482f8"],

Cell[TextData[{
 "A reflection of ",
 StyleBox["x", "TI"],
 " through ",
 StyleBox["a", "TI"],
 " is a vertex ",
 StyleBox["x\[Prime]", "TI"],
 " with ",
 StyleBox["d(a, x\[Prime]) = d(a, x)", "TI"],
 " and ",
 StyleBox["a", "TI"],
 " between ",
 StyleBox["x", "TI"],
 " and ",
 StyleBox["x\[Prime]", "TI"],
 ". Together the two conditions say ",
 StyleBox["d(a, x\[Prime]) = r", "TI"],
 " and ",
 StyleBox["d(x, x\[Prime]) = 2r", "TI"],
 ", with ",
 StyleBox["r = d(a, x)", "TI"],
 "."
}], "Notes",ExpressionUUID->"78a08146-4829-4d15-b125-6e4903f55a4e"],

Cell[TextData[{
 "In the plane the reflection is unique. On a graph there can be many, or \
none when the graph ends before distance ",
 StyleBox["2r", "TI"],
 " from ",
 StyleBox["x", "TI"],
 "."
}], "Notes",ExpressionUUID->"cae51439-3750-447d-8ea2-86ea01a3deac"],

Cell[TextData[{
 "On the square grid, away from the rim, the reflections are the vertices of \
the circle ",
 StyleBox["S\:1d63(a)", "TI"],
 " in the closed quadrant opposite ",
 StyleBox["x", "TI"],
 ": ",
 StyleBox["r + 1", "TI"],
 " vertices when ",
 StyleBox["x \[Minus] a", "TI"],
 " is off the axes, ",
 StyleBox["2r + 1", "TI"],
 " when it is on an axis."
}], "Notes",ExpressionUUID->"745573ec-c951-48ca-8c7b-43055aece2ee"],

Cell[TextData[{
 StyleBox["x", "TI"],
 " and ",
 StyleBox["a", "TI"],
 " can be vertices or regions. Regions give the reflections of every pair, \
pooled."
}], "Notes",ExpressionUUID->"9989f4b8-bdaa-406e-a79e-9e393c6cd67b"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81dc410f-a95b-4ca3-8935-c20964d88cc6"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20e6de8c-33b3-465e-b126-2d5a6cef0b9c"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0018e68-8b91-47d9-9b61-18e35686d01f"],
 ", the default. Fewer than ",
 StyleBox["n", "TI"],
 " reflections give ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "642861ea-d79e-4034-a482-59ef6481f702"],
 "."
}], "Notes",ExpressionUUID->"882a581a-e31a-4405-8d59-e6e4eb0caaf6"],

Cell["Corresponding notion in the classical axiom systems:", "Notes",ExpressionUUID->"18259eca-5cbe-4638-b36b-fe71904f2d02"],

