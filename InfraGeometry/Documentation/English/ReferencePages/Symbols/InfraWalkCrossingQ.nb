Cell[TextData[{
 "The walk must run on to distance ",
 StyleBox["r", "TI"],
 " + 1 from the vertex. The crossing walk ends at distance 2, so at scale 2 \
the test fails:"
}], "ExampleText",ExpressionUUID->"e57c0b9e-d475-44c9-97ea-a870fcfea372"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"walk", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "25", ",", " ", "35", ",", " ", "45", ",", " ", "55", ",", " ", "65", ",",
        " ", "66", ",", " ", "56", ",", " ", "46", ",", " ", "45", ",", " ", 
       "44", ",", " ", "43"}], "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraWalkCrossingQ", "[", 
      RowBox[{"g", ",", " ", "walk", ",", " ", "45", ",", " ", "r"}], "]"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "1", ",", " ", "2"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0ac158ca-1380-4553-bd6b-85fc292eaa6d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"27c00ab2-235c-42ca-8130-4b29481dc343"]
}, Open  ]],

Cell["\<\
A vertex visited three times is not a double point, and the test fails:\
\>", "ExampleText",ExpressionUUID->"4cd9a1ba-0a64-4342-8c55-5b49dbe3989a"],

