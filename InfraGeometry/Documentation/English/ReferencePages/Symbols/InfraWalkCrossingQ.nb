    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c167a4dd-2b5c-4072-857b-412a5fd3396f"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ade8dcb8-2670-4971-9f21-fafd44764f1f"],
 " if the two passes of ",
 StyleBox["walk", "TI"],
 " through the vertex ",
 StyleBox["v", "TI"],
 " cross at scale ",
 StyleBox["r", "TI"],
 ", and ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dfaace1-5bed-4bac-a1c5-1b71787fe198"],
 " if they only touch.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"93f43192-fb43-41d8-bad8-522dcbb0982b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWalkCrossingQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraWalkCrossingQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["i", "TI"], ",", " ", 
      StyleBox["j", "TI"]}], "}"}], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5288c0dc-af91-4505-9f48-fbbb3c5a2080"],
 "\[LineSeparator]",
 "tests the passes at the positions ",
 StyleBox["i", "TI"],
 " and ",
 StyleBox["j", "TI"],
 "."
}], "Usage",ExpressionUUID->"1e840e7d-d954-44a4-9051-79faed52b7ff"],

Cell[TextData[{
 "On a graph a double point has no tangent lines to compare, so the crossing \
is read at a distance. Each pass enters the ball ",
 StyleBox["B\:1d63\:208b\:2081(v)", "TI"],
 ", leaves it, and runs on through the annulus of the vertices at distance ",
 StyleBox["r", "TI"],
 " and ",
 StyleBox["r", "TI"],
 " + 1 from ",
 StyleBox["v", "TI"],
 ". The passes cross at scale ",
 StyleBox["r", "TI"],
 " when each one cuts the annulus between the two ends of the other."
}], "Notes",ExpressionUUID->"56f74959-0e80-4422-9c6e-8f4f9071d795"],

Cell[TextData[{
 "This is the linking of two pairs of points on a circle: on a surface-like \
substrate the passes cross when their ends alternate round ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"738039fb-d242-4c7c-89dc-299a5ec00c70"],

Cell[TextData[{
 "The test is ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "260a17f0-fd93-424e-9e16-3a0a41b2202c"],
 " unless ",
 StyleBox["v", "TI"],
 " is visited exactly twice, the two passes stay apart inside ",
 StyleBox["B\:1d63\:208b\:2081(v)", "TI"],
 ", and the walk reaches distance ",
 StyleBox["r", "TI"],
 " + 1 on both sides of both passes."
}], "Notes",ExpressionUUID->"f4a20f3d-b03f-4bb2-981e-53a5d5c6793b"],

Cell[TextData[{
 StyleBox["walk", "TI"],
 " is a vertex list, a walk graph, a list of walk graphs, or a cycle graph, \
read round the cycle."
}], "Notes",ExpressionUUID->"c33c090d-cf41-499a-a850-2d5372d63524"]
}, Open  ]],

