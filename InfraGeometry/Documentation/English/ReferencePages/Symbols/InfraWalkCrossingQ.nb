Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3579aad5-90bc-40ae-b989-ccb8faab7975"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWalkCrossingQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraWalkCrossingQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
