Cell["\<\
Two walks through the centre of the grid, each visiting it twice. The passes \
of the first cross; those of the second only touch:\
\>", "ExampleText",ExpressionUUID->"7959aaa6-c2cb-470e-a9e0-3fa9465aa99e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "25", ",", " ", "35", ",", " ", "45", ",", " ", "55", ",", " ", "65", 
         ",", " ", "66", ",", " ", "56", ",", " ", "46", ",", " ", "45", ",", 
         " ", "44", ",", " ", "43"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "25", ",", " ", "35", ",", " ", "45", ",", " ", "46", ",", " ", "47", 
         ",", " ", "57", ",", " ", "67", ",", " ", "66", ",", " ", "65", ",", 
         " ", "55", ",", " ", "45", ",", " ", "44", ",", " ", "43"}], "}"}]}],
       "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraWalk", "[", "w", "]"}], ",", " ", "45"}], "}"}], ",", 
        " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraWalkCrossingQ", "[", 
          RowBox[{"g", ",", " ", "w", ",", " ", "45", ",", " ", "1"}], 
          "]"}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"w", ",", " ", "walks"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"785180bf-fd72-4f59-ada8-fa54025f7a7e"],

