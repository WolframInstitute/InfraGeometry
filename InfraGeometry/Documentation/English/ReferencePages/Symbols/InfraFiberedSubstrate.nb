Cell["\<\
The trivial and covering entries are fiber bundles. The branched entries are \
fibrations but not bundles.\
\>", "ExampleText",ExpressionUUID->"3e97144a-b758-42c1-a080-25a34ab4008b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"name", " ", "->", " ", 
    RowBox[{"InfraFiberBundleQ", " ", "@", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}]}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"Join", " ", "@@", " ", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"InfraFiberedSubstrate", "[", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Trivial\>\"", ",", " ", "\"\<Covering\>\"", ",", 
          " ", "\"\<NonBundle\>\""}], "}"}]}], "]"}]}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4dce2399-f3cd-4915-bb75-7145fd08e0b2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"CycleProductBundle\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"GridProductBundle\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"CycleDoubleCover\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"MoebiusLadderCover\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"TriangularTorusDoubleCover\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"BranchedCycleFibration\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"BranchedGridFibration\"\>", "\[Rule]", "False"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"95d21c36-9054-4f12-b88a-48ccac5c2926"]
}, Open  ]],

Cell["\<\
The prism and the Moebius ladder have the same base and the same fiber. Only \
the twist tells them apart.\
\>", "ExampleText",ExpressionUUID->"7877e6fa-2f5f-4be1-9782-ea0ed763479b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"prism", " ", "=", " ", 
     RowBox[{"InfraTotalSpace", " ", "@", " ", 
      RowBox[{"InfraFiberedSubstrate", "[", 
       RowBox[{"\"\<CycleProductBundle\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"moebius", " ", "=", " ", 
     RowBox[{"InfraTotalSpace", " ", "@", " ", 
      RowBox[{"InfraFiberedSubstrate", "[", 
       RowBox[{"\"\<MoebiusLadderCover\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{"prism", ",", " ", "moebius"}], "}"}], "]"}]}], "]"}]}], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"5919c25b-d774-4976-86c9-b5e4dc17f7be"],

