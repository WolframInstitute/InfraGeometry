Cell["\<\
The trivial and covering entries are fiber bundles. The branched entries are \
fibrations but not bundles.\
\>", "ExampleText",ExpressionUUID->"c7bdf9a7-e461-4dd0-8699-339f584158c4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"name", " ", "->", " ", 
    RowBox[{"InfraFiberBundleQ", " ", "@", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}]}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"Join", " ", "@@", " ", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"InfraFiberedSubstrate", "[", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Trivial\>\"", ",", " ", "\"\<Covering\>\"", ",", 
          " ", "\"\<NonBundle\>\""}], "}"}]}], "]"}]}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fa1b65f7-8449-4d93-b807-d422253e6379"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"CycleProductBundle\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"GridProductBundle\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"CycleDoubleCover\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"MoebiusLadderCover\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"TriangularTorusDoubleCover\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"BranchedCycleFibration\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"BranchedGridFibration\"\>", "\[Rule]", "False"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"91e4a9c8-c571-4640-ae1a-775231eb5810"]
}, Open  ]],

Cell["\<\
The prism and the Moebius ladder have the same base and the same fiber. Only \
the twist tells them apart.\
\>", "ExampleText",ExpressionUUID->"b6341666-fd7c-4fa7-9ad5-4c07e68479c7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"prism", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", " ", "@", " ", 
      RowBox[{"InfraFiberedSubstrate", "[", 
       RowBox[{"\"\<CycleProductBundle\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"moebius", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", " ", "@", " ", 
      RowBox[{"InfraFiberedSubstrate", "[", 
       RowBox[{"\"\<MoebiusLadderCover\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{"prism", ",", " ", "moebius"}], "}"}], "]"}]}], "]"}]}], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"c721e9fe-144d-45ad-bc78-12bcdf13a8ef"],

