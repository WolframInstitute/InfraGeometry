Cell[TextData[{
 "The grid is the full ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GridGraph"]], "paclet:ref/GridGraph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6351c50c-b11c-4c93-a802-a061fc3c3766"],
 ". The octahedron has one size. ",
 StyleBox["size", "TI"],
 " may also be a raw size of the base: the length of a cycle, the dimensions \
of a grid or a torus, the cell area of a sphere mesh."
}], "Notes",ExpressionUUID->"add4fabd-0629-47ff-8cd5-84d021076ca0"],

Cell[TextData[{
 "A literal entry is an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "32dfa8ec-0cf4-4ed6-ba12-f7fa00b7aa72"],
 " with total vertices {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["k", "TI"],
 "}, the ",
 StyleBox["k", "TI"],
 "-th vertex over the base vertex ",
 StyleBox["p", "TI"],
 ". A tangent or displacement entry is the construction itself, and the \
readers accept it directly."
}], "Notes",ExpressionUUID->"88dd0e76-fcb9-4d97-bc79-c14991578d20"]
}, Open  ]],

