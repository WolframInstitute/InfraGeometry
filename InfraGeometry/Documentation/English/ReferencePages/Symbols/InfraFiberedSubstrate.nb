Cell["\<\
Nine entries at the small size. Each fiber is drawn around its base vertex.\
\>", "ExampleText",ExpressionUUID->"3575513b-293d-4141-8594-1c7d019cf8d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Partition", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"InfraTotalGraph", " ", "@", " ", 
       RowBox[{"InfraFiberedSubstrate", "[", 
        RowBox[{"#", ",", " ", "\"\<Small\>\""}], "]"}]}], " ", "&"}], " ", "/@",
      " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{"\"\<CycleProductBundle\>\"", ",", 
       " ", "\"\<MoebiusLadderCover\>\"", ",", " ", "\"\<CycleDoubleCover\>\"",
        ",", "\n", "    ", "\"\<GridProductBundle\>\"", ",", 
       " ", "\"\<TriangularTorusDoubleCover\>\"", ",", 
       " ", "\"\<BranchedGridFibration\>\"", ",", "\n", 
       "    ", "\"\<GridTangentBundle\>\"", ",", 
       " ", "\"\<GridDisplacementBundle\>\"", ",", 
       " ", "\"\<OctahedronDisplacementBundle\>\""}], "}"}]}], ",", "\n", 
    "  ", "3"}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4029b6b4-6470-41be-8829-ffd050b0ed5f"],

Cell[BoxData[
 GraphicsBox[{{}, {{InsetBox[
      FormBox[
       GraphicsBox[
        NamespaceBox["NetworkGraphics",
