   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "baad66d2-1eb5-4de1-8686-7efd7a67b25c"],
 ", whose rim vertices are pendant:"
}], "ExampleText",ExpressionUUID->"e2dc3bc7-cdd8-423a-8aad-46c634bd42f7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"VertexCount", " ", "@", " ", 
    RowBox[{"InfraBaseSpace", " ", "@", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridProductBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}]}], ",", "\n", " ", 
   RowBox[{"VertexCount", " ", "@", " ", 
    RowBox[{"InfraSubstrate", "[", 
     RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], 
     "]"}]}]}], "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4a64dc44-7f1f-4d16-919c-344bf9369b9d"],

