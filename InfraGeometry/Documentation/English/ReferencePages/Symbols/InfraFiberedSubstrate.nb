Cell["\<\
Nine entries at the small size. Each marked fiber is arranged around its base \
vertex.\
\>", "ExampleText",ExpressionUUID->"5a4789c9-d0fa-46e9-9508-e3e70e4e2969"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Partition", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
       RowBox[{"InfraFiberedSubstrate", "[", " ", 
        RowBox[{"#", ",", " ", "\"\<Small\>\""}], " ", "]"}], " ", "]"}], " ",
       "&"}], " ", "/@", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{"\"\<CycleProductBundle\>\"", ",", 
       " ", "\"\<MoebiusLadderCover\>\"", ",", " ", "\"\<CycleDoubleCover\>\"",
        ",", "\n", "    ", "\"\<GridProductBundle\>\"", ",", 
       " ", "\"\<TriangularTorusDoubleCover\>\"", ",", 
       " ", "\"\<BranchedGridFibration\>\"", ",", "\n", 
       "    ", "\"\<GridTangentBundle\>\"", ",", 
       " ", "\"\<GridDisplacementBundle\>\"", ",", 
       " ", "\"\<OctahedronDisplacementBundle\>\""}], "}"}]}], ",", "\n", 
    "  ", "3"}], "]"}]}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9d39e646-e928-4f27-ade9-8e66e35cf0bd"],

Cell[BoxData[
 GraphicsBox[{{}, {{InsetBox[
      RowBox[{"InfraFiberedGraphHighlight", "(", 
       RowBox[{"InfraFibration", "(", 
        RowBox[{
