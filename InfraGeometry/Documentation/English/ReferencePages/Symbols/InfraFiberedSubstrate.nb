Cell["The roster.", "ExampleText",ExpressionUUID->"e61a9ed8-1de9-45ed-aacb-9f804fcf0db4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"Normal", " ", "@", " ", 
  RowBox[{"InfraFiberedSubstrate", "[", "]"}]}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"51f445d8-46d4-43ad-9390-f390a8843292"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Trivial\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"CycleProductBundle\"\>", ",", "\<\"GridProductBundle\"\>"}],
      "}"}]}], ",", 
   RowBox[{"\<\"Covering\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"CycleDoubleCover\"\>", ",", "\<\"MoebiusLadderCover\"\>", 
      ",", "\<\"TriangularTorusDoubleCover\"\>"}], "}"}]}], ",", 
   RowBox[{"\<\"Tangent\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"GridTangentBundle\"\>", 
      ",", "\<\"TriangularTorusTangentBundle\"\>", 
      ",", "\<\"OctahedronTangentBundle\"\>", 
      ",", "\<\"SphereMeshTangentBundle\"\>"}], "}"}]}], ",", 
   RowBox[{"\<\"Displacement\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"GridDisplacementBundle\"\>", 
      ",", "\<\"TriangularTorusDisplacementBundle\"\>", 
      ",", "\<\"OctahedronDisplacementBundle\"\>", 
      ",", "\<\"SphereMeshDisplacementBundle\"\>"}], "}"}]}], ",", 
   RowBox[{"\<\"NonBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"BranchedCycleFibration\"\>", 
      ",", "\<\"BranchedGridFibration\"\>"}], "}"}]}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"3d5792c0-488c-4b12-b917-0ca920eed33c"]
}, Open  ]]
}, Open  ]],

