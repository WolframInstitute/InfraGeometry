Cell[TextData[{
 "The torus and sphere mesh use the corresponding combinatorial base graphs. \
The grid is a full ",
 Cell[BoxData["GridGraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05ab81f4-5fea-48fb-8e7e-dca941e8d6a9"],
 ". The octahedron has one size."
}], "Notes",ExpressionUUID->"26ddc2d8-da6a-4868-ad5b-c94d9c7d6c34"],

Cell[TextData[{
 "A literal entry has total vertices ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"p", ",", " ", "k"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ddba5fee-4181-45d8-805a-8005d910c4b1"],
