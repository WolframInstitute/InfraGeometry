Cell["\<\
Nine entries at the small size. Each fiber is drawn around its base vertex.\
\>", "ExampleText",ExpressionUUID->"ee971aca-ae9d-4e06-84ff-5b2cbbf61f42"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Partition", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"InfraTotalGraph", " ", "@", " ", 
       RowBox[{"InfraFiberedSubstrate", "[", 
        RowBox[{"#", ",", " ", "\"\<Small\>\""}], "]"}]}], " ", "&"}], " ", "/@",
      " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{"\"\<CycleProductBundle\>\"", ",", 
       " ", "\"\<MoebiusLadderCover\>\"", ",", " ", "\"\<CycleDoubleCover\>\"",
        ",", "\n", "    ", "\"\<GridProductBundle\>\"", ",", 
       " ", "\"\<TriangularTorusDoubleCover\>\"", ",", 
       " ", "\"\<BranchedGridFibration\>\"", ",", "\n", 
       "    ", "\"\<GridTangentBundle\>\"", ",", 
       " ", "\"\<GridDisplacementBundle\>\"", ",", 
       " ", "\"\<OctahedronDisplacementBundle\>\""}], "}"}]}], ",", "\n", 
    "  ", "3"}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e32f8fc1-47d7-4c35-a916-7f0c827c01a4"],

Cell[BoxData[
 GraphicsBox[{{}, {{InsetBox[
      FormBox[
       GraphicsBox[
        NamespaceBox["NetworkGraphics",
