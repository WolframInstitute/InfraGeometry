 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90438226-1f58-4845-a877-67ef8dfe70cc"],
 "-th vertex over the base vertex ",
 Cell[BoxData["p"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "976b8f57-68bc-4010-924c-a5e9b35d0570"],
 ". Structural evaluation stores no drawing coordinates; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraphHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraphHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "626afa90-7574-48b8-9f0d-52844103c5e1"],
 " arranges its fibers over the base."
}], "Notes",ExpressionUUID->"d0f4a4c8-9b43-44da-a447-914b2c44867e"],

Cell[TextData[{
 StyleBox["size", "TI"],
 " may also be a raw size of the base: the length of a cycle, the dimensions \
of a grid or a torus, the cell area of a sphere mesh."
}], "Notes",ExpressionUUID->"19ddf6bc-c824-4cf1-bec9-db37c3b4749e"]
