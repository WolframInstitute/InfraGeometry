Cell["Which entries are fibrations and which are fiber bundles:", \
"ExampleText",ExpressionUUID->"750faee5-c507-4904-b367-fcef616030cb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"name", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraFibrationQ", "[", "#", "]"}], ",", " ", 
        RowBox[{"InfraFiberBundleQ", "[", "#", "]"}]}], "}"}]}], " ", "&"}], 
    " ", "@", " ", 
    RowBox[{"InfraFiberedSubstrate", "[", 
     RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", "All", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5e6e9875-a696-4169-b6ed-11c33cc871d8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"CycleProductBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "True"}], "}"}]}], ",", 
   RowBox[{"\<\"GridProductBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "True"}], "}"}]}], ",", 
   RowBox[{"\<\"CycleDoubleCover\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "True"}], "}"}]}], ",", 
   RowBox[{"\<\"MoebiusLadderCover\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "True"}], "}"}]}], ",", 
   RowBox[{"\<\"TriangularTorusDoubleCover\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "True"}], "}"}]}], ",", 
   RowBox[{"\<\"GridTangentBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"\<\"TriangularTorusTangentBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"\<\"OctahedronTangentBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"\<\"SphereMeshTangentBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"\<\"GridDisplacementBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"\<\"TriangularTorusDisplacementBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"\<\"OctahedronDisplacementBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"\<\"SphereMeshDisplacementBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"\<\"BranchedCycleFibration\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"\<\"BranchedGridFibration\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"201f7c0d-178a-4c53-bd5c-0ea33da38755"]
}, Open  ]],

Cell["\<\
The prism and the Moebius ladder have isomorphic bases and isomorphic fibers, \
but their total graphs are not isomorphic:\
\>", "ExampleText",ExpressionUUID->"ca8d2a39-3e6c-40b2-9595-c54d58d6fcd5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"prism", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<CycleProductBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"moebius", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<MoebiusLadderCover\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"IsomorphicGraphQ", "[", 
      RowBox[{
       RowBox[{"f", "[", "prism", "]"}], ",", " ", 
       RowBox[{"f", "[", "moebius", "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"f", ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraBaseSpace", ",", " ", 
         RowBox[{
          RowBox[{"InfraFiber", "[", 
           RowBox[{"#", ",", " ", "1"}], "]"}], " ", "&"}], ",", " ", 
         "InfraTotalSpace"}], "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"92fa39b2-de4c-4fa7-8361-ad16e0b48b42"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"8266fb7e-24d5-48dc-b4f3-4e74c8f2d730"]
}, Open  ]]
}, Open  ]],

