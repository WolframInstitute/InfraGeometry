Cell["\<\
This is a particular Experimental construction in the Infra Fiber Bundles \
category. Its existing call forms remain available.\
\>", "Notes",ExpressionUUID->"140bdb38-c47f-4ace-a653-742c45ce1849"],

Cell[TextData[{
 "An entry is a fibration head: a construction ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTangentBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTangentBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "14ae2d89-acf5-44a0-a4a1-5ad4ada43bbb"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDisplacementBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bf110e6d-e17e-4634-bc46-d7f8e7a6ed1c"],
 ", or a literal ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "78fa77c4-2914-42bc-8b93-8885e3c314e2"],
 ". Every fibration function takes it as it is."
}], "Notes",ExpressionUUID->"cd781f7a-0681-4cef-a921-f392653d9660"],

Cell["The roster has five groups:", "Notes",ExpressionUUID->"ee9f6bc0-cd4b-477a-922a-592593fb9367"],

