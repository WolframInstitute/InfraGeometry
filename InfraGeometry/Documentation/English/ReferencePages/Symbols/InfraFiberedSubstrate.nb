Cell[TextData[{
 "The grid is the full ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GridGraph"]], "paclet:ref/GridGraph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "90c2db70-f695-40de-92be-42f050c14a8b"],
 ". The octahedron has one size. ",
 StyleBox["size", "TI"],
 " may also be a raw size of the base: the length of a cycle, the dimensions \
of a grid or a torus, the cell area of a sphere mesh."
}], "Notes",ExpressionUUID->"5f8da8fe-61cf-44ad-8965-813071c4bdae"],

Cell[TextData[{
 "A literal entry is an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "81bb3231-9c90-417c-988d-d57c03c24691"],
 " with total vertices {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["k", "TI"],
 "}, the ",
 StyleBox["k", "TI"],
 "-th vertex over the base vertex ",
 StyleBox["p", "TI"],
 ". A tangent or displacement entry is the construction itself, and the \
readers accept it directly."
}], "Notes",ExpressionUUID->"14eee324-3164-4b9c-9db4-04a5a1b83427"]
}, Open  ]],

