Cell["Which entries are fibrations and which are fiber bundles:", \
"ExampleText",ExpressionUUID->"62fad860-3983-451c-96a5-84d04695ea74"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"name", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraFibrationQ", "[", "#", "]"}], ",", " ", 
        RowBox[{"InfraFiberBundleQ", "[", "#", "]"}]}], "}"}]}], " ", "&"}], 
    " ", "@", " ", 
    RowBox[{"InfraFiberedSubstrate", "[", 
     RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", "All", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"95197ca5-a42f-4331-abaa-a64d01e137da"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"CycleProductBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "True"}], "}"}]}], ",", 
   RowBox[{"\<\"GridProductBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "True"}], "}"}]}], ",", 
   RowBox[{"\<\"CycleDoubleCover\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "True"}], "}"}]}], ",", 
   RowBox[{"\<\"MoebiusLadderCover\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "True"}], "}"}]}], ",", 
   RowBox[{"\<\"TriangularTorusDoubleCover\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "True"}], "}"}]}], ",", 
   RowBox[{"\<\"GridTangentBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"\<\"TriangularTorusTangentBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"\<\"OctahedronTangentBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"\<\"SphereMeshTangentBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"\<\"GridDisplacementBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"\<\"TriangularTorusDisplacementBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"\<\"OctahedronDisplacementBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"\<\"SphereMeshDisplacementBundle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"\<\"BranchedCycleFibration\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}], ",", 
   RowBox[{"\<\"BranchedGridFibration\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1e11a666-8b3d-44ab-a58c-ef1447a8d125"]
}, Open  ]],

Cell["\<\
The prism and the Moebius ladder have isomorphic bases and isomorphic fibers, \
but their total graphs are not isomorphic:\
\>", "ExampleText",ExpressionUUID->"f175bdd4-a2ca-4a4a-b178-400b6028ae57"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"prism", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<CycleProductBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"moebius", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<MoebiusLadderCover\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"IsomorphicGraphQ", "[", 
      RowBox[{
       RowBox[{"f", "[", "prism", "]"}], ",", " ", 
       RowBox[{"f", "[", "moebius", "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"f", ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraBaseSpace", ",", " ", 
         RowBox[{
          RowBox[{"InfraFiber", "[", 
           RowBox[{"#", ",", " ", "1"}], "]"}], " ", "&"}], ",", " ", 
         "InfraTotalSpace"}], "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"76d8d02d-c772-4d4b-a185-8de65c9e2030"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"ee516536-502b-4078-8c1c-29d973e117dd"]
}, Open  ]]
}, Open  ]],

