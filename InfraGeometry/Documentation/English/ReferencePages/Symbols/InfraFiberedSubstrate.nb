Cell["\<\
Nine entries at the small size. Each marked fiber is arranged around its base \
vertex.\
\>", "ExampleText",ExpressionUUID->"fdf20ac3-4604-4431-bf9a-24778d41ff27"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"GraphicsGrid", " ", "@", " ", 
  RowBox[{"Partition", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
       RowBox[{"InfraFiberedSubstrate", "[", " ", 
        RowBox[{"#", ",", " ", "\"\<Small\>\""}], " ", "]"}], " ", "]"}], " ",
       "&"}], " ", "/@", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{"\"\<CycleProductBundle\>\"", ",", 
       " ", "\"\<MoebiusLadderCover\>\"", ",", " ", "\"\<CycleDoubleCover\>\"",
        ",", "\n", "    ", "\"\<GridProductBundle\>\"", ",", 
       " ", "\"\<TriangularTorusDoubleCover\>\"", ",", 
       " ", "\"\<BranchedGridFibration\>\"", ",", "\n", 
       "    ", "\"\<GridTangentBundle\>\"", ",", 
       " ", "\"\<GridDisplacementBundle\>\"", ",", 
       " ", "\"\<OctahedronDisplacementBundle\>\""}], "}"}]}], ",", "\n", 
    "  ", "3"}], "]"}]}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"54b303b8-5997-4cf7-991c-28a05f8044b2"],

Cell[BoxData[
 GraphicsBox[{{}, {{InsetBox[
      FormBox[
       GraphicsBox[
