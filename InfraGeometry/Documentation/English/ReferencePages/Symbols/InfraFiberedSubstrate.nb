Cell["\<\
The trivial and covering entries are fiber bundles. The branched entries are \
fibrations but not bundles.\
\>", "ExampleText",ExpressionUUID->"fee92c84-30f1-4093-9699-816c902d5246"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"name", " ", "->", " ", 
    RowBox[{"InfraFiberBundleQ", " ", "@", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}]}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"Join", " ", "@@", " ", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"InfraFiberedSubstrate", "[", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Trivial\>\"", ",", " ", "\"\<Covering\>\"", ",", 
          " ", "\"\<NonBundle\>\""}], "}"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8d080d5b-3e13-4958-a604-cdc89d77275c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"CycleProductBundle\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"GridProductBundle\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"CycleDoubleCover\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"MoebiusLadderCover\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"TriangularTorusDoubleCover\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"BranchedCycleFibration\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"BranchedGridFibration\"\>", "\[Rule]", "False"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d4c34bc3-db32-4808-a5bd-a9efcaf00aee"]
}, Open  ]],

Cell["\<\
The prism and the Moebius ladder have the same base and the same fiber. Only \
the twist tells them apart.\
\>", "ExampleText",ExpressionUUID->"0f715492-9727-4f79-b2ed-7f75d7d92183"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"prism", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", " ", "@", " ", 
      RowBox[{"InfraFiberedSubstrate", "[", 
       RowBox[{"\"\<CycleProductBundle\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"moebius", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", " ", "@", " ", 
      RowBox[{"InfraFiberedSubstrate", "[", 
       RowBox[{"\"\<MoebiusLadderCover\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{"prism", ",", " ", "moebius"}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"86fe6c75-5189-4863-b8e6-40f26ca12df1"],

