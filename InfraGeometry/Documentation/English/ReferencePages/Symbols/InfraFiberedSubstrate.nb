Cell[TextData[{
 "The torus and sphere mesh use the corresponding combinatorial base graphs. \
The grid is a full ",
 Cell[BoxData["GridGraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9e30fcd-380b-41fd-a99d-324db0447c94"],
 ". The octahedron has one size."
}], "Notes",ExpressionUUID->"41ba8213-ea67-4e1c-9b7f-3e73beb90159"],

Cell[TextData[{
 "A literal entry has total vertices ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"p", ",", " ", "k"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6c9efb8-2879-4de3-b6cd-de9c5a68546e"],
