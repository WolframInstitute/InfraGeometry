Cell[TextData[{
 "The grid entries are over the full ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GridGraph"]], "paclet:ref/GridGraph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cbd0c3c1-ff09-480e-986d-b8ed83ce0686"],
