Cell["\<\
Between one and three new vertices over every vertex, drawn for each vertex.\
\>", "ExampleText",ExpressionUUID->"937e9d94-6acb-4869-8bdf-bd22902d4383"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "6"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InflateGraph", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", ",", " ", 
     RowBox[{
      RowBox[{"Counts", "[", 
       RowBox[{"Length", " ", "/@", " ", 
        RowBox[{"GatherBy", "[", 
         RowBox[{
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "inflated", "]"}], ",", " ", 
            "_InflatedVertex"}], "]"}], ",", " ", "First"}], "]"}]}], "]"}], 
      " ", "//", " ", "KeySort"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a661f8bd-b2e7-4ae5-88e2-d3c79add7b32"],

