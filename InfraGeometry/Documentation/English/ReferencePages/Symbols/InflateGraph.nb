Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
         " ", "\"\<Default\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}], ",", 
         " ", 
         RowBox[{"\"\<Inflate\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", 
            RowBox[{"\"\<VerticalEdges\>\"", " ", "->", " ", "1"}]}], 
           "}"}]}]}], "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"direct", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InflateGraph", "[", 
        RowBox[{
         RowBox[{"InfraSubstrate", "[", 
          
          RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
            " ", "\"\<Default\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}], ",", " ", "2", ",", " ", 
         RowBox[{"\"\<VerticalEdges\>\"", " ", "->", " ", "1"}]}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", ",", " ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"EdgeList", "[", "inflated", "]"}], "]"}], " ", "===", " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"EdgeList", "[", "direct", "]"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"bd5c8408-cac8-432a-9d97-b73d6845aeb6"],

