Cell[CellGroupData[{
Cell["InflateGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"42e94c33-e9df-43be-b9c3-d2246e5d91b7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflateGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflateGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2886732c-17ec-4c0d-b86e-102f5378250e"],
 "\[LineSeparator]",
 "grows a fiber of new vertices over every vertex of ",
 StyleBox["g", "TI"],
 ", joins each new vertex to its base vertex, and adds random edges from \
every fiber to the vertices nearby.",
 "\n"
}], "Usage",ExpressionUUID->"e1e8dc56-2736-4096-96ec-95c37a801ccf"],

Cell[TextData[{
 "Construction: over every vertex ",
 StyleBox["v", "TI"],
 " of ",
 StyleBox["g", "TI"],
 ", a fiber of ",
 StyleBox["k", "TI"],
 " new vertices ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflatedVertex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflatedVertex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", "1"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0c809f2-c0f5-47c7-a37d-95171d91826c"],
 ", \[Ellipsis], ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflatedVertex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflatedVertex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff688dd1-e875-4d41-ae3d-d08c3bb791aa"],
 ", each joined to ",
 StyleBox["v", "TI"],
 ", with ",
 StyleBox["k", "TI"],
 " drawn from ",
 Cell[BoxData["\"\<ExtraVertices\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "901d9947-c463-4c0c-90cf-bb8d2a179677"],
 ". Inside each fiber, ",
 Cell[BoxData["\"\<ExtraEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "129c9b6a-a9d0-428e-9759-1a890b59af9c"],
 " random pairs are joined. Then let ",
 StyleBox["N", "TI"],
 " be the vertices of ",
 StyleBox["g", "TI"],
 " within ",
 Cell[BoxData["\"\<Radius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b96c33f-70d9-4cb8-b53e-b86febb5902d"],
 " of ",
 StyleBox["v", "TI"],
 " and ",
 StyleBox["R", "TI"],
 " the new vertices over them: a random sample of the pairs of a vertex of \
the fiber of ",
 StyleBox["v", "TI"],
 " and a vertex of ",
 StyleBox["N", "TI"],
 " \:222a ",
 StyleBox["R", "TI"],
 " is joined, of a random size between 0 and ",
 StyleBox["density", "TI"],
 " |",
 StyleBox["R", "TI"],
 "| / |",
 StyleBox["N", "TI"],
 "|, rounded."
}], "Notes",ExpressionUUID->"aab3bc84-f653-4091-8ce4-521556337f8e"],

Cell[TextData[{
 Cell[BoxData["\"\<ExtraVertices\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a6b433c-9188-4c1a-9e25-075b53ce8c7a"],
 " and ",
 Cell[BoxData["\"\<ExtraEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1db38597-5462-4860-9c34-32df17009605"],
 " take a number or a range {",
 StyleBox["min", "TI"],
 ", ",
 StyleBox["max", "TI"],
 "}, drawn for each vertex of ",
 StyleBox["g", "TI"],
 "; ",
 Cell[BoxData["\"\<Radius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65ffd61a-fe4c-426b-bf97-5cc054859e8c"],
 " is drawn once."
}], "Notes",ExpressionUUID->"74e59547-33e4-4a90-8149-09ad77cd3d98"],

Cell[TextData[{
 "The base graph is untouched: the subgraph induced on the vertices of ",
 StyleBox["g", "TI"],
 " is ",
 StyleBox["g", "TI"],
 ". A new vertex is placed at a random point near its base vertex, within 0.3 \
of the mean edge length."
}], "Notes",ExpressionUUID->"a90f68e4-8d63-4115-b2d0-69e77a8db73d"],

Cell[TextData[{
 "The construction draws at random, so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "52e08e72-4ed4-4264-89f1-a4787d8e914e"],
