Cell["Density", "ExampleSubsection",ExpressionUUID->"9ac8951d-fceb-4454-9b10-da9301b7cad6"],

Cell["With density 0 a fiber is joined only to its base vertex.", \
"ExampleText",ExpressionUUID->"a84a4b2e-debd-4e9d-ad60-38e730c049b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "6"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"InflateGraph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"\"\<ExtraVertices\>\"", " ", "->", " ", "1"}], ",", " ", 
          RowBox[{"\"\<Density\>\"", " ", "->", " ", "density"}]}], "]"}]}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"density", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1", ",", " ", "3"}], "}"}]}], "}"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", "inflated", "]"}], ",", " ", 
     RowBox[{"EdgeCount", " ", "/@", " ", "inflated"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c299b649-170f-4317-a699-4d580e019fd0"],

