Cell["HorizontalEdges", "ExampleSubsection",ExpressionUUID->"0c4d96d3-d451-4f70-83d3-e6a3c7ca461a"],

Cell["\<\
Two new vertices over every vertex, with none, one and all four of the edges \
between the fibers over each edge.\
\>", "ExampleText",ExpressionUUID->"61c9c303-642f-43a5-ad7a-421264d05f8e"],

