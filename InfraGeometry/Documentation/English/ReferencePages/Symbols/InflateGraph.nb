Cell["A range is drawn for each edge: between none and two edges.", \
"ExampleText",ExpressionUUID->"0563ad98-88d1-4b48-9a57-000fce970a29"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InflateGraph", "[", 
        RowBox[{"g", ",", " ", "2", ",", " ", 
         RowBox[{"\"\<HorizontalEdges\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "2"}], "}"}]}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"horizontal", " ", "=", " ", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"EdgeList", "[", "inflated", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"UndirectedEdge", "[", 
          RowBox[{
           RowBox[{"InflatedVertex", "[", 
            RowBox[{"p_", ",", " ", "_"}], "]"}], ",", " ", 
           RowBox[{"InflatedVertex", "[", 
