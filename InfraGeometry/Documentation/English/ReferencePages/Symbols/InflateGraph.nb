Cell["\<\
The discretized plane, the square tiling and the hexagonal tiling with one \
new vertex over every vertex, the new vertices drawn red.\
\>", "ExampleText",ExpressionUUID->"e388804b-60b9-44fc-8fde-2e92923766e3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"inflated", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"InflateGraph", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"\"\<ExtraVertices\>\"", " ", "->", " ", "1"}]}], "]"}]}],
          ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"inflated", ",", " ", 
        RowBox[{"{", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "inflated", "]"}], ",", " ", 
           "_InflatedVertex"}], "]"}], "}"}]}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"101c8a27-aea1-46c1-8554-e066de4c6dbd"],

