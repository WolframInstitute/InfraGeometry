Cell[TextData[{
 "The default inflation is the prism over ",
 StyleBox["g", "TI"],
 ", the product of ",
 StyleBox["g", "TI"],
 " with an edge."
}], "ExampleText",ExpressionUUID->"592045e2-b406-46bc-b02e-570aa674cd8a"],

