Cell["\<\
The square grid and the square mesh with two new vertices over every vertex:\
\>", "ExampleText",ExpressionUUID->"2921f35a-d7f8-4ca4-b99f-26545decd4ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"BlockRandom", "[", 
       RowBox[{
        RowBox[{"InflateGraph", "[", 
         RowBox[{"g", ",", " ", "2"}], "]"}], ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}], ",",
     "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

