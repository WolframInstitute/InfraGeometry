Notebook[{

Cell[CellGroupData[{
Cell["InflateGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9c5c7883-c83a-4536-bd7d-1da990a5879d"],
 Cell[BoxData[
  RowBox[{"InflateGraph", "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "452bb009-bce4-472d-8b1b-3be980a99dd2"],
 "\[LineSeparator]",
 "grows a fiber of new vertices over every vertex of ",
 StyleBox["g", "TI"],
 ", joins each new vertex to its base vertex, and adds random edges from \
every fiber to the vertices nearby.",
 "\n"
}], "Usage",ExpressionUUID->"4c658232-e873-4e68-9e68-98807448b412"],

Cell[TextData[{
 "Construction: over every vertex ",
 StyleBox["v", "TI"],
 " of ",
 StyleBox["g", "TI"],
 ", a fiber of ",
 StyleBox["k", "TI"],
 " new vertices ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflatedVertex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflatedVertex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", "1"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "933e48e9-2986-4a01-a6f3-bda6119ccafa"],
 ", \[Ellipsis], ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflatedVertex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflatedVertex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75acd991-70fe-4866-b267-a203ef0c92cb"],
 ", each joined to ",
 StyleBox["v", "TI"],
 ", with ",
 StyleBox["k", "TI"],
 " drawn from ",
 Cell[BoxData["\"\<ExtraVertices\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bcb226c-a4bd-4f6f-945c-f92885cfe07e"],
 ". Inside each fiber, ",
 Cell[BoxData["\"\<ExtraEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d35e009c-10c0-4bee-bc37-11f9aa063e42"],
 " random pairs are joined. Then let ",
 StyleBox["N", "TI"],
 " be the vertices of ",
 StyleBox["g", "TI"],
 " within ",
 Cell[BoxData["\"\<Radius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f80e503e-8a9d-44d1-8579-1056640abaf8"],
 " of ",
 StyleBox["v", "TI"],
 " and ",
 StyleBox["R", "TI"],
 " the new vertices over them: a random sample of the pairs of a vertex of \
the fiber of ",
 StyleBox["v", "TI"],
 " and a vertex of ",
 StyleBox["N", "TI"],
 " \:222a ",
 StyleBox["R", "TI"],
 " is joined, of a random size between 0 and ",
 StyleBox["density", "TI"],
 " |",
 StyleBox["R", "TI"],
 "| / |",
 StyleBox["N", "TI"],
 "|, rounded."
}], "Notes",ExpressionUUID->"5bcad950-dc7f-4d1c-9b60-fb543c0673fc"],

Cell[TextData[{
 Cell[BoxData["\"\<ExtraVertices\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15723db1-f4d0-4a73-8cb9-48cfdfa07503"],
 " and ",
 Cell[BoxData["\"\<ExtraEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9e512a8-d971-4f2d-a3d6-096ca9c26895"],
 " take a number or a range {",
 StyleBox["min", "TI"],
 ", ",
 StyleBox["max", "TI"],
 "}, drawn for each vertex of ",
 StyleBox["g", "TI"],
 "; ",
 Cell[BoxData["\"\<Radius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4c28332-67cc-4a71-9605-802520f25207"],
 " is drawn once."
}], "Notes",ExpressionUUID->"9ee08f5d-29aa-41b6-88f8-c13170e2ddad"],

Cell[TextData[{
 "The base graph is untouched: the subgraph induced on the vertices of ",
 StyleBox["g", "TI"],
 " is ",
 StyleBox["g", "TI"],
 ". A new vertex is placed at a random point near its base vertex, within 0.3 \
of the mean edge length."
}], "Notes",ExpressionUUID->"eac2262d-de8d-4db6-b775-bb2b65268b30"],

Cell[TextData[{
 "The construction draws at random, so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "163c9060-5d8e-40e5-ae4a-237a4ecc5e85"],
 " fixes the result. ",
 Cell[BoxData["InfraSubstrate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "acdfa5c7-ac02-4637-adb9-e09d386db7f7"],
 " inflates any substrate through its option ",
 Cell[BoxData["\"\<Inflate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e69811fb-cf4e-41e5-8a60-359f7e282e57"],
 "."
}], "Notes",ExpressionUUID->"a3367358-fba1-4df1-99b6-20ce26ca769d"],

