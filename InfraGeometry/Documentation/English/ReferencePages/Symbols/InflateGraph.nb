Cell["\<\
Between one and three new vertices over every vertex, drawn for each vertex.\
\>", "ExampleText",ExpressionUUID->"8d686a6f-620d-431f-80df-4aefd3182d4c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "6"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InflateGraph", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", ",", " ", 
     RowBox[{
      RowBox[{"Counts", "[", 
       RowBox[{"Length", " ", "/@", " ", 
        RowBox[{"GatherBy", "[", 
         RowBox[{
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "inflated", "]"}], ",", " ", 
            "_InflatedVertex"}], "]"}], ",", " ", "First"}], "]"}]}], "]"}], 
      " ", "//", " ", "KeySort"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"941d36c0-3c13-4b80-8537-8553b92993a3"],

