       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fibers", " ", "=", " ", 
     RowBox[{"VertexDelete", "[", 
