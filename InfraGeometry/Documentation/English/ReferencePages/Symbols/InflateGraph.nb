Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InflateGraph", "[", 
        RowBox[{
         RowBox[{"GridGraph", "[", 
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], ",", " ", "2", ",", 
         " ", 
         RowBox[{"\"\<VerticalEdges\>\"", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\"\<HorizontalEdges\>\"", " ", "->", " ", "2"}]}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"VertexCount", "[", "inflated", "]"}], ",", " ", 
       RowBox[{"EdgeCount", "[", "inflated", "]"}]}], "}"}], ",", " ", 
     RowBox[{"SimpleGraphQ", "[", "inflated", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"74d446f5-3dcd-4db8-8028-61c4c051ce15"],

