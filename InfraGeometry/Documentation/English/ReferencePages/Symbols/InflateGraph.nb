Cell["The base graph is the subgraph induced on its vertices.", "ExampleText",ExpressionUUID->"abd9015d-1864-4eae-9e1f-f82db4192def"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InflateGraph", "[", 
        RowBox[{"g", ",", " ", "2", ",", " ", 
         RowBox[{"\"\<VerticalEdges\>\"", " ", "->", " ", "1"}]}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"inflated", ",", " ", 
       RowBox[{"{", 
        RowBox[{"VertexList", "[", "g", "]"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"EdgeList", "[", 
        RowBox[{"Subgraph", "[", 
         RowBox[{"inflated", ",", " ", 
          RowBox[{"VertexList", "[", "g", "]"}]}], "]"}], "]"}], "]"}], " ", "===",
       " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"EdgeList", "[", "g", "]"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a44b70fc-91d9-40ec-8bd8-4df28f4af29b"],

