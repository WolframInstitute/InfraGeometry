Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraFibration"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraFibration", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b7e76ee1-18b2-4cef-80d0-9ed3725d5685"],
 " grows fibers with vertical edges too, but it keeps no base and no spokes, \
and its horizontal edges are a matching, not a draw. With one vertex over \
every vertex the two agree: the new vertices of the inflation span a copy of ",
 StyleBox["g", "TI"],
 ", as the total graph of the fibration does."
}], "ExampleText",ExpressionUUID->"2579436e-3672-462b-8304-479d9e50ee8b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fibers", " ", "=", " ", 
     RowBox[{"VertexDelete", "[", 
      RowBox[{
       RowBox[{"InflateGraph", "[", "g", "]"}], ",", " ", 
       RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", 
      RowBox[{"RandomInfraFibration", "[", "g", "]"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{"fibers", ",", " ", "total"}], "}"}], "]"}], ",", " ", 
