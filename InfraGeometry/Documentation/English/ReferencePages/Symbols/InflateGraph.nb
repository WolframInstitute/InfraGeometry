Cell["\<\
The discretized plane, the square tiling and the hexagonal tiling with one \
new vertex over every vertex, the new vertices drawn red.\
\>", "ExampleText",ExpressionUUID->"60ca4f0e-c153-443b-89a8-6e5a7418e7d0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"inflated", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"InflateGraph", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"\"\<ExtraVertices\>\"", " ", "->", " ", "1"}]}], "]"}]}],
          ")"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"inflated", ",", " ", 
        RowBox[{"{", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "inflated", "]"}], ",", " ", 
           "_InflatedVertex"}], "]"}], "}"}]}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9cc0e9e7-a03e-41f8-84d8-24d4a97e4e5b"],

