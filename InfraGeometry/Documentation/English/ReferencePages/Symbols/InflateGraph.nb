Cell[CellGroupData[{

Cell["Density", "ExampleSubsection",ExpressionUUID->"4bb8aaee-5143-47f6-aa68-1debd99fbf75"],

Cell["With density 0 a fiber is joined only to its base vertex.", \
"ExampleText",ExpressionUUID->"854746a7-94c9-40a5-91ff-42981dfd3eca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "6"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"InflateGraph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"\"\<ExtraVertices\>\"", " ", "->", " ", "1"}], ",", " ", 
          RowBox[{"\"\<Density\>\"", " ", "->", " ", "density"}]}], "]"}]}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"density", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1", ",", " ", "3"}], "}"}]}], "}"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", "inflated", "]"}], ",", " ", 
     RowBox[{"EdgeCount", " ", "/@", " ", "inflated"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a65db5bb-92e0-4a31-aa58-36da9fc66585"],

