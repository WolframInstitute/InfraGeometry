Notebook[{

Cell[CellGroupData[{
Cell["InflateGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7a1043b1-4f0f-44f8-933c-6f2e6220fcb6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflateGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflateGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9a1f2e4-07f7-4c5e-b6e3-f74e861e1eb0"],
 "\[LineSeparator]",
 "grows a fiber of ",
 StyleBox["k", "TI"],
 " new vertices over every vertex of ",
 StyleBox["g", "TI"],
 ", joins each new vertex to its vertex, and adds random edges inside each \
fiber and between the fibers over each edge of ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"85fcab16-2cd5-40ac-a8d5-6aca3704fcd6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflateGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflateGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce1dce84-e047-454f-a6b0-6543aa63f0f0"],
 "\[LineSeparator]",
 "grows one new vertex over every vertex."
}], "Usage",ExpressionUUID->"ccea8a9f-3171-42cf-a6f0-231309f99a14"],

Cell[TextData[{
 "Construction: over every vertex ",
 StyleBox["v", "TI"],
 " of ",
 StyleBox["g", "TI"],
 ", a fiber of new vertices ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflatedVertex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflatedVertex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", "1"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f93194e-ad0c-4621-8d66-0b995a887ffe"],
 ", \[Ellipsis], ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflatedVertex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflatedVertex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f77034e-1ae2-4444-8881-7678887b8a09"],
 ", each joined to ",
 StyleBox["v", "TI"],
 ". ",
 StyleBox["k", "TI"],
 " is a number or a range {",
 StyleBox["min", "TI"],
 ", ",
 StyleBox["max", "TI"],
 "}, drawn for each vertex."
}], "Notes",ExpressionUUID->"aad6d0a2-3541-4a99-b44a-dfd92096dcd2"],

Cell["An edge of the result is of one of four kinds:", "Notes",ExpressionUUID->"f0f5bc0b-b574-42d8-aa26-d180ef78a1ec"],

Cell[TextData[{
 "an edge of ",
 StyleBox["g", "TI"]
}], "Notes",ExpressionUUID->"842a122f-c9c5-4c2a-8d79-5517db41b809"],

Cell["a spoke, from a vertex to a vertex of its fiber", "Notes",ExpressionUUID->"147d9c8c-2740-4c9c-a13e-6153646f3573"],

Cell["a vertical edge, between two vertices of one fiber", "Notes",ExpressionUUID->"5a1d0de3-6410-467e-86a0-c31b3a554a21"],

Cell[TextData[{
 "a horizontal edge, between the fibers over the two ends of an edge of ",
 StyleBox["g", "TI"]
}], "Notes",ExpressionUUID->"0f510be8-e0d4-45f0-907c-f6f2be99a3f4"],

Cell[TextData[{
 Cell[BoxData["\"\<VerticalEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7cbe175-2a9c-4146-8db9-81fe337b6c88"],
 " random pairs of each fiber are joined, and ",
 Cell[BoxData["\"\<HorizontalEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd47f78e-f925-44a7-b431-1dbede575afa"],
 " random pairs of the two fibers over each edge. Each is a number or a range \
{",
 StyleBox["min", "TI"],
 ", ",
 StyleBox["max", "TI"],
 "}, drawn for each fiber and for each edge. A number larger than the pairs \
available joins them all."
}], "Notes",ExpressionUUID->"c35c58c4-2f7e-448d-a6b4-d83c2f8d0477"],

Cell[TextData[{
 "The result is a simple graph. With ",
 StyleBox["k", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") new vertices over ",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["m", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") vertical edges in its fiber and ",
 StyleBox["h", "TI"],
 "(",
 StyleBox["e", "TI"],
 ") horizontal edges over the edge ",
 StyleBox["e", "TI"],
 ", it has |",
 StyleBox["V", "TI"],
 "| + \[CapitalSigma] ",
 StyleBox["k", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") vertices and |",
 StyleBox["E", "TI"],
 "| + \[CapitalSigma] ",
 StyleBox["k", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") + \[CapitalSigma] ",
 StyleBox["m", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") + \[CapitalSigma] ",
 StyleBox["h", "TI"],
 "(",
 StyleBox["e", "TI"],
 ") edges."
}], "Notes",ExpressionUUID->"a6f4ef93-11b4-4638-9b23-beed94a90def"],

Cell[TextData[{
 "The base graph is untouched: the subgraph induced on the vertices of ",
 StyleBox["g", "TI"],
 " is ",
 StyleBox["g", "TI"],
 ", and a new vertex is joined to no vertex of ",
 StyleBox["g", "TI"],
 " but its own."
}], "Notes",ExpressionUUID->"f5b230a7-407d-4f05-9cbd-dd9b878fb203"],

Cell[TextData[{
 "The fiber over ",
 StyleBox["v", "TI"],
 " lies on a circle about ",
 StyleBox["v", "TI"],
 " whose radius is a third of the shortest edge of ",
 StyleBox["g", "TI"],
 ", in the dimension of the embedding of ",
 StyleBox["g", "TI"],
 "."
}], "Notes",ExpressionUUID->"6c98cadf-445c-4099-b756-5915353ef70c"],

Cell[TextData[{
 "The construction draws at random, so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cb58c4bd-5b94-4bfe-8c5b-4a827f79e926"],
 " fixes the result. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "48568ccb-58a4-40fb-99ea-ac2749c9b1eb"],
 " inflates any substrate through its option ",
 Cell[BoxData["\"\<Inflate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3095c86a-7d24-4087-9251-2515126dfd75"],
 "."
}], "Notes",ExpressionUUID->"95d88a82-8725-419b-92a8-ca8a7d65a38f"],

