Cell[TextData[{
 "With two vertices over every vertex they differ: at its defaults the \
fibration joins vertex ",
 StyleBox["i", "TI"],
 " over one end of an edge to vertex ",
 StyleBox["i", "TI"],
 " over the other, while the inflation draws its horizontal edges at random."
}], "ExampleText",ExpressionUUID->"bf79beb6-ca6d-4ddd-a6ea-1da9ecf1f40c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "8", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fibers", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"VertexDelete", "[", 
        RowBox[{
         RowBox[{"InflateGraph", "[", 
          RowBox[{"g", ",", " ", "2", ",", " ", 
           RowBox[{"\"\<HorizontalEdges\>\"", " ", "->", " ", "2"}]}], "]"}], 
         ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InfraTotalGraph", "[", 
        RowBox[{"RandomInfraFibration", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"\"\<VerticalVertices\>\"", " ", "->", " ", "2"}]}], "]"}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{"fibers", ",", " ", "total"}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"5f5120c3-648d-4eb9-a383-6c24e0e89680"],

