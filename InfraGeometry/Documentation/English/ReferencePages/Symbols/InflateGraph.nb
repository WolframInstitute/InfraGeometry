Cell["\<\
The counts follow from the amounts. The grid has 96 vertices and 144 edges; \
two new vertices over each, one vertical edge per fiber and two horizontal \
edges per edge give 96 + 192 vertices and 144 + 192 + 96 + 288 edges:\
\>", "ExampleText",ExpressionUUID->"e60e172d-2546-4839-b0e1-cdf5dbd0e7b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"BlockRandom", "[", 
      RowBox[{
       RowBox[{"InflateGraph", "[", 
        RowBox[{"g", ",", " ", "2", ",", " ", 
         RowBox[{"\"\<VerticalEdges\>\"", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\"\<HorizontalEdges\>\"", " ", "->", " ", "2"}]}], "]"}], ",",
        " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"inflated", ",", " ", 
     RowBox[{"{", 
      RowBox[{"VertexList", "[", "g", "]"}], "}"}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"VertexCount", "[", "inflated", "]"}], ",", " ", 
        RowBox[{"EdgeCount", "[", "inflated", "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2e1e5280-07cc-43a7-89d5-24f63b7afb1d"],

