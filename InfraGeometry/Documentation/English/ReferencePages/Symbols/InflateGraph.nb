Cell[CellGroupData[{
Cell["InflateGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b5514403-f877-4d08-9cb0-e8546e8d894a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflateGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflateGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27839b09-94c1-4160-8fa3-7f3131863803"],
 "\[LineSeparator]",
 "grows a fiber of ",
 StyleBox["k", "TI"],
 " new vertices over every vertex of ",
 StyleBox["g", "TI"],
 ", joins each to its vertex, and adds random edges inside each fiber and \
between the fibers over each edge of ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0bc0269d-252a-428b-b136-af0633549bec"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflateGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflateGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d1220d1-bcba-4212-a1c2-94a670dde84f"],
 "\[LineSeparator]",
 "grows one new vertex over every vertex."
}], "Usage",ExpressionUUID->"561feea5-a316-44ff-be73-3bc00e611486"],

Cell[TextData[{
 "The fiber ",
 StyleBox["F(v)", "TI"],
 " over ",
 StyleBox["v", "TI"],
 " is the set of new vertices ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflatedVertex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflatedVertex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", "1"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92feb9d8-71b5-4e47-8b46-cb84356d825c"],
 ", \[Ellipsis], ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflatedVertex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflatedVertex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3544ad0-3776-4fa1-815a-ef59c533af08"],
 ". The count ",
 StyleBox["k", "TI"],
 " is a number or a range {",
 StyleBox["kMin", "TI"],
 ", ",
 StyleBox["kMax", "TI"],
 "}, drawn for each vertex."
}], "Notes",ExpressionUUID->"ad22720f-ac12-4219-9a34-dbfc2da74b1c"],

Cell["An edge of the result is of one of four kinds:", "Notes",ExpressionUUID->"f47dd493-0bf3-4da8-aff5-628a86d0f455"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1f8e5359-1b4c-4484-9474-7552f8cc3d6c"], Cell["Kind", "TableText",
     FontWeight->Bold,ExpressionUUID->"ed7a5df3-2e20-4a45-994c-2ac2fd9ba98e"],
     Cell["Joins", "TableText",
     FontWeight->Bold,ExpressionUUID->"ede44263-cc0c-4dc4-abf7-0912541d7290"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d16a006b-4262-4796-898c-82aa156dd1ce"], Cell[
    "base", "TableText",ExpressionUUID->
     "35202245-e8fe-4d7e-8f5d-277d4b6e37d1"], Cell[TextData[{
     "the two ends of an edge of ",
     StyleBox["g", "TI"]
    }], "TableText",ExpressionUUID->"4a0cb340-fc1e-4ed4-bc65-0569afe912bd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2f882043-70e7-4fdd-a7a4-b807e327f070"], Cell[
    "spoke", "TableText",ExpressionUUID->
     "4a14ecfe-d47f-4f93-a8d4-e09780ccb921"], Cell[TextData[{
     StyleBox["v", "TI"],
     " and a vertex of ",
     StyleBox["F(v)", "TI"]
    }], "TableText",ExpressionUUID->"e1719e13-785f-4678-ac76-a61f98673b59"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "262968b3-0d79-4915-84c6-066a7899abe2"], Cell[
    "vertical", "TableText",ExpressionUUID->
     "6d8b08fa-1f93-4d4f-818a-410f5da54ffc"], Cell[
    "two vertices of one fiber", "TableText",ExpressionUUID->
     "96c95615-5ae1-41a2-baf3-35973da30192"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "34b7e2b5-b25b-4545-a33e-597bcf5786df"], Cell[
    "horizontal", "TableText",ExpressionUUID->
     "cf732da2-6869-4e85-9bfe-8307581d3c1e"], Cell[TextData[{
     "a vertex of ",
     StyleBox["F(u)", "TI"],
     " and a vertex of ",
     StyleBox["F(v)", "TI"],
     ", for an edge ",
     StyleBox["uv", "TI"],
     " of ",
     StyleBox["g", "TI"]
    }], "TableText",ExpressionUUID->"d0748aaa-2e49-4fd7-9aea-6ff2b1687e18"]}
  }]], "2ColumnTableMod",ExpressionUUID->"e6f36d84-1a5c-4186-bc32-\
1f6a647c375f"],

Cell[TextData[{
 "The result is a simple graph with ",
 StyleBox["|V| + \[CapitalSigma] k(v)", "TI"],
 " vertices and ",
 StyleBox["|E| + \[CapitalSigma] k(v) + \[CapitalSigma] m(v) + \
\[CapitalSigma] h(e)", "TI"],
 " edges, where ",
 StyleBox["m(v)", "TI"],
 " and ",
 StyleBox["h(e)", "TI"],
 " are the vertical edges in ",
 StyleBox["F(v)", "TI"],
 " and the horizontal edges over ",
 StyleBox["e", "TI"],
 "."
}], "Notes",ExpressionUUID->"6c60ed27-1def-4161-8814-9de5189d5534"],

Cell[TextData[{
 "The inflation is a perturbation that keeps the geometry of ",
 StyleBox["g", "TI"],
 ". A new vertex is at distance 1 from its base vertex, and the distance \
between two vertices of ",
 StyleBox["g", "TI"],
 " does not change."
}], "Notes",ExpressionUUID->"df910fa4-00a4-44c9-982b-e21883a032d6"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9df4dc66-5b74-4e7c-b9b3-068f8b0933e0"], Cell["Option", "TableText",
