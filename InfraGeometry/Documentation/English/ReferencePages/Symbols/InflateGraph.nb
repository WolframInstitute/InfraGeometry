Cell[TextData[{
 "The option ",
 Cell[BoxData["\"\<Inflate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf68a9d4-350b-454f-88a7-7b36dfab1e84"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "855d27a8-3a6c-4cbb-adf2-8c7544f41787"],
 " is this inflation of the substrate."
}], "ExampleText",ExpressionUUID->"5bdc0b31-24b2-4cdb-b118-7ba4d842315a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
         " ", "\"\<Default\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}], ",", 
         " ", 
         RowBox[{"\"\<Inflate\>\"", " ", "->", " ", "1"}]}], "]"}]}], ")"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"direct", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InflateGraph", "[", 
        RowBox[{
         RowBox[{"InfraSubstrate", "[", 
          
          RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
            " ", "\"\<Default\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}], ",", " ", 
         RowBox[{"\"\<ExtraVertices\>\"", " ", "->", " ", "1"}]}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", ",", " ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"EdgeList", "[", "inflated", "]"}], "]"}], " ", "===", " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"EdgeList", "[", "direct", "]"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a5b96845-18bd-4ad1-b0a4-060592653f27"],

