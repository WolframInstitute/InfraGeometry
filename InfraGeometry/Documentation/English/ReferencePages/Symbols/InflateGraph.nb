Cell[TextData[{
 "The default inflation is the prism over ",
 StyleBox["g", "TI"],
 ", the product of ",
 StyleBox["g", "TI"],
 " with an edge."
}], "ExampleText",ExpressionUUID->"00407150-1715-4541-a90f-fec78dcfd0f1"],

