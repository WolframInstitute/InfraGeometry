Cell[TextData[{
 "The distances of ",
 StyleBox["g", "TI"],
 " do not change. The ball of radius 3 about the centre of the inflated grid \
meets the grid in the ball of the grid:"
}], "ExampleText",ExpressionUUID->"3f6572a2-07a9-402f-a687-f3647d49523e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"BlockRandom", "[", 
      RowBox[{
       RowBox[{"InflateGraph", "[", 
        RowBox[{"g", ",", " ", "2", ",", " ", 
         RowBox[{"\"\<VerticalEdges\>\"", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\"\<HorizontalEdges\>\"", " ", "->", " ", "2"}]}], "]"}], ",",
        " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"inflated", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{"c", ",", " ", "3"}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"inflated", ",", " ", 
     RowBox[{"{", 
      RowBox[{"ball", ",", " ", "c"}], "}"}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Intersection", "[", 
         RowBox[{"ball", ",", " ", 
          RowBox[{"VertexList", "[", "g", "]"}]}], "]"}], " ", "===", " ", 
        RowBox[{"Sort", " ", "@", " ", 
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraBall", "[", 
             RowBox[{"c", ",", " ", "3"}], "]"}], ",", 
            " ", "\"\<VertexDensity\>\""}], "]"}]}]}]}], ")"}]}], ",", "\n", 
     "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"20a50348-acfb-4c7e-ab80-f7c02936ba3e"],

