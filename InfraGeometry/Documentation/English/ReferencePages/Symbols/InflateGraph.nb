Cell["HorizontalEdges", "ExampleSubsection",ExpressionUUID->"02159b31-57ae-430c-b4ce-54dd5dc4a101"],

Cell["\<\
Two new vertices over every vertex, with none, one and all four of the edges \
between the fibers over each edge.\
\>", "ExampleText",ExpressionUUID->"7330c41a-f33d-4928-be6a-f5b5066337c4"],

