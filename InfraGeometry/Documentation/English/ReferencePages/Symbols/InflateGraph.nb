Cell["Radius", "ExampleSubsection",ExpressionUUID->"92ae355f-1849-476e-a2c5-ada430ca28dd"],

Cell["\<\
A larger radius joins the fibers to vertices farther away: radius 1 and 3.\
\>", "ExampleText",ExpressionUUID->"c415fc20-e91a-40c7-9889-abee9ac052c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "6"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InflateGraph", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"\"\<ExtraVertices\>\"", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\"\<Radius\>\"", " ", "->", " ", "radius"}]}], "]"}]}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"radius", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
