Notebook[{

Cell[CellGroupData[{
Cell["InflateGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3a96cad5-6497-4ce8-9de3-ef62a3607ab8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflateGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflateGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8077687-008f-48dd-84b5-0aee01d87d14"],
 "\[LineSeparator]",
 "grows a fiber of ",
 StyleBox["k", "TI"],
 " new vertices over every vertex of ",
 StyleBox["g", "TI"],
 ", joins each new vertex to its vertex, and adds random edges inside each \
fiber and between the fibers over each edge of ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f4b9a569-ba03-411a-9d1a-9c69f9adfe67"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflateGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflateGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f574b590-a821-44d9-83bd-880ce3ce2157"],
 "\[LineSeparator]",
 "grows one new vertex over every vertex."
}], "Usage",ExpressionUUID->"7ae77c85-3c1a-4887-a414-2979629dccfd"],

Cell[TextData[{
 "Construction: over every vertex ",
 StyleBox["v", "TI"],
 " of ",
 StyleBox["g", "TI"],
 ", a fiber of new vertices ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflatedVertex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflatedVertex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", "1"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ffcda89-95bd-4122-a49f-775c016eec46"],
 ", \[Ellipsis], ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflatedVertex"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflatedVertex", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5e076bc-8be7-4d56-979a-51e9e4b5bd9e"],
 ", each joined to ",
 StyleBox["v", "TI"],
 ". ",
 StyleBox["k", "TI"],
 " is a number or a range {",
 StyleBox["min", "TI"],
 ", ",
 StyleBox["max", "TI"],
 "}, drawn for each vertex."
}], "Notes",ExpressionUUID->"f9354bcd-edf2-4fa2-a8c6-4ff8bedac30d"],

Cell["An edge of the result is of one of four kinds:", "Notes",ExpressionUUID->"f56333f9-8f59-4614-942f-d11fcb850ccd"],

Cell[TextData[{
 "an edge of ",
 StyleBox["g", "TI"]
}], "Notes",ExpressionUUID->"fda8c6f0-2543-43b4-8b11-34c8e28a161b"],

Cell["a spoke, from a vertex to a vertex of its fiber", "Notes",ExpressionUUID->"d5c93520-8479-466e-aabd-52f5b964d6fa"],

Cell["a vertical edge, between two vertices of one fiber", "Notes",ExpressionUUID->"34c6d08d-e0ec-4f06-9dbb-894a60424dc7"],

Cell[TextData[{
 "a horizontal edge, between the fibers over the two ends of an edge of ",
 StyleBox["g", "TI"]
}], "Notes",ExpressionUUID->"745a50bb-6b7b-492e-bd1f-aee2359ccf0c"],

Cell[TextData[{
 Cell[BoxData["\"\<VerticalEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3da98386-6698-4fca-be94-9407ab870cb4"],
 " random pairs of each fiber are joined, and ",
 Cell[BoxData["\"\<HorizontalEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f33c74a-26c7-4be9-96b0-580b393b4273"],
 " random pairs of the two fibers over each edge. Each is a number or a range \
{",
 StyleBox["min", "TI"],
 ", ",
 StyleBox["max", "TI"],
 "}, drawn for each fiber and for each edge. A number larger than the pairs \
available joins them all."
}], "Notes",ExpressionUUID->"04922f87-8e21-470e-b6ff-de8f3d53ca18"],

Cell[TextData[{
 "The result is a simple graph. With ",
 StyleBox["k", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") new vertices over ",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["m", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") vertical edges in its fiber and ",
 StyleBox["h", "TI"],
 "(",
 StyleBox["e", "TI"],
 ") horizontal edges over the edge ",
 StyleBox["e", "TI"],
 ", it has |",
 StyleBox["V", "TI"],
 "| + \[CapitalSigma] ",
 StyleBox["k", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") vertices and |",
 StyleBox["E", "TI"],
 "| + \[CapitalSigma] ",
 StyleBox["k", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") + \[CapitalSigma] ",
 StyleBox["m", "TI"],
 "(",
 StyleBox["v", "TI"],
 ") + \[CapitalSigma] ",
 StyleBox["h", "TI"],
 "(",
 StyleBox["e", "TI"],
 ") edges."
}], "Notes",ExpressionUUID->"abbb1063-c562-42a4-a96b-7322d1ca2cc6"],

Cell[TextData[{
 "The base graph is untouched: the subgraph induced on the vertices of ",
 StyleBox["g", "TI"],
 " is ",
 StyleBox["g", "TI"],
 ", and a new vertex is joined to no vertex of ",
 StyleBox["g", "TI"],
 " but its own."
}], "Notes",ExpressionUUID->"bc5d38a8-1f9f-45ba-b751-847bb1a5b713"],

Cell[TextData[{
 "The fiber over ",
 StyleBox["v", "TI"],
 " lies on a circle about ",
 StyleBox["v", "TI"],
 " whose radius is a third of the shortest edge of ",
 StyleBox["g", "TI"],
 ", in the dimension of the embedding of ",
 StyleBox["g", "TI"],
 "."
}], "Notes",ExpressionUUID->"ea87f6bd-5d23-4e70-95ec-67ee4d785e3b"],

Cell[TextData[{
 "The construction draws at random, so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeedRandom"]], "paclet:ref/SeedRandom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b70119f1-b257-4d17-914a-e7032f1a3077"],
 " fixes the result. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0a417b8d-2f82-4dfd-8cbe-6e3d00658374"],
 " inflates any substrate through its option ",
 Cell[BoxData["\"\<Inflate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea97fe2b-16cb-46b8-972c-934fd2ea13a3"],
 "."
}], "Notes",ExpressionUUID->"1494a026-9eba-4854-baf2-5168de425b4b"],

