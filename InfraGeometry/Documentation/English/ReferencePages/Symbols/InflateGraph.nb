Cell[TextData[{
 "With two vertices over every vertex they differ: at its defaults the \
fibration joins vertex ",
 StyleBox["i", "TI"],
 " over one end of an edge to vertex ",
 StyleBox["i", "TI"],
 " over the other, while the inflation draws its horizontal edges at random."
}], "ExampleText",ExpressionUUID->"d67cd86b-9c38-4a5a-ab38-0c245c681cfa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "8", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fibers", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"VertexDelete", "[", 
        RowBox[{
         RowBox[{"InflateGraph", "[", 
          RowBox[{"g", ",", " ", "2", ",", " ", 
           RowBox[{"\"\<HorizontalEdges\>\"", " ", "->", " ", "2"}]}], "]"}], 
         ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InfraTotalGraph", "[", 
        RowBox[{"RandomInfraFibration", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"\"\<VerticalVertices\>\"", " ", "->", " ", "2"}]}], "]"}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{"fibers", ",", " ", "total"}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"e704a7da-5b2b-48f3-adc1-007db786b9a5"],

