Cell[TextData[{
 "The option ",
 Cell[BoxData["\"\<Inflate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84357e0c-cf47-4f5a-acd7-d9edee591fde"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0e7c8fb6-6b6b-4bd5-90e1-60f6d7302c45"],
 " is this inflation of the substrate: ",
 Cell[BoxData["\"\<Inflate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5472eb51-43e3-496b-87cd-652323cd8883"],
 " -> ",
 StyleBox["k", "TI"],
 " is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InflateGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InflateGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ad95ca4-e13b-411e-9575-72c6d42d7817"],
 ", and ",
 Cell[BoxData["\"\<Inflate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1720dcc-0b12-43e9-b08b-5cb947e87e9e"],
 " -> {",
 StyleBox["k", "TI"],
 ", ",
 StyleBox["opts", "TI"],
 "} passes the options."
}], "ExampleText",ExpressionUUID->"e4701cbf-7d34-4dd6-aec9-d941fed65d33"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"inflated", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
         " ", "\"\<Default\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}], ",", 
         " ", 
         RowBox[{"\"\<Inflate\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", 
            RowBox[{"\"\<VerticalEdges\>\"", " ", "->", " ", "1"}]}], 
           "}"}]}]}], "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"direct", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"InflateGraph", "[", 
        RowBox[{
         RowBox[{"InfraSubstrate", "[", 
          
          RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
            " ", "\"\<Default\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}], ",", " ", "2", ",", " ", 
         RowBox[{"\"\<VerticalEdges\>\"", " ", "->", " ", "1"}]}], "]"}]}], 
      ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inflated", ",", " ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"EdgeList", "[", "inflated", "]"}], "]"}], " ", "===", " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"EdgeList", "[", "direct", "]"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"2a2b8485-6e6e-4b22-92e5-1e82040c81ad"],

