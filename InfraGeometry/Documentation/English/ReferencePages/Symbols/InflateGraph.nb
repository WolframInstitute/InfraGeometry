    "1", "TableText",ExpressionUUID->"d07156c6-85a7-48ef-befa-4c62990ddc3d"], 
    Cell["\<\
the random pairs of the two fibers over each edge joined, drawn for each edge\
\
\>", "TableText",ExpressionUUID->"a5e0e877-e4e3-4310-8d5b-39531ffaa9f6"]}
  }]], "3ColumnTableMod",ExpressionUUID->"45c3fd75-61a6-4389-bd4d-\
1df36041f246"],

Cell[TextData[{
 "A number larger than the pairs available joins them all. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
