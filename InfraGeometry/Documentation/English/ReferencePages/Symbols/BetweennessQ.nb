     " iff its ruler coordinate lies between theirs."
    }], "TableText",ExpressionUUID->"d56a7f2e-801f-477a-bddf-e6846d41cf1e"]}
  }]], "3ColumnTableMod",ExpressionUUID->"efd8cf7f-78e6-4443-8516-\
127287f37114"]
}, Open  ]],

