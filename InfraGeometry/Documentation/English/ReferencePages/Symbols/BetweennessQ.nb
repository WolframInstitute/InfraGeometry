   {Cell["      ", "ModInfo",ExpressionUUID->
     "3d6ad909-7f39-4665-b4cd-4d5606444fdf"], Cell[
    "Birkhoff", "TableText",ExpressionUUID->
     "a99e4be0-578c-4698-93b0-c9b683d26327"], Cell[
