 "."
}], "ExampleText",ExpressionUUID->"a5db887c-ea46-4a86-ab23-5a6c77f1466b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"BetweennessQ", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "#", ",", " ", "b"}], "]"}], 
       " ", "&"}]}], "]"}], " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"MetricInterval", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e070aaae-b457-4809-90ca-1bddd4785fa5"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c0e1799b-0c56-451f-8290-582eb161a703"]
