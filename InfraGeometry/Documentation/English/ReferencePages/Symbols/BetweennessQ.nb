Cell[TextData[{
 "The vertices between two points are exactly ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MetricInterval"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/MetricInterval", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b50255af-e71c-4321-81e6-e5ba7ca0bc47"],
 "."
}], "ExampleText",ExpressionUUID->"ed533b7c-c742-4012-8d29-5e4aae35a1df"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"BetweennessQ", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "#", ",", " ", "b"}], "]"}], 
       " ", "&"}]}], "]"}], " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"MetricInterval", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"eb778720-c64b-4cb9-b56f-b33b65e5776e"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"aeaa4a73-4d96-483f-9290-cb22cfd87c14"]
}, Open  ]]
}, Open  ]],

