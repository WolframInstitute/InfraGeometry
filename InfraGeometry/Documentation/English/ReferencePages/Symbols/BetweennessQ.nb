      FontSize->0.9 Inherited,ExpressionUUID->
      "9df69d81-f196-4849-9469-1072fa2f2087"],
     " is between ",
     Cell[BoxData[
      FormBox[
       StyleBox["u", "TI"], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "56f5ee43-e2c9-4956-aad6-110837016460"],
     " and ",
     Cell[BoxData[
      FormBox[
       StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",
