Cell[CellGroupData[{
Cell["BetweennessQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b1610f98-3d41-41a1-99d9-b61a0afd5079"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BetweennessQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BetweennessQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97aa3954-0025-4db8-a0d1-00288e3e9538"],
 "\[LineSeparator]",
 "tests Tarski's betweenness ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["B", "TI"], "(", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     StyleBox["w", "TI"], ",", 
     StyleBox["v", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75648b16-101a-4d0e-8143-03547f8e7f5d"],
 ": whether ",
 StyleBox["w", "TI"],
 " lies on a geodesic from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"c3590ee3-a246-4d57-98b8-a155d34d3e32"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["B", "TI"], "(", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     StyleBox["w", "TI"], ",", 
     StyleBox["v", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8abb6f2b-b40c-4d2b-87c2-1b2b5dd43220"],
 " holds exactly when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      StyleBox["w", "TI"]}], ")"}], "+", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["w", "TI"], ",", 
      StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      StyleBox["v", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8552ef77-b91a-4f2e-9533-353d6fb31b80"],
 "."
}], "Notes",ExpressionUUID->"bfcf1b75-42ea-4ffe-b2f6-085c4664ce4a"],

Cell[TextData[{
 "Betweenness is one of the two primitives of Tarski's axiomatization \
\[LongDash] the other is equidistance, tested by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["EquidistanceQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/EquidistanceQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8a62386f-7507-46c7-9123-397f35923f03"],
 " \[LongDash] so this predicate is where the classical axiom system meets \
the graph. ",
 Cell[BoxData["TarskiAxiomQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0092b551-5ad7-4ad9-881f-6c6372ce5035"],
 " and the eleven individual axiom predicates are all built from these two."
}], "Notes",ExpressionUUID->"a1c89585-18ff-47f5-a8c2-a3b8a1108c00"],

Cell[TextData[{
 "Note the argument order: the ",
 StyleBox["middle",
  FontWeight->"Bold"],
 " point is second, matching Tarski's ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["B", "TI"], "(", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     StyleBox["w", "TI"], ",", 
     StyleBox["v", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "914e76ae-e394-47a0-8555-9b818be07b8f"],
 ", not last."
}], "Notes",ExpressionUUID->"dc5e0c51-cbd5-4a27-ad6d-c15b6c58031f"],

Cell[TextData[{
 "Unlike the plane, a graph has no order-completeness. Betweenness holds for \
a whole ",
 StyleBox["set", "TI"],
 " of middle vertices, which is exactly the metric interval, and that set can \
be large: on a square grid the vertices between two points fill a whole \
diamond, not a line."
}], "Notes",ExpressionUUID->"8c5f9cfd-9d6c-42e6-9296-db332d83e27f"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"0ef9c8c8-24e4-45d5-8915-dcfecee19036"],

