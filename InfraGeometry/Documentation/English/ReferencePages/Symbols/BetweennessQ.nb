      FontSize->0.9 Inherited,ExpressionUUID->
      "0c433446-1bb1-4b04-8f9a-37b7a7d467e2"],
     " is between ",
     Cell[BoxData[
      FormBox[
       StyleBox["u", "TI"], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8429051d-e4ef-4666-934f-cfb886b80e57"],
     " and ",
     Cell[BoxData[
      FormBox[
       StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "de9b42ed-68fd-497e-9040-f240353f8d56"],
     " iff its ruler coordinate lies between theirs."
    }], "TableText",ExpressionUUID->"41fcf036-457b-481e-9590-f8f50617698f"]}
  }]], "3ColumnTableMod",ExpressionUUID->"3f34c68f-dc32-4d61-841e-\
50aeb76e9dd7"]
}, Open  ]],

