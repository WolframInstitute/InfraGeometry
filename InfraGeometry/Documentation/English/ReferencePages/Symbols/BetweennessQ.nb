Cell[CellGroupData[{
Cell["BetweennessQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a05ace82-2f2a-4f94-8f58-d41fe5da1b24"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BetweennessQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BetweennessQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8bfff0d8-3fec-4f21-9e12-0fc1516fdec7"],
 "\[LineSeparator]",
 "tests Tarski's betweenness ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["B", "TI"], "(", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     StyleBox["w", "TI"], ",", 
     StyleBox["v", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cefbfdc0-9834-4f65-8cdd-d681b9ae89df"],
 ": whether ",
 StyleBox["w", "TI"],
 " lies on a geodesic from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"3ca8a8d7-296a-4f58-b638-0b42aad25949"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["B", "TI"], "(", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     StyleBox["w", "TI"], ",", 
     StyleBox["v", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "143f3bf5-02be-4d73-b8fa-020d17106ec0"],
 " holds exactly when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      StyleBox["w", "TI"]}], ")"}], "+", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["w", "TI"], ",", 
      StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      StyleBox["v", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8f0f251-0d29-4134-9e7a-2e70ba5055f5"],
 "."
}], "Notes",ExpressionUUID->"5666a86c-8057-4d61-888e-8aeb89be88c2"],

Cell[TextData[{
 "Betweenness is one of the two primitives of Tarski's axiomatization \
\[LongDash] the other is equidistance, tested by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["EquidistanceQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/EquidistanceQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6ba011cf-d67a-40ee-892f-2f21a08051cb"],
 " \[LongDash] so this predicate is where the classical axiom system meets \
the graph. ",
 Cell[BoxData["TarskiAxiomQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cabd2887-4a8a-4b34-a768-a954d92d2811"],
 " and the eleven individual axiom predicates are all built from these two."
}], "Notes",ExpressionUUID->"a148e1e7-2156-40ff-963c-18e74271066f"],

Cell[TextData[{
 "Note the argument order: the ",
 StyleBox["middle",
  FontWeight->"Bold"],
 " point is second, matching Tarski's ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["B", "TI"], "(", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     StyleBox["w", "TI"], ",", 
     StyleBox["v", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d9e6a6d-10a1-4a6a-8e69-b08e62f80e11"],
 ", not last."
}], "Notes",ExpressionUUID->"29c9efac-d96d-4e4f-8022-f405d2302620"],

Cell[TextData[{
 "Unlike the plane, a graph has no order-completeness. Betweenness holds for \
a whole ",
 StyleBox["set", "TI"],
 " of middle vertices, which is exactly the metric interval, and that set can \
be large: on a square grid the vertices between two points fill a whole \
diamond, not a line."
}], "Notes",ExpressionUUID->"ac9deb4f-4f9f-42b1-b1a7-de98fe1e373b"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"29a0c0f1-d313-4612-920b-77d34d93df7d"],

