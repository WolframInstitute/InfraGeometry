Notebook[{

Cell[CellGroupData[{
Cell["BetweennessQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"96dd3419-556c-48ca-86d1-241be12aa8ed"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BetweennessQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/BetweennessQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d608303-0a6c-462d-8a8c-5bfc82fbe201"],
 "\[LineSeparator]",
 "tests Tarski's betweenness ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["B", "TI"], "(", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     StyleBox["w", "TI"], ",", 
     StyleBox["v", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "895a699a-86af-498d-ad67-f0246d79505e"],
 ": whether ",
 StyleBox["w", "TI"],
 " lies on a geodesic from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"e1edbe19-99a6-480e-82df-54ab966a5f1e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["B", "TI"], "(", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     StyleBox["w", "TI"], ",", 
     StyleBox["v", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b055abe4-0f18-45a4-9ccd-bcdc3644774f"],
 " holds exactly when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      StyleBox["w", "TI"]}], ")"}], "+", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["w", "TI"], ",", 
      StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["u", "TI"], ",", 
      StyleBox["v", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05e5de21-533b-4253-956d-e084c8045924"],
 "."
}], "Notes",ExpressionUUID->"09a17c1b-29c2-448f-abcf-1583741c817e"],

Cell[TextData[{
 "Betweenness is one of the two primitives of Tarski's axiomatization \
\[LongDash] the other is equidistance, tested by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["EquidistanceQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/EquidistanceQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dccfbb6c-3d44-4818-b0bb-866855387efb"],
 " \[LongDash] so this predicate is where the classical axiom system meets \
the graph. ",
 Cell[BoxData["TarskiAxiomQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e4ea3d6-44c8-458d-a4e0-c3c0633aaf41"],
 " and the eleven individual axiom predicates are all built from these two."
}], "Notes",ExpressionUUID->"fd89fe85-c48e-4586-af86-085b56c630ca"],

Cell[TextData[{
 "Note the argument order: the ",
 StyleBox["middle",
  FontWeight->"Bold"],
 " point is second, matching Tarski's ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["B", "TI"], "(", 
    RowBox[{
     StyleBox["u", "TI"], ",", 
     StyleBox["w", "TI"], ",", 
     StyleBox["v", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "138e9756-b67b-4794-8e03-b7190519b732"],
 ", not last."
}], "Notes",ExpressionUUID->"a89980ca-2f93-4780-a514-f75b99a6331f"],

Cell[TextData[{
 "Unlike the plane, a graph has no order-completeness. Betweenness holds for \
a whole ",
 StyleBox["set", "TI"],
 " of middle vertices, which is exactly the metric interval, and that set can \
be large: on a square grid the vertices between two points fill a whole \
diamond, not a line."
}], "Notes",ExpressionUUID->"ed6e5d0f-833e-45ba-9636-c0cd08867849"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"164eb2bc-b717-44f5-8e1e-c2089c6eb648"],

