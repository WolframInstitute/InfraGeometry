     "6155703b-d8db-44c1-af88-8217af2d87ea"], Cell[TextData[{
     Cell[BoxData[
      FormBox[
       StyleBox["w", "TI"], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "11e2a9fa-24db-4124-8b8a-50fedcbd47dd"],
     " is between ",
     Cell[BoxData[
      FormBox[
       StyleBox["u", "TI"], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9b7af79c-3c79-4b1d-8de5-e88412193e2f"],
     " and ",
     Cell[BoxData[
      FormBox[
       StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a5ac00db-1e4b-4b78-9bca-d46554bfa18e"],
     " iff its ruler coordinate lies between theirs."
    }], "TableText",ExpressionUUID->"ce7514d0-918a-4489-90e5-8ef7a7f816b3"]}
  }]], "3ColumnTableMod",ExpressionUUID->"ca481f80-25d7-404b-9258-\
d0202a3ab10c"]
}, Open  ]],

