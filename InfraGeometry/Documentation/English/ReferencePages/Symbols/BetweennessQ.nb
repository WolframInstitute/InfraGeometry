       StyleBox["w", "TI"], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a78bbb8f-de91-407a-ae13-f6d7932a38f7"],
     " is between ",
     Cell[BoxData[
      FormBox[
       StyleBox["u", "TI"], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "27316c02-a17d-413b-a60b-c9d2d4f31853"],
     " and ",
     Cell[BoxData[
      FormBox[
       StyleBox["v", "TI"], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "05e81e8f-2bcb-4404-aaaa-f435ea670a76"],
     " iff its ruler coordinate lies between theirs."
    }], "TableText",ExpressionUUID->"a335de76-9cec-470b-b5db-3c2537354aee"]}
  }]], "3ColumnTableMod",ExpressionUUID->"788a7134-f332-4078-9e62-\
719f7d5c5368"]
}, Open  ]],

