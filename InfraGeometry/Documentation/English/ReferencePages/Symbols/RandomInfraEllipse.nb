Cell[CellGroupData[{
Cell["RandomInfraEllipse", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"75436675-ac45-4838-a168-cce4200ba355"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraEllipse"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraEllipse", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}], ",", " ", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b64c1e4-0b51-4939-8a06-26204a47a016"],
 "\[LineSeparator]",
 "draws one directed cycle graph for a shortest separating cycle in the \
level-surface subgraph { v : cMin <= d(p1,v) + d(p2,v) <= cMax } (c scalar or \
{cMin, cMax}).",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"01c3f899-d75d-451c-b18e-25c17471c96b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraEllipse"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraEllipse", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c230c6a5-c235-4a51-8450-5af0301afb5d"],
 "\[LineSeparator]",
 "returns exactly n realisations or {}; UpTo[n] returns up to n; All returns \
all."
}], "Usage",ExpressionUUID->"2f1ea384-8e2f-4c0d-ac3f-5e7bf1ace850"],

Cell[TextData[{
 "The default draw is random. Seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26caed87-d15a-4e30-922a-b919ef2469f1"],
 " to reproduce it. Give ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d59a4041-d078-468c-b784-366644cc14c5"],
 " for deterministic descent. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08202e36-4e1e-4b18-88d4-6d53a984bf0f"],
 " with ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09eff040-f681-4b48-9b14-9a81eca397f1"],
 " keeps the full enumeration without drawing."
}], "Notes",ExpressionUUID->"a2c597bf-d414-4d87-90d5-465d0dc5946d"],

