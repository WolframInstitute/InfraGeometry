Cell[CellGroupData[{
Cell["RandomInfraEllipse", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2cecd323-d1f8-499b-b4b8-f8df43e5919a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraEllipse"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraEllipse", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}], ",", " ", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8084a54-27f6-4588-af3c-80bdb11e5fd1"],
 "\[LineSeparator]",
 "draws one directed cycle graph for a shortest separating cycle in the \
level-surface subgraph { v : cMin <= d(p1,v) + d(p2,v) <= cMax } (c scalar or \
{cMin, cMax}).",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1cb5c364-15a8-4c61-b23f-767598a3c7a8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraEllipse"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraEllipse", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dacd01a-dbbd-43e4-b7e5-0437cd8cd690"],
 "\[LineSeparator]",
 "returns exactly n realisations or {}; UpTo[n] returns up to n; All returns \
all."
}], "Usage",ExpressionUUID->"ce510fa0-b13e-4e95-9156-7db42c4ee0d2"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomInfraEllipse", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "q"}], "}"}], ",", " ", "c", ",", " ", "count"}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57030320-daec-4bd1-8eb0-ca4a22ff2a01"],
 " uses the direct form."
}], "Notes",ExpressionUUID->"85dcdcf2-f8b8-47a1-9c6d-013f7bf7fdb0"],

Cell[TextData[{
 "The default draw is random. Give ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "573557d1-a40c-433b-ac8a-367e8a3635cc"],
 " for deterministic descent. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77b36771-cc35-419e-b74a-c88ac9864f4b"],
 " with ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5de94718-cf87-45e3-b8a8-c3c329d82b6f"],
 " keeps the full enumeration without drawing. ",
 Cell[BoxData[
  RowBox[{"RandomSeeding", " ", "->", " ", "Automatic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e181a07-3f54-4ab7-bf28-59cb070cc4af"],
 " (default) seeds each call afresh, independently of ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3edddfac-69b1-4c45-94d0-30696b206abc"],
 "; an integer or string gives a reproducible draw, and ",
 Cell[BoxData["Inherited"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "593945a1-e7d7-4490-a1fd-f813496656dd"],
 " a local snapshot of the current state. The outer random state is restored \
afterward, as with ",
 ButtonBox["RandomInstance",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/RandomInstance.html"], 
    None}],
 "."
}], "Notes",ExpressionUUID->"ae826712-ebcd-44ea-acb3-9f3b657c101d"],

