Cell[CellGroupData[{
Cell["RandomInfraEllipse", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell["LLM generated.", "Notes",ExpressionUUID->"2dad15d7-e162-4f8f-95b0-65143436123f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8b07b3ee-05ab-45c7-be2f-92baa44d6cc4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraEllipse"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraEllipse", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}], ",", " ", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "feb6341c-cb74-45c7-bc9e-ddf6e9e3f674"],
 "\[LineSeparator]",
 "draws one directed cycle graph for a shortest separating cycle in the \
level-surface subgraph { v : cMin <= d(p1,v) + d(p2,v) <= cMax } (c scalar or \
{cMin, cMax}).",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f064ebdf-adcb-4bb3-a597-3c5812e2a4bb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraEllipse"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraEllipse", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3118731f-0b57-4537-84e4-25e37bb71fef"],
 "\[LineSeparator]",
 "returns exactly n realisations or {}; UpTo[n] returns up to n; All returns \
all."
}], "Usage",ExpressionUUID->"e0df623d-8ded-4fee-a7f7-cff64831b53d"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomInfraEllipse", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "q"}], "}"}], ",", " ", "c", ",", " ", "count"}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6e4a7bd-664e-499d-a3af-55339620ac4e"],
 " uses the direct form."
}], "Notes",ExpressionUUID->"2428e114-9187-4390-adc5-2d60915925a8"],

Cell[TextData[{
 "The default draw is random. Seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c1fc0bf-7615-4eee-a21b-02d81299f693"],
 " to reproduce it. Give ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e3e4cd2-56ad-4e3a-8b74-f76bf24d0d73"],
 " for deterministic descent. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "341eb424-96de-4e78-a032-640b8e72c8dd"],
 " with ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbd488ed-9d1b-4837-882a-184d97afbbfd"],
 " keeps the full enumeration without drawing."
}], "Notes",ExpressionUUID->"d47673e7-52c2-456d-a64c-f59411234b52"],

