Notebook[{

Cell[CellGroupData[{
Cell["InfraCone", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9abbd4a0-ff7a-4e58-8434-17a6442ed990"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCone"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCone", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["slope", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d46750c1-85f4-46e3-b4f5-f907d39d935e"],
 "\[LineSeparator]",
 "is the cone along ",
 StyleBox["axis", "TI"],
 " with apex ",
 StyleBox["axis", "TI"],
 "[[1]]: the vertices within ",
 StyleBox["slope", "TI"],
 " (",
 StyleBox["i", "TI"],
 " \[Minus] 1) of the ",
 StyleBox["i", "TI"],
 "-th vertex of the axis they project to, with a flat base. It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "466208e6-9e4a-4618-a7b7-cb865da738c7"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3bac4cb4-824c-4442-a9ca-2dd2f1267dac"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"174776e6-c0e6-4971-8cb1-cc636c910fca"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCone"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCone", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["slope", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64a43957-1a07-4880-8a73-040970c841a5"],
 "\[LineSeparator]",
 "is the rounded cone, the union of the balls of radius ",
 StyleBox["slope", "TI"],
 " (",
 StyleBox["i", "TI"],
 " \[Minus] 1) about the vertices of the axis."
}], "Usage",ExpressionUUID->"07efa7c4-4e9b-4918-b2eb-a2b5010008d7"],

Cell[TextData[{
 "Definition: with the axis ",
 StyleBox["a_1, \[Ellipsis], a_n", "TI"],
 ", the cone of slope ",
 StyleBox["m", "TI"],
 " is the sliced tube ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    RowBox[{
     StyleBox["i", "TI"], " ", "|->", " ", 
     RowBox[{
      StyleBox["m", "TI"], " ", 
      RowBox[{"(", 
       RowBox[{
        StyleBox["i", "TI"], " ", "\[Minus]", " ", "1"}], ")"}]}]}], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Sliced\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "91a2bd79-551b-4cc5-82e5-ddf04b1a6804"],
 ". Slice ",
 StyleBox["i", "TI"],
 " is the set of vertices whose nearest axis vertex is ",
 StyleBox["a_i", "TI"],
 ", a tie lying in every nearest slice, and ",
 StyleBox["v", "TI"],
 " is in the cone when ",
 StyleBox["d(a_i, v) \[LessEqual] m (i \[Minus] 1)", "TI"],
 " for its slice: the radius grows linearly from the apex, and is read at the \
axis vertex the vertex projects to."
}], "Notes",ExpressionUUID->"ce0a5752-a366-41e0-9462-820849e55198"],

Cell[TextData[{
 "A radius is a whole number of steps, so the radius ",
 StyleBox["m (i \[Minus] 1)", "TI"],
 " is rounded down: a cone of slope 1/2 grows by one step every second vertex \
of the axis, and its mantle is a staircase."
}], "Notes",ExpressionUUID->"4c75cb7a-c55a-4d68-bc0c-ad24c7807412"],

Cell[TextData[{
 "The axis is prolonged straight on past both ends and the vertices nearer a \
prolongation than the axis are cut, so the base is flat: the cone keeps a \
full row at the last axis vertex. ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ced6eac3-115f-48d4-9065-d10104a69f35"],
 " drops the slicing and rounds the base. The rounded cone of the earlier \
releases is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    RowBox[{
     StyleBox["i", "TI"], " ", "|->", " ", 
     RowBox[{
      StyleBox["m", "TI"], " ", 
      RowBox[{"(", 
       RowBox[{
        StyleBox["i", "TI"], " ", "\[Minus]", " ", "1"}], ")"}]}]}]}], "]"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2265e1f4-a8bc-4b1e-9dd6-4db992aa1a63"],
 "."
}], "Notes",ExpressionUUID->"62464e2a-f724-4826-80f8-2e1579e45668"],

Cell[TextData[{
 StyleBox["axis", "TI"],
 " is a walk: a vertex list, for example one representative of a segment or a \
ray, or a path or cycle graph. Reverse it for the other apex. Slope 0 gives \
the axis."
}], "Notes",ExpressionUUID->"bacf430b-1301-4ba7-9adb-ece28db00c9c"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5f5d1f22-f3a4-4d92-99ee-b588103d6d5f"],
 " gives two measures of a cone:"
}], "Notes",ExpressionUUID->"9aba16a7-83f3-47e4-b7e6-b1157a4b3663"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "37375385-54b8-4a0f-96a9-fb1c1297fc19"], Cell["Measure", "TableText",
     FontWeight->Bold,ExpressionUUID->"abefcb99-4867-422d-a4ed-0fe3b94bd215"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"6d34f7c8-0eec-441b-b142-bcc84962aa61"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "cc18a3e1-7cae-43c2-b3b6-0d4c5a8f042e"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "cc660246-3645-4e5c-a824-ab430f0e2405"]], "TableText",ExpressionUUID->
     "efc66e51-1d57-4671-a1eb-4c355c2c0dec"], Cell[
    "the number of vertices of the cone", "TableText",ExpressionUUID->
     "5be54ab2-9edc-47cf-a82e-db02e5ccd72f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "36130123-0416-4232-b8df-65425a92e312"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "950c7f96-d264-4934-ad65-df1b32d7f379"]], "TableText",ExpressionUUID->
     "5314e2f7-e823-42b3-9112-509565e0cf3b"], Cell["\<\
the number of vertices of the cone all of whose neighbours lie in it: the \
count without the mantle and the base\
\>", "TableText",ExpressionUUID->"90193778-8eb0-4c66-ae35-2e010fcd1e24"]}
  }]], "2ColumnTableMod",ExpressionUUID->"d9804e2b-fb48-4204-aea0-\
256a2aa0f6eb"],

Cell["\<\
The apex is boundary, and so is the axis near it, where the cone is thinner \
than one step.\
\>", "Notes",ExpressionUUID->"756eba17-dcba-4669-9c49-deff70739713"],

Cell[TextData[{
 "A slope ",
 StyleBox["m \[GreaterEqual] 1", "TI"],
 " gives a ball under ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd5764c3-403e-4ca4-bd94-69d6ec5068db"],
 ". When the axis ",
 StyleBox["a_1, \[Ellipsis], a_n", "TI"],
 " is a shortest path, the rounded cone of slope ",
 StyleBox["m \[GreaterEqual] 1", "TI"],
 " is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a_n", "TI"], ",", " ", 
    RowBox[{"\[LeftFloor]", 
     RowBox[{
      StyleBox["m", "TI"], " ", 
      RowBox[{"(", 
       RowBox[{
        StyleBox["n", "TI"], " ", "\[Minus]", " ", "1"}], ")"}]}], 
     "\[RightFloor]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5598757-10d6-42d9-a190-dcc9ef6bd882"],
 ", the ball about the far end: a vertex within ",
 StyleBox["\[LeftFloor]m (i \[Minus] 1)\[RightFloor]", "TI"],
 " of ",
 StyleBox["a_i", "TI"],
 " is within ",
 StyleBox["\[LeftFloor]m (i \[Minus] 1)\[RightFloor] + n \[Minus] i \
\[LessEqual] \[LeftFloor]m (n \[Minus] 1)\[RightFloor]", "TI"],
 " of ",
 StyleBox["a_n", "TI"],
 ", by the triangle inequality along the axis. So the counts of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e4ac0f0f-608f-48aa-b7d3-a609251faa49"],
 " apply. For ",
 StyleBox["0 < m < 1", "TI"],
 " no lattice count is known, and the cone is measured."
}], "Notes",ExpressionUUID->"3907ade1-f158-45cd-b114-863aac557af9"],

Cell[TextData[{
 "In the continuum two cones are the references. In the Euclidean plane the \
union of the disks of radius ",
 StyleBox["m t", "TI"],
 " about the points at distance ",
 StyleBox["t", "TI"],
 " along a segment of length ",
 StyleBox["R", "TI"],
 ", for ",
 StyleBox["0 \[LessEqual] m < 1", "TI"],
 ", is the convex hull of the apex and the far disk of radius ",
 StyleBox["m R", "TI"],
 ", with area"
}], "Notes",ExpressionUUID->"7b111d87-501e-4970-b50f-548e5c935121"],

Cell[TextData[{
 StyleBox["m R\.b2 \[Sqrt](1 \[Minus] m\.b2) + m\.b2 R\.b2 (\[Pi] \[Minus] \
arccos m)", "TI"],
 "."
}], "Notes",ExpressionUUID->"c31609ac-c5f9-4820-aa45-4761ed6fa99c"],

Cell[TextData[{
 "In a Riemannian manifold of dimension ",
 StyleBox["n", "TI"],
 " the angular cone ",
 StyleBox["{exp_p(t u) : u \[Element] \[CapitalOmega], 0 \[LessEqual] t \
\[LessEqual] r}", "TI"],
 " over a set ",
 StyleBox["\[CapitalOmega]", "TI"],
 " of unit directions at the apex ",
 StyleBox["p", "TI"],
 ", of spherical measure ",
 StyleBox["\[Sigma](\[CapitalOmega])", "TI"],
 ", has volume"
}], "Notes",ExpressionUUID->"beeb39da-f033-44fc-b117-914e21d0ce0f"],

Cell[TextData[{
 StyleBox["\[Sigma](\[CapitalOmega]) r^n / n \[Minus] r^(n+2) / (6(n + 2)) \
\[Integral]_\[CapitalOmega] Ric(u, u) d\[Sigma] + O(r^(n+3))", "TI"],
 "."
}], "Notes",ExpressionUUID->"9985fd43-d67d-451c-aa4e-b4029e5b0412"],

Cell[TextData[{
 "Over the round cap ",
 StyleBox["\[CapitalOmega]", "TI"],
 " of half-angle ",
 StyleBox["\[Alpha]", "TI"],
 " about the axis direction ",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["\[Integral]", "TI"],
 StyleBox["\[CapitalOmega] Ric(u, u) d\[Sigma] = c", "TI", "TI"],
 StyleBox["\[UpTee] Scal + (c_\[DoubleVerticalBar] \[Minus] c_\[UpTee]) \
Ric(v, v)", "TI"],
 ", with ",
 StyleBox["c_\[DoubleVerticalBar] = |S^(n\[Minus]2)| \[Integral]_0^\[Alpha] \
cos\.b2 t sin^(n\[Minus]2) t dt", "TI"],
 " and ",
 StyleBox["c_\[UpTee] = (\[Sigma](\[CapitalOmega]) \[Minus] c_\
\[DoubleVerticalBar])/(n \[Minus] 1)", "TI"],
 ": a thin cone reads the Ricci curvature along its axis. The rounded cone of \
this head is the hull, not an angular cone; it agrees with the angular cone \
of half-angle ",
 StyleBox["arcsin m", "TI"],
 " within distance ",
 StyleBox["R (1 \[Minus] m)", "TI"],
 " of the apex."
}], "Notes",ExpressionUUID->"6aa54121-fd3e-461d-bdba-f8db779d9090"],

Cell[TextData[{
 "How the number is measured: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCone", "[", 
     RowBox[{
      StyleBox["axis", "TI"], ",", " ", 
      StyleBox["m", "TI"]}], "]"}], ",", " ", 
    StyleBox["measure", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f3ac4b3-0caa-4b45-8c4f-968fad7c8e86"],
 " takes the vertices within ",
 StyleBox["\[LeftFloor]m (i \[Minus] 1)\[RightFloor]", "TI"],
 " of the axis vertex they project to, or the union of the balls of radius ",
 StyleBox["\[LeftFloor]m (i \[Minus] 1)\[RightFloor]", "TI"],
 " about the vertices of the axis under ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50f09f94-85c1-465d-9350-ebe25c6ed641"],
 ", and counts them, or counts their ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraInterior"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraInterior", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1f8ecb30-8c73-437d-a29c-fc5c3ee3b4cf"],
 ". The profile is the list over the slope."
}], "Notes",ExpressionUUID->"8e6cbb66-9677-4c3f-bb94-48a3c61b53d9"],

Cell[TextData[{
 "The head computes nothing. A cone has one member, the vertex set. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "67245ffd-35ea-4466-b44c-0b91b81dcf5b"],
 " also reads ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "951f8df9-dde4-40e2-a2cb-182faf168fe9"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4366ecb-c6f6-4bbf-9b04-e671d53e3237"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf2369c8-1aa8-4267-a198-d86c6323e816"],
 ", ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07233932-d526-4c73-a0f4-2e3524987fd6"],
 " and ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "edfc28ed-d3b3-4348-959b-b70bc3d56d64"],
 "."
}], "Notes",ExpressionUUID->"b1211188-76be-4e87-b0ac-3afc4419f1dd"]
}, Open  ]],

