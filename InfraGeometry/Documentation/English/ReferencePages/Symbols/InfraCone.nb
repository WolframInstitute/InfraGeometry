Cell["\<\
The two measures against the slope, along a shortest path of length 6 on the \
square grid. Slope 0 is the axis, all boundary.\
\>", "ExampleText",ExpressionUUID->"f41320da-8a79-4fd8-a12b-9496f361d950"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
           RowBox[{"RandomInfraPoint", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "6"}], "]"}]}], ")"}]}], 
        "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"slopes", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", " ", "2", ",", " ", 
       RowBox[{"1", "/", "4"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"ListLinePlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraCone", "[", 
            RowBox[{"axis", ",", " ", "m"}], "]"}], ",", " ", "measure"}], 
          "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"measure", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<CountingMeasure\>\"", ",", 
           " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "slopes"}], "}"}]}], "]"}], ",", "\n", "    ", 
     
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<CountingMeasure\>\"", ",", 
        " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<slope\>\"", ",", " ", "None"}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"faf2fae5-a2d3-42e5-97c0-8a6ea2a0052f"],

