Notebook[{

Cell[CellGroupData[{
Cell["InfraCone", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7e35ccf9-34ef-4177-9268-bedf9a890ea2"],
 Cell[BoxData[
  RowBox[{"InfraCone", "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["slope", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e34d08c7-7969-43f9-8fa2-c6c24272cb6f"],
 "\[LineSeparator]",
 "is the cone along ",
 StyleBox["axis", "TI"],
 " with apex ",
 StyleBox["axis", "TI"],
 "[[1]]: the vertices within ",
 StyleBox["slope", "TI"],
 " (",
 StyleBox["i", "TI"],
 " \[Minus] 1) of the ",
 StyleBox["i", "TI"],
 "-th vertex of the axis, for some ",
 StyleBox["i", "TI"],
 ". It is inert; ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c58e4c0-acaf-4639-b055-e460ba194831"],
 " and ",
 Cell[BoxData["FindInfraRepresentative"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1622e85-9198-4e08-8ad5-18beaab698aa"],
 " evaluate it on a graph.",
 "\n"
}], "Usage",ExpressionUUID->"0b568e68-4715-442d-a89b-c22fc8fb7166"],

Cell[TextData[{
 "Definition: with the axis ",
 StyleBox["a_1, \[Ellipsis], a_n", "TI"],
 ", the cone of slope ",
 StyleBox["m", "TI"],
 " is ",
 StyleBox["{v : d(v, a_i) \[LessEqual] m (i \[Minus] 1) for some i}", "TI"],
 ", the union of the balls whose radius grows linearly from the apex."
}], "Notes",ExpressionUUID->"517c4732-8667-4923-87f1-fe72a9beca1b"],

Cell[TextData[{
 "A radius is a whole number of steps, so the radius ",
 StyleBox["m (i \[Minus] 1)", "TI"],
 " is rounded down: a cone of slope 1/2 grows by one step every second vertex \
of the axis, and its mantle is a staircase."
}], "Notes",ExpressionUUID->"875f29f6-4522-4ef6-8c6d-7b2dbccfeff7"],

Cell[TextData[{
 StyleBox["axis", "TI"],
 " is a vertex list, for example one representative of a segment or a ray. \
Reverse it for the other apex. Slope 0 gives the axis."
}], "Notes",ExpressionUUID->"500a7142-6152-4a48-82a0-14c98e78e218"],

Cell[TextData[{
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d55e8a26-b5bb-4003-81dc-399c1cb2f82f"],
 " gives two measures of a cone:"
}], "Notes",ExpressionUUID->"88c4d1bd-a838-483d-93c9-e3f66a71bf16"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4149276f-2e29-42b3-a063-650832d75985"], Cell["Measure", "TableText",
     FontWeight->Bold,ExpressionUUID->"4a5b2d99-e61b-4bd0-9a3f-86cc15d7d382"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"9cd762cb-779a-42df-9f23-78191a6ab8c2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "91569beb-888d-45ab-a857-b17fbd377888"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "bf91aec9-6374-400f-b435-359b16234069"]], "TableText",ExpressionUUID->
     "cf87ed3c-133f-4c9b-9a24-b1b76ac4bee9"], Cell[
    "the number of vertices of the cone", "TableText",ExpressionUUID->
     "a998f82f-f066-4066-a7b8-b5a56e9da1c9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "edc05a42-3793-4172-a4dd-63888ff0d5ac"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2742dbe4-21d8-4bdf-99cb-527f42eee35d"]], "TableText",ExpressionUUID->
     "4fcc7edb-cf62-4ab5-94fa-79601a1db059"], Cell["\<\
the number of vertices of the cone all of whose neighbours lie in it: the \
count without the mantle and the base\
\>", "TableText",ExpressionUUID->"3181d66d-7a4e-4eb8-a203-bad422a2cd70"]}
  }]], "2ColumnTableMod",ExpressionUUID->"9c9ccc8a-87a3-4f21-b9e3-\
6bcfe345e267"],

Cell["\<\
The apex is boundary, and so is the axis near it, where the cone is thinner \
than one step.\
\>", "Notes",ExpressionUUID->"395d10b2-0f5a-4d84-ba48-2660c77ff566"],

Cell[TextData[{
 "A slope ",
 StyleBox["m \[GreaterEqual] 1", "TI"],
 " gives a ball. When the axis ",
 StyleBox["a_1, \[Ellipsis], a_n", "TI"],
 " is a shortest path, the cone of slope ",
 StyleBox["m \[GreaterEqual] 1", "TI"],
 " is ",
 Cell[BoxData[
  RowBox[{"InfraBall", "[", 
   RowBox[{
    StyleBox["a_n", "TI"], ",", " ", 
    RowBox[{"\[LeftFloor]", 
     RowBox[{
      StyleBox["m", "TI"], " ", 
      RowBox[{"(", 
       RowBox[{
        StyleBox["n", "TI"], " ", "\[Minus]", " ", "1"}], ")"}]}], 
     "\[RightFloor]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5480e2eb-eb57-417d-8d78-9c9a74606c78"],
 ", the ball about the far end: a vertex within ",
 StyleBox["\[LeftFloor]m (i \[Minus] 1)\[RightFloor]", "TI"],
 " of ",
 StyleBox["a_i", "TI"],
 " is within ",
 StyleBox["\[LeftFloor]m (i \[Minus] 1)\[RightFloor] + n \[Minus] i \
\[LessEqual] \[LeftFloor]m (n \[Minus] 1)\[RightFloor]", "TI"],
 " of ",
 StyleBox["a_n", "TI"],
 ", by the triangle inequality along the axis. So the counts of ",
 Cell[BoxData["InfraBall"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c511d49-4bb2-4ce0-abd3-1bad00606a01"],
 " apply. For ",
 StyleBox["0 < m < 1", "TI"],
 " no lattice count is known, and the cone is measured."
}], "Notes",ExpressionUUID->"86459c22-c852-425e-b90c-1015e45ca646"],

Cell[TextData[{
 "In the continuum two cones are the references. In the Euclidean plane the \
union of the disks of radius ",
 StyleBox["m t", "TI"],
 " about the points at distance ",
 StyleBox["t", "TI"],
 " along a segment of length ",
 StyleBox["R", "TI"],
 ", for ",
 StyleBox["0 \[LessEqual] m < 1", "TI"],
 ", is the convex hull of the apex and the far disk of radius ",
 StyleBox["m R", "TI"],
 ", with area"
}], "Notes",ExpressionUUID->"8bf9712e-7294-410a-868f-f3255fabec3e"],

Cell[TextData[{
 StyleBox["m R\.b2 \[Sqrt](1 \[Minus] m\.b2) + m\.b2 R\.b2 (\[Pi] \[Minus] \
arccos m)", "TI"],
 "."
}], "Notes",ExpressionUUID->"a6a8144f-42a3-46b9-be7c-27d3862759f5"],

Cell[TextData[{
 "In a Riemannian manifold of dimension ",
 StyleBox["n", "TI"],
 " the angular cone ",
 StyleBox["{exp_p(t u) : u \[Element] \[CapitalOmega], 0 \[LessEqual] t \
\[LessEqual] r}", "TI"],
 " over a set ",
 StyleBox["\[CapitalOmega]", "TI"],
 " of unit directions at the apex ",
 StyleBox["p", "TI"],
 ", of spherical measure ",
 StyleBox["\[Sigma](\[CapitalOmega])", "TI"],
 ", has volume"
}], "Notes",ExpressionUUID->"14ee02f2-cc63-47f5-8a40-03e598c4076f"],

Cell[TextData[{
 StyleBox["\[Sigma](\[CapitalOmega]) r^n / n \[Minus] r^(n+2) / (6(n + 2)) \
\[Integral]_\[CapitalOmega] Ric(u, u) d\[Sigma] + O(r^(n+3))", "TI"],
 "."
}], "Notes",ExpressionUUID->"385388e4-2efc-4434-99ee-38dc3471e8a8"],

Cell[TextData[{
 "Over the round cap ",
 StyleBox["\[CapitalOmega]", "TI"],
 " of half-angle ",
 StyleBox["\[Alpha]", "TI"],
 " about the axis direction ",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["\[Integral]", "TI"],
 StyleBox["\[CapitalOmega] Ric(u, u) d\[Sigma] = c", "TI", "TI"],
 StyleBox["\[UpTee] Scal + (c_\[DoubleVerticalBar] \[Minus] c_\[UpTee]) \
Ric(v, v)", "TI"],
 ", with ",
 StyleBox["c_\[DoubleVerticalBar] = |S^(n\[Minus]2)| \[Integral]_0^\[Alpha] \
cos\.b2 t sin^(n\[Minus]2) t dt", "TI"],
 " and ",
 StyleBox["c_\[UpTee] = (\[Sigma](\[CapitalOmega]) \[Minus] c_\
\[DoubleVerticalBar])/(n \[Minus] 1)", "TI"],
 ": a thin cone reads the Ricci curvature along its axis. The cone of this \
head is the hull, not an angular cone; it agrees with the angular cone of \
half-angle ",
 StyleBox["arcsin m", "TI"],
 " within distance ",
 StyleBox["R (1 \[Minus] m)", "TI"],
 " of the apex."
}], "Notes",ExpressionUUID->"32cc2940-88a3-47fd-90f5-e5d6bcd53c1f"],

Cell[TextData[{
 "How the number is measured: ",
 Cell[BoxData[
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCone", "[", 
     RowBox[{
      StyleBox["axis", "TI"], ",", " ", 
      StyleBox["m", "TI"]}], "]"}], ",", " ", 
    StyleBox["measure", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6700dbf4-6e1a-45f2-98bc-67674c142210"],
 " takes the union of the balls of radius ",
 StyleBox["\[LeftFloor]m (i \[Minus] 1)\[RightFloor]", "TI"],
 " about the vertices of the axis and counts it, or counts its ",
 Cell[BoxData["InfraInterior"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4065a15c-9478-40e7-af8f-148117ae062b"],
 ". The profile is the list over the slope."
}], "Notes",ExpressionUUID->"5514e0b3-3256-42a9-bc6c-dc4b072b10e6"],

Cell[TextData[{
 "The head computes nothing. A cone has one member, the vertex set. ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ccb3a86b-5cd4-4453-9f3d-b3452b6c2b4f"],
 " also reads ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0d50fa5-5dbf-4102-8470-5517f44cd1ab"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee6dc9d4-4784-423c-b507-a88b991a74e9"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68eca79c-dd82-453a-b94b-e15533170e59"],
 ", ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ad21f5d-204b-4aa4-bc38-beff02b0fc32"],
 " and ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c38831cb-826a-496a-90c5-c21aea4e0c64"],
 "."
}], "Notes",ExpressionUUID->"e71ad8f7-d60c-45d7-8dba-04920aebd695"]
}, Open  ]],

