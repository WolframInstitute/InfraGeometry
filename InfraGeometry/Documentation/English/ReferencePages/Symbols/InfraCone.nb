Notebook[{

Cell[CellGroupData[{
Cell["InfraCone", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d4cc0117-a3b8-4988-818b-4219f8b760ba"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCone"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCone", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["slope", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1ff73e4-9a67-4781-b7b3-9d6570898279"],
 "\[LineSeparator]",
 "is the cone along ",
 StyleBox["axis", "TI"],
 " with apex ",
 StyleBox["axis", "TI"],
 "[[1]]: the vertices within ",
 StyleBox["slope", "TI"],
 " (",
 StyleBox["i", "TI"],
 " \[Minus] 1) of the ",
 StyleBox["i", "TI"],
 "-th vertex of the axis they project to, with a flat base. It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "094e1945-d478-43fa-bb1e-b3a989391bad"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d8d1e84c-63df-43ca-9b0f-d5a967bae33a"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6bae3812-66f6-4af4-9ea1-2e0bbfe8e68b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCone"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCone", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["slope", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ed165f8-acc4-4b5b-bafd-ccaee8898948"],
 "\[LineSeparator]",
 "is the rounded cone, the union of the balls of radius ",
 StyleBox["slope", "TI"],
 " (",
 StyleBox["i", "TI"],
 " \[Minus] 1) about the vertices of the axis."
}], "Usage",ExpressionUUID->"fb60e2c0-e17f-4072-96fe-88da5a0a8b6d"],

Cell[TextData[{
 "Definition: with the axis ",
 StyleBox["a_1, \[Ellipsis], a_n", "TI"],
 ", the cone of slope ",
 StyleBox["m", "TI"],
 " is the sliced tube ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    RowBox[{
     StyleBox["i", "TI"], " ", "|->", " ", 
     RowBox[{
      StyleBox["m", "TI"], " ", 
      RowBox[{"(", 
       RowBox[{
        StyleBox["i", "TI"], " ", "\[Minus]", " ", "1"}], ")"}]}]}], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Sliced\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffc99068-e3bc-4e14-8e19-b40ccbdad830"],
 ". Slice ",
 StyleBox["i", "TI"],
 " is the set of vertices whose nearest axis vertex is ",
 StyleBox["a_i", "TI"],
 ", a tie lying in every nearest slice, and ",
 StyleBox["v", "TI"],
 " is in the cone when ",
 StyleBox["d(a_i, v) \[LessEqual] m (i \[Minus] 1)", "TI"],
 " for its slice: the radius grows linearly from the apex, and is read at the \
axis vertex the vertex projects to."
}], "Notes",ExpressionUUID->"40737531-ef34-4e2a-8207-3786f017661a"],

Cell[TextData[{
 "A radius is a whole number of steps, so the radius ",
 StyleBox["m (i \[Minus] 1)", "TI"],
 " is rounded down: a cone of slope 1/2 grows by one step every second vertex \
of the axis, and its mantle is a staircase."
}], "Notes",ExpressionUUID->"d6ce36e4-3c54-4887-acdf-4ba73363a17c"],

Cell[TextData[{
 "The axis is prolonged straight on past both ends and the vertices nearer a \
prolongation than the axis are cut, so the base is flat: the cone keeps a \
full row at the last axis vertex. ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09f983e4-839f-442a-9b5d-5143c1afaa45"],
 " drops the slicing and rounds the base. The rounded cone of the earlier \
releases is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    RowBox[{
     StyleBox["i", "TI"], " ", "|->", " ", 
     RowBox[{
      StyleBox["m", "TI"], " ", 
      RowBox[{"(", 
       RowBox[{
        StyleBox["i", "TI"], " ", "\[Minus]", " ", "1"}], ")"}]}]}]}], "]"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7da9a243-b107-49b3-9bdf-448526c2447b"],
 "."
}], "Notes",ExpressionUUID->"41083c21-c910-4c02-99ca-d2094d0518a6"],

Cell[TextData[{
 StyleBox["axis", "TI"],
 " is a walk: a vertex list, for example one representative of a segment or a \
ray, or a path or cycle graph. Reverse it for the other apex. Slope 0 gives \
the axis."
}], "Notes",ExpressionUUID->"93908d6b-1ffa-4095-b637-286e00825e4a"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ae043e9e-f904-4356-9c3c-a45d288d8c44"],
 " gives two measures of a cone:"
}], "Notes",ExpressionUUID->"bd17b1d0-411a-41ea-8618-826e7864db3f"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "58cfcbc7-5858-41c1-821a-1b63de3ebeb3"], Cell["Measure", "TableText",
     FontWeight->Bold,ExpressionUUID->"7724ba1c-2760-4587-a6c5-5330beb72140"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"6ea3a780-2fa5-422d-abf6-2fbe4f42a8bd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "866e300b-7d47-4aaf-8eb9-84846d89bfd0"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3731ed61-2d97-47cd-aa33-2006a73bcde6"]], "TableText",ExpressionUUID->
     "2548c7c6-28e4-4144-becc-ac4dc7bb9e1c"], Cell[
    "the number of vertices of the cone", "TableText",ExpressionUUID->
     "7e949619-6c29-4a0c-a1b8-96c0b5803390"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a406a1bc-70b6-4828-b739-19d43c63fab7"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "dd691618-a5d8-4b48-aae2-f4403318c181"]], "TableText",ExpressionUUID->
     "a49fcc25-0a5b-49ae-831f-e34af2fe2e8c"], Cell["\<\
the number of vertices of the cone all of whose neighbours lie in it: the \
count without the mantle and the base\
\>", "TableText",ExpressionUUID->"a40c2974-c3fb-4678-beb4-398b0e0dd81c"]}
  }]], "2ColumnTableMod",ExpressionUUID->"0ff107be-f606-46a8-a60c-\
199c86f33d03"],

Cell["\<\
The apex is boundary, and so is the axis near it, where the cone is thinner \
than one step.\
\>", "Notes",ExpressionUUID->"bba5cab9-20b3-45b0-b1ac-5d20bf1668fb"],

Cell[TextData[{
 "A slope ",
 StyleBox["m \[GreaterEqual] 1", "TI"],
 " gives a ball under ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "560245fe-8b06-4b54-b229-417d082e3d57"],
 ". When the axis ",
 StyleBox["a_1, \[Ellipsis], a_n", "TI"],
 " is a shortest path, the rounded cone of slope ",
 StyleBox["m \[GreaterEqual] 1", "TI"],
 " is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a_n", "TI"], ",", " ", 
    RowBox[{"\[LeftFloor]", 
     RowBox[{
      StyleBox["m", "TI"], " ", 
      RowBox[{"(", 
       RowBox[{
        StyleBox["n", "TI"], " ", "\[Minus]", " ", "1"}], ")"}]}], 
     "\[RightFloor]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85f309e5-c2cd-4dcf-94d0-a433f6aef99e"],
 ", the ball about the far end: a vertex within ",
 StyleBox["\[LeftFloor]m (i \[Minus] 1)\[RightFloor]", "TI"],
 " of ",
 StyleBox["a_i", "TI"],
 " is within ",
 StyleBox["\[LeftFloor]m (i \[Minus] 1)\[RightFloor] + n \[Minus] i \
\[LessEqual] \[LeftFloor]m (n \[Minus] 1)\[RightFloor]", "TI"],
 " of ",
 StyleBox["a_n", "TI"],
 ", by the triangle inequality along the axis. So the counts of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "898f44bd-7a66-4f08-8588-55896d52befb"],
 " apply. For ",
 StyleBox["0 < m < 1", "TI"],
 " no lattice count is known, and the cone is measured."
}], "Notes",ExpressionUUID->"ccfad41d-fd5d-407a-bfa8-63fb25c099fa"],

Cell[TextData[{
 "In the continuum two cones are the references. In the Euclidean plane the \
union of the disks of radius ",
 StyleBox["m t", "TI"],
 " about the points at distance ",
 StyleBox["t", "TI"],
 " along a segment of length ",
 StyleBox["R", "TI"],
 ", for ",
 StyleBox["0 \[LessEqual] m < 1", "TI"],
 ", is the convex hull of the apex and the far disk of radius ",
 StyleBox["m R", "TI"],
 ", with area"
}], "Notes",ExpressionUUID->"d0826610-d9ea-494a-acfd-da2faa7c6c54"],

Cell[TextData[{
 StyleBox["m R\.b2 \[Sqrt](1 \[Minus] m\.b2) + m\.b2 R\.b2 (\[Pi] \[Minus] \
arccos m)", "TI"],
 "."
}], "Notes",ExpressionUUID->"b9f9795a-69ca-4a35-b7bf-555c5152bd63"],

Cell[TextData[{
 "In a Riemannian manifold of dimension ",
 StyleBox["n", "TI"],
 " the angular cone ",
 StyleBox["{exp_p(t u) : u \[Element] \[CapitalOmega], 0 \[LessEqual] t \
\[LessEqual] r}", "TI"],
 " over a set ",
 StyleBox["\[CapitalOmega]", "TI"],
 " of unit directions at the apex ",
 StyleBox["p", "TI"],
 ", of spherical measure ",
 StyleBox["\[Sigma](\[CapitalOmega])", "TI"],
 ", has volume"
}], "Notes",ExpressionUUID->"29c545fe-ba5d-418c-b023-d1d147fe1504"],

Cell[TextData[{
 StyleBox["\[Sigma](\[CapitalOmega]) r^n / n \[Minus] r^(n+2) / (6(n + 2)) \
\[Integral]_\[CapitalOmega] Ric(u, u) d\[Sigma] + O(r^(n+3))", "TI"],
 "."
}], "Notes",ExpressionUUID->"6a462d18-2d7d-4756-8ae9-4d423e638e22"],

Cell[TextData[{
 "Over the round cap ",
 StyleBox["\[CapitalOmega]", "TI"],
 " of half-angle ",
 StyleBox["\[Alpha]", "TI"],
 " about the axis direction ",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["\[Integral]", "TI"],
 StyleBox["\[CapitalOmega] Ric(u, u) d\[Sigma] = c", "TI", "TI"],
 StyleBox["\[UpTee] Scal + (c_\[DoubleVerticalBar] \[Minus] c_\[UpTee]) \
Ric(v, v)", "TI"],
 ", with ",
 StyleBox["c_\[DoubleVerticalBar] = |S^(n\[Minus]2)| \[Integral]_0^\[Alpha] \
cos\.b2 t sin^(n\[Minus]2) t dt", "TI"],
 " and ",
 StyleBox["c_\[UpTee] = (\[Sigma](\[CapitalOmega]) \[Minus] c_\
\[DoubleVerticalBar])/(n \[Minus] 1)", "TI"],
 ": a thin cone reads the Ricci curvature along its axis. The rounded cone of \
this head is the hull, not an angular cone; it agrees with the angular cone \
of half-angle ",
 StyleBox["arcsin m", "TI"],
 " within distance ",
 StyleBox["R (1 \[Minus] m)", "TI"],
 " of the apex."
}], "Notes",ExpressionUUID->"bb50208d-9409-41d2-82e5-416ef1f7e5f8"],

Cell[TextData[{
 "How the number is measured: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCone", "[", 
     RowBox[{
      StyleBox["axis", "TI"], ",", " ", 
      StyleBox["m", "TI"]}], "]"}], ",", " ", 
    StyleBox["measure", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b94a732-52e2-4f38-9255-1c625b3c599a"],
 " takes the vertices within ",
 StyleBox["\[LeftFloor]m (i \[Minus] 1)\[RightFloor]", "TI"],
 " of the axis vertex they project to, or the union of the balls of radius ",
 StyleBox["\[LeftFloor]m (i \[Minus] 1)\[RightFloor]", "TI"],
 " about the vertices of the axis under ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5016fa7a-15c1-45fd-b74c-97d0b8f22423"],
 ", and counts them, or counts their ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraInterior"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraInterior", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1c64cc3f-8978-47a2-b706-a38f18597978"],
 ". The profile is the list over the slope."
}], "Notes",ExpressionUUID->"c5d24f6a-9656-4693-b10a-34e32a92865c"],

Cell[TextData[{
 "The head computes nothing. A cone has one member, the vertex set. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9d02fe2d-61e9-4226-b89e-de046e1f1603"],
 " also reads ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea4b8964-423a-4196-836e-ced0e76935af"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9c5919c-d3a7-4dd3-a545-d90026c0a6db"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "300c4fd8-4b57-4118-8093-adc5c8ee6fa8"],
 ", ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76d97e68-16c8-4087-8aed-a063c420b639"],
 " and ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30a4a46a-fd56-420e-8481-d803015a660d"],
 "."
}], "Notes",ExpressionUUID->"5b543d19-738c-4f6a-9e75-0fcdeffff524"]
}, Open  ]],

