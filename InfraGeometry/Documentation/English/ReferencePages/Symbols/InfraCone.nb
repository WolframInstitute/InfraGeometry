Cell["Method", "ExampleSubsection",ExpressionUUID->"8851272b-99a8-4c76-a64f-4b1f774cb494"],

Cell["\<\
The cone of slope 1 with a flat base, with a round base, and the ball of \
radius 4 about the far end. The last two are equal:\
\>", "ExampleText",ExpressionUUID->"a466f253-376a-4103-835b-2f48c7e7f0e8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"region", ",", " ", "axis"}], "}"}]}], "]"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"region", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraCone", "[", 
           RowBox[{"axis", ",", " ", "1"}], "]"}], ",", " ", 
          RowBox[{"InfraCone", "[", 
           RowBox[{"axis", ",", " ", "1", ",", " ", 
            RowBox[{"Method", " ", "->", " ", "\"\<Balls\>\""}]}], "]"}], ",",
           " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{
            RowBox[{"Last", "[", "axis", "]"}], ",", " ", "4"}], "]"}]}], 
         "}"}]}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4ac00caa-6b89-4794-ba0a-ff2550c63d99"],

