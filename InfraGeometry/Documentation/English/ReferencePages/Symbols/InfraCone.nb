Cell["\<\
The cone of slope 1/2 along a shortest path of length 4, on the square grid \
and on the square mesh:\
\>", "ExampleText",ExpressionUUID->"793da4a6-c70d-45e9-97a8-3d828c350748"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"axis", " ", "=", " ", 
        RowBox[{"RandomInfraSegment", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraShell", "[", 
             RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraCone", "[", 
           RowBox[{"axis", ",", " ", 
            RowBox[{"1", "/", "2"}]}], "]"}], ",", " ", "axis"}], "}"}]}], 
       "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"3df4f7dc-f81d-4bc2-a7fb-e8eaafd47ec4"],

