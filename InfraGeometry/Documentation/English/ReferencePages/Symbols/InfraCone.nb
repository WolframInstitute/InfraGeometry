Cell["\<\
The cone of slope 1 along a shortest path, sliced, rounded, and the ball of \
radius the length of the axis about the far end. The rounded cone is that \
ball; the sliced one keeps the base flat.\
\>", "ExampleText",ExpressionUUID->"ac71d48c-4431-49eb-bd96-325d3cac9863"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"RandomInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
           RowBox[{"RandomInfraPoint", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraShell", "[", 
              RowBox[{"c", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], 
        "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cone", " ", "=", " ", 
     RowBox[{"InfraCone", "[", 
      RowBox[{"axis", ",", " ", "1", ",", " ", 
       RowBox[{"Method", " ", "->", " ", "\"\<Balls\>\""}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"farBall", " ", "=", " ", 
     RowBox[{"InfraBall", "[", 
      RowBox[{
       RowBox[{"Last", "[", "axis", "]"}], ",", " ", "4"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"InfraCone", "[", 
             RowBox[{"axis", ",", " ", "1"}], "]"}], ",", " ", "axis"}], 
           "}"}]}], "]"}], ",", " ", 
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{"cone", ",", " ", "axis"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{"farBall", ",", " ", 
            RowBox[{"Last", "[", "axis", "]"}]}], "}"}]}], "]"}]}], "}"}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"RandomInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", "cone"}], "]"}], " ", "===", " ", 
      RowBox[{"RandomInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", "farBall"}], "]"}]}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"ef649580-4dda-4792-8cd4-92f6ae50f9d8"],

