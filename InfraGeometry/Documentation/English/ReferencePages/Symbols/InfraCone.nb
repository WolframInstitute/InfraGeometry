Cell[CellGroupData[{
Cell["InfraCone", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b726baea-d705-4b61-ab16-02f97e32e3ce"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCone"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCone", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["slope", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f72a5b00-ca42-4ddc-a291-1a89fe8af82e"],
 "\[LineSeparator]",
 "is the cone along ",
 StyleBox["axis", "TI"],
 " with apex ",
 StyleBox["axis", "TI"],
 "[[1]]: the vertices within ",
 StyleBox["slope", "TI"],
 " (",
 StyleBox["i", "TI"],
 " \[Minus] 1) of the ",
 StyleBox["i", "TI"],
 "-th vertex of the axis, for some ",
 StyleBox["i", "TI"],
 ". It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a3ac7d40-59c7-49bb-93fa-d39dae076dd7"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "91ce7010-96e9-47fa-82f4-50a6afcbff58"],
 " evaluate it on a graph.",
 "\n"
}], "Usage",ExpressionUUID->"e90ed8ec-0534-4ca8-b1e8-885b77349882"],

Cell[TextData[{
 "Definition: with the axis ",
 StyleBox["a_1, \[Ellipsis], a_n", "TI"],
 ", the cone of slope ",
 StyleBox["m", "TI"],
 " is ",
 StyleBox["{v : d(v, a_i) \[LessEqual] m (i \[Minus] 1) for some i}", "TI"],
 ", the union of the balls whose radius grows linearly from the apex."
}], "Notes",ExpressionUUID->"565b53eb-1c6e-403d-ac55-efe2b46b6f20"],

Cell[TextData[{
 "A radius is a whole number of steps, so the radius ",
 StyleBox["m (i \[Minus] 1)", "TI"],
 " is rounded down: a cone of slope 1/2 grows by one step every second vertex \
of the axis, and its mantle is a staircase."
}], "Notes",ExpressionUUID->"d56f7ff4-9991-4dcf-85c5-ccc974b13916"],

Cell[TextData[{
 StyleBox["axis", "TI"],
 " is a vertex list, for example one representative of a segment or a ray. \
Reverse it for the other apex. Slope 0 gives the axis."
}], "Notes",ExpressionUUID->"391146a9-f766-4de3-8532-8434103682f9"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9d18f9fb-1beb-4a0d-b2e9-2cf68867e53c"],
 " gives two measures of a cone:"
}], "Notes",ExpressionUUID->"b6ca0b85-e830-4a92-8d00-b90171987312"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "62d60632-9c66-4d23-ab07-cdcb414fde1d"], Cell["Measure", "TableText",
     FontWeight->Bold,ExpressionUUID->"55127fd5-8e34-42ed-8817-7923ad6a5aa1"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"9f9b24a6-9fed-4354-a59a-028496903f1f"]},
