Cell[TextData[{
 "The cone is contained in the cylinder of radius ",
 StyleBox["slope", "TI"],
 " (",
 StyleBox["n", "TI"],
 " \[Minus] 1)."
}], "ExampleText",ExpressionUUID->"a3867b36-0799-4e3d-b541-74677c74d5cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
           RowBox[{"FindInfraPoint", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraShell", "[", 
              RowBox[{"c", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], 
        "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"SubsetQ", "[", 
    RowBox[{
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCylinder", "[", 
        RowBox[{"axis", ",", " ", 
         RowBox[{
          RowBox[{"Length", "[", "axis", "]"}], " ", "-", " ", "1"}]}], 
        "]"}]}], "]"}], ",", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCone", "[", 
        RowBox[{"axis", ",", " ", "1"}], "]"}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
