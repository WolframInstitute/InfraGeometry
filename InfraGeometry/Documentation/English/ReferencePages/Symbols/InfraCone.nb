Notebook[{

Cell[CellGroupData[{
Cell["InfraCone", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"32cde36f-2eb8-4496-878b-9cd66fa27dbf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCone"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCone", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["slope", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "997892b7-aece-4b05-94d6-7e76ad7f4535"],
 "\[LineSeparator]",
 "is the cone along ",
 StyleBox["axis", "TI"],
 " with apex ",
 StyleBox["axis", "TI"],
 "[[1]]: the vertices within ",
 StyleBox["slope", "TI"],
 " (",
 StyleBox["i", "TI"],
 " \[Minus] 1) of the ",
 StyleBox["i", "TI"],
 "-th vertex of the axis they project to, with a flat base. It is a symbolic \
object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e1af3406-d315-41a9-a7cf-2c6af2e20773"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f68ebd5a-5008-4e4f-bf65-0497639d5374"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e0c3fce7-f932-47e0-9200-c47c7cfd5ba1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCone"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCone", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["slope", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79742302-c2a5-487f-a1ca-12ab5b481294"],
 "\[LineSeparator]",
 "is the rounded cone, the union of the balls of radius ",
 StyleBox["slope", "TI"],
 " (",
 StyleBox["i", "TI"],
 " \[Minus] 1) about the vertices of the axis."
}], "Usage",ExpressionUUID->"89463d20-d9ef-4b53-87d8-47134bf4a639"],

Cell[TextData[{
 "Definition: with the axis ",
 StyleBox["a_1, \[Ellipsis], a_n", "TI"],
 ", the cone of slope ",
 StyleBox["m", "TI"],
 " is the sliced tube ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    RowBox[{
     StyleBox["i", "TI"], " ", "|->", " ", 
     RowBox[{
      StyleBox["m", "TI"], " ", 
      RowBox[{"(", 
       RowBox[{
        StyleBox["i", "TI"], " ", "\[Minus]", " ", "1"}], ")"}]}]}], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Sliced\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67ff5a69-4b28-4fd1-9211-bc5184746e21"],
 ". Slice ",
 StyleBox["i", "TI"],
 " is the set of vertices whose nearest axis vertex is ",
 StyleBox["a_i", "TI"],
 ", a tie lying in every nearest slice, and ",
 StyleBox["v", "TI"],
 " is in the cone when ",
 StyleBox["d(a_i, v) \[LessEqual] m (i \[Minus] 1)", "TI"],
 " for its slice: the radius grows linearly from the apex, and is read at the \
axis vertex the vertex projects to."
}], "Notes",ExpressionUUID->"89159f57-98d5-4519-80ba-fac57cc28303"],

Cell[TextData[{
 "A radius is a whole number of steps, so the radius ",
 StyleBox["m (i \[Minus] 1)", "TI"],
 " is rounded down: a cone of slope 1/2 grows by one step every second vertex \
of the axis, and its mantle is a staircase."
}], "Notes",ExpressionUUID->"e64a32ad-3942-41dd-9a96-828e60caddc9"],

Cell[TextData[{
 "The axis is prolonged straight on past both ends and the vertices nearer a \
prolongation than the axis are cut, so the base is flat: the cone keeps a \
full row at the last axis vertex. ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58da725b-054f-417d-9580-350cb537b12d"],
 " drops the slicing and rounds the base. The rounded cone of the earlier \
releases is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    RowBox[{
     StyleBox["i", "TI"], " ", "|->", " ", 
     RowBox[{
      StyleBox["m", "TI"], " ", 
      RowBox[{"(", 
       RowBox[{
        StyleBox["i", "TI"], " ", "\[Minus]", " ", "1"}], ")"}]}]}]}], "]"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ef3e9c1-3ad7-4b34-adcd-d2f343b86676"],
 "."
}], "Notes",ExpressionUUID->"cb81be8e-9152-4bdc-b612-5cd21a01f9cc"],

Cell[TextData[{
 StyleBox["axis", "TI"],
 " is a walk: a vertex list, for example one representative of a segment or a \
ray, or a path or cycle graph. Reverse it for the other apex. Slope 0 gives \
the axis."
}], "Notes",ExpressionUUID->"8a38b88e-61a9-49be-8e98-7ab35c8966cc"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "822da812-52a3-4a63-9690-4259da05a5f1"],
 " gives two measures of a cone:"
}], "Notes",ExpressionUUID->"e8f42b57-51ef-4435-9802-e3067be1727b"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f0dcbcfa-6143-4bb1-89dc-ed6f446d6d18"], Cell["Measure", "TableText",
     FontWeight->Bold,ExpressionUUID->"4cbda6c0-f84a-4012-acd5-7c534c50c76f"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"71f42bdf-e9a9-4c32-af54-08b751fc4bee"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5d53c5d4-671d-49a1-a53b-44950ba14b7c"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "43076131-a90b-42af-9004-7e8eaae17e9c"]], "TableText",ExpressionUUID->
     "6286f6e7-dc69-48f0-802e-23574d9e9833"], Cell[
    "the number of vertices of the cone", "TableText",ExpressionUUID->
     "eab7fe51-6b33-4f20-8610-6acdfb8478d6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "198fbdca-a9ba-42f9-9512-9834320dd77c"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "adc1dfdc-e490-45a1-a3c3-d52b81104706"]], "TableText",ExpressionUUID->
     "0a20f5d9-3f05-4d59-af41-fe114f9e0f0f"], Cell["\<\
the number of vertices of the cone all of whose neighbours lie in it: the \
count without the mantle and the base\
\>", "TableText",ExpressionUUID->"53f41f82-3b34-486d-9f46-2b8dbdcd36bd"]}
  }]], "2ColumnTableMod",ExpressionUUID->"53d4ef0e-930b-42c3-b18f-\
ff83b7b9590c"],

Cell["\<\
The apex is boundary, and so is the axis near it, where the cone is thinner \
than one step.\
\>", "Notes",ExpressionUUID->"815b66df-ba2c-4fb4-b82c-0b79ff952bdb"],

Cell[TextData[{
 "A slope ",
 StyleBox["m \[GreaterEqual] 1", "TI"],
 " gives a ball under ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86ef3402-fbf0-460e-9f5b-2135a8f61f5e"],
 ". When the axis ",
 StyleBox["a_1, \[Ellipsis], a_n", "TI"],
 " is a shortest path, the rounded cone of slope ",
 StyleBox["m \[GreaterEqual] 1", "TI"],
 " is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a_n", "TI"], ",", " ", 
    RowBox[{"\[LeftFloor]", 
     RowBox[{
      StyleBox["m", "TI"], " ", 
      RowBox[{"(", 
       RowBox[{
        StyleBox["n", "TI"], " ", "\[Minus]", " ", "1"}], ")"}]}], 
     "\[RightFloor]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "917ef0b6-fe80-46ca-8732-02d8ca312d79"],
 ", the ball about the far end: a vertex within ",
 StyleBox["\[LeftFloor]m (i \[Minus] 1)\[RightFloor]", "TI"],
 " of ",
 StyleBox["a_i", "TI"],
 " is within ",
 StyleBox["\[LeftFloor]m (i \[Minus] 1)\[RightFloor] + n \[Minus] i \
\[LessEqual] \[LeftFloor]m (n \[Minus] 1)\[RightFloor]", "TI"],
 " of ",
 StyleBox["a_n", "TI"],
 ", by the triangle inequality along the axis. So the counts of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "695f046f-aa14-42be-bbeb-c352ce3353b8"],
 " apply. For ",
 StyleBox["0 < m < 1", "TI"],
 " no lattice count is known, and the cone is measured."
}], "Notes",ExpressionUUID->"d57c06d8-35c3-45ec-9789-788e2a9f8053"],

Cell[TextData[{
 "In the continuum two cones are the references. In the Euclidean plane the \
union of the disks of radius ",
 StyleBox["m t", "TI"],
 " about the points at distance ",
 StyleBox["t", "TI"],
 " along a segment of length ",
 StyleBox["R", "TI"],
 ", for ",
 StyleBox["0 \[LessEqual] m < 1", "TI"],
 ", is the convex hull of the apex and the far disk of radius ",
 StyleBox["m R", "TI"],
 ", with area"
}], "Notes",ExpressionUUID->"8dc98452-dc89-4210-9bd8-b69fbed4b914"],

Cell[TextData[{
 StyleBox["m R\.b2 \[Sqrt](1 \[Minus] m\.b2) + m\.b2 R\.b2 (\[Pi] \[Minus] \
arccos m)", "TI"],
 "."
}], "Notes",ExpressionUUID->"9dd21949-5608-41ac-8715-8a764c12c938"],

Cell[TextData[{
 "In a Riemannian manifold of dimension ",
 StyleBox["n", "TI"],
 " the angular cone ",
 StyleBox["{exp_p(t u) : u \[Element] \[CapitalOmega], 0 \[LessEqual] t \
\[LessEqual] r}", "TI"],
 " over a set ",
 StyleBox["\[CapitalOmega]", "TI"],
 " of unit directions at the apex ",
 StyleBox["p", "TI"],
 ", of spherical measure ",
 StyleBox["\[Sigma](\[CapitalOmega])", "TI"],
 ", has volume"
}], "Notes",ExpressionUUID->"a62a8c72-946d-48a2-af1a-52c8863cec90"],

Cell[TextData[{
 StyleBox["\[Sigma](\[CapitalOmega]) r^n / n \[Minus] r^(n+2) / (6(n + 2)) \
\[Integral]_\[CapitalOmega] Ric(u, u) d\[Sigma] + O(r^(n+3))", "TI"],
 "."
}], "Notes",ExpressionUUID->"e6d5a843-3ed5-4ffc-adad-ee93fb1732b8"],

Cell[TextData[{
 "Over the round cap ",
 StyleBox["\[CapitalOmega]", "TI"],
 " of half-angle ",
 StyleBox["\[Alpha]", "TI"],
 " about the axis direction ",
 StyleBox["v", "TI"],
 ", ",
 StyleBox["\[Integral]", "TI"],
 StyleBox["\[CapitalOmega] Ric(u, u) d\[Sigma] = c", "TI", "TI"],
 StyleBox["\[UpTee] Scal + (c_\[DoubleVerticalBar] \[Minus] c_\[UpTee]) \
Ric(v, v)", "TI"],
 ", with ",
 StyleBox["c_\[DoubleVerticalBar] = |S^(n\[Minus]2)| \[Integral]_0^\[Alpha] \
cos\.b2 t sin^(n\[Minus]2) t dt", "TI"],
 " and ",
 StyleBox["c_\[UpTee] = (\[Sigma](\[CapitalOmega]) \[Minus] c_\
\[DoubleVerticalBar])/(n \[Minus] 1)", "TI"],
 ": a thin cone reads the Ricci curvature along its axis. The rounded cone of \
this head is the hull, not an angular cone; it agrees with the angular cone \
of half-angle ",
 StyleBox["arcsin m", "TI"],
 " within distance ",
 StyleBox["R (1 \[Minus] m)", "TI"],
 " of the apex."
}], "Notes",ExpressionUUID->"01dc16f7-56d0-41ca-9adf-92af3e48264e"],

Cell[TextData[{
 "How the number is measured: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraCone", "[", 
     RowBox[{
      StyleBox["axis", "TI"], ",", " ", 
      StyleBox["m", "TI"]}], "]"}], ",", " ", 
    StyleBox["measure", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dcd0fab8-eabf-4515-9bf8-5b547dc5e8e7"],
 " takes the vertices within ",
 StyleBox["\[LeftFloor]m (i \[Minus] 1)\[RightFloor]", "TI"],
 " of the axis vertex they project to, or the union of the balls of radius ",
 StyleBox["\[LeftFloor]m (i \[Minus] 1)\[RightFloor]", "TI"],
 " about the vertices of the axis under ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01e2844e-2b8e-414b-aa0c-e3339725f2ca"],
 ", and counts them, or counts their ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraInterior"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraInterior", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "869f3f7a-6c85-4d8e-9c30-d97d04f35e03"],
 ". The profile is the list over the slope."
}], "Notes",ExpressionUUID->"3fbce096-5475-489f-a990-25bfccebc8a9"],

Cell[TextData[{
 "The head computes nothing. A cone has one member, the vertex set. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b6124623-4793-4024-a19b-aed8a518a7a0"],
 " also reads ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30c26e88-2cfc-4a92-9ff3-4a2c2e85c2a6"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "633b5d96-3908-4e9b-9d3c-121a4a8086be"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9a3a928-1233-4160-8152-e78f258e71c4"],
 ", ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f1adb56-8d5e-4fd3-bd98-76a2b04973ba"],
 " and ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cd7e3fe-af1b-4a39-9cfd-ef6525282e60"],
 "."
}], "Notes",ExpressionUUID->"92d9ab9c-01f7-4152-a7ab-cfc8a910a5d4"]
}, Open  ]],

