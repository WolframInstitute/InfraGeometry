Cell["\<\
The two measures against the slope, along a shortest path of length 6 on the \
square grid. Slope 0 is the axis, all boundary.\
\>", "ExampleText",ExpressionUUID->"7f8741cb-03a5-47ed-a38c-34159f8ca80c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
           RowBox[{"FindInfraPoint", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraShell", "[", 
              RowBox[{"c", ",", " ", "6"}], "]"}]}], "]"}]}], ")"}]}], 
        "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"slopes", " ", "=", " ", 
     RowBox[{"Range", "[", 
