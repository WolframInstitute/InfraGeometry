Cell[CellGroupData[{
Cell["InfraCone", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8a5fbe6c-5d16-4c2e-a2b9-50b4da5143d4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCone"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCone", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["slope", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a42074ee-ed95-4a80-ac50-ad61a4d63eb0"],
 "\[LineSeparator]",
 "is the cone along ",
 StyleBox["axis", "TI"],
 " with apex ",
 StyleBox["axis", "TI"],
 "[[1]]: the vertices within ",
 StyleBox["slope", "TI"],
 " (",
 StyleBox["i", "TI"],
 " - 1) of the ",
 StyleBox["i", "TI"],
 "-th vertex of the axis, for some ",
 StyleBox["i", "TI"],
 ". It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e68626ed-c6ee-4a7e-99b5-0043ee3030d5"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "152e9ae3-f79d-43d8-8162-567113dbac47"],
 " evaluate it on a graph.",
 "\n"
}], "Usage",ExpressionUUID->"05d634d9-f790-4048-b82a-127b73bf66dd"],

Cell[TextData[{
 "Definition: with the axis ",
 StyleBox["a_1, \[Ellipsis], a_n", "TI"],
 ", the cone of slope ",
 StyleBox["m", "TI"],
 " is ",
 StyleBox["{v : d(v, a_i) \[LessEqual] m (i - 1) for some i}", "TI"],
 ", the union of the balls whose radius grows linearly from the apex."
}], "Notes",ExpressionUUID->"bcd0358c-fdbb-4b62-b601-9b3f6b39e725"],

Cell[TextData[{
 StyleBox["axis", "TI"],
 " is a vertex list, for example one representative of a segment or a ray. \
Reverse it for the other apex. The slope may be a rational number; slope 0 \
gives the axis."
}], "Notes",ExpressionUUID->"d2b514c8-6514-4049-bad9-e863db79c654"],

Cell[TextData[{
 "The head computes nothing. A cone has one member, the vertex set, and owns \
the same nine properties as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d370c04f-6f0c-4d97-9108-6b287675c1e1"],
 "."
}], "Notes",ExpressionUUID->"db318f09-cfff-4084-a978-a2f9b790cf93"]
}, Open  ]],

