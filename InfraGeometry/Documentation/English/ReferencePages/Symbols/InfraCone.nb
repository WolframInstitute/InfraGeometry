dd0e2d8123ff"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Balls\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0def4fc-1998-4622-9507-8da2bfbf5e2a"],
 " and ",
 StyleBox["m \[GreaterEqual] 1", "TI"],
 " along a shortest path, the cone is the ball of radius ",
 StyleBox["\[LeftFloor]m (n \[Minus] 1)\[RightFloor]", "TI"],
 " about the far end ",
 StyleBox["a\:2099", "TI"],
 ": by the triangle inequality every ball about ",
 StyleBox["a\:1d62", "TI"],
 " lies in it."
}], "Notes",ExpressionUUID->"e4d1d7de-0bbf-4426-b6e9-55cea851f9f2"]
}, Open  ]],

