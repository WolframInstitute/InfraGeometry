Cell[TextData[{
 "The cone of slope 1 along a straight axis of the grid and its interior, \
with the two measures ",
 StyleBox["(n + 1)\.b2 = 49", "TI"],
 " and ",
 StyleBox["(n \[Minus] 1)\.b2 = 25", "TI"],
 " for ",
 StyleBox["n", "TI"],
 " = 6:"
}], "ExampleText",ExpressionUUID->"9dade1dd-6f84-47b2-bcb5-93a1436a9d81"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", "6"}], "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSegment", "[", 
            RowBox[{"c", ",", " ", "#"}], "]"}], ",", 
           " ", "\"\<Cardinality\>\""}], "]"}], " ", "==", " ", "1"}], " ", 
        "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cone", " ", "=", " ", 
     RowBox[{"InfraCone", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"RandomInfraSegment", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "q", ",", " ", "All"}], 
         "]"}]}], ",", " ", "1"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"cone", ",", " ", 
       RowBox[{"InfraInterior", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Keys", " ", "@", " ", 
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", "cone", ",", " ", "\"\<VertexDensity\>\""}],
            "]"}]}]}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "cone", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<CountingMeasure\>\"", ",", 
          " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3306345b-8428-4f77-af1c-d7b3a2b0c1b2"],

