Cell[CellGroupData[{
Cell["InfraCone", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"35c639ca-a7f4-411c-858f-fa413258392e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCone"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCone", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["m", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b54c968-e9cf-4658-9f61-25fe78092e3f"],
 "\[LineSeparator]",
 "is the cone of slope ",
 StyleBox["m", "TI"],
 " along the walk ",
 StyleBox["axis", "TI"],
 ", with its apex at the first vertex of the axis and a flat base at the \
last.",
 "\n"
}], "Usage",ExpressionUUID->"a4798817-2ebd-4f25-b481-3afbddbbb5de"],

Cell[TextData[{
 "Let the axis be ",
 StyleBox["a\:2081, \[Ellipsis], a\:2099", "TI"],
 ". The cone is the cylinder whose radius grows from the apex: ",
 StyleBox["v", "TI"],
 " is in the cone when ",
 StyleBox["d(a\:1d62, v) \[LessEqual] \[LeftFloor]m (i \[Minus] 1)\
\[RightFloor]", "TI"],
 " for an axis vertex ",
 StyleBox["a\:1d62", "TI"],
 " nearest to ",
 StyleBox["v", "TI"],
 ". It is the sliced tube ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    RowBox[{
     StyleBox["i", "TI"], " ", "|->", " ", 
     RowBox[{
      StyleBox["m", "TI"], " ", 
      RowBox[{"(", 
       RowBox[{
        StyleBox["i", "TI"], " ", "\[Minus]", " ", "1"}], ")"}]}]}], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Sliced\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "800c0e4b-de79-4b45-965e-6de2d5ee12e9"],
 "."
}], "Notes",ExpressionUUID->"d8896cd6-6401-4f0c-8af9-b1981f5e88dc"],

Cell["\<\
A radius is a whole number of steps. A cone of slope 1/2 grows by one step \
every second axis vertex, and its side is a staircase.\
\>", "Notes",ExpressionUUID->"e0339121-9ff9-4f77-bf43-ef1aa5d46c97"],

Cell[TextData[{
 "The base is flat: as for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCylinder"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "21c04b98-8dd8-4811-9102-fca1ef116a7b"],
 ", the vertices nearer the prolongation of the axis than the axis are cut \
off. Reverse the axis to put the apex at the other end. Slope 0 gives the \
axis."
}], "Notes",ExpressionUUID->"635f8c15-0f38-4172-9be5-2ad1319311f9"],

Cell[TextData[{
 "On the square grid, away from the rim, the cone of slope 1 along a straight \
axis of ",
 StyleBox["n", "TI"],
 " edges is a triangle with ",
 StyleBox["(n + 1)\.b2", "TI"],
 " vertices, ",
 StyleBox["(n \[Minus] 1)\.b2", "TI"],
 " of them interior."
}], "Notes",ExpressionUUID->"9c5d7087-2d02-4b54-ac4a-9f388a6c1452"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2e9d1e49-cc83-42e0-8e93-ec3287311aa1"], Cell["Measure", "TableText",
