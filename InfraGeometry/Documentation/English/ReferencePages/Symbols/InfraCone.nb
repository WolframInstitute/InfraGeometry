Cell["\<\
The cone of slope 1/2 along a ray on the square, hexagonal and triangular \
tilings.\
\>", "ExampleText",ExpressionUUID->"2f57abfa-8a14-497f-80f4-21cd8c4a6e4c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "4"}], "]"}]}], ")"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"axis", " ", "=", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"c", ",", " ", "p"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraCone", "[", 
            RowBox[{"axis", ",", " ", 
             RowBox[{"1", "/", "2"}]}], "]"}], " ", "->", " ", 
           "$InfraBallColor"}], ",", " ", 
          RowBox[{"axis", " ", "->", " ", "$InfraSegmentColor"}]}], "}"}]}], 
       "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"162ddd7a-e101-4d41-8dfd-22292b9d1a8f"],

