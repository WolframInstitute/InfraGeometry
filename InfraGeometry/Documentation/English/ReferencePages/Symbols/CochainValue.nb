Cell["\<\
The coboundary of the distance from the centre of the grid, on the step from \
the centre to a neighbour and on the step back:\
\>", "ExampleText",ExpressionUUID->"3b206336-e514-46d6-a136-d17a91529e64"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"df", " ", "=", " ", 
      RowBox[{"Coboundary", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"List", " ", "/@", " ", 
           RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "c"}], "]"}]}], "]"}]}], "]"}]}], ",", " ", 
     
     RowBox[{"w", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"AdjacencyList", "[", 
        RowBox[{"g", ",", " ", "c"}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraWalk", "[", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "w"}], "}"}], "]"}], ",", " ", "c"}], "}"}], ",",
      " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"CochainValue", "[", 
         RowBox[{"df", ",", " ", 
          RowBox[{"{", 
           RowBox[{"c", ",", " ", "w"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"CochainValue", "[", 
         RowBox[{"df", ",", " ", 
          RowBox[{"{", 
           RowBox[{"w", ",", " ", "c"}], "}"}]}], "]"}]}], "}"}]}], ",", "\n",
      "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"46c445d9-4903-4f3f-9fe5-123e21f335cf"],

