Cell["\<\
On a triangle the six orderings give the stored value with the signs of the \
six permutations, here for the 2-cochain that is 1 on one triangle at the \
centre.\
\>", "ExampleText",ExpressionUUID->"c0de6e14-4bc5-4c8e-add8-3f05e9825186"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"center", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"GraphCenter", "[", "g", "]"}]}]}], ",", " ", 
     RowBox[{"positions", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"triangle", " ", "=", " ", 
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"FindClique", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", "3", "}"}], ",", " ", "All"}], "]"}], ",", " ", 
         RowBox[{"MemberQ", "[", "center", "]"}]}], "]"}]}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"{", 
         RowBox[{"StandardBlue", ",", " ", 
          RowBox[{"Polygon", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"positions", ",", " ", "triangle"}], "]"}], "]"}]}], 
         "}"}], "]"}], ",", " ", "g"}], "]"}], ",", "\n", "   ", 
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"CochainValue", "[", 
          RowBox[{
           RowBox[{"<|", 
            RowBox[{"triangle", " ", "->", " ", "1"}], "|>"}], ",", " ", 
           "#"}], "]"}], " ", "&"}], ",", " ", 
        RowBox[{"Permutations", "[", "triangle", "]"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cf3de0cf-c3c2-4d30-9dc0-a775d4a6e21e"],

