Cell[CellGroupData[{
Cell["CochainValue", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5f1e5ea7-3b36-40b3-b842-de389a3a7f81"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CochainValue"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/CochainValue", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["\[Alpha]", "TR"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v\:2080", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["v\:2096", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d014e011-1c6e-4c62-80ef-bb12ce1fb376"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["\[Alpha](v\:2080, \[Ellipsis], v\:2096)", "TI"],
 ", the value of the alternating ",
 StyleBox["k", "TI"],
 "-cochain ",
 StyleBox["\[Alpha]", "TI"],
 " on a tuple of vertices.",
 "\n"
}], "Usage",ExpressionUUID->"fd46724a-6323-4729-a9cc-04ef1d625eaa"],

Cell[TextData[{
 "Definition: an alternating ",
 StyleBox["k", "TI"],
 "-cochain ",
 StyleBox["\[Alpha]", "TI"],
 " on a graph is a function on the orderings of its (",
 StyleBox["k", "TI"],
 " + 1)-cliques with ",
 StyleBox["\[Alpha](v\[Sigma](0), \[Ellipsis], v\[Sigma](k)) = sgn(\[Sigma]) \
\[Alpha](v\:2080, \[Ellipsis], v\:2096)", "TI"],
 " for every permutation ",
 StyleBox["\[Sigma]", "TI"],
 ", extended by 0 to the tuples that span no clique."
}], "Notes",ExpressionUUID->"a9a75aa6-4e06-4298-a1f1-7084c98fc024"],

Cell[TextData[{
 "An alternating cochain is determined by its values on the increasing \
tuples, one value per ",
 StyleBox["k", "TI"],
 "-simplex of the clique complex, and it is stored so: ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"v0", ",", " ", "...", ",", " ", "vk"}], "}"}], " ", "->", " ", 
    "value"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de741e41-ca3b-4161-859e-afd919612ef5"],
 " on the sorted cliques. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "05a4f9a5-a6ba-4854-8e92-efe815ea1ba1"],
 " sorts the tuple, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Sort"]], "paclet:ref/Sort"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aa2617af-00ea-46ac-8d6d-f2e48869917a"],
 " orders the vertex names, and multiplies the stored value by the sign of \
the sorting permutation. A tuple with a repeated vertex gives 0, and so does \
a tuple that is not stored: a value 0 is not stored, and a tuple that spans \
no clique carries no value."
}], "Notes",ExpressionUUID->"164a40a3-7616-44d1-908a-dc91292ab986"],

Cell[TextData[{
 "The same storage carries the ordered cochains, functions on the increasing \
tuples alone, and nothing in the data says which convention a cochain \
follows. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrderedCochainCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9b0a890c-7373-4c73-a543-956b19cd7c9a"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainCupOne"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainCupOne", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "537991e2-9dd4-439a-912c-b78c2fa622fc"],
 " give ordered cochains; read them with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrderedCochainValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c9a92e98-9ad7-4de1-b3d4-2e709c9c120b"],
 "."
}], "Notes",ExpressionUUID->"57b49da2-83a5-4829-8523-fa1fb1fa9215"]
}, Open  ]],

