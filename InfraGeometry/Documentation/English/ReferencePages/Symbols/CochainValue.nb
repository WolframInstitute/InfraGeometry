Cell["\<\
The coboundary of the distance from the centre of the triangular tiling, \
drawn by an arc along each edge in the direction in which it is 1. On the \
step from the centre to a neighbour it is 1, on the step back \[Minus]1.\
\>", "ExampleText",ExpressionUUID->"feff6ef2-33e4-45cd-b507-617d48a0550f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"center", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cochain", " ", "=", " ", 
     RowBox[{"Coboundary", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"AssociationMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"g", ",", " ", "center", ",", " ", 
            RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], ",", " ", 
         RowBox[{"List", " ", "/@", " ", 
          RowBox[{"VertexList", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"GroupBy", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Keys", " ", "@", " ", 
            RowBox[{"Select", "[", 
             RowBox[{"cochain", ",", " ", "Positive"}], "]"}]}], ",", " ", 
           RowBox[{"Reverse", " ", "/@", " ", 
            RowBox[{"Keys", " ", "@", " ", 
             RowBox[{"Select", "[", 
              RowBox[{"cochain", ",", " ", "Negative"}], "]"}]}]}]}], "]"}], ",",
          " ", 
         RowBox[{"First", " ", "->", " ", "Last"}]}], "]"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"CochainValue", "[", 
        RowBox[{"cochain", ",", " ", 
         RowBox[{"{", 
          RowBox[{"center", ",", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"AdjacencyList", "[", 
             RowBox[{"g", ",", " ", "center"}], "]"}]}]}], "}"}]}], "]"}], ",",
        " ", 
       RowBox[{"CochainValue", "[", 
        RowBox[{"cochain", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"AdjacencyList", "[", 
             RowBox[{"g", ",", " ", "center"}], "]"}]}], ",", " ", "center"}],
           "}"}]}], "]"}]}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"206ac900-83c8-403b-8fdf-257511168db5"],

