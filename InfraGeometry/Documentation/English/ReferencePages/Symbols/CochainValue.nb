Cell[TextData[{
 "Every cochain is read as alternating. On the ordered cup of two 1-cochains \
on the complete graph on four vertices, the Alexander\[Dash]Whitney formula \
gives ",
 StyleBox["a(1, 3) b(3, 2) = \[Minus]2", "TI"],
 " on the ordering (1, 3, 2), while ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b2d07a17-a7b5-47de-b6d1-0a579d7a0f61"],
 " gives the sign of the ordering times the stored value on (1, 2, 3), \
\[Minus]1:"
}], "ExampleText",ExpressionUUID->"08df3350-3e08-4aff-a9e8-7abeb98bdb72"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CompleteGraph", "[", "4", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], " ", "->", " ", "1"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}], " ", "->", " ", "2"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "4"}], "}"}], " ", "->", " ", "0"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}], " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}], " ", "->", " ", "3"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}], " ", "->", " ", "1"}]}], 
       "|>"}]}], ",", "\n", "   ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], " ", "->", " ", "0"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}], " ", "->", " ", "1"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "4"}], "}"}], " ", "->", " ", "2"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}], " ", "->", " ", "1"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}], " ", "->", " ", "0"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}], " ", "->", " ", 
         RowBox[{"-", "2"}]}]}], "|>"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"CochainValue", "[", 
       RowBox[{"a", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}], " ", 
      RowBox[{"CochainValue", "[", 
       RowBox[{"b", ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "2"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"CochainValue", "[", 
      RowBox[{
       RowBox[{"OrderedCochainCup", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3", ",", " ", "2"}], "}"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8ce6a740-b5a0-4508-8ffa-082a49f0cbaf"],

