Cell["\<\
On a triangle the six orderings give the stored value with the signs of the \
six permutations. The 2-cochain that is 1 on one triangle at the centre of \
the mesh:\
\>", "ExampleText",ExpressionUUID->"d2c70f4e-ec58-4cff-b1a4-c8e12d084c58"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"SelectFirst", "[", 
       RowBox[{
        RowBox[{"FindClique", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", "3", "}"}], ",", " ", "All"}], "]"}], ",", " ", 
        RowBox[{"MemberQ", "[", "c", "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"CochainValue", "[", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{"t", " ", "->", " ", "1"}], "|>"}], ",", " ", "#"}], "]"}], 
      " ", "&"}], ",", " ", 
     RowBox[{"Permutations", "[", "t", "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b680013a-4571-4582-a5fc-250c9c692ea5"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"5", ",", "75", ",", "79"}], "}"}], "\[Rule]", "1"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"5", ",", "79", ",", "75"}], "}"}], "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"75", ",", "5", ",", "79"}], "}"}], "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"75", ",", "79", ",", "5"}], "}"}], "\[Rule]", "1"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"79", ",", "5", ",", "75"}], "}"}], "\[Rule]", "1"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"79", ",", "75", ",", "5"}], "}"}], "\[Rule]", 
    RowBox[{"-", "1"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2893bf00-0fb9-4900-9f00-da27c368833f"]
}, Open  ]],

Cell["\<\
The centre and a vertex at distance 2 span no clique, and the value is 0; so \
is the value on a repeated vertex. On an edge it is 1:\
\>", "ExampleText",ExpressionUUID->"f7b524db-1d8c-48ee-9461-89f0627cd8e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"df", " ", "=", " ", 
     RowBox[{"Coboundary", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"List", " ", "/@", " ", 
          RowBox[{"VertexList", "[", "g", "]"}]}], ",", " ", 
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c"}], "]"}]}], "]"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"CochainValue", "[", 
      RowBox[{"df", ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "v"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"CochainValue", "[", 
      RowBox[{"df", ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "c"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"CochainValue", "[", 
      RowBox[{"df", ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"AdjacencyList", "[", 
           RowBox[{"g", ",", " ", "c"}], "]"}]}]}], "}"}]}], "]"}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b2338fb1-5030-4d65-a67b-2b3319b3b7da"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "1"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"8dc75130-a702-486b-bcdf-980f67454fcc"]
}, Open  ]]
}, Open  ]],

