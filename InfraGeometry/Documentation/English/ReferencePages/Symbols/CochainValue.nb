Cell[CellGroupData[{
Cell["CochainValue", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a77b1f0d-4280-41d9-b45a-2612d74cc6b6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CochainValue"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/CochainValue", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["\[Alpha]", "TR"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v\:2080", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["v\:2096", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1de8649d-8ed8-4933-bb80-259e0e4cb8e4"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["\[Alpha](v\:2080, \[Ellipsis], v\:2096)", "TI"],
 ", the value of the alternating ",
 StyleBox["k", "TI"],
 "-cochain ",
 StyleBox["\[Alpha]", "TI"],
 " on a tuple of vertices.",
 "\n"
}], "Usage",ExpressionUUID->"92baa0a3-b8b1-4713-9c7d-6aa39a2579ed"],

Cell[TextData[{
 "An alternating ",
 StyleBox["k", "TI"],
 "-cochain satisfies ",
 StyleBox["\[Alpha](v\[Sigma]\:208d\:2080\:208e, \[Ellipsis], v\[Sigma]\:208d\
\:2096\:208e) = sgn(\[Sigma]) \[Alpha](v\:2080, \[Ellipsis], v\:2096)", 
  "TI"],
 " for every permutation ",
 StyleBox["\[Sigma]", "TI"],
 ", and is 0 on a tuple that spans no clique."
}], "Notes",ExpressionUUID->"061df533-2133-47b0-b43b-102ccd16ba2e"],

Cell[TextData[{
 "It is stored on the increasing tuples, one value per ",
 StyleBox["k", "TI"],
 "-simplex of the clique complex: ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v0", ",", " ", "\[Ellipsis]", ",", " ", "vk"}], "}"}], " ", "->",
      " ", "value"}], ",", " ", "\[Ellipsis]"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "017087eb-e505-4d63-ab63-04cbacb95db8"],
 ". The value on any tuple is the stored value on the sorted tuple times the \
sign of the sorting permutation."
}], "Notes",ExpressionUUID->"d6c8317f-cfee-431c-8529-51f6a55a3e44"],

Cell["\<\
The value is 0 on a tuple with a repeated vertex, on a tuple that spans no \
clique and on a tuple whose stored value is 0.\
\>", "Notes",ExpressionUUID->"c74b7503-c42d-4b27-ad5c-eeccb9b24ee3"],

Cell[TextData[{
 "The storage does not say whether a cochain is alternating or ordered. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrderedCochainCup"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainCup", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a5007f29-2dd3-4022-aab2-d9afabf0f09a"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainCupOne"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainCupOne", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "df074eff-242b-4607-a620-9b35063dcf0f"],
 " give ordered cochains; read them with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["OrderedCochainValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/OrderedCochainValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e2fa1c68-df8f-4739-8fc3-d3b78877ebb6"],
 "."
}], "Notes",ExpressionUUID->"ebbfaf8d-ce98-4932-b4f7-321109091ba0"]
}, Open  ]],

