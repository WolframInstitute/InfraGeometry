Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b5748033-1739-490e-b441-67bee409d3c2"],
 " reads every cochain as alternating. On the ordered cup of two 1-cochains \
on the complete graph on four vertices, the Alexander\[Dash]Whitney formula \
gives ",
 StyleBox["a(1, 3) b(3, 2) = \[Minus]2", "TI"],
 " on the ordering (1, 3, 2), while ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CochainValue"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CochainValue", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f529588c-f884-4c8c-af1b-d21fd9d40bee"],
 " returns the sign of the ordering times the stored value on (1, 2, 3), \
\[Minus]1."
}], "ExampleText",ExpressionUUID->"33b48ce8-e3ec-4948-a02f-e6d3ef9537d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CompleteGraph", "[", "4", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], " ", "->", " ", "1"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}], " ", "->", " ", "2"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "4"}], "}"}], " ", "->", " ", "0"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}], " ", "->", " ", 
         RowBox[{"-", "1"}]}], ",", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}], " ", "->", " ", "3"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}], " ", "->", " ", "1"}]}], 
       "|>"}]}], ",", "\n", "   ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], " ", "->", " ", "0"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}], " ", "->", " ", "1"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "4"}], "}"}], " ", "->", " ", "2"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}], " ", "->", " ", "1"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}], " ", "->", " ", "0"}], ",", 
        " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}], " ", "->", " ", 
         RowBox[{"-", "2"}]}]}], "|>"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"g", ",", " ", 
     RowBox[{
      RowBox[{"CochainValue", "[", 
       RowBox[{"a", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}], " ", 
      RowBox[{"CochainValue", "[", 
       RowBox[{"b", ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "2"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"CochainValue", "[", 
      RowBox[{
       RowBox[{"OrderedCochainCup", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3", ",", " ", "2"}], "}"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fe1e7097-6fce-4747-83fe-6b68b1103bd5"],

