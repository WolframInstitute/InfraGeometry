Cell["\<\
The translation by one step to the right, on the square grid and on the \
square mesh. On the mesh the step is 1/8, the spacing of its rim:\
\>", "ExampleText",ExpressionUUID->"e341f4ad-42f3-4d71-8e4a-6590884b2a38"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"KeyValueMap", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name", ",", " ", "u"}], "}"}], " ", "|->", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"DisplacementPlot", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"TranslationDisplacement", "[", 
          RowBox[{"g", ",", " ", "u"}], "]"}]}], "]"}]}], "]"}]}], ",", "\n", 
    "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<SquareGridGraph\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}]}], ",", " ", 
      RowBox[{"\"\<SquareMeshGraph\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "8"}], ",", " ", "0"}], "}"}]}]}], "|>"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"40928c32-4d63-42cb-aa22-46fd13b706c6"],

