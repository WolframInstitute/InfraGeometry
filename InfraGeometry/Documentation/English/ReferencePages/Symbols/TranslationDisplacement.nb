Cell["\<\
Half a diagonal step lands at the centre of a square. Its four corners are \
equally near, and the translation keeps all four:\
\>", "ExampleText",ExpressionUUID->"de580774-0988-4b1c-a33c-55b6eed195cb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"half", " ", "=", " ", 
     RowBox[{"TranslationDisplacement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "2"}], ",", " ", 
         RowBox[{"1", "/", "2"}]}], "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"KeyTake", "[", 
      RowBox[{"half", ",", " ", 
       RowBox[{"{", "c", "}"}]}], "]"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"half", "[", "c", "]"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"dfcf2d50-d6b2-4a12-934d-bb965a7c1ff5"],

