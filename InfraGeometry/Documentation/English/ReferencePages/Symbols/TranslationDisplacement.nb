Notebook[{

Cell[CellGroupData[{
Cell["TranslationDisplacement", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"800372d8-39ae-47f1-a5d1-f750a817948c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TranslationDisplacement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TranslationDisplacement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["u", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d752274-8ea7-4fe2-9828-7d4f1f48ff19"],
 "\[LineSeparator]",
 "is the translation of ",
 StyleBox["g", "TI"],
 " by the vector ",
 StyleBox["u", "TI"],
 ": each vertex moves to the vertices whose coordinates are nearest to its \
own coordinates plus ",
 StyleBox["u", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"9528b3ad-6fc6-4058-bb66-3e7d71ded11c"],

Cell[TextData[{
 "The translation is ",
 StyleBox["T\:1d64(v) = {w : |x(w) \[Minus] x(v) \[Minus] u| is least}", "TI"],
 ", with ",
 StyleBox["x(v)", "TI"],
 " the coordinates of ",
 StyleBox["v", "TI"],
 " given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphEmbedding"]], "paclet:ref/GraphEmbedding"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "36b4c90d-6915-4c2c-af53-441bc2c60251"],
 "."
}], "Notes",ExpressionUUID->"fd822d21-81bb-4b9f-8f60-7af8fd1264b0"],

Cell[TextData[{
 "A displacement is an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4a7fed83-6dba-4b4d-939f-abde4e70af50"],
 " ",
 StyleBox["v", "TI"],
 " -> {",
 StyleBox["w1", "TI"],
 ", ",
 StyleBox["w2", "TI"],
 ", \[Ellipsis]} from the vertices to sets of vertices: the discrete \
counterpart of the flow of a vector field for a short time."
}], "Notes",ExpressionUUID->"906ce549-fec3-4e66-a40d-e10e4b639a9c"],

Cell[TextData[{
 "The translation reads the coordinates, not the graph metric. A step of \
length |",
 StyleBox["u", "TI"],
 "| in the plane can be a longer or a shorter step in the graph."
}], "Notes",ExpressionUUID->"0e4d1f01-b6b1-4a3f-ba2f-898d9918b04b"],

Cell["\<\
Ties are kept, up to an absolute tolerance of 10\:207b\:2076. A vector that \
is not in the lattice of the graph lands between vertices, and all the \
nearest ones are values.\
\>", "Notes",ExpressionUUID->"310db651-c8e4-4e5c-88c2-51e8f17dd198"],

Cell["\<\
On a finite graph the translation is not a bijection. Near the rim the \
translated point falls outside the graph and the vertex moves to the nearest \
vertices of the rim; nothing arrives at the opposite rim.\
\>", "Notes",ExpressionUUID->"ceeae00f-5f4b-40ec-857c-e0bfefd888b6"]
}, Open  ]],

