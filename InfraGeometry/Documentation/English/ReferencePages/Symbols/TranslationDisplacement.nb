Cell["\<\
The translation is not a bijection. The inverse is empty at the 10 vertices \
nothing arrives at, all on the left of the grid:\
\>", "ExampleText",ExpressionUUID->"167f039c-5cfb-4333-b408-6d1cfb98d9dd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"TranslationDisplacement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"empty", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"DisplacementInverse", "[", "t", "]"}], ",", " ", 
        RowBox[{
         RowBox[{"#", " ", "===", " ", 
          RowBox[{"{", "}"}]}], " ", "&"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", "empty", "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"DisplacementBijectionQ", "[", "t", "]"}], ",", " ", 
        RowBox[{"Length", "[", "empty", "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a90e0e0e-65a1-4c4d-bac9-ebfead60a7ce"],

