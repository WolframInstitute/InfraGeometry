Cell["\<\
Translations of the 6 \[Times] 6 grid compose to the translation by the sum \
of the vectors.\
\>", "ExampleText",ExpressionUUID->"62d390ca-504c-4fda-a1be-2644fb85a543"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"6", ",", " ", "6"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"composite", " ", "=", " ", 
     RowBox[{"DisplacementCompose", "[", 
      RowBox[{
       RowBox[{"TranslationDisplacement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"TranslationDisplacement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", "composite"}], "]"}], ",", " ", 
     RowBox[{"composite", " ", "===", " ", 
      RowBox[{"TranslationDisplacement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e2c50cdb-3972-4af7-a360-5dd21965fb7e"],

