Cell["\<\
The translation of a patch is not a bijection: nothing arrives at the \
trailing rim, and several vertices arrive at the leading rim.\
\>", "ExampleText",ExpressionUUID->"16723a03-90b9-4234-bf0f-192ba3c722ac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"translation", " ", "=", " ", 
     RowBox[{"TranslationDisplacement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"3", "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}]}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", "translation"}], "]"}], ",", " ", 
     RowBox[{"DisplacementSingleValuedQ", "[", "translation", "]"}], ",", " ", 
     RowBox[{"DisplacementBijectionQ", "[", "translation", "]"}], ",", " ", 
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{"Values", "[", 
        RowBox[{"DisplacementInverse", "[", "translation", "]"}], "]"}], ",", 
       " ", 
       RowBox[{"{", "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2668c21e-41cc-4cda-918f-d2247ff46ac1"],

