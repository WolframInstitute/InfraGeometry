Cell["\<\
The tolerance for a tie is absolute. On coordinates of size 10\:207b\:2077 \
every vertex is within it, and the translation by zero keeps every vertex as \
a value at the centre:\
\>", "ExampleText",ExpressionUUID->"64c0c792-d9b3-4070-8c1b-3e81de2cc4de"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"small", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"VertexCoordinates", " ", "->", " ", 
        RowBox[{
         RowBox[{"10", "^", 
          RowBox[{"-", "7"}]}], " ", 
         RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"Length", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"TranslationDisplacement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}]}], "]"}], "[", "c", "]"}], ",", 
      " ", 
      RowBox[{
       RowBox[{"TranslationDisplacement", "[", 
        RowBox[{"small", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}]}], "]"}], "[", "c", "]"}]}], 
     "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"54bfe4cf-023c-48fc-8098-9a2dd07accff"],

