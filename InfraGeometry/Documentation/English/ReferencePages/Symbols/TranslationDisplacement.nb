Cell["\<\
The step lengths in the graph, with their counts. On the grid every vertex of \
degree 4 moves one step; a pendant vertex of the top or the bottom row moves \
three, to the next pendant vertex. On the mesh the steps have lengths 0, 1 \
and 2:\
\>", "ExampleText",ExpressionUUID->"cf815b67-2207-454f-bb95-341074b0607a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"KeyValueMap", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name", ",", " ", "u"}], "}"}], " ", "|->", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"t", " ", "=", " ", 
         RowBox[{"TranslationDisplacement", "[", 
          RowBox[{"g", ",", " ", "u"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"lengths", " ", "=", " ", 
         RowBox[{"Flatten", " ", "@", " ", 
          RowBox[{"KeyValueMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"v", ",", " ", "ws"}], "}"}], " ", "|->", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"GraphDistance", "[", 
                 RowBox[{"g", ",", " ", "v", ",", " ", "#"}], "]"}], " ", 
                "&"}], " ", "/@", " ", "ws"}], ")"}]}], ",", " ", "t"}], 
           "]"}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"DisplacementPlot", "[", 
        RowBox[{"g", ",", " ", "t", ",", " ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"KeySort", " ", "@", " ", 
           RowBox[{"Counts", "[", "lengths", "]"}]}]}]}], "]"}]}], "]"}]}], ",",
     "\n", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<SquareGridGraph\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}]}], ",", " ", 
      RowBox[{"\"\<SquareMeshGraph\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "8"}], ",", " ", "0"}], "}"}]}]}], "|>"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d2ec4f07-06f9-4148-9a77-553c60d1b1e9"],

