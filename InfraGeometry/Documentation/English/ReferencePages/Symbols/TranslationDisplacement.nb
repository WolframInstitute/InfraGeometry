Cell[CellGroupData[{
Cell["TranslationDisplacement", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d45a84c5-1e47-4cc8-9f3e-a991503b4a87"],
 Cell[BoxData[
  RowBox[{"TranslationDisplacement", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["u", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3925931-ca71-4b14-b8c1-4543ea5ee976"],
 "\[LineSeparator]",
 "translates by the vector ",
 StyleBox["u", "TI"],
 " of the embedding of ",
 StyleBox["g", "TI"],
 ": each vertex moves to the vertices whose coordinates are nearest to its \
own coordinates plus ",
 StyleBox["u", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"d3e855ab-4d85-4f08-a909-ea96bddd37e3"],

Cell[TextData[{
 "Definition: with ",
 StyleBox["x(v)", "TI"],
 " the coordinates of ",
 StyleBox["v", "TI"],
 " given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphEmbedding"]], "paclet:ref/GraphEmbedding"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d7e07a7d-8b02-466f-8760-05e196cc8be7"],
 ", ",
 StyleBox["T_u(v) = { w : |x(w) \[Minus] (x(v) + u)| is least }", "TI"],
 ". Ties are kept."
}], "Notes",ExpressionUUID->"14f8bef9-7f65-439b-818c-26eb9990c810"],

Cell[TextData[{
 "The translation reads coordinates, not the graph metric: a substrate is \
translated in its lattice with ",
 Cell[BoxData["\"\<KeepCoordinates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "942c6ded-010c-40ec-b3a5-592d5f47fde3"],
 " -> ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca077800-0dfa-4227-beb3-83546266121e"],
 ", and in a computed layout without it. A vector of the lattice of a tiling \
moves every inner vertex onto a vertex; at the rim the translated position \
falls outside the patch, and the vertex moves to the nearest vertices of the \
rim, so the translation of a patch is not a bijection. A vector that is not \
in the lattice lands between vertices, where several can be nearest."
}], "Notes",ExpressionUUID->"b8fe3e2e-81b8-4d22-9c05-4b2208e05b95"]
}, Open  ]],

