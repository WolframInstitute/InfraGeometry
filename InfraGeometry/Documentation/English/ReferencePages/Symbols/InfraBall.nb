Cell[TextData[{
 "The two measures against the radius on the square grid. The counting \
measure is ",
 StyleBox["2 r^2 + 2 r + 1", "TI"],
 ", the Riemannian measure ",
 StyleBox["2 r^2 \[Minus] 2 r + 1", "TI"],
 ": the same curve one radius later."
}], "ExampleText",ExpressionUUID->"62547211-fbd9-4226-bb06-ccfaec4b60be"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"ListLinePlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "r"}], "]"}], ",", " ", "measure"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"measure", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<CountingMeasure\>\"", ",", 
           " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "8"}], "}"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"DataRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "8"}], "}"}]}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<CountingMeasure\>\"", ",", 
        " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<r\>\"", ",", " ", "None"}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7c4cf685-fc18-42d4-aa1a-ecfd4b85f451"],

