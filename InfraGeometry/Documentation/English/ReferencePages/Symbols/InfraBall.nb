Cell[CellGroupData[{
Cell["InfraBall", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d76dc25e-686b-47b4-a13e-3ad848c707e2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03d40bf0-f941-4c60-8a41-df02a4a03032"],
 "\[LineSeparator]",
 "is the closed ball of radius ",
 StyleBox["r", "TI"],
 " about the vertex ",
 StyleBox["c", "TI"],
 ": the vertices at distance at most ",
 StyleBox["r", "TI"],
 " from ",
 StyleBox["c", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"17370e9d-50a3-4627-aae8-7ad5339f4df7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec91956c-0151-4899-81c5-766e11b5c67a"],
 "\[LineSeparator]",
 "is the band of the vertices at distance between ",
 StyleBox["r", "TI"],
 " and ",
 StyleBox["s", "TI"],
 " from ",
 StyleBox["c", "TI"],
 "."
}], "Usage",ExpressionUUID->"6de66b9c-ec1d-42ef-9df2-171fdd939e92"],

Cell[TextData[{
 "The ball is ",
 StyleBox["B\:1d63(c) = {v : d(c, v) \[LessEqual] r}", "TI"],
 ", with ",
 StyleBox["d", "TI"],
 " the graph distance."
}], "Notes",ExpressionUUID->"2d48d510-c8a2-4d20-b692-a116d183861d"],

Cell[TextData[{
 "The centre can be a vertex list ",
 StyleBox["C", "TI"],
 ". Then ",
 StyleBox["d(v, C) = min d(v, c)", "TI"],
 " over ",
 StyleBox["c", "TI"],
 " in ",
 StyleBox["C", "TI"],
 ", and the ball is the ",
 StyleBox["r", "TI"],
 "-neighbourhood of ",
 StyleBox["C", "TI"],
 "."
}], "Notes",ExpressionUUID->"47fe391c-6ed0-40c8-9dc5-8e2fe616eadb"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "540c9654-5b82-4cbd-a68e-1661f1389fa0"],
 " is a symbolic object: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ccd20bea-8689-47bc-bffb-1cde6275589e"],
 " evaluates it on a graph and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "67b2d92f-10bd-4127-a4ce-8542b3f3739c"],
 " draws it."
}], "Notes",ExpressionUUID->"66b96113-3dbc-4a05-8e54-d7225d0be6ed"],

Cell[TextData[{
 "A ball is not round. On the square grid it is a square standing on a \
corner, the unit ball of the \[ScriptL]\.b9 norm scaled by ",
 StyleBox["r", "TI"],
 "."
}], "Notes",ExpressionUUID->"b6e97cbc-cb6d-451f-a079-b37a7d06ece4"],

Cell[TextData[{
 "The boundary of a ball is not small: on the square grid the vertices at \
distance exactly ",
 StyleBox["r", "TI"],
 " are a share of about ",
 StyleBox["2/r", "TI"],
 " of the ball. So a ball has two volumes:"
}], "Notes",ExpressionUUID->"4fcb4188-c46e-4867-a408-c80f5d5046e5"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "51530cd9-ed84-4fbc-a1e5-9701ff5a1b8b"], Cell["Measure", "TableText",
     FontWeight->Bold,ExpressionUUID->"c737f6f0-3215-46dc-b183-3904e6fb1e53"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"473fa309-3b8c-4ef2-ac14-471c4d0ed5d2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "30195d9f-5769-4f59-b614-f96296c3ad31"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "833d3302-13e3-4b9f-a8a6-6a9a75605eea"]], "TableText",ExpressionUUID->
     "11ed715c-1171-41d2-8c62-e94a3123a7a3"], Cell[
    "the number of vertices of the ball", "TableText",ExpressionUUID->
     "b3770e26-56b0-4ff6-9aa2-15bb26876e58"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fdd0434b-4d7f-453b-a170-27302ec8d64f"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "35deb6fe-f7e2-4ab6-a7ba-b2bfeadcdfe0"]], "TableText",ExpressionUUID->
     "6dd74746-4d74-4768-8b7d-0e0ec62656f6"], Cell[TextData[{
     "the number of vertices of its ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraInterior"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraInterior", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "d79de1a4-5313-436e-8b06-dbc3d8664139"],
     ", those all of whose neighbours lie in the ball"
    }], "TableText",ExpressionUUID->"36bcbd17-0ff0-48f6-9d3e-c6ddb163b4a3"]}
  }]], "2ColumnTableMod",ExpressionUUID->"862f6491-315f-432f-abfe-\
e2cb46c8b4d8"],

Cell[TextData[{
 "On the square grid, away from the rim, the counting measure is ",
 StyleBox["2r\.b2 + 2r + 1", "TI"],
 " and the Riemannian measure is ",
 StyleBox["2r\.b2 \[Minus] 2r + 1", "TI"],
 " for ",
 StyleBox["r \[GreaterEqual] 1", "TI"],
 ", the same polynomial at ",
 StyleBox["r \[Minus] 1", "TI"],
 ". On ",
 StyleBox["Z\:1d48", "TI"],
 " the counting measure is ",
 StyleBox["\[CapitalSigma]\:2096 2\:1d4f C(d, k) C(r, k)", "TI"],
 ", the sum over ",
 StyleBox["k = 0, \[Ellipsis], d", "TI"],
 "."
}], "Notes",ExpressionUUID->"0a855c88-a21a-42a0-91b6-c9661640f4ed"],

Cell[TextData[{
 "A radius past the eccentricity of ",
 StyleBox["c", "TI"],
 " gives the whole graph. The rim of the graph is not a boundary of the ball, \
so both measures are then the number of vertices."
}], "Notes",ExpressionUUID->"2719073e-9634-4488-8fe6-5e541c5faec2"],

