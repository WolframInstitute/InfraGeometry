Cell[TextData[{
 "The ball bound in the scene is the one ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2852c60d-d4e2-409c-a2ab-a11b2b55eabd"],
 " computes."
}], "ExampleText",ExpressionUUID->"70e7adbb-c304-4d96-bd9a-3f9c91bd3ba3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"pA", ",", " ", "ballA"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"constr", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "ballA"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "c", "]"}]}], ",", " ", 
         RowBox[{"ballA", " ", "==", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"pA", ",", " ", "2"}], "]"}]}]}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"InfraSceneInstance", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"FindInfraScene", "[", 
         RowBox[{"constr", ",", " ", "g"}], "]"}]}], ",", " ", "ballA"}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ball", " ", "->", " ", "$InfraBallColor"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c"}],
         "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"ball", " ", "===", " ", 
      RowBox[{"FindInfraBall", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "2"}], "]"}]}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"bc0ab842-280f-4264-b0e7-a2c8665d85cf"],

