Cell["\<\
Past the eccentricity the ball is the whole graph, and the Riemannian measure \
counts every vertex: the rim of the graph is not a boundary of the ball.\
\>", "ExampleText",ExpressionUUID->"26bebad4-bde2-4bdc-92c6-510816f04e72"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{
         RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "20"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"\"\<CountingMeasure\>\"", ",", 
         " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"VertexCount", "[", "g", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"bb9125ca-930b-40b1-8a61-30e6c1690228"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"CountingMeasure\"\>", "\[Rule]", "109"}], ",", 
     RowBox[{"\<\"RiemannianMeasure\"\>", "\[Rule]", "109"}]}], 
    "\[RightAssociation]"}], ",", "109"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"fa5fdc50-bc85-4ab4-90ae-2593f454e5f8"]
}, Open  ]]
}, Open  ]],

