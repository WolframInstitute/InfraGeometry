Cell[CellGroupData[{
Cell["InfraBall", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2e2487b8-c40b-4398-bbcb-570ccb7a021b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["x", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "400c6ad5-f3f4-4ce8-8033-013e98bb3b70"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "16ba3e0c-5f10-4c68-8510-2d47b5482fc2"],
 " is the closed ball of radius ",
 StyleBox["r", "TI"],
 " about the object ",
 StyleBox["x", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"d5c8eaf0-da95-49ca-b5b9-8b41536bf52c"],

Cell[TextData[{
 "Definition: the closed ball of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " is ",
 StyleBox["B_r(c) = {v : d(c, v) \[LessEqual] r}", "TI"],
 "."
}], "Notes",ExpressionUUID->"5f5a3b0f-aa6e-43da-a48c-d1ffc6b35236"],

Cell[TextData[{
 Cell[BoxData["InfraBall"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2aef6aa5-049d-417b-b9c7-1f24e46fc088"],
 " is a scene token. It names the ball in a construction ",
 Cell[BoxData[
  RowBox[{"x", " ", "==", " ", 
   RowBox[{"InfraBall", "[", 
    RowBox[{"y", ",", " ", "r"}], "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed86a00e-845e-4758-8a49-806d1b7fd935"],
 ", where ",
 StyleBox["y", "TI"],
 " is an object of the scene, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "99dd162d-fc6f-4280-a8a3-4257ebab12f4"],
 " solves it: each branch binds ",
 StyleBox["x", "TI"],
 " to the ball about the vertex ",
 StyleBox["y", "TI"],
 " stands for, a sorted vertex list. The ball is unique, so the token adds no \
branches."
}], "Notes",ExpressionUUID->"11756904-7620-46c0-bd62-79c477069b17"],

Cell[TextData[{
 "A ball itself is a sorted vertex list, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "68b1dcb4-9d0e-4cb0-9019-f9d5b9699d5b"],
 " computes it. Outside a scene the head is inert, and nothing reads it: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e2b78b8a-d09f-4cdd-a44d-23daba0b0ea9"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraVertexList", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "65ad2275-960b-4943-a16c-5c3928927b2a"],
 " take the Euclidean heads, not this one."
}], "Notes",ExpressionUUID->"45d9e04d-f383-4f39-a031-25483538094f"],

Cell[TextData[{
 "Balls are the probe of the volume measurements. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallVolumes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallVolumes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ba4110ae-f923-4a94-b325-dbb4c80adaa2"],
 " counts them at every radius without building them."
}], "Notes",ExpressionUUID->"75d23ace-7880-4138-9ca0-cfea58eacf3f"]
}, Open  ]],

