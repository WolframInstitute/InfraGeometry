     StyleBox["cx \[Congruent] cy", "TI"],
     " for some ",
     StyleBox["y", "TI"],
     " between ",
     StyleBox["c", "TI"],
     " and a point at distance ",
     StyleBox["r", "TI"],
     "."
    }], "TableText",ExpressionUUID->"75ae9757-1d16-481b-8259-13bc8bb521a0"]}
  }]], "3ColumnTableMod",ExpressionUUID->"e5583826-5516-43e0-98aa-\
