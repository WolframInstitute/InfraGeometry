Cell["\<\
A ball of radius 2 about the centre of a grid and the shell of radius 2 about \
a point two steps away. They meet in three vertices, one per branch.\
\>", "ExampleText",ExpressionUUID->"da72809b-b1c3-4fc5-87b7-2060fad4e1ad"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "pA", ",", " ", "pB", ",", " ", "ballA", ",", " ", "shellB", ",", " ", 
    "meet"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"constr", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "pA", ",", " ", "pB", ",", " ", "ballA", ",", " ", "shellB", ",", " ",
          "meet"}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "41", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "43", "]"}]}], ",", "\n", "      ", 
         RowBox[{"ballA", " ", "==", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"pA", ",", " ", "2"}], "]"}]}], ",", " ", 
         RowBox[{"shellB", " ", "==", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"pB", ",", " ", "2"}], "]"}]}], ",", "\n", "      ", 
         RowBox[{"meet", " ", "==", " ", 
          RowBox[{"InfraIntersection", "[", 
           RowBox[{"ballA", ",", " ", "shellB"}], "]"}]}]}], "}"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"solved", " ", "=", " ", 
       RowBox[{"FindInfraScene", "[", 
        RowBox[{"constr", ",", " ", "g"}], "]"}]}], "}"}], ",", "\n", "    ", 
     
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", "\n", "      ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"InfraSceneInstance", "[", 
             RowBox[{
              RowBox[{"First", " ", "@", " ", "solved"}], ",", " ", "ballA"}],
              "]"}], " ", "->", " ", "$InfraBallColor"}], ",", "\n", 
           "            ", 
           RowBox[{
            RowBox[{"InfraSceneInstance", "[", 
             RowBox[{
              RowBox[{"First", " ", "@", " ", "solved"}], ",", " ", 
              "shellB"}], "]"}], " ", "->", " ", "$InfraCircleColor"}], ",", 
           "\n", "            ", 
           RowBox[{"Directive", "[", "$InfraPointColor", "]"}]}], "}"}], ",", 
         "\n", "        ", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraSceneInstance", "[", 
            RowBox[{"#", ",", " ", "meet"}], "]"}], " ", "&"}], " ", "/@", 
          " ", "solved"}]}], "]"}], ",", "\n", "      ", 
       RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}]}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1375695f-28d0-497f-a390-d06a3211d29d"],

