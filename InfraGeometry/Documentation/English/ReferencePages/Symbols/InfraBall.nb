Cell[TextData[{
 "The two measures of the balls about the centres of the square, the \
triangular and the hexagonal tiling, left to right, as points, against the \
lattice counts ",
 StyleBox["L(r)", "TI"],
 " and ",
 StyleBox["L(r \[Minus] 1)", "TI"],
 ", as curves. At ",
 StyleBox["r = 0", "TI"],
 " the Riemannian measure is 0."
}], "ExampleText",ExpressionUUID->"5d63bca7-e55d-4d6f-b41c-1eb68f288328"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", "[", 
  RowBox[{"MapThread", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"substrate", ",", " ", "ballCount"}], "}"}], " ", "|->", " ", 
     RowBox[{"Show", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"{", 
           RowBox[{"ballCount", ",", " ", 
            RowBox[{"ConditionalExpression", "[", 
             RowBox[{
              RowBox[{"ballCount", " ", "/.", " ", 
               RowBox[{"r", " ", "->", " ", 
                RowBox[{"r", " ", "-", " ", "1"}]}]}], ",", " ", 
              RowBox[{"r", " ", ">=", " ", "1"}]}], "]"}]}], "}"}], "]"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}], ",", 
       "\n", "    ", 
       RowBox[{"ListPlot", "[", "\n", "      ", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"substrate", ",", " ", 
             RowBox[{"InfraBall", "[", 
              RowBox[{
               RowBox[{"First", " ", "@", " ", 
                RowBox[{"GraphCenter", "[", "substrate", "]"}]}], ",", " ", 
               "r"}], "]"}], ",", " ", "measure"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"measure", ",", " ", 
             RowBox[{"{", 
              
              RowBox[{"\"\<CountingMeasure\>\"", ",", 
               " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"r", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}], ",", 
         "\n", "      ", 
         RowBox[{"DataRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "6"}], "}"}]}], ",", " ", 
         RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}]}], "]"}]}], 
      "]"}]}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"#", ",", " ", "\"\<Medium\>\""}], "]"}], " ", "&"}], " ", "/@",
        " ", 
       RowBox[{"{", 
        RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
         " ", "\"\<TriangularTilingGraph\>\"", ",", 
         " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], ",", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"r", "^", "2"}]}], " ", "+", " ", 
         RowBox[{"2", " ", "r"}], " ", "+", " ", "1"}], ",", " ", 
        RowBox[{
         RowBox[{"3", " ", 
          RowBox[{"r", "^", "2"}]}], " ", "+", " ", 
         RowBox[{"3", " ", "r"}], " ", "+", " ", "1"}], ",", " ", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"3", " ", "r", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"r", " ", "+", " ", "1"}], ")"}], "/", "2"}]}]}]}], 
       "}"}]}], "}"}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ededa881-20e0-416c-8b56-b4f541c77ce9"],

