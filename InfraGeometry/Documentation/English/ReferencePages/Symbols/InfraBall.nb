Cell[TextData[{
 "Inside a scene the token names the ball about a point, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraInstance"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraInstance", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "05b2cd73-27e9-40b5-84d3-1ea71386aaad"],
 " binds it to the same vertex set."
}], "ExampleText",ExpressionUUID->"54309aa1-01ae-448c-8631-14bfaae9867e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"pA", ",", " ", "ballA"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"constr", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "ballA"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "c", "]"}]}], ",", " ", 
         RowBox[{"ballA", " ", "==", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"pA", ",", " ", "2"}], "]"}]}]}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"InfraSceneInstance", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"RandomInfraInstance", "[", " ", 
         RowBox[{"constr", ",", " ", "g", ",", " ", "All"}], " ", "]"}]}], ",",
        " ", "ballA"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"ball", ",", " ", "c"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"ball", " ", "===", " ", 
      RowBox[{"RandomInfraBall", "[", " ", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{"c", ",", " ", "2"}], "]"}]}], " ", "]"}]}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"af7296da-d6e6-4fee-855e-b98aa2a5d23a"],

