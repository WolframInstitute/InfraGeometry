     RowBox[{
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"r", "^", "2"}]}], " ", "+", " ", "1"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "1", ",", " ", "5"}], "}"}]}], "]"}]}]}], 
