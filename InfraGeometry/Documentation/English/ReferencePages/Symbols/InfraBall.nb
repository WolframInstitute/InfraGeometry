Cell[CellGroupData[{
Cell["InfraBall", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2fe311dc-0836-47be-9bf4-fdc8a8e02d78"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["x", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "586255c2-7ad9-412e-a186-ada8c6b402ae"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "04ce13f9-b528-48c9-8522-a16883c77cb1"],
 " is the closed ball of radius ",
 StyleBox["r", "TI"],
 " about the object ",
 StyleBox["x", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"8be0a9ac-4435-4980-a32a-f42c8db47e04"],

Cell[TextData[{
 "Definition: the closed ball of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " is ",
 StyleBox["B_r(c) = {v : d(c, v) \[LessEqual] r}", "TI"],
 "."
}], "Notes",ExpressionUUID->"e87e2863-8837-4bae-b2c6-9d81e32fb481"],

Cell[TextData[{
 Cell[BoxData["InfraBall"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c0b9956-279d-46d5-8a3e-e7e886628570"],
 " is a scene token. It names the ball in a construction ",
 Cell[BoxData[
  RowBox[{"x", " ", "==", " ", 
   RowBox[{"InfraBall", "[", 
    RowBox[{"y", ",", " ", "r"}], "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3961b5b5-7b3e-4ca5-9f99-3356bdae9ebd"],
 ", where ",
 StyleBox["y", "TI"],
 " is an object of the scene, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4617f6a3-64fd-4ac9-850d-008de51d69b0"],
 " solves it: each branch binds ",
 StyleBox["x", "TI"],
 " to the ball about the vertex ",
 StyleBox["y", "TI"],
 " stands for, a sorted vertex list. The ball is unique, so the token adds no \
branches."
}], "Notes",ExpressionUUID->"2abe2849-e999-49f1-abeb-bf538226163d"],

Cell[TextData[{
 "A ball itself is a sorted vertex list, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5758bc45-c74e-4665-9d9c-825edf478938"],
 " computes it. Outside a scene the head is inert, and nothing reads it: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "286d1d45-7447-4aac-ab74-a2b868cabf29"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraVertexList", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "65a9f61e-d2bb-4da5-a3cb-3e6142e7adf7"],
 " take the Euclidean heads, not this one."
}], "Notes",ExpressionUUID->"04d48750-5e0b-4022-8241-1fb220a3de38"],

Cell[TextData[{
 "Balls are the probe of the volume measurements. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallVolumes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallVolumes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6f23e41f-bd3a-48e3-a41a-e8cfb012108d"],
 " counts them at every radius without building them."
}], "Notes",ExpressionUUID->"27d39abf-9e87-417a-b05d-f8b91d78b995"]
}, Open  ]],

