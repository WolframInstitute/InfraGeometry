    BoxData["\"\<CubicGridGraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6c865fc0-8cdb-4339-956a-c8b09fcf03bc"]], "TableText",ExpressionUUID->
     "6dc58b14-f6b7-47d1-8a35-1d839be40836"], Cell[TextData[StyleBox[
    "4/3 r\.b3 + 2r\.b2 + 8/3 r + 1", "TI"]], "TableText",ExpressionUUID->
     "cb562bd2-15c3-471d-9379-2266ea1cc9bf"], Cell[TextData[StyleBox[
    "L(r \[Minus] 1)", "TI"]], "TableText",ExpressionUUID->
