Cell[CellGroupData[{
Cell["InfraBall", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"05d5a9bd-5884-4852-9aee-1ebe5c0c9375"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["x", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46cdcddf-44f4-45b0-9629-9cd168ace0ba"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "97ec518c-f6d8-485e-840d-e98afba26657"],
 " is the closed ball of radius ",
 StyleBox["r", "TI"],
 " about the object ",
 StyleBox["x", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"6ff4b581-4c88-4386-b7c2-975ce7050c10"],

Cell[TextData[{
 "Definition: the closed ball of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " is ",
 StyleBox["B_r(c) = {v : d(c, v) \[LessEqual] r}", "TI"],
 "."
}], "Notes",ExpressionUUID->"8449cc6a-3d6e-4614-ada0-afae1d978b7b"],

Cell[TextData[{
 Cell[BoxData["InfraBall"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f07d741-5205-4257-aedd-a4db9ea7e9c8"],
 " is a scene token. It names the ball in a construction ",
 Cell[BoxData[
  RowBox[{"x", " ", "==", " ", 
   RowBox[{"InfraBall", "[", 
    RowBox[{"y", ",", " ", "r"}], "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc4ee6c6-5deb-4eec-866c-ae2a5cbf9ac0"],
 ", where ",
 StyleBox["y", "TI"],
 " is an object of the scene, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f0374bc6-7a9d-4c9b-be5f-452ef7938ab1"],
 " solves it: each branch binds ",
 StyleBox["x", "TI"],
 " to the ball about the vertex ",
 StyleBox["y", "TI"],
 " stands for, a sorted vertex list. The ball is unique, so the token adds no \
branches."
}], "Notes",ExpressionUUID->"33a810aa-7cc9-4298-974b-78a35a816b3e"],

Cell[TextData[{
 "A ball itself is a sorted vertex list, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "094bc9a1-48dc-42c2-b25d-cd94e4c2d3fd"],
 " computes it. Outside a scene the head is inert, and nothing reads it: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a79f425c-2beb-4e52-9a0a-deecbd1d397b"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraVertexList", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d326a0c8-ae27-40c5-a893-c195acbc9d0f"],
 " take the Euclidean heads, not this one."
}], "Notes",ExpressionUUID->"ff97548c-b89f-451a-a7d4-3d48c2e77d8e"],

Cell[TextData[{
 "Balls are the probe of the volume measurements. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallVolumes"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallVolumes", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8b2f5d0d-2b6c-4cfc-bf2e-b3eb48a49adc"],
 " counts them at every radius without building them."
}], "Notes",ExpressionUUID->"9ab3d79a-48d7-45b5-a033-d96f7aa10227"]
}, Open  ]],

