Cell["\<\
The ball of radius 3 about the centre of the discretized plane, the square \
grid and the hexagonal tiling. The Riemannian measure counts the inner \
vertices, in green; the counting measure adds the boundary, in blue.\
\>", "ExampleText",ExpressionUUID->"3892ee10-2864-4f7f-84b0-9814c5841391"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"ball", " ", "=", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "3"}], "]"}]}],
        "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"support", " ", "=", " ", 
        RowBox[{"Replace", "[", " ", 
         RowBox[{"ball", ",", " ", 
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"token_InfraPoint", " ", ":>", " ", 
             RowBox[{"RandomInfraPoint", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraSegment", " ", ":>", " ", 
             RowBox[{"RandomInfraSegment", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraHalfLine", " ", ":>", " ", 
             RowBox[{"RandomInfraHalfLine", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraInfiniteLine", " ", ":>", " ", 
             RowBox[{"RandomInfraInfiniteLine", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraCircle", " ", ":>", " ", 
             RowBox[{"RandomInfraCircle", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraArc", " ", ":>", " ", 
             RowBox[{"RandomInfraArc", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraRegularPolygon", " ", ":>", " ", 
             RowBox[{"RandomInfraRegularPolygon", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraPlane", " ", ":>", " ", 
             RowBox[{"RandomInfraPlane", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraBall", " ", ":>", " ", 
             RowBox[{"RandomInfraBall", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraShell", " ", ":>", " ", 
             RowBox[{"RandomInfraShell", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraSphere", " ", ":>", " ", 
             RowBox[{"RandomInfraSphere", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraTube", " ", ":>", " ", 
             RowBox[{"RandomInfraTube", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraCylinder", " ", ":>", " ", 
             RowBox[{"RandomInfraCylinder", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraCone", " ", ":>", " ", 
             RowBox[{"RandomInfraCone", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraSolidOfRevolution", " ", ":>", " ", 
             RowBox[{"RandomInfraSolidOfRevolution", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraBallHull", " ", ":>", " ", 
             RowBox[{"RandomInfraBallHull", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraConvexHull", " ", ":>", " ", 
             RowBox[{"RandomInfraConvexHull", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraQuadric", " ", ":>", " ", 
             RowBox[{"RandomInfraQuadric", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraWalk", " ", ":>", " ", 
             RowBox[{"RandomInfraWalk", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraGeodesic", " ", ":>", " ", 
             RowBox[{"RandomInfraGeodesic", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraEllipse", " ", ":>", " ", 
             RowBox[{"RandomInfraEllipse", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraIntersection", " ", ":>", " ", 
             RowBox[{"RandomInfraIntersection", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraUnion", " ", ":>", " ", 
             RowBox[{"RandomInfraUnion", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraRay", " ", ":>", " ", 
             RowBox[{"RandomInfraHalfLine", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraLine", " ", ":>", " ", 
             RowBox[{"RandomInfraInfiniteLine", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraPolygon", " ", ":>", " ", 
             RowBox[{"RandomInfraRegularPolygon", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}]}], " ", "}"}]}], 
         " ", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"InfraInterior", "[", 
              RowBox[{"g", ",", " ", "support"}], "]"}], " ", "->", " ", 
             "StandardGreen"}], ",", " ", 
            RowBox[{
             RowBox[{"InfraBoundary", "[", 
              RowBox[{"g", ",", " ", "support"}], "]"}], " ", "->", " ", 
             "StandardBlue"}]}], "}"}]}], "]"}], ",", "\n", "      ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", "ball", ",", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<CountingMeasure\>\"", ",", 
            " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "]"}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f39f7cd9-0c84-4690-8ece-e4e4a8f5d073"],

