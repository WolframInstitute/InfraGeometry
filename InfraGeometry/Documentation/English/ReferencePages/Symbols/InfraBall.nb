Notebook[{

Cell[CellGroupData[{
Cell["InfraBall", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"de31b19f-956f-4d3e-bd6a-7cf79bf35e68"],
 Cell[BoxData[
  RowBox[{"InfraBall", "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07b8408d-4175-474b-8b3f-5259746fdc93"],
 "\[LineSeparator]",
 "is the closed ball of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 ": the vertices at distance at most ",
 StyleBox["r", "TI"],
 ". It is inert; ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f21d0c8-317f-4091-aa2b-cbf38d6e17be"],
 " and ",
 Cell[BoxData["FindInfraRepresentative"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca7b77eb-68ab-4d67-a3d3-8ea1054c3524"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c094d538-a849-4866-baee-09731f843e78"],
 Cell[BoxData[
  RowBox[{"InfraBall", "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11bb6e04-1ca7-435a-a38c-ae2dcf9125db"],
 "\[LineSeparator]",
 "is the shell: the vertices at distance between ",
 StyleBox["r", "TI"],
 " and ",
 StyleBox["s", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"020b41ae-fb77-40a2-9442-a18891ea77a6"],
 Cell[BoxData[
  RowBox[{"InfraBall", "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bfcd3524-563d-46a4-bda3-a8b0a57964ed"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData["InfraScene"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1aaaca5c-49be-41b6-b3fd-22ce113cbf1e"],
 " is the ball construction token."
}], "Usage",ExpressionUUID->"1b1ae3d2-ba4e-479f-b60e-21e91dd01c68"],

Cell[TextData[{
 "Definition: the closed ball of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " is ",
 StyleBox["B_r(c) = {v : d(c, v) \[LessEqual] r}", "TI"],
 ". ",
 StyleBox["c", "TI"],
 " is a vertex or a vertex list, and then ",
 StyleBox["d(v, C) = min d(v, c)", "TI"],
 " and the ball is the ",
 StyleBox["r", "TI"],
 "-neighbourhood of ",
 StyleBox["C", "TI"],
 "."
}], "Notes",ExpressionUUID->"44d68f86-574c-4869-a24e-a0cb4cbe7520"],

Cell[TextData[{
 "The ball is not round. On a lattice it is the unit ball of the path metric \
scaled by ",
 StyleBox["r", "TI"],
 ": a square standing on a corner on the square grid, a hexagon on the \
hexagonal tiling."
}], "Notes",ExpressionUUID->"27a25a09-5ab8-47da-a57c-1a687f029f46"],

Cell[TextData[{
 "Its boundary is not negligible. The vertices at distance exactly ",
 StyleBox["r", "TI"],
 " are a share of order ",
 StyleBox["1/r", "TI"],
 " of the ball, so the volume of a ball depends on whether they count. ",
 Cell[BoxData["InfraMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8437093-c248-4576-a1de-2f084e9e9013"],
 " gives both:"
}], "Notes",ExpressionUUID->"9badbb47-1f8a-439a-a9ac-b5f4a0ea94a2"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "462ba8f1-6fee-4d1d-bb93-aca96d612462"], Cell["Measure", "TableText",
     FontWeight->Bold,ExpressionUUID->"6a2e4a56-1700-47f6-bddd-c6b9780afaf2"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"48410011-f6f5-4f70-9dfc-64cc3c50715e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "edd1d5c5-5e7b-463b-9636-69905fe3b3cc"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ed42269e-9f38-4ad7-903f-a970fb8fe88f"]], "TableText",ExpressionUUID->
     "0661299e-bd4c-4f93-9271-e8625c8417c6"], Cell[TextData[{
     StyleBox["|B_r(c)|", "TI"],
     ", the number of vertices of the ball"
    }], "TableText",ExpressionUUID->"26a8f288-258a-4426-9ba8-2c954b07730c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "10505ed0-33d2-4b91-bf20-02d3c2b83a13"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d90fab91-89ca-41e3-b32b-039b279b54c1"]], "TableText",ExpressionUUID->
     "d9399992-023d-49fd-83c8-fc4847e801fe"], Cell["\<\
the number of vertices of the ball all of whose neighbours lie in the ball: \
the count without the boundary\
\>", "TableText",ExpressionUUID->"99a8bec7-f0e3-4652-8c36-3d9e91be8530"]}
  }]], "2ColumnTableMod",ExpressionUUID->"1f70fdab-51c3-477e-9e3a-\
9201f3c5e216"],

Cell[TextData[{
 "The Riemannian measure of ",
 StyleBox["B_r(c)", "TI"],
 " for ",
 StyleBox["r \[GreaterEqual] 1", "TI"],
 " counts ",
 StyleBox["B_(r\[Minus]1)(c)", "TI"],
 " and the vertices at distance ",
 StyleBox["r", "TI"],
 " that have no neighbour at distance ",
 StyleBox["r + 1", "TI"],
 ". At ",
 StyleBox["r = 0", "TI"],
 " it is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e393eef1-ee67-4374-baf3-c2e0ba56a09c"],
 ": the centre has a neighbour outside. On the square and the triangular \
grids, away from the rim, no vertex at distance ",
 StyleBox["r", "TI"],
 " lacks a neighbour farther out, so the Riemannian profile over ",
 StyleBox["r", "TI"],
 " is the counting profile one radius later; on the hexagonal tiling this is \
measured, not proved. On an irregular mesh the extra vertices appear."
}], "Notes",ExpressionUUID->"8a5214b0-5f51-4da3-a00c-032fd8d3accb"],

Cell[TextData[{
 "On a lattice both measures are polynomials in ",
 StyleBox["r", "TI"],
 ". The counting measure is the number of lattice points in the ball of the \
path metric, a polygon or a polyhedron; the Riemannian measure is the same \
polynomial at ",
 StyleBox["r \[Minus] 1", "TI"],
 ":"
}], "Notes",ExpressionUUID->"3cc0923e-255e-4a45-95ac-15b1566d9059"],

Cell[BoxData[GridBox[{
   {Cell["Lattice", "TableText",
     FontWeight->Bold,ExpressionUUID->"f4a4cac6-6f16-41ea-bb18-fd619bc744ec"],
     Cell["Substrate", "TableText",
     FontWeight->Bold,ExpressionUUID->"6cc1fc05-5c30-401c-a9e4-0a7026bb4acd"],
     Cell[TextData[{
     Cell[BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "d240f0a1-4eaa-45e7-b4b6-095003971930"],
     " ",
     StyleBox["L(r)", "TI"]
    }], "TableText",
     FontWeight->Bold,ExpressionUUID->"6a9140c9-8a5b-4379-921b-7c3ee7cd581f"],
     Cell[TextData[{
     Cell[BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ba479b0f-24b7-40a5-a41e-c23199d1cb85"],
     ", ",
     StyleBox["r \[GreaterEqual] 1", "TI"]
    }], "TableText",
     FontWeight->Bold,ExpressionUUID->"b8f6f4da-1cea-413d-a4f1-225712afb85b"]},
   {Cell[TextData[StyleBox[
    "Z\.b2", "TI"]], "TableText",ExpressionUUID->
     "93eb6c84-568f-4033-bf01-0c042aa11a72"], Cell[TextData[Cell[
    BoxData["\"\<SquareTilingGraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c6060960-77da-4605-a1b2-92f698bc7916"]], "TableText",ExpressionUUID->
     "fbaf2771-b4d9-437e-96eb-de057fa9fff9"], Cell[TextData[StyleBox[
    "2r\.b2 + 2r + 1", "TI"]], "TableText",ExpressionUUID->
     "6b6321c2-9530-4640-b84c-f7e9c4d194d6"], Cell[TextData[StyleBox[
    "2r\.b2 \[Minus] 2r + 1", "TI"]], "TableText",ExpressionUUID->
     "eef421b6-951c-4dbf-95d6-f4a649509f1f"]},
   {Cell[TextData[StyleBox[
    "Z\.b3", "TI"]], "TableText",ExpressionUUID->
     "3f259e2b-8cd0-42ec-8e62-a97ff8d86607"], Cell[TextData[Cell[
    BoxData["\"\<CubicGridGraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "77a79377-fa27-4c12-ba04-f3af1fc3f778"]], "TableText",ExpressionUUID->
     "3f66c12d-f791-4ec5-a242-1344c1d2e64b"], Cell[TextData[StyleBox[
    "4/3 r\.b3 + 2r\.b2 + 8/3 r + 1", "TI"]], "TableText",ExpressionUUID->
     "a5fbda9c-3f5b-4131-8246-2ae09ac76875"], Cell[TextData[StyleBox[
    "L(r \[Minus] 1)", "TI"]], "TableText",ExpressionUUID->
     "1bc8e0d6-9e7f-4a8c-814c-fea3c4562a5d"]},
   {Cell["triangular", "TableText",ExpressionUUID->
     "fb8d85ae-38b4-49a8-9dd3-8f06359702d5"], Cell[TextData[Cell[
    BoxData["\"\<TriangularTilingGraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1d2a83f4-d29b-4ed4-ab41-f5a628c0364a"]], "TableText",ExpressionUUID->
     "413639d8-e13d-4825-9960-9eebc275f3e3"], Cell[TextData[StyleBox[
    "3r\.b2 + 3r + 1", "TI"]], "TableText",ExpressionUUID->
     "1874f4ed-a7fc-4001-971f-a1f53d803ba6"], Cell[TextData[StyleBox[
    "3r\.b2 \[Minus] 3r + 1", "TI"]], "TableText",ExpressionUUID->
     "d79a5c0e-6b40-48fc-b7fb-bef4c4b05d39"]},
