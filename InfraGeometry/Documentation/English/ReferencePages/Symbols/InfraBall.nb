Cell[TextData[{
 "The ball bound in the scene is the one ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "60206133-f813-4151-8372-bedc8fd2e340"],
 " computes."
}], "ExampleText",ExpressionUUID->"b462f758-7352-4587-9c5c-0f96cc219c26"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"pA", ",", " ", "ballA"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"constr", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "ballA"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "41", "]"}]}], ",", " ", 
         RowBox[{"ballA", " ", "==", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"pA", ",", " ", "2"}], "]"}]}]}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{
    RowBox[{"InfraSceneInstance", "[", 
     RowBox[{
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindInfraScene", "[", 
        RowBox[{"constr", ",", " ", "g"}], "]"}]}], ",", " ", "ballA"}], 
     "]"}], " ", "===", " ", 
    RowBox[{"FindInfraBall", "[", 
     RowBox[{"g", ",", " ", "41", ",", " ", "2"}], "]"}]}]}], "]"}]}], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"48b73a17-0b2c-489d-8026-a95dfecafc18"],

