Cell[CellGroupData[{
Cell["InfraBall", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"69216886-5a25-41f6-8dc2-fd86958372d2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b51a80a-9c91-4cb3-b6ad-61938a2f8a9b"],
 "\[LineSeparator]",
 "is the closed ball of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 ": the vertices at distance at most ",
 StyleBox["r", "TI"],
 ". It is a symbolic object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cc1e421a-0d2b-410e-9f79-92ebc3b4df84"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraBall"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraBall", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0402b3e6-88b8-4695-8846-54f6102ebb61"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e6b61aa9-c1c8-436e-8650-c47d655db7fb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb813012-a6c0-495f-907e-f5b7648927ea"],
 "\[LineSeparator]",
 "is the shell: the vertices at distance between ",
 StyleBox["r", "TI"],
 " and ",
 StyleBox["s", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"449772a7-9c61-40fb-97d8-4904687cfb0b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fcb3611-a36d-4291-b0b4-4fc6bb755f67"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "62186708-1d1f-49c5-9803-9b07f20e798a"],
 " is the ball construction token."
}], "Usage",ExpressionUUID->"4cf27bfa-7d50-4c46-ac83-f4d20ff43282"],

Cell[TextData[{
 "Definition: the closed ball of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " is ",
 StyleBox["B_r(c) = {v : d(c, v) \[LessEqual] r}", "TI"],
 ". ",
 StyleBox["c", "TI"],
 " is a vertex or a vertex list, and then ",
 StyleBox["d(v, C) = min d(v, c)", "TI"],
 " and the ball is the ",
 StyleBox["r", "TI"],
 "-neighbourhood of ",
 StyleBox["C", "TI"],
 "."
}], "Notes",ExpressionUUID->"7be65e72-bab0-4209-983b-933bc8ae9f26"],

Cell[TextData[{
 "The ball is not round. On a lattice it is the unit ball of the path metric \
scaled by ",
 StyleBox["r", "TI"],
 ": a square standing on a corner on the square grid, a hexagon on the \
hexagonal tiling."
}], "Notes",ExpressionUUID->"a5ad8895-a0a4-488b-9fb2-6c863f8dbac4"],

Cell[TextData[{
 "Its boundary is not negligible. The vertices at distance exactly ",
 StyleBox["r", "TI"],
 " are a share of order ",
 StyleBox["1/r", "TI"],
 " of the ball, so the volume of a ball depends on whether they count. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4c708b44-fa55-401a-9734-a2bcd840d8aa"],
 " gives both:"
}], "Notes",ExpressionUUID->"6fe66238-2b0d-4f48-a213-a6596e756a5d"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ccabcc51-816f-4057-b606-4c8e75e15f46"], Cell["Measure", "TableText",
     FontWeight->Bold,ExpressionUUID->"681385eb-3fee-4dd0-a207-affcca2b8aa6"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"f4fc6385-5ff4-4452-9950-8d72d87fed8f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fa6d7452-af49-4a0b-845e-7b22369f05f2"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3390f186-f832-4f94-ba50-a22fe4b99a94"]], "TableText",ExpressionUUID->
     "2e60e840-1df6-44e8-8d8d-5bc4f96e040e"], Cell[TextData[{
     StyleBox["|B_r(c)|", "TI"],
     ", the number of vertices of the ball"
    }], "TableText",ExpressionUUID->"9dfe0e5a-e894-4986-ae2e-cdeea71be24f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "487bd27f-26f6-48be-89c0-4a7fad75ed07"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0849d1df-a578-4fbd-93f8-1b218ca714af"]], "TableText",ExpressionUUID->
     "19787b58-9395-4440-99ac-27f1c0a06ede"], Cell["\<\
the number of vertices of the ball all of whose neighbours lie in the ball: \
the count without the boundary\
\>", "TableText",ExpressionUUID->"1644ab35-1eac-4b14-a14e-520517c48ca5"]}
  }]], "2ColumnTableMod",ExpressionUUID->"0b332ddc-5956-4893-95fa-\
ee7561c73a58"],

Cell[TextData[{
 "The Riemannian measure of ",
 StyleBox["B_r(c)", "TI"],
 " for ",
 StyleBox["r \[GreaterEqual] 1", "TI"],
 " counts ",
 StyleBox["B_(r\[Minus]1)(c)", "TI"],
 " and the vertices at distance ",
 StyleBox["r", "TI"],
 " that have no neighbour at distance ",
 StyleBox["r + 1", "TI"],
 ". At ",
 StyleBox["r = 0", "TI"],
 " it is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20a05f42-a8c6-4127-875d-a7151579dda3"],
 ": the centre has a neighbour outside. On the square and the triangular \
grids, away from the rim, no vertex at distance ",
 StyleBox["r", "TI"],
 " lacks a neighbour farther out, so the Riemannian profile over ",
 StyleBox["r", "TI"],
 " is the counting profile one radius later; on the hexagonal tiling this is \
measured, not proved. On an irregular mesh the extra vertices appear."
}], "Notes",ExpressionUUID->"4f78336b-9226-48fa-99b9-774b81824a5e"],

Cell[TextData[{
 "On a lattice both measures are polynomials in ",
 StyleBox["r", "TI"],
 ". The counting measure is the number of lattice points in the ball of the \
path metric, a polygon or a polyhedron; the Riemannian measure is the same \
polynomial at ",
 StyleBox["r \[Minus] 1", "TI"],
 ":"
}], "Notes",ExpressionUUID->"ab3b53fa-096e-4a23-a550-c1477a76b602"],

Cell[BoxData[GridBox[{
   {Cell["Lattice", "TableText",
     FontWeight->Bold,ExpressionUUID->"fa1654fd-e342-474d-a91c-5da9453c77bc"],
     Cell["Substrate", "TableText",
     FontWeight->Bold,ExpressionUUID->"13c46357-6c3c-452e-86eb-940106caadae"],
     Cell[TextData[{
     Cell[BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c8d66978-e29d-4ff2-8c42-bb28c75fc92b"],
     " ",
     StyleBox["L(r)", "TI"]
    }], "TableText",
     FontWeight->Bold,ExpressionUUID->"27061499-0074-439d-9c96-08f626639794"],
