Cell["\<\
The ball is the union of the shells up to its radius, so its counting measure \
is the running total of the shell areas.\
\>", "ExampleText",ExpressionUUID->"4c10fe7d-fcbf-4605-a0a1-5803e6c08998"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"volumes", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
         " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"areas", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
         " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"volumes", ",", " ", 
     RowBox[{"Accumulate", "[", "areas", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2dbb6dba-4ca8-42f0-8b6b-ab507ceba4a9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "4", ",", "10", ",", "19", ",", "31", ",", "46"}], 
    "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "4", ",", "10", ",", "19", ",", "31", ",", "46"}], 
    "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"248b90f9-7cd5-4add-b59a-82877ec6c735"]
}, Open  ]],

Cell["\<\
The Riemannian measure of a ball is at least the counting measure of the ball \
one radius smaller. On the discretized plane it is more: the ball of radius 5 \
is drawn with the shell of radius 6 around it, and two vertices of the shell, \
drawn as points, have no neighbour at distance 7, so they lie inside the ball \
of radius 6.\
\>", "ExampleText",ExpressionUUID->"358d7789-4278-49c7-9b91-7759c87c13e8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"inner", " ", "=", " ", 
     RowBox[{"InfraInterior", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"RandomInfraBall", "[", " ", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "6"}], "]"}]}], " ", "]"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"smaller", " ", "=", " ", 
     RowBox[{"RandomInfraBall", "[", " ", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{"c", ",", " ", "5"}], "]"}]}], " ", "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"smaller", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "6"}], "]"}], ",", " ", 
         RowBox[{"Complement", "[", 
          RowBox[{"inner", ",", " ", "smaller"}], "]"}]}], "}"}]}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{"c", ",", " ", "6"}], "]"}], ",", 
       " ", "\"\<RiemannianMeasure\>\""}], "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{"c", ",", " ", "5"}], "]"}], ",", 
       " ", "\"\<CountingMeasure\>\""}], "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"a9bd86bf-7836-492c-8b07-dda59964a930"],

