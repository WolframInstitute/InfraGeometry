Cell[TextData[{
 "The two measures against the radius on the square grid, ",
 StyleBox["2r\.b2 + 2r + 1", "TI"],
 " and ",
 StyleBox["2r\.b2 \[Minus] 2r + 1", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"a2a3455f-64f7-44b3-ae47-72131f0dc1c0"],

