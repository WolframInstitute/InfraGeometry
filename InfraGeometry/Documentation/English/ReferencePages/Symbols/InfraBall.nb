Cell["\<\
Past the eccentricity the ball is the whole graph, and the Riemannian measure \
counts every vertex: the rim of the graph is not a boundary of the ball.\
\>", "ExampleText",ExpressionUUID->"25dffee2-6101-48e8-87ec-a235019f65b8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "20"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"\"\<CountingMeasure\>\"", ",", 
         " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"VertexCount", "[", "g", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"81160e6c-1629-4dbb-a3fe-6251c13aad17"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"CountingMeasure\"\>", "\[Rule]", "109"}], ",", 
     RowBox[{"\<\"RiemannianMeasure\"\>", "\[Rule]", "109"}]}], 
    "\[RightAssociation]"}], ",", "109"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"1b164c87-db64-4574-b150-c1508e54738b"]
}, Open  ]]
}, Open  ]],

