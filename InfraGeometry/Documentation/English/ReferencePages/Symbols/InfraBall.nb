Cell["\<\
A ball about a point that is itself a choice gives one ball per choice: here \
one for each vertex at distance 2 from the centre. The balls are drawn \
summed, with the size of each.\
\>", "ExampleText",ExpressionUUID->"063dd5fe-42c3-40d7-aba5-9375f9ac4558"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"pA", ",", " ", "pB", ",", " ", "ballB"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"constr", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "pB", ",", " ", "ballB"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "c", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", 
           RowBox[{"pA", ",", " ", "2"}], "]"}]}], ",", " ", 
         RowBox[{"ballB", " ", "==", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{"pB", ",", " ", "1"}], "]"}]}]}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"balls", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraSceneInstance", "[", 
        RowBox[{"#", ",", " ", "ballB"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"FindInfraScene", "[", 
       RowBox[{"constr", ",", " ", "g"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"balls", " ", "->", " ", "$InfraBallColor"}], ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "c"}],
         "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Length", " ", "/@", " ", "balls"}]}], "}"}]}], "]"}]}], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"fc392dba-6bbe-40a4-9497-2789d1037bc2"],

