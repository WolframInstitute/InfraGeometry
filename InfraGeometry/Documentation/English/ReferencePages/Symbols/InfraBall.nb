Cell["\<\
The ball is the union of the shells up to its radius, so its counting measure \
is the running total of the shell areas.\
\>", "ExampleText",ExpressionUUID->"7735e3cd-cf91-4153-b594-575444c0f717"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Medium\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"volumes", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
         " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"areas", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
         " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"volumes", ",", " ", 
     RowBox[{"Accumulate", "[", "areas", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3ab04ef8-0d00-4594-8ae8-5f591f48c473"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "4", ",", "10", ",", "19", ",", "31", ",", "46"}], 
    "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "4", ",", "10", ",", "19", ",", "31", ",", "46"}], 
    "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"de9f8972-b14c-4900-8fc5-03af6efa61bd"]
}, Open  ]],

Cell["\<\
The Riemannian measure of a ball is at least the counting measure of the ball \
one radius smaller. On the discretized plane it is more: the ball of radius 5 \
is drawn with the shell of radius 6 around it, and two vertices of the shell, \
drawn as points, have no neighbour at distance 7, so they lie inside the ball \
of radius 6.\
\>", "ExampleText",ExpressionUUID->"b6f8abea-e020-4f87-a1fa-4d276a783ad1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
