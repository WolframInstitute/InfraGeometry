Cell[CellGroupData[{
Cell["InfraBall", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0b42d32b-7000-4b77-b99b-d2748bb5e652"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3238de31-2c2a-412d-96df-aa96a8b8a408"],
 "\[LineSeparator]",
 "is the closed ball of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 ": the vertices at distance at most ",
 StyleBox["r", "TI"],
 ". It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "961470d3-a1e1-4103-a1bc-1cacdf955af4"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c7ff1ae5-1083-4738-b66d-f83b6fb5254e"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6a4d71d0-0413-44a3-8527-935ded3b45f6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48701b71-56de-43c4-8cad-49d478e229a9"],
 "\[LineSeparator]",
 "is the shell: the vertices at distance between ",
 StyleBox["r", "TI"],
 " and ",
 StyleBox["s", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6ff691f5-65a9-45ba-b104-15c60fb24306"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4444b8ab-13e0-45d4-84d9-34dda209662b"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d11229b5-c35d-4eba-b7e5-d72e50ca8fa8"],
 " is the ball construction token."
}], "Usage",ExpressionUUID->"6ed10475-d4ee-46a9-9c51-ab93cebeeff7"],

Cell[TextData[{
 "Definition: the closed ball of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " is ",
 StyleBox["B_r(c) = {v : d(c, v) \[LessEqual] r}", "TI"],
 ". ",
 StyleBox["c", "TI"],
 " is a vertex or a vertex list, and then ",
 StyleBox["d(v, C) = min d(v, c)", "TI"],
 " and the ball is the ",
 StyleBox["r", "TI"],
 "-neighbourhood of ",
 StyleBox["C", "TI"],
 "."
}], "Notes",ExpressionUUID->"735f16f8-a05f-49ad-ad34-ee07e42d2167"],

Cell[TextData[{
 "The head holds the centre and the radius and computes nothing. A ball has \
one member, the vertex set, so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bbc34c9a-42d9-4427-9513-6118bac49f32"],
 " gives it as a sorted vertex list and ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "116d77d0-6d89-4bb7-9b48-8e3a1c21f63a"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "149a6278-b03d-4e3d-82c2-8cd6917a9b09"],
 "."
}], "Notes",ExpressionUUID->"03674532-18e3-43b9-a44a-b3d8687e0bbe"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "522dc22e-7b60-4ef4-a680-e7572dd41be3"],
 " reads nine properties: ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f05be51f-f6a4-4788-ac84-f1e5ae8f819c"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f95252da-6168-42a4-9d7e-2fdd4ae3c7d7"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7a46fc1-1e74-4d54-a354-00d4eec39bc8"],
 ", ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd7d9045-c0e9-4e9d-86c0-c06f83260425"],
 ", ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd3faf87-7172-4869-8ac8-36520962659e"],
 " and the four volumes ",
 Cell[BoxData["\"\<Volume\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f69f8e3d-220c-4745-b467-fdae9531ac8f"],
 ", ",
 Cell[BoxData["\"\<BoundaryVolume\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d06191c1-ee58-4024-953e-651df2e1de0c"],
 ", ",
 Cell[BoxData["\"\<InteriorVolume\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c56a316e-1cb4-4dcf-a08c-352981af2b0f"],
 ", ",
 Cell[BoxData["\"\<HalfBoundaryVolume\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b7b0c16-7553-4d4e-abb4-05eaaa4d217a"],
 ". A ball has no ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40b7e906-23a1-4037-9912-16294acc8932"],
 " and no ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e3059ed-c36b-4e3a-9abf-36115060f1f9"],
 "; asking for them leaves the call unevaluated."
}], "Notes",ExpressionUUID->"67c074ce-92d9-4cdb-9f89-2dc9d051b490"],

Cell[TextData[{
 "A radius past the eccentricity gives the whole graph; a band with ",
 StyleBox["r > s", "TI"],
 " gives the empty set."
}], "Notes",ExpressionUUID->"d46b5e4f-7529-4bc3-be74-293e72592481"],

