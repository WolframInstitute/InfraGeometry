    "Z\.b2", "TI"]], "TableText",ExpressionUUID->
     "0230adb4-3250-4075-8696-601ce5fe6b3b"], Cell[TextData[Cell[
    BoxData["\"\<SquareTilingGraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7dbc17fe-0150-4938-917c-a74477a584eb"]], "TableText",ExpressionUUID->
     "1846a393-9d69-42f6-9000-5ce4b552c75d"], Cell[TextData[StyleBox[
    "2r\.b2 + 2r + 1", "TI"]], "TableText",ExpressionUUID->
     "54f90865-fc5f-4eeb-88b1-dacd99123392"], Cell[TextData[StyleBox[
    "2r\.b2 \[Minus] 2r + 1", "TI"]], "TableText",ExpressionUUID->
     "33b46fd5-52ac-41e0-bec1-b3cb0349c9ce"]},
   {Cell[TextData[StyleBox[
    "Z\.b3", "TI"]], "TableText",ExpressionUUID->
