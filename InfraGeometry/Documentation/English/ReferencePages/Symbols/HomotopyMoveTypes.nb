Cell["\<\
The chain between the two shortest paths around a pair of triangles of the \
mesh goes up and comes down:\
\>", "ExampleText",ExpressionUUID->"be8e4d58-b71e-41ba-9a52-c7f1d953e503"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"HomotopyMoveTypes", " ", "@", " ", 
    RowBox[{"FindInfraHomotopy", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"First", " ", "@", " ", "members"}], ",", " ", 
      RowBox[{"Last", " ", "@", " ", "members"}]}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"f1c4effd-4682-4e05-a700-8cb53415b3a0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Extend\"\>", ",", "\<\"Contract\"\>"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b5632171-1855-4d63-94fc-b53f122fed70"]
}, Open  ]],

Cell["A chain of vertex lists:", "ExampleText",ExpressionUUID->"899e0839-13d8-41b8-80a5-dbfd8fca03e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HomotopyMoveTypes", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2", ",", " ", "1", ",", " ", "3"}], "}"}], ",", 
    " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "4", ",", " ", "3"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "5", ",", " ", "3"}], "}"}]}], "}"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8538d47f-bf19-46a0-9a4f-3fbd57da9075"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Contract\"\>", ",", "\<\"Extend\"\>", ",", "\<\"Lateral\"\>"}],
   "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"c49d90cf-9af4-4be9-a1ba-03643819eebd"]
}, Open  ]]
}, Open  ]],

