Cell["\<\
The chain between the two shortest paths around a pair of triangles of the \
mesh goes up and comes down:\
\>", "ExampleText",ExpressionUUID->"0b2369ee-9a48-4838-a591-7e08c390e5ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"HomotopyMoveTypes", " ", "@", " ", 
    RowBox[{"FindInfraHomotopy", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"First", " ", "@", " ", "members"}], ",", " ", 
      RowBox[{"Last", " ", "@", " ", "members"}]}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"0975db45-6c2c-456d-8251-e0e0a863a7bb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Extend\"\>", ",", "\<\"Contract\"\>"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6ab36904-a217-4f39-86f3-9bee9394cd35"]
}, Open  ]],

Cell["A chain of vertex lists:", "ExampleText",ExpressionUUID->"97a2ee71-65d6-474a-9dc8-915fe94900e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HomotopyMoveTypes", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2", ",", " ", "1", ",", " ", "3"}], "}"}], ",", 
    " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "4", ",", " ", "3"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "5", ",", " ", "3"}], "}"}]}], "}"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d59e0412-8dfa-4252-9414-732bb9bb7a7d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Contract\"\>", ",", "\<\"Extend\"\>", ",", "\<\"Lateral\"\>"}],
   "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"8183ee58-1f8d-4c50-8bcf-e0bbb4ce001b"]
}, Open  ]]
}, Open  ]],

