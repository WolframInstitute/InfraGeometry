Cell["\<\
A list of chains. With the squares of the grid filled, the two shortest paths \
across a square are joined by one lateral move, either way:\
\>", "ExampleText",ExpressionUUID->"c4ffff9d-6be6-4a52-a56a-5a0719b094a0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", "members"}]}], ",", " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"Last", " ", "@", " ", "members"}]}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"HomotopyMoveTypes", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"FindInfraHomotopy", "[", 
       RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", 
        RowBox[{"\"\<NullHomotopicCycles\>\"", " ", "->", " ", "4"}]}], "]"}],
       ",", " ", 
      RowBox[{"FindInfraHomotopy", "[", 
       RowBox[{"g", ",", " ", "b", ",", " ", "a", ",", " ", 
        RowBox[{"\"\<NullHomotopicCycles\>\"", " ", "->", " ", "4"}]}], 
       "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d744a91c-f52f-4b76-bb00-f78f90a101ee"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "\<\"Lateral\"\>", "}"}], ",", 
   RowBox[{"{", "\<\"Lateral\"\>", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"595d2fbc-3c28-4c7b-ad7b-8f3252af2f1a"]
}, Open  ]]
}, Open  ]],

