Cell["\<\
A list of chains. With the squares of the grid filled, the two shortest paths \
across a square are joined by one lateral move, either way:\
\>", "ExampleText",ExpressionUUID->"bc3cd323-41ce-4e71-a6bf-6d67906309d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"First", " ", "@", " ", "members"}]}], ",", " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"Last", " ", "@", " ", "members"}]}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"HomotopyMoveTypes", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"FindInfraHomotopy", "[", 
       RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", 
        RowBox[{"\"\<NullHomotopicCycles\>\"", " ", "->", " ", "4"}]}], "]"}],
       ",", " ", 
      RowBox[{"FindInfraHomotopy", "[", 
       RowBox[{"g", ",", " ", "b", ",", " ", "a", ",", " ", 
        RowBox[{"\"\<NullHomotopicCycles\>\"", " ", "->", " ", "4"}]}], 
       "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"81b6ac9c-6f1e-45dc-ab03-d5b25d2ec5bb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "\<\"Lateral\"\>", "}"}], ",", 
   RowBox[{"{", "\<\"Lateral\"\>", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"af208b8b-12d4-4be2-9b03-b75aec3c1f5c"]
}, Open  ]]
}, Open  ]],

