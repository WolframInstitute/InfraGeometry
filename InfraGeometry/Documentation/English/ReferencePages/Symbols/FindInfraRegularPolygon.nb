Cell["FindInfraRegularPolygon", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fd5e24e1-512b-481c-97b6-f87ac4948aa0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRegularPolygon"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRegularPolygon", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", "As", ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "caf3e97a-ba29-431c-b8ab-0b2e8989da18"],
 "\[LineSeparator]",
 "returns {InfraPolygon[{poly}]} for a length-n cyclic vertex sequence whose \
k-diagonal distances satisfy As[[k]] (slot grammar: Integer exact, {lo, hi} \
constant in range, Automatic any constant; Length[As] <= Floor[n/2]); count / \
UpTo[count] / All controls multiplicity.",
 "\n"
}], "Usage",ExpressionUUID->"def2ed95-7c21-4c9f-9b86-24f034d783d5"],

