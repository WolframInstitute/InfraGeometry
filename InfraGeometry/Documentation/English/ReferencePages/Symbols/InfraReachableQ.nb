Cell["A vertex list is reachable when one of its vertices is:", "ExampleText",ExpressionUUID->"b29d4048-5ecf-4b65-a941-294ca8ca6530"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cut", " ", "=", " ", 
     RowBox[{"VertexDelete", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"#", ",", " ", "10"}], "]"}], " ", "==", " ", "6"}], " ", 
          "&"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraReachableQ", "[", 
      RowBox[{"cut", ",", " ", "45", ",", " ", 
       RowBox[{"{", 
        RowBox[{"47", ",", " ", "48"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"InfraReachableQ", "[", 
      RowBox[{"cut", ",", " ", "45", ",", " ", 
       RowBox[{"{", 
        RowBox[{"47", ",", " ", "43"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d9149a48-839d-4043-b56e-f9f7b6cfcbb7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1ec20ac9-72d2-4092-8f71-daadf39e52c1"]
}, Open  ]],

Cell["A ball lies in one component, however large:", "ExampleText",ExpressionUUID->"d9b8e203-0d03-4d72-acbd-4ecf57c59dbc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
