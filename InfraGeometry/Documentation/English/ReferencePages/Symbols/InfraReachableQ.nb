Cell["\<\
The square grid cut along the column of vertices 6, 16, \[Ellipsis], 96 falls \
into two parts. The vertex 47 lies across the cut from the centre, 43 on the \
same side:\
\>", "ExampleText",ExpressionUUID->"ed2f12b1-e08b-44aa-b209-8d0907200fda"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cut", " ", "=", " ", 
     RowBox[{"VertexDelete", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"#", ",", " ", "10"}], "]"}], " ", "==", " ", "6"}], " ", 
          "&"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"cut", ",", " ", 
        RowBox[{"{", 
         RowBox[{"45", ",", " ", "q"}], "}"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraReachableQ", "[", 
          RowBox[{"cut", ",", " ", "45", ",", " ", "q"}], "]"}]}]}], "]"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"q", ",", " ", 
        RowBox[{"{", 
         RowBox[{"47", ",", " ", "43"}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"626bd44b-22f0-47b0-a05f-78aceddc276e"],

