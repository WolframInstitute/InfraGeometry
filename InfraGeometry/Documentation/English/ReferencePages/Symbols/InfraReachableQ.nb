Cell["For two vertices the test is a finite distance:", "ExampleText",ExpressionUUID->"6775100d-cd05-4aeb-b13e-970ff0e90bb5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cut", " ", "=", " ", 
     RowBox[{"VertexDelete", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"#", ",", " ", "10"}], "]"}], " ", "==", " ", "6"}], " ", 
          "&"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphDistance", "[", 
      RowBox[{"cut", ",", " ", "45", ",", " ", "47"}], "]"}], ",", " ", 
     RowBox[{"GraphDistance", "[", 
      RowBox[{"cut", ",", " ", "45", ",", " ", "43"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"48b4fab9-2e6a-4f78-9bb0-97388cc7b0e8"],

