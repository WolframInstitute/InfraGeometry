Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7d7835d4-99a0-4190-b039-7958816806f2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraReachableQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraReachableQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f48dc7b-4b77-4d39-b1fd-03088b6a856e"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bcb52ef4-1186-45c8-acbb-a86773000031"],
 " if a walk in ",
 StyleBox["g", "TI"],
 " joins a vertex of ",
 StyleBox["p", "TI"],
 " to a vertex of ",
 StyleBox["q", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"62b04032-3fd1-47c8-9542-2fe3f886f261"],

Cell[TextData[{
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " are vertices, vertex lists, regions such as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraBall"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraBall", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "915a7773-8916-4050-8480-f52a24d002bc"],
 ", walks ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["path", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37aa53f1-bfc2-4fcd-a8b0-6231f4054c2b"],
 " or point tokens ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b0e436fb-a068-4c97-8596-fa48abba4bb2"],
 ". The test is whether some vertex of ",
 StyleBox["p", "TI"],
 " and some vertex of ",
 StyleBox["q", "TI"],
 " lie in one connected component of ",
 StyleBox["g", "TI"],
 ", that is ",
 StyleBox["d(u, v) < \[Infinity]", "TI"],
 " for some ",
 StyleBox["u", "TI"],
 " in ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " in ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"08d99bff-9973-41c7-a38b-690e0c4a23c6"],

