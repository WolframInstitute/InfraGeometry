Cell["\<\
A walk and a point token across the cut, and on the same side:\
\>", "ExampleText",ExpressionUUID->"a4895f58-7b8b-4538-9760-6db1ce8cf8ac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cut", " ", "=", " ", 
     RowBox[{"VertexDelete", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"#", ",", " ", "10"}], "]"}], " ", "==", " ", "6"}], " ", 
          "&"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraReachableQ", "[", 
      RowBox[{"cut", ",", " ", 
