Cell[CellGroupData[{
Cell["KillingDisplacementMagnitude", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2f04f4fb-4138-4581-a36e-faf851d61b14"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["KillingDisplacementMagnitude"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/KillingDisplacementMagnitude",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "214288d0-1e78-41a8-b52a-48e40b381738"],
 "\[LineSeparator]",
 "gives the least magnitude of an automorphism of ",
 StyleBox["g", "TI"],
 " other than the identity, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "040ab97f-5a1f-42c8-afbd-24362c8f9ebe"],
 " when ",
 StyleBox["g", "TI"],
 " has none.",
 "\n"
}], "Usage",ExpressionUUID->"e95c3b6d-89cf-466c-adcf-d2c10facf390"],

Cell[TextData[{
 "The value is ",
 StyleBox["min {max_v d(v, \[Sigma](v)) : \[Sigma] \[NotEqual] id an \
automorphism of g}", "TI"],
 ", with the minimum over the empty set ",
 StyleBox["\[Infinity]", "TI"],
 ". It is the magnitude of the displacements ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindKillingDisplacement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindKillingDisplacement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4e147420-89b2-4c09-be0f-bc44a02e5ab9"],
 " gives."
}], "Notes",ExpressionUUID->"1b99d054-ce52-48a1-9f8b-b072d3301527"],

Cell[TextData[{
 "A small value means a symmetry that moves every vertex a little, as the \
flow of a Killing field for a short time does. On a torus the translations by \
one step give 1. A graph with a rim has few symmetries, and a graph without \
symmetry gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "02d008f1-46db-4cc8-bc49-e51b1615c2c2"],
 "."
}], "Notes",ExpressionUUID->"660acd12-c89a-4604-b8e7-360b8b878a35"],

Cell["\<\
The value is at most the diameter of a connected graph with a symmetry.\
\>", "Notes",ExpressionUUID->"5ce34714-118c-4849-b5ff-28538d819d2e"]
}, Open  ]],

