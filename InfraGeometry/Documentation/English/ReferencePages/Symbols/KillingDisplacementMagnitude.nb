Cell["The value is the magnitude of the least automorphism:", "ExampleText",ExpressionUUID->"78c93874-04a7-488e-a999-1795becc2c0a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"KillingDisplacementMagnitude", "[", "g", "]"}], " ", "==", " ", 
    RowBox[{"DisplacementMagnitude", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f4550840-99b3-48e6-ac04-efe4ad653f09"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0bf1caf7-780d-4188-a504-4616d3837bbb"]
}, Open  ]],

Cell["\<\
Without its pendant vertices the grid is an 8 \[Times] 8 grid. Its least \
symmetries move some vertex 7 steps, half its diameter:\
\>", "ExampleText",ExpressionUUID->"477e2b82-da89-4ce8-81f8-40a49e41df60"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"core", " ", "=", " ", 
     RowBox[{"VertexDelete", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"VertexDegree", "[", 
            RowBox[{"g", ",", " ", "#"}], "]"}], " ", "==", " ", "1"}], " ", 
          "&"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"VertexCount", "[", "core", "]"}], ",", " ", 
     RowBox[{"KillingDisplacementMagnitude", "[", "core", "]"}], ",", " ", 
     RowBox[{"GraphDiameter", "[", "core", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"423c815d-01b9-415e-9de6-907588db4bef"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"64", ",", "7", ",", "14"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"db38a8a2-2614-49ae-a54f-105b9ad7a30a"]
}, Open  ]]
}, Open  ]],

