      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<SquareMeshGraph\>\"",
         ",", " ", "\"\<SquareTorusGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2c4dab30-ec82-40cb-a6da-196118fb4423"],

