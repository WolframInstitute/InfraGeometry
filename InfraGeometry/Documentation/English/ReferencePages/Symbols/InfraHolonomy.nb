Cell[TextData[{
 "All holonomies are the identity exactly when ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTrivialMonodromyQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTrivialMonodromyQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "51c165ed-83ff-4f54-abae-dd77af49c1ee"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3b579c8-92c4-4251-b3c7-9073c88c355b"],
 "."
}], "Notes",ExpressionUUID->"6ccf58e6-8e40-4b3c-97da-24906bb8c828"],

Cell[TextData[{
 StyleBox["conn", "TI"],
 " must be a complete connection, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e48db520-c364-42e7-931d-291c6e8a4ffb"],
 " tests, and ",
 StyleBox["loop", "TI"],
 " a closed walk in the base. On a covering the transverse edges are the only \
connection."
}], "Notes",ExpressionUUID->"b1355c89-e5a0-4ef7-bb85-32bc83e449e5"]
}, Open  ]],

