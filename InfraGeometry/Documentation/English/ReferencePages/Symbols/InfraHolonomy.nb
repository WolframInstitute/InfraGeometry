Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}]}], " ", "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"fib", " ", "=", " ", 
      RowBox[{"InfraFiberedGraph", "[", " ", 
       RowBox[{"total", ",", " ", 
        RowBox[{"vertex", " ", "|->", " ", 
         RowBox[{"Mod", "[", " ", 
