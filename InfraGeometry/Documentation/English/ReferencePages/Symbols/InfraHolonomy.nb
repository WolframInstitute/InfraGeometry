Cell["\<\
A walk that does not return to its start is not a loop, and the holonomy \
stays unevaluated:\
\>", "ExampleText",ExpressionUUID->"4ef3de72-38b2-4ea6-aa17-fe9cf5ef6c19"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<CycleDoubleCover\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Head", " ", "@", " ", 
    RowBox[{"InfraHolonomy", "[", 
     RowBox[{"fib", ",", " ", 
      RowBox[{"RandomInfraConnection", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
