Cell["\<\
On the double cover: once around exchanges the sheets, twice around and out \
and back do not:\
\>", "ExampleText",ExpressionUUID->"3e05a61a-1fca-4fb7-8db8-fd4b1579bbaf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<CycleDoubleCover\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"InfraHolonomy", "[", 
      RowBox[{"fib", ",", " ", "conn", ",", " ", "#"}], "]"}], " ", "&"}], 
    " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{"Range", "[", "8", "]"}], ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Range", "[", "8", "]"}], ",", " ", 
        RowBox[{"Range", "[", "8", "]"}], ",", " ", 
        RowBox[{"{", "1", "}"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", "1", "}"}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"49ce2853-adc3-409d-830f-f041dac8fb8b"],

