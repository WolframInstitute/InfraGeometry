Cell["\<\
A covering of the 3 \[Times] 3 grid with three sheets, and the lift from {1, \
1} around the face 1, 2, 5, 4. The label gives the holonomies of the four \
faces:\
\>", "ExampleText",ExpressionUUID->"f1ffe8da-7f43-4cd4-b1c1-41ab7fca79d5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "3", "}"}]}], ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Covering\>\"", "}"}]}], ",", "\n", "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"faces", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "1", ",", " ", "2", ",", " ", "5", ",", " ", "4", ",", " ", "1"}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "2", ",", " ", "3", ",", " ", "6", ",", " ", "5", ",", " ", "2"}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "4", ",", " ", "5", ",", " ", "8", ",", " ", "7", ",", " ", "4"}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "5", ",", " ", "6", ",", " ", "9", ",", " ", "8", ",", " ", "5"}], 
        "}"}]}], "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", 
      RowBox[{"InfraWalk", " ", "@", " ", 
       RowBox[{"InfraHorizontalLift", "[", 
        RowBox[{"fib", ",", " ", "conn", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"First", " ", "@", " ", "faces"}]}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraHolonomy", "[", 
          RowBox[{"fib", ",", " ", "conn", ",", " ", "#"}], "]"}], " ", "&"}],
         " ", "/@", " ", "faces"}], ")"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"bc5e9b64-c7bc-4e3a-a94b-d8ff6446b7b0"],

