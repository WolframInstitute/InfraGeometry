 " made by transport along ",
 StyleBox["loop", "TI"],
 " under the connection ",
 StyleBox["conn", "TI"],
 ", as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Cycles"]], "paclet:ref/Cycles"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
