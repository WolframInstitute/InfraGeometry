Cell["\<\
The index convention is visible when the fiber vertices have a deliberately \
chosen order.\
\>", "ExampleText",ExpressionUUID->"4a69fdf8-af84-45b9-9e89-5273df5e9f5d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"Graph", "[", " ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{
        "1", ",", " ", "7", ",", " ", "4", ",", " ", "2", ",", " ", "3", ",", 
         " ", "5", ",", " ", "6", ",", " ", "8", ",", " ", "9"}], " ", "}"}], 
       ",", " ", 
       RowBox[{"EdgeList", " ", "@", " ", 
        RowBox[{"CycleGraph", "[", " ", "9", " ", "]"}]}]}], " ", "]"}]}], 
    " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"fib", " ", "=", " ", 
      RowBox[{"InfraFiberedGraph", "[", " ", 
       RowBox[{"total", ",", " ", 
        RowBox[{"vertex", " ", "|->", " ", 
         RowBox[{"Mod", "[", " ", 
          RowBox[{"vertex", ",", " ", "3", ",", " ", "1"}], " ", "]"}]}]}], 
       " ", "]"}]}], ",", "\n", "    ", 
     RowBox[{"connection", " ", "=", " ", 
      RowBox[{"InfraConnection", "[", " ", 
       RowBox[{"EdgeList", " ", "@", " ", "total"}], " ", "]"}]}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"InfraFiber", "[", " ", 
       RowBox[{"fib", ",", " ", "1"}], " ", "]"}]}], ",", "\n", "    ", 
     RowBox[{"InfraParallelTransport", "[", " ", 
      RowBox[{"fib", ",", " ", "connection", ",", " ", 
       RowBox[{"{", " ", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "1"}], " ", 
        "}"}]}], " ", "]"}], ",", "\n", "    ", 
     RowBox[{"PermutationList", "[", " ", 
      RowBox[{
       RowBox[{"InfraHolonomy", "[", " ", 
        RowBox[{"fib", ",", " ", "connection", ",", " ", 
         RowBox[{"{", " ", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "1"}], " ", 
          "}"}]}], " ", "]"}], ",", " ", "3"}], " ", "]"}]}], " ", "}"}]}], 
  "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c76c3440-5d23-4eb7-a1ca-2bea5821fb48"],

Cell[BoxData[
 RowBox[{"{", 
