Notebook[{

Cell[CellGroupData[{
Cell["InfraHolonomy", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"46eba94c-03b1-4538-906b-5344e3a88fc9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHolonomy"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHolonomy", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["connection", "TI"], ",", " ", 
    StyleBox["loop", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d53d767-e4f0-4892-a6ef-4c29c9cd63a8"],
 "\[LineSeparator]",
 "gives the permutation induced by transport around a closed base walk, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Cycles"]], "paclet:ref/Cycles"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e580f32b-a1d1-48ae-9c11-c089e462fbfe"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"a75ce768-ae4d-44fe-8ae4-1af47e34a4e7"],

Cell["\<\
The connection must be complete and the loop must be a nonempty valid base \
walk whose first and last vertices agree.\
\>", "Notes",ExpressionUUID->"f4b1afe5-24c4-4008-96dd-1ddcb6374ecc"],

Cell[TextData[{
 "Permutation positions refer to ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["VertexList",
    BaseStyle->"Link"], "[", 
   RowBox[{"InfraFiber", "[", 
    RowBox[{
     StyleBox["fib", "TI"], ",", " ", 
     RowBox[{
      ButtonBox["First",
       BaseStyle->"Link"], "[", 
      StyleBox["loop", "TI"], "]"}]}], "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e2a0210-0e4c-4532-91e5-dd77b6acb82a"],
 ", in that order."
}], "Notes",ExpressionUUID->"f1f587c7-82f1-4d5b-a99c-2a9be831c434"],

Cell[TextData[{
 "A one-vertex loop is the identity permutation, ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Cycles",
    BaseStyle->"Link"], "[", 
   RowBox[{"{", "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9cdced14-6c9b-4b3f-a255-98de1411af20"],
 "."
}], "Notes",ExpressionUUID->"8a6104ee-38f2-4bc7-991d-9bd8d6d05426"],

Cell["\<\
The result is monodromy of the chosen connection. A graph alone supplies no \
faces on which to define curvature.\
\>", "Notes",ExpressionUUID->"628a653a-647c-4b79-b43c-cb18b9e55bae"],

Cell["\<\
The reader consumes no random draws. Unsupported loops and connections remain \
unevaluated.\
\>", "Notes",ExpressionUUID->"eebf4bf2-b71f-4c04-89c4-c0d8bfd9a066"]
}, Open  ]],

