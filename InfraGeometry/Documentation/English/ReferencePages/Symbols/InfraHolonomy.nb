 "\n"
}], "Usage",ExpressionUUID->"8d6e8d2b-f9d2-4fc3-95ed-516b169531ee"],

Cell[TextData[{
 "A complete connection matches the fibers over the two ends of every base \
edge. Following the matchings along a closed walk ",
 StyleBox["\[Gamma]", "TI"],
 " from ",
 StyleBox["p", "TI"],
 " maps ",
 StyleBox["F(p)", "TI"],
 " to itself; this permutation is the holonomy ",
 StyleBox["hol(\[Gamma])", "TI"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraHorizontalLift"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraHorizontalLift", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dc85b6ca-11e9-4e50-bb48-d3e737637901"],
 " gives the lifted walk from one start."
}], "Notes",ExpressionUUID->"341dc351-1bc6-41e3-98df-2625524b8c45"],

Cell[TextData[{
 "The positions in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Cycles"]], "paclet:ref/Cycles"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "74a7fed8-e6cf-47a5-a293-d799d8a13e6f"],
 " refer to ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["VertexList",
    BaseStyle->"Link"], "[", 
   RowBox[{"InfraFiber", "[", 
    RowBox[{
     StyleBox["fib", "TI"], ",", " ", 
