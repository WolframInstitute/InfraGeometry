Cell[CellGroupData[{
Cell["InfraHolonomy", "ObjectName",ExpressionUUID->"8a7782c9-44ee-44ba-b657-ed509aef6b2c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5eaa5aff-92ea-4817-9d82-4cb0649dd7e5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHolonomy"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHolonomy", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["connection", "TI"], ",", " ", 
    StyleBox["loop", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30b9ec7c-62f5-42d3-899c-69957e9d3a71"],
 "\[LineSeparator]",
 "gives the permutation induced by transport around a closed base walk, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Cycles"]], "paclet:ref/Cycles"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "906816c9-0db1-4b00-9130-49a47680ae0c"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"99307521-62d1-47a5-a9aa-016d8568e9a0"],

Cell["\<\
The connection must be complete and the loop must be a nonempty valid base \
walk whose first and last vertices agree.\
\>", "Notes",ExpressionUUID->"e87e02c4-2498-400f-b9f7-a86c546ab814"],

Cell[TextData[{
 "Permutation positions refer to ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["VertexList",
    BaseStyle->"Link"], "[", 
   RowBox[{"InfraFiber", "[", 
    RowBox[{
     StyleBox["fib", "TI"], ",", " ", 
     RowBox[{
      ButtonBox["First",
       BaseStyle->"Link"], "[", 
      StyleBox["loop", "TI"], "]"}]}], "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c35c2528-397a-4ccf-aaa6-0589c293c839"],
 ", in that order."
}], "Notes",ExpressionUUID->"d905a021-63cd-472b-b06b-eb05dea20127"],

Cell[TextData[{
 "A one-vertex loop is the identity permutation, ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Cycles",
    BaseStyle->"Link"], "[", 
   RowBox[{"{", "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "abae637e-bd38-4d1f-b257-2369bce0240e"],
 "."
}], "Notes",ExpressionUUID->"2a21b72f-31b9-4059-8d91-c0cce06faaf5"],

Cell["\<\
The result is monodromy of the chosen connection. A graph alone supplies no \
faces on which to define curvature.\
\>", "Notes",ExpressionUUID->"0e7276e3-e2a2-433e-98d7-80c82632a0d4"],

Cell["\<\
The reader consumes no random draws. Unsupported loops and connections remain \
unevaluated.\
\>", "Notes",ExpressionUUID->"a575cbba-b652-4359-85a8-2848fb8ef442"]
}, Open  ]],

