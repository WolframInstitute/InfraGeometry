 ".",
 "\n"
}], "Usage",ExpressionUUID->"0b6af2bd-8d6f-4ec3-ba31-0146fd19d068"],

Cell[TextData[{
 "A complete connection matches the fibers over the two ends of every base \
edge. Following the matchings along a closed walk ",
 StyleBox["\[Gamma]", "TI"],
 " from ",
 StyleBox["p", "TI"],
 " maps ",
 StyleBox["F(p)", "TI"],
 " to itself; this permutation is the holonomy ",
 StyleBox["hol(\[Gamma])", "TI"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraHorizontalLift"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraHorizontalLift", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f5a87b42-6aa4-425f-9e6b-bf555378d327"],
 " gives the lifted walk from one start."
}], "Notes",ExpressionUUID->"8b4bd18b-6dcb-4401-b356-1f789870b598"],

Cell[TextData[{
 "The positions in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Cycles"]], "paclet:ref/Cycles"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4a35eeab-2df9-4a86-8396-6c804b98d4da"],
 " refer to ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["VertexList",
    BaseStyle->"Link"], "[", 
   RowBox[{"InfraFiber", "[", 
    RowBox[{
     StyleBox["fib", "TI"], ",", " ", 
     StyleBox["p", "TI"]}], "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73454e71-d45d-4752-929e-a40a1e3b012d"],
 "."
}], "Notes",ExpressionUUID->"6e1f2f8f-1f3d-47af-b695-4409dae6e504"],

