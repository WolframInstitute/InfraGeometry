Cell[TextData[{
 "All holonomies are the identity exactly when ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFlatConnectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFlatConnectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a05ece9c-7b9d-4319-a423-3ba382b9e0bd"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52c27e1a-374f-4a84-9a1c-a6233bbcc886"],
 "."
}], "Notes",ExpressionUUID->"ed8c0e3a-884d-40e6-904c-c8e3f52a39c6"],

Cell[TextData[{
 StyleBox["conn", "TI"],
 " must be a complete connection, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraConnectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "26e16ba1-af2e-4b04-84ff-2206192d386a"],
 " tests, and ",
 StyleBox["loop", "TI"],
 " a closed walk in the base. On a covering the transverse edges are the only \
connection."
}], "Notes",ExpressionUUID->"18dd255f-4355-417b-9196-2bc4eb2f8c13"]
}, Open  ]],

