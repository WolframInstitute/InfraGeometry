Cell["\<\
The positions refer to the vertex list of the fiber. The transport around the \
face is the same permutation written on vertices:\
\>", "ExampleText",ExpressionUUID->"09790fda-3532-4b80-85e8-675ee2e30114"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "3", "}"}]}], ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Covering\>\"", "}"}]}], ",", "\n", "    ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"VertexList", " ", "@", " ", 
      RowBox[{"InfraFiber", "[", 
       RowBox[{"fib", ",", " ", "1"}], "]"}]}], ",", " ", 
     RowBox[{"InfraParallelTransport", "[", 
      RowBox[{"fib", ",", " ", "conn", ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "1", ",", " ", "2", ",", " ", "5", ",", " ", "4", ",", " ", "1"}], 
        "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"InfraHolonomy", "[", 
      RowBox[{"fib", ",", " ", "conn", ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "1", ",", " ", "2", ",", " ", "5", ",", " ", "4", ",", " ", "1"}], 
        "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1f6901be-f78d-42f6-a274-5e859c91306a"],

