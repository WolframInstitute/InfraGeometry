Cell["\<\
A walk that does not return to its start is not a loop, and the holonomy \
stays unevaluated:\
\>", "ExampleText",ExpressionUUID->"336786d2-5009-4546-a654-126ca12e0021"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<CycleDoubleCover\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Head", " ", "@", " ", 
    RowBox[{"InfraHolonomy", "[", 
     RowBox[{"fib", ",", " ", 
      RowBox[{"RandomInfraConnection", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cb9023e5-0806-4a96-b8aa-95da6eb93d7b"],

