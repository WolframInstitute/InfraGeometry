Cell["\<\
The holonomy around the cycle: trivial on the prism, the swap of the sheets \
on the Moebius ladder.\
\>", "ExampleText",ExpressionUUID->"91b52a51-e8bc-44d2-b19e-3319086bfeef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fib", " ", "=", " ", 
       RowBox[{"InfraFiberedSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"conn", " ", "=", " ", 
       RowBox[{"InfraConnection", " ", "@", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"EdgeList", " ", "@", " ", 
           RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"First", " ", "@", " ", "#"}]}], " ", "=!=", " ", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"Last", " ", "@", " ", "#"}]}]}], " ", "&"}]}], 
         "]"}]}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraTotalGraph", "[", "fib", "]"}], ",", " ", 
       RowBox[{"InfraHolonomy", "[", 
        RowBox[{"fib", ",", " ", "conn", ",", " ", 
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{"Range", "[", "8", "]"}], ",", " ", "1"}], "]"}]}], 
        "]"}]}], "}"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<CycleProductBundle\>\"", ",", 
       " ", "\"\<MoebiusLadderCover\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"f43bc2e2-7a82-4a08-a8af-b7bf20041c07"],

