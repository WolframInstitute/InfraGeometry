Cell[TextData[{
 "On the sphere the tiling is finite. From the diameter of the solid on, the \
ball is the whole Platonic solid, the map ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["p", "TI"], ",", " ", 
     StyleBox["q", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b82cca4-a3a6-4f48-a44e-4e67268c9806"],
 "."
}], "Notes",ExpressionUUID->"cdf9ffa6-6cf2-47d3-92af-cc976680af0e"],

Cell[TextData[{
 "The ball has a rim: a vertex at distance ",
 StyleBox["r", "TI"],
 " has fewer than ",
 StyleBox["q", "TI"],
 " neighbours. Unlike the closed maps of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ac5f4016-9a42-4f89-a56e-82093755b023"],
 ", it does not wrap round. The tilings ",
 Cell[BoxData["\"\<SquareTilingGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e89d92f-e262-41b9-a8ca-e35ddb7cc71f"],
 ", ",
 Cell[BoxData["\"\<TriangularTilingGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc50eefb-3360-4280-b228-b6819a5381ae"],
 ", ",
 Cell[BoxData["\"\<HexagonalTilingGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e24c14f-7d6a-4de4-b4ed-6007217dbc44"],
 " and ",
 Cell[BoxData["\"\<HyperbolicTilingGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66ef2d04-4b33-4c22-b47a-56092ba3a11d"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bd7fbc84-c5c2-4014-8452-ed2b60cc4df4"],
 " are such balls with the rim contour removed by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BoundarylessGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BoundarylessGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f6dff431-3888-4925-ad30-8ec867fe80a3"],
 "."
}], "Notes",ExpressionUUID->"ee2e4dfb-b9c8-456f-b8f3-165ed73267c4"],

Cell["\<\
A vertex configuration lists the faces around a vertex in cyclic order: {3, \
4, 6, 4} is the rhombitrihexagonal tiling. The Euclidean configurations {3, \
6, 3, 6}, {3, 4, 6, 4}, {4, 6, 12}, {4, 8, 8}, {3, 12, 12} and the hyperbolic \
ones are built face by face around each vertex; a spherical one gives a ball \
of the Archimedean solid. The snub and elongated tilings are not built.\
\>", "Notes",ExpressionUUID->"5c7edd28-47f2-4ca4-9e32-01969317b0a6"],

Cell[TextData[{
 "The rectangular form exists for the three Euclidean tilings and has ",
 StyleBox["m", "TI"],
 " \[Times] ",
 StyleBox["n", "TI"],
 " cells in each, squares, rhombi of two triangles, hexagons, as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["m", "TI"], ",", " ", 
      StyleBox["n", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21af35c7-c127-499d-bde8-c7648645bff2"],
 " has. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "63e7d393-4e13-4f3e-86cd-c6a7f87aca65"],
 " options are passed on to the graph."
}], "Notes",ExpressionUUID->"f846e978-4318-41f3-af34-a42f336bc19a"]
}, Open  ]],

