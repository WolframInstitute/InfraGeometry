Cell[TextData[{
 "In the plane the ball has ",
 StyleBox["2r\.b2 + 2r + 1", "TI"],
 " vertices for squares, ",
 StyleBox["3r\.b2 + 3r + 1", "TI"],
 " for triangles and ",
 StyleBox["3r(r + 1)/2 + 1", "TI"],
 " for hexagons:"
}], "ExampleText",ExpressionUUID->"e82ca189-b43f-4404-8a8a-f24830ae2c70"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"VertexCount", " ", "@", " ", 
     RowBox[{"TessellationNeighborhoodGraph", "[", 
      RowBox[{"type", ",", " ", "r"}], "]"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"type", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "6"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "3"}], "}"}]}], "}"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"r", ",", " ", "6"}], "}"}]}], "]"}], " ", "==", "\n", "  ", 
  RowBox[{"Transpose", " ", "@", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"r", "^", "2"}]}], " ", "+", " ", 
        RowBox[{"2", " ", "r"}], " ", "+", " ", "1"}], ",", " ", 
       RowBox[{
        RowBox[{"3", " ", 
         RowBox[{"r", "^", "2"}]}], " ", "+", " ", 
        RowBox[{"3", " ", "r"}], " ", "+", " ", "1"}], ",", " ", 
       RowBox[{
        RowBox[{"3", " ", "r", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r", " ", "+", " ", "1"}], ")"}], "/", "2"}]}], " ", "+", 
        " ", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "6"}], "}"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"065a3e86-74c1-40aa-b9be-f865dd6834fb"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9db336ed-b2c8-4e7e-b3cb-dbee26c6b5a0"]
}, Open  ]],

