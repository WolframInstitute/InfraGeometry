Cell[TextData[{
 "Definition: let ",
 StyleBox["T", "TI"],
 " be the 1-skeleton of the infinite tiling and ",
 StyleBox["v\:2080", "TI"],
 " the vertex nearest the point the construction starts from, the origin of \
the plane or the disk, the north pole of the sphere. The result is the \
subgraph of ",
 StyleBox["T", "TI"],
 " induced on the ball ",
 StyleBox["B", "TI"],
 "\:1d63(",
 StyleBox["v\:2080", "TI"],
 ") = {",
 StyleBox["v", "TI"],
 " : ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["v\:2080", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") \[LessEqual] ",
 StyleBox["r", "TI"],
 "}, ",
 StyleBox["d", "TI"],
 " the graph distance of ",
 StyleBox["T", "TI"],
 "."
}], "Notes",ExpressionUUID->"b4540cf3-38af-4b03-ae78-bf40ac98a313"],

Cell["The tiling lies on the surface its curvature selects:", "Notes",ExpressionUUID->"4854853c-33b9-43e2-b658-5369e1c07bfb"],

