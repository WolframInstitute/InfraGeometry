Cell["\<\
The square tiling substrate is the ball of radius 7 with the rim contour \
removed.\
\>", "ExampleText",ExpressionUUID->"25a7c880-73b8-4812-a2ca-e17f95535ece"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"window", " ", "=", " ", 
     RowBox[{"BoundarylessGraph", "[", 
      RowBox[{"TessellationNeighborhoodGraph", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], ",", " ", "7"}], "]"}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"window", ",", " ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"EdgeList", "[", "window", "]"}], "]"}], " ", "===", " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"EdgeList", " ", "@", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
         "]"}]}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"18dc8720-e2f6-47fc-8cf8-80f505676f21"],

