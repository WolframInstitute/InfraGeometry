Cell[TextData[{
 "With ",
 StyleBox["T", "TI"],
 " the 1-skeleton of the infinite tiling and ",
 StyleBox["v\:2080", "TI"],
 " the vertex nearest the origin, the result is the subgraph of ",
 StyleBox["T", "TI"],
 " induced on ",
 StyleBox["B\:1d63(v\:2080) = {v : d(v\:2080, v) \[LessEqual] r}", "TI"],
 "."
}], "Notes",ExpressionUUID->"36e9a1ab-c39c-4b61-8a32-90d3ec11a6ca"],

