Cell[TextData[{
 "In the plane the counts are 2",
 StyleBox["r", "TI"],
 "\.b2 + 2",
 StyleBox["r", "TI"],
 " + 1 for squares, 3",
 StyleBox["r", "TI"],
 "\.b2 + 3",
 StyleBox["r", "TI"],
 " + 1 for triangles and 3",
 StyleBox["r", "TI"],
 "(",
 StyleBox["r", "TI"],
 " + 1)/2 + 1 for hexagons."
}], "ExampleText",ExpressionUUID->"ebedfc6d-5976-4538-be82-ddd4cc5dfaa6"],

