  FontSize->0.9 Inherited,ExpressionUUID->
  "a2a8ceaa-46bd-462a-99fb-f5e35e45923d"],
 "\[LineSeparator]",
 "tests whether the closed balls of radius ",
 StyleBox["r", "TI"],
 " about the vertices of ",
 StyleBox["s", "TI"],
 " cover every vertex of ",
 StyleBox["g", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"cb9bdee9-0357-49c5-9853-7b566575ef75"],
 Cell[BoxData[
  RowBox[{
