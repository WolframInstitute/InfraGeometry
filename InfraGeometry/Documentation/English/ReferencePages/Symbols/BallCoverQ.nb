Cell["\<\
A smallest cover of the hexagonal tiling by balls of radius 3 covers; without \
its first centre it does not. The remaining balls are blue and the vertices \
they leave uncovered are red.\
\>", "ExampleText",ExpressionUUID->"ab4a9c67-9ee8-4d62-b6cb-7131db422bbf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cover", " ", "=", " ", 
     RowBox[{"FindBallCover", "[", 
      RowBox[{"g", ",", " ", "3"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"balls", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"FindInfraRepresentative", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{"#", ",", " ", "3"}], "]"}]}], "]"}], " ", "&"}], " ", "/@",
       " ", 
      RowBox[{"Rest", "[", "cover", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"balls", " ", "->", " ", "StandardBlue"}], ",", " ", 
         RowBox[{
          RowBox[{"Complement", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{"Union", " ", "@@", " ", "balls"}]}], "]"}], " ", "->", 
          " ", "StandardRed"}]}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"BallCoverQ", "[", 
      RowBox[{"g", ",", " ", "3", ",", " ", "cover"}], "]"}], ",", " ", 
     RowBox[{"BallCoverQ", "[", 
      RowBox[{"g", ",", " ", "3", ",", " ", 
       RowBox[{"Rest", "[", "cover", "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0bcf9a5d-49f1-41b8-9211-8c919bf24557"],

