Cell["\<\
With targets, only the targets need covering. The centre covers its own ball \
of radius 2, not the whole tiling.\
\>", "ExampleText",ExpressionUUID->"eea20f50-a4ca-45e4-882c-622631009c3d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", "c"}], "}"}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"BallCoverQ", "[", 
      RowBox[{"g", ",", " ", "2", ",", " ", 
       RowBox[{"{", "c", "}"}], ",", " ", 
       RowBox[{"FindInfraRepresentative", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}]}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"BallCoverQ", "[", 
      RowBox[{"g", ",", " ", "2", ",", " ", 
       RowBox[{"{", "c", "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6be3dc23-584d-4db9-9fc5-3ddc6db1b0a2"],

