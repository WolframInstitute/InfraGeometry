Cell[TextData[{
 "A single vertex covers the whole graph exactly when its eccentricity is at \
most ",
 StyleBox["r", "TI"],
 ". The ball of radius 6 about the centre of the square tiling misses the \
rim; from radius 7, the eccentricity of the centre, the one ball covers."
}], "ExampleText",ExpressionUUID->"848cce14-a825-4ba5-9f55-39f2264f4c0a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", 
           RowBox[{
            RowBox[{"VertexEccentricity", "[", 
             RowBox[{"g", ",", " ", "c"}], "]"}], " ", "-", " ", "1"}]}], 
          "]"}], ",", " ", "c"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"VertexEccentricity", "[", 
      RowBox[{"g", ",", " ", "c"}], "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"BallCoverQ", "[", 
        RowBox[{"g", ",", " ", "r", ",", " ", 
         RowBox[{"{", "c", "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "5", ",", " ", "8"}], "}"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1c494cb7-4766-4d37-a07e-b89294d891a3"],

