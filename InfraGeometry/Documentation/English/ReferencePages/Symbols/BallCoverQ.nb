Cell["\<\
A smallest cover of the hexagonal tiling by balls of radius 3 covers; without \
its first centre it does not. The remaining balls are blue and the vertices \
they leave uncovered are red.\
\>", "ExampleText",ExpressionUUID->"54f5c9b2-a0a8-4e27-b5c4-9681182567cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cover", " ", "=", " ", 
     RowBox[{"FindBallCover", "[", 
      RowBox[{"g", ",", " ", "3"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"balls", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"FindInfraRepresentative", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{"#", ",", " ", "3"}], "]"}]}], "]"}], " ", "&"}], " ", "/@",
       " ", 
      RowBox[{"Rest", "[", "cover", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"balls", " ", "->", " ", "StandardBlue"}], ",", " ", 
         RowBox[{
          RowBox[{"Complement", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{"Union", " ", "@@", " ", "balls"}]}], "]"}], " ", "->", 
          " ", "StandardRed"}]}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"BallCoverQ", "[", 
      RowBox[{"g", ",", " ", "3", ",", " ", "cover"}], "]"}], ",", " ", 
     RowBox[{"BallCoverQ", "[", 
      RowBox[{"g", ",", " ", "3", ",", " ", 
       RowBox[{"Rest", "[", "cover", "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f9211a04-7743-4b62-8286-9ad76c1564f7"],

