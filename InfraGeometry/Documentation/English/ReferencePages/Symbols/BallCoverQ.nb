Cell[TextData[{
 "Definition: ",
 StyleBox["s", "TI"],
 " covers a set ",
 StyleBox["T", "TI"],
 " at radius ",
 StyleBox["r", "TI"],
 " when every ",
 StyleBox["t \[Element] T", "TI"],
 " has some ",
 StyleBox["c \[Element] s", "TI"],
 " with ",
 StyleBox["d(t, c) \[LessEqual] r", "TI"],
 "; for ",
 StyleBox["T", "TI"],
 " the whole vertex set, ",
 StyleBox["s", "TI"],
 " is an ",
 StyleBox["r", "TI"],
 "-dominating set."
}], "Notes",ExpressionUUID->"2294feb4-4db2-45fa-9abc-8fea0096949d"],

Cell[TextData[{
 "A cover of every vertex at radius ",
 StyleBox["r", "TI"],
 " is one at every larger radius, and a superset of a cover is a cover. The \
smallest covers are found by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindBallCover"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindBallCover", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "80196dea-8c20-4810-92a1-026834738580"],
 ", and their size is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DominationNumber"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DominationNumber", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ce0c42f5-aa4b-4bae-b664-7949a409fb17"],
 "."
}], "Notes",ExpressionUUID->"7948f263-4009-439d-a75d-12e070c14324"]
}, Open  ]],

