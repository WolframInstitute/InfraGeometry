Cell["\<\
With targets, only the targets need covering. The centre covers its own ball \
of radius 2, not the whole tiling.\
\>", "ExampleText",ExpressionUUID->"8ee0fc44-47a0-40be-ad00-5a997abe447a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}], ",", " ", "c"}], "}"}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"BallCoverQ", "[", 
      RowBox[{"g", ",", " ", "2", ",", " ", 
       RowBox[{"{", "c", "}"}], ",", " ", 
       RowBox[{"FindInfraRepresentative", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", "2"}], "]"}]}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"BallCoverQ", "[", 
      RowBox[{"g", ",", " ", "2", ",", " ", 
       RowBox[{"{", "c", "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3b3ec0db-da78-44c0-98b2-2c3b18453081"],

