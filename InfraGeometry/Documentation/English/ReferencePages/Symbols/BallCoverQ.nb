Cell[TextData[{
 "A single vertex covers the whole graph exactly when its eccentricity is at \
most ",
 StyleBox["r", "TI"],
 ". The ball of radius 6 about the centre of the square tiling misses the \
rim; from radius 7, the eccentricity of the centre, the one ball covers."
}], "ExampleText",ExpressionUUID->"10e6eab0-1461-470c-b037-d481026d84f1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraBall", "[", 
          RowBox[{"c", ",", " ", 
           RowBox[{
            RowBox[{"VertexEccentricity", "[", 
             RowBox[{"g", ",", " ", "c"}], "]"}], " ", "-", " ", "1"}]}], 
          "]"}], ",", " ", "c"}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"VertexEccentricity", "[", 
      RowBox[{"g", ",", " ", "c"}], "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"BallCoverQ", "[", 
        RowBox[{"g", ",", " ", "r", ",", " ", 
         RowBox[{"{", "c", "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "5", ",", " ", "8"}], "}"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f068ed0d-4f26-4393-b8ef-40b15a925a81"],

