Cell["\<\
The squares of side 2 with a corner at the centre of the grid, by the length \
of their diagonal: 12 on diamonds, 4 axis squares:\
\>", "ExampleText",ExpressionUUID->"370471e0-5b41-435b-91b4-bfe7856b6c46"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"polys", " ", "=", " ", 
     RowBox[{"RandomInfraRegularPolygon", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "Automatic"}], "}"}], ",", " ", "4", ",", " ", 
       "All", ",", " ", 
       RowBox[{"\"\<From\>\"", " ", "->", " ", "45"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"TopologicalSort", "[", "#", "]"}]}], " ", "&"}], ",", " ", 
       "polys", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Counts", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{"#", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
     "corners"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a0851816-a17d-48b1-83dc-a2c3a79963ce"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"2", "\[Rule]", "12"}], ",", 
   RowBox[{"4", "\[Rule]", "4"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"ab432bfc-c331-4560-b1d0-7d1c7258e224"]
}, Open  ]],

Cell["\<\
One of each, with its corners. A side of the diamond may run through its \
centre:\
\>", "ExampleText",ExpressionUUID->"66d31e62-8e66-404a-b778-80cee862d37a"],

