Cell[CellGroupData[{
Cell["RandomInfraRegularPolygon", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell["LLM generated.", "Notes",ExpressionUUID->"eac052bc-7cdf-42bb-869c-25f24601a126"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d2ff515e-458a-4977-9094-ce5584cb034c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraRegularPolygon"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRegularPolygon", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", "As", ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47c9c839-42b0-48ec-a820-9694a67b24d2"],
 "\[LineSeparator]",
 "draws one polygon as a list of directed path graphs joining a length-n \
cyclic vertex sequence whose k-diagonal distances satisfy As[[k]] (slot \
grammar: Integer exact, {lo, hi} constant in range, Automatic any constant; \
Length[As] <= Floor[n/2]); count / UpTo[count] / All controls multiplicity.",
 "\n"
}], "Usage",ExpressionUUID->"60c7e9a8-17be-4db1-85da-85f15ea5dbe8"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomInfraRegularPolygon", "[", 
   RowBox[{"g", ",", " ", "As", ",", " ", "n", ",", " ", "count"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f47b15db-c6f6-4126-90eb-faee28db1c49"],
 " uses the direct form. The bare form returns ordered directed Graph legs; \
the token form returns their concatenated ordered vertex sequence."
}], "Notes",ExpressionUUID->"b77a9907-7dbb-421d-9e21-49f9abe88a87"],

Cell[TextData[{
 "The default draw is random. Seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c44767d-7680-4842-82db-3612528ca5c0"],
 " to reproduce it. Give ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b531cba-8d10-496a-b089-a377cc75c17c"],
 " for deterministic descent. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64faed74-d7e9-4020-b2e5-d071d335bec9"],
 " with ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c04d782-4cb5-48d3-93a3-e36a6a004e16"],
 " keeps the full enumeration without drawing."
}], "Notes",ExpressionUUID->"248701ed-088a-4a02-b392-ce510be90610"],

