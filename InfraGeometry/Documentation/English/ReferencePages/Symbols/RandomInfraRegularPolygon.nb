Cell["\<\
An equilateral triangle of side 4 with a corner at the centre, on the square \
grid and on the square mesh:\
\>", "ExampleText",ExpressionUUID->"8049079a-2160-4d62-b500-aaec141972f1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"poly", " ", "=", " ", 
        RowBox[{"RandomInfraRegularPolygon", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", "4", "}"}], ",", " ", "3", ",", " ", 
          RowBox[{"\"\<From\>\"", " ", "->", " ", "c"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "5"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"poly", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"TopologicalSort", "[", "#", "]"}]}], " ", "&"}], " ", "/@",
            " ", "poly"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"10f83b52-4b64-4f40-ab9a-e31618fc717c"],

