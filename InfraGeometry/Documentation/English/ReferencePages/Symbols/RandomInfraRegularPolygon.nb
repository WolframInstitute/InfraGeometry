Cell[TextData[{
 "A regular ",
 StyleBox["n", "TI"],
 "-gon is a cyclic sequence of distinct corners ",
 StyleBox["v\:2081", "TI"],
 ", \[Ellipsis], ",
 StyleBox["v\:2099", "TI"],
 " with ",
 StyleBox["d(v\:1d62, v\:1d62\:208a\:2096)", "TI"],
 " the same for every ",
 StyleBox["i", "TI"],
 ", indices mod ",
 StyleBox["n", "TI"],
 ". The ",
 StyleBox["k", "TI"],
 "-th entry of the tuple says which value the ",
 StyleBox["k", "TI"],
 "-th diagonals take; ",
 StyleBox["k", "TI"],
 " = 1 is the side. At most \[LeftFloor]",
 StyleBox["n", "TI"],
 "/2\[RightFloor] entries are given, the rest are free."
}], "Notes",ExpressionUUID->"101d00bd-eb5c-4c4d-b06f-dcbb17d65f62"],

