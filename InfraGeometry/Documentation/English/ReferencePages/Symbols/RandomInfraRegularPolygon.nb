Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraRegularPolygon", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"03b4bfa3-7c59-4d49-8616-9371da1d2b14"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraRegularPolygon"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRegularPolygon", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", "As", ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06f7a345-9eeb-44c8-9006-b1005201a828"],
 "\[LineSeparator]",
 "draws one polygon as a list of directed path graphs joining a length-n \
cyclic vertex sequence whose k-diagonal distances satisfy As[[k]] (slot \
grammar: Integer exact, {lo, hi} constant in range, Automatic any constant; \
Length[As] <= Floor[n/2]); count / UpTo[count] / All controls multiplicity.",
 "\n"
}], "Usage",ExpressionUUID->"5c07bc58-f6f7-49a5-b3a7-b8f4862d4a25"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"RandomInfraRegularPolygon", "[", 
   RowBox[{"g", ",", " ", "As", ",", " ", "n", ",", " ", "count"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02e02051-e704-4f29-8fff-44e3c17ad49a"],
 " uses the direct form. The bare form returns ordered directed Graph legs; \
the token form returns their concatenated ordered vertex sequence."
}], "Notes",ExpressionUUID->"a5c6ea0a-830e-4391-8304-b140b15b6d4f"],

Cell[TextData[{
 "The default draw is random. Give ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76222b4e-869f-473d-9235-d9211aff0957"],
 " for deterministic descent. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d458c15f-61e8-476b-b5be-46ef44bcd9b7"],
 " with ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a155fdd0-c68d-4f14-a823-dfe0c776882e"],
 " keeps the full enumeration without drawing. ",
 Cell[BoxData[
  RowBox[{"RandomSeeding", " ", "->", " ", "Automatic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cde3b77d-8c77-4cf6-91cd-abbf94651d98"],
 " (default) seeds each call afresh, independently of ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "710976de-1a8d-467c-ad2e-fc6a34c20b72"],
 "; an integer or string gives a reproducible draw, and ",
 Cell[BoxData["Inherited"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8cbd4ac-5fb2-4af7-9e40-c20c0a9bbdaa"],
 " a local snapshot of the current state. The outer random state is restored \
afterward, as with ",
 ButtonBox["RandomInstance",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/RandomInstance.html"], 
    None}],
 "."
}], "Notes",ExpressionUUID->"2fe609aa-7785-47f9-bd66-db6fb1a64ae1"],

