Cell[CellGroupData[{
Cell["RandomInfraRegularPolygon", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5483b2cf-3335-4070-897b-21aa34169ada"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraRegularPolygon"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRegularPolygon", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", "As", ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "124ae4ee-6eec-4e1b-b3f6-bd1e0ddcefca"],
 "\[LineSeparator]",
 "draws one polygon as a list of directed path graphs joining a length-n \
cyclic vertex sequence whose k-diagonal distances satisfy As[[k]] (slot \
grammar: Integer exact, {lo, hi} constant in range, Automatic any constant; \
Length[As] <= Floor[n/2]); count / UpTo[count] / All controls multiplicity.",
 "\n"
}], "Usage",ExpressionUUID->"941f5ecf-206f-436e-9720-57669865a3a9"],

Cell[TextData[{
 "The default draw is random. Seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84aef842-675d-4132-8721-cec1f9e96c15"],
 " to reproduce it. Give ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1eed6973-254d-494c-bf7d-a57ffae1bb06"],
 " for deterministic descent. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d5579eb-8b84-41f6-99b0-0cc018a74326"],
 " with ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e538402c-2922-428a-acb8-e4714783228a"],
 " keeps the full enumeration without drawing."
}], "Notes",ExpressionUUID->"cfc128ee-44ad-467b-b0e7-3172703a3b5a"],

