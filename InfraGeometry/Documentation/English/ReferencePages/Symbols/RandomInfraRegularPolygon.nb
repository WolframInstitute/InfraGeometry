Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seq", " ", "=", " ", 
     RowBox[{"RandomInfraRegularPolygon", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraRegularPolygon", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", "4"}], "]"}], ",", 
       " ", 
       RowBox[{"\"\<From\>\"", " ", "->", " ", "45"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"InfraWalk", "[", 
       RowBox[{"Append", "[", 
        RowBox[{"seq", ",", " ", 
         RowBox[{"First", " ", "@", " ", "seq"}]}], "]"}], "]"}], "}"}], ",", 
     " ", 
     RowBox[{"PlotLabel", " ", "->", " ", "seq"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
