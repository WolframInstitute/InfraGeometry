Notebook[{

Cell[CellGroupData[{
Cell["TessellationEulerCharacteristic", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4f308eec-d33f-49c3-b2a9-a2a4f3d16242"],
 Cell[BoxData[
  RowBox[{"TessellationEulerCharacteristic", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["spec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6687eb4e-f6ca-47f6-aa46-33aa237a572c"],
 "\[LineSeparator]",
 "gives the Euler characteristic ",
 StyleBox["V", "TI"],
 " \[Minus] ",
 StyleBox["E", "TI"],
 " + ",
 StyleBox["F", "TI"],
 " of the closed map with graph ",
 StyleBox["g", "TI"],
 " and type ",
 StyleBox["spec", "TI"],
 ": a symbol {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} or a vertex configuration.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b1d378c8-61e7-400c-9fb5-538c268d70ad"],
 Cell[BoxData[
  RowBox[{"TessellationEulerCharacteristic", "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04580237-100e-49ea-8089-f81beb3ef88c"],
 "\[LineSeparator]",
 "reads the type off ",
 StyleBox["g", "TI"],
 " as for a regular map."
}], "Usage",ExpressionUUID->"f44e916e-98bc-4280-9be8-78876f448f1b"],

Cell[TextData[{
 "Definition: ",
 StyleBox["\[Chi] = V \[Minus] E + F", "TI"],
 ", with ",
 StyleBox["V", "TI"],
 " and ",
 StyleBox["E", "TI"],
 " the vertices and edges of ",
 StyleBox["g", "TI"],
 ". The faces are counted through their corners: when every vertex has faces \
of ",
 StyleBox["f", "TI"],
 "\:2081, \[Ellipsis], ",
 StyleBox["f", "TI"],
 "\:2096 sides, each vertex has one corner in each, and a face with ",
 StyleBox["f", "TI"],
 " sides has ",
 StyleBox["f", "TI"],
 " corners, so ",
 StyleBox["F = V \[CapitalSigma]\:1d62 1/f\:1d62", "TI"],
 ". A symbol {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} is ",
 StyleBox["q", "TI"],
 " faces of ",
 StyleBox["p", "TI"],
 " sides."
}], "Notes",ExpressionUUID->"8dd81516-54ce-46fb-ae1f-1f2b5ba44615"],

Cell[TextData[{
 "The surface of a closed orientable map of genus ",
 StyleBox["g", "TI"],
 " has ",
 StyleBox["\[Chi]", "TI"],
 " = 2 \[Minus] 2",
 StyleBox["g", "TI"],
 ": 2 on the sphere, 0 on the torus, negative on a hyperbolic surface. It \
equals ",
 StyleBox["V \[Kappa]", "TI"],
 ", ",
 StyleBox["\[Kappa]", "TI"],
 " the ",
 Cell[BoxData["TessellationCurvature"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4761177-2383-4dd2-924b-77797641e5fe"],
 " at a vertex."
}], "Notes",ExpressionUUID->"f4082e4c-5a42-429a-a182-7ea69f95012d"],

Cell["\<\
The count of faces through corners holds on a closed map, where every vertex \
has the whole configuration.\
\>", "Notes",ExpressionUUID->"48570280-b835-4dff-b783-25db7c603f8b"],

Cell[TextData[{
 "The graph form takes the type {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} with ",
 StyleBox["p", "TI"],
 " the girth of ",
 StyleBox["g", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " its least degree, as ",
 Cell[BoxData["TessellationCurvature"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a694fcba-10a1-4d8a-bd0a-f147f12781bb"],
 " does."
}], "Notes",ExpressionUUID->"bcde139a-f491-4d2a-a0dc-8f28faef9d1a"]
}, Open  ]],

