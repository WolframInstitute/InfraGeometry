Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"sizes", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"m", " ", "=", " ", 
           RowBox[{"TessellationGraph", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"3", ",", " ", "7"}], "}"}], ",", " ", "n"}], "]"}]}], 
          "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"VertexCount", "[", "m", "]"}], ",", " ", 
           RowBox[{"TessellationEulerCharacteristic", "[", 
