Cell[CellGroupData[{
Cell["TessellationEulerCharacteristic", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f0989b43-e86e-4ea5-8508-2883758f303e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationEulerCharacteristic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
TessellationEulerCharacteristic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["spec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bac40dd-1af6-4128-be93-b717ebc399c7"],
 "\[LineSeparator]",
 "gives the Euler characteristic ",
 StyleBox["V", "TI"],
 " \[Minus] ",
 StyleBox["E", "TI"],
 " + ",
 StyleBox["F", "TI"],
 " of the closed map with graph ",
 StyleBox["g", "TI"],
 " and type ",
 StyleBox["spec", "TI"],
 ": a symbol {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} or a vertex configuration.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"18489090-24a4-4b5b-8912-84363016ff3b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationEulerCharacteristic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
TessellationEulerCharacteristic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8667c2b3-e53f-4add-915e-a3901b369e22"],
 "\[LineSeparator]",
 "reads the type off ",
 StyleBox["g", "TI"],
 " as for a regular map."
}], "Usage",ExpressionUUID->"fff8a6e7-d174-415b-a88f-cf88b6739833"],

Cell[TextData[{
 "Definition: ",
 StyleBox["\[Chi] = V \[Minus] E + F", "TI"],
 ", with ",
 StyleBox["V", "TI"],
 " and ",
 StyleBox["E", "TI"],
 " the vertices and edges of ",
 StyleBox["g", "TI"],
 ". The faces are counted through their corners: when every vertex has faces \
of ",
 StyleBox["f", "TI"],
 "\:2081, \[Ellipsis], ",
 StyleBox["f", "TI"],
 "\:2096 sides, each vertex has one corner in each, and a face with ",
 StyleBox["f", "TI"],
 " sides has ",
 StyleBox["f", "TI"],
 " corners, so ",
 StyleBox["F = V \[CapitalSigma]\:1d62 1/f\:1d62", "TI"],
 ". A symbol {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} is ",
 StyleBox["q", "TI"],
 " faces of ",
 StyleBox["p", "TI"],
 " sides."
}], "Notes",ExpressionUUID->"cb0e08ab-cf29-487b-8fd2-0e83cd09406b"],

Cell[TextData[{
 "The surface of a closed orientable map of genus ",
 StyleBox["g", "TI"],
 " has ",
 StyleBox["\[Chi]", "TI"],
 " = 2 \[Minus] 2",
 StyleBox["g", "TI"],
 ": 2 on the sphere, 0 on the torus, negative on a hyperbolic surface. It \
equals ",
 StyleBox["V \[Kappa]", "TI"],
 ", ",
 StyleBox["\[Kappa]", "TI"],
 " the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationCurvature"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationCurvature", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a867a9b6-bc04-4bfb-b1eb-c25ff61f7537"],
 " at a vertex."
}], "Notes",ExpressionUUID->"e26cc9d0-596d-4bf2-8ef4-6b42ddec81c9"],

Cell["\<\
The count of faces through corners holds on a closed map, where every vertex \
has the whole configuration.\
\>", "Notes",ExpressionUUID->"5576bea1-63f7-4e7f-b48e-dab34158a1a8"],

Cell[TextData[{
 "The graph form takes the type {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} with ",
 StyleBox["p", "TI"],
 " the girth of ",
 StyleBox["g", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " its least degree, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationCurvature"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationCurvature", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1533be99-907d-4b09-afc4-5d1dcbc1e61a"],
 " does."
}], "Notes",ExpressionUUID->"ce7ed799-b5f6-4baf-9044-b0f0356bf6b6"]
}, Open  ]],

