Cell["\<\
The cube, a square torus and the smallest map of heptagons, three at every \
vertex:\
\>", "ExampleText",ExpressionUUID->"99c829ff-9f53-4865-a270-4de0004280f1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"specs", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"7", ",", " ", "3"}], "}"}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"maps", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"TessellationGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
       RowBox[{"TessellationGraph", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "4"}], "}"}], ",", " ", "6"}], "]"}], ",", 
       " ", 
       RowBox[{"TessellationGraph", "[", 
        RowBox[{"{", 
         RowBox[{"7", ",", " ", "3"}], "}"}], "]"}]}], "}"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Graph", "[", 
        RowBox[{"#1", ",", " ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"TessellationEulerCharacteristic", "[", 
           RowBox[{"#1", ",", " ", "#2"}], "]"}]}]}], "]"}], " ", "&"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"maps", ",", " ", "specs"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"49d3e607-e45b-4800-9756-c72f50755798"],

