Cell[CellGroupData[{
Cell["TessellationEulerCharacteristic", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b6388fc0-6ab5-4895-b757-72cf000555ae"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationEulerCharacteristic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
TessellationEulerCharacteristic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["spec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d87497c5-b43b-4fd6-818a-a4df9416b174"],
 "\[LineSeparator]",
 "gives the Euler characteristic ",
 StyleBox["V \[Minus] E + F", "TI"],
 " of the closed map with graph ",
 StyleBox["g", "TI"],
 " and type ",
 StyleBox["spec", "TI"],
 ", a symbol {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} or a vertex configuration {",
 StyleBox["f\:2081", "TI"],
 ", \[Ellipsis], ",
 StyleBox["f\:2096", "TI"],
 "}.",
 "\n"
}], "Usage",ExpressionUUID->"eee0b496-d700-4f21-959b-c7bce19214f2"],

Cell[TextData[{
 "The Euler characteristic is ",
 StyleBox["\[Chi] = V \[Minus] E + F", "TI"],
 ", with ",
 StyleBox["V", "TI"],
 " and ",
 StyleBox["E", "TI"],
 " the vertices and edges of ",
 StyleBox["g", "TI"],
 ". The faces are counted through their corners: every vertex has one corner \
in each of its faces and a face with ",
 StyleBox["f", "TI"],
 " sides has ",
 StyleBox["f", "TI"],
 " corners, so ",
 StyleBox["F = V \[CapitalSigma]\:1d62 1/f\:1d62", "TI"],
 ". A symbol {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} is ",
 StyleBox["q", "TI"],
 " faces of ",
 StyleBox["p", "TI"],
 " sides."
}], "Notes",ExpressionUUID->"f5a20788-641a-46e5-99a2-784821d5b1c5"],

Cell[TextData[{
 "A closed orientable surface of genus ",
 StyleBox["\[Gamma]", "TI"],
 " has ",
 StyleBox["\[Chi] = 2 \[Minus] 2\[Gamma]", "TI"],
 ": 2 on the sphere, 0 on the torus, negative on a hyperbolic surface. \
Discrete Gauss\[Dash]Bonnet gives ",
 StyleBox["\[Chi] = V\[Kappa]", "TI"],
 ", with ",
 StyleBox["\[Kappa]", "TI"],
 " the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationCurvature"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationCurvature", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "99da6d22-8874-41a1-a6bf-9a30a55f8680"],
 " at a vertex."
}], "Notes",ExpressionUUID->"7479ad34-ab1d-4f23-ad14-ea28a626a019"],

Cell["\<\
The count of faces holds on a closed map only, where every vertex has the \
whole configuration. The type is part of the map: a graph does not determine \
it.\
\>", "Notes",ExpressionUUID->"f4911820-9ba0-4513-b6e4-40d0a8fc7f0a"]
}, Open  ]],

