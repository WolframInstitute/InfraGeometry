Cell[TextData[{
 "The Euler characteristic is ",
 StyleBox["V\[Kappa]", "TI"],
 " and ",
 StyleBox["2 \[Minus] 2\[Gamma]", "TI"],
 ", with ",
 StyleBox["\[Gamma]", "TI"],
 " the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationGenus"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationGenus", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cfb83eb2-da9a-41cc-b04e-cee7f01c8651"],
 " of the type and the size:"
}], "ExampleText",ExpressionUUID->"2aae9c1e-9841-48df-91a0-aaff3a0a071c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", " ", "=", " ", 
       RowBox[{"TessellationGraph", "[", 
        RowBox[{"spec", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"TessellationEulerCharacteristic", "[", 
        RowBox[{"m", ",", " ", "spec"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"VertexCount", "[", "m", "]"}], " ", 
        RowBox[{"TessellationCurvature", "[", "spec", "]"}]}], ",", " ", 
       RowBox[{"2", " ", "-", " ", 
        RowBox[{"2", " ", 
         RowBox[{"TessellationGenus", "[", 
          RowBox[{"spec", ",", " ", "2"}], "]"}]}]}]}], "}"}]}], "]"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"spec", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "7"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "8"}], "}"}]}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"dacce4e7-a3dc-4bf5-a5a8-d76ff185dc4c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "12"}], ",", 
     RowBox[{"-", "12"}], ",", 
     RowBox[{"-", "12"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "8"}], ",", 
     RowBox[{"-", "8"}], ",", 
     RowBox[{"-", "8"}]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9929114f-c5b7-49e9-a26d-3eaf8f08f745"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
