 CellID->1305812373,ExpressionUUID->"9397dd0b-9de4-443a-9371-be2b75148f2f"],

Cell["\<\
The type must be the map's. The first map {5, 5}, twelve pentagons on a \
surface of genus 4, has the graph of the icosahedron; read as {3, 5}, the \
same graph gives the sphere:\
\>", "ExampleText",ExpressionUUID->"deae7d6c-1c8d-426d-a372-2b4f31f0e8a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"TessellationGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"IsomorphicGraphQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"TessellationGraph", "[", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "5"}], "}"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"TessellationEulerCharacteristic", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "5"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"TessellationEulerCharacteristic", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3d95955d-2f76-4a92-8dc8-ba4b33d3f44f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"-", "6"}], ",", "2"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"bbce59a2-ec38-4cc8-bf83-ef99da2881fc"]
}, Open  ]],

Cell["\<\
A ball cut from a tiling is not closed. Its rim vertices have fewer faces \
than the configuration says, and the value is not the Euler characteristic 1 \
of the disk:\
\>", "ExampleText",ExpressionUUID->"17004c5e-d324-4d03-b95d-3b012a50c895"],

