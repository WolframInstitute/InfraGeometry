Cell[CellGroupData[{
Cell["TessellationEulerCharacteristic", "ObjectName",ExpressionUUID->"a6cdc5d8-4da3-4ab4-9cea-06af65411a00"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9de4e269-5b52-41a5-9ac3-bd55f7759607"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TessellationEulerCharacteristic"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
TessellationEulerCharacteristic", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["spec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33659a89-5da5-473b-a3f8-35b523b1ef7d"],
 "\[LineSeparator]",
 "gives the Euler characteristic ",
 StyleBox["V", "TI"],
 " \[Minus] ",
 StyleBox["E", "TI"],
 " + ",
 StyleBox["F", "TI"],
 " of the closed map with graph ",
 StyleBox["g", "TI"],
 " and type ",
 StyleBox["spec", "TI"],
 ": a symbol {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} or a vertex configuration.",
 "\n"
}], "Usage",ExpressionUUID->"4f228519-1ee7-4f89-ae5d-d1336044138a"],

Cell[TextData[{
 "Definition: ",
 StyleBox["\[Chi] = V \[Minus] E + F", "TI"],
 ", with ",
 StyleBox["V", "TI"],
 " and ",
 StyleBox["E", "TI"],
 " the vertices and edges of ",
 StyleBox["g", "TI"],
 ". The faces are counted through their corners: when every vertex has faces \
of ",
 StyleBox["f", "TI"],
 "\:2081, \[Ellipsis], ",
 StyleBox["f", "TI"],
 "\:2096 sides, each vertex has one corner in each, and a face with ",
 StyleBox["f", "TI"],
 " sides has ",
 StyleBox["f", "TI"],
 " corners, so ",
 StyleBox["F = V \[CapitalSigma]\:1d62 1/f\:1d62", "TI"],
 ". A symbol {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["q", "TI"],
 "} is ",
 StyleBox["q", "TI"],
 " faces of ",
 StyleBox["p", "TI"],
 " sides."
}], "Notes",ExpressionUUID->"e64098fd-38bd-4a04-9fb2-32312bbbcf84"],

Cell[TextData[{
 "The surface of a closed orientable map of genus ",
 StyleBox["g", "TI"],
 " has ",
 StyleBox["\[Chi]", "TI"],
 " = 2 \[Minus] 2",
 StyleBox["g", "TI"],
 ": 2 on the sphere, 0 on the torus, negative on a hyperbolic surface. It \
equals ",
 StyleBox["V \[Kappa]", "TI"],
 ", ",
 StyleBox["\[Kappa]", "TI"],
 " the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationCurvature"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationCurvature", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "603cc803-c53d-4161-8dc3-341156258f5e"],
 " at a vertex."
}], "Notes",ExpressionUUID->"7edd541e-87e2-440f-a448-6b16c3ad68e2"],

Cell["\<\
The count of faces through corners holds on a closed map, where every vertex \
has the whole configuration.\
\>", "Notes",ExpressionUUID->"761e7527-c9d2-4ad6-b0ac-b13f4a119ad9"],

Cell[TextData[{
 "The type is part of the map: a graph does not determine it. For the ",
 StyleBox["k", "TI"],
 "-th map of a type, 2 \[Minus] 2 ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationGenus"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationGenus", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "529cb961-36c2-4b1c-8bb4-a4069647d78b"],
 "[",
 StyleBox["spec", "TI"],
 ", ",
 StyleBox["k", "TI"],
 "] gives the same value from the type and the size alone."
}], "Notes",ExpressionUUID->"35b80089-216e-43c3-8868-549e530e743f"]
}, Open  ]],

