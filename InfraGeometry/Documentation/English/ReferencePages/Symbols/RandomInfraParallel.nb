Cell["\<\
A line through the centre, the vertices at distance 2 from it, and a parallel \
through one of them:\
\>", "ExampleText",ExpressionUUID->"b4d74e0b-28ec-4cf1-8fbe-4dc5248d5bac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"line", " ", "=", " ", 
        RowBox[{"RandomInfraInfiniteLine", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "a", ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"line", ",", " ", "2"}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"par", " ", "=", " ", 
        RowBox[{"RandomInfraParallel", "[", 
         RowBox[{"g", ",", " ", "line", ",", " ", "p", ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraShell", "[", 
           RowBox[{"line", ",", " ", "2"}], "]"}], ",", " ", 
          RowBox[{"InfraWalk", "[", "line", "]"}], ",", " ", "par", ",", " ", 
          "p"}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"b92390af-7978-44f0-85c4-a86eb754f1b4"],

