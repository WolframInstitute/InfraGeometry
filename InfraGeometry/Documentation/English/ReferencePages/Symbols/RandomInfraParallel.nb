   RowBox[{"Range", "[", "5", "]"}], ",", " ", "13", ",", " ", "All"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a14b5f9d-f959-4b1d-aeaf-62459326f77b"],

