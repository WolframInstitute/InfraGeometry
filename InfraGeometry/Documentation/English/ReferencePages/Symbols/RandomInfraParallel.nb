Cell[CellGroupData[{

Cell["NextVertexFunction", "ExampleSubsection",ExpressionUUID->"0b273cb3-5026-4798-96e0-139092942d67"],

Cell["\<\
The class is the same under every next-vertex function; only the order in \
which parallels come off the pool differs.\
\>", "ExampleText",ExpressionUUID->"081ad378-3d91-4a31-93ed-343e99856d50"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "4"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"RandomInfraInfiniteLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "far"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
            " ", "2"}], " ", "&&", " ", 
           RowBox[{"!", " ", 
            RowBox[{"MemberQ", "[", 
             RowBox[{"line", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], 
        "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"SameQ", " ", "@@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"VertexList", " ", "/@", " ", 
         RowBox[{"RandomInfraParallel", "[", 
          RowBox[{"g", ",", " ", "line", ",", " ", "p", ",", " ", 
           RowBox[{"UpTo", "[", "100", "]"}], ",", " ", 
           RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "#"}]}], 
          "]"}]}], "]"}], " ", "&"}], " ", "/@", "\n", "     ", 
      RowBox[{"{", 
       RowBox[{"Identity", ",", " ", "RandomSample"}], "}"}]}], ")"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"61518aa6-441f-42e9-a35a-b5c86a659792"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b9ab2e9d-b47a-485b-98cb-32326a83c706"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

