   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
   RowBox[{"Range", "[", "5", "]"}], ",", " ", "13", ",", " ", "All"}], 
  "]"}]}], "Input",
