     FontWeight->Bold,ExpressionUUID->"b4d46424-71fa-4630-8dbc-21c4d0b81b9b"],
     Cell["Statement", "TableText",
     FontWeight->Bold,ExpressionUUID->"b7f1973c-85a7-4566-a919-4f5aca0931e5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "bdf551ea-3f84-4ce3-9071-e093e8bcf233"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "579d391f-5d02-466f-94a8-bb5f5cbab32b"], Cell[
    "Postulate 5", "TableText",ExpressionUUID->
     "832e0537-f558-44af-9d04-76dca90bd373"], Cell["\<\
The parallel postulate: two lines cut by a transversal making internal angles \
less than two right angles meet on that side.\
\>", "TableText",ExpressionUUID->"0627c299-9ff5-4383-8c42-e40513465e2a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3a6cb547-f4c5-401b-9b3c-89475b1e3879"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "5beee2e5-5775-4a7f-ae2d-f295f803bac8"], Cell[
    "Proposition I.31", "TableText",ExpressionUUID->
     "778d7cad-0020-4b5e-a2d9-a21121ecc9dd"], Cell["\<\
To draw a line through a given point parallel to a given line.\
\>", "TableText",ExpressionUUID->"82ff0f24-ff40-4e90-b60e-3e296df4b052"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d23b8c21-5b96-4593-888c-f7b16a5dbc07"], Cell[
    "Hilbert", "TableText",ExpressionUUID->
     "64b26fa2-12c8-42e6-9e9e-e3d763cf4046"], Cell[
    "Group IV", "TableText",ExpressionUUID->
     "fb4dee40-fd52-4465-ace5-9592de9829e8"], Cell["\<\
Playfair's axiom: through a point not on a line there is exactly one parallel.\
\>", "TableText",ExpressionUUID->"0ca38af9-98a7-488b-8efb-098522344693"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ca76730f-5557-4617-8b9c-bb4f5c51d878"], Cell[
    "Tarski", "TableText",ExpressionUUID->
     "89ecf85b-8c24-4044-95bb-8f35f2da6911"], Cell[
    "A10, Euclid's axiom", "TableText",ExpressionUUID->
     "0dd5a49b-044b-4299-a737-70bee5463f5b"], Cell["\<\
The Euclidean axiom, stated with betweenness and equidistance.\
\>", "TableText",ExpressionUUID->"479000e8-21a7-4096-82ac-6e97caa3041f"]}
  }]], "3ColumnTableMod",ExpressionUUID->"be38d583-2eed-41a7-bd6a-\
