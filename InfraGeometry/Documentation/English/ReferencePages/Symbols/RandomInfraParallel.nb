  $Line = 0; Null]], "ExampleSection",
 CellID->2123667759,ExpressionUUID->"0e0d5f37-f3c9-4474-a22b-9f10dcc8b438"],

Cell[TextData[{
 "Every parallel is a geodesic, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraParallelQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "27021d05-4196-4b52-a09c-1cf52f641cc9"],
 " accepts it \[LongDash] as it accepts two concentric shells, which no \
geodesic could be."
}], "ExampleText",ExpressionUUID->"0d1aba6f-50e1-4c9f-9300-70b9d4395d83"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"row", " ", "=", " ", 
     RowBox[{"RandomInfraParallel", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Range", "[", "5", "]"}], ",", " ", "13"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSegmentQ", "[", 
      RowBox[{"g", ",", " ", "row"}], "]"}], ",", " ", 
     RowBox[{"InfraParallelQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Range", "[", "5", "]"}], ",", " ", "row"}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"InfraParallelQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "13", ",", " ", "1"}], "]"}], ",", " ", 
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "13", ",", " ", "2"}], "]"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6f5b5638-80a7-4be5-a8b3-e43f1b671c4d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c804507a-a180-4109-a7cf-a17d82b069ef"]
}, Open  ]],

Cell["\<\
Parallelism runs both ways: the first row is the parallel to the third row \
through a vertex of the first.\
\>", "ExampleText",ExpressionUUID->"b1cc7ef3-2b30-4a21-b3ad-e9e7bba510b0"],

