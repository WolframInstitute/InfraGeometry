Notebook[{

Cell[CellGroupData[{
Cell["RandomInfraParallel", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d04a673c-5ccf-4aae-8c61-5c54017796df"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraParallel"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraParallel", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a209f5f-6f6a-4641-98a6-0b2bd761cb1e"],
 "\[LineSeparator]",
 "gives one parallel to ",
 StyleBox["line", "TI"],
 " through ",
 StyleBox["p", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " \[LongDash] a shortest path through ",
 StyleBox["p", "TI"],
 " that stays at the distance ",
 StyleBox["d(p, line)", "TI"],
 " from ",
 StyleBox["line", "TI"],
 " and cannot be prolonged at that distance \[LongDash] as a directed path \
graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"95512428-d70b-4fed-b4d3-bea77048deab"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraParallel"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraParallel", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "147bbe70-81a9-4b0e-b656-ecc0d28e9acf"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e35396ef-7b3a-4f6f-8f68-899aea6ba7e3"],
 " of exactly ",
 StyleBox["n", "TI"],
 " parallels or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6005113-f20f-4e08-b534-fb97deb55989"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d81a4886-0f63-46ea-8283-5391787eed80"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dda5d9ef-9b27-4970-906e-8eb12541498f"],
 " gives the whole class as a pool of DAGs."
}], "Usage",ExpressionUUID->"fb64ccdd-3cc7-4054-ad2e-c4ecfb35cad4"],

Cell[TextData[{
 "The default draw is random. Give ",
 Cell[BoxData[
  RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11d5c14a-d341-4280-ba24-647979d28227"],
 " for deterministic descent. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de644597-9072-49bf-b3d5-b3f335ecac66"],
 " with ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b8546d4-9ff7-4381-ab74-f87ed7e391c3"],
 " keeps the full enumeration without drawing. ",
 Cell[BoxData[
  RowBox[{"RandomSeeding", " ", "->", " ", "Automatic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2ed6712-bf69-4209-95a5-16033f6bc976"],
 " (default) seeds each call afresh, independently of ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2624bcaf-3855-42de-a76d-933f79aedde5"],
 "; an integer or string gives a reproducible draw, and ",
 Cell[BoxData["Inherited"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb2286a6-d3d2-414d-b547-a787eec5f169"],
 " a local snapshot of the current state. The outer random state is restored \
afterward, as with ",
 ButtonBox["RandomInstance",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/RandomInstance.html"], 
    None}],
 "."
}], "Notes",ExpressionUUID->"07bd392c-6990-4944-bc05-3d278f698899"],

Cell[TextData[{
 "Write ",
 StyleBox["L", "TI"],
 " for the level set ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["v", "TI"]}], ":", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["v", "TI"], ",", 
     StyleBox[
      RowBox[{"l", "i", "n", "e"}], "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["p", "TI"], ",", 
     StyleBox[
      RowBox[{"l", "i", "n", "e"}], "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "030064aa-75c0-4edf-9a1d-79a8109ad5cb"],
 ". A parallel to ",
 StyleBox["line", "TI"],
 " through ",
 StyleBox["p", "TI"],
 " is a shortest path ",
 StyleBox["s \[Ellipsis] p \[Ellipsis] e", "TI"],
 " of ",
 StyleBox["g", "TI"],
 " \[LongDash] so ",
 StyleBox["d(s, e) = d(s, p) + d(p, e)", "TI"],
 " \[LongDash] with every vertex in ",
 StyleBox["L", "TI"],
 ", such that no neighbour of ",
 StyleBox["s", "TI"],
 " or ",
 StyleBox["e", "TI"],
 " in ",
 StyleBox["L", "TI"],
 " prolongs it. This reads Euclid's fifth postulate intrinsically: constant \
distance is what a metric can say about parallelism without a notion of \
direction. Inextensibility is measured inside ",
 StyleBox["L", "TI"],
 ", not in ",
 StyleBox["g", "TI"],
 ", so a parallel need not be a line of ",
 StyleBox["g", "TI"],
 "."
}], "Notes",ExpressionUUID->"25766a89-63ef-4c71-bb2d-20dd39660fb6"],

Cell[TextData[{
 StyleBox["line", "TI"],
 " is a vertex sequence, a walk graph, or a list of walk graphs, which \
spreads over its walks. Each parallel appears once, oriented so that ",
 StyleBox["s", "TI"],
 " precedes ",
 StyleBox["e", "TI"],
 " in canonical order."
}], "Notes",ExpressionUUID->"791ef3f8-99fb-4845-bd6a-5e85342a16f6"],

Cell["\<\
On the square grid the classical picture survives: through a vertex of a \
parallel row there is exactly one parallel to a row, and it is the row. Off a \
line that bends, the level set bends with it, and a shortest path inside it \
soon has to leave \[LongDash] the parallels are then few and short. Below, \
through a vertex at distance 2 from a line through the centre, the square \
tiling has one parallel of 10 edges beside a line of 24, the irregular mesh \
two, of 4 and 5 edges, the hexagonal tiling a single edge. A vertex with no \
neighbour in its level set has no parallel at all: the class is empty, not \
the one-vertex walk.\
\>", "Notes",ExpressionUUID->"3d3c9801-19c4-414d-b9c5-0b5f548e4625"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraParallelQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f94a9abf-2ce8-4e3b-ae65-3076c0616d87"],
 " asks a different question, and the two do not match. The predicate tests \
that two vertex sets are disjoint and at constant distance, and does not \
require either to be a shortest path. So it accepts pairs this function never \
returns \[LongDash] concentric shells, for instance, are parallel by that \
test \[LongDash] while every parallel returned here passes it."
}], "Notes",ExpressionUUID->"e5b64ae3-469b-4945-9d62-17a124152909"],

Cell[TextData[{
 "The class is carried by a ",
 StyleBox["pool",
  FontWeight->"Bold"],
 ": one shortest path DAG per admissible pair of ends (",
 StyleBox["s", "TI"],
 ", ",
 StyleBox["e", "TI"],
 "), the ",
 StyleBox["s \[RightArrow] p", "TI"],
 " and ",
 StyleBox["p \[RightArrow] e", "TI"],
 " intervals cut down to ",
 StyleBox["L", "TI"],
 " and glued at ",
 StyleBox["p", "TI"],
 ". ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bac91dd-ffd0-4ca3-a1bf-07a53ba652b6"],
 " returns the pool itself \[LongDash] a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9375977d-4898-496f-9848-0aae5793b999"],
 " of DAGs, a single atom giving the one DAG. A bounded count streams \
parallels off the atoms as directed path graphs, and the count-less call is \
one random parallel."
}], "Notes",ExpressionUUID->"263d43c2-25bd-4c41-97cf-6daa01cb377a"],

