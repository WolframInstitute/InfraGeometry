      FontSize->0.9 Inherited,ExpressionUUID->
      "65c94a76-4d85-4a87-b06f-01a10525673c"],
     ". The class is the same under every value."
    }], "TableText",ExpressionUUID->"4453ecb9-1a32-459a-abdf-20d912c34165"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
