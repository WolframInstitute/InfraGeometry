Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"8304e89e-4849-41e9-ab04-d74b88ea4be5"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "99a39bae-01cb-4d76-b6e9-8dcc0807c8ad"], Cell["System", "TableText",
     FontWeight->Bold,ExpressionUUID->"8225c54f-581e-4db9-a61b-97c3fcd59e96"],
