Cell[TextData[{
 "Every parallel is a shortest path, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraParallelQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e80e7a3f-ab88-468a-bd3f-d6ac475444d5"],
 " accepts it \[LongDash] as it accepts two concentric shells, which no \
shortest path could be."
}], "ExampleText",ExpressionUUID->"8042c452-eb4b-499b-af8d-7fd1c04cd3a4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"row", " ", "=", " ", 
     RowBox[{"RandomInfraParallel", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Range", "[", "5", "]"}], ",", " ", "13", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSegmentQ", "[", 
      RowBox[{"g", ",", " ", "row"}], "]"}], ",", " ", 
     RowBox[{"InfraParallelQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Range", "[", "5", "]"}], ",", " ", "row"}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"InfraParallelQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", " ", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", " ", 
           RowBox[{"13", ",", " ", "1"}], " ", "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], " ", "]"}]}], ",", " ", 
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", " ", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", " ", 
           RowBox[{"13", ",", " ", "2"}], " ", "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], "]"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"25ce8bc9-f484-483d-9ae2-115661ad08bd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b966261b-f723-4de4-a244-9ac1c16d9cd2"]
}, Open  ]],

