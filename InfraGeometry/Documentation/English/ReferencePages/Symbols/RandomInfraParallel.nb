Cell[CellGroupData[{
Cell["RandomInfraParallel", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2badef93-b3b8-4cb0-8a12-cd1d9185928e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraParallel"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraParallel", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52f15197-2f73-43cf-a12d-ba2c5f4ba890"],
 "\[LineSeparator]",
 "gives a random parallel to ",
 StyleBox["line", "TI"],
 " through the vertex ",
 StyleBox["p", "TI"],
 ", as a directed path graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2582932a-0b92-4c47-b1f8-f39ec3f62c01"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraParallel"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraParallel", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7980c94d-fc02-4c81-a7b8-3050840421a1"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " parallels.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6a69c109-a551-40fe-a467-6f99af0cf2b1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraParallel"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraParallel", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c9d482fa-8808-4365-9d9e-19c3df2234be"],
 "\[LineSeparator]",
 "gives all parallels, as a list of directed acyclic graphs whose \
source-to-sink paths are the parallels."
}], "Usage",ExpressionUUID->"d28e5795-52a0-4a0f-a891-e18f1276df22"],

Cell[TextData[{
 "Let ",
 StyleBox["L = {v : d(v, line) = d(p, line)}", "TI"],
 " be the level set of ",
 StyleBox["p", "TI"],
 ". A parallel to ",
 StyleBox["line", "TI"],
 " through ",
 StyleBox["p", "TI"],
 " is a shortest path ",
 StyleBox["(s, \[Ellipsis], p, \[Ellipsis], e)", "TI"],
 " of ",
 StyleBox["g", "TI"],
 " with all its vertices in ",
 StyleBox["L", "TI"],
 " that no neighbour of ",
 StyleBox["s", "TI"],
 " or ",
 StyleBox["e", "TI"],
 " in ",
 StyleBox["L", "TI"],
 " prolongs. A parallel need not be a line of ",
 StyleBox["g", "TI"],
 ": it is inextensible inside ",
 StyleBox["L", "TI"],
 " only."
}], "Notes",ExpressionUUID->"325e18a0-f451-47ff-a555-4c5c1336dfc2"],

Cell[TextData[{
 "Through a vertex of a row of the square grid there is exactly one parallel \
to another row, and it is the row. Where the line bends, the level set bends \
with it, and the parallels are short and can be several. A vertex with no \
neighbour in ",
 StyleBox["L", "TI"],
 " has no parallel."
}], "Notes",ExpressionUUID->"ca460592-24a4-4064-83e3-2343bd85b2b3"],

Cell["\<\
The line can be a vertex list, a walk graph or a list of walk graphs.\
\>", "Notes",ExpressionUUID->"7413d2eb-ee43-484e-87dc-fd35c65445f3"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "844ef545-ff24-42c9-a723-be752b2da6af"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80b0ccdd-691a-4e9a-a7a8-35840375534f"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fbf6597d-f8cf-4d57-a765-298d09d7d34a"],
 ". Fewer than ",
 StyleBox["n", "TI"],
 " parallels give ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db7cb33e-3f54-4aeb-a878-21d5bc066408"],
 ". A single directed acyclic graph is returned bare by ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a3733e3-21d4-474f-9b1e-f514ffb4997e"],
 "."
}], "Notes",ExpressionUUID->"0270a0b8-1bb6-41b8-a4a7-d3bf2f06d3c4"],

