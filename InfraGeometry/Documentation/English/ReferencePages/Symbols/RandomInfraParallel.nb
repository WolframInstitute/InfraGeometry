Cell[TextData[{
 "Every parallel is a shortest path, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraParallelQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c42d6daf-be97-48db-bc7b-fe6b40bac074"],
 " accepts it \[LongDash] as it accepts two concentric shells, which no \
shortest path could be."
}], "ExampleText",ExpressionUUID->"7c5024d0-1241-4ec8-b68a-ff81197338f1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"row", " ", "=", " ", 
     RowBox[{"RandomInfraParallel", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Range", "[", "5", "]"}], ",", " ", "13"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSegmentQ", "[", 
      RowBox[{"g", ",", " ", "row"}], "]"}], ",", " ", 
     RowBox[{"InfraParallelQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Range", "[", "5", "]"}], ",", " ", "row"}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"InfraParallelQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", " ", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", " ", 
           RowBox[{"13", ",", " ", "1"}], " ", "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], " ", "]"}]}], ",", " ", 
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", " ", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", " ", 
           RowBox[{"13", ",", " ", "2"}], " ", "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], "]"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5bd60c05-c1fb-43a1-a039-75a4aa67aa27"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e18efe01-0c50-4822-b28a-efaea282caec"]
}, Open  ]],

