Cell["\<\
A parallel is a shortest path, and every vertex of it is at distance 2 from \
the line:\
\>", "ExampleText",ExpressionUUID->"f37761a8-32e9-4f63-b5a8-1c8886d14d59"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"RandomInfraInfiniteLine", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", "a", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"line", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "7"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"par", " ", "=", " ", 
     RowBox[{"RandomInfraParallel", "[", 
      RowBox[{"g", ",", " ", "line", ",", " ", "p", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSegmentQ", "[", 
      RowBox[{"g", ",", " ", "par"}], "]"}], ",", " ", 
     RowBox[{"Union", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Min", " ", "@", " ", 
