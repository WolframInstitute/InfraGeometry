Cell["\<\
Playfair on the square grid: through a vertex two rows above the middle row \
there is one parallel to it, and it is the row:\
\>", "ExampleText",ExpressionUUID->"27f63698-7042-4ed2-a0ee-9e28d99621ee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"vertexAt", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"Round", " ", "@", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}], ",", " ", 
       RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"row", " ", "=", " ", 
      RowBox[{"vertexAt", " ", "/@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "5"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "10"}], "}"}]}], "]"}]}]}], ",", " ", 
     RowBox[{"p", " ", "=", " ", 
      RowBox[{"vertexAt", "[", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "7"}], "}"}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"parallels", " ", "=", " ", 
     RowBox[{"RandomInfraParallel", "[", 
      RowBox[{"g", ",", " ", "row", ",", " ", "p", ",", " ", 
       RowBox[{"UpTo", "[", "10", "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
