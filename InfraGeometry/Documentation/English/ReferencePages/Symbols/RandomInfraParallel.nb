Cell[CellGroupData[{
Cell["RandomInfraParallel", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ca2b2268-7e7f-4bf7-9d9e-21cb2b590e16"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraParallel"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraParallel", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74963f29-efd8-4cb2-a295-94113999b3ea"],
 "\[LineSeparator]",
 "gives a random parallel to ",
 StyleBox["line", "TI"],
 " through the vertex ",
 StyleBox["p", "TI"],
 ", as a directed path graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7cb1bcb9-13c0-46b6-bd99-1f8fd2a83743"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraParallel"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraParallel", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b554a0f3-f6e8-48fd-b41e-4379367c6493"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " parallels.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d551a393-9705-48a8-8d50-9add7b8f851c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraParallel"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraParallel", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6df65c4-3801-47f9-9d0a-0c2b88a81f65"],
 "\[LineSeparator]",
 "gives all parallels, as a list of directed acyclic graphs whose \
source-to-sink paths are the parallels."
}], "Usage",ExpressionUUID->"8832f3c4-d8a9-4738-8e92-1f77045a9741"],

Cell[TextData[{
 "Let ",
 StyleBox["L = {v : d(v, line) = d(p, line)}", "TI"],
 " be the level set of ",
 StyleBox["p", "TI"],
 ". A parallel to ",
 StyleBox["line", "TI"],
 " through ",
 StyleBox["p", "TI"],
 " is a shortest path ",
 StyleBox["(s, \[Ellipsis], p, \[Ellipsis], e)", "TI"],
 " of ",
 StyleBox["g", "TI"],
 " with all its vertices in ",
 StyleBox["L", "TI"],
 " that no neighbour of ",
 StyleBox["s", "TI"],
 " or ",
 StyleBox["e", "TI"],
 " in ",
 StyleBox["L", "TI"],
 " prolongs. A parallel need not be a line of ",
 StyleBox["g", "TI"],
 ": it is inextensible inside ",
 StyleBox["L", "TI"],
 " only."
}], "Notes",ExpressionUUID->"d64edfac-9b51-4767-94f1-4909b47c7733"],

Cell[TextData[{
 "Through a vertex of a row of the square grid there is exactly one parallel \
to another row, and it is the row. Where the line bends, the level set bends \
with it, and the parallels are short and can be several. A vertex with no \
neighbour in ",
 StyleBox["L", "TI"],
 " has no parallel."
}], "Notes",ExpressionUUID->"5c459b79-2964-4bc0-a56f-a0183a1bafc8"],

Cell["\<\
The line can be a vertex list, a walk graph or a list of walk graphs.\
\>", "Notes",ExpressionUUID->"80d01e91-8d99-4ec3-9ea2-393eb704dd11"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a901a57-a3c8-46c2-a25d-c573c7e89549"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cd8925e-3111-4021-bf12-1f76afc37176"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f0900e3-51a6-47be-b546-84daa1f0ee71"],
 ". Fewer than ",
 StyleBox["n", "TI"],
 " parallels give ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ceb124b-8cee-46a2-bb01-fad5589b7b62"],
 ". A single directed acyclic graph is returned bare by ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a821fe3-de3f-43e6-a2e7-c996ccca51c7"],
 "."
}], "Notes",ExpressionUUID->"3d1af74d-752f-4c80-ae35-f1dd7851834c"],

