Cell[CellGroupData[{
Cell["RandomInfraParallel", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bbf898f5-db05-4f9c-a52c-cef0240e3dbf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraParallel"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraParallel", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "686fbd03-c0b1-4604-befa-ba1706392e2d"],
 "\[LineSeparator]",
 "gives a random parallel to ",
 StyleBox["line", "TI"],
 " through the vertex ",
 StyleBox["p", "TI"],
 ", as a directed path graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"859e0650-5ed5-4e1b-8e25-cec301a8814f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraParallel"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraParallel", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "690701bd-7d43-434d-b3fd-418e01341276"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " parallels.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ee2f88c8-4805-4015-a70f-8901a211be1c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraParallel"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraParallel", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c3a7421-26f1-4320-903e-1f7ea8a227f0"],
 "\[LineSeparator]",
 "gives all parallels, as a list of directed acyclic graphs whose \
source-to-sink paths are the parallels."
}], "Usage",ExpressionUUID->"76429a44-2a38-40ab-a91c-25a287219cf3"],

Cell[TextData[{
 "Let ",
 StyleBox["L = {v : d(v, line) = d(p, line)}", "TI"],
 " be the level set of ",
 StyleBox["p", "TI"],
 ". A parallel to ",
 StyleBox["line", "TI"],
 " through ",
 StyleBox["p", "TI"],
 " is a shortest path ",
 StyleBox["(s, \[Ellipsis], p, \[Ellipsis], e)", "TI"],
 " of ",
 StyleBox["g", "TI"],
 " with all its vertices in ",
 StyleBox["L", "TI"],
 " that no neighbour of ",
 StyleBox["s", "TI"],
 " or ",
 StyleBox["e", "TI"],
 " in ",
 StyleBox["L", "TI"],
 " prolongs. A parallel need not be a line of ",
 StyleBox["g", "TI"],
 ": it is inextensible inside ",
 StyleBox["L", "TI"],
 " only."
}], "Notes",ExpressionUUID->"d005d68b-c216-437e-887f-54edbe4d0121"],

Cell[TextData[{
 "Through a vertex of a row of the square grid there is exactly one parallel \
to another row, and it is the row. Where the line bends, the level set bends \
with it, and the parallels are short and can be several. A vertex with no \
neighbour in ",
 StyleBox["L", "TI"],
 " has no parallel."
}], "Notes",ExpressionUUID->"dfee3e78-d188-4865-a2d2-a7b5ae391f38"],

Cell["\<\
The line can be a vertex list, a walk graph or a list of walk graphs.\
\>", "Notes",ExpressionUUID->"aad50eec-942f-4762-9b4f-9b40d8985209"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3e6729b-74ae-4699-a7ed-ab0e80dfcc1e"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b8729f3-ba3a-47f4-89a3-a897e64f6101"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5f9155c-c11a-459a-83a1-b410517b9c87"],
 ". Fewer than ",
 StyleBox["n", "TI"],
 " parallels give ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76b7dd62-5657-4fc7-b472-89f8f9bbe91e"],
 ". A single directed acyclic graph is returned bare by ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd361675-107d-4701-a66c-e148e29147a6"],
 "."
}], "Notes",ExpressionUUID->"ada4a83f-d2b4-42b9-b775-c4359e183880"],

