Cell[TextData[{
 "Every parallel is a shortest path, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraParallelQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "56351c5a-1929-493c-888f-4b6b5f581884"],
 " accepts it \[LongDash] as it accepts two concentric shells, which no \
shortest path could be."
}], "ExampleText",ExpressionUUID->"133dcc57-c6ea-41db-a64f-bb63fe6fada4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"row", " ", "=", " ", 
     RowBox[{"RandomInfraParallel", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Range", "[", "5", "]"}], ",", " ", "13"}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSegmentQ", "[", 
      RowBox[{"g", ",", " ", "row"}], "]"}], ",", " ", 
     RowBox[{"InfraParallelQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Range", "[", "5", "]"}], ",", " ", "row"}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"InfraParallelQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "13", ",", " ", "1"}], "]"}], ",", " ", 
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "13", ",", " ", "2"}], "]"}]}], "]"}]}], 
    "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f98a531d-16ef-4e17-9499-1dc4ff52c53f"],

