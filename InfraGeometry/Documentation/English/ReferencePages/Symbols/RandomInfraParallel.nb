Cell[CellGroupData[{
Cell["RandomInfraParallel", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"23bc83b4-75ee-4269-894b-125afdd730bf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraParallel"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraParallel", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0351559b-e603-4294-a1b4-24aa23347df8"],
 "\[LineSeparator]",
 "gives a random parallel to ",
 StyleBox["line", "TI"],
 " through the vertex ",
 StyleBox["p", "TI"],
 ", as a directed path graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"847d9ac4-70a5-47d9-b397-28d633edf4a8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraParallel"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraParallel", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b75f1e8-7281-46f2-9138-a641132d96e0"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " parallels.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f31b5c72-dbdb-408b-bd81-a283597da412"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraParallel"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraParallel", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e05d48a3-fada-4a2b-aaf1-2efa4d50f25b"],
 "\[LineSeparator]",
 "gives all parallels, as a list of directed acyclic graphs whose \
source-to-sink paths are the parallels."
}], "Usage",ExpressionUUID->"da1e858f-7a55-43ed-a5e6-4f9c9e9904e4"],

Cell[TextData[{
 "Let ",
 StyleBox["L = {v : d(v, line) = d(p, line)}", "TI"],
 " be the level set of ",
 StyleBox["p", "TI"],
 ". A parallel to ",
 StyleBox["line", "TI"],
 " through ",
 StyleBox["p", "TI"],
 " is a shortest path ",
 StyleBox["(s, \[Ellipsis], p, \[Ellipsis], e)", "TI"],
 " of ",
 StyleBox["g", "TI"],
 " with all its vertices in ",
 StyleBox["L", "TI"],
 " that no neighbour of ",
 StyleBox["s", "TI"],
 " or ",
 StyleBox["e", "TI"],
 " in ",
 StyleBox["L", "TI"],
 " prolongs. A parallel need not be a line of ",
 StyleBox["g", "TI"],
 ": it is inextensible inside ",
 StyleBox["L", "TI"],
 " only. Its vertices are all at distance ",
 StyleBox["d(p, line)", "TI"],
 " from the line, but the line need not be at constant distance from it, so \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraParallelQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraParallelQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "82e7e9ba-6eee-44d4-89a0-fe581d79d86c"],
 ", which asks both, can reject it."
}], "Notes",ExpressionUUID->"84f724f5-a132-47c4-8c43-5858f7cde6c8"],

Cell[TextData[{
 "Through a vertex of a row of the square grid there is exactly one parallel \
to another row, and it is the row. Where the line bends, the level set bends \
with it, and the parallels are short and can be several. A vertex with no \
neighbour in ",
 StyleBox["L", "TI"],
 " has no parallel."
}], "Notes",ExpressionUUID->"6e8ac5bd-57a4-415a-81ef-9cbb8ece5bbb"],

Cell["\<\
The line can be a vertex list, a walk graph or a list of walk graphs.\
\>", "Notes",ExpressionUUID->"e0df36f8-41dd-4ae0-a212-2ca7adb10663"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad677804-0c99-4f1a-9af7-498a50c00fbc"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "262a434e-2e68-44fb-a124-2914ba40602b"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc9ffdcc-cdf2-4b5f-92fc-d69f26a5a208"],
 ". Fewer than ",
 StyleBox["n", "TI"],
 " parallels give ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "abebd23e-c90e-4c0e-a1e3-ab592fd9a714"],
 ". A single directed acyclic graph is returned bare by ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18e2a2e0-e87d-456a-8300-974be1f6eae3"],
 "."
}], "Notes",ExpressionUUID->"a881f27a-e7f5-4295-a391-f7ab13f3025d"],

