Cell["\<\
A loop snapped to the mesh. It crosses itself once, at a double point:\
\>", "ExampleText",ExpressionUUID->"3b9a3b79-6748-41a2-8edf-4e238293badc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"loop", " ", "=", " ", 
     RowBox[{"Line", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0.5", ",", " ", "0.5"}], "}"}], " ", "+", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"0.25", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"t", "^", "2"}], " ", "-", " ", "1.2"}], ")"}]}], ",", 
           " ", 
           RowBox[{"0.2", " ", "t", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"t", "^", "2"}], " ", "-", " ", "1.2"}], ")"}]}]}], 
          "}"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", 
          RowBox[{"-", "1.7"}], ",", " ", "1.7", ",", " ", "0.05"}], "}"}]}], 
       "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"w", " ", "=", " ", 
     RowBox[{"FindEmbeddingClosestPath", "[", 
      RowBox[{"g", ",", " ", "loop"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", "w", "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{
       RowBox[{"WalkSingularities", "[", "w", "]"}], 
       "[", "\"\<SelfIntersections\>\"", "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d1f22614-dd86-4385-b1f9-476a268dbe05"],

