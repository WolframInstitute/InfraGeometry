Cell["\<\
A closed curve gives an open walk graph that starts and ends at the same \
vertex. The circle's walk has 29 vertices, the first equal to the last:\
\>", "ExampleText",ExpressionUUID->"5917b596-6637-49ee-900c-f5094e348b37"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circle", " ", "=", " ", 
     RowBox[{"Line", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"5.5", ",", " ", "5.5"}], "}"}], " ", "+", " ", 
         RowBox[{"3.5", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", "t", "]"}], ",", " ", 
            RowBox[{"Sin", "[", "t", "]"}]}], "}"}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "0", ",", " ", 
          RowBox[{"2", " ", "Pi"}], ",", " ", 
          RowBox[{"Pi", "/", "40"}]}], "}"}]}], "]"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"w", " ", "=", " ", 
     RowBox[{"Last", " ", "/@", " ", 
      RowBox[{"SortBy", "[", 
       RowBox[{
        RowBox[{"VertexList", " ", "@", " ", 
         RowBox[{"FindEmbeddingClosestPath", "[", 
          RowBox[{"g", ",", " ", "circle"}], "]"}]}], ",", " ", "First"}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "w", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"First", "[", "w", "]"}], " ", "==", " ", 
      RowBox[{"Last", "[", "w", "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fcd8b0ee-919e-4b46-8596-664e88a0c393"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"29", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"45a3ad60-e2b5-4ad5-8337-a053a5ad0a9a"]
}, Open  ]],

Cell["\<\
A figure eight on the grid. At the crossing the two strands snap onto a \
common edge, a self-tangency, and at the rim the walk backtracks into a \
pendant vertex, a cusp. The curve has neither:\
\>", "ExampleText",ExpressionUUID->"28978374-6e15-4853-98c7-d480190450bb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"eight", " ", "=", " ", 
     RowBox[{"Line", "[", 
