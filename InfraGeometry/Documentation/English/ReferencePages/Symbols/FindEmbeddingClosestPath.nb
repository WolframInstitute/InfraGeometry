Cell["\<\
A circle of radius 3.5 snapped to the grid, and of radius 0.35 to the mesh, \
whose coordinates fill the unit square:\
\>", "ExampleText",ExpressionUUID->"591d4b29-3885-4cdf-9a24-3b6391bfd1f0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"o", " ", "=", " ", 
         RowBox[{"Mean", " ", "@", " ", 
          RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], ",", " ", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{"0.35", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"GraphEmbedding", "[", "g", "]"}], "]"}]}]}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"FindEmbeddingClosestPath", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"Circle", "[", 
            RowBox[{"o", ",", " ", "r"}], "]"}]}], "]"}], "}"}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"13506f89-ef83-4d91-a094-6b09a1b560e4"],

