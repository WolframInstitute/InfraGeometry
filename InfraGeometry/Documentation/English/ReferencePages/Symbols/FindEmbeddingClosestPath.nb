Notebook[{

Cell[CellGroupData[{
Cell["FindEmbeddingClosestPath", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b9645b91-e442-44bc-98ba-df130ca9fc6d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindEmbeddingClosestPath"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindEmbeddingClosestPath", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["curve", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e4b5424-c864-413e-8e83-3a7644b9e37f"],
 "\[LineSeparator]",
 "gives a walk of ",
 StyleBox["g", "TI"],
 " that follows the plane curve ",
 StyleBox["curve", "TI"],
 " in the drawing of ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"7fef2138-0592-467e-ac08-353d8c40cac0"],

Cell[TextData[{
 "The curve is sampled at points ",
 StyleBox["x\:2081, x\:2082, \[Ellipsis]", "TI"],
 ". Each point goes to its nearest vertex in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphEmbedding"]], "paclet:ref/GraphEmbedding"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "54e5af1e-0409-4726-bcc1-d124f679bfa1"],
 " of ",
 StyleBox["g", "TI"],
 ", repeats in a row are dropped, and each vertex is joined to the next by a \
shortest path. The result is the walk through all of them, as a directed path \
graph."
}], "Notes",ExpressionUUID->"77efbf16-99a4-431f-a6c9-2ceaeaa52873"],

Cell[TextData[{
 "The curve can be a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Line"]], "paclet:ref/Line"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7fd2e1e3-33f7-487d-94cf-7405fcf0f926"],
 ", a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BSplineCurve"]], "paclet:ref/BSplineCurve"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "702996aa-6214-464f-aeee-1366dd57bea7"],
 ", a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BezierCurve"]], "paclet:ref/BezierCurve"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7333e215-ac21-4c78-baa5-7b8a2014724c"],
 ", a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Circle"]], "paclet:ref/Circle"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "22e82b86-8a9b-4538-9e4c-2019eadf99d5"],
 " or a list of points, in the coordinates of the embedding. A spline is \
sampled at ",
 StyleBox["max(64, 4n)", "TI"],
 " parameter values, with ",
 StyleBox["n", "TI"],
 " control points, and a circle at 257 points. A line or a point list is used \
as given, so it should be sampled finely."
}], "Notes",ExpressionUUID->"5dd14e94-f334-4693-8922-5ce18d90b583"],

Cell["\<\
The walk can have singularities the curve does not: a strand snapped twice to \
the same edge is a self-tangency, and a crossing need not be a double point.\
\>", "Notes",ExpressionUUID->"f29762f1-938a-421c-965c-ea9757831440"],

Cell[TextData[{
 "Unlike ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["EmbeddingClosest"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/EmbeddingClosest", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fd207bd3-f6aa-406b-b197-63f711519126"],
 ", which selects among given walks, this constructs one walk."
}], "Notes",ExpressionUUID->"a445aa31-c4f2-40be-a9db-f2755046fa65"]
}, Open  ]],

