Cell[CellGroupData[{
Cell["TopologyGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4267054a-5597-4871-9201-b3f0918f9278"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TopologyGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TopologyGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["topo", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f727cd5-898c-4662-8ecb-62ab760f4442"],
 "\[LineSeparator]",
 "draws the graph ",
 StyleBox["g", "TI"],
 " with the edges of the digraph ",
 StyleBox["topo", "TI"],
 " as arrows on top.",
 "\n"
}], "Usage",ExpressionUUID->"d9dee157-aa5e-4e02-8f41-c0f380087c8c"],

Cell[TextData[{
 "The edges of ",
 StyleBox["g", "TI"],
 " are drawn faint and the arrows of ",
 StyleBox["topo", "TI"],
 " in full, at the vertex coordinates of ",
 StyleBox["g", "TI"],
 ". A substrate drawn with ",
 Cell[BoxData["\"\<KeepCoordinates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4ad8eb4-21e9-4af2-8597-579eab75c482"],
 " -> ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9f0438d-1e7e-4e06-8cfd-7fd7fedc2e48"],
 " keeps its own layout; a graph without coordinates is placed by its spring \
layout."
}], "Notes",ExpressionUUID->"13679d66-13a0-45f0-adbf-bf710689584f"],

Cell[TextData[{
 StyleBox["topo", "TI"],
 " is any digraph on the vertices of ",
 StyleBox["g", "TI"],
 ": the Hasse diagram of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallTopology"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallTopology", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "84d18485-9291-4197-9e66-d18eb1a6a5a6"],
 ", its dual, or its transitive closure. The drawing is a picture only; the \
topological operators read ",
 StyleBox["topo", "TI"],
 " itself."
}], "Notes",ExpressionUUID->"05e41778-e593-4b9b-b41d-721825bcb57f"]
}, Open  ]],

