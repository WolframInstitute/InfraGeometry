Cell["\<\
The ball topology of the mesh at radii 1, 2 and 3. The arrows stay at the \
rim, and there are more of them as the radius grows, 40, 62 and 81:\
\>", "ExampleText",ExpressionUUID->"d461df56-5d26-4d58-83e3-520c3186d136"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"TopologyGraph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"BallTopology", "[", 
         RowBox[{"g", ",", " ", "r"}], "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ceb80976-9521-4854-9eab-06a435294b5b"],

