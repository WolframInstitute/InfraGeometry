Cell["\<\
The Hasse diagram and its transitive closure, every comparable pair, on the \
grid at radius 2:\
\>", "ExampleText",ExpressionUUID->"e6a65412-7182-4338-8804-f514462275e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"topo", " ", "=", " ", 
     RowBox[{"BallTopology", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"TopologyGraph", "[", 
       RowBox[{"g", ",", " ", "topo"}], "]"}], ",", " ", 
      RowBox[{"TopologyGraph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"TransitiveClosureGraph", " ", "@", " ", "topo"}]}], "]"}]}], 
     "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9a189424-e735-47b4-9068-702c44786091"],

