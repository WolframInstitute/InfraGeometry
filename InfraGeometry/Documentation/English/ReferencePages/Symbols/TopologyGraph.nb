Cell[CellGroupData[{
Cell["TopologyGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d014596a-3e3c-4eaf-9f06-79a3a928ad6b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TopologyGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/TopologyGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["topo", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fdc08fe9-bce5-4603-8efa-deaee593932f"],
 "\[LineSeparator]",
 "draws the graph ",
 StyleBox["g", "TI"],
 " with the edges of the digraph ",
 StyleBox["topo", "TI"],
 " as arrows on top.",
 "\n"
}], "Usage",ExpressionUUID->"085613c1-a3e2-4dab-8118-62184668fdf6"],

Cell[TextData[{
 "The edges of ",
 StyleBox["g", "TI"],
 " are drawn faint and the arrows of ",
 StyleBox["topo", "TI"],
 " in full, at the vertex coordinates of ",
 StyleBox["g", "TI"],
 ". A substrate made with ",
 Cell[BoxData[
  RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4d9acfa-1c88-44cb-90ee-1fb2e5a436d5"],
 " keeps its own layout; a graph without coordinates is drawn with its \
default layout."
}], "Notes",ExpressionUUID->"89a27cd1-e36d-4006-8a12-4cc3c86a91d5"],

Cell[TextData[{
 "The digraph ",
 StyleBox["topo", "TI"],
 " is any digraph on the vertices of ",
 StyleBox["g", "TI"],
 ": the Hasse diagram of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallTopology"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallTopology", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "be572cdf-d778-4b3c-bed1-003d2141be6b"],
 ", its dual, or its transitive closure. The drawing is a picture only; the \
topological operators take ",
 StyleBox["topo", "TI"],
 " itself."
}], "Notes",ExpressionUUID->"3378eb78-e97b-4618-803d-cfc95fe922f2"]
}, Open  ]],

