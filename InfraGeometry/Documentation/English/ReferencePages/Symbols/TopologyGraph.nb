Cell["\<\
The ball topology of the hexagonal tiling at radii 1, 2 and 3. Every arrow \
ends near the rim.\
\>", "ExampleText",ExpressionUUID->"e865878a-6ecb-43ed-af1b-5b806d963490"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"TopologyGraph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"BallTopology", "[", 
         RowBox[{"g", ",", " ", "r"}], "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b438d228-415c-4e29-a772-556af1264e12"],

