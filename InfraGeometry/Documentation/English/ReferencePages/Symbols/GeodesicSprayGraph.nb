 CellLabel->"Out[1]= ",ExpressionUUID->"76f5e22b-a50f-4b4d-a249-f8bf4a27a40d"]
}, Open  ]],

Cell[TextData[{
 "The geodesics from ",
 StyleBox["c", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " are the paths of the spray from ",
 StyleBox["c", "TI"],
 " to ",
 StyleBox["v", "TI"],
 "; the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GeodesicIntervalGraph"]], 
