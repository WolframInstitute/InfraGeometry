Cell[TextData[{
 "A layer of the spray is a shell: the vertices at depth ",
 StyleBox["r", "TI"],
 " are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b77be068-836a-4029-a086-45adb2281229"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f62ad0d6-febe-4b08-8a4d-1c9fd15bb6c1"],
 ", and their number is the shell area."
}], "ExampleText",ExpressionUUID->"a262f22c-cde3-4030-a5c4-582a95cc47ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sprayDag", " ", "=", " ", 
     RowBox[{"GeodesicSprayGraph", "[", 
      RowBox[{"g", ",", " ", "41", ",", " ", 
       RowBox[{"\"\<AxisLength\>\"", " ", "->", " ", "3"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "sprayDag", "]"}], ",", " ", 
         RowBox[{"FindInfraBall", "[", 
          RowBox[{"g", ",", " ", "41", ",", " ", "2"}], "]"}]}], "]"}]}], " ",
       "===", " ", 
      RowBox[{"FindInfraShell", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", "3"}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"VertexCount", "[", "sprayDag", "]"}], " ", "===", " ", 
      RowBox[{"BallVolumes", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", "3"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2336c5bd-898f-422e-a106-2045baafb876"],

Cell[BoxData[
 RowBox[{"{", 
