Cell[TextData[{
 "A layer of the spray is a shell: the vertices at depth ",
 StyleBox["r", "TI"],
 " are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "20098562-281b-4f53-bac8-858ac0cadfad"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2eb503c-e867-4818-bca6-a24d8832bb8e"],
 ", and their number is the shell area."
}], "ExampleText",ExpressionUUID->"54fc259b-50a5-4320-8295-01e2eeec1284"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sprayDag", " ", "=", " ", 
     RowBox[{"GeodesicSprayGraph", "[", 
      RowBox[{"g", ",", " ", "41", ",", " ", 
       RowBox[{"\"\<AxisLength\>\"", " ", "->", " ", "3"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "sprayDag", "]"}], ",", " ", 
         RowBox[{"FindInfraBall", "[", 
          RowBox[{"g", ",", " ", "41", ",", " ", "2"}], "]"}]}], "]"}]}], " ",
       "===", " ", 
      RowBox[{"FindInfraShell", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", "3"}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"VertexCount", "[", "sprayDag", "]"}], " ", "===", " ", 
      RowBox[{"BallVolumes", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", "3"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cf02169d-57b6-495a-8a50-86b69c6cf586"],

Cell[BoxData[
 RowBox[{"{", 
