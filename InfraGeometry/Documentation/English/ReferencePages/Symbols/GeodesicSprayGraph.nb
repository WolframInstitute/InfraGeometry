Cell[CellGroupData[{
Cell["GeodesicSprayGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"16cf4d1a-df19-4c61-8efc-6ae160957cdc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicSprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicSprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4917a4a9-9345-4bc1-a37f-b5ec4bd47035"],
 "\[LineSeparator]",
 "gives the directed acyclic graph of all geodesics from ",
 StyleBox["c", "TI"],
 ": an edge ",
 StyleBox["u \[RightArrow] v", "TI"],
 " for every edge of ",
 StyleBox["g", "TI"],
 " with ",
 StyleBox["d(c, v) = d(c, u) + 1", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3791872c-c450-44e8-baac-06700175af64"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicSprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicSprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["c1", "TI"], ",", " ", 
      StyleBox["c2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f27a0b74-6f77-4642-9f8f-c545c334e340"],
 "\[LineSeparator]",
 "measures the distance from the nearest of the sources.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"eaaeb3dc-eb2c-4b85-8b41-69b3cc4da420"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicSprayGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/GeodesicSprayGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox["u1", "TI"], ",", " ", 
        StyleBox["v1", "TI"]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["u2", "TI"], ",", " ", 
        StyleBox["v2", "TI"]}], "}"}], ",", " ", "\[Ellipsis]"}], "}"}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71e6d428-8292-401e-a241-78c7ecb5f1a1"],
 "\[LineSeparator]",
 "gives the union of geodesics between the listed pairs."
}], "Usage",ExpressionUUID->"a76e09d7-7c66-416a-89f0-c2bb12ee3fd1"],

Cell[TextData[{
 "Definition: the spray at ",
 StyleBox["c", "TI"],
 " orients every edge of ",
 StyleBox["g", "TI"],
 " that joins two consecutive shells about ",
 StyleBox["c", "TI"],
 " outward, from the shell of radius ",
 StyleBox["r", "TI"],
 " to that of radius ",
 StyleBox["r", "TI"],
 " + 1. Edges inside one shell are dropped."
}], "Notes",ExpressionUUID->"6b4e99ce-1c35-4246-8e9d-c3654b0606bd"],

Cell[TextData[{
 "Its directed paths starting at ",
 StyleBox["c", "TI"],
 " are exactly the geodesics from ",
 StyleBox["c", "TI"],
 ", each once, and the paths from ",
 StyleBox["c", "TI"],
 " to a sink are the maximal ones \[LongDash] the geodesics that cannot be \
continued away from ",
 StyleBox["c", "TI"],
 ". It is the graph analogue of the exponential map at ",
 StyleBox["c", "TI"],
 ": every direction the observer can walk in without turning back towards ",
 StyleBox["c", "TI"],
 ", with the branching left in."
}], "Notes",ExpressionUUID->"09685735-7d82-4ccf-afcb-a6b85467dde3"],

Cell["\<\
With several sources the distance is to the nearest source, so the spray \
grows out of the whole set.\
\>", "Notes",ExpressionUUID->"65b2dcbb-4063-4322-88a3-8f1920cfe5d7"],

Cell["\<\
The pair form picks geodesics between each pair and takes the union of their \
path graphs. It enumerates, unlike the other two forms.\
\>", "Notes",ExpressionUUID->"0db61b93-dbc9-4ece-a0f7-ad2f444cf797"],

Cell["Options:", "Notes",ExpressionUUID->"d5b87f4f-58e8-431d-92be-7d223e4e8cc8"],

