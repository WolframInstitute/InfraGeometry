   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9311ed48-407c-41a1-9aa3-fae74a825151"],
 " holds the same family."
}], "ExampleText",ExpressionUUID->"279177fc-f9e0-448d-a1a4-5b89b2066b3b"],

