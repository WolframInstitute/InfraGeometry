     " ", 
     RowBox[{"Spacer", "[", "20", "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e26ea84b-b3f7-41e5-8745-303bdea05b64"],

