Notebook[{

Cell[CellGroupData[{
Cell["InfraPerpendicularBisector", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cc7df7ee-c061-44d9-a5d1-d53d162b0b8f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPerpendicularBisector"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularBisector", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58f18202-a159-4672-985e-c1b7505cfa9b"],
 "\[LineSeparator]",
 "is the perpendicular bisector of ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ": the vertices at equal distance from ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"c7ad4974-2a06-4e65-8b07-21ed8ffc5e86"],

Cell[TextData[{
 "The bisector is ",
 StyleBox["{v : d(p, v) = d(q, v) < \[Infinity]}", "TI"],
 "."
}], "Notes",ExpressionUUID->"bc08ce56-353e-4e67-931c-e768665c1967"],

Cell["\<\
In the plane it is a line. On a graph it can be a line, a thick region or \
empty:\
\>", "Notes",ExpressionUUID->"e25d79c0-94e8-4cd2-a83c-ec720be9c0e2"],

Cell[TextData[{
 "In a bipartite graph, such as the square grid, ",
 StyleBox["d(p, v) \[Minus] d(q, v)", "TI"],
 " has the parity of ",
 StyleBox["d(p, q)", "TI"],
 ", so at odd distance the bisector is empty."
}], "Notes",ExpressionUUID->"2f0faaa3-05c6-4fff-b8d2-d24497043bdb"],

Cell[TextData[{
 "On the square grid, for ",
 StyleBox["q", "TI"],
 " = ",
 StyleBox["p", "TI"],
 " + (2, 0) it is the line ",
 StyleBox["x", "TI"],
 " = 1 relative to ",
 StyleBox["p", "TI"],
 ". For ",
 StyleBox["q", "TI"],
 " = ",
 StyleBox["p", "TI"],
 " + (",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["a", "TI"],
 ") it contains two whole quadrants, the bisector of the \[ScriptL]\.b9 \
norm."
}], "Notes",ExpressionUUID->"8b0437d3-3e55-4640-9d12-196c9b8be43c"],

Cell[TextData[{
 "The bisector need not separate ",
 StyleBox["p", "TI"],
 " from ",
 StyleBox["q", "TI"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPlane"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPlane", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7e1257af-2726-4105-a903-46369fcca022"],
 " is the family of separating sets."
}], "Notes",ExpressionUUID->"b768f3c7-9784-4d48-9ef3-61ac7a60bbcb"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularBisector"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularBisector", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6f2e619e-c739-4bc1-a794-e952cf200969"],
 " is a symbolic object. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "55426f2a-3dca-450b-a12b-80333ef73c91"],
 " reads its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bed825c0-1ee7-4220-b0b9-b15b3bab5e94"],
 ", 1 on every vertex of the bisector, its ",
 Cell[BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16033461-a4d9-4a21-8861-2b4e9fd240e3"],
 ", ",
 Cell[BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7d03f96-ef32-42f4-9bc3-c9d7e9dc3d4a"],
 " and ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc241b13-07a0-460a-b6db-c8823d40cb1a"],
 ". Its ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7765c337-3be0-4c74-8bbe-16e5e13bcf1e"],
 " is 1: the bisector is one vertex set, even when empty. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMemberQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["bisector", "TI"], ",", " ", 
    StyleBox["vs", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01183cfe-8d8c-4e99-bb81-d8473ccd5bd3"],
 " tests whether ",
 StyleBox["vs", "TI"],
 " is the whole bisector."
}], "Notes",ExpressionUUID->"06b3a670-444b-45b7-84cb-0c861fadf628"],

Cell[TextData[{
 "Equal anchors give their connected component. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEquidistantSet"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEquidistantSet", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f3879536-4eea-4117-9409-5c8dd04444e1"],
 " is the bisector of several points."
}], "Notes",ExpressionUUID->"309407c3-1246-4f78-8406-f03b4b6bd663"]
}, Open  ]],

