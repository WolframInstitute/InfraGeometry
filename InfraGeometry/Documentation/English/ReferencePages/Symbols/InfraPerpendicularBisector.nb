Cell["Draw the complete support.", "ExampleText",ExpressionUUID->"15ab7bc7-6933-4413-b9bf-c9d7d23f584b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CompleteGraph", "[", " ", "3", " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"InfraSubstrateHighlight", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"{", " ", 
       RowBox[{"InfraPerpendicularBisector", "[", " ", 
        RowBox[{"1", ",", " ", "2"}], " ", "]"}], " ", "}"}]}], " ", "]"}]}], 
   " ", "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c96dec80-ebb1-48a1-b628-8af5c454ac49"],

