Cell["At odd distance on the square grid the bisector is empty:", \
"ExampleText",ExpressionUUID->"b35bdbf9-af2e-4a33-865c-5931d0105cf5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraPerpendicularBisector", "[", 
        RowBox[{"p", ",", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"p", ",", " ", "r"}], "]"}], ",", " ", 
           RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}], ",",
        " ", "\"\<CountingMeasure\>\""}], "]"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "1", ",", " ", "4"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"33614033-e715-427c-8329-13b900fef1a4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "48", ",", "0", ",", "10"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"64ba18f2-b1e5-498f-a09c-fc94ce4898f7"]
}, Open  ]],

Cell["\<\
Several properties at once. The bisector is one vertex set, so its \
cardinality is 1:\
\>", "ExampleText",ExpressionUUID->"12c5fd70-35ca-4dc3-a925-17937c632908"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"bisector", " ", "=", " ", 
     RowBox[{"InfraPerpendicularBisector", "[", 
      RowBox[{"p", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"p", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"InfraMeasurement", "[", 
    RowBox[{"g", ",", " ", "bisector", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Cardinality\>\"", ",", " ", "\"\<CountingMeasure\>\"", ",",
        " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"02072fbd-7602-450c-8e65-70c65dcb057e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Cardinality\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"CountingMeasure\"\>", "\[Rule]", "48"}], ",", 
   RowBox[{"\<\"RiemannianMeasure\"\>", "\[Rule]", "34"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"135b66c5-2b69-4520-b3b1-1cc49841cad5"]
