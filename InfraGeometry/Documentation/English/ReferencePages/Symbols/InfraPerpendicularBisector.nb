Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"bisector", " ", "=", " ", 
     RowBox[{"InfraPerpendicularBisector", "[", 
      RowBox[{"p", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"p", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"AssociationQ", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "bisector", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Cardinality\>\"", ",", " ", "\"\<CountingMeasure\>\""}],
          "}"}]}], "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", "bisector", ",", " ", "#"}], "]"}], " ", "&"}],
       " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Cardinality\>\"", ",", " ", "\"\<CountingMeasure\>\""}], 
       "}"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5efc7ab2-7b21-49ce-bc17-5aaec7ada958"],

