Notebook[{

Cell[CellGroupData[{
Cell["InfraPerpendicularBisector", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f3fd5805-afcb-49c1-bbdf-4003eedebf68"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPerpendicularBisector"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularBisector", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "259d148e-1882-4538-83c6-54b5bf0cf60f"],
 "\[LineSeparator]",
 "is the perpendicular bisector of ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ": the vertices at equal distance from ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"84c6cc9c-ab84-4e4a-9eb3-938267f791b8"],

Cell[TextData[{
 "The bisector is ",
 StyleBox["{v : d(p, v) = d(q, v) < \[Infinity]}", "TI"],
 "."
}], "Notes",ExpressionUUID->"7792f6c6-c090-4c4d-8770-993cc9ac5ebe"],

Cell["\<\
In the plane it is a line. On a graph it can be a line, a thick region or \
empty:\
\>", "Notes",ExpressionUUID->"7e3be058-03c7-461e-8ebf-6852e235a04b"],

Cell[TextData[{
 "In a bipartite graph, such as the square grid, ",
 StyleBox["d(p, v) \[Minus] d(q, v)", "TI"],
 " has the parity of ",
 StyleBox["d(p, q)", "TI"],
 ", so at odd distance the bisector is empty."
}], "Notes",ExpressionUUID->"5e5f919c-7e1a-4f17-ad3b-506c3072a24b"],

Cell[TextData[{
 "On the square grid, for ",
 StyleBox["q", "TI"],
 " = ",
 StyleBox["p", "TI"],
 " + (2, 0) it is the line ",
 StyleBox["x", "TI"],
 " = 1 relative to ",
 StyleBox["p", "TI"],
 ". For ",
 StyleBox["q", "TI"],
 " = ",
 StyleBox["p", "TI"],
 " + (",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["a", "TI"],
 ") it contains two whole quadrants, the bisector of the \[ScriptL]\.b9 \
norm."
}], "Notes",ExpressionUUID->"1f05f218-25ef-44a5-87c1-35f6752cf943"],

Cell[TextData[{
 "The bisector need not separate ",
 StyleBox["p", "TI"],
 " from ",
 StyleBox["q", "TI"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPlane"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPlane", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8277153d-e7ac-4902-b1bf-ff0d792b3f43"],
 " is the family of separating sets."
}], "Notes",ExpressionUUID->"1a8815b7-d600-4ab2-81fb-a7fae81c87c4"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularBisector"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularBisector", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d08177c5-ce53-4d95-8d8a-60b8b7d1a6f6"],
 " is a symbolic object. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "599cb584-d1b1-4084-9110-78d40a229e7b"],
 " reads its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c30bc65-9bda-49b2-968d-32774eccc4c4"],
 ", 1 on every vertex of the bisector, its ",
 Cell[BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7253c07c-d66a-4aa5-a981-264b1e6c08e5"],
 ", ",
 Cell[BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5080dd8c-aa4c-4ec3-a436-00e3e4d662a9"],
 " and ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b678795-85dd-45d0-a028-f912ed8f247f"],
 ". Its ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0d62c5e-68f7-48c3-8942-ae0b057ba4e5"],
 " is 1: the bisector is one vertex set, even when empty. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMemberQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["bisector", "TI"], ",", " ", 
    StyleBox["vs", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5243aa99-e74c-4fc1-aad4-5fba2164cd86"],
 " tests whether ",
 StyleBox["vs", "TI"],
 " is the whole bisector."
}], "Notes",ExpressionUUID->"4257b595-29fb-468c-aa0b-c35f68565094"],

Cell[TextData[{
 "Equal anchors give their connected component. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEquidistantSet"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEquidistantSet", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "86f8a223-1aa6-4a05-95cd-0defcadbc8cc"],
 " is the bisector of several points."
}], "Notes",ExpressionUUID->"c7110a77-d581-433c-8436-3bd75d0e973a"]
}, Open  ]],

