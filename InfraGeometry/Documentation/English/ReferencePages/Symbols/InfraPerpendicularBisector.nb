Notebook[{

Cell[CellGroupData[{
Cell["InfraPerpendicularBisector", "ObjectName",ExpressionUUID->"eba471d3-bb6a-41a4-8be6-334a5a0efd44"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"543a6229-6b69-444f-8072-b22b426b200c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPerpendicularBisector"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularBisector", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a21011f-2049-4668-984d-61d29a7d36c7"],
 "\[LineSeparator]",
 "is the locus of vertices at equal finite graph distance from ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"851e415f-8466-40fa-b7b9-ddb0e3de3d4f"],

Cell[TextData[{
 "On a graph with path distance ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "270a1636-ad76-4542-a259-36f4d6d4abe1"],
 ", the locus is the unique vertex set ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["v", "TI"]}], ":", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["p", "TI"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["q", "TI"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "<", "\[Infinity]", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a240f382-9752-49d7-a9e5-0516e5092bde"],
 ". The head is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1a1adcd9-89f3-4e83-9964-ddf7212310bb"],
 " reads its properties on a concrete graph. Its \"VertexDensity\" has weight \
1 at each vertex of the locus. Its \"Cardinality\" is 1, including for the \
empty locus; \"CountingMeasure\" counts its vertices. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5ee94a83-c4ba-4c32-b4b7-7220bd678aaa"],
 "[",
 StyleBox["graph", "TI"],
 ", ",
 StyleBox["bisector", "TI"],
 ", ",
 StyleBox["vertices", "TI"],
 "] tests whether ",
 StyleBox["vertices", "TI"],
 " is the complete locus, independently of ordering or repeated vertices. \
There is no random bisector: use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "29e9968a-476c-4a56-a129-ccc90b8cbbbb"],
 " with an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b9c95ba0-6f67-42fc-a30b-7c6039d3c02f"],
 " token to choose a point of the locus."
}], "Notes",ExpressionUUID->"8cfcdb00-e347-4222-9eaa-b322de46870e"],

Cell[TextData[{
 "The graph must be finite, simple, undirected and unweighted, with valid \
vertex anchors. Equal anchors give their connected component; disconnected \
anchors give the empty set. The locus need not separate the anchors or form a \
line, and it does not assert an angle. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPlane"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPlane", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1fc069d9-e3f6-4be3-b56a-246d345d6756"],
 " instead describes a family of separating vertex sets."
}], "Notes",ExpressionUUID->"1a82d6fb-59ef-4492-890a-221ccb8a6bab"],

Cell[TextData[{
 "The inert multipoint analogue is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEquidistantSet"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEquidistantSet", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fe3cf8ff-e11e-471d-9da7-08091f294f72"],
 "[{",
 StyleBox["p1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["pn", "TI"],
 "}], the equidistant locus ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["v", "TI"]}], ":", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], "1"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", "\[Ellipsis]", "=", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["n", "TI"]], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "<", "\[Infinity]", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d19aedb6-cde0-4074-88b3-42e7c0383a74"],
 ". It is the intersection of the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70d4fe70-47b1-4452-beff-c29eaf03734f"],
 " consecutive perpendicular bisectors. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4cf9763f-0c43-4aab-8cda-270e13cbcf31"],
 " reads its complete locus on the graph. The existing ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraEquidistantSet"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraEquidistantSet", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e0ea26c5-2826-49df-ac3b-8fe0cad3f2a1"],
 "[",
 StyleBox["graph", "TI"],
 ", {",
 StyleBox["p1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["pn", "TI"],
 "}] returns a vertex list on a connected substrate; its optional \
distance-difference window gives a thickened locus. For three points this is \
the graph analogue of the circumcentre locus."
}], "Notes",ExpressionUUID->"9ebc355c-970b-439f-97ab-4be5780fa06f"],

Cell["\<\
Supported measurements are \"VertexDensity\", \"Cardinality\", \
\"CountingMeasure\", \"Subgraph\" and \"RiemannianMeasure\". \
\"RiemannianMeasure\" counts support vertices whose neighbours all belong to \
the support. Unsupported arguments and properties stay unevaluated.\
\>", "Notes",ExpressionUUID->"67d12824-a1c3-45df-84ee-1fc31071ee32"]
}, Open  ]],

