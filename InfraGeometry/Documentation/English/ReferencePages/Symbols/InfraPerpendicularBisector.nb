Cell["At odd distance on the square grid the bisector is empty:", \
"ExampleText",ExpressionUUID->"6d95df07-f3f3-4146-8fb2-8bddae9a6c91"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraPerpendicularBisector", "[", 
        RowBox[{"p", ",", " ", 
         RowBox[{"RandomInfraPoint", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"p", ",", " ", "r"}], "]"}], ",", " ", 
           RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "]"}], ",",
        " ", "\"\<CountingMeasure\>\""}], "]"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "1", ",", " ", "4"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7eb24b2c-f233-4706-8561-a5a4f292b631"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "48", ",", "0", ",", "10"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f5fb44d7-a66d-40ae-8c94-5fd4e879e918"]
}, Open  ]],

Cell["A random point of the bisector:", "ExampleText",ExpressionUUID->"5ab5a6a7-086e-4eca-bb8f-98ed2079cd0c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"p", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"x", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraPerpendicularBisector", "[", 
        RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraPerpendicularBisector", "[", 
        RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "p", ",", " ", "q", ",",
        " ", "x"}], "}"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", "p", ",", " ", "x"}], "]"}], ",", " ", 
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", "q", ",", " ", "x"}], "]"}]}], "}"}]}], ",", 
     "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3f27e0b6-b5c4-4b5e-b777-1361fb34e321"],

