Cell["\<\
Read the bisector of vertices 1 and 3 on a four-cycle. Its vertices are 2 and \
4.\
\>", "ExampleText",ExpressionUUID->"3834e00a-2923-4402-8cf7-cdc4220b2dbc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"InfraMeasurement", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"InfraPerpendicularBisector", "[", " ", 
       RowBox[{"1", ",", " ", "3"}], " ", "]"}], ",", 
      " ", "\"\<VertexDensity\>\""}], " ", "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"55b5a39c-c8b8-4876-89f4-931bc03b859f"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"2", "\[Rule]", "1"}], ",", 
   RowBox[{"4", "\[Rule]", "1"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"784c3f57-638f-4dc4-ac55-744b3da3fd52"]
}, Open  ]],

Cell["Draw the complete locus.", "ExampleText",ExpressionUUID->"512d9bf8-d8ff-46a5-a26a-5e14cc37f03d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"InfraSubstrateHighlight", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"{", " ", 
       RowBox[{"InfraPerpendicularBisector", "[", " ", 
        RowBox[{"1", ",", " ", "3"}], " ", "]"}], " ", "}"}]}], " ", "]"}]}], 
   " ", "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ae70b3a6-96e1-4737-9d1d-3e5a80808135"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3, 4}, {Null, 
       SparseArray[
       Automatic, {4, 4}, 0, {
        1, {{0, 2, 4, 6, 8}, {{2}, {4}, {1}, {3}, {2}, {4}, {1}, {3}}}, 
         Pattern}]}, {
      GraphLayout -> "CircularEmbedding", 
       VertexShapeFunction -> {4 -> (Append[{
            RGBColor[0.790588, 0.201176, 0.], 
            Opacity[1.]}, 
           Disk[#, 1 #3]]& ), 2 -> (Append[{
            RGBColor[0.790588, 0.201176, 0.], 
            Opacity[1.]}, 
           Disk[#, 1 #3]]& )}}]]}, 
    TagBox[GraphicsGroupBox[{
       {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], 
        LineBox[{{
          DynamicLocation["VertexID$1", Automatic, Center], DynamicLocation[
           "VertexID$2", Automatic, Center]}, {
          DynamicLocation["VertexID$1", Automatic, Center], DynamicLocation[
           "VertexID$4", Automatic, Center]}, {
          DynamicLocation["VertexID$2", Automatic, Center], DynamicLocation[
           "VertexID$3", Automatic, Center]}, {
          DynamicLocation["VertexID$3", Automatic, Center], DynamicLocation[
           "VertexID$4", Automatic, Center]}}]}, 
       {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
        TagBox[DiskBox[{-1., 1.0106430996148606`*^-15}, 0.02261146496815286],
         "DynamicName",
         BoxID -> "VertexID$1"], 
        TagBox[
         {RGBColor[0.790588, 0.201176, 0.], Opacity[1.], 
          DiskBox[{-7.044813998280222*^-16, 1.}, 0.02261146496815286]},
         "DynamicName",
         BoxID -> "VertexID$2"], 
        TagBox[DiskBox[{1., -1.133107779529596*^-15}, 0.02261146496815286],
         "DynamicName",
         BoxID -> "VertexID$3"], 
        TagBox[
         {RGBColor[0.790588, 0.201176, 0.], Opacity[1.], 
          DiskBox[{6.049014748177263*^-16, -1.}, 0.02261146496815286]},
         "DynamicName",
         BoxID -> "VertexID$4"]}}],
     MouseAppearanceTag["NetworkGraphics"]],
    AllowKernelInitialization->False]],
  DefaultBaseStyle->"NetworkGraphics",
  FormatType->TraditionalForm,
  FrameTicks->None]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"da584357-d4d4-4a4d-a764-ba16e58d54f9"]
}, Open  ]],

Cell["Choose a point on the bisector.", "ExampleText",ExpressionUUID->"1748db8c-4827-4cd9-933d-46611f0bde4f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"RandomInfraPoint", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"InfraPoint", "[", " ", 
       RowBox[{"InfraPerpendicularBisector", "[", " ", 
        RowBox[{"1", ",", " ", "3"}], " ", "]"}], " ", "]"}], ",", " ", 
      RowBox[{"RandomSeeding", " ", "->", " ", "71"}]}], " ", "]"}]}], " ", 
   "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"01d772f9-16b0-46fe-b9ee-f1bc3be09c78"],

Cell[BoxData["2"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"e3ee99e0-b8dd-4222-ae40-3aadc0151aa1"]
}, Open  ]],

Cell["\<\
Find the vertices equidistant from three anchors. On the complete graph with \
four vertices, the answer is {4}.\
\>", "ExampleText",ExpressionUUID->"36bd34b9-7916-4ec9-94b0-28597495728d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"Keys", " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", " ", 
    RowBox[{
     RowBox[{"CompleteGraph", "[", " ", "4", " ", "]"}], ",", " ", 
     RowBox[{"InfraEquidistantSet", "[", " ", 
      RowBox[{"{", " ", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], " ", "}"}], " ", "]"}], ",",
      " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"accdcf7e-f6d1-49f5-9f36-a5bfca3888e5"],

Cell[BoxData[
 RowBox[{"{", "4", "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"563aa5a3-8abc-4dd5-bc4c-1e57d9bd969e"]
}, Open  ]]
}, Open  ]],

