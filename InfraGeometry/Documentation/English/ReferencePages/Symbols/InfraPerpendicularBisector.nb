Cell[TextData[{
 "On the square grid the shape depends on the direction from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ": a straight line, a staircase, two quadrants:"
}], "ExampleText",ExpressionUUID->"88eb6ac1-e5e6-4e58-81ff-d02d7c98f98d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"xy", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"q", " ", "=", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Keys", " ", "@", " ", 
            RowBox[{"Select", "[", 
             RowBox[{"xy", ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"#", " ", "-", " ", 
                 RowBox[{"xy", "[", "p", "]"}]}], " ", "==", " ", "offset"}], 
               " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "      ", 
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"InfraPerpendicularBisector", "[", 
             RowBox[{"p", ",", " ", "q"}], "]"}], ",", " ", "p", ",", " ", 
            "q"}], "}"}], ",", "\n", "        ", 
          RowBox[{"PlotLabel", " ", "->", " ", 
           RowBox[{"InfraMeasurement", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraPerpendicularBisector", "[", 
              RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
             " ", "\"\<CountingMeasure\>\""}], "]"}]}]}], "]"}]}], "]"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"offset", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], "]"}]}]}],
   "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b15c022a-1fa4-4afe-b2b7-1768ef065678"],

