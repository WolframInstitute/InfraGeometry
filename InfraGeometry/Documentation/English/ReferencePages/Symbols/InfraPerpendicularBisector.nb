Cell["\<\
Read the bisector of vertices 1 and 3 on a four-cycle. Its vertices are 2 and \
4.\
\>", "ExampleText",ExpressionUUID->"f0a84bae-68f0-4c20-91ef-eb3cf0293f95"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"InfraMeasurement", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"InfraPerpendicularBisector", "[", " ", 
       RowBox[{"1", ",", " ", "3"}], " ", "]"}], ",", 
      " ", "\"\<VertexDensity\>\""}], " ", "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"baae405d-a587-4121-b94c-1594c0e39b16"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"2", "\[Rule]", "1"}], ",", 
   RowBox[{"4", "\[Rule]", "1"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d6e85702-9d0b-4d4c-880a-81d6ce9004d4"]
}, Open  ]],

Cell["Draw the complete locus.", "ExampleText",ExpressionUUID->"5484dfb7-4999-4c5d-af41-ae5c3c11a4f0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"InfraSubstrateHighlight", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"{", " ", 
       RowBox[{"InfraPerpendicularBisector", "[", " ", 
        RowBox[{"1", ",", " ", "3"}], " ", "]"}], " ", "}"}]}], " ", "]"}]}], 
   " ", "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1999b3c6-09c8-44d5-a8bf-7b18f9a5a54e"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3, 4}, {Null, 
       SparseArray[
       Automatic, {4, 4}, 0, {
        1, {{0, 2, 4, 6, 8}, {{2}, {4}, {1}, {3}, {2}, {4}, {1}, {3}}}, 
         Pattern}]}, {
      GraphLayout -> "CircularEmbedding", 
       VertexShapeFunction -> {4 -> (Append[{
            RGBColor[0.790588, 0.201176, 0.], 
            Opacity[1.]}, 
           Disk[#, 1 #3]]& ), 2 -> (Append[{
            RGBColor[0.790588, 0.201176, 0.], 
            Opacity[1.]}, 
           Disk[#, 1 #3]]& )}}]]}, 
    TagBox[GraphicsGroupBox[{
       {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], 
        LineBox[{{
          DynamicLocation["VertexID$1", Automatic, Center], DynamicLocation[
           "VertexID$2", Automatic, Center]}, {
          DynamicLocation["VertexID$1", Automatic, Center], DynamicLocation[
           "VertexID$4", Automatic, Center]}, {
          DynamicLocation["VertexID$2", Automatic, Center], DynamicLocation[
           "VertexID$3", Automatic, Center]}, {
          DynamicLocation["VertexID$3", Automatic, Center], DynamicLocation[
           "VertexID$4", Automatic, Center]}}]}, 
       {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
        TagBox[DiskBox[{-1., 1.0106430996148606`*^-15}, 0.02261146496815286],
         "DynamicName",
         BoxID -> "VertexID$1"], 
        TagBox[
         {RGBColor[0.790588, 0.201176, 0.], Opacity[1.], 
          DiskBox[{-7.044813998280222*^-16, 1.}, 0.02261146496815286]},
         "DynamicName",
         BoxID -> "VertexID$2"], 
        TagBox[DiskBox[{1., -1.133107779529596*^-15}, 0.02261146496815286],
         "DynamicName",
         BoxID -> "VertexID$3"], 
        TagBox[
         {RGBColor[0.790588, 0.201176, 0.], Opacity[1.], 
          DiskBox[{6.049014748177263*^-16, -1.}, 0.02261146496815286]},
         "DynamicName",
         BoxID -> "VertexID$4"]}}],
     MouseAppearanceTag["NetworkGraphics"]],
    AllowKernelInitialization->False]],
  DefaultBaseStyle->"NetworkGraphics",
  FormatType->TraditionalForm,
  FrameTicks->None]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"2c87748e-ee75-4068-8f10-d5340dfb7983"]
}, Open  ]],

Cell["Choose a point on the bisector.", "ExampleText",ExpressionUUID->"b6b6c526-f0c2-4be2-a73c-c74c952f4eee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"CycleGraph", "[", " ", "4", " ", "]"}]}], " ", "}"}], ",", 
    "\n", "  ", 
    RowBox[{"RandomInfraPoint", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"InfraPoint", "[", " ", 
       RowBox[{"InfraPerpendicularBisector", "[", " ", 
        RowBox[{"1", ",", " ", "3"}], " ", "]"}], " ", "]"}]}], " ", "]"}]}], 
   " ", "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"65a3e654-c2a7-4b53-9e73-71f4492de6e9"],

Cell[BoxData["2"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"7ff1ecc0-563a-4768-8564-69422e818337"]
}, Open  ]],

Cell["\<\
Find the vertices equidistant from three anchors. On the complete graph with \
four vertices, the answer is {4}.\
\>", "ExampleText",ExpressionUUID->"bc911ff3-0d8b-4282-87de-0d0617753bce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"Keys", " ", "@", " ", 
   RowBox[{"InfraMeasurement", "[", " ", 
    RowBox[{
     RowBox[{"CompleteGraph", "[", " ", "4", " ", "]"}], ",", " ", 
     RowBox[{"InfraEquidistantSet", "[", " ", 
      RowBox[{"{", " ", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], " ", "}"}], " ", "]"}], ",",
      " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"f54d861e-bb87-483c-98b8-f17927db7640"],

Cell[BoxData[
 RowBox[{"{", "4", "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"fb185fcb-1d87-4e41-addd-fb8500dacd39"]
}, Open  ]]
}, Open  ]],

