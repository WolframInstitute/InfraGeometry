Notebook[{

Cell[CellGroupData[{
Cell["InfraPerpendicularBisector", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c62459c5-96c0-485d-988c-f72bdd9503d2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPerpendicularBisector"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPerpendicularBisector", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e9ff013-9876-434c-a338-b7b8ba9e9025"],
 "\[LineSeparator]",
 "is the locus of vertices at equal finite graph distance from ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"08fbb597-60aa-47d9-91c3-52b18a897e94"],

Cell[TextData[{
 "On a graph with path distance ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "130ce7f3-4d72-40a2-94cd-84f2133490a7"],
 ", the locus is the unique vertex set ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["v", "TI"]}], ":", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["p", "TI"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["q", "TI"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "<", "\[Infinity]", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3674c02-bbe2-4b28-86bf-437d0050b3e5"],
 ". The head is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "39edd030-bbfe-41f7-8a97-2c4b5c0908a7"],
 " reads its properties on a concrete graph. Its \"VertexDensity\" has weight \
1 at each vertex of the locus. Its \"Cardinality\" is 1, including for the \
empty locus; \"CountingMeasure\" counts its vertices. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3cce7fff-3df4-4656-a073-2f6129863338"],
 "[",
 StyleBox["graph", "TI"],
 ", ",
 StyleBox["bisector", "TI"],
 ", ",
 StyleBox["vertices", "TI"],
 "] tests whether ",
 StyleBox["vertices", "TI"],
 " is the complete locus, independently of ordering or repeated vertices. \
There is no random bisector: use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "19055597-2487-4af8-9d9b-d94c50276b2c"],
 " with an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "67255523-6a80-4849-b5dc-61cbfe8aafec"],
 " token to choose a point of the locus."
}], "Notes",ExpressionUUID->"a5b228ff-0957-402c-9d83-e29df224f758"],

Cell[TextData[{
 "The graph must be finite, simple, undirected and unweighted, with valid \
vertex anchors. Equal anchors give their connected component; disconnected \
anchors give the empty set. The locus need not separate the anchors or form a \
line, and it does not assert an angle. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPlane"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPlane", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0c0cc9d9-444e-4dbd-86ff-2886d549bebe"],
 " instead describes a family of separating vertex sets."
}], "Notes",ExpressionUUID->"53ba07c0-f7c3-49e7-8d17-414d7d340c89"],

Cell[TextData[{
 "The inert multipoint analogue is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEquidistantSet"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraEquidistantSet", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ccf7ceb2-0aed-4014-96b9-213933ed6def"],
 "[{",
 StyleBox["p1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["pn", "TI"],
 "}], the equidistant locus ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["v", "TI"]}], ":", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], "1"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", "\[Ellipsis]", "=", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["n", "TI"]], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "<", "\[Infinity]", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ac45285-efae-46ab-934a-00ffa8746377"],
 ". It is the intersection of the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a1e93b8-bab4-4b6b-8799-37f9581bdb04"],
 " consecutive perpendicular bisectors. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "00e80b94-0db0-448e-ae8d-f34d95e386ae"],
 " reads its complete locus on the graph. The existing ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraEquidistantSet"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraEquidistantSet", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "23ec6e31-940a-4bbd-b5dc-d368693839ae"],
 "[",
 StyleBox["graph", "TI"],
 ", {",
 StyleBox["p1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["pn", "TI"],
 "}] returns a vertex list on a connected substrate; its optional \
distance-difference window gives a thickened locus. For three points this is \
the graph analogue of the circumcentre locus."
}], "Notes",ExpressionUUID->"ca6724dd-8cfb-4e06-b5ef-e8e648a93815"],

Cell["\<\
Supported measurements are \"VertexDensity\", \"Cardinality\", \
\"CountingMeasure\", \"Subgraph\" and \"RiemannianMeasure\". \
\"RiemannianMeasure\" counts support vertices whose neighbours all belong to \
the support. Unsupported arguments and properties stay unevaluated.\
\>", "Notes",ExpressionUUID->"e2559998-3687-4c58-bc6f-f03c1af99cd3"]
}, Open  ]],

