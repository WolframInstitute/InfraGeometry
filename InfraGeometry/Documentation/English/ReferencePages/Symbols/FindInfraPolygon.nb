Cell[TextData[{
 "The count-less call is one polygon, deterministic; a strict count is exact, \
and ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c5f2f63-430e-4535-add4-8a653fe09e5c"],
 " when the class is smaller."
}], "ExampleText",ExpressionUUID->"597298f7-70e5-4696-b22c-d6106e4401b0"],

