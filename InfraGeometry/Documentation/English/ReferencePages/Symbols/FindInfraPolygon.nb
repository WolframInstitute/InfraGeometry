     "f4bb0e27-a014-4410-832c-fdb6189ae161"], Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "27853d0f-e949-4e18-9858-5854df824d5f"],
     " (default), ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "fb2a9002-cc7e-44ff-9c92-85e41da7ed1e"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
        RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "49d03651-3b0f-44ac-b763-a4844a4c9cac"],
     ", ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3ff3b46d-14dc-41f8-a15d-10a0aca836ae"],
     ", ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "fad5eaf5-5ce5-4985-aa7f-ce8dc33f63a6"]
    }], "TableText",ExpressionUUID->"9a6f3473-d0d5-460c-a049-b9a1fc5c990c"], 
    Cell[TextData[{
     "forwarded to the side geodesics. ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "d62b8614-37cc-44b0-9f5b-7cef385c6b85"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "430d3012-57f6-4786-b56f-ced9c764cb1d"],
     " to ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "41aa8f58-128a-4cd6-8027-21ef29f57254"],
     ", a bounded or absent count to ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b796cdd8-5d7a-4b32-8dcf-294edba708ac"],
     ". The class is the same under every value; ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5ae18dd9-039b-4ef9-b94c-5429ac84073c"],
     " and ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "91854e86-1eec-40f2-a983-d5ba786a0faa"],
     " take each side's geodesics in candidate order, ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c4213d4e-44a4-4a1c-b83f-e99a3e5c02c0"],
     " in random order, seeded by an ambient ",
     Cell[BoxData["SeedRandom"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "dc84e1d8-a666-4b34-b4c8-e0a2f523c15b"],
     ". ",
     Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "72e2ccac-a835-4ba3-a6c4-05732af63616"],
     " is accepted and inert: the sides come off geodesic pools, which have \
no frontier to cap."
    }], "TableText",ExpressionUUID->"8648bcdc-de05-4538-b7ce-025b10182f3a"]}
  }]], "3ColumnTableMod",ExpressionUUID->"d08fe27b-a43a-46e3-bb76-\
9adb6aa56c9f"],

Cell[TextData[{
 "Sides chosen by a local rule \[LongDash] straightest, curvature-minimising \
\[LongDash] are not a polygon option: build them with ",
 Cell[BoxData[
