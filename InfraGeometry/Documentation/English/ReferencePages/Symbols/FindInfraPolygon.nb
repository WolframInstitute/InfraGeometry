Cell["Method", "ExampleSubsection",ExpressionUUID->"791cf220-3f6d-4444-b360-c35352668f4c"],

Cell[TextData[{
 "The class is the same under every ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68fb3383-a521-40ff-a855-f7f788db44ed"],
 "; only the order in which polygons come off it differs."
}], "ExampleText",ExpressionUUID->"59dacaff-c3bf-424c-8f17-0b4c4f79b91b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"SameQ", " ", "@@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Sort", " ", "@", " ", 
        RowBox[{"FindInfraPolygon", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "15", ",", " ", "23", ",", " ", "11"}], 
           "}"}], ",", " ", "All", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "#"}]}], "]"}]}], " ", "&"}], " ",
       "/@", "\n", "     ", 
      RowBox[{"{", 
       RowBox[{"\"\<Exhaustive\>\"", ",", " ", "\"\<Greedy\>\"", ",", 
        " ", "\"\<RandomGreedy\>\""}], "}"}]}], ")"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fbc8067e-a5b7-4c62-b30d-6cd5e06eb97c"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d411511e-0ff8-47a6-be13-866005d54451"]
