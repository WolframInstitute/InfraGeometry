  $Line = 0; Null]], "ExampleSection",
 CellID->258228157,ExpressionUUID->"1cd6234d-1e3c-431d-9989-71f3025eee95"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Properties & Relations", "ExampleSection",ExpressionUUID->
   "d18b1e1f-4c4c-49a5-bb54-1e5e145ddf4e"],
  $Line = 0; Null]], "ExampleSection",
 CellID->2123667759,ExpressionUUID->"0e0d5f37-f3c9-4474-a22b-9f10dcc8b438"],

Cell[TextData[{
 "Every polygon satisfies ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPolygonQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPolygonQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6b1a85cb-637f-4f20-873a-ec2521821a90"],
 ", and a three-corner polygon is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraTriangle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraTriangle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "eea4d7bc-55ec-4677-8c3e-a772efb9d258"],
 "."
}], "ExampleText",ExpressionUUID->"a93ccd7c-083e-475b-bf0f-c4956079a93e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraPolygonQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"FindInfraPolygon", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3", ",", " ", "9"}], "}"}], ",", " ", 
         "All"}], "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"FindInfraPolygon", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3", ",", " ", "9"}], "}"}], ",", " ", 
        "All"}], "]"}], " ", "===", " ", 
      RowBox[{"FindInfraTriangle", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3", ",", " ", "9"}], "}"}], ",", " ", 
        "All"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"31c4b474-57e8-4945-9e71-12bdc9ff7d3a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6420d710-018d-42d1-96ff-c75b93e5e4ee"]
}, Open  ]],

Cell["\<\
The perimeter is the sum of the corner distances around the cycle.\
\>", "ExampleText",ExpressionUUID->"a88042e6-97eb-4028-9b86-2704d0210d6f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "15", ",", " ", "23", ",", " ", "11"}], "}"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"EdgeCount", " ", "/@", " ", 
      RowBox[{"FindInfraPolygon", "[", 
       RowBox[{"g", ",", " ", "corners"}], "]"}]}], "]"}], " ", "===", "\n", 
    "    ", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", "##"}], "]"}], " ", "&"}], " ", "@@@", " ", 
      RowBox[{"Partition", "[", 
       RowBox[{
        RowBox[{"Append", "[", 
         RowBox[{"corners", ",", " ", 
          RowBox[{"First", " ", "@", " ", "corners"}]}], "]"}], ",", " ", "2",
         ",", " ", "1"}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7b970d0f-6f30-47b9-81ba-a59ecaf7ad4e"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"1b8b58e2-1fb0-4e1d-b37c-1687b1abe9a0"]
}, Open  ]]
}, Open  ]],

