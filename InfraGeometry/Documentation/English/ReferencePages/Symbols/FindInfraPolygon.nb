   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2e1c1785-431b-410b-b8ac-00ec0f9016e7"],
 " and assemble the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "094e9e83-c2ce-47b9-aa07-99de759ba553"],
 " of sides."
}], "Notes",ExpressionUUID->"7c322878-6199-4e2d-a859-d64b81163689"],

