Cell[TextData[{
 "The count-less call is one polygon, deterministic; a strict count is exact, \
and ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dcc19f5-c739-4eaf-a3b7-4d9b1cca8cef"],
 " when the class is smaller."
}], "ExampleText",ExpressionUUID->"62f403e6-48b3-4f7f-86e6-e203f2fb81fb"],

