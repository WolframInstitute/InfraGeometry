Cell["Method", "ExampleSubsection",ExpressionUUID->"c439047b-d218-41d1-b211-53894d25fcfe"],

Cell[TextData[{
 "The class is the same under every ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01d7928e-86dd-4375-b52e-4a2382bd09f3"],
 "; only the order in which polygons come off it differs."
}], "ExampleText",ExpressionUUID->"9e5f4415-ab3f-4c77-8bba-6996e15012ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"SameQ", " ", "@@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Sort", " ", "@", " ", 
        RowBox[{"FindInfraPolygon", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "15", ",", " ", "23", ",", " ", "11"}], 
           "}"}], ",", " ", "All", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "#"}]}], "]"}]}], " ", "&"}], " ",
       "/@", "\n", "     ", 
      RowBox[{"{", 
       RowBox[{"\"\<Exhaustive\>\"", ",", " ", "\"\<Greedy\>\"", ",", 
        " ", "\"\<RandomGreedy\>\""}], "}"}]}], ")"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4eb1a672-4719-41aa-97ae-362fb1de3d36"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"4c84f651-4525-4c0e-ad82-d322baf6c589"]
