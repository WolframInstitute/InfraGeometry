Notebook[{

Cell[CellGroupData[{
Cell["FindInfraPolygon", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ee306607-0ddf-48d0-b286-9f1bc918625a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPolygon"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPolygon", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pn", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f7a8170-e65f-4851-ab8d-efbfd0238b68"],
 "\[LineSeparator]",
 "gives one polygon with corners ",
 StyleBox["p1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["pn", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " \[LongDash] a geodesic between each pair of consecutive corners, the last \
side returning to ",
 StyleBox["p1", "TI"],
 " \[LongDash] as the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0044f1a-4460-4af4-843a-27f5359c0f8c"],
 " of its sides, one directed path graph each.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a24a6465-7e7c-41c0-a4ec-198c434ac220"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPolygon"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPolygon", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pn", "TI"]}], "}"}], ",", " ", 
    StyleBox["m", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "879cdf7e-cf49-4fdf-85c9-6dedae6bdbf0"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09fe44d9-e6f3-4d77-8103-d29ea70e41b3"],
 " of exactly ",
 StyleBox["m", "TI"],
 " polygons or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dfd25780-e718-43cb-b07d-c7bd8ff150b8"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "m", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc315f16-fd49-41ed-902e-772da08f5ccb"],
 " gives up to ",
 StyleBox["m", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2828a504-09b7-4909-ad0f-be5a366fcfd5"],
 " gives the whole class."
}], "Usage",ExpressionUUID->"cc05eb9e-2735-4a84-b9a7-edb9a5dc28e1"],

Cell[TextData[{
 "A polygon with corners ",
 StyleBox["p1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["pn", "TI"],
 " (",
 StyleBox["n", "TI"],
 " \[GreaterEqual] 3) is a cyclic sequence of ",
 StyleBox["n", "TI"],
 " geodesics, the ",
 StyleBox["i", "TI"],
 "-th from ",
 StyleBox["pi", "TI"],
 " to ",
 StyleBox["p(i+1)", "TI"],
 " and the last from ",
 StyleBox["pn", "TI"],
 " back to ",
 StyleBox["p1", "TI"],
 ". Corners are vertices; each polygon is the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27caee43-7e36-4eff-aa26-430c279f06ca"],
 " of its ",
 StyleBox["n", "TI"],
 " sides, one directed path graph each, and its perimeter is the total edge \
count of the sides."
}], "Notes",ExpressionUUID->"fade0381-560b-419b-a8ec-abb98a9c1eec"],

Cell[TextData[{
 "The class is the Cartesian ",
 StyleBox["product",
  FontWeight->"Bold"],
 " of the per-side geodesic classes, so the count multiplies: a side with ",
 StyleBox["k", "TI"],
 " geodesics contributes a factor ",
 StyleBox["k", "TI"],
 ". On a 5\[Times]5 grid the square on the four corners has one member, while \
the diamond on the four side midpoints has 6^4 = 1296, every side being a \
diagonal with six geodesics."
}], "Notes",ExpressionUUID->"c70221c5-0ab1-4ff7-acc4-26bfb916aa6a"],

Cell["\<\
Nothing in the definition keeps the sides apart. A side may run back over \
another: on the 3\[Times]3 grid with corners 1, 3, 9 the side from 9 to 1 may \
retrace the two others, and the class admits it, since each side is a \
geodesic on its own.\
\>", "Notes",ExpressionUUID->"6b4b465c-27eb-41b4-b17a-2d06f3fcdf96"],

Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "89574842-803b-4adb-ab61-479fefebaf6b"],
 " forms the product. A bounded count never does: it streams that many \
geodesics per side and reads the first members of their product off a \
mixed-radix index, so the count-less call \[LongDash] one polygon, the first \
geodesic of every side \[LongDash] is cheap and deterministic, and a strict \
count is exact."
}], "Notes",ExpressionUUID->"8885a4d5-7d41-4e62-aad4-497f102b8312"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d00d8566-4fb5-4d72-a74d-ab3a304c0b31"], Cell["Option", "TableText",
