Cell[TextData[{
 "Every polygon satisfies ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPolygonQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPolygonQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6eddffd1-39d3-4e4f-8a7c-bde31a58800f"],
 ", and a three-corner polygon is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraTriangle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraTriangle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "08ef2d47-8718-4196-9203-a7a8ba4e38ef"],
 "."
}], "ExampleText",ExpressionUUID->"913f4930-c8d4-4b89-adda-db4662814ebb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraPolygonQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"FindInfraPolygon", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3", ",", " ", "9"}], "}"}], ",", " ", 
         "All"}], "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"FindInfraPolygon", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3", ",", " ", "9"}], "}"}], ",", " ", 
        "All"}], "]"}], " ", "===", " ", 
      RowBox[{"FindInfraTriangle", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3", ",", " ", "9"}], "}"}], ",", " ", 
        "All"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2e83a8ec-aa7c-46ab-9e11-4bbe691af152"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"3ec09fe9-db92-4083-9377-e40a3078d20e"]
}, Open  ]],

Cell["\<\
The perimeter is the sum of the corner distances around the cycle.\
\>", "ExampleText",ExpressionUUID->"7cc0c670-f86b-4e52-8e54-52c926165c6f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "15", ",", " ", "23", ",", " ", "11"}], "}"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"EdgeCount", " ", "/@", " ", 
      RowBox[{"FindInfraPolygon", "[", 
       RowBox[{"g", ",", " ", "corners"}], "]"}]}], "]"}], " ", "===", "\n", 
    "    ", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", "##"}], "]"}], " ", "&"}], " ", "@@@", " ", 
      RowBox[{"Partition", "[", 
       RowBox[{
        RowBox[{"Append", "[", 
         RowBox[{"corners", ",", " ", 
          RowBox[{"First", " ", "@", " ", "corners"}]}], "]"}], ",", " ", "2",
         ",", " ", "1"}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"fb5ca701-b0be-4470-8879-619ad164bcb8"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"c1abd7fa-1c0a-45eb-9233-b4263cea5f84"]
