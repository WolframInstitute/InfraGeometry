      FontSize->0.9 Inherited,ExpressionUUID->
      "4992bc91-e549-4b80-b315-2fa17bc37278"],
     " (default), ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5fec434c-c82d-4cb9-9e21-212871cdd9fb"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
        RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "07753f31-91a0-4c2e-bf65-a80cae8da417"],
     ", ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e37a7b5b-ae80-47b8-8d7c-b9b3ddaa4135"],
     ", ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "62cafc22-20e7-4c4b-8fbf-de3c1120727d"]
    }], "TableText",ExpressionUUID->"fed2d937-fc5d-4a6e-8e4f-a200165a7c48"], 
    Cell[TextData[{
     "forwarded to the side geodesics. ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "28f4f119-f95b-45e6-89d4-602fb81e576a"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1387f405-a6e8-4121-984d-69cf2b5d0edf"],
     " to ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c2fe3b9c-cbed-4e6f-8e0f-9bacdea0d02a"],
     ", a bounded or absent count to ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c9a2fc35-30de-4f67-9f1e-9d8f95ff3e2e"],
     ". The class is the same under every value; ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "64ebb961-ef2c-44df-86c3-56a27a4c81d6"],
     " and ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b36bb8c0-eb75-43d5-81ce-20f0468f182a"],
     " take each side's geodesics in candidate order, ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c45795cc-e76b-4582-867b-5dbca50d3ceb"],
     " in random order, seeded by an ambient ",
     Cell[BoxData["SeedRandom"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "d4797f21-85d7-4b98-a40b-960df93b862e"],
     ". ",
     Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3068fd33-eb64-475c-9470-9b9b4e79aab5"],
     " is accepted and inert: the sides come off geodesic pools, which have \
no frontier to cap."
    }], "TableText",ExpressionUUID->"a0381016-db32-43ef-b07b-0b2d801f292d"]}
  }]], "3ColumnTableMod",ExpressionUUID->"b9ef3ccd-cfa4-4041-bd64-\
9d1c50c1108f"],

Cell[TextData[{
 "Sides chosen by a local rule \[LongDash] straightest, curvature-minimising \
\[LongDash] are not a polygon option: build them with ",
