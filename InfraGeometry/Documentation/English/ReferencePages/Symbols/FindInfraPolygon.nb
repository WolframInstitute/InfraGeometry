 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac24a7af-6a69-4080-8b39-2a462478e056"],
 " of sides."
}], "Notes",ExpressionUUID->"a750262b-3692-4067-bad0-1dcdea795e98"],

