Notebook[{

Cell[CellGroupData[{
Cell["FindInfraPolygon", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1eadcff6-3f15-4e41-a24c-0e62d6402455"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPolygon"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPolygon", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pn", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02110268-812b-4322-be04-92bd7620263c"],
 "\[LineSeparator]",
 "gives one polygon with corners ",
 StyleBox["p1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["pn", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " \[LongDash] a geodesic between each pair of consecutive corners, the last \
side returning to ",
 StyleBox["p1", "TI"],
 " \[LongDash] as the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2d20774-f0c8-41a0-8204-61490c57875b"],
 " of its sides, one directed path graph each.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"33d123c0-0995-4293-9e3e-12fe8d79402f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPolygon"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPolygon", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pn", "TI"]}], "}"}], ",", " ", 
    StyleBox["m", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47a499cf-255b-482d-8b9b-15e1fc00e5f7"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e7e98b9-1081-494d-bdf0-71b2adecbeee"],
 " of exactly ",
 StyleBox["m", "TI"],
 " polygons or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5927325-5e5f-47f0-9816-8022b627d88a"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "m", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01d8e817-afbc-412f-9637-8efb716055dd"],
 " gives up to ",
 StyleBox["m", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21e9af32-1759-4dc9-8ba4-0aa1178cfa80"],
 " gives the whole class."
}], "Usage",ExpressionUUID->"7c9ba687-dd48-425f-a0b4-990af39f9656"],

Cell[TextData[{
 "A polygon with corners ",
 StyleBox["p1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["pn", "TI"],
 " (",
 StyleBox["n", "TI"],
 " \[GreaterEqual] 3) is a cyclic sequence of ",
 StyleBox["n", "TI"],
 " geodesics, the ",
 StyleBox["i", "TI"],
 "-th from ",
 StyleBox["pi", "TI"],
 " to ",
 StyleBox["p(i+1)", "TI"],
 " and the last from ",
 StyleBox["pn", "TI"],
 " back to ",
 StyleBox["p1", "TI"],
 ". Corners are vertices; each polygon is the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3afe4c18-d64c-404c-9adb-4738707ba3b0"],
 " of its ",
 StyleBox["n", "TI"],
 " sides, one directed path graph each, and its perimeter is the total edge \
count of the sides."
}], "Notes",ExpressionUUID->"4f07a21d-e360-4194-83d1-5bd426b84f2e"],

Cell[TextData[{
 "The class is the Cartesian ",
 StyleBox["product",
  FontWeight->"Bold"],
 " of the per-side geodesic classes, so the count multiplies: a side with ",
 StyleBox["k", "TI"],
 " geodesics contributes a factor ",
 StyleBox["k", "TI"],
 ". On a 5\[Times]5 grid the square on the four corners has one member, while \
the diamond on the four side midpoints has 6^4 = 1296, every side being a \
diagonal with six geodesics."
}], "Notes",ExpressionUUID->"b3f2e4cd-ed30-48f5-9b66-9d5c0ceee234"],

Cell["\<\
Nothing in the definition keeps the sides apart. A side may run back over \
another: on the 3\[Times]3 grid with corners 1, 3, 9 the side from 9 to 1 may \
retrace the two others, and the class admits it, since each side is a \
geodesic on its own.\
\>", "Notes",ExpressionUUID->"e886abcb-6a6e-4a2d-8c4b-671d0b380b66"],

Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b67640d5-91d0-46b7-aafe-1b13bea79eb7"],
 " forms the product. A bounded count never does: it streams that many \
geodesics per side and reads the first members of their product off a \
mixed-radix index, so the count-less call \[LongDash] one polygon, the first \
geodesic of every side \[LongDash] is cheap and deterministic, and a strict \
count is exact."
}], "Notes",ExpressionUUID->"cf591a8f-6367-48eb-9ce9-a3acfcf70f22"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1503c9a6-13b8-4c06-844f-13337d811a05"], Cell["Option", "TableText",
