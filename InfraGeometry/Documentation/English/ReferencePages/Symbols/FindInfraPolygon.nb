  FontSize->0.9 Inherited,ExpressionUUID->
  "46f80d89-b4ed-407c-ae7d-2fcebdbd6a5e"],
 " of sides."
}], "Notes",ExpressionUUID->"3272168b-03fc-4d64-9aa2-03e0ab061a66"],

