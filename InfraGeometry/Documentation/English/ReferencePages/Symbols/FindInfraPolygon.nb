   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "224924a8-280b-4dc2-8dd8-1ea4cba01f55"],
 " and assemble the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fad6738c-bc37-48e5-b6c4-19dd7b90311f"],
 " of sides."
}], "Notes",ExpressionUUID->"67b168ac-39df-423e-a3ba-67b29772dc31"],

