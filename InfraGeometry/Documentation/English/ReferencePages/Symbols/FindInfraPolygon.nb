Cell[TextData[{
 "The count-less call is one polygon, deterministic; a strict count is exact, \
and ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aaeb93da-ac16-4328-a6c4-e3f8c9d38ade"],
 " when the class is smaller."
}], "ExampleText",ExpressionUUID->"7ac438cc-9523-4482-b961-20ce077a3342"],

