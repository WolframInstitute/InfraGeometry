Cell["Method", "ExampleSubsection",ExpressionUUID->"96845dc4-972b-435a-8ab9-7f2bdd3bda8d"],

Cell[TextData[{
 "The class is the same under every ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a481938f-48a9-4942-9cda-9945a5398ce1"],
 "; only the order in which polygons come off it differs."
}], "ExampleText",ExpressionUUID->"1d999cf3-9131-4ec9-8820-7bc1aa86888d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"SameQ", " ", "@@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Sort", " ", "@", " ", 
        RowBox[{"FindInfraPolygon", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "15", ",", " ", "23", ",", " ", "11"}], 
           "}"}], ",", " ", "All", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "#"}]}], "]"}]}], " ", "&"}], " ",
       "/@", "\n", "     ", 
      RowBox[{"{", 
       RowBox[{"\"\<Exhaustive\>\"", ",", " ", "\"\<Greedy\>\"", ",", 
        " ", "\"\<RandomGreedy\>\""}], "}"}]}], ")"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"dc258e77-5e31-4f53-900f-6a9aec2ad57a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"793269ce-bb61-4c76-b396-e6100534c13d"]
}, Open  ]]
}, Open  ]]
