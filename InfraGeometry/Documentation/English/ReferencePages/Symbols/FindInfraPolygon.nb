Cell["\<\
The perimeter is the sum of the corner distances around the cycle.\
\>", "ExampleText",ExpressionUUID->"6d5a9e11-500a-4c67-a893-9c4e51140915"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "15", ",", " ", "23", ",", " ", "11"}], "}"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"EdgeCount", " ", "/@", " ", 
      RowBox[{"FindInfraPolygon", "[", 
       RowBox[{"g", ",", " ", "corners"}], "]"}]}], "]"}], " ", "===", "\n", 
    "    ", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", "##"}], "]"}], " ", "&"}], " ", "@@@", " ", 
      RowBox[{"Partition", "[", 
       RowBox[{
        RowBox[{"Append", "[", 
         RowBox[{"corners", ",", " ", 
          RowBox[{"First", " ", "@", " ", "corners"}]}], "]"}], ",", " ", "2",
         ",", " ", "1"}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6e1c4a49-b92d-48db-85f2-c402e9de5ba9"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"1057d729-fb31-4157-af95-bdeb88c913c5"]
