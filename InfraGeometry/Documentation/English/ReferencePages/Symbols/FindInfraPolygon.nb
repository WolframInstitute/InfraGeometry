   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9615cf74-f90d-42e7-9514-935acb1fc5bf"],
 " and assemble the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d5a9e97-e817-4e94-abd6-d27b125236e9"],
 " of sides."
}], "Notes",ExpressionUUID->"a7b49ec4-f706-4dee-8ea0-033c6c3c9701"],

