     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9496ceeb-135d-4da0-9991-5aa116ccc0f2"],
     " (default), ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7b0e483a-7288-41f6-b72e-de926ccd46e9"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
        RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "51f443a8-3dff-4df9-9754-ed58624d7f28"],
     ", ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7296a014-a61d-43f0-86f1-9bc12a226ee4"],
     ", ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2360b7ef-d183-4c58-90bd-882caa8ba947"]
    }], "TableText",ExpressionUUID->"63e13b27-863c-4440-a606-0c77453753c6"], 
    Cell[TextData[{
     "forwarded to the side geodesics. ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4f0847d2-ae03-4b4c-a347-cffd48a05544"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5c003f14-3ca5-4377-b81c-d541bd61aa40"],
     " to ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b7d98b7a-126f-4e5d-b3b8-404aae8b9f9f"],
     ", a bounded or absent count to ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "114c3853-196a-4a51-aa61-8891073b3557"],
     ". The class is the same under every value; ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7a86e74f-6bf0-479a-9036-95630e96a550"],
     " and ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "cbc75751-7f0e-476d-b556-1f251b6bc2c4"],
     " take each side's geodesics in candidate order, ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8dcede46-4b7e-4fc4-b750-9522bac08944"],
     " in random order, seeded by an ambient ",
     Cell[BoxData["SeedRandom"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "492e6af2-a7d9-416e-a1f2-5c3908396274"],
     ". ",
     Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "81446523-3b48-4496-9196-6d439af90195"],
     " is accepted and inert: the sides come off geodesic pools, which have \
no frontier to cap."
    }], "TableText",ExpressionUUID->"64ecf836-b11e-48c1-aafa-b1c79cf5785f"]}
  }]], "3ColumnTableMod",ExpressionUUID->"9e001a28-4e94-4b42-afa9-\
94423f5adf7c"],

Cell[TextData[{
 "Sides chosen by a local rule \[LongDash] straightest, curvature-minimising \
\[LongDash] are not a polygon option: build them with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
