 " and assemble the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc13836b-a41e-46e7-9d2e-e715efb9cede"],
 " of sides."
}], "Notes",ExpressionUUID->"67a36236-cbec-431d-ba5d-21bb1fa5d672"],

