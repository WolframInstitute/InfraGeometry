Cell[TextData[{
 "Every polygon satisfies ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPolygonQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPolygonQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5b8f369e-c489-423c-ac84-e896ae74b36d"],
 ", and a three-corner polygon is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraTriangle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraTriangle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "afed6fae-a18c-4fe9-b3d2-3f19d50b4bd6"],
 "."
}], "ExampleText",ExpressionUUID->"87493702-1e9a-4c80-bbd1-34d65af34a39"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraPolygonQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"FindInfraPolygon", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3", ",", " ", "9"}], "}"}], ",", " ", 
         "All"}], "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"FindInfraPolygon", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3", ",", " ", "9"}], "}"}], ",", " ", 
        "All"}], "]"}], " ", "===", " ", 
      RowBox[{"FindInfraTriangle", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3", ",", " ", "9"}], "}"}], ",", " ", 
        "All"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"282e49e6-3718-4fd7-9903-9655285df85b"],

Cell[BoxData[
 RowBox[{"{", 
