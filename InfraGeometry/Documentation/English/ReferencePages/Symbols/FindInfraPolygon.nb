Notebook[{

Cell[CellGroupData[{
Cell["FindInfraPolygon", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"18adeae9-1b79-4df9-b172-d6f55db6fe9b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPolygon"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPolygon", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pn", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40de196c-2d82-4a52-87f2-edc7089044f2"],
 "\[LineSeparator]",
 "gives one polygon with corners ",
 StyleBox["p1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["pn", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " \[LongDash] a geodesic between each pair of consecutive corners, the last \
side returning to ",
 StyleBox["p1", "TI"],
 " \[LongDash] as the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef309e2b-e4d9-44e9-8786-2f5b04960430"],
 " of its sides, one directed path graph each.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"aa865f64-02d6-4470-a7c4-908f2a6a3cb8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPolygon"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPolygon", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pn", "TI"]}], "}"}], ",", " ", 
    StyleBox["m", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "abdafa9c-aa74-47ec-a9ab-da076647a779"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "498b2f47-c3b9-435b-bdad-76f0cc6942e2"],
 " of exactly ",
 StyleBox["m", "TI"],
 " polygons or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09d06d35-019e-4443-8545-292916aa8465"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "m", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36e58c82-2f99-4a9e-9e30-e819f291ca16"],
 " gives up to ",
 StyleBox["m", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9897b89-2863-46a7-bbef-ba1db0e04e7c"],
 " gives the whole class."
}], "Usage",ExpressionUUID->"d8f80d9e-d0d6-4159-b4b1-ecb99d8e5729"],

Cell[TextData[{
 "A polygon with corners ",
 StyleBox["p1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["pn", "TI"],
 " (",
 StyleBox["n", "TI"],
 " \[GreaterEqual] 3) is a cyclic sequence of ",
 StyleBox["n", "TI"],
 " geodesics, the ",
 StyleBox["i", "TI"],
 "-th from ",
 StyleBox["pi", "TI"],
 " to ",
 StyleBox["p(i+1)", "TI"],
 " and the last from ",
 StyleBox["pn", "TI"],
 " back to ",
 StyleBox["p1", "TI"],
 ". Corners are vertices; each polygon is the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32692393-5394-4007-8a9c-b582cc8ae913"],
 " of its ",
 StyleBox["n", "TI"],
 " sides, one directed path graph each, and its perimeter is the total edge \
count of the sides."
}], "Notes",ExpressionUUID->"cd1d8880-f548-482e-8cff-cb7943e824a9"],

Cell[TextData[{
 "The class is the Cartesian ",
 StyleBox["product",
  FontWeight->"Bold"],
 " of the per-side geodesic classes, so the count multiplies: a side with ",
 StyleBox["k", "TI"],
 " geodesics contributes a factor ",
 StyleBox["k", "TI"],
 ". On a 5\[Times]5 grid the square on the four corners has one member, while \
the diamond on the four side midpoints has 6^4 = 1296, every side being a \
diagonal with six geodesics."
}], "Notes",ExpressionUUID->"fad4f2d0-aa2e-4d12-90d3-52d8bfa01579"],

Cell["\<\
Nothing in the definition keeps the sides apart. A side may run back over \
another: on the 3\[Times]3 grid with corners 1, 3, 9 the side from 9 to 1 may \
retrace the two others, and the class admits it, since each side is a \
geodesic on its own.\
\>", "Notes",ExpressionUUID->"65a9b51b-36a2-4f2f-985f-c30f3fb052f3"],

Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff978281-c1b4-4ed6-a0ea-3af91d5991b1"],
 " forms the product. A bounded count never does: it streams that many \
geodesics per side and reads the first members of their product off a \
mixed-radix index, so the count-less call \[LongDash] one polygon, the first \
geodesic of every side \[LongDash] is cheap and deterministic, and a strict \
count is exact."
}], "Notes",ExpressionUUID->"3d5e56eb-dd1f-4128-a13a-8b9481acc275"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a73ff436-76bb-4235-be06-9435fedf8df4"], Cell["Option", "TableText",
