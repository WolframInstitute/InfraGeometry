Cell["\<\
The square on the four corners of a 5\[Times]5 grid has one member; the \
diamond on the four side midpoints has 1296.\
\>", "ExampleText",ExpressionUUID->"4a14c708-81c7-4290-a7a2-002441d156b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraPolygon", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "5", ",", " ", "25", ",", " ", "21"}], "}"}], 
        ",", " ", "All"}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraPolygon", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "15", ",", " ", "23", ",", " ", "11"}], "}"}],
         ",", " ", "All"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"609fc32d-65a2-42cd-8e90-ccadaeaeaf17"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "1296"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"43733334-14d0-4735-b941-0a54d34b4f76"]
}, Open  ]],

Cell["\<\
Three of the diamonds, streamed off the class in random order.\
\>", "ExampleText",ExpressionUUID->"83de842a-bf31-4fc9-92ac-d2b22d0bcc58"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
  RowBox[{"With", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", " ", "=", " ", 
      RowBox[{"GridGraph", "[", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
    
    RowBox[{"InfraSubstrateHighlight", "[", 
     RowBox[{"g", ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"FindInfraPolygon", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "15", ",", " ", "23", ",", " ", "11"}], 
            "}"}], ",", " ", 
           RowBox[{"UpTo", "[", "3", "]"}], ",", " ", 
           
           RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
            "RandomSample"}]}], "]"}], " ", "->", " ", "$InfraSegmentColor"}],
         ",", "\n", "     ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "15", ",", " ", "23", ",", " ", "11"}], 
          "}"}], " ", "->", " ", "$InfraPointColor"}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d536161a-4317-4c5d-a563-0b04b97953e7"],

