   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7152f8af-b3b9-4c78-88c7-5d5ed68fa6a1"],
 " and assemble the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87058542-088d-4546-b703-339e7d05a745"],
 " of sides."
}], "Notes",ExpressionUUID->"3a585254-29bd-4098-9365-d35895434a5e"],

