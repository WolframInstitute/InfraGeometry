Notebook[{

Cell[CellGroupData[{
Cell["FindInfraPolygon", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3590635d-f15f-4740-a20d-324d4b1b185d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPolygon"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPolygon", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pn", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb8e9135-5d0e-4c5e-8f36-1e020ec873db"],
 "\[LineSeparator]",
 "gives one polygon with corners ",
 StyleBox["p1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["pn", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " \[LongDash] a geodesic between each pair of consecutive corners, the last \
side returning to ",
 StyleBox["p1", "TI"],
 " \[LongDash] as the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68f42fe3-c29b-4aa7-b431-e0df8980d9c5"],
 " of its sides, one directed path graph each.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"57cf6390-579a-45be-a560-f49125137bc2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPolygon"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPolygon", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pn", "TI"]}], "}"}], ",", " ", 
    StyleBox["m", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4abf2aa9-f10e-4c2b-97c7-d807c85f331b"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7ae3593-c079-4d24-87d0-3b3eb28e71dd"],
 " of exactly ",
 StyleBox["m", "TI"],
 " polygons or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "599e7902-18d5-4a56-bd3b-49aec54d831c"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "m", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39965791-441b-46d9-95e5-bc004660e27b"],
 " gives up to ",
 StyleBox["m", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38618c02-5f04-4b2c-b9f0-d5a1d9878dfe"],
 " gives the whole class."
}], "Usage",ExpressionUUID->"a8caca94-81b5-44d8-be0d-0d14ec43cf6d"],

Cell[TextData[{
 "A polygon with corners ",
 StyleBox["p1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["pn", "TI"],
 " (",
 StyleBox["n", "TI"],
 " \[GreaterEqual] 3) is a cyclic sequence of ",
 StyleBox["n", "TI"],
 " geodesics, the ",
 StyleBox["i", "TI"],
 "-th from ",
 StyleBox["pi", "TI"],
 " to ",
 StyleBox["p(i+1)", "TI"],
 " and the last from ",
 StyleBox["pn", "TI"],
 " back to ",
 StyleBox["p1", "TI"],
 ". Corners are vertices; each polygon is the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72691f5b-e4cf-4d59-a8d8-8492d15cffd6"],
 " of its ",
 StyleBox["n", "TI"],
 " sides, one directed path graph each, and its perimeter is the total edge \
count of the sides."
}], "Notes",ExpressionUUID->"b31ed596-93d5-469a-99b7-d7bfca8844d0"],

Cell[TextData[{
 "The class is the Cartesian ",
 StyleBox["product",
  FontWeight->"Bold"],
 " of the per-side geodesic classes, so the count multiplies: a side with ",
 StyleBox["k", "TI"],
 " geodesics contributes a factor ",
 StyleBox["k", "TI"],
 ". On a 5\[Times]5 grid the square on the four corners has one member, while \
the diamond on the four side midpoints has 6^4 = 1296, every side being a \
diagonal with six geodesics."
}], "Notes",ExpressionUUID->"7491651e-0d66-4240-bd11-b73644815327"],

Cell["\<\
Nothing in the definition keeps the sides apart. A side may run back over \
another: on the 3\[Times]3 grid with corners 1, 3, 9 the side from 9 to 1 may \
retrace the two others, and the class admits it, since each side is a \
geodesic on its own.\
\>", "Notes",ExpressionUUID->"dbe2efaf-ed53-4196-9681-4d848a5d7103"],

Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22efb6c0-4dfe-4438-a9c7-1ab5babe63ae"],
 " forms the product. A bounded count never does: it streams that many \
geodesics per side and reads the first members of their product off a \
mixed-radix index, so the count-less call \[LongDash] one polygon, the first \
geodesic of every side \[LongDash] is cheap and deterministic, and a strict \
count is exact."
}], "Notes",ExpressionUUID->"419eade5-805e-42cf-bf6d-aee2ad9c6647"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ed56f4b9-bed2-42d7-9415-f9c07fc0f730"], Cell["Option", "TableText",
