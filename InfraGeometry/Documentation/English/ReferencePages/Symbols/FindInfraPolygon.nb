Cell[CellGroupData[{
Cell["FindInfraPolygon", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8fc42951-8ddf-448f-9bb5-f40dc87ca3e3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPolygon"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPolygon", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pn", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7984e043-c6b8-4536-9876-82b2301b00c9"],
 "\[LineSeparator]",
 "gives one polygon with corners ",
 StyleBox["p1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["pn", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " \[LongDash] a geodesic between each pair of consecutive corners, the last \
side returning to ",
 StyleBox["p1", "TI"],
 " \[LongDash] as the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5edc422a-ff72-42ab-91a6-1016ac741645"],
 " of its sides, one directed path graph each.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b66e361d-e680-400d-bcdb-946bc3fc85b2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPolygon"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraPolygon", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
      StyleBox["pn", "TI"]}], "}"}], ",", " ", 
    StyleBox["m", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a0b1e6a-3c2a-429c-9f31-83437ec9fe2f"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84bc1a59-4e8e-4eaf-9ea2-45b46e449bf9"],
 " of exactly ",
 StyleBox["m", "TI"],
 " polygons or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "703d0fef-2d68-4e79-9706-88746f7b6b5c"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "m", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e2a0aea-df7b-48cb-861f-cae062103ddd"],
 " gives up to ",
 StyleBox["m", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6bb83fc-458f-40b8-8234-17fc35541ae0"],
 " gives the whole class."
}], "Usage",ExpressionUUID->"8feac2e5-69b7-42d6-a9b4-78c80001d948"],

Cell[TextData[{
 "A polygon with corners ",
 StyleBox["p1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["pn", "TI"],
 " (",
 StyleBox["n", "TI"],
 " \[GreaterEqual] 3) is a cyclic sequence of ",
 StyleBox["n", "TI"],
 " geodesics, the ",
 StyleBox["i", "TI"],
 "-th from ",
 StyleBox["pi", "TI"],
 " to ",
 StyleBox["p(i+1)", "TI"],
 " and the last from ",
 StyleBox["pn", "TI"],
 " back to ",
 StyleBox["p1", "TI"],
 ". Corners are vertices; each polygon is the ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f1ddbcf3-9d4a-46b4-be29-79038209166c"],
 " of its ",
 StyleBox["n", "TI"],
 " sides, one directed path graph each, and its perimeter is the total edge \
count of the sides."
}], "Notes",ExpressionUUID->"6ce43c81-fc72-474c-922e-0d95a976592e"],

Cell[TextData[{
 "The class is the Cartesian ",
 StyleBox["product",
  FontWeight->"Bold"],
 " of the per-side geodesic classes, so the count multiplies: a side with ",
 StyleBox["k", "TI"],
 " geodesics contributes a factor ",
 StyleBox["k", "TI"],
 ". On a 5\[Times]5 grid the square on the four corners has one member, while \
the diamond on the four side midpoints has 6^4 = 1296, every side being a \
diagonal with six geodesics."
}], "Notes",ExpressionUUID->"bfdb6fd2-6a44-4e76-b069-0f341f12b00a"],

Cell["\<\
Nothing in the definition keeps the sides apart. A side may run back over \
another: on the 3\[Times]3 grid with corners 1, 3, 9 the side from 9 to 1 may \
retrace the two others, and the class admits it, since each side is a \
geodesic on its own.\
\>", "Notes",ExpressionUUID->"85da572c-9dbf-4d2c-a4e7-7b5019694fd8"],

Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da8778db-e0f8-492a-95bb-80dc044b21e8"],
 " forms the product. A bounded count never does: it streams that many \
geodesics per side and reads the first members of their product off a \
mixed-radix index, so the count-less call \[LongDash] one polygon, the first \
geodesic of every side \[LongDash] is cheap and deterministic, and a strict \
count is exact."
}], "Notes",ExpressionUUID->"16000d0b-796e-4109-b3bb-27b0b77c7241"],

