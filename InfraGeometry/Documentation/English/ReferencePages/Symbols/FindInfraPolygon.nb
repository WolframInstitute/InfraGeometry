Cell["\<\
The perimeter is the sum of the corner distances around the cycle.\
\>", "ExampleText",ExpressionUUID->"a9b22bf3-b2a0-4c72-83da-6badb3faaf62"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "15", ",", " ", "23", ",", " ", "11"}], "}"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"EdgeCount", " ", "/@", " ", 
      RowBox[{"FindInfraPolygon", "[", 
       RowBox[{"g", ",", " ", "corners"}], "]"}]}], "]"}], " ", "===", "\n", 
    "    ", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", "##"}], "]"}], " ", "&"}], " ", "@@@", " ", 
      RowBox[{"Partition", "[", 
       RowBox[{
        RowBox[{"Append", "[", 
         RowBox[{"corners", ",", " ", 
          RowBox[{"First", " ", "@", " ", "corners"}]}], "]"}], ",", " ", "2",
         ",", " ", "1"}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"706dfb90-dbd9-4b25-b69b-95e820ee370c"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"cbf24671-eb5f-4fc8-8fac-1d6588e475d9"]
