Cell[TextData[{
 "Every polygon satisfies ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPolygonQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPolygonQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c1e50f3b-7cbc-465f-97ad-7d69769ce540"],
 ", and a three-corner polygon is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraTriangle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraTriangle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dd6acfbd-d282-4514-a92d-1923e3825117"],
 "."
}], "ExampleText",ExpressionUUID->"0f07ebce-a1fe-4a51-b2b3-b8b0d3b87941"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraPolygonQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"FindInfraPolygon", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3", ",", " ", "9"}], "}"}], ",", " ", 
         "All"}], "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"FindInfraPolygon", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3", ",", " ", "9"}], "}"}], ",", " ", 
        "All"}], "]"}], " ", "===", " ", 
      RowBox[{"FindInfraTriangle", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3", ",", " ", "9"}], "}"}], ",", " ", 
        "All"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e53d74a5-3ca1-4b81-b3b4-92cf30bfce69"],

