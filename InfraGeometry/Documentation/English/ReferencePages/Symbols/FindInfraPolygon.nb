Cell[TextData[{
 "Every polygon satisfies ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPolygonQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPolygonQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "706ad47e-ffa7-4931-97e4-64777fd83ddc"],
 ", and a three-corner polygon is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraTriangle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraTriangle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8f9eff54-4b45-481a-bb6b-8326259f260f"],
 "."
}], "ExampleText",ExpressionUUID->"c92c2b64-6dbd-436d-92bb-09d04495d299"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraPolygonQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"FindInfraPolygon", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3", ",", " ", "9"}], "}"}], ",", " ", 
         "All"}], "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"FindInfraPolygon", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3", ",", " ", "9"}], "}"}], ",", " ", 
        "All"}], "]"}], " ", "===", " ", 
      RowBox[{"FindInfraTriangle", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3", ",", " ", "9"}], "}"}], ",", " ", 
        "All"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a8b9b99c-52ac-4312-9ba0-3b0fed267ef5"],

