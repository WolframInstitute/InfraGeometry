Cell[CellGroupData[{

Cell["NextVertexFunction", "ExampleSubsection",ExpressionUUID->"c7f29f58-04f6-4e9a-a9f4-c84bc35e08f5"],

Cell["\<\
The class is the same under every next-vertex function; only the order in \
which polygons come off it differs.\
\>", "ExampleText",ExpressionUUID->"dd79b198-c7bb-4710-8867-930625426b34"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"SameQ", " ", "@@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Sort", " ", "@", " ", 
        RowBox[{"FindInfraPolygon", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "15", ",", " ", "23", ",", " ", "11"}], 
           "}"}], ",", " ", "All", ",", " ", 
          RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "#"}]}], 
         "]"}]}], " ", "&"}], " ", "/@", "\n", "     ", 
      RowBox[{"{", 
       RowBox[{"Identity", ",", " ", "RandomSample"}], "}"}]}], ")"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c04a0b0a-272b-4ba9-a006-26d155418125"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"49ef1a51-bb55-4722-a02d-dbf14b365061"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

