      FontSize->0.9 Inherited,ExpressionUUID->
      "688fb86b-7eca-4940-b994-ac7a8f2920ca"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
        RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "54c2b14c-b226-4eb1-93d6-b3d1dbd04485"],
     ", ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b806a3f2-58ff-4c3e-a98e-97bac4e86291"],
     ", ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ab81d980-460f-4bf6-8797-3641a2708529"]
    }], "TableText",ExpressionUUID->"bf760e09-30cb-421a-bbb7-ee17fc68d3c0"], 
    Cell[TextData[{
     "forwarded to the side geodesics. ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "160bcca6-0c07-4407-9b72-3752966c2501"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9c54228b-fb86-4651-a89a-87b7d23a082f"],
     " to ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f65e9f6c-e0bf-4ab8-9d19-6531a09f8a6d"],
     ", a bounded or absent count to ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8498188d-690e-4634-a3af-4386ed0067f9"],
     ". The class is the same under every value; ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6b3e63f4-f1cd-4a57-b109-a7277e4af045"],
     " and ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9aabbebc-7c62-47e1-b3f8-04dbda80a639"],
     " take each side's geodesics in candidate order, ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "48fb871f-fecf-40e7-9473-5dfaceda4128"],
     " in random order, seeded by an ambient ",
     Cell[BoxData["SeedRandom"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "19d88e56-9bd2-4ab1-85c1-694c8b568045"],
     ". ",
     Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6e45d4e6-ee4e-4dbb-9faa-dbd4e47c56f6"],
     " is accepted and inert: the sides come off geodesic pools, which have \
no frontier to cap."
    }], "TableText",ExpressionUUID->"624454a3-0206-454f-b4b7-815f409e22dd"]}
  }]], "3ColumnTableMod",ExpressionUUID->"078c5d99-fa25-4aa3-b0dc-\
823b04e798c9"],

Cell[TextData[{
 "Sides chosen by a local rule \[LongDash] straightest, curvature-minimising \
\[LongDash] are not a polygon option: build them with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
