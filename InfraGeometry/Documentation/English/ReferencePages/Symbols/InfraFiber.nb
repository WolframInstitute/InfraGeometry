Cell["\<\
The fiber of the grid product bundle over the base vertex 6 is a triangle.\
\>", "ExampleText",ExpressionUUID->"51835411-aecf-453f-8486-2e15d4581e96"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridProductBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"total", ",", " ", 
        RowBox[{"{", 
         RowBox[{"InfraDensity", "[", 
          RowBox[{"total", ",", " ", 
           RowBox[{"VertexList", " ", "@", " ", 
            RowBox[{"InfraFiber", "[", 
             RowBox[{"fib", ",", " ", "6"}], "]"}]}]}], "]"}], "}"}]}], "]"}],
       ",", " ", 
      RowBox[{"InfraFiber", "[", 
       RowBox[{"fib", ",", " ", "6"}], "]"}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"378d3f97-eafe-4014-a4ec-f355825ee560"],

