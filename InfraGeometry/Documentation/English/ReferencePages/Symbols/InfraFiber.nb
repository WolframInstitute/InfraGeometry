Cell["\<\
On a base without triangles the fibers of the tangent bundle have no edges.\
\>", "Notes",ExpressionUUID->"7a608e86-c50b-48b1-8ff1-f628e43a1e43"],

Cell[TextData[{
 "A ",
 StyleBox["p", "TI"],
 " that is not a base vertex gives the empty graph."
}], "Notes",ExpressionUUID->"759dc3e6-7413-4b41-b15e-6d08818f5405"]
