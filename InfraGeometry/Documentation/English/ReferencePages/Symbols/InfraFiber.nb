Cell[CellGroupData[{
Cell["InfraFiber", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b83a9102-3ab7-4c69-a8a4-b98ea2b5e486"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFiber"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFiber", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72f205ab-4031-4180-8c1d-9014b9bb6080"],
 "\[LineSeparator]",
 "gives the fiber of ",
 StyleBox["fib", "TI"],
 " over the base vertex ",
 StyleBox["p", "TI"],
 ": the subgraph of the total graph induced on the vertices that project to \
",
 StyleBox["p", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"5394cc55-c62a-4b4a-8dfb-a08539022d46"],

Cell[TextData[{
 "The fiber is ",
 StyleBox["F(p) = \[Pi]\:207b\.b9(p)", "TI"],
 ", with the edges of the total graph between its vertices. These are the \
vertical edges over ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"d77b7bce-2c9a-467e-adfa-4256b1a7a475"],

Cell[TextData[{
 "The fibers over different base vertices are disjoint, and together they \
hold every vertex of the total graph. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibers"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibers", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c2fd3ee4-031b-4d5e-8b55-6ee26d9b7413"],
 " gives them all."
}], "Notes",ExpressionUUID->"1881fe48-0c14-4ad3-807a-2c040743fb13"],

Cell["The fibers of the constructions:", "Notes",ExpressionUUID->"e3f967a6-f123-4501-ab6d-115ef1ff645a"],

