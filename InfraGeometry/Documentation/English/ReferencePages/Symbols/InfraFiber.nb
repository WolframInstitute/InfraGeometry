Cell["\<\
The square grid projected to its columns. The fiber over 5 is the fifth \
column, a path:\
\>", "ExampleText",ExpressionUUID->"5eb88d6c-ba9f-4b5f-bbe9-d5d894d0a05e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{"Round", " ", "@", " ", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}]}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"InfraFiber", "[", 
          RowBox[{"fib", ",", " ", "5"}], "]"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"InfraFiber", "[", 
       RowBox[{"fib", ",", " ", "5"}], "]"}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"55470725-132f-46d9-9c74-36bcc61e007d"],

