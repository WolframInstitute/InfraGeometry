Cell["\<\
The fiber of the grid product bundle over the base vertex 6 is a triangle.\
\>", "ExampleText",ExpressionUUID->"c1890d09-f768-460d-adaf-ef7ee0010d41"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridProductBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"total", ",", " ", 
        RowBox[{"{", 
         RowBox[{"InfraDensity", "[", 
          RowBox[{"total", ",", " ", 
           RowBox[{"VertexList", " ", "@", " ", 
            RowBox[{"InfraFiber", "[", 
             RowBox[{"fib", ",", " ", "6"}], "]"}]}]}], "]"}], "}"}]}], "]"}],
       ",", " ", 
      RowBox[{"InfraFiber", "[", 
       RowBox[{"fib", ",", " ", "6"}], "]"}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"27607620-0a3d-490c-9722-000f4bf6973e"],

