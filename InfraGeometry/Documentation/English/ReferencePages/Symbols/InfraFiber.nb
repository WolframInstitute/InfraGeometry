Cell["\<\
The fiber of the grid product bundle over the base vertex 6 is a triangle.\
\>", "ExampleText",ExpressionUUID->"06819e85-a905-459c-9f2d-15526d263941"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridProductBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalSpace", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"total", ",", " ", 
        RowBox[{"{", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"total", ",", " ", 
           RowBox[{"VertexList", " ", "@", " ", 
            RowBox[{"InfraFiber", "[", 
             RowBox[{"fib", ",", " ", "6"}], "]"}]}], ",", 
           " ", "\"\<VertexDensity\>\""}], " ", "]"}], "}"}]}], "]"}], ",", 
      " ", 
      RowBox[{"InfraFiber", "[", 
       RowBox[{"fib", ",", " ", "6"}], "]"}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3547959c-2907-4a3b-b3ab-b6485e591332"],

