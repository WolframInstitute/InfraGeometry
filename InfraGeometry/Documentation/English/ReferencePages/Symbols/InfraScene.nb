Cell["\<\
On the discretized plane a single radius suffices: its shells are cycles by \
accident of the mesh.\
\>", "ExampleText",ExpressionUUID->"15c9f562-21cf-48cd-9b7d-45e6d83ee392"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "pA", ",", " ", "pB", ",", " ", "circleA", ",", " ", "circleB", ",", " ", 
    "meet"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "pA", ",", " ", "pB", ",", " ", "circleA", ",", " ", "circleB", ",", 
         " ", "meet"}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "a", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "b", "]"}]}], ",", "\n", "      ", 
         RowBox[{"circleA", " ", "==", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"pA", ",", " ", "4"}], "]"}]}], ",", " ", 
         RowBox[{"circleB", " ", "==", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"pB", ",", " ", "4"}], "]"}]}], ",", "\n", "      ", 
         RowBox[{"meet", " ", "==", " ", 
          RowBox[{"InfraIntersection", "[", 
           RowBox[{"circleA", ",", " ", "circleB"}], "]"}]}]}], "}"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"solved", " ", "=", " ", 
     RowBox[{"FindInfraScene", "[", 
      RowBox[{"scene", ",", " ", "g"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "a",
            ",", " ", "b"}], "}"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"InfraSceneInstance", "[", 
            RowBox[{"#", ",", " ", "meet"}], "]"}], " ", "&"}], " ", "/@", 
          " ", "solved"}]}], "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Length", " ", "@", " ", "solved"}]}], "}"}]}], "]"}]}], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"cddb10a6-b500-4658-b531-d3ea35e41604"],

