Cell["\<\
Euclid I.1: two points at distance 4, the circle of radius 4 about each, and \
the vertices where the circles meet. On the discretized plane this succeeds.\
\>", "ExampleText",ExpressionUUID->"fb0fc649-c13b-4088-9a9b-6b4e77822b4e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "a", ",", " ", "b", ",", " ", "cA", ",", " ", "cB", ",", " ", "u"}], "]"}],
   ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p1", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p2", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "p1", ",", " ", "#"}], "]"}], " ", "==", " ",
          "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "a", ",", " ", "b", ",", " ", "cA", ",", " ", "cB", ",", " ", "u"}], 
        "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "p1", "]"}]}], "}"}], ",", 
           " ", "\"\<point a\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"b", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "p2", "]"}]}], "}"}], ",", 
           " ", "\"\<point b\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"cA", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"a", ",", " ", "4"}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle around a\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"cB", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"b", ",", " ", "4"}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle around b\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"u", " ", "==", " ", 
             RowBox[{"InfraIntersection", "[", 
              RowBox[{"cA", ",", " ", "cB"}], "]"}]}], "}"}], ",", 
           " ", "\"\<they meet\>\""}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<objects\>\"", " ", "->", " ", 
      RowBox[{"scene", "[", "\"\<Objects\>\"", "]"}]}], ",", " ", 
     RowBox[{"\"\<labels\>\"", " ", "->", " ", 
      RowBox[{"scene", "[", "\"\<Labels\>\"", "]"}]}]}], "|>"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4e47b7a8-e893-4abf-b447-08861e61ca86"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"objects\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "cA", ",", "cB", ",", "u"}], "}"}]}], ",", 
   RowBox[{"\<\"labels\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"point a\"\>", ",", "\<\"point b\"\>", 
      ",", "\<\"circle around a\"\>", ",", "\<\"circle around b\"\>", 
      ",", "\<\"they meet\"\>"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e3c253e5-9626-4197-8db0-7db6b8d59a4a"]
}, Open  ]],

Cell["\<\
Solving it. The third argument is the step to solve up to, and the last step \
binds every object.\
\>", "ExampleText",ExpressionUUID->"4616f193-c283-4e2d-a0d1-4d169d104ddf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "a", ",", " ", "b", ",", " ", "cA", ",", " ", "cB", ",", " ", "u"}], "]"}],
   ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p1", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p2", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "p1", ",", " ", "#"}], "]"}], " ", "==", " ",
          "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "a", ",", " ", "b", ",", " ", "cA", ",", " ", "cB", ",", " ", "u"}], 
        "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "p1", "]"}]}], "}"}], ",", 
           " ", "\"\<point a\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"b", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "p2", "]"}]}], "}"}], ",", 
           " ", "\"\<point b\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"cA", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"a", ",", " ", "4"}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle around a\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"cB", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"b", ",", " ", "4"}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle around b\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"u", " ", "==", " ", 
             RowBox[{"InfraIntersection", "[", 
              RowBox[{"cA", ",", " ", "cB"}], "]"}]}], "}"}], ",", 
           " ", "\"\<they meet\>\""}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"solved", " ", "=", " ", 
     RowBox[{"FindInfraScene", "[", 
      RowBox[{"scene", ",", " ", "g", ",", " ", "5"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<instances\>\"", " ", "->", " ", 
      RowBox[{"Length", "[", "solved", "]"}]}], ",", " ", 
     RowBox[{"\"\<bound objects\>\"", " ", "->", " ", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"First", "[", "solved", "]"}]}]}]}]}], "|>"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9cb23447-deeb-43e9-bb3b-f83a3e9b5dd4"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"instances\"\>", "\[Rule]", "4"}], ",", 
   RowBox[{"\<\"bound objects\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "cA", ",", "cB", ",", "u"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"3312ae73-fe75-4a36-9941-400858e7c4e8"]
}, Open  ]],

Cell["\<\
On a square grid the same construction finds nothing: at a single radius \
there is no circle at all, so there is nothing to meet.\
\>", "ExampleText",ExpressionUUID->"c3dda2c5-64dd-4df1-9bfb-0472d38aaf9a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p1", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p2", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "p1", ",", " ", "#"}], "]"}], " ", "==", " ",
          "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraCircle", "[", 
       RowBox[{"g", ",", " ", "p1", ",", " ", 
        RowBox[{"\"\<Radius\>\"", " ", "->", " ", "4"}], ",", " ", "All"}], 
       "]"}]}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraCircle", "[", 
       RowBox[{"g", ",", " ", "p2", ",", " ", 
        RowBox[{"\"\<Radius\>\"", " ", "->", " ", "4"}], ",", " ", "All"}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"d95646d8-4fbb-4ce3-aa05-05f1083224b0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"9b40d72a-c72d-4df7-983b-173bab8ce027"]
}, Open  ]]
}, Open  ]],

