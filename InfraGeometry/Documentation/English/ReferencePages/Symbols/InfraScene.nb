Notebook[{

Cell[CellGroupData[{
Cell["InfraScene", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d846fef5-9c29-4bad-982e-e8a97f5646f0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraScene"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["x1", "TI"], ",", " ", 
      StyleBox["x2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["hyp1", "TI"], ",", " ", 
      StyleBox["hyp2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37e8bec1-7ef4-439d-99e8-f7df129bfc42"],
 "\[LineSeparator]",
 "is a construction stated before any graph: the objects ",
 StyleBox["xi", "TI"],
 ", and hypotheses that construct them or assert relations between them.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1b346822-d04b-4c7d-883a-8a0172e5f0f0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraScene"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["x1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraStep", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          StyleBox["hyp1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
        
        StyleBox["label", "TI"]}], "]"}], ",", " ", "\[Ellipsis]"}], "}"}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3488491-75f5-42c8-9eb9-c5b0f1fecc48"],
 "\[LineSeparator]",
 "groups the hypotheses into labelled steps."
}], "Usage",ExpressionUUID->"e199f2bf-ba3d-405e-978e-39aa2208d357"],

Cell[TextData[{
 "Definition: a scene is a list of objects and a list of hypotheses. A ",
 StyleBox["construction",
  FontWeight->"Bold"],
 " is a hypothesis ",
 Cell[BoxData[
  RowBox[{"x", " ", "==", " ", "token"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "befa998a-12e5-4228-9c2c-72d037781a42"],
 ", whose left side is an object. Every other hypothesis is an ",
 StyleBox["assertion",
  FontWeight->"Bold"],
 ". A scene computes nothing; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "31921767-2a06-485d-8a6d-3356ccec71e4"],
 " solves it on a graph."
}], "Notes",ExpressionUUID->"44559258-575c-4739-9a0a-6a2b658e211f"],

Cell[TextData[{
 "The right side of a construction is a token: an inert head with objects in \
place of points. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cc7fff14-ed62-4b6c-89a8-2f2850ea4c2c"],
 Cell[BoxData[
  RowBox[{"[", "v", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "794b4832-3f76-40e3-a53b-613689279f92"],
 " is the vertex ",
 StyleBox["v", "TI"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPoint"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPoint", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d9bcfdb-c793-469d-8480-9a1afd30dc3f"],
 " every vertex at distance ",
 StyleBox["d", "TI"],
 " from ",
 StyleBox["v", "TI"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "13cd7ebf-dd95-40ae-b952-7feed8a0f481"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "y"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c40e32af-1324-43d7-aada-989981b54ef3"],
 " is a geodesic from ",
 StyleBox["x", "TI"],
 " to ",
 StyleBox["y", "TI"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRay"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraRay", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ec3c6a82-9f5d-4ec0-bb7b-63ee248298a8"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "y"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c80d222-39e1-4944-8fa6-d9580c9db0e2"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b9574a3b-3154-42e5-ae3f-380f77e869aa"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "y"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffb25e99-fde9-4832-9b0c-2f34460128cc"],
 " a ray and a line. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7c1c8075-043d-4160-ba50-dcb6178ca66b"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97953db9-9c82-44f3-8003-13765767fa6f"],
 " is a circle about ",
 StyleBox["x", "TI"],
 " at radius ",
 StyleBox["r", "TI"],
 ", or in the band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "s"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2256568-5b29-49eb-bfbd-01af6f451b16"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c1d19899-128c-4b82-b483-447ef474be05"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "y"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "774d55c1-151f-4b19-97f6-706f3b680447"],
 " is a vertex the two objects share; an operand may be a token itself."
}], "Notes",ExpressionUUID->"3902a980-346d-48b3-a775-70ed1d1307c1"],

Cell["\<\
A token stands for its realisations, and each realisation is one branch. So a \
construction binds its object to a single vertex, or a single vertex list, \
per branch, and the branches multiply from one construction to the next.\
\>", "Notes",ExpressionUUID->"7d8a7ff2-2c19-4c3b-9c7a-049c09836f56"],

Cell[TextData[{
 "Inside a scene the token ",
 Cell[BoxData[
  RowBox[{"InfraCircle", "[", 
   RowBox[{"x", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49fd348e-638e-43ef-a563-244f063d48cc"],
 " reads ",
 StyleBox["r", "TI"],
 " as a radius. As a head, a bare second argument of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "70a8bd5e-7df4-4212-9bb3-64296669910c"],
 " is always a point. This is an open inconsistency."
}], "Notes",ExpressionUUID->"06ef5e0b-66e8-4862-827b-04b279f46464"],

Cell[TextData[{
 "An assertion is a predicate on objects: a comparison of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDistance"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDistance", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "028767e9-aa17-4964-a089-b543cf1fbd31"],
 " values, or one of the ",
 Cell[BoxData[
  RowBox[{"Infra", "*", "Q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cf1c5af-7b31-4435-b5b7-1bc37ca0de32"],
 " tests without its graph (",
 Cell[BoxData[
  RowBox[{"InfraSegmentQ", "[", "s", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2021e0e4-ae07-427f-b6c5-2d380898ce59"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraCircleQ", "[", "c", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43d30d5f-6a6b-4e06-9b53-e00ecd540cd9"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraParallelQ", "[", 
   RowBox[{"l1", ",", " ", "l2"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ec9a9f8-9f2f-4c75-b19a-78fdd9cbe414"],
 " and a few more). The graph is supplied when the scene is solved, and a \
branch survives only if every assertion holds on it. An ",
 Cell[BoxData[
  RowBox[{"Infra", "*", "Q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12d0c58e-8174-4150-bfcb-09bc664e79f6"],
 " test that cannot be given the graph is refused with ",
 Cell[BoxData[
  RowBox[{"InfraScene", "::", "badassertion"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84a033c8-2c0b-4e18-a787-e801eb273f97"],
 "."
}], "Notes",ExpressionUUID->"0bf50985-d81b-48e7-9fac-1a54fac269c9"],

Cell[TextData[{
 "Without ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraStep"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraStep", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f95258c8-bb67-4bef-8b5c-c7fe5d040db3"],
 ", the steps are the levels of the dependency graph of the constructions: \
first the objects that depend on no other object, then those that depend only \
on them, and so on. With it, the steps are the ones written, in order."
}], "Notes",ExpressionUUID->"3a929fb6-95fe-4231-b485-912544aac245"],

Cell[TextData[{
 "The objects are ordinary symbols, so they must have no value when the scene \
is built; ",
 Cell[BoxData["ClearAll"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f06855da-c01d-4f1e-9265-0ec305ad2edb"],
 " them first."
}], "Notes",ExpressionUUID->"39c3081b-22e4-423f-adf9-e5400b16e48d"],

Cell[TextData[{
 "A scene answers ",
 Cell[BoxData["\"\<Objects\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "038bbaf5-975c-465c-aedb-6dd957ad83e7"],
 ", ",
 Cell[BoxData["\"\<Constructions\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aa3e8b3-d0f0-449e-9248-9fe7d4b920c8"],
 ", ",
 Cell[BoxData["\"\<Assertions\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae4a3e5e-2a46-44a7-a0d5-9fce9de2b8f7"],
 ", ",
 Cell[BoxData["\"\<Steps\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "102f6b9b-d6ed-4c12-a83d-4114b59feab8"],
 ", ",
 Cell[BoxData["\"\<Labels\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b25c281-593d-448d-af2a-942fb39a314b"],
 " and ",
 Cell[BoxData["\"\<DependencyGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "379fe7b5-5a04-4668-870f-738ac45c2ecd"],
 ". The dependency graph is ",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "824c26ce-38f7-44a9-b296-a9e73ab5cb8d"],
 " when the steps are written by hand."
}], "Notes",ExpressionUUID->"9fb7c80d-c755-4b45-994f-4bbf1c69ba49"],

Cell[TextData[{
 StyleBox["A construction can stall.",
  FontWeight->"Bold"],
 " Euclid never postulated that the two circles of I.1 meet, and on a graph \
they need not. On a square grid a single distance shell spans no cycle, so \
the circles of I.1 at one radius do not exist. That is the continuity \
assumption Euclid left unstated, showing up as an empty result. A band two \
radii thick carries the circles, and there the construction goes through."
}], "Notes",ExpressionUUID->"48ca26f5-d97d-4511-af17-3a3e8b2926ec"]
}, Open  ]],

