Cell[TextData[{
 "Euclid I.1 on the square tiling: two points four steps apart, a circle in \
the band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", " ", "5"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23bdf6ad-03f7-46ad-9049-c51ea2f00927"],
 " about each, and the vertices where the circles meet. On a lattice two \
circles meet along an edge rather than at a vertex, so there are several \
meeting vertices."
}], "ExampleText",ExpressionUUID->"0358e47e-4ca8-4c57-9bf9-abc57a841d1e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "pA", ",", " ", "pB", ",", " ", "circleA", ",", " ", "circleB", ",", " ", 
    "meet"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "4"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "pA", ",", " ", "pB", ",", " ", "circleA", ",", " ", "circleB", ",", 
         " ", "meet"}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"pA", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "a", "]"}]}], "}"}], ",", 
           " ", "\"\<point A\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"pB", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "b", "]"}]}], "}"}], ",", 
           " ", "\"\<point B\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"circleA", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"pA", ",", " ", 
               RowBox[{"{", 
                RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle about A\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"circleB", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"pB", ",", " ", 
               RowBox[{"{", 
                RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle about B\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"meet", " ", "==", " ", 
             RowBox[{"InfraIntersection", "[", 
              RowBox[{"circleA", ",", " ", "circleB"}], "]"}]}], "}"}], ",", 
           " ", "\"\<where they meet\>\""}], "]"}]}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
