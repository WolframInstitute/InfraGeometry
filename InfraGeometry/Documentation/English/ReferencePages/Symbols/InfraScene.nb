          " ", "b"}], "}"}], ",", "\n", "      ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraSceneInstance", "[", 
          RowBox[{"#", ",", " ", "meet"}], "]"}], " ", "&"}], " ", "/@", " ", 
        "solved"}]}], "]"}]}], "]"}]}], "]"}]}], "Input",
