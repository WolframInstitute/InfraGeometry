    RowBox[{"solved", " ", "=", " ", 
     RowBox[{"FindInfraScene", "[", 
      RowBox[{"scene", ",", " ", "g"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cycleA", " ", "=", " ", 
     RowBox[{"InfraSceneInstance", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", "solved"}], ",", " ", "circleA"}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"cycleB", " ", "=", " ", 
     RowBox[{"InfraSceneInstance", "[", 
