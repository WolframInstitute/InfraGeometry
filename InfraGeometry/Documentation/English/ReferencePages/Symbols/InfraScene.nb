Notebook[{

Cell[CellGroupData[{
Cell["InfraScene", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9fa224ec-e9d9-4b19-b70a-7bb5f78cf2bd"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraScene"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["x1", "TI"], ",", " ", 
      StyleBox["x2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["hyp1", "TI"], ",", " ", 
      StyleBox["hyp2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "91e755b7-8e99-4001-b528-9380decf7e64"],
 "\[LineSeparator]",
 "is a construction stated before any graph: the objects ",
 StyleBox["xi", "TI"],
 ", and hypotheses that construct them or assert relations between them.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6ef5602b-85e3-4365-ad7b-6a860ef5299f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraScene"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["x1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraStep", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          StyleBox["hyp1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
        
        StyleBox["label", "TI"]}], "]"}], ",", " ", "\[Ellipsis]"}], "}"}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "368b275d-81ee-46b6-ac47-9a2631fc8ca6"],
 "\[LineSeparator]",
 "groups the hypotheses into labelled steps."
}], "Usage",ExpressionUUID->"3adb0082-a9d6-476a-98ce-b9d64f16e1ad"],

Cell[TextData[{
 "Definition: a scene is a list of objects and a list of hypotheses. A ",
 StyleBox["construction",
  FontWeight->"Bold"],
 " is a hypothesis ",
 Cell[BoxData[
  RowBox[{"x", " ", "==", " ", "token"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af357e1f-83d2-4f0b-8233-36d45edb2c9a"],
 ", whose left side is an object. Every other hypothesis is an ",
 StyleBox["assertion",
  FontWeight->"Bold"],
 ". A scene computes nothing; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "66beca61-c4d0-4447-b94c-17b4aded598f"],
 " solves it on a graph."
}], "Notes",ExpressionUUID->"e658e7fc-c788-4cf2-a5ee-cd8c0dfe727c"],

Cell[TextData[{
 "The right side of a construction is a token: an inert head with objects in \
place of points. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "eac3c82e-adaf-442e-b483-672349b6a7b9"],
 Cell[BoxData[
  RowBox[{"[", "v", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8fff2077-c70b-43d7-a027-2693015730cf"],
 " is the vertex ",
 StyleBox["v", "TI"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPoint"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPoint", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "672e3f32-fede-4f1a-8040-57488afa71c3"],
 " every vertex at distance ",
 StyleBox["d", "TI"],
 " from ",
 StyleBox["v", "TI"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c2889726-18c8-480a-9c71-5865837f2716"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "y"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44228090-dc9c-4f03-b5af-7277701bf32b"],
 " is a shortest path from ",
 StyleBox["x", "TI"],
 " to ",
 StyleBox["y", "TI"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRay"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraRay", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c3fbee1b-28e1-4663-af75-be8e6eb8623d"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "y"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc20345c-9f38-4562-8b8b-a77fcc0dd9a2"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4aea30c6-b21b-42c9-b94a-cfb55551683e"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "y"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b2e3fac-77d6-42d4-83de-f92b7bd0a444"],
 " a ray and a line. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0ceef005-d848-40bb-b319-d8730150da0e"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2809c16f-d277-4054-b34d-2bade6360902"],
 " is a circle about ",
 StyleBox["x", "TI"],
 " at radius ",
 StyleBox["r", "TI"],
 ", or in the band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "s"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35074f3c-d509-4f42-a4f4-011f941b4966"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8c154557-70b9-4e8e-8041-de163b69a33a"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "y"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16c65670-0d8c-4c1e-82d7-52ea21413c76"],
 " is a vertex the two objects share; an operand may be a token itself."
}], "Notes",ExpressionUUID->"c83de7a6-880c-48e9-b219-05fc9048e74b"],

Cell["\<\
A token stands for its realisations, and each realisation is one branch. So a \
construction binds its object to a single vertex, or a single vertex list, \
per branch, and the branches multiply from one construction to the next.\
\>", "Notes",ExpressionUUID->"4ed18be0-9c78-4852-a27e-0f57b15571a1"],

Cell[TextData[{
 "The token is the head itself: the second argument of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "37af9ec6-18b6-4181-99a0-a87a89880f8e"],
 " is always a radius or a band. The circle through a point is the closed arc \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraArc"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraArc", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a30a728b-136f-491d-b287-c85a051903e1"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "p"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "500a74d9-5fcd-40f5-a417-de4b38c23c45"],
 "."
}], "Notes",ExpressionUUID->"f0f51e92-fd77-4a5e-956d-d691e0850bdc"],

Cell[TextData[{
 "An assertion is a predicate on objects: a comparison of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDistance"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDistance", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6a7b5e53-7a86-495d-a69c-13d7cb4f1cc0"],
 " values, or one of the ",
 Cell[BoxData[
  RowBox[{"Infra", "*", "Q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d965f36-c02e-4ed5-8abb-e65a73181aa9"],
 " tests without its graph (",
 Cell[BoxData[
  RowBox[{"InfraSegmentQ", "[", "s", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0577b020-834b-4753-9510-4f9bf0530fcc"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraCircleQ", "[", "c", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4399e642-ecbd-48ac-8706-a3efd81edb70"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraParallelQ", "[", 
   RowBox[{"l1", ",", " ", "l2"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f43c628-a283-4802-965f-2be50063972e"],
 " and a few more). The graph is supplied when the scene is solved, and a \
branch survives only if every assertion holds on it. An ",
 Cell[BoxData[
  RowBox[{"Infra", "*", "Q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44c9c6fa-2136-486e-90be-5587c431f901"],
 " test that cannot be given the graph is refused with ",
 Cell[BoxData[
  RowBox[{"InfraScene", "::", "badassertion"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3310a00-8b7c-4aba-b78f-e64159dac496"],
 "."
}], "Notes",ExpressionUUID->"4b0e010a-6802-4b3d-a93e-c5b39aeca0c4"],

Cell[TextData[{
 "Without ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraStep"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraStep", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "47ac673e-e0cd-4a70-ba71-a63eac85f299"],
 ", the steps are the levels of the dependency graph of the constructions: \
first the objects that depend on no other object, then those that depend only \
on them, and so on. With it, the steps are the ones written, in order."
}], "Notes",ExpressionUUID->"116f59d5-1945-48bb-8d40-6aeca1c05074"],

Cell[TextData[{
 "The objects are ordinary symbols, so they must have no value when the scene \
is built; ",
 Cell[BoxData["ClearAll"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4aa083eb-6725-478a-b601-1efe2ac49f32"],
 " them first."
}], "Notes",ExpressionUUID->"787aa77c-9103-4f17-a208-3b1f3d3ec067"],

Cell[TextData[{
 "A scene answers ",
 Cell[BoxData["\"\<Objects\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05627298-17c5-455c-9170-e5650b702add"],
 ", ",
 Cell[BoxData["\"\<Constructions\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d94c2fc-a584-4d96-8df3-a6f3b97f1c90"],
 ", ",
 Cell[BoxData["\"\<Assertions\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99331ca4-7235-4d5d-a44c-159c1fff874f"],
 ", ",
 Cell[BoxData["\"\<Steps\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "787e2bed-ac94-49fa-a55a-fa31ef00e12c"],
 ", ",
 Cell[BoxData["\"\<Labels\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "353990f0-42a3-4a55-81ba-3275420f0fea"],
 " and ",
 Cell[BoxData["\"\<DependencyGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8853919e-634a-42b5-ac88-24b82518835b"],
 ". The dependency graph is ",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf7cb29c-f059-4a10-8789-353173aaa198"],
 " when the steps are written by hand."
}], "Notes",ExpressionUUID->"16c12059-9548-49c5-af30-eab5ae6888c9"],

Cell[TextData[{
 StyleBox["A construction can stall.",
  FontWeight->"Bold"],
 " Euclid never postulated that the two circles of I.1 meet, and on a graph \
they need not. On a square grid a single distance shell spans no cycle, so \
the circles of I.1 at one radius do not exist. That is the continuity \
assumption Euclid left unstated, showing up as an empty result. A band two \
radii thick carries the circles, and there the construction goes through."
}], "Notes",ExpressionUUID->"cdc7bcae-59c0-402e-ae8d-33e77de6ea55"]
}, Open  ]],

