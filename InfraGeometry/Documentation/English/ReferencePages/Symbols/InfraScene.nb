 " may be a token, bound to no name."
}], "ExampleText",ExpressionUUID->"c2e70d5c-6a86-4a94-bc36-ff11ff2f2ca6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"pA", ",", " ", "pB", ",", " ", "circleA", ",", " ", "meet"}], 
   "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"13", ",", " ", "13"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pA", ",", " ", "pB", ",", " ", "circleA", ",", " ", "meet"}],
         "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "83", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "87", "]"}]}], ",", " ", 
         RowBox[{"circleA", " ", "==", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"pA", ",", " ", 
            RowBox[{"{", 
             RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}], ",", "\n", 
         "      ", 
         RowBox[{"meet", " ", "==", " ", 
          RowBox[{"InfraIntersection", "[", 
           RowBox[{"circleA", ",", " ", 
            RowBox[{"InfraCircle", "[", 
             RowBox[{"pB", ",", " ", 
              RowBox[{"{", 
               RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}], "]"}]}]}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"InfraSceneInstance", "[", 
      RowBox[{"#", ",", " ", "meet"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"FindInfraScene", "[", 
     RowBox[{"scene", ",", " ", "g"}], "]"}]}]}], "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"af1ca984-1088-4dd6-8daf-a534caa671b8"],

