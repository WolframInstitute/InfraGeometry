Cell["The objects, the step labels and the steps.", "ExampleText",ExpressionUUID->"7269c93d-245d-42ce-9b82-84784b1a0d01"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "pA", ",", " ", "pB", ",", " ", "circleA", ",", " ", "circleB", ",", " ", 
    "meet"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "pA", ",", " ", "pB", ",", " ", "circleA", ",", " ", "circleB", ",", 
         " ", "meet"}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"pA", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "83", "]"}]}], "}"}], ",", 
           " ", "\"\<point A\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"pB", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "87", "]"}]}], "}"}], ",", 
           " ", "\"\<point B\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"circleA", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"pA", ",", " ", 
               RowBox[{"{", 
                RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle about A\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"circleB", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"pB", ",", " ", 
               RowBox[{"{", 
                RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle about B\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"meet", " ", "==", " ", 
             RowBox[{"InfraIntersection", "[", 
              RowBox[{"circleA", ",", " ", "circleB"}], "]"}]}], "}"}], ",", 
           " ", "\"\<where they meet\>\""}], "]"}]}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"scene", "[", "\"\<Objects\>\"", "]"}], ",", " ", 
     RowBox[{"scene", "[", "\"\<Labels\>\"", "]"}], ",", " ", 
     RowBox[{"scene", "[", "\"\<Steps\>\"", "]"}]}], "}"}]}], "]"}]}], "Input",\

