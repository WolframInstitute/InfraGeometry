Cell["\<\
At a single radius the grid has no circle, so the construction finds nothing.\
\
\>", "ExampleText",ExpressionUUID->"6f661000-ddbb-4fc6-bb9d-e6d3f0d130f0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "pA", ",", " ", "pB", ",", " ", "circleA", ",", " ", "circleB", ",", " ", 
    "meet"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"13", ",", " ", "13"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "pA", ",", " ", "pB", ",", " ", "circleA", ",", " ", "circleB", ",", 
         " ", "meet"}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "83", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "87", "]"}]}], ",", "\n", "      ", 
         RowBox[{"circleA", " ", "==", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"pA", ",", " ", "4"}], "]"}]}], ",", " ", 
         RowBox[{"circleB", " ", "==", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"pB", ",", " ", "4"}], "]"}]}], ",", "\n", "      ", 
         RowBox[{"meet", " ", "==", " ", 
          RowBox[{"InfraIntersection", "[", 
           RowBox[{"circleA", ",", " ", "circleB"}], "]"}]}]}], "}"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraCircle", "[", 
       RowBox[{"g", ",", " ", "83", ",", " ", 
        RowBox[{"\"\<Radius\>\"", " ", "->", " ", "4"}], ",", " ", "All"}], 
       "]"}]}], ",", " ", 
     RowBox[{"FindInfraScene", "[", 
      RowBox[{"scene", ",", " ", "g"}], "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6aa2eec3-b448-4543-9c3a-841202261361"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7fe4db33-7f95-40e8-b93f-9f1f4bc9bb42"]
}, Open  ]],

Cell["\<\
On the discretized plane a single radius suffices: its shells are cycles by \
accident of the mesh.\
\>", "ExampleText",ExpressionUUID->"899a9524-4a91-4c41-890f-1223d758541e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "pA", ",", " ", "pB", ",", " ", "circleA", ",", " ", "circleB", ",", " ", 
    "meet"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"centre", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"farPoint", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "centre", ",", " ", "#"}], "]"}], " ", "==", 
         " ", "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "pA", ",", " ", "pB", ",", " ", "circleA", ",", " ", "circleB", ",", 
         " ", "meet"}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "centre", "]"}]}], ",", " ", 
         RowBox[{"pB", " ", "==", " ", 
          RowBox[{"InfraPoint", "[", "farPoint", "]"}]}], ",", "\n", "      ", 
         RowBox[{"circleA", " ", "==", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"pA", ",", " ", "4"}], "]"}]}], ",", " ", 
         RowBox[{"circleB", " ", "==", " ", 
          RowBox[{"InfraCircle", "[", 
           RowBox[{"pB", ",", " ", "4"}], "]"}]}], ",", "\n", "      ", 
         RowBox[{"meet", " ", "==", " ", 
          RowBox[{"InfraIntersection", "[", 
           RowBox[{"circleA", ",", " ", "circleB"}], "]"}]}]}], "}"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Length", " ", "@", " ", 
    RowBox[{"FindInfraScene", "[", 
     RowBox[{"scene", ",", " ", "g"}], "]"}]}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"63b7df8d-de45-4c1a-a37e-d0b864572a19"],

Cell[BoxData["4"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"512fbdaa-de19-4412-9396-4b1ad424e981"]
}, Open  ]],

