Notebook[{

Cell[CellGroupData[{
Cell["InfraScene", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"97ec68d3-2dfc-43da-9699-4aafa540c631"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraScene"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["x1", "TI"], ",", " ", 
      StyleBox["x2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["hyp1", "TI"], ",", " ", 
      StyleBox["hyp2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a3375a0-175d-45d5-ab72-727a431504ee"],
 "\[LineSeparator]",
 "is a construction stated before any graph: the objects ",
 StyleBox["xi", "TI"],
 ", and hypotheses that construct them or assert relations between them.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"962d484a-7f2e-4de6-85ce-1ce008da4fcd"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraScene"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["x1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraGeometricStep", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          StyleBox["hyp1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
        
        StyleBox["label", "TI"]}], "]"}], ",", " ", "\[Ellipsis]"}], "}"}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f6c1a17-a48c-4d9f-a435-36bca161975b"],
 "\[LineSeparator]",
 "groups the hypotheses into labelled steps."
}], "Usage",ExpressionUUID->"095eb41c-ffa9-46c6-9789-4f90e3ea1620"],

Cell[TextData[{
 "Definition: a scene is a list of objects and a list of hypotheses. A ",
 StyleBox["construction",
  FontWeight->"Bold"],
 " is a hypothesis ",
 Cell[BoxData[
  RowBox[{"x", " ", "==", " ", "token"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c179a08-5730-4840-a523-577ff699afcd"],
 ", whose left side is an object. Every other hypothesis is an ",
 StyleBox["assertion",
  FontWeight->"Bold"],
 ". A scene computes nothing; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2c38be80-d42f-4def-9877-559ba066a9b2"],
 " solves it on a graph."
}], "Notes",ExpressionUUID->"fc981712-d6bc-4fae-ad26-467a93ae8e39"],

Cell[TextData[{
 "The right side of a construction is a token: an inert head with objects in \
place of points. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "88f6619f-18d3-4ad5-b83e-2e37151bb5f7"],
 Cell[BoxData[
  RowBox[{"[", "v", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6050ddd-234c-4dd1-bb73-6cad37809935"],
 " is the vertex ",
 StyleBox["v", "TI"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPoint"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPoint", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "187ed148-f332-47f5-8aa1-3c17e803df66"],
 " every vertex at distance ",
 StyleBox["d", "TI"],
 " from ",
 StyleBox["v", "TI"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "594dbfbb-546d-474d-aed5-1c14b7dcf577"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "y"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9c29a61-e3db-4a97-ac52-f7923dd1cd6a"],
 " is a geodesic from ",
 StyleBox["x", "TI"],
 " to ",
 StyleBox["y", "TI"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRay"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraRay", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "131484f8-76c7-4589-bd91-df562b956675"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "y"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3f9a7b9-902c-4abd-9862-e095c680989b"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a1b0962b-89fd-4bb0-aac3-57de340c35f8"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "y"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d27bd325-c1ce-4067-a617-c3700d476e10"],
 " a ray and a line. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1885da6d-8f01-49f6-963f-cad92062b777"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "763e9276-c970-4fbe-a70c-81f44c3b8abc"],
 " is a circle about ",
 StyleBox["x", "TI"],
 " at radius ",
 StyleBox["r", "TI"],
 ", or in the band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "s"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "521b99cb-1745-4fdf-83b9-0ca203ac34f3"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d9f3b2b2-0f59-45bd-a48f-c1b4eefe2fec"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "y"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16edc433-8263-44d3-ad7b-4149fc937448"],
 " is a vertex the two objects share; an operand may be a token itself."
}], "Notes",ExpressionUUID->"f31926ce-4a57-4247-9e11-32ca3d507554"],

Cell["\<\
A token stands for its realisations, and each realisation is one branch. So a \
construction binds its object to a single vertex, or a single vertex list, \
per branch, and the branches multiply from one construction to the next.\
\>", "Notes",ExpressionUUID->"6d080a5c-d380-496c-a985-808a41ca7595"],

Cell[TextData[{
 "Inside a scene the token ",
 Cell[BoxData[
  RowBox[{"InfraCircle", "[", 
   RowBox[{"x", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b561ee2e-60dd-455f-990d-cec65336b792"],
 " reads ",
 StyleBox["r", "TI"],
 " as a radius. As a head, a bare second argument of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c5ee8910-eeda-40e2-a3da-5c9e40df9438"],
 " is always a point. This is an open inconsistency."
}], "Notes",ExpressionUUID->"8b8344fa-1900-4669-8757-5c80c9923430"],

Cell[TextData[{
 "An assertion is a predicate on objects: a comparison of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDistance"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDistance", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "00c8d408-22cb-4358-b8af-197941182251"],
 " values, or one of the ",
 Cell[BoxData[
  RowBox[{"Infra", "*", "Q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b866175-1bde-414f-b44b-c5db1d492128"],
 " tests without its graph (",
 Cell[BoxData[
  RowBox[{"InfraSegmentQ", "[", "s", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df9e0816-2eb3-4d12-a5f8-d68bcd197b2d"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraCircleQ", "[", "c", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cbb850c-d04c-4376-8b78-8cdcf5e41d43"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraParallelQ", "[", 
   RowBox[{"l1", ",", " ", "l2"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e230f182-b989-48be-84cf-c9d7c39e6a16"],
 " and a few more). The graph is supplied when the scene is solved, and a \
branch survives only if every assertion holds on it. An ",
 Cell[BoxData[
  RowBox[{"Infra", "*", "Q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "143f645c-50d6-44c2-8680-22633b938c2f"],
 " test that cannot be given the graph is refused with ",
 Cell[BoxData[
  RowBox[{"InfraScene", "::", "badassertion"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e07d5b91-e4a5-4a89-95c7-12d0450a91ad"],
 "."
}], "Notes",ExpressionUUID->"995b7009-255a-44cf-b425-20bf9a1967c1"],

Cell[TextData[{
 "Without ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraGeometricStep"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraGeometricStep", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8d1f513d-f344-47b1-8919-87cd7e1290ef"],
 ", the steps are the levels of the dependency graph of the constructions: \
first the objects that depend on no other object, then those that depend only \
on them, and so on. With it, the steps are the ones written, in order."
}], "Notes",ExpressionUUID->"301091dc-aa3a-4e88-b476-000e3344aa63"],

Cell[TextData[{
 "The objects are ordinary symbols, so they must have no value when the scene \
is built; ",
 Cell[BoxData["ClearAll"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e7f4ea0-1767-4bdd-a84c-476eede5791a"],
 " them first."
}], "Notes",ExpressionUUID->"6badd7a3-a56e-4c05-96eb-4c42312c3740"],

Cell[TextData[{
 "A scene answers ",
 Cell[BoxData["\"\<Objects\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e1d2cce-a120-448e-b01d-91d413f844a9"],
 ", ",
 Cell[BoxData["\"\<Constructions\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8170b9da-7b3f-4781-90cb-edb505013b5b"],
 ", ",
 Cell[BoxData["\"\<Assertions\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "215da178-4f7c-42b1-a100-4c7f6dcf1eee"],
 ", ",
 Cell[BoxData["\"\<Steps\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f635511e-be4b-4523-8f80-66dafcb42381"],
 ", ",
 Cell[BoxData["\"\<Labels\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14291987-53dc-4e19-bc1a-6ce9ed424d6b"],
 " and ",
 Cell[BoxData["\"\<DependencyGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8cfbc68c-9a47-4a03-b363-e0e834e118ff"],
 ". The dependency graph is ",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ee853b1-b9a9-46a3-aa0a-02eaf98f0e0c"],
 " when the steps are written by hand."
}], "Notes",ExpressionUUID->"318b2718-2043-4122-8c0a-9f537379da4e"],

Cell[TextData[{
 StyleBox["A construction can stall.",
  FontWeight->"Bold"],
 " Euclid never postulated that the two circles of I.1 meet, and on a graph \
they need not. On a square grid a single distance shell spans no cycle, so \
the circles of I.1 at one radius do not exist. That is the continuity \
assumption Euclid left unstated, showing up as an empty result. A band two \
radii thick carries the circles, and there the construction goes through."
}], "Notes",ExpressionUUID->"1e920bfa-16be-4d61-b0f2-7b1bd7993239"]
}, Open  ]],

