Notebook[{

Cell[CellGroupData[{
Cell["InfraScene", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7c34277d-925e-4237-8686-470998725591"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraScene"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["x1", "TI"], ",", " ", 
      StyleBox["x2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["hyp1", "TI"], ",", " ", 
      StyleBox["hyp2", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4170fe37-55ff-47d5-8180-e205cf6aa02f"],
 "\[LineSeparator]",
 "is a construction stated before any graph: the objects ",
 StyleBox["xi", "TI"],
 ", and hypotheses that construct them or assert relations between them.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"dd667b2a-2953-40b4-8938-d7d57172f688"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraScene"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["x1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraStep", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          StyleBox["hyp1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
        
        StyleBox["label", "TI"]}], "]"}], ",", " ", "\[Ellipsis]"}], "}"}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3a24b60-08b8-4183-b0e8-1cb4a8c67e84"],
 "\[LineSeparator]",
 "groups the hypotheses into labelled steps."
}], "Usage",ExpressionUUID->"bb60665c-d49d-4015-b0e9-0ca6e2f62b8f"],

Cell[TextData[{
 "Definition: a scene is a list of objects and a list of hypotheses. A ",
 StyleBox["construction",
  FontWeight->"Bold"],
 " is a hypothesis ",
 Cell[BoxData[
  RowBox[{"x", " ", "==", " ", "token"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "89c125eb-71af-4dce-b05f-6f2cced6b050"],
 ", whose left side is an object. Every other hypothesis is an ",
 StyleBox["assertion",
  FontWeight->"Bold"],
 ". A scene computes nothing; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1dbcc3f3-6ebe-4527-91ff-1479051eef95"],
 " solves it on a graph."
}], "Notes",ExpressionUUID->"95617235-cc14-4908-baf9-ed6f7779d6ee"],

Cell[TextData[{
 "The right side of a construction is a token: an inert head with objects in \
place of points. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraPoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4dbcf92d-598e-49a2-a814-a805c438ee11"],
 Cell[BoxData[
  RowBox[{"[", "v", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c521087d-e342-4b56-a2eb-cc87e8be44d0"],
 " is the vertex ",
 StyleBox["v", "TI"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPoint"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraPoint", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ece2037c-d116-4cfb-9cf4-715099c20136"],
 " every vertex at distance ",
 StyleBox["d", "TI"],
 " from ",
 StyleBox["v", "TI"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "46214599-e64e-4c4e-bc87-ada1b2f682e4"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "y"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1f61c43-bb9e-4798-9b68-6819b22614bc"],
 " is a geodesic from ",
 StyleBox["x", "TI"],
 " to ",
 StyleBox["y", "TI"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRay"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraRay", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ee54493e-93b5-4c78-ad44-3f49aa3f0475"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "y"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47d7f58d-2a47-4705-9af8-778c464ffbb3"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c38a6188-00fe-4231-afee-3d143201411f"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "y"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2777ee04-cd31-42fd-8261-a834bb879e0a"],
 " a ray and a line. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f942d603-8742-4d18-b884-8bfbb003346f"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57f50e2f-e77f-4842-9c8b-c5a8770d9c15"],
 " is a circle about ",
 StyleBox["x", "TI"],
 " at radius ",
 StyleBox["r", "TI"],
 ", or in the band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", "s"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9528a318-9638-4bb1-8a11-6951344204c1"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraIntersection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraIntersection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "78216e0d-5bd6-48d4-99d7-8de9bcc93787"],
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"x", ",", " ", "y"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aef3e298-5524-46cf-b590-5fb709094594"],
 " is a vertex the two objects share; an operand may be a token itself."
}], "Notes",ExpressionUUID->"db8d54fe-c3d9-4a3c-9d9a-dc22b41c6f22"],

Cell["\<\
A token stands for its realisations, and each realisation is one branch. So a \
construction binds its object to a single vertex, or a single vertex list, \
per branch, and the branches multiply from one construction to the next.\
\>", "Notes",ExpressionUUID->"80050924-28b6-4596-a2bd-07142d00968f"],

Cell[TextData[{
 "Inside a scene the token ",
 Cell[BoxData[
  RowBox[{"InfraCircle", "[", 
   RowBox[{"x", ",", " ", "r"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff19e53e-e43d-40b6-b618-58afa86dc188"],
 " reads ",
 StyleBox["r", "TI"],
 " as a radius. As a head, a bare second argument of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a340b709-2990-4cee-a4f4-af29a8f0361b"],
 " is always a point. This is an open inconsistency."
}], "Notes",ExpressionUUID->"7e5e167e-28c0-42b8-9e22-dabdb908610c"],

Cell[TextData[{
 "An assertion is a predicate on objects: a comparison of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDistance"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDistance", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3e8206b8-3505-45b0-9c66-b6cc15015a9c"],
 " values, or one of the ",
 Cell[BoxData[
  RowBox[{"Infra", "*", "Q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a07efeed-f58c-4b22-8c9c-14e1a00ec522"],
 " tests without its graph (",
 Cell[BoxData[
  RowBox[{"InfraSegmentQ", "[", "s", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef96330e-7041-4d8d-a3e9-8c22a7270431"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraCircleQ", "[", "c", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "602251ac-8197-4b77-b051-bd38b80c2f1b"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraParallelQ", "[", 
   RowBox[{"l1", ",", " ", "l2"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55eb1057-4b71-41ba-ab93-b5aa36150af0"],
 " and a few more). The graph is supplied when the scene is solved, and a \
branch survives only if every assertion holds on it. An ",
 Cell[BoxData[
  RowBox[{"Infra", "*", "Q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24874d79-da7a-48b5-b4ce-aae95baa1d9d"],
 " test that cannot be given the graph is refused with ",
 Cell[BoxData[
  RowBox[{"InfraScene", "::", "badassertion"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08a7a853-d10b-41fa-bdad-e7830eadffb9"],
 "."
}], "Notes",ExpressionUUID->"2b312570-0650-482b-af69-f7b1f806bc8e"],

Cell[TextData[{
 "Without ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraStep"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraStep", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b6a7356d-3e19-40d3-972e-ab7105cc0aad"],
 ", the steps are the levels of the dependency graph of the constructions: \
first the objects that depend on no other object, then those that depend only \
on them, and so on. With it, the steps are the ones written, in order."
}], "Notes",ExpressionUUID->"5f8f7794-e3e1-4a1c-94b6-4f73bb916126"],

Cell[TextData[{
 "The objects are ordinary symbols, so they must have no value when the scene \
is built; ",
 Cell[BoxData["ClearAll"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ccb17fb-edc1-4f43-9206-122527d7fe43"],
 " them first."
}], "Notes",ExpressionUUID->"61777cac-0d1d-4f27-9dfb-50105f066e31"],

Cell[TextData[{
 "A scene answers ",
 Cell[BoxData["\"\<Objects\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31bd9299-0465-44d8-afb8-2e35838b2737"],
 ", ",
 Cell[BoxData["\"\<Constructions\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10f749c9-e29a-4f8c-85b7-d42f9ea44837"],
 ", ",
 Cell[BoxData["\"\<Assertions\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e53e5737-b1e9-486b-b6b5-af155bf897fb"],
 ", ",
 Cell[BoxData["\"\<Steps\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48055761-8226-436d-83b6-6b46cc3da836"],
 ", ",
 Cell[BoxData["\"\<Labels\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3248db28-8b46-49fe-a8b3-58f62ac6d943"],
 " and ",
 Cell[BoxData["\"\<DependencyGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a867c27-c0da-4174-ae2f-ab0a97424bbd"],
 ". The dependency graph is ",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f03f37a-83fd-4816-a500-b4a4ce243208"],
 " when the steps are written by hand."
}], "Notes",ExpressionUUID->"4380104c-f0f2-4bcb-be1a-ade2b4c32a58"],

Cell[TextData[{
 StyleBox["A construction can stall.",
  FontWeight->"Bold"],
 " Euclid never postulated that the two circles of I.1 meet, and on a graph \
they need not. On a square grid a single distance shell spans no cycle, so \
the circles of I.1 at one radius do not exist. That is the continuity \
assumption Euclid left unstated, showing up as an empty result. A band two \
radii thick carries the circles, and there the construction goes through."
}], "Notes",ExpressionUUID->"1c4ac05b-33c1-4d0e-8599-0840434ee141"]
}, Open  ]],

