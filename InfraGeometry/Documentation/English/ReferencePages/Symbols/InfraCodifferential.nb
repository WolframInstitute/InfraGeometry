Cell["An edge may be named in either orientation.", "ExampleText",ExpressionUUID->"52b91aa3-b44b-42a3-969a-19b6fb914ebe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Normal", " ", "@", " ", 
  RowBox[{"InfraMeasurement", "[", 
   RowBox[{
    RowBox[{"PathGraph", "[", 
     RowBox[{"Range", "[", "4", "]"}], "]"}], ",", "\n", "  ", 
    RowBox[{"InfraCodifferential", "[", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{
        RowBox[{"DirectedEdge", "[", 
         RowBox[{"1", ",", " ", "2"}], "]"}], " ", "->", " ", "3"}], ",", " ", 
       RowBox[{
        RowBox[{"DirectedEdge", "[", 
         RowBox[{"3", ",", " ", "2"}], "]"}], " ", "->", " ", "5"}], ",", " ", 
       RowBox[{
        RowBox[{"DirectedEdge", "[", 
         RowBox[{"3", ",", " ", "4"}], "]"}], " ", "->", " ", "1"}]}], "|>"}],
      "]"}], ",", " ", "\"\<Function\>\""}], "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"25da88d6-4cd8-463d-b2c0-98d024943741"],

