Cell["\<\
The codifferential of a 1-form on the diamond. The bottom only sends, the top \
only receives.\
\>", "ExampleText",ExpressionUUID->"db497d5a-5b47-42c1-a9da-d0f082c35b55"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Normal", " ", "@", " ", 
  RowBox[{"InfraMeasurement", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Graph", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"2", " ", "->", " ", "4"}], ",", " ", 
        RowBox[{"3", " ", "->", " ", "4"}]}], "}"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"InfraCodifferential", "[", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{
        RowBox[{"DirectedEdge", "[", 
         RowBox[{"1", ",", " ", "2"}], "]"}], " ", "->", " ", "3"}], ",", " ", 
       RowBox[{
        RowBox[{"DirectedEdge", "[", 
         RowBox[{"1", ",", " ", "3"}], "]"}], " ", "->", " ", "5"}], ",", " ", 
       RowBox[{
        RowBox[{"DirectedEdge", "[", 
         RowBox[{"2", ",", " ", "4"}], "]"}], " ", "->", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{
        RowBox[{"DirectedEdge", "[", 
         RowBox[{"3", ",", " ", "4"}], "]"}], " ", "->", " ", "2"}]}], "|>"}],
      "]"}], ",", " ", "\"\<Function\>\""}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"affee880-2f48-41f5-b595-18602d5e8fbc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "\[Rule]", 
    RowBox[{"-", "8"}]}], ",", 
   RowBox[{"2", "\[Rule]", "4"}], ",", 
   RowBox[{"3", "\[Rule]", "3"}], ",", 
   RowBox[{"4", "\[Rule]", "1"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"072d284e-4647-4ea7-aabe-ea96e2081754"]
}, Open  ]],

Cell["\<\
The codifferential of the differential of the distance from the centre \
counts, at each vertex, the neighbours nearer the centre minus those farther \
out. It is drawn where it is negative, by its size, on the discretized plane, \
the square grid and the hexagonal tiling: at the vertices with more edges \
leading away from the centre than towards it. On the square grid these are \
the axes, the corners of the balls.\
\>", "ExampleText",ExpressionUUID->"835342ff-3a4f-478e-84a9-6e3e14df5a49"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"divergence", " ", "=", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCodifferential", "[", 
           RowBox[{"InfraDifferential", "[", 
            RowBox[{"AssociationThread", "[", 
             RowBox[{
              RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
              RowBox[{"GraphDistance", "[", 
               RowBox[{"g", ",", " ", "c"}], "]"}]}], "]"}], "]"}], "]"}], ",",
           " ", "\"\<Function\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Select", "[", 
            RowBox[{"divergence", ",", " ", "Negative"}], "]"}]}], ",", " ", 
          "c"}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c29767fc-6b0c-48e1-bb98-b1178fd7cedf"],

