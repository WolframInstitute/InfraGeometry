Cell[TextData[{
 "Gauss: the integral of ",
 StyleBox["\[Delta]\[Omega]", "TI"],
 " over a ball is the flux of ",
 StyleBox["\[Omega]", "TI"],
 " into the ball, the values on the edges entering it minus those on the \
edges leaving it:"
}], "ExampleText",ExpressionUUID->"7bae3123-6f77-4f86-83bb-67e7bd731902"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"ball", " ", "=", " ", 
     RowBox[{"InfraBall", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "3"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"omega", " ", "=", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"3", " ", 
             RowBox[{"First", "[", "#", "]"}]}], " ", "+", " ", 
            RowBox[{"Last", "[", "#", "]"}]}], ",", " ", "7"}], "]"}], " ", "-",
          " ", "3"}], " ", "&"}], ",", " ", 
       RowBox[{"DirectedEdge", " ", "@@@", " ", 
        RowBox[{"EdgeList", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraIntegral", "[", 
        RowBox[{
         RowBox[{"InfraCodifferential", "[", "omega", "]"}], ",", " ", 
         "ball"}], "]"}], ",", " ", "\"\<Value\>\""}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraIntegral", "[", 
        RowBox[{"omega", ",", " ", "ball"}], "]"}], ",", 
       " ", "\"\<Flux\>\""}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e39fd84b-7ae3-4c86-8175-4186b87690e2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "6"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"20d7e693-4cd8-4026-be4e-d0804a27a1b4"]
}, Open  ]],

Cell["\<\
The whole graph has no boundary, so the codifferential sums to 0:\
\>", "ExampleText",ExpressionUUID->"3325092e-d98a-442d-aeed-324e5efcf5a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"omega", " ", "=", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"3", " ", 
             RowBox[{"First", "[", "#", "]"}]}], " ", "+", " ", 
            RowBox[{"Last", "[", "#", "]"}]}], ",", " ", "7"}], "]"}], " ", "-",
          " ", "3"}], " ", "&"}], ",", " ", 
       RowBox[{"DirectedEdge", " ", "@@@", " ", 
        RowBox[{"EdgeList", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"Total", " ", "@", " ", 
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraCodifferential", "[", "omega", "]"}], ",", 
      " ", "\"\<Function\>\""}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a1dbd698-e951-457a-ad34-95be8865eeab"],

Cell[BoxData["0"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"d3a3c412-9e70-4052-bdf8-52a628301a69"]
}, Open  ]],

Cell[TextData[{
 "The codifferential of a differential is the Laplacian, the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KirchhoffMatrix"]], "paclet:ref/KirchhoffMatrix"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "15e9fdff-8244-46c8-b338-a47e2b2dcc11"],
 " applied to ",
 StyleBox["f", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"663b7f6e-79c4-45f2-82c9-126e71b6d8be"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"#", "^", "2"}], ",", " ", "11"}], "]"}], " ", "&"}], ",", 
       " ", 
       RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{
    RowBox[{"Values", " ", "@", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCodifferential", "[", 
        RowBox[{"InfraDifferential", "[", "f", "]"}], "]"}], ",", 
       " ", "\"\<Function\>\""}], "]"}]}], " ", "===", "\n", "    ", 
    RowBox[{
     RowBox[{"KirchhoffMatrix", "[", "g", "]"}], " ", ".", " ", 
     RowBox[{"Values", "[", "f", "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"ca68c77a-09c0-4209-ab8c-5693d2a38ec2"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"f2f3b39b-2523-4113-897d-ec94a88ebb70"]
}, Open  ]],

Cell["\<\
On a directed acyclic graph it is the Laplacian of the undirected Hasse \
diagram, which an implied edge does not change:\
\>", "ExampleText",ExpressionUUID->"71d9ccc6-81f7-4767-8e6b-6a1927c1e900"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dag", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"2", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"1", " ", "->", " ", "4"}], ",", " ", 
        RowBox[{"4", " ", "->", " ", "5"}], ",", " ", 
        RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
        RowBox[{"5", " ", "->", " ", "6"}], ",", " ", 
        RowBox[{"1", " ", "->", " ", "6"}]}], "}"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"1", " ", "->", " ", "5"}], ",", " ", 
       RowBox[{"2", " ", "->", " ", 
        RowBox[{"-", "2"}]}], ",", " ", 
       RowBox[{"3", " ", "->", " ", "7"}], ",", " ", 
       RowBox[{"4", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"5", " ", "->", " ", "3"}], ",", " ", 
       RowBox[{"6", " ", "->", " ", 
        RowBox[{"-", "4"}]}]}], "|>"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Values", " ", "@", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"dag", ",", " ", 
       RowBox[{"InfraCodifferential", "[", 
        RowBox[{"InfraDifferential", "[", "f", "]"}], "]"}], ",", 
       " ", "\"\<Function\>\""}], "]"}]}], " ", "===", "\n", "    ", 
    RowBox[{
     RowBox[{"KirchhoffMatrix", "[", 
      RowBox[{"UndirectedGraph", " ", "@", " ", 
       RowBox[{"TransitiveReductionGraph", "[", "dag", "]"}]}], "]"}], " ", ".",
      " ", 
     RowBox[{"Values", "[", "f", "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"eaa65430-5fa6-4fba-906d-7ef38ee8c6d5"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"10d8c891-c073-4410-8640-59c1078d393b"]
}, Open  ]]
}, Open  ]],

