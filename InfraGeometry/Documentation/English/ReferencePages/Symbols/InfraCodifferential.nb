    "directed acyclic graph", "TableText",ExpressionUUID->
     "158b9840-c193-41bc-b1be-d795468752c4"], Cell[TextData[{
     "the links into and out of ",
     StyleBox["v", "TI"],
     ", the edges of ",
     Cell[BoxData["TransitiveReductionGraph"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1e42fc64-9d82-4f23-82ac-f160a72dce24"]
    }], "TableText",ExpressionUUID->"2511fff6-ab6b-41b0-b320-a3a91cb2737d"]},
