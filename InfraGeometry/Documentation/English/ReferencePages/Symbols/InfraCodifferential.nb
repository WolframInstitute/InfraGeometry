Cell[TextData[{
 "The integral of ",
 StyleBox["\[Delta]\[Omega]", "TI"],
 " over a region is the flux of ",
 StyleBox["\[Omega]", "TI"],
 " into it (Gauss). The codifferential of a differential is the graph \
Laplacian: ",
 StyleBox["\[Delta]df(v) = \[CapitalSigma] (f(v) \[Minus] f(u))", "TI"],
 ", the sum over the neighbours ",
 StyleBox["u", "TI"],
 " of ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"a1cd020e-2f37-4c75-a150-9219a983eb88"]
}, Open  ]],

