Cell["\<\
The codifferential of the differential of the distance from the centre: at \
each vertex, the neighbours nearer the centre minus those farther out. \
Negative values are drawn as rings. On the grid it is \[Minus]4 at the \
centre, \[Minus]2 on the axes, 1 at the pendant vertices of the rim and 0 \
elsewhere:\
\>", "ExampleText",ExpressionUUID->"294f89a0-8638-45a3-85de-983d9677f022"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"div", " ", "=", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCodifferential", "[", 
           RowBox[{"InfraDifferential", "[", 
            RowBox[{
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "&"}], 
            "]"}], "]"}], ",", " ", "\"\<Function\>\""}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"div", ",", " ", "c"}], "}"}]}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"13373333-cb34-44d1-b6ed-aa6f83cb1918"],

