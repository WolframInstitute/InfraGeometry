Notebook[{

Cell[CellGroupData[{
Cell["InfraCodifferential", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ad49b33d-9186-4a8f-89a4-ac884ee8cf61"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCodifferential"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCodifferential", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["\[Omega]", "TR"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8753527-be94-41ed-8145-0188fcf6ab0d"],
 "\[LineSeparator]",
 "is the codifferential of the 1-form ",
 StyleBox["\[Omega]", "TI"],
 ": the vertex function ",
 StyleBox["\[Delta]\[Omega](v)", "TI"],
 ", the values of ",
 StyleBox["\[Omega]", "TI"],
 " on the links into ",
 StyleBox["v", "TI"],
 " minus those on the links out of ",
 StyleBox["v", "TI"],
 ". It is a symbolic object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0f6646e5-c91e-42ae-b5e2-1afe91f8f27c"],
 " evaluates it on a graph.",
 "\n"
}], "Usage",ExpressionUUID->"7792805d-2d7e-4aa0-aab1-2446a2ff3828"],

Cell[TextData[{
 "Definition: the codifferential of a 1-form ",
 StyleBox["\[Omega]", "TI"],
 " is the 0-form ",
 StyleBox["\[Delta]\[Omega](v) = \[CapitalSigma]", "TI"],
 StyleBox["(u \[RightArrow] v) \[Omega](u \[RightArrow] v) \[Minus] \
\[CapitalSigma]", "TI", "TI"],
 StyleBox["(v \[RightArrow] w) \[Omega](v \[RightArrow] w)", "TI"],
 ", the net amount of ",
 StyleBox["\[Omega]", "TI"],
 " flowing into ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"8cd9b662-c436-410a-97e8-bacdc741688e"],

Cell[TextData[{
 StyleBox["\[Omega]", "TI"],
 " is an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9cbe1c00-8b3a-40c9-8dd0-104bf03d50ee"],
 " on edges ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"DirectedEdge", "[", 
    RowBox[{"u", ",", " ", "v"}], "]"}], " ", "->", " ", "x"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd4d06e4-798f-4ed2-b261-adffd410150f"],
 ", in which a missing edge counts as 0, or ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDifferential"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDifferential", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["f", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "255f2520-9966-4713-a8cb-967d3cef27de"],
 ", read through its ",
 Cell[BoxData["\"\<Function\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7240c394-2c77-49e4-b943-b37690765b98"],
 ". It is read antisymmetrically, ",
 StyleBox["\[Omega](v \[RightArrow] u) = \[Minus]\[Omega](u \[RightArrow] v)",
   "TI"],
 "."
}], "Notes",ExpressionUUID->"fdf7d672-61a6-42cd-a408-71ce3aa31705"],

Cell["The edges summed over depend on the substrate:", "Notes",ExpressionUUID->"f113dd03-64be-46c4-8bf3-604536c10cff"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a5f2df7e-c007-4806-bbc2-196b3afe6ea8"], Cell["Substrate", "TableText",
     FontWeight->Bold,ExpressionUUID->"2575d5a7-9603-4a02-ac4a-c34cf9c9f7f4"],
     Cell[TextData[{
     "Edges of ",
     StyleBox["\[Delta]\[Omega](v)", "TI"]
    }], "TableText",
     FontWeight->Bold,ExpressionUUID->"2c9e8c7d-71c4-4477-9dce-d857e82599c4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
