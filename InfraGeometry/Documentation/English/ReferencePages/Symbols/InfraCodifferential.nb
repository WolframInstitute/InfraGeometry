Cell[CellGroupData[{
Cell["InfraCodifferential", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7e048098-2e54-477a-8dfd-0cc9f1617501"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCodifferential"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCodifferential", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["\[Omega]", "TR"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0c1d104-0cc7-4158-a306-2aedab9ca1d7"],
 "\[LineSeparator]",
 "is the codifferential of the 1-form ",
 StyleBox["\[Omega]", "TI"],
 ": the vertex function whose value at ",
 StyleBox["v", "TI"],
 " is the net amount of ",
 StyleBox["\[Omega]", "TI"],
 " flowing into ",
 StyleBox["v", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"e32bfffa-0160-4663-bd78-fd27f5c71e04"],

Cell[TextData[{
 "The codifferential is ",
 StyleBox["\[Delta]\[Omega](v) = \[CapitalSigma] \[Omega](u \[RightArrow] v) \
\[Minus] \[CapitalSigma] \[Omega](v \[RightArrow] w)", "TI"],
 ", the first sum over the edges ",
 StyleBox["u \[RightArrow] v", "TI"],
 " into ",
 StyleBox["v", "TI"],
 ", the second over the edges ",
 StyleBox["v \[RightArrow] w", "TI"],
 " out of ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"96151114-ef67-400d-bac8-d2ba34f7b8b4"],

Cell[TextData[{
 StyleBox["\[Omega]", "TI"],
 " is an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8caa0ff9-b503-4de1-be58-b211d4ad6091"],
 " ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"DirectedEdge", "[", 
    RowBox[{"u", ",", " ", "v"}], "]"}], " ", "->", " ", "x"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea31e46e-e460-4e78-9107-3e84d043a29f"],
 ", in which a missing edge counts as 0, or ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDifferential"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDifferential", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["f", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97b53ac3-5482-42a7-a499-6fe3cd10fee9"],
 ". It is read antisymmetrically, ",
 StyleBox["\[Omega](v \[RightArrow] u) = \[Minus]\[Omega](u \[RightArrow] v)",
   "TI"],
 ", so an edge may be named in either orientation."
}], "Notes",ExpressionUUID->"32f056c6-b279-4c81-b525-cadb53accffa"],

Cell["The edges summed over:", "Notes",ExpressionUUID->"14fd6a7d-48fb-4880-be18-0dd66675ff89"],

