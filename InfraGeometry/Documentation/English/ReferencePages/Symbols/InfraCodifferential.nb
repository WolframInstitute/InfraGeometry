Cell[TextData[{
 "Gauss: the integral of ",
 StyleBox["\[Delta]\[Omega]", "TI"],
 " over a region is the flux of ",
 StyleBox["\[Omega]", "TI"],
 " into it, the values on the edges entering it minus those on the edges \
leaving it."
}], "ExampleText",ExpressionUUID->"b9e173d0-a66b-4dde-a277-221f6e3b4365"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"omega", " ", "=", " ", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"DirectedEdge", " ", "@@@", " ", 
         RowBox[{"EdgeList", "[", "g", "]"}]}], ",", " ", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", " ", 
          RowBox[{"EdgeCount", "[", "g", "]"}]}], "]"}]}], "]"}]}], ",", " ", 
     
     RowBox[{"ball", " ", "=", " ", 
      RowBox[{"InfraBall", "[", 
       RowBox[{
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "3"}], "]"}]}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraIntegral", "[", 
        RowBox[{
         RowBox[{"InfraCodifferential", "[", "omega", "]"}], ",", " ", 
         "ball"}], "]"}], ",", " ", "\"\<Value\>\""}], "]"}], ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraIntegral", "[", 
        RowBox[{"omega", ",", " ", "ball"}], "]"}], ",", 
       " ", "\"\<Flux\>\""}], "]"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"de8b60a1-5397-4fdc-9de9-86a36d242429"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "9"}], ",", 
   RowBox[{"-", "9"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e5350257-ecaa-473f-bcc1-9ba2acae47a1"]
}, Open  ]],

Cell["\<\
The whole graph has no boundary, so the codifferential sums to zero.\
\>", "ExampleText",ExpressionUUID->"520f5745-525a-4cb2-9638-c86a9c0fb9c4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "2", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"omega", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"DirectedEdge", " ", "@@@", " ", 
        RowBox[{"EdgeList", "[", "g", "]"}]}], ",", " ", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", " ", 
         RowBox[{"EdgeCount", "[", "g", "]"}]}], "]"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"Total", " ", "@", " ", 
    RowBox[{"InfraMeasurement", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraCodifferential", "[", "omega", "]"}], ",", 
      " ", "\"\<Function\>\""}], "]"}]}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"81f538b7-9a9d-417e-af00-d690fc8466a1"],

Cell[BoxData["0"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"67f4cc64-e955-4cd2-a998-e0b0feff4377"]
}, Open  ]],

Cell["\<\
The codifferential of a differential is the Laplacian. On a directed acyclic \
graph it is the Laplacian of the undirected Hasse diagram, which an implied \
edge does not change.\
\>", "ExampleText",ExpressionUUID->"0f0d6396-856c-416a-88ae-5653abff13f1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dag", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "6", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "3"}], ",", " ", 
         RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
         RowBox[{"1", " ", "->", " ", "4"}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "5"}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
         RowBox[{"5", " ", "->", " ", "6"}], ",", " ", 
         RowBox[{"1", " ", "->", " ", "6"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"Range", "[", "6", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", 
         RowBox[{"-", "2"}], ",", " ", "7", ",", " ", "1", ",", " ", "3", ",",
          " ", 
         RowBox[{"-", "4"}]}], "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Values", " ", "@", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"dag", ",", " ", 
       RowBox[{"InfraCodifferential", "[", 
        RowBox[{"InfraDifferential", "[", "f", "]"}], "]"}], ",", 
       " ", "\"\<Function\>\""}], "]"}]}], " ", "===", "\n", "    ", 
    RowBox[{
     RowBox[{"KirchhoffMatrix", "[", 
      RowBox[{"UndirectedGraph", " ", "@", " ", 
       RowBox[{"TransitiveReductionGraph", "[", "dag", "]"}]}], "]"}], " ", ".",
      " ", 
     RowBox[{"Values", "[", "f", "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"328c55c5-2f50-4a67-a4f6-13fe47a5a1eb"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"fdfe5462-94db-4851-be44-63d587e954b5"]
}, Open  ]]
}, Open  ]],

