     "415eedff-054d-4945-a72e-7abe1c6694d3"], Cell[
    "undirected graph", "TableText",ExpressionUUID->
     "1616d67f-9196-41ad-9497-d7d0fe4296d0"], Cell[TextData[{
     "every edge at ",
     StyleBox["v", "TI"],
     ", so that ",
     StyleBox["\[Delta]\[Omega](v)", "TI"],
     " is the sum of ",
     StyleBox["\[Omega](u \[RightArrow] v)", "TI"],
     " over the neighbours ",
     StyleBox["u", "TI"]
    }], "TableText",ExpressionUUID->"a84898ac-4c36-47d5-b2eb-e551c24d7df7"]}
  }]], "2ColumnTableMod",ExpressionUUID->"43f17766-723e-4973-81e1-\
96ed911eb5fa"],

