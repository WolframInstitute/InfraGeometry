Cell[TextData[{
 "On the diamond ",
 StyleBox["1 < 2, 3 < 4", "TI"],
 " the bottom only sends and the top only receives:"
}], "ExampleText",ExpressionUUID->"99d6001a-6500-426f-bdcc-4c5399b88e7f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraMeasurement", "[", 
  RowBox[{
   RowBox[{"Graph", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
      RowBox[{"2", " ", "->", " ", "4"}], ",", " ", 
      RowBox[{"3", " ", "->", " ", "4"}]}], "}"}], "]"}], ",", "\n", "  ", 
   RowBox[{"InfraCodifferential", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{
       RowBox[{"DirectedEdge", "[", 
        RowBox[{"1", ",", " ", "2"}], "]"}], " ", "->", " ", "3"}], ",", " ", 
      
      RowBox[{
       RowBox[{"DirectedEdge", "[", 
        RowBox[{"1", ",", " ", "3"}], "]"}], " ", "->", " ", "5"}], ",", " ", 
      
      RowBox[{
       RowBox[{"DirectedEdge", "[", 
        RowBox[{"2", ",", " ", "4"}], "]"}], " ", "->", " ", 
       RowBox[{"-", "1"}]}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"DirectedEdge", "[", 
        RowBox[{"3", ",", " ", "4"}], "]"}], " ", "->", " ", "2"}]}], "|>"}], 
    "]"}], ",", " ", "\"\<Function\>\""}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"17d66ec0-41fb-4351-84eb-ff3963b51591"],

