Cell["A member is connected and is contained in the shell.", "ExampleText",ExpressionUUID->"108399c7-c7b5-4812-8421-5d79e17d12be"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"7", ",", " ", "7"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSphere", "[", 
        RowBox[{"25", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", "All"}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"ConnectedGraphQ", " ", "@", " ", 
        RowBox[{"Subgraph", "[", 
         RowBox[{"g", ",", " ", "#"}], "]"}]}], " ", "&"}], " ", "/@", " ", 
      "members"}], ",", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"members", ",", " ", 
       RowBox[{
        RowBox[{"SubsetQ", "[", 
         RowBox[{
