Cell[CellGroupData[{
Cell["InfraSphere", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3b770911-f3c6-474d-b5a2-f86ab617aceb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb7cbdb2-d27c-4e1e-8dd8-589a6f04111b"],
 "\[LineSeparator]",
 "is the sphere about ",
 StyleBox["c", "TI"],
 ": the family of inclusion-minimal connected subsets of the shell ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a2b17b3e-d0b2-41ef-96dd-ef4c67bfdd86"],
 "[",
 StyleBox["c", "TI"],
 ", {",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["s", "TI"],
 "}] that separate the side of ",
 StyleBox["c", "TI"],
 " from the far side. It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7df1aab2-161a-4e78-8178-d693bde4112c"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3aeeccba-83ed-4eda-921e-49dfc70c3044"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4d875eb2-633d-4537-8352-3fe7a13b5944"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a587643f-5f22-425f-8155-6ef727c0e11d"],
 "\[LineSeparator]",
 "is the band {",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["r", "TI"],
 "}."
}], "Usage",ExpressionUUID->"da9fefea-7a78-4697-b4a3-5b16180cdf44"],

Cell[TextData[{
 "Definition: a sphere of the shell ",
 StyleBox["S", "TI"],
 " is a subset ",
 StyleBox["T \[SubsetEqual] S", "TI"],
 " such that the induced subgraph on ",
 StyleBox["T", "TI"],
 " is connected, deleting ",
 StyleBox["T", "TI"],
 " leaves the component of ",
 StyleBox["c", "TI"],
 " within the mean radius and every other vertex beyond it, and no proper \
subset of ",
 StyleBox["T", "TI"],
 " does."
}], "Notes",ExpressionUUID->"ff41315f-f2d6-431c-a02b-49828309e98b"],

Cell[TextData[{
 "The family may be empty. On a bipartite graph, such as the square grid and \
the hexagonal tiling, no two vertices at the same distance from ",
 StyleBox["c", "TI"],
 " are adjacent, so a shell of one radius has no connected subset of more \
than one vertex and carries no sphere. A band of two radii carries spheres on \
the square grid. When the shell wraps around, as on a torus, and does not \
separate, the family is empty as well."
}], "Notes",ExpressionUUID->"deb7d864-0519-4206-9891-60b4cc878120"],

Cell[TextData[{
 "The family may have many members. The shell is a set of points; the sphere \
is the family of its connected separating subsets, and it is searched, not \
read off a graph: no polynomial-size faithful graph of the family is known. \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "011dbd98-3b64-4f84-b1eb-ae075a0004a3"],
 " is the search."
}], "Notes",ExpressionUUID->"fe0b7dc0-312a-440b-849a-548010926859"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6ae6b738-859e-4d5f-a1dc-51888a64122a"],
 " reads the family through the exhaustive search, so it is expensive. ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e23de836-a3e8-4f84-8ae0-932cea6848a7"],
 " is the sum of the indicators of the members, ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12a102b8-9524-415e-a771-6be5c3b40a70"],
 " the sum of their induced edge sets, ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a1363e1-9ad1-471a-8827-bcfbfb8efd6b"],
 " their number. The two measures are read on the support of the density, the \
union of the members:"
}], "Notes",ExpressionUUID->"15375a54-19c9-47b0-ad4e-3109ef451f92"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2665c0e2-a70a-47f1-abe9-d2c61d2e0bf9"], Cell["Measure", "TableText",
     FontWeight->Bold,ExpressionUUID->"c17de8d7-bb57-4876-be94-ab25ae64febf"],
