Cell[CellGroupData[{
Cell["InfraSphere", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ac481b3e-b144-40cf-93e1-10167f83161c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9245a3da-d923-4bdb-881f-ffd7e123e79d"],
 "\[LineSeparator]",
 "is the sphere of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 ": the family of minimal connected subsets of the shell of radius ",
 StyleBox["r", "TI"],
 " that separate ",
 StyleBox["c", "TI"],
 " from the far side.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"bcd2ecc1-e9c2-4d59-9831-78c84d0b45f3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "451035d1-820b-42db-8bf0-8ba60ae22c3a"],
 "\[LineSeparator]",
 "is the sphere in the band of radii ",
 StyleBox["r", "TI"],
 " to ",
 StyleBox["s", "TI"],
 "."
}], "Usage",ExpressionUUID->"ed60384e-6b95-45fe-8a12-b9a601e0b0d1"],

Cell[TextData[{
 "A member is a set ",
 StyleBox["T", "TI"],
 " of vertices with ",
 StyleBox["r \[LessEqual] d(c, v) \[LessEqual] s", "TI"],
 " such that"
}], "Notes",ExpressionUUID->"b549fea5-820d-46f4-b967-2c00a8da0e92"],

Cell[TextData[{
 StyleBox["T", "TI"],
 " is connected,"
}], "Notes",ExpressionUUID->"c84e6503-7f97-4087-a447-1fcea3dc7739"],

Cell[TextData[{
 "deleting ",
 StyleBox["T", "TI"],
 " leaves the component of ",
 StyleBox["c", "TI"],
 " within distance ",
 StyleBox["(r + s)/2", "TI"],
 " of ",
 StyleBox["c", "TI"],
 " and every other vertex beyond it,"
}], "Notes",ExpressionUUID->"0aa9dcec-cc04-4a31-8f3e-48b65fa541f6"],

Cell[TextData[{
 "no proper subset of ",
 StyleBox["T", "TI"],
 " has both properties."
}], "Notes",ExpressionUUID->"2a71dcaa-d1e2-4882-bae9-c25c0329ac8b"],

Cell["\<\
The shell is a set of points; the sphere is a family of connected surfaces in \
it. It can be empty or have many members.\
\>", "Notes",ExpressionUUID->"f8ec0444-37e3-4760-8363-41fd4097ba1c"],

Cell[TextData[{
 "On a bipartite graph, such as the square grid, no two vertices at the same \
distance from ",
 StyleBox["c", "TI"],
 " are adjacent. A shell of one radius then has no connected subset of more \
than one vertex, and the sphere of one radius is empty. A band of two radii \
carries spheres. On the square mesh the shell is a connected ring and is its \
own sphere."
}], "Notes",ExpressionUUID->"39d3492c-8af3-4491-a22e-be539111c9c7"],

