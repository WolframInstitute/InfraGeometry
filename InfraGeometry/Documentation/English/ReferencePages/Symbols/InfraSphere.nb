Cell["\<\
On the mesh the shell of radius 3 is a member, while the whole band {1, 2} \
separates but is not minimal:\
\>", "ExampleText",ExpressionUUID->"a29cffe9-a895-4e58-9a5e-e5952dde6594"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"InfraMemberQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSphere", "[", 
        RowBox[{"c", ",", " ", "#"}], "]"}], ",", " ", 
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", "#"}], "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}], " ", "&"}], " ", "/@",
     " ", 
    RowBox[{"{", 
     RowBox[{"3", ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"74661c31-98cc-4917-af3d-9d177460bf98"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0787ed7e-928c-4013-87c0-1893b52404b7"]
}, Open  ]]
}, Open  ]],

