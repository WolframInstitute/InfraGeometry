     "the number of vertices of the support all of whose neighbours lie in \
it; ",
     Cell[BoxData["0"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "913e548f-4e05-4a37-b1d9-30d92f8eab1c"],
     " for a sphere of one radius ",
     StyleBox["r \[GreaterEqual] 1", "TI"],
     ", since every vertex of it has a neighbour at distance ",
     StyleBox["r \[Minus] 1", "TI"]
    }], "TableText",ExpressionUUID->"71b96a6b-89c8-440d-8afa-6f35c537d54e"]}
  }]], "2ColumnTableMod",ExpressionUUID->"ecdcdb27-58ff-4437-be74-\
0c0e7991aa42"],

