   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"RandomInfraRepresentative", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSphere", "[", 
             RowBox[{"c", ",", " ", 
              RowBox[{"{", 
               RowBox[{"r", ",", " ", 
                RowBox[{"r", " ", "+", " ", "1"}]}], "}"}]}], "]"}]}], "]"}], 
          "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}], ",", 
       "\n", "    ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"c", ",", " ", 
             RowBox[{"{", 
              RowBox[{"r", ",", " ", 
               RowBox[{"r", " ", "+", " ", "1"}]}], "}"}]}], "]"}], ",", 
           " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
         RowBox[{"{", 
