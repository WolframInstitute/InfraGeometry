Cell[CellGroupData[{
Cell["InfraSphere", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1cc6e69f-c73c-4050-b507-2089ffd6cc70"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb6cbb5b-9f87-4152-9115-8a26d6873da8"],
 "\[LineSeparator]",
 "is the sphere of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 ": the family of the walls about ",
 StyleBox["c", "TI"],
 " in the shell of radius ",
 StyleBox["r", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ad587b7e-f4d9-4740-8d71-d00511dc5837"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ecbdb8a-89d1-47ce-9be3-7ebd4a1e7e45"],
 "\[LineSeparator]",
 "is the sphere in the band of radii ",
 StyleBox["r", "TI"],
 " to ",
 StyleBox["s", "TI"],
 "."
}], "Usage",ExpressionUUID->"e304ac2b-a958-4c25-abfa-6d5883007dde"],

Cell[TextData[{
 "In the band ",
 StyleBox["B = {v \[NotEqual] c : r \[LessEqual] d(c, v) \[LessEqual] s}", 
  "TI"],
 " a wall is a set ",
 StyleBox["W \[SubsetEqual] B", "TI"],
 " that separates ",
 StyleBox["c", "TI"],
 " from the vertices beyond ",
 StyleBox["s", "TI"],
 ", induces a connected subgraph, and has no proper subset that does both. \
The members of the sphere are its walls."
}], "Notes",ExpressionUUID->"7ae00073-3bdb-4496-a55c-a4b6a82a4bac"],

Cell[TextData[{
 StyleBox["W", "TI"],
 " separates when every path from ",
 StyleBox["c", "TI"],
 " to a vertex ",
 StyleBox["v", "TI"],
 " with ",
 StyleBox["d(c, v) > s", "TI"],
 " meets ",
 StyleBox["W", "TI"],
 ". A connected separating set is a wall exactly when no single vertex can be \
removed from it with both properties kept."
}], "Notes",ExpressionUUID->"80251f50-0e96-43fe-9037-b71e91a50bef"],

Cell["\<\
The shell is a set of points; the sphere is a family of connected surfaces in \
it. It can be empty or have many members.\
\>", "Notes",ExpressionUUID->"ed504a78-f89d-435a-ab40-f7db24a467c5"],

Cell[TextData[{
 "A wall need not be a minimal separator. On the square grid, which is \
bipartite, no two vertices at one distance from ",
 StyleBox["c", "TI"],
 " are adjacent, no minimal separator about ",
 StyleBox["c", "TI"],
 " is connected, and the sphere of one radius is empty; in a band of two \
radii a wall is a closed zigzag between the two shells. On the square mesh \
the minimal separators are connected, and the walls are the minimal \
separators."
}], "Notes",ExpressionUUID->"8abb8475-6cf3-498a-b418-e149007265d4"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ffa91624-3a21-4cf1-9ddb-c6d44d6bd136"],
 " is a symbolic object. Its members are found by search, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1bb9714a-d9a8-43c7-9ad2-a40c8a7f0c3f"],
 " searches all of them. The family grows fast with the width of the band: on \
the Small grid the band {1, 2} about the centre has 4 members and the band \
{1, 3} has 128."
}], "Notes",ExpressionUUID->"38e8d0be-c121-4576-b21a-e6ded32dc266"],

