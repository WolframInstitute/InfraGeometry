  FontSize->0.9 Inherited,ExpressionUUID->
  "cf166af0-0a22-45a5-a55c-8a2c9ec09951"],
 " stays unevaluated. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "19150b55-5061-42db-988e-b1529fbec307"],
 " draws members by a random greedy search, one by default, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
