      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "All"}], "]"}], " ", "===",
     " ", 
    RowBox[{"RandomInfraSphere", "[", 
     RowBox[{"g", ",", " ", "c", ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "All", ",", " ", 
      RowBox[{"Properties", " ", "->", " ", 
       RowBox[{"{", "\"\<Separating\>\"", "}"}]}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"9c64012f-24da-4e57-943c-5594bf802180"],

Cell[BoxData["True"], "Output",
