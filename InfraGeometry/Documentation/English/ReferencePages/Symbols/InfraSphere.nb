   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1e7bcfbe-e2c3-4a81-a3b2-f6ec637f9a3d"],
 " tests a vertex set without the search."
}], "Notes",ExpressionUUID->"a4689260-5536-49fc-bee3-a252108291f3"]
}, Open  ]],

