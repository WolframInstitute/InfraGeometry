Cell["\<\
Measuring the family of the 5 by 5 grid: four members, eight vertices in \
their union, none of them inside.\
\>", "ExampleText",ExpressionUUID->"056da56b-3bf9-4489-9139-31f721c402fa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraMeasurement", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
   RowBox[{"InfraSphere", "[", 
    RowBox[{"13", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Cardinality\>\"", ",", " ", "\"\<Faithful\>\"", ",", 
     " ", "\"\<CountingMeasure\>\"", ",", " ", "\"\<RiemannianMeasure\>\""}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"df7f3446-7a97-4728-84f1-e394f277b516"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Cardinality\"\>", "\[Rule]", "4"}], ",", 
   RowBox[{"\<\"Faithful\"\>", "\[Rule]", "Undetermined"}], ",", 
   RowBox[{"\<\"CountingMeasure\"\>", "\[Rule]", "8"}], ",", 
   RowBox[{"\<\"RiemannianMeasure\"\>", "\[Rule]", "0"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c812c721-df1a-42ad-ac9f-d37488931c51"]
}, Open  ]],

Cell["A member is connected and is contained in the shell.", "ExampleText",ExpressionUUID->"b09ce71c-79b7-4904-b045-3da8d0730162"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"7", ",", " ", "7"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSphere", "[", 
        RowBox[{"25", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", "All"}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"ConnectedGraphQ", " ", "@", " ", 
        RowBox[{"Subgraph", "[", 
         RowBox[{"g", ",", " ", "#"}], "]"}]}], " ", "&"}], " ", "/@", " ", 
      "members"}], ",", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"members", ",", " ", 
       RowBox[{
        RowBox[{"SubsetQ", "[", 
         RowBox[{
          RowBox[{"FindInfraShell", "[", 
           RowBox[{"g", ",", " ", "25", ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", "#"}], 
         "]"}], " ", "&"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e81f3be2-c219-4420-a367-b7bd49af454e"],

