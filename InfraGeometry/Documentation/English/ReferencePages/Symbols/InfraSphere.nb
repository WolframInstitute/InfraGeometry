Cell["\<\
On the grid the band {1, 2} has 16 minimal separators, none connected, so the \
sphere has no member:\
\>", "ExampleText",ExpressionUUID->"e903fb4a-89e6-4922-b5fd-d93eec246e95"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSphere", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", 
       " ", "\"\<Cardinality\>\""}], "]"}], ",", "\n", "   ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"RandomInfraSphere", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "All", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", "\"\<Separating\>\"", "}"}]}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a86388bf-210b-491e-83a2-8a6cacef5b64"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "16"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b7ad768b-4e3b-43b8-992e-7c0c1d58e812"]
}, Open  ]]
}, Open  ]],

