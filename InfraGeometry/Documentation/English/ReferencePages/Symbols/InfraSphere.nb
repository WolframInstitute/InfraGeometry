   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b87bf023-e2c5-402d-bb73-013ca4b1538a"],
 "\[LineSeparator]",
 "is the sphere in the band of radii ",
 StyleBox["r", "TI"],
 " to ",
 StyleBox["s", "TI"],
 "."
}], "Usage",ExpressionUUID->"e693ca56-5dab-4414-8544-59b685cb999a"],

Cell[TextData[{
 "A member is a set ",
 StyleBox["S \[SubsetEqual] L = {v \[NotEqual] c : r \[LessEqual] d(c, v) \
\[LessEqual] s}", "TI"],
 " such that"
}], "Notes",ExpressionUUID->"45e20f99-6321-4e36-ad4f-2349dd5889ae"],

Cell[TextData[{
 "every path from ",
 StyleBox["c", "TI"],
 " to a vertex ",
 StyleBox["v", "TI"],
 " with ",
 StyleBox["d(c, v) > s", "TI"],
 " meets ",
 StyleBox["S", "TI"],
 ","
}], "Notes",ExpressionUUID->"e8de530c-0217-4c8a-8ef4-6c3ba2c2862a"],

Cell[TextData[{
 "no proper subset of ",
 StyleBox["S", "TI"],
 " has this property,"
}], "Notes",ExpressionUUID->"c35c1a53-46c8-4868-94cb-4a227ceb3076"],

Cell[TextData[{
 StyleBox["S", "TI"],
 " is connected."
}], "Notes",ExpressionUUID->"aa3c3e94-4440-4093-b9e1-42979236726d"],

Cell["\<\
The shell is a set of vertices; the sphere is a family of vertex sets in it. \
It can be empty or have many members.\
\>", "Notes",ExpressionUUID->"f52ce71f-2f44-466a-bcb6-5fefa7542d5f"],

Cell[TextData[{
 "On the square mesh a shell of radius 1 to 4 about the centre is a ring and \
the only member of its sphere. On the square grid a minimal separator about \
the centre is not connected, and the sphere is empty; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b69de2a4-63fe-44e1-a789-081e7968d2ac"],
 " with ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "\"\<Separating\>\"", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12415078-3aaf-4026-a0e4-229e4d770880"],
 " gives the minimal separators."
}], "Notes",ExpressionUUID->"911140fc-869a-4f26-880d-edebf376a6bd"],

