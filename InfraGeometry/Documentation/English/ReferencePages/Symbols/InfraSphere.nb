Cell["\<\
Measuring the family of the 5 by 5 grid: four members, eight vertices in \
their union, none of them inside.\
\>", "ExampleText",ExpressionUUID->"d39123fd-83db-4411-b0b8-6c49eef62a8b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InfraMeasurement", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
   RowBox[{"InfraSphere", "[", 
    RowBox[{"13", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Cardinality\>\"", ",", " ", "\"\<Faithful\>\"", ",", 
     " ", "\"\<CountingMeasure\>\"", ",", " ", "\"\<RiemannianMeasure\>\""}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d0cb9e4d-3e72-4c3f-a8f8-1c0f859cc29c"],

