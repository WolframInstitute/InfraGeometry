Cell["\<\
The four minimal connected separators in the band 1 to 2 about the centre of \
a 5 by 5 grid.\
\>", "ExampleText",ExpressionUUID->"8e3d8ba6-88c5-463f-8fb5-0017ae71ecb4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FindInfraRepresentative", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
   RowBox[{"InfraSphere", "[", 
    RowBox[{"13", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", "All"}], 
  "]"}]], "Input",
