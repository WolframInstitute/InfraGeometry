Cell["\<\
The four minimal connected separators in the band 1 to 2 about the centre of \
a 5 by 5 grid, each drawn on its own.\
\>", "ExampleText",ExpressionUUID->"fe68f50d-4ba5-4f8e-a95d-58d6abffb7b1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"RandomInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSphere", "[", 
        RowBox[{"13", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", "All"}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Row", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"#", ",", " ", "13"}], "}"}]}], "]"}], " ", "&"}], " ", "/@",
      " ", "members"}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e837c24b-d566-4174-9c48-f6d4efa90dd7"],

