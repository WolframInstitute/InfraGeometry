Notebook[{

Cell[CellGroupData[{
Cell["InfraSphere", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"23a17876-9f09-4c01-aa4d-e842d73a6389"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d8a2c39-52ac-4bfe-af2e-63e14bc0bafb"],
 "\[LineSeparator]",
 "is the sphere about ",
 StyleBox["c", "TI"],
 ": the family of inclusion-minimal connected subsets of the shell ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c34e5c8d-87ce-438a-a9e9-aeaedeaa1bdd"],
 "[",
 StyleBox["c", "TI"],
 ", {",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["s", "TI"],
 "}] that separate the side of ",
 StyleBox["c", "TI"],
 " from the far side. It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d62810ab-d824-4f7c-8bea-28a8a3947bda"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bdae154f-b3ad-43a8-b561-d25aabab4334"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f1f1fe55-ccf7-4f0e-b087-2cbc937377cb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "646c66ef-cf16-41cf-ae0d-c941a13b5722"],
 "\[LineSeparator]",
 "is the band {",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["r", "TI"],
 "}."
}], "Usage",ExpressionUUID->"b2db26b1-479a-43c5-b6b4-6022836e938c"],

Cell[TextData[{
 "Definition: a sphere of the shell ",
 StyleBox["S", "TI"],
 " is a subset ",
 StyleBox["T \[SubsetEqual] S", "TI"],
 " such that the induced subgraph on ",
 StyleBox["T", "TI"],
 " is connected, deleting ",
 StyleBox["T", "TI"],
 " leaves the component of ",
 StyleBox["c", "TI"],
 " within the mean radius and every other vertex beyond it, and no proper \
subset of ",
 StyleBox["T", "TI"],
 " does."
}], "Notes",ExpressionUUID->"cff9e2af-4121-44ff-a973-e2a9ae14e23b"],

Cell[TextData[{
 "The shell is a set of points. The sphere is the family of its connected \
separating subsets, and it is searched, not read off a graph: no \
polynomial-size faithful graph of the family is known. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fddb4e38-1142-4801-be19-4ec5ca638e90"],
 " is the search."
}], "Notes",ExpressionUUID->"4a09f9f0-7286-45d3-8a87-43f8cacd68a4"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a5b176a4-b947-48ba-8b49-d007e4f34702"],
 " gives members: a count, ",
 Cell[BoxData["\"\<RandomChoice\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d94cf335-4790-46ba-911b-f96a555d2288"],
 " and ",
 Cell[BoxData[
  RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cda9a9d8-3f50-41a0-b036-4b6a5480681f"],
 " are translated to the ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "037f8285-0305-4eed-b105-ce9c6764c546"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ddeceda3-f757-4e54-8188-2d0e4c8be96a"],
 ". Without a count it gives one member, a sorted vertex list."
}], "Notes",ExpressionUUID->"c9b4018a-a78c-4eda-b90e-7009291e52e5"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "09e63fcb-c30c-4869-ae4f-c1730a4e4dc2"],
 " reads the family through the exhaustive search, so it is expensive: ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de129026-0a4f-42d2-8d29-0f2d5be41fcf"],
 " is the sum of the indicators of the members, ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe8d5991-dda8-4578-9327-c61aa3657eba"],
 " the sum of their induced edge sets, ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f9f5ad8-4e77-4039-aa0a-18e1f505e144"],
 " their number, and the two measures the support of the density. ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e178c45b-c6cc-435b-9247-7af8e68e8ea2"],
 " is ",
 Cell[BoxData["Undetermined"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09d4bac2-6e9e-49db-8722-e8feb8689005"],
 ". A sphere has no ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2de36f8a-ddbd-4678-b87d-55ed958f8d4d"],
 "."
}], "Notes",ExpressionUUID->"c6e0a0c3-394f-4e3c-8823-6bf26c1487c6"],

Cell["\<\
When the shell wraps around, as on a torus, and does not separate, the family \
is empty.\
\>", "Notes",ExpressionUUID->"d89156b0-2aee-4022-9fb1-db6178d322b8"]
}, Open  ]],

