Cell["Every member is connected and lies in the band:", "ExampleText",ExpressionUUID->"e24954b8-3463-438c-b5bd-4bb4ce18bf13"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"band", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraShell", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"RandomInfraSphere", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSphere", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", "All"}], 
      "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"ConnectedGraphQ", "[", 
        RowBox[{"Subgraph", "[", 
         RowBox[{"g", ",", " ", "#"}], "]"}], "]"}], " ", "&&", " ", 
       RowBox[{"SubsetQ", "[", 
        RowBox[{"band", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d45cf588-9cfa-4bf5-80fa-b7167110f9b3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"97462d57-f94e-4975-ba87-b532b5601fe1"]
}, Open  ]],

Cell["\<\
On the grid the minimal separators of the band {1, 2} are not connected, and \
none is a member:\
\>", "ExampleText",ExpressionUUID->"ec273abf-a2aa-46c0-9de9-4c0590a8bd41"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"separators", " ", "=", " ", 
     RowBox[{"RandomInfraSphere", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "All", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Separating\>\"", "}"}]}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "separators", "]"}], ",", " ", 
     RowBox[{"Count", "[", 
      RowBox[{"separators", ",", " ", 
       RowBox[{"s_", " ", "/;", " ", 
        RowBox[{"ConnectedGraphQ", "[", 
         RowBox[{"Subgraph", "[", 
          RowBox[{"g", ",", " ", "s"}], "]"}], "]"}]}]}], "]"}], ",", " ", 
     RowBox[{"AnyTrue", "[", 
      RowBox[{"separators", ",", " ", 
       RowBox[{
        RowBox[{"InfraMemberQ", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSphere", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", "#"}], 
         "]"}], " ", "&"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4845ed1e-6061-4878-8389-b2ddcd90e640"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"16", ",", "0", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"5051633a-2439-4e43-b8ae-bbe8148b6a3e"]
}, Open  ]],

Cell["\<\
On the mesh the members of the band {1, 2} are its minimal separators:\
\>", "ExampleText",ExpressionUUID->"47aae83d-b6cc-41f1-8a05-a2c0c8f064a6"],

Cell[CellGroupData[{

Cell[BoxData[
