Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cb09a7be-2e5d-41a9-8b9d-f9df7c69260e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1d95d01-62ce-41d4-bf48-00b69b61c619"],
 "\[LineSeparator]",
 "is the sphere of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 ": the family of connected minimal subsets of the shell of radius ",
 StyleBox["r", "TI"],
 " that separate ",
 StyleBox["c", "TI"],
 " from the vertices beyond it.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8137102c-0d46-499e-b15d-dd329b4ab3a5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
