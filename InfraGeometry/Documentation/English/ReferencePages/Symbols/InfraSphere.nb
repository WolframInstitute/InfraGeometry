Cell["\<\
A sphere of radius 3 about the centre, drawn over its shell. On the grid it \
needs the band of radii 2 and 3; on the mesh it is the whole shell of radius \
3:\
\>", "ExampleText",ExpressionUUID->"dba29331-60ab-4833-a2ca-7dad15522102"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", "spec"}], ",", " ", "\"\<Small\>\"",
           ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{"Last", " ", "@", " ", "spec"}]}], "]"}], ",", " ", 
          RowBox[{"RandomInfraSphere", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSphere", "[", 
             RowBox[{"c", ",", " ", 
              RowBox[{"Last", " ", "@", " ", "spec"}]}], "]"}], ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ",
           "c"}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"spec", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "3"}], "}"}]}], "}"}]}],
      "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1c9dcca3-cedb-4218-9701-e6a28a627219"],

