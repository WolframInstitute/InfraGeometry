Cell["\<\
The shell of radius 3, and the sphere in it, on the discretized plane, the \
square grid and the hexagonal tiling, labelled with the number of members and \
the two measures. The shell of the mesh is a connected ring and is its own \
sphere; the two lattices are bipartite, and the family is empty.\
\>", "ExampleText",ExpressionUUID->"c68792f7-6189-41b1-857c-454c7db4d918"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"family", " ", "=", " ", 
        RowBox[{"InfraSphere", "[", 
         RowBox[{"c", ",", " ", "3"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"InfraShell", "[", 
              RowBox[{"c", ",", " ", "3"}], "]"}], " ", "->", " ", 
             "$InfraShellColor"}], ",", " ", 
            RowBox[{
             RowBox[{"FindInfraRepresentative", "[", 
              RowBox[{"g", ",", " ", "family"}], "]"}], " ", "->", " ", 
             "$InfraCircleColor"}], ",", " ", 
            RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
            "c"}], "}"}]}], "]"}], ",", "\n", "      ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", "family", ",", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Cardinality\>\"", ",", " ", "\"\<CountingMeasure\>\"",
             ",", " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "]"}]}], 
       "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d29b5dbf-a2b2-446e-a820-73d5b7a171b3"],

