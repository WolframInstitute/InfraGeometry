}, Open  ]],

Cell["\<\
The 60 members of the mesh band {1, 2} together cover all 19 vertices of the \
band:\
\>", "ExampleText",ExpressionUUID->"baf11d7d-674d-4b95-ada3-8e12d1bc1aff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"#", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", 
       " ", "\"\<CountingMeasure\>\""}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"InfraSphere", ",", " ", "InfraShell"}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b6250a33-0196-43c0-a03f-0fb2eaeb1bea"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"19", ",", "19"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"c2fa7dc7-862a-48a3-baf5-716aec1b4bfb"]
}, Open  ]]
}, Open  ]],

