Cell["\<\
A sphere of radius 3 about the centre, drawn over its shell. On the grid it \
needs the band of radii 2 and 3; on the mesh it is the whole shell of radius \
3:\
\>", "ExampleText",ExpressionUUID->"187f0f51-761c-4f5a-83a1-3fa1f414f3b8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{
          RowBox[{"First", " ", "@", " ", "spec"}], ",", " ", "\"\<Small\>\"",
           ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{"Last", " ", "@", " ", "spec"}]}], "]"}], ",", " ", 
          RowBox[{"RandomInfraSphere", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraSphere", "[", 
             RowBox[{"c", ",", " ", 
              RowBox[{"Last", " ", "@", " ", "spec"}]}], "]"}], ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ",
           "c"}], "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"spec", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "3"}], "}"}]}], "}"}]}],
      "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"56d27bdb-9d63-4e1b-9885-52fc6a96e685"],

