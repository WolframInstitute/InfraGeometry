Cell["On the mesh the sphere of radius 3 is the shell:", "ExampleText",ExpressionUUID->"6562048e-85df-4f8e-a95a-0e7c8c45e932"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"RandomInfraSphere", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSphere", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], " ", "==", 
    " ", 
    RowBox[{"Keys", " ", "@", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"c", ",", " ", "3"}], "]"}], ",", 
       " ", "\"\<VertexDensity\>\""}], "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"761afbce-9946-4914-a8ed-29b046e68438"],

Cell[BoxData["True"], "Output",
