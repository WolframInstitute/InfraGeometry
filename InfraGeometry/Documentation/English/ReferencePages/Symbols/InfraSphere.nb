Notebook[{

Cell[CellGroupData[{
Cell["InfraSphere", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c089dce1-151e-49c1-a362-721ec91338d6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5152386-6fcf-49d6-b036-880bcb1da88d"],
 "\[LineSeparator]",
 "is the sphere about ",
 StyleBox["c", "TI"],
 ": the family of inclusion-minimal connected subsets of the shell ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "be4a9ab9-1d2e-4de5-bd4d-6243b5ab48aa"],
 "[",
 StyleBox["c", "TI"],
 ", {",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["s", "TI"],
 "}] that separate the side of ",
 StyleBox["c", "TI"],
 " from the far side. It is a symbolic object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b74afd6f-6356-4da5-90d4-536104624971"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "440a7ebc-5833-4e99-a568-11cc84beeb9f"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4c89eee6-24b5-412f-b62f-f6ede3820b68"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15bde901-eb1d-439c-8cc6-c5a2a20e5d2a"],
 "\[LineSeparator]",
 "is the band {",
 StyleBox["r", "TI"],
 ", ",
 StyleBox["r", "TI"],
 "}."
}], "Usage",ExpressionUUID->"106cd21c-5bba-4b00-bdc0-6ed63673b28d"],

Cell[TextData[{
 "Definition: a sphere of the shell ",
 StyleBox["S", "TI"],
 " is a subset ",
 StyleBox["T \[SubsetEqual] S", "TI"],
 " such that the induced subgraph on ",
 StyleBox["T", "TI"],
 " is connected, deleting ",
 StyleBox["T", "TI"],
 " leaves the component of ",
 StyleBox["c", "TI"],
 " within the mean radius and every other vertex beyond it, and no proper \
subset of ",
 StyleBox["T", "TI"],
 " does."
}], "Notes",ExpressionUUID->"a2e75a0e-f0b9-4221-a002-715b0e890bb2"],

Cell[TextData[{
 "The family may be empty. On a bipartite graph, such as the square grid and \
the hexagonal tiling, no two vertices at the same distance from ",
 StyleBox["c", "TI"],
 " are adjacent, so a shell of one radius has no connected subset of more \
than one vertex and carries no sphere. A band of two radii carries spheres on \
the square grid. When the shell wraps around, as on a torus, and does not \
separate, the family is empty as well."
}], "Notes",ExpressionUUID->"55ca18c5-2082-47d9-bb20-3b9d1bf40c0d"],

Cell[TextData[{
 "The family may have many members. The shell is a set of points; the sphere \
is the family of its connected separating subsets, and it is searched, not \
read off a graph: no polynomial-size faithful graph of the family is known. \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "19dbd770-50d8-4057-8607-2a6ffd22d786"],
 " is the search."
}], "Notes",ExpressionUUID->"89b5d478-0768-4765-b8b3-0aaf1aaf9fbc"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d38f10c5-f790-4c02-a09e-14746dd2f204"],
 " reads the family through the exhaustive search, so it is expensive. ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7689ccf1-8029-4c9c-b71c-a888c97d397f"],
 " is the sum of the indicators of the members, ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53716847-cb8d-40f3-b7af-7cf030455250"],
 " the sum of their induced edge sets, ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bda293e-2862-4063-98fb-0d75fc67211d"],
 " their number. The two measures are read on the support of the density, the \
union of the members:"
}], "Notes",ExpressionUUID->"474f4a63-4299-4195-8c63-681987d45a93"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "428bd5b2-367b-4db6-81a6-d77e3f72f492"], Cell["Measure", "TableText",
     FontWeight->Bold,ExpressionUUID->"d7484dd5-ef01-4c19-8174-e392e4f3606e"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"f62d9590-474e-42d4-acf3-c3a7715a98e4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3562d2ca-cd4b-45c5-a777-265afda8cd25"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "fd8d5166-15e9-48cd-8048-c1a72df71eff"]], "TableText",ExpressionUUID->
     "1a890406-8b6a-4469-aefa-2a2eff6c33e5"], Cell[
    "the number of vertices in some member", "TableText",ExpressionUUID->
     "f031f2f3-0678-4391-8d9a-3c745c3e9e8b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "572993c0-b6b4-483e-b31e-7ea00dbf8ee7"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "052d98bd-14e1-4ce2-9390-b18aa44a5584"]], "TableText",ExpressionUUID->
     "196ca24a-d63c-4cff-8283-6d4a8e56834a"], Cell[TextData[{
     "the number of vertices of the support all of whose neighbours lie in \
it; ",
     Cell[BoxData["0"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a90e42bc-7d53-4d49-9238-20a7863ebb52"],
     " for a sphere of one radius ",
     StyleBox["r \[GreaterEqual] 1", "TI"],
     ", since every vertex of it has a neighbour at distance ",
     StyleBox["r \[Minus] 1", "TI"]
    }], "TableText",ExpressionUUID->"bcf7d797-8b01-4ce5-b783-a8d67f94e6f6"]}
  }]], "2ColumnTableMod",ExpressionUUID->"3d85be6e-7237-42c9-be16-\
561a34daedad"],

Cell[TextData[{
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d475673-2f8c-40b2-8292-c7f0d24dbd2a"],
 " is ",
 Cell[BoxData["Undetermined"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "363553b3-8d8c-43ad-95c9-e5c600235f92"],
 ". A sphere has no ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f94fbc50-4acd-408b-b255-62c8dd682ea9"],
 "."
}], "Notes",ExpressionUUID->"6caa75c6-3172-46d5-a7c3-5f411c648641"],

Cell[TextData[{
 "The Riemannian measure of a sphere instance in a band ",
 StyleBox["{r, r + 1}", "TI"],
 ", ",
 StyleBox["r \[GreaterEqual] 1", "TI"],
 ", is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41ac1132-eccc-446c-a94d-50f3923ccb05"],
 " too, whenever every vertex at distance ",
 StyleBox["r + 1", "TI"],
 " has a neighbour at distance ",
 StyleBox["r + 2", "TI"],
 ": each vertex of the instance then has a neighbour outside the band."
}], "Notes",ExpressionUUID->"70b041d1-076d-485a-ad91-ed6df73e18f0"],

Cell[TextData[{
 "No count is known. The family has no closed formula for its number of \
members, and one instance none for its size: the size of one instance bounds \
the size of no other. The reference is the shell it lies in, whose count ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "babcb108-8c8c-4f0d-b452-6acd1859fde7"],
 " gives on a lattice. In the continuum a sphere instance stands for the \
geodesic sphere, of area ",
 StyleBox["n \[Omega]_n r^(n\[Minus]1) (1 \[Minus] Scal(c) r\.b2 / (6n) + O(r\
\:2074))", "TI"],
 "."
}], "Notes",ExpressionUUID->"0d475753-9315-4651-8ea6-e381b2593fc2"],

Cell[TextData[{
 "How the number is measured: one instance ",
 StyleBox["T", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSphere", "[", 
     RowBox[{
      StyleBox["c", "TI"], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["r", "TI"], ",", " ", 
        RowBox[{
         StyleBox["r", "TI"], " ", "+", " ", "1"}]}], "}"}]}], "]"}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b994de1-3dc0-428d-a440-cec874b3cece"],
 ", found greedily, is a vertex list, and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraTube", "[", 
     RowBox[{"T", ",", " ", "0"}], "]"}], ",", " ", 
    StyleBox["measure", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20fc9f45-3aec-43a0-9ec4-3a95a2e0275b"],
 " measures it as a region. The profile is the list of the instance sizes \
over ",
 StyleBox["r", "TI"],
 ", a profile of instances, not of the family."
}], "Notes",ExpressionUUID->"842d42e2-807e-481a-a2f6-cee25689af66"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6d867ad4-e103-45cb-ae3f-9aa7cadafa37"],
 " gives members: the count and ",
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b54f9548-d714-499f-9986-d19644d60b7e"],
 " are passed to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ca36cad0-6cb4-417b-ba5e-4280d5b72962"],
 ". Without a count it gives one member, a sorted vertex list."
}], "Notes",ExpressionUUID->"58f3af68-5aa0-46f5-b12f-8bd7120d85b8"]
}, Open  ]],

