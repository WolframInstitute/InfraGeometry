Cell[TextData[{
 "The cylinder of radius 0 is the axis, and its Riemannian measure is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2fa335f-b42c-4ede-9b17-d88808f9795b"],
 ": a path in a grid is all boundary."
}], "Notes",ExpressionUUID->"24bab038-2425-4fed-beab-406cfe3e82a0"],

Cell[TextData[{
 "The head computes nothing. A cylinder has one member, the vertex set. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c6945853-3558-4721-bc33-695da08b2862"],
 " also reads ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4d00ac6-b3b5-4a3e-b028-e5cfc8e579ba"],
 ", ",
 Cell[BoxData["\"\<EdgeDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e9e63d8-0712-4302-8790-405e04130a78"],
 ", ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c061fac-59e4-4604-a5d7-129270f593c8"],
 ", ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9930d989-3e92-4201-bdcf-0d743962fd55"],
 " and ",
 Cell[BoxData["\"\<Subgraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88742a71-5ec7-46b8-9d57-a8a59bdc8b2d"],
 "."
}], "Notes",ExpressionUUID->"d57e212c-3954-4153-9658-58fe7bd0b7d7"]
