Cell["\<\
The rounded cylinder is the tube about the axis, and the cylinder lies in it.\
\
\>", "ExampleText",ExpressionUUID->"069e487c-54ce-4b60-af8b-23bd24ab542c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "39", ",", " ", "40", ",", " ", "41", ",", " ", "42", ",", " ", "43"}], 
      "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"tube", " ", "=", " ", 
     RowBox[{"RandomInfraTube", "[", " ", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraTube", "[", 
        RowBox[{"axis", ",", " ", "2"}], "]"}]}], " ", "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"RandomInfraCylinder", "[", " ", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCylinder", "[", 
         RowBox[{"axis", ",", " ", "2", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<Balls\>\""}]}], "]"}]}], " ",
        "]"}], " ", "===", " ", "tube"}], ",", "\n", "   ", 
     RowBox[{"SubsetQ", "[", 
      RowBox[{"tube", ",", " ", 
       RowBox[{"RandomInfraCylinder", "[", " ", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCylinder", "[", 
          RowBox[{"axis", ",", " ", "2"}], "]"}]}], " ", "]"}]}], "]"}]}], 
    "}"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0abe1884-acac-40a3-a9ca-20a8f017bea0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"0dd2dd14-a202-41be-87a0-f2847fb80da7"]
}, Open  ]],

Cell["\<\
The cylinder is the solid of revolution of the constant profile.\
\>", "ExampleText",ExpressionUUID->"c3d079e9-cefe-4257-a0de-2ac6af4f1f7c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "39", ",", " ", "40", ",", " ", "41", ",", " ", "42", ",", " ", "43"}], 
      "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"RandomInfraCylinder", "[", " ", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraCylinder", "[", 
       RowBox[{"axis", ",", " ", "2"}], "]"}]}], " ", "]"}], " ", "===", " ", 
    
    RowBox[{"RandomInfraSolidOfRevolution", "[", " ", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraSolidOfRevolution", "[", 
       RowBox[{"axis", ",", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"2", ",", " ", "5"}], "]"}]}], "]"}]}], " ", "]"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"4a81500c-0d09-42c1-806d-d7ab182ce65f"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"8fb8b2ca-df1f-4070-b556-785a56945ed5"]
}, Open  ]]
