f19762596c99"],

Cell[TextData[{
 "The cylinder of radius 0 is the axis, and its Riemannian measure is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e76d92f-a8d7-4b88-9724-759c7326b12f"],
 ": a path in a grid is all boundary."
}], "Notes",ExpressionUUID->"c9ba79b6-ce3b-4e00-97b9-0b3483bb7cf4"],

Cell[TextData[{
 "The head computes nothing. A cylinder has one member, the vertex set. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
