Cell["\<\
The cylinder of radius 1 about a shortest path on the discretized plane, the \
square grid and the hexagonal tiling. The Riemannian measure counts the inner \
vertices, in green; the counting measure adds the boundary, in blue.\
\>", "ExampleText",ExpressionUUID->"f4512285-13c6-4f60-a1d4-60082e1d9343"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"axis", " ", "=", " ", 
        RowBox[{"RandomInfraSegment", "[", " ", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
              RowBox[{"RandomInfraPoint", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"InfraShell", "[", 
                 RowBox[{"c", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], 
           "]"}]}], " ", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"cylinder", " ", "=", " ", 
        RowBox[{"InfraCylinder", "[", 
         RowBox[{"axis", ",", " ", "1"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"support", " ", "=", " ", 
        RowBox[{"Replace", "[", " ", 
         RowBox[{"cylinder", ",", " ", 
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"token_InfraPoint", " ", ":>", " ", 
             RowBox[{"RandomInfraPoint", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraSegment", " ", ":>", " ", 
             RowBox[{"RandomInfraSegment", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraHalfLine", " ", ":>", " ", 
             RowBox[{"RandomInfraHalfLine", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraInfiniteLine", " ", ":>", " ", 
             RowBox[{"RandomInfraInfiniteLine", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraCircle", " ", ":>", " ", 
             RowBox[{"RandomInfraCircle", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraArc", " ", ":>", " ", 
             RowBox[{"RandomInfraArc", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraRegularPolygon", " ", ":>", " ", 
             RowBox[{"RandomInfraRegularPolygon", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraPlane", " ", ":>", " ", 
             RowBox[{"RandomInfraPlane", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
            RowBox[{"token_InfraBall", " ", ":>", " ", 
             RowBox[{"RandomInfraBall", "[", " ", 
              RowBox[{"g", ",", " ", "token"}], " ", "]"}]}], ",", " ", 
