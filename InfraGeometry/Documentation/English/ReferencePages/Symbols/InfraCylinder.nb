Notebook[{

Cell[CellGroupData[{
Cell["InfraCylinder", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2c4ed4dd-0617-4fdb-bad4-7b266e95a775"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCylinder"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc2be2c1-3d9b-4f26-9f6f-55abc1c8062b"],
 "\[LineSeparator]",
 "is the cylinder of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["axis", "TI"],
 ": the vertices within ",
 StyleBox["r", "TI"],
 " of the axis vertex they project to, with flat ends. It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9fca9528-db53-4bc3-bd45-98bdfee7724d"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1d819905-596f-4c70-9ed5-814c0f964b6b"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"14d2037b-f554-422e-a449-bbf804bfa7bc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCylinder"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d75eb75d-e5e8-4905-b5de-8768d7c51cdb"],
 "\[LineSeparator]",
 "is the mantle: the vertices at distance between ",
 StyleBox["r", "TI"],
 " and ",
 StyleBox["s", "TI"],
 " from their axis vertex.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a1f4dde0-1ec6-4262-afd6-725d32eebd53"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCylinder"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1eece3be-4132-4a79-aa51-928a530753f1"],
 "\[LineSeparator]",
 "is the rounded cylinder, the union of the balls of radius ",
 StyleBox["r", "TI"],
 " about the axis vertices."
}], "Usage",ExpressionUUID->"99a7ab82-105c-4931-b1a9-7020c234e0b4"],

Cell[TextData[{
 "Definition: the cylinder of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["axis", "TI"],
 " is the sliced tube ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Sliced\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd4c0006-15fe-4bbb-814d-825aeb547ba1"],
 ". Slice ",
 StyleBox["i", "TI"],
 " is the set of vertices whose nearest axis vertex is ",
 StyleBox["a_i", "TI"],
 ", a tie lying in every nearest slice, and ",
 StyleBox["v", "TI"],
 " is in the cylinder when ",
 StyleBox["d(a_i, v) \[LessEqual] r", "TI"],
 " for its slice."
}], "Notes",ExpressionUUID->"eab8ac54-b1e7-4901-b544-81bb9ea8bdd2"],

Cell[TextData[{
 "The axis is a walk: a vertex, a vertex list, or a path or cycle graph. A \
density or a Euclidean head such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "749e58da-881f-422a-85ea-2a831723b602"],
 " leaves the call unevaluated; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19025890-98b4-4c86-b524-e5e2b50c0c36"],
 " gives the axis of one shortest path."
}], "Notes",ExpressionUUID->"b3bc3652-e963-4d23-ba7b-103e30e36eaf"],

Cell["\<\
The axis is prolonged straight on past both ends, through the neighbours of \
an end vertex that continue the line, and the vertices nearer a prolongation \
than the axis are cut. So the ends are flat, which is what makes a cylinder \
and not a tube. A closed axis has no ends.\
\>", "Notes",ExpressionUUID->"b6684ee2-dbfd-47f8-876b-858da100f6f7"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07d040c9-4958-44e0-9aa4-0c2329d9ddbb"],
 " reads the same profile as the union of the balls, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18b935ae-96b9-47b6-9c96-10153335306e"],
 ", rounded at both ends."
}], "Notes",ExpressionUUID->"b4f450ca-3980-46e7-927a-cd96601773ff"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
