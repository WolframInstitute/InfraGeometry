Cell["The cylinder is the tube about the axis.", "ExampleText",ExpressionUUID->"862a858d-6f50-4424-a5dc-547b3f2e449a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
           RowBox[{"RandomInfraPoint", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "4"}], "]"}]}], ")"}]}], 
        "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"FindInfraRepresentative", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraCylinder", "[", 
       RowBox[{"axis", ",", " ", "2"}], "]"}]}], "]"}], " ", "===", " ", 
    RowBox[{"FindInfraRepresentative", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraTube", "[", 
       RowBox[{"axis", ",", " ", "2"}], "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d12724bd-f62b-46f7-9b62-543c90219690"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2f06e963-b5a7-485a-b5ea-3fe05ee281d8"]
}, Open  ]],

Cell[TextData[{
 "The cylinder is the solid of revolution of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRevolution"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRevolution", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1c836051-0df0-45b5-8661-15ced38d6e78"],
 " for the constant profile."
}], "ExampleText",ExpressionUUID->"e41a76e9-27cc-4d44-b48a-7bca64836168"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
           RowBox[{"RandomInfraPoint", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "4"}], "]"}]}], ")"}]}], 
        "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"FindInfraRepresentative", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraCylinder", "[", 
       RowBox[{"axis", ",", " ", "1"}], "]"}]}], "]"}], " ", "===", " ", 
    RowBox[{"FindInfraRevolution", "[", 
     RowBox[{"g", ",", " ", "axis", ",", " ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"1", ",", " ", 
        RowBox[{"Length", " ", "@", " ", "axis"}]}], "]"}], ",", " ", 
      RowBox[{"Method", " ", "->", " ", "\"\<Balls\>\""}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"77a4806d-48ea-47d4-86dc-0d71830fc291"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"54cd3966-ad57-4183-a5bf-8715cf4a0aff"]
