Cell[CellGroupData[{
Cell["InfraCylinder", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"edcdb6ea-5fe7-4eb5-b665-236760951724"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCylinder"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f1b8cf28-0e87-4984-b37e-b29cef5d3e3c"],
 "\[LineSeparator]",
 "is the cylinder of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["axis", "TI"],
 ": the vertices within ",
 StyleBox["r", "TI"],
 " of the axis vertex they project to, with flat ends. It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c90d06ff-82f3-4feb-994e-b3bc9199205b"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7c66c55a-5b9c-4ad4-966e-1232c40dd609"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e95f2088-fef1-4b36-a365-92c0f5ab9eff"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCylinder"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f2c01b7-7640-46ad-9732-3284ba6d0cc8"],
 "\[LineSeparator]",
 "is the mantle: the vertices at distance between ",
 StyleBox["r", "TI"],
 " and ",
 StyleBox["s", "TI"],
 " from their axis vertex.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"cabcb1f7-eb8c-479f-bcf9-027e46423b74"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCylinder"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8fc53184-0232-4e83-b9ac-6e662290f6f1"],
 "\[LineSeparator]",
 "is the rounded cylinder, the union of the balls of radius ",
 StyleBox["r", "TI"],
 " about the axis vertices."
}], "Usage",ExpressionUUID->"5b6294bc-6c73-49c7-b355-9130287d878d"],

Cell[TextData[{
 "Definition: the cylinder of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["axis", "TI"],
 " is the sliced tube ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Sliced\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1362df0e-12d8-4932-bb13-69e9af5f59a0"],
 ". Slice ",
 StyleBox["i", "TI"],
 " is the set of vertices whose nearest axis vertex is ",
 StyleBox["a_i", "TI"],
 ", a tie lying in every nearest slice, and ",
 StyleBox["v", "TI"],
 " is in the cylinder when ",
 StyleBox["d(a_i, v) \[LessEqual] r", "TI"],
 " for its slice."
}], "Notes",ExpressionUUID->"fdd0506c-982e-4dd3-ac5d-4f23b0edb45d"],

Cell[TextData[{
 "The axis is a walk: a vertex, a vertex list, or a path or cycle graph. A \
density or a Euclidean head such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4a0e22c9-081b-4e18-b9f9-a407c2706836"],
 " leaves the call unevaluated; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRepresentative"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8da81cb5-71b6-4b5d-87f1-1e3c2ff457d9"],
 " gives the axis of one shortest path."
}], "Notes",ExpressionUUID->"1721d17f-4138-465e-aa3a-d5ef5b8a342b"],

Cell["\<\
The axis is prolonged straight on past both ends, through the neighbours of \
an end vertex that continue the line, and the vertices nearer a prolongation \
than the axis are cut. So the ends are flat, which is what makes a cylinder \
and not a tube. A closed axis has no ends.\
\>", "Notes",ExpressionUUID->"49cc3c8d-15a4-4e75-a4c4-eaba6222554e"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81fa090a-3dce-47c5-bdce-2f8e43e73095"],
 " reads the same profile as the union of the balls, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aae27f7b-c260-4970-95a3-9b5f1f13ddd0"],
 ", rounded at both ends."
}], "Notes",ExpressionUUID->"1647f681-db73-46e0-9adf-3f489a5c2944"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
