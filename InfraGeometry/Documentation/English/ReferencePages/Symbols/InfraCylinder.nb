Cell[CellGroupData[{
Cell["InfraCylinder", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b2745fa7-d299-441f-880a-a2ec2853714a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCylinder"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af9732d7-d8b3-4ec0-a35c-6b6974875008"],
 "\[LineSeparator]",
 "is the cylinder of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["axis", "TI"],
 ": the vertices at distance at most ",
 StyleBox["r", "TI"],
 " from it. It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ba1ddf08-64fa-4e62-ba8e-88c319603229"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2d08d6c8-2588-4685-8006-e3b91b92f783"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e1d8a9fd-fe0a-4dd4-b632-a6eb535a666c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCylinder"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b84f7fc-ede9-4627-8ac1-10a8b812a67b"],
 "\[LineSeparator]",
 "is the mantle: the vertices at distance between ",
 StyleBox["r", "TI"],
 " and ",
 StyleBox["s", "TI"],
 "."
}], "Usage",ExpressionUUID->"c5fe8cf3-a08d-4f68-a968-141dffcab25b"],

Cell[TextData[{
 "Definition: the cylinder of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["axis", "TI"],
 " is ",
 StyleBox["{v : d(v, axis) \[LessEqual] r}", "TI"],
 ", the solid of revolution of the constant radius profile. ",
 StyleBox["axis", "TI"],
 " is a vertex list, or a Euclidean head."
}], "Notes",ExpressionUUID->"62d7a39d-92d6-45f5-94c5-9f05e70f241d"],

Cell[TextData[{
 "It is the blog's word for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTube"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "471cf9f0-8e7e-45cb-989a-3807dc2d5434"],
 " with an axis for a core, and has its own definition."
}], "Notes",ExpressionUUID->"522f9cd5-424c-44c3-a684-584923b96c97"],

Cell[TextData[{
 "The cylinder has caps of half balls at both ends of the axis, since every \
vertex within ",
 StyleBox["r", "TI"],
 " of an end vertex counts."
}], "Notes",ExpressionUUID->"da297a85-8688-4d97-8891-8cee0d7de306"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
