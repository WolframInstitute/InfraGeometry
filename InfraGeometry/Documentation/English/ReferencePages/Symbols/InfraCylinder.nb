Cell["\<\
The rounded cylinder is the tube about the axis, and the cylinder lies in it.\
\
\>", "ExampleText",ExpressionUUID->"2c8b2388-4614-49b2-9f8c-2c12810d1c20"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "39", ",", " ", "40", ",", " ", "41", ",", " ", "42", ",", " ", "43"}], 
      "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"tube", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraTube", "[", 
        RowBox[{"axis", ",", " ", "2"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"FindInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCylinder", "[", 
         RowBox[{"axis", ",", " ", "2", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<Balls\>\""}]}], "]"}]}], 
       "]"}], " ", "===", " ", "tube"}], ",", "\n", "   ", 
     RowBox[{"SubsetQ", "[", 
      RowBox[{"tube", ",", " ", 
       RowBox[{"FindInfraRepresentative", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCylinder", "[", 
          RowBox[{"axis", ",", " ", "2"}], "]"}]}], "]"}]}], "]"}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"31e101a1-065d-47f1-b41b-beea039a5475"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"ef593023-ec66-44c6-a431-1b8f1714ebb7"]
}, Open  ]],

Cell["\<\
The cylinder is the solid of revolution of the constant profile.\
\>", "ExampleText",ExpressionUUID->"2791ec0c-32a7-4f33-beb8-822a372a1654"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "39", ",", " ", "40", ",", " ", "41", ",", " ", "42", ",", " ", "43"}], 
      "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"FindInfraRepresentative", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraCylinder", "[", 
       RowBox[{"axis", ",", " ", "2"}], "]"}]}], "]"}], " ", "===", " ", 
    RowBox[{"FindInfraRepresentative", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraSolidOfRevolution", "[", 
       RowBox[{"axis", ",", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"2", ",", " ", "5"}], "]"}]}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"3a0d110e-7d34-469e-a2da-5f741f4f40cc"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"9c541fbd-d667-4bce-bd79-476b20bae7c2"]
}, Open  ]]
