             UndirectedEdge[54, 55] -> ({}& ), 
              UndirectedEdge[64, 74] -> ({}& ), UndirectedEdge[45, 55] -> ({
                JoinForm["Round"], 
                CapForm["Round"], 
                If[
                 And[
                  MatchQ[
                   Part[{{
                    UndirectedEdge[45, 55], 
                    UndirectedEdge[54, 55], 
                    UndirectedEdge[54, 64], 
                    UndirectedEdge[64, 74]}, {{5., 5.}, {6., 5.}, {6., 4.}, {
                    7., 4.}, {8., 4.}}, True, None}, 4], 
                   Blank[Arrowheads]], 
                  Part[{{
                    UndirectedEdge[45, 55], 
                    UndirectedEdge[54, 55], 
                    UndirectedEdge[54, 64], 
                    UndirectedEdge[64, 74]}, {{5., 5.}, {6., 5.}, {6., 4.}, {
                    7., 4.}, {8., 4.}}, True, None}, 3]], 
