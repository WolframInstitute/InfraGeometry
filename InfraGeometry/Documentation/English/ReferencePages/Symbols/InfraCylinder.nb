Cell["\<\
The rounded cylinder is the tube about the axis, and the cylinder lies in it.\
\
\>", "ExampleText",ExpressionUUID->"7efa3882-56b5-4545-975e-de61d23f514d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "39", ",", " ", "40", ",", " ", "41", ",", " ", "42", ",", " ", "43"}], 
      "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"tube", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraTube", "[", 
        RowBox[{"axis", ",", " ", "2"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"FindInfraRepresentative", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraCylinder", "[", 
         RowBox[{"axis", ",", " ", "2", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<Balls\>\""}]}], "]"}]}], 
       "]"}], " ", "===", " ", "tube"}], ",", "\n", "   ", 
     RowBox[{"SubsetQ", "[", 
      RowBox[{"tube", ",", " ", 
       RowBox[{"FindInfraRepresentative", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCylinder", "[", 
          RowBox[{"axis", ",", " ", "2"}], "]"}]}], "]"}]}], "]"}]}], "}"}]}],
   "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7da4d23a-363d-4890-bb64-9ecb21a654f6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"b1cb5229-5176-4483-bd31-670abb658c60"]
}, Open  ]],

Cell["\<\
The cylinder is the solid of revolution of the constant profile.\
\>", "ExampleText",ExpressionUUID->"c64968d2-8cac-49a2-a5ef-ec501dca595a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "39", ",", " ", "40", ",", " ", "41", ",", " ", "42", ",", " ", "43"}], 
      "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"FindInfraRepresentative", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraCylinder", "[", 
       RowBox[{"axis", ",", " ", "2"}], "]"}]}], "]"}], " ", "===", " ", 
    RowBox[{"FindInfraRepresentative", "[", 
     RowBox[{"g", ",", " ", 
      RowBox[{"InfraSolidOfRevolution", "[", 
       RowBox[{"axis", ",", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"2", ",", " ", "5"}], "]"}]}], "]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"f6ad05b4-98e2-4a23-9a4d-cab42f933643"],

