   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5c7f293b-31f8-4c11-8c85-d2c255e29ec0"],
 " gives two measures of a cylinder:"
}], "Notes",ExpressionUUID->"143b3935-f396-4795-823f-ab738e6e72f3"],

