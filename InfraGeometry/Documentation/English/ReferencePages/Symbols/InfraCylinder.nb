Cell[CellGroupData[{
Cell["InfraCylinder", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"736f9097-7fd8-4867-89ff-bfb8ac2df9a6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCylinder"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "392100f1-8171-4411-bcac-f5471ae61a4b"],
 "\[LineSeparator]",
 "is the cylinder of radius ",
 StyleBox["r", "TI"],
 " about the walk ",
 StyleBox["axis", "TI"],
 ": the vertices within ",
 StyleBox["r", "TI"],
 " of the axis vertex they project to, with flat ends.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b692aa0d-bc15-4f23-ada4-94e7e237da1f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCylinder"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48177d4a-2b8a-4409-9e8c-9f7ba2c8e28f"],
 "\[LineSeparator]",
 "is the shell of the cylinder: the vertices at distance between ",
 StyleBox["r", "TI"],
 " and ",
 StyleBox["s", "TI"],
 " from the axis vertex they project to."
}], "Usage",ExpressionUUID->"268cc38e-3f95-4a7e-a328-f087fb9a0bbc"],

Cell[TextData[{
 "Let the axis be ",
 StyleBox["a\:2081, \[Ellipsis], a\:2099", "TI"],
 ". A vertex ",
 StyleBox["v", "TI"],
 " projects to the axis vertices nearest to it. The cylinder is ",
 StyleBox["Z = {v : d(a\:1d62, v) \[LessEqual] r for an axis vertex a\:1d62 \
nearest to v}", "TI"],
 ", the sliced tube ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Sliced\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8cbcfa4f-99f1-407f-9927-75bb99319cc3"],
 "."
}], "Notes",ExpressionUUID->"df1bb189-7ada-401d-89ea-0823b23496dd"],

Cell["\<\
The axis is prolonged straight past both ends, and the vertices nearer the \
prolongation than the axis are cut off. So the ends are flat. A closed axis \
has no ends.\
\>", "Notes",ExpressionUUID->"99eb6093-36be-4629-933a-ea11426ba69e"],

Cell[TextData[{
 "The axis is a vertex list or a path or cycle graph, such as one shortest \
path drawn by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ee655372-15bb-4b65-b71d-1c714237b486"],
 "."
}], "Notes",ExpressionUUID->"c119e9ef-8188-43ac-a6e9-3f35c76aa0b5"],

Cell[TextData[{
 "On the square grid, away from the rim, the cylinder of radius ",
 StyleBox["r", "TI"],
 " about a straight axis of ",
 StyleBox["n", "TI"],
 " edges is the (",
 StyleBox["n", "TI"],
 " + 1) \[Times] (2",
 StyleBox["r", "TI"],
 " + 1) rectangle. Its counting measure is ",
 StyleBox["(n + 1)(2r + 1)", "TI"],
 " and its Riemannian measure ",
 StyleBox["(n \[Minus] 1)(2r \[Minus] 1)", "TI"],
 " for ",
 StyleBox["r \[GreaterEqual] 1", "TI"],
 "."
}], "Notes",ExpressionUUID->"a85c50b7-a067-4242-81b4-ef8d078c5dbc"],

