Cell["\<\
The shell of radius 1 to 2 about the axis, without the axis itself:\
\>", "ExampleText",ExpressionUUID->"26148491-01bb-40ff-80a4-a036bfe19b82"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"axis", " ", "=", " ", 
        RowBox[{"RandomInfraSegment", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", 
          RowBox[{"RandomInfraPoint", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraShell", "[", 
             RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", 
            RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"InfraCylinder", "[", 
           RowBox[{"axis", ",", " ", 
