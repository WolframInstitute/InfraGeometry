   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "75f3fb6e-1056-4ca0-a47d-896193c8e84e"],
 " gives two measures of a cylinder:"
}], "Notes",ExpressionUUID->"59d95d78-f7b5-44ba-9951-2e68ed43bcfb"],

