Cell["\<\
The cylinder of radius 1 about a shortest path on the discretized plane, the \
square grid and the hexagonal tiling. The Riemannian measure counts the inner \
vertices, in green; the counting measure adds the boundary, in blue.\
\>", "ExampleText",ExpressionUUID->"71b11e1f-c7df-477a-9d9f-de6777ff7afe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"axis", " ", "=", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraSegment", "[", 
           RowBox[{"c", ",", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
              RowBox[{"RandomInfraPoint", "[", 
               RowBox[{"g", ",", " ", "c", ",", " ", "4"}], "]"}]}], ")"}]}], 
           "]"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"cylinder", " ", "=", " ", 
        RowBox[{"InfraCylinder", "[", 
         RowBox[{"axis", ",", " ", "1"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"support", " ", "=", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", "cylinder"}], "]"}]}], "}"}], ",", "\n", 
      "    ", 
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"InfraInterior", "[", 
              RowBox[{"g", ",", " ", "support"}], "]"}], " ", "->", " ", 
             "$InfraBallColor"}], ",", " ", 
            RowBox[{
             RowBox[{"InfraBoundary", "[", 
              RowBox[{"g", ",", " ", "support"}], "]"}], " ", "->", " ", 
             "$InfraCircleColor"}]}], "}"}]}], "]"}], ",", "\n", "      ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", "cylinder", ",", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<CountingMeasure\>\"", ",", 
            " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "]"}]}], "]"}]}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"347f32b1-0cf8-4233-a4c2-81f80a84d8d3"],

