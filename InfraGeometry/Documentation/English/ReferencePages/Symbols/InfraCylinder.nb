Cell[TextData[{
 "About a straight axis of 4 edges on the grid, the counting measure is ",
 StyleBox["5(2r + 1)", "TI"],
 " and the Riemannian measure ",
 StyleBox["3(2r \[Minus] 1)", "TI"],
 "; the round ends add ",
 StyleBox["2r\.b2", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"e8e60dab-5883-4e4f-b448-f8c48d316467"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"c", ",", " ", "4"}], "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraSegment", "[", 
            RowBox[{"c", ",", " ", "#"}], "]"}], ",", 
           " ", "\"\<Cardinality\>\""}], "]"}], " ", "==", " ", "1"}], " ", 
        "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"RandomInfraSegment", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "q", ",", " ", "All"}], 
       "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCylinder", "[", 
          RowBox[{"axis", ",", " ", "r"}], "]"}], ",", 
         " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
       RowBox[{"5", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "r"}], " ", "+", " ", "1"}], ")"}]}], ",", "\n", 
       "    ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCylinder", "[", 
          RowBox[{"axis", ",", " ", "r"}], "]"}], ",", 
         " ", "\"\<RiemannianMeasure\>\""}], "]"}], ",", " ", 
       RowBox[{"3", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "r"}], " ", "-", " ", "1"}], ")"}]}], ",", " ", 
       RowBox[{
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCylinder", "[", 
           RowBox[{"axis", ",", " ", "r", ",", " ", 
            RowBox[{"Method", " ", "->", " ", "\"\<Balls\>\""}]}], "]"}], ",",
           " ", "\"\<CountingMeasure\>\""}], "]"}], " ", "-", " ", 
        RowBox[{"5", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "r"}], " ", "+", " ", "1"}], ")"}]}]}]}], "}"}], 
     ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"63ebeb2a-3a87-45a7-9db9-e8c2e071ee53"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"15", ",", "15", ",", "3", ",", "3", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"25", ",", "25", ",", "9", ",", "9", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"35", ",", "35", ",", "15", ",", "15", ",", "18"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2bd6b5fb-6c3e-4312-bb37-c94ed34205e5"]
}, Open  ]],

Cell["\<\
The cylinder lies in the tube about its axis, and with round ends it is the \
tube:\
\>", "ExampleText",ExpressionUUID->"626353ed-3562-4f25-9ca8-1364afc24ffb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"tube", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraTube", "[", 
         RowBox[{"axis", ",", " ", "2"}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"SubsetQ", "[", 
      RowBox[{"tube", ",", " ", 
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraCylinder", "[", 
           RowBox[{"axis", ",", " ", "2"}], "]"}], ",", 
          " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "]"}], ",", "\n", "   ", 
     
     RowBox[{
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCylinder", "[", 
          RowBox[{"axis", ",", " ", "2", ",", " ", 
           RowBox[{"Method", " ", "->", " ", "\"\<Balls\>\""}]}], "]"}], ",", 
         " ", "\"\<VertexDensity\>\""}], "]"}]}], " ", "===", " ", "tube"}]}],
     "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"94ef1818-61cd-45fc-a639-b4fffba95ec3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"dacc9e41-42e5-48ae-841b-c3d0747ea58c"]
}, Open  ]],

Cell["It is the solid of revolution of the constant profile:", "ExampleText",ExpressionUUID->"dadfc048-8968-4e6f-922f-65448daad007"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"axis", " ", "=", " ", 
     RowBox[{"RandomInfraSegment", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "4"}], "]"}], ",", " ", 
         RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{"Keys", " ", "@", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCylinder", "[", 
        RowBox[{"axis", ",", " ", "2"}], "]"}], ",", 
       " ", "\"\<VertexDensity\>\""}], "]"}]}], " ", "===", "\n", "    ", 
    RowBox[{"Keys", " ", "@", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSolidOfRevolution", "[", 
        RowBox[{"axis", ",", " ", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"2", ",", " ", 
           RowBox[{"Length", "[", "axis", "]"}]}], "]"}]}], "]"}], ",", 
       " ", "\"\<VertexDensity\>\""}], "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"fe379326-f5dc-4371-9f40-d567ceab6375"],

