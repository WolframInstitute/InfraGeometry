Notebook[{

Cell[CellGroupData[{
Cell["InfraCylinder", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a27dac6f-1cdf-4e60-9c68-27871661315e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCylinder"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac1bb06f-34bb-46ae-a506-59d92464c998"],
 "\[LineSeparator]",
 "is the cylinder of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["axis", "TI"],
 ": the vertices within ",
 StyleBox["r", "TI"],
 " of the axis vertex they project to, with flat ends. It is a symbolic \
object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8e2a8542-a282-4fe9-8d63-ba8fababfc5d"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraCylinder"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraCylinder", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9831d9c7-ccf0-45c4-8f81-f48723e9bea3"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"60316145-2580-4cfd-b78d-dbfb9e7042a1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCylinder"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3609a7e5-3916-4f24-bf86-9dca906b0d30"],
 "\[LineSeparator]",
 "is the mantle: the vertices at distance between ",
 StyleBox["r", "TI"],
 " and ",
 StyleBox["s", "TI"],
 " from their axis vertex.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ef155de4-0b30-40a3-9dda-4b40cb8c03d6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCylinder"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraCylinder", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53fe8c5d-0c3c-4707-bfcd-f9e30ce00085"],
 "\[LineSeparator]",
 "is the rounded cylinder, the union of the balls of radius ",
 StyleBox["r", "TI"],
 " about the axis vertices."
}], "Usage",ExpressionUUID->"457abb97-f973-4616-8bcb-da21fabd22f6"],

Cell[TextData[{
 "Definition: the cylinder of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["axis", "TI"],
 " is the sliced tube ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], " ", "->", " ", "\"\<Sliced\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2df58d8-fef2-4a97-85e3-2104c58b79c9"],
 ". Slice ",
 StyleBox["i", "TI"],
 " is the set of vertices whose nearest axis vertex is ",
 StyleBox["a_i", "TI"],
 ", a tie lying in every nearest slice, and ",
 StyleBox["v", "TI"],
 " is in the cylinder when ",
 StyleBox["d(a_i, v) \[LessEqual] r", "TI"],
 " for its slice."
}], "Notes",ExpressionUUID->"bc47b11b-4ddd-4ada-bf7a-c6fe68a15d93"],

Cell[TextData[{
 "The axis is a walk: a vertex, a vertex list, or a path or cycle graph. A \
density or a Euclidean head such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0c86c0fc-1131-4e8f-8dd8-8358d39290cc"],
 " leaves the call unevaluated; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraCylinder"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraCylinder", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60ae2377-bd25-4efc-97ac-089e0aeb685c"],
 " gives the axis of one shortest path."
}], "Notes",ExpressionUUID->"81b7dbf3-6251-474d-8335-64669f28275e"],

Cell["\<\
The axis is prolonged straight on past both ends, through the neighbours of \
an end vertex that continue the line, and the vertices nearer a prolongation \
than the axis are cut. So the ends are flat, which is what makes a cylinder \
and not a tube. A closed axis has no ends.\
\>", "Notes",ExpressionUUID->"e7a43646-107d-46d8-a83f-71570235841e"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link"], " ", "->", " ", "\"\<Balls\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "83af3b01-5ab3-4bc7-a9d3-4b8d4189348a"],
 " reads the same profile as the union of the balls, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraTube"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraTube", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9acce1ab-3450-45c0-a9d7-62904e366fab"],
 ", rounded at both ends."
}], "Notes",ExpressionUUID->"ad07c9a2-274b-453a-afdc-bcaa1984b45a"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "00d2308e-3556-498c-9487-17d20ccaba79"],
 " gives two measures of a cylinder:"
}], "Notes",ExpressionUUID->"aeb99ffc-d5d0-4fc9-81b9-1de8fa6b1bd4"],

