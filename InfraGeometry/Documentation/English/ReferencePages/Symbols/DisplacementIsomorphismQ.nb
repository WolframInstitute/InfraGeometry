Notebook[{

Cell[CellGroupData[{
Cell["DisplacementIsomorphismQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f1167c6d-8e6c-4f5e-aa23-34764d558911"],
 Cell[BoxData[
  RowBox[{"DisplacementIsomorphismQ", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dd0c5b8-bf8e-457e-817e-dfb03adbde4a"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3d8cb665-ce53-4144-af8c-9e515e66be2e"],
 " when the displacement ",
 StyleBox["d", "TI"],
 " is an automorphism of ",
 StyleBox["g", "TI"],
 ", a discrete Killing displacement, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d589dbc8-ef37-4178-805d-0c9319146db6"],
 " otherwise.",
 "\n"
}], "Usage",ExpressionUUID->"a3716f81-7946-49e5-b182-00547ef55a44"],

Cell[TextData[{
 "Definition: ",
 StyleBox["D", "TI"],
 " is an automorphism when it is a bijection (",
 Cell[BoxData["DisplacementBijectionQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f344b7bf-e114-46bb-bf2a-a4575f50df9e"],
 ") and the images of the ends of every edge of ",
 StyleBox["g", "TI"],
 " are joined by an edge. On a finite graph such a bijection also maps \
non-edges to non-edges, so it is an isometry of the graph metric: the \
discrete counterpart of the flow of a Killing field."
}], "Notes",ExpressionUUID->"84956c75-7cf1-47f2-b99e-76848bda99ac"],

Cell[TextData[{
 "A bijection that is 1-continuous (",
 Cell[BoxData["ContinuousDisplacementQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "677b4ae8-b10a-457c-9496-e00650face50"],
 ") is an automorphism. It does not increase any distance, and it permutes \
the pairs of vertices, so the total of all distances stays the same; hence \
every distance stays the same."
}], "Notes",ExpressionUUID->"55a9106f-5c86-4e92-84be-aafb96b71675"],

Cell[TextData[{
 "The automorphisms of ",
 StyleBox["g", "TI"],
 " form a group: composites, inverses and commutators of automorphisms are \
automorphisms. ",
 Cell[BoxData["FindKillingDisplacement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b4ffea3-0684-4eb8-87ce-0e26742193be"],
 " gives those of least magnitude."
}], "Notes",ExpressionUUID->"692ed76e-fa33-486d-b268-69d927da7e35"]
}, Open  ]],

