Cell["\<\
The least symmetry of the square, the triangular and the hexagonal tilings is \
an automorphism.\
\>", "ExampleText",ExpressionUUID->"b5df9149-9425-49a4-9f9f-151573fbac48"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graphs", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"#", ",", " ", "\"\<Small\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}],
        " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"DisplacementPlot", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"FindKillingDisplacement", "[", "#", "]"}]}], "]"}], " ", 
        "&"}], " ", "/@", " ", "graphs"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"DisplacementIsomorphismQ", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"FindKillingDisplacement", "[", "#", "]"}]}], "]"}], " ", 
       "&"}], " ", "/@", " ", "graphs"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2e29753e-e6e2-4a8d-a191-30aa10e5b5a9"],

