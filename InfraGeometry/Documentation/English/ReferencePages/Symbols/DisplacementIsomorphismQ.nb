Cell["\<\
The translation of the square torus by one step is an automorphism. The torus \
has no rim:\
\>", "ExampleText",ExpressionUUID->"6fc0f101-823c-4a04-9844-3e47f67f2b04"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"DisplacementIsomorphismQ", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b4993b0b-726f-4124-8dac-078263ad12dd"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"eb61d34f-e5e6-456a-9aaa-ed6096053d6a"]
}, Open  ]]
}, Open  ]],

