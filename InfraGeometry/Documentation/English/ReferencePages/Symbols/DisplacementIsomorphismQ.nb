Cell["\<\
The least symmetry of the square grid exchanges two pendant vertices at a \
corner, and it is an automorphism. The step right of the grid is not:\
\>", "ExampleText",ExpressionUUID->"7fe6fe30-6581-4a18-8b0b-8f73e98a10c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"DisplacementPlot", "[", 
       RowBox[{"g", ",", " ", "d", ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"DisplacementIsomorphismQ", "[", 
          RowBox[{"g", ",", " ", "d"}], "]"}]}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"d", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"FindKillingDisplacement", "[", "g", "]"}], ",", " ", 
          RowBox[{"TranslationDisplacement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], "}"}]}], "}"}]}],
      "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7c05abd7-28f3-4b40-b2fa-29aabba11a1e"],

