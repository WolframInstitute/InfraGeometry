Cell[CellGroupData[{
Cell["DisplacementIsomorphismQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a5417d95-f48b-4858-ab3f-6609c585340b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementIsomorphismQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementIsomorphismQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b903cc6-91d8-44e2-8faf-c00f7c1a139e"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9e4bc04b-1314-46ca-a60e-53a04cd16d1d"],
 " when the displacement ",
 StyleBox["d", "TI"],
 " is an automorphism of ",
 StyleBox["g", "TI"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d2bb2868-a598-4d70-b973-3a68a8b8ec8f"],
 " otherwise.",
 "\n"
}], "Usage",ExpressionUUID->"25172ccb-a474-4eb1-bcf4-61e6f7215478"],

Cell[TextData[{
 StyleBox["D", "TI"],
 " is an automorphism when it is a bijection (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementBijectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementBijectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b392be7e-5056-4887-8d81-05d4b7da5981"],
 ") and the images of the ends of every edge of ",
 StyleBox["g", "TI"],
 " are joined by an edge."
}], "Notes",ExpressionUUID->"c0bcb300-823b-46e2-9884-e23337ccd89d"],

Cell[TextData[{
 "An automorphism is an isometry of the graph metric, ",
 StyleBox["d(D(u), D(v)) = d(u, v)", "TI"],
 ": the discrete counterpart of the flow of a Killing field."
}], "Notes",ExpressionUUID->"a7376fdb-bc87-4bbb-8d12-3d6b5ad5fc8e"],

Cell[TextData[{
 "A bijection is an automorphism exactly when it is 1-continuous (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ContinuousDisplacementQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ContinuousDisplacementQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "366f71de-1275-4371-9374-95bdc33ef95a"],
 "). It then increases no distance and permutes the pairs of vertices, so it \
keeps every distance."
}], "Notes",ExpressionUUID->"3636cfad-38dc-41b0-9fd5-be85c75a8fab"],

Cell[TextData[{
 "The automorphisms form a group: composites, inverses and commutators of \
automorphisms are automorphisms. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindKillingDisplacement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindKillingDisplacement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0aa0ca0d-bd0a-426e-bd82-342909a94c5f"],
 " gives those of least magnitude."
}], "Notes",ExpressionUUID->"619805f0-471a-437d-be66-a2f758dbb2f0"]
}, Open  ]],

