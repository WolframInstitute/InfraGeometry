Cell["\<\
The magnitudes of the 128 automorphisms of the grid, with their counts. \
Besides the identity and the 15 exchanges of pendant vertices at the corners, \
every symmetry moves some vertex 9 or 16 steps:\
\>", "ExampleText",ExpressionUUID->"c1922912-092a-4a84-9198-92ab8e3bd93b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"elements", " ", "=", " ", 
     RowBox[{"GroupElements", "[", 
      RowBox[{"GraphAutomorphismGroup", "[", "g", "]"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"automorphisms", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{"List", " ", "/@", " ", 
          RowBox[{"Permute", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "#"}], "]"}]}]}],
         "]"}], " ", "&"}], " ", "/@", " ", "elements"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"AllTrue", "[", 
      RowBox[{"automorphisms", ",", " ", 
       RowBox[{
        RowBox[{"DisplacementIsomorphismQ", "[", 
         RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"KeySort", " ", "@", " ", 
      RowBox[{"Counts", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"DisplacementMagnitude", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
        "automorphisms"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0ccd1040-afab-439a-8356-bd14ea77c0d7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"0", "\[Rule]", "1"}], ",", 
     RowBox[{"2", "\[Rule]", "15"}], ",", 
     RowBox[{"9", "\[Rule]", "64"}], ",", 
     RowBox[{"16", "\[Rule]", "48"}]}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1d9ad468-39e6-4c47-8cba-6da2a252ee24"]
}, Open  ]],

Cell["\<\
An automorphism is 1-continuous; the exchange of two neighbours is not:\
\>", "ExampleText",ExpressionUUID->"b228fa9a-a3a5-4428-8013-19ae9e269426"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"swap", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"AssociationMap", "[", 
        RowBox[{"List", ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"c", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"c", " ", "+", " ", "1"}], "}"}]}], ",", " ", 
         RowBox[{
          RowBox[{"c", " ", "+", " ", "1"}], " ", "->", " ", 
          RowBox[{"{", "c", "}"}]}]}], "|>"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ContinuousDisplacementQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], "]"}], ",", " ", 
     
     RowBox[{"ContinuousDisplacementQ", "[", 
      RowBox[{"g", ",", " ", "swap"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b8a157a4-37ea-41d9-b1c1-1730e12808ad"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"36740845-d937-4a1b-b148-cfabf8a203a1"]
}, Open  ]],

Cell["The composite of two automorphisms is an automorphism:", "ExampleText",ExpressionUUID->"70c272fe-fb88-442c-baea-9a3e7644bd52"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"least", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", "[", 
      RowBox[{"g", ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"DisplacementIsomorphismQ", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"DisplacementCompose", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", "least"}], ",", " ", 
       RowBox[{"Last", " ", "@", " ", "least"}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"b648c17c-cb6d-4012-b9bc-7ab85ebc1513"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"a0f58e93-eb25-4774-a4bd-f0532d60bf8d"]
}, Open  ]]
}, Open  ]],

