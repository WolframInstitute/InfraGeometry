Cell["\<\
The commutator of two automorphisms is an automorphism. On the 12-cycle the \
rotation and a reflection give the rotation by two steps.\
\>", "ExampleText",ExpressionUUID->"b4389da0-2b7c-45ad-a52f-076e60d720df"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rotation", " ", "=", " ", 
      RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"reflection", " ", "=", " ", 
      RowBox[{"AssociationMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"2", " ", "-", " ", "#"}], ",", " ", "12", ",", " ", 
            "1"}], "]"}], "}"}], " ", "&"}], ",", " ", 
        RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"loop", " ", "=", " ", 
     RowBox[{"DisplacementCommutator", "[", 
      RowBox[{"g", ",", " ", "rotation", ",", " ", "reflection"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", "loop"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"DisplacementIsomorphismQ", "[", 
        RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"rotation", ",", " ", "reflection", ",", " ", "loop"}], 
       "}"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"50ffbb37-695e-408b-ab2a-bb2f2f34f37e"],

