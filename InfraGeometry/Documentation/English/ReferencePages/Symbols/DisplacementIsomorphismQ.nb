Cell["\<\
The 1-continuous bijections of the hexagon are its 12 automorphisms.\
\>", "ExampleText",ExpressionUUID->"e48dbc1a-41c2-484b-91b4-b26f97a4eeeb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "6", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"bijections", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"Range", "[", "6", "]"}], ",", " ", 
         RowBox[{"List", " ", "/@", " ", "#"}]}], "]"}], " ", "&"}], " ", "/@",
       " ", 
      RowBox[{"Permutations", "[", 
       RowBox[{"Range", "[", "6", "]"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"automorphisms", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"bijections", ",", " ", 
       RowBox[{
        RowBox[{"DisplacementIsomorphismQ", "[", 
         RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsGrid", "[", 
      RowBox[{"Partition", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"DisplacementPlot", "[", 
           RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
         "automorphisms"}], ",", " ", "6"}], "]"}], "]"}], ",", " ", 
     RowBox[{"Length", "[", "automorphisms", "]"}], ",", " ", 
     RowBox[{"automorphisms", " ", "===", " ", 
      RowBox[{"Select", "[", 
       RowBox[{"bijections", ",", " ", 
        RowBox[{
         RowBox[{"ContinuousDisplacementQ", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}]}], "]"}]}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"72467958-a09d-4a5d-ba8c-bd9988a9ef13"],

