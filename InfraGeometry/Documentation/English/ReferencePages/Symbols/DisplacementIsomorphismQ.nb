Cell["\<\
Exchanging the two ends of one edge of the 12-cycle is a bijection of \
magnitude 1, but not an automorphism: it sends the edge from 12 to 1 to the \
vertices 12 and 2, two steps apart.\
\>", "ExampleText",ExpressionUUID->"ab4288b3-5e8f-44d1-adb2-27183f55ff3c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"swap", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"AssociationMap", "[", 
        RowBox[{"List", ",", " ", 
         RowBox[{"VertexList", "[", "g", "]"}]}], "]"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", 
          RowBox[{"{", "2", "}"}]}], ",", " ", 
         RowBox[{"2", " ", "->", " ", 
          RowBox[{"{", "1", "}"}]}]}], "|>"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DisplacementPlot", "[", 
      RowBox[{"g", ",", " ", "swap"}], "]"}], ",", " ", 
     RowBox[{"DisplacementBijectionQ", "[", "swap", "]"}], ",", " ", 
     RowBox[{"DisplacementIsomorphismQ", "[", 
      RowBox[{"g", ",", " ", "swap"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"55c6b9c8-b8f2-475d-800c-3126117d5a85"],

