Cell["\<\
The resistance matrix of the square mesh passes, its distance matrix does not:\
\>", "ExampleText",ExpressionUUID->"1e5ef517-3ecb-466d-9121-cd5a098d73f4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"ArrayPlot", "[", 
       RowBox[{"m", ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"ResistanceQ", "[", "m", "]"}]}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"EffectiveResistance", "[", "g", "]"}], ",", " ", 
          RowBox[{"GraphDistanceMatrix", "[", "g", "]"}]}], "}"}]}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cc2f09cb-e1b0-4973-b4f8-715bcb0fb72c"],

