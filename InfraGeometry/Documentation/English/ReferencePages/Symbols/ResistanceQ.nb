Cell[TextData[{
 "On a tree the distances are the resistances, and the distance matrix \
passes. The distance matrices of the complete bipartite graph ",
 StyleBox["K", "TI"],
 "\:2082,\:2083 and of the discretized plane are not of negative type, so \
they are no resistance matrices."
}], "ExampleText",ExpressionUUID->"0ce8d05d-0a18-4f46-b4e5-b9aa18a5e040"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graphs", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"KaryTree", "[", "15", "]"}], ",", " ", 
       RowBox[{"CompleteGraph", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
         " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
        "]"}]}], "}"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", "graphs", "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"ResistanceQ", "[", 
        RowBox[{"GraphDistanceMatrix", "[", "#", "]"}], "]"}], " ", "&"}], 
      " ", "/@", " ", "graphs"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4ee8f652-218c-414d-8180-a721473b153d"],

