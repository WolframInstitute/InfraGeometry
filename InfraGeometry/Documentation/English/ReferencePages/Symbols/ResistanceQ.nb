Cell["\<\
On a tree the distances are the resistances, and the distance matrix passes:\
\>", "ExampleText",ExpressionUUID->"114db70d-935c-4aa2-892f-f704a019ce99"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"KaryTree", "[", "15", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ResistanceQ", "[", 
      RowBox[{"GraphDistanceMatrix", "[", "g", "]"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Max", " ", "@", " ", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"EffectiveResistance", "[", "g", "]"}], " ", "-", " ", 
         RowBox[{"GraphDistanceMatrix", "[", "g", "]"}]}], "]"}]}], " ", "<", 
      " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "9"}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a84e81ee-5aa8-4a58-b4a5-bcde2f65e84e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"23cc4b9b-ed53-4bea-a6e4-1a2d116fa1bc"]
}, Open  ]]
}, Open  ]],

