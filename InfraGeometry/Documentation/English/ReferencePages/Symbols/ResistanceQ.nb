Notebook[{

Cell[CellGroupData[{
Cell["ResistanceQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3de8a2dc-b70c-4806-aa87-3479225e849a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ResistanceQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ResistanceQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["r", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb436f55-3cfb-4e40-8fe4-a763f4a4dc31"],
 "\[LineSeparator]",
 "tests whether the symmetric matrix ",
 StyleBox["r", "TI"],
 " with zero diagonal is of negative type, a condition every resistance \
distance matrix meets.",
 "\n"
}], "Usage",ExpressionUUID->"8a1aef18-fa02-4493-9319-bae4f51b1b34"],

Cell[TextData[{
 "Definition: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ResistanceQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ResistanceQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "98d4c8a4-5048-405d-8be5-16bd6dee87f0"],
 " gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "02081095-d5cd-42d5-8210-a2693a2f7c1c"],
 " when ",
 StyleBox["r", "TI"],
 " is a square symmetric matrix with zero diagonal and the matrix ",
 StyleBox["B", "TI"],
 "\:1d62\:2c7c = (",
 StyleBox["r", "TI"],
 "\:2081\:2c7c + ",
 StyleBox["r", "TI"],
 "\:1d62\:2081 \[Minus] ",
 StyleBox["r", "TI"],
 "\:1d62\:2c7c)/2, ",
 StyleBox["i", "TI"],
 ", ",
 StyleBox["j", "TI"],
 " \[GreaterEqual] 2, is positive semidefinite, its eigenvalues at least \
\[Minus]10\:207b\:2079. Anything else gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ec95914c-7e42-457a-b0f2-39af45a3dc4b"],
 "."
}], "Notes",ExpressionUUID->"e35276d9-784c-4ac2-8d41-cc9c49ad8a08"],

Cell[TextData[{
 "By a theorem of Schoenberg, ",
 StyleBox["B", "TI"],
 " is positive semidefinite exactly when ",
 StyleBox["r", "TI"],
 " is of negative type: ",
 StyleBox["r", "TI"],
 "\:1d62\:2c7c = \:2016",
 StyleBox["x", "TI"],
 "\:1d62 \[Minus] ",
 StyleBox["x", "TI"],
 "\:2c7c\:2016\.b2 for some points ",
 StyleBox["x", "TI"],
 "\:1d62 of a Euclidean space. Every resistance matrix is of negative type, \
the points being its ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ResistanceCoordinates"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ResistanceCoordinates", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c3b8f167-4162-47af-bbee-3f301129a570"],
 ", so a matrix that fails is no resistance matrix."
}], "Notes",ExpressionUUID->"d036283d-9670-4bf1-9a27-3b0453096ca6"],

Cell[TextData[{
 "The converse fails. A matrix ",
 StyleBox["r", "TI"],
 " is the resistance matrix of a connected graph with nonnegative \
conductances exactly when, in addition, the matrix ",
 StyleBox["L", "TI"],
 " = (\[Minus]",
 StyleBox["P", "TI"],
 " ",
 StyleBox["r", "TI"],
 " ",
 StyleBox["P", "TI"],
 "/2)\:207a, with ",
 StyleBox["P", "TI"],
 " = ",
 StyleBox["I", "TI"],
 " \[Minus] ",
 StyleBox["J", "TI"],
 "/",
 StyleBox["n", "TI"],
 " and ",
 StyleBox["J", "TI"],
 " the matrix of ones, has rank ",
 StyleBox["n", "TI"],
 " \[Minus] 1 and no positive entry off the diagonal. ",
 StyleBox["L", "TI"],
 " is then the Laplacian of that graph, and \[Minus]",
 StyleBox["L", "TI"],
 "\:1d62\:2c7c the conductance between ",
 StyleBox["i", "TI"],
 " and ",
 StyleBox["j", "TI"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ResistanceQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ResistanceQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "84b419f2-f7a1-448b-8733-151bd8a969fc"],
 " does not test this."
}], "Notes",ExpressionUUID->"35c5c4d0-cd44-40c3-bb72-46b8656a589d"]
}, Open  ]],

