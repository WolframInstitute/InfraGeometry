Notebook[{

Cell[CellGroupData[{
Cell["ResistanceQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0371fb07-0fd9-4163-9e97-bd8f06e060fa"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ResistanceQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/ResistanceQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["r", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "389fb04b-96a0-473e-b8e3-5b82a9e75153"],
 "\[LineSeparator]",
 "tests whether the numeric matrix ",
 StyleBox["r", "TI"],
 " is the effective resistance matrix of a connected graph with nonnegative \
conductances.",
 "\n"
}], "Usage",ExpressionUUID->"2516e18b-6b41-4def-b126-de9b8f9b416c"],

Cell[TextData[{
 "Let ",
 StyleBox["P = I \[Minus] J/n", "TI"],
 ", with ",
 StyleBox["J", "TI"],
 " the matrix of ones, and ",
 StyleBox["B = \[Minus]P r P/2", "TI"],
 ". The symmetric matrix ",
 StyleBox["r", "TI"],
 " with zero diagonal is a resistance matrix exactly when ",
 StyleBox["B", "TI"],
 " is positive semidefinite of rank ",
 StyleBox["n \[Minus] 1", "TI"],
 " and ",
 StyleBox["L = B\:207a", "TI"],
 " has no positive entry off the diagonal. Then ",
 StyleBox["L", "TI"],
 " is the Laplacian of the graph and ",
 StyleBox["\[Minus]L\:1d62\:2c7c", "TI"],
 " the conductance between ",
 StyleBox["i", "TI"],
 " and ",
 StyleBox["j", "TI"],
 ". So a resistance matrix determines its graph."
}], "Notes",ExpressionUUID->"2aa5cf4d-6f81-4afa-8b77-35c32c49d847"],

Cell[TextData[{
 "The rank condition says that ",
 StyleBox["r", "TI"],
 " is of negative type: ",
 StyleBox["r\:1d62\:2c7c = \:2016x\:1d62 \[Minus] x\:2c7c\:2016\.b2", "TI"],
 " for points ",
 StyleBox["x\:1d62", "TI"],
 " of a Euclidean space (Schoenberg), the points being the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ResistanceCoordinates"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ResistanceCoordinates", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0621b250-0aa5-4121-a9e6-8ec3be8f55ba"],
 ". Negative type alone is not enough: the distance matrix of a cycle is of \
negative type and not a resistance matrix."
}], "Notes",ExpressionUUID->"5c873f9a-9291-4505-87c6-c0198a68e0e5"],

Cell[TextData[{
 "Each test has the tolerance 10\:207b\:2079: an asymmetry or a diagonal \
entry up to 10\:207b\:2079 counts as 0, as in a computed resistance matrix. A \
matrix with an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b5a03d1b-a980-450d-9bed-e96829c95820"],
 " entry gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3ea02c9e-7a96-4041-8e35-9dd066d6a0aa"],
 "."
}], "Notes",ExpressionUUID->"daecc0a6-6c32-4658-abfc-5bfb64df71a6"],

Cell["On a tree the distance matrix is the resistance matrix.", "Notes",ExpressionUUID->"8fe8305c-4176-447c-b267-6c375b439e4c"]
}, Open  ]],

