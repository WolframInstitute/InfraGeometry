Cell[TextData[{
 "A resistance matrix determines its graph: the Laplacian recovered from it \
is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KirchhoffMatrix"]], "paclet:ref/KirchhoffMatrix"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3ac9aa3c-ac4e-4738-b79d-42ff523d88b5"],
 ", and the conductances it gives are the edges of the graph."
}], "ExampleText",ExpressionUUID->"e31335c2-983d-4678-ae8e-baf3d8e862ad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"PetersenGraph", "[", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"resistances", " ", "=", " ", 
     RowBox[{"EffectiveResistance", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"laplacian", " ", "=", " ", 
     RowBox[{"PseudoInverse", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"IdentityMatrix", "[", "10", "]"}], " ", "-", " ", 
           RowBox[{"1", "/", "10"}]}], ")"}], " ", ".", " ", "resistances", 
         " ", ".", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"IdentityMatrix", "[", "10", "]"}], " ", "-", " ", 
           RowBox[{"1", "/", "10"}]}], ")"}]}]}], "/", "2"}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"AdjacencyGraph", "[", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"Diagonal", "[", "laplacian", "]"}], "]"}], " ", "-", " ", 
        "laplacian"}], "]"}], "]"}], ",", " ", 
     RowBox[{"ResistanceQ", "[", "resistances", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Round", "[", "laplacian", "]"}], " ", "===", " ", 
      RowBox[{"Normal", "[", 
       RowBox[{"KirchhoffMatrix", "[", "g", "]"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c1bda578-37d5-498d-ac64-d952aa0a4364"],

