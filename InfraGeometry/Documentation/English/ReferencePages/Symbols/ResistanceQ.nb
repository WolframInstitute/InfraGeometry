Cell[TextData[{
 "A resistance matrix determines its graph: the matrix ",
 StyleBox["L", "TI"],
 " recovered from the resistances of the mesh is its ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KirchhoffMatrix"]], "paclet:ref/KirchhoffMatrix"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "79e6c160-1fc1-41b7-83a1-cadc95c3c78e"],
 ":"
}], "ExampleText",ExpressionUUID->"abf1cca0-87ad-4b43-8acd-9334d1dade86"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", " ", "=", " ", 
      RowBox[{"EffectiveResistance", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"n", " ", "=", " ", 
      RowBox[{"VertexCount", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "n", "]"}], " ", "-", " ", 
      RowBox[{"1", "/", "n"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"laplacian", " ", "=", " ", 
     RowBox[{"PseudoInverse", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"p", " ", ".", " ", "r", " ", ".", " ", "p"}]}], "/", "2"}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Max", " ", "@", " ", 
     RowBox[{"Abs", "[", 
      RowBox[{"laplacian", " ", "-", " ", 
       RowBox[{"KirchhoffMatrix", "[", "g", "]"}]}], "]"}]}], " ", "<", " ", 
    RowBox[{"10", "^", 
     RowBox[{"-", "9"}]}]}]}], "]"}]], "Input",
