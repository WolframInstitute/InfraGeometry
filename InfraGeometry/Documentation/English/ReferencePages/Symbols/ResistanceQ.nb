Cell["\<\
The distance matrices of the cycles of length 4 and more fail; their \
resistance matrices pass:\
\>", "ExampleText",ExpressionUUID->"263992a6-f870-4ed1-82db-831ca51be471"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ResistanceQ", "[", 
      RowBox[{"GraphDistanceMatrix", "[", 
       RowBox[{"CycleGraph", "[", "n", "]"}], "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "3", ",", " ", "8"}], "}"}]}], "]"}], ",", "\n", 
   " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ResistanceQ", "[", 
      RowBox[{"EffectiveResistance", "[", 
       RowBox[{"CycleGraph", "[", "n", "]"}], "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "3", ",", " ", "8"}], "}"}]}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f2ad3125-7378-4af1-a4d0-0ddf2f1b68ce"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "True", ",", "False", ",", "False", ",", "False", ",", "False", ",", 
     "False"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
    "True", ",", "True", ",", "True", ",", "True", ",", "True", ",", "True"}],
     "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6f14cc2f-7fdf-4303-b067-25636ed3e1ca"]
}, Open  ]],

Cell[TextData[{
 "The matrix ",
 StyleBox["L", "TI"],
 " that the distance matrix of the 5-cycle determines gives each edge the \
conductance 8/5 and each chord the negative conductance \[Minus]2/5:"
}], "ExampleText",ExpressionUUID->"9e2cfb3b-068c-4c11-8cc2-9cb7e40fe5c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"r", " ", "=", " ", 
     RowBox[{"GraphDistanceMatrix", "[", 
      RowBox[{"CycleGraph", "[", "5", "]"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "5", "]"}], " ", "-", " ", 
      RowBox[{"1", "/", "5"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"MatrixForm", " ", "@", " ", 
    RowBox[{"PseudoInverse", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"p", " ", ".", " ", "r", " ", ".", " ", "p"}]}], "/", "2"}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"2ecbb4a9-17fb-4296-b808-93e37bda8453"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      FractionBox["12", "5"], 
      RowBox[{"-", 
       FractionBox["8", "5"]}], 
      FractionBox["2", "5"], 
      FractionBox["2", "5"], 
      RowBox[{"-", 
       FractionBox["8", "5"]}]},
     {
      RowBox[{"-", 
       FractionBox["8", "5"]}], 
      FractionBox["12", "5"], 
      RowBox[{"-", 
       FractionBox["8", "5"]}], 
      FractionBox["2", "5"], 
      FractionBox["2", "5"]},
     {
      FractionBox["2", "5"], 
      RowBox[{"-", 
       FractionBox["8", "5"]}], 
      FractionBox["12", "5"], 
      RowBox[{"-", 
       FractionBox["8", "5"]}], 
      FractionBox["2", "5"]},
     {
      FractionBox["2", "5"], 
      FractionBox["2", "5"], 
      RowBox[{"-", 
       FractionBox["8", "5"]}], 
      FractionBox["12", "5"], 
      RowBox[{"-", 
       FractionBox["8", "5"]}]},
     {
      RowBox[{"-", 
       FractionBox["8", "5"]}], 
      FractionBox["2", "5"], 
      FractionBox["2", "5"], 
      RowBox[{"-", 
       FractionBox["8", "5"]}], 
      FractionBox["12", "5"]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"e827cbe7-76eb-41de-bfaf-5daf3cd6d379"]
}, Open  ]],

Cell["\<\
The computed resistance matrix of the square grid is symmetric only up to \
rounding, and passes:\
\>", "ExampleText",ExpressionUUID->"dfebdba5-fd75-45bf-b321-457927761f36"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"r", " ", "=", " ", 
     RowBox[{"EffectiveResistance", "[", 
      RowBox[{"InfraSubstrate", "[", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Max", " ", "@", " ", 
      RowBox[{"Abs", "[", 
       RowBox[{"r", " ", "-", " ", 
        RowBox[{"Transpose", "[", "r", "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"ResistanceQ", "[", "r", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"f2c3504a-5304-4e0d-bc7b-8eeff9c25f5e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4.707345624410664`*^-14", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"097bc2f5-5551-403c-b37e-af06d103eb5e"]
}, Open  ]]
}, Open  ]],

