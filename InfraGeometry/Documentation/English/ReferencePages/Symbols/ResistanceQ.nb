Cell["\<\
The distance matrix of the square tiling passes too, though the Laplacian it \
determines has 4276 positive entries off the diagonal.\
\>", "ExampleText",ExpressionUUID->"40708948-2a3d-445b-b82d-eacbfd78ded0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"hops", " ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"GraphDistanceMatrix", "[", "g", "]"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"laplacian", " ", "=", " ", 
     RowBox[{"PseudoInverse", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"IdentityMatrix", "[", "113", "]"}], " ", "-", " ", 
           RowBox[{"1", "/", "113"}]}], ")"}], " ", ".", " ", "hops", " ", ".",
          " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"IdentityMatrix", "[", "113", "]"}], " ", "-", " ", 
           RowBox[{"1", "/", "113"}]}], ")"}]}]}], "/", "2"}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MatrixPlot", "[", 
      RowBox[{
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Diagonal", "[", "laplacian", "]"}], "]"}], " ", "-", " ", 
       "laplacian"}], "]"}], ",", " ", 
     RowBox[{"ResistanceQ", "[", "hops", "]"}], ",", " ", 
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"laplacian", " ", "-", " ", 
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{"Diagonal", "[", "laplacian", "]"}], "]"}]}], "]"}], ",", 
       " ", 
       RowBox[{"_", "?", 
        RowBox[{"(", 
         RowBox[{
