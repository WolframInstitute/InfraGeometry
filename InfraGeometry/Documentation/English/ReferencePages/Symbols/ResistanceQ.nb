Cell["\<\
The resistance matrices of the square, hexagonal and triangular tilings pass.\
\
\>", "ExampleText",ExpressionUUID->"7124b5a2-98c3-4ad7-969e-21a20fa34dac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graphs", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"#", ",", " ", "\"\<Small\>\"", ",", " ", 
         RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}],
        " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", "graphs", "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"ResistanceQ", "[", 
        RowBox[{"EffectiveResistance", "[", "#", "]"}], "]"}], " ", "&"}], 
      " ", "/@", " ", "graphs"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f4146272-0d54-443b-816c-ba82493b81b7"],

