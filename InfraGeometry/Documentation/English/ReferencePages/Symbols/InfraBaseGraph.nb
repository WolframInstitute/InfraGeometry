Cell["The compatibility reader accepts a canonical fibered graph.", \
"ExampleText",ExpressionUUID->"412d699e-c0d3-416d-b986-014392492676"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}], ",", " ", 
       RowBox[{"vertex", " ", "|->", " ", 
        RowBox[{"Mod", "[", " ", 
         RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
      " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"InfraBaseGraph", "[", " ", "fib", " ", "]"}]}], " ", 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1d66ccb2-3583-4537-9e2a-80d4661fadd9"],

