Cell["\<\
The base of the grid tangent bundle is the grid it was built on.\
\>", "ExampleText",ExpressionUUID->"b4bedcbb-0297-4e55-9e46-4f63d2f01d2d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridTangentBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
