Cell["The compatibility reader accepts a canonical fibered graph.", \
"ExampleText",ExpressionUUID->"66f01489-0187-4988-a37f-cc19535b4e0a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}], ",", " ", 
       RowBox[{"vertex", " ", "|->", " ", 
        RowBox[{"Mod", "[", " ", 
         RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
      " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"InfraBaseGraph", "[", " ", "fib", " ", "]"}]}], " ", 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5eedbade-0988-458a-a0da-78025b8ca55e"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3, 4}, {Null, {{1, 2}, {1, 4}, {2, 3}, {3, 4}}}]]}, 
    TagBox[
     GraphicsGroupBox[
      GraphicsComplexBox[{{-1., 
       1.0106430996148606`*^-15}, {-7.044813998280222*^-16, 1.}, {
       1., -1.133107779529596*^-15}, {6.049014748177263*^-16, -1.}}, {
        {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], Arrowheads[0.], 
         ArrowBox[{{1, 2}, {1, 4}, {2, 3}, {3, 4}}, 0.02261146496815286]}, 
        {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
         DiskBox[1, 0.02261146496815286], DiskBox[2, 0.02261146496815286], 
         DiskBox[3, 0.02261146496815286], DiskBox[4, 0.02261146496815286]}}]],
     
     MouseAppearanceTag["NetworkGraphics"]],
    AllowKernelInitialization->False]],
  DefaultBaseStyle->"NetworkGraphics",
  FormatType->TraditionalForm,
  FrameTicks->None]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"13bed00b-66fd-48b6-8a90-2b2dbbac8dd3"]
