Cell["\<\
The successive shells around the centre of the square grid: nested rings, \
each of 4r vertices, and none of them carrying a cycle.\
\>", "ExampleText",ExpressionUUID->"ad50086b-940c-49cd-9e9a-15b523ee44ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraHighlightGraph", "[", 
    RowBox[{"g", ",", "\n", "    ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"FindInfraShell", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}], " ", "->", " ", 
        "$InfraShellColor"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "1", ",", " ", "5"}], "}"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "13"}], ",", "\n", 
     "    ", 
     RowBox[{"VertexShapeFunction", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
          RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}], ",",
      "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "340"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"6145a100-514f-4cb3-bd5a-db166fc44895"],

