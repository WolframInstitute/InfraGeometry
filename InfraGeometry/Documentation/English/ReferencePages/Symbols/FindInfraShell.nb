Cell["\<\
Shell cardinality against radius. On both lattices the growth is exactly \
linear \[LongDash] 4r on the square grid, 3r on the hexagonal \[LongDash] \
which is the intrinsic statement that these substrates are two-dimensional.\
\>", "ExampleText",ExpressionUUID->"024e7189-70c4-481e-b018-329b6679f5a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Length", " ", "@", " ", 
          RowBox[{"FindInfraShell", "[", 
           RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], 
      "]"}]}], ",", "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
