Cell["\<\
Shell size against radius. On the three lattices the growth is linear, the \
intrinsic statement that these substrates are two-dimensional; the slope \
belongs to the tiling: 4 on the square, 3 on the hexagonal, 6 on the \
triangular.\
\>", "ExampleText",ExpressionUUID->"1ccf7c93-42f2-4be7-bcaa-f895a28b5e1c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"names", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
       " ", "\"\<HexagonalTilingGraph\>\"", ",", 
       " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"ListLinePlot", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"name", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], ",",
          " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Length", " ", "@", " ", 
            RowBox[{"FindInfraShell", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "r"}], 
             "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"r", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", "names"}], "}"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"DataRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "6"}], "}"}]}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", "names"}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<r\>\"", ",", " ", "\"\<|S_r|\>\""}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"56decb12-9bd6-4e0f-8b1f-b93c731f9634"],

