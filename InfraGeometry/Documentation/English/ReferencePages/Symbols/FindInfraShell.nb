Cell["\<\
The ball is the union of the shells up to its radius, so the volumes are the \
partial sums of the areas.\
\>", "ExampleText",ExpressionUUID->"7efef958-bae9-4a78-8165-d42735734ee2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"areas", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"FindInfraShell", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"volumes", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"FindInfraBall", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Accumulate", "[", "areas", "]"}], " ", "===", " ", "volumes"}]}],
   "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9114db58-62c2-43cc-acac-612f0c408846"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"99591f19-f509-44cb-bcae-567b68ba891c"]
}, Open  ]],

Cell[TextData[{
 "The shell sizes are the shell-area profile of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ShellAreas"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ShellAreas", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d6e2e1b5-f21c-436f-a920-cb054a1919fa"],
 "."
}], "ExampleText",ExpressionUUID->"0e63def1-754c-4486-a19e-96391c6fc83a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], " ", "===",
     " ", 
    RowBox[{"ShellAreas", "[", 
     RowBox[{"g", ",", " ", "c", ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "5"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"97a4f9b4-48f7-433a-8721-102e785db0a3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"fd0b0d37-cb62-46e5-8301-ff1c421ef580"]
