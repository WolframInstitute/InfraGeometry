Notebook[{

Cell[CellGroupData[{
Cell["FindInfraShell", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bf5d17de-8ff8-4aba-a5c9-4cdb7010669c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fca073ae-4e71-4d55-b8d5-50e3593e95e7"],
 "\[LineSeparator]",
 "gives the metric shell ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["v", "TI"], ":", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["c", "TI"], ",", 
       StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
     StyleBox["r", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb79a5e8-2f43-4bc5-8890-30f1df74cfe9"],
 " around ",
 StyleBox["c", "TI"],
 " as a sorted vertex list. ",
 StyleBox["r", "TI"],
 " may be a band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"rmin", ",", " ", "rmax"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef99a4b7-c116-469d-a627-efed41660e22"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"35867a35-4a57-435d-861b-3eef1ba8410b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "828f4ae4-e0d7-4927-b88a-38aed51b9f64"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a99804e9-d554-412c-b398-8a63e736e477"],
 " of exactly ",
 StyleBox["n", "TI"],
 " vertex sets or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad42525d-105a-4ab3-b0ce-5a595fea70b3"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f4470af-cec4-40d7-97a0-9927559d9df2"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "514c47e0-c99f-4d8e-8308-e3efeedc3e3b"],
 " gives all of them. Under the default ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "955b5fab-f213-4950-ab5a-f3501b4beeb7"],
 " the level set is the one vertex set."
}], "Usage",ExpressionUUID->"bc24a088-b969-4249-9aa1-eb21532353c6"],

Cell[TextData[{
 "The shell of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["v", "TI"], ":", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["c", "TI"], ",", 
       StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
     StyleBox["r", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c71923a0-4957-4688-977b-868d62e3df3c"],
 " \[LongDash] the sphere of the graph metric, as a vertex ",
 StyleBox["set",
  FontWeight->"Bold"],
 "."
}], "Notes",ExpressionUUID->"8fa76690-a6b7-41d7-a280-e2c9b640d029"],

Cell[TextData[{
 "It is the discrete analogue of a sphere, not of a circle: it is \
codimension-1 as a set, but on a lattice its vertices are pairwise \
non-adjacent, so it carries no cycle. The cyclic object is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9e1189bc-c5ac-44d6-ada8-fb845cf2195d"],
 ", which needs a thickened band for exactly that reason."
}], "Notes",ExpressionUUID->"3fcf900b-113d-446e-8633-51f791e12c85"],

Cell[TextData[{
 "The shell is the substrate of the volume-growth invariants. Its cardinality \
as a function of ",
 StyleBox["r", "TI"],
 " is the surface-area profile, which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ShellAreas"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ShellAreas", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f44f7f5a-2751-4117-b65b-5f6b57f81ec1"],
 " counts at every radius at once, and on a flat lattice it grows ",
 StyleBox["linearly",
  FontWeight->"Bold"],
 ", which is the statement that the dimension is 2. The slope is a property \
of the tiling: 4 per step on the square grid, 3 on the hexagonal."
}], "Notes",ExpressionUUID->"5e060115-121b-4446-b9a3-e59857da1e92"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21fa59e1-bf96-4103-a862-d292ba42ce00"],
 " takes ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4149a07a-b8ca-4440-ae29-988bf79139c5"],
 " (default; the whole level set as one vertex set), ",
 Cell[BoxData[
  RowBox[{"{", "\"\<Separating\>\"", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7c99d78-d5c5-4744-a685-4a1363f185ef"],
 " (inclusion-minimal subsets separating the centre from beyond), or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d791fda5-6f30-4bd5-8ea6-3d585523a6c3"],
 ". Option ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f517b35-b171-4998-a8cc-00c63aafbd06"],
 " takes ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19fd69c2-e591-4489-a355-fffb5577d5ca"],
 " (default), ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1f93561-ba58-42de-8a02-003cbe368319"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
    RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a360b32d-06ac-439a-be0b-1d3aaca76244"],
 ", ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a0031a5-0dc6-463a-91ee-e5f5948ba4c9"],
 " or ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bdccb13-f867-4e85-8b3c-c4d3f88dcb1d"],
 ", and is read only when ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bde4fcd7-9d0d-43bf-9c55-a46e6052e91d"],
 " names a class to search: ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d943a9d-219a-4496-aecb-5ff301e09904"],
 " resolves by the count \[LongDash] ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ff4fb47-7e72-4e2c-be00-02d3a9799e88"],
 " to ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4da8e856-62f2-4660-ad07-f7c7f813e955"],
 "; a bounded or absent count to ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd6ac44f-5e85-4fb4-853a-4785e3a4d5ef"],
 ", the lazy peel, so the count-less call is one minimal subset, \
deterministic \[LongDash] and the class is the same under every value. ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bab25d7-a071-4241-85c6-d497069901db"],
 " peels in random order, seeded by an ambient ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9e259c0-7c53-4143-bc46-f0890691427f"],
 "; ",
 Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5820a3f2-b1ce-4e19-9c9f-8cd41c93d406"],
 " caps the removable vertices tried per layer, and the result is then \
minimal among the survivors."
}], "Notes",ExpressionUUID->"d803ea90-21fc-4743-b239-a97a276a9259"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"6190bfd1-1621-4a94-954d-5d8ad75ff46a"],

