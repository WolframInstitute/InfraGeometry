Notebook[{

Cell[CellGroupData[{
Cell["FindInfraShell", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"035cd92e-f348-4142-b062-faf9f902cf99"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ff5d5a0-2e37-4e4d-818e-9c4af4428fbf"],
 "\[LineSeparator]",
 "gives the metric shell ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["v", "TI"], ":", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["c", "TI"], ",", 
       StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
     StyleBox["r", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18d6aec2-971a-4cea-bfb4-07063233aad6"],
 " around ",
 StyleBox["c", "TI"],
 " as a sorted vertex list. ",
 StyleBox["r", "TI"],
 " may be a band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"rmin", ",", " ", "rmax"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3733b52c-f334-4c06-b578-2d93ff4d0bc8"],
 ", and ",
 StyleBox["c", "TI"],
 " a vertex list, with the set distance.",
 "\n"
}], "Usage",ExpressionUUID->"67f516ca-6b42-44a3-9ede-314decc18d06"],

Cell[TextData[{
 "The shell of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["v", "TI"], ":", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["c", "TI"], ",", 
       StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
     StyleBox["r", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9164917b-a70f-4652-81dc-27a0e3f728b2"],
 " \[LongDash] the sphere of the graph metric, as a vertex ",
 StyleBox["set",
  FontWeight->"Bold"],
 "."
}], "Notes",ExpressionUUID->"d8a66bc7-fae9-4ac2-996c-9c5f4357d1e0"],

Cell[TextData[{
 "It is the discrete analogue of a sphere, not of a circle: it is \
codimension-1 as a set, but on a lattice its vertices are pairwise \
non-adjacent, so it carries no cycle. The cyclic object is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "28b02d13-285b-42de-8cb1-25859382ca93"],
 ", which needs a thickened band for exactly that reason."
}], "Notes",ExpressionUUID->"899fd183-d44a-4eae-83a0-10937aa8982f"],

Cell[TextData[{
 "The shell is the substrate of the volume-growth invariants. Its cardinality \
as a function of ",
 StyleBox["r", "TI"],
 " is the surface-area profile, which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5a345670-3c6e-4494-b50a-dcab21eb27a6"],
 " reads as the ",
 Cell[BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce21b501-9751-4f90-bfda-c0b5b25fe675"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2ddc093a-e591-413b-8992-e3bcc9b97503"],
 " at every radius, and on a flat lattice it grows ",
 StyleBox["linearly",
  FontWeight->"Bold"],
 ", which is the statement that the dimension is 2. The slope is a property \
of the tiling: 4 per step on the square grid, 3 on the hexagonal."
}], "Notes",ExpressionUUID->"3b1f90cc-4bd3-450f-8e27-f55956f89f57"],

Cell[TextData[{
 "It is the level set of the inert head ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraShell"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraShell", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "74e7d4bc-d659-4c9e-8937-4aaca89e423d"],
 ", as a function. The connected subsets of a shell that separate the centre \
from the outside are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cad6b666-c6ef-4219-b61e-4499131e7090"],
 "."
}], "Notes",ExpressionUUID->"a6d36921-fff1-4d5d-805c-2767081540d7"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"3f8d4e58-c466-4787-ae53-4d049029e4db"],

