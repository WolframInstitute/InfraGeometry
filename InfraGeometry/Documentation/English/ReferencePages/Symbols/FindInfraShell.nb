Notebook[{

Cell[CellGroupData[{
Cell["FindInfraShell", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6744edb4-06ab-45d8-b7c9-1261ff97005c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af95db37-2393-4482-ae16-30482c2dd6fa"],
 "\[LineSeparator]",
 "gives the metric shell ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["v", "TI"], ":", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["c", "TI"], ",", 
       StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
     StyleBox["r", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "817514e0-464f-497a-9ccb-edee23ec2014"],
 " around ",
 StyleBox["c", "TI"],
 " as a sorted vertex list. ",
 StyleBox["r", "TI"],
 " may be a band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"rmin", ",", " ", "rmax"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20f31ad4-a060-4547-8181-4a47b60baa90"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"83c07b70-b301-4043-b3e8-5fb70449a998"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraShell"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraShell", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4077b95-c46b-425b-9752-998955df3d94"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e80df0a5-26a6-4e44-845c-f731e392a26f"],
 " of exactly ",
 StyleBox["n", "TI"],
 " vertex sets or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebada780-3c86-48aa-a43c-31b8fddc8ab4"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "280d9865-eceb-480f-8f5b-783ccb30cc63"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0468d5bd-c822-4b2f-aa02-b9478b04f308"],
 " gives all of them. Under the default ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb21164f-8aa4-4910-b58a-8463dbe11e00"],
 " the level set is the one vertex set."
}], "Usage",ExpressionUUID->"1b05cf7d-70f9-43e6-9ffb-1f7172ba05f5"],

Cell[TextData[{
 "The shell of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["v", "TI"], ":", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["c", "TI"], ",", 
       StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
     StyleBox["r", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2948945c-14d2-4738-b265-018c9e9deb2f"],
 " \[LongDash] the sphere of the graph metric, as a vertex ",
 StyleBox["set",
  FontWeight->"Bold"],
 "."
}], "Notes",ExpressionUUID->"53891918-f014-435d-9628-2f8a47c35d67"],

Cell[TextData[{
 "It is the discrete analogue of a sphere, not of a circle: it is \
codimension-1 as a set, but on a lattice its vertices are pairwise \
non-adjacent, so it carries no cycle. The cyclic object is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraCircle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraCircle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "09771acd-8493-45cc-823a-0e3d98aacd26"],
 ", which needs a thickened band for exactly that reason."
}], "Notes",ExpressionUUID->"184491fc-f865-4a39-999d-391912f54870"],

Cell[TextData[{
 "The shell is the substrate of the volume-growth invariants. Its cardinality \
as a function of ",
 StyleBox["r", "TI"],
 " is the surface-area profile, which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ShellAreas"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ShellAreas", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "67d636bf-2c8f-4038-b35e-5f676ddd915e"],
 " counts at every radius at once, and on a flat lattice it grows ",
 StyleBox["linearly",
  FontWeight->"Bold"],
 ", which is the statement that the dimension is 2. The slope is a property \
of the tiling: 4 per step on the square grid, 3 on the hexagonal."
}], "Notes",ExpressionUUID->"5fa581bd-8373-448f-9803-42c1a68a8f20"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f77fe931-bc41-43a5-a450-14ac5d1e9ea5"],
 " takes ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa2a4207-d1d2-4dd4-95dc-43701507ec86"],
 " (default; the whole level set as one vertex set), ",
 Cell[BoxData[
  RowBox[{"{", "\"\<Separating\>\"", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1cc00ed-3a9c-4b3e-aa1c-b082d7135aab"],
 " (inclusion-minimal subsets separating the centre from beyond), or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5741467b-1934-4689-b636-161ebf1c11c1"],
 ". Option ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2042eb7-d300-4a6d-b0f0-529ff6905c30"],
 " takes ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9daa55ea-c666-4217-9aa2-6d13a451f6d1"],
 " (default), ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fb3ea78-4d7c-4e6c-80cc-b39038590385"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
    RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd22dc81-307a-4d67-9a4d-10e77c9f0cd8"],
 ", ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2525c7fe-c0ec-43a6-b06b-30167503e8c7"],
 " or ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc5fb429-d13a-4dd4-b7d2-5df99aaf8300"],
 ", and is read only when ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbce8959-512f-49c3-b29f-9abb1bc3f7b6"],
 " names a class to search: ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b0793c7-38ed-4e69-be2c-6eb748de4ce3"],
 " resolves by the count \[LongDash] ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9db845b-57f0-4f17-8427-b538f70b13b9"],
 " to ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9da2357-2372-4474-a802-c66e1c89a1c6"],
 "; a bounded or absent count to ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f77fc282-d07f-4b59-82f1-d8e71cf9b9dc"],
 ", the lazy peel, so the count-less call is one minimal subset, \
deterministic \[LongDash] and the class is the same under every value. ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d67acbf1-39fc-48e8-9ee1-88fc68404d99"],
 " peels in random order, seeded by an ambient ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06d71895-5bbc-4eb6-b5fc-267aad568d94"],
 "; ",
 Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f9a6c49-5262-41c7-bdb5-fa08f7274703"],
 " caps the removable vertices tried per layer, and the result is then \
minimal among the survivors."
}], "Notes",ExpressionUUID->"b34127a5-c8b9-4403-9aa4-f2c2b80e1dfb"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"d2d46f18-705c-4748-8d4c-3de3c08f0e68"],

