Cell["\<\
The ball is the union of the shells up to its radius, so the volumes are the \
partial sums of the areas.\
\>", "ExampleText",ExpressionUUID->"d2774127-bddf-4324-8a08-9b87825240bf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"areas", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"FindInfraShell", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"volumes", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"FindInfraBall", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Accumulate", "[", "areas", "]"}], " ", "===", " ", "volumes"}]}],
   "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"620c79da-b028-4836-b9ee-7a9a01e8ddb6"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"fcaad657-f987-409a-a013-d66cde96d1ff"]
}, Open  ]],

Cell[TextData[{
 "The shell sizes are the shell-area profile of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ShellAreas"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/ShellAreas", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "acd252b3-9865-42ec-845b-d84a2498a9fa"],
 "."
}], "ExampleText",ExpressionUUID->"ae8f2f0a-789a-4ef1-8901-ceef0bc7b751"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], " ", "===",
     " ", 
    RowBox[{"ShellAreas", "[", 
     RowBox[{"g", ",", " ", "c", ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "5"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"72eac5c1-bf9e-49ab-bdac-a5e394ae5b6a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"cd12e4dd-0ff7-4434-9de3-2ac5e2268079"]
