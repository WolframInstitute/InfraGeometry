Cell[TextData[{
 "The integral of ",
 StyleBox["df", "TI"],
 " along every shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " is ",
 StyleBox["f(q) \[Minus] f(p)", "TI"],
 ", and the codifferential of ",
 StyleBox["df", "TI"],
 " is the graph Laplacian of ",
 StyleBox["f", "TI"],
 "."
}], "Notes",ExpressionUUID->"760857e1-93ec-4eee-8cf4-fc7db3ded2e9"]
