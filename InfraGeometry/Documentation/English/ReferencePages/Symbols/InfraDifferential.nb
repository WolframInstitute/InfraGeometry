Cell["InfraDifferential", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b99328b1-4ced-4a7a-ad95-ebfc41f47c50"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDifferential"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDifferential", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["f", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "992d0c8b-30d7-45bf-9b7f-e5bf666cbe54"],
 "\[LineSeparator]",
 "is the differential of the vertex function ",
 StyleBox["f", "TI"],
 ": the 1-form that gives each edge ",
 StyleBox["u \[RightArrow] v", "TI"],
 " the increment ",
 StyleBox["f(v) \[Minus] f(u)", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"963c7352-300e-4672-85ff-e8958fada941"],

Cell[TextData[{
 "The differential is ",
 StyleBox["df(u \[RightArrow] v) = f(v) \[Minus] f(u)", "TI"],
 "."
}], "Notes",ExpressionUUID->"38d1c786-dddc-4c37-b4a6-efba51491561"],

Cell[TextData[{
 StyleBox["f", "TI"],
 " is a 0-form: an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aa6f52d0-ceaf-41f0-9879-7ccaba2d3e0b"],
 " ",
 StyleBox["v", "TI"],
 " -> ",
 StyleBox["x", "TI"],
 ", in which a missing vertex counts as 0, or a function applied to each \
vertex. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCodifferential"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraCodifferential", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5ffbb56b-1f2b-4357-93a1-8794bb32c1bc"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraAntiderivative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraAntiderivative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "639a3397-a804-40c9-a659-17f1373ff227"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDerivative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDerivative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5c4d7715-8293-4fc1-b857-e24f8cda89ed"],
 " are read as their 0-forms."
}], "Notes",ExpressionUUID->"5e30433c-35e5-4c1f-b244-374f00ef23d7"],

Cell[TextData[{
 "The edges that carry ",
 StyleBox["df", "TI"],
 ":"
}], "Notes",ExpressionUUID->"667cdc02-671c-492e-b3af-c6e6462913b0"],

