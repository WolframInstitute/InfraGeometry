Cell[TextData[{
 "The fundamental theorem. Along each of the shortest paths from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " the integral of ",
 StyleBox["df", "TI"],
 " is ",
 StyleBox["f(q) \[Minus] f(p)", "TI"],
 ", so the value density of the integral is one atom:"
}], "ExampleText",ExpressionUUID->"3fe71722-7aca-4764-abf3-fb0391a28e33"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"q", " ", "=", " ", 
      RowBox[{"RandomInfraPoint", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraShell", "[", 
         RowBox[{"p", ",", " ", "5"}], "]"}], ",", " ", 
        RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], ",", " ", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"#", "^", "2"}], ",", " ", "11"}], "]"}], " ", "&"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraIntegral", "[", 
        RowBox[{
         RowBox[{"InfraDifferential", "[", "f", "]"}], ",", " ", 
         RowBox[{"InfraSegment", "[", 
          RowBox[{"p", ",", " ", "q"}], "]"}]}], "]"}], ",", 
       " ", "\"\<ValueDensity\>\""}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"f", "[", "q", "]"}], " ", "-", " ", 
      RowBox[{"f", "[", "p", "]"}]}], ",", "\n", "   ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraSegment", "[", 
        RowBox[{"p", ",", " ", "q"}], "]"}], ",", 
       " ", "\"\<Cardinality\>\""}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6a169692-3fc2-455c-8b79-9c1ae0e51f82"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"2", "\[Rule]", "10"}], "\[RightAssociation]"}], ",", "2", ",", 
   "10"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"5130d9d9-3305-46f8-b154-dda8c5a6fcd3"]
}, Open  ]],

Cell[TextData[{
 "The Leibniz rule ",
 StyleBox["d(fh) = f dh + h df + df dh", "TI"],
 ", with ",
 StyleBox["f", "TI"],
 " and ",
 StyleBox["h", "TI"],
 " read at the tail of each edge. The last term has no continuum \
counterpart:"
}], "ExampleText",ExpressionUUID->"5b8365d4-4c42-4c54-b288-2ff22d73612e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", " ", "=", " ", 
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{"#", ",", " ", "5"}], "]"}], " ", "&"}]}], ",", " ", 
     RowBox[{"h", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{"#", ",", " ", "3"}], "]"}], " ", "-", " ", "1"}], " ", 
       "&"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"df", " ", "=", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraDifferential", "[", "f", "]"}], ",", 
        " ", "\"\<Function\>\""}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"dh", " ", "=", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraDifferential", "[", "h", "]"}], ",", 
        " ", "\"\<Function\>\""}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"dfh", " ", "=", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraDifferential", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"f", "[", "#", "]"}], " ", 
           RowBox[{"h", "[", "#", "]"}]}], " ", "&"}], "]"}], ",", 
        " ", "\"\<Function\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Keys", "[", "dfh", "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"dfh", "[", "#", "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"First", " ", "@", " ", "#"}], "]"}], " ", 
         RowBox[{"dh", "[", "#", "]"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"h", "[", 
          RowBox[{"First", " ", "@", " ", "#"}], "]"}], " ", 
         RowBox[{"df", "[", "#", "]"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"df", "[", "#", "]"}], " ", 
         RowBox[{"dh", "[", "#", "]"}]}]}]}], " ", "&"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"be6e6ee8-9c4f-474b-9934-4259e99f55f1"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"16331d69-bf7b-4e72-b747-dd22bc2012d3"]
}, Open  ]],

Cell[TextData[{
 "The codifferential of the differential is the Laplacian, the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KirchhoffMatrix"]], "paclet:ref/KirchhoffMatrix"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4ac6d218-6d5f-47bb-bebe-83a3daeaf2a3"],
 " applied to ",
 StyleBox["f", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"4db32b4b-3156-47fb-a8cf-1079fc7dc48f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"f", " ", "=", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"#", "^", "2"}], ",", " ", "11"}], "]"}], " ", "&"}], ",", 
       " ", 
       RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{
    RowBox[{"Values", " ", "@", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraCodifferential", "[", 
        RowBox[{"InfraDifferential", "[", "f", "]"}], "]"}], ",", 
       " ", "\"\<Function\>\""}], "]"}]}], " ", "===", "\n", "    ", 
    RowBox[{
     RowBox[{"KirchhoffMatrix", "[", "g", "]"}], " ", ".", " ", 
     RowBox[{"Values", "[", "f", "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"e6a1e577-2d12-4189-aad8-7b1254446cdc"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"40aa65aa-689e-4903-b88d-fdfbfd0a9e39"]
}, Open  ]],

Cell[TextData[{
 "The edges on which the differential of the distance from ",
 StyleBox["c", "TI"],
 " is not 0, oriented the way it grows, are the edges of the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SprayGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/SprayGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2e9e2e56-d563-485e-ac9b-cd2324fa09f5"],
 " of ",
 StyleBox["c", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"b8095bca-32c6-4331-b22b-2543d37bcbf6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"df", " ", "=", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraDifferential", "[", 
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "&"}], 
        "]"}], ",", " ", "\"\<Function\>\""}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Keys", " ", "@", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"df", ",", " ", "Positive"}], "]"}]}], ",", " ", 
       RowBox[{"Reverse", " ", "/@", " ", 
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"Select", "[", 
          RowBox[{"df", ",", " ", "Negative"}], "]"}]}]}]}], "]"}]}], " ", "===",
     "\n", "    ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"EdgeList", " ", "@", " ", 
      RowBox[{"SprayGraph", "[", 
       RowBox[{"g", ",", " ", "c"}], "]"}]}]}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"c2612728-9697-4268-b358-1dc0647d44f0"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"598677c7-9873-44a4-aa59-b7d780bff1e1"]
}, Open  ]],

Cell[TextData[{
 "On a directed acyclic graph the differential sees the order, not the edges \
that encode it. The ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TransitiveClosureGraph"]], "paclet:ref/TransitiveClosureGraph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "55567eb7-8d9a-45dc-854d-17770717c5e0"],
 ", which adds every implied edge, gives the same 1-form on the same links:"
}], "ExampleText",ExpressionUUID->"9892dff2-f22f-486d-aa11-bf8aa83a8c54"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dag", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"2", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"1", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"1", " ", "->", " ", "4"}], ",", " ", 
        RowBox[{"4", " ", "->", " ", "5"}], ",", " ", 
        RowBox[{"3", " ", "->", " ", "5"}], ",", " ", 
        RowBox[{"5", " ", "->", " ", "6"}], ",", " ", 
        RowBox[{"1", " ", "->", " ", "6"}]}], "}"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"df", " ", "=", " ", 
     RowBox[{"InfraDifferential", "[", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"1", " ", "->", " ", "5"}], ",", " ", 
        RowBox[{"2", " ", "->", " ", 
         RowBox[{"-", "2"}]}], ",", " ", 
        RowBox[{"3", " ", "->", " ", "7"}], ",", " ", 
        RowBox[{"4", " ", "->", " ", "1"}], ",", " ", 
        RowBox[{"5", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"6", " ", "->", " ", 
         RowBox[{"-", "4"}]}]}], "|>"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"dag", ",", " ", "df", ",", " ", "\"\<Function\>\""}], "]"}], ",",
      "\n", "   ", 
     RowBox[{
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"dag", ",", " ", "df", ",", " ", "\"\<Function\>\""}], "]"}], 
      " ", "===", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{
        RowBox[{"TransitiveClosureGraph", "[", "dag", "]"}], ",", " ", "df", ",",
         " ", "\"\<Function\>\""}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"e3aecadb-95a0-4625-b30f-894b4d87dd66"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "\[DirectedEdge]", "2"}], "\[Rule]", 
      RowBox[{"-", "7"}]}], ",", 
     RowBox[{
      RowBox[{"1", "\[DirectedEdge]", "4"}], "\[Rule]", 
      RowBox[{"-", "4"}]}], ",", 
     RowBox[{
      RowBox[{"2", "\[DirectedEdge]", "3"}], "\[Rule]", "9"}], ",", 
     RowBox[{
      RowBox[{"3", "\[DirectedEdge]", "5"}], "\[Rule]", 
      RowBox[{"-", "4"}]}], ",", 
     RowBox[{
      RowBox[{"4", "\[DirectedEdge]", "5"}], "\[Rule]", "2"}], ",", 
     RowBox[{
      RowBox[{"5", "\[DirectedEdge]", "6"}], "\[Rule]", 
      RowBox[{"-", "7"}]}]}], "\[RightAssociation]"}], ",", "True"}], 
  "}"}]], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"9bbb5b33-b242-4cbb-a77e-1b304b653309"]
}, Open  ]]
}, Open  ]],

