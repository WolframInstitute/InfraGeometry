Cell[TextData[{
 "On a directed acyclic graph an implied edge ",
 StyleBox["u \[RightArrow] w", "TI"],
 ", which a longer chain also joins, carries no value. Adding or removing \
implied edges leaves ",
 StyleBox["df", "TI"],
 " unchanged."
}], "Notes",ExpressionUUID->"13867aa8-46ef-488b-88d4-a52d66e20665"],

Cell[TextData[{
 "A 1-form is read antisymmetrically, ",
 StyleBox["\[Omega](v \[RightArrow] u) = \[Minus]\[Omega](u \[RightArrow] v)",
   "TI"],
 ", so an edge may be named in either orientation."
}], "Notes",ExpressionUUID->"5ed0f73f-48c8-452e-b86c-363bf149f507"],

