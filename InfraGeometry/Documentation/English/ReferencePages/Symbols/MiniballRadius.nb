Cell[TextData[{
 "The disks of radius ",
 StyleBox["r", "TI"],
 " about the corners of the acute triangle have a common point exactly from \
",
 StyleBox["r = \[Rho]", "TI"],
 " on. At ",
 StyleBox["0.9 \[Rho]", "TI"],
 " they miss; at ",
 StyleBox["\[Rho]", "TI"],
 " they meet in the centre of the circumcircle:"
}], "ExampleText",ExpressionUUID->"e8431c48-1d1c-4aee-b79c-7ef49320b9fd"],

