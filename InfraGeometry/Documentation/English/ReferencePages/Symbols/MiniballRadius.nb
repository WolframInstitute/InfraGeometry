Cell[TextData[{
 "The corners of the unit cube have radius ",
 StyleBox["\[Sqrt]3/2", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"02ade2a0-7893-4b05-9acf-7fe8389718a9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "3"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Point", "[", "corners", "]"}], ",", " ", "StandardRed", ",", 
        " ", 
        RowBox[{"Opacity", "[", "0.2", "]"}], ",", " ", 
        RowBox[{"BoundingRegion", "[", 
         RowBox[{"corners", ",", " ", "\"\<MinBall\>\""}], "]"}]}], "}"}], 
      "]"}], ",", " ", 
     RowBox[{"MiniballRadius", "[", "corners", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e410ed5a-dbb7-4476-ae1d-c8ccbafc579e"],

