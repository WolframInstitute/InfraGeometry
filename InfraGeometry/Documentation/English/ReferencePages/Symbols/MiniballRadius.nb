Cell["\<\
The lattice points of the ball of radius 3 of the square grid, and their \
smallest enclosing circle. Its radius is 3, the distance from the centre to \
the four corners:\
\>", "ExampleText",ExpressionUUID->"1c74efed-ff08-43fd-9f95-d57f1c02c847"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "3"}], ",", " ", "3"}], "]"}], ",", " ", "2"}], "]"}],
        ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"Abs", "[", "#", "]"}], "]"}], " ", "<=", " ", "3"}], " ", 
        "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Graphics", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Point", "[", "points", "]"}], ",", " ", "StandardRed", ",", 
       " ", 
       RowBox[{"Circle", " ", "@@", " ", 
        RowBox[{"BoundingRegion", "[", 
         RowBox[{
          RowBox[{"N", " ", "@", " ", "points"}], ",", 
          " ", "\"\<MinBall\>\""}], "]"}]}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"MiniballRadius", "[", "points", "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9ea0f599-9cde-44c6-b3e1-53d03774dc88"],

Cell[BoxData[
 GraphicsBox[{
   PointBox[{{-3, 0}, {-2, -1}, {-2, 0}, {-2, 1}, {-1, -2}, {-1, -1}, {-1, 
    0}, {-1, 1}, {-1, 2}, {0, -3}, {0, -2}, {0, -1}, {0, 0}, {0, 1}, {0, 2}, {
    0, 3}, {1, -2}, {1, -1}, {1, 0}, {1, 1}, {1, 2}, {2, -1}, {2, 0}, {2, 
    1}, {3, 0}}], 
   {RGBColor[0.93, 0.27, 0.27], CircleBox[{0., 0.}, 3.]}},
  ImageSize->Medium,
  PlotLabel->FormBox["3.`", TraditionalForm]]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"16f00da3-1528-4a1e-ae31-c36ed152afc2"]
}, Open  ]],

Cell["\<\
An acute and an obtuse triangle with the same longest side. The obtuse one \
fits in the circle on its longest side, drawn blue; the acute one needs its \
circumcircle:\
\>", "ExampleText",ExpressionUUID->"4b141648-59c7-48a2-a1ac-e3ba8ec3142c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"acute", " ", "=", " ", 
      RowBox[{"N", " ", "@", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1.5"}], "}"}]}], "}"}]}]}], ",", " ", 
     RowBox[{"obtuse", " ", "=", " ", 
      RowBox[{"N", " ", "@", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0.4"}], "}"}]}], "}"}]}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"Append", "[", 
            RowBox[{"t", ",", " ", 
             RowBox[{"First", "[", "t", "]"}]}], "]"}], "]"}], ",", " ", 
          "StandardRed", ",", " ", 
          RowBox[{"Circle", " ", "@@", " ", 
           RowBox[{"BoundingRegion", "[", 
            RowBox[{"t", ",", " ", "\"\<MinBall\>\""}], "]"}]}], ",", "\n", 
          "      ", "StandardBlue", ",", " ", 
          RowBox[{"Circle", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", "1"}], "]"}]}], 
         "}"}], ",", "\n", "      ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"MiniballRadius", "[", "t", "]"}]}]}], "]"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", 
        RowBox[{"{", 
         RowBox[{"acute", ",", " ", "obtuse"}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9c055f0a-1b41-45ec-b331-cf6269c123a6"],

