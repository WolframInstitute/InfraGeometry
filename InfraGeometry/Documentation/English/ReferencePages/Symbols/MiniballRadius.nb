Cell["\<\
The three disks about the corners of the acute triangle have no common point \
at nine tenths of the radius, and touch at one point at the radius. The \
triangle is a simplex of the \[CapitalCHacek]ech complex only from that \
radius on.\
\>", "ExampleText",ExpressionUUID->"8d4b27d3-303f-435c-a147-c4c6c9a85f6a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1.5"}], "}"}]}], "}"}]}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"rho", " ", "=", " ", 
     RowBox[{"MiniballRadius", "[", "points", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"StandardBlue", ",", " ", 
              RowBox[{"Opacity", "[", "0.15", "]"}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Disk", "[", 
                 RowBox[{"#", ",", " ", "s"}], "]"}], " ", "&"}], " ", "/@", 
               " ", "points"}]}], "}"}], ",", " ", 
            RowBox[{"Point", "[", "points", "]"}]}], "}"}], ",", " ", 
