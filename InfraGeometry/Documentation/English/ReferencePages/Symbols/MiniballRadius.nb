Cell["\<\
Seven random points in the plane and their smallest enclosing circle.\
\>", "ExampleText",ExpressionUUID->"6132b49c-aacb-41c1-8f39-dd40dce476d0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"7", ",", " ", "2"}], "}"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Point", "[", "points", "]"}], ",", " ", "StandardRed", ",", 
        " ", 
        RowBox[{"Circle", " ", "@@", " ", 
         RowBox[{"BoundingRegion", "[", 
          RowBox[{"points", ",", " ", "\"\<MinBall\>\""}], "]"}]}]}], "}"}], 
      "]"}], ",", " ", 
     RowBox[{"MiniballRadius", "[", "points", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6bec5880-8c86-4daa-95ae-d212a94af071"],

