Cell[TextData[{
 "A single point gives a tiny positive radius rather than 0, the radius of \
the ball that ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BoundingRegion"]], "paclet:ref/BoundingRegion"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "579f3cb6-46c3-4b5a-b88c-5fdc980d1cc9"],
 " returns. Two equal points give 0."
}], "ExampleText",ExpressionUUID->"57a68c8f-98c9-45cc-a39e-5b04637c3363"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"MiniballRadius", "[", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0"}], "}"}], "}"}], "]"}], ",", " ", 
   RowBox[{"MiniballRadius", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], "]"}]}], "}"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"be5f3a4c-2507-4fc5-8a4e-cd9c3f44e5d7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1.`*^-323", ",", "0.`"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"5b4b6463-8bf1-4424-8803-bb2573dc35df"]
}, Open  ]],

Cell[TextData[{
 "The points are converted to machine numbers first. On exact coordinates ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BoundingRegion"]], "paclet:ref/BoundingRegion"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d0ff7d39-f5c9-422c-879a-eee29569a73b"],
 " can return a ball that misses some of the points: for the corners of the \
cube it returns the ball about one face."
}], "ExampleText",ExpressionUUID->"04822360-a57e-4f51-a11e-ed4ddf2c290a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "3"}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"BoundingRegion", "[", 
      RowBox[{"corners", ",", " ", "\"\<MinBall\>\""}], "]"}], ",", " ", 
     RowBox[{"BoundingRegion", "[", 
      RowBox[{
       RowBox[{"N", " ", "@", " ", "corners"}], ",", " ", "\"\<MinBall\>\""}],
       "]"}], ",", " ", 
     RowBox[{"MiniballRadius", "[", "corners", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0d1634a1-3fe8-491b-a289-78874a4ecd6b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Ball", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       FractionBox["1", "2"], ",", 
       FractionBox["1", "2"]}], "}"}], ",", 
     FractionBox["1", 
      SqrtBox["2"]]}], "]"}], ",", 
   RowBox[{"Ball", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.5`", ",", "0.5`", ",", "0.5`"}], "}"}], ",", 
     "0.8660254037844386`"}], "]"}], ",", "0.8660254037844386`"}], 
  "}"}]], "Output",
