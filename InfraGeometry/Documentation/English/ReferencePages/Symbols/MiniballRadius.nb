Cell[TextData[{
 "The corners of the unit cube have radius ",
 StyleBox["\[Sqrt]3/2", "TI"],
 ":"
}], "ExampleText",ExpressionUUID->"e74a1682-3207-44cd-98a5-d8652def6fc6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "3"}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"Graphics3D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Point", "[", "corners", "]"}], ",", " ", "StandardRed", ",", 
       " ", 
       RowBox[{"Opacity", "[", "0.2", "]"}], ",", " ", 
       RowBox[{"BoundingRegion", "[", 
        RowBox[{
         RowBox[{"N", " ", "@", " ", "corners"}], ",", 
         " ", "\"\<MinBall\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"MiniballRadius", "[", "corners", "]"}]}]}], "]"}]}], 
