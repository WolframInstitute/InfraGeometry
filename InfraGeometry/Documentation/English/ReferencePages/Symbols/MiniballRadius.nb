Cell[CellGroupData[{
Cell["MiniballRadius", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"57c12452-4242-434b-af4e-9d1ed5c96791"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MiniballRadius"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/MiniballRadius", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["points", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb9aa7a0-0d7d-483a-a2fa-458cfbac3f1f"],
 "\[LineSeparator]",
 "gives the radius of the smallest closed ball that contains the Euclidean ",
 StyleBox["points", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"4066a96c-e277-4963-a5f3-668e2084cb56"],

Cell[TextData[{
 "The radius is ",
 StyleBox["\[Rho](P) = min\:2093 max\:1d62 |x \[Minus] p\:1d62|", "TI"],
 ". The point ",
 StyleBox["x", "TI"],
 " attaining it is the centre of ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["BoundingRegion",
    BaseStyle->"Link"], "[", 
   RowBox[{
    RowBox[{
     ButtonBox["N",
      BaseStyle->"Link"], "[", 
     StyleBox["points", "TI"], "]"}], ",", " ", "\"\<MinBall\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77809b78-50e0-4dae-8cb5-36a626831caa"],
 "."
}], "Notes",ExpressionUUID->"c5e58018-e7f5-4d13-a4f8-dd7ecac7f06a"],

Cell[TextData[{
 "The balls of radius ",
 StyleBox["r", "TI"],
 " about the points have a common point exactly when ",
 StyleBox["r \[GreaterEqual] \[Rho](P)", "TI"],
 ": a common point is the centre of a ball of radius ",
 StyleBox["r", "TI"],
 " that holds them all. That is the test of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CechComplex"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CechComplex", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d2ad099d-4930-46bd-80f7-409e1c09d2b6"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallIntersectionComplex"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "72eb45fc-0963-49a6-9f07-e31570e81f9e"],
 " for Euclidean points."
}], "Notes",ExpressionUUID->"fad138fc-3258-4e42-b29d-ed05b386d293"],

Cell["\<\
One point has radius 0. For a triangle without an obtuse angle the radius is \
the circumradius; for an obtuse triangle it is half the longest side. The \
points may lie in any dimension.\
\>", "Notes",ExpressionUUID->"c9010c3c-307d-4757-a408-6ba131ed9379"],

Cell["\<\
The result is a machine number, except the exact 0 for a single point.\
\>", "Notes",ExpressionUUID->"c7df672b-d778-41a5-a567-635f413c15f7"]
}, Open  ]],

