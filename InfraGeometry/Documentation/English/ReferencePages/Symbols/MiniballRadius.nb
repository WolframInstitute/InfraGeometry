Cell[TextData[{
 "The points are converted to machine numbers first. On exact coordinates ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BoundingRegion"]], "paclet:ref/BoundingRegion"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "89ba7164-a318-4746-95c5-460572f7f98e"],
 " can return a ball that misses some of the points: for the corners of the \
cube it returns the ball about one face."
}], "ExampleText",ExpressionUUID->"8e3bb5eb-42ff-4512-b4a7-58bbcfd04983"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
