Cell[TextData[{
 "The corners of the unit cube have radius ",
 StyleBox["\[Sqrt]3/2", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"77b32775-5431-4d71-bb81-7ebbf58fcf39"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "3"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Point", "[", "corners", "]"}], ",", " ", "StandardRed", ",", 
        " ", 
        RowBox[{"Opacity", "[", "0.2", "]"}], ",", " ", 
        RowBox[{"BoundingRegion", "[", 
         RowBox[{"corners", ",", " ", "\"\<MinBall\>\""}], "]"}]}], "}"}], 
      "]"}], ",", " ", 
     RowBox[{"MiniballRadius", "[", "corners", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8266a1e6-e827-4bcc-899b-51d0a4195f31"],

Cell[BoxData[
 RowBox[{"{", 
