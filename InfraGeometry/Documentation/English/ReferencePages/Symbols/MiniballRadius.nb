Cell["\<\
An acute and an obtuse triangle with the same longest side, the circle on \
that side in blue and the smallest enclosing circle in red. The obtuse \
triangle fits in the circle on its longest side; the acute one needs its \
circumcircle.\
\>", "ExampleText",ExpressionUUID->"34e78a55-bd3b-496e-8b2a-995f1a76520b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"acute", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1.5"}], "}"}]}], "}"}]}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"obtuse", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0.4"}], "}"}]}], "}"}]}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", "\n", "     ", 
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"Append", "[", 
             RowBox[{"t", ",", " ", 
              RowBox[{"First", "[", "t", "]"}]}], "]"}], "]"}], ",", " ", 
           "StandardRed", ",", " ", 
           RowBox[{"Circle", " ", "@@", " ", 
            RowBox[{"BoundingRegion", "[", 
             RowBox[{"t", ",", " ", "\"\<MinBall\>\""}], "]"}]}], ",", " ", 
           "StandardBlue", ",", " ", 
           RowBox[{"Circle", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", "1"}], "]"}]}], 
          "}"}], "]"}], ",", "\n", "     ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", 
          RowBox[{"{", 
           RowBox[{"acute", ",", " ", "obtuse"}], "}"}]}], "}"}]}], "]"}]}], ",",
      "\n", "   ", 
     RowBox[{"MiniballRadius", " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"acute", ",", " ", "obtuse"}], "}"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0187c0df-1dde-43bd-b784-2f69a982d631"],

