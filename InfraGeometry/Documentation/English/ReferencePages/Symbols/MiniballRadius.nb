Cell["\<\
Seven random points in the plane and their smallest enclosing circle.\
\>", "ExampleText",ExpressionUUID->"c6bc05fd-307e-41c2-a306-660eaabae818"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"7", ",", " ", "2"}], "}"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Point", "[", "points", "]"}], ",", " ", "StandardRed", ",", 
        " ", 
        RowBox[{"Circle", " ", "@@", " ", 
         RowBox[{"BoundingRegion", "[", 
          RowBox[{"points", ",", " ", "\"\<MinBall\>\""}], "]"}]}]}], "}"}], 
      "]"}], ",", " ", 
     RowBox[{"MiniballRadius", "[", "points", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fb248ab8-9372-4c0c-8950-d008156f79a4"],

Cell[BoxData[
 RowBox[{"{", 
