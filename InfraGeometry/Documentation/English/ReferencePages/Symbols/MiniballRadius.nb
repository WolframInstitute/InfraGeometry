Cell[TextData[{
 "The corners of the unit cube have radius ",
 StyleBox["\[Sqrt]3/2", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"f97484ca-7a20-4ca1-838e-80fc9a4d0667"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"corners", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "3"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Point", "[", "corners", "]"}], ",", " ", "StandardRed", ",", 
        " ", 
        RowBox[{"Opacity", "[", "0.2", "]"}], ",", " ", 
        RowBox[{"BoundingRegion", "[", 
         RowBox[{"corners", ",", " ", "\"\<MinBall\>\""}], "]"}]}], "}"}], 
      "]"}], ",", " ", 
     RowBox[{"MiniballRadius", "[", "corners", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e250cced-7f70-4efb-8f1e-4eb3fc18636c"],

