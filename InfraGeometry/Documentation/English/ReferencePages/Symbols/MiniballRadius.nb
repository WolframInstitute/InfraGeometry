Cell["\<\
The three disks about the corners of the acute triangle have no common point \
at nine tenths of the radius, and touch at one point at the radius. The \
triangle is a simplex of the \[CapitalCHacek]ech complex only from that \
radius on.\
\>", "ExampleText",ExpressionUUID->"1b25071a-02ae-4ba5-8c31-6d5f20c8ffa4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1.5"}], "}"}]}], "}"}]}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"rho", " ", "=", " ", 
     RowBox[{"MiniballRadius", "[", "points", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"StandardBlue", ",", " ", 
              RowBox[{"Opacity", "[", "0.15", "]"}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Disk", "[", 
                 RowBox[{"#", ",", " ", "s"}], "]"}], " ", "&"}], " ", "/@", 
               " ", "points"}]}], "}"}], ",", " ", 
            RowBox[{"Point", "[", "points", "]"}]}], "}"}], ",", " ", 
          RowBox[{"PlotLabel", " ", "->", " ", "s"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"s", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"0.9", " ", "rho"}], ",", " ", "rho"}], "}"}]}], "}"}]}], 
       "]"}]}], ",", "\n", "   ", 
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"CechComplex", "[", 
        RowBox[{"points", ",", " ", 
         RowBox[{"0.9", " ", "rho"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"CechComplex", "[", 
        RowBox[{"points", ",", " ", "rho"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"85a7cf66-f460-4a3a-bb80-ffe525b893d6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   GraphicsBox[{{}, {InsetBox[
       GraphicsBox[{
         {RGBColor[0.4, 0.6, 1], Opacity[0.15], DiskBox[{0., 0.}, 0.975], 
          DiskBox[{2., 0.}, 0.975], DiskBox[{1., 1.5}, 0.975]}, 
         PointBox[{{0., 0.}, {2., 0.}, {1., 1.5}}]},
