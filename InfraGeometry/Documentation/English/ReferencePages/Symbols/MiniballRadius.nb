Cell[CellGroupData[{
Cell["MiniballRadius", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f36a7b66-be9f-41a1-a9b3-77cf3bbfcd92"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MiniballRadius"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/MiniballRadius", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["points", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ff3a58d-5926-40e1-98fb-75c75e0d09d6"],
 "\[LineSeparator]",
 "gives the radius of the smallest closed ball that contains the Euclidean ",
 StyleBox["points", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"daec29af-0de0-4b85-be81-85094fa23600"],

Cell[TextData[{
 "Definition: the radius is ",
 StyleBox["min_x max_i |x \[Minus] p_i|", "TI"],
 ", the least ",
 StyleBox["r", "TI"],
 " for which a ball of radius ",
 StyleBox["r", "TI"],
 " contains every ",
 StyleBox["p_i", "TI"],
 ". The centre of that ball is the point ",
 StyleBox["x", "TI"],
 " attaining it, given by ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["BoundingRegion",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["points", "TI"], ",", " ", "\"\<MinBall\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a28c38eb-4118-463f-a680-910979be973c"],
 "."
}], "Notes",ExpressionUUID->"ac09878f-76ef-45da-ab21-774dd5246041"],

Cell[TextData[{
 "The closed balls of radius ",
 StyleBox["r", "TI"],
 " about the points have a common point exactly when ",
 StyleBox["r", "TI"],
 " is at least this radius: a common point is the centre of a ball of radius ",
 StyleBox["r", "TI"],
 " containing them all. That is the test of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CechComplex"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CechComplex", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bd252b38-e549-43c8-8d87-5c462a41cc01"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallIntersectionComplex"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e355da27-aad6-44e0-a035-c4930c62cb74"],
 " for Euclidean points."
}], "Notes",ExpressionUUID->"53641ed4-0ae3-4901-b839-965fafa4be79"],

Cell["\<\
For a triangle with no obtuse angle the radius is the circumradius; for an \
obtuse triangle it is half the longest side. The points may be in any \
dimension.\
\>", "Notes",ExpressionUUID->"8010bab0-64a2-4530-8d2d-cdc5e7abf500"]
}, Open  ]],

