Cell[CellGroupData[{
Cell["MiniballRadius", "ObjectName",ExpressionUUID->"8acc3278-da06-4876-bd0f-1ae359800cef"],

Cell["LLM generated.", "Notes",ExpressionUUID->"eeb8ac09-f142-482d-8894-0c543824a435"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1b97d690-3254-4263-94a1-0b02cb1e750c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MiniballRadius"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/MiniballRadius", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["points", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "979ed3c3-a064-4067-8ab7-df8755336752"],
 "\[LineSeparator]",
 "gives the radius of the smallest closed ball that contains the Euclidean ",
 StyleBox["points", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"2c046a20-2d98-4682-8c73-61332eaa9357"],

Cell[TextData[{
 "Definition: the radius is ",
 StyleBox["min_x max_i |x \[Minus] p_i|", "TI"],
 ", the least ",
 StyleBox["r", "TI"],
 " for which a ball of radius ",
 StyleBox["r", "TI"],
 " contains every ",
 StyleBox["p_i", "TI"],
 ". The centre of that ball is the point ",
 StyleBox["x", "TI"],
 " attaining it, given by ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["BoundingRegion",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["points", "TI"], ",", " ", "\"\<MinBall\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "91aa8ec3-2ab6-4931-b89b-65eeeb10e51a"],
 "."
}], "Notes",ExpressionUUID->"65e232ad-dad0-4719-99e7-c8cc114161f4"],

Cell[TextData[{
 "The closed balls of radius ",
 StyleBox["r", "TI"],
 " about the points have a common point exactly when ",
 StyleBox["r", "TI"],
 " is at least this radius: a common point is the centre of a ball of radius ",
 StyleBox["r", "TI"],
 " containing them all. That is the test of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CechComplex"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CechComplex", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fb217752-6056-46ee-bc7b-23b426296252"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallIntersectionComplex"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6e2ad154-bea3-408f-b918-2dc26112cd80"],
 " for Euclidean points."
}], "Notes",ExpressionUUID->"e283ae51-069d-48ae-b6c6-809fd9c808e9"],

Cell["The radius of one point is 0.", "Notes",ExpressionUUID->"81089f28-ede0-4715-9315-23631f07b5fe"],

Cell["\<\
For a triangle with no obtuse angle the radius is the circumradius; for an \
obtuse triangle it is half the longest side. The points may be in any \
dimension.\
\>", "Notes",ExpressionUUID->"339694db-03f6-4d31-ac01-ee3ed163bed9"]
}, Open  ]],

