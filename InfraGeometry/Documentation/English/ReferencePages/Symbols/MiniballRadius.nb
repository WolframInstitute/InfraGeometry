      0.22990978967072273`, 0.6125029843579641}, {0.0968159756118887, 
      0.548855107163392}, {0.13254785678519854`, 0.23233238756230468`}}], 
     {RGBColor[0.93, 0.27, 0.27], 
      CircleBox[{0.49517259429028226`, 0.5168935296948138}, 
       0.6697790635841964]}}], ",", "0.6697790635841964`"}], "}"}]], "Output",\

