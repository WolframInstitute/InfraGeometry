Cell["\<\
Seven random points in the plane and their smallest enclosing circle.\
\>", "ExampleText",ExpressionUUID->"85b81a0c-bb87-4d62-8120-9e67df4dbaa7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"7", ",", " ", "2"}], "}"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Point", "[", "points", "]"}], ",", " ", "StandardRed", ",", 
        " ", 
        RowBox[{"Circle", " ", "@@", " ", 
         RowBox[{"BoundingRegion", "[", 
          RowBox[{"points", ",", " ", "\"\<MinBall\>\""}], "]"}]}]}], "}"}], 
      "]"}], ",", " ", 
     RowBox[{"MiniballRadius", "[", "points", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"52aac3d5-69f1-4ee2-8af4-5f47af2a55a1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
