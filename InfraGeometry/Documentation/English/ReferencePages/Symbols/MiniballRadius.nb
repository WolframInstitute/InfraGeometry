Cell[TextData[{
 "The disks of radius ",
 StyleBox["r", "TI"],
 " about the corners of the acute triangle have a common point exactly from \
",
 StyleBox["r = \[Rho]", "TI"],
 " on. At ",
 StyleBox["0.9 \[Rho]", "TI"],
 " they miss; at ",
 StyleBox["\[Rho]", "TI"],
 " they meet in the centre of the circumcircle:"
}], "ExampleText",ExpressionUUID->"be2d4c0b-0ef1-452b-a1b7-c97ee5d1dc8f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"points", " ", "=", " ", 
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1.5"}], "}"}]}], "}"}]}]}], "}"}], ",", " ", 
   
   RowBox[{"{", 
    RowBox[{"rho", " ", "=", " ", 
     RowBox[{"MiniballRadius", "[", "points", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"StandardBlue", ",", " ", 
            RowBox[{"Opacity", "[", "0.15", "]"}], ",", " ", 
            RowBox[{
             RowBox[{
