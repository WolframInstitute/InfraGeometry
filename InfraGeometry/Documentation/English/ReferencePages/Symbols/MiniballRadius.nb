Cell[CellGroupData[{
Cell["MiniballRadius", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"832397f9-bc1b-447b-831e-fabbc3b95641"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MiniballRadius"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/MiniballRadius", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["points", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c046852d-5659-46e1-88db-61f95003be85"],
 "\[LineSeparator]",
 "gives the radius of the smallest closed ball that contains the Euclidean ",
 StyleBox["points", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"5f320fcc-5b8f-48e5-9d97-c8e824d68a7d"],

Cell[TextData[{
 "Definition: the radius is ",
 StyleBox["min_x max_i |x \[Minus] p_i|", "TI"],
 ", the least ",
 StyleBox["r", "TI"],
 " for which a ball of radius ",
 StyleBox["r", "TI"],
 " contains every ",
 StyleBox["p_i", "TI"],
 ". The centre of that ball is the point ",
 StyleBox["x", "TI"],
 " attaining it, given by ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["BoundingRegion",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["points", "TI"], ",", " ", "\"\<MinBall\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48433bdb-e59d-46eb-9b79-c3f4bc366d8d"],
 "."
}], "Notes",ExpressionUUID->"f773620a-e4a9-46a6-be87-17cd8e98add4"],

Cell[TextData[{
 "The closed balls of radius ",
 StyleBox["r", "TI"],
 " about the points have a common point exactly when ",
 StyleBox["r", "TI"],
 " is at least this radius: a common point is the centre of a ball of radius ",
 StyleBox["r", "TI"],
 " containing them all. That is the test of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CechComplex"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/CechComplex", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "03e90ea4-beeb-4371-bff7-4cb9637f7fa8"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BallIntersectionComplex"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/BallIntersectionComplex", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "879ee690-8c5d-4cfc-bd1d-33646442a091"],
 " for Euclidean points."
}], "Notes",ExpressionUUID->"6d9ba28d-0d99-4daa-8e89-8eda79259e4f"],

Cell["The radius of one point is 0.", "Notes",ExpressionUUID->"810b0c18-c72c-4399-80a4-6493470b5612"],

Cell["\<\
For a triangle with no obtuse angle the radius is the circumradius; for an \
obtuse triangle it is half the longest side. The points may be in any \
dimension.\
\>", "Notes",ExpressionUUID->"22f73649-bcae-4295-a3c0-260116bc15ad"]
}, Open  ]],

