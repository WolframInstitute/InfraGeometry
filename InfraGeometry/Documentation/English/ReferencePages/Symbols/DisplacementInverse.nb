Cell["\<\
A step that is not injective, followed by its inverse, is not the identity: a \
vertex goes back to every vertex with the same image. On the grid this \
happens at the right rim:\
\>", "ExampleText",ExpressionUUID->"2244204f-a383-4675-b5a0-d24796951487"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"right", " ", "=", " ", 
     RowBox[{"TranslationDisplacement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"DisplacementPlot", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"DisplacementCompose", "[", 
      RowBox[{"right", ",", " ", 
       RowBox[{"DisplacementInverse", "[", "right", "]"}]}], "]"}], ",", " ", 
     
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5e3d89c8-9372-4bde-85a7-114713307317"],

