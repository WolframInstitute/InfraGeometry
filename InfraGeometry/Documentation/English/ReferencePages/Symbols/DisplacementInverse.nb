Cell["\<\
The inverse of the step right, on the square grid and on the square mesh. The \
label counts the vertices by their number of values; 0 is a vertex nothing \
moves to:\
\>", "ExampleText",ExpressionUUID->"693088bb-3b30-44c2-bb8b-059558c407b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"KeyValueMap", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name", ",", " ", "s"}], "}"}], " ", "|->", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"inverse", " ", "=", " ", 
         RowBox[{"DisplacementInverse", "[", 
          RowBox[{"TranslationDisplacement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"s", ",", " ", "0"}], "}"}]}], "]"}], "]"}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{"DisplacementPlot", "[", 
        RowBox[{"g", ",", " ", "inverse", ",", " ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"KeySort", " ", "@", " ", 
           RowBox[{"Counts", "[", 
            RowBox[{"Length", " ", "/@", " ", "inverse"}], "]"}]}]}]}], 
        "]"}]}], "]"}]}], ",", "\n", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<SquareGridGraph\>\"", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"\"\<SquareMeshGraph\>\"", " ", "->", " ", 
       RowBox[{"1", "/", "8"}]}]}], "|>"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ed1088b5-56b8-4309-b1fa-214e2ca32806"],

