Cell["The inverse of the inverse is the displacement:", "ExampleText",ExpressionUUID->"61946ed4-fc29-498f-9f51-f33a7682cec2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"TranslationDisplacement", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "8"}], ",", " ", "0"}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{
    RowBox[{"DisplacementInverse", "[", 
     RowBox[{"DisplacementInverse", "[", "t", "]"}], "]"}], " ", "===", " ", 
    "t"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"93f73b80-155c-402b-a979-efb04425cf14"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"4f21a205-2dc9-4437-85dc-b0e47e84d941"]
}, Open  ]],

Cell["\<\
For a bijection the inverse is the inverse map. The rotation of a 12-cycle by \
one step and its inverse compose to the identity in both orders:\
\>", "ExampleText",ExpressionUUID->"841b1197-60f4-4936-aea1-3f2a508ad293"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"rotation", " ", "=", " ", 
     RowBox[{"FindKillingDisplacement", "[", "g", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"inverse", " ", "=", " ", 
     RowBox[{"DisplacementInverse", "[", "rotation", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"identity", " ", "=", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{"List", ",", " ", 
       RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rotation", "[", "1", "]"}], ",", " ", 
     RowBox[{"inverse", "[", "1", "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"DisplacementCompose", "[", 
       RowBox[{"rotation", ",", " ", "inverse"}], "]"}], " ", "===", " ", 
      "identity"}], ",", " ", 
     RowBox[{
      RowBox[{"DisplacementCompose", "[", 
       RowBox[{"inverse", ",", " ", "rotation"}], "]"}], " ", "===", " ", 
      "identity"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f72098b2-01b6-4243-8b4e-a970d8bfb779"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "12", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"60979628-9091-471a-a13a-0860b7430088"]
}, Open  ]],

Cell["\<\
The inverse is not the negative. At the centre of the grid the inverse of the \
outward radial displacement is empty, while the negative has the four \
neighbours:\
\>", "ExampleText",ExpressionUUID->"e037dbda-8c46-402e-b545-eb3787fd4ca9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"radial", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"PolarDisplacements", "[", 
       RowBox[{"g", ",", " ", "c"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"DisplacementInverse", "[", "radial", "]"}], "[", "c", "]"}], ",",
      " ", 
     RowBox[{
      RowBox[{"DisplacementNegative", "[", 
       RowBox[{"g", ",", " ", "radial"}], "]"}], "[", "c", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"460f7ef7-fc53-4609-874a-f374daf96a0e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"35", ",", "44", ",", "46", ",", "55"}], "}"}]}], "}"}]], "Output",\

 CellLabel->"Out[3]= ",ExpressionUUID->"0d5423eb-992a-4366-a550-e3d71df4cb01"]
}, Open  ]]
