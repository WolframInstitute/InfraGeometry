Cell[CellGroupData[{
Cell["DisplacementInverse", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c1c961ee-c9a8-4b3c-97bc-249a239dfc91"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DisplacementInverse"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DisplacementInverse", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "525261e2-fa99-4444-a9a3-a0ab3ba88351"],
 "\[LineSeparator]",
 "is the inverse relation of the displacement ",
 StyleBox["d", "TI"],
 ": its value at ",
 StyleBox["v", "TI"],
 " is the set of vertices whose value contains ",
 StyleBox["v", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"3f84e53f-784a-4556-bd27-f84edbce0a3d"],

Cell[TextData[{
 "The inverse is ",
 StyleBox["D\:207b\.b9(v) = {u : v \[Element] D(u)}", "TI"],
 ", for ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " among the keys of ",
 StyleBox["d", "TI"],
 "."
}], "Notes",ExpressionUUID->"7918ed47-f448-44c3-a643-29431a76029e"],

Cell[TextData[{
 "When ",
 StyleBox["D", "TI"],
 " is a bijection (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementBijectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementBijectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7af74246-9e68-4da9-9c39-2cc9b39c4233"],
 "), ",
 StyleBox["D\:207b\.b9", "TI"],
 " is the inverse map, and both composites with ",
 StyleBox["D", "TI"],
 " are the identity. Otherwise a vertex that nothing moves to has the empty \
value {}, and a vertex that several vertices move to has several values."
}], "Notes",ExpressionUUID->"a03a0bf2-bf54-482e-b396-aa31bc785412"],

Cell[TextData[{
 "The inverse needs no graph. The inverse of the inverse is ",
 StyleBox["D", "TI"],
 "."
}], "Notes",ExpressionUUID->"18a0c8df-65f1-493d-af53-f2a4f84e13db"],

Cell[TextData[{
 "The inverse is not the negative. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DisplacementNegative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/DisplacementNegative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7015bd6e-246a-4348-986e-28991f05abd9"],
 " reflects each step through its base vertex and needs the metric."
}], "Notes",ExpressionUUID->"765bf8e2-ecfd-488e-bee7-7a0e1715e62d"]
}, Open  ]],

