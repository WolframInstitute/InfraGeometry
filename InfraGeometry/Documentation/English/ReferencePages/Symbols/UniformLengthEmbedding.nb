Cell["\<\
Four points in the plane cannot be pairwise at distance 1, so the complete \
graph on four vertices gets no unit edges there:\
\>", "ExampleText",ExpressionUUID->"1cbae20d-2d6f-48df-a14b-41ad53aae79f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"CompleteGraph", "[", "4", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"UniformLengthEmbedding", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"MinMax", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"EuclideanDistance", " ", "@@", " ", 
       RowBox[{"c", "[", 
        RowBox[{"[", 
         RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", "&"}], 
     " ", "/@", " ", 
     RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1fe74a62-e300-4e0c-b008-eb286dc18d91"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.8786798306920517`", ",", "1.2426409335483946`"}], 
  "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"3f3b90fd-edf5-4819-bd15-2c791e8a2a46"]
}, Open  ]]
}, Open  ]],

