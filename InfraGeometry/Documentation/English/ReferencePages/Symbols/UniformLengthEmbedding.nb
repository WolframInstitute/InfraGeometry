Cell["\<\
A graph that has a unit-distance embedding need not end in it: the relaxation \
from the spring-electrical layout stops short. The ball of radius 3 of the \
triangular tiling has unit edges in the plane, yet its edges end between 0.86 \
and 1.15.\
\>", "ExampleText",ExpressionUUID->"2276b1d1-b876-4858-a344-d5dc52f2c066"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"IndexGraph", " ", "@", " ", 
      RowBox[{"TessellationNeighborhoodGraph", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "6"}], "}"}], ",", " ", "3"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"coordinates", " ", "=", " ", 
     RowBox[{"UniformLengthEmbedding", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Graph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"VertexCoordinates", " ", "->", " ", "coordinates"}]}], "]"}], 
     ",", " ", 
     RowBox[{"MinMax", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"EuclideanDistance", " ", "@@", " ", 
         RowBox[{"coordinates", "[", 
          RowBox[{"[", 
           RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", "&"}], 
       " ", "/@", " ", 
       RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7111ae52-06a6-430d-94b8-c45829ba27a3"],

