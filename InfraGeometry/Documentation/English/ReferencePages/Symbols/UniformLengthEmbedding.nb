Notebook[{

Cell[CellGroupData[{
Cell["UniformLengthEmbedding", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ad8b7028-4c73-4a1d-9a4a-d947c358aec7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["UniformLengthEmbedding"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/UniformLengthEmbedding", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d12bd280-89a8-44a6-83c3-45a6fff40120"],
 "\[LineSeparator]",
 "gives coordinates in space for the vertices of ",
 StyleBox["g", "TI"],
 ", in the order of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VertexList"]], "paclet:ref/VertexList"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c3a4dd5b-aa4e-4caa-8de8-bcd87ca9d579"],
 ", under which the edges of ",
 StyleBox["g", "TI"],
 " are relaxed towards length 1: from the spring-electrical layout, by edge \
springs.",
 "\n"
}], "Usage",ExpressionUUID->"ba076f9f-c460-4631-ac9f-d5e5f654393d"],

Cell[TextData[{
 "Construction: start from the spring-electrical layout of ",
 StyleBox["g", "TI"],
 " in dimension ",
 StyleBox["d", "TI"],
 ", scaled so that the mean edge length is 1. At each step, every edge {",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "} moves ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " by half of what brings it to length 1, a vertex moving at most ",
 Cell[BoxData["\"\<MaxStepPerVertex\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b28a265-662a-4a2d-ba4c-955fb3788005"],
 "; stop when no vertex moves more than ",
 Cell[BoxData["\"\<Tolerance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50593fe0-2f92-41bd-8d5f-7f241400a605"],
 ", or after ",
 Cell[BoxData["\"\<MaxIterations\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bed32f04-b956-4066-9955-eceaae3916a2"],
 " steps."
}], "Notes",ExpressionUUID->"b5a682ac-b2c9-4903-9750-ed03416060f1"],

Cell["\<\
An embedding with every edge of length 1 is a unit-distance embedding. The \
relaxation finds one for small graphs that have one, such as the Platonic \
solids in space, and it keeps one it is started from. A graph without one, \
such as the complete graph on four vertices in the plane, ends with edges \
spread about 1.\
\>", "Notes",ExpressionUUID->"7dba58b8-83be-41ac-8d5d-0f8d6acf834c"],

Cell[TextData[{
 "The result has the shape of ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["GraphEmbedding",
    BaseStyle->"Link"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de51dbe5-bcd6-46c3-acae-52f42521784b"],
 ": draw it with ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Graph",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["VertexCoordinates",
      BaseStyle->"Link"], " ", "->", " ", 
     RowBox[{"UniformLengthEmbedding", "[", 
      StyleBox["g", "TI"], "]"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b62be70b-4b93-4f49-a820-9d54162ea0f2"],
 "."
}], "Notes",ExpressionUUID->"0ed4f0c7-fa5e-43dc-953d-a7a83951081f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UniformLengthGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/UniformLengthGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0c1f25db-906d-4a48-99d8-7664cb34af74"],
 " goes the other way: it discretizes a region by a graph with edges of one \
length."
}], "Notes",ExpressionUUID->"5759ec41-e1a3-4e84-b48f-08e63c970d62"],

