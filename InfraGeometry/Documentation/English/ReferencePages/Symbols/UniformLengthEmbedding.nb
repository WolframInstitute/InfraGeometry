Cell["\<\
Four points in the plane cannot be pairwise at distance 1, so the complete \
graph on four vertices gets no unit edges there.\
\>", "ExampleText",ExpressionUUID->"c62a5584-bb37-4669-a5c6-150ba932083f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"coordinates", " ", "=", " ", 
     RowBox[{"UniformLengthEmbedding", "[", 
      RowBox[{
       RowBox[{"CompleteGraph", "[", "4", "]"}], ",", " ", 
       RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"CompleteGraph", "[", "4", "]"}], ",", " ", 
       RowBox[{"VertexCoordinates", " ", "->", " ", "coordinates"}]}], "]"}], 
     ",", " ", 
     RowBox[{"MinMax", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"EuclideanDistance", " ", "@@", " ", 
         RowBox[{"coordinates", "[", 
          RowBox[{"[", 
           RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", "&"}], 
       " ", "/@", " ", 
       RowBox[{"EdgeList", "[", 
        RowBox[{"CompleteGraph", "[", "4", "]"}], "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"45caecb4-2a91-42cd-af94-2644a62e7d3a"],

