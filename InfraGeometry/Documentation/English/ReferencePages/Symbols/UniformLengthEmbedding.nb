Cell["MaxIterations", "ExampleSubsection",ExpressionUUID->"8faff4ce-c68f-49f4-8efc-c905d83e90b3"],

Cell["\<\
The third Sierpinski graph needs more than the default 500 steps: after 500 \
its edges lie between 0.88 and 1.18, after 5000 they have length 1.\
\>", "ExampleText",ExpressionUUID->"c097143e-366c-4c0b-8b61-a17a0223dde7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"IndexGraph", " ", "@", " ", 
      RowBox[{"SierpinskiGraph", "[", "3", "]"}]}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Graph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", 
           RowBox[{"UniformLengthEmbedding", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "steps"}]}], 
            "]"}]}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"steps", ",", " ", 
          RowBox[{"{", 
           RowBox[{"500", ",", " ", "5000"}], "}"}]}], "}"}]}], "]"}]}], ",", 
     "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"coordinates", " ", "=", " ", 
           RowBox[{"UniformLengthEmbedding", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "steps"}]}], 
            "]"}]}], "}"}], ",", " ", 
         RowBox[{"MinMax", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"EuclideanDistance", " ", "@@", " ", 
             RowBox[{"coordinates", "[", 
              RowBox[{"[", 
               RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
            "&"}], " ", "/@", " ", 
           RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"steps", ",", " ", 
         RowBox[{"{", 
          RowBox[{"500", ",", " ", "5000"}], "}"}]}], "}"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b1949ab3-1344-4308-850d-3c6925f8287f"],

