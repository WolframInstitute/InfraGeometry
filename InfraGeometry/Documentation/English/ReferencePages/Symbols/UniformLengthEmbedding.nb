Cell["\<\
Four points in the plane cannot be pairwise at distance 1, so the complete \
graph on four vertices gets no unit edges there.\
\>", "ExampleText",ExpressionUUID->"4df6f2ff-20ef-4dda-acb5-a796a95c54c8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"coordinates", " ", "=", " ", 
     RowBox[{"UniformLengthEmbedding", "[", 
      RowBox[{
       RowBox[{"CompleteGraph", "[", "4", "]"}], ",", " ", 
       RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"CompleteGraph", "[", "4", "]"}], ",", " ", 
       RowBox[{"VertexCoordinates", " ", "->", " ", "coordinates"}]}], "]"}], 
     ",", " ", 
     RowBox[{"MinMax", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"EuclideanDistance", " ", "@@", " ", 
         RowBox[{"coordinates", "[", 
          RowBox[{"[", 
           RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", "&"}], 
       " ", "/@", " ", 
       RowBox[{"EdgeList", "[", 
        RowBox[{"CompleteGraph", "[", "4", "]"}], "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3081cf0a-630b-472a-8b3a-a18f18da69da"],

