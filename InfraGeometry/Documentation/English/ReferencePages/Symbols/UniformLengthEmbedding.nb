Cell[CellGroupData[{

Cell["NonEdgeRepulsion", "ExampleSubsection",ExpressionUUID->"776acfd8-5150-4394-bad2-e1e8113f1b8d"],

Cell["\<\
The four-dimensional cube in space. With unit edges two vertices without an \
edge come within 0.35 of each other; repulsion keeps them at least 0.58 \
apart, and the edges give way:\
\>", "ExampleText",ExpressionUUID->"9a75995c-fbf6-45e5-b267-32e5cb29619f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"HypercubeGraph", "[", "4", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Subsets", "[", 
        RowBox[{
         RowBox[{"Range", "[", "16", "]"}], ",", " ", 
         RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"EdgeQ", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"UndirectedEdge", " ", "@@", " ", "#"}]}], "]"}]}], " ", 
        "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"UniformLengthEmbedding", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"\"\<NonEdgeRepulsion\>\"", " ", "->", " ", "r"}]}], 
          "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"MinMax", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"EuclideanDistance", " ", "@@", " ", 
             RowBox[{"c", "[", 
              RowBox[{"[", 
               RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
            "&"}], " ", "/@", " ", 
           RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}], ",", " ", 
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"EuclideanDistance", " ", "@@", " ", 
             RowBox[{"c", "[", 
              RowBox[{"[", "#", "]"}], "]"}]}], " ", "&"}], " ", "/@", " ", 
           "far"}], "]"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0.", ",", " ", "1."}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4da2ecf7-2f5b-4ccb-85c7-1d00622e5f1d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.9999998648506658`", ",", "1.000000239538838`"}], "}"}], ",", 
     "0.3472566045178287`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.9572727327812136`", ",", "1.120622305478869`"}], "}"}], ",", 
     "0.5778037829750379`"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c6b53afb-04b8-42b5-a692-33d98d7baaba"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["InitialEmbedding", "ExampleSubsection",ExpressionUUID->"13a9d044-0df6-45b4-bc4e-477ca3600f0b"],

Cell["\<\
A ball of the triangular tiling is rigid. Started from the coordinates of the \
tiling, the relaxation keeps its unit edges:\
\>", "ExampleText",ExpressionUUID->"eac82372-65c3-4726-ad67-9f894f53ce7a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"IndexGraph", " ", "@", " ", 
      RowBox[{"TessellationNeighborhoodGraph", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "6"}], "}"}], ",", " ", "3"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"UniformLengthEmbedding", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}], ",", " ", 
       RowBox[{"\"\<InitialEmbedding\>\"", " ", "->", " ", 
        RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Graph", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"VertexCoordinates", " ", "->", " ", "c"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"MinMax", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"EuclideanDistance", " ", "@@", " ", 
            RowBox[{"c", "[", 
             RowBox[{"[", 
              RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
           "&"}], " ", "/@", " ", 
          RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}], ",", " ", "0.01"}], 
       "]"}]}], ",", "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"446830e7-e6d3-4b58-8056-14c0566b6888"],

