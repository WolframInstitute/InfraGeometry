Notebook[{

Cell[CellGroupData[{
Cell["UniformLengthEmbedding", "ObjectName",ExpressionUUID->"f604716d-0634-41fa-9c38-ed8c4aae0eaf"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"dc612b1f-e0de-4b49-aabf-01af3045a60b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["UniformLengthEmbedding"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/UniformLengthEmbedding", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28cf0168-cc9b-48aa-bd2b-4be54ca08e23"],
 "\[LineSeparator]",
 "gives coordinates in space for the vertices of ",
 StyleBox["g", "TI"],
 ", in the order of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VertexList"]], "paclet:ref/VertexList"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f7b8f15c-8ba4-4e70-8841-b235631c3992"],
 ", under which the edges of ",
 StyleBox["g", "TI"],
 " are relaxed towards length 1: from the spring-electrical layout, by edge \
springs.",
 "\n"
}], "Usage",ExpressionUUID->"c139202d-c00f-4cc7-aa4d-86356b5f7722"],

Cell[TextData[{
 "Construction: start from the spring-electrical layout of ",
 StyleBox["g", "TI"],
 " in dimension ",
 StyleBox["d", "TI"],
 ", scaled so that the mean edge length is 1. At each step, every edge {",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "} moves ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " by half of what brings it to length 1, a vertex moving at most ",
 Cell[BoxData["\"\<MaxStepPerVertex\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bb2cd94-f36d-4b9b-9342-c2c70af33ca1"],
 "; stop when no vertex moves more than ",
 Cell[BoxData["\"\<Tolerance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72dc1db4-86b7-4890-b7c9-4ce456e67ee7"],
 ", or after ",
 Cell[BoxData["\"\<MaxIterations\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31338a9e-d787-43de-a154-2db8c4303e04"],
 " steps."
}], "Notes",ExpressionUUID->"2c3c7238-1fb3-4277-a950-c89fc0aae899"],

Cell["\<\
An embedding with every edge of length 1 is a unit-distance embedding. The \
relaxation finds one for small graphs that have one, such as the Platonic \
solids in space, and it keeps one it is started from. A graph without one, \
such as the complete graph on four vertices in the plane, ends with edges \
spread about 1.\
\>", "Notes",ExpressionUUID->"8c179403-dc01-440a-83fd-7842d57fbdf5"],

Cell[TextData[{
 "The result has the shape of ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["GraphEmbedding",
    BaseStyle->"Link"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e6a9c4e-8cd7-4d52-b938-f1144f910a37"],
 ": draw it with ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Graph",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["VertexCoordinates",
      BaseStyle->"Link"], " ", "->", " ", 
     RowBox[{"UniformLengthEmbedding", "[", 
      StyleBox["g", "TI"], "]"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8fccb8c5-9ab5-4f06-bffd-325c6f8371b0"],
 "."
}], "Notes",ExpressionUUID->"0ccf79ee-132c-44f9-bd12-18dd1fd56239"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UniformLengthGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/UniformLengthGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "50f6deaa-f7be-4060-86de-f7996fa14ff5"],
 " goes the other way: it discretizes a region by a graph with edges of one \
length."
}], "Notes",ExpressionUUID->"6d4a9749-13d6-4127-91f5-f1fd866a702d"],

