Cell[CellGroupData[{

Cell["NonEdgeRepulsion", "ExampleSubsection",ExpressionUUID->"e2cf96a9-eddd-4131-8b73-8378d3a7b213"],

Cell["\<\
The four-dimensional cube in space: with unit edges, two vertices without an \
edge come within 0.35 of each other. Repulsion keeps them at least 0.58 \
apart, and the edges give way.\
\>", "ExampleText",ExpressionUUID->"d4a4d1ae-aa66-457f-ba06-75e0757078b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"HypercubeGraph", "[", "4", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"coordinates", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"UniformLengthEmbedding", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"\"\<NonEdgeRepulsion\>\"", " ", "->", " ", "repulsion"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"repulsion", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0.", ",", " ", "1."}], "}"}]}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Graph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", "c"}]}], "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "coordinates"}], "}"}]}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"MinMax", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"EuclideanDistance", " ", "@@", " ", 
           RowBox[{"c", "[", 
            RowBox[{"[", 
             RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
          "&"}], " ", "/@", " ", 
         RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "coordinates"}], "}"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"EuclideanDistance", " ", "@@", " ", 
           RowBox[{"c", "[", 
            RowBox[{"[", "#", "]"}], "]"}]}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Subsets", "[", 
            RowBox[{
             RowBox[{"Range", "[", "16", "]"}], ",", " ", 
             RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"!", " ", 
             RowBox[{"EdgeQ", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"UndirectedEdge", " ", "@@", " ", "#"}]}], "]"}]}], 
            " ", "&"}]}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "coordinates"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2df570c2-10af-4a47-af61-453200d20138"],

