Cell[TextData[{
 "The graphs of the octahedron, the icosahedron and the dodecahedron, which \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c19ebbc7-7673-4dd9-aac9-46c1b59499c4"],
 " builds without coordinates, placed in space with every edge of length 1; \
the shortest and the longest edge of each."
}], "ExampleText",ExpressionUUID->"1fd99162-20d7-4768-9692-2ab9e9544828"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"solids", " ", "=", " ", 
     RowBox[{"TessellationGraph", " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "5"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "3"}], "}"}]}], "}"}]}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Graph", "[", 
         RowBox[{"solid", ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", 
           RowBox[{"UniformLengthEmbedding", "[", "solid", "]"}]}]}], "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"solid", ",", " ", "solids"}], "}"}]}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"coordinates", " ", "=", " ", 
           RowBox[{"UniformLengthEmbedding", "[", "solid", "]"}]}], "}"}], ",",
          " ", 
         RowBox[{"MinMax", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"EuclideanDistance", " ", "@@", " ", 
             RowBox[{"coordinates", "[", 
              RowBox[{"[", 
               RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
            "&"}], " ", "/@", " ", 
           RowBox[{"EdgeList", "[", "solid", "]"}]}], "]"}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"solid", ",", " ", "solids"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5d4c1b20-4705-46bd-bd2e-e6a515c11bb7"],

