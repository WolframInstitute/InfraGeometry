Cell[CellGroupData[{

Cell["InitialEmbedding", "ExampleSubsection",ExpressionUUID->"b4398f49-d21c-4f3a-b397-5d213bcadb45"],

Cell["\<\
A ball of the triangular tiling has unit edges in the plane, but the \
relaxation from the spring-electrical layout stops with its edges between \
0.86 and 1.15. Started from the coordinates of the tiling, it keeps them.\
\>", "ExampleText",ExpressionUUID->"f569391c-2f88-4d86-9d76-e2a272c3c11f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"IndexGraph", " ", "@", " ", 
      RowBox[{"TessellationNeighborhoodGraph", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "6"}], "}"}], ",", " ", "3"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"coordinates", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"UniformLengthEmbedding", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}]}], "]"}], ",", 
       " ", 
       RowBox[{"UniformLengthEmbedding", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"\"\<InitialEmbedding\>\"", " ", "->", " ", 
          RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "]"}]}], "}"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Graph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", "c"}]}], "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "coordinates"}], "}"}]}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"MinMax", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"EuclideanDistance", " ", "@@", " ", 
           RowBox[{"c", "[", 
            RowBox[{"[", 
             RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
          "&"}], " ", "/@", " ", 
         RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "coordinates"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"77d049e1-bde8-42a2-9ec7-e88421e667cc"],

