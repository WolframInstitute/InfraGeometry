Cell["MaxIterations", "ExampleSubsection",ExpressionUUID->"a4e6316b-ff24-4f42-b340-2967ee02de1d"],

Cell["\<\
The third Sierpinski graph needs more than the default 500 steps: after 500 \
its edges lie between 0.88 and 1.18, after 5000 they have length 1.\
\>", "ExampleText",ExpressionUUID->"556dede5-adf9-41d5-9969-404ce0eb2f80"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"IndexGraph", " ", "@", " ", 
      RowBox[{"SierpinskiGraph", "[", "3", "]"}]}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Graph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", 
           RowBox[{"UniformLengthEmbedding", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "steps"}]}], 
            "]"}]}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"steps", ",", " ", 
          RowBox[{"{", 
           RowBox[{"500", ",", " ", "5000"}], "}"}]}], "}"}]}], "]"}]}], ",", 
     "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"coordinates", " ", "=", " ", 
           RowBox[{"UniformLengthEmbedding", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "steps"}]}], 
            "]"}]}], "}"}], ",", " ", 
         RowBox[{"MinMax", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"EuclideanDistance", " ", "@@", " ", 
             RowBox[{"coordinates", "[", 
              RowBox[{"[", 
               RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
            "&"}], " ", "/@", " ", 
           RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"steps", ",", " ", 
         RowBox[{"{", 
          RowBox[{"500", ",", " ", "5000"}], "}"}]}], "}"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c1a4db78-a5b0-4fa0-9bfb-ca6329cb3124"],

