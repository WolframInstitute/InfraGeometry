Cell[CellGroupData[{

Cell["MaxIterations", "ExampleSubsection",ExpressionUUID->"5b3efb41-3804-424b-b6eb-616b1f76d02e"],

Cell["\<\
The third Sierpinski graph needs more than 500 steps. After 500 its edges lie \
between 0.88 and 1.18, after 5000 they have length 1:\
\>", "ExampleText",ExpressionUUID->"ded55495-53a6-48bd-ae46-2d3900cabd6e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"IndexGraph", " ", "@", " ", 
      RowBox[{"SierpinskiGraph", "[", "3", "]"}]}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"c", " ", "=", " ", 
          RowBox[{"UniformLengthEmbedding", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "steps"}]}], 
           "]"}]}], "}"}], ",", "\n", "    ", 
        RowBox[{"Graph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", "c"}], ",", " ", 
          RowBox[{"PlotLabel", " ", "->", " ", 
           RowBox[{"Round", "[", 
            RowBox[{
             RowBox[{"MinMax", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"EuclideanDistance", " ", "@@", " ", 
                 RowBox[{"c", "[", 
                  RowBox[{"[", 
                   RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ",
                 "&"}], " ", "/@", " ", 
               RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}], ",", " ", 
             "0.01"}], "]"}]}]}], "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"steps", ",", " ", 
        RowBox[{"{", 
         RowBox[{"500", ",", " ", "5000"}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d9973ce2-8cc3-46cd-b9ac-77d1f8e681e1"],

