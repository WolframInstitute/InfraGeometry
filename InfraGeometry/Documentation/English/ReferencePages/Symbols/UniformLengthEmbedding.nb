Cell["MaxIterations", "ExampleSubsection",ExpressionUUID->"34aa269d-af46-404f-9461-2a61ff01c6ec"],

Cell["\<\
The third Sierpinski graph needs more than the default 500 steps: after 500 \
its edges lie between 0.88 and 1.18, after 5000 they have length 1.\
\>", "ExampleText",ExpressionUUID->"9013b2fa-27eb-4ca0-a8a7-32d6cb21a7ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"IndexGraph", " ", "@", " ", 
      RowBox[{"SierpinskiGraph", "[", "3", "]"}]}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Graph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", 
           RowBox[{"UniformLengthEmbedding", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "steps"}]}], 
            "]"}]}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"steps", ",", " ", 
          RowBox[{"{", 
           RowBox[{"500", ",", " ", "5000"}], "}"}]}], "}"}]}], "]"}]}], ",", 
     "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"coordinates", " ", "=", " ", 
           RowBox[{"UniformLengthEmbedding", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "steps"}]}], 
            "]"}]}], "}"}], ",", " ", 
         RowBox[{"MinMax", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"EuclideanDistance", " ", "@@", " ", 
             RowBox[{"coordinates", "[", 
              RowBox[{"[", 
               RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
            "&"}], " ", "/@", " ", 
           RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"steps", ",", " ", 
         RowBox[{"{", 
          RowBox[{"500", ",", " ", "5000"}], "}"}]}], "}"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"403b4422-9ea6-4c71-8a97-4ebf2bc452c1"],

