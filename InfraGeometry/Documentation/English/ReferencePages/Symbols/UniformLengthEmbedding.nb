Notebook[{

Cell[CellGroupData[{
Cell["UniformLengthEmbedding", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9903f65a-e542-4b32-8258-1c2a9fc5263a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["UniformLengthEmbedding"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/UniformLengthEmbedding", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34563d69-cb57-4d40-aef1-7131c36ae7c0"],
 "\[LineSeparator]",
 "gives coordinates in space for the vertices of ",
 StyleBox["g", "TI"],
 ", in the order of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VertexList"]], "paclet:ref/VertexList"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1df39a85-c033-4e51-9916-7ef588b3caf9"],
 ", under which the edges of ",
 StyleBox["g", "TI"],
 " are relaxed towards length 1: from the spring-electrical layout, by edge \
springs.",
 "\n"
}], "Usage",ExpressionUUID->"b20b1787-c639-443a-bd92-02b97df0302e"],

Cell[TextData[{
 "Construction: start from the spring-electrical layout of ",
 StyleBox["g", "TI"],
 " in dimension ",
 StyleBox["d", "TI"],
 ", scaled so that the mean edge length is 1. At each step, every edge {",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "} moves ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " by half of what brings it to length 1, a vertex moving at most ",
 Cell[BoxData["\"\<MaxStepPerVertex\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78ed33f9-593b-4157-9db1-0d614fd38b5f"],
 "; stop when no vertex moves more than ",
 Cell[BoxData["\"\<Tolerance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93f891b7-5ed9-4ad4-96df-110244d47d0f"],
 ", or after ",
 Cell[BoxData["\"\<MaxIterations\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6379d67c-78f9-4da8-9013-5b932a8ee019"],
 " steps."
}], "Notes",ExpressionUUID->"ce35154b-aac6-4981-927e-dd27d98c3e3d"],

Cell["\<\
An embedding with every edge of length 1 is a unit-distance embedding. The \
relaxation finds one for small graphs that have one, such as the Platonic \
solids in space, and it keeps one it is started from. A graph without one, \
such as the complete graph on four vertices in the plane, ends with edges \
spread about 1.\
\>", "Notes",ExpressionUUID->"59f5fb73-5e92-4d4a-8d57-34b6e6514bda"],

Cell[TextData[{
 "The result has the shape of ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["GraphEmbedding",
    BaseStyle->"Link"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fe037ca-3d03-4997-8571-5a2580ea2376"],
 ": draw it with ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Graph",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["VertexCoordinates",
      BaseStyle->"Link"], " ", "->", " ", 
     RowBox[{"UniformLengthEmbedding", "[", 
      StyleBox["g", "TI"], "]"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c892ef78-e149-49fb-b641-16bab4580a92"],
 "."
}], "Notes",ExpressionUUID->"13ba6c5a-ff33-4afb-8edc-2cfc288bda07"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UniformLengthGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/UniformLengthGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "469a6bb2-410a-41e2-b705-97ac1845d2cf"],
 " goes the other way: it discretizes a region by a graph with edges of one \
length."
}], "Notes",ExpressionUUID->"f6fcc689-f153-4422-b81e-55b570b7cc76"],

