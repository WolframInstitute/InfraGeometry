Cell[CellGroupData[{

Cell["NonEdgeRepulsion", "ExampleSubsection",ExpressionUUID->"e4ef2e18-8edd-4031-80e8-929665f1f98d"],

Cell["\<\
The four-dimensional cube in space: with unit edges, two vertices without an \
edge come within 0.35 of each other. Repulsion keeps them at least 0.58 \
apart, and the edges give way.\
\>", "ExampleText",ExpressionUUID->"c55829a8-66ea-472c-889f-789e774da8c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"HypercubeGraph", "[", "4", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"coordinates", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"UniformLengthEmbedding", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"\"\<NonEdgeRepulsion\>\"", " ", "->", " ", "repulsion"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"repulsion", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0.", ",", " ", "1."}], "}"}]}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Graph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", "c"}]}], "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "coordinates"}], "}"}]}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"MinMax", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"EuclideanDistance", " ", "@@", " ", 
           RowBox[{"c", "[", 
            RowBox[{"[", 
             RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
          "&"}], " ", "/@", " ", 
         RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "coordinates"}], "}"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"EuclideanDistance", " ", "@@", " ", 
           RowBox[{"c", "[", 
            RowBox[{"[", "#", "]"}], "]"}]}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Subsets", "[", 
            RowBox[{
             RowBox[{"Range", "[", "16", "]"}], ",", " ", 
             RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"!", " ", 
             RowBox[{"EdgeQ", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"UndirectedEdge", " ", "@@", " ", "#"}]}], "]"}]}], 
            " ", "&"}]}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "coordinates"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"20f0ab0c-0384-4c56-b613-d66f2342c1d5"],

