Cell[CellGroupData[{

Cell["NonEdgeRepulsion", "ExampleSubsection",ExpressionUUID->"11c34ef6-4c10-4a96-b916-595d21fa3d23"],

Cell["\<\
The four-dimensional cube in space: with unit edges, two vertices without an \
edge come within 0.35 of each other. Repulsion keeps them at least 0.58 \
apart, and the edges give way.\
\>", "ExampleText",ExpressionUUID->"b5d639eb-a58f-4ae5-8bc2-5320a0c1352e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"HypercubeGraph", "[", "4", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"coordinates", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"UniformLengthEmbedding", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"\"\<NonEdgeRepulsion\>\"", " ", "->", " ", "repulsion"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"repulsion", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0.", ",", " ", "1."}], "}"}]}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Graph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", "c"}]}], "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "coordinates"}], "}"}]}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"MinMax", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"EuclideanDistance", " ", "@@", " ", 
           RowBox[{"c", "[", 
            RowBox[{"[", 
             RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
          "&"}], " ", "/@", " ", 
         RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "coordinates"}], "}"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"EuclideanDistance", " ", "@@", " ", 
           RowBox[{"c", "[", 
            RowBox[{"[", "#", "]"}], "]"}]}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Subsets", "[", 
            RowBox[{
             RowBox[{"Range", "[", "16", "]"}], ",", " ", 
             RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"!", " ", 
             RowBox[{"EdgeQ", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"UndirectedEdge", " ", "@@", " ", "#"}]}], "]"}]}], 
            " ", "&"}]}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "coordinates"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d028dd7a-9b04-4178-af12-e268a94f014a"],

