Cell[CellGroupData[{

Cell["InitialEmbedding", "ExampleSubsection",ExpressionUUID->"4bca1967-3107-4485-a855-1f547de9f586"],

Cell["\<\
A ball of the triangular tiling has unit edges in the plane in the \
coordinates of the tiling. Started from them, the relaxation keeps the unit \
edges; the default start does not reach them (see Possible Issues).\
\>", "ExampleText",ExpressionUUID->"0f25872a-158a-4334-8db0-92e9fc316884"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"IndexGraph", " ", "@", " ", 
      RowBox[{"TessellationNeighborhoodGraph", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "6"}], "}"}], ",", " ", "3"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"coordinates", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"UniformLengthEmbedding", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}]}], "]"}], ",", 
       " ", 
       RowBox[{"UniformLengthEmbedding", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"\"\<InitialEmbedding\>\"", " ", "->", " ", 
          RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "]"}]}], "}"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Graph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", "c"}]}], "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "coordinates"}], "}"}]}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"MinMax", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"EuclideanDistance", " ", "@@", " ", 
           RowBox[{"c", "[", 
            RowBox[{"[", 
             RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
          "&"}], " ", "/@", " ", 
         RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "coordinates"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5f056f8b-5c87-4180-b917-4b9f70af1f06"],

