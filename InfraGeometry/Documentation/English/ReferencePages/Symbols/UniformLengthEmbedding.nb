Cell["\<\
In the plane: a ball of the hexagonal tiling, the 6 \[Times] 6 grid and the \
12-cycle.\
\>", "ExampleText",ExpressionUUID->"52bb0498-09b5-436c-9cbc-1c7dbc0c1e46"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"graphs", " ", "=", " ", 
     RowBox[{"IndexGraph", " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"TessellationNeighborhoodGraph", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"6", ",", " ", "3"}], "}"}], ",", " ", "5"}], "]"}], ",", 
        " ", 
        RowBox[{"GridGraph", "[", 
         RowBox[{"{", 
          RowBox[{"6", ",", " ", "6"}], "}"}], "]"}], ",", " ", 
        RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}]}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Graph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", 
           RowBox[{"UniformLengthEmbedding", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}]}], "]"}]}]}], 
         "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"g", ",", " ", "graphs"}], "}"}]}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"coordinates", " ", "=", " ", 
           RowBox[{"UniformLengthEmbedding", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}]}], "]"}]}], 
          "}"}], ",", " ", 
         RowBox[{"MinMax", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"EuclideanDistance", " ", "@@", " ", 
             RowBox[{"coordinates", "[", 
              RowBox[{"[", 
               RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
            "&"}], " ", "/@", " ", 
           RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"g", ",", " ", "graphs"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"620d8339-27e4-45e4-8ee7-3e642eb7e6f9"],

