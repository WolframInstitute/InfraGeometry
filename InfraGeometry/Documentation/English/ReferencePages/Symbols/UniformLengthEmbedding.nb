Notebook[{

Cell[CellGroupData[{
Cell["UniformLengthEmbedding", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1867531c-d907-4f50-9bcc-49b26cb6cef6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["UniformLengthEmbedding"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/UniformLengthEmbedding", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f64898a-dffb-433f-be88-85645643adda"],
 "\[LineSeparator]",
 "gives coordinates in space for the vertices of ",
 StyleBox["g", "TI"],
 ", in the order of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VertexList"]], "paclet:ref/VertexList"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5a3e412b-3b78-45e3-9750-b588707980d3"],
 ", under which the edges of ",
 StyleBox["g", "TI"],
 " have length close to 1.",
 "\n"
}], "Usage",ExpressionUUID->"12803d47-10a8-49fb-9879-3bf9e814d9f3"],

Cell[TextData[{
 "Construction: start from the spring-electrical layout of ",
 StyleBox["g", "TI"],
 " in dimension ",
 StyleBox["d", "TI"],
 ", scaled so that the mean edge length is 1. At each step, every edge {",
 StyleBox["u", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "} moves ",
 StyleBox["u", "TI"],
 " and ",
 StyleBox["v", "TI"],
 " by half of what brings it to length 1, a vertex moving at most ",
 Cell[BoxData["\"\<MaxStepPerVertex\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "734c59c3-2516-47c6-acd3-7fee79edf9c8"],
 "; stop when no vertex moves more than ",
 Cell[BoxData["\"\<Tolerance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f46323b-6459-4dd0-85bb-ddbaf4ea3644"],
 ", or after ",
 Cell[BoxData["\"\<MaxIterations\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bcf43e3-3ba7-4c77-8fe6-ef81d35b96e8"],
 " steps."
}], "Notes",ExpressionUUID->"17e8d379-0876-47bd-9eb8-94d7d08f34e7"],

Cell["\<\
An embedding with every edge of length 1 is a unit-distance embedding. The \
relaxation finds one for small graphs that have one, such as the Platonic \
solids in space. A graph without one, such as the complete graph on four \
vertices in the plane, ends with edges spread about 1, and so can a larger \
graph that has one: the relaxation stops short of it.\
\>", "Notes",ExpressionUUID->"ad0fb986-50ee-4d55-b01f-afe5e3e7875b"],

Cell[TextData[{
 "The result has the shape of ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["GraphEmbedding",
    BaseStyle->"Link"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42ab8016-624f-4aef-9f7a-fb420f4b4fab"],
 ": draw it with ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Graph",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["VertexCoordinates",
      BaseStyle->"Link"], " ", "->", " ", 
     RowBox[{"UniformLengthEmbedding", "[", 
      StyleBox["g", "TI"], "]"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9a2b353-3337-4879-aacf-91fedff641b2"],
 "."
}], "Notes",ExpressionUUID->"f7360209-2696-40f1-933f-292cdc6ef04c"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UniformLengthGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/UniformLengthGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4d254427-b5a1-45ae-94c8-27324a934197"],
 " goes the other way: it discretizes a region by a graph with edges of one \
length."
}], "Notes",ExpressionUUID->"1103c8ac-75e3-49fd-b901-b928ef7e52f9"],

