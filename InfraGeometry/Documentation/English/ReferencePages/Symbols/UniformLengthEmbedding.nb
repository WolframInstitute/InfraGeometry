Cell["MaxIterations", "ExampleSubsection",ExpressionUUID->"914b47c7-2124-4d2e-a5e3-0c44b1e545b9"],

Cell["\<\
The third Sierpinski graph needs more than the default 500 steps: after 500 \
its edges lie between 0.88 and 1.18, after 5000 they have length 1.\
\>", "ExampleText",ExpressionUUID->"f0851b46-d22f-482a-8d66-bb9aafbf8778"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"IndexGraph", " ", "@", " ", 
      RowBox[{"SierpinskiGraph", "[", "3", "]"}]}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Graph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", 
           RowBox[{"UniformLengthEmbedding", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "steps"}]}], 
            "]"}]}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"steps", ",", " ", 
          RowBox[{"{", 
           RowBox[{"500", ",", " ", "5000"}], "}"}]}], "}"}]}], "]"}]}], ",", 
     "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"coordinates", " ", "=", " ", 
           RowBox[{"UniformLengthEmbedding", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "steps"}]}], 
            "]"}]}], "}"}], ",", " ", 
         RowBox[{"MinMax", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"EuclideanDistance", " ", "@@", " ", 
             RowBox[{"coordinates", "[", 
              RowBox[{"[", 
               RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
            "&"}], " ", "/@", " ", 
           RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"steps", ",", " ", 
         RowBox[{"{", 
          RowBox[{"500", ",", " ", "5000"}], "}"}]}], "}"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b2f9a45b-8b57-4a7a-8448-36c543725960"],

