Cell[CellGroupData[{

Cell["InitialEmbedding", "ExampleSubsection",ExpressionUUID->"2f777728-c7d2-4900-b358-aed8845054e3"],

Cell["\<\
A ball of the triangular tiling has unit edges in the plane in the \
coordinates of the tiling. Started from them, the relaxation keeps the unit \
edges; the default start does not reach them (see Possible Issues).\
\>", "ExampleText",ExpressionUUID->"5344c208-25e8-43ed-a2ff-251c7de8d4b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"IndexGraph", " ", "@", " ", 
      RowBox[{"TessellationNeighborhoodGraph", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "6"}], "}"}], ",", " ", "3"}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"coordinates", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"UniformLengthEmbedding", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}]}], "]"}], ",", 
       " ", 
       RowBox[{"UniformLengthEmbedding", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"\"\<InitialEmbedding\>\"", " ", "->", " ", 
          RowBox[{"GraphEmbedding", "[", "g", "]"}]}]}], "]"}]}], "}"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Graph", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"VertexCoordinates", " ", "->", " ", "c"}]}], "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "coordinates"}], "}"}]}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"MinMax", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"EuclideanDistance", " ", "@@", " ", 
           RowBox[{"c", "[", 
            RowBox[{"[", 
             RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
          "&"}], " ", "/@", " ", 
         RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "coordinates"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"91ca1b3e-7b2f-4167-9b0a-e54c4aa3756b"],

