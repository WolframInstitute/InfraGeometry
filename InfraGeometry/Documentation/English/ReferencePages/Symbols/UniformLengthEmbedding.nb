Cell["\<\
In the plane: a ball of the hexagonal tiling, the 6 \[Times] 6 grid and the \
12-cycle, all flexible:\
\>", "ExampleText",ExpressionUUID->"3d226480-5db6-45cb-a1c6-74a49250bf61"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"IndexGraph", "[", "graph", "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"UniformLengthEmbedding", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}]}], "]"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"Graph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"VertexCoordinates", " ", "->", " ", "c"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"Round", "[", 
          RowBox[{
           RowBox[{"MinMax", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"EuclideanDistance", " ", "@@", " ", 
               RowBox[{"c", "[", 
                RowBox[{"[", 
                 RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
              "&"}], " ", "/@", " ", 
             RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}], ",", " ", "0.01"}],
           "]"}]}]}], "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"TessellationNeighborhoodGraph", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"6", ",", " ", "3"}], "}"}], ",", " ", "5"}], "]"}], ",", 
        " ", 
        RowBox[{"GridGraph", "[", 
         RowBox[{"{", 
          RowBox[{"6", ",", " ", "6"}], "}"}], "]"}], ",", " ", 
        RowBox[{"CycleGraph", "[", "12", "]"}]}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3aa957d3-cf32-42f1-b075-5f59533afc3b"],

