Cell["\<\
From the default start the same rigid ball stops short of unit edges, which \
end between 0.86 and 1.15:\
\>", "ExampleText",ExpressionUUID->"85bbf204-3190-4261-a7e0-c0a9c2f3d532"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"IndexGraph", " ", "@", " ", 
      RowBox[{"TessellationNeighborhoodGraph", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "6"}], "}"}], ",", " ", "3"}], "]"}]}]}], 
    "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"UniformLengthEmbedding", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"Graph", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"VertexCoordinates", " ", "->", " ", "c"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"MinMax", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"EuclideanDistance", " ", "@@", " ", 
            RowBox[{"c", "[", 
             RowBox[{"[", 
              RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", 
           "&"}], " ", "/@", " ", 
          RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}], ",", " ", "0.01"}], 
       "]"}]}], ",", "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2f199eb8-3945-4367-98d2-da06592139af"],

