Cell[CellGroupData[{
Cell["UniformLengthEmbedding", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"94c465dc-0347-40ef-b346-155d4e3494db"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["UniformLengthEmbedding"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/UniformLengthEmbedding", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e387a698-bb3e-41d6-b626-999de99e5680"],
 "\[LineSeparator]",
 "gives coordinates for the vertices of ",
 StyleBox["g", "TI"],
 ", in the order of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VertexList"]], "paclet:ref/VertexList"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9db97706-840d-4335-b871-b9370e354a3d"],
 ", under which the edges of ",
 StyleBox["g", "TI"],
 " are relaxed towards length 1.",
 "\n"
}], "Usage",ExpressionUUID->"78d54155-9cc1-4d8c-b043-20829fbcac36"],

Cell[TextData[{
 "A unit-distance embedding is a map ",
 StyleBox["f : V \[RightArrow] \:211d\:1d48", "TI"],
 " with ",
 StyleBox["\:2016f(u) \[Minus] f(v)\:2016 = 1", "TI"],
 " for every edge ",
 StyleBox["uv", "TI"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UniformLengthEmbedding"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/UniformLengthEmbedding", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7e91d312-6be1-49cb-a5b6-789474af0b40"],
 " looks for one: it starts from the spring-electrical layout scaled to mean \
edge length 1, and at every step moves the two ends of each edge by half of \
what brings it to length 1."
}], "Notes",ExpressionUUID->"0227cfd6-634d-4246-9e33-56f7bc3f728c"],

Cell["\<\
A flexible graph, such as a grid or a ball of the hexagonal tiling, has many \
unit-distance embeddings and the relaxation finds one. A rigid one, such as a \
ball of the triangular tiling, has essentially one, and the relaxation can \
stop short of it. A graph with no unit-distance embedding in \:211d\:1d48, \
such as the complete graph on four vertices in the plane, ends with edges \
spread about 1.\
\>", "Notes",ExpressionUUID->"e6b9cf37-5713-46b0-9f21-4efc5f20e0ae"],

Cell[TextData[{
 "The result has the shape of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphEmbedding"]], "paclet:ref/GraphEmbedding"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a53faa2c-45c0-4f79-b375-b1ee3d08fe7a"],
 "[",
 StyleBox["g", "TI"],
 "]: draw it with ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Graph",
    BaseStyle->"Link"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{
     ButtonBox["VertexCoordinates",
      BaseStyle->"Link"], " ", "->", " ", 
     RowBox[{"UniformLengthEmbedding", "[", 
      StyleBox["g", "TI"], "]"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "076d2937-ca3d-4454-83ae-60932db5e6a8"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UniformLengthGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/UniformLengthGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "703b920e-edd7-4d41-85e3-31831be6d4bc"],
 " goes the other way, from a region to a graph with edges of one length."
}], "Notes",ExpressionUUID->"c26e230b-79d1-489a-af4a-8689de9595f3"],

