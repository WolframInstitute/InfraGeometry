Cell["\<\
Four points in the plane cannot be pairwise at distance 1, so the complete \
graph on four vertices gets no unit edges there.\
\>", "ExampleText",ExpressionUUID->"c2b5a1aa-8415-464c-8783-0dd9cc74e8b0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"coordinates", " ", "=", " ", 
     RowBox[{"UniformLengthEmbedding", "[", 
      RowBox[{
       RowBox[{"CompleteGraph", "[", "4", "]"}], ",", " ", 
       RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"CompleteGraph", "[", "4", "]"}], ",", " ", 
       RowBox[{"VertexCoordinates", " ", "->", " ", "coordinates"}]}], "]"}], 
     ",", " ", 
     RowBox[{"MinMax", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"EuclideanDistance", " ", "@@", " ", 
         RowBox[{"coordinates", "[", 
          RowBox[{"[", 
           RowBox[{"List", " ", "@@", " ", "#"}], "]"}], "]"}]}], " ", "&"}], 
       " ", "/@", " ", 
       RowBox[{"EdgeList", "[", 
        RowBox[{"CompleteGraph", "[", "4", "]"}], "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e231afea-86a1-4fb8-a3e2-2934bdee077a"],

