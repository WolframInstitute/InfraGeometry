Cell[TextData[{
 "A call with ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57c4f06d-398f-4a78-be42-f802f7f0f163"],
 " and no hard rule that bounds the class is refused, since a stopping \
condition may never fire; so is a bare integer as ",
 StyleBox["kspec", "TI"],
 ". Both calls stay unevaluated, which ",
 Cell[BoxData["MatchQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c4e73e7b-0bc1-4c24-9e49-b7fccd140ee5"],
 " tests."
}], "ExampleText",ExpressionUUID->"ce61ebce-1f97-43c2-b3a5-4f0b77fcbeb3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MatchQ", "[", 
      RowBox[{
       RowBox[{"FindInfraWalk", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "Infinity", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", "}"}]}]}], "]"}], ",", " ", "_FindInfraWalk"}], "]"}], 
     ",", " ", 
     RowBox[{"MatchQ", "[", 
      RowBox[{
       RowBox[{"FindInfraWalk", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "3", ",", " ", "All"}], "]"}], ",",
        " ", "_FindInfraWalk"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"46227dc3-5c3b-478b-a2c7-2b2fadc4f8fc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f9bc1410-91f9-458d-9cec-7c45196b83f8"]
}, Open  ]],

Cell[TextData[{
 "Under ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fea7945c-a47b-4209-af41-0e3cb1aeb343"],
 " the weights are ignored, so a soft rule changes nothing: the walk is the \
canonical walk of the hard rules."
}], "ExampleText",ExpressionUUID->"998fdd33-7296-4216-857c-b45983c1aa0e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FindInfraWalk", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", 
       RowBox[{"{", "4", "}"}], ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Simple\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<Shortest\>\"", ",", " ", "3", ",", " ", "0.01"}], 
           "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]}], 
      "]"}], " ", "===", "\n", "    ", 
     RowBox[{"FindInfraWalk", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", 
       RowBox[{"{", "4", "}"}], ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Simple\>\"", "}"}]}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0d058f20-0204-4d9f-983f-b02971e33335"],

