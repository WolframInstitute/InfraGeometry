Cell[TextData[{
 "A call with ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba09cc74-7dcb-4fa3-a23e-e45bfaa20afc"],
 " and no rule that bounds the class is refused, since a stopping condition \
may never fire; so is a bare integer as ",
 StyleBox["kspec", "TI"],
 ". Both calls stay unevaluated, which ",
 Cell[BoxData["MatchQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1599b64d-dba1-4886-8e44-1c2c58b945dc"],
 " tests."
}], "ExampleText",ExpressionUUID->"5ba76d7c-c42c-4e1f-9647-6fd190318d08"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MatchQ", "[", 
      RowBox[{
       RowBox[{"FindInfraWalk", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "Infinity", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", "}"}]}]}], "]"}], ",", " ", "_FindInfraWalk"}], "]"}], 
     ",", " ", 
     RowBox[{"MatchQ", "[", 
      RowBox[{
       RowBox[{"FindInfraWalk", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "3", ",", " ", "All"}], "]"}], ",",
        " ", "_FindInfraWalk"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"64e1ec8c-8e2a-48e4-b27d-1b7cc5523e62"],

