Cell[CellGroupData[{

Cell["Properties", "ExampleSubsection",ExpressionUUID->"ff3adbfe-e686-43f6-840a-4f753ebcabfd"],

Cell["\<\
The class widens from the simple walks to every walk of at most 4 edges.\
\>", "ExampleText",ExpressionUUID->"b2dc457b-8ff4-4628-b385-146e95e7a888"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"walks", " ", "=", " ", 
          RowBox[{"FindInfraWalk", "[", 
           RowBox[{"g", ",", " ", "a", ",", " ", 
            RowBox[{"UpTo", "[", "4", "]"}], ",", " ", "All", ",", " ", 
            RowBox[{"Properties", " ", "->", " ", "rules"}]}], "]"}]}], "}"}],
         ",", "\n", "      ", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"walks", ",", " ", "a"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"rules", ",", " ", "\"\<: \>\"", ",", " ", 
             RowBox[{"Length", " ", "@", " ", "walks"}]}], "}"}], "]"}]}], 
         "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"rules", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "\"\<Simple\>\"", "}"}], ",", " ", 
          RowBox[{"{", "\"\<Immersed\>\"", "}"}], ",", " ", 
          RowBox[{"{", "}"}]}], "}"}]}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"61724e2d-5e95-4bfa-a574-66a3b07e897e"],

