Cell["\<\
Three walks of 9 edges from the centre of a mesh, the soft straightness at \
window 5 with weights 1, 0.3 and 0.01: from the random walk to a nearly \
straight one.\
\>", "ExampleText",ExpressionUUID->"50e0f88c-69ab-4c32-a097-94c195ed4755"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", "\n", "      ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
            RowBox[{"FindInfraWalk", "[", 
             RowBox[{"g", ",", " ", "c", ",", " ", 
              RowBox[{"UpTo", "[", "9", "]"}], ",", " ", 
              RowBox[{"Properties", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"{", 
                 RowBox[{"\"\<Shortest\>\"", ",", " ", "5", ",", " ", "p"}], 
                 "}"}], "}"}]}], ",", " ", 
              
              RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
               "RandomSample"}]}], "]"}]}], ")"}], ",", " ", "c"}], "}"}], ",",
         "\n", "      ", 
        RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0.3", ",", " ", "0.01"}], "}"}]}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c61db594-2ded-4684-9749-7823a23ef2ee"],

