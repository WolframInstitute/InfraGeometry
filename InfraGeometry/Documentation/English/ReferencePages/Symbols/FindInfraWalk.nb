Cell[TextData[{
 "A call with ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f9955a1-9bff-494a-9f90-4a6508c92b31"],
 " and no hard rule that bounds the class is refused, since a stopping \
condition may never fire; so is a bare integer as ",
 StyleBox["kspec", "TI"],
 ". Both calls stay unevaluated, which ",
 Cell[BoxData["MatchQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41fb02f3-dc11-44b5-b998-a575f808a2da"],
 " tests."
}], "ExampleText",ExpressionUUID->"5f2c6777-25da-4a58-981f-830bfc160c8d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MatchQ", "[", 
      RowBox[{
       RowBox[{"FindInfraWalk", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "Infinity", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", "}"}]}]}], "]"}], ",", " ", "_FindInfraWalk"}], "]"}], 
     ",", " ", 
     RowBox[{"MatchQ", "[", 
      RowBox[{
       RowBox[{"FindInfraWalk", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "3", ",", " ", "All"}], "]"}], ",",
        " ", "_FindInfraWalk"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cce7ab43-9c60-442c-be59-90f2ddd94db4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"59492815-43ad-4201-8a1e-cf20e5f2f41d"]
}, Open  ]],

Cell[TextData[{
 "A soft rule under ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bd9b75e-c1f8-42d0-a62d-ce67d4b80f48"],
 " stays unevaluated, since the order would drop the weights; so does a \
weighted ",
 Cell[BoxData["\"\<Stretched\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5508e0a6-f6df-449e-b5c6-f78bb2088134"],
 "."
}], "ExampleText",ExpressionUUID->"1b421a9d-f40c-483b-9129-225599152302"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MatchQ", "[", 
      RowBox[{
       RowBox[{"FindInfraWalk", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", 
         RowBox[{"{", "4", "}"}], ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"\"\<Shortest\>\"", ",", " ", "3", ",", " ", "0.3"}], 
            "}"}], "}"}]}], ",", " ", 
         RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]}],
         "]"}], ",", " ", "_FindInfraWalk"}], "]"}], ",", "\n", "   ", 
     RowBox[{"MatchQ", "[", 
      RowBox[{
       RowBox[{"FindInfraWalk", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", 
         RowBox[{"{", "4", "}"}], ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"\"\<Stretched\>\"", ",", " ", "3", ",", " ", "0.3"}], 
            "}"}], "}"}]}]}], "]"}], ",", " ", "_FindInfraWalk"}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8f8986d0-eea0-4157-b61d-4392ba3c67ab"],

