Cell[TextData[{
 "A call with ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539a336f-d865-4f45-b112-73cbf243ff80"],
 " and no rule that bounds the class is refused, since a stopping condition \
may never fire; so is a bare integer as ",
 StyleBox["kspec", "TI"],
 ". Both calls stay unevaluated, which ",
 Cell[BoxData["MatchQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9406681f-9263-42a8-b7f1-69eeddc1d2cb"],
 " tests."
}], "ExampleText",ExpressionUUID->"92540970-285f-4390-80f7-b714a6a2f3ab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MatchQ", "[", 
      RowBox[{
       RowBox[{"FindInfraWalk", "[", 
