      FontSize->0.9 Inherited,ExpressionUUID->
      "2a3f3cc5-54ec-4f04-a7ed-0214de721a6e"],
     " (no repeated vertex), ",
     Cell[BoxData["\"\<Immersed\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7b18bff2-47b2-4f50-b07d-480db2ed5850"],
     " (no backtrack), ",
     Cell[BoxData["\"\<Generic\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e420c9ac-a5b4-4029-ab11-ef1de92c8085"],
     " (no cusp, self-tangency or triple point), ",
     Cell[BoxData[
      RowBox[{"\"\<Exclude\>\"", " ", "->", " ", "species"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "09a4bc5c-f1aa-4d1e-b1f1-5955bf5a16d0"],
     ", ",
     Cell[BoxData["\"\<Minimizing\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "275ea866-8f75-42f5-ba67-599469e9defb"],
     ", or a predicate on the window; ",
     Cell[BoxData[
      RowBox[{"{", "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c36a9588-0791-4a80-a6e8-ab85ba560fa0"],
     " is every walk"
    }], "TableText",ExpressionUUID->"f025ede4-f7ec-493e-b2ca-8a841c49602a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9cad1ac1-519a-4ecb-904a-d4dc9e0556d8"], Cell[TextData[Cell[
    BoxData["\"\<InfraScale\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f88e850b-d8b8-4a9e-8b26-ea23abf711bb"]], "TableText",ExpressionUUID->
     "2cc7634d-70de-40a7-ba6d-58cb1824d073"], Cell[TextData[Cell[BoxData[
    "Infinity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "dd365406-49a3-44e1-9988-6143b8404daa"]], "TableText",ExpressionUUID->
     "9d185b33-aab9-4bf7-b3d9-05bf8df5ee69"], Cell[
    "how many vertices back a rule sees", "TableText",ExpressionUUID->
     "0c44a64b-8b39-4d4e-a849-01ae38025e7a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "93b6a584-53f6-4ec5-b66b-83394f24503c"], Cell[TextData[Cell[
    BoxData["\"\<Direction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b33f350a-ab74-4539-8552-24ba387d15b1"]], "TableText",ExpressionUUID->
     "f0a549b5-74b2-41fb-9abf-736dbc4a0824"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d2ed9364-351f-481a-94ff-bb290ea0d584"]], "TableText",ExpressionUUID->
     "41e6cb2d-fc5f-4285-b2a5-0baec7ce3809"], Cell[TextData[{
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3fb4b5a4-a10f-4b98-aa08-71392cfda024"],
     ", ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "47a67a16-47ce-4fc9-b4f6-e923fe8d4c24"],
     " or ",
     Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5ebd9d94-1207-445c-b7c7-39fb5ae3a2c2"]
    }], "TableText",ExpressionUUID->"e629b086-2045-40ee-a79d-defb1ffef439"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "40e933fd-2fa4-429c-bf66-1afe55b0fb98"], Cell[TextData[Cell[
    BoxData["\"\<StoppingCondition\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "e13bf612-6611-4f42-9362-6158127a7de5"]], "TableText",ExpressionUUID->
     "c882625d-f703-4bbb-9af5-d473078a3364"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f04109fb-c70f-40ce-97e0-0211bb4d1b1f"]], "TableText",ExpressionUUID->
     "377c53da-ae46-4190-84d1-e57bb9104039"], Cell[TextData[{
     StyleBox["n", "TI"],
     " (stop at the ",
     StyleBox["n", "TI"],
     "-th return to a visited vertex), a predicate on the walk so far, or ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"spec", ",", " ", 
        RowBox[{"\"\<Delay\>\"", " ", "->", " ", "k"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b1664219-83ef-4e9a-a295-adc4cfee6a49"]
    }], "TableText",ExpressionUUID->"50631ca7-6a82-4134-83d9-a0ba0347c437"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5d7950e0-8e67-438b-af96-fe3510b10ee6"], Cell[TextData[Cell[
    BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "94081bf6-595d-4743-9721-e681a9a0b2a9"]], "TableText",ExpressionUUID->
     "a2f1ffcb-8384-4acc-ac06-b309cace452e"], Cell[TextData[Cell[BoxData[
    "Identity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "46cdb14e-8007-4e14-af8c-627270d6deb3"]], "TableText",ExpressionUUID->
     "09b51d10-5b5d-47a0-bb5d-67a4a3f6727c"], Cell[TextData[{
     "a function of the candidate windows -- the window with one admissible \
candidate appended -- giving the ones to pursue, in the order to try: ",
     Cell[BoxData["Identity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5355ff3a-9203-439b-8206-619c3cefeca2"],
     " the canonical order, ",
     Cell[BoxData["RandomSample"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c560932a-3099-4e3d-862f-5054cac710e9"],
     " a random order, ",
     Cell[BoxData["RandomChoice"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a305ea1a-e8de-4689-b2b5-538698101c73"],
     " the random walk, ",
     Cell[BoxData[
      RowBox[{"MinimalBy", "[", "f", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "39373c16-6924-462c-819f-67d14e75baef"],
     " the candidates least by ",
     Cell[BoxData[
      RowBox[{"f", "[", "window", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6ce3c65b-ef7f-4beb-b38d-b70311bf07cc"],
     ", ",
     Cell[BoxData[
      RowBox[{
       RowBox[{"RandomSample", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"UpTo", "[", "n", "]"}]}], "]"}], " ", "&"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "aba0dff9-ae32-4e99-8881-eea11fc82a85"],
     " a pruning to ",
     StyleBox["n", "TI"],
     " branches per node"
    }], "TableText",ExpressionUUID->"92ee044d-7ae5-4b9d-92bd-e8b0dd2b3df5"]}
  }]], "3ColumnTableMod",ExpressionUUID->"63c2cfcb-bec6-45b7-b42f-\
b5348998e9dc"],

Cell[TextData[{
 "The default ",
 Cell[BoxData["\"\<Direction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dcb51b86-b0eb-4e86-8fd1-1876fbb74d49"],
 " is ",
 Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6ca4b6a-ab0f-4309-a046-7ae36325571a"],
 " on a one-vertex germ and ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b97c56fd-c933-4b62-aedc-56fbc624fe26"],
 " on a longer one. With a stopping condition it is ",
 Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea205d66-c90c-4a1b-b01d-9f751213c89f"],
 " for every germ, since the condition needs one tip, and an explicit ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539998f4-b6c0-4609-87a3-f6a44941a1df"],
 " with a condition leaves the call unevaluated. In a list of germs the \
default is read per germ."
}], "Notes",ExpressionUUID->"7d34ef3c-f177-4398-b98d-5306a747992d"],

Cell["\<\
A walk stops when a stopping condition fires, the budget is spent, or no \
admissible step remains.\
\>", "Notes",ExpressionUUID->"cafbfe3c-28bc-4a82-aa06-653090417632"],

Cell[TextData[{
 "An endpoint is a stopping condition. ",
 Cell[BoxData[
  RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "q"}], " ", "&"}], 
    ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc106002-fc36-407a-a4a5-bd7d27417da6"],
 " stops each walk at its first arrival at ",
 StyleBox["q", "TI"],
 "; the result is every maximal walk of the class, and the ones that end at \
",
 StyleBox["q", "TI"],
 " are the walks from the germ to ",
 StyleBox["q", "TI"],
 ". A shortest path between two points is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "615639b0-e0e0-4a8c-8bb5-92fde047b615"],
 "; the walk family has no two-point form. In the classes ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82b80ba9-7892-4383-9177-e54fe24ba24a"],
 " and ",
 Cell[BoxData[
  RowBox[{"{", "\"\<Immersed\>\"", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c4a0133-69c0-4280-9a7d-905974b425c5"],
 " a walk can pass ",
 StyleBox["q", "TI"],
 " before it ends there; those walks are reached with an exact budget ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d1c1167-f3f0-4515-82d8-203af0790846"],
 " and the same selection, without the condition."
}], "Notes",ExpressionUUID->"d24294cd-b583-4f13-88ff-c2089e3c1016"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "59206afd-b4c5-46b2-bcb4-02773ee85837"],
 " is this call at ",
 Cell[BoxData[
  RowBox[{"\"\<InfraScale\>\"", " ", "->", " ", "s"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9bad61fb-2f23-4b10-9fb3-600222634f72"],
 " with ",
 Cell[BoxData["\"\<Minimizing\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2b7f1bb-5ec2-4ace-89d2-a612f0b2df96"],
 " added to the rules."
}], "Notes",ExpressionUUID->"faaffae0-c273-4582-81ae-e73c7016ff92"]
}, Open  ]],

