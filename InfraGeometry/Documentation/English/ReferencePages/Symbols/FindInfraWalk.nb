     "fdef8625-c3d4-43c2-94d8-f22ccd67cf6c"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "06429e57-afa8-460f-9719-7d93ec74f054"]], "TableText",ExpressionUUID->
