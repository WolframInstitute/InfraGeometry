Cell["The same germ grown forward only.", "ExampleText",ExpressionUUID->"9af3ffda-cdbb-4c32-8a3d-a758f2a4c4af"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"germ", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}]}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{"FindInfraWalk", "[", 
      RowBox[{"g", ",", " ", "germ", ",", " ", 
       RowBox[{"UpTo", "[", "2", "]"}], ",", " ", "All", ",", " ", 
       RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<Forward\>\""}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"walks", ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
         "germ"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "walks"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"b9a3ac1d-d431-410b-90c7-7d6f8945d972"],

