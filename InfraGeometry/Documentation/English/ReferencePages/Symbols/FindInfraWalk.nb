Notebook[{

Cell[CellGroupData[{
Cell["FindInfraWalk", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"11d0b1e1-a682-46ec-93f1-91438183fde2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f6cd61b-1b1e-4330-a925-cde523107e87"],
 "\[LineSeparator]",
 "gives one walk grown from ",
 StyleBox["germ", "TI"],
 " in the class cut by ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8866b369-8925-4175-baf4-dada94700834"],
 ", until a stopping condition fires or the budget ",
 StyleBox["kspec", "TI"],
 " is spent.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b1771a09-7feb-40f2-8d0e-a774101ccc49"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10f28756-5132-43fc-a997-d7920c341bf5"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e45c9b28-a5dd-4be2-8fc0-a5dd538509f4"],
 " of exactly ",
 StyleBox["n", "TI"],
 " walks or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb688931-f581-437e-9dfc-9ba0598cbf5a"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "451fa73d-76bb-4d95-9c17-99195854e4e3"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20f30f79-661b-4f53-9731-8cb09b00192c"],
 " gives every one."
}], "Usage",ExpressionUUID->"5c4b9eec-9d98-4485-8df9-5a1827d8fee1"],

Cell[TextData[{
 "The germ is the seed of the walk: a vertex, a vertex list, a walk graph, or \
a list of germs. A vertex is the one-vertex germ, so ",
 Cell[BoxData[
  RowBox[{"FindInfraWalk", "[", 
   RowBox[{"g", ",", " ", "p", ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d25e9286-ccec-408a-9c97-c82878e0bbfa"],
 " and ",
 Cell[BoxData[
  RowBox[{"FindInfraWalk", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"{", "p", "}"}], ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b900dd2e-65fa-4363-a1ef-d26979e47c93"],
 " are the same call. A germ is read as a vertex first, so on a substrate \
labelled by lists the vertex ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "1"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "792510c1-f1e0-4a43-824d-778989d3853c"],
 " is one point, not the walk of its entries. A walk graph is read as its \
vertex sequence; a list of germs gives the walks grown from each."
}], "Notes",ExpressionUUID->"df044c9b-0c72-43c8-9efd-bfb9422a3b67"],

Cell[TextData[{
 StyleBox["kspec", "TI"],
 " is the budget in edges added on each growing side: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4e0b93c-a0e9-40b0-a6a6-48cf3f5d7eeb"],
 " (at most ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e05f44cb-bacc-4413-b1c7-64bfef1546b0"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b2e86b3-93aa-48ea-8813-f86ed37d2e51"],
 ", or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38a3374c-ac2b-4771-8ff4-33ad1f0b4866"],
 ". A bare integer is no ",
 StyleBox["kspec", "TI"],
 ". ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f44586dd-3719-464f-81d2-727013ea02c7"],
 " is legal only when a rule of the class bounds it, as the default ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03cc45fb-2fdd-40ce-a1d5-3e64deafbd88"],
 " does."
}], "Notes",ExpressionUUID->"c752421f-5637-4690-ba99-a251b325e4a5"],

Cell[TextData[{
 "A walk is a graph: a directed path graph on the pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "v"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "977debbe-a3d3-4bea-bc17-ef2ab76f5e22"],
 ", the position and the vertex. ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5e8b1c2-50cc-4bdc-9508-5f031ba45873"],
 " is its vertex sequence. The count-less call returns one walk graph, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4b15132-9af7-45b8-bd3e-7c79dea640b7"],
 " when there is none. The first walk is the first branch of the descent, a \
witness, not a shortest path."
}], "Notes",ExpressionUUID->"d7c76d4c-140e-442b-9484-57fb4ec45135"],

Cell[TextData[{
 "The class is cut by ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e8b5885-60f2-4176-8613-3e6a4e601e9e"],
 ", each rule read on the window of the last ",
 Cell[BoxData["\"\<InfraScale\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4f269a7-5a74-465b-9460-80227fd16e4b"],
 " vertices with the candidate:"
}], "Notes",ExpressionUUID->"75717e70-4cb3-462e-bcad-c14241c242a2"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "10f00e9f-a730-4f7a-98d7-f82e939fe382"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"9c3a3665-9b6f-42ba-8501-0a1dbd423fab"],
