Cell[TextData[{
 "At weight 1 a rule is off, and with no other soft rule the default order is \
canonical, not random: the walk of every-walk class goes back and forth on \
one edge. Write ",
 Cell[BoxData["RandomSample"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ccdb6a76-a051-4130-af60-cacc0e7964e1"],
 " for a random walk."
}], "ExampleText",ExpressionUUID->"e7dd9bf7-6f7b-45fa-ae53-05f22ac57547"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Last", " ", "/@", " ", 
      RowBox[{"VertexList", " ", "@", " ", 
       RowBox[{"FindInfraWalk", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", 
         RowBox[{"{", "4", "}"}], ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"\"\<Shortest\>\"", ",", " ", "3", ",", " ", "1"}], "}"}],
            "}"}]}]}], "]"}]}]}], ",", "\n", "   ", 
     RowBox[{"Last", " ", "/@", " ", 
      RowBox[{"VertexList", " ", "@", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
         RowBox[{"FindInfraWalk", "[", 
          RowBox[{"g", ",", " ", "a", ",", " ", 
           RowBox[{"{", "4", "}"}], ",", " ", 
           RowBox[{"Properties", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"\"\<Shortest\>\"", ",", " ", "3", ",", " ", "1"}], 
              "}"}], "}"}]}], ",", " ", 
           
           RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
            "RandomSample"}]}], "]"}]}], ")"}]}]}]}], "}"}]}], "]"}]], "Input",\

