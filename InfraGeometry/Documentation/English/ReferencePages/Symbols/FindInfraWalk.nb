     "4545f5ae-8e05-42e1-b06f-6bf609e70fb3"], Cell[
    "a predicate on the walk so far", "TableText",ExpressionUUID->
     "4d5f96e6-3554-4126-9eca-954c1ad22e2f"]}
  }]], "3ColumnTableMod",ExpressionUUID->"e7842303-6ee9-4346-931e-\
c31e3b041ae2"],

Cell[TextData[{
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f25209d7-fbe9-4350-abbd-e2fec7655c51"],
 " turns the surviving candidates and their weights into the order they are \
tried:"
}], "Notes",ExpressionUUID->"0c0e4395-b1c9-4537-bfaf-3581427960c9"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "917af254-1832-4913-af80-94e26e5e2485"], Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"bdb24be1-72f1-428f-9f4e-f35ce2718ff2"],
     Cell["Order", "TableText",
     FontWeight->Bold,ExpressionUUID->"3809b068-72f6-4734-b9b4-cca2d2951f40"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b2a23947-9c81-4d40-a3a5-5bb309f71b24"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9c7980eb-d6eb-45f0-b2be-054a702a0b5a"]], "TableText",ExpressionUUID->
     "82c87ce1-4b11-482d-b7be-34c77fe3d02e"], Cell[TextData[{
     "canonical with hard rules only; ",
     Cell[BoxData["RandomSample"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "cca47f60-acfe-434c-ab37-00daacc5b960"],
     " by the weights once a rule is soft"
    }], "TableText",ExpressionUUID->"77027bdb-5aff-44bb-8549-78ee12d2a2dd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2d2c7abe-1497-4661-83be-c75d7d0a0b17"], Cell[TextData[Cell[BoxData[
    "Identity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3b40cb8b-100f-45b2-b3d4-1161305104e8"]], "TableText",ExpressionUUID->
     "5acc7cb5-bd83-4417-918a-55d3fa29791a"], Cell[
    "canonical", "TableText",ExpressionUUID->
     "f2001c8e-08e2-4a1c-940e-6ce86e8c7041"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e0d6066c-0c56-4d04-853c-a4010d1e2f21"], Cell[TextData[Cell[BoxData[
    "RandomSample"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "828ae7c9-a9eb-43e7-aabb-edb0f9b78edd"]], "TableText",ExpressionUUID->
     "cba9e1c9-20d0-49e1-b525-1af3569ec646"], Cell[
    "random by the weights, uniform without a soft rule", "TableText",
     ExpressionUUID->"4bb4b2d7-bb20-435a-bb39-e4379c842961"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7224441f-cbb2-4f95-be78-8f380a855f2b"], Cell[TextData[Cell[BoxData[
    "RandomChoice"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "70d3a516-25f0-419c-bd91-519b9d3bace1"]], "TableText",ExpressionUUID->
     "d913dd92-cd20-403e-a314-85763f5c4697"], Cell["\<\
one candidate drawn by the weights: the random walk, which never backtracks\
\>", "TableText",ExpressionUUID->"f29dea4d-d030-4b2f-ac19-dde2941f3e7b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "cf1581fb-5659-434d-abe7-37b941bdad37"], Cell[TextData[{
     StyleBox["f", "TI"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"f", ",", " ", "r"}], "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c25431ca-c064-4531-b932-6fe93c9b645b"]
    }], "TableText",ExpressionUUID->"ea57abc5-47c5-4f23-855a-c46184e71403"], 
    Cell[TextData[{
     Cell[BoxData["f"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "72d81715-b024-4ed2-a586-980ec86138d6"],
     " of the candidate windows, whole or of scale ",
     StyleBox["r", "TI"],
     ", giving the ones to pursue in order"
    }], "TableText",ExpressionUUID->"f146e8b3-bb7e-412b-b63b-10eccc7f7ff9"]}
  }]], "2ColumnTableMod",ExpressionUUID->"3594636e-e9b9-4702-a403-\
9171f8b42946"],

Cell[TextData[{
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fbf90e64-62c3-4cfd-bc8a-651bf32ce527"],
 " and a function do not see the weights, so with a soft rule they leave the \
call unevaluated. ",
 Cell[BoxData["RandomSample"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11a95787-3600-4e24-947a-855638450d6d"],
 " is a permutation, so ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bdf71ce6-3bc7-4b29-9f52-f156b50518ad"],
 " is the whole class whatever the weights. Under ",
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bfe64965-6b50-40dd-9eb2-8297f0dbc131"],
 " the count ",
 StyleBox["n", "TI"],
 " is ",
 StyleBox["n", "TI"],
 " independent runs from the germ, and the runs that met ",
 StyleBox["kspec", "TI"],
 " are returned; a pruning to ",
 StyleBox["m", "TI"],
 " branches per step is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"RandomSample", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"UpTo", "[", "m", "]"}]}], "]"}], " ", "&"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bb5c152-7f89-4dcb-b5ab-29f8cc9dca77"],
 "."
}], "Notes",ExpressionUUID->"91f90347-106c-4d21-9b7d-a18fbeed2735"],

Cell[TextData[{
 Cell[BoxData["\"\<Direction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47bae9ca-6d1a-4b9c-acd0-48414b2337d8"],
 " says where the walk grows: ",
 Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d51a119-4f99-4878-ad93-601127e35ee9"],
 " after the last vertex of the germ, ",
 Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0965e82d-d0c5-4f14-9b58-890fb9d0da6b"],
 " before the first, ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65d759cd-872b-4ba8-888e-6912ee3533cd"],
 " at both ends. Under ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2496d5b-b553-4fe2-8f7c-c7baed9b690b"],
 " each outer step grows both ends, the front only or the back only, the hard \
",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "050527f9-1e02-4d56-a627-3af3cc96cd1d"],
 " and ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5de093f6-e9f1-45bd-927b-e8641debeee7"],
 " are checked again on the window holding both new ends, and the budget is \
the edges added on the longer side."
}], "Notes",ExpressionUUID->"65c78cc1-431b-49ff-87b0-2837660544ed"],

Cell[TextData[{
 Cell[BoxData["\"\<StoppingCondition\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "500f4b4b-6931-42d1-b27b-28cf3e4760cb"],
 " is a predicate on the whole walk so far, its vertex sequence, read after \
every step and on the germ once it has an edge. It can test both tips, and \
when it fires the walk stops on both sides. A walk also stops when the budget \
is spent or no admissible step remains."
}], "Notes",ExpressionUUID->"31d014e5-d461-42a6-9610-d82ced197b57"],

Cell[TextData[{
 "An endpoint is a stopping condition. ",
 Cell[BoxData[
  RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "q"}], " ", "&"}], 
    ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "597c14ae-3560-4981-b00c-ea64a9b1baf5"],
 " stops each walk at its first arrival at ",
 StyleBox["q", "TI"],
 "; the walks that end at ",
 StyleBox["q", "TI"],
 " are the walks from the germ to ",
 StyleBox["q", "TI"],
 ". A shortest path between two points is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d9efe15e-970a-4b23-826a-d4802219df5a"],
 "; the walk family has no two-point form."
}], "Notes",ExpressionUUID->"64a6841a-ec0e-4d6f-9687-88b1cbab8494"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "86e73a2c-6159-4580-a31e-a0a87bd55694"],
 " is this call with ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Shortest\>\"", ",", " ", "s"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49e35fc8-60af-4ac4-8657-d96d3835e8c0"],
 " first among the rules."
}], "Notes",ExpressionUUID->"4bdd321d-9038-48fb-83b2-4091076ce105"]
}, Open  ]],

