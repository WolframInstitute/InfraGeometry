    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a7fe4637-4fec-4dee-8429-e6a0e40c566e"]], "TableText",ExpressionUUID->
     "912e7621-ae67-4327-a256-214009da0752"], Cell[
    "a predicate on the walk so far", "TableText",ExpressionUUID->
     "28752970-c8b0-4cf7-9efe-990ce6dd3a6e"]}
  }]], "3ColumnTableMod",ExpressionUUID->"50f37a8f-2fa9-4d4e-96ff-\
15a8265f6931"],

Cell[TextData[{
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b4c4df3-b134-4aa0-88f5-5505c33ffb4c"],
 " turns the surviving candidates and their weights into the order they are \
tried:"
}], "Notes",ExpressionUUID->"475abae2-41bb-4b4c-8e2d-f05e981e4360"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "994f2017-dfea-4651-bbc5-5c34cca6e7a2"], Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"4656190c-67f4-4e4f-bff1-30bada0f05c2"],
     Cell["Order", "TableText",
     FontWeight->Bold,ExpressionUUID->"0a68a5b6-3708-4f06-9b26-66d6ea27a84e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1bef8a51-dc81-4826-b59b-0cd8b9258776"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "e0230ec4-eca8-477f-80e9-9a9134ff68f9"]], "TableText",ExpressionUUID->
     "70b171ed-5ffb-482f-ab96-2e49b64380ca"], Cell[TextData[{
     "canonical with hard rules only; ",
     Cell[BoxData["RandomSample"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5d59488c-bba9-4384-a18f-786e474d258a"],
     " by the weights once a rule is soft"
    }], "TableText",ExpressionUUID->"cd265fa7-3334-4396-86bb-76d3cb175273"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "df4bcc23-0dba-4dbe-81e5-4c9e521cea26"], Cell[TextData[Cell[BoxData[
    "Identity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "152ea2d0-0cd7-4c8f-9374-7fd991351191"]], "TableText",ExpressionUUID->
     "c7f18354-588a-481e-af9e-07ae2ef801c2"], Cell[
    "canonical, the weights ignored", "TableText",ExpressionUUID->
     "38e64142-54f0-444d-9844-30cda4effcf8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "dad590a9-030e-43d2-a4c3-ab56e38094dd"], Cell[TextData[Cell[BoxData[
    "RandomSample"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1984e848-9230-4321-962a-d154befec61e"]], "TableText",ExpressionUUID->
     "2db889ef-e002-4e33-9f32-47efd8d6c94b"], Cell[
    "random by the weights, uniform without a soft rule", "TableText",
     ExpressionUUID->"563798ef-f43f-4df2-beba-6d2aa1f8f16a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1e066afa-075b-499c-9357-ec0ab7ed48f2"], Cell[TextData[Cell[BoxData[
    "RandomChoice"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0b80d00a-2895-46f2-a405-91167558e345"]], "TableText",ExpressionUUID->
     "2bc684bc-b976-41ef-b15d-54fb7ad699f9"], Cell["\<\
one candidate drawn by the weights: the random walk, which never backtracks\
\>", "TableText",ExpressionUUID->"9caa8bf9-1353-4baa-857e-3f690f664353"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7c20db3b-ae7a-4672-958d-7f761b96a352"], Cell[TextData[{
     StyleBox["f", "TI"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"f", ",", " ", "r"}], "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5b9f5070-d944-46f3-b6ab-eb1af88fae3c"]
    }], "TableText",ExpressionUUID->"58f0cba5-c925-41e2-b99f-9076e3feaef5"], 
    Cell[TextData[{
     Cell[BoxData["f"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a3fbc31c-b73c-4177-ad69-dd4f3392afcc"],
     " of the candidate windows, whole or of scale ",
     StyleBox["r", "TI"],
     ", giving the ones to pursue in order; the weights ignored"
    }], "TableText",ExpressionUUID->"5aa0a275-90a4-4498-859c-baa0b8a0bde8"]}
  }]], "2ColumnTableMod",ExpressionUUID->"d55467ca-9991-4a21-b7e5-\
cab17f03c99c"],

Cell[TextData[{
 "Every order works with every rule. ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5df3d395-4aeb-435d-8389-809a977f20e6"],
 " and a function do not see the weights, so under them a soft rule changes \
nothing. ",
 Cell[BoxData["RandomSample"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37b3c12a-a2ad-4bb0-b990-0c7cebbb6828"],
 " is a permutation, so ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88c8a294-00db-40c4-85c7-e71134067460"],
 " is the whole class whatever the weights. Under ",
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c60ea93-9aa2-42a9-8751-ebba12bc1757"],
 " the count ",
 StyleBox["n", "TI"],
 " is ",
 StyleBox["n", "TI"],
 " independent runs from the germ, and the runs that met ",
 StyleBox["kspec", "TI"],
 " are returned; a pruning to ",
 StyleBox["m", "TI"],
 " branches per step is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"RandomSample", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"UpTo", "[", "m", "]"}]}], "]"}], " ", "&"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fce2637-2011-46a4-b65c-4a19fc9559b9"],
 "."
}], "Notes",ExpressionUUID->"3d4cba78-3f2a-435b-a98e-cabf7a95fe8e"],

Cell[TextData[{
 Cell[BoxData["\"\<Direction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ddf5922-1510-4cb3-a6c1-e0419aca147a"],
 " says where the walk grows: ",
 Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "849b1958-d925-4951-bb93-c9c7d7a8b572"],
 " after the last vertex of the germ, ",
 Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5743cd3-ca1a-4b17-9138-18dc9eba5c9e"],
 " before the first, ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f314d822-a4d2-4dc8-8eec-ba08325475da"],
 " at both ends. Under ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "042ea78b-78c8-48f6-a8fe-495742b072cb"],
 " each outer step grows both ends, the front only or the back only, the hard \
",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b048d726-a72c-4124-9969-25933f61bd94"],
 " and ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3644db6-5d08-482f-b6f8-828e2493cae4"],
 " are checked again on the window holding both new ends, and the budget is \
the edges added on the longer side."
}], "Notes",ExpressionUUID->"93778b37-3d09-43c6-bf62-2b8e6cdc5527"],

Cell[TextData[{
 Cell[BoxData["\"\<StoppingCondition\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a068a2d4-3761-420f-b0dc-d66f80281b66"],
 " is a predicate on the whole walk so far, its vertex sequence, read after \
every step and on the germ once it has an edge. It can test both tips, and \
when it fires the walk stops on both sides. A walk also stops when the budget \
is spent or no admissible step remains."
}], "Notes",ExpressionUUID->"40216d3f-72f4-4a47-9e65-de74b72d2cb8"],

Cell[TextData[{
 "An endpoint is a stopping condition. ",
 Cell[BoxData[
  RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "q"}], " ", "&"}], 
    ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c02fdec-9f71-4a64-badb-80c45eb17e4d"],
 " stops each walk at its first arrival at ",
 StyleBox["q", "TI"],
 "; the walks that end at ",
 StyleBox["q", "TI"],
 " are the walks from the germ to ",
 StyleBox["q", "TI"],
 ". A shortest path between two points is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "16db4158-38c6-472e-87de-ffabdf7162d4"],
 "; the walk family has no two-point form."
}], "Notes",ExpressionUUID->"fa4b2828-10e0-410f-90b1-bf112d8454a3"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "27ca637b-0d45-45a6-bf1a-b6660a87c212"],
 " is this call with ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Shortest\>\"", ",", " ", "s"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84859b21-7fc8-4eee-9aaa-307a1bd3de7c"],
 " first among the rules."
}], "Notes",ExpressionUUID->"f90d593b-3062-42ed-ab2d-e07b85591c1e"]
}, Open  ]],

