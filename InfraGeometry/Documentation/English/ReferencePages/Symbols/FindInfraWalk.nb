Notebook[{

Cell[CellGroupData[{
Cell["FindInfraWalk", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2ca9ffd5-646e-44f1-996d-7e307f3df3be"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9e097db-1358-484f-ab3a-2ac2f6766b11"],
 "\[LineSeparator]",
 "gives one walk grown from ",
 StyleBox["germ", "TI"],
 " one step at a time under the rules of ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ada105ee-764f-469e-b024-0f786e85c8ca"],
 ", until a stopping condition fires or the budget ",
 StyleBox["kspec", "TI"],
 " is spent.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"96aede0b-e13b-4a56-ade5-2ea2f9c7ef1d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99ee45a4-43df-4998-be57-afb1cd1e4d54"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1415a29c-ebf9-495a-9992-e12d776a6c60"],
 " of exactly ",
 StyleBox["n", "TI"],
 " walks or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fe510fe-e650-4f73-b290-bfa0d6192bd7"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd7b2f8e-bed4-41db-b57d-668d8267e0fe"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b20dd834-04a5-48be-acbe-6960a8fb91f1"],
 " gives every one."
}], "Usage",ExpressionUUID->"d9a8fc15-5f0e-4c31-8f69-a8845ed9619d"],

Cell[TextData[{
 "The germ is the seed of the walk: a vertex, a vertex list, a walk graph, or \
a list of germs. A vertex is the one-vertex germ, so ",
 Cell[BoxData[
  RowBox[{"FindInfraWalk", "[", 
   RowBox[{"g", ",", " ", "p", ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cced501f-c49e-46b2-a7c8-a12a67ab6f58"],
 " and ",
 Cell[BoxData[
  RowBox[{"FindInfraWalk", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"{", "p", "}"}], ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7195856b-ab40-4dd3-af08-a42c7f946f51"],
 " are the same call. A germ is read as a vertex first, so on a substrate \
labelled by lists the vertex ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "1"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35314b5d-e06a-4cc2-b487-1e88114c41b9"],
 " is one point, not the walk of its entries. A walk graph is read as its \
vertex sequence; a list of germs gives the walks grown from each."
}], "Notes",ExpressionUUID->"2190eae5-4da2-461a-ad07-ac6bb67a52e8"],

Cell[TextData[{
 StyleBox["kspec", "TI"],
 " is the budget in edges added on each growing side: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a02d1f20-8115-4c85-a981-0f84c871a064"],
 " (at most ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd7698da-5dea-4181-ab75-bc6d4cf9101a"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05ff980c-0d54-4bc7-a78a-13472e8cf3c7"],
 ", or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1500654-5f1c-4f1e-a818-c8e3a2bf8177"],
 ". A bare integer is no ",
 StyleBox["kspec", "TI"],
 ". ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c14991fc-836c-455e-8be1-d30310d1990a"],
 " is legal only under a hard rule that bounds the class: a bare ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0367183-fd37-46cf-833b-13b95c29d5dc"],
 " or a bare ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8570055b-dbd6-4ec8-85d8-0396cbccd8f3"],
 "."
}], "Notes",ExpressionUUID->"1de90958-3b97-4347-9dcf-5619bc2b98d5"],

Cell[TextData[{
 "A walk is a graph: a directed path graph on the pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "v"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5581f0b0-7af9-47f6-9cc3-8b87cdc5c298"],
 ", the position and the vertex. ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9b31b76-b1b1-4133-a9f3-be73d5d4435f"],
 " is its vertex sequence. The count-less call returns one walk graph, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8bb0736-ac95-4003-b9c9-b911ad94dfed"],
 " when there is none."
}], "Notes",ExpressionUUID->"10c14b09-78a0-4997-98d9-df7e5623e267"],

Cell[TextData[{
 "A step reads a ",
 StyleBox["window",
  FontWeight->"Bold"],
 ": the last ",
 StyleBox["r", "TI"],
 " vertices of the growing side with the candidate appended, ",
 StyleBox["r", "TI"],
 " + 1 vertices and ",
 StyleBox["r", "TI"],
 " edges; ",
 StyleBox["r", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4729ab72-2a27-4c35-9353-33b016fe681c"],
 " is the whole side. A rule is an ",
 StyleBox["energy",
  FontWeight->"Bold"],
 " on the window, a non-negative number that is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2aafd8c-d24c-47aa-8f91-664ad1fa8550"],
 " exactly when the rule holds:"
}], "Notes",ExpressionUUID->"7135464a-651e-43fc-a042-811e5edc51a1"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b0626794-0919-4904-a9d3-51247b6013fd"], Cell["Rule", "TableText",
     FontWeight->Bold,ExpressionUUID->"2d26d61f-a5c3-44cf-a633-fead8f9f79c7"],
     Cell["Energy of the window", "TableText",
     FontWeight->Bold,ExpressionUUID->"0f6de78a-9a66-4e4b-a512-cf7b6d114f7b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "336a61ab-be4c-4d7b-84a2-6d85f8f62c54"], Cell[TextData[Cell[
    BoxData["\"\<Simple\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2aedfdce-2251-4fff-a04a-c1d15e525ed9"]], "TableText",ExpressionUUID->
     "d7a601dd-4eaf-4ce8-8394-e0e41392f303"], Cell[TextData[{
     "the number of earlier occurrences of the candidate; at ",
     StyleBox["r", "TI"],
     " = 2 a backtrack, a cusp"
    }], "TableText",ExpressionUUID->"bd4fa805-60ec-405b-b971-ad75843fcb02"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "89185337-1146-42e6-8765-78661a30096b"], Cell[TextData[Cell[
    BoxData["\"\<Shortest\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "de3f2dcc-ad33-42be-8c8e-aca9c3367d46"]], "TableText",ExpressionUUID->
     "3e078f7b-5949-4ec0-b2c4-d3dd6e6845ae"], Cell["\<\
the defect: the edges of the window minus the distance between its ends\
\>", "TableText",ExpressionUUID->"6804036b-6e56-487c-8d3f-245aa80627f0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "56a528aa-3b97-453c-b132-ba4aaebb01cb"], Cell[TextData[Cell[
    BoxData["\"\<Stretched\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "bc6eda55-b25c-4fdd-b334-69dd02ef8627"]], "TableText",ExpressionUUID->
     "9d477ac9-0dba-47a1-affd-d2c8ab4f6e02"], Cell["\<\
the defect minus the least defect among the step's candidates\
\>", "TableText",ExpressionUUID->"167dc7fe-c18e-4338-ba0a-dc83788662fd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2b191ac4-3e23-4deb-977f-c115ab1d67f1"], Cell[TextData[StyleBox[
    "f", "TI"]], "TableText",ExpressionUUID->
     "a30ad54b-6cd4-4363-a215-bb45a942a3d6"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"f", "[", "window", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "edde76d2-c40c-45b1-8dcc-b46d3f6939d8"],
     ", a non-negative number; ",
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5dc32057-0d45-4e3a-bd61-3f90a4c69031"],
     " and ",
     Cell[BoxData["False"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "21d522af-9950-4e5d-b184-079d622fa16c"],
     " read as ",
     Cell[BoxData["0"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "771e13ee-6b1e-428a-b196-b799e7cdfb63"],
     " and ",
     Cell[BoxData["1"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f116fb0b-1e22-42b1-9564-bc341f109a66"],
     ", so a predicate is a rule"
    }], "TableText",ExpressionUUID->"1b33db15-f5ce-4dee-9108-de1ea16a6962"]}
  }]], "2ColumnTableMod",ExpressionUUID->"e31f8635-0fba-4a35-a2c5-\
d9917e8fac5b"],

Cell[TextData[{
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae3eb81e-a38d-4946-a7e5-387a8f5ab1f1"],
 " is a list of rules, each written ",
 Cell[BoxData["rule"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "509f6dd4-44c9-4dac-9360-35b38db3b085"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"rule", ",", " ", "r"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "155387d5-a910-4cdd-a917-86bdc71bb003"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"rule", ",", " ", "r", ",", " ", "p"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d96a5d2-10bf-4787-9cb2-f0e145cd2013"],
 ". A bare rule has ",
 StyleBox["r", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46d51840-ce55-4bfb-bd34-06496a502838"],
 ", a pair has ",
 StyleBox["p", "TI"],
 " = ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8fbc0b59-eeb8-4f2b-bc9b-093fd6489fbf"],
 ". The weight ",
 StyleBox["p", "TI"],
 " says how much a violation costs:"
}], "Notes",ExpressionUUID->"8a01b943-44e4-426b-ab31-e247aa797fbb"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "03e91f9c-e98e-489c-81ff-37b4fb61646f"], Cell[TextData[StyleBox[
    "p", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"141ff2fa-9ec2-4cbb-9ffd-19058cf12d10"],
     Cell["Reading", "TableText",
     FontWeight->Bold,ExpressionUUID->"0f98aee2-425a-4d6d-9126-81f9891bcf2c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "acf845d0-1a4e-4917-a77a-650b121f25f3"], Cell[TextData[Cell[BoxData[
    "0"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f20cfdd2-3b85-42fa-8f43-1e5980d30fec"]], "TableText",ExpressionUUID->
     "2ef057a7-bbe8-49c0-aaf9-219e39d56762"], Cell[
    "hard: a candidate of positive energy is dropped", "TableText",
     ExpressionUUID->"5bfa042e-3283-4461-a660-dd6990ebef74"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3b3724e3-52d0-4c56-bfdd-62636e3c9106"], Cell[TextData[Cell[BoxData[
     RowBox[{"0", " ", "<", " ", "p", " ", "<", " ", "1"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d8eecd36-3ec7-434b-b141-6b145b51e5e1"]], "TableText",ExpressionUUID->
     "24436c98-ed30-476e-b48e-e73dc3809337"], Cell[TextData[{
     "soft: a candidate keeps the weight ",
     StyleBox["p", "TI"],
     "^energy; ",
     StyleBox["p", "TI"],
     " = ",
     Cell[BoxData[
      RowBox[{"Exp", "[", 
       RowBox[{"-", "beta"}], "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9ab4bfc3-911b-45b4-b267-97829c319304"],
     " is the Boltzmann weight at inverse temperature ",
     StyleBox["beta", "TI"]
    }], "TableText",ExpressionUUID->"89b17d94-b837-40b1-9c3c-9669d271d864"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "00fd04d4-01b5-4d97-9cce-b80de1f55ded"], Cell[TextData[Cell[BoxData[
    "1"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "61bf829f-91ab-4583-b335-e1a11aacd748"]], "TableText",ExpressionUUID->
     "fad4dea5-d84e-45d8-8473-908eaea9474f"], Cell[
    "off", "TableText",ExpressionUUID->"f697fc8c-45ce-438e-860a-655f80ac9d94"]}
  }]], "2ColumnTableMod",ExpressionUUID->"5b4477a8-f234-44b6-aa7c-\
0255edf0eb75"],

Cell[TextData[{
 "The hard rules cut the class; the soft rules put a distribution on it, the \
weight of a candidate being the product over the soft rules. The rules act in \
the order written, so ",
 Cell[BoxData["\"\<Stretched\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6de56d1d-10c3-4b88-83be-b367e294e714"],
 " compares the candidates the hard rules before it left. ",
 Cell[BoxData["\"\<Stretched\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e14ede1-b6c3-41a7-bb11-40b9d66ff91e"],
 " is hard only: as a soft rule it would be the soft ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "102fdd55-f35d-43e9-9847-1eb341535644"],
 ", whose energy differs from it by a constant on each step."
}], "Notes",ExpressionUUID->"f5843228-f2f4-44ab-8c04-c24f5ff72de7"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4e19af34-c5e8-42f5-aa67-fba8590e8d4e"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"62f60f25-80b5-4199-8d7a-ce0ea3490b48"],
