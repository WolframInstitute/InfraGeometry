Cell[CellGroupData[{

Cell["NextVertexFunction", "ExampleSubsection",ExpressionUUID->"192082e1-d71c-4099-94d8-0d5a05f6c537"],

Cell[TextData[{
 "Under ",
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31f161dc-64d4-4017-8ff2-56f0f61abed7"],
 " the walk is a random one, one uniform admissible step at a time. Three \
walks of 12 edges from the centre, one per seed."
}], "ExampleText",ExpressionUUID->"ef59b966-fb04-4e70-a856-d476a4d22f42"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
            RowBox[{"FindInfraWalk", "[", 
             RowBox[{"g", ",", " ", "a", ",", " ", 
              RowBox[{"{", "12", "}"}], ",", " ", 
              
              RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
               "RandomChoice"}]}], "]"}]}], ")"}], ",", " ", "a"}], "}"}]}], 
       "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"seed", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7b0befda-4976-4688-b1af-2c22b536dd06"],

