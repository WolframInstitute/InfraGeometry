  FontSize->0.9 Inherited,ExpressionUUID->
  "a8a59af9-20ca-4260-b3ff-6309bf585a11"],
 ", and to every walk of at most 4 edges."
}], "ExampleText",ExpressionUUID->"365dd535-0422-4938-b118-b9e8dbaee0c6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"walks", " ", "=", " ", 
          RowBox[{"FindInfraWalk", "[", 
           RowBox[{"g", ",", " ", "a", ",", " ", 
            RowBox[{"UpTo", "[", "4", "]"}], ",", " ", "All", ",", " ", 
            RowBox[{"Properties", " ", "->", " ", "rules"}]}], "]"}]}], "}"}],
         ",", "\n", "      ", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"walks", ",", " ", "a"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"rules", ",", " ", "\"\<: \>\"", ",", " ", 
             RowBox[{"Length", " ", "@", " ", "walks"}]}], "}"}], "]"}]}], 
         "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"rules", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "\"\<Simple\>\"", "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"\"\<Simple\>\"", ",", " ", "2"}], "}"}], "}"}], ",", " ", 
          RowBox[{"{", "}"}]}], "}"}]}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8854b0ce-e188-491f-aec6-87da18585c5b"],

