Cell[TextData[{
 "A soft ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f47d719-3c2b-4c96-a41d-c72be5a936e8"],
 ": the walk of 30 edges that rarely returns to a vertex it has visited, at \
weights 0, 0.1 and 1, with the number of returns."
}], "ExampleText",ExpressionUUID->"156f33ba-092c-452a-879e-24755448df6e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"walk", " ", "=", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "4", "]"}], ";", "\n", "        ", 
            RowBox[{"FindInfraWalk", "[", 
             RowBox[{"g", ",", " ", "a", ",", " ", 
              RowBox[{"{", "30", "}"}], ",", " ", 
              RowBox[{"Properties", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"{", 
                 
                 RowBox[{"\"\<Simple\>\"", ",", " ", "Infinity", ",", " ", 
                  "p"}], "}"}], "}"}]}], ",", " ", 
              
              RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
               "RandomSample"}]}], "]"}]}], ")"}]}], "}"}], ",", "\n", 
        "      ", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"walk", ",", " ", "a"}], "}"}], ",", " ", 
            RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]}], "]"}], ",",
           "\n", "        ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "\"\<: \>\"", ",", " ", 
             RowBox[{"31", " ", "-", " ", 
              RowBox[{"Length", " ", "@", " ", 
               RowBox[{"DeleteDuplicates", "[", 
                RowBox[{"Last", " ", "/@", " ", 
                 RowBox[{"VertexList", " ", "@", " ", "walk"}]}], "]"}]}]}]}],
             "}"}], "]"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0.1", ",", " ", "1"}], "}"}]}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"33e67f38-d9e6-4c44-8005-6723529a8773"],

