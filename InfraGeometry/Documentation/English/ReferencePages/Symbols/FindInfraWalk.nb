Cell["A vertex and the one-vertex list are the same germ.", "ExampleText",ExpressionUUID->"4c84c81b-328e-43bc-81b7-5a333f77bbd0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FindInfraWalk", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", 
       RowBox[{"UpTo", "[", "3", "]"}], ",", " ", "All"}], "]"}], " ", "===", 
     " ", 
     RowBox[{"FindInfraWalk", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", "a", "}"}], ",", " ", 
       RowBox[{"UpTo", "[", "3", "]"}], ",", " ", "All"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"54f620c4-0f71-4b1f-b956-e849fd1991c4"],

Cell[BoxData[
 RowBox[{"{", "True", "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1960fd3c-6394-4fbb-88af-d66a233d5016"]
}, Open  ]],

Cell[TextData[{
 "With the geodesic rule ",
 Cell[BoxData["\"\<Minimizing\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4694150f-3cab-41ba-9e9b-71c86199c438"],
 " at scale ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f08a5b65-fe2d-463d-84a9-865225c596c4"],
 " the walks are shortest paths, so the walks to ",
 StyleBox["b", "TI"],
 " are the members of the segment."
}], "ExampleText",ExpressionUUID->"d22f72e4-ee37-4318-9e68-9501f6fb3eb6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "3"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{"Select", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"FindInfraWalk", "[", 
        RowBox[{
        "g", ",", " ", "a", ",", " ", "Infinity", ",", " ", "All", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", "\"\<Minimizing\>\"", "}"}]}], ",", " ", 
         RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "b"}], " ", 
            "&"}], ")"}]}]}], "]"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Last", " ", "@", " ", 
          RowBox[{"Last", " ", "@", " ", 
           RowBox[{"VertexList", " ", "@", " ", "#"}]}]}], " ", "===", " ", 
         "b"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"walks", ",", " ", "a", ",", " ", "b"}], "}"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Last", " ", "/@", " ", 
          RowBox[{"VertexList", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ",
         "walks"}], "]"}], " ", "===", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"FindInfraSegment", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], 
        "]"}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"78d496e8-3472-4ac4-b470-76ce667359f0"],

