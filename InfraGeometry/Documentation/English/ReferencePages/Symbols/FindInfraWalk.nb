Notebook[{

Cell[CellGroupData[{
Cell["FindInfraWalk", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1450481b-a94a-4dd7-b32d-99f7bcec1773"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb8f0136-e9ab-4a9f-b744-3d31d24bfc6a"],
 "\[LineSeparator]",
 "gives one walk grown from ",
 StyleBox["germ", "TI"],
 " in the class cut by ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "002d5a25-bdb6-4ba2-aaf1-28c101ff63e5"],
 ", until a stopping condition fires or the budget ",
 StyleBox["kspec", "TI"],
 " is spent.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6a5907bf-23e3-448b-8115-83b9a12b0411"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0625d559-8dea-47a5-95ae-1eefb0aabfe4"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f017567d-eaed-4388-ba37-4e2a19f15f61"],
 " of exactly ",
 StyleBox["n", "TI"],
 " walks or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec1b617e-9378-4e42-bc82-bf6b569e600a"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bcf6e1cd-c233-4179-a33d-35d8350bf858"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40a77fb4-ffd5-4dc8-acb4-31702047c392"],
 " gives every one."
}], "Usage",ExpressionUUID->"38581469-34cc-42a1-8fb7-d2446f3a9d54"],

Cell[TextData[{
 "The germ is the seed of the walk: a vertex, a vertex list, a walk graph, or \
a list of germs. A vertex is the one-vertex germ, so ",
 Cell[BoxData[
  RowBox[{"FindInfraWalk", "[", 
   RowBox[{"g", ",", " ", "p", ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "573c90bd-082c-4be8-ab45-45316b6794f2"],
 " and ",
 Cell[BoxData[
  RowBox[{"FindInfraWalk", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"{", "p", "}"}], ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "317fce0b-21cb-4683-b02b-3700ed8b2221"],
 " are the same call. A germ is read as a vertex first, so on a substrate \
labelled by lists the vertex ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "1"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "565342e1-ca91-4617-9d88-c0546d31eb87"],
 " is one point, not the walk of its entries. A walk graph is read as its \
vertex sequence; a list of germs gives the walks grown from each."
}], "Notes",ExpressionUUID->"9ed2bfa5-bfda-4319-a3e3-0238e31e14bf"],

Cell[TextData[{
 StyleBox["kspec", "TI"],
 " is the budget in edges added on each growing side: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6afbd169-0b51-45d3-b3ff-04ead21af5e9"],
 " (at most ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c4fdb7bf-41ba-49f4-aba4-521581959370"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "614ee9fc-f35f-41ef-a190-bcd8ce7a9c6e"],
 ", or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d980ce8-1ac2-49f3-ad41-31a7afca0782"],
 ". A bare integer is no ",
 StyleBox["kspec", "TI"],
 ". ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad92fefb-512f-4750-b49a-8bd823d33418"],
 " is legal only when a rule of the class bounds it, as the default ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57bf8439-86d9-4ad4-9725-fcf51ee1987e"],
 " does."
}], "Notes",ExpressionUUID->"1800ee4a-bad2-49d8-8da3-6d1bcbd04733"],

Cell[TextData[{
 "A walk is a graph: a directed path graph on the pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "v"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cab247e-e9a5-4fe2-81a7-d015cb40789a"],
 ", the position and the vertex. ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96cc624b-2346-4704-aaf3-f7467d7b3e21"],
 " is its vertex sequence. The count-less call returns one walk graph, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ebf0db5-a549-4899-be02-c8b6d3f24882"],
 " when there is none. The first walk is the first branch of the descent, a \
witness, not a shortest path."
}], "Notes",ExpressionUUID->"ca11f9ee-2168-4284-acfd-8641d44c1d0c"],

Cell[TextData[{
 "The class is cut by ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a778fc4-36ac-4747-9259-c2c992214c28"],
 ", each rule read on the window of the last ",
 Cell[BoxData["\"\<InfraScale\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb518326-3a5b-4275-b51f-0817bcb12f07"],
 " vertices with the candidate:"
}], "Notes",ExpressionUUID->"703e15f9-f06f-40a4-a8dd-2aa2c0f40a74"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b2e78dbe-e42b-4d20-b737-89a8aebdb66d"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"7be3d494-adb7-4446-8d1e-225d81c49c86"],
