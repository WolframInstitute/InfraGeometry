Cell[TextData[{
 "A soft ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82ef6c6a-7afd-4d73-abcb-489fa99095fd"],
 ": the walk of 30 edges that rarely returns to a vertex it has visited, at \
weights 0.01, 0.1 and 1, with the number of returns."
}], "ExampleText",ExpressionUUID->"ca053df6-9d70-47c0-b781-b895c37359da"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"walk", " ", "=", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "4", "]"}], ";", "\n", "        ", 
            RowBox[{"FindInfraWalk", "[", 
             RowBox[{"g", ",", " ", "a", ",", " ", 
              RowBox[{"{", "30", "}"}], ",", " ", 
              RowBox[{"Properties", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"{", 
                 
                 RowBox[{"\"\<Simple\>\"", ",", " ", "Infinity", ",", " ", 
                  "p"}], "}"}], "}"}]}]}], "]"}]}], ")"}]}], "}"}], ",", "\n",
         "      ", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"walk", ",", " ", "a"}], "}"}], ",", " ", 
            RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]}], "]"}], ",",
           "\n", "        ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "\"\<: \>\"", ",", " ", 
             RowBox[{"31", " ", "-", " ", 
              RowBox[{"Length", " ", "@", " ", 
               RowBox[{"DeleteDuplicates", "[", 
                RowBox[{"Last", " ", "/@", " ", 
                 RowBox[{"VertexList", " ", "@", " ", "walk"}]}], "]"}]}]}]}],
             "}"}], "]"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.01", ",", " ", "0.1", ",", " ", "1"}], "}"}]}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3b4d0f3d-cc0f-4cdd-9b46-116f438147d1"],

