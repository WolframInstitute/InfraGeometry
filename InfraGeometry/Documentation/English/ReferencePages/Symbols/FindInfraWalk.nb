Cell[TextData[{
 "A soft rule changes the order, not the class: under ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2564221-b343-41fe-bc9c-9b75cf4ea963"],
 " the weighted walks are the walks of the hard rules."
}], "ExampleText",ExpressionUUID->"d139a331-604c-46f7-967f-736fb4a6d28c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"FindInfraWalk", "[", 
       RowBox[{"g", ",", " ", "a", ",", " ", 
        RowBox[{"{", "4", "}"}], ",", " ", "All", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Simple\>\"", ",", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<Shortest\>\"", ",", " ", "3", ",", " ", "0.3"}], 
            "}"}]}], "}"}]}]}], "]"}]}], " ", "===", "\n", "    ", 
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"FindInfraWalk", "[", 
       RowBox[{"g", ",", " ", "a", ",", " ", 
        RowBox[{"{", "4", "}"}], ",", " ", "All", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", "\"\<Simple\>\"", "}"}]}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"73b33b7d-2d9a-435e-8851-242b7a424900"],

Cell[BoxData[
 RowBox[{"{", "True", "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"fafc9822-8602-4c15-9d91-6f61433516af"]
}, Open  ]],

Cell[TextData[{
 "The soft ",
 Cell[BoxData["\"\<Stretched\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c175252-2fb1-484f-bbd8-8b2c42aba4f4"],
 " weighs as the soft ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22be0e48-79d9-4ea5-b09e-99d7bca64ed0"],
 ": under one seed the two draw the same walk."
}], "ExampleText",ExpressionUUID->"cfea3697-713c-440c-9c0c-4cb3fd2b2479"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"SameQ", " ", "@@", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Last", " ", "/@", " ", 
        RowBox[{"VertexList", " ", "@", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
           RowBox[{"FindInfraWalk", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", 
             RowBox[{"{", "6", "}"}], ",", " ", 
             RowBox[{"Properties", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"{", 
                RowBox[{"rule", ",", " ", "3", ",", " ", "0.3"}], "}"}], 
               "}"}]}]}], "]"}]}], ")"}]}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"rule", ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Stretched\>\"", ",", " ", "\"\<Shortest\>\""}], 
          "}"}]}], "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"b59cd0e4-9796-46b8-b455-cdad002d08db"],

Cell[BoxData[
 RowBox[{"{", "True", "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"e47d5fa7-8282-44da-8721-119a820f07e4"]
}, Open  ]],

Cell[TextData[{
 "The cusps, self-tangencies and triple points of a walk are read by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WalkSingularities"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/WalkSingularities", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7db3b6cf-935e-4939-83f1-c26d0dde2a1f"],
 "; a class free of one of them is a predicate on it."
}], "ExampleText",ExpressionUUID->"b80eb66b-e9b2-4c04-9bf3-45edd6927fb3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"FindInfraWalk", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", 
         RowBox[{"{", "6", "}"}], ",", " ", "All", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"\"\<Simple\>\"", ",", " ", "2"}], "}"}], "}"}]}]}], 
        "]"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"WalkSingularities", "[", 
           RowBox[{"Last", " ", "/@", " ", 
            RowBox[{"VertexList", " ", "@", " ", "#"}]}], "]"}], 
          "[", "\"\<SelfTangencies\>\"", "]"}], " ", "=!=", " ", 
         RowBox[{"{", "}"}]}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"walks", ",", " ", 
           RowBox[{"UpTo", "[", "3", "]"}]}], "]"}], ",", " ", "a"}], "}"}]}],
       "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "walks"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"d374f525-e30b-441f-ac58-e6e0f22605ca"],

