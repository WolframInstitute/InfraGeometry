Cell[CellGroupData[{

Cell["NextVertexFunction", "ExampleSubsection",ExpressionUUID->"2ec5abac-cc75-451a-b155-cd674d5864b8"],

Cell[TextData[{
 "Under ",
 Cell[BoxData["RandomChoice"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab5cfb7b-88ef-491f-ab3d-77a9d2d45725"],
 " the walk is a random one, one uniform admissible step at a time. Three \
walks of 12 edges from the centre, one per seed."
}], "ExampleText",ExpressionUUID->"c433ae41-5a6b-473a-9c20-07d9870bac85"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
            RowBox[{"FindInfraWalk", "[", 
             RowBox[{"g", ",", " ", "a", ",", " ", 
              RowBox[{"{", "12", "}"}], ",", " ", 
              
              RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
               "RandomChoice"}]}], "]"}]}], ")"}], ",", " ", 
          RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", 
          "a"}], "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"seed", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5e588b17-9cc5-491a-8bd0-26d7daf31bdd"],

