Cell[CellGroupData[{

Cell["Direction", "ExampleSubsection",ExpressionUUID->"ab5eb058-fcea-4920-b5e5-266a4cd496b0"],

Cell["\<\
The simple walks of at most 2 edges grown from a two-vertex germ forward, \
backward and on both sides.\
\>", "ExampleText",ExpressionUUID->"871d516b-aecd-4787-8287-3b21819eedc6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"germ", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}]}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"walks", " ", "=", " ", 
          RowBox[{"FindInfraWalk", "[", 
           RowBox[{"g", ",", " ", "germ", ",", " ", 
            RowBox[{"UpTo", "[", "2", "]"}], ",", " ", "All", ",", " ", 
            RowBox[{"Properties", " ", "->", " ", 
             RowBox[{"{", "\"\<Simple\>\"", "}"}]}], ",", " ", 
            RowBox[{"\"\<Direction\>\"", " ", "->", " ", "dir"}]}], "]"}]}], 
         "}"}], ",", "\n", "      ", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"walks", ",", " ", "germ"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"dir", ",", " ", "\"\<: \>\"", ",", " ", 
             RowBox[{"Length", " ", "@", " ", "walks"}]}], "}"}], "]"}]}], 
         "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"dir", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Forward\>\"", ",", " ", "\"\<Backward\>\"", ",", 
          " ", "\"\<BothSides\>\""}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e7eb32ff-41e5-4838-80c8-da94b7aaf4b0"],

