Cell["\<\
Three walks of 9 edges from the centre of a mesh, the soft straightness at \
window 5 with weights 1, 0.3 and 0.01: from the random walk to a nearly \
straight one.\
\>", "ExampleText",ExpressionUUID->"53c1ddc9-bbbf-4697-9f84-1c4fdab7a94f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], 
        "]"}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
            RowBox[{"FindInfraWalk", "[", 
             RowBox[{"g", ",", " ", "c", ",", " ", 
              RowBox[{"UpTo", "[", "9", "]"}], ",", " ", 
              RowBox[{"Properties", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"{", 
                 RowBox[{"\"\<Shortest\>\"", ",", " ", "5", ",", " ", "p"}], 
                 "}"}], "}"}]}]}], "]"}]}], ")"}], ",", " ", "c"}], "}"}], ",",
         " ", 
        RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0.3", ",", " ", "0.01"}], "}"}]}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"095b742f-d71a-40ed-9282-ccce7000ac08"],

