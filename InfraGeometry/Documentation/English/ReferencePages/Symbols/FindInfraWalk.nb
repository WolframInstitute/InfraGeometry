Notebook[{

Cell[CellGroupData[{
Cell["FindInfraWalk", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f201c2ea-de61-4c8b-ad8d-3c6e19a79bc7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d50ed446-05d5-426a-84e9-a092e06d410f"],
 "\[LineSeparator]",
 "gives one walk grown from ",
 StyleBox["germ", "TI"],
 " one step at a time under the rules of ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e959f04-07ee-405c-81b2-9b54980d0485"],
 ", until a stopping condition fires or the budget ",
 StyleBox["kspec", "TI"],
 " is spent.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"72475147-ad02-4f94-9ead-89e04d36dda8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da9c5388-c176-45e4-abc2-553f607778aa"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4836bd9b-3c9b-41bf-b799-ad9fcd53e6db"],
 " of exactly ",
 StyleBox["n", "TI"],
 " walks or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c9cc96e-f6f9-4d5d-87aa-0542caa55afd"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a2fb015-c47f-4bf5-acc9-692011f4ea26"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea8af3d1-0dca-40d4-bbe3-cfaabe9b9646"],
 " gives every one."
}], "Usage",ExpressionUUID->"0f8540ec-6c9d-4ee0-8752-be2a671ab7b5"],

Cell[TextData[{
 "The germ is the seed of the walk: a vertex, a vertex list, a walk graph, or \
a list of germs. A vertex is the one-vertex germ, so ",
 Cell[BoxData[
  RowBox[{"FindInfraWalk", "[", 
   RowBox[{"g", ",", " ", "p", ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ef1933b-0730-4a32-b55e-221135b45701"],
 " and ",
 Cell[BoxData[
  RowBox[{"FindInfraWalk", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"{", "p", "}"}], ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81cd9c64-8924-4bb2-aab3-45e9d3e61833"],
 " are the same call. A germ is read as a vertex first, so on a substrate \
labelled by lists the vertex ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "1"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da626e7f-725e-42de-92d9-893178439591"],
 " is one point, not the walk of its entries. A walk graph is read as its \
vertex sequence; a list of germs gives the walks grown from each."
}], "Notes",ExpressionUUID->"8845561b-f726-480c-9164-89adc30bb201"],

Cell[TextData[{
 StyleBox["kspec", "TI"],
 " is the budget in edges added on each growing side: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffe1e273-e0e9-4558-a6e8-945fca754af0"],
 " (at most ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18304357-5052-4210-a1d4-ac1baf6c901a"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "026631a7-bd8f-45e1-ba31-6c1b97aa8e13"],
 ", or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8906f55f-0810-4ddd-b376-8c73e490036a"],
 ". A bare integer is no ",
 StyleBox["kspec", "TI"],
 ". ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b6b931b-ad6d-4ffb-8269-869c1f11c23a"],
 " is legal only under a hard rule that bounds the class: a bare ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "259d2eee-a180-4584-8be5-a51194789a4f"],
 " or a bare ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "062d9865-6292-4713-a318-217f21e22a2d"],
 "."
}], "Notes",ExpressionUUID->"e54c0938-6e64-42c6-8661-30f14f62ff43"],

Cell[TextData[{
 "A walk is a graph: a directed path graph on the pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "v"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e7803ce-d59a-4643-a16e-e51f7d39d8c6"],
 ", the position and the vertex. ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42f26f6a-ae4e-4e29-b915-6b7e5f702420"],
 " is its vertex sequence. The count-less call returns one walk graph, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35dfa932-95a0-4d03-b851-43c7fe96bb02"],
 " when there is none."
}], "Notes",ExpressionUUID->"40b49c74-8bb4-4886-92a3-c4b184289c12"],

Cell[TextData[{
 "A step reads a ",
 StyleBox["window",
  FontWeight->"Bold"],
 ": the last ",
 StyleBox["r", "TI"],
 " vertices of the growing side with the candidate appended, ",
 StyleBox["r", "TI"],
 " + 1 vertices and ",
 StyleBox["r", "TI"],
 " edges; ",
 StyleBox["r", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65ac63fa-6fc1-4a48-be07-f29ae757eaa1"],
 " is the whole side. A rule is an ",
 StyleBox["energy",
  FontWeight->"Bold"],
 " on the window, a non-negative number that is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "abf47135-0ee9-4be7-be38-0c6f8bd51bd1"],
 " exactly when the rule holds:"
}], "Notes",ExpressionUUID->"a785cc9f-3164-4d80-84b7-c4669a970081"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8d2cde05-22c4-45e0-90ad-973a03b28452"], Cell["Rule", "TableText",
     FontWeight->Bold,ExpressionUUID->"97a337de-5ef9-4f13-91dd-bf0a7ca6d6d2"],
     Cell["Energy of the window", "TableText",
     FontWeight->Bold,ExpressionUUID->"f8b2c101-b82f-43b7-b747-219d922a82f5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "49c122ba-99b1-4adc-a3e5-db001cac251a"], Cell[TextData[Cell[
    BoxData["\"\<Simple\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "35c34058-6df4-4f57-b0b8-2796315e0212"]], "TableText",ExpressionUUID->
     "7f6fe856-18ba-4127-813d-1398e2c3c903"], Cell[TextData[{
     "the number of earlier occurrences of the candidate; at ",
     StyleBox["r", "TI"],
     " = 2 a backtrack, a cusp"
    }], "TableText",ExpressionUUID->"8610c1f5-24ae-4282-bae1-ca57a1a0af2f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fe320fee-630d-4b89-a3c3-3dc7c3e81737"], Cell[TextData[Cell[
    BoxData["\"\<Shortest\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5d19c94c-dfe8-4ef1-af8f-a9eadc6a0fde"]], "TableText",ExpressionUUID->
     "143e5b65-b295-4008-a018-375ee70ac56c"], Cell["\<\
the defect: the edges of the window minus the distance between its ends\
\>", "TableText",ExpressionUUID->"d48ca1f3-fa77-4bdf-a62f-20d69497c081"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "995fb312-841f-47c5-b58f-9bad37f2a72f"], Cell[TextData[Cell[
    BoxData["\"\<Stretched\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5b763df2-4df5-44b1-a236-59562b005fd0"]], "TableText",ExpressionUUID->
     "370664f3-929a-4b06-983b-521d22fcccaa"], Cell["\<\
the defect minus the least defect among the step's candidates\
\>", "TableText",ExpressionUUID->"8978fbf6-6be7-464c-8ce3-51b194ff2e85"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "63f08536-48cf-43dc-a070-25910f9f7600"], Cell[TextData[StyleBox[
    "f", "TI"]], "TableText",ExpressionUUID->
     "03ceda31-ced1-41fe-93a9-18c4fc7e41d8"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"f", "[", "window", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "abb88560-eacb-4b7b-950e-a28a0996d221"],
     ", a non-negative number; ",
     Cell[BoxData["True"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "57bf2a8a-cb66-404e-9c43-c1ef8c2ca2ef"],
     " and ",
     Cell[BoxData["False"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2669ff33-4010-4b40-abf6-5e1706a43a1f"],
     " read as ",
     Cell[BoxData["0"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a7ab7b49-5b7e-4da3-b331-f90636a39e65"],
     " and ",
     Cell[BoxData["1"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c50f4144-a5d5-48b1-b619-3f7d075008fc"],
     ", so a predicate is a rule"
    }], "TableText",ExpressionUUID->"e91779b7-c076-479d-9c6e-46aa4a472d40"]}
  }]], "2ColumnTableMod",ExpressionUUID->"30a13b35-51dd-4bdd-b8ff-\
9e7b581081f0"],

Cell[TextData[{
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9528825-6825-4279-907a-a508c7009a26"],
 " is a list of rules, each written ",
 Cell[BoxData["rule"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3aaf4fbb-9eab-457c-b11d-fb716a917e4b"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"rule", ",", " ", "r"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd715361-6b18-49d7-a15d-73cefee158c3"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"rule", ",", " ", "r", ",", " ", "p"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c844456-a585-4cb4-a6f6-f848dd39b8bd"],
 ". A bare rule has ",
 StyleBox["r", "TI"],
 " = ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42ccba7a-c2f6-48e6-a7dd-7916f7040b70"],
 ", a pair has ",
 StyleBox["p", "TI"],
 " = ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fce8b82c-b063-42ca-afcd-abeb25d5d350"],
 ". The weight ",
 StyleBox["p", "TI"],
 " says how much a violation costs:"
}], "Notes",ExpressionUUID->"3fb9e60b-caa9-45f8-97cd-02f06e325a64"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5f3475fa-fd00-4fe0-86e5-3c6bcb88c01c"], Cell[TextData[StyleBox[
    "p", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"ed118f9d-1e6d-4251-81be-d4965f6074bb"],
     Cell["Reading", "TableText",
     FontWeight->Bold,ExpressionUUID->"fc809b82-3ea7-4aab-9c00-777e6614153d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8a602a49-fd26-4c69-a391-d97d762b876a"], Cell[TextData[Cell[BoxData[
    "0"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "956c57b7-b30b-4579-b663-f64dbc4c2264"]], "TableText",ExpressionUUID->
     "cdc63672-4f54-474e-828a-1e6bc7567236"], Cell[
    "hard: a candidate of positive energy is dropped", "TableText",
     ExpressionUUID->"05dd5f71-c122-4ef7-9a86-b68bcad94c03"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f13d8f34-83a4-472a-aeb0-dd3cdad326cd"], Cell[TextData[Cell[BoxData[
     RowBox[{"0", " ", "<", " ", "p", " ", "<=", " ", "1"}]], "InlineFormula",
     
     FontSize->0.9 Inherited,ExpressionUUID->
     "156004de-3d8f-4911-9da9-970becc5d8c9"]], "TableText",ExpressionUUID->
     "748663df-d9fa-4869-af21-64f009e41f4c"], Cell[TextData[{
     "soft: a candidate keeps the weight ",
     StyleBox["p", "TI"],
     "^energy; ",
     StyleBox["p", "TI"],
     " = ",
     Cell[BoxData[
      RowBox[{"Exp", "[", 
       RowBox[{"-", "beta"}], "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e39d34b0-79a4-4cf0-94d7-f75c12737ab1"],
     " is the Boltzmann weight at inverse temperature ",
     StyleBox["beta", "TI"],
     "; at ",
     StyleBox["p", "TI"],
     " = ",
     Cell[BoxData["1"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e919bcd5-7923-4c8c-89fa-b0ffd2967ba5"],
     " every candidate weighs alike"
    }], "TableText",ExpressionUUID->"f6429a38-9ebc-4695-a4ce-210da7ce9a0f"]}
  }]], "2ColumnTableMod",ExpressionUUID->"eb7151fc-15bb-476e-9ae3-\
5947b30d0292"],

Cell[TextData[{
 "The hard rules cut the class; the soft rules put a distribution on it, the \
weight of a candidate being the product over the soft rules. The rules act in \
the order written, so ",
 Cell[BoxData["\"\<Stretched\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a3107b5-ae51-43c0-a1b3-191ff9b6dc47"],
 " compares the candidates the hard rules before it left. As soft rules ",
 Cell[BoxData["\"\<Stretched\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa8133ff-df4b-4b70-8a74-ed2dfc07a348"],
 " and ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b84ab4e-3ba6-428c-9e76-090621a48b37"],
 " weigh alike: their energies differ by a constant on each step."
}], "Notes",ExpressionUUID->"28bf1d62-a2c5-4ce1-9145-8ae147f7a7f2"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1677e328-021c-4c97-bf4d-039fd1c08c07"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"4db8a2e3-9449-46dc-a6a9-17a9f07acc2d"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"3d82e878-8aa3-40cc-bcd0-0e120ebdce4e"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"62e3623c-3de8-457d-90b7-b38169e955a4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7723a5b3-6aff-4ca5-9e56-70666f190ec1"], Cell[TextData[Cell[BoxData[
    "Properties"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "fcfed166-56e4-4058-b2a5-04c3395c11b3"]], "TableText",ExpressionUUID->
     "66cf6ef7-5e08-4c7b-bb7b-f9e80fb5ebf6"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "13385d03-3fc9-492b-b730-738ee2d41818"]], "TableText",ExpressionUUID->
     "8311948f-e8d9-4d43-8407-0cb61118e24a"], Cell[TextData[{
     "the rules; ",
     Cell[BoxData[
      RowBox[{"{", "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ba9bcb51-7d32-4dab-8b13-2f564511cff9"],
     " is every walk"
    }], "TableText",ExpressionUUID->"d5dac86b-5730-4290-9a2f-136654535881"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "24766403-ac38-49b9-942c-cf0e5d622400"], Cell[TextData[Cell[
    BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "feb82659-5039-431f-86f9-85bc3bcbd5f8"]], "TableText",ExpressionUUID->
     "3bf86ddc-f588-40fa-9665-f42d9ce83183"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ef8779dc-80db-438f-af6c-bd97235fc733"]], "TableText",ExpressionUUID->
     "0290cdec-1d90-4557-9b3d-d705e70501d8"], Cell[
    "the order the surviving candidates are tried in", "TableText",
     ExpressionUUID->"d56dc380-6de1-4985-b2d7-e497fd3b651d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e5eefeeb-4978-4a06-a8e7-964e5eceae42"], Cell[TextData[Cell[
    BoxData["\"\<Direction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "cb71cc12-122b-46f3-8d7d-bfd0acd3ce2c"]], "TableText",ExpressionUUID->
     "11482ac4-7835-491f-bb73-5385639b990e"], Cell[TextData[Cell[
    BoxData["\"\<Forward\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ca71e57c-de4e-44b1-a9df-05aae25d8af7"]], "TableText",ExpressionUUID->
     "be03237a-9f1f-4531-bd1b-4e717cecbfc1"], Cell[TextData[{
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3b8ead83-c53a-4a76-95cc-b2001f1565c2"],
     ", ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "18dacab6-e167-4917-8382-4f3edfca1230"],
     " or ",
     Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9b7160ff-d9de-4a38-b1b0-c523ac0114e2"]
    }], "TableText",ExpressionUUID->"4bea431f-a0c0-4809-8028-8b1b3655d9ca"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "283db164-9178-42e9-bd64-c294894066bd"], Cell[TextData[Cell[
    BoxData["\"\<StoppingCondition\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2d978640-a6b7-4c1d-8dc3-5383a9e7e69b"]], "TableText",ExpressionUUID->
