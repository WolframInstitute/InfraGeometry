Cell[CellGroupData[{

Cell["Direction", "ExampleSubsection",ExpressionUUID->"3c923fcb-37ae-423a-b1be-a37e32ba926a"],

Cell["\<\
The simple walks of at most 2 edges grown from a two-vertex germ forward, \
backward and on both sides.\
\>", "ExampleText",ExpressionUUID->"921594ec-46ac-4699-89af-078701177c79"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"germ", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", " ", "a"}], "]"}]}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"walks", " ", "=", " ", 
          RowBox[{"FindInfraWalk", "[", 
           RowBox[{"g", ",", " ", "germ", ",", " ", 
            RowBox[{"UpTo", "[", "2", "]"}], ",", " ", "All", ",", " ", 
            RowBox[{"Properties", " ", "->", " ", 
             RowBox[{"{", "\"\<Simple\>\"", "}"}]}], ",", " ", 
            RowBox[{"\"\<Direction\>\"", " ", "->", " ", "dir"}]}], "]"}]}], 
         "}"}], ",", "\n", "      ", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"walks", ",", " ", "germ"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"dir", ",", " ", "\"\<: \>\"", ",", " ", 
             RowBox[{"Length", " ", "@", " ", "walks"}]}], "}"}], "]"}]}], 
         "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"dir", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Forward\>\"", ",", " ", "\"\<Backward\>\"", ",", 
          " ", "\"\<BothSides\>\""}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"48de9d8e-4713-4ce0-a891-053c218bd720"],

