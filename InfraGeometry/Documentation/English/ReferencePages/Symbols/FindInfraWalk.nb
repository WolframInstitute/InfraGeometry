      FontSize->0.9 Inherited,ExpressionUUID->
      "7ce12b10-e040-4998-96d2-2d4e636181ed"],
     " (no repeated vertex), ",
     Cell[BoxData["\"\<Immersed\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a156926a-c3ee-4d4d-a8c8-63906f931557"],
     " (no backtrack), ",
     Cell[BoxData["\"\<Generic\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1d294685-be97-41e0-a2c3-8aea1e604a2f"],
     " (no cusp, self-tangency or triple point), ",
     Cell[BoxData[
      RowBox[{"\"\<Exclude\>\"", " ", "->", " ", "species"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "d1614fd5-bcc0-4259-8633-7f582ec11b62"],
     ", ",
     Cell[BoxData["\"\<Minimizing\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b9f127b4-1755-4d92-aec5-734825042545"],
     ", or a predicate on the window; ",
     Cell[BoxData[
      RowBox[{"{", "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "65d2e56c-8c2e-4f73-b467-0f4b9c289dee"],
     " is every walk"
    }], "TableText",ExpressionUUID->"96dfe4e1-2116-4442-a0b9-f9e1f1d8a9c4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8a2133c9-69c1-4c2a-aa90-165d2b135a9e"], Cell[TextData[Cell[
    BoxData["\"\<InfraScale\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "17654be7-305a-45b5-a6cf-fd2d09e8f994"]], "TableText",ExpressionUUID->
     "99fb9bc2-2ad4-4b71-b1f6-b26ec1b7aa5c"], Cell[TextData[Cell[BoxData[
    "Infinity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2b286d4e-0d05-47cd-8516-981a6c895950"]], "TableText",ExpressionUUID->
     "6bc3a521-bcaa-486a-acb2-5201c8ea1146"], Cell[
    "how many vertices back a rule sees", "TableText",ExpressionUUID->
     "f0c7f9b0-556e-431f-9df4-c3dffe98de96"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a0afc4c1-5202-4bc3-86ab-45719504d82e"], Cell[TextData[Cell[
    BoxData["\"\<Direction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1caba834-1790-443e-a941-1bef0e3ec150"]], "TableText",ExpressionUUID->
     "039377a6-246c-4bca-b303-99ec60cd7338"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9d42bbb2-9604-430d-80bf-af4bcf416a95"]], "TableText",ExpressionUUID->
     "4f05cc62-c15e-409f-8ac9-93da33473e2c"], Cell[TextData[{
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "28440ef0-de25-4ad2-9eac-daa377657624"],
     ", ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "45c05d8b-1317-4958-9400-a50d1a3108d3"],
     " or ",
     Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f5f90544-4c3f-4c64-a9ab-f0050f17f201"]
    }], "TableText",ExpressionUUID->"11989970-7a77-48f5-a3e9-7325985eba54"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "84f5482c-3076-45d5-8499-4e946585a76c"], Cell[TextData[Cell[
    BoxData["\"\<StoppingCondition\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a580d81c-3d4a-49c1-9846-7bd94975dc9a"]], "TableText",ExpressionUUID->
     "5ddaac63-3669-4e9b-bd17-287cdfe866e2"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "deea3e7d-e318-4cfd-8587-4bcea5b62640"]], "TableText",ExpressionUUID->
     "ac4c2000-2573-450c-9ade-ad268b3cb1ab"], Cell[TextData[{
     StyleBox["n", "TI"],
     " (stop at the ",
     StyleBox["n", "TI"],
     "-th return to a visited vertex), a predicate on the walk so far, or ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"spec", ",", " ", 
        RowBox[{"\"\<Delay\>\"", " ", "->", " ", "k"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "06db7e40-b9d3-42e6-9a71-c573546c6748"]
    }], "TableText",ExpressionUUID->"490a8e58-a5b3-44c2-9e3f-c478a4cc9898"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9c9d0f49-1868-4a10-875e-d6186096d1bd"], Cell[TextData[Cell[
    BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5d1230bb-6b77-452d-8826-6bdd7515a127"]], "TableText",ExpressionUUID->
     "aaf8cb97-7085-4e09-bb2c-fbfd4088fe71"], Cell[TextData[Cell[BoxData[
    "Identity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "51b1ecde-1190-4794-9363-a79a90174851"]], "TableText",ExpressionUUID->
     "6c76398c-446a-43d8-b78f-a4530ded03fc"], Cell[TextData[{
     "a function of the candidate windows -- the window with one admissible \
candidate appended -- giving the ones to pursue, in the order to try: ",
     Cell[BoxData["Identity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ae042750-bf93-428c-b560-37416f11305f"],
     " the canonical order, ",
     Cell[BoxData["RandomSample"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8e46d6c7-da1f-431b-82f1-373dc43198d0"],
     " a random order, ",
     Cell[BoxData["RandomChoice"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a03fd7c9-2c9b-4b90-846d-6f73aacac2e8"],
     " the random walk, ",
     Cell[BoxData[
      RowBox[{"MinimalBy", "[", "f", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5737229f-618e-463d-ac63-cc46dceeeee0"],
     " the candidates least by ",
     Cell[BoxData[
      RowBox[{"f", "[", "window", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "985deb1b-6a34-426a-8745-bb22d477ac7e"],
     ", ",
     Cell[BoxData[
      RowBox[{
       RowBox[{"RandomSample", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"UpTo", "[", "n", "]"}]}], "]"}], " ", "&"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "d3e12804-c6f0-491c-8674-3cc586381664"],
     " a pruning to ",
     StyleBox["n", "TI"],
     " branches per node"
    }], "TableText",ExpressionUUID->"36e3ef20-7836-451f-a146-2ef3e47fdeb7"]}
  }]], "3ColumnTableMod",ExpressionUUID->"7722c3f0-46a4-4271-ab94-\
dc2e50464609"],

Cell[TextData[{
 "The default ",
 Cell[BoxData["\"\<Direction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81acba2c-50bc-4eb3-82c6-ea80901a981e"],
 " is ",
 Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbd0e106-94a2-4696-ae14-bcfb053d8dcb"],
 " on a one-vertex germ and ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "edfdc551-9d71-4c23-9900-81b8388a5b77"],
 " on a longer one. With a stopping condition it is ",
 Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc40b35b-1b26-4e4e-bd80-9e02b00945cf"],
 " for every germ, since the condition needs one tip, and an explicit ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "199ced6e-fa5b-4c78-839f-f5ab283dc591"],
 " with a condition leaves the call unevaluated. In a list of germs the \
default is read per germ."
}], "Notes",ExpressionUUID->"93b08535-9dad-4b8e-a2a4-904c6e1464fa"],

Cell["\<\
A walk stops when a stopping condition fires, the budget is spent, or no \
admissible step remains.\
\>", "Notes",ExpressionUUID->"ce7c6376-df53-4cfb-a536-38b675df9db9"],

Cell[TextData[{
 "An endpoint is a stopping condition. ",
 Cell[BoxData[
  RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "q"}], " ", "&"}], 
    ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ddfbce0-4c22-4ed2-8132-ae7bb9dcbf92"],
 " stops each walk at its first arrival at ",
 StyleBox["q", "TI"],
 "; the result is every maximal walk of the class, and the ones that end at \
",
 StyleBox["q", "TI"],
 " are the walks from the germ to ",
 StyleBox["q", "TI"],
 ". A shortest path between two points is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f7f3114c-533c-49be-bdbf-7307aa5761f7"],
 "; the walk family has no two-point form. In the classes ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6ed95a4-0aed-4936-8cbe-340721119886"],
 " and ",
 Cell[BoxData[
  RowBox[{"{", "\"\<Immersed\>\"", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b442435-d93d-41aa-9edc-0a66051788ed"],
 " a walk can pass ",
 StyleBox["q", "TI"],
 " before it ends there; those walks are reached with an exact budget ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02476008-8d04-4b9c-9e21-03ec1a1341c6"],
 " and the same selection, without the condition."
}], "Notes",ExpressionUUID->"d9ba2957-85bc-41f5-9932-e752bd32c0ba"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c3539bf4-3a5a-4018-8b15-fd349730cbad"],
 " is this call at ",
 Cell[BoxData[
  RowBox[{"\"\<InfraScale\>\"", " ", "->", " ", "s"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab266b04-a089-4430-9419-d5faa0f103b0"],
 " with ",
 Cell[BoxData["\"\<Minimizing\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3fdaae6-57b6-441b-a914-188da9215fe3"],
 " added to the rules."
}], "Notes",ExpressionUUID->"6e07d639-1cef-4ac8-9567-1b9b720e4764"]
}, Open  ]],

