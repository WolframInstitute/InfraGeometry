Notebook[{

Cell[CellGroupData[{
Cell["FindInfraWalk", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"39160ef9-1251-40cc-83a5-e2b7cfaa3922"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb26a50c-8a86-4ff4-b8f0-770195e75784"],
 "\[LineSeparator]",
 "gives one walk grown from ",
 StyleBox["germ", "TI"],
 " in the class cut by ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8dba36bd-aae6-4161-88d8-101ccd599a8d"],
 ", until a stopping condition fires or the budget ",
 StyleBox["kspec", "TI"],
 " is spent.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b0ffd3e7-5e2f-44b0-bdd4-3fa378cd5369"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraWalk"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraWalk", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["germ", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f89aa992-6504-42e7-822e-9da6bd0d2a01"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c729ea7-552e-4664-9b58-7f8a79a8d604"],
 " of exactly ",
 StyleBox["n", "TI"],
 " walks or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6507df33-e9c2-41d2-91c7-2aacbe496d0c"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9a22efc8-2964-40a7-b08a-778889135573"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f373fcf2-b7e2-43f6-a086-06d2aaa5b33b"],
 " gives every one."
}], "Usage",ExpressionUUID->"4145677c-d691-41e1-bf2b-362643e27ab6"],

Cell[TextData[{
 "The germ is the seed of the walk: a vertex, a vertex list, a walk graph, or \
a list of germs. A vertex is the one-vertex germ, so ",
 Cell[BoxData[
  RowBox[{"FindInfraWalk", "[", 
   RowBox[{"g", ",", " ", "p", ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c132d237-105b-42c1-9f2b-95a050e0c34c"],
 " and ",
 Cell[BoxData[
  RowBox[{"FindInfraWalk", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"{", "p", "}"}], ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b667838c-5571-4cf1-9c0b-951758e6fb12"],
 " are the same call. A germ is read as a vertex first, so on a substrate \
labelled by lists the vertex ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "1"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a28d75dd-756f-4637-aa9a-3004ce191846"],
 " is one point, not the walk of its entries. A walk graph is read as its \
vertex sequence; a list of germs gives the walks grown from each."
}], "Notes",ExpressionUUID->"b12aedf0-ab20-475c-bc22-b156f9901752"],

Cell[TextData[{
 StyleBox["kspec", "TI"],
 " is the budget in edges added on each growing side: ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "k", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8fa5532f-7ce3-4305-a239-ed88b401259e"],
 " (at most ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f83ce5f3-5fce-411b-9675-26838cef2b77"],
 " (exactly ",
 StyleBox["k", "TI"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d7f7c560-47a8-45f7-b33a-b85abf580655"],
 ", or ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87013269-caa6-4b41-b6a5-bcb51d993de2"],
 ". A bare integer is no ",
 StyleBox["kspec", "TI"],
 ". ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a2fc44d-e012-433b-a009-53f7fdcc86ff"],
 " is legal only when a rule of the class bounds it, as the default ",
 Cell[BoxData["\"\<Simple\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ca4925b-1de4-4df0-ae45-e7140921edee"],
 " does."
}], "Notes",ExpressionUUID->"125ff337-39d5-4b0c-8b51-9727a61124f5"],

Cell[TextData[{
 "A walk is a graph: a directed path graph on the pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "v"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b170ab2-2085-438f-9221-3d1ed2da5f6f"],
 ", the position and the vertex. ",
 Cell[BoxData[
  RowBox[{"Last", " ", "/@", " ", 
   RowBox[{"VertexList", "[", "w", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43dac7cd-fa9c-4125-b0c4-7a747b13e328"],
 " is its vertex sequence. The count-less call returns one walk graph, or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a18a836f-f59c-4d81-9d82-7c8fbb8a0ae6"],
 " when there is none. The first walk is the first branch of the descent, a \
witness, not a shortest path."
}], "Notes",ExpressionUUID->"c923da58-0460-43d7-b0d8-09a8840136b0"],

Cell[TextData[{
 "The class is cut by ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "810c8432-d609-46db-b679-db42ed1faf5b"],
 ", each rule read on the window of the last ",
 Cell[BoxData["\"\<InfraScale\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "637f2307-bcb2-431d-8c1a-a2c14fa7096b"],
 " vertices with the candidate:"
}], "Notes",ExpressionUUID->"87b29dce-a0f7-400f-b506-837c83090ffb"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6eaa8bf4-6966-4560-b4b1-3a846b82913a"], Cell["Option", "TableText",
