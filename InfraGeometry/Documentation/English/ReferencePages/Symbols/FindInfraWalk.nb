Cell[TextData[{
 "A function is a rule: the energy ",
 Cell[BoxData[
  RowBox[{"GraphDistance", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"Last", " ", "@", " ", "w"}], ",", " ", "q"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04d033de-eaaf-4791-a35d-18dd7361be7c"],
 " at window 1 and weight 0.3 pulls the walk toward ",
 StyleBox["q", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"41044275-c503-4dba-b082-2c4ab55d7a4b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "6"}], "]"}]}], ")"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", "\n", "      ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
            RowBox[{"FindInfraWalk", "[", 
             RowBox[{"g", ",", " ", "a", ",", " ", 
              RowBox[{"{", "12", "}"}], ",", " ", 
              RowBox[{"Properties", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"w", " ", "|->", " ", 
                   RowBox[{"GraphDistance", "[", 
                    RowBox[{"g", ",", " ", 
                    RowBox[{"Last", " ", "@", " ", "w"}], ",", " ", "q"}], 
                    "]"}]}], ",", " ", "1", ",", " ", "0.3"}], "}"}], 
                "}"}]}]}], "]"}]}], ")"}], ",", " ", "a", ",", " ", "q"}], 
         "}"}], ",", "\n", "      ", 
        RowBox[{"\"\<Arrowheads\>\"", " ", "->", " ", "True"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"seed", ",", " ", "3"}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"27142213-50ab-4b3a-b251-ddafacf63c84"],

