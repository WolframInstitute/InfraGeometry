Cell["Properties", "ExampleSubsection",ExpressionUUID->"027dbb93-044f-4ac5-98e6-8f1b874da92a"],

Cell["\<\
The class widens from the simple walks to every walk of at most 4 edges.\
\>", "ExampleText",ExpressionUUID->"f6673626-59ac-465b-9b43-2a0216ddbf4e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"walks", " ", "=", " ", 
          RowBox[{"FindInfraWalk", "[", 
           RowBox[{"g", ",", " ", "a", ",", " ", 
            RowBox[{"UpTo", "[", "4", "]"}], ",", " ", "All", ",", " ", 
            RowBox[{"Properties", " ", "->", " ", "rules"}]}], "]"}]}], "}"}],
         ",", "\n", "      ", 
        RowBox[{"Labeled", "[", 
         RowBox[{
          RowBox[{"InfraSubstrateHighlight", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"{", 
             RowBox[{"walks", ",", " ", "a"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"rules", ",", " ", "\"\<: \>\"", ",", " ", 
             RowBox[{"Length", " ", "@", " ", "walks"}]}], "}"}], "]"}]}], 
         "]"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"rules", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "\"\<Simple\>\"", "}"}], ",", " ", 
          RowBox[{"{", "\"\<Immersed\>\"", "}"}], ",", " ", 
          RowBox[{"{", "}"}]}], "}"}]}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0914995c-3cf0-4dca-87c6-74d22be6c1df"],

