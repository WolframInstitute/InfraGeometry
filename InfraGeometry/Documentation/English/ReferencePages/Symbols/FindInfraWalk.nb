Cell["One walk of exactly 5 edges, beside its vertex sequence.", "ExampleText",ExpressionUUID->"be751f71-3106-4a28-8d13-8f29819b257b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walk", " ", "=", " ", 
     RowBox[{"FindInfraWalk", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", 
       RowBox[{"{", "5", "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"walk", ",", " ", 
         RowBox[{"Directive", "[", "$InfraPointColor", "]"}], ",", " ", "a"}],
         "}"}]}], "]"}], ",", " ", 
     RowBox[{"Last", " ", "/@", " ", 
      RowBox[{"VertexList", "[", "walk", "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1dedcba9-603d-4c31-b7b8-4cadb52204af"],

