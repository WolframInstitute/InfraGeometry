Cell[TextData[{
 "Under ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34af1461-6b23-4d0a-9e81-f2c8dca25d89"],
 " the predicate reads both tips: the shortest paths through an edge of the \
grid stop when the back reaches 22 or the front reaches 28, whichever comes \
first."
}], "ExampleText",ExpressionUUID->"67b61828-62d5-4062-906e-3c432effa809"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"7", ",", " ", "7"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{"FindInfraWalk", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"24", ",", " ", "25"}], "}"}], ",", " ", "Infinity", ",", " ",
        "All", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Shortest\>\"", "}"}]}], ",", " ", 
       RowBox[{"\"\<Direction\>\"", " ", "->", " ", "\"\<BothSides\>\""}], ",",
        "\n", "    ", 
       RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"First", "[", "#", "]"}], " ", "===", " ", "22"}], " ", "||",
            " ", 
           RowBox[{
            RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "28"}]}], " ", 
          "&"}], ")"}]}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"stopped", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"walks", ",", " ", 
       RowBox[{
        RowBox[{"MatchQ", "[", 
         RowBox[{
          RowBox[{"Last", " ", "/@", " ", 
           RowBox[{"VertexList", " ", "@", " ", "#"}]}], ",", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"22", ",", " ", "__"}], "}"}], " ", "|", " ", 
           RowBox[{"{", 
            RowBox[{"__", ",", " ", "28"}], "}"}]}]}], "]"}], " ", "&"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"stopped", ",", " ", 
         RowBox[{"{", 
          RowBox[{"24", ",", " ", "25"}], "}"}], ",", " ", "22", ",", " ", 
         "28"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"walks", ",", " ", "stopped"}], "}"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"78c56137-35b2-41d4-8b14-cb83ce2c4119"],

