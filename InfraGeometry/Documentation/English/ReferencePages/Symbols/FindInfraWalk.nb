Cell["\<\
All simple walks of 3 edges from the centre of the square tiling.\
\>", "ExampleText",ExpressionUUID->"93265dee-e72a-44a9-9738-2b2605bc4145"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{"FindInfraWalk", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", 
       RowBox[{"{", "3", "}"}], ",", " ", "All", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Simple\>\"", "}"}]}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"walks", ",", " ", "a"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "walks"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1ee089a0-ab53-437e-b2ef-114c31d301f5"],

