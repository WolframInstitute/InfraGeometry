      FontSize->0.9 Inherited,ExpressionUUID->
      "e92f240e-77e3-4302-8f7f-56a62d6e2c06"],
     " (no repeated vertex), ",
     Cell[BoxData["\"\<Immersed\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4c76d843-b032-4446-85e2-bf092a8fa5e3"],
     " (no backtrack), ",
     Cell[BoxData["\"\<Generic\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6df8cf25-4aef-46da-8d63-7b8984ac3a64"],
     " (no cusp, self-tangency or triple point), ",
     Cell[BoxData[
      RowBox[{"\"\<Exclude\>\"", " ", "->", " ", "species"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a71f9ef7-d6a1-4593-b4d6-c359f40913de"],
     ", ",
     Cell[BoxData["\"\<Minimizing\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "04a5fbaa-cd20-41a9-af00-44f00ff4fb2c"],
     ", or a predicate on the window; ",
     Cell[BoxData[
      RowBox[{"{", "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0b9a353b-71a8-4f91-b44d-1cba3fd8d948"],
     " is every walk"
    }], "TableText",ExpressionUUID->"251d905b-37a3-480b-8656-fb0fe95f866a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "41c9fc1d-cac8-489f-8d60-c396a5307ee6"], Cell[TextData[Cell[
    BoxData["\"\<InfraScale\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "8e089a37-7a9e-4919-b1b0-3f1183549c4d"]], "TableText",ExpressionUUID->
     "ef3f66b5-5044-4f5f-82ca-102b74352761"], Cell[TextData[Cell[BoxData[
    "Infinity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "daf5d004-06ca-4907-bf1d-95905269c82a"]], "TableText",ExpressionUUID->
     "03b34a5c-d4fd-4be6-8f2a-326294a7fe77"], Cell[
    "how many vertices back a rule sees", "TableText",ExpressionUUID->
     "98c3c060-bd64-49a0-8937-04a1064e552c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4f27d52f-a8e4-44c9-8286-88228a37fc30"], Cell[TextData[Cell[
    BoxData["\"\<Direction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f103d648-fee0-4195-8581-3da50bc26cd1"]], "TableText",ExpressionUUID->
     "fc702249-f14d-4e63-9c79-5382b7eb65d4"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "fc1816c4-9eba-4602-a1e2-e4f95373076c"]], "TableText",ExpressionUUID->
     "f7f5572f-063f-48e8-80cc-d694ed3c67cc"], Cell[TextData[{
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f27bb7f6-1178-4ecb-95b2-a96f6a4cc643"],
     ", ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "12fb5e1c-16f4-4430-91cf-b55d34316f55"],
     " or ",
     Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "767f81a0-1809-479c-81ab-0557862644ee"]
    }], "TableText",ExpressionUUID->"c22c3e71-1029-40af-b99e-1783648680ce"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "96cc7548-1c38-4717-8430-6ad933a12c83"], Cell[TextData[Cell[
    BoxData["\"\<StoppingCondition\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6c717f7c-a7b3-49bc-bd3b-22fe0816122b"]], "TableText",ExpressionUUID->
     "9386b487-2f7c-4d75-b3a6-ab6a43efa695"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9400b299-c8bd-4190-9de3-a9a861d3b47f"]], "TableText",ExpressionUUID->
     "bf13526a-f726-4146-957d-ef89a1ea911c"], Cell[TextData[{
     StyleBox["n", "TI"],
     " (stop at the ",
     StyleBox["n", "TI"],
     "-th return to a visited vertex), a predicate on the walk so far, or ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"spec", ",", " ", 
        RowBox[{"\"\<Delay\>\"", " ", "->", " ", "k"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f92162ba-f786-45f7-97c2-7af95e9dc1f5"]
    }], "TableText",ExpressionUUID->"ea6f3f19-738c-4b7f-bb1d-d2fc912eaeba"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b1584d87-e04c-46ec-bef5-f3db94a03180"], Cell[TextData[Cell[
    BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b45776f4-5312-4e3e-8f85-2cb256673c3d"]], "TableText",ExpressionUUID->
     "208453e8-cbec-4367-963f-fcf89cfa84cb"], Cell[TextData[Cell[BoxData[
    "Identity"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "69e9c001-4aa6-4ed9-be4e-4048023dc93f"]], "TableText",ExpressionUUID->
     "8cf39bc5-8139-45c8-a158-428c3b671ead"], Cell[TextData[{
     "a function of the candidate windows -- the window with one admissible \
candidate appended -- giving the ones to pursue, in the order to try: ",
     Cell[BoxData["Identity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b0af8568-8066-4de8-a336-00f4ecf89041"],
     " the canonical order, ",
     Cell[BoxData["RandomSample"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9902afc8-0d99-4e4b-8032-ae1c4a5d8004"],
     " a random order, ",
     Cell[BoxData["RandomChoice"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0b835a23-8c54-4e63-920b-14e22f07ef18"],
     " the random walk, ",
     Cell[BoxData[
      RowBox[{"MinimalBy", "[", "f", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "50aa62c0-86ad-45bd-989f-6c77fe0bb74c"],
     " the candidates least by ",
     Cell[BoxData[
      RowBox[{"f", "[", "window", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "589fcb03-73af-4b2d-98ff-5e39e652361a"],
     ", ",
     Cell[BoxData[
      RowBox[{
       RowBox[{"RandomSample", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"UpTo", "[", "n", "]"}]}], "]"}], " ", "&"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9ebf6700-bf88-4307-a91d-19a48f5c91a8"],
     " a pruning to ",
     StyleBox["n", "TI"],
     " branches per node"
    }], "TableText",ExpressionUUID->"2ee547ba-ecc2-4adf-bec0-4e08e44701f5"]}
  }]], "3ColumnTableMod",ExpressionUUID->"c6f5b718-3ece-474e-89dc-\
d3b2a5ef8303"],

Cell[TextData[{
 "The default ",
 Cell[BoxData["\"\<Direction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c501c030-3d3b-4af6-916f-03c640d9b9f3"],
 " is ",
 Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "686ed776-da71-461b-93f7-2bd5b3f9ead0"],
 " on a one-vertex germ and ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3795b7f8-fb9b-41d6-b24f-83938b390f3e"],
 " on a longer one. With a stopping condition it is ",
 Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "960186a2-3263-4559-8091-3d89eee1fe70"],
 " for every germ, since the condition needs one tip, and an explicit ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cdad3ff6-4e29-41b3-80c9-a1f070cb3e5b"],
 " with a condition leaves the call unevaluated. In a list of germs the \
default is read per germ."
}], "Notes",ExpressionUUID->"06d1a0f5-acda-4397-979e-1cab0b331ce1"],

Cell["\<\
A walk stops when a stopping condition fires, the budget is spent, or no \
admissible step remains.\
\>", "Notes",ExpressionUUID->"2c1b1e09-8ecd-4bcc-ad7a-9f2d84452c44"],

Cell[TextData[{
 "An endpoint is a stopping condition. ",
 Cell[BoxData[
  RowBox[{"\"\<StoppingCondition\>\"", " ", "->", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "q"}], " ", "&"}], 
    ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a262840b-48c9-4512-8cd7-12a367e2b532"],
 " stops each walk at its first arrival at ",
 StyleBox["q", "TI"],
 "; the result is every maximal walk of the class, and the ones that end at \
",
 StyleBox["q", "TI"],
 " are the walks from the germ to ",
 StyleBox["q", "TI"],
 ". A shortest path between two points is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8414b35f-e641-4eaa-aa9d-b2df1c9d129a"],
 "; the walk family has no two-point form. In the classes ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a7eeb8b-a3d9-4aed-bd0b-e0b8133a1b30"],
 " and ",
 Cell[BoxData[
  RowBox[{"{", "\"\<Immersed\>\"", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60f09068-e89a-42c9-a235-88c82a27048c"],
 " a walk can pass ",
 StyleBox["q", "TI"],
 " before it ends there; those walks are reached with an exact budget ",
 Cell[BoxData[
  RowBox[{"{", "k", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29d715e8-fd0e-4cf8-a745-921f41ba2f06"],
 " and the same selection, without the condition."
}], "Notes",ExpressionUUID->"464a3062-8222-4a96-9601-4e283da69f1d"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraGeodesic"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraGeodesic", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f0ac6c12-ed7d-4f76-ad0d-495c34687536"],
 " is this call at ",
 Cell[BoxData[
  RowBox[{"\"\<InfraScale\>\"", " ", "->", " ", "s"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "507b2c96-8e85-4ce0-9ccd-3d79e2f0a992"],
 " with ",
 Cell[BoxData["\"\<Minimizing\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9575552b-4b4b-4fe0-b398-eaf688eb0bdf"],
 " added to the rules."
}], "Notes",ExpressionUUID->"3c8d8d0a-4bf6-4efc-bc75-3e276acb4abc"]
}, Open  ]],

