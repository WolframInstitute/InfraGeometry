Cell[TextData[{
 "A soft rule changes the order, not the class: under ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56e53b69-3915-4861-8fca-f705285dc558"],
 " the weighted walks are the walks of the hard rules."
}], "ExampleText",ExpressionUUID->"d76f3329-f24d-453c-9f8e-18030b9be0eb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"FindInfraWalk", "[", 
       RowBox[{"g", ",", " ", "a", ",", " ", 
        RowBox[{"{", "4", "}"}], ",", " ", "All", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Simple\>\"", ",", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<Shortest\>\"", ",", " ", "3", ",", " ", "0.3"}], 
            "}"}]}], "}"}]}]}], "]"}]}], " ", "===", "\n", "    ", 
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"FindInfraWalk", "[", 
       RowBox[{"g", ",", " ", "a", ",", " ", 
        RowBox[{"{", "4", "}"}], ",", " ", "All", ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
         RowBox[{"{", "\"\<Simple\>\"", "}"}]}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"ee5c76cd-ea34-4db0-8dd2-bb16fbede7bc"],

Cell[BoxData[
 RowBox[{"{", "True", "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"31638821-efd5-4c42-b27f-86c7ad45600f"]
}, Open  ]],

Cell[TextData[{
 "The cusps, self-tangencies and triple points of a walk are read by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WalkSingularities"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/WalkSingularities", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bdf575ba-bc13-4feb-8c03-244392aefac2"],
 "; a class free of one of them is a predicate on it."
}], "ExampleText",ExpressionUUID->"cb15ff73-0188-4902-b4c3-ea30a3798e57"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"walks", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"FindInfraWalk", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", 
         RowBox[{"{", "6", "}"}], ",", " ", "All", ",", " ", 
         RowBox[{"Properties", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"\"\<Simple\>\"", ",", " ", "2"}], "}"}], "}"}]}]}], 
        "]"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"WalkSingularities", "[", 
           RowBox[{"Last", " ", "/@", " ", 
            RowBox[{"VertexList", " ", "@", " ", "#"}]}], "]"}], 
          "[", "\"\<SelfTangencies\>\"", "]"}], " ", "=!=", " ", 
         RowBox[{"{", "}"}]}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"walks", ",", " ", 
           RowBox[{"UpTo", "[", "3", "]"}]}], "]"}], ",", " ", "a"}], "}"}]}],
       "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", "walks"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"f8750811-72f3-480f-a298-c07d829dedc4"],

