Cell["\<\
The fibers partition the vertices of the total graph. The vertical edges are \
the edges of the fibers, here 72 of the 144 edges of the grid:\
\>", "ExampleText",ExpressionUUID->"7c95d270-7a67-443a-801e-925c4004d0d9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{"Round", " ", "@", " ", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", "g", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}]}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"VertexCount", " ", "/@", " ", 
        RowBox[{"InfraFibers", "[", "fib", "]"}]}], "]"}], " ", "==", " ", 
      RowBox[{"VertexCount", "[", "g", "]"}]}], ",", " ", 
     RowBox[{"Total", "[", 
      RowBox[{"EdgeCount", " ", "/@", " ", 
       RowBox[{"InfraFibers", "[", "fib", "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"EdgeCount", "[", "g", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c2ee2ec4-b6fe-4a1f-8803-50f366d9d98e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "72", ",", "144"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"46adc9a7-ab38-4f29-83dc-347c6c724288"]
}, Open  ]]
}, Open  ]],

