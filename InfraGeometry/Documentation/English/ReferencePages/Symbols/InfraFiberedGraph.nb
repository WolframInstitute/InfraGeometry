Cell["A cycle wraps twice around its reconstructed square base.", \
"ExampleText",ExpressionUUID->"dbd02483-057b-49e1-8f2e-ece9c41f47c2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}], ",", " ", 
       RowBox[{"vertex", " ", "|->", " ", 
        RowBox[{"Mod", "[", " ", 
         RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
      " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", " ", 
      RowBox[{"InfraFiber", "[", " ", 
       RowBox[{"fib", ",", " ", "1"}], " ", "]"}], " ", "}"}]}], " ", "]"}]}],
   " ", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2996f826-a458-4e40-a0ae-dd7fc8ef4a0c"],

