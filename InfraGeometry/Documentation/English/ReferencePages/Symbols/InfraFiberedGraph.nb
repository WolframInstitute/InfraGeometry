Notebook[{

Cell[CellGroupData[{
Cell["InfraFiberedGraph", "ObjectName",ExpressionUUID->"cb49f5fd-71a0-400e-99ba-dd239d338939"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9e6c3dfc-9942-4cff-8bb7-2db02dfe7e29"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFiberedGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["total", "TI"], ",", " ", 
    StyleBox["projection", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76d03f17-dd65-4e1f-b6ba-3717ccbfc0e7"],
 "\[LineSeparator]",
 "is an inert fibered graph with total graph ",
 StyleBox["total", "TI"],
 " and a vertex projection given by an association or a function.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"fd5e606f-9d2c-43f4-8410-cafe5126b105"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFiberedGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["model", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac9f0797-0049-4d8c-a8a6-2d20d5e71549"],
 "\[LineSeparator]",
 "materializes an Experimental construction as a literal fibered graph, \
computing its total graph once."
}], "Usage",ExpressionUUID->"f1b588cf-51b9-4ff1-acb9-b97d1419bb20"],

Cell["\<\
The general object imposes no equal-size, lifting, matching or triviality \
condition. Separate predicates test these properties.\
\>", "Notes",ExpressionUUID->"bd423e62-67ef-450d-9145-02253bafb9e8"],

Cell["\<\
Readers support finite simple undirected unweighted untagged total graphs. \
Unsupported graph domains remain unevaluated; projection-dependent readers \
also leave malformed association projections unevaluated.\
\>", "Notes",ExpressionUUID->"9daf6dd4-d4d4-41ef-ab5c-55fb5aa78e23"],

Cell["\<\
An association projection has exactly one key for each total vertex. A \
function projection is evaluated at each total vertex.\
\>", "Notes",ExpressionUUID->"fd1a1c66-af84-4a2d-9198-bd1d0ae0e2b5"],

Cell["\<\
Edge-tagged graphs are unsupported; readers do not discard or merge edge tags.\
\>", "Notes",ExpressionUUID->"f8e61632-fc5e-4163-920b-8aec514a3bb5"],

Cell[TextData[{
 "Vertex labels are literal expressions. List-valued and pattern-like \
vertices remain individual association keys; use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Key"]], "paclet:ref/Key"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6a149226-1332-48ce-9cd5-bcf0623a979d"],
 " for literal lookup."
}], "Notes",ExpressionUUID->"b4712879-1ba8-41fb-9188-d3d7b15330a4"],

Cell[TextData[{
 Cell[BoxData["InfraTotalSpace"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb3b4a87-3bdf-43d8-87a9-6cb3896ed565"],
 " gives the total graph and ",
 Cell[BoxData["InfraProjection"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0278b96e-df8b-4c90-ac9c-1e97bfa712f5"],
 " gives the projection association."
}], "Notes",ExpressionUUID->"673d44b2-d6b1-4f74-83b3-cd1ab8760184"],

Cell[TextData[{
 Cell[BoxData["InfraBaseSpace"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd746a3e-4e71-4179-9947-95d95f3f605e"],
 " reconstructs the base. Its vertices are all projection values, including \
those represented only by isolated total vertices."
}], "Notes",ExpressionUUID->"9ab1e9e6-46b9-45a1-8aef-4c051d4d6621"],

Cell["\<\
Distinct base vertices are adjacent exactly when a total edge joins their \
fibers. Edges within a fiber are vertical and collapse under projection.\
\>", "Notes",ExpressionUUID->"40131db2-3083-4a15-b877-579a48c1948e"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiber"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiber", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3dac10b1-e9ec-4c67-a593-5c3104a30407"],
 " gives the induced graph on one projection preimage. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibers"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibers", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aa1620ee-05a8-4539-9f30-1884737d936b"],
 " gives all fibers as an association."
}], "Notes",ExpressionUUID->"9ba5d246-09a6-4ad9-9e26-d3c839a73ff7"],

Cell["\<\
The empty graph with the empty projection is a valid fibered graph.\
\>", "Notes",ExpressionUUID->"c2281cf6-c976-4b47-8a75-d1606ea289bc"],

Cell[TextData[{
 "The head stays inert even when its arguments are unsupported. ",
 Cell[BoxData["InfraFiberedGraphQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d691d1f-cb97-42a7-8907-b36345fdd376"],
 " recognizes supported literal objects; supported Experimental models are \
materialized by their explicit category methods."
}], "Notes",ExpressionUUID->"0f080141-7fb2-4ba5-8995-6b647333b9c9"],

