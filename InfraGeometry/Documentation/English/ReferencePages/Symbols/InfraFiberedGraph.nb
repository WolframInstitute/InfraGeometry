Cell["\<\
The cycle of length 8 wraps twice around its base, the cycle of length 4. The \
fiber over 1 is drawn:\
\>", "ExampleText",ExpressionUUID->"8393f34b-ceac-4038-a86b-e7aea8979e69"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
       RowBox[{"v", " ", "|->", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{"v", ",", " ", "4", ",", " ", "1"}], "]"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InfraFiberedGraphHighlight", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"{", 
         RowBox[{"InfraFiber", "[", 
          RowBox[{"fib", ",", " ", "1"}], "]"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"InfraBaseSpace", "[", "fib", "]"}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3b2ba460-c4bf-4d28-a6ba-18b39ec297a2"],

Cell[BoxData[
 GraphicsBox[{{}, {InsetBox[
     FormBox[
      GraphicsBox[
       NamespaceBox["NetworkGraphics",
        DynamicModuleBox[{Typeset`graph = HoldComplete[
          Graph[{1, 2, 3, 4, 5, 6, 7, 8}, {Null, 
            SparseArray[
            Automatic, {8, 8}, 0, {
             1, {{0, 2, 4, 6, 8, 10, 12, 14, 16}, {{2}, {8}, {1}, {3}, {2}, {
               4}, {3}, {5}, {4}, {6}, {5}, {7}, {6}, {8}, {1}, {7}}}, 
              Pattern}]}, {
           GraphLayout -> {
             "Dimension" -> 2, "VertexLayout" -> "CircularEmbedding"}, 
            VertexCoordinates -> {{-0.6666666666666667, 
             1.0106430996148606`*^-15}, {0.3333333333333326, 1.}, {
             1.3333333333333333`, -1.133107779529596*^-15}, {
             0.3333333333333339, -1.}, {-1.3333333333333333`, 
