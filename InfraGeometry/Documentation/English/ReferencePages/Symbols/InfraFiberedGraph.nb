Cell["A construction gives the same fibers as its fibered graph:", \
"ExampleText",ExpressionUUID->"a6ff138e-842a-406e-8deb-a734e0ac4e84"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"model", " ", "=", " ", 
     RowBox[{"InfraDisplacementBundle", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", "1"}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", "model", "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Head", "[", "fib", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"InfraFibers", "[", "fib", "]"}], " ", "===", " ", 
      RowBox[{"InfraFibers", "[", "model", "]"}]}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"ea060f50-2c91-479a-b551-a822c352935d"],

