Notebook[{

Cell[CellGroupData[{
Cell["InfraFiberedGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"022f8f2b-e120-4d9d-afcf-226e86ea7686"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFiberedGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["total", "TI"], ",", " ", 
    StyleBox["projection", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c4d3a6a-c4fc-4425-bed7-624ff925681d"],
 "\[LineSeparator]",
 "is an inert fibered graph with total graph ",
 StyleBox["total", "TI"],
 " and a vertex projection given by an association or a function.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d527682b-c911-4104-b930-a1077898d7a9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFiberedGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["model", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb46d31a-c80d-454a-96c7-50d869cac386"],
 "\[LineSeparator]",
 "materializes an Experimental construction as a literal fibered graph, \
computing its total graph once."
}], "Usage",ExpressionUUID->"99ec74e5-013d-4334-9cfe-b898e1c8a6c3"],

Cell["\<\
The general object imposes no equal-size, lifting, matching or triviality \
condition. Separate predicates test these properties.\
\>", "Notes",ExpressionUUID->"41c0dc90-93bf-46d9-9437-7408692a796d"],

Cell["\<\
Readers support finite simple undirected unweighted untagged total graphs. \
Unsupported graph domains remain unevaluated; projection-dependent readers \
also leave malformed association projections unevaluated.\
\>", "Notes",ExpressionUUID->"60678b89-7d76-40f4-88ff-2f1e68fc80bb"],

Cell["\<\
An association projection has exactly one key for each total vertex. A \
function projection is evaluated at each total vertex.\
\>", "Notes",ExpressionUUID->"d131014a-44cb-4cb5-a9af-caec12a484f2"],

Cell["\<\
Edge-tagged graphs are unsupported; readers do not discard or merge edge tags.\
\>", "Notes",ExpressionUUID->"289e833d-18d6-492f-88dd-63f35df634ee"],

Cell[TextData[{
 "Vertex labels are literal expressions. List-valued and pattern-like \
vertices remain individual association keys; use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Key"]], "paclet:ref/Key"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "30bb22f1-af74-4f50-a9cf-8d6b65bf0985"],
 " for literal lookup."
}], "Notes",ExpressionUUID->"96d9d7d8-4b88-4c1c-be9b-164497fb5a79"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTotalSpace"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTotalSpace", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "52bc66e2-1a33-402c-99bc-b01052774a24"],
 " gives the total graph and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraProjection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraProjection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dc1e183a-6486-4f4c-9503-b39f46b7d1f5"],
 " gives the projection association."
}], "Notes",ExpressionUUID->"97f80545-0694-46ce-8a06-dad97e54b624"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBaseSpace"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBaseSpace", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e52ed3b7-4f0b-4605-8daf-9406bdb6e6be"],
 " reconstructs the base. Its vertices are all projection values, including \
those represented only by isolated total vertices."
}], "Notes",ExpressionUUID->"8745d943-7f0e-4dc9-a52f-bb86fdcc5740"],

Cell["\<\
Distinct base vertices are adjacent exactly when a total edge joins their \
fibers. Edges within a fiber are vertical and collapse under projection.\
\>", "Notes",ExpressionUUID->"6a317e1b-814f-48bf-b0d3-47a9dbface07"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiber"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiber", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ebeceabd-7483-43c4-b9f0-02036c56606a"],
 " gives the induced graph on one projection preimage. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFibers"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFibers", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b8f58c97-9a12-42fb-b84c-492ad07004aa"],
 " gives all fibers as an association."
}], "Notes",ExpressionUUID->"1bfc469d-fb88-4ab6-82e5-d4dd34ce995b"],

Cell["\<\
The empty graph with the empty projection is a valid fibered graph.\
\>", "Notes",ExpressionUUID->"d4ec6674-c92f-434b-8de1-9707f1fb8246"],

Cell[TextData[{
 "The head stays inert even when its arguments are unsupported. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiberedGraphQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraphQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "95ed3d9f-a92e-49c4-acab-775eee602f0d"],
 " recognizes supported literal objects; supported Experimental models are \
materialized by their explicit category methods."
}], "Notes",ExpressionUUID->"71a108c6-0323-46a1-b97e-071c4e2f66b5"],

