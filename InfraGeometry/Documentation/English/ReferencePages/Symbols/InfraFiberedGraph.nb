Cell[TextData[{
 "A projection can give fibers of different sizes and vertices without lifts. \
Over ",
 Cell[BoxData["\"\<b\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf74e35f-2e37-49da-ad1b-f693af453756"],
 " there is one vertex; the vertex 1 over ",
 Cell[BoxData["\"\<a\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2965bee9-08ff-4669-8e48-d943c224ced7"],
 " and the vertices 5 and 6 over ",
 Cell[BoxData["\"\<c\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72a0d762-cdc9-493e-98cf-3297199e7504"],
 " have no neighbour over ",
 Cell[BoxData["\"\<b\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77c9b7ad-e372-43cb-9cea-c2e0b7658c35"],
 ":"
}], "ExampleText",ExpressionUUID->"9a5d8d7f-c4a4-4203-9130-370716fa38b3"],

