Cell["\<\
A general projection can have unequal fibers and missing lifts.\
\>", "ExampleText",ExpressionUUID->"6447023f-f024-40e3-91da-26f378bbbfd7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"PathGraph", "[", " ", 
        RowBox[{"Range", "[", " ", "6", " ", "]"}], " ", "]"}], ",", " ", 
       RowBox[{"<|", " ", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<a\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<a\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<b\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<c\>\""}], ",", " ", 
         RowBox[{"5", " ", "->", " ", "\"\<c\>\""}], ",", " ", 
         RowBox[{"6", " ", "->", " ", "\"\<c\>\""}]}], " ", "|>"}]}], " ", 
      "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"GraphicsRow", "[", " ", 
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{"InfraFiberedGraphHighlight", "[", " ", "fib", " ", "]"}], ",", 
      " ", 
      RowBox[{"InfraBaseSpace", "[", " ", "fib", " ", "]"}]}], " ", "}"}], 
    " ", "]"}]}], " ", "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4bd81087-4c7f-4f00-a0a1-e0872d56cd0a"],

Cell[BoxData[
 GraphicsBox[{{}, {InsetBox[
     FormBox[
      GraphicsBox[
