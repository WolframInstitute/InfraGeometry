Cell["A cycle wraps twice around its reconstructed square base.", \
"ExampleText",ExpressionUUID->"7ec8c57e-418e-429a-9cc7-aa8a46f2a60c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", " ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", " ", 
      RowBox[{
       RowBox[{"CycleGraph", "[", " ", "8", " ", "]"}], ",", " ", 
       RowBox[{"vertex", " ", "|->", " ", 
        RowBox[{"Mod", "[", " ", 
         RowBox[{"vertex", ",", " ", "4", ",", " ", "1"}], " ", "]"}]}]}], 
      " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
    RowBox[{"fib", ",", " ", 
     RowBox[{"{", " ", 
      RowBox[{"InfraFiber", "[", " ", 
       RowBox[{"fib", ",", " ", "1"}], " ", "]"}], " ", "}"}]}], " ", "]"}]}],
   " ", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8c56dd74-8b99-457b-a0ae-cd88ebb447e0"],

