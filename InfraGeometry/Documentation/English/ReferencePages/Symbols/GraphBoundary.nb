  FontSize->0.9 Inherited,ExpressionUUID->
  "e437bdca-162d-4c74-b1ad-b73c174fba2d"],
 "\[LineSeparator]",
 "gives the vertices of the vertex list ",
 StyleBox["s", "TI"],
 " that have a neighbour in ",
 StyleBox["g", "TI"],
 " outside ",
 StyleBox["s", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"beab46f4-34f1-440e-8e9f-0c7a73dd7bdb"],
 Cell[BoxData[
  RowBox[{
