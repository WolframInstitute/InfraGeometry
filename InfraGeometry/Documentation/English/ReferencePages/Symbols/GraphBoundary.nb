Cell["\<\
The outer boundary of a set is the boundary of its complement. For the ball \
of radius 3 it is the shell of radius 4, red, outside the inner boundary, \
blue.\
\>", "ExampleText",ExpressionUUID->"dce2f8c8-dac5-4c03-82cd-9efe51c39168"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"region", " ", "=", " ", 
        RowBox[{"FindInfraRepresentative", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraBall", "[", 
           RowBox[{
            RowBox[{"First", " ", "@", " ", 
             RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "3"}], 
           "]"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphBoundary", "[", 
            RowBox[{"g", ",", " ", "region"}], "]"}], " ", "->", " ", 
           "StandardBlue"}], ",", " ", 
          RowBox[{
           RowBox[{"GraphBoundary", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"Complement", "[", 
              RowBox[{
               RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "region"}], 
              "]"}]}], "]"}], " ", "->", " ", "StandardRed"}]}], "}"}]}], 
       "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\"", ",", 
        " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8b044119-0037-4311-b895-46e2c4630d76"],

