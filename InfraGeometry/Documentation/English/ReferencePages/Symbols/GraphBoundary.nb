Cell["\<\
The ball of radius 3 about the centre of the square, hexagonal and triangular \
tilings, its interior green and its boundary blue. The boundary of a ball is \
its outermost shell.\
\>", "ExampleText",ExpressionUUID->"32077103-6f4f-4397-8f8e-a665d6993294"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"panels", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "       ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
             RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
            "]"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{"region", " ", "=", " ", 
           RowBox[{"FindInfraRepresentative", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"InfraBall", "[", 
              RowBox[{
               RowBox[{"First", " ", "@", " ", 
                RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "3"}], 
              "]"}]}], "]"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraSubstrateHighlight", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"GraphInterior", "[", 
                 RowBox[{"g", ",", " ", "region"}], "]"}], " ", "->", " ", 
                "StandardGreen"}], ",", " ", 
               RowBox[{
                RowBox[{"GraphBoundary", "[", 
                 RowBox[{"g", ",", " ", "region"}], "]"}], " ", "->", " ", 
                "StandardBlue"}]}], "}"}]}], "]"}], ",", "\n", "        ", 
           RowBox[{"Length", "[", 
            RowBox[{"GraphBoundary", "[", 
             RowBox[{"g", ",", " ", "region"}], "]"}], "]"}]}], "}"}]}], 
        "]"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
           " ", "\"\<HexagonalTilingGraph\>\"", ",", 
           " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"First", " ", "/@", " ", "panels"}], "]"}], ",", " ", 
     RowBox[{"Last", " ", "/@", " ", "panels"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ed9330ae-e5fe-4bce-8d51-ce8fee6f96d2"],

