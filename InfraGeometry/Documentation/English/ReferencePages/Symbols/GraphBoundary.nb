Cell["\<\
A subgraph counts only its own edges. The spray of radius 2 about the centre \
of the triangular tiling has the vertices of the ball of radius 2 but no edge \
within a shell, so every vertex but the centre is a boundary vertex. Read as \
a vertex set, the ball has 12.\
\>", "ExampleText",ExpressionUUID->"8478f1fe-5ee2-45c8-9f27-5c784f12cec5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"spray", " ", "=", " ", 
     RowBox[{"SprayGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", 
       RowBox[{"\"\<AxisLength\>\"", " ", "->", " ", "2"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"AssociationThread", "[", 
              RowBox[{
               RowBox[{"GraphInterior", "[", 
                RowBox[{"g", ",", " ", "#"}], "]"}], ",", " ", "1"}], "]"}], 
             " ", "->", " ", "StandardGreen"}], ",", " ", 
            RowBox[{
             RowBox[{"AssociationThread", "[", 
              RowBox[{
               RowBox[{"GraphBoundary", "[", 
                RowBox[{"g", ",", " ", "#"}], "]"}], ",", " ", "1"}], "]"}], 
             " ", "->", " ", "StandardBlue"}]}], "}"}]}], "]"}], " ", "&"}], 
       " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"spray", ",", " ", 
         RowBox[{"VertexList", "[", "spray", "]"}]}], "}"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"GraphBoundary", "[", 
         RowBox[{"g", ",", " ", "#"}], "]"}], "]"}], " ", "&"}], " ", "/@", 
      " ", 
      RowBox[{"{", 
       RowBox[{"spray", ",", " ", 
        RowBox[{"VertexList", "[", "spray", "]"}]}], "}"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e65ac8a5-ce21-4d33-86b9-f330ffebad20"],

