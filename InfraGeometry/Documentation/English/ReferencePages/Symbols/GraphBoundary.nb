Cell["\<\
A set with a hole has a boundary on both of its sides: the ball of radius 4 \
less the ball of radius 1.\
\>", "ExampleText",ExpressionUUID->"6203a154-83a7-4cde-b674-c387d2d7be0f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"panels", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"With", "[", "\n", "       ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", " ", "=", " ", 
           RowBox[{"InfraSubstrate", "[", 
            RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
             RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
            "]"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{"region", " ", "=", " ", 
           RowBox[{"Complement", "[", 
            RowBox[{
             RowBox[{"FindInfraRepresentative", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraBall", "[", 
                RowBox[{
                 RowBox[{"First", " ", "@", " ", 
                  RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "4"}], 
                "]"}]}], "]"}], ",", " ", 
             RowBox[{"FindInfraRepresentative", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraBall", "[", 
                RowBox[{
                 RowBox[{"First", " ", "@", " ", 
                  RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "1"}], 
                "]"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"InfraSubstrateHighlight", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"GraphInterior", "[", 
                 RowBox[{"g", ",", " ", "region"}], "]"}], " ", "->", " ", 
                "StandardGreen"}], ",", " ", 
               RowBox[{
                RowBox[{"GraphBoundary", "[", 
                 RowBox[{"g", ",", " ", "region"}], "]"}], " ", "->", " ", 
                "StandardBlue"}]}], "}"}]}], "]"}], ",", "\n", "        ", 
           RowBox[{"Length", "[", 
            RowBox[{"GraphBoundary", "[", 
             RowBox[{"g", ",", " ", "region"}], "]"}], "]"}]}], "}"}]}], 
        "]"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<SquareTilingGraph\>\"", ",", 
           " ", "\"\<HexagonalTilingGraph\>\"", ",", 
           " ", "\"\<TriangularTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"First", " ", "/@", " ", "panels"}], "]"}], ",", " ", 
     RowBox[{"Last", " ", "/@", " ", "panels"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f4ce9faa-e6fb-4fbf-a430-73fab8fb3e72"],

