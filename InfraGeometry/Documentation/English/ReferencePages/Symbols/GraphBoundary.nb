Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraBoundary"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraBoundary", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "35dc2d9c-3a12-4c2f-af91-5879569ac5d4"],
 " with its default method gives the same vertices, sorted: here for the ball \
of radius 4 of the triangular tiling, its interior green."
}], "ExampleText",ExpressionUUID->"1f32d091-1ff1-45ce-a14a-181ee243c153"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<TriangularTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"region", " ", "=", " ", 
     RowBox[{"FindInfraRepresentative", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraBall", "[", 
        RowBox[{
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}], ",", " ", "4"}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"GraphInterior", "[", 
           RowBox[{"g", ",", " ", "region"}], "]"}], " ", "->", " ", 
          "StandardGreen"}], ",", " ", 
         RowBox[{
          RowBox[{"InfraBoundary", "[", 
           RowBox[{"g", ",", " ", "region"}], "]"}], " ", "->", " ", 
          "StandardBlue"}]}], "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"InfraBoundary", "[", 
       RowBox[{"g", ",", " ", "region"}], "]"}], " ", "===", " ", 
      RowBox[{"Sort", "[", 
       RowBox[{"GraphBoundary", "[", 
        RowBox[{"g", ",", " ", "region"}], "]"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"75539a08-ae5f-4661-826a-fee62a13ccff"],

