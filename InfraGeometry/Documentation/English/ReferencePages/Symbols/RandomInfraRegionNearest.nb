Cell[CellGroupData[{
Cell["RandomInfraRegionNearest", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"441af6d5-c672-4990-8df4-6c2ecc802100"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraRegionNearest"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRegionNearest", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["object", "TI"], ",", " ", 
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60b84690-fdc1-4db7-b77d-dd14ebb4420e"],
 "\[LineSeparator]",
 "samples the point family of all nearest support vertices to ",
 StyleBox["p", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"259a9c12-553b-4222-afd8-a140fe4646c2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraRegionNearest"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRegionNearest", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["token", "TI"], ",", " ", 
    StyleBox["count", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1667bb09-a2f0-4124-857e-c78ab1ee8554"],
 "\[LineSeparator]",
 "accepts an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRegionNearest"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraRegionNearest", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e5e96f1d-2536-436e-989d-3c1e2b929679"],
 " token."
}], "Usage",ExpressionUUID->"311da942-5af6-4c33-b4af-f07f5aa93618"],

Cell[TextData[{
 "The support is the nonzero supported vertex density of the object, or a \
supported raw vertex, vertex List, density Association or Graph carrier. \
Every finite-distance minimizer is retained. Empty or unreachable support \
gives an empty family. Unsupported support stays unevaluated. If ",
 StyleBox["p", "TI"],
 " is in the support, it is the unique nearest point."
}], "Notes",ExpressionUUID->"33c64401-39de-4bc8-9e8d-790389ca5a88"],

Cell["\<\
The graph must be finite, simple, undirected and unweighted, with valid \
anchors. Omitted count or Automatic gives one uniformly random vertex; an \
empty pool gives {}. An integer gives that many distinct vertices, or {} when \
too few exist. UpTo[n] gives at most n distinct vertices; All gives the \
complete pool in graph vertex order. Zero gives {}; negative counts and \
unsupported options stay unevaluated.\
\>", "Notes",ExpressionUUID->"e98bf6d6-524e-4106-91f3-cd36147d1c3d"],

Cell[TextData[{
 "\"NextVertexFunction\" defaults to Automatic. Identity selects in graph \
vertex order. These are the only supported selector values. All and Identity \
are deterministic. ",
 Cell[BoxData[
  RowBox[{"RandomSeeding", " ", "->", " ", "Automatic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6bb5051-6fdb-41f9-bea8-a563bddf09c8"],
 " (default) seeds each call afresh, independently of ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b433932a-ccce-48ac-8a65-b4bce0d1c2e7"],
 "; an integer or string gives a reproducible draw, and ",
 Cell[BoxData["Inherited"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ee197b2-0751-4f6f-b35c-bda810446287"],
 " a local snapshot of the current state. The outer random state is restored \
afterward, as with ",
 ButtonBox["RandomInstance",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/RandomInstance.html"], 
    None}],
 ". List-valued points remain intact. For an empty-List vertex, All and count \
1 distinguish {{}} from an empty pool."
}], "Notes",ExpressionUUID->"a6badda7-40c4-4c64-9bea-1e3d2c5b2deb"]
}, Open  ]],

