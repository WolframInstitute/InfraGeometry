        TagBox[DiskBox[{1., 2.4492935982947064`*^-16}, 0.02261146496815286],
         "DynamicName",
         BoxID -> "VertexID$2"], 
        TagBox[DiskBox[{2., 0.}, 0.02261146496815286],
         "DynamicName",
         BoxID -> "VertexID$3"]}}],
     MouseAppearanceTag["NetworkGraphics"]],
    AllowKernelInitialization->False]],
  DefaultBaseStyle->"NetworkGraphics",
