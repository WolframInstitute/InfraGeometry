Cell["Enumerate the complete point family.", "ExampleText",ExpressionUUID->"46d02871-e3c9-40d3-ac39-0c37734caf65"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"PathGraph", "[", " ", 
       RowBox[{"Range", "[", " ", "3", " ", "]"}], " ", "]"}]}], " ", "}"}], ",",
     "\n", "  ", 
    RowBox[{"RandomInfraRegionNearest", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"InfraRegionNearest", "[", " ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{"1", ",", " ", "3"}], " ", "}"}], ",", " ", "2"}], " ", 
       "]"}], ",", " ", "All"}], " ", "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fdf620b9-1937-4481-9bca-49f88a2bddaa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "3"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9434ec56-a625-49b4-acb4-e86f21b17f70"]
}, Open  ]],

Cell["Draw and highlight one point.", "ExampleText",ExpressionUUID->"48f52a1d-4f4e-4607-8dde-2d04dd318b51"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"PathGraph", "[", " ", 
       RowBox[{"Range", "[", " ", "3", " ", "]"}], " ", "]"}]}], " ", "}"}], ",",
     "\n", "  ", 
    RowBox[{"{", " ", 
     RowBox[{"point", " ", "=", " ", 
      RowBox[{"RandomInfraRegionNearest", "[", " ", 
       RowBox[{"graph", ",", " ", 
        RowBox[{"InfraRegionNearest", "[", " ", 
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{"1", ",", " ", "3"}], " ", "}"}], ",", " ", "2"}], " ", 
         "]"}]}], " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
    RowBox[{"InfraSubstrateHighlight", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"{", " ", 
       RowBox[{"<|", " ", 
        RowBox[{"point", " ", "->", " ", "1"}], " ", "|>"}], " ", "}"}]}], 
     " ", "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"25deec57-72cf-410f-8a60-9ad9af464f8e"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3}, {Null, {{1, 2}, {2, 3}}}, {
      VertexShapeFunction -> {1 -> (Append[{
            RGBColor[0.790588, 0.201176, 0.], 
            Opacity[1.]}, 
           Disk[#, 1 #3]]& )}}]]}, 
    TagBox[GraphicsGroupBox[{
