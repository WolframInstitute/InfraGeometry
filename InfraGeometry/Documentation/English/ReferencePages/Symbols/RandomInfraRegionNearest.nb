Cell["Enumerate the complete point family.", "ExampleText",ExpressionUUID->"d37bd9fc-e809-46c0-8dd6-40b74bc2b4e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"PathGraph", "[", " ", 
       RowBox[{"Range", "[", " ", "3", " ", "]"}], " ", "]"}]}], " ", "}"}], ",",
     "\n", "  ", 
    RowBox[{"RandomInfraRegionNearest", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"InfraRegionNearest", "[", " ", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{"1", ",", " ", "3"}], " ", "}"}], ",", " ", "2"}], " ", 
       "]"}], ",", " ", "All"}], " ", "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c3fdea60-3c9d-45d1-8569-76b70c776672"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "3"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"3d85e584-001d-454e-afbb-28cdbecabc64"]
}, Open  ]],

Cell["Draw and highlight one point.", "ExampleText",ExpressionUUID->"287fb8ea-51d7-4858-a69d-04bfed58431c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "71", " ", "]"}], ";", " ", 
  RowBox[{"With", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"graph", " ", "=", " ", 
      RowBox[{"PathGraph", "[", " ", 
       RowBox[{"Range", "[", " ", "3", " ", "]"}], " ", "]"}]}], " ", "}"}], ",",
     "\n", "  ", 
    RowBox[{"{", " ", 
     RowBox[{"point", " ", "=", " ", 
      RowBox[{"RandomInfraRegionNearest", "[", " ", 
       RowBox[{"graph", ",", " ", 
        RowBox[{"InfraRegionNearest", "[", " ", 
         RowBox[{
          RowBox[{"{", " ", 
           RowBox[{"1", ",", " ", "3"}], " ", "}"}], ",", " ", "2"}], " ", 
         "]"}]}], " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
    RowBox[{"InfraSubstrateHighlight", "[", " ", 
     RowBox[{"graph", ",", " ", 
      RowBox[{"{", " ", 
       RowBox[{"<|", " ", 
        RowBox[{"point", " ", "->", " ", "1"}], " ", "|>"}], " ", "}"}]}], 
     " ", "]"}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e7d00ba4-a3c8-4daa-a3c3-17d65726e266"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3}, {Null, {{1, 2}, {2, 3}}}, {
      VertexShapeFunction -> {1 -> (Append[{
            RGBColor[0.790588, 0.201176, 0.], 
            Opacity[1.]}, 
