Cell["\<\
Dropping the far vertex breaks inextensibility, so the truncation is no \
longer a ray.\
\>", "ExampleText",ExpressionUUID->"b97cb1d1-5205-41d3-9220-c8be5d578dc8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ray", " ", "=", " ", 
     RowBox[{"RandomInfraHalfLine", "[", 
