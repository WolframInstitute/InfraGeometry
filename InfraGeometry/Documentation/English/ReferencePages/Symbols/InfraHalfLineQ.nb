Cell[CellGroupData[{
Cell["InfraHalfLineQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4d3ba092-b1fc-4a4b-8e23-4f834c2baf14"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHalfLineQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHalfLineQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ray", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d164170-fb55-467d-81ad-e1a7828b08b1"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["ray", "TI"],
 " is a ray in ",
 StyleBox["g", "TI"],
 ": a shortest path from its own first vertex that cannot be prolonged past \
its last.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b0d7adbc-bf28-4e06-8206-165bb387234c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHalfLineQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHalfLineQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["ray1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ea18ff9-72ec-426f-91b7-7d89bc58d67d"],
 "\[LineSeparator]",
 "tests every ray of a list, such as the one ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraHalfLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraHalfLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d29c29a5-4d7d-4c3d-b3a1-7b6126bee2f0"],
 " returns."
}], "Usage",ExpressionUUID->"4b4dc460-eea0-4888-98c8-f05b1e4017db"],

Cell["\<\
Two conditions, and the asymmetry between them is the whole definition:\
\>", "Notes",ExpressionUUID->"ea8a24de-165d-4b34-a9f2-6ed64b83680b"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b7f06d80-f982-444c-8189-718d1f5613cf"], Cell["Condition", "TableText",
     FontWeight->Bold,ExpressionUUID->"610a0c2d-82fa-41c2-8484-dbeb53d82add"],
     Cell["Why", "TableText",
     FontWeight->Bold,ExpressionUUID->"e42bf715-2a4e-4e9b-bed3-9551c67d2e64"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ba862478-05c0-4b0d-a36b-9df6f6f9a2ef"], Cell[
    "the sequence is a shortest path", "TableText",ExpressionUUID->
     "253c9f27-a99c-46b3-b4a0-2cd1e59feebf"], Cell[TextData[{
     "a ray is straight, so ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSegmentQ"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "471cb095-f1b7-4244-af85-430a5547fccd"],
     " must hold"
    }], "TableText",ExpressionUUID->"86efd9a6-acda-487f-b5c9-74da0341b6ca"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d3926217-c16b-46b4-8467-0cb782804639"], Cell["\<\
no neighbour of the last vertex sits one step farther from the first\
\>", "TableText",ExpressionUUID->"5901426f-8fda-411a-b9f5-b78a8ae29999"], 
    Cell["the far end is inextensible", "TableText",ExpressionUUID->
     "bdbd7b74-cf83-498c-a5a9-bc7f2f15b920"]}
  }]], "2ColumnTableMod",ExpressionUUID->"61ceaf4f-aff1-4ced-acf5-\
37252d95b338"],

Cell[TextData[{
 "Inextensibility is required ",
 StyleBox["only at the far end",
  FontWeight->"Bold"],
 ". The origin is an endpoint by fiat \[LongDash] that is exactly what \
distinguishes a ray from a line (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraInfiniteLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraInfiniteLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ed7f933b-35be-4696-b374-f24f4ba03bc4"],
 " asks for inextensibility at both ends), and it means a ray may start \
anywhere, not only at a peripheral vertex."
}], "Notes",ExpressionUUID->"596cac16-e205-471c-9598-c38e0101d04a"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d875775d-9770-44fd-a4aa-b7a4b42abbcf"],
 ": a single vertex has no direction."
}], "Notes",ExpressionUUID->"5d9a8a19-5fde-4da2-899c-cd0eb7ac6c08"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraHalfLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraHalfLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "18738827-6c78-4a6d-9fa3-bbb84a1a8fda"],
 ", which prolongs a shortest path outward until no neighbour prolongs it, so \
every ray that finder returns satisfies it."
}], "Notes",ExpressionUUID->"0e88836c-db09-45c5-94a8-50c585f64dbf"]
}, Open  ]],

