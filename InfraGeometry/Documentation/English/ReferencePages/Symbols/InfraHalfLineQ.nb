Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cb498b7b-08d7-4882-9a59-45ea83b87528"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHalfLineQ"]], 
