Cell[CellGroupData[{
Cell["InfraHalfLineQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b5f25059-496f-48a2-8c61-94322b9b164a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHalfLineQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHalfLineQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ray", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d93d45fb-61c8-4279-9e45-ecbd6100838e"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["ray", "TI"],
 " is a ray in ",
 StyleBox["g", "TI"],
 ": a shortest path from its own first vertex that cannot be prolonged past \
its last.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f00b466c-80be-4399-9ada-ec9d4155ddc5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraHalfLineQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraHalfLineQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["ray1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b651b8e6-119e-42ad-8ae1-0a8166b7f8e5"],
 "\[LineSeparator]",
 "tests every ray of a list, such as the one ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RandomInfraHalfLine"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraHalfLine", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7adaae58-6c41-434a-8e71-dd31a9ba3802"],
 " returns."
}], "Usage",ExpressionUUID->"7dcd010e-0940-4fa8-bf5f-88f2e8d80967"],

Cell["\<\
Two conditions, and the asymmetry between them is the whole definition:\
\>", "Notes",ExpressionUUID->"1892783f-89dd-419c-ab0e-1ca8a81f30a9"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "12077556-23ee-413f-b4bd-31cb84d33976"], Cell["Condition", "TableText",
     FontWeight->Bold,ExpressionUUID->"85a76094-a259-4db0-b167-4d0c7886f2b7"],
     Cell["Why", "TableText",
     FontWeight->Bold,ExpressionUUID->"67a349c6-01e1-4e84-b3bc-ff8f42ccbfca"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "09e2fd97-000c-43c5-9183-815134e5237f"], Cell[
    "the sequence is a shortest path", "TableText",ExpressionUUID->
     "f141ffd5-6979-497e-aef1-27d913b4ff1f"], Cell[TextData[{
     "a ray is straight, so ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSegmentQ"]], 
        "paclet:WolframInstitute/InfraGeometry/ref/InfraSegmentQ", 
        "WolframInstitute/InfraGeometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "93a0ce98-80f8-4713-ae3d-5de79d3a5f67"],
     " must hold"
    }], "TableText",ExpressionUUID->"2e5811c4-6877-4d7a-95e5-a0ab252f0b50"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "73afa094-9331-44ac-9701-9a5616b06ac1"], Cell["\<\
no neighbour of the last vertex sits one step farther from the first\
\>", "TableText",ExpressionUUID->"0af46689-9b80-4c5b-8867-8b85dc57a25a"], 
    Cell["the far end is inextensible", "TableText",ExpressionUUID->
     "0c5da55a-8fa6-413d-a380-c11c4af3e806"]}
  }]], "2ColumnTableMod",ExpressionUUID->"45079db3-44cc-4457-8b5f-\
2aac962223c5"],

Cell[TextData[{
 "Inextensibility is required ",
 StyleBox["only at the far end",
  FontWeight->"Bold"],
 ". The origin is an endpoint by fiat \[LongDash] that is exactly what \
distinguishes a ray from a line (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraInfiniteLineQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraInfiniteLineQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4c1b5ccb-ad29-441a-91f0-8f9f69bd8206"],
 " asks for inextensibility at both ends), and it means a ray may start \
anywhere, not only at a peripheral vertex."
}], "Notes",ExpressionUUID->"e6cde9f0-bf8e-479c-9e75-672947780882"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "378aeef6-de0f-484e-b9b0-b450c5409098"],
 ": a single vertex has no direction."
}], "Notes",ExpressionUUID->"0d1fe7d1-e6e4-4dcb-8c32-b990002210eb"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraHalfLine"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraHalfLine", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5f0af5ca-579a-42cc-9b70-3edf346d39b2"],
 ", which prolongs a shortest path outward until no neighbour prolongs it, so \
every ray that finder returns satisfies it."
}], "Notes",ExpressionUUID->"e5814c6b-afec-4a65-b8c4-b48d30d41ff9"]
}, Open  ]],

