Cell["\<\
The interval of the same segments, its inner vertices in green and its \
boundary in blue. The Riemannian measure counts the green ones, the counting \
measure both. On the square grid the interval is a 3 \[Times] 4 rectangle \
with 2 inner vertices. On the discretized plane the two shortest paths differ \
in a single vertex, and nothing is inside.\
\>", "ExampleText",ExpressionUUID->"7b925e15-4432-46b3-a9bb-64be932b7213"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"seg", " ", "=", " ", 
        RowBox[{"InfraSegment", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
            RowBox[{"RandomInfraPoint", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"InfraShell", "[", 
               RowBox[{"c", ",", " ", "5"}], "]"}]}], "]"}]}], ")"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"support", " ", "=", " ", 
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<VertexDensity\>\""}], 
          "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"InfraInterior", "[", 
              RowBox[{"g", ",", " ", "support"}], "]"}], " ", "->", " ", 
             "StandardGreen"}], ",", " ", 
            RowBox[{
             RowBox[{"InfraBoundary", "[", 
              RowBox[{"g", ",", " ", "support"}], "]"}], " ", "->", " ", 
             "StandardBlue"}]}], "}"}]}], "]"}], ",", "\n", "      ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", "seg", ",", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Cardinality\>\"", ",", " ", "\"\<CountingMeasure\>\"",
             ",", " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "]"}]}], 
       "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c638ae93-3494-4fcc-b7ad-9e210ca4e443"],

