Cell[CellGroupData[{
Cell["InfraSegment", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cef7a970-9fe6-4e49-a700-ca1d4cac8da1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eace24a9-9351-42ec-acfc-c3ab550e2d75"],
 "\[LineSeparator]",
 "is the segment from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ": every geodesic from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " at once. It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f0b67e91-07f4-45c8-b8fd-2ee98c944f4d"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraVertexList", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6ba92052-3a2a-4d64-a3e4-b6492c67e830"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ecbcffa1-9c23-4efa-bc12-558798a92dc9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0abaae9-f037-47a1-81ed-d7ed3690052c"],
 "\[LineSeparator]",
 "is the polyline of the segments [",
 StyleBox["p1", "TI"],
 ", ",
 StyleBox["p2", "TI"],
 "], \[Ellipsis], [",
 StyleBox["p(k-1)", "TI"],
 ", ",
 StyleBox["pk", "TI"],
 "].",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b2076884-2af6-4d00-921d-b1d5de621604"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a213628-c6ab-4841-9270-df3d31e5b98d"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dee5019f-7310-43a8-b649-de6862036b38"],
 " is the segment construction token; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bccfeec7-0ba5-41eb-89d2-357ce60fd1e7"],
 " is the search."
}], "Usage",ExpressionUUID->"fd8b4005-c2d7-428c-baf8-cc6e4a87561f"],

Cell[TextData[{
 "Definition: an infra-segment between ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " is the set of all geodesics from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"0abf7da1-b672-4459-9949-77b803e2ac70"],

Cell["\<\
It carries no weights. The geodesics are equally admissible, so nothing \
distinguishes them.\
\>", "Notes",ExpressionUUID->"f7baf24b-def8-4c2c-815b-8bc1f64a753c"],

Cell[TextData[{
 "The head holds its two points and computes nothing. Its graph \[LongDash] \
",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f4a4bc9-efeb-426a-b560-af6a30172137"],
 " \[LongDash] is the geodesic interval: the vertices ",
 StyleBox["v", "TI"],
 " with ",
 StyleBox["d(p, v) + d(v, q) = d(p, q)", "TI"],
 ", with arrows of rising distance from ",
 StyleBox["p", "TI"],
 ". Its source-to-sink chains are exactly the geodesics, each once, so ",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a242a5d-3de7-4c8f-b9d4-079bdc8b3957"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db1af381-7c4c-4aaf-ae8d-c3728b9712a9"],
 "."
}], "Notes",ExpressionUUID->"c2413096-b215-41c1-8b78-6cd9c6cbd2b2"],

Cell["\<\
Every count is read off that graph by dynamic programming, never by \
enumeration. The graph stays small where the family is large: two vertices at \
distance 5 on a square grid have 10 geodesics and a 12-vertex graph.\
\>", "Notes",ExpressionUUID->"5d75dd45-f56d-4a4a-bccd-2ab1e2d71b9a"],

Cell[TextData[{
 "A polyline is the one head whose ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93bc0a80-85b1-464f-a29f-2ef6b53ef102"],
 " of graphs is not a family of alternatives. Its members are concatenations \
of one geodesic per piece, so its ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9dacd29-f1e7-4ba4-8b02-93f0e2542a11"],
 " is the product over the pieces and its ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66dd28d7-069a-487b-a369-bae110b0f318"],
 " the sum. Its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2c7ec66-b818-423a-a27c-519bce3354ae"],
 " stays the sum of the piece densities."
}], "Notes",ExpressionUUID->"828391d3-c7af-4559-bfb7-b614b74b7f5e"],

Cell[TextData[{
 "A member is a vertex list; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraVertexList"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraVertexList", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "64b1f624-1059-4f96-ad8d-ac269b000c02"],
 " reads one, several or all of them, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ed4a8bdd-b43f-451b-958d-f5880d733523"],
 " tests one."
}], "Notes",ExpressionUUID->"d5ab5ff9-fbef-4366-b65a-5fa47b348b37"]
}, Open  ]],

