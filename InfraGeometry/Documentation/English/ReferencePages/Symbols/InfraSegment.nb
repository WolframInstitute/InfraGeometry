Cell["\<\
The cardinality is the number of members, and every member has the graph \
distance as its length.\
\>", "ExampleText",ExpressionUUID->"67cfe471-2f9c-4ad7-9dc4-bb7f1c54a6c9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"1", ",", " ", "19"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"members", " ", "=", " ", 
     RowBox[{"InfraVertexList", "[", 
      RowBox[{"g", ",", " ", "seg", ",", " ", "All"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", " ", "@", " ", "members"}], " ", "===", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<Cardinality\>\""}], 
       "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Union", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "#", "]"}], " ", "-", " ", "1"}], " ", "&"}],
         " ", "/@", " ", "members"}], "]"}], " ", "===", " ", 
