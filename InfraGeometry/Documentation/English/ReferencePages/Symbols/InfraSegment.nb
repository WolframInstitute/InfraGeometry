Cell["\<\
A polyline through the centre: one shortest path in, one out. Its cardinality \
is the product of the two pieces' cardinalities.\
\>", "ExampleText",ExpressionUUID->"23850b17-87eb-4abe-85dc-40d5fe14d3db"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Small\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
       RowBox[{"RandomInfraPoint", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "4"}], "]"}]}], "]"}]}], ")"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"poly", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"a", ",", " ", "c", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"poly", ",", " ", "a", ",", " ", "c", ",", " ", "b"}], 
        "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "poly", ",", " ", "\"\<Cardinality\>\""}], 
       "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSegment", "[", 
          RowBox[{"a", ",", " ", "c"}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}], " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraSegment", "[", 
          RowBox[{"c", ",", " ", "b"}], "]"}], ",", 
         " ", "\"\<Cardinality\>\""}], "]"}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"14e380fe-2f13-4c04-ab44-faa29e09f85b"],

